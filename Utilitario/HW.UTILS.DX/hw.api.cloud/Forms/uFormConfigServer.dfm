          object memoDBLogNew: TMemo
            Left = 504
            Top = 0
            Width = 186
            Height = 37
            Align = alRight
            Lines.Strings = (
              'CREATE GENERATOR SEQ_LOGMESSAGE;'
              '|/BLOCO|'
              'CREATE TABLE LOGMESSAGE ('
              '    ID         CHAR(36) NOT NULL,'
              '    CNPJ       VARCHAR(14) NOT NULL,'
              '    SEQ        BIGINT,'
              '    CREATEDAT  TIMESTAMP,'
              '    DIRECTION  SMALLINT NOT NULL,'
              '    LEVEL_     SMALLINT NOT NULL,'
              '    SOURCE     VARCHAR(64) NOT NULL,'
              '    TEXT       BLOB SUB_TYPE 1 SEGMENT SIZE 128 NOT NULL,'
              '    LOG_ID     VARCHAR(36)'
              ');'
              '|/BLOCO|'
              
                'ALTER TABLE LOGMESSAGE ADD CONSTRAINT PK_LOGMESSAGE PRIMARY KEY ' +
                '(ID);'
              '|/BLOCO|'
              'CREATE INDEX LOGMESSAGE_IDX_SEQ ON LOGMESSAGE (CNPJ, SEQ);'
              '|/BLOCO|'
              'CREATE INDEX IDX_LOGMESSAGE ON LOGMESSAGE (CNPJ, CREATEDAT);'
              '|/BLOCO|'
              'CREATE TABLE LOGMESSAGE_TABLE ('
              '    LOG_ID  CHAR(36) NOT NULL,'
              '    TABELA  VARCHAR(31) NOT NULL,'
              '    KEYS    VARCHAR(128) NOT NULL,'
              '    CAMPOS  BLOB SUB_TYPE 1 SEGMENT SIZE 256 NOT NULL'
              ');'
              '|/BLOCO|'
              
                'ALTER TABLE LOGMESSAGE_TABLE ADD CONSTRAINT PK_LOGMESSAGE_TABLE ' +
                'PRIMARY KEY (LOG_ID);'
              '|/BLOCO|'
              'CREATE TABLE LOGMESSAGE_VALUES ('
              '    LOG_ID  CHAR(36) NOT NULL,'
              '    SEQ     INTEGER NOT NULL,'
              '    DATA    BLOB SUB_TYPE 1 SEGMENT SIZE 256 NOT NULL'
              ');'
              '|/BLOCO|'
              
                'ALTER TABLE LOGMESSAGE_VALUES ADD CONSTRAINT PK_LOGMESSAGE_VALUE' +
                'S PRIMARY KEY (LOG_ID, SEQ);'
              '|/BLOCO|'
              'CREATE TABLE EMPRESA_TIMEZONE ('
              '    CNPJ          VARCHAR(14) NOT NULL,'
              '    TIMEZONE_DIF  SMALLINT NOT NULL'
              ');'
              '|/BLOCO|'
              
                'CREATE UNIQUE INDEX IDX_EMPRESA_TIMEZONE ON EMPRESA_TIMEZONE (CN' +
                'PJ);'
              '|/BLOCO|'
              'SET TERM ^ ;'
              ''
              'CREATE OR ALTER TRIGGER TR_LOGMESSAGE_BI_ID FOR LOGMESSAGE'
              'ACTIVE BEFORE INSERT POSITION 0'
              'as'
              'begin'
              '  new.SEQ = next value for SEQ_LOGMESSAGE;'
              '  new.CREATEDAT = current_timestamp;'
              'end'
              '^'
              ''
              'create or alter procedure SP_CURRENT_TS ('
              '    CNPJ varchar(14) = 0)'
              'returns ('
              '    CURRENT_TS timestamp,'
              '    CURRENT_D timestamp,'
              '    CURRENT_T time)'
              'as'
              'begin'
              '  CURRENT_TS = dateadd(hour, coalesce((select TIMEZONE_DIF'
              '                                       from EMPRESA_TIMEZONE'
              
                '                                       where CNPJ = trim(:CNPJ))' +
                ', 0), current_timestamp);'
              '  CURRENT_D = cast(CURRENT_TS as date);'
              '  CURRENT_T = cast(CURRENT_TS as time);'
              '  suspend;'
              'end'
              '^'
              ''
              'create or alter trigger LOGMESSAGE_BD_CLEAR for LOGMESSAGE'
              'active before delete position 0'
              'as'
              'begin'
              '  delete from LOGMESSAGE_TABLE T where T.LOG_ID = old.ID;'
              '  delete from LOGMESSAGE_VALUES V where V.LOG_ID = old.ID;'
              'end'
              '^'
              ''
              'SET TERM ; ^'
              '')
            TabOrder = 1
            Visible = False
            WordWrap = False
          end
