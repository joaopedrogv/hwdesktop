              object ts_script_terminal: TTabSheet
                Caption = 'ts_script_terminal'
                ImageIndex = 2
                object memoScriptTerminal: TMemo
                  Left = 0
                  Top = 0
                  Width = 670
                  Height = 45
                  Align = alClient
                  Lines.Strings = (
                    'CREATE GENERATOR SEQ_SINCOFF_BKP;'
                    '|/BLOCO|'
                    'CREATE TABLE SINCOFF_BKP ('
                    '    ID      INTEGER NOT NULL,'
                    '    TABELA  VARCHAR(31),'
                    '    JSON    BLOB SUB_TYPE 1 SEGMENT SIZE 256 NOT NULL'
                    ');'
                    '|/BLOCO|'
                    'SET TERM ^ ;'
                    ''
                    'CREATE UNIQUE INDEX IDX_SINCOFF_BKP ON SINCOFF_BKP (ID, TABELA);'
                    '|/BLOCO|'
                    'CREATE OR ALTER TRIGGER SINCOFF_BKP_BI FOR SINCOFF_BKP'
                    'ACTIVE BEFORE INSERT POSITION 0'
                    'AS'
                    'begin'
                    '  if (new.ID is null) then'
                    '    new.ID = next value for SEQ_SINCOFF_BKP;'
                    'end;'
                    '^'
                    ''
                    'SET TERM ; ^'
                    '|/BLOCO|'
                    'CREATE TABLE SINCOFF_SERV_IDS ('
                    '    EMPRESA_ID     INTEGER NOT NULL,'
                    '    TABELA         VARCHAR(31) NOT NULL,'
                    '    SIDE           CHAR(1) NOT NULL,'
                    '    SEQID_SINCOFF  BIGINT NOT NULL'
                    ');'
                    '|/BLOCO|'
                    
                      'ALTER TABLE SINCOFF_SERV_IDS ADD CONSTRAINT PK_SINCOFF_SERV_IDS ' +
                      'PRIMARY KEY (EMPRESA_ID, TABELA, SIDE);')
                  TabOrder = 0
                  WordWrap = False
                end
              end
            end
          end
        end
