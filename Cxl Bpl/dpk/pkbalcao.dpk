  pkPedidoVenda,
  pkNF;

contains
  UPendBalcao in '..\fonte\UPendBalcao.pas' {FrmPendBalcao},
  UDtmBalcao in '..\fonte\UDtmBalcao.pas' {DtmBalcao: TDataModule},
  UPendOficina in '..\fonte\UPendOficina.pas' {FrmPendOficina},
