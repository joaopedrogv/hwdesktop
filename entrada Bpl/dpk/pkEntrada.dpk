package pkEntrada;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  vcljpg,
  dbrtl,
  dsnap,
  vcldb,
  ibxpress,
  VclSmp,
  vclx,
  tee,
  pkModern;

contains
  uClasseEntrada in '..\fonte\uClasseEntrada.pas',
  uDtmEntrada in '..\fonte\uDtmEntrada.pas' {dtmEnt},
  USenha in '..\fonte\USenha.pas' {FrmEntrada},
  USplash in '..\fonte\USplash.pas',
  uExplorer in '..\fonte\uExplorer.pas' {frmExplorer};

end.
