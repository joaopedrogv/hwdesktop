var
  dtmFP: TdtmFP;
  //obFormPag: TFormPag;


implementation

uses  uDtmAtivo;

{$R *.dfm}

procedure TdtmFP.cdsBuscasBeforeOpen(DataSet: TDataSet);
begin
  mudaSelect(TClientDataSet(DataSet));
end;

procedure TdtmFP.mudaSelect(DataSet: TClientDataSet);
var
  i: integer;
begin
  if DataSet.CommandText <> '' then
  begin
    for I := 0 to dtmFP.ComponentCount - 1 do
    begin
      if (dtmFP.Components[i] is TDataSetProvider) then
        if UpperCase(TDataSetProvider(dtmFP.Components[i]).Name) = UpperCase(DataSet.ProviderName)
          then
        begin
          TIBQuery(TDataSetProvider(dtmFP.Components[i]).DataSet).SQL.Text := DataSet.CommandText;
          Break;
        end;
    end;
  end;
end;

end.

