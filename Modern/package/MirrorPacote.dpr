procedure AtualizacaoConsultasSQL();
begin
  if ContainerDFe.GetInstance().DFeFeaturesFactory.CreateExisteAtualizacaoConsultasSqlUseCase(observer).Executar() then
    ContainerDFe.GetInstance().DFeFeaturesFactory.CreateSincronizarConsultasSqlUseCase(observer).Executar();
end;

procedure TesteNFSe();
var
  os: NFSeOSEtdList;
begin
  os := ErpFeaturesRepoContainer.GetInstance().NFSeRepo.ListarRelacionamento(
    1563
  );

  try
    if os.Count > 0 then
    begin
      ContainerDFe.GetInstance().DFeFeaturesFactory.CreateEmitirLoteWsNFSeUseCase(observer)
        .Executar( EmitirLoteWsNFSeInput.Create([os.Items[0].NFSeId], [''], EmpresaId, False
      ));
    end;
  finally
    os.Free;
  end;
end;

procedure TesteSubstituicaoNFSe();
var
  os: NFSeOSEtdList;
begin
  os := ErpFeaturesRepoContainer.GetInstance().NFSeRepo.ListarRelacionamento(
    1560
  );

  try
    if os.Count > 0 then
    begin
      Container.GetInstance().ErpFeaturesFactory.CreateIniciarSubstuicaoNFSeUseCase()
        .Executar( os.Items[0].NFSeId, EmpresaId
      );
    end;
  finally
    os.Free;
  end;
end;

