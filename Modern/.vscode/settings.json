{
  "files.associations": {
    "*.pas": "pascal",
    "*.dpr": "pascal",
    "*.dpk": "pascal",
    "*.dfm": "pascal",
    "*.inc": "pascal",
    "*.sql": "sql"
  },
  "[pascal]": {
    "files.encoding": "iso88591"
  },
  "files.defaultLanguage": "pascal",
  "workbench.editorAssociations": {
    "*.dfm": "default"
  },
  "search.exclude": {
    "**/*.dcu": true,
    "**/*.exe": true,
    "**/*.dll": true,
    "**/.git": true
  },
  "files.exclude": {
    ".aider.tags.cache.v4": true,
    ".aider.input.history": true,
    ".aider.chat.history.md": true,
    "**/*.identcache": true,
    "**/*.bdsproj.local": true,
    "**/*.dproj.local": true,
    "**/__history": true,
    "**/__recovery": true
  }
}