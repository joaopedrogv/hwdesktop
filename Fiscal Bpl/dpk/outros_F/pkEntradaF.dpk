package pkEntradaF;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  vcljpg,
  dbrtl,
  dsnap,
  vcldb,
  ibxpress,
  VclSmp,
  vclx,
  tee,
  pkAtivosF;

contains
  uClasseEntrada in '..\..\..\entrada Bpl\fonte\uClasseEntrada.pas',
  uDtmEntrada in '..\..\..\entrada Bpl\fonte\uDtmEntrada.pas' {dtmEnt},
  USenha in '..\..\..\entrada Bpl\fonte\USenha.pas',
  USplash in '..\..\..\entrada Bpl\fonte\USplash.pas',
  uExplorer in '..\..\..\entrada Bpl\fonte\uExplorer.pas' {frmExplorer};

end.
