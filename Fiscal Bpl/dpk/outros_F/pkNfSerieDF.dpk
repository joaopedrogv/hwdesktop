package pkNfSerieDF;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  PkFormulariosF,
  pkAtivosF,
  vcl,
  vcldb,
  dbrtl;

contains
  UDtmNfSerieD in '..\..\..\Automacao Bpl\fonte\UDtmNfSerieD.pas' {dtmNfSerieD: TDataModule},
  uCadNfSerieD in '..\..\..\Automacao Bpl\fonte\uCadNfSerieD.pas' {frmCadNfSerieD},
  UClassesNfSerieD in '..\..\..\Automacao Bpl\fonte\UClassesNfSerieD.pas';

end.
