package PkTerminaisFF;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  vcldb,
  dbrtl,
  dsnap,
  ibxpress,
  pkAtivosF,
  pkConfigF,
  PkFormulariosF,
  VclSmp,
  vclx,
  xhCntrls100,
  xhStd100,
  tee,
  dclstd,
  designide,
  xmlrtl,
  vclactnband,
  vcldesigner,
  dcldb,
  xhChart100,
  xhDsgn100,
  xhExport100;

contains
  UTerminalF in '..\..\..\Automacao Bpl\fonte\UTerminalF.pas',
  UdtmTerminalF in '..\..\..\Automacao Bpl\fonte\UdtmTerminalF.pas' {dtmTerminaisF: TDataModule},
  UClassesFinalizadores in '..\..\..\Automacao Bpl\fonte\UClassesFinalizadores.pas',
  UdetalhesResD in '..\..\..\Automacao Bpl\fonte\UdetalhesResD.pas' {FrmDetalhesResD},
  USincTerminais in '..\..\..\Automacao Bpl\fonte\USincTerminais.pas' {FrmSincTerminais},
  UArqFiscal in '..\..\..\Automacao Bpl\fonte\UArqFiscal.pas' {FrmArqUsados},
  uSelTerminal in '..\..\..\Automacao Bpl\fonte\uSelTerminal.pas' {frmSelTerminalF},
  uGTNSerieECF in '..\..\..\Automacao Bpl\fonte\uGTNSerieECF.pas' {frmGtNSerieECF},
  UArqFrente in '..\..\..\Automacao Bpl\fonte\UArqFrente.pas',
  uClasseLayoutFiscal in '..\..\..\Automacao Bpl\fonte\uClasseLayoutFiscal.pas',
  uAssistenteDeConfiguracaoFiscal in '..\..\..\Automacao Bpl\fonte\uAssistenteDeConfiguracaoFiscal.pas' {frmAssistemConfigFiscal},
  uClassesAssistenConfig in '..\..\..\Automacao Bpl\fonte\uClassesAssistenConfig.pas',
  uDtmAssistente in '..\..\..\Automacao Bpl\fonte\uDtmAssistente.pas' {dtmAssistente: TDataModule},
  UvisualizadorOLAP in '..\..\..\Hw Gestor\fontes\UvisualizadorOLAP.pas';

end.
