package pkSPED;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  pkAtivos,
  PkFormularios,
  vcl,
  vcldb,
  dbrtl,
  pkEquipamentos,
  vclx,
  dsnap,
  ibxpress,
  pkEditHw;

contains
  uDtmSPED in '..\fonte\uDtmSPED.pas' {dtmSPED: TDataModule},
  uCadInformacaoCompl in '..\fonte\uCadInformacaoCompl.pas' {frmCadInformacaoCompl},
  uClassesSped in '..\fonte\uClassesSped.pas',
  uCadSpedAcaoJudicial in '..\fonte\uCadSpedAcaoJudicial.pas' {frmCadSpedAcaoJudicial},
  uCadSpedProcessoAdm in '..\fonte\uCadSpedProcessoAdm.pas' {frmCadSpedProcessoAdm},
  uCadSpedPCOutRecCred in '..\fonte\uCadSpedPCOutRecCred.pas' {frmCadSpedPCOutRecCred},
  uClassesSpedPCBlocoF in '..\fonte\uClassesSpedPCBlocoF.pas',
  uCadSpedPCDeprAmortBem in '..\fonte\uCadSpedPCDeprAmortBem.pas' {frmCadSpedPCDeprecAmortBem},
  uCadSpedPCAquisicaoBem in '..\fonte\uCadSpedPCAquisicaoBem.pas' {frmCadSpedPCAquisicaoBem},
  uCadSpedPCEstoqueAbertura in '..\fonte\uCadSpedPCEstoqueAbertura.pas' {frmCadSpedPCEstoqueAbertura},
  uCIAP in '..\..\Automacao Bpl\fonte\uCIAP.pas' {frmCIAP},
  uCadPlContasContabil in '..\..\Automacao Bpl\fonte\uCadPlContasContabil.pas' {frmPlContasContabil},
  uClassesCIAP in '..\..\Automacao Bpl\fonte\uClassesCIAP.pas',
  uDtmCIAP in '..\..\Automacao Bpl\fonte\uDtmCIAP.pas' {dtmCIAP: TDataModule},
  uCadCentroCustos in '..\..\Automacao Bpl\fonte\uCadCentroCustos.pas' {frmCadCentroCustos},
  uCadMovimentacaoBem in '..\..\Automacao Bpl\fonte\uCadMovimentacaoBem.pas' {frmMovimentacaoBem},
  uCadContCredSped in '..\..\Automacao Bpl\fonte\uCadContCredSped.pas' {frmCadContSped},
  uCadSpedLancamentosFiscais in '..\fonte\uCadSpedLancamentosFiscais.pas' {frmCadSpedLancamentosFiscais},
  uCadSpedFIcmsInterAjustes in '..\fonte\uCadSpedFIcmsInterAjustes.pas' {frmSpedFIcmsInterAjustes},
  uClassesSpedFBlocoE in '..\fonte\uClassesSpedFBlocoE.pas',
  uCadSpedFObrigacoesDIFAL in '..\fonte\uCadSpedFObrigacoesDIFAL.pas' {frmCadSpedFObrigacoesDIFAL},
  uClassesSpedFBlocoH in '..\fonte\uClassesSpedFBlocoH.pas',
  uManutencaoInventario in '..\fonte\uManutencaoInventario.pas' {frmManutencaoInventario},
  uCadSpedConfAjustesAuto in '..\fonte\uCadSpedConfAjustesAuto.pas' {frmCadSpedConfAjustesAuto};

end.
