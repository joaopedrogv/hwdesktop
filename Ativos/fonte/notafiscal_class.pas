  Fxml_nfe                 := TStringList.Create;
  Fconf_bc                 := TStringList.Create;
end;

destructor TNotafiscal_class.Destroy;
begin
  if Assigned(Fobs) then
    FreeAndNil(Fobs);
  if Assigned(Fdados_interesse_fisco) then
    FreeAndNil(Fdados_interesse_fisco);
  if Assigned(Fdados_lancamento_fiscal) then
    FreeAndNil(Fdados_lancamento_fiscal);
  if Assigned(Finf_corpo_v) then
    FreeAndNil(Finf_corpo_v);
  if Assigned(Fdup_xml_entrada) then
    FreeAndNil(Fdup_xml_entrada);
  if Assigned(Fxml_nfe) then
    FreeAndNil(Fxml_nfe);
  if Assigned(Fconf_bc) then
    FreeAndNil(Fconf_bc);
  inherited;
end;

