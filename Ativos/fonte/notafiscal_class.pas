{ TNotafiscal_classList }

function TNotafiscal_classList.GetItem(Index: Integer): TNotafiscal_class;
begin
  Result := TNotafiscal_class(inherited Items[Index]);
end;

function TNotafiscal_classList.New: TNotafiscal_class;
begin
  Result := TNotafiscal_class.Create;
  Add(Result);
end;

procedure TNotafiscal_classList.SetItem(Index: Integer; const Value: TNotafiscal_class);
begin
  Put(Index, Value);
end;

procedure TNotafiscal_classList.SetValuesFrom(ADataSet: TDataSet; AcheckFields: Boolean);
begin
  ADataSet.First;
  while not ADataSet.Eof do
  begin
    Self.New.SetValuesFrom(ADataSet, AcheckFields);
    ADataSet.Next;
  end;
end;

