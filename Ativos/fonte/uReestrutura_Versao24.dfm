          'CREATE INDEX NFCE_PAGAMENTO_IDX_TR_CARTAO ON NFCE_PAGAMENTO (ID_' +
          'TR_CARTAO,COD_EMPRESA);'
        
          'ALTER TABLE NFCE_PAGAMENTO DROP CONSTRAINT NFCE_PAGAMENTO_TR_CAR' +
          'TAO;'
        'ALTER TABLE NFC_EMISSOR ADD REFRESH_TOKEN VARCHAR(256);'
        'ALTER TABLE NFC_EMISSOR ADD DATA_API_ONLINE TIMESTAMP;'
        'ALTER TABLE NFC_EMISSOR ADD DATA_API_ERROR TIMESTAMP;'
        'ALTER TABLE NFC_EMISSOR ADD SERIE_NFCE_OFF SMALLINT;'
        
          'CREATE EXCEPTION EXC_SINCOFF_SCHEMA_EMP_ID_EMPTY '#39'Tabela com cod' +
          'igo de empresa e n'#227'o preenchido'#39';'
        
          'CREATE EXCEPTION EXC_SINCOFF_FIELDNOTFOUND '#39'Campo configurado na' +
          'o encontrado, verifique'#39';'
        
          'CREATE EXCEPTION EXC_SO_TAB_NOTREP '#39'Tabela nao permitida para si' +
          'ncronizacao'#39';'
        
          'CREATE EXCEPTION EXC_SO_NO_CONF '#39'Sincroniza'#231#227'o de dados offline ' +
          'desativada. Configure por favor'#39';'
        
          'CREATE EXCEPTION EXC_SO_DEL_TABS_NFCE '#39'Tabelas relacionadas a NF' +
          'Ce n'#227'o podem ser excluidas do SCHEMA'#39';'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_FIELDS_PK ('
        '    TABELA varchar(31))'
        'returns ('
        '    INDEX_POS integer,'
        '    FIELDNAME varchar(31),'
        '    PK_NAME varchar(31))'
        'as'
        'begin'
        
          '  for select SG.RDB$FIELD_POSITION, trim(SG.RDB$FIELD_NAME) , tr' +
          'im(RC.RDB$CONSTRAINT_NAME)'
        '      from RDB$RELATION_CONSTRAINTS RC'
        
          '        inner join RDB$INDICES IX on RC.RDB$INDEX_NAME = IX.RDB$' +
          'INDEX_NAME'
        
          '        inner join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NAME = ' +
          'SG.RDB$INDEX_NAME'
        '      where RC.RDB$CONSTRAINT_TYPE = '#39'PRIMARY KEY'#39' and'
        '            RC.RDB$RELATION_NAME = :TABELA'
        '      order by SG.RDB$FIELD_POSITION'
        '        into :INDEX_POS, :FIELDNAME, :PK_NAME'
        '  do'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_FIELDS_FK ('
        '    TABELA varchar(31))'
        'returns ('
        '    TABLE_REF varchar(31),'
        '    PK_NAME varchar(31),'
        '    FIELDNAME varchar(31),'
        '    FK_NAME varchar(31),'
        '    TABLE_O varchar(31),'
        '    DELETE_CASCATA smallint,'
        '    UPDATE_CASCATA smallint,'
        '    INDEX_POS integer)'
        'as'
        'begin'
        
          '  for select distinct trim(CONSTRAINTSDESTINO.RDB$RELATION_NAME)' +
          ' as TABLE_REF, trim(RDB$CONST_NAME_UQ) as PK_NAME,'
        
          '                      trim(INDICES.RDB$FIELD_NAME) as FIELDNAME,' +
          ' trim(CONSTRAINTSORIGEM.RDB$CONSTRAINT_NAME) as FK_NAME,'
        
          '                      trim(CONSTRAINTSORIGEM.RDB$RELATION_NAME) ' +
          'as TABLE_O,'
        
          '                      iif(RELACIONAMENTOS.RDB$DELETE_RULE = '#39'CAS' +
          'CADE'#39', 1, 0) DELETE_CASCATA,'
        
          '                      iif(RELACIONAMENTOS.RDB$UPDATE_RULE = '#39'CAS' +
          'CADE'#39', 1, 0) UPDATE_CASCATA,'
        '                      INDICES.RDB$FIELD_POSITION'
        
          '      from RDB$RELATION_CONSTRAINTS CONSTRAINTSORIGEM, RDB$RELAT' +
          'ION_CONSTRAINTS CONSTRAINTSDESTINO, RDB$INDEX_SEGMENTS INDICES, ' +
          'RDB$REF_CONSTRAINTS RELACIONAMENTOS'
        '      where CONSTRAINTSORIGEM.RDB$RELATION_NAME = :TABELA and'
        
          '            CONSTRAINTSORIGEM.RDB$CONSTRAINT_TYPE = '#39'FOREIGN KEY' +
          #39' and'
        
          '            CONSTRAINTSORIGEM.RDB$INDEX_NAME = INDICES.RDB$INDEX' +
          '_NAME and'
        
          '            CONSTRAINTSORIGEM.RDB$CONSTRAINT_NAME = RELACIONAMEN' +
          'TOS.RDB$CONSTRAINT_NAME and'
        
          '            RELACIONAMENTOS.RDB$CONST_NAME_UQ = CONSTRAINTSDESTI' +
          'NO.RDB$CONSTRAINT_NAME'
        
          '      order by CONSTRAINTSDESTINO.RDB$RELATION_NAME, CONSTRAINTS' +
          'ORIGEM.RDB$CONSTRAINT_NAME, INDICES.RDB$FIELD_POSITION'
        
          '        into :TABLE_REF, :PK_NAME, :FIELDNAME, :FK_NAME, :TABLE_' +
          'O, :DELETE_CASCATA, :UPDATE_CASCATA, :INDEX_POS'
        '  do'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_FIELDS_ALL ('
        '    TABELA varchar(31))'
        'returns ('
        '    NAME varchar(31),'
        '    NTYPE smallint,'
        '    SUBTYPE smallint,'
        '    FTYPE varchar(32),'
        '    FSIZE integer,'
        '    ISPK smallint,'
        '    ISFK smallint,'
        '    FPOSITION integer)'
        'as'
        'begin'
        '  TABELA = upper(trim(TABELA));'
        
          '  for select distinct T.FIELDNAME, T.FTYPE, T.SUBTYPE, T.FIELDTY' +
          'PE, T.FIELDSIZE, T.FIELPOSITION,'
        
          '                      iif(T.FIELDNAME = PK.FIELDNAME, 1, 0) ISPK' +
          ', iif(T.FIELDNAME = FK.FIELDNAME, 1, 0) ISFK'
        
          '      from (select trim(RF.RDB$FIELD_NAME) FIELDNAME, trim(F.RDB' +
          '$FIELD_TYPE) FTYPE, F.RDB$FIELD_SUB_TYPE SUBTYPE,'
        '                   case F.RDB$FIELD_TYPE'
        '                     when 7 then case F.RDB$FIELD_SUB_TYPE'
        '                                   when 0 then '#39'SMALLINT'#39
        '                                   when 1 then '#39'NUMERIC'#39
        '                                   when 2 then '#39'DECIMAL'#39
        '                                 end'
        '                     when 8 then case F.RDB$FIELD_SUB_TYPE'
        '                                   when 0 then '#39'INTEGER'#39
        '                                   when 1 then '#39'NUMERIC'#39
        '                                   when 2 then '#39'DECIMAL'#39
        '                                 end'
        '                     when 10 then '#39'FLOAT'#39
        '                     when 12 then '#39'DATE'#39
        '                     when 13 then '#39'TIME'#39
        '                     when 14 then '#39'VARCHAR'#39
        '                     when 16 then case F.RDB$FIELD_SUB_TYPE'
        '                                    when 0 then '#39'BIGINT'#39
        '                                    when 1 then '#39'NUMERIC'#39
        '                                    when 2 then '#39'DECIMAL'#39
        '                                  end'
        '                     when 27 then '#39'DOUBLE'#39
        '                     when 35 then '#39'TIMESTAMP'#39
        '                     when 37 then '#39'VARCHAR'#39
        
          '                     when 261 then '#39'BLOB '#39' || F.RDB$FIELD_SUB_TY' +
          'PE'
        '                     else F.RDB$FIELD_TYPE || '#39'?'#39
        '                   end FIELDTYPE,'
        
          '                   trunc(F.RDB$FIELD_LENGTH / CH.RDB$BYTES_PER_C' +
          'HARACTER) FIELDSIZE,'
        '                   RF.RDB$FIELD_POSITION FIELPOSITION'
        '            from RDB$RELATION_FIELDS RF'
        
          '              join RDB$FIELDS F on (F.RDB$FIELD_NAME = RF.RDB$FI' +
          'ELD_SOURCE)'
        
          '              left outer join RDB$CHARACTER_SETS CH on (CH.RDB$C' +
          'HARACTER_SET_ID = F.RDB$CHARACTER_SET_ID)'
        '            where (RF.RDB$RELATION_NAME = :TABELA) and'
        '                  (coalesce(RF.RDB$SYSTEM_FLAG, 0) = 0) and'
        '                  (F.RDB$COMPUTED_SOURCE is null)'
        '            order by RF.RDB$FIELD_POSITION) as T'
        '        left join SPDB_FIELDS_PK(:TABELA) PK on 1 = 1 and'
        '              PK.FIELDNAME = T.FIELDNAME'
        '        left join SPDB_FIELDS_FK(:TABELA) FK on 1 = 1 and'
        '              FK.FIELDNAME = T.FIELDNAME'
        '      order by T.FIELPOSITION'
        
          '        into :NAME, :NTYPE, :SUBTYPE, :FTYPE, :FSIZE, :FPOSITION' +
          ', :ISPK, :ISFK'
        '  do'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_EMP_KEY ('
        '    TABELA varchar(31))'
        'returns ('
        '    CAMPO_EMP varchar(31))'
        'as'
        'begin'
        '  select first 1 TRIM(SG.RDB$FIELD_NAME) as FIELD_NAME'
        '  from RDB$RELATION_CONSTRAINTS RC'
        
          '    inner join RDB$INDICES IX on RC.RDB$INDEX_NAME = IX.RDB$INDE' +
          'X_NAME'
        
          '    inner join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NAME = SG.R' +
          'DB$INDEX_NAME'
        '    where RC.RDB$CONSTRAINT_TYPE = '#39'PRIMARY KEY'#39' and'
        '          SG.RDB$FIELD_NAME like '#39'%COD%EMP%'#39' and'
        '          RC.RDB$RELATION_NAME = trim(upper(:TABELA))'
        '    order by SG.RDB$FIELD_POSITION'
        '      into :CAMPO_EMP;'
        '  CAMPO_EMP = trim(coalesce(CAMPO_EMP, '#39#39'));'
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE SINCOFF_SCHEMA ('
        '    ID           INTEGER NOT NULL,'
        '    TABELA       VARCHAR(31) NOT NULL,'
        '    EMPRESAS_ID  VARCHAR(256),'
        '    CAMPOS       BLOB SUB_TYPE 1 SEGMENT SIZE 512,'
        '    ATIVO        SMALLINT DEFAULT 1'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE SINCOFF_SCHEMA ADD CONSTRAINT PK_SINCOFF_SCHEMA PRIM' +
          'ARY KEY (ID);'
        'CREATE INDEX IDX_SINCOFF_TABLE ON SINCOFF_SCHEMA (TABELA);'
        ''
        '|BLOCO|'
        'create or alter trigger TI_SINCOFF_SCHEMA_BIU for SINCOFF_SCHEMA'
        'active before insert or update or delete position 0'
        'as'
        '  declare variable EXISTE integer;'
        '  declare variable CAMPO_E varchar(31);'
        'begin'
        '  if (inserting) then'
        '  begin'
        '    select max(ID) + 1'
        '    from SINCOFF_SCHEMA'
        '      into new.ID;'
        ''
        '    if (new.ID is null) then'
        '      new.ID = 1;'
        ''
        '    select count(EMPDESVOLV.DADOS_OFFLINE)'
        '    from EMPDESVOLV'
        '    where EMPDESVOLV.COD_EMPDES = 1 and'
        '          EMPDESVOLV.DADOS_OFFLINE in ('#39'S'#39', '#39'C'#39')'
        '      into :EXISTE;'
        ''
        '    if (coalesce(EXISTE, 0) = 0) then'
        '      exception EXC_SO_NO_CONF;'
        '  end'
        ''
        '  if (updating) then'
        '    if ((old.TABELA <> new.TABELA) or (old.ID <> new.ID)) then'
        '      exception EXC_RI_TAB_ALT_NOT_ALLOW;'
        ''
        '  if (not deleting) then'
        '  begin'
        '    --new.empresas_id = coalesce(new.empresas_id, '#39'0'#39');'
        '    new.TABELA = upper(trim(coalesce(new.TABELA, '#39#39')));'
        '    new.ATIVO = coalesce(new.ATIVO, 1);'
        
          '    new.CAMPOS = iif(new.CAMPOS is null, null, upper(replace(new' +
          '.CAMPOS, '#39' '#39', '#39#39')));'
        ''
        '    if (new.TABELA in ('#39'CODIGO'#39')) then'
        '      exception EXC_SO_TAB_NOTREP;'
        ''
        '    select count(T.TABELA)'
        '    from SPDB_TABLES T'
        '    where T.TABELA = new.TABELA'
        '      into :EXISTE;'
        ''
        '    if (EXISTE = 0) then'
        '      exception EXC_RI_TAB_NOT_EXISTS;'
        ''
        '    select E.CAMPO_EMP'
        '    from SPDB_EMP_KEY(new.TABELA) E'
        '      into :CAMPO_E;'
        ''
        '    if (CAMPO_E = '#39#39') then'
        '      new.EMPRESAS_ID = null;'
        ''
        '    if (CAMPO_E <> '#39#39') then'
        '      if (coalesce(new.EMPRESAS_ID, '#39#39') = '#39#39') then'
        '        exception EXC_SINCOFF_SCHEMA_EMP_ID_EMPTY;'
        '  end'
        '  else'
        
          '  if (old.TABELA in ('#39'NFCE'#39', '#39'NFCE_DEST'#39', '#39'NFCE_INFADIC'#39', '#39'NFCE_' +
          'ITEM'#39', '#39'NFCE_PAGAMENTO'#39', '#39'NFCE_MOVIMENTO'#39', '#39'NFCE_MOVIMENTO_LANC'#39 +
          ', '#39'CLIENTES'#39', '#39'PRODUTOS'#39', '#39'GRADE'#39','
        '                     '#39'COD_GRADE_PROD'#39', '#39'PEDVENDA'#39')) then'
        '    exception EXC_SO_DEL_TABS_NFCE;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE SINCOFF_SCHEMA_EMP ('
        '    EMPRESA_ID  INTEGER NOT NULL,'
        '    TABELA      VARCHAR(31) NOT NULL,'
        '    ORDEM       SMALLINT'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE SINCOFF_SCHEMA_EMP ADD CONSTRAINT PK_SINCOFF_SCHEMA_' +
          'EMP PRIMARY KEY (EMPRESA_ID, TABELA);'
        'CREATE GENERATOR SEQ_SINCOFF_DEL;'
        ''
        '|BLOCO|'
        'CREATE TABLE SINCOFF_DEL ('
        '    ID          BIGINT NOT NULL,'
        '    EMPRESA_ID  INTEGER NOT NULL,'
        '    TABELA      VARCHAR(31) NOT NULL,'
        '    CAMPOS_PK   BLOB SUB_TYPE 1 SEGMENT SIZE 64,'
        '    VALUES_PK   BLOB SUB_TYPE 1 SEGMENT SIZE 128'
        ');'
        '|/BLOCO|'
        ''
        'ALTER TABLE SINCOFF_DEL ADD PRIMARY KEY (ID);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_SINCOFF_DEL FOR SINCOFF_DEL'
        'ACTIVE BEFORE INSERT POSITION 0'
        'as'
        'begin'
        '  new.id = next value for seq_sincoff_del;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_GUID ('
        '    TIPO smallint = 0)'
        'returns ('
        '    GUID char(36))'
        'as'
        'begin'
        '  select UUID_TO_CHAR(gen_uuid()) from RDB$DATABASE into GUID;'
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger RI_SCHEMA_TAB_BIU_CHECK for RI_SCHEMA_TA' +
          'B'
        'active before insert or update or delete position 0'
        'as'
        '  declare variable EMPID integer;'
        '  declare variable CONT integer;'
        '  declare variable CAMPO_E varchar(31);'
        'begin'
        '  if (updating) then'
        
          '    if ((old.TABELA <> new.TABELA) or (old.SCHEMA_ID <> new.SCHE' +
          'MA_ID)) then'
        '      exception EXC_RI_TAB_ALT_NOT_ALLOW;'
        ''
        '  if (not deleting) then'
        '  begin'
        '    select E.CAMPO_EMP'
        '    from SPDB_EMP_KEY(new.TABELA) E'
        '      into :CAMPO_E;'
        ''
        '    if (CAMPO_E = '#39#39') then'
        '      exception EXC_RI_TAB_FEMP_NOT_EXISTS;'
        ''
        '    delete from TAB_REP'
        '    where TABELA = new.TABELA;'
        ''
        '    for select count(SN.TABELA)'
        '        from SPRI_TABLES_NOTREP SN'
        '        where SN.TABELA = new.TABELA'
        '          into :CONT'
        '    do'
        '      if (CONT >= 1) then'
        '        exception EXC_RI_TAB_NOTREP;'
        ''
        '    for select EMPRESA_ID'
        '        from RI_SCHEMA_EMP E'
        '        where E.SCHEMA_ID = new.SCHEMA_ID'
        '          into :EMPID'
        '    do'
        '    begin'
        '      for select count(*)'
        '          from RI_SCHEMA S'
        '            inner join RI_SCHEMA_TAB T on T.SCHEMA_ID = S.ID'
        '            inner join RI_SCHEMA_EMP E on E.SCHEMA_ID = S.ID'
        '            inner join EMPRESA N on N.COD_EMPRESA = E.EMPRESA_ID'
        '          where E.EMPRESA_ID = :EMPID and'
        '                T.TABELA = new.TABELA and'
        '                T.SCHEMA_ID <> new.SCHEMA_ID'
        '            into :CONT'
        '      do'
        '        if (CONT >= 1) then'
        '          exception EXC_RI_DUPLICIDADE;'
        '    end'
        '  end'
        ''
        '  if (inserting) then'
        '  begin'
        '    select max(ID) + 1'
        '    from RI_SCHEMA_TAB'
        '      into new.ID;'
        ''
        '    if (new.ID is null) then'
        '      new.ID = 1;'
        '  end'
        ''
        '  new.TIPO_ID = coalesce(new.TIPO_ID, 0);'
        ''
        '  if (not new.TIPO_ID in (0, 1)) then'
        '    new.TIPO_ID = 0;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger TI_RI_TAB_BIU for RI_TAB'
        'active before insert or update or delete position 0'
        'as'
        '  declare variable EXISTE integer;'
        '  declare variable CAMPO_E varchar(31);'
        'begin'
        '  if (inserting) then'
        '  begin'
        '    select max(ID) + 1'
        '    from RI_TAB'
        '      into new.ID;'
        ''
        '    if (new.ID is null) then'
        '      new.ID = 1;'
        ''
        '    select UUID_TO_CHAR(gen_uuid())'
        '    from RDB$DATABASE'
        '      into new.GUIDT;'
        '  end'
        ''
        '  if (updating) then'
        '    if ((old.TABELA <> new.TABELA) or (old.ID <> new.ID)) then'
        '      exception EXC_RI_TAB_ALT_NOT_ALLOW;'
        ''
        '  if ((inserting) or (updating)) then'
        '  begin'
        '    select count(T.TABELA)'
        '    from SPDB_TABLES T'
        '    where T.TABELA = new.TABELA'
        '      into :EXISTE;'
        ''
        '    if (EXISTE = 0) then'
        '      exception EXC_RI_TAB_NOT_EXISTS;'
        '  end'
        ''
        '  if (deleting) then'
        '  begin'
        '    select count(T.TABELA)'
        '    from RI_SCHEMA_TAB T'
        '    where T.TABELA = old.TABELA'
        '      into :EXISTE;'
        ''
        '    if (EXISTE > 0) then'
        '      exception EXC_RI_TAB_SCHEMA_EXIST;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SPRI_EXEC'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_MAKE_OBJ ('
        '    TABELA varchar(31),'
        '    CAMPOS blob sub_type 1 segment size 512,'
        '    REMOVER smallint = 0)'
        'as'
        '  declare variable TABLE_ID integer;'
        '  declare variable STMTTR blob sub_type 1 segment size 256;'
        '  declare variable TRNAME varchar(31);'
        '  declare variable FNAME varchar(31);'
        '  declare variable IDXNAME varchar(31);'
        '  declare variable FEMPNAME varchar(31);'
        '  declare variable SEQNAME varchar(31);'
        '  declare variable PART_VAREMPS blob sub_type 1 segment size 32;'
        '  declare variable PART_TESTEMP blob sub_type 1 segment size 32;'
        '  declare variable PART_EMPRESA blob sub_type 1 segment size 32;'
        '  declare variable PART_SEQID blob sub_type 1 segment size 32;'
        
          '  declare variable PART_CAMPOS_PK blob sub_type 1 segment size 6' +
          '4;'
        
          '  declare variable PART_VALUES_PK blob sub_type 1 segment size 6' +
          '4;'
        '  declare variable PART_COMPARE blob sub_type 1 segment size 64;'
        '  declare variable PART_ELSE blob sub_type 1 segment size 64;'
        '  declare variable PART_TEST blob sub_type 1 segment size 64;'
        
          '  declare variable PART_PARAM_EMP1 blob sub_type 1 segment size ' +
          '32;'
        
          '  declare variable PART_PARAM_EMP2 blob sub_type 1 segment size ' +
          '32;'
        
          '  declare variable PART_TEST_REPL blob sub_type 1 segment size 3' +
          '2;'
        'begin'
        '  TABELA = trim(upper(TABELA));'
        
          '  CAMPOS = iif (CAMPOS is null, '#39#39', upper(replace(CAMPOS, '#39' '#39', '#39 +
          #39')));'
        ''
        '  update or insert into RI_TAB (TABELA)'
        '  values (:TABELA)'
        '  matching (TABELA);'
        ''
        '  select T.ID, E.CAMPO_EMP'
        '  from RI_TAB T'
        '    left join SPDB_EMP_KEY(T.TABELA) E on 1 = 1'
        '  where T.TABELA = :TABELA'
        '    into :TABLE_ID, :FEMPNAME;'
        ''
        '  TRNAME = '#39'TI_SO_'#39' ||(select RESULT'
        '                       from STRZERO(:TABLE_ID, 3));'
        '  SEQNAME = '#39'SEQ_SO_'#39' ||(select RESULT'
        '                         from STRZERO(:TABLE_ID, 3));'
        '  IDXNAME = '#39'IDX_SO_'#39' ||(select RESULT'
        '                         from STRZERO(:TABLE_ID, 3));'
        ''
        '  if (REMOVER = 1) then'
        '  begin'
        '    FNAME = '#39#39';'
        ''
        '    select count(ID)'
        '    from SINCOFF_SCHEMA'
        '    where TABELA = :TABELA AND'
        '          ATIVO = 1'
        '      into :TABLE_ID;'
        ''
        '    if (coalesce(TABLE_ID, 0) = 0) then'
        '    begin'
        '      select trim(TG.RDB$TRIGGER_NAME)'
        '      from RDB$TRIGGERS TG'
        '      where TG.RDB$RELATION_NAME = :TABELA and'
        '            TG.RDB$TRIGGER_NAME = :TRNAME and'
        '            TG.RDB$SYSTEM_FLAG = 0'
        '        into :FNAME;'
        ''
        '      if (FNAME = TRNAME) then'
        '        STMTTR = '#39'DROP TRIGGER '#39' || TRNAME;'
        '      else'
        
          '        STMTTR = '#39'DROP TRIGGER '#39' || TRNAME || '#39' - trigger not ex' +
          'ists'#39';'
        ''
        '      insert into RI_TMP_SQL (SQLEXEC)'
        '      values (:STMTTR);'
        ''
        '      if (FNAME = TRNAME) then'
        '        execute statement STMTTR;'
        '      exit;'
        '    end'
        '    else'
        '      REMOVER = 0;'
        '  end'
        ''
        '  select FIELDNAME'
        '    from SPDB_FIELDS(:TABELA)'
        '    where FIELDNAME = '#39'SEQID_SINCOFF'#39
        '      into :FNAME;'
        '  if (trim(upper(coalesce(FNAME, '#39#39'))) <> '#39'SEQID_SINCOFF'#39') then'
        '  begin'
        
          '    execute statement '#39'ALTER TABLE '#39' || :TABELA || '#39' ADD SEQID_S' +
          'INCOFF BIGINT;'#39';'
        
          '    execute statement '#39'CREATE INDEX '#39' || :IDXNAME || '#39' ON '#39' || :' +
          'TABELA ||'#39' (SEQID_SINCOFF'#39' || iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', ' +
          #39', '#39'  || :FEMPNAME, '#39#39') || '#39');'#39';'
        '  end   '
        ''
        '  select RDB$GENERATOR_NAME'
        '    from RDB$GENERATORS'
        '    where RDB$GENERATOR_NAME = :SEQNAME'
        '      into :FNAME;'
        '  if (trim(upper(coalesce(FNAME, '#39#39'))) <> SEQNAME) then'
        '    execute statement '#39'CREATE SEQUENCE '#39' || :SEQNAME || '#39';'#39';'
        ''
        
          '  PART_VAREMPS = iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', '#39'  declare va' +
          'riable EMPRESAS_ID varchar(256);'#39' || ascii_char(13), '#39#39');'
        
          '  PART_EMPRESA = trim(iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', '#39'iif(del' +
          'eting, old.@FEMPNAME, new.@FEMPNAME)'#39', '#39'0'#39'));'
        
          '  PART_SEQID = '#39'new.SEQID_SINCOFF = next value for '#39' || SEQNAME ' +
          '|| '#39';'#39';'
        
          '  PART_PARAM_EMP1 = trim(iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', '#39'SO.E' +
          'MPRESAS_ID, '#39', '#39#39'));'
        
          '  PART_PARAM_EMP2 = trim(iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', '#39':EMP' +
          'RESAS_ID, '#39', '#39#39'));'
        ''
        
          '  PART_TESTEMP = trim(iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', ascii_ch' +
          'ar(13) ||'
        
          '                 '#39'  if (replace('#39#39','#39#39' || EMPRESAS_ID || '#39#39','#39#39', '#39 +
          #39' '#39#39', '#39#39#39#39') not containing '#39#39','#39#39' || EMPRESA_ID || '#39#39','#39#39') then'#39' |' +
          '| ascii_char(13) ||'
        '                 '#39'    exit;'#39' || ascii_char(13),'
        '                 '#39#39'));'
        
          '--                 '#39'if (coalesce(EMPRESA_ID, -1) = -1) then'#39' || ' +
          'ascii_char(13) ||'
        '--                 '#39'    exit;'#39'));'
        '  PART_CAMPOS_PK = '#39#39';'
        '  PART_VALUES_PK = '#39#39';'
        '  PART_COMPARE = '#39#39';'
        ''
        '  for select FIELDNAME'
        '      from SPDB_FIELDS_PK(:TABELA)'
        '        into :FNAME'
        '  do'
        '  begin'
        '    if (PART_CAMPOS_PK <> '#39#39') then'
        '    begin'
        '      PART_CAMPOS_PK = PART_CAMPOS_PK || '#39','#39';'
        
          '      PART_VALUES_PK = PART_VALUES_PK || '#39' || '#39#39#184#39#39' || '#39'; -- nao' +
          ' e virgula, e o caracter 247 da tabela ascii'
        '      PART_COMPARE = PART_COMPARE || '#39' or '#39' || ascii_char(13);'
        '    end'
        '    PART_CAMPOS_PK = PART_CAMPOS_PK || FNAME;'
        '    PART_VALUES_PK = PART_VALUES_PK || '#39'old.'#39' || FNAME;'
        
          '    PART_COMPARE = PART_COMPARE || '#39'    (old.'#39' || FNAME || '#39' <> ' +
          'new.'#39' || FNAME || '#39')'#39';'
        '  end'
        ''
        '  for select FIELDNAME'
        '      from SPDB_FIELDS(:TABELA)'
        '      where FIELDNAME = '#39'GUIDT'#39
        '        into :FNAME'
        '  do'
        '  begin'
        '    PART_CAMPOS_PK = FNAME;'
        '    PART_VALUES_PK = '#39'old.'#39' || FNAME;'
        '  end'
        ''
        '  CAMPOS = replace(coalesce(CAMPOS, '#39#39'), '#39' '#39', '#39#39');'
        ''
        '  if (CAMPOS <> '#39#39') then'
        '  begin'
        
          '    PART_TEST = '#39','#39' || replace(coalesce(CAMPOS, '#39#39'), '#39' '#39', '#39#39') ||' +
          ' '#39','#39';'
        '    PART_TEST = replace(upper(PART_TEST), '#39','#39', '#39',,'#39');'
        '    for select FIELDNAME'
        '        from SPDB_FIELDS(:TABELA)'
        '          into :FNAME'
        '    do'
        '    begin'
        
          '      PART_TEST = replace(PART_TEST, '#39','#39' || upper(FNAME) || '#39','#39',' +
          ' '#39#39');'
        '    end'
        ''
        '    --  part_test2 = trim(replace(part_test, '#39',,'#39', '#39','#39'));'
        '    PART_TEST = trim(replace(PART_TEST, '#39','#39', '#39#39'));'
        '    if (PART_TEST <> '#39#39') then'
        '      exception EXC_SINCOFF_FIELDNOTFOUND;'
        ''
        '    if (CAMPOS starting with '#39','#39') then'
        
          '      CAMPOS = substring(CAMPOS from 2 for char_length(CAMPOS) -' +
          ' 1);'
        '    if (reverse(CAMPOS) starting with '#39','#39') then'
        
          '      CAMPOS = substring(CAMPOS from 1 for char_length(CAMPOS) -' +
          ' 1);'
        '    CAMPOS = '#39#39#39#39' || replace(CAMPOS, '#39','#39', '#39#39#39','#39#39#39') || '#39#39#39#39';'
        ''
        
          '    PART_TEST = '#39'select FIELDNAME from spdb_fields('#39#39#39' || :TABEL' +
          'A || '#39#39#39') where FIELDNAME in ('#39' || :CAMPOS || '#39')'#39';'
        ''
        '    for execute statement PART_TEST'
        '            into :FNAME'
        '    do'
        '    begin'
        '      if (PART_COMPARE <> '#39#39') then'
        '        PART_COMPARE = PART_COMPARE || '#39' or '#39' || ascii_char(13);'
        
          '      PART_COMPARE = PART_COMPARE || '#39'    (old.'#39' || FNAME || '#39' <' +
          '> new.'#39' || FNAME || '#39')'#39';'
        '    end'
        ''
        '    PART_ELSE = '#39'  else if (inserting'#39' ||'
        
          '                rtrim(iif(TABELA in ('#39'PRODUTOS'#39', '#39'COD_GRADE_PROD' +
          #39'),'
        
          '                    '#39' or (new.SEQID_SINCOFF is null)'#39', '#39#39')) || '#39 +
          ') then'#39' || ascii_char(13) ||'
        '                '#39'    '#39' || PART_SEQID || ascii_char(13) ||'
        '                '#39'  else if ('#39' || ascii_char(13) ||'
        '                PART_compare || ascii_char(13) ||'
        '                '#39'  ) then'#39';'
        '  end'
        '  else'
        '    PART_ELSE = '#39'  else'#39';'
        ''
        
          '  PART_ELSE = PART_ELSE || ascii_char(13) || '#39'    '#39' || PART_SEQI' +
          'D;'
        ''
        
          '  PART_TEST_REPL = '#39'  if (substring(user from 1 for 4) = '#39#39'REPL'#39 +
          #39') then'#39' || ascii_char(13) ||'
        '                   iif(TABELA in ('#39'PRODUTOS'#39', '#39'COD_GRADE_PROD'#39'),'
        
          '                   '#39'    if (deleting or (new.SEQID_SINCOFF is no' +
          't null)) then'#39' ||  ascii_char(13) || '#39'  '#39', '#39#39') ||'
        '                   '#39'    exit;'#39' || ascii_char(13);'
        ''
        
          '  STMTTR = '#39'CREATE OR ALTER TRIGGER @TRNAME FOR @TBNAME'#39' || asci' +
          'i_char(13) ||'
        
          '           '#39'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 99' +
          '9'#39' || ascii_char(13) ||'
        '           '#39'as'#39' || ascii_char(13) ||'
        '           '#39'@PART_VAREMPS@'#39' ||'
        
          '           '#39'  declare variable EMPRESA_ID integer;'#39' || ascii_cha' +
          'r(13) ||'
        
          '           '#39'  declare variable TABELA varchar(31);'#39' || ascii_cha' +
          'r(13) ||'
        '           '#39'begin'#39' || ascii_char(13) ||'
        '           '#39'@PART_TEST_REPL@'#39' ||'
        '           '#39#39' || ascii_char(13) ||'
        '           '#39'  EMPRESA_ID = @PART_EMPRESA@;'#39' || ascii_char(13) ||'
        '           '#39'  TABELA = '#39#39'@TBNAME'#39#39';'#39' || ascii_char(13) ||'
        '           '#39#39' || ascii_char(13) ||'
        
          '           '#39'  select @PART_PARAM_EMP1@'#39'|| '#39'SO.TABELA'#39' || ascii_c' +
          'har(13) ||'
        '           '#39'    from SINCOFF_SCHEMA SO'#39' || ascii_char(13) ||'
        '           '#39'    where SO.TABELA = :TABELA'#39' || ascii_char(13) ||'
        
          '           '#39'      into @PART_PARAM_EMP2@'#39'||'#39':TABELA;'#39' || ascii_c' +
          'har(13) ||'
        '           '#39#39' || ascii_char(13) ||'
        
          '           '#39'  if (TABELA <> '#39#39'@TBNAME'#39#39') then'#39' || ascii_char(13)' +
          ' ||'
        '           '#39'    exit;'#39' || ascii_char(13) ||'
        '           '#39#39' ||'
        '           '#39'@PART_TESTEMP@'#39' || ascii_char(13) ||'
        '           '#39'  if (deleting) then'#39' || ascii_char(13) ||'
        '           '#39'  begin'#39' || ascii_char(13) ||'
        
          '           '#39'    insert into SINCOFF_DEL (EMPRESA_ID, TABELA, CAM' +
          'POS_PK, VALUES_PK)'#39' || ascii_char(13) ||'
        
          '           '#39'    values (:EMPRESA_ID, :TABELA,'#39' || ascii_char(13)' +
          ' ||'
        
          '           '#39'            '#39#39'@PART_CAMPOS_PK@'#39#39','#39' || ascii_char(13)' +
          ' ||'
        '           '#39'            @PART_VALUES_PK@);'#39' || ascii_char(13) ||'
        '           '#39'  end'#39' || ascii_char(13) ||'
        '           '#39'@PART_ELSE@'#39' || ascii_char(13) ||'
        '           '#39'end'#39';'
        ''
        '  STMTTR = replace(STMTTR, '#39'@TRNAME'#39', :TRNAME);'
        '  STMTTR = replace(STMTTR, '#39'@TBNAME'#39', :TABELA);'
        '  STMTTR = replace(STMTTR, '#39'@PART_VAREMPS@'#39', :PART_VAREMPS);'
        '  STMTTR = replace(STMTTR, '#39'@PART_EMPRESA@'#39', :PART_EMPRESA);'
        
          '  STMTTR = replace(STMTTR, '#39'@PART_PARAM_EMP1@'#39', :PART_PARAM_EMP1' +
          ');'
        
          '  STMTTR = replace(STMTTR, '#39'@PART_PARAM_EMP2@'#39', :PART_PARAM_EMP2' +
          ');'
        '  STMTTR = replace(STMTTR, '#39'@PART_TESTEMP@'#39', :PART_TESTEMP);'
        '  STMTTR = replace(STMTTR, '#39'@PART_CAMPOS_PK@'#39', :PART_CAMPOS_PK);'
        
          '  STMTTR = replace(STMTTR, '#39'@PART_VALUES_PK@'#39', :PART_VALUES_PK);' +
          ' '
        '  STMTTR = replace(STMTTR, '#39'@PART_ELSE@'#39', :PART_ELSE);'
        '  STMTTR = replace(STMTTR, '#39'@PART_TEST_REPL@'#39', :PART_TEST_REPL);'
        '  STMTTR = replace(STMTTR, '#39'@FEMPNAME'#39', :FEMPNAME);'
        ''
        '  insert into RI_TMP_SQL (SQLEXEC)'
        '  values (:STMTTR);'
        ''
        '  execute statement STMTTR;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_MAKE_DEP_RECURSIVE ('
        '    TABELA varchar(31),'
        '    COMEMPRESA integer = 0)'
        'returns ('
        '    RESULT integer)'
        'as'
        '  declare variable TAB_REL varchar(31);'
        '  declare variable MAXID integer;'
        '  declare variable EXISTE integer;'
        'begin'
        ''
        '  for select distinct RF.RDB$RELATION_NAME TAB_REF'
        '      from RDB$INDICES IX'
        
          '        left join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NAME = S' +
          'G.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RC on RC.RDB$INDEX_NA' +
          'ME = IX.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RF on RF.RDB$INDEX_NA' +
          'ME = IX.RDB$FOREIGN_KEY'
        '      where RC.RDB$CONSTRAINT_TYPE = '#39'FOREIGN KEY'#39' and'
        '            RC.RDB$RELATION_NAME = :TABELA and'
        '            RF.RDB$RELATION_NAME <> :TABELA'
        '        into :TAB_REL'
        '  do'
        '  begin'
        ''
        '    TAB_REL = trim(coalesce(TAB_REL, '#39#39'));'
        ''
        '    EXISTE = 0;'
        '    select count(T.TABELA)'
        '    from RI_DEP T'
        '    where T.TABELA = :TAB_REL'
        '      into :EXISTE;'
        ''
        '    if (coalesce(EXISTE, 0) = 0) then'
        '    begin'
        
          '      select result from SPSO_MAKE_DEP_RECURSIVE(:TAB_REL, :COME' +
          'MPRESA) into :existe;'
        ''
        '      select max(T.ORDEM)'
        '      from RI_DEP T'
        '        into :MAXID;'
        '      MAXID = coalesce(MAXID, 0) + 1;'
        ''
        '      EXISTE = 0;'
        '      if (COMEMPRESA = 0) then'
        '        select count(T.TABELA)'
        '        from SPDB_TABLES T'
        '          left join SPDB_EMP_KEY(T.TABELA) P on 1 = 1'
        '        where T.TABELA = :TAB_REL and'
        '              P.CAMPO_EMP <> '#39#39
        '          into :EXISTE;'
        ''
        '      if ((coalesce(EXISTE, 0) > 0) or (COMEMPRESA = 0)) then'
        '        insert into RI_DEP (ORDEM, TABELA)'
        '        values (:MAXID, :TAB_REL);'
        '    end'
        '  end     '
        ''
        '  result = 1;'
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_MAKE_DEP ('
        '    TABELA varchar(31),'
        '    COMEMPRESA integer = 0)'
        'returns ('
        '    RESULT integer)'
        'as'
        '  declare variable MAXID integer;'
        '  declare variable EXISTE integer;'
        'begin'
        '  select RESULT'
        '  from SPSO_MAKE_DEP_RECURSIVE(:TABELA, :COMEMPRESA)'
        '    into :RESULT;'
        ''
        '  EXISTE = 0;'
        '  select count(T.TABELA)'
        '  from RI_DEP T'
        '  where T.TABELA = :TABELA'
        '    into :EXISTE;'
        ''
        '  if (coalesce(EXISTE, 0) = 0) then'
        '  begin'
        '    select max(T.ORDEM)'
        '    from RI_DEP T'
        '      into :MAXID;'
        '    MAXID = coalesce(MAXID, 0) + 1;'
        '    insert into RI_DEP (ORDEM, TABELA)'
        '    values (:MAXID, :TABELA);'
        '  end'
        '  RESULT = 1;'
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_FILL_SCHEMA'
        'as'
        '  declare variable EMPRESA_ID integer;'
        '  declare variable SEQUENCIA smallint;'
        '  declare variable ISACTIVE smallint;'
        'begin'
        '  delete from RI_DEP;'
        ''
        '  select distinct iif(SO.ID = 0, 1, 1)'
        '  from SINCOFF_SCHEMA SO'
        '    left join SPSO_MAKE_DEP(SO.TABELA) SP on 1 = 1'
        '  order by SO.TABELA'
        '    into :SEQUENCIA;'
        ''
        '  if (coalesce(SEQUENCIA, 0) = 0) then'
        '    exit;'
        ''
        '  for select COD_EMPRESA'
        '      from EMPRESA'
        '        into :EMPRESA_ID'
        '  do'
        '  begin'
        '    delete from SINCOFF_SCHEMA_EMP'
        '    where EMPRESA_ID = :EMPRESA_ID;'
        ''
        '    select count(*)'
        '    from SINCOFF_SCHEMA SO'
        
          '    where '#39','#39' || SO.EMPRESAS_ID || '#39','#39' containing '#39','#39' || :EMPRES' +
          'A_ID || '#39','#39
        '      into :SEQUENCIA;'
        ''
        '    if (coalesce(SEQUENCIA, 0) > 0) then'
        '    begin'
        '      insert into SINCOFF_SCHEMA_EMP (EMPRESA_ID, TABELA, ORDEM)'
        '      select :EMPRESA_ID, C.TABELA, D.ORDEM'
        '      from (select SO.EMPRESAS_ID, SO.TABELA'
        '            from SINCOFF_SCHEMA SO'
        
          '            where (('#39','#39' || SO.EMPRESAS_ID || '#39','#39' containing '#39','#39' ' +
          '|| :EMPRESA_ID || '#39','#39') or (SO.EMPRESAS_ID is null))'
        '            order by SO.TABELA'
        ''
        '      ) as C'
        '        left join RI_DEP D on D.TABELA = C.TABELA'
        '      order by D.ORDEM;'
        '    end'
        '  end'
        '  delete from RI_DEP;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger SINCOFF_SCHEMA_AIUD_MK_OBJ for SINCOFF_S' +
          'CHEMA'
        'active after insert or update or delete position 1'
        'as'
        '  declare variable CAMPOS blob sub_type 1 segment size 512;'
        '  declare variable REMOVER smallint;'
        'begin'
        '  if ((deleting) or (new.ATIVO = 0)) then'
        '  begin'
        '    CAMPOS = '#39#39';'
        '    REMOVER = 1;'
        '  end'
        '  else'
        '  begin'
        '    CAMPOS = new.CAMPOS;'
        '    REMOVER = 0;'
        '  end'
        ''
        
          '  execute procedure SPSO_MAKE_OBJ(iif(deleting, old.TABELA, new.' +
          'TABELA), :CAMPOS, :REMOVER);'
        'end'
        '|/BLOCO|'
        ''
        'CREATE GENERATOR SEQ_RAWDATA;'
        ''
        '|BLOCO|'
        'CREATE GLOBAL TEMPORARY TABLE RAWDATA ('
        '    ID      INTEGER NOT NULL,'
        '    TABELA  VARCHAR(31),'
        '    DATA    BLOB SUB_TYPE 1 SEGMENT SIZE 256 NOT NULL'
        ') ON COMMIT DELETE ROWS;'
        '|/BLOCO|'
        ''
        'CREATE UNIQUE INDEX IDX_RAWDATA ON RAWDATA (ID, TABELA);'
        ''
        '|BLOCO|'
        'create or alter trigger RAWDATA_BI for RAWDATA'
        'active before insert position 0'
        'as'
        'begin'
        '  if (new.ID is null) then'
        '    new.ID = next value for SEQ_RAWDATA;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_TIMESTAMPTOSTR ('
        '    VALOR timestamp,'
        '    DEFVALUE varchar(64) = '#39'0'#39')'
        'returns ('
        '    RESULT varchar(64))'
        'as'
        'begin'
        '  RESULT = VALOR || '#39#39';'
        '  while (reverse(RESULT) starting '#39'0'#39') do'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (reverse(RESULT) starting '#39'.'#39') then'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (RESULT is null) then'
        '    RESULT = DEFVALUE;'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_TIMETOSTR ('
        '    VALOR time,'
        '    DEFVALUE varchar(64) = '#39'0'#39')'
        'returns ('
        '    RESULT varchar(64))'
        'as'
        'begin'
        '  RESULT = VALOR || '#39#39';'
        '  while (reverse(RESULT) starting '#39'0'#39') do'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (reverse(RESULT) starting '#39'.'#39') then'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (RESULT is null) then'
        '    RESULT = DEFVALUE;'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_DOUBLETOSTR ('
        '    VALOR double precision,'
        '    DEFVALUE varchar(64) = '#39'0'#39')'
        'returns ('
        '    RESULT varchar(64))'
        'as'
        'begin'
        '  RESULT = VALOR || '#39#39';'
        '  while (reverse(RESULT) starting '#39'0'#39') do'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (reverse(RESULT) starting '#39'.'#39') then'
        
          '    RESULT = substring(RESULT from 1 for char_length(RESULT) - 1' +
          ');'
        ''
        '  if (RESULT is null) then'
        '    RESULT = DEFVALUE;'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_HANDLESTR ('
        '    VALOR blob sub_type 1 segment size 256,'
        '    SEPARATORREPLACE varchar(8),'
        '    NULLCHARREPLACE varchar(8),'
        '    APOSTREPLACE varchar(8) = null)'
        'returns ('
        '    RESULT blob sub_type 1 segment size 1024)'
        'as'
        'begin'
        '  if (VALOR is null) then'
        '  begin'
        '    RESULT = NULLCHARREPLACE;'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(APOSTREPLACE, '#39#39') <> '#39#39') then'
        '    VALOR = replace(VALOR, '#39#39#39#39', APOSTREPLACE);'
        ''
        '  if (coalesce(SEPARATORREPLACE, '#39#39') <> '#39#39') then'
        '    VALOR = replace(VALOR, SEPARATORREPLACE, '#39#39');'
        ''
        '  while (reverse(VALOR) starts with '#39' '#39') do'
        '    VALOR = substring(VALOR from 1 for char_length(VALOR) - 1);'
        ''
        '  RESULT = VALOR;'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_GENERICDATA ('
        '    TABELA varchar(31),'
        '    EMPRESA_ID integer,'
        '    CAIXA_ID integer,'
        '    LIMIT integer,'
        '    SKIPS integer,'
        '    SEQID integer,'
        '    SEP varchar(8) = '#39#184#39','
        '    NULLC varchar(8) = '#39#161#39','
        '    APOSTREPLACE varchar(8) = '#39#177#39')'
        'as'
        '  declare variable TBNAME varchar(31);'
        '  declare variable FEMPNAME varchar(31);'
        '  declare variable FNAME varchar(64);'
        '  declare variable FTYPE varchar(31);'
        '  declare variable SQL blob sub_type 1 segment size 512;'
        '  declare variable FIELDSSQL blob sub_type 1 segment size 512;'
        '  declare variable CAMPOS blob sub_type 1 segment size 512;'
        '  declare variable EMPRESAS_ID varchar(256);'
        '  declare variable FIELDS blob sub_type 1 segment size 256;'
        '  declare variable INNERSQL blob sub_type 1 segment size 256;'
        '  declare variable WHERESQL blob sub_type 1 segment size 64;'
        'begin'
        '  TABELA = trim(upper(TABELA));'
        '  SEP = trim(coalesce(SEP, '#39#184#39'));'
        '  NULLC = trim(coalesce(nullc,  '#39#161#39'));'
        '  APOSTREPLACE = trim(coalesce(APOSTREPLACE,  '#39#177#39'));'
        ''
        '  select T.TABELA, SO.CAMPOS, E.CAMPO_EMP, SO.EMPRESAS_ID'
        '  from RI_TAB T'
        '    inner join SINCOFF_SCHEMA SO on SO.TABELA = T.TABELA and'
        '          SO.ATIVO = 1'
        '    left join SPDB_EMP_KEY(T.TABELA) E on 1 = 1'
        '  where T.TABELA = :TABELA'
        '    into :TBNAME, :CAMPOS, :FEMPNAME, :EMPRESAS_ID;'
        ''
        '  if (TBNAME <> TABELA) then'
        '    exit;'
        ''
        '  if (coalesce(FEMPNAME, '#39#39') <> '#39#39') then'
        
          '    if (replace('#39','#39' || EMPRESAS_ID || '#39','#39', '#39' '#39', '#39#39') not containi' +
          'ng '#39','#39' || EMPRESA_ID || '#39','#39') then'
        '      exit;'
        ''
        '  CAMPOS = iif(coalesce(CAMPOS, '#39#39') = '#39#39', '#39'*'#39', CAMPOS);'
        '  CAMPOS = replace(CAMPOS, '#39' '#39', '#39#39');'
        '  CAMPOS = replace(CAMPOS, '#39',,'#39', '#39','#39');'
        ''
        '  while (CAMPOS starting with '#39','#39') do'
        
          '    CAMPOS = substring(CAMPOS from 2 for char_length(CAMPOS) - 1' +
          ');'
        '  while (reverse(CAMPOS) starting with '#39','#39') do'
        
          '    CAMPOS = substring(CAMPOS from 1 for char_length(CAMPOS) - 1' +
          ');'
        ''
        '  FIELDS = CAMPOS;'
        '  CAMPOS = '#39#39#39#39' || replace(CAMPOS, '#39','#39', '#39#39#39','#39#39#39') || '#39#39#39#39';'
        ''
        
          '  SQL = '#39'select NAME, FTYPE from spdb_fields_all('#39#39#39' || :TABELA ' +
          '|| '#39#39#39') '#39' ||'
        
          '        '#39' where trim(FTYPE) <> '#39#39'BLOB 0'#39#39' and trim(NAME) not in ' +
          '('#39#39'REP_INT_ACTIVE'#39#39', '#39#39'SEQID_SINC'#39#39')'#39' ||'
        
          '        '#39' and FTYPE in ('#39#39'SMALLINT'#39#39','#39#39'INTEGER'#39#39','#39#39'BIGINT'#39#39','#39#39'NU' +
          'MERIC'#39#39','#39#39'DECIMAL'#39#39','#39#39'FLOAT'#39#39','#39#39'DOUBLE'#39#39','#39#39'DATE'#39#39','#39#39'TIME'#39#39','#39#39'TIM' +
          'ESTAMP'#39#39','#39#39'VARCHAR'#39#39','#39#39'BLOB 1'#39#39','#39#39'BLOB 2'#39#39')'#39' ||'
        
          '        iif(FIELDS <> '#39'*'#39', '#39' and ((NAME in ('#39' || :CAMPOS || '#39', '#39 +
          #39'GUIDT'#39#39', '#39#39'SEQID_SINCOFF'#39#39')) or (ISPK = 1))'#39', '#39#39');'
        ''
        '  FIELDS = '#39#39';'
        '  FIELDSSQL = '#39#39';'
        '  for execute statement SQL'
        '          into :FNAME, :FTYPE--, :FTYPE2'
        '  do'
        '  begin'
        '    if (FIELDS <> '#39#39') then'
        '    begin'
        '      FIELDS = FIELDS || '#39','#39';'
        
          '      FIELDSSQL = FIELDSSQL || '#39'||'#39#39#39' || SEP || '#39#39#39'||'#39'; -- nao e' +
          ' virgula, e o caracter 247 da tabela ascii'
        '    end'
        '    FIELDS = FIELDS || FNAME;'
        ''
        
          '    if (TABELA in ('#39'NFCE_DEST'#39', '#39'NFCE_INFADIC'#39', '#39'NFCE_ITEM'#39', '#39'NF' +
          'CE_PAGAMENTO'#39', '#39'NFCE_MOVIMENTO_LANC'#39')) then'
        '      FNAME = TABELA || '#39'.'#39' || FNAME;'
        ''
        '    if (FTYPE = '#39'DOUBLE'#39') then'
        
          '      FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_DOUBLETO' +
          'STR('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o caracter 1' +
          '73'
        '    else if (FTYPE = '#39'TIMESTAMP'#39') then'
        
          '      FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_TIMESTAM' +
          'PTOSTR('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o caracte' +
          'r 173'
        '    else if (FTYPE = '#39'TIME'#39') then'
        
          '      FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_TIMETOST' +
          'R('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o caracter 173'
        '    else if (FTYPE in ('#39'VARCHAR'#39', '#39'BLOB 1'#39'))  then'
        
          '      FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_HANDLEST' +
          'R('#39' || FNAME || '#39','#39#39#39' || SEP || '#39#39#39','#39#39#39' || NULLC || '#39#39#39','#39#39#39' || A' +
          'POSTREPLACE || '#39#39#39'))'#39'; -- '#161', e o caracter 247, 173, e 241'
        '    else'
        
          '      FIELDSSQL = FIELDSSQL || '#39'coalesce('#39' || FNAME || '#39','#39#39#39' || ' +
          'NULLC || '#39#39#39')'#39'; -- '#161', e o caracter 173'
        ''
        '  end'
        ''
        '  INNERSQL = '#39#39';'
        '  WHERESQL = '#39#39';'
        
          '  if (TABELA in ('#39'NFCE_DEST'#39', '#39'NFCE_INFADIC'#39', '#39'NFCE_ITEM'#39', '#39'NFCE' +
          '_PAGAMENTO'#39')) then'
        '  begin'
        
          '    INNERSQL = '#39' inner join NFCE on NFCE.COD_NFCE = '#39' || TABELA ' +
          '|| '#39'.COD_NFCE and NFCE.COD_EMPRESA = '#39' || TABELA || '#39'.COD_EMPRES' +
          'A and NFCE.COD_EMISSOR = '#39' || CAIXA_ID;'
        '  end'
        '  else if (TABELA = '#39'NFCE_MOVIMENTO_LANC'#39') then'
        '  begin'
        
          '    INNERSQL = '#39' inner join NFCE_MOVIMENTO on NFCE_MOVIMENTO.ID ' +
          '= NFCE_MOVIMENTO_LANC.MOV_ID and NFCE_MOVIMENTO.COD_EMPRESA = NF' +
          'CE_MOVIMENTO_LANC.COD_EMPRESA and NFCE_MOVIMENTO.COD_EMISSOR = '#39 +
          ' || CAIXA_ID;'
        '  end'
        
          '  else if (TABELA in ('#39'NFCE'#39', '#39'NFCE_MOVIMENTO'#39', '#39'NFC_EMISSOR'#39')) ' +
          'then'
        '  begin'
        
          '    WHERESQL = '#39' and '#39' || TABELA || '#39'.COD_EMISSOR = '#39' || CAIXA_I' +
          'D;'
        '  end'
        ''
        
          '  WHERESQL = iif(coalesce(FEMPNAME, '#39#39') <> '#39#39', '#39' and '#39' || TABELA' +
          ' || '#39'.'#39' || :FEMPNAME || '#39' = '#39' || EMPRESA_ID, '#39#39') || WHERESQL;'
        ''
        
          '  SQL = '#39'select first '#39' || LIMIT || '#39' skip '#39' || SKIPS || '#39' (next' +
          ' value for SEQ_RAWDATA), '#39' || FIELDSSQL || '#39' from '#39' || TABELA ||'
        '        INNERSQL ||'
        
          '        '#39' where '#39' || TABELA || '#39'.SEQID_SINCOFF > '#39' || SEQID || W' +
          'HERESQL || '#39' order by '#39' || TABELA || '#39'.SEQID_SINCOFF'#39';'
        ''
        '  execute statement '#39'alter sequence SEQ_RAWDATA restart with 0'#39';'
        ''
        
          '  execute statement '#39'insert into RAWDATA (ID, DATA) values (0, '#39 +
          #39#39' || FIELDS || '#39#39#39')'#39';'
        ''
        '  execute statement '#39'insert into RAWDATA (ID, DATA) '#39' || SQL;'
        ''
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_SPLIT ('
        '    TEXT_INPUT blob sub_type 1 segment size 80,'
        '    SEPARATOR blob sub_type 1 segment size 80 = '#39','#39','
        '    IGNORE_EMPTYS char(1) = '#39'S'#39')'
        'returns ('
        '    TEXT blob sub_type 1 segment size 80)'
        'as'
        'begin'
        '  while (TEXT_INPUT containing (SEPARATOR)) do'
        '  begin'
        
          '    TEXT = substring(TEXT_INPUT from 1 for (position(SEPARATOR, ' +
          'TEXT_INPUT) - 1));'
        '    if ((TEXT <> '#39#39') or (IGNORE_EMPTYS = '#39'S'#39')) then'
        '      suspend;'
        
          '    TEXT_INPUT = substring(TEXT_INPUT from (position(SEPARATOR, ' +
          'TEXT_INPUT) + char_length(SEPARATOR)) for char_length(TEXT_INPUT' +
          '));'
        '  end'
        '  if (coalesce(TEXT_INPUT, '#39#39') <> '#39#39') then'
        '    if ((TEXT <> '#39#39') or (IGNORE_EMPTYS = '#39'S'#39')) then'
        '    begin'
        '      TEXT = TEXT_INPUT;'
        '      suspend;'
        '    end'
        'end;'
        ''
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_NFCE ('
        '    NFCE_ID integer,'
        '    EMPRESA_ID integer,'
        '    SEP varchar(8) = '#39#184#39','
        '    NULLC varchar(8) = '#39#161#39','
        '    APOSTREPLACE varchar(8) = '#39#177#39')'
        'as'
        '  declare variable FNAME varchar(31);'
        '  declare variable FTYPE varchar(31);'
        '  declare variable SQL blob sub_type 1 segment size 512;'
        '  declare variable FIELDSSQL blob sub_type 1 segment size 512;'
        '  declare variable CAMPOS blob sub_type 1 segment size 512;'
        '  declare variable FIELDS blob sub_type 1 segment size 256;'
        '  declare variable TABELA blob sub_type 1 segment size 80;'
        'begin'
        '  --  TABELA = trim(upper(TABELA));'
        '  SEP = trim(coalesce(SEP, '#39#184#39'));'
        '  NULLC = trim(coalesce(NULLC, '#39#161#39'));'
        '  APOSTREPLACE = trim(coalesce(APOSTREPLACE, '#39#177#39'));'
        ''
        '  for select TEXT'
        
          '      from SP_SPLIT('#39'NFCE,NFCE_DEST,NFCE_ITEM,NFCE_PAGAMENTO,NFC' +
          'E_INFADIC'#39')'
        '        into :TABELA'
        '  do'
        '  begin'
        '    CAMPOS = '#39#39';'
        ''
        '    select SO.CAMPOS'
        '    from RI_TAB T'
        '      inner join SINCOFF_SCHEMA SO on SO.TABELA = T.TABELA and'
        '            SO.ATIVO = 1'
        '    where T.TABELA = :TABELA'
        '      into :CAMPOS;'
        ''
        '    CAMPOS = iif(coalesce(CAMPOS, '#39#39') = '#39#39', '#39'*'#39', CAMPOS);'
        '    CAMPOS = replace(CAMPOS, '#39' '#39', '#39#39');'
        '    CAMPOS = replace(CAMPOS, '#39',,'#39', '#39','#39');'
        ''
        '    while (CAMPOS starting with '#39','#39') do'
        
          '      CAMPOS = substring(CAMPOS from 2 for char_length(CAMPOS) -' +
          ' 1);'
        '    while (reverse(CAMPOS) starting with '#39','#39') do'
        
          '      CAMPOS = substring(CAMPOS from 1 for char_length(CAMPOS) -' +
          ' 1);'
        ''
        '    FIELDS = CAMPOS;'
        '    CAMPOS = '#39#39#39#39' || replace(CAMPOS, '#39','#39', '#39#39#39','#39#39#39') || '#39#39#39#39';'
        ''
        
          '    SQL = '#39'select NAME, FTYPE from spdb_fields_all('#39#39#39' || :TABEL' +
          'A || '#39#39#39') '#39' ||'
        
          '          '#39' where trim(FTYPE) <> '#39#39'BLOB 0'#39#39' and trim(NAME) not i' +
          'n ('#39#39'REP_INT_ACTIVE'#39#39', '#39#39'SEQID_SINC'#39#39')'#39' ||'
        
          '          '#39' and FTYPE in ('#39#39'SMALLINT'#39#39','#39#39'INTEGER'#39#39','#39#39'BIGINT'#39#39','#39#39 +
          'NUMERIC'#39#39','#39#39'DECIMAL'#39#39','#39#39'FLOAT'#39#39','#39#39'DOUBLE'#39#39','#39#39'DATE'#39#39','#39#39'TIME'#39#39','#39#39'T' +
          'IMESTAMP'#39#39','#39#39'VARCHAR'#39#39','#39#39'BLOB 1'#39#39','#39#39'BLOB 2'#39#39')'#39' ||'
        
          '          iif(FIELDS <> '#39'*'#39', '#39' and ((NAME in ('#39' || :CAMPOS || '#39',' +
          ' '#39#39'GUIDT'#39#39', '#39#39'SEQID_SINCOFF'#39#39')) or (ISPK = 1))'#39', '#39#39');'
        ''
        '    FIELDS = '#39#39';'
        '    FIELDSSQL = '#39#39';'
        '    for execute statement SQL'
        '            into :FNAME, :FTYPE'
        '    do'
        '    begin'
        '      if (FIELDS <> '#39#39') then'
        '      begin'
        '        FIELDS = FIELDS || '#39','#39';'
        
          '        FIELDSSQL = FIELDSSQL || '#39'||'#39#39#39' || SEP || '#39#39#39'||'#39'; -- nao' +
          ' e virgula, e o caracter 247 da tabela ascii'
        '      end'
        '      FIELDS = FIELDS || FNAME;'
        '      if (FTYPE = '#39'DOUBLE'#39') then'
        
          '        FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_DOUBLE' +
          'TOSTR('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o caracter' +
          ' 173'
        '      else'
        '      if (FTYPE = '#39'TIMESTAMP'#39') then'
        
          '        FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_TIMEST' +
          'AMPTOSTR('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o carac' +
          'ter 173'
        '      else'
        '      if (FTYPE = '#39'TIME'#39') then'
        
          '        FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_TIMETO' +
          'STR('#39' || FNAME || '#39','#39#39#39' || NULLC || '#39#39#39'))'#39'; -- '#161', e o caracter 1' +
          '73'
        '      else'
        '      if (FTYPE in ('#39'VARCHAR'#39', '#39'BLOB 1'#39')) then'
        
          '        FIELDSSQL = FIELDSSQL || '#39'( select RESULT from SP_HANDLE' +
          'STR('#39' || FNAME || '#39','#39#39#39' || SEP || '#39#39#39','#39#39#39' || NULLC || '#39#39#39','#39#39#39' ||' +
          ' APOSTREPLACE || '#39#39#39'))'#39'; -- '#161', e o caracter 247, 173, e 241'
        '      else'
        
          '        FIELDSSQL = FIELDSSQL || '#39'coalesce('#39' || FNAME || '#39','#39#39#39' |' +
          '| NULLC || '#39#39#39')'#39'; -- '#161', e o caracter 173'
        '    end'
        ''
        
          '    SQL = '#39'select (next value for SEQ_RAWDATA), '#39#39#39' || TABELA ||' +
          ' '#39#39#39', '#39' || FIELDSSQL || '#39' from '#39' || TABELA || '#39' where COD_NFCE =' +
          ' '#39' || NFCE_ID || '#39' and COD_EMPRESA = '#39' || EMPRESA_ID;'
        ''
        
          '    execute statement '#39'alter sequence SEQ_RAWDATA restart with 0' +
          #39';'
        ''
        
          '    execute statement '#39'insert into RAWDATA (ID, TABELA, DATA) va' +
          'lues (0, '#39#39#39' || TABELA || '#39#39#39', '#39#39#39' || FIELDS || '#39#39#39')'#39';'
        ''
        
          '    execute statement '#39'insert into RAWDATA (ID, TABELA, DATA) '#39' ' +
          '|| SQL;'
        '  end'
        ''
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter trigger NFCE_BI_ID for NFCE'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger NFCE_DEST_BI_ID for NFCE_DEST'
        'active before insert position 0'
        'as'
        'begin'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);'
        '  if (coalesce(new.GUID_NFCE, '#39#39') = '#39#39') then'
        
          '    new.GUID_NFCE = (select GUIDT from NFCE where COD_NFCE = new' +
          '.COD_NFCE and COD_EMPRESA = new.COD_EMPRESA);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger NFCE_INFADIC_BI_ID for NFCE_INFADIC'
        'active before insert position 0'
        'as'
        'begin'
        '  if (coalesce(new.SEQID, 0) = 0) then'
        
          '    new.SEQID = (select COD from INCREMENTA_CODIGO(new.COD_EMPRE' +
          'SA, '#39'NFCE_INFADIC'#39'));'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);'
        '  if (coalesce(new.GUID_NFCE, '#39#39') = '#39#39') then'
        
          '    new.GUID_NFCE = (select GUIDT from NFCE where COD_NFCE = new' +
          '.COD_NFCE and COD_EMPRESA = new.COD_EMPRESA);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger NFCE_ITEM_BI_ID for NFCE_ITEM'
        'active before insert position 0'
        'as'
        'begin'
        '  if (coalesce(new.SEQID, 0) = 0) then'
        
          '    new.SEQID = (select COD from INCREMENTA_CODIGO(new.COD_EMPRE' +
          'SA, '#39'NFCE_ITEM'#39'));'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);'
        '  if (coalesce(new.GUID_NFCE, '#39#39') = '#39#39') then'
        
          '    new.GUID_NFCE = (select GUIDT from NFCE where COD_NFCE = new' +
          '.COD_NFCE and COD_EMPRESA = new.COD_EMPRESA);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger NFCE_PAGAMENTO_BI_ID for NFCE_PAGAMENTO'
        'active before insert position 0'
        'as'
        'begin'
        '  if (coalesce(new.SEQID, 0) = 0) then'
        
          '    new.SEQID = (select COD from INCREMENTA_CODIGO(new.COD_EMPRE' +
          'SA, '#39'NFCE_PAGAMENTO'#39'));'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);'
        '  if (coalesce(new.GUID_NFCE, '#39#39') = '#39#39') then'
        
          '    new.GUID_NFCE = (select GUIDT from NFCE where COD_NFCE = new' +
          '.COD_NFCE and COD_EMPRESA = new.COD_EMPRESA);'
        'end'
        '|/BLOCO|'
        ''
        'drop trigger TRANSACAO_CARTAO_BI_CURRENT_TS;'
        ''
        '|BLOCO|'
        
          'create or alter trigger TRANSACAO_CARTAO_BI_ID for TRANSACAO_CAR' +
          'TAO'
        'active before insert position 0'
        'as'
        'begin       '
        '  if (coalesce(new.SEQID, 0) = 0) then'
        
          '    new.SEQID = (select COD from INCREMENTA_CODIGO(new.COD_EMPRE' +
          'SA, '#39'TRANSACAO_CARTAO'#39'));'
        '  if (new.DATA_HORA is null) then'
        
          '    select CURRENT_TS from SP_CURRENT_TS(new.COD_EMPRESA) into n' +
          'ew.DATA_HORA;'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);'
        'end'
        '|/BLOCO|'
        ''
