        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_NFCE_HANDLE_PEDVENDA ('
        '    NFCE_ID integer,'
        '    EMPRESA_ID integer,'
        '    UPDATE_NFCE smallint)'
        'returns ('
        '    RESP varchar(128))'
        'as'
        '  declare variable NUM_NF integer;'
        '  declare variable INT_TMP integer;'
        '  declare variable STR_TMP varchar(128);'
        '  declare variable STATUS varchar(10);'
        '  declare variable SITUACAO varchar(16);'
        '  declare variable TPEMIS char(1);'
        '  declare variable PED_ORIGEM_ID integer;'
        '  declare variable PED_ORIGEM_TP char(3);'
        '  declare variable PED_DEST_ID integer;'
        '  declare variable PED_DEST_TP char(3);'
        '  declare variable ORC_ID integer;'
        '  declare variable PED_NEW_ID integer;'
        '  declare variable GRUPO_ID integer;'
        '  declare variable CODIGO_ID char(6);'
        '  declare variable GRADE_ID integer;'
        '  declare variable QTDE double precision;'
        '  declare variable GERAR_PED smallint;'
        '  declare variable UPDATE_PED smallint;'
        '  declare variable CURRENT_TS timestamp;'
        '  declare variable CLIENTE_ID integer;'
        'begin'
        '  RESP = '#39'OK'#39';'
        ''
        
          '  for select coalesce(COD_NFCE, 0), coalesce(NUM_NF, 0), coalesc' +
          'e(STATUS, '#39#39'), coalesce(SITUACAO_NFCE, '#39#39'),'
        
          '             coalesce(TPEMIS, '#39#39'), coalesce(NORC, 0), coalesce(P' +
          'ED_ORIGEM_NUM, 0), PED_ORIGEM_TIP,'
        '             coalesce(PED_DESTINO_NUM, 0), PED_DESTINO_TIP'
        '      from NFCE'
        '      where COD_NFCE = :NFCE_ID and'
        '            COD_EMPRESA = :EMPRESA_ID'
        
          '        into :INT_TMP, :NUM_NF, :STATUS, :SITUACAO, :TPEMIS, :OR' +
          'C_ID, :PED_ORIGEM_ID, :PED_ORIGEM_TP, PED_DEST_ID,'
        '             PED_DEST_TP'
        '  do'
        '  begin'
        '    if (NUM_NF = 0) then'
        '    begin'
        '      RESP = '#39'NFCe ainda nao emitida'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        
          '    if ((STATUS = '#39'Cancelada'#39') or (SITUACAO in ('#39'Cancelada'#39', '#39'In' +
          'utilizada'#39', '#39'Denegada'#39'))) then'
        '    begin'
        '      if (PED_ORIGEM_ID > 0) then'
        '      begin'
        '        for select COD_NFCE'
        '            from PEDVENDA'
        '            where NPED = :PED_ORIGEM_ID and'
        '                  TIPO = :PED_ORIGEM_TP and'
        '                  COD_EMPRESA = :EMPRESA_ID'
        '              into :INT_TMP'
        '        do'
        '          if (INT_TMP = NFCE_ID) then'
        '          begin'
        '            update PEDVENDA'
        '            set COD_NFCE = null,'
        '                NUM_NFCE = null'
        '            where NPED = :PED_ORIGEM_ID and'
        '                  TIPO = :PED_ORIGEM_TP and'
        '                  COD_EMPRESA = :EMPRESA_ID and'
        '                  COD_NFCE = :NFCE_ID;'
        ''
        '            if (UPDATE_NFCE = 1) then'
        '              update NFCE'
        '              set PED_ORIGEM_NUM = null,'
        '                  PED_ORIGEM_TIP = null'
        '              where COD_NFCE = :NFCE_ID and'
        '                    COD_EMPRESA = :EMPRESA_ID and'
        '                    PED_ORIGEM_NUM = :PED_ORIGEM_ID and'
        '                    PED_ORIGEM_TIP = :PED_ORIGEM_TP;'
        '          end'
        '      end'
        '      else'
        '      if (PED_DEST_ID > 0) then'
        '      begin'
        '        for select COD_NFCE, STATUS_PED'
        '            from PEDVENDA'
        '            where NPED = :PED_DEST_ID and'
        '                  TIPO = :PED_DEST_TP and'
        '                  COD_EMPRESA = :EMPRESA_ID'
        '              into :INT_TMP, :STR_TMP'
        '        do'
        '          if (INT_TMP <> NFCE_ID) then'
        '          begin'
        '            suspend;'
        '            exit;'
        '          end'
        ''
        '        --voltando estoque'
        '        if (trim(STR_TMP) = '#39'FECHADA'#39') then'
        '        begin'
        
          '          for select GRUPO_PROD, COD_PROD, coalesce(COD_GRADE, 0' +
          '), sum(QUANT_PED_ITEM)'
        '              from PEDVENDA_PROD'
        '              where NPED = :PED_DEST_ID and'
        '                    TIPO = :PED_DEST_TP and'
        '                    COD_EMPRESA = :EMPRESA_ID and'
        '                    coalesce(STATUS, '#39#39') <> '#39'CANCELADO'#39
        '              group by GRUPO_PROD, COD_PROD, COD_GRADE'
        '                into :GRUPO_ID, :CODIGO_ID, :GRADE_ID, :QTDE'
        '          do'
        '          begin'
        
          '            execute procedure MOVIMENTA_ESTOQUE(:GRUPO_ID, :CODI' +
          'GO_ID, :EMPRESA_ID, :GRADE_ID, :QTDE, 0, 0);'
        
          '            --update para acionar a trigger e incrementar o seqi' +
          'd para replcar o novo estoque'
        '            if (GRADE_ID > 0) then'
        '              execute statement'
        '              '#39'update COD_GRADE_PROD '#39' ||'
        '              '#39'set SEQID_SINCOFF = null '#39' ||'
        '              '#39'where GRUPO_PROD =  '#39' || :GRUPO_ID || '#39' and '#39' ||'
        '              '#39'      COD_PROD =  '#39' || :CODIGO_ID || '#39' and '#39' ||'
        
          '              '#39'      COD_EMPRESA =  '#39' || :EMPRESA_ID || '#39' and '#39' ' +
          '||'
        '              '#39'      COD_GRADE =  '#39' || :GRADE_ID  ;'
        '            else'
        '              execute statement'
        '              '#39'update PRODUTOS '#39' ||'
        '              '#39'set SEQID_SINCOFF = null '#39' ||'
        '              '#39'where GRUPO_PROD = '#39' || :GRUPO_ID  || '#39' and '#39' ||'
        '              '#39'      COD_PROD = '#39' || :CODIGO_ID  || '#39' and '#39' ||'
        '              '#39'      COD_EMPRESA = '#39' || :EMPRESA_ID;'
        '          end'
        ''
        
          '          --reabrindo a venda para gerar o historico de alteraca' +
          'o de estoque cancelando pedvenda'
        '          update PEDVENDA'
        '          set STATUS_PED = '#39#39
        '          where NPED = :PED_DEST_ID and'
        '                TIPO = :PED_DEST_TP and'
        '                COD_EMPRESA = :EMPRESA_ID and'
        '                COD_NFCE = :NFCE_ID and'
        '                STATUS_PED = '#39'FECHADA'#39';'
        ''
        '          --cancelando pedvenda'
        '          update PEDVENDA'
        '          set STATUS_PED = '#39'CANCELADO'#39
        '          where NPED = :PED_DEST_ID and'
        '                TIPO = :PED_DEST_TP and'
        '                COD_EMPRESA = :EMPRESA_ID and'
        '                COD_NFCE = :NFCE_ID and'
        '                STATUS_PED = '#39#39';'
        ''
        '          --cancelando pedvenda_prod'
        '          update PEDVENDA_PROD'
        '          set STATUS = '#39'CANCELADO'#39
        '          where NPED = :PED_DEST_ID and'
        '                TIPO = :PED_DEST_TP and'
        '                COD_EMPRESA = :EMPRESA_ID and'
        '                coalesce(STATUS, '#39#39') = '#39#39';'
        '        end'
        '      end'
        ''
        '      update FORMPAGAMENTO FP'
        '      set FP.NDOC = FP.NDOC_ANT,'
        '          FP.NDOC_ANT = null,'
        '          FP.COD_NFCE = null'
        '      where FP.COD_NFCE = :NFCE_ID and'
        '            FP.COD_EMPRESA = :EMPRESA_ID and'
        '            FP.NDOC_ANT is not null and'
        '            FP.NDOC_ANT <> '#39#39';'
        '    end'
        '    else'
        '    begin'
        '      if (((STATUS = '#39'Fechada'#39') and'
        
          '          (SITUACAO = '#39'Autorizada'#39')) or ((STATUS = '#39'Fechada'#39') an' +
          'd'
        '          (TPEMIS = '#39'9'#39'))) then'
        '      begin'
        
          '        GERAR_PED = iif((PED_ORIGEM_ID = 0) and (PED_DEST_ID = 0' +
          '), 1, 0);'
        
          '        UPDATE_PED = iif((PED_ORIGEM_ID > 0) and (PED_DEST_ID = ' +
          '0), 1, 0);'
        '      end'
        '      else'
        '      begin'
        '        GERAR_PED = 0;'
        '        UPDATE_PED = 0;'
        '      end'
        ''
        '      if (GERAR_PED = 1) then'
        '      begin'
        '        INT_TMP = 0;'
        '        select COD_NFCE'
        '        from PEDVENDA'
        '        where NPED = :PED_ORIGEM_ID and'
        '              TIPO = :PED_ORIGEM_TP and'
        '              COD_EMPRESA = :EMPRESA_ID'
        '          into :INT_TMP;'
        ''
        '        GERAR_PED = iif(INT_TMP = 0, 1, 0);'
        '      end'
        ''
        '      if (UPDATE_PED = 1) then'
        '      begin'
        '        update PEDVENDA'
        '        set COD_NFCE = :NFCE_ID,'
        '            NUM_NFCE = :NUM_NF'
        '        where NPED = :PED_ORIGEM_ID and'
        '              TIPO = :PED_ORIGEM_TP and'
        '              COD_EMPRESA = :EMPRESA_ID and'
        '              COD_NFCE is null;'
        ''
        '        update FORMPAGAMENTO FP'
        '        set FP.NDOC_ANT = FP.NDOC,'
        '            FP.COD_NFCE = :NFCE_ID,'
        '            FP.NDOC = (select RESULT'
        
          '                       from STRZERO(:NUM_NF, 6)) || substring(FP' +
          '.NDOC from 7 for (char_length(FP.NDOC) - 6))'
        '        where FP.NREQUISICAO = :PED_ORIGEM_ID and'
        '              FP.TPDOCS = :PED_ORIGEM_TP and'
        '              FP.COD_EMPRESA = :EMPRESA_ID and'
        '              FP.ATIVO = 1 and'
        '              FP.TIPDOC = '#39'S2'#39' and'
        '              char_length(FP.NDOC) > 5 and'
        '              FP.COD_NFCE is null;'
        '      end'
        '      else'
        '      if (GERAR_PED = 1) then'
        '      begin'
        '        for select coalesce(NPED, 0), coalesce(TIPO, '#39#39')'
        '            from PEDVENDA'
        '            where COD_NFCE = :NFCE_ID and'
        '                  COD_EMPRESA = :EMPRESA_ID and'
        '                  STATUS_PED = '#39'FECHADA'#39
        '              into :INT_TMP, :STR_TMP'
        '        do'
        '          if (INT_TMP > 0) then'
        '          begin'
        '            if (UPDATE_NFCE = 1) then'
        '              update NFCE'
        '              set PED_DESTINO_NUM = :INT_TMP,'
        
          '                  PED_DESTINO_TIP = substring(:STR_TMP from 1 fo' +
          'r 3)'
        '              where COD_NFCE = :INT_TMP and'
        '                    COD_EMPRESA = :EMPRESA_ID and'
        '                    PED_DESTINO_NUM is null;'
        ''
        '            suspend;'
        '            exit;'
        '          end'
        ''
        '        select CURRENT_TS'
        '        from SP_CURRENT_TS(:EMPRESA_ID)'
        '          into :CURRENT_TS;'
        ''
        '        select cast(trunc(SS.VALUE1_F) as integer)'
        '        from CONFIG_SISTEMA SS'
        '        where CHAVE = '#39'cl_conf_codigo_cliente_padrao'#39' and'
        '              COD_EMPRESA = :EMPRESA_ID'
        '          into :CLIENTE_ID;'
        ''
        '        PED_NEW_ID = (select COD'
        
          '                      from INCREMENTA_CODIGO(:EMPRESA_ID, '#39'REQVE' +
          'NDA'#39'));'
        ''
        
          '        insert into PEDVENDA (COD_NFCE, NUM_NFCE, COD_EMPRESA, N' +
          'PED, TIPO, COD_CLIENTE, COD_VENDEDOR, VALOR_TOTAL,'
        
          '                              DESCONTO, ACRESCIMO, TOT_PROD, COD' +
          '_COND_PAG, TIPV, STATUS_PED, DATA_PED, DATA_FECH,'
        
          '                              HORA_FECH, HORAABERTURA, MINABERTU' +
          'RA, HORAFECHAMENTO, MINFECHAMENTO, DATA_ESTOQUE, CPFCGC,'
        '                              NOME_CLIENTEDAV, NOME_CLI_ORC,'
        ''
        '                              OBS_PED)'
        
          '        select N.COD_NFCE, N.NUM_NF, N.COD_EMPRESA, :PED_NEW_ID,' +
          ' '#39'REQ'#39', coalesce(C.COD_CLIENTE, :CLIENTE_ID),'
        '               N.COD_VENDEDOR, N.VNF, N.VDESC,'
        
          '               (N.VSEG + N.VOUTRO + N.VFRETE), N.VPROD, N.COD_CO' +
          'ND_PAG, '#39'V'#39', '#39'FECHADA'#39', cast(N.DHEMI as date),'
        '               cast(:CURRENT_TS as date),'
        '               (select RESULT'
        
          '                from STRZERO(extract(hour from :CURRENT_TS), 2))' +
          ' || '#39':'#39' ||(select RESULT'
        
          '                                                                ' +
          '           from STRZERO(extract(minute from :CURRENT_TS), 2)),'
        
          '               extract(hour from N.DHEMI), extract(minute from N' +
          '.DHEMI), extract(hour from :CURRENT_TS),'
        
          '               extract(minute from :CURRENT_TS), cast(:CURRENT_T' +
          'S as date), coalesce(D.CNPJCPF, C.CPFCGC),'
        
          '               coalesce(D.XNOME, C.NOME_CLIENTE), coalesce(D.XNO' +
          'ME, C.NOME_CLIENTE), E.MENSAGEM_EMP || '#39'; NFC-e '#39' || N.DHEMI ||(' +
          'select RESULT'
        
          '                                                                ' +
          '                                                                ' +
          'from STRZERO(NUM_NF, 6)) || '#39'/'#39' ||(select RESULT'
        
          '                                                                ' +
          '                                                                ' +
          '                                   from STRZERO(SERIE, 3))'
        ''
        '        from NFCE N'
        '          left join NFCE_DEST D on D.COD_NFCE = N.COD_NFCE and'
        '                D.COD_EMPRESA = N.COD_EMPRESA'
        
          '          left join CLIENTES C on C.COD_CLIENTE = N.COD_CLIENTE ' +
          'and'
        '                C.COD_EMPRESA = N.COD_EMPRESA'
        '          inner join EMPRESA E on E.COD_EMPRESA = N.COD_EMPRESA'
        '        where N.COD_NFCE = :NFCE_ID and'
        '              N.COD_EMPRESA = :EMPRESA_ID;'
        ''
        
          '        execute statement '#39'alter sequence SEQ_PRODUTOS_TMP resta' +
          'rt with 0'#39';'
        
          '        insert into PEDVENDA_PROD (NPED, TIPO, COD_EMPRESA, NITE' +
          'M, GRUPO_PROD, COD_PROD, COD_GRADE, CODIGO_NOP,'
        
          '                                   NUM_FAB_PROD, DESCR_PROD_PED,' +
          ' UNIDADE, QUANT_PED_ITEM, VLUN_PED_ITEM, VLTOT_PED_ITEM,'
        
          '                                   VLUN_ORIG, VLUN_PED_NF, VLTOT' +
          '_PED_NF, VLO_UNITARIO, RATEIO_DESC, RATEIO_ACRESC,'
        
          '                                   VL_DESP_NF, PCUST_C, PCUST_MC' +
          ', NITEM_NF, COD_VENDEDOR, NOME_VEND, ICM_PROD, SIT_TRIB,'
        
          '                                   DATA_TRANSF, DATA_INCLUSAO, C' +
          'OMISS_PROD, COMISS_PROD_GER)'
        '        select :PED_NEW_ID, '#39'REQ'#39', :EMPRESA_ID,'
        
          '               (next value for SEQ_PRODUTOS_TMP), I.GRUPO_PROD, ' +
          'I.COD_PROD, I.COD_GRADE, I.CFOP, I.NUM_FAB_PROD,'
        
          '               substring(I.XPROD from 1 for 75), substring(I.UCO' +
          'M from 1 for 3), I.QCOM, I.VUNCOM, I.VPROD, I.VUNCOM,'
        '               I.VUNCOM, I.VPROD, I.VUNCOM, I.VDESC,'
        '               (I.VSEG + I.VOUTRO + I.VFRETE),'
        
          '               (I.VSEG + I.VOUTRO + I.VFRETE), I.PREC_CUS_PROD, ' +
          'I.PREC_CUSM_PROD, I.SEQID, N.COD_VENDEDOR,'
        '               C.NOME_VENDEDOR, I.ICM_PICMS,'
        
          '               iif(I.ICM_PICMS > 0, '#39'T'#39', iif((P.ISENTO_PROD = '#39'S' +
          #39') or (P.N_INCIDENCIA_PROD = '#39'S'#39'), '#39'I'#39', '#39'F'#39')),'
        
          '               cast(:CURRENT_TS as date), cast(:CURRENT_TS as da' +
          'te),'
        
          '               round(P.COMISSAO_PROD * (I.VPROD - I.VDESC) / 100' +
          ', 2),'
        
          '               round(P.COMISSAO_PROD_GER * (I.VPROD - I.VDESC) /' +
          ' 100, 2)'
        '        from NFCE_ITEM I'
        '          inner join NFCE N on N.COD_NFCE = I.COD_NFCE and'
        '                N.COD_EMPRESA = I.COD_EMPRESA'
        
          '          inner join PRODUTOS P on P.GRUPO_PROD = I.GRUPO_PROD a' +
          'nd'
        '                P.COD_PROD = I.COD_PROD and'
        '                P.COD_EMPRESA = I.COD_EMPRESA'
        
          '          left join COLABORADOR C on C.COD_VENDEDOR = N.COD_VEND' +
          'EDOR and'
        '                C.COD_EMPRESA = N.COD_EMPRESA'
        '        where I.COD_NFCE = :NFCE_ID and'
        '              I.COD_EMPRESA = :EMPRESA_ID and'
        '              I.TIPO_ITEM = '#39'P'#39';'
        ''
        '        --Baixando estoque'
        
          '        for select GRUPO_PROD, COD_PROD, coalesce(COD_GRADE, 0),' +
          ' sum(QUANT_PED_ITEM)'
        '            from PEDVENDA_PROD'
        '            where NPED = :PED_NEW_ID and'
        '                  TIPO = '#39'REQ'#39' and'
        '                  COD_EMPRESA = :EMPRESA_ID and'
        '                  coalesce(STATUS, '#39#39') <> '#39'CANCELADO'#39
        '            group by GRUPO_PROD, COD_PROD, COD_GRADE'
        '              into :GRUPO_ID, :CODIGO_ID, :GRADE_ID, :QTDE'
        '        do'
        '        begin'
        
          '          execute procedure MOVIMENTA_ESTOQUE(:GRUPO_ID, :CODIGO' +
          '_ID, :EMPRESA_ID, :GRADE_ID, 0, :QTDE, 1);'
        
          '          --update para acionar a trigger e incrementar o seqid ' +
          'para replcar o novo estoque'
        '          if (GRADE_ID > 0) then'
        '            execute statement'
        '            '#39'update COD_GRADE_PROD '#39' ||'
        '            '#39'set SEQID_SINCOFF = null '#39' ||'
        '            '#39'where GRUPO_PROD = '#39' || :GRUPO_ID  || '#39' and '#39' ||'
        '            '#39'      COD_PROD = '#39' || :CODIGO_ID  || '#39' and '#39' ||'
        '            '#39'      COD_EMPRESA = '#39' || :EMPRESA_ID  || '#39' and '#39' ||'
        '            '#39'      COD_GRADE = '#39' || :GRADE_ID;'
        '          else'
        '            execute statement'
        '            '#39'update PRODUTOS '#39' ||'
        '            '#39'set SEQID_SINCOFF = null '#39' ||'
        '            '#39'where GRUPO_PROD = '#39' || :GRUPO_ID  || '#39' and '#39' ||'
        '            '#39'      COD_PROD = '#39' || :CODIGO_ID  || '#39' and '#39' ||'
        '            '#39'      COD_EMPRESA = '#39' || :EMPRESA_ID;'
        '        end'
        ''
        '        --update na nfce para criar o vinculo'
        '        if (UPDATE_NFCE = 1) then'
        '        begin'
        '          update NFCE'
        '          set PED_DESTINO_NUM = :PED_NEW_ID,'
        '              PED_DESTINO_TIP = '#39'REQ'#39
        '          where COD_NFCE = :NFCE_ID and'
        '                COD_EMPRESA = :EMPRESA_ID and'
        '                PED_DESTINO_NUM is null;'
        ''
        '          INT_TMP = 0;'
        
          '          select coalesce(PED_DESTINO_NUM, 0), coalesce(PED_DEST' +
          'INO_TIP, '#39#39')'
        '          from NFCE'
        '          where COD_NFCE = :NFCE_ID and'
        '                COD_EMPRESA = :EMPRESA_ID'
        '            into :INT_TMP, :STR_TMP;'
        ''
        '          if (INT_TMP = 0) then'
        '          begin'
        '            RESP = '#39'NFC-e nao encontrada'#39';'
        '            suspend;'
        '            exit;'
        '          end'
        ''
        
          '          if ((INT_TMP <> PED_NEW_ID) or (trim(STR_TMP) <> '#39'REQ'#39 +
          ')) then'
        '          begin'
        
          '            RESP = '#39'Nao foi concluir o processo. Registro gerado' +
          ' por outro processo'#39';'
        '            suspend;'
        '            exit;'
        '          end'
        '        end'
        '        else'
        '          RESP = RESP || '#39'|'#39' || PED_NEW_ID || '#39'|REQ'#39';'
        '      end'
        '    end'
        ''
        '    if (ORC_ID > 0) then'
        '      update PEDVENDA'
        '      set COD_NFCE = :NFCE_ID,'
        '          NUM_NFCE = :NUM_NF'
        '      where NPED = :ORC_ID and'
        '            TIPO = '#39'ORC'#39' and'
        '            COD_EMPRESA = :EMPRESA_ID;'
        '    suspend;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE ADM_CARTAO ADD CAMPO_NSU_OBRIG VARCHAR(1) DEFAULT '#39'S' +
          #39';'
        
          'ALTER TABLE ADM_CARTAO ADD CAMPO_NUM_AUT_OBRIG VARCHAR(1) DEFAUL' +
          'T '#39'S'#39';'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CAR106'#39', :COD_EMPRESA, '#39'BT' +
          ' ATUALIZAR VALOR LIQUIDO'#39', 5, '#39'S'#39', '#39'.'#39', 1, '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'create or alter procedure SPRI_EXEC ('
        '    TABELA varchar(31),'
        '    CONDICAO_O varchar(255),'
        '    CONDICAO_D varchar(255),'
        '    IDORIGEM integer,'
        '    REMOVER smallint)'
        'as'
        '  declare variable CAMPO_E varchar(31);'
        '  declare variable FIELDNAME varchar(31);'
        '  declare variable FIELDKEY varchar(31);'
        '  declare variable CONDORIG varchar(255);'
        '  declare variable CONDDEST varchar(255);'
        '  declare variable FTYPE2 varchar(32);'
        '  declare variable STMT blob sub_type 1 segment size 80;'
        '  declare variable STMTV blob sub_type 1 segment size 80;'
        '  declare variable STMTRUN blob sub_type 1 segment size 80;'
        '  declare variable STMTI blob sub_type 1 segment size 256;'
        '  declare variable STMTU blob sub_type 1 segment size 256;'
        '  declare variable STMTE blob sub_type 1 segment size 512;'
        '  declare variable ISPK integer;'
        '  declare variable COUNTPK integer;'
        '  declare variable IDDEST integer;'
        '  declare variable TIPO_ID smallint;'
        '  declare variable SCHEMA_ID smallint;'
        '  declare variable CONTEXT_VAR varchar(80);'
        '  declare variable CONTEXT_STAT varchar(255);'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        '    '
        '  select S.SCHEMA_ID, S.TIPO_ID'
        '  from SPRI_SCHEMA(:TABELA, :IDORIGEM) S'
        '      into :SCHEMA_ID, :TIPO_ID;'
        ''
        '  if (coalesce(SCHEMA_ID, 0) <= 0) then'
        '    exit;'
        ''
        '  TIPO_ID = coalesce(TIPO_ID, 0);'
        ''
        
          '  select GUIDT from RI_TAB where TABELA = :TABELA into :CONTEXT_' +
          'VAR;'
        ''
        '  if (CONTEXT_VAR is null) then'
        '    exit;'
        ''
        '  select RDB$GET_CONTEXT('#39'USER_TRANSACTION'#39', :CONTEXT_VAR)'
        '  from RDB$DATABASE'
        '    into :CONTEXT_STAT;'
        ''
        '  if (trim(CONTEXT_STAT) = trim(CONDICAO_O)) then'
        '    exit;'
        ''
        '  RDB$SET_CONTEXT('#39'USER_TRANSACTION'#39', :CONTEXT_VAR, CONDICAO_O);'
        ''
        '  insert into RI_TMP_SQL (SQLEXEC)'
        
          '    values ('#39'CONDICAO_O '#39' || :CONDICAO_O || ASCII_CHAR(13) || '#39' ' +
          'CONDICAO_D '#39' || :CONDICAO_D );'
        ''
        '  select E.CAMPO_EMP, PK.COUNTPK'
        '  from SPDB_EMP_KEY(:TABELA) E'
        '    left join SPDB_COUNT_PK(:TABELA) PK on 1 = 1'
        '    into :CAMPO_E, :COUNTPK;'
        ''
        '  CONDICAO_O = trim(coalesce(CONDICAO_O, '#39#39'));'
        
          '  CONDORIG = replace(CONDICAO_O, '#39'@'#39', '#39's'#39') || iif(CONDICAO_O <> ' +
          #39#39', '#39' and '#39', '#39#39') || '#39' s.'#39' || CAMPO_E || '#39' = '#39' || cast(IDORIGEM a' +
          's varchar(20));'
        ''
        '  CONDICAO_D = trim(coalesce(CONDICAO_D, '#39#39'));'
        
          '  CONDDEST = replace(CONDICAO_D, '#39'@'#39', '#39'd'#39') || iif(CONDICAO_D <> ' +
          #39#39', '#39' and '#39', '#39#39') || '#39' d.'#39' || CAMPO_E || '#39' = @IDDEST@'#39';'
        ''
        
          '  if (((CONDICAO_O = '#39#39') or (CONDICAO_D = '#39#39')) and (COUNTPK > 1)' +
          ') then'
        '    exit;'
        ''
        '  STMT = CAMPO_E;'
        '  STMTV = '#39#39';'
        '  STMTU = '#39#39';'
        '  FIELDKEY = '#39#39';'
        ''
        '  if (coalesce(REMOVER, 0) <> 1) then'
        '    for select F.FIELDNAME, F.FIELDTYPE2, PK.ISPK'
        '        from SPDB_FIELDS(:TABELA) F'
        '          left join SPDB_IS_PK(:TABELA, F.FIELDNAME) PK on 1 = 1'
        '          inner join RI_SCHEMA_TAB T on T.TABELA = :TABELA and'
        '                T.SCHEMA_ID = :SCHEMA_ID'
        
          '          left join RI_SCHEMA_TAB_EXCE TE on TE.TABELA_ID = T.ID' +
          ' and'
        '                TE.CAMPO = F.FIELDNAME'
        '        where F.FIELDNAME <> :CAMPO_E and'
        
          '              F.FIELDNAME not in ('#39'REP_INT_ACTIVE'#39', '#39'ID_COMMERCE' +
          #39', '#39'SEQID_SINC'#39', '#39'SEQID_SINCOFF'#39', '#39'GUIDT'#39') and'
        '              TE.CAMPO is null'
        '          into :FIELDNAME, :FTYPE2, ISPK    '
        '    do'
        '    begin'
        '      STMT = STMT || '#39','#39' || FIELDNAME;'
        ''
        '      if ((FTYPE2 = '#39'INT'#39') and'
        '          (FIELDKEY = '#39#39') and'
        '          (coalesce(ISPK, 0) = 1) and'
        '          (coalesce(COUNTPK, 0) = 2)) then '
        '          FIELDKEY = FIELDNAME;'
        '  '
        '      if ((TIPO_ID = 1) and'
        '          (FIELDKEY = FIELDNAME)) then'
        '      begin'
        '        if (STMTV <> '#39#39') then'
        '          STMTV = STMTV || '#39','#39';'
        '  '
        '        STMTV = STMTV || '#39'@FUNCAO_INCREMENTA_CODIGO@'#39';'
        '      end'
        '      else'
        '      begin'
        '        if (STMTV <> '#39#39') then'
        '          STMTV = STMTV || '#39','#39';'
        '        STMTV = STMTV || '#39's.'#39' || FIELDNAME;'
        '  '
        '        if (STMTU <> '#39#39') then'
        '          STMTU = STMTU || '#39','#39';'
        '  '
        
          '        STMTU = STMTU || '#39'd.'#39' || FIELDNAME || '#39'=s.'#39' || FIELDNAME' +
          ';'
        '      end'
        '    end'
        ''
        '  for select E.EMPRESA_ID'
        '      from RI_SCHEMA_EMP E'
        '        inner join RI_SCHEMA S on E.SCHEMA_ID = S.ID'
        '        inner join RI_SCHEMA_TAB TB on TB.SCHEMA_ID = S.ID'
        '      where E.EMPRESA_ID <> :IDORIGEM and'
        '            TB.TABELA = :TABELA and'
        '            S.ID in (select S.ID'
        '                     from RI_SCHEMA S'
        
          '                       inner join RI_SCHEMA_TAB T on T.SCHEMA_ID' +
          ' = S.ID'
        
          '                       inner join RI_SCHEMA_EMP E on E.SCHEMA_ID' +
          ' = S.ID'
        '                     where E.EMPRESA_ID = :IDORIGEM and'
        '                           T.TABELA = :TABELA)'
        '      order by E.EMPRESA_ID'
        '        into :IDDEST'
        '  do'
        '  begin'
        '    if (REMOVER = 1) then'
        
          '      STMTE = '#39'delete from '#39' || :TABELA || '#39' d where '#39' || replac' +
          'e(CONDDEST, '#39'@IDDEST@'#39', cast(IDDEST as varchar(20)));'
        '    else'
        '    begin '
        
          '      STMTRUN = replace(STMTV, '#39'@FUNCAO_INCREMENTA_CODIGO@'#39', '#39'(s' +
          'elect COD from INCREMENTA_CODIGO('#39'|| cast(IDDEST as varchar(20))' +
          ' || '#39','#39#39#39' || :TABELA || '#39#39#39'))'#39');'
        ''
        '      STMTI = cast(IDDEST as varchar(20)) || '#39','#39' || STMTRUN;'
        '  '
        '      STMTE = '#39'merge into '#39' || TABELA || '#39' d'#39' ||'
        
          '              '#39' using (select * from '#39' || TABELA || '#39' where '#39' ||' +
          ' replace(CONDORIG, '#39's.'#39', '#39#39') || '#39') s'#39' ||'
        
          '              '#39' on ('#39' || replace(CONDDEST, '#39'@IDDEST@'#39', cast(IDDE' +
          'ST as varchar(20))) || '#39')'#39' ||'
        '              '#39' when matched then'#39' ||'
        '              '#39'   update set '#39' || STMTU ||'
        '              '#39' when not matched then'#39' ||'
        
          '              '#39'   insert ('#39' || STMT || '#39') values ('#39' || STMTI || ' +
          #39')'#39';'
        '    end'
        ''
        '    insert into RI_TMP_SQL (SQLEXEC)'
        '    values (:STMTE);'
        ''
        '    execute statement STMTE;'
        ''
        '    CONDICAO_O = replace(CONDICAO_O, '#39'@.'#39', '#39#39');'
        '    CONDICAO_D = replace(CONDICAO_D, '#39'@.'#39', '#39#39');'
        '    CONDICAO_O = replace(CONDICAO_O, '#39' and '#39', '#39' '#39');'
        '    CONDICAO_D = replace(CONDICAO_D, '#39' and '#39', '#39' '#39');'
        ''
        
          '    insert into RI_TAB_LOG (SEQID, TABELA, CONDICAO_O, CONDICAO_' +
          'D, IDORIG, IDDEST, EXCLUSAO, DH_REP)'
        
          '    values (gen_id(SEQ_REP_INT_LOG, 1), :TABELA, :CONDICAO_O, :C' +
          'ONDICAO_D, :IDORIGEM, :IDDEST, :REMOVER, current_timestamp);'
        '  end'
        ''
        '  RDB$SET_CONTEXT('#39'USER_TRANSACTION'#39', :CONTEXT_VAR, null);'
        'end'
        '|/BLOCO|'
