          '    SELECT GEN_ID(SEQ_DEL_EC, 1) FROM RDB$DATABASE INTO :VSEQID;' +
          ' '
        '    CAMPOS_CHAVE =  '#39'|ID|COD_EMPRESA|'#39'; '
        '    VALORES_CHAVE = '#39'|'#39'||OLD.ID||'#39'|'#39'||OLD.COD_EMPRESA||'#39'|'#39'; '
        
