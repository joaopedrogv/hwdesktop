        'CREATE OR ALTER trigger nfce_item_calc_imp for nfce_item'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_PRODUTOS_EC('
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_EMPRESA,'
        '    ATIVO,'
        '    NUM_FAB_PROD,'
        '    DESCR_PROD_RES,'
        '    DESCR_PROD_COMPL,'
        '    SINC_ECOMMERCE,'
        '    ID_COMMERCE,'
        '    DISPONIVEL,'
        '    PROMOCIONAL,'
        '    FRETE_GRATIS,'
        '    LANCAMENTO,'
        '    DESTAQUE,'
        '    VARIACAO,'
        '    TERMOS_ACEITE,'
        '    COMPREJUNTO,'
        '    VIRTUAL,'
        '    ENV_COMERCIO_ABERTO,'
        '    ID_COMERCIO_ABERTO,'
        '    DESCRICAO_MARCA,'
        '    LISTA_IMAGENS,'
        '    URL_IMAGENS,'
        '    LISTA_IMAGENS_GRADE,'
        '    URL_IMAGENS_GRADE,'
        '    REFERENCE,'
        '    COM_GRADE,'
        '    COD_GRADE,'
        '    GRADE1,'
        '    GRADE2,'
        '    EST_DISP,'
        '    EST_DISP_GRADE,'
        '    EST_MINIMO,'
        '    MANUAL_EST_DISP,'
        '    MANUAL_EST_DISP_GRADE,'
        '    MANUAL_EST_MINIMO,'
        '    API,'
        '    API_PRECO_TABELA,'
        '    PRECO_TABELA,'
        '    DESCRICAOPROMOCAO,'
        '    VALORPROMOCAO,'
        '    DATAINICIOPROMOCAO,'
        '    DATAFIMPROMOCAO,'
        '    HORAINICIOPROMOCAO,'
        '    HORAFIMPROMOCAO,'
        '    PRECO_A_COMBINAR_CA,'
        '    SEQID_CA)'
        'AS'
        'select'
        '  0 TIPO,'
        '--DADOS DO PRODUTO'
        
          '  PEC.GRUPO_PROD, PEC.COD_PROD, PEC.COD_EMPRESA, PR.ATIVO, PR.NU' +
          'M_FAB_PROD,'
        
          '  coalesce(PEC.DESCR_PROD_RES, PR.DESCR_PROD) DESCR_PROD_RES, PE' +
          'C.DESCR_PROD_COMPL,'
        ''
        '  CASE WHEN (PECG.COD_GRADE > 0) THEN'
        
          '         CASE WHEN (PEC.SINC_ECOMMERCE = '#39'S'#39') AND (PECG.SINC_ECO' +
          'MMERCE = '#39'S'#39') THEN'
        '                '#39'S'#39
        '              ELSE'
        '                '#39'N'#39
        '         END'
        '       ELSE'
        '         COALESCE(PEC.SINC_ECOMMERCE, '#39'N'#39')'
        '  END SINC_ECOMMERCE,'
        '  PEC.ID_COMMERCE,'
        
          '  PEC.DISPONIVEL, PEC.PROMOCIONAL, PEC.FRETE_GRATIS, PEC.LANCAME' +
          'NTO, PEC.DESTAQUE, PEC.VARIACAO,'
        '  PEC.TERMOS_ACEITE, PEC.COMPREJUNTO, PEC.VIRTUAL,'
        
          '  PEC.ENV_COMERCIO_ABERTO, COALESCE(PECG.ID_COMERCIO_ABERTO, PEC' +
          '.ID_COMERCIO_ABERTO) ID_COMERCIO_ABERTO,'
        '  MARCA_PROD.DESCRICAO_MARCA,'
        
          '  PIP.LISTA_IMAGENS, PIP.URL_IMAGENS, PIG.LISTA_IMAGENS as LISTA' +
          '_IMAGENS_GRADE,'
        '  PIG.URL_IMAGENS as URL_IMAGENS_GRADE,'
        '  (select first 1 CB.COD_BARRA from COD_BARRA CB'
        '   where CB.GRUPO_PROD = PEC.GRUPO_PROD'
        '   and CB.COD_PROD = PEC.COD_PROD'
        '   and coalesce(CB.COD_GRADE, 0) = 0'
        '   and CB.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '   and CB.COD_BARRA <> (CB.GRUPO_PROD || CB.COD_PROD)) as REFERE' +
          'NCE,'
        '--DADOS GRADE'
        '  CASE WHEN ((SELECT COUNT(*) FROM COD_GRADE_PROD'
        '  WHERE COD_GRADE_PROD.GRUPO_PROD = PEC.GRUPO_PROD'
        '  AND COD_GRADE_PROD.COD_PROD = PEC.COD_PROD'
        '  AND COD_GRADE_PROD.COD_GRADE > 0'
        
          '  AND COD_GRADE_PROD.COD_EMPRESA = PEC.COD_EMPRESA) > 0) then '#39'1' +
          #39' else '#39'0'#39' end COM_GRADE,'
        '  coalesce(PECG.COD_GRADE, 0) COD_GRADE,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC, '#39#39') <> '#39#39', GRADE.DESCRICAO_EC' +
          ', GRADE.DESCRICAO) GRADE1,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC1, '#39#39') <> '#39#39', GRADE.DESCRICAO_E' +
          'C1, GRADE.DESCRICAO_EC1) GRADE2,'
        '--ESTOQUE FISICO'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PEC.GRUPO_PROD, PEC.COD_PROD, 0, PEC.COD_EMPRESA, 0, '#39#39', 0,' +
          ' 0)), 0) EST_DISP,'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PECG.GRUPO_PROD, PECG.COD_PROD, PECG.COD_GRADE, PECG.COD_EM' +
          'PRESA, 0, '#39#39', 0, 0)), 0) EST_DISP_GRADE,'
        '  coalesce(PR.N_MIN_PROD, 0) EST_MINIMO,'
        '--ESTOQUE MANUAL'
        '  coalesce(PEC.ESTOQUE_EC, 0) MANUAL_EST_DISP,'
        '  coalesce(PECG.ESTOQUE_EC, 0) MANUAL_EST_DISP_GRADE,'
        '  coalesce(PEC.ESTOQUE_MIN_EC, 0) MANUAL_EST_MINIMO,'
        '-- PRECO CONFIG_API'
        '  CONFIG_API.API,'
        '  (select first 1 PMP.VALOR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        
          '        PMP.COD_PROMOCAO = CONFIG_API.COD_TAB_PRECO) API_PRECO_T' +
          'ABELA,'
        '--PRECO PADRAO PRODUTO'
        '  PR.PREC_TAB_PROD as PRECO_TABELA,'
        '--DESCRICAO PROMOCAO COMERCIO ABERTO'
        '  (select first 1 PM.DESCR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D  >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DESCRICAOPROMOCAO,'
        '-- VALOR PROMOCAO COMERCIO ABERTO'
        '  (select first 1 iif((PMP.PORCENTAGEM > 0),'
        
          '                      (PR.PREC_TAB_PROD - (round(PR.PREC_TAB_PRO' +
          'D * PMP.PORCENTAGEM) / 100)),'
        '                       PMP.VALOR_PROMOCAO)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) VALORPROMOCAO,'
        '--DATA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_INI, PM.DATA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAINICIOPROMOCAO,'
        '--DATA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAFIMPROMOCAO,'
        '--HORA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_INI, PM.HORA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAINICIOPROMOCAO,'
        '--HORA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_FIM, PM.HORA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAFIMPROMOCAO,'
        '-- PRECO_A_COMBINAR_CA'
        '  PEC.PRECO_A_COMBINAR_CA,'
        '--SEQIDS'
        '  coalesce(PECG.SEQID_CA, PEC.SEQID_CA)  SEQID_CA'
        'from PRODUTOS_EC PEC'
        '  inner join PRODUTOS PR on PEC.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PEC.COD_PROD = PR.COD_PROD and'
        '        PEC.COD_EMPRESA = PR.COD_EMPRESA'
        
          '  left join PRODUTOS_EC_GRADE PECG on PECG.GRUPO_PROD = PEC.GRUP' +
          'O_PROD and'
        '        PECG.COD_PROD = PEC.COD_PROD and'
        '        PECG.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIP on PIP.GRUPO_PROD = PEC.GRUPO_P' +
          'ROD and'
        '        PIP.COD_PROD = PEC.COD_PROD and'
        '        PIP.COD_GRADE = 0 and'
        '        PIP.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIG on PIG.GRUPO_PROD = PECG.GRUPO_' +
          'PROD and'
        '        PIG.COD_PROD = PECG.COD_PROD and'
        '        PIG.COD_GRADE = PECG.COD_GRADE and'
        '        PIG.COD_EMPRESA = PECG.COD_EMPRESA'
        '  left join GRADE on GRADE.COD_GRADE = PECG.COD_GRADE and'
        '        GRADE.COD_EMPRESA = PECG.COD_EMPRESA and'
        '        GRADE.COD_GRADE > 0'
        
          '  left join CATEGORIA on CATEGORIA.COD_CATEGORIA = PEC.COD_CATEG' +
          'ORIA AND CATEGORIA.COD_EMPRESA = PEC.COD_EMPRESA'
        '  left join MARCA_PROD on MARCA_PROD.COD_MARCA = PR.COD_MARCA'
        
          '  left join CONFIG_API on CONFIG_API.COD_EMPRESA = PEC.COD_EMPRE' +
          'SA'
        'UNION'
        
          'select 1 TIPO, TS.COD_SERVICO GRUPO_PROD, '#39'SERV'#39' COD_PROD, coale' +
          'sce(TS.COD_EMPRESA, EMP.COD_EMPRESA) COD_EMPRESA,'
        
          '       TS.ATIVO, null NUM_FAB_PROD, TS.DESC_SERV_RES DESCR_PROD_' +
          'RES, TS.DESC_SERV_COMPL DESCR_PROD_COMPL,'
        '       null SINC_ECOMMERCE, null ID_COMMERCE,'
        
          '       null DISPONIVEL, null PROMOCIONAL, null FRETE_GRATIS, nul' +
          'l LANCAMENTO, null DESTAQUE, null VARIACAO,'
        '       null TERMOS_ACEITE, null COMPREJUNTO, null VIRTUAL,'
        
          '       TS.ENV_COMERCIO_ABERTO, TS.ID_COMERCIO_ABERTO, null DESCR' +
          'ICAO_MARCA, null LISTA_IMAGENS, null URL_IMAGENS,'
        
          '       null LISTA_IMAGENS_GRADE, null URL_IMAGENS_GRADE, cast(TS' +
          '.COD_SERVICO as varchar(20)) REFERENCE, 0 COM_GRADE,'
        
          '       0 COD_GRADE, null GRADE1, null GRADE2, 100 EST_DISP, 100 ' +
          'EST_DISP_GRADE, 100 EST_MINIMO, 100 MANUAL_EST_DISP,'
        
          '       100 MANUAL_EST_DISP_GRADE, 100 MANUAL_EST_MINIMO, '#39'COMERC' +
          'IOABERTO'#39' API, TS.VALOR_SERVICO API_PRECO_TABELA,'
        
          '       TS.VALOR_SERVICO PRECO_TABELA, null DESCRICAOPROMOCAO, nu' +
          'll VALORPROMOCAO, null DATAINICIOPROMOCAO,'
        
          '       null DATAFIMPROMOCAO, null HORAINICIOPROMOCAO, null HORAF' +
          'IMPROMOCAO, TS.PRECO_A_COMBINAR_CA, TS.SEQID_CA'
        'from EMPRESA EMP'
        
          '  left join TIPO_SERVICO TS on coalesce(TS.COD_EMPRESA, EMP.COD_' +
          'EMPRESA) = EMP.COD_EMPRESA'
        'where TS.SEQID_CA > 0;'
        '|/BLOCO|'
        ''
        'ALTER TABLE NOTAFISCAL_PAG ADD XPAG VARCHAR(60);'
        'ALTER TABLE NFCE_PAGAMENTO ADD XPAG VARCHAR(60);'
        'ALTER TABLE NOTAFISCAL ADD COMPRA_XNEMP VARCHAR(22);'
        'ALTER TABLE NOTAFISCAL ADD COMPRA_XPED VARCHAR(60);'
        'ALTER TABLE NOTAFISCAL ADD COMPRA_XCONT VARCHAR(60);'
        'ALTER TABLE FORMPAGAMENTO_EC ADD QTDE_PARC INTEGER;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD CBARRA VARCHAR(30);'
        'ALTER TABLE NOTAFISCAL_ITEM ADD INDSOMAPISST SMALLINT DEFAULT 1;'
        
          'ALTER TABLE NOTAFISCAL_ITEM ADD INDSOMACOFINSST SMALLINT DEFAULT' +
          ' 1;'
        'ALTER TABLE FORMPAGAMENTO ADD GUID_TR_CARTAO CHAR(36);'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VEICULO ('
        '    PCHASSI varchar(17),'
        '    PPLACA varchar(10),'
        '    PCODIGO integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    ICHASSI varchar(17),'
        '    IPLACA varchar(10),'
        '    ICODIGO integer,'
        '    ICOD_EMPRESA integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  pplaca = trim(coalesce(pplaca, '#39#39'));'
        '  pchassi = trim(coalesce(pchassi, '#39#39'));'
        '  pcodigo = coalesce(pcodigo, 0);'
        '  pcod_empresa = coalesce(pcod_empresa, 0);'
        ''
        '  iplaca = '#39#39';'
        '  ichassi = '#39#39';'
        '  icodigo = 0;'
        
          '  if ((trim(pchassi) <> '#39#39') and (trim(pplaca) <> '#39#39') and (pcodig' +
          'o > 0))  then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.placa = :pplaca'
        '    and veiculos.chassi = :pchassi'
        '    and veiculos.codigo = :pcodigo'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        ''
        
          '    if ((trim(ichassi) = '#39#39') or (trim(iplaca) = '#39#39') or (pcodigo ' +
          '<= 0))  then'
        '    begin'
        '      if ((trim(pplaca) <> '#39#39') and (trim(iplaca) = '#39#39')) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.placa = :pplaca'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '      if ((trim(pchassi) <> '#39#39') and (trim(ichassi) = '#39#39')) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.chassi = :pchassi'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '      if ((pcodigo > 0) and (icodigo <= 0)) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.codigo = :pcodigo'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '    end'
        '  end'
        '  else if (trim(pplaca) <> '#39#39') then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.placa = :pplaca'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  else if (trim(pchassi) <> '#39#39') then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.chassi = :pchassi'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  else if (pcodigo > 0) then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.codigo = :pcodigo'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE STATS ('
        '    DIA         TIMESTAMP NOT NULL,'
        '    COD_E       INTEGER NOT NULL,'
        '    DESCRICAO   VARCHAR(64) NOT NULL,'
        '    TIPO        SMALLINT NOT NULL,'
        '    QUANTIDADE  INTEGER,'
        '    VALOR       T_VL_TODOS,'
        '    ENVIADO     CHAR(1)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE STATS ADD CONSTRAINT PK_STATS PRIMARY KEY (DIA, COD_' +
          'E, DESCRICAO, TIPO);'
        ''
        '|BLOCO|'
        'CREATE TABLE STATS_US ('
        '    DIA              TIMESTAMP NOT NULL,'
        '    COD_E            INTEGER NOT NULL,'
        '    USUARIO_HW       VARCHAR(32) NOT NULL,'
        '    USUARIO_WINDOWS  VARCHAR(32) NOT NULL,'
        '    SERIALHD         VARCHAR(8) NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'CREATE UNIQUE INDEX STATS_US_IDX ON STATS_US (DIA, COD_E, USUARI' +
          'O_HW, USUARIO_WINDOWS, SERIALHD);'
        ''
        '|BLOCO|'
        'CREATE TABLE STATS_CUSTOM ('
        '    ID            CHAR(36) NOT NULL,'
        '    COD_E         INTEGER NOT NULL,'
        '    NAME          VARCHAR(32) NOT NULL,'
        '    CUSTOMEXEC    BLOB SUB_TYPE 1 SEGMENT SIZE 1024,'
        '    CUSTOMSELECT  BLOB SUB_TYPE 1 SEGMENT SIZE 1024,'
        '    FREQUENCY     SMALLINT NOT NULL,                '
        '    SEQUPDATE     BIGINT,'
        '    LASTRUN       TIMESTAMP,'
        '    ATIVO         SMALLINT default 1'
        ');'
        '|/BLOCO|      '
        ''
        'ALTER TABLE STATS_CUSTOM ADD PRIMARY KEY (ID, COD_E);'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_STATS_INC'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_STATS_US '
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    NUM_FAB_PROD,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, pvp.num_fab_prod, pvp.unidade, pvp.descr_prod_ped, pvp.cod_g' +
          'rade, pvp.quant_ped_item,'
        
          'pvp.vlun_ped_item,pvp.vltot_ped_item, coalesce(pvp.rateio_desc,0' +
          ') as rateio_desc, coalesce(pvp.rateio_acresc,0) as rateio_acresc' +
          ', p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||pvs.cod_servico, null, null, pvs.cod_servico, nu' +
          'll, null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        
          'pvs.valor_un_serv, pvs.valor_tot_serv, coalesce(pvs.rateio_desc,' +
          '0) as rateio_desc, coalesce(pvs.rateio_acresc,0) as rateio_acres' +
          'c, null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', null,'
        
          'vpt.nped, '#39'PROD-T'#39', null, null, null, null, vpt.unidade, vpt.des' +
          'cricao, null, vpt.qtde,'
        
          'vpt.vl_unit, vpt.vl_total, 0, 0, null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39',null,'
        
          'vst.nped, '#39'SERV-T'#39', null, null, null, null, null, vst.descr_serv' +
          't, null, 1,'
        
          'vst.vl_servt, vst.vl_servt, 0, 0,null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VEICULO ('
        '    PCHASSI varchar(17),'
        '    PPLACA varchar(10),'
        '    PCODIGO integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    ICHASSI varchar(17),'
        '    IPLACA varchar(10),'
        '    ICODIGO integer,'
        '    ICOD_EMPRESA integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  pplaca = trim(coalesce(pplaca, '#39#39'));'
        '  pchassi = trim(coalesce(pchassi, '#39#39'));'
        '  pcodigo = coalesce(pcodigo, 0);'
        '  pcod_empresa = coalesce(pcod_empresa, 0);'
        ''
        '  iplaca = '#39#39';'
        '  ichassi = '#39#39';'
        '  icodigo = 0;'
        
          '  if ((trim(pchassi) <> '#39#39') and (trim(pplaca) <> '#39#39') and (pcodig' +
          'o > 0))  then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.placa = :pplaca'
        '    and veiculos.chassi = :pchassi'
        '    and veiculos.codigo = :pcodigo'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        ''
        
          '    if ((trim(ichassi) = '#39#39') or (trim(iplaca) = '#39#39') or (pcodigo ' +
          '<= 0))  then'
        '    begin'
        '      if ((trim(pplaca) <> '#39#39') and (trim(iplaca) = '#39#39')) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.placa = :pplaca'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '      if ((trim(pchassi) <> '#39#39') and (trim(ichassi) = '#39#39')) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.chassi = :pchassi'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '      if ((pcodigo > 0) and (icodigo <= 0)) then'
        '      begin'
        
          '        select first 1 veiculos.placa, veiculos.chassi, veiculos' +
          '.codigo, veiculos.cod_empresa from veiculos'
        '        where veiculos.codigo = :pcodigo'
        '        and veiculos.cod_empresa = :pcod_empresa'
        '        and veiculos.ativo <> 99'
        '            into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '      end'
        '    end'
        '  end'
        '  else if (trim(pplaca) <> '#39#39') then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.placa = :pplaca'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  else if (trim(pchassi) <> '#39#39') then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.chassi = :pchassi'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  else if (pcodigo > 0) then'
        '  begin'
        
          '    select first 1 veiculos.placa, veiculos.chassi, veiculos.cod' +
          'igo, veiculos.cod_empresa from veiculos'
        '    where veiculos.codigo = :pcodigo'
        '    and veiculos.cod_empresa = :pcod_empresa'
        '    and veiculos.ativo <> 99'
        '        into :iplaca, :ichassi, :icodigo, :icod_empresa;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VALOR_VENC_MIN('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    DATA)'
        'AS'
        'SELECT NREQUISICAO NPED,'
        'TPDOCS TIPO,'
        'COD_EMPRESA COD_EMPRESA,'
        'DATA_VENC DATA_VENC FROM FORMPAGAMENTO;'
        '|/BLOCO|'
        ''
        'ALTER TABLE FOTOS ADD GRUPO_PROD INTEGER;'
        'ALTER TABLE FOTOS ADD COD_PROD CHAR(6);'
        'ALTER TABLE FOTOS ADD COD_GRADE INTEGER;'
        'ALTER TABLE FOTOS ADD DATA_CAD TIMESTAMP;'
        
          'ALTER TABLE FOTOS ADD CONSTRAINT FK_FOTOS_PROD FOREIGN KEY (GRUP' +
          'O_PROD, COD_PROD, COD_EMPRESA) REFERENCES PRODUTOS (GRUPO_PROD, ' +
          'COD_PROD, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        
          'CREATE INDEX IDX_FOTOS_PED_PROD ON FOTOS (CODIGO, TIPO, COD_EMPR' +
          'ESA, GRUPO_PROD, COD_PROD, COD_GRADE);'
        'ALTER TABLE PEDVENDA ADD PREP_IMPRESSAO CHAR(1) DEFAULT '#39'N'#39';'
        
          'CREATE EXCEPTION EXC_PED_IMPRESSAO_TOTAL '#39'Erro ao efetuar somato' +
          'rio dos itens. Proceder novamente com a impressao'#39';'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  (select count(*) from pedvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39') quant_ped_item,'
        ''
        '  (select count(*) from pedvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39') quant_serv_ped,'
        ''
        '  (coalesce(pedvenda.acrescimo, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.acresc_item, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.acresc_item, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        '  (coalesce(pedvenda.desconto, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.desc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.desc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.desc_item, 0)) from pedvend' +
          'a_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.desc_item, 0)) from pedvend' +
          'a_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        '  ('
        
          '    coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '    coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_CALC_VL_SINT'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_CALC_VL_SINT_NF ('
        '    NF_ID integer,'
        '    EMPRESA_ID integer,'
        '    NITEM_ID integer)'
        'returns ('
        '    VNF double precision,'
        '    VBCICMS double precision,'
        '    VISENTO double precision,'
        '    VOUTRO double precision)'
        'as'
        '  declare variable VLIQ double precision;'
        '  declare variable VBC double precision;'
        '  declare variable VIMPOSTOS double precision;'
        '  declare variable CST char(3);'
        'begin'
        '  select coalesce(NFI.CST, '#39#39'),'
        
          '                  (NFI.VALOR_TOTAL + NFI.RATEIO_SEGURO + NFI.RAT' +
          'EIO_OUTDESP + iif(NF.FRETE_F_NFE = '#39'S'#39', 0, NFI.RATEIO_FRETE) + N' +
          'FI.VALOR_ICMSUB + NFI.FCP_VFCPST + NFI.VALOR_IPI + NFI.NFE_VIPID' +
          'EVOL - NFI.RATEIO_DESCONTO - iif(NF.TOTAIS_COM_DESON = '#39'N'#39', 0, N' +
          'FI.VICMDESON) - NFI.VPISDESON - NFI.VCOFINSDESON) VLIQ,'
        '         NFI.BASE_ICM VBC,'
        
          '         (NFI.VALOR_ICMSUB + NFI.FCP_VFCPST + NFI.VALOR_IPI + NF' +
          'I.NFE_VIPIDEVOL) VIMPOSTOS'
        '  from NOTAFISCAL_ITEM NFI'
        '    inner join NOTAFISCAL NF on NF.COD_NF = NFI.COD_NF and'
        '          NF.COD_EMPRESA = NFI.COD_EMPRESA'
        '  where NFI.COD_NF = :NF_ID and'
        '        NFI.COD_EMPRESA = :EMPRESA_ID and'
        '        NFI.NITEM = :NITEM_ID'
        '    into :CST, :VLIQ, :VBC, :VIMPOSTOS;'
        ''
        '  for select C.VNF, C.VBCICMS, C.VISENTO, C.VOUTRO'
        '    from RDB$DATABASE R'
        
          '    left join SP_CALC_VL_SINT(coalesce(:CST, '#39#39'), coalesce(:VLIQ' +
          ', 0), coalesce(:VBC, 0), coalesce(:VIMPOSTOS, 0)) as C on 1=1'
        '      into :VNF, :VBCICMS, :VISENTO, :VOUTRO'
        '    do'
        '    begin'
        '      suspend;'
        '    end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_COMISSAO_FAIXADESC ('
        '    PCOD_COMISSAO_FAIXA_DESC integer,'
        '    PCOD_EMPRESA integer,'
        '    PPERC_DESCONTO double precision,'
        '    PVALOR_ITEM double precision)'
        'returns ('
        '    ICODIGO_REGRA integer,'
        '    IDESCRICAO_REGRA varchar(50),'
        '    ITIPO_REGRA varchar(10),'
        '    IPERCENTUAL_REGRA double precision,'
        '    IPERCENTUAL_DESC double precision,'
        '    IVALOR_COMISSAO double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  icodigo_regra = 0;'
        '  idescricao_regra = '#39#39';'
        '  itipo_regra = '#39#39';'
        '  ipercentual_regra = 0;'
        '  ivalor_comissao = 0;'
        '  if (coalesce(pcod_comissao_faixa_desc, 0) > 0) then'
        '  begin'
        
          '      select first 1 cdesc.codigo, cdesc.descricao, cdesc.tipo, ' +
          'cperc.perc_comissao from comissao_faixa_desconto cdesc'
        '      inner join comissao_faixa_desconto_vig cvig on'
        '        cvig.codigo = cdesc.codigo'
        '        and cvig.cod_empresa = cdesc.cod_empresa'
        '        and current_date >= cvig.dtini_vig'
        '        and current_date <= cvig.dtfim_vig'
        '      inner join comissao_faixa_desconto_perc cperc on'
        '        cperc.cod_vig = cvig.cod_vig'
        '        and cperc.codigo = cvig.codigo'
        '        and cperc.cod_empresa = cvig.cod_empresa'
        '        and :pperc_desconto >= cperc.perc_desc_ini'
        '        and :pperc_desconto <= cperc.perc_desc_fim'
        '      where cdesc.codigo = :pcod_comissao_faixa_desc'
        '      and cdesc.cod_empresa = :pcod_empresa'
        
          '      and cdesc.ativo = 1 into :icodigo_regra, :idescricao_regra' +
          ', :itipo_regra, :ipercentual_regra;'
        '  end'
        '  if (coalesce(icodigo_regra, 0) <= 0) then'
        '  begin'
        
          '    select first 1 cdesc.codigo, cdesc.descricao, cdesc.tipo, cp' +
          'erc.perc_comissao from comissao_faixa_desconto cdesc'
        '    inner join comissao_faixa_desconto_vig cvig on'
        '      cvig.codigo = cdesc.codigo'
        '      and cvig.cod_empresa = cdesc.cod_empresa'
        '      and current_date >= cvig.dtini_vig'
        '      and current_date <= cvig.dtfim_vig'
        '    inner join comissao_faixa_desconto_perc cperc on'
        '      cperc.cod_vig = cvig.cod_vig'
        '      and cperc.codigo = cvig.codigo'
        '      and cperc.cod_empresa = cvig.cod_empresa'
        '      and :pperc_desconto >= cperc.perc_desc_ini'
        '      and :pperc_desconto <= cperc.perc_desc_fim'
        '    where cdesc.tipo = '#39'GERAL'#39
        '    and cdesc.cod_empresa = :pcod_empresa'
        
          '    and cdesc.ativo = 1 into :icodigo_regra, :idescricao_regra, ' +
          ':itipo_regra, :ipercentual_regra;'
        '  end'
        
          '  if ((coalesce(icodigo_regra, 0) > 0) and (coalesce(ipercentual' +
          '_regra, 0) > 0)) then'
        '  begin'
        
          '    ivalor_comissao = round(((coalesce(pvalor_item, 0) / 100) * ' +
          'coalesce(ipercentual_regra, 0)), 2);'
        '    ipercentual_desc = coalesce(pperc_desconto, 0);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'delete from config_sistema where chave = '#39'ped_vnd_impressao'#39';'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER PEDVENDA_BIU_CONF_TOTAL FOR PEDVENDA'
        'ACTIVE BEFORE UPDATE POSITION 0'
        'AS'
        '  declare variable vverificar_total char(1);'
        '  declare variable val_tot t_vl_todos;'
        '  declare variable val_acr t_vl_todos;'
        '  declare variable val_des t_vl_todos;'
        '  declare variable sum_prod t_vl_todos;'
        '  declare variable sum_serv t_vl_todos;'
        '  declare variable sum_total t_vl_todos;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  vverificar_total = '#39'N'#39';'
        
          '  if ((coalesce(old.status_ped, '#39#39') <> '#39'FECHADA'#39') and (coalesce(' +
          'new.status_ped, '#39#39') = '#39'FECHADA'#39')) then'
        '    vverificar_total = '#39'S'#39';'
        
          '  else if ((coalesce(old.prep_impressao, '#39'N'#39') <> coalesce(new.pr' +
          'ep_impressao, '#39'S'#39')) and (coalesce(new.prep_impressao, '#39'S'#39') = '#39'S'#39 +
          ')) then'
        '    vverificar_total = '#39'S'#39';'
        ''
        '  if (trim(vverificar_total) = '#39'S'#39') then'
        '  begin'
        '    sum_prod = 0;'
        '    sum_serv = 0;'
        '    sum_total = 0;'
        ''
        '    --Produtos'
        '    select sum(coalesce(pvp.vltot_ped_item, 0)),'
        '      sum(coalesce(pvp.rateio_desc, 0)),'
        '      sum(coalesce(pvp.rateio_acresc, 0)) from pedvenda_prod pvp'
        
          '      where pvp.nped = new.nped and pvp.tipo = new.tipo and pvp.' +
          'cod_empresa = new.cod_empresa'
        '        and coalesce(pvp.status, '#39#39') = '#39#39
        '        into :val_tot, :val_des, val_acr;'
        ''
        '    sum_prod = coalesce(val_tot, 0);'
        
          '    sum_total = coalesce(sum_total, 0) + coalesce(val_tot, 0) + ' +
          'coalesce(val_acr, 0) - coalesce(val_des, 0);'
        ''
        '    --Servicos'
        '    select sum(coalesce(pvs.valor_tot_serv, 0)),'
        '      sum(coalesce(pvs.rateio_desc, 0)),'
        '      sum(coalesce(pvs.rateio_acresc, 0)) from pedvenda_serv pvs'
        
          '      where pvs.nped = new.nped and pvs.tipo = new.tipo and pvs.' +
          'cod_empresa = new.cod_empresa'
        '        and coalesce(pvs.status, '#39#39') = '#39#39
        '        into :val_tot, :val_des, val_acr;'
        ''
        '    sum_serv = coalesce(val_tot, 0);'
        
          '    sum_total = coalesce(sum_total, 0) + coalesce(val_tot, 0) + ' +
          'coalesce(val_acr, 0) - coalesce(val_des, 0);'
        ''
        '    --Produtos Terceiro'
        '    select sum(coalesce(pvpt.vl_total, 0)),'
        '      sum(0),'
        '      sum(0) from pedvenda_prod_terc pvpt'
        
          '      where pvpt.nped = new.nped and pvpt.tipo = new.tipo and pv' +
          'pt.cod_empresa = new.cod_empresa'
        '        into :val_tot, :val_des, val_acr;'
        ''
        
          '    sum_total = coalesce(sum_total, 0) + coalesce(val_tot, 0) + ' +
          'coalesce(val_acr, 0) - coalesce(val_des, 0);'
        ''
        '    --Servicos Terceiro'
        '    select sum(coalesce(pvt.vl_servt, 0)),'
        '      sum(0),'
        '      sum(0) from pedvenda_serv_terc pvt'
        
          '      where pvt.nped = new.nped and pvt.tipo = new.tipo and pvt.' +
          'cod_empresa = new.cod_empresa'
        '        into :val_tot, :val_des, val_acr;'
        ''
        
          '    sum_total = coalesce(sum_total, 0) + coalesce(val_tot, 0) + ' +
          'coalesce(val_acr, 0) - coalesce(val_des, 0);'
        ''
        '    if (round(sum_total, 2) <> round(new.valor_total, 2)) then'
        '    begin'
        
          '      if ((coalesce(old.status_ped, '#39#39') <> '#39'FECHADA'#39') and (coale' +
          'sce(new.status_ped, '#39#39') = '#39'FECHADA'#39')) then'
        '        exception EXC_PED_CONF_TOTAL;'
        
          '      else if ((coalesce(old.prep_impressao, '#39'N'#39') <> coalesce(ne' +
          'w.prep_impressao, '#39'N'#39')) and (coalesce(new.prep_impressao, '#39'N'#39') =' +
          ' '#39'S'#39')) then'
        '        exception EXC_PED_IMPRESSAO_TOTAL;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure INCREMENTA_CODIGO ('
        '    VCOD_EMPRESA integer,'
        '    VTABELA varchar(32))'
        'returns ('
        '    COD integer)'
        'as'
        '  declare variable TAB varchar(32);'
        'begin'
        '  select distinct(TABELA)'
        '  from CODIGO'
        '  where TABELA = :VTABELA and'
        '        COD_EMPRESA = :VCOD_EMPRESA'
        '    into :TAB;'
        ''
        '  if (:TAB is null) then'
        '    insert into CODIGO (TABELA, COD_EMPRESA, VALOR)'
        '    values (:VTABELA, :VCOD_EMPRESA, 0);'
        ''
        '  update CODIGO'
        '  set VALOR = coalesce(VALOR, 0) + 1'
        '  where TABELA = :VTABELA and'
        '        COD_EMPRESA = :VCOD_EMPRESA;'
        ''
        '  select VALOR'
        '  from CODIGO'
        '  where TABELA = :VTABELA and'
        '        COD_EMPRESA = :VCOD_EMPRESA'
        '    into :COD;'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER trigger nfce_pagamento_biu1_codnfce_trc for nfce' +
          '_pagamento'
        'active before insert or update position 1'
        'AS'
        '  declare variable nfceId integer;'
        '  declare variable status varchar(10);'
        '  declare variable situacao varchar(16);'
        'begin'
        '  if (trim(coalesce(new.guid_tr_cartao, '#39#39')) = '#39#39') then'
        '    exit;'
        ''
        '  select nfce.status, nfce.situacao_nfce from nfce'
        
          '    where nfce.cod_nfce = new.cod_nfce and nfce.cod_empresa = ne' +
          'w.cod_empresa'
        '  into :status, :situacao;'
        ''
        '  if (coalesce(status, '#39#39') <> '#39'Fechada'#39') then'
        '    exit;'
        ''
        
          '  if (coalesce(situacao, '#39#39') in ('#39'Cancelada'#39', '#39'Denegada'#39', '#39'Inuti' +
          'lizada'#39')) then'
        '    exit;'
        ''
        '  select nrequisicao from transacao_cartao'
        
          '    where guidt = new.guid_tr_cartao and cod_empresa = new.cod_e' +
          'mpresa and tpdocs = '#39'NFCE'#39
        '  into :nfceid;'
        ''
        '  if (coalesce(nfceid, 0) = 0) then'
        '    exit;'
        ''
        '  if (nfceid <> new.cod_nfce) then'
        '    update transacao_cartao set nrequisicao = new.cod_nfce'
        
          '      where guidt = new.guid_tr_cartao and cod_empresa = new.cod' +
          '_empresa and tpdocs = '#39'NFCE'#39';'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        
          'CREATE OR ALTER trigger transacao_cartao_biu_codnfce for transac' +
          'ao_cartao'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER trigger transacao_cartao_biu_codnfce for transac' +
          'ao_cartao'
        'active before insert or update position 0'
        'AS'
        '  declare variable nfceId integer;'
        'begin'
        
          '  if ((new.tpdocs <> '#39'NFCE'#39') or (trim(coalesce(new.guidt, '#39#39')) =' +
          ' '#39#39'))  then'
        '    exit;'
        ''
        '  select first 1 cod_nfce from nfce_pagamento'
        
          '    where guid_tr_cartao = new.guidt and cod_empresa = new.cod_e' +
          'mpresa'
        '    order by cod_nfce desc'
        '  into :nfceid;'
        ''
        '  if (coalesce(nfceid, 0) = 0) then'
        '    exit;'
        ''
        '  if (nfceid <> new.nrequisicao) then'
        '    new.nrequisicao = nfceid;'
        'end'
        ''
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW CODIGO_FORNECEDOR_VW('
        '    SEQID,'
        '    COD_EMPRESA,'
        '    COD_FORNECEDOR,'
        '    CPFCGC,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NUM_FAB_FORNECEDOR,'
        '    ATIVO,'
        '    DATA_CADASTRO,'
        '    DATA_MODIFICACAO,'
        '    COD_GRADE,'
        '    TABELA)'
        'AS'
        'select 0, PRODUTOS_FORN_NFE2.COD_EMPRESA,'
        '       0 COD_FORNECEDOR, PRODUTOS_FORN_NFE2.CPFCGC,'
        
          '       PRODUTOS_FORN_NFE2.GRUPO_PROD, PRODUTOS_FORN_NFE2.COD_PRO' +
          'D, PRODUTOS_FORN_NFE2.NUM_FAB_FORNECEDOR,'
        
          '       PRODUTOS_FORN_NFE2.ATIVO, PRODUTOS_FORN_NFE2.DATA_CADASTR' +
          'O, PRODUTOS_FORN_NFE2.DATA_MODIFICACAO,'
        '       PRODUTOS_FORN_NFE2.COD_GRADE, '#39'PRODUTOS_FORN_NFE2'#39' TABELA'
        'from PRODUTOS_FORN_NFE2'
        
          'INNER JOIN PRODUTOS ON PRODUTOS.GRUPO_PROD = PRODUTOS_FORN_NFE2.' +
          'GRUPO_PROD'
        '    AND PRODUTOS.COD_PROD = PRODUTOS_FORN_NFE2.COD_PROD'
        '    AND PRODUTOS.COD_EMPRESA = PRODUTOS_FORN_NFE2.COD_EMPRESA'
        'WHERE PRODUTOS.ATIVO <> 99'
        'union'
        'select PRODUTOS_FORN_NFE.SEQID, PRODUTOS_FORN_NFE.COD_EMPRESA,'
        '       PRODUTOS_FORN_NFE.COD_FORNECEDOR, CLIENTES.CPFCGC,'
        
          '       PRODUTOS_FORN_NFE.GRUPO_PROD, PRODUTOS_FORN_NFE.COD_PROD,' +
          ' PRODUTOS_FORN_NFE.NUM_FAB_FORNECEDOR,'
        
          '       PRODUTOS_FORN_NFE.ATIVO, PRODUTOS_FORN_NFE.DATA_CADASTRO,' +
          ' PRODUTOS_FORN_NFE.DATA_MODIFICACAO,'
        '       PRODUTOS_FORN_NFE.COD_GRADE, '#39'PRODUTOS_FORN_NFE'#39' TABELA'
        'from PRODUTOS_FORN_NFE'
        
          'INNER JOIN CLIENTES ON CLIENTES.COD_CLIENTE = PRODUTOS_FORN_NFE.' +
          'COD_FORNECEDOR'
        '    AND CLIENTES.COD_EMPRESA = PRODUTOS_FORN_NFE.COD_EMPRESA'
        
          'INNER JOIN PRODUTOS ON PRODUTOS.GRUPO_PROD = PRODUTOS_FORN_NFE.G' +
          'RUPO_PROD'
        '    AND PRODUTOS.COD_PROD = PRODUTOS_FORN_NFE.COD_PROD'
        '    AND PRODUTOS.COD_EMPRESA = PRODUTOS_FORN_NFE.COD_EMPRESA'
        'WHERE PRODUTOS.ATIVO <> 99'
        'union'
        'select 0 SEQID, CODIGO_FORNECEDOR.COD_EMPRESA,'
        '       CODIGO_FORNECEDOR.COD_FORNECEDOR, CLIENTES.CPFCGC,'
        
          '       CODIGO_FORNECEDOR.GRUPO_PROD, CODIGO_FORNECEDOR.COD_PROD,' +
          ' cast(CODIGO_FORNECEDOR.NUM_FAB_FORNECEDOR as varchar(60)),'
        
          '       CODIGO_FORNECEDOR.ATIVO, CODIGO_FORNECEDOR.DATA_CADASTRO,' +
          ' CODIGO_FORNECEDOR.DATA_MODIFICACAO,'
        '       CODIGO_FORNECEDOR.COD_GRADE, '#39'CODIGO_FORNECEDOR'#39' TABELA'
        'from CODIGO_FORNECEDOR'
        
          'INNER JOIN CLIENTES ON CLIENTES.COD_CLIENTE = CODIGO_FORNECEDOR.' +
          'COD_FORNECEDOR'
        '    AND CLIENTES.COD_EMPRESA = CODIGO_FORNECEDOR.COD_EMPRESA'
        
          'INNER JOIN PRODUTOS ON PRODUTOS.GRUPO_PROD = CODIGO_FORNECEDOR.G' +
          'RUPO_PROD'
        '    AND PRODUTOS.COD_PROD = CODIGO_FORNECEDOR.COD_PROD'
        '    AND PRODUTOS.COD_EMPRESA = CODIGO_FORNECEDOR.COD_EMPRESA'
        'WHERE PRODUTOS.ATIVO <> 99;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_DTEC_PRODUTOS_EC FOR PRODUTOS_EC'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS '
        ' DECLARE VARIABLE ECOMMERCE INTEGER;'
        ' DECLARE VARIABLE ESTMANUAL_ECOMMERCE INTEGER;'
        ' DECLARE VARIABLE VSEQID BIGINT; '
        ' DECLARE VARIABLE CAMPOS_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VALORES_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VDELETE INTEGER;'
        ' DECLARE VARIABLE VESTOQUE DOUBLE PRECISION DEFAULT 00000.00;'
        
          ' DECLARE VARIABLE VQUANT_MAT_PRIMA DOUBLE PRECISION DEFAULT 0000' +
          '0.00;'
        ' DECLARE VARIABLE VQUANT_TEMP DOUBLE PRECISION DEFAULT 00000.00;'
        ' DECLARE VARIABLE VTIPO_ITEM CHAR(2);'
        ' DECLARE VARIABLE VMATERIA_PRIMA INTEGER;'
        'begin '
        '  /* Trigger text */ '
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit; '
        ''
        '  VDELETE = 0; '
        '  if (updating) then '
        
          '    if (coalesce(old.sinc_ecommerce, '#39'N'#39') <> (coalesce(new.sinc_' +
          'ecommerce, '#39'N'#39')) '
        
          '     and (coalesce(old.sinc_ecommerce, '#39'N'#39') = '#39'S'#39') and (coalesce' +
          '(new.sinc_ecommerce, '#39'N'#39') = '#39'N'#39')) then '
        '      VDELETE = 1; '
        ''
        '  if (deleting) then '
        '    VDELETE = 1; '
        ''
        '  if ((inserting)or(updating)) then'
        '  begin'
        '    SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO: ECOMM' +
          'ERCE;'
        ''
        '    SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        
          '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_controle_est_manual' +
          #39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO: ESTMA' +
          'NUAL_ECOMMERCE;'
        ''
        '    SELECT COALESCE(TIPO_ITEM, '#39'00'#39') FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = NEW.GRUPO_PROD AND COD_PROD = NEW.COD_PRO' +
          'D AND COD_EMPRESA = NEW.COD_EMPRESA INTO: VTIPO_ITEM;'
        '  end'
        '  else if (deleting) then'
        '  begin'
        '    SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = OLD.COD_EMPRESA INTO: ECOMM' +
          'ERCE;'
        '  end'
        ''
        '  if (vdelete > 0) then '
        '  begin '
        '    if (COALESCE(OLD.ID_COMMERCE, 0) <= 0) then '
        '     exit; '
        ''
        
          '    SELECT GEN_ID(SEQ_DEL_EC, 1) FROM RDB$DATABASE INTO :VSEQID;' +
          ' '
        '    CAMPOS_CHAVE =  '#39'|GRUPO_PROD|COD_PROD|COD_EMPRESA|'#39'; '
        
          '    VALORES_CHAVE = '#39'|'#39'||OLD.GRUPO_PROD||'#39'|'#39'||OLD.COD_PROD||'#39'|'#39'|' +
          '|OLD.COD_EMPRESA||'#39'|'#39'; '
        
          '    INSERT INTO DEL_EC(SEQID, COD_EMPRESA, TABELA, DATA_HORA_ALT' +
          '_WS, CAMPOS_CHAVE, VALORES_CHAVE, ID_COMMERCE)  '
        
          '    VALUES(:VSEQID, old.COD_EMPRESA, '#39'PRODUTOS_EC'#39', CURRENT_TIME' +
          'STAMP, :CAMPOS_CHAVE, :VALORES_CHAVE, OLD.ID_COMMERCE); '
        '    NEW.ID_COMMERCE = 0;'
        '  end '
        '  else if ((inserting)or(updating)) then '
        '  begin '
        
          '    NEW.SEQID_EC = (SELECT GEN_ID(SEQ_EC_PRODUTOS_EC, 1) FROM RD' +
          'B$DATABASE); '
        ''
        
          '    if ((updating) and (COALESCE(ESTMANUAL_ECOMMERCE, 0) <= 0)) ' +
          'then'
        '    begin'
        '      /* Alterar estoque produto acabado */'
        
          '      if ((coalesce(vtipo_item, '#39'00'#39') = '#39'04'#39') and (coalesce(new.' +
          'variacao, '#39'N'#39') = '#39'N'#39')) then'
        '      begin'
        '        vmateria_prima = 0;'
        '        vquant_temp = coalesce(new.estoque_ec, 0);'
        ''
        '        for select distinct'
        '          coalesce(ind.quant, 0) quant,'
        
          '          coalesce(est.estoque, 0) estoque from indice_tecnico i' +
          'nd'
        '        inner join produtos_pdc_var prodac on'
        '          prodac.grupo_prod = ind.grupo_prod_acabado'
        '          and prodac.cod_prod = ind.cod_prod_acabado'
        '          and prodac.cod_empresa = ind.cod_empresa'
        '        inner join produtos_pdc_var_it prodit on'
        '          prodit.id_ind = prodac.id_ind'
        '          and prodit.grupo_prod = ind.grupo_prod_mprima'
        '          and prodit.cod_prod = ind.cod_prod_mprima'
        '          and prodit.cod_empresa = ind.cod_empresa'
        '        left join getestoquedisponivel('
        '          ind.grupo_prod_mprima,'
        '          ind.cod_prod_mprima,'
        '          coalesce(prodit.cod_grade, 0),'
        '          ind.cod_empresa,'
        '          0,'
        '          '#39#39','
        '          0,'
        '          0) est on 1 = 1'
        '        where ind.grupo_prod_acabado = new.grupo_prod'
        '        and ind.cod_prod_acabado = new.cod_prod'
        '        and ind.cod_empresa = new.cod_empresa'
        '        union'
        '        select distinct'
        '          coalesce(ind.quant, 0) quant,'
        
          '          coalesce(est.estoque, 0) estoque from indice_tecnico i' +
          'nd'
        '        left join cod_grade_prod cprod on'
        '          cprod.grupo_prod = ind.grupo_prod_mprima'
        '          and cprod.cod_prod = ind.cod_prod_mprima'
        '          and cprod.cod_empresa = ind.cod_empresa'
        '        left join getestoquedisponivel('
        '          ind.grupo_prod_mprima,'
        '          ind.cod_prod_mprima,'
        '          coalesce(cprod.cod_grade, 0),'
        '          ind.cod_empresa,'
        '          0,'
        '          '#39#39','
        '          0,'
        '          0) est on 1 = 1'
        '        where ind.grupo_prod_acabado = new.grupo_prod'
        '        and ind.cod_prod_acabado = new.cod_prod'
        '        and ind.cod_empresa = new.cod_empresa'
        '        and (select count(*) from produtos_pdc_var prodac2'
        '             inner join produtos_pdc_var_it prodit2 on'
        '                prodit2.id_ind = prodac2.id_ind'
        '                and prodit2.grupo_prod = ind.grupo_prod_mprima'
        '                and prodit2.cod_prod = ind.cod_prod_mprima'
        '                and prodit2.cod_empresa = prodac2.cod_empresa'
        '             where prodac2.grupo_prod = ind.grupo_prod_acabado'
        '                and prodac2.cod_prod = ind.cod_prod_acabado'
        '                and prodac2.cod_grade = 0'
        '                and prodac2.cod_empresa = ind.cod_empresa) = 0'
        ''
        '          into :vquant_mat_prima, :vestoque do'
        '        begin'
        '          if (vmateria_prima = 0) then'
        '            if (coalesce(vestoque, 0) > 0) then'
        
          '              vquant_temp = (coalesce(vestoque, 0) / coalesce(vq' +
          'uant_mat_prima, 0));'
        '            else'
        '              vquant_temp = 0;'
        ''
        
          '          if ((coalesce(vestoque, 0) / coalesce(vquant_mat_prima' +
          ', 0)) < (coalesce(vquant_temp, 0))) then'
        '            if (coalesce(vestoque, 0) > 0) then'
        
          '              vquant_temp = (coalesce(vestoque, 0) / coalesce(vq' +
          'uant_mat_prima, 0));'
        '            else'
        '              vquant_temp = 0;'
        ''
        '          vmateria_prima = 1;'
        '        end'
        '        new.estoque_ec = trunc(coalesce(vquant_temp, 0));'
        '      end'
        '    end'
        '  end '
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_DTEC_PRODUTOS_EC_GRADE FOR PRODUTOS_E' +
          'C_GRADE'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS'
        ' DECLARE VARIABLE ECOMMERCE INTEGER;'
        ' DECLARE VARIABLE ESTMANUAL_ECOMMERCE INTEGER;'
        ' DECLARE VARIABLE ID_COMMERCE INTEGER;'
        ' DECLARE VARIABLE VSEQID BIGINT;'
        ' DECLARE VARIABLE CAMPOS_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VALORES_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VDELETE INTEGER;'
        ' DECLARE VARIABLE VESTOQUE DOUBLE PRECISION DEFAULT 00000.00;'
        
          ' DECLARE VARIABLE VQUANT_MAT_PRIMA DOUBLE PRECISION DEFAULT 0000' +
          '0.00;'
        ' DECLARE VARIABLE VQUANT_TEMP DOUBLE PRECISION DEFAULT 00000.00;'
        ' DECLARE VARIABLE VVARIACAO CHAR(1);'
        ' DECLARE VARIABLE VTIPO_ITEM CHAR(2);'
        ' DECLARE VARIABLE VMATERIA_PRIMA INTEGER;'
        'begin '
        '  /* Trigger text */ '
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit; '
        ''
        '  VDELETE = 0; '
        '  if (updating) then '
        
          '    if (coalesce(old.sinc_ecommerce, '#39'N'#39') <> (coalesce(new.sinc_' +
          'ecommerce, '#39'N'#39')) '
        
          '     and (coalesce(old.sinc_ecommerce, '#39'N'#39') = '#39'S'#39') and (coalesce' +
          '(new.sinc_ecommerce, '#39'N'#39') = '#39'N'#39')) then '
        '      VDELETE = 1; '
        ''
        '  if (deleting) then '
        '    VDELETE = 1; '
        ''
        '  if ((inserting)or(updating)) then '
        '  begin'
        '    SELECT CONFIG_SISTEMA.VALUE1_F from CONFIG_SISTEMA'
        '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO :ECOMM' +
          'ERCE;'
        ''
        '    SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        
          '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_controle_est_manual' +
          #39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO: ESTMA' +
          'NUAL_ECOMMERCE;'
        '    '
        
          '    SELECT PRODUTOS_EC.ID_COMMERCE, PRODUTOS_EC.VARIACAO from PR' +
          'ODUTOS_EC'
        '    WHERE PRODUTOS_EC.GRUPO_PROD = NEW.GRUPO_PROD'
        '    AND PRODUTOS_EC.COD_PROD = NEW.COD_PROD'
        
          '    AND PRODUTOS_EC.COD_EMPRESA = NEW.COD_EMPRESA INTO :ID_COMME' +
          'RCE, :VVARIACAO;'
        ''
        '    SELECT COALESCE(TIPO_ITEM, '#39'00'#39') FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = NEW.GRUPO_PROD AND COD_PROD = NEW.COD_PRO' +
          'D AND COD_EMPRESA = NEW.COD_EMPRESA INTO: VTIPO_ITEM;'
        '  end'
        '  else if (deleting) then'
        '  begin'
        '    SELECT CONFIG_SISTEMA.VALUE1_F from CONFIG_SISTEMA'
        '    WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '    AND CONFIG_SISTEMA.COD_EMPRESA = OLD.COD_EMPRESA INTO :ECOMM' +
          'ERCE;'
        '    '
        '    SELECT PRODUTOS_EC.ID_COMMERCE from PRODUTOS_EC'
        '    WHERE PRODUTOS_EC.GRUPO_PROD = OLD.GRUPO_PROD'
        '    AND PRODUTOS_EC.COD_PROD = OLD.COD_PROD'
        
          '    AND PRODUTOS_EC.COD_EMPRESA = OLD.COD_EMPRESA INTO :ID_COMME' +
          'RCE;'
        '  end'
        ''
        '  if (vdelete > 0) then '
        '  begin '
        '    if (COALESCE(OLD.ID_COMMERCE, 0) <= 0) then '
        '     exit; '
        ''
        
          '    SELECT GEN_ID(SEQ_DEL_EC, 1) FROM RDB$DATABASE INTO :VSEQID;' +
          ' '
        
          '    CAMPOS_CHAVE =  '#39'|GRUPO_PROD|COD_PROD|COD_GRADE|COD_EMPRESA|' +
          #39'; '
        
          '    VALORES_CHAVE = '#39'|'#39'||OLD.GRUPO_PROD||'#39'|'#39'||OLD.COD_PROD||'#39'|'#39'|' +
          '|OLD.COD_GRADE||'#39'|'#39'||OLD.COD_EMPRESA||'#39'|'#39'; '
        
          '    INSERT INTO DEL_EC(SEQID, COD_EMPRESA, TABELA, DATA_HORA_ALT' +
          '_WS, CAMPOS_CHAVE, VALORES_CHAVE, ID_COMMERCE)  '
        
          '    VALUES(:VSEQID, old.COD_EMPRESA, '#39'PRODUTOS_EC_GRADE'#39', CURREN' +
          'T_TIMESTAMP, :CAMPOS_CHAVE, :VALORES_CHAVE, OLD.ID_COMMERCE); '
        '    NEW.ID_COMMERCE = 0;'
        '  end '
        '  else if ((inserting)or(updating)) then '
        '  begin '
        
          '    NEW.SEQID_EC = (SELECT GEN_ID(SEQ_EC_PRODUTOS_EC_GRADE, 1) F' +
          'ROM RDB$DATABASE); '
        ''
        
          '    if ((updating) and (COALESCE(ESTMANUAL_ECOMMERCE, 0) <= 0)) ' +
          'then'
        '    begin'
        '      /* Alterar estoque produto acabado */'
        
          '      if ((coalesce(vtipo_item, '#39'00'#39') = '#39'04'#39') and (coalesce(vvar' +
          'iacao, '#39'N'#39') = '#39'S'#39')) then'
        '      begin'
        '        vmateria_prima = 0;'
        '        vquant_temp = coalesce(new.estoque_ec, 0);'
        ''
        '        for select distinct'
        '          coalesce(ind.quant, 0) quant,'
        
          '          coalesce(est.estoque, 0) estoque from indice_tecnico i' +
          'nd'
        '        inner join produtos_pdc_var prodac on'
        '          prodac.grupo_prod = ind.grupo_prod_acabado'
        '          and prodac.cod_prod = ind.cod_prod_acabado'
        '          and prodac.cod_grade = new.cod_grade'
        '          and prodac.cod_empresa = ind.cod_empresa'
        '        inner join produtos_pdc_var_it prodit on'
        '          prodit.id_ind = prodac.id_ind'
        '          and prodit.grupo_prod = ind.grupo_prod_mprima'
        '          and prodit.cod_prod = ind.cod_prod_mprima'
        '          and prodit.cod_empresa = ind.cod_empresa'
        '        left join getestoquedisponivel('
        '          ind.grupo_prod_mprima,'
        '          ind.cod_prod_mprima,'
        '          coalesce(prodit.cod_grade, 0),'
        '          ind.cod_empresa,'
        '          0,'
        '          '#39#39','
        '          0,'
        '          0) est on 1 = 1'
        '        where ind.grupo_prod_acabado = new.grupo_prod'
        '        and ind.cod_prod_acabado = new.cod_prod'
        '        and ind.cod_empresa = new.cod_empresa'
        '        union'
        '        select distinct'
        '          coalesce(ind.quant, 0) quant,'
        
          '          coalesce(est.estoque, 0) estoque from indice_tecnico i' +
          'nd'
        '        left join cod_grade_prod acab on'
        '          acab.grupo_prod = ind.grupo_prod_acabado'
        '          and acab.cod_prod = ind.cod_prod_acabado'
        '          and acab.cod_grade = new.cod_grade'
        '          and acab.cod_empresa = ind.cod_empresa'
        '        left join cod_grade_prod cprod on'
        '          cprod.grupo_prod = ind.grupo_prod_mprima'
        '          and cprod.cod_prod = ind.cod_prod_mprima'
        '          and cprod.cod_empresa = ind.cod_empresa'
        '        left join getestoquedisponivel('
        '          ind.grupo_prod_mprima,'
        '          ind.cod_prod_mprima,'
        '          coalesce(cprod.cod_grade, 0),'
        '          ind.cod_empresa,'
        '          0,'
        '          '#39#39','
        '          0,'
        '          0) est on 1 = 1'
        '        where ind.grupo_prod_acabado = new.grupo_prod'
        '        and ind.cod_prod_acabado = new.cod_prod'
        '        and ind.cod_empresa = new.cod_empresa'
        '        and (select count(*) from produtos_pdc_var prodac2'
        '             where prodac2.grupo_prod = ind.grupo_prod_acabado'
        '                and prodac2.cod_prod = ind.cod_prod_acabado'
        
          '                and prodac2.cod_grade = coalesce(acab.cod_grade,' +
          ' 0)'
        '                and prodac2.cod_empresa = ind.cod_empresa) = 0'
        ''
        '          into :vquant_mat_prima, :vestoque do'
        '        begin'
        '          if (vmateria_prima = 0) then'
        '            if (coalesce(vestoque, 0) > 0) then'
        
          '              vquant_temp = (coalesce(vestoque, 0) / coalesce(vq' +
          'uant_mat_prima, 0));'
        '            else'
        '              vquant_temp = 0;'
        ''
        
          '          if ((coalesce(vestoque, 0) / coalesce(vquant_mat_prima' +
          ', 0)) < (coalesce(vquant_temp, 0))) then'
        '            if (coalesce(vestoque, 0) > 0) then'
        
          '              vquant_temp = (coalesce(vestoque, 0) / coalesce(vq' +
          'uant_mat_prima, 0));'
        '            else'
        '              vquant_temp = 0;'
        ''
        '          vmateria_prima = 1;'
        '        end'
        '        new.estoque_ec = trunc(coalesce(vquant_temp, 0));'
        ''
        '        if (vmateria_prima > 0) then'
        '        begin'
        '          update produtos_ec set produtos_ec.estoque_ec ='
        
          '            coalesce((select sum(coalesce(produtos_ec_grade.esto' +
          'que_ec, 0)) from produtos_ec_grade'
        
          '                      where produtos_ec_grade.grupo_prod = new.g' +
          'rupo_prod'
        
          '                      and produtos_ec_grade.cod_prod = new.cod_p' +
          'rod'
        
          '                      and produtos_ec_grade.cod_empresa = new.co' +
          'd_empresa), 0)'
        '          where produtos_ec.grupo_prod = new.grupo_prod'
        '          and produtos_ec.cod_prod = new.cod_prod'
        '          and produtos_ec.cod_empresa = new.cod_empresa;'
        '        end'
        '      end'
        '    end'
        '  end '
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|delete from config_sistema where chave = '#39'ped_vnd_impre' +
          'ssao_dav'#39' and value1_vc is null;'
        ''
        '|BLOCO|'
        'create or alter procedure SP_CALC_VL_SINT ('
        '    CST varchar(3),'
        '    VLIQ double precision,'
        '    VBC double precision,'
        '    VIMPOSTOS double precision)'
        'returns ('
        '    VNF double precision,'
        '    VBCICMS double precision,'
        '    VISENTO double precision,'
        '    VOUTRO double precision)'
        'as'
        '  declare variable VLIQSEMIMPOSTO double precision;'
        'begin'
        '  vnf = vliq;'
        '  vbcicms = vbc;'
        '  visento = 0;'
        '  voutro = 0;'
        '  if (char_length(cst) = 3) then'
        '    cst = substring(cst from 2 for 1);'
        '  else if (char_length(cst) = 2) then'
        '    cst = substring(cst from 1 for 1);'
        ''
        '  if (vbc < vliq ) then'
        '  begin'
        '    vliqsemimposto = vliq - VIMPOSTOS;'
        '    if (cst in ('#39'2'#39', '#39'3'#39', '#39'4'#39', '#39'7'#39', '#39'9'#39')) then'
        
          '      visento = iif(vliqsemimposto > vbc, vliqsemimposto - vbc, ' +
          '0);'
        ''
        '    voutro = vliq - vbc - visento;'
        '  end'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        
          'CREATE OR ALTER trigger notafiscal_item_biu_sint_calc for notafi' +
          'scal_item'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER trigger notafiscal_item_biu_sint_calc for notafi' +
          'scal_item'
        'active before insert or update position 10'
        'AS'
        '  declare variable vliq double precision;'
        '  declare variable vimpostos double precision;'
        '  declare variable vbc double precision;'
        '  declare variable cst char(3);'
        'begin  '
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  select first 1'
        
          '         (iif(nf.frete_f_nfe = '#39'S'#39', 0, coalesce(new.rateio_frete' +
          ', 0)) - iif(nf.totais_com_deson = '#39'N'#39', 0, coalesce(new.vicmdeson' +
          ', 0))),'
        
          '         (iif(new.tipo_item = '#39'S'#39', coalesce(new.base_iss, 0), co' +
          'alesce(new.base_icm, 0)))'
        '  from notafiscal_item nfi'
        
          '    inner join notafiscal nf on nf.cod_nf = nfi.cod_nf and nf.co' +
          'd_empresa = nfi.cod_empresa'
        
          '  where nfi.cod_nf = new.cod_nf and nfi.cod_empresa = new.cod_em' +
          'presa and nfi.nitem = new.nitem'
        '    into :vliq, :vbc;'
        ''
        '  vliq =   coalesce(vliq, 0)'
        '         + coalesce(new.valor_total, 0)'
        '         + coalesce(new.rateio_seguro, 0)'
        '         + coalesce(new.rateio_outdesp, 0)'
        '         + coalesce(new.valor_icmsub, 0)'
        '         + coalesce(new.fcp_vfcpst, 0)'
        '         + coalesce(new.valor_ipi, 0)'
        '         + coalesce(new.nfe_vipidevol, 0)'
        '         - coalesce(new.rateio_desconto, 0)'
        '         - coalesce(new.vpisdeson, 0)'
        '         - coalesce(new.vcofinsdeson, 0);'
        ''
        '  vimpostos = + coalesce(new.valor_icmsub, 0)'
        '              + coalesce(new.fcp_vfcpst, 0)'
        '              + coalesce(new.valor_ipi, 0)'
        '              + coalesce(new.nfe_vipidevol, 0);'
        ''
        '  vbc = coalesce(vbc, 0);'
        ''
        '  cst = iif(new.tipo_item = '#39'S'#39', '#39'040'#39', new.cst);'
        '  '
        
          '  select c.visento, c.voutro, 0 from sp_calc_vl_sint(:cst, :vliq' +
          ', :vbc, :vimpostos) as c'
        '    into new.vlisento, new.vloutras, new.vln_trib;'
        ''
        '  vbc = 0;'
        'end'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRODUTOS_EC ADD TITULO_PAGINA VARCHAR(131);'
        'ALTER TABLE PRODUTOS_EC ADD PALAVRAS_CHAVES VARCHAR(131);'
        
          'CMD:REPL|delete from config_sistema where chave = '#39'ped_vnd_impre' +
          'ssao_dav'#39' and value1_vc is null;'
        'ALTER TABLE PRODUTOS_EC ADD URL_ACESSO VARCHAR(131);'
        'ALTER TABLE EQUIPAMENTO ADD ORIGEM_EQUIP_ID INTEGER;'
        
          'ALTER TABLE EQUIPAMENTO ADD CONSTRAINT FK_EQUIPAMENTO_REPLICA FO' +
          'REIGN KEY(ORIGEM_EQUIP_ID, COD_EMPRESA) REFERENCES EQUIPAMENTO (' +
          'COD_EQUIP, COD_EMPRESA) ON UPDATE CASCADE;'
        'ALTER TABLE KITS_PROD_EC ADD TITULO_PAGINA VARCHAR(131);'
        'ALTER TABLE KITS_PROD_EC ADD PALAVRAS_CHAVES VARCHAR(131);'
        'ALTER TABLE KITS_PROD_EC ADD URL_ACESSO VARCHAR(131);'
        'ALTER TABLE NFCE ADD GUID_NFCE_CONTING CHAR(36);'
        'ALTER TABLE NFCE ADD GUID_NFCE_ORIGINAL CHAR(36);'
        ''
        '|BLOCO|'
        'create or alter trigger NFCE_BI_ID for NFCE'
        'active before insert position 0'
        'as'
        'begin'
        '  if (coalesce(new.COD_NFCE, 0) = 0) then'
        
          '    new.COD_NFCE = (select COD from INCREMENTA_CODIGO(new.COD_EM' +
          'PRESA, '#39'NFCE'#39'));'
        '  if (coalesce(new.GUIDT, '#39#39') = '#39#39') then'
        '    new.GUIDT = (select GUID from SPDB_GUID);  '
        ''
        '  if ((coalesce(new.COD_NFCE_ORIGINAL, 0) = 0) and'
        '      (new.tpemis = '#39'9'#39') and'
        '      (trim(coalesce(new.GUID_NFCE_ORIGINAL, '#39#39')) <> '#39#39')) then'
        
          '    new.COD_NFCE_ORIGINAL = (select first 1 COD_NFCE from NFCE w' +
          'here GUIDT = new.GUID_NFCE_ORIGINAL and COD_EMPRESA = new.COD_EM' +
          'PRESA);'
        ''
        '  if ((coalesce(new.COD_NFCE_CONTING, 0) = 0) and'
        '      (new.status = '#39'A Cancelar'#39') and'
        '      (trim(coalesce(new.GUID_NFCE_CONTING, '#39#39')) <> '#39#39')) then'
        
          '    new.COD_NFCE_CONTING = (select first 1 COD_NFCE from NFCE wh' +
          'ere GUIDT = new.GUID_NFCE_CONTING and COD_EMPRESA = new.COD_EMPR' +
          'ESA);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER trigger nfce_item_calc_imp for nfce_item'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER trigger nfce_item_calc_imp for nfce_item'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW FOTOS_EMP('
        '    COD_EMPRESA,'
        '    FOTO,'
        '    USAR_LOGO)'
        'AS'
        
          'select fotos.cod_empresa, fotos.foto, empresa.usar_logo from fot' +
          'os'
        'inner join empresa on empresa.cod_empresa = fotos.cod_empresa'
        'where fotos.codigo = 0 '
        'and fotos.tipo = 3;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DADOS_PLANO('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    SEQPLANO,'
        '    TEXTO_PLANO,'
        '    DATA_VENC,'
        '    VALOR_DOC)'
        'AS'
        
          'select nrequisicao, tpdocs, cod_empresa, seqplano, texto_plano, ' +
          'data_venc, valordoc from plano_pag'
        'where valordoc > 0;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DADOS_FORMAPAG('
        '    NREQUISICAO,'
        '    NDOC,'
        '    TPDOCS,'
        '    COD_EMPRESA,'
        '    VALORDOC,'
        '    DATA_VENC)'
        'AS'
        
          'select fp.nrequisicao, fp.ndoc, fp.tpdocs, fp.cod_empresa, fp.va' +
          'lordoc, fp.data_venc from formpagamento fp'
        'where fp.tipdoc <> '#39'N'#39
        'and fp.valordoc > 0'
        'and fp.ativo = 1'
        'union'
        
          'select fp.rec_numvend, fp.ndoc, fp.rec_tipvend, fp.cod_empresa, ' +
          'fp.valordoc, fp.data_venc from formpagamento fp'
        'where fp.tpdocs <> '#39'LCS'#39
        'and fp.tipdoc <> '#39'N'#39
        'and fp.valordoc > 0'
        'and fp.ativo = 1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DADOS_MIN_ENTREGA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    DEST_SEQID_ENTRG,'
        '    NOME_CLIENTE,'
        '    NOME_RECEB,'
        '    END_RECEB,'
        '    BAIRRO_RECEB,'
        '    CIDA_RECEB,'
        '    CEP_RECEB,'
        '    FONE_RECEB)'
        'AS'
        'select pedvenda.nped, pedvenda.tipo, pedvenda.cod_empresa,'
        'pedvenda.dest_seqid_entrg,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '        vw_clientes_dest.nome_cliente'
        '     else'
        '        clientes.nome_cliente'
        'end nome_cliente,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '        vw_clientes_dest.nome_cliente'
        '     else'
        '        pedvenda.nome_receb'
        'end nome_receb,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '        trim(coalesce(vw_clientes_dest.logradouro, '#39#39')) ||'
        
          '        case when (trim(coalesce(vw_clientes_dest.numero, '#39#39')) <' +
          '> '#39#39') then '#39', '#39' || trim(coalesce(vw_clientes_dest.numero, '#39#39')) e' +
          'lse '#39#39' end ||'
        
          '        case when (trim(coalesce(vw_clientes_dest.complemento, '#39 +
          #39')) <> '#39#39') then '#39', '#39' || trim(coalesce(vw_clientes_dest.complemen' +
          'to, '#39#39')) else '#39#39' end'
        '     else'
        '        pedvenda.end_receb'
        'end end_receb,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '        vw_clientes_dest.bairro'
        '     else'
        '        pedvenda.bairro_receb'
        'end bairro_receb,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '         vw_clientes_dest.cidade'
        '     else'
        '        pedvenda.cida_receb'
        'end cida_receb,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '    vw_clientes_dest.cep'
        'else'
        '    pedvenda.cep_receb'
        'end cep_receb,'
        'case when (pedvenda.dest_seqid_entrg is not null) then'
        '    vw_clientes_dest.telefone'
        'else'
        '    pedvenda.fone_receb'
        'end fone_receb'
        ' from pedvenda'
        
          'inner join clientes on clientes.cod_cliente = pedvenda.cod_clien' +
          'te'
        '    and clientes.cod_empresa = pedvenda.cod_empresa'
        
          'left join vw_clientes_dest on vw_clientes_dest.cod_cliente = ped' +
          'venda.cod_cliente'
        '    and vw_clientes_dest.cod_empresa = pedvenda.cod_empresa'
        '    and vw_clientes_dest.dest_seqid = pedvenda.dest_seqid_entrg;'
        '|/BLOCO|'#9
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    NUM_FAB_PROD,'
        '    CODIGO_KIT,'
        '    DESCRICA0_KIT,'
        '    VALOR_UN_KIT,'
        '    VALOR_KIT,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, pvp.num_fab_prod,'
        
          'pvp.codigo_kit, case when (pvp.codigo_kit > 0) then k.descricao_' +
          'kit else pvp.descr_prod_ped end descricao_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_kit,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_acresc, 0)) from pedve' +
          'nda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_acresc_k' +
          'it,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_desc, 0)) from pedvend' +
          'a_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_desc_kit' +
          ','
        
          'pvp.unidade, pvp.descr_prod_ped, pvp.cod_grade, pvp.quant_ped_it' +
          'em,'
        
          'pvp.vlun_ped_item,pvp.vltot_ped_item, coalesce(pvp.rateio_desc,0' +
          ') as rateio_desc, coalesce(pvp.rateio_acresc,0) as rateio_acresc' +
          ', p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join pedvenda pv on pv.nped = pvp.nped and pv.tipo = pvp.t' +
          'ipo and pv.cod_empresa = pvp.cod_empresa'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join kits_prod k on k.codigo_kit = pvp.codigo_kit and k.cod' +
          '_empresa = pvp.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||pvs.cod_servico, null, null, pvs.cod_servico, nu' +
          'll,'
        'null, null, null, null, null, null,'
        'null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        
          'pvs.valor_un_serv, pvs.valor_tot_serv, coalesce(pvs.rateio_desc,' +
          '0) as rateio_desc, coalesce(pvs.rateio_acresc,0) as rateio_acres' +
          'c, null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'inner join pedvenda pv on pv.nped = pvs.nped and pv.tipo = pvs.t' +
          'ipo and pv.cod_empresa = pvs.cod_empresa'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', null,'
        'vpt.nped, '#39'PROD-T'#39', null, null, null, null,'
        'null, null, null, null, null, null,'
        'vpt.unidade, vpt.descricao, null, vpt.qtde,'
        
          'vpt.vl_unit, vpt.vl_total, 0, 0, null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39',null,'
        'vst.nped, '#39'SERV-T'#39', null, null, null, null,'
        'null, null, null, null, null, null,'
        'null, vst.descr_servt, null, 1,'
        
          'vst.vl_servt, vst.vl_servt, 0, 0,null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_ATIVIDADES_REPARP('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    SELOS_COL,'
        '    SELOS_REM,'
        '    LACRES_COL,'
        '    LACRES_REM)'
        'AS'
        'select nped, tipo, cod_empresa,'
        'cast(selos_col as varchar(200)) selos_col,'
        'cast(selos_rem as varchar(200)) selos_rem,'
        'cast(lacres_col as varchar(200)) lacres_col,'
        'cast(lacres_rem as varchar(200)) lacres_rem from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_FOTOS_PROD('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_GRADE)'
        'AS'
        'select first 1 codigo as nped,'
        'case when (tipo = -1000) then '#39'REQ'#39
        '     when (tipo = -1001) then '#39'OS'#39
        '     else '#39'ORC'#39
        'end tipo,'
        'cod_empresa,'
        'grupo_prod,'
        'cod_prod,'
        'cod_grade from fotos'
        
          'where tipo = iif(trim(tipo) = '#39'REQ'#39', -1000, iif(trim(tipo) = '#39'OS' +
          #39', -1001, -1002));'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DADOS_VEICULO('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    CHASSI,'
        '    PLACA,'
        '    CODIGO,'
        '    MODELO,'
        '    MARCA,'
        '    COR,'
        '    ANOFAB,'
        '    ANOMOD,'
        '    RENAVAM,'
        '    KM_V)'
        'AS'
        'select pv.nped, pv.tipo, pv.cod_empresa,'
        'ret.ichassi, ret.iplaca, ret.icodigo,'
        
          'case when (v.modelo > 0) then t.descricao else v.descmodelo end ' +
          'descmodelo,'
        
          'case when (v.cod_marca > 0) then m.descricao_marca else v.marca_' +
          'v end marca_v,'
        
          'case when (v.cod_cor > 0) then c.descricao_cor else v.cor end co' +
          'r,'
        'v.anofab, v.anomod, v.renavam, v.km_v'
        'from pedvenda pv'
        
          'left join retorna_veiculo (pv.chassi, pv.placa, pv.cod_veiculo, ' +
          'pv.cod_empresa) ret on 1 = 1'
        
          'left join veiculos v on v.placa = ret.iplaca and v.chassi = ret.' +
          'ichassi and v.codigo = ret.icodigo and v.cod_empresa = ret.icod_' +
          'empresa'
        
          'left join tipmodelo t on t.codigo = v.modelo and t.cod_empresa =' +
          ' v.cod_empresa'
        'left join marca_prod m on m.cod_marca = v.cod_marca'
        'left join codigo_corfab c on c.cod_cor = v.cod_cor;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    NUM_FAB_PROD,'
        '    ID_KIT,'
        '    CODIGO_KIT,'
        '    DESCRICA0_KIT,'
        '    VALOR_UN_KIT,'
        '    VALOR_KIT,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, pvp.num_fab_prod,'
        
          'pvp.id_kit, pvp.codigo_kit, case when (pvp.codigo_kit > 0) then ' +
          'k.descricao_kit else pvp.descr_prod_ped end descricao_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_kit,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_acresc, 0)) from pedve' +
          'nda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_acresc_k' +
          'it,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_desc, 0)) from pedvend' +
          'a_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_desc_kit' +
          ','
        
          'pvp.unidade, pvp.descr_prod_ped, pvp.cod_grade, pvp.quant_ped_it' +
          'em,'
        
          'pvp.vlun_ped_item,pvp.vltot_ped_item, coalesce(pvp.rateio_desc,0' +
          ') as rateio_desc, coalesce(pvp.rateio_acresc,0) as rateio_acresc' +
          ', p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join pedvenda pv on pv.nped = pvp.nped and pv.tipo = pvp.t' +
          'ipo and pv.cod_empresa = pvp.cod_empresa'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join kits_prod k on k.codigo_kit = pvp.codigo_kit and k.cod' +
          '_empresa = pvp.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||pvs.cod_servico, null, null, pvs.cod_servico, nu' +
          'll,'
        'null, null, null, null, null, null, null,'
        'null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        
          'pvs.valor_un_serv, pvs.valor_tot_serv, coalesce(pvs.rateio_desc,' +
          '0) as rateio_desc, coalesce(pvs.rateio_acresc,0) as rateio_acres' +
          'c, null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'inner join pedvenda pv on pv.nped = pvs.nped and pv.tipo = pvs.t' +
          'ipo and pv.cod_empresa = pvs.cod_empresa'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', null,'
        'vpt.nped, '#39'PROD-T'#39', null, null, null, null,'
        'null, null, null, null, null, null, null,'
        'vpt.unidade, vpt.descricao, null, vpt.qtde,'
        
          'vpt.vl_unit, vpt.vl_total, 0, 0, null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39',null,'
        'vst.nped, '#39'SERV-T'#39', null, null, null, null,'
        'null, null, null, null, null, null, null,'
        'null, vst.descr_servt, null, 1,'
        
          'vst.vl_servt, vst.vl_servt, 0, 0,null, '#39#39', null, null, null, nul' +
          'l, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        '  for select distinct pp.id_kit from pedvenda_prod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        '  select count(*) from pedvenda_prod pp'
        '    where pp.nped = :nped'
        '    and pp.tipo = :tipo'
        '    and pp.cod_empresa = :cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39
        '    and coalesce(pp.codigo_kit, 0) <= 0 into :qtde_prod;'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  (select count(*) from pedvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39') quant_ped_item,'
        ''
        '  (select count(*) from pedvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39') quant_serv_ped,'
        ''
        
          '  (select qtde from retorna_qtde_kit(pedvenda.nped, pedvenda.tip' +
          'o, pedvenda.cod_empresa)) quant_kit,'
        ''
        '  (coalesce(pedvenda.acrescimo, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.acresc_item, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.acresc_item, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        '  (coalesce(pedvenda.desconto, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.desc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.desc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.desc_item, 0)) from pedvend' +
          'a_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.desc_item, 0)) from pedvend' +
          'a_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        '  ('
        
          '    coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '    coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PEDVENDA_PROD ADD DESCRICAO_KIT_ID_KIT VARCHAR(80);'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_PROMOCAO_PRODUTO_EC FOR PROMOCAO_PROD' +
          'UTO'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS '
        '   DECLARE VARIABLE GRUPO_PROD INTEGER; '
        '   DECLARE VARIABLE COD_PROD CHAR(6); '
        '   DECLARE VARIABLE VCOD_EMPRESA INTEGER;'
        '   DECLARE VARIABLE COD_PROMOCAO INTEGER;'
        '   DECLARE VARIABLE ECOMMERCE INTEGER; '
        '   DECLARE VARIABLE VATUALIZAR INTEGER;'
        ' BEGIN'
        '   /* TRIGGER TEXT */ '
        '   IF(SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN '
        '    EXIT; '
        ''
        '   if (DELETING) then'
        '   begin '
        '     if (COALESCE(OLD.COD_PROMOCAO, 0) <= 0) then '
        '         exit; '
        '     GRUPO_PROD = OLD.GRUPO_PROD; '
        '     COD_PROD = OLD.COD_PROD; '
        '     VCOD_EMPRESA = OLD.COD_EMPRESA;'
        '     COD_PROMOCAO = OLD.COD_PROMOCAO;'
        '   end '
        '   else '
        '   begin '
        '     if (COALESCE(NEW.COD_PROMOCAO, 0) <= 0) then '
        '         exit; '
        '     GRUPO_PROD = NEW.GRUPO_PROD; '
        '     COD_PROD = NEW.COD_PROD; '
        '     VCOD_EMPRESA = NEW.COD_EMPRESA;'
        '     COD_PROMOCAO = NEW.COD_PROMOCAO;'
        '   end '
        ''
        '  SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        '  WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '  AND CONFIG_SISTEMA.COD_EMPRESA = :VCOD_EMPRESA INTO: ECOMMERCE' +
          ';'
        ''
        '  IF(COALESCE(ECOMMERCE, 0) <= 0) THEN'
        '    exit;'
        ''
        '   SELECT CONFIG_API.COD_TAB_PRECO FROM CONFIG_API'
        '      WHERE CONFIG_API.COD_EMPRESA = :VCOD_EMPRESA'
        '      AND CONFIG_API.API IN ('#39'TRAYCOMMERCE'#39', '#39'NUVEMSHOP'#39')'
        '      and CONFIG_API.COD_TAB_PRECO = :COD_PROMOCAO'
        '      INTO: VATUALIZAR;'
        ''
        '   if (COALESCE(VATUALIZAR, 0) <= 0) then'
        
          '     SELECT PROMOCAO_ORDEM_EC.COD_PROMOCAO FROM PROMOCAO_ORDEM_E' +
          'C'
        
          '        WHERE PROMOCAO_ORDEM_EC.COD_PROMOCAO = :COD_PROMOCAO AND' +
          ' PROMOCAO_ORDEM_EC.COD_EMPRESA = :VCOD_EMPRESA'
        '        INTO: VATUALIZAR;'
        ''
        
          '   if (COALESCE(VATUALIZAR, 0) <> COALESCE(COD_PROMOCAO, 0)) the' +
          'n'
        '     exit;'
        ''
        '   update produtos_ec set produtos_ec.grupo_prod = :grupo_prod,'
        '    produtos_ec.cod_prod = :cod_prod,'
        '    produtos_ec.cod_empresa = :VCOD_EMPRESA'
        '  where produtos_ec.grupo_prod = :grupo_prod'
        '    and produtos_ec.cod_prod = :cod_prod'
        '    and produtos_ec.cod_empresa = :VCOD_EMPRESA;'
        'END;'
        '|/BLOCO|'
        ''
        
          'update config_sistema set display_ = '#39'Configura'#231#245'es sobre altera' +
          #231#227'o de pre'#231'o na entrada da nota fiscal juntamente com o processo' +
          ' NF0223'#39' where chave = '#39'nf_e_alteracao_preco'#39' and display_ <> '#39'C' +
          'onfigura'#231#245'es sobre altera'#231#227'o de pre'#231'o na entrada da nota fiscal ' +
          'juntamente com o processo NF0223'#39';'
        
