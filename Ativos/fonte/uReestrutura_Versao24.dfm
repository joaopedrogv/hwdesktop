      Lines.Strings = (
        'CREATE INDEX IDX_NFCE_EMISSOR ON NFCE (COD_EMISSOR,COD_EMPRESA);'
        
          'ALTER TABLE NFCE_DEST ADD CONSTRAINT FK_NFCE_DEST FOREIGN KEY (C' +
          'OD_NFCE, COD_EMPRESA) REFERENCES NFCE (COD_NFCE, COD_EMPRESA) ON' +
          ' DELETE CASCADE ON UPDATE CASCADE;'
        
          'ALTER TABLE NFCE_INFADIC ADD CONSTRAINT FK_NFCE_INFADIC FOREIGN ' +
          'KEY (COD_NFCE, COD_EMPRESA) REFERENCES NFCE (COD_NFCE, COD_EMPRE' +
          'SA) ON DELETE CASCADE ON UPDATE CASCADE;'
        'ALTER TABLE EMPDESVOLV ADD DADOS_OFFLINE CHAR(1);'
        'ALTER TABLE NFCE ADD GUIDT CHAR(36);'
        'ALTER TABLE NFCE_ITEM ADD GUIDT CHAR(36);'
        'ALTER TABLE NFCE_ITEM ADD GUID_NFCE CHAR(36);'
        'ALTER TABLE NFCE_DEST ADD GUIDT CHAR(36);'
        'ALTER TABLE NFCE_DEST ADD GUID_NFCE CHAR(36);'
        'ALTER TABLE NFCE_PAGAMENTO ADD GUIDT CHAR(36);'
        'ALTER TABLE NFCE_PAGAMENTO ADD GUID_NFCE CHAR(36);'
        'ALTER TABLE NFCE_PAGAMENTO ADD GUID_TR_CARTAO CHAR(36);'
        'ALTER TABLE NFCE_INFADIC ADD GUIDT CHAR(36);'
        'ALTER TABLE NFCE_INFADIC ADD GUID_NFCE CHAR(36);'
        'ALTER TABLE PRODUTOS ADD GUIDT CHAR(36);'
        'ALTER TABLE COD_BARRA ADD GUIDT CHAR(36);'
        'ALTER TABLE COD_GRADE_PROD ADD GUIDT CHAR(36);'
        'ALTER TABLE TRANSACAO_CARTAO ADD GUIDT CHAR(36);'
        'CREATE UNIQUE INDEX NFCE_GUID ON NFCE (GUIDT);'
        'CREATE UNIQUE INDEX NFCE_ITEM_GUID ON NFCE_ITEM (GUIDT);'
        'CREATE INDEX NFCE_ITEM_GUID_NFCE ON NFCE_ITEM (GUID_NFCE);'
        'CREATE UNIQUE INDEX NFCE_DEST_GUID ON NFCE_DEST (GUIDT);'
        'CREATE INDEX NFCE_DEST_GUID_NFCE ON NFCE_DEST (GUID_NFCE);'
        
          'CREATE UNIQUE INDEX NFCE_PAGAMENTO_GUID ON NFCE_PAGAMENTO (GUIDT' +
          ');'
        
          'CREATE INDEX NFCE_PAGAMENTO_GUID_NFCE ON NFCE_PAGAMENTO (GUID_NF' +
          'CE);'
        
          'CREATE INDEX NFCE_PAGAMENTO_GUID_TR_CARTAO ON NFCE_PAGAMENTO (GU' +
          'ID_TR_CARTAO);'
        'CREATE UNIQUE INDEX NFCE_INFADIC_GUID ON NFCE_INFADIC (GUIDT);'
        'CREATE INDEX NFCE_INFADIC_GUID_NFCE ON NFCE_INFADIC (GUID_NFCE);'
        'CREATE UNIQUE INDEX PRODUTOS_GUID ON PRODUTOS (GUIDT);'
        'CREATE UNIQUE INDEX COD_BARRA_GUID ON COD_BARRA (GUIDT);'
        
          'CREATE UNIQUE INDEX COD_GRADE_PROD_GUID ON COD_GRADE_PROD (GUIDT' +
          ');'
        
          'CREATE UNIQUE INDEX TRANSACAO_CARTAO_GUID ON TRANSACAO_CARTAO (G' +
