          'atureza = '#39'S'#39
        ''
        '    union'
        ''
        '    --RECIBO'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rec.cod_empresa end) cod_empresa,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rec' +
