        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_DTEC_VALOR_TIPO_GRADE_EC FOR VALOR_TI' +
          'PO_GRADE_EC'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS '
        '  DECLARE VARIABLE VSEQID BIGINT; '
        'begin '
        '  /* Trigger text */ '
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit; '
        ''
        '  if ((inserting)or(updating)) then '
        '  begin '
        
          '    NEW.SEQID_EC = (SELECT GEN_ID(SEQ_EC_VALOR_TIPO_GRADE_EC, 1)' +
          ' FROM RDB$DATABASE);'
        '  end '
        'end;'
        '|/BLOCO|'
