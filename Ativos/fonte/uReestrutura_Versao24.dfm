        '    LAYOUT400                    CHAR(1),'
        '    AUTOMATICA                   CHAR(1),'
        '    REGISTROWS                   CHAR(1),'
        '    CONSULTAWS                   CHAR(1),'
        '    VALIDADOR                    CHAR(1),'
        
          '    MENSAGEM                     BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
          ','
        '    ATIVO                        INTEGER,'
        '    MASCARA_CODIGOAGENCIA        VARCHAR(20),'
        '    MASCARA_NUMEROCONTACORRENTE  VARCHAR(20),'
        '    MASCARA_NUMEROCONVENIO       VARCHAR(20),'
