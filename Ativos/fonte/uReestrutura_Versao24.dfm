        '|BLOCO|'
        'create or alter procedure GETPROXIMONOSSONUMERO ('
        '    VCOD_EMPRESA integer,'
        '    VCOD_COBREBEM integer)'
        'returns ('
        '    NOSSONUMERO varchar(20))'
        'as'
        'declare variable VDIG integer;'
        'declare variable VPNUM varchar(20);'
        'declare variable VNOVONUM varchar(20);'
        'declare variable VINUM varchar(20);'
        'declare variable J bigint;'
        'declare variable VFNUM varchar(20);'
        'declare variable F bigint;'
        'declare variable I bigint;'
        'begin'
        
          '    select proximonossonumero, inicionossonumero, qtdedignossonu' +
          'mero,FIMNOSSONUMERO from cobrebem where cod_cobrebem = :vcod_cob' +
          'rebem and'
        
          '        cod_empresa = :vcod_empresa into :vpnum, :vinum, :vdig, ' +
          ':vfnum;'
        ''
        '    if (:vpnum is null) then'
        '        vpnum = :vinum;'
        ''
        '    vpnum = trim(:vpnum);'
        '    vfnum = trim(:vfnum);'
        '    vinum = trim(:vinum);'
        ''
        '    J = cast(:vpnum as bigint);'
        '    F = cast(:vfnum as bigint);'
        '    I = cast(:vinum as bigint);'
        ''
        '    if (J >= F) then'
        '    J = I;'
        '    else'
        '    J = J + 1;'
        ''
        '    select result from strzero(:J,:vdig) into :vnovonum;'
        
          '    update cobrebem set proximonossonumero = :vnovonum where cod' +
          '_cobrebem = :vcod_cobrebem and'
        '            cod_empresa = :vcod_empresa;'
        '    nossonumero = :vpnum;'
        '    suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE TITULOS_NAO_CONCILIADOS ('
        '    SEQID                         INTEGER NOT NULL,'
        '    COD_EMPRESA                   INTEGER NOT NULL,'
        '    CODIGOMOVIMENTO               VARCHAR(2) NOT NULL,'
        '    DESCRICAO_MOVIMENTO           VARCHAR(50), '
        '    TITULONOSSONUMERO             VARCHAR(20),'
        '    TITULONOSSONUMEROORIGINAL     VARCHAR(20),'
        '    TITULODATAVENCIMENTO          TIMESTAMP,'
        
          '    PAGAMENTOVALORPAGO            T_VL_TODOS /* T_VL_TODOS = DOU' +
          'BLE PRECISION DEFAULT 000000000.00 */,'
        
          '    PAGAMENTOVALORCREDITO         T_VL_TODOS /* T_VL_TODOS = DOU' +
          'BLE PRECISION DEFAULT 000000000.00 */,'
        
          '    PAGAMENTOVALORTAXACOBRANCA    T_VL_TODOS /* T_VL_TODOS = DOU' +
          'BLE PRECISION DEFAULT 000000000.00 */,'
        
          '    PAGAMENTOVALORACRESCIMOS      T_VL_TODOS /* T_VL_TODOS = DOU' +
          'BLE PRECISION DEFAULT 000000000.00 */,'
        '    PAGAMENTODATA                 TIMESTAMP,'
        '    PAGAMENTODATACREDITO          TIMESTAMP,'
        '    PAGAMENTOREALIZADO            CHAR(1),'
        
          '    PAGAMENTOVALOROUTROSCREDITOS  T_VL_TODOS /* T_VL_TODOS = DOU' +
          'BLE PRECISION DEFAULT 000000000.00 */,'
        '    TITULONUMERODOCUMENTO         VARCHAR(10),'
        '    TITULOIDENTIFICACAOEMPRESA    VARCHAR(20),'
        
          '    OCORRENCIABANCARIA            BLOB SUB_TYPE 1 SEGMENT SIZE 1' +
          '024,'
        '    COD_COBREBEM                  INTEGER,'
        '    API_PROTOCOLO                 VARCHAR(16)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE TITULOS_NAO_CONCILIADOS ADD CONSTRAINT PK_TITULOS_NA' +
          'O_CONCILIADOS PRIMARY KEY (SEQID, COD_EMPRESA);'
        
          'CREATE INDEX IDX_TITULOS_NAO_CONCILIADOS ON TITULOS_NAO_CONCILIA' +
          'DOS (COD_COBREBEM, API_PROTOCOLO, COD_EMPRESA);'
        ''
        '|BLOCO|'
        'CREATE TABLE BANCOS_HOMOLOGADOS ('
        '    SEQID                        BIGINT NOT NULL,'
        '    CODBANCO                     CHAR(3),'
