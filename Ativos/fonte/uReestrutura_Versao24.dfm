        'create or alter procedure RETIRAR_ZERO_ESQUERDA ('
        '    VALOR varchar(50))'
        'returns ('
        '    RESULT varchar(50))'
        'as'
        'declare variable I integer;'
        'declare variable ZERO_ESQ char(1);'
        'declare variable VVAL varchar(50);'
        'BEGIN'
        '  i = 0;'
        '  ZERO_ESQ = '#39'N'#39';'
        '  RESULT = '#39#39';'
        '  vval= trim(valor);'
        ''
        '  while (i < char_length(:vval)) do'
        '  begin'
        
          '    if ((SUBSTRING(:vval FROM i + 1 FOR 1) = '#39'0'#39') and (TRIM(RESU' +
          'LT) = '#39#39')) then'
        '        RESULT = RESULT;'
        '    else'
        '        RESULT = RESULT || SUBSTRING(:vval FROM i + 1 FOR 1);'
        '    i = i + 1;'
        '  end'
        ''
        '  SUSPEND;'
        'END'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRODUCAO_ITEM ADD NPED INTEGER;'
        'ALTER TABLE PRODUCAO_ITEM ADD TIPO CHAR(3);'
