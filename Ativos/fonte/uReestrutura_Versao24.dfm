        '|BLOCO|'
        'create or alter trigger NFCE_BIU_CONT_ALT for NFCE'
        'active before insert or update position 0'
        'as'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (inserting) then'
        '    new.CONT_ALT = 0;'
        '  else'
        '  if (updating) then'
        '    if ((coalesce(new.CONT_ALT, 0)) >= 9999) then'
        '      new.CONT_ALT = 1;'
        '    else'
        '      new.CONT_ALT = coalesce(new.CONT_ALT, 0) + 1;'
        '  if (updating) then'
        '    if ((coalesce(new.CONT_MSG, 0)) >= 9999) then'
        '      new.CONT_MSG = 1;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_CHECK_PRIVILEGES ('
        '    USERNAME varchar(31),'
        '    OBJECT_NAME varchar(31))'
        'as'
        '  declare variable OBTYPE smallint;'
        '  declare variable OBNAME varchar(31);'
        '  declare variable DEPNAME varchar(31);'
        '  declare variable COUNTPRIV integer;'
        '  declare variable COUNTTEST integer;'
        '  declare variable COUNTINSERT integer;'
        '  declare variable MAXINSERT integer;'
        'begin'
        '  OBJECT_NAME = upper(trim(OBJECT_NAME));'
        '  for select OBTYPE, NAME'
        
          '      from (select 0 OBTYPE, R.RDB$RELATION_NAME NAME, null RELA' +
          'TION'
        '            from RDB$RELATIONS R'
        
          '            where ((R.RDB$SYSTEM_FLAG = 0) or (R.RDB$SYSTEM_FLAG' +
          ' is null)) and'
        '                  (R.RDB$VIEW_SOURCE is null) and'
        '                  (R.RDB$RELATION_NAME = :OBJECT_NAME)'
        '            union'
        
          '            select 1 OBTYPE, R.RDB$RELATION_NAME NAME, null RELA' +
          'TION'
        '            from RDB$RELATIONS R'
        
          '            where ((R.RDB$SYSTEM_FLAG = 0) or (R.RDB$SYSTEM_FLAG' +
          ' is null)) and'
        '                  (R.RDB$VIEW_SOURCE is not null) and'
        '                  (R.RDB$RELATION_NAME = :OBJECT_NAME)'
        '            union'
        
          '            select 2 OBTYPE, SP.RDB$PROCEDURE_NAME NAME, null RE' +
          'LATION'
        '            from RDB$PROCEDURES SP'
        '            where (SP.RDB$PROCEDURE_NAME = :OBJECT_NAME))'
        '        into :OBTYPE, :OBNAME'
        '  do'
        '  begin'
        '    if (OBTYPE = 2) then'
        '      COUNTTEST = 1;'
        '    else'
        '      COUNTTEST = 5;'
        '    select count(RP.RDB$PRIVILEGE)'
        '    from RDB$USER_PRIVILEGES RP'
        '    where RP.RDB$USER = :USERNAME and'
        '          trim(RP.RDB$RELATION_NAME) = :OBNAME'
        '      into :COUNTPRIV;'
        ''
        '    if (COUNTTEST > coalesce(COUNTPRIV, 0)) then'
        '      if (OBTYPE = 2) then'
        
          '        execute statement '#39'GRANT EXECUTE ON PROCEDURE '#39' || OBNAM' +
          'E || '#39' TO '#39' || USERNAME;'
        '      else'
        
          '        execute statement '#39'GRANT ALL ON '#39' || OBNAME || '#39' TO '#39' ||' +
          ' USERNAME;'
        ''
        '    select count(TABELA), max(ORDEM)'
        '    from RI_DEP'
        '    where TABELA = :OBNAME'
        '      into :COUNTINSERT, :MAXINSERT;'
        ''
        '    if (coalesce(COUNTINSERT, 0) = 0) then'
        '    begin'
        '      insert into RI_DEP (ORDEM, TABELA)'
        '      values (coalesce(:MAXINSERT, 0) + 1, :OBNAME);'
        ''
        '      for select distinct DP.RDB$DEPENDED_ON_NAME'
        '          from RDB$TRIGGERS T'
        
          '            inner join RDB$DEPENDENCIES DP on DP.RDB$DEPENDENT_N' +
          'AME = T.RDB$TRIGGER_NAME and'
        
          '                  not DP.RDB$DEPENDED_ON_NAME starts with '#39'RDB$'#39 +
          ' and'
        '                  DP.RDB$FIELD_NAME is null and'
        '                  DP.RDB$DEPENDED_ON_TYPE in (0, 1, 5)'
        '          where T.RDB$SYSTEM_FLAG = 0 and'
        '                (T.RDB$RELATION_NAME = :OBNAME)'
        '          union'
        '          distinct select distinct DP.RDB$DEPENDED_ON_NAME'
        '                   from RDB$DEPENDENCIES DP'
        '                   where DP.RDB$DEPENDENT_NAME = :OBNAME and'
        '                         DP.RDB$FIELD_NAME is null and'
        '                         DP.RDB$DEPENDED_ON_TYPE in (0, 1, 5)'
        '                     into :DEPNAME'
        '      do'
        
          '        execute procedure SPDB_CHECK_PRIVILEGES(:USERNAME, :DEPN' +
          'AME);'
        ''
        '    end'
        '  end'
        ''
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE MIG_EMP ('
        '    IDORIGEM   INTEGER NOT NULL,'
        '    IDDESTINO  INTEGER NOT NULL,'
        '    TABELA     VARCHAR(31) NOT NULL,'
        '    CAMPO_E    VARCHAR(31),'
        '    ACAO       CHAR(1) NOT NULL,'
        '    CONCLUIDO  SMALLINT DEFAULT 0 NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'CREATE UNIQUE INDEX IDX_MIG_EMP ON MIG_EMP (IDORIGEM, IDDESTINO,' +
          ' TABELA);'
        ''
        '|BLOCO|'
        'CREATE TABLE MIG_EMP_TRIG ('
        '    TRIGGERN  VARCHAR(31) NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        'CREATE UNIQUE INDEX IDX_MIG_EMP_TRIG ON MIG_EMP_TRIG (TRIGGERN);'
        ''
        '|BLOCO|'
        'create or alter procedure SP_MIGEMP_INACTIVE_TRIGGER ('
        '    IDORIG integer,'
        '    IDDEST integer,'
        '    ATIVAR smallint)'
        'returns ('
        '    TABELA varchar(31),'
        '    TGNAME varchar(31))'
        'as'
        'begin'
        '  if (ATIVAR <> 1) then'
        '  begin'
        '    for select NE.TABELA'
        '        from MIG_EMP NE'
        '        where NE.IDORIGEM = :IDORIG and'
        '              NE.IDDESTINO = :IDDEST'
        '          into :TABELA'
        '    do'
        '    begin'
        '      for select TG.RDB$TRIGGER_NAME'
        '          from RDB$TRIGGERS TG'
        '          where TG.RDB$RELATION_NAME = :TABELA and'
        '                TG.RDB$SYSTEM_FLAG = 0 and'
        '                TG.RDB$VALID_BLR = 1 and'
        '                TG.RDB$TRIGGER_INACTIVE = 0'
        '            into :TGNAME'
        '      do'
        '      begin'
        '        insert into MIG_EMP_TRIG values (:TGNAME);'
        
          '        execute statement '#39'alter trigger '#39' || :TGNAME || '#39' inact' +
          'ive;'#39';'
        '        suspend;'
        '      end'
        '    end'
        '  end'
        '  else'
        '  begin'
        '    for select T.TRIGGERN'
        '        from MIG_EMP_TRIG T'
        '          into :TGNAME'
        '    do'
        '    begin'
        '      for select TG.RDB$RELATION_NAME'
        '          from RDB$TRIGGERS TG'
        '          where TG.RDB$TRIGGER_NAME = :TGNAME and'
        '                TG.RDB$SYSTEM_FLAG = 0'
        '            into :TABELA'
        '      do'
        '      begin'
        
          '        execute statement '#39'alter trigger '#39' || :TGNAME || '#39' activ' +
          'e;'#39';'
        '        suspend;'
        '      end'
        '    end'
        '    delete from MIG_EMP_TRIG;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_MIGEMP_MAKE_DEP_ALL ('
        '    IDORIG integer,'
        '    IDDEST integer)'
        'as'
        '  declare variable EXISTE smallint;'
        'begin'
        '  delete from RI_DEP;'
        ''
        '  select count(n.TABELA)'
        '  from MIG_EMP N'
        '  inner join RDB$RELATIONS R on R.RDB$FLAGS = 1 and'
        '    R.RDB$VIEW_SOURCE is null and'
        '    R.RDB$RELATION_NAME = N.TABELA'
        '  left join SPSO_MAKE_DEP(N.TABELA) SP on 1 = 1'
        '  where N.IDORIGEM = :IDORIG and'
        '        N.IDDESTINO = :IDDEST'
        '    into :existe;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_MIGEMP ('
        '    ACAO char(1),'
        '    IDORIG integer,'
        '    IDDEST integer,'
        '    ETAPA integer)'
        'returns ('
        '    TABELA varchar(31),'
        '    PASSO blob sub_type 1 segment size 80)'
        'as'
        '  declare variable CAMPO_E varchar(31);'
        '  declare variable FIELDNAME varchar(31);'
        '  declare variable FIELDKEY varchar(31);'
        '  declare variable FTYPE integer;'
        '  declare variable FSUBTYPE integer;'
        '  declare variable STMT blob sub_type 1 segment size 80;'
        '  declare variable SEQID integer;'
        'begin'
        '  execute procedure SP_MIGEMP_MAKE_DEP_ALL(IDORIG, IDDEST);'
        ''
        '  if ((ACAO = '#39'X'#39') or ((acao = '#39'U'#39') and (etapa = 2)))  then'
        '  begin  '
        '    for select TABELA, CAMPO_EMP from (      '
        '      select ER.TABELA, EK.CAMPO_EMP'
        '      from MIG_EMP ER'
        '        left join SPDB_EMP_KEY(ER.TABELA) EK on 1=1'
        '        inner join RI_DEP EE on EE.TABELA = ER.TABELA and'
        '          ER.ACAO = :ACAO and'
        '          ER.CONCLUIDO = iif(acao = '#39'X'#39', 0, -1)'
        '      where ER.IDORIGEM = :IDORIG and'
        '          ER.IDDESTINO = :IDDEST'
        '      order by EE.ORDEM desc'
        '      ) as C where coalesce(C.CAMPO_EMP,'#39#39') <> '#39#39
        '          into :TABELA, :CAMPO_E'
        '    do'
        '    begin'
        '      PASSO = '#39'INICIADO'#39';'
        '      suspend;'
        ''
        
          '      STMT = '#39'delete from '#39' || TABELA || '#39' where '#39' || CAMPO_E ||' +
          ' '#39' = '#39' || cast(IDORIG as varchar(20));'
        ''
        '      PASSO = stmt;'
        '      suspend;'
        ''
        '      execute statement STMT;'
        ''
        '      update MIG_EMP NE'
        '      set NE.CONCLUIDO = 1'
        '      where NE.TABELA = :TABELA and'
        '            NE.IDORIGEM = :IDORIG and'
        '            NE.IDDESTINO = :IDDEST;'
        ''
        '      delete from CODIGO'
        '      where TABELA = :TABELA and'
        '            COD_EMPRESA = :IDORIG;'
        ''
        '      PASSO = '#39'CONCLUIDO'#39';'
        '      suspend;'
        '    end'
        '  end'
        '  else'
        '  if ((ACAO = '#39'I'#39') or ((acao = '#39'U'#39') and (etapa = 1))) then'
        '  begin'
        '    for select ER.TABELA, EK.CAMPO_EMP'
        '        from MIG_EMP ER'
        '          left join SPDB_EMP_KEY(ER.TABELA) EK on 1=1'
        '          inner join RI_DEP EE on EE.TABELA = ER.TABELA and'
        '                ER.ACAO = :ACAO and'
        '                ER.CONCLUIDO = 0'
        '        where ER.IDORIGEM = :IDORIG and'
        '              ER.IDDESTINO = :IDDEST'
        '        order by EE.ORDEM'
        '          into :TABELA, :CAMPO_E'
        '    do'
        '    begin'
        '      PASSO = '#39'INICIADO'#39';'
        '      suspend;'
        ''
        '      STMT = '#39#39';'
        ''
        '      FIELDKEY = '#39#39';'
        
          '      for select RF.RDB$FIELD_NAME, F.RDB$FIELD_TYPE, F.RDB$FIEL' +
          'D_SUB_TYPE'
        '          from RDB$RELATION_FIELDS RF'
        
          '            join RDB$FIELDS F on (F.RDB$FIELD_NAME = RF.RDB$FIEL' +
          'D_SOURCE)'
        '          where (RF.RDB$RELATION_NAME = :TABELA) and'
        '                (coalesce(RF.RDB$SYSTEM_FLAG, 0) = 0) and'
        '                (RF.RDB$FIELD_NAME <> :CAMPO_E) and'
        '                (F.RDB$COMPUTED_SOURCE IS NULL)'
        '          order by RF.RDB$FIELD_POSITION'
        '            into :FIELDNAME, :FTYPE, FSUBTYPE'
        '      do'
        '      begin'
        '        FIELDNAME = trim(FIELDNAME);'
        '        if (STMT <> '#39#39') then'
        '          STMT = STMT || '#39','#39' || FIELDNAME;'
        '        else'
        '          STMT = FIELDNAME;'
        ''
        '        if ((FTYPE in (7, 8, 16)) and'
        '            (FSUBTYPE = 0) and'
        '            (FIELDKEY = '#39#39') and'
        '            (TABELA <> '#39'PRODUTOS'#39')) then'
        '        begin'
        
          '          -- talvez um retorno com a quantidade de campos q form' +
          'a a pk, tabela terminal_cartao por exemplo tem cmpo inteiro chav' +
          'e, porem outro campo faz parete e nao usa tabela codigo'
        '          select count(PK.FIELDNAME)'
        '          from SPDB_FIELDS_PK(:TABELA) PK'
        '          where PK.FIELDNAME = :FIELDNAME'
        '            into :SEQID;'
        ''
        '          if (coalesce(SEQID, 0) = 1) then'
        '          begin'
        '            select count(SG.RDB$FIELD_NAME) as FIELD_NAME'
        '            from RDB$INDICES IX'
        
          '              left join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NA' +
          'ME = SG.RDB$INDEX_NAME'
        
          '              left join RDB$RELATION_CONSTRAINTS RC on RC.RDB$IN' +
          'DEX_NAME = IX.RDB$INDEX_NAME'
        '            where RC.RDB$CONSTRAINT_TYPE = '#39'PRIMARY KEY'#39' and'
        '                  RC.RDB$RELATION_NAME = :TABELA and'
        '                  SG.RDB$FIELD_NAME <> :CAMPO_E'
        '              into :SEQID;'
        ''
        '            if (coalesce(SEQID, 0) = 1) then'
        '              FIELDKEY = FIELDNAME;'
        '          end'
        '        end'
        '      end'
        ''
        
          '      STMT = '#39'insert into '#39' || TABELA || '#39'('#39' || CAMPO_E || '#39','#39' |' +
          '| STMT || '#39') '#39' || '#39'select '#39' || cast(IDDEST as varchar(20)) || '#39',' +
          #39' || STMT || '#39' from '#39' || TABELA || '#39' where '#39' || CAMPO_E || '#39' = '#39 +
          ' || cast(IDORIG as varchar(20));'
        ''
        '      PASSO = stmt;'
        '      suspend;'
        ''
        '      execute statement STMT;'
        ''
        '      update MIG_EMP NE'
        '      set NE.CONCLUIDO = iif(acao = '#39'I'#39', 1, -1)'
        '      where NE.TABELA = :TABELA and'
        '            NE.IDORIGEM = :IDORIG and'
        '            NE.IDDESTINO = :IDDEST;'
        ''
        '      if (TABELA = '#39'PRODUTOS'#39') then'
        '      begin'
        '        insert into CODIGO (TABELA, COD_EMPRESA, VALOR, CODIGO)'
        '          select TABELA, :IDDEST, VALOR, 0 from CODIGO'
        '            where TABELA = :TABELA and'
        '                  COD_EMPRESA = :IDORIG;'
        '      end'
        '      else if (FIELDKEY <> '#39#39') then'
        '      begin'
        
          '        execute statement '#39'select max('#39' || FIELDKEY || '#39') from '#39 +
          ' || TABELA || '#39' where '#39' || CAMPO_E || '#39' = '#39' || cast(IDDEST as va' +
          'rchar(20))'
        '            into :SEQID;'
        '        if (coalesce(SEQID, 0) > 0) then'
        
          '          insert into CODIGO (TABELA, COD_EMPRESA, VALOR, CODIGO' +
          ')'
        '          values (:TABELA, :IDDEST, :SEQID, 0);'
        '      end'
        ''
        '      PASSO = '#39'CONCLUIDO'#39';'
        '      suspend;'
        '    end'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPRI_TABLES_NOTREP'
        'returns ('
        '    TABELA varchar(31),'
        '    ORIGEM smallint)'
        'as'
        'begin'
        '  for select TABELA, 1'
        '      from RI_TAB_NOTREP'
        '    union distinct'
        '    select T.TABELA, 0'
        '      from SPDB_TABLES T'
        '        inner join SPDB_EMP_KEY(T.TABELA) EK on 1 = 1'
        '      where EK.CAMPO_EMP <> '#39#39' and'
        '            T.TABELA in ( '#39'AGENDA'#39','
        '                          '#39'AGENDAMENTO'#39','
        '                          '#39'AGENDA_ITENS'#39','
        '                          '#39'ANOTACOES'#39','
        '                          '#39'APURACAO_BALANCO'#39','
        '                          '#39'APURACAO_DEPTO'#39','
        '                          '#39'ARQ_FABRICA'#39','
        '                          '#39'ATESTADO_ECF'#39','
        '                          '#39'AT_TERMINAIS'#39','
        '                          '#39'BAIXA_CREDITOS'#39','
        '                          '#39'BALANCO_PRODUTOS'#39','
        '                          '#39'BOLETAS'#39','
        '                          '#39'BOX'#39','
        '                          '#39'CADASTROS_EMP'#39','
        '                          '#39'CARGA'#39','
        '                          '#39'CARGA_ITEM'#39','
        '                          '#39'CARGA_ITEM_HISTORICO'#39','
        '                          '#39'CHASSI_A_PAGAR'#39','
        '                          '#39'CLIENTES_CONTATO'#39','
        '                          '#39'CLIENTES_END_DOC_ADD'#39','
        '                          '#39'CLIENTES_TRIB_AD'#39','
        '                          '#39'COBREBEM'#39','
        '                          '#39'CODIGO'#39','
        '                          '#39'CODIGO_FORNECEDOR'#39','
        '                          '#39'COD_GRADE_BALANCO'#39','
        '                          '#39'COD_GRADE_PROD_COMPRA'#39','
        '                          '#39'COD_GRADE_PROD_VENDA'#39','
        '                          '#39'COMISSAO_CONSORCIO'#39','
        '                          '#39'COM_FAT'#39','
        '                          '#39'CONFERENCIA_CEGA'#39','
        '                          '#39'CONFERENCIA_CEGA_ITENS'#39','
        '                          '#39'CONFIG_API'#39','
        '                          '#39'CONFIG_EMAILMARK'#39','
        '                          '#39'CONSULTA_CREDCL'#39','
        '                          '#39'CONTAS_A_PAGAR'#39','
        '                          '#39'CONTA_CORRENTE_PROG_FIDELIDADE'#39','
        '                          '#39'CONTROLE_ALMOXARIFADO'#39','
        '                          '#39'CONTROLE_CHEQUE'#39','
        '                          '#39'CONTROLE_CREDITOS'#39','
        '                          '#39'COTACAO'#39','
        '                          '#39'COTACAO_ITENS'#39','
        '                          '#39'COTACAO_P'#39','
        '                          '#39'CREDITOS_LANC'#39','
        '                          '#39'CUPOM'#39','
        '                          '#39'CUPOM2'#39','
        '                          '#39'CUPOM_EMIT'#39','
        '                          '#39'CUSTOS'#39','
        '                          '#39'DADOS_JSON'#39','
