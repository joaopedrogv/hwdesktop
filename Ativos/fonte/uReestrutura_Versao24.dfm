          'left join tipo_vendas tp on tp.tipo = pd.tipo and (tp.sigla = pd' +
          '.tipv or (tp.tipo_os = pd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
