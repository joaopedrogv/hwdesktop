          'DICE (NPED, TIPO, COD_EMPRESA);'
        'ALTER TABLE PRODUTOS ADD CRIAR_PRODUCAO_AUT CHAR(1) DEFAULT '#39'N'#39';'
        
          'UPDATE PRODUCAO SET GERACAO_AUT = '#39'N'#39' WHERE COD_EMPRESA = :COD_E' +
          'MPRESA AND GERACAO_AUT IS NULL;'
        ''
        '|BLOCO|'
        'create or alter procedure SPED_1601 ('
        '    EMPRESA integer,'
        '    DATAINI timestamp,'
        '    DATAFIM timestamp)'
        'returns ('
        '    COD_PART_IP integer,'
        '    COD_PART_IT integer,'
        '    TOT_VS double precision,'
        '    TOT_ISS double precision,'
        '    TOT_OUTROS double precision)'
        'as'
        '  declare variable CURRENT_COD_PART_IP integer;'
        '  declare variable CURRENT_COD_PART_IT integer;'
        '  declare variable NDOC integer;'
        '  declare variable TIPODOC varchar(6);'
        '  declare variable VALORDOC double precision;'
        '  declare variable VALOROPERACAO double precision;'
        '  declare variable VALORSERVICO double precision;'
        '  declare variable CONTADOR integer;'
        'begin'
        ''
        '  COD_PART_IP = NULL;'
        '  COD_PART_IT = NULL;'
        '  TOT_VS = 0;'
        '  TOT_ISS = 0;'
        '  TOT_OUTROS = 0;'
        '  VALOROPERACAO = 0;'
        '  contador = 0;'
        
          '  for select coalesce(cl.cartao_sped_part, 0), coalesce(cl.carta' +
          'o_sped_part_it, 0),'
        
          '             coalesce(fp.nrequisicao, 0), trim(fp.tpdocs), sum(f' +
          'p.valordoc) valoroperacao'
        '      from formpagamento fp'
        
          '        inner join controles cl on cl.codigo_ctrl = fp.cod_contr' +
          'ole and cl.codigo_emp = fp.cod_empresa'
        
          '      where ((cl.cartao_sped = 1) or (cl.cartao_sped = 2)) and f' +
          'p.cod_empresa = :empresa and'
        '        fp.data_mov >= :dataIni and fp.data_mov <= :dataFim'
        '      group by 1, 2, 3, 4'
        
          '      into :CURRENT_COD_PART_IP, :CURRENT_COD_PART_IT, :NDOC, :T' +
          'IPODOC, :VALOROPERACAO'
        '  do'
        '  begin'
        '    contador = contador + 1;'
        '    if (contador = 42) then'
        '      contador = 0;'
        ''
        '    if ((COD_PART_IP <> coalesce(CURRENT_COD_PART_IP, 0)) or'
        '        (COD_PART_IT <> coalesce(CURRENT_COD_PART_IT, 0))) then'
        '    begin'
        '      suspend;'
        '      TOT_VS = 0;'
        '      TOT_ISS = 0;'
        '      TOT_OUTROS = 0;'
        '    end                 '
        '      COD_PART_IP = CURRENT_COD_PART_IP;'
        '      COD_PART_IT = CURRENT_COD_PART_IT;'
        ''
        '    if (tipodoc = '#39'OS'#39') then'
        '    begin'
        '      select (coalesce(pv.tot_prod, 0) +'
        '              coalesce(pv.tot_serv, 0) +'
        '              coalesce(pv.tot_prod_terc, 0) +'
        '              coalesce(pv.tot_serv_terc, 0)) total,'
        
          '             (coalesce(pv.tot_serv, 0) + coalesce(pv.tot_serv_te' +
          'rc, 0)) totalservico'
        
          '      from pedvenda pv where pv.nped = :ndoc and pv.tipo = :tipo' +
          'doc and pv.cod_empresa = :empresa'
        '      into :VALORDOC, :VALORSERVICO;'
        ''
        '      if (coalesce(VALORSERVICO, 0) > 0) then'
        '      begin'
        '        VALORSERVICO = VALORSERVICO / VALORDOC;'
        '        VALORSERVICO = round( VALOROPERACAO * VALORSERVICO, 2);'
        ''
        '        TOT_ISS = TOT_ISS + VALORSERVICO;'
        '        TOT_VS = TOT_VS + (VALOROPERACAO - VALORSERVICO);'
        '      end'
        '      else'
        '        TOT_VS = TOT_VS + VALOROPERACAO;'
        ''
        '    end'
        '    else'
        '    begin'
        '      TOT_VS = TOT_VS + VALOROPERACAO;'
        '    end'
        ''
        '  end'
        '  if (VALOROPERACAO > 0) then'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NFC044'#39', :COD_EMPRESA, '#39'CANCELAR NFCE ESPELHO AUTORIZ' +
          'ADA EM LOTE'#39', 100, '#39'S'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'create or alter procedure SPSO_MAKE_DEP_RECURSIVE ('
        '    TABELA varchar(31),'
        '    COMEMPRESA integer = 0)'
        'returns ('
        '    RESULT integer)'
        'as'
        '  declare variable TAB_REL varchar(31);'
        '  declare variable MAXID integer;'
        '  declare variable EXISTE integer;'
        'begin'
        ''
        '  for select distinct RF.RDB$RELATION_NAME TAB_REF'
        '      from RDB$INDICES IX'
        
          '        left join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NAME = S' +
          'G.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RC on RC.RDB$INDEX_NA' +
          'ME = IX.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RF on RF.RDB$INDEX_NA' +
          'ME = IX.RDB$FOREIGN_KEY'
        '      where RC.RDB$CONSTRAINT_TYPE = '#39'FOREIGN KEY'#39' and'
        '            RC.RDB$RELATION_NAME = :TABELA and'
        '            RF.RDB$RELATION_NAME <> :TABELA'
        '        into :TAB_REL'
        '  do'
        '  begin'
        ''
        '    TAB_REL = trim(coalesce(TAB_REL, '#39#39'));'
        ''
        '    EXISTE = 0;'
        '    select count(T.TABELA)'
        '    from RI_DEP T'
        '    where T.TABELA = :TAB_REL'
        '      into :EXISTE;'
        ''
        '    if (coalesce(EXISTE, 0) = 0) then'
        '    begin'
        
          '      select result from SPSO_MAKE_DEP_RECURSIVE(:TAB_REL, :COME' +
          'MPRESA) into :existe;'
        ''
        '      select max(T.ORDEM)'
        '      from RI_DEP T'
        '        into :MAXID;'
        '      MAXID = coalesce(MAXID, 0) + 1;'
        ''
        '      EXISTE = 0;'
        '      if (COMEMPRESA = 0) then'
        '        select count(T.TABELA)'
        '        from SPDB_TABLES T'
        '          left join SPDB_EMP_KEY(T.TABELA) P on 1 = 1'
        '        where T.TABELA = :TAB_REL and'
        '              P.CAMPO_EMP <> '#39#39
        '          into :EXISTE;'
        ''
        '      if ((coalesce(EXISTE, 0) > 0) or (COMEMPRESA = 0)) then'
        '        insert into RI_DEP (ORDEM, TABELA)'
        '        values (:MAXID, :TAB_REL);'
        '    end'
        '  end     '
        ''
        '  result = 1;'
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_RI_MAKE_DEP ('
        '    TABELA varchar(31))'
        'as'
        '  declare variable TAB_REL varchar(31);'
        '  declare variable MAXID integer;'
        '  declare variable EXISTE integer;'
        'begin'
        ''
        '  for select DISTINCT RF.RDB$RELATION_NAME TAB_REF'
        '      from RDB$INDICES IX'
        
          '        left join RDB$INDEX_SEGMENTS SG on IX.RDB$INDEX_NAME = S' +
          'G.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RC on RC.RDB$INDEX_NA' +
          'ME = IX.RDB$INDEX_NAME'
        
          '        left join RDB$RELATION_CONSTRAINTS RF on RF.RDB$INDEX_NA' +
          'ME = IX.RDB$FOREIGN_KEY'
        '      where RC.RDB$CONSTRAINT_TYPE = '#39'FOREIGN KEY'#39' and'
        '            RC.RDB$RELATION_NAME = :TABELA and'
        '            RF.RDB$RELATION_NAME <> :TABELA'
        '        into :TAB_REL'
        '  do'
        '  begin'
        ''
        '    TAB_REL = trim(coalesce(TAB_REL, '#39#39'));'
        ''
        '    EXISTE = 0;'
        '    select count(T.TABELA)'
        '    from RI_DEP T'
        '    where T.TABELA = :TAB_REL'
        '      into :EXISTE;'
        ''
        '    if (coalesce(EXISTE, 0) = 0) then'
        '    begin'
        '      execute procedure SPDB_RI_MAKE_DEP(:TAB_REL);'
        ''
        '      select max(T.ORDEM)'
        '      from RI_DEP T'
        '        into :MAXID;'
        '      MAXID = coalesce(MAXID, 0) + 1;'
        ''
        '      EXISTE = 0;'
        '      select count(T.TABELA)'
        '      from SPDB_TABLES T'
        '        left join SPDB_EMP_KEY(T.TABELA) P on 1 = 1'
        '      where T.TABELA = :TAB_REL and'
        '            P.CAMPO_EMP <> '#39#39
        '        into :EXISTE;'
        ''
        '      if (coalesce(EXISTE, 0) > 0) then'
        '        insert into RI_DEP (ORDEM, TABELA)'
        '        values (:MAXID, :TAB_REL);'
        '    end'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        
          'CREATE INDEX IDX_PEDVENDA_PROD_NPED_PROD ON PEDVENDA_PROD (NPED,' +
          ' TIPO, GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA);'
        ''
        '|BLOCO|'
        'CREATE GLOBAL TEMPORARY TABLE TEMP_PRODUCAO_AUT ('
        '    NPED                    INTEGER,'
        '    TIPO                    CHAR(3),'
        '    COD_EMPRESA             INTEGER,'
        '    GRUPO_PROD_ACABADO      INTEGER,'
        '    COD_PROD_ACABADO        CHAR(6),'
        '    COD_GRADE_ACABADO       INTEGER,'
        
          '    QUANT_PED_ITEM_ACABADO  T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    EST_F_ACABADO           T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    EST_F_ANT_ACABADO       T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    ESTOQUE_DISP_ACABADO    T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    CUSTO_INDICE_ACABADO    T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    CUSTO_RATEIO_ACABADO    T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PREC_CUS_PROD_ACABADO   T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PREC_CUSM_PROD_ACABADO  T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PESO_UN_ACABADO'#9'    T_N_GERAL /* T_N_GERAL = DOUBLE PRECISIO' +
          'N DEFAULT 000.00 */,'
        
          '    PESO_UTIL_ACABADO'#9'    T_N_GERAL /* T_N_GERAL = DOUBLE PRECIS' +
          'ION DEFAULT 000.00 */,'
        '    GRUPO_PROD_MPRIMA       INTEGER,'
        '    COD_PROD_MPRIMA         CHAR(6),'
        '    COD_GRADE_MPRIMA        INTEGER,'
        
          '    QUANT_MPRIMA            T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    EST_F_MPRIMA            T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    ESTOQUE_DISP_MPRIMA     T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    QTDE_PRODUCAO           T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PREC_CUSM_PROD_MPRIMA   T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PESO_UN_MPRIMA          T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */,'
        
          '    PESO_UTIL_MPRIMA        T_N_GERAL /* T_N_GERAL = DOUBLE PREC' +
          'ISION DEFAULT 000.00 */'
        ') ON COMMIT PRESERVE ROWS;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETPRODUTOSACABADOS_RECURSIVO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PQTDE double precision)'
        'returns ('
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6),'
        '    COD_GRADE integer,'
        '    QTDE double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  for select indice_tecnico.grupo_prod_mprima, indice_tecnico.co' +
          'd_prod_mprima,'
        
          '    coalesce((select first 1 produtos_pdc_var_it.cod_grade from ' +
          'produtos_pdc_var'
        '              inner join produtos_pdc_var_it on'
        
          '                 produtos_pdc_var_it.id_ind = produtos_pdc_var.i' +
          'd_ind'
        
          '                and produtos_pdc_var_it.cod_empresa = produtos_p' +
          'dc_var.cod_empresa'
        '              where produtos_pdc_var.grupo_prod = :pgrupo_prod'
        '              and produtos_pdc_var.cod_prod = :pcod_prod'
        '              and produtos_pdc_var.cod_grade = :pcod_grade'
        '              and produtos_pdc_var.cod_empresa = :pcod_empresa'
        
          '              and produtos_pdc_var_it.grupo_prod = indice_tecnic' +
          'o.grupo_prod_mprima'
        
          '              and produtos_pdc_var_it.cod_prod = indice_tecnico.' +
          'cod_prod_mprima'
        
          '              and produtos_pdc_var_it.cod_empresa = indice_tecni' +
          'co.cod_empresa), 0) cod_grade,'
        
          '    (coalesce(indice_tecnico.quant, 0) * coalesce(:pqtde, 0)) qu' +
          'ant from indice_tecnico'
        '  inner join produtos on'
        '    produtos.grupo_prod = indice_tecnico.grupo_prod_mprima'
        '    and produtos.cod_prod = indice_tecnico.cod_prod_mprima'
        '    and produtos.cod_empresa = indice_tecnico.cod_empresa'
        '  where indice_tecnico.grupo_prod_acabado = :pgrupo_prod'
        '  and indice_tecnico.cod_prod_acabado = :pcod_prod'
        '  and indice_tecnico.cod_empresa = :pcod_empresa'
        '  and produtos.criar_producao_aut = '#39'S'#39
        '    into :grupo_prod, :cod_prod, :cod_grade, :qtde do'
        '  begin'
        '    suspend;'
        ''
        
          '    for select grupo_prod, cod_prod, cod_grade, qtde from getpro' +
          'dutosacabados_recursivo ('
        '      :grupo_prod,'
        '      :cod_prod,'
        '      :cod_grade,'
        '      :pcod_empresa,'
        '      coalesce(:qtde, 0))'
        '      into :grupo_prod, :cod_prod, :cod_grade, :qtde do'
        '    begin'
        '      suspend;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETPRODUTOSACABADOS ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PQTDE double precision)'
        'returns ('
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6),'
        '    COD_GRADE integer,'
        '    QTDE double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  select produtos.grupo_prod, produtos.cod_prod, cod_grade_prod.' +
          'cod_grade from produtos'
        '  left join cod_grade_prod on'
        '    cod_grade_prod.grupo_prod = produtos.grupo_prod'
        '    and cod_grade_prod.cod_prod = produtos.cod_prod'
        '    and cod_grade_prod.cod_grade = :pcod_grade'
        '    and cod_grade_prod.cod_empresa = produtos.cod_empresa'
        '  where produtos.grupo_prod = :pgrupo_prod'
        '  and produtos.cod_prod = :pcod_prod'
        '  and produtos.cod_empresa = :pcod_empresa'
        '    into :grupo_prod, :cod_prod, :cod_grade;'
        ''
        '  grupo_prod = coalesce(grupo_prod, 0);'
        '  cod_prod = coalesce(cod_prod, '#39#39');'
        '  cod_grade = coalesce(cod_grade, 0);'
        '  qtde = coalesce(pqtde, 0);'
        ''
        '  suspend;'
        ''
        
          '  for select grupo_prod, cod_prod, cod_grade, qtde from getprodu' +
          'tosacabados_recursivo ('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_grade,'
        '    :pcod_empresa,'
        '    coalesce(:pqtde, 0))'
        '    into :grupo_prod, :cod_prod, :cod_grade, :qtde do'
        '  begin'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETESTOQUE_RECURSIVO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PCOD_GRADE integer)'
        'returns ('
        '    ESTOQUE double precision)'
        'as'
        'declare variable VSQL varchar(500);'
        'declare variable VEXISTE_GRADE integer;'
        'declare variable VCRIAR_PRODUCAO_AUT char(1);'
        'declare variable VUSAR_PRODUCAO_TIPO char(1);'
        'declare variable VGRUPO_PROD_MPRIMA integer;'
        'declare variable VCOD_PROD_MPRIMA char(6);'
        'declare variable VCOD_GRADE_MPRIMA integer;'
        'declare variable VQUANT_MPRIMA double precision;'
        'declare variable VESTOQUE double precision;'
        'declare variable VESTOQUE_P double precision;'
        'declare variable VESTOQUE_GERAL double precision;'
        'declare variable VID_IND_A integer;'
        'declare variable VTEMP double precision;'
        'declare variable VTEMP_SQL varchar(100);'
        'declare variable VOK integer;'
        'begin'
        '  /* Procedure Text */'
        '  vestoque_geral = 0;'
        '  vestoque_p = 0;'
        '  vok = 0;'
        '  estoque = 0;'
        ''
        
          '  select usar_producao_tipo from empresa where cod_empresa = :pc' +
          'od_empresa into :vusar_producao_tipo;'
        ''
        '  if (coalesce(vusar_producao_tipo, '#39'N'#39') <> '#39'S'#39') then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  select criar_producao_aut from produtos where grupo_prod = :pg' +
          'rupo_prod and cod_prod = :pcod_prod and cod_empresa = :pcod_empr' +
          'esa into :vcriar_producao_aut;'
        ''
        '  if (coalesce(vcriar_producao_aut, '#39'N'#39') <> '#39'S'#39') then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  select count(*) from cod_grade_prod where grupo_prod = :pgrupo' +
          '_prod and cod_prod = :pcod_prod and cod_empresa = :pcod_empresa ' +
          'and cod_grade > 0 into :vexiste_grade;'
        ''
        '  vtemp_sql = '#39#39';'
        '  if (coalesce(pcod_grade, 0) > 0) then'
        '    vtemp_sql = '#39' and pa.cod_grade = '#39' || :pcod_grade;'
        '  else if (coalesce(vexiste_grade, 0) > 0) then'
        '    vtemp_sql = '#39' and pa.cod_grade > 0 '#39';'
        ''
        '  vestoque_geral = 0;'
        '  vsql = '#39' select 0 from rdb$database '#39';'
        
          '  if ((coalesce(vexiste_grade, 0) > 0) or (coalesce(pcod_grade, ' +
          '0) > 0)) then'
        '    vsql = '#39' select '#39' ||'
        
          '           iif((coalesce(pcod_grade, 0) <= 0) and (coalesce(vexi' +
          'ste_grade, 0) > 0), '#39#39', '#39' first 1 '#39') ||'
        '           '#39' pa.id_ind from produtos_pdc_var pa'
        '             where pa.grupo_prod = '#39' || :pgrupo_prod || '#39
        '             and pa.cod_prod = '#39' || :pcod_prod || '#39
        '           '#39' || vtemp_sql || '#39
        '             and pa.cod_empresa = '#39' || :pcod_empresa;'
        ''
        '  for'
        '    execute statement'
        '      vsql into :vid_ind_a do'
        '  begin'
        '    vtemp = 0;'
        '    vok = 0;'
        '    vestoque_p = 0;'
        '    for'
        
          '      select ind.grupo_prod_mprima, ind.cod_prod_mprima, coalesc' +
          'e(ind.quant, 0) quant,'
        
          '      iif(coalesce(pm.cod_grade, 0) > 0, coalesce(pm.cod_grade, ' +
          '0), 0) cod_grade_mprima,'
        '      coalesce((select estoque from getestoquedisponivel('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        
          '        iif(coalesce(pm.cod_grade, 0) > 0, coalesce(pm.cod_grade' +
          ', 0), 0),'
        '        ind.cod_empresa,'
        '        0,'
        '        '#39#39','
        '        0,'
        '        0)), 0) estoque from indice_tecnico ind'
        '      left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '      inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '      where ind.grupo_prod_acabado = :pgrupo_prod'
        '      and ind.cod_prod_acabado = :pcod_prod'
        '      and ind.cod_empresa = :pcod_empresa'
        '      and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        
          '        into :vgrupo_prod_mprima, :vcod_prod_mprima, :vquant_mpr' +
          'ima, :vcod_grade_mprima, :vtemp do'
        '    begin'
        '      if (coalesce(vestoque_p, 0) = 0) then'
        
          '        vestoque = (coalesce(vtemp, 0) / coalesce(vquant_mprima,' +
          ' 0));'
        
          '      else if ((coalesce(vtemp, 0) / coalesce(vquant_mprima, 0))' +
          ' < coalesce(vestoque_p, 0)) then'
        
          '        vestoque = (coalesce(vtemp, 0) / coalesce(vquant_mprima,' +
          ' 0));'
        '    '
        '      vtemp = 0;'
        '      select estoque from getestoque_recursivo ('
        '        :vgrupo_prod_mprima,'
        '        :vcod_prod_mprima,'
        '        :pcod_empresa,'
        '        :vcod_grade_mprima) into :vtemp;'
        '    '
        '      vestoque = coalesce(vestoque, 0) + coalesce(vtemp, 0);'
        '    '
        '      if (coalesce(vok, 0) = 0) then'
        '        vestoque_p = coalesce(vestoque, 0);'
        
          '      else if (coalesce(vestoque, 0) < coalesce(vestoque_p, 0)) ' +
          'then'
        '        vestoque_p = coalesce(vestoque, 0);'
        ''
        '      vok = 1;'
        '    end'
        '    estoque = coalesce(estoque, 0) + coalesce(vestoque_p, 0);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETESTOQUEDISPONIVEL ('
        '    PGRUPOPROD integer,'
        '    PCODPROD char(6),'
        '    PCODGRADE integer,'
        '    PCODEMPRESA integer,'
        '    PNUMVENDA integer,'
        '    PTIPOVENDA varchar(5),'
        '    PCODPEDALMOX integer,'
        '    PNITEMPEDALMOX integer)'
        'returns ('
        '    ESTOQUE double precision,'
        '    PEND_REQOS double precision,'
        '    PEND_PDC double precision,'
        '    PEND_ALMOX double precision,'
        '    EST_F double precision,'
        '    EST_PRIMA double precision)'
        'as'
        'declare variable VSQL varchar(1000);'
        'declare variable VESTOQUE double precision;'
        'declare variable VPENDENCIA double precision;'
        'declare variable VABATERITENS char(1);'
        'declare variable VUSAR_PRODUCAO_TIPO char(1);'
        'declare variable VCOD_VENDEDOR integer;'
        'declare variable VUSARCONFERENCIAPRODUTO char(1);'
        'declare variable VCRIAR_PRODUCAO_AUT char(1);'
        'begin     '
        ''
        
          '  if ((pgrupoprod is null) or (pcodprod is null) or (pcodempresa' +
          ' is null)) then'
        '   exit;'
        ''
        '  vSql = '#39#39';'
        
          '  select abater_itens from empresa where cod_empresa = :pcodempr' +
          'esa into: vabateritens;'
        ''
        
          '  select usar_producao_tipo from empresa where cod_empresa = :pc' +
          'odempresa into :vusar_producao_tipo;'
        ''
        
          '  select criar_producao_aut from produtos where grupo_prod = :pg' +
          'rupoprod and cod_prod = :pcodprod and cod_empresa = :pcodempresa' +
          ' into :vcriar_producao_aut;'
        ''
        '  if (coalesce(pcodgrade, 0) <= 0) then'
        '  begin'
        '    select est_f from produtos'
        '    where grupo_prod = :pgrupoprod'
        '    and cod_prod = :pcodprod'
        '    and cod_empresa = :pcodempresa into :vestoque;'
        '  end'
        '  else'
        '  begin'
        '    select qtde from cod_grade_prod'
        '    where grupo_prod = :pgrupoprod'
        '    and cod_prod = :pcodprod'
        '    and cod_grade = :pcodgrade'
        '    and cod_empresa = :pcodempresa into :vestoque;'
        '  end'
        ''
        '  est_f = coalesce(vestoque, 0);'
        ''
        
          '  if ((coalesce(vabateritens, '#39#39') = '#39'S'#39') and (coalesce(pnumvenda' +
          ', 0) > 0) and (Trim(coalesce(ptipovenda, '#39#39')) <> '#39#39')) then'
        '  begin'
        
          '    select first 1 coalesce(tv.usar_conferencia_produto, '#39#39') as ' +
          'usar_conferencia_produto, pv.cod_vendedor from pedvenda pv'
        
          '    inner join tipo_vendas tv on tv.tipo = pv.tipo and tv.sigla ' +
          '= pv.tipv'
        '    where pv.nped = :pnumvenda'
        '    and pv.tipo = :ptipovenda'
        '    and pv.cod_empresa = :pcodempresa'
        
          '    order by tv.cod_tipo into : vusarconferenciaproduto, :vcod_v' +
          'endedor;'
        ''
        '    if (coalesce(vusarconferenciaproduto, '#39#39') <> '#39'S'#39') then'
        
          '      vSql = vsql || '#39' inner join tipo_vendas tv on tv.sigla = p' +
          'd.tipv and tv.tipo = pd.tipo'
        
          '         and (coalesce(tv.usar_conferencia_produto, '#39#39#39#39') <> '#39#39'S' +
          #39#39')'#39';'
        '  end'
        ''
        
          '  vSql = vSql || '#39' where pd.ativo = 1 and itpd.grupo_prod = '#39'||:' +
          'pgrupoprod||'#39' and itpd.cod_prod = '#39#39#39'||:pcodprod||'#39#39#39
        '     and pd.cod_empresa = '#39' || pcodempresa ||'#39
        
          '     and (pd.data_fech is null or pd.data_fech < '#39#39'01.01.1899'#39#39' ' +
          ') and (itpd.status<>'#39#39'CANCELADO'#39#39' or itpd.status is null)'
        '     and pd.tipo <> '#39#39'ORC'#39#39' '#39';'
        ''
        
          '  if ((coalesce(vabateritens, '#39#39') = '#39'S'#39') and (coalesce(pnumvenda' +
          ', 0) > 0)'
        
          '    and (Trim(ptipovenda) <> '#39#39') and (Trim(vusarconferenciaprodu' +
          'to) <> '#39'S'#39')) then'
        '    vSql = vSql || '#39' and pd.cod_vendedor = '#39'|| :vcod_vendedor;'
        ''
        '  if (coalesce(pcodgrade, 0) > 0) then'
        '    vSql = vSql || '#39' and itpd.cod_grade = '#39'|| :pcodgrade;'
        '             '
        
          '  if ((coalesce(pnumvenda, 0) > 0) and (coalesce(ptipovenda, '#39#39')' +
          ' <> '#39#39')) then'
        
          '    vSql = vSql || '#39' and pd.nped = '#39'|| :pnumvenda || '#39' and pd.ti' +
          'po = '#39#39#39' || :ptipovenda || '#39#39#39' '#39';'
        ''
        '  execute statement'
        
          '    '#39' select sum(itpd.quant_ped_item) as pendecia from pedvenda ' +
          'pd'
        
          '    inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.' +
          'cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo'
        '    '#39' || vSql into :vpendencia;'
        ''
        '  pend_reqos = coalesce(vpendencia, 0);'
        ''
        '  vestoque = coalesce(vestoque, 0) - coalesce(vpendencia, 0);'
        ''
        '  vsql = '#39#39';'
        '  if (coalesce(pcodgrade, 0) > 0) then'
        '    vSql = vSql || '#39' and pi.cod_grade = '#39'||:pcodgrade;'
        ''
        '  if (Trim(coalesce(ptipovenda, '#39#39')) = '#39'PRODUCAO'#39') then'
        '    vSql = vSql || '#39' and pd.cod_producao <> '#39'|| :pnumvenda;'
        ''
        
          '  execute statement '#39'select sum(coalesce(pi.quantidade_utilizada' +
          ',0) + coalesce(pi.quantidade_perda,0)) as pendecia from producao' +
          ' pd, producao_item_indice pi'
        '                    where pi.grupo_prod = '#39' || :pgrupoprod ||'
        '                    '#39' and pi.cod_prod = '#39#39#39' || :pcodprod || '#39#39#39
        
          '                    and pd.cod_producao = pi.cod_producao and pd' +
          '.cod_empresa = pi.cod_empresa'
        
          '                    and (pd.data_fechamento is null) and pd.cod_' +
          'empresa = '#39' || :pcodempresa || vsql into :vpendencia;'
        ''
        '  pend_pdc = coalesce(vpendencia, 0);'
        ''
        '  vestoque = coalesce(vestoque, 0) - coalesce(vpendencia, 0);'
        ''
        '  vSql = '#39#39';'
        '  if (coalesce(pcodgrade, 0) > 0) then'
        '      vSql = vSql || '#39' and c.cod_grade = '#39'||:pcodgrade;'
        ''
        '  execute statement'
        
          '    '#39' select sum(coalesce(c.quant,0)) as pendecia from controle_' +
          'almoxarifado c'
        
          '      where not(c.cod_pedido = '#39'||:pcodpedalmox||'#39' and c.nitem =' +
          ' '#39'||:pnitempedalmox||'#39')'#39'||'#39
        
          '      and c.grupo_prod = '#39'|| :pgrupoprod ||'#39' and c.cod_prod = '#39#39 +
          #39'||:pcodprod||'#39#39#39
        
          '      and c.cod_empresa = '#39'||:pcodempresa|| vsql into :vpendenci' +
          'a;'
        ''
        '  pend_almox = coalesce(vpendencia, 0);'
        ''
        '  vestoque = coalesce(vestoque, 0) - coalesce(vpendencia, 0);'
        ''
        
          '  if ((coalesce(vcriar_producao_aut, '#39'N'#39') = '#39'S'#39') and (coalesce(v' +
          'usar_producao_tipo, '#39'N'#39') = '#39'S'#39')) then'
        '  begin'
        '    vSql = '#39#39';'
        '    if (coalesce(pcodgrade, 0) > 0) then'
        '      vSql = :pcodgrade;'
        '    else'
        '      vSql = '#39'0'#39';'
        '    '
        '    execute statement'
        '      '#39' select estoque from getestoque_recursivo ('
        '          '#39' || :pgrupoprod || '#39','
        '          '#39#39#39' || :pcodprod || '#39#39#39', '#39
        '          || :pcodempresa || '#39', '#39
        '          || :vSql || '#39') '#39' into :vpendencia;'
        '    '
        '    est_prima = coalesce(vpendencia, 0);'
        '  end'
        ''
        '  ESTOQUE = vestoque;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETMATERIA_PRIMA_RECURSIVO ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PQUANT double precision,'
        '    PQTDE_DIM_EST double precision)'
        'returns ('
        '    RESULT varchar(100))'
        'as'
        'declare variable VPRODUCAO_AUT_ESTOQUE_NEG double precision;'
        'declare variable VEST_F_ACABADO double precision;'
        'declare variable VESTOQUE_DISP_ACABADO double precision;'
        'declare variable VESTOQUE_MATPRIMA_ACABADO double precision;'
        'declare variable VQUANT_ITEM_ACABADO double precision;'
        'declare variable VEST_F_ANT_ACABADO double precision;'
        'declare variable VCUSTO_INDICE_ACABADO double precision;'
        'declare variable VCUSTO_RATEIO_ACABADO double precision;'
        'declare variable VPREC_CUS_PROD_ACABADO double precision;'
        'declare variable VPREC_CUSM_PROD_ACABADO double precision;'
        'declare variable VPESO_BRUT_PROD_ACABADO double precision;'
        'declare variable VGRUPO_PROD_MPRIMA integer;'
        'declare variable VCOD_PROD_MPRIMA char(6);'
        'declare variable VCOD_GRADE_MPRIMA integer;'
        'declare variable VIND_IND_MPRIMA integer;'
        'declare variable VEST_F_MPRIMA double precision;'
        'declare variable VESTOQUE_DISP_MPRIMA double precision;'
        'declare variable VESTOQUE_RECURSIVO_MPRIMA double precision;'
        'declare variable VQUANT_MPRIMA double precision;'
        'declare variable VQTDE_PRODUCAO double precision;'
        'declare variable VPREC_CUS_PROD_MPRIMA double precision;'
        'declare variable VPREC_CUSM_PROD_MPRIMA double precision;'
        'declare variable VPESO_BRUT_PROD_MPRIMA double precision;'
        'declare variable VID_IND_A integer;'
        'declare variable VPREC_CUS_MED_TEMP double precision;'
        'declare variable VTEMP double precision;'
        'declare variable VVALORPARARATEIO_MPRIMA double precision;'
        'declare variable VRESULT varchar(100);'
        'declare variable VEXISTE_GRADE integer;'
        'begin'
        '  /* Procedure Text */'
        '  vqtde_producao = 0;'
        '  result = '#39'OK'#39';'
        ''
        '  select value1_f from config_sistema'
        '  where chave = '#39'producao_aut_estoque_neg'#39
        '  and cod_empresa = :pcod_empresa'
        '  into: vproducao_aut_estoque_neg;'
        ''
        '  select est_f, estoque from getestoquedisponivel('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    coalesce(:pcod_grade, 0),'
        '    :pcod_empresa,'
        '    0,'
        '    '#39#39','
        '    0,'
        '    0)'
        '  into :vest_f_acabado, :vestoque_disp_acabado;'
        ''
        '  if (coalesce(pqtde_dim_est, 0) > 0) then'
        '  begin'
        
          '    vest_f_acabado = coalesce(:vest_f_acabado, 0) - coalesce(pqt' +
          'de_dim_est, 0);'
        
          '    vestoque_disp_acabado = coalesce(vestoque_disp_acabado, 0)  ' +
          '- coalesce(pqtde_dim_est, 0);'
        '  end'
        ''
        '  select estoque from getestoque_recursivo('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    coalesce(:pcod_grade, 0))'
        '  into :vestoque_matprima_acabado;'
        ''
        '  -- Produto acabado sem estoque'
        '  if (coalesce(vestoque_disp_acabado, 0) >= 0) then'
        '  begin'
        '    result = '#39'PRODUTO ACABADO NAO ESTA COM ESTOQUE NEGATIVO'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(vproducao_aut_estoque_neg, 0) = 0) then'
        '    if (coalesce(vestoque_matprima_acabado, 0) <= 0) then'
        '    begin'
        '      result = '#39'MATERIA PRIMA SEM ESTOQUE SUFICIENTE'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '  -- Produto acabado nao possui cadastro da grade na producao'
        '  if (coalesce(pcod_grade, 0) <= 0) then'
        '  begin'
        '    select count(*) from cod_grade_prod cprod'
        '    where cprod.grupo_prod = :pgrupo_prod'
        '    and cprod.cod_prod = :pcod_prod'
        '    and cprod.cod_empresa = :pcod_empresa'
        '    and cprod.cod_grade > 0'
        '      into :vexiste_grade;'
        ''
        
          '    if ((coalesce(vexiste_grade, 0) > 0) and (coalesce(pcod_grad' +
          'e, 0) <= 0)) then'
        '    begin'
        
          '      result = '#39'PRODUTO ACABADO NAO POSSUI CADASTRO DA GRADE NA ' +
          'PRODUCAO'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        '  '
        '  select first 1 pa.id_ind from produtos_pdc_var pa'
        '  where pa.grupo_prod = :pgrupo_prod'
        '  and pa.cod_prod = :pcod_prod'
        '  and pa.cod_grade = :pcod_grade'
        '  and pa.cod_empresa = :pcod_empresa'
        '  into :vid_ind_a;'
        ''
        '  -- Produto acabado nao possui cadastro da grade na producao'
        
          '  if ((coalesce(pcod_grade, 0) > 0) and (coalesce(vid_ind_a, 0) ' +
          '<= 0)) then'
        '  begin'
        
          '    result = '#39'PRODUTO ACABADO NAO POSSUI CADASTRO DA GRADE NA PR' +
          'ODUCAO'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  -- Estoque anterior do produto acabado'
        
          '  vest_f_ant_acabado  = (coalesce(pquant, 0)) - abs(coalesce(ves' +
          't_f_acabado, 0));'
        ''
        '  -- Quantidade produto acabado'
        
          '  if ((coalesce(vest_f_ant_acabado, 0) = 0) and (coalesce(pquant' +
          ', 0) = abs(coalesce(vest_f_ant_acabado, 0)))) then'
        '    vquant_item_acabado = coalesce(pquant, 0);'
        '  else'
        
          '    vquant_item_acabado = coalesce(pquant, 0) - coalesce(vest_f_' +
          'ant_acabado, 0);'
        ''
        '  -- Estoque materia prima menor que o da venda'
        '  if (coalesce(vproducao_aut_estoque_neg, 0) = 1) then'
        '    vquant_item_acabado = abs(coalesce(vest_f_acabado, 0));'
        
          '  else if (coalesce(vquant_item_acabado, 0) > coalesce(vestoque_' +
          'matprima_acabado, 0)) then'
        
          '    vquant_item_acabado = coalesce(vestoque_matprima_acabado, 0)' +
          ';'
        ''
        '  vtemp = 0;'
        '  vprec_cus_med_temp = 0;'
        '  vcusto_indice_acabado = 0;'
        '  vcusto_rateio_acabado = 0;'
        '  vprec_cus_prod_acabado = 0;'
        '  vprec_cusm_prod_acabado = 0;'
        '  vvalorpararateio_mprima = 0;'
        '  for select ind.grupo_prod_mprima, ind.cod_prod_mprima,'
        
          '    iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, 0)' +
          ', 0),'
        
          '    iif(coalesce(pm.id_ind, 0) > 0, coalesce(pm.id_ind_it, 0), 0' +
          '),'
        '    iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.qtde, 0),'
        '    coalesce(pr.est_f, 0)),'
        '    (select estoque from getestoquedisponivel('
        '      ind.grupo_prod_mprima,'
        '      ind.cod_prod_mprima,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0),'
        '      ind.cod_empresa,'
        '      0,'
        '      '#39#39','
        '      0,'
        '      0)) estoque_disp_mprima,'
        '    (select estoque from getestoque_recursivo('
        '      ind.grupo_prod_mprima,'
        '      ind.cod_prod_mprima,'
        '      ind.cod_empresa,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0))) estoque_recursivo_mprima,'
        '    coalesce(ind.quant, 0) quant,'
        '    coalesce(pa.prec_cus_prod, 0) prec_cus_prod_acabado,'
        '    coalesce(pa.prec_cusm_prod, 0) prec_cusm_prod_acabado,'
        '    coalesce(pa.peso_brut_prod, 0) peso_brut_prod_acabado,'
        '    coalesce(pr.prec_cus_prod, 0) prec_cus_prod_mprima,'
        
          '    coalesce(pr.prec_cusm_prod, 0) prec_cusm_prod_mprima from in' +
          'dice_tecnico ind'
        '    inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '    inner join produtos pr on'
        '        pr.grupo_prod = ind.grupo_prod_mprima'
        '        and pr.cod_prod = ind.cod_prod_mprima'
        '        and pr.cod_empresa = ind.cod_empresa'
        '    left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '    left join cod_grade_prod gr on'
        '        gr.grupo_prod = ind.grupo_prod_mprima'
        '        and gr.cod_prod = ind.cod_prod_mprima'
        '        and gr.cod_grade = coalesce(pm.cod_grade, 0)'
        '        and gr.cod_empresa = ind.cod_empresa'
        '    where ind.grupo_prod_acabado = :pgrupo_prod'
        '    and ind.cod_prod_acabado = :pcod_prod'
        '    and ind.cod_empresa = :pcod_empresa'
        '    and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '    and (select count(*) from temp_producao_aut tmp'
        '         where tmp.nped = :pnped'
        '         and tmp.tipo = :ptipo'
        '         and tmp.cod_empresa = :pcod_empresa'
        '         and tmp.grupo_prod_acabado = :pgrupo_prod'
        '         and tmp.cod_prod_acabado = :pcod_prod'
        '         and tmp.cod_grade_acabado = coalesce(:pcod_grade, 0)'
        '         and tmp.grupo_prod_mprima = ind.grupo_prod_mprima'
        '         and tmp.cod_prod_mprima = ind.cod_prod_mprima'
        
          '         and tmp.cod_grade_mprima = coalesce(gr.cod_grade, 0)) =' +
          ' 0'
        
          '  into :vgrupo_prod_mprima, :vcod_prod_mprima, :vcod_grade_mprim' +
          'a, :vind_ind_mprima,'
        
          '    :vest_f_mprima, :vestoque_disp_mprima, :vestoque_recursivo_m' +
          'prima, :vquant_mprima,'
        
          '    :vprec_cus_prod_acabado, :vprec_cusm_prod_acabado, :vpeso_br' +
          'ut_prod_acabado,'
        '    :vprec_cus_prod_mprima, :vprec_cusm_prod_mprima do'
        '  begin'
        '    -- Materia prima nao possui cadastro da grade na producao'
        
          '    if ((coalesce(vcod_grade_mprima, 0) > 0) and (coalesce(vind_' +
          'ind_mprima, 0) <= 0)) then'
        '    begin'
        
          '      result = '#39'MATERIA PRIMA NAO POSSUI CADASTRO DA GRADE NA PR' +
          'ODUCAO'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '    -- Sem estoque na materia prima'
        '    if (coalesce(vproducao_aut_estoque_neg, 0) = 0) then'
        
          '      if ((coalesce(vestoque_disp_mprima, 0) + coalesce(vestoque' +
          '_recursivo_mprima, 0)) < coalesce(vquant_mprima, 0)) then'
        '      begin'
        '        result = '#39'MATERIA PRIMA SEM ESTOQUE SUFICIENTE'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '    -- Custo indico item acabado'
        '    vcusto_indice_acabado = coalesce(vcusto_indice_acabado, 0) +'
        
          '      (coalesce(vprec_cusm_prod_mprima, 0) * coalesce(vquant_mpr' +
          'ima, 0));'
        ''
        '    -- Materia prima tem estoque disponivel'
        '    if (coalesce(vquant_mprima, 0) > 0) then'
        '    begin'
        
          '      if (coalesce(vqtde_producao, 0) > (coalesce(vestoque_disp_' +
          'mprima, 0) + coalesce(vestoque_recursivo_mprima, 0)) / coalesce(' +
          'vquant_mprima, 0)) then'
        
          '        vqtde_producao = ((coalesce(vestoque_disp_mprima, 0) + c' +
          'oalesce(vestoque_recursivo_mprima, 0)) / coalesce(vquant_mprima,' +
          ' 0));'
        '      else if (coalesce(vqtde_producao, 0) = 0) then'
        
          '        vqtde_producao = ((coalesce(vestoque_disp_mprima, 0) + c' +
          'oalesce(vestoque_recursivo_mprima, 0)) / coalesce(vquant_mprima,' +
          ' 0));'
        '    end'
        '    else'
        
          '      vqtde_producao = (coalesce(vestoque_disp_mprima, 0) + coal' +
          'esce(vestoque_recursivo_mprima, 0));'
        ''
        '    -- Preco de custo medio atual'
        
          '    vtemp = coalesce(vtemp, 0) + (coalesce(vprec_cus_prod_mprima' +
          ', 0) * coalesce(vquant_mprima, 0));'
        '  end'
        ''
        '  vprec_cus_med_temp = 0;'
        '  -- Preco de custo medio atual'
        '  vprec_cus_med_temp = coalesce(vprec_cus_med_temp, 0) +'
        
          '    (coalesce(vtemp, 0) * (coalesce(vquant_item_acabado, 0) / co' +
          'alesce(pquant, 0)));'
        ''
        '  -- Preco de custo medio anterior'
        '  if (coalesce(vest_f_ant_acabado, 0) > 0) then'
        '    vprec_cus_med_temp = coalesce(vprec_cus_med_temp, 0) +'
        
          '        (coalesce(vprec_cusm_prod_acabado, 0) * ((coalesce(pquan' +
          't, 0) - coalesce(vquant_item_acabado, 0)) / coalesce(pquant, 0))' +
          ');'
        ''
        '  -- Preco de custo medio acabado'
        '  vprec_cusm_prod_acabado = coalesce(vprec_cus_med_temp, 0);'
        ''
        '  -- Preco de custo item acabado'
        '  vprec_cus_prod_acabado = coalesce(vcusto_indice_acabado, 0);'
        ''
        '  -- Custo indice acabado'
        
          '  vcusto_indice_acabado = coalesce(vcusto_indice_acabado, 0) * c' +
          'oalesce(:vquant_item_acabado, 0);'
        ''
        '  if (result = '#39'OK'#39') then'
        '  begin'
        '    for select ind.grupo_prod_mprima, ind.cod_prod_mprima,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0),'
        
          '      iif(coalesce(pm.id_ind, 0) > 0, coalesce(pm.id_ind_it, 0),' +
          ' 0),'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.qtde, 0), c' +
          'oalesce(pr.est_f, 0)),'
        '      (select estoque from getestoquedisponivel('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        
          '        iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade' +
          ', 0), 0),'
        '        ind.cod_empresa,'
        '        0,'
        '        '#39#39','
        '        0,'
        '        0)) estoque_disp_mprima,'
        '      (select estoque from getestoque_recursivo('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        '        ind.cod_empresa,'
        
          '        iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade' +
          ', 0), 0))) estoque_recursivo_mprima,'
        '      coalesce(ind.quant, 0) quant,'
        '      coalesce(pr.prec_cus_prod, 0) prec_cus_prod,'
        '      coalesce(pr.prec_cusm_prod, 0) prec_cusm_prod,'
        
          '      coalesce(pr.peso_brut_prod, 0) peso_brut_prod from indice_' +
          'tecnico ind'
        '      inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '      inner join produtos pr on'
        '        pr.grupo_prod = ind.grupo_prod_mprima'
        '        and pr.cod_prod = ind.cod_prod_mprima'
        '        and pr.cod_empresa = ind.cod_empresa'
        '      left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '      left join cod_grade_prod gr on'
        '        gr.grupo_prod = ind.grupo_prod_mprima'
        '        and gr.cod_prod = ind.cod_prod_mprima'
        '        and gr.cod_grade = coalesce(pm.cod_grade, 0)'
        '        and gr.cod_empresa = ind.cod_empresa'
        '      where ind.grupo_prod_acabado = :pgrupo_prod'
        '      and ind.cod_prod_acabado = :pcod_prod'
        '      and ind.cod_empresa = :pcod_empresa'
        '      and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '      and (select count(*) from temp_producao_aut tmp'
        '           where tmp.nped = :pnped'
        '           and tmp.tipo = :ptipo'
        '           and tmp.cod_empresa = :pcod_empresa'
        '           and tmp.grupo_prod_acabado = :pgrupo_prod'
        '           and tmp.cod_prod_acabado = :pcod_prod'
        '           and tmp.cod_grade_acabado = coalesce(:pcod_grade, 0)'
        '           and tmp.grupo_prod_mprima = ind.grupo_prod_mprima'
        '           and tmp.cod_prod_mprima = ind.cod_prod_mprima'
        
          '           and tmp.cod_grade_mprima = coalesce(gr.cod_grade, 0))' +
          ' = 0'
        
          '    into :vgrupo_prod_mprima, :vcod_prod_mprima, :vcod_grade_mpr' +
          'ima, :vind_ind_mprima,'
        
          '        :vest_f_mprima, :vestoque_disp_mprima, :vestoque_recursi' +
          'vo_mprima, :vquant_mprima,'
        
          '        :vprec_cus_prod_mprima, :vprec_cusm_prod_mprima, :vpeso_' +
          'brut_prod_mprima do'
        '    begin'
        '      insert into temp_producao_aut ('
        '        nped,'
        '        tipo,'
        '        cod_empresa,'
        '        grupo_prod_acabado,'
        '        cod_prod_acabado,'
        '        cod_grade_acabado,'
        '        quant_ped_item_acabado,'
        '        est_f_acabado,'
        '        est_f_ant_acabado,'
        '        estoque_disp_acabado,'
        '        custo_indice_acabado,'
        '        custo_rateio_acabado,'
        '        prec_cus_prod_acabado,'
        '        prec_cusm_prod_acabado,'
        '        peso_un_acabado,'
        '        peso_util_acabado,'
        '        grupo_prod_mprima,'
        '        cod_prod_mprima,'
        '        cod_grade_mprima,'
        '        quant_mprima,'
        '        est_f_mprima,'
        '        estoque_disp_mprima,'
        '        qtde_producao,'
        '        prec_cusm_prod_mprima,'
        '        peso_un_mprima,'
        '        peso_util_mprima'
        '      )'
        '      values ('
        '        :pnped,'
        '        :ptipo,'
        '        :pcod_empresa,'
        '        :pgrupo_prod,'
        '        :pcod_prod,'
        '        coalesce(:pcod_grade, 0),'
        '        coalesce(:vquant_item_acabado, 0),'
        '        coalesce(:vest_f_acabado, 0),'
        '        coalesce(:vest_f_ant_acabado, 0),'
        '        coalesce(:vestoque_disp_acabado, 0),'
        '        coalesce(:vcusto_indice_acabado, 0),'
        '        coalesce(:vcusto_rateio_acabado, 0),'
        '        coalesce(:vprec_cus_prod_acabado, 0),'
        '        coalesce(:vprec_cusm_prod_acabado, 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_acabado, 0) > 0, coalesce(' +
          ':vpeso_brut_prod_acabado, 0), 1),'
        
          '        iif(coalesce(:vpeso_brut_prod_acabado, 0) > 0, coalesce(' +
          ':vpeso_brut_prod_acabado, 0), 1) * coalesce(:vquant_item_acabado' +
          ', 0),'
        '        :vgrupo_prod_mprima,'
        '        :vcod_prod_mprima,'
        '        coalesce(:vcod_grade_mprima, 0),'
        '        coalesce(:vquant_mprima, 0),'
        '        coalesce(:vest_f_mprima, 0),'
        
          '        coalesce(:vestoque_disp_mprima, 0) + coalesce(:vestoque_' +
          'recursivo_mprima, 0),'
        '        coalesce(:vqtde_producao, 0),'
        '        coalesce(:vprec_cusm_prod_mprima, 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_mprima, 0) > 0, coalesce(:' +
          'vpeso_brut_prod_mprima, 0), 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_mprima, 0) > 0, coalesce(:' +
          'vpeso_brut_prod_mprima, 0), 0) * coalesce(:vquant_mprima, 0)'
        '      );'
        '    end'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETCRIARPRODUCAO_TEMP ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT varchar(100))'
        'as'
        'declare variable VGRUPO_PROD_ACAB integer;'
        'declare variable VCOD_PROD_ACAB char(6);'
        'declare variable VCOD_GRADE_ACAB integer;'
        'declare variable VCOD_EMPRESA_ACAB integer;'
        'declare variable VQUANT_PED_ACAB double precision;'
        'declare variable VGRUPO_PROD_MPRIMA integer;'
        'declare variable VCOD_PROD_MPRIMA char(6);'
        'declare variable VESTOQUE_MPRIMA double precision;'
        'declare variable VQUANT_MPRIMA double precision;'
        'declare variable VTEMP double precision;'
        'declare variable VRESULT varchar(100);'
        'declare variable VRESULT_OK varchar(100);'
        'declare variable VGRUPO_PROD integer;'
        'declare variable VCOD_PROD char(6);'
        'declare variable VCOD_GRADE integer;'
        'declare variable VQTDE double precision;'
        'declare variable VTQDE_DIM_EST double precision;'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'OK'#39';'
        ''
        
          '  if ((:pnped > 0) and (trim(:ptipo) <> '#39#39') and (:pcod_empresa >' +
          ' 0)) then'
        '  begin'
        
          '    for select pp.grupo_prod, pp.cod_prod, pp.cod_grade, pp.cod_' +
          'empresa, sum(coalesce(pp.quant_ped_item, 0)) quant_ped_item from' +
          ' pedvenda pd'
        '      inner join pedvenda_prod pp on'
        '        pp.nped = pd.nped'
        '        and pp.tipo = pd.tipo'
        '        and pp.cod_empresa = pd.cod_empresa'
        '      inner join produtos pr on'
        '        pr.grupo_prod = pp.grupo_prod'
        '        and pr.cod_prod = pp.cod_prod'
        '        and pr.cod_empresa = pp.cod_empresa'
        '      where pp.nped = :pnped'
        '      and pp.tipo = :ptipo'
        '      and pp.cod_empresa = :pcod_empresa'
        '      and coalesce(pp.status, '#39#39') <> '#39'CANCELADO'#39
        '      and pp.ativo = 1'
        
          '      and not(coalesce(pp.quant_ped_item, 0) = coalesce(pp.quant' +
          '_item_dev, 0) and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39')'
        '      and coalesce(pr.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '      group by 1, 2, 3, 4'
        
          '    into :vgrupo_prod_acab, :vcod_prod_acab, :vcod_grade_acab, :' +
          'vcod_empresa_acab, :vquant_ped_acab do'
        '    begin'
        
          '      for select grupo_prod, cod_prod, cod_grade, qtde from getp' +
          'rodutosacabados ('
        '        :vgrupo_prod_acab,'
        '        :vcod_prod_acab,'
        '        :vcod_grade_acab,'
        '        :vcod_empresa_acab,'
        '        coalesce(:vquant_ped_acab, 0))'
        '          into :vgrupo_prod, :vcod_prod, :vcod_grade, :vqtde do'
        '      begin'
        '        vtqde_dim_est = 0;'
        
          '        if  ( (coalesce(vgrupo_prod_acab, 0) = coalesce(vgrupo_p' +
          'rod, 0))'
        
          '          and (coalesce(vcod_prod_acab, '#39#39') = coalesce(vcod_prod' +
          ', '#39#39'))'
        
          '          and (coalesce(vcod_grade_acab, 0) = coalesce(vcod_grad' +
          'e, 0))  ) then'
        '        begin'
        '          vtqde_dim_est = 0;'
        '        end'
        '        else'
        '        begin'
        '          vtqde_dim_est = coalesce(vqtde, 0);'
        '        end'
        ''
        '        select result from getmateria_prima_recursivo('
        '          :pnped,'
        '          :ptipo,'
        '          :vgrupo_prod,'
        '          :vcod_prod,'
        '          coalesce(:vcod_grade, 0),'
        '          :pcod_empresa,'
        '          coalesce(:vqtde, 0),'
        '          coalesce(:vtqde_dim_est, 0)'
        '        )'
        '          into :vresult;'
        ''
        '        if (coalesce(vresult, '#39#39') = '#39'OK'#39') then'
        '          vresult_ok = coalesce(vresult, '#39#39');'
        ''
        
          '        if ((coalesce(vresult_ok, '#39#39') <> '#39'OK'#39') and (coalesce(vre' +
          'sult, '#39#39') <> '#39'OK'#39')) then'
        '        begin'
        '          result = vresult;'
        '          suspend;'
        '        end'
        '      end'
        '    end'
        '  end'
        '  result = '#39'OK'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_PRODUCAO_AUT ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT varchar(100))'
        'as'
        'declare variable VERRO char(1);'
        'declare variable VCOD_PRODUCAO integer;'
        'declare variable VGRUPO_PROD_A integer;'
        'declare variable VCOD_PROD_A char(6);'
        'declare variable VEST_F_A double precision;'
        'declare variable VESTOQUE_DISP_A double precision;'
        'declare variable VNITEM_A integer;'
        'declare variable VCOD_GRADE_A integer;'
        'declare variable VCODIGO_NOP_A double precision;'
        'declare variable VNUM_FAB_PROD_A varchar(20);'
        'declare variable VDESCR_PROD_A varchar(75);'
        'declare variable VUNIDADE_A varchar(3);'
        'declare variable VQUANT_PED_ITEM_A double precision;'
        'declare variable VPREC_CUS_PROD_A double precision;'
        'declare variable VPREC_CUSM_PROD_A double precision;'
        'declare variable VCUSTO_INDICE_A double precision;'
        'declare variable VCUSTO_RATEIO_A double precision;'
        'declare variable VPESO_BRUT_PROD_A double precision;'
        'declare variable VPESO_UN_A double precision;'
        'declare variable VPESO_UTIL_A double precision;'
        'declare variable VGRUPO_PROD_P integer;'
        'declare variable VCOD_PROD_P char(6);'
        'declare variable VNITEM_P integer;'
        'declare variable VCOD_GRADE_P integer;'
        'declare variable VCODIGO_NOP_P double precision;'
        'declare variable VNUM_FAB_PROD_P varchar(20);'
        'declare variable VDESCR_PROD_P varchar(75);'
        'declare variable VUNIDADE_P varchar(3);'
        'declare variable VQUANT_PED_ITEM_P double precision;'
        'declare variable VQUANT_MPRIMA_P double precision;'
        'declare variable VEST_F_MPRIMA double precision;'
        'declare variable VPREC_CUS_PROD_P double precision;'
        'declare variable VPREC_CUSM_PROD_P double precision;'
        'declare variable VPESO_BRUT_PROD_P double precision;'
        'declare variable VPESO_UN_P double precision;'
        'declare variable VPESO_UTIL_P double precision;'
        'declare variable VTIPO_ITEM_P char(2);'
        'declare variable VNITEM_ACAB integer;'
        'declare variable VNITEM_PRIMA integer;'
        'declare variable VNITEMID_PRIMA integer;'
        'declare variable VQTDE_MATERIA_PRIMA double precision;'
        'declare variable VEXISTE_MAT_PRIMA integer;'
        'declare variable VCRIAR_PROD_TEMP varchar(100);'
        'declare variable VCRIAR_PROD integer;'
        'declare variable VVENDA_FECHADA_HOJE integer;'
        'declare variable VPRODUCAO_GERADA integer;'
        'declare variable VPRODUCAO_GERADA_HOJE integer;'
        'declare variable VPRODUCAO_ESTORNAR integer;'
        'declare variable VSTATUS_PED varchar(10);'
        'declare variable VTEMP varchar(50);'
        'declare variable VPREC_CUS_PROD double precision;'
        'declare variable VPREC_CUSM_PROD double precision;'
        'declare variable VCUSTOMEDIO_A double precision;'
        'declare variable VEST_F double precision;'
        'declare variable VCODIGO_TEMP integer;'
        'declare variable VPRECCUSPROD_TEMP double precision;'
        'declare variable VPRECCUSMPROD_TEMP double precision;'
        'declare variable VPRECCUSMNF_TEMP double precision;'
        'declare variable VDATAULTCOMPRA_TEMP timestamp;'
        'declare variable VNUMNFREC_TEMP integer;'
        'declare variable VCODPRODU_TEMP integer;'
        'declare variable VUSAR_PRODUCAO_TIPO char(1);'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'ERRO'#39';'
        '  vproducao_gerada = 0;'
        '  vproducao_gerada_hoje = 0;'
        '  vexiste_mat_prima = 0;'
        '  vnitem_acab = 0;'
        '  vnitem_prima = 0;'
        '  vnitemid_prima = 0;'
        '  '
        '  if ((trim(ptipo) <> '#39'REQ'#39') and (trim(ptipo) <> '#39'OS'#39'))  then'
        '    exit;'
        ''
        '  select usar_producao_tipo from empresa'
        '  where cod_empresa = :pcod_empresa into :vusar_producao_tipo;'
        ''
        '  if (coalesce(vusar_producao_tipo, '#39'N'#39') <> '#39'S'#39') then'
        '  begin'
        '    result = '#39'PRODUCAO SIMPLES NAO CONFIGURADA'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  if ((:pnped > 0) and (trim(:ptipo) <> '#39#39') and (:pcod_empresa >' +
          ' 0)) then'
        '  begin'
        '    select coalesce(status_ped, '#39#39') from pedvenda'
        '    where nped = :pnped'
        '    and tipo = :ptipo'
        '    and cod_empresa = :pcod_empresa into :vstatus_ped;'
        ''
        '    -- Venda aberta'
        '    if (coalesce(vstatus_ped, '#39#39') = '#39#39') then'
        '    begin'
        '      select count(*) from producao_item pdi'
        '      where pdi.nped = :pnped'
        '      and pdi.tipo = :ptipo'
        
          '      and pdi.cod_empresa = :pcod_empresa into :vproducao_estorn' +
          'ar;'
        ''
        '      -- Estornar producao'
        '      if (coalesce(vproducao_estornar, 0) <= 0) then'
        '      begin'
        '        result = '#39'ITENS DA PRODUCAO DESTA VENDA JA REMOVIDOS'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '      select first 1 pdi.cod_producao from producao pd'
        
          '      inner join producao_item pdi on pdi.cod_producao = pd.cod_' +
          'producao and pdi.cod_empresa = pd.cod_empresa'
        
          '      where pd.data = (select current_d from sp_current_ts(:pcod' +
          '_empresa))'
        '      and pd.cod_empresa = :pcod_empresa'
        '      and pd.geracao_aut = '#39'S'#39
        '      and pdi.nped = :pnped'
        '      and pdi.tipo = :ptipo into :vproducao_gerada_hoje;'
        ''
        '      -- Producao para venda gerada hoje'
        '      if (coalesce(vproducao_gerada_hoje, 0) <= 0) then'
        '      begin'
        '        result = '#39'PRODUCAO NAO FOI GERADA HOJE'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '      -- Deletando itens acabados'
        
          '      for select cod_producao, nitem, grupo_prod, cod_prod, cod_' +
          'grade, quantidade from producao_item'
        '          where nped = :pnped'
        '          and tipo = :ptipo'
        '          and cod_empresa = :pcod_empresa'
        
          '      into :vcod_producao, :vnitem_a, :vgrupo_prod_a, :vcod_prod' +
          '_a, :vcod_grade_a, :vquant_ped_item_a do'
        '      begin'
        '        delete from producao_item'
        '        where cod_producao = :vcod_producao'
        '        and cod_empresa = :pcod_empresa'
        '        and nitem = :vnitem_a;'
        ''
        '        execute procedure movimenta_estoque('
        '          :vgrupo_prod_a,'
        '          :vcod_prod_a,'
        '          :pcod_empresa,'
        '          coalesce(:vcod_grade_a, 0),'
        '          0,'
        '          coalesce(:vquant_ped_item_a, 0),'
        '          0);'
        ''
        
          '        select first 1 codigo, valor, prec_cus_med, pr_cusc_prod' +
          ', data, num_nota_nfe, cod_producao from custos'
        '        where grupo_prod = :vgrupo_prod_a'
        '        and cod_prod = :vcod_prod_a'
        '        and cod_empresa = :pcod_empresa'
        '        order by data desc'
        
          '        into :vcodigo_temp, :vpreccusprod_temp, :vpreccusmprod_t' +
          'emp, :vpreccusmnf_temp,'
        
          '             :vdataultcompra_temp, :vnumnfrec_temp, :vcodprodu_t' +
          'emp;'
        ''
        '        if (coalesce(vcodigo_temp, 0) > 0) then'
        '        begin'
        '          if (coalesce(vcodprodu_temp, 0) > 0) then'
        
          '            update produtos set prec_cus_prod = coalesce(:vprecc' +
          'usprod_temp, 0),'
        '              prec_cusm_prod = coalesce(:vpreccusmprod_temp, 0),'
        '              dt_ult_e_producao = :vdataultcompra_temp,'
        '              cod_producao = coalesce(:vcodprodu_temp, 0)'
        '            where grupo_prod = :vgrupo_prod_a'
        '            and cod_prod = :vcod_prod_a'
        '            and cod_empresa = :pcod_empresa;'
        '          else'
        
          '            update produtos set prec_cus_prod = coalesce(:vprecc' +
          'usprod_temp, 0),'
        '              prec_cusm_prod = coalesce(:vpreccusmprod_temp, 0),'
        '              prec_cus_mnf = coalesce(:vpreccusmnf_temp, 0),'
        '              data_ult_compra = :vdataultcompra_temp,'
        '              num_nf_rec = coalesce(:vnumnfrec_temp, 0)'
        '            where grupo_prod = :vcod_prod_a'
        '            and cod_prod = :vcod_prod_a'
        '            and cod_empresa = :pcod_empresa;'
        '        end'
        '      end'
        ''
        '      -- Deletando materias primas'
        
          '      for select cod_producao, nitem, nitem_ind, grupo_prod, cod' +
          '_prod, cod_grade, quantidade_utilizada from producao_item_indice'
        '          where nped = :pnped'
        '          and tipo = :ptipo'
        '          and cod_empresa = :pcod_empresa'
        
          '      into :vcod_producao, :vnitem_a, :vnitem_p, :vgrupo_prod_p,' +
          ' :vcod_prod_p, :vcod_grade_p, :vqtde_materia_prima do'
        '      begin'
        '        delete from producao_item_indice'
        '        where cod_producao = :vcod_producao'
        '        and cod_empresa = :pcod_empresa'
        '        and nitem = :vnitem_a'
        '        and nitem_ind = :vnitem_p;'
        ''
        '        execute procedure movimenta_estoque('
        '          :vgrupo_prod_p,'
        '          :vcod_prod_p,'
        '          :pcod_empresa,'
        '          coalesce(:vcod_grade_p, 0),'
        '          coalesce(:vqtde_materia_prima, 0),'
        '          0,'
        '          0);'
        '      end'
        ''
        '      -- Atualizar quantidade produzida da producao'
        
          '      update producao set quantidadeproduzida = coalesce((select' +
          ' sum(coalesce(pdi.quantidade, 0)) from producao_item pdi'
        
          '                                                          where ' +
          'pdi.cod_producao = :vproducao_gerada_hoje'
        
          '                                                          and pd' +
          'i.cod_empresa = :pcod_empresa), 0)'
        '      where cod_producao = :vproducao_gerada_hoje'
        '      and cod_empresa = :pcod_empresa;'
        ''
        '      result = '#39'OK'#39';'
        '      suspend;'
        '    end'
        '    else if (coalesce(vstatus_ped, '#39#39') = '#39'FECHADA'#39') then'
        '    begin'
        '      select count(*) from pedvenda pd'
        '      inner join pedvenda_prod pp on'
        '        pp.nped = pd.nped'
        '        and pp.tipo = pd.tipo'
        '        and pp.cod_empresa = pd.cod_empresa'
        '      inner join produtos pr on'
        '        pr.grupo_prod = pp.grupo_prod'
        '        and pr.cod_prod = pp.cod_prod'
        '        and pr.cod_empresa = pp.cod_empresa'
        '      inner join indice_tecnico ind on'
        '        ind.grupo_prod_acabado = pp.grupo_prod'
        '        and ind.cod_prod_acabado = pp.cod_prod'
        '        and ind.cod_empresa = pp.cod_empresa'
        '      where pp.nped = :pnped'
        '      and pp.tipo = :ptipo'
        '      and pp.cod_empresa = :pcod_empresa'
        '      and coalesce(pp.status, '#39#39') <> '#39'CANCELADO'#39
        '      and pp.ativo = 1'
        
          '      and not(coalesce(pp.quant_ped_item, 0) = coalesce(pp.quant' +
          '_item_dev, 0) and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39')'
        '      and coalesce(pr.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '      into :vexiste_mat_prima;'
        '    '
        '      -- Venda possuiu produtos com insumos'
        '      if (coalesce(vexiste_mat_prima, 0) <= 0) then'
        '      begin'
        
          '        result = '#39'NAO EXISTEM PRODUTOS ACABADOS CONFIG PARA GERA' +
          'R PRODUCAO'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '      select first 1 nped from pedvenda'
        '      where nped = :pnped'
        '      and tipo = :ptipo'
        '      and cod_empresa = :pcod_empresa'
        
          '      and data_fech = (select current_d from sp_current_ts(:pcod' +
          '_empresa)) into :vvenda_fechada_hoje;'
        ''
        '      -- venda fechada hoje'
        '      if (coalesce(vvenda_fechada_hoje, 0) <= 0) then'
        '      begin'
        '        suspend;'
        '        exit;'
        '      end'
        '    '
        '      select first 1 cod_producao from producao'
        
          '      where data = (select current_d from sp_current_ts(:pcod_em' +
          'presa))'
        '      and cod_empresa = :pcod_empresa'
        '      and geracao_aut = '#39'S'#39' into :vproducao_gerada_hoje;'
        '    '
        '      -- Nao existe nenhuma producao automatica gerada hoje'
        '      if (coalesce(vproducao_gerada_hoje, 0) <= 0) then'
        '      begin'
        '        select count(*) from producao_item'
        '        where nped = :pnped'
        '        and tipo = :ptipo'
        '        and cod_empresa = :pcod_empresa into :vproducao_gerada;'
        '    '
        '        -- Ja existe producao gerada para esta venda'
        '        if (coalesce(vproducao_gerada, 0) > 0) then'
        '        begin'
        '          result = '#39'JA EXISTE PRODUCAO GERADA PARA ESTA VENDA'#39';'
        '          suspend;'
        '          exit;'
        '        end'
        '      end'
        '    '
        '      verro = '#39'N'#39';'
        
          '      for select result from getcriarproducao_temp(:pnped, :ptip' +
          'o, :pcod_empresa)'
        '       into :vcriar_prod_temp do'
        '      begin'
        '        --  Producao temporaria criada para esta venda'
        '        if (coalesce(vcriar_prod_temp, '#39#39') <> '#39'OK'#39') then'
        '        begin'
        '          verro = '#39'S'#39';  '
        '          result = vcriar_prod_temp;'
        '          suspend;'
        '        end'
        '      end'
        ''
        '      -- Erro ao gerar producao temporaria'
        '      if (coalesce(verro, '#39'N'#39') = '#39'S'#39') then'
        '        exit;'
        ''
        '      select count(*) from temp_producao_aut'
        
          '      where nped = :pnped and tipo = :ptipo and cod_empresa = :p' +
          'cod_empresa into :vcriar_prod;'
        '    '
        '      -- Producao temporaria foi criada para esta venda'
        '      if (coalesce(vcriar_prod, 0) <= 0) then'
        '      begin'
        '        result = '#39'PRODUCAO TEMPORARIA NAO FOI GERADA'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        '    '
        
          '      -- Producao automatica gerada hoje, se nao gerar nova prod' +
          'ucao'
        '      if (coalesce(vproducao_gerada_hoje, 0) > 0) then'
        '        vcod_producao = coalesce(vproducao_gerada_hoje, 0);'
        '      else'
        
          '        vcod_producao = (select cod from incrementa_codigo(:pcod' +
          '_empresa, '#39'PRODUCAO'#39'));'
        '    '
        '      -- Inserir nova producao, se nao existir uma gerada'
        '      if (coalesce(vproducao_gerada_hoje, 0) <= 0) then'
        '      begin'
        
          '        insert into producao (cod_producao, cod_empresa, cod_cli' +
          'ente,'
        
          '          data, data_fechamento, data_inicio, status, descricao,' +
          ' nlote,'
        '          quantidadeprevista, quantidadeproducao,'
        
          '          unidade, cod_formula, cod_emp_form, hora_inicio, hora_' +
          'fechamento,'
        '          data_estoque, tipo_k, tipo_conversao, geracao_aut)'
        '        values ('
        '          :vcod_producao,'
        '          :pcod_empresa,'
        '          null,'
        '          (select current_d from sp_current_ts(:pcod_empresa)),'
        '          (select current_d from sp_current_ts(:pcod_empresa)),'
        '          (select current_d from sp_current_ts(:pcod_empresa)),'
        '          '#39'FECHADO'#39','
        '          '#39'PRODUCAO '#39' ||'
        '          (cast((select result from strzero('
        
          '              extract(day from (select current_d from sp_current' +
          '_ts(:pcod_empresa))), 2)) as varchar(2)) ||'#39'/'#39'||'
        '           cast((select result from strzero('
        
          '              extract(month from (select current_d from sp_curre' +
          'nt_ts(:pcod_empresa))), 2))  as varchar(2)) ||'#39'/'#39'||'
        
          '           case extract(weekday from (select current_d from sp_c' +
          'urrent_ts(:pcod_empresa)))'
        '              when 0 then '#39'domingo'#39
        '              when 1 then '#39'segunda-feira'#39
        '              when 2 then '#39'terca-feira'#39
        '              when 3 then '#39'quarta-feira'#39
        '              when 4 then '#39'quinta-feira'#39
        '              when 5 then '#39'sexta-feira'#39
        '              when 6 then '#39'sabado'#39
        '          end),'
        '          (select result from strzero('
        
          '            (select cod from incrementa_codigo(:pcod_empresa, '#39'P' +
          'RODUCAO'#39' ||'
        
          '              cast(extract(year from (select current_d from sp_c' +
          'urrent_ts(:pcod_empresa))) as varchar(4)))), 4)) || '#39'/'#39' ||'
        
          '                        substring(cast(extract(year from (select' +
          ' current_d from sp_current_ts(:pcod_empresa))) as varchar(4))  f' +
          'rom 3 for 2),'
        '          0,'
        '          0,'
        '          '#39'KG'#39','
        '          null,'
        '          null,'
        '          (select current_ts from sp_current_ts(:pcod_empresa)),'
        '          (select current_ts from sp_current_ts(:pcod_empresa)),'
        '          (select current_d from sp_current_ts(:pcod_empresa)),'
        '          null,'
        '          null,'
        '          '#39'S'#39');'
        '      end'
        '    '
        '      -- Retorna nitem total dos itens acabados'
        '      select max(coalesce(nitem, 0)) from producao_item'
        
          '      where cod_producao = :vcod_producao and cod_empresa = :pco' +
          'd_empresa into :vnitem_acab;'
        '    '
        '      -- Retorna nitem total dos itens de insumos'
        '      select max(coalesce(nitem, 0)) from producao_item_indice'
        
          '      where cod_producao = :vcod_producao and cod_empresa = :pco' +
          'd_empresa into :vnitem_prima;'
        ''
        '      -- Retorna nitem_ind total dos itens de insumos'
        
          '      select max(coalesce(nitem_ind, 0)) from producao_item_indi' +
          'ce'
        
          '      where cod_producao = :vcod_producao and cod_empresa = :pco' +
          'd_empresa into :vnitemid_prima;'
        '    '
        '      -- Inserir itens acabados'
        
          '      for select distinct tmp.grupo_prod_acabado, tmp.cod_prod_a' +
          'cabado, tmp.cod_grade_acabado,'
        
          '         pr.codigo_nop, pr.num_fab_prod, pr.descr_prod, pr.unida' +
          'de,'
        
          '         coalesce(tmp.quant_ped_item_acabado, 0) quant_ped_item_' +
          'acabado,'
        '         coalesce(tmp.est_f_acabado, 0) est_f_acabado,'
        
          '         coalesce(tmp.estoque_disp_acabado, 0) estoque_disp_acab' +
          'ado,'
        
          '         coalesce(tmp.prec_cus_prod_acabado, 0) prec_cus_prod_ac' +
          'abado,'
        
          '         coalesce(tmp.prec_cusm_prod_acabado, 0) prec_cusm_prod_' +
          'acabado,'
        '         coalesce(tmp.peso_un_acabado, 0) peso_un_acabado,'
        '         coalesce(tmp.peso_util_acabado, 0) peso_util_acabado,'
        
          '         coalesce(tmp.custo_indice_acabado, 0) custo_indice_acab' +
          'ado,'
        
          '         coalesce(tmp.custo_rateio_acabado, 0) custo_rateio_acab' +
          'ado,'
        
          '         coalesce(pr.peso_brut_prod, 0) peso_brut_prod from temp' +
          '_producao_aut tmp'
        '         inner join produtos pr on'
        '            pr.grupo_prod = tmp.grupo_prod_acabado'
        '            and pr.cod_prod = tmp.cod_prod_acabado'
        '            and pr.cod_empresa = tmp.cod_empresa'
        '         left join cod_grade_prod gr on'
        '            gr.grupo_prod = tmp.grupo_prod_acabado'
        '            and gr.cod_prod = tmp.cod_prod_acabado'
        '            and gr.cod_grade = tmp.cod_grade_acabado'
        '            and gr.cod_empresa = tmp.cod_empresa'
        '         where tmp.nped = :pnped'
        '         and tmp.tipo = :ptipo'
        '         and tmp.cod_empresa = :pcod_empresa'
        
          '         into :vgrupo_prod_a, :vcod_prod_a, :vcod_grade_a, :vcod' +
          'igo_nop_a,'
        
          '              :vnum_fab_prod_a, :vdescr_prod_a, :vunidade_a, :vq' +
          'uant_ped_item_a,'
        
          '              :vest_f_a, :vestoque_disp_a, :vprec_cus_prod_a, :v' +
          'prec_cusm_prod_a,'
        
          '              :vpeso_un_a, :vpeso_util_a, :vcusto_indice_a, :vcu' +
          'sto_rateio_a, :vpeso_brut_prod_a do'
        '      begin'
        '        vnitem_acab = coalesce(vnitem_acab, 0) + 1;'
        
          '        insert into producao_item (cod_producao, cod_empresa, ni' +
          'tem, grupo_prod, cod_prod, num_fab_prod,'
        
          '          descr_prod, unidade, quantidade, prec_cusm_prod, prec_' +
          'cus_prod,'
        
          '          peso_un, peso_util, custo_indice, custo_rateio, seq, c' +
          'od_grade, nped, tipo)'
        '        values ('
        '          :vcod_producao,'
        '          :pcod_empresa,'
        '          :vnitem_acab,'
        '          :vgrupo_prod_a,'
        '          :vcod_prod_a,'
        '          :vnum_fab_prod_a,'
        '          :vdescr_prod_a,'
        '          :vunidade_a,'
        '          coalesce(:vquant_ped_item_a, 0),'
        '          coalesce(:vprec_cusm_prod_a, 0),'
        '          coalesce(:vprec_cus_prod_a, 0),'
        '          coalesce(:vpeso_un_a, 0),'
        '          coalesce(:vpeso_util_a, 0),'
        '          coalesce(:vcusto_indice_a, 0),'
        '          coalesce(:vcusto_rateio_a, 0),'
        '          :vnitem_acab,'
        '          coalesce(:vcod_grade_a, 0),'
        '          :pnped,'
        '          :ptipo);'
        ''
        '        -- Inserir materias primas'
        
          '        for select tmp.grupo_prod_mprima, tmp.cod_prod_mprima, t' +
          'mp.cod_grade_mprima,'
        
          '          pr.codigo_nop, pr.num_fab_prod, pr.descr_prod, pr.unid' +
          'ade, pr.tipo_item,'
        
          '          coalesce(tmp.quant_ped_item_acabado, 0) quant_ped_item' +
          '_acabado,'
        '          coalesce(tmp.quant_mprima, 0) quant_mprima,'
        '          coalesce(tmp.est_f_mprima, 0) est_f_mprima,'
        
          '          coalesce(tmp.prec_cusm_prod_mprima, 0) prec_cusm_prod_' +
          'mprima,'
        '          coalesce(tmp.peso_un_mprima, 0) peso_un_mprima,'
        
          '          coalesce(tmp.peso_util_mprima, 0) peso_util_mprima fro' +
          'm temp_producao_aut tmp'
        
          '          inner join produtos pr on pr.grupo_prod = tmp.grupo_pr' +
          'od_mprima and pr.cod_prod = tmp.cod_prod_mprima and pr.cod_empre' +
          'sa = tmp.cod_empresa'
        '          where tmp.nped = :pnped'
        '          and tmp.tipo = :ptipo'
        '          and tmp.cod_empresa = :pcod_empresa'
        '          and tmp.grupo_prod_acabado = :vgrupo_prod_a'
        '          and tmp.cod_prod_acabado = :vcod_prod_a'
        '          and tmp.cod_grade_acabado = coalesce(:vcod_grade_a, 0)'
        
          '        into :vgrupo_prod_p, :vcod_prod_p, :vcod_grade_p, :vcodi' +
          'go_nop_p,'
        
          '             :vnum_fab_prod_p, :vdescr_prod_p, :vunidade_p, :vti' +
          'po_item_p,'
        
          '             :vquant_ped_item_p, :vquant_mprima_p, :vest_f_mprim' +
          'a,'
        '             :vprec_cusm_prod_p, :vpeso_un_p, :vpeso_util_p do'
        '        begin'
        
          '          vqtde_materia_prima = coalesce(:vquant_ped_item_a, 0) ' +
          '* coalesce(vquant_mprima_p, 0);'
        '          vnitem_prima        = coalesce(vnitem_prima, 0) + 1;'
        '          vnitemid_prima      = coalesce(vnitemid_prima, 0) + 1;'
        ''
        
          '          insert into producao_item_indice (cod_producao, cod_em' +
          'presa, nitem, nitem_ind,'
        
          '            grupo_prod, cod_prod, num_fab_prod, descr_prod, unid' +
          'ade, tipo_item,'
        
          '            quantidade_receita, quantidade_utilizada, quantidade' +
          '_perda, quantidade_teorica,'
        
          '            prec_cusm_prod, cod_formula, peso_un, peso_util, sol' +
          'vente, seq, seqn, cod_grade, nped, tipo)'
        '          values ('
        '            :vcod_producao,'
        '            :pcod_empresa,'
        '            :vnitem_acab,'
        '            :vnitemid_prima,'
        '            :vgrupo_prod_p,'
        '            :vcod_prod_p,'
        '            :vnum_fab_prod_p,'
        '            :vdescr_prod_p,'
        '            :vunidade_p,'
        '            :vtipo_item_p,'
        '            coalesce(:vquant_mprima_p, 0),'
        '            coalesce(:vqtde_materia_prima, 0),'
        '            0,'
        '            coalesce(:vqtde_materia_prima, 0),'
        '            coalesce(:vprec_cusm_prod_p, 0),'
        '            null,'
        '            coalesce(:vpeso_un_p, 0),'
        '            coalesce(:vpeso_util_p, 0),'
        '            null,'
        '            :vnitem_acab,'
        '            :vnitemid_prima,'
        '            coalesce(:vcod_grade_p, 0),'
        '            :pnped,'
        '            :ptipo);'
        ''
        '          -- Movimentar estoque dos insumos'
        '          execute procedure movimenta_estoque('
        '            :vgrupo_prod_p,'
        '            :vcod_prod_p,'
        '            :pcod_empresa,'
        '            :vcod_grade_p,'
        '            0,'
        '            coalesce(:vqtde_materia_prima, 0),'
        '            0);'
        ''
        
          '          update produtos set dt_ult_s_producao = (select curren' +
          't_d from sp_current_ts(:pcod_empresa))'
        
          '          where grupo_prod = :vgrupo_prod_p and cod_prod = :vcod' +
          '_prod_p and cod_empresa = :pcod_empresa;'
        '        end'
        ''
        '        -- Movimentar estoque dos produtos acabados'
        '        execute procedure movimenta_estoque('
        '          :vgrupo_prod_a,'
        '          :vcod_prod_a,'
        '          :pcod_empresa,'
        '          :vcod_grade_a,'
        '          coalesce(:vquant_ped_item_a, 0),'
        '          0,'
        '          0);'
        ''
        '        vcustomedio_a = coalesce(vprec_cusm_prod_a, 0);'
        ''
        '        /*'
        '        update produtos set'
        '          prec_cus_prod = coalesce(:vprec_cus_prod_a, 0),'
        '          prec_cusm_prod = coalesce(:vcustomedio_a, 0),'
        '          cod_producao = :vcod_producao,'
        
          '          dt_ult_e_producao = (select current_d from sp_current_' +
          'ts(:pcod_empresa))'
        '        where grupo_prod = :vgrupo_prod_a'
        '        and cod_prod = :vcod_prod_a'
        '        and cod_empresa = :pcod_empresa;'
        '        */'
        ''
        '        update pedvenda_prod set'
        '          pcust_c = coalesce(:vprec_cus_prod_a, 0),'
        '          pcust_mc = coalesce(:vcustomedio_a, 0)'
        '        where nped = :pnped'
        '        and tipo = :ptipo'
        '        and grupo_prod = :vgrupo_prod_a'
        '        and cod_prod = :vcod_prod_a'
        '        and cod_grade = :vcod_grade_a'
        '        and cod_empresa = :pcod_empresa;'
        ''
        '        insert into custos (codigo, cod_empresa, valor,'
        
          '          grupo_prod, cod_prod, data, prec_cus_med, pr_cusc_prod' +
          ', cod_producao)'
        '        values ('
        
          '          (select cod from incrementa_codigo(:pcod_empresa, '#39'CUS' +
          'TOS'#39')),'
        '          :pcod_empresa,'
        '          coalesce(:vprec_cus_prod_a, 0),'
        '          :vgrupo_prod_a,'
        '          :vcod_prod_a,'
        '          (select current_d from sp_current_ts(:pcod_empresa)),'
        '          coalesce(:vcustomedio_a, 0),'
        '          coalesce(:vprec_cus_prod_a, 0),'
        '          :vcod_producao);'
        ''
        
          '        update producao_item set prec_cusm_prod = coalesce(:vcus' +
          'tomedio_a, 0)'
        '        where cod_producao = :vcod_producao'
        '        and cod_empresa = :pcod_empresa'
        '        and nped = :pnped'
        '        and tipo = :ptipo;'
        '      end'
        '    '
        '      -- Atualizar quantidade produzida da producao'
        '      if (coalesce(vcod_producao, 0) > 0) then'
        '      begin'
        '        update producao set quantidadeproduzida ='
        
          '            coalesce((select sum(coalesce(pdi.quantidade, 0)) fr' +
          'om producao_item pdi'
        '                      where pdi.cod_producao = :vcod_producao'
        '                      and pdi.cod_empresa = :pcod_empresa), 0)'
        '        where cod_producao = :vcod_producao'
        '        and cod_empresa = :pcod_empresa;'
        '      end'
        ''
        '      delete from temp_producao_aut'
        '      where nped = :pnped'
        '      and tipo = :ptipo'
        '      and cod_empresa = :pcod_empresa;'
        ''
        '      result = '#39'OK'#39';'
        '      suspend;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER TRIGGER TR_PEDVENDA_PRODUCAO_AUT FOR PEDVENDA'
        'ACTIVE AFTER INSERT OR UPDATE POSITION 0'
        'as'
        '  declare variable status_ped varchar(100);'
        'begin'
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.status_ped, '#39#39') = '#39'FECHADA'#39') then'
        
          '      select first 1 result from sp_producao_aut (new.nped, new.' +
          'tipo, new.cod_empresa) into :status_ped;'
        '  end'
        '  else if (updating) then'
        '  begin'
        
          '    if ((coalesce(old.status_ped, '#39#39') <> coalesce(new.status_ped' +
          ', '#39#39'))'
        '        and (trim(coalesce(new.status_ped, '#39#39')) = '#39#39')) then'
        
          '            select first 1 result from sp_producao_aut (new.nped' +
          ', new.tipo, new.cod_empresa) into :status_ped;'
        
          '    else if ((coalesce(old.status_ped, '#39#39') <> coalesce(new.statu' +
          's_ped, '#39#39'))'
        
          '        and (trim(coalesce(new.status_ped, '#39#39')) = '#39'FECHADA'#39')) th' +
          'en'
        
          '            select first 1 result from sp_producao_aut (new.nped' +
          ', new.tipo, new.cod_empresa) into :status_ped;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_INDICE_TECNICO_PROD_VAR FOR INDICE_TE' +
          'CNICO'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */ '
        '  delete from produtos_pdc_var_it pit'
        '  where pit.grupo_prod = old.grupo_prod_mprima'
        '  and pit.cod_prod = old.cod_prod_mprima'
        '  and pit.cod_empresa = old.cod_empresa;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_COD_GRADE_PROD_PROD_VAR FOR COD_GRADE' +
          '_PROD'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  delete from produtos_pdc_var pvar'
        '  where pvar.grupo_prod = old.grupo_prod'
        '  and pvar.cod_prod = old.cod_prod'
        '  and pvar.cod_grade = old.cod_grade'
        '  and pvar.cod_empresa = old.cod_empresa;'
        ''
        '  '
        '  delete from produtos_pdc_var_it pit'
        '  where pit.grupo_prod = old.grupo_prod'
        '  and pit.cod_prod = old.cod_prod'
        '  and pit.cod_grade = old.cod_grade'
        '  and pit.cod_empresa = old.cod_empresa;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
