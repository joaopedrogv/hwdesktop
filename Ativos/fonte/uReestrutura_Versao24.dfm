        'ALTER TABLE CONTROLES ADD CARTAO_SPED_PART_IT INTEGER;'
        ''
        '|BLOCO|'
        'create or alter procedure SPED_1601 ('
        '    EMPRESA integer,'
        '    DATAINI timestamp,'
        '    DATAFIM timestamp)'
        'returns ('
        '    COD_PART_IP integer,'
        '    COD_PART_IT integer,'
        '    TOT_VS double precision,'
        '    TOT_ISS double precision,'
        '    TOT_OUTROS double precision)'
        'as'
        '  declare variable LAST_COD_PART_IP integer;'
        '  declare variable LAST_COD_PART_IT integer;'
        '  declare variable ndoc integer;'
        '  declare variable tipodoc varchar(6);'
        '  declare variable valordoc double precision;'
        '  declare variable VALOROPERACAO double precision;'
        '  declare variable valorservico double precision;'
        'begin'
        ''
        '  LAST_COD_PART_IP = null;'
        '  LAST_COD_PART_IT = null;'
        '  COD_PART_IP = 0;'
        '  COD_PART_IT = 0;'
        '  TOT_VS = 0;'
        '  TOT_ISS = 0;'
        '  TOT_OUTROS = 0;'
        '  VALOROPERACAO = 0;'
        
          '  for select coalesce(cl.cartao_sped_part, 0), coalesce(cl.carta' +
          'o_sped_part_it, 0),'
        
          '             coalesce(fp.nrequisicao, 0), trim(fp.tpdocs), sum(f' +
          'p.valordoc) valoroperacao'
        '      from formpagamento fp'
        
          '        inner join controles cl on cl.codigo_ctrl = fp.cod_contr' +
          'ole and cl.codigo_emp = fp.cod_empresa'
        
          '      where ((cl.cartao_sped = 1) or (cl.cartao_sped = 2)) and f' +
          'p.cod_empresa = :empresa and'
        '        fp.data_mov >= :dataIni and fp.data_mov <= :dataFim'
        '      group by 1, 2, 3, 4'
        
          '      into :COD_PART_IP, :COD_PART_IT, :NDOC, :TIPODOC, :VALOROP' +
          'ERACAO'
        '  do'
        '  begin'
        ''
        '    if ((LAST_COD_PART_IP <> COD_PART_IP) or'
        '         (LAST_COD_PART_IT <> COD_PART_IT)) then'
        '    begin'
        '      suspend;  '
        '      LAST_COD_PART_IP = COD_PART_IP;'
        '      LAST_COD_PART_IT = COD_PART_IT;'
        '      COD_PART_IP = 0;'
        '      COD_PART_IT = 0;'
        '      TOT_VS = 0;'
        '      TOT_ISS = 0;'
        '      TOT_OUTROS = 0;'
        '    end'
        ''
        '    if (tipodoc = '#39'OS'#39') then'
        '    begin'
        '      select (coalesce(pv.tot_prod, 0) +'
        '              coalesce(pv.tot_serv, 0) +'
        '              coalesce(pv.tot_prod_terc, 0) +'
        '              coalesce(pv.tot_serv_terc, 0)) total,'
        
          '             (coalesce(pv.tot_serv, 0) + coalesce(pv.tot_serv_te' +
          'rc, 0)) totalservico'
        
          '      from pedvenda pv where pv.nped = :ndoc and pv.tipo = :tipo' +
          'doc and pv.cod_empresa = :empresa'
        '      into :VALORDOC, :VALORSERVICO;'
        ''
        '      if (coalesce(VALORSERVICO, 0) > 0) then'
        '      begin'
        
          '        VALORSERVICO = VALORSERVICO / VALORDOC; -- calculou o pe' +
          'rcentual'
        
          '        VALORSERVICO = round( VALOROPERACAO * VALORSERVICO, 2); ' +
          '-- calculou ou valor proporcional'
        ''
        '        TOT_ISS = TOT_ISS + VALORSERVICO;'
        '        TOT_VS = TOT_VS + (VALOROPERACAO - VALORSERVICO);'
        '      end'
        '      else'
        '        TOT_VS = TOT_VS + VALOROPERACAO;'
        ''
        '    end'
        '    else'
        '    begin'
        '      TOT_VS = TOT_VS + VALOROPERACAO;'
        '    end'
        ''
        '  end'
        '  if (VALOROPERACAO > 0) then'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        
          'update RDB$RELATION_FIELDS set RDB$NULL_FLAG = NULL where (RDB$F' +
          'IELD_NAME = '#39'CARTAO_SPED_PART_IT'#39') and (RDB$RELATION_NAME = '#39'CON' +
          'TROLES'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV001'#39', :COD_EMPRESA, '#39'RENAVE CONFIGURAR'#39', 6, '#39'N'#39', '#39 +
          'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV002'#39', :COD_EMPRESA, '#39'RENAVE VISUALIZAR DADOS'#39', 6, ' +
          #39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV003'#39', :COD_EMPRESA, '#39'RENAVE ENTRADADA VEICULO ZERO' +
          #39', 6, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV004'#39', :COD_EMPRESA, '#39'RENAVE CANCELAR ENTRADADA VEI' +
          'CULO ZERO'#39', 6, '#39'S'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV005'#39', :COD_EMPRESA, '#39'RENAVE SAIDA VEICULO ZERO'#39', 6' +
          ', '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV006'#39', :COD_EMPRESA, '#39'RENAVE CANCELAR SAIDA VEICULO' +
          ' ZERO'#39', 6, '#39'S'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV007'#39', :COD_EMPRESA, '#39'RENAVE DEVOLUCAO VEICULO ZERO' +
          #39', 6, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV008'#39', :COD_EMPRESA, '#39'RENAVE VEICULOS ZERO PENDENTE' +
          'S'#39', 6, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV009'#39', :COD_EMPRESA, '#39'RENAVE REJEITAR VEICULO ZERO'#39 +
          ', 6, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV010'#39', :COD_EMPRESA, '#39'RENAVE CANCELAR REJEICAO VEIC' +
          'ULO ZERO'#39', 6, '#39'S'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'RNV011'#39', :COD_EMPRESA, '#39'RENAVE ALTERA HODOMETRO VEICU' +
          'LO'#39', 6, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0224'#39', :COD_EMPRESA, '#39'CONFERIR VALOR DIF PEDIDO NF ' +
          'QUANDO 1PED=1NF'#39', 11, '#39'S'#39', '#39'S'#39');'
        'ALTER TABLE PRODUTOS_EC ADD PRECO_A_COMBINAR_EC CHAR(1);'
        
          'CMD:INATIVO|CMD:REPL|UPDATE PRODUTOS_EC SET PRECO_A_COMBINAR_EC ' +
          '= '#39'N'#39' WHERE PRECO_A_COMBINAR_EC IS NULL;'
        
          'CMD:INATIVO|CMD:REPL|UPDATE PRODUTOS_EC SET PRECO_A_COMBINAR_CA ' +
          '= '#39'N'#39' WHERE PRECO_A_COMBINAR_CA IS NULL;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_PRODUTOS_EC('
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_EMPRESA,'
        '    ATIVO,'
        '    NUM_FAB_PROD,'
        '    DESCR_PROD_RES,'
        '    DESCR_PROD_COMPL,'
        '    SINC_ECOMMERCE,'
        '    ID_COMMERCE,'
        '    DISPONIVEL,'
        '    PROMOCIONAL,'
        '    FRETE_GRATIS,'
        '    LANCAMENTO,'
        '    DESTAQUE,'
        '    VARIACAO,'
        '    TERMOS_ACEITE,'
        '    COMPREJUNTO,'
        '    VIRTUAL,'
        '    ENV_COMERCIO_ABERTO,'
        '    ID_COMERCIO_ABERTO,'
        '    DESCRICAO_MARCA,'
        '    LISTA_IMAGENS,'
        '    URL_IMAGENS,'
        '    LISTA_IMAGENS_GRADE,'
        '    URL_IMAGENS_GRADE,'
        '    REFERENCE,'
        '    COM_GRADE,'
        '    COD_GRADE,'
        '    GRADE1,'
        '    GRADE2,'
        '    EST_DISP,'
        '    EST_DISP_GRADE,'
        '    EST_MINIMO,'
        '    MANUAL_EST_DISP,'
        '    MANUAL_EST_DISP_GRADE,'
        '    MANUAL_EST_MINIMO,'
        '    API,'
        '    API_PRECO_TABELA,'
        '    PRECO_TABELA,'
        '    DESCRICAOPROMOCAO,'
        '    VALORPROMOCAO,'
        '    DATAINICIOPROMOCAO,'
        '    DATAFIMPROMOCAO,'
        '    HORAINICIOPROMOCAO,'
        '    HORAFIMPROMOCAO,'
        '    PRECO_A_COMBINAR_EC,'
        '    PRECO_A_COMBINAR_CA,'
        '    SEQID_CA)'
        'AS'
        'select'
        '  0 TIPO,'
        '--DADOS DO PRODUTO'
        
          '  PEC.GRUPO_PROD, PEC.COD_PROD, PEC.COD_EMPRESA, PR.ATIVO, PR.NU' +
          'M_FAB_PROD,'
        
          '  coalesce(PEC.DESCR_PROD_RES, PR.DESCR_PROD) DESCR_PROD_RES, PE' +
          'C.DESCR_PROD_COMPL,'
        ''
        '  CASE WHEN (PECG.COD_GRADE > 0) THEN'
        
          '         CASE WHEN (PEC.SINC_ECOMMERCE = '#39'S'#39') AND (PECG.SINC_ECO' +
          'MMERCE = '#39'S'#39') THEN'
        '                '#39'S'#39
        '              ELSE'
        '                '#39'N'#39
        '         END'
        '       ELSE'
        '         COALESCE(PEC.SINC_ECOMMERCE, '#39'N'#39')'
        '  END SINC_ECOMMERCE,'
        '  PEC.ID_COMMERCE,'
        
          '  PEC.DISPONIVEL, PEC.PROMOCIONAL, PEC.FRETE_GRATIS, PEC.LANCAME' +
          'NTO, PEC.DESTAQUE, PEC.VARIACAO,'
        '  PEC.TERMOS_ACEITE, PEC.COMPREJUNTO, PEC.VIRTUAL,'
        
          '  PEC.ENV_COMERCIO_ABERTO, COALESCE(PECG.ID_COMERCIO_ABERTO, PEC' +
          '.ID_COMERCIO_ABERTO) ID_COMERCIO_ABERTO,'
        '  MARCA_PROD.DESCRICAO_MARCA,'
        
          '  PIP.LISTA_IMAGENS, PIP.URL_IMAGENS, PIG.LISTA_IMAGENS as LISTA' +
          '_IMAGENS_GRADE,'
        '  PIG.URL_IMAGENS as URL_IMAGENS_GRADE,'
        '  (select first 1 CB.COD_BARRA from COD_BARRA CB'
        '   where CB.GRUPO_PROD = PEC.GRUPO_PROD'
        '   and CB.COD_PROD = PEC.COD_PROD'
        '   and coalesce(CB.COD_GRADE, 0) = 0'
        '   and CB.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '   and CB.COD_BARRA <> (CB.GRUPO_PROD || CB.COD_PROD)) as REFERE' +
          'NCE,'
        '--DADOS GRADE'
        '  CASE WHEN ((SELECT COUNT(*) FROM COD_GRADE_PROD'
        '  WHERE COD_GRADE_PROD.GRUPO_PROD = PEC.GRUPO_PROD'
        '  AND COD_GRADE_PROD.COD_PROD = PEC.COD_PROD'
        '  AND COD_GRADE_PROD.COD_GRADE > 0'
        
          '  AND COD_GRADE_PROD.COD_EMPRESA = PEC.COD_EMPRESA) > 0) then '#39'1' +
          #39' else '#39'0'#39' end COM_GRADE,'
        '  coalesce(PECG.COD_GRADE, 0) COD_GRADE,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC, '#39#39') <> '#39#39', GRADE.DESCRICAO_EC' +
          ', GRADE.DESCRICAO) GRADE1,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC1, '#39#39') <> '#39#39', GRADE.DESCRICAO_E' +
          'C1, GRADE.DESCRICAO_EC1) GRADE2,'
        '--ESTOQUE FISICO'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PEC.GRUPO_PROD, PEC.COD_PROD, 0, PEC.COD_EMPRESA, 0, '#39#39', 0,' +
          ' 0)), 0) EST_DISP,'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PECG.GRUPO_PROD, PECG.COD_PROD, PECG.COD_GRADE, PECG.COD_EM' +
          'PRESA, 0, '#39#39', 0, 0)), 0) EST_DISP_GRADE,'
        '  coalesce(PR.N_MIN_PROD, 0) EST_MINIMO,'
        '--ESTOQUE MANUAL'
        '  coalesce(PEC.ESTOQUE_EC, 0) MANUAL_EST_DISP,'
        '  coalesce(PECG.ESTOQUE_EC, 0) MANUAL_EST_DISP_GRADE,'
        '  coalesce(PEC.ESTOQUE_MIN_EC, 0) MANUAL_EST_MINIMO,'
        '-- PRECO CONFIG_API'
        '  CONFIG_API.API,'
        '  (select first 1 PMP.VALOR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        
          '        PMP.COD_PROMOCAO = CONFIG_API.COD_TAB_PRECO) API_PRECO_T' +
          'ABELA,'
        '--PRECO PADRAO PRODUTO'
        '  PR.PREC_TAB_PROD as PRECO_TABELA,'
        '--DESCRICAO PROMOCAO COMERCIO ABERTO'
        '  (select first 1 PM.DESCR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D  >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DESCRICAOPROMOCAO,'
        '-- VALOR PROMOCAO COMERCIO ABERTO'
        '  (select first 1 iif((PMP.PORCENTAGEM > 0),'
        
          '                      (PR.PREC_TAB_PROD - (round(PR.PREC_TAB_PRO' +
          'D * PMP.PORCENTAGEM) / 100)),'
        '                       PMP.VALOR_PROMOCAO)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) VALORPROMOCAO,'
        '--DATA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_INI, PM.DATA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAINICIOPROMOCAO,'
        '--DATA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAFIMPROMOCAO,'
        '--HORA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_INI, PM.HORA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAINICIOPROMOCAO,'
        '--HORA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_FIM, PM.HORA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAFIMPROMOCAO,'
        '-- PRECO_A_COMBINAR_CA'
        '  PEC.PRECO_A_COMBINAR_EC,'
        '  PEC.PRECO_A_COMBINAR_CA,'
        '--SEQIDS'
        '  coalesce(PECG.SEQID_CA, PEC.SEQID_CA)  SEQID_CA'
        'from PRODUTOS_EC PEC'
        '  inner join PRODUTOS PR on PEC.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PEC.COD_PROD = PR.COD_PROD and'
        '        PEC.COD_EMPRESA = PR.COD_EMPRESA'
        
          '  left join PRODUTOS_EC_GRADE PECG on PECG.GRUPO_PROD = PEC.GRUP' +
          'O_PROD and'
        '        PECG.COD_PROD = PEC.COD_PROD and'
        '        PECG.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIP on PIP.GRUPO_PROD = PEC.GRUPO_P' +
          'ROD and'
        '        PIP.COD_PROD = PEC.COD_PROD and'
        '        PIP.COD_GRADE = 0 and'
        '        PIP.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIG on PIG.GRUPO_PROD = PECG.GRUPO_' +
          'PROD and'
        '        PIG.COD_PROD = PECG.COD_PROD and'
        '        PIG.COD_GRADE = PECG.COD_GRADE and'
        '        PIG.COD_EMPRESA = PECG.COD_EMPRESA'
        '  left join GRADE on GRADE.COD_GRADE = PECG.COD_GRADE and'
        '        GRADE.COD_EMPRESA = PECG.COD_EMPRESA and'
        '        GRADE.COD_GRADE > 0'
        
          '  left join CATEGORIA on CATEGORIA.COD_CATEGORIA = PEC.COD_CATEG' +
          'ORIA AND CATEGORIA.COD_EMPRESA = PEC.COD_EMPRESA'
        '  left join MARCA_PROD on MARCA_PROD.COD_MARCA = PR.COD_MARCA'
        
          '  left join CONFIG_API on CONFIG_API.COD_EMPRESA = PEC.COD_EMPRE' +
          'SA'
        'UNION'
        
          'select 1 TIPO, TS.COD_SERVICO GRUPO_PROD, '#39'SERV'#39' COD_PROD, coale' +
          'sce(TS.COD_EMPRESA, EMP.COD_EMPRESA) COD_EMPRESA,'
        
          '       TS.ATIVO, null NUM_FAB_PROD, TS.DESC_SERV_RES DESCR_PROD_' +
          'RES, TS.DESC_SERV_COMPL DESCR_PROD_COMPL,'
        '       null SINC_ECOMMERCE, null ID_COMMERCE,'
        
          '       null DISPONIVEL, null PROMOCIONAL, null FRETE_GRATIS, nul' +
          'l LANCAMENTO, null DESTAQUE, null VARIACAO,'
        '       null TERMOS_ACEITE, null COMPREJUNTO, null VIRTUAL,'
        
          '       TS.ENV_COMERCIO_ABERTO, TS.ID_COMERCIO_ABERTO, null DESCR' +
          'ICAO_MARCA, null LISTA_IMAGENS, null URL_IMAGENS,'
        
          '       null LISTA_IMAGENS_GRADE, null URL_IMAGENS_GRADE, cast(TS' +
          '.COD_SERVICO as varchar(20)) REFERENCE, 0 COM_GRADE,'
        
          '       0 COD_GRADE, null GRADE1, null GRADE2, 100 EST_DISP, 100 ' +
          'EST_DISP_GRADE, 100 EST_MINIMO, 100 MANUAL_EST_DISP,'
        
          '       100 MANUAL_EST_DISP_GRADE, 100 MANUAL_EST_MINIMO, '#39'COMERC' +
          'IOABERTO'#39' API, TS.VALOR_SERVICO API_PRECO_TABELA,'
        
          '       TS.VALOR_SERVICO PRECO_TABELA, null DESCRICAOPROMOCAO, nu' +
          'll VALORPROMOCAO, null DATAINICIOPROMOCAO,'
        
          '       null DATAFIMPROMOCAO, null HORAINICIOPROMOCAO, null HORAF' +
          'IMPROMOCAO,'
        
          '       null PRECO_A_COMBINAR_EC, TS.PRECO_A_COMBINAR_CA, TS.SEQI' +
          'D_CA'
        'from EMPRESA EMP'
        
          '  left join TIPO_SERVICO TS on coalesce(TS.COD_EMPRESA, EMP.COD_' +
          'EMPRESA) = EMP.COD_EMPRESA'
        'where TS.SEQID_CA > 0;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure MOVIMENTA_ESTOQUE ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PCOD_GRADE integer,'
        '    PQTDE_ENTRADA double precision,'
        '    PQTDE_SAIDA double precision,'
        '    PALTDTULTVND integer)'
        'as'
        '  declare variable PEXISTEGRADE smallint;'
        '  declare variable PEXISTEMOVD smallint;'
        '  declare variable VESTOQUE double precision;'
        '  declare variable VCUSTOMEDIO double precision;'
        '  declare variable CURRENT_TS timestamp;'
        '  declare variable VESTPROD double precision;'
        '  declare variable VCONTGRA integer;'
        'begin'
        '  select CURRENT_D'
        '  from SP_CURRENT_TS(:PCOD_EMPRESA)'
        '    into :CURRENT_TS;'
        ''
        '  if (:pqtde_entrada > 0) then'
        '  begin'
        '    if (:paltdtultvnd > 0) then'
        '    begin'
        
          '      update produtos set est_f = coalesce(est_f, 0) + :pqtde_en' +
          'trada, dt_ult_vnd = dt_ult_vnda'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa;'
        '    end'
        '    else'
        '    begin'
        
          '      update produtos set est_f = coalesce(est_f, 0) + :pqtde_en' +
          'trada'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa;'
        '    end'
        ''
        '    if (:pcod_grade > 0) then'
        '    begin'
        '      pexistegrade = 0;'
        '      select first 1 cod_grade from cod_grade_prod'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa'
        '        and cod_grade = :pcod_grade into :pexistegrade;'
        ''
        '      if (coalesce(:pexistegrade,0) > 0) then'
        '      begin'
        
          '        update cod_grade_prod set qtde = coalesce(qtde, 0) + :pq' +
          'tde_entrada'
        
          '          where grupo_prod = :pgrupo_prod and cod_prod = :pcod_p' +
          'rod and cod_empresa = :pcod_empresa'
        '          and cod_grade = :pcod_grade;'
        '      end'
        '      else'
        '      begin'
        
          '        insert into cod_grade_prod (grupo_prod, cod_prod, cod_gr' +
          'ade, cod_empresa, qtde, ativo)'
        
          '          values (:pgrupo_prod, :pcod_prod, :pcod_grade, :pcod_e' +
          'mpresa, :pqtde_entrada, 1);'
        '      end'
        '    end'
        '  end'
        '  else if (:pqtde_saida > 0) then'
        '  begin'
        '    if (:paltdtultvnd > 0) then'
        '    begin'
        
          '      update produtos set est_f = coalesce(est_f, 0) - :pqtde_sa' +
          'ida, dt_ult_vnda = dt_ult_vnd, dt_ult_vnd = :CURRENT_TS'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa;'
        '    end'
        '    else'
        '    begin'
        
          '      update produtos set est_f = coalesce(est_f, 0) - :pqtde_sa' +
          'ida'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa;'
        '    end'
        ''
        '    if (:pcod_grade > 0) then'
        '    begin'
        '      pexistegrade = 0;'
        '      select first 1 cod_grade from cod_grade_prod'
        
          '        where grupo_prod = :pgrupo_prod and cod_prod = :pcod_pro' +
          'd and cod_empresa = :pcod_empresa'
        '        and cod_grade = :pcod_grade into :pexistegrade;'
        ''
        '      if (coalesce(:pexistegrade,0) > 0) then'
        '      begin'
        
          '        update cod_grade_prod set qtde = coalesce(qtde, 0) - :pq' +
          'tde_saida'
        
          '          where grupo_prod = :pgrupo_prod and cod_prod = :pcod_p' +
          'rod and cod_empresa = :pcod_empresa'
        '          and cod_grade = :pcod_grade;'
        '      end'
        '      else'
        '      begin'
        
          '        insert into cod_grade_prod (grupo_prod, cod_prod, cod_gr' +
          'ade, cod_empresa, qtde, ativo)'
        
          '          values (:pgrupo_prod, :pcod_prod, :pcod_grade, :pcod_e' +
          'mpresa, ((-1) * :pqtde_saida), 1);'
        '      end'
        '    end'
        '  end'
        ''
        '  if (:pcod_grade > 0) then'
        '  begin'
        '    vestprod = 0;'
        '    select est_f from produtos'
        
          '    where grupo_prod = :pgrupo_prod and cod_prod = :pcod_prod an' +
          'd cod_empresa = :pcod_empresa'
        '      into :vestprod;'
        ''
        '    vestoque = 0;'
        '    vcontgra = 0;'
        '    select count(qtde), sum(qtde) from cod_grade_prod'
        
          '    where grupo_prod = :pgrupo_prod and cod_prod = :pcod_prod an' +
          'd cod_empresa = :pcod_empresa'
        '      into :vcontgra, :vestoque;'
        ''
        '    if ((coalesce(vcontgra, 0) > 0) and'
        
          '        (round(coalesce(vestprod, 0)) <> round(coalesce(vestoque' +
          ', 0)))) then'
        '      update produtos set est_f = :vestoque'
        
          '      where grupo_prod = :pgrupo_prod and cod_prod = :pcod_prod ' +
          'and cod_empresa = :pcod_empresa;'
        '  end'
        ''
        '  pexisteMovD = 0;'
        '  select first 1 cod_empresa from estoque_diario'
        
          '    where grupo_prod = :pgrupo_prod and cod_prod = :pcod_prod an' +
          'd cod_empresa = :pcod_empresa'
        
          '    and cod_grade = :pcod_grade and dia = :CURRENT_TS and tipo =' +
          ' '#39'P'#39' into :pexisteMovD;'
        '    '
        
          '  select case when coalesce(gp.cod_grade, 0) > 0 then gp.qtde el' +
          'se p.est_f end, p.prec_cusm_prod'
        '    from produtos p'
        
          '    left join cod_grade_prod gp on gp.grupo_prod = p.grupo_prod ' +
          'and gp.cod_prod = p.cod_prod'
        
          '      and gp.cod_empresa = p.cod_empresa and gp.cod_grade = :pco' +
          'd_grade'
        
          '    where p.grupo_prod = :pgrupo_prod and p.cod_prod = :pcod_pro' +
          'd and p.cod_empresa = :pcod_empresa'
        '    into :vEstoque, :vCustoMedio;'
        '    '
        '  if (coalesce(:pexisteMovD,0) > 0) then'
        '  begin'
        
          '    update estoque_diario set estoque = :vEstoque, custo_medio =' +
          ' :vCustoMedio'
        
          '      where grupo_prod = :pgrupo_prod and cod_prod = :pcod_prod ' +
          'and cod_empresa = :pcod_empresa'
        
          '      and cod_grade = :pcod_grade and dia = :CURRENT_TS and tipo' +
          ' = '#39'P'#39';'
        '  end'
        '  else'
        '  begin'
        
          '    insert into estoque_diario (grupo_prod, cod_prod, cod_empres' +
          'a, cod_grade, dia, estoque, custo_medio, tipo, seqid )'
        
          '      values (:pgrupo_prod, :pcod_prod, :pcod_empresa, :pcod_gra' +
          'de, :CURRENT_TS, :vEstoque, :vCustoMedio, '#39'P'#39', gen_id(INC_ESTOQU' +
          'E_DIARIO, 1));'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRODUTOS ADD FORA_LINHA CHAR(1);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_FORA_LINHA FOR PRODUTOS'
        'ACTIVE BEFORE UPDATE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        
          '  if ((coalesce(new.fora_linha, '#39'N'#39') = '#39'S'#39') and (new.ativo = 1))' +
          ' then'
        
          '      if ((coalesce(old.est_f, 0) <> coalesce(new.est_f, 0)) and' +
          ' (coalesce(new.est_f, 0) <= 0)) then'
        '        new.ativo = 0;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_DESCR_PROD FOR PRODUTOS'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        '  new.descr_prod = replace(new.descr_prod, ASCII_CHAR(13), '#39' '#39');'
        '  new.descr_prod = replace(new.descr_prod, ASCII_CHAR(10), '#39' '#39');'
        'end;'
        '|/BLOCO|'
        ''
        
