          'end cpfcgc,'
        '    '#39'CREDIARIO'#39' tp_rel, '#39'CREDIARIO'#39' tp_recebimento,'
        '    coalesce((case'
        
          '        when (((select count(*) from hist_rec hist where hist.lo' +
          'te_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_emp) > 0' +
