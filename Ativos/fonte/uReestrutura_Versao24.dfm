        'ALTER TABLE MARCA_PROD_EC ADD SEQID_EC BIGINT;'
        'CREATE SEQUENCE SEQ_EC_MARCA_PROD_EC;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_DTEC_MARCA_PROD_EC FOR MARCA_PROD_EC'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS '
        ' DECLARE VARIABLE VSEQID BIGINT;'
        ' DECLARE VARIABLE CAMPOS_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VALORES_CHAVE VARCHAR(255);'
        ' DECLARE VARIABLE VDELETE INTEGER;'
        'begin '
        '  /* Trigger text */ '
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit; '
        ''
        '  VDELETE = 0; '
        '  if (deleting) then '
        '    VDELETE = 1; '
        ''
        '  if (vdelete > 0) then '
        '  begin '
        '    if (COALESCE(OLD.ID_COMMERCE, 0) <= 0) then '
        '     exit; '
        ''
        
          '    SELECT GEN_ID(SEQ_DEL_EC, 1) FROM RDB$DATABASE INTO :VSEQID;' +
          ' '
        '    CAMPOS_CHAVE =  '#39'|COD_MARCA|COD_EMPRESA|'#39'; '
        
          '    VALORES_CHAVE = '#39'|'#39'||OLD.COD_MARCA||'#39'|'#39'||OLD.COD_EMPRESA||'#39'|' +
          #39'; '
        
          '    INSERT INTO DEL_EC(SEQID, COD_EMPRESA, TABELA, DATA_HORA_ALT' +
          '_WS, CAMPOS_CHAVE, VALORES_CHAVE, ID_COMMERCE)  '
        
          '    VALUES(:VSEQID, old.COD_EMPRESA, '#39'MARCA_PROD_EC'#39', CURRENT_TI' +
          'MESTAMP, :CAMPOS_CHAVE, :VALORES_CHAVE, OLD.ID_COMMERCE); '
        '  end '
        '  else if ((inserting)or(updating)) then '
        '  begin '
        
          '    NEW.SEQID_EC = (SELECT GEN_ID(SEQ_EC_MARCA_PROD_EC, 1) FROM ' +
          'RDB$DATABASE);'
        '  end '
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE VALOR_TIPO_GRADE_EC ADD SEQID_EC BIGINT;'
        'CREATE SEQUENCE SEQ_EC_VALOR_TIPO_GRADE_EC;'
