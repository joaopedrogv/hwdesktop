        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_GET_OPFISCAL'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_PEDVENDA_PRODUCAO_AUT FOR PEDVENDA'
        'ACTIVE AFTER INSERT OR UPDATE POSITION 0'
        'as'
        '  declare variable status_ped varchar(100);'
        '  declare variable datahoje timestamp;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        '      '
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.status_ped, '#39#39') = '#39'FECHADA'#39') then'
        
          '      select first 1 result from sp_producao_aut (new.nped, new.' +
          'tipo, new.cod_empresa) into :status_ped;'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    select current_date from rdb$database into :datahoje;'
        ''
        
          '    if ((new.cod_nfce > 0) and (trim(coalesce(new.status_ped, '#39#39 +
          ')) = '#39'FECHADA'#39') and (:datahoje = new.data_fech)) then'
        
          '        select first 1 result from sp_producao_aut (new.nped, ne' +
          'w.tipo, new.cod_empresa) into :status_ped;'
        
          '    else if ((new.id_commerce > 0) and (trim(coalesce(new.status' +
          '_ped, '#39#39')) = '#39'FECHADA'#39') and (:datahoje = new.data_fech)) then'
        
          '        select first 1 result from sp_producao_aut (new.nped, ne' +
          'w.tipo, new.cod_empresa) into :status_ped;'
        
          '    else if ((coalesce(old.status_ped, '#39#39') <> coalesce(new.statu' +
          's_ped, '#39#39'))'
        '        and (trim(coalesce(new.status_ped, '#39#39')) = '#39#39')) then'
        
          '            select first 1 result from sp_producao_aut (new.nped' +
          ', new.tipo, new.cod_empresa) into :status_ped;'
        
          '    else if ((coalesce(old.status_ped, '#39#39') <> coalesce(new.statu' +
          's_ped, '#39#39'))'
        
          '        and (trim(coalesce(new.status_ped, '#39#39')) = '#39'FECHADA'#39')) th' +
          'en'
        
          '            select first 1 result from sp_producao_aut (new.nped' +
          ', new.tipo, new.cod_empresa) into :status_ped;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE COBREBEM ADD AMBIENTE VARCHAR(16);'
        
          'UPDATE COBREBEM SET AMBIENTE = '#39'Produ'#231#227'o'#39' WHERE TIPO_API IS NULL' +
          ' AND AMBIENTE IS NULL;'
        
          'UPDATE COBREBEM SET AMBIENTE = '#39'Produ'#231#227'o'#39' WHERE TIPO_API IS NULL' +
          ';'
        'ALTER TABLE BOLETAS ADD TIPO_API CHAR(1);'
        'ALTER TABLE PEDVENDA ADD FINALIDADEID INTEGER;'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_GET_OPFISCAL'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_EMPRESA_PROMOCAO_PROD_ALT FOR EMPRESA'
        'ACTIVE AFTER UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE RECALCULAR_PRECOS INTEGER;'
        'begin'
        '  /* Trigger text */'
        '  SELECT COALESCE(VALUE1_F, 0) FROM CONFIG_SISTEMA'
        '  WHERE CHAVE = '#39'prod_cad_recalcular_preco_diferenciado'#39
        '  AND COD_EMPRESA = new.COD_EMPRESA into :RECALCULAR_PRECOS;'
        ''
        '  if (COALESCE(RECALCULAR_PRECOS, 0) <= 0) then'
        '    exit;'
        ''
        '  update promocao_produto pp set pp.proporcao_tabela ='
        '    coalesce(valor_promocao, 0) /'
        '    coalesce((select coalesce(prec_tab_prod, 0) from produtos pr'
        '              where pr.grupo_prod = pp.grupo_prod'
        '              and pr.cod_prod = pp.cod_prod'
        '              and pr.cod_empresa = pp.cod_empresa), 0)'
        '  where (coalesce(pp.proporcao_tabela, 0) > 0)'
        '  and (coalesce(pp.valor_promocao, 0) > 0)'
        '  and (coalesce(pp.cod_tppreco, 0) > 1)'
        '  and (pp.cod_empresa = new.COD_EMPRESA)'
        '  and (select coalesce(prec_tab_prod, 0) from produtos pr'
        '       where pr.grupo_prod = pp.grupo_prod'
        '       and pr.cod_prod = pp.cod_prod'
        '       and pr.cod_empresa = pp.cod_empresa) > 0;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'REL060'#39', :COD_EMPRESA, '#39'BT' +
          ' CONFIRMAR REL PAGAMENTOS FINANCEIRO'#39', 3, '#39'FRMRELATORIOS'#39', 1, '#39'N' +
          #39', '#39'N'#39', CURRENT_DATE);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'REL061'#39', :COD_EMPRESA, '#39'BT' +
          ' CONFIRMAR REL PAGAMENTOS/RECEBIMENTOS FINANC'#39', 3, '#39'FRMRELATORIO' +
          'S'#39', 1, '#39'N'#39', '#39'N'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_PAGAMENTOS('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE)'
        'AS'
        'select l.cod_lanc,'
        '    l.codigo_emp,'
        '    l.cod_emp_mult,'
        '    l.codigo_emp,'
        '    l.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    l.valor_l,'
        '    '#39#39' nome_c,'
        '    '#39#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        '    0 tipo_doc_c,'
        '    l.n_conta_plc,'
        '    l.lote'
        '    from lancamentos l'
        
          '    inner join controles c on c.codigo_ctrl = l.codigo_ctrl and ' +
          'c.codigo_emp = l.codigo_emp and docs = '#39'N'#39
        '    union all'
        '    select cc.codigo_ch,'
        '    cc.codigo_emp,'
        '    cc.cod_emp_mult,'
        '    cc.cod_emp_lote,'
        '    cc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cc.valor_ch,'
        '    cc.nome_ch,'
        '    cc.status_ch,'
        '    cc.data_venc,'
        '    cc.historico_ch,'
        '    cc.n_ch,'
        '    cc.data_rec,'
        '    0 tipo_doc_c,'
        '    cc.n_conta_plc,'
        '    cc.lote'
        '    from controle_cheque cc'
        
          '    inner join controles c on c.codigo_ctrl = cc.codigo_ctrl and' +
          ' c.codigo_emp = cc.codigo_emp'
        '    union all'
        '    select cx.cod_cred,'
        '    cx.codigo_emp,'
        '    cx.cod_emp_mult,'
        '    cx.cod_emp_lote,'
        '    cx.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cx.valor_c,'
        '    cx.nome_c,'
        '    cx.status_c,'
        '    cx.data_venc_c,'
        '    cx.historico_c,'
        '    cx.n_doc_c,'
        '    cx.data_rec_c,'
        '    cx.tipo_doc_c,'
        '    cx.n_conta_plc,'
        '    cx.lote'
        '    from controle_creditos cx'
        
          '    inner join controles c on c.codigo_ctrl = cx.codigo_ctrl and' +
          ' c.codigo_emp = cx.codigo_emp'
        '    union all'
        '    select bc.seq_bxcred,'
        '    bc.codigo_emp,'
        '    bc.cod_emp_mult,'
        '    bc.cod_emp_lote,'
        '    bc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    bc.valor_quitado,'
        '    bc.nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    bc.data_venc_c,'
        '    bc.historico_c,'
        '    bc.n_doc_c,'
        '    bc.data_rec_c,'
        '    bc.tipo_doc_c,'
        '    0,'
        '    bc.lote'
        '    from baixa_creditos bc'
        
          '    inner join controles c on c.codigo_ctrl = bc.codigo_ctrl and' +
          ' c.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW PAGAMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    TIPO,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST,'
        '    QTDE_PREST_EMP,'
        '    VALOR_PREST_EMP,'
        '    VALOR_PREST_TOT,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as Num_doc,'
        '    coalesce(det.lote, coalesce(ctp.cod_contrp, 0), 0) Num_doc2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.datq_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.codigo_emp = ctp.codigo_emp) =' +
          ' 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    1) qtde_prest,'
        ''
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        
          '    inner join det_pagamentos det on iif(emp.financeiro_unificad' +
          'o = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and' +
          ' det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as Num_doc,'
        '    coalesce(det.lote, coalesce(ctp.cod_contrp, 0), 0) Num_doc2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.data_ent_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.codigo_emp = ctp.codigo_emp) =' +
          ' 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    1) qtde_prest,'
        ''
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        
          '    left join det_pagamentos det on iif(emp.financeiro_unificado' +
          ' = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and ' +
          'det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW PAGAMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR_PAGO,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.datq_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    inner join det_pagamentos det on iif(emp.financeiro_unificad' +
          'o = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and' +
          ' det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.data_ent_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join det_pagamentos det on iif(emp.financeiro_unificado' +
          ' = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and ' +
          'det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        '  for select distinct pp.id_kit from pedvenda_prod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        
          '  select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod ' +
          'pp'
        '    where pp.nped = :nped'
        '    and pp.tipo = :tipo'
        '    and pp.cod_empresa = :cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39
        '    and coalesce(pp.codigo_kit, 0) <= 0 into :qtde_prod;'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        
          '  (select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod' +
          ' pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39') quant_ped_item,'
        ''
        
          '  (select sum(coalesce(ps.quant_serv_ped, 0)) from pedvenda_serv' +
          ' ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39') quant_serv_ped,'
        ''
        
          '  (select qtde from retorna_qtde_kit(pedvenda.nped, pedvenda.tip' +
          'o, pedvenda.cod_empresa)) quant_kit,'
        ''
        '  (coalesce(pedvenda.acrescimo, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.acresc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.acresc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.acresc_item, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.acresc_item, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        '  (coalesce(pedvenda.desconto, 0) +'
        
          '    iif((coalesce(pedvenda.tot_prod, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_prod, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_prod, 0) / 100) * coalesce(pedven' +
          'da.desc_p_prod, 0), 0) +'
        
          '    iif((coalesce(pedvenda.tot_serv, 0) > 0) and (coalesce(pedve' +
          'nda.desc_p_serv, 0) > 0),'
        
          '        (coalesce(pedvenda.tot_serv, 0) / 100) * coalesce(pedven' +
          'da.desc_p_serv, 0), 0) +'
        
          '    coalesce((select sum(coalesce(pp.desc_item, 0)) from pedvend' +
          'a_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.desc_item, 0)) from pedvend' +
          'a_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        '  ('
        
          '    coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '    coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CONTRP,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST,'
        '    QTDE_PREST_EMP,'
        '    VALOR_PREST_EMP,'
        '    VALOR_PREST_TOT,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.n_doc_ctp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.n_doc_ctp, 0), 0) as Num_doc' +
          '2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.datq_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.codigo_emp = ctp.codigo_emp) =' +
          ' 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    1) qtde_prest,'
        ''
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        
          '    inner join det_pagamentos det on iif(emp.financeiro_unificad' +
          'o = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and' +
          ' det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.cod_contrp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.cod_contrp, 0), 0) as Num_do' +
          'c2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.data_ent_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.codigo_emp = ctp.codigo_emp) =' +
          ' 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    1) qtde_prest,'
        ''
        
          '    coalesce((case when ((select count(*) from contas_a_pagar cp' +
          ' where cp.lote = ctp.lote and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        
          '                     (select count(*) from contas_a_pagar cp whe' +
          're cp.lote = ctp.lote and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(contas_a_pagar.valor_p' +
          'ago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.lot' +
          'e and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        
          '    left join det_pagamentos det on iif(emp.financeiro_unificado' +
          ' = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and ' +
          'det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR_PAGO,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.datq_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    inner join det_pagamentos det on iif(emp.financeiro_unificad' +
          'o = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and' +
          ' det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.data_ent_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(contas_a_pagar.valor' +
          '_pago, 0)) from contas_a_pagar where contas_a_pagar.lote = ctp.l' +
          'ote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.cod_emp_mult = ctp.cod_emp_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(contas_a_pag' +
          'ar.valor_pago, 0)) from contas_a_pagar where contas_a_pagar.lote' +
          ' = ctp.lote and contas_a_pagar.codigo_emp = ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join det_pagamentos det on iif(emp.financeiro_unificado' +
          ' = '#39'S'#39', det.cod_emp_lote, det.cod_empresa) = ctp.codigo_emp and ' +
          'det.lote = ctp.lote'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CRED,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DAS VENDAS (REQUISICAO, ORDEM DE S' +
          'ERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (CREDITOS/CHE' +
          'QUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '    --- REQ, OS'
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'DIRETO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebi' +
          'mento2,'
        
          '    1 ordem, 0 cod_tipo, rq.tipo, 0 cod_cred, coalesce(rq.nped, ' +
          '0) as Num_doc, coalesce(fp.ndoc, coalesce(rq.nped, 0), 0) Num_do' +
          'c2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.ncupom, 0) ncupom, coalesce(rq.num_nf, 0) num_nf' +
          ','
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '--    inner join formpagamento fp on fp.nrequisicao = rq.nped an' +
          'd fp.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp' +
          '.recibo is null'
        
          '    left join formpagamento fp on fp.nrequisicao = rq.nped and f' +
          'p.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.re' +
          'cibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        
          '    /*where coalesce((select count(*) from formpagamento frc whe' +
          're frc.nrequisicao = rq.nped and'
        
          '        frc.tpdocs = rq.tipo and frc.cod_empresa = rq.cod_empres' +
          'a and (not frc.recibo is null)),0) <= 0*/'
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'RECIBO'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '        (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        
          '    coalesce(rq.ncupom, 0) ncupom, coalesce(rq.num_nf, 0) num_nf' +
          ','
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = rq.nped and ' +
          'fp.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not' +
          ' fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'TROCO'#39' tp_recebimento, '#39'TROCO'#39' tp_recebime' +
          'nto2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.ncupom, 0) ncupom, coalesce(rq.num_nf, 0) num_nf' +
          ','
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ',  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rq.nped and ' +
          'fp.rec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and' +
          ' fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        '    --- CF'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'DIRETO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando), coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '--    inner join formpagamento fp on fp.nrequisicao = mt.n_coman' +
          'do and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  an' +
          'd fp.recibo is null'
        
          '    left join formpagamento fp on fp.nrequisicao = mt.n_comando ' +
          'and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and f' +
          'p.recibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        
          '    /* where coalesce((select count(*) from formpagamento frc wh' +
          'ere frc.nrequisicao = mt.n_comando and'
        
          '        frc.tpdocs = '#39'MOT'#39' and frc.cod_empresa = mt.cod_empresa ' +
          'and (not frc.recibo is null)),0) <= 0*/'
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'RECIBO'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '       inner join formpagamento rc on rc.cod_controle = ctrl.cod' +
          'igo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '       where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa ' +
          '= fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '        (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordo' +
          'c asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = mt.n_comando' +
          ' and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (' +
          'not fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'TROCO'#39' tp_recebimento, '#39'TROCO'#39' tp_recebime' +
          'nto2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
