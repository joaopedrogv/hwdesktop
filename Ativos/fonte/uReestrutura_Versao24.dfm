          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where coalesce(pr.status_ch, '#39#39') = '#39#39' and pr.datq_ch is null'
        '    '
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.' +
          'cod_emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_emp_m' +
          'ult,'
        
          '    coalesce(rq.cod_devedor, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'RECIBO ANTECIPADO'#39' tp_rel, '#39'DIRETO'#39' tp_recebimento, '#39'DIRETO' +
          #39' tp_recebimento2,'
        '    2 ordem, 0 cod_tipo, '#39'REC'#39' tipo, 0 cod_cred,'
        
          '    coalesce(rq.nrecibo, 0) as Num_doc, coalesce(fp.ndoc, coales' +
          'ce(rq.nrecibo, 0), 0) Num_doc2, rq.data_rec as data_doc,'
        
          '    rq.data_rec as data_Conf, coalesce(rq.valor_orig, 0) as valo' +
          'r_total,'
        '    (trim(rq.referencia1) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia2) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia3) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia4)) referencia, rq.nrecibo as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_us,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rq.num_rec_dep <> '#39#39') then rq.num_rec_dep else co' +
          'alesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        '    0 ncupom, 0 num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nr' +
          'ecibo), '#39'N'#39' venda, '#39#39' tipv, '#39'REC'#39' as tipo_doc,'
        '    1 qtde_prest'
        '    '
        '    from recibos rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_devedor and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = rq.nrecibo an' +
          'd fp.tpdocs = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp.r' +
          'ecibo is null'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        '    where rq.recant = '#39'S'#39
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.' +
          'cod_emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_emp_m' +
          'ult,'
        
          '    coalesce(rq.cod_devedor, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'RECIBO ANTECIPADO'#39' tp_rel, '#39'TROCO'#39' tp_recebimento, '#39'TROCO'#39' ' +
          'tp_recebimento2,'
        
          '    2 ordem, 0 cod_tipo, '#39'REC'#39' tipo, 0 cod_cred, coalesce(rq.nre' +
          'cibo, 0) as Num_doc,'
        
          '    coalesce(fp.ndoc, coalesce(rq.nrecibo, 0), 0) Num_doc2, rq.d' +
          'ata_rec as data_doc,'
        
          '    rq.data_rec as data_Conf, coalesce(rq.valor_orig, 0) as valo' +
          'r_total,'
        '    (trim(rq.referencia1) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia2) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia3) || ascii_char(13) || ascii_char(10) ||'
        '    trim(rq.referencia4)) referencia, rq.nrecibo as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_us,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rq.num_rec_dep <> '#39#39') then rq.num_rec_dep else co' +
          'alesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        '    0 ncupom, 0 num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nr' +
          'ecibo), '#39'N'#39' venda, '#39#39' tipv, '#39'REC'#39' as tipo_doc,'
        '    1 qtde_prest'
        '    '
        '    from recibos rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_devedor and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rq.nrecibo a' +
          'nd fp.rec_tipvend = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa an' +
          'd fp.tpdocs = '#39'TRC'#39
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        '    where rq.recant = '#39'S'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    FORMPAG,'
        '    VALOR_PAGO,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DETALHADOS DAS VENDAS (REQUISICAO,' +
          ' ORDEM DE SERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (C' +
          'REDITOS/CHEQUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '--- REQ, OS'
        'select '#39'DIRETO'#39', 1, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        'coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nped and fp.tp' +
          'docs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.recibo' +
          ' is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        'select '#39'RECIBO'#39', 1, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as nome_ctrl,'
        #39'RECIBO ANTECIPADO'#39' formpag,'
        
          'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc, co' +
          'alesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)'
        ''
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = rq.nped and fp.t' +
          'pdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not fp.' +
          'recibo is null)'
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        'select '#39'TROCO'#39', 1, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        
          'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc, co' +
          'alesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nped and fp.r' +
          'ec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.' +
          'tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        '--- CF'
        ''
        'select '#39'DIRETO'#39', 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = mt.n_comando and ' +
          'fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and fp.re' +
          'cibo is null'
        'inner join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'RECIBO'#39', 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as nome_ctrl,'
        #39'RECIBO ANTECIPADO'#39' formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = mt.n_comando and' +
          ' fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (not ' +
          'fp.recibo is null)'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'TROCO'#39', 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando)'
        'from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = mt.n_comando and' +
          ' fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and ' +
          'fp.tpdocs = '#39'TRC'#39
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        '-- Cred'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                            and ((l.historico_l like '#39'%RECIBOS A' +
          'TENCIPADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) ' +
          'then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
        '                        '#39'DIRETO'#39
        'end), '#39'DIRETO'#39'),'
        
          '3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null) then pr.tipo_' +
          'doc_c else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        0'
        '                      else'
        
          '                        case when (ctr.codigo_ctrl is null) then' +
          ' 0 else ctr.codigo_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.codigo_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.codigo_ctrl is nu' +
          'll) then 0 else ctr1.codigo_ctrl end'
        '                             else'
        '                               0'
        '                        end'
        '                      else'
        '                        ctr.codigo_ctrl'
        '                 end'
        '          end),'
        '0) codigo_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        
          '                        case when (ctr.nome_ctrl is null) then 0' +
          ' else ctr.nome_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.nome_ctrl is null' +
          ') then 0 else ctr1.nome_ctrl end'
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        '                        '#39'RECIBO ANTECIPADO'#39
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        '                               '#39'DEVOLUCAO'#39
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') formpag,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       case when (coalesce(l.valor_l, 0)) <= 0 then'
        '              case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                    coalesce(pr.valor_quitado, 0)'
        '                   else'
        '                     coalesce(l.valor_l, 0)'
        '              end'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        'end valor_pago,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.seq_bxcred), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.datq_c and l.tipo_l = '#39'E'#39
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        
          'where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_c is not nul' +
          'l'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is nu' +
          'll) then pr.tipo_doc_c else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        
          '999999 codigo_ctrl, '#39'CONTAS A PAGAR'#39' nome_ctrl, '#39'CONTAS A PAGAR'#39 +
          ' formpag,'
        'coalesce(pr.valor_quitado, 0) valor_pago,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(pr.seq_bxcred, 0), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_c is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is nu' +
          'll) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec_c,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        
          'case when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1) els' +
          'e coalesce(l.valor_l, 0) end valor_pago,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.cod_cred), 0'
        'from controle_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.data_rec_c'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                       and ((l.historico_l like '#39'%RECIBOS ATENCI' +
          'PADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
        '                        '#39'DIRETO'#39' end),'
        #39'DIRETO'#39'),'
        
          '3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null) then '#39#39' else ' +
          'ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_ch,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        0'
        '                      else'
        
          '                        case when (ctr.codigo_ctrl is null) then' +
          ' 0 else ctr.codigo_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.codigo_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.codigo_ctrl is nu' +
          'll) then 0 else ctr1.codigo_ctrl end'
        '                             else'
        '                               0'
        '                        end'
        '                      else'
        '                        ctr.codigo_ctrl'
        '                 end'
        '          end),'
        '0) codigo_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39')))  then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        
          '                        case when (ctr.nome_ctrl is null) then 0' +
          ' else ctr.nome_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.nome_ctrl is null' +
          ') then 0 else ctr1.nome_ctrl end'
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 '#39'RECIBO'#39
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        '                               '#39'DEVOLUCAO'#39
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') formpag,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       case when (coalesce(l.valor_l, 0)) <= 0 then '
        '              case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                     coalesce(pr.valor_ch, 0)'
        '                   else'
        '                     coalesce(pr.valor_ch, 0)'
        '              end'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        'end valor_pago,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(l.cod_lanc, pr.codigo_ch), 0 from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.datq_ch and l.tipo_l = '#39'E'#39
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        
          'where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_ch is not nu' +
          'll'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is nu' +
          'll) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_ch,'
        
          '999999 codigo_ctrl, '#39'CONTAS A PAGAR'#39' nome_ctrl, '#39'CONTAS A PAGAR'#39 +
          ' formpag,'
        'coalesce(pr.valor_ch, 0) valor_pago,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(pr.codigo_ch, 0), 0 from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_ch is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is nu' +
          'll) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        
          'case when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1) els' +
          'e coalesce(l.valor_l, 0) end valor_pago,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(l.cod_lanc, pr.codigo_ch), 0'
        'from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.data_rec'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_ch, '#39#39') = '#39#39' and pr.datq_ch is null'
        ''
        'union all'
        ''
        'select '#39'DIRETO'#39', 2, '#39'REC'#39', '#39'REC'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nrecibo and fp' +
          '.tpdocs = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp.recib' +
          'o is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'TROCO'#39', 2, '#39'REC'#39', '#39'REC'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc, fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nrecibo and f' +
          'p.rec_tipvend = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp' +
          '.tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_PROMOCAO_ALT FOR PRODUTOS'
        'ACTIVE AFTER UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        'begin'
        '  /* Trigger text */'
        '  if (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        
          '  if (COALESCE(old.PREC_TAB_PROD, 0) = COALESCE(new.PREC_TAB_PRO' +
          'D, 0)) then'
        '    exit;'
        ''
        '  SELECT COALESCE(VALUE1_F, 0) FROM CONFIG_SISTEMA'
        '  WHERE CHAVE = '#39'prod_cad_recalcular_preco_diferenciado'#39
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '    into :VRECALCULAR_PRECOS;'
        ''
        '  if (COALESCE(VRECALCULAR_PRECOS, 0) <= 0) then'
        '    exit;'
        ''
        '  SELECT CASAS_DECIMAIS FROM EMPRESA'
        '  WHERE COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCASAS_DECIMAIS;'
        ''
        '  VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '  if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '    VCASAS_DECIMAIS = 2;'
        ''
        
          '  UPDATE PROMOCAO_PRODUTO set VALOR_PROMOCAO = ROUND((PROPORCAO_' +
          'TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '  WHERE GRUPO_PROD = new.GRUPO_PROD'
        '  AND COD_PROD = new.COD_PROD'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '  AND PROPORCAO_TABELA > 0;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_PRECO_QTDE_ALT FOR PRODUTOS'
        'ACTIVE AFTER UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        'begin'
        '  /* Trigger text */'
        '  if (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        
          '  if (COALESCE(old.PREC_TAB_PROD, 0) = COALESCE(new.PREC_TAB_PRO' +
          'D, 0)) then'
        '    exit;'
        ''
        '  SELECT COALESCE(VALUE1_F, 0) FROM CONFIG_SISTEMA'
        '  WHERE CHAVE = '#39'prod_cad_recalcular_preco_por_quantidade'#39
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '    into :VRECALCULAR_PRECOS;'
        ''
        '  if (COALESCE(VRECALCULAR_PRECOS, 0) <= 0) then'
        '    exit;'
        ''
        '  SELECT CASAS_DECIMAIS FROM EMPRESA'
        '  WHERE COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCASAS_DECIMAIS;'
        ''
        '  VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '  if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '    VCASAS_DECIMAIS = 2;'
        ''
        
          '  UPDATE PRECO_PRODUTOS_QTDE set PRECO_VENDA = ROUND((PROPORCAO_' +
          'TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '  WHERE GRUPO_PROD = new.GRUPO_PROD'
        '  AND COD_PROD = new.COD_PROD'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '  AND PROPORCAO_TABELA > 0;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable VTEMP double precision;'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        
          '  for select distinct coalesce(pp.id_kit, 0) from pedvenda_prod ' +
          'pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        
          '  for select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_p' +
          'rod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '      and coalesce(pp.codigo_kit, 0) <= 0'
        '      union'
        
          '      select sum(coalesce(ppt.qtde, 0)) from pedvenda_prod_terc ' +
          'ppt'
        '      where ppt.nped = :nped'
        '      and ppt.tipo = :tipo'
        '      and ppt.cod_empresa = :cod_empresa'
        '          into :vtemp do'
        '  begin'
        '    qtde_prod = qtde_prod + vtemp;'
        '  end'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    ACRESC_ITEM_PROD,'
        '    DESC_ITEM_PROD,'
        '    ACRESC_ITEM_SERV,'
        '    DESC_ITEM_SERV,'
        '    VALOR_TOTAL,'
        '    VALOR_BRUTO,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  coalesce('
        
          '   coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from ped' +
          'venda_prod pp'
        '             where pp.nped = pedvenda.nped'
        '             and pp.tipo = pedvenda.tipo'
        '             and pp.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '   coalesce((select sum(coalesce(ppt.qtde, 0)) from pedvenda_pro' +
          'd_terc ppt'
        '             where ppt.nped = pedvenda.nped'
        '             and ppt.tipo = pedvenda.tipo'
        '             and ppt.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_ped_item,'
        ''
        '  coalesce('
        
          '   coalesce((select sum(coalesce(ps.quant_serv_ped, 0)) from ped' +
          'venda_serv ps'
        '             where ps.nped = pedvenda.nped'
        '             and ps.tipo = pedvenda.tipo'
        '             and ps.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(ps.status, '#39#39') = '#39#39'), 0) +'
        '   coalesce((select count(*) from pedvenda_serv_terc pst'
        '             where pst.nped = pedvenda.nped'
        '             and pst.tipo = pedvenda.tipo'
        '             and pst.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_serv_ped,'
        ''
        
          '  coalesce((select coalesce(qtde, 0) from retorna_qtde_kit(pedve' +
          'nda.nped, pedvenda.tipo, pedvenda.cod_empresa)), 0) quant_kit,'
        ''
        '  coalesce(pedvenda.tot_prod, 0) TOT_PROD,'
        '  coalesce(pedvenda.tot_serv, 0) TOT_SERV,'
        '  coalesce(pedvenda.tot_prod_terc, 0) TOT_PROD_TERC,'
        '  coalesce(pedvenda.tot_serv_terc, 0) TOT_SERV_TERC,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedve' +
          'nda_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_PRO' +
          'D,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedvend' +
          'a_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) DESC_ITEM_PROD,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from pedve' +
          'nda_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_SER' +
          'V,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedvend' +
          'a_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) DESC_ITEM_SERV,'
        ''
        '  coalesce(pedvenda.valor_total, 0) VALOR_TOTAL,'
        
          '  (coalesce(pedvenda.tot_prod, 0) + coalesce(pedvenda.tot_serv, ' +
          '0) + coalesce(pedvenda.tot_prod_terc, 0) + coalesce(pedvenda.tot' +
          '_serv_terc, 0)) VALOR_BRUTO,'
        ''
        
          '  (coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedv' +
          'enda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from ped' +
          'venda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '   (coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0)) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES ADD DESC_TP_CLIENTE VARCHAR(30);'
        'ALTER TABLE CLIENTES ADD ESTADOS_UF VARCHAR(2);'
        'ALTER TABLE CLIENTES ADD ESTADOS_UF_COBRANCA VARCHAR(2);'
        ''
        '|BLOCO|'
        'CREATE TABLE CAMPOS_DISPLAY ('
        '    NOME_TABELA  VARCHAR(31) NOT NULL,'
        '    CAMPO        VARCHAR(31) NOT NULL,'
        '    "DISPLAY"    VARCHAR(100),'
        '    TAMANHO      INTEGER,'
        '    TAG          INTEGER'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE CAMPOS_DISPLAY ADD CONSTRAINT PK_CAMPOS_DISPLAY PRIM' +
          'ARY KEY (NOME_TABELA, CAMPO);'
        ''
        
          'ALTER TABLE CABECALHO_ETIQUETA ALTER TAMANHO_ETI_H COMPUTED BY (' +
          '((LARGURA_P - MARGEM_ESQUERDA - MARGEM_DIREITA - ((COLUNAS-1) * ' +
          'DISTANCIA_ENTRECOL)) / COLUNAS));'
        ''
        'ALTER TABLE IMP_BAR_PROD ADD COD_GRADE INTEGER;'
        ''
        'ALTER TABLE CAMPOS_ETIQUETA ADD CAMPOCALCULADO     CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD CAMPOCODBARRA      CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD CAMPOIMAGEM        CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD QUEBRA_LINHA       CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD CODBARRA_VIS_TEXTO CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD CODBARRA_TIPO      VARCHAR(32);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD ALTURA             INTEGER;'
        'ALTER TABLE CAMPOS_ETIQUETA ADD COMPRIMENTO        INTEGER;'
        'ALTER TABLE CAMPOS_ETIQUETA ADD ALINHAMENTO        VARCHAR(10);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD FORMATO_MONETARIO  CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD MASCARAR_VALOR     CHAR(1);'
        'ALTER TABLE CAMPOS_ETIQUETA ADD FORMULA            VARCHAR(10);'
        
          'ALTER TABLE CAMPOS_ETIQUETA ADD IMAGEM             BLOB SUB_TYPE' +
          ' 0 SEGMENT SIZE 80;'
        'ALTER TABLE CAMPOS_ETIQUETA ADD AUTOSIZE           CHAR(1);'
        ''
        'ALTER TABLE CAMPOS_ETIQUETA ADD BARCODE VARCHAR(20);'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 50, RDB$CHARACTER_LENGT' +
          'H = 50 where RDB$FIELD_NAME = (select rdb$field_source from rdb$' +
          'relation_fields where rdb$relation_name = '#39'CAMPOS_ETIQUETA'#39' and ' +
          'rdb$field_name = '#39'FORMULA'#39');'
        ''
        'ALTER TABLE IMP_BAR_PROD ADD BARCODE VARCHAR(20);'
        ''
        '|BLOCO|'
        'CREATE GLOBAL TEMPORARY TABLE EDICAO_ETIQUETA ('
        '    COD_ETIQUETA            INTEGER NOT NULL,'
        '    COD_EMPRESA             INTEGER NOT NULL,'
        '    ORDEM                   INTEGER NOT NULL,'
        '    NOME_COMPONENTE         VARCHAR(50) NOT NULL,'
        '    CAPTION                 VARCHAR(50),'
        '    HINT                    VARCHAR(50),'
        '    FONTE_NAME              VARCHAR(50),'
        '    FONTE_SIZE              INTEGER,'
        '    FONTE_COR               VARCHAR(50),'
        '    FONTE_NEGRITO           CHAR(1),'
        '    FONTE_ITALICO           CHAR(1),'
        '    FONTE_SUBLINHADO        CHAR(1),'
        '    ALINHA_ESQUERDA         CHAR(1),'
        '    ALINHA_DIREITA          CHAR(1),'
        '    ALINHA_CENTRO           CHAR(1),'
        '    VERTICAL                INTEGER,'
        '    HORIZONTAL              INTEGER,'
        '    ALTURA                  INTEGER,'
        '    LARGURA                 INTEGER,'
        '    AUTO_SIZE               CHAR(1),'
        '    BARCODE_AUTO_WITTH      CHAR(1),'
        '    QUEBRA_LINHA            CHAR(1),'
        '    FORMATO_MONETARIO       CHAR(1),'
        '    MASCARAR_VALORES        CHAR(1),'
        '    IMAGEM                  BLOB SUB_TYPE 0 SEGMENT SIZE 80,'
        '    FORMULA                 VARCHAR(50),'
        '    BARCODE                 VARCHAR(20),'
        '    BARCODE_TEXTSHOW        CHAR(1),'
        '    BARCODE_TIPO            VARCHAR(32),'
        '    BARCODE_COR             VARCHAR(50),'
        '    COMPONENTE_CRIADO       CHAR(1),'
        '    COMPONENTE_DELETADO     CHAR(1),'
        '    COMPONENTE_SELECIONADO  CHAR(1)'
        ') ON COMMIT PRESERVE ROWS;'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE EDICAO_ETIQUETA ADD CONSTRAINT PK_EDICAO_ETIQUETA PR' +
          'IMARY KEY (COD_EMPRESA, ORDEM, COD_ETIQUETA, NOME_COMPONENTE);'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 100, RDB$CHARACTER_LENG' +
          'TH = 100 where RDB$FIELD_NAME = (select rdb$field_source from rd' +
          'b$relation_fields where rdb$relation_name = '#39'ITMODELOETITERMICA'#39 +
          ' and rdb$field_name = '#39'PARAMETROS_IMP'#39');'
        ''
        'ALTER TABLE PRODUTOS_PDC_VAR_IT ADD QUANT DOUBLE PRECISION;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_INDICE_TECNICO_PROD_VAR FOR INDICE_TE' +
          'CNICO'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        ' declare variable vind_ind integer;'
        'begin'
        '  /* Trigger text */ '
        '  for select p.id_ind from produtos_pdc_var p'
        '      where p.grupo_prod = old.grupo_prod_acabado'
        '      and p.cod_prod = old.cod_prod_acabado'
        '      and p.cod_empresa = old.cod_empresa into :vind_ind do'
        '  begin'
        '    if (coalesce(vind_ind, 0) > 0) then'
        '    begin'
        '      delete from produtos_pdc_var_it pit'
        '      where pit.id_ind = coalesce(:vind_ind, 0)'
        '      and pit.grupo_prod = old.grupo_prod_mprima'
        '      and pit.cod_prod = old.cod_prod_mprima'
        '      and pit.cod_empresa = old.cod_empresa;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETESTOQUE_RECURSIVO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PCOD_GRADE integer)'
        'returns ('
        '    ESTOQUE double precision)'
        'as'
        'declare variable VSQL varchar(500);'
        'declare variable VEXISTE_GRADE integer;'
        'declare variable VCRIAR_PRODUCAO_AUT char(1);'
        'declare variable VUSAR_PRODUCAO_TIPO char(1);'
        'declare variable VGRUPO_PROD_MPRIMA integer;'
        'declare variable VCOD_PROD_MPRIMA char(6);'
        'declare variable VCOD_GRADE_MPRIMA integer;'
        'declare variable VQUANT_MPRIMA double precision;'
        'declare variable VESTOQUE double precision;'
        'declare variable VESTOQUE_P double precision;'
        'declare variable VESTOQUE_GERAL double precision;'
        'declare variable VID_IND_A integer;'
        'declare variable VTEMP double precision;'
        'declare variable VTEMP_SQL varchar(100);'
        'declare variable VOK integer;'
        'begin'
        '  /* Procedure Text */'
        '  vestoque_geral = 0;'
        '  vestoque_p = 0;'
        '  vok = 0;'
        '  estoque = 0;'
        ''
        
          '  select usar_producao_tipo from empresa where cod_empresa = :pc' +
          'od_empresa into :vusar_producao_tipo;'
        ''
        '  if (coalesce(vusar_producao_tipo, '#39'N'#39') <> '#39'S'#39') then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  select criar_producao_aut from produtos where grupo_prod = :pg' +
          'rupo_prod and cod_prod = :pcod_prod and cod_empresa = :pcod_empr' +
          'esa into :vcriar_producao_aut;'
        ''
        '  if (coalesce(vcriar_producao_aut, '#39'N'#39') <> '#39'S'#39') then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  select count(*) from cod_grade_prod where grupo_prod = :pgrupo' +
          '_prod and cod_prod = :pcod_prod and cod_empresa = :pcod_empresa ' +
          'and cod_grade > 0 into :vexiste_grade;'
        ''
        '  vtemp_sql = '#39#39';'
        '  if (coalesce(pcod_grade, 0) > 0) then'
        '    vtemp_sql = '#39' and pa.cod_grade = '#39' || :pcod_grade;'
        '  else if (coalesce(vexiste_grade, 0) > 0) then'
        '    vtemp_sql = '#39' and pa.cod_grade > 0 '#39';'
        ''
        '  vestoque_geral = 0;'
        '  vsql = '#39' select 0 from rdb$database '#39';'
        
          '  if ((coalesce(vexiste_grade, 0) > 0) or (coalesce(pcod_grade, ' +
          '0) > 0)) then'
        '    vsql = '#39' select '#39' ||'
        
          '           iif((coalesce(pcod_grade, 0) <= 0) and (coalesce(vexi' +
          'ste_grade, 0) > 0), '#39#39', '#39' first 1 '#39') ||'
        '           '#39' pa.id_ind from produtos_pdc_var pa'
        '             where pa.grupo_prod = '#39' || :pgrupo_prod || '#39
        '             and pa.cod_prod = '#39' || :pcod_prod || '#39
        '           '#39' || vtemp_sql || '#39
        '             and pa.cod_empresa = '#39' || :pcod_empresa;'
        ''
        '  for'
        '    execute statement'
        '      vsql into :vid_ind_a do'
        '  begin'
        '    vtemp = 0;'
        '    vok = 0;'
        '    vestoque_p = 0;'
        '    for'
        '      select ind.grupo_prod_mprima, ind.cod_prod_mprima,'
        
          '      iif(coalesce(pm.quant, 0) > 0, coalesce(pm.quant, 0), coal' +
          'esce(ind.quant, 0)) quant,'
        
          '      iif(coalesce(pm.cod_grade, 0) > 0, coalesce(pm.cod_grade, ' +
          '0), 0) cod_grade_mprima,'
        '      coalesce((select estoque from getestoquedisponivel('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        
          '        iif(coalesce(pm.cod_grade, 0) > 0, coalesce(pm.cod_grade' +
          ', 0), 0),'
        '        ind.cod_empresa,'
        '        0,'
        '        '#39#39','
        '        0,'
        '        0)), 0) estoque from indice_tecnico ind'
        '      left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '      inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '      where ind.grupo_prod_acabado = :pgrupo_prod'
        '      and ind.cod_prod_acabado = :pcod_prod'
        '      and ind.cod_empresa = :pcod_empresa'
        '      and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        
          '        into :vgrupo_prod_mprima, :vcod_prod_mprima, :vquant_mpr' +
          'ima, :vcod_grade_mprima, :vtemp do'
        '    begin'
        '      if (coalesce(vestoque_p, 0) = 0) then'
        
          '        vestoque = (coalesce(vtemp, 0) / coalesce(vquant_mprima,' +
          ' 0));'
        
          '      else if ((coalesce(vtemp, 0) / coalesce(vquant_mprima, 0))' +
          ' < coalesce(vestoque_p, 0)) then'
        
          '        vestoque = (coalesce(vtemp, 0) / coalesce(vquant_mprima,' +
          ' 0));'
        '    '
        '      vtemp = 0;'
        '      select estoque from getestoque_recursivo ('
        '        :vgrupo_prod_mprima,'
        '        :vcod_prod_mprima,'
        '        :pcod_empresa,'
        '        :vcod_grade_mprima) into :vtemp;'
        '    '
        '      vestoque = coalesce(vestoque, 0) + coalesce(vtemp, 0);'
        '    '
        '      if (coalesce(vok, 0) = 0) then'
        '        vestoque_p = coalesce(vestoque, 0);'
        
          '      else if (coalesce(vestoque, 0) < coalesce(vestoque_p, 0)) ' +
          'then'
        '        vestoque_p = coalesce(vestoque, 0);'
        ''
        '      vok = 1;'
        '    end'
        '    estoque = coalesce(estoque, 0) + coalesce(vestoque_p, 0);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETPRODUTOSACABADOS_RECURSIVO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PQTDE double precision)'
        'returns ('
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6),'
        '    COD_GRADE integer,'
        '    QTDE double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  for select indice_tecnico.grupo_prod_mprima, indice_tecnico.co' +
          'd_prod_mprima,'
        
          '    iif(coalesce(produtos_pdc_var_it.cod_grade, 0) > 0, coalesce' +
          '(produtos_pdc_var_it.cod_grade, 0), 0) cod_grade,'
        '    (iif(coalesce(produtos_pdc_var_it.quant, 0) > 0,'
        '       coalesce(produtos_pdc_var_it.quant, 0),'
        '       coalesce(indice_tecnico.quant, 0) )'
        '           * coalesce(:pqtde, 0)) quant'
        '  from indice_tecnico'
        '  inner join produtos on'
        '    produtos.grupo_prod = indice_tecnico.grupo_prod_mprima'
        '    and produtos.cod_prod = indice_tecnico.cod_prod_mprima'
        '    and produtos.cod_empresa = indice_tecnico.cod_empresa'
        '  left join produtos_pdc_var on'
        '    produtos_pdc_var.grupo_prod = :pgrupo_prod'
        '    and produtos_pdc_var.cod_prod = :pcod_prod'
        '    and produtos_pdc_var.cod_grade = :pcod_grade'
        '    and produtos_pdc_var.cod_empresa = :pcod_empresa'
        '  left join produtos_pdc_var_it on'
        '    produtos_pdc_var_it.id_ind = produtos_pdc_var.id_ind'
        
          '    and produtos_pdc_var_it.cod_empresa = produtos_pdc_var.cod_e' +
          'mpresa'
        
          '    and produtos_pdc_var_it.grupo_prod =  indice_tecnico.grupo_p' +
          'rod_mprima'
        
          '    and produtos_pdc_var_it.cod_prod = indice_tecnico.cod_prod_m' +
          'prima'
        '  where indice_tecnico.grupo_prod_acabado = :pgrupo_prod'
        '  and indice_tecnico.cod_prod_acabado = :pcod_prod'
        '  and indice_tecnico.cod_empresa = :pcod_empresa'
        '  and produtos.criar_producao_aut = '#39'S'#39
        '    into :grupo_prod, :cod_prod, :cod_grade, :qtde do'
        '  begin'
        '    suspend;'
        ''
        
          '    for select grupo_prod, cod_prod, cod_grade, qtde from getpro' +
          'dutosacabados_recursivo ('
        '      :grupo_prod,'
        '      :cod_prod,'
        '      :cod_grade,'
        '      :pcod_empresa,'
        '      coalesce(:qtde, 0))'
        '      into :grupo_prod, :cod_prod, :cod_grade, :qtde do'
        '    begin'
        '      suspend;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETMATERIA_PRIMA_RECURSIVO ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PQUANT double precision,'
        '    PQTDE_DIM_EST double precision)'
        'returns ('
        '    RESULT varchar(100))'
        'as'
        'declare variable VPRODUCAO_AUT_ESTOQUE_NEG double precision;'
        'declare variable VEST_F_ACABADO double precision;'
        'declare variable VESTOQUE_DISP_ACABADO double precision;'
        'declare variable VESTOQUE_MATPRIMA_ACABADO double precision;'
        'declare variable VQUANT_ITEM_ACABADO double precision;'
        'declare variable VEST_F_ANT_ACABADO double precision;'
        'declare variable VCUSTO_INDICE_ACABADO double precision;'
        'declare variable VCUSTO_RATEIO_ACABADO double precision;'
        'declare variable VPREC_CUS_PROD_ACABADO double precision;'
        'declare variable VPREC_CUSM_PROD_ACABADO double precision;'
        'declare variable VPESO_BRUT_PROD_ACABADO double precision;'
        'declare variable VGRUPO_PROD_MPRIMA integer;'
        'declare variable VCOD_PROD_MPRIMA char(6);'
        'declare variable VCOD_GRADE_MPRIMA integer;'
        'declare variable VIND_IND_MPRIMA integer;'
        'declare variable VEST_F_MPRIMA double precision;'
        'declare variable VESTOQUE_DISP_MPRIMA double precision;'
        'declare variable VESTOQUE_RECURSIVO_MPRIMA double precision;'
        'declare variable VQUANT_MPRIMA double precision;'
        'declare variable VQTDE_PRODUCAO double precision;'
        'declare variable VPREC_CUS_PROD_MPRIMA double precision;'
        'declare variable VPREC_CUSM_PROD_MPRIMA double precision;'
        'declare variable VPESO_BRUT_PROD_MPRIMA double precision;'
        'declare variable VID_IND_A integer;'
        'declare variable VPREC_CUS_MED_TEMP double precision;'
        'declare variable VTEMP double precision;'
        'declare variable VVALORPARARATEIO_MPRIMA double precision;'
        'declare variable VRESULT varchar(100);'
        'declare variable VEXISTE_GRADE integer;'
        'begin'
        '  /* Procedure Text */'
        '  vqtde_producao = 0;'
        '  result = '#39'OK'#39';'
        ''
        '  select value1_f from config_sistema'
        '  where chave = '#39'producao_aut_estoque_neg'#39
        '  and cod_empresa = :pcod_empresa'
        '  into: vproducao_aut_estoque_neg;'
        ''
        '  select est_f, estoque from getestoquedisponivel('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    coalesce(:pcod_grade, 0),'
        '    :pcod_empresa,'
        '    0,'
        '    '#39#39','
        '    0,'
        '    0)'
        '  into :vest_f_acabado, :vestoque_disp_acabado;'
        ''
        '  if (coalesce(pqtde_dim_est, 0) > 0) then'
        '  begin'
        
          '    vest_f_acabado = coalesce(:vest_f_acabado, 0) - coalesce(pqt' +
          'de_dim_est, 0);'
        
          '    vestoque_disp_acabado = coalesce(vestoque_disp_acabado, 0)  ' +
          '- coalesce(pqtde_dim_est, 0);'
        '  end'
        ''
        '  select estoque from getestoque_recursivo('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    coalesce(:pcod_grade, 0))'
        '  into :vestoque_matprima_acabado;'
        ''
        '  -- Produto acabado sem estoque'
        '  if (coalesce(vestoque_disp_acabado, 0) >= 0) then'
        '  begin'
        '    result = '#39'PRODUTO ACABADO NAO ESTA COM ESTOQUE NEGATIVO'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(vproducao_aut_estoque_neg, 0) = 0) then'
        '    if (coalesce(vestoque_matprima_acabado, 0) <= 0) then'
        '    begin'
        '      result = '#39'MATERIA PRIMA SEM ESTOQUE SUFICIENTE'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '  -- Produto acabado nao possui cadastro da grade na producao'
        '  if (coalesce(pcod_grade, 0) <= 0) then'
        '  begin'
        '    select count(*) from cod_grade_prod cprod'
        '    where cprod.grupo_prod = :pgrupo_prod'
        '    and cprod.cod_prod = :pcod_prod'
        '    and cprod.cod_empresa = :pcod_empresa'
        '    and cprod.cod_grade > 0'
        '      into :vexiste_grade;'
        ''
        
          '    if ((coalesce(vexiste_grade, 0) > 0) and (coalesce(pcod_grad' +
          'e, 0) <= 0)) then'
        '    begin'
        
          '      result = '#39'PRODUTO ACABADO NAO POSSUI CADASTRO DA GRADE NA ' +
          'PRODUCAO'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        '  '
        '  select first 1 pa.id_ind from produtos_pdc_var pa'
        '  where pa.grupo_prod = :pgrupo_prod'
        '  and pa.cod_prod = :pcod_prod'
        '  and pa.cod_grade = :pcod_grade'
        '  and pa.cod_empresa = :pcod_empresa'
        '  into :vid_ind_a;'
        ''
        '  -- Produto acabado nao possui cadastro da grade na producao'
        
          '  if ((coalesce(pcod_grade, 0) > 0) and (coalesce(vid_ind_a, 0) ' +
          '<= 0)) then'
        '  begin'
        
          '    result = '#39'PRODUTO ACABADO NAO POSSUI CADASTRO DA GRADE NA PR' +
          'ODUCAO'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  -- Estoque anterior do produto acabado'
        
          '  vest_f_ant_acabado  = (coalesce(pquant, 0)) - abs(coalesce(ves' +
          't_f_acabado, 0));'
        ''
        '  -- Quantidade produto acabado'
        
          '  if ((coalesce(vest_f_ant_acabado, 0) = 0) and (coalesce(pquant' +
          ', 0) = abs(coalesce(vest_f_ant_acabado, 0)))) then'
        '    vquant_item_acabado = coalesce(pquant, 0);'
        '  else'
        
          '    vquant_item_acabado = coalesce(pquant, 0) - coalesce(vest_f_' +
          'ant_acabado, 0);'
        ''
        '  -- Estoque materia prima menor que o da venda'
        '  if (coalesce(vproducao_aut_estoque_neg, 0) = 1) then'
        '    vquant_item_acabado = abs(coalesce(vest_f_acabado, 0));'
        
          '  else if (coalesce(vquant_item_acabado, 0) > coalesce(vestoque_' +
          'matprima_acabado, 0)) then'
        
          '    vquant_item_acabado = coalesce(vestoque_matprima_acabado, 0)' +
          ';'
        ''
        '  vtemp = 0;'
        '  vprec_cus_med_temp = 0;'
        '  vcusto_indice_acabado = 0;'
        '  vcusto_rateio_acabado = 0;'
        '  vprec_cus_prod_acabado = 0;'
        '  vprec_cusm_prod_acabado = 0;'
        '  vvalorpararateio_mprima = 0;'
        '  for select ind.grupo_prod_mprima, ind.cod_prod_mprima,'
        
          '    iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, 0)' +
          ', 0),'
        
          '    iif(coalesce(pm.id_ind, 0) > 0, coalesce(pm.id_ind_it, 0), 0' +
          '),'
        '    iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.qtde, 0),'
        '    coalesce(pr.est_f, 0)),'
        '    (select estoque from getestoquedisponivel('
        '      ind.grupo_prod_mprima,'
        '      ind.cod_prod_mprima,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0),'
        '      ind.cod_empresa,'
        '      0,'
        '      '#39#39','
        '      0,'
        '      0)) estoque_disp_mprima,'
        '    (select estoque from getestoque_recursivo('
        '      ind.grupo_prod_mprima,'
        '      ind.cod_prod_mprima,'
        '      ind.cod_empresa,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0))) estoque_recursivo_mprima,'
        
          '    iif(coalesce(pm.quant, 0) > 0, coalesce(pm.quant, 0), coales' +
          'ce(ind.quant, 0)) quant,'
        '    coalesce(pa.prec_cus_prod, 0) prec_cus_prod_acabado,'
        '    coalesce(pa.prec_cusm_prod, 0) prec_cusm_prod_acabado,'
        '    coalesce(pa.peso_brut_prod, 0) peso_brut_prod_acabado,'
        '    coalesce(pr.prec_cus_prod, 0) prec_cus_prod_mprima,'
        
          '    coalesce(pr.prec_cusm_prod, 0) prec_cusm_prod_mprima from in' +
          'dice_tecnico ind'
        '    inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '    inner join produtos pr on'
        '        pr.grupo_prod = ind.grupo_prod_mprima'
        '        and pr.cod_prod = ind.cod_prod_mprima'
        '        and pr.cod_empresa = ind.cod_empresa'
        '    left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '    left join cod_grade_prod gr on'
        '        gr.grupo_prod = ind.grupo_prod_mprima'
        '        and gr.cod_prod = ind.cod_prod_mprima'
        '        and gr.cod_grade = coalesce(pm.cod_grade, 0)'
        '        and gr.cod_empresa = ind.cod_empresa'
        '    where ind.grupo_prod_acabado = :pgrupo_prod'
        '    and ind.cod_prod_acabado = :pcod_prod'
        '    and ind.cod_empresa = :pcod_empresa'
        '    and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '    and (select count(*) from temp_producao_aut tmp'
        '         where tmp.nped = :pnped'
        '         and tmp.tipo = :ptipo'
        '         and tmp.cod_empresa = :pcod_empresa'
        '         and tmp.grupo_prod_acabado = :pgrupo_prod'
        '         and tmp.cod_prod_acabado = :pcod_prod'
        '         and tmp.cod_grade_acabado = coalesce(:pcod_grade, 0)'
        '         and tmp.grupo_prod_mprima = ind.grupo_prod_mprima'
        '         and tmp.cod_prod_mprima = ind.cod_prod_mprima'
        
          '         and tmp.cod_grade_mprima = coalesce(gr.cod_grade, 0)) =' +
          ' 0'
        
          '  into :vgrupo_prod_mprima, :vcod_prod_mprima, :vcod_grade_mprim' +
          'a, :vind_ind_mprima,'
        
          '    :vest_f_mprima, :vestoque_disp_mprima, :vestoque_recursivo_m' +
          'prima, :vquant_mprima,'
        
          '    :vprec_cus_prod_acabado, :vprec_cusm_prod_acabado, :vpeso_br' +
          'ut_prod_acabado,'
        '    :vprec_cus_prod_mprima, :vprec_cusm_prod_mprima do'
        '  begin'
        '    -- Materia prima nao possui cadastro da grade na producao'
        
          '    if ((coalesce(vcod_grade_mprima, 0) > 0) and (coalesce(vind_' +
          'ind_mprima, 0) <= 0)) then'
        '    begin'
        
          '      result = '#39'MATERIA PRIMA NAO POSSUI CADASTRO DA GRADE NA PR' +
          'ODUCAO'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '    -- Sem estoque na materia prima'
        '    if (coalesce(vproducao_aut_estoque_neg, 0) = 0) then'
        
          '      if ((coalesce(vestoque_disp_mprima, 0) + coalesce(vestoque' +
          '_recursivo_mprima, 0)) < coalesce(vquant_mprima, 0)) then'
        '      begin'
        '        result = '#39'MATERIA PRIMA SEM ESTOQUE SUFICIENTE'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '    -- Custo indico item acabado'
        '    vcusto_indice_acabado = coalesce(vcusto_indice_acabado, 0) +'
        
          '      (coalesce(vprec_cusm_prod_mprima, 0) * coalesce(vquant_mpr' +
          'ima, 0));'
        ''
        '    -- Materia prima tem estoque disponivel'
        '    if (coalesce(vquant_mprima, 0) > 0) then'
        '    begin'
        
          '      if (coalesce(vqtde_producao, 0) > (coalesce(vestoque_disp_' +
          'mprima, 0) + coalesce(vestoque_recursivo_mprima, 0)) / coalesce(' +
          'vquant_mprima, 0)) then'
        
          '        vqtde_producao = ((coalesce(vestoque_disp_mprima, 0) + c' +
          'oalesce(vestoque_recursivo_mprima, 0)) / coalesce(vquant_mprima,' +
          ' 0));'
        '      else if (coalesce(vqtde_producao, 0) = 0) then'
        
          '        vqtde_producao = ((coalesce(vestoque_disp_mprima, 0) + c' +
          'oalesce(vestoque_recursivo_mprima, 0)) / coalesce(vquant_mprima,' +
          ' 0));'
        '    end'
        '    else'
        
          '      vqtde_producao = (coalesce(vestoque_disp_mprima, 0) + coal' +
          'esce(vestoque_recursivo_mprima, 0));'
        ''
        '    -- Preco de custo medio atual'
        
          '    vtemp = coalesce(vtemp, 0) + (coalesce(vprec_cus_prod_mprima' +
          ', 0) * coalesce(vquant_mprima, 0));'
        '  end'
        ''
        '  vprec_cus_med_temp = 0;'
        '  -- Preco de custo medio atual'
        '  vprec_cus_med_temp = coalesce(vprec_cus_med_temp, 0) +'
        
          '    (coalesce(vtemp, 0) * (coalesce(vquant_item_acabado, 0) / co' +
          'alesce(pquant, 0)));'
        ''
        '  -- Preco de custo medio anterior'
        '  if (coalesce(vest_f_ant_acabado, 0) > 0) then'
        '    vprec_cus_med_temp = coalesce(vprec_cus_med_temp, 0) +'
        
          '        (coalesce(vprec_cusm_prod_acabado, 0) * ((coalesce(pquan' +
          't, 0) - coalesce(vquant_item_acabado, 0)) / coalesce(pquant, 0))' +
          ');'
        ''
        '  -- Preco de custo medio acabado'
        '  vprec_cusm_prod_acabado = coalesce(vprec_cus_med_temp, 0);'
        ''
        '  -- Preco de custo item acabado'
        '  vprec_cus_prod_acabado = coalesce(vcusto_indice_acabado, 0);'
        ''
        '  -- Custo indice acabado'
        
          '  vcusto_indice_acabado = coalesce(vcusto_indice_acabado, 0) * c' +
          'oalesce(:vquant_item_acabado, 0);'
        ''
        '  if (result = '#39'OK'#39') then'
        '  begin'
        '    for select ind.grupo_prod_mprima, ind.cod_prod_mprima,'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade, ' +
          '0), 0),'
        
          '      iif(coalesce(pm.id_ind, 0) > 0, coalesce(pm.id_ind_it, 0),' +
          ' 0),'
        
          '      iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.qtde, 0), c' +
          'oalesce(pr.est_f, 0)),'
        '      (select estoque from getestoquedisponivel('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        
          '        iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade' +
          ', 0), 0),'
        '        ind.cod_empresa,'
        '        0,'
        '        '#39#39','
        '        0,'
        '        0)) estoque_disp_mprima,'
        '      (select estoque from getestoque_recursivo('
        '        ind.grupo_prod_mprima,'
        '        ind.cod_prod_mprima,'
        '        ind.cod_empresa,'
        
          '        iif(coalesce(gr.cod_grade, 0) > 0, coalesce(gr.cod_grade' +
          ', 0), 0))) estoque_recursivo_mprima,'
        
          '      iif(coalesce(pm.quant, 0) > 0, coalesce(pm.quant, 0), coal' +
          'esce(ind.quant, 0)) quant,'
        '      coalesce(pr.prec_cus_prod, 0) prec_cus_prod,'
        '      coalesce(pr.prec_cusm_prod, 0) prec_cusm_prod,'
        
          '      coalesce(pr.peso_brut_prod, 0) peso_brut_prod from indice_' +
          'tecnico ind'
        '      inner join produtos pa on'
        '        pa.grupo_prod = ind.grupo_prod_acabado'
        '        and pa.cod_prod = ind.cod_prod_acabado'
        '        and pa.cod_empresa = ind.cod_empresa'
        '      inner join produtos pr on'
        '        pr.grupo_prod = ind.grupo_prod_mprima'
        '        and pr.cod_prod = ind.cod_prod_mprima'
        '        and pr.cod_empresa = ind.cod_empresa'
        '      left join produtos_pdc_var_it pm on'
        '        pm.id_ind = coalesce(:vid_ind_a, 0)'
        '        and pm.grupo_prod = ind.grupo_prod_mprima'
        '        and pm.cod_prod = ind.cod_prod_mprima'
        '        and pm.cod_empresa = ind.cod_empresa'
        '      left join cod_grade_prod gr on'
        '        gr.grupo_prod = ind.grupo_prod_mprima'
        '        and gr.cod_prod = ind.cod_prod_mprima'
        '        and gr.cod_grade = coalesce(pm.cod_grade, 0)'
        '        and gr.cod_empresa = ind.cod_empresa'
        '      where ind.grupo_prod_acabado = :pgrupo_prod'
        '      and ind.cod_prod_acabado = :pcod_prod'
        '      and ind.cod_empresa = :pcod_empresa'
        '      and coalesce(pa.criar_producao_aut, '#39'N'#39') = '#39'S'#39
        '      and (select count(*) from temp_producao_aut tmp'
        '           where tmp.nped = :pnped'
        '           and tmp.tipo = :ptipo'
        '           and tmp.cod_empresa = :pcod_empresa'
        '           and tmp.grupo_prod_acabado = :pgrupo_prod'
        '           and tmp.cod_prod_acabado = :pcod_prod'
        '           and tmp.cod_grade_acabado = coalesce(:pcod_grade, 0)'
        '           and tmp.grupo_prod_mprima = ind.grupo_prod_mprima'
        '           and tmp.cod_prod_mprima = ind.cod_prod_mprima'
        
          '           and tmp.cod_grade_mprima = coalesce(gr.cod_grade, 0))' +
          ' = 0'
        
          '    into :vgrupo_prod_mprima, :vcod_prod_mprima, :vcod_grade_mpr' +
          'ima, :vind_ind_mprima,'
        
          '        :vest_f_mprima, :vestoque_disp_mprima, :vestoque_recursi' +
          'vo_mprima, :vquant_mprima,'
        
          '        :vprec_cus_prod_mprima, :vprec_cusm_prod_mprima, :vpeso_' +
          'brut_prod_mprima do'
        '    begin'
        '      insert into temp_producao_aut ('
        '        nped,'
        '        tipo,'
        '        cod_empresa,'
        '        grupo_prod_acabado,'
        '        cod_prod_acabado,'
        '        cod_grade_acabado,'
        '        quant_ped_item_acabado,'
        '        est_f_acabado,'
        '        est_f_ant_acabado,'
        '        estoque_disp_acabado,'
        '        custo_indice_acabado,'
        '        custo_rateio_acabado,'
        '        prec_cus_prod_acabado,'
        '        prec_cusm_prod_acabado,'
        '        peso_un_acabado,'
        '        peso_util_acabado,'
        '        grupo_prod_mprima,'
        '        cod_prod_mprima,'
        '        cod_grade_mprima,'
        '        quant_mprima,'
        '        est_f_mprima,'
        '        estoque_disp_mprima,'
        '        qtde_producao,'
        '        prec_cusm_prod_mprima,'
        '        peso_un_mprima,'
        '        peso_util_mprima'
        '      )'
        '      values ('
        '        :pnped,'
        '        :ptipo,'
        '        :pcod_empresa,'
        '        :pgrupo_prod,'
        '        :pcod_prod,'
        '        coalesce(:pcod_grade, 0),'
        '        coalesce(:vquant_item_acabado, 0),'
        '        coalesce(:vest_f_acabado, 0),'
        '        coalesce(:vest_f_ant_acabado, 0),'
        '        coalesce(:vestoque_disp_acabado, 0),'
        '        coalesce(:vcusto_indice_acabado, 0),'
        '        coalesce(:vcusto_rateio_acabado, 0),'
        '        coalesce(:vprec_cus_prod_acabado, 0),'
        '        coalesce(:vprec_cusm_prod_acabado, 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_acabado, 0) > 0, coalesce(' +
          ':vpeso_brut_prod_acabado, 0), 1),'
        
          '        iif(coalesce(:vpeso_brut_prod_acabado, 0) > 0, coalesce(' +
          ':vpeso_brut_prod_acabado, 0), 1) * coalesce(:vquant_item_acabado' +
          ', 0),'
        '        :vgrupo_prod_mprima,'
        '        :vcod_prod_mprima,'
        '        coalesce(:vcod_grade_mprima, 0),'
        '        coalesce(:vquant_mprima, 0),'
        '        coalesce(:vest_f_mprima, 0),'
        
          '        coalesce(:vestoque_disp_mprima, 0) + coalesce(:vestoque_' +
          'recursivo_mprima, 0),'
        '        coalesce(:vqtde_producao, 0),'
        '        coalesce(:vprec_cusm_prod_mprima, 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_mprima, 0) > 0, coalesce(:' +
          'vpeso_brut_prod_mprima, 0), 0),'
        
          '        iif(coalesce(:vpeso_brut_prod_mprima, 0) > 0, coalesce(:' +
          'vpeso_brut_prod_mprima, 0), 0) * coalesce(:vquant_mprima, 0)'
        '      );'
        '    end'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES ADD NPED_ULT_COMPRA INTEGER;'
        'ALTER TABLE CLIENTES ADD TIPO_ULT_COMPRA CHAR(3);'
        'ALTER TABLE CLIENTES ADD VALOR_ULT_COMPRA T_VL_TODOS;'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER TRIGGER TI_PEDVENDA_ULT_COMPRA FOR PEDVENDA'
        'ACTIVE AFTER INSERT OR UPDATE POSITION 0'
        'AS'
        '  declare variable vnped integer;'
        '  declare variable vtipo char(3);'
        '  declare variable vdata_fech timestamp;'
        
          '  declare variable vvalor_total double precision default 00000.0' +
          '0;'
        '  declare variable vvenda char(1);'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        
          '  if ((trim(new.TIPO) <> '#39'REQ'#39') and (trim(new.TIPO) <> '#39'OS'#39')) th' +
          'en'
        '    exit;'
        ''
        '  vvenda = '#39'N'#39';'
        '  if (trim(new.TIPO) = '#39'REQ'#39') then'
        
          '    select venda from tipo_vendas where trim(tipo) = trim(new.ti' +
          'po) and sigla = new.tipv into :vvenda;'
        '  else if (trim(new.TIPO) = '#39'OS'#39') then'
        
          '    select venda from tipo_vendas where trim(tipo) = trim(new.ti' +
          'po) and tipo_os = new.tipo_os into :vvenda;'
        ''
        '  if (coalesce(vvenda, '#39'N'#39') <> '#39'S'#39') then'
        '    exit;'
        ''
        '  if (inserting) then'
        '  begin'
        
          '    if ((trim(coalesce(old.STATUS_PED, '#39#39')) <> trim(coalesce(new' +
          '.STATUS_PED, '#39#39')))'
        '      and (trim(coalesce(new.STATUS_PED, '#39#39')) = '#39'FECHADA'#39')) then'
        '    begin'
        '      update clientes set'
        '        nped_ult_compra = new.NPED,'
        '        tipo_ult_compra = new.TIPO,'
        '        data_ult_compra = new.DATA_FECH,'
        '        valor_ult_compra = new.VALOR_TOTAL'
        '      where cod_cliente = new.COD_CLIENTE'
        '      and cod_empresa = new.COD_EMPRESA;'
        '    end'
        '  end'
        '  else if (updating) then'
        '  begin'
        
          '    if ((trim(coalesce(old.STATUS_PED, '#39#39')) <> trim(coalesce(new' +
          '.STATUS_PED, '#39#39')))'
        '      and (trim(coalesce(new.STATUS_PED, '#39#39')) = '#39'FECHADA'#39')) then'
        '    begin'
        '      update clientes set'
        '        nped_ult_compra = new.NPED,'
        '        tipo_ult_compra = new.TIPO,'
        '        data_ult_compra = new.DATA_FECH,'
        '        valor_ult_compra =  new.VALOR_TOTAL'
        '      where cod_cliente = new.COD_CLIENTE'
        '      and cod_empresa = new.COD_EMPRESA;'
        '    end'
        
          '    else if ((trim(coalesce(old.STATUS_PED, '#39#39')) <> trim(coalesc' +
          'e(new.STATUS_PED, '#39#39')))'
        '      and (trim(coalesce(old.STATUS_PED, '#39#39')) = '#39'FECHADA'#39')) then'
        '    begin'
        
          '      select first 1 nped, tipo, data_fech, valor_total from ped' +
          'venda'
        '      where trim(tipo) in ('#39'REQ'#39', '#39'OS'#39')'
        '      and cod_empresa = new.COD_EMPRESA'
        '      and status_ped = '#39'FECHADA'#39
        '      and data_fech is not null'
        '      order by data_fech desc, nped desc'
        '        into :vnped, :vtipo, :vdata_fech, :vvalor_total;'
        ''
        '      if (coalesce(vnped, 0) > 0) then'
        '      begin'
        '        update clientes set'
        '          nped_ult_compra = :vnped,'
        '          tipo_ult_compra = :vtipo,'
        '          data_ult_compra = :vdata_fech,'
        '          valor_ult_compra = :vvalor_total'
        '        where cod_cliente = new.COD_CLIENTE'
        '        and cod_empresa = new.COD_EMPRESA;'
        '      end'
        '      else'
        '      begin'
        '        update clientes set'
        '          nped_ult_compra = null,'
        '          tipo_ult_compra = null,'
        '          data_ult_compra = null,'
        '          valor_ult_compra = null'
        '        where cod_cliente = new.COD_CLIENTE'
        '        and cod_empresa = new.COD_EMPRESA;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
          'CREATE EXCEPTION EXC_EFD_SEM_INVENTARIO '#39'Sem registro de inventa' +
          'rio na data informada'#39';'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_EFD_ICMSST_CR_EST'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_TIPO88_ITNF'
        '|/BLOCO|')
      ExplicitWidth = 1022
    end
  end
end
