        'CREATE OR ALTER VIEW DEVOLUCAO_TOT('
        '    TIPO,'
        '    TIPO_DEV,'
        '    NDEV,'
        '    DATA,'
        '    COD_EMPRESA,'
        '    VALOR_DEV,'
        '    QUANT_DEV)'
        'AS'
        'select '#39'DEV'#39' as tipo,'
        '  dev.tipo tipo_dev,'
        '  dev.sequencia,'
        '  dev.data,'
        '  dev.cod_empresa,'
        '  sum((-1)*coalesce((dev.valor * dev.quant), 0)) valor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        '  group by 1, 2, 3, 4, 5'
        ';'
        '|/BLOCO|'
        ''
        
