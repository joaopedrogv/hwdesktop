        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure EXISTE_FORMAS'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure FORMAS_DET ('
        '    PNDOC integer,'
        '    PTIPODOC varchar(6),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    SEQFORM integer,'
        '    NDOC varchar(20),'
        '    DATA_MOV timestamp,'
        '    DATA_VENC timestamp,'
        '    VALORDOC double precision,'
        '    COD_CONTROLE integer,'
        '    NOME_CTRL varchar(35),'
        '    DOCS char(2),'
        '    NPARCELA integer,'
        '    REC_TIPVEND char(3),'
        '    REC_NUMVEND integer,'
        '    RECIBO char(1),'
        '    HISTORICO varchar(100),'
        '    PRG_FID char(1))'
        'as'
        'declare variable VSQL varchar(600);'
        'declare variable VCONFFORMPAGAMENTO varchar(3);'
        'declare variable VNF integer;'
        'declare variable VSERIE integer;'
        'declare variable VTEMP varchar(400);'
        'begin'
        '  VSQL = '#39#39';'
        '  VTEMP = '#39#39';'
        '  /* Procedure Text */'
        
          '  select conf_formpagamento from empresa where cod_empresa = 1 i' +
          'nto :vconfformpagamento;'
        
          '  if ((trim(coalesce(vconfformpagamento, '#39#39')) = '#39'PED'#39') or (trim(' +
          'coalesce(ptipodoc, '#39#39')) = '#39'PRE'#39')) then'
        '  begin'
        '    for select fp.seqform, fp.ndoc, fp.data_mov, fp.data_venc,'
        '    fp.valordoc, fp.cod_controle, ctr.nome_ctrl, ctr.docs,'
        
          '    fp.nparcela, fp.rec_tipvend, fp.rec_numvend, fp.recibo, fp.h' +
          'istorico, fp.prg_fid from formpagamento fp'
        
          '    inner join controles ctr on ctr.codigo_ctrl = fp.cod_control' +
          'e and ctr.codigo_emp = fp.cod_empresa'
        
          '    where fp.nrequisicao = :pndoc and fp.tpdocs = :ptipodoc and ' +
          'fp.cod_empresa = :pcod_empresa'
        '    and fp.ativo = 1 and fp.prg_fid = '#39'S'#39
        
          '    into :seqform, :ndoc, :data_mov, :data_venc, :valordoc, :cod' +
          '_controle, :nome_ctrl, :docs,'
        
          '      :nparcela, :rec_tipvend, :rec_numvend, :recibo, :historico' +
          ', :prg_fid do'
        '      suspend;'
        '  end'
        '  else'
        '  begin'
        '    if (trim(ptipodoc) = '#39'MOT'#39') then'
        '    begin'
        
          '      VSQL = '#39' select cf.num_nota_v as n_nf, cf.sub_serie as ser' +
          'ie from com_fat cf'
        
          '        where cf.n_comando = '#39'||:pndoc||'#39' and cf.cod_empresa = '#39 +
          '||:pcod_empresa;'
        '    end'
        '    else'
        '    begin'
        '      VSQL = '#39' select pp.n_nf, pp.serie from pedvenda_prod pp'
        
          '        where pp.nped = '#39'||:pndoc||'#39' and pp.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and pp.cod_empresa = '#39'||:pcod_empresa||'#39' and pp.ativo = ' +
          '1'
        
          '        and ((pp.status is null) or (pp.status <> '#39#39'CANCELADO'#39#39')' +
          ') and pp.n_nf > 0 and pp.serie <> '#39#39#39#39
        '        union'
        '        select ps.n_nf, ps.serie from pedvenda_serv ps'
        
          '        where ps.nped = '#39'||:pndoc||'#39' and ps.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and ps.cod_empresa = '#39'||:pcod_empresa||'#39' and ps.ativo = ' +
          '1'
        
          '        and ((ps.status is null) or (ps.status <> '#39#39'CANCELADO'#39#39')' +
          ') and ps.n_nf > 0 and ps.serie <> '#39#39#39#39
        '        group by 1,2 '#39';'
        '    end'
        ''
        '    for execute statement VSQL into :vnf, :vserie do'
        '    begin'
        '       if (trim(VTEMP) = '#39#39') then'
        
          '          VTEMP = '#39' ((fp.num_nota = '#39'||:vnf||'#39' and fp.sub_serie ' +
          '= '#39'||:vserie||'#39')'#39';'
        '       else'
        '          VTEMP = VTEMP || '#39' or (fp.num_nota = '#39'||:vnf||'
        '            '#39' and fp.sub_serie = '#39'||:vserie||'#39')'#39';'
        '    end'
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '      VTEMP = VTEMP || '#39')'#39';'
        ''
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '    begin'
        '        for execute statement'
        '        '#39' select fp.seqform, fp.ndoc, fp.data_mov, fp.data_venc,'
        '          fp.valordoc, fp.cod_controle, ctr.nome_ctrl, ctr.docs,'
        
          '          fp.nparcela, fp.rec_tipvend, fp.rec_numvend, fp.recibo' +
          ', fp.historico, fp.prg_fid'
        '          from formpagamento fp'
        
          '          inner join controles ctr on ctr.codigo_ctrl = fp.cod_c' +
          'ontrole and ctr.codigo_emp = fp.cod_empresa'
        
          '          where '#39'||:VTEMP||'#39' and fp.tpdocs <> '#39#39'LCS'#39#39' and fp.cod' +
          '_empresa = '#39'||:pcod_empresa||'#39
        '          and fp.ativo = 1 and fp.prg_fid = '#39#39'S'#39#39' '#39
        
          '          into :seqform, :ndoc, :data_mov, :data_venc, :valordoc' +
          ', :cod_controle, :nome_ctrl, :docs,'
        
          '          :nparcela, :rec_tipvend, :rec_numvend, :recibo, :histo' +
          'rico, :prg_fid do'
        '            suspend;'
        '      end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'FPG036'#39', :COD_EMPRESA, '#39'MO' +
          'NTAR BOLETO A PARTIR DE REQ'#39', 11, '#39'...'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DA' +
          'TE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'FPG037'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR BOLETO DE REQ NA CONFIRMACAO'#39', 11, '#39'...'#39', 1, '#39'N'#39', '#39'S'#39', CURR' +
          'ENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'FPG038'#39', :COD_EMPRESA, '#39'MO' +
          'NTAR BOLETO A PARTIR DE RECIBO'#39', 11, '#39'...'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT' +
          '_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'FPG039'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR BOLETO DE RECIBO NA CONFIRMACAO'#39', 11, '#39'...'#39', 1, '#39'N'#39', '#39'S'#39', C' +
          'URRENT_DATE);'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PREDBCEFET T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VBCEFET T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PICMSEFET T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VICMSEFET T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_PAG ADD INDPAG CHAR(1);'
        'ALTER TABLE NOTAFISCAL_DUP ADD NDOC VARCHAR(10);'
        'ALTER TABLE PRODUTOS ADD COD_BARRA_ETI VARCHAR(20);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER COD_BARRA_AIUD_CODBAR_ETI FOR COD_BARRA'
        'ACTIVE AFTER INSERT OR UPDATE OR DELETE POSITION 0'
        'AS'
        '  declare variable aexiste smallint;'
        '  declare variable acb_prod varchar(20);'
        '  declare variable acb_cb varchar(20);'
        'begin'
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '     exit;'
        
          '  if ((inserting) or ((updating) and ( old.cod_barra <> new.cod_' +
          'barra))) then'
        '  begin'
        '    select count(cod_prod) from produtos pr'
        
          '      where pr.grupo_prod = new.grupo_prod and pr.cod_prod = new' +
          '.cod_prod and'
        
          '        pr.cod_empresa = new.cod_empresa and pr.num_fab_prod = n' +
          'ew.cod_barra'
        '      into :aexiste;'
        ''
        '    if (coalesce(aexiste,0) > 0) then'
        '      exit;'
        ''
        '    update produtos pr set pr.cod_barra_eti = new.cod_barra'
        
          '      where pr.grupo_prod = new.grupo_prod and pr.cod_prod = new' +
          '.cod_prod and'
        '        pr.cod_empresa = new.cod_empresa;'
        '  end'
        '  else if (deleting) then'
        '  begin'
        
          '    select first 1 pr.num_fab_prod, cb.cod_barra from produtos p' +
          'r'
        
          '      left join cod_barra cb on pr.grupo_prod = cb.grupo_prod an' +
          'd pr.cod_prod = cb.cod_prod and'
        '        pr.cod_empresa = cb.cod_empresa and'
        
          '        pr.num_fab_prod <> cb.cod_barra and cb.cod_barra <> old.' +
          'cod_barra'
        
          '      where pr.grupo_prod = old.grupo_prod and pr.cod_prod = old' +
          '.cod_prod and'
        '        pr.cod_empresa = old.cod_empresa'
        '        into :acb_prod, acb_cb;'
        ''
        '    if (coalesce(acb_cb,'#39#39') = '#39#39') then'
        '      acb_cb = acb_prod;'
        '      '
        '    update produtos pr set pr.cod_barra_eti = :acb_cb'
        
          '      where pr.grupo_prod = old.grupo_prod and pr.cod_prod = old' +
          '.cod_prod and'
        '        pr.cod_empresa = old.cod_empresa;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'execute block as begin'
        '|/BLOCO|'
        ''
