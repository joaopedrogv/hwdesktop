        'ALTER TABLE NFCE_ITEM ADD FCP_PFCPST T_N_GERAL;'
        'ALTER TABLE NFCE_ITEM ADD FCP_VFCPST T_N_GERAL;'
        'ALTER TABLE NFCE_ITEM ADD FCP_PST T_N_GERAL;'
