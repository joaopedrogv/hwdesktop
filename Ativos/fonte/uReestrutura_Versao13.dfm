        'ACTIVE BEFORE INSERT POSITION 0'
        'as'
        '  declare variable ACODIGO integer;'
        'begin                  '
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
