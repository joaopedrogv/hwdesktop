procedure TSingleton.carregarUnidades(
  pBuscas: TIBQuery;
  var pCombobox: TComboBox;
  pHabilitar: Boolean = False;
  pUnidade: string = '';
  pUnidadeEmBranco: Boolean = False);
var
	I: Integer;
begin
	pCombobox.Enabled := pHabilitar;
	pCombobox.Clear;

  if pUnidadeEmBranco then
  	pCombobox.Items.Add('');

  SqlOpen(' select sigla from unidades ' +
    ' order by sigla ', pBuscas).FetchAll;

  pBuscas.First;
  while not pBuscas.Eof do
  begin
    pCombobox.Items.Add(UpperCase(trim(pBuscas.FieldByName('sigla').AsString)));

    pBuscas.Next;
  end;

  if trim(pUnidade) <> '' then
  begin
    for I := 0 to pCombobox.Items.Count - 1 do
      if UpperCase(trim(pCombobox.Items[I])) = UpperCase(trim(pUnidade)) then
      begin
      	pCombobox.ItemIndex := I;
        Break;
      end;
  end;
end;

