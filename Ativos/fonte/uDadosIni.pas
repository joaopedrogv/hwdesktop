procedure TSingleton.retornaEmail(
	pCodCliente: Integer;
  pEditEmail: TEdit);
var
	Con: TConexao;
begin
  Con := TConexao.Create(dtmAtivo.bancoHw);

	try
    try
    pEditEmail.Text := '';

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' select cod_cliente, nome_cliente, razao, contato, email from clientes ' +
      ' where cod_cliente = :cod_cliente and cod_empresa = :cod_empresa ';
      Con.QrAux.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
      Con.QrAux.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.Open;

      pEditEmail.Text := trim(Con.QrAux.FieldByName('email').AsString);
  except on E: Exception do
    begin
      Application.MessageBox(PChar('Erro ao retorna email: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao retorna email: ' + e.Message);
    end;
  end;
  finally
    if Assigned(Con) then
      FreeAndNil(Con);
end;
end;

