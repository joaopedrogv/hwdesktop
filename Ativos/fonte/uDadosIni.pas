  end;
end;

function TSingleton.ValidaEAN(CodBar: string): Boolean;
var
  sl_CodIni: string;
  il_SeqSom, il_Soma, il_TodNum: Integer;

  function DUN14Valido: Boolean;
  var
    Codigo,converCalculo :string;
    imp2, imp1, imp3, imp4, imp5,imp6, imp7, par1, par2 ,par3, par4, par5,par6,TResult,Tamanho,TImpar, TPar, Calculo, Digito:integer;
  begin

    try
      Codigo := Copy(CodBar, 1, 13);

      imp1:= StrToInt(copy(Codigo,1,1));
      imp2:= StrToInt(copy(Codigo,3,1));
      imp3:= StrToInt(copy(Codigo,5,1));
      imp4:= StrToInt(copy(Codigo,7,1));
      imp5:= StrToInt(copy(Codigo,9,1));
      imp6:= StrToInt(copy(Codigo,11,1));
      imp7:= StrToInt(copy(Codigo,13,1));

      TImpar:= (imp1)+(imp2)+(imp3)+(imp4)+(imp5)+(imp6)+(imp7);
      TImpar:= TImpar * 3;

      par1:= StrToInt(copy(Codigo,2,1));
      par2:= StrToInt(copy(Codigo,4,1));
      par3:= StrToInt(copy(Codigo,6,1));
      par4:= StrToInt(copy(Codigo,8,1));
      par5:= StrToInt(copy(Codigo,10,1));
      par6:= StrToInt(copy(Codigo,12,1));

      TPar:= (par1)+(par2)+(par3)+(par4)+(par5)+(par6);

      Calculo:= TImpar + TPar;

      converCalculo:= IntToStr(Calculo);

      Tamanho:= length(converCalculo);

      case Tamanho of
      1 :begin
          TResult:= StrToInt(copy(converCalculo,1,1));
            if TResult= 0 then
             Digito:= 0
            else
             Digito:= TResult - 10;

            if Digito < 0 then
             Digito:= ABS(Digito);
         end;

      2 :begin
          TResult:= StrToInt(copy(converCalculo,2,1));
            if TResult = 0 then
             Digito:= 0
            else
             Digito:= 10 - TResult;

           if Digito < 0 then
             Digito:= ABS(Digito);
         end;

      3 :begin
          TResult:= StrToInt(copy(converCalculo,3,1));
            if TResult= 0 then
              Digito:= 0
            else
              Digito:= 10 -  TResult;

           if Digito < 0 then
             Digito:= ABS(Digito);
         end;
      end;

      Result := IntToStr(Digito) = Copy(CodBar, 14, 1);

    except
      Result := False;
    end;
  end;

begin
  Result := False;

  CodBar := Trim(CodBar);
  if CodBar <> apenasNumeros(CodBar) then
    Exit;

  if not (Length(CodBar) in [8, 12, 13, 14]) then
    Exit;

  if (Length(Trim(CodBar)) = 14) then
     Result := DUN14Valido
    // se codigo eh certo, entao continua
  else
  begin
    sl_CodIni := PadL(CodBar, 13, '0');

    sl_CodIni := Copy(Trim(sl_CodIni), 1, Length(sl_CodIni) - 1);
    il_Soma := 0;
    il_SeqSom := 1;

    // se for ean8 entao completa numeros
//    if Length(Trim(CodBar)) = 8 then
//      sl_CodIni := '00000' + sl_CodIni;

    // continua

    for il_TodNum := 1 to Length(sl_CodIni) do
    begin
      if il_SeqSom = 1 then
      begin
        il_Soma := il_Soma +
          (StrToInt(Copy(sl_CodIni, il_TodNum, 1)) * il_SeqSom);
        il_SeqSom := 3;
      end
      else
      begin
        il_Soma := il_Soma +
          (StrToInt(Copy(sl_CodIni, il_TodNum, 1)) * il_SeqSom);
        il_SeqSom := 1;
      end

    end;

    // calcula o restante

    // para numeros que nao sao zero no final
    if Copy(IntToStr(il_Soma), Length(IntToStr(il_Soma)), 1) <> '0' then
    begin
      if Copy(Trim(CodBar), Length(CodBar), 1) =
        IntToStr(10 - StrToInt(Copy(IntToStr(il_Soma),
        Length(IntToStr(il_Soma)), 1))) then
        Result := TRUE
      else
        Result := FALSE
    end
    else if StrToInt(Copy(Trim(CodBar), Length(CodBar), 1)) = 0 then
      Result := TRUE
    else
      Result := FALSE;
  end;
end;

function TSingleton.validarAcessoCadastrosEmpresas(pCadastro, pAcao: string; pQuery: TIBQuery): Boolean;
var
  vAcao: string;
begin
  Result := True;

  if pCadastro = 'PEDIDO_VENDA' then
    pCadastro := 'PEDVENDA'
  else if pCadastro = 'CHEQUES' then
    pCadastro := 'CONTROLE_CHEQUE'
  else if pCadastro = 'CONTAS_A_RECEBER' then
    pCadastro := 'CONTROLE_CREDITOS'
  else if pCadastro = 'FECHAMENTO_DIA_FINANCEIRO' then
    pCadastro := 'FECH_DIA'
  else if pCadastro = 'NOTAFISCAL_LANCAMENTOS_FISCAIS' then
    pCadastro := 'NOTAFISCAL_SPED_C195_C197'
  else if pCadastro = 'CLIENTES_TELEVENDAS' then
    pCadastro := 'AGENDAMENTO'
  else if pCadastro = 'CLIENTES_CONTRATOS' then
    pCadastro := 'CLIENTES_COM_CONTRATO'
  else if pCadastro = 'PRODUTOS_PRECOS_DIFERENCIADOS' then
    pCadastro := 'PROMOCAO_PRODUTO'
  else if pCadastro = 'FORMA_PAGAMENTO' then
    pCadastro := 'FORMPAGAMENTO';

  if vCodEmpresaFisica = 0 then
    Exit;

  if vCodEmpresaFisica = StrToInt(codEmpresa) then
    Exit;

  pQuery.Close;
  pQuery.SQL.Text := 'select cod_empresa from EMPRESA_FISICA ' +
  	' where cod_empresa = ' + codEmpresa;
  pQuery.Open;

  if not pQuery.IsEmpty then
	  exit;

  if (UpperCase(Copy(pAcao, 1, 1)) = 'I') then
    vAcao := '. Ação: Incluir'
  else if (UpperCase(Copy(pAcao, 1, 1)) = 'E') then
    vAcao := '. Ação: Excluir'
  else if (UpperCase(Copy(pAcao, 1, 1)) = 'A') then
    vAcao := '. Ação: Alterar';

  Result := False;

  pQuery.Close;
  pQuery.SQL.Text := 'select * from CADASTROS_EMP' +
    ' where COD_EMP_ACESSO = ' + codEmpresa +
    ' and CADASTRO =  ' + QuotedStr(UpperCase(Trim(pCadastro)));
  pQuery.Open;

  try
    if pQuery.IsEmpty then
      Exit;

    if (UpperCase(Copy(pAcao, 1, 1)) = 'I') then
      Result := (pQuery.FieldByName('NIVEL_INCLUSAO').AsInteger > 0) and ( vNivel >= pQuery.FieldByName('NIVEL_INCLUSAO').AsInteger)
    else if (UpperCase(Copy(pAcao, 1, 1)) = 'A') then
      Result := (pQuery.FieldByName('NIVEL_ALTERACAO').AsInteger > 0) and ( vNivel >= pQuery.FieldByName('NIVEL_ALTERACAO').AsInteger)
    else if (UpperCase(Copy(pAcao, 1, 1)) = 'E') then
      Result := (pQuery.FieldByName('NIVEL_EXCLUSAO').AsInteger > 0) and ( vNivel >= pQuery.FieldByName('NIVEL_EXCLUSAO').AsInteger);
  finally
   if not Result then
      Application.MessageBox(pchar('Usuário não tem acesso a efetuar esta funcionalidade porque a empresa logada não é a mesma da empresa física configurada internamente' + #13 +
        'Funcionalidade: ' + pCadastro + vAcao + #13 +
        'Favor verificar com o administrador do sistema'), 'Atenção', 0 + 64);
  end;
end;

function TSingleton.validarAcessoEmpresasUnificadas(cQuery: TIBQuery): Boolean;
var
 vtemp: string;
begin
  Result := True;

  if vEmp.vFinanceiroUnificado then
  begin
    if vEmp.vCodigoUnificadora <> StrToInt(codEmpresa) then
    begin
       Result := False;

       if (cQuery <> nil) then
       begin
       cQuery.Close;
       cQuery.SQL.Text := ' select cod_empresa, (trim(coalesce(identificacao_emp, '''')) ||'' - ''|| trim(coalesce(cgc_emp, ''''))) identificacao_emp from empresa ' +
         ' where cod_empresa = ' + IntToStr(vEmp.vCodigoUnificadora) + ' order by cod_empresa ';
       cQuery.Open;

         vtemp := cQuery.FieldByName('identificacao_emp').AsString;
       end
       else
         vtemp := trim(vEmp.vEmpUnificadora) + ' - ' + trim(vEmp.vCNPJ);

      Application.MessageBox(PChar('Empresa não tem acesso a efetuar esta funcionalidade ' +
       'porque o financeiro está unificado na Empresa: ' + #13 +
       UpperCase(trim(vtemp))), 'Informação',
       MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
    end;
  end;
end;

