    vEmp.vMascaraGrupoCotaRd := trim(buscas.FieldByName('MASCARA_GRUPO_COTA_RD').AsString);
    vEmp.vEnvEmailReservaVeic := trim(buscas.FieldByName('ENV_EMAIL_RESERVA_VEIC').AsString);
    vEmp.vSqlOrdemFilaRes := trim(buscas.FieldByName('SQL_ORDEM_FILA_RES').AsString);
    vEmp.vCtrPlanoPg := trim(buscas.FieldByName('CTR_PLANO_VEIC').AsString);
    vEmp.vDiasReservaBanco := buscas.FieldByName('DIAS_RES_BANCO').AsInteger;
    vEmp.vInfRedLucro := buscas.FieldByName('INF_RED_LUCRO').AsString;
    vEmp.vPercComissaoVendedorVeic := buscas.FieldByName('PERC_COMISSAO_V_VEIC').AsFloat;
    vEmp.vPercComissaoGerenteVeic := buscas.FieldByName('PERC_COMISSAO_G_VEIC').AsFloat;
    vEmp.vPercRetornoVendedorVeic := buscas.FieldByName('PERC_RET_BANCO_V_VEIC').AsFloat;
    vEmp.vPercRetornoGerenteVeic := buscas.FieldByName('PERC_RET_BANCO_G_VEIC').AsFloat;
    vEmp.vSenhaContratoVeic := buscas.FieldByName('SENHA_CONTRATO_VEIC').AsString;
    vEmp.vResponsavelCopiaHwF := Trim(buscas.FieldByName('COPIAR_HWF_TERM_RET').AsString);
    if Trim(vEmp.vResponsavelCopiaHwF) = '' then
      vEmp.vResponsavelCopiaHwF := 'R';
    vEmp.vDirCopiaHwFTerminais := Trim(buscas.FieldByName('DIRETORIO_HWF_TERM').AsString);
    vEmp.vUsarReducaoInvertida := Trim(buscas.FieldByName('USAR_REDUCAO_INVERTIDA').AsString);
    vEmp.vVndToleranciaMarkUp := buscas.FieldByName('VND_TOLER_PERC_MARKUP').AsFloat;
    vEmp.vUsarPoliticasDesc := (buscas.FieldByName('USARPOLITICASDESC').AsString = 'S');
    vEmp.vAbaterItens := trim(buscas.FieldByName('ABATER_ITENS').AsString);
    vEmp.vConfCNPJTransfDep := trim(buscas.FieldByName('CONF_CNPJ_TRANSFDEP').AsString);
    vEmp.vDtVencUIItensVnd  :=  DateToStr(buscas.FieldByName('VENC_UI_ITENSVND').AsDateTime);
    vEmp.vConsDepositoEstoque := trim(buscas.FieldByName('CONS_DEPOSITO_ESTOQUE').AsString);
    vEmp.vCodCtrlMtUsadas := buscas.FieldByName('COD_CTRL_MTUSADAS').AsInteger;
    vEmp.vAcrescCaracteresChassi := trim(buscas.FieldByName('ACRESC_CARACTERES_CHASSI').AsString);
    vEmp.vFinanceiroUnificado := Trim(buscas.FieldByName('FINANCEIRO_UNIFICADO').AsString) = 'S';
    vEmp.vCodigoUnificadora := buscas.FieldByName('CODIGO_UNIFICADORA').AsInteger;
    vEmp.vUsarDebCred := buscas.FieldByName('USARDEBITOCREDITO').AsString='S';
    vEmp.vLancDebCredDev := buscas.FieldByName('LANCDEBCRED_DEV').AsString='S';
    vEmp.vPercLancDebCredDev := buscas.FieldByName('PERC_LANCDEBCRED_DEV').AsFloat;

    if vEmp.vOC_UsarOrdemCarregamento = 'S' then
      vEmp.vUSAR_SEPARACAO_PED := 'N'
    else if vEmp.vOC_UsarOrdemCarregamento = 'D' then
      vEmp.vUSAR_SEPARACAO_PED := 'N'
    else if vEmp.vAlmox = 'S2' then
      vEmp.vUSAR_SEPARACAO_PED := 'N';

    if vEmp.vAlmox = 'S2' then
      vEmp.vUsarConferenciaCegaSaida := 'N';

    SetLength(vEmp.UnificadasArray, 1);
    vEmp.UnificadasArray[High(vEmp.UnificadasArray)] := cod_empresa;

    if (vEmp.vFinanceiroUnificado) then// and (vEmp.vCodigoUnificadora = StrToInt(codEmpresa)) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_empresa from empresa' +
        ' where codigo_unificadora = ' + IntToStr(vEmp.vCodigoUnificadora);
      buscas.Open;
      buscas.FetchAll;

      vEmp.vCodigoUnificadas := '(';
      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.FieldByName('cod_empresa').AsInteger <> cod_empresa then
        begin
          SetLength(vEmp.UnificadasArray, Length(vEmp.UnificadasArray) + 1);
          vEmp.UnificadasArray[High(vEmp.UnificadasArray)] := buscas.FieldByName('cod_empresa').AsInteger;
        end;

        if vEmp.vCodigoUnificadas <> '(' then
          vEmp.vCodigoUnificadas := vEmp.vCodigoUnificadas + ',' + IntToStr(buscas.FieldByName('cod_empresa').AsInteger)
        else
          vEmp.vCodigoUnificadas := vEmp.vCodigoUnificadas + IntToStr(buscas.FieldByName('cod_empresa').AsInteger);
        buscas.Next;
      end;
      vEmp.vCodigoUnificadas := vEmp.vCodigoUnificadas + ')';
      if vEmp.vCodigoUnificadas = '()' then
        vEmp.vCodigoUnificadas := '(' + codEmpresa + ')';
    end
    else
      vEmp.vCodigoUnificadas := '(' + codEmpresa + ')';

    buscas.Close;
    buscas.SQL.Text := 'select' +
      ' NFE_CAMINHO_CERT,' +
      ' NFE_SENHA__CERT,' +
      ' NFE_NUMSERIE_CERT,' +
      ' NFE_DANFE_TIPO,' +
      ' NFE_DANFE_FOREMISS,' +
      ' NFE_LOGOMARCA,' +
      ' NFE_LOGPATH,' +
      ' WEBSERV_UF,' +
      ' WEBSERV_AMBIENTE,' +
      ' WEBSERV_VISUALIZAR,' +
      ' DIAS_AVISO,' +
      ' NFE_ENDRELRAVE,' +
      ' NFE_ENDERECOPDF,' +
      ' PORTA_SMTP,' +
      ' ENVIAEMAILNFE,' +
      ' ASSUNTO_NFE,' +
      ' EMAIL_USASSL,' +
      ' EMAIL_SENHA,' +
      ' MENSAGEM_NFE,' +
      ' IBGE_COD_CIDADE,' +
      ' IBGE_CODIGO_UF,' +
      ' MODELO_NF,' +
      ' SERIE_SCAN,' +
      ' USO_SERVICO_NFE,' +
      ' SERIE_SERV_NFE,' +
      ' MODELO_NF_SERV,' +
      ' nfe_xjust, ' +
      ' nfe_dhcont' +
      ' from empresa where ativo=1 and cod_empresa=' + codEmpresa;
    try
      buscas.Open;
    except
      on e: exception do
      begin
        Application.MessageBox(pchar('Erro ao abrir dados da NF-e. Erro: ' + e.Message),
          'Atenção', 0 + 64);
      end;
    end;

    vEmp.vNfe.pathCertificado := buscas.FieldByName('NFE_CAMINHO_CERT').AsString;
    vEmp.vNfe.certificadoSenha := buscas.FieldByName('NFE_SENHA__CERT').AsString;
    vEmp.vNfe.certificadonumSerie := buscas.FieldByName('NFE_NUMSERIE_CERT').AsString;
    vEmp.vNfe.danfeTipo := buscas.FieldByName('NFE_DANFE_TIPO').AsString;
    vEmp.vNfe.danfeFormaEmissao := buscas.FieldByName('NFE_DANFE_FOREMISS').AsString;
    vEmp.vNfe.pathLogo := buscas.FieldByName('NFE_LOGOMARCA').AsString;
    vEmp.vNfe.pathArquivos := buscas.FieldByName('NFE_LOGPATH').AsString;
    vEmp.vNfe.webServiceSiglaUF := buscas.FieldByName('WEBSERV_UF').AsString;
    vEmp.vNfe.webServiceAmbiente := buscas.FieldByName('WEBSERV_AMBIENTE').AsString;
    vEmp.vNfe.webServiceVisualizar := buscas.FieldByName('WEBSERV_VISUALIZAR').AsString;
    vEmp.vNfe.pathRaveDanfe := buscas.FieldByName('NFE_ENDRELRAVE').AsString;
    vEmp.vNfe.pathPdfDanfe := buscas.FieldByName('NFE_ENDERECOPDF').AsString;
    vEmp.vNfe.emailAssunto := buscas.FieldByName('ASSUNTO_NFE').AsString;
    vEmp.vNfe.emailSenha := buscas.FieldByName('EMAIL_SENHA').AsString;
    vEmp.vNfe.mensagem := buscas.FieldByName('MENSAGEM_NFE').AsString;
    vEmp.vNfe.modeloNF := buscas.FieldByName('MODELO_NF').AsString;
    vEmp.vNfe.modeloNFServico := buscas.FieldByName('MODELO_NF_SERV').AsString;
    vEmp.vNfe.emailEnviar := buscas.FieldByName('ENVIAEMAILNFE').AsString;
    vEmp.vNfe.emailUsarSSL := buscas.FieldByName('EMAIL_USASSL').AsString;
    vEmp.vNfe.usarServico := buscas.FieldByName('USO_SERVICO_NFE').AsString;
    vEmp.vNfe.diasAviso := buscas.FieldByName('DIAS_AVISO').AsInteger;
    vEmp.vNfe.emailportaSmtp := buscas.FieldByName('PORTA_SMTP').AsInteger;
    vEmp.vNfe.ibgeCodCidade := buscas.FieldByName('IBGE_COD_CIDADE').AsInteger;
    vEmp.vNfe.ibgeCodEstado := buscas.FieldByName('IBGE_CODIGO_UF').AsInteger;
    vEmp.vNfe.serieScan := buscas.FieldByName('SERIE_SCAN').AsInteger;
    vEmp.vNfe.serieServico := buscas.FieldByName('SERIE_SERV_NFE').AsInteger;
    vEmp.vNfe.nfe_xjust := buscas.FieldByName('nfe_xjust').AsString;
    vEmp.vNfe.nfe_dhcont := buscas.FieldByName('nfe_dhcont').AsDateTime;

    if (vEmp.vFinanceiroUnificado) and (vEmp.vCodigoUnificadora > 0) then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select cod_empresa, (identificacao_emp ||'' - ''|| cnpj_emp) identificacao_emp from empresa ' +
        ' where cod_empresa = ' + IntToStr(vEmp.vCodigoUnificadora) +
        ' order by cod_empresa ';
      buscas.Open;

      vEmp.vEmpUnificadora := UpperCase(trim(buscas.FieldByName('identificacao_emp').AsString));
    end
    else
      vEmp.vEmpUnificadora := '';

    buscas.close;

    try
      buscas.Close;
      buscas.SQL.Text := 'select * from EMPDESVOLV where COD_EMPDES = 1';
      buscas.Open;

      vCodEmpresaFisica := buscas.FieldByName('COD_EMPRESA_FISICA').AsInteger;
    except
      vCodEmpresaFisica := 0;
    end;
    if vCodEmpresaFisica = 0 then
      vCodEmpresaFisica := StrToInt(codEmpresa);

    if (vSistema <> 'Fiscal') or (bancoConectado = 'servidor') then
    begin

      vTipoVendaREQ := '(';
      vTipoVendaOS := '(';
      vTipoNaoVendaREQ := '(';
      vTipoNaoVendaOS := '(';

      buscas.SQL.Text := 'select * from TIPO_VENDAS';
      buscas.Open;
      buscas.First;
      while not buscas.Eof do
      begin

        if Trim(buscas.FieldByName('venda').AsString) = 'S' then
        begin
          if Trim(buscas.FieldByName('tipo').AsString) = 'REQ' then
            vTipoVendaREQ := vTipoVendaREQ + QuotedStr(Trim(buscas.FieldByName('sigla').AsString)) +
              ','
          else if Trim(buscas.FieldByName('tipo').AsString) = 'OS' then
            vTipoVendaOS := vTipoVendaOS + QuotedStr(Trim(buscas.FieldByName('tipo_os').AsString)) +
              ',';
        end
        else if Trim(buscas.FieldByName('venda').AsString) = 'N' then
        begin
          if Trim(buscas.FieldByName('tipo').AsString) = 'REQ' then
            vTipoNaoVendaREQ := vTipoNaoVendaREQ +
              QuotedStr(Trim(buscas.FieldByName('sigla').AsString)) + ','
          else if Trim(buscas.FieldByName('tipo').AsString) = 'OS' then
            vTipoNaoVendaOS := vTipoNaoVendaOS +
              QuotedStr(Trim(buscas.FieldByName('tipo_os').AsString)) + ',';
        end;

        buscas.Next;
      end;

      vTipoVendaREQ := vTipoVendaREQ + ')';
      vTipoVendaOS := vTipoVendaOS + ')';
      vTipoNaoVendaREQ := vTipoNaoVendaREQ + ')';
      vTipoNaoVendaOS := vTipoNaoVendaOS + ')';

      vTipoVendaREQ := StringReplace(vTipoVendaREQ, ',)', ')', [rfReplaceAll]);
      vTipoVendaOS := StringReplace(vTipoVendaOS, ',)', ')', [rfReplaceAll]);
      vTipoNaoVendaREQ := StringReplace(vTipoNaoVendaREQ, ',)', ')', [rfReplaceAll]);
      vTipoNaoVendaOS := StringReplace(vTipoNaoVendaOS, ',)', ')', [rfReplaceAll]);

      vTipoVendaREQ := StringReplace(vTipoVendaREQ, '()', '('''')', [rfReplaceAll]);
      vTipoVendaOS := StringReplace(vTipoVendaOS, '()', '('''')', [rfReplaceAll]);
      vTipoNaoVendaREQ := StringReplace(vTipoNaoVendaREQ, '()', '('''')', [rfReplaceAll]);
      vTipoNaoVendaOS := StringReplace(vTipoNaoVendaOS, '()', '('''')', [rfReplaceAll]);

      buscas.close;
      buscas.SQL.Text:= 'select ptv.maxdescontotv from TIPO_VENDAS tv '+
        ' inner join PERCENTUAISTIPOVND ptv on tv.cod_tipo = ptv.cod_tipo '+
        ' where tv.tipo = ''REQ'' and tv.sigla = ''V'''+
        ' and ptv.cod_empresa = ' + codEmpresa;
      buscas.Open;
      vEmp.vTotDescProdVarejo := buscas.FieldByName('maxdescontotv').AsFloat;

      buscas.Close;
      buscas.SQL.Text := 'select * from PROPAGANDA';
      buscas.Open;
      if not buscas.IsEmpty then
      begin
        AssignFile(vArquivoPropaganda, ExtractFilePath(Application.ExeName) + 'prop.txt');
        try
          Rewrite(vArquivoPropaganda);

          while not buscas.Eof do
          begin
            Writeln(vArquivoPropaganda, buscas.FieldByName('LOCAL').AsString +
              buscas.FieldByName('ENDERECO_PROPAGANDA').AsString);
            buscas.Next;
          end;

        finally
          CloseFile(vArquivoPropaganda);
        end;
      end;

    end;

    vBoletos.ExisteConvenio := SqlOpen('select count(*) from cobrebem where cod_empresa = %d and ativo = 1', [cod_empresa]).Fields[0].AsInteger > 0;

    buscas.Close;

    atualizarConfiguracoesDoSistema(buscas);

  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao abrir dados de Configuração. Erro: ' + e.Message),
        'Atenção', 0 + 64);
    end;
  end;
end;

procedure TSingleton.Auditoria(Processo, Acao, Mensagem, Tabela,
  CodigoTabMov: string);
begin
  gravarAuditoria(PChar(vNomeUsuario),
                  PChar(''),
                  PChar(Processo),
                  PChar(Acao),
                  PChar(Mensagem),
                  PChar(Tabela),
                  PChar(CodigoTabMov),
                  PChar(codEmpresa));
end;

function TSingleton.baixarRecAntValeCompra(pCodCliente: Integer): boolean;
var
  Config: TConfig_sistema_class;
  vDataUltimaConsulta: string;
  vDataAtual: TDateTime;
	vBuscasTmp, vBuscasTmp2, vBuscasTmp3: TIBQuery;
	vTransTmp: TIBTransaction;
  vNrecibo: Integer;
  vCodEmpresa: Integer;
  vDataRec: TDateTime;
  vValor: Double;
  vRecAnt: string;
  vCodigo: Integer;
begin
	Result := False;

  if vRecibo.Baixar.vBaixarAutomaticamentoAposVencRecAntValeCompra <> 'S' then
    Exit;

	if vEmp.vFinanceiroUnificado then
  	if vEmp.vCodigoUnificadora <> StrToInt(codEmpresa) then
    	Exit;

	try
  	vTransTmp := TIBTransaction.Create(Application);
    vTransTmp.DefaultDatabase := dtmAtivo.bancoHw;
    vTransTmp.DefaultAction := TACommit;
    vTransTmp.Params.Clear;
    vTransTmp.Params.Add('read_committed');
    vTransTmp.Params.Add('rec_version');
    vTransTmp.Params.Add('nowait');

    vBuscasTmp := TIBQuery.Create(Application);
    vBuscasTmp.Database := dtmAtivo.bancoHw;
    vBuscasTmp.Transaction := vTransTmp;

    vBuscasTmp2 := TIBQuery.Create(Application);
    vBuscasTmp2.Database := dtmAtivo.bancoHw;
    vBuscasTmp2.Transaction := vTransTmp;

    vBuscasTmp3 := TIBQuery.Create(Application);
    vBuscasTmp3.Database := dtmAtivo.bancoHw;
    vBuscasTmp3.Transaction := vTransTmp;

    vDataAtual := vDadosIni.getDataBanco(vBuscasTmp);

    if pCodCliente = 0 then
    begin
      try
        Config := TConfig_sistema_class.getConf('rec_hab_vencimento', vBuscasTmp, cod_empresa);

        try
          if Config.value_dt = 0 then
            vDataUltimaConsulta := ''
          else
            vDataUltimaConsulta := FormatDateTime('dd/mm/yyyy', Config.value_dt);

          if trim(vDataUltimaConsulta) = '' then
            vDataUltimaConsulta := '01/01/2000';

          StrToDate(vDataUltimaConsulta);
        except
          vDataUltimaConsulta := '01/01/2000';
        end;

        if trim(vRecibo.Baixar.vUsarDataAtualDataFinanceiroRecAntValeCompra) = 'F' then
        begin
          if vDadosIni.diaFFinanceiro + 1 = StrToDate(vDataUltimaConsulta) then
            Exit;

          Config.value_dt := vDadosIni.diaFFinanceiro + 1;
        end
        else
        begin
          if vDataAtual = StrToDate(vDataUltimaConsulta) then
            Exit;

          Config.value_dt := vDataAtual;
        end;

        Config.SaveConfDB(vBuscasTmp);

        if vBuscasTmp.Transaction.InTransaction then
          vBuscasTmp.Transaction.Commit;

      finally
        if Assigned(Config) then
          FreeAndNil(Config);
      end;
    end;

    vInibeMensPesqPros := 'S';
    if not PesqPros('REC009', 'RECEBER - AUT', '', 'RECIBOS', '', vBuscasTmp2, true) then
      Exit;

    vBuscasTmp.Close;
    vBuscasTmp.SQL.Text := ' select recibos.nrecibo, recibos.cod_empresa, ' +
      ' recibos.data_rec, recibos.valor, recant from recibos ' +
      ' left join empresa on empresa.cod_empresa = recibos.' + vDadosIni.IfThen(vDadosIni.vEmp.vFinanceiroUnificado, 'cod_emp_mult', 'cod_empresa') +
      ' where ';

    if pCodCliente > 0 then
      vBuscasTmp.SQL.Text := vBuscasTmp.SQL.Text +
        ' recibos.cod_empresa = :pcod_empresa '
    else
      vBuscasTmp.SQL.Text := vBuscasTmp.SQL.Text +
        vDadosIni.IfThen(vDadosIni.vEmp.vFinanceiroUnificado,
          ' (case when (empresa.financeiro_unificado = ''S'') then :pcod_empresa else recibos.cod_empresa end) ',
          ' recibos.cod_empresa ') + ' = :pcod_empresa ';

    if pCodCliente > 0 then
      vBuscasTmp.SQL.Text := vBuscasTmp.SQL.Text +
        ' and ((recibos.cod_benef = :pcod_benef) or (recibos.cod_devedor = :pcod_devedor)) ';

    vBuscasTmp.SQL.Text := vBuscasTmp.SQL.Text +
      ' and recibos.data_venc < :pdata_venc ' +
      ' and recibos.data_venc >= :pdata_venc_ini ' +
      ' and trim(coalesce(recibos.status_rec, '''')) <> ''RECEBIDO'' ';

    if pCodCliente > 0 then
    begin
      vBuscasTmp.ParamByName('pcod_benef').AsInteger := pCodCliente;
      vBuscasTmp.ParamByName('pcod_devedor').AsInteger := pCodCliente;
    end;

    vBuscasTmp.ParamByName('pcod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);

    if trim(vRecibo.Baixar.vUsarDataAtualDataFinanceiroRecAntValeCompra) = 'F' then
      vBuscasTmp.ParamByName('pdata_venc').AsDateTime := vDadosIni.diaFFinanceiro + 1
    else
      vBuscasTmp.ParamByName('pdata_venc').AsDateTime := vDataAtual;

    vBuscasTmp.ParamByName('pdata_venc_ini').AsDateTime := StrToDate(vRecibo.Baixar.vDataVencimentoBaseRecAntValeCompra);

    vBuscasTmp.Open;

    if vBuscasTmp.IsEmpty then
      Exit;

    vBuscasTmp.First;
    while not vBuscasTmp.Eof do
    begin
      vNrecibo    := vBuscasTmp.FieldByName('NRECIBO').AsInteger;
      vCodEmpresa := vBuscasTmp.FieldByName('COD_EMPRESA').AsInteger;
      vDataRec    := vBuscasTmp.FieldByName('DATA_REC').AsDateTime;
      vValor      := vBuscasTmp.FieldByName('VALOR').AsFloat;
      vRecAnt     := vBuscasTmp.FieldByName('RECANT').AsString;

      vBuscasTmp2.Close;
      vBuscasTmp2.SQL.Text := ' select cod from incrementa_codigo(:cod_empresa, :tabela); ';
      vBuscasTmp2.ParamByName('cod_empresa').AsInteger := vDadosIni.cod_empresa;
      vBuscasTmp2.ParamByName('tabela').AsString := 'HIST_REC';
      vBuscasTmp2.Open;

      vCodigo := vBuscasTmp2.FieldByName('COD').AsInteger;

      vBuscasTmp2.Close;
      vBuscasTmp2.SQL.Text := ' update recibos set data_baixa = :data_baixa, status_rec = :status_rec ' +
        ' where nrecibo = :nrecibo and cod_empresa = :cod_empresa ';
      vBuscasTmp2.ParamByName('status_rec').AsString := 'RECEBIDO';
      vBuscasTmp2.ParamByName('data_baixa').AsDateTime := vDataAtual;
      vBuscasTmp2.ParamByName('nrecibo').AsInteger := vNrecibo;
      vBuscasTmp2.ParamByName('cod_empresa').AsInteger := vCodEmpresa;
      vBuscasTmp2.ExecSQL;

      vBuscasTmp2.Close;
      vBuscasTmp2.SQL.Text := ' insert into hist_rec ' +
        ' (seqcad_rec, cod_empresa, nrecibo, valor_baixa, ' +
        ' data_rec, data_baixa, recant, cod_us, tp_baixa, historico_rec, ativo) ' +
        ' values ' +
        ' (:seqcad_rec, :cod_empresa, :nrecibo, :valor_baixa, ' +
        ' :data_rec, :data_baixa, :recant, :cod_us, :tp_baixa, :historico_rec, :ativo); ';
      vBuscasTmp2.ParamByName('seqcad_rec').AsInteger := vCodigo;
      vBuscasTmp2.ParamByName('cod_empresa').AsInteger := vDadosIni.cod_empresa;
      vBuscasTmp2.ParamByName('nrecibo').AsInteger := vNrecibo;
      vBuscasTmp2.ParamByName('valor_baixa').AsFloat := vValor;
      vBuscasTmp2.ParamByName('data_rec').AsDateTime := vDataRec;
      vBuscasTmp2.ParamByName('data_baixa').AsDateTime := vDataAtual;
      vBuscasTmp2.ParamByName('recant').AsString := vRecAnt;
      vBuscasTmp2.ParamByName('cod_us').AsInteger := vCodUsuario;
      vBuscasTmp2.ParamByName('tp_baixa').AsString := 'T';
      vBuscasTmp2.ParamByName('historico_rec').AsString := 'BAIXA AUT';
      vBuscasTmp2.ParamByName('ativo').AsInteger := 1;
      vBuscasTmp2.ExecSQL;

      GravaAuditoria(
        'REC009',
        'BAIXAR - AUT',
        'Emp: ' + IntToStr(vCodEmpresa),
        'RECIBOS',
        IntToStr(vNrecibo), vBuscasTmp2);

      vBuscasTmp.Next;
    end;

    if vTransTmp.InTransaction then
    begin
      vTransTmp.Commit;
      GravaAuditoria('REC011', 'BAIXAR - AUT', 'SUCESSO', 'RECIBOS', '', vBuscasTmp3);
      Result := True;
    end;

  except
    on E: exception do
    begin
      Result := False;
      vDadosIni.fechaStatusProcessamento;
      registraErro('function TSingleton.baixarRecAntValeCompra. Erro: ' + e.Message);
      Application.MessageBox(pchar('Erro na Baixar Recibo Antecipado / Vale Compra Vencidos. Erro: ' + E.Message), 'Atenção', 0 + 64);
      GravaAuditoria('REC011', 'BAIXAR - AUT', 'FALHA', 'RECIBOS', '', vBuscasTmp2);
    end;
  end;
end;

function TSingleton.negativarClientes(pCodCliente: Integer; pCpfCnpj: string; pExibirMensagem: Boolean = False; pVerificarConf: Boolean = False): boolean;
var
	Config: TConfig_sistema_class;
  vDataUltimaConsulta: string;
  vDataAtual: TDateTime;
	vBuscasTmp, vBuscasTmp2, vBuscasTmp3: TIBQuery;
  vTransTmp: TIBTransaction;
  vCodCliente: Integer;
  vcl_hab_faturamento_unico_entre_empresas: Boolean;
  vCpf: string;
  vStatus_f: string;
  vList: TStrings;
begin
 	Result := False;

  if (vCliente.Barramento.vBarraAutomaticamenteAposVencCrediario <> 'S') and (vCliente.Barramento.vDesbarraAutomaticamenteAposQuitCrediario <> 'S') then
    Exit;

  if vEmp.vFinanceiroUnificado then
  	if vEmp.vCodigoUnificadora <> StrToInt(codEmpresa) then
    	Exit;

	try
  	try
      vTransTmp := TIBTransaction.Create(Application);
      vTransTmp.DefaultDatabase := dtmAtivo.bancoHw;
      vTransTmp.DefaultAction := TACommit;
      vTransTmp.Params.Clear;
      vTransTmp.Params.Add('read_committed');
      vTransTmp.Params.Add('rec_version');
      vTransTmp.Params.Add('nowait');

      vBuscasTmp := TIBQuery.Create(Application);
      vBuscasTmp.Database := dtmAtivo.bancoHw;
      vBuscasTmp.Transaction := vTransTmp;

      vBuscasTmp2 := TIBQuery.Create(Application);
      vBuscasTmp2.Database := dtmAtivo.bancoHw;
      vBuscasTmp2.Transaction := vTransTmp;

      vBuscasTmp3 := TIBQuery.Create(Application);
      vBuscasTmp3.Database := dtmAtivo.bancoHw;
      vBuscasTmp3.Transaction := vTransTmp;

      vDataAtual := vDadosIni.getDataBanco(vBuscasTmp);

      vcl_hab_faturamento_unico_entre_empresas := vDadosIni.getConfSisBool('cl_hab_faturamento_unico_entre_empresas', vBuscasTmp);

    	vList := TStringList.Create;
      vList := vDadosIni.getConfSisBlob('cl_hab_faturamento_unico_entre_empresas', vBuscasTmp);

      if ((pCodCliente = 0) and (trim(pCpfCnpj) = '')) and (pVerificarConf) then
      begin
        try
          Config := TConfig_sistema_class.getConf('cl_faturamento_conf', vBuscasTmp, cod_empresa);

          try
            if Config.value_dt = 0 then
              vDataUltimaConsulta := ''
            else
              vDataUltimaConsulta := FormatDateTime('dd/mm/yyyy', Config.value_dt);

            if trim(vDataUltimaConsulta) = '' then
              vDataUltimaConsulta := '01/01/2000';

            StrToDate(vDataUltimaConsulta);
          except
            vDataUltimaConsulta := '01/01/2000';
          end;


          if trim(vCliente.Barramento.vUsarDataAtualDataFinanceiro) = 'F' then
          begin
            if vDadosIni.diaFFinanceiro + 1 = StrToDate(vDataUltimaConsulta) then
              Exit;

            Config.value_dt := vDadosIni.diaFFinanceiro + 1;
          end
          else
          begin
            if vDataAtual = StrToDate(vDataUltimaConsulta) then
              Exit;

            Config.value_dt := vDataAtual;
          end;

          Config.SaveConfDB(vBuscasTmp);

          if vBuscasTmp.Transaction.InTransaction then
            vBuscasTmp.Transaction.Commit;

        finally
          if Assigned(Config) then
            FreeAndNil(Config);
        end;
      end;

      if vCliente.Barramento.vBarraAutomaticamenteAposVencCrediario = 'S' then
      begin
        if vCliente.Barramento.vCodigoBarrado = 0 then
        begin
        	if pExibirMensagem then
            Application.MessageBox(
              'Barramento automático ativado. Campo "CodigoBarrado" deve ser informado na engrenagem do cadastro do cliente "cl_faturamento_conf"',
              'Atenção', 0 + 64);
          Exit;
        end;

        if vCliente.Barramento.vCodigoBarrado > 0 then
        begin
          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select codigo_faturamento, status_f, ativo from tipo_faturamento ' +
            ' where codigo_faturamento = :codigo_faturamento ';
          vBuscasTmp.ParamByName('codigo_faturamento').AsInteger := vCliente.Barramento.vCodigoBarrado;
          vBuscasTmp.Open;

          if vBuscasTmp.IsEmpty then
          begin
            if pExibirMensagem then
              Application.MessageBox(PChar(
                'Barramento automático ativado. Código ' + IntToStr(vCliente.Barramento.vCodigoBarrado) + ' não encontrado no cadastro de tipo de faturamento'),
                'Atenção', 0 + 64);
            Exit;
          end;

          if UpperCase(trim(vBuscasTmp.FieldByName('status_f').AsString)) <> 'BARRADO' then
          begin
            if pExibirMensagem then
            	Application.MessageBox(PChar(
                'Barramento automático ativado. O status do código do tipo de faturamento ' + IntToStr(vCliente.Barramento.vCodigoBarrado) + ' deve ser BARRADO'),
                'Atenção', 0 + 64);
            Exit;
          end;

          if vBuscasTmp.FieldByName('ativo').AsInteger <> 1 then
          begin
            if pExibirMensagem then
              Application.MessageBox(PChar(
                'Barramento automático ativado. O código do tipo de faturamento  ' + IntToStr(vCliente.Barramento.vCodigoBarrado) + ' esta na lixeira'),
                'Atenção', 0 + 64);
            Exit;
          end;
        end;
      end;

      if vCliente.Barramento.vDesbarraAutomaticamenteAposQuitCrediario = 'S' then
      begin
        if vCliente.Barramento.vCodigoDesbarrado = 0 then
        begin
          if pExibirMensagem then
            Application.MessageBox(
              'Desbarramento automático ativado. Campo "CodigoDesbarrado" deve ser informado na engrenagem do cadastro do cliente "cl_faturamento_conf"',
              'Atenção', 0 + 64);
          Exit;
        end;

        if vCliente.Barramento.vCodigoDesbarrado > 0 then
        begin
          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select codigo_faturamento, status_f, ativo from tipo_faturamento ' +
            ' where codigo_faturamento = :codigo_faturamento ';
          vBuscasTmp.ParamByName('codigo_faturamento').AsInteger := vCliente.Barramento.vCodigoDesbarrado;
          vBuscasTmp.Open;

          if vBuscasTmp.IsEmpty then
          begin
            if pExibirMensagem then
              Application.MessageBox(PChar(
                'Desbarramento automático ativado. Código ' + IntToStr(vCliente.Barramento.vCodigoDesbarrado) + ' não encontrado no cadastro de tipo de faturamento'),
                'Atenção', 0 + 64);
            Exit;
          end;

          if UpperCase(trim(vBuscasTmp.FieldByName('status_f').AsString)) <> 'ATIVO' then
          begin
            if pExibirMensagem then
              Application.MessageBox(PChar(
                'Desbarramento automático ativado. O status do código do tipo de faturamento ' + IntToStr(vCliente.Barramento.vCodigoDesbarrado) + ' deve ser ATIVO'),
                'Atenção', 0 + 64);
            Exit;
          end;

          if vBuscasTmp.FieldByName('ativo').AsInteger <> 1 then
          begin
            if pExibirMensagem then
              Application.MessageBox(PChar(
                'Desbarramento automático ativado. O código do tipo de faturamento  ' + IntToStr(vCliente.Barramento.vCodigoDesbarrado) + ' esta na lixeira'),
                'Atenção', 0 + 64);
            Exit;
          end;
        end;
      end;

//      if (vCliente.Barramento.vBarraAutomaticamenteAposVencCrediario = 'S') or (vCliente.Barramento.vDesbarraAutomaticamenteAposQuitCrediario = 'S') then
//        if vEmp.vUsarBarramento = 'S' then
//        begin
//        	if (pCodCliente = 0) and (trim(pCpfCnpj) = '') then
//  					Application.MessageBox('Usar barramento automático da empresa habilitado, favor verificar antes de continuar.', 'Atenção', MB_ICONWARNING + MB_OK);
//          Exit;
//        end;

  	  if vCliente.Barramento.vBarraAutomaticamenteAposVencCrediario = 'S' then
      begin
      	vInibeMensPesqPros := 'S';
        if not PesqPros('CLI276', 'BARRAR - AUT', '', 'CLIENTES', '', vBuscasTmp2, true) then
          Exit;

	      try
  				vDadosIni.abreStatusProcessamento('', 'Aguarde. Consultando cliente(s) NÃO BARRADO(S) com crediário(s) vencido(s)');

          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select * from sp_negativar_desnegativar_cl ' +
            ' (:pcpfcgc, :pcod_cliente, :pcod_empresa, :pbarrado, :pfinanc_dia_atual, :pdata_atual, :pdia_financ, :pdata_venc_ini) ';
          vBuscasTmp.ParamByName('pcpfcgc').AsString := pCpfCnpj;
          vBuscasTmp.ParamByName('pcod_cliente').AsInteger := pCodCliente;
          vBuscasTmp.ParamByName('pcod_empresa').AsInteger := StrToInt(codEmpresa);
          vBuscasTmp.ParamByName('pbarrado').AsInteger := 0;
          vBuscasTmp.ParamByName('pfinanc_dia_atual').AsString := vCliente.Barramento.vUsarDataAtualDataFinanceiro;
          vBuscasTmp.ParamByName('pdata_atual').AsDateTime := vDataAtual;
          vBuscasTmp.ParamByName('pdia_financ').AsDateTime := diaFFinanceiro + 1;
          vBuscasTmp.ParamByName('pdata_venc_ini').AsDateTime := StrToDate(vCliente.Barramento.vDataVencimentoBase);
          vBuscasTmp.Open;
          vBuscasTmp.FetchAll;
        finally
          vDadosIni.fechaStatusProcessamento;
        end;

        if not vBuscasTmp.IsEmpty then
        begin
          try
            vDadosIni.abreStatusProcessamento('', 'Barrar cliente (Negativar)');

            vBuscasTmp.First;
            while not vBuscasTmp.Eof do
            begin
              vCodCliente := vBuscasTmp.FieldByName('COD_CLIENTE').AsInteger;
              vCpf        := trim(vBuscasTmp.FieldByName('CPFCGC').AsString);
              vStatus_f   := trim(vBuscasTmp.FieldByName('STATUS_F').AsString);

              if (vCodCliente > 0) or (trim(vCpf) <> '') then
              begin
                if UpperCase(trim(vStatus_f)) <> 'BARRADO' then
              	begin
                  vDadosIni.abreStatusProcessamento('',
                    'Barrar cliente(s) (Negativar) (' + IntToStr(vBuscasTmp.RecNo) + '/' + IntToStr(vBuscasTmp.RecordCount) + ')');

                  if ((vEmp.vFinanceiroUnificado) and (trim(vCpf) <> ''))
                    or ((not vEmp.vFinanceiroUnificado) and (vCodCliente > 0)) then
                  begin
                    vBuscasTmp2.Close;
                    vBuscasTmp2.SQL.Text := ' update clientes SET rep_int_active = 1, ' +
                      ' codigo_faturamento = ' + IntToStr(vCliente.Barramento.vCodigoBarrado);

                    if vEmp.vFinanceiroUnificado then
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' where cpfcgc = ' + QuotedStr(trim(vCpf))
                    else
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' where cod_cliente = ' + IntToStr(vCodCliente);

                    if (vEmp.vFinanceiroUnificado) and (trim(vEmp.vCodigoUnificadas) <> '')  then
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' and cod_empresa in ' + vEmp.vCodigoUnificadas
                    else
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' and cod_empresa = ' + vDadosIni.codEmpresa;

                    vBuscasTmp2.ExecSQL;
                  end;

                  if (not vEmp.vFinanceiroUnificado) and (vcl_hab_faturamento_unico_entre_empresas) then
                  begin
                    if trim(vCpf) <> '' then
                    begin
                      if vList.Count > 1 then
                      begin
                        vList[2] := StringReplace(UpperCase(vList[2]), 'EMPRESAS:', '', [rfReplaceAll]);

                        vBuscasTmp2.Close;
                        vBuscasTmp2.SQL.Text := ' select cod_empresa from empresa ' +
                          ' where cod_empresa <> :cod_empresa ';
                        vBuscasTmp2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
                        vBuscasTmp2.Open;
                        vBuscasTmp2.FetchAll;

                        vBuscasTmp2.First;
                        while not vBuscasTmp2.Eof do
                        begin
                          if ((Pos('|' + IntToStr(vBuscasTmp2.FieldByName('cod_empresa').AsInteger) + '|', trim(vList[2])) > 0)
                            or (trim(vList[2]) = '')) then
                          begin
                            vDadosIni.abreStatusProcessamento('', 'Replicando para outras empresas');

                            vBuscasTmp3.Close;
                            vBuscasTmp3.SQL.Text := ' update clientes set codigo_faturamento = :codigo_faturamento' +
                              ' where cpfcgc = :cpfcgc ' +
                              ' and cod_empresa = :cod_empresa ';
                            vBuscasTmp3.ParamByName('cpfcgc').AsString := trim(vCpf);
                            vBuscasTmp3.ParamByName('cod_empresa').AsInteger := vBuscasTmp2.FieldByName('cod_empresa').AsInteger;
                            vBuscasTmp3.ParamByName('codigo_faturamento').AsInteger := vCliente.Barramento.vCodigoBarrado;
                            vBuscasTmp3.ExecSQL;
                          end;

                          vBuscasTmp2.Next;
                        end;
                      end;
                    end;
                  end;

                  GravaAuditoria(
                    'CLI276',
                    'BARRAR - AUT',
                    'Cpf/Cnpj: ' + trim(vCpf),
                    'CLIENTES',
                    IntToStr(vCodCliente), vBuscasTmp3);
                end;
              end;

              vBuscasTmp.Next;
            end;

            if vTransTmp.InTransaction then
            begin
              vTransTmp.Commit;
              GravaAuditoria('CLI276', 'BARRAR - AUT', 'SUCESSO', 'CLIENTES', '', vBuscasTmp3);
              Result := True;
            end;
          finally
          	vDadosIni.fechaStatusProcessamento;
          end;
        end;
      end;

      if vCliente.Barramento.vDesbarraAutomaticamenteAposQuitCrediario = 'S' then
      begin
        vInibeMensPesqPros := 'S';
        if not PesqPros('CLI277', 'DESBARRAR - AUT', '', 'CLIENTES', '', vBuscasTmp2, true) then
          Exit;

      	try
          vDadosIni.abreStatusProcessamento('', 'Aguarde. Consultando cliente(s) BARRADO(S) sem crediário(s) vencido(s)');

          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select * from sp_desnegativar_cl ' +
            ' (:pcpfcgc, :pcod_cliente, :pcod_empresa, :pfinanc_dia_atual, :pdata_atual, :pdia_financ, :pdata_venc_ini) ';
          vBuscasTmp.ParamByName('pcpfcgc').AsString := pCpfCnpj;
          vBuscasTmp.ParamByName('pcod_cliente').AsInteger := pCodCliente;
          vBuscasTmp.ParamByName('pcod_empresa').AsInteger := StrToInt(codEmpresa);
          vBuscasTmp.ParamByName('pfinanc_dia_atual').AsString := vCliente.Barramento.vUsarDataAtualDataFinanceiro;
          vBuscasTmp.ParamByName('pdata_atual').AsDateTime := vDataAtual;
          vBuscasTmp.ParamByName('pdia_financ').AsDateTime := diaFFinanceiro + 1;
          vBuscasTmp.ParamByName('pdata_venc_ini').AsDateTime := StrToDate(vCliente.Barramento.vDataVencimentoBase);
          vBuscasTmp.Open;
          vBuscasTmp.FetchAll;
        finally
          vDadosIni.fechaStatusProcessamento;
        end;

        if not vBuscasTmp.IsEmpty then
        begin
          try
            vDadosIni.abreStatusProcessamento('', 'Desbarrar cliente (Remover Negativação)');

            vBuscasTmp.First;
            while not vBuscasTmp.Eof do
            begin
              vCodCliente := vBuscasTmp.FieldByName('COD_CLIENTE').AsInteger;
              vCpf        := trim(vBuscasTmp.FieldByName('CPFCGC').AsString);
              vStatus_f   := trim(vBuscasTmp.FieldByName('STATUS_F').AsString);

              if (vCodCliente > 0) or (trim(vCpf) <> '') then
              begin
                if UpperCase(trim(vStatus_f)) = 'BARRADO' then
              	begin
                  vDadosIni.abreStatusProcessamento('',
                    'Desbarrar cliente(s) (Remover Negativação) (' + IntToStr(vBuscasTmp.RecNo) + '/' + IntToStr(vBuscasTmp.RecordCount) + ')');

                  if ((vEmp.vFinanceiroUnificado) and (trim(vCpf) <> ''))
                    or ((not vEmp.vFinanceiroUnificado) and (vCodCliente > 0)) then
                  begin
                    vBuscasTmp2.Close;
                    vBuscasTmp2.SQL.Text := ' update clientes SET rep_int_active = 1, ' +
                      '	codigo_faturamento = ' + IntToStr(vCliente.Barramento.vCodigoDesbarrado);

                    if vEmp.vFinanceiroUnificado then
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' where cpfcgc = ' + QuotedStr(trim(vCpf))
                    else
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' where cod_cliente = ' + IntToStr(vCodCliente);

                    if (vEmp.vFinanceiroUnificado) and (trim(vEmp.vCodigoUnificadas) <> '')  then
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' and cod_empresa in ' + vEmp.vCodigoUnificadas
                    else
                      vBuscasTmp2.SQL.Text := vBuscasTmp2.SQL.Text +
                        ' and cod_empresa = ' + vDadosIni.codEmpresa;

                    vBuscasTmp2.ExecSQL;
                  end;

                  if (not vEmp.vFinanceiroUnificado) and (vcl_hab_faturamento_unico_entre_empresas) then
                  begin
                    if trim(vCpf) <> '' then
                    begin
                      if vList.Count > 1 then
                      begin
                        vList[2] := StringReplace(UpperCase(vList[2]), 'EMPRESAS:', '', [rfReplaceAll]);

                        vBuscasTmp2.Close;
                        vBuscasTmp2.SQL.Text := ' select cod_empresa from empresa ' +
                          ' where cod_empresa <> :cod_empresa ';
                        vBuscasTmp2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
                        vBuscasTmp2.Open;
                        vBuscasTmp2.FetchAll;

                        vBuscasTmp2.First;
                        while not vBuscasTmp2.Eof do
                        begin
                          if ((Pos('|' + IntToStr(vBuscasTmp2.FieldByName('cod_empresa').AsInteger) + '|', trim(vList[2])) > 0)
                            or (trim(vList[2]) = '')) then
                          begin
                            vDadosIni.abreStatusProcessamento('', 'Replicando para outras empresas');

                            vBuscasTmp3.Close;
                            vBuscasTmp3.SQL.Text := ' update clientes set codigo_faturamento = :codigo_faturamento' +
                              ' where cpfcgc = :cpfcgc ' +
                              ' and cod_empresa = :cod_empresa ';
                            vBuscasTmp3.ParamByName('cpfcgc').AsString := trim(vCpf);
                            vBuscasTmp3.ParamByName('cod_empresa').AsInteger := vBuscasTmp2.FieldByName('cod_empresa').AsInteger;
                            vBuscasTmp3.ParamByName('codigo_faturamento').AsInteger := vCliente.Barramento.vCodigoDesbarrado;
                            vBuscasTmp3.ExecSQL;
                          end;

                          vBuscasTmp2.Next;
                        end;
                      end;
                    end;
                  end;

                  GravaAuditoria(
                    'CLI277',
                    'DESBARRAR - AUT',
                    'Cpf/Cnpj: ' + trim(vCpf),
                    'CLIENTES',
                    IntToStr(vCodCliente), vBuscasTmp3);
                end;
              end;

              vBuscasTmp.Next;
            end;

            if vTransTmp.InTransaction then
            begin
              vTransTmp.Commit;
              GravaAuditoria('CLI277', 'DESBARRAR - AUT', 'SUCESSO', 'CLIENTES', '', vBuscasTmp3);
              Result := True;
            end;
          finally
            vDadosIni.fechaStatusProcessamento;
          end;
        end;
      end;

    finally
    	if Assigned(vList) then
    		FreeAndNil(vList);
    end;

  except
    on E: exception do
    begin
      Result := False;
      vDadosIni.fechaStatusProcessamento;
      registraErro('function TSingleton.negativarClientes. Erro: ' + e.Message);
      Application.MessageBox(pchar('Erro ao Negativar/Desnegativar cliente. Erro: ' + E.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TSingleton.BmpToJpg(FileName: string): string;
var
  Jpg: TJpegImage;
  Stm: TMemoryStream;
  Bmp: TBitmap;
begin
	try
    try
      Result := FileName;

      if not DirectoryExists(ExtractFileDir(FileName)) then
      begin
        Application.MessageBox(PChar('Diretório não encontrado: ' + #13 +
        	ExtractFileDir(FileName)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not FileExists(FileName) then
      begin
        Application.MessageBox(PChar('Arquivo não encontrado: ' + #13 +
        	FileName), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      Bmp := TBitmap.Create;
      Bmp.LoadFromFile(FileName);
      Jpg := TJpegImage.Create;
      Jpg.Assign(Bmp);
      Jpg.Compress;
      Stm := TMemoryStream.Create;
      Jpg.SaveToStream(Stm);
      Stm.Position := 0;
      Stm.SaveToFile(ChangeFileExt(FileName, '.jpg'));
      Stm.Free;
      Jpg.Free;
      Bmp.Free;

    except on E: Exception do
      begin
        Application.MessageBox(pchar(
        	'Falha ao converter BMP para JPG:' + #13 + #13 +
        	'ARQUIVO' + #13 +
          FileName + #13 + #13 +
          'Erro: ' + e.Message), pchar('Erro'), MB_ICONERROR + MB_OK);
        registraErro('Falha ao converter BMP para JPG' + E.Message);
        Result := FileName;
      end;
    end;

  finally
  	if FileExists(ChangeFileExt(FileName, '.jpg')) then
    begin
    	Result := ChangeFileExt(FileName, '.jpg');

      if FileExists(FileName) then
        DeleteFile(PChar(FileName));
    end;
  end;
end;

function TSingleton.buscarClasseProgFidelidade(pDesc: string;
  pbuscas: TIBQuery): boolean;
begin
  SqlOpen('select rf.descricao_regra, cf.valor_vc, ' +
   ' cf.condicao_ini, cf.condicao_fim, cf.valor_f_ini, cf.valor_f_fim, cf.perc_dia_real, ' +
   ' cf.cod_tp_regra, cf.descricao_config, cf.pontos, ' +
   ' cf.grupo_prod, cf.cod_prod from config_regras_prog_fidelidade cf ' +
   ' inner join regras_prog_fidelidade rf on rf.cod_tp_regra = cf.cod_tp_regra  and rf.cod_empresa = cf.cod_empresa ' +
   ' where cf.cod_empresa = ' + codEmpresa + ' and rf.situacao = ''ATIVA'' ' +
   ' and rf.descricao_regra = ' + QuotedStr(pDesc) +
   ' order by 1, 2 ', pbuscas).FetchAll;

  Result := not pbuscas.IsEmpty;
end;

procedure TSingleton.buscarConfigHwCloud;
var
  Con: TConexao;
begin
  Con := TConexao.Create(dtmAtivo.bancoHw);
  try
    if trim(retornaDadosHwCloudIA(Con.QrAux, True)) = '' then
      Exit;

    hwc_buscar_config(
      Format(';databaseName=%s;empresaid=%s;silent=false;userHW=HW;userLevel=10',
             [vBancoHW, codEmpresa]));
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

function TSingleton.buscarMascaraFone(pCampo, pValor: string): string;
var
 I: Integer;
begin
  Result := '';
  if Trim(pCampo) = '' then
  begin
    if Length(Trim(apenasNumeros(pValor))) = 10 then
      Result := '(99) 9999-99999;0;_'
    else if Length(Trim(pValor)) = 11 then
      Result := '(99) 99999-99999;0;_'
    else
      Result := '';
    Exit;
  end;
  for I := 0 to Length(MascarasEstados) - 1 do
  begin
    if ((trim(pCampo) = 'CODIGO_UF') or (trim(pCampo) = 'UF_TR') or (trim(pCampo) = 'UF_EMP'))
     and (trim(pValor) = trim(getCampoPipe(MascarasEstados[I], 1))) then
    begin
      Result := trim(getCampoPipe(MascarasEstados[I], 3));
      Break;
    end
    else if (trim(pCampo) = 'ESTADO')
    and (trim(pValor) = trim(getCampoPipe(MascarasEstados[I], 2))) then
    begin
      Result := trim(getCampoPipe(MascarasEstados[I], 3));
      Break;
    end;
  end;
  if (Length(MascarasEstados) > 0) and (Result = '') then
    Result := '(99) 9999-9999;0;_';
end;

function TSingleton.buscarProduto(ANumFab: string; AGrupoProd: Integer;
  ACodProd: string; ACodGrade: Integer; ADescrProd: string; ATransaction: TIBTransaction): boolean;
var
  AProcedure: TbuscarProduto;
  ATransactionRescue: TIBTransaction;
  AUseTransacionIni: Boolean;
begin
  try
    if (Assigned(ATransaction)) and     // transacao do parametro
       (Assigned(vTransactionTmp)) then // transacao do dadosini
      ATransactionRescue := vTransactionTmp; // transacao para recuperar no finally

    if vPedVnd.AHandle = 0 then
      CarregaPacote('pkPedidoVenda', vPedVnd.AHandle);

    if vPedVnd.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Pedido de Venda não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vPedVnd.AHandle, 'buscarProduto');
    if Assigned(AProcedure) then
    begin
      if Assigned(ATransaction) then
      begin
        vTransactionTmp := ATransaction;
        AUseTransacionIni := True;
      end
      else
        AUseTransacionIni := False;
      Result := AProcedure(ANumFab, AGrupoProd, ACodProd, ACodGrade, ADescrProd, AUseTransacionIni);
    end;
  finally
    if Assigned(ATransactionRescue) then
      vTransactionTmp := ATransactionRescue;
  end;
end;

