function TSingleton.GetIni(pChave, pIdentificador, pValorDefault: string;
  IniText: TStrings): string;
var
//  ArqIni: string;
//  ArqConfig: TIniFile;
//  vPath: array[0..MAX_PATH] of char;
  I: Integer;
  ChaveAtiva, IdentificadorAtivo: Boolean;
  Chave, Identificador: string;
  ArqConfig: TMemIniFile;
begin
  Result := pValorDefault;
  ArqConfig := TMemIniFile.Create('');
  try
    ArqConfig.SetStrings(IniText);
    Result := ArqConfig.ReadString(pChave, pIdentificador, pValorDefault);
  finally
    FreeAndNil(ArqConfig);
  end;
  Exit;




  Result := pValorDefault;
  try
    Chave := Trim(UpperCase(pChave));
    Identificador := Trim(UpperCase(pIdentificador));
    ChaveAtiva := False;
    IdentificadorAtivo := False;
    for I := 0 to IniText.Count - 1 do
    begin
      if not ChaveAtiva then
        if Pos('[' + Trim(Chave) + ']', UpperCase(Trim(IniText[I]))) = 1 then
          ChaveAtiva := True;

      if ChaveAtiva then
        if Pos('=', IniText[I]) > 0 then
          if Identificador = Trim(UpperCase(Copy(IniText[I], 1, Pos('=', IniText[I]) - 1))) then
          begin
            Result := Trim(IniText[I]);
            Result := Copy(Result, Pos('=', Result) + 1, Length(Result));
          end;
    end;
  except on E: Exception do
    Application.MessageBox(PChar('Erro ao ler configuracao ' +'[' + pChave + '] -> ' + pIdentificador + ' = ' + #13 +
      'Conf abaixo ' + #13 + #13 + IniText.Text + #13 +
      'Erro: ' + E.Message), 'Atenção', 0 + 64);
  end;


  {try
    Result := pValorDefault;
    if IniText = nil then
      raise Exception.Create('IniText não associado');

    GetTempPath(SizeOf(vPath), vPath);
    ArqIni := IncludeTrailingPathDelimiter(String(vPath)) + 'hwtmp.ini';
    IniText.SaveToFile(ArqIni);
    if not FileExists(ArqIni) then
      raise Exception.Create('Sem permissão para salvar na pasta temporária do windows');

    ArqConfig := TIniFile.Create(ArqIni);
    try
      Result := ArqConfig.ReadString(pChave, pIdentificador, pValorDefault);
    finally
      FreeAndNil(ArqConfig);
    end;
  except on E: Exception do
    begin
      Application.MessageBox(PChar('Erro ao ler configuracao. Pasta TEMP: ' + E.Message), 'Atenção', 0 + 64);
    end;
  end;}
end;

