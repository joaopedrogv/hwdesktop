function TSingleton.conectaBanco(banco: TIBDatabase; endereco: string;
  mostrarErro: boolean): Boolean;
begin
  try
    fdbUsuario := string(__getUsuarioFDB);
    fdbSenha := string(__getSenhaFDB);
    banco.ForceClose;
    banco.Connected := false;

    if (Trim(fdbUsuario) <> '') then
      banco.Params[0] := 'user_name=' + string(__descriptografaTextoFDB(Pchar(fdbUsuario)));
    if (Trim(fdbSenha) <> '') then
      banco.Params[1] := 'password=' + string(__descriptografaTextoFDB(Pchar(fdbSenha)));

    banco.DatabaseName := endereco;
    try
      banco.Connected := true;
    except on e: exception do
      begin
        result := false;
        if mostrarErro then
          Application.MessageBox(pchar('Erro ao conectar com o banco : ' + endereco + #13 +
            'Erro: E0020' + e.Message), pchar('Erro'), MB_ICONERROR + MB_OK);
        registraErro('Erro: E0020' + e.Message);
      end;
    end;
  finally
    Result := banco.Connected;
  end;
end;

