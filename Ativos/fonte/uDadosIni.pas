  function getDevolucao(query: TIBQuery): TDevolucaoProgFid;
  var
   buscasTemp: TIBQuery;
   I: Integer;
  begin
    try
      buscasTemp := TIBQuery.Create(Application);
      buscasTemp.Database := pbuscas.Database;
      buscasTemp.Transaction := pbuscas.Transaction;

      Result := TDevolucaoProgFid.Create;
      Randomize;
      with Result do
      begin
         coddev := query.FieldByName('ndoc').AsInteger;
         tipodev := trim(query.FieldByName('tipo_dev').AsString);
         data := FormatDateTime('dd/mm/yyyy', query.FieldByName('data').AsDateTime);
         valor_dev := query.FieldByName('valor_dev').AsFloat;

         if trim(ptipo) = 'DEVV' then
           SqlOpen(' select nfi.cod_estmoto codigo, nfi.chassi, nfv.placa, ' +
            ' nfv.descricao_versao descricao, nfi.valor_total from notafiscal_item nfi ' +
            ' inner join notafiscal_item_veiculo nfv on nfv.cod_nf = nfi.cod_nf and nfv.cod_empresa = nfi.cod_empresa and nfv.nitem = nfi.nitem ' +
            ' where nfi.cod_nf = ' + IntToStr(coddev) +
            ' and nfi.cod_empresa = ' + codEmpresa +
            ' order by nfi.nitem ', buscasTemp).FetchAll
         else
           SqlOpen(' select dev.grupo_prod, dev.cod_prod, dev.cod_grade, ' +
            ' dev.descricao, (dev.quant * dev.valor) valor_total from devolucao dev ' +
            ' where dev.sequencia = ' + IntToStr(coddev) +
            ' and dev.cod_empresa = ' + codEmpresa +
            ' order by dev.seqid ', buscasTemp).FetchAll;

         if buscasTemp.RecordCount > 0 then
         begin
           SetLengthItens(buscasTemp.RecordCount);
           buscasTemp.First;
           for I := Low(Itens) to High(Itens) do
           begin
             Itens[I] := getItemDevolucao(buscasTemp, I + 1);
             buscasTemp.Next;
           end;
           buscasTemp.First;
         end;
      end;
    finally
       if Assigned(buscasTemp) then
         FreeAndNil(buscasTemp);
     end
  end;

