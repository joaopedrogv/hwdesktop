function TSingleton.GetRTFFormat(DataObject: IDataObject;
  var RTFFormat: TFormatEtc): Boolean;
var
  Formats: IEnumFORMATETC;
  TempFormat: TFormatEtc;
  pFormatName: PChar;
  Found: Boolean;
begin
  try
    OleCheck(DataObject.EnumFormatEtc(DATADIR_GET, Formats));
    Found := False;
    while (not Found) and (Formats.Next(1, TempFormat, nil) = S_OK) do
    begin
      pFormatName := AllocMem(255);
      GetClipBoardFormatName(TempFormat.cfFormat, pFormatName, 254);
      if (string(pFormatName) = 'Rich Text Format') then
      begin
        RTFFormat := TempFormat;
        Found := True;
      end;
      FreeMem(pFormatName);
    end;
    Result := Found;
  except
    Result := False;
  end;
end;

function TSingleton.getTerminalADM(pQuery: TIBQuery; pTodos: Boolean): string;
var
  vTerminalF: Integer;
begin
  try
    vTerminalF := retornoPorCondicao( StrToIntDef(vCodTerminal, 0) > 0,
        StrToIntDef(vCodTerminal, 0),
        StrToIntDef(Trim(GetIni('TEF', 'TerminalF', '0')), 0));

    SqlOpen('select t.cod_term_adm from adm_cartao a' +
            ' inner join terminal_cartao t on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
            ' inner join adm_cartao_redes ar on a.cod_adm = ar.cod_adm and a.cod_empresa = ar.cod_empresa' +
            ' where %s a.cod_empresa = %d and t.tipo = ''D'' and ar.rede = %s',
            [StrUtils.IfThen((vTerminalF > 0) and (not pTodos), 't.cod_terminalf = ' + IntToStr(vTerminalF) + ' and '),
             cod_empresa, QuotedStr(Trim(vPOSV.retornoREDE))], pQuery).FetchAll;
    {
    if vTerminalF > 0 then
      SqlOpen('select first 2 t.cod_term_adm, a.descricao_adm, t.desc_term_adm from adm_cartao a' +
              ' inner join terminal_cartao t on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
              ' where t.cod_terminalf = %d and a.cod_empresa = %d and t.tipo = ''D''' ,
              [vTerminalF, cod_empresa], pQuery).FetchAll;

    if (not pQuery.Active) or (pQuery.RecordCount = 0) then    
      SqlOpen('select first 2 t.cod_term_adm, a.descricao_adm, t.desc_term_adm from adm_cartao a' +
              ' inner join terminal_cartao t on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
              ' where a.cod_empresa = %d and t.tipo = ''D''' ,
              [cod_empresa], pQuery).FetchAll;

    if pQuery.RecordCount = 1 then
    begin
      Result := pQuery.FieldByName('cod_term_adm').AsString;
      Exit;
    end;

    pQuery.Close;
    pQuery.SQL.Text :=
      'select t.cod_term_adm, a.descricao_adm, t.desc_term_adm from adm_cartao a' +
      ' inner join terminal_cartao t on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
      ' where a.redes like ''%|''||' + QuotedStr(Trim(vPOSV.retornoREDE)) +
      '||''|%'' and a.cod_empresa = :cod_empresa and t.tipo = ''D''';
    if (vTerminalF > 0) and (not pTodos) then
    begin
      pQuery.SQL.Text := pQuery.SQL.Text + ' and t.cod_terminalf = :cod_terminalf';
      pQuery.ParamByName('COD_TERMINALF').AsInteger := vTerminalF;
    end;
    pQuery.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(codEmpresa, 0);
    pQuery.Open;
    pQuery.FetchAll;
    }

    if (pQuery.RecordCount = 1) and (not pTodos) then
      Result := pQuery.FieldByName('cod_term_adm').AsString
    else
    begin
      try

        vPesquisa := '';
        Result := '';
        while Trim(Result) = '' do
        begin
          selecionaTerminalNaoEncontradoPOSVirtual;
          Result := vPesquisa;
        end;
      finally
        vPesquisa := '';
      end;
    end;
  except
    Result := '';
  end;
end;

