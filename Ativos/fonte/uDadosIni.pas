function TSingleton.criarExcel2(var pExcel: Variant; DBGrid: TDBGrid;
  vNomePlanilha, pNameSheet: string; pContinuarNoSheet: boolean): boolean;
var
  I, J,vSheet: Integer;
  vtemp: string;
  vExisteSheet:boolean;
begin
  try
    if VarIsEmpty(pExcel) then
      pExcel := CreateOleObject('Excel.Application');
    Result := True;
  except
    Result := False;
    Application.MessageBox ('Versão do Microsoft Office Excel Incompatível','Erro',MB_OK+MB_ICONEXCLAMATION);
    exit;
  end;
  try
    if pExcel.Workbooks.count<1 then
      pExcel.Workbooks.add;

    vExisteSheet:=false;
    for I := 1 to pExcel.Workbooks[1].Sheets.count do
      if pExcel.Workbooks[1].WorkSheets[i].Name = pNameSheet  then
      begin
        vSheet:= i;
        vExisteSheet:=true;
        if not pContinuarNoSheet then
        begin
          vSheet:= 1;
          pExcel.Workbooks[1].Sheets.Add;
          if trim(pNameSheet)<>'' then
            pNameSheet:= pNameSheet+' '+StrZero(inttostr(pExcel.Workbooks[1].Sheets.count),2);

          pExcel.Workbooks[1].WorkSheets[1].Name := pNameSheet;
          Sheet := pExcel.Workbooks[1].WorkSheets[pNameSheet]
        end;
        break;
      end;
    if not vExisteSheet then
    begin
      vSheet:= 1;
      if not pContinuarNoSheet then
      begin
        pExcel.Workbooks[1].Sheets.Add;
        if pNameSheet='' then
          pNameSheet:= 'Plan0'+inttostr(pExcel.Workbooks[1].Sheets.count);
        pExcel.Workbooks[1].WorkSheets[1].Name := pNameSheet;
        Sheet := pExcel.Workbooks[1].WorkSheets[pNameSheet];
      end;
    end;

    sheet := pExcel.Workbooks[1].sheets[vSheet];
    sheet.activate;
    j := pExcel.ActiveCell.Row;
    if j>1 then
     inc(j,2);
    sheet.cells[j, 01] := vNomePlanilha;
    sheet.cells[j, 01].Font.Size := 12;
    sheet.cells[j, 01].Font.Bold := True;
    inc(j);
    for I := 1 to DBGrid.Columns.Count do
      if DBGrid.Columns[I - 1].Visible then
      begin
        vtemp := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).DisplayName;
        sheet.cells[j, I] := vtemp;
//          sheet.cells[j, 01].Font.Bold := True;
        sheet.cells[j, I].Interior.Color := $00FFCF9C;
      end;
    sheet.Cells.SpecialCells($0000000B, EmptyParam).Activate;
  except
  end;
end;

