function TSingleton.RetornaDataHoraVenc(pQuery: TIBQuery; pPosicao, pTipoRes, pGrupoCotaRd: string; pDataRes: TDateTime; pHoraRes: string;
  pDataAssembleia: TDateTime; var vTipoRes, vGrupoCotaRd, vDataVenc, vHoraVenc, vDataAssembleia: Variant): boolean;
begin
  Result := True;

  if (trim(pPosicao) = 'FILA') or (trim(pPosicao) = 'TRANSITO') then
  begin
    pQuery.Close;
    pQuery.SQL.Text := ' SELECT * FROM TIPO_RESERVA RES ' +
     ' WHERE RES.TIPO = ''VEI'' AND RES.TIPO_RES = :TIPO_RES ';
    pQuery.ParamByName('TIPO_RES').AsString := Copy(trim(pPosicao), 1, 1);
    pQuery.Open;

    if (pQuery.IsEmpty) or (pQuery.FieldByName('QUANT_DIAS_RESERVA').AsInteger <= 0) then
    begin
    	vDataVenc := Null;
      vHoraVenc := Null;
    end
    else if (trim(pPosicao) = 'FILA') or (trim(pPosicao) = 'TRANSITO') then
    begin
      vDataVenc := DateToStr(pDataRes + pQuery.FieldByName('QUANT_DIAS_RESERVA').AsInteger);
      vHoraVenc := pHoraRes;
    end;
  end;

  pQuery.Close;
  pQuery.SQL.Text := ' SELECT * FROM TIPO_RESERVA RES ' +
   ' WHERE RES.TIPO = ''VEI'' AND RES.SIGLA = :SIGLA ';
  pQuery.ParamByName('SIGLA').AsString := trim(pTipoRes);
  pQuery.Open;

  if pQuery.IsEmpty then
  begin
    vDataVenc := Null;
    vHoraVenc := Null;
    Result := False;
    exit;
  end;

  vTipoRes := pQuery.FieldByName('TIPO_RES').AsString;
  if pDataRes > 0 then
  begin
    if (vTipoRes = 'V') or  (vTipoRes = 'B') or (vTipoRes = 'M') then
    begin
      if (trim(pPosicao) <> 'FILA') and (trim(pPosicao) <> 'TRANSITO') then
      begin
        vDataVenc := DateToStr(pDataRes + pQuery.FieldByName('QUANT_DIAS_RESERVA').AsInteger);
        vHoraVenc := pHoraRes;
      end;
      vGrupoCotaRd := Null;
      vDataAssembleia := Null;
    end
    else //if (vTipoRes = 'C') then
    begin
      if pDataAssembleia > 0 then
      begin
        if (trim(pPosicao) <> 'FILA') and (trim(pPosicao) <> 'TRANSITO') then
        begin
          if pDataRes >  pDataAssembleia then
            vDataVenc := DateToStr(pDataRes + pQuery.FieldByName('QUANT_DIAS_RESERVA_ASS').AsInteger)
          else
            vDataVenc := DateToStr(pDataAssembleia + pQuery.FieldByName('QUANT_DIAS_RESERVA_ASS').AsInteger);
	        vHoraVenc := pHoraRes;
        end;
        vGrupoCotaRd := pGrupoCotaRd;
        vDataAssembleia := DateToStr(pDataAssembleia);
      end
      else
      begin
        if pQuery.FieldByName('QUANT_DIAS_RESERVA').AsInteger > 0 then
        begin
          if (trim(pPosicao) <> 'FILA') and (trim(pPosicao) <> 'TRANSITO') then
          begin
            vDataVenc := DateToStr(pDataRes + pQuery.FieldByName('QUANT_DIAS_RESERVA').AsInteger);
            vHoraVenc := pHoraRes;
          end;
        end
        else
        begin
          vDataVenc := Null;
          vHoraVenc := Null;
        end;
        vGrupoCotaRd := pGrupoCotaRd;
        vDataAssembleia := Null;
      end;
    end;
  end;
end;

function TSingleton.retornaDescricaoTipoNumConta(pNatureza,
  pTipo: string): string;
begin
  if pNatureza = 'S' then
  begin
    if pTipo = 'D' then
    	 Result := 'DESPESA'
    else if pTipo = 'F' then
	    Result := 'FORNECEDOR'
    else if pTipo = 'I' then
	    Result := 'IMPOSTOS'
    else if pTipo = 'P' then
	    Result := 'FOLHA DE PAGAMENTO'
    else if pTipo = 'O' then
	    Result := 'OUTRAS SAIDAS'
    else if pTipo = 'Z' then
       Result := 'CORRECAO DE SALDO'
    else
