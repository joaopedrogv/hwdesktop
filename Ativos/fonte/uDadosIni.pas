procedure TSingleton.retornaWhatsApp(
	pOrigemEnv: TOrigemEnv;
  pCodCliente: Integer;
  pCheckListContatoWhatsApp: TCheckListBox;
  pTodos: boolean);
var
	Con: TConexao;
	vDadosKentro: string;
	vListaWhatsAppBol: TStringList;
  J: Integer;
begin
  Con := TConexao.Create(dtmAtivo.bancoHw);

	try
    try
      vDadosKentro := retornaDadosKentro(Con.QrAux, False);
    if trim(vDadosKentro) = '' then
      exit;

    vListaWhatsAppBol := TStringList.Create;

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' select id_tipo, tipo, fone, id_contato, env ' +
      ' from sp_contatos_clientes(:cod_cliente, :cod_empresa, :origem) ' +
      ' order by env desc, tipo ';
      Con.QrAux.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
      Con.QrAux.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.ParamByName('ORIGEM').AsString := OrigemEnvStr[pOrigemEnv];
      Con.QrAux.Open;

    vListaWhatsAppBol.Clear;
      Con.QrAux.First;
      while not Con.QrAux.Eof do
    begin
    	if pTodos then
        vListaWhatsAppBol.Add(
            trim(Con.QrAux.FieldByName('env').AsString) + '|' +
            trim(Con.QrAux.FieldByName('fone').AsString) + '|' +
            StringReplace(trim(Con.QrAux.FieldByName('tipo').AsString), '|', ' ', [rfReplaceAll, rfIgnoreCase]) + '|' +
            IntToStr(Con.QrAux.FieldByName('id_contato').AsInteger) + '|')
        else if trim(Con.QrAux.FieldByName('env').AsString) = 'S' then
      	vListaWhatsAppBol.Add(
            trim(Con.QrAux.FieldByName('env').AsString) + '|' +
            trim(Con.QrAux.FieldByName('fone').AsString) + '|' +
            StringReplace(trim(Con.QrAux.FieldByName('tipo').AsString), '|', ' ', [rfReplaceAll, rfIgnoreCase]) + '|' +
            IntToStr(Con.QrAux.FieldByName('id_contato').AsInteger) + '|');

        Con.QrAux.Next;
    end;

    pCheckListContatoWhatsApp.Clear;
    for J := 0 to vListaWhatsAppBol.Count - 1 do
    begin
      pCheckListContatoWhatsApp.Items.Add(
        getCampoPipe(trim(vListaWhatsAppBol[J]), 2) + '|' +
        getCampoPipe(trim(vListaWhatsAppBol[J]), 3) + '|' +
        getCampoPipe(trim(vListaWhatsAppBol[J]), 4) + '|'
      );
      if getCampoPipe(trim(vListaWhatsAppBol[J]), 1) = 'S' then
        pCheckListContatoWhatsApp.Checked[J] := True;
    end;

  except on E: Exception do
    begin
      Application.MessageBox(PChar('Erro ao retorna whatsapp: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao retorna whatsapp: ' + e.Message);
    end;
  end;
  finally
  	if Assigned(Con) then
      FreeAndNil(Con);
end;
end;

