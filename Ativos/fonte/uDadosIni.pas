    else
    begin
    	if vDadosAdicReceb = 'S' then
      	pCombobox.Enabled := False
      else
    		pCombobox.Enabled := True;

      pBuscas.First;
      while not pBuscas.Eof do
      begin
        if trim(pBuscas.FieldByName('UNIDADE').AsString) <> '' then
        begin
        	if pCombobox.Items.IndexOf(UpperCase(trim(pBuscas.FieldByName('UNIDADE').AsString))) = -1 then
