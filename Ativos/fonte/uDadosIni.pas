function TSingleton.getEstoqueDisponivel(pQuery: TIBQuery; pGrupoProd: Integer; pCodProd: String;
  pCodGrade, pNumVenda: Integer; pTipoVenda: string; pCodPedAlmox, pNitemPedAlmox: Integer): Extended;
var
  vSql, vAbaterItens: string;
  vEstoque: Extended;
  vCodVendedor: Integer;
begin
  vEstoque := 0;
  if pCodGrade = 0 then
  begin
    pQuery.Close;
    pQuery.SQL.Text := 'select est_f from produtos' +
      ' where grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and cod_prod = ' + QuotedStr(pCodProd) +
      ' and cod_empresa = ' + codEmpresa;
    pQuery.Open;

    vEstoque := pQuery.FieldByName('est_f').AsFloat;
  end
  else
  begin
    pQuery.Close;
    pQuery.SQL.Text := 'select qtde from cod_grade_prod' +
      ' where grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and cod_prod = ' + QuotedStr(pCodProd) +
      ' and cod_grade = ' + IntToStr(pCodGrade) +
      ' and cod_empresa = ' + codEmpresa;
    pQuery.Open;

    vEstoque := pQuery.FieldByName('qtde').AsFloat;
  end;

  vSql := 'select sum(itpd.quant_ped_item) as pendecia from pedvenda pd' +
    ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo';

  if (vEmp.vAbaterItens = 'S') and (pNumVenda > 0) and (strIn(Trim(pTipoVenda), ['REQ', 'OS'])) then
  begin
    pQuery.Close;
    pQuery.SQL.Text := 'select first 1 coalesce(tv.usar_conferencia_produto, '''') as usar_conferencia_produto, pv.cod_vendedor from pedvenda pv' +
      ' inner join tipo_vendas tv on tv.tipo = pv.tipo and tv.sigla = pv.tipv' +
      ' where pv.nped = ' + IntToStr(pNumVenda) +
      ' and pv.tipo = ' + QuotedStr(pTipoVenda) +
      ' and pv.cod_empresa = ' + codEmpresa +
      ' order by tv.cod_tipo';
    pQuery.Open;
    vAbaterItens := pQuery.FieldByName('usar_conferencia_produto').AsString;
    vCodVendedor := pQuery.FieldByName('cod_vendedor').AsInteger;
    if Trim(vAbaterItens) <> 'S' then
      vSql := vSql + ' inner join tipo_vendas tv on tv.sigla = pd.tipv and tv.tipo = pd.tipo and (coalesce(tv.usar_conferencia_produto, '''') <> ''S'')';
  end;

  vSql := vSql + ' where pd.ativo = 1 and itpd.grupo_prod = :grupo_prod and itpd.cod_prod = :cod_prod' +
    ' and pd.cod_empresa = ' + codEmpresa +
    ' and (pd.data_fech is null or pd.data_fech < :data_fech) and (itpd.status<>''CANCELADO'' or itpd.status is null) ' +
    ' and pd.tipo <> ''ORC''';

  if (vEmp.vAbaterItens = 'S') and (pNumVenda > 0) and (strIn(Trim(pTipoVenda), ['REQ', 'OS'])) and (Trim(vAbaterItens) <> 'S') then
    vSql := vSql + ' and pd.cod_vendedor = ' + IntToStr(vCodVendedor);

//  if vEmp.vApresentarEstR = 'R' then
//    vSql := vSql + ' and pd.tipo = ''REQ'''
//  else if vEmp.vApresentarEstR = 'O' then
//    vSql := vSql + ' and pd.tipo = ''OS'''
//  else
//    vSql := vSql + ' ';

  if pCodGrade > 0 then
    vSql := vSql + ' and itpd.cod_grade = ' + IntToStr(pCodGrade);

  if (pNumVenda > 0) and (strIn(Trim(pTipoVenda), ['REQ', 'OS'])) then
    vSql := vSql + ' and pd.nped = ' + IntToStr(pNumVenda) + ' and pd.tipo = ' + QuotedStr(Trim(pTipoVenda));

  pQuery.Close;
  pQuery.SQL.Text := vSql;
  pQuery.ParamByName('grupo_prod').AsInteger := pGrupoProd;
  pQuery.ParamByName('cod_prod').AsString := pCodProd;
  pQuery.ParamByName('data_fech').AsDate := 0;
  pQuery.Open;

  vEstoque := vEstoque - pQuery.FieldByName('pendecia').AsFloat;

//  if (vEmp.vApresentarEstR = 'P') or (vEmp.vApresentarEstR = 'S') then
//  begin
    pQuery.Close;
    pQuery.SQL.Text := 'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as pendecia from producao pd, producao_item_indice pi' +
      ' where pi.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and pi.cod_prod = ' + QuotedStr(pCodProd) +
      StrUtils.IfThen(pCodGrade > 0, Format(' and pi.cod_grade = %d', [pCodGrade])) +
      StrUtils.IfThen(pTipoVenda = 'PRODUCAO', Format(' and pd.cod_producao <> %d', [pNumVenda])) +
      ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
      ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + codEmpresa;
    pQuery.Open;
    vEstoque := vEstoque - pQuery.FieldByName('pendecia').AsFloat;
//  end;

//  if (vEmp.vAlmox = 'S2') then//and (pCodPedAlmox > 0) and (pNitemPedAlmox > 0)) then//and
    //(vEmp.vApresentarEstR = 'S') or (vEmp.vApresentarEstR = 'R') or (vEmp.vApresentarEstR = 'O') then
  begin
    vSql := 'select sum(coalesce(c.quant,0)) as pendecia from controle_almoxarifado c' +
      ' where not(c.cod_pedido = ' + IntToStr(pCodPedAlmox) +
      ' and c.nitem = ' + IntToStr(pNitemPedAlmox) +
      ') and c.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and c.cod_prod = ' + QuotedStr(pCodProd) +
      ' and c.cod_empresa ='+ codEmpresa;

    if pCodGrade > 0 then
      vSql := vSql + ' and c.cod_grade = ' + IntToStr(pCodGrade);

    pQuery.Close;
    pQuery.SQL.Text := vSql;
    pQuery.Open;
    vEstoque := vEstoque - pQuery.FieldByName('pendecia').AsFloat;
  end;

  Result := vEstoque;
end;

