function TSingleton.inserirContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pTipo: string;
  pContato: string;
  pTelefone: string;
  pEmail: string;
  pIdContato: Integer): boolean;
var
	Con: TConexao;
	vTipoId: Integer;
  vIdContato: Integer;
begin
	Result := False;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      if not PesqPros('CLI255', 'SALVAR', 'CL: ' + IntToStr(pCodCliente), 'CLIENTES_CONTATO', IntToStr(pIdContato), Con.QrAux, True) then
        Exit;

      vTipoId := retornaCodTipoContato(trim(pTipo));

      if vTipoId <= 0 then
      begin
        Application.MessageBox(PChar('Tipo de contato não encontrado: ' + #13 + #13 +
          'TIPO DE CONTATO' + #13 +
          'Descrição: ' + trim(pTipo)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        Exit;
      end;

      if (pIdContato = 0) then
      begin
        if apenasNumeros(trim(pTelefone)) <> '' then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select first 1 id from clientes_contato ' +
                	' where cod_cliente = :cod_cliente ' +
                  ' and cod_empresa = :cod_empresa ' +
            ' and telefone = :telefone ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('telefone').AsString := apenasNumeros(trim(pTelefone));
          Con.QrAux.Open;

          if not Con.QrAux.IsEmpty then
          begin
            Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
              'CONTATO' + #13 +
              'Telefone: ' + apenasNumeros(trim(pTelefone))), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            Exit;
          end;
        end;

        if trim(pEmail) <> '' then
                begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select first 1 id from clientes_contato ' +
            ' where cod_cliente = :cod_cliente ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and email like :email ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('email').AsString := '%' + trim(pEmail) + '%';
          Con.QrAux.Open;

          if not Con.QrAux.IsEmpty then
          begin
            Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
              'CONTATO' + #13 +
              'E-mail: ' + trim(pEmail)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            Exit;
          end;

          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select first 1 cod_cliente from clientes ' +
            ' where cod_cliente = :cod_cliente ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and email like :email ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('email').AsString := '%' + trim(pEmail) + '%';
          Con.QrAux.Open;

          if not Con.QrAux.IsEmpty then
          begin
            Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
              'CONTATO' + #13 +
              'E-mail: ' + trim(pEmail)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            Exit;
          end;
        end;
      end;

      if (pIdContato = 0) then
      begin
        vIdContato := Gencodigo('CLIENTES_CONTATO', Con.QrAux, codEmpresa);

        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' insert into clientes_contato ' +
          ' (id, cod_cliente, cod_empresa, tipo_id, ' + IfThen(trim(pTelefone) <> '', ' telefone, ', '') + IfThen(trim(pEmail) <> '', ' email, ', '') + ' contato) ' +
          ' values (:id, :cod_cliente, :cod_empresa, :tipo_id, ' + IfThen(trim(pTelefone) <> '', ' :telefone, ', '') + IfThen(trim(pEmail) <> '', ' :email,', '') + ' :contato) ';
        Con.QrAux.ParamByName('id').AsInteger := vIdContato;
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('tipo_id').AsInteger := vTipoId;
        if trim(pTelefone) <> '' then
          Con.QrAux.ParamByName('telefone').AsString := apenasNumeros(trim(pTelefone));
        if trim(pEmail) <> '' then
          Con.QrAux.ParamByName('email').AsString := trim(pEmail);
        Con.QrAux.ParamByName('contato').AsString := Copy(UpperCase(trim(pContato)), 1, 32);
        Con.QrAux.ExecSQL;

        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select * from clientes_contato_env ' +
          ' where cod_cliente = :cod_cliente ' +
          ' and cod_empresa = :cod_empresa ' +
          ' and origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + ' :origem_env ' +
          ' and id_contato = :id_contato ';
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[cContrato];
        Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
        Con.QrAux.Open;

        if Con.QrAux.IsEmpty then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' insert into clientes_contato_env ' +
                    ' (cod_cliente, cod_empresa, origem_env, id_contato) ' +
            ' values (:cod_cliente, :cod_empresa, :origem_env, :id_contato) ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigem];
          Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
          Con.QrAux.ExecSQL;
                end;
      end
      else
      begin
        if apenasNumeros(trim(pTelefone)) <> '' then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' update clientes_contato set telefone = :telefone ' +
            ' where id = :id ' +
            ' and cod_empresa = :cod_empresa ';
          Con.QrAux.ParamByName('id').AsInteger := pIdContato;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('telefone').AsString := apenasNumeros(trim(pTelefone));
          Con.QrAux.ExecSQL;
              end;

        if trim(pEmail) <> '' then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' update clientes_contato set email = :email ' +
            ' where id = :id ' +
            ' and cod_empresa = :cod_empresa ';
          Con.QrAux.ParamByName('id').AsInteger := pIdContato;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('email').AsString := trim(pEmail);
          Con.QrAux.ExecSQL;
            end;
          end;

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;

      GravaAuditoria('CLI255', 'SALVAR', 'SUCESSO', 'CLIENTES_CONTATO', IntToStr(pIdContato), Con.QrAux);

      Result := True;
    except on E: Exception do
      begin
        Result := False;
        GravaAuditoria('CLI255', 'INSERIR', 'FALHA', 'CLIENTES_CONTATO', '', Con.QrAux);
        Application.MessageBox(PChar('Erro ao inserir contato cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao inserir contato cliente: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
        end;
    end;
  finally
    if Assigned(Con) then
      FreeAndNil(Con);
  end;
end;

function TSingleton.inserirRemoverContatoEnv(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox): boolean;
var
	Con: TConexao;
	vAplicativo: string;
  vContato: string;
  vIdentificacao: string;
  vIdAplicativo: Integer;
  vIdContato: Integer;
begin
	Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      Result := True;

      if pCheckListContato.ItemIndex < 0 then
        Exit;

      if vHwCloudIA.vUsarServMensageria = 'S' then
        Exit;

      retornaDadosContato(pCheckListContato, vAplicativo, vContato, vIdentificacao);
      vIdAplicativo := retornaCodAplicativo(trim(vAplicativo));
      vIdContato := retornaCodContato(pCodCliente, vIdAplicativo, vContato, vIdentificacao);

      if vIdContato <= 0 then
        Exit;

      if pCheckListContato.Checked[pCheckListContato.ItemIndex] then
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select * from clientes_contato_env ' +
          ' where cod_cliente = :cod_cliente ' +
          ' and cod_empresa = :cod_empresa ' +
          ' and origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + ' :origem_env ' +
          ' and id_contato = :id_contato ';
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[cContrato];
        Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
        Con.QrAux.Open;

        if Con.QrAux.IsEmpty then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' insert into clientes_contato_env ' +
            ' (cod_cliente, cod_empresa, origem_env, id_contato) ' +
            ' values (:cod_cliente, :cod_empresa, :origem_env, :id_contato) ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigem];
          Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
          Con.QrAux.ExecSQL;
      end;
      end
      else
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' delete from clientes_contato_env ' +
          ' where cod_cliente = :cod_cliente ' +
          ' and cod_empresa = :cod_empresa ' +
          IfThen(pOrigem = cContrato,
            ' and origem_env = :origem_env ', '') +
          ' and id_contato = :id_contato ';
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        if pOrigem = cContrato then
          Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigem];
        Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
        Con.QrAux.ExecSQL;
      end;

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;
  except on E: Exception do
    begin
      Result := False;
        Application.MessageBox(PChar('Erro ao inserir contato env cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao inserir contato env cliente: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
    end;
  end;
  finally
  	if Assigned(Con) then
    	FreeAndNil(Con);
end;
end;

function TSingleton.inserirTipoContato(
	pTipo: string;
  pCombobox: TCombobox): Boolean;
var
	Con: TConexao;
  vTipoId: Integer;
	I: Integer;
begin
	Con := TConexao.Create(dtmAtivo.bancoHw);

	try
    try
  	Result := False;

      if not PesqPros('CLI257', 'INSERIR', '', 'TIPO_CONTATO', '', Con.QrAux, True) then
    	Exit;

    pTipo := UpperCase(trim(pTipo));

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' select id, tipo from tipo_contato ' +
      ' where cod_empresa = :cod_empresa ' +
      ' and tipo = :tipo ';
      Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.ParamByName('tipo').AsString := trim(pTipo);
      Con.QrAux.Open;

      if not Con.QrAux.IsEmpty then
    begin
      Application.MessageBox(PChar('Tipo de contato já existe.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

      vTipoId := Gencodigo('TIPO_CONTATO', Con.QrAux, codEmpresa);

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' insert into tipo_contato ' +
        ' (id, cod_empresa, tipo) ' +
        ' values (:id, :cod_empresa, :tipo); ';
      Con.QrAux.ParamByName('id').AsInteger := vTipoId;
      Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.ParamByName('tipo').AsString := trim(pTipo);
      Con.QrAux.ExecSQL;

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' select id, tipo from tipo_contato ' +
      ' where cod_empresa = :cod_empresa ' +
      ' order by tipo ';
      Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.Open;

    pCombobox.Clear;
      Con.QrAux.First;
      while not Con.QrAux.Eof do
    begin
      pCombobox.Items.Add(
          trim(Con.QrAux.FieldByName('tipo').AsString) + '|' +
          IntToStr(Con.QrAux.FieldByName('id').AsInteger) + '|'
      );

        Con.QrAux.Next;
    end;

    for I := 0 to pCombobox.Items.Count - 1 do
      if ContainsText(pCombobox.Items[I], trim(pTipo) + '|') then
      begin
        pCombobox.ItemIndex := I;
        Break;
      end;


      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;

      GravaAuditoria('CLI257', 'INSERIR', 'SUCESSO', 'TIPO_CONTATO', '', Con.QrAux);

    Result := True;
  except on E: Exception do
    begin
      Result := False;
        GravaAuditoria('CLI257', 'INSERIR', 'FALHA', 'TIPO_CONTATO', '', Con.QrAux);
      Application.MessageBox(PChar('Erro ao inserir tipo de contato: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao inserir tipo de contato: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
    end;
  end;
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
end;
end;

