procedure TSingleton.setTClientDataSetCadPadrao(dtSet: TClientDataSet;
  nomeUsuario: string; transacao: TIBTransaction; pAlterarNomeDtSet: string;
  var pGridCfg: TDBGrid; pDBGrid: TDBGrid;
  pcdsGrid: TClientDataSet; var pcdsColunas: TClientDataSet; ptrans: TIBTransaction;
  var pListGridAndDataSets, pListPositions: TStrings; var pnomeDtSet: string;
  var pPrimeiraPesquisa: boolean; var pCamposPadraoRegistro: boolean; var pusuario: string;
  pUtilizarValorDefault: Boolean = False);
var
  I: Integer;
begin
  //Chamar este método em cada formulário no evento onshow depois do datasourse do dbgrid já setado e antes do 'inherited'
  pCamposPadraoRegistro := (GetIni('Sistema', 'CamposPadraoPesquisaNoRegistro', 'N') = 'S');
  pcdsColunas := TClientDataSet(dtSet);
  ptrans := TIBTransaction(transacao);
  pusuario := nomeUsuario;

  if pUtilizarValorDefault then
  begin
    PcdsColunas.Close;
    PcdsColunas.CommandText := ' select * from config_colunas ' +
      ' where usuario = ' + QuotedStr(Pusuario)+
      ' and componente = ' + QuotedStr(pDBGrid.DataSource.DataSet.Name + pAlterarNomeDtSet);
    PcdsColunas.Open;

    if PcdsColunas.IsEmpty then
    begin
      for I := 0 to pDBGrid.Columns.Count - 1 do
      begin
        PcdsColunas.Close;
        PcdsColunas.CommandText := ' select * from config_colunas ' +
          ' where usuario = ' + QuotedStr(Pusuario)+
          ' and componente = ' + QuotedStr(pDBGrid.DataSource.DataSet.Name + pAlterarNomeDtSet) +
          ' and campos = ' + QuotedStr(pDBGrid.DataSource.DataSet.Name + pDBGrid.Columns[I].FieldName);
        PcdsColunas.Open;

        if PcdsColunas.IsEmpty then
        begin
          PcdsColunas.Insert;
          PcdsColunas.FieldByName('visivel').AsInteger          := IfThen(pDBGrid.Columns[I].Visible, 1, 0);
          PcdsColunas.FieldByName('usuario').AsString           := Pusuario;
          PcdsColunas.FieldByName('componente').AsString        := pDBGrid.DataSource.DataSet.Name + pAlterarNomeDtSet;
          PcdsColunas.FieldByName('campos').AsString            := pDBGrid.DataSource.DataSet.Name + pDBGrid.Columns[I].FieldName;
          PcdsColunas.FieldByName('ordem').AsInteger            := pDBGrid.Columns[I].Index;
          PcdsColunas.FieldByName('largura_exibicao').AsInteger := pDBGrid.Columns[I].Width;
          PcdsColunas.Post;

          PcdsColunas.ApplyUpdates(-1);
        end;
      end;

      ptrans.Commit;
      ptrans.StartTransaction;
    end;
  end;

  pcdsGrid := TClientDataSet(pDBGrid.DataSource.DataSet);
  pGridCfg := pDBGrid;
  pcdsColunas.IndexFieldNames := 'ordem';
  setDataSetNameByGridCadPadrao(pGridCfg.Name, pcdsGrid.Name + pAlterarNomeDtSet, False, pListGridAndDataSets);

  pGridCfg.Columns.Clear;
  pGridCfg.Columns.RebuildColumns;
  if pListPositions = nil then
  begin
    pListPositions := TStringList.Create;
    pListPositions.Clear;
  end;

  for I := 0 to pcdsGrid.Fields.Count - 1 do
  begin
    if pListPositions.Count <> pcdsGrid.Fields.Count then
      pListPositions.Add(pcdsGrid.Fields[i].FieldName);

    if pcdsGrid.Fields[i].Tag = 0 then
      pcdsGrid.Fields[i].Visible := True
    else if pcdsGrid.Fields[i].Tag = 1 then
      pcdsGrid.Fields[i].Visible := False
    else if pcdsGrid.Fields[i].Tag = 2 then
      pcdsGrid.Fields[i].Visible := True
    else if pcdsGrid.Fields[i].Tag = 3 then
      pcdsGrid.Fields[i].Visible := False;
  end;
  pPrimeiraPesquisa := True;
  mostraColunasCadPadrao(pDBGrid, pnomeDtSet, pAlterarNomeDtSet);
end;

function TSingleton.Space(tam: integer): string;
var
  res: string;
  i: integer;
begin
  res := '';
  i := 1;
  while i <= tam do
  begin
    res := res + ' ';
    inc(i);
  end;
  result := res;
end;

function TSingleton.Space(texto: string; tam: integer; pSpaceLeft: Boolean): string;
var
  vTemp: string;
begin
  vTemp := texto;
  while Length(vTemp) < tam do
    if pSpaceLeft then
      vTemp := ' ' + vTemp
    else
      vTemp := vTemp + ' ';
  Result := copy(vTemp, 1, tam);
end;

function TSingleton.SplitS(const Str: string; Delimiter: string; pRemoveFirstLineCaseEmpty: Boolean): TStrings;
var
  vLineBreak: string;
begin
  Result := TStringList.Create;
  vLineBreak := Result.LineBreak;
  Result.LineBreak := Delimiter;
  Result.Text := Str;
  Result.LineBreak := vLineBreak;
  if pRemoveFirstLineCaseEmpty then
    if Result.Count > 0 then
      if Trim(Result.Strings[0]) = '' then
        Result.Delete(0);
end;

function TSingleton.Split(const Str: string; Delimiter: string;
  pRemoveFirstLineCaseEmpty: Boolean): TStringList;
var
  vLineBreak: string;
begin
  Result := TStringList.Create;
  vLineBreak := Result.LineBreak;
  Result.LineBreak := Delimiter;
  Result.Text := Str;
  Result.LineBreak := vLineBreak;
  if pRemoveFirstLineCaseEmpty then
    if Result.Count > 0 then
      if Trim(Result.Strings[0]) = '' then
        Result.Delete(0);
end;

function TSingleton.SplitA(const Str: string;
  Delimiter: array of string; IgnoreEmpty: Boolean): arraystring;
var
  Astr, Avalue, Adel: string;
  I: Integer;
begin
  if Length(Delimiter) = 0 then
  begin
    SetLength(Result, 1);
    Result[High(Result)] := Str;
    Exit;
  end
  else
    SetLength(Result, 0);

  Adel := Delimiter[Low(Delimiter)];
  Astr := ReplaceMult(Str, Delimiter, Adel);

  while Pos(Adel, Astr) > 0 do
  begin
    Avalue := Copy(Astr, 1, Pos(Adel, Astr) - 1);
    Astr    := Copy(Astr, Pos(Adel, Astr) + 1, Length(Astr));

    if (Trim(Avalue) <> '') or (not IgnoreEmpty) then
    begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := Avalue;
    end;
  end;

  if (Trim(Astr) <> '') or (not IgnoreEmpty) then
  begin
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := Astr;
  end;
end;

function TSingleton.SplitS(const Str: string; Delimiter: array of string;
  pRemoveFirstLineCaseEmpty: Boolean): TStrings;
var
  ADelimiter: string;
  I: Integer;
  AValue: string;
begin
  AValue := Str;
  if Low(Delimiter) > -1 then
    ADelimiter := Delimiter[Low(Delimiter)];
  for I := Low(Delimiter) to High(Delimiter) do
    AValue := StringReplace(AValue, Delimiter[I], ADelimiter, [rfReplaceAll]);
  Result := SplitS(AValue, ADelimiter, pRemoveFirstLineCaseEmpty);
end;

