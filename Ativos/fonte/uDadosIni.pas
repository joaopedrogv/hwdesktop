function TSingleton.definirDiaFinanceiroFechado(pQuery: TIBQuery): Boolean;
begin
  try
    Result := false;

    pQuery.Close;
    pQuery.SQL.Text := 'select first 1 DIA_FCD  from FECH_DIA' +
      ' where CODIGO_EMP = ' + codEmpresa + ' order by dia_fcd desc ';
    pQuery.Open;

    if not pQuery.IsEmpty then
      diaFFinanceiro := pQuery.FieldByName('dia_fcd').AsDateTime
    else
    begin
      diaFFinanceiro := Date - 1;

      pQuery.Close;
      pQuery.SQL.Text := 'insert into FECH_DIA (DIA_FCD, NMOV, TOT_E_FCD, TOT_S_FCD, CODIGO_EMP)' +
        ' values (:DIA_FCD, 1, 0, 0, ' + codEmpresa + ')';
      pQuery.ParamByName('DIA_FCD').AsDate := diaFFinanceiro;
      pQuery.ExecSQL;

      if pQuery.Transaction.InTransaction then
        pQuery.Transaction.Commit;

    end;
    Result := True;

  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro ao definir dia do Financeiro fechado. Erro: ' +
        e.message),
        'Atenção', 0 + 64);
      registraErro('function TSingleton.definirDiaFinanceiroFechado Erro: ' + e.Message);
      if (Pos('Dataset open', e.Message) > 0)
      	or (Pos('Unable to complete network', e.Message) > 0)
        or (Pos('shutdown', e.Message) > 0) then
      begin
        if Application.MessageBox('Falha de conexão com o banco de dados. Deseja tentar recuperar a conexão?', 'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = ID_YES then
          if not conectaBanco(pQuery.Database, vBancoHW, True) then
            Application.MessageBox('O sistema não recuperou a conexão. Favor entre novamente no sistema', 'Atenção', 0 + 64);
      end;
    end;
  end;

end;

function TSingleton.deletarVinculosGradeAcabadoMateriaPrima(pBuscas: TIBQuery;
  pGrupoProdAcab: Integer; pCodProdAcab: string): boolean;
begin
	try
  	Result := False;

    pBuscas.Close;
    pBuscas.SQL.Text := ' select grupo_prod, cod_prod, cod_empresa, num_fab_prod, descr_prod from produtos ' +
    	' where grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cod_empresa = ' + codEmpresa;
    pBuscas.Open;

    if Application.MessageBox(PChar('Deseja remover os vinculos das grades do Produto Acabado e Matérias Primas/Insumos/Embalagens?' + #13 + #13 +
	    'PRODUTO' + #13 +
      'Grupo Prod: ' + IntToStr(pGrupoProdAcab) + #13 +
      'Cod Prod: ' +  trim(pCodProdAcab) + #13 +
      'Num Fabr: ' + trim(pBuscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
      'Descrição: ' + trim(pBuscas.FieldByName('DESCR_PROD').AsString)),
    	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
    	exit;

		pBuscas.Close;
    pBuscas.SQL.Text := ' delete from produtos_pdc_var ' +
    	' where grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cod_empresa = ' + codEmpresa;
    pBuscas.ExecSQL;

  	if pBuscas.Transaction.InTransaction then
    	pBuscas.Transaction.Commit;

    Result := True;
  except
    on E: Exception do
		begin
			pBuscas.Transaction.Rollback;
      fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
