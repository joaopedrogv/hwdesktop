function TSingleton.retornaCodBarraEtiqueta(
	pBuscas: TIBQuery;
  pGrupoProd: Integer;
  pCodProd: string;
  pCodGrade: Integer;
  pNumFabProd: string;
  pCodBarraGrupoCod: boolean = false;
  pEAN: boolean = false): string;
var
	vBuscasTmp: TIBQuery;
  vTransTmp: TIBTransaction;
begin
	Result := '';

  vTransTmp := TIBTransaction.Create(Application);
  vTransTmp.DefaultDatabase := pBuscas.Database;
  vTransTmp.DefaultAction := TACommit;
  vTransTmp.Params.Clear;
  vTransTmp.Params.Add('read_committed');
	vTransTmp.Params.Add('rec_version');
	vTransTmp.Params.Add('nowait');

  vBuscasTmp := TIBQuery.Create(Application);
  vBuscasTmp.Database := pBuscas.Database;
  vBuscasTmp.Transaction := vTransTmp;

  if vProduto.vUsarCodHexCodbarra then
  begin
  	if (pCodGrade <= 0) and (pEAN) then
    begin
      Result := trim(pNumFabProd);
      Exit;
    end;

    vBuscasTmp.Close;
    vBuscasTmp.SQL.Text := ' select cod_etiq from cod_barra_etiq ' +
      ' where grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and cod_prod = ' + QuotedStr(trim(pCodProd)) +
      ' and cod_grade = ' + IntToStr(pCodGrade) +
      ' and cod_empresa = ' + codEmpresa;
    vBuscasTmp.Open;

    if vBuscasTmp.IsEmpty then
    begin
      vBuscasTmp.Close;
      vBuscasTmp.SQL.Text := 'INSERT INTO COD_BARRA_ETIQ ' +
        ' (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA) ' +
        ' VALUES (:GRUPO_PROD, :COD_PROD, :COD_GRADE, :COD_EMPRESA) ';
      vBuscasTmp.ParamByName('GRUPO_PROD').AsInteger := pGrupoProd;
      vBuscasTmp.ParamByName('COD_PROD').AsString := pCodProd;
      vBuscasTmp.ParamByName('COD_GRADE').AsInteger := pCodGrade;
      vBuscasTmp.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      vBuscasTmp.ExecSQL;

      if vBuscasTmp.Transaction.InTransaction then
        vBuscasTmp.Transaction.Commit;

      vBuscasTmp.Close;
      vBuscasTmp.SQL.Text := ' select cod_etiq from cod_barra_etiq ' +
        ' where grupo_prod = ' + IntToStr(pGrupoProd) +
        ' and cod_prod = ' + QuotedStr(trim(pCodProd)) +
        ' and cod_grade = ' + IntToStr(pCodGrade) +
        ' and cod_empresa = ' + codEmpresa;
      vBuscasTmp.Open;
    end;

    if not vBuscasTmp.IsEmpty then
      Result := 'A-' + StrZero(CodEmpresa, 2) + IntToHex(vBuscasTmp.FieldByName('COD_ETIQ').AsInteger, 1);
  end
  else
  begin
    if (pCodGrade > 0) then
    begin
      if (vEmp.vDigitosEmp = 2) or (vEmp.vDigitosEmp = 1) then
        Result :=
          'G-' + StrZero(CodEmpresa, vEmp.vDigitosEmp) +
          StrZero(pGrupoProd, vEmp.vDidgitosGrup) +
          trim(pCodProd) +
          IntToStr(pCodGrade)
      else
        Result :=
          'G-' + StrZero(pGrupoProd, vEmp.vDidgitosGrup) +
          trim(pCodProd) +
          IntToStr(pCodGrade);
    end
    else
    begin
    	if pCodBarraGrupoCod then
       	Result := IntToStr(pGrupoProd) + trim(pCodProd)
      else
      	Result := trim(pNumFabProd);
    end;
  end;
  vBuscasTmp.Close;
end;

function TSingleton.retornaCodContato(
	pCodCliente: Integer;
  pIdAplicativo: Integer;
  pContato: string;
  pIdentificacao: string): Integer;
var
	Con: TConexao;
begin
	Result := 0;

  Con := TConexao.Create(dtmAtivo.bancoHw);
	try
    try
      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select first 1 msg_contato.id from msg_contato ' +
          ' where msg_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and msg_contato.cod_empresa = ' + codEmpresa +
          ' and msg_contato.id_msg_aplicativo = ' + IntToStr(pIdAplicativo) +
          ' and msg_contato.contato = ' + QuotedStr(trim(pContato)) +
          ' and msg_contato.identificador = ' + QuotedStr(trim(pIdentificacao)) +
          ' and ativo = 1 ';
        Con.QrAux.Open;
      end
      else
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select clientes_contato.id from clientes_contato ' +
          ' inner join tipo_contato on tipo_contato.id = clientes_contato.tipo_id ' +
          ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and clientes_contato.cod_empresa = ' + codEmpresa +
          ' and clientes_contato.contato = ' + QuotedStr(trim(pContato)) +
          ' and clientes_contato. ' +
            IfThen(pIdAplicativo = 2, 'telefone = ', 'email like ') +
            IfThen(pIdAplicativo = 2, QuotedStr(trim(pIdentificacao)), QuotedStr('%' + trim(pIdentificacao) + '%'));
        Con.QrAux.Open;

        if (pIdAplicativo = 1) and (Con.QrAux.IsEmpty) then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select - 1 id from clientes ' +
            ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
            ' and clientes.cod_empresa = ' + codEmpresa +
            ' and clientes.email like ' + QuotedStr('%' + trim(pIdentificacao) + '%');
          Con.QrAux.Open;
        end;
      end;

      Result := Con.QrAux.FieldByName('id').AsInteger;
    except on E: Exception do
      begin
        Result := 0;
        Application.MessageBox(PChar('Erro ao retorna código do contato: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao retorna código do contato: ' + e.Message);
      end;
    end;
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

