function TSingleton.imprimirtexto(pTexto: string; pTamLimiteTextoPorLinha: Integer;
  var pLista: TStringList): boolean;
var
 I: Integer;
 vtemp, vtemp2: string;
 vLista: TStringList;
begin
 try
   try
      Result := true;
      vLista := TStringList.Create;

      vLista.Clear;
      pLista.Clear;
      vtemp := '';
      vtemp2 := '';

      vLista.LineBreak := ' ';
      vLista.Text := pTexto;
      for I := 0 to vLista.Count - 1 do
      begin
        vtemp2 := vtemp2 + IfThen(trim(vtemp2) <> '', ' ', '') + trim(vLista[I]);
        if Length(vtemp2) > pTamLimiteTextoPorLinha then
          pLista.Add(trim(vtemp));
        vtemp := vtemp + IfThen(trim(vtemp) <> '', ' ', '') + trim(vLista[I]);
         if Length(vtemp2) > pTamLimiteTextoPorLinha then
         begin
           vtemp := trim(vLista[I]);
           vtemp2 := trim(vLista[I]);
         end;
      end;
      if Length(vtemp2) <= pTamLimiteTextoPorLinha then
        pLista.Add(trim(vtemp2));
  //    for I := 0 to pLista.Count - 1 do
  //     ShowMessage(pLista[I]);
    finally
    begin
      FreeAndNil(vLista);
    end;
   end;

 except on E: Exception do
   begin
     Result := false;
   end;
 end;
end;

function TSingleton.informarSituacaoPedido(pNped: Integer; pTipo, pSituacao, pStatus, pObs: string;
  pQuery: TIBQuery; pCommitar: Boolean; pMensagem: Boolean; pExcluir: Boolean): Boolean;
var
  vCodOcorrencia: Integer;
begin
  Result := True;

  if Trim(pTipo) <> 'REQ' then
    Exit;

  if pSituacao = 'FINANCEIRO' then
  begin
    if vEmp.vCaixaIntegrado <> 'S' then
      Exit;
  end
  else if pSituacao = 'SEPARACAO' then
  begin
    if (vEmp.vOC_UsarOrdemCarregamento <> 'D') and (vEmp.vUSAR_SEPARACAO_PED <> 'S') then
      Exit;
  end
  else if pSituacao = 'EXPEDICAO' then
  begin
    if vEmp.vUsarConferenciaCegaSaida = 'N' then
      Exit;
  end
  else if pSituacao = 'SAIDA' then
  begin
    if vEmp.vOC_UsarOrdemCarregamento <> 'D' then
      Exit;
  end
  else if pSituacao = 'ACERTO' then
  begin
    if vEmp.vModoFaturamento <> 'S' then
      Exit;
  end;

  try

    pQuery.Close;
    pQuery.SQL.Text := 'select * from OCORRENCIAS_OS' +
      ' where NPED = ' + IntToStr(pNped) +
      ' and TIPO = ' + QuotedStr(Trim(pTipo)) +
      ' and COD_EMPRESA = ' + codEmpresa +
      ' and SITUACAO = ' + QuotedStr(pSituacao) +
      ' and STATUS_SITUACAO = ' + QuotedStr(pStatus);
    pQuery.Open;

    if pExcluir then
    begin    
      if pQuery.IsEmpty then
        Exit;

      pQuery.Close;
      pQuery.SQL.Text := 'delete from OCORRENCIAS_OS' +
        ' where NPED = :NPED and TIPO = :TIPO and COD_EMPRESA = :COD_EMPRESA and SITUACAO = :SITUACAO and STATUS_SITUACAO = :STATUS_SITUACAO';
      pQuery.ParamByName('NPED').AsInteger := pNped;
      pQuery.ParamByName('TIPO').AsString := Copy(Trim(pTipo),1,3);
      pQuery.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      pQuery.ParamByName('SITUACAO').AsString := Copy(pSituacao , 1, 16);
      pQuery.ParamByName('STATUS_SITUACAO').AsString := Copy(pStatus , 1, 16);
      pQuery.ExecSQL;

    end
    else
    begin
      if not pQuery.IsEmpty then
        Exit;

      pQuery.Close;
      pQuery.SQL.Text := 'select COD from INCREMENTA_CODIGO(' + codEmpresa + ', ''OCORRENCIAS_OS'')';
      pQuery.Open;

      vCodOcorrencia := pQuery.FieldByName('COD').AsInteger;

      pQuery.Close;
      pQuery.SQL.Text := 'insert into OCORRENCIAS_OS (COD_OCORRENCIA, NPED, TIPO, COD_EMPRESA, HISTORICO_OC, DATA_E_HORA, ATIVO, N_OS, SITUACAO, STATUS_SITUACAO)' +
        ' values (:COD_OCORRENCIA, :NPED, :TIPO, :COD_EMPRESA, :HISTORICO_OC, ' + FusoSqlDateTime + ' , 1, :N_OS, :SITUACAO, :STATUS_SITUACAO)';
      pQuery.ParamByName('COD_OCORRENCIA').AsInteger := vCodOcorrencia;
      pQuery.ParamByName('NPED').AsInteger := pNped;
      pQuery.ParamByName('TIPO').AsString := Copy(Trim(pTipo),1,3);
      pQuery.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      pQuery.ParamByName('HISTORICO_OC').AsString := Copy( pSituacao + ' - ' + pStatus , 1, 150);
      pQuery.ParamByName('N_OS').AsInteger := pNped;
      pQuery.ParamByName('SITUACAO').AsString := Copy(pSituacao , 1, 16);
      pQuery.ParamByName('STATUS_SITUACAO').AsString := Copy(pStatus , 1, 16);
      pQuery.ExecSQL;
    end;

    if pCommitar then
      if pQuery.Transaction.InTransaction then
        pQuery.Transaction.Commit;

  except on E: Exception do
    begin
      Result := False;
      if pCommitar then
        if pQuery.Transaction.InTransaction then
          pQuery.Transaction.Rollback;

      registraErro('TSingleton.informarSituacaoPedido. ' +
        pTipo + ' - ' + IntToStr(pNped) + ' - ' + pSituacao + ' - ' + pStatus +
        '. Erro: ' + e.Message) ;

      if pMensagem then
        Application.MessageBox(
          pchar('Erro ao gravar situação do pedido. Erro: ' + E.Message),
          'Atenção', 0 + 64);
    end;
  end;
end;

function TSingleton.iniciarServicoBackup(pAtualizarArq: boolean = True): boolean;
const
  ConfHwService: string = 'Software\Hw\Configuracao\HwService\';
  ConfHwGuard:   string = 'Software\Microsoft\Windows\CurrentVersion\Run';
var
	ArqConfigTmp: TIniFile;
  Registro: TRegistry;
  HwServicoRodando: boolean;
  HwServicoIniciar: boolean;
  vPathArq, vPcScale: string;
  vMD5Hw, vMD5Serv: string;
  vServer, vDatabase: string;
  AList: TStringList;
  I: Integer;

  procedure verificarHwServiceAtivo;
  begin
  	try
      Registro := TRegistry.Create;
      try
        Registro.OpenKey(ConfHwService, True);
        if Registro.ValueExists('HwServicoAtivado') then
          HwServicoIniciar := Registro.ReadBool('HwServicoAtivado');
        Registro.CloseKey;
      finally
        Registro.Free;
      end;
    except
    end;
  end;

begin
	HwServicoRodando := False;
	if pAtualizarArq then
  	HwServicoRodando := RunningTask('HwServico.exe') > 0;

  vPathArq := _getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas';

  // Não iniciar ou tentar atualizar se o serviço estiver rodando
  if (HwServicoRodando) then
  begin
  	vMD5Hw   := '';
    if FileExists(ExtractFilePath(Application.Exename) + 'HwServico.exe') then
    	vMD5Hw   := UpperCase(MD5Print(MD5File(ExtractFilePath(Application.Exename) + 'HwServico.exe')));//_getMd5(ExtractFilePath(Application.Exename) + 'HwServico.exe');
    vMD5Serv := '';
    if FileExists(vPathArq + '\HwServico.exe') then
      vMD5Serv := UpperCase(MD5Print(MD5File(vPathArq + '\HwServico.exe'))); //_getMd5(vPathArq + '\HwServico.exe');

    if (trim(vMD5Hw) = '') or (trim(vMD5Serv) = '') then
  		Exit
    else if (trim(vMD5Hw) <> trim(vMD5Serv)) then
    	//
    else
    	Exit;
  end;

  HwServicoIniciar := False;

  verificarHwServiceAtivo;

  // Não iniciar ou tentar atualizar se o serviço não estiver configurado
  if (not HwServicoIniciar) then
  	Exit;

  if (pAtualizarArq) and (HwServicoIniciar) then
  begin
    if not FileExists(ExtractFilePath(Application.ExeName) + 'HwServico.exe') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'Compacta.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'CompativelHW.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'auditoria.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'hw.auditoria.dx.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'cons40.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'PcScale.dll') then
      if not FileExists(vDadosIni._getSpecialFolderPath(CSIDL_SYSTEM)+ '\PcScale.dll') then
        Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'MD5XE3.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'hw.nfe.dx.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'hw.utils.dx.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'HwScript.dll') then
      Exit;

    if not FileExists(ExtractFilePath(Application.ExeName) + 'HwGuard.exe') then
      Exit;

    if (HwServicoRodando) then
      if KillTask('HwGuard.exe') > 0 then
        Exit;

    if (HwServicoRodando) then
      if KillTask('HwServico.exe') > 0 then
        Exit;

    if not DirectoryExists(vPathArq) then
      CreateDir(vPathArq);

    if not DirectoryExists(vPathArq) then
      Exit;

    if (HwServicoRodando) then
    	sleep(2000);

    if FileExists(vPathArq + '\HwServico.exe') then
      DeleteFile(PChar(vPathArq + '\HwServico.exe'));

    if FileExists(vPathArq + '\HwServico.exe') then
    	Exit;

    if FileExists(vPathArq + '\Compacta.dll') then
      DeleteFile(PChar(vPathArq + '\Compacta.dll'));

    if FileExists(vPathArq + '\Compacta.dll') then
    	Exit;

    if FileExists(vPathArq + '\CompativelHW.dll') then
      DeleteFile(PChar(vPathArq + '\CompativelHW.dll'));

    if FileExists(vPathArq + '\CompativelHW.dll') then
    	Exit;

    if FileExists(vPathArq + '\auditoria.dll') then
      DeleteFile(PChar(vPathArq + '\auditoria.dll'));

    if FileExists(vPathArq + '\auditoria.dll') then
    	Exit;

    if FileExists(vPathArq + '\hw.auditoria.dx.dll') then
      DeleteFile(PChar(vPathArq + '\hw.auditoria.dx.dll'));

    if FileExists(vPathArq + '\hw.auditoria.dx.dll') then
    	Exit;

    if FileExists(vPathArq + '\cons40.dll') then
      DeleteFile(PChar(vPathArq + '\cons40.dll'));

    if FileExists(vPathArq + '\cons40.dll') then
    	Exit;

    if FileExists(vPathArq + '\PcScale.dll') then
      DeleteFile(PChar(vPathArq + '\PcScale.dll'));

    if FileExists(vPathArq + '\PcScale.dll') then
    	Exit;
    
    if FileExists(vPathArq + '\MD5XE3.dll') then
      DeleteFile(PChar(vPathArq + '\MD5XE3.dll'));

    if FileExists(vPathArq + '\MD5XE3.dll') then
    	Exit;
    
    if FileExists(vPathArq + '\hw.utils.dx.dll') then
      DeleteFile(PChar(vPathArq + '\hw.utils.dx.dll'));

    if FileExists(vPathArq + '\hw.utils.dx.dll') then
