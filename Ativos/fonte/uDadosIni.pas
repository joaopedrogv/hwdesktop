function TSingleton.InputValoReal(captionForm, captionCampo: string;
  var valor: double): boolean;
var
	vresultado: Integer;
begin
	Result := false;
  
  Application.CreateForm(TFrmInputValorReal, FrmInputValorReal);
  FrmInputValorReal.Caption := captionForm;
  FrmInputValorReal.Label1.Caption := captionCampo;
  FrmInputValorReal.EditMoeda1.Valor := valor;
  vresultado := FrmInputValorReal.ShowModal;
  try

  if vresultado = mrOk then
  begin
  	Result := true;
    valor := FrmInputValorReal.EditMoeda1.Valor;
  end
  else if vresultado = mrCancel then
  	Result := true
  else if vresultado = mrAbort then
  	Result := false;
  //    else
  //      valor := 0;
  finally
    FreeAndNil(FrmInputValorReal);
  end;
end;

function TSingleton.inserirContatoAplicativo(
  pCodCliente: Integer;
  pAplicativo: string;
  pContato: string;
  pIdentificacao: string;
  pCheckListTipoContato: TCheckListBox;
  pIdContato: Integer): boolean;
var
	Con: TConexao;
  vAplicativoId: Integer;
	vIdContato: Integer;
  vIdTipoContato: Integer;
  vTemp: string;
  I: Integer;
begin
    Result := False;

	Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      if not PesqPros('CLI297', 'SALVAR', 'CL: ' + IntToStr(pCodCliente), 'MSG_CONTATO', IntToStr(pIdContato), Con.QrAux, True) then
      Exit;

      vAplicativoId := retornaCodAplicativo(trim(pAplicativo));

      if vAplicativoId <= 0 then
      begin
        Application.MessageBox(PChar('Aplicativo não encontrado: ' + #13 + #13 +
          'APLICATIVO' + #13 +
          'Descrição: ' + trim(pAplicativo)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        Exit;
      end;

      for I := 0 to pCheckListTipoContato.Count - 1 do
        if pCheckListTipoContato.Checked[I] then
        begin
          vIdTipoContato := retornaCodTipoContato(trim(pCheckListTipoContato.Items[I]));

          if vIdTipoContato <= 0 then
          begin
            Application.MessageBox(PChar('Tipo de contato não encontrado: ' + #13 + #13 +
              'TIPO DE CONTATO' + #13 +
              'Descrição: ' + trim(pCheckListTipoContato.Items[I])), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            Exit;
          end;
        end;

      if pIdContato <= 0 then
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select msg_contato.id from msg_contato ' +
          ' where msg_contato.cod_cliente = :cod_cliente ' +
          ' and msg_contato.cod_empresa = :cod_empresa ' +
          ' and msg_contato.id_msg_aplicativo = :id_msg_aplicativo ' +
          ' and msg_contato.identificador = :identificador ' +
          ' and msg_contato.ativo = :ativo ' +
          ' and msg_contato.id <> :id ';
        Con.QrAux.ParamByName('id').AsInteger := pIdContato;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := vAplicativoId;
        Con.QrAux.ParamByName('identificador').AsString := trim(pIdentificacao);
        Con.QrAux.ParamByName('ativo').AsInteger := 1;
        Con.QrAux.Open;

        if not Con.QrAux.IsEmpty then
        begin
          Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
            'CONTATO' + #13 +
            Copy(trim(pAplicativo), 1, 1) + LowerCase(Copy(trim(trim(pAplicativo)), 2, Length(trim(trim(pAplicativo))) - 1)) +': ' + trim(pIdentificacao)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          Exit;
        end;
      end;
    
      if pIdContato <= 0 then
      begin
        vIdContato := Gencodigo('MSG_CONTATO', Con.QrAux, codEmpresa);

        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' insert into msg_contato ' +
          ' (id, cod_empresa, cod_cliente, id_msg_aplicativo, contato, identificador, ativo) ' +
          ' values (:id, :cod_empresa, :cod_cliente, :id_msg_aplicativo, :contato, :identificador, :ativo); ';
        Con.QrAux.ParamByName('id').AsInteger := vIdContato;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := vAplicativoId;
        Con.QrAux.ParamByName('contato').AsString := Copy(UpperCase(trim(pContato)), 1, 32);
        Con.QrAux.ParamByName('identificador').AsString := Copy(trim(pIdentificacao), 1, 60);
        Con.QrAux.ParamByName('ativo').AsInteger := 1;
        Con.QrAux.ExecSQL;
      end;

      for I := 0 to pCheckListTipoContato.Count - 1 do
      begin
        vIdTipoContato := retornaCodTipoContato(trim(pCheckListTipoContato.Items[I]));

        if vIdTipoContato > 0 then
        begin
          if (pIdContato <= 0) and (pCheckListTipoContato.Checked[I]) then
          begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
              ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
              ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
            Con.QrAux.ParamByName('id_msg_contato').AsInteger := vIdContato;
            Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vIdTipoContato;
            Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
            Con.QrAux.ExecSQL;
          end
          else if pIdContato > 0 then
          begin
            if pCheckListTipoContato.Checked[I] then
            begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' select * from msg_contato_tipo ' +
                ' where id_msg_contato = :id_msg_contato ' +
                ' and id_tipo_contato = :id_tipo_contato ' +
                ' and cod_empresa = :cod_empresa ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := pIdContato;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vIdTipoContato;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              Con.QrAux.Open;

              if Con.QrAux.IsEmpty then
              begin
                Con.QrAux.Close;
                Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
                  ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
                  ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
                Con.QrAux.ParamByName('id_msg_contato').AsInteger := pIdContato;
                Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vIdTipoContato;
                Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
                Con.QrAux.ExecSQL;
              end;
            end
            else
            begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' delete from msg_contato_tipo ' +
                ' where id_msg_contato = :id_msg_contato ' +
                ' and id_tipo_contato = :id_tipo_contato ' +
                ' and cod_empresa = :cod_empresa ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := pIdContato;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vIdTipoContato;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              Con.QrAux.ExecSQL;
            end;
          end;
        end;
      end;

      GravaAuditoria('CLI297', 'SALVAR', 'SUCESSO', 'MSG_CONTATO', IntToStr(pIdContato), Con.QrAux);

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;

    Result := True;
  except on E: Exception do
    begin
      Result := False;
        GravaAuditoria('CLI297', 'SALVAR', 'FALHA', 'MSG_CONTATO', '', Con.QrAux);
        Application.MessageBox(PChar('Erro ao inserir contato por aplicativo: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao inserir contato por aplicativo: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
    end;
  end;
  finally
  	if Assigned(Con) then
      FreeAndNil(Con);
end;
end;

function TSingleton.inserirContatoCliente(
	pOrigemEnv: TOrigemEnv;
  pCodCliente: Integer;
  pListContatoWhatsApp: TCheckListBox): boolean;
var
	Con: TConexao;
	vContatoEmail: string;
	vTipoId: Integer;
  vIdContato: Integer;
  I: Integer;
begin
  	Result := False;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' select cod_cliente, contato from clientes ' +
    	' where cod_cliente = :cod_cliente ' +
      ' and cod_empresa = :cod_empresa ';
      Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
      Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
      Con.QrAux.Open;

      vContatoEmail := trim(Con.QrAux.FieldByName('contato').AsString);

    for I := 0 to pListContatoWhatsApp.Items.Count - 1 do
    	if not pListContatoWhatsApp.Checked[I] then
      begin
        if StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3))) > 0 then
        begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' select cod_cliente, cod_empresa, origem_env, id_contato from clientes_contato_env ' +
          ' where cod_cliente = :cod_cliente ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and origem_env = :origem_env ' +
            ' and id_contato = :id_contato ';
            Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
            Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
            Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
            Con.QrAux.ParamByName('id_contato').AsInteger := StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3)));
            Con.QrAux.Open;

            if not Con.QrAux.IsEmpty then
          begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' delete from clientes_contato_env ' +
              ' where cod_cliente = :cod_cliente ' +
              ' and cod_empresa = :cod_empresa ' +
              ' and origem_env = :origem_env ' +
              ' and id_contato = :id_contato ';
              Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
              Con.QrAux.ParamByName('id_contato').AsInteger := StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3)));
              Con.QrAux.ExecSQL;
          end;
        end;
      end
      else if pListContatoWhatsApp.Checked[I] then
      begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select cod_cliente, cod_empresa, origem_env, id_contato from clientes_contato_env ' +
          ' where cod_cliente = :cod_cliente ' +
          ' and cod_empresa = :cod_empresa ' +
          ' and origem_env = :origem_env ' +
          ' and id_contato = :id_contato ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
          Con.QrAux.ParamByName('id_contato').AsInteger := StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3)));
          Con.QrAux.Open;

          if Con.QrAux.IsEmpty then
        begin
          if StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3))) > 0 then
          begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' insert into clientes_contato_env ' +
              ' (cod_cliente, cod_empresa, origem_env, id_contato) ' +
              ' values (:cod_cliente, :cod_empresa, :origem_env, :id_contato); ';
              Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
              Con.QrAux.ParamByName('id_contato').AsInteger := StrToInt(trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 3)));
              Con.QrAux.ExecSQL;
          end
          else
          begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' select id from tipo_contato ' +
              ' where tipo = :tipo ' +
              ' and cod_empresa = :cod_empresa ';
