procedure TSingleton.montarDBComboboxTipoGradeEC(
	pBuscas: TIBQuery;
  pDbcombobox: TDBComboBox);
begin
	pDbcombobox.Clear;
  pDbcombobox.Items.Add('');

  SqlOpen(' select descricao from tipo_grade_ec ' +
  	' where cod_empresa = ' + codEmpresa +
    ' and ativo = 1 ' +
    ' order by descricao ', pBuscas).FetchAll;

  pBuscas.First;
  while not pBuscas.Eof do
  begin
  	pDbcombobox.Items.Add(pBuscas.FieldByName('descricao').AsString);

    pBuscas.Next;
  end;
end;

procedure TSingleton.montarDbComboboxUndConv(
	pBuscas: TIBQuery;
  var pDBCombobox: TDBCombobox;
  pGrupoProd: Integer = 0;
  pCodProd: string = '';
  pNumFabProd: string = '';
  pUnidade: string = '');
var
	vUnidadeProd: string;
	vUnidadePadrao: string;
  I: Integer;
begin
	vUnidadeProd := '';
	vUnidadePadrao := '';

	pDBCombobox.Clear;
  if trim(pCodProd) = '' then
    pDBCombobox.Enabled := False
  else if trim(pNumFabProd) = '' then
    pDBCombobox.Enabled := False
  else
  begin
    SqlOpen(' select unidade from produtos pr ' +
      ' where pr.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and pr.cod_prod = ' + QuotedStr(pCodProd) +
      ' and pr.cod_empresa = ' + codEmpresa, pBuscas).FetchAll;

    if trim(pBuscas.FieldByName('UNIDADE').AsString) <> '' then
    begin
    	if pDBCombobox.Items.IndexOf(UpperCase(trim(pBuscas.FieldByName('UNIDADE').AsString))) = -1 then
      	pDBCombobox.Items.Add(UpperCase(trim(pBuscas.FieldByName('UNIDADE').AsString)));

      vUnidadeProd := UpperCase(trim(pBuscas.FieldByName('UNIDADE').AsString));
    end;

    if trim(pUnidade) <> '' then
    	if pDBCombobox.Items.IndexOf(UpperCase(trim(pUnidade))) = -1 then
    		pDBCombobox.Items.Add(UpperCase(trim(pUnidade)));

    SqlOpen(' select cv.grupo_prod, cv.cod_prod, cv.cod_empresa, unidade, ' +
    	' cv.disponivel_venda, cv.padrao_venda from produtos_conversao_saida cv ' +
      ' where cv.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and cv.cod_prod = ' + QuotedStr(pCodProd) +
      ' and cv.cod_empresa = ' + codEmpresa +
