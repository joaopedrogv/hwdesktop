procedure TSingleton.addContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
var
	I: Integer;
begin
  if pCodCliente <= 0 then
  	Exit;

  if not vDadosIni.abreFormInserirContatoCliente(
    pCodCliente,
    pOrigem,
    cTpContatoCliente) then
      Exit;

  vDadosIni.retornaCheckListContato(
    pCodCliente,
    pOrigem,
    pCheckListContato
  );

  if pOrigem <> cContrato then
  begin
    for I := 0 to vListaContatoTemp.Count - 1 do
    begin
      pCheckListContato.Items.Add(
        trim(vListaContatoTemp[I]) + ' * '
      );

      pCheckListContato.Checked[pCheckListContato.Items.Count - 1] := True;
    end;
  end;
end;

procedure TSingleton.addOutrosContatoCliente(
  pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
var
	Con: TConexao;
	I: Integer;
begin
  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    if not vDadosIni.abreFormInserirContatoCliente(
      pCodCliente,
      pOrigem,
      cTpContatoOutros) then
        Exit;

    if pCodCliente <= 0 then
      pCheckListContato.Items.Clear
    else
    begin
      vDadosIni.retornaCheckListContato(
        pCodCliente,
        pOrigem,
        pCheckListContato
      );
    end;

    if pOrigem <> cContrato then
    begin
      for I := 0 to vListaContatoTemp.Count - 1 do
      begin
        pCheckListContato.Items.Add(
          trim(vListaContatoTemp[I]) + ' * '
        );

        pCheckListContato.Checked[pCheckListContato.Items.Count - 1] := True;
      end;
    end;
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

