procedure TSingleton.SomarvaloresdacolunaCadPadraoClick(pDBGrid: TDBGrid;
  plbStatusProcessamento, plbTextoProcessamento: TLabel;
  pnStatusProcessamento: TPanel);
var
  vValorGeral, vValorSelecionados, vValorMarcados: Extended;
  vRecNo, vCountMarcados, vCountSelecionados: Integer;
  vCampoMarc: string;
begin
  if (pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName) is TFloatField) or (pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName) is TIntegerField) then
  begin
    try
      pDBGrid.DataSource.DataSet.DisableControls;
      try
        plbStatusProcessamento.Caption := 'Status de processamento';
        plbTextoProcessamento.Caption := 'Somando registros';
        pnStatusProcessamento.Top := Trunc((Application.MainForm.Height - pnStatusProcessamento.Height) / 2);
        pnStatusProcessamento.Left := Trunc((Application.MainForm.Width - pnStatusProcessamento.Width) / 2);
        pnStatusProcessamento.Visible := True;
        vValorGeral := 0;
        vValorSelecionados := 0;
        vValorMarcados := 0;
        vCountMarcados := 0;
        vCountSelecionados := 0;
        if pDBGrid.DataSource.DataSet.FindField('SEL') <> nil then
          vCampoMarc := 'SEL'
        else if pDBGrid.DataSource.DataSet.FindField('SELEC') <> nil then
          vCampoMarc := 'SELEC'
        else
          vCampoMarc := '';
        if not pDBGrid.DataSource.DataSet.IsEmpty then
          vRecNo := pDBGrid.DataSource.DataSet.RecNo;
        pDBGrid.DataSource.DataSet.First;
        while not pDBGrid.DataSource.DataSet.Eof do
        begin
          if pDBGrid.DataSource.DataSet.RecNo mod 5 = 0 then
            plbTextoProcessamento.Caption := 'Somando registros ' + IntToStr(Trunc(pDBGrid.DataSource.DataSet.RecNo / pDBGrid.DataSource.DataSet.RecordCount * 100)) + '%';
          Application.ProcessMessages;
          vValorGeral := vValorGeral + pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName).AsFloat;
          if pDBGrid.SelectedRows.CurrentRowSelected then
          begin
            vValorSelecionados := vValorSelecionados + pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName).AsFloat;
            vCountSelecionados := vCountSelecionados + 1;
          end;
          if vCampoMarc <> '' then
            if pDBGrid.DataSource.DataSet.FieldByName(vCampoMarc).AsString = 'S' then
            begin
              vValorMarcados := vValorMarcados + pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName).AsFloat;
              vCountMarcados := vCountMarcados + 1;
            end;
          pDBGrid.DataSource.DataSet.Next;
        end;
        plbTextoProcessamento.Caption := 'Somando registros 100%';
      finally
        pnStatusProcessamento.Visible := False;
        if not pDBGrid.DataSource.DataSet.IsEmpty then
          pDBGrid.DataSource.DataSet.RecNo := vRecNo;
        pDBGrid.DataSource.DataSet.EnableControls;
      end;
      vCampoMarc := 'Soma da coluna selecionada "' +
        pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName).DisplayLabel + '"' + #13 +
        'Soma geral: ' + Format('%n', [vValorGeral]) + #13 +
        'Soma selecionados ("Ctrl + Click" ou "Shift + Up ou Down"): ' + Format('%n', [vValorSelecionados]) + #13 +
        'Soma marcados ("Tecla de espaço"): ' + Format('%n', [vValorMarcados]) + #13 +
        'Quantidade de registros geral: ' + IntToStr(pDBGrid.DataSource.DataSet.RecordCount) + #13 +
        'Quantidade de registros selecionados: ' + IntToStr(vCountSelecionados) + #13 +
        'Quantidade de registros marcados: ' + IntToStr(vCountMarcados);
      Application.MessageBox(PChar(vCampoMarc), 'Atenção', 0 + 64);
    except
      on e: Exception do
        Application.MessageBox(PChar('Erro ao efetuar soma. Erro: ' + e.Message), 'Erro', MB_ICONERROR + MB_OK);
    end;
  end
  else
  begin
  	try
      pDBGrid.DataSource.DataSet.DisableControls;
      try
        plbStatusProcessamento.Caption := 'Status de processamento';
        plbTextoProcessamento.Caption := 'Somando registros';
        pnStatusProcessamento.Top := Trunc((Application.MainForm.Height - pnStatusProcessamento.Height) / 2);
        pnStatusProcessamento.Left := Trunc((Application.MainForm.Width - pnStatusProcessamento.Width) / 2);
        pnStatusProcessamento.Visible := True;
        vValorGeral := 0;
        vValorSelecionados := 0;
        vValorMarcados := 0;
        vCountMarcados := 0;
        vCountSelecionados := 0;
        if pDBGrid.DataSource.DataSet.FindField('SEL') <> nil then
          vCampoMarc := 'SEL'
        else if pDBGrid.DataSource.DataSet.FindField('SELEC') <> nil then
          vCampoMarc := 'SELEC'
        else
          vCampoMarc := '';
        if not pDBGrid.DataSource.DataSet.IsEmpty then
          vRecNo := pDBGrid.DataSource.DataSet.RecNo;
        pDBGrid.DataSource.DataSet.First;
        while not pDBGrid.DataSource.DataSet.Eof do
        begin
          if pDBGrid.DataSource.DataSet.RecNo mod 5 = 0 then
            plbTextoProcessamento.Caption := 'Somando registros ' + IntToStr(Trunc(pDBGrid.DataSource.DataSet.RecNo / pDBGrid.DataSource.DataSet.RecordCount * 100)) + '%';
          Application.ProcessMessages;
          if pDBGrid.SelectedRows.CurrentRowSelected then
          begin
            vCountSelecionados := vCountSelecionados + 1;
          end;
          if vCampoMarc <> '' then
            if pDBGrid.DataSource.DataSet.FieldByName(vCampoMarc).AsString = 'S' then
            begin
              vCountMarcados := vCountMarcados + 1;
            end;
          pDBGrid.DataSource.DataSet.Next;
        end;
        plbTextoProcessamento.Caption := 'Somando registros 100%';
      finally
        pnStatusProcessamento.Visible := False;
        if not pDBGrid.DataSource.DataSet.IsEmpty then
          pDBGrid.DataSource.DataSet.RecNo := vRecNo;
        pDBGrid.DataSource.DataSet.EnableControls;
      end;
      vCampoMarc := 'Soma da coluna selecionada "' +
        pDBGrid.DataSource.DataSet.FieldByName(pDBGrid.Columns[pDBGrid.SelectedIndex].FieldName).DisplayLabel + '"' + #13 +
        'Quantidade de registros geral: ' + IntToStr(pDBGrid.DataSource.DataSet.RecordCount) + #13 +
        'Quantidade de registros selecionados: ' + IntToStr(vCountSelecionados) + #13 +
        'Quantidade de registros marcados: ' + IntToStr(vCountMarcados);
      Application.MessageBox(PChar(vCampoMarc), 'Atenção', 0 + 64);
    except
      on e: Exception do
        Application.MessageBox(PChar('Erro ao efetuar soma. Erro: ' + e.Message), 'Erro', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TSingleton.copyArquivo(pArquivoOrigem, pArquivoDestino: string): boolean;
var
  arqOrigem, arqDestino: TFileStream;
begin
  Result := false;
  arqOrigem := TFileStream.Create(pArquivoOrigem, fmOpenRead);
  try
    arqDestino := TFileStream.Create(pArquivoDestino, fmOpenWrite or fmCreate);
    try
      arqDestino.CopyFrom(arqOrigem, arqOrigem.Size);
      Result := true;
    finally
      arqDestino.Free;
    end;
  finally
    arqOrigem.Free;
  end;
end;

function TSingleton.StrZeroStr(Num: string; Tam: Integer): string;
var
  I: Integer;
  V1: string;
begin
  V1 := Trim(Num);
  for I := 1 to Tam - Length(V1) do V1 := '0' + V1;
  Result := V1;
end;

function TSingleton.RunningTask(ExeNameWithExtension: string): Integer;
const
  PROCESS_TERMINATE = $0001;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  Result := 0;
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);

  while Integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) = UpperCase(ExeNameWithExtension)) or (UpperCase(FProcessEntry32.szExeFile) = UpperCase(ExeNameWithExtension))) then
    begin
      Result := 1;
      Break;
    end;

    ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

