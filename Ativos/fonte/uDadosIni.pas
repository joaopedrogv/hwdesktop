function TSingleton._ValidarCelular(pStr: string; pExibirErro: boolean): boolean;
var
  ApenasNumeros: string;
  i: Integer;
  begin
	try
    Result := False;
    ApenasNumeros := '';

    // 1. Remove caracteres não numéricos (, ), -
    for i := 1 to Length(pstr) do
    begin
      if (pStr[i] in ['0'..'9']) then
        ApenasNumeros := ApenasNumeros + pStr[i];
    end;

    // 2. Verifica se tem 11 dígitos (DDD + 9 + 8 dígitos)
    if Length(ApenasNumeros) <> 11 then
      Exit;

    // 3. Valida se começa com 9 (opcional, mas recomendado no Brasil)
    if Copy(ApenasNumeros, 3, 1) <> '9' then
      Exit;

    Result := True;
  finally
    if (pExibirErro) and (not Result) then
    	Application.MessageBox(PChar('Erro ao validar celular: '+  pstr), 'Informação', MB_OK + MB_ICONINFORMATION);
  end;
end;

function TSingleton._ValidarEMail(pStr: string; pExibirErro: boolean): Boolean;
begin
  pStr := Trim(UpperCase(pStr));
  if Pos('@', pStr) > 1 then
  begin
    System.Delete(pStr, 1, pos('@', pStr));
    Result := (Length(pStr) > 0) and (Pos('.', pStr) > 2);
  end
  else
  begin
    if pExibirErro then
      Application.MessageBox(PChar('Erro ao validar email: '+  pstr), 'Informação', MB_OK + MB_ICONINFORMATION);
    Result := False;
  end;
end;

function TSingleton._verificarSinal(codBarra: string; pQuantNegativa: boolean = False): Boolean;
var
  temp, nBarra: string;
  nQuant: Double;
  j: Integer;
  i: Integer;
begin
      //Validando codigo de barras
  Result := false;

  nQuant := 0;
  j := 0;
  for i := 1 to length(codBarra) do
    if (Copy(codBarra, I, 1) = '*') {or (Copy(UpperCase(codBarra), I, 1) = 'X')} then
    begin
      inc(j);
      if j >= 2 then
      begin
        Application.MessageBox('Quantidade Invalida. Dois ou mais sinais de multiplicação',
          'Atenção', MB_ICONWARNING + MB_OK);
        exit;
      end;
    end;
  for i := 1 to length(codBarra) do
    if (Copy(codBarra, I, 1) = '*') then // or (Copy(UpperCase(codBarra), I, 1) = 'X') then
    begin
      try
        nQuant := strtofloat(copy(codBarra, 1, I - 1));
      except
        Application.MessageBox(pchar('Quantidade Invalida'), 'Informação', MB_ICONINFORMATION
          + mb_OK);
        exit;
      end;
      nBarra := COPY(codBarra, I + 1, 20);
      if pQuantNegativa = False then
      begin
      	if nQuant <= 0 then
      	begin
        	Application.MessageBox('Quantidade deve ser maior que zero', 'Informação', MB_ICONINFORMATION
          	+ mb_OK);
        	Exit;
      	end;
    	end;
    end;
  if nQuant = 0 then
  begin
    nQuant := 1;
    nBarra := codBarra;
  end;
  codBarra := nBarra;

  vPesquisa :=  FloatToStr(nQuant) + '|' + codBarra + '|';


  Result := true;
end;

