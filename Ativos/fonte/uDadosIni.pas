function TSingleton.validaTextoEMail2(pEMailIn: string): Boolean;
var
  i,cont   : integer;
  EMail    : ShortString;

const
  CaraEsp: array[1..40] of string[1] =
  ( '!','#','$','%','¨','&','*',
  '(',')','+','=','§','¬','¢','¹','²',
  '³','£','´','`','ç','Ç',',',';',':',
  '<','>','~','^','?','/','','|','[',']','{','}',
  'º','ª','°');
begin
  EMail := pEMailIn;
  Result := True;
  cont := 0;
  if EMail <> '' then
    if (Pos('@', EMail)<>0) and (Pos('.', EMail)<>0) then    // existe @ .
    begin
      if (Pos('@', EMail)=1) or (Pos('@', EMail)= Length(EMail)) or (Pos('.', EMail)=1) or (Pos('.', EMail)= Length(EMail)) or (Pos(' ', EMail)<>0) then
        Result := False
      else                                   // @ seguido de . e vice-versa
        if (abs(Pos('@', EMail) - Pos('.', EMail)) = 1) then
          Result := False
        else
          begin
            for i := 1 to 40 do            // se existe Caracter Especial
              if Pos(CaraEsp[i], EMail)<>0 then
                Result := False;
            for i := 1 to length(EMail) do
            begin                                 // se existe apenas 1 @
              if EMail[i] = '@' then
                cont := cont + 1;                    // . seguidos de .
              if (EMail[i] = '.') and (EMail[i+1] = '.') then
                Result := false;
            end;
                                   // . no f, 2ou+ @, . no i, - no i, _ no i
            if (cont >=2) or ( EMail[length(EMail)]= '.' )
              or ( EMail[1]= '.' ) or ( EMail[1]= '_' )
              or ( EMail[1]= '-' )  then
                Result := false;
                                            // @ seguido de COM e vice-versa
            if (abs(Pos('@', EMail) - Pos('com', EMail)) = 1) then
              if (Pos('@com', EMail) + 4) = Length(EMail) then //@com somente no final
                Result := False;
                                              //@com. como provedor
              if (Pos('@com.', EMail) > 0) then
                Result := False;
                                              // @ seguido de - e vice-versa
            if ((Pos('@', EMail) - Pos('-', EMail)) = -1) then
              Result := False;
                                              // @ seguido de _ e vice-versa
//            if (abs(Pos('@', EMail) - Pos('_', EMail)) = 1) then
//              Result := False;
          end;
    end
    else
      Result := False;
end;

function TSingleton.verificaImagemBD(
  ABuscas: TIBQuery;
  pCodEmpresa: Integer;
	ACompression: integer;
  var AInFile: string;
  var AOutFile: string): Integer;
var
	iCompression : integer;
  oJPG : TJPegImage;
  oBMP: TBitMap;

	vMD5: string;
begin
	try
  	try
      Result := 0;

      if not DirectoryExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas') then
        CreateDir(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas');

      if not DirectoryExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas') then
      begin
      	Application.MessageBox(PChar('Falha ao criar diretório: ' + #13 +
        	_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not DirectoryExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg') then
        CreateDir(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg');

      if not DirectoryExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg') then
      begin
      	Application.MessageBox(PChar('Falha ao criar diretório: ' + #13 +
        	_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not DirectoryExists(ExtractFileDir(AInFile)) then
      begin
        Application.MessageBox(PChar('Diretório não encontrado: ' + #13 +
        	ExtractFileDir(AInFile)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not FileExists(AInFile) then
      begin
        Application.MessageBox(PChar('Arquivo não encontrado: ' + #13 +
        	AInFile), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not DirectoryExists(ExtractFileDir(AOutFile)) then
      begin
        Application.MessageBox(PChar('Diretório não encontrado: ' + #13 +
        	ExtractFileDir(AOutFile)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      vMD5 := _getMd5File(AInFile);

      ABuscas.Close;
      ABuscas.SQL.Text := ' SELECT FIRST 1 COD_IMG FROM IMAGENS_DOC ' +
        ' WHERE MD5 = :MD5 ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ';
      ABuscas.ParamByName('MD5').AsString := vMD5;
      ABuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      ABuscas.Open;

      Result := ABuscas.FieldByName('COD_IMG').AsInteger;

      if Result > 0 then
        exit;

      if LowerCase(trim(ExtractFileExt(AInFile))) = '.bmp' then
      begin
        AInFile  := BmpToJpg(AInFile);
        AOutFile := ChangeFileExt(AOutFile, '.jpg');

        vMD5 := _getMd5File(AInFile);

        ABuscas.Close;
        ABuscas.SQL.Text := ' SELECT COD_IMG FROM IMAGENS_DOC ' +
          ' WHERE MD5 = :MD5 ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ';
        ABuscas.ParamByName('MD5').AsString := vMD5;
        ABuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
        ABuscas.Open;

        Result := ABuscas.FieldByName('COD_IMG').AsInteger;

        if Result > 0 then
          exit;
      end;

      try
        iCompression := abs(ACompression);
        if iCompression = 0 then
          iCompression := 1;
        if iCompression > 100 then
          iCompression := 100;

        // Cria as classes de trabalho Jpeg e Bmp
        oJPG := TJPegImage.Create;
        oJPG.LoadFromFile(AInFile);

        oBMP := TBitMap.Create;
        oBMP.Assign(oJPG);

        // Fazer a compressão e salva o novo arquivo
        oJPG.CompressionQuality := iCompression;
        oJPG.Compress;

        if FileExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile)) then
          DeleteFile(PChar(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile)));

        if FileExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile)) then
          exit;

      	oJPG.SaveToFile(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile));

      	vMD5 := _getMd5File(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile));
      except
      	vMD5 := _getMd5File(AInFile);
      end;

      ABuscas.Close;
      ABuscas.SQL.Text := ' SELECT FIRST 1 COD_IMG FROM IMAGENS_DOC ' +
        ' WHERE MD5 = :MD5 ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ';
      ABuscas.ParamByName('MD5').AsString := vMD5;
      ABuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      ABuscas.Open;

      Result := ABuscas.FieldByName('COD_IMG').AsInteger;
    except on E: Exception do
      begin
      	Application.MessageBox(pchar(
        	'Falha ao verificar imagem: ' + #13 + #13 +
          'ARQUIVO' + #13 +
          'de ' + AInFile + #13 +
          'para ' + _getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile) + #13 + #13 +
          'Erro: ' + e.Message), pchar('Erro'), MB_ICONERROR + MB_OK);
        registraErro('Falha ao verificar imagem ' + E.Message);
        Result := 0;
      end;
    end;
  finally
    if FileExists(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile)) then
      DeleteFile(PChar(_getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\TempImg\' + ExtractFileName(AOutFile)));
  end;
end;

function TSingleton.verificaParametrosLogin(var usuario,
