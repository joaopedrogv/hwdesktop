function TSingleton.retornaMaxOrdemPromocao: Integer;
var
  Con: TConexao;
begin
  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    SqlOpen(' SELECT FIRST 1 * FROM ( ' +
            '   SELECT MAX(COALESCE(ORDEM, 0)) ORDEM FROM PROMOCAO ' +
            '   WHERE COD_PROMOCAO > 0 ' +
            '   AND COD_EMPRESA = ' + codEmpresa +
            '   AND ATIVO = 1 ' +
            '   UNION ALL ' +
            '   SELECT MAX(COALESCE(ORDEM, 0)) ORDEM FROM PROMOCAO ' +
            '   WHERE COD_PROMOCAO > 0 ' +
            '   AND COD_EMPRESA = ' + codEmpresa +
            '   AND ATIVO <> 99 ' +
            '   AND PADRAO = ''S'' ' +
            ' ) ' +
            ' ORDER BY 1 DESC ', Con.QrAux);

    Result := Con.QrAux.FieldByName('ORDEM').AsInteger;
  finally
  	 if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

