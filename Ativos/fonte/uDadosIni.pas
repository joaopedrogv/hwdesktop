begin
  for I := 0 to ParamCount do
  begin
    temp := ParamStr(i);
    if decodifica(copy(temp, 1, 2)) = '-u' then
      usuario := decodifica(Copy(temp, 3, length(temp)))
    else if decodifica(copy(temp, 1, 2)) = '-s' then
      senha := decodifica(Copy(temp, 3, length(temp)))
    else if decodifica(copy(temp, 1, 2)) = '-p' then
