function TSingleton.PesqPros(var Alist: THw_auditoria_classList; Aquery: TIBQuery): Boolean;
const
  Amsg_senha_invalida: string = 'Usuário ou senha inválida ' + sLineBreak + 'Verifique se o usuário está ativo e tem permissão de acesso na empresa';
var
  Aaux_sql  : string;
  Aprcs     : TTabela_processos_classList;
  Aexs_us   : TTabela_processos_usuarios_classList;
  Aexs_ger  : TTabela_processos_usuarios_classList;
  Aliberado : THw_auditoria_classList;
  Anegado   : THw_auditoria_classList;
  Apendente : THw_auditoria_classList;
  Asolits   : TSolicitacoes_acesso_classList;
  Auser_at  : TSenhas_class;
  Auser_ger : TSenhas_class;
  I, J      : Integer;
  Avalid    : Boolean;
  Amsg, Astr: string;
  Alotesol  : Integer;
  Aexec     : TIBQuery;
  Atran     : TIBTransaction;

  {$REGION 'montando listas'}
  procedure montar_listas(Auser: TSenhas_class; Aexs: TTabela_processos_usuarios_classList; AcheckGeren: Boolean);
  var
    A, B : Integer;
    Aitem: THw_auditoria_class;
  begin
    Aliberado.Clear;
    Apendente.Clear;
    Anegado.Clear;
    for A := 0 to Pred(Alist.Count) do
    begin
      Aitem  := Alist.Items[A];

      if ((not AcheckGeren) and (Aitem.status = '')) or           //primeiro momento da validacao
         ((    AcheckGeren) and (Aitem.status = 'Pendente')) then //segunda etapa apos a digitacao da senha do gerente
        for B := 0 to Pred(Aexs.Count) do with Aprcs.Items[B] do
          if cod_processo = Aitem.cod_processo then
          begin
            Aitem.status := 'Liberado';
            Break;
          end;

      if strIn(Aitem.status, ['', 'Pendente']) then
        for B := 0 to Pred(Aprcs.Count) do with Aprcs.Items[B] do
          if cod_processo = Aitem.cod_processo then
          begin
            if (not AcheckGeren) and (senha_gerente = 'S') then
              Aitem.status := 'Pendente'
            else if (nivel_processo <= Auser.nivel_us) then
            begin
              Aitem.status := 'Liberado';
              Aitem.usuario_lib := IfThen(AcheckGeren, Auser.usuario, Aitem.usuario_lib);
            end
            else
              Aitem.status := 'Negado';
            Break;
          end;

      case IndexText(Aitem.status, ['Liberado', 'Pendente']) of
        0 :  Aliberado.Add(Aitem.Clone);
        1 :  Apendente.Add(Aitem.Clone);
        else Anegado.Add(Aitem.Clone);
      end;
    end;
  end;
  {$ENDREGION}
begin
  if Aquery = nil then
    Aquery := dtmAtivo.qrAudit;
//  SqlOpen()
  if Alist.Mensagem.Count > 0 then
    ShowAtencao(Alist.Mensagem.Text);

  Result := False;
  Aaux_sql := '';
  for I := 0 to Pred(Alist.Count) do with Alist.Items[I] do
    Aaux_sql := Aaux_sql + StrUtils.IfThen(I = 0, '(') + QuotedStr(cod_processo) + StrUtils.IfThen(Pred(Alist.Count) = I, ')', ',');

  Aprcs     := TTabela_processos_classList.Create;
  Aexs_us   := TTabela_processos_usuarios_classList.Create;
  Aliberado := THw_auditoria_classList.Create;
  Apendente := THw_auditoria_classList.Create;
  Anegado   := THw_auditoria_classList.Create;
  Auser_at  := TSenhas_class.Create;
  try
    Auser_at.SetValuesFrom(SqlOpen('select %s from senhas where usuario = %s and cod_empresa = %s and ativo = 1', [TSenhas_class.GetFieldsSql(), QuotedStr(vNomeUsuario), codEmpresa], Aquery) );

    Aprcs.SetValuesFrom(SqlOpen('select %s from TABELA_PROCESSOS where cod_processo in %s and cod_empresa = %s',
                                [TTabela_processos_class.GetFieldsSql(), Aaux_sql, codEmpresa], Aquery));

    Aexs_us.SetValuesFrom(SqlOpen('select %s from TABELA_PROCESSOS_USUARIOS where cod_processo in %s and cod_empresa = %s and usuario = %s',
                                [TTabela_processos_usuarios_class.GetFieldsSql(), Aaux_sql, codEmpresa, QuotedStr(vNomeUsuario)], Aquery));

    for I := 0 to Pred(Alist.Count) do
    begin 
      Alist.Items[I].usuario := vNomeUsuario;
      for J := 0 to Pred(Aprcs.Count) do if Alist.Items[I].cod_processo = Aprcs.Items[J].cod_processo then
      begin
        Alist.Items[I].nome_processo := Aprcs.Items[J].nome_processo;
        Break;
      end;
    end;

    montar_listas(Auser_at, Aexs_us, False);

    try

      if Anegado.Count > 0 then
        Exit;

      if Apendente.Count = 0 then
        Exit;

      Atran := TIBTransaction.Create(nil);
      Atran.DefaultDatabase := Aquery.Database;

      Aexec := TIBQuery.Create(nil);
      Aexec.Transaction := Atran;
      try
        Asolits := TSolicitacoes_acesso_classList.Create;
        Alotesol := SqlOpen('select cod from incrementa_codigo(%s, %s)', [codEmpresa, QuotedStr('SOLICITACOES_ACESSO_LOTE')], Aexec).FieldByName('cod').AsInteger;
        for I := 0 to Alist.Count - 1 do if Alist.Items[I].status = 'Pendente' then                                         
          with Asolits.New do
          begin
            cod_solicitacao     := SqlOpen('select cod, (select fh.current_ts from sp_current_ts(%d) fh) datahora from incrementa_codigo(%s, %s)',
                                           [cod_empresa, codEmpresa, QuotedStr('SOLICITACOES_ACESSO')], Aexec).FieldByName('cod').AsInteger;
            cod_empresa         := StrToInt(codEmpresa);
            usuario_solicitante := vNomeUsuario;
            data_solicitacao    := Aexec.FieldByName('datahora').AsDateTime;
            processo            := Alist.Items[I].cod_processo;
            mensagem            := Alist.Items[I].mensagem;
            lote                := Alotesol;

            Alist.Items[I].id   := cod_solicitacao;
          end;
        Astr := 'cod_solicitacao, cod_empresa, usuario_solicitante, data_solicitacao, processo, mensagem, lote';
        Aexec.Close;
        Aexec.SQL.Text := Format('insert into SOLICITACOES_ACESSO (%s) values (:%s)',
                                 [Astr, StringReplace(Astr, ', ', ', :', [rfReplaceAll])]);
        for I := 0 to Pred(Asolits.Count) do
          Asolits.Items[I].SetValuesInParams(Aexec, True).ExecSQL;
        if Aexec.Transaction.InTransaction then
          Aexec.Transaction.Commit;

        Auser_ger := TSenhas_class.Create;
        Aexs_ger  := TTabela_processos_usuarios_classList.Create;

        if Assigned(frmPesqPros_lote) then
          FreeAndNil(frmPesqPros_lote);

        Application.CreateForm(TfrmPesqPros_lote, frmPesqPros_lote);
        frmPesqPros_lote.ed_user.Text := vNomeUsuario;
        while True do with frmPesqPros_lote do
        begin
          loteLib.popular(Apendente, Aprcs);
          lb_lote.Caption := Format('LOTE: %d', [Alotesol]);

          case ShowModal of
            mrOk :
            begin
              Amsg := '';

              if modal_origem = 'LIB' then
              begin
                Asolits.Clear;
                Asolits.SetValuesFrom(SqlOpen('select %s from SOLICITACOES_ACESSO where lote = %d and cod_empresa = %s',
                                              [TSolicitacoes_acesso_class.GetFieldsSql(), Alotesol, codEmpresa], Aquery));
                for I := 0 to Pred(Asolits.Count) do
                  if Asolits.Items[I].usuario_gerente = '' then
                    Amsg := 'Existem solicitações pendentes'
                  else
                    for J := 0 to Pred(Alist.Count) do
                      if Alist.Items[J].id = Asolits.Items[I].cod_solicitacao then
                      begin
                        Alist.Items[J].usuario_lib := Asolits.Items[I].usuario_gerente;
                        Alist.Items[J].status      := 'Liberado';
                        Break;
                      end;

                montar_listas(Auser_at, Aexs_us, False);
                if Amsg <> ''  then
                  ShowErro(Amsg)
                else
                  Break;
              end
              else if modal_origem = 'OK' then
              begin

                Auser_ger.SetValuesFrom(SqlOpen('select %s from senhas where usuario = %s and cod_empresa = %s and ativo = 1', [TSenhas_class.GetFieldsSql(), QuotedStr(ed_user.Text), codEmpresa], Aquery));
                if (Auser_ger.usuario = ed_user.Text) and (Auser_ger.emp_padrao > 0) and (Auser_ger.emp_padrao <> Auser_ger.cod_empresa) then
                begin
                  Auser_ger.SetValuesFrom(SqlOpen('select %s from senhas where usuario = %s and cod_empresa = %d', [TSenhas_class.GetFieldsSql(), QuotedStr(ed_user.Text), Auser_ger.emp_padrao], Aquery));
                  if (Auser_ger.usuario = '') or (Auser_ger.ativo <> 1) then
                    Amsg := Amsg_senha_invalida;
                end;

                if (Amsg = '') and ((Auser_ger.usuario = '') or (Auser_ger.usuario <> ed_user.Text) or (decodifica(Auser_ger.senha) <> ed_pass.Text)) then
                  Amsg := Amsg_senha_invalida;

                if Amsg <> ''  then
                  ShowErro(Amsg)
                else
                begin
                  Aexs_ger.SetValuesFrom(SqlOpen('select %s from TABELA_PROCESSOS_USUARIOS where cod_processo in %s and cod_empresa = %s and usuario = %s',
                                                 [TTabela_processos_usuarios_class.GetFieldsSql(), Aaux_sql, codEmpresa, QuotedStr(Auser_ger.usuario)], Aquery));
                  //percorrer a lista das liberacoes e permitir de acordo o nivel do usuário
                  montar_listas(Auser_ger, Aexs_ger, True);
                  Break;
                end;
              end;

            end;
            else
              Break;
          end;
        end;

      finally
        SqlExec('delete from SOLICITACOES_ACESSO where lote = %d and cod_empresa = %s', [Alotesol, codEmpresa], Aexec);
        if Aexec.Transaction.InTransaction then
          Aexec.Transaction.Commit;
      end;

    finally  
      if (Apendente.Count > 0) or (Anegado.Count > 0) then
        Result := False
      else
      begin
        Result := True;

        if (vEmp.vUsarAuditoria = 'S') and (bancoConectado <> 'local') then
          for I := 0 to Pred(Alist.Count) do with Alist.Items[I] do if gravar then
            gravarAuditoria(PChar(usuario),
                            PChar(usuario_lib),
                            PChar(cod_processo),
                            PChar(acao),
                            PChar(nome_processo + ' - ' + mensagem),
                            PChar(tabela),
                            PChar(codigo),
                            PChar(codEmpresa));
      end;
    end;

  finally
    if Assigned(Auser_at)  then FreeAndNil(Auser_at);
    if Assigned(Auser_ger)  then FreeAndNil(Auser_ger);
    if Assigned(Aexs_us)  then FreeAndNil(Aexs_us);
    if Assigned(Aexs_ger)  then FreeAndNil(Aexs_ger);
    if Assigned(Aprcs)     then FreeAndNil(Aprcs);
    if Assigned(Aliberado) then FreeAndNil(Aliberado);
    if Assigned(Apendente) then FreeAndNil(Apendente);
    if Assigned(Anegado)   then FreeAndNil(Anegado);
    if Assigned(Asolits)   then FreeAndNil(Asolits);
    if Assigned(Aexec)     then FreeAndNil(Aexec);
    if Assigned(Atran)     then FreeAndNil(Atran);
  end;
end;

function TSingleton.PesqPros(vCodProcesso, vAcao, vMensagem, vTabela,
  vCodigoTabMov: string; qrBusca: TIBQuery; vGravarAuditoria, pConfirmarContinuacao, pInibePesqPros: Boolean; pDepartamento: string): boolean;
var
  vUsarSenhaGerente, vNomeProcesso, vGravAuditoriaProcesso: string;
  vNivelProcesso, vCodEmpPadrao: Integer;
  vCodLiberacao: Integer;
  vDataHoraBanco: TDateTime;
  buscasGrav: TIBQuery;
  ibtransGrav: TIBTransaction;
begin
  if qrBusca = nil then
    qrBusca := dtmAtivo.qrAudit;
  try
    if pInibePesqPros then
      vInibeMensPesqPros := 'S';
    qrBusca.Close;
    qrBusca.SQL.Text :=
      ' select NIVEL_PROCESSO,NOME_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA from TABELA_PROCESSOS ' +
      ' where COD_PROCESSO = ' + quotedstr(vCodProcesso) +
      ' AND COD_EMPRESA = ' + CodEmpresa +
      ' AND ATIVO = 1';
    qrBusca.open;
    if qrBusca.IsEmpty then
    begin
      try
        if not Assigned(vSetTabPro) then
          vSetTabPro := TSetTabelaProcessos.create;

        vSetTabPro.verificar_processo(vCodProcesso, codEmpresa, qrBusca);
      except

      end;
      qrBusca.Close;
      qrBusca.Open;
      if qrBusca.IsEmpty then
      begin
        Application.MessageBox(pchar('Processo ' + vCodProcesso + ' não definido na tabela de Processos'),
          'Erro', MB_ICONINFORMATION + MB_OK);
        Result := False;
        exit;
      end;
    end;
    vUsarSenhaGerente := qrBusca.FieldByName('senha_gerente').AsString;
    vNivelProcesso := qrBusca.FieldByName('nivel_processo').AsInteger;
    vNomeProcesso := qrBusca.FieldByName('nome_processo').AsString;
    vGravAuditoriaProcesso := qrBusca.FieldByName('GRAVAR_AUDITORIA').AsString;

    vUsuarioAutorizou := '';
    vNivelGerente := 0;
    vPercProdVnd := 0;
    if ((vUsarSenhaGerente = 'S') or (trim(pDepartamento) <> '')) then
    begin
      if (vSistema <> 'Fiscal') or (vTipoConexao <> 'off') then
      begin
      ibtransGrav := TIBTransaction.Create(Application);
      ibtransGrav.DefaultAction := TACommit;
      ibtransGrav.Active := False;
      ibtransGrav.AllowAutoStart := True;
      ibtransGrav.AutoStopAction := saNone;
      ibtransGrav.DefaultDatabase := qrBusca.Database;
      ibtransGrav.Params.Clear;
      ibtransGrav.Params.Add('read_committed');
   	  ibtransGrav.Params.Add('rec_version');
      ibtransGrav.Params.Add('nowait');

      buscasGrav := TIBQuery.Create(Application);
    	buscasGrav.Database := qrBusca.Database;
    	buscasGrav.Transaction := ibtransGrav;
      end;

      if Assigned(FrmPesqPros) then
        FreeAndNil(FrmPesqPros);

      Application.CreateForm(TFRMPesqPros, FRMPesqPros);
      FRMPesqPros.Caption := '[' + vCodProcesso + '] - Liberação de Acesso Gerência';
      FrmPesqPros.Panel2.Caption := Trim(vNomeProcesso);
      if vModoTreino = 'S' then
      begin
        FRMPesqPros.MaskEdit1.Text := 'HW';
        FRMPesqPros.MaskEdit2.Text := 'EUJJ'; // nao faz diferensa a senha ser diferente pois logo abaixo o sistema nao pesquisa pela senha
      end
      else
        FRMPesqPros.MaskEdit1.Text := vNomeUsuario;
      FRMPesqPros.MaskEdit1.Enabled := vCodProcesso <> 'PRC014';

      if (vSistema <> 'Fiscal') or (vTipoConexao <> 'off') then
      begin
      vCodLiberacao := Gencodigo('SOLICITACOES_ACESSO', buscasGrav, codEmpresa);
      vDataHoraBanco := getDataHoraBanco(buscasGrav);

      buscasGrav.Close;
      buscasGrav.SQL.Text := ' INSERT INTO SOLICITACOES_ACESSO (COD_SOLICITACAO, COD_EMPRESA, USUARIO_SOLICITANTE, ' +
      	' DATA_SOLICITACAO, PROCESSO, MENSAGEM, USUARIO_GERENTE) ' +
         ' VALUES (:COD_SOLICITACAO, :COD_EMPRESA, :USUARIO_SOLICITANTE, ' +
      	' :DATA_SOLICITACAO, :PROCESSO, :MENSAGEM, :USUARIO_GERENTE);';
      buscasGrav.ParamByName('COD_SOLICITACAO').AsInteger := vCodLiberacao;
      buscasGrav.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscasGrav.ParamByName('USUARIO_SOLICITANTE').AsString := vNomeUsuario;
      buscasGrav.ParamByName('DATA_SOLICITACAO').AsDateTime := vDataHoraBanco;
      buscasGrav.ParamByName('PROCESSO').AsString := vCodProcesso;
      buscasGrav.ParamByName('MENSAGEM').AsString := vNomeProcesso;
      buscasGrav.ExecSQL;
      buscasGrav.Transaction.Commit;

      FRMPesqPros.Tag := vCodLiberacao;
      FrmPesqPros.Label3.Caption := 'COD LIB: ' + IntToStr(vCodLiberacao);
      FrmPesqPros.BitBtn3.Visible := True;
      end
      else
      begin
        FrmPesqPros.Label3.Caption := '';
        FrmPesqPros.BitBtn3.Visible := False;
      end;
      FRMPesqPros.ShowModal;
      if FRMPesqPros.ModalResult <> mrOk then
      begin
        if (vSistema <> 'Fiscal') or (vTipoConexao <> 'off') then
        begin
        buscasGrav.Close;
        buscasGrav.SQL.Text := 'DELETE FROM SOLICITACOES_ACESSO ' +
          ' WHERE COD_SOLICITACAO = :COD_SOLICITACAO AND COD_EMPRESA = :COD_EMPRESA ';
        buscasGrav.ParamByName('COD_SOLICITACAO').AsInteger := vCodLiberacao;
	     buscasGrav.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        buscasGrav.ExecSQL;
        buscasGrav.Transaction.Commit;
        end;

        Result := False;
        Exit;
      end;

      qrBusca.Close;
      qrBusca.SQL.Text := ' select * from senhas s ' +
        ' inner join empresa emp on emp.cod_empresa = s.emp_padrao ' +
        ' where s.usuario = ' + QuotedStr(Trim(FRMPesqPros.MaskEdit1.Text)) +
        ' and s.emp_padrao > 0 and s.ativo = 1 and s.cod_empresa = ' + codEmpresa +
        ' and ((select count(*) from senhas s2 where s2.usuario = s.usuario and s2.cod_empresa = s.emp_padrao) > 0) ';
      qrBusca.Open;
      if qrBusca.FieldByName('emp_padrao').AsInteger  > 0 then
        vCodEmpPadrao := qrBusca.FieldByName('emp_padrao').AsInteger
      else
        vCodEmpPadrao := StrToInt(codEmpresa);

      if trim(pDepartamento) = '' then
      begin
        qrBusca.Close;
        qrBusca.SQL.Text := ' SELECT S.NIVEL_US, S.USUARIO, S.ATIVO, COL.PC_VEND_PROD FROM SENHAS S ' +
        	' LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = S.CODIGO AND COL.COD_EMPRESA = S.COD_EMPRESA ' +
          ' where S.USUARIO = ' + QuotedStr(Trim(FRMPesqPros.MaskEdit1.Text)) +
          ' and S.COD_EMPRESA = ' + IntToStr(vCodEmpPadrao);
        if vModoTreino <> 'S' then
          qrBusca.SQL.Text :=  qrBusca.SQL.Text +  ' and S.SENHA = ' + QuotedStr(codifica(Trim(FRMPesqPros.MaskEdit2.Text)));
        qrBusca.Open;
      end
      else
      begin
        qrBusca.Close;
        qrBusca.SQL.Text := ' SELECT S.NIVEL_US, S.USUARIO, S.ATIVO, D.NOME_DEPTO, COL.PC_VEND_PROD FROM SENHAS S ' +
          ' INNER JOIN COLABORADOR COL ON COL.COD_VENDEDOR = S.CODIGO AND COL.COD_EMPRESA = S.COD_EMPRESA ' +
          ' INNER JOIN FUNCOES F ON F.COD_FUNCAO = COL.COD_FUNCAO ' +
          ' LEFT JOIN DEPTO D ON D.COD_DEPTO = F.COD_DEPTO ' +
          ' where S.USUARIO = ' + QuotedStr(Trim(FRMPesqPros.MaskEdit1.Text)) +
          ' and S.COD_EMPRESA = ' + IntToStr(vCodEmpPadrao);
        if vModoTreino <> 'S' then
          qrBusca.SQL.Text :=  qrBusca.SQL.Text +  ' and S.SENHA = ' + QuotedStr(codifica(Trim(FRMPesqPros.MaskEdit2.Text)));
        qrBusca.Open;
      end;

      if qrBusca.IsEmpty then
      begin
       Application.MessageBox(pchar('Senha inválida para o usuário!'), 'Erro', MB_ICONERROR + MB_OK);
        Result := False;
        Exit;
      end;

      vUsuarioAutorizou := qrBusca.FieldByName('USUARIO').AsString;

      if (StrToInt(codEmpresa) = vCodEmpPadrao) and (qrBusca.FieldByName('ativo').AsInteger = 1) then
      begin
        vNivelGerente := qrBusca.FieldByName('NIVEL_US').AsInteger;
        vPercProdVnd := qrBusca.FieldByName('PC_VEND_PROD').AsFloat;

        // Testar departamento
        if trim(pDepartamento) <> '' then
        begin
          if vNivelProcesso >= vNivelGerente then
          begin
             if vNivelGerente = 10 then
             begin
               Result := True;
               Exit;
             end
             else if UpperCase(trim(pDepartamento)) <> UpperCase(trim(qrBusca.FieldByName('NOME_DEPTO').AsString)) then
             begin
               Application.MessageBox(pchar('Usuário não pertence ao departamento ' +
                 QuotedStr(UpperCase(Trim(pDepartamento)))), 'Erro', MB_ICONERROR + MB_OK);
               Result := False;
               Exit;
             end;
          end;
        end;
      end
      else
      begin
        qrBusca.Close;
        qrBusca.SQL.Text := ' select S.NIVEL_US, S.USUARIO, COL.PC_VEND_PROD from SENHAS S ' +
          ' LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = S.CODIGO AND COL.COD_EMPRESA = S.COD_EMPRESA ' +
          ' where S.USUARIO = ' + QuotedStr(Trim(FRMPesqPros.MaskEdit1.Text)) +
          ' and S.ativo = 1 and S.COD_EMPRESA = ' + codEmpresa;
        qrBusca.Open;

        if qrBusca.IsEmpty then
        begin
          Application.MessageBox(pchar('Usuário não tem acesso a esta empresa!'), 'Erro', MB_ICONERROR + MB_OK);
          Result := False;
          Exit;
        end;
        vNivelGerente := qrBusca.FieldByName('NIVEL_US').AsInteger;
        vPercProdVnd := qrBusca.FieldByName('PC_VEND_PROD').AsFloat;
      end;

//      qrBusca.Close;
//      Agora ja existe um usuario HW para cada empresa
//      if Trim(FRMPesqPros.MaskEdit1.Text) = 'HW' then
//        qrBusca.SQL.Text := 'select NIVEL_US, USUARIO from SENHAS where USUARIO = ''' +
//          trim(FRMPesqPros.MaskEdit1.Text) + ''' and SENHA = ''' +
//          codifica(FRMPesqPros.MaskEdit2.Text)
//          +
//          ''' AND ATIVO = 1 '
//      else
//        qrBusca.SQL.Text := 'select NIVEL_US, USUARIO from SENHAS where USUARIO = ''' +
//          trim(FRMPesqPros.MaskEdit1.Text) + ''' and SENHA = ''' +
//          codifica(FRMPesqPros.MaskEdit2.Text) +
//          ''' AND COD_EMPRESA = ''' + codEmpresa + ''' AND ATIVO = 1 ';
//      qrBusca.Open;
//      if qrBusca.IsEmpty then
//      begin
//       Application.MessageBox(pchar('Senha inválida para o usuário!'), 'Erro', MB_ICONERROR
//          + MB_OK);
//        Result := False;
//        Exit;
//      end;
//      vUsuarioAutorizou := qrBusca.FieldByName('USUARIO').AsString;
//      vNivelGerente := qrBusca.FieldByName('NIVEL_US').AsInteger;
      if vNivelProcesso > vNivelGerente then
      begin
        qrBusca.Close;
        qrBusca.SQL.Text := ' SELECT 1 FIRST FROM TABELA_PROCESSOS T ' +
          ' INNER JOIN TABELA_PROCESSOS_USUARIOS TU ON TU.COD_PROCESSO = T.COD_PROCESSO ' +
          ' AND TU.COD_EMPRESA = T.COD_EMPRESA ' +
          ' WHERE T.COD_EMPRESA = ' + codEmpresa + ' AND T.ATIVO = 1 ' +
          ' AND TU.USUARIO= ' + QuotedStr(trim(FRMPesqPros.MaskEdit1.Text)) +
	        ' AND T.COD_PROCESSO = ' + QuotedStr(vCodProcesso) + '';
        qrBusca.Open;

        if qrBusca.IsEmpty then
        begin
          Application.MessageBox(pchar('Processo não Permitido para o usuário' + #13 + #13 +
            'Código: ' + vCodProcesso + #13 +
            'Processo: ' + vNomeProcesso),
            'Erro', MB_ICONINFORMATION + MB_OK);
          Result := False;
          Exit;
        end;
      end;
      if pConfirmarContinuacao then
        if Application.MessageBox('Deseja continuar mesmo assim', 'Confirmação', MB_ICONQUESTION + MB_YESNO ) <> ID_YES then
        begin
          Result := False;
          Exit;
        end;
      if ((vGravarAuditoria) or (vGravAuditoriaProcesso = 'S')) and (vEmp.vUsarAuditoria = 'S') and
        (bancoConectado <> 'local') then
        gravarAuditoria(pchar(vNomeUsuario),
          pchar(vUsuarioAutorizou),
          pchar(vCodProcesso),
          pchar(vAcao),
          pchar(vNomeProcesso + ' - ' + vMensagem),
          pchar(vTabela),
          pchar(vCodigoTabMov),
          pchar(codEmpresa));

      if ((vUsarSenhaGerente = 'S') or (trim(pDepartamento) <> '')) then
      if (vSistema <> 'Fiscal') or (vTipoConexao <> 'off') then
      begin
        buscasGrav.Close;
        buscasGrav.SQL.Text := 'DELETE FROM SOLICITACOES_ACESSO ' +
          ' WHERE COD_SOLICITACAO = :COD_SOLICITACAO AND COD_EMPRESA = :COD_EMPRESA ';
        buscasGrav.ParamByName('COD_SOLICITACAO').AsInteger := vCodLiberacao;
        buscasGrav.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        buscasGrav.ExecSQL;
        buscasGrav.Transaction.Commit;
      end;

      Result := true;
      Exit;
    end;
    if vNivelProcesso > vNivel then
    begin
      qrBusca.Close;
      qrBusca.SQL.Text :=
        ' SELECT 1 FIRST FROM TABELA_PROCESSOS T '
        + ' INNER JOIN TABELA_PROCESSOS_USUARIOS TU ON TU.COD_PROCESSO = T.COD_PROCESSO '
        + ' AND TU.COD_EMPRESA = T.COD_EMPRESA '
        + ' WHERE T.COD_EMPRESA = ' + codEmpresa + ' AND T.ATIVO =1 AND TU.USUARIO=' +
        QuotedStr(vNomeUsuario) +
        ' AND T.COD_PROCESSO = ' + QuotedStr(vCodProcesso) + '';
      qrBusca.Open;

      if qrBusca.IsEmpty then
      begin
        if vInibeMensPesqPros <> 'S' then
          Application.MessageBox(pchar('Processo' +
            ' não Permitido para o usuário' + #13 + #13 +
            'Código: ' + vCodProcesso + #13 +
            'Processo: ' + vNomeProcesso),
            'Erro', MB_ICONINFORMATION + MB_OK)
        else
          vInibeMensPesqPros := '';

        Result := False;
        Exit;
      end;
    end;
    if pConfirmarContinuacao then
      if Application.MessageBox('Deseja continuar mesmo assim', 'Confirmação', MB_ICONQUESTION + MB_YESNO ) <> ID_YES then
      begin
        Result := False;
        Exit;
      end;
    if ((vGravarAuditoria) or (vGravAuditoriaProcesso = 'S')) and (vEmp.vUsarAuditoria = 'S') and
      (bancoConectado <> 'local') then
      gravarAuditoria(pchar(vNomeUsuario),
        pchar(vUsuarioAutorizou),
        pchar(vCodProcesso),
        pchar(vAcao),
        pchar(vNomeProcesso + ' - ' + vMensagem),
        pchar(vTabela),
        pchar(vCodigoTabMov),
        pchar(codEmpresa));
    Result := true;
    Exit;
  finally
    vInibeMensPesqPros := '';
    if buscasGrav <> nil then
    	FreeAndNil(buscasGrav);
    if ibtransGrav <> nil then
    	FreeAndNil(ibtransGrav); 
  end;

end;

