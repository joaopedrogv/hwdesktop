procedure TSingleton._AlterarFonteCrystalReport(var pCrpe: TCrpe);
var
	i, j: Integer;
  vFontName: string;
begin
	vFontName := 'Arial Narrow';
  
	for i := 0 to pCrpe.DatabaseFields.Count - 1 do
    pCrpe.DatabaseFields.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.Formulas.Count - 1 do
    pCrpe.Formulas.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.GroupNameFields.Count - 1 do
    pCrpe.GroupNameFields.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.ParamFields.Count - 1 do
    pCrpe.ParamFields.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.RunningTotals.Count - 1 do
    pCrpe.RunningTotals.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.SpecialFields.Count - 1 do
    pCrpe.SpecialFields.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.SQLExpressions.Count - 1 do
  	pCrpe.SQLExpressions.Items[I].Font.Name := vFontName;

	for i := 0 to pCrpe.SummaryFields.Count - 1 do
    pCrpe.SummaryFields.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.TextObjects.Count - 1 do
    pCrpe.TextObjects.Items[I].Font.Name := vFontName;

  for i := 0 to pCrpe.Subreports.Count - 1 do
  begin
  	for j := 0 to pCrpe.Subreports.Items[i].DatabaseFields.Count - 1 do
    	pCrpe.Subreports.Items[i].DatabaseFields.Items[j].Font.Name := vFontName;

  	for	j := 0 to pCrpe.Subreports.Items[i].Formulas.Count - 1 do
    	pCrpe.Subreports.Items[i].Formulas.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].GroupNameFields.Count - 1 do
      pCrpe.Subreports.Items[i].GroupNameFields.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].ParamFields.Count - 1 do
      pCrpe.Subreports.Items[i].ParamFields.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].RunningTotals.Count - 1 do
      pCrpe.Subreports.Items[i].RunningTotals.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].SpecialFields.Count - 1 do
      pCrpe.Subreports.Items[i].SpecialFields.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].SQLExpressions.Count - 1 do
    		pCrpe.Subreports.Items[i].SQLExpressions.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].SummaryFields.Count - 1 do
      pCrpe.Subreports.Items[i].SummaryFields.Items[j].Font.Name := vFontName;

    for j := 0 to pCrpe.Subreports.Items[i].TextObjects.Count - 1 do
      pCrpe.Subreports.Items[i].TextObjects.Items[j].Font.Name := vFontName;
  end;
end;

function TSingleton.apenasLetras(pTexto: string;
  CaseSensitive: Boolean): string;
var
  I: Integer;
  TextoU, TextoL: string;
begin
  Result := '';
  TextoU := UpperCase('ABCDEFGHIJKLMNOPQRSTUVXYWZ');
  TextoL := LowerCase('abcdefghijklmnopqrstuvxywz');

  for I := 1 to (Length(pTexto)) do
  begin
    if CaseSensitive then
    begin
      if (Pos(pTexto[I], TextoU) > 0) or (Pos(pTexto[I], TextoL) > 0) then
        Result := Result + pTexto[I];
    end
    else if Pos(UpperCase(pTexto[I]), TextoU) > 0 then
      Result := Result + pTexto[I];
  end;
end;

function TSingleton.apenasLetraseNumeros(pTexto: string;
  CaseSensitive: Boolean): string;
 var
  I: Integer;
  TextoU, TextoL: string;
begin
  Result := '';
  TextoU := UpperCase('ABCDEFGHIJKLMNOPQRSTUVXYWZ1234567890');
  TextoL := LowerCase('abcdefghijklmnopqrstuvxywz1234567890');

  for I := 1 to (Length(pTexto)) do
  begin
    if CaseSensitive then
    begin
      if (Pos(pTexto[I], TextoU) > 0) or (Pos(pTexto[I], TextoL) > 0) then
        Result := Result + pTexto[I];
    end
    else if Pos(UpperCase(pTexto[I]), TextoU) > 0 then
      Result := Result + pTexto[I];
  end;
end;

function TSingleton.apenasNumeros(pTexto: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to (Length(pTexto)) do
    if Pos(pTexto[I], '0123456789') > 0 then
      Result := Result + pTexto[I];
end;

