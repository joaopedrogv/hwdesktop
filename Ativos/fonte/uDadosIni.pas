function TSingleton.abreFormI(pCaption: string; pPanelConteudo: TPanel; pOpcoesForm: TOpcoesFoms): Integer;
var
	vFormulario: TFrmPadrao;
  vParent: TWinControl;
  fKeyDownEvent: TKeyEvent;
  vPanelVisible: Boolean;
  vFormK: TForm_;
  vH_Control, vW_Control: Integer;
  vA_Control: TAlign;
  AregStoreMaximized: string;
  AControl: TWinControl;
begin
  try
    AregStoreMaximized := '';
    if not (ofMaximized in pOpcoesForm) then // sem parametro para maximizar janela
      if (ofStoreMaximized in pOpcoesForm) and (Assigned(pPanelConteudo.Parent)) then // parametro para armazenar a situação do formulário, maximizado ou não
      begin
        AregStoreMaximized := pPanelConteudo.Name; // salvando o nome do parametro para deixar no registro e localizar futuramente
        AControl := pPanelConteudo.Parent;
        while Assigned(AControl) do
        begin
          if not Assigned(AControl.Parent) then // quando o parent for nulo quer dizer q ja é o form
            AregStoreMaximized := AControl.Name + '.' + AregStoreMaximized;
          if Assigned(AControl.Parent) then
            AControl := AControl.Parent
          else
            AControl := nil;
        end;
        if _LerConfiguracoesRegistroString(AregStoreMaximized, '') = 'S' then
          pOpcoesForm := pOpcoesForm + [ofMaximized];
      end;

  	vFormulario := TFrmPadrao.Create(Application);
    vFormulario.ClientWidth := pPanelConteudo.Width;
    vFormulario.ClientHeight := pPanelConteudo.Height;
    vFormulario.Position := poScreenCenter;
    vFormulario.Caption := pCaption;
    vPanelVisible := pPanelConteudo.Visible;
    pPanelConteudo.Visible := True;
    vParent := pPanelConteudo.Parent;
    pPanelConteudo.Parent := vFormulario;
    vFormulario.AutoSize := ofAutoSize in pOpcoesForm;
    vFormulario.AutoScroll := ofAutoScroll in pOpcoesForm;
    vFormulario.ShowHint := True;
    vFormulario.BorderStyle := bsSingle;
    vFormulario.KeyPreview := True;
    if ofBISystemMenuOff in pOpcoesForm then
      vFormulario.BorderIcons := vFormulario.BorderIcons - [biSystemMenu];
    if ofBIMinimizeOff in pOpcoesForm then
      vFormulario.BorderIcons := vFormulario.BorderIcons - [biMinimize];
    if ofBIMaximizeOff in pOpcoesForm then
      vFormulario.BorderIcons := vFormulario.BorderIcons - [biMaximize];

    if ofMaximized in pOpcoesForm then
    begin
      vFormulario.WindowState := wsMaximized;
      vFormulario.BorderIcons := [biSystemMenu, biMaximize];
    end;

    if ofEscapeExit in pOpcoesForm then
    begin
      vFormulario.OnKeyDown := vFormK.FormKeyDown;
    end;

    if ofAlignAllClientWinCtrl in pOpcoesForm then
    begin
      vH_Control := pPanelConteudo.Height;
      vW_Control := pPanelConteudo.Width;
      vA_Control := pPanelConteudo.Align;
      pPanelConteudo.Align := alClient;
    end;

    Result := (vFormulario.ShowModal);// = mrOk);
  finally
    if AregStoreMaximized <> '' then
      _GravaConfiguracoesString(AregStoreMaximized, StrUtils.IfThen(vFormulario.WindowState = wsMaximized, 'S'));

    pPanelConteudo.Visible := vPanelVisible;
    pPanelConteudo.Parent := vParent;
    if ofAlignAllClientWinCtrl in pOpcoesForm then
    begin
      pPanelConteudo.Align := vA_Control;
      pPanelConteudo.Height := vH_Control;
      pPanelConteudo.Width := vW_Control;
    end;
    FreeAndNil(vFormulario);
  end;
end;

