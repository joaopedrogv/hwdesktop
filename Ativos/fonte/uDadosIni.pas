procedure TSingleton.configurarGridPeloConfigColunas(PGridCfg, PGridCfg2: TDBGrid; PcdsGrid: TClientDataSet; PcdsColunas: TClientDataSet; Pusuario: string; pListGridsAndDataSets: TStrings; ptrans: TIBTransaction; pAlterarNomeDtSet: string = '');
var
  I, J, Indice: Integer;
  Field: TField;
  FieldName: string;
  Visivel: Boolean;
  Column: TColumn;
  List, ListDelete: TStrings;
begin
  if PGridCfg = nil then
    Exit;
  PGridCfg2 := TDBGrid(PGridCfg);
  if not Assigned(PGridCfg2.DataSource) then
    Exit;
  if not Assigned(PGridCfg2.DataSource.DataSet) then
    Exit;
  PcdsGrid := TClientDataSet(PGridCfg2.DataSource.DataSet);

  PcdsGrid.DisableControls;
  PcdsColunas.Close;
  PcdsColunas.CommandText := ' select * from config_colunas ' +
  	' where usuario = ' + QuotedStr(Pusuario)+
    ' and componente = ' + QuotedStr(getDataSetNameByGridCadPadrao(PGridCfg2.Name, PcdsGrid.Name, pListGridsAndDataSets) + pAlterarNomeDtSet);
  PcdsColunas.Open;
  PcdsColunas.IndexFieldNames := 'ordem';

//  for I := 0 to PcdsGrid.Fields.Count - 1 do
//    if not PcdsColunas.Locate('campos', PcdsGrid.Name + PcdsGrid.Fields[I].FieldName, []) then
//    begin
//      Field := PcdsGrid.Fields[I];
//      if (Field.Tag = 0) or (Field.Tag = 2) then Field.Visible := True
//      else Field.Visible := False;
//      PcdsColunas.Insert;
//      if Field.Visible then
//        PcdsColunas.FieldByName('visivel').AsInteger := 1
//      else
//        PcdsColunas.FieldByName('visivel').AsInteger := 0;
//      PcdsColunas.FieldByName('usuario').AsString           := Pusuario;
//      PcdsColunas.FieldByName('componente').AsString        := getDataSetNameByGridCadPadrao(PGridCfg2.Name, PcdsGrid.Name, pListGridsAndDataSets) + pAlterarNomeDtSet;
//      PcdsColunas.FieldByName('campos').AsString            := PcdsGrid.Name + Field.FieldName;
//      PcdsColunas.FieldByName('ordem').AsInteger            := 9999 + Field.Index;
//      PcdsColunas.Post;
//    end;
  try
    PcdsColunas.First;
    I := 0;
    while not PcdsColunas.Eof do
    begin
      FieldName := PcdsColunas.FieldByName('campos').AsString;
      Delete(FieldName, 1, Length(PcdsGrid.Name));
      Field := PcdsGrid.FindField(FieldName);
      if Field <> nil then
      begin
        Visivel := PcdsColunas.FieldByName('visivel').AsInteger = 1;
        if (Field.Tag = 1) then
          Visivel := False
        else if (Field.Tag = 2) then
          Visivel := True;
        Field.Visible := Visivel;
        Field.Index := I;

        if (PGridCfg2.Columns.Count) < (I + 1) then
          Column := TColumn.Create(PGridCfg2.Columns)
        else
          Column := PGridCfg2.Columns[Field.Index];
        if PcdsColunas.FieldByName('largura_exibicao').AsInteger > 0 then
          Column.Width := PcdsColunas.FieldByName('largura_exibicao').AsInteger;
        Column.Index := Field.Index;
        Column.Visible := Field.Visible;
        Column.FieldName := Field.FieldName;
      end
      else
      begin
        if ListDelete = nil then
        begin
          ListDelete := TStringList.Create;
          ListDelete.Clear;
        end;
        ListDelete.Add(Trim(PcdsColunas.FieldByName('campos').AsString));
      end;
      I := I + 1;
      PcdsColunas.Next;
    end;

    if ListDelete <> nil then
    begin
      for I := 0 to ListDelete.Count - 1 do
        if PcdsColunas.Locate('campos', ListDelete[I], []) then
          PcdsColunas.Delete;
      if PcdsColunas.ChangeCount > 0 then
      begin
        PcdsColunas.ApplyUpdates(-1);
        ptrans.Commit;
        ptrans.StartTransaction;
      end;
    end;
  finally
  end;
  PcdsGrid.EnableControls;
end;

