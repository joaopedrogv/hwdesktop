function TSingleton.StrToTStrings(AText: string; Aseparator: array of string;
  AdupIgnore: Boolean; AemptyIgnore: Boolean): TStrings;
var
  Astr: string;
  Alist: TStrings;
  I: Integer;
begin
  Result := TStringList.Create;
  try
    Astr := AText;
    for I := Low(Aseparator) to High(Aseparator) do
      Astr := StringReplace(Astr, Aseparator[I], sLineBreak, [rfReplaceAll]);
    Alist := TStringList.Create;
    Alist.Text := Astr;

    for I := 0 to Alist.Count - 1 do
    begin
      Astr := Alist[I];
      if (Trim(Astr) <> '') or (not AemptyIgnore) then
        if not AdupIgnore  then
          Result.Add(Astr)
        else if Result.IndexOf(Astr) = -1 then
          Result.Add(Astr);
    end;
  finally
    FreeAndNil(Alist);
  end;
end;

