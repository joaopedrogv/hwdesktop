    qrBusca.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
    qrBusca.ParamByName('data_envio').AsDateTime := Date - 30;
    qrBusca.open;
    qrBusca.FetchAll;

    ultimasql := qrBusca.SQL.Text;

    if not qrBusca.IsEmpty then
    begin
      if Length(trim(qrBusca.FieldByName('MENSAGEM').AsString)) >= 190 then
        vMensPagOnline := Copy(trim(qrBusca.FieldByName('MENSAGEM').AsString), 1, 190) + '...'
      else
        vMensPagOnline := Copy(trim(qrBusca.FieldByName('MENSAGEM').AsString), 1, 190);
      vMensPagOnline := vMensPagOnline + #13 + #13 + 'Para visualizar clique em notificações.';
//      vMensPagOnline := vMensPagOnline + #13 + #13 + 'Para visualizar as mensagens clique duas vezes neste ícone.';
      vQuantMensPagOnline := qrBusca.RecordCount;
      result := true;
    end;

  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro ao verificar Mensagens Pag Online. Erro: ' +
        e.message), 'Atenção', 0 + 64);
      registraErro('function TSingleton.VerificarMensPagOnline Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton.verificarPromocao(pBuscas: TIBQuery; pCodPromocao: Integer; pTipo: Integer): boolean;
var
  buscas3: TIBQuery;
  vCampos: string;
  vCamposIns: string;
  I, J: Integer;
begin
   vCampos := ' COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, DESCR_PROMOCAO, ORDEM, ATIVO, DATA_INI, DATA_FIM, HORA_INI, HORA_FIM ';
   vCamposIns := ' :COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA, :DESCR_PROMOCAO, :ORDEM, :ATIVO, :DATA_INI, :DATA_FIM, :HORA_INI, :HORA_FIM ';

   buscas3 := TIBQuery.Create(Application);
   buscas3.Database := pBuscas.Database;
   buscas3.Transaction := pBuscas.Transaction;

   for I := 0 to Length(vReplicaoInternaEmpresa) - 1 do
   begin
     buscas3.Close;
     buscas3.SQL.Text := ' SELECT ' + vCampos + ' FROM PROMOCAO ' +
       ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
       ' AND COD_TPPRECO = :COD_TPPRECO ' +
       ' AND COD_EMPRESA = :COD_EMPRESA ';
     buscas3.ParamByName('COD_PROMOCAO').AsInteger := pCodPromocao;
     buscas3.ParamByName('COD_TPPRECO').AsInteger := pTipo;
     buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
     buscas3.Open;

     if buscas3.IsEmpty then
     begin
       buscas3.Close;
       buscas3.SQL.Text := ' SELECT ' + vCampos + ' FROM PROMOCAO ' +
         ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
         ' AND COD_TPPRECO = :COD_TPPRECO ' +
         ' AND COD_EMPRESA = :COD_EMPRESA ';
       buscas3.ParamByName('COD_PROMOCAO').AsInteger := pCodPromocao;
       buscas3.ParamByName('COD_TPPRECO').AsInteger := pTipo;
       buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
       buscas3.Open;

       pBuscas.Close;
       pBuscas.SQL.Text := ' INSERT INTO PROMOCAO (' + vCampos + ') ' +
          ' VALUES (' + vCamposIns + ') ';
       for J := 0 to buscas3.FieldCount - 1 do
          pBuscas.ParamByName(buscas3.Fields[J].FieldName).Value := buscas3.Fields[J].Value;
       pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
       pBuscas.ExecSQL;
     end;
   end;
end;

function TSingleton.verificarRecursividadeMateriasPrimas(pBuscas: TIBQuery;
	pGrupoProdAcab: Integer; pCodProdAcab: string;
  pGrupoProd: Integer; pCodProd: string): boolean;
var
	vbuscastmp: TIBQuery;
begin
	Result := True;
	try
  	vbuscastmp := TIBQuery.Create(Application);
    vbuscastmp.Database := pBuscas.Database;
    vbuscastmp.Transaction := pBuscas.Transaction;

    vbuscastmp.Close;
    vbuscastmp.SQL.Text := ' select ind.grupo_prod_acabado, ' +
    	' ind.cod_prod_acabado, ' +
    	' ind.grupo_prod_mprima, ' +
    	' ind.cod_prod_mprima from indice_tecnico ind ' +
      ' inner join produtos pr on ' +
      '   pr.grupo_prod = ind.grupo_prod_acabado ' +
      '   and pr.cod_prod = ind.cod_prod_acabado ' +
      '   and pr.cod_empresa = ind.cod_empresa ' + 
      ' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProd) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProd) +
      ' and ind.cod_empresa = ' + codEmpresa +
      ' and pr.criar_producao_aut = ''S'' ';
    vbuscastmp.Open;

    vbuscastmp.First;
    while not vbuscastmp.Eof do
    begin
    	if (pGrupoProdAcab = vbuscastmp.FieldByName('GRUPO_PROD_MPRIMA').AsInteger)
      	and (trim(pCodProdAcab) = trim(vbuscastmp.FieldByName('COD_PROD_MPRIMA').AsString)) then
      begin
      	Application.MessageBox(pchar('Produto acabado abaixo já foi adicionado como insumo do mesmo produto: ' + #13 + #13 +
        	'ACABADO' + #13 +
          'Grupo Prod: ' + IntToStr(pGrupoProdAcab) + #13 +
          'Cod Prod: ' + trim(pCodProdAcab) + #13 + #13 +
          'INSUMO' + #13 +
          'Grupo Prod: ' + IntToStr(pGrupoProd) + #13 +
          'Cod Prod: ' + trim(pCodProd) + #13 + #13 +
          'Favor verificar antes de continuar!'), 'Atenção', 0 + 64);
      	Result := False;
        exit;
      end;

      if not verificarRecursividadeMateriasPrimas(
      	pBuscas,
        pGrupoProdAcab,
        pCodProdAcab,
      	vbuscastmp.FieldByName('GRUPO_PROD_MPRIMA').AsInteger,
        vbuscastmp.FieldByName('COD_PROD_MPRIMA').AsString) then
      begin
        Result := False;
        exit;
      end;

    	vbuscastmp.Next;
    end;
    vbuscastmp.First;
  except
    on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('procedure TSingleton.verificarRecursividadeMateriasPrimas. Erro: ' + e.Message);
      Result := False;
    end;
  end;
end;

function TSingleton.verificarReplicacaoInterna(pbuscas: TIBQuery; pEmpFis: boolean = false; pNomeTabela: string = 'PRODUTOS'): boolean;
var
	I: Integer;
begin
  pbuscas.Close;
  pbuscas.SQL.Text := ' select * from TAB_REP ' +
  	' where TABELA = :TABELA ';
  pbuscas.ParamByName('TABELA').AsString := pNomeTabela;  
  pbuscas.Open;

  vReplicacaoInterna := not pbuscas.IsEmpty;
  Result := not pbuscas.IsEmpty;

  if vReplicacaoInterna then
  begin
     pbuscas.close;
     pbuscas.sql.Text := ' select cod_empresa, coalesce(emp_repl_interna, ' + codEmpresa + ') emp_repl_interna from EMPRESA ' +
       ' where ativo = 1 and COD_EMPRESA <> ' + codEmpresa;
     pbuscas.Open;
     pbuscas.FetchAll;

     pbuscas.First;
     if pEmpFis then
	     I := 1
     else
       I := 0;

     while not pbuscas.Eof do
     begin
       if pbuscas.FieldByName('EMP_REPL_INTERNA').AsInteger = StrToInt(codEmpresa) then
         Inc(I);
       pbuscas.Next;
     end;
     SetLength(vReplicaoInternaEmpresa, I);

     if pEmpFis then
     begin
       vReplicaoInternaEmpresa[0] := codEmpresa;
       I := 1;
     end
     else
	     I := 0;

     pbuscas.First;
     while not pbuscas.Eof do
     begin
       if pbuscas.FieldByName('EMP_REPL_INTERNA').AsInteger = StrToInt(codEmpresa) then
       begin
         vReplicaoInternaEmpresa[i] := pbuscas.FieldByName('cod_empresa').AsString;
         Inc(I);
       end;
       pbuscas.Next;
     end;
  end
  else if pEmpFis then
  begin
  	SetLength(vReplicaoInternaEmpresa, 1);
    vReplicaoInternaEmpresa[0] := codEmpresa;
  end;
end;

function TSingleton.verificarSugestaoServico(pBuscas: TIBQuery; pSpIncCodigo: TIBStoredProc; pTipo: string;
  pCodVendedor, pCodCliente, pCodEquip, pCodVeic: Integer; pChassi,
  pPlaca: string; pNPED, pKm: integer; var pMensagem: string; pVenda: boolean): boolean;
var
  buscas3: TIBQuery;
  formulario: TForm;
  hdTemp: THandle;
begin
  try
    Result := true;

    if (pNPED > 0 ) then
      if ((trim(pTipo) <> 'OS') and (trim(pTipo) <> 'AVS')) then
        exit;

    if not (vSugServico.vHabilitarSug) then
      exit;

    if vEmp.vUsarAparelho = 'S' then
    begin
      if pCodEquip <= 0 then
        exit;
    end
    else
    begin
      if ((pCodVeic <= 0) and (trim(pChassi) = '') and (trim(pPlaca) = '')) then
        exit;
    end;

    Result := false;

    vDataBanco := getDataBanco(pBuscas);
    vHoraBanco := FormatDateTime('HH:MM', getDataHoraBanco(pBuscas));

    buscas3 := TIBQuery.Create(Application);
    buscas3.Database := pBuscas.Database;
    buscas3.Transaction := pBuscas.Transaction;

    vDtSetTmp := TClientDataSet.Create(nil);
    vDtSetTmp.Close;
    vDtSetTmp.FieldDefs.Clear;
    vDtSetTmp.FieldDefs.Add('SEL', ftString, 1, false);
    vDtSetTmp.FieldDefs.Add('COD_SUG_OS', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('COD_SERV_SUG', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('DESCR_SERV_SUG', ftString, 50, false);
    vDtSetTmp.FieldDefs.Add('COD_VENDEDOR', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('COD_EQUIP', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('COD_VEIC', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('CHASSI', ftString, 17, false);
    vDtSetTmp.FieldDefs.Add('PLACA', ftString, 10, false);
    vDtSetTmp.FieldDefs.Add('DIAS', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('DATA', ftTimeStamp, 0, false);
    vDtSetTmp.FieldDefs.Add('TIPO', ftString, 40, false);

    vDtSetTmp.FieldDefs.Add('COD_CLIENTE', ftInteger, 0, false);
    vDtSetTmp.FieldDefs.Add('KM', ftInteger, 0, false);

    if vDtSetTmp.Tag = 0 then
    try
      vDtSetTmp.CreateDataSet;
      vDtSetTmp.Tag := 1;
      vDtSetTmp.FieldByName('SEL').DisplayLabel := 'Sel';
      vDtSetTmp.FieldByName('DESCR_SERV_SUG').DisplayLabel := 'Descrição';
      vDtSetTmp.FieldByName('DIAS').DisplayLabel := 'Dias';
      vDtSetTmp.FieldByName('DATA').DisplayLabel := 'Data';
      vDtSetTmp.FieldByName('COD_SUG_OS').Visible := false;
      vDtSetTmp.FieldByName('COD_SERV_SUG').Visible := false;
      vDtSetTmp.FieldByName('COD_VENDEDOR').Visible := false;
      vDtSetTmp.FieldByName('COD_EQUIP').Visible := false;
      vDtSetTmp.FieldByName('COD_VEIC').Visible := false;
      vDtSetTmp.FieldByName('CHASSI').Visible := false;
      vDtSetTmp.FieldByName('PLACA').Visible := false;
      vDtSetTmp.FieldByName('TIPO').Visible := false;

      vDtSetTmp.FieldByName('COD_CLIENTE').Visible := false;
      vDtSetTmp.FieldByName('KM').Visible := false;

      vDtSourceTmp := TDataSource.Create(nil);
      vDtSourceTmp.DataSet := vDtSetTmp;
    except
    end;

    vSpIncCodigoTmp := pSpIncCodigo;

    recalcularData(pBuscas, pSpIncCodigo, pTipo, pCodVendedor, pCodCliente, pCodEquip,
    	pCodVeic, pChassi, pPlaca, pNPED, pKm);

    if pVenda then
    	vPesquisa := 'SERVSUGERIDOS|VENDA|'
    else
    	vPesquisa := 'SERVSUGERIDOS|SUGESTAO|';


  	formulario := Funcoes.AbreForm('pkPedidoVenda', 'TfrmServSugeridos', hdTemp);

  	try
    	formulario.ShowModal;
      if trim(vPesquisa) = 'SERVSUGERIDOSOK|' then
      begin
        try
          vDtSetTmp.Filter := ' SEL = ''S'' ';
          vDtSetTmp.Filtered := true;

          if (vDtSetTmp.IsEmpty) then
          begin
            pMensagem := 'Nenhuma sugestão de serviço selecionada!';

            if (pNPED > 0) then
            begin
              if Application.MessageBox(pchar(pMensagem + #13 + #13 + 'Deseja continuar assim mesmo?'), 'Confirmação',
                MB_ICONWARNING + MB_YESNO + MB_DEFBUTTON2) = IDNO then
              begin
                Result := false;
                exit;
              end;
            end
            else
            begin
              Application.MessageBox(PChar(pMensagem), 'Erro', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
              Result := false;
              exit;
            end;

            if (trim(pTipo) = 'OS') then
              if not PesqPros('BAS408', 'PERMITIR', '', 'PEDVENDA', IntToStr(pNPED), pBuscas, true) then
              begin
                Result := false;
                exit;
              end;
          end;

          vDtSetTmp.First;
          while not vDtSetTmp.Eof do
          begin
            if vDtSetTmp.FieldByName('SEL').AsString = 'S' then
            begin
              buscas3.Close;
              buscas3.SQL.Text := ' INSERT INTO SUG_OS ' +
                ' (COD_SUG_OS, COD_EMPRESA, COD_EQUIP, COD_VEIC, CHASSI, PLACA, US_CAD, DATA_CAD, HORA_CAD, ' +
                ' KM, NDOC, TPDOC, COD_SERV_SUG, COD_VENDEDOR, ATIVO) ' +
                ' VALUES (:COD_SUG_OS, :COD_EMPRESA, :COD_EQUIP, :COD_VEIC, :CHASSI, :PLACA, :US_CAD, :DATA_CAD, :HORA_CAD, ' +
                ' :KM, :NDOC, :TPDOC, :COD_SERV_SUG, :COD_VENDEDOR, :ATIVO); ';
              buscas3.ParamByName('COD_SUG_OS').AsInteger := vDtSetTmp.FieldByName('COD_SUG_OS').AsInteger;
              buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
              if vEmp.vUsarAparelho = 'S' then
                buscas3.ParamByName('COD_EQUIP').AsInteger := vDtSetTmp.FieldByName('COD_EQUIP').AsInteger
              else
              begin
                buscas3.ParamByName('COD_VEIC').AsInteger := vDtSetTmp.FieldByName('COD_VEIC').AsInteger;
                buscas3.ParamByName('CHASSI').AsString := vDtSetTmp.FieldByName('CHASSI').AsString;
                buscas3.ParamByName('PLACA').AsString := vDtSetTmp.FieldByName('PLACA').AsString;
              end;
              buscas3.ParamByName('US_CAD').AsInteger := vCodUsuario;
              buscas3.ParamByName('DATA_CAD').AsDateTime := vDataBanco;
              buscas3.ParamByName('HORA_CAD').AsString := vHoraBanco;
              buscas3.ParamByName('KM').AsInteger := pKm;
              buscas3.ParamByName('NDOC').AsInteger := pNPED;
              buscas3.ParamByName('TPDOC').AsString := pTipo;
              buscas3.ParamByName('COD_SERV_SUG').AsInteger := vDtSetTmp.FieldByName('COD_SERV_SUG').AsInteger;
              buscas3.ParamByName('COD_VENDEDOR').AsInteger := vDtSetTmp.FieldByName('COD_VENDEDOR').AsInteger;
              buscas3.ParamByName('ATIVO').AsInteger := 1;
              buscas3.ExecSQL;

              buscas3.Close;
              buscas3.SQL.Text := ' UPDATE SUGESTAOSERVICO SET ' +
                ' STATUS = :STATUS, NDOC = :NDOC, TPDOC = :TPDOC, DATA_DOC = :DATA_DOC ' +
                ' WHERE (TRIM(COALESCE(STATUS, '''')) = '''') AND COD_SERV_SUG = :COD_SERV_SUG ' +
                ' AND COD_EMPRESA = :COD_EMPRESA ';
              if vEmp.vUsarAparelho = 'S' then
                buscas3.SQL.Text := buscas3.SQL.Text + ' AND COD_EQUIP = :COD_EQUIP '
              else
                buscas3.SQL.Text := buscas3.SQL.Text +
                ' AND PLACA = :PLACA AND CHASSI = :CHASSI AND COD_VEIC = :COD_VEIC ';
              buscas3.ParamByName('NDOC').AsInteger := pNPED;
              buscas3.ParamByName('TPDOC').AsString := pTipo;
              buscas3.ParamByName('DATA_DOC').AsDateTime := vDataBanco;
              buscas3.ParamByName('STATUS').AsString := 'FINALIZADA';
              buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
              buscas3.ParamByName('COD_SERV_SUG').AsInteger := vDtSetTmp.FieldByName('COD_SERV_SUG').AsInteger;
              if vEmp.vUsarAparelho = 'S' then
                buscas3.ParamByName('COD_EQUIP').AsInteger := vDtSetTmp.FieldByName('COD_EQUIP').AsInteger
              else
              begin
                buscas3.ParamByName('COD_VEIC').AsInteger := vDtSetTmp.FieldByName('COD_VEIC').AsInteger;
                buscas3.ParamByName('CHASSI').AsString := vDtSetTmp.FieldByName('CHASSI').AsString;
                buscas3.ParamByName('PLACA').AsString := vDtSetTmp.FieldByName('PLACA').AsString;
              end;
              buscas3.ExecSQL;

              buscas3.Close;
              buscas3.SQL.Text := ' INSERT INTO SUGESTAOSERVICO ' +
                ' (COD_SUG, COD_EMPRESA, COD_EQUIP, COD_VEIC, CHASSI, PLACA, COD_SUG_OS, ULT_ATD, DATA, HORA, ' +
                ' ATIVO, COD_CLIENTE, US_CAD, DATA_CAD, HORA_CAD, NDOC_ANT, TPDOC_ANT, DATA_DOC_ANT, ' +
                ' COD_SERV_SUG, DATA_ULT_SERV, KM_ULT_SERV, DIAS, TIPO) ' +
                ' VALUES ' +
                ' (:COD_SUG, :COD_EMPRESA, :COD_EQUIP, :COD_VEIC, :CHASSI, :PLACA, :COD_SUG_OS, :ULT_ATD, :DATA, :HORA, ' +
                ' :ATIVO, :COD_CLIENTE, :US_CAD, :DATA_CAD, :HORA_CAD, :NDOC_ANT, :TPDOC_ANT, :DATA_DOC_ANT, ' +
                ' :COD_SERV_SUG, :DATA_ULT_SERV, :KM_ULT_SERV, :DIAS, :TIPO); ';
              buscas3.ParamByName('COD_SUG').AsInteger := Gencodigo('SUGESTAOSERVICO', pSpIncCodigo, codEmpresa);
              buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
              if vEmp.vUsarAparelho = 'S' then
                buscas3.ParamByName('COD_EQUIP').AsInteger := vDtSetTmp.FieldByName('COD_EQUIP').AsInteger
              else
              begin
                buscas3.ParamByName('COD_VEIC').AsInteger := vDtSetTmp.FieldByName('COD_VEIC').AsInteger;
                buscas3.ParamByName('CHASSI').AsString := vDtSetTmp.FieldByName('CHASSI').AsString;
                buscas3.ParamByName('PLACA').AsString := vDtSetTmp.FieldByName('PLACA').AsString;
              end;
              buscas3.ParamByName('COD_SUG_OS').AsInteger := vDtSetTmp.FieldByName('COD_SUG_OS').AsInteger;
              buscas3.ParamByName('ULT_ATD').AsInteger := pCodVendedor;
              buscas3.ParamByName('DATA_ULT_SERV').AsDateTime := vDataBanco;
              buscas3.ParamByName('KM_ULT_SERV').AsInteger := pKm;
              buscas3.ParamByName('DATA').AsDateTime := vDataBanco + vDtSetTmp.FieldByName('DIAS').AsInteger;
              buscas3.ParamByName('HORA').AsString := vHoraBanco;
              buscas3.ParamByName('ATIVO').AsInteger := 1;
              buscas3.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
              buscas3.ParamByName('US_CAD').AsInteger := vCodUsuario;
              buscas3.ParamByName('DATA_CAD').AsDateTime := vDataBanco;
              buscas3.ParamByName('HORA_CAD').AsString := vHoraBanco;
              buscas3.ParamByName('NDOC_ANT').AsInteger := pNPED;
              buscas3.ParamByName('TPDOC_ANT').AsString := pTipo;
              buscas3.ParamByName('DATA_DOC_ANT').AsDateTime := vDataBanco;
              buscas3.ParamByName('COD_SERV_SUG').AsInteger := vDtSetTmp.FieldByName('COD_SERV_SUG').AsInteger;
              buscas3.ParamByName('DIAS').AsInteger := vDtSetTmp.FieldByName('DIAS').AsInteger;
              buscas3.ParamByName('TIPO').AsString := vDtSetTmp.FieldByName('TIPO').AsString;
              buscas3.ExecSQL;
            end;

            vDtSetTmp.Next;
          end;
        finally
        	vPesquisa := '';
          vDtSetTmp.Filtered := false;
        end;
        Result := true;
      end
      else
      begin
        pMensagem := 'Nenhuma sugestão de serviço selecionada';
        Result := false;
      end;
  	finally
    	formulario.Free;
    	unLoadPackage(hdTemp);
  	end;
  except
    on e: exception do
    begin
      Result := false;
      pMensagem := 'Nenhuma sugestão de serviço selecionada';
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;

end;

function TSingleton.verificarTabPreco(pBuscas: TIBQuery; pDescTipo: string; pTipo: Integer): boolean;
var
	buscas3, buscas4: TIBQuery;
  I, J: Integer;
  vCodSetor: Integer;
  vCamposSet, vCamposSetIns: string;
  vCamposLoc, vCamposLocIns: string; 
begin
  vCamposSet := 'COD_SETOR, COD_EMPRESA, SETOR, COD_VENDEDOR, ATIVO';
  vCamposSetIns := ':COD_SETOR, :COD_EMPRESA, :SETOR, :COD_VENDEDOR, :ATIVO';

  vCamposLoc := 'COD_LOCALIDADE, COD_EMPRESA, COD_SETOR, LOCALIDADE, COD_CIDADE, COD_ESTADO, ATIVO';
  vCamposLocIns := ':COD_LOCALIDADE, :COD_EMPRESA, :COD_SETOR, :LOCALIDADE, :COD_CIDADE, :COD_ESTADO, :ATIVO';

  buscas3 := TIBQuery.Create(Application);
  buscas3.Database := pBuscas.Database;
  buscas3.Transaction := pBuscas.Transaction;

  buscas4 := TIBQuery.Create(Application);
  buscas4.Database := pBuscas.Database;
  buscas4.Transaction := pBuscas.Transaction;

  for I := 0 to Length(vReplicaoInternaEmpresa) - 1 do
  begin
    if pDescTipo = 'LOCALIDADE' then
    begin
       buscas3.Close;
       buscas3.SQL.Text := ' SELECT ' + vCamposLoc + ' FROM LOCALIDADE ' +
         ' WHERE COD_LOCALIDADE = :COD_LOCALIDADE AND COD_EMPRESA = :COD_EMPRESA ';
       buscas3.ParamByName('COD_LOCALIDADE').AsInteger := pTipo;
       buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
       buscas3.Open;

