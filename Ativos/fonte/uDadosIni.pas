      buscas2.ExecSQL;

      buscas2.Close;
      buscas2.SQL.Text := ' DELETE FROM CONTROLE_CREDITOS ' +
        ' WHERE COD_CRED = :COD_CRED AND CODIGO_EMP = :CODIGO_EMP ';
      buscas2.ParamByName('COD_CRED').AsInteger := cQuery.FieldByName('COD_CRED').AsInteger;
      buscas2.ParamByName('CODIGO_EMP').AsInteger := cQuery.FieldByName('CODIGO_EMP').AsInteger;
      buscas2.ExecSQL;

      buscas2.Close;
      buscas2.SQL.Text := ' SELECT * FROM CREDITOS_LANC ' +
       ' WHERE COD_LANC = :COD_LANC AND COD_CRED = :COD_CRED AND CODIGO_EMP = :CODIGO_EMP ';
