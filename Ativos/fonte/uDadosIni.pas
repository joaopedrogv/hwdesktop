procedure TSingleton.restoreDataSetDefaultCadPadrao(PGridCfg, PGridCfg2: TDBGrid;
  pClearListPositions: Boolean; pListPositions: TStrings;
  pcdsGrid: TClientDataSet);
var
  I: Integer;
  Columns: TColumn;
begin
  if PGridCfg = nil then
    Exit;
  PGridCfg2 := TDBGrid(PGridCfg);
  if not Assigned(PGridCfg2.DataSource) then
    Exit;
  if not Assigned(PGridCfg2.DataSource.DataSet) then
    Exit;
  pcdsGrid := TClientDataSet(PGridCfg2.DataSource.DataSet);

  for I := 0 to pListPositions.Count - 1 do
  begin
    if pcdsGrid.FieldByName(pListPositions[I]).Tag = 0 then
      pcdsGrid.FieldByName(pListPositions[I]).Visible := True
    else if pcdsGrid.FieldByName(pListPositions[I]).Tag = 1 then
      pcdsGrid.FieldByName(pListPositions[I]).Visible := False
    else if pcdsGrid.FieldByName(pListPositions[I]).Tag = 2 then
      pcdsGrid.FieldByName(pListPositions[I]).Visible := True
    else if pcdsGrid.FieldByName(pListPositions[I]).Tag = 3 then
      pcdsGrid.FieldByName(pListPositions[I]).Visible := False;
    pcdsGrid.FieldByName(pListPositions[I]).Index := I;

    if (PGridCfg2.Columns.Count) < (I + 1) then
      Columns := TColumn.Create(PGridCfg2.Columns)
    else
      Columns := PGridCfg2.Columns[I];
    Columns.Index := I;
    Columns.Visible := pcdsGrid.FieldByName(pListPositions[I]).Visible;
    Columns.FieldName := pcdsGrid.FieldByName(pListPositions[I]).FieldName;
  end;
  if pClearListPositions then
    pListPositions.Clear;
end;

