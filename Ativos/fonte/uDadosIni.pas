procedure TSingleton.delContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
var
	I: Integer;
begin
	if pCodCliente <= 0 then
  	Exit;

  if not Assigned(vListaContatoTemp) then
    vListaContatoTemp := TStringList.Create;
  vListaContatoTemp.Clear;

  if not vDadosIni.removerContatoCliente(
    pCodCliente,
    pCheckListContato) then
      Exit;

  vDadosIni.retornaCheckListContato(
    pCodCliente,
    pOrigem,
    pCheckListContato
  );

  if pOrigem <> cContrato then
  begin
    for I := 0 to vListaContatoTemp.Count - 1 do
    begin
      pCheckListContato.Items.Add(
        trim(vListaContatoTemp[I]) + ' * '
      );

      pCheckListContato.Checked[pCheckListContato.Items.Count - 1] := True;
    end;
  end;
end;

function TSingleton.deletarVinculosGradeAcabadoMateriaPrima(pBuscas: TIBQuery;
  pGrupoProdAcab: Integer; pCodProdAcab: string;
  pCodGradeAcab: Integer): boolean;
begin
	if (pCodGradeAcab <= 0) then
  begin
  	Application.MessageBox('Nenhuma grade do produto acabado selecionada.', 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
    exit;
  end;

	try
  	Result := False;

    pBuscas.Close;
    pBuscas.SQL.Text := ' select grupo_prod, cod_prod, cod_empresa, num_fab_prod, descr_prod from produtos ' +
    	' where grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cod_empresa = ' + codEmpresa;
    pBuscas.Open;

    if Application.MessageBox(PChar('Deseja remover os vinculos da grade ' + IntToStr(pCodGradeAcab) + ' do Produto Acabado?' + #13 + #13 +
	    'PRODUTO' + #13 +
      'Grupo Prod: ' + IntToStr(pGrupoProdAcab) + #13 +
      'Cod Prod: ' +  trim(pCodProdAcab) + #13 +
      'Num Fabr: ' + trim(pBuscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
      'Descrição: ' + trim(pBuscas.FieldByName('DESCR_PROD').AsString)),
    	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
    	exit;

		pBuscas.Close;
    pBuscas.SQL.Text := ' delete from produtos_pdc_var ' +
    	' where grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cod_grade = ' + IntToStr(pCodGradeAcab) +
      ' and cod_empresa = ' + codEmpresa;
    pBuscas.ExecSQL;

  	if pBuscas.Transaction.InTransaction then
    	pBuscas.Transaction.Commit;

    Result := True;
  except
    on E: Exception do
		begin
			pBuscas.Transaction.Rollback;
      fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TSingleton.deletarVinculosGradeMateriaPrima(pBuscas: TIBQuery;
	pGrupoProdAcab: Integer; pCodProdAcab: string;
  pGrupoProdMPrima: Integer; pCodProdMPrima: string): boolean;
var
	buscas2: TIBQuery;
begin
	try
  	Result := False;

    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := pBuscas.Database;
	  buscas2.Transaction := pBuscas.Transaction;

		buscas2.Close;
    buscas2.SQL.Text := ' select id_ind from produtos_pdc_var ' +
    	' where grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cod_empresa = ' + codEmpresa;
    buscas2.Open;

    if buscas2.RecordCount > 0 then
    begin
    	buscas2.First;
      while not buscas2.Eof do
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' delete from produtos_pdc_var_it ' +
          ' where id_ind = ' + IntToStr(buscas2.FieldByName('id_ind').AsInteger) +
          ' and cod_empresa = ' + codEmpresa +
          ' and grupo_prod = ' + IntToStr(pGrupoProdMPrima) +
          ' and cod_prod = ' + QuotedStr(pCodProdMPrima);
        pBuscas.ExecSQL;

        buscas2.Next;
      end;

      if buscas2.Transaction.InTransaction then
        buscas2.Transaction.Commit;
    end;

    Result := True;
  except
    on E: Exception do
		begin
			pBuscas.Transaction.Rollback;
      fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

