procedure TSingleton.WriteToMSWord(const RTFText: string; pSenha: string = ''; pDestino: string = '');
var
  Word, varFileName, varFormat: OleVariant;
  WordDoc: _Document;
  WordApp: _Application;
  DataObj: IDataObject;
  Formats: IEnumFormatEtc;
  RTFFormat: TFormatEtc;
  Medium: TStgMedium;
  pGlobal: Pointer;
  V1, V2, V3: OleVariant;
begin
  try
    GetActiveOleObject('Word.Application').QueryInterface(_Application, WordApp);
  except
//    WordApp := CoWordApplication.Create;
    Application.MessageBox('Versão do Microsoft Office Word Incompatível','Erro',MB_OK+MB_ICONEXCLAMATION);
    exit;
  end;
  WordApp.Documents.Add(EmptyParam, EmptyParam, EmptyParam, EmptyParam);
  if trim(pDestino) <> '' then
    WordApp.Visible := False
  else
    WordApp.Visible := True;
  WordDoc := WordApp.ActiveDocument;
  if trim(pSenha) <> '' then
  begin
    V1 := wdAllowOnlyFormFields;
    V2 := EmptyParam;
    if trim(pSenha) = '' then
      V3 := ''
    else
      V3 := trim(pSenha);
    WordDoc.Protect(V1, V2, V3);
  end;
  OleCheck(WordDoc.QueryInterface(IDataObject, DataObj));
  GetRTFFormat(DataObj, RTFFormat);
  FillChar(Medium, SizeOf(Medium), 0);
  Medium.tymed := RTFFormat.tymed;
  Medium.hGlobal := GlobalAlloc(GMEM_MOVEABLE, Length(RTFText) + 1);
  try
    pGlobal := GlobalLock(Medium.hGlobal);
    CopyMemory(PGlobal, PChar(RTFText), Length(RTFText) + 1);
    GlobalUnlock(Medium.hGlobal);
    OleCheck(DataOBJ.SetData(RTFFormat, Medium, True));
  finally
    GlobalFree(Medium.hGlobal);
    ReleaseStgMedium(Medium);
  end;
  if trim(pDestino) <> '' then
  begin
    varFileName := pDestino;
    varFormat := wdFormatDocument;
    WordDoc.SaveAs(varFileName, varFormat, EmptyParam, EmptyParam, EmptyParam,
                       EmptyParam, EmptyParam, EmptyParam, EmptyParam, EmptyParam,
                       EmptyParam, EmptyParam, EmptyParam, EmptyParam, EmptyParam,
                       EmptyParam);
    WordDoc.Close(EmptyParam, varFormat, EmptyParam);
    WordApp.Quit(EmptyParam, varFormat, EmptyParam);
  end;
end;

