function TSingleton.FazerLancamentoContaCorrente(
	pDebito: Boolean; pBarrado: Boolean;
  pCodCliente: Integer; pCodEmpResp: Integer; pCredDebito, pDescricao: string; pValor: Double; pData: TDateTime;
  pPontos: Double; pNdoc: Integer; pTipoDoc: string; pDataVencProg: TDateTime;
  pJSON: string; pCodTaxaProg: Integer; pPercProg, pValorDoc,
  pValorDev, pValorVale: Double; pbuscas: TIBQuery;
  pNdoc2: Integer; pTipoDoc2: string;
  pcoddev: Integer; ptipodev: string;
  pValeTroca: boolean = false; pValeResgate: boolean = false): boolean;
var
  vbuscas: TIBQuery;
  vcodigoAnt: Integer;
  vdataBanco: TDatetime;
begin
  try
    try
      Result := true;

      vbuscas := TIBQuery.Create(Application);
      vbuscas.Database := pbuscas.Database;
      vbuscas.Transaction := pbuscas.Transaction;

      if (vProgFid.vHabilitarProgFid) or (pBarrado) then
      begin
        pbuscas.Close;
        pbuscas.SQL.Text := ' INSERT INTO CONTA_CORRENTE_PROG_FIDELIDADE ' +
           ' (CODIGO, COD_EMPRESA, COD_EMP_RESP, COD_TAXA_PROG_FID, COD_CLIENTE, TIPO, DESCRICAO, VALOR_OP, ' +
           ' PERC_PROG_FID, VALOR, DATA, PONTOS, NDOC, TIPODOC, COD_EMP_TIPODOC, DATA_VENC_PROG, JSONCLASSES, ' +
           ' VALORDOC, VALORDEV, VALORVALE, DATA_LANC, COD_DEV, TIPO_DEV) ' +
           ' VALUES ' +
           ' (:CODIGO, :COD_EMPRESA, :COD_EMP_RESP, :COD_TAXA_PROG_FID, :COD_CLIENTE, :TIPO, :DESCRICAO, :VALOR_OP, ' +
           ' :PERC_PROG_FID, :VALOR, :DATA, :PONTOS, :NDOC, :TIPODOC, :COD_EMP_TIPODOC, :DATA_VENC_PROG, :JSONCLASSES, ' +
           ' :VALORDOC, :VALORDEV, :VALORVALE, :DATA_LANC, :COD_DEV, :TIPO_DEV); ';
        pbuscas.ParamByName('CODIGO').AsInteger := Gencodigo('CONTA_CORRENTE_PROG_FIDELIDADE', vbuscas, codEmpresa);
        pbuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        pbuscas.ParamByName('COD_EMP_RESP').AsInteger := pCodEmpResp;
        pbuscas.ParamByName('COD_TAXA_PROG_FID').AsInteger := pCodTaxaProg;
        pbuscas.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
        pbuscas.ParamByName('TIPO').AsString := pCredDebito;
        pbuscas.ParamByName('DESCRICAO').AsString := pDescricao;
        pbuscas.ParamByName('VALOR_OP').AsFloat := pValor;
        pbuscas.ParamByName('DATA_LANC').AsDateTime := getDataBanco(vbuscas);
        pbuscas.ParamByName('DATA').AsDateTime := pData;
        pbuscas.ParamByName('PERC_PROG_FID').AsFloat := pPercProg;
        pbuscas.ParamByName('PONTOS').AsFloat := pPontos;
        pbuscas.ParamByName('NDOC').AsInteger := IfThen(pNdoc2 > 0, pNdoc2, pNdoc);
        pbuscas.ParamByName('TIPODOC').AsString := IfThen(pNdoc2 > 0, pTipoDoc2, IfThen(trim(pTipoDoc) = 'DEVV', 'NF', trim(pTipoDoc)));
        pbuscas.ParamByName('COD_EMP_TIPODOC').AsInteger := StrToInt(codEmpresa);
        pbuscas.ParamByName('DATA_VENC_PROG').AsDateTime := pDataVencProg;
        pbuscas.ParamByName('JSONCLASSES').AsString := pJSON;
        pbuscas.ParamByName('VALOR').AsFloat := StrToFloatFormat(pPontos * pPercProg,2);
        pbuscas.ParamByName('VALORDOC').AsFloat := pValorDoc;
        pbuscas.ParamByName('VALORDEV').AsFloat := pValorDev;
        pbuscas.ParamByName('VALORVALE').AsFloat := pValorVale;
        pbuscas.ParamByName('COD_DEV').AsInteger := pcoddev;
        if pcoddev > 0 then
          pbuscas.ParamByName('TIPO_DEV').AsString := IfThen(trim(ptipodev) = 'DEVV', 'NF', trim(ptipodev));
        pbuscas.ExecSQL;

        if (pCredDebito = 'CRÉDITO') and ((pValeTroca) or (pValeResgate)) then
        begin
          SqlExec(' update conta_corrente_prog_fidelidade set vale = ''N'' ' +
            ' where ndoc = ' + IntToStr(IfThen(pNdoc2 > 0, pNdoc2, pNdoc)) +
            ' and tipodoc = ' + QuotedStr(IfThen(pNdoc2 > 0, pTipoDoc2, IfThen(trim(pTipoDoc) = 'DEVV', 'NF', trim(pTipoDoc)))) +
            ' and cod_emp_tipodoc = ' + codEmpresa +
            ' and pontos > 0 and vale = ''S'' ' +
            ' order by codigo desc ', pbuscas);
        end;
      end
      else
      begin
      	vcodigoAnt := 0;

      	if (((trim(pTipoDoc) = 'REQ') or (trim(pTipoDoc) = 'OS')) and (pDebito))
        	or ((trim(pTipoDoc) = 'DEV') and (not pDebito)) then
        begin
          pbuscas.Close;
          pbuscas.SQL.Text := ' select first 1 codigo, cod_empresa, origem from central_cashback ' +
            ' where ndoc = :ndoc ' +
            ' and tipodoc = :tipodoc ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and tabela = :tabela ' +
            ' order by codigo desc ';
          pbuscas.ParamByName('NDOC').AsInteger := IfThen(pNdoc2 > 0, pNdoc2, pNdoc);
          pbuscas.ParamByName('TIPODOC').AsString := IfThen(pNdoc2 > 0, pTipoDoc2, IfThen(trim(pTipoDoc) = 'DEVV', 'NF', trim(pTipoDoc)));
          pbuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
          pbuscas.ParamByName('TABELA').AsString := 'DOCUMENTOS';
          pbuscas.Open;

          if pbuscas.IsEmpty then
            Exit;

          if (((trim(pTipoDoc) = 'REQ') or (trim(pTipoDoc) = 'OS')) and (pDebito)) then
          begin
            if trim(pbuscas.FieldByName('ORIGEM').AsString) <> 'C' then
              Exit;
          end
          else if ((trim(pTipoDoc) = 'DEV') and (not pDebito)) then
          begin
          	if trim(pbuscas.FieldByName('ORIGEM').AsString) <> 'D' then
              Exit;
          end;

          vcodigoAnt := pbuscas.FieldByName('CODIGO').AsInteger;
        end;

        vdataBanco := vDadosIni.getDataHoraBanco(pBuscas);

        pbuscas.Close;
        pbuscas.SQL.Text := ' INSERT INTO CENTRAL_CASHBACK ' +
           ' (CODIGO, COD_EMPRESA, TABELA, NDOC, TIPODOC, ORIGEM, DATA, CODIGO_ANT) ' +
           ' VALUES ' +
           ' (:CODIGO, :COD_EMPRESA, :TABELA, :NDOC, :TIPODOC, :ORIGEM, :DATA, :CODIGO_ANT); ';
        pbuscas.ParamByName('CODIGO').AsInteger := Gencodigo('CENTRAL_CASHBACK', vbuscas, codEmpresa);
        pbuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        pbuscas.ParamByName('NDOC').AsInteger := IfThen(pNdoc2 > 0, pNdoc2, pNdoc);
        pbuscas.ParamByName('TIPODOC').AsString := IfThen(pNdoc2 > 0, pTipoDoc2, IfThen(trim(pTipoDoc) = 'DEVV', 'NF', trim(pTipoDoc)));
        pbuscas.ParamByName('TABELA').AsString := 'DOCUMENTOS';
        pbuscas.ParamByName('ORIGEM').AsString := IfThen(not pDebito, 'C', 'D');
        pbuscas.ParamByName('DATA').AsDateTime := vdataBanco;
        if (vcodigoAnt > 0) then
        	pbuscas.ParamByName('CODIGO_ANT').AsInteger := vcodigoAnt
        else
        	pbuscas.ParamByName('CODIGO_ANT').Value := Null;
        pbuscas.ExecSQL;
      end;

    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(PChar('Erro ao realizar lançamento conta corrente do cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao realizar lançamento conta corrente do cliente: ' + e.Message);
      end;
    end;
  finally
    if Assigned(vbuscas) then
      FreeAndNil(vbuscas);
  end;
end;

