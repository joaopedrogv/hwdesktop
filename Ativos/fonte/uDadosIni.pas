procedure TSingleton.AlterarDataSourceComponentes(pForm: TForm; pDataModule: TDataModule);
var
	component, component2: TComponent;
	I: Integer;
begin
	for I := 0 to pForm.ComponentCount - 1 do
  	if (pForm.Components[I] is TDataSource) then
    begin
    	if (pForm.Components[I] as TDataSource).DataSet <> nil then
      begin
        component := pDataModule.FindComponent((pForm.Components[I] as TDataSource).DataSet.Name);
        if component <> nil then
        begin
        	if (pForm.Components[I] as TDataSource).DataSet <> nil then
            if apenasLetras((pForm.Components[I] as TDataSource).Owner.Name) = apenasLetras(pDataModule.Name) then
              (pForm.Components[I] as TDataSource).DataSet := TDataSet(component);
