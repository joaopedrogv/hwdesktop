function TSingleton.ApiHwCentralSuporte(AQuery: TIBQuery;
  AEmail: string): Boolean;
var
  AtokenResp: WideString;
  AtokenDB: WideString;
begin
  try
    AQuery.Close;
    AQuery.SQL.Text := 'select token from colaborador' +
      ' where cod_vendedor = ' + IntToStr(vCodUsuario) +
      ' and cod_empresa = ' + codEmpresa;
    AQuery.Open;
    AtokenDB := Trim(AQuery.FieldByName('token').AsString);

    if (AtokenDB <> '') then
      apiHw.accessTokenJSON := AtokenDB;

    AtokenResp := hw_central_suporte(AEmail, vNomeFuncionario + StrUtils.IfThen(vNomeFuncionario = 'HW', vEmp.vCNPJ), vEmp.vCNPJ, apiHw.accessTokenJSON);

    if (Trim(AtokenResp) <> '') and (Trim(AtokenResp) <> 'ERRO') then
    if AtokenResp <> apiHw.accessTokenJSON then
    begin
      apiHw.accessTokenJSON := AtokenResp;
      AQuery.Close;
      AQuery.SQL.Text := 'update colaborador set token = :token' +
        ' where cod_vendedor = ' + IntToStr(vCodUsuario) +
        ' and cod_empresa = ' + codEmpresa;
      AQuery.ParamByName('token').AsString := apiHw.accessTokenJSON;
      AQuery.ExecSQL;
      if AQuery.Transaction.InTransaction then
        AQuery.Transaction.Commit;
    end;

    Result := True;
  except
    Result := False;
  end;
end;

function TSingleton.ApiHwemailColaboradorValidoParaAcesso(AQuery: TIBQuery;
  var AEmail: string; AShowMessage: Boolean): Boolean;
var
  AMensagem: TStrings;
  AEmails: TStrings;
  I: Integer;
begin
  try
    Result := False;
    AQuery.Close;
    AQuery.SQL.Text := 'select cod_vendedor, nome_vendedor, email from colaborador' +
      ' where cod_vendedor = ' + IntToStr(vCodUsuario) +
      ' and cod_empresa = ' +codEmpresa;
    AQuery.Open;
    AEmail := Trim(AQuery.FieldByName('email').AsString);
    AEmails := SplitS(Trim(AQuery.FieldByName('email').AsString), [';', ',', '/', '\', '|', ' ']);
    try
    for I := AEmails.Count - 1 downto 0 do
      if Trim(AEmails[I]) = '' then
        AEmails.Delete(I);
    if AEmails.Count > 1 then
      AEmail := AEmails[0];
    finally
      AEmails.Free();
    end;

    if Trim(AEmail) = '' then
    begin
      if not AShowMessage then
        Exit;

      raise Exception.Create('Sem email configurado' +#13 + #13 +
        'Por favor configure o email no cadastro do colaborador');
    end;

    AQuery.Close;
    AQuery.SQL.Text := 'select cod_vendedor, nome_vendedor, email from colaborador' +
      ' where lower(email) like :email' +
      ' and cod_vendedor <> ' + IntToStr(vCodUsuario) +
      ' and cod_empresa = ' + codEmpresa;
    AQuery.ParamByName('email').AsString := LowerCase(AEmail) + '%';
    AQuery.Open;
    AQuery.FetchAll;
    if AQuery.RecordCount >= 1 then
    begin
      AMensagem := TStringList.Create;
      try
        AMensagem.Add('Seu email está duplicado: ' + LowerCase(AEmail));
        AMensagem.Add('Por favor configure o email no cadastro do colaborador sem duplicar');
        AMensagem.Add('O email correto é necessario para acessar o chat e a abertura de chamados');
        AMensagem.Add('');
        if AQuery.RecordCount = 1 then
          AMensagem.Add('Outro cadastro de colaborador também está utilizando o mesmo email')
        else
          AMensagem.Add('Outros cadastros de colaboradores também estão utilizando o mesmo email');
        AMensagem.Add('');
        AQuery.First;
        while not AQuery.Eof do
        begin
          AMensagem.Add(StrZero(AQuery.FieldByName('cod_vendedor').AsInteger, 3) + ' - ' +
                        Trim(AQuery.FieldByName('nome_vendedor').AsString)
                       );
          AQuery.Next;
        end;

        if AShowMessage then
        begin
          ShowAtencao(AMensagem.Text);
          Exit;
        end;

      finally
        FreeAndNil(AMensagem);
      end;
    end
    else
      Result := True;
  except on E: Exception do
    begin
      if AShowMessage then
        ShowAtencao(E.Message);
    end;
  end;
end;

function TSingleton.ApiHwExtractToken(var AText: WideString): WideString;
begin
  if (Pos('<token>', AText) = 1) and (Pos('<token/>', AText) > 8)  then
  begin
    Result := Copy(AText, 1, Pos('<token/>', AText) + 7);
    AText := Copy(AText, Pos('<token/>', AText) + 8, Length(AText));
  end
  else
    Result := '';
end;

procedure TSingleton.AtualizarColunasDBGrid(var pDBGrid: TDBGrid;
  cdsColunas: TClientDataSet; pUsuario: string; 
  vAlterarNomeDtSet: string = '');
var
	I: Integer;
begin
	cdsColunas.DisableControls;
  cdsColunas.Close;
  cdsColunas.CommandText := ' select * from config_colunas ' +
  	' where usuario = ' + QuotedStr(pUsuario)+
    ' and componente = ' + QuotedStr(pDBGrid.DataSource.DataSet.Name + vAlterarNomeDtSet);
  cdsColunas.Open;

  if cdsColunas.IsEmpty then
    exit;
    
	for I := 0 to pDBGrid.FieldCount - 1 do
  begin
  	if cdsColunas.Locate('campos', pDBGrid.DataSource.DataSet.Name + pDBGrid.Fields[I].FieldName, []) then
    	pDBGrid.Fields[I].Visible := cdsColunas.FieldByName('VISIVEL').AsInteger = 1;
  end;       
end;

function TSingleton.AtualizarChassiPlaca(var pChassi: string; var pPlaca: string; pBuscas: TIBQuery): boolean;
var
  vPlaca: string;
  vChassi: string;
  vConverterPlaca: boolean;

  vCodigoTmp: Integer;
  vChassiTmp: string;
  vPlacaTmp: string;
begin
	try
    Result := false;
    Application.CreateForm(TfrmAlterarChassiPlaca, frmAlterarChassiPlaca);
    frmAlterarChassiPlaca.lbChassi.Visible := true;
    frmAlterarChassiPlaca.EdChassi.Visible := true;
    frmAlterarChassiPlaca.lbPlaca.Visible := true;
    frmAlterarChassiPlaca.EdPlaca.Visible := true;
    frmAlterarChassiPlaca.RadioGroup1.Visible := true;
    frmAlterarChassiPlaca.vPlaca := pPlaca;
    frmAlterarChassiPlaca.vChassi := pChassi;
    frmAlterarChassiPlaca.vBuscas := pBuscas;

    if vVeic.vDesabilitarChassi then
    begin
    	frmAlterarChassiPlaca.RadioGroup1.ItemIndex := 0;
      frmAlterarChassiPlaca.lbChassi.Visible := false;
      frmAlterarChassiPlaca.EdChassi.Visible := false;
      frmAlterarChassiPlaca.lbPlaca.Left := 8;
    	frmAlterarChassiPlaca.EdPlaca.Left := 49;

      frmAlterarChassiPlaca.RadioGroup1.Items[1] := 'Alterar Placa';
    end
    else
    begin
      if trim(pPlaca) = '' then
      begin
         frmAlterarChassiPlaca.RadioGroup1.ItemIndex := 1;
         frmAlterarChassiPlaca.RadioGroup1.Visible := false;
         frmAlterarChassiPlaca.lbPlaca.Visible := false;
         frmAlterarChassiPlaca.EdPlaca.Visible := false;
      end;
    end;

    if frmAlterarChassiPlaca.ShowModal <> IDOK then
      exit;

    vConverterPlaca := frmAlterarChassiPlaca.RadioGroup1.ItemIndex = 0;
    vChassi := trim(frmAlterarChassiPlaca.EdChassi.Text);
    vPlaca  := trim(frmAlterarChassiPlaca.EdPlaca.Text);

    if vVeic.vDesabilitarChassi then
    	vChassi := trim(frmAlterarChassiPlaca.EdPlaca.Text);;

    if not PesqPros(IfThen(vConverterPlaca, 'VEI169', 'VEI170'),
    	'SALVAR - ' +
      	IfThen(vConverterPlaca,
        	'Placa Ant: ' + pPlaca + ' Placa Nova: ' + vPlaca,
          'Placa Ant: ' + pPlaca + ' Chassi Ant: ' + pChassi + ' Placa Nova: ' + vPlaca + ' Chassi Novo: ' +  vChassi) +
        ' Alt OS/ORC/NF: ' + IfThen(frmAlterarChassiPlaca.ckAlterarInfOsOrcNF.Checked, 'S', 'N'),
      '', 'VEICULOS', '',
      pBuscas, true) then
      Exit;

    if not vVeic.vDesabilitarChassi then
      if vConverterPlaca then
        vChassi := '';


    if frmAlterarChassiPlaca.ckAlterarInfOsOrcNF.Checked then
    begin
      if (trim(vPlaca) <> '') and (trim(vPlaca) <> trim(pPlaca)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update veiculos set placa = ' + QuotedStr(vPlaca) +
          ' where placa = ' + QuotedStr(pPlaca) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if (trim(vChassi) <> '') and (trim(vChassi) <> trim(pChassi)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update veiculos set chassi = ' + QuotedStr(vChassi) +
          ' where chassi = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if (trim(vPlaca) <> '') and (trim(vPlaca) <> trim(pPlaca)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update pedvenda set placa = ' + QuotedStr(vPlaca) +
          ' where placa = ' + QuotedStr(pPlaca) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if (trim(vChassi) <> '') and (trim(vChassi) <> trim(pChassi)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update pedvenda set chassi = ' + QuotedStr(vChassi) +
          ' where chassi = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      // Veículos movimentados
      if vVeic.vDesabilitarChassi then
      	// Não fazer nada
      else if (trim(vPlaca) <> '') and (trim(vPlaca) <> trim(pPlaca)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update est_moto set placaest = ' + QuotedStr(vPlaca) +
          ' where placaest = ' + QuotedStr(pPlaca) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if vVeic.vDesabilitarChassi then
      	// Não fazer nada
      else if (trim(vChassi) <> '') and (trim(vChassi) <> trim(pChassi)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update est_moto set chassi_c = ' + QuotedStr(vChassi) +
          ' where chassi_c = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      // Notas Fiscais
      if vVeic.vDesabilitarChassi then
      	// Não fazer nada
      else if (trim(vPlaca) <> '') and (trim(vPlaca) <> trim(pPlaca)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update notafiscal_item_veiculo set placa = ' + QuotedStr(vPlaca) +
          ' where placa = ' + QuotedStr(pPlaca) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if vVeic.vDesabilitarChassi then
      	// Não fazer nada
      else if (trim(vChassi) <> '') and (trim(vChassi) <> trim(pChassi)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update notafiscal_item set chassi = ' + QuotedStr(vChassi) +
          ' where chassi = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;

        pBuscas.Close;
        pBuscas.SQL.Text := ' update notafiscal_item_veiculo set chassi = ' + QuotedStr(vChassi) +
          ' where chassi = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      // Historico Veículo
      if (trim(vPlaca) <> '') and (trim(vPlaca) <> trim(pPlaca)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update hist_estmoto set placaest = ' + QuotedStr(vPlaca) +
          ' where placaest = ' + QuotedStr(pPlaca) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if (trim(vChassi) <> '') and (trim(vChassi) <> trim(pChassi)) then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' update hist_estmoto set chassi_c = ' + QuotedStr(vChassi) +
          ' where chassi_c = ' + QuotedStr(pChassi) +
          ' and cod_empresa = ' + codEmpresa;
        pBuscas.ExecSQL;
      end;

      if pBuscas.Transaction.InTransaction then
      	pBuscas.Transaction.Commit;
    end;

    if (trim(vChassi) <> '') and (trim(pChassi) <> '') then
	    if trim(vChassi) <> trim(pChassi) then
      	pChassi := vChassi;

    if (trim(vPlaca) <> '') and (trim(pPlaca) <> '') then
    	if trim(vPlaca) <> trim(pPlaca) then
      	pPlaca := vPlaca;

    GravaAuditoria(IfThen(vConverterPlaca, 'VEI169', 'VEI170'),
    	'SALVAR - ' +
      	IfThen(vConverterPlaca,
        	'Placa Ant: ' + pPlaca + ' Placa Nova: ' + vPlaca,
          'Placa Ant: ' + pPlaca + ' Chassi Ant: ' + pChassi + ' Placa Nova: ' + vPlaca + ' Chassi Novo: ' +  vChassi) +
        ' Alt OS/ORC/NF: ' + IfThen(frmAlterarChassiPlaca.ckAlterarInfOsOrcNF.Checked, 'S', 'N'),
      'SUCESSO', 'VEICULOS', '', pBuscas);

    Result := true;
  except on E: Exception do
    begin
      Result := False;

      GravaAuditoria(IfThen(vConverterPlaca, 'VEI169', 'VEI170'),
        'SALVAR - ' +
          IfThen(vConverterPlaca,
            'Placa Ant: ' + pPlaca + ' Placa Nova: ' + vPlaca,
            'Placa Ant: ' + pPlaca + ' Chassi Ant: ' + pChassi + ' Placa Nova: ' + vPlaca + ' Chassi Novo: ' +  vChassi) +
          ' Alt OS/ORC/NF: ' + IfThen(frmAlterarChassiPlaca.ckAlterarInfOsOrcNF.Checked, 'S', 'N'),
        'FALHA', 'VEICULOS', '', pBuscas);

      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function AtualizarChassiPlaca. Erro: ' + e.Message);
    end;
  end;
end;

procedure TSingleton.editContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
var
	I: Integer;
begin
	if pCodCliente <= 0 then
  	Exit;

  if not vDadosIni.abreFormEditarContatoCliente(
    pCodCliente,
    pOrigem,
    cTpContatoCliente,
    pCheckListContato) then
      Exit;

  vDadosIni.retornaCheckListContato(
    pCodCliente,
    pOrigem,
    pCheckListContato
  );

  if pOrigem <> cContrato then
  begin
    for I := 0 to vListaContatoTemp.Count - 1 do
    begin
      pCheckListContato.Items.Add(
        trim(vListaContatoTemp[I]) + ' * '
      );

      pCheckListContato.Checked[pCheckListContato.Items.Count - 1] := True;
    end;
  end;
end;

function TSingleton.empresaEstaUnificada(pCodigUnificada: Integer): Boolean;
var
  vTemp: string;
begin
  if not vEmp.vFinanceiroUnificado then
  begin
    Result := False;
    Exit;
  end;

  vTemp := StringReplace(vEmp.vCodigoUnificadas, ',','|', [rfReplaceAll, rfIgnoreCase]);
  vTemp := StringReplace(vTemp, '(','|', [rfReplaceAll, rfIgnoreCase]);
  vTemp := StringReplace(vTemp, ')','|', [rfReplaceAll, rfIgnoreCase]);
  vTemp := StringReplace(vTemp, ' ','|', [rfReplaceAll, rfIgnoreCase]);

  Result := Pos('|' + IntToStr(pCodigUnificada) + '|', vTemp) > 0;
end;

