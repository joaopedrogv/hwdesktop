function TSingleton.CreateProcessSimple(cmd: string; pWait: Boolean; AhideWindow: Boolean): boolean;
var
  SUInfo: TStartupInfo;
  ProcInfo: TProcessInformation;
begin
  FillChar(SUInfo, SizeOf(SUInfo), #0);
  SUInfo.cb := SizeOf(SUInfo);
  SUInfo.dwFlags := STARTF_USESHOWWINDOW;
  SUInfo.wShowWindow := SW_SHOW;

  if AhideWindow then
  Result := CreateProcess(nil, PChar(cmd), nil, nil, false, CREATE_NO_WINDOW, nil, nil, SUInfo, ProcInfo)
  else
  Result := CreateProcess(nil, PChar(cmd), nil, nil, false, CREATE_NEW_CONSOLE or
    NORMAL_PRIORITY_CLASS, nil, nil, SUInfo, ProcInfo);

  if (Result) then
  begin
    if pWait then
    WaitForSingleObject(ProcInfo.hProcess, INFINITE)
    else
    WaitForSingleObject(ProcInfo.hProcess, 0);
    CloseHandle(ProcInfo.hProcess);
    CloseHandle(ProcInfo.hThread);
  end;
end;

procedure TSingleton.criaChecksColunas(DBGrid: TClientDataSet; cdsColunas: TClientDataSet; form: TForm; vCheck: TCheckBox; ScrollBox: TScrollBox);
var
  k, i, altura: integer;
  jaexiste: boolean;
begin
  jaexiste := false;
  jaexiste := false;
  cdsColunas.IndexFieldNames := 'campos';
  altura := 0;
  for I := 0 to DBGrid.FieldCount - 1 do
  begin
    for k := 0 to form.ComponentCount - 1 do //Testando aqui o CheckBox já não existe.
    begin
      if (form.Components[k] is TCheckBox) then
        if DBGrid.Fields[i].Name = TCheckBox(form.Components[k]).Name then
        begin
          jaexiste := true;
        end;
    end;
    if not jaexiste then
    begin
      altura := altura + 15;
      vCheck := TCheckBox.create(form);
      vCheck.Alignment := taRightJustify;
      vCheck.Parent := ScrollBox;
      vCheck.Name := DBGrid.Fields[i].Name;
      vCheck.Caption := DBGrid.Fields[i].DisplayName;
      vCheck.Tag := DBGrid.Fields[i].Index;
      vCheck.Left := 16;
      vCheck.Width := 225;
      vCheck.Top := altura;
      vCheck.Visible := true;
      vCheck.Checked := DBGrid.Fields[I].Visible;
      if not((DBGrid.Fields[I].Tag = 0) or (DBGrid.Fields[I].Tag = 3))  then
        vCheck.Enabled := false;
    end;
  end;
end;

