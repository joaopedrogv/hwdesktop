procedure TSingleton.cadastrosbasicos_empresaadq(pTipoForm: Integer);
var
  AProcedure: Tcadastrosbasicos_empresaadq;
begin
  if vCadBasicos.AHandle = 0 then
    CarregaPacote('pkCadastrosBasicos', vCadBasicos.AHandle);

  if vCadBasicos.AHandle = 0 then
  begin
    Application.MessageBox('Pacote Cadastros Basicos não carregado', 'Atenção', 0 + 64);
    Exit;
  end;
  @AProcedure := GetProcAddress(vCadBasicos.AHandle, 'cadastrosbasicos_empresaadq');
  if Assigned(AProcedure) then
    AProcedure(pTipoForm);
end;

function TSingleton.testarControleProgFid(pbuscas: TIBQuery): boolean;
begin
  try
    Result := true;

    if vProgFid.vCodControle <= 0 then
    begin
      Result := false;
      Application.MessageBox(pchar('Código do controle configurado como baixa automática para formas de pagamento de vales (resgate/troca) não informado nas configurações do Programa de fidelidade!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    SqlOpen(' select coalesce(baixa_automatica, ''N'') baixa_automatica, coalesce(n_conta_bx_auto, 0) n_conta_bx_auto from controles ' +
      ' where codigo_ctrl = ' + IntToStr(vProgFid.vCodControle) +
      ' and codigo_emp = ' + codEmpresa, pbuscas);

    if pbuscas.IsEmpty then
    begin
    	Result := false;
      Application.MessageBox(pchar('Controle informado nas configurações do programa de fidelidade não encontrado!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if trim(pbuscas.FieldByName('baixa_automatica').AsString) <> 'S' then
    begin
      Result := false;
      Application.MessageBox(pchar('Controle informado nas configurações do programa de fidelidade não esta definido como baixa automática!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(PChar('Erro ao testar controle - prog fid: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao testar controle - prog fid: ' + e.Message);
    end;
  end;
end;

function TSingleton.testarHtmlBoleto(
	pNossoNumero: string; pCnpjCpf: string;
  pDataVenc: TDateTime; pValorBol: Double; pValorDesc: Double;
	pHtmlBase64: string; pTipo: string = 'HTML'): boolean;
var
	vEncNossoNumero: boolean;
  vEncCnpjCpf: boolean;
  vEncDataVenc: boolean;
  vEncValorBoleto: boolean;
begin
	try
		Result := False;
    vEncNossoNumero := False;
    vEncCnpjCpf := False;
    vEncDataVenc := False;
  	vEncValorBoleto := False;

    vEncNossoNumero := Pos(apenasNumeros(pNossoNumero), apenasNumeros(pHtmlBase64)) > 0;

    if not vEncNossoNumero then
    begin
    	Application.MessageBox(pchar('Nosso número não encontrado no html do boleto, favor reimprimir!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    vEncCnpjCpf := Pos(apenasNumeros(pCnpjCpf), apenasNumeros(pHtmlBase64)) > 0;

    if not vEncCnpjCpf then
    begin
    	Application.MessageBox(pchar('CPNJ / CPF não encontrado no html do boleto, favor reimprimir!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    vEncDataVenc := Pos(FormatDateTime('dd/mm/yyyy', pDataVenc), pHtmlBase64) > 0;

    if not vEncDataVenc then
    begin
      Application.MessageBox(pchar('Data de vencimento não encontrado no html do boleto, favor reimprimir!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    vEncValorBoleto := Pos(apenasNumeros(FloatToStr(pValorBol + pValorDesc)), apenasNumeros(pHtmlBase64)) > 0;

    if not vEncValorBoleto then
    begin
      Application.MessageBox(pchar('Valor do boleto não encontrado no html do boleto, favor reimprimir!'), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    Result := (vEncNossoNumero) and (vEncCnpjCpf) and (vEncDataVenc) and (vEncValorBoleto);

  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao testa HtmlBoleto. Erro: ' + e.Message),
