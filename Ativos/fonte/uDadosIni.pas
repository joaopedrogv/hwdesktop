//      Registro.WriteString('Database', vBancoHW); //Grava o endereço da sua aplicação no Registro

//    vatual := registro.ReadString('Dbname');
//    if vatual <> vBancoHW then
//      Registro.WriteString('Dbname', vBancoHW); //Grava o endereço da sua aplicação no Registro

//    Registro.CloseKey; // Fecha a chave e o objeto

//    Registro.RootKey := HKEY_LOCAL_MACHINE;
//    if Registro.OpenKey('SOFTWARE\Wow6432Node\ODBC\ODBC.INI\' + alias, False) then
//      if vatual <> vBancoHW then
//        Registro.WriteString('Dbname', vBancoHW);

    Registro.Free;
    Result := true;
  except
    Application.MessageBox(Pchar('Erro ao gravar no registro o endereço do ODBC para: ' + vBancoHW
      +
      ' com o alias ' + alias), 'Erro', MB_OK + MB_ICONERROR);
    Result := false;
  end;
