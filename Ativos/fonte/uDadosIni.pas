function TSingleton.mudarStatusSeparacao(pNPED: integer; pTipo: string;
  pStatusSeparacao: TStatusSeparacao; pQry: TIBQuery; pComita: Boolean): Boolean;
var
  vStatusSeparacao: string;
begin
	try
  	Result := False;

//    if UpperCase(vEmp.vUSAR_SEPARACAO_PED) <> 'S' then
//    begin
//      Result := True;
//    	Exit;      
//    end;
    
    case pStatusSeparacao of
      cEmBranco: vStatusSeparacao := '';
      cSeparacao: vStatusSeparacao := 'SEPARACAO';
      cEmSeparacao: vStatusSeparacao := 'EM SEPARACAO';
      cSeparado: vStatusSeparacao := 'SEPARADO';
      cConferencia: vStatusSeparacao := 'CONFERENCIA';
      cConferido: vStatusSeparacao := 'CONFERIDO';
      cDevolucaoConferencia: vStatusSeparacao := 'DEVOLUCAO CONFERENCIA';
    end;
    
    pQry.Close;
    pQry.SQL.Text := 'UPDATE PEDVENDA P SET P.STATUS_SEP_CONF = :STATUS_SEP_CONF '+
		'WHERE P.NPED = :NPED '+
		'AND P.TIPO = :TIPO '+
		'AND P.COD_EMPRESA = :COD_EMPRESA';
    pQry.ParamByName('STATUS_SEP_CONF').AsString := vStatusSeparacao;
    pQry.ParamByName('NPED').AsInteger := pNPED;
    pQry.ParamByName('TIPO').AsString := pTipo;
    pQry.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);

    pQry.ExecSQL;

    if pComita then
      if pQry.Transaction.InTransaction then
        pQry.Transaction.Commit;

    Result := True;
  except on E: Exception do
    begin
    	Result := False;
			if pComita then
      	if pQry.Transaction.InTransaction then
        	pQry.Transaction.Rollback;
          
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;  
  end;
end;

