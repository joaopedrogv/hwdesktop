  try
    Registro := TRegistry.Create(KEY_ALL_ACCESS);
    Registro.RootKey := HKEY_CURRENT_USER;

    Registro.OpenKey('Software\ODBC', True);
    Registro.CloseKey;

    Registro.OpenKey('Software\ODBC\ODBC.INI', True);
    Registro.CloseKey;

    if Registro.OpenKey('SOFTWARE\ODBC\ODBC.INI\' + alias, True) then
    begin
