    else if decodifica(copy(temp, 1, 2)) = '-e' then
      codEmpresa := decodifica(Copy(temp, 3, length(temp)));
  end;
  if (usuario <> '') and (senha <> '') then
    Result := true
  else
    Result := false;
end;

