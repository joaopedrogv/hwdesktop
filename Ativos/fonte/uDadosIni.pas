procedure TSingleton.montarExcel(DBGrid: TDBGrid; vNomePlanilha: string; pAcao: string = '');
//pAcao: A = abrir; F = Fechar; N: Nao abrir nem fechar
const
  xlCellTypeLastCell = $0000000B;
var
  vTemp: string;
  vPointer: Pointer;
  vCor, vLinhaExcel: integer;
  I: Integer;
  DataAux: TDateTime;
  DiaAux: word;
  MesAux: word;
  AnoAux: word;
  vOK: Boolean;
begin
  if (vOpenOfficeExportRel = 'S') then
  begin
	  montarCalc(DBGrid, vNomePlanilha, pAcao);
    exit;
  end;

  if (pAcao = '') then
  begin
    Application.CreateForm(TfrmColunasExcelAtivos, frmColunasExcelAtivos);
    frmColunasExcelAtivos.vDataSetTabela := TClientDataSet(DBGrid.DataSource.DataSet);
    frmColunasExcelAtivos.vNomeUsuario := vNomeUsuario;
    frmColunasExcelAtivos.vTitulo := vNomePlanilha;
    frmColunasExcelAtivos.vTransacao := transacaoCol;
    frmColunasExcelAtivos.ShowModal;
    Exit;
  end;

  if (pAcao = 'A') or (pAcao = '') then
    vOK := criarExcel(DBGrid, vNomePlanilha)
  else
    vOK := True;

  if vOK then
  begin
    try
      vPointer := TClientDataSet(DBGrid.DataSource.DataSet).GetBookmark;

      if (pAcao = 'F') or (pAcao = 'N') then
      begin
        sheet.Cells.SpecialCells($0000000B, EmptyParam).Activate;
        vLinhaExcel := excel.ActiveCell.Row;
        vLinhaExcel := vLinhaExcel + 2;
        sheet.cells[vLinhaExcel, 01] := vNomePlanilha;
        sheet.cells[vLinhaExcel, 01].Font.Size := 12;
        sheet.cells[vLinhaExcel, 01].Font.Bold := True;
        vLinhaExcel := vLinhaExcel + 1;
        for I := 1 to DBGrid.Columns.Count do
          if DBGrid.Columns[I - 1].Visible then
          begin
            vtemp := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).DisplayName;
            sheet.cells[vLinhaExcel, I] := vtemp;
            sheet.cells[vLinhaExcel, I].Interior.Color := $00FFCF9C;
          end;

        vLinhaExcel := vLinhaExcel + 1;
      end
      else
      vLinhaExcel := 3;
      TClientDataSet(DBGrid.DataSource.DataSet).First;
      while not TClientDataSet(DBGrid.DataSource.DataSet).Eof do
      begin
        abreStatusProcessamento('', 'Exportando para o excel - '+vNomePlanilha+'...');
        for I := 1 to DBGrid.Columns.Count do
        begin
          vTemp := Trim(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsString);
          if vTemp = '' then
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TDateTimeField then
          begin
            DataAux := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime;
            DecodeDate(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime, AnoAux, MesAux, DiaAux);
            if DataAux - EncodeDate(AnoAux, MesAux, DiaAux) = 0 then
              sheet.cells[vLinhaExcel, I].Value := EncodeDate(AnoAux, MesAux, DiaAux)
            else sheet.cells[vLinhaExcel, I].Value := DataAux; //datetostr(DataAux);
//            sheet.cells[vLinhaExcel, I].Value := EncodeDate(YearOf(StrToDate(vTemp)),MonthOf(StrToDate(vTemp)),DayOf(StrToDate(vTemp)))
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TFloatField then
          begin
            sheet.cells[vLinhaExcel, I].Value := StrToFloat(StringReplace(vTemp, '.', '', [rfReplaceAll]));
            vTemp := Trim(TFloatField(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName)).DisplayFormat);
            if vTemp <> '' then
            begin
              vTemp := StringReplace(vTemp, '#', '', [rfReplaceAll]);
              vTemp := StringReplace(vTemp, '.', ',', [rfReplaceAll]);
            end
            else
              vTemp := '0,00';
            sheet.cells[vLinhaExcel, I].NumberFormat := vTemp;
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TStringField then
          begin
            sheet.cells[vLinhaExcel, I].NumberFormat := '@';
            sheet.cells[vLinhaExcel, I].Value := vTemp;
          end
          else
            sheet.cells[vLinhaExcel, I] := vTemp;

          if (vLinhaExcel mod 2) = 1 then
            sheet.cells[vLinhaExcel, I].Interior.Color := 8303567 //ColorToRGB(clYellow)
          else
            sheet.cells[vLinhaExcel, I].Interior.Color := 13893372; //ColorToRGB(clSkyBlue);
        end;

        Inc(vLinhaExcel);

        TClientDataSet(DBGrid.DataSource.DataSet).Next;
      end;

      TClientDataSet(DBGrid.DataSource.DataSet).GotoBookmark(vPointer);

      excel.Cells.EntireRow.AutoFit;
      excel.Cells.EntireColumn.AutoFit;
    finally
    	fechaStatusProcessamento;
      if (pAcao = '') or (pAcao = 'F') then
        excel.visible := True;
    end;
  end;
end;

procedure TSingleton.montarExcel2(var pExcel: Variant; DBGrid: TDBGrid;
  vNomePlanilha, pAcao, pNameSheet: string; pContinuarNoSheet: boolean;
  GridDetalhe: TDBGrid);
//pAcao: A = abrir; F = Fechar; N: Nao abrir nem fechar ,pExcel deve ser criado no formulário para que o arquivo excel não fique nã mémoria após fechar a aplicação.
const
  xlCellTypeLastCell = $0000000B;
var
  vTemp: string;
  vPointer: Pointer;
  vCor, vLinhaExcel,vLinhaExcelD: integer;
  I,K: Integer;
  DataAux: TDateTime;
  vOK: Boolean;
begin
	if (vOpenOfficeExportRel = 'S') then
  begin
	  montarCalc2(pExcel, DBGrid,
		  vNomePlanilha, pAcao, pNameSheet, pContinuarNoSheet,
  		GridDetalhe);
    exit;
  end;

  if Length(pNameSheet)>28 then
    pNameSheet:= copy(pNameSheet,1,28);
  vOK := criarExcel2(pExcel, DBGrid, vNomePlanilha,pNameSheet,pContinuarNoSheet) ;
  if vOK then
  begin
    try
      vPointer := TClientDataSet(DBGrid.DataSource.DataSet).GetBookmark;
      vLinhaExcel := pExcel.ActiveCell.Row;
      inc(vLinhaExcel);
      vLinhaExcelD:=0;
      if DBGrid.DataSource.DataSet.IsEmpty then
        exit;
      TClientDataSet(DBGrid.DataSource.DataSet).First;
      while not TClientDataSet(DBGrid.DataSource.DataSet).Eof do
      begin
        abreStatusProcessamento('', 'Exportando para o excel - '+vNomePlanilha+'...');
        for I := 1 to DBGrid.Columns.Count do
        begin
          vTemp := Trim(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsString);
          if vTemp = '' then
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TDateTimeField then
          begin
            DataAux := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime;
            if DataAux < 0 then
              sheet.cells[vLinhaExcel, I].Value := datetostr(DataAux)
            else if DataAux = 0 then
              sheet.cells[vLinhaExcel, I].Value :=datetostr(1)
            else sheet.cells[vLinhaExcel, I].Value := DataAux;// EncodeDate(AnoAux, MesAux, DiaAux); //datetostr(DataAux);
//            sheet.cells[vLinhaExcel, I].Value := EncodeDate(YearOf(StrToDate(vTemp)),MonthOf(StrToDate(vTemp)),DayOf(StrToDate(vTemp)))
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TFloatField then
          begin
            sheet.cells[vLinhaExcel, I].Value := StrToFloat(StringReplace(vTemp, '.', '', [rfReplaceAll]));
            vTemp := Trim(TFloatField(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName)).DisplayFormat);
            if vTemp <> '' then
            begin
              vTemp := StringReplace(vTemp, '#', '', [rfReplaceAll]);
              vTemp := StringReplace(vTemp, '.', ',', [rfReplaceAll]);
            end
            else
              vTemp := '0,00';
            sheet.cells[vLinhaExcel, I].NumberFormat := vTemp;
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TStringField then
          begin
            sheet.cells[vLinhaExcel, I].NumberFormat := '@';
            sheet.cells[vLinhaExcel, I].Value := vTemp;
          end
          else
            sheet.cells[vLinhaExcel, I] := vTemp;
          if (((vLinhaExcel) mod 2) = 1) or (vLinhaExcelD>0) then
            sheet.cells[vLinhaExcel, I].Interior.Color := 8303567 //ColorToRGB(clYellow)
          else
            sheet.cells[vLinhaExcel, I].Interior.Color := 13893372; //ColorToRGB(clSkyBlue);
        end;
        Inc(vLinhaExcel);

        if GridDetalhe<>nil then
        begin
          if not TClientDataSet(GridDetalhe.DataSource.DataSet).IsEmpty then
          begin
            for K := 1 to GridDetalhe.Columns.Count do
              if GridDetalhe.Columns[K-1].Visible then
              begin
                vtemp := TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName).DisplayName;
                sheet.cells[vLinhaExcel, K+1] := vtemp;
  //              sheet.cells[vLinhaExcel, 01].Font.Bold := True;
                sheet.cells[vLinhaExcel, K+1].Interior.Color := $00ACC891;//$00FFCF9C;
              end;
            Inc(vLinhaExcelD);
            Inc(vLinhaExcel);
          end;
          while not TClientDataSet(GridDetalhe.DataSource.DataSet).Eof do
          begin
            for K := 1 to GridDetalhe.Columns.Count do
            begin
              vTemp := Trim(TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName).AsString);
              if vTemp = '' then
              else if TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName) is TDateTimeField then
              begin
                DataAux := TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName).AsDateTime;
                if DataAux < 0 then
                  sheet.cells[vLinhaExcel, K+1].Value := datetostr(DataAux)
                else if DataAux = 0 then
                  sheet.cells[vLinhaExcel, K+1].Value :=datetostr(1)
                else sheet.cells[vLinhaExcel, K+1].Value := DataAux;// EncodeDate(AnoAux, MesAux, DiaAux); //datetostr(DataAux);
              end
              else if TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName) is TFloatField then
              begin
                sheet.cells[vLinhaExcel, K+1].Value := StrToFloat(StringReplace(vTemp, '.', '', [rfReplaceAll]));
                vTemp := Trim(TFloatField(TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName)).DisplayFormat);
                if vTemp <> '' then
                begin
                  vTemp := StringReplace(vTemp, '#', '', [rfReplaceAll]);
                  vTemp := StringReplace(vTemp, '.', ',', [rfReplaceAll]);
                end
                else
                  vTemp := '0,00';
                sheet.cells[vLinhaExcel, K+1].NumberFormat := vTemp;
              end
              else if TClientDataSet(GridDetalhe.DataSource.DataSet).FieldByName(GridDetalhe.Columns[K - 1].FieldName) is TStringField then
              begin
                sheet.cells[vLinhaExcel, K+1].NumberFormat := '@';
                sheet.cells[vLinhaExcel, K+1].Value := vTemp;
              end
              else
                sheet.cells[vLinhaExcel, K+1] := vTemp;
  //            if (vLinhaExcel mod 2) = 1 then
  //              sheet.cells[vLinhaExcel, K+1].Interior.Color := 8303567 //ColorToRGB(clYellow)
  //            else
  //              sheet.cells[vLinhaExcel, K+1].Interior.Color := 13893372; //ColorToRGB(clSkyBlue);
            end;
            Inc(vLinhaExcel);
            Inc(vLinhaExcelD);
            TClientDataSet(GridDetalhe.DataSource.DataSet).Next;
          end;
        end;
        TClientDataSet(DBGrid.DataSource.DataSet).Next;
      end;
      sheet.Cells.SpecialCells($0000000B, EmptyParam).Activate;
      TClientDataSet(DBGrid.DataSource.DataSet).GotoBookmark(vPointer);
      pExcel.Cells.EntireRow.AutoFit;
      pExcel.Cells.EntireColumn.AutoFit;
    finally
      fechaStatusProcessamento;
      if (pAcao = '') or (pAcao = 'F') then
        pExcel.visible := True;
    end;
  end;
end;

