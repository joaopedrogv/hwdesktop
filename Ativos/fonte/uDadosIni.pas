      'Arquivo: ' + FileName));
end;

function TLeitorIni.ReadString(const Section, Ident, Default: string): string;
var
  I: Integer;
  SearchIdent: Boolean;
begin
  Result := Default;
  SearchIdent := False;
  for I := 0 to fLeitor.Count - 1 do
  begin
    if Pos('[' + Section + ']', fLeitor[i]) = 1 then // inicio com a Section do parametro
      SearchIdent := True
    else if (Pos('[', fLeitor[i]) = 1) // outra Section qualquer quer dizer que a Section Anterior ja foi totalmente lida
      and (SearchIdent) then // ja iniciou a leitura se valor SearchIdent = True
      Break
    else if SearchIdent then
      if Pos(Ident + '=', fLeitor[i]) = 1 then
      begin
        Result := fLeitor[i];
        System.Delete(Result, 1, Length(Ident + '='));
      end;
  end;
end;

function TLeitorIni.ReadString(const Ident, Default: string): string;
var
  I: Integer;
begin
  Result := Default;
  for I := 0 to fLeitor.Count - 1 do
    if Pos(Ident + '=', fLeitor[i]) = 1 then
    begin
      Result := fLeitor[i];
      System.Delete(Result, 1, Length(Ident + '='));
    end;
end;

