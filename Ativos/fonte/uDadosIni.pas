function TSingleton.GravarHistEstMoto(buscas: TIBQuery; SpIncCodigo: TIBStoredProc; pHist: THistEstmoto; pDelete: boolean = False): Boolean;
var
 vTemp: string;
 vCodNf: Integer;
begin
  try
    if pDelete then
    begin
      buscas.Close;
      if trim(pHist.vTipo) = 'NF' then
        buscas.SQL.Text := 'delete from hist_estmoto ' +
         ' where chassi_c = ' + QuotedStr(pHist.vChassi) +
         ' and codigo = ' + IntToStr(pHist.vCodigo) +
         ' and natureza = ' + QuotedStr(pHist.vNatureza) +
         ' and tipo = ' + QuotedStr(pHist.vTipo) +
         ' and numdoc = ' + IntToStr(pHist.vNumDoc) +
         ' and num_nota = ' + IntToStr(pHist.vNumNota) +
         ' and cod_empresa = ' + codEmpresa
      else
        buscas.SQL.Text := 'delete from hist_estmoto ' +
         ' where chassi_c = ' + QuotedStr(pHist.vChassi) +
         ' and codigo = ' + IntToStr(pHist.vCodigo) +
         ' and natureza = ' + QuotedStr(pHist.vNatureza) +
         ' and tipo = ' + QuotedStr(pHist.vTipo) +
         ' and numdoc = ' + IntToStr(pHist.vNumDoc) +
         ' and cod_empresa = ' + codEmpresa;
      buscas.ExecSQL;
    exit;
    end;

    if trim(pHist.vStatusEstoque) = '' then
      pHist.vStatusEstoque := 'N';
    if trim(pHist.vStatusRes) = '' then
      pHist.vStatusRes := 'N';
    if trim(pHist.vStatusTransD) = '' then
      pHist.vStatusTransD := 'N';
    if trim(pHist.vStatusDemonst) = '' then
      pHist.vStatusDemonst := 'N';
    if trim(pHist.vStatusCanc) = '' then
      pHist.vStatusCanc := 'N';

    buscas.Close;
    if trim(pHist.vTipo) = 'NF' then
      buscas.SQL.Text := 'select first 1 * from hist_estmoto ' +
       ' where chassi_c = ' + QuotedStr(pHist.vChassi) +
       ' and codigo = ' + IntToStr(pHist.vCodigo) +
       ' and natureza = ' + QuotedStr(pHist.vNatureza) +
       ' and tipo = ' + QuotedStr(pHist.vTipo) +
       ' and numdoc = ' + IntToStr(pHist.vNumDoc) +
       ' and num_nota = ' + IntToStr(pHist.vNumNota) +
       ' and cod_empresa = ' + codEmpresa
    else
      buscas.SQL.Text := 'select first 1 * from hist_estmoto ' +
       ' where chassi_c = ' + QuotedStr(pHist.vChassi) +
       ' and codigo = ' + IntToStr(pHist.vCodigo) +
       ' and natureza = ' + QuotedStr(pHist.vNatureza) +
       ' and tipo = ' + QuotedStr(pHist.vTipo) +
       ' and numdoc = ' + IntToStr(pHist.vNumDoc) +
       ' and cod_empresa = ' + codEmpresa;
    buscas.Open;

    if buscas.IsEmpty then
    begin
      pHist.vCodHist := Gencodigo('HIST_ESTMOTO', SpIncCodigo, codEmpresa);
      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO HIST_ESTMOTO (COD_HIST, CHASSI_C, CODIGO, COD_EMPRESA, NATUREZA, NUMDOC, NUM_NOTA, TIPO, MODELO, PLACAEST, SERIE, ' +
        ' DATA, DATVENC, NATOP_V, TIPO_VENDA_V, COD_CLIENTE, COD_CLI_VENDE, COD_GERENTE, COD_CONCESS, COD_INTERMED, COD_VENDEDOR, COD_COND_PAG, PRECO_CUSTO, PRECO_TABEST, VALOR, RED_LUCRO, ' +
        ' TIPV_VEICULO, STATUS_DEMONST, STATUS_ESTOQUE, STATUS_RES, STATUS_TRANSDEP, STATUS_CANC, STATUS_USO, ALTERA_ESTOQUE_CFOP, ' +
        ' STATUS_NFE, SITUACAO_NFE, MODELO_NF , POSICAO, STATUS_V, EMISSAO_PROPRIA, N_COMANDONF, N_OS)' +
        ' VALUES ' +
        ' (:COD_HIST, :CHASSI_C, :CODIGO, :COD_EMPRESA, :NATUREZA, :NUMDOC, :NUM_NOTA, :TIPO, :MODELO, :PLACAEST, :SERIE, ' +
        ' :DATA, :DATVENC, :NATOP_V, :TIPO_VENDA_V, :COD_CLIENTE, :COD_CLI_VENDE, :COD_GERENTE, :COD_CONCESS, :COD_INTERMED, :COD_VENDEDOR, :COD_COND_PAG, :PRECO_CUSTO, :PRECO_TABEST, :VALOR, :RED_LUCRO, ' +
        ' :TIPV_VEICULO, :STATUS_DEMONST, :STATUS_ESTOQUE, :STATUS_RES, :STATUS_TRANSDEP, :STATUS_CANC, :STATUS_USO, :ALTERA_ESTOQUE_CFOP,' +
        ' :STATUS_NFE, :SITUACAO_NFE, :MODELO_NF, :POSICAO, :STATUS_V, :EMISSAO_PROPRIA, :N_COMANDONF, :N_OS);';
    end
    else
    begin
      pHist.vCodHist := buscas.FieldByName('COD_HIST').AsInteger;
      buscas.Close;
      buscas.SQL.Text := ' UPDATE HIST_ESTMOTO SET PLACAEST = :PLACAEST, SERIE = :SERIE, ' +
       ' DATA = :DATA, DATVENC = :DATVENC, NATOP_V = :NATOP_V, ' +
       ' NUM_NOTA = :NUM_NOTA, TIPO_VENDA_V = :TIPO_VENDA_V, COD_CLIENTE = :COD_CLIENTE, COD_VENDEDOR = :COD_VENDEDOR, ' +
       ' COD_COND_PAG = :COD_COND_PAG, PRECO_CUSTO = :PRECO_CUSTO, PRECO_TABEST = :PRECO_TABEST, VALOR = :VALOR, ' +
       ' RED_LUCRO = :RED_LUCRO, STATUS_NFE = :STATUS_NFE, SITUACAO_NFE = :SITUACAO_NFE, ' +
       ' TIPV_VEICULO = :TIPV_VEICULO, STATUS_DEMONST = :STATUS_DEMONST, STATUS_ESTOQUE = :STATUS_ESTOQUE, ' +
       ' STATUS_RES = :STATUS_RES, STATUS_TRANSDEP = :STATUS_TRANSDEP, ' +
       ' STATUS_CANC = :STATUS_CANC, STATUS_USO = :STATUS_USO, ' +
       ' ALTERA_ESTOQUE_CFOP = :ALTERA_ESTOQUE_CFOP, MODELO = :MODELO, MODELO_NF = :MODELO_NF, COD_CLI_VENDE = :COD_CLI_VENDE, ' +
       ' COD_GERENTE = :COD_GERENTE, COD_CONCESS = :COD_CONCESS, COD_INTERMED = :COD_INTERMED, POSICAO = :POSICAO, STATUS_V = :STATUS_V, ' +
       ' EMISSAO_PROPRIA = :EMISSAO_PROPRIA, N_COMANDONF = :N_COMANDONF, N_OS = :N_OS ' +
       ' WHERE (COD_HIST = :COD_HIST) AND (CHASSI_C = :CHASSI_C) AND (CODIGO = :CODIGO) ' +
       ' AND (COD_EMPRESA = :COD_EMPRESA) AND (NATUREZA = :NATUREZA) AND (NUMDOC = :NUMDOC) AND (TIPO = :TIPO);';
    end;
    buscas.ParamByName('CHASSI_C').AsString := pHist.vChassi;
    buscas.ParamByName('CODIGO').AsInteger := pHist.vCodigo;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
    buscas.ParamByName('NATUREZA').AsString := pHist.vNatureza;
    buscas.ParamByName('NUMDOC').AsInteger := pHist.vNumDoc;
    buscas.ParamByName('PLACAEST').AsString := pHist.vPlaca;
    buscas.ParamByName('TIPO').AsString := pHist.vTipo;
    buscas.ParamByName('MODELO').AsString := pHist.vModelo;
    buscas.ParamByName('NUM_NOTA').Value := pHist.vNumNota;
    buscas.ParamByName('SERIE').Value := pHist.vSerieNF;
    buscas.ParamByName('STATUS_NFE').Value := pHist.vStatusNF;
    buscas.ParamByName('SITUACAO_NFE').Value := pHist.vSituacaoNF;
    buscas.ParamByName('MODELO_NF').Value := pHist.vModeloNF;
    buscas.ParamByName('EMISSAO_PROPRIA').Value := pHist.vEmissaoPropriaNF;
    buscas.ParamByName('VALOR').AsFloat := pHist.vValorOP;
    buscas.ParamByName('DATA').AsString := pHist.vData;
    buscas.ParamByName('DATVENC').AsString := pHist.vDataVenc;
    buscas.ParamByName('NATOP_V').AsFloat := pHist.vNatOP;
    buscas.ParamByName('TIPO_VENDA_V').AsString := pHist.vTipoVenda;
    buscas.ParamByName('COD_CLIENTE').AsInteger := pHist.vCodCliente;
    buscas.ParamByName('COD_CLI_VENDE').AsInteger := pHist.vCodCliVend;
    buscas.ParamByName('COD_GERENTE').AsInteger := pHist.vCodGerente;
    buscas.ParamByName('COD_CONCESS').AsInteger := pHist.vCodConcess;
    buscas.ParamByName('COD_INTERMED').AsInteger := pHist.vCodIntermed;
    buscas.ParamByName('COD_VENDEDOR').AsInteger := pHist.vCodVendedor;
    buscas.ParamByName('COD_COND_PAG').AsInteger := pHist.vCodCondPag;
    buscas.ParamByName('PRECO_CUSTO').AsFloat := pHist.vPrecCusto;
    buscas.ParamByName('PRECO_TABEST').AsFloat := pHist.vPrecTabEst;
    buscas.ParamByName('RED_LUCRO').AsString := pHist.vRedLucro;
    buscas.ParamByName('TIPV_VEICULO').AsString := pHist.vTipvVeiculo;
    buscas.ParamByName('STATUS_DEMONST').AsString := pHist.vStatusDemonst;
    buscas.ParamByName('STATUS_ESTOQUE').AsString := pHist.vStatusEstoque;
    buscas.ParamByName('STATUS_RES').AsString := pHist.vStatusRes;
    buscas.ParamByName('STATUS_TRANSDEP').AsString := pHist.vStatusTransD;
    buscas.ParamByName('STATUS_USO').AsString := pHist.vStatusUso;
    buscas.ParamByName('STATUS_V').AsString := pHist.vStatusV;
    buscas.ParamByName('STATUS_CANC').AsString := pHist.vStatusCanc;
    buscas.ParamByName('POSICAO').AsString := pHist.vPosicao;
    buscas.ParamByName('ALTERA_ESTOQUE_CFOP').AsString := pHist.vAlteraEstoqueCFOP;
    if trim(pHist.vTipo) = 'NF' then
     buscas.ParamByName('N_COMANDONF').AsInteger := pHist.vNComandoNF;
    if trim(pHist.vModelo) = 'CTRINTERM' then
     buscas.ParamByName('N_OS').AsInteger := pHist.vNumOS;
    buscas.ParamByName('COD_HIST').AsInteger := pHist.vCodHist;
    buscas.Prepare;
    buscas.ExecSQL;

    if trim(pHist.vTipo) = 'NF' then
    begin
      if UpperCase(trim(pHist.vStatusNF)) = 'CANCELADA'  then
        vTemp :=' , STATUS_V = :STATUS_V '
      else
        vTemp :='';

      buscas.Close;
      buscas.SQL.Text := ' UPDATE HIST_ESTMOTO SET NUM_NOTA = :NUM_NOTA, SERIE = :SERIE, ' +
       ' STATUS_NFE = :STATUS_NFE, SITUACAO_NFE = :SITUACAO_NFE, MODELO_NF = :MODELO_NF, ' +
       ' EMISSAO_PROPRIA = :EMISSAO_PROPRIA, ALTERA_ESTOQUE_CFOP = :ALTERA_ESTOQUE_CFOP, COD_NF_CFT = :COD_NF_CFT ' + vTemp +
       ' WHERE (COALESCE(TRIM(TIPO), '''') IN (''CTR'', ''CFT'')) AND CHASSI_C = :CHASSI_C AND CODIGO = :CODIGO ' +
       ' AND NUMDOC = :NUMDOC AND COD_EMPRESA = :COD_EMPRESA;';
      buscas.ParamByName('NUMDOC').AsInteger := pHist.vNComandoNF;
      buscas.ParamByName('CHASSI_C').AsString := pHist.vChassi;
      buscas.ParamByName('CODIGO').AsInteger := pHist.vCodigo;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas.ParamByName('NUM_NOTA').AsInteger := pHist.vNumNota;
      buscas.ParamByName('SERIE').Value := pHist.vSerieNF;
      buscas.ParamByName('STATUS_NFE').AsString := pHist.vStatusNF;
      buscas.ParamByName('SITUACAO_NFE').AsString := pHist.vSituacaoNF;
      buscas.ParamByName('MODELO_NF').AsString := pHist.vModeloNF;
      buscas.ParamByName('EMISSAO_PROPRIA').AsString := pHist.vEmissaoPropriaNF;
      buscas.ParamByName('ALTERA_ESTOQUE_CFOP').AsString := pHist.vAlteraEstoqueCFOP;
      buscas.ParamByName('COD_NF_CFT').AsInteger := pHist.vNumDoc;
      if UpperCase(trim(pHist.vStatusNF)) = 'CANCELADA'  then
        buscas.ParamByName('STATUS_V').AsString := 'CANCELADO';
      buscas.Prepare;
      buscas.ExecSQL;
    end
    else if (trim(pHist.vTipo) = 'CTR') or (trim(pHist.vTipo) = 'CFT') then
    begin
      buscas.Close;
      buscas.SQL.Text := ' UPDATE HIST_ESTMOTO SET N_COMANDONF = :N_COMANDONF, ' +
       ' STATUS_V = :STATUS_V, N_OS = :N_OS, MODELO = :MODELO ' +
       ' WHERE (COALESCE(TRIM(TIPO), '''') = ''NF'') AND CHASSI_C = :CHASSI_C AND CODIGO = :CODIGO ' +
       ' AND NUM_NOTA = :NUM_NOTA AND SERIE = :SERIE AND MODELO_NF = :MODELO_NF AND COD_EMPRESA = :COD_EMPRESA;';
      buscas.ParamByName('CHASSI_C').AsString := pHist.vChassi;
      buscas.ParamByName('CODIGO').AsInteger := pHist.vCodigo;
      buscas.ParamByName('STATUS_V').AsString := pHist.vStatusV;
      buscas.ParamByName('MODELO').AsString := pHist.vModelo;
      buscas.ParamByName('N_OS').AsInteger := pHist.vNumOS;
      buscas.ParamByName('N_COMANDONF').AsInteger := pHist.vNumDoc;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas.ParamByName('NUM_NOTA').AsInteger := pHist.vNumNota;
      buscas.ParamByName('SERIE').AsString := pHist.vSerieNF;
      buscas.ParamByName('MODELO_NF').AsString := pHist.vModeloNF;
      buscas.Prepare;
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ' select cod_nf from notafiscal ' +
       ' where num_nf = :num_nf and serie = :serie and modelo_nf = :modelo_nf ' +
       ' and cod_empresa = :cod_empresa';
      buscas.ParamByName('num_nf').AsInteger := pHist.vNumNota;
      buscas.ParamByName('serie').AsString := pHist.vSerieNF;
      buscas.ParamByName('modelo_nf').AsString := pHist.vModeloNF;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(CodEmpresa);
      buscas.Open;

      vCodNf := buscas.FieldByName('COD_NF').AsInteger;
      if not buscas.IsEmpty then
      begin
        buscas.Close;
        buscas.SQL.Text := ' update hist_estmoto set cod_nf_cft = :cod_nf_cft ' +
          ' where (coalesce(trim(tipo), '''') in (''CTR'', ''CFT'')) and chassi_c = :chassi_c and codigo = :codigo ' +
          ' and numdoc = :numdoc and cod_empresa = :cod_empresa ;';
        buscas.ParamByName('NUMDOC').AsInteger := pHist.vNumDoc;
        buscas.ParamByName('CHASSI_C').AsString := pHist.vChassi;
        buscas.ParamByName('CODIGO').AsInteger := pHist.vCodigo;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        buscas.ParamByName('COD_NF_CFT').AsInteger := vCodNf;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
    end;

  finally
     pHist.vChassi := '';
     pHist.vNatureza := '';
     pHist.vTipo := '';
     pHist.vPlaca := '';
     pHist.vModelo := '';
     pHist.vSerieNF := '';
     pHist.vModeloNF := '';
     pHist.vEmissaoPropriaNF:= '';
     pHist.vData := '';
     pHist.vDataVenc := '';
     pHist.vTipoVenda := '';
     pHist.vRedLucro := '';
     pHist.vStatusNF := '';
     pHist.vSituacaoNF := '';
     pHist.vTipvVeiculo := '';
     pHist.vStatusEstoque := '';
     pHist.vStatusDemonst := '';
     pHist.vStatusRes := '';
     pHist.vStatusTransD := '';
     pHist.vStatusUso := '';
     pHist.vStatusCanc := '';
     pHist.vStatusV := '';
     pHist.vAlteraEstoqueCFOP := '';
     pHist.vPosicao := '';

     pHist.vCodHist := 0;
     pHist.vCodigo := 0;
     pHist.vNumOS := 0;
     pHist.vNComandoNF := 0;
     pHist.vNumDoc := 0;
     pHist.vNumNota := 0;
     pHist.vCodVendedor := 0;
     pHist.vCodCliente := 0;
     pHist.vCodCliVend := 0;
     pHist.vCodGerente := 0;
     pHist.vCodConcess := 0;
     pHist.vCodIntermed := 0;
     pHist.vCodCondPag := 0;

     pHist.vNatOP := 0;
     pHist.vPrecCusto := 0;
     pHist.vPrecTabEst := 0;
     pHist.vValorOP := 0;
  end;
end;

function TSingleton.gravaTransacaoPosVirtual(pSEQID: Integer; pTipVND, pTermAdm: string; pNVnd,
  pSecao, pCtrl: Integer; pQuery: TIBQuery; pCancelamento: Boolean;
  pOperacao: string; pDiasCred: Smallint): Integer;
var
  vSeqIDTransacao, vCtrl, vSecao: Integer;
  vAUT, vNSU, vTipVnd, vNumREQ: string;
begin
  pTermAdm := StrUtils.IfThen(Trim(pTermAdm) <> '', pTermAdm, vPOSV.terminalAdm);
  if (pSEQID = 0) and (not pCancelamento) then
  begin
    vSeqIDTransacao := 0;
    while true do
    begin
      pQuery.Close;
      pQuery.SQL.Text := 'select cod from incrementa_codigo( ' + codEmpresa + ',''TRANSACAO_CARTAO'')';
      try
      pQuery.Open;
      if pQuery.FieldByName('cod').AsInteger > 0 then
      begin
        vSeqIDTransacao := pQuery.FieldByName('cod').AsInteger;
        Break;
      end;
      except
        on E: Exception do
        begin
          Application.MessageBox('Erro ao obter seqid para transação com o POS Virtual. Se o processo ficar repetitivo contacte o suporte', 'Atenção', 0 + 64);
        end;
      end;
    end;

    pQuery.Close;
    pQuery.SQL.Text := 'insert into TRANSACAO_CARTAO' +
      ' (SEQID, COD_EMPRESA, TPDOCS, NREQUISICAO, SECAO, COD_CONTROLE, VALOR_OPERACAO, VALOR_TRANSACAO, N_AUT_CART, N_DOCNSU_ADM, COD_TERMINAL_ADM, STATUS,' +
      ' COD_USUARIO, LOGIN_USUARIO, PARCELAS, IMPRESSAO, DATA_TRANSACAO, OPERACAO, DIAS_PARA_CRED, REDE, ID_CARTDIG, ID_PSP)' +
      ' values ( ' + IntToStr(vSeqIDTransacao) + ',' +
      codEmpresa + ', ' +
      QuotedStr(Copy(Trim(pTipVND), 1, 6)) + ', ' +
      IntToStr(pNVnd) + ', ' +
      IntToStr(pSecao) + ', ' +
      IntToStr(pCtrl) + ', :VALOR_OPERACAO, :VALOR_TRANSACAO, ' +
      QuotedStr(Copy(Trim(vPOSV.retornoAUT), 1, 20)) + ', ' +
      QuotedStr(Copy(Trim(vPOSV.retornoNSU), 1, 10)) + ', ' +
      QuotedStr(Copy(Trim(pTermAdm), 1, 10)) + ', ''A'', ' +
      IntToStr(vCodUsuario) + ', ' +
      QuotedStr(Copy( Trim(vNomeUsuario), 1, 10)) + ', ' +
      IntToStr(vPOSV.parcelas) + ', ' + ':IMPRESSAO, :DATA_TRANSACAO, ' +
      QuotedStr(Copy(Trim(vPOSV.debitoCreditoOutros),1)) + ', ' +
      IntToStr(vPOSV.diasParaCredito) + ',' +
      QuotedStr(Copy(vPOSV.retornoREDE, 1, 32)) + ',' +
      IfThen(vPOSV.idCarteiraDigital = '', 'null', QuotedStr(Copy(vPOSV.idCarteiraDigital, 1, 8))) + ',' +
      IfThen(vPOSV.IdPSP = '', 'null', QuotedStr(Copy(vPOSV.IdPSP, 1, 8))) +
      ')';
    pQuery.ParamByName('VALOR_OPERACAO').AsFloat := vPOSV.valorOperacao;
    pQuery.ParamByName('VALOR_TRANSACAO').AsFloat := vPOSV.valorTransacaoTEF;
    pQuery.ParamByName('IMPRESSAO').AsString := vPOSV.vLinhasImpressao.Text;
    if Pos('/', vPOSV.retornoDataTransacao) = 0 then
      vPOSV.retornoDataTransacao := Copy(vPOSV.retornoDataTransacao, 1, 2) + '/' +
        Copy(vPOSV.retornoDataTransacao, 3, 2) + '/' +
        Copy(vPOSV.retornoDataTransacao, 5, 4);
    if Pos(':', vPOSV.retornoHoraTransacao) = 0 then
      vPOSV.retornoHoraTransacao := Copy(vPOSV.retornoHoraTransacao, 1, 2) + ':' +
        Copy(vPOSV.retornoHoraTransacao, 3, 2) + ':' +
        Copy(vPOSV.retornoHoraTransacao, 5, 2);
    pQuery.ParamByName('DATA_TRANSACAO').AsDateTime := StrToDateDef(vPOSV.retornoDataTransacao, Date) + StrToTimeDef(vPOSV.retornoHoraTransacao, Time);
    pQuery.ExecSQL;

    Result := vSeqIDTransacao;

    vPOSV.guidTrCartao := SqlOpen('select GUIDT from TRANSACAO_CARTAO where SEQID = %d and cod_empresa = %d', [vSeqIDTransacao, cod_empresa], pQuery).FieldByName('GUIDT').AsString;

    if vPOSV.idCarteiraDigital = '' then
    if SqlOpen('select rede from adm_cartao_redes where rede = %s and cod_empresa = %d',
               [QuotedStr(Copy(vPOSV.retornoREDE, 1, 32)), cod_empresa], pQuery).IsEmpty then
      SqlExec('update or insert into adm_cartao_redes (rede, cod_empresa)' +
              ' values (%s, %d) matching (rede, cod_empresa)',
              [QuotedStr(Copy(vPOSV.retornoREDE, 1, 32)), cod_empresa], pQuery);

    if vNFConsumidor.NFCeOffline = noClient then
    begin
      try
        CreateProcessSimple(
          Format('%s%s LESS cnpj=%s empresaId=%d caixaId=%d urgency=true',
                [ExtractFilePath(Application.ExeName), 'HWNFCServiceLess.exe',
                 vEmp.vCNPJ, cod_empresa, vNFConsumidor.CodEmissor]));

      except on E: Exception do
      end;
    end;


  end
  else if (not pCancelamento) then
  begin
    pQuery.Close;
    pQuery.SQL.Text := 'update transacao_cartao set COD_TERMINAL_ADM = ' + QuotedStr(Copy(pTermAdm,1,10));
    if pNVnd > 0 then
      pQuery.SQL.Text := pQuery.SQL.Text + ', NREQUISICAO = ' + IntToStr(pNVnd);
    if Trim(pTipVND) <> '' then
      pQuery.SQL.Text := pQuery.SQL.Text + ', TPDOCS = ' + QuotedStr(Trim(pTipVND));
    if pSecao > 0 then
      pQuery.SQL.Text := pQuery.SQL.Text + ', SECAO = ' + IntToStr(pSecao);

    if (pCtrl > 0) or (Trim(pTipVND) = 'AVL') then
      pQuery.SQL.Text := pQuery.SQL.Text + ', COD_CONTROLE = ' + IntToStr(pCtrl);

    if Trim(pOperacao) <> '' then
      pQuery.SQL.Text := pQuery.SQL.Text + ', OPERACAO = ' + QuotedStr(Copy(Trim(pOperacao),1,1));
    if pDiasCred > 0 then
      pQuery.SQL.Text := pQuery.SQL.Text + ', DIAS_PARA_CRED = ' + IntToStr(pDiasCred);
    pQuery.SQL.Text := pQuery.SQL.Text +
      ' where seqid = ' + IntToStr(pSEQID) +
      ' and cod_empresa = ' + codEmpresa;
    pQuery.ExecSQL;
    Result := pSEQID;
  end
  else
  begin
    pQuery.Close;
    pQuery.SQL.Text := 'select cod_controle, secao, n_aut_cart, n_docnsu_adm, TPDOCS, nrequisicao from TRANSACAO_CARTAO' +
      ' where seqid = ' + IntToStr(pSEQID) +
      ' and cod_empresa = ' + codEmpresa;
    pQuery.Open;

    vCtrl := pQuery.FieldByName('cod_controle').AsInteger;
    vSecao := pQuery.FieldByName('secao').AsInteger;
    vAUT := pQuery.FieldByName('N_AUT_CART').AsString;
    vNSU := pQuery.FieldByName('N_DOCNSU_ADM').AsString;
    vTipVnd := pQuery.FieldByName('TPDOCS').AsString;
    vNumREQ := IntToStr(pQuery.FieldByName('nrequisicao').AsInteger);

    pQuery.Close;
    pQuery.SQL.Text := 'update formpagamento' +
      ' set cod_terminal_adm = ''''' +
      ', n_aut_cart = ''''' +
      ', n_docnsu_adm = ''''' +
      ', tef = ''N''' +
      ' where coalesce(tpdocs, '''') = ' + QuotedStr(Trim(vTipVnd)) +
      ' and nrequisicao = ' + vNumREQ +
//      ' and coalesce(secao,0) = ' + IntToStr(vSecao) +
      ' and cod_empresa = ' + codEmpresa +
      ' and cod_controle = ' + IntToStr(vCtrl) +
      ' and tpdocs <> ''LCS'' and tipdoc = ''S2''' +
      ' and coalesce(n_aut_cart, '''') = ' + QuotedStr(Trim(vAUT)) +
      ' and coalesce(n_docnsu_adm, '''') = ' + QuotedStr(Trim(vNSU));
    pQuery.ExecSQL;

    pQuery.Close;
    pQuery.SQL.Text := 'update transacao_cartao set status = ''C'',' +
      ' COD_USUARIO_CANC = ' + IntToStr(vCodUsuario) + ',' +
      ' LOGIN_USUARIO_CANC = ' +QuotedStr(Copy(Trim(vNomeUsuario), 1, 20)) + ', ' +
      ' DATA_HORA_CANC = ' + FusoSqlDateTime + 
      ' where seqid = ' + IntToStr(pSEQID) +
      ' and cod_empresa = ' + codEmpresa +
      ' and coalesce(status,'''') <> ''C''';
    pQuery.ExecSQL;
    Result := pSEQID;
  end;
end;

