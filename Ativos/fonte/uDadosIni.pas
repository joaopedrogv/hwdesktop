function TSingleton.retornaTextoTemplate(pTemplate: string): string;
var
	Con: TConexao;
  vStringListTexto: TStringList;
begin
	Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    Con.QrAux.Close;
    Con.QrAux.SQL.Text := ' select texto from msg_template ' +
      ' where template = ' + QuotedStr(pTemplate) +
      ' and cod_empresa = ' + codEmpresa +
      ' and status = ''APPROVED'' ' +
      ' order by 1 ';
    Con.QrAux.Open;

    try
      vStringListTexto := TStringList.Create;
      vStringListTexto.Text := Con.QrAux.FieldByName('texto').AsString;

      Result := vStringListTexto.Text;
    finally
      if Assigned(vStringListTexto) then
        FreeAndNil(vStringListTexto);
    end;
  except on E: Exception do
    begin
      Application.MessageBox(PChar('Erro ao retorna template: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao retorna template: ' + e.Message);
    end;
  end;
end;

