          ' VALUES (:COD_LANC, :CODIGO_CH, :CODIGO_EMP); ';
        buscas2.ParamByName('COD_LANC').AsInteger := cCodLanc;
        buscas2.ParamByName('CODIGO_CH').AsInteger := cQuery.FieldByName('CODIGO_CH').AsInteger;
        buscas2.ParamByName('CODIGO_EMP').AsInteger := StrToInt(codEmpresa);
        buscas2.ExecSQL;
