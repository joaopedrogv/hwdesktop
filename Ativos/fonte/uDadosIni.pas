function TSingleton.TZero(valor: currency; tam: integer): string;
var
  vl: string;
begin
  vl := format('%n', [valor]);
  while (pos('.', vl) > 0) do
  begin
    vl := copy(vl, 1, pos('.', vl) - 1) + copy(vl, pos('.', vl) + 1, (length(vl) - pos('.', vl) +
      1));
  end;
  while (pos(',', vl)) > 0 do
  begin
    vl := copy(vl, 1, pos(',', vl) - 1) + copy(vl, pos(',', vl) + 1, (length(vl) - pos(',', vl) +
      1));
  end;
  try
    result := strzero(strtoint64(vl), tam);
  except
    result := strzero(strtoint('0'), tam);
  end;
end;

