  function getItemClasseProduto(query: TIBQuery) : TClasseFaixaPontosProduto_Item;
  var
    vvalor: Double;
  begin
    Result := TClasseFaixaPontosProduto_Item.Create;
    Randomize;
    with Result do
    begin
      vvalor := IfThen((not vinclusaodevtotal) and (not vexclusaodevtotal),
        query.FieldByName('valor_total').AsFloat - query.FieldByName('valor_dev').AsFloat,
        query.FieldByName('valor_total').AsFloat);

      nome := query.FieldByName('descricao_config').AsString;
      grupo_prod := query.FieldByName('grupo_prod').AsInteger;
      cod_prod := query.FieldByName('cod_prod').AsString;
      descricao := query.FieldByName('descricao').AsString;
      valor_calculado := IfThen(query.FieldByName('valor_tot_vnd').AsFloat > 0,
         ((query.FieldByName('valor_tot_vnd').AsFloat - query.FieldByName('valor_vale_prg').AsFloat) /
            IfThen(query.FieldByName('valor_tot_vnd').AsFloat > 0, query.FieldByName('valor_tot_vnd').AsFloat, 1)) * (vvalor),
           vvalor);
      pontos := query.FieldByName('pontos').AsFloat;
      total_pontos := valor_calculado * pontos;
    end;
  end;

