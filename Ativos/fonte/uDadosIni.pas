function TSingleton.recalcularData(pBuscas: TIBQuery; pSpIncCodigo: TIBStoredProc; pTipo: string;
  pCodVendedor, pCodCliente, pCodEquip, pCodVeic: Integer; pChassi,
  pPlaca: string; pNPED, pKm: integer; pPrimeiraRev,
  pSegundaRev: boolean): boolean;
var
	vCodTipo: Integer;
  buscas: TIBQuery;
  buscas2: TIBQuery;
  vDataMax: TDateTime;
  vOK: boolean;
  vKmMax: Integer;
  vDataCad:TDateTime;
  vHoraCad: string;
  vDiasQtde: Double;
  vDiasInterM, vDiasInterKm, vDiasMP, vDiasKmP, vDiasMS, vDiasKmS: Integer;
  vKmDia: Double;
  vDataMedia: TDateTime;
  vKmMedia: Double;
  vDataBanco: TDateTime;
  vHoraBanco: string;
begin
	try
  	Result := false;
    vCodTipo := 0;

    buscas := TIBQuery.Create(Application);
    buscas.Database := pBuscas.Database;
    buscas.Transaction := pBuscas.Transaction;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := pBuscas.Database;
    buscas2.Transaction := pBuscas.Transaction;

    vDataBanco := getDataBanco(buscas);
    vHoraBanco := FormatDateTime('HH:MM', getDataHoraBanco(buscas));

    vDtSetTmp.EmptyDataSet;

    if vEmp.vUsarAparelho = 'S' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select equipamento.cod_equip, equipamento.dat_cad_equi from equipamento ' +
        ' where equipamento.cod_equip = :cod_equip and equipamento.cod_empresa = :cod_empresa ';
      buscas.ParamByName('COD_EQUIP').AsInteger := pCodEquip;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        vCodTipo := buscas.FieldByName('COD_EQUIP').AsInteger;
        vDataCad := buscas.FieldByName('DAT_CAD_EQUI').AsDateTime;
      end;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := ' select tipmodelo.codigo, veiculos.data_cad from veiculos ' +
        ' inner join tipmodelo on tipmodelo.codigo = veiculos.modelo and tipmodelo.cod_empresa = veiculos.cod_empresa ' +
        ' where ((veiculos.placa = :placa and veiculos.chassi = :chassi and veiculos.codigo = :codigo) ' +
        ' 	or (veiculos.placa = :placa) or (veiculos.chassi = :chassi)) ' +
        ' and veiculos.cod_empresa = :cod_empresa and veiculos.ativo = 1 ';
      buscas.ParamByName('CHASSI').AsString := pChassi;
      buscas.ParamByName('PLACA').AsString := pPlaca;
      buscas.ParamByName('CODIGO').AsInteger := pCodVeic;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        vCodTipo := buscas.FieldByName('CODIGO').AsInteger;
        vDataCad := buscas.FieldByName('DATA_CAD').AsDateTime;
      end;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select regras_sug.codigo, regras_sug.descricao, ' +
      ' regras_sug.interv_mes_serv, regras_sug.mes_ret_serv1, regras_sug.mes_ret_serv2, ' +
      ' regras_sug.interv_km_serv, regras_sug.km_ret_serv1, regras_sug.km_ret_serv2 from regras_sug ' +
      ' inner join regras_sug_itens on regras_sug_itens.codigo = regras_sug.codigo and regras_sug_itens.cod_empresa = regras_sug.cod_empresa ' +
      ' where regras_sug_itens.cod_tipo = :cod_tipo and regras_sug_itens.cod_empresa = :cod_empresa and regras_sug.ativo = 1 ';
    if vEmp.vUsarAparelho = 'S' then
      buscas.SQL.Text := buscas.SQL.Text + ' and regras_sug.tipo = ''E'' '
    else
      buscas.SQL.Text := buscas.SQL.Text + ' and regras_sug.tipo = ''V'' ';
    buscas.ParamByName('COD_TIPO').AsInteger := vCodTipo;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
    buscas.Open;
    buscas.FetchAll;

    buscas.First;
    while not buscas.Eof do
    begin
      buscas2.Close;
      buscas2.SQL.Text := ' select ' +
        IfThen(vSugServico.vMediaSug > 1, ' first ' + IntToStr(vSugServico.vMediaSug), '') +
        ' sug_os.data_cad, sug_os.km, sug_os.cod_serv_sug from sug_os ';
      if vEmp.vUsarAparelho = 'S' then
        buscas2.SQL.Text := buscas2.SQL.Text +
          ' where sug_os.cod_equip = :cod_equip '
      else
        buscas2.SQL.Text := buscas2.SQL.Text +
          ' where ((sug_os.placa = :placa and sug_os.chassi = :chassi and sug_os.cod_veic = :cod_veic) ' +
          ' 	or (sug_os.placa = :placa) or (sug_os.chassi = :chassi)) ';
      buscas2.SQL.Text := buscas2.SQL.Text + ' and sug_os.cod_empresa = :cod_empresa ' +
        ' and sug_os.cod_serv_sug = :cod_serv_sug and sug_os.ativo = 1 ' +
        ' order by 1 desc,  2 desc ';
      if vEmp.vUsarAparelho = 'S' then
        buscas2.ParamByName('COD_EQUIP').AsInteger := pCodEquip
      else
      begin
        buscas2.ParamByName('CHASSI').AsString := pChassi;
        buscas2.ParamByName('PLACA').AsString := pPlaca;
        buscas2.ParamByName('COD_VEIC').AsInteger := pCodVeic;
      end;
      buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas2.ParamByName('COD_SERV_SUG').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
      buscas2.Open;
      buscas2.FetchAll;

      buscas2.First;
      if not (buscas2.IsEmpty) then
      begin
        vDataMax := buscas2.FieldByName('DATA_CAD').AsDateTime;
        vKmMax := buscas2.FieldByName('KM').AsInteger;
      end
      else
      begin
        vDataMax := Date;
        vKmMax := 0;
      end;
      buscas2.Last;

      vTipoRev := '';  
      vDiasQtde := 9999999999999999;
      vDiasInterM := 0;
      vDiasInterKm := 0;
      vDiasMP := 0;
      vDiasKmP := 0;
      vDiasMS := 0;
      vDiasKmS := 0;

      vOK := false;
      //Quando marcado primeira ou segunda revisão não testar o intervalo entre os meses das revisoes
      if not ((pPrimeiraRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)	and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0))
        and not ((pSegundaRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)
          and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)) then
        //Testar o intervalo entre os meses das revisoes
        if (buscas.FieldByName('INTERV_MES_SERV').AsInteger > 0) then
        begin
          if ((not buscas2.IsEmpty) and (vDataBanco >= vDataMax + (buscas.FieldByName('INTERV_MES_SERV').AsInteger * 30))) or (buscas2.IsEmpty) then
          	vOK := true;

          vDiasInterM := Round(buscas.FieldByName('INTERV_MES_SERV').AsInteger * 30);
          if (vDiasInterM > 0) then
          begin
            vDiasQtde := vDiasInterM;
            vTipoRev := 'INTERVALO MESES ENTRE AS REVISOES';
          end;
        end;
        
      if vEmp.vUsarAparelho <> 'S' then
      begin
        //Quando marcado segunda revisão não testar km da primeira revisao
        if not ((pSegundaRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)) then
          //Testar a km da primeira revisao
          if ((pPrimeiraRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0))
            or ((buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)
            and (pKm <= buscas.FieldByName('KM_RET_SERV1').AsInteger)) then
          begin
            vOK := true;
            vDataMedia := (vDataBanco - IfThen(buscas2.IsEmpty, vDataCad, buscas2.FieldByName('DATA_CAD').AsDateTime));
            vKmMedia := (pKm - IfThen(buscas2.IsEmpty, 0, buscas2.FieldByName('KM').AsInteger));

            if vKmMedia <> 0 then
              vDiasKmP := Round((buscas.FieldByName('KM_RET_SERV2').AsInteger - pKm) * (vDataMedia / vKmMedia))
            else
            	vDiasKmP := Round((buscas.FieldByName('KM_RET_SERV2').AsInteger - pKm) * (vDataMedia));

            if (vDiasKmP > 0) and (vDiasQtde > vDiasKmP)  then
            begin
              vDiasQtde := vDiasKmP;
              vTipoRev := 'KM PRIMEIRA REVISAO';
            end;
          end;

        //Quando marcado segunda revisão não testar mês da primeira revisao
        if not ((pSegundaRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)) then
          //Testar o mês da primeira revisao
          if ((pPrimeiraRev) and (buscas.FieldByName('MES_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('MES_RET_SERV2').AsInteger > 0))
            or ((buscas.FieldByName('MES_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('MES_RET_SERV2').AsInteger > 0)
            and ((vDataBanco - vDataCad) / 30 <= buscas.FieldByName('MES_RET_SERV1').AsInteger)
            and (pKm <= buscas.FieldByName('KM_RET_SERV1').AsInteger)) then
          begin
            vOK := true;
            vDiasMP := Round((buscas.FieldByName('MES_RET_SERV2').AsInteger - buscas.FieldByName('MES_RET_SERV1').AsInteger) * 30);
            if (vDiasMP > 0) and (vDiasQtde > vDiasMP) then
            begin
              vDiasQtde := vDiasMP;
              vTipoRev := 'MES PRIMEIRA REVISAO';
            end;
          end;

          //Quando marcado primeira revisão não testar  a km segunda revisao
          if not ((pPrimeiraRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)	and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)) then
            //Testar a km da segunda revisao
            if ((pSegundaRev) and (buscas.FieldByName('INTERV_KM_SERV').AsInteger > 0)
              and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0))
              or ((buscas.FieldByName('INTERV_KM_SERV').AsInteger > 0)
              and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)
              and (pKm > buscas.FieldByName('KM_RET_SERV1').AsInteger)
              and (pKm <= buscas.FieldByName('KM_RET_SERV2').AsInteger)) then
            begin
              vOK := true;
              vDataMedia := (vDataBanco - IfThen(buscas2.IsEmpty, vDataCad, buscas2.FieldByName('DATA_CAD').AsDateTime));
              vKmMedia := (pKm - IfThen(buscas2.IsEmpty, 0, pKm));

              if vKmMedia <> 0 then
  	            vDiasKmS := Round((buscas.FieldByName('INTERV_KM_SERV').AsInteger) * (vDataMedia / vKmMedia))
              else
              	vDiasKmS := Round((buscas.FieldByName('INTERV_KM_SERV').AsInteger) * (vDataMedia));

              if (vDiasKmS > 0) and (vDiasQtde > vDiasKmS) then
              begin
                vDiasQtde := vDiasKmS;
                vTipoRev :='KM SEGUNDA REVISAO';
              end;
            end;

        //Quando marcado primeira revisão não testar  a km segunda revisao
        if not ((pPrimeiraRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)	and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)) then
          //Testar o mês da segunda revisao
          if ((pSegundaRev) and (buscas.FieldByName('INTERV_MES_SERV').AsInteger > 0)
            and	(buscas.FieldByName('MES_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('MES_RET_SERV2').AsInteger > 0))
            or ((buscas.FieldByName('INTERV_MES_SERV').AsInteger > 0)
            and	(buscas.FieldByName('MES_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('MES_RET_SERV2').AsInteger > 0)
            and ((vDataBanco - IfThen(buscas2.IsEmpty, vDataCad, vDataMax)) / 30 > buscas.FieldByName('MES_RET_SERV1').AsInteger)
            and ((vDataBanco - IfThen(buscas2.IsEmpty, vDataCad, vDataMax)) / 30 <= buscas.FieldByName('MES_RET_SERV2').AsInteger)
            and (pKm > buscas.FieldByName('KM_RET_SERV1').AsInteger)
            and (pKm <= buscas.FieldByName('KM_RET_SERV2').AsInteger)) then
          begin
            vOK := true;
            vDiasMS := Round(buscas.FieldByName('INTERV_MES_SERV').AsInteger * 30);
            if (vDiasMS > 0) and (vDiasQtde > vDiasMS) then
            begin
              vDiasQtde := vDiasMS;
              vTipoRev := 'MES SEGUNDA REVISAO';
            end;
          end;

        //Quando marcado primeira ou segunda revisão não testar o intervalo entre a km das revisoes
        if not ((pPrimeiraRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0)
          and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0))
        and not ((pSegundaRev) and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)
          and (buscas.FieldByName('KM_RET_SERV1').AsInteger > 0) and (buscas.FieldByName('KM_RET_SERV2').AsInteger > 0)) then
          //Testar o intervalo entre a km das revisoes
          if (buscas.FieldByName('INTERV_KM_SERV').AsInteger > 0) and (not buscas2.IsEmpty) then
          begin
            if (pKm >= (vKmMax +  buscas.FieldByName('INTERV_KM_SERV').AsInteger)) then
              vOK := true;
            vDataMedia := (vDataBanco - IfThen(buscas2.IsEmpty, vDataCad, buscas2.FieldByName('DATA_CAD').AsDateTime));
            vKmMedia := (pKm - IfThen(buscas2.IsEmpty, 0, buscas2.FieldByName('KM').AsInteger));

            if vKmMedia <> 0 then
            	vDiasInterKm := Round((buscas.FieldByName('INTERV_KM_SERV').AsInteger) * (vDataMedia / vKmMedia))
            else
            	vDiasInterKm := Round((buscas.FieldByName('INTERV_KM_SERV').AsInteger) * (vDataMedia));

            if (vDiasInterKm > 0) and (vDiasQtde > vDiasInterKm) then
            begin
              vDiasQtde := vDiasInterKm;
              vTipoRev := 'INTERVALO KM ENTRE AS REVISOES';
            end;
          end;
      end;
    
      vDtSetTmp.Insert;
      if (vOK) then
        vDtSetTmp.FieldByName('SEL').AsString := 'S'
      else
        vDtSetTmp.FieldByName('SEL').AsString := '';
      vDtSetTmp.FieldByName('COD_SUG_OS').AsInteger := Gencodigo('SUG_OS', pSpIncCodigo, codEmpresa);
      vDtSetTmp.FieldByName('COD_SERV_SUG').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
      vDtSetTmp.FieldByName('DESCR_SERV_SUG').AsString := buscas.FieldByName('DESCRICAO').AsString;
      vDtSetTmp.FieldByName('KM').AsInteger := pKm;
      vDtSetTmp.FieldByName('COD_CLIENTE').AsInteger := pCodCliente;
      vDtSetTmp.FieldByName('COD_VENDEDOR').AsInteger := pCodVendedor;
      if vEmp.vUsarAparelho = 'S' then
        vDtSetTmp.FieldByName('COD_EQUIP').AsInteger := pCodEquip
      else
      begin
        vDtSetTmp.FieldByName('COD_VEIC').AsInteger := pCodVeic;
        vDtSetTmp.FieldByName('CHASSI').AsString := pChassi;
        vDtSetTmp.FieldByName('PLACA').AsString := pPlaca;
      end;
      vDtSetTmp.FieldByName('DIAS').AsInteger := Round(vDiasQtde);
      vDtSetTmp.FieldByName('TIPO').AsString := vTipoRev;
      vDtSetTmp.FieldByName('DATA').AsDateTime := vDataBanco + Round(vDiasQtde);
      vDtSetTmp.Post;

      buscas.Next;
    end;

    if vDtSetTmp.IsEmpty then
    begin
      Result := true;
      exit;
    end;
  except
  	on e: exception do
    begin
    	Result := false;
      Application.MessageBox(pchar('Erro ao recalcularData. Erro: ' + e.Message),
        'Atenção', 0 + 64);
      registraErro('TSingleton.recalcularData. Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton.ReceberPeloFinanceiro(pNdoc: Integer;
  pTipoDoc: string; pBusca: TIBQuery): string;
var
	vtipV: string;
  vtipoOs: string;
begin
	Result := 'N';

  if (trim(pTipoDoc) = 'MOT') then
  	pTipoDoc := 'VEI';

  if (trim(pTipoDoc) <> 'REQ') and (trim(pTipoDoc) <> 'OS') and (trim(pTipoDoc) <> 'VEI') then
  	exit;

  pBusca.Close;
  if (trim(pTipoDoc) = 'REQ') or (trim(pTipoDoc) = 'OS') then
    pBusca.SQL.Text := ' select nped, tipo, tipv, tipo_os from pedvenda ' +
      ' where nped = ' + IntToStr(pNdoc) +
      ' and tipo = ' + QuotedStr(trim(pTipoDoc)) +
      ' and cod_empresa = ' + codEmpresa +
      ' and status_ped = ''FECHADA'' ' +
      ' and ativo = 1 '
  else if (trim(pTipoDoc) = 'VEI') then
  	pBusca.SQL.Text := ' select n_comando, ''VEI'' tipo, '''' tipv, tipo_v as tipo_os from com_fat ' +
    	' where n_comando = ' + IntToStr(pNdoc) +
      ' and cod_empresa = ' + codEmpresa +
      ' and natureza = ''S'' ' +
      ' and status_v = ''FECHADO'' ' +
      ' and ativo = 1 ';
  pBusca.Open;

  if pBusca.IsEmpty then
  	exit;

  vtipV := trim(pBusca.FieldByName('tipv').AsString);
  vtipoOs := trim(pBusca.FieldByName('tipo_os').AsString);

  pBusca.Close;
  pBusca.SQL.Text := ' select first 1 coalesce(receber_financeiro, ''N'') receber_financeiro from tipo_vendas ' +
  	'	where tipo = ' + QuotedStr(trim(pTipoDoc));
  if (trim(pTipoDoc) = 'REQ') then
	  pBusca.SQL.Text := pBusca.SQL.Text +  '	and sigla = ' + QuotedStr(trim(vtipV))
  else if (trim(pTipoDoc) = 'OS') then
	  pBusca.SQL.Text := pBusca.SQL.Text +  '	and tipo_os = ' + QuotedStr(trim(vtipoOs))
  else if (trim(pTipoDoc) = 'VEI') then
	  pBusca.SQL.Text := pBusca.SQL.Text +  '	and tipo_os = ' + QuotedStr(trim(vtipoOs));
  pBusca.Open;

  if pBusca.IsEmpty then
  	exit;

  Result := trim(pBusca.FieldByName('receber_financeiro').AsString);
end;

function TSingleton.reestruturarBancoDeDados(vBanco: string;
  autoExecutar: Boolean): boolean;
var
  reestrutura_verificar_fiscal_pelo_endereco : Treestrutura_verificar_fiscal_pelo_endereco;
  reestrutura_verificar_hwf_pelo_endereco    : Treestrutura_verificar_hwf_pelo_endereco;
begin
  result := False;
  Application.CreateForm(TfrmReestruturacao, frmReestruturacao);
  frmReestruturacao.vBanco := LowerCase(vBanco);
  if autoExecutar then
  begin
    frmReestruturacao.Show;
    frmReestruturacao.Refresh;
    Application.ProcessMessages;
    frmReestruturacao.BitBtn1.Click;
    result := True;
  end
  else
    result := frmReestruturacao.ShowModal = IDOK;
  frmReestruturacao.Free;
  frmReestruturacao := nil;

  if hdReestrutura = 0 then
    CarregaPacote('pkReestrutura', hdReestrutura);
  if hdReestrutura = 0 then
    Application.MessageBox('Pacote de reestruturação não carregado', 'Atenção', 0 + 64)
  else
  begin
    try
      if vBanco = 'fiscal' then
      begin
        @reestrutura_verificar_fiscal_pelo_endereco := GetProcAddress(hdReestrutura, 'reestrutura_verificar_fiscal_pelo_endereco');
        if Assigned(reestrutura_verificar_fiscal_pelo_endereco) then
          reestrutura_verificar_fiscal_pelo_endereco(PChar(vVersaoBpl), PChar(vBancoFiscal));
      end;

      if vBanco = 'hwf' then
      begin
        @reestrutura_verificar_hwf_pelo_endereco := GetProcAddress(hdReestrutura, 'reestrutura_verificar_hwf_pelo_endereco');
        if Assigned(reestrutura_verificar_hwf_pelo_endereco) then
          reestrutura_verificar_hwf_pelo_endereco(PChar(vVersaoBpl), PChar(vBancoHwF));
      end;
    except
      Application.MessageBox('Pacote de reestruturação não executado', 'Atenção', 0 + 64)
    end;
  end;
end;

procedure TSingleton.registraErro(vMenserro: string);
var
  Arq: TextFile;
  NomeArq: string;
  auxstr: string;
begin
  if vGravaErros = 'S' then
  begin
    Nomearq := ExtractFilePath(Application.Exename) + 'erros.log';
    AssignFile(Arq, NomeArq);
    if not FileExists(NomeArq) then
      Rewrite(arq)
    else
      append(arq);
    auxstr := 'ERRO: ' + vmenserro + ' Dia: ' + datetostr(date) +
      ' Hora: ' + timetostr(time) + ' ' + vSistema;
    WriteLn(arq, auxstr);
    closeFile(arq);
  end;
end;

function TSingleton.RemoveAcentos(Texto: string): string;
Const
  ComAcento = 'àâêôûãõáéíóúçüÀÂÊÔÛÃÕÁÉÍÓÚÇÜ';
  SemAcento = 'aaeouaoaeioucuAAEOUAOAEIOUCU';
var iFor : Integer;
begin
  for iFor := 1 to Length(Texto) do begin
    if Pos(Texto[iFor],ComAcento) <> 0 then begin
      Texto[iFor] := SemAcento[Pos(Texto[iFor],ComAcento)];
    end;
  end;
  Result := Texto;
end;

function TSingleton.removerContatoCliente(
  pCodCliente: Integer;
  pCheckListContato: TCheckListBox): boolean;
var
	Con: TConexao;
  buscas2: TIBQuery;
	vAplicativo: string;
  vContato: string;
  vIdentificacao: string;
  vIdentificacaoTmp: string;
  vEmail: string;
	vTemp: string;
  vStringListIdentificacao: TStringList;
  I: Integer;
begin
    Result := False;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := Con.QrAux.Database;
      buscas2.Transaction := Con.QrAux.Transaction;

      try
        if pCheckListContato.ItemIndex < 0 then
    begin
          Application.MessageBox(PChar('Clique em um contato antes de remover.'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          Exit;
        end;

        if Copy(pCheckListContato.Items[pCheckListContato.ItemIndex], Length(pCheckListContato.Items[pCheckListContato.ItemIndex]) - 1, 1) = '*' then
          //
        else if vHwCloudIA.vUsarServMensageria = 'S' then
        begin
          if not PesqPros('CLI296', 'REMOVER', 'CL: ' + IntToStr(pCodCliente), 'MSG_CONTATO', '', Con.QrAux, True) then
            Exit;
        end
        else
        begin
          if not PesqPros('CLI256', 'REMOVER', 'CL: ' + IntToStr(pCodCliente), 'CLIENTES_CONTATO', '', Con.QrAux, True) then
            Exit;
        end;

        if Application.MessageBox('Deseja remover contato do cliente?',
          'Apagar', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
            Exit;

        retornaDadosContato(pCheckListContato, vAplicativo, vContato, vIdentificacao);

        if Copy(pCheckListContato.Items[pCheckListContato.ItemIndex], Length(pCheckListContato.Items[pCheckListContato.ItemIndex]) - 1, 1) = '*' then
        begin
          for I := 0 to vDadosIni.vListaContatoTemp.Count - 1 do
            if (trim(vAplicativo) + ' - ' +
                trim(vContato) + ' - ' +
                trim(vIdentificacao) = trim(vDadosIni.vListaContatoTemp[I])) then
            begin
              vDadosIni.vListaContatoTemp.Delete(I);
              Break;
            end;
        end
        else if vHwCloudIA.vUsarServMensageria = 'S' then
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' delete from msg_contato ' +
            ' where cod_cliente = :cod_cliente ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and id_msg_aplicativo = :id_msg_aplicativo ' +
            ' and identificador = :identificador ' +
            ' and ativo = :ativo ';
          Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
          Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := retornaCodAplicativo(UpperCase(trim(vAplicativo)));
          Con.QrAux.ParamByName('identificador').AsString := trim(vIdentificacao);
          Con.QrAux.ParamByName('ativo').AsInteger := 99;
          Con.QrAux.ExecSQL;

          buscas2.Close;
          buscas2.SQL.Text := ' select msg_contato.id from msg_contato ' +
          	' where cod_cliente = :cod_cliente ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and id_msg_aplicativo = :id_msg_aplicativo ' +
            ' and identificador = :identificador ' +
            ' and ativo = :ativo ';
          buscas2.ParamByName('cod_cliente').AsInteger := pCodCliente;
          buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
          buscas2.ParamByName('id_msg_aplicativo').AsInteger := retornaCodAplicativo(UpperCase(trim(vAplicativo)));
          buscas2.ParamByName('identificador').AsString := trim(vIdentificacao);
          buscas2.ParamByName('ativo').AsInteger := 1;
          buscas2.Open;

          buscas2.First;
          while not buscas2.Eof do
          begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' update msg_contato set ativo = :ativo ' +
        ' where id = :id ' +
        ' and cod_empresa = :cod_empresa ';
            Con.QrAux.ParamByName('id').AsInteger := buscas2.FieldByName('id').AsInteger;
            Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
            Con.QrAux.ParamByName('ativo').AsInteger := 99;
            Con.QrAux.ExecSQL;

            GravaAuditoria('CLI296', 'REMOVER',
              'CL: ' + IntToStr(pCodCliente) + ' ' +
              vAplicativo + ' ' +
              vContato + ' ' +
              vIdentificacao, 'MSG_CONTATO', IntToStr(buscas2.FieldByName('id').AsInteger), Con.QrAux);

            buscas2.Next;
          end;
        end
        else
        begin
          buscas2.Close;
          buscas2.SQL.Text := ' select clientes_contato.id, ' +
            ' clientes_contato.cod_empresa, ' +
            ' clientes_contato.contato, ' +
            ' clientes_contato.telefone, ' +
            ' clientes_contato.email from clientes_contato ' +
            ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
            ' and clientes_contato.cod_empresa = ' + codEmpresa +
            ' and clientes_contato.contato = ' + QuotedStr(trim(vContato)) +
            ' and clientes_contato.' +
              IfThen(trim(vAplicativo) = 'WHATSAPP', 'telefone = ', 'email like ') +
              IfThen(trim(vAplicativo) = 'WHATSAPP', QuotedStr(trim(vIdentificacao)), QuotedStr('%' + trim(vIdentificacao) + '%'));
          buscas2.Open;

          if (trim(vAplicativo) = 'E-MAIL') and (buscas2.IsEmpty) then
          begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' select clientes.email from clientes ' +
              ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
              ' and clientes.cod_empresa = ' + codEmpresa;
            Con.QrAux.Open;

            vIdentificacaoTmp := trim(Con.QrAux.FieldByName('email').AsString);

            try
              vStringListIdentificacao := TStringList.Create;
              vStringListIdentificacao.Sorted := True;
              vStringListIdentificacao.Duplicates := dupIgnore;
              vStringListIdentificacao.Clear;
              vStringListIdentificacao.Text :=  trim(vEmail);

              vEmail := '';
              for I := 1 to Length(vIdentificacaoTmp) do
              begin
                if (vIdentificacaoTmp[I] = ';') or (vIdentificacaoTmp[I] = ',') or (vIdentificacaoTmp[I] = '|') then
                begin
                  if _ValidarEMail(trim(vEmail)) then
                    vStringListIdentificacao.Add(trim(vEmail));
                  vemail := '';
                end
                else
                  vemail := vemail + vIdentificacaoTmp[I];
              end;
              if _ValidarEMail(trim(vEmail)) then
                vStringListIdentificacao.Add(trim(vEmail));

              for I := 0 to vStringListIdentificacao.Count - 1 do
                if trim(vStringListIdentificacao[I]) = trim(vIdentificacao) then
                begin
                  vStringListIdentificacao.Delete(I);
                  Break;
                end;

              vIdentificacao := trim(Join(vStringListIdentificacao, ';'));
              if Copy(vIdentificacao, 1, 1) = ';' then
                vIdentificacao := Copy(vIdentificacao, 2, Length(vIdentificacao) - 1);
              if Copy(vIdentificacao, Length(vIdentificacao), 1) = ';' then
                vIdentificacao := Copy(vIdentificacao, 1, Length(vIdentificacao) - 1);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' update clientes set ' +
                IfThen((trim(vContato) <> '') and (trim(vContato) <> 'SEM CONTATO'), ' contato = null, ', '') +
                IfThen(vStringListIdentificacao.Count <= 0, ' email = null ', ' email = :email ') +
                ' where cod_cliente = :cod_cliente ' +
                ' and cod_empresa = :cod_empresa ' +
                IfThen((trim(vContato) <> '') and (trim(vContato) <> 'SEM CONTATO'), ' and contato = :contato ', '');
              Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              if (trim(vContato) <> '') and (trim(vContato) <> 'SEM CONTATO') then
                Con.QrAux.ParamByName('contato').AsString := trim(vContato);
              if vStringListIdentificacao.Count > 0 then
                Con.QrAux.ParamByName('email').AsString := trim(vIdentificacao);
              Con.QrAux.ExecSQL;
            finally
              if Assigned(vStringListIdentificacao) then
                FreeAndNil(vStringListIdentificacao);
            end;
          end
          else
          begin
            buscas2.First;
            while not buscas2.Eof do
            begin
              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' delete from clientes_contato ' +
        ' where id = :id ' +
        ' and cod_empresa = :cod_empresa ';
              Con.QrAux.ParamByName('id').AsInteger := buscas2.FieldByName('id').AsInteger;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
              Con.QrAux.ExecSQL;

              GravaAuditoria('CLI256', 'REMOVER',
                'CL: ' + IntToStr(pCodCliente) + ' ' +
                vAplicativo + ' ' +
                vContato + ' ' +
                vIdentificacao, 'CLIENTES_CONTATO', IntToStr(buscas2.FieldByName('id').AsInteger), Con.QrAux);

              buscas2.Next;
    end;
          end;
        end;

        if Copy(pCheckListContato.Items[pCheckListContato.ItemIndex], Length(pCheckListContato.Items[pCheckListContato.ItemIndex]) - 1, 1) = '*' then
          //
        else if vHwCloudIA.vUsarServMensageria = 'S' then
          GravaAuditoria('CLI296', 'REMOVER', 'SUCESSO', 'MSG_CONTATO', '', Con.QrAux)
        else
          GravaAuditoria('CLI256', 'REMOVER', 'SUCESSO', 'CLIENTES_CONTATO', '', Con.QrAux);

        if Con.QrAux.Transaction.InTransaction then
          Con.QrAux.Transaction.Commit;

    Result := True;
      finally
        if Assigned(buscas2) then
          FreeAndNil(buscas2);
      end;

  except on E: Exception do
    begin
      Result := False;
        GravaAuditoria('CLI256', 'FALHA', 'SUCESSO', 'CLIENTES_CONTATO', '', Con.QrAux);
      Application.MessageBox(PChar('Erro ao remover contato cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao remover contato cliente: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
    end;
  end;
  finally
  	if Assigned(Con) then
    	FreeAndNil(Con);
end;
end;

procedure TSingleton.removerGradeNaoUtilizadosEcomerce(pGrupoProd: Integer; pCodProd: string);
var
  Con: TConexao;
  buscas2: TIBQuery;
begin
  try
    try
      Con := TConexao.Create(dtmAtivo.bancoHw);
      
      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := Con.QrAux.Database;
      buscas2.Transaction := Con.QrAux.Transaction;

      buscas2.Close;
      buscas2.SQL.Text :=
        ' select ' +
        ' produtos_ec_grade.grupo_prod, ' +
        ' produtos_ec_grade.cod_prod, ' +
        ' produtos_ec_grade.cod_grade, ' +
        ' produtos_ec_grade.cod_empresa from produtos_ec_grade ' +
        ' where produtos_ec_grade.grupo_prod = :grupo_prod ' +
        ' and produtos_ec_grade.cod_prod = :cod_prod ' +
        ' and produtos_ec_grade.cod_empresa = :cod_empresa ' +
        ' and produtos_ec_grade.cod_grade > 0 ' +
        ' and (select count(*) from cod_grade_prod ' +
        '      where cod_grade_prod.grupo_prod = produtos_ec_grade.grupo_prod ' +
        '      and cod_grade_prod.cod_prod = produtos_ec_grade.cod_prod ' +
        '      and cod_grade_prod.cod_grade = produtos_ec_grade.cod_grade ' +
        '      and cod_grade_prod.cod_empresa = produtos_ec_grade.cod_empresa) = 0 ';
      buscas2.ParamByName('grupo_prod').AsInteger := pGrupoProd;
      buscas2.ParamByName('cod_prod').AsString := pCodProd;
      buscas2.ParamByName('cod_empresa').AsInteger := cod_empresa;
      buscas2.Open;

      if buscas2.IsEmpty then
        Exit;

      buscas2.First;
      while not buscas2.Eof do
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' delete from produtos_ec_grade ' +
          ' where produtos_ec_grade.grupo_prod = :grupo_prod ' +
          ' and produtos_ec_grade.cod_prod = :cod_prod ' +
          ' and produtos_ec_grade.cod_grade = :cod_grade ' +
          ' and produtos_ec_grade.cod_empresa = :cod_empresa ';
        Con.QrAux.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
        Con.QrAux.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
        Con.QrAux.ParamByName('cod_grade').AsInteger := buscas2.FieldByName('cod_grade').AsInteger;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := buscas2.FieldByName('cod_empresa').AsInteger;
        Con.QrAux.ExecSQL;

        buscas2.Next;
      end;

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;

    finally
      if Assigned(buscas2) then
        FreeAndNil(buscas2);
      if Assigned(Con) then
        FreeAndNil(Con);
    end;
  except on E: Exception do
    begin
