    if vHwCloudIA.vUsarServMensageria <> 'S' then
      Exit;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        SqlOpen(' select ' +
          '	msg_aplicativo.aplicativo, ' +
          '	msg_contato.contato, ' +
          '	msg_contato.identificador, ' +
          IfThen(vHwCloudIA.vSomenteContatosAceitos = 'S',
            ' coalesce((select coalesce(msg_contato_tipo_notif.aceita, '''') from msg_contato_tipo_notif ' +
            '						inner join msg_tipo_notif on msg_tipo_notif.id = msg_contato_tipo_notif.id_msg_tipo_notif ' +
            '						inner join msg_tipo_notif_origem on msg_tipo_notif_origem.id_msg_tipo_not = msg_tipo_notif.id ' +
            '           inner join msg_origem on msg_origem.id = msg_tipo_notif_origem.id_msg_origem ' +
            '  					where msg_contato_tipo_notif.id_msg_contato = msg_contato.id ' +
            '  					and msg_contato_tipo_notif.cod_empresa = msg_contato.cod_empresa ' +
            ' 					and msg_origem.descricao = ' + QuotedStr(OrigemEnvStr[pOrigem]) + '), '''') ',
            QuotedStr('S')
          ) + ' aceita, ' +
          ' ''S'' sel from msg_contato ' +
          ' inner join msg_aplicativo on msg_aplicativo.id = msg_contato.id_msg_aplicativo ' +
          ' where msg_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and msg_contato.cod_empresa = ' + codEmpresa +
          ' and msg_aplicativo.aplicativo = ' + QuotedStr(AplicativoEnvStr[pAplicativo]) +
          ' and ativo = 1 ' +
          IfThen(vHwCloudIA.vSomenteContatosAceitos = 'S',
          	' and (select count(*) from msg_contato_tipo_notif ' +
            '			 inner join msg_tipo_notif on msg_tipo_notif.id = msg_contato_tipo_notif.id_msg_tipo_notif ' +
            '			 inner join msg_tipo_notif_origem on msg_tipo_notif_origem.id_msg_tipo_not = msg_tipo_notif.id ' +
            '      inner join msg_origem on msg_origem.id = msg_tipo_notif_origem.id_msg_origem ' +
            ' 		 where msg_contato_tipo_notif.id_msg_contato = msg_contato.id ' +
            ' 		 and msg_contato_tipo_notif.cod_empresa = msg_contato.cod_empresa ' +
            '			 and msg_origem.descricao = ' + QuotedStr(OrigemEnvStr[pOrigem]) +
            '      and msg_contato_tipo_notif.aceita = ''S'') <> 0 ',
            '') +
          ' order by 1, 3 ',
          Con.QrAux).FetchAll;

        SetLength(Result, Con.QrAux.RecordCount);
        I := 0;

        Con.QrAux.First;
        while not Con.QrAux.Eof do
        begin
          Result[I].Aplicativo := retornaAplicativoEnv(trim(Con.QrAux.FieldByName('aplicativo').AsString));
          Result[I].Contato := trim(Con.QrAux.FieldByName('contato').AsString);
          Result[I].Identificacao := trim(Con.QrAux.FieldByName('identificador').AsString);
          Result[I].Avulso := False;
          Result[I].Aceita := trim(Con.QrAux.FieldByName('aceita').AsString);
          Result[I].Sel := IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S', 'N', trim(Con.QrAux.FieldByName('sel').AsString));

          Inc(I);

          Con.QrAux.Next;
        end;
      end
      else
      begin
        try
          vHabKentro := trim(retornaDadosKentro(Con.QrAux, False)) <> '';

          vStringListContato := TStringList.Create;
          vStringListContato.Sorted := True;
          vStringListContato.Duplicates := dupIgnore;
          vStringListContato.Clear;

          vStringListIdentificacao := TStringList.Create;
          vStringListIdentificacao.Sorted := True;
          vStringListIdentificacao.Duplicates := dupIgnore;
          vStringListIdentificacao.Clear;

          vTemp := '';

          if pAplicativo = cEmail then
            vTemp := IfThen(trim(vTemp) <> '', trim(vTemp) + ' union ', '') +
              ' select ' +
              ' ''E-MAIL'' aplicativo, ' +
              '	coalesce(clientes.contato, ''SEM CONTATO'') as contato, ' +
              '	clientes.email as identificador, ' +
              ' ''S'' aceita, ' +
              ' ''S'' sel from clientes ' +
              ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
              ' and clientes.cod_empresa = ' + codEmpresa +
              ' and trim(coalesce(clientes.email, '''')) <> '''' ';

  //        if pAplicativo = cEmail then
  //          vTemp := IfThen(trim(vTemp) <> '', trim(vTemp) + ' union ', '') +
  //            ' select ' +
  //						' ''E-MAIL'' aplicativo, ' +
  //					  '	clientes_contato.contato, ' +
  //					  ' clientes_contato.email as identificador, ' +
  //						' ''S'' aceita, ' +
  //            ' case when ((select count(*) from clientes_contato_env ' +
  //            '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
  //            '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
  //            '             and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
  //            '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
  //            ' from clientes_contato ' +
  //            ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
  //            ' and clientes_contato.cod_empresa = ' + codEmpresa +
  //            ' and trim(coalesce(clientes_contato.email, '''')) <> '''' ' +
  //  				  ' and (select count(*) from clientes_contato_env ' +
  //            '      where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
  //            '      and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
  //            '      and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
  //            '      and clientes_contato_env.id_contato = clientes_contato.id) <> 0 ' +

          if (pAplicativo = cWhatsApp) and (vHabKentro) then
            vTemp := IfThen(trim(vTemp) <> '', trim(vTemp) + ' union ', '') +
              ' select ' +
              '	''WHATSAPP'' aplicativo, ' +
              ' clientes_contato.contato, ' +
              ' clientes_contato.telefone as identificador, ' +
              ' ''S'' aceita, ' +
              ' case when ((select count(*) from clientes_contato_env ' +
              '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
              '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
              '             and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
              '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
              ' from clientes_contato ' +
              ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
              ' and clientes_contato.cod_empresa = ' + codEmpresa +
              ' and trim(coalesce(clientes_contato.telefone, '''')) <> '''' ' +
              ' and (select count(*) from clientes_contato_env ' +
              '      where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
              '      and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
              '      and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
              '      and clientes_contato_env.id_contato = clientes_contato.id) <> 0 ';

          SqlOpen(
            vTemp +
            ' order by 1, 3 ', Con.QrAux);

          Con.QrAux.First;
          while not Con.QrAux.Eof do
          begin
            vIdentificacao := trim(Con.QrAux.FieldByName('identificador').AsString);
            vEmail := '';

            vStringListIdentificacao.Clear;
            if trim(Con.QrAux.FieldByName('aplicativo').AsString) = 'E-MAIL' then
            begin
              for I := 1 to Length(vIdentificacao) do
              begin
                if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
                begin
                  if _ValidarEMail(trim(vEmail)) then
                    vStringListIdentificacao.Add(trim(vEmail));
                  vemail := '';
                end
                else
                  vemail := vemail + vIdentificacao[I];
              end;
              if _ValidarEMail(trim(vEmail)) then
                vStringListIdentificacao.Add(trim(vEmail));
            end
            else if _ValidarCelular(trim(vIdentificacao)) then
              vStringListIdentificacao.Add(vIdentificacao);

            for I := 0 to vStringListIdentificacao.Count - 1 do
              vStringListContato.Add(trim(vStringListIdentificacao[I]));

            Con.QrAux.Next;
          end;

          SetLength(Result, vStringListContato.Count);
          J := 0;

          Con.QrAux.First;
          while not Con.QrAux.Eof do
          begin
            vIdentificacao := trim(Con.QrAux.FieldByName('identificador').AsString);
            vEmail := '';

            vStringListIdentificacao.Clear;
            if trim(Con.QrAux.FieldByName('aplicativo').AsString) = 'E-MAIL' then
            begin
              for I := 1 to Length(vIdentificacao) do
              begin
                if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
                begin
                  if _ValidarEMail(trim(vEmail)) then
                    vStringListIdentificacao.Add(trim(vEmail));
                  vemail := '';
                end
                else
                  vemail := vemail + vIdentificacao[I];
              end;
              if _ValidarEMail(trim(vEmail)) then
                vStringListIdentificacao.Add(trim(vEmail));
            end
            else if _ValidarCelular(trim(vIdentificacao)) then
              vStringListIdentificacao.Add(vIdentificacao);

            for I := 0 to vStringListIdentificacao.Count - 1 do
            begin
              Result[J].Aplicativo := retornaAplicativoEnv(trim(Con.QrAux.FieldByName('aplicativo').AsString));
              Result[J].Contato := trim(Con.QrAux.FieldByName('contato').AsString);
              Result[J].Identificacao := trim(vStringListIdentificacao[I]);
              Result[J].Avulso := False;
              Result[I].Aceita := trim(Con.QrAux.FieldByName('aceita').AsString);
              Result[I].Sel := IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S', 'N', trim(Con.QrAux.FieldByName('sel').AsString));

              Inc(J);
            end;

            Con.QrAux.Next;
          end;
        finally
          if Assigned(vStringListContato) then
            FreeAndNil(vStringListContato);
          if Assigned(vStringListIdentificacao) then
            FreeAndNil(vStringListIdentificacao);
        end;
      end;
   except on E: Exception do
      begin
        Application.MessageBox(pchar('Falha ao retorna array de contatos cliente.'), 'Erro', MB_ICONERROR + MB_OK);
        registraErro('Falha ao retorna array de contatos cliente:' + E.Message);
      end;
    end;
  finally
  	if Assigned(Con) then
      FreeAndNil(Con);
  end;
end;

function TSingleton.retornaArrayOrigem(pChecklistOrigem: TCheckListBox;
  pSomenteSel: Boolean): arrayorigem;
var
	I: Integer;
begin
	Result := [];
  for I := 0 to pChecklistOrigem.Items.Count - 1 do
    if (not pSomenteSel) or (pChecklistOrigem.Checked[I]) then
    begin
    	if trim(pChecklistOrigem.Items[I]) = 'NFSe' then
      	Result := Result +  [cNfse]
      else if trim(pChecklistOrigem.Items[I]) = 'NFe' then
      	Result := Result +  [cNfe]
      else if trim(pChecklistOrigem.Items[I]) = 'Recibo Locação' then
      	Result := Result +  [cReciboLoc]
      else if trim(pChecklistOrigem.Items[I]) = 'Boleto' then
      	Result := Result +  [cBoleto];
    end;
end;

function TSingleton.retornaArrayAplicativo(
	pChecklistBoxAplicativo: TCheckListBox;
  pSomenteSel: Boolean = False): arrayaplicativo;
var
	I: Integer;
begin
	Result := [];

  if not pChecklistBoxAplicativo.Enabled then
  	Exit;

  if not pChecklistBoxAplicativo.Visible then
  	Exit;

  for I := 0 to pChecklistBoxAplicativo.Items.Count - 1 do
    if (not pSomenteSel) or (pChecklistBoxAplicativo.Checked[I]) then
    begin
      if trim(pChecklistBoxAplicativo.Items[I]) = 'E-MAIL' then
        Result := Result + [cEmail]
      else if trim(pChecklistBoxAplicativo.Items[I]) = 'WHATSAPP' then
        Result := Result + [cWhatsApp]
      else if trim(pChecklistBoxAplicativo.Items[I]) = 'TELEGRAM' then
        Result := Result + [cTelegram];
    end;
end;

