      vEnvNotFinanc.vInterMensagemEnvNotFinanc						 := GetConf('env_not_financ_tempo_sinc_mensagens').AsInteger;

      vPagOnline.vReceberMensagemPagOnline                 := GetConf('pag_online_receber_notificacao').AsBoolean;
      vPagOnline.vInterMensagemPagOnline                   := GetConf('pag_online_tempo_sinc_mensagens').AsInteger;

      vRecibo.ReceberPeloFinanceiro					               := GetConf('rec_receber_financeiro').AsBoolean;

      vCliente.Barramento.Config(GetConf('cl_faturamento_conf'));

      vPedVnd.ExibirDesconto.Config(GetConf('ped_vnd_prod_exibir_desconto'));

      vRecibo.Baixar.Config(GetConf('rec_hab_vencimento'));

      vSuzuki.Config(GetConf('vei_codmarca'));

      vSubGrupoVinc                                        := IfThen(GetConf('prod_sub_grupo_vinculado').AsBoolean, 'S', 'N');
      conf_historicos                                      := GetConf('conf_historicos').AsStrings.Text;
    end;
    finally
      AconfList.Free();
    end;

    PosVirtualGetConfsPrintNaoFiscal(buscas);

    buscas.Close;

    if GetIni('Sistema', 'ClientePadrao', '@') <> vCliente.vCodClientePadrao then
      GravaIni('Sistema', 'ClientePadrao', vCliente.vCodClientePadrao);
  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao abrir configuracoes (config_sistema). Erro: ' + e.Message),
        'Atenção', 0 + 64);
      registraErro('TSingleton.atualizarConfiguracoesDoSistema. Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton.AtualizarControles(cQuery: TIBQuery; pTipo: tTipoOpControle; cCodControle: Integer): boolean;
var
  fInsertControles, fUpdateControles, vTemp: string;
  I, J, qtEmpresas: Integer;
  fUpdate: boolean;
  buscas, buscas2: TIBQuery;
  arrayEmpresas: array of Integer;
begin
 Result := True;

 buscas := TIBQuery.Create(Application);
 buscas.Database := cQuery.Database;
 buscas.Transaction := cQuery.Transaction;

 buscas2 := TIBQuery.Create(Application);
 buscas2.Database := cQuery.Database;
 buscas2.Transaction := cQuery.Transaction;

 fInsertControles := '';
 fUpdateControles := '';

 if not vEmp.vFinanceiroUnificado then
   exit;

 if vEmp.vCodigoUnificadora <> StrToInt(codEmpresa) then
   exit;

 buscas.Close;
 buscas.SQL.Text := ' SELECT COD_EMPRESA FROM EMPRESA ' +
  ' WHERE CODIGO_UNIFICADORA = ' + codEmpresa +
  ' AND FINANCEIRO_UNIFICADO = ''S'' AND COD_EMPRESA <> ' + codEmpresa;
 buscas.Open;
 buscas.FetchAll;

 if buscas.RecordCount <= 0 then
  exit;

 SetLength(arrayEmpresas, buscas.RecordCount);
 qtEmpresas := buscas.RecordCount;

 I := 0;
 buscas.First;
 while not buscas.Eof do
 begin
  arrayEmpresas[I] := buscas.FieldByName('COD_EMPRESA').AsInteger;
  inc(I);
  buscas.Next;
 end;

 buscas.Close;
 buscas.SQL.Text := ' SELECT * FROM CONTROLES ' +
   ' WHERE CODIGO_CTRL = ' + IntToStr(cCodControle) + ' AND CODIGO_EMP = ' + codEmpresa;
 buscas.Open;

 if buscas.IsEmpty then
   exit;

 if pTipo = tInserir then
 begin
   for I := 0 to buscas.FieldCount - 1 do
     if buscas.FindField(buscas.Fields[I].FieldName) <> nil then
     begin
       if (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CONTROLE_VISIVEL')
         and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'IND_TIT')
       	 and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CARTAO_SPED_PART')
       	 and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CARTAO_SPED_PART_IT') then
       begin
         if trim(fInsertControles) = '' then
           fInsertControles := trim(buscas.Fields[I].FieldName)
         else
           fInsertControles := fInsertControles + ', ' + trim(buscas.Fields[I].FieldName);

         if trim(fUpdateControles) = '' then
           fUpdateControles := trim(buscas.Fields[I].FieldName) + ' = :' + trim(buscas.Fields[I].FieldName)
         else
           fUpdateControles := fUpdateControles + ', ' + trim(buscas.Fields[I].FieldName) + ' = :' + trim(buscas.Fields[I].FieldName);
       end;
     end;

   vTemp := StringReplace(fInsertControles, ', ', ', :', [rfReplaceAll, rfIgnoreCase]);
   fInsertControles := 'INSERT INTO CONTROLES (' + fInsertControles + ') ' +
    ' VALUES (:' + vTemp + ')';

//   fUpdateControles := StringReplace(fUpdateControles, 'CODIGO_CTRL = :CODIGO_CTRL,', '', [rfReplaceAll, rfIgnoreCase]);
   fUpdateControles := StringReplace(fUpdateControles, ' CODIGO_EMP = :CODIGO_EMP,', '', [rfReplaceAll, rfIgnoreCase]);

   fUpdateControles := 'UPDATE CONTROLES SET ' + fUpdateControles +
     ' WHERE CODIGO_CTRL = :CODIGO_CTRL and CODIGO_EMP = :CODIGO_EMP';

   for J := 0 to qtEmpresas -1 do
   begin
     buscas2.Close;
     buscas2.SQL.Text := ' SELECT * FROM CONTROLES ' +
       ' WHERE CODIGO_CTRL = ' + IntToStr(cCodControle) +
       ' AND CODIGO_EMP = ' + IntToStr(arrayEmpresas[J]) +
       ' ORDER BY CODIGO_CTRL';
     buscas2.Open;

     fUpdate := False;
     if not buscas2.IsEmpty then
       fUpdate := True;

     buscas2.Close;
     if fUpdate then
       buscas2.SQL.Text := fUpdateControles
     else
       buscas2.SQL.Text := fInsertControles;

     for I := 0 to buscas.FieldCount - 1 do
     begin
     	 if (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CONTROLE_VISIVEL')
         and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'IND_TIT')
       	 and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CARTAO_SPED_PART')
       	 and (UpperCase(trim(buscas.Fields[I].FieldName)) <> 'CARTAO_SPED_PART_IT') then
       begin
	       buscas2.ParamByName(trim(buscas.Fields[I].FieldName)).Value := buscas.FieldByName(trim(buscas.Fields[I].FieldName)).Value;
       end;
     end;
     buscas2.ParamByName('CODIGO_EMP').AsInteger := arrayEmpresas[J];
     buscas2.Prepare;
     buscas2.ExecSQL;
   end;
 end
 else if pTipo = tMover then
 begin
   for J := 0 to qtEmpresas -1 do
   begin
     buscas2.Close;
     buscas2.SQL.Text := ' UPDATE CONTROLES SET ATIVO = 0 ' +
       ' WHERE CODIGO_CTRL = ' + IntToStr(cCodControle) +
       ' AND CODIGO_EMP = ' + IntToStr(arrayEmpresas[J]) ;
     buscas2.ExecSQL;
   end;
 end
 else if pTipo = tRecuperar then
 begin
   for J := 0 to qtEmpresas -1 do
   begin
     buscas2.Close;
     buscas2.SQL.Text := ' UPDATE CONTROLES SET ATIVO = 1 ' +
       ' WHERE CODIGO_CTRL = ' + IntToStr(cCodControle) +
       ' AND CODIGO_EMP = ' + IntToStr(arrayEmpresas[J]);
     buscas2.Prepare;
     buscas2.ExecSQL;
   end;
 end
 else if pTipo = tApagar then
 begin
   for J := 0 to qtEmpresas -1 do
   begin
     buscas2.Close;
     buscas2.SQL.Text := ' UPDATE CONTROLES SET ATIVO = 99 ' +
       ' WHERE CODIGO_CTRL = ' + IntToStr(cCodControle) +
       ' AND CODIGO_EMP = ' + IntToStr(arrayEmpresas[J]);
     buscas2.Prepare;
     buscas2.ExecSQL;
   end;
 end;
end;

function TSingleton.atualizarEndBancoHwService: boolean;
var
	ArqConfigTmp: TIniFile;
  vServer: string;
  vDatabase: string;
  AList: TStringList;
  I: Integer;
begin
	try
    if FileExists(ExtractFilePath(Application.Exename) + 'HwService.ini') then
    begin
      ArqConfigTmp := TIniFile.Create(ExtractFilePath(Application.Exename) + 'HwService.ini');

      try
        if (trim(ArqConfigTmp.ReadString('BancoBkp', 'Forma', 'C')) = 'C')
        	and (trim(ArqConfigTmp.ReadString('BancoBkp', 'Server', '')) + ':' + trim(ArqConfigTmp.ReadString('BancoBkp', 'Database', '')) <> trim(vDadosIni.vBancoHW)) then
        begin
          vServer   := '';
          vDatabase := '';

        	AList := TStringList.Create;
          try
            AList := vDadosIni.Split(vDadosIni.vBancoHW, ':');
            if AList.Count >= 2 then
            begin
              vServer   := AList[0];
              vDatabase := '';
              for I := 1 to AList.Count - 1 do
                vDatabase := vDatabase + vDadosIni.IfThen(trim(vDatabase) = '', '', ':') + AList[I];
            end;
          finally
            FreeAndNil(AList);
          end;

        	ArqConfigTmp.WriteString('BancoBkp', 'Server',   vServer);
          ArqConfigTmp.WriteString('BancoBkp', 'Database', vDatabase);
        end;

        if trim(ArqConfigTmp.ReadString('BancoHw', 'Endereco', '')) <> trim(vBancoHW) then
          ArqConfigTmp.WriteString('BancoHw', 'Endereco', trim(vBancoHW));

        if trim(ArqConfigTmp.ReadString('BancoHw', 'VerificarBackup', '')) <> trim(vVerificarBackup) then
        	ArqConfigTmp.WriteString('BancoHw', 'VerificarBackup', trim(vVerificarBackup));

      	if trim(ArqConfigTmp.ReadString('BancoHw', 'TsPlus', '')) <> trim(vDadosIni.vTsPlus) then
        	ArqConfigTmp.WriteString('BancoHw', 'TsPlus', trim(vDadosIni.vTsPlus));
      finally
        ArqConfigTmp.Free;
      end;
    end;

    if FileExists(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\HwService.ini') then
    begin
			ArqConfigTmp := TIniFile.Create(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\HwService.ini');

      try
      	if (trim(ArqConfigTmp.ReadString('BancoBkp', 'Forma', 'C')) = 'C')
        	and (trim(ArqConfigTmp.ReadString('BancoBkp', 'Server', '')) + ':' + trim(ArqConfigTmp.ReadString('BancoBkp', 'Database', '')) <> trim(vDadosIni.vBancoHW)) then
        begin
          vServer   := '';
          vDatabase := '';

        	AList := TStringList.Create;
          try
            AList := vDadosIni.Split(vDadosIni.vBancoHW, ':');
            if AList.Count >= 2 then
            begin
              vServer   := AList[0];
              vDatabase := '';
              for I := 1 to AList.Count - 1 do
                vDatabase := vDatabase + vDadosIni.IfThen(trim(vDatabase) = '', '', ':') + AList[I];
            end;
          finally
            FreeAndNil(AList);
          end;

        	ArqConfigTmp.WriteString('BancoBkp', 'Server',   vServer);
          ArqConfigTmp.WriteString('BancoBkp', 'Database', vDatabase);
        end;

        if trim(ArqConfigTmp.ReadString('BancoHw', 'Endereco', '')) <> trim(vBancoHW) then
          ArqConfigTmp.WriteString('BancoHw', 'Endereco', trim(vBancoHW));

        if trim(ArqConfigTmp.ReadString('BancoHw', 'VerificarBackup', '')) <> trim(vVerificarBackup) then
        	ArqConfigTmp.WriteString('BancoHw', 'VerificarBackup', trim(vVerificarBackup));

        if trim(ArqConfigTmp.ReadString('BancoHw', 'TsPlus', '')) <> trim(vDadosIni.vTsPlus) then
        	ArqConfigTmp.WriteString('BancoHw', 'TsPlus', trim(vDadosIni.vTsPlus));
      finally
        ArqConfigTmp.Free;
      end;
    end;
  except
  	on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao atualizar endereco banco hwservice. Erro: ' + e.Message),
        'Atenção', 0 + 64);
      registraErro('TSingleton.atualizarEndBancoHwService. Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton.AtualizarFilaReserva(buscas: TIBQuery; SpIncCodigo: TIBStoredProc; pCodEstMoto: Integer;
  pChassi: string; pReservar: boolean; pEnvEmail: boolean; pPrev: string): boolean;
var
  buscas2, buscas3: TIBQuery;
  vcod_modelo, vano_fab, vano_mod, vcod_cor, vcodfila, vcod_vendedor: Integer;
  vdesc_modelo, vdesc_cor, vnomeCliente, vfoneCliente, vcondres, vGrupoCtRD: string;
  vdataBanco, vassembleia: TDateTime;
  vPosicao, vhoraBanco, vmensTemp, vTemp, vPrevCheg, vreordenarFilaEmp: string;
  vTipoRes, vGrupoCotaRD, vDataVenc, vHoraVenc, vDataAssembleia, vDataRes, vHoraRes: Variant;

  procedure AtualizarReserva(pQuery: TIBQuery; pTipo: Integer = 0);
  var
   pQuery2: TIBQuery;
  begin
    pQuery2 := TIBQuery.Create(Application);
    pQuery2.Database := pQuery.Database;
    pQuery2.Transaction := pQuery.Transaction;

    buscas2.Close;
    buscas2.SQL.Text := ' update est_moto set ' +
      ' status_res = :status_res, ' +
      ' cod_cliente = :cod_cliente, ' +
      ' nome_res = :nome_res, ' +
      ' fone_res = :fone_res, ' +
      ' data_res = :data_res, ' +
      ' hora_res = :hora_res, ' +
      ' vendedor_res = :vendedor_res, ' +
      ' tipo_res = :tipo_res, ' +
      ' sit_res = :sit_res, ' +
      ' obs_res = :obs_res, ' +
      ' data_venc_res = :data_venc_res, ' +
      ' hora_venc_res = :hora_venc_res, ' +
      ' cod_fila_res = :cod_fila_res, ';
    if pTipo = 0 then
      buscas2.SQL.Text := buscas2.SQL.Text  +
        ' status_avarias = :status_avarias, obs_itemest = :obs_itemest ,';

    buscas2.SQL.Text := buscas2.SQL.Text  +
      ' grupo_cota_rd = :grupo_cota_rd, ' +
      ' data_assembleia = :data_assembleia ' +
      ' where codigo = :codigo and chassi_c = :chassi_c and cod_empresa = :cod_empresa';
    if pReservar then
    begin
      buscas2.ParamByName('COD_CLIENTE').AsInteger := pQuery.FieldByName('COD_CLIENTE').AsInteger;
      buscas2.ParamByName('NOME_RES').AsString := pQuery.FieldByName('NOME_RES').AsString;
      buscas2.ParamByName('FONE_RES').AsString := pQuery.FieldByName('FONE_RES').AsString;
      if pTipo <> 0 then
        buscas2.ParamByName('VENDEDOR_RES').AsInteger := pQuery.FieldByName('VENDEDOR_RES').AsInteger
      else
        buscas2.ParamByName('VENDEDOR_RES').AsInteger := pQuery.FieldByName('COD_VENDEDOR').AsInteger;
      if buscas2.ParamByName('VENDEDOR_RES').AsInteger > 0 then
        buscas2.ParamByName('STATUS_RES').AsString := 'S'
      else
        buscas2.ParamByName('STATUS_RES').AsString := 'N';
      buscas2.ParamByName('TIPO_RES').AsString := pQuery.FieldByName('TIPO_RES').AsString;
      buscas2.ParamByName('SIT_RES').AsString := pQuery.FieldByName('SIT_RES').AsString;
      buscas2.ParamByName('OBS_RES').AsString := pQuery.FieldByName('OBS_RES').AsString;
      if trim(vPosicao) = 'TRANSITO' then
      begin
        if pQuery.FieldByName('DATA_RES').AsDateTime > 0 then
          buscas2.ParamByName('DATA_RES').AsDateTime := pQuery.FieldByName('DATA_RES').AsDateTime
        else
          buscas2.ParamByName('DATA_RES').Value := Null;
        buscas2.ParamByName('HORA_RES').AsString := pQuery.FieldByName('HORA_RES').AsString;
        buscas2.ParamByName('DATA_VENC_RES').Value := Null;
        buscas2.ParamByName('HORA_VENC_RES').Value := Null;
      end
      else
      begin
        if (trim(vReordenarFila) = 'S') then
        begin
           if (trim(pQuery.FieldByName('POSICAO').AsString) = 'TRANSITO')
           or (trim(pQuery.FieldByName('POSICAO').AsString) = 'FILA') then
           begin
             RetornaDataHoraVenc(pQuery2,
               pQuery.FieldByName('POSICAO').AsString,
               pQuery.FieldByName('TIPO_RES').AsString,
               pQuery.FieldByName('GRUPO_COTA_RD').AsString,
               vDataBanco,//pQuery.FieldByName('DATA_RES').AsDateTime,
               vHoraBanco,//pQuery.FieldByName('HORA_RES').AsString,
               pQuery.FieldByName('DATA_ASSEMBLEIA').AsDateTime,
               vTipoRes, vGrupoCotaRD, vDataVenc, vHoraVenc, vDataAssembleia);
             buscas2.ParamByName('DATA_RES').AsDateTime := vDataBanco;
             buscas2.ParamByName('HORA_RES').AsString := vhoraBanco;
             buscas2.ParamByName('DATA_VENC_RES').Value := vDataVenc;
             buscas2.ParamByName('HORA_VENC_RES').Value := vHoraVenc;
           end
           else
           begin
             if pQuery.FieldByName('DATA_RES').AsDateTime > 0 then
               buscas2.ParamByName('DATA_RES').AsDateTime := pQuery.FieldByName('DATA_RES').AsDateTime
             else
               buscas2.ParamByName('DATA_RES').Value := Null;
             buscas2.ParamByName('HORA_RES').AsString := pQuery.FieldByName('HORA_RES').AsString;
             buscas2.ParamByName('DATA_VENC_RES').Value := pQuery.FieldByName('DATA_VENC_RES').Value;
             buscas2.ParamByName('HORA_VENC_RES').Value := pQuery.FieldByName('HORA_VENC_RES').Value;
           end;
        end
        else
        begin
          if buscas2.ParamByName('VENDEDOR_RES').AsInteger > 0 then
          begin
            buscas2.ParamByName('DATA_RES').AsDateTime := vDataBanco;
            buscas2.ParamByName('HORA_RES').AsString := vHoraBanco;
            buscas2.ParamByName('DATA_VENC_RES').Value := vDataVenc;
            if not buscas2.ParamByName('DATA_VENC_RES').IsNull then
             buscas2.ParamByName('HORA_VENC_RES').Value := vHoraBanco;
          end;
        end;
      end;
      buscas2.ParamByName('COD_FILA_RES').AsInteger := pQuery.FieldByName('CODIGO').AsInteger;
      if pTipo = 0 then
      begin
        buscas2.ParamByName('STATUS_AVARIAS').AsString := pQuery.FieldByName('STATUS_AVARIAS').AsString;
        buscas2.ParamByName('OBS_ITEMEST').AsString := pQuery.FieldByName('OBS_ITEMEST').AsString;
      end;
      buscas2.ParamByName('GRUPO_COTA_RD').AsString := pQuery.FieldByName('GRUPO_COTA_RD').AsString;
      buscas2.ParamByName('DATA_ASSEMBLEIA').Value := pQuery.FieldByName('DATA_ASSEMBLEIA').Value;
    end
    else
    begin
      buscas2.ParamByName('STATUS_RES').AsString := 'N';
      buscas2.ParamByName('COD_CLIENTE').Value := Null;
      buscas2.ParamByName('NOME_RES').Value := Null;
      buscas2.ParamByName('FONE_RES').Value := Null;
      buscas2.ParamByName('DATA_RES').Value := Null;
      buscas2.ParamByName('HORA_RES').Value := Null;
      buscas2.ParamByName('VENDEDOR_RES').Value := Null;
      buscas2.ParamByName('TIPO_RES').Value := Null;
      buscas2.ParamByName('SIT_RES').Value := Null;
      buscas2.ParamByName('OBS_RES').Value := Null;
      buscas2.ParamByName('DATA_VENC_RES').Value := Null;
      buscas2.ParamByName('HORA_VENC_RES').Value := Null;
      buscas2.ParamByName('COD_FILA_RES').Value := Null;
      if pTipo = 0 then
      begin
        buscas2.ParamByName('STATUS_AVARIAS').Value := Null;
        buscas2.ParamByName('OBS_ITEMEST').Value := Null;
      end;
      buscas2.ParamByName('GRUPO_COTA_RD').Value := Null;
      buscas2.ParamByName('DATA_ASSEMBLEIA').Value := Null;
    end;
    buscas2.ParamByName('CODIGO').AsInteger := pCodEstMoto;
    buscas2.ParamByName('CHASSI_C').AsString := pChassi;
    buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
    buscas2.Prepare;
    buscas2.ExecSQL;
  end;

 begin
  try
    try
      Result := True;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      buscas3 := TIBQuery.Create(Application);
      buscas3.Database := buscas.Database;
      buscas3.Transaction := buscas.Transaction;

      buscas.Close;
      buscas.SQL.Text := ' select coalesce(reordenar_fila_res, ''N'') as reordenar_fila_res from empresa ' +
        ' where cod_empresa = ' + codEmpresa;
      buscas.Open;
      vreordenarFilaEmp := '';
      if not buscas.IsEmpty then
        vreordenarFilaEmp := buscas.FieldByName('REORDENAR_FILA_RES').AsString;

      if trim(vreordenarFilaEmp) <> 'S' then
       exit;

      vDataBanco := getDataBanco(buscas);
      vHoraBanco := FormatDateTime('HH:MM', getDataHoraBanco(buscas));
      // Busca as informações do veículo atual que esta sendo reservado ou que a reserva está sendo retirada 
      buscas.Close;
      buscas.SQL.Text := ' select first 1 est_moto.*, cl.nome_cliente from est_moto  ' +
       ' left join clientes cl on cl.cod_cliente = est_moto.cod_cliente and cl.cod_empresa = est_moto.cod_empresa ' +
       ' where est_moto.codigo = :codigo and est_moto.chassi_c = :chassi_c and est_moto.cod_empresa = :cod_empresa ';
      buscas.ParamByName('CODIGO').AsInteger := pCodEstMoto;
      buscas.ParamByName('CHASSI_C').AsString := pChassi;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      buscas.Open;

      if buscas.IsEmpty then
        exit;

      vcod_modelo := buscas.FieldByName('VERSAOEST').AsInteger;
      vano_fab := buscas.FieldByName('ANO_FABEST').AsInteger;
      vano_mod := buscas.FieldByName('ANO_MODEST').AsInteger;
      vcod_cor := buscas.FieldByName('COD_COR').AsInteger;
      vcodfila := buscas.FieldByName('COD_FILA_RES').AsInteger;
      vdesc_modelo := UpperCase(trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString));
      vdesc_cor := UpperCase(trim(buscas.FieldByName('COREST').AsString));
      vnomeCliente := UpperCase(trim(buscas.FieldByName('NOME_RES').AsString));
      vfoneCliente := UpperCase(trim(buscas.FieldByName('FONE_RES').AsString));
      vcondres := UpperCase(trim(buscas.FieldByName('TIPO_RES').AsString));
      vGrupoCtRD := UpperCase(trim(buscas.FieldByName('GRUPO_COTA_RD').AsString));
      vassembleia := buscas.FieldByName('DATA_ASSEMBLEIA').AsDateTime;
      vcod_vendedor := buscas.FieldByName('VENDEDOR_RES').AsInteger;
      vPosicao := UpperCase(trim(buscas.FieldByName('POSICAO').AsString));

      if pReservar then
      begin
        // Ao reserva e o veículo já possui um fila de reserva vinculada o sistema não faz nada
        if vcodfila > 0 then
         exit
      end
      else //if not pReservar then
      begin
        // Ao retirar reserva e o veículo não tem nenhuma fila vinculada o sistema não faz nada
        if vcodfila <= 0 then
         exit
      end;

      if pReservar then
      begin
        // Ao reserva o sistema testar se existem veículos em transito para buscar as informações da reserva
        if (trim(vReordenarFila) = 'S') then //and (trim(vPosicao) <> 'TRANSITO') then
        begin
          // Buscar todos os veículos em deposito, transito
          verificarTransito(buscas3, pCodEstMoto, vcod_modelo, vano_fab, vano_mod, vcod_cor, vPosicao, 1);
          // Verifica se o existe alguma veículo em deposito, transito com reserva
          if verificarTransito(buscas, pCodEstMoto, vcod_modelo, vano_fab, vano_mod, vcod_cor, vPosicao) then
          begin
            // Retirar todas as reservas
            try
              pReservar := False;
              buscas.First;
              buscas3.First;
              while not buscas3.Eof do
              begin
                pCodEstMoto := buscas3.FieldByName('CODIGO').AsInteger;
                pChassi := buscas3.FieldByName('CHASSI_C').AsString;
                vPosicao := UpperCase(trim(buscas3.FieldByName('POSICAO').AsString));
                AtualizarReserva(buscas3, 1);
                buscas3.Next;
              end;
            finally
              pReservar := True;
            end;
            // Incluir dados da reserva do veículo em transito na reserva atual que está sendo removida
            buscas.First;
            buscas3.First;
            buscas.RecordCount;
            buscas3.RecordCount;
            while not buscas.Eof do
            begin
              pCodEstMoto := buscas3.FieldByName('CODIGO').AsInteger;
              pChassi := buscas3.FieldByName('CHASSI_C').AsString;
              vPosicao := UpperCase(trim(buscas3.FieldByName('POSICAO').AsString));
              AtualizarReserva(buscas, 1);
              buscas3.Next;
              buscas.Next;
            end;
            if not buscas3.Eof then
            begin
              pCodEstMoto := buscas3.FieldByName('CODIGO').AsInteger;
              pChassi := buscas3.FieldByName('CHASSI_C').AsString;
              vPosicao := UpperCase(trim(buscas3.FieldByName('POSICAO').AsString));
            end;
          end;
        end;
        // Busca o primeiro registro da fila de reserva para adicionar as informações de reserva no veículo
        buscas.Close;
        buscas.SQL.Text := ' select first 1 ''FILA'' posicao, f.*, res.tipo_res tip_res, cl.nome_cliente, ' +
         ' res.quant_dias_reserva from fila_reserva_veic f ' +
         ' left join tipo_reserva res on res.sigla = f.tipo_res and res.tipo = ''VEI'' ' +
         ' left join clientes cl on cl.cod_cliente = f.cod_cliente and cl.cod_empresa = f.cod_empresa ' +
         ' where f.cod_modelo = :cod_modelo and f.ano_fab = :ano_fab and f.ano_mod = :ano_mod ' +
         ' and f.cod_cor = :cod_cor and coalesce(f.status_res, ''N'') = ''N'' ' +
         ' and f.cod_empresa = :cod_empresa and f.ativo = 1 ';
        if (trim(vReordenarFila) = 'S') then
         buscas.SQL.Text := buscas.SQL.Text + ' and f.cod_vendedor > 0 ';
        buscas.SQL.Text := buscas.SQL.Text + ' order by f.ordem ';
        buscas.ParamByName('COD_MODELO').AsInteger := vcod_modelo;
        buscas.ParamByName('ANO_FAB').AsInteger := vano_fab;
        buscas.ParamByName('ANO_MOD').AsInteger := vano_mod;
        buscas.ParamByName('COD_COR').AsInteger := vcod_cor;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
        buscas.Open;

        if (not buscas.IsEmpty) and (trim(vReordenarFila) = 'S') then
        begin
          buscas2.Close;
          buscas2.SQL.Text := ' insert into fila_reserva_veic (codigo, ordem, cod_empresa, cod_modelo, ' +
            ' ano_mod, ano_fab, cod_cor, prev_cheg, ativo) ' +
            ' values (:codigo, :ordem, :cod_empresa, :cod_modelo, :ano_mod, :ano_fab, :cod_cor, :prev_cheg, :ativo) ';
          buscas2.ParamByName('CODIGO').AsInteger := Gencodigo('FILA_RESERVA_VEIC', SpIncCodigo, codEmpresa);
          buscas2.ParamByName('ORDEM').AsInteger := Gencodigo('FILA_RESERVA_VEIC_ORDEM', SpIncCodigo, codEmpresa);
          buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
          buscas2.ParamByName('COD_MODELO').AsInteger := vcod_modelo;
          buscas2.ParamByName('ANO_MOD').AsInteger := vano_mod;
          buscas2.ParamByName('ANO_FAB').AsInteger := vano_fab;
          buscas2.ParamByName('COD_COR').AsInteger := vcod_cor;
          buscas2.ParamByName('PREV_CHEG').AsString := pPrev;
          buscas2.ParamByName('ATIVO').AsInteger := 1;
          buscas2.ExecSQL;
        end;

        if (buscas.IsEmpty) and (trim(vReordenarFila) <> 'S') and (trim(vPosicao) = 'VIVO') then
        begin
           // Verifica se o veículo já teve alguma reserva
           buscas.Close;
           buscas.SQL.Text := ' select first 1 ''FILA'' posicao, f.*, res.tipo_res tip_res, cl.nome_cliente, ' +
            ' res.quant_dias_reserva from fila_reserva_veic f ' +
            ' inner join tipo_reserva res on res.sigla = f.tipo_res and res.tipo = ''VEI'' ' +
            ' left join clientes cl on cl.cod_cliente = f.cod_cliente and cl.cod_empresa = f.cod_empresa ' +
            ' where f.chassi_c = :chassi_c and f.cod_estmoto = :cod_estmoto ' +
            ' and f.codigo = :codigo and coalesce(f.status_res, ''N'') = ''S'' ' +
            ' and f.cod_empresa = :cod_empresa and f.ativo = 1 ' +
            ' order by f.ordem ';
           buscas.ParamByName('CODIGO').AsInteger := vcodfila;
           buscas.ParamByName('COD_ESTMOTO').AsInteger := pCodEstMoto;
           buscas.ParamByName('CHASSI_C').AsString := pChassi;
           buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
           buscas.Open;
        end;

        if buscas.IsEmpty then
          exit;

        vnomeCliente := UpperCase(trim(buscas.FieldByName('NOME_RES').AsString));
        vfoneCliente := UpperCase(trim(buscas.FieldByName('FONE_RES').AsString));
        vcondres := UpperCase(trim(buscas.FieldByName('TIPO_RES').AsString));
        vGrupoCtRD := UpperCase(trim(buscas.FieldByName('GRUPO_COTA_RD').AsString));
        vassembleia := buscas.FieldByName('DATA_ASSEMBLEIA').AsDateTime;
        vcod_vendedor := buscas.FieldByName('COD_VENDEDOR').AsInteger;
        
        if trim(vPosicao) = 'TRANSITO' then
        begin
           vDataRes := buscas.FieldByName('DATA_RES').Value;
           vHoraRes := buscas.FieldByName('HORA_RES').Value;
        end;

        if trim(vPosicao) = 'TRANSITO' then
          RetornaDataHoraVenc(buscas2,
           vPosicao,
           buscas.FieldByName('TIPO_RES').AsString,
           buscas.FieldByName('GRUPO_COTA_RD').AsString,
           buscas.FieldByName('DATA_RES').AsDateTime,
           buscas.FieldByName('HORA_RES').AsString,
           buscas.FieldByName('DATA_ASSEMBLEIA').AsDateTime,
           vTipoRes, vGrupoCotaRD, vDataVenc, vHoraVenc, vDataAssembleia)
        else
          RetornaDataHoraVenc(buscas2,
           vPosicao,
           buscas.FieldByName('TIPO_RES').AsString,
           buscas.FieldByName('GRUPO_COTA_RD').AsString,
           vDataBanco,
           vHoraBanco,
           buscas.FieldByName('DATA_ASSEMBLEIA').AsDateTime,
           vTipoRes, vGrupoCotaRD, vDataVenc, vHoraVenc, vDataAssembleia);
      end;

      buscas2.Close;
      buscas2.SQL.Text := ' update fila_reserva_veic set status_res = :status_res, ' +
       ' cod_estmoto = :cod_estmoto, chassi_c = :chassi_c ' +
       ' where codigo = :codigo and cod_empresa = :cod_empresa ';
      if pReservar then
        buscas2.ParamByName('CODIGO').AsInteger := buscas.FieldByName('CODIGO').AsInteger
      else
        buscas2.ParamByName('CODIGO').AsInteger := vcodfila;
      buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
      if pReservar then
      begin
        buscas2.ParamByName('STATUS_RES').AsString := 'S';
        buscas2.ParamByName('COD_ESTMOTO').AsInteger := pCodEstMoto;
        buscas2.ParamByName('CHASSI_C').AsString := pChassi;
      end
      else
      begin
        buscas2.ParamByName('STATUS_RES').AsString := 'N';
        buscas2.ParamByName('COD_ESTMOTO').Value := Null;
        buscas2.ParamByName('CHASSI_C').Value := Null;
      end;
      buscas2.Prepare;
      buscas2.ExecSQL;

      AtualizarReserva(buscas, 0);

      if pReservar then
      begin
        if trim(vPosicao) <> 'TRANSITO' then
          vTemp := 'VEÍCULO DISPONÍVEL EM ESTOQUE: ' + trim(pChassi) + ','
      end
      else
        vTemp := 'FILA DE RESERVA RETORNADA: ';
      vMensTemp := vTemp +
         'MODELO: ' + trim(vDesc_modelo)  +
         ',ANO_FAB: ' + IntToStr(vano_fab) +
         ',ANO_MOD: ' + IntToStr(vano_mod) +
         ',COR: ' + trim(vDesc_cor) +
         ',CLIENTE: ' + trim(vNomeCliente) +
         ',FONE: ' + trim(vfoneCliente) +
         ',COND: ' + trim(vcondres) +
         + retornoPorCondicao(trim(vGrupoCtRD) <> '',
          ',GRUPO/COTA/RD: ' + trim(vGrupoCtRD), '') + 
         + retornoPorCondicao(vassembleia > 0,
          ',ASSEMBLEIA: ' + trim(FormatDateTime('dd/mm/yyyy', vassembleia)), '');
      if (vcod_vendedor > 0) and (pEnvEmail) then
        EnvMensMobile(buscas, SpIncCodigo, vTemp, vMensTemp, vcod_vendedor);
    except
       on e: exception do
       begin
         Application.MessageBox(Pchar('Não foi possível atualizar fila de reserva: TSingleton.AtualizarFilaReserva!' + #13 +
          'Erro: ' + e.Message), 'Atenção', 64);
         registraErro(e.Message);
         Result := False;
       end;
    end;
  finally
    vReordenarFila := 'N';
  end;
end;

procedure TSingleton.atualizarSaldoCC(pCodCliente: Integer; pCPFCGC: string; pLabel: TLabel;
  pVencidos: boolean; pQtdeGrid: Integer; pBuscas: TIBQuery;
  var pSaldoCC: Double; var pValorCC: Double;
  var pPagGrid: Integer; var pRecordPagGrid: Integer; var pMaxPagGrid: Integer; var pRecordCount: Integer);
var
	vtemp: string;
  vsql: string;
begin
  // Ver saldo
  verSaldoCC(pCodCliente, pCPFCGC, pBuscas, pSaldoCC, pValorCC);

  vtemp := ' cl.cpfcgc = ' +  QuotedStr(pCPFCGC);
  if trim(pCPFCGC) = '' then
  	vtemp := ' cl.cod_cliente = ' + IntToStr(pCodCliente);

//    as datas por conta da performance usar nao usar apos o where, pois interfere nos indices

	vsql := ' select count(*) from conta_corrente_prog_fidelidade cc ' +
    ' left join sp_current_ts(coalesce(cc.cod_emp_resp, cc.cod_empresa)) fh on 1=1' +
    ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
    ' left join empresa_prog_fid empg on coalesce(cc.cod_emp_resp, cc.cod_empresa) = empg.cod_empresa ' +
  	' where ' + vtemp +
    ' and coalesce(cc.cod_emp_resp, cc.cod_empresa) in (case when (empg.cod_empresa > 0) then empg.cod_empresa else ' + codEmpresa + ' end) ' +
   IfThen(not pVencidos,
   		' and cc.data_venc_prog >= fh.current_d',
      ' and cc.data_venc_prog < fh.current_d');

  SqlOpen(vsql, pBuscas);

  pRecordCount := pBuscas.FieldByName('count').AsInteger;
  pMaxPagGrid := Trunc(pBuscas.FieldByName('count').AsInteger / pQtdeGrid);
  if ((pBuscas.FieldByName('count').AsInteger / pQtdeGrid) > pMaxPagGrid) then
    pMaxPagGrid := pMaxPagGrid + 1;

  if pBuscas.FieldByName('count').AsInteger <= 0 then
  begin
    pPagGrid := 0;
    pLabel.Caption := '0 / 0';
  end
  else
    pLabel.Caption := IntToStr(pPagGrid + 1) + ' / ' + IntToStr(pMaxPagGrid);

  vsql := StringReplace(vsql,
  	' count(*) ',
    ' first ' + IntToStr(pQtdeGrid) + ' skip ' + IntToStr(pQtdeGrid * pPagGrid) + ' cc.codigo, cc.cod_empresa ',
    [rfReplaceAll]);

  SqlOpen(vsql, pBuscas).FetchAll;

  pRecordPagGrid := pBuscas.RecordCount;
end;

function TSingleton.atualizarValorDesconto(
	pValorDoc: Currency; pValorDescontoDoc: Currency; pValorBoletos: Currency;
  pValorArray: array of Currency; var pDescontoArray: array of Currency): Boolean;
var
	vtotdescontotmp: Double;
  I: Integer;
begin
	vtotdescontotmp := 0;
	if pValorDoc > pValorBoletos then
  begin
    for I := 0 to Length(pValorArray) - 1 do
    begin
      pDescontoArray[I] := StrToFloatFormat(
      	((pValorArray[I] / pValorBoletos) * pValorDescontoDoc) *
        		(pValorBoletos / pValorDoc), 2);

      vtotdescontotmp := vtotdescontotmp + pDescontoArray[I];
    end;
  end
  else
  begin
    for I := 0 to Length(pValorArray) - 1 do
    begin
      pDescontoArray[I] := StrToFloatFormat(
      	(pValorArray[I] / pValorBoletos) * pValorDescontoDoc, 2);

      vtotdescontotmp := vtotdescontotmp + pDescontoArray[I];
    end;
  end;

  if pValorDoc = pValorBoletos then
  begin
  	if vtotdescontotmp <> pValorDescontoDoc then
    	if pValorArray[High(pValorArray)] >= pValorArray[Low(pValorArray)] then
      begin
        pDescontoArray[High(pValorArray)] :=
        	pDescontoArray[High(pValorArray)] - (vtotdescontotmp - pValorDescontoDoc);
      end
      else
      begin
    		pDescontoArray[Low(pValorArray)]  :=
        	pDescontoArray[Low(pValorArray)] - (vtotdescontotmp - pValorDescontoDoc);
      end;
  end;
end;

