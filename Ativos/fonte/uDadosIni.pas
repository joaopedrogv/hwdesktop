                  Con.QrAux.Close;
                  Con.QrAux.SQL.Text := ' insert into clientes_contato_env ' +
                    ' (cod_cliente, cod_empresa, origem_env, id_contato) ' +
                    ' values (:cod_cliente, :cod_empresa, :origem_env, :id_contato); ';
                  Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
                  Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
                  Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
                  Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
                  Con.QrAux.ExecSQL;
                end;
            end
            else
            begin
                vTipoId := Gencodigo('TIPO_CONTATO', Con.QrAux, codEmpresa);

                Con.QrAux.Close;
                Con.QrAux.SQL.Text := ' insert into tipo_contato ' +
                  ' (id, cod_empresa, tipo) ' +
                  ' values (:id, :cod_empresa, :tipo); ';
                Con.QrAux.ParamByName('id').AsInteger := vTipoId;
                Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
                Con.QrAux.ParamByName('tipo').AsString := trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 2));
                Con.QrAux.ExecSQL;

              if vTipoId > 0 then
              begin
                  vIdContato := Gencodigo('CLIENTES_CONTATO', Con.QrAux, codEmpresa);

                  Con.QrAux.Close;
                  Con.QrAux.SQL.Text := ' insert into clientes_contato ' +
                  ' (id, cod_cliente, cod_empresa, tipo_id, contato, telefone) ' +
                    ' values (:id, :cod_cliente, :cod_empresa, :tipo_id, :contato, :telefone) ';
                  Con.QrAux.ParamByName('id').AsInteger := vIdContato;
                  Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
                  Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
                  Con.QrAux.ParamByName('tipo_id').AsInteger := vTipoId;
                  Con.QrAux.ParamByName('contato').AsString := Copy(trim(pContatoEmail), 1, 32);
                  Con.QrAux.ParamByName('telefone').AsString := trim(getCampoPipe(trim(pListContatoWhatsApp.Items[I]), 1));
                  Con.QrAux.ExecSQL;

                  Con.QrAux.Close;
                  Con.QrAux.SQL.Text := ' insert into clientes_contato_env ' +
                    ' (cod_cliente, cod_empresa, origem_env, id_contato) ' +
                    ' values (:cod_cliente, :cod_empresa, :origem_env, :id_contato); ';
                  Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
                  Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
                  Con.QrAux.ParamByName('origem_env').AsString := OrigemEnvStr[pOrigemEnv];
                  Con.QrAux.ParamByName('id_contato').AsInteger := vIdContato;
                  Con.QrAux.ExecSQL;
                end;
              end;
            end;
          end;
        end;

        if Con.QrAux.Transaction.InTransaction then
          Con.QrAux.Transaction.Commit;

      Result := True;
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar('Erro ao confirmar email / whatsapp: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao confirmar email / whatsapp: ' + e.Message);
        Con.QrAux.Transaction.Rollback;
    end;
  end;
  finally
    if Assigned(Con) then
      FreeAndNil(Con);
end;
end;

procedure TSingleton.configuraChecks(DBGrid: TClientDataSet; form: TForm);
var
  i, j: integer;
begin
  for I := 0 to DBGrid.FieldCount - 1 do
  begin
    for j := 0 to form.ComponentCount - 1 do
      if (form.Components[j] is TCheckBox) and (form.Components[j].Name = DBGrid.Fields[i].Name) then
      begin
        if (DBGrid.Fields[I].Tag = 0) or (DBGrid.Fields[I].Tag = 3) then
          TCheckBox(form.Components[j]).Checked := DBGrid.Fields[i].Visible
        else if (DBGrid.Fields[I].Tag = 1) then
          TCheckBox(form.Components[j]).Checked := false
        else if (DBGrid.Fields[I].Tag = 2) then
          TCheckBox(form.Components[j]).Checked := true;
        Break;
      end;
  end;
end;

function TSingleton.configuraItensTipovenda(vcomb: TDbCombobox; vtipo: string;
  pQuery: TIBQuery;pAddTipoEscolha: boolean): boolean;
begin
  result := false;
  pQuery.close;
  pQuery.sql.text := 'select * from tipo_vendas where tipo = ''' + vtipo + ''' order by cod_tipo';
  pQuery.open;
  vcomb.Items.Clear;
  while not pQuery.eof do
  begin
    if (pQuery.FieldByName('TIPO').AsString = 'REQ') or (pQuery.FieldByName('TIPO').AsString = 'ORC')
      then
      vcomb.Items.Add(pQuery.FieldByName('DESCRICAO').AsString);
    if (trim(pQuery.FieldByName('TIPO').AsString) = 'OS') or
      (trim(pQuery.FieldByName('TIPO').AsString) = 'TMO') then
      vcomb.Items.Add(pQuery.FieldByName('TIPO_OS').AsString);
    pQuery.next;
  end;
  if pAddTipoEscolha then
    if (vtipo = 'REQ') or (vtipo = 'ORC') then
      vcomb.Items.Add('E - ESCOLHA');
  Result := true;
end;

