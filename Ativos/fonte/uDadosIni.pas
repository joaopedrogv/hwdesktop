function TSingleton.EnvMensMobile(query: TIBQuery; SpIncCodigo: TIBStoredProc; pAssunto, pMensagem: string;
  pCodVendRes: Integer; pEmailVeiculos: boolean = true): boolean;
var
 vNomeUsuario, vEmail: string;
 buscas2: TIBQuery;
begin
  if (trim(vEmp.vEnvEmailReservaVeic) <> 'S') and (pEmailVeiculos) then
  begin
     Result := True;
     exit;
  end;
  try
    try
       Result := False;
       buscas2 := TIBQuery.Create(Application);
       buscas2.Database := query.Database;
       buscas2.Transaction := query.Transaction;

       query.Close;
       query.SQL.Text := ' SELECT FIRST 1 COL.COD_VENDEDOR, COL.NOME_VENDEDOR, COL.EMAIL, SEN.USUARIO FROM COLABORADOR COL ' +
        ' INNER JOIN SENHAS SEN ON SEN.CODIGO = COL.COD_VENDEDOR AND SEN.COD_EMPRESA = COL.COD_EMPRESA ' +
        ' WHERE COL.COD_VENDEDOR = :COD_VENDEDOR AND COL.COD_EMPRESA = :COD_EMPRESA';
       query.ParamByName('COD_VENDEDOR').AsInteger := pCodVendRes;
       query.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
       query.Open;

       if trim(query.FieldByName('EMAIL').AsString) = '' then
         exit;

       vEmail := trim(query.FieldByName('EMAIL').AsString);
       vNomeUsuario := trim(query.FieldByName('USUARIO').AsString);

       query.Close;
       query.SQL.Text := ' INSERT INTO MENSAGEM_MOB (IDSEQM, IDMOBILE, COD_EMPRESA, TIPO, NATUREZA_MENS, ' +
        ' DATA_ENVIO, HORA_ENVIO, MENSAGEM, ATIVO, US_ENVIO, US_DEST) ' +
        ' VALUES (:IDSEQM, :IDMOBILE, :COD_EMPRESA, :TIPO, :NATUREZA_MENS, ' +
        ' :DATA_ENVIO, :HORA_ENVIO, :MENSAGEM, :ATIVO, :US_ENVIO, :US_DEST); ';
       query.ParamByName('IDSEQM').AsInteger := Gencodigo('MENSAGEM_MOB', SpIncCodigo, codEmpresa);
       query.ParamByName('IDMOBILE').AsInteger := 0;
       query.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
       query.ParamByName('TIPO').AsString := 'E';
       query.ParamByName('NATUREZA_MENS').AsString := 'A';
       query.ParamByName('DATA_ENVIO').AsString := FormatDateTime('DD/MM/YYYY', getDataHoraBanco(buscas2));
       query.ParamByName('HORA_ENVIO').AsString := FormatDateTime('HH:MM', getDataHoraBanco(buscas2));
       query.ParamByName('MENSAGEM').AsString := Copy(trim(pMensagem), 1, 400);
       query.ParamByName('ATIVO').AsInteger := 1;
       query.ParamByName('US_ENVIO').AsInteger := vCodUsuario;
       query.ParamByName('US_DEST').AsString := Copy(trim(vNomeUsuario), 1, 30);
       query.ParamByName('ORIG_MENS').AsString := 'M';
       query.ExecSQL;
       Result := True;
    except
      Result := False;
    end;
  finally
//     if (Pos('#$D#$A', pMensagem) > 0) then
//       pMensagem := StringReplace(pMensagem, '#$D#$A', '<BR>', [rfReplaceAll]);
//     else if (Pos(#13, pMensagem) > 0) then
//       pMensagem := StringReplace(pMensagem, #13, '<BR>', [rfReplaceAll])
//     else if (Pos(#13#10, pMensagem) > 0) then
       pMensagem := StringReplace(pMensagem, #13#10, '<BR>', [rfReplaceAll]);

     vEmailVend := 'S';
     EnvEmail(pAssunto, pMensagem, pCodVendRes);
  end;
end;

