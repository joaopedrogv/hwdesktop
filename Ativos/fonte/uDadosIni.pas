function TSingleton.dataVerificacaoNotificacaoBackup(
  AqrBusca: TIBQuery; 
  var AVerificarBackupBD: string; var ANotificarAposDias: Integer; var ANotificarBackupBD: Boolean; var ADataUltimoBackupBD: TDateTime): boolean;
begin
	try
    Result := False;
    ANotificarBackupBD := Result;

    AQrBusca.Close;
    AQrBusca.SQL.Text := ' select empdesvolv.verificar_backup, ' +
      ' cast(empdesvolv.data_backup_banco as date) data_backup_banco, ' +
    	' cast(empdesvolv.data_backup_outros as date) data_backup_outros, ' +
      ' case when (empdesvolv.notificar_backup_apos_dias > 1) then empdesvolv.notificar_backup_apos_dias else 1 end notificar_backup_apos_dias, ' +
      ' case when (empdesvolv.enviar_notificacao_cada_dias > 1) then empdesvolv.enviar_notificacao_cada_dias else 1 end enviar_notificacao_cada_dias, ' +
      ' cast(empdesvolv.data_verificacao_backup as date) data_verificacao_backup, ' +
      ' cast(empdesvolv.data_notificacao_backup as date) data_notificacao_backup, ' +
      ' current_date from empdesvolv ' +
      ' where empdesvolv.cod_empdes = :cod_empdes ';
    AQrBusca.ParamByName('cod_empdes').AsInteger := 1;
    AQrBusca.Open;

    // Verificar backup bd
    AVerificarBackupBD := AQrBusca.FieldByName('verificar_backup').AsString;

    // Notificar apos dia
    ANotificarAposDias := AQrBusca.FieldByName('notificar_backup_apos_dias').AsInteger;

    // Data último backup bd
//    if AQrBusca.FieldByName('data_backup_outros').AsDateTime > AQrBusca.FieldByName('data_backup_banco').AsDateTime then
//    	ADataUltimoBackupBD := AQrBusca.FieldByName('data_backup_outros').AsDateTime
//    else
    ADataUltimoBackupBD := AQrBusca.FieldByName('data_backup_banco').AsDateTime;

    // Enviar notificacao
    if AQrBusca.FieldByName('verificar_backup').AsString <> 'S' then
    	Exit;

    // Notificar apos x dias
    if (AQrBusca.FieldByName('current_date').AsDateTime - AQrBusca.FieldByName('notificar_backup_apos_dias').AsInteger >= AQrBusca.FieldByName('data_backup_banco').AsDateTime) then
    	Result := True;
//    	and (AQrBusca.FieldByName('current_date').AsDateTime - AQrBusca.FieldByName('notificar_backup_apos_dias').AsInteger >= AQrBusca.FieldByName('data_backup_outros').AsDateTime) then
//    		Result := True;

    // Notificar a cada x dias (data_verificacao_backup / data_notificacao_backup)
    if Result then
    begin
    	if (AQrBusca.FieldByName('current_date').AsDateTime - 1 >= AQrBusca.FieldByName('data_verificacao_backup').AsDateTime)
      	and ((AQrBusca.FieldByName('current_date').AsDateTime - AQrBusca.FieldByName('enviar_notificacao_cada_dias').AsInteger >= AQrBusca.FieldByName('data_notificacao_backup').AsDateTime)) then
    			Result := True
      else
      		Result := False;
    end;

    ANotificarBackupBD := Result;
  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao verificar data notificacao backup do sistema. Erro: ' + e.Message),
        'Atenção', 0 + 64);
      registraErro('TSingleton.dataVerificacaoNotificacaoBackup. Erro: ' + e.Message);
    end;
  end;
end;

procedure TSingleton.DBGridOnDrawColumnCell(Sender: TObject; const Rect: TRect;
  DataCol: Integer; Column: TColumn; State: TGridDrawState);
var
  Check: Integer;
  R: TRect;
  Agrid: TDBGrid;
begin
  inherited;
  if not Assigned(Sender) then
    Exit;

  Agrid := TDBGrid(Sender);

  if Agrid.DataSource.DataSet.FieldByName('sel').AsString = 'S' then
    if (gdFocused in State) then
    begin
      Agrid.Canvas.Brush.Color := clWindow;
      Agrid.Canvas.Font.Color := clWindowText;
    end
    else
    begin
      Agrid.Canvas.Brush.Color := clHighlight;
      Agrid.Canvas.Font.Color := clWhite;
    end;
  Agrid.DefaultDrawColumnCell(Rect, DataCol, Column, State);

  if Column.FieldName = 'SEL' then
  begin
    if Column.Index <> 0 then
      Column.Index := 0;
    if Column.Width <> 18 then
      Column.Field.DisplayWidth := 1;

    Agrid.Canvas.FillRect(Rect);
    Check := 0;
    if Column.Field.AsString = 'S' then
      Check := DFCS_CHECKED
    else
      Check := 0;
    R := Rect;
    InflateRect(R, 2, 0);
    DrawFrameControl(Agrid.Canvas.Handle, R, DFC_BUTTON, DFCS_BUTTONCHECK or Check);
  end;
end;

procedure TSingleton.DBGridOnTitleClick(DBGrid: TDBGrid; Column: TColumn);
var
  i,k, t: integer; vTemp,vNomeIdx: string;
  vInverterOrdem:boolean;
begin
  if TClientDataSet(DBGrid.DataSource.DataSet) <> nil then
    TClientDataSet(DBGrid.DataSource.DataSet).AfterClose := fDataseAfterClose;

  if (Column.Field <> nil) and (Column.Field.FieldKind = fkInternalCalc) then
    exit;
  if DBGrid.DataSource = nil then
    exit;
  try
  if vShiftClick then
  begin
    vInverterOrdem:=false;
    if (TClientDataSet(DBGrid.DataSource.DataSet).IndexName = '') then//or (copy(TClientDataSet(DBGrid.DataSource.DataSet).IndexName, 1, 4) = 'IDX$') then
    begin
      vTemp := Column.Field.FieldName;
      vNomeIdx:='IDX$A'+vTemp;
      for I := 0 to DBGrid.Columns.Count - 1 do
        DBGrid.Columns[i].Title.Font.Style := [];
      TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Clear;
      TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add( 'IDX$A'+vTemp, vTemp , []);
    end else if not(pos(Column.Field.FieldName,TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Items[0].FieldExpression)>0) then
    begin
      vNomeIdx := copy(TClientDataSet(DBGrid.DataSource.DataSet).IndexName,6,length(TClientDataSet(DBGrid.DataSource.DataSet).IndexName)-5);
      vTemp := TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Items[0].FieldExpression;
      vTemp := vTemp + ';' + Column.Field.FieldName;
      k:=0;
      for I := 1 to Length(vTemp) do
        if vTemp[i]=';' then
          inc(k);
      vNomeIdx:= vNomeIdx+inttostr(k);
      TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Clear;
      if pos('IDX$A',TClientDataSet(DBGrid.DataSource.DataSet).IndexName)>0 then
      begin
         TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add( 'IDX$A'+vNomeIdx, vTemp , []);
         vNomeIdx := 'IDX$A'+vNomeIdx;
      end
      else begin
        TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add( 'IDX$D'+vNomeIdx, vTemp , [ixDescending]);
        vNomeIdx := 'IDX$D'+vNomeIdx
      end;
    end else begin
      vTemp := TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Items[0].FieldExpression;
      k:=0;
      for I := 1 to Length(vTemp) do
        if vTemp[i]=';' then
          inc(k);
      if TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Find(TClientDataSet(DBGrid.DataSource.DataSet).IndexName).Options = [ixDescending] then
      begin
        vNomeIdx := StringReplace(TClientDataSet(DBGrid.DataSource.DataSet).IndexName,'IDX$D','IDX$A',[]);
        vNomeIdx := vNomeIdx + inttostr(k);
        TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Clear;
        TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add( vNomeIdx, vTemp , []);
      end
      else begin
        vNomeIdx := StringReplace(TClientDataSet(DBGrid.DataSource.DataSet).IndexName,'IDX$A','IDX$D',[]);
        vNomeIdx := vNomeIdx + inttostr(k);
        TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Clear;
        TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add( vNomeIdx, vTemp , [ixDescending]);
      end;
//      TClientDataSet(DBGrid.DataSource.DataSet).IndexFieldNames:='';
      vInverterOrdem:=true;
    end;

    try
//      Application.MessageBox(pchar(vNomeIdx+' '+TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Items[0].FieldExpression), 'Alerta', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      TClientDataSet(DBGrid.DataSource.DataSet).IndexName := vNomeIdx;
      Column.Title.Font.Style := [fsBold];
    except
    end;

  end
  else
  if (not naoOrdenar) and (TClientDataSet(DBGrid.DataSource.DataSet).Active) then
  begin
    // Aqui todas as colunas voltam para fonte normal
    for I := 0 to DBGrid.Columns.Count - 1 do
      DBGrid.Columns[i].Title.Font.Style := [];
    
    TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Clear;
    if TClientDataSet(DBGrid.DataSource.DataSet).Tag = 0 then // a Propriedade TAG do clientDataSet serve para definir a ordem ascendente quando 1 e descendent quando 2
    begin
      TClientDataSet(DBGrid.DataSource.DataSet).Tag := 1;
      vTemp := 'IDX$A' + Column.Field.FieldName;
      TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add(vTemp, Column.Field.FieldName,[]);
    end
    else if TClientDataSet(DBGrid.DataSource.DataSet).Tag = 1 then
    begin
      TClientDataSet(DBGrid.DataSource.DataSet).Tag := 0;
      vTemp := 'IDX$D' + Column.Field.FieldName;
      TClientDataSet(DBGrid.DataSource.DataSet).IndexDefs.Add(vTemp, Column.Field.FieldName,[ixDescending]);
    end;
    TClientDataSet(DBGrid.DataSource.DataSet).IndexName := vTemp;
    Column.Title.Font.Style := [fsBold];
  end;
  //Aqui a coluna que foi clicada fica em negrito para destaque.

  if DBGrid.DataSource <> nil then
    if TClientDataSet(DBGrid.DataSource.DataSet).active then
      TClientDataSet(DBGrid.DataSource.DataSet).First;
  finally
    vShiftClick:=false;
  end;
  //Aqui a coluna que foi clicada fica em negrito para destaque.

  if DBGrid.DataSource <> nil then
    if TClientDataSet(DBGrid.DataSource.DataSet).active then
      TClientDataSet(DBGrid.DataSource.DataSet).First;
end;

