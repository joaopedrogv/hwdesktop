function TSingleton.gerar_contrapartida(ACamposLanc, AValoresLanc: string; AQtdeCampos: Integer; ATransaction: TIBTransaction): boolean;
var
  AProcedure: Tgerar_contrapartida;
  ATransactionRescue: TIBTransaction;
  AUseTransacionIni: Boolean;
begin
  try
    if (Assigned(ATransaction)) and     // transacao do parametro
       (Assigned(vTransactionTmp)) then // transacao do dadosini
      ATransactionRescue := vTransactionTmp; // transacao para recuperar no finally

    if vContasAReceber.AHandle = 0 then
      CarregaPacote('pkContasAReceber', vContasAReceber.AHandle);

    if vContasAReceber.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Contas a Receber não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vContasAReceber.AHandle, 'gerar_contrapartida');
    if Assigned(AProcedure) then
    begin
      if Assigned(ATransaction) then
      begin
        vTransactionTmp := ATransaction;
        AUseTransacionIni := True;
      end
      else
        AUseTransacionIni := False;
      Result := AProcedure(ACamposLanc, AValoresLanc, AQtdeCampos, AUseTransacionIni);
    end;
  finally
  	if Assigned(ATransactionRescue) then
      vTransactionTmp := ATransactionRescue;
  end;
end;

function TSingleton.gerar_contrapartidaCTP(ACamposCTP, AValoresCTP: string; AQtdeCampos: Integer): boolean;
