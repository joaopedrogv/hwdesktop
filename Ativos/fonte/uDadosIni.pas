        Application.MessageBox(PChar('Erro ao atribuir valor do vale programa de fidelidade (ndoc: ' + IntToStr(pndoc) + ' tipo: ' + trim(ptipo) + ' ) ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
