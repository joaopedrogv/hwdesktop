        registraErro('procedure TSingleton.verificarControleCheque_Pendentes_Unificacao. Erro' + e.Message + ' SQL: ' + buscas2.SQL.Text);
      end;
    end;
    cQuery.Next;
  end;
end;

procedure TSingleton.verificarControleCreditos_Pendentes_Unificacao(
