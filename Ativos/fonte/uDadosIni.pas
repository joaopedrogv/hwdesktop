function TSingleton.operacaoPosVirtual(payload: TTEFOperacao; pBuscas: TIBQuery): Boolean;
var
  formulario: TForm;
  aClass: TPersistentClass;
  hdPedVenda: THandle;
  terminalf: Integer;
  fileName: string;
begin
  Result := False;
  if GetIni('TEF', 'POSVirtual', 'N') <> 'S' then
  begin
    Application.MessageBox('POS Virtual desativado!', 'Atenção', 0 + 64);
    Exit;
  end;

  fileName := IncludeTrailingPathDelimiter(GetIni('TEF', 'Path', 'C:\Client\')) + 'Resp\';
  if FileExists(fileName + 'IntPos.fim') then
  begin
    DeleteFile(PAnsiChar(fileName + 'IntPos.fim'));
    Sleep(100);
  end;

  if FileExists(fileName + 'IntPos.fin') then
  begin
    DeleteFile(PAnsiChar(fileName + 'IntPos.fin'));
    Sleep(100);
  end;

  if (StrToInt64Def(payload.numeroDocumento, 0) <= 0) and (payload.operacao = posCRT) then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := 'select COD from INCREMENTA_CODIGO(' + codEmpresa + ', ''POSVIRTUAL'')';
    pBuscas.Open;

    if pBuscas.FieldByName('COD').AsInteger > 0 then
      payload.numeroDocumento := IntToStr(pBuscas.FieldByName('COD').AsInteger)
    else
    begin
      Randomize;
      payload.numeroDocumento := IntToStr(Random(999999));
    end;
    payload.textoParaUsuario := payload.textoParaUsuario + ' - ' + payload.numeroDocumento;
    pBuscas.Transaction.Commit;
  end;

  aClass := GetClass('TfrmPOSVirtualTEF');
  if aClass = nil then
  begin
    CarregaPacote('pkPedidoVenda', hdPedVenda);
    if hdPedVenda <> 0 then
      aClass := GetClass('TfrmPOSVirtualTEF');
  end;
  if aClass <> nil then
    Application.CreateForm(TComponentClass(aClass), formulario)
  else
    raise Exception.Create('Modulo não foi carregado');

  if payload.operacao = posCartaoMaisCarteiras then
  begin
    with TConfig_sistema_class.getConf('pos_virtual_conf', pBuscas, cod_empresa) do
    try
      if ReadString('Conf', 'HabilitarCarteirasDigitais', '') <> 'S' then
        payload.operacao := posCRT;
    finally
      Free()
    end;
  end;

  vPOSV.operacao := payload.operacao;
  vPOSV.textoParaUsuario := payload.textoParaUsuario;
  vPOSV.numeroDocumento := payload.numeroDocumento;
  vPOSV.TEFSHouse := vEmpDesNomeEmp;
  vPOSV.showImpressao := not payload.hidePrint;
  vPOSV.valorOperacao := payload.valorOperacao;
  vPOSV.valorMaximoFP := payload.valorMaximoFP;
  vPOSV.idCarteiraDigital := payload.idCarteiraDigital;
  vPOSV.IdPSP := payload.idPSP;
  vPOSV.nomeCarteiraDigital := '';

  try
    Result := formulario.Showmodal = mrOk;

    payload.operacao := vPOSV.operacao; //caso seja indefinida e selecionada na tela aqui pega a operação selecionada
  finally
    formulario.Free;
  end;

  if Result and (vPOSV.idCarteiraDigital <> '') then
  begin

  end
  else
  if Result and (vPOSV.operacao in [posCRT, posCRTDIG]) then
  begin
    try
      terminalf := StrToIntDef(Trim(GetIni('TEF', 'TerminalF', '0')), 0);

      SqlOpen('select t.cod_term_adm from terminal_cartao t' +
              ' inner join adm_cartao a on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
              ' inner join adm_cartao_redes ar on a.cod_adm = ar.cod_adm and a.cod_empresa = ar.cod_empresa and ar.rede = %s' +
              ' where %s t.cod_empresa = %d and t.tipo = ''D'' ',
              [QuotedStr(Trim(vPOSV.retornoREDE)),
               StrUtils.IfThen(terminalf > 0, 't.cod_terminalf = ' + IntToStr(terminalf) + ' and '),
               cod_empresa], pBuscas).FetchAll;
      if pBuscas.RecordCount = 1 then
        vPOSV.terminalAdm := pBuscas.FieldByName('cod_term_adm').AsString
      else
        vPOSV.terminalAdm := getTerminalADM(pBuscas, True);

      SqlOpen('select ar.tband, ar.debcred, cl.cpfcgc from terminal_cartao t' +
              ' inner join adm_cartao a on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
              ' left join adm_cartao_redes ar on a.cod_adm = ar.cod_adm and a.cod_empresa = ar.cod_empresa and ar.rede = %s' +
              ' inner join clientes cl on cl.cod_cliente = a.cod_cliente and cl.cod_empresa = a.cod_empresa' +
              ' where t.cod_term_adm = %s and  t.cod_empresa = %d and t.tipo = ''D'' ',
              [QuotedStr(vPOSV.retornoREDE), QuotedStr(vPOSV.terminalAdm), cod_empresa], pBuscas);

      vPOSV.tband := 99;
      if pBuscas.FieldByName('tband').AsInteger > 0 then
        vPOSV.tband := pBuscas.FieldByName('tband').AsInteger;
      if Trim(pBuscas.FieldByName('debcred').AsString) <> '' then
      begin
        vPOSV.debitoCreditoOutros := Trim(pBuscas.FieldByName('debcred').AsString);
        if (not pBuscas.IsEmpty) and (vPOSV.parcelas <= 1) and (vPOSV.debitoCreditoOutros = 'D') then
          vPOSV.diasParaCredito := 2;
      end;
      if Trim(pBuscas.FieldByName('cpfcgc').AsString) <> '' then
      begin
        vPOSV.cnpjAdm := Trim(pBuscas.FieldByName('cpfcgc').AsString);
        vPOSV.cnpjAdm := StrUtils.IfThen(Length(vPOSV.cnpjAdm) = 14, vPOSV.cnpjAdm);
      end;

    except on E: Exception do
      begin
        registraErro('TSingleton.operacaoPosVirtual* ' + e.Message);
      end;
    end;
  end;
end;

function TSingleton.permiteSelecionarContato(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox;
  pExibirMensagem: Boolean = True): Boolean;
var
	Con: TConexao;
	vAplicativo: string;
  vContato: string;
  vIdentificacao: string;
  vIdAplicativo: Integer;
  vIdContato: Integer;
begin
	Result := True;

  Con := TConexao.Create(dtmAtivo.bancoHw);
  try
    if vHwCloudIA.vUsarServMensageria <> 'S' then
      Exit;

    if vHwCloudIA.vSomenteContatosAceitos <> 'S' then
    	Exit;

    retornaDadosContato(pCheckListContato, vAplicativo, vContato, vIdentificacao);
    vIdAplicativo := retornaCodAplicativo(trim(vAplicativo));
    vIdContato := retornaCodContato(pCodCliente, vIdAplicativo, vContato, vIdentificacao);

    if vIdContato <= 0 then
      Exit;

    SqlOpen(' select msg_contato_tipo_notif.aceita from msg_contato_tipo_notif ' +
    	'	inner join msg_tipo_notif on msg_tipo_notif.id = msg_contato_tipo_notif.id_msg_tipo_notif ' +
      '	inner join msg_tipo_notif_origem on msg_tipo_notif_origem.id_msg_tipo_not = msg_tipo_notif.id ' +
      ' inner join msg_origem on msg_origem.id = msg_tipo_notif_origem.id_msg_origem ' +
      ' where msg_contato_tipo_notif.id_msg_contato = ' + IntToStr(vIdContato) +
      ' and msg_contato_tipo_notif.cod_empresa = ' + codEmpresa +
      ' and msg_origem.descricao = ' + QuotedStr(OrigemEnvStr[pOrigem]), Con.QrAux);

    if Con.QrAux.FieldByName('ACEITA').IsNull then
    begin
      if pExibirMensagem then
        Application.MessageBox(PChar('Contato selecionado ainda não aceito pelo cliente: ' + #13 + #13 +
          'CONTATO' + #13 +
          'Contato: ' + trim(vContato) + #13 +
          vAplicativo + ': ' + trim(vIdentificacao) + #13 + #13 +
          'Favor verificar antes de continuar.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      Exit;
    end
    else if Con.QrAux.FieldByName('ACEITA').AsString <> 'S' then
    begin
      if pExibirMensagem then
        Application.MessageBox(PChar('Contato selecionado não foi aceito pelo cliente: ' + #13 + #13 +
          'CONTATO' + #13 +
          'Contato: ' + trim(vContato) + #13 +
          vAplicativo + ': ' + trim(vIdentificacao) + #13 + #13 +
          'Favor verificar antes de continuar.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      Exit;
    end;
  finally
  	if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

