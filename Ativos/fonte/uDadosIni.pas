procedure TSingleton.retornaCheckListContato(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListBox: TCheckListBox);
var
  Con: TConexao;
	vHabKentro: Boolean;
  vIdentificacao: string;
  vEmail: string;
  vStringListIdentificacao: TStringList;
  I: Integer;
begin
	pCheckListBox.Items.Clear;
  if pCodCliente <= 0 then
  	Exit;

  Con := TConexao.Create(dtmAtivo.bancoHw);
  try
    try
      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        SqlOpen(' select ' +
          ' msg_aplicativo.aplicativo, ' +
          ' msg_contato.contato, ' +
          '	msg_contato.identificador, ' +
          IfThen(vHwCloudIA.vSomenteContatosAceitos = 'S',
            ' coalesce((select coalesce(msg_contato_tipo_notif.aceita, '''') from msg_contato_tipo_notif ' +
            '						inner join msg_tipo_notif on msg_tipo_notif.id = msg_contato_tipo_notif.id_msg_tipo_notif ' +
            '						inner join msg_tipo_notif_origem on msg_tipo_notif_origem.id_msg_tipo_not = msg_tipo_notif.id ' +
            '           inner join msg_origem on msg_origem.id = msg_tipo_notif_origem.id_msg_origem ' +
            '  					where msg_contato_tipo_notif.id_msg_contato = msg_contato.id ' +
            '  					and msg_contato_tipo_notif.cod_empresa = msg_contato.cod_empresa ' +
            ' 					and msg_origem.descricao = ' + QuotedStr(OrigemEnvStr[pOrigem]) + '), '''') ',
            QuotedStr('S')
          ) + ' aceita, ' +
          ' ''S'' sel from msg_contato ' +
          ' inner join msg_aplicativo on msg_aplicativo.id = msg_contato.id_msg_aplicativo ' +
          ' where msg_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and msg_contato.cod_empresa = ' + codEmpresa +
          ' and ativo = 1 ' +
          ' order by 1, 3 ',
          Con.QrAux);

        Con.QrAux.First;
        while not Con.QrAux.Eof do
        begin
          pCheckListBox.Items.Add(
            trim(Con.QrAux.FieldByName('aplicativo').AsString) + ' - ' +
            StringReplace(trim(Con.QrAux.FieldByName('contato').AsString), '-', ' ', [rfReplaceAll]) + ' - ' +
            trim(Con.QrAux.FieldByName('identificador').AsString) +
            IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) = '',
            	' -> Contato não aceito pelo cliente ',
              	IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S', ' -> Contato ainda não foi aceito pelo cliente ', '')) 
          );

        	if trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S' then
          	pCheckListBox.ItemEnabled[pCheckListBox.Items.Count - 1] := False
          else if trim(Con.QrAux.FieldByName('sel').AsString) = 'S' then
            pCheckListBox.Checked[pCheckListBox.Items.Count - 1] := True;

          Con.QrAux.Next;
        end;
      end
      else
      begin
        try
          vHabKentro := trim(retornaDadosKentro(Con.QrAux, False)) <> '';

          vStringListIdentificacao := TStringList.Create;
          vStringListIdentificacao.Sorted := True;
          vStringListIdentificacao.Duplicates := dupIgnore;
          vStringListIdentificacao.Clear;

          SqlOpen(' select ' +
            ' ''E-MAIL'' aplicativo, ' +
            ' coalesce(clientes.contato, ''SEM CONTATO'') as contato, ' +
            '	clientes.email as identificador, ' +
            ' ''S'' aceita, ' +
            ' ''S'' sel from clientes ' +
            ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
            ' and clientes.cod_empresa = ' + codEmpresa +
            ' and trim(coalesce(clientes.email, '''')) <> '''' ' +
  //          ' union ' +
  //          ' select ' +
  //					' ''E-MAIL'' aplicativo, ' +
  //					' clientes_contato.contato, ' +
  //					' clientes_contato.email as identificador, ' +
	//					' ''S'' aceita, ' +
  //          ' case when ((select count(*) from clientes_contato_env ' +
  //          '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
  //          '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
  //          '             and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
  //          '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
  //          ' from clientes_contato ' +
  //          ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
  //          ' and clientes_contato.cod_empresa = ' + codEmpresa +
  //          ' and trim(coalesce(clientes_contato.email, '''')) <> '''' ' +
            IfThen(vHabKentro,
              ' union ' +
              ' select ' +
              ' ''WHATSAPP'' aplicativo, ' +
              ' clientes_contato.contato, ' +
              ' clientes_contato.telefone as identificador, ' +
              ' ''S'' aceita, ' +
              ' case when ((select count(*) from clientes_contato_env ' +
              '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
              '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
              '             and clientes_contato_env.origem_env ' + IfThen(pOrigem = cContrato, ' = ', ' <> ') + QuotedStr(OrigemEnvStr[cContrato]) +
              '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
              ' from clientes_contato ' +
              ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
              ' and clientes_contato.cod_empresa = ' + codEmpresa +
              ' and trim(coalesce(clientes_contato.telefone, '''')) <> '''' ', '') +
            ' order by 1, 3 ', Con.QrAux);

            Con.QrAux.First;
            while not Con.QrAux.Eof do
            begin
              vIdentificacao := trim(Con.QrAux.FieldByName('identificador').AsString);
              vEmail := '';

              vStringListIdentificacao.Clear;
              if trim(Con.QrAux.FieldByName('aplicativo').AsString) = 'E-MAIL' then
              begin
                for I := 1 to Length(vIdentificacao) do
                begin
                  if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
                  begin
                    if _ValidarEMail(trim(vEmail)) then
                      vStringListIdentificacao.Add(trim(vEmail));
                    vemail := '';
                  end
                  else
                    vemail := vemail + vIdentificacao[I];
                end;
                if _ValidarEMail(trim(vEmail)) then
                  vStringListIdentificacao.Add(trim(vEmail));
              end
              else if _ValidarCelular(trim(vIdentificacao)) then
                vStringListIdentificacao.Add(vIdentificacao);

              for I := 0 to vStringListIdentificacao.Count - 1 do
              begin
                pCheckListBox.Items.Add(
                  trim(Con.QrAux.FieldByName('aplicativo').AsString) + ' - ' +
                  StringReplace(trim(Con.QrAux.FieldByName('contato').AsString), '-', ' ', [rfReplaceAll]) + ' - ' +
                  trim(vStringListIdentificacao[I]) +
                  IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) = '',
                    ' -> Contato não aceito pelo cliente ',
                      IfThen(trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S', ' -> Contato ainda não foi aceito pelo cliente ', ''))
                );

                if trim(Con.QrAux.FieldByName('aceita').AsString) <> 'S' then
                	pCheckListBox.ItemEnabled[pCheckListBox.Items.Count - 1] := False
                else if trim(Con.QrAux.FieldByName('sel').AsString) = 'S' then
                  pCheckListBox.Checked[pCheckListBox.Items.Count - 1] := True;
              end;

              Con.QrAux.Next;
            end;
        finally
          if Assigned(vStringListIdentificacao) then
            FreeAndNil(vStringListIdentificacao);
        end;
      end;

    except on E: Exception do
      begin
        Application.MessageBox(pchar('Falha ao retorna lista de contatos cliente.'), 'Erro', MB_ICONERROR + MB_OK);
        registraErro('Falha ao retorna lista de contatos cliente:' + E.Message);
      end;
    end;
  finally
  	if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

function TSingleton.montarParcelamento(
	query: TIBQuery;
  var pNumDoc: arraystring;
  var pDataVenc: arraystring;
  var pValor: arrayextended;
  pNumeroVenda: string;
  pValorDoc: Extended;
  pCodigoCliente: Integer;
  pCondPag: string;
  vQtdeParc: integer = 0;
  pInteracaoUsuario: string = 'S';
  pDataBase: string = '';
  pSilent: Boolean = False): boolean;
const
  numeros = ['0'..'9'];
var
  temp: string;
  diaVenc, i, j, k, incDias: integer;
  dias: array of integer;
  dataTemp: TDate;
  condicaoPagamento: string;
  vQtde: Integer;
  vAnoTemp, vMesTemp, vDiaTemp : Word;

  procedure limpaParcelamento;
  begin
   SetLength(pValor, 0);
   SetLength(pNumDoc, 0);
   SetLength(pDataVenc, 0);
  end;

  function RemoveAcentos(Texto: String): String;
  Const
  	ComAcento = 'àâêôûãõáéíóúçüÀÂÊÔÛÃÕÁÉÍÓÚÇÜ';
    SemAcento = 'aaeouaoaeioucuAAEOUAOAEIOUCU';
  var iFor : Integer;
  begin
    for iFor := 1 to Length(Texto) do begin
    	if Pos(Texto[iFor],ComAcento) <> 0 then begin
      	Texto[iFor] := SemAcento[Pos(Texto[iFor],ComAcento)];
      end;
    end;
    Result := Texto;
	end;

  procedure ArredondaParcela(Valor: Currency; Quant: Integer);
  var
    resto, vr: Currency;
    i: Integer;
  begin
    vr := 0;
    for i := 0 to Length(pValor) - 1 do
    begin
      if (vTipoParcelamento = 'T1') or (vTipoParcelamento = 'TN') then
        pValor[i] := Trunc(valor / quant)
      else
        pValor[i] := StrToFloatFormat(( 0.01 * Trunc((valor / quant)*100) ) , 2);
    end;
    if vTipoParcelamento = 'T1' then
      pValor[0] := StrToFloatFormat(pValor[0] + (valor - (pValor[0] * quant)), 2)
    else if (vTipoParcelamento = 'TN') and (pValor[0] > 0) then //Caso a primeira parcela fique zerado o valor vai pra ela para ser o proximo vencimento
      pValor[Length(pValor) - 1] := StrToFloatFormat(pValor[Length(pValor) - 1] + (valor - (pValor[Length(pValor) - 1] * quant)), 2)
    else if (vTipoParcelamento = 'IN') then
      pValor[Length(pValor) - 1] := StrToFloatFormat(pValor[0] + (valor - (pValor[0] * quant)), 2)
    else
      pValor[0] := StrToFloatFormat(pValor[0] + (valor - (pValor[0] * quant)), 2);
  end;

begin
  try
    condicaoPagamento := '';
    limpaParcelamento;
    SetLength(dias, 0);
    SetLength(dias, 99);

    if Pos('X', UpperCase(pCondPag)) > 0 then
    begin
      try
        J := StrToInt(Trim(copy(pCondPag, 1, Pos('X', UpperCase(pCondPag)) - 1)));
        vQtdeParc := J;
      except
      end;
    end;

    if vQtdeParc > 0 then
      pCondPag := 'NENHUMA';

    if RemoveAcentos(UpperCase(trim(pCondPag))) = 'A VISTA' then
    begin
      result := false;
      Application.MessageBox('Condição A Vista!', 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if vQtdeParc > 0 then
    begin
      condicaoPagamento := IntToStr(vQtdeParc) + 'X';
      temp := '';

      query.close;
      query.SQL.Text := 'select dia_venc as valor from clientes where cod_cliente  = ' +
       IntToStr(pCodigoCliente) + ' and cod_empresa = ' + codEmpresa;
      query.Prepare;
      query.Open;

      if query.FieldByName('valor').AsInteger > 0 then
       temp := query.FieldByName('valor').AsString;

      if (temp = '') or (temp = '0') then
      begin
        if (vParcelamentoDiaBase <> 'S') or (pInteracaoUsuario = 'N') then
          temp := IntToStr(DayOf(date))
        else
          if not InputQuery('Todo Dia', 'Dia de Vencimento:', temp) then
          begin
            result := false;
            exit;
          end;
      end;

      diaVenc := StrToInt(temp);
      vQtde := vQtdeParc;
    end
    else if RemoveAcentos(UpperCase(trim(pCondPag))) = 'NENHUMA' then
    begin
      result := false;
      if not pSilent then
      	Application.MessageBox('Nenhuma condição de pagamento informada!', 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end
    else if trim(pCondPag) <> '' then
    begin
      incDias := 0;
      temp := '';
      i := 0;
      k := Length(pCondPag);
      while i <> k do
      begin
        temp := '';
        inc(i);
        for j := i to k do
        begin
          if pCondPag[j] in numeros then
            temp := temp + pCondPag[j]
          else
            break;
        end; //fim for j
        i := j;

        try
          if temp <> '' then
          begin
            if StrToInt(temp) > 0 then
            begin
              dias[incDias] := StrToInt(temp);
              Inc(incDias);
            end;
          end;
        except
        end;
        if (i - 1) = k then
          Break;
      end; //fim for i
      vQtde := incDias;
    end; //fim else

    if (pValorDoc / vQtde) < 0.01 then
    begin
    	if not pSilent then
      	Application.MessageBox('Parcela gerada menor que 0,01 com o valor informado e a quantidade de parcelas!', 'Atenção', 0 + 64);
      Result := False;
      Exit;
    end;

    SetLength(pValor, vQtde);
    SetLength(pNumDoc, vQtde);
    SetLength(pDataVenc, vQtde);
    ArredondaParcela(pValorDoc, vQtde);

    for i := 0 to vQtde - 1 do
      pNumDoc[I] := StrZero(pNumeroVenda, 6) + '-' + IntToStr(I + 1);
    if trim(pDataBase) = '' then
	   dataTemp := getDataBanco(query)
    else
    begin
    	dataTemp := StrToDate(pDataBase);
      DecodeDate(dataTemp, vAnoTemp, vMesTemp, vDiaTemp);
      diaVenc := vDiaTemp;
    end;
    if vQtdeParc > 0 then
    begin
      for i := 0 to vQtde - 1 do
      begin
        if vParcelamentoDiaBase = 'S' then
        begin
          if trim(pDataBase) = '' then
          begin
            if IsValidDate(YearOf(IncMonth(dataTemp, I + 1)), MonthOf(IncMonth(dataTemp, I + 1)), diaVenc) then
              pDataVenc[i] := DateToStr(StartOfTheMonth(IncMonth(dataTemp, I + 1)) + diaVenc - 1)
            else
              pDataVenc[i] := DateToStr(EndOfTheMonth(IncMonth(dataTemp, I + 1)));
          end
          else
          begin
            if IsValidDate(YearOf(IncMonth(dataTemp, I + 1)), MonthOf(IncMonth(dataTemp, I + 1)), diaVenc) then
              pDataVenc[i] := DateToStr(StartOfTheMonth(IncMonth(dataTemp, I)) + diaVenc - 1)
            else
              pDataVenc[i] := DateToStr(EndOfTheMonth(IncMonth(dataTemp, I)));
          end;
          IncMonth(dataTemp, 1);
        end
        else
          pDataVenc[i] := DateToStr(dataTemp + (i * 30));
      end;
    end
    else
    begin
      for i := 0 to vQtde - 1 do
        pDataVenc[i] := DateToStr(dataTemp + dias[i]);
    end;
//    frmFormPag2.ListBox1.Clear;
//    for I := 0 to vQtde - 1 do
//      frmFormPag2.ListBox1.Items.Add(vDocumento[I] + '    ' + vData[I] + '           ' +  Format('%m',  [vValor[I]]));
    result := true;
  except
    on e: exception do
    begin
      result := false;
      Application.MessageBox(pchar('EFPG0019 Erro ao gerar parcelas. Erro: ' + e.Message),
        'Informação', MB_OK + MB_ICONINFORMATION);
      registraErro('EFPG0019 ' + e.Message);
    end;
  end;
end;

procedure TSingleton.carregarUnidades(
	pBuscas: TIBQuery;
  var pDbCombobox: TDBComboBox;
  pHabilitar: Boolean = False;
  pUnidade: string = '';
  pUnidadeEmBranco: Boolean = False);
var
	I: Integer;
begin
	pDbCombobox.Enabled := pHabilitar;
	pDbCombobox.Clear;

  if pUnidadeEmBranco then
  	pDbCombobox.Items.Add('');

  SqlOpen(' select sigla from unidades ' +
    ' order by sigla ', pBuscas).FetchAll;

  pBuscas.First;
  while not pBuscas.Eof do
  begin
    pDbCombobox.Items.Add(UpperCase(trim(pBuscas.FieldByName('sigla').AsString)));

    pBuscas.Next;
  end;

  if trim(pUnidade) <> '' then
  begin
    for I := 0 to pDbCombobox.Items.Count - 1 do
      if UpperCase(trim(pDbCombobox.Items[I])) = UpperCase(trim(pUnidade)) then
      begin
      	pDbCombobox.ItemIndex := I;
        Break;
      end;
  end;
end;

procedure TSingleton.mostraColunas(cdsColunas: TClientDataSet; DBGrid: TDBGrid; usuario, nomeDTSEt, vTabela, vCampoPadrao: string);
var
  Settings: TIniFile;
  i, idx, j, menor: integer;
  temp: string;
begin

  cdsColunas.IndexFieldNames := 'USUARIO;CAMPOS';
  try
    if cdsColunas = nil then
      exit;
    if DBGrid.DataSource = nil then
      exit;
    if not cdsColunas.IsEmpty then
    begin
      for I := 0 to TClientDataSet(DBGrid.DataSource.DataSet).FieldCount - 1 do
      begin
        cdsColunas.FindNearest([usuario,
          cripSettings(TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Name)]);
        if (cdsColunas.FieldByName('campos').AsString =
          cripSettings(TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Name)) and
          ((trim(cdsColunas.FieldByName('USUARIO').AsString)) = trim(usuario)) then
        begin
          if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 0) or (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 3) then
            TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible :=
              (cdsColunas.FieldByName('visivel').AsInteger = 1)
          else if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 1) then
            TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := false
          else if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 2) then
            TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := true;
        end;
      end;
    end
    else
    begin
      for I := 0 to TClientDataSet(DBGrid.DataSource.DataSet).FieldCount - 1 do
      begin
        if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 0) then
          TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := True
        else if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 1) then
          TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := False
        else if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 2) then
          TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := True
        else if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Tag = 3) then
          TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Visible := false;
      end;
    end;

    if not cdsColunas.IsEmpty then
    begin
      temp := cdsColunas.IndexFieldNames;
      cdsColunas.IndexFieldNames := 'USUARIO;COMPONENTE;ORDEM';
      cdsColunas.First;
      cdsColunas.FindNearest([trim(usuario), nomeDTSEt, cdsColunas.FieldByName('ordem').AsInteger]);
      while not cdsColunas.Eof do
      begin
        if cdsColunas.FieldByName('ordem').AsInteger > -1 then
          for I := TClientDataSet(DBGrid.DataSource.DataSet).FieldCount - 1 downto 0 do
            if (TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Name =
              cdsColunas.FieldByName('campos').AsString) and
              ((trim(cdsColunas.FieldByName('USUARIO').AsString)) = trim(usuario)) then
            begin
              TClientDataSet(DBGrid.DataSource.DataSet).Fields[i].Index :=
                cdsColunas.FieldByName('ordem').AsInteger;
              Break;
            end;
        cdsColunas.Next;
        if cdsColunas.FieldByName('componente').AsString <> nomeDTSEt then
          Break;
      end;
      cdsColunas.IndexFieldNames := temp;
    end;
  finally
  end;
end;

