function TSingleton._converterTags(pDados, pRtfHtml: string): string;
var
  Tamanho, Contador, FixoInicial, FixoFinal: Integer;
  VariavelMacro, ValorMacro: string;
  CaracterIniOld, CaracterFimOld: string;
  CaracterIniNew, CaracterFimNew: string;
begin
  Tamanho := length(pDados);
  FixoInicial := 0;
  FixoFinal := 0;
  Contador := 0;

  if pRtfHtml <> 'R' then
  begin
    pDados := StringReplace(pDados, '&lt;*', '<*', [rfReplaceAll, rfIgnoreCase]);
    pDados := StringReplace(pDados, '&lt;#', '<#', [rfReplaceAll, rfIgnoreCase]);
    pDados := StringReplace(pDados, '&gt;', '>', [rfReplaceAll, rfIgnoreCase]);
  end;

  CaracterIniOld := IfThen(pRtfHtml = 'R', '{', '<');
  CaracterFimOld := IfThen(pRtfHtml = 'R', '}', '>');
  CaracterIniNew := IfThen(pRtfHtml = 'R', '<', '{');
  CaracterFimNew := IfThen(pRtfHtml = 'R', '>', '}');

  while Contador < Tamanho do
  begin
    if (pDados[Contador] = CaracterIniOld) and ((pDados[Contador + 1] = '#') or (pDados[Contador + 1] = '*')) then
    begin
      FixoInicial := Contador + 2;
    end;
    if (pDados[Contador] = CaracterFimOld) and (FixoInicial > 0) then
    begin
      FixoFinal := Contador;
      VariavelMacro := copy(pDados, FixoInicial, (FixoFinal - FixoInicial));
      if VariavelMacro = 'INI' then
        ValorMacro := '\INI'
      else
        ValorMacro := trim(VariavelMacro);
      //O novo Valor para os pDados já tirado a macro
      if trim(ValorMacro) <> '' then
        pDados := Copy(pDados, 1, FixoInicial - 3) + CaracterIniNew + '*' + ValorMacro + CaracterFimNew +
          Copy(pDados, FixoFinal + 1, (Tamanho - FixoFinal + 1));
      Tamanho := length(pDados);
      Contador := 0;
      FixoInicial := 0;
      FixoFinal := 0;
    end
    else
      Inc(Contador);
  end;
  Result := pDados;
end;

function TSingleton._converterTagsImage(pDados: string;
  pBuscas: TIBQuery; pMD5toBase64: boolean): string;
var
	vExtensao, vBase64, vMD5: string;
  vIndex: Integer;
  vPos: Integer;
  vStrIni, vStrFim: string;
begin
	Result := pDados;
  registraErro(Result);

  if not pMD5toBase64 then
  begin
  	if pos(';base64,', Result) > 0 then
    begin
      while pos(';base64,', Result) > 0 do
      begin
        vIndex := pos(';base64,', Result) + length(';base64,');
        vPos := pos('">', Result) - vIndex;

        vBase64 := Copy(Result, vIndex, vPos);
        vMD5 := Sign_RSA_MD5_SomenteTexto(vBase64);

        if  pos('<IMG src="data:image/', Result) > 0 then
	        vIndex := pos('<IMG src="data:image/', Result) + length('<IMG src="data:image/')
        else
        	vIndex := pos('<img src="data:image/', Result) + length('<img src="data:image/');
        vPos := pos(';base64,', Result) - vIndex;

        vExtensao := Copy(Result, vIndex, vPos);

        pBuscas.Close;
        pBuscas.SQL.Text := ' UPDATE OR INSERT INTO IMAGE_BASE64 (MD5, BASE64, EXTENSAO) ' +
          ' VALUES (:MD5, :BASE64, :EXTENSAO) ' +
          ' MATCHING (MD5); ';
        pBuscas.ParamByName('MD5').AsString := vMD5;
        pBuscas.ParamByName('BASE64').AsString := vBase64;
        pBuscas.ParamByName('EXTENSAO').AsString := vExtensao;
        pBuscas.ExecSQL;

        if pos('<IMG src="data:image/', Result) > 0 then
	        vIndex := pos('<IMG src="data:image/', Result) - 1
        else
        	vIndex := pos('<img src="data:image/', Result) - 1;
        vPos := pos('">', Result);

        vStrIni := Copy(Result,	1, vIndex);
        vStrFim := Copy(Result, vPos + Length('">'), Length(Result) - (vIndex));

        Result := vStrIni + vMD5 + vStrFim;
      end;
      if pBuscas.Transaction.InTransaction then
        pBuscas.Transaction.Commit;
    end;
  end
  else
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select * from image_base64 ';
    pBuscas.Open;

    pBuscas.First;
    while not pBuscas.Eof do
    begin
      Result := StringReplace(Result,
        pBuscas.FieldByName('MD5').AsString,
        '<img src="data:image/' + pBuscas.FieldByName('EXTENSAO').AsString + ';base64,' +
        pBuscas.FieldByName('BASE64').AsString +
        '">', [rfReplaceAll]);

      pBuscas.Next;
    end;
  end;
end;

