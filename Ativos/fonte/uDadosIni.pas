          if (trim(pBuscas.FieldByName('PADRAO_VENDA').AsString) = 'S') then
          begin
          	pCombobox.ItemIndex := pCombobox.Items.Count - 1;
          	vUnidadePadrao := UpperCase(trim(pBuscas.FieldByName('UNIDADE').AsString));
          end;
        end;

        pBuscas.Next;
      end;
    end;

    for I := 0 to pCombobox.Items.Count - 1 do
    	if IfThen(trim(pUnidade) <> '', UpperCase(trim(pUnidade)), UpperCase(trim(vUnidadeProd))) = UpperCase(trim(pCombobox.Items[I])) then
