             ' WHERE COD_SETOR = :COD_SETOR AND COD_EMPRESA = :COD_EMPRESA ';
           buscas4.ParamByName('COD_SETOR').AsInteger := vCodSetor;
           buscas4.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
