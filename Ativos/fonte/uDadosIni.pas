procedure TSingleton.selUnselContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
begin
  try
    if pCodCliente <= 0 then
      Exit;

    if pCheckListContato.ItemIndex < 0 then
    	Exit;

    if not pCheckListContato.ItemEnabled[pCheckListContato.ItemIndex] then
    	Exit;

    if pCheckListContato.Checked[pCheckListContato.ItemIndex] then
      if not permiteSelecionarContato(pCodCliente, pOrigem, pCheckListContato) then
        pCheckListContato.Checked[pCheckListContato.ItemIndex] := False;

    if not vDadosIni.inserirRemoverContatoEnv(
      pCodCliente,
      pOrigem,
      pCheckListContato) then
        pCheckListContato.Checked[pCheckListContato.ItemIndex] := False;
  except on E: Exception do
    begin
      registraErro('TSingleton.selUnselContatoCliente. Erro: ' + E.Message);
      Application.MessageBox(PChar('Erro ao marcar/desmarcar todos contato. Erro: ' + e.Message),
        'Erro', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TSingleton.senhaGerente(vCodProcesso: string;
  qrBusca: TIBQuery): boolean;
begin
  try
    qrBusca.Close;
    qrBusca.SQL.Text :=
      'select NIVEL_PROCESSO,NOME_PROCESSO from TABELA_PROCESSOS where COD_PROCESSO = ' +
      quotedstr(vCodProcesso) +
      ' AND COD_EMPRESA = ' + CodEmpresa + ' AND ATIVO = 1 and SENHA_GERENTE=''S''';
    qrBusca.open;
    if not qrBusca.IsEmpty then
      result := true
    else
      result := false;
  except
    result := false;
  end;
end;

