procedure TSingleton.verificarCTP_Pendentes_Unificacao(cQuery: TIBQuery; cCodEmpresa: Integer = 0; cComitar: boolean = true);
var
  buscas2: TIBQuery;
  I: Integer;
  vregistroAtualizado: boolean;
  vsql, vcampos, vparametros: string;
begin
  if not vEmp.vFinanceiroUnificado then  // SOMENTE SE O FINANCEIRO ESTIVER UNIFICADO
    Exit;

  if vEmp.vCodigoUnificadora <> StrToIntDef(codEmpresa, 0) then  // SOMENTE SE A EMPRESA LOGADA FOR A UNIFICADORA
    Exit;

  if vCodEmpresaFisica <> StrToIntDef(codEmpresa, 0) then  // SOMENTE SE A EMPRESA FISICA TAMBEM FOR A UNIFICADORA
    Exit;

  vregistroAtualizado := false;

  try
    if cCodEmpresa <= 0 then
    	abreStatusProcessamento('Status de Processamento', 'Verificando contas a pagar pendentes de unificação');

    buscas2 := TIBQuery.Create(Application);
 		buscas2.Database := cQuery.Database;
	  buscas2.Transaction := cQuery.Transaction;

    cQuery.Close;
    cQuery.SQL.Text :=
      'select ctp.* from contas_a_pagar ctp' +
      ' where ctp.codigo_emp in ' + vEmp.vCodigoUnificadas +
      ' and ctp.datq_ctp is null';

    if (cCodEmpresa > 0) then
    	cQuery.SQL.Text := cQuery.SQL.Text + ' and ctp.codigo_emp = ' + IntToStr(cCodEmpresa)
    else
      cQuery.SQL.Text := cQuery.SQL.Text + ' and ctp.codigo_emp <> ' + codEmpresa;
    cQuery.Open;
    cQuery.FetchAll;

    cQuery.First;
    while not cQuery.Eof do
    begin
      vregistroAtualizado := true;

      if cCodEmpresa <= 0 then
	      abreStatusProcessamento('Status de Processamento', 'Unificando contas a pagar pendentes. ' + IntToStr(cQuery.RecNo) + ' de ' + IntToStr(cQuery.RecordCount) );
      Application.ProcessMessages;

      vsql := '';
      vcampos := '';
      vparametros := '';
      for i := 0 to cQuery.Fields.Count - 1 do
      begin
        vcampos := vcampos + cQuery.Fields[i].FieldName + ',';
        if (UpperCase(trim(cQuery.Fields[I].FieldName)) = 'COD_CONTRP') then
        	vparametros := vparametros + ' (select cod from incrementa_codigo(' + codEmpresa + ', ''CONTAS_A_PAGAR'')),'
        else
        	vparametros := vparametros + ':' + cQuery.Fields[i].FieldName + ',';
    	end;

      vcampos := Copy(vcampos, 0, Length(vcampos) - 1);
      vparametros := Copy(vparametros, 0, Length(vparametros) - 1);

      vsql := 'insert into contas_a_pagar (' + vcampos + ')' +
      	' values ( ' + vparametros + ');';

      try
        buscas2.Close;
        buscas2.SQL.Text := vsql;
        for i := 0 to cQuery.Fields.Count - 1 do
    		begin
          if (UpperCase(trim(cQuery.Fields[I].FieldName)) <> 'CODIGO_EMP')
          	and (UpperCase(trim(cQuery.Fields[I].FieldName)) <> 'COD_CONTRP') then
            	buscas2.ParamByName(cQuery.Fields[i].FieldName).Value :=
              	cQuery.FieldByName(cQuery.Fields[I].FieldName).Value;
        end;
        buscas2.ParamByName('codigo_emp').Value := codEmpresa;
        buscas2.ExecSQL;

        buscas2.Close;
        buscas2.SQL.Text := ' delete from contas_a_pagar ' +
          ' where cod_contrp = ' + IntToStr(cQuery.FieldByName('cod_contrp').AsInteger) +
          ' and codigo_emp = ' + IntToStr(cQuery.FieldByName('codigo_emp').AsInteger);
        buscas2.ExecSQL;
//      buscas2.Close;
//      buscas2.SQL.Text := 'update contas_a_pagar set cod_contrp = (select cod from incrementa_codigo(' + codEmpresa + ', ''CONTAS_A_PAGAR''))' +
//        ', codigo_emp = ' + codEmpresa +
//        ', cod_emp_mult = ' + getCampoPipe(vLista[I], 2) +
//        ' where cod_contrp = ' + getCampoPipe(vLista[I], 1) +
//        ' and codigo_emp = ' + getCampoPipe(vLista[I], 2);
//      try
//        buscas2.ExecSQL;
      except
        on e: Exception do
        begin
          registraErro('procedure TSingleton.verificarCTP_Pendentes_Unificacao. Erro' + e.Message + ' SQL: ' + buscas2.SQL.Text);
        end;
      end;
      cQuery.Next;
    end;

    if ((vregistroAtualizado) and (cComitar)) then
      if buscas2.Transaction.InTransaction then
        buscas2.Transaction.Commit;

  finally
    fechaStatusProcessamento;
  end;
end;

