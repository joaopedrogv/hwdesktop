function TSingleton.retornaPlacaNovaAntiga(pPlaca: string): string;
var
	I: Integer;
	vQtdeDig: Integer;
	vPlacaOld: string;
  vPlacaNew: string;
  vTemp: string;
begin
	vPlacaOld := '';
  vPlacaNew := '';
  vQtdeDig := 0;
  
  if Length(trim(apenasLetraseNumeros(pPlaca))) <= 4 then
  begin
    Result := pPlaca;
    exit;
  end;

  for I := 1 to Length(pPlaca) do
  begin
  	vPlacaOld := vPlacaOld + pPlaca[i];
  	if trim(apenasLetraseNumeros(pPlaca[I])) <> '' then
    	vQtdeDig := vQtdeDig + 1;
    if vQtdeDig >= 5 then
    	break;
  end;

  vPlacaNew := Copy(vPlacaOld, 1, Length(vPlacaOld) - 1);
  vtemp := Copy(vPlacaOld, Length(vPlacaOld), 1);

  if vtemp = 'A' then
  	vPlacaNew := vPlacaNew + '0'
  else if vtemp = 'B' then
    vPlacaNew := vPlacaNew + '1'
  else if vtemp = 'C' then
    vPlacaNew := vPlacaNew + '2'
  else if vtemp = 'D' then
    vPlacaNew := vPlacaNew + '3'
  else if vtemp = 'E' then
    vPlacaNew := vPlacaNew + '4'
  else if vtemp = 'F' then
    vPlacaNew := vPlacaNew + '5'
  else if vtemp = 'G' then
    vPlacaNew := vPlacaNew + '6'
  else if vtemp = 'H' then
    vPlacaNew := vPlacaNew + '7'
  else if vtemp = 'I' then
    vPlacaNew := vPlacaNew + '8'
  else if vtemp = 'J' then
    vPlacaNew := vPlacaNew + '9'
  else if vtemp = '0' then
    vPlacaNew := vPlacaNew + 'A'
  else if vtemp = '1' then
    vPlacaNew := vPlacaNew + 'B'
  else if vtemp = '2' then
    vPlacaNew := vPlacaNew + 'C'
  else if vtemp = '3' then
    vPlacaNew := vPlacaNew + 'D'
  else if vtemp = '4' then
    vPlacaNew := vPlacaNew + 'E'
  else if vtemp = '5' then
    vPlacaNew := vPlacaNew + 'F'
  else if vtemp = '6' then
    vPlacaNew := vPlacaNew + 'G'
  else if vtemp = '7' then
    vPlacaNew := vPlacaNew + 'H'
  else if vtemp = '8' then
    vPlacaNew := vPlacaNew + 'I'
  else if vtemp = '9' then
    vPlacaNew := vPlacaNew + 'J'
  else
    vPlacaNew := vPlacaNew + vtemp;

  Result := StringReplace(trim(pPlaca), trim(vPlacaOld), trim(vPlacaNew), [rfReplaceAll]);
end;

function TSingleton.retornaImagens(
	pBuscas: TIBQuery;
  pGrupoProd: Integer;
  pCodProd: string;
  var pListaImagens: string;
  var pListaUrl: string): boolean;
begin
	try
  	Result := True;

    pListaImagens := '';
    pListaUrl     := '';

    pBuscas.Close;
    pBuscas.SQL.Text := ' select prec_tab_prod, prec_publico, lista_imagens, null url_imagens from produtos ' +
      ' where grupo_prod = :grupo_prod ' +
      ' and cod_prod = :cod_prod ' +
      ' and cod_empresa = :cod_empresa ';
    pBuscas.ParamByName('grupo_prod').AsInteger := pGrupoProd;
    pBuscas.ParamByName('cod_prod').AsString := pCodProd;
    pBuscas.ParamByName('cod_empresa').AsString := codEmpresa;
    pBuscas.Open;

    if trim(pBuscas.FieldByName('lista_imagens').AsString) <> '' then
    begin
      pListaImagens := pBuscas.FieldByName('lista_imagens').AsString;
      pListaUrl     := pBuscas.FieldByName('url_imagens').AsString;
    end
    else
    begin
      pBuscas.Close;
      pBuscas.SQL.Text := ' select img.imagem, img.url from produtos_grade_imagens pimg ' +
        ' inner join imagens_doc img on ' +
        '		img.cod_img = pimg.cod_img and img.cod_empresa = pimg.cod_empresa ' +
        ' where pimg.grupo_prod = :grupo_prod ' +
        ' and pimg.cod_prod = :cod_prod ' +
        ' and pimg.cod_empresa = :cod_empresa ' +
        ' order by pimg.grupo_prod, pimg.cod_prod, pimg.cod_empresa, pimg.cod_grade, img.cod_img ';
      pBuscas.ParamByName('GRUPO_PROD').AsInteger := pGrupoProd;
      pBuscas.ParamByName('COD_PROD').AsString := pCodProd;
      pBuscas.ParamByName('COD_EMPRESA').AsInteger := cod_empresa;
      pBuscas.Open;

      pBuscas.First;
      while not pBuscas.Eof do
      begin
      	if trim(pBuscas.FieldByName('imagem').AsString) <> '' then
        begin
          if trim(pListaImagens) = '' then
            pListaImagens := trim(pBuscas.FieldByName('imagem').AsString)
          else
            pListaImagens := pListaImagens + #13 + trim(pBuscas.FieldByName('imagem').AsString);

          if trim(pListaUrl) = '' then
            pListaUrl := trim(pBuscas.FieldByName('url').AsString)
          else
            pListaUrl := pListaUrl + #13 + trim(pBuscas.FieldByName('url').AsString);
        end;

        pBuscas.Next;
      end;
    end;

  except on E: Exception do
    begin
      Application.MessageBox(pchar(
        'Falha ao retorna imagens. Erro: ' + e.Message), pchar('Erro'), MB_ICONERROR + MB_OK);
      registraErro('Falha ao retorna imagens. Erro: ' + E.Message);
      Result := False;
    end;
  end;
end;

function TSingleton.retornaProdutosAcabado(pBuscas: TIBQuery;
  pGrupoProd: Integer; pCodProd: string): boolean;
begin
	Result := False;

	vDtSetTmpProducao := TClientDataSet.Create(nil);
  vDtSetTmpProducao.Close;
  vDtSetTmpProducao.FieldDefs.Clear;
  vDtSetTmpProducao.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
  vDtSetTmpProducao.FieldDefs.Add('COD_PROD', ftString, 6, false);
  if vDtSetTmpProducao.Tag = 0 then
  try
    vDtSetTmpProducao.CreateDataSet;
    vDtSetTmpProducao.Tag := 1;
  except
  end;

  vDtSetTmpProducao.EmptyDataSet;

	pBuscas.Close;
  pBuscas.SQL.Text := ' select distinct ind.grupo_prod_acabado as grupo_prod, ' +
  	' ind.cod_prod_acabado as cod_prod from indice_tecnico ind ' +
    ' inner join produtos pr on ' +
    '		pr.grupo_prod = ind.grupo_prod_acabado ' +
    '   and pr.cod_prod = ind.cod_prod_acabado ' +
    '   and pr.cod_empresa = ind.cod_empresa ' +
    ' where ind.grupo_prod_mprima = ' + IntToStr(pGrupoProd) +
    ' and ind.cod_prod_mprima = ' + QuotedStr(pCodProd) +
    ' and ind.cod_empresa = ' + codEmpresa +
    ' and pr.criar_producao_aut = ''S'' ';
  pBuscas.Open;
  pBuscas.FetchAll;

  pBuscas.First;
  while not pBuscas.Eof do
  begin
    vDtSetTmpProducao.Insert;
    vDtSetTmpProducao.FieldByName('GRUPO_PROD').AsInteger := pBuscas.FieldByName('GRUPO_PROD').AsInteger;
    vDtSetTmpProducao.FieldByName('COD_PROD').AsString := pBuscas.FieldByName('COD_PROD').AsString;
    vDtSetTmpProducao.Post;

  	pBuscas.Next;
  end;

  Result := True;
end;

procedure TSingleton.RetornarEstoquePrecoCusto(buscas, buscas2: TIBQuery; vDataReferencia: string;
  vGrupoProd: Integer; vCodProd: string; vExisteGrade: Boolean; var vGradeP: Boolean; var vest: Double; var vprC: Double);
var
 vDatatemp: TDate;
begin
  vest := 0.00;
  vprC := 0;

  buscas2.close;
   if vExisteGrade then
   begin
     buscas2.SQL.Text := ' SELECT DISTINCT CC.GRUPO_PROD, CC.COD_PROD, CC.COD_GRADE FROM COD_GRADE_PROD_COMPRA CC ' +
      ' INNER JOIN GRADE GR ON CC.COD_GRADE = GR.COD_GRADE AND CC.COD_EMPRESA = GR.COD_EMPRESA ' +
      ' WHERE CC.GRUPO_PROD = :GRUPO_PROD AND CC.COD_PROD = :COD_PROD AND CC.COD_EMPRESA = :COD_EMPRESA AND GR.COD_GRADE > 0' +
      ' UNION ' +
      ' SELECT DISTINCT PD.GRUPO_PROD, PD.COD_PROD, PD.COD_GRADE FROM PEDVENDA_PROD PD ' +
      ' INNER JOIN GRADE GR ON PD.COD_GRADE = GR.COD_GRADE AND PD.COD_EMPRESA = GR.COD_EMPRESA ' +
      ' WHERE PD.GRUPO_PROD = :GRUPO_PROD AND PD.COD_PROD = :COD_PROD AND PD.COD_EMPRESA = :COD_EMPRESA AND GR.COD_GRADE > 0 ' +
      ' UNION ' +
      ' SELECT DISTINCT CP.GRUPO_PROD, CP.COD_PROD, CP.COD_GRADE FROM COD_GRADE_PROD CP ' +
      ' INNER JOIN GRADE GR ON CP.COD_GRADE = GR.COD_GRADE AND CP.COD_EMPRESA = GR.COD_EMPRESA ' +
      ' WHERE CP.GRUPO_PROD = :GRUPO_PROD AND CP.COD_PROD = :COD_PROD AND CP.COD_EMPRESA = :COD_EMPRESA AND CP.QTDE > 0 AND GR.COD_GRADE > 0';
     buscas2.ParamByName('GRUPO_PROD').AsInteger := vGrupoProd;
     buscas2.ParamByName('COD_PROD').AsString := vCodProd;
     buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
     buscas2.Open;
     buscas2.FetchAll;
   end;

   vGradeP := false;
   if not buscas2.IsEmpty then
   begin
     buscas2.First;
     vDatatemp := 0;
     while not buscas2.Eof do
     begin
       vGradeP := true;

       buscas.close;
       buscas.SQL.Text := ' select first 1 e.dia, e.estoque, e.custo_medio from estoque_diario e ' +
        ' where e.grupo_prod = :grupo_prod and cod_prod = :cod_prod and cod_grade = :cod_grade ' +
        ' and e.dia <= :vdat1 and e.cod_empresa = :cod_empresa order by e.dia desc, e.seqid desc ';
       buscas.ParamByName('GRUPO_PROD').AsInteger := vGrupoProd;
       buscas.ParamByName('COD_PROD').AsString := vCodProd;
       buscas.ParamByName('COD_GRADE').AsInteger := buscas2.FieldByName('COD_GRADE').AsInteger;
       buscas.ParamByName('VDAT1').AsDate := StrToDate(vDataReferencia);
       buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
       buscas.Open;
       buscas.FetchAll;

       if buscas.IsEmpty then
       begin
         vGradeP := False;
         break;
       end
       else if buscas.FieldByName('ESTOQUE').AsFloat > 0 then
       begin
        vest := vest + buscas.FieldByName('ESTOQUE').AsFloat;
        if buscas.FieldByName('DIA').AsDateTime > vDatatemp  then
        begin
          vprC := buscas.FieldByName('CUSTO_MEDIO').AsFloat;
          vDatatemp := buscas.FieldByName('DIA').AsDateTime;
        end;
       end;
       buscas2.Next;
     end;
   end
   else
   begin
     vGradeP := true;

     buscas.close;
     buscas.SQL.Text := ' select first 1 e.estoque, e.custo_medio from estoque_diario e ' +
      ' where e.grupo_prod = :grupo_prod and e.cod_prod = :cod_prod ' +
      ' and e.dia <= :vdat1 and e.cod_empresa = :cod_empresa order by e.dia desc, e.seqid desc ';
     buscas.parambyName('GRUPO_PROD').AsInteger := vGrupoProd;
     buscas.parambyName('COD_PROD').AsString := vCodProd;
     buscas.parambyName('VDAT1').AsDate := StrToDate(vDataReferencia);
     buscas.parambyName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
     buscas.Open;

     if buscas.FieldByName('ESTOQUE').AsFloat > 0 then
     begin
       vest := buscas.FieldByName('ESTOQUE').AsFloat;
       vprC := buscas.FieldByName('CUSTO_MEDIO').AsFloat;
     end;
   end;
end;

