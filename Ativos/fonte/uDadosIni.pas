function TSingleton.limpardados_boleto(pNossoNumero, RemessaEnviada,
  pRetirarCredito, pCarne, pOutrosDados: boolean;
  pListBoletas: TStringList): boolean;
var
  AProcedure: Tlimpardados_boleto;
begin
  try
    if vBoletos.AHandle = 0 then
      CarregaPacote('pkBoletos', vBoletos.AHandle);

    if vBoletos.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Boletos não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vBoletos.AHandle, 'limpardados_boleto');
    if Assigned(AProcedure) then
      Result := AProcedure(pNossoNumero, RemessaEnviada, pRetirarCredito, pCarne, pOutrosDados, pListBoletas);
  finally
  end;
end;

procedure TSingleton.retornaComboboxAplicativo(
  pCombobox: TCombobox);
var
	Con: TConexao;
begin
	Con := TConexao.Create(dtmAtivo.bancoHw);
  
	try
    try
      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select distinct msg_aplicativo.aplicativo from msg_aplicativo ' +
          ' where msg_aplicativo.id > 0 ' +
          ' and (select count(*) from msg_plataforma ' +
          '		  where msg_plataforma.id_msg_aplicativo = msg_aplicativo.id ' +
          '      and msg_plataforma.cod_empresa = :cod_empresa) <> 0 ' +
          ' order by msg_aplicativo.id ';
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.Open;

        pCombobox.Clear;
        Con.QrAux.First;
        while not Con.QrAux.Eof do
        begin
          pCombobox.Items.Add(trim(Con.QrAux.FieldByName('aplicativo').AsString));

          Con.QrAux.Next;
        end;
      end
      else
      begin
        pCombobox.Items.Add('E-MAIL');

        if trim(retornaDadosKentro(Con.QrAux, False)) <> '' then
          pCombobox.Items.Add('WHATSAPP');
      end;
    except on E: Exception do
      begin
        Application.MessageBox(PChar('Erro ao retorna aplicativo: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao retorna aplicativo: ' + e.Message);
      end;
    end;
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

