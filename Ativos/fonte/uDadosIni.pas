  end;

  try
    Self.vGerarLinkAnexos := trim(conf.ReadString('Configuracao', 'GerarLinkAnexos'));
    
    if (UpperCase(trim(Self.vGerarLinkAnexos)) = 'S') or (UpperCase(trim(Self.vGerarLinkAnexos)) = 'SIM') then
      Self.vGerarLinkAnexos := 'S'
    else
      Self.vGerarLinkAnexos := 'N';
  except
    Self.vGerarLinkAnexos := 'S';
  end;

  try
    Self.vAnexosDocFiscal := '';
    if (ContainsText(LowerCase(trim(conf.ReadString('Configuracao', 'AnexosDocFiscal'))), 'pdf')) then
    	Self.vAnexosDocFiscal := trim(Self.vAnexosDocFiscal) + IfThen(trim(Self.vAnexosDocFiscal) <> '', ',', '') + 'pdf';
    if (ContainsText(LowerCase(trim(conf.ReadString('Configuracao', 'AnexosDocFiscal'))), 'xml')) then
    	Self.vAnexosDocFiscal := trim(Self.vAnexosDocFiscal) + IfThen(trim(Self.vAnexosDocFiscal) <> '', ',', '') + 'xml';

    if trim(Self.vAnexosDocFiscal) = '' then
      Self.vAnexosDocFiscal := 'pdf';
  except
    Self.vAnexosDocFiscal := 'pdf';
  end;

  try
    Self.vExibirAcrescDescPedido := '';
    if (ContainsText(LowerCase(trim(conf.ReadString('Configuracao', 'ExibirAcrescDescPedido'))), 'acrésc')) or (ContainsText(LowerCase(trim(conf.ReadString('Configuracao', 'ExibirAcrescDescPedido'))), 'acresc')) then
      Self.vExibirAcrescDescPedido := trim(Self.vExibirAcrescDescPedido) + IfThen(trim(Self.vExibirAcrescDescPedido) <> '', ',', '') + 'Acrescimo';
    if (ContainsText(LowerCase(trim(conf.ReadString('Configuracao', 'ExibirAcrescDescPedido'))), 'desc')) then
      Self.vExibirAcrescDescPedido := trim(Self.vExibirAcrescDescPedido) + IfThen(trim(Self.vExibirAcrescDescPedido) <> '', ',', '') + 'Desconto';
  except
    Self.vExibirAcrescDescPedido := 'Acrescimo, Desconto';
  end;
end;

end.

