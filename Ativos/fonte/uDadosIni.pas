function TSingleton.PosVirtualGetComprovantes(value: string;
  tagCorte: Boolean): string;
var
  reduzido: Boolean;
  impressao: TStrings;
  I: Integer;
  strvia1, strvia2, tagCut: string;

  function handleComprovante(key: string; ini, fim: Integer): string;
  var
    Z: Integer;
    linha: string;
  begin
    Result := '';
    for Z := ini to fim do
    begin
      linha := TrimLeft(impressao.Values[key + PadL(z, 3) + ' ']);
      if StartsStr('"', linha) then
        System.Delete(linha, 1, 1);
      if EndsStr('"', linha) then
        System.Delete(linha, Length(linha), 1);

      if Trim(impressao.Values[key + PadL(z, 3) + ' ']) <> '' then
        Result := Result + StrUtils.IfThen(Result <> '', sLineBreak) + linha;
    end;
  end;
begin

  reduzido := GetIni('TEF', 'ComprovanteReduzido', 'N') = 'S';

  impressao := NewStringList(False, value);
  try

    strvia1 := '';
    strvia2 := ''; 
    if (reduzido) then
      strvia1 := handleComprovante('711-', 1, StrToIntDef(impressao.Values['710-000 '], 0));

    // quando o comprovante nao é reduzido aí sao duas vias
    if strvia1 = '' then
    begin
      strvia1 := handleComprovante('713-', 1, StrToIntDef(impressao.Values['712-000 '], 0));

      if strvia1 = '' then
        strvia1 := handleComprovante('029-', 1, StrToIntDef(impressao.Values['028-001 '], 0));

      strvia2 := handleComprovante('715-', 1, StrToIntDef(impressao.Values['714-000 '], 0));
      if strvia2 = '' then
        strvia2 := handleComprovante('029-', StrToIntDef(impressao.Values['028-001 '], 0) + 1, StrToIntDef(impressao.Values['028-000 '], 0) );
    end;

    if (strvia1 <> '') and (strvia2 <> '')  then
    begin
      for I := 1 to IniConf.ReadInt('TEF', 'ImpNaoFiscal_LinhasEntreComprovantes', 0) do
        strvia1 := strvia1 + ' ' + sLineBreak;
    end;

    if (strvia1 <> '') then
    begin
      if not tagCorte then
        strvia1 := strvia1 + sLineBreak + '     ** corte aqui **' + sLineBreak
      else
      begin
        if IniConf.ReadStr('TEF', 'ImpNaoFiscal_CorteParcialEntreComprovantes', 'N') = 'S' then
          tagCut := '</corte_parcial>'
        else if IniConf.ReadStr('TEF', 'ImpNaoFiscal_CorteTotalEntreComprovantes', 'S') = 'S' then
          tagCut := '</corte_total>'
        else
          tagCut := '                       --';

        strvia1 := strvia1 + sLineBreak + tagCut + sLineBreak;
        if (strvia2 <> '') then
          strvia2 := strvia2 + sLineBreak + tagCut + sLineBreak;
      end;
    end;

    Result :=  strvia1 + strvia2;
    if Trim(Result) = '' then
      Result := value;

    if IniConf.ReadStr('MD', 'Debug') = 'S' then
      LogApp.Log('tefprint', 'Get' + sLineBreak + Result);
  finally
    impressao.Free;
  end;
end;

procedure TSingleton.PosVirtualGetConfsPrintNaoFiscal(buscas: TIBQuery);
var
  Aconf: TConfig_sistema_class;
  section, ag, ps: string;
begin
  Aconf := TCfg_sis.getConf('pos_virtual_nao_fiscal', buscas, cod_empresa);
  try
  Aconf.AtivarMapeamentoKeys;
  with Aconf do
  begin
    vModoImpressao.AgenteId := '';
    vModoImpressao.PosPrinter := '';
    section := '';

    while (vModoImpressao.AgenteId = '') and (vModoImpressao.PosPrinter = '') do
    begin
      if (vNFConsumidor.CodEmissor > 0) and (section = '') then
        section := 'AgenteNaoFiscal_Caixa_' + PadL(vNFConsumidor.CodEmissor, 3)
      else
        section := 'AgenteNaoFiscal_Usuario_' + PadL(vCodUsuario, 3);

      ag := ReadString(section, 'AgenteId');
      ps := ReadString(section, 'ArquivoIniPosPrinterNaoFiscal');

      if (ag <> '') and (ps <> '') then
      begin
        vModoImpressao.AgenteId := ag;
        vModoImpressao.PosPrinter := ps;
      end;

      if StartsText('AgenteNaoFiscal_Usuario_', section) then
        Break;
    end;

    if vModoImpressao.PosPrinter = '' then
      vModoImpressao.PosPrinter := GetIni('TEF', 'POSPrinter', '');
  end;
  try
    if Aconf.KesyChanges then
      Aconf.SaveConfDB(buscas).Transaction.Commit;
  except 
  end;
  finally
    FreeAndNil(Aconf);
  end;
end;

function TSingleton.produtos_replicacao_interna(AGrupoProd: Integer;
  ACodProd: string; ATransaction: TIBTransaction): boolean;
var
  AProcedure: Tprodutos_replicacao_interna;
  ATransactionRescue: TIBTransaction;
  AUseTransacionIni: Boolean;
begin
  try
    if (Assigned(ATransaction)) and     // transacao do parametro
       (Assigned(vTransactionTmp)) then // transacao do dadosini
      ATransactionRescue := vTransactionTmp; // transacao para recuperar no finally

    if vProduto.AHandle = 0 then
      CarregaPacote('pkProdutos', vProduto.AHandle);

    if vProduto.AHandle = 0 then
    begin
      Application.MessageBox('Pacote CTP não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vProduto.AHandle, 'produtos_replicacao_interna');
    if Assigned(AProcedure) then
    begin
      if Assigned(ATransaction) then
      begin
        vTransactionTmp := ATransaction;
        AUseTransacionIni := True;
      end
      else
        AUseTransacionIni := False;
      AProcedure(AGrupoProd, ACodProd, AUseTransacionIni);

      Result := True;
    end
    else
      raise Exception.Create('Método produtos_replicacao_interna não encontrado no pacote pkProdutos');

  finally
    if Assigned(ATransactionRescue) then
      vTransactionTmp := ATransactionRescue;
  end;
end;

function TSingleton.produtoTemGrade(pBuscas: TIBQuery; pGrupoProd: Integer;
  pCodProd: string): boolean;
begin
	pBuscas.Close;
  pBuscas.SQL.Text := ' select count(*) from cod_grade_prod cgp ' +
  	' where cgp.grupo_prod = ' + IntToStr(pGrupoProd) +
    '	and cgp.cod_prod = ' + QuotedStr(pCodProd) +
    ' and cgp.cod_empresa = ' + codEmpresa +
    '	and cgp.cod_grade > 0 ';
  pBuscas.Open;

  Result := pBuscas.FieldByName('count').AsInteger > 0;
end;

function TSingleton.produtoAcabadoPrimaTemGrade(pBuscas: TIBQuery;
	pGrupoProdAcab: Integer; pCodProdAcab: string;
  pGrupoProdMprima: Integer; pCodProdMprima: string): boolean;
begin
  Result := False;

  if (not Result) and (pGrupoProdAcab > 0) and (trim(pCodProdAcab) <> '') then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select count(*) from cod_grade_prod cgp ' +
    	' inner join produtos pr on ' +
      '		pr.grupo_prod = cgp.grupo_prod ' +
      '   and pr.cod_prod = cgp.cod_prod ' +
      '   and pr.cod_empresa = cgp.cod_empresa ' +
      ' where cgp.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      '	and cgp.cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cgp.cod_empresa = ' + codEmpresa +
      '	and cgp.cod_grade > 0 ';
    pBuscas.Open;

    Result := pBuscas.FieldByName('count').AsInteger > 0;
  end;

  if (not Result) and (pGrupoProdMprima > 0) and (trim(pCodProdMprima) <> '') then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select count(*) from cod_grade_prod cgp ' +
      ' where cgp.grupo_prod = ' + IntToStr(pGrupoProdMprima) +
      '	and cgp.cod_prod = ' + QuotedStr(pCodProdMprima) +
      ' and cgp.cod_empresa = ' + codEmpresa +
      '	and cgp.cod_grade > 0 ';
    pBuscas.Open;

    Result := pBuscas.FieldByName('count').AsInteger > 0;
  end;

  if (not Result) and (pGrupoProdAcab > 0) and (trim(pCodProdAcab) <> '') then
  begin
	  pBuscas.Close;
	  pBuscas.SQL.Text := ' select count(*) from indice_tecnico ind ' +
    	' inner join produtos pr on ' +
      '		pr.grupo_prod = ind.grupo_prod_acabado ' +
      '   and pr.cod_prod = ind.cod_prod_acabado ' +
      '   and pr.cod_empresa = ind.cod_empresa ' +
    	' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProdAcab) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProdAcab) +
      '	and ind.cod_empresa = ' + codEmpresa +
			' and (select count(*) from cod_grade_prod cgp ' +
      '      where cgp.grupo_prod = ind.grupo_prod_mprima ' +
      '      and cgp.cod_prod = ind.cod_prod_mprima ' +
      '      and cgp.cod_empresa = ind.cod_empresa ' +
      '      and cgp.cod_grade > 0) > 0 ';
    pBuscas.Open;

	  Result := pBuscas.FieldByName('count').AsInteger > 0;
  end
end;

procedure TSingleton.progressoFuncao(caption, mensagemPrincipal, mensagemProgresso: string);
var
  k, i, altura: integer;
  jaexiste: boolean;
begin
  if UpperCase(GetIni('Sistema', 'ProgressoFuncao', '')) = 'OFF' then
  begin
    abreStatusProcessamento(mensagemPrincipal, mensagemProgresso);
    Exit;
  end;

  jaexiste := false;
  altura := 0;
  Application.ProcessMessages;
  if frmProgresso = nil then
  begin
    Application.CreateForm(TfrmProgresso, frmProgresso);
    if caption <> '' then
      frmProgresso.Caption := caption;
    vqtLabel := 0;
    vParar := 0;
  end;
  for I := 1 to vqtLabel do
  begin
    for k := 0 to frmProgresso.ComponentCount - 1 do //Testando aqui se o Label já já não existe.
    begin
      if (frmProgresso.Components[k] is TLabel) then
        if 'vLabel' + IntToStr(i) = TLabel(frmProgresso.Components[k]).Name then
          if Pos('Concluído!', TLabel(frmProgresso.Components[k]).Caption) = 0 then
          begin
            TLabel(frmProgresso.Components[k]).Caption := TLabel(frmProgresso.Components[k]).Caption
              + ' (Concluído!)';
            altura := TLabel(frmProgresso.Components[k]).Top;
          end;
    end;
  end;
  if {(not jaexiste) and }(trim(mensagemProgresso) <> '') then
  begin
    inc(vqtLabel);
    if vqtLabel = 1 then
      altura := 10
    else
      altura := altura + 20; // 10 + (( vqtLabel - 1 ) * 20);
    vLabel := TLabel.create(frmProgresso);
    vLabel.Alignment := taLeftJustify;
    vLabel.Parent := frmProgresso.ScrollBox1;
    vLabel.Name := 'vLabel' + IntToStr(vqtLabel);
    vLabel.Caption := mensagemProgresso;
    vLabel.Tag := vqtLabel;
    vLabel.Left := 60;
    vLabel.AutoSize := true;
    vLabel.Top := altura;
    vLabel.Visible := true;
    vLabel.Font.Style := [fsBold];
    vLabel.Font.Color := clNavy;
    frmProgresso.ScrollBox1.ScrollInView(vLabel);
  end;

  if (altura + 60) >= (frmProgresso.Height) then
  begin
    //    frmProgresso.top := frmProgresso.top - 10;
    //    frmProgresso.Height := altura+60;
    //    frmProgresso.Visible := false;
  end;

  frmProgresso.Show;
  if mensagemPrincipal <> '' then
    frmProgresso.Label1.Caption := mensagemPrincipal;
  if caption <> '' then
    frmProgresso.Caption := caption;
  frmProgresso.Refresh;
  Application.ProcessMessages;
end;

