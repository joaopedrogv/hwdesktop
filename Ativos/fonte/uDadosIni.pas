function TSingleton.PrimeiraLetrasMaiusculaCadaPalavra(x: string): string;
var
  y:string;
  i:integer;
begin
  x := UpperCase(Copy(trim(x), 1, 1)) + Copy(LowerCase(x), 2, Length(x));
  for i := 1 to length(x) do
  begin
    if x[i-1] = ' ' then
    	y := y + uppercase(x[i])
    else
    	y := y + x[i];
  end;
  result := y;
end;

function TSingleton._novaVersao(buscas: TIBQuery): Boolean;
begin
  Result := False;
  try
    buscas.Close;
    buscas.SQL.Text := 'select VERSAO_INST, SITUACAO_INST, ATIVO from CONFIG_HWUPDATE' +
      ' where COD_HWUPDATE = 1';
    buscas.Open;

    if buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := 'insert into CONFIG_HWUPDATE (COD_HWUPDATE, HD_PC, CNPJ, STAND_ALONE, HOMOLOGACAO, ATIVO, VERSAO_INST, SITUACAO_INST)' +
        ' values ( 1, '''', '''', ''S'', ''P'', 0, ' + QuotedStr(vVersaoBpl) + ', ''INSTALADA'')';
      buscas.ExecSQL;
      buscas.Transaction.Commit;
      Exit;
    end;
//    if buscas.FieldByName('ativo').AsInteger = 0 then
//      Exit;

    if vVersaoBpl >= Trim(buscas.FieldByName('VERSAO_INST').AsString) then
    begin
      if buscas.FieldByName('ativo').AsInteger = 0 then
        if vVersaoBpl > Trim(buscas.FieldByName('VERSAO_INST').AsString) then
        begin
          buscas.Close;
          buscas.SQL.Text := 'update CONFIG_HWUPDATE set VERSAO_INST = '+ QuotedStr(vVersaoBpl) +
            ', SITUACAO_INST = ''INSTALADA''' +
            ' where COD_HWUPDATE = 1';
          buscas.ExecSQL;
          buscas.Transaction.Commit;
        end;
      Exit;
    end;

    //ModoDesenvolvimento = MD
    //SairQuandoVersaoNovaJaInstaladaEmOutroPC = SQVNJIEOPC
    if GetIni('MD', 'SQVNJIEOPC', 'N') = 'S' then
      Exit;

    if Trim(buscas.FieldByName('SITUACAO_INST').AsString) = 'INSTALADA' then
    begin
      if buscas.FieldByName('ativo').AsInteger = 0 then
      begin
        Application.MessageBox('Nova versão já instalada em outros computadores. É necessário instalar nova versão para continuar',
          'Atenção', MB_ICONEXCLAMATION + MB_OK);
        Halt(0);
      end;
      if Application.MessageBox('Nova versão já instalada em outros computadores. É necessário instalar nova versão para continuar. Deseja continuar?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        Halt(0);
      Result := True;
    end
    else if Trim(buscas.FieldByName('SITUACAO_INST').AsString) = 'DISPONIVEL' then
    begin
      if buscas.FieldByName('ativo').AsInteger = 0 then
        exit;

      buscas.Close;
      buscas.SQL.Text := 'select HD_PC_INST from CONFIG_HWUPDATE' +
        ' where COD_HWUPDATE = 1';
      try
        buscas.Open;
        if Trim(buscas.FieldByName('HD_PC_INST').AsString) <> '' then
          if Trim(buscas.FieldByName('HD_PC_INST').AsString) <> Trim(retornaSerialHd) then
            exit;
      except
      end;

      Result := Application.MessageBox('Nova versão disponível. Deseja instalar nova versão agora?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON1) = IDYES;
    end;
  except
    on e: exception do
    begin
      if Pos('Table unknown', e.Message) = 0 then
        Application.MessageBox(pchar('Erro ao abrir dados de Configuração. Erro: ' + e.Message),
          'Atenção', 0 + 64);
      registraErro('_novaVersao. Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton._novaVersaoBugSeq(buscas: TIBQuery): Boolean;
var
	CRCBugList: TStringList;
	vCrcMin: Integer;
  I: Integer;
begin
  Result := False;

  if (vDadosIni.vTsPlus = 'S') then
  	Exit;

  vCrcMin := retornaVersaoMinimaCRC(buscas);

  if (vCrcMin > vCrcSeq) then
  begin
    if Application.MessageBox('Nova versão já instalada em outros computadores. É necessário instalar nova versão para continuar. Deseja continuar?',
      'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
      Halt(0);
    Result := True;
    Exit;
  end;

  if Trim(vCrcInf) <> '' then
  begin
    try
      CRCBugList := TStringList.Create;
      if FileExists(ExtractFilePath(Application.Exename) + 'CRCBugList.txt') then
        CRCBugList.LoadFromFile(ExtractFilePath(Application.Exename) + 'CRCBugList.txt');

      for I := 0 to CRCBugList.Count - 1 do
      begin
        if Trim(vCrcInf) = Trim(CRCBugList[I]) then
        begin
          if Application.MessageBox(PChar(
            'Um correção de bugs importante está disponível para esta versão.' + #13 + #13 +
            'Recomendamos a atualização para evitar falhas no sistema.' + #13 + #13 +
            'Instalar agora?'),
            'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
              Result := False
          else
              Result := True;
          Exit;
        end;
      end;
    finally
      CRCBugList.Free;
    end;
  end;
end;

