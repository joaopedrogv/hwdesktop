           pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
           pBuscas.ExecSQL;
         end;

         pBuscas.Close;
         pBuscas.SQL.Text := ' INSERT INTO LOCALIDADE (' + vCamposLoc + ') ' +
            ' VALUES (' + vCamposLocIns + ') ';
         for J := 0 to buscas3.FieldCount - 1 do
            pBuscas.ParamByName(buscas3.Fields[J].FieldName).Value := buscas3.Fields[J].Value;
         pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
         pBuscas.ExecSQL;
       end;
    end
    else if pDescTipo = 'SETOR' then
    begin
       buscas3.Close;
       buscas3.SQL.Text := ' SELECT ' + vCamposSet + ' FROM SETOR ' +
         ' WHERE COD_SETOR = :COD_SETOR AND COD_EMPRESA = :COD_EMPRESA ';
       buscas3.ParamByName('COD_SETOR').AsInteger := pTipo;
       buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
       buscas3.Open;

       if buscas3.IsEmpty then
       begin
         buscas3.Close;
         buscas3.SQL.Text := ' SELECT ' + vCamposSet + ' FROM SETOR ' +
           ' WHERE COD_SETOR = :COD_SETOR AND COD_EMPRESA = :COD_EMPRESA ';
         buscas3.ParamByName('COD_SETOR').AsInteger := pTipo;
         buscas3.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
         buscas3.Open;

         pBuscas.Close;
         pBuscas.SQL.Text := ' INSERT INTO SETOR (' + vCamposSet + ') ' +
           ' VALUES (' + vCamposSetIns + ') ';
         for J := 0 to buscas3.FieldCount - 1 do
            pBuscas.ParamByName(buscas3.Fields[J].FieldName).Value := buscas3.Fields[J].Value;
         pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vReplicaoInternaEmpresa[i]);
         pBuscas.ExecSQL;
       end;
    end;
  end;
end;

function TSingleton.verificarTransito(buscas: TIBQuery; pCodEstMoto, pCodModelo,
  pAnoFab, pAnoMod, pCodCor: Integer; vPosicao: string; pTp: Integer = 0): boolean;
begin
   buscas.Close;
   buscas.SQL.Text := '';
   if pTp = 1 then
   begin
     if (trim(vPosicao) = 'VIVO') then
       buscas.SQL.Text := ' select 1 tipo, '
     else if (trim(vPosicao)= 'TRANSITO') then
       buscas.SQL.Text := ' select 3 tipo, '
     else
       buscas.SQL.Text := ' select 2 tipo, ';

     buscas.SQL.Text := buscas.SQL.Text + ' est.data_ch_nota, est.data_trans_nota, est.codigo, est.* from est_moto est ' +
      ' where est.codigo = :codigo and est.cod_empresa = :cod_empresa ' +
      ' union ';
     if (trim(vPosicao) = 'VIVO') then
       buscas.SQL.Text := buscas.SQL.Text +
        ' select 1 tipo, est.data_ch_nota, est.data_trans_nota, est.codigo, est.* from est_moto est ' +
        ' where est.versaoest = :cod_modelo and est.ano_fabest = :ano_fab and est.ano_modest = :ano_mod ' +
        ' and est.cod_cor = :cod_cor and est.cod_empresa = :cod_empresa ' +
        ' and (trim(coalesce(est.status_res, ''N'')) <> ''S'') and est.posicao = ''VIVO'' ' +
        ' and (trim(coalesce(est.status_demonst, ''N'')) <> ''S'') ' +
        ' and (trim(coalesce(est.status_uso, ''N'')) <> ''U'') and est.codigo <> :codigo ' +
        ' union ';
   end;
   buscas.SQL.Text := buscas.SQL.Text +
    ' select 2 tipo, est.data_ch_nota, est.data_trans_nota, est.codigo, est.* from est_moto est ' +
    ' left join tipo_reserva res on res.sigla = est.tipo_res and res.tipo = ''VEI'' ' +
    ' left join clientes cl on cl.cod_cliente = est.cod_cliente and cl.cod_empresa = est.cod_empresa ' +
    ' where est.versaoest = :cod_modelo and est.ano_fabest = :ano_fab and est.ano_modest = :ano_mod ' +
    ' and est.cod_cor = :cod_cor ';
   if (pTp = 0) then
     buscas.SQL.Text := buscas.SQL.Text + ' and (coalesce(est.status_res, ''N'') = ''S'') ';
   buscas.SQL.Text := buscas.SQL.Text +
    ' and est.cod_empresa = :cod_empresa ' +
    ' and est.posicao = ''MORTO'' and est.status_transdep = ''S'' and est.data_trans_ret is null ' +
    ' and (coalesce(res.tipo_res, '''') <> ''M'') ' +
    ' and (trim(coalesce(est.status_uso, ''N'')) <> ''U'') and est.codigo <> :codigo ' +
    ' union ' +
    ' select 3 tipo, est.data_ch_nota, est.data_trans_nota, est.codigo, est.* from est_moto est ' +
    ' left join tipo_reserva res on res.sigla = est.tipo_res and res.tipo = ''VEI'' ' +
    ' left join clientes cl on cl.cod_cliente = est.cod_cliente and cl.cod_empresa = est.cod_empresa ' +
    ' where est.versaoest = :cod_modelo and est.ano_fabest = :ano_fab and est.ano_modest = :ano_mod ' +
    ' and est.cod_cor = :cod_cor ';
   if (pTp = 0) then
     buscas.SQL.Text := buscas.SQL.Text + ' and (coalesce(est.status_res, ''N'') = ''S'') ';
   buscas.SQL.Text := buscas.SQL.Text +
    ' and est.cod_empresa = :cod_empresa and est.posicao = ''TRANSITO'' ' +
    ' and (coalesce(res.tipo_res, '''') <> ''M'') ' +
    ' and (trim(coalesce(est.status_uso, ''N'')) <> ''U'') and est.codigo <> :codigo ' +
    ' order by 1, 2, 3, 4 ';
   buscas.ParamByName('CODIGO').AsInteger := pCodEstMoto;
   buscas.ParamByName('COD_MODELO').AsInteger := pCodModelo;
   buscas.ParamByName('ANO_FAB').AsInteger := pAnoFab;
   buscas.ParamByName('ANO_MOD').AsInteger := pAnoMod;
   buscas.ParamByName('COD_COR').AsInteger := pCodCor;
   buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
   buscas.Open;
   buscas.FetchAll;

   Result := not buscas.IsEmpty;
end;

procedure TSingleton.verSaldoCC(pCodCliente: Integer; pCPFCGC: string; pBuscas: TIBQuery;
  var pSaldoCC: Double; var pValorCC: Double);
var
  vtemp: string;
begin
	vtemp := ' cl.cpfcgc = ' +  QuotedStr(pCPFCGC);
  if trim(pCPFCGC) = '' then
  	vtemp := ' cl.cod_cliente = ' + IntToStr(pCodCliente);

  SqlOpen(' select sum(case when (trim(cc.tipo) = ''CRÉDITO'') then ' +
   '   			                  cc.pontos ' +
   '			                  else ' +
   '  			                  (-1) * cc.pontos ' +
   '									 end) pontos, ' +
   '							 sum(case when (trim(cc.tipo) = ''CRÉDITO'') then ' +
   '   			                  cc.valor ' +
   '			                  else ' +
   '  			                  (-1) * cc.valor ' +
   '									 end) valor from conta_corrente_prog_fidelidade cc ' +
   ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
   ' left join empresa_prog_fid empg on coalesce(cc.cod_emp_resp, cc.cod_empresa) = empg.cod_empresa ' +
   ' where ' + vtemp +
   ' and coalesce(cc.cod_emp_resp, cc.cod_empresa) in (case when (empg.cod_empresa > 0) then ' +
   '																												  empg.cod_empresa ' +
   '																												else ' +
   																														codEmpresa +
   ' 																									 end) ' +
   ' and cc.data_venc_prog >= %s', [FusoDateFb()], pBuscas);
  pSaldoCC := pBuscas.FieldByName('pontos').AsFloat;
  pValorCC := pBuscas.FieldByName('valor').AsFloat;
end;

function TSingleton.vincularProdutoAcabadoMateriaPrima(pBuscas: TIBQuery;
	pGrupoProdAcab: Integer; pCodProdAcab: string; pCodGradeAcab,
  pGrupoProdMprima: Integer; pCodProdMprima: string; pQuantMprima: Double;
  pMensagem: boolean): boolean;
var
	buscasG, buscasMatP: TIBQuery;
  buscas2, buscas3: TIBQuery;
  vBuscasProdutosAcabado: TIBQuery;
  vBuscasProdutosMateriaPrima: TIBQuery;

  vBuscasGradeAcabado: TIBQuery;

  vBuscasGradeMatPrima: TIBQuery;
  vBuscasMateriasPrima: TIBQuery;

  vDataSetGradeMatPrima: TClientDataSet;
  vDataSourceGradeMatPrima: TDataSource;

  vIdInd, vIdIndIt: Integer;
  vIncluirGradeMatPrima: Integer;
  vExisteAcab: Integer;
  vIdIndTmp: Integer;
  I: Integer;

  sDescricaoo: string;
begin
	try
    Result := False;

    vIdInd      := 0;
    vIdIndIt    := 0;
    vExisteAcab := 0;

    vIncluirGradeMatPrima := 0;

    buscasG := TIBQuery.Create(Application);
    buscasG.Database := pBuscas.Database;
    buscasG.Transaction := pBuscas.Transaction;

    buscasMatP := TIBQuery.Create(Application);
    buscasMatP.Database := pBuscas.Database;
    buscasMatP.Transaction := pBuscas.Transaction;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := pBuscas.Database;
    buscas2.Transaction := pBuscas.Transaction;

    buscas3 := TIBQuery.Create(Application);
    buscas3.Database := pBuscas.Database;
    buscas3.Transaction := pBuscas.Transaction;

    vBuscasProdutosAcabado := TIBQuery.Create(Application);
    vBuscasProdutosAcabado.Database := pBuscas.Database;
    vBuscasProdutosAcabado.Transaction := pBuscas.Transaction;

    vBuscasProdutosMateriaPrima := TIBQuery.Create(Application);
    vBuscasProdutosMateriaPrima.Database := pBuscas.Database;
    vBuscasProdutosMateriaPrima.Transaction := pBuscas.Transaction;

    vBuscasGradeAcabado := TIBQuery.Create(Application);
    vBuscasGradeAcabado.Database := pBuscas.Database;
    vBuscasGradeAcabado.Transaction := pBuscas.Transaction;

    vBuscasGradeMatPrima := TIBQuery.Create(Application);
    vBuscasGradeMatPrima.Database := pBuscas.Database;
    vBuscasGradeMatPrima.Transaction := pBuscas.Transaction;

    vDataSetGradeMatPrima := TClientDataSet.Create(Application);
    vDataSetGradeMatPrima.Close;
    vDataSetGradeMatPrima.FieldDefs.Clear;
    vDataSetGradeMatPrima.FieldDefs.Add('COD_GRADE', ftInteger);
    vDataSetGradeMatPrima.FieldDefs.Add('QUANT', ftFloat);
    vDataSetGradeMatPrima.FieldDefs.Add('DESCR_GRADE', ftString, 32);
    vDataSetGradeMatPrima.FieldDefs.Add('DESCR_GRADE1', ftString, 32);
    vDataSetGradeMatPrima.CreateDataSet;

    TFloatField(vDataSetGradeMatPrima.FieldByName('QUANT')).DisplayFormat   := '#,##0.000';

    vDataSourceGradeMatPrima := TDataSource.Create(Application);
    vDataSourceGradeMatPrima.DataSet := vDataSetGradeMatPrima;

    buscasMatP.Close;
    buscasMatP.SQL.Text := ' select ind.grupo_prod_mprima, ind.cod_prod_mprima, ' +
      ' pr.num_fab_prod, pr.descr_prod from indice_tecnico ind ' +
      ' inner join produtos pr on ' +
      '		pr.grupo_prod = ind.grupo_prod_mprima ' +
      '   and pr.cod_prod = ind.cod_prod_mprima ' +
      '   and pr.cod_empresa = ind.cod_empresa ' +
      ' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProdAcab) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProdAcab) +
      ' and ind.cod_empresa = ' + codEmpresa +
      ' and (select count(*) from cod_grade_prod cgp ' +
      '      where cgp.grupo_prod = ind.grupo_prod_mprima ' +
      '      and cgp.cod_prod = ind.cod_prod_mprima ' +
      '      and cgp.cod_empresa = ind.cod_empresa ' +
      '      and cgp.cod_grade > 0) > 0 ';
    buscasMatP.Open;
    buscasMatP.FetchAll;

    if buscasMatP.RecordCount <= 0 then
    begin
    	buscasG.Close;
	    buscasG.SQL.Text := '	select cgp.grupo_prod, cgp.cod_prod, cgp.cod_empresa, pr.num_fab_prod, ' +
        ' cgp.cod_grade, ' +
        ' coalesce(gr.descricao, '''') as descr_grade, ' +
        ' coalesce(gr.descricao1, '''') as descr_grade1, ' +
	      ' pr.descr_prod from cod_grade_prod cgp ' +
        ' inner join produtos pr on ' +
      	'		pr.grupo_prod = cgp.grupo_prod ' +
	      '		and pr.cod_prod = cgp.cod_prod ' +
	      '   and pr.cod_empresa = cgp.cod_empresa ' +
  	    ' left join grade gr on ' +
	      '		gr.cod_grade = cgp.cod_grade ' +
  	    '		and gr.cod_empresa = cgp.cod_empresa ' +
	      ' where cgp.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
        ' and cgp.cod_prod = ' + QuotedStr(pCodProdAcab) +
        ' and cgp.cod_empresa = ' + codEmpresa +
        ' and cgp.cod_grade > 0 ' +
        ' and (select count(*) from produtos_pdc_var pvar ' +
	      '      where pvar.grupo_prod = cgp.grupo_prod ' +
  	    '      and pvar.cod_prod = cgp.cod_prod ' +
    	  '      and pvar.cod_grade = cgp.cod_grade ' +
      	'      and pvar.cod_empresa = cgp.cod_empresa) = 0 ';
      buscasG.Open;
	    buscasG.FetchAll;

      buscasG.First;
      while not buscasG.Eof do
      begin
        vBuscasProdutosAcabado.Close;
        vBuscasProdutosAcabado.SQL.Text := 'INSERT INTO PRODUTOS_PDC_VAR ' +
        	' (ID_IND, COD_EMPRESA, GRUPO_PROD, COD_PROD, COD_GRADE, DESCRICAO) ' +
        	' VALUES ((SELECT COD FROM INCREMENTA_CODIGO (:COD_EMPRESA, ''PRODUTOS_PDC_VAR'')), ' +
          ' :COD_EMPRESA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :DESCRICAO); ';
        vBuscasProdutosAcabado.ParamByName('cod_empresa').AsInteger                  :=
          StrToInt(codEmpresa);
        vBuscasProdutosAcabado.ParamByName('grupo_prod').AsInteger                   :=
          pGrupoProdAcab;
        vBuscasProdutosAcabado.ParamByName('cod_prod').AsString                      :=
          pCodProdAcab;
        {
        vBuscasProdutosAcabado.ParamByName('descricao').AsString                     :=
          trim(buscasG.FieldByName('descr_prod').AsString) +
            IfThen(trim(buscasG.FieldByName('descr_grade').AsString) <> '',
              ' - ' + trim(buscasG.FieldByName('descr_grade').AsString), '');
        }
        sDescricaoo := StrUtils.IfThen(trim(buscasG.FieldByName('descr_grade').AsString) <> '', ' - ' + trim(buscasG.FieldByName('descr_grade').AsString));
        sDescricaoo := Copy(trim(buscasG.FieldByName('descr_prod').AsString), 1, 75 - Length(sDescricaoo)) + sDescricaoo;
        vBuscasProdutosAcabado.ParamByName('descricao').AsString                     := sDescricaoo; 

        vBuscasProdutosAcabado.ParamByName('cod_grade').AsInteger                    :=
          buscasG.FieldByName('cod_grade').AsInteger;
        vBuscasProdutosAcabado.ExecSQL;

        buscasG.Next;
      end;

      if vBuscasProdutosAcabado.Transaction.InTransaction then
	      vBuscasProdutosAcabado.Transaction.Commit;

    	Result := True;
    	exit;
    end;

    buscasG.Close;
    buscasG.SQL.Text := ' select cgp.grupo_prod, cgp.cod_prod, cgp.cod_empresa, pr.num_fab_prod, ' +
      ' cgp.cod_grade, ' +
      ' coalesce(gr.descricao, '''') as descr_grade, ' +
      ' coalesce(gr.descricao1, '''') as descr_grade1, ' +
      ' pr.descr_prod from cod_grade_prod cgp ' +
      ' inner join produtos pr on ' +
      '		pr.grupo_prod = cgp.grupo_prod ' +
      '		and pr.cod_prod = cgp.cod_prod ' +
      '   and pr.cod_empresa = cgp.cod_empresa ' +
      ' left join grade gr on ' +
      '		gr.cod_grade = cgp.cod_grade ' +
      '		and gr.cod_empresa = cgp.cod_empresa ' +
      ' where cgp.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and cgp.cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and cgp.cod_empresa = ' + codEmpresa +
      ' and cgp.cod_grade > 0 ' +
      ' and (select count(*) from produtos_pdc_var pvar ' +
      '      where pvar.grupo_prod = cgp.grupo_prod ' +
      '      and pvar.cod_prod = cgp.cod_prod ' +
      '      and pvar.cod_grade = cgp.cod_grade ' +
      '      and pvar.cod_empresa = cgp.cod_empresa) = 0 ';

    buscasG.SQL.Text := buscasG.SQL.Text +
      ' union ' +
      ' select pvar.grupo_prod, pvar.cod_prod, pvar.cod_empresa, pr.num_fab_prod, ' +
      ' pvar.cod_grade, ' +
      ' coalesce(gr.descricao, '''') as descr_grade, ' +
      ' coalesce(gr.descricao1, '''') as descr_grade1, ' +
      ' pr.descr_prod from produtos_pdc_var pvar ' +
      ' inner join produtos pr on ' +
      '   pr.grupo_prod = pvar.grupo_prod ' +
      '   and pr.cod_prod = pvar.cod_prod ' +
      '   and pr.cod_empresa = pvar.cod_empresa ' +
      ' left join grade gr on ' +
      '   gr.cod_grade = pvar.cod_grade ' +
      '   and gr.cod_empresa = pvar.cod_empresa' +
      ' where pvar.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and pvar.cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and pvar.cod_empresa = ' + codEmpresa +
      ' and (select count(*) from produtos_pdc_var_it pit ' +
      '      where pit.id_ind = pvar.id_ind ' +
      '      and pit.cod_empresa = pvar.cod_empresa) = 0 ';

    buscasG.SQL.Text := buscasG.SQL.Text +
      ' union ' +
      ' select distinct ind.grupo_prod_acabado as grupo_prod, ind.cod_prod_acabado as cod_prod, ind.cod_empresa, pr.num_fab_prod, ' +
      ' pvar.cod_grade, ' +
      ' coalesce(gr.descricao, '''') as descr_grade, ' +
      ' coalesce(gr.descricao1, '''') as descr_grade1, ' +
      ' pr.descr_prod from indice_tecnico ind ' +
      ' inner join produtos pr on ' +
      '   pr.grupo_prod = ind.grupo_prod_acabado ' +
      '   and pr.cod_prod = ind.cod_prod_acabado ' +
      '   and pr.cod_empresa = ind.cod_empresa ' +
      ' inner join produtos_pdc_var pvar on ' +
      '   pvar.grupo_prod = ind.grupo_prod_acabado ' +
      '   and pvar.cod_prod = ind.cod_prod_acabado ' +
      '   and pvar.cod_empresa = ind.cod_empresa ' +
      ' left join grade gr on ' +
      '   gr.cod_grade = pvar.cod_grade ' +
      '   and gr.cod_empresa = pvar.cod_empresa ' +
      ' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProdAcab) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProdAcab) +
      ' and ind.cod_empresa = ' + codEmpresa +
      ' and (select count(*) from cod_grade_prod cgp ' +
      '      where cgp.grupo_prod = ind.grupo_prod_mprima ' +
      '      and cgp.cod_prod = ind.cod_prod_mprima ' +
      '      and cgp.cod_empresa = ind.cod_empresa ' +
      '      and cgp.cod_grade > 0) > 0 ' +
      ' and (select count(*) from produtos_pdc_var_it pit ' +
      '      where pit.id_ind = pvar.id_ind ' +
      '      and pit.cod_empresa = ind.cod_empresa ' +
      '      and pit.grupo_prod = ind.grupo_prod_mprima ' +
      '      and pit.cod_prod = ind.cod_prod_mprima) = 0 ';

    if (pCodGradeAcab > 0) then
    begin
  		buscasG.SQL.Text := buscasG.SQL.Text +
      	' union ' +
        ' select pr.grupo_prod, pr.cod_prod, pr.cod_empresa, pr.num_fab_prod, ' +
        IntToStr(pCodGradeAcab) + ' cod_grade, ' +
        ' coalesce(gr.descricao, '''') as descr_grade, ' +
        ' coalesce(gr.descricao1, '''') as descr_grade1, ' +
        ' pr.descr_prod from produtos pr ' +
        ' left join grade gr on ' +
        '		gr.cod_grade = ' + IntToStr(pCodGradeAcab) +
        '		and gr.cod_empresa = pr.cod_empresa ' +
        ' where pr.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
        ' and pr.cod_prod = ' + QuotedStr(pCodProdAcab) +
        ' and pr.cod_empresa = ' + codEmpresa +
        ' and (select count(*) from produtos_pdc_var pvar ' +
        '      where pvar.grupo_prod = pr.grupo_prod ' +
        '      and pvar.cod_prod = pr.cod_prod ' +
        '      and pvar.cod_grade = ' + IntToStr(pCodGradeAcab) +
        '      and pvar.cod_empresa = pr.cod_empresa) = 0 ';
    end;

    if (pCodGradeAcab <= 0) then
    begin
      buscasG.SQL.Text := buscasG.SQL.Text +
        ' union ' +
        ' select pr.grupo_prod, pr.cod_prod, pr.cod_empresa, pr.num_fab_prod, ' +
