function TSingleton.verificarLiberacaoPesqPros(vCodLiberacao: Integer; qrBusca: TIBQuery; var vUsuario: string; var vSenha: string): boolean;
begin
	Result := False;

   qrBusca.Close;
   qrBusca.SQL.Text := ' SELECT SA.COD_SOLICITACAO, SA.USUARIO_GERENTE, SE.SENHA FROM SOLICITACOES_ACESSO SA ' +
      ' INNER JOIN SENHAS SE ON SE.USUARIO = SA.USUARIO_GERENTE AND SE.COD_EMPRESA = SA.COD_EMPRESA ' +
   	' WHERE SA.COD_SOLICITACAO = :COD_SOLICITACAO AND SA.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND SA.USUARIO_GERENTE IS NOT NULL ';
   qrBusca.ParamByName('COD_SOLICITACAO').AsInteger := vCodLiberacao;
   qrBusca.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
   qrBusca.Open;

   if not qrBusca.IsEmpty then
   begin
     vUsuario := qrBusca.FieldByName('USUARIO_GERENTE').AsString;
     vSenha := decodifica(qrBusca.FieldByName('SENHA').AsString);
     Result := True;
   end;
end;

