function TSingleton.ConversaoRecursiva(N:int64): string;
begin
    if (N >= 1) and (N<=19) then
      Result := Unidades[(N div 1)]
    else if (N = 20) or (N = 30) or (N =40) or (N =50) or (N = 60) or (N = 70) or (N =80) or (N =90) then
      Result := Dezenas[N div 10] + ' '
    else if (N >= 21) and (N<=99) then
      Result := Dezenas[N div 10] + ' e ' + ConversaoRecursiva(N mod 10)
    else if (N = 100) or (N = 200) or (N =300) or (N =400) or (N = 500) or (N = 600) or (N =700) or (N =800) or (N =900) then
      Result := Centenas[N div 100] + ' '
    else if (N >= 101) and (N<=199) then
      Result := ' cento e ' + ConversaoRecursiva(N mod 100)
    else if (N >= 201) and (N<=999) then
      Result := Centenas[N div 100] + ' e ' + ConversaoRecursiva(N mod 100)
    else if (N >= 1000) and (N<=999999) then
      Result := ConversaoRecursiva(N div 1000) + ' mil, ' + ConversaoRecursiva(N mod 1000)
    else if (N >= 1000000) and (N<=1999999) then
      Result := ConversaoRecursiva(N div 1000000) + ' milhão, ' + ConversaoRecursiva(N mod
        1000000)
    else if (N >= 2000000) and (N<=999999999) then
      Result := ConversaoRecursiva(N div 1000000) + ' milhões, ' + ConversaoRecursiva(N mod
        1000000)
    else if (N >= 1000000000) and (N<=1999999999) then
      Result := ConversaoRecursiva(N div 1000000000) + ' bilhão, ' + ConversaoRecursiva(N mod
        1000000000)
    else if (N >= 2000000000) and (N<=999999999999) then
      Result := ConversaoRecursiva(N div 1000000000) + ' bilhões, ' + ConversaoRecursiva(N mod
        1000000000)
    else if (N >= 1000000000000) and (N<=1999999999999) then
      Result := ConversaoRecursiva(N div 1000000000000) + ' trilhão, ' + ConversaoRecursiva(N mod
        1000000000000)
    else if (N >= 2000000000000) and (N<=999999999999999) then //(N<=2337203685477) then
      Result := ConversaoRecursiva(N div 1000000000000) + ' trilhões, ' + ConversaoRecursiva(N mod
        1000000000000);
end;

function TSingleton.convertStringToArrayGetCamposPipe(Str,
  Delimiter: string): arraystring;
var
  Count: Integer;
  I: Integer;
begin

  Count := OccurrencesOfString(Str, Delimiter);
  if Count <= 0 then
  begin
    SetLength(Result, 0);
    Exit;
  end;
  SetLength(Result, Count);

  for I := 0 to Count - 1 do
    Result[i] := getCampoPipe(Str, I + 1, Delimiter);
end;

function TSingleton.convertStringToArrayGetValue(Str: string;
  Delimiter: string = '|'): arraystring;
var
  Count: Integer;
  I: Integer;
begin

  Count := OccurrencesOfString(Str, Delimiter) - 1;
  if Count <= 0 then
  begin
    SetLength(Result, 0);
    Exit;
  end;
  SetLength(Result, Count);

  for I := 0 to Count - 1 do
    Result[i] := getValue(Str, I + 1, Delimiter);
end;

function TSingleton.convertStrinsToArray(Strings: TStrings; IndexGetValue: Integer): arraystring;
var
  vLista: TStrings;
  Count: Integer;
  I: Integer;
begin
  vLista := TStringList.Create;
  vLista.Text := Strings.Text;

  SetLength(Result, vLista.Count);

  for I := 0 to vLista.Count - 1 do
    Result[i] := IfThen(IndexGetValue > 0, getValue(vLista[i], IndexGetValue), vLista[i]);
end;

