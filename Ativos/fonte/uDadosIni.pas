function TSingleton.existeContato(
	pCodCliente: Integer;
  pIdAplicativo: Integer;
  pIdentificacao: string): Boolean;
var
	Con: TConexao;
	vAplicativo: string;
begin
	Result := False;

  if pCodCliente <= 0 then
  	Exit;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      vAplicativo := retornaNomeAplicativo(pIdAplicativo);

      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select first 1 msg_contato.id from msg_contato ' +
          ' where msg_contato.cod_cliente = :cod_cliente ' +
          ' and msg_contato.cod_empresa = :cod_empresa ' +
          ' and msg_contato.id_msg_aplicativo = :id_msg_aplicativo ' +
          ' and msg_contato.identificador = :identificador ' +
          ' and ativo = :ativo ';
        Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
        Con.QrAux.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
        Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := pIdAplicativo;
        Con.QrAux.ParamByName('identificador').AsString := trim(pIdentificacao);
        Con.QrAux.ParamByName('ativo').AsInteger := 1;
        Con.QrAux.Open;

        Result := not Con.QrAux.IsEmpty;

        if Result then
  begin
          Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
            'CONTATO' + #13 +
            retornaNomeAplicativo(pIdAplicativo) + ': ' + trim(pIdentificacao)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          Exit;
  end;
      end
      else
      begin
        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select clientes_contato.id from clientes_contato ' +
          ' inner join tipo_contato on tipo_contato.id = clientes_contato.tipo_id ' +
          ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and clientes_contato.cod_empresa = ' + codEmpresa +
          ' and clientes_contato. ' + IfThen(trim(vAplicativo) = 'WHATSAPP', 'telefone', 'email') + ' = ' + QuotedStr(trim(pIdentificacao));
        Con.QrAux.Open;

        Result := not Con.QrAux.IsEmpty;

        if Result then
        begin
          Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
            'CONTATO' + #13 +
            trim(vAplicativo) + ': ' + trim(pIdentificacao)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          Exit;
end;

        if (not Result) and (trim(vAplicativo) = 'E-MAIL') then
begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select clientes.cod_cliente from clientes ' +
            ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
            ' and clientes.cod_empresa = ' + codEmpresa +
            ' and clientes.email = ' + QuotedStr(trim(pIdentificacao));
          Con.QrAux.Open;

          Result := not Con.QrAux.IsEmpty;

          if Result then
          begin
            Application.MessageBox(PChar('Contato já cadastrado: ' + #13 + #13 +
              'CONTATO' + #13 +
              trim(vAplicativo) + ': ' + trim(pIdentificacao)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
  Exit;
end;
        end;
      end;
    except on E: Exception do
      begin
        Result := False;
        Application.MessageBox(PChar('Erro ao retorna código do contato: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao retorna código do contato: ' + e.Message);
      end;
    end;
  finally
    if Assigned(Con) then
      FreeAndNil(Con);
  end;
end;

function TSingleton.existeGradeProducao(pBuscas: TIBQuery;
	pGrupoProdAcab: Integer; pCodProdAcab: string;
  pGrupoProdMprima: Integer; pCodProdMprima: string): boolean;
var
  pBuscas2: TIBQuery;
begin
  Result := False;

  pBuscas2 := TIBQuery.Create(Application);
	pBuscas2.Database := pBuscas.Database;
	pBuscas2.Transaction := pBuscas.Transaction;

  if (not Result) and (pGrupoProdAcab > 0) and (trim(pCodProdAcab) <> '') then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select count(*) from produtos pr ' +
      ' inner join cod_grade_prod cgp on ' +
      '   cgp.grupo_prod = pr.grupo_prod ' +
      '   and cgp.cod_prod = pr.cod_prod ' +
      '   and cgp.cod_empresa = pr.cod_empresa ' +
      ' where pr.grupo_prod = ' + IntToStr(pGrupoProdAcab) +
      ' and pr.cod_prod = ' + QuotedStr(pCodProdAcab) +
      ' and pr.cod_empresa = ' + codEmpresa +
      ' and cgp.cod_grade > 0 ' +
      ' and (select count(*) from produtos_pdc_var pvar ' +
      '      where pvar.grupo_prod = cgp.grupo_prod ' +
      '      and pvar.cod_prod = cgp.cod_prod ' +
      '      and pvar.cod_empresa = cgp.cod_empresa ' +
      '      and pvar.cod_grade = cgp.cod_grade) = 0 ';
    pBuscas.Open;

    Result := pBuscas.FieldByName('count').AsInteger > 0;
  end;

  if (not Result) and (pGrupoProdMprima > 0) and (trim(pCodProdMprima) <> '') then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select count(*) from produtos pr ' +
      ' inner join cod_grade_prod cgp on ' +
      '   cgp.grupo_prod = pr.grupo_prod ' +
      '   and cgp.cod_prod = pr.cod_prod ' +
      '   and cgp.cod_empresa = pr.cod_empresa ' +
      ' where pr.grupo_prod = ' + IntToStr(pGrupoProdMprima) +
      ' and pr.cod_prod = ' + QuotedStr(pCodProdMprima) +
      ' and pr.cod_empresa = ' + codEmpresa +
      ' and cgp.cod_grade > 0 ' +
      ' and (select count(*) from produtos_pdc_var pit ' +
      '      where pit.grupo_prod = cgp.grupo_prod ' +
      '      and pit.cod_prod = cgp.cod_prod ' +
      '      and pit.cod_empresa = cgp.cod_empresa ' +
      '      and pit.cod_grade = cgp.cod_grade) = 0 ';
    pBuscas.Open;

    Result := pBuscas.FieldByName('count').AsInteger > 0;
  end;

  if (not Result) and (pGrupoProdAcab > 0) and (trim(pCodProdAcab) <> '') then
  begin
	  pBuscas.Close;
	  pBuscas.SQL.Text := ' select count(*) from indice_tecnico ind ' +
    	' inner join produtos pr on ' +
      '		pr.grupo_prod = ind.grupo_prod_acabado ' +
      '		and pr.cod_prod = ind.cod_prod_acabado ' +
      '   and pr.cod_empresa = ind.cod_empresa ' +
      ' inner join cod_grade_prod cgp on ' +
      '   cgp.grupo_prod = ind.grupo_prod_mprima ' +
      '   and cgp.cod_prod = ind.cod_prod_mprima ' +
      '   and cgp.cod_empresa = ind.cod_empresa ' +
    	' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProdAcab) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProdAcab) +
      '	and ind.cod_empresa = ' + codEmpresa +
			' and (select count(*) from produtos_pdc_var pit ' +
      '      where pit.grupo_prod = cgp.grupo_prod ' +
      '      and pit.cod_prod = cgp.cod_prod ' +
      '      and pit.cod_empresa = cgp.cod_empresa ' +
      '      and pit.cod_grade = cgp.cod_grade) = 0 ';
    pBuscas.Open;

	  Result := pBuscas.FieldByName('count').AsInteger > 0;
  end;

  if (not Result) and (pGrupoProdAcab > 0) and (trim(pCodProdAcab) <> '') then
  begin
  	pBuscas.Close;
	  pBuscas.SQL.Text := ' select ind.grupo_prod_mprima, ind.cod_prod_mprima,ind.cod_empresa from indice_tecnico ind ' +
    	' where ind.grupo_prod_acabado = ' + IntToStr(pGrupoProdAcab) +
      ' and ind.cod_prod_acabado = ' + QuotedStr(pCodProdAcab) +
      '	and ind.cod_empresa = ' + codEmpresa;
    pBuscas.Open;

    pBuscas.First;
    while not pBuscas.Eof do
    begin
      pBuscas2.Close;
		  pBuscas2.SQL.Text := ' select count(*) from cod_grade_prod cgp ' +
	      ' where cgp.grupo_prod = ' + IntToStr(pBuscas.FieldByName('grupo_prod_mprima').AsInteger) +
  	    ' and cgp.cod_prod = ' + QuotedStr(pBuscas.FieldByName('cod_prod_mprima').AsString) +
    	  ' and cgp.cod_empresa = ' + codEmpresa +
        ' and cgp.cod_grade > 0 ' +
        ' and (select count(*) from produtos_pdc_var_it pit ' +
        '      where pit.grupo_prod = cgp.grupo_prod ' +
        '      and pit.cod_prod = cgp.cod_prod ' +
        '      and pit.cod_empresa = cgp.cod_empresa ' +
        '      and pit.cod_grade = cgp.cod_grade) = 0 ';;
      pBuscas2.Open;

      Result := pBuscas2.FieldByName('count').AsInteger > 0;

      if Result then
        exit;

      pBuscas.Next;
    end;
  end;
end;

