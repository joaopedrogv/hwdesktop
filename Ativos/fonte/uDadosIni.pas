  function atualizarValorVale(pquery: TIBQuery; pValorVale: Double; pDeb: boolean): boolean;
  var
	  vvalortem: Double;
  begin
    try
      Result := true;

      vvalortem := 0;
      if not pDeb then
      	vvalortem := pValorVale;

      if (trim(ptipo) = 'REQ') or (trim(ptipo) = 'OS') then
      begin
        SqlExec(' update pedvenda set ' +
          ' valor_vale_prg = ' + ffloat_fb(vvalortem) +
          ' where nped = ' + IntToStr(pndoc) +
          ' and tipo = ' + QuotedStr(ptipo) +
          ' and cod_empresa = ' + codEmpresa, pquery);
      end
      else if trim(ptipo) = 'MOT' then
      begin
        SqlExec(' update com_fat set ' +
          ' valor_vale_prg = ' + ffloat_fb(vvalortem) +
          ' where n_comando = ' + IntToStr(pndoc) +
          ' and cod_empresa = ' + codEmpresa, pquery);
      end;
//      else if trim(ptipo) = 'PRE' then
