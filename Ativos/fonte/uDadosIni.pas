    end;
    if (vLetra <> ';') and (vLetra <> ',') and (vLetra <> '|') then
      VerificarEmail(vemail);

   abreStatusProcessamento('', 'Enviando E-mail para: ' + vEmails);

   if (Pos(vEmails, ';') <= 0 ) then
