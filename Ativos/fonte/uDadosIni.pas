      Registro.WriteString('APILevel', '1');
      Registro.WriteString('ConnectFunctions', 'YYN');
      Registro.WriteString('Driver', 'C:\Windows\system32\ib6xtg10.dll');
      Registro.WriteString('DriverODBCVer', '02.50');
      Registro.WriteString('Setup', 'C:\Windows\system32\ib6xtg10.dll');
      Registro.WriteString('SQLLevel', '1');
    end;
    Registro.CloseKey;

//    vatual := registro.ReadString('Database');
