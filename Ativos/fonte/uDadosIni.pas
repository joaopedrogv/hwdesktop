function TSingleton.ReplaceFor(const Subject: string; const OldPatterns,
  NewPatterns: array of string; ReplaceFlags: TReplaceFlags): string;
var
  AReplaceFlags: TReplaceFlags;
  AnewPattern: String;
  I: Integer;
begin
  Result := Subject;
  for I := Low(OldPatterns) to High(OldPatterns) do
  begin
    if I <= High(NewPatterns) then
      AnewPattern := NewPatterns[I]
    else
      AnewPattern := '';
    Result := StringReplace(Result, OldPatterns[I], AnewPattern, ReplaceFlags);
  end;
end;

function TSingleton.ReplaceMult(const Subject: Double;
  const OldPatterns: array of string; NewPatterns, Aformat: string;
  ReplaceFlags: TReplaceFlags): string;
begin
  Result := ReplaceMult(Format(Aformat, [Subject]), OldPatterns, NewPatterns, ReplaceFlags);
end;

function TSingleton.ReplaceMult(const Subject: string;
  const OldPatterns: array of string; NewPatterns: string;
  ReplaceFlags: TReplaceFlags): string;
var
  ANew: array of string;
  I: Integer;
begin
  SetLength(ANew, Length(OldPatterns));
  for I := Low(OldPatterns) to High(OldPatterns) do
    ANew[I] := NewPatterns;
  Result := ReplaceFor(Subject, OldPatterns, ANew, ReplaceFlags);
end;

function TSingleton.Replicate(pString: string; xWidth: Integer): string;
var
  nCount: Integer;
  pStr: string;
begin
  pStr := '';
  for nCount := 1 to xWidth do
    pStr := pStr + pString;
  Result := pStr;
end;

