function TSingleton.abreFormCadastro(pNomeBpl, pNomeForm: string;
  pMensagemSeJaAberto: Boolean; pMensagem: string; pNameClassName: string): Boolean;
var
	nf_fichaproduto: Tnf_fichaproduto;
  hdTemp: THandle;
  formulario: TForm;
  X: Byte;
begin
  if Application.MainForm.MDIChildCount > 0 then
    for X := 0 to Pred(Application.MainForm.MDIChildCount) do
    begin
      if ((trim(pNameClassName) = 'NAME') and (UpperCase(Application.MainForm.MDIChildren[X].Name) = UpperCase(pNomeForm)))
      	or
         ((trim(pNameClassName) = 'CLASSNAME') and (UpperCase(Application.MainForm.MDIChildren[X].ClassName) = UpperCase(pNomeForm))) then
      begin
        if pMensagemSeJaAberto then
          if Trim(pMensagem) = '' then
            Application.MessageBox(PChar(Application.MainForm.MDIChildren[X].Caption + ' já está aberto'), 'Atenção',
            0 + 64)
          else
            Application.MessageBox(PChar(pMensagem), 'Atenção', 0 + 64);
        try
          Application.MainForm.MDIChildren[X].Show;
        except
        end;
        Exit;
      end;
    end;

  if (Pos('NF_FICHAPRODUTO|', vDadosIni.vPesquisa) > 0) and (pNomeForm = 'TfrmCadNF') then
  begin
  	if vNotaFiscal.AHandle = 0 then
      CarregaPacote('pkNF', vNotaFiscal.AHandle);

    if vNotaFiscal.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Nota Fiscal não carregado', 'Atenção', 0 + 64);
      Exit;
    end;

    @nf_fichaproduto := GetProcAddress(vNotaFiscal.AHandle, 'nf_fichaproduto');
    if Assigned(nf_fichaproduto) then
      nf_fichaproduto;
  end
  else
  begin
    vTipoForm := 1;
    vModalOuChild := 'M';

    formulario := Funcoes.AbreForm(pNomeBpl, pNomeForm, hdTemp);

    try
      formulario.ShowModal;
    finally
      formulario.Free;
      unLoadPackage(hdTemp);
    end;
  end;
end;

function TSingleton.abreFormEditarContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pTipoContato: TTipoContato;
  pCheckListContato: TCheckListBox): Boolean;
var
	Con: TConexao;
	vIdAplicativo: Integer;
	vAplicativo: string;
  vIdContato: Integer;
  vContato: string;
  vIdentificacao: string;
  vEmail: string;
  vStringListContato: TStringList;
  I: Integer;
begin
	Result := False;

  if not Assigned(vListaContatoTemp) then
    vListaContatoTemp := TStringList.Create;
  vListaContatoTemp.Clear;


  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
    try
      if pCheckListContato.ItemIndex < 0 then
      begin
        Application.MessageBox('Clique em um contato antes de alterar.', 'Atenção', MB_ICONINFORMATION + MB_OK + MB_DEFBUTTON1);
        Exit;
      end;

      retornaDadosContato(pCheckListContato, vAplicativo, vContato, vIdentificacao);

      vIdAplicativo := retornaCodAplicativo(trim(vAplicativo));

      vIdContato := retornaCodContato(pCodCliente, vIdAplicativo, vContato, vIdentificacao);

      if vIdContato = 0 then
        Exit;

      if (vHwCloudIA.vUsarServMensageria <> 'S')
        and (trim(vAplicativo) = 'E-MAIL')
        and (vIdContato < 0) then
      begin
      	SqlOpen(' select email from clientes where cod_cliente = ' + IntToStr(pCodCliente) + ' and cod_empresa = ' + codEmpresa, Con.QrAux);
        vEmail := trim(Con.QrAux.FieldByName('email').AsString);

        if not InputQuery('Atenção', 'Informe o(s) email(s):', vEmail) then
          exit;

        if trim(vEmail) = '' then
        begin
          Application.MessageBox('E-mail(s) não informado(s).', 'Atenção', MB_ICONINFORMATION + MB_OK + MB_DEFBUTTON1);
          Exit;
        end
        else
        begin
          try
            vIdentificacao := LowerCase(trim(vEmail));
            vEmail := '';

            vStringListContato := TStringList.Create;
            vStringListContato.Clear;
            vStringListContato.Sorted := true;
            vStringListContato.Duplicates := dupIgnore;

            for I := 1 to Length(trim(vIdentificacao)) do
            begin
              if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
              begin
                if not _ValidarEMail(trim(vEmail)) then
                begin
                  Application.MessageBox(PChar('E-mail informado é invalido:' + trim(vEmail)), 'Atenção', MB_ICONINFORMATION + MB_OK + MB_DEFBUTTON1);
                  Exit;
                end;
                vStringListContato.Add(trim(vemail));
                vemail := '';
              end
              else
                vemail := vemail + vIdentificacao[I];
            end;
            if not _ValidarEMail(trim(vEmail)) then
            begin
              Application.MessageBox(PChar('E-mail informado é invalido:' + trim(vEmail)), 'Atenção', MB_ICONINFORMATION + MB_OK + MB_DEFBUTTON1);
              Exit;
            end;
            vStringListContato.Add(trim(vemail));

            vIdentificacao := trim(Join(vStringListContato, ';'));
            if Copy(vIdentificacao, 1, 1) = ';' then
              vIdentificacao := Copy(vIdentificacao, 2, Length(vIdentificacao) - 1);
            if Copy(vIdentificacao, Length(vIdentificacao), 1) = ';' then
              vIdentificacao := Copy(vIdentificacao, 1, Length(vIdentificacao) - 1);

            SqlExec(' update clientes set email = ' + QuotedStr(trim(vIdentificacao)) +
             ' where cod_cliente = ' + IntToStr(pCodCliente) +
             ' and cod_empresa = ' + codEmpresa, Con.QrAux);

            if Con.QrAux.Transaction.InTransaction then
              Con.QrAux.Transaction.Commit;

            Result := True;
            Exit;
          finally
            if Assigned(vStringListContato) then
              FreeAndNil(vStringListContato);
          end;
        end;
      end;

      Application.CreateForm(TFrmContato, FrmContato);
      FrmContato.codcliente := pCodCliente;
      FrmContato.origemenv := pOrigem;
      FrmContato.aplicativo := vAplicativo;
      FrmContato.idcontado := vIdContato;
      FrmContato.tipocontato := pTipoContato;

      if vHwCloudIA.vUsarServMensageria = 'S' then
      begin
        if pCheckListContato.ItemIndex < 0 then
          FrmContato.lb_contato_pla_identificacao.Caption := 'Identificação:'
        else
          FrmContato.lb_contato_pla_identificacao.Caption :=
            Copy(trim(vAplicativo), 1, 1) + LowerCase(Copy(trim(vAplicativo), 2, Length(trim(vAplicativo)) - 1)) + ':';

        FrmContato.ed_contato_pla_identificacao.EditMask := '';
        FrmContato.ed_contato_pla_identificacao.OnKeyPress := nil;

        retornaComboboxAplicativo(FrmContato.ed_contato_pla_aplicativo);
        retornaCheckListTipoContato(FrmContato.ck_contrato_pla_tipos_contato);

        FrmContato.ed_contato_pla_aplicativo.ItemIndex := -1;
        for I := 0 to FrmContato.ed_contato_pla_aplicativo.Items.Count - 1 do
          if trim(FrmContato.ed_contato_pla_aplicativo.Items[I]) = trim(vAplicativo) then
          begin
            FrmContato.ed_contato_pla_aplicativo.ItemIndex := I;
            Break;
          end;

        FrmContato.ed_contato_pla_contato.Text := vContato;
        FrmContato.ed_contato_pla_identificacao.Text := vIdentificacao;

        for I := 0 to FrmContato.ck_contrato_pla_tipos_contato.Items.Count - 1 do
        begin
          Con.QrAux.Close;
          Con.QrAux.SQL.Text := ' select msg_contato_tipo.* from msg_contato_tipo ' +
            ' inner join tipo_contato on tipo_contato.id = msg_contato_tipo.id_tipo_contato ' +
            ' where msg_contato_tipo.id_msg_contato = ' + IntToStr(FrmContato.idcontado) +
            ' and msg_contato_tipo.cod_empresa = ' + codEmpresa +
            ' and tipo_contato.tipo = ' + QuotedStr(trim(FrmContato.ck_contrato_pla_tipos_contato.Items[I]));
          Con.QrAux.Open;

          FrmContato.ck_contrato_pla_tipos_contato.Checked[I] := not Con.QrAux.IsEmpty;
        end;

        FrmContato.ed_contato_pla_aplicativo.Enabled := False;
        FrmContato.ed_contato_pla_contato.Enabled := False;
        FrmContato.ed_contato_pla_identificacao.Enabled := False;

        FrmContato.TabSheet2.Show;
      end
      else
      begin
        retornaComboboxTipoContato(FrmContato.cbTipoContato);

        FrmContato.cbTipoContato.ItemIndex := -1;

        Con.QrAux.Close;
        Con.QrAux.SQL.Text := ' select tipo_contato.tipo from clientes_contato ' +
          ' inner join tipo_contato on tipo_contato.id = clientes_contato.tipo_id ' +
          ' where clientes_contato.id = ' + IntToStr(FrmContato.idcontado) +
          ' and clientes_contato.cod_empresa = ' + codEmpresa;
        Con.QrAux.Open;

        if not Con.QrAux.IsEmpty then
        begin
          for I := 0 to FrmContato.cbTipoContato.Items.Count - 1 do
            if trim(FrmContato.cbTipoContato.Items[I]) = trim(Con.QrAux.FieldByName('tipo').AsString) then
            begin
              FrmContato.cbTipoContato.ItemIndex := I;
              Break;
            end;
        end;

        FrmContato.EdContato.Text := IfThen(trim(vContato) = 'SEM CONTATO', '', trim(vContato));
        FrmContato.meTelefone.EditMask := '';
        if trim(vAplicativo) = 'WHATSAPP' then
        begin
          FrmContato.meTelefone.Text := trim(vIdentificacao);
          FrmContato.meEmail.Text := '';
        end
        else
        begin
          FrmContato.meTelefone.Text := '';
          FrmContato.meEmail.Text := trim(vIdentificacao);
        end;
        FrmContato.meTelefone.EditMask := '(99) 99999-9999;0;_';

        FrmContato.lbTelefone.Visible := trim(vAplicativo) = 'WHATSAPP';
        FrmContato.meTelefone.Visible := trim(vAplicativo) = 'WHATSAPP';

        FrmContato.lbEmail.Visible := trim(vAplicativo) = 'E-MAIL';
        FrmContato.meEmail.Visible := trim(vAplicativo) = 'E-MAIL';

        if FrmContato.lbEmail.Visible then
        begin
          FrmContato.lbEmail.Top := FrmContato.lbTelefone.Top;
          FrmContato.meEmail.Top := FrmContato.meTelefone.Top;
        end;

        FrmContato.TabSheet1.Show;
      end;

      Result := FrmContato.ShowModal = IDOK;

    except on E: Exception do
      begin
        Application.MessageBox(PChar('Erro ao inserir contato cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao inserir contato cliente: ' + e.Message);
      end;
    end;
  finally
    if Assigned(Con) then
    	FreeAndNil(Con);
  end;
end;

