function TSingleton.pos_a_direita(Texto, Busca: string): integer;
var
  i: integer;
begin
  {Pesquisa um caractere ou substring à direita da string,
   retornando sua posição inicial}
  result := 0;
  for i := length(Texto) downto 1 do
  begin
    if Copy(Texto, i, length(Busca)) = Busca then
    begin
      Result := i;
      break;
    end;
  end;
end;

