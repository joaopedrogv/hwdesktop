function TSingleton.verificarControlesCondPagBarrados(pBuscas: TIBQuery;
  pNumDoc, pCodCliente, pCodCondPag: Integer; pTipo: string; pProcess: boolean): boolean;
var
  vLista, vLista2: TStrings;
  vListaDesControle, vListaControle: TStrings;
  vDesCondPag: string;
  vtemp: string;
  I, J: Integer;
  vnome_cliente: string;
  vMensagem: string;
  vTabela: string;
begin
  try
    Result := true;

    if not vCliente.vendaVistaClientesBarrados then
    begin
      Result := false;
      exit;
    end;

    if (trim(pTipo) <> 'REQ') and (trim(pTipo) <> 'OS') and (trim(pTipo) <> 'MOT')   then
    begin
      Result := true;
      exit;
    end;

    if (trim(pTipo) = 'REQ') or (trim(pTipo) = 'OS') then
      vTabela := 'PEDVENDA'
    else if (trim(pTipo) = 'MOT') then
      vTabela := 'COM_FAT';

    if pCodCondPag <= 0 then
    begin
      Result := false;
      exit;
    end;

    if pCodCliente <= 0 then
    begin
      Result := false;
      exit;
    end;

    pBuscas.Close;
    pBuscas.SQL.Text := ' SELECT CL.COD_CLIENTE, CL.NOME_CLIENTE, CL.CODIGO_FATURAMENTO, TP.STATUS_F FROM CLIENTES CL ' +
      ' LEFT JOIN TIPO_FATURAMENTO TP ON TP.CODIGO_FATURAMENTO = CL.CODIGO_FATURAMENTO AND TP.ATIVO = 1 ' +
      ' WHERE CL.COD_CLIENTE = :COD_CLIENTE AND CL.COD_EMPRESA = :COD_EMPRESA ';
    pBuscas.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
    pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(codEmpresa);
    pBuscas.Open;

    if pBuscas.IsEmpty then
    begin
      Result := false;
      exit;
    end;

    if pBuscas.FieldByName('CODIGO_FATURAMENTO').IsNull then
    begin
      Result := false;
      exit;
    end;

    if Trim(pBuscas.FieldByName('STATUS_F').AsString) <> 'BARRADO' then
      exit;

     vnome_cliente := trim(pBuscas.FieldByName('NOME_CLIENTE').AsString);

     pBuscas.Close;
     pBuscas.SQL.Text := ' select desc_cond_pag from cond_pag ' +
       ' where cod_cond_pag = :cod_cond_pag and ativo = 1 ' +
       ' order by cod_cond_pag ';
     pBuscas.ParamByName('cod_cond_pag').AsInteger := pCodCondPag;
     pBuscas.Open;
     pBuscas.FetchAll;

     if not pBuscas.IsEmpty then
       vDesCondPag := trim(pBuscas.FieldByName('desc_cond_pag').AsString);

    vLista := TStringList.Create;
    vLista2 := TStringList.Create;
    vListaDesControle := TStringList.Create;
    vListaControle := TStringList.Create;

    vLista := getConfSisBlob('cl_conf_condicoes_clientes_barrados', pBuscas);
    for I := 0 to vLista.Count - 1 do
    begin
      vLista2 := SplitS(vLista[i]);
      for J := 0 to vLista2.Count - 1 do
      begin
        if trim(vLista2[j]) <> '' then
        begin
          pBuscas.Close;
          pBuscas.SQL.Text := ' select cod_cond_pag from cond_pag ' +
          	' where desc_cond_pag = :desc_cond_pag and ativo = 1 ' +
            ' order by cod_cond_pag ';
          pBuscas.ParamByName('desc_cond_pag').AsString := UpperCase(trim(vLista2[j]));
          pBuscas.Open;
          pBuscas.FetchAll;

          if not pBuscas.IsEmpty then
          begin
            pBuscas.First;
            while not pBuscas.Eof do
            begin
              vListaDesControle.Add(UpperCase(trim(vLista2[j])));
              vListaControle.Add(pBuscas.FieldByName('cod_cond_pag').AsString);
              
              pBuscas.Next;
            end;
          end;
        end;
      end;
    end;

    if vListaControle.Count > 0 then
     if vListaControle.IndexOf(IntToStr(pCodCondPag)) <= -1 then
     begin
         Result := false;
         vtemp := '';
         for I := 0 to vListaDesControle.Count - 1 do
           vtemp := vtemp + trim(vListaControle[I]) + ' - ' + UpperCase(trim(vListaDesControle[I])) + #13;

         vMensagem := 'A condição de pagamento ' +
           '"' + IntToStr(pCodCondPag) + ' - ' + UpperCase(trim(vDesCondPag)) + '" não é permitida para clientes com o tipo de faturamento "BARRADO". ' + #13 +
           IfThen(not pProcess, 'Deseja continuar assim mesmo ou informe umas das condições de pagamento abaixo.' + #13, '') +
           #13 + vtemp;
         if pProcess then
           Application.MessageBox(pchar(vMensagem), 'Atenção', 0 + 64)
         else if Application.MessageBox(pchar(vMensagem), 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = IDNO then
           exit;

         if not pProcess then
           Result := true;   
     end
     else
     begin
     		Result := false;

       	if pProcess then
           if not PesqPros('VND233', 'LIBERAR', QuotedStr(trim(vDesCondPag)) + ' (' + IntToStr(pCodCliente) + ' - ' +
          	trim(vnome_cliente) + ')', vTabela, IntToStr(pNumDoc), pBuscas, True) then
          	exit;
       	Result := true;
     end;

  except on E: Exception do
    begin
      Result := false;
      GravaAuditoria('VND233', 'ENVIAR', 'FALHA', 'PEDVENDA', '', pBuscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TSingleton.verificarControlesCondPagBarrados. Erro: ' + e.Message);
    end;
  end;
end;

