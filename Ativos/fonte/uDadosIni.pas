function TSingleton.getValorCurrencyCasasDecEmp(valor: Currency): Currency;
var
  temp: string;
begin
  try
    temp := getValorStringCasasDecEmp(valor);
    Result := StrToCurr(temp);
  except
    Result := 0;
  end;
end;

function TSingleton.getValorStringCasasDecEmp(valor: Currency): string;
var
  temp: string;
begin
  temp := Trim(Format('%16.' + IntToStr(vEmp.vCasasDecimais) + 'f', [valor]));
  Result := StringReplace(temp, '.', '', [rfReplaceAll, rfIgnoreCase]);
end;

function TSingleton.getValue(pStr: string; pPos: integer; pDelimiter: string;
  StartWithDelimiter: Boolean): string;
begin
  // parecido com a funcao getCampoPipe,
  // porém sempre vai iniciar com um delimitador
  // Ex: |1|nome|endedeco|, onde a string possui 3 itens
  // sempre começa e sempre termina com delimitador
  if StartWithDelimiter then
    pStr := Trim(Copy(pStr, 2, Length(pStr)));
  Result := getCampoPipe(pStr, pPos, pDelimiter);
end;

