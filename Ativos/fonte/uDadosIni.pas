function TSingleton.testarCodBarrasEtiqueta(pSomenteSelecionado: Boolean; pDatasetProd: TDataSet; pTestarHexa: Boolean): boolean;
var
	vListaProdCodBarraErrado: TStringList;
begin
	try
  	if (pTestarHexa) and (vProduto.vUsarCodHexCodbarra) then
    begin
    	Result := True;
      Exit;
    end;

    Result := False;

    if pDatasetProd.IsEmpty then
      Exit;

    vListaProdCodBarraErrado := TStringList.Create;
    vListaProdCodBarraErrado.Clear;

    try
      pDatasetProd.DisableControls;
      pDatasetProd.First;
      while not pDatasetProd.Eof do
      begin
      	if pSomenteSelecionado then
        begin
        	if pDatasetProd.FieldByName('sel').AsString = 'S' then
          begin
          	if Length(trim(pDatasetProd.FieldByName('GRUPO_PROD').AsString)) > vDadosIni.vEmp.vDidgitosGrup then
            begin
              if vListaProdCodBarraErrado.Count >= 10 then
              begin
                vListaProdCodBarraErrado.Add('...');
                Break;
              end;

              vListaProdCodBarraErrado.Add(
                '' + IntToStr(pDatasetProd.FieldByName('GRUPO_PROD').AsInteger) +
                ' - ' + trim(pDatasetProd.FieldByName('COD_PROD').AsString) +
                ' - ' + trim(pDatasetProd.FieldByName('DESCR_PROD').AsString));
            end;
          end;
        end
        else
        begin
          if Length(trim(pDatasetProd.FieldByName('GRUPO_PROD').AsString)) > vDadosIni.vEmp.vDidgitosGrup then
          begin
            if vListaProdCodBarraErrado.Count >= 10 then
            begin
              vListaProdCodBarraErrado.Add('...');
              Break;
            end;

            vListaProdCodBarraErrado.Add(
              '' + IntToStr(pDatasetProd.FieldByName('GRUPO_PROD').AsInteger) +
              ' - ' + trim(pDatasetProd.FieldByName('COD_PROD').AsString) +
              ' - ' + trim(pDatasetProd.FieldByName('DESCR_PROD').AsString));
          end;
        end;

        pDatasetProd.Next;
      end;

      if vListaProdCodBarraErrado.Count > 0 then
      begin
        Application.MessageBox(PChar('Produto(s) com código do grupo maior que ' + IntToStr(vDadosIni.vEmp.vDidgitosGrup) + ' caracter(es).' + #13 + #13 +
          'PRODUTOS' + #13 +
          vListaProdCodBarraErrado.Text + #13 + #13 +
          'Favor verificar a mascara de dígitos para o grupo no cadastro da empresa antes de continuar.'),
          'Atenção', MB_OK + MB_ICONASTERISK + MB_DEFBUTTON1);
        Result := False;
        Exit;
      end;
    finally
    	pDatasetProd.First;
    	pDatasetProd.EnableControls;
    end;

    Result := True;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(PChar('Erro ao testar código de barras etiqueta: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao testar código de barras etiqueta: ' + e.Message);
    end;
  end;
end;

