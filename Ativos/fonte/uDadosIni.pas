   vSpeedButton.Flat := true;
   vSpeedButton.Align := alClient;
   vSpeedButton.Enabled := true;
   vSpeedButton.Visible := true;
   vSpeedButton.Name := 'vSpeedButton';
   vSpeedButton.Hint := 'Send E-mail';
   vSpeedButton.Caption := '';

   if not FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
 	 	 saveResourceToFile('emailrel', 'bmp', ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

 	 if FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
	 	 vSpeedButton.Glyph.LoadFromFile(ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

   if Assigned(vSpeedButton) then
   	 vSpeedButton.OnClick := onClickSendEmailCrystalReport;

   _AlterarFonteCrystalReport(vCrystal);

   vCrystal.ReportName := vPastaRel + '\CX\Conciliação Bancária.rpt';
   vCrystal.ReportTitle := 'RELATÓRIO CONCILIAÇÃO BANCÁRIA';
   vCrystal.GroupSelection.Formula.Clear;
//   vCrystal.GroupSelection.Formula.Text := Formula;
   vCrystal.LogOnServer.Retrieve;

   for i := 0 to vCrystal.ParamFields.Count - 1 do
   begin
      if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'NOMEEMPRESA' then
        vCrystal.ParamFields[i].CurrentValue := vEmp.vnomeEmpresa
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'TPREL' then
        vCrystal.ParamFields[i].CurrentValue := IfThen(pDetalhado, 'ANALÍTICO', 'SINTÉTICO')
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'OUTROSDADOS' then
      begin
        vsubtitulo := 'Tipo Relatório: '+ IfThen(pDetalhado, 'ANALÍTICO', 'SINTÉTICO') + ' ' +
	        'Dia Financerio ' + FormatDateTime('dd/mm/yyyy', vDiaFinanceiroFechado);

        if vEmp.vFinanceiroUnificado then
           vsubtitulo := vsubtitulo + ' ' + 'Código Empresa Unificada (0 - TODAS): ' + IntToStr(pCodEmpUnificada) + ' ' +
		        'Agrupar Empresas Unificadas: ' + Copy(trim(pAgruparUnificada), 1, 1);
            
        vCrystal.ParamFields[i].CurrentValue := vsubtitulo;
      end
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'CODEMPRESA' then
        vCrystal.ParamFields[i].CurrentValue := codEmpresa
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'DIAFINANCEIRO' then
        vCrystal.ParamFields[i].CurrentValue := FormatDateTime('yyyy,mm,dd', vDiaFinanceiroFechado)
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'CODEMPUNIFICADA' then
        vCrystal.ParamFields[i].CurrentValue := IntToStr(pCodEmpUnificada)
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'AGRUPARUNIFICADAS' then
        vCrystal.ParamFields[i].CurrentValue := Copy(trim(pAgruparUnificada), 1, 1)
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'AGRUPARUNIFICADAS_QSRT' then
        vCrystal.ParamFields[i].CurrentValue := QuotedStr(Copy(trim(pAgruparUnificada), 1, 1))
      else if UpperCase(trim(vCrystal.ParamFields[i].Name)) = 'DATA_INICIO_CONC_BANC' then
      	vCrystal.ParamFields[i].CurrentValue := FormatDateTime('yyyy,mm,dd', StrToDateTime(pDataInicioConcBanc));
   end;

   vUs := string(__getUsuarioFDB);
   vPw := string(__getSenhaFDB);

   if (Trim(vPw) <> '') then
     vCrystal.LogOnServer.Item.Password := string(__descriptografaTextoFDB(Pchar(vPw)))
   else
     vCrystal.LogOnServer.Item.Password := 'masterkey';
   vCrystal.LogOnServer.Item.DLLName := 'pdsodbc.dll';
   vCrystal.Connect.DatabaseName := vBancoHW;

   if (Trim(vPw) <> '') then
     vCrystal.Connect.Password := string(__descriptografaTextoFDB(Pchar(vPw)))
   else
     vCrystal.Connect.Password := 'masterkey';
   vCrystal.Connect.ServerName := 'admin';
   if (Trim(vUs) <> '') then
     vCrystal.Connect.UserID := string(__descriptografaTextoFDB(Pchar(vUs)))
   else
     vCrystal.Connect.UserID := 'SYSDBA';

   for i := 0 to (vCrystal.LogOnServer.Count - 1) do
   begin
     if not vCrystal.LogOnServer.Items[i].LogOn then
     begin
       Application.MessageBox(pchar('Erro de conexão com o banco de dados: ' + vCrystal.LastErrorString), 'Informação', MB_ICONERROR + MB_OK);
       exit;
     end;
   end;  

	 if vCrystal.Connect.Test then
   begin
//     vCrystal.Execute; //vCrystal.Show;
     vForm.WindowState := wsMaximized;
     vForm.BorderIcons := [biSystemMenu, biMinimize, biMaximize];
     Screen.Cursor := crDefault;
     vForm.OnShow := FormShowCrpe;
     vForm.ShowModal;
   end;
 finally
   Screen.Cursor := crDefault;
   if Assigned(vSpeedButton) then
	 	 FreeAndNil(vSpeedButton);
   if Assigned(vPanel) then
	   FreeAndNil(vPanel);
   if Assigned(vForm) then
     FreeAndNil(vForm);
   if Assigned(vCrystal) then
     vCrystal.free;
 end;
end;

function TSingleton.imprimirReciboLocacao(
	pBuscas: TIBQuery;
  pNped: Integer;
  pTipo: string;
  pCodCliente: Integer;
  pOrigemImp: string;
  pExibirMensagem: boolean = True;
  pImprimirRel: boolean = True;
  pAbrirFormImportarRel: boolean = True;
  pExportarRel: boolean = False): boolean;
var
	vForm: TForm;
  vPanel: TPanel;
  vSpeedButton: TSpeedButton;
  vPw, vUs : string;
  vEmail: string;
  ConfigImp: TConfig_sistema_class;
  sText, sPrintName, sPdfFile: WideString;
  vImprimirCXL, vProduto, vServico, vProdutoTerc, vServicoTerc: string;
  vOrigemServ: string;
  vImprimir: boolean;
  arrayOrigensServ: hw_utils.ArrayString;
  vDescrOrigemServTmp: string;
  vOrigemServTmp: string;
  I: Integer;
begin
	try
    result := false;
    vOrigemServTmp := '';
    vDescrOrigemServTmp := '';

    ConfigImp := TConfig_sistema_class.getConf('ped_vnd_impressao_recibo_locacao', pBuscas, cod_empresa);

    if (UpperCase(ConfigImp.ReadString('Conf_Geral', 'ImprimirAposRecebimentoCXL')) = 'S') then
      vImprimirCXL := 'S'
    else
    	vImprimirCXL := 'N';

    if (trim(pOrigemImp) = 'CXL') and (vImprimirCXL <> 'S') then
    begin
    	Result := True;
      exit;
    end;
      
    if (UpperCase(ConfigImp.ReadString('Conf_Produto', 'Exibir')) = 'S') then
      vProduto := 'S'
    else
    	vProduto := 'N';

    if (UpperCase(ConfigImp.ReadString('Conf_Servico', 'Exibir')) = 'S') then
      vServico := 'S'
    else
    	vServico := 'N';

    if (UpperCase(ConfigImp.ReadString('Conf_Servico', 'Origem')) <> '') then
    	vOrigemServ := UpperCase(ConfigImp.ReadString('Conf_Servico', 'Origem'))
    else
    	vOrigemServ := '|TODOS|';

    if (UpperCase(ConfigImp.ReadString('Conf_ProdTerc', 'Exibir')) = 'S') then
      vProdutoTerc := 'S'
    else
    	vProdutoTerc := 'N';

    if (UpperCase(ConfigImp.ReadString('Conf_ServTerc', 'Exibir')) = 'S') then
      vServicoTerc := 'S'
    else
    	vServicoTerc := 'N';

    if (vProduto <> 'S') and (vServico <> 'S') and (vProdutoTerc <> 'S') and (vServicoTerc <> 'S') then
    begin
    	if pExibirMensagem then
        Application.MessageBox(Pchar('Nenhuma opção informada nas configurações do RECIBO DE LOCAÇÃO: ' + #13 + #13 +
          'Opções: Produto, Serviço, ProdTerc, e ServTerc' + #13 + #13 +
          'Antes de continuar.'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;

    vImprimir := false;

    SqlOpen(' select NPED, TIPO, COD_EMPRESA, STATUS_PED from PEDVENDA ' +
        ' where NPED = ' + IntToStr(pNped) +
        ' and TIPO = ' + QuotedStr(pTipo) +
        ' and COD_EMPRESA = ' + codEmpresa, pBuscas);

    if (trim(pBuscas.FieldByName('STATUS_PED').AsString) = 'CANCELADO') then
    begin
      Result := True;
      exit;
    end;

    if (vProduto = 'S') and (not vImprimir) then
    begin
      vImprimir := not SqlOpen(' select FIRST 1 PEDVENDA_PROD.NPED, PEDVENDA_PROD.TIPO, PEDVENDA_PROD.COD_EMPRESA from PEDVENDA_PROD ' +
        ' where PEDVENDA_PROD.NPED = ' + IntToStr(pNped) +
        ' and PEDVENDA_PROD.TIPO = ' + QuotedStr(pTipo) +
        ' and PEDVENDA_PROD.COD_EMPRESA = ' + codEmpresa +
        ' and (PEDVENDA_PROD.STATUS <> ''CANCELADO'' OR PEDVENDA_PROD.STATUS IS NULL) ', pBuscas).IsEmpty;
    end;

    if (vServico = 'S') and (not vImprimir) then
    begin
      if trim(vOrigemServ) = '' then
        vOrigemServ := '|TODOS|'
      else if ContainsStr(trim(vOrigemServ), '|TODOS|') then
        vOrigemServ := '|TODOS|'
      else
      begin
        arrayOrigensServ := NewArrayString(vOrigemServ, '|');

        if Length(arrayOrigensServ) > 0 then
        begin
          for I := 0 to Length(arrayOrigensServ) - 1 do
          begin
          	if not SqlOpen(' select * from tipo_tipo_servico ' +
            	'where sigla = ' + QuotedStr(trim(arrayOrigensServ[I])), pBuscas).IsEmpty then
              	vDescrOrigemServTmp := vDescrOrigemServTmp + trim(pBuscas.FieldByName('sigla').AsString) + ' - ' + trim(pBuscas.FieldByName('descricao').AsString) + #13;

            if trim(vOrigemServTmp) = '' then
              vOrigemServTmp := '''' + UpperCase(trim(arrayOrigensServ[I])) + ''''
            else
              vOrigemServTmp := vOrigemServTmp + ',' + '''' + UpperCase(trim(arrayOrigensServ[I])) + '''';
          end;

          vOrigemServTmp := '(' + vOrigemServTmp + ')';
        end
        else
        	vOrigemServ := '|TODOS|';
      end;

      vImprimir := not SqlOpen(' select FIRST 1 PEDVENDA_SERV.NPED, PEDVENDA_SERV.TIPO, PEDVENDA_SERV.COD_EMPRESA from PEDVENDA_SERV ' +
        ' LEFT JOIN TIPO_SERVICO ON TIPO_SERVICO.COD_SERVICO = PEDVENDA_SERV.COD_SERVICO ' +
        ' where PEDVENDA_SERV.NPED = ' + IntToStr(pNped) +
        ' and PEDVENDA_SERV.TIPO = ' + QuotedStr(pTipo) +
        ' and PEDVENDA_SERV.COD_EMPRESA = ' + codEmpresa +
        ' and (PEDVENDA_SERV.STATUS <> ''CANCELADO'' OR PEDVENDA_SERV.STATUS IS NULL) ' +
        IfThen(trim(vOrigemServTmp) <> '',
          ' and TIPO_SERVICO.STIPO in ' + trim(vOrigemServTmp), ''), pBuscas).IsEmpty;
    end;

    if (vProdutoTerc = 'S') and (not vImprimir) then
    begin
      vImprimir := not SqlOpen(' select FIRST 1 PEDVENDA_PROD_TERC.NPED, PEDVENDA_PROD_TERC.TIPO, PEDVENDA_PROD_TERC.COD_EMPRESA from PEDVENDA_PROD_TERC ' +
        ' where PEDVENDA_PROD_TERC.NPED = ' + IntToStr(pNped) +
        ' and PEDVENDA_PROD_TERC.TIPO = ' + QuotedStr(pTipo) +
        ' and PEDVENDA_PROD_TERC.COD_EMPRESA = ' + codEmpresa, pBuscas).IsEmpty;
    end;

    if (vServicoTerc = 'S') and (not vImprimir) then
    begin
      vImprimir := not SqlOpen(' select FIRST 1 PEDVENDA_SERV_TERC.NPED, PEDVENDA_SERV_TERC.TIPO, PEDVENDA_SERV_TERC.COD_EMPRESA from PEDVENDA_SERV_TERC ' +
        ' where PEDVENDA_SERV_TERC.NPED = ' + IntToStr(pNped) +
        ' and PEDVENDA_SERV_TERC.TIPO = ' + QuotedStr(pTipo) +
        ' and PEDVENDA_SERV_TERC.COD_EMPRESA = ' + codEmpresa, pBuscas).IsEmpty;
    end;
    
    if not vImprimir then
    begin
    	if pExibirMensagem then
      begin
      	if (vProduto = 'S') and (vServico <> 'S') and (vProdutoTerc <> 'S') and (vServicoTerc <> 'S') then
          Application.MessageBox(Pchar('Nenhum produto encontrado na Ordem de Serviço, ' +
            'favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else if (vProduto <> 'S') and ((vServico = 'S') and (ContainsStr(trim(vOrigemServ), '|TODOS|'))) and (vProdutoTerc <> 'S') and (vServicoTerc <> 'S') then
        	Application.MessageBox(Pchar('Nenhum serviço encontrado na Ordem de Serviço, ' +
            'favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else if (vProduto <> 'S') and ((vServico = 'S') and (not ContainsStr(trim(vOrigemServ), '|TODOS|'))) and (vProdutoTerc <> 'S') and (vServicoTerc <> 'S') then
        	Application.MessageBox(Pchar('Nenhum serviço encontrado na Ordem de Serviço das origens: ' + #13 + #13 +
          	vDescrOrigemServTmp + #13 +
            'Favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else if (vProduto <> 'S') and (vServico <> 'S') and (vProdutoTerc = 'S') and (vServicoTerc <> 'S') then
        	Application.MessageBox(Pchar('Nenhum produto de terceiro encontrado na Ordem de Serviço, ' +
            'favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else if (vProduto <> 'S') and (vServico <> 'S') and (vProdutoTerc <> 'S') and (vServicoTerc = 'S') then
        	Application.MessageBox(Pchar('Nenhum serviço de terceiro encontrado na Ordem de Serviço, ' +
            'favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else
        	Application.MessageBox(Pchar('Nenhum item encontrado na Ordem de Serviço de acordo com as configurações do recibo de locação: ' + #13 + #13 +
            'Configurações: ' + #13 +
            'Produto= ' + vProduto + #13 +
            'Servico= ' + vServico + ' Origem= ' + trim(vOrigemServ) + #13 +
            'ProdTerc=' + vProdutoTerc + #13 +
            'ServTerc=' + vServicoterc + #13 + #13 + 
            'Favor vericar antes de imprimir o RECIBO DE LOCAÇÃO'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      end;
    	Result := False;
      exit;
    end;

    if (trim(pOrigemImp) = 'CXL') then
    begin
    	if Application.MessageBox('Deseja imprimir o recibo de locação?',
        'Confirmação', MB_YESNO + MB_DEFBUTTON2) <> IDYES then
      begin
        Result := True;
        exit;
      end;
    end;

    vCrystal := TCrpe.Create(nil);
    vCrystal.WindowButtonBar.GroupTree := true;
    vCrystal.WindowButtonBar.CancelBtn := true;
    vCrystal.WindowButtonBar.SearchBtn := true;
    vCrystal.WindowButtonBar.AllowDrillDown := true;
    vCrystal.WindowButtonBar.DocumentTips := true;
    vCrystal.WindowButtonBar.PrintSetupBtn := true;
    if pTipo = 'REQ' then
    begin
    	vCrystal.SummaryInfo.Title := 'Requisição - Avançado 5';
  	  vCrystal.SummaryInfo.AppName := 'Requisição - Avançado 5';
    	vCrystal.WindowStyle.Title := 'Requisição - Avançado 5';
    end
    else if pTipo = 'OS' then
    begin
	    vCrystal.SummaryInfo.Title := 'Ordem de Serviço - Avançado 5';
  	  vCrystal.SummaryInfo.AppName := 'Ordem de Serviço - Avançado 5';
    	vCrystal.WindowStyle.Title := 'Ordem de Serviço - Avançado 5';
    end
    else
    begin
	    vCrystal.SummaryInfo.Title := 'Orçamento - Avançado 5';
  	  vCrystal.SummaryInfo.AppName := 'Orçamento - Avançado 5';
    	vCrystal.WindowStyle.Title := 'Orçamento - Avançado 5';
    end;
    vCrystal.WindowState := wsMaximized;
    vCrystal.WindowStyle.BorderStyle := bsNone;
    crpeTmp := vCrystal;

    vForm:= TForm.Create(nil);
    vForm.bordericons:= [bisystemmenu];
    vForm.OnResize:= OnCrpeViewerResize;
    vForm.ShowHint := true;
    vForm.Caption := vCrystal.SummaryInfo.Title;
    vCrystal.WindowParent:= vForm;

    vPanel := TPanel.Create(nil);
    vPanel.Parent := vForm;
    vPanel.Height := 19;
    vPanel.Width := 19;
    vPanel.Top := 4;
    vPanel.Left := 513;
    vPanel.TabOrder := 0;
    vPanel.BevelInner := bvNone;
    vPanel.BevelKind := bkNone;
    vPanel.BevelOuter := bvNone;
    vPanel.Name := 'vPanel';
    vPanel.Caption := '';

    vSpeedButton := TSpeedButton.Create(nil);
    vSpeedButton.Parent := vPanel;
    vSpeedButton.Flat := true;
    vSpeedButton.Align := alClient;
    vSpeedButton.Enabled := true;
    vSpeedButton.Visible := true;
    vSpeedButton.Name := 'vSpeedButton';
    vSpeedButton.Hint := 'Send E-mail';
    vSpeedButton.Caption := '';

    if not FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
      saveResourceToFile('emailrel', 'bmp', ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

    if FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
      vSpeedButton.Glyph.LoadFromFile(ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

    if Assigned(vSpeedButton) then
    begin
    	vDadosIni._LimparVarSendEmail;
      vDadosini.CodClienteSendEmail := pCodCliente;
      vDadosini.OrigemEnvSendEmail := cReciboLoc;
      vDadosini.NDocSendEmail := IntToStr(pNped);
      vDadosini.TipoDocSendEmail := trim(pTipo);
    	vSpeedButton.OnClick := onClickSendEmailCrystalReport;
    end;

    _AlterarFonteCrystalReport(vCrystal);
    
    vCrystal.ReportName := ExtractFilePath(Application.Exename) + 'recibo_locacao.rpt';

    vCrystal.ReportTitle := 'Recibo Locação';

    vCrystal.LogOnServer.Retrieve;

    SqlOpen('select COD_EMPRESA, EMAIL_EMP from empresa ' +
      ' where COD_EMPRESA = ' + codEmpresa, pBuscas);
      
    vEmail := pBuscas.FieldByName('EMAIL_EMP').AsString;

    for i := 0 to (vCrystal.ParamFields.Count - 1) do
    begin
    	if Pos('NPED', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
      	vCrystal.ParamFields[i].CurrentValue := IntToStr(pNped)
      else if Pos('TIPO', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
      	vCrystal.ParamFields[i].CurrentValue := trim(pTipo)
      else if Pos('CODEMPRESA', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
      	vCrystal.ParamFields[i].CurrentValue := codEmpresa
      else if Pos('EXIBIR_PRODUTO', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
        vCrystal.ParamFields[i].CurrentValue := vProduto
      else if Pos('EXIBIR_SERVICO', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
        vCrystal.ParamFields[i].CurrentValue := vServico
      else if Pos('EXIBIR_PRODTERC', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
        vCrystal.ParamFields[i].CurrentValue := vProdutoTerc
      else if Pos('EXIBIR_SERVTERC', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
        vCrystal.ParamFields[i].CurrentValue := vServicoTerc
      else if Pos('ORIGEM_SERV', UpperCase(trim(vCrystal.ParamFields[i].Name))) > 0 then
        vCrystal.ParamFields[i].CurrentValue := vOrigemServ;
    end;

    vUs := string(__getUsuarioFDB);
    vPw := string(__getSenhaFDB);

    if (Trim(vPw) <> '') then
