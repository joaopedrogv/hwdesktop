procedure TSingleton.setDataSetNameByGridCadPadrao(DBGridName,
  DataSetName: string; pAlteracao: boolean; pListGridsAndDataSets: TStrings);
var
  Adicionar: Boolean;
  I: Integer;
  StrAlteracao: string;
begin
  if pAlteracao then
    StrAlteracao := 'True'
  else
    StrAlteracao := 'False';
  if pListGridsAndDataSets = nil then
    pListGridsAndDataSets := TStringList.Create;
  Adicionar := True;
  for I := 0 to pListGridsAndDataSets.Count - 1 do
    if getValue(pListGridsAndDataSets[I], 1) = DBGridName then
    begin
      pListGridsAndDataSets[I] := '|' + DBGridName + '|' + DataSetName + '|' + StrAlteracao + '|';
      Adicionar := False;
      Break;
    end;
  if Adicionar then
    pListGridsAndDataSets.Add('|' + DBGridName + '|' + DataSetName + '|' + StrAlteracao + '|');
end;

function TSingleton.SetJPGCompression(
	ACompression: integer;
  var AInFile: string;
  var AOutFile: string): boolean;
var
	iCompression : integer;
  oJPG : TJPegImage;
  oBMP: TBitMap;
begin
	try
    try
      Result := False;

      if not DirectoryExists(ExtractFileDir(AInFile)) then
      begin
        Application.MessageBox(PChar('Diretório não encontrado: ' + #13 +
        	ExtractFileDir(AInFile)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not FileExists(AInFile) then
      begin
        Application.MessageBox(PChar('Arquivo não encontrado: ' + #13 +
        	AInFile), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not DirectoryExists(ExtractFileDir(AOutFile)) then
      begin
        Application.MessageBox(PChar('Diretório não encontrado: ' + #13 +
        	ExtractFileDir(AOutFile)), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      // Forçar a Compressão para faixa entre 1..100
      iCompression := abs(ACompression);
      if iCompression = 0 then
        iCompression := 1;
      if iCompression > 100 then
        iCompression := 100;

      // Cria as classes de trabalho Jpeg e Bmp
      oJPG := TJPegImage.Create;
      oJPG.LoadFromFile(AInFile);

      oBMP := TBitMap.Create;
      oBMP.Assign(oJPG);

      // Fazer a compressão e salva o novo arquivo
      oJPG.CompressionQuality := iCompression;
      oJPG.Compress;

      if UpperCase(ExtractFilePath(trim(AInFile))) <> UpperCase(ExtractFilePath(trim(AOutFile))) then
      begin
        while True do
        begin
          if not FileExists(AOutFile) then
            Break
          else
          begin
            AOutFile :=
              StringReplace(
                AOutFile,
                  ExtractFileExt(AOutFile), '', [rfIgnoreCase]) + '1' +
                    ExtractFileExt(AOutFile);
          end;
        end;
      end;

      oJPG.SaveToFile(AOutFile);

      // Limpar
      oJPG.Free;
      oBMP.Free;

      if FileExists(AOutFile) then
        Result := True
      else
      begin
        registraErro('Falha ao salvar imagem ' + trim(AOutFile));
        Result := False;
        exit;
      end;

    except on E: Exception do
      begin
        registraErro('Falha ao compactar imagem:' + #13 + #13 +
        'ARQUIVO' + #13 +
        'de: ' + AInFile + #13 +
        'para: ' + AOutFile + #13 + #13 +
        'Erro: ' + E.Message);
        Result := False;
      end;
    end;
  finally
  	// Não deletar imagem origem
//  	if UpperCase(ExtractFilePath(trim(AInFile))) <> UpperCase(ExtractFilePath(trim(AOutFile))) then
//    begin
//      if FileExists(AOutFile) then
//        if FileExists(AInFile) then
//          DeleteFile(PChar(AInFile));
//    end;
  end;
end;

