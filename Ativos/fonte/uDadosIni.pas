function TSingleton.abreFormImagensProduto(pDescProd, grupoProd, codProd,
  numFabProd: string; PrecTab, PrecPub: Double; AQuery: TIBQuery): boolean;
var
  AProcedure: TabreFormImagensProduto;
  AQueryRescue: TIBQuery;
  AUseQueryIni: Boolean;
begin
  try
    if (Assigned(AQuery)) and     // transacao do parametro
       (Assigned(vQueryTmp)) then // transacao do dadosini
      AQueryRescue := vQueryTmp; // transacao para recuperar no finally

    if vProduto.AHandle = 0 then
      CarregaPacote('pkProdutos', vProduto.AHandle);

    if vProduto.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Produtos não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vProduto.AHandle, 'abreFormImagensProduto');

    if Assigned(AProcedure) then
    begin
      if Assigned(AQuery) then
      begin
        vQueryTmp := AQuery;
        AUseQueryIni := True;
      end
      else
        AUseQueryIni := False;
      Result := AProcedure(pDescProd, grupoProd, codProd, numFabProd, PrecTab, PrecPub, AUseQueryIni);
    end;
  finally
    if Assigned(AQueryRescue) then
      vQueryTmp := AQueryRescue;
  end;
end;

function TSingleton.abreFormInserirContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pTipoContato: TTipoContato): Boolean;
var
	I: Integer;
begin
	Result := False;

  if not Assigned(vListaContatoTemp) then
    vListaContatoTemp := TStringList.Create;
  vListaContatoTemp.Clear;

  try
    Application.CreateForm(TFrmContato, FrmContato);
    FrmContato.codcliente := pCodCliente;
    FrmContato.origemenv := pOrigem;
    FrmContato.aplicativo := '';
    FrmContato.idcontado := 0;
    FrmContato.tipocontato := pTipoContato;

    if (pCodCliente <= 0) or (pTipoContato = cTpContatoOutros) or (vHwCloudIA.vUsarServMensageria = 'S') then
    begin
      FrmContato.lb_contrato_pla_tipos_contato.Visible := (pCodCliente > 0) and (pTipoContato <> cTpContatoOutros);
      FrmContato.ck_contrato_pla_tipos_contato.Visible := (pCodCliente > 0) and (pTipoContato <> cTpContatoOutros);
      FrmContato.sbAdicionarTipoContatoAplicativo.Visible := (pCodCliente > 0) and (pTipoContato <> cTpContatoOutros);
      FrmContato.btSelectAllTipoContato.Visible := (pCodCliente > 0) and (pTipoContato <> cTpContatoOutros);
      FrmContato.btUnSelectAllTipoContato.Visible := (pCodCliente > 0) and (pTipoContato <> cTpContatoOutros);

      FrmContato.lb_contato_pla_identificacao.Caption := 'Identificação:';
      FrmContato.ed_contato_pla_identificacao.EditMask := '';
      FrmContato.ed_contato_pla_identificacao.OnKeyPress := nil;

      FrmContato.ed_contato_pla_aplicativo.ItemIndex := -1;
      FrmContato.ed_contato_pla_contato.Text := '';
      FrmContato.ed_contato_pla_identificacao.Text := '';

      retornaComboboxAplicativo(FrmContato.ed_contato_pla_aplicativo);
      retornaCheckListTipoContato(FrmContato.ck_contrato_pla_tipos_contato);

      if FrmContato.ck_contrato_pla_tipos_contato.Count = 1 then
        FrmContato.ck_contrato_pla_tipos_contato.Checked[0] := True;

      FrmContato.TabSheet2.Show;
    end
    else
    begin
      FrmContato.cbTipoContato.ItemIndex := -1;
      FrmContato.EdContato.Text := '';
      FrmContato.meTelefone.Text := '';
      FrmContato.meEmail.Text := '';

      retornaComboboxTipoContato(FrmContato.cbTipoContato);

      FrmContato.TabSheet1.Show;
    end;

    Result := FrmContato.ShowModal = IDOK;

  except on E: Exception do
    begin
      Application.MessageBox(PChar('Erro ao inserir contato cliente: ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao inserir contato cliente: ' + e.Message);
    end;
  end;
end;

