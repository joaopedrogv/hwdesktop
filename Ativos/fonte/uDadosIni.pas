procedure TSingleton.SalvardadosnoExcelCadPadraoClick(Sender: TObject; pDBGrid: TDBGrid; pusuario: string; ptrans: TIBTransaction;
  var plbStatusProcessamento, plbTextoProcessamento: TLabel; pnStatusProcessamento: TPanel; pCaption: string);
var
  vRecNo: Integer;
begin
  try
    Screen.Cursor := crHourGlass;
    pDBGrid.DataSource.DataSet.DisableControls;
    plbStatusProcessamento.Caption := 'Status de processamento';
    plbTextoProcessamento.Caption := 'Montando Excel';
    pnStatusProcessamento.Top := Trunc((Application.MainForm.Height - pnStatusProcessamento.Height) / 2);
    pnStatusProcessamento.Left := Trunc((Application.MainForm.Width - pnStatusProcessamento.Width) / 2);
    pnStatusProcessamento.Visible := True;
    if not pDBGrid.DataSource.DataSet.IsEmpty then
      vRecNo := pDBGrid.DataSource.DataSet.RecNo;
    montarExcelCadPadrao(pDBGrid, pusuario, ptrans, pCaption);
  finally
    pnStatusProcessamento.Visible := False;
    if not pDBGrid.DataSource.DataSet.IsEmpty then
      pDBGrid.DataSource.DataSet.RecNo := vRecNo;
    pDBGrid.DataSource.DataSet.EnableControls;
    Screen.Cursor := crDefault;
  end;
end;

procedure TSingleton.salvarGridNoConfigColunasCadPadrao(PGridCfg, PGridCfg2: TDBGrid; pcdsGrid, pcdsColunas: TClientDataSet; pusuario: string; pListGridsAndDataSets: TStrings; ptrans: TIBTransaction; pAlterarNomeDtSet: string = '');
var
  I, K: Integer;
  Visivel: Boolean;
  Largura, Ordem: Integer;
  ListOrder: TStrings;

  procedure obterDadosGrid(FieldName: string);
  var
    J: Integer;
  begin
    for J := 0 to PGridCfg2.Columns.Count - 1 do
      if PGridCfg2.Columns[J].FieldName = FieldName then
      begin
      	Visivel := PGridCfg2.Columns[J].Visible;
        Largura := PGridCfg2.Columns[J].Width;
//        Ordem := PGridCfg2.Columns[J].Index;
        Break;
      end;
  end;

begin
  if PGridCfg = nil then
    Exit;
  PGridCfg2 := TDBGrid(PGridCfg);
  if not Assigned(PGridCfg2.DataSource) then
    Exit;
  if not Assigned(PGridCfg2.DataSource.DataSet) then
    Exit;
  pcdsGrid := TClientDataSet(PGridCfg2.DataSource.DataSet);

  ListOrder := TStringList.Create;
  ListOrder.Clear;
  for I := 0 to pcdsGrid.Fields.Count - 1 do
    ListOrder.Add(pcdsGrid.Fields[i].FieldName);
  for K := PGridCfg2.Columns.Count - 1 downto 0 do
    if PGridCfg2.Columns[K].Visible then
    begin
      I := ListOrder.IndexOf(PGridCfg2.Columns[K].FieldName);
      if I > -1 then
      begin
        ListOrder.Delete(I);
        ListOrder.Insert(0, PGridCfg2.Columns[K].FieldName);
      end;
    end;
  pcdsColunas.Close;
  pcdsColunas.CommandText := ' select * from config_colunas ' +
  	' where usuario = ' + QuotedStr(pusuario)+
    ' and componente = ' + QuotedStr(getDataSetNameByGridCadPadrao(PGridCfg2.Name, pcdsGrid.Name, pListGridsAndDataSets) + pAlterarNomeDtSet);
  pcdsColunas.Open;
  for I := 0 to pcdsGrid.Fields.Count - 1 do
  begin
//    Ordem := -1;
    Ordem := ListOrder.IndexOf(pcdsGrid.Fields[I].FieldName);
    Largura := 0;
    Visivel := False;
//    if pcdsGrid.Fields[I].Visible then
    obterDadosGrid(pcdsGrid.Fields[I].FieldName);
    if pcdsColunas.Locate('campos', pcdsGrid.Name + pcdsGrid.Fields[I].FieldName, []) then
    begin
      pcdsColunas.Edit;
      if Visivel then //pcdsGrid.Fields[I].Visible then
      begin
        pcdsColunas.FieldByName('visivel').AsInteger := 1;
        pcdsColunas.FieldByName('ordem').AsInteger   := Ordem;
      end
      else
        pcdsColunas.FieldByName('visivel').AsInteger := 0;
      if Largura > 0 then
        pcdsColunas.FieldByName('largura_exibicao').AsInteger :=  Largura;
      pcdsColunas.Post;
    end
    else
    begin
      pcdsColunas.Insert;
      if Visivel then //pcdsGrid.Fields[I].Visible then
        pcdsColunas.FieldByName('visivel').AsInteger := 1
      else
        pcdsColunas.FieldByName('visivel').AsInteger := 0;
      pcdsColunas.FieldByName('usuario').AsString           := pusuario;
      pcdsColunas.FieldByName('componente').AsString        := getDataSetNameByGridCadPadrao(PGridCfg2.Name, pcdsGrid.Name, pListGridsAndDataSets) + pAlterarNomeDtSet;
      pcdsColunas.FieldByName('campos').AsString            := pcdsGrid.Name + pcdsGrid.Fields[I].FieldName;
      pcdsColunas.FieldByName('ordem').AsInteger            := Ordem;
      if Largura > 0 then
        pcdsColunas.FieldByName('largura_exibicao').AsInteger :=  Largura;
      pcdsColunas.Post;
    end;
  end;

  if pcdsColunas.ChangeCount > 0 then
  begin
    pcdsColunas.ApplyUpdates(-1);
    ptrans.Commit;
    ptrans.StartTransaction;
  end;
end;

function TSingleton.saveResourceToFile(ResName, ResType,
  FileDestination: string): Boolean;
var
  Res: TResourceStream;
begin
  try
    Res := TResourceStream.Create(HInstance, ResName, PChar(ResType));
    try
      Res.SaveToFile( FileDestination );
      Result := True;
    finally
      Res.Free;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('TSingleton.saveResourceToFile. Erro: ' + E.Message);
      Application.MessageBox(PChar('Erro ao salvar arquivo do resource. Erro: ' + e.Message),
        'Erro', MB_ICONERROR + MB_OK);
    end;
  end;
end;

procedure TSingleton.selAllContatoCliente(
	pCodCliente: Integer;
  pOrigem: TOrigemEnv;
  pCheckListContato: TCheckListBox);
var
	I: Integer;
begin
	try
    for I := 0 to pCheckListContato.Count - 1 do
    begin
    	if pCheckListContato.ItemEnabled[i] then
      begin
        pCheckListContato.ItemIndex := I;

        if not permiteSelecionarContato(pCodCliente, pOrigem, pCheckListContato, False) then
          pCheckListContato.Checked[I] := False
        else
          pCheckListContato.Checked[I] := True;

        if pCodCliente > 0 then
        begin
          pCheckListContato.ItemIndex := I;
          if not vDadosIni.inserirRemoverContatoEnv(
            pCodCliente,
            pOrigem,
            pCheckListContato) then
              pCheckListContato.Checked[I] := False;
        end;
      end;
    end;

    if pCheckListContato.Count > 0 then
      pCheckListContato.ItemIndex := 0;
  except on E: Exception do
    begin
      registraErro('TSingleton.selAllContatoCliente. Erro: ' + E.Message);
      Application.MessageBox(PChar('Erro ao marcar todos contato. Erro: ' + e.Message),
        'Erro', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TSingleton.selecionar_convenio(
	pImprimir: boolean;
  pEnviar: boolean;
  pOrigem: TOrigemEnv;
	pListBoletas: TStringList;
  pExibirPergunta: Boolean): Integer;
var
  AProcedure: Tselecionar_convenio;
begin
  try
  	Result := 0;
    if vBoletos.AHandle = 0 then
      CarregaPacote('pkBoletos', vBoletos.AHandle);

    if vBoletos.AHandle = 0 then
    begin
      Application.MessageBox('Pacote Boletos não carregado', 'Atenção', 0 + 64);
      Exit;
    end;
    @AProcedure := GetProcAddress(vBoletos.AHandle, 'selecionar_convenio');
    if Assigned(AProcedure) then
      Result := AProcedure(
      	pImprimir,
        pEnviar,
        pOrigem,
      	pListBoletas,
        pExibirPergunta);
  finally
  end;
end;

