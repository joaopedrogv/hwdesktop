function TSingleton.testarContasLigacao(pBuscas: TIBQuery; pTipo: string): boolean;
var
	buscas: TIBQuery;
begin
	try
    Result := False;

    buscas := TIBQuery.Create(Application);
    buscas.Database := pBuscas.Database;
    buscas.Transaction := pBuscas.Transaction;

    pBuscas.Close;
    pBuscas.SQL.Text := ' select * from cont_lig ' +
      ' where cod_emp = ' + codEmpresa;
    pBuscas.Open;

    // Nº da Conta para Venda de Produtos
    if ((pTipo = 'EMP')
    		or (pTipo = 'RET_BOL')
        or (pTipo = 'IMP_AUT')
        or (pTipo = 'PREST')
        or (pTipo = 'CHQ')
        or (pTipo = 'LANC')
        or (pTipo = 'UNIF_EMP')) then
    begin
    	if ((pTipo = 'RET_BOL')
      		or (pTipo = 'IMP_AUT')
          or (pTipo = 'UNIF_EMP')
          or (pTipo = 'PREST')
          or (pTipo = 'CHQ')
          or (pTipo = 'LANC'))
      	and (pBuscas.FieldByName('NCON_V_PROD').AsFloat <= 0) then
      begin
      	Application.MessageBox(pchar('Nº da Conta para Venda de Produtos não informada no cadastro da empresa'), pchar('Erro'), MB_ICONERROR + MB_OK);
        Exit;
      end;

      if (pBuscas.FieldByName('NCON_V_PROD').AsFloat > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select n_conta_plc, tipo_plc from p_contas ' +
          ' where n_conta_plc = :n_conta_plc';
        buscas.ParamByName('N_CONTA_PLC').AsFloat := pBuscas.FieldByName('NCON_V_PROD').AsFloat;
        buscas.Open;

        if buscas.IsEmpty then
        begin
          Application.MessageBox(pchar('Nº da Conta para Venda de Produtos informada no cadastro da empresa não encontrada'), pchar('Erro'), MB_ICONERROR + MB_OK);
          Exit;
        end
        else if buscas.FieldByName('TIPO_PLC').AsString <> 'E' then
        begin
          Application.MessageBox(pchar('Nº da Conta para Venda de Produtos informada no cadastro da empresa deve ser da natureza Entrada'), pchar('Erro'), MB_ICONERROR + MB_OK);
          Exit;
        end;
      end;
    end;

    // Controle para Venda de Produtos
    if ((pTipo = 'EMP')
    		or (pTipo = 'RET_BOL')
        or (pTipo = 'IMP_AUT')
        or (pTipo = 'PREST')
        or (pTipo = 'CHQ')) then
    begin
    	if ((pTipo = 'RET_BOL')
      		or (pTipo = 'IMP_AUT')
          or (pTipo = 'PREST')
          or (pTipo = 'CHQ'))
      	and (pBuscas.FieldByName('CONTR_V_PROD').AsInteger <= 0) then
      begin
      	Application.MessageBox(pchar('Controle para Venda de Produtos não informado no cadastro da empresa'), pchar('Erro'), MB_ICONERROR + MB_OK);
        Exit;
      end;

      if (pBuscas.FieldByName('CONTR_V_PROD').AsInteger > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select codigo_ctrl from controles ' +
          ' where codigo_ctrl = :codigo_ctrl ' +
          ' and codigo_emp = :codigo_emp ' +
          ' and ativo <> 99 ';
        buscas.ParamByName('CODIGO_CTRL').AsInteger := pBuscas.FieldByName('CONTR_V_PROD').AsInteger;
        buscas.ParamByName('CODIGO_EMP').AsInteger := StrToInt(codEmpresa);
