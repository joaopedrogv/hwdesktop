procedure TSingleton.verificarControleCheque_Pendentes_Unificacao(
  cQuery: TIBQuery; cCodCheque: Integer; cCodEmpresa: Integer; cCodLanc: Integer);
var
  buscas2: TIBQuery;
  I: Integer;
  vsql, vcampos, vparametros: string;
begin
//  if not vEmp.vFinanceiroUnificado then  // SOMENTE SE O FINANCEIRO ESTIVER UNIFICADO
//    Exit;
//
//  if vEmp.vCodigoUnificadora <> StrToIntDef(codEmpresa, 0) then  // SOMENTE SE A EMPRESA LOGADA FOR A UNIFICADORA
