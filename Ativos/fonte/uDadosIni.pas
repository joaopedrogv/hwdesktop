function TSingleton.getPendenciasEstoque(pGrupo: Integer; pCodProd: string;
  pGrade: Integer; pTipo: string; buscas: TIBQuery; pAlmoxApenasAT: Boolean): Double;
var
  vrTemp: Double;
  vSqlTipo, vSqlGrade: string;
begin
  vrTemp := 0;
  if strEstaContidoEm(pTipo, ['REQ', 'OS', '', 'TODOS']) then
  begin
    if pTipo = 'REQ' then
      vSqlTipo := ' and pv.tipo = ''REQ'''
    else if pTipo = 'OS' then
      vSqlTipo := ' and pv.tipo = ''OS'''
    else
      vSqlTipo := ' and pv.tipo <> ''ORC''';
    if pGrade >= 0 then
      vSqlGrade := ' and ipv.COD_GRADE = ' + IntToStr(pGrade)
    else
      vSqlGrade := '';

    buscas.close;
    buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
      ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
      ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
      ' where ipv.cod_prod = ' + quotedstr(trim(pCodProd)) +
      ' and ipv.grupo_prod = ' + IntToStr(pGrupo) +
      vSqlGrade +
      ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' + vSqlTipo +
      ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' + codEmpresa +
      ' and pv.ativo = 1';
    buscas.Open;
    vrTemp := vrTemp + buscas.FieldByName('valor').AsFloat;
  end;
  if strEstaContidoEm(pTipo, ['PRODUCAO', '', 'TODOS']) then
  begin
    buscas.Close;
    buscas.SQL.Text :=
      'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as valor from producao pd, producao_item_indice pi' +
      ' where pi.grupo_prod = ' + IntToStr(pGrupo) + ' and pi.cod_prod = ' + QuotedStr(Trim(pCodProd)) +
      ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
      ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + codEmpresa;
    buscas.Open;
    vrTemp := vrTemp + buscas.FieldByName('valor').AsFloat;
  end;
  if strEstaContidoEm(pTipo, ['REQ', '', 'TODOS']) then
  begin
    if pAlmoxApenasAT then
      vSqlTipo := ' and c.sit_atd in (''AT'', ''DV'')'
    else
      vSqlTipo := '';
    if pGrade >= 0 then
      vSqlGrade := ' and c.cod_grade = ' + IntToStr(pGrade)
    else
      vSqlGrade := '';
    buscas.close;
    buscas.SQL.Text := 'select sum(coalesce(c.quant,0)) valor' +
      ' from controle_almoxarifado c ' +
      ' where c.grupo_prod = ' + IntToStr(pGrupo) +
      ' and c.cod_prod = ' + QuotedStr(Trim(pCodProd)) +
      vSqlGrade +
      vSqlTipo +
      ' and c.cod_empresa =' + codEmpresa;
    buscas.Open;
    vrTemp := vrTemp + buscas.FieldByName('valor').AsFloat;
  end;

  Result := vrTemp;
end;

function TSingleton.getPontosProgFidelidade(pJSON: string; pTreeView: TTreeView): boolean;
var
  ACalculo: TCalculo;
  ANode, ANode2, ANode3: TtreeNode;
  I, J: Integer;
  vTemp: string;
begin
  pTreeView.Items.Clear;
  
  if trim(pJSON) = '' then
