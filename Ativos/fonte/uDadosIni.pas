function TSingleton.verificarFechamentoSistema(qrBusca: TIBQuery): boolean;
var
	vDiaSemana: string;
begin
	try
    Result := False;

    if vCodPerfilHorasTrab <= 0 then
    begin
      Result := True;
      Exit;
    end;

    qrBusca.Close;
    qrBusca.SQL.Text := ' select extract(weekday from current_date) dia_semana, ' +
      ' (dia.hora_ini || '':'' || dia.minuto_ini || '':00'') hora_ini, ' +
      ' (dia.hora_fim || '':'' || dia.minuto_fim || '':59'') hora_fim, ' +
      ' current_time as hora_atual, ' +
      ' perfil.ativo from perfil_horas_trabalho perfil  ' +
      ' inner join perfil_horas_trabalho_dia dia on ' +
      '		dia.codigo = perfil.codigo ' +
      '		and dia.cod_empresa = perfil.cod_empresa ' +
      ' 	and dia.dia_semana = extract(weekday from current_date) ' +
      ' where perfil.codigo = :codigo ' +
      ' and perfil.cod_empresa = :cod_empresa ';
    qrBusca.ParamByName('codigo').AsInteger := vCodPerfilHorasTrab;
    qrBusca.ParamByName('cod_empresa').AsInteger := StrToInt(codEmpresa);
    qrBusca.Open;

    if qrBusca.IsEmpty then
    begin
      Result := True;
      Exit;
    end;

    if qrBusca.FieldByName('ativo').AsInteger <> 1 then
      Exit;

    if qrBusca.FieldByName('hora_ini').IsNull then
      Exit;

    if qrBusca.FieldByName('hora_fim').IsNull then
      Exit;

    if (vDadosIni.apenasNumeros(trim(qrBusca.FieldByName('hora_atual').AsString)) >= vDadosIni.apenasNumeros(trim(qrBusca.FieldByName('hora_ini').AsString)))
      and (vDadosIni.apenasNumeros(trim(qrBusca.FieldByName('hora_atual').AsString)) <= vDadosIni.apenasNumeros(trim(qrBusca.FieldByName('hora_fim').AsString))) then
    begin
      Result := False;
      Exit;
    end
    else
    begin
    	if not vAvisoFechaHorasTrab then
      begin
      	if vAvisoFechaExibido then
        	Exit;

        if qrBusca.FieldByName('dia_semana').AsInteger = 0 then
          vDiaSemana := 'Domingo'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 1 then
          vDiaSemana := 'Segunda-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 2 then
          vDiaSemana := 'Terça-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 3 then
          vDiaSemana := 'Quarta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 4 then
          vDiaSemana := 'Quinta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 5 then
          vDiaSemana := 'Sexta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 6 then
          vDiaSemana := 'Sábado';

        vAvisoFechaExibido   := True;

      	Application.MessageBox(PChar('Usuário sem permissão para acessar o sistema neste horário, o sistema será fechado em 5 minutos: ' + #13 + #13 +
        	'HORÁRIO DE TRABALHO' + #13 +
          'Dia Semana: ' + trim(vDiaSemana) + #13 +
          'Inicial: ' + Copy(trim(qrBusca.FieldByName('hora_ini').AsString), 1, 5) + #13 +
          'Final: ' + Copy(trim(qrBusca.FieldByName('hora_fim').AsString), 1, 5)), 'Atenção', MB_ICONWARNING + MB_OK);

        vInibeMensPesqPros := 'S';
      	if vDadosIni.PesqPros('CFG059', 'LIBERAR', '', 'SENHAS', trim(vNomeUsuario), qrBusca, False) then
        begin
        	Result := True;
          vCodPerfilHorasTrab := 0;
          Exit;
        end
        else
        begin
          vAvisoFechaHorasTrab := True;
          Result := False;
          Exit;
        end;
      end
      else
      begin
      	if qrBusca.FieldByName('dia_semana').AsInteger = 0 then
          vDiaSemana := 'Domingo'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 1 then
          vDiaSemana := 'Segunda-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 2 then
          vDiaSemana := 'Terça-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 3 then
          vDiaSemana := 'Quarta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 4 then
          vDiaSemana := 'Quinta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 5 then
          vDiaSemana := 'Sexta-Feira'
        else if qrBusca.FieldByName('dia_semana').AsInteger = 6 then
          vDiaSemana := 'Sábado';

//      	Application.MessageBox(PChar('Usuário sem permissão para acessar o sistema neste horário: ' + #13 + #13 +
//          'HORÁRIO DE TRABALHO' + #13 +
//          'Dia Semana: ' + trim(vDiaSemana) + #13 +
//          'Inicial: ' + Copy(trim(qrBusca.FieldByName('hora_ini').AsString), 1, 5) + #13 +
//          'Final: ' + Copy(trim(qrBusca.FieldByName('hora_fim').AsString), 1, 5)), 'Atenção', MB_ICONWARNING + MB_OK);

//        vInibeMensPesqPros := 'S';
//      	if vDadosIni.PesqPros('CFG059', 'LIBERAR', '', 'SENHAS', trim(vNomeUsuario), qrBusca, False) then
//        begin
//        	Result := True;
//          Exit;
//        end
//        else
//        begin
        	vFecharSistema := True;
        	Result := False;
          Exit;
//        end;
      end;
    end;
  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao verificar fechamento do sistema. Erro: ' + e.Message),
        'Atenção', 0 + 64);
      registraErro('TSingleton.verificarFechamentoSistema. Erro: ' + e.Message);
    end;
  end;
end;

function TSingleton.verificarImpFaturaVindi: boolean;
var
	vBuscasTmp: TIBQuery;
  vTransTmp: TIBTransaction;
  vDataAtual: TDateTime;
  vListaDoc: TStringList;
begin
	try
  	try
      Result := False;

      vListaDoc := TStringList.Create;;
      vListaDoc.Clear;

      vTransTmp := TIBTransaction.Create(Application);
      vTransTmp.DefaultDatabase := dtmAtivo.bancoHw;
      vTransTmp.DefaultAction := TACommit;
      vTransTmp.Params.Clear;
      vTransTmp.Params.Add('read_committed');
      vTransTmp.Params.Add('rec_version');
      vTransTmp.Params.Add('nowait');

      vBuscasTmp := TIBQuery.Create(Application);
      vBuscasTmp.Database := dtmAtivo.bancoHw;
      vBuscasTmp.Transaction := vTransTmp;

      vDataAtual := getDataBanco(vBuscasTmp);

      vBuscasTmp.Close;
      vBuscasTmp.SQL.Text := ' select g.cod_gerador from gerador_osbol g ' +
        ' where g.mes_vencimento = :mes_atual ' +
        ' and g.ano_vencimento = :ano_atual ' +
        ' and g.cod_empresa = :cod_empresa ' +
        ' and g.vindi = ''S'' ';

      if StrToInt(FormatDateTime('mm', vDataAtual)) > 1 then
      begin
        vBuscasTmp.SQL.Text := vBuscasTmp.SQL.Text  +
          ' union ' +
          ' select g.cod_gerador from gerador_osbol g ' +
          ' where g.mes_vencimento = :mes_anterior ' +
          ' and g.ano_vencimento = :ano_anterior ' +
          ' and g.cod_empresa = :cod_empresa ' +
          ' and g.vindi = ''S'' ';
      end;

      vBuscasTmp.ParamByName('MES_ATUAL').AsInteger := StrToInt(FormatDateTime('mm', vDataAtual));
      vBuscasTmp.ParamByName('ANO_ATUAL').AsInteger := StrToInt(FormatDateTime('yyyy', vDataAtual));

      if StrToInt(FormatDateTime('mm', vDataAtual)) > 1 then
      begin
        vBuscasTmp.ParamByName('MES_ANTERIOR').AsInteger := StrToInt(FormatDateTime('mm', vDataAtual));
        vBuscasTmp.ParamByName('ANO_ANTERIOR').AsInteger := StrToInt(FormatDateTime('yyyy', vDataAtual));
      end;

      vBuscasTmp.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      vBuscasTmp.Open;

      if vBuscasTmp.IsEmpty then
        Exit;

      vBuscasTmp.Close;
      vBuscasTmp.SQL.Text := ' select first 10 fp.nrequisicao, fp.tpdocs, fp.data_mov, fp.cobranca_vindi_id from formpagamento fp ' +
        ' where fp.data_mov >= :data_ini ' +
        ' and fp.data_mov <= :data_fim ' +
        ' and fp.cod_empresa = :cod_empresa ' +
        ' and fp.prcss is null ' +
        ' and fp.cobranca_vindi_id > 0 ';
      vBuscasTmp.ParamByName('DATA_INI').AsDateTime := (vDataAtual - 15);
      vBuscasTmp.ParamByName('DATA_FIM').AsDateTime := (vDataAtual + 15);
      vBuscasTmp.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      vBuscasTmp.Open;
      vBuscasTmp.FetchAll;

      if not vBuscasTmp.IsEmpty then
      begin
        vBuscasTmp.First;
        while not vBuscasTmp.Eof do
        begin
        	vListaDoc.Add(
          	'Num doc: ' + IntToStr(vBuscasTmp.FieldByName('NREQUISICAO').AsInteger));
          vListaDoc.Add(
          	'Tipo: ' + trim(vBuscasTmp.FieldByName('TPDOCS').AsString));
          vListaDoc.Add(
          	'Data Mov: ' + FormatDateTime('dd/mm/yyyy', vBuscasTmp.FieldByName('data_mov').AsDateTime));
          vListaDoc.Add(
            'Cobrança Id: ' + IntToStr(vBuscasTmp.FieldByName('COBRANCA_VINDI_ID').AsInteger));

          if (vBuscasTmp.RecNo >= 5) and (vBuscasTmp.RecordCount > 5) then
          	vListaDoc.Add('...')
          else
          	vListaDoc.Add('');

          if (vBuscasTmp.RecNo >= 5) then
          	Break;

          vBuscasTmp.Next;
        end;

        Application.MessageBox(PChar('Documento(s) pendente(s) no financeiro:' + #13 + #13 +
        	'DOCUMENTOS' + #13 +
          vListaDoc.Text + #13 +
          'Favor realizar a importação do financeiro.'), 'Atenção', 0 + 64)
      end;

      Result := True;
    finally
      if Assigned(vListaDoc) then
      	FreeAndNil(vListaDoc);
    end;
  except
    on E: exception do
    begin
      Result := False;
      vDadosIni.fechaStatusProcessamento;
      registraErro('TSingleton.verificarImpFaturaVindi. Erro: ' + e.Message);
      Application.MessageBox(pchar('Erro verificar importação fatura vindi. Erro: ' + E.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

