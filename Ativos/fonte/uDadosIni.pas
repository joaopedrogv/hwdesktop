procedure TSingleton.CalcularTaxaCartao(pBuscas: TIBQuery;
	pCOD_EMP_MULT: Integer; 
	pNUM_DOC: Integer; pTIPO_DOC: string;
	pCODIGO_CTRL: Integer; pTP_PLANO,
  pCOD_TERMINAL_ADM: string; pCOD_BANDEIRA_ADM: Integer;
  pDEB_CRED: string; pQTDE_PARC: Integer;
  pVALOR_LIQUIDO, pVALOR_C, pTAXA_CARTAO_CTRL: Double;
  pCorrigirValor: boolean; var pNOVO_VALOR_LIQUIDO: Double);
var
  vLancarTaxaCartao: Boolean;
  vIdCommerce: Integer;
  vValorPedido: Double;
  vValorProdutos: Double;
  vValorFrete: Double;
  vQtdeItens: Double;
  vQtdeUnidades: Double;
begin
  vLancarTaxaCartao := true;
  vIdCommerce := 0;
  vValorPedido := 0;
  vValorProdutos := 0;
  vValorFrete := 0;
  vQtdeItens := 0;
  vQtdeUnidades := 0;

  pNOVO_VALOR_LIQUIDO := pVALOR_LIQUIDO;

  if pCorrigirValor then
  	if pVALOR_LIQUIDO > 0 then
      if not (pVALOR_LIQUIDO = pVALOR_C) then // Corrigir valor liquido somente se o valor do crédito for igual ao valor líquido
        Exit;

  if (trim(pTIPO_DOC) = 'REQ') and (pNUM_DOC > 0) then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := ' select pd.nped, pd.tipo, pd.cod_empresa, pd.id_commerce, ' +
      ' coalesce(pd.valor_total, 0) valor_total, ' +
      ' coalesce(pd.acrescimo, 0) acrescimo, ' +
      ' coalesce(pd.desconto, 0) desconto, ' +
      ' coalesce(pd.nf_ac_frete, 0) nf_ac_frete, ' +
      ' coalesce(pd.nf_ac_outras, 0) nf_ac_outras, ' +
      ' coalesce((select count(*) from pedvenda_prod pp ' +
      '          where pp.nped = pd.nped ' +
      '          and pp.tipo = pd.tipo ' +
      '          and pp.cod_empresa = pd.cod_empresa ' +
      '          and coalesce(pp.status, '''') <> ''CANCELADO''), 0) qtde_itens, ' +
      ' coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod pp ' +
      '          where pp.nped = pd.nped ' +
      '          and pp.tipo = pd.tipo ' +
      '          and pp.cod_empresa = pd.cod_empresa ' +
      '          and coalesce(pp.status, '''') <> ''CANCELADO''), 0) qtde_unidades ' +
      ' from pedvenda pd ' +
      ' where pd.nped = ' + IntToStr(pNUM_DOC) +
      ' and pd.tipo = ' + QuotedStr(trim(pTIPO_DOC)) +
      ' and pd.cod_empresa = ' + codEmpresa;
    pBuscas.Open;

    vIdCommerce := pBuscas.FieldByName('id_commerce').AsInteger;
    vValorPedido := pBuscas.FieldByName('valor_total').AsFloat;
    vValorProdutos := pBuscas.FieldByName('valor_total').AsFloat - pBuscas.FieldByName('nf_ac_frete').AsFloat;
    vValorFrete := pBuscas.FieldByName('nf_ac_frete').AsFloat;
    vQtdeItens := pBuscas.FieldByName('qtde_itens').AsInteger;
    vQtdeUnidades := pBuscas.FieldByName('qtde_unidades').AsInteger;

    if vIdCommerce > 0 then
    	if pBuscas.IsEmpty then
	      exit;
  end;

  if (trim(pTP_PLANO) = '') or (trim(pDEB_CRED) = '') or (pTAXA_CARTAO_CTRL = 0) then
  begin
    pBuscas.Close;
    pBuscas.SQL.Text := 'select tp_plano, taxa_cartao, cartao_sped from controles' +
       ' where codigo_ctrl = ' + IntToStr(pCODIGO_CTRL) +
       ' and tp_plano = ''C'' and codigo_emp = ' + codEmpresa;
    pBuscas.Open;

    if trim(pTP_PLANO) = '' then
	    pTP_PLANO := pBuscas.FieldByName('tp_plano').AsString;

    if pTAXA_CARTAO_CTRL = 0 then
	    pTAXA_CARTAO_CTRL := pBuscas.FieldByName('taxa_cartao').AsFloat;

    if trim(pDEB_CRED) = '' then
      if pBuscas.FieldByName('cartao_sped').AsInteger = 1 then
        pDEB_CRED := 'D'
      else if pBuscas.FieldByName('cartao_sped').AsInteger = 2 then
        pDEB_CRED := 'C';
  end;

  // E-Commerce
  if (vIdCommerce > 0) then
  begin
    if (pCODIGO_CTRL > 0) then
    begin
      vLancarTaxaCartao := false;

      pBuscas.Close;
      pBuscas.SQL.Text := ' select first 1 tx.codigo_ctrl, ' +
        ' tx.debito_credito, tx.valor_de, tx.valor_ate, tx.parcelas_de, tx.parcelas_ate, ' +
        ' tx.hab_taxa_prod, tx.taxa_prod, ' +
        ' tx.hab_taxa_frete, tx.taxa_frete, ' +
        ' tx.hab_taxa_por_pedido, tx.vl_taxa_por_pedido, ' +
        ' tx.hab_taxa_por_item, tx.vl_taxa_por_item, ' +
        ' tx.hab_taxa_por_unidade, tx.vl_taxa_por_unidade, ' +
        ' tx.frete_conta_smart_place ' +
        ' from controles_taxas_ecommerce tx ' +
        ' where tx.codigo_ctrl = :codigo_ctrl ' +
        ' and tx.cod_empresa = :cod_empresa ' +
        ' and tx.debito_credito = :deb_cred ';

    	pBuscas.SQL.Text := pBuscas.SQL.Text +
      	' and case when (tx.cons_frete_regra = ''S'') then cast(:valoresprodfrete as t_vl_todos) else cast(:valoresprod as t_vl_todos) end >= tx.valor_de ' +
      	' and case when (tx.cons_frete_regra = ''S'') then cast(:valoresprodfrete as t_vl_todos) else cast(:valoresprod as t_vl_todos) end <= tx.valor_ate ';

//      if pDEB_CRED = 'C' then        
        pBuscas.SQL.Text := pBuscas.SQL.Text +
          ' and cast(:qtde_parc as Integer) >= tx.parcelas_de ' +
          ' and cast(:qtde_parc as Integer) <= tx.parcelas_ate ';

      pBuscas.SQL.Text := pBuscas.SQL.Text +
        ' and tx.ativo = 1 ';
      pBuscas.ParamByName('CODIGO_CTRL').AsInteger := pCODIGO_CTRL;
      pBuscas.ParamByName('COD_EMPRESA').AsInteger := IfThen((vEmp.vFinanceiroUnificado) and (pCOD_EMP_MULT > 0),
        pCOD_EMP_MULT, StrToInt(codEmpresa));
      pBuscas.ParamByName('DEB_CRED').AsString := IfThen(trim(pDEB_CRED) = '', 'C', pDEB_CRED);

//      if pDEB_CRED = 'C' then
        pBuscas.ParamByName('QTDE_PARC').AsInteger := IfThen(pQTDE_PARC > 0, pQTDE_PARC, 1);
			pBuscas.ParamByName('VALORESPRODFRETE').AsFloat := vValorPedido;
      pBuscas.ParamByName('VALORESPROD').AsFloat := vValorProdutos;
      pBuscas.Open;

      if not pBuscas.IsEmpty then
      begin
        if ((pBuscas.FieldByName('HAB_TAXA_PROD').AsString = 'S') and (pBuscas.FieldByName('TAXA_PROD').AsFloat > 0))
          or ((pBuscas.FieldByName('HAB_TAXA_FRETE').AsString = 'S') and (pBuscas.FieldByName('TAXA_FRETE').AsFloat > 0))
          or ((pBuscas.FieldByName('HAB_TAXA_POR_PEDIDO').AsString = 'S') and (pBuscas.FieldByName('VL_TAXA_POR_PEDIDO').AsFloat > 0))
          or ((pBuscas.FieldByName('HAB_TAXA_POR_ITEM').AsString = 'S') and (pBuscas.FieldByName('VL_TAXA_POR_ITEM').AsFloat > 0))
          or ((pBuscas.FieldByName('HAB_TAXA_POR_UNIDADE').AsString = 'S') and (pBuscas.FieldByName('VL_TAXA_POR_UNIDADE').AsFloat > 0))
          or (pBuscas.FieldByName('FRETE_CONTA_SMART_PLACE').AsString = 'S') then
        begin
          if not pCorrigirValor then
            pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
              pVALOR_C -
                (
                // Comissao sobre valor dos produtos + frete
                IfThen((pBuscas.FieldByName('FRETE_CONTA_SMART_PLACE').AsString <> 'S')
                  and (pBuscas.FieldByName('HAB_TAXA_PROD').AsString = 'S')
                  and (pBuscas.FieldByName('HAB_TAXA_FRETE').AsString = 'S')
                  and (pBuscas.FieldByName('TAXA_PROD').AsFloat > 0)
                  and (pBuscas.FieldByName('TAXA_PROD').AsFloat = pBuscas.FieldByName('TAXA_FRETE').AsFloat),
                    ((pVALOR_C) * (pBuscas.FieldByName('TAXA_PROD').AsFloat / 100)),

                  // Comissao sobre valor dos produtos
                  IfThen((pBuscas.FieldByName('HAB_TAXA_PROD').AsString = 'S')
                    and (pBuscas.FieldByName('TAXA_PROD').AsFloat > 0),
                      (((pVALOR_C / vValorPedido) *  vValorProdutos) * (pBuscas.FieldByName('TAXA_PROD').AsFloat / 100)), 0) +

                  // Comissao sobre valor do frete
                  IfThen((vValorFrete > 0)
                    and (pBuscas.FieldByName('HAB_TAXA_FRETE').AsString = 'S')
                    and (pBuscas.FieldByName('TAXA_FRETE').AsFloat > 0),
                      (((pVALOR_C / vValorPedido) * vValorFrete) * (pBuscas.FieldByName('TAXA_FRETE').AsFloat / 100)), 0)  ) +

                // Taxa fixa por pedido (frete)
                IfThen((pBuscas.FieldByName('HAB_TAXA_POR_PEDIDO').AsString = 'S')
                  and (pBuscas.FieldByName('VL_TAXA_POR_PEDIDO').AsFloat > 0),
                    ((pVALOR_C / vValorPedido) * (pBuscas.FieldByName('VL_TAXA_POR_PEDIDO').AsFloat)), 0) +

                // Taxa fixa por item do pedido (frete)
                IfThen((pBuscas.FieldByName('HAB_TAXA_POR_ITEM').AsString = 'S')
                  and (pBuscas.FieldByName('VL_TAXA_POR_ITEM').AsFloat > 0),
                    ((pVALOR_C / vValorPedido) * (vQtdeItens * pBuscas.FieldByName('VL_TAXA_POR_ITEM').AsFloat)), 0) +

                // Taxa fixa por unidade do pedido (frete)
                IfThen((pBuscas.FieldByName('HAB_TAXA_POR_UNIDADE').AsString = 'S')
                  and (pBuscas.FieldByName('VL_TAXA_POR_UNIDADE').AsFloat > 0),
                    ((pVALOR_C / vValorPedido) * (vQtdeUnidades * pBuscas.FieldByName('VL_TAXA_POR_UNIDADE').AsFloat)), 0) +

                // Frete por conta do Smart Place (valor do frete não será recebido pela empresa)
                IfThen((vValorFrete > 0)
                	and (pBuscas.FieldByName('FRETE_CONTA_SMART_PLACE').AsString = 'S'),
                  	((pVALOR_C / vValorPedido) * (vValorFrete)), 0))
              , 2)
          else
          begin
            if pVALOR_LIQUIDO = pVALOR_C then
              pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
                pVALOR_C -
                  (
                  // Comissao sobre valor dos produtos + frete
                  IfThen((pBuscas.FieldByName('FRETE_CONTA_SMART_PLACE').AsString <> 'S')
                  	and (pBuscas.FieldByName('HAB_TAXA_PROD').AsString = 'S')
                    and (pBuscas.FieldByName('HAB_TAXA_FRETE').AsString = 'S')
                    and (pBuscas.FieldByName('TAXA_PROD').AsFloat > 0)
                    and (pBuscas.FieldByName('TAXA_PROD').AsFloat = pBuscas.FieldByName('TAXA_FRETE').AsFloat),
                      ((pVALOR_C) * (pBuscas.FieldByName('TAXA_PROD').AsFloat / 100)),

                    // Comissao sobre valor dos produtos
                    IfThen((pBuscas.FieldByName('HAB_TAXA_PROD').AsString = 'S')
                      and (pBuscas.FieldByName('TAXA_PROD').AsFloat > 0),
                        (((pVALOR_C / vValorPedido) *  vValorProdutos) * (pBuscas.FieldByName('TAXA_PROD').AsFloat / 100)), 0) +

                    // Comissao sobre valor do frete
                    IfThen((vValorFrete > 0)
                      and (pBuscas.FieldByName('HAB_TAXA_FRETE').AsString = 'S')
                      and (pBuscas.FieldByName('TAXA_FRETE').AsFloat > 0),
                        (((pVALOR_C / vValorPedido) * vValorFrete) * (pBuscas.FieldByName('TAXA_FRETE').AsFloat / 100)), 0)) +

                  // Taxa fixa por pedido (frete)
                  IfThen((pBuscas.FieldByName('HAB_TAXA_POR_PEDIDO').AsString = 'S')
                    and (pBuscas.FieldByName('VL_TAXA_POR_PEDIDO').AsFloat > 0),
                      ((pVALOR_C / vValorPedido) * (pBuscas.FieldByName('VL_TAXA_POR_PEDIDO').AsFloat)), 0) +

                  // Taxa fixa por item do pedido (frete)
                  IfThen((pBuscas.FieldByName('HAB_TAXA_POR_ITEM').AsString = 'S')
                    and (pBuscas.FieldByName('VL_TAXA_POR_ITEM').AsFloat > 0),
                      ((pVALOR_C / vValorPedido) * (vQtdeItens * pBuscas.FieldByName('VL_TAXA_POR_ITEM').AsFloat)), 0) +

                  // Taxa fixa por unidade do pedido (frete)
                  IfThen((pBuscas.FieldByName('HAB_TAXA_POR_UNIDADE').AsString = 'S')
                    and (pBuscas.FieldByName('VL_TAXA_POR_UNIDADE').AsFloat > 0),
                      ((pVALOR_C / vValorPedido) * (vQtdeUnidades * pBuscas.FieldByName('VL_TAXA_POR_UNIDADE').AsFloat)), 0) +

                  // Frete por conta do Smart Place (valor do frete não será recebido pela empresa) 
                  IfThen((vValorFrete > 0)
                  	and (pBuscas.FieldByName('FRETE_CONTA_SMART_PLACE').AsString = 'S'),
                    	((pVALOR_C / vValorPedido) * (vValorFrete)), 0))
                , 2)
          end;
        end;
      end;
    end;
  end
  else if pTP_PLANO = 'C' then
  begin
    if (trim(pCOD_TERMINAL_ADM) <> '')
      and (pCOD_BANDEIRA_ADM > 0) then
    begin
      pBuscas.Close;
      pBuscas.SQL.Text := ' select first 1 tc.cod_term_adm, ' +
        ' 	ac.taxa_por_controle_bandeira from terminal_cartao tc ' +
        ' inner join adm_cartao ac on ac.cod_adm = tc.cod_adm ' +
        '   and ac.cod_empresa = tc.cod_empresa and ac.ativo = 1 ' +
        ' where tc.cod_term_adm = :cod_term_adm and tc.cod_empresa = :cod_empresa ' +
        '	and ac.taxa_por_controle_bandeira = ''B'' ' +
        '	and tc.ativo = 1 ';
      pBuscas.ParamByName('COD_TERM_ADM').AsString := pCOD_TERMINAL_ADM;
      pBuscas.ParamByName('COD_EMPRESA').AsInteger := IfThen((vEmp.vFinanceiroUnificado) and (pCOD_EMP_MULT > 0),
        pCOD_EMP_MULT, StrToInt(codEmpresa));
      pBuscas.Open;

      if not pBuscas.IsEmpty then
        if trim(pDEB_CRED) = '' then
          exit;

      if not pBuscas.IsEmpty then
      begin
        vLancarTaxaCartao := false;

        pBuscas.Close;
        pBuscas.SQL.Text := ' select first 1 tc.cod_term_adm, tx.cod_bandeira, bd.descricao, ' +
          ' tx.debito_credito, tx.parcelas_de, tx.parcelas_ate, tx.taxa from terminal_cartao tc ' +
          ' inner join adm_cartao ac on ac.cod_adm = tc.cod_adm ' +
          ' 		and ac.cod_empresa = tc.cod_empresa and ac.ativo = 1 ' +
          ' inner join adm_cartao_taxas_bandeiras tx on tx.cod_adm = tc.cod_adm and tx.cod_empresa = tc.cod_empresa ' +
          ' inner join bandeiras_cartao bd on bd.cod_bandeira = tx.cod_bandeira ' +
          '			and bd.cod_empresa = tx.cod_empresa and bd.ativo = 1 ' +
          ' where tc.cod_term_adm = :cod_term_adm ' +
          ' and tx.cod_bandeira = :cod_bandeira ' +
          ' and tc.cod_empresa = :cod_empresa ' +
          ' and tx.debito_credito = :deb_cred ';

        if pDEB_CRED = 'C' then
          pBuscas.SQL.Text := pBuscas.SQL.Text +
            ' and cast(:qtde_parc as Integer) >= tx.parcelas_de ' +
            ' and cast(:qtde_parc as Integer) <= tx.parcelas_ate ';

        pBuscas.SQL.Text := pBuscas.SQL.Text +
          ' and ac.taxa_por_controle_bandeira = ''B'' ' +
          ' and tc.ativo = 1 ';
        pBuscas.ParamByName('COD_TERM_ADM').AsString := pCOD_TERMINAL_ADM;
        pBuscas.ParamByName('COD_BANDEIRA').AsInteger := pCOD_BANDEIRA_ADM;
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := IfThen((vEmp.vFinanceiroUnificado) and (pCOD_EMP_MULT > 0),
          pCOD_EMP_MULT, StrToInt(codEmpresa));
        pBuscas.ParamByName('DEB_CRED').AsString := pDEB_CRED;

        if pDEB_CRED = 'C' then
          pBuscas.ParamByName('QTDE_PARC').AsInteger := IfThen(pQTDE_PARC > 0, pQTDE_PARC, 1);
        pBuscas.Open;

        if not pBuscas.IsEmpty then
        begin
          if pBuscas.FieldByName('TAXA').AsFloat > 0 then
            if not pCorrigirValor then
              pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
                pVALOR_C - (pVALOR_C * pBuscas.FieldByName('TAXA').AsFloat / 100), 2)
            else
            begin
            	if pVALOR_LIQUIDO = 0 then
              	pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
                  pVALOR_C - (pVALOR_C * pBuscas.FieldByName('TAXA').AsFloat / 100), 2)
              else if pVALOR_LIQUIDO = pVALOR_C then
                pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
                  pVALOR_C - (pVALOR_C * pBuscas.FieldByName('TAXA').AsFloat / 100), 2);
            end;
        end;
      end;
    end;
  end;

  // Não calcular em pedido do E-Commerce
  if (vIdCommerce <= 0) then
  begin
    if not pCorrigirValor then
    begin
      if vLancarTaxaCartao then
        if pTAXA_CARTAO_CTRL > 0 then
          pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
            pVALOR_C - (pVALOR_C * pTAXA_CARTAO_CTRL / 100), 2);
    end
    else if pTP_PLANO = 'C' then
      if vLancarTaxaCartao then
        if pTAXA_CARTAO_CTRL > 0 then
        begin
          if pVALOR_LIQUIDO = 0 then
          	pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
              pVALOR_C - (pVALOR_C * pTAXA_CARTAO_CTRL / 100), 2)
          else if pVALOR_LIQUIDO = pVALOR_C then
            pNOVO_VALOR_LIQUIDO := StrToFloatFormat(
              pVALOR_C - (pVALOR_C * pTAXA_CARTAO_CTRL / 100), 2);
        end;
  end;
end;

procedure TSingleton.ListCheckCadPadaoClickCheck(Sender: TObject);
var
  DisplayLabel: string;
  ListCheck: TCheckListBox;
  I: Integer;
  J: Integer;
  Columns: TColumn;
begin
  if vGridCfg = nil then
    Exit;
  if vcdsGrid = nil then
    Exit;

  ListCheck := TCheckListBox(Sender);
  if ListCheck.ItemIndex <= -1 then
    Exit;

  DisplayLabel := ListCheck.Items[ListCheck.ItemIndex];

  for I := 0 to vcdsGrid.Fields.Count - 1 do
    if vcdsGrid.Fields[I].DisplayLabel = DisplayLabel then
    begin
      vcdsGrid.Fields[I].Visible := ListCheck.Checked[ListCheck.ItemIndex];
      for J := 0 to vGridCfg.Columns.Count - 1 do
        if vGridCfg.Columns[J].FieldName = vcdsGrid.Fields[I].FieldName then
        begin
          Columns := vGridCfg.Columns[J];
          Columns.Visible := ListCheck.Checked[ListCheck.ItemIndex];
          Columns.Index := vGridCfg.Columns.Count - 1;
          Break;
        end;
      Break;
    end;
end;

function TSingleton.LoadPackage(ABPLName: string;
  var AHandle: THandle): Boolean;
begin
  if AHandle = 0 then
    Result := CarregaPacote(ABPLName, AHandle)
  else
    Result := True;
end;

function TSingleton.localizarCreditoFinanceiro(pValorOld,
  pValorNew: string): boolean;
var
	i, j: Integer;
  vtemp, vtemp2: string;
begin
  Result := False;

  pValorOld := trim(pValorOld);
  pValorNew := trim(pValorNew);

  if pValorOld = pValorNew then
    Result := True;

	if not Result then
  begin
    for i := 1 to Length(pValorOld) do
    begin
      if (not Result) and (i = 1) then
      begin
        vTemp := Copy(pValorOld, I + 1, Length(pValorOld) - 1);
        if (vtemp = pValorNew) then
        begin
          Result := True;
          exit;
        end;
      end
      else if (not Result) and (i > 1) and (I < Length(pValorOld)) then
      begin
        vtemp := Copy(pValorOld, 1, I -1) + Copy(pValorOld, I + 1, Length(pValorOld) - I);
        if (vtemp = pValorNew) then
        begin
          Result := True;
          exit;
        end;
      end
      else if (not Result) and (i > 1) and (I = Length(pValorOld)) then
      begin
        vtemp := Copy(pValorOld, 1, Length(pValorOld) - 1);
        if (vtemp = pValorNew) then
        begin
          Result := true;
          exit;
        end;
      end;
    end;
  end;

  if not Result then
  begin
    for i := 1 to Length(pValorNew) do
    begin
      if (not Result) and (i = 1) then
      begin
        vTemp := Copy(pValorNew, I + 1, Length(pValorNew) - 1);
        if (vtemp = pValorOld) then
        begin
          Result := true;
          exit;
        end;
      end
      else if (not Result) and (i > 1) and (I < Length(pValorNew)) then
      begin
        vtemp := Copy(pValorNew, 1, I -1) + Copy(pValorNew, I + 1, Length(pValorNew) - I);
        if (vtemp = pValorOld) then
        begin
          Result := true;
          exit;
        end;
      end
      else if (not Result) and (i > 1) and (I = Length(pValorNew)) then
      begin
        vtemp := Copy(pValorNew, 1, Length(pValorNew) - 1);
        if (vtemp = pValorOld) then
        begin
          Result := true;
          exit;
        end;
      end;
    end;
  end;

  if not Result then
  begin
    for i := 1 to Length(pValorOld) do
    begin
      if (not Result) and (i = 1) then
        vTemp := Copy(pValorOld, I + 1, Length(pValorOld) - 1)
      else if (not Result) and (i > 1) and (I < Length(pValorOld)) then
        vtemp := Copy(pValorOld, 1, I -1) + Copy(pValorOld, I + 1, Length(pValorOld) - I)
      else if (not Result) and (i > 1) and (I = Length(pValorOld)) then
        vtemp := Copy(pValorOld, 1, Length(pValorOld) - 1);

      for j := 1 to Length(pValorNew) do
      begin
        if (not Result) and (j = 1) then
          vTemp2 := Copy(pValorNew, j + 1, Length(pValorNew) - 1)
        else if (not Result) and (j > 1) and (j < Length(pValorNew)) then
          vTemp2 := Copy(pValorNew, 1, j -1) + Copy(pValorNew, j + 1, Length(pValorNew) - j)
        else if (not Result) and (j > 1) and (j = Length(pValorNew)) then
          vTemp2 := Copy(pValorNew, 1, Length(pValorNew) - 1);

        if (vtemp = vTemp2) then
        begin
          Result := true;
          exit;
        end;
      end;
    end;
  end;
end;

procedure TSingleton.logs(Atext, Afilename: string; Asingleline: Boolean;
  AtimeStart: TDateTime);
var
  Afile: TextFile;
  Adir, Alogname, Atimestr: string;
begin
  if IndexText(loggeral, ['S', 'D']) < 0 then
    Exit;

  try
    Atimestr := '';
    if AtimeStart > 0 then
    begin
      if (Now - AtimeStart) >= 1  then
      begin
        Atimestr := IntToStr(Trunc(Now - AtimeStart));
        AtimeStart := (Now - AtimeStart) - Trunc(Now - AtimeStart);
        Atimestr := Atimestr + ' dia(s) ' + FormatDateTime('hh:mm:ss', AtimeStart);
      end
      else
        Atimestr := FormatDateTime('hh:mm:ss', Now);
    end;

    Alogname := ExtractFileName(Afilename);
    if loggeral = 'S' then //Simplificado, Unico arquivo, com o nome da classe
      if Pos('.', Afilename) > 0 then
        System.Delete(Afilename, Pos('.', Afilename), Length(Afilename));

    Adir := ExtractFilePath(Application.ExeName) + 'log\' +
            FormatDateTime('YYYY-MM-DD', Date) + '\';

    ForceDirectories(ExtractFilePath(Adir));

    Afilename := Adir + '\' + Afilename + '.log';

    AssignFile(Afile, Afilename);
    if FileExists(Afilename) then
      Append(Afile)
    else
      Rewrite(Afile);
    if not Asingleline then
    begin
      if Atimestr <> '' then
        Writeln(Afile, Format('/*[%s] {%s} (%s)*/', [FormatDateTime('YYYY-MM-DD hh:mm:ss', Now), Alogname, Atimestr]))
      else
        Writeln(Afile, Format('/*[%s] {%s}*/', [FormatDateTime('YYYY-MM-DD hh:mm:ss', Now), Alogname]));
      Writeln(Afile, Atext);
    end
    else if Atimestr <> '' then
      Writeln(Afile, Format('/*[%s] {%s} (%s)*/ %s', [FormatDateTime('YYYY-MM-DD hh:mm:ss', Now), Alogname, Atimestr, Atext]))
    else
      Writeln(Afile, Format('/*[%s] {%s}*/ %s', [FormatDateTime('YYYY-MM-DD hh:mm:ss', Now), Alogname, Atext]));
    CloseFile(Afile);

  except on E: Exception do
    begin
      registraErro('TSingleton.logs ' + E.Message);
    end;
  end;
end;

