{ RGeradorContratos }

procedure RGeradorFaturamentoContratos.Config(conf: TConfig_sistema_class);
begin
	Self.vGerarBoleto := vDadosIni.IfThen(UpperCase(trim(conf.ReadString('Configuracao', 'GerarBoleto', 'N'))) = 'S', True, False);

  Self.vGerarBoletoProdServ := vDadosIni.IfThen(UpperCase(trim(conf.ReadString('Configuracao', 'GerarBoletoProdServ', 'N'))) = 'S', True, False);

  Self.vAgruparContratos := vDadosIni.IfThen(UpperCase(trim(conf.ReadString('Configuracao', 'AgruparContratos', 'N'))) = 'S', True, False);

  Self.vDesconsiderarRegraControles := vDadosIni.IfThen(UpperCase(trim(conf.ReadString('Configuracao', 'DesconsiderarRegraControles', 'N'))) = 'S', True, False);

  Self.vStatusTMO := trim(conf.ReadString('Configuracao', 'StatusTMO'));

  Self.vCodOperadorCXL := 0;
  if vDadosIni.vEmp.vModoFaturamento = 'S' then
  begin
  	if trim(conf.ReadString('Configuracao', 'CodOperadorCXL')) <> '' then
    begin
      try
        Self.vCodOperadorCXL := StrToInt(trim(conf.ReadString('Configuracao', 'CodOperadorCXL')));
      except
        Self.vCodOperadorCXL := 0;
      end;
    end;
  end;

  Self.vCodVendedor := 0;
  if trim(conf.ReadString('Configuracao', 'CodVendedor')) <> '' then
  begin
    try
      Self.vCodVendedor := StrToInt(trim(conf.ReadString('Configuracao', 'CodVendedor')));
    except
      Self.vCodVendedor := 0;
    end;
  end;

  Self.vCodSubGrupoOS := 0;
  if trim(conf.ReadString('Configuracao', 'CodSubGrupoOS')) <> '' then
  begin
    try
      Self.vCodSubGrupoOS := StrToInt(trim(conf.ReadString('Configuracao', 'CodSubGrupoOS')));
    except
      Self.vCodSubGrupoOS := 0;
    end;
  end;

  if UpperCase(trim(conf.ReadString('Configuracao', 'Ordem'))) = 'FANTASIA' then
    Self.vOrdem := 0
  else if UpperCase(trim(conf.ReadString('Configuracao', 'Ordem'))) = 'RAZAO' then
    Self.vOrdem := 1
  else if UpperCase(trim(conf.ReadString('Configuracao', 'Ordem'))) = 'CODCLIENTE' then
    Self.vOrdem := 2
  else
    Self.vOrdem := 0;
end;

{ RSuzuki }

procedure RSuzuki.Config(conf: TConfig_sistema_class);
var
	vStringListTemp: TStringList;
	vtemp: string;
  I: Integer;
begin
	vtemp := trim(conf.ReadString('SUZUKI', 'Codigo'));

  Self.vVerificarNotasFiscais := trim(conf.ReadString('SUZUKI', 'VerificarNotasFiscais'));
  Self.vDataUltimaVerificacao := trim(conf.ReadString('SUZUKI', 'DataUltimaVerificacao'));
  Self.vNotasFiscaisApartir   := trim(conf.ReadString('SUZUKI', 'NotasFiscaisApartir'));


  Self.vCodMarcas := '';

  try
  	vStringListTemp := TStringList.Create;
    vStringListTemp := vDadosIni.Split(vtemp, ',');

    for I := 0 to vStringListTemp.Count - 1 do
    	if trim(vStringListTemp[I]) <> '' then
      begin
        try
          StrToInt(trim(vStringListTemp[I]));

          if StrToInt(trim(vStringListTemp[I])) > 0 then
          	Self.vCodMarcas := IfThen(trim(Self.vCodMarcas) <> '', trim(Self.vCodMarcas) + ',', '') + trim(vStringListTemp[I]);
        except
        end;
      end;

    if trim(Self.vCodMarcas) = '' then
    	Self.vCodMarcas := '0';

    Self.vCodMarcas := '(' + trim(Self.vCodMarcas) + ')';

  finally
  	if Assigned(vStringListTemp) then
    	vStringListTemp.Free;
  end;
end;

