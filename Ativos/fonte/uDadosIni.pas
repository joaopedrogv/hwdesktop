function TSingleton.Gencodigo(Tabela: string; buscas: TIBQuery; codemp: string): integer;
begin
  while true do
  begin
    try

      buscas.Close;
      buscas.SQL.Text := 'SELECT COD FROM INCREMENTA_CODIGO(:VCOD_EMPRESA, :VTABELA)';
      buscas.ParamByName('VCOD_EMPRESA').Text := codemp;
      buscas.ParamByName('VTABELA').Text := UpperCase(Tabela);
      buscas.Open;
      Result := buscas.FieldByName('COD').Value;
      buscas.Close;
      exit;
    except
      on E: Exception do
      begin
        MessageDlg('E0005 ' + 'Erro ao obter código para: "' + Tabela +'"'+ #13 +
          'Não desligue o computador durante este processamento' + #13 +
          'Operação será repetida' + #13 +
          'Se o processo ficar repetitivo procure o Suporte', mtinformation, [mbOK], 0);
        registraErro('E0005 ' + e.Message + ' ' + Tabela);
        //     Result := False;
      end;
    end;
  end;
end;

function TSingleton.Gencodigo(Tabela: string; procedureCodigo: TIBStoredProc;
  codemp: string): integer;
begin
  while true do
  begin
    try
      procedureCodigo.Close;
      procedureCodigo.ParamByName('VCOD_EMPRESA').Text := codemp;
      procedureCodigo.ParamByName('VTABELA').Text := UpperCase(Tabela);
      procedureCodigo.ExecProc;
      Result := procedureCodigo.ParamByName('COD').Value;
      procedureCodigo.Close;
      exit;
    except
      on E: Exception do
      begin
        MessageDlg('E0005 ' + 'Erro ao obter código para: "' + Tabela +'"'+ #13 +
          'Não desligue o computador durante este processamento' + #13 +
          'Operação será repetida' + #13 +
          'Se o processo ficar repetitivo procure o Suporte', mtinformation, [mbOK], 0);
        registraErro('E0005 ' + e.Message + ' ' + Tabela);
        //     Result := False;
      end;
    end;
  end;

end;

function TSingleton.gerarMD5ArquivoEletronico(vPathArquivo: string): boolean;
var
  Buffer: Ansistring;
  Arq: TextFile;
begin
  Result := True;
  try
    Buffer := Sign_RSA_MD5(pchar(ExtractFilePath(Application.Exename)), vPathArquivo);
    AssignFile(Arq, vPathArquivo);
    try
      Append(arq);
      WriteLn(arq, 'EAD' + buffer);
    finally
      CloseFile(Arq);
    end;
  except
    Result := False;
  end;
end;


