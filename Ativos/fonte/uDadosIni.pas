function TSingleton.mdiAberto(pNomeFormMDI: string; pCloseForm: Boolean; pNameClassName: string): Boolean;
var
  x: Byte;
  vTemp: string;
begin
  Result := False;
  if Application.MainForm.MDIChildCount > 0 then
    for X := 0 to Pred(Application.MainForm.MDIChildCount) do
      if ((trim(pNameClassName) = 'NAME') and (UpperCase(Application.MainForm.MDIChildren[X].Name) = UpperCase(pNomeFormMDI)))
        or
         ((trim(pNameClassName) = 'CLASSNAME') and (UpperCase(Application.MainForm.MDIChildren[X].ClassName) = UpperCase(pNomeFormMDI))) then
      begin
        if pCloseForm then
        begin
          try
            vTemp := vPesquisa;
            vPesquisa := '*SM*';
            TForm(Application.MainForm.MDIChildren[X]).Close;
            TForm(Application.MainForm.MDIChildren[X]).Free;
            Exit;
          finally
            vPesquisa := vTemp;
          end;
        end;
        Result := True;
        Exit;
      end;
end;

function TSingleton.sincronizarDadosContatoClienteAplicativo(
	pCodCliente: Integer): Boolean;
var
	Con: TConexao;
  buscas2: TIBQuery;
	vHabKentro: Boolean;
  vId: Integer;
  vTipoId: Integer;
  vSinc: Boolean;
  vIdentificacao: string;
  vEmail: string;
  vStringListIdentificacao: TStringList;
  I: Integer;
begin
  Result := True;

  Con := TConexao.Create(dtmAtivo.bancoHw);

  try
  	try
    	if pCodCliente <= 0 then
      	Exit;

      if vHwCloudIA.vUsarServMensageria <> 'S' then
        Exit;

      SqlOpen(' select clientes.cod_cliente, clientes.sinc_contato, clientes.ativo from clientes ' +
        ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
        ' and clientes.cod_empresa = ' + codEmpresa,
        Con.QrAux);

      if Con.QrAux.IsEmpty then
      	Exit;

      if Con.QrAux.FieldByName('ATIVO').AsInteger = 99 then
      	Exit;

      if Con.QrAux.FieldByName('SINC_CONTATO').AsString = 'S' then
        Exit;

      SqlOpen(' select first 1 msg_contato.id from msg_contato ' +
        ' where msg_contato.cod_cliente = ' + IntToStr(pCodCliente) +
        ' and msg_contato.cod_empresa = ' + codEmpresa,
        Con.QrAux);

      if not Con.QrAux.IsEmpty then
        Exit;

      if vHwCloudIA.vCodTipoContatoPadrao <= 0 then
      begin
        Application.MessageBox(PChar('Código do tipo de contato padrão não definido, favor verificar na configuração (hw_cloud_ia_conf)'), 'Atenção', MB_ICONERROR + MB_OK);
        Exit;
      end;

      if SqlOpen(' select tipo_contato.tipo from tipo_contato ' +
        ' where tipo_contato.id = ' + IntToStr(vHwCloudIA.vCodTipoContatoPadrao) +
        ' and tipo_contato.cod_empresa = ' + codEmpresa, Con.QrAux).IsEmpty then
      begin
        Application.MessageBox(PChar('Código do tipo de contato padrão (CodTipoContatoPadrao) não encontrado, favor verificar na configuração (hw_cloud_ia_conf).'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        Exit;
      end;

      vHabKentro := trim(retornaDadosKentro(Con.QrAux, False)) <> '';

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := Con.QrAux.Database;
      buscas2.Transaction := Con.QrAux.Transaction;

      vStringListIdentificacao := TStringList.Create;
      vStringListIdentificacao.Sorted := True;
      vStringListIdentificacao.Duplicates := dupIgnore;
      vStringListIdentificacao.Clear;

      SqlOpen(' select 1 id_msg_aplicativo, coalesce(clientes.contato, ''SEM CONTATO'') as contato, ' +
        ' clientes.email as identificador, 0 tipo_id, ' +
        ' ''S'' sel from clientes ' +
        ' where clientes.cod_cliente = ' + IntToStr(pCodCliente) +
        ' and clientes.cod_empresa = ' + codEmpresa +
        ' and trim(coalesce(clientes.email, '''')) <> '''' ' +
  //      ' union ' +
  //      ' select 1 id_msg_aplicativo, coalesce(clientes_contato.contato, ''SEM CONTATO'') contato, ' +
  //      '	clientes_contato.email as identificador, clientes_contato.tipo_id, ' +
  //      ' case when ((select count(*) from clientes_contato_env ' +
  //      '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
  //      '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
  //      '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
  //      ' from clientes_contato ' +
  //      ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
  //      ' and clientes_contato.cod_empresa = ' + codEmpresa +
  //      ' and trim(coalesce(clientes_contato.email, '''')) <> '''' ' +
        IfThen(vHabKentro,
          ' union ' +
          ' select 2 id_msg_aplicativo, coalesce(clientes_contato.contato, ''SEM CONTATO'') contato, ' +
          ' clientes_contato.telefone as identificador, clientes_contato.tipo_id, ' +
          ' case when ((select count(*) from clientes_contato_env ' +
          '             where clientes_contato_env.cod_cliente = clientes_contato.cod_cliente ' +
          '             and clientes_contato_env.cod_empresa = clientes_contato.cod_empresa ' +
          '             and clientes_contato_env.id_contato = clientes_contato.id) > 0) then ''S'' else ''N'' end sel ' +
          '   from clientes_contato ' +
          ' where clientes_contato.cod_cliente = ' + IntToStr(pCodCliente) +
          ' and clientes_contato.cod_empresa = ' + codEmpresa +
          ' and trim(coalesce(clientes_contato.telefone, '''')) <> '''' ', '') +
        ' order by 1, 3 ', buscas2);

      buscas2.First;
      while not buscas2.Eof do
      begin
        if buscas2.FieldByName('SEL').AsString = 'S' then
        begin
          vSinc := False;

          vIdentificacao := trim(buscas2.FieldByName('identificador').AsString);
          vEmail := '';

          vStringListIdentificacao.Clear;
          if vDadosIni.retornaNomeAplicativo(buscas2.FieldByName('id_msg_aplicativo').AsInteger) = 'E-MAIL' then
          begin
            for I := 1 to Length(vIdentificacao) do
            begin
              if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
              begin
                if _ValidarEMail(trim(vEmail)) then
                  vStringListIdentificacao.Add(trim(vEmail));
                vemail := '';
              end
              else
                vemail := vemail + vIdentificacao[I];
            end;
            if _ValidarEMail(trim(vEmail)) then
              vStringListIdentificacao.Add(trim(vEmail));
          end
          else if vDadosIni.retornaNomeAplicativo(buscas2.FieldByName('id_msg_aplicativo').AsInteger) = 'WHATSAPP' then
          begin
            if _ValidarCelular(trim(vIdentificacao)) then
              vStringListIdentificacao.Add(vIdentificacao);
          end;

          for I := 0 to vStringListIdentificacao.Count - 1 do
          begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' select msg_contato.id from msg_contato ' +
              ' where msg_contato.cod_cliente = ' + IntToStr(pCodCliente)+
              ' and msg_contato.cod_empresa = ' + codEmpresa +
              ' and msg_contato.id_msg_aplicativo = ' + IntToStr(buscas2.FieldByName('id_msg_aplicativo').AsInteger) +
              ' and msg_contato.identificador = ' + QuotedStr(trim(vStringListIdentificacao[I]));
            Con.QrAux.Open;

            if Con.QrAux.IsEmpty then
            begin
              vId := Gencodigo('MSG_CONTATO', Con.QrAux, codEmpresa);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' insert into msg_contato ' +
                ' (id, cod_empresa, cod_cliente, id_msg_aplicativo, contato, identificador, ativo) ' +
                ' values (:id, :cod_empresa, :cod_cliente, :id_msg_aplicativo, :contato, :identificador, :ativo) ';
              Con.QrAux.ParamByName('id').AsInteger := vId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
              Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := buscas2.FieldByName('id_msg_aplicativo').AsInteger;
              Con.QrAux.ParamByName('contato').AsString := Copy(buscas2.FieldByName('contato').AsString, 1, 32);
              Con.QrAux.ParamByName('identificador').AsString := Copy(trim(vStringListIdentificacao[I]), 1, 60);
              Con.QrAux.ParamByName('ativo').AsInteger := 1;
              Con.QrAux.ExecSQL;

              vTipoId := IfThen(buscas2.FieldByName('tipo_id').AsInteger > 0, buscas2.FieldByName('tipo_id').AsInteger, vHwCloudIA.vCodTipoContatoPadrao);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
                ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
                ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.ExecSQL;
            end
            else
            begin
              vId := Con.QrAux.FieldByName('id').AsInteger;
              vTipoId := IfThen(buscas2.FieldByName('tipo_id').AsInteger > 0, buscas2.FieldByName('tipo_id').AsInteger, vHwCloudIA.vCodTipoContatoPadrao);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' select * from msg_contato_tipo ' +
                ' where id_msg_contato = :id_msg_contato ' +
                ' and id_tipo_contato = :id_tipo_contato ' +
                ' and cod_empresa = :cod_empresa ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.Open;

              if Con.QrAux.IsEmpty then
              begin
                Con.QrAux.Close;
                Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
                  ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
                  ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
                Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
                Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
                Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
                Con.QrAux.ExecSQL;
              end;
            end;
          end;
        end;

        buscas2.Next;
      end;

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' update clientes set sinc_contato = ''S'' ' +
        ' where cod_cliente = :cod_cliente ' +
        ' and cod_empresa = :cod_empresa ';
      Con.QrAux.ParamByName('cod_cliente').AsInteger := pCodCliente;
      Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
      Con.QrAux.ExecSQL;

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;
    except on E: Exception do
      begin
        Application.MessageBox(PChar('Erro ao sincronizar contato - cod cliente: ' + IntToStr(pCodCliente) + ' - ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao sincronizar contato - cod cliente: ' + IntToStr(pCodCliente) + ' - ' + e.Message);
        Result := False;
      end;
    end;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
    if Assigned(vStringListIdentificacao) then
    	FreeAndNil(vStringListIdentificacao);
    if Assigned(Con) then
      FreeAndNil(Con);
  end;
end;

