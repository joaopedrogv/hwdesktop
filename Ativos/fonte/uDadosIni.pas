        Exit;
      end;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := Con.QrAux.Database;
      buscas2.Transaction := Con.QrAux.Transaction;

      vStringListIdentificacao := TStringList.Create;
      vStringListIdentificacao.Sorted := True;
      vStringListIdentificacao.Duplicates := dupIgnore;
      vStringListIdentificacao.Clear;

      SqlOpen(' select 1 id_msg_aplicativo, coalesce(colaborador.nome_vendedor, ''SEM CONTATO'') as contato, ' +
        ' colaborador.email as identificador, 0 tipo_id, ' +
        ' ''S'' sel from colaborador ' +
        ' where colaborador.cod_vendedor = ' + IntToStr(pCodColaborador) +
        ' and colaborador.cod_empresa = ' + codEmpresa +
        ' and trim(coalesce(colaborador.email, '''')) <> '''' ', buscas2);

      buscas2.First;
      while not buscas2.Eof do
      begin
        if buscas2.FieldByName('SEL').AsString = 'S' then
        begin
          vSinc := False;

          vIdentificacao := trim(buscas2.FieldByName('identificador').AsString);
          vEmail := '';

          vStringListIdentificacao.Clear;
          if vDadosIni.retornaNomeAplicativo(buscas2.FieldByName('id_msg_aplicativo').AsInteger) = 'E-MAIL' then
          begin
            for I := 1 to Length(vIdentificacao) do
            begin
              if (vIdentificacao[I] = ';') or (vIdentificacao[I] = ',') or (vIdentificacao[I] = '|') then
              begin
                if _ValidarEMail(trim(vEmail)) then
                  vStringListIdentificacao.Add(trim(vEmail));
                vemail := '';
              end
              else
                vemail := vemail + vIdentificacao[I];
            end;
            if _ValidarEMail(trim(vEmail)) then
              vStringListIdentificacao.Add(trim(vEmail));
          end
          else if vDadosIni.retornaNomeAplicativo(buscas2.FieldByName('id_msg_aplicativo').AsInteger) = 'WHATSAPP' then
          begin
            if _ValidarCelular(trim(vIdentificacao)) then
              vStringListIdentificacao.Add(vIdentificacao);
          end;

          for I := 0 to vStringListIdentificacao.Count - 1 do
          begin
            Con.QrAux.Close;
            Con.QrAux.SQL.Text := ' select msg_contato.id from msg_contato ' +
              ' where msg_contato.cod_vendedor = ' + IntToStr(pCodColaborador)+
              ' and msg_contato.cod_empresa = ' + codEmpresa +
              ' and msg_contato.id_msg_aplicativo = ' + IntToStr(buscas2.FieldByName('id_msg_aplicativo').AsInteger) +
              ' and msg_contato.identificador = ' + QuotedStr(trim(vStringListIdentificacao[I]));
            Con.QrAux.Open;

            if Con.QrAux.IsEmpty then
            begin
              vId := Gencodigo('MSG_CONTATO', Con.QrAux, codEmpresa);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' insert into msg_contato ' +
                ' (id, cod_empresa, cod_vendedor, id_msg_aplicativo, contato, identificador, ativo) ' +
                ' values (:id, :cod_empresa, :cod_vendedor, :id_msg_aplicativo, :contato, :identificador, :ativo) ';
              Con.QrAux.ParamByName('id').AsInteger := vId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.ParamByName('cod_vendedor').AsInteger := pCodColaborador;
              Con.QrAux.ParamByName('id_msg_aplicativo').AsInteger := buscas2.FieldByName('id_msg_aplicativo').AsInteger;
              Con.QrAux.ParamByName('contato').AsString := Copy(buscas2.FieldByName('contato').AsString, 1, 32);
              Con.QrAux.ParamByName('identificador').AsString := Copy(trim(vStringListIdentificacao[I]), 1, 60);
              Con.QrAux.ParamByName('ativo').AsInteger := 1;
              Con.QrAux.ExecSQL;

              vTipoId := IfThen(buscas2.FieldByName('tipo_id').AsInteger > 0, buscas2.FieldByName('tipo_id').AsInteger, vHwCloudIA.vCodTipoContatoPadrao);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
                ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
                ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.ExecSQL;
            end
            else
            begin
              vId := Con.QrAux.FieldByName('id').AsInteger;
              vTipoId := IfThen(buscas2.FieldByName('tipo_id').AsInteger > 0, buscas2.FieldByName('tipo_id').AsInteger, vHwCloudIA.vCodTipoContatoPadrao);

              Con.QrAux.Close;
              Con.QrAux.SQL.Text := ' select * from msg_contato_tipo ' +
                ' where id_msg_contato = :id_msg_contato ' +
                ' and id_tipo_contato = :id_tipo_contato ' +
                ' and cod_empresa = :cod_empresa ';
              Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
              Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
              Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
              Con.QrAux.Open;

              if Con.QrAux.IsEmpty then
              begin
                Con.QrAux.Close;
                Con.QrAux.SQL.Text := ' insert into msg_contato_tipo ' +
                  ' (id_msg_contato, id_tipo_contato, cod_empresa) ' +
                  ' values (:id_msg_contato, :id_tipo_contato, :cod_empresa) ';
                Con.QrAux.ParamByName('id_msg_contato').AsInteger := vId;
                Con.QrAux.ParamByName('id_tipo_contato').AsInteger := vTipoId;
                Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
                Con.QrAux.ExecSQL;
              end;
            end;
          end;
        end;

        buscas2.Next;
      end;

      Con.QrAux.Close;
      Con.QrAux.SQL.Text := ' update colaborador set sinc_contato = ''S'' ' +
        ' where cod_vendedor = :cod_vendedor ' +
        ' and cod_empresa = :cod_empresa ';
      Con.QrAux.ParamByName('cod_vendedor').AsInteger := pCodColaborador;
      Con.QrAux.ParamByName('cod_empresa').AsInteger := cod_empresa;
      Con.QrAux.ExecSQL;

      if Con.QrAux.Transaction.InTransaction then
        Con.QrAux.Transaction.Commit;
    except on E: Exception do
      begin
        Application.MessageBox(PChar('Erro ao sincronizar contato - cod colaborador: ' + IntToStr(pCodColaborador) + ' - ' + pchar(e.Message)), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro('Erro ao sincronizar contato - cod colaborador: ' + IntToStr(pCodColaborador) + ' - ' + e.Message);
        Result := False;
      end;
    end;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
    if Assigned(vStringListIdentificacao) then
    	FreeAndNil(vStringListIdentificacao);
    if Assigned(Con) then
      FreeAndNil(Con);
  end;
end;

function TSingleton.ModImp(Print: TRDPrint): boolean;
var
  vtipo: string;
begin
  try
    try
      Result := false;
    
      if Printer.Printers.IndexOf(_LerConfiguracoesRegistroString('ComboBoxNomeImpressora'+vNomeUsuario))< 0 then
      begin
        Application.CreateForm(TFrModImpG, FrModImpG);
        if FrModImpG.ShowModal = IDOK then
        begin
          vtipo := FrModImpG.ComboBox1.Text;
          Result := true;
        end
        else
          vtipo := vImp_Us;
      end else if (vAltImp = 'S') or (_LerConfiguracoesRegistroString('ComboBoxNomeImpressora'+vNomeUsuario)='') then
      begin
        Application.CreateForm(TFrModImpG, FrModImpG);
        if FrModImpG.ShowModal = IDOK then
        begin
          vtipo := FrModImpG.ComboBox1.Text;
          Result := true;
        end
        else
          vtipo := vImp_Us;
      end
      else
      begin
        vtipo := vImp_Us;
        Result := true;
      end;

      if not (Print as TRDPrint).SetPrinterbyName(_LerConfiguracoesRegistroString('ComboBoxNomeImpressora'+vNomeUsuario)) then
      begin
        if vtipo = 'Epson' then
          (Print as TRDPrint).Impressora := Epson
        else if vtipo = 'Grafico' then
          (Print as TRDPrint).Impressora := Grafico
        else if vtipo = 'HP' then
          (Print as TRDPrint).Impressora := HP
        else if vtipo = 'Rima' then
          (Print as TRDPrint).Impressora := Rima;
      end;
    finally
      if Assigned(FrModImpG) then
        FrModImpG.Free;
    end;
  except on E: Exception do
    begin
      registraErro('TSingleton.ModImp ' + E.Message);
    end;
  end;
end;

procedure TSingleton.MontaLinha(Pos: Integer; const Dado: string);
var
  i: Smallint;
  car: string[1];
begin
  i := 1;
  while i <= length(Dado) do
  begin
    car := Copy(dado, i, 1);
    AuxStr[(i - 1) + pos] := car[1];
    inc(i);
  end;
end;

procedure TSingleton.montarCalc(DBGrid: TDBGrid; vNomePlanilha, pAcao: string);
const
  xlCellTypeLastCell = $0000000B;
var
  vTemp: string;
  vPointer: Pointer;
  vCor, vLinhaExcel: integer;
  I, J: Integer;
  DataAux: TDateTime;
  DiaAux: word;
  MesAux: word;
  AnoAux: word;
  vSize: Integer;
  vOK: Boolean;
begin
	if (pAcao = '') then
  begin
    Application.CreateForm(TfrmColunasExcelAtivos, frmColunasExcelAtivos);
    frmColunasExcelAtivos.vDataSetTabela := TClientDataSet(DBGrid.DataSource.DataSet);
    frmColunasExcelAtivos.vNomeUsuario := vNomeUsuario;
    frmColunasExcelAtivos.vTitulo := vNomePlanilha;
    frmColunasExcelAtivos.vTransacao := transacaoCol;
    frmColunasExcelAtivos.ShowModal;
    Exit;
  end;

  if (pAcao = 'A') or (pAcao = '') then
    vOK := criarCalc(DBGrid, vNomePlanilha)
  else
    vOK := True;

  if vOK then
  begin
    try
      //Cria o link OLE com o OpenOffice
      if VarIsEmpty(OpenOffice) then
        OpenOffice := CreateOleObject('com.sun.star.ServiceManager');
      Connect := not (VarIsEmpty(OpenOffice) or VarIsNull(OpenOffice));

      //Inicia o Calc
      OpenDesktop := OpenOffice.CreateInstance('com.sun.star.frame.Desktop');
      Documento   := OpenDesktop.LoadComponentFromURL('private:factory/scalc',
                        '_blank', 0, VarArrayCreate([0, -1], varVariant));
      Planilha    := Documento.getSheets.getByName('Planilha1');
      Sheets      := Documento.Sheets;
      Sheet       := Sheets.getByIndex(0);

      //Criar linha inicial
      Celula := Planilha.getCellByPosition(i, 0);
      Celula.CharWeight := 200;
      Sheet.getCellByPosition(i, 0).setString('Exportação de dados para Planilha');

      //Definir largura colunas
      for I := 0 to DBGrid.Columns.Count - 1 do
      begin
        if (I = 0) then
        begin
          if Length('Exportação de dados para Planilha') > (TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I].FieldName).Size) then
            vSize := Length('Exportação de dados para Planilha')
          else
            vSize := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I].FieldName).Size;
        end
        else
          vSize := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I].FieldName).Size;
        Planilha.getColumns.getByIndex(i).width := vSize * 220;
      end;

      //Preencher colunas planilha
      j := 1;
      for I := 0 to DBGrid.Columns.Count - 1 do
      begin
        Celula := Planilha.getCellByPosition(i, j);
        Celula.CharWeight := 200;
        Celula.CellBackColor := '39423';
        Sheet.getCellByPosition(i, j).setString(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I].FieldName).DisplayName);
      end;

      //Preencher linhas planilha
      vPointer:=TClientDataSet(DBGrid.DataSource.DataSet).GetBookmark;
      
      j := 2;
      TClientDataSet(DBGrid.DataSource.DataSet).First;
      while not TClientDataSet(DBGrid.DataSource.DataSet).Eof do
      begin
      	abreStatusProcessamento('', 'Exportando para o planilha - '+vNomePlanilha+'...');
        for I := 1 to DBGrid.Columns.Count  do
        begin
          vTemp := Trim(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsString);
          if vTemp = '' then
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TTimeField then
          begin
          	if not TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).IsNull then
            begin
              DataAux := TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime;
              Sheet.getCellByPosition(i, j).setString(FormatDateTime('hh:mm:ss', DataAux));
            end;
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TDateTimeField then
          begin
          	if not TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).IsNull then
            begin
              DataAux:=TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime;
              DecodeDate(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName).AsDateTime, AnoAux, MesAux, DiaAux);
              if DataAux-EncodeDate(AnoAux, MesAux, DiaAux) = 0 then
                Sheet.getCellByPosition(i, j).setString(FormatDateTime('dd/mm/yyyy', EncodeDate(AnoAux, MesAux, DiaAux)))
              else
                Sheet.getCellByPosition(i, j).setString(FormatDateTime('dd/mm/yyyy', DataAux));
            end;
          end
          else if (TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TIntegerField) and (trim(vTemp) <> '') then
            Sheet.getCellByPosition(i, j).setValue(StrToInt(vTemp))
          else if (TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TFloatField) and (trim(vTemp) <> '') then
          begin
          	Sheet.getCellByPosition(i, j).setValue(StrToFloat(vTemp));
          	if (TFloatField(TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName)).currency) then
            	Sheet.getCellByPosition(i, j).NumberFormat := 21
            else
	            Sheet.getCellByPosition(i, j).NumberFormat := 4;
          end
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TStringField then
            Sheet.getCellByPosition(i, j).setString(vTemp)
          else
            Sheet.getCellByPosition(i, j).setString(vTemp);

          Celula := Planilha.getCellByPosition(i, j);

          if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TTimeField then
            Celula.HoriJustify   := 3
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TDateTimeField then
            Celula.HoriJustify   := 3
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TFloatField then
            Celula.HoriJustify   := 3
          else if TClientDataSet(DBGrid.DataSource.DataSet).FieldByName(DBGrid.Columns[I - 1].FieldName) is TIntegerField then
            Celula.HoriJustify   := 3;

          if ((j mod 2) = 1) then
            Celula.CellBackColor := 8303567
          else
            Celula.CellBackColor := 13893372;
        end;
        j := j + 1;

        TClientDataSet(DBGrid.DataSource.DataSet).Next;
      end;

      TClientDataSet(DBGrid.DataSource.DataSet).GotoBookmark(vPointer);
    finally
    	fechaStatusProcessamento;
//    	if (pAcao = '') or (pAcao = 'F') then
    end;
  end;
end;

