function TSingleton.TestarCst(vcst: string): boolean;
begin
  TestarCst := true;
  if vcst = '' then
  begin
    Application.MessageBox('Cst Não Informado.' + chr(13) + 'Campo Requerido.', 'Aviso', MB_OK +
      MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if Length(Trim(vcst)) <> 3 then
  begin
    ShowAtencao('CST em formato incorreto, são 3 dígitos');
    Result := False;
  end
  else
  begin
    if not strIn(Copy(vcst, 1, 1), ['0', '1', '2', '3', '4', '5', '6', '7', '8']) then
    begin
      ShowAtencao('Primeiro dígito do CST ICMS incorreto' + sLineBreak + 'Valores válidos: 0, 1, 2, 3, 4, 5, 6, 7 e 8');
      Result := False;
    end
    else
    if not strIn(Copy(vcst, 2, 2), ['00', '02', '10', '15', '20', '30', '40', '41', '50', '51', '53', '60', '61', '70', '90']) then
    begin
      ShowAtencao('Segundo e terceiro dígito do CST ICMS incorreto' + sLineBreak + 'Valores válidos: 00, 02, 10, 15, 20, 30, 40, 41, 50, 51, 53, 60, 61, 70 e 90');
      Result := False
    end;
  end;
end;

function TSingleton.tirapontos(vdados: string; CasaDecimal: Integer): string;
var
  i: integer;
  vd1, vd: string;
begin
  //
  // vd1:='';
  if trim(vdados) <> '' then
  begin
    vd := trim(vdados);
    for i := 1 to length(vd) do
    begin
      if (i = 1) and (vd[i] <> '.') then
        vd1 := vd[i]
      else
      begin
        if vd[i] <> '.' then
          vd1 := vd1 + vd[i];
      end;
    end;
    Tirapontos := vd1;
  end
  else if CasaDecimal = 4 then
    Tirapontos := '0,0000'
  else if CasaDecimal = 3 then
    Tirapontos := '0,000'
  else
    Tirapontos := '0,00';
end;

