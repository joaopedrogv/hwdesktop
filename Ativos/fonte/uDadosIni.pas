function TSingleton.ExtractTagXML(ATag: string; var AText: string): string;
var
  AtagIni, AtagFim: string;
  PosTagIni, PosTagFim: Integer;
begin
  AtagIni   := '<' + ATag + '>';
  AtagFim   := '<' + ATag + '/>';
  PosTagIni := Pos(AtagIni, AText);
  PosTagFim := Pos(AtagFim, AText);

  if ( PosTagIni > 0) and (PosTagFim > PosTagIni)  then
  begin
//    TStringList.Create().AddPair('comtag', AText).SaveToFile('d:\comtag.txt');
    Result := Copy(AText, PosTagIni + Length(AtagIni), PosTagFim - PosTagIni - Length(AtagIni));
//    TStringList.Create().AddPair('comtag', Result).SaveToFile('d:\semtag.txt');
