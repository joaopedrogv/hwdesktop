function TSingleton.testarImpressaoReciboProgFid(pbuscas: TIBQuery; pNdoc: Integer; pTipoDoc: string; pTipoOP: string; pImprimirRecibo: boolean; var pDuasVias: string): boolean;
begin
  Result := false;

  if not vProgFid.vHabilitarProgFid then
    exit;

  if not pImprimirRecibo then
    if not vProgFid.vImprimirRecibo then
      exit;

  if not pImprimirRecibo then
    if (trim(pTipoDoc) <> 'REQ') and (trim(pTipoDoc) <> 'OS') and (trim(pTipoDoc) <> 'MOT')
      and (trim(pTipoDoc) <> 'PRE') and (trim(pTipoDoc) <> 'DEV') and (trim(pTipoDoc) <> 'DEVV') and (trim(pTipoDoc) <> 'REC') then
      exit;

  if not pImprimirRecibo then
  begin
   	SqlOpen(' SELECT FIRST 1 CODIGO FROM RECIBO_PROG_FID ' +
      ' WHERE NDOC = ' + IntToStr(pNdoc) +
      ' AND TIPODOC = ' + QuotedStr(pTipoDoc) +
      ' AND COD_EMPRESA = ' + codEmpresa +
      ' AND TIPO = ' + QuotedStr(pTipoOP) +
      ' AND VALE <> ''S'' ' +
      ' ORDER BY CODIGO DESC ', pbuscas);

    if pbuscas.IsEmpty then
      exit;
  end;

  if Application.MessageBox('Deseja imprimir recibo do programa de fidelidade com 2 cópias na mesma página?', 'Atenção.',  MB_ICONQUESTION + MB_YESNO) = IDYES then
    pDuasVias := 'S'
  else
    pDuasVias := 'N';

  Result := true;    
end;

function TSingleton.textoInTStrings(pTexto: string; pTStrings: TStrings): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to pTStrings.Count - 1 do
    if copy(pTStrings[I], 1, Length(Trim(pTexto))) = Trim(pTexto) then
    begin
      Result := True;
      Exit;
    end;
end;

function TSingleton.CountSubString(pSubString, pString: string; pCaseSensitive: boolean = False): Integer;
var
  vCount: integer;
begin
  if not pCaseSensitive then // if not use CaseSentive
  begin // all to upper
    pString := AnsiUpperCase(pString);
    pSubString := AnsiUpperCase(pSubString);
  end;
  vCount := 0;
  while Trim(pString) <> '' do // while text is not null
  begin
    if Pos(pSubString,pString) > 0 then // if found sub-text in text
    begin
      Inc(vCount); // inc vCount
      Delete(pString,1,Pos(pSubString,pString) + Length(pSubString)); // delete text verified
    end
    else // if not found, clear text to exit
      pString := '';
  end;
  Result := vCount; // return vCount
end;

