   vCrystal.WindowStyle.Title := 'RELATÓRIO CONCILIAÇÃO BANCÁRIA';
   vCrystal.WindowState := wsMaximized;
   vCrystal.WindowStyle.BorderStyle := bsNone;
   crpeTmp := vCrystal;

   vForm:= TForm.Create(Nil);
   vForm.bordericons:= [bisystemmenu];
   vForm.OnResize:= OnCrpeViewerResize;
   vForm.ShowHint := true;
   vForm.Caption := 'RELATÓRIO CONCILIAÇÃO BANCÁRIA';
