function TSingleton.financeiroFechando(pQuery: TIBQuery): Boolean;
begin
	try
    Result := false;

    pQuery.Close;
    pQuery.SQL.Text := 'select first 1 DIA_FCD, INICIA_FECH from FECH_DIA' +
      ' where CODIGO_EMP = ' + codEmpresa +
      ' order by dia_fcd desc ';
    pQuery.Open;

    if not pQuery.IsEmpty then
    begin
      Result := trim(pQuery.FieldByName('inicia_fech').AsString) = 'S';

      if Result then
        Application.MessageBox(pchar('Financeiro está sendo fechado, favor aguardar o fechamento do caixa antes de continuar!'),
          'Atenção',  MB_ICONWARNING + MB_OK);
    end
    else
    begin
    	Result := false;
      exit;
    end;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro ao verificar se o Financeiro esta sendo fechado. Erro: ' +
        e.message),
        'Atenção', 0 + 64);
      registraErro('function TSingleton.financeiroFechando Erro: ' + e.Message);
      if (Pos('Dataset open', e.Message) > 0)
      	or (Pos('Unable to complete network', e.Message) > 0)
        or (Pos('shutdown', e.Message) > 0) then
      begin
        if Application.MessageBox('Falha de conexão com o banco de dados. Deseja tentar recuperar a conexão?', 'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = ID_YES then
          if not conectaBanco(pQuery.Database, vBancoHW, True) then
            Application.MessageBox('O sistema não recuperou a conexão. Favor entre novamente no sistema', 'Atenção', 0 + 64);
      end;
    end;
  end;
end;

