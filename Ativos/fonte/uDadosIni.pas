procedure TSingleton.nfc_abreFormNFConsumidor(NomeProcedure: string;
  TipoForm: Integer);
var
  nfc_abreformEmissor   : Tnfc_abreformEmissor;
  nfc_abreformNFCe      : Tnfc_abreformNFCe;
  nfc_abreformNFCSat    : Tnfc_abreformNFCSat;
  nfc_abreformConfigNFCe: Tnfc_abreformConfigNFCe;
begin
  if vNFConsumidor.AHandle = 0 then
    CarregaPacote('pkNFConsumidor', vNFConsumidor.AHandle);

  if vNFConsumidor.AHandle = 0 then
  begin
    Application.MessageBox('Pacote NF Consumidor não carregado', 'Atenção', 0 + 64);
    Exit;
  end;
  if Trim(LowerCase(NomeProcedure)) = Trim(LowerCase('nfc_abreformEmissor')) then
  begin
    @nfc_abreformEmissor := GetProcAddress(vNFConsumidor.AHandle, PChar(NomeProcedure));
    if Assigned(nfc_abreformEmissor) then
      nfc_abreformEmissor(TipoForm);
  end
  else if Trim(LowerCase(NomeProcedure)) = Trim(LowerCase('nfc_abreformNFCe')) then
  begin
    @nfc_abreformNFCe := GetProcAddress(vNFConsumidor.AHandle, PChar(NomeProcedure));
    if Assigned(nfc_abreformNFCe) then
      nfc_abreformNFCe(TipoForm);
  end
  else if Trim(LowerCase(NomeProcedure)) = Trim(LowerCase('nfc_abreformNFCSat')) then
  begin
    @nfc_abreformNFCSat := GetProcAddress(vNFConsumidor.AHandle, PChar(NomeProcedure));
    if Assigned(nfc_abreformNFCSat) then
      nfc_abreformNFCSat(TipoForm);
  end
  else if Trim(LowerCase(NomeProcedure)) = Trim(LowerCase('nfc_abreformConfigNFCe')) then
  begin
    @nfc_abreformConfigNFCe := GetProcAddress(vNFConsumidor.AHandle, PChar(NomeProcedure));
    if Assigned(nfc_abreformConfigNFCe) then
      nfc_abreformConfigNFCe;
  end;
end;

