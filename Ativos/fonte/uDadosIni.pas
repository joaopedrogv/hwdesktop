function TSingleton.retornaDadosBandeira(pBandeira: string; pCodEmpresa: Integer;
	pNdoc: Integer; pTipoDoc: string; pBuscas: TIBQuery): Integer;
var
	vList: TStringList;
  vCodNFCE: Integer;
  vCodBandeira: Integer;
  vBandeira: string;
  vCodMax: Integer;
  I: Integer;
begin
	Result := 0;

  try
    vList := TStringList.Create;
    vList.Clear;

    if (pNdoc > 0) and (Trim(pTipoDoc) <> '') then
    begin
    	if (Trim(pTipoDoc) = 'REQ') or (Trim(pTipoDoc) = 'OS') then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' select COD_NFCE FROM PEDVENDA ' +
          ' where NPED = :NDOC ' +
          ' and TIPO = :TIPO ' +
          ' and COD_EMPRESA = :COD_EMPRESA ';
        pBuscas.ParamByName('NDOC').AsInteger := pNdoc;
        pBuscas.ParamByName('TIPO').AsString := Trim(pTipoDoc);
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
        pBuscas.Open;

        if pBuscas.FieldByName('COD_NFCE').AsInteger > 0 then
        begin
          vCodNFCE := pBuscas.FieldByName('COD_NFCE').AsInteger;

          pBuscas.Close;
          pBuscas.SQL.Text := ' select SEQID, NREQUISICAO, TPDOCS, COD_EMPRESA, ' +
            ' N_DOCNSU_ADM, N_AUT_CART, STATUS, IMPRESSAO, REDE from TRANSACAO_CARTAO ' +
            ' where NREQUISICAO = :NDOC and TPDOCS = :TIPO and COD_EMPRESA = :COD_EMPRESA ';
          pBuscas.ParamByName('NDOC').AsInteger := vCodNFCE;
          pBuscas.ParamByName('TIPO').AsString := 'NFCE';
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
          pBuscas.Open;

          if pBuscas.IsEmpty then
          begin
            pBuscas.Close;
            pBuscas.SQL.Text := ' select SEQID, NREQUISICAO, TPDOCS, COD_EMPRESA, ' +
              ' N_DOCNSU_ADM, N_AUT_CART, STATUS, IMPRESSAO, REDE from TRANSACAO_CARTAO ' +
              ' where NREQUISICAO = :NDOC and TPDOCS = :TIPO and COD_EMPRESA = :COD_EMPRESA ';
            pBuscas.ParamByName('NDOC').AsInteger := pNdoc;
            pBuscas.ParamByName('TIPO').AsString := Trim(pTipoDoc);
            pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
            pBuscas.Open;
          end;
        end
        else
        begin
          pBuscas.Close;
          pBuscas.SQL.Text := ' select SEQID, NREQUISICAO, TPDOCS, COD_EMPRESA, ' +
            ' N_DOCNSU_ADM, N_AUT_CART, STATUS, IMPRESSAO, REDE from TRANSACAO_CARTAO ' +
            ' where NREQUISICAO = :NDOC and TPDOCS = :TIPO and COD_EMPRESA = :COD_EMPRESA ';
          pBuscas.ParamByName('NDOC').AsInteger := pNdoc;
          pBuscas.ParamByName('TIPO').AsString := Trim(pTipoDoc);
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
          pBuscas.Open;
        end;
      end
      else
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' select SEQID, NREQUISICAO, TPDOCS, COD_EMPRESA, ' +
          ' N_DOCNSU_ADM, N_AUT_CART, STATUS, IMPRESSAO, REDE from TRANSACAO_CARTAO ' +
          ' where NREQUISICAO = :NDOC and TPDOCS = :TIPO and COD_EMPRESA = :COD_EMPRESA ';
        pBuscas.ParamByName('NDOC').AsInteger := pNdoc;
        pBuscas.ParamByName('TIPO').AsString := Trim(pTipoDoc);
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
        pBuscas.Open;
      end;

      pBuscas.First;
      while not pBuscas.Eof do
      begin
        if Trim(pBuscas.FieldByName('REDE').AsString) <> '' then
        begin
          vBandeira := Trim(pBuscas.FieldByName('REDE').AsString);
          vBandeira := StringReplace(Trim(vBandeira), 'DEBITO', '', []);
          vBandeira := StringReplace(Trim(vBandeira), 'DEBIT', '', []);
          vBandeira := StringReplace(Trim(vBandeira), 'CREDITO', '', []);
          vBandeira := StringReplace(Trim(vBandeira), 'CREDIT', '', []);

          vList := Split(trim(vBandeira), ' ');
        end;

        pBuscas.Next;
      end;
    end
    else
    begin
    	vBandeira := Trim(pBandeira);
      vBandeira := StringReplace(Trim(vBandeira), 'DEBITO', '', []);
      vBandeira := StringReplace(Trim(vBandeira), 'DEBIT', '', []);
      vBandeira := StringReplace(Trim(vBandeira), 'CREDITO', '', []);
      vBandeira := StringReplace(Trim(vBandeira), 'CREDIT', '', []);

      vList := Split(trim(vBandeira), ' ');
    end;

    pBuscas.Close;
    pBuscas.SQL.Text := ' select first 1 COD_BANDEIRA from BANDEIRAS_CARTAO ' +
      ' where DESCRICAO = :DESCRICAO ' +
      ' and COD_EMPRESA = :COD_EMPRESA ' +
      ' and ATIVO = 1 ';
    pBuscas.ParamByName('DESCRICAO').AsString := Trim(vBandeira);
    pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
    pBuscas.Open;

    if not pBuscas.IsEmpty then
    begin
    	Result := pBuscas.FieldByName('COD_BANDEIRA').AsInteger;
      Exit;
    end;

    if (Pos('CARD', Trim(vBandeira)) <= 0) and (pBuscas.IsEmpty) then
    begin
      pBuscas.Close;
      pBuscas.SQL.Text := ' select first 1 COD_BANDEIRA from BANDEIRAS_CARTAO ' +
        ' where DESCRICAO = :DESCRICAO ' +
        ' and COD_EMPRESA = :COD_EMPRESA ' +
        ' and ATIVO = 1 ';
      pBuscas.ParamByName('DESCRICAO').AsString := Trim(vBandeira) + 'CARD';
      pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      pBuscas.Open;

      if not pBuscas.IsEmpty then
      begin
        Result := pBuscas.FieldByName('COD_BANDEIRA').AsInteger;
        Exit;
      end;
    end;

    if pBuscas.IsEmpty then
    begin
      for I := 0 to vList.Count - 1 do
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' select first 1 COD_BANDEIRA from BANDEIRAS_CARTAO ' +
          ' where DESCRICAO = :DESCRICAO ' +
          ' and COD_EMPRESA = :COD_EMPRESA ' +
          ' and ATIVO = 1 ';
        pBuscas.ParamByName('DESCRICAO').AsString := Trim(vList[I]);
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
        pBuscas.Open;

        if ((Trim(vList[I]) = 'MASTER')
        		or (Trim(vList[I]) = 'MASTERCARD')
            or (Trim(vList[I]) = 'HIPER')
            or (Trim(vList[I]) = 'HIPERCARD'))
        	and (pBuscas.IsEmpty) then
        begin
          pBuscas.Close;
          pBuscas.SQL.Text := ' select first 1 COD_BANDEIRA from BANDEIRAS_CARTAO ' +
            ' where DESCRICAO = :DESCRICAO ' +
            ' and COD_EMPRESA = :COD_EMPRESA ' +
            ' and ATIVO = 1 ';
          if ((Trim(vList[I]) = 'MASTER') or (Trim(vList[I]) = 'MASTERCARD')) then
          	pBuscas.ParamByName('DESCRICAO').AsString := IfThen(Trim(vList[I]) = 'MASTER', 'MASTERCARD', 'MASTER')
          else if ((Trim(vList[I]) = 'HIPER') or (Trim(vList[I]) = 'HIPERCARD')) then
          	pBuscas.ParamByName('DESCRICAO').AsString := IfThen(Trim(vList[I]) = 'HIPER', 'HIPERCARD', 'HIPER');
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
          pBuscas.Open;
        end;

        if (pBuscas.IsEmpty) then
        begin
          vCodBandeira := Gencodigo('BANDEIRAS_CARTAO', pBuscas, IntToStr(pCodEmpresa));

          pBuscas.Close;
          pBuscas.SQL.Text := 'select max(coalesce(COD_BANDEIRA, 0)) as MAXIMOCOD from BANDEIRAS_CARTAO ' +
            ' where COD_EMPRESA = ' + IntToStr(pCodEmpresa);
          pBuscas.open;

          vCodMax := pBuscas.FieldByName('MAXIMOCOD').AsInteger;

          if (vCodMax > vCodBandeira) then
          begin
          	SqlExec(' update codigo set valor = ' + IntToStr(vCodMax) +
            	' where tabela = ''BANDEIRAS_CARTAO'' and cod_empresa = ' + IntToStr(pCodEmpresa), pBuscas);

          	vCodBandeira := Gencodigo('BANDEIRAS_CARTAO', pBuscas, IntToStr(pCodEmpresa));
          end;

          pBuscas.Close;
          pBuscas.SQL.Text := ' INSERT INTO BANDEIRAS_CARTAO (COD_BANDEIRA, COD_EMPRESA, DESCRICAO, ATIVO) ' +
            ' VALUES (:COD_BANDEIRA, :COD_EMPRESA, :DESCRICAO, :ATIVO); ';
          pBuscas.ParamByName('COD_BANDEIRA').AsInteger := vCodBandeira;
          pBuscas.ParamByName('DESCRICAO').AsString := Copy(Trim(vBandeira), 1, 32);
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
          pBuscas.ParamByName('ATIVO').AsInteger := 1;
          pBuscas.ExecSQL;

          if pBuscas.Transaction.InTransaction then
            pBuscas.Transaction.Commit;

          pBuscas.Close;
          pBuscas.SQL.Text := ' select first 1 COD_BANDEIRA from BANDEIRAS_CARTAO ' +
            ' where COD_BANDEIRA = :COD_BANDEIRA ' +
            ' and COD_EMPRESA = :COD_EMPRESA ' +
            ' and ATIVO = 1 ';
          pBuscas.ParamByName('COD_BANDEIRA').AsInteger := vCodBandeira;
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
          pBuscas.Open;
        end;

        if not pBuscas.IsEmpty then
        begin
          Result := pBuscas.FieldByName('COD_BANDEIRA').AsInteger;
          Exit;
        end;
        break;
      end;
    end;
  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao retornar dados da bandeira. Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('TSingleton.retornaDadosBandeira. Erro: ' + e.Message);
    end;
  end;
end;

procedure TSingleton.retornaDadosContato(
	pCheckListBox: TCheckListBox;
  var vAplicativo: string;
  var vContato: string;
  var vIdentificacao: string);
var
	vTempOrig: string;
  vTemp: string;
begin
	vTempOrig := pCheckListBox.Items[pCheckListBox.ItemIndex];

  if Copy(vTempOrig, Length(vTempOrig) - 1, 1) = '*' then
  	vTempOrig := Copy(vTempOrig, 1, Length(vTempOrig) - 3);

  vAplicativo := Copy(vTempOrig, 1, Pos(' - ', vTempOrig) - 1);
  vContato := '';
  vIdentificacao := '';

  vTemp := StringReplace(vTempOrig, vAplicativo + ' - ', '', [rfReplaceAll]);

  vContato := Copy(vTemp, 1, Pos(' - ', vTemp) - 1);

  vIdentificacao := StringReplace(vTemp, vContato + ' - ', '', [rfReplaceAll]);
end;

function TSingleton.retornaDadosEtiqueta(
	pBuscas: TIBQuery;
  pCodBarra: string;
  pGrupoProd: Integer = 0;
  pCodProd: string = '';
  pCodGrade: Integer = 0): TEtiqProd;
var
	temp: string;
  grupoprodtemp: string;
  codprodtemp: string;
	valortemp: string;
  carater: string;
  nBarra: string;
  I, J: Integer;
  vcodetiq: Int64;
begin
//	if Pos('*', pCodBarra) > 0 then
//    pCodBarra := Copy(pCodBarra, 1, Pos('*', pCodBarra))
//  else if Pos('/', pCodBarra) > 0 then
//    pCodBarra := Copy(pCodBarra, 1, Pos('/', pCodBarra));
  if (Trim(pCodBarra) <> '') then
  	pCodBarra := Trim(pCodBarra);

	vEtiqProd.Quant := 1;
  if (trim(pCodBarra) <> '') and (Pos('*', pCodBarra) > 0) then
  begin
    j := 0;
    for i := 1 to length(pCodBarra) do
      if (Copy(pCodBarra, I, 1) = '*') then
      begin
        inc(j);
        if j >= 2 then
        begin
          Application.MessageBox('Quantidade Invalida. Dois ou mais sinais de multiplicação',
            'Atenção', MB_ICONWARNING + MB_OK);
          exit;
        end;
      end;
    for i := 1 to length(pCodBarra) do
      if (Copy(pCodBarra, I, 1) = '*') then
      begin
        try
          vEtiqProd.Quant := strtofloat(copy(pCodBarra, 1, I - 1));
        except
          Application.MessageBox(pchar('Quantidade Invalida'), 'Informação', MB_ICONINFORMATION
            +
            mb_OK);
          exit;
        end;
        nBarra := COPY(pCodBarra, I + 1, 20);
      end;
    if vEtiqProd.Quant = 0 then
    begin
      vEtiqProd.Quant := 1;
      nBarra := pCodBarra;
    end;
    pCodBarra := nBarra;
  end;

	if (trim(pCodProd) <> '') then
  begin
  	vEtiqProd.GrupoProd := pGrupoProd;
  	vEtiqProd.CodProd := pCodProd;
  	vEtiqProd.CodGrade := pCodGrade;
  	vEtiqProd.CodBarra := pCodBarra;

  	Result := vEtiqProd;
    exit;
  end;
	vEtiqProd.GrupoProd := 0;
  vEtiqProd.CodProd := '';
  vEtiqProd.CodGrade := 0;
  vEtiqProd.CodBarra := pCodBarra;

  Result := vEtiqProd;

  vBuscasTmp := TIBQuery.Create(Application);
  vBuscasTmp.Database := pBuscas.Database;
  vBuscasTmp.Transaction := pBuscas.Transaction;

  temp := '';
	if (Copy(pCodBarra, 1, 2) = 'A-') then
  begin
    if Length(pCodBarra) > 4 then
      temp := Copy(pCodBarra, 5, Length(pCodBarra) - 4);

//    if OnlyNumber(temp) <> temp then // Não é o padrão de codigos do sistema, pois aceitase apenas numeros
//      Exit;
  	if not (TryStrToInt64('$' + temp, vcodetiq)) then
    	exit;

    if trim(temp) <> '' then
    begin
      vBuscasTmp.Close;
      vBuscasTmp.SQL.Text := ' select et.grupo_prod, ' +
        ' et.cod_prod, ' +
        ' et.cod_grade, ' +
        ' pr.num_fab_prod from cod_barra_etiq et ' +
        ' inner join produtos pr on ' +
        '		et.grupo_prod = pr.grupo_prod ' +
        '		and et.cod_prod = pr.cod_prod ' +
        '		and et.cod_empresa = pr.cod_empresa ' +
        ' where et.cod_etiq = ' + IntToStr(vcodetiq) +
        ' and et.cod_empresa = ' + codEmpresa;
      vBuscasTmp.Open;

      if not vBuscasTmp.IsEmpty then
      begin
        vEtiqProd.GrupoProd := vBuscasTmp.FieldByName('GRUPO_PROD').AsInteger;
        vEtiqProd.CodProd := vBuscasTmp.FieldByName('COD_PROD').AsString;
        vEtiqProd.CodGrade := vBuscasTmp.FieldByName('COD_GRADE').AsInteger;
        vEtiqProd.CodBarra := trim(vBuscasTmp.FieldByName('NUM_FAB_PROD').AsString);

        if vEtiqProd.CodGrade > 0 then
        begin
          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select cod_grade from cod_grade_prod ' +
            ' where grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
            ' and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
            ' and cod_empresa = ' + codEmpresa +
            ' and cod_grade = ' + IntToStr(vEtiqProd.CodGrade);
          vBuscasTmp.Open;

          if vBuscasTmp.IsEmpty then
          begin
            Application.MessageBox(pchar('Grade de código ' + IntToStr(vEtiqProd.CodGrade) + ' não encontrada para o produto'), 'Atenção', MB_ICONINFORMATION + MB_OK);
            vEtiqProd.GrupoProd := 0;
            vEtiqProd.CodProd := '';
            vEtiqProd.CodGrade := 0;
            result := vEtiqProd;
            exit;
          end;
        end;

        Result := vEtiqProd;
      end;
    end;
  end
  else if Copy(pCodBarra, 1, 2) = 'G-' then
  begin
    try
      if (pos(';', pCodBarra) > 0) then //compatibilidade com etiquetas antigas
      begin
        vEtiqProd.CodGrade := StrToInt(Copy(pCodBarra, Pos(';', pCodBarra) + 1, Length(pCodBarra) - Pos(';', pCodBarra)));
        vEtiqProd.GrupoProd := StrToInt(trim(Copy(pCodBarra, 5, (pos(';', pCodBarra) - 5 - strtoint(vProduto.vDigitosProd)))));
        vEtiqProd.CodProd := trim(Copy(pCodBarra, (pos(';', pCodBarra) - strtoint(vProduto.vDigitosProd)), strtoint(vProduto.vDigitosProd)));

        vBuscasTmp.Close;
        vBuscasTmp.SQL.Text := ' select num_fab_prod from produtos ' +
          '	where	grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
          '	and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
          '	and cod_empresa = ' + codEmpresa +
          ' and ativo = 1 ';
        vBuscasTmp.Open;

        vEtiqProd.CodBarra := trim(vBuscasTmp.FieldByName('NUM_FAB_PROD').AsString);

        if trim(vEtiqProd.CodBarra) = '' then
        begin
          Application.MessageBox('Produto não encontrado', 'Atenção', MB_ICONINFORMATION + MB_OK);
          vEtiqProd.GrupoProd := 0;
          vEtiqProd.CodProd := '';
          vEtiqProd.CodGrade := 0;
          result := vEtiqProd;
          exit;
        end;
      end
      else if (pos('/', pCodBarra) > 0) then //compatibilidade com etiquetas antigas
      begin
        vEtiqProd.CodGrade := StrToInt(Copy(pCodBarra, Pos('/', pCodBarra) + 1, Length(pCodBarra) - Pos('/', pCodBarra)));
        vEtiqProd.GrupoProd := strtoint(trim(Copy(pCodBarra, 5, (pos('/', pCodBarra) - 5 - strtoint(vProduto.vDigitosProd)))));
        vEtiqProd.CodProd := trim(Copy(pCodBarra, (pos('/', pCodBarra) - strtoint(vProduto.vDigitosProd)), strtoint(vProduto.vDigitosProd)));

        vBuscasTmp.Close;
        vBuscasTmp.SQL.Text := ' select num_fab_prod from produtos ' +
          '	where	grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
          '	and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
          '	and cod_empresa = ' + codEmpresa +
          ' and ativo = 1 ';
        vBuscasTmp.Open;

        vEtiqProd.CodBarra := trim(vBuscasTmp.FieldByName('NUM_FAB_PROD').AsString);

        if trim(vEtiqProd.CodBarra) = '' then
        begin
          Application.MessageBox('Produto não encontrado', 'Atenção', MB_ICONINFORMATION + MB_OK);
          vEtiqProd.GrupoProd := 0;
          vEtiqProd.CodProd := '';
          vEtiqProd.CodGrade := 0;
          result := vEtiqProd;
          exit;
        end;
      end
      else
      begin //Novo modelo de etiqueta
        vEtiqProd.CodGrade := StrToInt(copy(pCodBarra, (3 + vEmp.vDigitosEmp + vEmp.vDidgitosGrup + strtoint(vProduto.vDigitosProd)), 10));
        vEtiqProd.GrupoProd := strtoint(trim(Copy(pCodBarra, 3 + vEmp.vDigitosEmp, vEmp.vDidgitosGrup)));
        vEtiqProd.CodProd := trim(Copy(pCodBarra, 3 + vEmp.vDigitosEmp + vEmp.vDidgitosGrup, strtoint(vProduto.vDigitosProd)));

        vBuscasTmp.Close;
        vBuscasTmp.SQL.Text := ' select num_fab_prod from produtos ' +
          '	where	grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
          '	and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
          '	and cod_empresa = ' + codEmpresa +
          ' and ativo = 1 ';
        vBuscasTmp.Open;

        vEtiqProd.CodBarra := trim(vBuscasTmp.FieldByName('NUM_FAB_PROD').AsString);

        if (trim(vEtiqProd.CodBarra) = '')
        	and (vEmp.vDigitosEmp = 0)
          and (Copy(pCodBarra, 1, 3) = 'G-' + codEmpresa) then
        begin
        	vEtiqProd.CodGrade := StrToInt(copy(pCodBarra, (3 + vEmp.vDigitosEmp + 1 + vEmp.vDidgitosGrup + strtoint(vProduto.vDigitosProd)), 10));
        	vEtiqProd.GrupoProd := strtoint(trim(Copy(pCodBarra, 3 + vEmp.vDigitosEmp + 1, vEmp.vDidgitosGrup)));
        	vEtiqProd.CodProd := trim(Copy(pCodBarra, 3 + vEmp.vDigitosEmp + 1 + vEmp.vDidgitosGrup, strtoint(vProduto.vDigitosProd)));

          if vEtiqProd.CodGrade <= 0 then
          begin
            Application.MessageBox('Produto não encontrado', 'Atenção', MB_ICONINFORMATION + MB_OK);
            vEtiqProd.GrupoProd := 0;
            vEtiqProd.CodProd := '';
            vEtiqProd.CodGrade := 0;
            result := vEtiqProd;
            exit;
          end;

          vBuscasTmp.Close;
          vBuscasTmp.SQL.Text := ' select num_fab_prod from produtos ' +
            '	where	grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
            '	and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
            '	and cod_empresa = ' + codEmpresa +
            ' and ativo = 1 ';
          vBuscasTmp.Open;

          vEtiqProd.CodBarra := trim(vBuscasTmp.FieldByName('NUM_FAB_PROD').AsString);
        end;

        if trim(vEtiqProd.CodBarra) = '' then
        begin
          Application.MessageBox('Produto não encontrado', 'Atenção', MB_ICONINFORMATION + MB_OK);
          vEtiqProd.GrupoProd := 0;
          vEtiqProd.CodProd := '';
          vEtiqProd.CodGrade := 0;
          result := vEtiqProd;
          exit;
        end;
      end;

      if vEtiqProd.CodGrade > 0 then
      begin
        vBuscasTmp.Close;
        vBuscasTmp.SQL.Text := ' select cod_grade from cod_grade_prod ' +
          ' where grupo_prod = ' + IntToStr(vEtiqProd.GrupoProd) +
          ' and cod_prod = ' + QuotedStr(vEtiqProd.CodProd) +
          ' and cod_empresa = ' + codEmpresa +
          ' and cod_grade = ' + IntToStr(vEtiqProd.CodGrade);
        vBuscasTmp.Open;

        if vBuscasTmp.IsEmpty then
        begin
          Application.MessageBox(pchar('Grade de código ' + IntToStr(vEtiqProd.CodGrade) + ' não encontrada para o produto'), 'Atenção', MB_ICONINFORMATION + MB_OK);
          vEtiqProd.GrupoProd := 0;
          vEtiqProd.CodProd := '';
          vEtiqProd.CodGrade := 0;
          result := vEtiqProd;
          exit;
        end;
      end;

      Result := vEtiqProd;
    except
    	raise exception.create('Produto não encontrado');
      vEtiqProd.GrupoProd := 0;
      vEtiqProd.CodProd := '';
      vEtiqProd.CodGrade := 0;
      result := vEtiqProd;
      exit;
    end;
  end
  else if (apenasNumeros(pCodBarra) = pCodBarra) 	and
          (IndexText(vProduto.LeituraPesoBalanca.leitura_executar(pCodBarra).vals.msg, ['VALIDO', 'INVALIDO']) >= 0) then
  begin
     //talvez chamar algum metodo de validacao do EAN13 tambem
     with vProduto.LeituraPesoBalanca do
     begin
       if Copy(UpperCase(vals.msg), 1, 4) = 'ERRO' then
       begin
         ShowErro(vals.msg);
         vEtiqProd.GrupoProd := 0;
         vEtiqProd.CodProd := '';
         vEtiqProd.CodGrade := 0;
         result := vEtiqProd;
         Exit;
       end;

       if vals.msg = 'VALIDO' then
       begin
         if not conf.pesquisarNoCodProd then
         begin
           if vSupermercado = 'S' then
             vEtiqProd.CodBarra := StrZero(vals.codigo, 13)
           else
             vEtiqProd.CodBarra := vals.codigo;
           result := vEtiqProd;
         end
         else
         begin
           if not SqlOpen('select grupo_prod, cod_prod, num_fab_prod, prec_tab_prod from produtos ' +
           	  ' where cod_prod = %s ' +
              ' and cod_empresa = %s ' +
              ' and ativo = 1 ',
                 [QuotedStr(StrZero(vals.codigo, StrToIntDef(vProduto.vDigitosProd, Length(vals.codigo)))),
                 codEmpresa], vBuscasTmp).IsEmpty then
           begin
             vEtiqProd.GrupoProd := vBuscasTmp.FieldByName('grupo_prod').AsInteger;
             vEtiqProd.CodProd := Trim(vBuscasTmp.FieldByName('cod_prod').AsString);
             vEtiqProd.CodBarra := Trim(vBuscasTmp.FieldByName('num_fab_prod').AsString);
             result := vEtiqProd;
           end;
         end;
       end;
     end;
  end;
end;

