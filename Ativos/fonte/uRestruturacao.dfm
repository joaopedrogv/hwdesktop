            'UPDATE COBREBEM CB SET CB.LOCAL_PAG = (SELECT EMP.LOCAl_PAG FROM' +
            ' EMPRESA EMP WHERE EMP.COD_EMPRESA = :COD_EMPRESA), CB.OBS_BOL =' +
            '  (SELECT EMP.OBS_BOL FROM EMPRESA EMP WHERE EMP.COD_EMPRESA = :' +
            'COD_EMPRESA), CB.MENSAGEM_BOL = (SELECT EMP.MENSAGEM_EMP FROM EM' +
            'PRESA EMP WHERE EMP.COD_EMPRESA = :COD_EMPRESA), CB.TX_JUROS = (' +
            'SELECT EMP.TX_JUROS FROM EMPRESA EMP WHERE EMP.COD_EMPRESA = :CO' +
            'D_EMPRESA), CB.MULTAS = (SELECT EMP.MULTAS FROM EMPRESA EMP WHER' +
            'E EMP.COD_EMPRESA = :COD_EMPRESA) WHERE CB.COD_EMPRESA = :COD_EM' +
            'PRESA;'
