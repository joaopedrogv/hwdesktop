            'fab, vanomod, vdescricao;'
          ''
          
            '            UPDATE CLIENTES SET COD_VENDEDORV = COD_VENDEDORV_AN' +
            'T, DATA_ULT_COMPRAV = DATA_ULT_COMPRAV_ANT,'
          
            '              CODMODELO_POTVEIC = CODMODELO_POTVEIC_ANT, COR_POT' +
            'VEIC = COR_POTVEIC_ANT,'
          
