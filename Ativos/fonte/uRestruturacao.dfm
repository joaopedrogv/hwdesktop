            'update RDB$FIELDS set RDB$FIELD_LENGTH = 50, RDB$CHARACTER_LENGT' +
            'H = 50 where RDB$FIELD_NAME = (select trim(f.rdb$field_name) fro' +
            'm rdb$relation_fields r join rdb$fields f on f.rdb$field_name = ' +
            'rdb$field_source where (r.rdb$relation_name = '#39'PEDVENDA_SERV'#39') a' +
            'nd (r.rdb$field_name='#39'CODIGO_VERWSNFSE'#39'));'
          
            'update RDB$FIELDS set RDB$FIELD_LENGTH = 50, RDB$CHARACTER_LENGT' +
            'H = 50 where RDB$FIELD_NAME = (select trim(f.rdb$field_name) fro' +
            'm rdb$relation_fields r join rdb$fields f on f.rdb$field_name = ' +
            'rdb$field_source where (r.rdb$relation_name = '#39'NFSE_CANCELADAS'#39')' +
            ' and (r.rdb$field_name='#39'CODIGO_VERWSNFSE'#39'));'
