            'H = 32 where RDB$FIELD_NAME =  (select trim(f.rdb$field_name) fr' +
            'om rdb$relation_fields r join rdb$fields f on f.rdb$field_name =' +
            ' rdb$field_source where (r.rdb$relation_name = '#39'CLIENTES'#39') and (' +
            'r.rdb$field_name='#39'CONTATO'#39'));'
          
            'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
            'where RDB$FIELD_NAME =  (select trim(f.rdb$field_name) from rdb$' +
            'relation_fields r join rdb$fields f on f.rdb$field_name = rdb$fi' +
            'eld_source where (r.rdb$relation_name = '#39'CLIENTES'#39') and (r.rdb$f' +
            'ield_name='#39'CATEGORIA'#39'));'
          
