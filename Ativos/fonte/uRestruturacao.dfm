            'ENTES'#39') AND (F3.RDB$FIELD_NAME = '#39'IBE$$TEMP_COLUMN'#39')) WHERE (F1.' +
            'RDB$RELATION_NAME = '#39'CLIENTES'#39') AND (F1.RDB$FIELD_NAME = '#39'CONSUM' +
