            'update RDB$RELATION_FIELDS set RDB$NULL_FLAG = 1 where (RDB$FIEL' +
            'D_NAME = '#39'SEQVP'#39') and (RDB$RELATION_NAME = '#39'VENDA_PERDIDA'#39');'
          'CommitLinhaaLinha'
          
            'UPDATE VENDA_PERDIDA SET SEQVP = (select cod from incrementa_cod' +
            'igo(:COD_EMPRESA,'#39'VENDA_PERDIDA'#39')) WHERE COD_EMPRESA = :COD_EMPR' +
            'ESA and SEQVP is null order by data_vnp;'
          'CommitLinhaaLinha'
          'ALTER TABLE VENDA_PERDIDA DROP CONSTRAINT PK_VENDA_PERDIDA;'
          'CommitLinhaaLinha'
          
            'ALTER TABLE VENDA_PERDIDA ADD CONSTRAINT PK_VENDA_PERDIDA PRIMAR' +
            'Y KEY (SEQVP, COD_EMPRESA);'
          'CommitLinhaaLinha'
          
            'update codigo set codigo.valor = (select coalesce(max(venda_perd' +
            'ida.seqvp),0) from venda_perdida where venda_perdida.cod_empresa' +
            '= :cod_empresa) where upper(codigo.tabela)='#39'VENDA_PERDIDA'#39' and c' +
            'odigo.cod_empresa = :COD_EMPRESA;  '
          
