            'e(old.md5, '#39#39') = '#39#39')) then'
          
            '      execute procedure sp_evd_paf(vcodempresa, vtiporegistro, v' +
            'data, vcamposchave, vvalorechave, substring(vmd5 from 1 for 32),' +
            ' vacao);'
          '  end'
          'end^'
          'SET TERM ; ^'
          'fim'
          ''
          'inicio'
          'SET TERM ^ ;'
          'CREATE OR ALTER TRIGGER TI_EVD_PAF_PEDVENDA FOR PEDVENDA'
