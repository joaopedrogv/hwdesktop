          '    begin'
          '      vcodempresa =  old.cod_empresa;'
          '      vdata = old.data_ped;'
          
            '      vvalorechave = '#39'|'#39'||old.nped||'#39'|'#39'||old.tipo||'#39'|'#39'||old.cod_' +
            'empresa||'#39'|'#39';'
          '      vmd5 = old.md5;'
