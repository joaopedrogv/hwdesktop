            '      if ((deleting) or (coalesce(new.md5, '#39#39') <> '#39#39') and (coale' +
            'sce(old.md5, '#39#39') = '#39#39')) then'
          
            '        execute procedure sp_evd_paf(vcodempresa, vtiporegistro,' +
            ' vdata, vcamposchave, vvalorechave, substring(vmd5 from 1 for 32' +
            '), vacao);'
