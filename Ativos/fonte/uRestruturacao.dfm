            'DIAS_RESERVA, RETIRAR_RESERVAS_VENC, ATIVO, TIPO_RES, ORDEMEXIBI' +
            'CAO, CONFIG_VENDEDOR, CONFIG_CLIENTE, VISUALIZAR_RESERVAS_VENC) ' +
            'VALUES (1, '#39'VEI'#39', '#39'V - VENDA'#39', '#39'V'#39', 1, '#39'S'#39', 1, '#39'V'#39', 99, '#39'V'#39', '#39'M'#39 +
            ', '#39'S'#39');'
          
            'INSERT INTO TIPO_RESERVA (CODIGO, TIPO, DESCRICAO, SIGLA, QUANT_' +
            'DIAS_RESERVA, RETIRAR_RESERVAS_VENC, ATIVO, TIPO_RES, ORDEMEXIBI' +
            'CAO, CONFIG_VENDEDOR, CONFIG_CLIENTE, VISUALIZAR_RESERVAS_VENC) ' +
            'VALUES (2, '#39'VEI'#39', '#39'M - MONTAGEM'#39', '#39'M'#39', 0, '#39'N'#39', 1, '#39'M'#39', 99, '#39'N'#39', ' +
            #39'N'#39', '#39'N'#39');'
          'SET GENERATOR GEN_TIPO_RESERVA TO 2;'
          
            'UPDATE EST_MOTO EST SET EST.DATA_VENC_RES = EST.DATA_RES +  (SEL' +
            'ECT COALESCE(EMP.DIAS_RES_EMP, 0) FROM EMPRESA EMP WHERE EMP.COD' +
            '_EMPRESA = :COD_EMPRESA), EST.HORA_VENC_RES = EST.HORA_RES WHERE' +
