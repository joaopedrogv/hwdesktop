          'inicio'
          'SET TERM ^ ;'
          'CREATE OR ALTER TRIGGER TI_EVD_PAF_REDZ FOR RESUMOD'
          'ACTIVE AFTER INSERT OR UPDATE OR DELETE POSITION 0'
