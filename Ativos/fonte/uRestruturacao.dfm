            'OMOD_POTVEIC_ANT, MODELO_POTVEIC = MODELO_POTVEIC_ANT,'
          
            '              COD_VENDEDORV_ANT = null, DATA_ULT_COMPRAV_ANT = n' +
            'ull,'
          
            '              CODMODELO_POTVEIC_ANT = null, COR_POTVEIC_ANT = nu' +
            'll,'
          
