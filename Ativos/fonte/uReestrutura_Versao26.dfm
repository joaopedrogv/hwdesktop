        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(pcpf_cnpj, '#39#39') <> '#39#39') then'
        '  begin'
        
          '    select sum(coalesce(controle_cheque.valor_ch, 0)) soma from ' +
          'controle_cheque'
        
          '    inner join clientes on clientes.cod_cliente = controle_chequ' +
          'e.cod_cliente and clientes.cod_empresa = controle_cheque.cod_emp' +
          '_mult'
        
          '    inner join empresa on empresa.cod_empresa = controle_cheque ' +
          '.codigo_emp'
        '    inner join controles on'
        '      controles.codigo_ctrl = controle_cheque.codigo_ctrl'
        '      and controles.codigo_emp = controle_cheque.codigo_emp'
        
          '      and trim(coalesce(controles.exibir_doc, '#39'A'#39')) in ('#39#39', '#39'A'#39',' +
          ' '#39'L'#39')'
        '    where clientes.cpfcgc = :pcpf_cnpj'
        
          '    and (controle_cheque.status_ch is null or controle_cheque.st' +
          'atus_ch = '#39#39')'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else controle_cheque.codigo_emp end) = :p' +
          'cod_empresa'
        '      into :valor_chq;'
        '  end'
        '  else'
        '  begin'
        
          '    select sum(coalesce(controle_cheque.valor_ch, 0)) soma from ' +
          'controle_cheque'
        
          '    inner join empresa on empresa.cod_empresa = controle_cheque ' +
          '.codigo_emp'
        '    inner join controles on'
        '      controles.codigo_ctrl = controle_cheque.codigo_ctrl'
        '      and controles.codigo_emp = controle_cheque.codigo_emp'
        
          '      and trim(coalesce(controles.exibir_doc, '#39'A'#39')) in ('#39#39', '#39'A'#39',' +
          ' '#39'L'#39')'
        '    where controle_cheque.cod_cliente = :pcod_cliente'
        
          '    and (controle_cheque.status_ch is null or controle_cheque.st' +
          'atus_ch = '#39#39')'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else controle_cheque.codigo_emp end) = :p' +
          'cod_empresa'
        '      into :valor_chq;'
        '  end'
        ''
        '  valor_chq = coalesce(valor_chq, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VL_RECANT_ABERTO ('
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PCPF_CNPJ varchar(18))'
        'returns ('
        '    VALOR_REC double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(pcpf_cnpj, '#39#39') <> '#39#39') then'
        '  begin'
        '    select sum(coalesce(recibos.valor, 0)) soma from recibos'
        
          '    inner join empresa on empresa.cod_empresa = recibos.cod_empr' +
          'esa'
        '    inner join clientes on'
        '      clientes.cod_cliente = recibos.cod_benef'
        '      and clientes.cod_empresa = recibos.cod_empresa'
        '    where clientes.cpfcgc = :pcpf_cnpj'
        '    and ((recibos.recant = '#39'S'#39') or (recibos.recant = '#39'O'#39'))'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else recibos.cod_empresa end) = :pcod_emp' +
          'resa'
        '    and recibos.ativo = 1'
        
          '    and ((recibos.status_rec is null) or (recibos.status_rec <> ' +
          #39'RECEBIDO'#39'))'
        '      into :valor_rec;'
        '  end'
        '  else'
        '  begin'
        '    select sum(coalesce(recibos.valor, 0)) soma from recibos'
        
          '    inner join empresa on empresa.cod_empresa = recibos.cod_empr' +
          'esa'
        '    inner join clientes on'
        '      clientes.cod_cliente = recibos.cod_benef'
        '      and clientes.cod_empresa = recibos.cod_empresa'
        '    where recibos.cod_benef = :pcod_cliente'
        '    and ((recibos.recant = '#39'S'#39') or (recibos.recant = '#39'O'#39'))'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else recibos.cod_empresa end) = :pcod_emp' +
          'resa'
        '    and recibos.ativo = 1'
        
          '    and ((recibos.status_rec is null) or (recibos.status_rec <> ' +
          #39'RECEBIDO'#39'))'
        '      into :valor_rec;'
        '  end'
        ''
        '  valor_rec = coalesce(valor_rec, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
