          'CREATE INDEX IDX_BAIXA_CREDITOS_CONTR_LNC ON BAIXA_CREDITOS (COD' +
          '_CONTRAPARTIDA, CODIGO_EMP);'
        
          'CREATE INDEX IDX_BAIXA_CREDITOS_CONTR_CTP ON BAIXA_CREDITOS (COD' +
          '_CONTRAPARTIDA_CTP, CODIGO_EMP);'
