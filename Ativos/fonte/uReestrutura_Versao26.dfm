          ') VALUES ('#39'NF0253'#39', :COD_EMPRESA, '#39'SERV TRANSP NOVO AJUSTES'#39', 5,' +
          ' '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0254'#39', :COD_EMPRESA, '#39'SERV TRANSP ALTERAR AJUSTES'#39',' +
          ' 5, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0255'#39', :COD_EMPRESA, '#39'SERV TRANSP SALVAR AJUSTES'#39', ' +
          '5, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
