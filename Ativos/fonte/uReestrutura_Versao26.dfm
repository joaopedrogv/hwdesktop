        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_PAGAMENTOS('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE)'
        'AS'
        '    select l.cod_lanc,'
        '    l.codigo_emp,'
        '    l.cod_emp_mult,'
        '    l.codigo_emp,'
        '    l.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    l.valor_l,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        '    c.nome_ctrl tipo_doc_c,'
        '    l.n_conta_plc,'
        '    l.lote'
        '    from lancamentos l'
        
          '    inner join controles c on c.codigo_ctrl = l.codigo_ctrl and ' +
          'c.codigo_emp = l.codigo_emp and docs = '#39'N'#39
        '    union all'
        '    select cc.codigo_ch,'
        '    cc.codigo_emp,'
        '    cc.cod_emp_mult,'
        '    cc.cod_emp_lote,'
        '    cc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cc.valor_ch,'
        '    cc.nome_ch,'
        '    cc.status_ch,'
        '    cc.data_venc,'
        '    cc.historico_ch,'
        '    cc.n_ch,'
        '    cc.data_rec,'
        '    '#39'CHEQUE'#39' tipo_doc_c,'
        '    cc.n_conta_plc,'
        '    cc.lote'
        '    from controle_cheque cc'
        
          '    inner join controles c on c.codigo_ctrl = cc.codigo_ctrl and' +
          ' c.codigo_emp = cc.codigo_emp'
        '    union all'
        '    select cx.cod_cred,'
        '    cx.codigo_emp,'
        '    cx.cod_emp_mult,'
        '    cx.cod_emp_lote,'
        '    cx.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cx.valor_c,'
        '    cx.nome_c,'
        '    cx.status_c,'
        '    cx.data_venc_c,'
        '    cx.historico_c,'
        '    cx.n_doc_c,'
        '    cx.data_rec_c,'
        '    cx.tipo_doc_c,'
        '    cx.n_conta_plc,'
        '    cx.lote'
        '    from controle_creditos cx'
        
          '    inner join controles c on c.codigo_ctrl = cx.codigo_ctrl and' +
          ' c.codigo_emp = cx.codigo_emp'
        '    union all'
        '    select bc.seq_bxcred,'
        '    bc.codigo_emp,'
        '    bc.cod_emp_mult,'
        '    bc.cod_emp_lote,'
        '    bc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    bc.valor_quitado,'
        '    bc.nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    bc.data_venc_c,'
        '    bc.historico_c,'
        '    bc.n_doc_c,'
        '    bc.data_rec_c,'
        '    bc.tipo_doc_c,'
        '    0,'
        '    bc.lote'
        '    from baixa_creditos bc'
        
          '    inner join controles c on c.codigo_ctrl = bc.codigo_ctrl and' +
          ' c.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '    union all'
        '    select ctp.cod_contrp,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    ctp.cod_emp_mult,'
        '    ctp.codigo_ctrl,'
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        '    coalesce(ctp.valor_ctp, 0),'
        '    ctp.nome_for_ctp,'
        '    '#39'QUITADO'#39' status,'
        '    ctp.data_venc_ctp,'
        '    ctp.historico_ctp,'
        '    ctp.n_doc_ctp,'
        '    ctp.data_ent_ctp,'
        '    '#39'CONTAS A PAGAR'#39' tipo_doc_c,'
        '    0,'
        '    ctp.lote'
        '    from contas_a_pagar ctp;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_PAG_CTP ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PVER_FORMAS integer,'
        '    PFORM_PAG varchar(200) character set WIN1252)'
        'returns ('
        '    ENCONTROU integer,'
        '    FORM_PAG varchar(200) character set WIN1252,'
        '    FORM_PAG2 varchar(200))'
        'as'
        'declare variable VTEMP varchar(200);'
        'declare variable VTEMP2 varchar(200);'
        'declare variable VCONTROLE varchar(35);'
        'declare variable VVALOR double precision;'
        'begin'
        '  /* Procedure Text */'
        '  encontrou = 0;'
        '  form_pag = '#39#39';'
        '  form_pag2 = '#39#39';'
        ''
        '  if (coalesce(pver_formas, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (trim(coalesce(pform_pag, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp2, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39')) ||'
        
          '                '#39' (R$'#39' || trim(cast(cast(vvalor as numeric(12, 2' +
          ')) as varchar(24))) || '#39')'#39';'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = trim(substring(trim(vtemp) from 1 for 200));'
        '    else'
        '      form_pag = trim(vtemp);'
        ''
        '    if (character_length(vtemp2) > 200) then'
        '      form_pag2 = trim(substring(trim(vtemp2) from 1 for 200));'
        '    else'
        '      form_pag2 = trim(vtemp2);'
        '    suspend;'
        '  end'
        '  else'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        '        and det.nome_ctrl like :pform_pag'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp2, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39')) ||'
        
          '                '#39' (R$'#39' || trim(cast(cast(vvalor as numeric(12, 2' +
          ')) as varchar(24))) || '#39')'#39';'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = trim(substring(trim(vtemp) from 1 for 200));'
        '    else'
        '      form_pag = trim(vtemp);'
        ''
        '    if (character_length(vtemp2) > 200) then'
        '      form_pag2 = trim(substring(trim(vtemp2) from 1 for 200));'
        '    else'
        '      form_pag2 = trim(vtemp2);'
        ''
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_PAGAMENTOS('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE)'
        'AS'
        '    select l.cod_lanc,'
        '    l.codigo_emp,'
        '    l.cod_emp_mult,'
        '    l.codigo_emp,'
        '    l.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    l.valor_l,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        '    c.nome_ctrl tipo_doc_c,'
        '    l.n_conta_plc,'
        '    l.lote'
        '    from lancamentos l'
        
          '    inner join controles c on c.codigo_ctrl = l.codigo_ctrl and ' +
          'c.codigo_emp = l.codigo_emp and docs = '#39'N'#39
        '    union all'
        '    select cc.codigo_ch,'
        '    cc.codigo_emp,'
        '    cc.cod_emp_mult,'
        '    cc.cod_emp_lote,'
        '    cc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cc.valor_ch,'
        '    cc.nome_ch,'
        '    cc.status_ch,'
        '    cc.data_venc,'
        '    cc.historico_ch,'
        '    cc.n_ch,'
        '    cc.data_rec,'
        '    '#39'CHEQUE'#39' tipo_doc_c,'
        '    cc.n_conta_plc,'
        '    cc.lote'
        '    from controle_cheque cc'
        
          '    inner join controles c on c.codigo_ctrl = cc.codigo_ctrl and' +
          ' c.codigo_emp = cc.codigo_emp'
        '    union all'
        '    select cx.cod_cred,'
        '    cx.codigo_emp,'
        '    cx.cod_emp_mult,'
        '    cx.cod_emp_lote,'
        '    cx.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cx.valor_c,'
        '    cx.nome_c,'
        '    cx.status_c,'
        '    cx.data_venc_c,'
        '    cx.historico_c,'
        '    cx.n_doc_c,'
        '    cx.data_rec_c,'
        '    cx.tipo_doc_c,'
        '    cx.n_conta_plc,'
        '    cx.lote'
        '    from controle_creditos cx'
        
          '    inner join controles c on c.codigo_ctrl = cx.codigo_ctrl and' +
          ' c.codigo_emp = cx.codigo_emp'
        '    union all'
        '    select bc.seq_bxcred,'
        '    bc.codigo_emp,'
        '    bc.cod_emp_mult,'
        '    bc.cod_emp_lote,'
        '    bc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    bc.valor_quitado,'
        '    bc.nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    bc.data_venc_c,'
        '    bc.historico_c,'
        '    bc.n_doc_c,'
        '    bc.data_rec_c,'
        '    bc.tipo_doc_c,'
        '    0,'
        '    bc.lote'
        '    from baixa_creditos bc'
        
          '    inner join controles c on c.codigo_ctrl = bc.codigo_ctrl and' +
          ' c.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '    union all'
        '    select ctp.cod_contrp,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    ctp.cod_emp_mult,'
        '    ctp.codigo_ctrl,'
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        '    coalesce(ctp.valor_ctp, 0),'
        '    ctp.nome_for_ctp,'
        '    '#39'QUITADO'#39' status,'
        '    ctp.data_venc_ctp,'
        '    ctp.historico_ctp,'
        '    ctp.n_doc_ctp,'
        '    ctp.data_ent_ctp,'
        '    '#39'CONTAS A PAGAR'#39' tipo_doc_c,'
        '    0,'
        '    ctp.lote_ent'
        '    from contas_a_pagar ctp'
        '    union all'
        '    select ctp.cod_contrp,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    ctp.cod_emp_mult,'
        '    ctp.codigo_ctrl,'
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        '    coalesce(ctp.valor_ctp, 0),'
        '    ctp.nome_for_ctp,'
        '    '#39'QUITADO'#39' status,'
        '    ctp.data_venc_ctp,'
        '    ctp.historico_ctp,'
        '    ctp.n_doc_ctp,'
        '    ctp.data_ent_ctp,'
        '    '#39'CONTAS A PAGAR'#39' tipo_doc_c,'
        '    0,'
        '    ctp.lote_quit_parc'
        '    from contas_a_pagar ctp;'
        '|/BLOCO|'
        ''
        'ALTER TABLE SERVICO_TRANSPORTE ADD TP_CT_E SMALLINT;'
        ''
        'ALTER TABLE RECIBOS ADD DATA_VENC TIMESTAMP;'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'RECIBOS'#39' and rdb$field_name ' +
          '= '#39'REFERENCIA1'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'RECIBOS'#39' and rdb$field_name ' +
          '= '#39'REFERENCIA2'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'RECIBOS'#39' and rdb$field_name ' +
          '= '#39'REFERENCIA3'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'RECIBOS'#39' and rdb$field_name ' +
          '= '#39'REFERENCIA4'#39');'
        ''
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD GERAR_NFS CHAR(1) DEFAULT ' +
          #39'S'#39';'
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD GERAR_NF CHAR(1) DEFAULT '#39 +
          'S'#39';'
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD GERAR_REC_LOC CHAR(1) DEFA' +
          'ULT '#39'S'#39';'
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD GERAR_BOLETO CHAR(1) DEFAU' +
          'LT '#39'S'#39';'
        ''
        
          'UPDATE CLIENTES_COM_CONTRATO SET GERAR_NFS = '#39'S'#39' WHERE GERAR_NFS' +
          ' IS NULL;'
        
          'UPDATE CLIENTES_COM_CONTRATO SET GERAR_NF = '#39'S'#39' WHERE GERAR_NF I' +
          'S NULL;'
        
          'UPDATE CLIENTES_COM_CONTRATO SET GERAR_REC_LOC = '#39'S'#39' WHERE GERAR' +
          '_REC_LOC IS NULL;'
        
          'UPDATE CLIENTES_COM_CONTRATO SET GERAR_BOLETO = '#39'S'#39' WHERE GERAR_' +
          'BOLETO IS NULL;'
        ''
        'ALTER TABLE PEDVENDA ADD GERAR_NFS CHAR(1) DEFAULT '#39'S'#39';'
        'ALTER TABLE PEDVENDA ADD GERAR_NF CHAR(1) DEFAULT '#39'S'#39';'
        'ALTER TABLE PEDVENDA ADD GERAR_REC_LOC CHAR(1) DEFAULT '#39'S'#39';'
        'ALTER TABLE PEDVENDA ADD GERAR_BOLETO CHAR(1) DEFAULT '#39'S'#39';'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES_COM_CONTRATO ADD DIA_FATURAMENTO INTEGER;'
        ''
        
          'UPDATE CLIENTES_COM_CONTRATO SET DIA_FATURAMENTO = DIA_VENCIMENT' +
          'O WHERE DIA_FATURAMENTO IS NULL;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI278'#39', :COD_EMPRESA, '#39'IN' +
          'CLUIR ENDERECO ADICIONAL CLIENTE'#39', 3, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39', ' +
          #39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI279'#39', :COD_EMPRESA, '#39'ED' +
          'ITAR ENDERECO ADICIONAL CLIENTE'#39', 3, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39', '#39 +
          'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI280'#39', :COD_EMPRESA, '#39'EX' +
          'CLUIR ENDERECO ADICIONAL CLIENTE'#39', 3, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39', ' +
          #39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI281'#39', :COD_EMPRESA, '#39'SA' +
          'LVAR ENDERECO ADICIONAL CLIENTE'#39', 3, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39', '#39 +
          'S'#39', CURRENT_DATE);'
        ''
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD ASSINATURA_VINDI_ID BIGINT' +
          ';'
        ''
        'ALTER TABLE PEDVENDA ADD FATURA_VINDI_ID BIGINT;'
        ''
        
          'CREATE INDEX IDX_CL_COM_CONT_CLI_ASSINATURA ON CLIENTES_COM_CONT' +
          'RATO (ASSINATURA_VINDI_ID,COD_EMPRESA);'
        ''
        
          'CREATE INDEX IDX_PEDVENDA_FATURAVINI ON PEDVENDA (FATURA_VINDI_I' +
          'D,COD_EMPRESA);'
        ''
        
          'CREATE INDEX IDX_CONCILIACAO_FINANCEIRO_DTPG ON CONCILIACAO_FINA' +
          'NCEIRO (PAYMENT_DATE, COD_EMPRESA, EVENT_TYPE_DESCRIPTION);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONC_FINANC_PIX_STATUS('
        '    ID,'
        '    PIX_ID,'
        '    COD_EMPRESA)'
        'AS'
        
          'select max (cf.id), cf.pix_id, cf.cod_empresa from conciliacao_f' +
          'inanceiro cf'
        'where trim(cf.event_type_description) = '#39'Venda'#39
        'and cf.pix_id is not null'
        'and (select count(*) from conciliacao_adquirente adq'
        '     left join conciliacao_band_adq band_adq on'
        '        band_adq.codigo = cf.bandeira_cod'
        '        and band_adq.id_adquirente = adq.id'
        '     left join conciliacao_status_transf_adq st_transf_adq on'
        '        st_transf_adq.codigo = cf.status_transf_cod'
        '        and st_transf_adq.id_adquirente = adq.id'
        '     left join conciliacao_status_transf st_transf on'
        '        st_transf.id = st_transf_adq.id_status_transf'
        '     where adq.id = cf.acquirer_id'
        '     and st_transf_adq.status = '#39'P'#39') <> 0'
        'group by 2, 3;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONC_FINANC_STATUS('
        '    ID,'
        '    NSU,'
        '    AUTHORIZATION_NUMBER,'
        '    COD_TRANS_REC,'
        '    CHAVE_UR,'
        '    INSTALLMENT_NUMBER,'
        '    INSTALLMENTS_TOTAL,'
        '    COD_EMPRESA)'
        'AS'
        
          'select max (cf.id) id, max(cf.nsu) nsu, max(cf.authorization_num' +
          'ber) authorization_number,'
        
          'cf.cod_trans_rec, cf.chave_ur, cf.installment_number, cf.install' +
          'ments_total, cf.cod_empresa from conciliacao_financeiro cf'
        
          'where ((trim(cf.event_type_description) in ('#39'Venda'#39', '#39'Ajuste'#39')) ' +
          'or (trim(cf.event_type_description) like '#39'Antecipa%'#39'))'
        'and cf.pix_id is null'
        'and (select count(*) from conciliacao_adquirente adq'
        '     left join conciliacao_band_adq band_adq on'
        '        band_adq.codigo = cf.bandeira_cod'
        '        and band_adq.id_adquirente = adq.id'
        '     left join conciliacao_status_pag_adq stpag_adq on'
        '        stpag_adq.codigo = cf.status_pag_cod'
        '        and stpag_adq.id_adquirente = adq.id'
        '     left join conciliacao_status_pag stpag on'
        '        stpag.id = stpag_adq.id_status_pag'
        '     where adq.id = cf.acquirer_id'
        '     and stpag_adq.status in ('#39'E'#39', '#39'P'#39')) <> 0'
        'group by 4, 5, 6, 7, 8;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONCILIACAO_ADM('
        '    DATA,'
        '    DATE_,'
        '    REQUEST_DATE,'
        '    EFFECTED_DATE,'
        '    PAYMENT_DATE,'
        '    BANK_SHIPPING_DATE,'
        '    ID,'
        '    COD_EMPRESA,'
        '    ARQUIVO,'
        '    DATA_ARQUIVO,'
        '    ESTABLISHMENT_NUMBER,'
        '    NSU,'
        '    AUTHORIZATION_NUMBER,'
        '    TYPE_,'
        '    TYPE_DESCRIPTION,'
        '    ACQUIRER_ID,'
        '    ACQUIRER_NAME,'
        '    BRAND_ID,'
        '    BRAND_NAME,'
        '    EVENT_TYPE,'
        '    EVENT_TYPE_DESCRIPTION,'
        '    DESCRIPTION,'
        '    BANK_RECON_STATUS,'
        '    BANK_RECON_DESCRIPTION,'
        '    GROSS_AMOUNT,'
        '    EVENT_NET_AMOUNT,'
        '    BATCH_NET_AMOUNT,'
        '    GROSS_EVENT_AMOUNT,'
        '    BATCH_GROSS_AMOUNT,'
        '    TAX,'
        '    SALE_TAX,'
        '    CUSTOMER_TAX,'
        '    INSTALLMENT_NUMBER,'
        '    INSTALLMENTS_TOTAL,'
        '    BANK_NUMBER,'
        '    BANK_NAME,'
        '    BRANCH_NUMBER,'
        '    ACCOUNT_NUMBER,'
        '    IDENTIFICACAO_EMP,'
        '    PIX_ID,'
        '    FORM_PAG_COD,'
        '    FORM_PAG,'
        '    COD_AJUSTE_COD,'
        '    COD_AJUSTE,'
        '    BANDEIRA_COD,'
        '    BANDEIRA,'
        '    STATUS_PAG_COD,'
        '    STATUS_PAG,'
        '    STATUS_PAG_ST,'
        '    TIPO_LANCAMENTO_COD,'
        '    TIPO_LANCAMENTO,'
        '    TIPO_LIQUIDACAO_COD,'
        '    TIPO_LIQUIDACAO,'
        '    TIPO_ANTECIPACAO_COD,'
        '    TIPO_ANTECIPACAO,'
        '    TIPO_CARTAO_COD,'
        '    TIPO_CARTAO,'
        '    MOTIVO_REJ_COD,'
        '    MOTIVO_REJ,'
        '    GRUPO_CARTAO_COD,'
        '    GRUPO_CARTAO,'
        '    TIPO_TRANSACAO_COD,'
        '    TIPO_TRANSACAO,'
        '    STATUS_TRANSF_COD,'
        '    STATUS_TRANSF,'
        '    STATUS_TRANSF_ST,'
        '    ORIGEM_AJUSTE_COD,'
        '    ORIGEM_AJUSTE)'
        'AS'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number,'
        'cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description, '
        'cf.acquirer_id, cf.acquirer_name, '
        'cf.brand_id, cf.brand_name, '
        'cf.event_type, cf.event_type_description, '
        'cf.description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax, '
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r, '
        'emp.identificacao_emp, '
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        
          'where ((trim(cf.event_type_description) = '#39'Venda'#39') or (trim(cf.e' +
          'vent_type_description) like '#39'Antecipa%'#39'))'
        'and cf.pix_id is null'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number,'
        'cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description, '
        'cf.acquirer_id, cf.acquirer_name, '
        'cf.brand_id, cf.brand_name, '
        'cf.event_type, cf.event_type_description, '
        'cf.description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax, '
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp, '
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_pix_status vwfp'
        'inner join conciliacao_financeiro cf on'
        '    vwfp.pix_id = cf.pix_id'
        '    and vwfp.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
