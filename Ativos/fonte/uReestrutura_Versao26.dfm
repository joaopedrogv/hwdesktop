        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_BOLETAS_ENV_EMAIL_WHAT FOR BOLETAS'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (inserting) then'
        '  begin'
        '    if (trim(coalesce(new.env_whatsapp_bol, '#39#39')) = '#39'S'#39') then'
        '    begin'
        '      INSERT INTO ENV_DOC'
        '      (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO)'
        
          '      VALUES ('#39'BOL_'#39' || new.n_seq_bol, new.cod_empresa, '#39'W'#39', new' +
          '.data_whatsapp_bol, new.cod_us_whatsapp_bol);'
        ''
        '      new.env_whatsapp_bol    = null;'
        '      new.data_whatsapp_bol   = null;'
        '      new.cod_us_whatsapp_bol = null;'
        '    end'
        ''
        '    if (trim(coalesce(new.env_email_bol, '#39#39')) = '#39'S'#39') then'
        '    begin'
        '      INSERT INTO ENV_DOC'
        '      (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO)'
        
          '      VALUES ('#39'BOL_'#39' || new.n_seq_bol, new.cod_empresa, '#39'E'#39', new' +
          '.data_email_bol, new.cod_us_email_bol);'
        ''
        '      new.env_email_bol       = null;'
        '      new.data_email_bol      = null;'
        '      new.cod_us_email_bol    = null;'
        '    end'
        '  end'
        '  else if (updating) then'
        '  begin'
        
          '    if ((trim(coalesce(old.env_whatsapp_bol, '#39#39')) <> trim(coales' +
          'ce(new.env_whatsapp_bol, '#39#39')))'
        
          '        and (trim(coalesce(new.env_whatsapp_bol, '#39#39')) = '#39'S'#39')) th' +
          'en'
        '    begin'
        '      INSERT INTO ENV_DOC'
        '      (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO)'
        
          '      VALUES ('#39'BOL_'#39' || new.n_seq_bol, new.cod_empresa, '#39'W'#39', new' +
          '.data_whatsapp_bol, new.cod_us_whatsapp_bol);'
        ''
        '      new.env_whatsapp_bol    = null;'
        '      new.data_whatsapp_bol   = null;'
        '      new.cod_us_whatsapp_bol = null;'
        '    end'
        
          '    else if ((trim(coalesce(old.env_whatsapp_bol, '#39#39')) <> trim(c' +
          'oalesce(new.env_whatsapp_bol, '#39#39')))'
        
          '        and  (  (trim(coalesce(new.env_whatsapp_bol, '#39'N'#39')) = '#39'N'#39 +
          ') )  ) then'
        '    begin'
        '      DELETE FROM ENV_DOC'
        '      WHERE NUM_DOC = '#39'BOL_'#39' || new.n_seq_bol'
        '      AND COD_EMPRESA = new.cod_empresa'
        '      AND TIPO_ENV = '#39'W'#39';'
        ''
        '      new.env_whatsapp_bol    = null;'
        '      new.data_whatsapp_bol   = null;'
        '      new.cod_us_whatsapp_bol = null;'
        '    end'
        ''
        
          '    if ((trim(coalesce(old.env_email_bol, '#39#39')) <> trim(coalesce(' +
          'new.env_email_bol, '#39#39')))'
        '        and (trim(coalesce(new.env_email_bol, '#39#39')) = '#39'S'#39')) then'
        '    begin'
        '      INSERT INTO ENV_DOC'
        '      (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO)'
        
          '      VALUES ('#39'BOL_'#39' || new.n_seq_bol, new.cod_empresa, '#39'E'#39', new' +
          '.data_email_bol, new.cod_us_email_bol);'
        ''
        '      new.env_email_bol       = null;'
        '      new.data_email_bol      = null;'
        '      new.cod_us_email_bol    = null;'
        '    end'
        
          '    else if ((trim(coalesce(old.env_email_bol, '#39#39')) <> trim(coal' +
          'esce(new.env_email_bol, '#39#39')))'
        
          '        and  (  (trim(coalesce(new.env_email_bol, '#39'N'#39')) = '#39'N'#39') )' +
          '   )  then'
        '    begin'
        '      DELETE FROM ENV_DOC'
        '      WHERE NUM_DOC = '#39'BOL_'#39' || new.n_seq_bol'
        '      AND COD_EMPRESA = new.cod_empresa'
        '      AND TIPO_ENV = '#39'E'#39';'
        ''
        '      new.env_email_bol       = null;'
        '      new.data_email_bol      = null;'
        '      new.cod_us_email_bol    = null;'
        '    end'
