          'E DADOS VIA ARQUIVO'#39', 100, '#39'S'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_COND ('
        '    PNDOC integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer,'
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer)'
        'returns ('
        '    RESULT double precision)'
        'as'
        'declare variable VTEMP varchar(50);'
        'begin'
        '  /* Procedure Text */'
        '  result = 0;'
        '  vtemp = '#39#39';'
        '  if (pcod_grade > 0) then'
        '    vtemp = '#39' and c.cod_grade = '#39' || :pcod_grade;'
        ''
        '  execute statement'
        
          '  '#39' select sum(coalesce(c.quantidade, 0)) quantidade from pedven' +
          'da_prod_cond_dev c'
        '    where c.nped = '#39' || :pndoc || '#39
        '    and c.tipo = '#39#39#39' || :ptipo || '#39#39#39
        '    and c.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and c.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '    and c.cod_empresa = '#39' || :pcod_empresa ||'
        '    vtemp'
        '      into :result;'
        ''
        '  result = coalesce(result, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_COND_VND ('
        '    PNDOC integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer,'
        '    PVALOR_TOT double precision)'
        'returns ('
        '    VALOR_TOTAL_COND double precision,'
        '    VALOR_TOTAL_DEV_COND double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  valor_total_cond     = 0;'
        '  valor_total_dev_cond = 0;'
        ''
        '  execute statement'
        '  '#39' select sum('
        '        coalesce(c.quantidade, 0) *'
        
          '        coalesce((select first 1 coalesce(pp.vlun_ped_item, 0) f' +
          'rom pedvenda_prod pp'
        '        where pp.nped = c.nped'
        '        and pp.tipo = c.tipo'
        '        and pp.grupo_prod = c.grupo_prod'
        '        and pp.cod_prod = c.cod_prod'
        '        and pp.cod_empresa = c.cod_empresa'
        '        and (pp.status<>'#39#39'CANCELADO'#39#39' or pp.status is null)), 0)'
        '    ) quantidade from pedvenda_prod_cond_dev c'
        '    where c.nped = '#39' || :pndoc || '#39
        '    and c.tipo = '#39#39#39' || :ptipo || '#39#39#39
        '    and c.cod_empresa = '#39' || :pcod_empresa'
        '      into :valor_total_dev_cond;'
        ''
        
          '  valor_total_cond     = coalesce(pvalor_tot, 0) + coalesce(valo' +
          'r_total_dev_cond, 0);'
        '  valor_total_dev_cond = coalesce(valor_total_dev_cond, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'PERFIL_PRODUTOS'#39' and rdb$fie' +
          'ld_name = '#39'DESCR_PROD'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'PERFIL_PRODUTOS'#39' and rdb$fie' +
          'ld_name = '#39'DESCR_PERFIL'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'TERMINALF'#39' and rdb$field_nam' +
          'e = '#39'NOME_TERMINAL'#39');'
