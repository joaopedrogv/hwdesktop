        'create or alter procedure GETCREDIARIO ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PFINANCEIRO_UNIFICADO char(1),'
        '    PDIAS_CARENCIA_JUROS integer)'
        'returns ('
