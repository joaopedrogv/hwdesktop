          'CREATE OR ALTER TRIGGER TI_CL_COM_CONTR_SERV_VLCTR FOR CLIENTES_' +
          'COM_CONTRATO_SERV'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VDESCR_SERV VARCHAR(75);'
        '  DECLARE VARIABLE VDESCR_CONTRATO VARCHAR(75);'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  update clientes_com_contrato set ind_inclalt = ind_inclalt'
        '  where cod_contrato = new.cod_contrato'
        '  and cod_empresa = new.cod_empresa;'
        ''
        
          '  select coalesce(clientes_com_contrato.descr_contrato, '#39#39') from' +
          ' clientes_com_contrato'
        '  where clientes_com_contrato.cod_contrato = new.cod_contrato'
        '  and clientes_com_contrato.cod_empresa = new.cod_empresa'
        '    into :vdescr_contrato;'
        ''
        '  if (trim(coalesce(vdescr_contrato, '#39#39')) = '#39#39') then'
        '  begin'
        '    select tipo_servico.desc_servico from tipo_servico'
        '    where tipo_servico.cod_servico = new.cod_servico'
        #9'  into :vdescr_serv;'
        ''
        '    if (trim(coalesce(vdescr_serv, '#39#39')) <> '#39#39') then'
        '    begin'
        
          #9'  update clientes_com_contrato set descr_contrato = trim(coales' +
          'ce(:vdescr_serv, '#39#39'))'
        #9'  where cod_contrato = new.cod_contrato'
        #9'  and cod_empresa = new.cod_empresa;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_CL_COM_CONTR_SERV_VLCTR_DEL FOR CLIEN' +
          'TES_COM_CONTRATO_SERV'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  update clientes_com_contrato set ind_inclalt = ind_inclalt'
        '  where cod_contrato = old.cod_contrato'
        '  and cod_empresa = old.cod_empresa;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_CL_COM_CONTR_PROD_VLCTR FOR CLIENTES_' +
          'COM_CONTRATO_PROD'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  update clientes_com_contrato set ind_inclalt = ind_inclalt'
        '  where cod_contrato = new.cod_contrato'
        '  and cod_empresa = new.cod_empresa;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_CL_COM_CONTR_PROD_VLCTR_DEL FOR CLIEN' +
          'TES_COM_CONTRATO_PROD'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  update clientes_com_contrato set ind_inclalt = ind_inclalt'
        '  where cod_contrato = old.cod_contrato'
        '  and cod_empresa = old.cod_empresa;'
