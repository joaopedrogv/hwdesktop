        'ALTER TABLE PRODUTOS_EC ADD ID INTEGER;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER trigger tr_produtos_ec_id for produtos_ec'
        'active before insert or update position 0'
        'AS'
        '  declare variable vcod integer;'
        'begin'
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.id, 0) = 0) then'
        '    begin'
        
          '      select cod from incrementa_codigo (new.cod_empresa, '#39'PRODU' +
          'TOS_EC'#39') into :vcod;'
        '      new.id = :vcod;'
        '    end'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    if (coalesce(new.id, 0) = 0) then'
        '    begin'
        
          '      select cod from incrementa_codigo (new.cod_empresa, '#39'PRODU' +
          'TOS_EC'#39') into :vcod;'
        '      new.id = :vcod;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE KITS_PROD_EC ADD ID INTEGER;'
        ''
