        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_CONTAS_A_PAGAR_FORNECEDOR FOR CONTAS_' +
          'A_PAGAR'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  declare variable vnome_cliente varchar(35);'
        '  declare variable vcpfcgc varchar(18);'
        'begin'
        '  /* Trigger text */'
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '     exit;'
        ''
        '  if (coalesce(new.cod_forn_nfe, 0) > 0) then'
        
          '    if ((trim(coalesce(new.nome_for_ctp, '#39#39')) = '#39#39') or (trim(coa' +
          'lesce(new.cpf_cgc_f, '#39#39')) = '#39#39')) then'
        '    begin'
        '      if (coalesce(new.cod_emp_mult, 0) > 0) then'
        '      begin'
        '        select nome_cliente, cpfcgc from clientes'
        '        where cod_cliente = new.cod_forn_nfe'
        '        and cod_empresa = new.cod_emp_mult'
        '          into :vnome_cliente, :vcpfcgc;'
        '      end'
        '      else'
        '      begin'
        '        select nome_cliente, cpfcgc from clientes'
        '        where cod_cliente = new.cod_forn_nfe'
        '        and cod_empresa = new.codigo_emp'
        '          into :vnome_cliente, :vcpfcgc;'
        '      end'
        ''
        '      if (trim(coalesce(new.nome_for_ctp, '#39#39')) = '#39#39') then'
        '        new.nome_for_ctp = trim(coalesce(vnome_cliente, '#39#39'));'
        ''
        '      if (trim(coalesce(new.cpf_cgc_f, '#39#39')) = '#39#39') then'
        '        new.cpf_cgc_f = trim(coalesce(vcpfcgc, '#39#39'));'
        '    end'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND270'#39', :COD_EMPRESA, '#39'AB' +
          'RIR TELA MONTAR PEDIDOS PRODUTOS EM ESTOQUE'#39', 10, '#39'FRMMONTARPEDI' +
          'DOS'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND271'#39', :COD_EMPRESA, '#39'BT' +
          ' MONTAR PEDIDOS PRODUTOS EM ESTOQUE'#39', 10, '#39'FRMMONTARPEDIDOS'#39', 1,' +
          ' '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_PEDVENDA_PROD_UNQ_CONV FOR PEDVENDA_P' +
          'ROD'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VUNIDADE VARCHAR(6);'
        'begin'
        '  /* Trigger text */'
        
          '  if ((trim(coalesce(new.unidade, '#39#39')) = '#39#39') or (trim(coalesce(n' +
          'ew.unidade_conv, '#39#39')) = '#39#39')) then'
        '  begin'
        '    select unidade from produtos'
        '    where grupo_prod = new.grupo_prod'
        '    and cod_prod = new.cod_prod'
        '    and cod_empresa = new.cod_empresa'
        '      into :vunidade;'
        ''
        '    if (trim(coalesce(new.unidade, '#39#39')) = '#39#39') then'
        '      if (trim(coalesce(vunidade, '#39#39')) <> '#39#39') then'
        '        new.unidade = upper(trim(vunidade));'
        ''
        '    if (trim(coalesce(new.unidade_conv, '#39#39')) = '#39#39') then'
        '      if (trim(coalesce(vunidade, '#39#39')) <> '#39#39') then'
        '        new.unidade_conv = upper(trim(vunidade));'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
