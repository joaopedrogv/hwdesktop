          'RM ALT VALOR DOS PRODUTOS COM PRECO PROMOCAO'#39', 11, '#39'FRMCADPEDVEN' +
          'DA'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
