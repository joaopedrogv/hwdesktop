        '|BLOCO|'
        'CREATE TABLE PEDIDOCOMPRACL ('
        '    CODIGO       INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    NUM_PEDIDO   VARCHAR(15),'
        '    COD_CLIENTE  INTEGER,'
        '    DATA_PEDIDO  TIMESTAMP,'
        '    COD_USUARIO  INTEGER,'
        '    ATIVO        INTEGER default 1'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PEDIDOCOMPRACL ADD CONSTRAINT PK_PEDIDOCOMPRACL PRIM' +
          'ARY KEY (CODIGO, COD_EMPRESA);'
        
          'ALTER TABLE PEDIDOCOMPRACL ADD CONSTRAINT FK_PEDIDOCOMPRACL_CLIE' +
          'NTE FOREIGN KEY (COD_CLIENTE, COD_EMPRESA) REFERENCES CLIENTES (' +
          'COD_CLIENTE, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        'CREATE TABLE PEDIDOCOMPRACL_ITENS ('
        '    CODIGO       INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    NITEM        INTEGER NOT NULL,'
        '    GRUPO_PROD   INTEGER NOT NULL,'
        '    COD_PROD     CHAR(6) NOT NULL,'
        '    COD_GRADE    INTEGER NOT NULL,'
        
          '    QUANT        T_D_QUANT NOT NULL /* T_D_QUANT = DOUBLE PRECIS' +
          'ION DEFAULT 00000.00 */,'
        
          '    VALOR        T_VL_TODOS NOT NULL /* T_VL_TODOS = DOUBLE PREC' +
          'ISION DEFAULT 000000000.00 */,'
        '    NITEM_NFE    INTEGER NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS ADD CONSTRAINT PK_PEDIDOCOMPRAC' +
          'L_ITENS PRIMARY KEY (CODIGO, COD_EMPRESA, NITEM);'
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS ADD CONSTRAINT FK_PEDIDOCOMPRAC' +
          'L_ITENS_PROD FOREIGN KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA) REF' +
          'ERENCES PRODUTOS (GRUPO_PROD, COD_PROD, COD_EMPRESA) ON DELETE C' +
          'ASCADE ON UPDATE CASCADE;'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET SENHA_GERENTE = '#39'S'#39' WHERE C' +
          'OD_PROCESSO IN ('#39'CFG058'#39', '#39'CFG059'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND284'#39', :COD_EMPRESA, '#39'PE' +
          'RM SALVAR VENDA VAN OUTRA ABERTO MESMO VENDEDOR'#39', 10, '#39'S'#39', '#39'FRMC' +
          'ADPEDVENDA'#39', 1, '#39'S'#39', CURRENT_DATE);'
        ''
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS ADD CONSTRAINT FK_PEDIDOCOMPRAC' +
          'L_ITENS FOREIGN KEY (CODIGO, COD_EMPRESA) REFERENCES PEDIDOCOMPR' +
          'ACL (CODIGO, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS ADD ENVIADO CHAR(1) DEFAULT '#39'N'#39 +
          ';'
        ''
        '|BLOCO|'
        'CREATE TABLE PEDIDOCOMPRACL_ITENS_ENV ('
        '    CODIGO       INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    NITEM        INTEGER NOT NULL,'
        '    COD_NF       INTEGER NOT NULL,'
        '    NITEM_NF     INTEGER NOT NULL,'
        
          '    QTDE_ENV     T_D_QUANT NOT NULL /* T_D_QUANT = DOUBLE PRECIS' +
          'ION DEFAULT 00000.00 */'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS_ENV ADD CONSTRAINT PK_PEDIDOCOM' +
          'PRACL_ITENS_ENV PRIMARY KEY (CODIGO, COD_EMPRESA, NITEM, COD_NF,' +
          ' NITEM_NF);'
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS_ENV ADD CONSTRAINT FK_PEDCOMPRA' +
          'CL_ITENS_ENV_NFIT FOREIGN KEY (COD_NF, COD_EMPRESA, NITEM_NF) RE' +
          'FERENCES NOTAFISCAL_ITEM (COD_NF, COD_EMPRESA, NITEM) ON DELETE ' +
          'CASCADE ON UPDATE CASCADE;'
        
          'ALTER TABLE PEDIDOCOMPRACL_ITENS_ENV ADD CONSTRAINT FK_PEDIDOCOM' +
          'PRACL_ITENS_ENV FOREIGN KEY (CODIGO, COD_EMPRESA, NITEM) REFEREN' +
          'CES PEDIDOCOMPRACL_ITENS (CODIGO, COD_EMPRESA, NITEM) ON DELETE ' +
          'CASCADE ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER PEDIDOCOMPRACL_ITENS_ENV_BID0 FOR PEDIDO' +
          'COMPRACL_ITENS_ENV'
        'ACTIVE AFTER INSERT OR UPDATE OR DELETE POSITION 0'
        'AS'
        '  declare variable qtdeped t_vl_todos;'
        '  declare variable qtdeenv t_vl_todos;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  qtdeped = null;'
        '  qtdeenv = null;'
        ''
        
          '  -- caso a subtracao da quantidade com a soma dos enviados seja' +
          ' maior que zero'
        '  if (deleting) then'
        '    for select pit.quant, sum(coalesce(env.qtde_env,0))'
        '      from pedidocompracl_itens pit'
        
          '      left join pedidocompracl_itens_env env on env.codigo = pit' +
          '.codigo and env.cod_empresa = pit.cod_empresa and env.nitem = pi' +
          't.nitem'
        
          '        and env.cod_nf <> old.cod_nf and env.nitem_nf <> old.nit' +
          'em_nf'
        
          '      where pit.codigo = old.codigo and pit.cod_empresa = old.co' +
          'd_empresa and pit.nitem = old.nitem'
        '      group by quant'
        '        into :qtdeped, :qtdeenv'
        '    do'
        '    begin'
        '      if (qtdeped > qtdeenv) then'
        '        update pedidocompracl_itens pit set pit.enviado = '#39'N'#39
        
          '          where pit.codigo = old.codigo and pit.cod_empresa = ol' +
          'd.cod_empresa and pit.nitem = old.nitem and coalesce(pit.enviado' +
          ', '#39#39') <> '#39'N'#39';'
        '    end'
        ''
        '  if (not deleting) then'
        '    for select pit.quant, sum(coalesce(env.qtde_env,0))'
        '      from pedidocompracl_itens pit'
        
          '      inner join pedidocompracl_itens_env env on env.codigo = pi' +
          't.codigo and env.cod_empresa = pit.cod_empresa and env.nitem = p' +
          'it.nitem'
        
          '      where pit.codigo = new.codigo and pit.cod_empresa = new.co' +
          'd_empresa and pit.nitem = new.nitem'
        '      group by quant'
        '        into :qtdeped, :qtdeenv'
        '    do'
        '    begin'
        
          '      update pedidocompracl_itens pit set pit.enviado = iif((:qt' +
          'deenv - :qtdeped) > -0.001, '#39'S'#39', '#39'N'#39')'
        
          '        where pit.codigo = new.codigo and pit.cod_empresa = new.' +
          'cod_empresa and pit.nitem = new.nitem and coalesce(pit.enviado, ' +
          #39#39') <> iif((:qtdeenv - :qtdeped) > -0.001, '#39'S'#39', '#39'N'#39');'
        '    end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER NOTAFISCAL_ITEM_BU_PEDCL FOR NOTAFISCAL_' +
          'ITEM'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        
          '  if (new.tipo_item <> '#39'P'#39' or coalesce(Trim(new.cod_prod),  '#39#39') ' +
          '= '#39#39' or new.grupo_prod is null) then'
        '    exit;'
        ''
        '  -- qualquer alteracao na referencia do pedido vamos excluir'
        ''
        '  -- aqui quando deixa algum campo vazio'
        '  if ( updating and'
        
          '    (coalesce(trim(old.xped_compra), '#39#39') <> '#39#39' and old.nitemped_' +
          'compra > 0) and'
        
          '    (coalesce(trim(new.xped_compra), '#39#39') = '#39#39' or new.nitemped_co' +
          'mpra = 0)'
        '  ) then'
        '    delete from pedidocompracl_itens_env'
        
          '      where cod_nf = old.cod_nf and cod_empresa = old.cod_empres' +
          'a and nitem_nf = old.nitem;'
        ''
        '  -- aqui quando muda o numero do pedido ou numero do item'
        '  else if ( deleting or ( updating and'
        
          '    (coalesce(trim(old.xped_compra), '#39#39') <> '#39#39' and old.nitemped_' +
          'compra > 0) and'
        
          '    (old.xped_compra <> new.xped_compra or old.nitemped_compra <' +
          '> new.nitemped_compra))'
        '  ) then'
        '  begin'
        '    delete from pedidocompracl_itens_env'
        
          '      where cod_nf = old.cod_nf and cod_empresa = old.cod_empres' +
          'a and nitem_nf = old.nitem;'
        ''
        '    if (updating) then'
        '      delete from pedidocompracl_itens_env'
        
          '        where cod_nf = new.cod_nf and cod_empresa = new.cod_empr' +
          'esa and nitem_nf = new.nitem;'
        '  end'
        '  '
        '  -- aqui altera apenas a quantidade'
        '  else if ( updating and'
        
          '    (coalesce(old.xped_compra, '#39#39') = new.xped_compra and coalesc' +
          'e(old.nitemped_compra, 0) = new.nitemped_compra and coalesce(old' +
          '.quantidade, 0) <> new.quantidade)'
        '  ) then'
        '  begin'
        
          '    update pedidocompracl_itens_env set qtde_env = new.quantidad' +
          'e'
        
          '        where cod_nf = new.cod_nf and cod_empresa = new.cod_empr' +
          'esa and nitem_nf = new.nitem;'
        '  end'
        ''
        '  -- registro no historico de envios'
        '  if ( inserting or ( updating and'
        
          '    (coalesce(trim(new.xped_compra), '#39#39') <> '#39#39' and new.nitemped_' +
          'compra > 0) and'
        
          '    (coalesce(old.xped_compra,'#39#39') <> new.xped_compra or coalesce' +
          '(old.nitemped_compra, 0) <> new.nitemped_compra))'
        '  ) then'
        '  begin'
        '    merge into pedidocompracl_itens_env env'
        '    using ('
        
          '      select pit.codigo, pit.nitem, pit.quant, sum(coalesce(env.' +
          'qtde_env,0)) qtde_env,'
        
          '             sum(iif((env.nitem_nf = new.nitem) and (env.cod_nf ' +
          '= new.cod_nf), 1, 0)) nitemexiste'
        '      from pedidocompracl_itens pit'
        
          '        inner join notafiscal nf on nf.cod_nf = new.cod_nf and n' +
          'f.cod_empresa = new.cod_empresa'
        
          '        inner join pedidocompracl pd on pd.codigo = pit.codigo a' +
          'nd pd.cod_empresa = pit.cod_empresa and pd.cod_cliente = nf.cod_' +
          'cliente'
        
          '        left join pedidocompracl_itens_env env on env.codigo = p' +
          'it.codigo and env.cod_empresa = pit.cod_empresa'
        '          and env.nitem = pit.nitem'
        
          '      where pit.grupo_prod = new.grupo_prod and pit.cod_prod = n' +
          'ew.cod_prod and pit.cod_empresa = new.cod_empresa'
        
          '        and pit.cod_grade = coalesce(new.cod_grade, 0) and pit.n' +
          'item_nfe = new.nitemped_compra'
        '        and coalesce(pit.enviado,'#39#39') <> '#39'S'#39
        '      group by codigo, nitem, quant'
        '      having sum(coalesce(env.qtde_env,0)) < pit.quant'
        '    ) pit'
        '    on (pit.qtde_env > 0 and pit.nitemexiste > 0)'
        '    when not matched then'
        
          '      insert (codigo, cod_empresa, nitem, cod_nf, nitem_nf, qtde' +
          '_env)'
        
          '      values (pit.codigo, new.cod_empresa, pit.nitem, new.cod_nf' +
          ', new.nitem, new.quantidade);'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 50, RDB$CHARACTER_LENGT' +
          'H = 50 where RDB$FIELD_NAME = (select rdb$field_source from rdb$' +
          'relation_fields where rdb$relation_name = '#39'TITULOS_NAO_CONCILIAD' +
          'OS'#39' and rdb$field_name = '#39'TITULOIDENTIFICACAOEMPRESA'#39');'
        ''
        
          'update empresa set email_senha = '#39'prjp gczs xwve bneg'#39' where ema' +
          'il_senha = '#39'ttadmin'#39' and lower(login_emp) = '#39'nfe@hwsistemas.com.' +
          'br'#39' and lower(smtp_emp) = '#39'smtp.gmail.com'#39';'
        
          'update nfce_config set email_password = '#39'prjp gczs xwve bneg'#39' wh' +
          'ere email_password = '#39'ttadmin'#39' and lower(email_username) = '#39'nfe@' +
          'hwsistemas.com.br'#39' and lower(email_smpt_host) = '#39'smtp.gmail.com'#39 +
          ';'
        ''
        ''
        '|BLOCO|'
        'create or alter procedure SP_NFCE_TOT ('
        '    PCOD_NFCE integer,'
        '    PCOD_EMRESA integer)'
        'returns ('
        '    VALOR_TOTAL double precision,'
        '    VALOR_PROD double precision,'
        '    VALOR_SERV double precision,'
        '    BASE_ICM double precision,'
        '    VALOR_ICM double precision,'
        '    BASE_ICMSUB double precision,'
        '    VALOR_ICMSUB double precision,'
        '    BASE_ISS double precision,'
        '    VALOR_ISS double precision,'
        '    VALOR_DESC double precision,'
        '    VALOR_DESC_P double precision,'
        '    VALOR_DESC_S double precision,'
        '    CODIGO_NOP integer,'
        '    DESCRICAO_NOP varchar(60))'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select'
        '  sum(coalesce(nfci.vprod, 0)) valor_total,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then 0 else coalesce(nfci' +
          '.vprod, 0) end) valor_prod,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then coalesce(nfci.vprod,' +
          ' 0) else 0 end) valor_serv,'
        '  sum(coalesce(nfci.icm_vbc, 0)) base_icm,'
        '  sum(coalesce(nfci.icm_vicms, 0)) valor_icm,'
        '  0 base_icmsub,'
        '  0 valor_icmsub,'
        '  sum(coalesce(nfci.iss_vbc, 0)) base_iss,'
        '  sum(coalesce(nfci.iss_vissqn, 0)) valor_iss,'
        '  sum(coalesce(nfci.vdesc, 0)) valor_desc,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then 0 else coalesce(nfci' +
          '.vdesc, 0) end) valor_desc_p,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then coalesce(nfci.vdesc,' +
          ' 0) else 0 end) valor_desc_s from nfce nfc'
        
          '  inner join nfce_item nfci on nfci.cod_nfce = nfc.cod_nfce and ' +
          'nfci.cod_empresa = nfc.cod_empresa'
        '  where nfc.cod_nfce = :pcod_nfce'
        '  and nfc.cod_empresa = :pcod_emresa'
        '    into :valor_total, :valor_prod, :valor_serv,'
        
          '         :base_icm, :valor_icm, :base_icmsub, :valor_icmsub, :ba' +
          'se_iss, :valor_iss,'
        '         :valor_desc, :valor_desc_p, :valor_desc_s;'
        ''
        
          '  select first 1 nfci.cfop, substring(nt.descricao_nop from 1 fo' +
          'r 60) descricao_nop from nfce_item nfci'
        '  inner join nat_op nt on nfci.cfop = nt.codigo_nop'
        '  where nfci.cod_nfce = :pcod_nfce'
        '  and nfci.cod_empresa = :pcod_emresa'
        '  order by nfci.nitem'
        '    into :codigo_nop, :descricao_nop;'
        ''
        '  valor_total = coalesce(valor_total, 0);'
        '  valor_prod = coalesce(valor_prod, 0);'
        '  valor_serv = coalesce(valor_serv, 0);'
        '  base_icm = coalesce(base_icm, 0);'
        '  valor_icm = coalesce(valor_icm, 0);'
        '  base_icmsub = coalesce(base_icmsub, 0);'
        '  valor_icmsub = coalesce(valor_icmsub, 0);'
        '  base_iss = coalesce(base_iss, 0);'
        '  valor_iss = coalesce(valor_iss, 0);'
        '  valor_desc = coalesce(valor_desc, 0);'
        '  valor_desc_p = coalesce(valor_desc_p, 0);'
        '  valor_desc_s = coalesce(valor_desc_s, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
