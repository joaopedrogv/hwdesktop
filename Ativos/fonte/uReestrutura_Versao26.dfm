        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        'left join controles ctrl2 on'
        '    ctrl2.codigo_ctrl = cc.codigo_ctrl '
        '    and ctrl2.codigo_emp = cc.codigo_emp '
        
          'where ((trim(cf.event_type_description) = '#39'Venda'#39') or (trim(cf.e' +
          'vent_type_description) like '#39'Antecipa%'#39'))'
        'and cf.pix_id is not null'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
