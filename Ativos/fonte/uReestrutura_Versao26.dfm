        'create or alter procedure RETIRAR_ZERO_ESQ_DESCONS_ULT_D ('
        '    VALOR varchar(50))'
        'returns ('
        '    RESULT varchar(50))'
        'as'
        'declare variable I integer;'
        'declare variable ZERO_ESQ char(1);'
        'declare variable VVAL varchar(50);'
        'begin'
        '  i = 0;'
        '  ZERO_ESQ = '#39'N'#39';'
        '  RESULT = '#39#39';'
        '  vval= trim(valor);'
        ''
        '  while (i < char_length(:vval)) do'
        '  begin'
        
          '    if ((SUBSTRING(:vval FROM i + 1 FOR 1) = '#39'0'#39') and (TRIM(RESU' +
          'LT) = '#39#39')) then'
        '        RESULT = RESULT;'
        '    else'
        '        RESULT = RESULT || SUBSTRING(:vval FROM i + 1 FOR 1);'
        '    i = i + 1;'
        '  end'
        ''
        '  if (CHAR_LENGTH(TRIM(RESULT)) > 1) then'
        
          '    RESULT = SUBSTRING(RESULT FROM 1 FOR CHAR_LENGTH(TRIM(RESULT' +
          ')) - 1);'
        ''
        '  SUSPEND;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_CTRL_AG_CONTA ('
        '    PAGENCIA_CTRL varchar(10),'
        '    PN_CONTA_CTRL varchar(10),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO_CTRL integer,'
        '    NOME_CTRL varchar(35))'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  codigo_ctrl = 0;'
        '  nome_ctrl   = '#39#39';'
        
          '  select first 1 controles.codigo_ctrl, controles.nome_ctrl from' +
          ' controles'
        
          '  where (select result from retirar_zero_esquerda (controles.age' +
          'ncia_ctrl)) ='
        '    (select result from retirar_zero_esquerda (:pagencia_ctrl))'
        
          '  and (select result from retirar_zero_esquerda (controles.n_con' +
          'ta_ctrl)) ='
        '    (select result from retirar_zero_esquerda (:pn_conta_ctrl))'
        '  and controles.codigo_emp = :pcod_empresa'
        '    into :codigo_ctrl, :nome_ctrl;'
        ''
        '  if (coalesce(codigo_ctrl, 0) <= 0) then'
        '  begin'
        
          '    select first 1 controles.codigo_ctrl, controles.nome_ctrl fr' +
          'om controles'
        
          '    where (select result from retirar_zero_esq_descons_ult_d (co' +
          'ntroles.n_conta_ctrl)) ='
        
          '      (select result from retirar_zero_esq_descons_ult_d (:pn_co' +
          'nta_ctrl))'
        '    and controles.codigo_emp = :pcod_empresa'
        '      into :codigo_ctrl, :nome_ctrl;'
        '  end'
        ''
        '  codigo_ctrl = coalesce(codigo_ctrl, 0);'
        '  nome_ctrl   = coalesce(nome_ctrl, '#39#39');'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
