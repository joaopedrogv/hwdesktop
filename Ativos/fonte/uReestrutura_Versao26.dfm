    inherited sqlHwauto: TMemo
      Lines.Strings = (
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'VND265'#39', :COD_EMPRESA, '#39'RECALCULAR PRECOS DE PEDIDO M' +
          'OBILE'#39', 100, '#39'S'#39', '#39'S'#39');'
        'ALTER TABLE REGRAS_VENDAS ADD VALORMAXDOC T_VL_TODOS;'
        'ALTER TABLE REGRAS_VENDAS ADD PARCELAMAX T_VL_TODOS;'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0248'#39', :COD_EMPRESA, '#39'BT HAB EMPRESA CONSULTA COPIA' +
          ' NF'#39', 100, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0249'#39', :COD_EMPRESA, '#39'NOVA NF TRANSF COSULTA COPIA ' +
          'NF'#39', 10, '#39'N'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_PAG_CTP ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PVER_FORMAS integer,'
        '    PFORM_PAG varchar(200) character set WIN1252)'
        'returns ('
        '    ENCONTROU integer,'
        '    FORM_PAG varchar(200) character set WIN1252)'
        'as'
        'declare variable VTEMP varchar(200);'
        'declare variable VCONTROLE varchar(35);'
        'begin'
        '  /* Procedure Text */'
        '  encontrou = 0;'
        '  form_pag = '#39#39';'
        ''
        '  if (coalesce(pver_formas, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (trim(coalesce(pform_pag, '#39#39')) = '#39#39') then'
        '  begin'
        '    for select distinct det.nome_ctrl from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        '        order by 1'
        '      into: vcontrole do'
        '    begin'
        '      encontrou = 1;'
        
          '      vtemp = trim(coalesce(vtemp, '#39#39')) || iif (trim(coalesce(vt' +
          'emp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') || trim(coalesce(vcontrole, '#39#39'));'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = substring(trim(vtemp) from 1 for 200);'
        '    else'
        '      form_pag = trim(vtemp);'
        '    suspend;'
        '  end'
        '  else'
        '  begin'
        '    for select distinct det.nome_ctrl from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        '        and det.nome_ctrl like :pform_pag'
        '        order by 1'
        '      into: vcontrole do'
        '    begin'
        '      encontrou = 1;'
        
          '      vtemp = trim(coalesce(vtemp, '#39#39')) || iif (trim(coalesce(vt' +
          'emp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') || trim(coalesce(vcontrole, '#39#39'));'
        '    end'
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = substring(trim(vtemp) from 1 for 200);'
        '    else'
        '      form_pag = trim(vtemp);'
        '    suspend;'
        '  end'
        ''
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CTP043'#39', :COD_EMPRESA, '#39'HA' +
          'BILITAR CAMPO DATA CADASTRO PARA ALTERACAO'#39', 10, '#39'FRMCADCONTASAP' +
          'AGAR'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CTP044'#39', :COD_EMPRESA, '#39'HA' +
          'BILITAR CAMPO DATA REFERENCIA PARA ALTERACAO'#39', 1, '#39'FRMCADCONTASA' +
          'PAGAR'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        
          'update tabela_processos t set t.nivel_processo = (select t1.nive' +
          'l_processo from tabela_processos t1 where t1.cod_processo = '#39'FPG' +
          '022'#39' and t1.cod_empresa = t.cod_empresa) where t.cod_processo = ' +
          #39'CTP043'#39' and t.cod_empresa = :cod_empresa;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'LANC050'#39', :COD_EMPRESA, '#39'H' +
          'ABILITAR CAMPO DATA REFERENCIA PARA ALTERACAO'#39', 1, '#39'FRMLANCAMENT' +
          'OS'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PROD_SERV_EMVENDAS('
        '    COD_EMPRESA,'
        '    DATA_FECH,'
        '    NPED,'
        '    TIPO,'
        '    NITEM,'
        '    PROD_SERV,'
        '    GRUPOP_CODSERV,'
        '    COD_PROD,'
        '    QUANT_PED_ITEM,'
        '    VLUN_PED_ITEM,'
        '    VLTOT_PED_ITEM,'
        '    VALOR_TOTAL_LIQUIDO,'
        '    VALOR_TOTAL_BRUTO,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PCUST_MC,'
        '    DESCR_ITEM_PED,'
        '    COMISS_PROD,'
        '    COMISS_PROD_GER,'
        '    N_NF,'
        '    DESCRICAO,'
        '    SIGLA,'
        '    TIPO_OS,'
        '    NOME_VENDEDOR,'
        '    COD_VENDEDOR,'
        '    COL_COD_VENDEDOR,'
        '    PC_VEND_SERV,'
        '    PC_VEND_PROD,'
        '    COD_FUNCAO,'
        '    DESC_FUNCAO,'
        '    VENDA,'
        '    QTDE_PROD,'
        '    QTDE_SERV)'
        'AS'
        
          'select v.cod_empresa,  v.data_fech, pp.nped,pp.tipo,pp.nitem,'#39'P'#39 +
          ' as prod_serv,'
        'pp.grupo_prod,pp.cod_prod,'
        'coalesce(pp.quant_ped_item,0) as quant_ped_item,'
        'coalesce(pp.vlun_ped_item,0) as vlun_ped_item,'
        'coalesce(pp.vltot_ped_item,0) as vltot_ped_item,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(pp.rateio_desc,0) as rateio_desc,'
        'coalesce(pp.rateio_acresc,0) as rateio_acresc,'
        'coalesce(pp.pcust_mc,0) as pcust_mc,'
        'pp.descr_prod_ped,'
        'coalesce(pp.comiss_prod,0) as comiss_prod,'
        'coalesce(pp.comiss_prod_ger,0) as comiss_prod_ger,'
        'coalesce(pp.n_nf,0) as n_nf,'
        'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,'
        
          'pp.col_cod_vendedor,c.pc_vend_serv, c.PC_VEND_PROD,f.cod_funcao,' +
          'f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_prod pp on v.tipo = pp.tipo and v.nped = pp.' +
          'nped and v.cod_empresa = pp.cod_empresa'
        'inner join grupos g on pp.grupo_prod = g.codigo_grup'
        
          'inner join colaborador c on pp.cod_vendedor = c.cod_vendedor and' +
          ' pp.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        'where v.status_ped = '#39'FECHADA'#39
        'and v.ativo = 1'
        'and (pp.status <> '#39'CANCELADO'#39' or (pp.status is null))'
        'union'
        
          'select v.cod_empresa,  v.data_fech, ps.nped,ps.tipo,ps.nitem,'#39'S'#39 +
          ' as prod_serv,'
        'ps.cod_servico,'#39'      '#39','
        'coalesce(ps.quant_serv_ped,0) as quant_serv_ped,'
        
          '(case when ps.valor_un_serv=0 then ps.prc_int_serv else ps.valor' +
          '_un_serv end) as valor_un_serv,'
        'coalesce(ps.valor_tot_serv,0) as valor_tot_serv,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(ps.rateio_desc,0) as rateio_desc,'
        'coalesce(ps.rateio_acresc,0) as rateio_acresc,0,'
        'ps.desc_serv_ped,0,0,'
        'coalesce(ps.n_nf,0) as n_nf,'
        
          'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,' +
          'c.cod_vendedor,'
        'c.pc_vend_serv, c.PC_VEND_PROD,'
        'f.cod_funcao,f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_serv ps on v.tipo = ps.tipo and v.nped = ps.' +
          'nped and v.cod_empresa = ps.cod_empresa'
        
          'inner join colaborador c on ps.cod_vendedor = c.cod_vendedor and' +
          ' ps.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        
          'where v.status_ped='#39'FECHADA'#39' and v.ativo = 1 and (ps.status <> '#39 +
          'CANCELADO'#39' or (ps.status is null));'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0250'#39', :COD_EMPRESA, '#39'NF NOVA CONVERSAO AUTO ITEM 1' +
          '=1'#39', 10, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0251'#39', :COD_EMPRESA, '#39'NF NOVA CONVERSAO AUTO ITEM 1' +
          '=1 TODOS PENDENTES'#39', 100, '#39'N'#39', '#39'S'#39');'
        
          'update preco_produtos_qtde pq set pq.seqid = pq.seqid where pq.s' +
          'eqid is null'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'EMITIR CUPOM FISCAL' +
          ' / NFCE REQ'#39' WHERE COD_PROCESSO = '#39'VND136'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'EMITIR CUPOM FISCAL' +
          ' / NFCE OS'#39' WHERE COD_PROCESSO = '#39'VND252'#39';'
        '     '
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND266'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR NF REQ'#39', 10, NULL, 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND267'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR NF OS'#39', 10, NULL, 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND268'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR NFS OS'#39', 10, NULL, 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 6, RDB$CHARACTER_LENGTH' +
          ' = 6 where RDB$FIELD_NAME = (select rdb$field_source from rdb$re' +
          'lation_fields where rdb$relation_name = '#39'IMP_BAR_PROD'#39' and rdb$f' +
          'ield_name = '#39'UNIDADE'#39');'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND269'#39', :COD_EMPRESA, '#39'EN' +
          'VIAR EMAIL/WHATSAPP NFS OS'#39', 1, NULL, 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE)' +
          ';'
        ''
        'ALTER TABLE COBREBEM ADD TESTAR_HTML CHAR(1) DEFAULT '#39'S'#39';'
        ''
        
          'update cobrebem set testar_html = '#39'S'#39' where tipo_api is null and' +
          ' testar_html is null;'
        ''
        'ALTER TABLE BOLETAS ADD DATA_EMAIL_BOL TIMESTAMP;'
        'ALTER TABLE BOLETAS ADD DATA_WHATSAPP_BOL TIMESTAMP;'
        ''
        'ALTER TABLE PEDVENDA ADD DATA_EMAIL_NFS TIMESTAMP;'
        'ALTER TABLE PEDVENDA ADD DATA_WHATSAPP_NFS TIMESTAMP;'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT ENVIAR BOLETO PO' +
          'R EMAIL / WHATSPP'#39' WHERE COD_PROCESSO = '#39'VND232'#39';'
