        'coalesce(pr.valor_ch, 0) valor_pago,'
        'coalesce(pr.valor_ch, 0) valorrateio,'
        '0 valor_pago_vista,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(pr.codigo_ch, 0), 0from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_ch is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 6, pr.codigo_ch, '#39'CREDIARIO'#39', case when (ctr' +
          '1.nome_ctrl is null) then '#39#39' else ctr1.nome_ctrl end tipo2, coal' +
          'esce(pr.valor_ch, 0) as valor_total, '
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       coalesce(l.valor_l, 0)'
        'end valor_pago,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       coalesce(l.valor_l, 0)'
        'end valorrateio,'
        'case when (ctr.docs = '#39'N'#39') then'
        '       case when(l.tipo_l = '#39'S'#39') then'
        '              (coalesce(l.valor_l, 0) * -1)'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        '     else'
        '       0'
        'end valor_pago_vista,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(l.cod_lanc, pr.codigo_ch), 0'
        'from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        'left join lancamentos l on'
        '    l.lote_ent = pr.lote_quit'
        
          '    and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unificado' +
          'ra, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codi' +
          'go_unificadora, pr.codigo_emp)'
        '    and l.data = pr.data_rec'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_ch, '#39#39') = '#39#39' and pr.datq_ch is null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 2, 4, rq.nrecibo, '#39'REC'#39', '#39'REC'#39', coalesce(rq.val' +
          'or_orig, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nrecibo and fp' +
          '.tpdocs = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp.recib' +
          'o is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39
        ''
        'union all'
        ''
        
          'select '#39'TROCO'#39', 2, 4, rq.nrecibo, '#39'REC'#39', '#39'REC'#39', coalesce(rq.valo' +
          'r_orig, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nrecibo and f' +
          'p.rec_tipvend = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp' +
          '.tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS4('
        '    TPDTQUIT_DTREF,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    EXIBIR_RESUMO_FINANCEIRO,'
        '    DOCS,'
        '    DOCS2,'
        '    DOCS3,'
        '    VALOR_PAGO,'
        '    SEQID,'
        '    SEQID2,'
        '    HISTORICO,'
        '    HISTORICO2,'
        '    QTDE_PREST,'
        '    CODIGO,'
        '    TIPO_LOTE,'
        '    LOTE,'
        '    TIPO_LANC,'
        '    COD_LANC,'
        '    NREQUISICAO,'
        '    TIP_BAIXA)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS A VISTA E RECEBIMENTOS DO CREDIARI' +
          'O (CREDITOS/CHEQUES)'
        
          '-- RELATORIO "RESUMO FINANCEIRO" EXIBIDO NA PARTE DOS RECEBIMENT' +
          'OS'
        '    select 1, 1, fp.tpdocs, fp.tpdocs,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else lanc.codigo_emp end) cod_empresa,'
        '    lanc.cod_emp_mult, lanc.data,'
        
          '    case when ctr.nome_ctrl is null then 0 else lanc.codigo_ctrl' +
          ' end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    case when ctr.nome_ctrl is null then '#39'N'#39' else ctr.docs end d' +
          'ocs, ctr.docs docs2, ctr.docs docs3,'
        '    coalesce(fp.valordoc, 0) valordoc,'
        
          '    coalesce(fp.seqform, fp.nrequisicao), coalesce(fp.seqform, f' +
          'p.nrequisicao),'
        
          '    trim(lanc.historico_l) ||'#39' - '#39' || trim(fp.cliente), trim(lan' +
          'c.historico_l),'
        '    1 qtde_prest, lanc.cod_lanc,'
        
          '    '#39'LOTE'#39', (case when (lanc.lote_quit >0) then lanc.lote_quit e' +
          'lse lanc.lote_ent end),'
        '    '#39'LANC'#39', lanc.cod_lanc,'
        '    fp.nrequisicao, null tip_baixa'
        '    from lancamentos lanc'
        '    left join empresa emp on lanc.codigo_emp = emp.cod_empresa'
        '    inner join formpagamento fp on'
        '        fp.n_processamento = lanc.cod_lanc'
        
          '        and fp.cod_empresa = (case when(emp.financeiro_unificado' +
          ' = '#39'S'#39') then lanc.cod_emp_mult else lanc.codigo_emp end)'
        
          '    left join lanccxl cxl on cxl.cod_lancxl = fp.nrequisicao and' +
          ' cxl.codigo_emp = fp.cod_empresa and fp.tpdocs = '#39'LCS'#39
        '    inner join p_contas p on p.n_conta_plc = lanc.n_conta_plc'
        '    inner join grupos_ct c on p.grup_ct = c.grup_ct'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(p.tipo_ctp, '#39#39') <> '#39'F'#39' and c.tipo_gr <> '#39'S'#39' a' +
          'nd coalesce(cxl.cod_lancxl, 0) = 0'
        ''
        '    union'
        '    '
        '    select 2, 1, fp.tpdocs, fp.tpdocs,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else lanc.codigo_emp end) cod_empresa,'
        '    lanc.cod_emp_mult, lanc.dtreferencia,'
        
          '    case when ctr.nome_ctrl is null then 0 else lanc.codigo_ctrl' +
          ' end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    case when ctr.nome_ctrl is null then '#39'N'#39' else ctr.docs end d' +
          'ocs, ctr.docs docs2, ctr.docs docs3,'
        '    coalesce(fp.valordoc, 0) valordoc,'
        
          '    coalesce(fp.seqform, fp.nrequisicao), coalesce(fp.seqform, f' +
          'p.nrequisicao),'
        
          '    trim(lanc.historico_l) ||'#39' - '#39' || trim(fp.cliente), trim(lan' +
          'c.historico_l),'
        '    1 qtde_prest, lanc.cod_lanc,'
        
          '    '#39'LOTE'#39', (case when (lanc.lote_quit >0) then lanc.lote_quit e' +
          'lse lanc.lote_ent end),'
        '    '#39'LANC'#39', lanc.cod_lanc,'
        '    fp.nrequisicao, null tip_baixa'
        '    from lancamentos lanc'
        '    left join empresa emp on lanc.codigo_emp = emp.cod_empresa'
        '    inner join formpagamento fp on'
        '        fp.n_processamento = lanc.cod_lanc'
        
          '        and fp.cod_empresa = (case when(emp.financeiro_unificado' +
          ' = '#39'S'#39') then lanc.cod_emp_mult else lanc.codigo_emp end)'
        
          '    left join lanccxl cxl on cxl.cod_lancxl = fp.nrequisicao and' +
          ' cxl.codigo_emp = fp.cod_empresa and fp.tpdocs = '#39'LCS'#39
        '    inner join p_contas p on p.n_conta_plc = lanc.n_conta_plc'
        '    inner join grupos_ct c on p.grup_ct = c.grup_ct'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(p.tipo_ctp, '#39#39') <> '#39'F'#39' and c.tipo_gr <> '#39'S'#39' a' +
          'nd coalesce(cxl.cod_lancxl, 0) = 0'
        ''
        '    union'
        ''
        '    select 1, 1, fp.tpdocs, fp.tpdocs,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else lanc.codigo_emp end) cod_empresa,'
        '    lanc.cod_emp_mult, lanc.data,'
        
          '    case when ctr.nome_ctrl is null then 0 else lanc.codigo_ctrl' +
          ' end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    case when ctr.nome_ctrl is null then '#39'N'#39' else ctr.docs end d' +
          'ocs, ctr.docs docs2, ctr.docs docs3,'
        '    coalesce(fp.valordoc, 0) valordoc,'
        
          '    coalesce(fp.seqform, fp.nrequisicao), coalesce(fp.seqform, f' +
          'p.nrequisicao),'
        
          '    trim(lanc.historico_l) ||'#39' - '#39' || trim(fp.cliente), trim(lan' +
          'c.historico_l),'
        '    1 qtde_prest, lanc.cod_lanc,'
        
          '    '#39'LOTE'#39', (case when (lanc.lote_quit >0) then lanc.lote_quit e' +
          'lse lanc.lote_ent end),'
        '    '#39'LANC'#39', lanc.cod_lanc,'
        '    fp.nrequisicao, null tip_baixa'
        '    from lancamentos lanc'
        '    left join empresa emp on lanc.codigo_emp = emp.cod_empresa'
        '    inner join formpagamento fp on'
        '        fp.n_processamento = lanc.cod_lanc'
        
          '        and fp.cod_empresa = (case when(emp.financeiro_unificado' +
          ' = '#39'S'#39') then lanc.cod_emp_mult else lanc.codigo_emp end)'
        
          '    left join lanccxl cxl on cxl.cod_lancxl = fp.nrequisicao and' +
          ' cxl.codigo_emp = fp.cod_empresa and fp.tpdocs = '#39'LCS'#39
        '    inner join p_contas p on p.n_conta_plc = lanc.n_conta_plc'
        '    inner join grupos_ct c on p.grup_ct = c.grup_ct'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        '    where coalesce(p.tipo_ctp, '#39#39') <> '#39'F'#39' and c.tipo_gr <> '#39'S'#39
        '    and cxl.tipo_lanc_cxl = '#39'S'#39' and cxl.refrecibo = '#39'S'#39
        ''
        '    union'
        ''
        '    select 2, 1, fp.tpdocs, fp.tpdocs,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else lanc.codigo_emp end) cod_empresa,'
        '    lanc.cod_emp_mult, lanc.dtreferencia,'
        
          '    case when ctr.nome_ctrl is null then 0 else lanc.codigo_ctrl' +
          ' end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    case when ctr.nome_ctrl is null then '#39'N'#39' else ctr.docs end d' +
          'ocs, ctr.docs docs2, ctr.docs docs3,'
        '    coalesce(fp.valordoc, 0) valordoc,'
        
          '    coalesce(fp.seqform, fp.nrequisicao), coalesce(fp.seqform, f' +
          'p.nrequisicao),'
        
          '    trim(lanc.historico_l) ||'#39' - '#39' || trim(fp.cliente), trim(lan' +
          'c.historico_l),'
        '    1 qtde_prest, lanc.cod_lanc,'
        
          '    '#39'LOTE'#39', (case when (lanc.lote_quit >0) then lanc.lote_quit e' +
          'lse lanc.lote_ent end),'
        '    '#39'LANC'#39', lanc.cod_lanc,'
        '    fp.nrequisicao, null tip_baixa'
        '    from lancamentos lanc'
        '    left join empresa emp on lanc.codigo_emp = emp.cod_empresa'
        '    inner join formpagamento fp on'
        '        fp.n_processamento = lanc.cod_lanc'
        
          '        and fp.cod_empresa = (case when(emp.financeiro_unificado' +
          ' = '#39'S'#39') then lanc.cod_emp_mult else lanc.codigo_emp end)'
        
          '    left join lanccxl cxl on cxl.cod_lancxl = fp.nrequisicao and' +
          ' cxl.codigo_emp = fp.cod_empresa and fp.tpdocs = '#39'LCS'#39
        '    inner join p_contas p on p.n_conta_plc = lanc.n_conta_plc'
        '    inner join grupos_ct c on p.grup_ct = c.grup_ct'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        '    where coalesce(p.tipo_ctp, '#39#39') <> '#39'F'#39' and c.tipo_gr <> '#39'S'#39
        '    and cxl.tipo_lanc_cxl = '#39'S'#39' and cxl.refrecibo = '#39'S'#39
        ''
        '    -- Cred'
        '    '
        '    union'
        '    '
        
          '    select 0, 2, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null)' +
          ' then pr.tipo_doc_c else ctr1.nome_ctrl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, pr.datq_c,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then ctr1.codigo_ctrl else cas' +
          'e when ctr.codigo_ctrl is null then 0 else ctr.codigo_ctrl end e' +
          'nd codigo_ctrl,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then ctr1.nome_ctrl else case ' +
          'when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_ctrl e' +
          'nd end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    '#39'N'#39' docs, case when(pr.tip_baixa = '#39'C'#39') then '#39'S2'#39' else ctr.d' +
          'ocs end docs2, case when(pr.tip_baixa = '#39'C'#39') then '#39'N'#39' else ctr.d' +
          'ocs end docs3,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.valor_quitado else cas' +
          'e when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1) else c' +
          'oalesce(l.valor_l, 0) end end valor_pago,'
        '    coalesce(l.cod_lanc, pr.seq_bxcred), 0,'
        
          '    trim(pr.historico_c) ||'#39' - '#39'|| trim(pr.nome_c), coalesce(tri' +
          'm(l.historico_l), coalesce(trim(pr.historico_c) , '#39#39')),'
        '    coalesce((case when ((select count(*) from baixa_creditos bc'
        '                          where bc.lote_quit = pr.lote_quit'
        
          '                          and bc.datq_c = iif(emp.financeiro_uni' +
          'ficado = '#39'S'#39', pr.datq_c, bc.datq_c)'
        
          '                          and iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, bc.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '        1'
        '    else'
        '        (select count(*) from baixa_creditos bc'
        '         where bc.lote_quit = pr.lote_quit'
        
          '         and bc.datq_c = iif(emp.financeiro_unificado = '#39'S'#39', pr.' +
          'datq_c, bc.datq_c)'
        
          '         and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unif' +
          'icadora, bc.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', em' +
          'p.codigo_unificadora, pr.codigo_emp))'
        '    end), 1) qtde_prest, pr.SEQ_BXCRED,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then '#39'LOTE PG'#39' else '#39'LOTE'#39' end' +
          ','
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.lote else pr.lote_quit' +
          ' end,'
        '    case when(pr.tip_baixa = '#39'C'#39') then '#39'CRED'#39' else '#39'LANC'#39' end,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.seq_bxcred else l.cod_' +
          'lanc end cod_lanc,'
        '    0, pr.tip_baixa'
        '    from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join controle_creditos cc on cc.cod_cred = pr.cod_cred ' +
          'and cc.codigo_emp = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_c'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where pr.datq_c is not null'
        '    '
        '    union'
        '    '
        
          '    select 0, 2, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null)' +
          ' then pr.tipo_doc_c else ctr1.nome_ctrl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, pr.data_rec_c,'
        
          '    case when ctr.codigo_ctrl is null then 0 else ctr.codigo_ctr' +
          'l end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        '    '#39'N'#39' docs, ctr.docs docs2, ctr.docs docs3,'
        
          '    case when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1)' +
          ' else coalesce(l.valor_l, 0) end valor_pago,'
        '    coalesce(l.cod_lanc, pr.seq_bxcred), 0,'
        
          '    trim(pr.historico_c) ||'#39' - '#39'|| trim(pr.nome_c), coalesce(tri' +
          'm(l.historico_l), coalesce(trim(pr.historico_c) , '#39#39')),'
        '    coalesce((case when ((select count(*) from baixa_creditos bc'
        '                          where bc.lote_quit = pr.lote_quit'
        
          '                          and bc.datq_c = iif(emp.financeiro_uni' +
          'ficado = '#39'S'#39', pr.datq_c, bc.datq_c)'
        
          '                          and iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, bc.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '        1'
        '    else'
        '        (select count(*) from baixa_creditos bc'
        '         where bc.lote_quit = pr.lote_quit'
        
          '         and bc.datq_c = iif(emp.financeiro_unificado = '#39'S'#39', pr.' +
          'datq_c, bc.datq_c)'
        
          '         and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unif' +
          'icadora, bc.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', em' +
          'p.codigo_unificadora, pr.codigo_emp))'
        '    end), 1) qtde_prest, pr.SEQ_BXCRED,'
        '    '#39'LOTE'#39', pr.lote_quit,'
        '    '#39'LANC'#39', l.cod_lanc,'
        '    0, pr.tip_baixa'
        '    from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.codigo_emp'
        
          '    left join controle_creditos cc on cc.cod_cred = pr.cod_cred ' +
          'and cc.codigo_emp = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.data_rec_c'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where pr.datq_c is null'
        '    '
        '    union'
        '    '
        
          '    select 0, 2, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null)' +
          ' then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, pr.data_rec_c,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        '    '#39'N'#39' docs, ctr.docs docs2, ctr.docs docs3,'
        
          '    case when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1)' +
          ' else coalesce(l.valor_l, 0) end valor_pago,'
        '    coalesce(l.cod_lanc, pr.cod_cred), 0,'
        
          '    trim(pr.historico_c) || '#39' - '#39'|| trim(pr.nome_c), coalesce(tr' +
          'im(l.historico_l), coalesce(trim(pr.historico_c) , '#39#39')),'
        '    1 qtde_prest, pr.cod_cred,'
        '    '#39'LOTE'#39', pr.lote_quit,'
        '    '#39'LANC'#39', l.cod_lanc,'
        '    0, pr.tip_baixa'
        '    from controle_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.data_rec_c'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        '    '
        '    union'
        '    '
        
          '    select 0, 2, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null)' +
          ' then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, pr.datq_ch,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then ctr1.codigo_ctrl else cas' +
          'e when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end end' +
          ' codigo_ctrl,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then ctr1.nome_ctrl else case ' +
          'when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_ctrl e' +
          'nd end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        
          '    '#39'N'#39' docs, case when(pr.tip_baixa = '#39'C'#39') then '#39'S1'#39' else ctr.d' +
          'ocs end docs2, case when(pr.tip_baixa = '#39'C'#39') then '#39'N'#39' else ctr.d' +
          'ocs end docs3,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.valor_ch else case whe' +
          'n(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1) else coales' +
          'ce(l.valor_l, 0) end end valor_pago,'
        '    coalesce(l.cod_lanc, pr.codigo_ch), 0,'
        
          '    trim(pr.historico_ch) || '#39' - '#39'|| trim(pr.nome_ch), coalesce(' +
          'trim(l.historico_l), coalesce(trim(pr.historico_ch) , '#39#39')),'
        
          '    coalesce((case when ((select count(*) from controle_cheque c' +
          'h'
        '                          where ch.lote_quit = pr.lote_quit'
        
          '                          and ch.datq_ch = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', pr.datq_ch, ch.datq_ch)'
        
          '                          and iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, ch.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '      1'
        '    else'
        '      (select count(*) from controle_cheque ch'
        '       where ch.lote_quit = pr.lote_quit'
        
          '       and ch.datq_ch = iif(emp.financeiro_unificado = '#39'S'#39', pr.d' +
          'atq_ch, ch.datq_ch)'
        
          '       and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unific' +
          'adora, ch.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp))'
        '    end), 1) qtde_prest, pr.codigo_ch,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then '#39'LOTE PG'#39' else '#39'LOTE'#39' end' +
          ','
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.lote else pr.lote_quit' +
          ' end,'
        '    case when(pr.tip_baixa = '#39'C'#39') then '#39'CHQ'#39' else '#39'LANC'#39' end,'
        
          '    case when(pr.tip_baixa = '#39'C'#39') then pr.codigo_ch else l.cod_l' +
          'anc end cod_lanc,'
        '    0, pr.tip_baixa'
        '    from controle_cheque pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_ch'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where pr.status_ch is not null and pr.datq_ch is not null'
        '    '
        '    union'
        '    '
        
          '    select 0, 2, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null)' +
          ' then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, pr.data_rec,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    coalesce(ctr.exibir_resumo_financeiro, '#39'S'#39') exibir_resumo_fi' +
          'nanceiro,'
        '    '#39'N'#39' docs, ctr.docs docs2, ctr.docs docs3,'
        
          '    case when(l.tipo_l = '#39'S'#39') then (coalesce(l.valor_l, 0) * -1)' +
          ' else coalesce(l.valor_l, 0) end valor_pago,'
        '    coalesce(l.cod_lanc, pr.codigo_ch), 0,'
        
          '    trim(pr.historico_ch) || '#39' - '#39'|| trim(pr.nome_ch), coalesce(' +
          'trim(l.historico_l), coalesce(trim(pr.historico_ch) , '#39#39')),'
        '    1 qtde_prest, pr.codigo_ch,'
        '    '#39'LOTE'#39', pr.lote_quit,'
        '    '#39'LANC'#39', l.cod_lanc,'
        '    0, pr.tip_baixa'
        '    from controle_cheque pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.data_rec'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        
          '    where coalesce(pr.status_ch, '#39#39') = '#39#39' and pr.datq_ch is null' +
          ';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_ORIG,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_DOC,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CRED,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DAS VENDAS (REQUISICAO, ORDEM DE S' +
          'ERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (CREDITOS/CHE' +
          'QUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '    --- REQ, OS'
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, rq.tipo tp_doc, '#39'DIRETO'#39' tp_recebimento, '#39'D' +
          'IRETO'#39' tp_recebimento2,'
        
          '    1 ordem, 0 cod_tipo, rq.tipo, 0 cod_cred, coalesce(rq.nped, ' +
          '0) as Num_doc, coalesce(fp.ndoc, coalesce(rq.nped, 0), 0) Num_do' +
          'c2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = rq.nped and f' +
          'p.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.re' +
          'cibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, rq.tipo tp_doc, '#39'RECIBO'#39' tp_recebimento, '#39'R' +
          'ECIBO'#39' tp_recebimento2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico,  coalesce(fp.valordoc, 0) valordo' +
          'c,'
        '    fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '        (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = rq.nped and ' +
          'fp.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not' +
          ' fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, rq.tipo tp_doc, '#39'TROCO'#39' tp_recebimento, '#39'TR' +
          'OCO'#39' tp_recebimento2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ',  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rq.nped and ' +
          'fp.rec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and' +
          ' fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        '    --- CF'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'MOT'#39' tp_doc, '#39'DIRETO'#39' tp_recebimento, '#39'DIR' +
          'ETO'#39' tp_recebimento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando), coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = mt.n_comando ' +
          'and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and f' +
          'p.recibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'MOT'#39' tp_doc, '#39'RECIBO'#39' tp_recebimento, '#39'REC' +
          'IBO'#39' tp_recebimento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ','
        '    fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '       inner join formpagamento rc on rc.cod_controle = ctrl.cod' +
          'igo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '       where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa ' +
          '= fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '       (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordo' +
          'c asc)'
        '    end as  nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = mt.n_comando' +
          ' and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (' +
          'not fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'MOT'#39' tp_doc, '#39'TROCO'#39' tp_recebimento, '#39'TROC' +
          'O'#39' tp_recebimento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = mt.n_comando' +
          ' and fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa ' +
          'and fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    -- Cred'
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.codigo_emp,'
        '    pr.cod_emp_mult,'
        '    coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc,'
        '    '#39'CREDIARIO'#39' tp_rel, '#39'CC'#39' tp_doc, '#39'CREDIARIO'#39' tp_recebimento,'
        '    coalesce((case'
        
          '        when (((select count(*) from hist_rec hist where hist.lo' +
          'te_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_emp) > 0' +
          ')'
        
          '            and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39') or' +
          ' (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                '#39'RECIBO'#39
        '        when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                '#39'DEVOLUCAO'#39
        '        else'
        '                '#39'DIRETO'#39
        '        end),'
        '    '#39'DIRETO'#39') tp_recebimento2, 3 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
        
          '    coalesce(pr.seq_bxcred, 0) cod_cred, coalesce(pr.n_doc_c, 0)' +
          ' Num_doc, coalesce(l.ndoc_l, coalesce(pr.n_doc_c, 0)) Num_doc2, ' +
          'pr.data_venc_c as Data_Doc,'
        '    pr.datq_c as Data_Conf,'
        
          '    coalesce(pr.valor_quitado, 0) as valor_total, '#39' '#39' as obs_cxl' +
          '_rq, coalesce(pr.lote_quit, pr.seq_bxcred) as loterec,'
        
          '    coalesce(pr.op_cxl, 0) op_cxl, pr.codigo_vend, l.data, l.his' +
          'torico_l,'
        ''
        '    case when(l.tipo_l = '#39'S'#39') then'
        '           (coalesce(l.valor_l, 0) * -1)'
        '         else'
        '           case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                  case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' the' +
          'n'
        '                        coalesce(pr.valor_quitado, 0)'
        '                       else'
        '                         coalesce(l.valor_l, 0)'
        '                  end'
        '                else'
        '                  coalesce(l.valor_l, 0)'
        '           end'
        '    end valor_pago,'
        ''
        '    l.data, '#39' '#39' terceiros,'
        ''
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            0'
        '                          else'
        
          '                            case when (ctr.codigo_ctrl is null) ' +
          'then 0 else ctr.codigo_ctrl end'
        '                     end'
        '                   else'
        '                     case when ctr.codigo_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        
          '                                   case when (ctr1.codigo_ctrl i' +
          's null) then 0 else ctr1.codigo_ctrl end'
        '                                 else'
        '                                   0'
        '                            end'
        '                          else'
        '                            ctr.codigo_ctrl'
        '                     end'
        '              end),'
        '    0) codigo_ctrl,'
        '    '
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            '#39'SEM FORMA'#39
        '                          else'
        
          '                            case when (ctr.nome_ctrl is null) th' +
          'en 0 else ctr.nome_ctrl end'
        '                     end'
        '                   else'
        '                     case when ctr.nome_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        
          '                                   case when (ctr1.nome_ctrl is ' +
          'null) then 0 else ctr1.nome_ctrl end'
        '                                 else'
        '                                   '#39'SEM FORMA'#39
        '                            end'
        '                          else'
        '                            ctr.nome_ctrl'
        '                     end'
        '              end),'
        '    '#39'SEM FORMA'#39') nome_ctrl,'
        ''
        '    0 as num_recibo, 0 as valor_recibo,'
        ''
        '    coalesce(('
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '            0'
        '         else'
        
          '            (select coalesce(pd.num_nfce, 0) from pedvenda pd   ' +
          '     '
        
          '             where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_' +
          'v and pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) ncupom,'
        ''
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '        (select coalesce(cf.num_nota_v, 0) from com_fat cf'
        
          '        where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.' +
          'codigo_emp)'
        '    else'
        '        (select coalesce(pd.num_nf, 0) from pedvenda pd'
        
          '        where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and' +
          ' pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) num_nf,'
        ''
        ''
        
          '    case when(cc.cod_cred > 0) then coalesce(cc.nparcela, 0) els' +
          'e 0 end nparcela, pr.seq_bxcred, coalesce(l.cod_lanc, pr.seq_bxc' +
          'red),'
        ''
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select coalesce(tp.venda, '#39'S'#39') venda from com_fat cf left j' +
          'oin tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        
          '    else (select coalesce(tp.venda, '#39'S'#39') venda from pedvenda pd ' +
          'left join tipo_vendas tp on tp.tipo = pd.tipo and (tp.sigla = pd' +
          '.tipv or (tp.tipo_os = pd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end), '#39'S'#39') venda,'
        ''
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select tp.tipo_os from com_fat cf left join tipo_vendas tp ' +
          'on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        '    when(trim(pr.tp_doc_v) = '#39'OS'#39') then'
        
          '    (select tp.tipo_os from pedvenda pd left join tipo_vendas tp' +
          ' on tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = p' +
          'd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    else'
        
          '    (select tp.sigla from pedvenda pd left join tipo_vendas tp o' +
          'n tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = pd.' +
          'tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end tipv,'
        '    pr.tp_doc_v as tipo_doc,'
        '    coalesce((case when ((select count(*) from baixa_creditos bc'
        '                          where bc.lote_quit = pr.lote_quit'
        
          '                          and bc.datq_c = iif(emp.financeiro_uni' +
          'ficado = '#39'S'#39', pr.datq_c, bc.datq_c)'
        
          '                          and iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, bc.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '        1'
        '    else'
        '        (select count(*) from baixa_creditos bc'
        '         where bc.lote_quit = pr.lote_quit'
        
          '         and bc.datq_c = iif(emp.financeiro_unificado = '#39'S'#39', pr.' +
          'datq_c, bc.datq_c)'
        
          '         and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unif' +
          'icadora, bc.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', em' +
          'p.codigo_unificadora, pr.codigo_emp))'
        '    end), 1) qtde_prest'
        ''
        '    from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.cod_emp_mult'
        
          '    left join controle_creditos cc on cc.cod_cred = pr.cod_cred ' +
          'and cc.codigo_emp = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_c'
        '        and l.tipo_l = '#39'E'#39
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
          'nd ctr.codigo_emp = l.codigo_emp'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        
          '    where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_c is not' +
          ' null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.codigo_emp,'
        '    pr.cod_emp_mult,'
        '    coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc_cliente,'
        
          '    '#39'CREDIARIO'#39' tp_rel, '#39'CC'#39' tp_doc, '#39'CREDIARIO'#39' tp_recebimento,' +
          ' '#39'DIRETO'#39' tp_recebimento2, 3 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
        
          '    coalesce(pr.seq_bxcred, 0) cod_cred, coalesce(pr.n_doc_c, 0)' +
          ' Num_doc, coalesce(pr.lote, 0) Num_doc2, pr.data_venc_c as Data_' +
          'Doc,'
        '    pr.datq_c as Data_Conf,'
        
