        ''
        '|BLOCO|'
        'create or alter procedure GETDEBITOSEMATRASO ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PTIPO char(3))'
        'returns ('
        '    VALOR double precision,'
        '    QTDE integer)'
        'as'
        'declare variable VSQL varchar(1000);'
        'declare variable VFINANCEIRO_UNIFICADO char(1);'
        'declare variable VDIAS_CARENCIA_JUROS integer;'
        'declare variable VVALOR double precision;'
        'declare variable VQTDE integer;'
        'begin'
        '  valor = 0;'
        '  qtde  = 0;'
        ''
        
          '  select empresa.financeiro_unificado, empresa.dias_car_juros fr' +
          'om empresa where empresa.cod_empresa = :pcod_empresa into :vfina' +
          'nceiro_unificado, :vdias_carencia_juros;'
        ''
        
          '  if ((coalesce(ptipo, '#39#39') = '#39'CH'#39') or (coalesce(ptipo, '#39#39') = '#39'A'#39 +
          ')) then'
        '  begin'
        '    vsql ='
        
          '      '#39' select sum(coalesce(controle_cheque.valor_ch, 0)) valor,' +
          ' count(*) qtde from controle_cheque'
        
          '        left join empresa on empresa.cod_empresa = controle_cheq' +
          'ue.cod_emp_mult'
        '        inner join controles on'
        '          controles.codigo_ctrl = controle_cheque.codigo_ctrl'
        '           and controles.codigo_emp = controle_cheque.codigo_emp'
        
          '           and trim(coalesce(controles.exibir_doc, '#39#39'A'#39#39')) in ('#39 +
          #39#39#39', '#39#39'A'#39#39', '#39#39'S'#39#39')'
        '        inner join clientes on'
        '           clientes.cod_cliente = controle_cheque.cod_cliente'
        
          '           and clientes.cod_empresa = controle_cheque.cod_emp_mu' +
          'lt '#39';'
        ''
        
          '    if ((coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coales' +
          'ce(pcpfcgc, '#39#39') <> '#39#39')) then'
        '      vsql = vsql ||'
        '        '#39' where clientes.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39' '#39';'
        '    else'
        '      vsql = vsql ||'
        
          '        '#39' where controle_cheque.cod_cliente = '#39' || :pcod_cliente' +
          ';'
        ''
        '    vsql = vsql ||'
        
          '      '#39'  and controle_cheque.data_venc + '#39' || :vdias_carencia_ju' +
          'ros || '#39' < current_date'
        
          '         and ((controle_cheque.status_ch is null) or (controle_c' +
          'heque.status_ch = '#39#39#39#39')) '#39';'
        ''
        
          '    if ((coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coales' +
          'ce(pcpfcgc, '#39#39') <> '#39#39')) then'
        '      vsql = vsql ||'
        '        '#39' and empresa.codigo_unificadora = '#39' || :pcod_empresa;'
        '    else'
        '      vsql = vsql ||'
        '        '#39' and controle_cheque.codigo_emp = '#39' || :pcod_empresa;'
        ''
        '    execute statement'
        '      vsql into :vvalor, :vqtde;'
        ''
        '    valor = coalesce(valor, 0) + coalesce(vvalor, 0);'
        '    qtde  = coalesce(qtde, 0)  + coalesce(vqtde, 0);'
        '  end'
        ''
        
          '  if ((coalesce(ptipo, '#39#39') = '#39'CC'#39') or (coalesce(ptipo, '#39#39') = '#39'A'#39 +
          ')) then'
        '  begin'
        '    vsql ='
        
          '      '#39' select sum(coalesce(controle_creditos.valor_c, 0)) valor' +
          ', count(*) qtde from controle_creditos'
        
          '        left join empresa on empresa.cod_empresa = controle_cred' +
          'itos.cod_emp_mult'
        '        inner join controles on'
        '          controles.codigo_ctrl = controle_creditos.codigo_ctrl'
        
          '          and controles.codigo_emp = controle_creditos.codigo_em' +
          'p'
        
          '          and trim(coalesce(controles.exibir_doc, '#39#39'A'#39#39')) in ('#39#39 +
          #39#39', '#39#39'A'#39#39', '#39#39'S'#39#39')'
        '        inner join clientes on'
        '          clientes.cod_cliente = controle_creditos.cod_cliente'
        
          '          and clientes.cod_empresa = controle_creditos.cod_emp_m' +
          'ult '#39';'
        ''
        
          '    if ((coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coales' +
          'ce(pcpfcgc, '#39#39') <> '#39#39')) then'
        '      vsql = vsql ||'
        '        '#39' where clientes.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39' '#39';'
        '    else'
        '      vsql = vsql ||'
        
