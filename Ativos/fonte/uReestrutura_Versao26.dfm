        '|BLOCO|'
        'create or alter procedure RETORNA_DATA_ENV_BOL ('
        '    PN_SEQ_BOL integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    DATA_ENV_WHATSAPP timestamp,'
        '    DATA_ENV_EMAIL timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  data_env_email    = null;'
        '  data_env_whatsapp = null;'
        ''
        '  select first 1 data_env from('
        '        select first 1 env_doc.data_env from env_doc'
        '        where env_doc.num_doc = '#39'BOL_'#39' || :pn_seq_bol'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'W'#39
        '        union'
        '        select first 1 bol.data_whatsapp_bol from boletas bol'
        '        where bol.n_seq_bol = :pn_seq_bol'
        '        and bol.cod_empresa = :pcod_empresa'
        '        order by 1 desc)'
        '          into :data_env_whatsapp;'
        ''
        '  select first 1 data_env from('
        '        select first 1 env_doc.data_env from env_doc'
        '        where env_doc.num_doc = '#39'BOL_'#39' || :pn_seq_bol'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'E'#39
        '        union'
        '        select first 1 bol.data_email_bol from boletas bol'
        '        where bol.n_seq_bol = :pn_seq_bol'
        '        and bol.cod_empresa = :pcod_empresa'
        '        order by 1 desc)'
        '          into :data_env_email;'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    QUANT_PROD,'
        '    QUANT_PROD_TERC,'
        '    QUANT_SERV,'
        '    QUANT_SERV_TERC,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    ACRESC_ITEM_PROD,'
        '    DESC_ITEM_PROD,'
        '    ACRESC_ITEM_SERV,'
        '    DESC_ITEM_SERV,'
        '    VALOR_TOTAL,'
        '    VALOR_BRUTO,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  coalesce('
        
          '   coalesce((select sum(case when (trim(coalesce(pp.unidade_conv' +
          ', '#39#39')) = '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '             where pp.nped = pedvenda.nped'
        '             and pp.tipo = pedvenda.tipo'
        '             and pp.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '   coalesce((select sum(coalesce(ppt.qtde, 0)) from pedvenda_pro' +
          'd_terc ppt'
        '             where ppt.nped = pedvenda.nped'
        '             and ppt.tipo = pedvenda.tipo'
        '             and ppt.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_ped_item,'
        ''
        '  coalesce('
        
          '   coalesce((select sum(coalesce(ps.quant_serv_ped, 0)) from ped' +
          'venda_serv ps'
        '             where ps.nped = pedvenda.nped'
        '             and ps.tipo = pedvenda.tipo'
        '             and ps.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(ps.status, '#39#39') = '#39#39'), 0) +'
        '   coalesce((select count(*) from pedvenda_serv_terc pst'
        '             where pst.nped = pedvenda.nped'
        '             and pst.tipo = pedvenda.tipo'
        '             and pst.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_serv_ped,'
        ''
        
          '  coalesce((select coalesce(qtde, 0) from retorna_qtde_kit(pedve' +
          'nda.nped, pedvenda.tipo, pedvenda.cod_empresa)), 0) quant_kit,'
        ''
        ''
        
          '  coalesce((select sum(case when (trim(coalesce(pp.unidade_conv,' +
          ' '#39#39')) = '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '             where pp.nped = pedvenda.nped'
        '             and pp.tipo = pedvenda.tipo'
        '             and pp.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(pp.status, '#39#39') = '#39#39'),'
        '  0) quant_prod,'
        ''
        
          '  coalesce((select sum(coalesce(ppt.qtde, 0)) from pedvenda_prod' +
          '_terc ppt'
        '             where ppt.nped = pedvenda.nped'
        '             and ppt.tipo = pedvenda.tipo'
        '             and ppt.cod_empresa = pedvenda.cod_empresa),'
        '  0) quant_prod_terc,'
        ''
        
          '  coalesce((select sum(coalesce(ps.quant_serv_ped, 0)) from pedv' +
          'enda_serv ps'
        '             where ps.nped = pedvenda.nped'
        '             and ps.tipo = pedvenda.tipo'
        '             and ps.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(ps.status, '#39#39') = '#39#39'),'
        '  0) quant_serv,'
        ''
        '  coalesce((select count(*) from pedvenda_serv_terc pst'
        '             where pst.nped = pedvenda.nped'
        '             and pst.tipo = pedvenda.tipo'
        '             and pst.cod_empresa = pedvenda.cod_empresa),'
        '  0) quant_serv_terc,'
        ''
        '  coalesce(pedvenda.tot_prod, 0) TOT_PROD,'
        '  coalesce(pedvenda.tot_serv, 0) TOT_SERV,'
        '  coalesce(pedvenda.tot_prod_terc, 0) TOT_PROD_TERC,'
        '  coalesce(pedvenda.tot_serv_terc, 0) TOT_SERV_TERC,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedve' +
          'nda_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_PRO' +
          'D,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedvend' +
          'a_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) DESC_ITEM_PROD,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from pedve' +
          'nda_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_SER' +
          'V,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedvend' +
          'a_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) DESC_ITEM_SERV,'
        ''
        '  coalesce(pedvenda.valor_total, 0) VALOR_TOTAL,'
        
          '  (coalesce(pedvenda.tot_prod, 0) + coalesce(pedvenda.tot_serv, ' +
          '0) + coalesce(pedvenda.tot_prod_terc, 0) + coalesce(pedvenda.tot' +
          '_serv_terc, 0)) VALOR_BRUTO,'
        ''
        
          '  (coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedv' +
          'enda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from ped' +
          'venda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '   (coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0)) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DADOS_RECEBIMENTO('
        '    SEQFORM,'
        '    NREQUISICAO,'
        '    NDOC,'
        '    TPDOCS,'
        '    COD_EMPRESA,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALORDOC)'
        'AS'
        
          'select fp.seqform, fp.nrequisicao, fp.ndoc, fp.tpdocs, fp.cod_em' +
          'presa, fp.data_mov, fp.data_venc,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        'coalesce(fp.valordoc, 0) valordoc'
        'from formpagamento fp'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where fp.recibo is null'
        'union'
        
          'select fp.seqform, fp.nrequisicao, fp.ndoc, fp.tpdocs, fp.cod_em' +
          'presa, fp.data_mov, fp.data_venc,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        'end as codigo_ctrl,'
        #39'RECIBO ANTECIPADO'#39' nome_ctrl,'
        'coalesce(fp.valordoc, 0) valordoc'
        'from formpagamento fp'
        'where (not fp.recibo is null)'
        'union'
        
          'select fp.seqform, fp.rec_numvend, fp.ndoc, fp.rec_tipvend, fp.c' +
          'od_empresa, fp.data_mov, fp.data_venc,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        #39'TROCO'#39' nome_ctrl,'
        'coalesce(fp.valordoc, 0) valordoc'
        'from formpagamento fp'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where fp.tpdocs = '#39'TRC'#39
        'order by 1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW FICHAVENDAPROD4('
        '    TP,'
        '    NOME_CLIENTE,'
        '    NDOC,'
        '    VALOR,'
        '    DATA,'
        '    DATA_FECH,'
        '    DESCR_PROD,'
        '    NUM_FAB_PROD,'
        '    QTDE,'
        '    VL_UNIT,'
        '    VL_TOT,'
        '    COD_CLIENTE,'
        '    COD_EMPRESA,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_GRADE,'
        '    TIPOVENDA,'
        '    TIPOOS,'
        '    DESCRICAOGRADE,'
        '    N_ITEM,'
        '    STATUS_PED,'
        '    STATUS,'
        '    TABPRATICADA,'
        '    UNIDADE,'
        '    UNIDADE_CONV,'
        '    OPERACAO_CONV,'
        '    FATOR_CONV)'
        'AS'
        'select pv.Tipo,cl.nome_cliente, pv.nped,'
        'coalesce(pv.valor_total, 0) valor_total,'
        'pv.data_ped, pv.data_fech, pvp.descr_prod_ped,'
        'pvp.num_fab_prod,'
        'coalesce(pvp.quant_ped_item, 0) quant_ped_item,'
        'coalesce(pvp.vlun_ped_item, 0) vlun_ped_item,'
        'coalesce(pvp.vltot_ped_item, 0) vltot_ped_item,'
        
          'pv.cod_cliente, pv.cod_empresa, pvp.grupo_prod, pvp.cod_prod, pv' +
          'p.cod_grade,'
        
          'pv.tipv, pv.tipo_os, gr.descricao, pvp.nitem, pv.status_ped, pvp' +
          '.status,'
        
          'pvp.tabpraticada, pvp.unidade, pvp.unidade_conv, pvp.operacao_co' +
          'nv, pvp.fator_conv'
        'from pedvenda pv'
        
          'inner join pedvenda_prod pvp on pvp.nped = pv.nped and pvp.cod_e' +
          'mpresa = pv.cod_empresa and pvp.tipo = pv.tipo'
        'and (pvp.status is null or pvp.status = '#39#39')'
        
          'left join grade gr on pvp.cod_grade = gr.cod_grade and gr.cod_em' +
          'presa = pvp.cod_empresa'
        
          'inner join clientes cl on cl.cod_cliente = pv.cod_cliente and cl' +
          '.cod_empresa = pv.cod_empresa'
        
          'inner join produtos p on p.cod_prod = pvp.cod_prod and p.grupo_p' +
          'rod = pvp.grupo_prod and p.cod_empresa = pvp.cod_empresa'
        'where pv.ativo = 1;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS524'#39', :COD_EMPRESA, '#39'AB' +
          'RIR TELA TIPO LANC CONC CARTAO'#39', 10, '#39'N'#39', '#39'FRMCADCONCILIACAOTIPO' +
          'LANC'#39', 1, '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS525'#39', :COD_EMPRESA, '#39'BT' +
          ' PESQUISAR TIPO LANC CONC CARTAO'#39', 10, '#39'N'#39', '#39'FRMCADCONCILIACAOTI' +
          'POLANC'#39', 1, '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS526'#39', :COD_EMPRESA, '#39'BT' +
          ' ALTERAR TIPO LANC CONC CARTAO'#39', 10, '#39'N'#39', '#39'FRMCADCONCILIACAOTIPO' +
          'LANC'#39', 1, '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS527'#39', :COD_EMPRESA, '#39'BT' +
          ' REMOVER NUM CONTA (E/S) TIPO LANC CONC CARTAO'#39', 10, '#39'N'#39', '#39'FRMCA' +
          'DCONCILIACAOTIPOLANC'#39', 1, '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS528'#39', :COD_EMPRESA, '#39'BT' +
          ' SALVAR TIPO LANC CONC CARTAO'#39', 10, '#39'N'#39', '#39'FRMCADCONCILIACAOTIPOL' +
          'ANC'#39', 1, '#39'S'#39', CURRENT_DATE);'
        ''
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'ABRIR TELA' +
          ' COD EMPRESA POR ADQ CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS518'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT PESQUIS' +
          'AR COD EMPRESA POR ADQ CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS519' +
          #39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT INCLUIR' +
          ' COD EMPRESA POR ADQ CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS520'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT ALTERAR' +
          ' COD EMPRESA POR ADQ  CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS521'#39 +
          ';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT EXCLUIR' +
          ' COD EMPRESA POR ADQ CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS522'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT SALVAR ' +
          'COD EMPRESA POR ADQ CONC CARTAO'#39' WHERE COD_PROCESSO = '#39'BAS523'#39';'
        ''
        'ALTER TABLE CONCILIACAO_TIPO_LANC ADD N_CONTA_PLC_E T_N_GERAL;'
        'ALTER TABLE CONCILIACAO_TIPO_LANC ADD N_CONTA_PLC_S T_N_GERAL;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS529'#39', :COD_EMPRESA, '#39'SA' +
          'LVAR DADOS TIPO LANC EM LOTE'#39', 5, '#39'S'#39', '#39'FRMCADCONCILIACAOTIPOLAN' +
          'C'#39', 1, '#39'S'#39', CURRENT_DATE);'
        ''
        'ALTER TABLE CONCILIACAO_FINANCEIRO ADD PAYMENT_DATE TIMESTAMP;'
        
          'ALTER TABLE CONCILIACAO_FINANCEIRO ADD BANK_SHIPPING_DATE TIMEST' +
          'AMP;'
        'ALTER TABLE CONCILIACAO_FINANCEIRO ADD ARQUIVO VARCHAR(50);'
