        '|BLOCO|'
        'CREATE OR ALTER VIEW DEVOLUCAO_HIST_TOT('
        '    TIPO,'
        '    TIPO_DEV,'
        '    NDEV,'
        '    DATA,'
        '    COD_CLIENTE,'
        '    COD_EMPRESA,'
        '    COD_VENDEDOR,'
        '    VALOR_DEV,'
        '    QUANT_DEV)'
        'AS'
        'select '#39'DEV'#39' as tipo,'
        '  '#39#39' tipo_dev,'
        '  h.numero,'
        '  h.data,'
        '  h.cod_cliente,'
        '  h.cod_empresa,'
        '  h.cod_vendedor,'
        
          '  sum((-1) * case when (coalesce(h.valor_tot, 0) > 0) then coale' +
          'sce(h.valor_tot, 0) else coalesce((h.valor_unit * h.qtde), 0) en' +
          'd) valor_dev,'
        
          '  count(distinct(h.numero)) quant_dev from hist_estoque_diario_p' +
          'rod h'
        '  where h.natureza = '#39'E'#39
        '  group by 1, 2, 3, 4, 5, 6, 7;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_DOC_CASHBACK ('
        '    PNDOC integer,'
        '    PTIPODOC char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    NDOC integer,'
        '    TIPODOC char(3),'
        '    COD_EMPRESA integer,'
        '    VALOR_DESCONTO double precision,'
        '    VALOR_ACRESCIMO double precision,'
        '    VALOR_TOTAL double precision,'
        '    VALOR_VALE double precision,'
        '    COD_CLIENTE integer,'
        '    NOME_CLIENTE varchar(35),'
        '    RAZAO_CLIENTE varchar(60),'
        '    CPFCGC_CLIENTE varchar(18),'
        '    RG_CLIENTE varchar(10),'
        '    TELEFONE_CLIENTE varchar(13),'
        '    CELULAR_CLIENTE varchar(13),'
        '    EMAIL_CLIENTE varchar(256),'
        '    DATA_NASC_CLIENTE timestamp,'
        '    SEXO_GENERO_CLIENTE char(1),'
        '    COD_VENDEDOR integer,'
        '    NOME_VENDEDOR varchar(35),'
        '    CPF_VENDEDOR varchar(11),'
        '    RG_VENDEDOR varchar(11),'
        '    TELEFONE_VENDEDOR varchar(13),'
        '    EMAIL_VENDEDOR varchar(128),'
        '    DATA_NASC_VENDEDOR timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  if ((trim(coalesce(ptipodoc, '#39#39')) = '#39'REQ'#39') or (trim(coalesce(p' +
          'tipodoc, '#39#39')) = '#39'OS'#39')) then'
        '  begin'
        
          '    select pedvenda.nped, pedvenda.tipo, pedvenda.cod_empresa, p' +
          'edvenda.valor_total,'
        
          '    (coalesce((select sum(coalesce(pedvenda_prod.rateio_desc, 0)' +
          ') from pedvenda_prod'
        '               where pedvenda_prod.nped = pedvenda.nped'
        '               and pedvenda_prod.tipo = pedvenda.tipo'
        
          '               and pedvenda_prod.cod_empresa = pedvenda.cod_empr' +
          'esa'
        '               and coalesce(pedvenda_prod.status, '#39#39') = '#39#39'), 0)'
        '    ) valor_desconto,'
        
          '    (coalesce((select sum(coalesce(pedvenda_prod.rateio_acresc, ' +
          '0)) from pedvenda_prod'
        '               where pedvenda_prod.nped = pedvenda.nped'
        '               and pedvenda_prod.tipo = pedvenda.tipo'
        
          '               and pedvenda_prod.cod_empresa = pedvenda.cod_empr' +
          'esa'
        '               and coalesce(pedvenda_prod.status, '#39#39') = '#39#39'), 0)'
        '    ) valor_acrescimo,'
        
          '    coalesce((select coalesce(valor_vale, 0) from existe_formas ' +
          '(pedvenda.nped, pedvenda.tipo, pedvenda.cod_empresa)), 0) valor_' +
          'vale,'
        
          '    clientes.cod_cliente, clientes.nome_cliente, clientes.razao,' +
          ' clientes.cpfcgc, clientes.rg,'
        
          '    clientes.fone_cliente, clientes.fone_celular, clientes.email' +
          ', clientes.data_nasc, clientes.sexo,'
        
          '    colaborador.cod_vendedor, colaborador.nome_vendedor, colabor' +
          'ador.cpf_vendedor, colaborador.rg_vendedor,'
        
          '    colaborador.fone_vendedor, colaborador.email, colaborador.da' +
          't_nasc_col from pedvenda'
        
          '    inner join clientes on clientes.cod_cliente = pedvenda.cod_c' +
          'liente and clientes.cod_empresa = pedvenda.cod_empresa'
        
          '    inner join colaborador on colaborador.cod_vendedor = pedvend' +
          'a.cod_vendedor and colaborador.cod_empresa = pedvenda.cod_empres' +
          'a'
        '    where pedvenda.nped = :pndoc'
        '    and pedvenda.tipo = :ptipodoc'
        '    and pedvenda.cod_empresa = :pcod_empresa'
        
          '      into :ndoc, :tipodoc, :cod_empresa, :valor_total, :valor_d' +
          'esconto, :valor_acrescimo, :valor_vale,'
        
          '           :cod_cliente, :nome_cliente, :razao_cliente, :cpfcgc_' +
          'cliente, :rg_cliente,'
        
          '           :telefone_cliente, :celular_cliente, :email_cliente, ' +
          ':data_nasc_cliente, :sexo_genero_cliente,'
        
          '           :cod_vendedor, :nome_vendedor, :cpf_vendedor, :rg_ven' +
          'dedor,'
        
          '           :telefone_vendedor, :email_vendedor, :data_nasc_vende' +
          'dor;'
        '  end'
        '  else if (trim(coalesce(ptipodoc, '#39#39')) = '#39'DEV'#39') then'
        '  begin'
        
          '    select devolucao_tot.ndev, '#39'DEV'#39', devolucao_tot.cod_empresa,' +
          ' - abs(devolucao_tot.valor_dev) valor_dev, 0 valor_desconto, 0 v' +
          'alor_acrescimo, 0 valor_vale,'
        
          '    clientes.cod_cliente, clientes.nome_cliente, clientes.razao,' +
          ' clientes.cpfcgc, clientes.rg,'
        
          '    clientes.fone_cliente, clientes.fone_celular, clientes.email' +
          ', clientes.data_nasc, clientes.sexo,'
        
          '    colaborador.cod_vendedor, colaborador.nome_vendedor, colabor' +
          'ador.cpf_vendedor, colaborador.rg_vendedor,'
        
          '    colaborador.fone_vendedor, colaborador.email, colaborador.da' +
          't_nasc_col from devolucao_tot'
        
          '    inner join clientes on clientes.cod_cliente = devolucao_tot.' +
          'cod_cliente and clientes.cod_empresa = devolucao_tot.cod_empresa'
        
          '    inner join colaborador on colaborador.cod_vendedor = devoluc' +
          'ao_tot.cod_vendedor and colaborador.cod_empresa = devolucao_tot.' +
          'cod_empresa'
        '    where devolucao_tot.ndev = :pndoc'
        '    and devolucao_tot.cod_empresa = :pcod_empresa'
        
          '      into :ndoc, :tipodoc, :cod_empresa, :valor_total, :valor_d' +
          'esconto, :valor_acrescimo, :valor_vale,'
        
          '           :cod_cliente, :nome_cliente, :razao_cliente, :cpfcgc_' +
          'cliente, :rg_cliente,'
        
          '           :telefone_cliente, :celular_cliente, :email_cliente, ' +
          ':data_nasc_cliente, :sexo_genero_cliente,'
        
          '           :cod_vendedor, :nome_vendedor, :cpf_vendedor, :rg_ven' +
          'dedor,'
        
          '           :telefone_vendedor, :email_vendedor, :data_nasc_vende' +
          'dor;'
        ''
        '    if (coalesce(cod_empresa, 0) = 0) then'
        '    begin'
        
          '      select devolucao_hist_tot.ndev, '#39'DEV'#39', devolucao_hist_tot.' +
          'cod_empresa, - abs(devolucao_hist_tot.valor_dev) valor_dev, 0 va' +
          'lor_desconto, 0 valor_acrescimo,'
        
          '      clientes.cod_cliente, clientes.nome_cliente, clientes.raza' +
          'o, clientes.cpfcgc, clientes.rg,'
        
          '      clientes.fone_cliente, clientes.fone_celular, clientes.ema' +
          'il, clientes.data_nasc, clientes.sexo,'
        
          '      colaborador.cod_vendedor, colaborador.nome_vendedor, colab' +
          'orador.cpf_vendedor, colaborador.rg_vendedor,'
        
          '      colaborador.fone_vendedor, colaborador.email, colaborador.' +
          'dat_nasc_col from devolucao_hist_tot'
        
          '      inner join clientes on clientes.cod_cliente = devolucao_hi' +
          'st_tot.cod_cliente and clientes.cod_empresa = devolucao_hist_tot' +
          '.cod_empresa'
        
          '      inner join colaborador on colaborador.cod_vendedor = devol' +
          'ucao_hist_tot.cod_vendedor and colaborador.cod_empresa = devoluc' +
          'ao_hist_tot.cod_empresa'
        '      where devolucao_hist_tot.ndev = :pndoc'
        '      and devolucao_hist_tot.cod_empresa = :pcod_empresa'
        
          '        into :ndoc, :tipodoc, :cod_empresa, :valor_total, :valor' +
          '_desconto, :valor_acrescimo,'
        
          '             :cod_cliente, :nome_cliente, :razao_cliente, :cpfcg' +
          'c_cliente, :rg_cliente,'
        
          '             :telefone_cliente, :celular_cliente, :email_cliente' +
          ', :data_nasc_cliente, :sexo_genero_cliente,'
        
          '             :cod_vendedor, :nome_vendedor, :cpf_vendedor, :rg_v' +
          'endedor,'
        
          '             :telefone_vendedor, :email_vendedor, :data_nasc_ven' +
          'dedor;'
        '    end'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE VALE_CUPONS ADD NUM_DOC INTEGER;'
        'ALTER TABLE VALE_CUPONS ADD TIPO_DOC CHAR(3);'
        'ALTER TABLE VALE_CUPONS ADD COD_EMP_DOC INTEGER;'
        ''
        'ALTER TABLE COBREBEM ADD QRCODE_PIX CHAR(1);'
        ''
        'ALTER TABLE BOLETAS ADD API_URLPIX VARCHAR(256);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO458'#39', :COD_EMPRESA, '#39'HA' +
          'BILITAR BOTAO ALTERNA ENTRE CAD SIMPL E COMPLETO'#39', 100, '#39'FRMCADC' +
          'LIENTES'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO459'#39', :COD_EMPRESA, '#39'AL' +
          'TERNAR ENTRE CAD SIMPL E COMPLETO'#39', 10, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39 +
          ', '#39'S'#39', CURRENT_DATE);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI292'#39', :COD_EMPRESA, '#39'HA' +
          'BILITAR BOTAO ALTERNA ENTRE CAD SIMPL E COMPLETO'#39', 100, '#39'FRMCADC' +
          'LIENTES'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI293'#39', :COD_EMPRESA, '#39'AL' +
          'TERNAR ENTRE CAD SIMPL E COMPLETO'#39', 10, '#39'FRMCADCLIENTES'#39', 1, '#39'N'#39 +
          ', '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_PRODUTOS_EC FOR PRODUTOS'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE ECOMMERCE INTEGER;  '
        '  DECLARE VARIABLE SINC_ECOMMERCE VARCHAR(1);'
        '  DECLARE VARIABLE IDCOMMERCE INTEGER;'
        '  DECLARE VARIABLE VSQL VARCHAR(100);'
        'begin'
        '  /* Trigger text */'
        '   IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        '  VSQL = '#39#39';'
        ''
        '  SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        '  WHERE CONFIG_SISTEMA.CHAVE = '#39'e-commerce_hab'#39
        
          '  AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO: ECOMMER' +
          'CE;'
        ''
        
          '  SELECT COALESCE(PRODUTOS_EC.SINC_ECOMMERCE, '#39'N'#39') SINC_ECOMMERC' +
          'E,'
        
          '  COALESCE(PRODUTOS_EC.ID_COMMERCE, 0) ID_COMMERCE FROM PRODUTOS' +
          '_EC'
        '  WHERE PRODUTOS_EC.GRUPO_PROD = NEW.GRUPO_PROD'
        '  AND PRODUTOS_EC.COD_PROD = NEW.COD_PROD'
        '  AND PRODUTOS_EC.COD_EMPRESA = NEW.COD_EMPRESA'
        '    INTO :SINC_ECOMMERCE, :IDCOMMERCE;'
        ''
        
          '  if ((COALESCE(IDCOMMERCE, 0) <= 0) and (COALESCE(ECOMMERCE, 0)' +
          ' <= 0)) then'
        '    exit;'
        ''
        '  if (trim(old.LISTA_IMAGENS) <> trim(new.LISTA_IMAGENS)) then'
        '  begin'
        '    if (coalesce(new.ALTEROU_IMAGEM, '#39'N'#39') <> '#39'S'#39') then'
        '        new.ALTEROU_IMAGEM = '#39'S'#39';'
        '    if (coalesce(new.ALTEROU_IMAGEM_GRADE, '#39'N'#39') <> '#39'S'#39') then'
        '        new.ALTEROU_IMAGEM_GRADE = '#39'S'#39';'
        '  end'
        ''
        '  IF (COALESCE(IDCOMMERCE, 0) > 0) THEN'
        '    new.ID_COMMERCE = :IDCOMMERCE;'
        ''
        '  if (updating) then'
        '  begin'
        
          '    if ((coalesce(old.ativo, 0) <> coalesce(new.ativo, 0)) and (' +
          'new.ativo = 0)) then'
        '      VSQL = '#39' produtos_ec.disponivel = '#39#39'N'#39#39', '#39';'
        
          '    else if ((coalesce(old.ativo, 0) <> coalesce(new.ativo, 0)) ' +
          'and (new.ativo = 99)) then'
        '      VSQL = '#39' produtos_ec.sinc_ecommerce = '#39#39'N'#39#39', '#39';'
        '  end'
        ''
        '  execute statement'
        '   '#39'update produtos_ec set '#39'||VSQL||'#39
        '      produtos_ec.grupo_prod = '#39'||new.grupo_prod||'#39','
        '      produtos_ec.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39','
        '      produtos_ec.cod_empresa = '#39'||new.cod_empresa||'#39
        '    where produtos_ec.grupo_prod = '#39'||new.grupo_prod||'#39
        '    and produtos_ec.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39
        '    and produtos_ec.cod_empresa = '#39'||new.cod_empresa||'#39';'#39';'
        ''
        '  execute statement'
        '   '#39'update kits_prod_kits set'
        '      kits_prod_kits.grupo_prod = '#39'||new.grupo_prod||'#39','
        '      kits_prod_kits.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39','
        '      kits_prod_kits.cod_empresa = '#39'||new.cod_empresa||'#39
        '    where kits_prod_kits.grupo_prod = '#39'||new.grupo_prod||'#39
        '    and kits_prod_kits.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39
        '    and kits_prod_kits.cod_empresa = '#39'||new.cod_empresa||'#39';'#39';'
        ''
        '  update produtos_ec_grade set'
        '    produtos_ec_grade.grupo_prod = new.grupo_prod,'
        '    produtos_ec_grade.cod_prod = new.cod_prod,'
        '    produtos_ec_grade.cod_empresa = new.cod_empresa'
        '  where produtos_ec_grade.grupo_prod = new.grupo_prod'
        '  and produtos_ec_grade.cod_prod = new.cod_prod'
        '  and produtos_ec_grade.cod_empresa = new.cod_empresa;'
        ''
        '  if (updating) then'
        '    if (coalesce(SINC_ECOMMERCE, '#39'N'#39') = '#39'N'#39') then'
        '    begin'
        '      update produtos_ec_grade set'
        '        produtos_ec_grade.sinc_ecommerce = '#39'N'#39
        '      where produtos_ec_grade.grupo_prod = new.grupo_prod'
        '      and produtos_ec_grade.cod_prod = new.cod_prod'
        '      and produtos_ec_grade.cod_empresa = new.cod_empresa'
        '      and produtos_ec_grade.sinc_ecommerce = '#39'S'#39';'
        '    end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_PRODUTOS_CA FOR PRODUTOS'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE COMERCIO_ABERTO INTEGER;'
        '  DECLARE VARIABLE ENV_COMERCIO_ABERTO CHAR(1);'
        '  DECLARE VARIABLE ID_COMERCIO_ABERTO INTEGER;'
        '  DECLARE VARIABLE VSQL VARCHAR(100);'
        'begin'
        '  /* Trigger text */'
        '   IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        '  VSQL = '#39#39';'
        ''
        '  SELECT CONFIG_SISTEMA.VALUE1_F FROM CONFIG_SISTEMA'
        '  WHERE CONFIG_SISTEMA.CHAVE = '#39'comercio_aberto_hab'#39
        
          '  AND CONFIG_SISTEMA.COD_EMPRESA = NEW.COD_EMPRESA INTO: COMERCI' +
          'O_ABERTO;'
        ''
        
          '  SELECT COALESCE(PRODUTOS_EC.ENV_COMERCIO_ABERTO, '#39'N'#39') ENV_COME' +
          'RCIO_ABERTO,'
        
          '  COALESCE(PRODUTOS_EC.ID_COMERCIO_ABERTO, 0) ID_COMERCIO_ABERTO' +
          ' FROM PRODUTOS_EC'
        '  WHERE PRODUTOS_EC.GRUPO_PROD = NEW.GRUPO_PROD'
        '  AND PRODUTOS_EC.COD_PROD = NEW.COD_PROD'
        '  AND PRODUTOS_EC.COD_EMPRESA = NEW.COD_EMPRESA'
        '    INTO :ENV_COMERCIO_ABERTO, :ID_COMERCIO_ABERTO;'
        ''
        
          '  if ((COALESCE(ID_COMERCIO_ABERTO, 0) <= 0) and (COALESCE(COMER' +
          'CIO_ABERTO, 0) <= 0)) then'
        '    exit;'
        ''
        '  if (trim(old.LISTA_IMAGENS) <> trim(new.LISTA_IMAGENS)) then'
        '  begin'
        '    if (coalesce(new.ALTEROU_IMAGEM, '#39'N'#39') <> '#39'S'#39') then'
        '        new.ALTEROU_IMAGEM = '#39'S'#39';'
        '    if (coalesce(new.ALTEROU_IMAGEM_GRADE, '#39'N'#39') <> '#39'S'#39') then'
        '        new.ALTEROU_IMAGEM_GRADE = '#39'S'#39';'
        '  end'
        ''
        '  if (COALESCE(ID_COMERCIO_ABERTO, 0) > 0) THEN'
        '    new.ID_COMERCIO_ABERTO = :ID_COMERCIO_ABERTO;'
        '    '
        '  if (updating) then'
        '  begin'
        
          '    if ((coalesce(old.ativo, 0) <> coalesce(new.ativo, 0)) and (' +
          'new.ativo = 0)) then'
        '      VSQL = '#39' produtos_ec.env_comercio_aberto = '#39#39'N'#39#39', '#39';'
        
          '    else if ((coalesce(old.ativo, 0) <> coalesce(new.ativo, 0)) ' +
          'and (new.ativo = 99)) then'
        '      VSQL = '#39' produtos_ec.env_comercio_aberto = '#39#39'N'#39#39', '#39';'
        '  end'
        ''
        '  execute statement'
        '   '#39'update produtos_ec set '#39'||VSQL||'#39
        '      produtos_ec.grupo_prod = '#39'||new.grupo_prod||'#39','
        '      produtos_ec.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39','
        '      produtos_ec.cod_empresa = '#39'||new.cod_empresa||'#39
        '    where produtos_ec.grupo_prod = '#39'||new.grupo_prod||'#39
        '    and produtos_ec.cod_prod = '#39#39#39'||new.cod_prod||'#39#39#39
        '    and produtos_ec.cod_empresa = '#39'||new.cod_empresa||'#39';'#39';'
        ''
        '  update produtos_ec_grade set'
        '    produtos_ec_grade.grupo_prod = new.grupo_prod,'
        '    produtos_ec_grade.cod_prod = new.cod_prod,'
        '    produtos_ec_grade.cod_empresa = new.cod_empresa'
        '  where produtos_ec_grade.grupo_prod = new.grupo_prod'
        '  and produtos_ec_grade.cod_prod = new.cod_prod'
        '  and produtos_ec_grade.cod_empresa = new.cod_empresa;'
        'end;'
        '|/BLOCO|'
        ''
        'delete from config_colunas where componente = '#39'cdsGrupos'#39';'
        'delete from config_colunas where componente = '#39'cdsSubGrupo'#39';'
        ''
