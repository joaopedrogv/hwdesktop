        '|BLOCO|'
        'CREATE OR ALTER VIEW DEVOLUCAO_TOT('
        '    TIPO,'
        '    TIPO_DEV,'
        '    NDEV,'
        '    DATA,'
        '    COD_CLIENTE,'
        '    COD_EMPRESA,'
        '    COD_VENDEDOR,'
        '    VALOR_DEV,'
        '    QUANT_DEV)'
        'AS'
        '  select '#39'DEV'#39' as tipo,'
        '  dev.tipo tipo_dev,'
        '  dev.sequencia,'
        '  dev.data,'
        '  dev.cod_cliente,'
        '  dev.cod_empresa,'
        
          '  (select first 1 devolucao.cod_vendedor from devolucao where de' +
          'volucao.sequencia = dev.sequencia and devolucao.cod_empresa = de' +
          'v.cod_empresa) cod_vendedor,'
        
          '  sum((-1) * case when (coalesce(dev.valor_tot, 0) > 0) then coa' +
          'lesce(dev.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0' +
          ') end) valor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        '  group by 1, 2, 3, 4, 5, 6;'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE CONTA_CORRENTE_PROG_FIDELIDADE ADD COD_CASHBACK INTE' +
          'GER;'
        ''
        
          'CREATE INDEX IDX_CCORRENTE_PROG_CASH ON CONTA_CORRENTE_PROG_FIDE' +
          'LIDADE (COD_CASHBACK,COD_EMPRESA);'
        ''
