          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'PRODUTOS'#39' and rdb$field_name' +
          ' = '#39'DESCR_PROD'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'CLIENTES'#39' and rdb$field_name' +
          ' = '#39'NOME_CLIENTE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$COLLATION_ID = 0 ' +
          'where RDB$FIELD_NAME = (select rdb$field_source from rdb$relatio' +
          'n_fields where rdb$relation_name = '#39'TIPO_FATURAMENTO'#39' and rdb$fi' +
          'eld_name = '#39'DESC_FAT'#39');'
