        'CREATE TABLE MENSAGEM_WHATSAPP ('
        '    ID           INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    FONE         VARCHAR(13) NOT NULL,'
        '    DATA         TIMESTAMP NOT NULL,'
        '    MENSAGEM     BLOB SUB_TYPE 1 SEGMENT SIZE 80,'
        '    ARQUIVO      SMALLINT,'
        '    NDOC         INTEGER,'
        '    TIPODOC      CHAR(3)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE MENSAGEM_WHATSAPP ADD CONSTRAINT PK_MENSAGEM_WHATSAP' +
          'P PRIMARY KEY (ID, COD_EMPRESA);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_PAGAMENTOS('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE,'
        '    DATA_LOTE,'
        '    PARCIAL,'
        '    RENEGOCIACAO)'
        'AS'
        'select l.cod_lanc,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else l.codigo_emp end codigo_emp,'
        '    l.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else l.codigo_emp end codigo_emp,'
        '    l.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    l.valor_l,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        '    c.nome_ctrl tipo_doc_c,'
        '    l.n_conta_plc,'
        '    l.lote,'
        '    l.data,'
        '    null parcial,'
        '    null renegociacao'
        '    from lancamentos l'
        '    left join empresa e on e.cod_empresa = l.codigo_emp'
        
          '    inner join controles c on c.codigo_ctrl = l.codigo_ctrl and ' +
          'c.codigo_emp = l.codigo_emp and docs = '#39'N'#39
        '    union all'
        '    select cc.codigo_ch,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else cc.codigo_emp end codigo_emp,'
        '    cc.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else cc.cod_emp_lote end cod_emp_lote,'
        '    cc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cc.valor_ch,'
        '    cc.nome_ch,'
        '    cc.status_ch,'
        '    cc.data_venc,'
        '    cc.historico_ch,'
        '    cc.n_ch,'
        '    cc.data_rec,'
        '    '#39'CHEQUE'#39' tipo_doc_c,'
        '    cc.n_conta_plc,'
        '    cc.lote,'
        '    cc.datq_ch,'
        '    null parcial,'
        '    null renegociacao'
        '    from controle_cheque cc'
        '    left join empresa e on e.cod_empresa = cc.codigo_emp'
        
          '    inner join controles c on c.codigo_ctrl = cc.codigo_ctrl and' +
          ' c.codigo_emp = cc.codigo_emp'
        '    union all'
        '    select cx.cod_cred,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else cx.codigo_emp end codigo_emp,'
        '    cx.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else cx.cod_emp_lote end cod_emp_lote,'
        '    cx.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    cx.valor_c,'
        '    cx.nome_c,'
        '    cx.status_c,'
        '    cx.data_venc_c,'
        '    cx.historico_c,'
        '    cx.n_doc_c,'
        '    cx.data_rec_c,'
        '    cx.tipo_doc_c,'
        '    cx.n_conta_plc,'
        '    cx.lote,'
        '    cx.datq_c,'
        '    null parcial,'
        '    null renegociacao'
        '    from controle_creditos cx'
        '    left join empresa e on e.cod_empresa = cx.codigo_emp'
        
          '    inner join controles c on c.codigo_ctrl = cx.codigo_ctrl and' +
          ' c.codigo_emp = cx.codigo_emp'
        '    union all'
        '    select bc.seq_bxcred,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else bc.codigo_emp end codigo_emp,'
        '    bc.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else bc.cod_emp_lote end cod_emp_lote,'
        '    bc.codigo_ctrl,'
        '    c.nome_ctrl,'
        '    bc.valor_quitado,'
        '    bc.nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    bc.data_venc_c,'
        '    bc.historico_c,'
        '    bc.n_doc_c,'
        '    bc.data_rec_c,'
        '    bc.tipo_doc_c,'
        '    0,'
        '    bc.lote,'
        '    bc.datq_c,'
        '    null parcial,'
        '    null renegociacao'
        '    from baixa_creditos bc'
        '    left join empresa e on e.cod_empresa = bc.codigo_emp'
        
          '    inner join controles c on c.codigo_ctrl = bc.codigo_ctrl and' +
          ' c.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '    union all'
        '    select ctp.cod_contrp,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else ctp.codigo_emp end codigo_emp,'
        '    ctp.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else ctp.codigo_emp end codigo_emp,'
        '    ctp.codigo_ctrl,'
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        '    coalesce(ctp.valor_ctp, 0),'
        '    ctp.nome_for_ctp,'
        '    '#39'QUITADO'#39' status,'
        '    ctp.data_venc_ctp,'
        '    ctp.historico_ctp,'
        '    ctp.n_doc_ctp,'
        '    ctp.data_ent_ctp,'
        '    '#39'CONTAS A PAGAR'#39' tipo_doc_c,'
        '    0,'
        '    ctp.lote_ent,'
        '    ctp.data_ent_ctp,'
        '    null parcial,'
        '    '#39'S'#39' renegociacao'
        '    from contas_a_pagar ctp'
        '    left join empresa e on e.cod_empresa = ctp.codigo_emp'
        '    union all'
        '    select ctp.cod_contrp,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else ctp.codigo_emp end codigo_emp,'
        '    ctp.cod_emp_mult,'
        
          '    case when (e.financeiro_unificado = '#39'S'#39') then e.codigo_unifi' +
          'cadora else ctp.codigo_emp end codigo_emp,'
        '    ctp.codigo_ctrl,'
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        '    coalesce(ctp.valor_ctp, 0),'
        '    ctp.nome_for_ctp,'
        '    '#39'QUITADO'#39' status,'
        '    ctp.data_venc_ctp,'
        '    ctp.historico_ctp,'
        '    ctp.n_doc_ctp,'
        '    ctp.data_ent_ctp,'
        '    '#39'CONTAS A PAGAR'#39' tipo_doc_c,'
        '    0,'
        '    ctp.lote_quit_parc,'
        '    ctp.data_ent_ctp,'
        '    '#39'S'#39' parcial,'
        '    null renegociacao'
        '    from contas_a_pagar ctp'
        '    left join empresa e on e.cod_empresa = ctp.codigo_emp;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_PAG_CTP ('
        '    PLOTE integer,'
        '    PDATA_LOTE timestamp,'
        '    PCOD_EMPRESA integer,'
        '    PVER_FORMAS integer,'
        '    PFORM_PAG varchar(200) character set WIN1252)'
        'returns ('
        '    ENCONTROU integer,'
        '    FORM_PAG varchar(200) character set WIN1252,'
        '    FORM_PAG2 varchar(200))'
        'as'
        'declare variable VTEMP varchar(200);'
        'declare variable VTEMP2 varchar(200);'
        'declare variable VCONTROLE varchar(35);'
        'declare variable VVALOR double precision;'
        'begin'
        '  /* Procedure Text */'
        '  encontrou = 0;'
        '  form_pag = '#39#39';'
        '  form_pag2 = '#39#39';'
        ''
        '  if (coalesce(pver_formas, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (trim(coalesce(pform_pag, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_uni' +
          'ficadora, det.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, :pcod_empresa)'
        '        and det.lote = :plote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          ':pdata_lote, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp2, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39')) ||'
        
          '                '#39' (R$'#39' || trim(cast(cast(vvalor as numeric(12, 2' +
          ')) as varchar(24))) || '#39')'#39';'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = trim(substring(trim(vtemp) from 1 for 200));'
        '    else'
        '      form_pag = trim(vtemp);'
        ''
        '    if (character_length(vtemp2) > 200) then'
        '      form_pag2 = trim(substring(trim(vtemp2) from 1 for 200));'
        '    else'
        '      form_pag2 = trim(vtemp2);'
        '    suspend;'
        '  end'
        '  else'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        '        and det.nome_ctrl like :pform_pag'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp2, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39')) ||'
        
          '                '#39' (R$'#39' || trim(cast(cast(vvalor as numeric(12, 2' +
          ')) as varchar(24))) || '#39')'#39';'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = trim(substring(trim(vtemp) from 1 for 200));'
        '    else'
        '      form_pag = trim(vtemp);'
        ''
        '    if (character_length(vtemp2) > 200) then'
        '      form_pag2 = trim(substring(trim(vtemp2) from 1 for 200));'
        '    else'
        '      form_pag2 = trim(vtemp2);'
        ''
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CONTRP,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST,'
        '    QTDE_PREST_EMP,'
        '    VALOR_PREST_EMP,'
        '    VALOR_PREST_TOT,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.n_doc_ctp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.n_doc_ctp, 0), 0) as Num_doc' +
          '2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.datq_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        
          '                          left join empresa e on cp.codigo_emp =' +
          ' e.cod_empresa'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and (case when(e.financeiro_unificado ' +
          '= '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end)) = 0) th' +
          'en'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                        (case when(e.financeiro_unificado = '#39'S'#39')' +
          ' then e.codigo_unificadora else ctp.codigo_emp end))'
        '              end),'
        '    1) qtde_prest,'
        ''
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.codig' +
          'o_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.cod' +
          'igo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) =' +
          ' ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        '    inner join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult, coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.cod_contrp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.cod_contrp, 0), 0) as Num_do' +
          'c2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.data_ent_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        
          '                          left join empresa e on cp.codigo_emp =' +
          ' e.cod_empresa'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and (case when(e.financeiro_unificado ' +
          '= '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end)) = 0) th' +
          'en'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                        (case when(e.financeiro_unificado = '#39'S'#39')' +
          ' then e.codigo_unificadora else ctp.codigo_emp end))'
        '              end),'
        '    1) qtde_prest,'
        ''
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.codig' +
          'o_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.cod' +
          'igo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) =' +
          ' ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        '    left join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR_PAGO,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.datq_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                                    (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        '    inner join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.cod_emp_mult,'
        '    ctp.data_ent_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                                    (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        '    left join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CRED,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DAS VENDAS (REQUISICAO, ORDEM DE S' +
          'ERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (CREDITOS/CHE' +
          'QUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '    --- REQ, OS'
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'DIRETO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebi' +
          'mento2,'
        
          '    1 ordem, 0 cod_tipo, rq.tipo, 0 cod_cred, coalesce(rq.nped, ' +
          '0) as Num_doc, coalesce(fp.ndoc, coalesce(rq.nped, 0), 0) Num_do' +
          'c2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = rq.nped and f' +
          'p.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.re' +
          'cibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'RECIBO'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico,  coalesce(fp.valordoc, 0) valordo' +
          'c,'
        '    fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '        (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = rq.nped and ' +
          'fp.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not' +
          ' fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        '    rq.cod_empresa,'
        
          '    coalesce(rq.cod_cliente, 0) cod_cliente, cl.nome_cliente, cl' +
          '.cpfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'TROCO'#39' tp_recebimento, '#39'TROCO'#39' tp_recebime' +
          'nto2, 1 ordem, 0 cod_tipo, rq.tipo,'
        
          '    0 cod_cred, coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndo' +
          'c, coalesce(rq.nped, 0), 0) Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, rq.obs_cxl_rq, rq.nped as loterec,'
        '    coalesce(rq.op_cxl, 0) op_cxl, rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ',  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rq.nped and ' +
          'fp.rec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and' +
          ' fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        '    '
        '    union'
        '    '
        '    --- CF'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'DIRETO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando), coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = mt.n_comando ' +
          'and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and f' +
          'p.recibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'RECIBO'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebi' +
          'mento2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ','
        '    fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        0'
        '    else'
        '       (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '       inner join formpagamento rc on rc.cod_controle = ctrl.cod' +
          'igo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '       where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa ' +
          '= fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        '#39'SEM FORMA'#39
        '    else'
        '       (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordo' +
          'c asc)'
        '    end as  nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = mt.n_comando' +
          ' and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (' +
          'not fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        '    '
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        '    mt.cod_empresa,'
        
          '    coalesce(mt.clientes_v, 0) clientes_v, cl.nome_cliente, cl.c' +
          'pfcgc,'
        
          '    '#39'SAIDAS'#39' tp_rel, '#39'TROCO'#39' tp_recebimento, '#39'TROCO'#39' tp_recebime' +
          'nto2, 1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo,'
        
          '    0 cod_cred, coalesce(mt.n_comando, 0) as Num_doc, coalesce(f' +
          'p.ndoc, coalesce(mt.n_comando, 0), 0) Num_doc2, mt.data_ven as D' +
          'ata_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, '#39' '#39' as obs_cxl_rq, mt.n_comando as loterec,'
        '    coalesce(mt.op_cxl, 0) op_cxl, mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 1 qtde_prest from com_fat mt'
        '    left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = mt.n_comando' +
          ' and fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa ' +
          'and fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    -- Cred'
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc,'
        '    '#39'CREDIARIO'#39' tp_rel, '#39'CREDIARIO'#39' tp_recebimento,'
        '    coalesce((case'
        
          '        when (((select count(*) from hist_rec hist where hist.lo' +
          'te_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_emp) > 0' +
          ')'
        
          '            and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39') or' +
          ' (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                '#39'RECIBO'#39
        '        when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                '#39'DEVOLUCAO'#39
        '        else'
        '                '#39'DIRETO'#39
        '        end),'
        '    '#39'DIRETO'#39') tp_recebimento2, 3 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
        
          '    coalesce(pr.seq_bxcred, 0) cod_cred, coalesce(pr.n_doc_c, 0)' +
          ' Num_doc, coalesce(l.ndoc_l, coalesce(pr.n_doc_c, 0)) Num_doc2, ' +
          'pr.data_venc_c as Data_Doc,'
        '    pr.datq_c as Data_Conf,'
        
          '    coalesce(pr.valor_quitado, 0) as valor_total, '#39' '#39' as obs_cxl' +
          '_rq, coalesce(pr.lote_quit, pr.seq_bxcred) as loterec,'
        
          '    coalesce(pr.op_cxl, 0) op_cxl, pr.codigo_vend, l.data, l.his' +
          'torico_l,'
        ''
        '    case when(l.tipo_l = '#39'S'#39') then'
        '           (coalesce(l.valor_l, 0) * -1)'
        '         else'
        '           case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                  case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' the' +
          'n'
        '                        coalesce(pr.valor_quitado, 0)'
        '                       else'
        '                         coalesce(l.valor_l, 0)'
        '                  end'
        '                else'
        '                  coalesce(l.valor_l, 0)'
        '           end'
        '    end valor_pago,'
        ''
        '    l.data, '#39' '#39' terceiros,'
        ''
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            0'
        '                          else'
        
          '                            case when (ctr.codigo_ctrl is null) ' +
          'then 0 else ctr.codigo_ctrl end'
        '                     end'
        '                   else'
        '                     case when ctr.codigo_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        
          '                                   case when (ctr1.codigo_ctrl i' +
          's null) then 0 else ctr1.codigo_ctrl end'
        '                                 else'
        '                                   0'
        '                            end'
        '                          else'
        '                            ctr.codigo_ctrl'
        '                     end'
        '              end),'
        '    0) codigo_ctrl,'
        '    '
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            '#39'SEM FORMA'#39
        '                          else'
        
          '                            case when (ctr.nome_ctrl is null) th' +
          'en 0 else ctr.nome_ctrl end'
        '                     end'
        '                   else'
        '                     case when ctr.nome_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        
          '                                   case when (ctr1.nome_ctrl is ' +
          'null) then 0 else ctr1.nome_ctrl end'
        '                                 else'
        '                                   '#39'SEM FORMA'#39
        '                            end'
        '                          else'
        '                            ctr.nome_ctrl'
        '                     end'
        '              end),'
        '    '#39'SEM FORMA'#39') nome_ctrl,'
        ''
        '    0 as num_recibo, 0 as valor_recibo,'
        ''
        '    coalesce(('
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '            0'
        '         else'
        
          '            (select coalesce(pd.num_nfce, 0) from pedvenda pd   ' +
          '     '
        
          '             where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_' +
          'v and pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) ncupom,'
        ''
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '        (select coalesce(cf.num_nota_v, 0) from com_fat cf'
        
          '        where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.' +
          'codigo_emp)'
        '    else'
        '        (select coalesce(pd.num_nf, 0) from pedvenda pd'
        
          '        where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and' +
          ' pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) num_nf,'
        ''
        ''
        
          '    case when(cc.cod_cred > 0) then coalesce(cc.nparcela, 0) els' +
          'e 0 end nparcela, pr.seq_bxcred, coalesce(l.cod_lanc, pr.seq_bxc' +
          'red),'
        ''
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select coalesce(tp.venda, '#39'S'#39') venda from com_fat cf left j' +
          'oin tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        
          '    else (select coalesce(tp.venda, '#39'S'#39') venda from pedvenda pd ' +
          'left join tipo_vendas tp on tp.tipo = pd.tipo and (tp.sigla = pd' +
          '.tipv or (tp.tipo_os = pd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end), '#39'S'#39') venda,'
        ''
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select tp.tipo_os from com_fat cf left join tipo_vendas tp ' +
          'on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        '    when(trim(pr.tp_doc_v) = '#39'OS'#39') then'
        
          '    (select tp.tipo_os from pedvenda pd left join tipo_vendas tp' +
          ' on tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = p' +
          'd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    else'
        
          '    (select tp.sigla from pedvenda pd left join tipo_vendas tp o' +
          'n tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = pd.' +
          'tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end tipv,'
        '    pr.tp_doc_v as tipo_doc,'
        '    coalesce((case when ((select count(*) from baixa_creditos bc'
        '                          where bc.lote_quit = pr.lote_quit'
        
          '                          and bc.datq_c = iif(emp.financeiro_uni' +
          'ficado = '#39'S'#39', pr.datq_c, bc.datq_c)'
        
          '                          and iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, bc.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '        1'
        '    else'
        '        (select count(*) from baixa_creditos bc'
        '         where bc.lote_quit = pr.lote_quit'
        
          '         and bc.datq_c = iif(emp.financeiro_unificado = '#39'S'#39', pr.' +
          'datq_c, bc.datq_c)'
        
          '         and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unif' +
          'icadora, bc.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', em' +
          'p.codigo_unificadora, pr.codigo_emp))'
        '    end), 1) qtde_prest'
        ''
        '    from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.cod_emp_mult'
        
          '    left join controle_creditos cc on cc.cod_cred = pr.cod_cred ' +
          'and cc.codigo_emp = pr.codigo_emp'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_c'
        '        and l.tipo_l = '#39'E'#39
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl a' +
