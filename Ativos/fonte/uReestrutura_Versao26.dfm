          '1'#39' AND BARRAMENTO_AUTOMATICO IS NULL;'
        
          'UPDATE CONTROLES SET BARRAMENTO_AUTOMATICO = '#39'N'#39' WHERE DOCS = '#39'S' +
          '2'#39' AND BARRAMENTO_AUTOMATICO IS NULL AND COALESCE(TP_PLANO, '#39#39') ' +
          '= '#39'C'#39';'
        
          'UPDATE CONTROLES SET BARRAMENTO_AUTOMATICO = '#39'S'#39' WHERE DOCS = '#39'S' +
          '2'#39' AND BARRAMENTO_AUTOMATICO IS NULL AND COALESCE(TP_PLANO, '#39#39') ' +
          '<> '#39'C'#39';'
