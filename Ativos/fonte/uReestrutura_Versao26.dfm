        ''
        'ALTER TABLE CLIENTES ADD RET_FED_NFS SMALLINT;'
        
          'CREATE INDEX IDX_PEDV_SERV_RPSEMISS ON PEDVENDA_SERV (TIPO, EMIS' +
          'SAO_RPS);'
        ''
        
          'ALTER TABLE PEDVENDA_PROD ADD CALC_COMISSAO_CONDPAG_VEND CHAR(1)' +
          ';'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'PRO452'#39', :COD_EMPRESA, '#39'ALTERAR DADOS PRODUTOS VIA AR' +
          'QUIVO'#39', 100, '#39'S'#39', '#39'S'#39');'
        ''
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_CONDPAG T_N_GERAL;'
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_VEND3 T_N_GERAL;'
        ''
        'ALTER TABLE DEVOLUCAO ADD PERC_COMISSAO_CONDPAG T_N_GERAL;'
        'ALTER TABLE DEVOLUCAO ADD PERC_COMISSAO_VEND3 T_N_GERAL;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PROD_SERV_EMVENDAS_AC_PAG_VND('
        '    COD_EMPRESA,'
        '    DATA_FECH,'
        '    NPED,'
        '    TIPO,'
        '    NITEM,'
        '    PROD_SERV,'
        '    GRUPOP_CODSERV,'
        '    COD_PROD,'
        '    QUANT_PED_ITEM,'
        '    VLUN_PED_ITEM,'
        '    VLTOT_PED_ITEM,'
        '    VALOR_TOTAL_LIQUIDO,'
        '    VALOR_TOTAL_BRUTO,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PCUST_MC,'
        '    DESCR_ITEM_PED,'
        '    COMISS_PROD,'
        '    COMISS_PROD_GER,'
        '    N_NF,'
        '    DESCRICAO,'
        '    SIGLA,'
        '    TIPO_OS,'
        '    NOME_VENDEDOR,'
        '    COD_VENDEDOR,'
        '    COL_COD_VENDEDOR,'
        '    PC_VEND_SERV,'
        '    PC_VEND_PROD,'
        '    COD_FUNCAO,'
        '    DESC_FUNCAO,'
        '    VENDA,'
        '    QTDE_PROD,'
        '    QTDE_SERV)'
        'AS'
        
          'select v.cod_empresa,  v.data_fech, pp.nped,pp.tipo,pp.nitem,'#39'P'#39 +
          ' as prod_serv,'
        'pp.grupo_prod,pp.cod_prod,'
        'coalesce(pp.quant_ped_item,0) as quant_ped_item,'
        'coalesce(pp.vlun_ped_item,0) as vlun_ped_item,'
        'coalesce(pp.vltot_ped_item,0) as vltot_ped_item,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(pp.rateio_desc,0) as rateio_desc,'
        'coalesce(pp.rateio_acresc,0) as rateio_acresc,'
        'coalesce(pp.pcust_mc,0) as pcust_mc,'
        'pp.descr_prod_ped,'
        'case when (coalesce(pp.perc_comissao_vend3, 0) > 0) then'
        
          '       ((coalesce(pp.vltot_ped_item, 0) / 100) * coalesce(pp.per' +
          'c_comissao_vend3, 0))'
        '     else'
        '       0'
        'end comiss_prod,'
        '0 as comiss_prod_ger,'
        'coalesce(pp.n_nf,0) as n_nf,'
        'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,'
        
          'pp.col_cod_vendedor,c.pc_vend_serv, c.PC_VEND_PROD,f.cod_funcao,' +
          'f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_prod pp on v.tipo = pp.tipo and v.nped = pp.' +
          'nped and v.cod_empresa = pp.cod_empresa'
        'inner join grupos g on pp.grupo_prod = g.codigo_grup'
        
          'inner join colaborador c on pp.cod_vendedor = c.cod_vendedor and' +
          ' pp.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        'where v.status_ped = '#39'FECHADA'#39
        'and v.ativo = 1'
        'and (pp.status <> '#39'CANCELADO'#39' or (pp.status is null))'
        'union'
        
          'select v.cod_empresa,  v.data_fech, ps.nped,ps.tipo,ps.nitem,'#39'S'#39 +
          ' as prod_serv,'
        'ps.cod_servico,'#39'      '#39','
        'coalesce(ps.quant_serv_ped,0) as quant_serv_ped,'
        
          '(case when ps.valor_un_serv=0 then ps.prc_int_serv else ps.valor' +
          '_un_serv end) as valor_un_serv,'
        'coalesce(ps.valor_tot_serv,0) as valor_tot_serv,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(ps.rateio_desc,0) as rateio_desc,'
        'coalesce(ps.rateio_acresc,0) as rateio_acresc,0,'
        'ps.desc_serv_ped,0,0,'
        'coalesce(ps.n_nf,0) as n_nf,'
        
          'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,' +
          'c.cod_vendedor,'
        'c.pc_vend_serv, c.PC_VEND_PROD,'
        'f.cod_funcao,f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_serv ps on v.tipo = ps.tipo and v.nped = ps.' +
          'nped and v.cod_empresa = ps.cod_empresa'
        
          'inner join colaborador c on ps.cod_vendedor = c.cod_vendedor and' +
          ' ps.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        
          'where v.status_ped='#39'FECHADA'#39' and v.ativo = 1 and (ps.status <> '#39 +
          'CANCELADO'#39' or (ps.status is null));'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VENDAPRODUTOS_AC_PAG_VND('
        '    COD_EMPRESA,'
        '    DATA_FECH,'
        '    NPED,'
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_GRADE,'
        '    QUANT_PED_ITEM,'
        '    VLUN_ORIG,'
        '    VLUN_PED_ITEM,'
        '    VLTOT_PED_ITEM,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    DESCR_PROD_PED,'
        '    PCUST_MC,'
        '    COMISS_PROD,'
        '    COMISS_PROD_GER,'
        '    N_NF,'
        '    DESCRICAO_TIPV,'
        '    TIPV,'
        '    TIPO_OS,'
        '    DESCRICAO_GRUPO,'
        '    NOME_VENDEDOR,'
        '    NOME_PARTICIPANTE,'
        '    COD_VENDEDOR,'
        '    COD_PARTICIPANTE,'
        '    COL_COD_VENDEDOR,'
        '    COD_FUNCAO,'
        '    DESC_FUNCAO,'
        '    NITEM,'
        '    VENDA,'
        '    NOME_CLIENTEDAV,'
        '    DEV_NPED,'
        '    DEV_TIPO,'
        '    COD_CIDADE,'
        '    NOME_CIDADE)'
        'AS'
        'select v.cod_empresa,v.data_fech,'
        'pp.nped,pp.tipo, pp.grupo_prod,pp.cod_prod,pp.cod_grade,'
        'coalesce(pp.quant_ped_item,0) as quant_ped_item,'
        'coalesce(pp.vlun_orig, 0) as vlun_orig,'
        'coalesce(pp.vlun_ped_item,0) as vlun_ped_item,'
        'coalesce(pp.vltot_ped_item,0) as vltot_ped_item,'
        'coalesce(pp.rateio_desc,0) as rateio_desc,'
        'coalesce(pp.rateio_acresc,0) as rateio_acresc,'
        'pp.descr_prod_ped,'
        'coalesce(pp.pcust_mc,0) as pcust_mc,'
        'case when (coalesce(pp.perc_comissao_vend3, 0) > 0) then'
        
          '       ((coalesce(pp.vltot_ped_item, 0) / 100) * coalesce(pp.per' +
          'c_comissao_vend3, 0))'
        '     else'
        '       0'
        'end comiss_prod,'
        '0 as comiss_prod_ger,'
        'coalesce(pp.n_nf,0) as n_nf,'
        'tv.descricao,tv.sigla,tv.tipo_os, g.descricao,'
        
          'c.nome_vendedor, p.nome_participante,c.cod_vendedor, p.cod_parti' +
          'cipante, pp.col_cod_vendedor, f.cod_funcao,f.desc_funcao,'
        
          'pp.nitem,tv.venda,v.nome_clientedav,v.nped,v.tipo, cl.cod_cidade' +
          ', cd.nome_cidade from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo=tv.tipo and (v.tipv=tv.sigla or ' +
          '(v.tipo_os=tv.tipo_os))'
        
          'inner join pedvenda_prod pp on v.tipo=pp.tipo and v.nped=pp.nped' +
          ' and v.cod_empresa=pp.cod_empresa'
        'inner join grupos g on pp.grupo_prod=g.codigo_grup'
        
          'inner join colaborador c on pp.cod_vendedor=c.cod_vendedor and p' +
          'p.cod_empresa=c.cod_empresa'
        
          'left join participante p on pp.cod_vendedor1 = p.cod_participant' +
          'e and pp.cod_empresa = p.cod_empresa'
        'inner join funcoes f on c.cod_funcao=f.cod_funcao'
        
          'left join clientes cl on cl.cod_cliente = v.cod_cliente and cl.c' +
          'od_empresa = v.cod_cliente'
        'left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        
          'where v.status_ped='#39'FECHADA'#39' and v.ativo=1 and (pp.status<>'#39'CANC' +
          'ELADO'#39' or (pp.status is null))'
        'union'
        'select d.cod_empresa,d.data,'
        'd.sequencia,'#39'DEV'#39' as tipo,d.grupo_prod,d.cod_prod,d.cod_grade,'
        'd.quant as quant_ped_item,'
        '((-1)*coalesce(d.valor_orig, 0)) as valor_orig,'
        '((-1)*coalesce(d.valor, 0)) as valor,'
        
          '((-1)*(coalesce(d.quant, 0)*coalesce(d.valor, 0))) as vltot_ped_' +
          'item,'
        '0 as rateio_desc,'
        '0 as rateio_acresc,'
        'substr(d.descricao,1,60) as descr_prod_ped,'
        '((-1)*coalesce(d.pcust_mc, 0)) as pcust_mc,'
        'case when (coalesce(d.cod_venda, 0) <= 0) then'
        '       0'
        
          '     when ((coalesce(d.tipo_venda, '#39#39') <> '#39'REQ'#39') and (coalesce(d' +
          '.tipo_venda, '#39#39') <> '#39'OS'#39')) then'
        '       0'
        
          '     when ((coalesce(d.valor_orig, 0) > 0) and (coalesce(d.perc_' +
          'comissao_vend3, 0) > 0)) then'
        
          '       ((((-1) * (coalesce(d.valor_orig, 0) * coalesce(d.quant, ' +
          '0))) / 100) * coalesce(d.perc_comissao_vend3, 0))'
        '     when (coalesce(vp.perc_comissao_vend3, 0) > 0) then'
        
          '       ((((-1)*(coalesce(d.quant, 0)*coalesce(vp.vltot_ped_item,' +
          ' 0))) / 100) * coalesce(vp.perc_comissao_vend3, 0))'
        '     else'
        '       0'
        'end comiss_prod,'
        '0 as comiss_prod_ger,'
        'num_nota_nfe,'
        
          'case when tv.descricao is null then '#39'V - VAREJO          '#39' else ' +
          'tv.descricao end as descricao,'
        'case when tv.sigla is null then '#39'V'#39' else tv.sigla end as sigla,'
        'tv.tipo_os,g.descricao,c.nome_vendedor, null nome_participante,'
        
          'c.cod_vendedor, null cod_participante,c.cod_vendedor,f.cod_funca' +
          'o,f.desc_funcao,'
        
          'd.seqid,coalesce(tv.venda,'#39'S'#39'),d.nome_cliente,d.cod_venda,d.tipo' +
          '_venda, cl.cod_cidade, cd.nome_cidade'
        'from devolucao d'
        
          'inner join colaborador c on d.cod_vendedor = c.cod_vendedor and ' +
          'd.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        'inner join grupos g on d.grupo_prod = g.codigo_grup'
        
          'left join pedvenda v on d.tipo_venda = v.tipo and coalesce(d.cod' +
          '_venda,0) = v.nped and d.cod_empresa = v.cod_empresa'
        'left join pedvenda_prod vp on'
        '  vp.nped = d.cod_venda'
        '  and vp.tipo = d.tipo_venda'
        '  and vp.grupo_prod = d.grupo_prod'
        '  and vp.cod_prod = d.cod_prod'
        '  and vp.cod_empresa = d.cod_empresa'
        '  and vp.cod_grade = d.cod_grade'
        
          'left join clientes cl on cl.cod_cliente = d.cod_cliente and cl.c' +
          'od_empresa = d.cod_cliente'
        'left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        
          'left join tipo_vendas tv on v.tipo = tv.tipo and (v.tipv=tv.sigl' +
          'a or (v.tipo_os=tv.tipo_os));'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPDB_FIELDS_SCHEMA ('
        '    TABELA char(31))'
        'returns ('
        '    FIELDNAME varchar(31),'
        '    DBTYPE varchar(6),'
        '    DBSUBTYPE smallint,'
        '    FIELDTYPE integer,'
        '    FIELDSIZE bigint,'
        '    FIELDPRECISION smallint,'
        '    FIELDSCALE smallint,'
        '    FIELDPOSITION smallint,'
        '    ISPK integer,'
        '    ISFK integer,'
        '    HASDEFAULT integer,'
        '    ISNULLABLE integer,'
        '    ISCOMPUTED integer,'
        '    FIELDTYPETEXT char(8))'
        'as'
        'begin'
        '  TABELA = upper(trim(TABELA));'
        
          '  for select distinct T.FIELDNAME, T.DBTYPE, T.DBSUBTYPE, T.FIEL' +
          'DTYPE, T.FIELDSIZE,'
        
          '                      iif(T.FIELDTYPE in (5, 6), T.FIELDPRECISIO' +
          'N, null) FIELDPRECISION,'
        
          '                      iif(T.FIELDTYPE in (5, 6), T.FIELDSCALE, n' +
          'ull) FIELDSCALE, T.FIELDPOSITION,'
        
          '                      iif(T.FIELDNAME = PK.FIELDNAME, 1, 0) ISPK' +
          ', iif(T.FIELDNAME = FK.FIELDNAME, 1, 0) ISFK,'
        '                      T.HASDEFAULT, T.ISNULLABLE, T.ISCOMPUTED,'
        '                      case T.FIELDTYPE'
        '                        when 1 then '#39'Boolean'#39
        '                        when 2 then '#39'Smallint'#39
        '                        when 3 then '#39'Integer'#39
        '                        when 4 then '#39'Bigint'#39
        '                        when 5 then '#39'Numeric'#39
        '                        when 6 then '#39'Decimal'#39
        '                        when 7 then '#39'Float'#39
        '                        when 8 then '#39'Double'#39
        '                        when 9 then '#39'Char'#39
        '                        when 10 then '#39'Varchar'#39
        '                        when 11 then '#39'Text'#39
        '                        when 12 then '#39'Datetime'#39
        '                        when 13 then '#39'Date'#39
        '                        when 14 then '#39'Time'#39
        '                        when 15 then '#39'Strings'#39
        '                        when 16 then '#39'Binary'#39
        '                        else '#39'Unknow'#39
        '                      end as FIELDTYPETEXT'
        
          '      from (select trim(RF.RDB$FIELD_NAME) FIELDNAME, trim(F.RDB' +
          '$FIELD_TYPE) DBTYPE, F.RDB$FIELD_SUB_TYPE DBSUBTYPE,'
        '                   case F.RDB$FIELD_TYPE'
        
          '                   --TFieldTypeSchemaDB = (fsUnknow = 0, fsBoole' +
          'an = 1, fsSmallInt = 2, fsInteger = 3, fsBigint = 4, -- fsNumeri' +
          'c = 5, fsDecimal = 6, fsFloat = 7, fsDouble = 8,'
        
          '                   -- fsChar = 9, fsVarchar = 10, fsText = 11, f' +
          'sDateTime = 12, fsDate = 13, fsTime = 14, fsStrings = 15, fsBina' +
          'ry = 16);'
        '                     when 7 then case F.RDB$FIELD_SUB_TYPE'
        '                                   when 0 then 2 --'#39'SMALLINT'#39
        '                                   when 1 then 5 --'#39'NUMERIC'#39
        '                                   when 2 then 6 --'#39'DECIMAL'#39
        '                                   else 0'
        '                                 end'
        '                     when 8 then case F.RDB$FIELD_SUB_TYPE'
        '                                   when 0 then 3 --'#39'INTEGER'#39
        '                                   when 1 then 5 --'#39'NUMERIC'#39
        '                                   when 2 then 6 --'#39'DECIMAL'#39
        '                                   else 0'
        '                                 end'
        '                     when 10 then 7 --'#39'FLOAT'#39
        '                     when 12 then 13 --'#39'DATE'#39
        '                     when 13 then 14 --'#39'TIME'#39
        '                     when 14 then 9 --'#39'CHAR'#39
        '                     when 16 then case F.RDB$FIELD_SUB_TYPE'
        '                                    when 0 then 4 --'#39'BIGINT'#39
        '                                    when 1 then 5 --'#39'NUMERIC'#39
        '                                    when 2 then 6 --'#39'DECIMAL'#39
        '                                    else 0'
        '                                  end'
        '                     when 27 then 8 --'#39'DOUBLE'#39
        '                     when 35 then 12 -- '#39'TIMESTAMP'#39
        '                     when 37 then 10 --'#39'VARCHAR'#39
        '                     when 261 then case F.RDB$FIELD_SUB_TYPE'
        
          '                                     when 0 then 16 --'#39'BLOB BINA' +
          'RY'#39
        
          '                                     when 1 then 15 --'#39'BLOB TEXT' +
          #39
        '                                     else 0'
        '                                   end'
        '                     else 0'
        '                   end FIELDTYPE,'
        
          '                   trunc(F.RDB$FIELD_LENGTH / CH.RDB$BYTES_PER_C' +
          'HARACTER * iif(F.RDB$FIELD_TYPE in (14, 37), 1, null)) FIELDSIZE' +
          ', -- 14 char e 37 varchar somente, resto fica null'
        
          '                   F.RDB$FIELD_PRECISION FIELDPRECISION, F.RDB$F' +
          'IELD_SCALE FIELDSCALE,'
        
          '                   RF.RDB$FIELD_POSITION FIELDPOSITION, iif(RF.R' +
          'DB$DEFAULT_VALUE is null, 0, 1) HASDEFAULT,'
        
          '                   iif(RF.RDB$NULL_FLAG = 1, 0, 1) ISNULLABLE, i' +
          'if(F.RDB$COMPUTED_SOURCE is not null, 1, 0) ISCOMPUTED'
        '            from RDB$RELATION_FIELDS RF'
        
          '              join RDB$FIELDS F on (F.RDB$FIELD_NAME = RF.RDB$FI' +
          'ELD_SOURCE)'
        
          '              left outer join RDB$CHARACTER_SETS CH on (CH.RDB$C' +
          'HARACTER_SET_ID = F.RDB$CHARACTER_SET_ID)'
        '            where (RF.RDB$RELATION_NAME = :TABELA) and'
        '                  (coalesce(RF.RDB$SYSTEM_FLAG, 0) = 0)'
        '            order by RF.RDB$FIELD_POSITION) as T'
        '        left join(select FIELDNAME'
        
          '                  from SPDB_FIELDS_PK(:TABELA)) PK on PK.FIELDNA' +
          'ME = T.FIELDNAME'
        '        left join(select FIELDNAME'
        
          '                  from SPDB_FIELDS_FK(:TABELA)) FK on FK.FIELDNA' +
          'ME = T.FIELDNAME'
        '      order by T.FIELDPOSITION'
        
          '        into :FIELDNAME, :DBTYPE, :DBSUBTYPE, :FIELDTYPE, :FIELD' +
          'SIZE, :FIELDPRECISION, :FIELDSCALE, :FIELDPOSITION,'
        
          '             :ISPK, :ISFK, :HASDEFAULT, :ISNULLABLE, :ISCOMPUTED' +
          ', :FIELDTYPETEXT'
        '  do'
        '  begin'
        '    suspend;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    ORDEM2,'
        '    NUMDOC,'
        '    TIPO,'
        '    TIPO2,'
        '    VALORDOC,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    FORMPAG,'
        '    VALOR_PAGO,'
        '    VALORRATEIO,'
        '    VALOR_PAGO_VISTA,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DETALHADOS DAS VENDAS (REQUISICAO,' +
          ' ORDEM DE SERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (C' +
          'REDITOS/CHEQUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '--- REQ, OS'
        
          'select '#39'DIRETO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 en' +
          'd ordem2, rq.nped, rq.tipo, rq.tipo, coalesce(rq.valor_total, 0)' +
          ' valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        ''
        'fp.data_mov, fp.data_venc,'
        'coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nped and fp.tp' +
          'docs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.recibo' +
          ' is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        
          'select '#39'RECIBO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 en' +
          'd ordem2, rq.nped, rq.tipo, rq.tipo, coalesce(rq.valor_total, 0)' +
          ' valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as nome_ctrl,'
        #39'RECIBO'#39' formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        '0 valor_pago_vista,'
        
          'fp.data_mov, fp.data_venc, coalesce(fp.seqform, rq.nped), coales' +
          'ce(fp.seqform, rq.nped)'
        ''
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = rq.nped and fp.t' +
          'pdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not fp.' +
          'recibo is null)'
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        
          'select '#39'TROCO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 end' +
          ' ordem2, rq.nped, rq.tipo, rq.tipo, coalesce(rq.valor_total, 0) ' +
          'valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        
          'fp.data_mov, fp.data_venc, coalesce(fp.seqform, rq.nped), coales' +
          'ce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nped and fp.r' +
          'ec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.' +
          'tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        '--- CF'
        ''
        
          'select '#39'DIRETO'#39', 1, 1, mt.n_comando, '#39'MOT'#39',  '#39'MOT'#39', coalesce(mt.' +
          'valor_a_rec, 0) valor_a_rec,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = mt.n_comando and ' +
          'fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and fp.re' +
          'cibo is null'
        
          'inner join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl an' +
          'd fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        
          'select '#39'RECIBO'#39', 1, 1, mt.n_comando, '#39'MOT'#39',  '#39'MOT'#39', coalesce(mt.' +
          'valor_a_rec, 0) valor_a_rec,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as nome_ctrl,'
        #39'RECIBO'#39' formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        '0 valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = mt.n_comando and' +
          ' fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (not ' +
          'fp.recibo is null)'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        
          'select '#39'TROCO'#39', 1, 1, mt.n_comando, '#39'MOT'#39',  '#39'MOT'#39', coalesce(mt.v' +
          'alor_a_rec, 0) valor_a_rec,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando)'
        'from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = mt.n_comando and' +
          ' fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and ' +
          'fp.tpdocs = '#39'TRC'#39
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        '-- Cred'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                            and ((l.historico_l like '#39'%RECIBOS A' +
          'TENCIPADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) ' +
          'then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
        '                        '#39'DIRETO'#39
        'end), '#39'DIRETO'#39'),'
        
          '3, 5, pr.seq_bxcred, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is n' +
          'ull) then pr.tipo_doc_c else ctr1.nome_ctrl end tipo2, coalesce(' +
          'pr.valor_quitado, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        0'
        '                      else'
        
          '                        case when (ctr.codigo_ctrl is null) then' +
          ' 0 else ctr.codigo_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.codigo_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.codigo_ctrl is nu' +
          'll) then 0 else ctr1.codigo_ctrl end'
        '                             else'
        '                               0'
        '                        end'
        '                      else'
        '                        ctr.codigo_ctrl'
        '                 end'
        '          end),'
        '0) codigo_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        
          '                        case when (ctr.nome_ctrl is null) then 0' +
          ' else ctr.nome_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.nome_ctrl is null' +
          ') then 0 else ctr1.nome_ctrl end'
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        '                        '#39'RECIBO'#39
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        '                               '#39'DEVOLUCAO'#39
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') formpag,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       case when (coalesce(l.valor_l, 0)) <= 0 then'
        '              case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                    coalesce(pr.valor_quitado, 0)'
        '                   else'
        '                     coalesce(l.valor_l, 0)'
        '              end'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        'end valor_pago,'
        ''
        'case when (coalesce((select count(*) from baixa_creditos pr1'
        '                    where pr1.lote_quit = pr.lote_quit and'
        '                    l.codigo_emp = pr.codigo_emp), 0) > 1) then'
        '       (case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                            coalesce(pr.valor_quitado, 0)'
        '                           else'
        '                             coalesce(l.valor_l, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '        end /'
        '        coalesce((select count(*) from baixa_creditos pr1'
        '                  where pr1.lote_quit = pr.lote_quit and'
        '                  l.codigo_emp = pr.codigo_emp), 0)'
        '       )'
        '     else'
        '        case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                            coalesce(pr.valor_quitado, 0)'
        '                           else'
        '                             coalesce(l.valor_l, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '        end'
        'end valorrateio,'
        'case when (((select count(*) from hist_rec hist'
        '             where hist.lote_quit = pr.lote_quit'
        '             and hist.cod_empresa = pr.codigo_emp) > 0)'
        
          '             and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39') o' +
          'r (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '       0'
        '     when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '       0'
        '     else'
        '       case when (ctr.docs = '#39'N'#39') then'
        '              case when(l.tipo_l = '#39'S'#39') then'
        '                     (coalesce(l.valor_l, 0) * -1)'
        '                   else'
        
          '                     case when (coalesce(l.valor_l, 0)) <= 0 the' +
          'n'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   coalesce(pr.valor_quitado, 0)'
        '                                 else'
        '                                   coalesce(l.valor_l, 0)'
        '                            end'
        '                          else'
        '                            coalesce(l.valor_l, 0)'
        '                     end'
        '              end'
        '            else'
        '              0'
        '       end'
        'end valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.seq_bxcred), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.datq_c and l.tipo_l = '#39'E'#39
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        
          'where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_c is not nul' +
          'l'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 5, pr.seq_bxcred, '#39'CREDIARIO'#39', case when (ct' +
          'r1.nome_ctrl is null) then pr.tipo_doc_c else ctr1.nome_ctrl end' +
          ' tipo2, coalesce(pr.valor_quitado, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        
          '999999 codigo_ctrl, '#39'CONTAS A PAGAR'#39' nome_ctrl, '#39'CONTAS A PAGAR'#39 +
          ' formpag,'
        'coalesce(pr.valor_quitado, 0) valor_pago,'
        'coalesce(pr.valor_quitado, 0) valorrateio,'
        '0 valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(pr.seq_bxcred, 0), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_c is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 5, pr.cod_cred, '#39'CREDIARIO'#39', case when (ctr1' +
          '.nome_ctrl is null) then '#39#39' else ctr1.nome_ctrl end tipo2, coale' +
          'sce(pr.valor_c, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec_c,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else coalesce(l.valor_l, 0)'
        'end valor_pago,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else coalesce(l.valor_l, 0)'
        'end valorrateio,'
        ''
        'case when (ctr.docs = '#39'N'#39') then'
        '       case when(l.tipo_l = '#39'S'#39') then'
        '              (coalesce(l.valor_l, 0) * -1)'
        '            else coalesce(l.valor_l, 0)'
        '       end'
        '     else'
        '       0'
        'end valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.cod_cred), 0'
        'from controle_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.data_rec_c'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                       and ((l.historico_l like '#39'%RECIBOS ATENCI' +
          'PADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
