          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nrecibo and fp' +
          '.tpdocs = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp.recib' +
          'o is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39
        ''
        'union all'
        ''
        
          'select '#39'TROCO'#39', 2, 4, rq.nrecibo, '#39'REC'#39', '#39'REC'#39', coalesce(rq.valo' +
          'r_orig, 0) as valor_total,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nrecibo and f' +
          'p.rec_tipvend = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp' +
          '.tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS('
        '    COD_EMPRESA,'
        '    COD_EMP_ORIG,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_REL,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CONTRP,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    QTDE_PREST,'
        '    QTDE_PREST_EMP,'
        '    VALOR_PREST_EMP,'
        '    VALOR_PREST_TOT,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.n_doc_ctp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.n_doc_ctp, 0), 0) as Num_doc' +
          '2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.datq_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        
          '                          left join empresa e on cp.codigo_emp =' +
          ' e.cod_empresa'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and (case when(e.financeiro_unificado ' +
          '= '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end)) = 0) th' +
          'en'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                        (case when(e.financeiro_unificado = '#39'S'#39')' +
          ' then e.codigo_unificadora else ctp.codigo_emp end))'
        '              end),'
        '    1) qtde_prest,'
        ''
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.codig' +
          'o_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.cod' +
          'igo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) =' +
          ' ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        '    inner join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    coalesce(ctp.cod_forn_nfe, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then ctp.nome_for_ctp el' +
          'se ctp.nome_for_ctp end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then ctp.cpf_cgc_f else cl.cpf' +
          'cgc end cpfcgc_cliente,'
        
          '    '#39'PAGAMENTOS'#39' tp_rel, '#39'PAGAMENTOS'#39' tp_recebimento, '#39'DIRETO'#39' t' +
          'p_recebimento2, 1 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then 0 else ctr1.codigo' +
          '_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo,'
        '    coalesce(ctp.cod_contrp, 0) as cod_contrp,'
        '    coalesce(ctp.cod_contrp, 0) as Num_doc,'
        
          '    coalesce(det.lote, coalesce(ctp.cod_contrp, 0), 0) as Num_do' +
          'c2,'
        '    ctp.data_venc_ctp as Data_Doc,'
        '    ctp.data_ent_ctp as Data_Conf,'
        
          '    iif(ctp.datq_ctp is not null, coalesce(ctp.valor_pago, 0), c' +
          'oalesce(ctp.valor_ctp, 0)) as valor_total,'
        '    '#39' '#39' as obs_cxl_rq,'
        '    coalesce(ctp.lote, ctp.cod_contrp) as loterec,'
        '    coalesce(ctp.op_cx, 0) op_cxl, 0 codigo_vend,'
        '    ctp.datq_ctp, ('#39'LOTE CTP '#39' || ctp.lote) historico_ctp,'
        '    coalesce(det.valor, 0) valor_pago,'
        '    ctp.datq_ctp, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo,'
        '    0 as valor_recibo,'
        '    0 ncupom,'
        '    0 num_nf,'
        '    0 parcela,'
        '    ctp.cod_contrp seqid,'
        '    coalesce(det.codigo, ctp.cod_contrp) seqid2,'
        '    '#39'N'#39' venda,'
        '    '#39#39' tipv,'
        '    ctp.tipo_ctp,'
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        
          '                          left join empresa e on cp.codigo_emp =' +
          ' e.cod_empresa'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and (case when(e.financeiro_unificado ' +
          '= '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end)) = 0) th' +
          'en'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                        (case when(e.financeiro_unificado = '#39'S'#39')' +
          ' then e.codigo_unificadora else ctp.codigo_emp end))'
        '              end),'
        '    1) qtde_prest,'
        ''
        '    coalesce((case when ((select count(*) from contas_a_pagar cp'
        '                          where cp.lote = ctp.lote'
        '                          and cp.datq_ctp = ctp.datq_ctp'
        
          '                          and ctp.cod_emp_mult = ctp.cod_emp_mul' +
          't) = 0) then'
        '                     1'
        '                   else'
        '                     (select count(*) from contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    1) qtde_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        '                      and cp.cod_emp_mult = ctp.cod_emp_mult)'
        '              end),'
        '    0) valor_prest_emp,'
        ''
        '    coalesce((case when (ctp.lote <= 0) then'
        '                     ctp.valor_ctp'
        '                   else'
        
          '                     (select sum(coalesce(cp.valor_pago, 0)) fro' +
          'm contas_a_pagar cp'
        
          '                      left join empresa e on cp.codigo_emp = e.c' +
          'od_empresa'
        '                      where cp.lote = ctp.lote'
        '                      and cp.datq_ctp = ctp.datq_ctp'
        
          '                      and (case when(e.financeiro_unificado = '#39'S' +
          #39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.codig' +
          'o_emp)'
        '              end),'
        '    0) valor_prest_tot,'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) = ctp.cod' +
          'igo_emp)'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) =' +
          ' ctp.codigo_emp)'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = ctp.cod_forn_nfe a' +
          'nd cl.cod_empresa = ctp.cod_emp_mult'
        '    left join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PAGAMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_ORIG,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR_PAGO,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2,'
        '    VALOR_PAGO_PROP)'
        'AS'
        '-- VIEW EXIBE OS PAGAMENTOS REALIZADOS'
        '-- RELATORIO "PAGAMENTO FINANCEIRO"'
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    ctp.datq_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                                    (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        '    inner join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is not null'
        ''
        '    union'
        ''
        '    select distinct '#39'DIRETO'#39', 1, '#39'PAGAMENTOS'#39','
        
          '    case when (ctr1.nome_ctrl is null) then '#39#39' else ctr1.nome_ct' +
          'rl end tipo2,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else ctp.codigo_emp end) cod_empresa,'
        '    ctp.codigo_emp,'
        '    ctp.cod_emp_mult,'
        '    ctp.data_ent_ctp,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    iif(ctp.datq_ctp is null, 0, coalesce(det.valor, 0)) valordo' +
          'c, det.data_rec, det.data_venc,'
        
          '    coalesce(det.codigo, ctp.cod_contrp), coalesce(det.codigo, c' +
          'tp.cod_contrp),'
        ''
        '    case when (coalesce((case when (ctp.lote <= 0) then'
        '                       ctp.valor_ctp'
        '                     else'
        
          '                       (select sum(coalesce(cp.valor_pago, 0)) f' +
          'rom contas_a_pagar cp'
        
          '                        left join empresa e on cp.codigo_emp = e' +
          '.cod_empresa'
        '                        where cp.lote = ctp.lote'
        '                        and cp.datq_ctp = ctp.datq_ctp'
        
          '                        and (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                            (case when(e.financeiro_unificado = ' +
          #39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                end), 0)) <= 0 then'
        '           0'
        '         else'
        '            ((coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and cp.cod_emp_mult = ctp.cod_em' +
          'p_mult)'
        '                        end), 0) /'
        '              coalesce((case when (ctp.lote <= 0) then'
        '                               ctp.valor_ctp'
        '                             else'
        
          '                               (select sum(coalesce(cp.valor_pag' +
          'o, 0)) from contas_a_pagar cp'
        
          '                                left join empresa e on cp.codigo' +
          '_emp = e.cod_empresa'
        '                                where cp.lote = ctp.lote'
        '                                and cp.datq_ctp = ctp.datq_ctp'
        
          '                                and (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else cp.codigo_emp end) ='
        
          '                                    (case when(e.financeiro_unif' +
          'icado = '#39'S'#39') then e.codigo_unificadora else ctp.codigo_emp end))'
        '                        end), 0)) *'
        '              coalesce(det.valor, 0) '
        '            )'
        '    end valor_pago_prop'
        ''
        '    from contas_a_pagar ctp'
        '    left join empresa emp on ctp.codigo_emp = emp.cod_empresa'
        '    left join det_pagamentos det on'
        
          '        iif(emp.financeiro_unificado = '#39'S'#39', det.cod_empresa, det' +
          '.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_' +
          'unificadora, det.cod_emp_lote)'
        '        and det.lote = ctp.lote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          'ctp.datq_ctp, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        
          '    left join controles ctr on ctr.codigo_ctrl = det.codigo_ctrl' +
          ' and ctr.codigo_emp = det.cod_empresa'
        
          '    left join controles ctr1 on ctr1.codigo_ctrl = ctp.codigo_ct' +
          'rl and ctr1.codigo_emp = ctp.codigo_emp'
        '    where ctp.datq_ctp is null;'
        '|/BLOCO|'
        ''
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_NEGATIVAR_DESNEGATIVAR_CL;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_NEG_DESNEG_CL_CRED;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_DESNEGATIVAR_CL;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_DESNEG_CL_CRED;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER TRIGGER TI_PEDVENDA_PROD_CONF FOR PEDVENDA_PROD'
        '|/BLOCO|'
        ''
        'CREATE SEQUENCE GEN_ITENS_CANC;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PEDVENDA_PROD_CONF FOR PEDVENDA_PROD'
        'ACTIVE BEFORE INSERT OR UPDATE OR DELETE POSITION 0'
        'AS'
        'DECLARE VARIABLE  vnped Integer;'
        'DECLARE VARIABLE  vtipo char(3);'
        'DECLARE VARIABLE  vcod_empresa Integer;'
        'DECLARE VARIABLE  vgrupo_prod Integer;'
        'DECLARE VARIABLE  vcod_prod char(6);'
        'DECLARE VARIABLE  vnitem Integer;'
        'DECLARE VARIABLE  vcod_grade Integer;'
        'DECLARE VARIABLE  vquantConf double precision default 00000.00;'
        'DECLARE VARIABLE  vquantVnd double precision default 00000.00;'
        
          'DECLARE VARIABLE  vquantConfTemp double precision default 00000.' +
          '00;'
        'DECLARE VARIABLE  vconfTp char(1);'
        'DECLARE VARIABLE  vconfProd char(1);'
        'DECLARE VARIABLE  vTipV char(1);'
        'DECLARE VARIABLE  vtotvenda float;'
        'DECLARE VARIABLE  vtotprod float;'
        'DECLARE VARIABLE  vtotacresc float;'
        'DECLARE VARIABLE  vtotdesc float;'
        'DECLARE VARIABLE  valtEst char(1);'
        'DECLARE VARIABLE  vCodigoConf Integer;'
        'DECLARE VARIABLE  vStatusItem varchar(10);'
        'DECLARE VARIABLE  vOK smallint;'
        'DECLARE VARIABLE  vAbaterItens char(1);'
        'DECLARE VARIABLE  vNAbaterItens char(1);'
        'DECLARE VARIABLE VGRUPOPRODPDC integer;'
        'begin'
        '  IF (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '   exit;'
        ''
        '  select coalesce(emp.abater_itens, '#39#39') from empresa emp'
        '  where emp.cod_empresa = new.cod_empresa and emp.ativo = 1'
        '  into :vAbaterItens;'
        ''
        '  if (trim(vAbaterItens) <> '#39'S'#39') then'
        '   exit;'
        ''
        
          '  select coalesce(tp.usar_conferencia_produto, '#39#39') usar_conferen' +
          'cia_produto ,'
        
          '  coalesce(tp.n_usar_conferencia_produto, '#39#39') n_usar_conferencia' +
          '_produto , coalesce(pd.tipv, '#39#39') tipv from pedvenda pd'
        
          '  left join tipo_vendas tp on tp.sigla = pd.tipv and tp.tipo = n' +
          'ew.tipo'
        '  where pd.nped = new.nped'
        '  and pd.tipo = new.tipo'
        '  and pd.cod_empresa = new.cod_empresa'
        '  and pd.cod_vendedor = new.cod_vendedor'
        '  and tp.ativo = 1'
        '    into :vconfTp, :vNAbaterItens, :vTipV;'
        ''
        '  if (trim(vNAbaterItens) = '#39'S'#39') then'
        '   exit;'
        ''
        '  vOK = 0;'
        '  vquantVnd = trunc(new.quant_ped_item, 4);'
        ''
        
          '  if ((inserting) and (upper(coalesce(trim(new.status), '#39#39')) = '#39 +
          'CANCELADO'#39') and (upper(coalesce(vconfTp, '#39#39')) <> '#39'S'#39')) then'
        '   exit;'
        ''
        
          '  if ((updating) and (upper(coalesce(trim(old.status), '#39#39')) = '#39'C' +
          'ANCELADO'#39') and (upper(coalesce(trim(new.status), '#39#39')) = '#39'CANCELA' +
          'DO'#39') and (upper(coalesce(vconfTp, '#39#39')) <> '#39'S'#39')) then'
        '   exit;'
        ''
        
          '  if ((updating) and (coalesce(old.nitem, 0) <> coalesce(new.nit' +
          'em, 0)) and (upper(coalesce(vconfTp, '#39#39')) <> '#39'S'#39')'
        '    and (upper(coalesce(trim(old.status), '#39#39')) <> '#39'CANCELADO'#39')'
        
          '    and (upper(coalesce(trim(new.status), '#39#39')) <> '#39'CANCELADO'#39')) ' +
          'then'
        '  begin'
        '    select first 1 pdc.grupo_prod from pedvenda pv'
        
          '    left join pedvenda_prod pp on pp.nped = pv.nped and pp.tipo ' +
          '= pv.tipo and pv.cod_empresa = pp.cod_empresa'
        
          '    left join pedvenda_prod_conf pdc on pdc.nped_conf = pp.nped ' +
          'and pdc.tipo_conf = pp.tipo and pdc.nitem_conf = pp.nitem and pd' +
          'c.cod_empresa = pp.cod_empresa'
        '    where pdc.nped = old.nped'
        '    and pdc.tipo = old.tipo'
        '    and pdc.nitem = old.nitem'
        '    and pdc.cod_empresa = old.cod_empresa'
        '      into :vgrupoprodpdc;'
        ''
        '    if (coalesce(vgrupoprodpdc, 0) > 0) then'
        '    begin'
        '      update pedvenda_prod_conf pdc set pdc.nitem = new.nitem'
        '      where pdc.nped = new.nped'
        '      and pdc.tipo = new.tipo'
        '      and pdc.grupo_prod = new.grupo_prod'
        '      and pdc.cod_prod = new.cod_prod'
        '      and pdc.cod_grade = new.cod_grade'
        '      and pdc.nitem = old.nitem'
        '      and pdc.cod_empresa = new.cod_empresa;'
        '    end'
        '    else'
        '    begin'
        '      update pedvenda_prod_conf pdc set pdc.nitem = new.nitem'
        '      where pdc.nped = new.nped'
        '      and pdc.tipo = new.tipo'
        '      and pdc.nitem = old.nitem'
        '      and pdc.cod_empresa = new.cod_empresa;'
        '    end'
        '  end'
        ''
        
          '  if (((updating) and (upper(coalesce(trim(new.status), '#39#39')) = '#39 +
          #39') and (old.cod_vendedor <> new.cod_vendedor) and (upper(coalesc' +
          'e(vconfTp, '#39#39')) <> '#39'S'#39'))'
        
          '    or ((updating) and (upper(coalesce(trim(new.status), '#39#39')) = ' +
          #39#39') and (old.quant_ped_item <> new.quant_ped_item) and (upper(co' +
          'alesce(vconfTp, '#39#39')) <> '#39'S'#39'))'
        
          '    or ((updating) and (upper(coalesce(trim(new.status), '#39#39')) = ' +
          #39'CANCELADO'#39') and (old.quant_ped_item = new.quant_ped_item) and (' +
          'upper(coalesce(vconfTp, '#39#39')) <> '#39'S'#39'))'
        
          '    or ((deleting) and (upper(coalesce(vconfTp, '#39#39')) <> '#39'S'#39'))) t' +
          'hen'
        '  begin'
        '    vOK = 1;'
        
          '    if ((old.tipo = '#39'REQ'#39') and (upper(coalesce(vconfTp, '#39#39')) <> ' +
          #39'S'#39'))  then'
        '    begin'
        
          '      for select pdc.nped_conf, pdc.tipo_conf, pdc.nitem_conf, s' +
          'um(pdc.quant) quant,'
        '          pdc.cod_empresa from pedvenda_prod_conf pdc'
        
          '          inner join pedvenda pd on pd.nped = pdc.nped_conf and ' +
          'pd.tipo = pdc.tipo_conf and pd.cod_empresa = pdc.cod_empresa'
        '          where coalesce(pd.status_ped, '#39#39') = '#39#39
        '          and pdc.nped = old.nped'
        '          and pdc.tipo = old.tipo'
        '          and pdc.nitem = old.nitem'
        '          and pdc.cod_empresa = old.cod_empresa'
        '          and pdc.cod_vendedor = old.cod_vendedor'
        
          '          group by pdc.nped, pdc.tipo, pdc.nitem, pdc.nped_conf,' +
          ' pdc.tipo_conf, pdc.nitem_conf, pdc.cod_empresa'
        
          '            into  :vnped, :vtipo, :vnitem, :vquantConfTemp, :vco' +
          'd_empresa do'
        '      begin'
        '        if (coalesce(vnped, 0) > 0) then'
        '        begin'
        
          '          select first 1 trunc(coalesce(pdi.quant_ped_item, 0), ' +
          '4), pdi.status from pedvenda_prod pdi'
        '          where pdi.nped = :vnped'
        '          and pdi.tipo = :vtipo'
        '          and pdi.cod_empresa = :vcod_empresa'
        '          and pdi.nitem = :vnitem'
        '          and pdi.grupo_prod = old.grupo_prod'
        '          and pdi.cod_prod = old.cod_prod'
        '          and pdi.cod_grade = old.cod_grade'
        '          order by pdi.status'
        '            into :vquantConf, :vstatusItem;'
        '                                   '
        
          '          if (upper(coalesce(trim(vStatusItem) , '#39#39')) = '#39'CANCELA' +
          'DO'#39') then'
        '            vquantConf = vquantConfTemp;'
        '          else'
        '            vquantConf = vquantConfTemp + vquantConf;'
        ''
        '          update pedvenda_prod pdi set pdi.status = Null,'
        
          '          pdi.nped_conf = Null, pdi.tipo_conf = Null, pdi.nitem_' +
          'conf = Null,'
        '          pdi.quant_ped_item = (:vquantConf),'
        
          '          pdi.vltot_ped_item = (:vquantConf * old.vlun_ped_item)' +
          ','
        '          pdi.vltot_ped_nf = (:vquantConf * old.vlun_ped_nf)'
        '          where pdi.nped = :vnped'
        '          and pdi.tipo = :vtipo'
        '          and pdi.cod_empresa = :vcod_empresa'
        '          and pdi.nitem = :vnitem'
        '          and pdi.grupo_prod = old.grupo_prod'
        '          and pdi.cod_prod = old.cod_prod'
        '          and pdi.cod_grade = old.cod_grade;'
        ''
        '          delete from pedvenda_prod_conf pdc'
        '          where pdc.nped = old.nped'
        '          and pdc.tipo = old.tipo'
        '          and pdc.nitem = old.nitem'
        '          and pdc.cod_empresa = old.cod_empresa;'
        ''
        
          '          select (sum(coalesce(pdi.quant_ped_item, 0) * coalesce' +
          '(pdi.vlun_ped_item, 0)) + sum(coalesce(pdi.acresc_item, 0)) - su' +
          'm(coalesce(pdi.desc_item, 0))) as totovenda,'
        
          '          (sum(coalesce(pdi.quant_ped_item, 0) * coalesce(pdi.vl' +
          'un_ped_item, 0))) as totprod,'
        
          '          (sum(coalesce(pdi.rateio_acresc, 0))) as acrescimo, (s' +
          'um(coalesce(pdi.rateio_desc, 0))) as desconto from pedvenda_prod' +
          ' pdi'
        '          where pdi.nped = :vnped'
        '          and pdi.tipo = :vtipo'
        '          and pdi.cod_empresa = :vcod_empresa'
        '          and (coalesce(pdi.status, '#39#39') = '#39#39')'
        '            into :vtotvenda, :vtotprod, :vtotacresc, :vtotdesc;'
        '        '
        '          update pedvenda pd set pd.valor_total = :vtotvenda,'
        '          pd.tot_prod = :vtotprod,'
        '          pd.acrescimo = :vtotacresc,'
        '          pd.desconto = :vtotdesc'
        '          where pd.nped = :vnped'
        '          and pd.tipo = :vtipo'
        '          and pd.cod_empresa = :vcod_empresa;'
        '        end'
        '      end'
        ''
        '      if ((deleting) and (coalesce(vnped, 0) > 0)) then'
        '      begin'
        
          '        select (sum(coalesce(pdi.quant_ped_item, 0) * coalesce(p' +
          'di.vlun_ped_item, 0)) + sum(coalesce(pdi.acresc_item, 0)) - sum(' +
          'coalesce(pdi.desc_item, 0))) as totovenda,'
        
          '        (sum(coalesce(pdi.quant_ped_item, 0) * coalesce(pdi.vlun' +
          '_ped_item, 0))) as totprod,'
        
          '        (sum(coalesce(pdi.rateio_acresc, 0))) as acrescimo, (sum' +
          '(coalesce(pdi.rateio_desc, 0))) as desconto from pedvenda_prod p' +
          'di'
        '        where pdi.nped = new.nped'
        '        and pdi.tipo = new.tipo'
        '        and pdi.cod_empresa = :vcod_empresa'
        '        and (coalesce(pdi.status, '#39#39') = '#39#39')'
        '          into :vtotvenda, :vtotprod, :vtotacresc, :vtotdesc;'
        ''
        '        update pedvenda pd set pd.valor_total = :vtotvenda,'
        '        pd.tot_prod = :vtotprod,'
        '        pd.acrescimo = :vtotacresc,'
        '        pd.desconto = :vtotdesc'
        '        where pd.nped = old.nped'
        '        and pd.tipo = old.tipo'
        '        and pd.cod_empresa = :vcod_empresa;'
        '      end'
        '    end'
        '  end'
        ''
        '  if ((inserting) or ((updating) and (vOk = 1))) then'
        '  begin'
        
          '    if ((new.tipo = '#39'REQ'#39') and (upper(coalesce(vconfTp, '#39#39')) <> ' +
          #39'S'#39'))  then'
        '    begin'
        '      while (trunc(vquantVnd, 4) > 0) do'
        '      begin'
        
          '        if ((updating) and (upper(coalesce(trim(new.status), '#39#39')' +
          ') = '#39'CANCELADO'#39')) then'
        '         break;'
        ''
        
          '        select first 1 tp.usar_conferencia_produto, pdi.nped, pd' +
          'i.tipo, pdi.cod_empresa, pdi.grupo_prod, pdi.cod_prod, pdi.nitem' +
          ', pdi.cod_grade, pdi.quant_ped_item, coalesce(pdi.status,'#39#39') sta' +
          'tus   from pedvenda pd'
        
          '        inner join pedvenda_prod pdi on pdi.nped = pd.nped and p' +
          'di.tipo = pd.tipo and pdi.cod_empresa = pd.cod_empresa'
        
          '        left join tipo_vendas tp on tp.sigla = pd.tipv and tp.ti' +
          'po = pd.tipo'
        '        where coalesce(pd.status_ped, '#39#39') = '#39#39
        '        and (coalesce(pdi.status, '#39#39') = '#39#39')'
        '        and (coalesce(tp.usar_conferencia_produto, '#39#39') = '#39'S'#39')'
        '        and pdi.grupo_prod = new.grupo_prod'
        '        and pdi.cod_prod = new.cod_prod'
        '        and pd.tipo = new.tipo'
        '        and pd.cod_empresa = new.cod_empresa'
        '        and pdi.cod_grade = new.cod_grade'
        '        and pd.cod_vendedor = new.cod_vendedor'
        '        order by pd.nped, pd.tipo, pd.cod_empresa'
        
          '          into :vconfProd, :vnped, :vtipo, :vcod_empresa, :vgrup' +
          'o_prod, :vcod_prod, :vnitem, :vcod_grade, :vquantConf, :vstatusI' +
          'tem;'
        ''
        
          '        select first 1 coalesce(pdi.status,'#39#39') status from pedve' +
          'nda_prod pdi'
        '        where pdi.nped = :vnped'
        '        and pdi.tipo = :vtipo'
        '        and pdi.cod_empresa = :vcod_empresa'
        '        and pdi.grupo_prod = :vgrupo_prod'
        '        and pdi.cod_prod = :vcod_prod'
        '        and pdi.nitem = :vnitem'
        '        and pdi.cod_grade = :vcod_grade'
        '        order by pdi.status'
        '          into :vstatusItem;'
        ''
        '        if (trim(vStatusItem) = '#39'CANCELADO'#39') then'
        '          break;'
        ''
        '        if (upper(vconfProd) = '#39'S'#39') then'
        '        begin'
        
          '          if ((coalesce(vnped, 0) > 0) and (vtipo = new.tipo) an' +
          'd (vcod_empresa = new.cod_empresa)'
        
          '            and (vgrupo_prod = new.grupo_prod) and (vcod_prod = ' +
          'new.cod_prod) and (vcod_grade = new.cod_grade)) then'
        '          begin'
        
          '            if (trunc(vquantVnd, 4) >= trunc(vquantConf, 4)) the' +
          'n'
        '            begin'
        '              vquantConfTemp = trunc(vquantConf, 4);'
        ''
        
          '              update pedvenda_prod pdi set pdi.status = '#39'CANCELA' +
          'DO'#39','
        '              pdi.codigo_nop = gen_id(gen_itens_canc, 1),'
        
          '              pdi.nped_conf = new.nped, pdi.tipo_conf = new.tipo' +
          ', pdi.nitem_conf = new.nitem'
        '              where pdi.nped = :vnped'
        '              and pdi.tipo = :vtipo'
        '              and pdi.cod_empresa = :vcod_empresa'
        '              and pdi.grupo_prod = :vgrupo_prod'
        '              and pdi.cod_prod = :vcod_prod'
        '              and pdi.nitem = :vnitem'
        '              and pdi.cod_grade = :vcod_grade;'
        ''
        
          '              insert into pedvenda_prod_conf (codigo, nped, tipo' +
          ', nitem, cod_empresa, quant, nped_conf, nitem_conf, tipo_conf, c' +
          'od_vendedor, tipv, grupo_prod, cod_prod, cod_grade)'
        
          '              values ((select cod from incrementa_codigo(new.cod' +
          '_empresa, '#39'PRODUTOS_PROD_CONF'#39')), new.nped, new.tipo, new.nitem,' +
          ' new.cod_empresa, :vquantConfTemp, :vnped, :vnitem, :vtipo, new.' +
          'cod_vendedor, :vTipV, new.grupo_prod, new.cod_prod, new.cod_grad' +
          'e);'
        ''
        
          '              vquantVnd = trunc(vquantVnd, 4) -  trunc(vquantCon' +
          'f, 4);'
        '            end'
        '            else'
        '            begin'
        '              vquantConfTemp = trunc(vquantVnd, 4);'
        ''
        
          '              update pedvenda_prod pdi set pdi.quant_ped_item = ' +
          '(:vquantConf - :vquantVnd),'
        
          '              pdi.vltot_ped_item = ((:vquantConf - :vquantVnd) *' +
          ' new.vlun_ped_item),'
        
          '              pdi.vltot_ped_nf = ((:vquantConf - :vquantVnd) * n' +
          'ew.vlun_ped_nf),'
        
          '              pdi.nped_conf = new.nped, pdi.tipo_conf = new.tipo' +
          ', pdi.nitem_conf = new.nitem'
        '              where pdi.nped = :vnped'
        '              and pdi.tipo = :vtipo'
        '              and pdi.cod_empresa = :vcod_empresa'
        '              and pdi.grupo_prod = :vgrupo_prod'
        '              and pdi.cod_prod = :vcod_prod'
        '              and pdi.nitem = :vnitem'
        '              and pdi.cod_grade = :vcod_grade;'
        ''
        
          '              insert into pedvenda_prod_conf (codigo, nped, tipo' +
          ', nitem, cod_empresa, quant, nped_conf, nitem_conf, tipo_conf, c' +
          'od_vendedor, tipv, grupo_prod, cod_prod, cod_grade)'
        
          '              values ((select cod from incrementa_codigo(new.cod' +
          '_empresa, '#39'PRODUTOS_PROD_CONF'#39')), new.nped, new.tipo, new.nitem,' +
          ' new.cod_empresa, :vquantConfTemp, :vnped, :vnitem, :vtipo, new.' +
          'cod_vendedor, :vTipV, new.grupo_prod, new.cod_prod, new.cod_grad' +
          'e);'
        ''
        '              vquantVnd = 0;'
        '            end'
        ''
        
          '            select (sum(coalesce(pdi.quant_ped_item, 0) * coales' +
          'ce(pdi.vlun_ped_item, 0)) + sum(coalesce(pdi.acresc_item, 0)) - ' +
          'sum(coalesce(pdi.desc_item, 0))) as totovenda,'
        
          '            (sum(coalesce(pdi.quant_ped_item, 0) * coalesce(pdi.' +
          'vlun_ped_item, 0))) as totprod,'
        
          '            (sum(coalesce(pdi.rateio_acresc, 0))) as acrescimo, ' +
          '(sum(coalesce(pdi.rateio_desc, 0))) as desconto from pedvenda_pr' +
          'od pdi'
        '            where pdi.nped = :vnped'
        '            and pdi.tipo = :vtipo'
        '            and pdi.cod_empresa = :vcod_empresa'
        '            and (coalesce(pdi.status, '#39#39') = '#39#39')'
        
          '              into :vtotvenda, :vtotprod, :vtotacresc, :vtotdesc' +
          ';'
        '        '
        '            update pedvenda pd set pd.valor_total = :vtotvenda,'
        '            pd.tot_prod = :vtotprod,'
        '            pd.acrescimo = :vtotacresc,'
        '            pd.desconto = :vtotdesc'
        '            where pd.nped = :vnped'
        '            and pd.tipo = :vtipo'
        '            and pd.cod_empresa = :vcod_empresa;'
        '          end'
        '        end'
        '        else'
        '          break;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CAR107'#39', :COD_EMPRESA, '#39'PE' +
          'RMISSAO ALTERAR DATA PREV REC CHEQUE'#39', 10, '#39'.'#39', 1, '#39'S'#39', '#39'S'#39', CUR' +
          'RENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
