        '|BLOCO|'
        'CREATE OR ALTER trigger nfce_item_calc_imp for nfce_item'
        'active before insert or update or delete position 0'
        'AS'
        '  --declare variable calcular char(1);'
        '  declare variable update_pis char(1);'
        '  declare variable update_icms char(1);'
        '  declare variable update_icef char(1);'
        '  declare variable update_iss char(1);'
        '  declare variable update_fcp char(1);'
        '  declare variable valor_tmp t_vl_todos;'
        '  declare variable naousaricms t_vl_todos;'
        '  declare variable scontext_compl_id varchar(255);'
        '  declare variable icodnfce_compl integer;'
        'BEGIN             '
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '     exit;'
        ''
        
          '  select RDB$GET_CONTEXT('#39'USER_SESSION'#39', '#39'COD_NFCE_COMPL'#39') from ' +
          'RDB$DATABASE'
        '    into :scontext_compl_id;'
        ''
        
          '  if (coalesce(scontext_compl_id, '#39#39') = cast(new.cod_nfce as var' +
          'char(255))) then'
        '    exit;'
        ''
        
          '  select cod_nfce_complementada from nfce where cod_nfce = new.c' +
          'od_nfce and cod_empresa = new.cod_empresa'
        '    into :icodnfce_compl;'
        ''
        '  if (coalesce(icodnfce_compl,  0) > 0) then'
        '    exit;'
        ''
        
          '  if (((inserting) or ( updating)) and (new.cfop in (5401, 5402,' +
          ' 5403))) then'
        '    new.cfop = 5405;'
        ''
        '--  calcular = '#39'N'#39';--coalesce(new.calcular, '#39'N'#39');'
        '  update_icms = '#39'N'#39';'
        '  update_icef = '#39'N'#39';'
        '  update_pis = '#39'N'#39';'
        '  update_iss = '#39'N'#39';'
        '  update_fcp = '#39'N'#39';'
        ''
        '  if ((inserting) or (deleting) ) then'
        '  begin'
        '--    calcular = '#39'S'#39';'
        '    update_icms = '#39'S'#39';'
        '    update_icef = '#39'S'#39';'
        '    update_pis = '#39'S'#39';'
        '    update_iss = '#39'S'#39';'
        '    update_fcp = '#39'S'#39';'
        '  end'
        '  else if (updating) then'
        '    if ((old.vprod <> new.vprod) or'
        '      (old.vseg <> new.vseg) or'
        '      (old.vdesc <> new.vdesc) or  '
        
          '      --((old.vfrete <> new.vfrete) and (new.frete_na_base = '#39'S'#39 +
          ')) or'
        '      (old.vfrete <> new.vfrete) or'
        '      (old.voutro <> new.voutro) or'
        '      (old.frete_na_base <> new.frete_na_base)) then-- or'
        '    begin              '
        '      update_icms = '#39'S'#39';'
        '      update_icef = '#39'S'#39';'
        '      update_pis = '#39'S'#39';'
        '      update_iss = '#39'S'#39';'
        '      update_fcp = '#39'S'#39';'
        '    end'
        '    else'
        '    begin                   '
        '      if ((old.icm_cst <> new.icm_cst) or'
        '         (old.icm_csosn <> new.icm_csosn)) then'
        '      begin'
        '        update_icms = '#39'S'#39';'
        '        update_icef = '#39'S'#39';'
        '        update_fcp = '#39'S'#39';'
        '      end'
        ''
        '      if ((old.icm_cst <> new.icm_cst) or'
        '        (old.icm_csosn <> new.icm_csosn) or'
        '        (old.icm_predbc <> new.icm_predbc) or'
        '        (old.icm_picms <> new.icm_picms) or'
        '        (old.icm_pcredsn <> new.icm_pcredsn)) then-- or'
        '        update_icms = '#39'S'#39';'
        '        '
        '      if ((old.icm_cst <> new.icm_cst) or'
        '        (old.icm_csosn <> new.icm_csosn) or'
        '        (old.icm_predbcefet <> new.icm_predbcefet) or'
        '        (old.icm_picmsefet <> new.icm_picmsefet)) then'
        '        update_icef = '#39'S'#39';'
        ''
        '      if ((old.pis_reset <> new.pis_reset) or'
        '        (old.pis_cst <> new.pis_cst) or'
        '        (old.pis_ppis <> new.pis_ppis) or'
        '        (old.pis_valiqprod <> new.pis_valiqprod) or'
        '        (old.cofins_cst <> new.cofins_cst) or'
        '        (old.cofins_pcofins <> new.cofins_pcofins) or'
        
          '        (old.cofins_valiqprod <> new.cofins_valiqprod)) then-- o' +
          'r'
        '        update_pis = '#39'S'#39';'
        ''
        '      if ((old.iss_valiq <> new.iss_valiq) or'
        '        (old.iss_retido <> new.iss_retido) ) then'
        '        update_iss = '#39'S'#39';'
        '        '
        '      if ((old.fcp_pfcp <> new.fcp_pfcp) or'
        '        (old.fcp_pfcpst <> new.fcp_pfcpst) ) then'
        '        update_fcp = '#39'S'#39';'
        '    end'
        ''
        
          '  if ((update_icms = '#39'N'#39') and (update_pis = '#39'N'#39') and (update_iss' +
          ' = '#39'N'#39') and (update_fcp = '#39'N'#39') and (update_icef = '#39'N'#39')) then'
        '    exit;'
        ''
        '  --if (new.frete_na_base = '#39'S'#39') then'
        '  --  valor_tmp = new.vfrete;'
        '  --else'
        '  --   valor_tmp = 0;'
        
          '  --valor_tmp = valor_tmp + new.vprod + new.vseg + new.voutro - ' +
          'new.vdesc;'
        ''
        '  valor_tmp = coalesce(new.vprod, 0) +'
        '              coalesce(new.vseg, 0) +'
        '              coalesce(new.voutro, 0) +'
        
          '              iif(coalesce(new.frete_na_base, '#39'S'#39') = '#39'S'#39', coales' +
          'ce(new.vfrete, 0), 0) -'
        '              coalesce(new.vdesc, 0);'
        ''
        '  IF (update_icms = '#39'S'#39') THEN'
        '  begin'
        
          '    if ((coalesce(new.icm_pcredsn,0) > 0) and ((new.icm_csosn = ' +
          #39'101'#39') or (new.icm_csosn = '#39'900'#39'))) then'
        '    begin'
        
          '      new.icm_vcredicmssn = round(valor_tmp * new.icm_pcredsn / ' +
          '100, 2);'
        '      new.icm_predbc = 0;'
        '      new.icm_picms = 0;'
        '      new.icm_vbc = 0;'
        '      new.icm_vicms = 0;'
        '    end'
        '    else if (coalesce(new.icm_csosn, '#39#39') <> '#39#39') then'
        '    begin               '
        '      new.icm_pcredsn = 0;'
        '      new.icm_vcredicmssn = 0;'
        '      new.icm_predbc = 0;'
        '      new.icm_picms = 0;'
        '      new.icm_vbc = 0;'
        '      new.icm_vicms = 0;'
        '    end'
        
          '    else if ((new.icm_picms > 0) and ((new.icm_cst = '#39'00'#39') or (n' +
          'ew.icm_cst = '#39'20'#39') or (new.icm_cst = '#39'90'#39'))) then'
        '    begin'
        '      if (new.icm_cst = '#39'00'#39') then'
        '        new.icm_predbc = 0;'
        '  '
        '      new.icm_vbc = valor_tmp;'
        '      if (new.icm_predbc > 0) then'
        '        new.icm_vbc = new.icm_predbc * new.icm_vbc / 100;'
        '  '
        '      new.icm_vbc = round(new.icm_vbc, 2);'
        
          '      new.icm_vicms = round(new.icm_vbc * new.icm_picms / 100, 2' +
          ');'
        '      '
        '      new.icm_pcredsn = 0;'
        '      new.icm_vcredicmssn = 0;'
        '    end'
        '    else'
        '    begin'
        '      new.icm_predbc = 0;'
        '      new.icm_picms = 0;'
        '      new.icm_vbc = 0;'
        '      new.icm_vicms = 0;'
        '      new.icm_pcredsn = 0;'
        '      new.icm_vcredicmssn = 0;'
        '    end'
        '  end'
        ''
        '  if (update_icef = '#39'S'#39') then'
        '  begin'
        
          '    if ((new.icm_cst = 60) and (coalesce(new.icm_picmsefet, 0) >' +
          ' 0)) then'
        '    begin'
        '      if (coalesce(new.icm_predbcefet, 0) > 0) then'
        
          '        new.icm_vbcefet = round(valor_tmp * (100 - new.icm_predb' +
          'cefet) / 100, 2);'
        '      else'
        '      begin'
        '        new.icm_vbcefet    = round(valor_tmp, 0);'
        '        new.icm_predbcefet = 0;'
        '      end'
        
          '      new.icm_vicmsefet  = round(new.icm_vbcefet * new.icm_picms' +
          'efet / 100, 2);'
        '    end'
        '    else'
        '    begin'
        '      new.icm_predbcefet = 0;'
        '      new.icm_picmsefet  = 0;'
        '      new.icm_vbcefet    = 0;'
        '      new.icm_vicmsefet  = 0;'
        '    end'
        '  end'
        ''
        '  valor_tmp = coalesce(new.vprod, 0) +'
        '              coalesce(new.vseg, 0) +'
        '              coalesce(new.voutro, 0) +'
        '              coalesce(new.vfrete, 0) -'
        '              coalesce(new.vdesc, 0);'
        ''
        '  naousaricms = 0;'
        
          '  select value1_f from config_sistema where chave = '#39'nfc_bc_pico' +
          'fins_sem_icms'#39' and cod_empresa = new.cod_empresa'
        '    into :naousaricms;     '
        ''
        '  if (trunc(coalesce(naousaricms, 0)) <> 1) then'
        '    valor_tmp = valor_tmp -'
        '                coalesce(new.icm_vcredicmssn, 0) -'
        '                coalesce(new.icm_vicms, 0);'
        ''
        '  valor_tmp = iif(valor_tmp > 0, valor_tmp, 0);'
        ''
        '  if (update_pis = '#39'S'#39') then'
        '  begin'
        '    new.cofins_cst = new.pis_cst;'
        '  '
        '    if ('
        '      ( (new.pis_cst = '#39'03'#39') and (new.pis_valiqprod > 0) )'
        '      or'
        
          '      ( ( (new.pis_cst = '#39'01'#39') or (new.pis_cst = '#39'02'#39') ) and (ne' +
          'w.pis_ppis > 0) )'
        '      ) then'
        '    begin'
        '      if (new.pis_cst = '#39'03'#39') then'
        '      begin'
        '        new.pis_qbcprod = new.qcom;'
        
          '        new.pis_vpis = round(new.pis_qbcprod * new.pis_valiqprod' +
          ', 2);'
        '        new.pis_vbc = 0;'
        '        new.pis_ppis = 0;'
        '      end'
        '      else'
        '      begin'
        '        new.pis_vbc = round(valor_tmp, 2);'
        
          '        new.pis_vpis = round(new.pis_ppis * new.pis_vbc / 100, 2' +
          ');'
        '        new.pis_qbcprod = 0;'
        '        new.pis_valiqprod = 0;'
        '      end'
        '    end'
        '    else'
        '    begin'
        '      new.pis_vbc = 0;'
        
          '      if (new.pis_cst <> '#39'05'#39') then --Quando cst 05, no sped tem' +
          ' de permanecer a aliquota, porem base e valor zero'
        '        new.pis_ppis = 0;'
        '      new.pis_qbcprod = 0;'
        '      new.pis_valiqprod = 0;'
        '      new.pis_vpis = 0;'
        '    end'
        '  '
        '    if ('
        '      ( (new.cofins_cst = '#39'03'#39') and (new.cofins_valiqprod > 0) )'
        '      or'
        
          '      ( ( (new.cofins_cst = '#39'01'#39') or (new.cofins_cst = '#39'02'#39') ) a' +
          'nd (new.cofins_pcofins > 0) )'
        '      ) then'
        '    begin'
        '      if (new.cofins_cst = '#39'03'#39') then'
        '      begin'
        '        new.cofins_qbcprod = new.qcom;'
        
          '        new.cofins_vcofins = round(new.cofins_qbcprod * new.cofi' +
          'ns_valiqprod, 2);'
        '        new.cofins_vbc = 0;'
        '        new.cofins_pcofins = 0;'
        '      end'
        '      else'
        '      begin'
        '        new.cofins_vbc = round(valor_tmp, 2);'
        
          '        new.cofins_vcofins = round(new.cofins_pcofins * new.cofi' +
          'ns_vbc / 100, 2);'
        '        new.cofins_qbcprod = 0;'
        '        new.cofins_valiqprod = 0;'
        '      end'
        '    end'
        '    else'
        '    begin'
        '      new.cofins_vbc = 0;'
        '      if (new.cofins_cst <> '#39'05'#39') then'
        '        new.cofins_pcofins = 0;'
        '      new.cofins_qbcprod = 0;'
        '      new.cofins_valiqprod = 0;'
        '      new.cofins_vcofins = 0;'
        '    end'
        '  end    '
        ''
        '  valor_tmp = coalesce(new.vprod, 0) +'
        '              coalesce(new.vseg, 0) +'
        '              coalesce(new.voutro, 0) +'
        '              coalesce(new.vfrete, 0) -'
        '              coalesce(new.vdesc, 0);'
        ''
        '  if (update_iss = '#39'S'#39') then'
        '  begin'
        '    if (new.iss_valiq > 0) then'
        '    begin'
        '      new.iss_vbc = round(valor_tmp, 2);'
        
          '      if ((new.iss_retido = '#39'S'#39') or (new.iss_retido = '#39'C'#39'))  the' +
          'n'
        '      begin'
        
          '        new.iss_vissret = round(new.iss_vbc * new.iss_valiq / 10' +
          '0, 2);'
        '        new.iss_vissqn = 0;'
        '      end'
        '      else'
        '      begin'
        
          '        new.iss_vissqn = round(new.iss_vbc * new.iss_valiq / 100' +
          ', 2);'
        '        new.iss_vissret = 0;'
        '      end'
        '    end'
        '    else'
        '    begin'
        '      new.iss_vbc = 0;'
        '      new.iss_valiq = 0;'
        '      new.iss_vissqn = 0;'
        '      new.iss_vissret = 0;'
        '      new.iss_retido = '#39'N'#39';'
        '    end'
        '  end'
        ''
        '  if (update_fcp = '#39'S'#39') then'
        '  begin'
        '    if (new.icm_cst in ('#39'10'#39', '#39'20'#39','#39'70'#39', '#39'90'#39')) then'
        '      new.fcp_vbcfcp = coalesce(new.icm_vbc, 0);'
        ''
        '    if (new.icm_cst in ('#39'00'#39', '#39'10'#39', '#39'20'#39','#39'70'#39', '#39'90'#39')) then'
        
          '      new.fcp_vfcp = round(coalesce(new.icm_vbc, 0) * new.fcp_pf' +
          'cp / 100, 2);'
        ''
        '    if (new.icm_cst = '#39'51'#39') then'
        '    begin'
        '      new.fcp_vbcfcp = valor_tmp;'
        
          '      new.fcp_vfcp   = round(coalesce(new.fcp_vbcfcp, 0) * new.f' +
          'cp_pfcp / 100, 2);'
        '    end'
        ''
        '    if ((new.icm_cst in ('#39'10'#39' , '#39'30'#39' , '#39'70'#39' , '#39'90'#39' )) or'
        '      (new.icm_csosn in ('#39'201'#39', '#39'202'#39', '#39'203'#39', '#39'900'#39'))) then'
        '    begin'
        '      new.fcp_vbcfcpst = new.fcp_vbcfcp;'
        
          '      new.fcp_vfcpst   = round(coalesce(new.fcp_vbcfcpst, 0) * n' +
          'ew.fcp_pfcpst / 100, 2);'
        '    end'
        '    '
        '    if (not new.icm_cst in ('#39'10'#39', '#39'20'#39', '#39'70'#39', '#39'90'#39')) then'
        '      new.fcp_vbcfcp = 0;'
        ''
        '    if (not new.icm_cst in ('#39'00'#39', '#39'10'#39', '#39'20'#39', '#39'70'#39', '#39'90'#39')) then'
        '    begin'
        '      new.fcp_pfcp = 0;'
        '      new.fcp_vfcp = 0;'
        '    end'
        ''
        
          '    if (((not new.icm_cst   in ( '#39'10'#39',  '#39'30'#39',  '#39'70'#39',  '#39'90'#39')) and' +
          ' (trim(coalesce(new.icm_csosn, '#39#39')) =  '#39#39')) or'
        
          '        ((not new.icm_csosn in ('#39'201'#39', '#39'202'#39', '#39'203'#39', '#39'900'#39')) and' +
          ' (trim(coalesce(new.icm_csosn, '#39#39')) <> '#39#39'))) then'
        '    begin'
        '      new.fcp_vbcfcpst = 0;'
        '      new.fcp_pfcpst   = 0;'
        '      new.fcp_vfcpst   = 0;'
        '    end'
        '  '
        
          '    if (((new.icm_cst                 <>  '#39'60'#39') and (trim(coales' +
          'ce(new.icm_csosn, '#39#39')) =  '#39#39')) or'
        
          '        ((coalesce(new.icm_csosn, '#39#39') <> '#39'500'#39') and (trim(coales' +
          'ce(new.icm_csosn, '#39#39')) <> '#39#39'))) then'
        '    begin'
        '      new.fcp_vbcfcpstret = 0;'
        '      new.fcp_pfcpstret   = 0;'
        '      new.fcp_vfcpstret   = 0;'
        '    end'
        '  '
        '    if (coalesce(new.fcp_pfcp, 0) <= 0) then'
        '    begin'
        '      new.fcp_pfcp   = 0;'
        '      new.fcp_vbcfcp = 0;'
        '      new.fcp_vfcp   = 0;'
        '    end'
        '  '
        '    if (coalesce(new.fcp_pfcpst, 0) <= 0) then'
        '    begin'
        '      new.fcp_pfcpst   = 0;'
        '      new.fcp_vbcfcpst = 0;'
        '      new.fcp_vfcpst   = 0;'
        '    end'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_NEGATIVAR_DESNEGATIVAR_CL ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PBARRADO integer,'
        '    PFINANC_DIA_ATUAL char(1),'
        '    PDATA_ATUAL timestamp,'
        '    PDIA_FINANCEIRO timestamp,'
        '    PDATA_VENC_INI timestamp)'
        'returns ('
        '    COD_CLIENTE integer,'
        '    COD_EMPRESA integer,'
        '    CPFCGC varchar(18),'
        '    NOME_CLIENTE varchar(35),'
        '    RAZAO varchar(60),'
        '    CODIGO_FATURAMENTO integer,'
        '    DESC_FAT varchar(30),'
        '    STATUS_F varchar(10),'
        '    VALOR double precision,'
        '    QTDE integer)'
        'as'
        'declare variable VSQL_DTVENC_CR varchar(1000);'
        'declare variable VSQL_DTVENC_CH varchar(1000);'
        'declare variable VSQL_EMPRESA_CR varchar(1000);'
        'declare variable VSQL_EMPRESA_CH varchar(1000);'
        'declare variable VSQL_CLIENTE_CR varchar(1000);'
        'declare variable VSQL_CLIENTE_CH varchar(1000);'
        'declare variable VSQL_BARRADO varchar(1000);'
        'declare variable VSQL_CAMPOS varchar(1000);'
        'declare variable VSQL_CAMPOS_CR varchar(1000);'
        'declare variable VSQL_CAMPOS_CH varchar(1000);'
        'declare variable VSQL_GROUPBY varchar(1000);'
        'declare variable VSQL varchar(10000);'
        'declare variable VDIAS_CAR_JUROS integer;'
        'declare variable VCOD_BARRADO integer;'
        'declare variable VFINANCEIRO_UNIFICADO char(1);'
        'declare variable VDATA timestamp;'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  select emp.dias_car_juros, emp.codbarrado, emp.financeiro_unif' +
          'icado from empresa emp'
        '  where emp.cod_empresa = :pcod_empresa'
        
          '    into :vdias_car_juros, :vcod_barrado, :vfinanceiro_unificado' +
          ';'
        ''
        
          '  vsql_dtvenc_cr = '#39' case when (cc.data_prev_rec > (cc.data_venc' +
          '_c + '#39' || coalesce(:vdias_car_juros, 0) || '#39')) then'
        '                            cc.data_prev_rec'
        '                          else'
        
          '                            (cc.data_venc_c + '#39' || coalesce(:vdi' +
          'as_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        
          '  vsql_dtvenc_ch = '#39' case when (ch.data_prev_rec > (ch.data_venc' +
          ' + '#39' || coalesce(:vdias_car_juros, 0) || '#39')) then'
        '                             ch.data_prev_rec'
        '                          else'
        
          '                            (ch.data_venc + '#39' || coalesce(:vdias' +
          '_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        '  if (pfinanc_dia_atual = '#39'A'#39') then'
        '    vdata = :pdata_atual;'
        '  else'
        '    vdata = :pdia_financeiro;'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') then'
        '  begin'
        
          '    vsql_campos    = '#39' cpfcgc, nome_cliente, razao, codigo_fatur' +
          'amento, desc_fat, status_f, '#39';'
        
          '    vsql_campos_cr = '#39' cl.cpfcgc, cl.nome_cliente, cl.razao, cl.' +
          'codigo_faturamento, tf.desc_fat, tf.status_f, '#39';'
        
          '    vsql_campos_ch = '#39' cl.cpfcgc, cl.nome_cliente, cl.razao, cl.' +
          'codigo_faturamento, tf.desc_fat, tf.status_f, '#39';'
        
          '    vsql_empresa_cr= '#39' and emp.codigo_unificadora = '#39' || :pcod_e' +
          'mpresa;'
        
          '    vsql_empresa_ch= '#39' and emp.codigo_unificadora = '#39' || :pcod_e' +
          'mpresa;'
        '    vsql_groupby   = '#39' group by 1, 2, 3, 4, 5, 6 '#39';'
        '  end'
        '  else'
        '  begin'
        
          '    vsql_campos    = '#39' cod_cliente, cod_empresa, cpfcgc, nome_cl' +
          'iente, razao, codigo_faturamento, desc_fat, status_f, '#39';'
        
          '    vsql_campos_cr = '#39' cl.cod_cliente, cl.cod_empresa, cl.cpfcgc' +
          ', cl.nome_cliente, cl.razao, cl.codigo_faturamento, tf.desc_fat,' +
          ' tf.status_f, '#39';'
        
          '    vsql_campos_ch = '#39' cl.cod_cliente, cl.cod_empresa, cl.cpfcgc' +
          ', cl.nome_cliente, cl.razao, cl.codigo_faturamento, tf.desc_fat,' +
          ' tf.status_f, '#39';'
        '    vsql_empresa_cr= '#39' and cc.cod_emp_mult = '#39' || :pcod_empresa;'
        '    vsql_empresa_ch= '#39' and ch.cod_emp_mult = '#39' || :pcod_empresa;'
        '    vsql_groupby   = '#39' group by 1, 2, 3, 4, 5, 6, 7, 8 '#39';'
        '  end'
        ''
        
          '  if ((vfinanceiro_unificado = '#39'S'#39') and (trim(coalesce(pcpfcgc, ' +
          #39#39')) <> '#39#39')) then'
        '  begin'
        '    vsql_cliente_cr = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '    vsql_cliente_ch = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '  end'
        '  else if (coalesce(pcod_cliente, 0) <> 0) then'
        '  begin'
        '    vsql_cliente_cr = '#39' and cc.cod_cliente = '#39' || :pcod_cliente;'
        '    vsql_cliente_ch = '#39' and ch.cod_cliente = '#39' || :pcod_cliente;'
        '  end'
        '  else'
        '  begin'
        '    vsql_cliente_cr = '#39#39';'
        '    vsql_cliente_ch = '#39#39';'
        '  end'
        ''
        '  if (coalesce(pbarrado, 0) = 1) then'
        '    vsql_barrado = '#39' and tf.status_f = '#39#39'BARRADO'#39#39' '#39';'
        '  else'
        
          '    vsql_barrado = '#39' and trim(coalesce(tf.status_f, '#39#39#39#39')) <> '#39#39 +
          'BARRADO'#39#39' '#39';'
        ''
        '  vsql ='
        '    '#39' select distinct '#39' || :vsql_campos || '#39
        
          '      sum(coalesce(valor, 0)) valor, sum(coalesce(qtde, 0)) qtde' +
          ' from ('
        '        select '#39' || :vsql_campos_cr || '#39
        '        sum(coalesce(cc.valor_c, 0)) valor, count(*) as qtde'
        '        from controle_creditos cc'
        
          '        inner join empresa emp on emp.cod_empresa = cc.codigo_em' +
          'p'
        
          '        inner join controles ctrl on ctrl.codigo_ctrl = cc.codig' +
          'o_ctrl and ctrl.codigo_emp = cc.cod_emp_mult'
        
          '        inner join clientes cl on cl.cod_cliente = cc.cod_client' +
          'e and cl.cod_empresa = cc.cod_emp_mult'
        '        left join bairros br on br.cod_bairro = cl.cod_bairro'
        '        left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        '        left join estados es on es.codigo_uf = cl.codigo_uf'
        
          '        left join tipo_faturamento tf on tf.codigo_faturamento =' +
          ' cl.codigo_faturamento'
        '        where cc.cod_cliente > 0'
        '        and '#39' || :vsql_dtvenc_cr || '#39' < '#39#39#39' || :vdata || '#39#39#39
        '        and cc.data_venc_c >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        '        and cc.datq_c is null'
        '        and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39
        
          '        and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' ' +
          #39' || :vsql_empresa_cr || :vsql_cliente_cr || :vsql_barrado || :v' +
          'sql_groupby || '#39
        '        union all'
        '        select '#39' || :vsql_campos_cr || '#39
        '        sum(coalesce(ch.valor_ch, 0)) valor, count(*) as qtde'
        '        from controle_cheque ch'
        
          '        inner join empresa emp on emp.cod_empresa = ch.codigo_em' +
          'p'
        
          '        inner join controles ctrl on ctrl.codigo_ctrl = ch.codig' +
          'o_ctrl and ctrl.codigo_emp = ch.cod_emp_mult'
        
          '        inner join clientes cl on cl.cod_cliente = ch.cod_client' +
          'e and cl.cod_empresa = ch.cod_emp_mult'
        '        left join bairros br on br.cod_bairro = cl.cod_bairro'
        '        left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        '        left join estados es on es.codigo_uf = cl.codigo_uf'
        
          '        left join tipo_faturamento tf on tf.codigo_faturamento =' +
          ' cl.codigo_faturamento'
        '        where ch.cod_cliente > 0'
        '        and '#39' || :vsql_dtvenc_ch || '#39' < '#39#39#39' || :vdata || '#39#39#39
        '        and ch.data_venc >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        '        and ch.datq_ch is null'
        '        and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39
        
          '        and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' ' +
          #39' || :vsql_empresa_ch || :vsql_cliente_ch || :vsql_barrado || :v' +
          'sql_groupby || '#39
        '      ) '#39' || :vsql_groupby;'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39#39') = '#39'S'#39') then'
        '  begin'
        '    for execute statement'
        
          '      vsql into :cpfcgc, :nome_cliente, :razao, :codigo_faturame' +
          'nto, :desc_fat, :status_f, :valor, :qtde do'
        '    begin'
        '      cod_cliente = 0;'
        '      cod_empresa = 0;'
        '      suspend;'
        '    end'
        '  end'
        '  else'
        '  begin'
        '    for execute statement'
        
          '      vsql into :cod_cliente, :cod_empresa, :cpfcgc, :nome_clien' +
          'te, :razao, :codigo_faturamento, :desc_fat, :status_f, :valor, :' +
          'qtde do'
        '        suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_DESNEGATIVAR_CL ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PFINANC_DIA_ATUAL char(1),'
        '    PDATA_ATUAL timestamp,'
        '    PDIA_FINANCEIRO timestamp,'
        '    PDATA_VENC_INI timestamp)'
        'returns ('
        '    COD_CLIENTE integer,'
        '    COD_EMPRESA integer,'
        '    CPFCGC varchar(18),'
        '    NOME_CLIENTE varchar(35),'
        '    RAZAO varchar(60),'
        '    CODIGO_FATURAMENTO integer,'
        '    DESC_FAT varchar(30),'
        '    STATUS_F varchar(10))'
        'as'
        'declare variable VSQL_DTVENC_CR varchar(1000);'
        'declare variable VSQL_DTVENC_CH varchar(1000);'
        'declare variable VSQL_EMPRESA_CL varchar(1000);'
        'declare variable VSQL_EMPRESA_CR varchar(1000);'
        'declare variable VSQL_EMPRESA_CH varchar(1000);'
        'declare variable VSQL_GERAL varchar(1000);'
        'declare variable VSQL_CLIENTE varchar(1000);'
        'declare variable VSQL_CLIENTE_CR varchar(1000);'
        'declare variable VSQL_CLIENTE_CH varchar(1000);'
        'declare variable VSQL_BARRADO varchar(1000);'
        'declare variable VSQL_CAMPOS varchar(1000);'
        'declare variable VSQL_CAMPOS_CL varchar(1000);'
        'declare variable VSQL varchar(10000);'
        'declare variable VSQL2 varchar(10000);'
        'declare variable VDIAS_CAR_JUROS integer;'
        'declare variable VCOD_BARRADO integer;'
        'declare variable VFINANCEIRO_UNIFICADO char(1);'
        'declare variable VDATA timestamp;'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  select emp.dias_car_juros, emp.codbarrado, emp.financeiro_unif' +
          'icado from empresa emp'
        '  where emp.cod_empresa = :pcod_empresa'
        
          '    into :vdias_car_juros, :vcod_barrado, :vfinanceiro_unificado' +
          ';'
        ''
        
          '  vsql_dtvenc_cr = '#39' case when (controle_creditos.data_prev_rec ' +
          '> (controle_creditos.data_venc_c + '#39' || coalesce(:vdias_car_juro' +
          's, 0) || '#39')) then'
        '                            controle_creditos.data_prev_rec'
        '                          else'
        
          '                            (controle_creditos.data_venc_c + '#39' |' +
          '| coalesce(:vdias_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        
          '  vsql_dtvenc_ch = '#39' case when (controle_cheque.data_prev_rec > ' +
          '(controle_cheque.data_venc + '#39' || coalesce(:vdias_car_juros, 0) ' +
          '|| '#39')) then'
        '                             controle_cheque.data_prev_rec'
        '                          else'
        
          '                            (controle_cheque.data_venc + '#39' || co' +
          'alesce(:vdias_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        '  if (pfinanc_dia_atual = '#39'A'#39') then'
        '    vdata = :pdata_atual;'
        '  else'
        '    vdata = :pdia_financeiro;'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') then'
        
          '    vsql_geral = '#39' cl.cod_cliente <> 0 and trim(coalesce(cl.cpfc' +
          'gc, '#39#39#39#39')) <> '#39#39#39#39' '#39';'
        '  else'
        '    vsql_geral = '#39' cl.cod_cliente <> 0 '#39';'
        ''
        
          '  if ((vfinanceiro_unificado = '#39'S'#39') and (trim(coalesce(pcpfcgc, ' +
          #39#39')) <> '#39#39')) then'
        '    vsql_cliente = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '  else if (coalesce(pcod_cliente, 0) <> 0) then'
        '    vsql_cliente    = '#39' and cl.cod_cliente = '#39' || :pcod_cliente;'
        '  else'
        '    vsql_cliente    = '#39#39';'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') then'
        '  begin'
        
          '    vsql_campos          = '#39' cpfcgc, nome_cliente, razao, codigo' +
          '_faturamento, desc_fat, status_f '#39';'
        
          '    vsql_campos_cl       = '#39' cl.cpfcgc, cl.nome_cliente, cl.raza' +
          'o, cl.codigo_faturamento, tf.desc_fat, tf.status_f '#39';'
        
          '    vsql_empresa_cl      = '#39' and emp.codigo_unificadora = '#39' || :' +
          'pcod_empresa;'
        '    vsql_cliente_cr      = '#39' and clientes.cpfcgc = cl.cpfcgc '#39';'
        '    vsql_cliente_ch      = '#39' and clientes.cpfcgc = cl.cpfcgc '#39';'
        
          '    vsql_empresa_cr      = '#39' and empresa.codigo_unificadora  = '#39 +
          ' || :pcod_empresa;'
        
          '    vsql_empresa_ch      = '#39' and empresa.codigo_unificadora  = '#39 +
          ' || :pcod_empresa;'
        '  end'
        '  else'
        '  begin'
        
          '    vsql_campos          = '#39' cod_cliente, cod_empresa, cpfcgc, n' +
          'ome_cliente, razao, codigo_faturamento, desc_fat, status_f '#39';'
        
          '    vsql_campos_cl       = '#39' cl.cod_cliente, cl.cod_empresa, cl.' +
          'cpfcgc, cl.nome_cliente, cl.razao, cl.codigo_faturamento, tf.des' +
          'c_fat, tf.status_f '#39';'
        
          '    vsql_empresa_cl      = '#39' and cl.cod_empresa = '#39' || :pcod_emp' +
          'resa;'
        
          '    vsql_cliente_cr      = '#39' and controle_creditos.cod_cliente =' +
          ' cl.cod_cliente '#39';'
        
          '    vsql_cliente_ch      = '#39' and controle_cheque.cod_cliente = c' +
          'l.cod_cliente '#39';'
        
          '    vsql_empresa_cr      = '#39' and controle_creditos.cod_emp_mult ' +
          '= '#39' || :pcod_empresa;'
        
          '    vsql_empresa_ch      = '#39' and controle_cheque.cod_emp_mult = ' +
          #39' || :pcod_empresa;'
        '  end'
        ''
        '  vsql_barrado = '#39' and tf.status_f = '#39#39'BARRADO'#39#39' '#39';'
        ''
        '  vsql ='
        '    '#39' select distinct '#39' || :vsql_campos || '#39' from ('
        '        select '#39' || :vsql_campos_cl || '#39' from clientes cl'
        
          '        inner join empresa emp on emp.cod_empresa = cl.cod_empre' +
          'sa'
        '        left join bairros br on br.cod_bairro = cl.cod_bairro'
        '        left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        '        left join estados es on es.codigo_uf = cl.codigo_uf'
        
          '        left join tipo_faturamento tf on tf.codigo_faturamento =' +
          ' cl.codigo_faturamento'
        
          '        where '#39' || :vsql_geral || :vsql_empresa_cl || :vsql_barr' +
          'ado || :vsql_cliente || '#39
        '        and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39
        '        and (select count(*) from clientes'
        
          '             inner join empresa on empresa.cod_empresa = cliente' +
          's.cod_empresa'
        
          '             inner join controle_creditos on controle_creditos.c' +
          'od_cliente = clientes.cod_cliente and controle_creditos.cod_emp_' +
          'mult = clientes.cod_empresa'
        
          '             inner join controles on controles.codigo_ctrl = con' +
          'trole_creditos.codigo_ctrl and controles.codigo_emp = controle_c' +
          'reditos.cod_emp_mult'
        
          '             where '#39' || :vsql_dtvenc_cr || '#39' < '#39#39#39' || :vdata || ' +
          #39#39#39
        
          '             and controle_creditos.data_venc_c >= '#39#39#39' || :pdata_' +
          'venc_ini || '#39#39#39
        '             and controle_creditos.datq_c is null'
        
          '             and coalesce(controles.barramento_automatico, '#39#39'S'#39#39 +
          ') = '#39#39'S'#39#39' '#39' || :vsql_empresa_cr || :vsql_cliente_cr || '#39
        '            ) = 0'
        '        and (select count(*) from clientes'
        
          '             inner join empresa on empresa.cod_empresa = cliente' +
          's.cod_empresa'
        
          '             inner join controle_cheque on controle_cheque.cod_c' +
          'liente = clientes.cod_cliente and controle_cheque.cod_emp_mult =' +
          ' clientes.cod_empresa'
        
          '             inner join controles on controles.codigo_ctrl = con' +
          'trole_cheque.codigo_ctrl and controles.codigo_emp = controle_che' +
          'que.cod_emp_mult'
        
          '             where '#39' || :vsql_dtvenc_ch || '#39' < '#39#39#39' || :vdata || ' +
          #39#39#39
        
          '             and controle_cheque.data_venc >= '#39#39#39' || :pdata_venc' +
          '_ini || '#39#39#39
        '             and controle_cheque.datq_ch is null'
        
          '             and coalesce(controles.barramento_automatico, '#39#39'S'#39#39 +
          ') = '#39#39'S'#39#39' '#39' || :vsql_empresa_ch || :vsql_cliente_ch || '#39
        '            ) = 0'
        '      ) '#39';'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39#39') = '#39'S'#39') then'
        '  begin'
        '    for execute statement'
        
          '      vsql into :cpfcgc, :nome_cliente, :razao, :codigo_faturame' +
          'nto, :desc_fat, :status_f do'
        '    begin'
        '      cod_cliente = 0;'
        '      cod_empresa = 0;'
        '      suspend;'
        '    end'
        '  end'
        '  else'
        '  begin'
        '    for execute statement'
        
          '      vsql into :cod_cliente, :cod_empresa, :cpfcgc, :nome_clien' +
          'te, :razao, :codigo_faturamento, :desc_fat, :status_f do'
        '        suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_NEG_DESNEG_CL_CRED ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PFINANC_DIA_ATUAL char(1),'
        '    PDATA_ATUAL timestamp,'
        '    PDIA_FINANCEIRO timestamp,'
        '    PDATA_VENC_INI timestamp)'
        'returns ('
        '    COD_CRED integer,'
        '    COD_EMP_MULT integer,'
        '    TIPO_DOC_C varchar(15),'
        '    N_CH varchar(20),'
        '    N_DOC_V integer,'
        '    N_DOC_C char(20),'
        '    TP_DOC_V char(6),'
        '    VALOR_C double precision,'
        '    VALOR_CORR double precision,'
        '    DATA_REC_C timestamp,'
        '    DATA_VENC_C timestamp,'
        '    DATA_PREV_REC timestamp,'
        '    DATQ_C timestamp,'
        '    STATUS_C varchar(10),'
        '    CODIGO_CTRL integer,'
        '    NOME_CTRL varchar(35),'
        '    COD_CLIENTE integer,'
        '    NOME_CLIENTE varchar(35),'
        '    RAZAO varchar(60),'
        '    CPFCGC varchar(18))'
        'as'
        'declare variable VSQL_DTVENC_CR varchar(1000);'
        'declare variable VSQL_DTVENC_CH varchar(1000);'
        'declare variable VSQL_EMPRESA_CR varchar(1000);'
        'declare variable VSQL_EMPRESA_CH varchar(1000);'
        'declare variable VSQL_CLIENTE_CR varchar(1000);'
        'declare variable VSQL_CLIENTE_CH varchar(1000);'
        'declare variable VSQL varchar(10000);'
        'declare variable VDIAS_CAR_JUROS integer;'
        'declare variable VCOD_BARRADO integer;'
        'declare variable VFINANCEIRO_UNIFICADO char(10);'
        'declare variable VDATA timestamp;'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  select emp.dias_car_juros, emp.codbarrado, emp.financeiro_unif' +
          'icado from empresa emp'
        '  where emp.cod_empresa = :pcod_empresa'
        
          '    into :vdias_car_juros, :vcod_barrado, :vfinanceiro_unificado' +
          ';'
        ''
        
          '  vsql_dtvenc_cr = '#39' case when (cc.data_prev_rec > (cc.data_venc' +
          '_c + '#39' || coalesce(:vdias_car_juros, 0) || '#39')) then'
        '                            cc.data_prev_rec'
        '                          else'
        
          '                            (cc.data_venc_c + '#39' || coalesce(:vdi' +
          'as_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        
          '  vsql_dtvenc_ch = '#39' case when (ch.data_prev_rec > (ch.data_venc' +
          ' + '#39' || coalesce(:vdias_car_juros, 0) || '#39')) then'
        '                             ch.data_prev_rec'
        '                          else'
        
          '                            (ch.data_venc + '#39' || coalesce(:vdias' +
          '_car_juros, 0) || '#39')'
        '                     end '#39';'
        ''
        '  if (pfinanc_dia_atual = '#39'A'#39') then'
        '    vdata = :pdata_atual;'
        '  else'
        '    vdata = :pdia_financeiro;'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') then'
        '  begin'
        
          '    vsql_empresa_cr      = '#39' and emp.codigo_unificadora = '#39' || :' +
          'pcod_empresa;'
        
          '    vsql_empresa_ch      = '#39' and emp.codigo_unificadora = '#39' || :' +
          'pcod_empresa;'
        '  end'
        '  else'
        '  begin'
        
          '    vsql_empresa_cr      = '#39' and cc.cod_emp_mult = '#39' || :pcod_em' +
          'presa;'
        
          '    vsql_empresa_ch      = '#39' and ch.cod_emp_mult = '#39' || :pcod_em' +
          'presa;'
        '  end'
        ''
        
          '  if ((vfinanceiro_unificado = '#39'S'#39') and (trim(coalesce(pcpfcgc, ' +
          #39#39')) <> '#39#39')) then'
        '  begin'
        '    vsql_cliente_cr = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '    vsql_cliente_ch = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '  end'
        '  else if (coalesce(pcod_cliente, 0) <> 0) then'
        '  begin'
        '    vsql_cliente_cr = '#39' and cc.cod_cliente = '#39' || :pcod_cliente;'
        '    vsql_cliente_ch = '#39' and ch.cod_cliente = '#39' || :pcod_cliente;'
        '  end'
        '  else'
        '  begin'
        '    vsql_cliente_cr = '#39#39';'
        '    vsql_cliente_ch = '#39#39';'
        '  end'
        ''
        '  vsql ='
        '    '#39' select cc.cod_cred, cc.cod_emp_mult, cc.tipo_doc_c,'
        '      null n_ch, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        
          '      cc.valor_c, coalesce(cc.valor_corr, cc.valor_c) valor_corr' +
          ', '
        
          '      cc.data_rec_c, cc.data_venc_c, cc.data_prev_rec, cc.datq_c' +
          ', cc.status_c,'
        '      cc.codigo_ctrl, ctrl.nome_ctrl,'
        
          '      cc.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc from ' +
          'controle_creditos cc'
        
          '      inner join controles ctrl on ctrl.codigo_ctrl = cc.codigo_' +
          'ctrl and ctrl.codigo_emp = cc.cod_emp_mult '
        '      inner join empresa emp on emp.cod_empresa = cc.codigo_emp '
        
          '      inner join clientes cl on cl.cod_cliente = cc.cod_cliente ' +
          'and cl.cod_empresa = cc.cod_emp_mult '
        '      where cc.cod_cliente > 0'
        '      and '#39' || :vsql_dtvenc_cr || '#39' < '#39#39#39' || :vdata || '#39#39#39
        '      and cc.data_venc_c >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        '      and cc.datq_c is null '
        '      and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '
        
          '      and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '#39' ' +
          '|| vsql_empresa_cr || vsql_cliente_cr || '#39
        '      union all '
        
          '      select ch.codigo_ch, ch.cod_emp_mult, '#39#39'CHEQUE'#39#39' tipo_doc_' +
          'c, '
        '      ch.n_ch, ch.n_doc_v, null n_doc_c, ch.tp_doc_v,'
        '      ch.valor_ch, ch.valor_ch, '
        
          '      ch.data_rec, ch.data_venc, ch.data_prev_rec, ch.datq_ch, c' +
          'h.status_ch,'
        '      ch.codigo_ctrl, ctrl.nome_ctrl,'
        
          '      ch.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc from ' +
          'controle_cheque ch'
        
          '      inner join controles ctrl on ctrl.codigo_ctrl = ch.codigo_' +
          'ctrl and ctrl.codigo_emp = ch.cod_emp_mult '
        '      inner join empresa emp on emp.cod_empresa = ch.codigo_emp '
        
          '      inner join clientes cl on cl.cod_cliente = ch.cod_cliente ' +
          'and cl.cod_empresa = ch.cod_emp_mult '
        '      where ch.cod_cliente > 0 '
        '      and '#39' || :vsql_dtvenc_ch || '#39' < '#39#39#39' || :vdata || '#39#39#39
        '      and ch.data_venc >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        '      and ch.datq_ch is null '
        '      and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '
        
          '      and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '#39' ' +
          '|| vsql_empresa_ch || vsql_cliente_ch || '#39
        '      order by 2 '#39';'
        ''
        '    for execute statement'
        '      vsql into :cod_cred, :cod_emp_mult, :tipo_doc_c,'
        '                :n_ch, :n_doc_v, :n_doc_c, :tp_doc_v,'
        
          '                :valor_c, :valor_corr, :data_rec_c, :data_venc_c' +
          ', :data_prev_rec, :datq_c, :status_c,'
        '                :codigo_ctrl, :nome_ctrl,'
        '                :cod_cliente, :nome_cliente, :razao, :cpfcgc do'
        '    begin'
        '      suspend;'
        '    end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_DESNEG_CL_CRED ('
        '    PCPFCGC varchar(18),'
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PSTATUS varchar(10),'
        '    PFINANC_DIA_ATUAL char(1),'
        '    PDATA_ATUAL timestamp,'
        '    PDIA_FINANCEIRO timestamp,'
        '    PDATA_VENC_INI timestamp)'
        'returns ('
        '    COD_CRED integer,'
        '    COD_EMP_MULT integer,'
        '    TIPO_DOC_C varchar(15),'
        '    N_CH varchar(20),'
        '    N_DOC_V integer,'
        '    N_DOC_C char(20),'
        '    TP_DOC_V char(6),'
        '    VALOR_C double precision,'
        '    VALOR_CORR double precision,'
        '    DATA_REC_C timestamp,'
        '    DATA_VENC_C timestamp,'
        '    DATA_PREV_REC timestamp,'
        '    DATQ_C timestamp,'
        '    STATUS_C varchar(10),'
        '    CODIGO_CTRL integer,'
        '    NOME_CTRL varchar(35),'
        '    COD_CLIENTE integer,'
        '    NOME_CLIENTE varchar(35),'
        '    RAZAO varchar(60),'
        '    CPFCGC varchar(18))'
        'as'
        'declare variable VSQL_STATUS_BC varchar(1000);'
        'declare variable VSQL_STATUS_CR varchar(1000);'
        'declare variable VSQL_STATUS_CH varchar(1000);'
        'declare variable VSQL_DTVENC_BC varchar(1000);'
        'declare variable VSQL_DTVENC_CR varchar(1000);'
        'declare variable VSQL_DTVENC_CH varchar(1000);'
        'declare variable VSQL_EMPRESA_BC varchar(1000);'
        'declare variable VSQL_EMPRESA_CR varchar(1000);'
        'declare variable VSQL_EMPRESA_CH varchar(1000);'
        'declare variable VSQL_CLIENTE_BC varchar(1000);'
        'declare variable VSQL_CLIENTE_CR varchar(1000);'
        'declare variable VSQL_CLIENTE_CH varchar(1000);'
        'declare variable VSQL varchar(10000);'
        'declare variable VDIAS_CAR_JUROS integer;'
        'declare variable VCOD_BARRADO integer;'
        'declare variable VFINANCEIRO_UNIFICADO char(10);'
        'declare variable VDATA timestamp;'
        'begin'
        '  /* Procedure Text */'
        ''
        
          '  select emp.dias_car_juros, emp.codbarrado, emp.financeiro_unif' +
          'icado from empresa emp'
        '  where emp.cod_empresa = :pcod_empresa'
        
          '    into :vdias_car_juros, :vcod_barrado, :vfinanceiro_unificado' +
          ';'
        ''
        
          '  vsql_dtvenc_cr   = '#39' (bc.data_venc_c + '#39' || coalesce(:vdias_ca' +
          'r_juros, 0) || '#39') '#39';'
        
          '  vsql_dtvenc_cr   = '#39' (cc.data_venc_c + '#39' || coalesce(:vdias_ca' +
          'r_juros, 0) || '#39') '#39';'
        
          '  vsql_dtvenc_ch   = '#39' (ch.data_venc + '#39' || coalesce(:vdias_car_' +
          'juros, 0) || '#39') '#39';'
        ''
        '  if (pfinanc_dia_atual = '#39'A'#39') then'
        '    vdata = :pdata_atual;'
        '  else'
        '    vdata = :pdia_financeiro;'
        ''
        '  if (coalesce(pstatus, '#39#39') = '#39'ABERTO'#39') then'
        '  begin'
        '    vsql_status_bc    = '#39#39';'
        
          '    vsql_status_cr    = '#39' and (cc.status_c is null or cc.status_' +
          'c = '#39#39#39#39') '#39';'
        
          '    vsql_status_ch    = '#39' and (ch.status_ch is null or ch.status' +
          '_ch = '#39#39#39#39') '#39';'
        '  end'
        '  else if (coalesce(pstatus, '#39#39') = '#39'QUITADO'#39') then'
        '  begin'
        '    vsql_status_bc    = '#39#39';'
        
          '    vsql_status_cr    = '#39' and ((not cc.status_c is null) or (cc.' +
          'status_c <> '#39#39#39#39')) '#39';'
        
          '    vsql_status_ch    = '#39' and ((not ch.status_ch is null) or (ch' +
          '.status_ch <> '#39#39#39#39')) '#39';'
        '  end'
        '  else'
        '  begin'
        '    vsql_status_bc    = '#39#39';'
        '    vsql_status_cr    = '#39#39';'
        '    vsql_status_ch    = '#39#39';'
        '  end'
        ''
        '  if (coalesce(vfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') then'
        '  begin'
        
          '    vsql_empresa_bc = '#39' and emp.codigo_unificadora = '#39' || :pcod_' +
          'empresa;'
        
          '    vsql_empresa_cr = '#39' and emp.codigo_unificadora = '#39' || :pcod_' +
          'empresa;'
        
          '    vsql_empresa_ch = '#39' and emp.codigo_unificadora = '#39' || :pcod_' +
          'empresa;'
        '  end'
        '  else'
        '  begin'
        
          '    vsql_empresa_bc = '#39' and bc.cod_emp_mult = '#39' || :pcod_empresa' +
          ';'
        
          '    vsql_empresa_cr = '#39' and cc.cod_emp_mult = '#39' || :pcod_empresa' +
          ';'
        
          '    vsql_empresa_ch = '#39' and ch.cod_emp_mult = '#39' || :pcod_empresa' +
          ';'
        '  end'
        ''
        
          '  if ((vfinanceiro_unificado = '#39'S'#39') and (trim(coalesce(pcpfcgc, ' +
          #39#39')) <> '#39#39')) then'
        '  begin'
        '    vsql_cliente_bc = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '    vsql_cliente_cr = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '    vsql_cliente_ch = '#39' and cl.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39#39';'
        '  end'
        '  else if (coalesce(pcod_cliente, 0) <> 0) then'
        '  begin'
        '    vsql_cliente_bc = '#39' and bc.cod_cliente = '#39' || :pcod_cliente;'
        '    vsql_cliente_cr = '#39' and cc.cod_cliente = '#39' || :pcod_cliente;'
        '    vsql_cliente_ch = '#39' and ch.cod_cliente = '#39' || :pcod_cliente;'
        '  end'
        '  else'
        '  begin'
        '    vsql_cliente_bc = '#39#39';'
        '    vsql_cliente_cr = '#39#39';'
        '    vsql_cliente_ch = '#39#39';'
        '  end'
        ''
        '  vsql ='
        
          '    iif((trim(coalesce(pstatus, '#39#39')) = '#39'AMBOS'#39') or (trim(coalesc' +
          'e(pstatus, '#39#39')) = '#39'QUITADO'#39'),'
        '    '#39' select bc.seq_bxcred, bc.cod_emp_mult, bc.tipo_doc_c,'
        '      null n_ch, bc.n_doc_v, bc.n_doc_c, bc.tp_doc_v,'
        
          '      bc.valor_c, coalesce(bc.valor_corr, bc.valor_c) valor_corr' +
          ','
        
          '      bc.data_rec_c, bc.data_venc_c, cc.data_prev_rec, bc.datq_c' +
          ', '#39#39'QUITADO'#39#39' status_c,'
        '      bc.codigo_ctrl, ctrl.nome_ctrl,'
        
          '      bc.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc from ' +
          'baixa_creditos bc'
        
          '      inner join controle_creditos cc on cc.cod_cred = bc.cod_cr' +
          'ed and cc.codigo_emp = bc.codigo_emp'
        
          '      inner join controles ctrl on ctrl.codigo_ctrl = bc.codigo_' +
          'ctrl and ctrl.codigo_emp = bc.cod_emp_mult'
        '      inner join empresa emp on emp.cod_empresa = bc.codigo_emp'
        
          '      inner join clientes cl on cl.cod_cliente = bc.cod_cliente ' +
          'and cl.cod_empresa = bc.cod_emp_mult'
        '      where bc.tp_operacao = '#39#39'P'#39#39
        '      and bc.cod_cliente > 0'
        '      and bc.data_venc_c >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        '      and bc.datq_c is not null'
        '      and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39
        
          '      and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '#39' ' +
          '|| :vsql_empresa_bc || :vsql_cliente_bc || :vsql_status_bc || '#39
        '      union all '#39', '#39#39') || '#39
        '      select cc.cod_cred, cc.cod_emp_mult, cc.tipo_doc_c,'
        '      null n_ch, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        
          '      cc.valor_c, coalesce(cc.valor_corr, cc.valor_c) valor_corr' +
          ', '
        
          '      cc.data_rec_c, cc.data_venc_c, cc.data_prev_rec, cc.datq_c' +
          ', cc.status_c,'
        '      cc.codigo_ctrl, ctrl.nome_ctrl,'
        
          '      cc.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc from ' +
          'controle_creditos cc'
        
          '      inner join controles ctrl on ctrl.codigo_ctrl = cc.codigo_' +
          'ctrl and ctrl.codigo_emp = cc.cod_emp_mult '
        '      inner join empresa emp on emp.cod_empresa = cc.codigo_emp '
        
          '      inner join clientes cl on cl.cod_cliente = cc.cod_cliente ' +
          'and cl.cod_empresa = cc.cod_emp_mult '
        '      where cc.cod_cliente > 0'
        '      and cc.data_venc_c >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        
          '      '#39' || iif ((trim(coalesce(pstatus, '#39#39')) = '#39'ABERTO'#39'),  '#39' and' +
          ' cc.datq_c is null '#39', '#39#39') || '#39
        
          '      '#39' || iif ((trim(coalesce(pstatus, '#39#39')) = '#39'QUITADO'#39'), '#39' and' +
          ' cc.datq_c is not null '#39', '#39#39') || '#39
        '      and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '
        
          '      and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '#39' ' +
          '|| :vsql_empresa_cr || :vsql_cliente_cr || :vsql_status_cr || '#39
        '      union all '
        
          '      select ch.codigo_ch, ch.cod_emp_mult, '#39#39'CHEQUE'#39#39' tipo_doc_' +
          'c, '
        '      ch.n_ch, ch.n_doc_v, null n_doc_c, ch.tp_doc_v,'
        '      ch.valor_ch, ch.valor_ch, '
        
          '      ch.data_rec, ch.data_venc, ch.data_prev_rec, ch.datq_ch, c' +
          'h.status_ch,'
        '      ch.codigo_ctrl, ctrl.nome_ctrl,'
        
          '      ch.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc from ' +
          'controle_cheque ch'
        
          '      inner join controles ctrl on ctrl.codigo_ctrl = ch.codigo_' +
          'ctrl and ctrl.codigo_emp = ch.cod_emp_mult '
        '      inner join empresa emp on emp.cod_empresa = ch.codigo_emp '
        
          '      inner join clientes cl on cl.cod_cliente = ch.cod_cliente ' +
          'and cl.cod_empresa = ch.cod_emp_mult '
        '      where ch.cod_cliente > 0 '
        '      and ch.data_venc >= '#39#39#39' || :pdata_venc_ini || '#39#39#39
        
          '      '#39' || iif ((trim(coalesce(pstatus, '#39#39')) = '#39'ABERTO'#39'),  '#39' and' +
          ' ch.datq_ch is null '#39', '#39#39') || '#39
        
          '      '#39' || iif ((trim(coalesce(pstatus, '#39#39')) = '#39'QUITADO'#39'), '#39' and' +
          ' ch.datq_ch is not null '#39', '#39#39') || '#39
        '      and coalesce(cl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '
        
          '      and coalesce(ctrl.barramento_automatico, '#39#39'S'#39#39') = '#39#39'S'#39#39' '#39' ' +
          '|| :vsql_empresa_ch || :vsql_cliente_ch || :vsql_status_ch || '#39
        '      order by 2 '#39';'
        ''
        '    for execute statement'
        '      vsql into :cod_cred, :cod_emp_mult, :tipo_doc_c,'
        '                :n_ch, :n_doc_v, :n_doc_c, :tp_doc_v,'
        
          '                :valor_c, :valor_corr, :data_rec_c, :data_venc_c' +
          ', :data_prev_rec, :datq_c, :status_c,'
        '                :codigo_ctrl, :nome_ctrl,'
        '                :cod_cliente, :nome_cliente, :razao, :cpfcgc do'
        '    begin'
        '      suspend;'
        '    end'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CAR111'#39', :COD_EMPRESA, '#39'BT' +
          ' INFORMAR DATA PREV REC CHEQUE'#39', 5, '#39'.'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DA' +
          'TE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CAR112'#39', :COD_EMPRESA, '#39'BT' +
          ' INFORMAR DATA PREV REC CHEQUE'#39', 5, '#39'.'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DA' +
          'TE);'
