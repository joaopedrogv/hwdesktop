        'DROP VIEW VW_CONCILIACAO_FINANCEIRO;'
        'DROP VIEW VW_CONCILIACAO_PENDENCIAS_CONF;'
        'DROP VIEW VW_CONCILIACAO_FINANCEIRO_REC;'
