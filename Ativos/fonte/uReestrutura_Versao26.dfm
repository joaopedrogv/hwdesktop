          's.codigo_emp'
        '    inner join controles on'
        '      controles.codigo_ctrl = controle_creditos.codigo_ctrl'
        '      and controles.codigo_emp = controle_creditos.codigo_emp'
        
          '      and trim(coalesce(controles.exibir_doc, '#39'A'#39')) in ('#39#39', '#39'A'#39',' +
          ' '#39'S'#39')'
        '    inner join clientes on'
        '      clientes.cod_cliente = controle_creditos.cod_cliente'
        '      and clientes.cod_empresa = controle_creditos.cod_emp_mult'
        '    where controle_creditos.datq_c is null'
        '    and controle_creditos.cod_cliente = :pcod_cliente'
        
          '    and controle_creditos.data_venc_c + empresa.dias_car_juros <' +
          ' current_date'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else controle_creditos.codigo_emp end) = ' +
          ':pcod_empresa'
        '      into :valor_cred;'
        '  end'
        ''
        '  valor_cred = coalesce(valor_cred, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
