          ', emp.codigo_unificadora, ch.codigo_emp) = iif(emp.financeiro_un' +
          'ificado = '#39'S'#39', emp.codigo_unificadora, pr.codigo_emp)) = 0) then'
        '        1'
        '    else'
        '        (select count(*) from controle_cheque ch'
        '         where ch.lote_quit = pr.lote_quit'
        
          '         and ch.datq_ch = iif(emp.financeiro_unificado = '#39'S'#39', pr' +
          '.datq_ch, ch.datq_ch)'
        
          '         and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unif' +
          'icadora, ch.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', em' +
          'p.codigo_unificadora, pr.codigo_emp))'
