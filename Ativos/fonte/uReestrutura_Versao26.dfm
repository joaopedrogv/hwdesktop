          '      '#39' where controle_creditos.cod_cliente = '#39' || :pcod_cliente' +
          ';'
        ''
        '  vsql = vsql ||'
        '    '#39' and controle_creditos.data_venc_c < current_date'
        
          '      and ((controle_creditos.status_c is null) or (controle_cre' +
          'ditos.status_c = '#39#39#39#39')) '#39';'
        ''
        
          '  if ((coalesce(pfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coalesce' +
          '(pcpfcgc, '#39#39') <> '#39#39')) then'
        '    vsql = vsql ||'
        '      '#39' and empresa.codigo_unificadora = '#39' || :pcod_empresa;'
        '  else'
        '    vsql = vsql ||'
        '      '#39' and controle_creditos.codigo_emp = '#39' || :pcod_empresa;'
        ''
        '  execute statement'
        
          '    vsql into :vvalor_debito_atraso, :vqtde_debito_atraso, :vmed' +
          'ia_debito_atraso;'
        ''
        
          '  valor_debito_atraso = coalesce(valor_debito_atraso, 0) + coale' +
          'sce(vvalor_debito_atraso, 0);'
        
          '  qtde_debito_atraso  = coalesce(qtde_debito_atraso, 0)  + coale' +
          'sce(vqtde_debito_atraso, 0);'
        
          '  media_debito_atraso = coalesce(media_debito_atraso, 0) + coale' +
          'sce(vmedia_debito_atraso, 0);'
        ''
        '  vsql ='
        '    '#39' select'
        '      sum(coalesce(controle_creditos.valor_c, 0)) valor,'
        '      count(*) qtde,'
        
          '      sum(case when (controle_creditos.data_venc_c > current_dat' +
          'e) then'
        '                 0'
        '               else'
        
          '                 datediff(day, controle_creditos.data_venc_c, cu' +
          'rrent_date)'
        '      end) media from controle_creditos'
        
          '      left join empresa on empresa.cod_empresa = controle_credit' +
          'os.cod_emp_mult'
        '      inner join controles on'
        '        controles.codigo_ctrl = controle_creditos.codigo_ctrl'
        '        and controles.codigo_emp = controle_creditos.codigo_emp'
        
          '        and trim(coalesce(controles.exibir_doc, '#39#39'A'#39#39')) in ('#39#39#39#39 +
          ', '#39#39'A'#39#39', '#39#39'S'#39#39')'
        '      inner join clientes on'
        '        clientes.cod_cliente = controle_creditos.cod_cliente'
        
          '        and clientes.cod_empresa = controle_creditos.cod_emp_mul' +
          't '#39';'
        ''
        
          '  if ((coalesce(pfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coalesce' +
          '(pcpfcgc, '#39#39') <> '#39#39')) then'
        '    vsql = vsql ||'
        '      '#39' where clientes.cpfcgc = '#39#39#39' || :pcpfcgc || '#39#39#39' '#39';'
        '  else'
        '    vsql = vsql ||'
        
          '      '#39' where controle_creditos.cod_cliente = '#39' || :pcod_cliente' +
          ';'
        '  '
        '  vsql = vsql ||'
        
          '    '#39' and controle_creditos.data_venc_c + '#39' || :pdias_carencia_j' +
          'uros || '#39' < current_date'
        
          '      and ((controle_creditos.status_c is null) or (controle_cre' +
          'ditos.status_c = '#39#39#39#39')) '#39';'
        '  '
        
          '  if ((coalesce(pfinanceiro_unificado, '#39'N'#39') = '#39'S'#39') and (coalesce' +
          '(pcpfcgc, '#39#39') <> '#39#39')) then'
        '    vsql = vsql ||'
        '      '#39' and empresa.codigo_unificadora = '#39' || :pcod_empresa;'
        '  else'
        '    vsql = vsql ||'
        '      '#39' and controle_creditos.codigo_emp = '#39' || :pcod_empresa;'
        ''
        '  execute statement'
        
          '    vsql into :vvalor_debito_atraso_car, :vqtde_debito_atraso_ca' +
          'r, :vmedia_debito_atraso_car;'
        ''
        
          '  valor_debito_atraso_car = coalesce(valor_debito_atraso_car, 0)' +
          ' + coalesce(vvalor_debito_atraso_car, 0);'
        
          '  qtde_debito_atraso_car  = coalesce(qtde_debito_atraso_car, 0) ' +
          ' + coalesce(vqtde_debito_atraso_car, 0);'
        
          '  media_debito_atraso_car = coalesce(media_debito_atraso_car, 0)' +
          ' + coalesce(vmedia_debito_atraso_car, 0);'
        ''
        '  if (coalesce(qtde_debito, 0) > 0) then'
        
          '    media_debito = coalesce(media_debito, 0) / coalesce(qtde_deb' +
          'ito, 0);'
        '  else'
        '    media_debito = coalesce(media_debito, 0);'
        ''
        '  if (coalesce(qtde_debito_atraso, 0) > 0) then'
        
          '    media_debito_atraso = coalesce(media_debito_atraso, 0) / coa' +
          'lesce(qtde_debito_atraso, 0);'
        '  else'
        '    media_debito_atraso = coalesce(media_debito_atraso, 0);'
        ''
        '  if (coalesce(qtde_debito_atraso_car, 0) > 0) then'
        
          '    media_debito_atraso_car = coalesce(media_debito_atraso_car, ' +
          '0) / coalesce(qtde_debito_atraso_car, 0);'
        '  else'
        
          '    media_debito_atraso_car = coalesce(media_debito_atraso_car, ' +
          '0);'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter view DET_RECEBIMENTOS_CC;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_RECEBIMENTOS_CC('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE,'
        '    DATA_LOTE)'
        'AS'
        'select distinct l.cod_lanc,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else l.codigo_emp end codigo_emp,'
        '    l.cod_emp_mult,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else l.codigo_emp end codigo_emp,'
        '    '
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            0'
        '                          else'
        '                            888888'
        '                     end'
        '                   else'
        '                     case when ctr.codigo_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   666666'
        '                                 else'
        '                                   0'
        '                            end'
        '                          else'
        '                            ctr.codigo_ctrl'
        '                     end'
        '              end),'
        '    0) codigo_ctrl,'
        ''
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            '#39'SEM FORMA'#39
        '                          else'
        '                            '#39'RECIBO ANTECIPADO'#39
        '                     end'
        '                   else'
        '                     case when ctr.nome_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   '#39'DEVOLUCAO'#39
        '                                 else'
        '                                   '#39'SEM FORMA'#39
        '                            end'
        '                          else'
        '                            ctr.nome_ctrl'
        '                     end'
        '              end),'
        '    '#39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          '    case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then coalesce(pr.' +
          'valor_quitado, pr.valor_c) else coalesce(l.valor_l, 0) end valor' +
          '_pago,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        ''
        
          '    coalesce(case when (ctr.nome_ctrl is null) then 0 else ctr.n' +
          'ome_ctrl end, '#39'SEM FORMA'#39') tipo_doc_c,'
        ''
        '    l.n_conta_plc,'
        '    pr.lote_quit,'
        '    pr.datq_c from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_c'
        '        and l.tipo_l = '#39'E'#39
        '    left join controles ctr on'
        '        ctr.codigo_ctrl = l.codigo_ctrl'
        '        and ctr.codigo_emp = l.codigo_emp'
        '    left join CONTROLES ctr1 on'
        '        ctr1.codigo_ctrl = pr.codigo_ctrl'
        '        and ctr1.codigo_emp = pr.codigo_emp'
        
          '    where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_c is not' +
          ' null'
        ''
        '    union all'
        ''
        '    select distinct pr.seq_bxcred,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end codigo_emp,'
        '    pr.cod_emp_mult,'
        '    pr.cod_emp_lote, '
        ''
        '    999999 codigo_ctrl,'
        ''
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        ''
        '    coalesce(pr.valor_quitado, 0) valor_pago,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    pr.datq_c,'
        '    pr.historico_c,'
        '    pr.n_doc_c,'
        '    pr.data_rec_c,'
        ''
        '    '#39'CONTAS A PAGAR'#39' historico_l,'
        ''
        '    0 n_conta_plc,'
        '    pr.lote_quit,'
        '    pr.datq_c'
        ''
        '    from baixa_creditos pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        '    where pr.tip_baixa = '#39'C'#39' and pr.datq_c is not null;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter view DET_RECEBIMENTOS_CH;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DET_RECEBIMENTOS_CH('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_EMP_LOTE,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    VALOR,'
        '    NOME,'
        '    STATUS,'
        '    DATA_VENC,'
        '    HISTORICO,'
        '    N_CH,'
        '    DATA_REC,'
        '    TIPO_DOC_C,'
        '    N_CONTA_PLC,'
        '    LOTE,'
        '    DATA_LOTE)'
        'AS'
        'select distinct l.cod_lanc,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else l.codigo_emp end codigo_emp,'
        '    l.cod_emp_mult,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else l.codigo_emp end codigo_emp,'
        '    '
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            0'
        '                          else'
        '                            888888'
        '                     end'
        '                   else'
        '                     case when ctr.codigo_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   666666'
        '                                 else'
        '                                   0'
        '                            end'
        '                          else'
        '                            ctr.codigo_ctrl'
        '                     end'
        '              end),'
        '    0) codigo_ctrl,'
        ''
        
          '    coalesce((case when (((select count(*) from hist_rec hist wh' +
          'ere hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codi' +
          'go_emp) > 0)'
        
          '                    and ((l.historico_l like '#39'%RECIBOS ATENCIPAD' +
          'OS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                     case when (l.tipo_l = '#39'S'#39') then'
        '                            '#39'SEM FORMA'#39
        '                          else'
        '                            '#39'RECIBO ANTECIPADO'#39
        '                     end'
        '                   else'
        '                     case when ctr.nome_ctrl is null then'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   '#39'DEVOLUCAO'#39
        '                                 else'
        '                                   '#39'SEM FORMA'#39
        '                            end'
        '                          else'
        '                            ctr.nome_ctrl'
        '                     end'
        '              end),'
        '    '#39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          '    case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then coalesce(pr.' +
          'valor_ch, 0) else coalesce(l.valor_l, 0) end valor_pago,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    l.data,'
        '    l.historico_l,'
        '    l.ndoc_l,'
        '    l.dtreferencia,'
        ''
        
          '    coalesce(case when (ctr.nome_ctrl is null) then 0 else ctr.n' +
          'ome_ctrl end, '#39'SEM FORMA'#39') tipo_doc_c,'
        ''
        '    l.n_conta_plc,'
        '    pr.lote_quit,'
        '    pr.datq_ch from controle_cheque pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        '    left join lancamentos l on'
        '        l.lote_ent = pr.lote_quit'
        
          '        and iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_unifi' +
          'cadora, l.codigo_emp) = iif(emp.financeiro_unificado = '#39'S'#39', emp.' +
          'codigo_unificadora, pr.codigo_emp)'
        '        and l.data = pr.datq_ch'
        '        and l.tipo_l = '#39'E'#39
        '    left join controles ctr on'
        '        ctr.codigo_ctrl = l.codigo_ctrl'
        '        and ctr.codigo_emp = l.codigo_emp'
        '    left join CONTROLES ctr1 on'
        '        ctr1.codigo_ctrl = pr.codigo_ctrl'
        '        and ctr1.codigo_emp = pr.codigo_emp'
        
          '    where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_ch is no' +
          't null'
        ''
        '    union all'
        ''
        '    select distinct pr.codigo_ch,'
        
          '    case when (emp.financeiro_unificado = '#39'S'#39') then emp.codigo_u' +
          'nificadora else pr.codigo_emp end codigo_emp,'
        '    pr.cod_emp_mult,'
        '    pr.cod_emp_lote, '
        ''
        '    999999 codigo_ctrl,'
        ''
        '    '#39'CONTAS A PAGAR'#39' nome_ctrl,'
        ''
        '    coalesce(pr.valor_ch, 0) valor_pago,'
        '    '#39#39' nome_c,'
        '    '#39'QUITADO'#39' status,'
        '    pr.datq_ch,'
        '    pr.historico_ch,'
        '    pr.n_doc_v,'
        '    pr.data_rec,'
        ''
        '    '#39'CONTAS A PAGAR'#39' historico_l,'
        ''
        '    0 n_conta_plc,'
        '    pr.lote_quit,'
        '    pr.datq_ch'
        ''
        '    from controle_cheque pr'
        '    left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        '    where pr.tip_baixa = '#39'C'#39' and pr.datq_ch is not null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_PAG_CTP ('
        '    PLOTE integer,'
        '    PDATA_LOTE timestamp,'
        '    PCOD_EMPRESA integer,'
        '    PVER_FORMAS integer,'
        '    PFORM_PAG varchar(200) character set WIN1252)'
        'returns ('
        '    ENCONTROU integer,'
        '    FORM_PAG varchar(200),'
        '    FORM_PAG2 varchar(200))'
        'as'
        'declare variable VTEMP varchar(200);'
        'declare variable VTEMP2 varchar(200);'
        'declare variable VCONTROLE varchar(35);'
        'declare variable VVALOR double precision;'
        'begin'
        '  /* Procedure Text */'
        '  encontrou = 0;'
        '  form_pag = '#39#39';'
        '  form_pag2 = '#39#39';'
        ''
        '  if (coalesce(pver_formas, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (trim(coalesce(pform_pag, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_uni' +
          'ficadora, det.cod_emp_lote) = iif(emp.financeiro_unificado = '#39'S'#39 +
          ', emp.codigo_unificadora, :pcod_empresa)'
        '        and det.lote = :plote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          ':pdata_lote, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp2, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39')) ||'
        
          '                '#39' (R$'#39' || trim(cast(cast(vvalor as numeric(12, 2' +
          ')) as varchar(24))) || '#39')'#39';'
        '    end'
        ''
        '    if (character_length(vtemp) > 200) then'
        '      form_pag = trim(substring(trim(vtemp) from 1 for 200));'
        '    else'
        '      form_pag = trim(vtemp);'
        ''
        '    if (character_length(vtemp2) > 200) then'
        '      form_pag2 = trim(substring(trim(vtemp2) from 1 for 200));'
        '    else'
        '      form_pag2 = trim(vtemp2);'
        '    suspend;'
        '  end'
        '  else'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_pagamentos det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', det.cod_emp_lo' +
          'te, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          ':pdata_lote, det.data_lote)'
        '        and det.parcial is null'
        '        and det.renegociacao is null'
        '        and det.nome_ctrl like :pform_pag'
        '        group by 1'
        '        order by 1'
        '      into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
        ''
        '      vtemp2 = trim(coalesce(vtemp2, '#39#39')) ||'
