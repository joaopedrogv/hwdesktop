          'CREATE INDEX IDX_CONTAS_A_PAGAR_CONTR_LNC ON CONTAS_A_PAGAR (COD' +
          '_CONTRAPARTIDA, CODIGO_EMP);'
        
          'CREATE INDEX IDX_CONTAS_A_PAGAR_CONTR_CTP ON CONTAS_A_PAGAR (COD' +
          '_CONTRAPARTIDA_CTP, CODIGO_EMP);'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_FORMAS ('
        '    PNDOC integer,'
        '    PTIPODOC varchar(6),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    NDOC integer,'
        '    TIPODOC varchar(6),'
        '    DATA_MOV timestamp,'
        '    VALOR_TOTAL double precision,'
        '    ENTRADA double precision,'
        '    CREDIARIO char(1),'
        '    VALOR_VALE double precision,'
        '    JUROS double precision,'
        '    PRCSS char(1))'
        'as'
        'declare variable VSQL varchar(600);'
        'declare variable VCONFFORMPAGAMENTO varchar(3);'
        'declare variable VNF integer;'
        'declare variable VSERIE integer;'
        'declare variable VTEMP varchar(400);'
        'begin'
        '  VSQL = '#39#39';'
        '  VTEMP = '#39#39';'
        '  /* Procedure Text */'
        
          '  select conf_formpagamento from empresa where cod_empresa = 1 i' +
          'nto :vconfformpagamento;'
        
          '  if ((trim(coalesce(vconfformpagamento, '#39'PED'#39')) = '#39'PED'#39') or (tr' +
          'im(coalesce(ptipodoc, '#39#39')) = '#39'PRE'#39')) then'
        '  begin'
        '    select first 1 fp.nrequisicao, fp.tpdocs, fp.data_mov,'
        ''
        
          '    coalesce((select sum(coalesce(fp2.valordoc, 0)) from formpag' +
          'amento fp2'
        
          '    where fp2.nrequisicao = fp.nrequisicao and fp2.tpdocs = fp.t' +
          'pdocs and fp2.cod_empresa = fp.cod_empresa), 0) valor_total,'
        ''
        
          '    coalesce((select sum(coalesce(fp3.valordoc, 0)) from formpag' +
          'amento fp3'
        
          '    inner join controles ctr3 on fp3.cod_controle = ctr3.codigo_' +
          'ctrl and fp3.cod_empresa = ctr3.codigo_emp and ctr3.docs = '#39'N'#39
        
          '    where fp3.nrequisicao = fp.nrequisicao and fp3.tpdocs = fp.t' +
          'pdocs and fp3.cod_empresa = fp.cod_empresa), 0) entrada,'
        ''
        
          '    coalesce((case when (coalesce((select coalesce(count(*), 0) ' +
          'from formpagamento fp4'
        
          '    inner join controles ctr4 on ctr4.codigo_ctrl = fp4.cod_cont' +
          'role and ctr4.codigo_emp = fp4.cod_empresa'
        
          '    where fp4.nrequisicao = fp.nrequisicao and fp4.tpdocs = fp.t' +
          'pdocs and fp4.cod_empresa = fp.cod_empresa'
        
          '    and trim(ctr4.fp_regra_fidelidade) = '#39'CR'#39'), 0) > 0) then '#39'S'#39 +
          ' else '#39'N'#39' end), '#39'N'#39') crediario,'
        ''
        
          '    coalesce((select sum(coalesce(fp5.valordoc, 0)) from formpag' +
          'amento fp5'
        
          '    where fp5.nrequisicao = fp.nrequisicao and fp5.tpdocs = fp.t' +
          'pdocs and fp5.cod_empresa = fp.cod_empresa'
        '    and fp5.ativo = 1 and fp5.prg_fid = '#39'S'#39'), 0) valor_vale,'
        ''
        
          '    coalesce((case when coalesce((select coalesce(count(*), 0) f' +
          'rom formpagamento fp6'
        
          '    where fp6.nrequisicao = fp.nrequisicao and fp6.tpdocs = fp.t' +
          'pdocs and fp6.cod_empresa = fp.cod_empresa'
        
          '    and fp6.prcss = '#39'S'#39'), 0) > 0 then '#39'S'#39' else '#39'N'#39' end), '#39'N'#39') pr' +
          'css,'
        ''
        
          '    (coalesce((select sum(coalesce(fp7.vl_juros, 0)) from formpa' +
          'gamento fp7'
        
          '    where fp7.nrequisicao = fp.nrequisicao and fp7.tpdocs = fp.t' +
          'pdocs and fp7.cod_empresa = fp.cod_empresa), 0) +'
        
          '    coalesce((select sum(coalesce(fp7.vl_juros, 0)) from formpag' +
          'amento fp7'
        
          '    inner join hist_rec h on h.ndocant = fp7.nrequisicao and h.t' +
          'p_doc_baixa = fp7.tpdocs and h.cod_empresa = fp7.cod_empresa'
        
          '    where h.ndocant = fp.nrequisicao and h.tp_doc_baixa = fp.tpd' +
          'ocs and h.cod_empresa = fp.cod_empresa), 0)) vl_juros'
        ''
        '       from formpagamento fp'
        
          '    where fp.nrequisicao = :pndoc and fp.tpdocs = :ptipodoc and ' +
          'fp.cod_empresa = :pcod_empresa and fp.ativo = 1'
        
          '    into :ndoc, :tipodoc, :data_mov, :valor_total, :entrada, :cr' +
          'ediario, :valor_vale, :prcss, :juros;'
        '  end'
        '  else'
        '  begin'
        '    if (trim(ptipodoc) = '#39'MOT'#39') then'
        '    begin'
        
          '      VSQL = '#39' select cf.num_nota_v as n_nf, cf.sub_serie as ser' +
          'ie from com_fat cf'
        
          '        where cf.n_comando = '#39'||:pndoc||'#39' and cf.cod_empresa = '#39 +
          '||:pcod_empresa;'
        '    end'
        '    else'
        '    begin'
        '      VSQL = '#39' select pp.n_nf, pp.serie from pedvenda_prod pp'
        
          '        where pp.nped = '#39'||:pndoc||'#39' and pp.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and pp.cod_empresa = '#39'||:pcod_empresa||'#39' and pp.ativo = ' +
          '1'
        
          '        and ((pp.status is null) or (pp.status <> '#39#39'CANCELADO'#39#39')' +
          ') and pp.n_nf > 0 and pp.serie <> '#39#39#39#39
        '        union'
        '        select ps.n_nf, ps.serie from pedvenda_serv ps'
        
          '        where ps.nped = '#39'||:pndoc||'#39' and ps.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and ps.cod_empresa = '#39'||:pcod_empresa||'#39' and ps.ativo = ' +
          '1'
        
          '        and ((ps.status is null) or (ps.status <> '#39#39'CANCELADO'#39#39')' +
          ') and ps.n_nf > 0 and ps.serie <> '#39#39#39#39
        '        group by 1,2 '#39';'
        '    end'
        ''
        '    for execute statement VSQL into :vnf, :vserie do'
        '    begin'
        '       if (trim(VTEMP) = '#39#39') then'
        
          '          VTEMP = '#39' ((fp.num_nota = '#39'||:vnf||'#39' and fp.sub_serie ' +
          '= '#39'||:vserie||'#39')'#39';'
        '       else'
        '          VTEMP = VTEMP || '#39' or (fp.num_nota = '#39'||:vnf||'
        '            '#39' and fp.sub_serie = '#39'||:vserie||'#39')'#39';'
        '    end'
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '      VTEMP = VTEMP || '#39')'#39';'
        ''
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '    begin'
        '        execute statement'
        '        '#39' select first 1 fp.nrequisicao, fp.tpdocs, fp.data_mov,'
        
          '          coalesce((select sum(coalesce(fp2.valordoc, 0)) from f' +
          'ormpagamento fp2'
        
          '          where fp2.nrequisicao = fp.nrequisicao and fp2.tpdocs ' +
          '= fp.tpdocs and fp2.cod_empresa = fp.cod_empresa), 0) valor_tota' +
          'l,'
        '    '
        
          '          coalesce((select sum(coalesce(fp3.valordoc, 0)) from f' +
          'ormpagamento fp3'
        
          '          inner join controles ctr3 on fp3.cod_controle = ctr3.c' +
          'odigo_ctrl and fp3.cod_empresa = ctr3.codigo_emp and ctr3.docs =' +
          ' '#39#39'N'#39#39
        
          '          where fp3.nrequisicao = fp.nrequisicao and fp3.tpdocs ' +
          '= fp.tpdocs and fp3.cod_empresa = fp.cod_empresa), 0) entrada,'
        '    '
        
          '          coalesce((case when (coalesce((select coalesce(count(*' +
          '), 0) from formpagamento fp4'
        
          '          inner join controles ctr4 on ctr4.codigo_ctrl = fp4.co' +
          'd_controle and ctr4.codigo_emp = fp4.cod_empresa'
        
          '          where fp4.nrequisicao = fp.nrequisicao and fp4.tpdocs ' +
          '= fp.tpdocs and fp4.cod_empresa = fp.cod_empresa'
        
          '          and trim(ctr4.fp_regra_fidelidade) = '#39#39'CR'#39#39'), 0) > 0) ' +
          'then '#39#39'S'#39#39' else '#39#39'N'#39#39' end), '#39#39'N'#39#39') crediario,'
        '    '
        
          '          coalesce((select sum(coalesce(fp5.valordoc, 0)) from f' +
          'ormpagamento fp5'
        
          '          where fp5.nrequisicao = fp.nrequisicao and fp5.tpdocs ' +
          '= fp.tpdocs and fp5.cod_empresa = fp.cod_empresa'
        
          '          and fp5.ativo = 1 and fp5.prg_fid = '#39#39'S'#39#39'), 0) valor_v' +
          'ale,'
        ''
        
          '          coalesce((case when coalesce((select coalesce(count(*)' +
          ', 0) from formpagamento fp6'
        
          '          where fp6.nrequisicao = fp.nrequisicao and fp6.tpdocs ' +
          '= fp.tpdocs and fp6.cod_empresa = fp.cod_empresa'
        
          '          and fp6.prcss = '#39#39'S'#39#39'), 0) > 0 then '#39#39'S'#39#39' else '#39#39'N'#39#39' e' +
          'nd), '#39#39'N'#39#39') prcss,'
        ''
        
          '          (coalesce((select sum(coalesce(fp7.vl_juros, 0)) from ' +
          'formpagamento fp7'
        
          '          where fp7.nrequisicao = fp.nrequisicao and fp7.tpdocs ' +
          '= fp.tpdocs and fp7.cod_empresa = fp.cod_empresa), 0) +'
        
          '          coalesce((select sum(coalesce(fp7.vl_juros, 0)) from f' +
          'ormpagamento fp7'
        
          '          inner join hist_rec h on h.ndocant = fp7.nrequisicao a' +
          'nd h.tp_doc_baixa = fp7.tpdocs and h.cod_empresa = fp7.cod_empre' +
          'sa'
        
          '          where h.ndocant = fp.nrequisicao and h.tp_doc_baixa = ' +
          'fp.tpdocs and h.cod_empresa = fp.cod_empresa), 0)) vl_juros'
        ''
        ''
        '             from formpagamento fp'
        
          '          where '#39'||:VTEMP||'#39' and fp.tpdocs <> '#39#39'LCS'#39#39' and fp.cod' +
          '_empresa = '#39'||:pcod_empresa||'#39
        '          and fp.ativo = 1 '#39
        
          '          into :ndoc, :tipodoc, :data_mov, :valor_total, :entrad' +
          'a, :crediario, :valor_vale, :prcss, :juros;'
        '      end'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_PAGAMENTOS ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO integer,'
        '    TIPOLANC varchar(10),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    LOTE integer,'
        '    NATUREZA char(1),'
        '    CODIGO_CTRL integer,'
        '    N_CONTA_PLC double precision,'
        '    NCHEQUE varchar(20),'
        '    NDOC varchar(20),'
        '    VALOR double precision,'
        '    DATA timestamp,'
        '    DATAVENCIMENTO timestamp,'
        '    DTREFERENCIA timestamp,'
        '    DATAQUITACAO timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  select first 1 * from ('
        '    select lanc.cod_lanc as codigo, '#39'LANC'#39' tipolanc,'
        
          '    lanc.codigo_emp as cod_empresa, lanc.cod_emp_mult, lanc.lote' +
          ' as lote,'
        '    lanc.tipo_l as natureza, lanc.codigo_ctrl, lanc.n_conta_plc,'
        
          '    lanc.n_cheq_l as ncheque, lanc.ndoc_l as ndoc, lanc.valor_l,' +
          ' lanc.data, null datavencimento,'
        
          '    lanc.dtreferencia, lanc.datq_l as dataquitacao from lancamen' +
          'tos lanc'
        
          '    inner join controles ctrl on ctrl.codigo_ctrl = lanc.codigo_' +
          'ctrl and ctrl.codigo_emp = lanc.codigo_emp'
        '    where ctrl.docs = '#39'N'#39
        '    union all'
        '    select ch.codigo_ch as codigo, '#39'CH'#39' tipolanc,'
        
          '    coalesce(ch.cod_emp_lote, ch.codigo_emp) as cod_empresa, ch.' +
          'cod_emp_mult, ch.lote as lote,'
        '    '#39'E'#39' as natureza, ch.codigo_ctrl, ch.n_conta_plc,'
        
          '    ch.n_ch as ncheque, ch.n_doc_v as ndoc, ch.valor_ch, ch.data' +
          '_rec as data, ch.data_venc as datavencimento,'
        
          '    ch.data_rec as dtreferencia, ch.datq_ch as dataquitacao from' +
          ' controle_cheque ch'
        '    union all'
        '    select cc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(cc.cod_emp_lote, cc.codigo_emp) as cod_empresa, cc.' +
          'cod_emp_mult, cc.lote as lote,'
        '    '#39'E'#39' as natureza, cc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque, cc.n_doc_c as ndoc, cc.valor_c, cc.data_rec_c ' +
          'as data, cc.data_venc_c as datavencimento,'
        
          '    cc.data_rec_c as dtreferencia, cc.datq_c as dataquitacao fro' +
          'm controle_creditos cc'
        '    union all'
        '    select bc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(bc.cod_emp_lote, bc.codigo_emp) as cod_empresa, bc.' +
          'cod_emp_mult, bc.lote as lote,'
        '    '#39'E'#39' as natureza, bc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque,bc.n_doc_c, bc.valor_quitado, bc.data_rec_c as ' +
          'data, bc.data_venc_c as datavencimento,'
        
          '    bc.data_rec_c as dtreferencia, bc.datq_c as dataquitacao fro' +
          'm baixa_creditos bc'
        
          '    inner join controle_creditos cc on cc.cod_cred = bc.cod_cred' +
          ' and cc.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '  ) pag'
        '  where pag.lote = :plote'
        '  and pag.cod_empresa = :pcod_empresa'
        '    into :codigo, :tipolanc,'
        '        :cod_empresa, :cod_emp_mult, :lote,'
        '        :natureza, :codigo_ctrl, :n_conta_plc,'
        
          '        :ncheque, :ndoc, :valor, :data, :datavencimento, :dtrefe' +
          'rencia, :dataquitacao;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_RECEBIMENTOS ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO integer,'
        '    TIPOLANC varchar(10),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    LOTE integer,'
        '    NATUREZA char(1),'
        '    CODIGO_CTRL integer,'
        '    N_CONTA_PLC double precision,'
        '    NCHEQUE varchar(20),'
        '    NDOC varchar(20),'
        '    VALOR double precision,'
        '    DATA timestamp,'
        '    DATAVENCIMENTO timestamp,'
        '    DTREFERENCIA timestamp,'
        '    DATAQUITACAO timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  select first 1 * from ('
        '    select lanc.cod_lanc as codigo, '#39'LANC'#39' tipolanc,'
        
          '    lanc.codigo_emp as cod_empresa, lanc.cod_emp_mult, lanc.lote' +
          '_ent as lote,'
        '    lanc.tipo_l as natureza, lanc.codigo_ctrl, lanc.n_conta_plc,'
        
          '    lanc.n_cheq_l as ncheque, lanc.ndoc_l as ndoc, lanc.valor_l,' +
          ' lanc.data, null datavencimento,'
        
          '    lanc.dtreferencia, lanc.datq_l as dataquitacao from lancamen' +
          'tos lanc'
        '    where lanc.tipo_l = '#39'E'#39
        '    union all'
        '    select ch.codigo_ch as codigo, '#39'CH'#39' tipolanc,'
        
          '    ch.codigo_emp as cod_empresa, ch.cod_emp_mult, ch.lote_ent a' +
          's lote,'
        '    '#39'E'#39' as natureza, ch.codigo_ctrl, ch.n_conta_plc,'
        
          '    ch.n_ch as ncheque, ch.n_doc_v as ndoc, ch.valor_ch, ch.data' +
          '_rec as data, ch.data_venc as datavencimento,'
        
          '    ch.data_rec as dtreferencia, ch.datq_ch as dataquitacao from' +
          ' controle_cheque ch'
        '    union all'
        '    select cc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    cc.codigo_emp as cod_empresa, cc.cod_emp_mult, cc.lote_ent a' +
          's lote,'
        '    '#39'E'#39' as natureza, cc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque, cc.n_doc_c as ndoc, cc.valor_c, cc.data_rec_c ' +
          'as data, cc.data_venc_c as datavencimento,'
        
          '    cc.data_rec_c as dtreferencia, cc.datq_c as dataquitacao fro' +
          'm controle_creditos cc'
        '    union all'
        '    select bc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    bc.codigo_emp as cod_empresa, bc.cod_emp_mult, bc.lote_ent a' +
          's lote,'
        '    '#39'E'#39' as natureza, bc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque,bc.n_doc_c, bc.valor_quitado, bc.data_rec_c as ' +
          'data, bc.data_venc_c as datavencimento,'
        
          '    bc.data_rec_c as dtreferencia, bc.datq_c as dataquitacao fro' +
          'm baixa_creditos bc'
        
          '    inner join controle_creditos cc on cc.cod_cred = bc.cod_cred' +
          ' and cc.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '  ) rec'
        '  where rec.lote = :plote'
        '  and rec.cod_empresa = :pcod_empresa'
        '    into :codigo, :tipolanc,'
        '        :cod_empresa, :cod_emp_mult, :lote,'
        '        :natureza, :codigo_ctrl, :n_conta_plc,'
        
          '        :ncheque, :ndoc, :valor, :data, :datavencimento, :dtrefe' +
          'rencia, :dataquitacao;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_PERMUTA ('
        '    PLOTE integer,'
        '    PTIPOLOTE varchar(10),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  result = 0;'
        ''
        '  if (coalesce(plote, 0) = 0) then'
        '  begin'
        '    result = coalesce(result, 0);'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  if ((coalesce(ptipolote, '#39#39') = '#39'CH'#39') or (coalesce(ptipolote, '#39 +
          #39') = '#39'CC'#39') or (coalesce(ptipolote, '#39#39') = '#39'BC'#39')) then'
        '  begin'
        '    select count(*) from contas_a_pagar cp'
        '    where cp.lote = :plote'
        '    and cp.codigo_emp = :pcod_empresa'
        '    and cp.datq_ctp is not null'
        '      into :result;'
        ''
        '    if (coalesce(result, 0) > 0) then'
        '    begin'
        '     result = coalesce(result, 0);'
        '     suspend;'
        '     exit;'
        '    end'
        '  end'
        '  else'
        '  begin'
        '    select count(*) from controle_cheque ch'
        '    where ch.lote = :plote'
        '    and ch.codigo_emp = :pcod_empresa'
        '    and ch.datq_ch is not null'
        '      into :result;'
        ''
        '    if (coalesce(result, 0) > 0) then'
        '    begin'
        '      result = coalesce(result, 0);'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '    select count(*) from controle_creditos cc'
        '    where cc.lote = :plote'
        '    and cc.codigo_emp = :pcod_empresa'
        '    and cc.datq_c is not null'
        '      into :result;'
        ''
        '    if (coalesce(result, 0) > 0) then'
        '    begin'
        '      result = coalesce(result, 0);'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '    select count(*) from baixa_creditos bc'
        '    where bc.lote = :plote'
        '    and bc.codigo_emp = :pcod_empresa'
        '    and bc.tip_baixa = '#39'P'#39
        '    and bc.datq_c is not null'
        '      into :result;'
        ''
        '    if (coalesce(result, 0) > 0) then'
        '    begin'
        '      result = coalesce(result, 0);'
        '      suspend;'
        '      exit;'
        '    end'
        ''
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_RECIBO ('
        '    PLOTE integer,'
        '    PTIPOLOTE varchar(10),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  result = 0;'
        ''
        '  if (coalesce(plote, 0) = 0) then'
        '  begin'
        '    result = coalesce(result, 0);'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  if ((coalesce(ptipolote, '#39#39') = '#39'CH'#39') or (coalesce(ptipolote, '#39 +
          #39') = '#39'CC'#39') or (coalesce(ptipolote, '#39#39') = '#39'BC'#39')) then'
        '  begin'
        '    select count(*) from hist_rec hist'
        '    where hist.lote_quit = :plote'
        '    and hist.cod_empresa = :pcod_empresa'
        '      into :result;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure FORMAS_DET ('
        '    PNDOC integer,'
        '    PTIPODOC varchar(6),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    SEQFORM integer,'
        '    COD_EMPRESA integer,'
        '    NDOC varchar(20),'
        '    DATA_MOV timestamp,'
        '    DATA_VENC timestamp,'
        '    VALORDOC double precision,'
        '    COD_CONTROLE integer,'
        '    NOME_CTRL varchar(35),'
        '    N_CONTA_PLC double precision,'
        '    DOCS char(2),'
        '    NPARCELA integer,'
        '    SECAO integer,'
        '    REC_TIPVEND char(3),'
        '    REC_NUMVEND integer,'
        '    RECIBO char(1),'
        '    COD_CLIENTE integer,'
        '    HISTORICO varchar(100),'
        '    PRG_FID char(1),'
        '    QTDE_REG integer)'
        'as'
        'declare variable VSQL varchar(600);'
        'declare variable VCONFFORMPAGAMENTO varchar(3);'
        'declare variable VNF integer;'
        'declare variable VSERIE integer;'
        'declare variable VTEMP varchar(400);'
        'declare variable VTEMP2 varchar(400);'
        'begin'
        '  VSQL = '#39#39';'
        '  VTEMP = '#39#39';'
        '  VTEMP2 = '#39#39';'
        '  /* Procedure Text */'
        
          '  select conf_formpagamento from empresa where cod_empresa = 1 i' +
          'nto :vconfformpagamento;'
        
          '  if ((trim(coalesce(vconfformpagamento, '#39#39')) = '#39'PED'#39') or (trim(' +
          'coalesce(ptipodoc, '#39#39')) = '#39'PRE'#39')) then'
        '  begin'
        
          '    for select fp.seqform, fp.cod_empresa, fp.ndoc, fp.data_mov,' +
          ' fp.data_venc,'
        
          '    fp.valordoc, fp.cod_controle, ctr.nome_ctrl, fp.n_conta_plc,' +
          ' ctr.docs,'
        
          '    fp.nparcela, fp.secao, fp.rec_tipvend, fp.rec_numvend, fp.re' +
          'cibo, fp.cod_cliente, fp.historico, fp.prg_fid,'
        '        coalesce((select count(*) from formpagamento fp2'
        
          '        where fp2.nrequisicao = fp.nrequisicao and fp2.tpdocs = ' +
          'fp.tpdocs and fp2.cod_empresa = fp.cod_empresa), 0)'
        '    from formpagamento fp'
        
          '    inner join controles ctr on ctr.codigo_ctrl = fp.cod_control' +
          'e and ctr.codigo_emp = fp.cod_empresa'
        
          '    where fp.nrequisicao = :pndoc and fp.tpdocs = :ptipodoc and ' +
          'fp.cod_empresa = :pcod_empresa'
        '    and fp.ativo = 1'
        
          '    into :seqform, :cod_empresa, :ndoc, :data_mov, :data_venc, :' +
          'valordoc, :cod_controle, :nome_ctrl, :n_conta_plc, :docs,'
        
          '      :nparcela, :secao, :rec_tipvend, :rec_numvend, :recibo, :c' +
          'od_cliente, :historico, :prg_fid, :qtde_reg do'
        '      suspend;'
        '  end'
        '  else'
        '  begin'
        '    if (trim(ptipodoc) = '#39'MOT'#39') then'
        '    begin'
        
          '      VSQL = '#39' select cf.num_nota_v as n_nf, cf.sub_serie as ser' +
          'ie from com_fat cf'
        
          '        where cf.n_comando = '#39'||:pndoc||'#39' and cf.cod_empresa = '#39 +
          '||:pcod_empresa;'
        '    end'
        '    else'
        '    begin'
        '      VSQL = '#39' select pp.n_nf, pp.serie from pedvenda_prod pp'
        
          '        where pp.nped = '#39'||:pndoc||'#39' and pp.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and pp.cod_empresa = '#39'||:pcod_empresa||'#39' and pp.ativo = ' +
          '1'
        
          '        and ((pp.status is null) or (pp.status <> '#39#39'CANCELADO'#39#39')' +
          ') and pp.n_nf > 0 and pp.serie <> '#39#39#39#39
        '        union'
        '        select ps.n_nf, ps.serie from pedvenda_serv ps'
        
          '        where ps.nped = '#39'||:pndoc||'#39' and ps.tipo = '#39#39#39'||:ptipodo' +
          'c||'#39#39#39
        
          '        and ps.cod_empresa = '#39'||:pcod_empresa||'#39' and ps.ativo = ' +
          '1'
        
          '        and ((ps.status is null) or (ps.status <> '#39#39'CANCELADO'#39#39')' +
          ') and ps.n_nf > 0 and ps.serie <> '#39#39#39#39
        '        group by 1,2 '#39';'
        '    end'
        ''
        '    for execute statement VSQL into :vnf, :vserie do'
        '    begin'
        '       if (trim(VTEMP) = '#39#39') then'
        '       begin'
        
          '          VTEMP = '#39' ((fp.num_nota = '#39'||:vnf||'#39' and fp.sub_serie ' +
          '= '#39'||:vserie||'#39')'#39';'
        
          '          VTEMP2 = '#39' ((fp2.num_nota = '#39'||:vnf||'#39' and fp2.sub_ser' +
          'ie = '#39'||:vserie||'#39')'#39';'
        '       end'
        '       else'
        '       begin'
        
          '          VTEMP = VTEMP || '#39' or (fp.num_nota = '#39'||:vnf||'#39' and fp' +
          '.sub_serie = '#39'||:vserie||'#39')'#39';'
        
          '          VTEMP2 = VTEMP2 || '#39' or (fp2.num_nota = '#39'||:vnf||'#39' and' +
          ' fp2.sub_serie = '#39'||:vserie||'#39')'#39';'
        '       end'
        '    end'
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '    begin'
        '      VTEMP = VTEMP || '#39')'#39';'
        '      VTEMP2 = VTEMP2 || '#39')'#39';'
        '    end'
        ''
        '    if (trim(coalesce(VTEMP, '#39#39')) <> '#39#39') then'
        '    begin'
        '        for execute statement'
        
          '        '#39' select fp.seqform, fp.cod_empresa, fp.ndoc, fp.data_mo' +
          'v, fp.data_venc,'
        
          '          fp.valordoc, fp.cod_controle, ctr.nome_ctrl, fp.n_cont' +
          'a_plc, ctr.docs,'
        
          '          fp.nparcela, fp.secao, fp.rec_tipvend, fp.rec_numvend,' +
          ' fp.recibo, fp.cod_cliente, fp.historico, fp.prg_fid,'
        '             coalesce((select count(*) from formpagamento fp2'
        
          '             where '#39'||:VTEMP2||'#39' and fp2.tpdocs <> '#39#39'LCS'#39#39' and f' +
          'p2.cod_empresa = '#39'||:pcod_empresa||'#39
        '             and fp2.ativo = 1), 0)'
        '          from formpagamento fp'
        
          '          inner join controles ctr on ctr.codigo_ctrl = fp.cod_c' +
          'ontrole and ctr.codigo_emp = fp.cod_empresa'
        
          '          where '#39'||:VTEMP||'#39' and fp.tpdocs <> '#39#39'LCS'#39#39' and fp.cod' +
          '_empresa = '#39'||:pcod_empresa||'#39
        '          and fp.ativo = 1 '#39
        
          '          into :seqform, :cod_empresa, :ndoc, :data_mov, :data_v' +
          'enc, :valordoc, :cod_controle, :nome_ctrl, :n_conta_plc, :docs,'
        
          '          :nparcela, :secao, :rec_tipvend, :rec_numvend, :recibo' +
          ', :cod_cliente, :historico, :prg_fid, :qtde_reg do'
        '            suspend;'
        '      end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure PAGAMENTOS_DET ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO integer,'
        '    TIPOLANC varchar(10),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    LOTE integer,'
        '    NATUREZA char(1),'
        '    CODIGO_CTRL integer,'
        '    N_CONTA_PLC double precision,'
        '    NCHEQUE varchar(20),'
        '    NDOC varchar(20),'
        '    VALOR double precision,'
        '    DATA timestamp,'
        '    DATAVENCIMENTO timestamp,'
        '    DTREFERENCIA timestamp,'
        '    DATAQUITACAO timestamp,'
        '    NPARCELA integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  for select * from ('
        '    select lanc.cod_lanc as codigo, '#39'LANC'#39' tipolanc,'
        
          '    lanc.codigo_emp as cod_empresa, lanc.cod_emp_mult, lanc.lote' +
          ' as lote,'
        '    lanc.tipo_l as natureza, lanc.codigo_ctrl, lanc.n_conta_plc,'
        
          '    lanc.n_cheq_l as ncheque, lanc.ndoc_l as ndoc, lanc.valor_l,' +
          ' lanc.data, null datavencimento,'
        
          '    lanc.dtreferencia, lanc.datq_l as dataquitacao, null nparcel' +
          'a from lancamentos lanc'
        
          '    inner join controles ctrl on ctrl.codigo_ctrl = lanc.codigo_' +
          'ctrl and ctrl.codigo_emp = lanc.codigo_emp'
        '    where ctrl.docs = '#39'N'#39
        '    union all'
        '    select ch.codigo_ch as codigo, '#39'CH'#39' tipolanc,'
        
          '    coalesce(ch.cod_emp_lote, ch.codigo_emp) as cod_empresa, ch.' +
          'cod_emp_mult, ch.lote as lote,'
        '    '#39'E'#39' as natureza, ch.codigo_ctrl, ch.n_conta_plc,'
        
          '    ch.n_ch as ncheque, ch.n_doc_v as ndoc, ch.valor_ch, ch.data' +
          '_rec as data, ch.data_venc as datavencimento,'
        
          '    ch.data_rec as dtreferencia, ch.datq_ch as dataquitacao, nul' +
          'l nparcela from controle_cheque ch'
        '    union all'
        '    select cc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(cc.cod_emp_lote, cc.codigo_emp) as cod_empresa, cc.' +
          'cod_emp_mult, cc.lote as lote,'
        '    '#39'E'#39' as natureza, cc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque, cc.n_doc_c as ndoc, cc.valor_c, cc.data_rec_c ' +
          'as data, cc.data_venc_c as datavencimento,'
        
          '    cc.data_rec_c as dtreferencia, cc.datq_c as dataquitacao, cc' +
          '.nparcela from controle_creditos cc'
        '    union all'
        '    select bc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(bc.cod_emp_lote, bc.codigo_emp) as cod_empresa, bc.' +
          'cod_emp_mult, bc.lote as lote,'
        '    '#39'E'#39' as natureza, bc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque,bc.n_doc_c, bc.valor_quitado, bc.data_rec_c as ' +
          'data, bc.data_venc_c as datavencimento,'
        
          '    bc.data_rec_c as dtreferencia, bc.datq_c as dataquitacao, cc' +
          '.nparcela from baixa_creditos bc'
        
          '    inner join controle_creditos cc on cc.cod_cred = bc.cod_cred' +
          ' and cc.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '  ) pag'
        '  where pag.lote = :plote'
        '  and pag.cod_empresa = :pcod_empresa'
        '    into :codigo, :tipolanc,'
        '        :cod_empresa, :cod_emp_mult, :lote,'
        '        :natureza, :codigo_ctrl, :n_conta_plc,'
        
          '        :ncheque, :ndoc, :valor, :data, :datavencimento, :dtrefe' +
          'rencia, :dataquitacao, :nparcela do'
        '     suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RECEBIMENTOS_DET ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO integer,'
        '    TIPOLANC varchar(10),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    LOTE integer,'
        '    NATUREZA char(1),'
        '    HISTORICO varchar(100),'
        '    COD_CLIENTE integer,'
        '    CODIGO_CTRL integer,'
        '    N_CONTA_PLC double precision,'
        '    NCHEQUE varchar(20),'
        '    NDOC varchar(20),'
        '    VALOR double precision,'
        '    DATA timestamp,'
        '    DATAVENCIMENTO timestamp,'
        '    DTREFERENCIA timestamp,'
        '    DATAQUITACAO timestamp,'
        '    NPARCELA integer,'
        '    NOSSO_NUMERO_BANCO varchar(20),'
        '    COD_COBREBEM integer,'
        '    COD_ADM integer,'
        '    N_DOCNSU_ADM varchar(10),'
        '    N_AUT_CART varchar(20),'
        '    TAXA_COBRANCA double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  for select * from ('
        '    select lanc.cod_lanc as codigo, '#39'LANC'#39' tipolanc,'
        
          '    lanc.codigo_emp as cod_empresa, lanc.cod_emp_mult, lanc.lote' +
          '_ent as lote,'
        
          '    lanc.tipo_l as natureza, lanc.historico_l as historico, null' +
          ' cod_cliente,  lanc.codigo_ctrl, lanc.n_conta_plc,'
        
          '    lanc.n_cheq_l as ncheque, lanc.ndoc_l as ndoc, lanc.valor_l,' +
          ' lanc.data, null datavencimento,'
        
          '    lanc.dtreferencia, lanc.datq_l as dataquitacao, null nparcel' +
          'a,'
        '    null nosso_numero_banco, null cod_cobrebem,'
        
          '    null cod_adm, null n_docnsu_adm, null n_aut_cart, null taxa_' +
          'cobranca from lancamentos lanc'
        '    where lanc.tipo_l = '#39'E'#39
        '    union all'
        '    select ch.codigo_ch as codigo, '#39'CH'#39' tipolanc,'
        
          '    ch.codigo_emp as cod_empresa, ch.cod_emp_mult, ch.lote_ent a' +
          's lote,'
        
          '    '#39'E'#39' as natureza, ch.historico_ch as historico, ch.cod_client' +
          'e, ch.codigo_ctrl, ch.n_conta_plc,'
        
          '    ch.n_ch as ncheque, ch.n_doc_v as ndoc, ch.valor_ch, ch.data' +
          '_rec as data, ch.data_venc as datavencimento,'
        
          '    ch.data_rec as dtreferencia, ch.datq_ch as dataquitacao, nul' +
          'l nparcela,'
        '    null nosso_numero_banco, null cod_cobrebem,'
        
          '    null cod_adm, null n_docnsu_adm, null n_aut_cart, null taxa_' +
          'cobranca  from controle_cheque ch'
        '    union all'
        '    select cc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    cc.codigo_emp as cod_empresa, cc.cod_emp_mult, cc.lote_ent a' +
          's lote,'
        
          '    '#39'E'#39' as natureza, cc.historico_c as historico, cc.cod_cliente' +
          ', cc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque, cc.n_doc_c as ndoc, cc.valor_c, cc.data_rec_c ' +
          'as data, cc.data_venc_c as datavencimento,'
        
          '    cc.data_rec_c as dtreferencia, cc.datq_c as dataquitacao, cc' +
          '.nparcela,'
        '    cc.nosso_numero_banco, cc.cod_cobrebem,'
        
          '    cc.cod_adm, cc.n_docnsu_adm, cc.n_aut_cart, cc.taxa_cobranca' +
          ' from controle_creditos cc'
        '    union all'
        '    select bc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    bc.codigo_emp as cod_empresa, bc.cod_emp_mult, bc.lote_ent a' +
          's lote,'
        
          '    '#39'E'#39' as natureza, bc.historico_c as historico, bc.cod_cliente' +
          ', bc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque,bc.n_doc_c, bc.valor_quitado, bc.data_rec_c as ' +
          'data, bc.data_venc_c as datavencimento,'
        
          '    bc.data_rec_c as dtreferencia, bc.datq_c as dataquitacao, cc' +
          '.nparcela,'
        '    cc.nosso_numero_banco, cc.cod_cobrebem,'
        
          '    cc.cod_adm, cc.n_docnsu_adm, cc.n_aut_cart, cc.taxa_cobranca' +
          ' from baixa_creditos bc'
        
          '    inner join controle_creditos cc on cc.cod_cred = bc.cod_cred' +
          ' and cc.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '  ) rec'
        '  where rec.lote = :plote'
        '  and rec.cod_empresa = :pcod_empresa'
        '    into :codigo, :tipolanc,'
        '        :cod_empresa, :cod_emp_mult, :lote,'
        
          '        :natureza, :historico, :cod_cliente, :codigo_ctrl, :n_co' +
          'nta_plc,'
        
          '        :ncheque, :ndoc, :valor, :data, :datavencimento, :dtrefe' +
          'rencia, :dataquitacao, :nparcela,'
        '        :nosso_numero_banco, :cod_cobrebem,'
        '        :cod_adm, :n_docnsu_adm, :n_aut_cart, :taxa_cobranca do'
        '    suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_BAIXA_REC ('
        '    PNRECIBO integer,'
        '    PTIPO_BAIXA varchar(10),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    SEQCAD_REC integer,'
        '    COD_EMPRESA integer,'
        '    NRECIBO integer,'
        '    VALOR_BAIXA double precision,'
        '    VALOR_RECIBO double precision,'
        '    DATA_REC timestamp,'
        '    RECANT char(1),'
        '    NDOCANT integer,'
        '    DATA_BAIXA timestamp,'
        '    HISTORICO_REC varchar(50),'
        '    ATIVO integer,'
        '    COD_US integer,'
        '    TP_DOC_BAIXA char(3),'
        '    TP_BAIXA char(1),'
        '    LOTE_QUIT integer,'
        '    COD_UNIFICADA integer,'
        '    OP_CXL integer)'
        'as'
        'declare variable VSQL varchar(100);'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(pnrecibo, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  vsql = '#39#39';'
        '  if (coalesce(ptipo_baixa, '#39#39') = '#39'MANUAL'#39') then'
        '    vsql = '#39' and hist.tp_doc_baixa is null '#39';'
        
          '  else if ((coalesce(ptipo_baixa, '#39#39') = '#39'REQ'#39') or (coalesce(ptip' +
          'o_baixa, '#39#39') = '#39'OS'#39'))  then'
        '    vsql = '#39' and hist.tp_doc_baixa = '#39#39#39' || :ptipo_baixa || '#39#39';'
        
          '  else if ((coalesce(ptipo_baixa, '#39#39') = '#39'PRE'#39') or (coalesce(ptip' +
          'o_baixa, '#39#39') = '#39'CC'#39') or (coalesce(ptipo_baixa, '#39#39') = '#39'CH'#39'))  the' +
          'n'
        '    vsql = '#39' and hist.tp_doc_baixa = '#39#39'PRE'#39#39' '#39';'
        ''
        '  execute statement'
        
          '    '#39' select first 1 hist.seqcad_rec, hist.cod_empresa, hist.nre' +
          'cibo, hist.valor_baixa, hist.valor_recibo, hist.data_rec, hist.r' +
          'ecant,'
        
          '      hist.ndocant, hist.data_baixa, hist.historico_rec, hist.at' +
          'ivo, hist.cod_us,'
        
          '      hist.tp_doc_baixa, hist.tp_baixa, hist.lote_quit, hist.cod' +
          '_unificada, hist.op_cxl from hist_rec hist'
        '      where hist.nrecibo = '#39' || :pnrecibo || '#39
        '      and hist.cod_empresa ='#39' || :pcod_empresa || :vsql'
        
          '        into :seqcad_rec, :cod_empresa, :nrecibo, :valor_baixa, ' +
          ':valor_recibo, :data_rec, :recant,'
        
          '             :ndocant, :data_baixa, :historico_rec, :ativo, :cod' +
          '_us,'
        
          '             :tp_doc_baixa, :tp_baixa, :lote_quit, :cod_unificad' +
          'a, :op_cxl;'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure BAIXA_REC_DET ('
        '    PNRECIBO integer,'
        '    PTIPO_BAIXA char(10),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    SEQCAD_REC integer,'
        '    COD_EMPRESA integer,'
        '    NRECIBO integer,'
        '    VALOR_BAIXA double precision,'
        '    VALOR_RECIBO double precision,'
        '    DATA_REC timestamp,'
        '    RECANT char(1),'
        '    NDOCANT integer,'
        '    DATA_BAIXA timestamp,'
        '    HISTORICO_REC varchar(50),'
        '    ATIVO integer,'
        '    COD_US integer,'
        '    TP_DOC_BAIXA char(3),'
        '    TP_BAIXA char(1),'
        '    LOTE_QUIT integer,'
        '    COD_UNIFICADA integer,'
        '    OP_CXL integer)'
        'as'
        'declare variable VSQL varchar(100);'
        'begin'
        '  /* Procedure Text */'
        ''
        '  vsql = '#39#39';'
        '  if (coalesce(ptipo_baixa, '#39#39') = '#39'MANUAL'#39') then'
        '    vsql = '#39' and hist.tp_doc_baixa is null '#39';'
        
          '  else if ((coalesce(ptipo_baixa, '#39#39') = '#39'REQ'#39') or (coalesce(ptip' +
          'o_baixa, '#39#39') = '#39'OS'#39'))  then'
        '    vsql = '#39' and hist.tp_doc_baixa = '#39#39#39' || :ptipo_baixa || '#39#39';'
        
          '  else if ((coalesce(ptipo_baixa, '#39#39') = '#39'PRE'#39') or (coalesce(ptip' +
          'o_baixa, '#39#39') = '#39'CC'#39') or (coalesce(ptipo_baixa, '#39#39') = '#39'CH'#39'))  the' +
          'n'
        '    vsql = '#39' and hist.tp_doc_baixa = '#39#39'PRE'#39#39' '#39';'
        ''
        '  for execute statement'
        
          '        '#39' select hist.seqcad_rec, hist.cod_empresa, hist.nrecibo' +
          ', hist.valor_baixa, hist.valor_recibo, hist.data_rec, hist.recan' +
          't,'
        
          '          hist.ndocant, hist.data_baixa, hist.historico_rec, his' +
          't.ativo, hist.cod_us,'
        
          '          hist.tp_doc_baixa, hist.tp_baixa, hist.lote_quit, hist' +
          '.cod_unificada, hist.op_cxl from hist_rec hist'
        '          where hist.nrecibo = '#39' || :pnrecibo || '#39
        '          and hist.cod_empresa = '#39' || :pcod_empresa || :vsql'
        
          '       into :seqcad_rec, :cod_empresa, :nrecibo, :valor_baixa, :' +
          'valor_recibo, :data_rec, :recant,'
        
          '            :ndocant, :data_baixa, :historico_rec, :ativo, :cod_' +
          'us,'
        
          '            :tp_doc_baixa, :tp_baixa, :lote_quit, :cod_unificada' +
          ', :op_cxl do'
        '  begin'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure PAGAMENTOS_DET ('
        '    PLOTE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO integer,'
        '    TIPOLANC varchar(10),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    LOTE integer,'
        '    NATUREZA char(1),'
        '    HISTORICO varchar(100),'
        '    COD_CLIENTE integer,'
        '    CODIGO_CTRL integer,'
        '    N_CONTA_PLC double precision,'
        '    NCHEQUE varchar(20),'
        '    NDOC varchar(20),'
        '    VALOR double precision,'
        '    DATA timestamp,'
        '    DATAVENCIMENTO timestamp,'
        '    DTREFERENCIA timestamp,'
        '    DATAQUITACAO timestamp,'
        '    NPARCELA integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  for select * from ('
        '    select lanc.cod_lanc as codigo, '#39'LANC'#39' tipolanc,'
        
          '    lanc.codigo_emp as cod_empresa, lanc.cod_emp_mult, lanc.lote' +
          ' as lote,'
        
          '    lanc.tipo_l as natureza, lanc.historico_l as historico, null' +
          ' cod_cliente, lanc.codigo_ctrl, lanc.n_conta_plc,'
        
          '    lanc.n_cheq_l as ncheque, lanc.ndoc_l as ndoc, lanc.valor_l,' +
          ' lanc.data, null datavencimento,'
        
          '    lanc.dtreferencia, lanc.datq_l as dataquitacao, null nparcel' +
          'a from lancamentos lanc'
        
          '    inner join controles ctrl on ctrl.codigo_ctrl = lanc.codigo_' +
          'ctrl and ctrl.codigo_emp = lanc.codigo_emp'
        '    where ctrl.docs = '#39'N'#39
        '    union all'
        '    select ch.codigo_ch as codigo, '#39'CH'#39' tipolanc,'
        
          '    coalesce(ch.cod_emp_lote, ch.codigo_emp) as cod_empresa, ch.' +
          'cod_emp_mult, ch.lote as lote,'
        
          '    '#39'E'#39' as natureza, ch.historico_ch as historico, ch.cod_client' +
          'e, ch.codigo_ctrl, ch.n_conta_plc,'
        
          '    ch.n_ch as ncheque, ch.n_doc_v as ndoc, ch.valor_ch, ch.data' +
          '_rec as data, ch.data_venc as datavencimento,'
        
          '    ch.data_rec as dtreferencia, ch.datq_ch as dataquitacao, nul' +
          'l nparcela from controle_cheque ch'
        '    union all'
        '    select cc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(cc.cod_emp_lote, cc.codigo_emp) as cod_empresa, cc.' +
          'cod_emp_mult, cc.lote as lote,'
        
          '    '#39'E'#39' as natureza, cc.historico_c as historico, cc.cod_cliente' +
          ', cc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque, cc.n_doc_c as ndoc, cc.valor_c, cc.data_rec_c ' +
          'as data, cc.data_venc_c as datavencimento,'
        
          '    cc.data_rec_c as dtreferencia, cc.datq_c as dataquitacao, cc' +
          '.nparcela from controle_creditos cc'
        '    union all'
        '    select bc.cod_cred as codigo, '#39'CC'#39' tipolanc,'
        
          '    coalesce(bc.cod_emp_lote, bc.codigo_emp) as cod_empresa, bc.' +
          'cod_emp_mult, bc.lote as lote,'
        
          '    '#39'E'#39' as natureza, bc.historico_c as historico, bc.cod_cliente' +
          ', bc.codigo_ctrl, cc.n_conta_plc,'
        
          '    null ncheque,bc.n_doc_c, bc.valor_quitado, bc.data_rec_c as ' +
          'data, bc.data_venc_c as datavencimento,'
        
          '    bc.data_rec_c as dtreferencia, bc.datq_c as dataquitacao, cc' +
          '.nparcela from baixa_creditos bc'
        
          '    inner join controle_creditos cc on cc.cod_cred = bc.cod_cred' +
          ' and cc.codigo_emp = bc.codigo_emp'
        '    where bc.tip_baixa = '#39'P'#39
        '  ) pag'
        '  where pag.lote = :plote'
        '  and pag.cod_empresa = :pcod_empresa'
        '    into :codigo, :tipolanc,'
        '        :cod_empresa, :cod_emp_mult, :lote,'
        
          '        :natureza, :historico, :cod_cliente, :codigo_ctrl, :n_co' +
          'nta_plc,'
        
          '        :ncheque, :ndoc, :valor, :data, :datavencimento, :dtrefe' +
          'rencia, :dataquitacao, :nparcela do'
        '     suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETESTOQUEEMPRESAS ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESAS varchar(50),'
        '    PSOMAR_EMP_SEM_EST integer)'
        'returns ('
        '    ESTOQUE double precision,'
        '    PEND_REQOS double precision,'
        '    PEND_PDC double precision,'
        '    PEND_ALMOX double precision,'
        '    EST_F double precision,'
        '    EST_PRIMA double precision)'
        'as'
        'declare variable VEMPRESA varchar(20);'
        'declare variable VESTOQUE double precision;'
        'declare variable VPEND_REQOS double precision;'
        'declare variable VPEND_PDC double precision;'
        'declare variable VPEND_ALMOX double precision;'
        'declare variable VEST_F double precision;'
        'declare variable VEST_PRIMA double precision;'
        'begin'
        '  /* Procedure Text */'
        '  estoque = 0;'
        '  pend_reqos = 0;'
        '  pend_pdc = 0;'
        '  pend_almox = 0;'
        '  est_f = 0;'
        '  est_prima = 0;'
        ''
        '  vestoque = 0;'
        '  vpend_reqos = 0;'
        '  vpend_pdc = 0;'
        '  vpend_almox = 0;'
        '  vest_f = 0;'
        '  vest_prima = 0;'
        '  for select osplit from p_split (:pcod_empresas, '#39','#39')'
        '    into :vempresa do'
        '  begin'
        
          '    select estoque, pend_reqos, pend_pdc, pend_almox, est_f, est' +
          '_prima  from getestoquedisponivel'
        
          '        (:pgrupo_prod, :pcod_prod, :pcod_grade, :vempresa, 0, '#39#39 +
          ', 0, 0)'
        
          '          into :vestoque, :vpend_reqos, :vpend_pdc, :vpend_almox' +
          ', :vest_f, :vest_prima;'
        ''
        '    if (coalesce(psomar_emp_sem_est, 0) > 0) then'
        '    begin'
        
          '      estoque    = coalesce(estoque, 0)    + coalesce(vestoque, ' +
          '0);'
        
          '      pend_reqos = coalesce(pend_reqos, 0) + coalesce(vpend_reqo' +
          's, 0);'
        
          '      pend_pdc   = coalesce(pend_pdc, 0)   + coalesce(vpend_pdc,' +
          ' 0);'
        
          '      pend_almox = coalesce(pend_almox, 0) + coalesce(vpend_almo' +
          'x, 0);'
        
          '      est_f      = coalesce(est_f, 0)      + coalesce(vest_f, 0)' +
          ';'
        
          '      est_prima  = coalesce(est_prima, 0)  + coalesce(vest_prima' +
          ', 0);'
        '    end'
        '    else if (coalesce(vestoque, 0) > 0) then'
        '    begin'
        
          '      estoque    = coalesce(estoque, 0)    + coalesce(vestoque, ' +
          '0);'
        
          '      pend_reqos = coalesce(pend_reqos, 0) + coalesce(vpend_reqo' +
          's, 0);'
        
          '      pend_pdc   = coalesce(pend_pdc, 0)   + coalesce(vpend_pdc,' +
          ' 0);'
        
          '      pend_almox = coalesce(pend_almox, 0) + coalesce(vpend_almo' +
          'x, 0);'
        
          '      est_f      = coalesce(est_f, 0)      + coalesce(vest_f, 0)' +
          ';'
        
          '      est_prima  = coalesce(est_prima, 0)  + coalesce(vest_prima' +
          ', 0);'
        '    end'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETPRECOEMPRESAS ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESAS varchar(50),'
        '    PCOD_TAB_PRECO integer,'
        '    PUTILIZAR_PRECO varchar(10))'
        'returns ('
        '    PREC_TAB_PROD double precision,'
        '    PREC_PUBLICO double precision,'
        '    COD_TABELA integer,'
        '    DESCR_TABELA varchar(128),'
        '    TIPO_TABELA char(1),'
        '    PRECO_TABELA double precision,'
        '    COD_PROMOCAO integer,'
        '    DESCR_PROMOCAO varchar(128),'
        '    TIPO_PROMOCAO char(1),'
        '    DATA_INI timestamp,'
        '    DATA_FIM timestamp,'
        '    PRECO_PROMOCAO double precision)'
        'as'
        'declare variable VEMPRESA varchar(20);'
        'declare variable VESTOQUE double precision;'
        'declare variable VPREC_TAB_PROD double precision;'
        'declare variable VPREC_PUBLICO double precision;'
        'declare variable VCOD_TABELA integer;'
        'declare variable VDESCR_TABELA varchar(128);'
        'declare variable VTIPO_TABELA char(1);'
        'declare variable VTABPRECO double precision;'
        'declare variable VPROMPRECO double precision;'
        'declare variable VCOD_PROMOCAO integer;'
        'declare variable VDESCR_PROMOCAO varchar(128);'
        'declare variable VTIPO_PROMOCAO char(1);'
        'declare variable VDATA_INI timestamp;'
        'declare variable VDATA_FIM timestamp;'
        'begin'
        '  /* Procedure Text */'
        '  vprec_tab_prod = null;'
        '  vprec_publico  = null;'
        '  vtabpreco      = null;'
        '  vprompreco     = null;'
        ''
        '  prec_tab_prod  = null;'
        '  prec_publico   = null;'
        ''
        '  cod_tabela     = null;'
        '  descr_tabela   = null;'
        '  tipo_tabela    = null;'
        '  preco_tabela   = null;'
        ''
        '  cod_promocao   = null;'
        '  descr_promocao = null;'
        '  tipo_promocao  = null;'
        '  data_ini       = null;'
        '  data_fim       = null;'
        '  preco_promocao = null;'
        ''
        '  for select osplit from p_split (:pcod_empresas, '#39','#39')'
        '    into :vempresa do'
        '  begin'
        '    if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '    begin'
        '      vestoque = 1;'
        '    end'
        '    else'
        '    begin'
        '      select estoque from getestoquedisponivel'
        '          (:pgrupo_prod, :pcod_prod, 0, :vempresa, 0, '#39#39', 0, 0)'
        '            into :vestoque;'
        '    end'
        ''
        '    if (coalesce(vestoque, 0) > 0) then'
        '    begin'
        '      select'
        
          '      round(coalesce(produtos.prec_tab_prod, 0), 2) prec_tab_pro' +
          'd,'
        
          '      round(coalesce(produtos.prec_publico, 0), 2) prec_publico ' +
          'from produtos'
        '      where produtos.grupo_prod = :pgrupo_prod'
        '      and produtos.cod_prod = :pcod_prod'
        '      and produtos.cod_empresa = :vempresa'
        '        into :vprec_tab_prod , :vprec_publico;'
        ''
        '      if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '      begin'
        '        prec_tab_prod = vprec_tab_prod;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MAIOR'#39') a' +
          'nd (coalesce(vprec_tab_prod, 0) > coalesce(prec_tab_prod, 0))) t' +
          'hen'
        '      begin'
        '        prec_tab_prod = vprec_tab_prod;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MENOR'#39') a' +
          'nd ((coalesce(prec_tab_prod, 0) = 0) or (coalesce(vprec_tab_prod' +
          ', 0) < coalesce(prec_tab_prod, 0)))) then'
        '      begin'
        '        prec_tab_prod = vprec_tab_prod;'
        '      end'
        ''
        '      if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '      begin'
        '        prec_publico = vprec_publico;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MAIOR'#39') a' +
          'nd (coalesce(vprec_publico, 0) > coalesce(prec_publico, 0))) the' +
          'n'
        '      begin'
        '        prec_publico = vprec_publico;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MENOR'#39') a' +
          'nd ((coalesce(prec_publico, 0) = 0) or (coalesce(vprec_publico, ' +
          '0) < coalesce(prec_publico, 0)))) then'
        '      begin'
        '        prec_publico = vprec_publico;'
        '      end'
        '            '
        '      if (coalesce(pcod_tab_preco, 0) > 0) then'
        '      begin'
        '        select first 1'
        '        promocao.cod_promocao,'
        '        promocao.descr_promocao,'
        '        tipo_preco.tipo,'
        
          '        round(coalesce(promocao_produto.valor_promocao, 0), 2) f' +
          'rom produtos'
        '        inner join promocao_produto on'
        '          promocao_produto.grupo_prod = produtos.grupo_prod'
        '          and promocao_produto.cod_prod = produtos.cod_prod'
        
          '          and promocao_produto.cod_empresa = produtos.cod_empres' +
          'a'
        '        inner join promocao on'
        '          promocao.cod_promocao = promocao_produto.cod_promocao'
        
          '          and promocao.cod_empresa = promocao_produto.cod_empres' +
          'a'
        '          and promocao.ativo = 1'
        '        left join tipo_preco on'
        
          '            tipo_preco.cod_tppreco = promocao_produto.cod_tpprec' +
          'o'
        
          '            and tipo_preco.cod_empresa = promocao_produto.cod_em' +
          'presa'
        '        where promocao_produto.grupo_prod = :pgrupo_prod'
        '        and promocao_produto.cod_prod = :pcod_prod'
        '        and promocao_produto.cod_empresa = :vempresa'
        '        and promocao_produto.cod_promocao = :pcod_tab_preco'
        
          '          into :vcod_tabela, :vdescr_tabela, :vtipo_tabela, :vta' +
          'bpreco;'
        '      end'
        '      else'
        '      begin'
        '        select'
        '        0 cod_tabela,'
        '        '#39'PRECO PADRAO VAREJO'#39' descr_tabela,'
        '        '#39'V'#39' tipo_tabela,'
        
          '        round(coalesce(produtos.prec_tab_prod, 0), 2) from produ' +
          'tos'
        '        where produtos.grupo_prod = :pgrupo_prod'
        '        and produtos.cod_prod = :pcod_prod'
        '        and produtos.cod_empresa = :vempresa'
        
          '          into :vcod_tabela, :vdescr_tabela, :vtipo_tabela, :vta' +
          'bpreco;'
        '      end  '
        ''
        '      if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '      begin'
        '        cod_tabela   = vcod_tabela;'
        '        descr_tabela = vdescr_tabela;'
        '        tipo_tabela  = vtipo_tabela;'
        '        preco_tabela = vtabpreco;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MAIOR'#39') a' +
          'nd (coalesce(vtabpreco, 0) > coalesce(preco_tabela, 0))) then'
        '      begin'
        '        cod_tabela   = vcod_tabela;'
        '        descr_tabela = vdescr_tabela;'
        '        tipo_tabela  = vtipo_tabela;'
        '        preco_tabela = vtabpreco;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MENOR'#39') a' +
          'nd ((coalesce(preco_tabela, 0) = 0) or (coalesce(vtabpreco, 0) <' +
          ' coalesce(preco_tabela, 0)))) then'
        '      begin'
        '        cod_tabela   = vcod_tabela;'
        '        descr_tabela = vdescr_tabela;'
        '        tipo_tabela  = vtipo_tabela;'
        '        preco_tabela = vtabpreco;'
        '      end'
        ''
        '      select first 1'
        '      promocao.cod_promocao,'
        '      promocao.descr_promocao,'
        '      tipo_preco.tipo,'
        '      promocao_produto.data_ini,'
        '      promocao_produto.data_fim,'
        '      case when(promocao_produto.porcentagem > 0) then'
        
          '             round(produtos.prec_tab_prod, 2) - round((round(pro' +
          'dutos.prec_tab_prod * promocao_produto.porcentagem) / 100), 2)'
        '           else'
        '             round(promocao_produto.valor_promocao, 2)'
        '      end valor_promocao from produtos'
        '      inner join promocao_produto on'
        '        promocao_produto.grupo_prod = produtos.grupo_prod'
        '        and promocao_produto.cod_prod = produtos.cod_prod'
        '        and promocao_produto.cod_empresa = produtos.cod_empresa'
        
          '      inner join promocao on promocao.cod_promocao = promocao_pr' +
          'oduto.cod_promocao'
        '        and promocao.cod_empresa = promocao_produto.cod_empresa'
        '        and promocao.ativo = 1'
        '      inner join promocao_ordem_ec on'
        
          '        promocao_ordem_ec.cod_promocao = promocao_produto.cod_pr' +
          'omocao'
        
          '        and promocao_ordem_ec.cod_empresa = promocao_produto.cod' +
          '_empresa'
        
          '      left join tipo_preco on tipo_preco.cod_tppreco = promocao_' +
          'produto.cod_tppreco'
        
          '        and tipo_preco.cod_empresa = promocao_produto.cod_empres' +
          'a'
        '--        and tipo_preco.tipo = '#39'P'#39
        '      where promocao_produto.grupo_prod = :pgrupo_prod'
        '      and promocao_produto.cod_prod = :pcod_prod'
        '      and promocao_produto.cod_empresa = :vempresa'
        
          '      and current_date >= coalesce(promocao_produto.data_ini, pr' +
          'omocao.data_ini)'
        
          '      and current_date <= coalesce(promocao_produto.data_fim, pr' +
          'omocao.data_fim)'
        '      order by promocao_ordem_ec.ordem'
        
          '        into :vcod_promocao, :vdescr_promocao, :vtipo_promocao, ' +
          ':vdata_ini, :vdata_ini, :vprompreco;'
        ''
        '      if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '      begin'
        '        cod_promocao   = vcod_promocao;'
        '        descr_promocao = vdescr_promocao;'
        '        tipo_promocao  = vtipo_promocao;'
        '        data_ini       = vdata_ini;'
        '        data_fim       = vdata_fim;'
        '        preco_promocao = vprompreco;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MAIOR'#39') a' +
          'nd (coalesce(vprompreco, 0) > coalesce(preco_promocao, 0))) then'
        '      begin'
        '        cod_promocao   = vcod_promocao;'
        '        descr_promocao = vdescr_promocao;'
        '        tipo_promocao  = vtipo_promocao;'
        '        data_ini       = vdata_ini;'
        '        data_fim       = vdata_fim;'
        '        preco_promocao = vprompreco;'
        '      end'
        
          '      else if ((trim(coalesce(putilizar_preco, '#39#39')) = '#39'MENOR'#39') a' +
          'nd ((coalesce(preco_promocao, 0) = 0) or (coalesce(vprompreco, 0' +
          ') < coalesce(preco_promocao, 0)))) then'
        '      begin'
        '        cod_promocao   = vcod_promocao;'
        '        descr_promocao = vdescr_promocao;'
        '        tipo_promocao  = vtipo_promocao;'
        '        data_ini       = vdata_ini;'
        '        data_fim       = vdata_fim;'
        '        preco_promocao = vprompreco;'
        '      end'
        '    end'
        ''
        '    if (trim(coalesce(putilizar_preco, '#39#39')) = '#39'PADRAO'#39') then'
        '      break;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES_COM_CONTRATO ADD DIAS_APOS_VENC INTEGER;'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VALOR_CTR ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer,'
        '    PCOD_CLIENTE integer,'
        '    PDIA_VENCIMENTO integer,'
        '    PDIAS_APOS_VENC integer,'
        '    PCOD_VENDEDOR integer,'
        '    PCOD_CONTROLE integer,'
        '    PTIPO_OS varchar(40),'
        '    PGERAR_CONTRATO_CADA_MES integer,'
        '    PDATA_BASE_VENDA timestamp,'
        '    PAGRUPAR_CTR integer,'
        '    PDESCONS_REGRA_CTRL integer)'
        'returns ('
        '    VALOR_CONTRATO double precision,'
        '    VALOR_PROD double precision,'
        '    VALOR_SERV double precision)'
        'as'
        'declare variable VTEMP_SQL varchar(2000);'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(pagrupar_ctr, 0) = 0) then'
        '  begin'
        '    vtemp_sql ='
        '      '#39' select coalesce(ctr1.valor_contrato, 0) valor_contrato,'
        '        coalesce(ctr1.valor_prod, 0) valor_prod,'
        
          '        coalesce(ctr1.valor_serv, 0) valor_serv from clientes_co' +
          'm_contrato ctr1'
        '        where ctr1.cod_contrato = '#39' || :pcod_contrato || '#39
        '        and ctr1.cod_empresa = '#39' || :pcod_empresa;'
        ''
        '    execute statement'
        '      vtemp_sql'
        '        into :valor_contrato, :valor_prod, :valor_serv;'
        '  end'
        '  else'
        '  begin'
        '    vtemp_sql ='
        
          '      '#39' select sum(coalesce(ctr1.valor_contrato, 0)) valor_contr' +
          'ato,'
        '        sum(coalesce(ctr1.valor_prod, 0)) valor_prod,'
        
          '        sum(coalesce(ctr1.valor_serv, 0)) valor_serv from client' +
          'es_com_contrato ctr1'
        '        where ctr1.cod_cliente = '#39' || :pcod_cliente || '#39
        '        and ctr1.cod_empresa = '#39' || :pcod_empresa || '#39
        
          '        and coalesce(ctr1.dia_vencimento, 0) = '#39' || :pdia_vencim' +
          'ento || '#39
        
          '        and coalesce(ctr1.dias_apos_venc, 0) = '#39' || :pdias_apos_' +
          'venc || '#39
        '        and ctr1.cod_vendedor = '#39' || :pcod_vendedor || '#39
        '        and ctr1.cod_controle = '#39' || :pcod_controle || '#39
        '        and ctr1.tipo_os = '#39#39#39' || :ptipo_os || '#39#39#39
        
          '        and coalesce(ctr1.contratos_cada_mes, 1) = '#39' || :pgerar_' +
          'contrato_cada_mes || '#39
        '        and ctr1.status = '#39#39'Ativo'#39#39
        '        and ((ctr1.data_inicial_vigencia is null)'
        
          '              or (ctr1.data_inicial_vigencia <= '#39#39#39' || :pdata_ba' +
          'se_venda || '#39#39#39')) '#39';'
        ''
        '    if (coalesce(pdescons_regra_ctrl, 0) = 0) then'
        '    begin'
        '      vtemp_sql = vtemp_sql ||'
        '        '#39' and (not ctr1.data_inicial_boleto is null)'
        
          '          and (ctr1.data_inicial_boleto <= '#39#39#39' || :pdata_base_ve' +
          'nda || '#39#39#39') '#39';'
        '    end'
        ''
        '    execute statement'
        '      vtemp_sql'
        '        into :valor_contrato, :valor_prod, :valor_serv;'
        '  end'
        ''
        '  valor_contrato = coalesce(valor_contrato, 0);'
        '  valor_prod     = coalesce(valor_prod, 0);'
        '  valor_serv     = coalesce(valor_serv, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VALOR_BOL_CTR ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer,'
        '    PCOD_CLIENTE integer,'
        '    PDIA_VENCIMENTO integer,'
        '    PDIAS_APOS_VENC integer,'
        '    PCOD_VENDEDOR integer,'
        '    PCOD_CONTROLE integer,'
        '    PTIPO_OS varchar(40),'
        '    PGERAR_CONTRATO_CADA_MES integer,'
        '    PDATA_BASE_VENDA timestamp,'
        '    PAGRUPAR_CTR integer,'
        '    PDESCONS_REGRA_CTRL integer)'
        'returns ('
        '    VALOR_BOLETO double precision)'
        'as'
        'declare variable VTEMP_SQL varchar(2000);'
        'begin'
        '  /* Procedure Text */'
        '  valor_boleto = 0;'
        ''
        '  if (coalesce(pagrupar_ctr, 0) = 0) then'
        '  begin'
        '    vtemp_sql ='
        
          '      '#39' select coalesce(ctr1.valor_contrato, 0) from clientes_co' +
          'm_contrato ctr1'
        '        left join controles ctrl on'
        '          ctrl.codigo_ctrl = ctr1.cod_controle'
        '          and ctrl.codigo_emp = ctr1.cod_empresa'
        '        where ctr1.cod_contrato = '#39' || :pcod_contrato || '#39
        '        and ctr1.cod_empresa = '#39' || :pcod_empresa || '#39
        '        and ctr1.status = '#39#39'Ativo'#39#39
        
          '        and ((ctr1.data_inicial_vigencia is null) or (ctr1.data_' +
          'inicial_vigencia <= '#39#39#39' || :pdata_base_venda || '#39#39#39'))'
        
          '        and (not ctr1.data_inicial_boleto is null) and (ctr1.dat' +
          'a_inicial_boleto <= '#39#39#39' || :pdata_base_venda || '#39#39#39')'
        '        and coalesce(ctrl.nao_gera_finan, '#39#39'N'#39#39') <> '#39#39'S'#39#39
        '        and ctrl.usar_boleto = '#39#39'S'#39#39' '#39';'
        ''
        '    execute statement'
        '      vtemp_sql'
        '        into :valor_boleto;'
        '    '
        '    valor_boleto = coalesce(valor_boleto, 0);'
        '  end'
        '  else'
        '  begin'
        '    vtemp_sql ='
        
          '      '#39' select sum(coalesce(ctr1.valor_contrato, 0)) from client' +
          'es_com_contrato ctr1'
        '        left join controles ctrl on'
        '          ctrl.codigo_ctrl = ctr1.cod_controle'
        '          and ctrl.codigo_emp = ctr1.cod_empresa'
        '        where ctr1.cod_cliente = '#39' || :pcod_cliente || '#39
        '        and ctr1.cod_empresa = '#39' || :pcod_empresa || '#39
        
          '        and coalesce(ctr1.dia_vencimento, 0) = '#39' || :pdia_vencim' +
          'ento || '#39
        
          '        and coalesce(ctr1.dias_apos_venc, 0) = '#39' || :pdias_apos_' +
          'venc || '#39
        '        and ctr1.cod_vendedor = '#39' || :pcod_vendedor || '#39
        '        and ctr1.cod_controle = '#39' || :pcod_controle || '#39
        '        and ctr1.tipo_os = '#39#39#39' || :ptipo_os || '#39#39#39
        
          '        and coalesce(ctr1.contratos_cada_mes, 1) = '#39' || :pgerar_' +
          'contrato_cada_mes || '#39
        '        and ctr1.status = '#39#39'Ativo'#39#39
        
          '        and ((ctr1.data_inicial_vigencia is null) or (ctr1.data_' +
          'inicial_vigencia <= '#39#39#39' || :pdata_base_venda || '#39#39#39'))'
        
          '        and (not ctr1.data_inicial_boleto is null) and (ctr1.dat' +
          'a_inicial_boleto <= '#39#39#39' || :pdata_base_venda || '#39#39#39')'
        '        and coalesce(ctrl.nao_gera_finan, '#39#39'N'#39#39') <> '#39#39'S'#39#39
        '        and ctrl.usar_boleto = '#39#39'S'#39#39' '#39';'
        ''
        '    execute statement'
        '      vtemp_sql'
        '        into :valor_boleto;'
        ''
        '    valor_boleto = coalesce(valor_boleto, 0);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_MES_ULT_GER ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer,'
        '    PCOD_CLIENTE integer,'
        '    PDIA_VENCIMENTO integer,'
        '    PDIAS_APOS_VENC integer,'
        '    PCOD_VENDEDOR integer,'
        '    PCOD_CONTROLE integer,'
        '    TIPO_OS varchar(40),'
        '    PGERAR_CONTRATO_CADA_MES integer,'
        '    PDATA_BASE_VENDA timestamp,'
        '    PAGRUPAR_CTR integer,'
        '    PDESCONS_REGRA_CTRL integer)'
        'returns ('
        '    CONTRATOS_CADA_MES integer,'
        '    QTDE_MES_ULT_GER integer)'
        'as'
        'declare variable VTEMP_CTR_MES integer;'
        'declare variable VTEMP_QTDE_MES integer;'
        'declare variable VCTR_MES_PROD integer;'
        'declare variable VCTR_MES_SERV integer;'
        'declare variable VQTDE_MES_PROD integer;'
        'declare variable VQTDE_MES_SERV integer;'
        'declare variable VTEMP_SQL varchar(2000);'
        'begin'
        '  /* Procedure Text */'
        '  contratos_cada_mes   = 0;'
        '  qtde_mes_ult_ger = 0;'
        '  if (coalesce(pagrupar_ctr, 0) = 0) then'
        '  begin'
        '    vtemp_sql ='
        
          '      '#39' select coalesce(ctr.contratos_cada_mes, 1) contratos_cad' +
          'a_mes,'
        
          '               coalesce((select case when (max(pd.data_fech) is ' +
          'null) then'
        
          '                               datediff(month, date '#39#39'01.01.2000' +
          #39#39', cast('#39#39#39' || :pdata_base_venda || '#39#39#39' as timestamp))'
        '                             else'
        
          '                               datediff(month, max(pd.data_fech)' +
          ', cast('#39#39#39' || :pdata_base_venda || '#39#39#39' as timestamp))'
        '                        end'
        '                 from pedvenda pd'
        
          '                 inner join pedvenda_prod pdp on pdp.nped = pd.n' +
          'ped and pdp.tipo = pd.tipo and pdp.cod_empresa = pd.cod_empresa'
        '                 where pdp.cod_contrato = ctr.cod_contrato'
        '                 and pdp.tipo = '#39#39'OS'#39#39
        '                 and pdp.cod_empresa = ctr.cod_empresa'
        '                 and pd.status_ped = '#39#39'FECHADA'#39#39
        
          '                 and (pdp.status <> '#39#39'CANCELADO'#39#39' or pdp.status ' +
          'is null)), 0) qtde_mes_ult_ger'
        ''
        '        from clientes cl'
        
          '        inner join clientes_com_contrato ctr on ctr.cod_cliente ' +
          '= cl.cod_cliente and ctr.cod_empresa = cl.cod_empresa'
        '        where ctr.cod_contrato = '#39' || :pcod_contrato || '#39
        '        and ctr.cod_empresa = '#39' || :pcod_empresa || '#39
        '        order by 1, 2 '#39';'
        ''
        '     execute statement'
        '       vtemp_sql'
