        'CREATE OR ALTER trigger tr_categoria_id for categoria'
        'active before insert or update position 0'
        'AS'
        '  declare variable vcod integer;'
        'begin'
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.id, 0) = 0) then'
        '    begin'
        
          '      select cod from incrementa_codigo (new.cod_empresa, '#39'CATEG' +
          'ORIA'#39') into :vcod;'
        '      new.id = :vcod;'
        '    end'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    if (coalesce(new.id, 0) = 0) then'
        '    begin'
        
          '      select cod from incrementa_codigo (new.cod_empresa, '#39'CATEG' +
          'ORIA'#39') into :vcod;'
        '      new.id = :vcod;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'update categoria set id = cod_categoria where id is null;'
        ''
        'ALTER TABLE MARCA_PROD_EC ADD ID INTEGER;'
