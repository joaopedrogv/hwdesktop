          'CREATE OR ALTER TRIGGER TI_PRECO_QTDE_PPRECO FOR PRECO_PRODUTOS_' +
          'QTDE'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;'
        'begin'
        '  /* Trigger text */'
        '  if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        '  begin'
        '    SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') then'
        '                  1'
        '                else'
        '                  0'
        '           END FROM TIPO_PRECO'
        '    WHERE COD_TPPRECO = 6'
        '    AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VRECALCULAR_PRECOS;'
        ''
        
          '    if ((COALESCE(new.PRECO_VENDA, 0) > 0) and (COALESCE(VRECALC' +
          'ULAR_PRECOS, 0) <= 0)) then'
        '      exit;'
        ''
        '    SELECT CASAS_DECIMAIS FROM EMPRESA'
        '    WHERE COD_EMPRESA = new.COD_EMPRESA'
        '      into :VCASAS_DECIMAIS;'
        ''
        '    VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '    if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '      VCASAS_DECIMAIS = 2;'
        ''
        '    SELECT PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        
          '      if (COALESCE(new.PRECO_VENDA, 0) <> ROUND((new.PROPORCAO_T' +
          'ABELA * :VPREC_TAB_PROD), :VCASAS_DECIMAIS)) then'
        
          '        new.PRECO_VENDA = ROUND((new.PROPORCAO_TABELA * :VPREC_T' +
          'AB_PROD), :VCASAS_DECIMAIS);'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE TIPO_PRECO ADD ARREDONDA_PRECO CHAR(4);'
        'ALTER TABLE PROMOCAO ADD ARREDONDA_PRECO CHAR(4);'
        ''
        
          'delete from config_colunas where componente in ('#39'cdsItemProdReqN' +
          '_'#39', '#39'cdsItemProdOsP_'#39', '#39'cdsItemProdOsS_'#39', '#39'cdsItemProdOsST_'#39', '#39'c' +
          'dsItemProdOsPT_'#39', '#39'cdsItemProdReqR_'#39');'
