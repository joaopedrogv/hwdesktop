          'update clientes_com_contrato set clientes_com_contrato.descr_con' +
          'trato = trim(coalesce((select tipo_servico.desc_servico from tip' +
          'o_servico where tipo_servico.cod_servico = clientes_com_contrato' +
          '.cod_servico), '#39#39')) where clientes_com_contrato.cod_empresa = :c' +
          'od_empresa and clientes_com_contrato.cod_servico > 0 and cliente' +
          's_com_contrato.descr_contrato is null;'
        ''
        
          'update clientes_com_contrato set clientes_com_contrato.descr_con' +
          'trato = trim(coalesce((select first 1 tipo_servico.desc_servico ' +
          'from clientes_com_contrato_serv inner join tipo_servico on tipo_' +
          'servico.cod_servico = clientes_com_contrato_serv.cod_servico whe' +
          're clientes_com_contrato_serv.cod_contrato = clientes_com_contra' +
          'to.cod_contrato and clientes_com_contrato_serv.cod_empresa = cli' +
          'entes_com_contrato.cod_empresa and clientes_com_contrato_serv.co' +
          'd_servico > 0), '#39#39')) where clientes_com_contrato.cod_empresa = :' +
          'cod_empresa and clientes_com_contrato.cod_servico = 0 and client' +
          'es_com_contrato.descr_contrato is null;'
