          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CFG060'#39', :COD_EMPRESA, '#39'VE' +
          'RIFICAR BACKUP'#39', 1, '#39'FRMCONFIGURACAOSERVICO'#39', 1, '#39'N'#39', '#39'S'#39', CURRE' +
          'NT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CFG061'#39', :COD_EMPRESA, '#39'NA' +
          'O VERIFICAR BACKUP'#39', 10, '#39'FRMCONFIGURACAOSERVICO'#39', 1, '#39'S'#39', '#39'S'#39', ' +
          'CURRENT_DATE);'
        ''
        'delete from config_colunas where componente = '#39'cdsMarcas'#39';'
        'delete from config_colunas where componente = '#39'cdsMensMobile'#39';'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, FORM, ATIVO, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CFG062'#39', :COD_EMPRESA, '#39'PE' +
          'RM BACKUP SERVIDOR PROPRIA UNIDADE DIRETORIO BD'#39', 100, '#39'S'#39', '#39'FRM' +
          'CONFIGURACAOSERVICO'#39', 1, '#39'S'#39', CURRENT_DATE);'
        ''
        'ALTER TABLE CONTROLE_ALMOXARIFADO ADD PRECOPORQTDE CHAR(1);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND297'#39', :COD_EMPRESA, '#39'HA' +
          'B CAMPO VALOR UN PRODUTOS COM PRECO DIFERENCIADO'#39', 11, '#39'FRMCADPE' +
          'DVENDA'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND298'#39', :COD_EMPRESA, '#39'HA' +
          'B CAMPO VALOR UN PRODUTOS COM PRECO PROMOCAO'#39', 11, '#39'FRMCADPEDVEN' +
          'DA'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND299'#39', :COD_EMPRESA, '#39'HA' +
          'B CAMPO VALOR UN PRODUTOS COM PRECO POR QTDE'#39', 11, '#39'FRMCADPEDVEN' +
          'DA'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NIVEL_PROCESSO = (SELECT NIVEL_PROCE' +
          'SSO FROM TABELA_PROCESSOS WHERE COD_PROCESSO = '#39'VND285'#39' AND COD_' +
          'EMPRESA = :COD_EMPRESA) WHERE COD_PROCESSO = '#39'VND297'#39' AND COD_EM' +
          'PRESA = :COD_EMPRESA;'
        
          'UPDATE TABELA_PROCESSOS SET NIVEL_PROCESSO = (SELECT NIVEL_PROCE' +
          'SSO FROM TABELA_PROCESSOS WHERE COD_PROCESSO = '#39'VND286'#39' AND COD_' +
          'EMPRESA = :COD_EMPRESA) WHERE COD_PROCESSO = '#39'VND298'#39' AND COD_EM' +
          'PRESA = :COD_EMPRESA;'
        
          'UPDATE TABELA_PROCESSOS SET NIVEL_PROCESSO = (SELECT NIVEL_PROCE' +
          'SSO FROM TABELA_PROCESSOS WHERE COD_PROCESSO = '#39'VND226'#39' AND COD_' +
          'EMPRESA = :COD_EMPRESA) WHERE COD_PROCESSO = '#39'VND299'#39' AND COD_EM' +
          'PRESA = :COD_EMPRESA;'
        ''
        'ALTER TABLE PROMOCAO ADD USAR_DEBCRED CHAR(1);'
        'ALTER TABLE TIPO_PRECO ADD USAR_DEBCRED CHAR(1);'
        'ALTER TABLE PRODUTOS ADD USAR_DEBCRED CHAR(1);'
        'ALTER TABLE PROMOCAO_PRODUTO ADD USAR_DEBCRED CHAR(1);'
        'ALTER TABLE PRECO_PRODUTOS_QTDE ADD USAR_DEBCRED CHAR(1);'
        ''
        
          'UPDATE PROMOCAO SET USAR_DEBCRED = '#39'S'#39' WHERE USAR_DEBCRED IS NUL' +
          'L;'
        
          'UPDATE TIPO_PRECO SET USAR_DEBCRED = '#39'S'#39' WHERE DESCR_TIPO = '#39'LOC' +
          'ALIDADE'#39' AND USAR_DEBCRED IS NULL;'
        
          'UPDATE TIPO_PRECO SET USAR_DEBCRED = '#39'S'#39' WHERE DESCR_TIPO = '#39'SET' +
          'OR'#39' AND USAR_DEBCRED IS NULL;'
        
          'UPDATE TIPO_PRECO SET USAR_DEBCRED = '#39'S'#39' WHERE DESCR_TIPO = '#39'CID' +
          'ADE'#39' AND USAR_DEBCRED IS NULL;'
        
          'UPDATE TIPO_PRECO SET USAR_DEBCRED = '#39'S'#39' WHERE DESCR_TIPO = '#39'QUA' +
          'NTIDADE'#39' AND USAR_DEBCRED IS NULL;'
        ''
        'ALTER TABLE PEDVENDA_PROD ADD USAR_DEBCRED CHAR(1);'
        'ALTER TABLE DEVOLUCAO ADD USAR_DEBCRED CHAR(1);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_DEVOLUCAO_DEBCRED FOR DEVOLUCAO'
        'ACTIVE AFTER INSERT OR DELETE POSITION 0'
        'AS'
        '  declare variable vdescricao varchar(48);'
        '  declare variable vpercetual_dc t_vl_todos;'
        '  declare variable vpercetual_dc_temp t_vl_todos;'
        '  declare variable vdebcred t_vl_todos;'
        '  declare variable vempusadebcred char(1);'
        '  declare variable vlancdebcred_dev char(1);'
        '  declare variable current_t timestamp;'
        '  declare variable current_d timestamp;'
        '  /*declare variable vtipo_os varchar(10);*/'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.usar_debcred, '#39'S'#39') = '#39'N'#39') then'
        '      exit;'
        '  end'
        '  else'
        '  begin'
        '    if (coalesce(old.usar_debcred, '#39'S'#39') = '#39'N'#39') then'
        '      exit;'
        '  end'
        ''
        '  /*vtipo_os='#39#39'; */'
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.tipo, '#39#39') <> '#39'D'#39') then'
        '      exit;'
        ''
        
          '    select coalesce(e.usardebitocredito, '#39#39') as usardebitocredit' +
          'o,'
        '    coalesce(e.perc_lancdebcred_dev, 0) as perc_lancdebcred_dev,'
        '    coalesce(p.perc_lancdebcred_dev, 0) as perc_lancdebcre_dev2,'
        
          '    coalesce(e.lancdebcred_dev, '#39#39') as lancdebcred_dev from empr' +
          'esa e'
        '    inner join produtos p on e.cod_empresa = p.cod_empresa'
        '    where p.grupo_prod = new.grupo_prod'
        '    and p.cod_prod = new.cod_prod'
        '    and e.cod_empresa = new.cod_empresa'
        
          '      into :vempusadebcred, :vpercetual_dc, :vpercetual_dc_temp,' +
          ' :vlancdebcred_dev;'
        ''
        
          '    if ((vempusadebcred <> '#39'S'#39') or ((vpercetual_dc <= 0) and (vp' +
          'ercetual_dc_temp <= 0)) or (vlancdebcred_dev <> '#39'S'#39') ) then'
        '      exit;'
        ''
        '    /*if (rtrim(coalesce(new.tipo_venda,'#39#39'))='#39'OS'#39') then'
        '      select v.tipo_os from pedvenda v'
        '      where v.nped = coalesce(new.cod_venda, -1)'
        '      and v.tipo = coalesce(new.tipo_venda, '#39#39')'
        '      and v.cod_empresa = new.cod_empresa'
        '        into :vtipo_os;'
        '        '
        
          '    if ((select retorno from sp_retorno_debitocredito(new.tipo_v' +
          'enda,new.tipv,:vtipo_os)) <> '#39'S'#39') then'
        '      exit;*/'
        '  end'
        '  else'
        '  begin'
        '    if (coalesce(old.tipo, '#39#39') <> '#39'D'#39') then'
        '      exit;'
        ''
        
          '    select coalesce(e.usardebitocredito, '#39#39') as usardebitocredit' +
          'o,'
        '    coalesce(e.perc_lancdebcred_dev, 0) as perc_lancdebcred_dev,'
        
          '    coalesce(p.perc_lancdebcred_dev, 0) as perc_lancdebcred_dev2' +
          ','
        
          '    coalesce(e.lancdebcred_dev, '#39#39') as lancdebcred_dev from empr' +
          'esa e'
        '    inner join produtos p on e.cod_empresa=p.cod_empresa'
        '    where p.grupo_prod = old.grupo_prod'
        '    and p.cod_prod = old.cod_prod'
        '    and e.cod_empresa = old.cod_empresa'
        
          '      into :vempusadebcred, :vpercetual_dc, :vpercetual_dc_temp,' +
          ' :vlancdebcred_dev;'
        ''
        
          '    if ((vempusadebcred <> '#39'S'#39') or ((vpercetual_dc <= 0) and (vp' +
          'ercetual_dc_temp <= 0)) or (vlancdebcred_dev <> '#39'S'#39')) then'
        '      exit;'
        ''
        '    /*if (rtrim(coalesce(old.tipo_venda, '#39#39')) = '#39'OS'#39') then'
        '      select v.tipo_os from pedvenda v'
        '      where v.nped = coalesce(old.cod_venda, -1)'
        '      and v.tipo = coalesce(old.tipo_venda, '#39#39')'
        '      and v.cod_empresa = old.cod_empresa'
        '        into :vtipo_os;'
        ''
        
          '    if ((select retorno from sp_retorno_debitocredito(old.tipo_v' +
          'enda,old.tipv,:vtipo_os)) <> '#39'S'#39') then'
        '      exit;*/'
        '  end'
        ''
        '  if (coalesce(vpercetual_dc_temp,0) > 0) then'
        '    vpercetual_dc = vpercetual_dc_temp;'
        ''
        '  if (inserting) then'
        
          '    vdebcred = (coalesce(new.quant,0) * coalesce(new.valor,0) * ' +
          'vpercetual_dc) / 100;'
        '  else'
        
          '    vdebcred = (coalesce(old.quant,0) * coalesce(old.valor,0) * ' +
          'vpercetual_dc) / 100;'
        ''
        '  if (inserting) then'
        '    vdescricao = '#39'DEBITO REF. A DEVOLUCAO ITEM '#39';'
        '  else'
        '    vdescricao = '#39'ESTORNO - EXCLUSAO DE ITEM DEV '#39';'
        ''
        '  if ((inserting) and (new.cod_vendedor is not null)) then'
        '  begin'
        
          '    select current_d, current_t from sp_current_ts(new.cod_empre' +
          'sa) into :current_d, :current_t;'
        ''
        
          '    insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_VENDEDO' +
          'R, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPEDORIGEM' +
          ', DESCRICAO)'
        
          '    values ((select COD from INCREMENTA_CODIGO(new.cod_empresa, ' +
          #39'LANC_DEBCRED'#39')),'
        
          '    new.cod_empresa, new.cod_vendedor, :current_d, :current_t, '#39 +
          'DEV'#39','
        
          '    -(:vdebcred), new.sequencia, :vdescricao||'#39'|'#39'||new.seqid||'#39'|' +
          #39'||new.grupo_prod||'#39'|'#39'||new.cod_prod);'
        '  end'
        '  else if (old.cod_vendedor is not null) then'
        '  begin'
        
          '    select current_d, current_t from sp_current_ts(new.cod_empre' +
          'sa) into :current_d, :current_t;'
        ''
        
          '    insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_VENDEDO' +
          'R, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPEDORIGEM' +
          ', DESCRICAO)'
        
          '    values ((select COD from INCREMENTA_CODIGO(old.cod_empresa, ' +
          #39'LANC_DEBCRED'#39')),'
        
          '    old.cod_empresa, old.cod_vendedor, :current_d, :current_t, '#39 +
          'DEV'#39','
        
          '    (:vdebcred), old.sequencia, :vdescricao||'#39'|'#39'||old.seqid||'#39'|'#39 +
          '||old.grupo_prod||'#39'|'#39'||old.cod_prod);'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_LANCDEBCRED_SALDODEBCRED FOR LANC_DEB' +
          'CRED'
        'ACTIVE AFTER INSERT OR DELETE POSITION 0'
        'AS'
        '  declare variable vsaldo t_vl_todos;'
        '  declare variable current_d timestamp;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        '    '
        '  if (inserting) then'
        '  begin  '
        
          '    select current_d from sp_current_ts(new.cod_empresa) into :c' +
          'urrent_d;'
        ''
        '    if (new.cod_vendedor is not null) then'
        '    begin'
        '      select sdc.saldo from saldo_debcred sdc'
        '      where sdc.cod_vendedor = new.cod_vendedor'
        '      and sdc.cod_empresa = new.cod_empresa'
        '      and sdc.data = :current_d'
        '        into :vsaldo;'
        ''
        '      if (row_count > 0) then'
        '      begin'
        
          '        if ((round((coalesce(vsaldo, 0) + coalesce(new.vl_lancde' +
          'bcred, 0)), 5)) = 0.00000) then'
        '        begin'
        '          update saldo_debcred sdc set sdc.saldo = 0'
        '          where sdc.cod_vendedor = new.cod_vendedor'
        '          and sdc.cod_empresa = new.cod_empresa'
        '          and sdc.data = :current_d;'
        '        end'
        '        else'
        '        begin'
        
          '          update saldo_debcred sdc set sdc.saldo = coalesce(:vsa' +
          'ldo, 0) + coalesce(new.vl_lancdebcred, 0)'
        '          where sdc.cod_vendedor = new.cod_vendedor'
        '          and sdc.cod_empresa = new.cod_empresa'
        '          and sdc.data = :current_d;'
        '        end'
        '      end'
        '      else'
        '      begin'
        
          '        select first 1 coalesce(sdc.saldo, 0) from saldo_debcred' +
          ' sdc'
        '        where sdc.cod_vendedor = new.cod_vendedor'
        '        and sdc.cod_empresa = new.cod_empresa'
        '        order by sdc.cod_saldo desc'
        '          into :vsaldo;'
        ''
        '        if (row_count = 0) then'
        '          vsaldo=0;'
        ''
        
          '        insert into saldo_debcred (COD_SALDO, COD_EMPRESA, COD_V' +
          'ENDEDOR, SALDO, DATA)'
        
          '        values ((select COD from INCREMENTA_CODIGO(new.cod_empre' +
          'sa, '#39'SALDO_DEBCRED'#39')),'
        
          '        new.cod_empresa, new.cod_vendedor, (coalesce(:vsaldo, 0)' +
          ' + coalesce(new.vl_lancdebcred, 0)), :current_d);'
        '      end'
        '    end'
        '  end'
        '  else'
        '  begin   '
        
          '    select current_d from sp_current_ts(old.cod_empresa) into :c' +
          'urrent_d;'
        ''
        '    if (old.cod_vendedor is not null) then'
        '    begin'
        '      select sdc.saldo from saldo_debcred sdc'
        '      where sdc.cod_vendedor = old.cod_vendedor'
        '      and sdc.cod_empresa = old.cod_empresa'
        '      and sdc.data = :current_d'
        '        into :vsaldo;'
        ''
        '      if (row_count > 0) then'
        '      begin'
        
          '        if ((round((coalesce(vsaldo, 0) - coalesce(old.vl_lancde' +
          'bcred, 0)), 5)) = 0.00000) then'
        '        begin'
        '          update saldo_debcred sdc set sdc.saldo = 0'
        '          where sdc.cod_vendedor = old.cod_vendedor'
        '          and sdc.cod_empresa = old.cod_empresa'
        '          and sdc.data = :current_d;'
        '        end'
        '        else'
        '        begin'
        
          '          update saldo_debcred sdc set sdc.saldo = coalesce(sdc.' +
          'saldo, 0) - coalesce(old.vl_lancdebcred, 0)'
        '          where sdc.cod_vendedor = old.cod_vendedor'
        '          and sdc.cod_empresa = old.cod_empresa'
        '          and sdc.data = :current_d;'
        '        end'
        '      end'
        '      else'
        '      begin'
        '        select first 1 sdc.saldo from saldo_debcred sdc'
        '        where sdc.cod_vendedor = old.cod_vendedor'
        '        and sdc.cod_empresa = old.cod_empresa'
        '        order by sdc.cod_saldo desc'
        '          into :vsaldo;'
        ''
        '        if (vsaldo is null) then'
        '          vsaldo=0;'
        ''
        
          '        insert into saldo_debcred (COD_SALDO, COD_EMPRESA, COD_V' +
          'ENDEDOR, SALDO, DATA)'
        
          '        values ((select COD from INCREMENTA_CODIGO(old.cod_empre' +
          'sa, '#39'SALDO_DEBCRED'#39')),'
        
          '        old.cod_empresa, old.cod_vendedor, coalesce(:vsaldo, 0) ' +
          '- coalesce(old.vl_lancdebcred, 0), :current_d);'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_PEDVENDAPROD_DEBCRED FOR PEDVENDA_PRO' +
          'D'
        'ACTIVE AFTER UPDATE POSITION 1'
        'AS'
        '  declare variable vstatus varchar(10);'
        '  declare variable vdescricao varchar(48);'
        '  declare variable vdescricaonew varchar(48);'
        '  declare variable vempusadebcred char(1);'
        '  declare variable vtipo varchar(3);'
        '  declare variable vtipv varchar(1);'
        '  declare variable vtipo_os varchar(10);   '
        '  declare variable current_t timestamp;'
        '  declare variable current_d timestamp;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (coalesce(new.usar_debcred, '#39'S'#39') = '#39'N'#39') then'
        '    exit;'
        ''
        
          '  if ((coalesce(old.vl_debcred, 0) = 0) and (coalesce(new.vl_deb' +
          'cred, 0) = 0)) then'
        '    exit;'
        ''
        
          '  select coalesce(e.usardebitocredito, '#39#39') as usardebitocredito ' +
          'from empresa e'
        '  where e.cod_empresa = new.cod_empresa'
        '    into :vempusadebcred;'
        ''
        '  if (vempusadebcred <> '#39'S'#39') then'
        '    exit;'
        ''
        '  select v.status_ped, v.tipo, v.tipv, v.tipo_os from pedvenda v'
        '  where v.nped = new.nped'
        '  and v.tipo = new.tipo'
        '  and v.cod_empresa = new.cod_empresa'
        '    into :vstatus, :vtipo, :vtipv, :vtipo_os;'
        ''
        '  if (vstatus is null) then'
        '    vstatus='#39#39';'
        
          '  if ((vstatus = '#39'FECHADA'#39') and (coalesce(new.status,'#39#39') <> '#39'CAN' +
          'CELADO'#39')) then'
        '  begin'
        
          '    if ((select retorno from sp_retorno_debitocredito(:vtipo, :v' +
          'tipv, :vtipo_os)) <> '#39'S'#39') then'
        '      exit;'
        
          '    /*No caso de alterar o vendedor da venda ja fechada, lancar ' +
          'um credito ou debito para o new e old vendedor*/'
        '    if (coalesce(new.vl_debcred, 0) > 0) then'
        '    begin'
        '      vdescricao    = '#39'ESTORNO DE CREDITO: ITEM '#39';'
        '      vdescricaonew = '#39'LANCAMENTO DE CREDITO: ITEM '#39';'
        '    end'
        '    else if (coalesce(new.vl_debcred, 0) < 0) then'
        '    begin'
        '      vdescricao    = '#39'ESTORNO DE DEBITO: ITEM '#39';'
        '      vdescricaonew = '#39'LANCAMENTO DE DEBITO: ITEM '#39';'
        '    end'
        ''
        
          '    if ((coalesce(old.cod_vendedor, 0)) <> (coalesce(new.cod_ven' +
          'dedor, 0)))  then'
        '    begin     '
        
          '      select current_d, current_t from sp_current_ts(new.cod_emp' +
          'resa) into :current_d, :current_t;'
        ''
        
          '      if ((not(old.cod_vendedor is null)) and (coalesce(old.vl_d' +
          'ebcred, 0) <> 0)) then'
        '      begin'
        
          '        insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_VEN' +
          'DEDOR, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPEDOR' +
          'IGEM, DESCRICAO)'
        
          '        values ((select COD from INCREMENTA_CODIGO(old.cod_empre' +
          'sa, '#39'LANC_DEBCRED'#39')),'
        
          '        old.cod_empresa, old.cod_vendedor, :current_d ,:current_' +
          't, old.tipo,'
        
          '        - (coalesce(old.vl_debcred, 0)), old.nped, :vdescricao||' +
          #39'|'#39'||old.nitem||'#39'|'#39'||old.grupo_prod||'#39'|'#39'||old.cod_prod);'
        '      end'
        ''
        
          '      if ((not(new.cod_vendedor is null)) and (coalesce(new.vl_d' +
          'ebcred, 0) <> 0)) then'
        '      begin'
        
          '        insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_VEN' +
          'DEDOR, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPEDOR' +
          'IGEM, DESCRICAO)'
        
          '        values ((select COD from INCREMENTA_CODIGO(new.cod_empre' +
          'sa, '#39'LANC_DEBCRED'#39')),'
        
          '        new.cod_empresa, new.cod_vendedor, :current_d, :current_' +
          't, new.tipo,'
        
          '        (coalesce(new.vl_debcred, 0)), new.nped, :vdescricaonew|' +
          '|'#39'|'#39'||new.nitem||'#39'|'#39'||new.grupo_prod||'#39'|'#39'||new.cod_prod);'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PEDVENDA_DEBCRED FOR PEDVENDA'
        'ACTIVE AFTER INSERT OR UPDATE POSITION 0'
        'AS'
        '  declare variable vdebcred t_vl_todos;'
        '  declare variable vcodvendedor integer;'
        '  declare variable vusar_debcred char(1);'
        '  declare variable vdescricao varchar(48);'
        '  declare variable vempusadebcred char(1);   '
        '  declare variable current_t timestamp;'
        '  declare variable current_d timestamp;'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        
          '  select coalesce(e.usardebitocredito, '#39#39') as usardebitocredito ' +
          'from empresa e'
        '  where e.cod_empresa = new.cod_empresa'
        '    into :vempusadebcred;'
        ''
        '  if (vempusadebcred <> '#39'S'#39')then'
        '    exit;'
        ''
        '  vdebcred = 0;'
        
          '  if (((coalesce(new.status_ped, '#39#39')) = '#39'FECHADA'#39') and ((coalesc' +
          'e(old.status_ped, '#39#39')) <> '#39'FECHADA'#39')) then'
        '  begin'
        
          '    if ((select retorno from sp_retorno_debitocredito(new.tipo, ' +
          'new.tipv, new.tipo_os)) <> '#39'S'#39') then'
        '      exit;'
        ''
        
          '    update pedvenda_prod pvp set pvp.vl_debcred = (coalesce(pvp.' +
          'rateio_acresc, 0) - coalesce(pvp.rateio_desc, 0)) +'
        
          '        (coalesce(pvp.vltot_ped_item, 0) - (coalesce(pvp.vlun_or' +
          'ig, coalesce(pvp.vlun_ped_item, 0)) * coalesce(pvp.quant_ped_ite' +
          'm, 0))) /*Para o caso de alterar o valor unitario*/'
        '    where pvp.nped = new.nped'
        '    and pvp.tipo = new.tipo'
        '    and pvp.cod_empresa = new.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39';'
        ''
        '    for select pvp.cod_vendedor,'
        
          '        iif(coalesce(pvp.usar_debcred, '#39'S'#39') = '#39'N'#39', '#39'N'#39', '#39'S'#39') usa' +
          'r_debcred,'
        
          '        sum(coalesce(pvp.vl_debcred, 0)) vl_debcred from pedvend' +
          'a_prod pvp'
        '        where pvp.nped = new.nped'
        '        and pvp.tipo = new.tipo'
        '        and pvp.cod_empresa = new.cod_empresa'
        '        and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39
        '        group by 1, 2'
        '          into :vcodvendedor, :vusar_debcred, :vdebcred do'
        '    begin'
        '      if ((vcodvendedor is not null)'
        '        and (coalesce(vusar_debcred, '#39'S'#39') <> '#39'N'#39')) then'
        '      begin      '
        
          '        select current_d, current_t from sp_current_ts(new.cod_e' +
          'mpresa) into :current_d, :current_t;'
        '        if (vdebcred > 0) then'
        '          vdescricao = '#39'LANCAMENTO DE CREDITO - FECHAMENTO VND'#39';'
        '        else if (vdebcred < 0) then'
        '          vdescricao = '#39'LANCAMENTO DE DEBITO - FECHAMENTO VND'#39';'
        ''
        '        if (coalesce(vdebcred, 0) <> 0) then'
        '        begin'
        
          '          insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_V' +
          'ENDEDOR, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPED' +
          'ORIGEM, DESCRICAO)'
        
          '          values ((select COD from INCREMENTA_CODIGO(new.cod_emp' +
          'resa, '#39'LANC_DEBCRED'#39')),'
        
          '          new.cod_empresa, :vcodvendedor, :current_d, :current_t' +
          ', new.tipo, :vdebcred, new.nped, :vdescricao);'
        '        end'
        '      end'
        '    end'
        '  end'
        
          '  else if (((coalesce(old.status_ped, '#39#39')) = '#39'FECHADA'#39') and ((co' +
          'alesce(new.status_ped, '#39#39')) <> '#39'FECHADA'#39')) then'
        '  begin'
        
          '    if ((select retorno from sp_retorno_debitocredito(new.tipo,n' +
          'ew.tipv,new.tipo_os)) <> '#39'S'#39') then'
        '      exit;'
        ''
        '    for select pvp.cod_vendedor,'
        
          '        iif(coalesce(pvp.usar_debcred, '#39'S'#39') = '#39'N'#39', '#39'N'#39', '#39'S'#39') usa' +
          'r_debcred,'
        
          '        sum(coalesce(pvp.vl_debcred, 0)) vl_debcred from pedvend' +
          'a_prod pvp'
        '        where pvp.nped = new.nped'
        '        and pvp.tipo = new.tipo'
        '        and pvp.cod_empresa = new.cod_empresa '
        '        and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39
        '        group by 1, 2'
        '          into :vcodvendedor, :vusar_debcred, :vdebcred do'
        '    begin'
        '      if ((vcodvendedor is not null)'
        '        and (coalesce(vusar_debcred, '#39'S'#39') <> '#39'N'#39')) then'
        '      begin'
        
          '        select current_d, current_t from sp_current_ts(new.cod_e' +
          'mpresa) into :current_d, :current_t;'
        ''
        '        if (vdebcred > 0) then'
        
          '          vdescricao = '#39'ESTORNO REFERENTE A CREDITO - VENDA REAB' +
          'ERTA'#39';'
        '        else if (vdebcred < 0) then'
        
          '          vdescricao = '#39'ESTORNO REFERENTE A DEBITO - VENDA REABE' +
          'RTA'#39';'
        ''
        '        if (coalesce(vdebcred, 0) <> 0) then'
        '        begin'
        
          '          insert into LANC_DEBCRED (COD_LANC, COD_EMPRESA, COD_V' +
          'ENDEDOR, DATA_LANC, HORA_LANC, ORIGEM_LANC, VL_LANCDEBCRED, NPED' +
          'ORIGEM, DESCRICAO)'
        
          '          values ((select COD from INCREMENTA_CODIGO(new.cod_emp' +
          'resa, '#39'LANC_DEBCRED'#39')),'
        
          '          new.cod_empresa, :vcodvendedor, :current_d, :current_t' +
          ', new.tipo, - (:vdebcred), new.nped, :vdescricao);'
        '        end'
        '      end'
        '    end'
        ''
        '    update pedvenda_prod pvp set pvp.vl_debcred = 0'
        '    where pvp.nped = new.nped'
        '    and pvp.tipo = new.tipo'
        '    and pvp.cod_empresa = new.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39';'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE FECH_DIA ADD INICIA_IMPORT VARCHAR(1);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'LANC051'#39', :COD_EMPRESA, '#39'R' +
          'ETIRAR MARCA DE INICIO DE IMPORTACAO DO DIA'#39', 10, '#39'FRMFECH_DIA'#39',' +
          ' 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);')
    end
  end
end
