          'INSERT INTO TIPO_PRECO (COD_TPPRECO, COD_EMPRESA, TIPO, DESCR_TI' +
          'PO, RECALC_PRECO) VALUES (6, :COD_EMPRESA, '#39'Q'#39', '#39'QUANTIDADE'#39', (c' +
          'ase when ((select coalesce(config_sistema.value1_f, 0) from conf' +
          'ig_sistema where config_sistema.chave = '#39'prod_cad_recalcular_pre' +
          'co_por_quantidade'#39' and config_sistema.cod_empresa = :COD_EMPRESA' +
