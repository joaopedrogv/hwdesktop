        'end tax,'
        'cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp, '
        'ctrl.codigo_ctrl, ctrl.nome_ctrl, '
        
          'ctrl2.codigo_ctrl as codigo_ctrl_tx, ctrl2.nome_ctrl as nome_ctr' +
          'l_tx, '
        'ctrl2.n_conta_plc_tx_cartao, ctrl2.n_conta_plc_tarifa_cartao, '
        'cc.n_conta_plc, p.desc_plc, '
        'cc.cod_cred, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v, '
        
          'cc.valor_c, cc.valor_liquido, cc.valor_original, cc.data_rec_c, ' +
          'cc.data_venc_c, cc.status_c,'
        'cc.datq_c,'
        'case when (cc.datq_c is not null) and (cc.tip_baixa = '#39'D'#39') then'
        '        '#39'DEVOLUCAO'#39
        '     when (cc.datq_c is not null) then'
        '        '#39'QUITADO'#39
        '     else'
        '        '#39'ABERTO'#39
        'end statusq_c,'
        
          'case when ((coalesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.' +
          'valor_c, 0) > 0)) then'
        
          '        ((1 - (coalesce(cc.valor_liquido, 0) / coalesce(cc.valor' +
          '_c, 0))) * 100)'
        '     else'
        '        0'
        'end taxa_cred,'
        'coalesce(cc.cod_cliente, 0) cod_cliente,'
        
          'trim(case when (cc.cod_cliente > 0) then cl.nome_cliente else cc' +
          '.nome_c end) nome_cliente, '
        
          'trim(case when (cc.cod_cliente > 0) then cl.razao else cc.razao ' +
          'end) razao,'
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm, '
        'cc.cod_bandeira_adm, bande.descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join getcreditos ('
        '    trim(cf.nsu),'
        '    trim(cf.authorization_number),'
        
          '    iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.i' +
          'nstallment_number, 1)),'
        '    cf.cod_empresa) credq on 1 = 1'
        'left join controle_creditos cc on'
        '    cc.cod_cred = credq.cod_cred'
        '    and cc.codigo_emp = credq.codigo_emp'
        'left join terminal_cartao termc on '
        '    termc.cod_term_adm = cc.cod_terminal_adm '
        '    and termc.cod_empresa = cc.cod_emp_mult '
        'left join adm_cartao adm on '
        '    adm.cod_adm = termc.cod_adm '
        '    and adm.cod_empresa = termc.cod_empresa '
        'left join bandeiras_cartao bande on'
        '    bande.cod_bandeira = cc.cod_bandeira_adm'
        '   and bande.cod_empresa = cc.cod_emp_mult'
        'left join clientes cl on '
        '    cl.cod_cliente = cc.cod_cliente '
        '    and cl.cod_empresa = cc.cod_emp_mult '
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        'left join controles ctrl2 on'
        '    ctrl2.codigo_ctrl = cc.codigo_ctrl '
        '    and ctrl2.codigo_emp = cc.codigo_emp '
        
          'where trim(cf.event_type_description) in  ('#39'Cancelamento'#39', '#39'Char' +
          'geback'#39')'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number,'
        'cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description, '
        'cf.acquirer_id, cf.acquirer_name, '
        'cf.brand_id, cf.brand_name, '
        'cf.event_type, cf.event_type_description, '
        'cf.description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp, '
        'ctrl.codigo_ctrl, ctrl.nome_ctrl, '
        'null codigo_ctrl_tx, null nome_ctrl_tx,'
        'null n_conta_plc_tx_cartao, null n_conta_plc_tarifa_cartao,'
        'p.n_conta_plc, p.desc_plc,'
        'null cod_cred, null n_doc_v, null n_doc_c, null tp_doc_v,'
        
          'null valor_c, null valor_liquido, null valor_original, null data' +
          '_rec_c, null data_venc_c, null status_c,'
        '(select first 1 lanc.data from lancamentos lanc'
        ' where lanc.id_financ_confere = cf.id'
        ' and lanc.cod_emp_mult = cf.cod_empresa) datq_c,'
        'case when ((select count(*) from lancamentos lanc'
        '            where lanc.id_financ_confere = cf.id'
        '            and lanc.cod_emp_mult = cf.cod_empresa) <> 0) then'
        '       '#39'QUITADO'#39
        '     else'
        '       '#39'ABERTO'#39
        'end statusq_c,'
        'null taxa_cred,'
        'null cod_cliente, null nome_cliente, null razao,'
        
          'null cod_terminal_adm, null desc_term_adm, null cod_adm, null de' +
          'scricao_adm,'
        'null cod_bandeira_adm, null descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        
          'where trim(cf.event_type_description) = '#39'Ajuste'#39' and coalesce(cf' +
          '.event_net_amount, 0) >= 0'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number,'
        'cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description, '
        'cf.acquirer_id, cf.acquirer_name, '
        'cf.brand_id, cf.brand_name, '
        'cf.event_type, cf.event_type_description, '
        'cf.description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp, '
        'ctrl.codigo_ctrl, ctrl.nome_ctrl, '
        'null codigo_ctrl_tx, null  nome_ctrl_tx,'
        'null n_conta_plc_tx_cartao, null n_conta_plc_tarifa_cartao,'
        'p.n_conta_plc, p.desc_plc,'
        'null cod_cred, null n_doc_v, null n_doc_c, null tp_doc_v,'
        
          'null valor_c, null valor_liquido, null valor_original, null data' +
          '_rec_c, null data_venc_c, null status_c,'
        '(select first 1 lanc.data from lancamentos lanc'
        ' where lanc.id_financ_confere = cf.id'
        ' and lanc.cod_emp_mult = cf.cod_empresa) datq_c,'
        'case when ((select count(*) from lancamentos lanc'
        '            where lanc.id_financ_confere = cf.id'
        '            and lanc.cod_emp_mult = cf.cod_empresa) <> 0) then'
        '       '#39'QUITADO'#39
        '     else'
        '       '#39'ABERTO'#39
        'end statusq_c,'
        'null taxa_cred,'
        'null cod_cliente, null nome_cliente, null razao,'
        
          'null cod_terminal_adm, null desc_term_adm, null cod_adm, null de' +
          'scricao_adm,'
        'null cod_bandeira_adm, null descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        
          'where trim(cf.event_type_description) = '#39'Ajuste'#39' and coalesce(cf' +
          '.event_net_amount, 0) < 0;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONCILIACAO_PENDENCIAS_CONF('
        '    DATA,'
        '    DATE_,'
        '    REQUEST_DATE,'
        '    EFFECTED_DATE,'
        '    PAYMENT_DATE,'
        '    BANK_SHIPPING_DATE,'
        '    ID,'
        '    COD_EMPRESA,'
        '    ARQUIVO,'
        '    DATA_ARQUIVO,'
        '    ESTABLISHMENT_NUMBER,'
        '    NSU,'
        '    AUTHORIZATION_NUMBER,'
        '    TYPE_,'
        '    TYPE_DESCRIPTION,'
        '    ACQUIRER_ID,'
        '    ACQUIRER_NAME,'
        '    BRAND_ID,'
        '    BRAND_NAME,'
        '    EVENT_TYPE,'
        '    EVENT_TYPE_DESCRIPTION,'
        '    DESCRIPTION,'
        '    BANK_RECON_STATUS,'
        '    BANK_RECON_DESCRIPTION,'
        '    GROSS_AMOUNT,'
        '    EVENT_NET_AMOUNT,'
        '    BATCH_NET_AMOUNT,'
        '    GROSS_EVENT_AMOUNT,'
        '    BATCH_GROSS_AMOUNT,'
        '    TAX,'
        '    SALE_TAX,'
        '    CUSTOMER_TAX,'
        '    INSTALLMENT_NUMBER,'
        '    INSTALLMENTS_TOTAL,'
        '    BANK_NUMBER,'
        '    BANK_NAME,'
        '    BRANCH_NUMBER,'
        '    ACCOUNT_NUMBER,'
        '    IDENTIFICACAO_EMP,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    CODIGO_CTRL_TX,'
        '    NOME_CTRL_TX,'
        '    N_CONTA_PLC_TX_CARTAO,'
        '    N_CONTA_PLC,'
        '    DESC_PLC,'
        '    COD_CRED,'
        '    N_DOC_V,'
        '    N_DOC_C,'
        '    TP_DOC_V,'
        '    VALOR_C,'
        '    VALOR_LIQUIDO,'
        '    VALOR_ORIGINAL,'
        '    DATA_REC_C,'
        '    DATA_VENC_C,'
        '    DATQ_C,'
        '    STATUS_C,'
        '    TAXA_CRED,'
        '    COD_TERMINAL_ADM,'
        '    DESC_TERM_ADM,'
        '    COD_ADM,'
        '    DESCRICAO_ADM,'
        '    COD_BANDEIRA_ADM,'
        '    DESC_BANDEIRA_ADM,'
        '    PIX_ID,'
        '    FORM_PAG_COD,'
        '    FORM_PAG,'
        '    COD_AJUSTE_COD,'
        '    COD_AJUSTE,'
        '    BANDEIRA_COD,'
        '    BANDEIRA,'
        '    STATUS_PAG_COD,'
        '    STATUS_PAG,'
        '    STATUS_PAG_ST,'
        '    TIPO_LANCAMENTO_COD,'
        '    TIPO_LANCAMENTO,'
        '    TIPO_LIQUIDACAO_COD,'
        '    TIPO_LIQUIDACAO,'
        '    TIPO_ANTECIPACAO_COD,'
        '    TIPO_ANTECIPACAO,'
        '    TIPO_CARTAO_COD,'
        '    TIPO_CARTAO,'
        '    MOTIVO_REJ_COD,'
        '    MOTIVO_REJ,'
        '    GRUPO_CARTAO_COD,'
        '    GRUPO_CARTAO,'
        '    TIPO_TRANSACAO_COD,'
        '    TIPO_TRANSACAO,'
        '    STATUS_TRANSF_COD,'
        '    STATUS_TRANSF,'
        '    STATUS_TRANSF_ST,'
        '    ORIGEM_AJUSTE_COD,'
        '    ORIGEM_AJUSTE)'
        'AS'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number, cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description,'
        'cf.acquirer_id, cf.acquirer_name,'
        'cf.brand_id, cf.brand_name,'
        'cf.event_type, cf.event_type_description,'
        'tplanc.descricao as description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp,'
        'ctrl.codigo_ctrl, ctrl.nome_ctrl,'
        
          'ctrl2.codigo_ctrl as codigo_ctrl_tx, ctrl2.nome_ctrl as nome_ctr' +
          'l_tx, ctrl2.n_conta_plc_tx_cartao,'
        'cc.n_conta_plc, p.desc_plc,'
        'cc.cod_cred, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        
          'cc.valor_c, cc.valor_liquido, cc.valor_original, cc.data_rec_c, ' +
          'cc.data_venc_c, cc.datq_c, cc.status_c,'
        
          'case when ((coalesce(cc.valor_original, cc.valor_c) > 0) and (co' +
          'alesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.valor_original' +
          ', cc.valor_c) <> coalesce(cc.valor_liquido, 0))) then'
        
          '        (100 - ((coalesce(cc.valor_original, cc.valor_c, 0) / co' +
          'alesce(cc.valor_c, 0)) * 100))'
        '     else 0'
        'end taxa_cred,'
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm,'
        'cc.cod_bandeira_adm, bande.descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join getcreditos ('
        '    trim(cf.nsu),'
        '    trim(cf.authorization_number),'
        
          '    iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.i' +
          'nstallment_number, 1)),'
        '    cf.cod_empresa) credq on 1 = 1'
        'left join controle_creditos cc on'
        '    cc.cod_cred = credq.cod_cred'
        '    and cc.codigo_emp = credq.codigo_emp'
        'left join terminal_cartao termc on'
        '    termc.cod_term_adm = cc.cod_terminal_adm '
        '    and termc.cod_empresa = cc.cod_emp_mult '
        'left join adm_cartao adm on '
        '    adm.cod_adm = termc.cod_adm '
        '    and adm.cod_empresa = termc.cod_empresa '
        'left join bandeiras_cartao bande on'
        '    bande.cod_bandeira = cc.cod_bandeira_adm'
        '    and bande.cod_empresa = cc.cod_emp_mult'
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        'left join controles ctrl2 on'
        '    ctrl2.codigo_ctrl = cc.codigo_ctrl'
        '    and ctrl2.codigo_emp = cc.codigo_emp'
        'where'
        'credq.cod_cred <= 0'
        
          'and ((trim(cf.event_type_description) = '#39'Venda'#39') or (trim(cf.eve' +
          'nt_type_description) like '#39'Antecipa%'#39'))'
        'and cf.pix_id is null'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number, cf.nsu, cf.authorization_number, '
        'cf.type_, cf.type_description,'
        'cf.acquirer_id, cf.acquirer_name,'
        'cf.brand_id, cf.brand_name,'
        'cf.event_type, cf.event_type_description,'
        'tplanc.descricao as description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp,'
        'ctrl.codigo_ctrl, ctrl.nome_ctrl,'
        
          'ctrl2.codigo_ctrl as codigo_ctrl_tx, ctrl2.nome_ctrl as nome_ctr' +
          'l_tx, ctrl2.n_conta_plc_tx_cartao,'
        'cc.n_conta_plc, p.desc_plc,'
        'cc.cod_cred, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        
          'cc.valor_c, cc.valor_liquido, cc.valor_original, cc.data_rec_c, ' +
          'cc.data_venc_c, cc.datq_c, cc.status_c,'
        
          'case when ((coalesce(cc.valor_original, cc.valor_c) > 0) and (co' +
          'alesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.valor_original' +
          ', cc.valor_c) <> coalesce(cc.valor_liquido, 0))) then'
        
          '        (100 - ((coalesce(cc.valor_original, cc.valor_c, 0) / co' +
          'alesce(cc.valor_c, 0)) * 100))'
        '     else 0'
        'end taxa_cred,'
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm,'
        'cc.cod_bandeira_adm, bande.descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_pix_status vwfp'
        'inner join conciliacao_financeiro cf on'
        '    vwfp.pix_id = cf.pix_id'
        '    and vwfp.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join getcreditos ('
        '    trim(cf.nsu),'
        '    trim(cf.authorization_number),'
        
          '    iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.i' +
          'nstallment_number, 1)),'
        '    cf.cod_empresa) credq on 1 = 1'
        'left join controle_creditos cc on'
        '    cc.cod_cred = credq.cod_cred'
        '    and cc.codigo_emp = credq.codigo_emp'
        'left join terminal_cartao termc on '
        '    termc.cod_term_adm = cc.cod_terminal_adm '
        '    and termc.cod_empresa = cc.cod_emp_mult '
        'left join adm_cartao adm on '
        '    adm.cod_adm = termc.cod_adm '
        '    and adm.cod_empresa = termc.cod_empresa '
        'left join bandeiras_cartao bande on'
        '    bande.cod_bandeira = cc.cod_bandeira_adm'
        '    and bande.cod_empresa = cc.cod_emp_mult'
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        'left join controles ctrl2 on'
        '    ctrl2.codigo_ctrl = cc.codigo_ctrl'
        '    and ctrl2.codigo_emp = cc.codigo_emp'
        'where credq.cod_cred <= 0'
        
          'and ((trim(cf.event_type_description) = '#39'Venda'#39') or (trim(cf.eve' +
          'nt_type_description) like '#39'Antecipa%'#39'))'
        'and cf.pix_id is not null'
        'union'
        
          'select case when (cf.payment_date is not null) then cf.payment_d' +
          'ate else cf.date_ end data,'
        
          'cf.date_, cf.request_date, cf.effected_date, cf.payment_date, cf' +
          '.bank_shipping_date,'
        'cf.id, cf.cod_empresa, cf.arquivo, cf.data_arquivo,'
        'cf.establishment_number, cf.nsu, cf.authorization_number,'
        'cf.type_, cf.type_description,'
        'cf.acquirer_id, cf.acquirer_name,'
        'cf.brand_id, cf.brand_name,'
        'cf.event_type, cf.event_type_description,'
        'tplanc.descricao as description,'
        'stpag.id as bank_recon_status,'
        'stpag.descricao as bank_recon_description,'
        'coalesce(cf.gross_amount, 0) gross_amount,'
        'coalesce(cf.event_net_amount, 0) event_net_amount,'
        'coalesce(cf.batch_net_amount, 0) batch_net_amount,'
        'coalesce(cf.gross_event_amount, 0) gross_event_amount,'
        'coalesce(cf.batch_gross_amount, 0) batch_gross_amount,'
        'cf.tax, cf.sale_tax, cf.customer_tax,'
        
          'iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.insta' +
          'llment_number, 1)) installment_number,'
        
          'iif(coalesce(cf.installments_total, 1) = 0, 1, coalesce(cf.insta' +
          'llments_total, 1)) installments_total,'
        
          'cf.bank_number, cf.bank_name, cf.branch_number, cf.account_numbe' +
          'r,'
        'emp.identificacao_emp,'
        'ctrl.codigo_ctrl, ctrl.nome_ctrl,'
        
          'ctrl2.codigo_ctrl as codigo_ctrl_tx, ctrl2.nome_ctrl as nome_ctr' +
          'l_tx, ctrl2.n_conta_plc_tx_cartao,'
        'cc.n_conta_plc, p.desc_plc,'
        'cc.cod_cred, cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        
          'cc.valor_c, cc.valor_liquido, cc.valor_original, cc.data_rec_c, ' +
          'cc.data_venc_c, cc.datq_c, cc.status_c,'
        
          'case when ((coalesce(cc.valor_original, cc.valor_c) > 0) and (co' +
          'alesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.valor_original' +
          ', cc.valor_c) <> coalesce(cc.valor_liquido, 0))) then'
        
          '        (100 - ((coalesce(cc.valor_original, cc.valor_c, 0) / co' +
          'alesce(cc.valor_c, 0)) * 100))'
        '     else 0'
        'end taxa_cred,'
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm,'
        'cc.cod_bandeira_adm, bande.descricao,'
        'cf.pix_id,'
        'cf.form_pag_cod, formpag.descricao form_pag,'
        'cf.cod_ajuste_cod, codajt.descricao cod_ajuste,'
        'cf.bandeira_cod, band.nome bandeira,'
        
          'cf.status_pag_cod, stpag.descricao status_pag, stpag_adq.status ' +
          'status_pag_st,'
        'cf.tipo_lancamento_cod, tplanc.descricao tipo_lancamento,'
        'cf.tipo_liquidacao_cod, tpliq.descricao tipo_liquidacao,'
        'cf.tipo_antecipacao_cod, tpantec.descricao tipo_antecipacao,'
        'cf.tipo_cartao_cod, tpcartao.descricao tipo_cartao,'
        'cf.motivo_rej_cod, motrej.descricao motivo_rej,'
        'cf.grupo_cartao_cod, grcartao.descricao grupo_cartao,'
        'cf.tipo_transacao_cod, tptr.descricao tipo_transacao,'
        
          'cf.status_transf_cod, st_transf.descricao status_trans, st_trans' +
          'f_adq.status status_trans_st,'
        'cf.origem_ajuste_cod, orig_transf.descricao origem_ajuste'
        'from vw_conc_financ_status vwf'
        'inner join conciliacao_financeiro cf on'
        '    vwf.id = cf.id'
        '    and vwf.installment_number = cf.installment_number'
        '    and vwf.installments_total = cf.installments_total'
        '    and vwf.cod_empresa = cf.cod_empresa'
        'inner join empresa emp on'
        '    emp.cod_empresa = cf.cod_empresa'
        'left join conciliacao_adquirente adq on'
        '    adq.id = cf.acquirer_id'
        'left join conciliacao_band_adq band_adq on'
        '    band_adq.codigo = cf.bandeira_cod'
        '    and band_adq.id_adquirente = adq.id'
        'left join conciliacao_bandeira band on'
        '    band.id = band_adq.id_bandeira'
        'left join conciliacao_cod_ajuste_adq codajt_adq on'
        '    codajt_adq.codigo = cf.cod_ajuste_cod'
        '    and codajt_adq.id_adquirente = adq.id'
        'left join conciliacao_cod_ajuste codajt on'
        '    codajt.id = codajt_adq.id_cod_ajuste'
        'left join conciliacao_form_pag_adq formpag_adq on'
        '    formpag_adq.codigo = cf.form_pag_cod'
        '    and formpag_adq.id_adquirente = adq.id'
        'left join conciliacao_form_pag formpag on'
        '    formpag.id = formpag_adq.id_form_pag'
        'left join conciliacao_grupo_cartao_adq grcartao_adq on'
        '    grcartao_adq.codigo = cf.grupo_cartao_cod'
        '    and grcartao_adq.id_adquirente = cf.acquirer_id'
        'left join conciliacao_grupo_cartao grcartao on'
        '    grcartao.id = grcartao_adq.id_grupo_cartao'
        'left join conciliacao_motivo_rej_adq motrej_adq on'
        '    motrej_adq.codigo = cf.motivo_rej_cod'
        '    and motrej_adq.id_adquirente = adq.id'
        'left join conciliacao_motivo_rej motrej on'
        '    motrej.id = motrej_adq.id_motivo_rej'
        'left join conciliacao_origem_ajuste_adq orig_transf_adq on'
        '    orig_transf_adq.codigo = cf.origem_ajuste_cod'
        '    and orig_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_origem_ajuste orig_transf on'
        '    orig_transf.id = orig_transf_adq.id_origem_ajuste'
        'left join conciliacao_status_pag_adq stpag_adq on'
        '    stpag_adq.codigo = cf.status_pag_cod'
        '    and stpag_adq.id_adquirente = adq.id'
        'left join conciliacao_status_pag stpag on'
        '    stpag.id = stpag_adq.id_status_pag'
        'left join conciliacao_status_transf_adq st_transf_adq on'
        '    st_transf_adq.codigo = cf.status_transf_cod'
        '    and st_transf_adq.id_adquirente = adq.id'
        'left join conciliacao_status_transf st_transf on'
        '    st_transf.id = st_transf_adq.id_status_transf'
        'left join conciliacao_tipo_antecip_adq tpantec_adq on'
        '    tpantec_adq.codigo = cf.tipo_antecipacao_cod'
        '    and tpantec_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_antecip tpantec on'
        '    tpantec.id = tpantec_adq.id_tipo_antecip'
        'left join conciliacao_tipo_cartao_adq tpcartao_adq on'
        '    tpcartao_adq.codigo = cf.tipo_cartao_cod'
        '    and tpcartao_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_cartao tpcartao on'
        '    tpcartao.id = tpcartao_adq.id_tipo_cartao'
        'left join conciliacao_tipo_lanc_adq tplanc_adq on'
        '    tplanc_adq.codigo = cf.tipo_lancamento_cod'
        '    and tplanc_adq.id_aquirente = adq.id'
        'left join conciliacao_tipo_lanc tplanc on'
        '    tplanc.id = tplanc_adq.id_tipo_lanc'
        'left join conciliacao_tipo_liq_adq tpliq_adq on'
        '    tpliq_adq.codigo = cf.tipo_liquidacao_cod'
        '    and tpliq_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_liq tpliq on'
        '    tpliq.id = tpliq_adq.id_tipo_liq'
        'left join conciliacao_tipo_transacao_adq tptr_adq on'
        '    tptr_adq.codigo = cf.tipo_transacao_cod'
        '    and tptr_adq.id_adquirente = adq.id'
        'left join conciliacao_tipo_transacao tptr on'
        '    tptr.id = tptr_adq.id_tipo_transacao'
        'left join p_contas p on'
        
          '    p.n_conta_plc = (case when (cf.event_net_amount >= 0) then c' +
          'odajt.n_conta_plc_e else codajt.n_conta_plc_s end)'
        'left join getcreditos ('
        '    trim(cf.nsu),'
        '    trim(cf.authorization_number),'
        
          '    iif(coalesce(cf.installment_number, 1) = 0, 1, coalesce(cf.i' +
          'nstallment_number, 1)),'
        '    cf.cod_empresa) credq on 1 = 1'
        'left join controle_creditos cc on'
        '    cc.cod_cred = credq.cod_cred'
        '    and cc.codigo_emp = credq.codigo_emp'
        'left join terminal_cartao termc on '
        '    termc.cod_term_adm = cc.cod_terminal_adm '
        '    and termc.cod_empresa = cc.cod_emp_mult '
        'left join adm_cartao adm on '
        '    adm.cod_adm = termc.cod_adm '
        '    and adm.cod_empresa = termc.cod_empresa '
        'left join bandeiras_cartao bande on'
        '    bande.cod_bandeira = cc.cod_bandeira_adm'
        '    and bande.cod_empresa = cc.cod_emp_mult'
        'left join retorna_ctrl_ag_conta ('
        '    cf.branch_number,'
        '    cf.account_number,'
        '    cf.cod_empresa) ctrl on 1 = 1'
        'left join controles ctrl2 on'
        '    ctrl2.codigo_ctrl = cc.codigo_ctrl'
        '    and ctrl2.codigo_emp = cc.codigo_emp'
        'where credq.cod_cred <= 0'
        
          'and trim(cf.event_type_description) in ('#39'Cancelamento'#39', '#39'Chargeb' +
          'ack'#39');'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONCILIACAO_PENDENCIAS_CRED('
        '    COD_CRED,'
        '    CODIGO_EMP,'
        '    COD_EMP_MULT,'
        '    DATA_REC_C,'
        '    DATA_VENC_C,'
        '    N_DOCNSU_ADM,'
        '    N_AUT_CART,'
        '    NPARCELA,'
        '    QTDE_PARC,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    N_DOC_V,'
        '    N_DOC_C,'
        '    TP_DOC_V,'
        '    VALOR_C,'
        '    VALOR_LIQUIDO,'
        '    VALOR_ORIGINAL,'
        '    DATQ_C,'
        '    STATUS_C,'
        '    TAXA_CRED,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    COD_TERMINAL_ADM,'
        '    DESC_TERM_ADM,'
        '    COD_ADM,'
        '    DESCRICAO_ADM,'
        '    COD_BANDEIRA_ADM,'
        '    DESC_BANDEIRA_ADM,'
        '    NOME_C,'
        '    IDENTIFICACAO_EMP)'
        'AS'
        'select cc.cod_cred, cc.codigo_emp, cc.cod_emp_mult, '
        'cc.data_rec_c, cc.data_venc_c, '
        'cc.n_docnsu_adm, cc.n_aut_cart, '
        'cc.nparcela, cc.qtde_parc, '
        'cc.codigo_ctrl, ctrl.nome_ctrl, '
        'cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v, '
        'coalesce(cc.valor_c, 0) valor_c,'
        'coalesce(cc.valor_liquido, 0) valor_liquido,'
        'coalesce(cc.valor_original, 0) valor_original,'
        'cc.datq_c, cc.status_c,'
        
          'case when ((coalesce(cc.valor_original, cc.valor_c) > 0) and (co' +
          'alesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.valor_original' +
          ', cc.valor_c) <> coalesce(cc.valor_liquido, 0))) then'
        
          '        (100 - ((coalesce(cc.valor_original, cc.valor_c, 0) / co' +
          'alesce(cc.valor_c, 0)) * 100))'
        '     else 0'
        'end taxa_cred,'
        'coalesce(cc.cod_cliente, 0) cod_cliente,'
        
          'trim(case when (cc.cod_cliente > 0) then cl.nome_cliente else cc' +
          '.nome_c end) nome_cliente, '
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm, '
        'cc.cod_bandeira_adm, band.descricao, '
        'cc.nome_c, emp.identificacao_emp from controle_creditos cc '
        'left join clientes cl on '
        '    cl.cod_cliente = cc.cod_cliente '
        '    and cl.cod_empresa = cc.cod_emp_mult '
        'inner join empresa emp on '
        '    emp.cod_empresa = cc.cod_emp_mult '
        'inner join controles ctrl on '
        '   ctrl.codigo_ctrl = cc.codigo_ctrl '
        '    and ctrl.codigo_emp = cc.cod_emp_mult '
        '    and ctrl.tp_plano = '#39'C'#39' '
        'left join terminal_cartao termc on '
        '    termc.cod_term_adm = cc.cod_terminal_adm'
        '    and termc.cod_empresa = cc.cod_emp_mult'
        'left join adm_cartao adm on'
        '    adm.cod_adm = termc.cod_adm'
        '    and adm.cod_empresa = termc.cod_empresa'
        'left join bandeiras_cartao band on'
        '    band.cod_bandeira = cc.cod_bandeira_adm'
        '   and band.cod_empresa = cc.cod_emp_mult'
        'where cc.datq_c is null'
        'and coalesce(cc.n_docnsu_adm, '#39#39') <> '#39#39
        'and coalesce(cc.n_aut_cart, '#39#39') <> '#39#39
        
          'and (select result from retorna_pend_confere (cc.n_docnsu_adm, c' +
          'c.n_aut_cart, cc.nparcela, cc.cod_emp_mult)) = 0'
        'union'
        'select cc.cod_cred, cc.codigo_emp, cc.cod_emp_mult,'
        'cc.data_rec_c, cc.data_venc_c,'
        'cc.n_docnsu_adm, cc.n_aut_cart,'
        'cc.nparcela, cc.qtde_parc,'
        'cc.codigo_ctrl, ctrl.nome_ctrl,'
        'cc.n_doc_v, cc.n_doc_c, cc.tp_doc_v,'
        'coalesce(cc.valor_c, 0) valor_c,'
        'coalesce(cc.valor_liquido, 0) valor_liquido,'
        'coalesce(cc.valor_original, 0) valor_original,'
        'cc.datq_c, cc.status_c,'
        
          'case when ((coalesce(cc.valor_original, cc.valor_c) > 0) and (co' +
          'alesce(cc.valor_liquido, 0) > 0) and (coalesce(cc.valor_original' +
          ', cc.valor_c) <> coalesce(cc.valor_liquido, 0))) then'
        
          '        (100 - ((coalesce(cc.valor_original, cc.valor_c, 0) / co' +
          'alesce(cc.valor_c, 0)) * 100))'
        '     else 0'
        'end taxa_cred,'
        'coalesce(cc.cod_cliente, 0) cod_cliente,'
        
          'trim(case when (cc.cod_cliente > 0) then cl.nome_cliente else cc' +
          '.nome_c end) nome_cliente,'
        
          'cc.cod_terminal_adm, termc.desc_term_adm, cc.cod_adm, adm.descri' +
          'cao_adm,'
        'cc.cod_bandeira_adm, band.descricao, '
        'cc.nome_c, emp.identificacao_emp from controle_creditos cc '
        'left join clientes cl on '
        '    cl.cod_cliente = cc.cod_cliente '
        '    and cl.cod_empresa = cc.cod_emp_mult '
        'inner join empresa emp on '
        '    emp.cod_empresa = cc.cod_emp_mult '
        'inner join controles ctrl on '
        '    ctrl.codigo_ctrl = cc.codigo_ctrl '
        '    and ctrl.codigo_emp = cc.cod_emp_mult '
        '    and ctrl.tp_plano = '#39'C'#39' '
        'left join terminal_cartao termc on '
        '    termc.cod_term_adm = cc.cod_terminal_adm '
        '    and termc.cod_empresa = cc.cod_emp_mult '
        'left join adm_cartao adm on '
        '    adm.cod_adm = termc.cod_adm '
        '    and adm.cod_empresa = termc.cod_empresa '
        'left join bandeiras_cartao band on '
        '    band.cod_bandeira = cc.cod_bandeira_adm '
        '    and band.cod_empresa = cc.cod_emp_mult '
        'where cc.datq_c is null'
        'and coalesce(cc.n_docnsu_adm, '#39#39') = '#39#39
        'and coalesce(cc.n_aut_cart, '#39#39') = '#39#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_CL_COM_CONTR_PROD_SERV_VLCTR FOR CLIE' +
          'NTES_COM_CONTRATO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VSERV T_VL_TODOS;'
        '  DECLARE VARIABLE VPROD T_VL_TODOS;'
        'begin'
        '  /* Trigger text */'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (coalesce(new.cod_servico, 0) > 0) then'
        '    exit;'
        ''
        '  if (coalesce(new.assinatura_vindi_id, 0) > 0) then'
        '    exit;'
        ''
        
          '  select sum(coalesce(qtde, 0) * coalesce(valor_un, 0)) from cli' +
          'entes_com_contrato_serv'
        '  where cod_contrato = new.cod_contrato'
        '  and cod_empresa = new.cod_empresa'
        '    into :vserv;'
        ''
        '  vserv = coalesce(:vserv, 0);'
        ''
        
          '  select sum(coalesce(qtde, 0) * coalesce(valor_un, 0)) from cli' +
          'entes_com_contrato_prod'
        '  where cod_contrato = new.cod_contrato'
        '  and cod_empresa = new.cod_empresa'
        '    into :vprod;'
        ''
        '  vprod = coalesce(vprod, 0);'
        ''
        '  if (coalesce(vserv, 0) + coalesce(vprod, 0) > 0) then'
        
          '    new.valor_contrato = Round(coalesce(:vserv, 0) + coalesce(:v' +
          'prod, 0), 2);'
        '  else'
        '    new.valor_contrato = 0;'
        ''
        '  if (coalesce(vprod, 0) > 0) then'
        '    new.valor_prod = Round(coalesce(vprod, 0), 2);'
        '  else'
        '    new.valor_prod = 0;'
        ''
        '  if (coalesce(vserv, 0) > 0) then'
        '    new.valor_serv = Round(coalesce(vserv, 0), 2);'
        '  else'
        '    new.valor_serv = 0;    '
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE GERADOR_OSBOL ADD VINDI CHAR(1);'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES ADD CLIENTE_VINDI_ID BIGINT;'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL;'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE CLIENTES_COM_CONTRATO ADD DATA_CANCELAMENTO TIMESTAM' +
          'P;'
        ''
        'ALTER TABLE FORMPAGAMENTO ADD COBRANCA_VINDI_ID BIGINT;'
        ''
        
          'CREATE INDEX IDX_FORMPAGAMENTO_COBR_VIND ON FORMPAGAMENTO (COBRA' +
          'NCA_VINDI_ID, COD_EMPRESA);'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_CONTRATOS ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    COD_CONTRATO integer,'
        '    DESCR_CONTRATO varchar(75),'
        '    TOT_FORMPAG double precision,'
        '    TOT_BOLETAS double precision,'
        '    N_SEQ_BOL varchar(22),'
        '    NOSSO_NUMERO_BANCO varchar(44),'
        '    DATA_REMESSA timestamp,'
        '    COD_COBREBEM integer,'
        '    COD_CONTROLE_CX integer,'
        '    COD_RPS varchar(100),'
        '    NUM_NFS varchar(100),'
        '    SERIE_NFS varchar(5),'
        '    DATA_NFS timestamp,'
        '    SITUACAO_NFS varchar(100),'
        '    DESCRICAOERRO_NFS varchar(1000),'
        '    COD_NF integer,'
        '    NUM_NF bigint,'
        '    SERIE_NF varchar(5),'
        '    DATA_NF timestamp,'
        '    SITUACAO_NF varchar(100),'
        '    DESCRICAOERRO_NF varchar(1000),'
        '    DATA_EMAIL_NFS timestamp,'
        '    DATA_WHATSAPP_NFS timestamp,'
        '    DATA_EMAIL_NF timestamp,'
        '    DATA_WHATSAPP_NF timestamp,'
        '    DATA_EMAIL_BOL timestamp,'
        '    DATA_WHATSAPP_BOL timestamp,'
        '    DATA_EMAIL_REC timestamp,'
        '    DATA_WHATSAPP_REC timestamp,'
        '    GERAR_NFS char(1),'
        '    GERAR_NF char(1),'
        '    GERAR_REC_LOC char(1),'
        '    GERAR_BOLETO char(1))'
        'as'
        'declare variable VCOD_RPS_TMP integer;'
        'declare variable VTOT_FORMPAG double precision;'
        'declare variable VTOT_BOLETAS double precision = 000.00;'
        'declare variable VNUM_NFS_TMP bigint;'
        'declare variable VN_SEQ_BOL_TMP integer;'
        'declare variable VNOSSO_NUMERO_BANCO_TMP varchar(20);'
        'declare variable VN_SEQ_BOL varchar(22);'
        'declare variable VNOSSO_NUMERO_BANCO varchar(44);'
        'declare variable VDATA_REMESSA timestamp;'
        'declare variable VCOD_COBREBEM integer;'
        'declare variable VCOD_CONTROLE_CX integer;'
        'declare variable VCOD_RPS varchar(100);'
        'declare variable VNUM_NFS varchar(100);'
        'declare variable VSERIE_NFS varchar(5);'
        'declare variable VDATA_NFS timestamp;'
        'declare variable VSITUACAO_NFS varchar(100);'
        'declare variable VDESCRICAOERRO_NFS varchar(1000);'
        'declare variable VCOD_NF integer;'
        'declare variable VNUM_NF bigint;'
        'declare variable VSERIE_NF varchar(5);'
        'declare variable VDATA_NF timestamp;'
        'declare variable VSITUACAO_NF varchar(100);'
        'declare variable VDESCRICAOERRO_NF varchar(1000);'
        'declare variable VDATA_EMAIL_NFS timestamp;'
        'declare variable VDATA_WHATSAPP_NFS timestamp;'
        'declare variable VDATA_EMAIL_NF timestamp;'
        'declare variable VDATA_WHATSAPP_NF timestamp;'
        'declare variable VDATA_EMAIL_BOL timestamp;'
        'declare variable VDATA_WHATSAPP_BOL timestamp;'
        'declare variable VDATA_EMAIL_REC timestamp;'
        'declare variable VDATA_WHATSAPP_REC timestamp;'
        'begin'
        '  /* Procedure Text */'
        '  cod_contrato        = null;'
        '  descr_contrato      = null;'
        '  num_nfs             = null;'
        '  serie_nfs           = null;'
        '  data_nfs            = null;'
        ''
        '  situacao_nfs        = null;'
        '  num_nf              = null;'
        '  serie_nf            = null;'
        '  data_nf             = null;'
        '  situacao_nf         = null;'
        '  descricaoerro_nf    = null;'
        ''
        '  tot_formpag         = null;'
        '  tot_boletas         = null;'
        '  n_seq_bol           = null;'
        '  nosso_numero_banco  = null;'
        '  data_remessa        = null;'
        '  cod_cobrebem        = null;'
        '  cod_controle_cx     = null;'
        ''
        '  data_email_nfs      = null;'
        '  data_whatsapp_nfs   = null;'
        '  data_email_nf       = null;'
        '  data_whatsapp_nf    = null;'
        '  data_email_bol      = null;'
        '  data_whatsapp_bol   = null;'
        ''
        '  data_email_rec      = null;'
        '  data_whatsapp_rec   = null;'
        ''
        '  gerar_nfs           = null;'
        '  gerar_nf            = null;'
        '  gerar_rec_loc       = null;'
        '  gerar_boleto        = null;'
        ''
        '  vcod_rps_tmp        = null;'
        '  vnum_nfs_tmp        = null;'
        ''
        '  vcod_rps            = null;'
        '  vnum_nfs            = null;'
        '  vserie_nfs          = null;'
        '  vdata_nfs           = null;'
        '  vsituacao_nfs       = null;'
        '  vdescricaoerro_nfs  = null;'
        ''
        '  vtot_formpag        = null;'
        '  vtot_boletas        = null;'
        '  vn_seq_bol          = null;'
        '  vnosso_numero_banco = null;'
        '  vdata_remessa       = null;'
        '  vcod_cobrebem       = null;'
        '  vcod_controle_cx    = null;'
        ''
        '  vdata_email_nfs     = null;'
        '  vdata_whatsapp_nfs  = null;'
        '  vdata_email_nf      = null;'
        '  vdata_whatsapp_nf   = null;'
        '  vdata_email_bol     = null;'
        '  vdata_whatsapp_bol  = null;'
        '  vdata_email_rec     = null;'
        '  vdata_whatsapp_rec  = null;'
        ''
        '  vcod_nf             = null;'
        '  vnum_nf             = null;'
        '  vserie_nf           = null;'
        '  vdata_nf            = null;'
        '  vsituacao_nf        = null;'
        '  vdescricaoerro_nf   = null;'
        ''
        
          '  select valor_total from existe_formas (:pnped, :ptipo, :pcod_e' +
          'mpresa)'
        '    into :vtot_formpag;'
        ''
        '  select sum(coalesce(boletas.vl_doc_bol, 0)) from boletas'
        '  where boletas.num_nf_vnd = :pnped'
        '  and boletas.tipo_emissao = :ptipo'
        '  and boletas.cod_empresa = :pcod_empresa'
        '  and boletas.ativo = 1'
        '    into :vtot_boletas;'
        ''
        
          '  for select first 2 boletas.n_seq_bol, boletas.nosso_numero_ban' +
          'co,'
        
          '      boletas.data_remessa, boletas.cod_cobrebem, boletas.cod_co' +
          'ntrole_cx from boletas'
        '      where boletas.num_nf_vnd = :pnped'
        '      and boletas.tipo_emissao = :ptipo'
        '      and boletas.cod_empresa = :pcod_empresa'
        '      and boletas.ativo = 1'
        '      order by 1'
        
          '        into :vn_seq_bol_tmp, :vnosso_numero_banco_tmp, :vdata_r' +
          'emessa, :vcod_cobrebem, :vcod_controle_cx do'
        '  begin'
        '    if (coalesce(vn_seq_bol_tmp, 0) > 0) then'
        
          '      vn_seq_bol = coalesce(vn_seq_bol, '#39#39') || iif(trim(coalesce' +
          '(vn_seq_bol, '#39#39')) <> '#39#39', '#39','#39', '#39#39') || coalesce(vn_seq_bol_tmp, 0)' +
          ';'
        ''
        '    if (trim(coalesce(vnosso_numero_banco_tmp, '#39#39')) <> '#39#39') then'
        
          '      vnosso_numero_banco = coalesce(vnosso_numero_banco, '#39#39') ||' +
          ' iif(trim(coalesce(vnosso_numero_banco, '#39#39')) <> '#39#39', '#39','#39', '#39#39') || ' +
          'coalesce(vnosso_numero_banco_tmp, 0);'
        '  end'
        ''
        '  if (coalesce(vn_seq_bol_tmp, 0) > 0) then'
        '  begin'
        '    select first 1 data_env from('
        '        select env_doc.data_env from env_doc'
        '        where env_doc.num_doc = '#39'BOL_'#39' || :vn_seq_bol_tmp'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'W'#39
        '        union'
        '        select bol.data_whatsapp_bol from boletas bol'
        '        where bol.n_seq_bol = :vn_seq_bol_tmp'
        '        and bol.cod_empresa = :pcod_empresa'
        '        order by 1 desc)'
        '    order by 1 desc'
        '          into :vdata_whatsapp_bol;'
        ''
        '    select first 1 data_env from('
        '        select env_doc.data_env from env_doc'
        '        where env_doc.num_doc = '#39'BOL_'#39' || :vn_seq_bol_tmp'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'E'#39
        '        union'
        '        select bol.data_email_bol from boletas bol'
        '        where bol.n_seq_bol = :vn_seq_bol_tmp'
        '        and bol.cod_empresa = :pcod_empresa'
        '        order by 1 desc)'
        '    order by 1 desc'
        '          into :vdata_email_bol;'
        '  end'
        ''
        '  if (coalesce(pnped, 0) > 0) then'
        '  begin'
        '    select first 1 data_env from('
        '        select first 1 env_doc.data_env from env_doc'
        
          '        where env_doc.num_doc = '#39'LOC'#39' || trim(:ptipo) || '#39'_'#39'  ||' +
          ' :pnped'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'W'#39
        '        order by 1 desc)'
        '          into :vdata_whatsapp_rec;'
        ''
        '    select first 1 data_env from('
        '        select first 1 env_doc.data_env from env_doc'
        
          '        where env_doc.num_doc = '#39'LOC'#39' || trim(:ptipo) || '#39'_'#39' || ' +
          ':pnped'
        '        and env_doc.cod_empresa = :pcod_empresa'
        '        and env_doc.tipo_env = '#39'E'#39
        '        order by 1 desc)'
        '          into :vdata_email_rec;'
        '  end'
        ''
        
          '  for select distinct pedvenda_serv.cod_rps, pedvenda_serv.n_nf,' +
          ' pedvenda_serv.serie,'
        
          '        pedvenda_serv.emissao_nfse, pedvenda_serv.status_nfse fr' +
          'om pedvenda'
        '        inner join pedvenda_serv on'
        '          pedvenda_serv.nped = pedvenda.nped'
        '          and pedvenda_serv.tipo = pedvenda.tipo'
        '          and pedvenda_serv.cod_empresa = pedvenda.cod_empresa'
        '        where pedvenda.nped = :pnped'
        '        and pedvenda.tipo = :ptipo'
        '        and pedvenda.cod_empresa = :pcod_empresa'
        '        and pedvenda.status_ped = '#39'FECHADA'#39
        
          '        and (pedvenda_serv.status <> '#39'CANCELADO'#39' or pedvenda_ser' +
          'v.status is null)'
        '        order by 1 asc'
        
          '          into :vcod_rps_tmp, :vnum_nfs_tmp, :vserie_nfs, :vdata' +
          '_nfs, :vsituacao_nfs do'
        '  begin'
        '    if (coalesce(vcod_rps_tmp, 0) > 0) then'
        
          '      vcod_rps = coalesce(vcod_rps, '#39#39') || iif(trim(coalesce(vco' +
          'd_rps, '#39#39')) <> '#39#39', '#39','#39', '#39#39') || coalesce(vcod_rps_tmp, 0);'
        ''
        '    if (coalesce(vnum_nfs_tmp, 0) > 0) then'
        
          '      vnum_nfs = coalesce(vnum_nfs, '#39#39') || iif(trim(coalesce(vnu' +
          'm_nfs, '#39#39')) <> '#39#39', '#39','#39', '#39#39') || coalesce(vnum_nfs_tmp, 0);'
        '  end'
        ''
        '  if (coalesce(vcod_rps_tmp, 0) > 0) then'
        '  begin'
        '    select first 1 env_doc.data_env from env_doc'
        '    where env_doc.num_doc = '#39'RPS_'#39' || :vcod_rps_tmp'
        '    and env_doc.cod_empresa = :pcod_empresa'
        '    and env_doc.tipo_env = '#39'W'#39
        '    order by env_doc.data_env desc'
        '      into :vdata_whatsapp_nfs;'
        '        '
        '    select first 1 env_doc.data_env from env_doc'
        '    where env_doc.num_doc = '#39'RPS_'#39' || :vcod_rps_tmp'
        '    and env_doc.cod_empresa = :pcod_empresa'
        '    and env_doc.tipo_env = '#39'E'#39
        '    order by env_doc.data_env desc'
        '      into :vdata_email_nfs;'
        '  end'
        ''
        
          '  select first 1 notafiscal.cod_nf, notafiscal.num_nf, notafisca' +
          'l.serie,'
        
          '  notafiscal.data_lanc, notafiscal.situacao_nfe, notafiscal.desc' +
          'ricaoerro from notafiscal'
        '  inner join pedvenda on'
        '    pedvenda.nped = notafiscal.nped'
        '    and pedvenda.tipo = notafiscal.tipo_ped'
        '    and pedvenda.cod_empresa = notafiscal.cod_empresa'
        '    and pedvenda.num_nf = notafiscal.num_nf'
        '    and pedvenda.serie_nf = notafiscal.serie'
        '  where notafiscal.nped = :pnped'
        '  and notafiscal.tipo_ped = :ptipo'
        '  and notafiscal.cod_empresa = :pcod_empresa'
        '  order by 1 desc'
        
          '    into :vcod_nf, :vnum_nf, vserie_nf, :vdata_nf, :vsituacao_nf' +
          ', :vdescricaoerro_nf;'
        ''
        '  if (coalesce(vcod_nf, 0) > 0) then'
        '  begin'
        '    select first 1 env_doc.data_env from env_doc'
        '    where env_doc.num_doc = '#39'NF_'#39' || :vcod_nf'
        '    and env_doc.cod_empresa = :pcod_empresa'
        '    and env_doc.tipo_env = '#39'W'#39
        '    order by env_doc.data_env desc'
        '      into :vdata_whatsapp_nf;'
        ''
        '    select first 1 env_doc.data_env from env_doc'
        '    where env_doc.num_doc = '#39'NF_'#39' || :vcod_nf'
        '    and env_doc.cod_empresa = :pcod_empresa'
        '    and env_doc.tipo_env = '#39'E'#39
        '    order by env_doc.data_env desc'
        '      into :vdata_email_nf;'
        '  end'
        ''
        
          '  for select distinct cod_contrato, descr_contrato, gerar_nfs, g' +
          'erar_nf, gerar_rec_loc, gerar_boleto from ('
        '        select distinct pedvenda_serv.cod_contrato,'
        '        clientes_com_contrato.descr_contrato,'
        '        clientes_com_contrato.gerar_nfs,'
        '        clientes_com_contrato.gerar_nf,'
        '        clientes_com_contrato.gerar_rec_loc,'
        '        clientes_com_contrato.gerar_boleto from pedvenda'
        '        inner join pedvenda_serv on'
        '          pedvenda_serv.nped = pedvenda.nped'
        '          and pedvenda_serv.tipo = pedvenda.tipo'
        '          and pedvenda_serv.cod_empresa = pedvenda.cod_empresa'
        '        inner join clientes_com_contrato on'
        
          '          clientes_com_contrato.cod_contrato = pedvenda_serv.cod' +
          '_contrato'
        
          '          and clientes_com_contrato.cod_empresa = pedvenda_serv.' +
          'cod_empresa'
        '        where pedvenda.nped = :pnped'
        '        and pedvenda.tipo = :ptipo'
        '        and pedvenda.cod_empresa = :pcod_empresa'
        '        and pedvenda.status_ped = '#39'FECHADA'#39
        
          '        and (pedvenda_serv.status <> '#39'CANCELADO'#39' or pedvenda_ser' +
          'v.status is null)'
        '        union'
        '        select distinct pedvenda_prod.cod_contrato,'
        '        clientes_com_contrato.descr_contrato,'
        '        clientes_com_contrato.gerar_nfs,'
        '        clientes_com_contrato.gerar_nf,'
        '        clientes_com_contrato.gerar_rec_loc,'
        '        clientes_com_contrato.gerar_boleto from pedvenda'
        '        inner join pedvenda_prod on'
        '          pedvenda_prod.nped = pedvenda.nped'
        '          and pedvenda_prod.tipo = pedvenda.tipo'
        '          and pedvenda_prod.cod_empresa = pedvenda.cod_empresa'
        '        inner join clientes_com_contrato on'
        
          '          clientes_com_contrato.cod_contrato = pedvenda_prod.cod' +
          '_contrato'
        
          '          and clientes_com_contrato.cod_empresa = pedvenda_prod.' +
          'cod_empresa'
        '        where pedvenda.nped = :pnped'
        '        and pedvenda.tipo = :ptipo'
        '        and pedvenda.cod_empresa = :pcod_empresa'
        '        and pedvenda.status_ped = '#39'FECHADA'#39
        
          '        and (pedvenda_prod.status <> '#39'CANCELADO'#39' or pedvenda_pro' +
          'd.status is null)  )'
        
          '          into :cod_contrato, :descr_contrato, :gerar_nfs, :gera' +
          'r_nf, :gerar_rec_loc, :gerar_boleto do'
        '  begin'
        '    cod_rps            = trim(vcod_rps);'
        '    num_nfs            = trim(vnum_nfs);'
        '    serie_nfs          = trim(vserie_nfs);'
        '    data_nfs           = vdata_nfs;'
        '    situacao_nfs       = trim(vsituacao_nfs);'
        '    descricaoerro_nfs  = trim(vdescricaoerro_nfs);'
        '    data_email_nfs     = vdata_email_nfs;'
        '    data_whatsapp_nfs  = vdata_whatsapp_nfs;'
        ''
        '    cod_nf             = vcod_nf;'
        '    num_nf             = vnum_nf;'
        '    serie_nf           = trim(vserie_nf);'
        '    data_nf            = vdata_nf;'
        '    situacao_nf        = trim(vsituacao_nf);'
        '    descricaoerro_nf   = trim(vdescricaoerro_nf);'
        '    data_email_nf      = vdata_email_nf;'
        '    data_whatsapp_nf   = vdata_whatsapp_nf;'
        ''
        '    tot_formpag        = vtot_formpag;'
        '    tot_boletas        = vtot_boletas;'
        '    n_seq_bol          = trim(vn_seq_bol);'
        '    nosso_numero_banco = trim(vnosso_numero_banco);'
        '    data_remessa       = vdata_remessa;'
        '    cod_cobrebem       = vcod_cobrebem;'
        '    cod_controle_cx    = vcod_controle_cx;'
        '    data_email_bol     = vdata_email_bol;'
        '    data_whatsapp_bol  = vdata_whatsapp_bol;'
        ''
        '    data_email_rec     = vdata_email_rec;'
        '    data_whatsapp_rec  = vdata_whatsapp_rec;'
        ''
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL('
        '    COD_GERADOR,'
        '    COD_EMPRESA,'
        '    NPED,'
        '    TIPO,'
        '    DATA_PED,'
        '    DATA_FECH,'
        '    VALOR_TOTAL,'
        '    TOT_ACRESCIMO,'
        '    TOT_DESCONTO,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    TOT_FORMPAG,'
        '    TOT_BOLETAS,'
        '    STATUS_PED,'
        '    TIPO_OS,'
        '    GERAR_NFS,'
        '    GERAR_NF,'
        '    GERAR_REC_LOC,'
        '    GERAR_BOLETO,'
        '    COD_RPS,'
        '    NUM_NFS,'
        '    SERIE_NFS,'
        '    DATA_NFS,'
        '    SITUACAO_NFS,'
        '    DESCRICAOERRO_NFS,'
        '    DATA_EMAIL_NFS,'
        '    DATA_WHATSAPP_NFS,'
        '    COD_NF,'
        '    NUM_NF,'
        '    SERIE_NF,'
        '    DATA_NF,'
        '    SITUACAO_NF,'
        '    DESCRICAOERRO_NF,'
        '    DATA_EMAIL_NF,'
        '    DATA_WHATSAPP_NF,'
        '    COD_CONTRATO,'
        '    DESCR_CONTRATO,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    RAZAO,'
        '    CPFCGC,'
        '    FONE_CLIENTE,'
        '    FONE_CELULAR,'
        '    EMAIL,'
        '    CODIGO_UF,'
        '    SIGLA_UF,'
        '    COD_CIDADE,'
        '    NOME_CIDADE,'
        '    COD_BAIRRO,'
        '    NOME_BAIRRO,'
        '    CEP,'
        '    ENDERECO,'
        '    NUM_END_CLIENTE,'
        '    N_SEQ_BOL,'
        '    NOSSO_NUMERO_BANCO,'
        '    DATA_REMESSA,'
        '    COD_COBREBEM,'
        '    COD_CONTROLE_CX,'
        '    DATA_EMAIL_BOL,'
        '    DATA_WHATSAPP_BOL,'
        '    DATA_EMAIL_REC,'
        '    DATA_WHATSAPP_REC,'
        '    LOCACAO,'
        '    FATURA_VINDI_ID,'
        '    PEND_NFS,'
        '    PEND_NF,'
        '    PEND_REC_LOC,'
        '    PEND_BOLETO)'
        'AS'
        'SELECT PEDVENDA.COD_GERADOR, PEDVENDA.COD_EMPRESA,'
        
          'PEDVENDA.NPED, PEDVENDA.TIPO, PEDVENDA.DATA_PED, PEDVENDA.DATA_F' +
          'ECH,'
        'COALESCE(PEDVENDA.VALOR_TOTAL, 0) VALOR_TOTAL,'
        
          '(COALESCE((SELECT SUM(COALESCE(PEDVENDA_PROD.RATEIO_ACRESC, 0)) ' +
          'FROM PEDVENDA_PROD'
        '                   WHERE PEDVENDA_PROD.NPED = PEDVENDA.NPED'
        '                   AND PEDVENDA_PROD.TIPO = PEDVENDA.TIPO'
        
          '                   AND PEDVENDA_PROD.COD_EMPRESA = PEDVENDA.COD_' +
          'EMPRESA'
        
          '                   AND COALESCE(PEDVENDA_PROD.STATUS, '#39#39') <> '#39'CA' +
          'NCELADO'#39'), 0) +'
        
          ' COALESCE((SELECT SUM(COALESCE(PEDVENDA_SERV.RATEIO_ACRESC, 0)) ' +
          'FROM PEDVENDA_SERV'
        '           WHERE PEDVENDA_SERV.NPED = PEDVENDA.NPED'
        '           AND PEDVENDA_SERV.TIPO = PEDVENDA.TIPO'
        '           AND PEDVENDA_SERV.COD_EMPRESA = PEDVENDA.COD_EMPRESA'
        
          '           AND COALESCE(PEDVENDA_SERV.STATUS, '#39#39') <> '#39'CANCELADO'#39 +
          '), 0)'
        ' ) TOT_ACRESCIMO,'
        
          '(COALESCE((SELECT SUM(COALESCE(PEDVENDA_PROD.RATEIO_DESC, 0)) FR' +
          'OM PEDVENDA_PROD'
        '           WHERE PEDVENDA_PROD.NPED = PEDVENDA.NPED'
        '           AND PEDVENDA_PROD.TIPO = PEDVENDA.TIPO'
        '           AND PEDVENDA_PROD.COD_EMPRESA = PEDVENDA.COD_EMPRESA'
        
          '           AND COALESCE(PEDVENDA_PROD.STATUS, '#39#39') <> '#39'CANCELADO'#39 +
          '), 0) +'
        
          ' COALESCE((SELECT SUM(COALESCE(PEDVENDA_SERV.RATEIO_DESC, 0)) FR' +
          'OM PEDVENDA_SERV'
        '           WHERE PEDVENDA_SERV.NPED = PEDVENDA.NPED'
        '           AND PEDVENDA_SERV.TIPO = PEDVENDA.TIPO'
        '           AND PEDVENDA_SERV.COD_EMPRESA = PEDVENDA.COD_EMPRESA'
        
          '           AND COALESCE(PEDVENDA_SERV.STATUS, '#39#39') <> '#39'CANCELADO'#39 +
          '), 0)'
        ' ) TOT_DESCONTO,'
        'COALESCE(PEDVENDA.TOT_PROD, 0) TOT_PROD,'
        'COALESCE(PEDVENDA.TOT_SERV, 0) TOT_SERV,'
        'COALESCE(PEDVENDA.TOT_PROD_TERC, 0) TOT_PROD_TERC,'
        'COALESCE(PEDVENDA.TOT_SERV_TERC, 0) TOT_SERV_TERC,'
        'COALESCE(RETORNA_CONTRATOS.TOT_FORMPAG, 0) TOT_FORMPAG,'
        'COALESCE(RETORNA_CONTRATOS.TOT_BOLETAS, 0) TOT_BOLETAS,'
        'PEDVENDA.STATUS_PED, PEDVENDA.TIPO_OS, '
        'RETORNA_CONTRATOS.GERAR_NFS,'
        'RETORNA_CONTRATOS.GERAR_NF,'
        'RETORNA_CONTRATOS.GERAR_REC_LOC,'
        'RETORNA_CONTRATOS.GERAR_BOLETO,'
        
          'RETORNA_CONTRATOS.COD_RPS, RETORNA_CONTRATOS.NUM_NFS, RETORNA_CO' +
          'NTRATOS.SERIE_NFS,'
        
          'RETORNA_CONTRATOS.DATA_NFS, RETORNA_CONTRATOS.SITUACAO_NFS, RETO' +
          'RNA_CONTRATOS.DESCRICAOERRO_NFS,'
        
          'RETORNA_CONTRATOS.DATA_EMAIL_NFS, RETORNA_CONTRATOS.DATA_WHATSAP' +
          'P_NFS,'
        
          'RETORNA_CONTRATOS.COD_NF, RETORNA_CONTRATOS.NUM_NF, RETORNA_CONT' +
          'RATOS.SERIE_NF,'
        
          'RETORNA_CONTRATOS.DATA_NF, RETORNA_CONTRATOS.SITUACAO_NF, RETORN' +
          'A_CONTRATOS.DESCRICAOERRO_NF,'
        
          'RETORNA_CONTRATOS.DATA_EMAIL_NF, RETORNA_CONTRATOS.DATA_WHATSAPP' +
          '_NF,'
        
          'RETORNA_CONTRATOS.COD_CONTRATO, RETORNA_CONTRATOS.DESCR_CONTRATO' +
          ', '
        'PEDVENDA.COD_CLIENTE, CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, '
        
          'CLIENTES.CPFCGC, CLIENTES.FONE_CLIENTE, CLIENTES.FONE_CELULAR, C' +
          'LIENTES.EMAIL, '
        'CLIENTES.CODIGO_UF, ESTADOS.SIGLA_UF,'
        'CLIENTES.COD_CIDADE, CIDADES.NOME_CIDADE,'
        'CLIENTES.COD_BAIRRO, BAIRROS.NOME_BAIRRO,'
        'CLIENTES.CEP, CLIENTES.ENDERECO, CLIENTES.NUM_END_CLIENTE,'
        
          'RETORNA_CONTRATOS.N_SEQ_BOL, RETORNA_CONTRATOS.NOSSO_NUMERO_BANC' +
          'O, RETORNA_CONTRATOS.DATA_REMESSA,'
        
          'RETORNA_CONTRATOS.COD_COBREBEM, RETORNA_CONTRATOS.COD_CONTROLE_C' +
          'X,'
        
          'RETORNA_CONTRATOS.DATA_EMAIL_BOL, RETORNA_CONTRATOS.DATA_WHATSAP' +
          'P_BOL,'
        
          'RETORNA_CONTRATOS.DATA_EMAIL_REC, RETORNA_CONTRATOS.DATA_WHATSAP' +
          'P_REC,'
        'EXISTE_LOCACAO.RESULT, PEDVENDA.FATURA_VINDI_ID,'
        
          'CASE WHEN ((COALESCE(RETORNA_CONTRATOS.GERAR_NFS, '#39'N'#39') = '#39'S'#39') an' +
          'd (COALESCE(PEDVENDA.TOT_SERV, 0) > 0) and (COALESCE(RETORNA_CON' +
          'TRATOS.NUM_NFS, '#39#39') = '#39#39')) then'
        '       '#39'S'#39
        '     ELSE'
        '       '#39'N'#39
        'END PEND_NFS,'
        
          'CASE WHEN ((COALESCE(RETORNA_CONTRATOS.GERAR_NF, '#39'N'#39') = '#39'S'#39') and' +
          ' (COALESCE(PEDVENDA.TOT_PROD, 0) > 0) and (COALESCE(RETORNA_CONT' +
          'RATOS.NUM_NF, 0) <= 0)) then'
        '       '#39'S'#39
        '     ELSE'
        '       '#39'N'#39
        'END PEND_NF,'
        #39'N'#39' PEND_REC_LOC,'
        
          'CASE WHEN ((COALESCE(RETORNA_CONTRATOS.GERAR_BOLETO, '#39'N'#39') = '#39'S'#39')' +
          ' and (COALESCE(RETORNA_CONTRATOS.TOT_BOLETAS, 0) > 0) and (COALE' +
          'SCE(retorna_contratos.N_SEQ_BOL, '#39#39') = '#39#39')) then'
        '        '#39'S'#39
        '     ELSE'
        '       '#39'N'#39
        'END PEND_BOLETO'
        ' FROM PEDVENDA'
        'INNER JOIN CLIENTES ON '
        '    CLIENTES.COD_CLIENTE = PEDVENDA.COD_CLIENTE '
        '    AND CLIENTES.COD_EMPRESA = PEDVENDA.COD_EMPRESA'
        'LEFT JOIN CIDADES ON CIDADES.COD_CIDADE = CLIENTES.COD_CIDADE'
        'LEFT JOIN ESTADOS ON ESTADOS.CODIGO_UF = CLIENTES.CODIGO_UF'
        'LEFT JOIN BAIRROS ON BAIRROS.COD_BAIRRO = CLIENTES.COD_BAIRRO'
        'LEFT JOIN RETORNA_CONTRATOS ( '
        '    PEDVENDA.NPED, '
        '    PEDVENDA.TIPO, '
        '    PEDVENDA.COD_EMPRESA) ON 1 = 1'
        'LEFT JOIN EXISTE_LOCACAO ('
        '    PEDVENDA.NPED, '
        '    PEDVENDA.TIPO, '
        '    PEDVENDA.COD_EMPRESA) ON 1 = 1;'
        '|/BLOCO|'
        ''
        
          'CREATE INDEX IDX_GERADOR_OSBOL_M_A_EMP_V ON GERADOR_OSBOL (MES_V' +
          'ENCIMENTO, ANO_VENCIMENTO, COD_EMPRESA, VINDI);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND281'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR SALVAR ITEM SEM ESTOQUE'#39', 100, '#39'FRMCADPEDVENDA'#39', 1, '#39'N'#39', ' +
          #39'N'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND282'#39', :COD_EMPRESA, '#39'HA' +
          'B PROC P/ PERM  SALVAR PEDIDO ITENS SEM ESTOQUE'#39', 100, '#39'FRMCADPE' +
          'DVENDA'#39', 1, '#39'N'#39', '#39'N'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND283'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR SALVAR PEDIDO ITENS SEM ESTOQUE'#39', 100, '#39'FRMCADPEDVENDA'#39', ' +
          '1, '#39'S'#39', '#39'N'#39', CURRENT_DATE);'
        ''
        
          'INSERT INTO CONCILIACAO_COD_AJUSTE (ID, DESCRICAO, TIPO) VALUES ' +
          '(378, '#39'Cobranca/devolucao da mensalidade do aluguel da maquina C' +
          'ielo'#39', '#39'Acerto'#39');'
        ''
        
          'INSERT INTO CONCILIACAO_COD_AJUSTE_ADQ (ID_ADQUIRENTE, ID_COD_AJ' +
          'USTE, CODIGO, CODIGO_ANT) VALUES (1, 378, '#39'0065'#39', null);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAS531'#39', :COD_EMPRESA, '#39'CO' +
          'PIAR TIPO DE SERVICO'#39', 3, '#39'FRMCADTIPOSERV'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT' +
          '_DATE);'
        ''
        'CREATE INDEX IDX_COLAB_CPF ON COLABORADOR (CPF_VENDEDOR);'
        ''
        '|BLOCO|'
        'create or alter procedure SP_SPLITCHARS ('
        '    TEXT_INPUT blob sub_type 1 segment size 80,'
        '    ACHARS blob sub_type 1 segment size 80 = '#39','#39','
        '    IGNORE_EMPTYS char(1) = '#39'S'#39')'
        'returns ('
        '    TEXT blob sub_type 1 segment size 80)'
        'as'
        '  declare variable ASUB blob sub_type 1 segment size 80;'
        '  declare variable ACH char(1);'
        'begin'
        '  TEXT = null;'
        '  ASUB = TEXT_INPUT;'
        ''
        '  while (char_length(ASUB) > 0) do'
        '  begin'
        '    ACH = substring(ASUB from 1 for 1);'
        '    ASUB = substring(ASUB from 2 for char_length(ASUB) - 1);'
        '    if (achars containing ach) then'
        '    begin'
        '      if ((TEXT <> '#39#39') or (IGNORE_EMPTYS <> '#39'S'#39')) then'
        '        suspend;'
        ''
        '      TEXT = '#39#39';'
        '    end'
        '    else'
        '      TEXT = coalesce(TEXT, '#39#39') || ACH;'
        '  end'
        ''
        
          '  if ((TEXT = null) and (coalesce(TEXT_INPUT, '#39#39') <> '#39#39')) then -' +
          '- nao entrou no while'
        '  begin'
        '    TEXT = TEXT_INPUT;'
        '    suspend;'
        '  end'
        
          '  else if ((TEXT <> '#39#39') or (IGNORE_EMPTYS <> '#39'S'#39')) then -- entro' +
          'u no while, porem nao teve split'
        '    suspend;'
        'end'
        '|/BLOCO|'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 510, RDB$CHARACTER_LENG' +
          'TH = 510 where RDB$FIELD_NAME = (select rdb$field_source from rd' +
          'b$relation_fields where rdb$relation_name = '#39'NOTAFISCAL_SPED_C11' +
          '0'#39' and rdb$field_name = '#39'TXT_COMPL'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 510, RDB$CHARACTER_LENG' +
          'TH = 510 where RDB$FIELD_NAME = (select rdb$field_source from rd' +
          'b$relation_fields where rdb$relation_name = '#39'SPED_INFORMACAO_COM' +
          'PLEMENTAR'#39' and rdb$field_name = '#39'TXT'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_LENGTH = 510, RDB$CHARACTER_LENG' +
          'TH = 510 where RDB$FIELD_NAME = (select rdb$field_source from rd' +
          'b$relation_fields where rdb$relation_name = '#39'SPED_INFORMACAO_COM' +
          'PLEMENTAR'#39' and rdb$field_name = '#39'TXT_COMPL'#39');'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO453'#39', :COD_EMPRESA, '#39'AL' +
          'TERAR DADOS GRADES EM LOTE'#39', 5, '#39'FRMCADGRADE'#39', 1, '#39'N'#39', '#39'S'#39', CURR' +
          'ENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO454'#39', :COD_EMPRESA, '#39'SA' +
          'LVAR DADOS GRADES EM LOTE'#39', 5, '#39'FRMCADGRADE'#39', 1, '#39'S'#39', '#39'S'#39', CURRE' +
          'NT_DATE);'
        ''
        '|BLOCO|'
        'create or alter procedure KIT_COM_GRADE ('
        '    PCODIGO_KIT integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT integer)'
        'as'
        'declare variable VGRUPO_PROD integer;'
        'declare variable VCOD_PROD char(6);'
        'begin'
        '  /* Procedure Text */'
        '  result = 0;'
        
          '  for  select distinct i.grupo_prod, i.cod_prod from kits_prod_k' +
          'its i'
        '       where i.codigo_kit = :pcodigo_kit'
        '       and i.cod_empresa = :pcod_empresa'
        '         into :vgrupo_prod, :vcod_prod do'
        '  begin'
        
          '     select first 1 iif(c.cod_empresa > 0, 1, 0)  from cod_grade' +
          '_prod c'
        '     where c.grupo_prod = :vgrupo_prod'
        '     and c.cod_prod = :vcod_prod'
        '     and c.cod_empresa = :pcod_empresa'
        '        into result;'
        ''
        '     if (result > 0) then'
        '        break;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER trigger tr_cond_pag_emp for cond_pag'
        'inactive before insert position 1'
        'AS'
        '  DECLARE VARIABLE VRESULT VARCHAR(10);'
        'begin'
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    if (new.cod_cond_pag > 0) then'
        '    begin'
        
          '      select result from sp_inserir_condpag_emp(new.cod_cond_pag' +
          ', 0) into :vresult;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER trigger cond_pagtrigger1 for cond_pag'
        'active before insert position 0'
        'AS'
        'BEGIN'
        '  if (new.COD_COND_PAG is null) then'
        '    new.COD_COND_PAG = gen_id(INC_COD_CONDPAG,1);'
        'END;'
        '|/BLOCO|'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR CONTROLE' +
          ' - EXCLUIR PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'CXG003'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR CONTROLE' +
          ' - ENVIAR PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'CXG005'#39';'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR VEICULO ' +
          '- ENVIAR PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'VEI008'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR VEICULO ' +
          '- EXCLUIR PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'VEI012'#39';'
        ''
        'delete from config_colunas where componente = '#39'cdsCondPgto'#39';'
        'delete from config_colunas where componente = '#39'cdsControles'#39';'
        'delete from config_colunas where componente = '#39'cdsTipoServ'#39';'
        'delete from config_colunas where componente = '#39'CdsVeiculos'#39';'
        'delete from config_colunas where componente = '#39'cdsEquipamentos'#39';'
        'delete from config_colunas where componente = '#39'cdsColab'#39';'
        'delete from config_colunas where componente = '#39'cdsParticipante'#39';'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR MOD VEIC' +
          ' - ENVIAR PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'VEI015'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR MOD VEIC' +
          ' - EXCLUIR PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'VEI019'#39';'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR EQUIPAME' +
          'NTO - ENVIAR PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'EQU003'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR EQUIPAME' +
          'NTO - EXCLUIR PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'EQU014'#39';'
        ''
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR COLABORA' +
          'DOR - ENVIAR PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'COL004'#39';'
        
          'UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT DELETAR COLABORA' +
          'DOR - EXCLUIR PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'COL013'#39';'
