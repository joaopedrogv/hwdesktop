        'CREATE OR ALTER TRIGGER TR_CLIENTES_LIXEIRA FOR CLIENTES'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if ((new.ativo = 99)'
        '    and (new.ativo <> old.ativo)'
        '    and (trim(coalesce(new.cpfcgc, '#39#39')) <> '#39#39')) then'
        '  begin'
        '    new.cpfcgc_old = new.cpfcgc;'
        '    new.cpfcgc = null;'
        '  end'
        'end;'
        '|/BLOCO|'
