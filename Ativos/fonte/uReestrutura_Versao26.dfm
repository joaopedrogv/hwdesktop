        'create or alter procedure GETESTOQUEEMPRESAS ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMRESAS varchar(50),'
        '    PSOMAR_EMP_SEM_EST integer)'
        'returns ('
        '    ESTOQUE double precision,'
        '    PEND_REQOS double precision,'
        '    PEND_PDC double precision,'
        '    PEND_ALMOX double precision,'
        '    EST_F double precision,'
        '    EST_PRIMA double precision)'
        'as'
        'declare variable EMPRESA varchar(20);'
        'declare variable VESTOQUE double precision;'
        'declare variable VPEND_REQOS double precision;'
        'declare variable VPEND_PDC double precision;'
        'declare variable VPEND_ALMOX double precision;'
        'declare variable VEST_F double precision;'
        'declare variable VEST_PRIMA double precision;'
        'begin'
        '  /* Procedure Text */'
        '  estoque = 0;'
        '  pend_reqos = 0;'
        '  pend_pdc = 0;'
        '  pend_almox = 0;'
        '  est_f = 0;'
        '  est_prima = 0;'
        ''
        '  vestoque = 0;'
        '  vpend_reqos = 0;'
        '  vpend_pdc = 0;'
        '  vpend_almox = 0;'
        '  vest_f = 0;'
        '  vest_prima = 0;'
        '  for select osplit from p_split (:pcod_emresas, '#39','#39')'
        '    into :empresa do'
        '  begin'
        
          '    select estoque, pend_reqos, pend_pdc, pend_almox, est_f, est' +
          '_prima  from getestoquedisponivel'
        
          '        (:pgrupo_prod, :pcod_prod, :pcod_grade, :empresa, 0, '#39#39',' +
          ' 0, 0)'
        
          '          into :vestoque, :vpend_reqos, :vpend_pdc, :vpend_almox' +
          ', :vest_f, :vest_prima;'
        ''
        '    if (coalesce(psomar_emp_sem_est, 0) > 1) then'
        '    begin'
        
          '      estoque    = coalesce(estoque, 0)    + coalesce(vestoque, ' +
          '0);'
        
          '      pend_reqos = coalesce(pend_reqos, 0) + coalesce(vpend_reqo' +
          's, 0);'
        
          '      pend_pdc   = coalesce(pend_pdc, 0)   + coalesce(vpend_pdc,' +
          ' 0);'
        
          '      pend_almox = coalesce(pend_almox, 0) + coalesce(vpend_almo' +
          'x, 0);'
        
          '      est_f      = coalesce(est_f, 0)      + coalesce(vest_f, 0)' +
          ';'
        
          '      est_prima  = coalesce(est_prima, 0)  + coalesce(vest_prima' +
          ', 0);'
        '    end'
        '    else if (coalesce(vestoque, 0) > 0) then'
        '    begin'
        
          '      estoque    = coalesce(estoque, 0)    + coalesce(vestoque, ' +
          '0);'
        
          '      pend_reqos = coalesce(pend_reqos, 0) + coalesce(vpend_reqo' +
          's, 0);'
        
          '      pend_pdc   = coalesce(pend_pdc, 0)   + coalesce(vpend_pdc,' +
          ' 0);'
        
          '      pend_almox = coalesce(pend_almox, 0) + coalesce(vpend_almo' +
          'x, 0);'
        
          '      est_f      = coalesce(est_f, 0)      + coalesce(vest_f, 0)' +
          ';'
        
          '      est_prima  = coalesce(est_prima, 0)  + coalesce(vest_prima' +
          ', 0);'
        '    end'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'CATEGORIA'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'CLIENTES'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'CUPOM_DESCONTO_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'DEL_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'FORMPAGAMENTO_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'KITS_PROD'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'KITS_PROD_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'KITS_PROD_KITS'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'MARCA_PROD_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'NOTAFISCAL_DANFE'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'NOT_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'PEDVENDA'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'PRODUTOS'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'PRODUTOS_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'PRODUTOS_EC_GRADE'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'TIPO_GRADE_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 16, RDB$FIELD_LENGTH = 8,' +
          ' RDB$CHARACTER_LENGTH = NULL where RDB$FIELD_NAME = (select rdb$' +
          'field_source from rdb$relation_fields where rdb$relation_name = ' +
          #39'VALOR_TIPO_GRADE_EC'#39' and rdb$field_name = '#39'ID_COMMERCE'#39');'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_PRODUTOS_EC('
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_EMPRESA,'
        '    ATIVO,'
        '    NUM_FAB_PROD,'
        '    DESCR_PROD_RES,'
        '    DESCR_PROD_COMPL,'
        '    SINC_ECOMMERCE,'
        '    ID_COMMERCE,'
        '    DISPONIVEL,'
        '    PROMOCIONAL,'
        '    FRETE_GRATIS,'
        '    LANCAMENTO,'
        '    DESTAQUE,'
        '    VARIACAO,'
        '    TERMOS_ACEITE,'
        '    COMPREJUNTO,'
        '    VIRTUAL,'
        '    ENV_COMERCIO_ABERTO,'
        '    ID_COMERCIO_ABERTO,'
        '    DESCRICAO_MARCA,'
        '    LISTA_IMAGENS,'
        '    URL_IMAGENS,'
        '    LISTA_IMAGENS_GRADE,'
        '    URL_IMAGENS_GRADE,'
        '    REFERENCE,'
        '    COM_GRADE,'
        '    COD_GRADE,'
        '    GRADE1,'
        '    GRADE2,'
        '    EST_DISP,'
        '    EST_DISP_GRADE,'
        '    EST_MINIMO,'
        '    MANUAL_EST_DISP,'
        '    MANUAL_EST_DISP_GRADE,'
        '    MANUAL_EST_MINIMO,'
        '    API,'
        '    API_PRECO_TABELA,'
        '    PRECO_TABELA,'
        '    DESCRICAOPROMOCAO,'
        '    VALORPROMOCAO,'
        '    DATAINICIOPROMOCAO,'
        '    DATAFIMPROMOCAO,'
        '    HORAINICIOPROMOCAO,'
        '    HORAFIMPROMOCAO,'
        '    PRECO_A_COMBINAR_EC,'
        '    PRECO_A_COMBINAR_CA,'
        '    SEQID_CA)'
        'AS'
        'select'
        '  0 TIPO,'
        '--DADOS DO PRODUTO'
        
          '  PEC.GRUPO_PROD, PEC.COD_PROD, PEC.COD_EMPRESA, PR.ATIVO, PR.NU' +
          'M_FAB_PROD,'
        
          '  coalesce(PEC.DESCR_PROD_RES, PR.DESCR_PROD) DESCR_PROD_RES, PE' +
          'C.DESCR_PROD_COMPL,'
        ''
        '  CASE WHEN (PECG.COD_GRADE > 0) THEN'
        
          '         CASE WHEN (PEC.SINC_ECOMMERCE = '#39'S'#39') AND (PECG.SINC_ECO' +
          'MMERCE = '#39'S'#39') THEN'
        '                '#39'S'#39
        '              ELSE'
        '                '#39'N'#39
        '         END'
        '       ELSE'
        '         COALESCE(PEC.SINC_ECOMMERCE, '#39'N'#39')'
        '  END SINC_ECOMMERCE,'
        '  PEC.ID_COMMERCE,'
        
          '  PEC.DISPONIVEL, PEC.PROMOCIONAL, PEC.FRETE_GRATIS, PEC.LANCAME' +
          'NTO, PEC.DESTAQUE, PEC.VARIACAO,'
        '  PEC.TERMOS_ACEITE, PEC.COMPREJUNTO, PEC.VIRTUAL,'
        
          '  PEC.ENV_COMERCIO_ABERTO, COALESCE(PECG.ID_COMERCIO_ABERTO, PEC' +
          '.ID_COMERCIO_ABERTO) ID_COMERCIO_ABERTO,'
        '  MARCA_PROD.DESCRICAO_MARCA,'
        
          '  PIP.LISTA_IMAGENS, PIP.URL_IMAGENS, PIG.LISTA_IMAGENS as LISTA' +
          '_IMAGENS_GRADE,'
        '  PIG.URL_IMAGENS as URL_IMAGENS_GRADE,'
        '  (select first 1 CB.COD_BARRA from COD_BARRA CB'
        '   where CB.GRUPO_PROD = PEC.GRUPO_PROD'
        '   and CB.COD_PROD = PEC.COD_PROD'
        '   and coalesce(CB.COD_GRADE, 0) = 0'
        '   and CB.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '   and CB.COD_BARRA <> (CB.GRUPO_PROD || CB.COD_PROD)) as REFERE' +
          'NCE,'
        '--DADOS GRADE'
        '  CASE WHEN ((SELECT COUNT(*) FROM COD_GRADE_PROD'
        '  WHERE COD_GRADE_PROD.GRUPO_PROD = PEC.GRUPO_PROD'
        '  AND COD_GRADE_PROD.COD_PROD = PEC.COD_PROD'
        '  AND COD_GRADE_PROD.COD_GRADE > 0'
        
          '  AND COD_GRADE_PROD.COD_EMPRESA = PEC.COD_EMPRESA) > 0) then '#39'1' +
          #39' else '#39'0'#39' end COM_GRADE,'
        '  coalesce(PECG.COD_GRADE, 0) COD_GRADE,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC, '#39#39') <> '#39#39', GRADE.DESCRICAO_EC' +
          ', GRADE.DESCRICAO) GRADE1,'
        
          '  iif(coalesce(GRADE.DESCRICAO_EC1, '#39#39') <> '#39#39', GRADE.DESCRICAO_E' +
          'C1, GRADE.DESCRICAO_EC1) GRADE2,'
        '--ESTOQUE FISICO'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PEC.GRUPO_PROD, PEC.COD_PROD, 0, PEC.COD_EMPRESA, 0, '#39#39', 0,' +
          ' 0)), 0) EST_DISP,'
        
          '  coalesce((select trunc(coalesce(ESTOQUE, 0)) from GETESTOQUEDI' +
          'SPONIVEL'
        
          '    (PECG.GRUPO_PROD, PECG.COD_PROD, PECG.COD_GRADE, PECG.COD_EM' +
          'PRESA, 0, '#39#39', 0, 0)), 0) EST_DISP_GRADE,'
        '  coalesce(PR.N_MIN_PROD, 0) EST_MINIMO,'
        '--ESTOQUE MANUAL'
        '  coalesce(PEC.ESTOQUE_EC, 0) MANUAL_EST_DISP,'
        '  coalesce(PECG.ESTOQUE_EC, 0) MANUAL_EST_DISP_GRADE,'
        '  coalesce(PEC.ESTOQUE_MIN_EC, 0) MANUAL_EST_MINIMO,'
        '-- PRECO CONFIG_API'
        '  CONFIG_API.API,'
        '  (select first 1 PMP.VALOR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        
          '        PMP.COD_PROMOCAO = CONFIG_API.COD_TAB_PRECO) API_PRECO_T' +
          'ABELA,'
        '--PRECO PADRAO PRODUTO'
        '  PR.PREC_TAB_PROD as PRECO_TABELA,'
        '--DESCRICAO PROMOCAO COMERCIO ABERTO'
        '  (select first 1 PM.DESCR_PROMOCAO'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D  >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DESCRICAOPROMOCAO,'
        '-- VALOR PROMOCAO COMERCIO ABERTO'
        '  (select first 1 iif((PMP.PORCENTAGEM > 0),'
        
          '                      (PR.PREC_TAB_PROD - (round(PR.PREC_TAB_PRO' +
          'D * PMP.PORCENTAGEM) / 100)),'
        '                       PMP.VALOR_PROMOCAO)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) VALORPROMOCAO,'
        '--DATA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_INI, PM.DATA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAINICIOPROMOCAO,'
        '--DATA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) DATAFIMPROMOCAO,'
        '--HORA INICIAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_INI, PM.HORA_INI)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAINICIOPROMOCAO,'
        '--HORA FINAL PROMOCAO'
        '  (select first 1 coalesce(PMP.HORA_FIM, PM.HORA_FIM)'
        '  from PROMOCAO_PRODUTO PMP'
        
          '    inner join PROMOCAO PM on PM.COD_PROMOCAO = PMP.COD_PROMOCAO' +
          ' and'
        '          PM.COD_EMPRESA = PMP.COD_EMPRESA and'
        '          PM.ATIVO = 1'
        
          '    inner join PROMOCAO_ORDEM_CA PMOCA on PMOCA.COD_PROMOCAO = P' +
          'MP.COD_PROMOCAO and'
        '          PMOCA.COD_EMPRESA = PMP.COD_EMPRESA'
        
          '    left join TIPO_PRECO TP on TP.COD_TPPRECO = PMP.COD_TPPRECO ' +
          'and'
        '          TP.COD_EMPRESA = PMP.COD_EMPRESA'
        '    left join SP_CURRENT_TS(PMP.COD_EMPRESA) CD on 1=1'
        '  where PMP.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PMP.COD_PROD = PR.COD_PROD and'
        '        PMP.COD_EMPRESA = PR.COD_EMPRESA and'
        '        CD.CURRENT_D >= coalesce(PMP.DATA_INI, PM.DATA_INI) and'
        '        CD.CURRENT_D <= coalesce(PMP.DATA_FIM, PM.DATA_FIM)'
        '  order by PMOCA.ORDEM) HORAFIMPROMOCAO,'
        '-- PRECO_A_COMBINAR_CA'
        '  PEC.PRECO_A_COMBINAR_EC,'
        '  PEC.PRECO_A_COMBINAR_CA,'
        '--SEQIDS'
        '  coalesce(PECG.SEQID_CA, PEC.SEQID_CA)  SEQID_CA'
        'from PRODUTOS_EC PEC'
        '  inner join PRODUTOS PR on PEC.GRUPO_PROD = PR.GRUPO_PROD and'
        '        PEC.COD_PROD = PR.COD_PROD and'
        '        PEC.COD_EMPRESA = PR.COD_EMPRESA'
        
          '  left join PRODUTOS_EC_GRADE PECG on PECG.GRUPO_PROD = PEC.GRUP' +
          'O_PROD and'
        '        PECG.COD_PROD = PEC.COD_PROD and'
        '        PECG.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIP on PIP.GRUPO_PROD = PEC.GRUPO_P' +
          'ROD and'
        '        PIP.COD_PROD = PEC.COD_PROD and'
        '        PIP.COD_GRADE = 0 and'
        '        PIP.COD_EMPRESA = PEC.COD_EMPRESA'
        
          '  left join PRODUTOS_IMAGENS PIG on PIG.GRUPO_PROD = PECG.GRUPO_' +
          'PROD and'
        '        PIG.COD_PROD = PECG.COD_PROD and'
        '        PIG.COD_GRADE = PECG.COD_GRADE and'
        '        PIG.COD_EMPRESA = PECG.COD_EMPRESA'
        '  left join GRADE on GRADE.COD_GRADE = PECG.COD_GRADE and'
        '        GRADE.COD_EMPRESA = PECG.COD_EMPRESA and'
        '        GRADE.COD_GRADE > 0'
        
          '  left join CATEGORIA on CATEGORIA.COD_CATEGORIA = PEC.COD_CATEG' +
          'ORIA AND CATEGORIA.COD_EMPRESA = PEC.COD_EMPRESA'
        '  left join MARCA_PROD on MARCA_PROD.COD_MARCA = PR.COD_MARCA'
        
          '  left join CONFIG_API on CONFIG_API.COD_EMPRESA = PEC.COD_EMPRE' +
          'SA'
        'UNION'
        
          'select 1 TIPO, TS.COD_SERVICO GRUPO_PROD, '#39'SERV'#39' COD_PROD, coale' +
          'sce(TS.COD_EMPRESA, EMP.COD_EMPRESA) COD_EMPRESA,'
        
          '       TS.ATIVO, null NUM_FAB_PROD, TS.DESC_SERV_RES DESCR_PROD_' +
          'RES, TS.DESC_SERV_COMPL DESCR_PROD_COMPL,'
        '       null SINC_ECOMMERCE, null ID_COMMERCE,'
        
          '       null DISPONIVEL, null PROMOCIONAL, null FRETE_GRATIS, nul' +
          'l LANCAMENTO, null DESTAQUE, null VARIACAO,'
        '       null TERMOS_ACEITE, null COMPREJUNTO, null VIRTUAL,'
        
          '       TS.ENV_COMERCIO_ABERTO, TS.ID_COMERCIO_ABERTO, null DESCR' +
          'ICAO_MARCA, null LISTA_IMAGENS, null URL_IMAGENS,'
        
          '       null LISTA_IMAGENS_GRADE, null URL_IMAGENS_GRADE, cast(TS' +
          '.COD_SERVICO as varchar(20)) REFERENCE, 0 COM_GRADE,'
        
          '       0 COD_GRADE, null GRADE1, null GRADE2, 100 EST_DISP, 100 ' +
          'EST_DISP_GRADE, 100 EST_MINIMO, 100 MANUAL_EST_DISP,'
        
          '       100 MANUAL_EST_DISP_GRADE, 100 MANUAL_EST_MINIMO, '#39'COMERC' +
          'IOABERTO'#39' API, TS.VALOR_SERVICO API_PRECO_TABELA,'
        
          '       TS.VALOR_SERVICO PRECO_TABELA, null DESCRICAOPROMOCAO, nu' +
          'll VALORPROMOCAO, null DATAINICIOPROMOCAO,'
        
          '       null DATAFIMPROMOCAO, null HORAINICIOPROMOCAO, null HORAF' +
          'IMPROMOCAO,'
        
          '       null PRECO_A_COMBINAR_EC, TS.PRECO_A_COMBINAR_CA, TS.SEQI' +
          'D_CA'
        'from EMPRESA EMP'
        
          '  left join TIPO_SERVICO TS on coalesce(TS.COD_EMPRESA, EMP.COD_' +
          'EMPRESA) = EMP.COD_EMPRESA'
        'where TS.SEQID_CA > 0;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS5('
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    CPFCGC_CLIENTE,'
        '    TP_RECEBIMENTO,'
        '    TP_RECEBIMENTO2,'
        '    ORDEM,'
        '    COD_TIPO,'
        '    TIPO,'
        '    COD_CRED,'
        '    NUM_DOC,'
        '    NUM_DOC2,'
        '    DATA_DOC,'
        '    DATA_CONF,'
        '    VALOR_A_RECEBER,'
        '    VALOR_A_RECEBER_CORR,'
        '    OBS_CXL,'
        '    LOTEREC,'
        '    DIA_CXL,'
        '    OP_CXL,'
        '    NOME_OP_CXL,'
        '    COD_US,'
        '    DATA_MOV,'
        '    HISTORICO,'
        '    VALOR_PAGO,'
        '    DATA_VENC,'
        '    TERCEIROS,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    NUM_RECIBO,'
        '    VALOR_RECIBO,'
        '    NCUPOM,'
        '    NUM_NF,'
        '    PARCELA,'
        '    SEQID,'
        '    SEQID2,'
        '    VENDA,'
        '    TIPV,'
        '    TIPO_DOC,'
        '    ID_COMMERCE,'
        '    QTDE_PREST)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DETALHADOS DO CAIXA AUXILIAR POR O' +
          'PERADOR E DATA DO CAIXA'
        '-- RELATORIO "RECEBIMENTOS CAIXA AUXILIAR"'
        '    '
        '    --- REQ, OS'
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        
          '    rq.cod_empresa, coalesce(rq.cod_cliente, 0) cod_cliente, cl.' +
          'nome_cliente, cl.cpfcgc,'
        
          '    case when (rq.id_commerce > 0) then '#39'ECOMMERCE'#39' else case wh' +
          'en (rq.tipo = '#39'REQ'#39') then '#39'BALCAO'#39' else '#39'SERVICOS'#39' end end tp_re' +
          'cebimento,'
        '    '#39'DIRETO'#39' tp_recebimento2,'
        
          '    case when (rq.id_commerce > 0) then 7 else case when (rq.tip' +
          'o = '#39'REQ'#39') then 2 else 3 end end ordem, 0 cod_tipo, rq.tipo, 0 c' +
          'od_cred,'
        
          '    coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndoc, coalesce(' +
          'rq.nped, 0)) as Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, coalesce(rq.valor_total, 0) as valor_total, rq.obs_cx' +
          'l_rq, rq.nped as loterec,'
        
          '    rq.dia_cxl, coalesce(rq.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end as num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    coalesce(rq.id_commerce, 0) id_commerce,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    inner join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = rq.op_cxl a' +
          'nd col.cod_empresa = rq.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = rq.nped and f' +
          'p.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.re' +
          'cibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        
          '    rq.cod_empresa, coalesce(rq.cod_cliente, 0) cod_cliente, cl.' +
          'nome_cliente, cl.cpfcgc,'
        
          '    case when (rq.id_commerce > 0) then '#39'ECOMMERCE'#39' else case wh' +
          'en (rq.tipo = '#39'REQ'#39') then '#39'BALCAO'#39' else '#39'SERVICOS'#39' end end tp_re' +
          'cebimento,'
        '    '#39'RECIBO'#39' tp_recebimento2,'
        
          '    case when (rq.id_commerce > 0) then 7 else case when (rq.tip' +
          'o = '#39'REQ'#39') then 2 else 3 end end ordem, 0 cod_tipo, rq.tipo, 0 c' +
          'od_cred,'
        
          '    coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndoc, coalesce(' +
          'rq.nped, 0)) as Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, coalesce(rq.valor_total, 0) as valor_total, rq.obs_cx' +
          'l_rq, rq.nped as loterec,'
        
          '    rq.dia_cxl, coalesce(rq.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', rq.cod_vendedor,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0) valordoc' +
          ', fp.data_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        0'
        '    else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ') is null then'
        '        '#39'SEM FORMA'#39
        '    else (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc' +
          ' asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ', coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    coalesce(rq.id_commerce, 0) id_commerce,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    inner join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = rq.op_cxl a' +
          'nd col.cod_empresa = rq.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = rq.nped and ' +
          'fp.tpdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not' +
          ' fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rq.cod_empresa end) cod_empresa,'
        
          '    rq.cod_empresa, coalesce(rq.cod_cliente, 0) cod_cliente, cl.' +
          'nome_cliente, cl.cpfcgc,'
        
          '    case when (rq.id_commerce > 0) then '#39'ECOMMERCE'#39' else case wh' +
          'en (rq.tipo = '#39'REQ'#39') then '#39'BALCAO'#39' else '#39'SERVICOS'#39' end end tp_re' +
          'cebimento,'
        '    '#39'TROCO'#39' tp_recebimento2,'
        
          '    case when (rq.id_commerce > 0) then 7 else case when (rq.tip' +
          'o = '#39'REQ'#39') then 2 else 3 end end ordem, 0 cod_tipo, rq.tipo, 0 c' +
          'od_cred,'
        
          '    coalesce(rq.nped, 0) as Num_doc, coalesce(fp.ndoc, coalesce(' +
          'rq.nped, 0)) as Num_doc2, rq.data_ped as data_doc,'
        
          '    rq.data_fech as data_Conf, coalesce(rq.valor_total, 0) as va' +
          'lor_total, coalesce(rq.valor_total, 0) as valor_total, rq.obs_cx' +
          'l_rq, rq.nped as loterec,'
        
          '    rq.dia_cxl, coalesce(rq.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', rq.cod_vendedor,'
        '    fp.data_mov, fp.historico,'
        
          '    coalesce(fp.valordoc, 0) valordoc, fp.data_venc, fp.terceiro' +
          's,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        
          '    coalesce(rq.num_nfce, 0) ncupom, coalesce(rq.num_nf, 0) num_' +
          'nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)' +
          ',  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    case when(rq.tipo = '#39'REQ'#39') then tp.sigla else tp.tipo_os end' +
          ' tipv, rq.tipo as tipo_doc,'
        '    coalesce(rq.id_commerce, 0) id_commerce,'
        '    1 qtde_prest'
        ''
        '    from pedvenda rq'
        '    inner join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = rq.op_cxl a' +
          'nd col.cod_empresa = rq.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = rq.tipo and (tp.sigla ' +
          '= rq.tipv or (tp.tipo_os = rq.tipo_os))'
        
          '    left join clientes cl on cl.cod_cliente = rq.cod_cliente and' +
          ' cl.cod_empresa = rq.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rq.nped and ' +
          'fp.rec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and' +
          ' fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.t' +
          'ipo in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        '    union'
        '    '
        '    --- CF'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        
          '    mt.cod_empresa, coalesce(mt.clientes_v, 0) clientes_v, cl.no' +
          'me_cliente, cl.cpfcgc,'
        '    '#39'VEICULOS'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebimento2,'
        '    1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo, 0 cod_cred,'
        
          '    coalesce(mt.n_comando, 0) as Num_doc, coalesce(fp.ndoc, coal' +
          'esce(mt.n_comando, 0)) as Num_doc2, mt.data_ven as Data_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total, coalesce(mt.valor_a_rec, 0) as valor_total, '#39' '#39' as ob' +
          's_cxl_rq, mt.n_comando as loterec,'
        
          '    mt.dia_cxl, coalesce(mt.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando), coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 0 id_commerce, 1 qtde_prest f' +
          'rom com_fat mt'
        '    inner join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = mt.op_cxl a' +
          'nd col.cod_empresa = mt.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = mt.n_comando ' +
          'and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and fp' +
          '.recibo is null'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        
          '    mt.cod_empresa, coalesce(mt.clientes_v, 0) clientes_v, cl.no' +
          'me_cliente, cl.cpfcgc,'
        '    '#39'VEICULOS'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebimento2,'
        '    1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo, 0 cod_cred,'
        
          '    coalesce(mt.n_comando, 0) as Num_doc, coalesce(fp.ndoc, coal' +
          'esce(mt.n_comando, 0)) as Num_doc2, mt.data_ven as Data_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total,  coalesce(mt.valor_a_rec, 0) as valor_total, '#39' '#39' as o' +
          'bs_cxl_rq, mt.n_comando as loterec,'
        
          '    mt.dia_cxl, coalesce(mt.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        0'
        '    else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordo' +
          'c asc)'
        '    end as codigo_ctrl,'
        '    case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c) is null then'
        '        '#39'SEM FORMA'#39
        '    else (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '        inner join formpagamento rc on rc.cod_controle = ctrl.co' +
          'digo_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '        where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa' +
          ' = fp.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordo' +
          'c asc)'
        '    end as nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo,'
        
          '    coalesce((select sum(rc.valor_orig) from recibos rc where rc' +
          '.nrecibo = fp.rec_numvend and rc.cod_empresa = fp.cod_empresa), ' +
          '0) as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 0 id_commerce, 1 qtde_prest f' +
          'rom com_fat mt'
        '    inner join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = mt.op_cxl a' +
          'nd col.cod_empresa = mt.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.nrequisicao = mt.n_comando' +
          ' and fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (' +
          'not fp.recibo is null)'
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    union'
        '    '
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else mt.cod_empresa end) cod_empresa,'
        
          '    mt.cod_empresa, coalesce(mt.clientes_v, 0) clientes_v, cl.no' +
          'me_cliente, cl.cpfcgc,'
        '    '#39'VEICULOS'#39' tp_recebimento, '#39'TROCO'#39' tp_recebimento2,'
        '    1 ordem, 0 cod_tipo, '#39'MOT'#39' as tipo, 0 cod_cred,'
        
          '    coalesce(mt.n_comando, 0) as Num_doc, coalesce(fp.ndoc, coal' +
          'esce(mt.n_comando, 0)) as Num_doc2, mt.data_ven as Data_Doc,'
        
          '    mt.data_fech as Data_Conf, coalesce(mt.valor_a_rec, 0) as va' +
          'lor_total,  coalesce(mt.valor_a_rec, 0) as valor_total, '#39' '#39' as o' +
          'bs_cxl_rq, mt.n_comando as loterec,'
        
          '    mt.dia_cxl, coalesce(mt.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', mt.covend_v,'
        
          '    fp.data_mov, fp.historico, coalesce(fp.valordoc, 0), fp.data' +
          '_venc, fp.terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        
          '    case when (rec.num_rec_dep <> '#39#39') then rec.num_rec_dep else ' +
          'coalesce(fp.rec_numvend,0) end num_recibo, 0 as valor_recibo,'
        '    0 ncupom, coalesce(mt.num_nota_v, 0) num_nf,'
        
          '    case when (fp.nrequisicao > 0) then coalesce(fp.nparcela, 0)' +
          ' else 0 end nparcela,'
        
          '    coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.' +
          'n_comando),  coalesce(tp.venda, '#39'S'#39') venda,'
        
          '    tp.tipo_os, '#39'MOT'#39' as tipo_doc, 0 id_commerce, 1 qtde_prest f' +
          'rom com_fat mt'
        '    inner join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = mt.op_cxl a' +
          'nd col.cod_empresa = mt.cod_empresa'
        
          '    left join tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os =' +
          ' mt.tipo_v'
        
          '    left join clientes cl on cl.cod_cliente = mt.clientes_v and ' +
          'cl.cod_empresa = mt.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = mt.n_comando' +
          ' and fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa ' +
          'and fp.tpdocs = '#39'TRC'#39
        
          '    left join recibos rec on rec.nrecibo = fp.rec_numvend and re' +
          'c.cod_empresa = fp.cod_empresa'
        
          '    left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl' +
          ' and fp.cod_empresa = ctr.codigo_emp'
        
          '    where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.n' +
          'atureza = '#39'S'#39
        ''
        '    union'
        ''
        '    --RECIBO'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rec.cod_empresa end) cod_empresa,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rec' +
          '.cod_emp_mult, rec.cod_empresa) else rec.cod_empresa end) cod_em' +
          'p_mult,'
        
          '    coalesce(rec.cod_devedor, 0) cod_cliente, rec.nome_dev nome_' +
          'cliente, cl.cpfcgc,'
        
          '    '#39'RECIBO ANTECIPADO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebimento2' +
          ', 4 ordem,'
        '    0 cod_tipo, '#39'RECIBO'#39' tipo, 0 cod_cred,'
        
          '    coalesce(rec.nrecibo, 0) Num_doc, coalesce(fp.ndoc, coalesce' +
          '(rec.nrecibo, 0)) as Num_doc2, rec.data_rec as Data_Doc,'
        '    rec.data_rec as Data_Conf,'
        
          '    coalesce(rec.valor_orig, 0) as valor_total, coalesce(rec.val' +
          'or_orig, 0) as valor_total,'
        
          '    rec.obs_cxl_rq as obs_cxl_rq, coalesce(rec.nrecibo, 0) as lo' +
          'terec,'
        
          '    rec.dia_cxl, coalesce(rec.op_cxl, 0) op_cxl, col.nome_vended' +
          'or, rec.cod_us, fp.data_mov, fp.historico,'
        
          '    case when(fp.valordoc < 0) then (coalesce(fp.valordoc, 0) * ' +
          '-1) else coalesce(fp.valordoc, 0) end valor_pago,'
        '    fp.data_mov, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo, 0 as valor_recibo,'
        '    0 ncupom, 0 num_nf,'
        
          '    0 as nparcela, rec.nrecibo, coalesce(fp.seqform, rec.nrecibo' +
          '),'
        
          '    '#39'N'#39' venda, '#39#39' tipv, '#39'REC'#39' as tipo_doc, 0 id_commerce, 1 qtde' +
          '_prest'
        '    from recibos rec'
        '    inner join empresa emp on rec.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = rec.op_cxl ' +
          'and col.cod_empresa = rec.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = rec.cod_devedor an' +
          'd cl.cod_empresa = rec.cod_empresa'
        
          '    left join formpagamento fp on fp.nrequisicao = rec.nrecibo a' +
          'nd fp.cod_empresa = rec.cod_empresa and fp.tpdocs = '#39'REC'#39' and fp' +
          '.recibo is null'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = fp.cod_controle' +
          ' and ctr.codigo_emp = fp.cod_empresa'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else rec.cod_empresa end) cod_empresa,'
        
          '    (case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rec' +
          '.cod_emp_mult, rec.cod_empresa) else rec.cod_empresa end) cod_em' +
          'p_mult,'
        
          '    coalesce(rec.cod_devedor, 0) cod_cliente, rec.nome_dev nome_' +
          'cliente, cl.cpfcgc,'
        
          '    '#39'RECIBO ANTECIPADO'#39' tp_recebimento, '#39'TROCO'#39' tp_recebimento2,' +
          ' 4 ordem,'
        '    0 cod_tipo, '#39'RECIBO'#39' tipo, 0 cod_cred,'
        
          '    coalesce(rec.nrecibo, 0) Num_doc, coalesce(fp.ndoc, coalesce' +
          '(rec.nrecibo, 0)) as Num_doc2, rec.data_rec as Data_Doc,'
        '    rec.data_rec as Data_Conf,'
        
          '    coalesce(rec.valor_orig, 0) as valor_total, coalesce(rec.val' +
          'or_orig, 0) as valor_total,'
        
          '    rec.obs_cxl_rq as obs_cxl_rq, coalesce(rec.nrecibo, 0) as lo' +
          'terec,'
        
          '    rec.dia_cxl, coalesce(rec.op_cxl, 0) op_cxl, col.nome_vended' +
          'or, rec.cod_us, fp.data_mov, fp.historico,'
        
          '    coalesce(fp.valordoc, 0) valor_pago, fp.data_mov, '#39' '#39' tercei' +
          'ros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo, 0 as valor_recibo,'
        '    0 ncupom, 0 num_nf,'
        
          '    0 as nparcela, rec.nrecibo, coalesce(fp.seqform, rec.nrecibo' +
          '),'
        
          '    '#39'N'#39' venda, '#39#39' tipv, '#39'REC'#39' as tipo_doc, 0 id_commerce, 1 qtde' +
          '_prest'
        '    from recibos rec'
        '    inner join empresa emp on rec.cod_empresa = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = rec.op_cxl ' +
          'and col.cod_empresa = rec.cod_empresa'
        
          '    left join clientes cl on cl.cod_cliente = rec.cod_devedor an' +
          'd cl.cod_empresa = rec.cod_empresa'
        
          '    inner join formpagamento fp on fp.rec_numvend = rec.nrecibo ' +
          'and fp.cod_empresa = rec.cod_empresa and fp.rec_tipvend = '#39'REC'#39' ' +
          'and fp.tpdocs = '#39'TRC'#39
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = fp.cod_controle' +
          ' and ctr.codigo_emp = fp.cod_empresa'
        '    '
        '    union'
        ''
        '    -- PRESTACOES'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc,'
        '    '#39'PRESTACOES'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebimento2,'
        '    5 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then pr.codigo_ctrl els' +
          'e ctr1.codigo_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
