        '|/BLOCO|'
        ''
        'ALTER TABLE PEDVENDA ADD PERC_COMISSAO_VEND T_VL_TODOS;'
        'ALTER TABLE PEDVENDA ADD PERC_COMISSAO_VEND1 T_VL_TODOS;'
        'ALTER TABLE PEDVENDA ADD PERC_COMISSAO_VEND3 T_VL_TODOS;'
        ''
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_VEND T_VL_TODOS;'
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_VEND1 T_VL_TODOS;'
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_VEND3 T_VL_TODOS;'
        'ALTER TABLE PEDVENDA_PROD ADD PERC_COMISSAO_CONDPAG T_VL_TODOS;'
        ''
        
          'CREATE INDEX IDX_LANCAMENTOS_CONTR_LANC ON LANCAMENTOS (COD_CONT' +
          'RAPARTIDA, CODIGO_EMP);'
        
          'CREATE INDEX IDX_LANCAMENTOS_CONTR_CTP ON LANCAMENTOS (COD_CONTR' +
          'APARTIDA_CTP, CODIGO_EMP);'
        ''
        
          'CREATE INDEX IDX_CONTROLE_CREDITOS_CONTR_LNC ON CONTROLE_CREDITO' +
          'S (COD_CONTRAPARTIDA, CODIGO_EMP);'
        
          'CREATE INDEX IDX_CONTROLE_CREDITOS_CONTR_CTP ON CONTROLE_CREDITO' +
          'S (COD_CONTRAPARTIDA_CTP, CODIGO_EMP);'
