        '        into :vtemp_ctr_mes, :vtemp_qtde_mes;'
        '    begin'
        '      vctr_mes_prod = coalesce(vtemp_ctr_mes, 1);'
        '      vqtde_mes_prod     = coalesce(vtemp_qtde_mes, 0);'
        '    end'
        ''
        '    vtemp_sql ='
        '      '#39' select first 1'
        
          '               coalesce(ctr.contratos_cada_mes, 1) contratos_cad' +
          'a_mes,'
        
          '               coalesce((select case when (max(pd.data_fech) is ' +
          'null) then'
        
          '                                       datediff(month, date '#39#39'01' +
          '.01.2000'#39#39', cast('#39#39#39' || :pdata_base_venda || '#39#39#39' as timestamp))'
        '                                     else'
        
          '                                       datediff(month, max(pd.da' +
          'ta_fech), cast('#39#39#39' || :pdata_base_venda || '#39#39#39' as timestamp))'
        '                                end'
        '                         from pedvenda pd'
        
          '                         inner join pedvenda_serv pds on pds.npe' +
          'd = pd.nped and pds.tipo = pd.tipo and pds.cod_empresa = pd.cod_' +
          'empresa'
        
          '                         where pds.cod_contrato = ctr.cod_contra' +
          'to'
        '                         and pds.tipo = '#39#39'OS'#39#39
        '                         and pds.cod_empresa = ctr.cod_empresa'
        '                         and pd.status_ped = '#39#39'FECHADA'#39#39
        
          '                         and (pds.status <> '#39#39'CANCELADO'#39#39' or pds' +
          '.status is null)), 0) qtde_mes_ult_ger'
        '        from clientes cl'
        
          '        inner join clientes_com_contrato ctr on ctr.cod_cliente ' +
          '= cl.cod_cliente and ctr.cod_empresa = cl.cod_empresa'
        
          '        inner join controles ctrl on ctrl.codigo_ctrl = ctr.cod_' +
          'controle and ctrl.codigo_emp = ctr.cod_empresa'
        
          '        left join colaborador col on col.cod_vendedor = ctr.cod_' +
          'vendedor and col.cod_empresa = ctr.cod_empresa'
        '        where ctr.cod_cliente = '#39' || :pcod_cliente || '#39
        '        and ctr.cod_empresa = '#39' || :pcod_empresa || '#39
        
          '        and coalesce(ctr.dia_vencimento, 0) = '#39' || :pdia_vencime' +
          'nto || '#39
        
          '        and coalesce(ctr.dias_apos_venc, 0) = '#39' || :pdias_apos_v' +
          'enc || '#39
        '        and ctr.cod_vendedor = '#39' || :pcod_vendedor || '#39
        '        and ctr.cod_controle = '#39' || :pcod_controle || '#39
        '        and ctr.tipo_os = '#39#39#39' || :tipo_os || '#39#39#39
        
          '        and coalesce(ctr.contratos_cada_mes, 1) = '#39' || :pgerar_c' +
          'ontrato_cada_mes || '#39
        '        and ctr.status = '#39#39'Ativo'#39#39
        
          '        and ((ctr.data_inicial_vigencia is null) or (ctr.data_in' +
          'icial_vigencia <= '#39#39#39' || :pdata_base_venda || '#39#39#39')) '#39';'
        ''
        '    if (coalesce(pdescons_regra_ctrl, 0) = 0) then'
        '    begin'
        '      vtemp_sql = vtemp_sql ||'
        
          '        '#39' and (not ctr.DATA_INICIAL_BOLETO is null) and (ctr.DAT' +
          'A_INICIAL_BOLETO <= '#39#39#39' || :pdata_base_venda || '#39#39#39') '#39';'
