        '|BLOCO|'
        'create or alter procedure SP_CONTRATOS ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    COD_SERVICO integer,'
        '    DESC_SERVICO varchar(75),'
        '    VALOR_CONTRATO double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select cod_servico, desc_servico,'
        '    sum(coalesce(valor_contrato, 0)) valor_contrato from ('
        '      select cc.cod_servico,'
        '        case when (cc.cod_servico > 0) then'
        '               tp.desc_servico'
        '             else'
        '               cc.descr_contrato'
        '        end desc_servico,'
        '        coalesce(cc.valor_contrato, 0) valor_contrato'
        '        from clientes_com_contrato cc'
        
          '        left join tipo_servico tp on tp.cod_servico = cc.cod_ser' +
          'vico'
        '        where cc.cod_contrato = :pcod_contrato'
        '        and cc.cod_empresa = :pcod_empresa'
        '        and cc.cod_servico > 0'
        '        union all'
        '        select cc.cod_servico,'
        '        cc.descr_contrato as desc_servico,'
        
          '        sum(coalesce(cs.qtde, 0) * coalesce(cs.valor_un, 0)) val' +
          'or_contrato'
        '        from clientes_com_contrato cc'
        '        inner join clientes_com_contrato_serv cs on'
        '            cs.cod_contrato = cc.cod_contrato'
        '            and cs.cod_empresa = cc.cod_empresa'
        
          '        left join tipo_servico tp on tp.cod_servico = cs.cod_ser' +
          'vico'
        '        where cc.cod_contrato = :pcod_contrato'
        '        and cc.cod_empresa = :pcod_empresa'
        '        and cc.cod_servico = 0'
        '        group by 1, 2'
        '        union all'
        '        select cc.cod_servico,'
        '        cc.descr_contrato as desc_servico,'
        
          '        sum(coalesce(cp.qtde, 0) * coalesce(cp.valor_un, 0)) val' +
          'or_contrato'
        '        from clientes_com_contrato cc'
        '        inner join clientes_com_contrato_prod cp on'
        '          cp.cod_contrato = cc.cod_contrato'
        '          and cp.cod_empresa = cc.cod_empresa'
        '        where cp.cod_contrato = :pcod_contrato'
        '        and cp.cod_empresa = :pcod_empresa'
        '        and cc.cod_servico = 0'
        '        group by 1, 2'
        '      )'
        '      group by 1, 2'
        '        into :cod_servico, :desc_servico, :valor_contrato;'
        '          suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_CONTRATOS_PROD ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    COD_SERVICO integer,'
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6),'
        '    COD_GRADE integer,'
        '    DESCR_PROD varchar(75),'
        '    VALOR_CONTRATO double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  for select null cod_servico, pr.grupo_prod, pr.cod_prod, cp.co' +
          'd_grade,'
        
          '      case when (cp.cod_grade > 0) and (trim(coalesce(gr.descric' +
          'ao, '#39#39')) <> '#39#39') then'
        
          '             trim(coalesce(pr.descr_prod, '#39#39')) || '#39' '#39' || trim(co' +
          'alesce(gr.descricao, '#39#39'))'
        '           else'
        '             trim(pr.descr_prod)'
        '      end descr_prod,'
        
          '      sum(coalesce(cp.qtde, 0) * coalesce(cp.valor_un, 0)) valor' +
          '_contrato'
        '      from clientes_com_contrato cc'
        '      inner join clientes_com_contrato_prod cp on'
        '        cc.cod_contrato = cp.cod_contrato'
        '        and cc.cod_empresa = cp.cod_empresa'
        '      inner join produtos pr on'
        '        pr.grupo_prod = cp.grupo_prod'
        '        and pr.cod_prod = cp.cod_prod'
        '        and pr.cod_empresa = cp.cod_empresa'
        '      left join grade gr on'
        '        gr.cod_grade = cp.cod_grade'
        '        and gr.cod_empresa = cp.cod_empresa'
        '      where cc.cod_contrato = :pcod_contrato'
        '      and cc.cod_empresa = :pcod_empresa'
        '      and cc.cod_servico = 0'
        '      group by 1, 2, 3, 4, 5'
        
          '        into :cod_servico, :grupo_prod, :cod_prod, :cod_grade, :' +
          'descr_prod, :valor_contrato do'
        '          suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_CONTRATOS_SERV ('
        '    PCOD_CONTRATO integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6),'
        '    COD_GRADE integer,'
        '    COD_SERVICO integer,'
        '    DESC_SERVICO varchar(75),'
        '    VALOR_CONTRATO double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  for select null grupo_prod, null cod_prod, null cod_grade, cc.' +
          'cod_servico,'
        '      case when (cc.cod_servico > 0) then'
        '             tp.desc_servico'
        '           else'
        '             cc.descr_contrato'
        '      end desc_servico,'
        '      coalesce(cc.valor_contrato, 0) valor_contrato'
        '      from clientes_com_contrato cc'
        '      left join tipo_servico tp on'
        '        tp.cod_servico = cc.cod_servico'
        '      where cc.cod_contrato = :pcod_contrato'
        '      and cc.cod_empresa = :pcod_empresa'
        '      and cc.cod_servico > 0'
        '      union all'
        
          '      select null grupo_prod, null cod_prod, null cod_grade, cs.' +
          'cod_servico,'
        '      tp.desc_servico,'
        
          '      sum(coalesce(cs.qtde, 0) * coalesce(cs.valor_un, 0)) valor' +
          '_contrato'
        '      from clientes_com_contrato cc'
        '      inner join clientes_com_contrato_serv cs on'
        '        cc.cod_contrato = cs.cod_contrato'
        '        and cc.cod_empresa = cs.cod_empresa'
        '      left join tipo_servico tp on'
        '        tp.cod_servico = cs.cod_servico'
        '      where cc.cod_contrato = :pcod_contrato'
        '      and cc.cod_empresa = :pcod_empresa'
        '      and cc.cod_servico = 0'
        '      group by 1, 2, 3, 4, 5'
        
          '        into :grupo_prod, :cod_prod, :cod_grade, :cod_servico, :' +
          'desc_servico, :valor_contrato do'
        '          suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable VTEMP double precision;'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        
          '  for select distinct coalesce(pp.id_kit, 0) from pedvenda_prod ' +
          'pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        
          '  for select sum(coalesce((case when (trim(coalesce(pp.unidade_c' +
          'onv, '#39#39')) = '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end), 0)) from pedvenda_prod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '      and coalesce(pp.codigo_kit, 0) <= 0'
        '      union'
        
          '      select sum(coalesce(ppt.qtde, 0)) from pedvenda_prod_terc ' +
          'ppt'
        '      where ppt.nped = :nped'
        '      and ppt.tipo = :tipo'
        '      and ppt.cod_empresa = :cod_empresa'
        '          into :vtemp do'
        '  begin'
        '    qtde_prod = qtde_prod + vtemp;'
        '  end'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES ADD IDCONTATO_MARK2 VARCHAR(36);'
        'ALTER TABLE END_PCLIENTES ADD IDCONTATO_MARK2 VARCHAR(36);'
        ''
