          'delete from config_colunas where componente in ('#39'cdsItemProdReqN' +
          '_'#39', '#39'cdsItemProdOsP_'#39', '#39'cdsItemProdOsS_'#39', '#39'cdsItemProdOsST_'#39', '#39'c' +
          'dsItemProdOsPT_'#39', '#39'cdsItemProdReqR_'#39');'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_PEDVENDA_PROD_PERM_DESC FOR PEDVENDA_' +
          'PROD'
        'ACTIVE BEFORE INSERT POSITION 0'
        'AS'
        '  declare variable vpermitir_desconto char(1);'
        'begin'
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    if (new.permitir_desconto is null) then'
        '    begin'
        
          '      select coalesce(produtos.permitir_desconto, '#39'S'#39') from prod' +
          'utos'
        '      where produtos.grupo_prod = new.grupo_prod'
        '      and produtos.cod_prod = new.cod_prod'
        '      and produtos.cod_empresa = new.cod_empresa'
        '        into :vpermitir_desconto;'
        ''
        '      if (coalesce(vpermitir_desconto, '#39'S'#39') <> '#39#39') then'
        '      new.permitir_desconto = coalesce(vpermitir_desconto, '#39'S'#39');'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
