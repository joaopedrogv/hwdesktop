          'A_INICIAL_BOLETO <= '#39#39#39' || :pdata_base_venda || '#39#39#39') '#39';'
        '    end'
        ''
        '    vtemp_sql = vtemp_sql ||'
        '      '#39' order by 1, 2 '#39';'
        ''
        '    execute statement'
