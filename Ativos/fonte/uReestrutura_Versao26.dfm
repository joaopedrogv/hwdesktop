          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND285'#39', :COD_EMPRESA, '#39'PE' +
          'RM ALT VALOR DOS PRODUTOS COM PRECO DIFERENCIADO'#39', 11, '#39'FRMCADPE' +
          'DVENDA'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
