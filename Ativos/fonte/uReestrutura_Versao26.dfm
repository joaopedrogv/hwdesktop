        'create or alter procedure RETORNA_PAG_CR ('
        '    PLOTE integer,'
        '    PDATA_LOTE timestamp,'
        '    PCOD_EMPRESA integer,'
        '    PVER_FORMAS integer,'
        '    PFORM_PAG varchar(200))'
        'returns ('
        '    ENCONTROU integer,'
        '    FORM_PAG varchar(200),'
        '    FORM_PAG2 varchar(200))'
        'as'
        'declare variable VTEMP varchar(200);'
        'declare variable VTEMP2 varchar(200);'
        'declare variable VCONTROLE varchar(35);'
        'declare variable VVALOR double precision;'
        'begin'
        '  /* Procedure Text */'
        '  encontrou = 0;'
        '  form_pag = '#39#39';'
        '  form_pag2 = '#39#39';'
        ''
        '  if (coalesce(pver_formas, 0) = 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (coalesce(plote, 0) <= 0) then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  if (trim(coalesce(pform_pag, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select distinct det.nome_ctrl, sum(coalesce(det.valor, 0' +
          ')) valor from det_recebimentos_cc det'
        
          '        left join empresa emp on emp.cod_empresa = det.cod_empre' +
          'sa'
        
          '        where iif(emp.financeiro_unificado = '#39'S'#39', emp.codigo_uni' +
          'ficadora, det.cod_empresa) = :pcod_empresa'
        '        and det.lote = :plote'
        
          '        and det.data_lote = iif(emp.financeiro_unificado = '#39'S'#39', ' +
          ':pdata_lote, det.data_lote)'
        '        group by 1'
        '        order by 1'
        '       into :vcontrole, :vvalor do'
        '    begin'
        '      encontrou = 1;'
        ''
        '      vtemp = trim(coalesce(vtemp, '#39#39')) ||'
        '        iif (trim(coalesce(vtemp, '#39#39')) = '#39#39', '#39#39', '#39' | '#39') ||'
        '            trim(coalesce(vcontrole, '#39#39'));'
