        'create or alter procedure UTIL_SPLIT_BLOB_TO_ROW ('
        '    BLOBTEXT varchar(1000))'
        'returns ('
        '    MNUMBER integer,'
        '    RETSTRING varchar(1000))'
        'as'
        'declare variable LSTRING varchar(1000);'
        'declare variable POS1 integer;'
        'declare variable POS2 integer;'
        'declare variable INTLEN integer;'
        'BEGIN'
        '  lstring = SUBSTRING( BLOBTEXT FROM 1 FOR 1000);'
        ''
        '  pos1 = 1;'
        '  intlen = CHAR_LENGTH(lstring);'
        '  MNUMBER = 0;'
        ''
        '  while (pos1 < intlen) do'
        '  BEGIN'
        '    MNUMBER = MNUMBER + 1;'
        
          '    pos2 = POSITION (ASCII_CHAR(13) IN SUBSTRING(lstring FROM po' +
          's1));'
        ' '
        '    IF (pos2 = 0) THEN'
        '    BEGIN'
        '      pos2 = intlen;'
        '    END'
        ' '
        '    retstring = SUBSTRING (lstring FROM pos1 FOR (pos2 - 1));'
        '    pos1 = pos2 + pos1;'
        ' '
        '    suspend;'
        '  END'
        'END;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure P_SPLIT ('
        '    ITEXTO varchar(4000),'
        '    ISEPARADOR char(1))'
        'returns ('
        '    OSPLIT varchar(20))'
        'as'
        'declare variable VTEXTO varchar(4000);'
        'declare variable VPOSICAO integer;'
        'declare variable VPOSICAO_INICIAL integer;'
        'declare variable VSPLIT varchar(4000);'
        'BEGIN'
        '    vtexto = itexto;'
        '    vposicao_inicial = 1;'
        '    vposicao = 1;'
        '    '
        '    IF (iseparador IS NULL OR itexto IS NULL) THEN'
        '    BEGIN'
        '        -- Sair da funcao sem executar'
        '    END'
        '    ELSE'
        '    BEGIN'
        '        WHILE (CHAR_LENGTH(vtexto) > 0) DO'
        '        BEGIN'
        
          '            vposicao = POSITION (:iseparador, vtexto, vposicao_i' +
          'nicial);'
        '            IF (vposicao <= 0) THEN'
        '            BEGIN'
        
          '                vsplit = SUBSTRING (:vtexto FROM :vposicao_inici' +
          'al FOR'
        
          '                        CHAR_LENGTH (:vtexto) - vposicao_inicial' +
          ' + 1);'
        
          '                IF (NOT :vsplit IS NULL AND NOT :vsplit = '#39#39') TH' +
          'EN'
        '                BEGIN'
        '                    osplit = :vsplit;   '
        '                    SUSPEND;'
        '                END'
        '                BREAK;'
        '            END'
        '            vsplit = SUBSTRING (:vtexto FROM :vposicao_inicial'
        '                    FOR :vposicao - vposicao_inicial);'
        '            IF (NOT :vsplit IS NULL AND NOT :vsplit = '#39#39') THEN'
        '            BEGIN'
        '                osplit = :vsplit;   '
        '            END'
        '            vsplit = NULL;'
        '            vposicao_inicial = :vposicao + 1;'
        '            SUSPEND;'
        '        END'
        '    END'
        'END;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure EXISTE_LOCACAO ('
        '    PNPED integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT char(1))'
        'as'
        'declare variable VVALUE1_B blob sub_type 1 segment size 4096;'
        'declare variable VNLINHA integer;'
        'declare variable VLINHA varchar(100);'
        'declare variable VEXISTE integer;'
        'declare variable VCONF_SERVICO integer;'
        'declare variable VEXIBIR_SERVICO integer;'
        'declare variable VORIGEM_SERVICO varchar(1000);'
        'declare variable VEXIBSERV varchar(10);'
        'declare variable VORIGSERV varchar(1000);'
        'declare variable VEXIBTODOS varchar(1000);'
        'declare variable VTEMP varchar(1000);'
        'declare variable VSTIPO char(10);'
        'begin'
        '  /* Procedure Text */'
        '  select config_sistema.value1_b from config_sistema'
        
          '  where config_sistema.chave = '#39'ped_vnd_impressao_recibo_locacao' +
          #39
        '  and config_sistema.cod_empresa = :pcod_empresa'
        '    into :vvalue1_b;'
        ''
        '  vconf_servico   = 0;'
        '  vexibir_servico = 0;'
        ''
        '  result          = '#39'N'#39';'
        ''
        '  vexibServ       = '#39'N'#39';'
        '  vorigServ       = '#39#39';'
        '  vexibtodos      = '#39'N'#39';'
        
          '  for select util_split_blob_to_row.mnumber, util_split_blob_to_' +
          'row.retstring'
        '      from util_split_blob_to_row (:vvalue1_b)'
        '    into :vnlinha, :vlinha do'
        '  begin'
        
          '    if ((coalesce(vconf_servico, 0) > 0) and (coalesce(vexibir_s' +
          'ervico, 0) = 0)) then'
        '    begin'
        '      select result from pos ('#39'Exibir'#39', :vlinha)'
        '        into :vexibir_servico;'
        ''
        '      if (coalesce(vexibir_servico, 0) > 0) then'
        '      begin'
        '        vtemp = replace(vlinha, '#39'Exibir'#39', '#39#39');'
        '        vtemp = replace(vtemp, '#39'='#39', '#39#39');'
        '        vtemp = replace(vtemp, ascii_char(13), '#39#39');'
        ''
        
          '        select case when(result > 0) then '#39'S'#39' else '#39'N'#39' end from ' +
          'pos ('#39'S'#39', :vtemp)'
        '          into :vexibserv;'
        '      end'
        '    end'
        ''
        
          '    if ((coalesce(vconf_servico, 0) > 0) and (coalesce(vexibir_s' +
          'ervico, 0) > 0) and (coalesce(vorigem_servico, 0) = 0)) then'
        '    begin'
        '      select result from pos ('#39'Origem'#39', :vlinha)'
        '        into :vorigem_servico;'
        ''
        '      if (coalesce(vorigem_servico, 0) > 0) then'
        '      begin'
        '        vtemp = replace(vlinha, '#39'Origem'#39', '#39#39');'
        '        vtemp = replace(vtemp, '#39'='#39', '#39#39');'
        '        vtemp = replace(vtemp, ascii_char(13), '#39#39');'
        ''
        '        vorigServ = trim(coalesce(vtemp, '#39#39'));'
        '      end'
        ''
        '      if (coalesce(vorigem_servico, 0) > 0) then'
        '      begin'
        
          '        select case when (result > 0) then '#39'S'#39' else '#39'N'#39' end from' +
          ' pos ('#39'TODOS'#39', :vlinha)'
        '          into :vexibtodos;'
        '      end'
        '    end'
        ''
        '    if (coalesce(vconf_servico, 0) = 0) then'
        '    begin'
        '      select result from pos ('#39'[Conf_Servico]'#39', :vlinha)'
        '        into :vconf_servico;'
        '    end'
        ''
        
          '    if ((coalesce(vconf_servico, 0) > 0) and (coalesce(vexibir_s' +
          'ervico, 0) > 0) and (coalesce(vorigem_servico, 0) > 0)) then'
        '      break;'
        '  end'
        ''
        '  if ((coalesce(vexibserv, '#39'N'#39')) <> '#39'S'#39') then'
        '  begin'
        '    result = '#39'N'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        
          '  if ((trim(coalesce(vexibserv, '#39'N'#39')) = '#39'S'#39') and (trim(coalesce(' +
          'vorigServ, '#39#39')) <> '#39#39') and (trim(coalesce(vexibtodos, '#39'N'#39')) = '#39'S' +
          #39')) then'
        '    vexiste = 1;'
        
          '  else if ((trim(coalesce(vexibserv, '#39'N'#39')) = '#39'S'#39') and (trim(coal' +
          'esce(vorigServ, '#39#39')) <> '#39#39')) then'
        '  begin'
        '    for select distinct tipo_servico.stipo from pedvenda'
        
          '        inner join pedvenda_serv on pedvenda.nped = pedvenda_ser' +
          'v.nped and pedvenda.tipo = pedvenda_serv.tipo and pedvenda.cod_e' +
          'mpresa = pedvenda_serv.cod_empresa'
        
          '        inner join tipo_servico on tipo_servico.cod_servico = pe' +
          'dvenda_serv.cod_servico'
        '        where pedvenda.nped = :pnped'
        '        and pedvenda.tipo = :ptipo'
        '        and pedvenda.cod_empresa = :pcod_empresa'
        
          '        and (pedvenda_serv.status <> '#39'CANCELADO'#39' or pedvenda_ser' +
          'v.status is null)'
        '          into :vstipo do'
        '    begin'
        
          '      select case when (p_split.osplit is not null) then 1 else ' +
          '0 end from p_split (:vorigServ, '#39'|'#39')'
        '      where p_split.osplit = :vstipo'
        '        into :vexiste;'
        ''
        '      if (coalesce(vexiste, 0) > 0) then'
        '        break;'
        '    end'
        '  end'
        ''
        '  if (coalesce(vexiste, 0) > 0) then'
        '    result = '#39'S'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONTRATOS_CL;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND268'#39', :COD_EMPRESA, '#39'EM' +
          'ITIR NFS OS'#39', 1, '#39'.'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND269'#39', :COD_EMPRESA, '#39'EN' +
          'VIAR EMAIL/WHATSAPP NFS OS'#39', 1, '#39'.'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND272'#39', :COD_EMPRESA, '#39'EN' +
          'VIAR EMAIL/WHATSAPP NF OS'#39', 1, '#39'.'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
