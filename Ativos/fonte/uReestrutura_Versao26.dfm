        'create or alter procedure RETORNA_PEND_CONFERE ('
        '    PNSU varchar(20),'
        '    PAUT varchar(20),'
        '    PNPARCELA integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT integer)'
        'as'
        'begin'
        '  result = 0;'
        
          '  if ((trim(coalesce(pnsu, '#39#39')) = '#39#39') and (trim(coalesce(paut, '#39 +
          #39')) = '#39#39')) then'
        '    suspend;'
        
          '  else if ((trim(coalesce(pnsu, '#39#39')) <> '#39#39') and (trim(coalesce(p' +
          'aut, '#39#39')) <> '#39#39')) then'
        '  begin'
        '    execute statement'
        '      '#39' select first 1 cf.id from conciliacao_financeiro cf'
        '        left join conciliacao_adquirente adq on'
        '          adq.id = cf.acquirer_id'
        '        left join conciliacao_status_pag_adq stpag_adq on'
        '          stpag_adq.codigo = cf.status_pag_cod'
        '          and stpag_adq.id_adquirente = adq.id'
        '        left join conciliacao_status_pag stpag on'
        '          stpag.id = stpag_adq.id_status_pag'
        
          '        where (select result from retirar_zero_esquerda (cf.nsu)' +
          ') = '#39#39#39' || (select result from retirar_zero_esquerda (:pnsu)) ||' +
          ' '#39#39#39
        '        and cf.authorization_number = '#39#39#39' || :paut || '#39#39#39
        
          '        and coalesce(cf.installment_number, 1) = '#39' || coalesce(:' +
          'pnparcela, 1) || '#39
        '        and cf.cod_empresa = '#39' || :pcod_empresa || '#39
        '        and stpag_adq.status = '#39#39'P'#39#39#39
        '          into :result;'
        '  end'
        '  else if (trim(coalesce(pnsu, '#39#39')) <> '#39#39') then'
        '  begin'
        '    execute statement'
        '      '#39' select first 1 cf.id from conciliacao_financeiro cf'
        '        left join conciliacao_adquirente adq on'
        '          adq.id = cf.acquirer_id'
        '        left join conciliacao_status_pag_adq stpag_adq on'
        '          stpag_adq.codigo = cf.status_pag_cod'
        '          and stpag_adq.id_adquirente = adq.id'
        '        left join conciliacao_status_pag stpag on'
        '          stpag.id = stpag_adq.id_status_pag'
        
          '        where (select result from retirar_zero_esquerda (cf.nsu)' +
          ') = '#39#39#39' || (select result from retirar_zero_esquerda (:pnsu)) ||' +
          ' '#39#39#39
        
          '        and coalesce(cf.installment_number, 1) = '#39' || coalesce(:' +
          'pnparcela, 1) || '#39
        '        and cf.cod_empresa = '#39' || :pcod_empresa || '#39
        '        and stpag_adq.status = '#39#39'P'#39#39#39
        '      into :result;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'CREATE OR ALTER VIEW VW_CONCILIACAO_PENDENCIAS_CRED;'
        '|/BLOCO|'
        ''
        'ALTER TABLE CLIENTES ADD OBS_REQ_OS VARCHAR(130);'
        ''
        'ALTER TABLE PEDVENDA ADD PERC_COMISSAO_VEND3 T_N_GERAL;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND276'#39', :COD_EMPRESA, '#39'BT' +
          ' ALTERAR PERCENTUAL COMISSAO VENDEDOR'#39', 1, '#39'FRMCADPEDVENDA'#39', 1, ' +
          #39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND277'#39', :COD_EMPRESA, '#39'PE' +
          'RC COMISSAO VEND INFORMADO MENOR DO QUE O CONFIG'#39', 1, '#39'FRMCADPED' +
          'VENDA'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PROD_SERV_EMVENDAS_AC_PAG_VND('
        '    COD_EMPRESA,'
        '    DATA_FECH,'
        '    NPED,'
        '    TIPO,'
        '    NITEM,'
        '    PROD_SERV,'
        '    GRUPOP_CODSERV,'
        '    COD_PROD,'
        '    QUANT_PED_ITEM,'
        '    VLUN_PED_ITEM,'
        '    VLTOT_PED_ITEM,'
        '    VALOR_TOTAL_LIQUIDO,'
        '    VALOR_TOTAL_BRUTO,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PCUST_MC,'
        '    DESCR_ITEM_PED,'
        '    COMISS_PROD,'
        '    COMISS_PROD_GER,'
        '    N_NF,'
        '    DESCRICAO,'
        '    SIGLA,'
        '    TIPO_OS,'
        '    NOME_VENDEDOR,'
        '    COD_VENDEDOR,'
        '    COL_COD_VENDEDOR,'
        '    PC_VEND_SERV,'
        '    PC_VEND_PROD,'
        '    COD_FUNCAO,'
        '    DESC_FUNCAO,'
        '    VENDA,'
        '    QTDE_PROD,'
        '    QTDE_SERV)'
        'AS'
        
          'select v.cod_empresa,  v.data_fech, pp.nped,pp.tipo,pp.nitem,'#39'P'#39 +
          ' as prod_serv,'
        'pp.grupo_prod,pp.cod_prod,'
        'coalesce(pp.quant_ped_item,0) as quant_ped_item,'
        'coalesce(pp.vlun_ped_item,0) as vlun_ped_item,'
        'coalesce(pp.vltot_ped_item,0) as vltot_ped_item,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(pp.rateio_desc,0) as rateio_desc,'
        'coalesce(pp.rateio_acresc,0) as rateio_acresc,'
        'coalesce(pp.pcust_mc,0) as pcust_mc,'
        'pp.descr_prod_ped,'
        
          'case when (coalesce(pp.rateio_acresc, 0) > coalesce(pp.rateio_de' +
          'sc, 0)) then'
        
          '       (coalesce(pp.rateio_acresc, 0) - coalesce(pp.rateio_desc,' +
          ' 0))'
        '     else'
        '       0'
        'end comiss_prod,'
        '0 as comiss_prod_ger,'
        'coalesce(pp.n_nf,0) as n_nf,'
        'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,'
        
          'pp.col_cod_vendedor,c.pc_vend_serv, c.PC_VEND_PROD,f.cod_funcao,' +
          'f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_prod pp on v.tipo = pp.tipo and v.nped = pp.' +
          'nped and v.cod_empresa = pp.cod_empresa'
        'inner join grupos g on pp.grupo_prod = g.codigo_grup'
        
          'inner join colaborador c on pp.cod_vendedor = c.cod_vendedor and' +
          ' pp.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        'where v.status_ped = '#39'FECHADA'#39
        'and v.ativo = 1'
        'and (pp.status <> '#39'CANCELADO'#39' or (pp.status is null))'
        'union'
        
          'select v.cod_empresa,  v.data_fech, ps.nped,ps.tipo,ps.nitem,'#39'S'#39 +
          ' as prod_serv,'
        'ps.cod_servico,'#39'      '#39','
        'coalesce(ps.quant_serv_ped,0) as quant_serv_ped,'
        
          '(case when ps.valor_un_serv=0 then ps.prc_int_serv else ps.valor' +
          '_un_serv end) as valor_un_serv,'
        'coalesce(ps.valor_tot_serv,0) as valor_tot_serv,'
        'coalesce(v.valor_total, 0) valor_total_liquido,'
        
          '(coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) + coalesce(v.' +
          'tot_prod_terc, 0) + coalesce(v.tot_serv_terc, 0)) valor_total_br' +
          'uto,'
        'coalesce(ps.rateio_desc,0) as rateio_desc,'
        'coalesce(ps.rateio_acresc,0) as rateio_acresc,0,'
        'ps.desc_serv_ped,0,0,'
        'coalesce(ps.n_nf,0) as n_nf,'
        
          'tv.descricao,tv.sigla,tv.tipo_os,c.nome_vendedor,c.cod_vendedor,' +
          'c.cod_vendedor,'
        'c.pc_vend_serv, c.PC_VEND_PROD,'
        'f.cod_funcao,f.desc_funcao,tv.venda,'
        
          'coalesce((select sum(coalesce(pp2.quant_ped_item, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_prod pp2 on v2.tipo = pp2.tipo and' +
          ' v2.nped = pp2.nped and v2.cod_empresa = pp2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (pp2.status <> '#39'CANCELADO'#39' or (pp2.status is null)' +
          ')), 0) qtde_prod,'
        
          'coalesce((select sum(coalesce(ps2.quant_serv_ped, 0)) from pedve' +
          'nda v2'
        
          '          inner join pedvenda_serv ps2 on v2.tipo = ps2.tipo and' +
          ' v2.nped = ps2.nped and v2.cod_empresa = ps2.cod_empresa'
        '          where v2.nped = v.nped'
        '          and v2.tipo = v.tipo'
        '          and v2.cod_empresa = v.cod_empresa'
        '          and v2.status_ped = '#39'FECHADA'#39
        '          and v2.ativo = 1'
        
          '          and (ps2.status <> '#39'CANCELADO'#39' or (ps2.status is null)' +
          ')), 0) qtde_serv'
        'from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo = tv.tipo and (v.tipv = tv.sigla' +
          ' or (v.tipo_os = tv.tipo_os))'
        
          'inner join pedvenda_serv ps on v.tipo = ps.tipo and v.nped = ps.' +
          'nped and v.cod_empresa = ps.cod_empresa'
        
          'inner join colaborador c on ps.cod_vendedor = c.cod_vendedor and' +
          ' ps.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        
          'where v.status_ped='#39'FECHADA'#39' and v.ativo = 1 and (ps.status <> '#39 +
          'CANCELADO'#39' or (ps.status is null));'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VENDAPRODUTOS_AC_PAG_VND('
        '    COD_EMPRESA,'
        '    DATA_FECH,'
        '    NPED,'
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_GRADE,'
        '    QUANT_PED_ITEM,'
        '    VLUN_ORIG,'
        '    VLUN_PED_ITEM,'
        '    VLTOT_PED_ITEM,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    DESCR_PROD_PED,'
        '    PCUST_MC,'
        '    COMISS_PROD,'
        '    COMISS_PROD_GER,'
        '    N_NF,'
        '    DESCRICAO_TIPV,'
        '    TIPV,'
        '    TIPO_OS,'
        '    DESCRICAO_GRUPO,'
        '    NOME_VENDEDOR,'
        '    NOME_PARTICIPANTE,'
        '    COD_VENDEDOR,'
        '    COD_PARTICIPANTE,'
        '    COL_COD_VENDEDOR,'
        '    COD_FUNCAO,'
        '    DESC_FUNCAO,'
        '    NITEM,'
        '    VENDA,'
        '    NOME_CLIENTEDAV,'
        '    DEV_NPED,'
        '    DEV_TIPO,'
        '    COD_CIDADE,'
        '    NOME_CIDADE)'
        'AS'
        'select v.cod_empresa,v.data_fech,'
        'pp.nped,pp.tipo, pp.grupo_prod,pp.cod_prod,pp.cod_grade,'
        'coalesce(pp.quant_ped_item,0) as quant_ped_item,'
        'coalesce(pp.vlun_orig, 0) as vlun_orig,'
        'coalesce(pp.vlun_ped_item,0) as vlun_ped_item,'
        'coalesce(pp.vltot_ped_item,0) as vltot_ped_item,'
        'coalesce(pp.rateio_desc,0) as rateio_desc,'
        'coalesce(pp.rateio_acresc,0) as rateio_acresc,'
        'pp.descr_prod_ped,'
        'coalesce(pp.pcust_mc,0) as pcust_mc,'
        
          'case when (coalesce(pp.rateio_acresc, 0) > coalesce(pp.rateio_de' +
          'sc, 0)) then'
        
          '       (coalesce(pp.rateio_acresc, 0) - coalesce(pp.rateio_desc,' +
          ' 0))'
        '     else'
        '       0'
        'end comiss_prod,'
        '0 as comiss_prod_ger,'
        'coalesce(pp.n_nf,0) as n_nf,'
        'tv.descricao,tv.sigla,tv.tipo_os, g.descricao,'
        
          'c.nome_vendedor, p.nome_participante,c.cod_vendedor, p.cod_parti' +
          'cipante, pp.col_cod_vendedor, f.cod_funcao,f.desc_funcao,'
        
          'pp.nitem,tv.venda,v.nome_clientedav,v.nped,v.tipo, cl.cod_cidade' +
          ', cd.nome_cidade from tipo_vendas tv'
        
          'inner join pedvenda v on v.tipo=tv.tipo and (v.tipv=tv.sigla or ' +
          '(v.tipo_os=tv.tipo_os))'
        
          'inner join pedvenda_prod pp on v.tipo=pp.tipo and v.nped=pp.nped' +
          ' and v.cod_empresa=pp.cod_empresa'
        'inner join grupos g on pp.grupo_prod=g.codigo_grup'
        
          'inner join colaborador c on pp.cod_vendedor=c.cod_vendedor and p' +
          'p.cod_empresa=c.cod_empresa'
        
          'left join participante p on pp.cod_vendedor1 = p.cod_participant' +
          'e and pp.cod_empresa = p.cod_empresa'
        'inner join funcoes f on c.cod_funcao=f.cod_funcao'
        
          'left join clientes cl on cl.cod_cliente = v.cod_cliente and cl.c' +
          'od_empresa = v.cod_cliente'
        'left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        
          'where v.status_ped='#39'FECHADA'#39' and v.ativo=1 and (pp.status<>'#39'CANC' +
          'ELADO'#39' or (pp.status is null))'
        'union'
        'select d.cod_empresa,d.data,'
        'd.sequencia,'#39'DEV'#39' as tipo,d.grupo_prod,d.cod_prod,d.cod_grade,'
        'd.quant as quant_ped_item,'
        '((-1)*coalesce(d.valor_orig, 0)) as valor_orig,'
        '((-1)*coalesce(d.valor, 0)) as valor,'
        
          '((-1)*(coalesce(d.quant, 0)*coalesce(d.valor, 0))) as vltot_ped_' +
          'item,'
        '0 as rateio_desc,'
        '0 as rateio_acresc,'
        'substr(d.descricao,1,60) as descr_prod_ped,'
        '((-1)*coalesce(d.pcust_mc, 0)) as pcust_mc,'
        '((-1)*coalesce(d.comiss_prod, 0)),'
        '((-1)*coalesce(d.comiss_prod_ger, 0)),'
        'num_nota_nfe,'
        
          'case when tv.descricao is null then '#39'V - VAREJO          '#39' else ' +
          'tv.descricao end as descricao,'
        'case when tv.sigla is null then '#39'V'#39' else tv.sigla end as sigla,'
        'tv.tipo_os,g.descricao,c.nome_vendedor, null nome_participante,'
        
          'c.cod_vendedor, null cod_participante,c.cod_vendedor,f.cod_funca' +
          'o,f.desc_funcao,'
        
          'd.seqid,coalesce(tv.venda,'#39'S'#39'),d.nome_cliente,d.cod_venda,d.tipo' +
          '_venda, cl.cod_cidade, cd.nome_cidade'
        'from devolucao d'
        
          'inner join colaborador c on d.cod_vendedor = c.cod_vendedor and ' +
          'd.cod_empresa = c.cod_empresa'
        'inner join funcoes f on c.cod_funcao = f.cod_funcao'
        'inner join grupos g on d.grupo_prod = g.codigo_grup'
        
          'left join pedvenda v on d.tipo_venda = v.tipo and coalesce(d.cod' +
          '_venda,0) = v.nped and d.cod_empresa = v.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = d.cod_cliente and cl.c' +
          'od_empresa = d.cod_cliente'
        'left join cidades cd on cd.cod_cidade = cl.cod_cidade'
        
          'left join tipo_vendas tv on v.tipo = tv.tipo and (v.tipv=tv.sigl' +
          'a or (v.tipo_os=tv.tipo_os));'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_VALOR_DEV ('
        '    PNDOC integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer,'
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer)'
        'returns ('
        '    QTDE_VND double precision,'
        '    VALOR_VND_TOT double precision,'
        '    QTDE_DEV double precision,'
        '    VALOR_DEV_TOT double precision,'
        '    COMISSAO_PROD double precision)'
        'as'
        'declare variable VTEMP varchar(50);'
        'begin'
        '  /* Procedure Text */'
        '  qtde_vnd = 0;'
        '  valor_vnd_tot = 0;'
        '  qtde_dev = 0;'
        '  valor_dev_tot = 0;'
        '  comissao_prod = 0;'
        '  vtemp = '#39#39';'
        ''
        '  if (pcod_grade > 0) then'
        '    vtemp = '#39' and pp.cod_grade = '#39' || :pcod_grade;'
        ''
        '  if (ptipo = '#39'DEV'#39') then'
        '  begin'
        '    execute statement'
        '    '#39' select sum(coalesce(pp.quant_ped_item, 0)) quantidade,'
        
          '      sum(coalesce(pp.vltot_ped_item, 0)) vltot_ped_item from de' +
          'volucao dev'
        '      inner join pedvenda_prod pp on'
        '        pp.nped = dev.cod_venda'
        '        and pp.tipo = dev.tipo_venda'
        '        and pp.grupo_prod = dev.grupo_prod'
        '        and pp.cod_prod = dev.cod_prod'
        '        and pp.cod_empresa = dev.cod_empresa'
        '        and pp.cod_grade = dev.cod_grade'
        '        and (pp.status <> '#39#39'CANCELADO'#39#39' or pp.status is null)'
        '      where dev.sequencia = '#39' || :pndoc || '#39
        '      and dev.grupo_prod = '#39' || :pgrupo_prod || '#39
        '      and dev.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '      and pp.cod_empresa = '#39' || :pcod_empresa ||'
        '      vtemp'
        '        into :qtde_vnd, :valor_vnd_tot;'
        ''
        '  end'
        '  else'
        '  begin'
        '    execute statement'
        '    '#39' select sum(coalesce(pp.quant_ped_item, 0)) quantidade,'
        
          '      sum(coalesce(pp.vltot_ped_item, 0)) valor_tot from pedvend' +
          'a pd'
        '      inner join pedvenda_prod pp on'
        '        pd.nped = pp.nped'
        '        and pd.tipo = pp.tipo'
        '        and pd.cod_empresa = pp.cod_empresa'
        '      where pp.nped = '#39' || :pndoc || '#39
        '      and pp.tipo = '#39#39#39' || :ptipo || '#39#39#39
        '      and pp.grupo_prod = '#39' || :pgrupo_prod || '#39
        '      and pp.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '      and (pp.status <> '#39#39'CANCELADO'#39#39' or pp.status is null)'
        '      and pp.cod_empresa = '#39' || :pcod_empresa ||'
        '      vtemp'
        '        into :qtde_vnd, :valor_vnd_tot;'
        '  end'
        ''
        '  qtde_vnd = coalesce(qtde_vnd, 0);'
        '  valor_vnd_tot = coalesce(valor_vnd_tot, 0);'
        ''
        '  if (pcod_grade > 0) then'
        '    vtemp = '#39' and d.cod_grade = '#39' || :pcod_grade;'
        ''
        '  if (ptipo = '#39'DEV'#39') then'
        '  begin'
        '    execute statement'
        '    '#39' select sum(coalesce(d.quant, 0)) quantidade,'
        
          '      sum(coalesce(d.quant, 0) * coalesce(d.valor, 0)) valor_tot' +
          ' from devolucao d'
        '      where d.sequencia = '#39' || :pndoc || '#39
        '      and d.grupo_prod = '#39' || :pgrupo_prod || '#39
        '      and d.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '      and d.cod_empresa = '#39' || :pcod_empresa ||'
        '      vtemp'
        '        into :qtde_dev, :valor_dev_tot;'
        '  end'
        '  else'
        '  begin'
        '    execute statement'
        '    '#39' select sum(coalesce(d.quant, 0)) quantidade,'
        
          '      sum(coalesce(d.quant, 0) * coalesce(d.valor, 0)) valor_tot' +
          ' from devolucao d'
        '      where d.cod_venda = '#39' || :pndoc || '#39
        '      and d.tipo_venda = '#39#39#39' || :ptipo || '#39#39#39
        '      and d.grupo_prod = '#39' || :pgrupo_prod || '#39
        '      and d.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '      and d.cod_empresa = '#39' || :pcod_empresa ||'
        '      vtemp'
        '        into :qtde_dev, :valor_dev_tot;'
        '  end'
        ''
        '  qtde_dev = coalesce(qtde_dev, 0);'
        '  valor_dev_tot = coalesce(valor_dev_tot, 0);'
        ''
        
          '  if ((ptipo = '#39'DEV'#39') and (coalesce(qtde_dev, 0) > 0) and (coale' +
          'sce(qtde_vnd, 0) > 0)) then'
        
          '    comissao_prod = (coalesce(qtde_dev, 0) * ((coalesce(valor_de' +
          'v_tot, 0) / coalesce(qtde_dev, 0)) - (coalesce(valor_vnd_tot, 0)' +
          ' / coalesce(qtde_vnd, 0))));'
        '  else'
        '    comissao_prod = 0;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'REL063'#39', :COD_EMPRESA, '#39'BT' +
          ' CONF REL SAIDAS POR VEND COND PAG E COMISS VEND'#39', 5, '#39'FRMRELATO' +
          'RIOS'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'REL064'#39', :COD_EMPRESA, '#39'BT' +
          ' HAB VEND REL SAIDAS VEND COND PAG E COMISS VEND'#39', 5, '#39'FRMRELATO' +
          'RIOS'#39', 1, '#39'N'#39', '#39'N'#39', CURRENT_DATE);'
        'ALTER TABLE CLIENTES ADD RET_FED_NFS SMALLINT;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CLI272'#39', :COD_EMPRESA, '#39'LI' +
