        'create or alter procedure GETCREDITOSQUITADOS ('
        '    PNSU varchar(20),'
        '    PAUT varchar(20),'
        '    PNPARCELA integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    COD_CRED integer,'
        '    CODIGO_EMP integer)'
        'as'
        'begin'
        '  cod_cred   = 0;'
        '  codigo_emp = 0;'
        
          '  if ((trim(coalesce(pnsu, '#39#39')) = '#39#39') and (trim(coalesce(paut, '#39 +
          #39')) = '#39#39')) then'
        '    suspend;'
        
          '  else if ((trim(coalesce(pnsu, '#39#39')) <> '#39#39') and (trim(coalesce(p' +
          'aut, '#39#39')) <> '#39#39')) then'
        '  begin'
        '    execute statement'
        
          '      '#39'select first 1 cc.cod_cred, cc.codigo_emp from controle_c' +
          'reditos cc'
        
          '       where (select result from retirar_zero_esquerda (cc.n_doc' +
          'nsu_adm)) = '#39#39#39'|| (select result from retirar_zero_esquerda (:pn' +
          'su)) || '#39#39#39
        '       and cc.n_aut_cart = '#39#39#39' || :paut || '#39#39#39
        '       and coalesce(cc.nparcela, 1) = '#39'||:pnparcela||'#39
        '       and cc.cod_emp_mult = '#39'||:pcod_empresa||'#39
        '       and cc.datq_c is not null'
        '       and (coalesce((select count(*) from controle_creditos cc2'
        
          '                      where (select result from retirar_zero_esq' +
          'uerda (cc2.n_docnsu_adm)) = '#39#39#39'|| (select result from retirar_ze' +
          'ro_esquerda (:pnsu)) || '#39#39#39
        '                      and cc2.n_aut_cart = '#39#39#39' || :paut || '#39#39#39
        
          '                      and coalesce(cc2.nparcela, 1) = '#39'||:pnparc' +
          'ela||'#39
        '                      and cc2.cod_emp_mult = '#39'||:pcod_empresa||'#39
        '                      and cc2.datq_c is null), 0)) = 0'
        '       order by 1 desc '#39
        '         into :cod_cred, :codigo_emp;'
        ''
        '    cod_cred   = coalesce(cod_cred, 0);'
        '    codigo_emp = coalesce(codigo_emp, 0);'
        '    suspend;'
        '  end'
        '  else if (trim(coalesce(pnsu, '#39#39')) <> '#39#39') then'
        '  begin'
        '    execute statement'
        
          '      '#39'select first 1 cc.cod_cred, cc.codigo_emp from controle_c' +
          'reditos cc'
        
          '       where (select result from retirar_zero_esquerda (cc.n_doc' +
          'nsu_adm)) = '#39#39#39'|| (select result from retirar_zero_esquerda (:pn' +
          'su)) || '#39#39#39
        '       and coalesce(cc.nparcela, 1) = '#39'||:pnparcela||'#39
        '       and cc.cod_emp_mult = '#39'||:pcod_empresa||'#39
        '       and cc.datq_c is not null'
        '       and (coalesce((select count(*) from controle_creditos cc2'
        
          '                      where (select result from retirar_zero_esq' +
          'uerda (cc2.n_docnsu_adm)) = '#39#39#39'|| (select result from retirar_ze' +
          'ro_esquerda (:pnsu)) || '#39#39#39
        
          '                      and coalesce(cc2.nparcela, 1) = '#39'||:pnparc' +
          'ela||'#39
        '                      and cc2.cod_emp_mult = '#39'||:pcod_empresa||'#39
        '                      and cc2.datq_c is null), 0)) = 0'
        '       order by 1 desc '#39
        '         into :cod_cred, :codigo_emp;'
        ''
        '    cod_cred   = coalesce(cod_cred, 0);'
        '    codigo_emp = coalesce(codigo_emp, 0);'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETCREDITOSEMABERTO_NSU_AUT ('
        '    PNSU varchar(20),'
        '    PAUT varchar(20),'
        '    PNPARCELA integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    COD_CRED integer,'
        '    CODIGO_EMP integer,'
        '    QTDE_REG integer)'
        'as'
        'begin'
        '  cod_cred   = 0;'
        '  codigo_emp = 0;'
        '  qtde_reg   = 0;'
        
          '  if ((trim(coalesce(pnsu, '#39#39')) = '#39#39') and (trim(coalesce(paut, '#39 +
          #39')) = '#39#39')) then'
        '    suspend;'
        
          '  else if ((trim(coalesce(pnsu, '#39#39')) <> '#39#39') and (trim(coalesce(p' +
          'aut, '#39#39')) <> '#39#39')) then'
        '  begin'
        '    execute statement'
        
          '      '#39'select first 1 min(cc.cod_cred) cod_cred, min(cc.codigo_e' +
          'mp) codigo_emp, count(*) qtde_reg from controle_creditos cc'
        
          '       where (select result from retirar_zero_esquerda (cc.n_doc' +
          'nsu_adm)) = '#39#39#39' || (select result from retirar_zero_esquerda (:p' +
          'nsu)) || '#39#39#39
        '       and cc.n_aut_cart = '#39#39#39' || :paut || '#39#39#39
        '       and coalesce(cc.nparcela, 1) = '#39' || :pnparcela || '#39
        '       and cc.cod_emp_mult = '#39' || :pcod_empresa || '#39
        '       and cc.datq_c is null '#39
        '         into :cod_cred, :codigo_emp, :qtde_reg;'
        ''
        '    cod_cred   = coalesce(cod_cred, 0);'
        '    codigo_emp = coalesce(codigo_emp, 0);'
        '    qtde_reg   = coalesce(qtde_reg, 0);'
        '    suspend;'
        '  end'
        '  else if (trim(coalesce(pnsu, '#39#39')) <> '#39#39') then'
        '  begin'
        '    execute statement'
        
          '      '#39'select first 1 min(cc.cod_cred) cod_cred, min(cc.codigo_e' +
          'mp) codigo_emp, count(*) qtde_reg from controle_creditos cc'
        
          '       where (select result from retirar_zero_esquerda (cc.n_doc' +
          'nsu_adm)) = '#39#39#39' || (select result from retirar_zero_esquerda (:p' +
          'nsu)) || '#39#39#39
        '       and coalesce(cc.nparcela, 1) = '#39' || :pnparcela || '#39
        '       and cc.cod_emp_mult = '#39' || :pcod_empresa || '#39
        '       and cc.datq_c is null '#39
        '         into :cod_cred, :codigo_emp, :qtde_reg;'
        ''
        '    cod_cred   = coalesce(cod_cred, 0);'
        '    codigo_emp = coalesce(codigo_emp, 0);'
        '    qtde_reg   = coalesce(qtde_reg, 0);'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure GETCREDITOS ('
        '    PNSU varchar(20),'
        '    PAUT varchar(20),'
        '    PNPARCELA integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
