        'create or alter procedure RETORNA_VL_CRED_ABERTO ('
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PCPF_CNPJ varchar(18))'
        'returns ('
        '    VALOR_CRED double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  if (coalesce(pcpf_cnpj, '#39#39') <> '#39#39') then'
        '  begin'
        
          '    select sum(coalesce(controle_creditos.valor_c, 0)) soma from' +
          ' controle_creditos'
        
          '    inner join clientes on clientes.cod_cliente = controle_credi' +
          'tos.cod_cliente and clientes.cod_empresa = controle_creditos.cod' +
          '_emp_mult'
        
          '    inner join empresa on empresa.cod_empresa = controle_credito' +
          's.codigo_emp'
        '    inner join controles on'
        '      controles.codigo_ctrl = controle_creditos.codigo_ctrl'
        '      and controles.codigo_emp = controle_creditos.codigo_emp'
        
          '      and trim(coalesce(controles.exibir_doc, '#39'A'#39')) in ('#39#39', '#39'A'#39',' +
          ' '#39'L'#39')'
        '    where clientes.cpfcgc = :pcpf_cnpj'
        
          '    and (controle_creditos.status_c is null or controle_creditos' +
          '.status_c = '#39#39')'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else controle_creditos.codigo_emp end) = ' +
          ':pcod_empresa'
        '      into :valor_cred;'
        '  end'
        '  else'
        '  begin'
        
          '    select sum(coalesce(controle_creditos.valor_c, 0)) soma from' +
          ' controle_creditos'
        
          '    inner join empresa on empresa.cod_empresa = controle_credito' +
          's.codigo_emp'
        '    inner join controles on'
        '      controles.codigo_ctrl = controle_creditos.codigo_ctrl'
        '      and controles.codigo_emp = controle_creditos.codigo_emp'
        
          '      and trim(coalesce(controles.exibir_doc, '#39'A'#39')) in ('#39#39', '#39'A'#39',' +
          ' '#39'L'#39')'
        '    where controle_creditos.cod_cliente = :pcod_cliente'
        
          '    and (controle_creditos.status_c is null or controle_creditos' +
          '.status_c = '#39#39')'
        
          '    and (case when(empresa.financeiro_unificado = '#39'S'#39') then empr' +
          'esa.codigo_unificadora else controle_creditos.codigo_emp end) = ' +
          ':pcod_empresa'
        '      into :valor_cred;'
        '  end'
        ''
        '  valor_cred = coalesce(valor_cred, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_VL_CHQ_ABERTO ('
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
