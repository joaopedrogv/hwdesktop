        'CREATE TABLE SERVICO_TRANSPORTE_AJUSTE ('
        '    ID              CHAR(36) NOT NULL,'
        '    SERVTR_ID       CHAR(36) NOT NULL,'
        '    COD_EMPRESA     INTEGER NOT NULL,'
        '    COD_OBS         INTEGER NOT NULL,'
        '    COD_AJ          VARCHAR(10) NOT NULL,'
        '    DESCR_COMPL_AJ  VARCHAR(128),'
        
          '    VL_BC_ICMS      T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION ' +
          'DEFAULT 000000000.00 */,'
        
          '    ALIQ_ICMS       T_N_GERAL /* T_N_GERAL = DOUBLE PRECISION DE' +
          'FAULT 000.00 */,'
        
          '    VL_ICMS         T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION ' +
          'DEFAULT 000000000.00 */,'
        
          '    VL_OUTROS       T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION ' +
          'DEFAULT 000000000.00 */,'
        '    TXT_COMPL_D195  VARCHAR(128)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE SERVICO_TRANSPORTE_AJUSTE ADD CONSTRAINT PK_SERVICO_' +
          'TRANSPORTE_AJUSTE PRIMARY KEY (ID);'
        
          'ALTER TABLE SERVICO_TRANSPORTE_AJUSTE ADD CONSTRAINT FK_SERVTRAN' +
          'SP_AJUSTE_LANCF FOREIGN KEY (COD_OBS, COD_EMPRESA) REFERENCES SP' +
          'ED_LANCAMENTO_FISCAL (COD_OBS, COD_EMPRESA);'
        
          'CREATE INDEX IDX_SERV_TR_FK ON SERVICO_TRANSPORTE_AJUSTE (SERVTR' +
          '_ID);'
        'ALTER TABLE SERVICO_TRANSPORTE ADD SERVTR_ID CHAR(36);'
        'CREATE INDEX IDX_SERVT_GUIDID ON SERVICO_TRANSPORTE (SERVTR_ID);'
        'CREATE INDEX IDX_COLAB_CPF ON COLABORADOR (CPF_VENDEDOR);'
        
          'CREATE INDEX IDX_TRANSPORTADOR_CNPJCPF ON TRANSPORTADOR (CNPJ_TR' +
          ');'
        
          'CREATE INDEX IDX_PARTICIPANTE_CPF ON PARTICIPANTE (CPF_PARTICIPA' +
          'NTE);'
        
          'CREATE INDEX IDX_TRANSACAO_CARTAO_DATA ON TRANSACAO_CARTAO (DATA' +
          '_HORA,COD_EMPRESA)'
        
          'CREATE INDEX IDX_CONTROLE_CREDITOS_IDDEV ON CONTROLE_CREDITOS (I' +
          'DDEV_CARTAO, STATUS_ADM, COD_EMP_MULT);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0252'#39', :COD_EMPRESA, '#39'SERV TRANSP VER AJUSTES'#39', 5, ' +
          #39'N'#39', '#39'N'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
