{ TClientes_classList }

function TClientes_classList.GetItem(Index: Integer): TClientes_class;
begin
  Result := TClientes_class(inherited Items[Index]);
end;

function TClientes_classList.New: TClientes_class;
begin
  Result := TClientes_class.Create;
  Add(Result);
end;

procedure TClientes_classList.SetItem(Index: Integer; const Value: TClientes_class);
begin
  Put(Index, Value);
end;

procedure TClientes_classList.SetValuesFrom(ADataSet: TDataSet; AcheckFields: Boolean);
begin
  ADataSet.First;
  while not ADataSet.Eof do
  begin
    Self.New.SetValuesFrom(ADataSet, AcheckFields);
    ADataSet.Next;
  end;
end;

