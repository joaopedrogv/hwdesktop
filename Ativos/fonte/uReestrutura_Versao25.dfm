          '  new.CASAS_DECIMAIS = iif(coalesce(new.CASAS_DECIMAIS, 0) <= 0,' +
          ' 02, new.CASAS_DECIMAIS);'
        
          '  new.CASAS_DECIMAIS = iif(coalesce(new.CASAS_DECIMAIS, 0) > 10,' +
