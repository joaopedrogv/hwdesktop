          ' '#39'PRE'#39' and fp.cod_empresa = bc.cod_emp_mult'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = bc.lote_cxl and fp.tpdocs =' +
          ' '#39'PRE'#39' and fp.cod_empresa = bc.cod_emp_mult), 0) valorrecebiment' +
          'o,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim from baixa_creditos bc'
        '    inner join empresa emp on emp.cod_empresa = bc.codigo_emp'
        '    left join empresa emp2 on emp2.cod_empresa = bc.cod_emp_mult'
        
          '    inner join clientes cl on cl.cod_cliente = bc.cod_cliente an' +
          'd cl.cod_empresa = bc.cod_emp_mult'
        
          '    left join colaborador col on col.cod_vendedor = bc.op_cxl an' +
          'd col.cod_empresa = bc.cod_emp_mult'
        '    where bc.dia_cxl >= :pdataIni'
        '    and bc.dia_cxl <= :pdataFim'
        '    and bc.cod_emp_mult = :pCodEmpresa'
        '    and bc.tip_baixa = '#39'P'#39
        '    union'
        
          '    select 6 ordem, '#39'A Vista'#39' modalidade, '#39'LCS'#39' tipo, lanc.histo' +
          'rico_cxl,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else lanc.op' +
          '_cxl end op_cxl,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else col.nom' +
          'e_vendedor end nome_op_cxl,'
        '    lanc.data_lc_cxl as data_fech, lanc.cod_lancxl,'
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then coalesce(lanc.valo' +
          'r_cxl * - 1, 0) else coalesce(lanc.valor_cxl, 0) end valor_total' +
          ','
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then coalesce(lanc.valo' +
          'r_cxl * - 1, 0) else coalesce(lanc.valor_cxl, 0) end valor_lote,'
        '    1 qtde_lote,'
        '    null cod_cred,'
        '    :pAgruparOperadores agrupar_operadores,'
        '    emp.financeiro_unificado,'
        '    lanc.codigo_emp as cod_empresa,'
        '    lanc.codigo_emp,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    '#39'N'#39' as exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = lanc.cod_lancxl and fp.tpdo' +
          'cs = '#39'LCS'#39' and fp.cod_empresa = lanc.codigo_emp'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = lanc.cod_lancxl and fp.tpdo' +
          'cs = '#39'LCS'#39' and fp.cod_empresa = lanc.codigo_emp), 0) valorrecebi' +
          'mento,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim from lanccxl lanc'
        '    inner join empresa emp on emp.cod_empresa = lanc.codigo_emp'
        '    left join empresa emp2 on emp2.cod_empresa = lanc.codigo_emp'
        
          '    left join colaborador col on col.cod_vendedor = lanc.op_cxl ' +
          'and col.cod_empresa = lanc.codigo_emp'
        '    where lanc.data_lc_cxl >= :pdataIni'
        '    and lanc.data_lc_cxl <= :pdataFim'
        '    and lanc.codigo_emp = :pCodEmpresa'
        '    and lanc.tipo_doc_cxl is null'
        '    and lanc.refrecibo is null'
        '    and (select count(*) from formpagamento fp'
        
          '         inner join controles ctr on ctr.codigo_ctrl = fp.cod_co' +
          'ntrole and ctr.codigo_emp = fp.cod_empresa'
        
          '         where fp.nrequisicao = lanc.cod_lancxl and fp.tpdocs = ' +
          #39'LCS'#39' and fp.cod_empresa = lanc.codigo_emp'
        '         and ctr.docs = '#39'N'#39
        '         and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        '         and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39') > 0'
        '    union'
        
          '    select 6 ordem, '#39'Detalhes'#39' modalidade, '#39'LCS'#39' tipo, lanc.hist' +
          'orico_cxl,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else lanc.op' +
          '_cxl end op_cxl,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else col.nom' +
          'e_vendedor end nome_op_cxl,'
        '    lanc.data_lc_cxl as data_fech, lanc.cod_lancxl,'
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then coalesce(lanc.valo' +
          'r_cxl * - 1, 0) else coalesce(lanc.valor_cxl, 0) end valor_total' +
          ','
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then coalesce(lanc.valo' +
          'r_cxl * - 1, 0) else coalesce(lanc.valor_cxl, 0) end valor_lote,'
        '    1 qtde_lote,'
        '    null cod_cred,'
        '    :pAgruparOperadores agrupar_operadores,'
        '    emp.financeiro_unificado,'
        '    lanc.codigo_emp as cod_empresa,'
        '    lanc.codigo_emp,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    '#39'N'#39' as exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = lanc.cod_lancxl and fp.tpdo' +
          'cs = '#39'LCS'#39' and fp.cod_empresa = lanc.codigo_emp'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = lanc.cod_lancxl and fp.tpdo' +
          'cs = '#39'LCS'#39' and fp.cod_empresa = lanc.codigo_emp), 0) valorrecebi' +
          'mento,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim from lanccxl lanc'
        '    inner join empresa emp on emp.cod_empresa = lanc.codigo_emp'
        '    left join empresa emp2 on emp2.cod_empresa = lanc.codigo_emp'
        
          '    left join colaborador col on col.cod_vendedor = lanc.op_cxl ' +
          'and col.cod_empresa = lanc.codigo_emp'
        '    where lanc.data_lc_cxl >= :pdataIni'
        '    and lanc.data_lc_cxl <= :pdataFim'
        '    and lanc.codigo_emp = :pCodEmpresa'
        '    and lanc.tipo_doc_cxl is null'
        '    and lanc.refrecibo is null'
        '    order by 1, 2 desc, 4, 5'
        
          '      into :ordem, :modalidade, :tipo, :nome_cliente, :op_cxl, :' +
          'nome_op_cxl, :data_fech, :nped, :valor_total, :valor_lote, :qtde' +
          '_lote, :cod_cred,'
        
          '        :agrupar_operadores, :financeiro_unificado, :cod_empresa' +
          ', :cod_emp_mult, :codempresa_temp, :identificacao_emp_temp,'
        
          '        :exibir_emp, :valordinheiro, :valorrecebimento, :data_in' +
          'i, :data_fim do'
        '  begin'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SAIDAS_RECEB_MERCADORIA_FINANC ('
        '    PDATAINI timestamp,'
        '    PDATAFIM timestamp,'
        '    PCODEMPRESA integer,'
        '    PCODEMPUNIFICADA integer,'
        '    PAGRUPARUNIFICADAS char(1))'
        'returns ('
        '    ORDEM integer,'
        '    ORDEM2 integer,'
        '    TP_REL varchar(20),'
        '    MODALIDADE varchar(30),'
        '    TIPO char(10),'
        '    NOME_CLIENTE varchar(35),'
        '    OP_CXL integer,'
        '    NOME_OP_CXL varchar(35),'
        '    DATA_FECH timestamp,'
        '    NPED integer,'
        '    SEQ_BXCREDCH integer,'
        '    TIP_BAIXA char(1),'
        '    VALOR_TOTAL double precision,'
        '    VALOR_LOTE double precision,'
        '    QTDE_LOTE integer,'
        '    AGRUPAR_OPERADORES char(1),'
        '    FINANCEIRO_UNIFICADO char(1),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    CODEMPRESA_TEMP integer,'
        '    IDENTIFICACAO_EMP_TEMP varchar(64),'
        '    EXIBIR_EMP char(1),'
        '    VALORRECEBIMENTO double precision,'
        '    VALORDINHEIRO double precision,'
        '    DATA_INI timestamp,'
        '    DATA_FIM timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  for select 1 ordem, case when (pv.tipo = '#39'REQ'#39') then 2 else 3 ' +
          'end ordem2,'
        '    '#39'SAIDAS/VENDA'#39' tp_rel,'
        '    '#39'A Vista'#39' modalidade, pv.tipo, cl.nome_cliente,'
        '    pv.op_cxl,'
        '    col.nome_vendedor as nome_op_cxl,'
        '    pv.data_fech, pv.nped, null, null,'
        '    coalesce(pv.valor_total, 0) valor_total,'
        '    coalesce(pv.valor_total, 0) valor_lote,'
        '    1 qtde_lote,'
        '    '#39'S'#39' agrupar_operadores,'
        '    emp.financeiro_unificado,'
        
          '    case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_un' +
          'ificadora else pv.cod_empresa end cod_empresa,'
        '    pv.cod_empresa as cod_emp_mult,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    case when (:pCodEmpUnificada > 0) then '#39'N'#39
        '         when (:pAgruparUnificadas = '#39'S'#39') then '#39'N'#39
        '         else '#39'S'#39' end exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = pv.nped and fp.tpdocs = pv.' +
          'tipo and fp.cod_empresa = pv.cod_empresa), 0) valorrecebimento,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = pv.nped and fp.tpdocs = pv.' +
          'tipo and fp.cod_empresa = pv.cod_empresa'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim'
        '    from pedvenda pv'
        '    inner join empresa emp on emp.cod_empresa = pv.cod_empresa'
        '    left join empresa emp2 on emp2.cod_empresa ='
        
          '        (case when (:pCodEmpUnificada > 0) then :pCodEmpUnificad' +
          'a'
        
          '              when (:pAgruparUnificadas = '#39'S'#39') then emp.codigo_u' +
          'nificadora'
        '              else pv.cod_empresa end)'
        
          '    inner join clientes cl on cl.cod_cliente = pv.cod_cliente an' +
          'd cl.cod_empresa = pv.cod_empresa'
        
          '    left join colaborador col on col.cod_vendedor = pv.op_cxl an' +
          'd col.cod_empresa = pv.cod_empresa'
        '    where pv.data_fech >= :pdataIni'
        '    and pv.data_fech <= :pdataFim'
        
          '    and (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codi' +
          'go_unificadora else pv.cod_empresa end) = :pCodEmpresa'
        '    and pv.tipo <> '#39'ORC'#39
        '    and pv.status_ped = '#39'FECHADA'#39
        
          '    and (select sum(coalesce(fp.valordoc, 0)) from formpagamento' +
          ' fp'
        
          '         inner join controles ctr on ctr.codigo_ctrl = fp.cod_co' +
          'ntrole and ctr.codigo_emp = fp.cod_empresa'
        
          '         where fp.nrequisicao = pv.nped and fp.tpdocs = pv.tipo ' +
          'and fp.cod_empresa = pv.cod_empresa'
        '         and ctr.docs = '#39'N'#39
        '         and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        '         and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39') > 0'
        '    union'
        
          '    select 1 ordem, case when (pv.tipo = '#39'REQ'#39') then 2 else 3 en' +
          'd ordem2,'
        '    '#39'SAIDAS/VENDA'#39' tp_rel,'
        '    '#39'Detalhes'#39' modalidade, pv.tipo, cl.nome_cliente,'
        '    pv.op_cxl,'
        '    col.nome_vendedor as nome_op_cxl,'
        '    pv.data_fech, pv.nped, null, null,'
        '    coalesce(pv.valor_total, 0) valor_total,'
        '    coalesce(pv.valor_total, 0) valor_lote,'
        '    1 qtde_lote,'
        '    '#39'S'#39' agrupar_operadores,'
        '    emp.financeiro_unificado,'
        
          '    case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_un' +
          'ificadora else pv.cod_empresa end cod_empresa,'
        '    pv.cod_empresa as cod_emp_mult,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    case when (:pCodEmpUnificada > 0) then '#39'N'#39
        '         when (:pAgruparUnificadas = '#39'S'#39') then '#39'N'#39
        '         else '#39'S'#39' end exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = pv.nped and fp.tpdocs = pv.' +
          'tipo and fp.cod_empresa = pv.cod_empresa), 0) valorrecebimento,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = pv.nped and fp.tpdocs = pv.' +
          'tipo and fp.cod_empresa = pv.cod_empresa'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    cast(:pdataIni  as timestamp) data_ini, cast(:pdataFim  as t' +
          'imestamp) data_fim'
        '    from pedvenda pv'
        '    inner join empresa emp on emp.cod_empresa = pv.cod_empresa'
        '    left join empresa emp2 on emp2.cod_empresa ='
        
          '        (case when (:pCodEmpUnificada > 0) then :pCodEmpUnificad' +
          'a'
        
          '              when (:pAgruparUnificadas = '#39'S'#39') then emp.codigo_u' +
          'nificadora'
        '              else pv.cod_empresa end)'
        
          '    inner join clientes cl on cl.cod_cliente = pv.cod_cliente an' +
          'd cl.cod_empresa = pv.cod_empresa'
        
          '    left join colaborador col on col.cod_vendedor = pv.op_cxl an' +
          'd col.cod_empresa = pv.cod_empresa'
        '    where pv.data_fech >= :pdataIni'
        '    and pv.data_fech <= :pdataFim'
        
          '    and (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codi' +
          'go_unificadora else pv.cod_empresa end) = :pCodEmpresa'
        '    and pv.tipo <> '#39'ORC'#39
        '    and pv.status_ped = '#39'FECHADA'#39
        
          '    and (select sum(coalesce(fp.valordoc, 0)) from formpagamento' +
          ' fp'
        
          '         inner join controles ctr on ctr.codigo_ctrl = fp.cod_co' +
          'ntrole and ctr.codigo_emp = fp.cod_empresa'
        
          '         where fp.nrequisicao = pv.nped and fp.tpdocs = pv.tipo ' +
          'and fp.cod_empresa = pv.cod_empresa) > 0'
        '    union'
        '    select 2 ordem, 4 ordem2, '#39'RECIBO ANTECIPADO'#39' tp_rel,'
        '    '#39'A Vista'#39' modalidade, '#39'REC'#39' tipo, cl.nome_cliente,'
        '    rec.op_cxl,'
        '    col.nome_vendedor as nome_op_cxl,'
        '    rec.data_rec as data_fech, rec.nrecibo, null, null,'
        '    coalesce(rec.valor_orig, 0) valor_total,'
        '    coalesce(rec.valor_orig, 0) valor_lote,'
        '    1 qtde_lote,'
        '    '#39'S'#39' agrupar_operadores,'
        '    emp.financeiro_unificado,'
        
          '    case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_un' +
          'ificadora else rec.cod_empresa end cod_empresa,'
        '    rec.cod_empresa as cod_emp_mult,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    case when (:pCodEmpUnificada > 0) then '#39'N'#39
        '         when (:pAgruparUnificadas = '#39'S'#39') then '#39'N'#39
        '         else '#39'S'#39' end exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = rec.nrecibo and fp.tpdocs =' +
          ' '#39'REC'#39' and fp.cod_empresa = rec.cod_empresa), 0) valorrecebiment' +
          'o,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '              inner join controles ctr on ctr.codigo_ctrl = fp.c' +
          'od_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '              where fp.nrequisicao = rec.nrecibo and fp.tpdocs =' +
          ' '#39'REC'#39' and fp.cod_empresa = rec.cod_empresa'
        '              and ctr.docs = '#39'N'#39
        '              and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '              and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) v' +
          'alordinheiro,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim from recibos rec'
        '    inner join empresa emp on emp.cod_empresa = rec.cod_empresa'
        '    left join empresa emp2 on emp2.cod_empresa ='
        
          '        (case when (:pCodEmpUnificada > 0) then :pCodEmpUnificad' +
          'a'
        
          '              when (:pAgruparUnificadas = '#39'S'#39') then emp.codigo_u' +
          'nificadora'
        '              else rec.cod_empresa end)'
        
          '    inner join clientes cl on cl.cod_cliente = rec.cod_devedor a' +
          'nd cl.cod_empresa = rec.cod_empresa'
        
          '    left join colaborador col on col.cod_vendedor = rec.op_cxl a' +
          'nd col.cod_empresa = rec.cod_empresa'
        '    where rec.data_rec >= :pdataIni'
        '    and rec.data_rec <= :pdataFim'
        
          '    and (case when(emp.financeiro_unificado = '#39'S'#39') then emp.codi' +
          'go_unificadora else rec.cod_empresa end) = :pCodEmpresa'
        
