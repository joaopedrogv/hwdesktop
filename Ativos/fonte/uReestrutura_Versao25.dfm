          'ULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', 12, 20, '#39'N'#39', '#39'CENTRO'#39', NULL, NULL' +
          ', NULL, NULL, NULL, NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'S'#39', '#39'qrsDetailNo' +
