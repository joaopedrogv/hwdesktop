        '|BLOCO|'
        'CREATE OR ALTER VIEW NOTAFISCAL_DANFE('
        '    COD_NF,'
        '    COD_EMPRESA,'
        '    NATUREZA_NF,'
        '    DESC_NATUREZA_NF,'
        '    NUM_NF,'
        '    SERIE,'
        '    MODELO_NF,'
        '    TIPO_NF,'
        '    STATUS,'
        '    SITUACAO_NFE,'
        '    EMISSAO_PROPRIA,'
        '    DATA_LANC,'
        '    DATA_EMISSAO,'
        '    DATA_ENTRADA_SAIDA,'
        '    CHAVE_NFE,'
        '    NPED,'
        '    TIPO_PED,'
        '    COD_RASTREAMENTO,'
        '    COD_FORMA_RAST,'
        '    DESCR_FORM_RAST,'
        '    DATA_ENVIO_RAST,'
        '    VALOR_TOTAL,'
        '    VALOR_PROD,'
        '    VALOR_SERV,'
        '    VALOR_FRETE,'
        '    RAZAO_EMP,'
        '    FANTASIA_EMP,'
        '    IDENTIFICACAO_EMP,'
        '    CPFCGC_EMP,'
        '    ENDERECO_COMPL_EMP,'
        '    ENDERECO_EMP,'
        '    NUMERO_END,'
        '    COMPLEMENTO_EMP,'
        '    BAIRRO_EMP,'
        '    CIDADE_EMP,'
        '    UF_EMP,'
        '    CEP_EMP,'
        '    TELEFONE_EMP,'
        '    EMAIL_EMP,'
        '    IE_EMP,'
        '    IM_EMP,'
        '    COD_CL,'
        '    NOME_CL,'
        '    RAZAO_CL,'
        '    CPFCGC_CL,'
        '    CEP_CL,'
        '    TELEFONE_CL,'
        '    CELULAR_CL,'
        '    EMAIL_CL,'
        '    ENDERECO_COMPL_CL,'
        '    ENDERECO_CL,'
        '    CIDADE_CL,'
        '    BAIRRO_CL,'
        '    UF_CL,'
        '    COMPLEMENTO_CL,'
        '    NUM_END_CL,'
        '    QTDE_VOLUMES_TR,'
        '    FRETECONTA_TR,'
        '    COD_TR,'
        '    NOME_TR,'
        '    CNPJ_TR,'
        '    END_COMPL_TR,'
        '    END_TR,'
        '    MUNICIPIO_TR,'
        '    UF_TR,'
        '    IE_TR,'
        '    PESO_B_NF,'
        '    PESO_L_NF,'
        '    PESO_B_PROD,'
        '    PESO_L_PROD)'
        'AS'
        'SELECT NOTAFISCAL.COD_NF, NOTAFISCAL.COD_EMPRESA,'
        'NOTAFISCAL.NATUREZA_NF,'
        
          'CASE WHEN (NOTAFISCAL.NATUREZA_NF = '#39'S'#39') then '#39'SAIDA'#39' else '#39'ENTR' +
          'ADA'#39' END DESC_NATUREZA_NF,'
        'NOTAFISCAL.NUM_NF, NOTAFISCAL.SERIE,'
        
          'NOTAFISCAL.MODELO_NF, NOTAFISCAL.TIPO_NF, NOTAFISCAL.EMISSAO_PRO' +
          'PRIA,'
        
          'NOTAFISCAL.STATUS, NOTAFISCAL.SITUACAO_NFE, NOTAFISCAL.DATA_LANC' +
          ', NOTAFISCAL.DATA_CONTABIL, NOTAFISCAL.DATA_ENT_SAIDA,'
        'NOTAFISCAL.CHAVE_NFE,'
        'NOTAFISCAL.NPED, NOTAFISCAL.TIPO_PED,'
        'PEDVENDA.COD_RASTREAMENTO,'
        'PEDVENDA.COD_FORMA_RAST,'
        'FORMAS_ENVIO_EC.DESCRICAO AS DESCR_FORM_RAST,'
        'PEDVENDA.DATA_ENVIO_RAST,'
        
          'NOTAFISCAL.VALOR_TOTAL, NOTAFISCAL.VALOR_PROD, NOTAFISCAL.VALOR_' +
          'SERV, NOTAFISCAL.VALOR_FRETE,'
        'EMPRESA.NOME_EMP,'
        'EMPRESA.FANTASIA_EMP,'
        'EMPRESA.IDENTIFICACAO_EMP,'
        'EMPRESA.CGC_EMP,'
        '(coalesce(EMPRESA.ENDRECO_EMP, '#39#39') ||'
        
          '    iif(coalesce(EMPRESA.NUMERO_END, 0) > 0, '#39', N: '#39' || coalesce' +
          '(EMPRESA.NUMERO_END, 0), '#39#39') ||'
        
          '    iif((trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')) <> '#39#39'), '#39', ' +
          #39' || trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CEP_EMP, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(EMPRESA.CEP_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CIDADE_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.CIDADE_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ') ENDERECO_COMPL_EMP,'
        'EMPRESA.ENDRECO_EMP,'
        'EMPRESA.NUMERO_END,'
        'EMPRESA.COMPLEMENTO_EMP,'
        'EMPRESA.BAIRRO_EMP,'
        'EMPRESA.CIDADE_EMP,'
        'ESTEMP.SIGLA_UF UF_EMP,'
        'EMPRESA.CEP_EMP,'
        'EMPRESA.TELEFONE_EMP,'
        'EMPRESA.EMAIL_EMP,'
        'EMPRESA.IE_EMP,'
        'EMPRESA.IM_EMP,'
        'NOTAFISCAL.COD_CLIENTE,'
        'CLIENTES.NOME_CLIENTE,'
        'CLIENTES.RAZAO,'
        'CLIENTES.CPFCGC,'
        'CLIENTES.CEP,'
        'CLIENTES.FONE_CLIENTE,'
        'CLIENTES.FONE_CELULAR,'
        'CLIENTES.EMAIL,'
        '(coalesce(CLIENTES.ENDERECO, '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')) <> '#39#39', '#39', N' +
          ': '#39' || trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')), '#39#39') ||'
        
          '    iif((trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')) <> '#39#39'), '#39', '#39' |' +
          '| trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.CEP, '#39#39')) <> '#39#39', '#39', '#39' || trim(coa' +
          'lesce(CLIENTES.CEP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(BAICL.NOME_BAIRRO, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(BAICL.NOME_BAIRRO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CIDCL.NOME_CIDADE, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(CIDCL.NOME_CIDADE, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ') ENDERECO_COMPL_CL,'
        'CLIENTES.ENDERECO,'
        'CIDCL.NOME_CIDADE CIDADE_CL,'
        'BAICL.NOME_BAIRRO BAIRRO_CL,'
        'ESTCL.SIGLA_UF UF_CL,'
        'CLIENTES.COMPLEMENTO,'
        'CLIENTES.NUM_END_CLIENTE,'
        'NOTAFISCAL.CODIGO_TR,'
        'TRANSPORTADOR.NOME_TR,'
        'TRANSPORTADOR.CNPJ_TR,'
        '(coalesce(TRANSPORTADOR.END_TR, '#39#39') ||'
        
          '    iif(trim(coalesce(TRANSPORTADOR.MUNICIPIO_TR, '#39#39')) <> '#39#39', '#39',' +
          ' '#39' || trim(coalesce(TRANSPORTADOR.MUNICIPIO_TR, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTTR.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(c' +
          'oalesce(ESTTR.SIGLA_UF, '#39#39')), '#39#39')'
        ') END_COMPL_TR,'
        'TRANSPORTADOR.END_TR,'
        'TRANSPORTADOR.MUNICIPIO_TR,'
        'ESTTR.SIGLA_UF UF_TR,'
        'TRANSPORTADOR.IE_TR,'
        'NOTAFISCAL.QTDE_VOLUMES_TR,'
        'NOTAFISCAL.FRETECONTA_TR,'
        
          'COALESCE((SELECT SUM(COALESCE(NOTAFISCAL_ITEM.PESO_B, 0)) FROM N' +
          'OTAFISCAL_ITEM'
        '          WHERE NOTAFISCAL_ITEM.COD_NF = NOTAFISCAL.COD_NF'
        
          '          AND NOTAFISCAL_ITEM.COD_EMPRESA = NOTAFISCAL.COD_EMPRE' +
          'SA), 0) PESO_B_NF,'
        
          'COALESCE((SELECT SUM(COALESCE(NOTAFISCAL_ITEM.PESO_L, 0)) FROM N' +
          'OTAFISCAL_ITEM'
        '          WHERE NOTAFISCAL_ITEM.COD_NF = NOTAFISCAL.COD_NF'
        
          '          AND NOTAFISCAL_ITEM.COD_EMPRESA = NOTAFISCAL.COD_EMPRE' +
          'SA), 0) PESO_L_NF,'
        
          'COALESCE((SELECT SUM(COALESCE(PRODUTOS.PESO_BRUT_PROD, 0) * COAL' +
          'ESCE(NOTAFISCAL_ITEM.QUANTIDADE, 0)) FROM NOTAFISCAL_ITEM'
        '          INNER JOIN PRODUTOS ON'
        '            PRODUTOS.GRUPO_PROD = NOTAFISCAL_ITEM.GRUPO_PROD'
        '            AND PRODUTOS.COD_PROD = NOTAFISCAL_ITEM.COD_PROD'
        
          '            AND PRODUTOS.COD_EMPRESA = NOTAFISCAL_ITEM.COD_EMPRE' +
          'SA'
        '          WHERE NOTAFISCAL_ITEM.COD_NF = NOTAFISCAL.COD_NF'
        
          '          AND NOTAFISCAL_ITEM.COD_EMPRESA = NOTAFISCAL.COD_EMPRE' +
          'SA), 0) PESO_B_PROD,'
        
          'COALESCE((SELECT SUM(COALESCE(PRODUTOS.PESO_LIQ_PROD, 0) * COALE' +
          'SCE(NOTAFISCAL_ITEM.QUANTIDADE, 0)) FROM NOTAFISCAL_ITEM'
        '          INNER JOIN PRODUTOS ON'
        '            PRODUTOS.GRUPO_PROD = NOTAFISCAL_ITEM.GRUPO_PROD'
        '            AND PRODUTOS.COD_PROD = NOTAFISCAL_ITEM.COD_PROD'
        
          '            AND PRODUTOS.COD_EMPRESA = NOTAFISCAL_ITEM.COD_EMPRE' +
          'SA'
        '          WHERE NOTAFISCAL_ITEM.COD_NF = NOTAFISCAL.COD_NF'
        
          '          AND NOTAFISCAL_ITEM.COD_EMPRESA = NOTAFISCAL.COD_EMPRE' +
          'SA), 0) PESO_L_PROD FROM NOTAFISCAL'
        'LEFT JOIN EMPRESA ON'
        '  EMPRESA.COD_EMPRESA = NOTAFISCAL.COD_EMPRESA'
        'LEFT JOIN ESTADOS ESTEMP ON'
        '  ESTEMP.CODIGO_UF = EMPRESA.UF_EMP'
        'LEFT JOIN CLIENTES ON'
        '  CLIENTES.COD_CLIENTE = NOTAFISCAL.COD_CLIENTE'
        '  AND CLIENTES.COD_EMPRESA = NOTAFISCAL.COD_EMPRESA'
        'LEFT JOIN CIDADES CIDCL ON'
        '  CIDCL.COD_CIDADE = CLIENTES.COD_CIDADE'
        'LEFT JOIN BAIRROS BAICL ON'
        '  BAICL.COD_BAIRRO = CLIENTES.COD_BAIRRO'
        'LEFT JOIN ESTADOS ESTCL ON'
        '  ESTCL.CODIGO_UF = CLIENTES.CODIGO_UF'
        'LEFT JOIN TRANSPORTADOR ON'
        '  TRANSPORTADOR.CODIGO_TR = NOTAFISCAL.CODIGO_TR'
        '  AND TRANSPORTADOR.COD_EMPRESA = NOTAFISCAL.COD_EMPRESA'
        'LEFT JOIN ESTADOS ESTTR ON'
        '  ESTTR.CODIGO_UF = TRANSPORTADOR.UF_TR'
        'LEFT JOIN PEDVENDA ON'
        '  PEDVENDA.NPED = NOTAFISCAL.NPED'
        '  AND PEDVENDA.TIPO = NOTAFISCAL.TIPO_PED'
        '  AND PEDVENDA.COD_EMPRESA = NOTAFISCAL.COD_EMPRESA'
        'LEFT JOIN FORMAS_ENVIO_EC ON'
        '  FORMAS_ENVIO_EC.COD_FORMA = PEDVENDA.COD_FORMA_RAST'
        '  AND FORMAS_ENVIO_EC.COD_EMPRESA = PEDVENDA.COD_EMPRESA;'
        '|/BLOCO|'
