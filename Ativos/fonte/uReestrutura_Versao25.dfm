          'STRETCH, CAMPOVARIAVEL, TEXTOCAMPOVARIAVEL, CAMPOSISTEMA, TIPOSI' +
          'STEMA, QTDEZEROESQUERDA, CASASDECIMAIS, VALOR_DEFAULT)'
        
          '    VALUES (:vcod_danfe, 4, :pcod_empresa, '#39'NF-E:'#39', '#39'FIXO3'#39', '#39'S'#39 +
          ', '#39'NF-e:'#39', 29, '#39'Arial'#39', 8, '#39'clWindowText'#39', '#39'S'#39', '#39'N'#39', '#39'N'#39', 13, 23' +
          ', 1, NULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', NULL, NULL, 12, 29, '#39'ESQUER' +
          'DA'#39', NULL, NULL, NULL, '#39'N'#39', NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N'#39', '#39#39', ' +
          'NULL, NULL, NULL);'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
