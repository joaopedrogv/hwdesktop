        '          valor_ult_compra = null'
        '        where cod_cliente = new.CLIENTES_V'
        '        and cod_empresa = new.COD_EMPRESA;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE NOTAFISCAL_ITEM ADD MED_CPRODANVISA VARCHAR(13);'
        'ALTER TABLE NOTAFISCAL_ITEM ADD MED_VPMC T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD RASTRO_NLOTE VARCHAR(20);'
        'ALTER TABLE NOTAFISCAL_ITEM ADD RASTRO_QLOTE T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD RASTRO_DFAB TIMESTAMP;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD RASTRO_DVAL TIMESTAMP;'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CXL088'#39', :COD_EMPRESA, '#39'IN' +
          'ICIAR MODULO DE RECIBO'#39', 3, NULL, 1, '#39'N'#39', '#39'N'#39', CURRENT_DATE);'
        ''
        'ALTER TABLE CONTROLE_CHEQUE ADD DATA_BAIXA TIMESTAMP;'
        ''
        
          'CMD:REPL|UPDATE CONTROLE_CHEQUE SET DATA_BAIXA = DATQ_CH WHERE D' +
          'ATQ_CH IS NOT NULL AND DATA_BAIXA IS NULL;'
