        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_NFCE_MOVIMENTO('
        '    ID,'
        '    COD_EMISSOR,'
        '    OPERADOR,'
        '    DIA_MOV,'
        '    DIA_FECH,'
        '    TIPO,'
        '    TPAG,'
        '    XPAG,'
        '    VPAG,'
        '    COD_CONTROLE,'
        '    NOME_CTRL,'
        '    COD_EMPRESA,'
        '    MOV_SEQ,'
        '    COD_NFCE,'
        '    STATUS,'
        '    SITUACAO_NFCE,'
        '    TPEMIS,'
        '    VNF,'
        '    VPROD,'
        '    VDESC,'
        '    VSEG,'
        '    VFRETE,'
        '    VOUTRO)'
        'AS'
        
          'select mov.id,  mov.cod_emissor, mov.operador, mov.dia_mov,  mov' +
          '.dia_fech, '#39'NFC-e'#39','
        
          'pag.tpag, xpag.xpag, coalesce(pag.vpag, 0) vpag, ctrl.codigo_ctr' +
          'l, ctrl.nome_ctrl,'
        
          'mov.cod_empresa, nfc.mov_seq, nfc.cod_nfce, coalesce(nfc.status,' +
          ' '#39#39') status,'
        
          'coalesce(nfc.situacao_nfce, '#39#39') situacao_nfce, nfc.tpemis, coale' +
          'sce(nfc.vnf, 0) vnf,'
        
          'coalesce(nfc.vprod, 0) vprod, coalesce(nfc.vdesc, 0) vdesc, coal' +
          'esce(nfc.vseg, 0) vseg,'
        'coalesce(nfc.vfrete, 0) vfrete, coalesce(nfc.voutro, 0) voutro'
        'from nfce_movimento mov'
        
          'inner join nfce nfc on nfc.mov_id = mov.id and nfc.cod_empresa =' +
          ' mov.cod_empresa and nfc.ativo = 1'
        
          'left join nfce_pagamento pag on pag.cod_nfce = nfc.cod_nfce and ' +
          'pag.cod_empresa = nfc.cod_empresa'
        'left join sp_nfce_tab_tpag(pag.tpag) xpag on 1 = 1'
        
          'left join controles ctrl on ctrl.codigo_ctrl = pag.cod_controle ' +
          'and ctrl.codigo_emp = pag.cod_empresa'
        'union all'
        
          'select mov.id,  mov.cod_emissor, mov.operador, mov.dia_mov,  mov' +
          '.dia_fech, lanc.historico,'
        
          'xpag.tpag, xpag.xpag, coalesce(lanc.valor, 0) valor, 1, ctrl.nom' +
          'e_ctrl, mov.cod_empresa, lanc.mov_seq,'
        'null, null, null, null, 0, 0, 0, 0, 0, 0'
        'from nfce_movimento mov'
        
          'inner join nfce_movimento_lanc lanc on lanc.mov_id = mov.id and ' +
          'lanc.cod_empresa = mov.cod_empresa'
        'left join sp_nfce_tab_tpag(1) xpag on 1 = 1'
        
          'left join controles ctrl on ctrl.codigo_ctrl = 1 and ctrl.codigo' +
          '_emp = lanc.cod_empresa;'
        '|/BLOCO|'
        ''
