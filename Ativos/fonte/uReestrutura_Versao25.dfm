        '|BLOCO|'
        'CREATE TABLE CLIENTES_CONTATO_ENV ('
        '    COD_CLIENTE  INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    ORIGEM_ENV   VARCHAR(10) NOT NULL,'
        '    ID_CONTATO   INTEGER NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE CLIENTES_CONTATO_ENV ADD CONSTRAINT PK_CLIENTES_CONT' +
          'ATO_ENV PRIMARY KEY (COD_CLIENTE, COD_EMPRESA, ID_CONTATO, ORIGE' +
          'M_ENV);'
        
          'ALTER TABLE CLIENTES_CONTATO_ENV ADD CONSTRAINT FK_CLIENTES_CONT' +
          'ATO_ENV_CL FOREIGN KEY (COD_CLIENTE, COD_EMPRESA) REFERENCES CLI' +
          'ENTES (COD_CLIENTE, COD_EMPRESA) ON DELETE CASCADE;'
        
          'ALTER TABLE CLIENTES_CONTATO_ENV ADD CONSTRAINT FK_CLIENTES_CONT' +
          'ATO_ENV_CONT FOREIGN KEY (ID_CONTATO, COD_EMPRESA) REFERENCES CL' +
          'IENTES_CONTATO (ID, COD_EMPRESA) ON DELETE CASCADE;'
        ''
        '|BLOCO|'
        'create or alter procedure SP_CONTATOS_CLIENTES ('
        '    PCOD_CLIENTE integer,'
        '    PCOD_EMPRESA integer,'
        '    PORIGEM varchar(10))'
        'returns ('
        '    COD_CLIENTE integer,'
        '    COD_EMPRESA integer,'
        '    FONE varchar(14),'
        '    ID_TIPO integer,'
        '    TIPO varchar(32),'
        '    ID_CONTATO integer,'
        '    ENV char(1))'
        'as'
        'begin'
        '  /* Procedure Text */'
        ''
        '  for select cl.cod_cliente, cl.cod_empresa,'
        '      (select result from sonumeros(trim(cl.fone_celular))),'
        '      0, '#39'CELULAR'#39', 0, '#39'N'#39' from clientes cl'
        '      where coalesce(cl.fone_celular, '#39#39') <> '#39#39
        '      and cl.cod_cliente = :pcod_cliente'
        '      and cl.cod_empresa = :pcod_empresa'
        '      and (select count(*) from clientes_contato cc'
        '           where cc.cod_cliente = cl.cod_cliente'
        '           and cc.cod_empresa = cl.cod_empresa'
        
          '           and trim(coalesce(cc.telefone, '#39#39')) = (select result ' +
          'from sonumeros(trim(coalesce(cl.fone_celular, '#39#39'))))) = 0'
        '      union all'
        '      select cl.cod_cliente, cl.cod_empresa,'
        '      (select result from sonumeros(trim(cl.fone_cliente))),'
        '      0, '#39'FONE'#39', 0, '#39'N'#39' from clientes cl'
        '      where coalesce(cl.fone_cliente, '#39#39') <> '#39#39
        '      and cl.cod_cliente = :pcod_cliente'
        '      and cl.cod_empresa = :pcod_empresa'
        
          '      and (trim(coalesce(cl.fone_cliente, '#39#39')) <> trim(coalesce(' +
          'cl.fone_celular, '#39#39')))'
        '      and (select count(*) from clientes_contato cc'
        '           where cc.cod_cliente = cl.cod_cliente'
        '           and cc.cod_empresa = cl.cod_empresa'
        
          '           and trim(coalesce(cc.telefone, '#39#39')) = (select result ' +
          'from sonumeros(trim(coalesce(cl.fone_cliente, '#39#39'))))) = 0'
        '      union all'
        '      select cl.cod_cliente, cl.cod_empresa,'
        '      (select result from sonumeros(trim(cl.tel_res_cf))),'
        '      0, '#39'FONE RESIDENCIAL'#39', 0, '#39'N'#39' from clientes cl'
        '      where coalesce(cl.tel_res_cf, '#39#39') <> '#39#39
        '      and cl.cod_cliente = :pcod_cliente'
        '      and cl.cod_empresa = :pcod_empresa'
        
          '      and (trim(coalesce(cl.tel_res_cf, '#39#39')) <> trim(coalesce(cl' +
          '.fone_celular, '#39#39')))'
        
          '      and (trim(coalesce(cl.tel_res_cf, '#39#39')) <> trim(coalesce(cl' +
          '.fone_cliente, '#39#39')))'
        '      and (select count(*) from clientes_contato cc'
        '           where cc.cod_cliente = cl.cod_cliente'
        '           and cc.cod_empresa = cl.cod_empresa'
        
          '           and trim(coalesce(cc.telefone, '#39#39')) = (select result ' +
          'from sonumeros(trim(coalesce(cl.tel_res_cf, '#39#39'))))) = 0'
        '      union all'
        '      select cl.cod_cliente, cl.cod_empresa,'
        '      (select result from sonumeros(trim(cl.fax))),'
        '      0, '#39'FAX'#39', 0, '#39'N'#39' from clientes cl'
        '      where coalesce(cl.fax, '#39#39') <> '#39#39
        '      and cl.cod_cliente = :pcod_cliente'
        '      and cl.cod_empresa = :pcod_empresa'
        
          '      and (trim(coalesce(cl.fax, '#39#39')) <> trim(coalesce(cl.fone_c' +
          'elular, '#39#39')))'
        
          '      and (trim(coalesce(cl.fax, '#39#39')) <> trim(coalesce(cl.fone_c' +
          'liente, '#39#39')))'
        
          '      and (trim(coalesce(cl.fax, '#39#39')) <> trim(coalesce(cl.tel_re' +
          's_cf, '#39#39')))'
        '      and (select count(*) from clientes_contato cc'
        '           where cc.cod_cliente = cl.cod_cliente'
        '           and cc.cod_empresa = cl.cod_empresa'
        
          '           and trim(coalesce(cc.telefone, '#39#39')) = (select result ' +
          'from sonumeros(trim(coalesce(cl.fax, '#39#39'))))) = 0'
        '      union all'
        '      select cc.cod_cliente, cc.cod_empresa,'
        '      (select result from sonumeros(trim(cc.telefone))),'
        '      cc.tipo_id, tp.tipo, cc.id,'
        '      case when ((select count(*) from clientes_contato_env ce'
        '                  where ce.cod_cliente = cc.cod_cliente'
        '                  and ce.cod_empresa = cc.cod_empresa'
        '                  and ce.origem_env = :porigem'
        
          '                  and ce.id_contato = cc.id) > 0) then '#39'S'#39' else ' +
          #39'N'#39' end from clientes_contato cc'
        
          '      inner join tipo_contato tp on tp.id = cc.tipo_id and tp.co' +
          'd_empresa = cc.cod_empresa'
        '      where coalesce(cc.telefone, '#39#39') <> '#39#39
        '      and cc.cod_cliente = :pcod_cliente'
        '      and cc.cod_empresa = :pcod_empresa'
        
          '        into :cod_cliente, :cod_empresa, :fone, :id_tipo, :tipo,' +
          ' :id_contato, :env do'
        '  begin'
        '    suspend;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
          'update config_sistema cs set cs.display_ = '#39'Assunto e Mensagem p' +
          'adrao whatsapp boletos'#39' where cs.chave = '#39'boletos_mensagem_whats' +
          'app'#39';'
        
          'update config_sistema cs set cs.value1_vc = '#39'Assunto padrao'#39' whe' +
