inherited frmReestruturaVersao25: TfrmReestruturaVersao25
  Caption = 'frmReestruturaVersao25'
  ExplicitWidth = 1068
  ExplicitHeight = 596
  PixelsPerInch = 96
  TextHeight = 13
  inherited Panel1: TPanel
