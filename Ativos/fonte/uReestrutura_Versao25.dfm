        'CREATE TABLE P_CONTAS_CLIENTES ('
        
          '    N_CONTA_PLC  T_N_GERAL NOT NULL /* T_N_GERAL = DOUBLE PRECIS' +
          'ION DEFAULT 000.00 */,'
        '    CPFCGC       VARCHAR(18) NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE P_CONTAS_CLIENTES ADD CONSTRAINT PK_P_CONTAS_CLIENTE' +
          'S PRIMARY KEY (N_CONTA_PLC, CPFCGC);'
        ''
        
          'ALTER TABLE P_CONTAS_CLIENTES ADD CONSTRAINT FK_P_CONTAS_CLIENTE' +
          'S_P_CONTAS FOREIGN KEY (N_CONTA_PLC) REFERENCES P_CONTAS (N_CONT' +
          'A_PLC) ON DELETE CASCADE ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        'create or alter procedure SP_P_CONTAS_CLIENTE'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VN_CONTA_PLC double precision;'
        'declare variable VCPFCGC_FORNECEDOR varchar(18);'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'ERRO'#39';'
        '  for select n_conta_plc, cpfcgc_fornecedor from p_contas'
        '      where coalesce(cpfcgc_fornecedor, '#39#39') <> '#39#39
        '    into :vn_conta_plc, :vcpfcgc_fornecedor do'
        '  begin'
        
          '    update or insert into p_contas_clientes (n_conta_plc, cpfcgc' +
          ')'
        '    values (:vn_conta_plc, :vcpfcgc_fornecedor)'
        '    matching (n_conta_plc, cpfcgc);'
        ''
        '    update p_contas set cpfcgc_fornecedor = null'
        '    where n_conta_plc = :vn_conta_plc;'
        '  end'
        '  result = '#39'OK'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'execute procedure sp_p_contas_cliente;'
        ''
        
