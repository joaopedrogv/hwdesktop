          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT NOVA PO' +
          'LITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS340'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT EDITAR ' +
          'POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS341'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT MOVER P' +
          'OLITICA DE PAGAMENTO PARA A LIXEIRA'#39' WHERE COD_PROCESSO = '#39'BAS34' +
          '2'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT EXCLUIR' +
          ' POLITICA DE PAGAMENTO PERMANENTEMENTE'#39' WHERE COD_PROCESSO = '#39'BA' +
          'S343'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT ABRIR L' +
          'IXEIRA POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS344'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT RESTAUR' +
          'AR REGIST LIXEIRA POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'B' +
          'AS345'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT SALVAR ' +
          'POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS346'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'BT CANCELA' +
          'R POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS347'#39';'
        
          'CMD:REPL|UPDATE TABELA_PROCESSOS SET NOME_PROCESSO = '#39'ABRIR TELA' +
          ' DE CADASTRO POLITICA DE PAGAMENTO'#39' WHERE COD_PROCESSO = '#39'BAS348' +
          #39';'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_COND_PAG ('
        '    PCOND_PAG varchar(30))'
        'returns ('
        '    QTDE_PARC integer,'
        '    DIAS_PRAZO integer)'
        'as'
        'declare variable I integer;'
        'declare variable J integer;'
        'declare variable VTEMP varchar(30);'
        'begin'
        '  /* Procedure Text */'
        
          '  if  ((select result from pos('#39'X'#39', upper(:pcond_pag))) > 0) the' +
          'n'
        '  begin'
        
          '    vtemp = trim(substring(:pcond_pag from 1 for (select result ' +
          'from Pos('#39'X'#39', upper(:pcond_pag))) - 1));'
        
          '    if (char_length(trim(pcond_pag)) = (char_length(trim(vtemp))' +
          ' + 1)) then'
        '    begin'
        '      qtde_parc  = (select result from sonumeros (:vtemp));'
        '      dias_prazo = (30 * qtde_parc);'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        ''
        '  if ((select result from pos('#39'VISTA'#39', :pcond_pag)) > 0) then'
        '  begin'
        '    qtde_parc = 1;'
        '    dias_prazo = 0;'
        '    suspend;'
        '    exit;'
        '  end'
        
          '  else if ((select result from pos('#39'NENHUMA'#39', :pcond_pag)) > 0) ' +
          'then'
        '  begin'
        '    qtde_parc = 0;'
        '    dias_prazo = 0;'
        '    suspend;'
        '    exit;'
        '  end'
        '  else'
        '  begin'
        '    vtemp = '#39#39';'
        '    qtde_parc = 0;'
        '    i = 1;'
        '    j = char_length(trim(pcond_pag));'
        '    while (i <= j) do'
        '    begin'
        
          '      if ((select result from sonumeros (substring(:pcond_pag fr' +
          'om :i for 1))) <> '#39#39') then'
        '        vtemp = vtemp || substring(:pcond_pag from i for 1);'
        '      else if (trim(vtemp) <> '#39#39') then'
        '      begin'
        '        qtde_parc = qtde_parc + 1;'
        '        dias_prazo = cast(trim(vtemp) as Integer);'
        '        vtemp = '#39#39';'
        '      end'
        '      i = i + 1;'
        '    end'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE EFD_AJUSTES_CONF ('
        '    ID                CHAR(36) NOT NULL,'
        '    SEQ               INTEGER NOT NULL,'
        '    COD_EMPRESA       INTEGER NOT NULL,'
        '    DESCRICAO         VARCHAR(60) NOT NULL,'
        '    ATIVO             SMALLINT DEFAULT 1,'
        '    DATA_CADASTRO     TIMESTAMP,'
        '    DATA_MODIFICACAO  TIMESTAMP'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE EFD_AJUSTES_CONF ADD CONSTRAINT PK_EFD_AJUSTES_CONF ' +
          'PRIMARY KEY (ID, COD_EMPRESA);'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER EFD_AJUSTES_CONF_BI_ID FOR EFD_AJUSTES_C' +
          'ONF'
        'ACTIVE BEFORE INSERT POSITION 0'
        'as'
        'begin'
        '  if (coalesce(new.ID, '#39#39') = '#39#39') then'
        '    new.ID = (select GUID from SPDB_GUID);'
        '  if (coalesce(new.SEQ, 0) = 0) then'
        
          '    new.SEQ = coalesce((select max(SEQ) from EFD_AJUSTES_CONF wh' +
          'ere COD_EMPRESA = new.COD_EMPRESA), 0) + 1;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE EFD_AJUSTES_CONF_TIPO ('
        '    ID           CHAR(36) NOT NULL,'
        '    CONF_ID      CHAR(36) NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    TIPO         SMALLINT NOT NULL,'
        '    COD_OBS      INTEGER,'
        '    COD_AJUSTE   VARCHAR(10) NOT NULL,'
        '    ALIQUOTA     DOUBLE PRECISION,'
        '    CONF         BLOB SUB_TYPE 1 SEGMENT SIZE 512,'
        '    ATIVO        SMALLINT DEFAULT 1'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE EFD_AJUSTES_CONF_TIPO ADD CONSTRAINT PK_EFD_AJUSTES_' +
          'CONF_TIPO PRIMARY KEY (ID, COD_EMPRESA);'
        
          'ALTER TABLE EFD_AJUSTES_CONF_TIPO ADD CONSTRAINT FK_EFD_AJUSTES_' +
          'CONF_TIPO FOREIGN KEY (CONF_ID, COD_EMPRESA) REFERENCES EFD_AJUS' +
          'TES_CONF (ID, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        
          'ALTER TABLE EFD_AJUSTES_CONF_TIPO ADD CONSTRAINT FK_EFD_AJUSTES_' +
          'CONF_TIPO_OBS FOREIGN KEY (COD_OBS, COD_EMPRESA) REFERENCES SPED' +
          '_LANCAMENTO_FISCAL (COD_OBS, COD_EMPRESA) ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER EFD_AJUSTES_CONF_TIPO_BI_ID FOR EFD_AJUS' +
          'TES_CONF_TIPO'
        'ACTIVE BEFORE INSERT POSITION 0'
        'as'
        'begin'
        '  if (coalesce(new.ID, '#39#39') = '#39#39') then'
        '    new.ID = (select GUID from SPDB_GUID);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE EFD_AJUSTES_CONF_COND ('
        '    ID           CHAR(36) NOT NULL,'
        '    CONF_ID      CHAR(36) NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    TIPO         SMALLINT NOT NULL,'
        '    CONDICAO     VARCHAR(32) NOT NULL,'
        '    ALIQUOTA     DOUBLE PRECISION'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE EFD_AJUSTES_CONF_COND ADD CONSTRAINT PK_EFD_AJUSTES_' +
          'CONF_COND PRIMARY KEY (ID, COD_EMPRESA);'
        
          'ALTER TABLE EFD_AJUSTES_CONF_COND ADD CONSTRAINT FK_EFD_AJUSTES_' +
          'CONF_COND FOREIGN KEY (CONF_ID, COD_EMPRESA) REFERENCES EFD_AJUS' +
          'TES_CONF (ID, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER EFD_AJUSTES_CONF_COND_BI_ID FOR EFD_AJUS' +
