        '|BLOCO|'
        'CREATE TABLE SIT_PEDIDO_EC ('
        '    CODIGO            INTEGER NOT NULL,'
        '    STATUS_EC         VARCHAR(100) NOT NULL,'
        '    EXIBIR_AREA_ADM   CHAR(1) NOT NULL,'
        '    OPERACAO_PEDIDO   VARCHAR(16),'
        '    ATIVO             INTEGER DEFAULT 1'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE SIT_PEDIDO_EC ADD CONSTRAINT PK_SIT_PEDIDO_EC PRIMAR' +
          'Y KEY (CODIGO);'
        ''
        '|BLOCO|'
        'CREATE TABLE UNIDADES ('
        '   SIGLA                VARCHAR(6) NOT NULL,'
        '   DESCRICAO            VARCHAR(50) NOT NULL,'
        '   FRACIONADO           INTEGER NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE UNIDADES ADD CONSTRAINT PK_UNIDADES PRIMARY KEY (SIG' +
          'LA);'
        ''
        '|BLOCO|'
        'CREATE TABLE PRODUTOS_CONVERSAO_SAIDA ('
        '    GRUPO_PROD          INTEGER NOT NULL,'
        '    COD_PROD            VARCHAR(6) NOT NULL,'
        '    COD_EMPRESA         INTEGER NOT NULL,'
        '    UNIDADE             VARCHAR(6) NOT NULL,'
        '    QUANTIDADE          T_N_GERAL NOT NULL,'
        '    OPERACAO            CHAR(1),'
        '    DISPONIVEL_VENDA    CHAR(1),'
        '    PADRAO_VENDA        CHAR(1)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PRODUTOS_CONVERSAO_SAIDA ADD CONSTRAINT PK_PRODUTOS_' +
          'CONVER_SAIDA PRIMARY KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA, UNI' +
          'DADE);'
        ''
        
          'ALTER TABLE PRODUTOS_CONVERSAO_SAIDA ADD CONSTRAINT FK_PRODUTOS_' +
          'CONVER_SAID_PROD FOREIGN KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA)' +
          ' REFERENCES PRODUTOS (GRUPO_PROD, COD_PROD, COD_EMPRESA) ON DELE' +
          'TE CASCADE ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_PRODUTOS_CONVERSAO('
        '  GRUPO_PROD,'
        '  COD_PROD,'
        '  COD_EMPRESA,'
        '  CODIGO_EAN,'
        '  UNIDADE,'
        '  QUANTIDADE,'
        '  TIPO,'
        '  OPERACAO,'
        '  DISPONIVEL_VENDA,'
        '  PADRAO_VENDA)'
        'AS'
        '  select'
        '  grupo_prod, cod_prod,'
        '  cod_empresa,'
        '  codigo_ean,'
        '  unidade,'
        
          '  case when (coalesce(quantidade, 0) >= 1) then coalesce(quantid' +
          'ade, 0) else (1 / coalesce(quantidade, 0)) end quantidade,'
        '  '#39'EAN'#39' tipo,'
        
          '  case when (coalesce(quantidade, 0) >= 1) then '#39'Divisao'#39' else '#39 +
          'Multiplicacao'#39' end operacao,'
        '  '#39'N'#39' disponivel_venda,'
        '  '#39'N'#39' padrao_venda'
        '  from produtos_conversao'
        '  union'
        '  select'
        '  grupo_prod,'
        '  cod_prod,'
        '  cod_empresa,'
        '  '#39#39' codigo_ean,'
        '  unidade,'
        '  coalesce(quantidade, 0) quantidade,'
        '  '#39'Conversao'#39' tipo,'
        
          '  case when (operacao = '#39'D'#39') then '#39'Divisao'#39' else '#39'Multiplicacao'#39 +
          ' end operacao,'
        '  coalesce(disponivel_venda, '#39'N'#39') disponivel_venda,'
        '  coalesce(padrao_venda, '#39'N'#39') padrao_venda'
        '  from produtos_conversao_saida;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRODUTOS ADD INF_UNIDADE CHAR(1);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO446'#39', :COD_EMPRESA, '#39'BT' +
          ' ALTERAR UNIDADE PRODUTO'#39', 3, '#39'FRMCADPRODUTOS'#39', 1, '#39'N'#39', '#39'S'#39', CUR' +
          'RENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO447'#39', :COD_EMPRESA, '#39'BT' +
          ' NOVA UNIDADE'#39', 3, '#39'FRMCADPRODUTOS'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO448'#39', :COD_EMPRESA, '#39'BT' +
          ' EDITAR UNIDADE'#39', 3, '#39'FRMCADPRODUTOS'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DATE' +
          ');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO449'#39', :COD_EMPRESA, '#39'BT' +
          ' EXCLUIR UNIDADE'#39', 3, '#39'FRMCADPRODUTOS'#39', 1, '#39'N'#39', '#39'S'#39', CURRENT_DAT' +
          'E);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO450'#39', :COD_EMPRESA, '#39'BT' +
          ' ALTERAR CONVERSAO DE PRODUTO'#39', 3, '#39'FRMCADPRODUTOS'#39', 1, '#39'N'#39', '#39'S'#39 +
          ', CURRENT_DATE);'
        ''
        ''
        'ALTER TABLE PEDVENDA_PROD ADD UNIDADE_CONV VARCHAR(3);'
        'ALTER TABLE PEDVENDA_PROD ADD OPERACAO_CONV CHAR(1);'
        'ALTER TABLE PEDVENDA_PROD ADD FATOR_CONV T_N_GERAL;'
        ''
        ''
        'ALTER TABLE DEVOLUCAO ADD UNIDADE VARCHAR(6);'
        'ALTER TABLE DEVOLUCAO ADD UNIDADE_CONV VARCHAR(6);'
        'ALTER TABLE DEVOLUCAO ADD OPERACAO_CONV CHAR(1);'
        'ALTER TABLE DEVOLUCAO ADD FATOR_CONV T_N_GERAL;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_PROD_CONVERS_SAIDA_UN_PADRAO FOR PROD' +
          'UTOS_CONVERSAO_SAIDA'
        'ACTIVE AFTER UPDATE OR INSERT POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        ''
        '  if ((inserting) or (updating)) then'
        '  begin'
        '    if (coalesce(new.padrao_venda, '#39'N'#39') = '#39'S'#39') then'
        '    begin'
        '      update produtos_conversao_saida set padrao_venda = '#39'N'#39
        '      where grupo_prod = new.grupo_prod'
        '      and cod_prod = new.cod_prod'
        '      and cod_empresa = new.cod_empresa'
        '      and unidade <> new.unidade;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    ORIGEM_SERVICO,'
        '    NUM_FAB_PROD,'
        '    ID_KIT,'
        '    CODIGO_KIT,'
        '    DESCRICA0_KIT,'
        '    VALOR_UN_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT_LIQ,'
        '    VALOR_KIT_LIQ,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    UNIDADE_CONV,'
        '    QUANTIDADE_CONV,'
        '    VL_UNITARIO_CONV,'
        '    OPERACAO_CONV,'
        '    FATOR_CONV,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, null, pvp.num_fab_prod,'
        
          'pvp.id_kit, pvp.codigo_kit, case when (pvp.codigo_kit > 0) then ' +
          'k.descricao_kit else pvp.descr_prod_ped end descricao_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit_li' +
          'q,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_tot_kit_l' +
          'iq,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_acresc, 0)) from pedve' +
          'nda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_acresc_k' +
          'it,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_desc, 0)) from pedvend' +
          'a_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_desc_kit' +
          ','
        'pvp.unidade, pvp.descr_prod_ped, pvp.cod_grade,'
        'coalesce(pvp.quant_ped_item, 0) quant_ped_item,'
        'coalesce(pvp.vlun_ped_item, 0) vlun_ped_item,'
        'coalesce(pvp.vltot_ped_item, 0) vltot_ped_item,'
        
          'iif(trim(coalesce(pvp.unidade_conv, '#39#39')) <> '#39#39', trim(coalesce(pv' +
          'p.unidade_conv, '#39#39')), trim(coalesce(pvp.unidade, '#39#39'))),'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) * coalesce(pvp.fator_con' +
          'v, 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) / coalesce(pvp.fator_con' +
          'v, 0))'
        '     else'
        '       coalesce(pvp.quant_ped_item, 0)'
        'end quant_ped_item_conv,'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) / coalesce(pvp.fator_conv' +
          ', 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) * coalesce(pvp.fator_conv' +
          ', 0))'
        '     else'
        '       coalesce(pvp.vlun_ped_item, 0)'
        'end vlun_ped_item_conv,'
        'pvp.operacao_conv,'
        'pvp.fator_conv,'
        'coalesce(pvp.rateio_desc,0) as rateio_desc,'
        'coalesce(pvp.rateio_acresc,0) as rateio_acresc,'
        'p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join pedvenda pv on pv.nped = pvp.nped and pv.tipo = pvp.t' +
          'ipo and pv.cod_empresa = pvp.cod_empresa'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join kits_prod k on k.codigo_kit = pvp.codigo_kit and k.cod' +
          '_empresa = pvp.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||pvs.cod_servico, null, null, pvs.cod_servico, co' +
          'alesce(tp.stipo, '#39#39'), null,'
        
          'null, null, pvs.desc_serv_ped, null, null, null, null, null, nul' +
          'l,'
        'null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        'coalesce(pvs.valor_un_serv, 0) valor_un_serv,'
        'coalesce(pvs.valor_tot_serv, 0) valor_tot_serv,'
        'null, null, null, null, null,'
        'coalesce(pvs.rateio_desc,0) as rateio_desc,'
        'coalesce(pvs.rateio_acresc,0) as rateio_acresc,'
        'null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'inner join pedvenda pv on pv.nped = pvs.nped and pv.tipo = pvs.t' +
          'ipo and pv.cod_empresa = pvs.cod_empresa'
        'left join tipo_servico tp on tp.cod_servico = pvs.cod_servico'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', vpt.seqid,'
        'vpt.nped, '#39'PROD-T'#39', null, null, null, null, null,'
        'null, null, vpt.descricao, null, null, null, null, null, null,'
        'vpt.unidade, vpt.descricao, null, vpt.qtde,'
        'vpt.vl_unit, vpt.vl_total,'
        'null, null, null, null, null,'
        '0, 0, null, null, null, null, null, null, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39', vst.seqid,'
        'vst.nped, '#39'SERV-T'#39', null, null, null, null, null,'
        'null, null, vst.descr_servt, null, null, null, null, null, null,'
        'null, vst.descr_servt, null, 1,'
        'vst.vl_servt, vst.vl_servt,'
        'null, null, null, null, null, '
        '0, 0, null, null, null, null, null, null, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_DAV('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    IDENTIFICACAO_EMP,'
        '    NOME_EMP,'
        '    FANTASIA_EMP,'
        '    CGC_EMP,'
        '    IE_EMP,'
        '    TELEFONE_EMP,'
        '    EMAIL_EMP,'
        '    ENDERECO_COMPL_EMP,'
        '    ENDERECO_EMP,'
        '    CEP_EMP,'
        '    NUMERO_END_EMP,'
        '    COMPLEMENTO_END_EMP,'
        '    BAIRRO_EMP,'
        '    CIDADE_EMP,'
        '    ESTADO_EMP,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    RAZAO_CLIENTE,'
        '    CPFCGC,'
        '    INSC_EST,'
        '    FONE_CLIENTE,'
        '    FONE_CELULAR,'
        '    EMAIL,'
        '    ENDERECO_COMPL,'
        '    ENDERECO,'
        '    CEP,'
        '    BAIRRO,'
        '    CIDADE,'
        '    ESTADO,'
        '    COMPLEMENTO,'
        '    CONTATO,'
        '    DESC_COND_PAG,'
        '    VALOR_TOTAL,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    OBS_PED,'
        '    OBS_RED_OS,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NUM_FAB_PROD,'
        '    STATUS,'
        '    COD_GRADE,'
        '    GRADE,'
        '    STATUS_PED,'
        '    NPREVENDA,'
        '    NOME_RECEB,'
        '    FONE_RECEB,'
        '    CEP_RECEB,'
        '    END_RECEB,'
        '    BAIRRO_RECEB,'
        '    CIDA_RECEB,'
        '    DATA_FECH,'
        '    HORAFECHAMENTO,'
        '    MINFECHAMENTO,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    APLICACAO_PROD,'
        '    UNIDADE,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PROD_SERV,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    COD_VEICULO,'
        '    CHASSI,'
        '    PLACA,'
        '    COMBUST_VEIC,'
        '    KM_V,'
        '    COD_SERVICO,'
        '    ORIGEM_SERVICO,'
        '    APARELHO_PED,'
        '    NCM,'
        '    ORDEM,'
        '    NITEM,'
        '    COD_EQUIP,'
        '    DATA_PED,'
        '    CODIGO,'
        '    CIDA_AVL,'
        '    ESTA_AVL,'
        '    BAIRRO_AVL,'
        '    CEP_AVL,'
        '    NOME_CLI_ORC,'
        '    HORAABERTURA,'
        '    MINABERTURA,'
        '    CEP_DEST,'
        '    LOGRADOURO_DEST,'
        '    BAIRRO_DEST,'
        '    CIDADE_DEST,'
        '    ESTADO_DEST,'
        '    COMPLEMENTO_DEST,'
        '    DEST_SEQID,'
        '    LOCACAO_PROD,'
        '    LOCACAO_PROD_1,'
        '    LOC_DEP,'
        '    SELOS_REM,'
        '    SELOS_COL,'
        '    LACRES_REM,'
        '    LACRES_COL,'
        '    OBS_LIVRO_REG,'
        '    CODIGO_KIT,'
        '    DESCRICAO_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    MARCA_P,'
        '    DESCRICAO,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    ACRESCIMO_TOT,'
        '    DESCONTO_TOT,'
        '    CANCELADO,'
        '    PESO_BRUT_TOT,'
        '    DATA,'
        '    ANO_FAB,'
        '    COR,'
        '    MARCA_V,'
        '    MODELO_V,'
        '    PLACA_V,'
        '    RENAVAM,'
        '    COD_VENDEDOR,'
        '    NOME_VENDEDOR,'
        '    RG_VENDEDOR,'
        '    CPF_VENDEDOR,'
        '    USAR_LOGO,'
        '    TIPO_OS,'
        '    DESCRICAO_TV,'
        '    ID_KIT,'
        '    QUANT_KIT,'
        '    PESO_BRUT_PROD,'
        '    NUM_END_CLIENTE,'
        '    END_AVL,'
        '    VALOR_KIT_LIQ,'
        '    VALOR_UN_KIT_LIQ,'
        '    ACRESC_ITEM_PROD_TOT,'
        '    DESC_ITEM_PROD_TOT,'
        '    ACRESC_ITEM_SERV_TOT,'
        '    DESC_ITEM_SERV_TOT,'
        '    COD_US_FECH,'
        '    NOME_US_FECH,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2,'
        '    OBS_TPVENDA1,'
        '    OBS_TPVENDA2,'
        '    OBS_TPVENDA,'
        '    ESTADO_VEIC,'
        '    DEFEITO,'
        '    ACESSORIOS,'
        '    OBS_OS,'
        '    CODIGO_FOTO,'
        '    FOTO,'
        '    CODIGO_FOTO_EMP,'
        '    FOTO_EMP)'
        'AS'
        'SELECT PEDVENDA.NPED, PEDVENDA.TIPO, PEDVENDA.COD_EMPRESA,'
        
          ' EMPRESA.IDENTIFICACAO_EMP, EMPRESA.NOME_EMP, EMPRESA.FANTASIA_E' +
          'MP, EMPRESA.CGC_EMP, EMPRESA.IE_EMP,'
        ' EMPRESA.TELEFONE_EMP, EMPRESA.EMAIL_EMP,'
        ' (coalesce(EMPRESA.ENDRECO_EMP, '#39#39') ||'
        
          '    iif(coalesce(EMPRESA.NUMERO_END, 0) > 0, '#39', N: '#39' || coalesce' +
          '(EMPRESA.NUMERO_END, 0), '#39#39') ||'
        
          '    iif((trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')) <> '#39#39'), '#39', ' +
          #39' || trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CEP_EMP, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(EMPRESA.CEP_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CIDADE_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.CIDADE_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ' ) ENDERECO_COMPL_EMP,'
        
          ' EMPRESA.ENDRECO_EMP, EMPRESA.CEP_EMP, EMPRESA.NUMERO_END, EMPRE' +
          'SA.COMPLEMENTO_EMP,'
        
          ' EMPRESA.BAIRRO_EMP, EMPRESA.CIDADE_EMP, ESTEMP.SIGLA_UF ESTADO_' +
          'EMP,'
        
          ' CLIENTES.COD_CLIENTE, CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, CL' +
          'IENTES.CPFCGC, CLIENTES.INSC_EST,'
        ' CLIENTES.FONE_CLIENTE, CLIENTES.FONE_CELULAR, CLIENTES.EMAIL,'
        ' (coalesce(CLIENTES.ENDERECO, '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')) <> '#39#39', '#39', N' +
          ': '#39' || trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')), '#39#39') ||'
        
          '    iif((trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')) <> '#39#39'), '#39', '#39' |' +
          '| trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.CEP, '#39#39')) <> '#39#39', '#39', '#39' || trim(coa' +
          'lesce(CLIENTES.CEP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(BAICL.NOME_BAIRRO, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(BAICL.NOME_BAIRRO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CIDCL.NOME_CIDADE, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(CIDCL.NOME_CIDADE, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ') ENDERECO_COMPL_CL,'
        
          ' CLIENTES.ENDERECO, CLIENTES.CEP, BAICL.NOME_BAIRRO, CIDCL.NOME_' +
          'CIDADE, ESTCL.SIGLA_UF ESTADO,'
        ' CLIENTES.COMPLEMENTO, CLIENTES.CONTATO,'
        ' COND_PAG.DESC_COND_PAG,'
        
          ' PEDVENDA.VALOR_TOTAL, PEDVENDA.TOT_PROD, PEDVENDA.TOT_SERV, PED' +
          'VENDA.TOT_PROD_TERC, PEDVENDA.TOT_SERV_TERC,'
        ' PEDVENDA.OBS_PED, PEDVENDA.OBS_RED_OS, '
        
          ' ORCAMENTO4.GRUPO_PROD, ORCAMENTO4.COD_PROD, ORCAMENTO4.NUM_FAB_' +
          'PROD,  ORCAMENTO4.STATUS, ORCAMENTO4.COD_GRADE, GRADE.DESCRICAO,'
        ' PEDVENDA.STATUS_PED, PEDVENDA.NPREVENDA,'
        
          ' PEDVENDA.NOME_RECEB, PEDVENDA.FONE_RECEB, PEDVENDA.CEP_RECEB, P' +
          'EDVENDA.END_RECEB, PEDVENDA.BAIRRO_RECEB, PEDVENDA.CIDA_RECEB,'
        
          ' PEDVENDA.DATA_FECH, PEDVENDA.HORAFECHAMENTO, PEDVENDA.MINFECHAM' +
          'ENTO,'
        
          ' CASE WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) = '#39#39') TH' +
          'EN'
        '        ORCAMENTO4.QUANTIDADE'
        
          '      WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39')) = TRIM(COALES' +
          'CE(ORCAMENTO4.UNIDADE_CONV, '#39#39'))) THEN'
        '        ORCAMENTO4.QUANTIDADE'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'M'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.QUANTIDADE_CONV'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'D'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.QUANTIDADE_CONV'
        '      ELSE'
        '        ORCAMENTO4.QUANTIDADE'
        ' END QUANTIDADE,'
        
          ' CASE WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) = '#39#39') TH' +
          'EN'
        '        ORCAMENTO4.VL_UNITARIO'
        
          '      WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39')) = TRIM(COALES' +
          'CE(ORCAMENTO4.UNIDADE_CONV, '#39#39'))) THEN'
        '        ORCAMENTO4.VL_UNITARIO'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'M'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.VL_UNITARIO_CONV'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'D'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.VL_UNITARIO_CONV'
        '      ELSE'
        '        ORCAMENTO4.VL_UNITARIO'
        ' END VL_UNITARIO,'
        ' ORCAMENTO4.VL_TOTAL_ITEM, PRODUTOS.APLICACAO_PROD,'
        ' IIF(TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) <> '#39#39','
        '    TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')),'
        '    TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39'))) UNIDADE,'
        
          ' ORCAMENTO4.RATEIO_DESC, ORCAMENTO4.RATEIO_ACRESC, ORCAMENTO4.PR' +
          'OD_SERV,'
        
          ' ORCAMENTO4.COD_TECNICO_MECAN, ORCAMENTO4.NOME_TECNICO_MECAN, OR' +
          'CAMENTO4.COD_TECNICO_MECAN2, ORCAMENTO4.NOME_TECNICO_MECAN2,'
        
          ' DADOS_VEICULO.CODIGO, DADOS_VEICULO.CHASSI, DADOS_VEICULO.PLACA' +
          ', PEDVENDA.COMBUST_VEIC, PEDVENDA.KM_V, ORCAMENTO4.COD_SERVICO, ' +
          'ORCAMENTO4.ORIGEM_SERVICO, PEDVENDA.APARELHO_PED,'
        ' ORCAMENTO4.NCM, ORCAMENTO4.ORDEM, ORCAMENTO4.NITEM,'
        
          ' PEDVENDA.COD_EQUIP, PEDVENDA.DATA_PED, FOTOS.CODIGO, PEDVENDA.C' +
          'IDA_AVL, PEDVENDA.ESTA_AVL, PEDVENDA.BAIRRO_AVL, PEDVENDA.CEP_AV' +
          'L,'
        
          ' PEDVENDA.NOME_CLI_ORC, PEDVENDA.HORAABERTURA, PEDVENDA.MINABERT' +
          'URA,'
        
          ' VW_CLIENTES_DEST.CEP, VW_CLIENTES_DEST.LOGRADOURO, VW_CLIENTES_' +
          'DEST.BAIRRO, VW_CLIENTES_DEST.CIDADE, VW_CLIENTES_DEST.UF, VW_CL' +
          'IENTES_DEST.COMPLEMENTO, PEDVENDA.DEST_SEQID,'
        
          ' PRODUTOS.LOCACAO_PROD, PRODUTOS.LOCACAO_PROD_1, PRODUTOS.LOC_DE' +
          'P,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_REM, PEDVENDA_ATIVIDADES_REPAR' +
          'P.SELOS_COL, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM, PEDVENDA_ATI' +
          'VIDADES_REPARP.LACRES_COL,'
        
          ' PEDVENDA.OBS_LIVRO_REG, ORCAMENTO4.CODIGO_KIT, ORCAMENTO4.DESCR' +
          'ICA0_KIT, ORCAMENTO4.VALOR_KIT, ORCAMENTO4.VALOR_UN_KIT, ORCAMEN' +
          'TO4.RATEIO_ACRESC_KIT, ORCAMENTO4.RATEIO_DESC_KIT,'
        
          ' ORCAMENTO4.MARCA_P, ORCAMENTO4.DESCRICAO, TOTAIS_PEDVENDA.QUANT' +
          '_PED_ITEM, TOTAIS_PEDVENDA.QUANT_SERV_PED,'
        
          ' TOTAIS_PEDVENDA.ACRESCIMO, TOTAIS_PEDVENDA.DESCONTO, TOTAIS_PED' +
          'VENDA.CANCELADO, TOTAIS_PEDVENDA.PESO_BRUT_PROD, VALOR_VENC_MIN.' +
          'DATA,'
        
          ' DADOS_VEICULO.ANOFAB, DADOS_VEICULO.COR, DADOS_VEICULO.MARCA, D' +
          'ADOS_VEICULO.MODELO, DADOS_VEICULO.PLACA, DADOS_VEICULO.RENAVAM,'
        
          ' COLABORADOR.COD_VENDEDOR, COLABORADOR.NOME_VENDEDOR, COLABORADO' +
          'R.RG_VENDEDOR, COLABORADOR.CPF_VENDEDOR, FOTOS_EMP.USAR_LOGO, PE' +
          'DVENDA.TIPO_OS, TIPO_VENDAS.DESCRICAO,'
        
          ' ORCAMENTO4.ID_KIT, TOTAIS_PEDVENDA.QUANT_KIT, PRODUTOS.PESO_BRU' +
          'T_PROD,'
        ' CLIENTES.NUM_END_CLIENTE, PEDVENDA.END_AVL,'
        
          ' ORCAMENTO4.VALOR_KIT_LIQ, ORCAMENTO4.VALOR_UN_KIT_LIQ, TOTAIS_P' +
          'EDVENDA.ACRESC_ITEM_PROD, TOTAIS_PEDVENDA.DESC_ITEM_PROD, TOTAIS' +
          '_PEDVENDA.ACRESC_ITEM_SERV,'
        
          ' TOTAIS_PEDVENDA.DESC_ITEM_SERV, PEDVENDA.COD_US_FECH, COLABORAD' +
          'OR_1.NOME_VENDEDOR,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_COL1, PEDVENDA_ATIVIDADES_REPA' +
          'RP.SELOS_COL2, PEDVENDA_ATIVIDADES_REPARP.SELOS_REM1, PEDVENDA_A' +
          'TIVIDADES_REPARP.SELOS_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.LACRES_COL1, PEDVENDA_ATIVIDADES_REP' +
          'ARP.LACRES_COL2, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM1, PEDVEND' +
          'A_ATIVIDADES_REPARP.LACRES_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA1, PEDVENDA_ATIVIDADES_RE' +
          'PARP.OBS_TPVENDA2, PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA, PEDVE' +
          'NDA.ESTADO_VEIC, PEDVENDA.DEFEITO,'
        
          ' PEDVENDA.ACESSORIOS, PEDVENDA.OBS_OS, FOTOS.CODIGO, FOTOS.FOTO,' +
          ' FOTOS_EMP.CODIGO, FOTOS_EMP.FOTO'
        ''
        ' FROM PEDVENDA'
        
          ' LEFT JOIN TOTAIS_PEDVENDA ON TOTAIS_PEDVENDA.NPED=PEDVENDA.NPED' +
          ' AND TOTAIS_PEDVENDA.TIPO=PEDVENDA.TIPO AND TOTAIS_PEDVENDA.COD_' +
          'EMPRESA=PEDVENDA.COD_EMPRESA'
        
          ' LEFT JOIN PEDVENDA_ATIVIDADES_REPARP ON PEDVENDA_ATIVIDADES_REP' +
          'ARP.NPED=PEDVENDA.NPED AND PEDVENDA_ATIVIDADES_REPARP.TIPO=PEDVE' +
          'NDA.TIPO AND PEDVENDA_ATIVIDADES_REPARP.COD_EMPRESA=PEDVENDA.COD' +
          '_EMPRESA'
        
          ' LEFT JOIN CLIENTES ON PEDVENDA.COD_CLIENTE=CLIENTES.COD_CLIENTE' +
          ' AND PEDVENDA.COD_EMPRESA=CLIENTES.COD_EMPRESA'
        ' LEFT JOIN EMPRESA ON PEDVENDA.COD_EMPRESA=EMPRESA.COD_EMPRESA'
        ' LEFT JOIN ESTADOS ESTEMP ON ESTEMP.CODIGO_UF = EMPRESA.UF_EMP'
        
          ' LEFT JOIN COND_PAG ON PEDVENDA.COD_COND_PAG=COND_PAG.COD_COND_P' +
          'AG'
        
          ' LEFT JOIN COLABORADOR ON PEDVENDA.COD_VENDEDOR=COLABORADOR.COD_' +
          'VENDEDOR AND PEDVENDA.COD_EMPRESA=COLABORADOR.COD_EMPRESA'
        
          ' LEFT JOIN ORCAMENTO4 ON PEDVENDA.NPED=ORCAMENTO4.NPED AND PEDVE' +
          'NDA.COD_EMPRESA=ORCAMENTO4.COD_EMPRESA AND PEDVENDA.TIPO=ORCAMEN' +
          'TO4.TIPO'
        
          ' LEFT JOIN VW_CLIENTES_DEST ON PEDVENDA.COD_CLIENTE=VW_CLIENTES_' +
          'DEST.COD_CLIENTE AND PEDVENDA.COD_EMPRESA=VW_CLIENTES_DEST.COD_E' +
          'MPRESA AND PEDVENDA.DEST_SEQID=VW_CLIENTES_DEST.DEST_SEQID'
        
          ' LEFT JOIN VALOR_VENC_MIN ON PEDVENDA.NPED=VALOR_VENC_MIN.NPED A' +
          'ND PEDVENDA.COD_EMPRESA=VALOR_VENC_MIN.COD_EMPRESA AND PEDVENDA.' +
          'TIPO=VALOR_VENC_MIN.TIPO'
        
          ' LEFT JOIN DADOS_VEICULO ON PEDVENDA.NPED=DADOS_VEICULO.NPED AND' +
          ' PEDVENDA.COD_EMPRESA=DADOS_VEICULO.COD_EMPRESA AND PEDVENDA.TIP' +
          'O=DADOS_VEICULO.TIPO'
        
          ' LEFT JOIN FOTOS_EMP ON PEDVENDA.COD_EMPRESA=FOTOS_EMP.COD_EMPRE' +
          'SA'
        
          ' LEFT JOIN TIPO_VENDAS ON PEDVENDA.TIPO=TIPO_VENDAS.TIPO AND PED' +
          'VENDA.TIPV=TIPO_VENDAS.SIGLA'
        
          ' LEFT JOIN COLABORADOR COLABORADOR_1 ON PEDVENDA.COD_EMPRESA=COL' +
          'ABORADOR_1.COD_EMPRESA AND PEDVENDA.COD_US_FECH=COLABORADOR_1.CO' +
          'D_VENDEDOR'
        
          ' LEFT JOIN GRADE ON ORCAMENTO4.COD_EMPRESA=GRADE.COD_EMPRESA AND' +
          ' ORCAMENTO4.COD_GRADE=GRADE.COD_GRADE'
        
          ' LEFT JOIN PRODUTOS ON ORCAMENTO4.GRUPO_PROD=PRODUTOS.GRUPO_PROD' +
          ' AND ORCAMENTO4.COD_EMPRESA=PRODUTOS.COD_EMPRESA AND ORCAMENTO4.' +
          'COD_PROD=PRODUTOS.COD_PROD'
        
          ' LEFT JOIN FOTOS ON ORCAMENTO4.NPED=FOTOS.CODIGO AND ORCAMENTO4.' +
          'COD_EMPRESA=FOTOS.COD_EMPRESA AND ORCAMENTO4.GRUPO_PROD=FOTOS.GR' +
          'UPO_PROD AND ORCAMENTO4.COD_PROD=FOTOS.COD_PROD AND ORCAMENTO4.C' +
          'OD_GRADE=FOTOS.COD_GRADE AND ORCAMENTO4.TIPO_FOTO=FOTOS.TIPO'
        
          ' LEFT JOIN CIDADES CIDCL ON CIDCL.COD_CIDADE = CLIENTES.COD_CIDA' +
          'DE'
        
          ' LEFT JOIN BAIRROS BAICL ON BAICL.COD_BAIRRO = CLIENTES.COD_BAIR' +
          'RO'
        
          ' LEFT JOIN ESTADOS ESTCL ON ESTCL.CODIGO_UF = CLIENTES.CODIGO_UF' +
          ';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW VW_PRODUTOS_CONVERSAO('
        '  GRUPO_PROD,'
        '  COD_PROD,'
        '  COD_EMPRESA,'
        '  CODIGO_EAN,'
        '  UNIDADE,'
        '  QUANTIDADE,'
        '  TIPO,'
        '  OPERACAO,'
        '  DISPONIVEL_VENDA,'
        '  PADRAO_VENDA)'
        'AS'
        '  select'
        '  grupo_prod, cod_prod,'
        '  cod_empresa,'
        '  codigo_ean,'
        '  unidade,'
        
          '  case when (coalesce(quantidade, 0) >= 1) then coalesce(quantid' +
          'ade, 0) else (1 / coalesce(quantidade, 0)) end quantidade,'
        '  '#39'EAN'#39' tipo,'
        
          '  case when (coalesce(quantidade, 0) >= 1) then '#39'Divisao'#39' else '#39 +
          'Multiplicacao'#39' end operacao,'
        '  '#39'N'#39' disponivel_venda,'
        '  '#39'N'#39' padrao_venda'
        '  from produtos_conversao'
        '  union'
        '  select'
        '  grupo_prod,'
        '  cod_prod,'
        '  cod_empresa,'
        '  '#39#39' codigo_ean,'
        '  unidade,'
        '  coalesce(quantidade, 0) quantidade,'
        '  '#39'Conversao'#39' tipo,'
        
          '  case when (operacao = '#39'D'#39') then '#39'Divisao'#39' else '#39'Multiplicacao'#39 +
          ' end operacao,'
        '  coalesce(disponivel_venda, '#39'N'#39') disponivel_venda,'
        '  coalesce(padrao_venda, '#39'N'#39') padrao_venda'
        '  from produtos_conversao_saida;'
        '|/BLOCO|'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SP_GET_OPFISCAL_LOTE'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure FLOATTOSTR ('
        '    VALOR double precision,'
        '    CDECIMAL smallint = 2)'
        'returns ('
        '    RESULTADO varchar(64))'
        'as'
        'begin'
        '  resultado = '#39#39' || round(coalesce(valor, 0), cdecimal);'
        ''
        
          '  while (substring(resultado from char_length(resultado) for 1) ' +
          '= '#39'0'#39') do'
        
          '    resultado = substring(resultado from 1 for char_length(resul' +
          'tado) - 1);'
        ''
        
          '  if (substring(resultado from char_length(resultado) for 1) = '#39 +
          '.'#39') then'
        
          '    resultado = substring(resultado from 1 for char_length(resul' +
          'tado) - 1);'
        ''
        '  resultado = replace(resultado, '#39'.'#39', '#39','#39');'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_PROD_FATOR('
        '    NPED,'
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NITEM,'
        '    COD_EMPRESA,'
        '    COD_GRADE,'
        '    CODIGO_NOP,'
        '    QCOM,'
        '    VUNCOM,'
        '    VPROD,'
        '    UCOM,'
        '    UVND,'
        '    VPRODNF,'
        '    UVND_FATOR,'
        '    PARIDADE,'
        '    QVND,'
        '    VVND,'
        '    VVNDNF)'
        'AS'
        
          'select D.NPED, D.TIPO, D.GRUPO_PROD, D.COD_PROD, D.NITEM, D.COD_' +
          'EMPRESA, D.COD_GRADE, D.CODIGO_NOP, D.QCOM, D.VUNCOM,'
        
          '       D.VPROD, D.UCOM, D.UVND, D.VPRODNF, D.UVND_FATOR, D.PARID' +
          'ADE, D.QVND,'
        '       (D.VPROD / D.QVND) VVND,'
        '       (D.VPRODNF / D.QVND) VVNDNF'
        
          'from (select C.NPED, C.TIPO, C.GRUPO_PROD, C.COD_PROD, C.NITEM, ' +
          'C.COD_EMPRESA, C.COD_GRADE, C.CODIGO_NOP, C.QCOM,'
        
          '             C.VUNCOM, C.VPROD, C.UCOM, C.UVND, C.VPRODNF, C.UVN' +
          'D_FATOR,'
        '             case'
        '               when C.UVND_FATOR > 1 then (select RESULTADO'
        
          '                                           from FLOATTOSTR(C.UVN' +
          'D_FATOR, 4)) || '#39' '#39' || C.UVND || '#39' = 1 '#39' || C.UCOM'
        
          '               when C.UVND_FATOR > 0 then '#39'1 '#39' || C.UVND || '#39' = ' +
          #39' ||(select RESULTADO'
        
          '                                                                ' +
          '    from FLOATTOSTR(1 / C.UVND_FATOR, 4)) || '#39' '#39' || C.UCOM'
        '               else '#39'1 '#39' || C.UVND || '#39' = 1 '#39' || C.UCOM'
        '             end PARIDADE,'
        '             (C.QCOM * C.UVND_FATOR) QVND'
        
          '      from (select PP.NPED, PP.TIPO, PP.GRUPO_PROD, PP.COD_PROD,' +
          ' PP.NITEM, PP.COD_EMPRESA, PP.COD_GRADE, PP.CODIGO_NOP,'
        
          '                   PP.QUANT_PED_ITEM QCOM, PP.VLUN_PED_ITEM VUNC' +
          'OM, PP.VLTOT_PED_ITEM VPROD, PP.UNIDADE UCOM,'
        
          '                   coalesce(PP.UNIDADE_CONV, PP.UNIDADE) UVND, P' +
          'P.VLTOT_PED_NF VPRODNF,'
        '                   case'
        
          '                     when PP.OPERACAO_CONV = '#39'D'#39' then 1 / PP.FAT' +
          'OR_CONV'
        
          '                     when PP.OPERACAO_CONV = '#39'M'#39' then 1 * PP.FAT' +
          'OR_CONV'
        '                     else 1'
        '                   end UVND_FATOR'
        '            from PEDVENDA_PROD PP'
        '            order by PP.NPED desc, PP.NITEM desc) as C) as D;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    ACRESC_ITEM_PROD,'
        '    DESC_ITEM_PROD,'
        '    ACRESC_ITEM_SERV,'
        '    DESC_ITEM_SERV,'
        '    VALOR_TOTAL,'
        '    VALOR_BRUTO,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  coalesce('
        
          '   coalesce((select sum(case when (trim(coalesce(pp.unidade_conv' +
          ', '#39#39')) = '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '             where pp.nped = pedvenda.nped'
        '             and pp.tipo = pedvenda.tipo'
        '             and pp.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '   coalesce((select sum(coalesce(ppt.qtde, 0)) from pedvenda_pro' +
          'd_terc ppt'
        '             where ppt.nped = pedvenda.nped'
        '             and ppt.tipo = pedvenda.tipo'
        '             and ppt.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_ped_item,'
        ''
        '  coalesce('
        
          '   coalesce((select sum(coalesce(ps.quant_serv_ped, 0)) from ped' +
          'venda_serv ps'
        '             where ps.nped = pedvenda.nped'
        '             and ps.tipo = pedvenda.tipo'
        '             and ps.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(ps.status, '#39#39') = '#39#39'), 0) +'
        '   coalesce((select count(*) from pedvenda_serv_terc pst'
        '             where pst.nped = pedvenda.nped'
        '             and pst.tipo = pedvenda.tipo'
        '             and pst.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_serv_ped,'
        ''
        
          '  coalesce((select coalesce(qtde, 0) from retorna_qtde_kit(pedve' +
          'nda.nped, pedvenda.tipo, pedvenda.cod_empresa)), 0) quant_kit,'
        ''
        '  coalesce(pedvenda.tot_prod, 0) TOT_PROD,'
        '  coalesce(pedvenda.tot_serv, 0) TOT_SERV,'
        '  coalesce(pedvenda.tot_prod_terc, 0) TOT_PROD_TERC,'
        '  coalesce(pedvenda.tot_serv_terc, 0) TOT_SERV_TERC,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedve' +
          'nda_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_PRO' +
          'D,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedvend' +
          'a_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) DESC_ITEM_PROD,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from pedve' +
          'nda_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_SER' +
          'V,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedvend' +
          'a_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) DESC_ITEM_SERV,'
        ''
        '  coalesce(pedvenda.valor_total, 0) VALOR_TOTAL,'
        
          '  (coalesce(pedvenda.tot_prod, 0) + coalesce(pedvenda.tot_serv, ' +
          '0) + coalesce(pedvenda.tot_prod_terc, 0) + coalesce(pedvenda.tot' +
          '_serv_terc, 0)) VALOR_BRUTO,'
        ''
        
          '  (coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedv' +
          'enda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from ped' +
          'venda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '   (coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0)) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable VTEMP double precision;'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        
          '  for select distinct coalesce(pp.id_kit, 0) from pedvenda_prod ' +
          'pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        
          '  for select sum(case when (trim(coalesce(pp.unidade_conv, '#39#39')) ' +
          '= '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '      and coalesce(pp.codigo_kit, 0) <= 0'
        '      union'
        
          '      select sum(coalesce(ppt.qtde, 0)) from pedvenda_prod_terc ' +
          'ppt'
        '      where ppt.nped = :nped'
        '      and ppt.tipo = :tipo'
        '      and ppt.cod_empresa = :cod_empresa'
        '          into :vtemp do'
        '  begin'
        '    qtde_prod = qtde_prod + vtemp;'
        '  end'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE IMAGENS_DOC ADD MD5 VARCHAR(32);'
        
          'ALTER TABLE IMAGENS_DOC ADD URL BLOB SUB_TYPE 1 SEGMENT SIZE 256' +
          ';'
        ''
        'CREATE INDEX IDX_IMAGENS_DOC_MD5 ON IMAGENS_DOC (MD5, COD_IMG);'
        ''
        '|BLOCO|'
        'CREATE TABLE PRODUTOS_GRADE_IMAGENS ('
        '    GRUPO_PROD   INTEGER NOT NULL,'
        '    COD_PROD     CHAR(6) NOT NULL,'
        '    COD_GRADE    INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    COD_IMG      INTEGER NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PRODUTOS_GRADE_IMAGENS ADD CONSTRAINT PK_PRODUTOS_GR' +
          'ADE_IMAGENS PRIMARY KEY (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EM' +
          'PRESA, COD_IMG);'
        ''
        
          'ALTER TABLE PRODUTOS_GRADE_IMAGENS ADD CONSTRAINT FK_PRODUTOS_GR' +
          'ADE_IMAGENS_PROD FOREIGN KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA)' +
          ' REFERENCES PRODUTOS (GRUPO_PROD, COD_PROD, COD_EMPRESA) ON DELE' +
          'TE CASCADE ON UPDATE CASCADE;'
        
          'ALTER TABLE PRODUTOS_GRADE_IMAGENS ADD CONSTRAINT FK_PRODUTOS_GR' +
          'ADE_IMAGENS_GRADE FOREIGN KEY (COD_GRADE, COD_EMPRESA) REFERENCE' +
          'S GRADE (COD_GRADE, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CAS' +
          'CADE;'
        ''
        '|BLOCO|'
        'CREATE TABLE KITS_PROD_IMAGENS ('
        '    CODIGO_KIT   INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    COD_IMG      INTEGER NOT NULL'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE KITS_PROD_IMAGENS ADD CONSTRAINT PK_KITS_IMAGENS PRI' +
          'MARY KEY (CODIGO_KIT, COD_EMPRESA, COD_IMG);'
        ''
        
          'ALTER TABLE KITS_PROD_IMAGENS ADD CONSTRAINT FK_KITS_PROD_IMAGEN' +
          'S_KIT FOREIGN KEY (CODIGO_KIT, COD_EMPRESA) REFERENCES KITS_PROD' +
          ' (CODIGO_KIT, COD_EMPRESA) ON DELETE CASCADE ON UPDATE CASCADE;'
        ''
        
          'CREATE INDEX IDX_CONTAS_A_PAGAR_IMAGENS_IMG ON CONTAS_A_PAGAR_IM' +
          'AGENS (COD_IMG,COD_EMPRESA);'
        
          'CREATE INDEX IDX_LOTE_LANC_IMAGENS_IMG ON LOTE_LANC_IMAGENS (COD' +
          '_IMG,CODIGO_EMP);'
        
          'CREATE INDEX IDX_PRODUTOS_GRADE_IMAGENS_IMG ON PRODUTOS_GRADE_IM' +
          'AGENS (COD_IMG, COD_EMPRESA);'
        
          'CREATE INDEX IDX_KITS_PROD_IMAGENS_IMG ON KITS_PROD_IMAGENS (COD' +
          '_IMG, COD_EMPRESA);'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_IMG_PROD ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    GRUPO_PROD integer,'
        '    COD_PROD char(10),'
        '    COD_GRADE integer,'
        '    COD_EMPRESA integer,'
        '    LISTA_IMAGENS blob sub_type 1 segment size 256,'
        '    URL_IMAGENS blob sub_type 1 segment size 256,'
        '    COD_IMAGENS blob sub_type 1 segment size 256)'
        'as'
        'declare variable VIMAGEM blob sub_type 1 segment size 256;'
        'declare variable VURL blob sub_type 1 segment size 256;'
        'declare variable VCOD_IMG integer;'
        'begin'
        '  /* Procedure Text */'
        '  grupo_prod    = pgrupo_prod;'
        '  cod_prod      = pcod_prod;'
        '  cod_grade     = pcod_grade;'
        '  cod_empresa   = pcod_empresa;'
        '  lista_imagens = null;'
        '  url_imagens   = null;'
        '  cod_imagens   = null;'
        ''
        '  select lista_imagens, url_imagens from produtos_imagens'
        '  where grupo_prod = :pgrupo_prod'
        '  and cod_prod = :pcod_prod'
        '  and cod_grade = :pcod_grade'
        '  and cod_empresa = :pcod_empresa'
        '    into :lista_imagens, :url_imagens;'
        ''
        '  if (trim(coalesce(lista_imagens, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select img.imagem, img.url, img.cod_img from produtos_gr' +
          'ade_imagens pimg'
        '        inner join imagens_doc img on'
        '          img.cod_img = pimg.cod_img'
        '          and img.cod_empresa = pimg.cod_empresa'
        '        where pimg.grupo_prod = :pgrupo_prod'
        '        and pimg.cod_prod = :pcod_prod'
        '        and pimg.cod_grade = :pcod_grade'
        '        and pimg.cod_empresa = :pcod_empresa'
        '          into :vimagem, :vurl, :vcod_img do'
        '    begin'
        '      if (trim(coalesce(lista_imagens, '#39#39')) = '#39#39') then'
        '        lista_imagens = :vimagem;'
        '      else'
        
          '        lista_imagens = lista_imagens || ASCII_CHAR(13) || :vima' +
          'gem;'
        ''
        '      if (trim(coalesce(url_imagens, '#39#39')) = '#39#39') then'
        
          '        url_imagens = iif(trim(coalesce(vurl, '#39#39')) = '#39#39', '#39'sem ur' +
          'l'#39', :vurl);'
        '      else'
        
          '        url_imagens = url_imagens || ASCII_CHAR(13) || iif(trim(' +
          'coalesce(vurl, '#39#39')) = '#39#39', '#39'sem url'#39', :vurl);'
        ''
        '      if (trim(coalesce(cod_imagens, '#39#39')) = '#39#39') then'
        '        cod_imagens = :vcod_img;'
        '      else'
        
          '        cod_imagens = cod_imagens || ASCII_CHAR(13) || :vcod_img' +
          ';'
        '    end'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_IMG_KIT ('
        '    PCODIGO_KIT integer,'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    CODIGO_KIT integer,'
        '    COD_EMPRESA integer,'
        '    LISTA_IMAGENS blob sub_type 1 segment size 256,'
        '    URL_IMAGENS blob sub_type 1 segment size 256,'
        '    COD_IMAGENS blob sub_type 1 segment size 256)'
        'as'
        'declare variable VIMAGEM blob sub_type 1 segment size 256;'
        'declare variable VURL blob sub_type 1 segment size 256;'
        'declare variable VCOD_IMG integer;'
        'begin'
        '  /* Procedure Text */'
        '  codigo_kit    = pcodigo_kit;'
        '  cod_empresa   = pcod_empresa;'
        '  lista_imagens = null;'
        '  url_imagens   = null;'
        '  cod_imagens   = null;'
        ''
        '  select lista_imagens, url_imagens from kits_prod'
        '  where codigo_kit = :pcodigo_kit'
        '  and cod_empresa = :pcod_empresa'
        '    into :lista_imagens, :url_imagens;'
        ''
        '  if (trim(coalesce(lista_imagens, '#39#39')) = '#39#39') then'
        '  begin'
        
          '    for select img.imagem, img.url, img.cod_img from kits_prod_i' +
          'magens pimg'
        '        inner join imagens_doc img on'
        '          img.cod_img = pimg.cod_img'
        '          and img.cod_empresa = pimg.cod_empresa'
        '        where pimg.codigo_kit = :pcodigo_kit'
        '        and pimg.cod_empresa = :pcod_empresa'
        '          into :vimagem, :vurl, :vcod_img do'
        '    begin'
        '      if (trim(coalesce(lista_imagens, '#39#39')) = '#39#39') then'
        '        lista_imagens = :vimagem;'
        '      else'
        
          '        lista_imagens = lista_imagens || ASCII_CHAR(13) || :vima' +
          'gem;'
        ''
        '      if (trim(coalesce(url_imagens, '#39#39')) = '#39#39') then'
        
          '        url_imagens = iif(trim(coalesce(vurl, '#39#39')) = '#39#39', '#39'sem ur' +
          'l'#39', :vurl);'
        '      else'
        
          '        url_imagens = url_imagens || ASCII_CHAR(13) || iif(trim(' +
          'coalesce(vurl, '#39#39')) = '#39#39', '#39'sem url'#39', :vurl);'
        ''
        '      if (trim(coalesce(cod_imagens, '#39#39')) = '#39#39') then'
        '        cod_imagens = :vcod_img;'
        '      else'
        
          '        cod_imagens = cod_imagens || ASCII_CHAR(13) || :vcod_img' +
          ';'
        '    end'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRODUTOS_CONVERSAO_SAIDA ADD UNID_PREF VARCHAR(6);'
        'ALTER TABLE PRODUTOS_CONVERSAO_SAIDA ADD CODIGO_EAN VARCHAR(20);'
        
          'ALTER TABLE PRODUTOS_CONVERSAO_SAIDA ADD ATIVO SMALLINT DEFAULT ' +
          '1;'
        'ALTER TABLE PRODUTOS_CONVERSAO ADD ATIVO SMALLINT;'
        ''
        'ALTER TABLE NOTAFISCAL_ITEM ADD VUNCOM T_N_GERAL;'
        ''
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$FIELD_LENGTH = 6,' +
          ' RDB$CHARACTER_LENGTH = 6, RDB$COLLATION_ID = 0 where RDB$FIELD_' +
          'NAME = (select rdb$field_source from rdb$relation_fields where r' +
          'db$relation_name = '#39'NOTAFISCAL_ITEM'#39' and rdb$field_name = '#39'REFER' +
          'ENCIA'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$FIELD_LENGTH = 6,' +
          ' RDB$CHARACTER_LENGTH = 6, RDB$COLLATION_ID = 0 where RDB$FIELD_' +
          'NAME = (select rdb$field_source from rdb$relation_fields where r' +
          'db$relation_name = '#39'NOTAFISCAL_ITEM'#39' and rdb$field_name = '#39'UNIDA' +
          'DE_NF'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$FIELD_LENGTH = 6,' +
          ' RDB$CHARACTER_LENGTH = 6, RDB$COLLATION_ID = 0 where RDB$FIELD_' +
          'NAME = (select rdb$field_source from rdb$relation_fields where r' +
          'db$relation_name = '#39'PEDVENDA_PROD'#39' and rdb$field_name = '#39'UNIDADE' +
          #39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$FIELD_LENGTH = 6,' +
          ' RDB$CHARACTER_LENGTH = 6, RDB$COLLATION_ID = 0 where RDB$FIELD_' +
          'NAME = (select rdb$field_source from rdb$relation_fields where r' +
          'db$relation_name = '#39'PEDVENDA_PROD'#39' and rdb$field_name = '#39'UNIDADE' +
          '_CONV'#39');'
        
          'update RDB$FIELDS set RDB$FIELD_TYPE = 37, RDB$FIELD_LENGTH = 6,' +
          ' RDB$CHARACTER_LENGTH = 6, RDB$COLLATION_ID = 0 where RDB$FIELD_' +
          'NAME = (select rdb$field_source from rdb$relation_fields where r' +
          'db$relation_name = '#39'PRODUTOS'#39' and rdb$field_name = '#39'UNIDADE'#39');'
        ''
        '|BLOCO|'
        'create or alter view VW_PRODUTOS_CONVERSAO ('
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_EMPRESA,'
        '    CODIGO_EAN,'
        '    UNIDADE,'
        '    QUANTIDADE,'
        '    TIPO,'
        '    OPERACAO,'
        '    DISPONIVEL_VENDA,'
        '    PADRAO_VENDA,'
        '    UNID_VND,'
        '    UNID_PRINC,'
        '    UNID_PREF,'
        '    QTDE_VND,'
        '    QTDE_PRINC,'
        '    PARIDADE,'
        '    FATOR,'
        '    FATOR_SPED,'
        '    ATIVO)'
        'AS'
        'select'
        ' ps.grupo_prod,'
        ' ps.cod_prod,'
        ' ps.cod_empresa,'
        ' ps.codigo_ean,'
        ' ps.unidade,'
        ' coalesce(ps.quantidade, 0) quantidade,'
        ' '#39'Conversao'#39' tipo,'
        
          ' case when (ps.operacao = '#39'D'#39') then '#39'Divisao'#39' else '#39'Multiplicaca' +
          'o'#39' end operacao,'
        ' coalesce(ps.disponivel_venda, '#39'N'#39') disponivel_venda,'
        ' coalesce(ps.padrao_venda, '#39'N'#39') padrao_venda,'
        ' ps.unidade unid_vnd,'
        ' p.unidade unid_princ,'
        ' ps.unid_pref,'
        ' iif(ps.operacao = '#39'D'#39', 1, ps.quantidade) qtde_vnd,'
        ' iif(ps.operacao = '#39'M'#39', 1, ps.quantidade) qtde_princ,'
        ' cast('
        '   case'
        
          '     when ps.operacao = '#39'D'#39' then '#39'1'#39' || ps.unidade || '#39' = '#39' ||(s' +
          'elect RESULTADO from FLOATTOSTR(ps.quantidade, 4)) || p.unidade'
        
          '     when ps.operacao = '#39'M'#39' then (select RESULTADO from FLOATTOS' +
          'TR(ps.quantidade, 4)) || ps.unidade || '#39' = 1'#39' || p.unidade'
        '     else '#39#39
        '   end'
        '   as varchar(128))'
        '  paridade,'
        ' case'
        '   when ps.operacao = '#39'D'#39' then 1 / ps.quantidade'
        '   when ps.operacao = '#39'M'#39' then 1 * ps.quantidade'
        '   else 1.0'
        ' end'
        '  fator,'
        ' case'
        '   when ps.operacao = '#39'D'#39' then ps.quantidade'
        '   when ps.operacao = '#39'M'#39' then 1 / ps.quantidade'
        '   else 1.0'
        ' end'
        '  fator_sped,'
        ' coalesce(ps.ativo, 1) ativo'
        ' from produtos_conversao_saida ps'
        
          ' inner join produtos p on (ps.grupo_prod = p.grupo_prod) and (ps' +
          '.cod_prod = p.cod_prod) and (ps.cod_empresa = p.cod_empresa)'
        '|/BLOCO|'
        ''
        
          'INSERT INTO UNIDADES (SIGLA, DESCRICAO, FRACIONADO) SELECT DISTI' +
          'NCT UPPER(TRIM(COALESCE(UNIDADE, '#39#39'))), UPPER(TRIM(COALESCE(UNID' +
          'ADE, '#39#39'))), 1 FROM PRODUTOS WHERE TRIM(COALESCE(UNIDADE, '#39#39')) <>' +
          ' '#39#39';'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    ORIGEM_SERVICO,'
        '    NUM_FAB_PROD,'
        '    ID_KIT,'
        '    CODIGO_KIT,'
        '    DESCRICA0_KIT,'
        '    VALOR_UN_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT_LIQ,'
        '    VALOR_KIT_LIQ,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,  '
        '    UNIDADE_CONV,'
        '    QUANTIDADE_CONV,'
        '    VL_UNITARIO_CONV,'
        '    OPERACAO_CONV,'
        '    FATOR_CONV,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, null, pvp.num_fab_prod,'
        
          'pvp.id_kit, pvp.codigo_kit, case when (pvp.codigo_kit > 0) then ' +
          'k.descricao_kit else pvp.descr_prod_ped end descricao_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit_li' +
          'q,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_tot_kit_l' +
          'iq,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_acresc, 0)) from pedve' +
          'nda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_acresc_k' +
          'it,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_desc, 0)) from pedvend' +
          'a_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_desc_kit' +
          ','
        'pvp.unidade, pvp.descr_prod_ped, pvp.cod_grade,'
        'coalesce(pvp.quant_ped_item, 0) quant_ped_item,'
        'coalesce(pvp.vlun_ped_item, 0) vlun_ped_item,'
        'coalesce(pvp.vltot_ped_item, 0) vltot_ped_item,'
        'pvp.unidade_conv,'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) * coalesce(pvp.fator_con' +
          'v, 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) / coalesce(pvp.fator_con' +
          'v, 0))'
        '     else'
        '       coalesce(pvp.quant_ped_item, 0)'
        'end quant_ped_item_conv,'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) / coalesce(pvp.fator_conv' +
          ', 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) * coalesce(pvp.fator_conv' +
          ', 0))'
        '     else'
        '       coalesce(pvp.vlun_ped_item, 0)'
        'end vlun_ped_item_conv,'
        'pvp.operacao_conv,'
        'pvp.fator_conv,'
        'coalesce(pvp.rateio_desc,0) as rateio_desc,'
        'coalesce(pvp.rateio_acresc,0) as rateio_acresc,'
        'p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join pedvenda pv on pv.nped = pvp.nped and pv.tipo = pvp.t' +
          'ipo and pv.cod_empresa = pvp.cod_empresa'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join kits_prod k on k.codigo_kit = pvp.codigo_kit and k.cod' +
          '_empresa = pvp.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||pvs.cod_servico, null, null, pvs.cod_servico, co' +
          'alesce(tp.stipo, '#39#39'), null,'
        
          'null, null, pvs.desc_serv_ped, null, null, null, null, null, nul' +
          'l,'
        'null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        'coalesce(pvs.valor_un_serv, 0) valor_un_serv,'
        'coalesce(pvs.valor_tot_serv, 0) valor_tot_serv,'
        'null, null, null, null, null,'
        'coalesce(pvs.rateio_desc,0) as rateio_desc,'
        'coalesce(pvs.rateio_acresc,0) as rateio_acresc,'
        'null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'inner join pedvenda pv on pv.nped = pvs.nped and pv.tipo = pvs.t' +
          'ipo and pv.cod_empresa = pvs.cod_empresa'
        'left join tipo_servico tp on tp.cod_servico = pvs.cod_servico'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', vpt.seqid,'
        'vpt.nped, '#39'PROD-T'#39', null, null, null, null, null,'
        'null, null, vpt.descricao, null, null, null, null, null, null,'
        'vpt.unidade, vpt.descricao, null, vpt.qtde,'
        'vpt.vl_unit, vpt.vl_total,'
        'null, null, null, null, null,'
        '0, 0, null, null, null, null, null, null, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39', vst.seqid,'
        'vst.nped, '#39'SERV-T'#39', null, null, null, null, null,'
        'null, null, vst.descr_servt, null, null, null, null, null, null,'
        'null, vst.descr_servt, null, 1,'
        'vst.vl_servt, vst.vl_servt,'
        'null, null, null, null, null, '
        '0, 0, null, null, null, null, null, null, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_DAV('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    IDENTIFICACAO_EMP,'
        '    NOME_EMP,'
        '    FANTASIA_EMP,'
        '    CGC_EMP,'
        '    IE_EMP,'
        '    TELEFONE_EMP,'
        '    EMAIL_EMP,'
        '    ENDERECO_COMPL_EMP,'
        '    ENDERECO_EMP,'
        '    CEP_EMP,'
        '    NUMERO_END_EMP,'
        '    COMPLEMENTO_END_EMP,'
        '    BAIRRO_EMP,'
        '    CIDADE_EMP,'
        '    ESTADO_EMP,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    RAZAO_CLIENTE,'
        '    CPFCGC,'
        '    INSC_EST,'
        '    FONE_CLIENTE,'
        '    FONE_CELULAR,'
        '    EMAIL,'
        '    ENDERECO_COMPL,'
        '    ENDERECO,'
        '    CEP,'
        '    BAIRRO,'
        '    CIDADE,'
        '    ESTADO,'
        '    COMPLEMENTO,'
        '    CONTATO,'
        '    DESC_COND_PAG,'
        '    VALOR_TOTAL,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    OBS_PED,'
        '    OBS_RED_OS,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NUM_FAB_PROD,'
        '    STATUS,'
        '    COD_GRADE,'
        '    GRADE,'
        '    STATUS_PED,'
        '    NPREVENDA,'
        '    NOME_RECEB,'
        '    FONE_RECEB,'
        '    CEP_RECEB,'
        '    END_RECEB,'
        '    BAIRRO_RECEB,'
        '    CIDA_RECEB,'
        '    DATA_FECH,'
        '    HORAFECHAMENTO,'
        '    MINFECHAMENTO,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    APLICACAO_PROD,'
        '    UNIDADE,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PROD_SERV,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    COD_VEICULO,'
        '    CHASSI,'
        '    PLACA,'
        '    COMBUST_VEIC,'
        '    KM_V,'
        '    COD_SERVICO,'
        '    APARELHO_PED,'
        '    NCM,'
        '    ORDEM,'
        '    NITEM,'
        '    COD_EQUIP,'
        '    DATA_PED,'
        '    CODIGO,'
        '    CIDA_AVL,'
        '    ESTA_AVL,'
        '    BAIRRO_AVL,'
        '    CEP_AVL,'
        '    NOME_CLI_ORC,'
        '    HORAABERTURA,'
        '    MINABERTURA,'
        '    CEP_DEST,'
        '    LOGRADOURO_DEST,'
        '    BAIRRO_DEST,'
        '    CIDADE_DEST,'
        '    ESTADO_DEST,'
        '    COMPLEMENTO_DEST,'
        '    DEST_SEQID,'
        '    LOCACAO_PROD,'
        '    LOCACAO_PROD_1,'
        '    LOC_DEP,'
        '    SELOS_REM,'
        '    SELOS_COL,'
        '    LACRES_REM,'
        '    LACRES_COL,'
        '    OBS_LIVRO_REG,'
        '    CODIGO_KIT,'
        '    DESCRICAO_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    MARCA_P,'
        '    DESCRICAO,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    ACRESCIMO_TOT,'
        '    DESCONTO_TOT,'
        '    CANCELADO,'
        '    PESO_BRUT_TOT,'
        '    DATA,'
        '    ANO_FAB,'
        '    COR,'
        '    MARCA_V,'
        '    MODELO_V,'
        '    PLACA_V,'
        '    RENAVAM,'
        '    COD_VENDEDOR,'
        '    NOME_VENDEDOR,'
        '    RG_VENDEDOR,'
        '    CPF_VENDEDOR,'
        '    USAR_LOGO,'
        '    TIPO_OS,'
        '    DESCRICAO_TV,'
        '    ID_KIT,'
        '    QUANT_KIT,'
        '    PESO_BRUT_PROD,'
        '    NUM_END_CLIENTE,'
        '    END_AVL,'
        '    VALOR_KIT_LIQ,'
        '    VALOR_UN_KIT_LIQ,'
        '    ACRESC_ITEM_PROD_TOT,'
        '    DESC_ITEM_PROD_TOT,'
        '    ACRESC_ITEM_SERV_TOT,'
        '    DESC_ITEM_SERV_TOT,'
        '    COD_US_FECH,'
        '    NOME_US_FECH,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2,'
        '    OBS_TPVENDA1,'
        '    OBS_TPVENDA2,'
        '    OBS_TPVENDA,'
        '    ESTADO_VEIC,'
        '    DEFEITO,'
        '    ACESSORIOS,'
        '    OBS_OS,'
        '    CODIGO_FOTO,'
        '    FOTO,'
        '    CODIGO_FOTO_EMP,'
        '    FOTO_EMP)'
        'AS'
        'SELECT PEDVENDA.NPED, PEDVENDA.TIPO, PEDVENDA.COD_EMPRESA,'
        
          ' EMPRESA.IDENTIFICACAO_EMP, EMPRESA.NOME_EMP, EMPRESA.FANTASIA_E' +
          'MP, EMPRESA.CGC_EMP, EMPRESA.IE_EMP,'
        ' EMPRESA.TELEFONE_EMP, EMPRESA.EMAIL_EMP,'
        ' (coalesce(EMPRESA.ENDRECO_EMP, '#39#39') ||'
        
          '    iif(coalesce(EMPRESA.NUMERO_END, 0) > 0, '#39', N: '#39' || coalesce' +
          '(EMPRESA.NUMERO_END, 0), '#39#39') ||'
        
          '    iif((trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')) <> '#39#39'), '#39', ' +
          #39' || trim(coalesce(EMPRESA.COMPLEMENTO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CEP_EMP, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(EMPRESA.CEP_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.BAIRRO_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(EMPRESA.CIDADE_EMP, '#39#39')) <> '#39#39', '#39', '#39' || tr' +
          'im(coalesce(EMPRESA.CIDADE_EMP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ' ) ENDERECO_COMPL_EMP,'
        
          ' EMPRESA.ENDRECO_EMP, EMPRESA.CEP_EMP, EMPRESA.NUMERO_END, EMPRE' +
          'SA.COMPLEMENTO_EMP,'
        
          ' EMPRESA.BAIRRO_EMP, EMPRESA.CIDADE_EMP, ESTEMP.SIGLA_UF ESTADO_' +
          'EMP,'
        
          ' CLIENTES.COD_CLIENTE, CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, CL' +
          'IENTES.CPFCGC, CLIENTES.INSC_EST,'
        ' CLIENTES.FONE_CLIENTE, CLIENTES.FONE_CELULAR, CLIENTES.EMAIL,'
        ' (coalesce(CLIENTES.ENDERECO, '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')) <> '#39#39', '#39', N' +
          ': '#39' || trim(coalesce(CLIENTES.NUM_END_CLIENTE, '#39#39')), '#39#39') ||'
        
          '    iif((trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')) <> '#39#39'), '#39', '#39' |' +
          '| trim(coalesce(CLIENTES.COMPLEMENTO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CLIENTES.CEP, '#39#39')) <> '#39#39', '#39', '#39' || trim(coa' +
          'lesce(CLIENTES.CEP, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(BAICL.NOME_BAIRRO, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(BAICL.NOME_BAIRRO, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(CIDCL.NOME_CIDADE, '#39#39')) <> '#39#39', '#39', '#39' || tri' +
          'm(coalesce(CIDCL.NOME_CIDADE, '#39#39')), '#39#39') ||'
        
          '    iif(trim(coalesce(ESTEMP.SIGLA_UF, '#39#39')) <> '#39#39', '#39', '#39' || trim(' +
          'coalesce(ESTEMP.SIGLA_UF, '#39#39')), '#39#39')'
        ') ENDERECO_COMPL_CL,'
        
          ' CLIENTES.ENDERECO, CLIENTES.CEP, BAICL.NOME_BAIRRO, CIDCL.NOME_' +
          'CIDADE, ESTCL.SIGLA_UF ESTADO,'
        ' CLIENTES.COMPLEMENTO, CLIENTES.CONTATO,'
        ' COND_PAG.DESC_COND_PAG,'
        
          ' PEDVENDA.VALOR_TOTAL, PEDVENDA.TOT_PROD, PEDVENDA.TOT_SERV, PED' +
          'VENDA.TOT_PROD_TERC, PEDVENDA.TOT_SERV_TERC,'
        ' PEDVENDA.OBS_PED, PEDVENDA.OBS_RED_OS, '
        
          ' ORCAMENTO4.GRUPO_PROD, ORCAMENTO4.COD_PROD, ORCAMENTO4.NUM_FAB_' +
          'PROD,  ORCAMENTO4.STATUS, ORCAMENTO4.COD_GRADE, GRADE.DESCRICAO,'
        ' PEDVENDA.STATUS_PED, PEDVENDA.NPREVENDA,'
        
          ' PEDVENDA.NOME_RECEB, PEDVENDA.FONE_RECEB, PEDVENDA.CEP_RECEB, P' +
          'EDVENDA.END_RECEB, PEDVENDA.BAIRRO_RECEB, PEDVENDA.CIDA_RECEB,'
        
          ' PEDVENDA.DATA_FECH, PEDVENDA.HORAFECHAMENTO, PEDVENDA.MINFECHAM' +
          'ENTO,'
        
          ' CASE WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) = '#39#39') TH' +
          'EN'
        '        ORCAMENTO4.QUANTIDADE'
        
          '      WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39')) = TRIM(COALES' +
          'CE(ORCAMENTO4.UNIDADE_CONV, '#39#39'))) THEN'
        '        ORCAMENTO4.QUANTIDADE'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'M'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.QUANTIDADE_CONV'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'D'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.QUANTIDADE_CONV'
        '      ELSE'
        '        ORCAMENTO4.QUANTIDADE'
        ' END QUANTIDADE,'
        
          ' CASE WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) = '#39#39') TH' +
          'EN'
        '        ORCAMENTO4.VL_UNITARIO'
        
          '      WHEN (TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39')) = TRIM(COALES' +
          'CE(ORCAMENTO4.UNIDADE_CONV, '#39#39'))) THEN'
        '        ORCAMENTO4.VL_UNITARIO'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'M'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.VL_UNITARIO_CONV'
        
          '      WHEN ((COALESCE(ORCAMENTO4.OPERACAO_CONV, '#39#39') = '#39'D'#39') AND (' +
          'COALESCE(ORCAMENTO4.FATOR_CONV, 0) > 0)) THEN'
        '        ORCAMENTO4.VL_UNITARIO_CONV'
        '      ELSE'
        '        ORCAMENTO4.VL_UNITARIO'
        ' END VL_UNITARIO,'
        ' ORCAMENTO4.VL_TOTAL_ITEM, PRODUTOS.APLICACAO_PROD,'
        ' IIF(TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')) <> '#39#39','
        '    TRIM(COALESCE(ORCAMENTO4.UNIDADE_CONV, '#39#39')),'
        '    TRIM(COALESCE(ORCAMENTO4.UNIDADE, '#39#39'))) UNIDADE,'
        
          ' ORCAMENTO4.RATEIO_DESC, ORCAMENTO4.RATEIO_ACRESC, ORCAMENTO4.PR' +
          'OD_SERV,'
        
          ' ORCAMENTO4.COD_TECNICO_MECAN, ORCAMENTO4.NOME_TECNICO_MECAN, OR' +
          'CAMENTO4.COD_TECNICO_MECAN2, ORCAMENTO4.NOME_TECNICO_MECAN2,'
        
          ' DADOS_VEICULO.CODIGO, DADOS_VEICULO.CHASSI, DADOS_VEICULO.PLACA' +
          ', PEDVENDA.COMBUST_VEIC, PEDVENDA.KM_V, ORCAMENTO4.COD_SERVICO, ' +
          'PEDVENDA.APARELHO_PED,'
        ' ORCAMENTO4.NCM, ORCAMENTO4.ORDEM, ORCAMENTO4.NITEM,'
        
          ' PEDVENDA.COD_EQUIP, PEDVENDA.DATA_PED, FOTOS.CODIGO, PEDVENDA.C' +
          'IDA_AVL, PEDVENDA.ESTA_AVL, PEDVENDA.BAIRRO_AVL, PEDVENDA.CEP_AV' +
          'L,'
        
          ' PEDVENDA.NOME_CLI_ORC, PEDVENDA.HORAABERTURA, PEDVENDA.MINABERT' +
          'URA,'
        
          ' VW_CLIENTES_DEST.CEP, VW_CLIENTES_DEST.LOGRADOURO, VW_CLIENTES_' +
          'DEST.BAIRRO, VW_CLIENTES_DEST.CIDADE, VW_CLIENTES_DEST.UF, VW_CL' +
          'IENTES_DEST.COMPLEMENTO, PEDVENDA.DEST_SEQID,'
        
          ' PRODUTOS.LOCACAO_PROD, PRODUTOS.LOCACAO_PROD_1, PRODUTOS.LOC_DE' +
          'P,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_REM, PEDVENDA_ATIVIDADES_REPAR' +
          'P.SELOS_COL, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM, PEDVENDA_ATI' +
          'VIDADES_REPARP.LACRES_COL,'
        
          ' PEDVENDA.OBS_LIVRO_REG, ORCAMENTO4.CODIGO_KIT, ORCAMENTO4.DESCR' +
          'ICA0_KIT, ORCAMENTO4.VALOR_KIT, ORCAMENTO4.VALOR_UN_KIT, ORCAMEN' +
          'TO4.RATEIO_ACRESC_KIT, ORCAMENTO4.RATEIO_DESC_KIT,'
        
          ' ORCAMENTO4.MARCA_P, ORCAMENTO4.DESCRICAO, TOTAIS_PEDVENDA.QUANT' +
          '_PED_ITEM, TOTAIS_PEDVENDA.QUANT_SERV_PED,'
        
          ' TOTAIS_PEDVENDA.ACRESCIMO, TOTAIS_PEDVENDA.DESCONTO, TOTAIS_PED' +
          'VENDA.CANCELADO, TOTAIS_PEDVENDA.PESO_BRUT_PROD, VALOR_VENC_MIN.' +
          'DATA,'
        
          ' DADOS_VEICULO.ANOFAB, DADOS_VEICULO.COR, DADOS_VEICULO.MARCA, D' +
          'ADOS_VEICULO.MODELO, DADOS_VEICULO.PLACA, DADOS_VEICULO.RENAVAM,'
        
          ' COLABORADOR.COD_VENDEDOR, COLABORADOR.NOME_VENDEDOR, COLABORADO' +
          'R.RG_VENDEDOR, COLABORADOR.CPF_VENDEDOR, FOTOS_EMP.USAR_LOGO, PE' +
          'DVENDA.TIPO_OS, TIPO_VENDAS.DESCRICAO,'
        
          ' ORCAMENTO4.ID_KIT, TOTAIS_PEDVENDA.QUANT_KIT, PRODUTOS.PESO_BRU' +
          'T_PROD,'
        ' CLIENTES.NUM_END_CLIENTE, PEDVENDA.END_AVL,'
        
          ' ORCAMENTO4.VALOR_KIT_LIQ, ORCAMENTO4.VALOR_UN_KIT_LIQ, TOTAIS_P' +
          'EDVENDA.ACRESC_ITEM_PROD, TOTAIS_PEDVENDA.DESC_ITEM_PROD, TOTAIS' +
          '_PEDVENDA.ACRESC_ITEM_SERV,'
        
          ' TOTAIS_PEDVENDA.DESC_ITEM_SERV, PEDVENDA.COD_US_FECH, COLABORAD' +
          'OR_1.NOME_VENDEDOR,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_COL1, PEDVENDA_ATIVIDADES_REPA' +
          'RP.SELOS_COL2, PEDVENDA_ATIVIDADES_REPARP.SELOS_REM1, PEDVENDA_A' +
          'TIVIDADES_REPARP.SELOS_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.LACRES_COL1, PEDVENDA_ATIVIDADES_REP' +
          'ARP.LACRES_COL2, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM1, PEDVEND' +
          'A_ATIVIDADES_REPARP.LACRES_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA1, PEDVENDA_ATIVIDADES_RE' +
          'PARP.OBS_TPVENDA2, PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA, PEDVE' +
          'NDA.ESTADO_VEIC, PEDVENDA.DEFEITO,'
        
          ' PEDVENDA.ACESSORIOS, PEDVENDA.OBS_OS, FOTOS.CODIGO, FOTOS.FOTO,' +
          ' FOTOS_EMP.CODIGO, FOTOS_EMP.FOTO'
        ''
        ' FROM PEDVENDA'
        
          ' LEFT JOIN TOTAIS_PEDVENDA ON TOTAIS_PEDVENDA.NPED=PEDVENDA.NPED' +
          ' AND TOTAIS_PEDVENDA.TIPO=PEDVENDA.TIPO AND TOTAIS_PEDVENDA.COD_' +
          'EMPRESA=PEDVENDA.COD_EMPRESA'
        
          ' LEFT JOIN PEDVENDA_ATIVIDADES_REPARP ON PEDVENDA_ATIVIDADES_REP' +
          'ARP.NPED=PEDVENDA.NPED AND PEDVENDA_ATIVIDADES_REPARP.TIPO=PEDVE' +
          'NDA.TIPO AND PEDVENDA_ATIVIDADES_REPARP.COD_EMPRESA=PEDVENDA.COD' +
          '_EMPRESA'
        
          ' LEFT JOIN CLIENTES ON PEDVENDA.COD_CLIENTE=CLIENTES.COD_CLIENTE' +
          ' AND PEDVENDA.COD_EMPRESA=CLIENTES.COD_EMPRESA'
        ' LEFT JOIN EMPRESA ON PEDVENDA.COD_EMPRESA=EMPRESA.COD_EMPRESA'
        ' LEFT JOIN ESTADOS ESTEMP ON ESTEMP.CODIGO_UF = EMPRESA.UF_EMP'
        
          ' LEFT JOIN COND_PAG ON PEDVENDA.COD_COND_PAG=COND_PAG.COD_COND_P' +
          'AG'
        
          ' LEFT JOIN COLABORADOR ON PEDVENDA.COD_VENDEDOR=COLABORADOR.COD_' +
          'VENDEDOR AND PEDVENDA.COD_EMPRESA=COLABORADOR.COD_EMPRESA'
        
          ' LEFT JOIN ORCAMENTO4 ON PEDVENDA.NPED=ORCAMENTO4.NPED AND PEDVE' +
          'NDA.COD_EMPRESA=ORCAMENTO4.COD_EMPRESA AND PEDVENDA.TIPO=ORCAMEN' +
          'TO4.TIPO'
        
          ' LEFT JOIN VW_CLIENTES_DEST ON PEDVENDA.COD_CLIENTE=VW_CLIENTES_' +
          'DEST.COD_CLIENTE AND PEDVENDA.COD_EMPRESA=VW_CLIENTES_DEST.COD_E' +
          'MPRESA AND PEDVENDA.DEST_SEQID=VW_CLIENTES_DEST.DEST_SEQID'
        
          ' LEFT JOIN VALOR_VENC_MIN ON PEDVENDA.NPED=VALOR_VENC_MIN.NPED A' +
          'ND PEDVENDA.COD_EMPRESA=VALOR_VENC_MIN.COD_EMPRESA AND PEDVENDA.' +
          'TIPO=VALOR_VENC_MIN.TIPO'
        
          ' LEFT JOIN DADOS_VEICULO ON PEDVENDA.NPED=DADOS_VEICULO.NPED AND' +
          ' PEDVENDA.COD_EMPRESA=DADOS_VEICULO.COD_EMPRESA AND PEDVENDA.TIP' +
          'O=DADOS_VEICULO.TIPO'
        
          ' LEFT JOIN FOTOS_EMP ON PEDVENDA.COD_EMPRESA=FOTOS_EMP.COD_EMPRE' +
          'SA'
        
          ' LEFT JOIN TIPO_VENDAS ON PEDVENDA.TIPO=TIPO_VENDAS.TIPO AND PED' +
          'VENDA.TIPV=TIPO_VENDAS.SIGLA'
        
          ' LEFT JOIN COLABORADOR COLABORADOR_1 ON PEDVENDA.COD_EMPRESA=COL' +
          'ABORADOR_1.COD_EMPRESA AND PEDVENDA.COD_US_FECH=COLABORADOR_1.CO' +
          'D_VENDEDOR'
        
          ' LEFT JOIN GRADE ON ORCAMENTO4.COD_EMPRESA=GRADE.COD_EMPRESA AND' +
          ' ORCAMENTO4.COD_GRADE=GRADE.COD_GRADE'
        
          ' LEFT JOIN PRODUTOS ON ORCAMENTO4.GRUPO_PROD=PRODUTOS.GRUPO_PROD' +
          ' AND ORCAMENTO4.COD_EMPRESA=PRODUTOS.COD_EMPRESA AND ORCAMENTO4.' +
          'COD_PROD=PRODUTOS.COD_PROD'
        
          ' LEFT JOIN FOTOS ON ORCAMENTO4.NPED=FOTOS.CODIGO AND ORCAMENTO4.' +
          'COD_EMPRESA=FOTOS.COD_EMPRESA AND ORCAMENTO4.GRUPO_PROD=FOTOS.GR' +
          'UPO_PROD AND ORCAMENTO4.COD_PROD=FOTOS.COD_PROD AND ORCAMENTO4.C' +
          'OD_GRADE=FOTOS.COD_GRADE AND ORCAMENTO4.TIPO_FOTO=FOTOS.TIPO'
        
          ' LEFT JOIN CIDADES CIDCL ON CIDCL.COD_CIDADE = CLIENTES.COD_CIDA' +
          'DE'
        
          ' LEFT JOIN BAIRROS BAICL ON BAICL.COD_BAIRRO = CLIENTES.COD_BAIR' +
          'RO'
        
          ' LEFT JOIN ESTADOS ESTCL ON ESTCL.CODIGO_UF = CLIENTES.CODIGO_UF' +
          ';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW TOTAIS_PEDVENDA('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    QUANT_KIT,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    ACRESC_ITEM_PROD,'
        '    DESC_ITEM_PROD,'
        '    ACRESC_ITEM_SERV,'
        '    DESC_ITEM_SERV,'
        '    VALOR_TOTAL,'
        '    VALOR_BRUTO,'
        '    ACRESCIMO,'
        '    DESCONTO,'
        '    CANCELADO,'
        '    PESO_BRUT_PROD)'
        'AS'
        'select'
        '  pedvenda.nped,'
        '  pedvenda.tipo,'
        '  pedvenda.cod_empresa,'
        '  coalesce('
        
          '   coalesce((select sum(case when (trim(coalesce(pp.unidade_conv' +
          ', '#39#39')) = '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '             where pp.nped = pedvenda.nped'
        '             and pp.tipo = pedvenda.tipo'
        '             and pp.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '   coalesce((select sum(coalesce(ppt.qtde, 0)) from pedvenda_pro' +
          'd_terc ppt'
        '             where ppt.nped = pedvenda.nped'
        '             and ppt.tipo = pedvenda.tipo'
        '             and ppt.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_ped_item,'
        ''
        '  coalesce('
        
          '   coalesce((select sum(coalesce(ps.quant_serv_ped, 0)) from ped' +
          'venda_serv ps'
        '             where ps.nped = pedvenda.nped'
        '             and ps.tipo = pedvenda.tipo'
        '             and ps.cod_empresa = pedvenda.cod_empresa'
        '             and coalesce(ps.status, '#39#39') = '#39#39'), 0) +'
        '   coalesce((select count(*) from pedvenda_serv_terc pst'
        '             where pst.nped = pedvenda.nped'
        '             and pst.tipo = pedvenda.tipo'
        '             and pst.cod_empresa = pedvenda.cod_empresa), 0),'
        '  0) quant_serv_ped,'
        ''
        
          '  coalesce((select coalesce(qtde, 0) from retorna_qtde_kit(pedve' +
          'nda.nped, pedvenda.tipo, pedvenda.cod_empresa)), 0) quant_kit,'
        ''
        '  coalesce(pedvenda.tot_prod, 0) TOT_PROD,'
        '  coalesce(pedvenda.tot_serv, 0) TOT_SERV,'
        '  coalesce(pedvenda.tot_prod_terc, 0) TOT_PROD_TERC,'
        '  coalesce(pedvenda.tot_serv_terc, 0) TOT_SERV_TERC,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedve' +
          'nda_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_PRO' +
          'D,'
        ''
        
          '  coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedvend' +
          'a_prod pp'
        '           where pp.nped = pedvenda.nped'
        '           and pp.tipo = pedvenda.tipo'
        '           and pp.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(pp.status, '#39#39') = '#39#39'), 0) DESC_ITEM_PROD,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from pedve' +
          'nda_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        
          '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) ACRESC_ITEM_SER' +
          'V,'
        ''
        
          '  coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedvend' +
          'a_serv ps'
        '           where ps.nped = pedvenda.nped'
        '           and ps.tipo = pedvenda.tipo'
        '           and ps.cod_empresa = pedvenda.cod_empresa'
        '           and coalesce(ps.status, '#39#39') = '#39#39'), 0) DESC_ITEM_SERV,'
        ''
        '  coalesce(pedvenda.valor_total, 0) VALOR_TOTAL,'
        
          '  (coalesce(pedvenda.tot_prod, 0) + coalesce(pedvenda.tot_serv, ' +
          '0) + coalesce(pedvenda.tot_prod_terc, 0) + coalesce(pedvenda.tot' +
          '_serv_terc, 0)) VALOR_BRUTO,'
        ''
        
          '  (coalesce((select sum(coalesce(pp.rateio_acresc, 0)) from pedv' +
          'enda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_acresc, 0)) from ped' +
          'venda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) acrescimo,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.rateio_desc, 0)) from pedve' +
          'nda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.rateio_desc, 0)) from pedve' +
          'nda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39#39'), 0)) desconto,'
        ''
        
          '   (coalesce((select sum(coalesce(pp.vltot_ped_item, 0)) from pe' +
          'dvenda_prod pp'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39'CANCELADO'#39'), 0) +'
        
          '    coalesce((select sum(coalesce(ps.valor_tot_serv, 0)) from pe' +
          'dvenda_serv ps'
        '    where ps.nped = pedvenda.nped'
        '    and ps.tipo = pedvenda.tipo'
        '    and ps.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(ps.status, '#39#39') = '#39'CANCELADO'#39'), 0)) cancelado,'
        ''
        
          '   (coalesce((select sum(coalesce(pr.peso_brut_prod, 0) * coales' +
          'ce(pp.quant_ped_item, 0)) from pedvenda_prod pp'
        
          '    inner join produtos pr on pr.grupo_prod = pp.grupo_prod and ' +
          'pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        '    where pp.nped = pedvenda.nped'
        '    and pp.tipo = pedvenda.tipo'
        '    and pp.cod_empresa = pedvenda.cod_empresa'
        '    and coalesce(pp.status, '#39#39') = '#39#39'), 0)) peso_brut_prod'
        '     from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_KIT ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    QTDE double precision)'
        'as'
        'declare variable VTEMP double precision;'
        'declare variable QTDE_KIT double precision;'
        'declare variable QTDE_PROD double precision;'
        'declare variable VID_KIT integer;'
        'begin'
        '  qtde_kit = 0;'
        '  qtde_prod = 0;'
        
          '  for select distinct coalesce(pp.id_kit, 0) from pedvenda_prod ' +
          'pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '    and pp.id_kit > 0'
        '        into :vid_kit do'
        '  begin'
        '    qtde_kit = qtde_kit + 1;'
        '  end'
        ''
        
          '  for select sum(case when (trim(coalesce(pp.unidade_conv, '#39#39')) ' +
          '= '#39#39') then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when (trim(coalesce(pp.unidade, '#39#39')) = ' +
          'trim(coalesce(pp.unidade_conv, '#39#39'))) then'
        '                           coalesce(pp.quant_ped_item, 0)'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'M'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) * coa' +
          'lesce(pp.fator_conv, 0))'
        
          '                         when ((coalesce(pp.operacao_conv, '#39#39') =' +
          ' '#39'D'#39') AND (coalesce(pp.fator_conv, 0) > 0)) then'
        
          '                           (coalesce(pp.quant_ped_item, 0) / coa' +
          'lesce(pp.fator_conv, 0))'
        '                         else'
        '                           coalesce(pp.quant_ped_item, 0)'
        '                        end) from pedvenda_prod pp'
        '      where pp.nped = :nped'
        '      and pp.tipo = :tipo'
        '      and pp.cod_empresa = :cod_empresa'
        '      and coalesce(pp.status, '#39#39') = '#39#39
        '      and coalesce(pp.codigo_kit, 0) <= 0'
        '      union'
        
          '      select sum(coalesce(ppt.qtde, 0)) from pedvenda_prod_terc ' +
          'ppt'
        '      where ppt.nped = :nped'
        '      and ppt.tipo = :tipo'
        '      and ppt.cod_empresa = :cod_empresa'
        '          into :vtemp do'
        '  begin'
        '    qtde_prod = qtde_prod + vtemp;'
        '  end'
        ''
        '  qtde = coalesce(qtde_kit, 0) + coalesce(qtde_prod, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE NFCE_ITEM ADD UVND VARCHAR(6);'
        'ALTER TABLE NFCE_ITEM ADD UVND_FATOR T_VL_TODOS;'
        ''
        '|BLOCO|'
        'create or alter procedure FLOATTOSTR ('
        '    VALOR double precision,'
        '    CDECIMAL smallint = 2)'
        'returns ('
        '    RESULTADO varchar(64))'
        'as'
        'begin'
        '  resultado = '#39#39' || round(coalesce(valor, 0), cdecimal);'
        ''
        
          '  while (substring(resultado from char_length(resultado) for 1) ' +
          '= '#39'0'#39') do'
        
          '    resultado = substring(resultado from 1 for char_length(resul' +
          'tado) - 1);'
        ''
        
          '  if (substring(resultado from char_length(resultado) for 1) = '#39 +
          '.'#39') then'
        
          '    resultado = substring(resultado from 1 for char_length(resul' +
          'tado) - 1);'
        ''
        '  resultado = replace(resultado, '#39'.'#39', '#39','#39');'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter view PEDVENDA_PROD_FATOR('
        '    NPED,'
        '    TIPO,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NITEM,'
        '    COD_EMPRESA,'
        '    COD_GRADE,'
        '    CODIGO_NOP,'
        '    QCOM,'
        '    VUNCOM,'
        '    VPROD,'
        '    UCOM,'
        '    UVND,'
        '    VPRODNF,'
        '    UVND_FATOR,'
        '    PARIDADE,'
        '    QVND,'
        '    VVND,'
        '    VVNDNF)'
        'as'
        
          'select D.NPED, D.TIPO, D.GRUPO_PROD, D.COD_PROD, D.NITEM, D.COD_' +
          'EMPRESA, D.COD_GRADE, D.CODIGO_NOP, D.QCOM, D.VUNCOM,'
        
          '       D.VPROD, D.UCOM, D.UVND, D.VPRODNF, D.UVND_FATOR, D.PARID' +
          'ADE, D.QVND,'
        '       (D.VPROD / D.QVND) VVND,'
        '       (D.VPRODNF / D.QVND) VVNDNF'
        
          'from (select C.NPED, C.TIPO, C.GRUPO_PROD, C.COD_PROD, C.NITEM, ' +
          'C.COD_EMPRESA, C.COD_GRADE, C.CODIGO_NOP, C.QCOM,'
        
          '             C.VUNCOM, C.VPROD, C.UCOM, C.UVND, C.VPRODNF, C.UVN' +
          'D_FATOR,'
        '             case'
        '               when C.UVND_FATOR > 1 then (select RESULTADO'
        
          '                                           from FLOATTOSTR(C.UVN' +
          'D_FATOR, 4)) || '#39' '#39' || C.UVND || '#39' = 1 '#39' || C.UCOM'
        
          '               when C.UVND_FATOR > 0 then '#39'1 '#39' || C.UVND || '#39' = ' +
          #39' ||(select RESULTADO'
        
          '                                                                ' +
          '    from FLOATTOSTR(1 / C.UVND_FATOR, 4)) || '#39' '#39' || C.UCOM'
        '               else '#39'1 '#39' || C.UVND || '#39' = 1 '#39' || C.UCOM'
        '             end PARIDADE,'
        '             (C.QCOM * C.UVND_FATOR) QVND'
        
          '      from (select PP.NPED, PP.TIPO, PP.GRUPO_PROD, PP.COD_PROD,' +
          ' PP.NITEM, PP.COD_EMPRESA, PP.COD_GRADE, PP.CODIGO_NOP,'
        
          '                   PP.QUANT_PED_ITEM QCOM, PP.VLUN_PED_ITEM VUNC' +
          'OM, PP.VLTOT_PED_ITEM VPROD, PP.UNIDADE UCOM,'
        
          '                   coalesce(PP.UNIDADE_CONV, PP.UNIDADE) UVND, P' +
          'P.VLTOT_PED_NF VPRODNF,'
        '                   case'
        
          '                     when PP.OPERACAO_CONV = '#39'D'#39' then 1 / PP.FAT' +
          'OR_CONV'
        
          '                     when PP.OPERACAO_CONV = '#39'M'#39' then 1 * PP.FAT' +
          'OR_CONV'
        '                     else 1'
        '                   end UVND_FATOR'
        '            from PEDVENDA_PROD PP'
        '            order by PP.NPED desc, PP.NITEM desc) as C) as D '
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0241'#39', :COD_EMPRESA, '#39'CONFIRMAR ENTRADA NF SEM FATO' +
          'R CONVERSAO UNIDADES'#39', 100, '#39'S'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0242'#39', :COD_EMPRESA, '#39'CONFIRMAR ENTRADA NF SEM CONV' +
          'ERTER UNIDADE'#39', 100, '#39'S'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW RECEBIMENTOS2('
        '    TP_RECEBIMENTO,'
        '    ORDEM,'
        '    ORDEM2,'
        '    TIPO,'
        '    TIPO2,'
        '    COD_EMPRESA,'
        '    COD_EMP_MULT,'
        '    DATA_CONF,'
        '    CODIGO_CTRL,'
        '    NOME_CTRL,'
        '    FORMPAG,'
        '    VALOR_PAGO,'
        '    VALORRATEIO,'
        '    VALOR_PAGO_VISTA,'
        '    DATA_MOV,'
        '    DATA_VENC,'
        '    SEQID,'
        '    SEQID2)'
        'AS'
        
          '-- VIEW EXIBE OS RECEBIMENTOS DETALHADOS DAS VENDAS (REQUISICAO,' +
          ' ORDEM DE SERVICO, COMANDOS), RECIBO ANTECIPADOS E  CREDIARIO (C' +
          'REDITOS/CHEQUES)'
        '-- RELATORIO "RECEBIMENTO FINANCEIRO"'
        '--- REQ, OS'
        
          'select '#39'DIRETO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 en' +
          'd ordem2, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        ''
        'fp.data_mov, fp.data_venc,'
        'coalesce(fp.seqform, rq.nped), coalesce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nped and fp.tp' +
          'docs = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.recibo' +
          ' is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        
          'select '#39'RECIBO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 en' +
          'd ordem2, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc) is' +
          ' null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend ='#39'REC'#39' order by rc.valordoc asc' +
          ')'
        'end as nome_ctrl,'
        #39'RECIBO'#39' formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        '0 valor_pago_vista,'
        
          'fp.data_mov, fp.data_venc, coalesce(fp.seqform, rq.nped), coales' +
          'ce(fp.seqform, rq.nped)'
        ''
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = rq.nped and fp.t' +
          'pdocs = rq.tipo and fp.cod_empresa = rq.cod_empresa and (not fp.' +
          'recibo is null)'
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        
          'select '#39'TROCO'#39', 1, case when (rq.tipo = '#39'REQ'#39') then 2 else 3 end' +
          ' ordem2, rq.tipo, rq.tipo,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        'rq.cod_empresa,'
        'rq.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        
          'fp.data_mov, fp.data_venc, coalesce(fp.seqform, rq.nped), coales' +
          'ce(fp.seqform, rq.nped)'
        'from pedvenda rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nped and fp.r' +
          'ec_tipvend = rq.tipo and fp.cod_empresa = rq.cod_empresa and fp.' +
          'tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where coalesce(trim(rq.status_ped), '#39#39') = '#39'FECHADA'#39' and rq.tipo ' +
          'in ('#39'REQ'#39', '#39'OS'#39')'
        ''
        'union all'
        ''
        '--- CF'
        ''
        'select '#39'DIRETO'#39', 1, 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = mt.n_comando and ' +
          'fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa  and fp.re' +
          'cibo is null'
        
          'inner join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl an' +
          'd fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'RECIBO'#39', 1, 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    0'
        'else (select first 1 ctrl.codigo_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as codigo_ctrl,'
        'case when (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          'inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctr' +
          'l and rc.cod_empresa = ctrl.codigo_emp'
        
          'where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = fp.co' +
          'd_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc asc) i' +
          's null then'
        '    '#39'SEM FORMA'#39
        'else'
        '    (select first 1 ctrl.nome_ctrl from controles ctrl'
        
          '    inner join formpagamento rc on rc.cod_controle = ctrl.codigo' +
          '_ctrl and rc.cod_empresa = ctrl.codigo_emp'
        
          '    where rc.rec_numvend = fp.rec_numvend and rc.cod_empresa = f' +
          'p.cod_empresa and rc.rec_tipvend = '#39'REC'#39' order by rc.valordoc as' +
          'c)'
        'end as nome_ctrl,'
        #39'RECIBO'#39' formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        '0 valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando) from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.nrequisicao = mt.n_comando and' +
          ' fp.tpdocs = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and (not ' +
          'fp.recibo is null)'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'TROCO'#39', 1, 1, '#39'MOT'#39',  '#39'MOT'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else mt.cod_empresa end) cod_empresa,'
        'mt.cod_empresa,'
        'mt.data_fech,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, mt.n_comando), coalesce(fp.seqform, mt.n_co' +
          'mando)'
        'from com_fat mt'
        'left join empresa emp on mt.cod_empresa = emp.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = mt.n_comando and' +
          ' fp.rec_tipvend = '#39'MOT'#39' and fp.cod_empresa = mt.cod_empresa and ' +
          'fp.tpdocs = '#39'TRC'#39
        
          'left join recibos rec on rec.nrecibo = fp.rec_numvend and rec.co' +
          'd_empresa = fp.cod_empresa'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        
          'where (coalesce(trim(mt.status_v), '#39#39') = '#39'FECHADO'#39') and mt.natur' +
          'eza = '#39'S'#39
        ''
        '-- Cred'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                            and ((l.historico_l like '#39'%RECIBOS A' +
          'TENCIPADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) ' +
          'then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
        '                        '#39'DIRETO'#39
        'end), '#39'DIRETO'#39'),'
        
          '3, 5, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null) then pr.ti' +
          'po_doc_c else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        0'
        '                      else'
        
          '                        case when (ctr.codigo_ctrl is null) then' +
          ' 0 else ctr.codigo_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.codigo_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.codigo_ctrl is nu' +
          'll) then 0 else ctr1.codigo_ctrl end'
        '                             else'
        '                               0'
        '                        end'
        '                      else'
        '                        ctr.codigo_ctrl'
        '                 end'
        '          end),'
        '0) codigo_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        
          '                        case when (ctr.nome_ctrl is null) then 0' +
          ' else ctr.nome_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.nome_ctrl is null' +
          ') then 0 else ctr1.nome_ctrl end'
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        '                        '#39'RECIBO'#39
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        '                               '#39'DEVOLUCAO'#39
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') formpag,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       case when (coalesce(l.valor_l, 0)) <= 0 then'
        '              case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                    coalesce(pr.valor_quitado, 0)'
        '                   else'
        '                     coalesce(l.valor_l, 0)'
        '              end'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        'end valor_pago,'
        ''
        'case when (coalesce((select count(*) from baixa_creditos pr1'
        '                    where pr1.lote_quit = pr.lote_quit and'
        '                    l.codigo_emp = pr.codigo_emp), 0) > 1) then'
        '       (case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                            coalesce(pr.valor_quitado, 0)'
        '                           else'
        '                             coalesce(l.valor_l, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '        end /'
        '        coalesce((select count(*) from baixa_creditos pr1'
        '                  where pr1.lote_quit = pr.lote_quit and'
        '                  l.codigo_emp = pr.codigo_emp), 0)'
        '       )'
        '     else'
        '        case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then'
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                            coalesce(pr.valor_quitado, 0)'
        '                           else'
        '                             coalesce(l.valor_l, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '        end'
        'end valorrateio,'
        'case when (((select count(*) from hist_rec hist'
        '             where hist.lote_quit = pr.lote_quit'
        '             and hist.cod_empresa = pr.codigo_emp) > 0)'
        
          '             and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39') o' +
          'r (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '       0'
        '     when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '       0'
        '     else'
        '       case when (ctr.docs = '#39'N'#39') then'
        '              case when(l.tipo_l = '#39'S'#39') then'
        '                     (coalesce(l.valor_l, 0) * -1)'
        '                   else'
        
          '                     case when (coalesce(l.valor_l, 0)) <= 0 the' +
          'n'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   coalesce(pr.valor_quitado, 0)'
        '                                 else'
        '                                   coalesce(l.valor_l, 0)'
        '                            end'
        '                          else'
        '                            coalesce(l.valor_l, 0)'
        '                     end'
        '              end'
        '            else'
        '              0'
        '       end'
        'end valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.seq_bxcred), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.datq_c and l.tipo_l = '#39'E'#39
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        
          'where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_c is not nul' +
          'l'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 5, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is' +
          ' null) then pr.tipo_doc_c else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_c,'
        
          '999999 codigo_ctrl, '#39'CONTAS A PAGAR'#39' nome_ctrl, '#39'CONTAS A PAGAR'#39 +
          ' formpag,'
        'coalesce(pr.valor_quitado, 0) valor_pago,'
        'coalesce(pr.valor_quitado, 0) valorrateio,'
        '0 valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(pr.seq_bxcred, 0), 0'
        'from baixa_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join controle_creditos cc on cc.cod_cred = pr.cod_cred and ' +
          'cc.codigo_emp = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_c is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 5, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is' +
          ' null) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec_c,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else coalesce(l.valor_l, 0)'
        'end valor_pago,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else coalesce(l.valor_l, 0)'
        'end valorrateio,'
        ''
        'case when (ctr.docs = '#39'N'#39') then'
        '       case when(l.tipo_l = '#39'S'#39') then'
        '              (coalesce(l.valor_l, 0) * -1)'
        '            else coalesce(l.valor_l, 0)'
        '       end'
        '     else'
        '       0'
        'end valor_pago_vista,'
        'pr.datq_c, pr.data_venc_c,'
        'coalesce(l.cod_lanc, pr.cod_cred), 0'
        'from controle_creditos pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.data_rec_c'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        'union all'
        ''
        
          'select coalesce((case when (((select count(*) from hist_rec hist' +
          ' where hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.c' +
          'odigo_emp) > 0)'
        
          '                       and ((l.historico_l like '#39'%RECIBOS ATENCI' +
          'PADOS%'#39') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                        '#39'RECIBO'#39
        '                      when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                        '#39'DEVOLUCAO'#39
        '                      else'
        '                        '#39'DIRETO'#39' end),'
        #39'DIRETO'#39'),'
        
          '3, 6, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is null) then '#39#39' el' +
          'se ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_ch,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        0'
        '                      else'
        
          '                        case when (ctr.codigo_ctrl is null) then' +
          ' 0 else ctr.codigo_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.codigo_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.codigo_ctrl is nu' +
          'll) then 0 else ctr1.codigo_ctrl end'
        '                             else'
        '                               0'
        '                        end'
        '                      else'
        '                        ctr.codigo_ctrl'
        '                 end'
        '          end),'
        '0) codigo_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39')))  then'
        '                 case when (l.tipo_l = '#39'S'#39') then'
        '                        '#39'SEM FORMA'#39
        '                      else'
        
          '                        case when (ctr.nome_ctrl is null) then 0' +
          ' else ctr.nome_ctrl end'
        '                 end'
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        
          '                               case when (ctr1.nome_ctrl is null' +
          ') then 0 else ctr1.nome_ctrl end'
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') nome_ctrl,'
        ''
        
          'coalesce((case when (((select count(*) from hist_rec hist where ' +
          'hist.lote_quit = pr.lote_quit and hist.cod_empresa = pr.codigo_e' +
          'mp) > 0)'
        
          '                and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39 +
          ') or (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '                 '#39'RECIBO'#39
        '               else'
        '                 case when ctr.nome_ctrl is null then'
        
          '                        case when coalesce(pr.tip_baixa, '#39#39') = '#39 +
          'D'#39' then'
        '                               '#39'DEVOLUCAO'#39
        '                             else'
        '                               '#39'SEM FORMA'#39
        '                        end'
        '                      else'
        '                        ctr.nome_ctrl'
        '                 end'
        '          end),'
        #39'SEM FORMA'#39') formpag,'
        ''
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       case when (coalesce(l.valor_l, 0)) <= 0 then '
        '              case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '                     coalesce(pr.valor_ch, 0)'
        '                   else'
        '                     coalesce(pr.valor_ch, 0)'
        '              end'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        'end valor_pago,'
        ''
        'case when (coalesce((select count(*) from controle_cheque pr1'
        '                     where pr1.lote_quit = pr.lote_quit'
        
          '                     and pr1.codigo_emp =  pr.codigo_emp), 0) > ' +
          '0) then'
        '        (case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then '
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                             coalesce(pr.valor_ch, 0)'
        '                           else'
        '                             coalesce(pr.valor_ch, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '         end /'
        '         coalesce((select count(*) from controle_cheque pr1'
        '                     where pr1.lote_quit = pr.lote_quit'
        '                     and pr1.codigo_emp =  pr.codigo_emp), 0)'
        '        )'
        '    else'
        '        case when(l.tipo_l = '#39'S'#39') then'
        '               (coalesce(l.valor_l, 0) * -1)'
        '             else'
        '               case when (coalesce(l.valor_l, 0)) <= 0 then '
        
          '                      case when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39 +
          ' then'
        '                             coalesce(pr.valor_ch, 0)'
        '                           else'
        '                             coalesce(pr.valor_ch, 0)'
        '                      end'
        '                    else'
        '                      coalesce(l.valor_l, 0)'
        '               end'
        '        end'
        'end  valorrateio,'
        ''
        'case when (((select count(*) from hist_rec hist'
        '             where hist.lote_quit = pr.lote_quit'
        '             and hist.cod_empresa = pr.codigo_emp) > 0)'
        
          '             and ((l.historico_l like '#39'%RECIBOS ATENCIPADOS%'#39') o' +
          'r (l.historico_l like '#39'%RECIBOS ANTECIPADOS%'#39'))) then'
        '       0'
        '     when coalesce(pr.tip_baixa, '#39#39') = '#39'D'#39' then'
        '       0'
        '     else'
        '       case when (ctr.docs = '#39'N'#39') then'
        '              case when(l.tipo_l = '#39'S'#39') then'
        '                     (coalesce(l.valor_l, 0) * -1)'
        '                   else'
        
          '                     case when (coalesce(l.valor_l, 0)) <= 0 the' +
          'n'
        
          '                            case when coalesce(pr.tip_baixa, '#39#39')' +
          ' = '#39'D'#39' then'
        '                                   coalesce(pr.valor_ch, 0)'
        '                                 else'
        '                                   coalesce(pr.valor_ch, 0)'
        '                            end'
        '                          else'
        '                            coalesce(l.valor_l, 0)'
        '                     end'
        '              end'
        '            else'
        '              0'
        '       end'
        'end valor_pago_vista,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(l.cod_lanc, pr.codigo_ch), 0 from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.datq_ch and l.tipo_l = '#39'E'#39
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        
          'where coalesce(pr.tip_baixa, '#39#39') <> '#39'C'#39' and pr.datq_ch is not nu' +
          'll'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 6, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is' +
          ' null) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.datq_ch,'
        
          '999999 codigo_ctrl, '#39'CONTAS A PAGAR'#39' nome_ctrl, '#39'CONTAS A PAGAR'#39 +
          ' formpag,'
        'coalesce(pr.valor_ch, 0) valor_pago,'
        'coalesce(pr.valor_ch, 0) valorrateio,'
        '0 valor_pago_vista,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(pr.codigo_ch, 0), 0from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where pr.tip_baixa = '#39'C'#39' and pr.datq_ch is not null'
        ''
        'union all'
        ''
        
          'select '#39'DIRETO'#39', 3, 6, '#39'CREDIARIO'#39', case when (ctr1.nome_ctrl is' +
          ' null) then '#39#39' else ctr1.nome_ctrl end tipo2,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else pr.codigo_emp end) cod_empresa,'
        'pr.cod_emp_mult, pr.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       coalesce(l.valor_l, 0)'
        'end valor_pago,'
        'case when(l.tipo_l = '#39'S'#39') then'
        '       (coalesce(l.valor_l, 0) * -1)'
        '     else'
        '       coalesce(l.valor_l, 0)'
        'end valorrateio,'
        'case when (ctr.docs = '#39'N'#39') then'
        '       case when(l.tipo_l = '#39'S'#39') then'
        '              (coalesce(l.valor_l, 0) * -1)'
        '            else'
        '              coalesce(l.valor_l, 0)'
        '       end'
        '     else'
        '       0'
        'end valor_pago_vista,'
        'pr.datq_ch, pr.data_venc,'
        'coalesce(l.cod_lanc, pr.codigo_ch), 0'
        'from controle_cheque pr'
        'left join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = pr.cod_cliente and cl.' +
          'cod_empresa = pr.codigo_emp'
        
          'left join lancamentos l on l.lote_ent = pr.lote_quit and l.codig' +
          'o_emp = pr.codigo_emp and l.data = pr.data_rec'
        
          'left join CONTROLES ctr on ctr.codigo_ctrl = l.codigo_ctrl and c' +
          'tr.codigo_emp = l.codigo_emp'
        
          'left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctrl an' +
          'd ctr1.codigo_emp = pr.codigo_emp'
        'where coalesce(pr.status_ch, '#39#39') = '#39#39' and pr.datq_ch is null'
        ''
        'union all'
        ''
        'select '#39'DIRETO'#39', 2, 4, '#39'REC'#39', '#39'REC'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'left join formpagamento fp on fp.nrequisicao = rq.nrecibo and fp' +
          '.tpdocs = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp.recib' +
          'o is null'
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39
        ''
        'union all'
        ''
        'select '#39'TROCO'#39', 2, 4, '#39'REC'#39', '#39'REC'#39','
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then emp.codigo_unifi' +
          'cadora else rq.cod_empresa end) cod_empresa,'
        
          '(case when(emp.financeiro_unificado = '#39'S'#39') then coalesce(rq.cod_' +
          'emp_mult, rq.cod_empresa) else rq.cod_empresa end) cod_empresa,'
        'rq.data_rec,'
        
          'case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end ' +
          'codigo_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end nome_ctrl,'
        
          'case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.nome_c' +
          'trl end formpag,'
        'coalesce(fp.valordoc, 0) valordoc,'
        'coalesce(fp.valordoc, 0) valorrateio,'
        
          'case when (ctr.docs = '#39'N'#39') then coalesce(fp.valordoc, 0) else 0 ' +
          'end valor_pago_vista,'
        'fp.data_mov, fp.data_venc,'
        
          'coalesce(fp.seqform, rq.nrecibo), coalesce(fp.seqform, rq.nrecib' +
          'o)'
        'from recibos rq'
        'left join empresa emp on rq.cod_empresa = emp.cod_empresa'
        
          'left join clientes cl on cl.cod_cliente = rq.cod_devedor and cl.' +
          'cod_empresa = rq.cod_empresa'
        
          'inner join formpagamento fp on fp.rec_numvend = rq.nrecibo and f' +
          'p.rec_tipvend = '#39'REC'#39' and fp.cod_empresa = rq.cod_empresa and fp' +
          '.tpdocs = '#39'TRC'#39
        
          'left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and' +
          ' fp.cod_empresa = ctr.codigo_emp'
        'where rq.recant = '#39'S'#39';'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SAIDAS_RECEB_MERCADORIA_CXL ('
        '    PDATAINI timestamp,'
        '    PDATAFIM timestamp,'
        '    PCODEMPRESA integer,'
        '    POPCXL integer,'
        '    PAGRUPAROPERADORES char(1))'
        'returns ('
        '    ORDEM integer,'
        '    MODALIDADE varchar(30),'
        '    TIPO char(10),'
        '    NOME_CLIENTE varchar(50),'
        '    OP_CXL integer,'
        '    NOME_OP_CXL varchar(35),'
        '    DATA_FECH timestamp,'
        '    NPED integer,'
        '    VALOR_TOTAL double precision,'
        '    VALOR_LOTE double precision,'
        '    QTDE_LOTE integer,'
        '    COD_CRED integer,'
        '    AGRUPAR_OPERADORES char(1),'
        '    FINANCEIRO_UNIFICADO char(1),'
        '    COD_EMPRESA integer,'
        '    COD_EMP_MULT integer,'
        '    CODEMPRESA_TEMP integer,'
        '    IDENTIFICACAO_EMP_TEMP varchar(64),'
        '    EXIBIR_EMP char(1),'
        '    VALORDINHEIRO double precision,'
        '    VALORRECEBIMENTO double precision,'
        '    DATA_INI timestamp,'
        '    DATA_FIM timestamp)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  for select case when (pv.tipo = '#39'REQ'#39') then 2 else 3 end ordem' +
          ','
        '    '#39'A Vista'#39' modalidade, pv.tipo, cl.nome_cliente,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else pv.op_c' +
          'xl end op_cxl,'
        
          '    case when (:pagruparoperadores = '#39'S'#39') then null else col.nom' +
          'e_vendedor end nome_op_cxl,'
        '    pv.dia_cxl as data_fech, pv.nped,'
        '    coalesce(pv.valor_total, 0) valor_total,'
        '    coalesce(pv.valor_total, 0) valor_lote,'
        '    1 qtde_lote,'
        '    null cod_cred,'
        '    :pAgruparOperadores agrupar_operadores,'
        '    emp.financeiro_unificado,'
        '    pv.cod_empresa as cod_empresa,'
        '    pv.cod_empresa as cod_emp_mult,'
        '    emp2.cod_empresa as codempresa_temp,'
        '    emp2.identificacao_emp as identificacao_emp_temp,'
        '    '#39'N'#39' as exibir_emp,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '             inner join controles ctr on ctr.codigo_ctrl = fp.co' +
          'd_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '             where fp.nrequisicao = pv.nped and fp.tpdocs = pv.t' +
          'ipo and fp.cod_empresa = pv.cod_empresa'
        '             and ctr.docs = '#39'N'#39
        '             and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        
          '             and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39'), 0) va' +
          'lordinheiro,'
        
          '    coalesce((select sum(coalesce(fp.valordoc, 0)) from formpaga' +
          'mento fp'
        
          '             inner join controles ctr on ctr.codigo_ctrl = fp.co' +
          'd_controle and ctr.codigo_emp = fp.cod_empresa'
        
          '             where fp.nrequisicao = pv.nped and fp.tpdocs = pv.t' +
          'ipo and fp.cod_empresa = pv.cod_empresa), 0) valorrecebimento,'
        
          '    cast(:pdataIni as timestamp) data_ini, cast(:pdataFim  as ti' +
          'mestamp) data_fim'
        '    from pedvenda pv'
        '    inner join empresa emp on emp.cod_empresa = pv.cod_empresa'
        '    left join empresa emp2 on emp2.cod_empresa = pv.cod_empresa'
        
          '    inner join clientes cl on cl.cod_cliente = pv.cod_cliente an' +
          'd cl.cod_empresa = pv.cod_empresa'
        
          '    left join colaborador col on col.cod_vendedor = pv.op_cxl an' +
          'd col.cod_empresa = pv.cod_empresa'
        '    where pv.dia_cxl >= :pdataIni'
        '    and pv.dia_cxl <= :pdataFim'
        '    and pv.cod_empresa = :pCodEmpresa'
        '    and pv.tipo <> '#39'ORC'#39
        '    and pv.status_ped = '#39'FECHADA'#39
        
          '    and (select sum(coalesce(fp.valordoc, 0)) from formpagamento' +
          ' fp'
        
          '         inner join controles ctr on ctr.codigo_ctrl = fp.cod_co' +
          'ntrole and ctr.codigo_emp = fp.cod_empresa'
        
          '         where fp.nrequisicao = pv.nped and fp.tpdocs = pv.tipo ' +
          'and fp.cod_empresa = pv.cod_empresa'
        '         and ctr.docs = '#39'N'#39
        '         and coalesce(fp.recibo, '#39#39') <> '#39'S'#39
        '         and coalesce(ctr.nao_gera_finan, '#39#39') <> '#39'S'#39') > 0'
        '    union'
