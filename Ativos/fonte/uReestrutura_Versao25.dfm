          'RRIGIR QUANTIDADE / CUSTO NOTA FISCAL'#39', 10, '#39'FRMCADPRODUTOS'#39', 1,' +
          ' '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO444'#39', :COD_EMPRESA, '#39'RE' +
          'CALCULAR ESTOQUE DO ESTOQUE DIARIO'#39', 10, '#39'FRMCADPRODUTOS'#39', 1, '#39'S' +
          #39', '#39'S'#39', CURRENT_DATE);'
        
