        'CREATE TABLE COD_ETIQ ('
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    VALOR        BIGINT'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE COD_ETIQ ADD CONSTRAINT PK_COD_ETIQ PRIMARY KEY (COD' +
          '_EMPRESA);'
        ''
        '|BLOCO|'
        'create or alter procedure INCREMENTA_ETIQ ('
        '    VCOD_EMPRESA integer)'
        'returns ('
        '    COD integer)'
        'as'
        'declare variable VALOR bigint;'
        'begin'
        '  select VALOR from COD_ETIQ'
        '  where COD_EMPRESA = :VCOD_EMPRESA'
        '    into :VALOR;'
        ''
        '  if (VALOR is null) then'
        '    insert into COD_ETIQ (COD_EMPRESA, VALOR)'
        '    values (:VCOD_EMPRESA, 0);'
        ''
        '  update COD_ETIQ set VALOR = coalesce(VALOR, 0) + 1'
        '  where COD_EMPRESA = :VCOD_EMPRESA;'
        ''
        '  select VALOR from COD_ETIQ'
        '  where COD_EMPRESA = :VCOD_EMPRESA'
        '    into :COD;'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE COD_BARRA_ETIQ ('
        '    GRUPO_PROD   INTEGER NOT NULL,'
        '    COD_PROD     CHAR(6) NOT NULL,'
        '    COD_GRADE    INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    COD_ETIQ     BIGINT'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE COD_BARRA_ETIQ ADD CONSTRAINT PK_COD_BARRA_ETIQ PRIM' +
          'ARY KEY (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA);'
        
          'ALTER TABLE COD_BARRA_ETIQ ADD CONSTRAINT FK_COD_BARRA_ETIQ_PROD' +
          'UTOS FOREIGN KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA) REFERENCES ' +
          'PRODUTOS (GRUPO_PROD, COD_PROD, COD_EMPRESA) ON DELETE CASCADE O' +
          'N UPDATE CASCADE;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_COD_BARRA_ETIQ_INSERT FOR COD_BARRA_E' +
          'TIQ'
        'ACTIVE BEFORE INSERT POSITION 0'
        'AS'
        '  declare variable cod bigint;'
        'begin'
        '  /* Trigger text */'
        '  if (new.cod_etiq is null) then'
        '  begin'
        '    select cod from incrementa_etiq(new.cod_empresa) into :cod;'
        '    new.cod_etiq = cod;'
        '  end'
        'end;'
        '|/BLOCO|'
