        ''
        '    if (coalesce(new.guidt, '#39#39') = '#39#39') then'
        '      new.guidt = (select guid from spdb_guid);'
        '  '
        '    EXECUTE PROCEDURE'
        
          '    sp_handle_hist_preco(coalesce(new.preco_venda, 0), 0, :custo' +
          ', 0, new.quant, new.guidt, new.cod_empresa, new.grupo_prod, new.' +
          'cod_prod);'
