          'res, :financeiro_unificado, :cod_empresa,'
        
          '        :cod_emp_mult, :codempresa_temp, :identificacao_emp_temp' +
          ', :exibir_emp, :valorrecebimento, :valordinheiro, :data_ini, :da' +
