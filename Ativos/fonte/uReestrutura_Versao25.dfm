        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_ATIVIDADES_REPARP('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    ESTADO_VEIC,'
        '    DEFEITO,'
        '    ACESSORIOS,'
        '    OBS_OS,'
        '    SELOS_COL,'
        '    SELOS_REM,'
        '    LACRES_COL,'
        '    LACRES_REM,'
        '    OBS_TPVENDA,'
        '    ESTADO_VEIC1,'
        '    ESTADO_VEIC2,'
        '    DEFEITO1,'
        '    DEFEITO2,'
        '    ACESSORIOS1,'
        '    ACESSORIOS2,'
        '    OBS_OS1,'
        '    OBS_OS2,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2,'
        '    OBS_TPVENDA1,'
        '    OBS_TPVENDA2)'
        'AS'
        'select nped, tipo, cod_empresa,'
        
          'cast(substring(estado_veic from 1 for 400) as varchar(400)) esta' +
          'do_veic,'
        'cast(substring(defeito from 1 for 400) as varchar(400)) defeito,'
        
          'cast(substring(acessorios from 1 for 400) as varchar(400)) acess' +
          'orios,'
        'cast(substring(obs_os from 1 for 400) as varchar(400)) obs_os,'
        
          'cast(substring(selos_col from 1 for 400) as varchar(400)) selos_' +
          'col,'
        
          'cast(substring(selos_rem from 1 for 400) as varchar(400)) selos_' +
          'rem,'
        
          'cast(substring(lacres_col from 1 for 400) as varchar(400)) lacre' +
          's_col,'
        
          'cast(substring(lacres_rem from 1 for 400) as varchar(400)) lacre' +
          's_rem,'
        
          'cast(substring(obs_tpvenda from 1 for 400) as varchar(400)) obs_' +
          'tpvenda,'
        
          'cast(substring(estado_veic from 1 for 200) as varchar(200)) esta' +
          'do_veic1,'
        
          'cast(substring(estado_veic from 201 for 200) as varchar(200)) es' +
          'tado_veic2,'
        
          'cast(substring(defeito from 1 for 200) as varchar(200)) defeito1' +
          ','
        
          'cast(substring(defeito from 201 for 200) as varchar(200)) defeit' +
          'o2,'
        
          'cast(substring(acessorios from 1 for 200) as varchar(200)) acess' +
          'orios1,'
        
          'cast(substring(acessorios from 201 for 200) as varchar(200)) ace' +
          'ssorios2,'
        'cast(substring(obs_os from 1 for 200) as varchar(200)) obs_os1,'
        
          'cast(substring(obs_os from 201 for 200) as varchar(200)) obs_os2' +
          ','
        
          'cast(substring(selos_col from 1 for 200) as varchar(200)) selos_' +
          'col1,'
        
          'cast(substring(selos_col from 201 for 200) as varchar(200)) selo' +
          's_col2,'
        
          'cast(substring(selos_rem from 1 for 200) as varchar(200)) selos_' +
          'rem1,'
        
          'cast(substring(selos_rem from 201 for 200) as varchar(200)) selo' +
          's_rem2,'
        
          'cast(substring(lacres_col from 1 for 200) as varchar(200)) lacre' +
          's_col1,'
        
          'cast(substring(lacres_col from 201 for 200) as varchar(200)) lac' +
          'res_col2,'
        
          'cast(substring(lacres_rem from 1 for 200) as varchar(200)) lacre' +
          's_rem1,'
        
          'cast(substring(lacres_rem from 201 for 200) as varchar(200)) lac' +
          'res_rem2,'
        
          'cast(substring(obs_tpvenda from 1 for 200) as varchar(200)) obs_' +
          'tpvenda1,'
        
          'cast(substring(obs_tpvenda from 201 for 200) as varchar(200)) ob' +
          's_tpvenda2 from pedvenda;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure INSERIR_ETIQUETA_DANFE_SIMP ('
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VEXISTE_DANFE_SIMPL integer;'
        'declare variable VCOD_DANFE integer;'
        'declare variable VCOD_MAX_DANFE integer;'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'OK'#39';'
        ''
        '  select c.cod_empresa from cabecalho_etiqueta c'
        '  where c.tabela = '#39'NOTAFISCAL_DANFE'#39
        '  and c.descricao = '#39'DANFE SIMPLIFICADO'#39
        '  and c.cod_empresa = :pcod_empresa into :vexiste_danfe_simpl;'
        ''
        '  if (coalesce(vexiste_danfe_simpl, 0) <= 0) then'
        '  begin'
        '    select first 1 c.cod_etiqueta from cabecalho_etiqueta c'
        '    where c.cod_empresa = :pcod_empresa'
        '    order by c.cod_etiqueta desc into :vcod_max_danfe;'
        ''
        
          '    select cod from incrementa_codigo (:pcod_empresa, '#39'CABECALHO' +
          '_ETIQUETA'#39') into :vcod_danfe;'
        ''
        '    if ((coalesce(vcod_max_danfe, 0) > 0)'
        
          '       and (coalesce(vcod_max_danfe, 0) + 1 > coalesce(vcod_danf' +
          'e, 0))) then'
        '    begin'
        '        vcod_danfe = vcod_max_danfe + 1;'
        ''
        
          '        update codigo cd set cd.valor = coalesce(:vcod_max_danfe' +
          ', 0)'
        '        where cd.tabela = '#39'CABECALHO_ETIQUETA'#39
        '        and cd.cod_empresa = :pcod_empresa;'
        '    end'
        ''
        '    -- Cabecalho'
        
          '    INSERT INTO CABECALHO_ETIQUETA (COD_ETIQUETA, COD_EMPRESA, T' +
          'AMANHO_P, DESCRICAO, TABELA, COLUNAS, COMPRIMENTO_P, LARGURA_P, ' +
          'DISTANCIA_ENTRECOL, TAMANHO_ETI_V, MARGEM_SUPERIOR, MARGEM_INFER' +
          'IOR, MARGEM_ESQUERDA, MARGEM_DIREITA, ORIENTACAO, ATIVO, PORTA, ' +
          'AGENTE_ID, QUANT_IMPRESSAO)'
        
          '    VALUES (:vcod_danfe, :pcod_empresa, '#39'Custom Size'#39', '#39'DANFE SI' +
          'MPLIFICADO'#39', '#39'NOTAFISCAL_DANFE'#39', 1, 110, 90, 0, 110, 0, 0, 0, 0,' +
          ' 0, 1, NULL, NULL, 0);'
        ''
        '    -- Campos'
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
          'ULADO, CAMPOCODBARRA, CAMPOIMAGEM, QUEBRA_LINHA, CODBARRA_VIS_TE' +
          'XTO, CODBARRA_TIPO, ALTURA, COMPRIMENTO, ALINHAMENTO, FORMATO_MO' +
          'NETARIO, MASCARAR_VALOR, FORMULA, AUTOSIZE, BARCODE, AUTOWIDTH, ' +
          'STRETCH, CAMPOVARIAVEL, TEXTOCAMPOVARIAVEL, CAMPOSISTEMA, TIPOSI' +
          'STEMA, QTDEZEROESQUERDA, CASASDECIMAIS, VALOR_DEFAULT)'
        
          '    VALUES (:vcod_danfe, 1, :pcod_empresa, '#39'DANFE SIMPLIFICADO -' +
          ' ETIQUETA'#39', '#39'FIXO1'#39', '#39'S'#39', '#39'DANFE Simplificado - Etiqueta'#39', 333, ' +
          #39'Arial'#39', 10, '#39'clWindowText'#39', '#39'S'#39', '#39'N'#39', '#39'N'#39', 1, 1, 1, NULL, NULL,' +
          ' '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', NULL, NULL, 16, 333, '#39'CENTRO'#39', NULL, NULL, ' +
          'NULL, '#39'N'#39', NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N'#39', '#39#39', NULL, NULL, NULL)' +
          ';'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
          'ULADO, CAMPOCODBARRA, CAMPOIMAGEM, QUEBRA_LINHA, CODBARRA_VIS_TE' +
          'XTO, CODBARRA_TIPO, ALTURA, COMPRIMENTO, ALINHAMENTO, FORMATO_MO' +
          'NETARIO, MASCARAR_VALOR, FORMULA, AUTOSIZE, BARCODE, AUTOWIDTH, ' +
          'STRETCH, CAMPOVARIAVEL, TEXTOCAMPOVARIAVEL, CAMPOSISTEMA, TIPOSI' +
          'STEMA, QTDEZEROESQUERDA, CASASDECIMAIS, VALOR_DEFAULT)'
        
          '    VALUES (:vcod_danfe, 2, :pcod_empresa, '#39'OPERACAO:'#39', '#39'FIXO2'#39',' +
          ' '#39'S'#39', '#39'OPERACAO:'#39', 64, '#39'Arial'#39', 8, '#39'clWindowText'#39', '#39'S'#39', '#39'N'#39', '#39'N'#39 +
          ', 9, 23, 1, NULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', NULL, NULL, 12, 64, ' +
          #39'ESQUERDA'#39', NULL, NULL, NULL, '#39'N'#39', NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N' +
          #39', '#39#39', NULL, NULL, NULL);'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
          'ULADO, CAMPOCODBARRA, CAMPOIMAGEM, QUEBRA_LINHA, CODBARRA_VIS_TE' +
          'XTO, CODBARRA_TIPO, ALTURA, COMPRIMENTO, ALINHAMENTO, FORMATO_MO' +
          'NETARIO, MASCARAR_VALOR, FORMULA, AUTOSIZE, BARCODE, AUTOWIDTH, ' +
          'STRETCH, CAMPOVARIAVEL, TEXTOCAMPOVARIAVEL, CAMPOSISTEMA, TIPOSI' +
          'STEMA, QTDEZEROESQUERDA, CASASDECIMAIS, VALOR_DEFAULT)'
        
          '    VALUES (:vcod_danfe, 3, :pcod_empresa, '#39'SAIDA'#39', '#39'DESC_NATURE' +
          'ZA_NF'#39', '#39'N'#39', '#39#39', 80, '#39'Arial'#39', 8, '#39'clWindowText'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', ' +
          '9, 42, 1, NULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', NULL, NULL, 12, 80, '#39'E' +
          'SQUERDA'#39', NULL, NULL, NULL, '#39'N'#39', NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N'#39',' +
          ' '#39#39', NULL, NULL, NULL);'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
