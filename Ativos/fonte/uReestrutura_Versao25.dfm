        '|BLOCO|'
        'create or alter procedure INSERIR_ETIQUETA_DADOS_TRANSP ('
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VEXISTE_DADOS_TRANSP integer;'
        'declare variable VCOD_TRANSP integer;'
        'declare variable VCOD_MAX_TRANSP integer;'
        'begin'
        '  /* Procedure Text */'
        '  RESULT = '#39'OK'#39';'
        ''
        '  select c.cod_empresa from cabecalho_etiqueta c'
        '  where c.tabela = '#39'NOTAFISCAL_DANFE'#39
        '  and c.descricao = '#39'DADOS TRANSPORTE'#39
        '  and c.cod_empresa = :pcod_empresa into :vexiste_dados_transp;'
        ''
        '  if (coalesce(vexiste_dados_transp, 0) <= 0) then'
        '  begin'
        '    select first 1 c.cod_etiqueta from cabecalho_etiqueta c'
        '    where c.cod_empresa = :pcod_empresa'
        '    order by c.cod_etiqueta desc into :vcod_max_transp;'
        ''
        
          '    select cod from incrementa_codigo (:pcod_empresa, '#39'CABECALHO' +
          '_ETIQUETA'#39') into :vcod_transp;'
        ''
        '    if ((coalesce(vcod_max_transp, 0) > 0)'
        
          '       and (coalesce(vcod_max_transp, 0) + 1 > coalesce(vcod_tra' +
          'nsp, 0))) then'
        '    begin'
        '        vcod_transp = vcod_max_transp + 1;'
        ''
        
          '        update codigo cd set cd.valor = coalesce(:vcod_max_trans' +
          'p, 0)'
        '        where cd.tabela = '#39'CABECALHO_ETIQUETA'#39
        '        and cd.cod_empresa = :pcod_empresa;'
        '    end'
        ''
        '    -- Cabecalho'
        
          '    INSERT INTO CABECALHO_ETIQUETA (COD_ETIQUETA, COD_EMPRESA, T' +
          'AMANHO_P, DESCRICAO, TABELA, COLUNAS, COMPRIMENTO_P, LARGURA_P, ' +
          'DISTANCIA_ENTRECOL, TAMANHO_ETI_V, MARGEM_SUPERIOR, MARGEM_INFER' +
          'IOR, MARGEM_ESQUERDA, MARGEM_DIREITA, ORIENTACAO, ATIVO, PORTA, ' +
          'AGENTE_ID, QUANT_IMPRESSAO)'
        
          '    VALUES (:vcod_transp, :pcod_empresa, '#39'Custom Size'#39', '#39'DADOS T' +
          'RANSPORTE'#39', '#39'NOTAFISCAL_DANFE'#39', 1, 90, 105, 0, 90, 0, 0, 0, 0, 0' +
          ', 1, NULL, NULL, 1);'
        ''
        '    -- Campos'
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
          'ULADO, CAMPOCODBARRA, CAMPOIMAGEM, QUEBRA_LINHA, ALTURA, COMPRIM' +
          'ENTO, AUTOSIZE, ALINHAMENTO, FORMATO_MONETARIO, MASCARAR_VALOR, ' +
          'FORMULA, BARCODE, CODBARRA_VIS_TEXTO, CODBARRA_TIPO, AUTOWIDTH, ' +
          'STRETCH, CAMPOVARIAVEL, TEXTOCAMPOVARIAVEL, CAMPOSISTEMA, TIPOSI' +
          'STEMA, QTDEZEROESQUERDA, CASASDECIMAIS, VALOR_DEFAULT)'
        
          '    VALUES (:vcod_transp, 1, :pcod_empresa, '#39'VOLUME:'#39', '#39'FIXO1'#39', ' +
          #39'S'#39', '#39'VOLUME:'#39', 49, '#39'Arial'#39', 8, '#39'clWindowText'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', 4' +
          ', 22, 1, NULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', 12, 49, '#39'N'#39', '#39'ESQUERDA'#39 +
          ', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N'#39', ' +
          #39#39', NULL, NULL, NULL);'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
          '_EMPRESA, DESCRICAO, CAMPO, CAMPOFIXO, VALORCAMPOFIXO, TAMANHO, ' +
          'NOME_FONTE, TAMANHO_FONTE, COR_FONTE, NEGRITO, ITALICO, SUBLINHA' +
          'DO, POSICAO_V, POSICAO_H, ATIVO, QTDCASASDEC, MASCARA, CAMPOCALC' +
