          '    VALUES (:vcod_danfe, 6, :pcod_empresa, '#39'SERIE:'#39', '#39'FIXO4'#39', '#39'S' +
          #39', '#39'SERIE:'#39', 36, '#39'Arial'#39', 8, '#39'clWindowText'#39', '#39'S'#39', '#39'N'#39', '#39'N'#39', 17, ' +
          '23, 1, NULL, NULL, '#39'N'#39', '#39'N'#39', '#39'N'#39', '#39'N'#39', NULL, NULL, 12, 36, '#39'ESQU' +
          'ERDA'#39', NULL, NULL, NULL, '#39'N'#39', NULL, NULL, NULL, '#39'N'#39', '#39#39', '#39'N'#39', '#39#39 +
          ', NULL, NULL, NULL);'
        ''
        
          '    INSERT INTO CAMPOS_ETIQUETA (COD_ETIQUETA, COD_CAMPOETI, COD' +
