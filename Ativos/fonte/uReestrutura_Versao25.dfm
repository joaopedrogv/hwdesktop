          'CALCULAR CUSTO PRODUTO ACABADO'#39', 10, '#39'FRMCADPRODUTOS'#39', 1, '#39'S'#39', '#39 +
          'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_NUMDOC_INI_FIM ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PTIPO char(3),'
        '    PDATAINI timestamp,'
        '    PDATAFIM timestamp)'
        'returns ('
        '    NUMDOC_INI integer,'
        '    NUMDOC_FIM integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        
          '  if ((trim(ptipo) = '#39'REQ'#39') or (trim(ptipo) = '#39'OS'#39') or (trim(pti' +
          'po) = '#39'ORC'#39')) then'
        '  begin'
        '    select first 1 pd.nped from pedvenda pd'
        '    inner join pedvenda_prod pp on'
        '      pp.nped = pd.nped'
        '      and pp.tipo = pd.tipo'
        '      and pp.cod_empresa = pd.cod_empresa'
        '    where pp.tipo = :ptipo'
        '    and pp.cod_empresa = :pcod_empresa'
        '    and pp.grupo_prod = :pgrupo_prod'
        '    and pp.cod_prod = :pcod_prod'
        '    and pd.data_estoque >= :pdataini'
        '    and pd.data_estoque <= :pdatafim'
        '    order by pd.nped'
        '      into :numdoc_ini;'
        ''
        '    select first 1 pd.nped from pedvenda pd'
        '    inner join pedvenda_prod pp on'
        '      pp.nped = pd.nped'
        '      and pp.tipo = pd.tipo'
        '      and pp.cod_empresa = pd.cod_empresa'
        '    where pp.tipo = :ptipo'
        '    and pp.cod_empresa = :pcod_empresa'
        '    and pp.grupo_prod = :pgrupo_prod'
        '    and pp.cod_prod = :pcod_prod'
        '    and pd.data_estoque >= :pdataini'
        '    and pd.data_estoque <= :pdatafim'
        '    order by pd.nped desc'
        '      into :numdoc_fim;'
        '  end'
        '  else if (trim(ptipo) = '#39'NF'#39') then'
        '  begin'
        '    select first 1 nf.cod_nf from notafiscal nf'
        '    inner join notafiscal_item nfi on'
        '      nfi.cod_nf = nf.cod_nf'
        '      and nfi.cod_empresa = nf.cod_empresa'
        '    where nf.natureza_nf = '#39'S'#39
        '    and nf.cod_empresa = :pcod_empresa'
        '    and nfi.codigo_nop > 3000'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    and nf.data_lanc >= :pdataini'
        '    and nf.data_lanc <= :pdatafim'
        '    order by nf.cod_nf'
        '      into :numdoc_ini;'
        ''
        '    select first 1 nf.cod_nf from notafiscal nf'
        '    inner join notafiscal_item nfi on'
        '      nfi.cod_nf = nf.cod_nf'
        '      and nfi.cod_empresa = nf.cod_empresa'
        '    where nf.natureza_nf = '#39'S'#39
        '    and nf.cod_empresa = :pcod_empresa'
        '    and nfi.codigo_nop > 3000'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    and nf.data_lanc >= :pdataini'
        '    and nf.data_lanc <= :pdatafim'
        '    order by nf.cod_nf desc'
        '      into :numdoc_fim;'
        '  end'
        '  else if (trim(ptipo) = '#39'DEV'#39') then'
        '  begin'
        '    select first 1 dev.sequencia from devolucao dev'
        '    where dev.grupo_prod = :pgrupo_prod'
        '    and dev.cod_prod = :pcod_prod'
        '    and dev.cod_empresa = :pcod_empresa'
        '    and dev.data_estoque >= :pdataini'
        '    and dev.data_estoque <= :pdataini'
        '    order by dev.sequencia'
        '      into :numdoc_ini;'
        ''
        '    select first 1 dev.sequencia from devolucao dev'
        '    where dev.grupo_prod = :pgrupo_prod'
        '    and dev.cod_prod = :pcod_prod'
        '    and dev.cod_empresa = :pcod_empresa'
        '    and dev.data_estoque >= :pdataini'
        '    and dev.data_estoque <= :pdataini'
        '    order by dev.sequencia desc'
        '      into :numdoc_ini;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATUALIZAR_CUSTO_ACAB_DOC ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PDATA_INI timestamp,'
        '    PDATA_FIM timestamp,'
        '    PCUSTO_MEDIO double precision)'
        'as'
        'declare variable VNUMDOC_INI integer;'
        'declare variable VNUMDOC_FIM integer;'
        'begin'
        '  /* Procedure Text */'
        '  '
        '  -- Corrigir custo '
        '  update estoque_diario est set'
        '    est.custo_medio = coalesce(:pcusto_medio, 0)'
        '  where est.grupo_prod = :pgrupo_prod'
        '  and est.cod_prod = :pcod_prod'
        '  and est.cod_empresa = :pcod_empresa'
        '  and est.dia >= :pdata_ini'
        '  and est.dia <= :pdata_fim;'
        '  '
        '  update custos c set'
        '    c.pr_cusc_prod = coalesce(:pcusto_medio, 0),'
        '    c.prec_cus_med = coalesce(:pcusto_medio, 0)'
        '  where c.grupo_prod = :pgrupo_prod'
        '  and c.cod_prod = :pcod_prod'
        '  and c.cod_empresa = :pcod_empresa'
        '  and c.data >= :pdata_ini'
        '  and c.data <= :pdata_fim;'
        ''
        '  -- Atualizar requisicoes'
        '  select numdoc_ini, numdoc_fim from retorna_numdoc_ini_fim('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    '#39'REQ'#39','
        '    :pdata_ini,'
        '    :pdata_fim)'
        '      into :vnumdoc_ini, :vnumdoc_fim;'
        '    '
        
          '  if ((coalesce(vnumdoc_ini, 0) > 0) and (coalesce(vnumdoc_fim, ' +
          '0) > 0)) then'
        '  begin'
        '    update pedvenda_prod pp set'
        '      pp.pcust_c  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_r  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mc = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mr = coalesce(:pcusto_medio, 0)'
        '    where pp.nped >= :vnumdoc_ini'
        '    and pp.nped <= :vnumdoc_fim'
        '    and pp.tipo = '#39'REQ'#39
        '    and pp.grupo_prod = :pgrupo_prod'
        '    and pp.cod_prod = :pcod_prod'
        '    and pp.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario hd set'
        '      hd.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hd.numero >= :vnumdoc_ini'
        '    and hd.numero <= :vnumdoc_fim'
        '    and hd.tipor = '#39'REQ'#39
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    and hd.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario_prod hp set'
        '      hp.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hp.numero >= :vnumdoc_ini'
        '    and hp.numero <= :vnumdoc_fim'
        '    and hp.tipor = '#39'REQ'#39
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    and hp.cod_empresa = :pcod_empresa;'
        '  end'
        ''
        '  -- Atualizar ordem de servico'
        '  select numdoc_ini, numdoc_fim from retorna_numdoc_ini_fim('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    '#39'OS'#39','
        '    :pdata_ini,'
        '    :pdata_fim)'
        '      into :vnumdoc_ini, :vnumdoc_fim;'
        '    '
        
          '  if ((coalesce(vnumdoc_ini, 0) > 0) and (coalesce(vnumdoc_fim, ' +
          '0) > 0)) then'
        '  begin'
        '    update pedvenda_prod pp set'
        '      pp.pcust_c  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_r  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mc = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mr = coalesce(:pcusto_medio, 0)'
        '    where pp.nped >= :vnumdoc_ini'
        '    and pp.nped <= :vnumdoc_fim'
        '    and pp.tipo = '#39'OS'#39
        '    and pp.grupo_prod = :pgrupo_prod'
        '    and pp.cod_prod = :pcod_prod'
        '    and pp.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario hd set'
        '      hd.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hd.numero >= :vnumdoc_ini'
        '    and hd.numero <= :vnumdoc_fim'
        '    and hd.tipor = '#39'OS'#39
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    and hd.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario_prod hp set'
        '      hp.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hp.numero >= :vnumdoc_ini'
        '    and hp.numero <= :vnumdoc_fim'
        '    and hp.tipor = '#39'OS'#39
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    and hp.cod_empresa = :pcod_empresa;'
        '  end'
        ''
        '  -- Atualizar orcamentos'
        '  select numdoc_ini, numdoc_fim from retorna_numdoc_ini_fim('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    '#39'ORC'#39','
        '    :pdata_ini,'
        '    :pdata_fim)'
        '      into :vnumdoc_ini, :vnumdoc_fim;'
        '    '
        
          '  if ((coalesce(vnumdoc_ini, 0) > 0) and (coalesce(vnumdoc_fim, ' +
          '0) > 0)) then'
        '  begin'
        '    update pedvenda_prod pp set'
        '      pp.pcust_c  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_r  = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mc = coalesce(:pcusto_medio, 0),'
        '      pp.pcust_mr = coalesce(:pcusto_medio, 0)'
        '    where pp.nped >= :vnumdoc_ini'
        '    and pp.nped <= :vnumdoc_fim'
        '    and pp.tipo = '#39'ORC'#39
        '    and pp.grupo_prod = :pgrupo_prod'
        '    and pp.cod_prod = :pcod_prod'
        '    and pp.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario hd set'
        '      hd.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hd.numero >= :vnumdoc_ini'
        '    and hd.numero <= :vnumdoc_fim'
        '    and hd.tipor = '#39'ORC'#39
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    and hd.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario_prod hp set'
        '      hp.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hp.numero >= :vnumdoc_ini'
        '    and hp.numero <= :vnumdoc_fim'
        '    and hp.tipor = '#39'ORC'#39
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    and hp.cod_empresa = :pcod_empresa;'
        '  end'
        ''
        '  -- Atualizar devolucao'
        '  select numdoc_ini, numdoc_fim from retorna_numdoc_ini_fim('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    '#39'DEV'#39','
        '    :pdata_ini,'
        '    :pdata_fim)'
        '      into :vnumdoc_ini, :vnumdoc_fim;'
        ''
        
          '  if ((coalesce(vnumdoc_ini, 0) > 0) and (coalesce(vnumdoc_fim, ' +
          '0) > 0)) then'
        '  begin'
        '    update devolucao dev set'
        '      dev.pcust_mc  = coalesce(:pcusto_medio, 0)'
        '    where dev.sequencia >= :vnumdoc_ini'
        '    and dev.sequencia <= :vnumdoc_fim'
        '    and dev.grupo_prod = :pgrupo_prod'
        '    and dev.cod_prod = :pcod_prod'
        '    and dev.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario hd set'
        '      hd.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hd.numero >= :vnumdoc_ini'
        '    and hd.numero <= :vnumdoc_fim'
        '    and hd.tipor = '#39'DEV'#39
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    and hd.cod_empresa = :pcod_empresa;'
        ''
        '    update hist_estoque_diario_prod hp set'
        '      hp.custo_med = coalesce(:pcusto_medio, 0)'
        '    where hp.numero >= :vnumdoc_fim'
        '    and hp.numero <= :vnumdoc_ini'
        '    and hp.tipor = '#39'DEV'#39
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    and hp.cod_empresa = :pcod_empresa;'
        '  end'
        ''
        '  -- Atualizar notafiscal saida'
        '  select numdoc_ini, numdoc_fim from retorna_numdoc_ini_fim('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_empresa,'
        '    '#39'NF'#39','
        '    :pdata_ini,'
        '    :pdata_fim)'
        '      into :vnumdoc_ini, :vnumdoc_fim;'
        '    '
        
          '  if ((coalesce(vnumdoc_ini, 0) > 0) and (coalesce(vnumdoc_fim, ' +
          '0) > 0)) then'
        '  begin'
        '    update notafiscal_item nfi set'
        '      nfi.prec_cus_rep  = coalesce(:pcusto_medio, 0),'
        '      nfi.prec_cus_cnt  = coalesce(:pcusto_medio, 0),'
        '      nfi.prec_cus_r = coalesce(:pcusto_medio, 0),'
        '      nfi.prec_cusm_prod = coalesce(:pcusto_medio, 0)'
        '    where nfi.cod_nf >= :vnumdoc_ini'
        '    and nfi.cod_nf <= :vnumdoc_fim'
        '    and nfi.codigo_nop > 3000'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    and nfi.cod_empresa = :pcod_empresa;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATRIBUIR_CUSTO_DATA_ANT ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'as'
        'declare variable VSEQID integer;'
        'declare variable VDATA_ANT timestamp;'
        'declare variable VCUSTO_MEDIO double precision;'
        'declare variable VCOD_CORRECAO integer;'
        'declare variable VCOD_NF integer;'
        'declare variable VCOD_PRODUCAO integer;'
        'begin'
        '  /* Procedure Text */'
        '  vcusto_medio  = 0;'
        '  vcod_correcao = 0;'
        '  vcod_nf       = 0;'
        '  vcod_producao = 0;'
        
          '  select first 1 est.seqid, est.dia, est.custo_medio from estoqu' +
          'e_diario est'
        '  where est.grupo_prod = :pgrupo_prod'
        '  and est.cod_prod = :pcod_prod'
        '  and est.cod_grade = :pcod_grade'
        '  and est.cod_empresa = :pcod_empresa'
        '  and est.dia < :pdata'
        '  order by est.dia desc'
        '    into :vseqid, :vdata_ant, :vcusto_medio;'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '    and (coalesce(vcod_nf, 0) <= 0)'
        '    and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 hd.cod_empresa from hist_estoque_diario hd'
        '    where hd.data = :pdata'
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    -- and hd.cod_grade = :pcod_grade'
        '    and hd.cod_empresa = :pcod_empresa'
        '    and hd.qtde = 0'
        '    and hd.custo_med <> 0'
        '      into :vcod_correcao;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '    and (coalesce(vcod_nf, 0) <= 0)'
        '    and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        
          '    select first 1 hp.cod_empresa from hist_estoque_diario_prod ' +
          'hp'
        '    where hp.data = :pdata'
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    -- and hp.cod_grade = :pcod_grade'
        '    and hp.cod_empresa = :pcod_empresa'
        '    and hp.qtde = 0'
        '    and hp.custo_med <> 0'
        '      into :vcod_correcao;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '    and (coalesce(vcod_nf, 0) <= 0)'
        '    and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 nf.cod_nf from notafiscal nf'
        '    inner join notafiscal_item nfi on'
        '      nfi.cod_nf = nf.cod_nf'
        '      and nfi.cod_empresa = nf.cod_empresa'
        '    where nf.data_estoque = :pdata'
        '    and nf.cod_empresa = :pcod_empresa'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    -- and nfi.cod_grade = :pcod_grade'
        '    and nf.natureza_nf = '#39'E'#39
        '    and (nf.status = '#39'Fechada'#39')'
        '    and nfi.altera_custo_cfop <> '#39'N'#39
        '    and nf.ativo = 1'
        '      into :vcod_nf;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '    and (coalesce(vcod_nf, 0) <= 0)'
        '    and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 p.cod_producao from producao p'
        '    inner join producao_item pii on'
        '      pii.cod_producao = p.cod_producao'
        '      and pii.cod_empresa = p.cod_empresa'
        '    where p.data_estoque = :pdata'
        '    and p.cod_empresa = :pcod_empresa'
        '    and pii.grupo_prod = :pgrupo_prod'
        '    and pii.cod_prod = :pcod_prod'
        '    -- and pii.cod_grade = :pcod_grade'
        '    and p.status = '#39'FECHADO'#39
        '      into :vcod_producao;'
        '  end'
        ''
        '  if ((coalesce(vseqid, 0) > 0)'
        '    and (coalesce(vcod_correcao, 0) <= 0)'
        '    and (coalesce(vcod_nf, 0) <= 0)'
        '    and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    update estoque_diario est set'
        '      est.custo_medio = coalesce(:vcusto_medio, 0)'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    -- and est.cod_grade = :pcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia = :pdata;'
        ''
        '    update custos c set'
        '      c.prec_cus_med = coalesce(:vcusto_medio, 0),'
        '      c.pr_cusc_prod = coalesce(:vcusto_medio, 0),'
        #9'  c.valor = coalesce(:vcusto_medio, 0)'
        '    where c.grupo_prod = :pgrupo_prod'
        '    and c.cod_prod = :pcod_prod'
        '    and c.cod_empresa = :pcod_empresa'
        '    and c.data = :pdata;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_ESTOQUE_ANT ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp,'
        '    PPORGRADE integer)'
        'returns ('
        '    ESTOQUE double precision,'
        '    ESTOQUE_DIARIO double precision)'
        'as'
        'declare variable VEST double precision;'
        'begin'
        '  /* Procedure Text */'
        '  estoque = 0;'
        '  estoque_diario = 0;'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(est.estoque, 0)) estoque from estoque_di' +
          'ario est'
        '    where est.dia = '#39#39#39' || :pdata || '#39#39#39
        '    and est.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and est.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and est.cod_grade = '#39' || :pcod_gra' +
          'de, '#39#39') || '#39
        '    and est.cod_empresa = '#39' || :pcod_empresa'
        '     into :estoque_diario;'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(est.estoque, 0)) estoque from estoque_di' +
          'ario est'
        
          '    where est.dia = (select first 1 est1.dia from estoque_diario' +
          ' est1'
        '                     where est1.grupo_prod = est.grupo_prod'
        '                     and est1.cod_prod = est.cod_prod'
        
          '                     '#39' || iif(pporgrade > 0, '#39' and est1.cod_grad' +
          'e = '#39' || :pcod_grade, '#39#39') || '#39
        '                     and est1.cod_empresa = est.cod_empresa'
        '                     and est1.dia <= '#39#39#39' || (:pdata - 1) || '#39#39#39
        '                     order by est1.dia desc)'
        '    and est.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and est.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and est.cod_grade = '#39' || :pcod_gra' +
          'de, '#39#39') || '#39
        '    and est.cod_empresa = '#39' || :pcod_empresa'
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        '  '#39' select sum(case when (hd.natureza = '#39#39'S'#39#39') then'
        '                  - coalesce(hd.qtde, 0)'
        '                else'
        '                  coalesce(hd.qtde, 0)'
        '           end) qtde from hist_estoque_diario hd'
        '    where hd.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and hd.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and coalesce(hd.cod_grade, 0) = '#39' ' +
          '|| :pcod_grade, '#39#39') || '#39
        '    and hd.tipor = '#39#39'COR'#39#39
        '    and hd.data = '#39#39#39' || :pdata || '#39#39#39
        '    and hd.cod_empresa = '#39' || :pcod_empresa'
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        '  '#39' select sum(case when (hp.natureza = '#39#39'S'#39#39') then'
        '                  - coalesce(hp.qtde, 0)'
        '                else'
        '                  coalesce(hp.qtde, 0)'
        '           end) qtde from hist_estoque_diario_prod hp'
        '    where hp.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and hp.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and coalesce(hp.cod_grade, 0) = '#39' ' +
          '|| :pcod_grade, '#39#39') || '#39
        '    and hp.tipor = '#39#39'COR'#39#39
        '    and hp.data = '#39#39#39' || :pdata || '#39#39#39
        '    and hp.cod_empresa = '#39' || :pcod_empresa'
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        '  '#39' select sum(case when grcomp.qtde is null then'
        '                      coalesce(infe.quant_item_nfe, 0)'
        '                    else'
        '                      coalesce(grcomp.qtde, 0) end) quantidade'
        '    from nf_entrada nfe'
        '    inner join item_nf_entrada infe on'
        '      infe.num_nota_nfe = nfe.num_nota_nfe'
        '      and infe.cod_forn_nfe = nfe.cod_forn_nfe'
        '      and infe.cod_empresa = nfe.cod_empresa'
        '    left join cod_grade_prod_compra grcomp on'
        '      infe.grupo_prod = grcomp.grupo_prod'
        '      and infe.cod_prod = grcomp.cod_prod'
        '      and infe.cod_empresa = grcomp.cod_empresa'
        '      and infe.num_nota_nfe = grcomp.num_nota_nfe'
        '      and infe.cod_forn_nfe = grcomp.cod_forn_nfe'
        '    left join grade gra on'
        '      grcomp.cod_grade = gra.cod_grade'
        '      and grcomp.cod_empresa = gra.cod_empresa'
        '    where nfe.data_lanc_nfe = '#39#39#39' || :pdata || '#39#39#39
        '    and nfe.cod_empresa = '#39' || :pcod_empresa || '#39
        '    and infe.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and infe.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and grcomp.cod_grade = '#39' || :pcod_' +
          'grade, '#39#39') || '#39
        '    and infe.altera_estoque_cfop = '#39#39'S'#39#39
        '    and nfe.status_nfe = '#39#39'CONFIRMADA'#39#39
        '    and nfe.ativo = 1 '#39
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(nfi.quantidade, 0)) quantidade from nota' +
          'fiscal nf'
        '    inner join notafiscal_item nfi on'
        '      nfi.cod_nf = nf.cod_nf'
        '      and nfi.cod_empresa = nf.cod_empresa'
        '    where nf.data_estoque = '#39#39#39' || :pdata || '#39#39#39
        '    and nf.cod_empresa = '#39' || :pcod_empresa || '#39
        '    and nfi.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and nfi.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and nfi.cod_grade = '#39' || :pcod_gra' +
          'de, '#39#39') || '#39
        '    and nf.natureza_nf = '#39#39'E'#39#39
        '    and (nf.status = '#39#39'Fechada'#39#39')'
        
          '    and (nfi.altera_estoque_cfop <> '#39#39'N'#39#39' or nfi.altera_estoque_' +
          'cfop is null)'
        '    and nf.ativo = 1 '#39
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(dev.quant, 0)) quantidade from devolucao' +
          ' dev'
        
          '    left join grade gra on gra.cod_grade = dev.cod_grade and gra' +
          '.cod_empresa = dev.cod_empresa'
        '    where coalesce(dev.nf_gerou, '#39#39#39#39') <> '#39#39'S'#39#39
        '    and dev.data_estoque = '#39#39#39' || :pdata || '#39#39#39
        '    and dev.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and dev.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and dev.cod_grade = '#39' || :pcod_gra' +
          'de, '#39#39') || '#39
        '    and dev.cod_empresa = '#39' || :pcod_empresa'
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(pi.quantidade, 0)) quantidade from produ' +
          'cao pd'
        '    inner join producao_item pi on'
        '      pi.cod_producao = pd.cod_producao'
        '      and pi.cod_empresa = pd.cod_empresa'
        '    where pd.data_estoque = '#39#39#39' || :pdata || '#39#39#39
        '    and pi.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and pi.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and pi.cod_grade = '#39' || :pcod_grad' +
          'e, '#39#39') || '#39
        '    and pi.cod_empresa = '#39' || :pcod_empresa || '#39
        '    and pd.status = '#39#39'FECHADO'#39#39' '#39
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) + coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(ipv.quant_ped_item, 0)) quantidade from ' +
          'pedvenda pv'
        
          '    inner join pedvenda_prod ipv on ipv.tipo = pv.tipo and ipv.n' +
          'ped = pv.nped and ipv.cod_empresa = pv.cod_empresa'
        '    where pv.data_estoque = '#39#39#39' || :pdata || '#39#39#39
        '    and ipv.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and ipv.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and ipv.cod_grade = '#39' || :pcod_gra' +
          'de, '#39#39') || '#39
        '    and pv.cod_empresa = '#39' || :pcod_empresa || '#39
        '    and pv.status_ped = '#39#39'FECHADA'#39#39' and pv.tipo <> '#39#39'ORC'#39#39
        '    and ((ipv.status is null) or (ipv.status <> '#39#39'CANCELADO'#39#39'))'
        '    and pv.ativo = 1 '#39
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) - coalesce(vest, 0);'
        ''
        '  EXECUTE STATEMENT'
        
          '  '#39' select sum(coalesce(pi.quantidade_utilizada, 0) + coalesce(p' +
          'i.quantidade_perda, 0)) from producao pd'
        '    inner join producao_item_indice pi on'
        '      pi.cod_producao = pd.cod_producao'
        '      and pi.cod_empresa = pd.cod_empresa'
        '    where pd.data_estoque = '#39#39#39' || :pdata || '#39#39#39
        '    and pi.grupo_prod = '#39' || :pgrupo_prod || '#39
        '    and pi.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        
          '    '#39' || iif(pporgrade > 0, '#39' and pi.cod_grade = '#39' || :pcod_grad' +
          'e, '#39#39') || '#39
        '    and pi.cod_empresa = '#39' || :pcod_empresa || '#39
        '    and pd.status = '#39#39'FECHADO'#39#39' '#39
        '      into :vest;'
        ''
        '  estoque = coalesce(estoque, 0) - coalesce(vest, 0);'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure CORRIGIR_ESTOQUE_DIARIO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'as'
        'declare variable VESTOQUETMP double precision;'
        'declare variable VESTOQUEDIARIOTMP double precision;'
        'declare variable VESTOQUETMPGER double precision;'
        'declare variable VESTOQUEDIARIOTMPGER double precision;'
        'begin'
        '  /* Procedure Text */'
        '  select estoque, estoque_diario from retorna_estoque_ant('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_grade,'
        '    :pcod_empresa,'
        '    :pdata,'
        '    1)'
        '    into :vestoquetmp, :vestoquediariotmp;'
        ''
        '  select estoque, estoque_diario from retorna_estoque_ant('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_grade,'
        '    :pcod_empresa,'
        '    :pdata,'
        '    0)'
        '    into :vestoquetmpGer, :vestoquediariotmpGer;'
        ''
        
          '  if ((coalesce(vestoquetmp, 0) > 0) and (coalesce(vestoquetmpGe' +
          'r, 0) > 0)) then'
        '  begin'
        '    update estoque_diario est set'
        '      est.estoque = :vestoquetmp,'
        
          '      est.custo_medio = ((est.custo_medio / :vestoquetmpger) * :' +
          'vestoquediariotmpger)'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    and est.cod_grade = :pcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia = :pdata;'
        ''
        '    update custos c set'
        
          '      c.prec_cus_med = ((c.prec_cus_med / :vestoquetmpger) * :ve' +
          'stoquediariotmpger),'
        
          '      c.pr_cusc_prod = ((c.pr_cusc_prod / :vestoquetmpger) * :ve' +
          'stoquediariotmpger),'
        
          #9'  c.valor = ((c.pr_cusc_prod / :vestoquetmpger) * :vestoquediar' +
          'iotmpger)'
        '    where c.grupo_prod = :pgrupo_prod'
        '    and c.cod_prod = :pcod_prod'
        '    and c.cod_empresa = :pcod_empresa'
        '    and c.data = :pdata;'
        '  end'
        '  else'
        '  begin'
        '    update estoque_diario est set'
        '      est.estoque = :vestoquetmp'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    and est.cod_grade = :pcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia = :pdata;'
        '  end'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_CUSTO_MED_ACAB ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp,'
        '    PPREC_CUS_PROD_ACAB double precision,'
        '    PQUANTIDADE_ACAB double precision)'
        'returns ('
        '    CUSTO_MEDIO double precision)'
        'as'
        'declare variable VEXISTE_GRADE integer;'
        'declare variable VCOD_GRADE integer;'
        'declare variable VCUSTO_MEDIO double precision;'
        'declare variable VESTOQUE double precision;'
        'declare variable VEST_TMP double precision;'
        'begin'
        '  custo_medio = 0;'
        '  vest_tmp    = 0;'
        '  vestoque    = 0;'
        '  /* Procedure Text */'
        '  select count(*) from cod_grade_prod cp'
        '  where cp.grupo_prod = :pgrupo_prod'
        '  and cp.cod_prod = :pcod_prod'
        '  and cp.cod_empresa = :pcod_empresa'
        '  and cp.ativo = 1'
        '    into :vexiste_grade;'
        ''
        '  if (coalesce(vexiste_grade, 0) > 0) then'
        '  begin'
        '    for select cp.cod_grade from cod_grade_prod cp'
        '        where cp.grupo_prod = :pgrupo_prod'
        '        and cp.cod_prod = :pcod_prod'
        '        and cp.cod_empresa = :pcod_empresa'
        '        and cp.ativo = 1'
        '          into :vcod_grade do'
        '    begin'
        
          '      select first 1 coalesce(est.estoque, 0) estoque from estoq' +
          'ue_diario est'
        '      where est.grupo_prod = :pgrupo_prod'
        '      and est.cod_prod = :pcod_prod'
        '      and est.cod_grade = :vcod_grade'
        '      and est.cod_empresa = :pcod_empresa'
        '      and est.dia < :pdata'
        '      order by est.dia desc'
        '        into :vest_tmp;'
        ''
        '      vestoque = coalesce(vestoque, 0) + coalesce(vest_tmp, 0);'
        ''
        
          '      select first 1 coalesce(est.custo_medio, 0) custo_medio fr' +
          'om estoque_diario est'
        '      where est.grupo_prod = :pgrupo_prod'
        '      and est.cod_prod = :pcod_prod'
        '      and est.cod_empresa = :pcod_empresa'
        '      and est.dia < :pdata'
        '      order by est.dia desc'
        '        into :vcusto_medio;'
        '    end'
        '  end'
        '  else'
        '  begin'
        
          '    select first 1 coalesce(est.estoque, 0) estoque, coalesce(es' +
          't.custo_medio, 0) custo_medio from estoque_diario est'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia < :pdata'
        '    order by est.dia desc'
        '      into :vestoque, :vcusto_medio;'
        '  end'
        ''
        
          '  if ((coalesce(vcusto_medio, 0) > 0) and (coalesce(vestoque, 0)' +
          ' > 0)) then'
        '  begin'
        
          '    custo_medio = (coalesce(vcusto_medio, 0) * coalesce(vestoque' +
          ', 0));'
        '    custo_medio = (coalesce(custo_medio, 0) +'
        
          '      (coalesce(pprec_cus_prod_acab, 0) * coalesce(pquantidade_a' +
          'cab, 0)));'
        ''
        
          '    if (coalesce(pquantidade_acab, 0) + coalesce(vestoque, 0) > ' +
          '0) then'
        
          '      custo_medio = (coalesce(custo_medio, 0) / (coalesce(pquant' +
          'idade_acab, 0) + coalesce(vestoque, 0)));'
        '    else'
        '      custo_medio = coalesce(custo_medio, 0);'
        '  end'
        '  else'
        '    custo_medio = coalesce(vcusto_medio, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure CORRIGIR_CUSTO_ACABADO ('
        '    PCOD_PRODUCAO integer,'
        '    PTIPO char(6),'
        '    PNITEM integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VQUANTIDADE_PRODUZIDA_PD double precision;'
        'declare variable VGRUPO_PROD_ACAB integer;'
        'declare variable VCOD_PROD_ACAB char(6);'
        'declare variable VNITEM_ACAB integer;'
        'declare variable VQUANTIDADE_ACAB double precision;'
        'declare variable VPESO_UTIL_ACAB double precision;'
        'declare variable VSOLVENTE_INS char(1);'
        'declare variable VPESO_UN_INS double precision;'
        'declare variable VPESO_UTIL_INS double precision;'
        'declare variable VPREC_CUSM_PROD_INS double precision;'
        'declare variable VQUANTIDADE_UTILIZADA_INS double precision;'
        'declare variable VQUANTIDADE_PERDA_INS double precision;'
        'declare variable VVALORCUSTO double precision;'
        'declare variable VCUSTO_INDICE double precision;'
        'declare variable VCUSTO_RATEIO double precision;'
        'declare variable VVALORPARARATEIO double precision;'
        'declare variable VPESOPARARATEIO double precision;'
        'declare variable VPREC_CUS_PROD double precision;'
        'declare variable VPREC_CUSM_PROD double precision;'
        'declare variable VDATA_ESTOQUETMP timestamp;'
        'declare variable VDATA_ESTOQUE_INI_PD timestamp;'
        'declare variable VDATA_ESTOQUE_FIM_PD timestamp;'
        'declare variable VSEQID integer;'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'FALHA'#39';'
        ''
        '  vvalorpararateio = 0;'
        '  vpesopararateio  = 0;'
        '  vvalorcusto      = 0;'
        '  for select pii.solvente, pii.prec_cusm_prod,'
        '      pii.quantidade_utilizada,'
        '      pii.quantidade_perda,'
        '      pii.peso_un,'
        '      pii.peso_util from producao p'
        '      inner join producao_item_indice pii on'
        '        pii.cod_producao = p.cod_producao'
        '        and pii.cod_empresa = p.cod_empresa'
        '      where pii.cod_producao = :pcod_producao'
        '      and pii.cod_empresa = :pcod_empresa'
        '      and pii.nitem = 0'
        '      and p.status = '#39'FECHADO'#39
        
          '        into :vsolvente_ins, :vprec_cusm_prod_ins, :vquantidade_' +
          'utilizada_ins, :vquantidade_perda_ins,'
        '        :vpeso_un_ins, :vpeso_util_ins do'
        '  begin'
        '    if (trim(vsolvente_ins) <> '#39'S'#39') then'
        '    begin'
        '      vvalorpararateio = coalesce(vvalorpararateio, 0) +'
        
          '        (coalesce(vprec_cusm_prod_ins, 0) * coalesce(vquantidade' +
          '_utilizada_ins, 0));'
        ''
        '      vvalorpararateio = coalesce(vvalorpararateio, 0) +'
        
          '        (coalesce(vprec_cusm_prod_ins, 0) * coalesce(vquantidade' +
          '_perda_ins, 0));'
        ''
        '      vpesopararateio = coalesce(vpesopararateio, 0) +'
        '        (coalesce(vpeso_util_ins, 0));'
        ''
        '      vpesopararateio = coalesce(vpesopararateio, 0) +'
        
          '        (coalesce(vpeso_util_ins, 0) * coalesce(vquantidade_perd' +
          'a_ins, 0));'
        '    end'
        '  end'
        ''
        
          '  for select case when (p.data_estoque is not null) then p.data_' +
          'estoque else p.data_fechamento end data_estoque,'
        '      p.quantidadeproduzida,'
        '      pi.grupo_prod, pi.cod_prod, pi.nitem,'
        '      pi.quantidade, pi.peso_util from producao p'
        '      inner join producao_item pi on'
        '        pi.cod_producao = p.cod_producao'
        '        and pi.cod_empresa = p.cod_empresa'
        '      where pi.cod_producao = :pcod_producao'
        '      and pi.cod_empresa = :pcod_empresa'
        '      and pi.nitem = :pnitem'
        '      and p.status = '#39'FECHADO'#39
        '        into :vdata_estoque_ini_pd, :vquantidade_produzida_pd,'
        '             :vgrupo_prod_acab, :vcod_prod_acab, :vnitem_acab,'
        '             :vquantidade_acab, :vpeso_util_acab do'
        '  begin'
        
          '    for select pii.prec_cusm_prod, pii.quantidade_utilizada, pii' +
          '.quantidade_perda from producao p'
        '        inner join producao_item_indice pii on'
        '          pii.cod_producao = p.cod_producao'
        '          and pii.cod_empresa = p.cod_empresa'
        '        where pii.cod_producao = :pcod_producao'
        '        and pii.cod_empresa = :pcod_empresa'
        '        and pii.nitem = :vnitem_acab'
        '        and p.status = '#39'FECHADO'#39
        
          '          into :vprec_cusm_prod_ins, :vquantidade_utilizada_ins,' +
          ' :vquantidade_perda_ins do'
        '    begin'
        '      vvalorcusto = coalesce(vvalorcusto, 0) +'
        
          '        (coalesce(vprec_cusm_prod_ins, 0) * coalesce(vquantidade' +
          '_utilizada_ins, 0));'
        ''
        '      vvalorcusto = coalesce(vvalorcusto, 0) +'
        
          '        (coalesce(vprec_cusm_prod_ins, 0) * coalesce(vquantidade' +
          '_perda_ins, 0));'
        '    end'
        ''
        '    vcusto_indice = coalesce(vvalorcusto, 0);'
        '    vvalorcusto = 0;'
        
          '    if ((coalesce(vvalorpararateio, 0) > 0) and (coalesce(vquant' +
          'idade_produzida_pd, 0) > 0)) then'
        
          '      vvalorcusto = (coalesce(vpeso_util_acab, 0) * coalesce(vqu' +
          'antidade_produzida_pd, 0));'
        '    vcusto_rateio = coalesce(vvalorcusto, 0);'
        
          '    vprec_cus_prod = ((coalesce(vcusto_indice, 0) + coalesce(vcu' +
          'sto_rateio, 0)) / coalesce(vquantidade_acab, 0));'
        '    select custo_medio from retorna_custo_med_acab ('
        '      :vgrupo_prod_acab,'
        '      :vcod_prod_acab,'
        '      :pcod_empresa,'
        '      :pdata,'
        '      :vprec_cus_prod,'
        '      :vquantidade_acab)'
        '        into :vprec_cusm_prod;'
        ''
        '    update producao_item pi set'
        '      pi.custo_indice   = coalesce(:vcusto_indice, 0),'
        '      pi.custo_rateio   = coalesce(:vcusto_rateio, 0),'
        '      pi.prec_cus_prod  = coalesce(:vprec_cus_prod, 0),'
        '      pi.prec_cusm_prod = coalesce(:vprec_cusm_prod, 0)'
        '    where pi.cod_producao = :pcod_producao'
        '    and pi.cod_empresa = :pcod_empresa'
        '    and pi.nitem = coalesce(:vnitem_acab, 0)'
        '    and pi.grupo_prod = :vgrupo_prod_acab'
        '    and pi.cod_prod = :vcod_prod_acab;'
        ''
        
          '    for select cast((case when (p.data_estoque is not null) then' +
          ' p.data_estoque else p.data_fechamento end) as timestamp) data_e' +
          'stoque'
        '        from producao p'
        '        inner join producao_item pi on'
        '          pi.cod_producao = p.cod_producao'
        '          and pi.cod_empresa = p.cod_empresa'
        '        where pi.cod_producao > :pcod_producao'
        '        and pi.grupo_prod = :vgrupo_prod_acab'
        '        and pi.cod_prod = :vcod_prod_acab'
        '        and pi.cod_empresa = :pcod_empresa'
        '        and p.status = '#39'FECHADO'#39
        '        union'
        '        select cast(current_date as timestamp) from rdb$database'
        
          '        where coalesce((select first 1 p.cod_producao from produ' +
          'cao p'
        '               inner join producao_item pi on'
        '                 pi.cod_producao = p.cod_producao'
        '                 and pi.cod_empresa = p.cod_empresa'
        '               where pi.cod_producao > :pcod_producao'
        '               and pi.grupo_prod = :vgrupo_prod_acab'
        '               and pi.cod_prod = :vcod_prod_acab'
        '               and pi.cod_empresa = :pcod_empresa'
        '               and p.status = '#39'FECHADO'#39'), 0) = 0'
        '          into :vdata_estoquetmp do'
        '    begin'
        '      if (vdata_estoque_ini_pd > vdata_estoquetmp) then'
        '      begin'
        '        vdata_estoque_fim_pd = vdata_estoquetmp - 1;'
        '        break;'
        '      end'
        '      else'
        '        vdata_estoque_fim_pd = vdata_estoquetmp;'
        '    end'
        ''
        '    -- Atualizar custo produtos acabados'
        '    execute procedure atualizar_custo_acab_doc ('
        '      :vgrupo_prod_acab,'
        '      :vcod_prod_acab,'
        '      :pcod_empresa,'
        '      :vdata_estoque_ini_pd,'
        '      :vdata_estoque_fim_pd,'
        '      :vprec_cusm_prod);'
        ''
        '    '
        '    update hist_estoque_diario_prod hp set'
        #9'  hp.valor_unit = coalesce(:vprec_cusm_prod, 0),'
        
          #9'  hp.valor_tot = round(hp.qtde * coalesce(:vprec_cusm_prod, 0),' +
          ' 2)'
        '    where hp.numero = :pcod_producao'
        '    and hp.tipor = :ptipo'
        '    and hp.cod_empresa = :pcod_empresa'
        '    and hp.nitem = :pnitem'
        '    and hp.grupo_prod = :vgrupo_prod_acab'
        '    and hp.cod_prod = :vcod_prod_acab;'
        ''
        '    update hist_estoque_diario hd set'
        '  '#9'  hd.valor_unit = coalesce(:vprec_cusm_prod, 0),'
        
          #9'  hd.valor_tot = round(hd.qtde * coalesce(:vprec_cusm_prod, 0),' +
          ' 2)'
        '    where hd.numero = :pcod_producao'
        '    and hd.tipor = :ptipo'
        '    and hd.cod_empresa = :pcod_empresa'
        '    and hd.nitem = :pnitem'
        '    and hd.grupo_prod = :vgrupo_prod_acab'
        '    and hd.cod_prod = :vcod_prod_acab;'
        '  end'
        ''
        '  result = '#39'OK'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATRIBUIR_CUSTO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp,'
        '    PNUMERO integer,'
        '    PTIPO varchar(3),'
        '    PNITEM integer,'
        '    PNATUREZA char(1))'
        'as'
        'declare variable VRESULT varchar(10);'
        'declare variable VESTOQUE double precision;'
        'declare variable VDATA_ANT timestamp;'
        'declare variable VCUSTO_MEDIO double precision;'
        'declare variable VCOD_CORRECAO integer;'
        'declare variable VCOD_NF integer;'
        'declare variable VCOD_PRODUCAO integer;'
        'declare variable VSEQID integer;'
        'declare variable VSEQID_HD integer;'
        'declare variable VSEQID_HP integer;'
        'declare variable VVALORPARARATEIO double precision;'
        'declare variable VPESOPARARATEIO double precision;'
        'declare variable VVALORCUSTO double precision;'
        'declare variable VSOLVENTE_INS char(1);'
        'declare variable VPREC_CUSM_PROD_INS double precision;'
        'declare variable VQUANTIDADE_UTILIZADA_INS double precision;'
        'declare variable VQUANTIDADE_PERDA_INS double precision;'
        'declare variable VPESO_UN_INS double precision;'
        'declare variable VPESO_UTIL_INS double precision;'
        'declare variable VDATA_ESTOQUE_INI_PD timestamp;'
        'declare variable VDATA_ESTOQUE_FIM_PD timestamp;'
        'declare variable VDATA_ESTOQUETMP timestamp;'
        'declare variable VQUANTIDADE_PRODUZIDA_PD double precision;'
        'declare variable VGRUPO_PROD_ACAB integer;'
        'declare variable VCOD_PROD_ACAB char(6);'
        'declare variable VNITEM_ACAB integer;'
        'declare variable VQUANTIDADE_ACAB double precision;'
        'declare variable VPESO_UTIL_ACAB double precision;'
        'declare variable VCUSTO_INDICE double precision;'
        'declare variable VCUSTO_RATEIO double precision;'
        'declare variable VPREC_CUS_PROD double precision;'
        'declare variable VPREC_CUSM_PROD double precision;'
        'begin'
        '  /* Procedure Text */'
        '  vcusto_medio  = 0;'
        '  vcod_correcao = 0;'
        '  vcod_nf       = 0;'
        '  vcod_producao = 0;'
        '  vseqid        = 0;'
        '  vseqid_hd     = 0;'
        '  vseqid_hp     = 0;'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '        and (coalesce(vcod_nf, 0) <= 0)'
        '        and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 hd.cod_empresa from hist_estoque_diario hd'
        '    where hd.data = :pdata'
        '    and hd.grupo_prod = :pgrupo_prod'
        '    and hd.cod_prod = :pcod_prod'
        '    -- and hd.cod_grade = :pcod_grade'
        '    and hd.cod_empresa = :pcod_empresa'
        '    and hd.qtde = 0'
        '    and hd.custo_med <> 0'
        '      into :vcod_correcao;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '        and (coalesce(vcod_nf, 0) <= 0)'
        '        and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        
          '    select first 1 hp.cod_empresa from hist_estoque_diario_prod ' +
          'hp'
        '    where hp.data = :pdata'
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '    -- and hp.cod_grade = :pcod_grade'
        '    and hp.cod_empresa = :pcod_empresa'
        '    and hp.qtde = 0'
        '    and hp.custo_med <> 0'
        '      into :vcod_correcao;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '        and (coalesce(vcod_nf, 0) <= 0)'
        '        and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 nf.cod_nf from notafiscal nf'
        '    inner join notafiscal_item nfi on'
        '      nfi.cod_nf = nf.cod_nf'
        '      and nfi.cod_empresa = nf.cod_empresa'
        '    where nf.data_estoque = :pdata'
        '    and nf.cod_empresa = :pcod_empresa'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    -- and nfi.cod_grade = :pcod_grade'
        '    and nf.natureza_nf = '#39'E'#39
        '    and (nf.status = '#39'Fechada'#39')'
        '    and nfi.altera_custo_cfop <> '#39'N'#39
        '    and nf.ativo = 1'
        '      into :vcod_nf;'
        '  end'
        ''
        '  if ((coalesce(vcod_correcao, 0) <= 0)'
        '        and (coalesce(vcod_nf, 0) <= 0)'
        '        and (coalesce(vcod_producao, 0) <= 0)) then'
        '  begin'
        '    select first 1 p.cod_producao from producao p'
        '    inner join producao_item pii on'
        '      pii.cod_producao = p.cod_producao'
        '      and pii.cod_empresa = p.cod_empresa'
        '    where p.data_estoque = :pdata'
        '    and p.cod_empresa = :pcod_empresa'
        '    and pii.grupo_prod = :pgrupo_prod'
        '    and pii.cod_prod = :pcod_prod'
        '    -- and pii.cod_grade = :pcod_grade'
        '    and p.status = '#39'FECHADO'#39
        '      into :vcod_producao;'
        '  end'
        ''
        
          '  -- Custo foi alterado no dia, se nao atribuir custo data anter' +
          'ior'
        '  if ((coalesce(vcod_correcao, 0) > 0)'
        '       or (coalesce(vcod_nf, 0) > 0)'
        '       or (coalesce(vcod_producao, 0) > 0)) then'
        '  begin'
        
          '    select first 1 est.seqid, est.dia, est.custo_medio from esto' +
          'que_diario est'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    -- and est.cod_grade = :pcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia = :pdata'
        '    order by est.dia desc'
        '      into :vseqid, :vdata_ant, :vcusto_medio;'
        '  end'
        '  else'
        '  begin'
        
          '    select first 1 est.seqid, est.dia, est.custo_medio from esto' +
          'que_diario est'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    -- and est.cod_grade = :pcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia < :pdata'
        '    order by est.dia desc'
        '      into :vseqid, :vdata_ant, :vcusto_medio;'
        '  end'
        ''
        '  if (coalesce(vcusto_medio, 0) > 0) then'
        '  begin'
        '    if ((trim(ptipo) = '#39'PDC'#39') and (trim(pnatureza) = '#39'S'#39')) then'
        '    begin'
        '      update producao_item_indice pii set'
        '        pii.prec_cusm_prod = coalesce(:vcusto_medio, 0)'
        '      where pii.cod_producao = :pnumero'
        '      and pii.cod_empresa = :pcod_empresa'
        '      and pii.nitem = :pnitem'
        '      and pii.grupo_prod = :pgrupo_prod'
        '      and pii.cod_prod = :pcod_prod;'
        ''
        '      select result from corrigir_custo_acabado ('
        '        :pnumero,'
        '        :ptipo,'
        '        :pnitem,'
        '        :pcod_empresa,'
        '        :pdata)'
        '          into :vresult;'
        '    end'
        
          '    else if ((trim(ptipo) = '#39'DEV'#39') and (trim(pnatureza) = '#39'E'#39')) ' +
          'then'
        '    begin'
        '      update devolucao dev set'
        '        dev.pcust_mc = coalesce(:vcusto_medio, 0)'
        '      where dev.sequencia = :pnumero'
        '      and dev.cod_empresa = :pcod_empresa'
        '      and dev.grupo_prod = :pgrupo_prod'
        '      and dev.cod_prod = :pcod_prod;'
        '    end'
        
          '    else if (((trim(ptipo) = '#39'REQ'#39') or (trim(ptipo) = '#39'OS'#39')) and' +
          ' (trim(pnatureza) = '#39'S'#39')) then'
        '    begin'
        '      update pedvenda_prod pp set'
        '        pp.pcust_c = coalesce(:vcusto_medio, 0),'
        '        pp.pcust_r = coalesce(:vcusto_medio, 0),'
        '        pp.pcust_mc = coalesce(:vcusto_medio, 0),'
        '        pp.pcust_mr = coalesce(:vcusto_medio, 0)'
        '      where pp.nped = :pnumero'
        '      and pp.tipo = :ptipo'
        '      and pp.cod_empresa = :pcod_empresa'
        '      and pp.nitem = :pnitem'
        '      and pp.grupo_prod = :pgrupo_prod'
        '      and pp.cod_prod = :pcod_prod;'
        '    end'
        ''
        '    vseqid    = 0;'
        '    vseqid_hd = 0;'
        '    vseqid_hp = 0;'
        '    select first 1 hp.seqid from hist_estoque_diario_prod hp'
        '    where hp.numero = :pnumero'
        '    and hp.tipor = :ptipo'
        '    and hp.cod_empresa = :pcod_empresa'
        '    and hp.nitem = :pnitem'
        '    and hp.grupo_prod = :pgrupo_prod'
        '    and hp.cod_prod = :pcod_prod'
        '      into :vseqid_hp;'
        ''
        '    if (coalesce(vseqid_hp, 0) <= 0) then'
        '    begin'
        '      select first 1 he.seqid from hist_estoque_diario he'
        '      where he.numero = :pnumero'
        '      and he.tipor = :ptipo'
        '      and he.cod_empresa = :pcod_empresa'
        '      and he.nitem = :pnitem'
        '      and he.grupo_prod = :pgrupo_prod'
        '      and he.cod_prod = :pcod_prod'
        '        into :vseqid_hd;'
        '    end'
        ''
        '    if (coalesce(vseqid_hp, 0) > 0) then'
        '    begin'
        '      update hist_estoque_diario_prod hp set'
        '        hp.valor_unit = coalesce(:vcusto_medio, 0),'
        
          '        hp.valor_tot = round(hp.qtde * coalesce(:vcusto_medio, 0' +
          '), 2)'
        '      where hp.numero = :pnumero'
        '      and hp.tipor = :ptipo'
        '      and hp.cod_empresa = :pcod_empresa'
        '      and hp.nitem = :pnitem'
        '      and hp.grupo_prod = :pgrupo_prod'
        '      and hp.cod_prod = :pcod_prod;'
        '    end'
        '    else if (coalesce(vseqid_hd, 0) > 0) then'
        '    begin'
        '      update hist_estoque_diario hd set'
        '        hd.valor_unit = coalesce(:vcusto_medio, 0),'
        
          '        hd.valor_tot = round(hd.qtde * coalesce(:vcusto_medio, 0' +
          '), 2)'
        '      where hd.numero = :pnumero'
        '      and hd.tipor = :ptipo'
        '      and hd.cod_empresa = :pcod_empresa'
        '      and hd.nitem = :pnitem'
        '      and hd.grupo_prod = :pgrupo_prod'
        '      and hd.cod_prod = :pcod_prod;'
        '    end'
        '  end'
        ''
        '  execute procedure atribuir_custo_data_ant ('
        '    :pgrupo_prod,'
        '    :pcod_prod,'
        '    :pcod_grade,'
        '    :pcod_empresa,'
        '    :pdata);'
        ''
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATRIBUIR_EST_ULT_DATA ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'as'
        'declare variable VEXISTE_GRADE integer;'
        'declare variable VCOD_GRADE integer;'
        'declare variable VESTOQUE double precision;'
        'declare variable VESTOQUE_TOT double precision;'
        'declare variable VDATA timestamp;'
        'declare variable VCUSTO_MEDIO double precision;'
        'begin'
        '  /* Procedure Text */'
        
          '  select first 1 est.dia, est.custo_medio from estoque_diario es' +
          't'
        '  where est.grupo_prod = :pgrupo_prod'
        '  and est.cod_prod = :pcod_prod'
        '  and est.cod_empresa = :pcod_empresa'
        '  order by est.dia desc'
        '    into :vdata, :vcusto_medio;'
        ''
        '  -- Atualizar estoque somente na ultima data'
        '  if (pdata <> vdata) then'
        '    exit;'
        ''
        '  vestoque = 0;'
        '  vestoque_tot = 0;'
        '  select count(*) from cod_grade_prod cg'
        '  where cg.grupo_prod = :pgrupo_prod'
        '  and cg.cod_prod = :pcod_prod'
        '  and cg.cod_empresa = :pcod_empresa'
        '  and cg.ativo = 1'
        '    into :vexiste_grade;'
        ''
        '  if (coalesce(vexiste_grade, 0) > 0) then'
        '  begin'
        '    for select cg.cod_grade from cod_grade_prod cg'
        '        where cg.grupo_prod = :pgrupo_prod'
        '        and cg.cod_prod = :pcod_prod'
        '        and cg.cod_empresa = :pcod_empresa'
        '        and cg.ativo = 1'
        '    into :vcod_grade do'
        '    begin'
        '      select first 1 est.estoque from estoque_diario est'
        '      where est.grupo_prod = :pgrupo_prod'
        '      and est.cod_prod = :pcod_prod'
        '      and est.cod_grade = :vcod_grade'
        '      and est.cod_empresa = :pcod_empresa'
        '      order by est.dia desc'
        '        into :vestoque;'
        ''
        
          '      vestoque_tot = coalesce(vestoque_tot, 0) + coalesce(vestoq' +
          'ue, 0);'
        ''
        
          '      update or insert into cod_grade_prod (grupo_prod, cod_prod' +
          ', cod_grade, cod_empresa, qtde, ativo)'
        
          '      values (:pgrupo_prod, :pcod_prod, :vcod_grade, :pcod_empre' +
          'sa, coalesce(:vestoque, 0), 1)'
        '      matching (grupo_prod, cod_prod, cod_grade, cod_empresa);'
        '    end'
        ''
        '    update produtos pr set'
        '      pr.est_f = coalesce(:vestoque_tot, 0),'
        '      pr.prec_cus_prod  = coalesce(:vcusto_medio, 0),'
        '      pr.prec_cusm_prod = coalesce(:vcusto_medio, 0),'
        '      pr.prec_cusr_prod = coalesce(:vcusto_medio, 0),'
        '      pr.prec_rep_prod  = coalesce(:vcusto_medio, 0)'
        '    where pr.grupo_prod = :pgrupo_prod'
        '    and pr.cod_prod = :pcod_prod'
        '    and pr.cod_empresa = :pcod_empresa;'
        '  end'
        '  else'
        '  begin'
        '    select first 1 est.estoque from estoque_diario est'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    and est.cod_grade = 0'
        '    and est.cod_empresa = :pcod_empresa'
        '    order by est.dia desc'
        '      into :vestoque;'
        ''
        '    update produtos pr set'
        '      pr.est_f = coalesce(:vestoque, 0),'
        '      pr.prec_cus_prod = coalesce(:vcusto_medio, 0),'
        '      pr.prec_cusm_prod = coalesce(:vcusto_medio, 0),'
        '      pr.prec_cusr_prod = coalesce(:vcusto_medio, 0),'
        '      pr.prec_rep_prod  = coalesce(:vcusto_medio, 0)'
        '    where pr.grupo_prod = :pgrupo_prod'
        '    and pr.cod_prod = :pcod_prod'
        '    and pr.cod_empresa = :pcod_empresa;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATRIBUIR_EST_DATA ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'as'
        'declare variable VSEQID integer;'
        'declare variable VCOD_GRADE integer;'
        'declare variable VEST double precision;'
        'declare variable VESTOQUE double precision;'
        'declare variable VENT_SAIDA double precision;'
        'begin'
        '  /* Procedure Text */'
        
          '  for select est.seqid, est.cod_grade, est.estoque from estoque_' +
          'diario est'
        '      where est.grupo_prod = :pgrupo_prod'
        '      and est.cod_prod = :pcod_prod'
        '      and est.cod_empresa = :pcod_empresa'
        
          '      and est.dia = (select first 1 est1.dia from estoque_diario' +
          ' est1'
        '                     where est1.grupo_prod = :pgrupo_prod'
        '                     and est1.cod_prod = :pcod_prod'
        '                     and est1.cod_empresa = :pcod_empresa'
        '                     and est1.dia < :pdata'
        '                     order by est1.dia desc)'
        '        into :vseqid, :vcod_grade, :vest do'
        '  begin'
        '    if (coalesce(vseqid, 0) <= 0) then'
        '      exit;'
        ''
        '    select sum(case when (f.natureza = '#39'S'#39') then'
        '                  - coalesce(f.qtde, 0)'
        '                else'
        '                  coalesce(f.qtde, 0)'
        '           end) qtde from fichaprodutosdetalhada f'
        '    where f.grupo_prod = :pgrupo_prod'
        '    and f.cod_prod = :pcod_prod'
        '    and f.cod_grade = :vcod_grade'
        '    and f.cod_empresa = :pcod_empresa'
        '    and f.data = :pdata'
        '      into :vent_saida;'
        ''
        '    vestoque = coalesce(vest, 0) + coalesce(vent_saida, 0);'
        ''
        '    update estoque_diario est set'
        '      est.estoque = coalesce(:vestoque, 0)'
        '    where est.grupo_prod = :pgrupo_prod'
        '    and est.cod_prod = :pcod_prod'
        '    and est.cod_grade = :vcod_grade'
        '    and est.cod_empresa = :pcod_empresa'
        '    and est.dia = :pdata;'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure ATUALIZAR_ESTOQUE_DIARIO ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VEXISTE_REG integer;'
        'declare variable VDATA_DOCTMP timestamp;'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'OK'#39';'
        '  select first 1 est.seqid from estoque_diario est'
        '  where est.dia >= :pdata'
        '  and est.grupo_prod = :pgrupo_prod'
        '  and est.cod_prod = :pcod_prod'
        '  and est.cod_empresa = :pcod_empresa'
        '    into :vexiste_reg;'
        ''
        '  if (coalesce(vexiste_reg, 0) > 0) then'
        '  begin'
        '    for select distinct est.dia from estoque_diario est'
        '        where est.dia >= :pdata'
        '        and est.grupo_prod = :pgrupo_prod'
        '        and est.cod_prod = :pcod_prod'
        '        and est.cod_empresa = :pcod_empresa'
        '         into :vdata_doctmp do'
        '    begin'
        '      execute procedure atribuir_est_data ('
        '        :pgrupo_prod,'
        '        :pcod_prod,'
        '        :pcod_empresa,'
        '        :vdata_doctmp);'
        '    end'
        ''
        '    -- Atualizar estoque'
        '    execute procedure atribuir_est_ult_data ('
        '      :pgrupo_prod,'
        '      :pcod_prod,'
        '      :pcod_empresa,'
        '      :vdata_doctmp);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure CONSULTAR_CUSTO_ESTOQUE ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PDATA timestamp,'
        '    PCOD_NF integer,'
        '    PNITEM_NF integer)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VWHERE varchar(1000);'
        'declare variable VSQL varchar(1000);'
        'declare variable VSQL2 varchar(1000);'
        'declare variable VEXISTE_REG integer;'
        'declare variable VNUM_DOCTMP integer;'
        'declare variable VTIPO_DOCTMP char(6);'
        'declare variable VDATA_DOCTMP timestamp;'
        'declare variable VNITEMTMP integer;'
        'declare variable VNATUREZATMP char(1);'
        'declare variable VCOD_NFTMP integer;'
        'begin'
        '  /* Procedure Text */'
        '  vwhere = '#39' where f.grupo_prod = '#39' || :pgrupo_prod || '#39
        '  and f.cod_prod = '#39#39#39' || :pcod_prod || '#39#39#39
        '  and f.cod_grade = '#39' || :pcod_grade || '#39
        '  and f.cod_empresa = '#39' || :pcod_empresa || '#39
        '  and f.data_estoque >= '#39#39#39' || cast(:pdata as date) || '#39#39#39
        
          '  and f.tipo in ('#39#39'DEV'#39#39', '#39#39'NF'#39#39', '#39#39'REQ'#39#39', '#39#39'OS'#39#39', '#39#39'PDC'#39#39', '#39#39'CO' +
          'R'#39#39') '#39';'
        ''
        
          '  vsql  = '#39' select first 1 f.cod_empresa from fichaprodutosdetal' +
          'hada f '#39
        '          || vwhere;'
        ''
        
          '  vsql2 = '#39' select f.numdoc, f.tipo, f.data_estoque, f.natureza,' +
          ' f.nitem_id, f.cod_nf from fichaprodutosdetalhada f '#39
        '          || vwhere ||'
        
          '          '#39' order by f.data_estoque, f.natureza, f.ordem, f.tipo' +
          ', f.cod_nf, f.numdoc, f.nitem_id '#39';'
        ''
        '  execute statement'
        '    :vsql'
        '      into :vexiste_reg;'
        ''
        '  if (coalesce(vexiste_reg, 0) > 0) then'
        '  begin'
        '    for execute statement'
        '          :vsql2'
        
          '            into :vnum_doctmp, :vtipo_doctmp, :vdata_doctmp, :vn' +
          'aturezatmp, :vnitemtmp, :vcod_nftmp do'
        '    begin'
        '      -- Parar rotina na proxima nota'
        '      if ((coalesce(pcod_nf, 0) > 0)'
        '           and (trim(vtipo_doctmp) = '#39'NF'#39')'
        '           and (trim(vnaturezatmp) = '#39'E'#39')'
        
          '           and (coalesce(vcod_nftmp, 0) > coalesce(pcod_nf, 0)))' +
          ' then'
        '      begin'
        '        result = '#39'OK'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        '      -- Parar rotina no proximo item'
        '      if ((coalesce(pcod_nf, 0) > 0)'
        '          and (trim(vtipo_doctmp) = '#39'NF'#39')'
        '          and (trim(vnaturezatmp) = '#39'E'#39')'
        '          and (coalesce(vcod_nftmp, 0) = coalesce(pcod_nf, 0))'
        
          '          and (coalesce(vnitemtmp, 0) > coalesce(pnitem_nf, 0)))' +
          ' then'
        '      begin'
        '        result = '#39'OK'#39';'
        '        suspend;'
        '        exit;'
        '      end'
        ''
        
          '      if (  ((trim(vtipo_doctmp) = '#39'NF'#39') and (trim(vnaturezatmp)' +
          ' = '#39'E'#39'))'
        
          '           or (((trim(vtipo_doctmp) = '#39'REQ'#39') or (trim(vtipo_doct' +
          'mp) = '#39'OS'#39')) and (trim(vnaturezatmp) = '#39'S'#39'))'
        
          '           or ((trim(vtipo_doctmp) = '#39'DEV'#39') and (trim(vnaturezat' +
          'mp) = '#39'E'#39'))'
        
          '           or ((trim(vtipo_doctmp) = '#39'PDC'#39') and (trim(vnaturezat' +
          'mp) = '#39'S'#39'))'
        '           or (trim(vtipo_doctmp) = '#39'COR'#39')  ) then'
        '      begin'
        '        execute procedure atribuir_custo ('
        '          :pgrupo_prod,'
        '          :pcod_prod,'
        '          :pcod_grade,'
        '          :pcod_empresa,'
        '          :vdata_doctmp,'
        '          :vnum_doctmp,'
        '          :vtipo_doctmp,'
        '          :vnitemtmp,'
        '          :vnaturezatmp);'
        '      end'
        ''
        '      execute procedure corrigir_estoque_diario ('
        '        :pgrupo_prod,'
        '        :pcod_prod,'
        '        :pcod_grade,'
        '        :pcod_empresa,'
        '        :vdata_doctmp);'
        '    end'
        ''
        '    -- Atualizar estoque'
        '    execute procedure atribuir_est_ult_data ('
        '      :pgrupo_prod,'
        '      :pcod_prod,'
        '      :pcod_empresa,'
        '      :vdata_doctmp);'
        '  end'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure CORRIGIR_EST_CUSTO_NF_PDC ('
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6),'
        '    PCOD_GRADE integer,'
        '    PCOD_EMPRESA integer,'
        '    PTIPO char(3),'
        '    PNUM integer,'
        '    PNITEM integer,'
        '    PQUANTIDADE double precision)'
        'returns ('
        '    RESULT varchar(100))'
        'as'
        'declare variable VCOD_NF integer;'
        'declare variable VNITEM_NF integer;'
        'declare variable VNATUREZA_NF char(1);'
        'declare variable VTIPO_NF char(1);'
        'declare variable VDATA_NF timestamp;'
        'declare variable VQUANTIDADE double precision;'
        'declare variable VVALOR_UNITARIO double precision;'
        'declare variable VVALOR_TOTAL double precision;'
        'declare variable VPREC_CUS_CNT double precision;'
        'declare variable VPREC_CUS_REP double precision;'
        'declare variable VPREC_CUSM_PROD double precision;'
        'declare variable VPR_CUSC_PROD double precision;'
        'declare variable VPREC_CUS_R double precision;'
        'declare variable VQCOM double precision;'
        'declare variable VNUM_DOCTMP integer;'
        'declare variable VTIPO_DOCTMP char(6);'
        'declare variable VNITEMTMP integer;'
        'declare variable VDATA_DOCTMP timestamp;'
        'declare variable VNATUREZATMP char(1);'
        'declare variable VCOD_NFTMP integer;'
        'declare variable VESTOQUETMP double precision;'
        'declare variable VESTOQUEDIARIOTMP double precision;'
        'declare variable VEXISTE_REG integer;'
        'declare variable VEXISTE_IND integer;'
        'declare variable VEXISTE_GRADE integer;'
        'declare variable VSQL varchar(1000);'
        'declare variable VSQL2 varchar(1000);'
        'declare variable VWHERE varchar(1000);'
        'declare variable VGRUPO_PROD integer;'
        'declare variable VCOD_PROD char(6);'
        'declare variable VCOD_GRADE integer;'
        'declare variable VRESULT varchar(10);'
        'begin'
        '  /* Procedure Text */'
        '  result = '#39'FALHA'#39';'
        ''
        '  vcod_nf = 0;'
        '  vnitem_nf = 0;'
        '  vnatureza_nf = '#39#39';'
        '  vtipo_nf = '#39#39';'
        '  vquantidade = 0;'
        '  vvalor_unitario = 0;'
        '  vvalor_total = 0;'
        '  vprec_cus_cnt = 0;'
        '  vprec_cus_rep = 0;'
        '  vprec_cusm_prod = 0;'
        '  vpr_cusc_prod = 0;'
        '  vprec_cus_r = 0;'
        '  vqcom = 0;'
        ''
        '  vnum_doctmp      = 0;'
        '  vtipo_doctmp     = '#39#39';'
        '  vnitemtmp        = 0;'
        '  vdata_doctmp     = null;'
        '  vnaturezatmp     = '#39#39';'
        ''
        '  if ((trim(ptipo) <> '#39'NF'#39') and (trim(ptipo) <> '#39'PDF'#39')) then'
        '  begin'
        '    result = '#39'DOCUMENTO DEVE SER NF OU PRODUCAO'#39';'
        '    exit;'
        '  end'
        ''
        '  if (pquantidade <= 0) then'
        '  begin'
        '    result = '#39'QUANTIDADE INFORMADA DEVE SER MAIOR QUE ZERO'#39';'
        '    exit;'
        '  end'
        ''
        '  if (ptipo = '#39'NF'#39') then'
        '  begin'
        '    select nfi.cod_nf,'
        '    nfi.nitem,'
        '    nf.natureza_nf,'
        '    nf.tipo_nf,'
        '    nf.data_estoque,'
        '    nfi.quantidade,'
        '    nfi.valor_unitario,'
        '    nfi.valor_total,'
        '    nfi.prec_cus_cnt,'
        '    nfi.prec_cus_rep,'
        '    nfi.prec_cusm_prod,'
        '    nfi.pr_cusc_prod,'
        '    nfi.prec_cus_r,'
        '    nfi.qcom from notafiscal_item nfi'
        '    inner join notafiscal nf on'
        '        nf.cod_nf = nfi.cod_nf'
        '        and nf.cod_empresa = nfi.cod_empresa'
        '    where nfi.cod_nf = :pnum'
        '    and nfi.cod_empresa = :pcod_empresa'
        '    and nfi.nitem = :pnitem'
        '    and nfi.grupo_prod = :pgrupo_prod'
        '    and nfi.cod_prod = :pcod_prod'
        '    and nfi.cod_grade = :pcod_grade'
        
          '     into :vcod_nf, :vnitem_nf, :vnatureza_nf, :vtipo_nf, :vdata' +
          '_nf,'
        '      :vquantidade, :vvalor_unitario, :vvalor_total,'
        '      :vprec_cus_cnt, :vprec_cus_rep, :vprec_cusm_prod,'
        '      :vpr_cusc_prod, :vprec_cus_r, :vqcom;'
        ''
        '    if (trim(vnatureza_nf) <> '#39'E'#39') then '
        '    begin'
        '      result = '#39'NF DEVE SER DE ENTRADA'#39';'
        '      exit;'
        '    end'
        ''
        '    if (trim(vtipo_nf) <> '#39'P'#39') then'
        '    begin'
        '      result = '#39'NF DEVE SER DE PRODUTO'#39';'
        '      exit;'
        '    end'
        ''
        '    if (vcod_nf > 0) then'
        '    begin'
        
          '      update notafiscal_item nfi set nfi.quantidade = :pquantida' +
          'de,'
        
          '        nfi.valor_unitario = ((:vvalor_unitario / :pquantidade) ' +
          '* :vquantidade),'
        
          '        nfi.prec_cus_cnt = ((:vprec_cus_cnt / :pquantidade) * :v' +
          'quantidade),'
        
          '        nfi.prec_cus_rep = ((:vprec_cus_rep / :pquantidade) * :v' +
          'quantidade),'
        
          '        nfi.prec_cusm_prod = ((:vprec_cusm_prod / :pquantidade) ' +
          '* :vquantidade),'
        
          '        nfi.pr_cusc_prod = ((:vpr_cusc_prod / :pquantidade) * :v' +
          'quantidade)'
        '      where nfi.cod_nf = :pnum'
        '      and nfi.cod_empresa = :pcod_empresa'
        '      and nfi.nitem = :pnitem'
        '      and nfi.grupo_prod = :pgrupo_prod'
        '      and nfi.cod_prod = :pcod_prod'
        '      and nfi.cod_grade = :pcod_grade;'
        ''
        '      select result from consultar_custo_estoque ('
        '        :pgrupo_prod,'
        '        :pcod_prod,'
        '        :pcod_grade,'
        '        :pcod_empresa,'
        '        :vdata_nf,'
        '        :vcod_nf,'
        '        :vnitem_nf)'
        '          into :vresult;'
        '    end'
        '  end'
        ''
        '  result = '#39'OK'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CREATE INDEX IDX_HIST_ESTOQUE_DIARIO_PROD ON HIST_ESTOQUE_DIARIO' +
          ' (GRUPO_PROD, COD_PROD, COD_EMPRESA);'
        ''
        
          'CREATE INDEX IDX_DEVOLUCAO_NUM_PR ON DEVOLUCAO (SEQUENCIA, COD_E' +
          'MPRESA, GRUPO_PROD, COD_PROD);'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0239'#39', :COD_EMPRESA, '#39'ENTRAR NF VL UN DIVERGENTE UL' +
          'TIMAS ENTRADAS'#39', 100, '#39'S'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'NF0240'#39', :COD_EMPRESA, '#39'ENTRAR NF UND MEDIDA DIVERGEN' +
          'TE'#39', 100, '#39'S'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW FOTOS_EMP('
        '    CODIGO,'
        '    COD_EMPRESA,'
        '    FOTO,'
        '    USAR_LOGO)'
        'AS'
        
          'select fotos.codigo, fotos.cod_empresa, fotos.foto, empresa.usar' +
          '_logo from fotos'
        'inner join empresa on empresa.cod_empresa = fotos.cod_empresa'
        'where fotos.codigo = 0'
        'and fotos.tipo = 3;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_DAV('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    IDENTIFICACAO_EMP,'
        '    NOME_EMP,'
        '    FANTASIA_EMP,'
        '    CGC_EMP,'
        '    IE_EMP,'
        '    TELEFONE_EMP,'
        '    EMAIL_EMP,'
        '    CEP_EMP,'
        '    ENDERECO_EMP,'
        '    BAIRRO_EMP,'
        '    CIDADE_EMP,'
        '    ESTADO_EMP,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    RAZAO_CLIENTE,'
        '    CPFCGC,'
        '    INSC_EST,'
        '    FONE_CLIENTE,'
        '    FONE_CELULAR,'
        '    EMAIL,'
        '    CEP,'
        '    ENDERECO,'
        '    BAIRRO,'
        '    CIDADE,'
        '    ESTADO,'
        '    COMPLEMENTO,'
        '    CONTATO,'
        '    DESC_COND_PAG,'
        '    VALOR_TOTAL,'
        '    TOT_PROD,'
        '    TOT_SERV,'
        '    TOT_PROD_TERC,'
        '    TOT_SERV_TERC,'
        '    OBS_PED,'
        '    OBS_RED_OS,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    NUM_FAB_PROD,'
        '    STATUS,'
        '    COD_GRADE,'
        '    GRADE,'
        '    STATUS_PED,'
        '    NPREVENDA,'
        '    NOME_RECEB,'
        '    FONE_RECEB,'
        '    CEP_RECEB,'
        '    END_RECEB,'
        '    BAIRRO_RECEB,'
        '    CIDA_RECEB,'
        '    DATA_FECH,'
        '    HORAFECHAMENTO,'
        '    MINFECHAMENTO,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    APLICACAO_PROD,'
        '    UNIDADE,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    PROD_SERV,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    COD_VEICULO,'
        '    CHASSI,'
        '    PLACA,'
        '    COMBUST_VEIC,'
        '    KM_V,'
        '    COD_SERVICO,'
        '    APARELHO_PED,'
        '    NCM,'
        '    ORDEM,'
        '    NITEM,'
        '    COD_EQUIP,'
        '    DATA_PED,'
        '    CODIGO,'
        '    CIDA_AVL,'
        '    ESTA_AVL,'
        '    BAIRRO_AVL,'
        '    CEP_AVL,'
        '    NOME_CLI_ORC,'
        '    HORAABERTURA,'
        '    MINABERTURA,'
        '    CEP_DEST,'
        '    LOGRADOURO_DEST,'
        '    BAIRRO_DEST,'
        '    CIDADE_DEST,'
        '    ESTADO_DEST,'
        '    COMPLEMENTO_DEST,'
        '    DEST_SEQID,'
        '    LOCACAO_PROD,'
        '    LOCACAO_PROD_1,'
        '    LOC_DEP,'
        '    SELOS_REM,'
        '    SELOS_COL,'
        '    LACRES_REM,'
        '    LACRES_COL,'
        '    OBS_LIVRO_REG,'
        '    CODIGO_KIT,'
        '    DESCRICAO_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    MARCA_P,'
        '    DESCRICAO,'
        '    QUANT_PED_ITEM,'
        '    QUANT_SERV_PED,'
        '    ACRESCIMO_TOT,'
        '    DESCONTO_TOT,'
        '    CANCELADO,'
        '    PESO_BRUT_TOT,'
        '    DATA,'
        '    ANO_FAB,'
        '    COR,'
        '    MARCA_V,'
        '    MODELO_V,'
        '    PLACA_V,'
        '    RENAVAM,'
        '    COD_VENDEDOR,'
        '    NOME_VENDEDOR,'
        '    RG_VENDEDOR,'
        '    CPF_VENDEDOR,'
        '    USAR_LOGO,'
        '    TIPO_OS,'
        '    DESCRICAO_TV,'
        '    ID_KIT,'
        '    QUANT_KIT,'
        '    PESO_BRUT_PROD,'
        '    NUM_END_CLIENTE,'
        '    END_AVL,'
        '    VALOR_KIT_LIQ,'
        '    VALOR_UN_KIT_LIQ,'
        '    ACRESC_ITEM_PROD_TOT,'
        '    DESC_ITEM_PROD_TOT,'
        '    ACRESC_ITEM_SERV_TOT,'
        '    DESC_ITEM_SERV_TOT,'
        '    COD_US_FECH,'
        '    NOME_US_FECH,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2,'
        '    OBS_TPVENDA1,'
        '    OBS_TPVENDA2,'
        '    OBS_TPVENDA,'
        '    ESTADO_VEIC,'
        '    DEFEITO,'
        '    ACESSORIOS,'
        '    OBS_OS,'
        '    CODIGO_FOTO,'
        '    FOTO,'
        '    CODIGO_FOTO_EMP,'
        '    FOTO_EMP)'
        'AS'
        ' SELECT PEDVENDA.NPED, PEDVENDA.TIPO, PEDVENDA.COD_EMPRESA,'
        
          ' EMPRESA.IDENTIFICACAO_EMP, EMPRESA.NOME_EMP, EMPRESA.FANTASIA_E' +
          'MP, EMPRESA.CGC_EMP, EMPRESA.IE_EMP,'
        ' EMPRESA.TELEFONE_EMP, EMPRESA.EMAIL_EMP,'
        
          ' EMPRESA.CEP_EMP, EMPRESA.ENDRECO_EMP, EMPRESA.BAIRRO_EMP, EMPRE' +
          'SA.CIDADE_EMP, ESTADOS_1.SIGLA_UF ESTADO_EMP,'
        
          ' CLIENTES.COD_CLIENTE, CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, CL' +
          'IENTES.CPFCGC, CLIENTES.INSC_EST,'
        ' CLIENTES.FONE_CLIENTE, CLIENTES.FONE_CELULAR, CLIENTES.EMAIL,'
        
          ' CLIENTES.CEP, CLIENTES.ENDERECO, CLIENTES.BAIRRO, CLIENTES.CIDA' +
          'DE, ESTADOS.SIGLA_UF ESTADO,'
        ' CLIENTES.COMPLEMENTO, CLIENTES.CONTATO,'
        ' COND_PAG.DESC_COND_PAG,'
        
          ' PEDVENDA.VALOR_TOTAL, PEDVENDA.TOT_PROD, PEDVENDA.TOT_SERV, PED' +
          'VENDA.TOT_PROD_TERC, PEDVENDA.TOT_SERV_TERC,'
        ' PEDVENDA.OBS_PED, PEDVENDA.OBS_RED_OS, '
        
          ' ORCAMENTO4.GRUPO_PROD, ORCAMENTO4.COD_PROD, ORCAMENTO4.NUM_FAB_' +
          'PROD,  ORCAMENTO4.STATUS, ORCAMENTO4.COD_GRADE, GRADE.DESCRICAO,'
        ' PEDVENDA.STATUS_PED, PEDVENDA.NPREVENDA,'
        
          ' PEDVENDA.NOME_RECEB, PEDVENDA.FONE_RECEB, PEDVENDA.CEP_RECEB, P' +
          'EDVENDA.END_RECEB, PEDVENDA.BAIRRO_RECEB, PEDVENDA.CIDA_RECEB,'
        
          ' PEDVENDA.DATA_FECH, PEDVENDA.HORAFECHAMENTO, PEDVENDA.MINFECHAM' +
          'ENTO,'
        
          ' ORCAMENTO4.QUANTIDADE, ORCAMENTO4.VL_UNITARIO, ORCAMENTO4.VL_TO' +
          'TAL_ITEM, PRODUTOS.APLICACAO_PROD, ORCAMENTO4.UNIDADE,'
        
          ' ORCAMENTO4.RATEIO_DESC, ORCAMENTO4.RATEIO_ACRESC, ORCAMENTO4.PR' +
          'OD_SERV,'
        
          ' ORCAMENTO4.COD_TECNICO_MECAN, ORCAMENTO4.NOME_TECNICO_MECAN, OR' +
          'CAMENTO4.COD_TECNICO_MECAN2, ORCAMENTO4.NOME_TECNICO_MECAN2,'
        
          ' DADOS_VEICULO.CODIGO, DADOS_VEICULO.CHASSI, DADOS_VEICULO.PLACA' +
          ', PEDVENDA.COMBUST_VEIC, PEDVENDA.KM_V, ORCAMENTO4.COD_SERVICO, ' +
          'PEDVENDA.APARELHO_PED,'
        ' ORCAMENTO4.NCM, ORCAMENTO4.ORDEM, ORCAMENTO4.NITEM,'
        
          ' PEDVENDA.COD_EQUIP, PEDVENDA.DATA_PED, FOTOS.CODIGO, PEDVENDA.C' +
          'IDA_AVL, PEDVENDA.ESTA_AVL, PEDVENDA.BAIRRO_AVL, PEDVENDA.CEP_AV' +
          'L,'
        
          ' PEDVENDA.NOME_CLI_ORC, PEDVENDA.HORAABERTURA, PEDVENDA.MINABERT' +
          'URA,'
        
          ' VW_CLIENTES_DEST.CEP, VW_CLIENTES_DEST.LOGRADOURO, VW_CLIENTES_' +
          'DEST.BAIRRO, VW_CLIENTES_DEST.CIDADE, VW_CLIENTES_DEST.UF, VW_CL' +
          'IENTES_DEST.COMPLEMENTO, PEDVENDA.DEST_SEQID,'
        
          ' PRODUTOS.LOCACAO_PROD, PRODUTOS.LOCACAO_PROD_1, PRODUTOS.LOC_DE' +
          'P,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_REM, PEDVENDA_ATIVIDADES_REPAR' +
          'P.SELOS_COL, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM, PEDVENDA_ATI' +
          'VIDADES_REPARP.LACRES_COL,'
        
          ' PEDVENDA.OBS_LIVRO_REG, ORCAMENTO4.CODIGO_KIT, ORCAMENTO4.DESCR' +
          'ICA0_KIT, ORCAMENTO4.VALOR_KIT, ORCAMENTO4.VALOR_UN_KIT, ORCAMEN' +
          'TO4.RATEIO_ACRESC_KIT, ORCAMENTO4.RATEIO_DESC_KIT,'
        
          ' ORCAMENTO4.MARCA_P, ORCAMENTO4.DESCRICAO, TOTAIS_PEDVENDA.QUANT' +
          '_PED_ITEM, TOTAIS_PEDVENDA.QUANT_SERV_PED,'
        
          ' TOTAIS_PEDVENDA.ACRESCIMO, TOTAIS_PEDVENDA.DESCONTO, TOTAIS_PED' +
          'VENDA.CANCELADO, TOTAIS_PEDVENDA.PESO_BRUT_PROD, VALOR_VENC_MIN.' +
          'DATA,'
        
          ' DADOS_VEICULO.ANOFAB, DADOS_VEICULO.COR, DADOS_VEICULO.MARCA, D' +
          'ADOS_VEICULO.MODELO, DADOS_VEICULO.PLACA, DADOS_VEICULO.RENAVAM,'
        
          ' COLABORADOR.COD_VENDEDOR, COLABORADOR.NOME_VENDEDOR, COLABORADO' +
          'R.RG_VENDEDOR, COLABORADOR.CPF_VENDEDOR, FOTOS_EMP.USAR_LOGO, PE' +
          'DVENDA.TIPO_OS, TIPO_VENDAS.DESCRICAO,'
        
          ' ORCAMENTO4.ID_KIT, TOTAIS_PEDVENDA.QUANT_KIT, PRODUTOS.PESO_BRU' +
          'T_PROD,'
        ' CLIENTES.NUM_END_CLIENTE, PEDVENDA.END_AVL,'
        
          ' ORCAMENTO4.VALOR_KIT_LIQ, ORCAMENTO4.VALOR_UN_KIT_LIQ, TOTAIS_P' +
          'EDVENDA.ACRESC_ITEM_PROD, TOTAIS_PEDVENDA.DESC_ITEM_PROD, TOTAIS' +
          '_PEDVENDA.ACRESC_ITEM_SERV,'
        
          ' TOTAIS_PEDVENDA.DESC_ITEM_SERV, PEDVENDA.COD_US_FECH, COLABORAD' +
          'OR_1.NOME_VENDEDOR,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.SELOS_COL1, PEDVENDA_ATIVIDADES_REPA' +
          'RP.SELOS_COL2, PEDVENDA_ATIVIDADES_REPARP.SELOS_REM1, PEDVENDA_A' +
          'TIVIDADES_REPARP.SELOS_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.LACRES_COL1, PEDVENDA_ATIVIDADES_REP' +
          'ARP.LACRES_COL2, PEDVENDA_ATIVIDADES_REPARP.LACRES_REM1, PEDVEND' +
          'A_ATIVIDADES_REPARP.LACRES_REM2,'
        
          ' PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA1, PEDVENDA_ATIVIDADES_RE' +
          'PARP.OBS_TPVENDA2, PEDVENDA_ATIVIDADES_REPARP.OBS_TPVENDA, PEDVE' +
          'NDA.ESTADO_VEIC, PEDVENDA.DEFEITO,'
        
          ' PEDVENDA.ACESSORIOS, PEDVENDA.OBS_OS, FOTOS.CODIGO, FOTOS.FOTO,' +
          ' FOTOS_EMP.CODIGO, FOTOS_EMP.FOTO'
        ''
        ' FROM PEDVENDA'
        
          ' LEFT JOIN TOTAIS_PEDVENDA ON TOTAIS_PEDVENDA.NPED=PEDVENDA.NPED' +
          ' AND TOTAIS_PEDVENDA.TIPO=PEDVENDA.TIPO AND TOTAIS_PEDVENDA.COD_' +
          'EMPRESA=PEDVENDA.COD_EMPRESA'
        
          ' LEFT JOIN PEDVENDA_ATIVIDADES_REPARP ON PEDVENDA_ATIVIDADES_REP' +
          'ARP.NPED=PEDVENDA.NPED AND PEDVENDA_ATIVIDADES_REPARP.TIPO=PEDVE' +
          'NDA.TIPO AND PEDVENDA_ATIVIDADES_REPARP.COD_EMPRESA=PEDVENDA.COD' +
          '_EMPRESA'
        
          ' LEFT JOIN CLIENTES ON PEDVENDA.COD_CLIENTE=CLIENTES.COD_CLIENTE' +
          ' AND PEDVENDA.COD_EMPRESA=CLIENTES.COD_EMPRESA'
        ' LEFT JOIN EMPRESA ON PEDVENDA.COD_EMPRESA=EMPRESA.COD_EMPRESA'
        
          ' LEFT JOIN ESTADOS ESTADOS_1 ON ESTADOS_1.CODIGO_UF = EMPRESA.UF' +
          '_EMP'
        
          ' LEFT JOIN COND_PAG ON PEDVENDA.COD_COND_PAG=COND_PAG.COD_COND_P' +
          'AG'
        
          ' LEFT JOIN COLABORADOR ON PEDVENDA.COD_VENDEDOR=COLABORADOR.COD_' +
          'VENDEDOR AND PEDVENDA.COD_EMPRESA=COLABORADOR.COD_EMPRESA'
        
          ' LEFT JOIN ORCAMENTO4 ON PEDVENDA.NPED=ORCAMENTO4.NPED AND PEDVE' +
          'NDA.COD_EMPRESA=ORCAMENTO4.COD_EMPRESA AND PEDVENDA.TIPO=ORCAMEN' +
          'TO4.TIPO'
        
          ' LEFT JOIN VW_CLIENTES_DEST ON PEDVENDA.COD_CLIENTE=VW_CLIENTES_' +
          'DEST.COD_CLIENTE AND PEDVENDA.COD_EMPRESA=VW_CLIENTES_DEST.COD_E' +
          'MPRESA AND PEDVENDA.DEST_SEQID=VW_CLIENTES_DEST.DEST_SEQID'
        
          ' LEFT JOIN VALOR_VENC_MIN ON PEDVENDA.NPED=VALOR_VENC_MIN.NPED A' +
          'ND PEDVENDA.COD_EMPRESA=VALOR_VENC_MIN.COD_EMPRESA AND PEDVENDA.' +
          'TIPO=VALOR_VENC_MIN.TIPO'
        
          ' LEFT JOIN DADOS_VEICULO ON PEDVENDA.NPED=DADOS_VEICULO.NPED AND' +
          ' PEDVENDA.COD_EMPRESA=DADOS_VEICULO.COD_EMPRESA AND PEDVENDA.TIP' +
          'O=DADOS_VEICULO.TIPO'
        
          ' LEFT JOIN FOTOS_EMP ON PEDVENDA.COD_EMPRESA=FOTOS_EMP.COD_EMPRE' +
          'SA'
        
          ' LEFT JOIN TIPO_VENDAS ON PEDVENDA.TIPO=TIPO_VENDAS.TIPO AND PED' +
          'VENDA.TIPV=TIPO_VENDAS.SIGLA'
        
          ' LEFT JOIN COLABORADOR COLABORADOR_1 ON PEDVENDA.COD_EMPRESA=COL' +
          'ABORADOR_1.COD_EMPRESA AND PEDVENDA.COD_US_FECH=COLABORADOR_1.CO' +
          'D_VENDEDOR'
        
          ' LEFT JOIN GRADE ON ORCAMENTO4.COD_EMPRESA=GRADE.COD_EMPRESA AND' +
          ' ORCAMENTO4.COD_GRADE=GRADE.COD_GRADE'
        
          ' LEFT JOIN PRODUTOS ON ORCAMENTO4.GRUPO_PROD=PRODUTOS.GRUPO_PROD' +
          ' AND ORCAMENTO4.COD_EMPRESA=PRODUTOS.COD_EMPRESA AND ORCAMENTO4.' +
          'COD_PROD=PRODUTOS.COD_PROD'
        
          ' LEFT JOIN FOTOS ON ORCAMENTO4.NPED=FOTOS.CODIGO AND ORCAMENTO4.' +
          'COD_EMPRESA=FOTOS.COD_EMPRESA AND ORCAMENTO4.GRUPO_PROD=FOTOS.GR' +
          'UPO_PROD AND ORCAMENTO4.COD_PROD=FOTOS.COD_PROD AND ORCAMENTO4.C' +
          'OD_GRADE=FOTOS.COD_GRADE AND ORCAMENTO4.TIPO_FOTO=FOTOS.TIPO'
        
          ' LEFT JOIN ESTADOS ESTADOS ON CLIENTES.CODIGO_UF=ESTADOS.CODIGO_' +
          'UF;'
