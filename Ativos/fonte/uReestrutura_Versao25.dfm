        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_PEDVENDA_COD_US_FECH FOR PEDVENDA'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        'begin'
        '  if (substring(user from 1 for 4) = '#39'REPL'#39') then'
        '    exit;'
        ''
        '  if (coalesce(new.id_commerce, 0) <= 0) then'
        '    exit;'
        ''
        '  if (inserting) then'
        '  begin'
        '    if (coalesce(new.cod_us_fech, 0) <= 0) then'
        '      new.cod_us_fech = new.cod_vendedor;'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    if (coalesce(new.cod_us_fech, 0) <= 0) then'
        '      new.cod_us_fech = new.cod_vendedor;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PRECO_PRODUTOS_QTDE ADD MAX_DESC T_VL_TODOS;'
        ''
        'ALTER TABLE PRECO_PRODUTOS_QTDE ADD MARKUP T_N_GERAL;'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER PRECO_PRODUTOS_QTDE_BU_CALC_MKT FOR PREC' +
          'O_PRODUTOS_QTDE'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 9'
        'as'
        '  declare variable CUSTO T_VL_TODOS;'
        '  declare variable PRECO T_VL_TODOS;'
        '  declare variable DIG integer;'
        'begin'
        ''
        '  if (round(coalesce(new.MARKUP, 0), 2) > 0) then'
        '  begin'
        ''
        '    select P.PREC_CUSM_PROD, E.CASAS_DECIMAIS'
        '    from PRODUTOS P'
        '      inner join EMPRESA E on E.COD_EMPRESA = P.COD_EMPRESA'
        '    where P.GRUPO_PROD = new.GRUPO_PROD and'
        '          P.COD_PROD = new.COD_PROD and'
        '          P.COD_EMPRESA = new.COD_EMPRESA'
        '      into :CUSTO, :DIG;'
        ''
        '    if (coalesce(CUSTO, 0) <= 0) then'
        '      exit;'
        ''
        '    DIG = iif(coalesce(DIG, 0) <= 0, 2, DIG);'
        '    DIG = iif(DIG > 10, 3, DIG);'
        '    PRECO = round(CUSTO * (1 + (new.MARKUP / 100)), :DIG);'
        ''
        '    if (abs(new.PRECO_VENDA - PRECO) > 0.01) then'
        '      new.PRECO_VENDA = PRECO;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
