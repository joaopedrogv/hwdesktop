        '    COD_COND_PAG,'
        '    COD_EMPRESA,'
        '    DESC_COND_PAG,'
        '    SEQPRECO,'
        '    MAX_DESC,'
        '    ATIVO,'
        '    FINALIZADOR_CUPOM,'
        '    NATUREZA_CP,'
        '    MODALIDADE,'
        '    CONSIDERAR_DIA_UTIL,'
        '    PARCELAS_ADICIONAIS,'
        '    COND_PADRAO_CL_VND,'
        '    COND_PADRAO_CL_PREST)'
        'AS'
        'SELECT'
        'COND_PAG.COD_COND_PAG,'
        'COND_PAG_EMPRESA.COD_EMPRESA,'
        'COND_PAG.DESC_COND_PAG,'
        'COND_PAG.SEQPRECO,'
        'COND_PAG.MAX_DESC,'
        'COND_PAG.ATIVO,'
        'COND_PAG.FINALIZADOR_CUPOM,'
        'COND_PAG.NATUREZA_CP,'
        'COND_PAG.MODALIDADE,'
        'COND_PAG.CONSIDERAR_DIA_UTIL,'
        'COND_PAG.PARCELAS_ADICIONAIS,'
        'COND_PAG.COND_PADRAO_CL_VND,'
        'COND_PAG.COND_PADRAO_CL_PREST'
        'FROM COND_PAG'
        'LEFT JOIN COND_PAG_EMPRESA ON'
        '    COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_INSERIR_CONDPAG_EMP ('
        '    PCOD_COND_PAG integer,'
        '    PTODOS integer)'
        'returns ('
        '    RESULT varchar(10))'
        'as'
        'declare variable VCOD_COND_PAG integer;'
        'declare variable VCOD_EMPRESA integer;'
        'begin'
        '  result = '#39'ERRO'#39';'
        '  /* Procedure Text */'
        '  if (ptodos > 0) then'
        '  begin'
        '    for select cod_cond_pag from cond_pag'
        '        order by cod_cond_pag'
        '      into :vcod_cond_pag do'
        '    begin'
        '      for select cod_empresa from empresa'
        '          order by cod_empresa'
        '        into :vcod_empresa do'
        '      begin'
        
          '        update or insert into cond_pag_empresa (cod_cond_pag, co' +
          'd_empresa)'
        '        values (:vcod_cond_pag, :vcod_empresa)'
        '        matching (cod_cond_pag, cod_empresa);'
        '      end'
        '    end'
        '  end'
        '  else'
        '  begin'
        '    for select cod_empresa from empresa'
        '        order by cod_empresa'
        '      into :vcod_empresa do'
        '    begin'
        
          '      update or insert into cond_pag_empresa (cod_cond_pag, cod_' +
          'empresa)'
        '      values (:pcod_cond_pag, :vcod_empresa)'
        '      matching (cod_cond_pag, cod_empresa);'
        '    end'
        '  end'
        ''
        '  result = '#39'OK'#39';'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TR_COND_PAG_EMP FOR COND_PAG'
        'ACTIVE BEFORE INSERT POSITION 1'
        'AS'
        '  DECLARE VARIABLE VRESULT VARCHAR(10);'
        'begin'
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    if (new.cod_cond_pag > 0) then'
        '    begin'
        
          '      select result from sp_inserir_condpag_emp(new.cod_cond_pag' +
          ', 0) into :vresult;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'select result from sp_inserir_condpag_emp (0, 1);'
        ''
        '|BLOCO|'
        'create or alter procedure RETORNA_QTDE_DEV_VND ('
        '    PNDOC integer,'
        '    PTIPO char(3),'
        '    PCOD_EMPRESA integer,'
        '    PVALOR_TOT double precision)'
        'returns ('
        '    VALOR_TOTAL_DEV double precision,'
        '    VALOR_TOTAL_APOS_DEV double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  valor_total_dev = 0;'
        '  execute statement'
        
          '  '#39' select sum(coalesce(d.quant, 0) * coalesce(d.valor, 0)) quan' +
          'tidade from devolucao d'
        '    where d.cod_venda = '#39' || :pndoc || '#39
        '    and d.tipo_venda = '#39#39#39' || :ptipo || '#39#39#39
        '    and d.cod_empresa = '#39' || :pcod_empresa'
        '      into :valor_total_dev;'
        ''
        '  valor_total_dev = coalesce(valor_total_dev, 0);'
        
          '  valor_total_apos_dev = coalesce(pvalor_tot, 0) - coalesce(valo' +
          'r_total_dev, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'PRO451'#39', :COD_EMPRESA, '#39'HA' +
          'BILITAR PRECOS POR QTDE CADASTRO SIMPL PROD'#39', 1, '#39'FRMCADPRODUTOS' +
          #39', 1, '#39'N'#39', '#39'N'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        'create or alter procedure SP_NFCE_TOT ('
        '    PCOD_NFCE integer,'
        '    PCOD_EMRESA integer)'
        'returns ('
        '    VALOR_TOTAL double precision,'
        '    VALOR_PROD double precision,'
        '    VALOR_SERV double precision,'
        '    BASE_ICM double precision,'
        '    VALOR_ICM double precision,'
        '    BASE_ICMSUB double precision,'
        '    VALOR_ICMSUB double precision,'
        '    BASE_ISS double precision,'
        '    VALOR_ISS double precision,'
        '    VALOR_DESC double precision,'
        '    VALOR_DESC_P double precision,'
        '    VALOR_DESC_S double precision,'
        '    CODIGO_NOP integer,'
        '    DESCRICAO_NOP varchar(100))'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select'
        '  sum(coalesce(nfci.vprod, 0)) valor_total,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then 0 else coalesce(nfci' +
          '.vprod, 0) end) valor_prod,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then coalesce(nfci.vprod,' +
          ' 0) else 0 end) valor_serv,'
        '  sum(coalesce(nfci.icm_vbc, 0)) base_icm,'
        '  sum(coalesce(nfci.icm_vicms, 0)) valor_icm,'
        '  0 base_icmsub, '
        '  0 valor_icmsub,'
        '  sum(coalesce(nfci.iss_vbc, 0)) base_iss,'
        '  sum(coalesce(nfci.iss_vissqn, 0)) valor_iss,'
        '  sum(coalesce(nfci.vdesc, 0)) valor_desc,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then 0 else coalesce(nfci' +
          '.vdesc, 0) end) valor_desc_p,'
        
          '  sum(case when (nfci.tipo_item = '#39'S'#39') then coalesce(nfci.vdesc,' +
          ' 0) else 0 end) valor_desc_s from nfce nfc'
        
          '  inner join nfce_item nfci on nfci.cod_nfce = nfc.cod_nfce and ' +
          'nfci.cod_empresa = nfc.cod_empresa'
        '  where nfc.cod_nfce = :pcod_nfce'
        '  and nfc.cod_empresa = :pcod_emresa'
        '    into :valor_total, :valor_prod, :valor_serv,'
        
          '         :base_icm, :valor_icm, :base_icmsub, :valor_icmsub, :ba' +
          'se_iss, :valor_iss,'
        '         :valor_desc, :valor_desc_p, :valor_desc_s;'
        ''
        '  select first 1 nfci.cfop, nt.descricao_nop from nfce_item nfci'
        '  inner join nat_op nt on nfci.cfop = nt.codigo_nop'
        '  where nfci.cod_nfce = :pcod_nfce'
        '  and nfci.cod_empresa = :pcod_emresa'
        '  order by nfci.nitem'
        '    into :codigo_nop, :descricao_nop;'
        ''
        '  valor_total = coalesce(valor_total, 0);'
        '  valor_prod = coalesce(valor_prod, 0);'
        '  valor_serv = coalesce(valor_serv, 0);'
        '  base_icm = coalesce(base_icm, 0);'
        '  valor_icm = coalesce(valor_icm, 0);'
        '  base_icmsub = coalesce(base_icmsub, 0);'
        '  valor_icmsub = coalesce(valor_icmsub, 0);'
        '  base_iss = coalesce(base_iss, 0);'
        '  valor_iss = coalesce(valor_iss, 0);'
        '  valor_desc = coalesce(valor_desc, 0);'
        '  valor_desc_p = coalesce(valor_desc_p, 0);'
        '  valor_desc_s = coalesce(valor_desc_s, 0);'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
