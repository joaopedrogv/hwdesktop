          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc,'
        '    '#39'PRESTACOES'#39' tp_recebimento, '#39'RECIBO'#39' tp_recebimento2,'
        '    5 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then pr.codigo_ctrl els' +
          'e ctr1.codigo_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
        '    coalesce(pr.cod_cred, 0) cod_cred,'
        
          '    coalesce(pr.n_doc_c, 0) Num_doc, coalesce(fp.ndoc, coalesce(' +
          'pr.n_doc_c, 0)) as Num_doc2, pr.data_venc_c as Data_Doc,'
        '    pr.data_rec_c as Data_Conf,'
        '    coalesce(pr.valor_c, 0) as valor_total,'
        
          '    case when coalesce(pr.valor_corr, 0) > 0 then coalesce(pr.va' +
          'lor_corr, 0) else pr.valor_c end as valor_total,'
        
          '    '#39' '#39' as obs_cxl_rq, coalesce(pr.lote_cxl, cod_cred) as lotere' +
          'c,'
        
          '    pr.dia_cxl, coalesce(pr.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', pr.codigo_vend, fp.data_mov, fp.historico,'
        
          '    case when(fp.valordoc < 0) then (coalesce(fp.valordoc, 0) * ' +
          '-1) else coalesce(fp.valordoc, 0) end valor_pago, fp.data_mov, '#39 +
          ' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo, 0 as valor_recibo,'
        '    '
        '    coalesce(('
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '            0'
        '         else'
        
          '            (select coalesce(pd.num_nfce, 0) from pedvenda pd   ' +
          '     '
        
          '             where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_' +
          'v and pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) ncupom,'
        '    '
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '        (select coalesce(cf.num_nota_v, 0) from com_fat cf'
        
          '        where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.' +
          'codigo_emp)'
        '    else'
        '        (select coalesce(pd.num_nf, 0) from pedvenda pd'
        
          '        where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and' +
          ' pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) num_nf,'
        '    '
        
          '    0 as nparcela, pr.cod_cred, coalesce(fp.seqform, pr.cod_cred' +
          '),'
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select coalesce(tp.venda, '#39'S'#39') venda from com_fat cf left j' +
          'oin tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        
          '    else (select coalesce(tp.venda, '#39'S'#39') venda from pedvenda pd ' +
          'left join tipo_vendas tp on tp.tipo = pd.tipo and (tp.sigla = pd' +
          '.tipv or (tp.tipo_os = pd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end), '#39'S'#39') venda,'
        '    '
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select tp.tipo_os from com_fat cf left join tipo_vendas tp ' +
          'on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        '    when(trim(pr.tp_doc_v) = '#39'OS'#39') then'
        
          '    (select tp.tipo_os from pedvenda pd left join tipo_vendas tp' +
          ' on tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = p' +
          'd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    else'
        
          '    (select tp.sigla from pedvenda pd left join tipo_vendas tp o' +
          'n tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = pd.' +
          'tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end tipv,'
        '    pr.tp_doc_v as tipo_doc, 0 id_commerce,'
        
          '    coalesce((case when((select count(*) from controle_creditos ' +
          'cc where cc.lote_cxl = pr.lote_cxl and cc.cod_emp_mult = pr.cod_' +
          'emp_mult) = 0) then'
        '        1'
        '    else'
        
          '        (select count(*) from controle_creditos cc where cc.lote' +
          '_cxl = pr.lote_cxl and cc.cod_emp_mult = pr.cod_emp_mult)'
        '    end), 1) qtde_prest'
        '    from controle_creditos pr'
        '    inner join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = pr.op_cxl a' +
          'nd col.cod_empresa = pr.cod_emp_mult'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.cod_emp_mult'
        
          '    inner join formpagamento fp on fp.nrequisicao = pr.lote_cxl ' +
          'and fp.cod_empresa = pr.cod_emp_mult and fp.tpdocs = '#39'PRE'#39' and (' +
          'not fp.recibo is null)'
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = fp.cod_controle' +
          ' and ctr.codigo_emp = fp.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        '    union'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else pr.codigo_emp end) cod_empresa,'
        '    pr.cod_emp_mult, coalesce(pr.cod_cliente, 0) cod_cliente,'
        
          '    case when (cl.nome_cliente is null) then pr.nome_c else cl.n' +
          'ome_cliente end nome_cliente,'
        
          '    case when (cl.cpfcgc is null) then pr.cpfcgc else cl.cpfcgc ' +
          'end cpfcgc,'
        '    '#39'PRESTACOES'#39' tp_recebimento, '#39'TROCO'#39' tp_recebimento2,'
        '    5 ordem,'
        
          '    case when (ctr1.codigo_ctrl is null) then pr.codigo_ctrl els' +
          'e ctr1.codigo_ctrl end cod_tipo,'
        
          '    case when (ctr1.nome_ctrl is null) then pr.tipo_doc_c else c' +
          'tr1.nome_ctrl end tipo,'
        '    coalesce(pr.cod_cred, 0) cod_cred,'
        
          '    coalesce(pr.n_doc_c, 0) Num_doc, coalesce(fp.ndoc, coalesce(' +
          'pr.n_doc_c, 0)) as Num_doc2, pr.data_venc_c as Data_Doc,'
        '    pr.data_rec_c as Data_Conf,'
        '    coalesce(pr.valor_c, 0) as valor_total,'
        
          '    case when coalesce(pr.valor_corr, 0) > 0 then coalesce(pr.va' +
          'lor_corr, 0) else pr.valor_c end as valor_total,'
        
          '    '#39' '#39' as obs_cxl_rq, coalesce(pr.lote_cxl, cod_cred) as lotere' +
          'c,'
        
          '    pr.dia_cxl, coalesce(pr.op_cxl, 0) op_cxl, col.nome_vendedor' +
          ', pr.codigo_vend, fp.data_mov, fp.historico,'
        
          '    coalesce(fp.valordoc, 0) valor_pago, fp.data_mov, '#39' '#39' tercei' +
          'ros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo, 0 as valor_recibo,'
        '    '
        '    coalesce(('
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '            0'
        '         else'
        
          '            (select coalesce(pd.num_nfce, 0) from pedvenda pd   ' +
          '     '
        
          '             where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_' +
          'v and pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) ncupom,'
        ''
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        '        (select coalesce(cf.num_nota_v, 0) from com_fat cf'
        
          '        where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.' +
          'codigo_emp)'
        '    else'
        '        (select coalesce(pd.num_nf, 0) from pedvenda pd'
        
          '        where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and' +
          ' pd.cod_empresa = pr.codigo_emp)'
        '    end), 0) num_nf,'
        '    '
        
          '    0 as nparcela, pr.cod_cred, coalesce(fp.seqform, pr.cod_cred' +
          '),'
        '    coalesce((case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select coalesce(tp.venda, '#39'S'#39') venda from com_fat cf left j' +
          'oin tipo_vendas tp on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        
          '    else (select coalesce(tp.venda, '#39'S'#39') venda from pedvenda pd ' +
          'left join tipo_vendas tp on tp.tipo = pd.tipo and (tp.sigla = pd' +
          '.tipv or (tp.tipo_os = pd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end), '#39'S'#39') venda,'
        '    '
        '    case when(trim(pr.tp_doc_v) = '#39'MOT'#39') then'
        
          '    (select tp.tipo_os from com_fat cf left join tipo_vendas tp ' +
          'on tp.tipo = '#39'VEI'#39' and tp.tipo_os = cf.tipo_v'
        
          '    where cf.n_comando = pr.n_doc_v and cf.cod_empresa = pr.codi' +
          'go_emp)'
        '    when(trim(pr.tp_doc_v) = '#39'OS'#39') then'
        
          '    (select tp.tipo_os from pedvenda pd left join tipo_vendas tp' +
          ' on tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = p' +
          'd.tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    else'
        
          '    (select tp.sigla from pedvenda pd left join tipo_vendas tp o' +
          'n tp.tipo = pd.tipo and (tp.sigla = pd.tipv or (tp.tipo_os = pd.' +
          'tipo_os))'
        
          '    where pd.nped = pr.n_doc_v and pd.tipo = pr.tp_doc_v and pd.' +
          'cod_empresa = pr.codigo_emp)'
        '    end tipv,'
        '    pr.tp_doc_v as tipo_doc, 0 id_commerce,'
        
          '    coalesce((case when((select count(*) from controle_creditos ' +
          'cc where cc.lote_cxl = pr.lote_cxl and cc.cod_emp_mult = pr.cod_' +
          'emp_mult) = 0) then'
        '        1'
        '    else'
        
          '        (select count(*) from controle_creditos cc where cc.lote' +
          '_cxl = pr.lote_cxl and cc.cod_emp_mult = pr.cod_emp_mult)'
        '    end), 1) qtde_prest'
        '    from controle_creditos pr'
        '    inner join empresa emp on pr.codigo_emp = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = pr.op_cxl a' +
          'nd col.cod_empresa = pr.cod_emp_mult'
        
          '    left join clientes cl on cl.cod_cliente = pr.cod_cliente and' +
          ' cl.cod_empresa = pr.cod_emp_mult'
        
          '    inner join formpagamento fp on fp.rec_numvend = pr.lote_cxl ' +
          'and fp.cod_empresa = pr.cod_emp_mult and fp.rec_tipvend = '#39'PRE'#39' ' +
          'and fp.tpdocs = '#39'TRC'#39
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = fp.cod_controle' +
          ' and ctr.codigo_emp = fp.cod_empresa'
        
          '    left join CONTROLES ctr1 on ctr1.codigo_ctrl = pr.codigo_ctr' +
          'l and ctr1.codigo_emp = pr.codigo_emp'
        '    where coalesce(pr.status_c, '#39#39') = '#39#39' and pr.datq_c is null'
        ''
        '    union'
        ''
        '    -- LANC CXL'
        ''
        
          '    select (case when(emp.financeiro_unificado = '#39'S'#39') then emp.c' +
          'odigo_unificadora else lanc.codigo_emp end) cod_empresa,'
        '    lanc.codigo_emp, 0, coalesce(lanc.historico_cxl, '#39#39'), '#39#39','
        
          '    '#39'LANCAMENTO AVULSO'#39' tp_recebimento, '#39'DIRETO'#39' tp_recebimento2' +
          ','
        '    6 ordem, 0 cod_tipo, '#39'LANC CXL'#39' tipo, 0 cod_cred,'
        
          '    coalesce(lanc.n_doc_cxl, 0) num_doc, coalesce(fp.ndoc, coale' +
          'sce(lanc.n_doc_cxl, 0)) as Num_doc2, lanc.data_lc_cxl data_doc,'
        '    lanc.data_lc_cxl,'
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then (lanc.valor_cxl * ' +
          '-1) else lanc.valor_cxl end valor_total,'
        
          '    case when (lanc.tipo_lanc_cxl = '#39'S'#39') then (lanc.valor_cxl * ' +
          '-1) else lanc.valor_cxl end valor_total,'
        '    '#39' '#39' as obs_cxl_rq, coalesce(lanc.cod_lancxl, 0) as loterec,'
        
          '    lanc.data_lc_cxl, coalesce(lanc.op_cxl, 0), col.nome_vendedo' +
          'r, lanc.op_cxl, fp.data_mov, fp.historico,'
        '    coalesce(fp.valordoc, 0), fp.data_mov, '#39' '#39' terceiros,'
        
          '    case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl ' +
          'end codigo_ctrl,'
        
          '    case when ctr.nome_ctrl is null then '#39'SEM FORMA'#39' else ctr.no' +
          'me_ctrl end nome_ctrl,'
        '    0 as num_recibo, 0 as valor_recibo,'
        '    0 ncupom, 0 num_nf,'
        
          '    0 as nparcela, lanc.cod_lancxl, coalesce(fp.seqform, lanc.co' +
          'd_lancxl), '
        
          '    '#39'N'#39' venda, '#39#39' tipv, '#39'LANCCXL'#39' tipo_doc, 0 id_commerce, 1 qtd' +
          'e_prest from lanccxl lanc'
        '    inner join empresa emp on lanc.codigo_emp = emp.cod_empresa'
        
          '    inner join colaborador col on col.cod_vendedor = lanc.op_cxl' +
          ' and col.cod_empresa = lanc.codigo_emp'
        
          '    inner join formpagamento fp on fp.nrequisicao = lanc.cod_lan' +
          'cxl and fp.cod_empresa = lanc.codigo_emp and fp.tpdocs = '#39'LCS'#39
        
          '    left join CONTROLES ctr on ctr.codigo_ctrl = fp.cod_controle' +
          ' and ctr.codigo_emp = fp.cod_empresa'
        '    where lanc.tipo_doc_cxl is null and lanc.refrecibo is null;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_ATIVIDADES_REPARP('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    SELOS_COL,'
        '    SELOS_REM,'
        '    LACRES_COL,'
        '    LACRES_REM,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2)'
        'AS'
        'select nped, tipo, cod_empresa,'
        
          'cast(substring(selos_col from 1 for 400) as varchar(400)) selos_' +
          'col,'
        
          'cast(substring(selos_rem from 1 for 400) as varchar(400)) selos_' +
          'rem,'
        
          'cast(substring(lacres_col from 1 for 400) as varchar(400)) lacre' +
          's_col,'
        
          'cast(substring(lacres_rem from 1 for 400) as varchar(400)) lacre' +
          's_rem,'
        
          'cast(substring(selos_col from 1 for 200) as varchar(200)) selos_' +
          'col1,'
        
          'cast(substring(selos_col from 201 for 200) as varchar(200)) selo' +
          's_col2,'
        
          'cast(substring(selos_rem from 1 for 200) as varchar(200)) selos_' +
          'rem1,'
        
          'cast(substring(selos_rem from 201 for 200) as varchar(200)) selo' +
          's_rem2,'
        
          'cast(substring(lacres_col from 1 for 200) as varchar(200)) lacre' +
          's_col1,'
        
          'cast(substring(lacres_col from 201 for 200) as varchar(200)) lac' +
          'res_col2,'
        
          'cast(substring(lacres_rem from 1 for 200) as varchar(200)) lacre' +
          's_rem1,'
        
          'cast(substring(lacres_rem from 201 for 200) as varchar(200)) lac' +
          'res_rem2 from pedvenda;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PEDVENDA_PROD ADD ACRESC_PLANO T_VL_TODOS;'
        'ALTER TABLE PEDVENDA_SERV ADD ACRESC_PLANO T_VL_TODOS;'
        'ALTER TABLE PEDVENDA ADD PLANO_CALCULADO CHAR(1);'
        ''
        '|BLOCO|'
        'create or alter procedure SP_PEDVENDA_PLANO_REVERTER ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer)'
        'returns ('
        '    RESULT smallint,'
        '    MSG varchar(128))'
        'as'
        '  declare variable TOTAL_PROD double precision;'
        '  declare variable TOTAL_SERV double precision;'
        '  declare variable ACRESC_PLANO double precision;'
        '  declare variable PED integer;'
        'begin'
        '  RESULT = 1;'
        '  MSG = '#39'SEM ALTERACAO'#39';'
        ''
        '  if ((NPED = 0) or (trim(TIPO) not in ('#39'REQ'#39', '#39'OS'#39')))  then'
        '  begin'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  --obtendo o total geral produtos e servicos'
        '  for select C.PLANO_CALCULADO, sum(C.ACRESC_PLANO) TOTAL'
        
          '      from (select PV.PLANO_CALCULADO, sum(coalesce(PVP.ACRESC_P' +
          'LANO, 0)) ACRESC_PLANO'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_PROD PVP on PVP.NPED = PV.NPED' +
          ' and'
        '                    PVP.TIPO = PV.TIPO and'
        '                    PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVP.STATUS, '#39#39') = '#39#39
        '            group by 1'
        '            union all'
        
          '            select PV.PLANO_CALCULADO, sum(coalesce(PVS.ACRESC_P' +
          'LANO, 0)) ACRESC_PLANO'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_SERV PVS on PVS.NPED = PV.NPED' +
          ' and'
        '                    PVS.TIPO = PV.TIPO and'
        '                    PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVS.STATUS, '#39#39') = '#39#39
        '            group by 1) as C'
        '      group by 1'
        '        into :MSG, :ACRESC_PLANO'
        '  do'
        '  begin'
        
          '    if (coalesce(:MSG, '#39#39') <> '#39'S'#39') then -- nao tem rateio feito ' +
          'anteriormente'
        '    begin'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        ''
        '  for select PV.NPED from PEDVENDA PV'
        
          '    where PV.NPED = :NPED and PV.TIPO = :TIPO and PV.COD_EMPRESA' +
          ' = :COD_EMPRESA'
        '    into :PED'
        '  do'
        '  begin'
        
          '    if (NPED <> PED) then -- nao encontrado o pedido passado com' +
          'o parametro   '
        '    begin'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        ''
        '  if (coalesce(acresc_plano, 0) > 0) then'
        '  begin'
        '    -- atualizando o total dos produtos com o valor do plano'
        '    update PEDVENDA_PROD PVP'
        
          '    set --PVP.VLUN_PED_ITEM = round((PVP.VLTOT_PED_ITEM - coales' +
          'ce(PVP.ACRESC_PLANO, 0)) / PVP.QUANT_PED_ITEM, 4),'
        
          '        --PVP.VLTOT_PED_ITEM = PVP.VLTOT_PED_ITEM - coalesce(PVP' +
          '.ACRESC_PLANO, 0),'
        '        PVP.ACRESC_ITEM = PVP.ACRESC_ITEM - PVP.ACRESC_PLANO,'
        '        PVP.ACRESC_PLANO = 0'
        '    where PVP.NPED = :NPED and'
        '          PVP.TIPO = :TIPO and'
        '          PVP.COD_EMPRESA = :COD_EMPRESA and'
        '          coalesce(STATUS, '#39#39') = '#39#39';'
        '  '
        '    -- atualizando o total dos servicos com o valor do plano'
        '    update PEDVENDA_SERV PVS'
        
          '    set --PVS.VALOR_UN_SERV = round((PVS.VALOR_TOT_SERV - coales' +
          'ce(PVS.ACRESC_PLANO, 0)) / PVS.QUANT_SERV_PED, 4),'
        
          '        --PVS.VALOR_TOT_SERV = PVS.VALOR_TOT_SERV - coalesce(PVS' +
          '.ACRESC_PLANO, 0),'
        '        PVS.ACRESC_ITEM = PVS.ACRESC_ITEM - PVS.ACRESC_PLANO,'
        '        PVS.ACRESC_PLANO = 0'
        '    where PVS.NPED = :NPED and'
        '          PVS.TIPO = :TIPO and'
        '          PVS.COD_EMPRESA = :COD_EMPRESA and'
        '          coalesce(STATUS, '#39#39') = '#39#39';'
        '  end'
        ''
        
          '  -- finalizando somamos o total prod e total serv para atualiza' +
          'r no cabecalho'
        '  /*'
        
          '  for select sum(C.TOTAL_PROD) TOTAL_PROD, sum(C.TOTAL_SERV) TOT' +
          'AL_SERV'
        
          '      from (select sum(coalesce(PVP.VLTOT_PED_ITEM, 0)) TOTAL_PR' +
          'OD, 0.0 TOTAL_SERV'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_PROD PVP on PVP.NPED = PV.NPED' +
          ' and'
        '                    PVP.TIPO = PV.TIPO and'
        '                    PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVP.STATUS, '#39#39') = '#39#39
        '            union all'
        
          '            select 0.0 TOTAL_PROD, sum(coalesce(PVS.VALOR_TOT_SE' +
          'RV, 0)) TOTAL_SERV'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_SERV PVS on PVS.NPED = PV.NPED' +
          ' and'
        '                    PVS.TIPO = PV.TIPO and'
        '                    PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVS.STATUS, '#39#39') = '#39#39
        ''
        '      ) as C'
        '        into :TOTAL_PROD, :TOTAL_SERV'
        '  do'
        '  */'
        '  begin'
        '    -- atualizando o valor total do pedido'
        '    update PEDVENDA'
        '    set --TOT_PROD = :TOTAL_PROD,'
        '        --TOT_SERV = :TOTAL_SERV,'
        '        PLANO_CALCULADO = '#39'N'#39
        '    where NPED = :NPED and'
        '          TIPO = :TIPO and'
        '          COD_EMPRESA = :COD_EMPRESA;'
        '  end'
        ''
        '  MSG = '#39'REVERTIDO'#39';'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_PEDVENDA_PLANO_RATEAR ('
        '    NPED integer,'
        '    TIPO char(3),'
        '    COD_EMPRESA integer,'
        '    VPLANO double precision)'
        'returns ('
        '    RESULT smallint,'
        '    MSG varchar(128))'
        'as'
        '  declare variable TOTAL double precision;'
        '  declare variable TOTAL_PROD double precision;'
        '  declare variable TOTAL_SERV double precision;'
        '  declare variable ACRESC_PLANO double precision;'
        '  declare variable PLANO_CALCULADO char(1);'
        '  declare variable NITEM integer;'
        '  declare variable GRUPO_PROD integer;'
        '  declare variable COD_PROD char(6);'
        '  declare variable COD_GRADE integer;'
        '  declare variable CODIGO_NOP double precision;'
        '  declare variable COD_SERVICO integer;'
        '  declare variable PED integer;'
        'begin'
        '  RESULT = 1;'
        '  MSG = '#39#39';'
        ''
        '  if (VPLANO <= 0) then'
        '  begin'
        '    RESULT = 0;'
        '    MSG = '#39'Sem valor para o plano, sem necessidade de calcular'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        '  '
        '  if ((NPED = 0) or (trim(TIPO) not in ('#39'REQ'#39', '#39'OS'#39')))  then'
        '  begin                                                         '
        '    RESULT = 0;'
        '    MSG = '#39'Parametros invalidos'#39';'
        '    suspend;'
        '    exit;'
        '  end'
        ''
        '  for select PV.NPED from PEDVENDA PV'
        
          '    where PV.NPED = :NPED and PV.TIPO = :TIPO and PV.COD_EMPRESA' +
          ' = :COD_EMPRESA'
        '    into :PED'
        '  do'
        '  begin'
        
          '    if (NPED <> PED) then -- nao encontrado o pedido passado com' +
          'o parametro   '
        '    begin                                   '
        '      RESULT = 0;'
        '      MSG = '#39'Pedido ou OS nao encontrado'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        ''
        '  --obtendo o total geral produtos e servicos'
        '  for select C.PLANO_CALCULADO, C.STATUS_PED, sum(C.TOTAL) TOTAL'
        
          '      from (select PV.PLANO_CALCULADO, PV.STATUS_PED, sum(coales' +
          'ce(PVP.VLTOT_PED_ITEM, 0)) TOTAL'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_PROD PVP on PVP.NPED = PV.NPED' +
          ' and'
        '                    PVP.TIPO = PV.TIPO and'
        '                    PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVP.STATUS, '#39#39') = '#39#39
        '            group by 1,2'
        '            union all'
        
          '            select PV.PLANO_CALCULADO, PV.STATUS_PED, sum(coales' +
          'ce(PVS.VALOR_TOT_SERV, 0))'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_SERV PVS on PVS.NPED = PV.NPED' +
          ' and'
        '                    PVS.TIPO = PV.TIPO and'
        '                    PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVS.STATUS, '#39#39') = '#39#39
        '            group by 1, 2) as C'
        '      group by 1,2'
        '        into :PLANO_CALCULADO, :MSG, :TOTAL'
        '  do'
        '  begin'
        '    if (coalesce(MSG, '#39#39') <> '#39#39') then'
        '    begin'
        '      RESULT = 0;'
        '      MSG = '#39'Status igual a '#39' || MSG;'
        '      suspend;'
        '      exit;'
        '    end'
        '    '
        '    if (coalesce(PLANO_CALCULADO, '#39#39') = '#39'S'#39') then'
        '    begin'
        '      RESULT = 0;'
        '      MSG = '#39'Plano j?? rateado entre os itens, tente novamente'#39';'
        '      suspend;'
        '      exit;'
        '    end'
        '  end'
        ''
        '  --setando no produto o rateio do acrecimo do plano'
        '  update PEDVENDA_PROD'
        '  set NAT_DESCACRES = '#39'VALOR'#39','
        
          '      VALOR_DESCACRES = iif(trim(TP_DESCACRES) = '#39'DESCONTO'#39', DES' +
          'C_ITEM, ACRESC_ITEM),'
        '      ACRESC_PLANO = round(:VPLANO / :TOTAL * VLTOT_PED_ITEM, 2)'
        '  where NPED = :NPED and'
        '        TIPO = :TIPO and'
        '        COD_EMPRESA = :COD_EMPRESA and'
        '        coalesce(STATUS, '#39#39') = '#39#39';'
        ''
        '  --setando no servico o rateio do acrecimo do plano'
        '  update PEDVENDA_SERV'
        '  set ACRESC_PLANO = round(:VPLANO / :TOTAL * VALOR_TOT_SERV, 2)'
        '  where NPED = :NPED and'
        '        TIPO = :TIPO and'
        '        COD_EMPRESA = :COD_EMPRESA and'
        '        coalesce(STATUS, '#39#39') = '#39#39';'
        ''
        
          '  -- somando o rateio aplicado para validar com o valor do param' +
          'etro vplano'
        
          '  for select sum(C.TOTAL_PROD) TOTAL_PROD, sum(C.TOTAL_SERV) TOT' +
          'AL_SERV, sum(C.ACRESC_PLANO) ACRESC_PLANO'
        
          '      from (select sum(coalesce(PVP.VLTOT_PED_ITEM, 0)) TOTAL_PR' +
          'OD, 0.0 TOTAL_SERV, sum(PVP.ACRESC_PLANO) ACRESC_PLANO'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_PROD PVP on PVP.NPED = PV.NPED' +
          ' and'
        '                    PVP.TIPO = PV.TIPO and'
        '                    PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVP.STATUS, '#39#39') = '#39#39
        '            union all'
        
          '            select 0.0 TOTAL_PROD, sum(coalesce(PVS.VALOR_TOT_SE' +
          'RV, 0)) TOTAL_SERV, sum(PVS.ACRESC_PLANO) ACRESC_PLANO'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_SERV PVS on PVS.NPED = PV.NPED' +
          ' and'
        '                    PVS.TIPO = PV.TIPO and'
        '                    PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVS.STATUS, '#39#39') = '#39#39
        ''
        '      ) as C'
        '        into :TOTAL_PROD, :TOTAL_SERV, :ACRESC_PLANO'
        '  do'
        '  begin'
        
          '    -- valor diferente entao vamos ajustar para o primeiro item ' +
          'com maior valor seja servico ou produto'
        '    if (round(VPLANO, 2) <> round(ACRESC_PLANO, 2)) then'
        '    begin'
        
          '      for select first 1 C.NITEM, C.GRUPO_PROD, C.COD_PROD, C.CO' +
          'D_GRADE, C.CODIGO_NOP, C.COD_SERVICO'
        
          '          from (select first 1 PVP.VLTOT_PED_ITEM TOTAL, PVP.NIT' +
          'EM, PVP.GRUPO_PROD, PVP.COD_PROD, PVP.COD_GRADE,'
        '                               PVP.CODIGO_NOP, null COD_SERVICO'
        '                from PEDVENDA PV'
        
          '                  inner join PEDVENDA_PROD PVP on PVP.NPED = PV.' +
          'NPED and'
        '                        PVP.TIPO = PV.TIPO and'
        '                        PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '                where PV.NPED = :NPED and'
        '                      PV.TIPO = :TIPO and'
        '                      PV.COD_EMPRESA = :COD_EMPRESA and'
        '                      coalesce(PVP.STATUS, '#39#39') = '#39#39
        '                union all'
        
          '                select first 1 PVS.VALOR_TOT_SERV TOTAL, PVS.NIT' +
          'EM, 0 GRUPO_PROD, '#39#39' COD_PROD, 0 COD_GRADE,'
        '                               PVS.CODIGO_NOP, PVS.COD_SERVICO'
        '                from PEDVENDA PV'
        
          '                  inner join PEDVENDA_SERV PVS on PVS.NPED = PV.' +
          'NPED and'
        '                        PVS.TIPO = PV.TIPO and'
        '                        PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '                where PV.NPED = :NPED and'
        '                      PV.TIPO = :TIPO and'
        '                      PV.COD_EMPRESA = :COD_EMPRESA and'
        '                      coalesce(PVS.STATUS, '#39#39') = '#39#39
        '                order by 1 desc) as C'
        
          '            into :NITEM, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :CO' +
          'DIGO_NOP, :COD_SERVICO'
        '      do'
        '      begin'
        '        if (COD_SERVICO is null) then'
        '          update PEDVENDA_PROD'
        
          '          set ACRESC_PLANO = ACRESC_PLANO + (:VPLANO - :ACRESC_P' +
          'LANO)'
        '          where NPED = :NPED and'
        '                TIPO = :TIPO and'
        '                COD_EMPRESA = :COD_EMPRESA and'
        '                NITEM = :NITEM and'
        '                GRUPO_PROD = :GRUPO_PROD and'
        '                COD_PROD = :COD_PROD and'
        '                COD_GRADE = :COD_GRADE and'
        '                CODIGO_NOP = :CODIGO_NOP;'
        ''
        '        update PEDVENDA_SERV'
        
          '        set ACRESC_PLANO = ACRESC_PLANO + (:VPLANO - :ACRESC_PLA' +
          'NO)'
        '        where NPED = :NPED and'
        '              TIPO = :TIPO and'
        '              COD_EMPRESA = :COD_EMPRESA and'
        '              NITEM = :NITEM and'
        '              COD_SERVICO = :COD_SERVICO and'
        '              CODIGO_NOP = :CODIGO_NOP;'
        '      end'
        '    end'
        '  end'
        ''
        '  -- atualizando o total dos produtos com o valor do plano'
        '  update PEDVENDA_PROD PVP'
        
          '  set --PVP.VLUN_PED_ITEM = round((PVP.VLTOT_PED_ITEM + coalesce' +
          '(PVP.ACRESC_PLANO, 0)) / PVP.QUANT_PED_ITEM, 4),'
        
          '      --PVP.VLTOT_PED_ITEM = PVP.VLTOT_PED_ITEM + coalesce(PVP.A' +
          'CRESC_PLANO, 0)'
        '      PVP.ACRESC_ITEM = PVP.ACRESC_ITEM + PVP.ACRESC_PLANO'
        '  where PVP.NPED = :NPED and'
        '        PVP.TIPO = :TIPO and'
        '        PVP.COD_EMPRESA = :COD_EMPRESA and'
        '        coalesce(STATUS, '#39#39') = '#39#39';'
        ''
        '  -- atualizando o total dos servicos com o valor do plano'
        '  update PEDVENDA_SERV PVS'
        
          '  set -- PVS.VALOR_UN_SERV = round((PVS.VALOR_TOT_SERV + coalesc' +
          'e(PVS.ACRESC_PLANO, 0)) / PVS.QUANT_SERV_PED, 4),'
        
          '      -- PVS.VALOR_TOT_SERV = PVS.VALOR_TOT_SERV + coalesce(PVS.' +
          'ACRESC_PLANO, 0)'
        '      PVS.ACRESC_ITEM = PVS.ACRESC_ITEM + PVS.ACRESC_PLANO'
        '  where PVS.NPED = :NPED and'
        '        PVS.TIPO = :TIPO and'
        '        PVS.COD_EMPRESA = :COD_EMPRESA and'
        '        coalesce(STATUS, '#39#39') = '#39#39';'
        ''
        
          '  -- finalizando somamos o total prod e total serv para atualiza' +
          'r no cabecalho'
        '  /*'
        
          '  for select sum(C.TOTAL_PROD) TOTAL_PROD, sum(C.TOTAL_SERV) TOT' +
          'AL_SERV'
        
          '      from (select sum(coalesce(PVP.VLTOT_PED_ITEM, 0)) TOTAL_PR' +
          'OD, 0.0 TOTAL_SERV'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_PROD PVP on PVP.NPED = PV.NPED' +
          ' and'
        '                    PVP.TIPO = PV.TIPO and'
        '                    PVP.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVP.STATUS, '#39#39') = '#39#39
        '            union all'
        
          '            select 0.0 TOTAL_PROD, sum(coalesce(PVS.VALOR_TOT_SE' +
          'RV, 0)) TOTAL_SERV'
        '            from PEDVENDA PV'
        
          '              inner join PEDVENDA_SERV PVS on PVS.NPED = PV.NPED' +
          ' and'
        '                    PVS.TIPO = PV.TIPO and'
        '                    PVS.COD_EMPRESA = PV.COD_EMPRESA'
        '            where PV.NPED = :NPED and'
        '                  PV.TIPO = :TIPO and'
        '                  PV.COD_EMPRESA = :COD_EMPRESA and'
        '                  coalesce(PVS.STATUS, '#39#39') = '#39#39
        ''
        '      ) as C'
        '        into :TOTAL_PROD, :TOTAL_SERV'
        '  do    '
        '  */'
        '  begin'
        '    -- atualizando o valor total do pedido'
        '    update PEDVENDA'
        '    set --TOT_PROD = :TOTAL_PROD,'
        '        --TOT_SERV = :TOTAL_SERV,'
        '        PLANO_CALCULADO = '#39'S'#39
        '    where NPED = :NPED and'
        '          TIPO = :TIPO and'
        '          COD_EMPRESA = :COD_EMPRESA;'
        '  end'
        ''
        '  MSG = '#39'OK'#39';'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PEDVENDA ADD OBS_TPVENDA BLOB SUB_TYPE 1 SEGMENT SIZ' +
          'E 80;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_ATIVIDADES_REPARP('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    SELOS_COL,'
        '    SELOS_REM,'
        '    LACRES_COL,'
        '    LACRES_REM,'
        '    OBS_TPVENDA,'
        '    SELOS_COL1,'
        '    SELOS_COL2,'
        '    SELOS_REM1,'
        '    SELOS_REM2,'
        '    LACRES_COL1,'
        '    LACRES_COL2,'
        '    LACRES_REM1,'
        '    LACRES_REM2,'
        '    OBS_TPVENDA1,'
        '    OBS_TPVENDA2)'
        'AS'
        'select nped, tipo, cod_empresa,'
        
          'cast(substring(selos_col from 1 for 400) as varchar(400)) selos_' +
          'col,'
        
          'cast(substring(selos_rem from 1 for 400) as varchar(400)) selos_' +
          'rem,'
        
          'cast(substring(lacres_col from 1 for 400) as varchar(400)) lacre' +
          's_col,'
        
          'cast(substring(lacres_rem from 1 for 400) as varchar(400)) lacre' +
          's_rem,'
        
          'cast(substring(obs_tpvenda from 1 for 400) as varchar(200)) obs_' +
          'tpvenda,'
        
          'cast(substring(selos_col from 1 for 200) as varchar(200)) selos_' +
          'col1,'
        
          'cast(substring(selos_col from 201 for 200) as varchar(200)) selo' +
          's_col2,'
        
          'cast(substring(selos_rem from 1 for 200) as varchar(200)) selos_' +
          'rem1,'
        
          'cast(substring(selos_rem from 201 for 200) as varchar(200)) selo' +
          's_rem2,'
        
          'cast(substring(lacres_col from 1 for 200) as varchar(200)) lacre' +
          's_col1,'
        
          'cast(substring(lacres_col from 201 for 200) as varchar(200)) lac' +
          'res_col2,'
        
          'cast(substring(lacres_rem from 1 for 200) as varchar(200)) lacre' +
          's_rem1,'
        
          'cast(substring(lacres_rem from 201 for 200) as varchar(200)) lac' +
          'res_rem2,'
        
          'cast(substring(obs_tpvenda from 1 for 200) as varchar(200)) obs_' +
          'tpvenda1,'
        
          'cast(substring(obs_tpvenda from 201 for 200) as varchar(200)) ob' +
          's_tpvenda2 from pedvenda;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND261'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR IMPRIMIR REQUISICAO EM ABERTO'#39', 1, '#39'FRMCADPEDVENDA'#39', 1, '#39 +
          'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VND262'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR IMPRIMIR ORDEM SERVICO EM ABERTO'#39', 1, '#39'FRMCADPEDVENDA'#39', 1' +
          ', '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VEI172'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR IMPRIMIR CONTR COMPRA/CONS EM ABERTO'#39', 1, '#39'FRMMOVVEICULOS' +
          'CCIA'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'VEI173'#39', :COD_EMPRESA, '#39'PE' +
          'RMITIR IMPRIMIR CONTR/COMANDO FAT EM ABERTO'#39', 1, '#39'FRMMOVVEICULOS' +
          'CCIA'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
