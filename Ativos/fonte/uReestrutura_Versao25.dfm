        '|/BLOCO|'
        ''
        'ALTER TABLE PROMOCAO_PRODUTO ADD INF CHAR(1) DEFAULT '#39'N'#39';'
        ''
        'ALTER TABLE PROMOCAO ADD RECALC_PRECO CHAR(1) DEFAULT '#39'N'#39';'
        ''
        'ALTER TABLE TIPO_PRECO ADD RECALC_PRECO CHAR(1) DEFAULT '#39'N'#39';'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PROM_PROD_PPRECO FOR PROMOCAO_PRODUTO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 1'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;  '
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;  '
        '  DECLARE VARIABLE VPREC_CUSM_PROD T_VL_TODOS;  '
        'begin'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) and (coalesce(new.' +
          'MARKUP, 0) > 0)) then'
        '    new.PROPORCAO_TABELA = 0;'
        '    '
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) AND (COALESCE(new.' +
          'COD_TPPRECO, 0) > 1)) then'
        '  begin'
        '    if (COALESCE(new.COD_LOCALIDADE, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 2'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else if (COALESCE(new.COD_SETOR, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 3'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else if (COALESCE(new.COD_CIDADE, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 4'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM PROMOCAO'
        '        WHERE COD_PROMOCAO = new.COD_PROMOCAO'
        '        AND COD_TPPRECO = new.COD_TPPRECO'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into: VRECALCULAR_PRECOS;'
        '    end'
        ''
        
          '    if ((COALESCE(new.VALOR_PROMOCAO, 0) > 0) and (COALESCE(VREC' +
          'ALCULAR_PRECOS, 0) <= 0)) then'
        '      exit;'
        ''
        '    SELECT CASAS_DECIMAIS FROM EMPRESA'
        '    WHERE COD_EMPRESA = new.COD_EMPRESA'
        '      into :VCASAS_DECIMAIS;           '
        ''
        '    VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '    if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '      VCASAS_DECIMAIS = 2;'
        ''
        '    SELECT PREC_CUSM_PROD, PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_CUSM_PROD, :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(new.INF, '#39#39') = '#39'V'#39') then'
        '    begin'
        
          '      if (coalesce(VPREC_CUSM_PROD, 0) >= coalesce(VPREC_TAB_PRO' +
          'D, 0)) then'
        '        new.PROPORCAO_TABELA = 0;'
        '      else'
        '      begin'
        '        if (coalesce(VPREC_TAB_PROD, 0) > 0) then'
        
          '          new.PROPORCAO_TABELA = new.VALOR_PROMOCAO / VPREC_TAB_' +
          'PROD;'
        '        else'
        '          new.PROPORCAO_TABELA = 0;'
        '      end'
        '    end'
        '    else if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        '    begin'
        
          '      if (COALESCE(new.VALOR_PROMOCAO, 0) <> ROUND((new.PROPORCA' +
          'O_TABELA * VPREC_TAB_PROD), VCASAS_DECIMAIS)) then'
        '        if (COALESCE(VPREC_TAB_PROD, 0) <= 0.1) then'
        '          new.VALOR_PROMOCAO = 0;'
        '        else'
        
          '          new.VALOR_PROMOCAO = ROUND((new.PROPORCAO_TABELA * VPR' +
          'EC_TAB_PROD), :VCASAS_DECIMAIS);'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        
          'update promocao p set p.recalc_preco = '#39'N'#39' where p.cod_tppreco =' +
          ' 1 and p.cod_empresa = :cod_empresa and p.recalc_preco is null;'
        ''
        
          'update promocao p set p.recalc_preco = (case when coalesce((sele' +
          'ct cs.value1_f from config_sistema cs where cs.chave = '#39'prod_cad' +
          '_recalcular_preco_diferenciado'#39' and cs.cod_empresa = p.cod_empre' +
          'sa), 0) = 1 then '#39'S'#39' else '#39'N'#39' end) where p.cod_tppreco > 1 and p' +
          '.cod_empresa = :cod_empresa and p.recalc_preco is null;'
        ''
        
          'update tipo_preco t set t.recalc_preco = (case when coalesce((se' +
          'lect cs.value1_f from config_sistema cs where cs.chave = '#39'prod_c' +
          'ad_recalcular_preco_diferenciado'#39' and cs.cod_empresa = t.cod_emp' +
          'resa), 0) = 1 then '#39'S'#39' else '#39'N'#39' end) where t.cod_tppreco in (2, ' +
          '3, 4) and t.cod_empresa = :cod_empresa and t.recalc_preco is nul' +
          'l;'
        ''
        
          'update config_sistema cs set cs.ativo = 0 where cs.chave = '#39'prod' +
          '_cad_recalcular_preco_diferenciado'#39' and cs.cod_empresa = :cod_em' +
          'presa;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_PROMOCAO_ALT FOR PRODUTOS'
        'ACTIVE AFTER UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        '  DECLARE VARIABLE VCOD_TAB INTEGER;'
        '  DECLARE VARIABLE VCOD_TPPRECO INTEGER;'
        'begin'
        '  /* Trigger text */'
        '  if (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        
          '  if (COALESCE(old.PREC_TAB_PROD, 0) = COALESCE(new.PREC_TAB_PRO' +
          'D, 0)) then'
        '    exit;'
        ''
        '  SELECT CASAS_DECIMAIS FROM EMPRESA'
        '  WHERE COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCASAS_DECIMAIS;'
        ''
        '  VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '  if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '    VCASAS_DECIMAIS = 2;'
        ''
        '  -- Atualizar tabela avulsas'
        
          '  for SELECT DISTINCT COD_PROMOCAO, COD_TPPRECO FROM PROMOCAO_PR' +
          'ODUTO'
        '  WHERE GRUPO_PROD = new.GRUPO_PROD'
        '  AND COD_PROD = new.COD_PROD'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '  AND COD_TPPRECO = 5'
        '    into :VCOD_TAB, :VCOD_TPPRECO do'
        '  begin'
        '    if (COALESCE(VCOD_TAB, 0) > 0) then'
        '    begin'
        '      SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') then'
        '                    1'
        '                  else'
        '                    0'
        '             END FROM PROMOCAO'
        '      WHERE COD_PROMOCAO = :VCOD_TAB'
        '      AND COD_TPPRECO = :VCOD_TPPRECO'
        '      AND COD_EMPRESA = new.COD_EMPRESA'
        '        into :VRECALCULAR_PRECOS;'
        ''
        '      if (COALESCE(VRECALCULAR_PRECOS, 0) > 0) then'
        '      begin'
        
          '        UPDATE PROMOCAO_PRODUTO set VALOR_PROMOCAO = ROUND((PROP' +
          'ORCAO_TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '        WHERE GRUPO_PROD = new.GRUPO_PROD'
        '        AND COD_PROD = new.COD_PROD'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '        AND COD_PROMOCAO = :VCOD_TAB'
        '        AND COD_TPPRECO = :VCOD_TPPRECO'
        '        AND PROPORCAO_TABELA > 0;'
        '      end'
        '    end'
        '  end'
        ''
        '  -- Atualizar tabela localidade, setor, cidade'
        '  for SELECT COD_TPPRECO FROM TIPO_PRECO'
        '  WHERE COD_TPPRECO in (2, 3, 4)'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCOD_TPPRECO do'
        '  begin'
        '    if (COALESCE(VCOD_TAB, 0) > 0) then'
        '    begin'
        '      SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') then'
        '                    1'
        '                  else'
        '                    0'
        '             END FROM TIPO_PRECO'
        '      WHERE COD_TPPRECO = :VCOD_TPPRECO'
        '      AND COD_EMPRESA = new.COD_EMPRESA'
        '        into :VRECALCULAR_PRECOS;'
        ''
        '      if (COALESCE(VRECALCULAR_PRECOS, 0) > 0) then'
        '      begin'
        
          '        UPDATE PROMOCAO_PRODUTO set VALOR_PROMOCAO = ROUND((PROP' +
          'ORCAO_TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '        WHERE GRUPO_PROD = new.GRUPO_PROD'
        '        AND COD_PROD = new.COD_PROD'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '        AND COD_TPPRECO = :VCOD_TPPRECO'
        '        AND PROPORCAO_TABELA > 0;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PROMOCAO ADD RECALC_PRECO CHAR(1) DEFAULT '#39'N'#39';'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PROM_PROD_PPRECO FOR PROMOCAO_PRODUTO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 1'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;'
        '  DECLARE VARIABLE VPREC_CUSM_PROD T_VL_TODOS;'
        'begin'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) and (coalesce(new.' +
          'MARKUP, 0) > 0)) then'
        '    new.PROPORCAO_TABELA = 0;'
        ''
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) AND (COALESCE(new.' +
          'COD_TPPRECO, 0) > 1)) then'
        '  begin'
        '    if (COALESCE(new.COD_LOCALIDADE, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 2'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else if (COALESCE(new.COD_SETOR, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 3'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else if (COALESCE(new.COD_CIDADE, 0) > 0) then'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM TIPO_PRECO'
        '        WHERE COD_TPPRECO = 4'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into :VRECALCULAR_PRECOS;'
        '    end'
        '    else'
        '    begin'
        
          '        SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') the' +
          'n'
        '                      1'
        '                    else'
        '                      0'
        '               END FROM PROMOCAO'
        '        WHERE COD_PROMOCAO = new.COD_PROMOCAO'
        '        AND COD_TPPRECO = new.COD_TPPRECO'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '          into: VRECALCULAR_PRECOS;'
        '    end'
        ''
        
          '    if ((COALESCE(new.VALOR_PROMOCAO, 0) > 0) and (COALESCE(VREC' +
          'ALCULAR_PRECOS, 0) <= 0)) then'
        '      exit;'
        ''
        '    SELECT CASAS_DECIMAIS FROM EMPRESA'
        '    WHERE COD_EMPRESA = new.COD_EMPRESA'
        '      into :VCASAS_DECIMAIS;'
        ''
        '    VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '    if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '      VCASAS_DECIMAIS = 2;'
        ''
        '    SELECT PREC_CUSM_PROD, PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_CUSM_PROD, :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(new.INF, '#39#39') = '#39'V'#39') then'
        '    begin'
        
          '      if (coalesce(VPREC_CUSM_PROD, 0) >= coalesce(VPREC_TAB_PRO' +
          'D, 0)) then'
        '        new.PROPORCAO_TABELA = 0;'
        '      else'
        '      begin'
        '        if (coalesce(VPREC_TAB_PROD, 0) > 0) then'
        
          '          new.PROPORCAO_TABELA = new.VALOR_PROMOCAO / VPREC_TAB_' +
          'PROD;'
        '        else'
        '          new.PROPORCAO_TABELA = 0;'
        '      end'
        '    end'
        '    else if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        '    begin'
        
          '      if (COALESCE(new.VALOR_PROMOCAO, 0) <> ROUND((new.PROPORCA' +
          'O_TABELA * VPREC_TAB_PROD), VCASAS_DECIMAIS)) then'
        '        if (COALESCE(VPREC_TAB_PROD, 0) <= 0.1) then'
        '          new.VALOR_PROMOCAO = 0;'
        '        else'
        
          '          new.VALOR_PROMOCAO = ROUND((new.PROPORCAO_TABELA * VPR' +
          'EC_TAB_PROD), :VCASAS_DECIMAIS);'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PRODUTOS_PROMOCAO_ALT FOR PRODUTOS'
        'ACTIVE AFTER UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;'
        '  DECLARE VARIABLE VCOD_TAB INTEGER;'
        '  DECLARE VARIABLE VCOD_TPPRECO INTEGER;'
        'begin'
        '  /* Trigger text */'
        '  if (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '    exit;'
        ''
        
          '  if (COALESCE(old.PREC_TAB_PROD, 0) = COALESCE(new.PREC_TAB_PRO' +
          'D, 0)) then'
        '    exit;'
        ''
        '  SELECT CASAS_DECIMAIS FROM EMPRESA'
        '  WHERE COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCASAS_DECIMAIS;'
        ''
        '  VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '  if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '    VCASAS_DECIMAIS = 2;'
        ''
        '  -- Atualizar tabela avulsas'
        
          '  for SELECT DISTINCT COD_PROMOCAO, COD_TPPRECO FROM PROMOCAO_PR' +
          'ODUTO'
        '  WHERE GRUPO_PROD = new.GRUPO_PROD'
        '  AND COD_PROD = new.COD_PROD'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '  AND COD_TPPRECO = 5'
        '    into :VCOD_TAB, :VCOD_TPPRECO do'
        '  begin'
        '    if (COALESCE(VCOD_TAB, 0) > 0) then'
        '    begin'
        '      SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') then'
        '                    1'
        '                  else'
        '                    0'
        '             END FROM PROMOCAO'
        '      WHERE COD_PROMOCAO = :VCOD_TAB'
        '      AND COD_TPPRECO = :VCOD_TPPRECO'
        '      AND COD_EMPRESA = new.COD_EMPRESA'
        '        into :VRECALCULAR_PRECOS;'
        ''
        '      if (COALESCE(VRECALCULAR_PRECOS, 0) > 0) then'
        '      begin'
        
          '        UPDATE PROMOCAO_PRODUTO set VALOR_PROMOCAO = ROUND((PROP' +
          'ORCAO_TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '        WHERE GRUPO_PROD = new.GRUPO_PROD'
        '        AND COD_PROD = new.COD_PROD'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '        AND COD_PROMOCAO = :VCOD_TAB'
        '        AND COD_TPPRECO = :VCOD_TPPRECO'
        '        AND PROPORCAO_TABELA > 0;'
        '      end'
        '    end'
        '  end'
        ''
        '  -- Atualizar tabela localidade, setor, cidade'
        '  for SELECT COD_TPPRECO FROM TIPO_PRECO'
        '  WHERE COD_TPPRECO in (2, 3, 4)'
        '  AND COD_EMPRESA = new.COD_EMPRESA'
        '    into :VCOD_TPPRECO do'
        '  begin'
        '    if (COALESCE(VCOD_TAB, 0) > 0) then'
        '    begin'
        '      SELECT CASE WHEN (COALESCE(RECALC_PRECO, '#39'N'#39') = '#39'S'#39') then'
        '                    1'
        '                  else'
        '                    0'
        '             END FROM TIPO_PRECO'
        '      WHERE COD_TPPRECO = :VCOD_TPPRECO'
        '      AND COD_EMPRESA = new.COD_EMPRESA'
        '        into :VRECALCULAR_PRECOS;'
        ''
        '      if (COALESCE(VRECALCULAR_PRECOS, 0) > 0) then'
        '      begin'
        
          '        UPDATE PROMOCAO_PRODUTO set VALOR_PROMOCAO = ROUND((PROP' +
          'ORCAO_TABELA * new.PREC_TAB_PROD), :VCASAS_DECIMAIS)'
        '        WHERE GRUPO_PROD = new.GRUPO_PROD'
        '        AND COD_PROD = new.COD_PROD'
        '        AND COD_EMPRESA = new.COD_EMPRESA'
        '        AND COD_TPPRECO = :VCOD_TPPRECO'
        '        AND PROPORCAO_TABELA > 0;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW ORCAMENTO4('
        '    COD_EMPRESA,'
        '    TIPO,'
        '    PROD_SERV,'
        '    NITEM,'
        '    NPED,'
        '    COD_PROD_SER,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    COD_SERVICO,'
        '    ORIGEM_SERVICO,'
        '    NUM_FAB_PROD,'
        '    ID_KIT,'
        '    CODIGO_KIT,'
        '    DESCRICA0_KIT,'
        '    VALOR_UN_KIT,'
        '    VALOR_KIT,'
        '    VALOR_UN_KIT_LIQ,'
        '    VALOR_KIT_LIQ,'
        '    RATEIO_ACRESC_KIT,'
        '    RATEIO_DESC_KIT,'
        '    UNIDADE,'
        '    DESCRICAO,'
        '    COD_GRADE,'
        '    QUANTIDADE,'
        '    VL_UNITARIO,'
        '    VL_TOTAL_ITEM,'
        '    UNIDADE_CONV,'
        '    QUANTIDADE_CONV,'
        '    VL_UNITARIO_CONV,'
        '    OPERACAO_CONV,'
        '    FATOR_CONV,'
        '    RATEIO_DESC,'
        '    RATEIO_ACRESC,'
        '    MARCA_P,'
        '    STATUS,'
        '    NCM,'
        '    COD_TECNICO_MECAN,'
        '    NOME_TECNICO_MECAN,'
        '    COD_TECNICO_MECAN2,'
        '    NOME_TECNICO_MECAN2,'
        '    NCUPOM,'
        '    N_NF,'
        '    ICM_PROD,'
        '    ISENTO_PROD,'
        '    N_INCIDENCIA_PROD,'
        '    CST_PROD,'
        '    TIPO_FOTO,'
        '    ORDEM)'
        'AS'
        'select pvp.cod_empresa, pvp.tipo, '#39'PRODUTO'#39', pvp.nitem,'
        
          'pvp.nped, '#39'P-'#39'||p.num_fab_prod, pvp.grupo_prod, pvp.cod_prod, nu' +
          'll, null, pvp.num_fab_prod,'
        
          'pvp.id_kit, pvp.codigo_kit, case when (pvp.codigo_kit > 0) then ' +
          'k.descricao_kit else pvp.descr_prod_ped end descricao_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedv' +
          'enda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_kit,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_un_kit_li' +
          'q,'
        
          '(select sum(coalesce(pedvenda_prod.vltot_ped_item, 0) + coalesce' +
          '(pedvenda_prod.rateio_acresc, 0) - coalesce(pedvenda_prod.rateio' +
          '_desc, 0)) from pedvenda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') valor_tot_kit_l' +
          'iq,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_acresc, 0)) from pedve' +
          'nda_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_acresc_k' +
          'it,'
        
          '(select sum(coalesce(pedvenda_prod.rateio_desc, 0)) from pedvend' +
          'a_prod'
        '    where pedvenda_prod.nped = pvp.nped'
        '    and pedvenda_prod.tipo = pvp.tipo'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        '    and pedvenda_prod.codigo_kit = pvp.codigo_kit'
        '    and pedvenda_prod.id_kit = pvp.id_kit'
        '    and pedvenda_prod.cod_empresa = pvp.cod_empresa'
        
          '    and coalesce(pvp.status, '#39#39') <> '#39'CANCELADO'#39') rateio_desc_kit' +
          ','
        'pvp.unidade, pvp.descr_prod_ped, pvp.cod_grade,'
        'coalesce(pvp.quant_ped_item, 0) quant_ped_item,'
        'coalesce(pvp.vlun_ped_item, 0) vlun_ped_item,'
        'coalesce(pvp.vltot_ped_item, 0) vltot_ped_item,'
        'pvp.unidade_conv,'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.quant_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) * coalesce(pvp.fator_con' +
          'v, 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.quant_ped_item, 0) / coalesce(pvp.fator_con' +
          'v, 0))'
        '     else'
        '       coalesce(pvp.quant_ped_item, 0)'
        'end quant_ped_item_conv,'
        'case when (trim(coalesce(pvp.unidade_conv, '#39#39')) = '#39#39') then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when (trim(coalesce(pvp.unidade, '#39#39')) = trim(coalesce(pvp.u' +
          'nidade_conv, '#39#39'))) then'
        '       coalesce(pvp.vlun_ped_item, 0)'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'M'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) / coalesce(pvp.fator_conv' +
          ', 0))'
        
          '     when ((coalesce(pvp.operacao_conv, '#39#39') = '#39'D'#39') and (coalesce' +
          '(pvp.fator_conv, 0) > 0)) then'
        
          '       (coalesce(pvp.vlun_ped_item, 0) * coalesce(pvp.fator_conv' +
          ', 0))'
        '     else'
        '       coalesce(pvp.vlun_ped_item, 0)'
        'end vlun_ped_item_conv,'
        'pvp.operacao_conv,'
        'pvp.fator_conv,'
        'coalesce(pvp.rateio_desc,0) as rateio_desc,'
        'coalesce(pvp.rateio_acresc,0) as rateio_acresc,'
        'p.marca_p, pvp.status,'
        
          'p.nbm, pvp.cod_vendedor, col.nome_vendedor, pvp.col_cod_vendedor' +
          ', col2.nome_vendedor,'
        
          'pv.ncupom, pvp.n_nf, p.icm_prod, p.isento_prod, p.n_incidencia_p' +
          'rod, p.cst_prod,'
        
          'case when (trim(pvp.tipo) = '#39'REQ'#39') then -1000 when (trim(pvp.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '1 ordem'
        'from pedvenda_prod pvp'
        
          'inner join pedvenda pv on pv.nped = pvp.nped and pv.tipo = pvp.t' +
          'ipo and pv.cod_empresa = pvp.cod_empresa'
        
          'inner join produtos p on pvp.grupo_prod = p.grupo_prod and pvp.c' +
          'od_prod = p.cod_prod and pvp.cod_empresa = p.cod_empresa'
        
          'left join kits_prod k on k.codigo_kit = pvp.codigo_kit and k.cod' +
          '_empresa = pvp.cod_empresa'
        
          'left join colaborador col on col.cod_vendedor = pvp.cod_vendedor' +
          ' and col.cod_empresa = pvp.cod_empresa'
        
          'left join colaborador col2 on col2.cod_vendedor = pvp.col_cod_ve' +
          'ndedor and col2.cod_empresa = pvp.cod_empresa'
        'where pvp.ativo=1'
        'union'
        'select pvs.cod_empresa,pvs.tipo, '#39'SERVICO'#39',pvs.nitem,'
        
          'pvs.nped, '#39'S-'#39'||(select result from strzero(pvs.cod_servico, 5))' +
          ', null, null, pvs.cod_servico, coalesce(tp.stipo, '#39#39'), null,'
        
          'null, null, pvs.desc_serv_ped, null, null, null, null, null, nul' +
          'l,'
        'null, pvs.desc_serv_ped, null, pvs.quant_serv_ped,'
        'coalesce(pvs.valor_un_serv, 0) valor_un_serv,'
        'coalesce(pvs.valor_tot_serv, 0) valor_tot_serv,'
        'null, pvs.quant_serv_ped as quant_serv_ped_conv,'
        'coalesce(pvs.valor_un_serv, 0) as valor_un_serv_conv,'
        'null, null,'
        'coalesce(pvs.rateio_desc,0) as rateio_desc,'
        'coalesce(pvs.rateio_acresc,0) as rateio_acresc,'
        'null, pvs.status,'
        
          'null, pvs.cod_vendedor, col.nome_vendedor, pvs.cod_vendedor1, co' +
          'l2.nome_vendedor,'
        'null, null, null, null, null, null,'
        
          'case when (trim(pvs.tipo) = '#39'REQ'#39') then -1000 when (trim(pvs.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '2 ordem'
        'from pedvenda_serv pvs'
        
          'inner join pedvenda pv on pv.nped = pvs.nped and pv.tipo = pvs.t' +
          'ipo and pv.cod_empresa = pvs.cod_empresa'
        'left join tipo_servico tp on tp.cod_servico = pvs.cod_servico'
        
          'left join colaborador col on pvs.cod_vendedor = col.cod_vendedor' +
          ' and pvs.cod_empresa = col.cod_empresa'
        
          'left join colaborador col2 on pvs.cod_vendedor1 = col2.cod_vende' +
          'dor and pvs.cod_empresa = col2.cod_empresa'
        'where pvs.ativo=1'
        'union'
        'select vpt.cod_empresa, vpt.tipo, '#39'PRODUTOT'#39', vpt.seqid,'
        'vpt.nped, '#39'PROD-T'#39', null, null, null, null, null,'
        'null, null, vpt.descricao, null, null, null, null, null, null,'
        'vpt.unidade, vpt.descricao, null, vpt.qtde,'
        'vpt.vl_unit, vpt.vl_total,'
        
          'null, vpt.qtde as qtde_conv, vpt.vl_unit as vl_unit_conv, null, ' +
          'null,'
        '0, 0, null, null, null, null, null, null, null,'
        'null, null,  null, null, null, null,'
        
          'case when (trim(vpt.tipo) = '#39'REQ'#39') then -1000 when (trim(vpt.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '3 ordem  from pedvenda pv'
        
          'inner join pedvenda_prod_terc vpt on pv.nped=vpt.nped and pv.cod' +
          '_empresa=vpt.cod_empresa and pv.tipo=vpt.tipo'
        'where vpt.ativo=1'
        'union'
        'select vst.cod_empresa, vst.tipo, '#39'SERVICOT'#39', vst.seqid,'
        'vst.nped, '#39'SERV-T'#39', null, null, null, null, null,'
        'null, null, vst.descr_servt, null, null, null, null, null, null,'
        'null, vst.descr_servt, null, 1,'
        'vst.vl_servt, vst.vl_servt,'
        'null, 1, vst.vl_servt, null, null,'
        '0, 0, null, null, null, null, null, null, null,'
        'null, null, null, null, null, null,'
        
          'case when (trim(vst.tipo) = '#39'REQ'#39') then -1000 when (trim(vst.tip' +
          'o) = '#39'OS'#39') then -1001 else -1002 end tipo,'
        '4 ordem  from pedvenda pv'
        
          'inner join pedvenda_serv_terc vst on pv.nped = vst.nped and pv.c' +
          'od_empresa = vst.cod_empresa and pv.tipo = vst.tipo'
        'where vst.ativo=1;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'CTP042'#39', :COD_EMPRESA, '#39'PE' +
          'RM CAD/ALT CONTAS A PAGAR APOS DRE GERADO'#39', 1, '#39'FRMCADCONTASAPAG' +
          'AR'#39', 1, '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'LANC049'#39', :COD_EMPRESA, '#39'P' +
          'ERM CAD/ALT LANCAMENTO APOS DRE GERADO'#39', 1, '#39'FRMLANCAMENTOS'#39', 1,' +
          ' '#39'S'#39', '#39'S'#39', CURRENT_DATE);'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'BAS513'#39', :COD_EMPRESA, '#39'ALTERAR RETENCAO FEDERAL OPER' +
          'ACAO FISCAL'#39', 5, '#39'N'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'CREATE TABLE OPF_RETTRIB ('
        '    ID           INTEGER NOT NULL,'
        '    OPF_ID       INTEGER NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        
          '    PIR          T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        
          '    PCSLL        T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        
          '    PPIS         T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        
          '    PCOFINS      T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        '    ATIVO        SMALLINT DEFAULT 1'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE OPF_RETTRIB ADD CONSTRAINT PK_OPF_RETTRIB PRIMARY KE' +
          'Y (ID, COD_EMPRESA);'
        
          'ALTER TABLE OPF_RETTRIB ADD CONSTRAINT FK_OPF_RETTRIB FOREIGN KE' +
          'Y (OPF_ID, COD_EMPRESA) REFERENCES OPF (ID, COD_EMPRESA) ON DELE' +
          'TE CASCADE ON UPDATE CASCADE;'
        'ALTER TABLE CLIENTES ADD RET_FED SMALLINT;'
        'ALTER TABLE NOTAFISCAL ADD RET_FED SMALLINT;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD TIPO_CALC_RETFED SMALLINT;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VBCRETFED T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRETIR T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRETCSLL T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRETPIS T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRETCOFINS T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VRETIR T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VRETCSLL T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VRETPIS T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD VRETCOFINS T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD OPF_RET_ID INTEGER;'
        
          'ALTER TABLE NOTAFISCAL_ITEM ADD CONSTRAINT FK_NOTAFISCAL_ITEM_OP' +
          'F_RET FOREIGN KEY (OPF_RET_ID, COD_EMPRESA) REFERENCES OPF (ID, ' +
          'COD_EMPRESA) ON UPDATE CASCADE;'
        ''
        '|BLOCO|'
        'create or alter procedure SP_GET_OPFISCAL ('
        '    COD_EMPRESA integer,'
        '    NCM varchar(8),'
        '    CIDADE_IBGE integer,'
        '    CONSUMIDOR_FINAL char(1),'
        '    INDIEDEST char(1),'
        '    FINALIDADE_ID integer,'
        '    PESSOA char(2),'
        '    TIPO_ITEM char(2),'
        '    TIPO_NF smallint,'
        '    UF char(2),'
        '    CST_ICMS char(2),'
        '    CST_PISCOFINS char(2))'
        'returns ('
        '    ICMS_ID integer,'
        '    CONF_ICM blob sub_type 1 segment size 80,'
        '    TRIBUTACAO smallint,'
        '    MOTDESICM smallint,'
        '    CFOP smallint,'
        '    ALIQ_ICMS T_VL_TODOS,'
        '    ALIQ_INTRA T_VL_TODOS,'
        '    ALIQ_FCP T_VL_TODOS,'
        '    ALIQ_RED_BC T_VL_TODOS,'
        '    ALIQ_ICMS_DIF T_VL_TODOS,'
        '    ALIQ_FCP_DIF T_VL_TODOS,'
        '    PISCOFINS_ID integer,'
        '    CONF_PC blob sub_type 1 segment size 80,'
        '    CST_PC char(2),'
        '    NAT_REC char(3),'
        '    MOTDESPC smallint,'
        '    ALIQ_PIS T_VL_TODOS,'
        '    ALIQ_COFINS T_VL_TODOS,'
        '    ALIQ_CREDSN T_VL_TODOS,'
        '    RET_ID integer,'
        '    ALIQ_RET_IR T_VL_TODOS,'
        '    ALIQ_RET_CSLL T_VL_TODOS,'
        '    ALIQ_RET_PIS T_VL_TODOS,'
        '    ALIQ_RET_COFINS T_VL_TODOS,'
        '    EMPRESA_ID integer)'
        'as'
        'begin'
        ''
        '  EMPRESA_ID = COD_EMPRESA;'
        ''
        '  -- ICMS'
        
          '  for select first 1 iif(ICP.ID is not null, OP.ID, null) ICMS_I' +
          'D, ICM.CONF_CALC CONF_ICM, ICM.TRIBUTACAO,'
        
          '                     ICM.MOTDESICM, ICD.CFOP, ICP.ALIQ_ICMS, DES' +
          'T_ES.ALIQ_INTRA, ICP.ALIQ_FCP, ICP.ALIQ_RED_BC,'
        
          '                     ICP.ALIQ_ICMS_DIF, ICP.ALIQ_FCP_DIF, E.ALIQ' +
          '_SIMPLES_ICM ALIQ_CREDSN, OP.COD_EMPRESA'
        
          '      from (select distinct O.ID, O.COD_EMPRESA, iif(FIN.FINALID' +
          'ADE_ID is null, 0, 1) FINALIDADE_ORDER,'
        
          '                            (iif(CID.CIDADE_ID is null, 0, 1) + ' +
          'iif(CF.CONSUMIDOR_FINAL is null, 0, 1) +'
        
          '                            iif(IE.INDIEDEST is null, 0, 1) + ii' +
          'f(PS.PESSOA is null, 0, 1) +'
        
          '                            iif(TI.TIPO_ITEM is null, 0, 1) + ii' +
          'f(TNF.TIPO is null, 0, 1) + iif(UF.UFS is null, 0, 1) +'
        
          '                            iif(ICM.CST is null, 0, 1) + iif(PCE' +
          '.CST is null, 0, 1) + iif(PCS.CST is null, 0, 1)) DEMAIS_ORDER'
        '            from OPF_COND_NCM NCM'
        '              inner join OPF O on O.ID = NCM.OPF_ID and'
        '                    O.COD_EMPRESA = NCM.COD_EMPRESA and'
        '                    O.ATIVO = 1'
        
          '              left join OPF_COND_CIDADE CID on CID.OPF_ID = O.ID' +
          ' and'
        '                    CID.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONS_FINAL CF on CF.OPF_ID = O.' +
          'ID and'
        '                    CF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONTRIB IE on IE.OPF_ID = O.ID ' +
          'and'
        '                    IE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_FINALIDADE FIN on FIN.OPF_ID = ' +
          'O.ID and'
        '                    FIN.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_PESSOA PS on PS.OPF_ID = O.ID a' +
          'nd'
        '                    PS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_ITEM TI on TI.OPF_ID = O.I' +
          'D and'
        '                    TI.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_NF TNF on TNF.OPF_ID = O.I' +
          'D and'
        '                    TNF.COD_EMPRESA = O.COD_EMPRESA'
        '              left join OPF_COND_UF UF on UF.OPF_ID = O.ID and'
        '                    UF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_ICMS ICM on ICM.OPF_ID = O.' +
          'ID and'
        '                    ICM.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_ENT PCE on PCE.OPF_ID = ' +
          'O.ID and'
        '                    PCE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_SAI PCS on PCS.OPF_ID = ' +
          'O.ID and'
        '                    PCS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              inner join EMPRESA E on E.COD_EMPRESA = O.COD_EMPR' +
          'ESA'
        '              inner join ESTADOS ES on ES.CODIGO_UF = E.UF_EMP'
        
          '              left join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :U' +
          'F'
        '              inner join OPF_ICMS OICM on OICM.OPF_ID = O.ID and'
        '                    OICM.COD_EMPRESA = O.COD_EMPRESA and'
        '                    OICM.ATIVO = 1'
        
          '              inner join OPF_ICMS_DEST ICD on ICD.OPF_ICMS_ID = ' +
          'OICM.ID and'
        '                    ICD.COD_EMPRESA = OICM.COD_EMPRESA and'
        
          '                    ICD.IDDEST = iif(:UF = '#39'EX'#39', 3, iif(ES.SIGLA' +
          '_UF = :UF, 1, 2)) and'
        '                    ICD.ATIVO = 1'
        
          '              inner join OPF_ICMS_DEST_PARAMS ICP on ICP.OPF_ICM' +
          'S_DEST_ID = ICD.ID and'
        '                    ICP.COD_EMPRESA = ICD.COD_EMPRESA and'
        '                    ICP.UFS like '#39'%'#39' || :UF || '#39'%'#39
        '            where NCM.COD_EMPRESA = :COD_EMPRESA and'
        '                  :NCM >= NCM.NCM_INI and'
        '                  :NCM <= NCM.NCM_FIM and'
        
          '                  coalesce(CID.CIDADE_ID, :CIDADE_IBGE) = :CIDAD' +
          'E_IBGE and'
        
          '                  coalesce(CF.CONSUMIDOR_FINAL, :CONSUMIDOR_FINA' +
          'L) = :CONSUMIDOR_FINAL and'
        
          '                  coalesce(IE.INDIEDEST, :INDIEDEST) = :INDIEDES' +
          'T and'
        
          '                  coalesce(FIN.FINALIDADE_ID, :FINALIDADE_ID) = ' +
          ':FINALIDADE_ID and'
        '                  coalesce(PS.PESSOA, :PESSOA) = :PESSOA and'
        
          '                  coalesce(TI.TIPO_ITEM, :TIPO_ITEM) = :TIPO_ITE' +
          'M and'
        '                  coalesce(TNF.TIPO, :TIPO_NF) = :TIPO_NF and'
        
          '                  coalesce(UF.UFS, :UF) like '#39'%'#39' || :UF || '#39'%'#39' a' +
          'nd'
        '                  coalesce(ICM.CST, :CST_ICMS) = :CST_ICMS and'
        
          '                  coalesce(PCE.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS and'
        
          '                  coalesce(PCS.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS'
        
          '            order by FINALIDADE_ORDER desc, DEMAIS_ORDER desc) a' +
          's OP'
        '        inner join EMPRESA E on E.COD_EMPRESA = OP.COD_EMPRESA'
        '        inner join ESTADOS ES on ES.CODIGO_UF = E.UF_EMP'
        '        left join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :UF'
        '        inner join OPF_ICMS ICM on ICM.OPF_ID = OP.ID and'
        '              ICM.COD_EMPRESA = OP.COD_EMPRESA and'
        '              ICM.ATIVO = 1'
        
          '        inner join OPF_ICMS_DEST ICD on ICD.OPF_ICMS_ID = ICM.ID' +
          ' and'
        '              ICD.COD_EMPRESA = OP.COD_EMPRESA and'
        
          '              ICD.IDDEST = iif(:UF = '#39'EX'#39', 3, iif(ES.SIGLA_UF = ' +
          ':UF, 1, 2)) and'
        '              ICD.ATIVO = 1'
        
          '        inner join OPF_ICMS_DEST_PARAMS ICP on ICP.OPF_ICMS_DEST' +
          '_ID = ICD.ID and'
        '              ICP.COD_EMPRESA = ICD.COD_EMPRESA and'
        '              ICP.UFS like '#39'%'#39' || :UF || '#39'%'#39
        
          '        into :ICMS_ID, :CONF_ICM, :TRIBUTACAO, :MOTDESICM, :CFOP' +
          ', :ALIQ_ICMS, :ALIQ_INTRA, :ALIQ_FCP, :ALIQ_RED_BC,'
        
          '             :ALIQ_ICMS_DIF, :ALIQ_FCP_DIF, :ALIQ_CREDSN, :EMPRE' +
          'SA_ID'
        '  do'
        '  begin'
        '    --'
        '  end'
        ''
        '  -- PISCOFINS'
        
          '  for select first 1 iif(PC.CST is not null, OP.ID, null) PISCOF' +
          'INS_ID, PC.CONF_CALC CONF_PC, PC.CST, PC.NAT_REC,'
        '                     PC.MOTDESPC, PC.ALIQ_PIS, PC.ALIQ_COFINS'
        
          '      from (select distinct O.ID, O.COD_EMPRESA, iif(FIN.FINALID' +
          'ADE_ID is null, 0, 1) FINALIDADE_ORDER,'
        
          '                            (iif(CID.CIDADE_ID is null, 0, 1) + ' +
          'iif(CF.CONSUMIDOR_FINAL is null, 0, 1) +'
        
          '                            iif(IE.INDIEDEST is null, 0, 1) + ii' +
          'f(PS.PESSOA is null, 0, 1) + iif(TI.TIPO_ITEM is null, 0, 1) +'
        
          '                            iif(TNF.TIPO is null, 0, 1) + iif(UF' +
          '.UFS is null, 0, 1) + iif(ICM.CST is null, 0, 1) +'
        
          '                            iif(PCE.CST is null, 0, 1) + iif(PCS' +
          '.CST is null, 0, 1)) DEMAIS_ORDER'
        '            from OPF_COND_NCM NCM'
        '              inner join OPF O on O.ID = NCM.OPF_ID and'
        '                    O.COD_EMPRESA = NCM.COD_EMPRESA and'
        '                    O.ATIVO = 1'
        
          '              left join OPF_COND_CIDADE CID on CID.OPF_ID = O.ID' +
          ' and'
        '                    CID.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONS_FINAL CF on CF.OPF_ID = O.' +
          'ID and'
        '                    CF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONTRIB IE on IE.OPF_ID = O.ID ' +
          'and'
        '                    IE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_FINALIDADE FIN on FIN.OPF_ID = ' +
          'O.ID and'
        '                    FIN.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_PESSOA PS on PS.OPF_ID = O.ID a' +
          'nd'
        '                    PS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_ITEM TI on TI.OPF_ID = O.I' +
          'D and'
        '                    TI.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_NF TNF on TNF.OPF_ID = O.I' +
          'D and'
        '                    TNF.COD_EMPRESA = O.COD_EMPRESA'
        '              left join OPF_COND_UF UF on UF.OPF_ID = O.ID and'
        '                    UF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_ICMS ICM on ICM.OPF_ID = O.' +
          'ID and'
        '                    ICM.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_ENT PCE on PCE.OPF_ID = ' +
          'O.ID and'
        '                    PCE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_SAI PCS on PCS.OPF_ID = ' +
          'O.ID and'
        '                    PCS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              inner join EMPRESA E on E.COD_EMPRESA = O.COD_EMPR' +
          'ESA'
        
          '              inner join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :' +
          'UF'
        '              inner join OPF_PC PC on PC.OPF_ID = O.ID and'
        '                    PC.COD_EMPRESA = O.COD_EMPRESA and'
        '                    PC.ATIVO = 1'
        '            where NCM.COD_EMPRESA = :COD_EMPRESA and'
        '                  :NCM >= NCM.NCM_INI and'
        '                  :NCM <= NCM.NCM_FIM and'
        
          '                  coalesce(CID.CIDADE_ID, :CIDADE_IBGE) = :CIDAD' +
          'E_IBGE and'
        
          '                  coalesce(CF.CONSUMIDOR_FINAL, :CONSUMIDOR_FINA' +
          'L) = :CONSUMIDOR_FINAL and'
        
          '                  coalesce(IE.INDIEDEST, :INDIEDEST) = :INDIEDES' +
          'T and'
        
          '                  coalesce(FIN.FINALIDADE_ID, :FINALIDADE_ID) = ' +
          ':FINALIDADE_ID and'
        '                  coalesce(PS.PESSOA, :PESSOA) = :PESSOA and'
        
          '                  coalesce(TI.TIPO_ITEM, :TIPO_ITEM) = :TIPO_ITE' +
          'M and'
        '                  coalesce(TNF.TIPO, :TIPO_NF) = :TIPO_NF and'
        
          '                  coalesce(UF.UFS, :UF) like '#39'%'#39' || :UF || '#39'%'#39' a' +
          'nd'
        '                  coalesce(ICM.CST, :CST_ICMS) = :CST_ICMS and'
        
          '                  coalesce(PCE.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS and'
        
          '                  coalesce(PCS.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS'
        
          '            order by FINALIDADE_ORDER desc, DEMAIS_ORDER desc) a' +
          's OP'
        '        inner join EMPRESA E on E.COD_EMPRESA = OP.COD_EMPRESA'
        '        inner join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :UF'
        '        inner join OPF_PC PC on PC.OPF_ID = OP.ID and'
        '              PC.COD_EMPRESA = OP.COD_EMPRESA and'
        '              PC.ATIVO = 1'
        
          '        into :PISCOFINS_ID, :CONF_PC, :CST_PC, :NAT_REC, :MOTDES' +
          'PC, :ALIQ_PIS, :ALIQ_COFINS'
        '  do'
        '  begin'
        '    --'
        '  end'
        '  '
        '  -- RETENCOES'
        
          '  for select first 1 iif(RT.OPF_ID is not null, RT.ID, null) RET' +
          '_ID, RT.PIR, RT.PCSLL, RT.PPIS, RT.PCOFINS'
        
          '      from (select distinct O.ID, O.COD_EMPRESA, iif(FIN.FINALID' +
          'ADE_ID is null, 0, 1) FINALIDADE_ORDER,'
        
          '                            (iif(CID.CIDADE_ID is null, 0, 1) + ' +
          'iif(CF.CONSUMIDOR_FINAL is null, 0, 1) +'
        
          '                            iif(IE.INDIEDEST is null, 0, 1) + ii' +
          'f(PS.PESSOA is null, 0, 1) + iif(TI.TIPO_ITEM is null, 0, 1) +'
        
          '                            iif(TNF.TIPO is null, 0, 1) + iif(UF' +
          '.UFS is null, 0, 1) + iif(ICM.CST is null, 0, 1) +'
        
          '                            iif(PCE.CST is null, 0, 1) + iif(PCS' +
          '.CST is null, 0, 1)) DEMAIS_ORDER'
        '            from OPF_COND_NCM NCM'
        '              inner join OPF O on O.ID = NCM.OPF_ID and'
        '                    O.COD_EMPRESA = NCM.COD_EMPRESA and'
        '                    O.ATIVO = 1'
        
          '              left join OPF_COND_CIDADE CID on CID.OPF_ID = O.ID' +
          ' and'
        '                    CID.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONS_FINAL CF on CF.OPF_ID = O.' +
          'ID and'
        '                    CF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CONTRIB IE on IE.OPF_ID = O.ID ' +
          'and'
        '                    IE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_FINALIDADE FIN on FIN.OPF_ID = ' +
          'O.ID and'
        '                    FIN.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_PESSOA PS on PS.OPF_ID = O.ID a' +
          'nd'
        '                    PS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_ITEM TI on TI.OPF_ID = O.I' +
          'D and'
        '                    TI.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_TIPO_NF TNF on TNF.OPF_ID = O.I' +
          'D and'
        '                    TNF.COD_EMPRESA = O.COD_EMPRESA'
        '              left join OPF_COND_UF UF on UF.OPF_ID = O.ID and'
        '                    UF.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_ICMS ICM on ICM.OPF_ID = O.' +
          'ID and'
        '                    ICM.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_ENT PCE on PCE.OPF_ID = ' +
          'O.ID and'
        '                    PCE.COD_EMPRESA = O.COD_EMPRESA'
        
          '              left join OPF_COND_CST_PC_SAI PCS on PCS.OPF_ID = ' +
          'O.ID and'
        '                    PCS.COD_EMPRESA = O.COD_EMPRESA'
        
          '              inner join EMPRESA E on E.COD_EMPRESA = O.COD_EMPR' +
          'ESA'
        
          '              inner join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :' +
          'UF'
        '              inner join OPF_RETTRIB RT on RT.OPF_ID = O.ID and'
        '                    RT.COD_EMPRESA = O.COD_EMPRESA and'
        '                    RT.ATIVO = 1'
        '            where NCM.COD_EMPRESA = :COD_EMPRESA and'
        '                  :NCM >= NCM.NCM_INI and'
        '                  :NCM <= NCM.NCM_FIM and'
        
          '                  coalesce(CID.CIDADE_ID, :CIDADE_IBGE) = :CIDAD' +
          'E_IBGE and'
        
          '                  coalesce(CF.CONSUMIDOR_FINAL, :CONSUMIDOR_FINA' +
          'L) = :CONSUMIDOR_FINAL and'
        
          '                  coalesce(IE.INDIEDEST, :INDIEDEST) = :INDIEDES' +
          'T and'
        
          '                  coalesce(FIN.FINALIDADE_ID, :FINALIDADE_ID) = ' +
          ':FINALIDADE_ID and'
        '                  coalesce(PS.PESSOA, :PESSOA) = :PESSOA and'
        
          '                  coalesce(TI.TIPO_ITEM, :TIPO_ITEM) = :TIPO_ITE' +
          'M and'
        '                  coalesce(TNF.TIPO, :TIPO_NF) = :TIPO_NF and'
        
          '                  coalesce(UF.UFS, :UF) like '#39'%'#39' || :UF || '#39'%'#39' a' +
          'nd'
        '                  coalesce(ICM.CST, :CST_ICMS) = :CST_ICMS and'
        
          '                  coalesce(PCE.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS and'
        
          '                  coalesce(PCS.CST, :CST_PISCOFINS) = :CST_PISCO' +
          'FINS'
        
          '            order by FINALIDADE_ORDER desc, DEMAIS_ORDER desc) a' +
          's OP'
        '        inner join EMPRESA E on E.COD_EMPRESA = OP.COD_EMPRESA'
        '        inner join ESTADOS DEST_ES on DEST_ES.SIGLA_UF = :UF'
        '        inner join OPF_RETTRIB RT on RT.OPF_ID = OP.ID and'
        '              RT.COD_EMPRESA = OP.COD_EMPRESA and'
        '              RT.ATIVO = 1'
        
          '        into :RET_ID, :ALIQ_RET_IR, :ALIQ_RET_CSLL, :ALIQ_RET_PI' +
          'S, :ALIQ_RET_COFINS'
        '  do'
        '  begin'
        '    --'
        '  end'
        ''
        '  suspend;'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_GET_OPFISCAL_LOTE ('
        '    ID_TMP varchar(60),'
        '    COD_EMPRESA integer,'
        '    CIDADE_IBGE integer,'
        '    CONSUMIDOR_FINAL char(1),'
        '    INDIEDEST char(1),'
        '    FINALIDADE_ID integer,'
        '    PESSOA char(2),'
        '    TIPO_NF smallint,'
        '    UF char(2))'
        'returns ('
        '    NCM varchar(8),'
        '    TIPO_ITEM char(2),'
        '    CST_ICMS char(2),'
        '    CST_PISCOFINS char(2),'
        '    ICMS_ID integer,'
        '    CONF_ICM blob sub_type 1 segment size 80,'
        '    TRIBUTACAO smallint,'
        '    MOTDESICM smallint,'
        '    CFOP smallint,'
        '    ALIQ_ICMS T_VL_TODOS,'
        '    ALIQ_INTRA T_VL_TODOS,'
        '    ALIQ_FCP T_VL_TODOS,'
        '    ALIQ_RED_BC T_VL_TODOS,'
        '    ALIQ_ICMS_DIF T_VL_TODOS,'
        '    ALIQ_FCP_DIF T_VL_TODOS,'
        '    PISCOFINS_ID integer,'
        '    CONF_PC blob sub_type 1 segment size 80,'
        '    CST_PC char(2),'
        '    NAT_REC char(3),'
        '    MOTDESPC smallint,'
        '    ALIQ_PIS T_VL_TODOS,'
        '    ALIQ_COFINS T_VL_TODOS,'
        '    ALIQ_CREDSN T_VL_TODOS,'
        '    RET_ID integer,'
        '    ALIQ_RET_IR T_VL_TODOS,'
        '    ALIQ_RET_CSLL T_VL_TODOS,'
        '    ALIQ_RET_PIS T_VL_TODOS,'
        '    ALIQ_RET_COFINS T_VL_TODOS,'
        '    EMPRESA_ID integer)'
        'as'
        'begin'
        
          '  for select distinct P.NBM, coalesce(P.TIPO_ITEM, '#39#39'), substrin' +
          'g(P.CST_PROD from 2 for 2), coalesce(P.CST_PIS, '#39#39')'
        '      from PRODUTOS_TMP T'
        '        inner join PRODUTOS P on P.GRUPO_PROD = T.GRUPO_PROD and'
        '              P.COD_PROD = T.COD_PROD and'
        '              P.COD_EMPRESA = T.COD_EMPRESA'
        '      where T.ID_TMP = :ID_TMP and'
        '            T.COD_EMPRESA = :COD_EMPRESA'
        '        into :NCM, :TIPO_ITEM, :CST_ICMS, :CST_PISCOFINS'
        '  do'
        '  begin'
        ''
        
          '    for select ICMS_ID, CONF_ICM, TRIBUTACAO, MOTDESICM, CFOP, A' +
          'LIQ_ICMS, ALIQ_INTRA, ALIQ_FCP, ALIQ_RED_BC,'
        
          '               ALIQ_ICMS_DIF, ALIQ_FCP_DIF, PISCOFINS_ID, CONF_P' +
          'C, CST_PC, NAT_REC, MOTDESPC, ALIQ_PIS, ALIQ_COFINS,'
        
          '               ALIQ_CREDSN, RET_ID, ALIQ_RET_IR, ALIQ_RET_CSLL, ' +
          'ALIQ_RET_PIS, ALIQ_RET_COFINS'
        
          '        from SP_GET_OPFISCAL(:COD_EMPRESA, :NCM, :CIDADE_IBGE, :' +
          'CONSUMIDOR_FINAL, :INDIEDEST, :FINALIDADE_ID, :PESSOA, :TIPO_ITE' +
          'M, :TIPO_NF, :UF, :CST_ICMS, :CST_PISCOFINS)'
        
          '          into :ICMS_ID, :CONF_ICM, :TRIBUTACAO, :MOTDESICM, :CF' +
          'OP, :ALIQ_ICMS, :ALIQ_INTRA, :ALIQ_FCP, :ALIQ_RED_BC,'
        
          '               :ALIQ_ICMS_DIF, :ALIQ_FCP_DIF, :PISCOFINS_ID, :CO' +
          'NF_PC, :CST_PC, :NAT_REC, :MOTDESPC, :ALIQ_PIS,'
        
          '               :ALIQ_COFINS, :ALIQ_CREDSN, :RET_ID, :ALIQ_RET_IR' +
          ', :ALIQ_RET_CSLL, :ALIQ_RET_PIS, :ALIQ_RET_COFINS'
        '    do'
        '    begin'
        ''
        '      EMPRESA_ID = COD_EMPRESA;'
        ''
        
          '      if ((coalesce(ICMS_ID, 0) > 0) or (coalesce(PISCOFINS_ID, ' +
          '0) > 0) or (coalesce(RET_ID, 0) > 0)) then'
        '        suspend;'
        '    end'
        ''
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_OPF_ICM_TABTRIBUTACAO ('
        '    IDPESQUISA integer = null)'
        'returns ('
        '    CODIGO integer,'
        '    DESCRICAO varchar(64))'
        'as'
        'begin'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 0)) then'
        '  begin'
        '    codigo = 0;'
        
          '    descricao = '#39'Tributada pelo ICMS Normal ou com Diferimento (' +
          '00, 20, 51)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 1)) then'
        '  begin'
        '    codigo = 1;'
        '    descricao = '#39'Tributada pelo ICMS ST (10, 70)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 2)) then'
        '  begin'
        '    codigo = 2;'
        
          '    descricao = '#39'Isenta / Nao tributada com cobranca do ICMS ST ' +
          '(30)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 3)) then'
        '  begin'
        '    codigo = 3;'
        '    descricao = '#39'Isenta (40)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 4)) then'
        '  begin'
        '    codigo = 4;'
        '    descricao = '#39'Nao tributada (41)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 5)) then'
        '  begin'
        '    codigo = 5;'
        '    descricao = '#39'Com suspensao (50)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 6)) then'
        '  begin'
        '    codigo = 6;'
        
          '    descricao = '#39'ICMS cobrando anteriormente por substituicao tr' +
          'ibutaria (60)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 7)) then'
        '  begin'
        '    codigo = 7;'
        '    descricao = '#39'Outras - Com ICMS OP e com ICMS ST (90)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 8)) then'
        '  begin'
        '    codigo = 8;'
        '    descricao = '#39'Outras - Com ICMS OP e sem ICMS ST (90)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 9)) then'
        '  begin'
        '    codigo = 9;'
        '    descricao = '#39'Outras - Sem ICMS OP e com ICMS ST (90)'#39';'
        '    suspend;'
        '  end'
        ''
        '  if ((idpesquisa is null) or (idpesquisa = 10)) then'
        '  begin'
        '    codigo = 10;'
        '    descricao = '#39'Outras - Sem ICMS OP e sem ICMS ST (90)'#39';'
        '    suspend;'
        '  end'
        ''
        'end'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE FORMPAGAMENTO ADD VALORDOC_LIQ DOUBLE PRECISION DEFA' +
          'ULT 0.00;'
        'ALTER TABLE CLIENTES ADD COD_CLI_FAT INTEGER;'
        
          'ALTER TABLE CLIENTES ADD CONSTRAINT FK_CLIENTES_CLI_FAT FOREIGN ' +
          'KEY (COD_CLI_FAT, COD_EMPRESA) REFERENCES CLIENTES(COD_CLIENTE, ' +
          'COD_EMPRESA) ON UPDATE CASCADE;'
        'ALTER TABLE PEDVENDA ADD COD_CLI_FAT INTEGER;'
        
          'ALTER TABLE PEDVENDA ADD CONSTRAINT FK_PEDVENDA_CLI_FAT FOREIGN ' +
          'KEY (COD_CLI_FAT, COD_EMPRESA) REFERENCES CLIENTES(COD_CLIENTE, ' +
          'COD_EMPRESA) ON UPDATE CASCADE;'
        'ALTER TABLE NOTAFISCAL ADD COD_CLI_PED INTEGER;'
        
          'ALTER TABLE NOTAFISCAL ADD CONSTRAINT FK_NOTAFISCAL_CLI_PED FORE' +
          'IGN KEY (COD_CLI_PED, COD_EMPRESA) REFERENCES CLIENTES(COD_CLIEN' +
          'TE, COD_EMPRESA) ON UPDATE CASCADE;'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI163'#39';'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI164'#39';'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI165'#39';'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI188'#39';'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI200'#39';'
        
          'UPDATE TABELA_PROCESSOS TB SET GRAVAR_AUDITORIA = '#39'N'#39' WHERE GRAV' +
          'AR_AUDITORIA = '#39'S'#39' AND COD_PROCESSO = '#39'CLI201'#39';'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'CLI271'#39', :COD_EMPRESA, '#39'ALTERAR CLIENTE EMISSAO NFE'#39',' +
          ' 5, '#39'N'#39', '#39'S'#39');'
        
          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, SENHA_GERENTE, GRAVAR_AUDITORIA' +
          ') VALUES ('#39'VND264'#39', :COD_EMPRESA, '#39'ALTERAR CLIENTE EMISSAO NFE N' +
          'A VENDA'#39', 5, '#39'N'#39', '#39'S'#39');'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW PEDVENDA_DAV('
        '    NPED,'
        '    TIPO,'
        '    COD_EMPRESA,'
        '    IDENTIFICACAO_EMP,'
        '    NOME_EMP,'
        '    FANTASIA_EMP,'
        '    CGC_EMP,'
        '    IE_EMP,'
        '    TELEFONE_EMP,'
        '    EMAIL_EMP,'
        '    ENDERECO_COMPL_EMP,'
        '    ENDERECO_EMP,'
        '    CEP_EMP,'
        '    NUMERO_END_EMP,'
        '    COMPLEMENTO_END_EMP,'
        '    BAIRRO_EMP,'
        '    CIDADE_EMP,'
        '    ESTADO_EMP,'
        '    COD_CLIENTE,'
        '    NOME_CLIENTE,'
        '    RAZAO_CLIENTE,'
        '    CPFCGC,'
