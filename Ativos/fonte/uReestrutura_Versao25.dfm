        '|BLOCO|'
        'create or alter procedure SP_SQL_INSERT_GUID ('
        '    SQL blob sub_type 1 segment size 1024,'
        '    RETURN_FIELD varchar(31))'
        'returns ('
        '    ID char(36))'
        'as'
        'begin'
        '  execute statement SQL || '#39' returning '#39' || RETURN_FIELD'
        '      into :ID;'
