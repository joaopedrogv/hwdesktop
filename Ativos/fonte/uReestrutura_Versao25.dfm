          'CMD:REPL|INSERT INTO TABELA_PROCESSOS (COD_PROCESSO, COD_EMPRESA' +
          ', NOME_PROCESSO, NIVEL_PROCESSO, FORM, ATIVO, SENHA_GERENTE, GRA' +
          'VAR_AUDITORIA, DATA_MOD_CAD) VALUES ('#39'BAL008'#39', :COD_EMPRESA, '#39'AR' +
          'QUIVO DE BALANCO GERADO EM OUTRA DATA'#39', 10, '#39'FRMBALANCO'#39', 1, '#39'S'#39 +
          ', '#39'S'#39', CURRENT_DATE);'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_BALANCO_PRODUTOS_GRADE FOR BALANCO_PR' +
          'ODUTOS'
        'ACTIVE AFTER UPDATE OR DELETE POSITION 0'
        'AS'
        'begin'
        '  /* Trigger text */'
        '  if (deleting) then'
        '  begin'
        '    delete from cod_grade_balanco'
        '    where grupo_prod = old.grupo_prod'
        '    and cod_prod = old.cod_prod'
        '    and cod_empresa = old.cod_empresa;'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    if (coalesce(new.qtde_prod, 0) <= 0) then'
        '    begin'
        '      delete from cod_grade_balanco'
        '      where grupo_prod = new.grupo_prod'
        '      and cod_prod = new.cod_prod'
        '      and cod_empresa = new.cod_empresa;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TR_COD_GRADE_BALANCO_GRADE FOR COD_GRADE' +
          '_BALANCO'
        'ACTIVE AFTER DELETE POSITION 0'
        'AS'
        '  declare variable vqtdecont double precision default 00000.00;'
        '  declare variable vqtdedif  double precision default 00000.00;'
        'begin'
        '  /* Trigger text */'
        '  if (deleting) then'
        '  begin'
        '    if (coalesce(old.cod_grade , 0) > 0) then'
        '    begin'
        
          '      select sum(coalesce(qtde, 0)) qtde, sum(coalesce(qtd_dif_b' +
          'al, 0)) qtd_dif_bal from cod_grade_balanco'
        '      where grupo_prod = old.grupo_prod'
        '      and cod_prod = old.cod_prod'
        '      and cod_empresa = old.cod_empresa'
        '      and cod_grade > 0 into :vqtdecont, :vqtdedif;'
        ''
        
          '      update balanco_produtos set qtde_prod = coalesce(:vqtdecon' +
          't, 0), qtd_dif_bal = coalesce(:vqtdedif, 0)'
        '      where grupo_prod = old.grupo_prod'
        '      and cod_prod = old.cod_prod'
        '      and cod_empresa = old.cod_empresa;'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE DEVOLUCAO ADD VALOR_TOT DOUBLE PRECISION;'
        ''
        '|BLOCO|'
        'CREATE OR ALTER VIEW DEVOLUCAO_TOT('
        '    TIPO,'
        '    TIPO_DEV,'
        '    NDEV,'
        '    DATA,'
        '    COD_CLIENTE,'
        '    COD_EMPRESA,'
        '    VALOR_DEV,'
        '    QUANT_DEV)'
        'AS'
        'select '#39'DEV'#39' as tipo,'
        '  dev.tipo tipo_dev,'
        '  dev.sequencia,'
        '  dev.data,'
        '  dev.cod_cliente,'
        '  dev.cod_empresa,'
        
          '  sum((-1) * case when (coalesce(dev.valor_tot, 0) > 0) then coa' +
          'lesce(dev.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0' +
          ') end) valor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        '  group by 1, 2, 3, 4, 5, 6;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure DEVOLUCAO_NPED ('
        '    PNPED integer,'
        '    PTIPO_VENDA char(3),'
        '    PCOD_EMPRESA integer)'
        'returns ('
        '    TIPO char(3),'
        '    NPED integer,'
        '    TIPO_VENDA char(3),'
        '    COD_EMPRESA integer,'
        '    VALOR_DEV double precision,'
        '    QUANT_DEV double precision)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select '#39'DEV'#39' as tipo,'
        
          '  coalesce(dev.cod_venda, 0) nped, coalesce(dev.tipo_venda, '#39#39') ' +
          'tipo_venda, dev.cod_empresa, --dev.data,'
        
          '  sum((-1) * case when (coalesce(dev.valor_tot, 0) > 0) then coa' +
          'lesce(dev.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0' +
          ') end) valor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        
          '  WHERE dev.cod_venda = :pnped and dev.tipo_venda = :ptipo_venda' +
          ' and dev.cod_empresa = :pcod_empresa'
        '  group by 1, 2, 3, 4'
        
          '  into :tipo, :nped, :tipo_venda, :cod_empresa, :valor_dev, :qua' +
          'nt_dev;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure DEVOLUCAO_GRUPO ('
        '    PNPED integer,'
        '    PTIPO_VENDA char(3),'
        '    PCOD_EMPRESA integer,'
        '    PGRUPO_PROD integer)'
        'returns ('
        '    TIPO char(3),'
        '    NPED integer,'
        '    TIPO_VENDA char(3),'
        '    COD_EMPRESA integer,'
        '    DATA timestamp,'
        '    VALOR_DEV double precision,'
        '    QUANT_DEV double precision,'
        '    GRUPO_PROD integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select '#39'DEV'#39' as tipo,'
        
          '  coalesce(dev.cod_venda, 0) nped, coalesce(dev.tipo_venda, '#39#39') ' +
          'tipo_venda, dev.cod_empresa, dev.data,'
        '  dev.grupo_prod,'
        
          '  sum(case when(coalesce(dev.valor_tot, 0) > 0) then coalesce(de' +
          'v.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0) end) v' +
          'alor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        '  where coalesce(dev.cod_venda, 0) = :pnped'
        '  and dev.tipo_venda = :ptipo_venda'
        '  and dev.cod_empresa = :pcod_empresa'
        '  and dev.grupo_prod = :pgrupo_prod'
        '  group by 1, 2, 3, 4, 5, 6'
        
          '  into :tipo, :nped, :tipo_venda, :cod_empresa, :data, :grupo_pr' +
          'od, :valor_dev, :quant_dev;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure DEVOLUCAO_MARCA ('
        '    PNPED integer,'
        '    PTIPO_VENDA char(3),'
        '    PCOD_EMPRESA integer,'
        '    PCOD_MARCA integer)'
        'returns ('
        '    TIPO char(3),'
        '    NPED integer,'
        '    TIPO_VENDA char(3),'
        '    COD_EMPRESA integer,'
        '    DATA timestamp,'
        '    VALOR_DEV double precision,'
        '    QUANT_DEV double precision,'
        '    COD_MARCA integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select '#39'DEV'#39' as tipo,'
        
          '  coalesce(dev.cod_venda, 0) nped, coalesce(dev.tipo_venda, '#39#39') ' +
          'tipo_venda, dev.cod_empresa, dev.data,'
        '  dev.grupo_prod,'
        
          '  sum(case when(coalesce(dev.valor_tot, 0) > 0) then coalesce(de' +
          'v.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0) end) v' +
          'alor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev  from devolucao dev'
        
          '  inner join produtos pr on pr.grupo_prod = dev.grupo_prod and p' +
          'r.cod_prod = dev.cod_prod and pr.cod_empresa = dev.cod_empresa'
        '  where coalesce(dev.cod_venda, 0) = :pnped'
        '  and dev.tipo_venda = :ptipo_venda'
        '  and dev.cod_empresa = :pcod_empresa'
        '  and pr.cod_marca = :pcod_marca'
        '  group by 1, 2, 3, 4, 5, 6'
        
          '  into :tipo, :nped, :tipo_venda, :cod_empresa, :data, :cod_marc' +
          'a, :valor_dev, :quant_dev;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure DEVOLUCAO_PROD ('
        '    PNPED integer,'
        '    PTIPO_VENDA char(3),'
        '    PCOD_EMPRESA integer,'
        '    PGRUPO_PROD integer,'
        '    PCOD_PROD char(6))'
        'returns ('
        '    TIPO char(3),'
        '    NPED integer,'
        '    TIPO_VENDA char(3),'
        '    COD_EMPRESA integer,'
        '    DATA timestamp,'
        '    VALOR_DEV double precision,'
        '    QUANT_DEV double precision,'
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6))'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select '#39'DEV'#39' as tipo,'
        
          '  coalesce(dev.cod_venda, 0) nped, coalesce(dev.tipo_venda, '#39#39') ' +
          'tipo_venda, dev.cod_empresa, dev.data,'
        '  dev.grupo_prod, dev.cod_prod,'
        
          '  sum(case when(coalesce(dev.valor_tot, 0) > 0) then coalesce(de' +
          'v.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0) end) v' +
          'alor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev from devolucao dev'
        '  where coalesce(dev.cod_venda, 0) = :pnped'
        '  and dev.tipo_venda = :ptipo_venda'
        '  and dev.cod_empresa = :pcod_empresa'
        '  and dev.grupo_prod = :pgrupo_prod'
        '  and dev.cod_prod = :pcod_prod'
        '  group by 1, 2, 3, 4, 5, 6, 7'
        
          '  into :tipo, :nped, :tipo_venda, :cod_empresa, :data, :grupo_pr' +
          'od, :cod_prod, :valor_dev, :quant_dev;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure DEVOLUCAO_SUBGRUPO ('
        '    PNPED integer,'
        '    PTIPO_VENDA char(3),'
        '    PCOD_EMPRESA integer,'
        '    PSUB_G_PROD integer)'
        'returns ('
        '    TIPO char(3),'
        '    NPED integer,'
        '    TIPO_VENDA char(3),'
        '    COD_EMPRESA integer,'
        '    DATA timestamp,'
        '    VALOR_DEV double precision,'
        '    QUANT_DEV double precision,'
        '    SUB_GRUPO_PROD integer)'
        'as'
        'begin'
        '  /* Procedure Text */'
        '  select '#39'DEV'#39' as tipo,'
        
          '  coalesce(dev.cod_venda, 0) nped, coalesce(dev.tipo_venda, '#39#39') ' +
          'tipo_venda, dev.cod_empresa, dev.data,'
        '  dev.grupo_prod,'
        
          '  sum(case when(coalesce(dev.valor_tot, 0) > 0) then coalesce(de' +
          'v.valor_tot, 0) else coalesce((dev.valor * dev.quant), 0) end) v' +
          'alor_dev,'
        '  count(distinct(dev.sequencia)) quant_dev'
        '  from devolucao dev'
        
          '  inner join produtos pr on pr.grupo_prod = dev.grupo_prod and p' +
          'r.cod_prod = dev.cod_prod and pr.cod_empresa = dev.cod_empresa'
        '  where coalesce(dev.cod_venda, 0) = :pnped'
        '  and dev.tipo_venda = :ptipo_venda'
        '  and dev.cod_empresa = :pcod_empresa'
        '  and pr.sub_g_prod = :psub_g_prod'
        '  group by 1, 2, 3, 4, 5, 6'
        
          '  into :tipo, :nped, :tipo_venda, :cod_empresa, :data, :sub_grup' +
          'o_prod, :valor_dev, :quant_dev;'
        '  suspend;'
        'end;'
        '|/BLOCO|'
        ''
        
          'CMD:REPL|UPDATE DEVOLUCAO SET VALOR_TOT = ROUND(VALOR * QUANT, 2' +
          ') WHERE VALOR_TOT IS NULL;'
        ''
        '|BLOCO|CMD:INATIVO|'
        'create or alter procedure SPRI_MAKE_OBJ_EST'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'CREATE OR ALTER TRIGGER TI_PROM_PROD_BI_PROPORC_PREC FOR PROMOCA' +
          'O_PRODUTO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;'
        '  DECLARE VARIABLE VPREC_CUSM_PROD T_VL_TODOS;'
        'begin'
        '  /* Trigger text */'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) <= 0) AND (COALESCE(new' +
          '.VALOR_PROMOCAO, 0) > 0) AND (COALESCE(new.COD_TPPRECO, 0) > 1))' +
          ' then'
        '  begin'
        '    SELECT PREC_CUSM_PROD, PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_CUSM_PROD, :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(VPREC_TAB_PROD, 0) > 0.1) then'
        '    begin'
        
          '      if (COALESCE(VPREC_CUSM_PROD, 0) >= COALESCE(VPREC_TAB_PRO' +
          'D, 0)) then'
        '        new.PROPORCAO_TABELA = 0;'
        '      else'
        '      begin'
        '        if (COALESCE(VPREC_TAB_PROD, 0) > 0) then'
        
          '          new.PROPORCAO_TABELA = new.VALOR_PROMOCAO / VPREC_TAB_' +
          'PROD;'
        '        else'
        '          new.PROPORCAO_TABELA = 0;'
        '      end'
        '    end'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PROM_PROD_PPRECO FOR PROMOCAO_PRODUTO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;  '
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;  '
        'begin'
        '  /* Trigger text */'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) AND (COALESCE(new.' +
          'COD_TPPRECO, 0) > 1)) then'
        '  begin'
        '    SELECT COALESCE(VALUE1_F, 0) FROM CONFIG_SISTEMA'
        '    WHERE CHAVE = '#39'prod_cad_recalcular_preco_diferenciado'#39
        '    AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VRECALCULAR_PRECOS;'
        ''
        
          '    if ((COALESCE(new.VALOR_PROMOCAO, 0) > 0) and (COALESCE(VREC' +
          'ALCULAR_PRECOS, 0) <= 0)) then'
        '      exit;'
        ''
        '    SELECT CASAS_DECIMAIS FROM EMPRESA'
        '    WHERE COD_EMPRESA = new.COD_EMPRESA'
        '      into :VCASAS_DECIMAIS;           '
        ''
        '    VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '    if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '      VCASAS_DECIMAIS = 2;'
        ''
        '    SELECT PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        
          '      if (COALESCE(new.VALOR_PROMOCAO, 0) <> ROUND((new.PROPORCA' +
          'O_TABELA * VPREC_TAB_PROD), VCASAS_DECIMAIS)) then'
        '        if (COALESCE(VPREC_TAB_PROD, 0) <= 0.1) then'
        '          new.VALOR_PROMOCAO = 0;'
        '        else'
        
          '          new.VALOR_PROMOCAO = ROUND((new.PROPORCAO_TABELA * VPR' +
          'EC_TAB_PROD), :VCASAS_DECIMAIS);'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        'ALTER TABLE PEDVENDA ADD DEV CHAR(1);'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PEDVENDA_DEV FOR PEDVENDA'
        'ACTIVE AFTER INSERT OR UPDATE POSITION 0'
        'AS'
        '  DECLARE VARIABLE  vstatus_ped varchar(10);'
        '  DECLARE VARIABLE  vexiste_dev char(1);'
        '  DECLARE VARIABLE  vgrupoprod Integer;'
        '  DECLARE VARIABLE  vcodprod char(6);'
        '  DECLARE VARIABLE  vcodgrade Integer;'
        
          '  DECLARE VARIABLE  vquant_ped double precision default 00000.00' +
          ';'
        
          '  DECLARE VARIABLE  vquant_dev double precision default 00000.00' +
          ';'
        'begin'
        '  if (SUBSTRING(USER FROM 1 FOR 4) = '#39'REPL'#39') THEN'
        '   exit;'
        ''
        '  vstatus_ped = '#39#39';'
        '  vexiste_dev = '#39'N'#39';'
        '  vgrupoprod = 0;'
        '  vcodprod = 0;'
        '  vcodgrade = 0;'
        '  vquant_ped = 0;'
        '  vquant_dev = 0;'
        ''
        '  /* Trigger text */'
        '  if (inserting) then'
        '  begin'
        '    select status_ped from pedvenda'
        '    where nped = new.nped'
        '    and tipo = new.tipo'
        '    and cod_empresa = new.cod_empresa into :vstatus_ped;'
        ''
        '    if (coalesce(new.status_ped, '#39#39') = '#39'CANCELADO'#39') then'
        '      exit;'
        ''
        
          '    select case when (count(*) > 0) then '#39'S'#39' else '#39'N'#39' end from d' +
          'evolucao'
        '    where cod_venda = new.nped'
        '    and tipo_venda = new.tipo'
        '    and cod_empresa = new.cod_empresa'
        '      into :vexiste_dev;'
        ''
        
          '    for select grupo_prod, cod_prod, cod_grade, sum(coalesce(qua' +
          'nt_ped_item, 0)) quant from pedvenda_prod'
        '        where nped = new.nped'
        '        and tipo = new.tipo'
        '        and cod_empresa = new.cod_empresa'
        '        and (status <> '#39'CANCELADO'#39' or status is null)'
        '        group by 1, 2, 3'
        
          '          into :vgrupoprod, :vcodprod, :vcodgrade, :vquant_ped d' +
          'o'
        '    begin'
        '      select sum(coalesce(quant, 0)) quant from devolucao'
        '      where cod_venda = new.nped'
        '      and tipo_venda = new.tipo'
        '      and grupo_prod = :vgrupoprod'
        '      and cod_prod = :vcodprod'
        '      and cod_grade = :vcodgrade'
        '      and cod_empresa = new.cod_empresa'
        '        into :vquant_dev;'
        ''
        
          '      if ((coalesce(vexiste_dev, '#39'N'#39') = '#39'S'#39') and (coalesce(vquan' +
          't_dev, 0) <= 0)) then'
        '      begin'
        
          '        update pedvenda set dev = '#39'P'#39' where nped = new.nped and ' +
          'tipo = new.tipo and cod_empresa = new.cod_empresa and (coalesce(' +
          'dev, '#39#39') <> '#39'P'#39');'
        '        exit;'
        '      end'
        
          '      else if ((coalesce(vexiste_dev, '#39'N'#39') = '#39'S'#39') and (coalesce(' +
          'vquant_ped, 0) > coalesce(vquant_dev, 0))) then'
        '      begin'
        
          '        update pedvenda set dev = '#39'P'#39' where nped = new.nped and ' +
          'tipo = new.tipo and cod_empresa = new.cod_empresa and (coalesce(' +
          'dev, '#39#39') <> '#39'P'#39');'
        '        exit;'
        '      end'
        '    end'
        ''
        '    if (coalesce(vexiste_dev, '#39'N'#39') = '#39'N'#39') then'
        
          '      update pedvenda set dev = null where nped = new.nped and t' +
          'ipo = new.tipo and cod_empresa = new.cod_empresa and (coalesce(d' +
          'ev, '#39#39') <> '#39#39');'
        '    else'
        
          '      update pedvenda set dev = '#39'T'#39' where nped = new.nped and ti' +
          'po = new.tipo and cod_empresa = new.cod_empresa and (coalesce(de' +
          'v, '#39#39') <> '#39'T'#39');'
        '  end'
        '  else if (updating) then'
        '  begin'
        '    select status_ped from pedvenda'
        '    where nped = new.nped'
        '    and tipo = new.tipo'
