        '|BLOCO|'
        'create or alter procedure SPRI_MAKE_OBJ_CTRL ('
        '    TABELA varchar(31),'
        '    TABELA_ID integer)'
        'as'
        'declare variable STMT blob sub_type 1 segment size 256;'
        'begin'
        '  if (TABELA = '#39'CONTROLES'#39') then'
        '  begin'
        
          '    update or insert into RI_SCHEMA_TAB_EXCE (TABELA_ID, CAMPO) ' +
          'values (:TABELA_ID, '#39'SALDO_ANT_CTRL'#39') matching (TABELA_ID, CAMPO' +
          ');'
        
          '    update or insert into RI_SCHEMA_TAB_EXCE (TABELA_ID, CAMPO) ' +
          'values (:TABELA_ID, '#39'SALDO_AT_CTRL'#39') matching (TABELA_ID, CAMPO)' +
          ';'
        
          '    update or insert into RI_SCHEMA_TAB_EXCE (TABELA_ID, CAMPO) ' +
          'values (:TABELA_ID, '#39'SOBRA_CTRL'#39') matching (TABELA_ID, CAMPO);'
        ''
        
          '    STMT = '#39'create or alter trigger TI_RI_SALDO_CTRL for CONTROL' +
          'ES'#39' || ascii_char(13) ||'
        
          '           '#39'active before update position 1'#39' || ascii_char(13) |' +
          '|'
        '           '#39'as'#39' || ascii_char(13) ||'
        
          '           '#39'  declare variable CONTEXT_VAR char(36);'#39' || ascii_c' +
          'har(13) ||'
        
          '           '#39'  declare variable CONTEXT_STAT varchar(255);'#39' || as' +
          'cii_char(13) ||'
        '           '#39'begin'#39' || ascii_char(13) ||'
        '           '#39'  select GUIDT'#39' || ascii_char(13) ||'
        '           '#39'  from RI_TAB'#39' || ascii_char(13) ||'
        
          '           '#39'  where TABELA = '#39#39'CONTROLES'#39#39' '#39' || ascii_char(13) |' +
          '|'
        '           '#39'    into :CONTEXT_VAR;'#39' || ascii_char(13) ||'
        '           '#39#39' || ascii_char(13) ||'
        
          '           '#39'  select RDB$GET_CONTEXT('#39#39'USER_TRANSACTION'#39#39', :CONT' +
          'EXT_VAR)'#39' || ascii_char(13) ||'
        '           '#39'  from RDB$DATABASE'#39' || ascii_char(13) ||'
        '           '#39'    into :CONTEXT_STAT;'#39' || ascii_char(13) ||'
        '           '#39#39' || ascii_char(13) ||'
        
          '           '#39'  if (coalesce(CONTEXT_STAT, '#39#39#39#39') <> '#39#39#39#39') then'#39' ||' +
          ' ascii_char(13) ||'
        '           '#39'  begin'#39' || ascii_char(13) ||'
        
          '           '#39'    new.SALDO_ANT_CTRL = old.SALDO_ANT_CTRL;'#39' || asc' +
          'ii_char(13) ||'
        
          '           '#39'    new.SALDO_AT_CTRL = old.SALDO_AT_CTRL;'#39' || ascii' +
          '_char(13) ||'
        
          '           '#39'    new.SOBRA_CTRL = old.SOBRA_CTRL;'#39' || ascii_char(' +
          '13) ||'
        '           '#39'  end'#39' || ascii_char(13) ||'
        '           '#39'end'#39';'
        '  end'
        '  else'
        '    STMT = '#39#39';'
        ''
        '  if (coalesce(STMT, '#39#39') <> '#39#39') then'
        '  begin'
        '    insert into RI_TMP_SQL (SQLEXEC)'
        '    values (:STMT);'
        ''
        '    execute statement STMT;'
        '  end'
        'end;'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SPRI_MAKE_OBJ ('
        '    TABELA varchar(31),   '
        '    SCH_TB_ID integer,'
        '    REMOVER smallint = 0)'
        'as'
        'declare variable SCHEMA_ID integer;'
        'declare variable TABLE_ID integer;'
        'declare variable STMTTR blob sub_type 1 segment size 256;'
        'declare variable SQLTMP blob sub_type 1 segment size 32;'
        'declare variable SQLTMP2 blob sub_type 1 segment size 32;'
        'declare variable SQLTMP3 blob sub_type 1 segment size 32;'
        'declare variable STMTCASE0 blob sub_type 1 segment size 32;'
        'declare variable STMTCASE1 blob sub_type 1 segment size 32;'
        'declare variable STMTCASEWHEN1 blob sub_type 1 segment size 32;'
        'declare variable STMTCASEWHEN2 blob sub_type 1 segment size 32;'
        'declare variable STMTEMPTY blob sub_type 1 segment size 32;'
        'declare variable STMTACTIVE blob sub_type 1 segment size 32;'
        'declare variable STMTACTIVEEND blob sub_type 1 segment size 32;'
        'declare variable LOGKEYSUPDATE blob sub_type 1 segment size 32;'
        'declare variable VARPKID varchar(128);'
        'declare variable TNAME varchar(31);'
        'declare variable TRNAME varchar(31);'
        'declare variable FNAME varchar(31);'
        'declare variable PKNAME varchar(31);'
        'declare variable FKNAME varchar(31);'
        'declare variable FEMPNAME varchar(31);'
        'declare variable FTYPE varchar(32);'
        'declare variable FISPK smallint;'
        'declare variable FISWHERE smallint;'
        'declare variable TPID smallint;'
        'declare variable KEYONLYEMP integer;'
        'begin'
        '  TABELA = trim(TABELA);'
        ''
        '  update or insert into RI_TAB (TABELA)'
        '  values (:TABELA)'
        '  matching (TABELA);'
        ''
        '  select T.ID, E.CAMPO_EMP'
        '  from RI_TAB T'
        '    left join SPDB_EMP_KEY(T.TABELA) E on 1 = 1'
        '  where T.TABELA = :TABELA'
        '    into :TABLE_ID, :FEMPNAME;'
        ''
        '  TRNAME = '#39'TI_RI_'#39' ||(select RESULT'
        '                       from STRZERO(:TABLE_ID, 3));'
        '  STMTCASE0 = '#39#39';'
        '  STMTCASEWHEN1 = '#39#39';'
        '  STMTCASEWHEN2 = '#39#39';'
        '  STMTACTIVE = '#39#39';'
        '  STMTACTIVEEND = '#39#39';'
        ''
        '  if (REMOVER = 1) then'
        '  begin'
        '    FNAME = '#39#39';'
        ''
        '    select count(ID)'
        '    from RI_SCHEMA_TAB'
        '    where TABELA = :TABELA'
        '      into :TABLE_ID;'
        ''
        '    if (coalesce(TABLE_ID, 0) = 0) then'
        '    begin'
        '      select trim(TG.RDB$TRIGGER_NAME)'
        '      from RDB$TRIGGERS TG'
        '      where TG.RDB$RELATION_NAME = :TABELA and'
        '            TG.RDB$TRIGGER_NAME = :TRNAME and'
        '            TG.RDB$SYSTEM_FLAG = 0'
        '        into :FNAME;'
        '  '
        '      if (FNAME = TRNAME) then'
        '        STMTTR = '#39'DROP TRIGGER '#39' || TRNAME;'
        '      else'
        
          '        STMTTR = '#39'DROP TRIGGER '#39' || TRNAME || '#39' - trigger not ex' +
          'ists'#39';'
        '  '
        '      insert into RI_TMP_SQL (SQLEXEC)'
        '      values (:STMTTR);'
        '  '
        '      if (FNAME = TRNAME) then'
        '        execute statement STMTTR;'
        '      exit;'
        '    end'
        '    else'
        '      REMOVER = 0;'
        '  end'
        ''
        '  VARPKID = '#39#39';'
        '  SQLTMP = '#39#39';'
        '  for select distinct TABLE_REF, PK_NAME, FK_NAME'
        '    from SPDB_FIELDS_FK(:TABELA)'
        '    where UPDATE_CASCATA = 1'
        '      into :TNAME, :PKNAME, :FKNAME'
        '  do'
        '  begin'
        '    SQLTMP2 = '#39#39';'
        '    SQLTMP3 = '#39#39';'
        ''
        '    for select FIELDNAME'
        '        from SPDB_FIELDS_FK(:TABELA)'
        '        where FK_NAME = :FKNAME'
        '          into :FNAME'
        '    do'
        '    begin'
        '      if (SQLTMP2 <> '#39#39') then'
        '      begin'
        '        SQLTMP2 = SQLTMP2 || '#39' || '#39#39'-'#39#39' || '#39';'
        '        SQLTMP3 = SQLTMP3 || '#39' or '#39';'
        '      end'
        '      SQLTMP2 = SQLTMP2 || '#39'old.'#39' || FNAME;'
        
          '      SQLTMP3 = SQLTMP3 || '#39'(old.'#39' || FNAME || '#39' <> new.'#39' || FNA' +
          'ME || '#39')'#39';'
        '    end'
        ''
        '    SQLTMP = iif(SQLTMP <> '#39#39', ascii_char(13), '#39#39') ||'
        '             SQLTMP ||'
        
          '             '#39'  if ((updating) and ('#39' || SQLTMP3 || '#39')) then'#39' ||' +
          ' ascii_char(13) ||'
        
          '             '#39'    for select IDPK from SPRI_FKCHECK('#39#39#39' || :TNAM' +
          'E || '#39#39#39', '#39#39#39' || :PKNAME || '#39#39#39', '#39' || SQLTMP2 || '#39')'#39' || ascii_ch' +
          'ar(13) ||'
        '             '#39'        where IDPK > 0'#39' || ascii_char(13) ||'
        '             '#39'          into :IDPK'#39' || ascii_char(13) ||'
        '             '#39'    do'#39' || ascii_char(13) ||'
        '             '#39'      exit;'#39' || ascii_char(13);'
        ''
        
          '    VARPKID = '#39'  declare variable IDPK integer;'#39' || ascii_char(1' +
          '3);'
        '  end'
        '  LOGKEYSUPDATE = SQLTMP;'
        ''
        '  SQLTMP = '#39#39';'
        '  SQLTMP2 = '#39#39';'
        '  for select FIELDNAME, PK_NAME from SPDB_FIELDS_PK(:TABELA)'
        '        into :FNAME, :PKNAME'
        '  do'
        '  begin'
        '    if (SQLTMP <> '#39#39') then'
        '    begin'
        '      SQLTMP = SQLTMP || '#39' or '#39';'
        '      SQLTMP2 = SQLTMP2 || '#39' || '#39#39'-'#39#39' || '#39';'
        '    end'
        
          '    SQLTMP = SQLTMP || '#39'(old.'#39' || FNAME || '#39' <> new.'#39' || FNAME |' +
          '| '#39')'#39';'
        '    SQLTMP2 = SQLTMP2 || '#39'old.'#39' || FNAME;'
        '  end'
        ''
        
          '  LOGKEYSUPDATE = '#39'  if ((updating) and ('#39' || SQLTMP || '#39')) then' +
          #39' || ascii_char(13) ||'
        
          '                  '#39'    insert into RI_TAB_UPDATEKEY(TABELA, CONS' +
          'TRAINT_NAME, KEYVALUES) values ('#39#39#39' || :TABELA || '#39#39#39', '#39#39#39' || :P' +
          'KNAME || '#39#39#39', '#39' || SQLTMP2 || '#39');'#39' || ascii_char(13) ||'
        '                  LOGKEYSUPDATE;'
        ''
        '  select first 1 trim(F.FIELDNAME)'
        '    from SPDB_FIELDS(:TABELA) F'
        '    where F.FIELDNAME = '#39'REP_INT_ACTIVE'#39' and'
        '          F.FIELDTYPE2 = '#39'INT'#39
        '      into :STMTACTIVE;'
        ''
        '  if (STMTACTIVE = '#39'REP_INT_ACTIVE'#39') then'
        '  begin'
        
          '    STMTACTIVE = '#39'  if ((updating) and (coalesce(new.REP_INT_ACT' +
          'IVE, 0) <> 1)) then'#39' || ascii_char(13) ||'
        
          '                 '#39'    exit;'#39' || ascii_char(13) || ascii_char(13)' +
          ';'
        ''
        '    for select trim(F.FIELDNAME), trim(F.FIELDTYPE2)'
        '        from SPDB_FIELDS(:TABELA) F'
        '          inner join SPDB_IS_PK(:TABELA, F.FIELDNAME) P on 1 = 1'
        '        where P.ISPK = 1'
        '          into :FNAME, :FTYPE'
        '        do'
        '        begin    '
        '          if (STMTACTIVEEND <> '#39#39') then'
        '            STMTACTIVEEND = STMTACTIVEEND || '#39' || '#39#39' and '#39';'
        ''
        '          if (FTYPE in ('#39'STRING'#39')) then'
        
          '            STMTACTIVEEND = STMTACTIVEEND || FNAME || '#39' = '#39#39#39#39#39#39 +
          ' || new.'#39' || FNAME || '#39' || '#39#39#39#39#39#39#39#39' '#39';'
        '          else'
        
          '            STMTACTIVEEND = STMTACTIVEEND || FNAME || '#39' = '#39#39' || ' +
          'cast(new.'#39' || FNAME ||'#39' as varchar(64)) '#39';'
        '        end'
        ''
        '    STMTACTIVEEND = ascii_char(13) ||'
        
          '                    '#39'  if ((not deleting) and (new.REP_INT_ACTIV' +
          'E = 1)) then'#39' || ascii_char(13) ||'
        
          '                    '#39'    execute statement '#39#39'update '#39' || :TABELA' +
          ' || '#39' set REP_INT_ACTIVE = null where '#39' || STMTACTIVEEND || '#39';'#39' ' +
          '|| ascii_char(13);'
        '  end'
        ''
        '  for select distinct SCHEMA_ID'
        '      from RI_SCHEMA_TAB'
        '      where TABELA = :TABELA'
        '      order by TIPO_ID'
        '        into :SCHEMA_ID'
        '  do'
        '  begin'
        '    STMTCASE1 = '#39#39';'
        '    STMTEMPTY = '#39#39';'
        
          '    for select F.FIELDNAME, F.FIELDTYPE2, P.ISPK, iif(W.CAMPO = ' +
          'F.FIELDNAME, 1, 0), T.TIPO_ID'
        '        from SPDB_FIELDS(:TABELA) F'
        '          left join SPDB_IS_PK(:TABELA, F.FIELDNAME) P on 1 = 1'
        '          left join RI_SCHEMA_TAB T on T.TABELA = :TABELA and'
        '                T.SCHEMA_ID = :SCHEMA_ID'
        
          '          left join RI_SCHEMA_TAB_WHERE W on W.TABELA_ID = T.ID ' +
          'and'
        '                W.CAMPO = F.FIELDNAME'
        '        where (F.FIELDNAME <> :FEMPNAME) and'
        '              (F.FIELDNAME <> '#39'REP_INT_ACTIVE'#39') and'
        '              (P.ISPK = 1 or W.CAMPO = F.FIELDNAME)'
        '          into :FNAME, :FTYPE, :FISPK, :FISWHERE, :TPID'
        '    do'
        '    begin'
        '      SQLTMP = '#39#39';'
        ''
        '      if (((TPID = 0) and'
        '          (FISPK = 1)) or ((TPID = 1) and'
        '          (FISWHERE = 1))) then'
        '      begin'
        
          '        if ((TPID = 1) and (FISWHERE = 1) and (FTYPE in ('#39'STRING' +
          #39'))) then'
        
          '          STMTEMPTY = STMTEMPTY || '#39' and (coalesce(iif(@ACAO, @P' +
          '1.'#39' || FNAME || '#39', @P2.'#39' || FNAME || '#39'),'#39#39#39#39') <> '#39#39#39#39')'#39';'
        ''
        '        SQLTMP = SQLTMP || '#39#39#39'@.'#39' || FNAME || '#39'='#39#39#39';'
        ''
        '        if (FTYPE in ('#39'STRING'#39')) then'
        
          '          SQLTMP = SQLTMP || '#39#39#39#39#39' || iif(@ACAO, @P1.'#39' || FNAME ' +
          '|| '#39', @P2.'#39' || FNAME || '#39') || '#39#39#39#39#39#39#39#39#39';'
        '        else'
        
          '          SQLTMP = SQLTMP || '#39' || cast(iif(@ACAO, @P1.'#39' || FNAME' +
          ' || '#39', @P2.'#39' || FNAME || '#39') as varchar(64))'#39';'
        '      end'
        ''
        '      if ((TPID = 0) and'
        '          (FISPK = 1) and'
        '          (STMTCASE0 <> '#39'FIM'#39')) then'
        '      begin'
        '        if (STMTCASE0 <> '#39#39') then'
        '          STMTCASE0 = STMTCASE0 || '#39' || '#39#39' and '#39#39' || '#39';'
        '        STMTCASE0 = STMTCASE0 || SQLTMP;'
        '      end'
        ''
        '      if ((TPID = 1) and'
        '          (FISWHERE = 1)) then'
        '      begin'
        '        if (STMTCASE1 <> '#39#39') then'
        '          STMTCASE1 = STMTCASE1 || '#39' || '#39#39' and '#39#39' || '#39';'
        '        STMTCASE1 = STMTCASE1 || SQLTMP;'
        '      end'
        '    end'
        ''
        '    if ((STMTCASE0 <> '#39#39') and'
        '        (STMTCASE0 <> '#39'FIM'#39')) then'
        '    begin'
        
          '      STMTCASEWHEN1 = STMTCASEWHEN1 || '#39'           when (S.TIPO_' +
          'ID = 0) then '#39' || STMTCASE0 || ascii_char(13);'
        
          '      STMTCASEWHEN2 = STMTCASEWHEN2 || '#39'           when (S.TIPO_' +
          'ID = 0) then '#39' || STMTCASE0 || ascii_char(13);'
        '      STMTCASE0 = '#39'FIM'#39';'
        '    end'
        '    if (STMTCASE1 <> '#39#39') then'
        '    begin'
        
          '      STMTCASEWHEN1 = STMTCASEWHEN1 || '#39'           when (S.TIPO_' +
          'ID = 1) and (S.SCHEMA_ID = '#39' || cast(:SCHEMA_ID as varchar(32)) ' +
          '|| '#39')'#39' || STMTEMPTY || '#39' then '#39' || STMTCASE1 || ascii_char(13);'
        
          '      STMTCASEWHEN2 = STMTCASEWHEN2 || '#39'           when (S.TIPO_' +
          'ID = 1) and (S.SCHEMA_ID = '#39' || cast(:SCHEMA_ID as varchar(32)) ' +
          '|| '#39')'#39' || STMTEMPTY || '#39' then '#39' || STMTCASE1 || ascii_char(13);'
        '    end'
        ''
        '    STMTCASEWHEN1 = replace(STMTCASEWHEN1, '#39'@ACAO'#39', '#39'deleting'#39');'
        '    STMTCASEWHEN1 = replace(STMTCASEWHEN1, '#39'@P1'#39', '#39'old'#39');'
        '    STMTCASEWHEN1 = replace(STMTCASEWHEN1, '#39'@P2'#39', '#39'new'#39');'
        ''
        
          '    STMTCASEWHEN2 = replace(STMTCASEWHEN2, '#39'@ACAO'#39', '#39'inserting'#39')' +
          ';'
        '    STMTCASEWHEN2 = replace(STMTCASEWHEN2, '#39'@P1'#39', '#39'new'#39');'
        '    STMTCASEWHEN2 = replace(STMTCASEWHEN2, '#39'@P2'#39', '#39'old'#39');'
        '  end'
        ''
        '  KEYONLYEMP = 0;'
        '  if ((STMTCASEWHEN1 = '#39#39') and (STMTCASEWHEN2 = '#39#39')) then'
        '    select count(T.TABELA)'
        '    from SPDB_TABLES T'
        '      inner join SPDB_COUNT_PK(T.TABELA) CP on 1 = 1'
        '      inner join SPDB_EMP_KEY(T.TABELA) EK on 1 = 1'
        '    where EK.CAMPO_EMP <> '#39#39' and'
        '          CP.COUNTPK = 1 and'
        '          T.TABELA = :TABELA'
        '      into :KEYONLYEMP;'
        ''
        
          '  STMTTR = '#39'CREATE OR ALTER TRIGGER @TRNAME FOR @TBNAME'#39' || asci' +
          'i_char(13) ||'
        
          '           '#39'ACTIVE AFTER INSERT OR UPDATE OR DELETE POSITION 999' +
          #39' || ascii_char(13) ||'
        '           '#39'as'#39' || ascii_char(13) ||'
        '           iif(KEYONLYEMP = 1, '#39#39','
        
          '           '#39'  declare variable CONDICAO_O varchar(255);'#39' || asci' +
          'i_char(13) ||'
        
          '           '#39'  declare variable CONDICAO_D varchar(255);'#39' || asci' +
          'i_char(13)) ||'
        '           '#39'@VARPKID@'#39' ||'
        '           '#39'begin'#39' || ascii_char(13) ||'
        '           '#39'@LOGKEYSUPDATE@'#39' || ascii_char(13) ||'
        '           '#39'@STMTACTIVE@'#39' ||'
        '           iif(KEYONLYEMP = 1,'
        
          '           '#39'  execute procedure SPRI_EXEC('#39#39'@TBNAME'#39#39', '#39#39#39#39', '#39#39#39 +
          #39', iif(deleting, old.@FEMPNAME, new.@FEMPNAME), iif(deleting, 1,' +
          ' 0));'#39','
        '           '#39'  select'#39' || ascii_char(13) ||'
        '           '#39'         case'#39' || ascii_char(13) ||'
        '           '#39'@CASEWHEN1'#39' ||'
        '           '#39'           else '#39#39#39#39#39' || ascii_char(13) ||'
        '           '#39'         end,'#39' || ascii_char(13) ||'
        '           '#39'         case'#39' || ascii_char(13) ||'
        '           '#39'@CASEWHEN2'#39' ||'
        '           '#39'           else '#39#39#39#39#39' || ascii_char(13) ||'
        '           '#39'         end'#39' || ascii_char(13) ||'
        
          '           '#39'  from SPRI_SCHEMA('#39#39'@TBNAME'#39#39', iif(deleting, old.@F' +
          'EMPNAME, new.@FEMPNAME)) S'#39' || ascii_char(13) ||'
        
          '           '#39'    into :CONDICAO_O, :CONDICAO_D;'#39' || ascii_char(13' +
          ') ||'
        '           '#39#39' || ascii_char(13) ||'
        
          '           '#39'  if ((updating) and (new.@FEMPNAME <> old.@FEMPNAME' +
          ')) then'#39' || ascii_char(13) ||'
        '           '#39'    CONDICAO_O = '#39#39#39#39';'#39' || ascii_char(13) ||'
        '           '#39#39' || ascii_char(13) ||'
        '           '#39'  if (CONDICAO_O <> '#39#39#39#39') then'#39' || ascii_char(13) ||'
        
          '           '#39'    execute procedure SPRI_EXEC('#39#39'@TBNAME'#39#39', :CONDIC' +
          'AO_O, :CONDICAO_D, iif(deleting, old.@FEMPNAME, new.@FEMPNAME), ' +
          'iif(deleting, 1, 0));'#39') || ascii_char(13) ||'
        '           '#39'@STMTACTIVEEND@'#39' ||'
        '           '#39'end'#39';'
        ''
        '  STMTTR = replace(STMTTR, '#39'@TBNAME'#39', :TABELA);'
        '  STMTTR = replace(STMTTR, '#39'@TRNAME'#39', :TRNAME);'
        '  STMTTR = replace(STMTTR, '#39'@VARPKID@'#39', :VARPKID);'
        '  STMTTR = replace(STMTTR, '#39'@LOGKEYSUPDATE@'#39', :LOGKEYSUPDATE);'
        '  STMTTR = replace(STMTTR, '#39'@STMTACTIVE@'#39', :STMTACTIVE);'
        '  STMTTR = replace(STMTTR, '#39'@FEMPNAME'#39', :FEMPNAME);'
        '  STMTTR = replace(STMTTR, '#39'@CASEWHEN1'#39', :STMTCASEWHEN1);'
        '  STMTTR = replace(STMTTR, '#39'@CASEWHEN2'#39', :STMTCASEWHEN2);'
        '  STMTTR = replace(STMTTR, '#39'@STMTACTIVEEND@'#39', :STMTACTIVEEND);'
        ''
        '  insert into RI_TMP_SQL (SQLEXEC)'
        '  values (:STMTTR);'
        ''
        '  execute statement STMTTR;'
        ''
        '  if (:TABELA in ('#39'PRODUTOS'#39', '#39'COD_GRADE_PROD'#39') ) then'
        '    execute procedure SPRI_MAKE_OBJ_EST(:TABELA, :SCH_TB_ID);'
        '  else if (:TABELA in ('#39'CONTROLES'#39') ) then'
        '    execute procedure SPRI_MAKE_OBJ_CTRL(:TABELA, :SCH_TB_ID);'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE TABLE PRODUTOS_HISTORICO_PRECO ('
        '    ID           CHAR(36) NOT NULL,'
        '    COD_EMPRESA  INTEGER NOT NULL,'
        '    DATA         TIMESTAMP NOT NULL,'
        '    GRUPO_PROD   INTEGER NOT NULL,'
        '    COD_PROD     CHAR(6) NOT NULL,'
        '    TABELA_ID    VARCHAR(36),'
        
          '    CUSTO        T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        
          '    PRECO        T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        
          '    QUANTIDADE   T_VL_TODOS /* T_VL_TODOS = DOUBLE PRECISION DEF' +
          'AULT 000000000.00 */,'
        '    USUARIO      VARCHAR(32),'
        
          '    MARKUP       COMPUTED BY (iif (coalesce (CUSTO, 0) <= 0, 0, ' +
          '(PRECO / CUSTO - 1) * 100)),'
        
          '    MARGEM       COMPUTED BY (iif (coalesce (PRECO, 0) <= 0, 0, ' +
          '(PRECO - CUSTO) / PRECO * 100)),'
        '    DESCRICAO    VARCHAR(128)'
        ');'
        '|/BLOCO|'
        ''
        
          'ALTER TABLE PRODUTOS_HISTORICO_PRECO ADD CONSTRAINT PK_PRODUTOS_' +
          'HISTORICO_PRECO PRIMARY KEY (ID, COD_EMPRESA);'
        
          'ALTER TABLE PRODUTOS_HISTORICO_PRECO ADD CONSTRAINT FK_PRODUTOS_' +
          'HISTORICO_PRECO FOREIGN KEY (GRUPO_PROD, COD_PROD, COD_EMPRESA) ' +
          'REFERENCES PRODUTOS (GRUPO_PROD, COD_PROD, COD_EMPRESA) ON UPDAT' +
          'E CASCADE;'
        
          'CREATE INDEX PRODUTOS_HISTORICO_PRECO_IDX ON PRODUTOS_HISTORICO_' +
          'PRECO (COD_EMPRESA, DATA);'
        'ALTER TABLE PROMOCAO_PRODUTO ADD GUIDT CHAR(36);'
        'ALTER TABLE PROMOCAO_PRODUTO ADD MARKUP T_N_GERAL;'
        
          'CREATE UNIQUE INDEX PROMOCAO_PRODUTO_GUID ON PROMOCAO_PRODUTO (G' +
          'UIDT);'
        'ALTER TABLE PRECO_PRODUTOS_QTDE ADD GUIDT CHAR(36);'
        
          'CREATE UNIQUE INDEX PRECO_PRODUTOS_QTDE_GUID ON PRECO_PRODUTOS_Q' +
          'TDE (GUIDT);'
        'ALTER TABLE PRODUTOS ADD PDESC_PR30_VAREJO T_VL_TODOS;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRCTB_ITEM3 T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRCTB_ITEM6 T_N_GERAL;'
        'ALTER TABLE NOTAFISCAL_ITEM ADD PRCTB_ITEM9 T_N_GERAL;'
        ''
        '|BLOCO|'
        'create or alter view VW_TABELA_PRECOS('
        '    COD_PROMOCAO,'
        '    COD_TPPRECO,'
        '    COD_EMPRESA,'
        '    DESCR_PROMOCAO,'
        '    ORDEM,'
        '    TIPO,'
        '    DETALHE,'
        '    GRUPO_PROD,'
        '    COD_PROD,'
        '    DESCR_PROD,'
        '    PREC_CUSM_PROD,'
        '    PREC_TAB_PROD,'
        '    COD_LOCALIDADE,'
        '    COD_SETOR,'
        '    COD_CIDADE,'
        '    PORCENTAGEM,'
        '    VALOR_PROMOCAO,'
        '    PROPORCAO_TABELA,'
        '    MARKUP)'
        'AS'
        
          'select COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, DESCR_PROMOCAO, O' +
          'RDEM, TIPO, DETALHE, GRUPO_PROD, COD_PROD, DESCR_PROD,'
        
          '       PREC_CUSM_PROD, PREC_TAB_PROD, COD_LOCALIDADE, COD_SETOR,' +
          ' COD_CIDADE, PORCENTAGEM, VALOR_PROMOCAO, PROPORCAO_TABELA, MARK' +
          'UP'
        'from ('
        '  select'
        
          '  pm.cod_promocao, pm.cod_tppreco, pm.cod_empresa, pm.descr_prom' +
          'ocao, pm.ordem,'
        '  case when l.cod_localidade is not null then '#39'LOCALIDADE'#39
        '       when s.cod_setor is not null then '#39'SETOR'#39
        '       when c.cod_cidade is not null then '#39'CIDADE'#39
        '       when pp.cod_tppreco = 1 then '#39'PROMOCAO'#39
        '    else'
        '      '#39'AVULSA'#39
        '  end tipo,'
        '  case when l.cod_localidade is not null then l.localidade'
        '       when s.cod_setor is not null then s.setor'
        '       when c.cod_cidade is not null then c.nome_cidade'
        '    else'
        '      pm.descr_promocao'
        '  end detalhe,'
        
          '  pr.grupo_prod,  pr.cod_prod, pr.descr_prod, pr.prec_cusm_prod,' +
          ' pr.prec_tab_prod,'
        
          '  pp.cod_localidade, pp.cod_setor, pp.cod_cidade, pp.porcentagem' +
          ','
        '  case'
        
          '    when (coalesce(pp.valor_promocao, 0) = 0) and (pp.cod_tpprec' +
          'o = 1) and (pp.porcentagem <> 0) then'
        '      pr.prec_tab_prod * (1 - abs(pp.porcentagem) / 100)'
        '    else pp.valor_promocao'
        '  end valor_promocao, pp.PROPORCAO_TABELA, pp.markup'
        '  from promocao_produto pp'
        
          '  inner join promocao  pm on pm.cod_promocao = pp.cod_promocao a' +
          'nd pm.cod_tppreco = pp.cod_tppreco and pm.cod_empresa = pp.cod_e' +
          'mpresa'
        
          '  inner join produtos pr on pr.grupo_prod = pp.grupo_prod and pr' +
          '.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa'
        
          '  left join localidade l on l.cod_localidade = pp.cod_localidade' +
          ' and l.cod_empresa = pp.cod_empresa'
        
          '  left join setor s on s.cod_setor = pp.cod_setor and s.cod_empr' +
          'esa = pp.cod_empresa'
        
          '  left join cidades c on c.cod_cidade = pp.cod_cidade and c.cod_' +
          'cidade > 0'
        '  where pm.ativo = 1'
        ') as q'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter procedure SP_HANDLE_HIST_PRECO ('
        '    NEW_PRECO T_VL_TODOS,'
        '    OLD_PRECO T_VL_TODOS,'
        '    NEW_CUSTO T_VL_TODOS,'
        '    OLD_CUSTO T_VL_TODOS,'
        '    QUANTIDADE T_VL_TODOS,'
        '    TABELA_ID varchar(36),'
        '    EMPRESA_ID integer,'
        '    GRUPO_PROD integer,'
        '    COD_PROD char(6))'
        'as'
        '  declare variable PRECO T_VL_TODOS;'
        '  declare variable USUARIO varchar(32);'
        'begin'
        '  preco = null;'
        '  new_preco = coalesce(new_preco, 0);'
        '  old_preco = coalesce(old_preco, 0);'
        '  new_custo = coalesce(new_custo, 0);'
        '  old_custo = coalesce(old_custo, 0);'
        ''
        '  -- alteracao direta no preco'
        '  if (round(old_preco, 2) <> round(new_preco, 2)) then'
        '    preco = new_preco;'
        ''
        '  -- alteracao do custo'
        '  if (new_custo > 0) then'
        '    if (round(old_custo, 2) <> round(new_custo, 2)) then'
        '      if ((old_preco > 0) or (new_preco > 0))  then'
        '        preco = new_preco;'
        ''
        '  -- preco alterado ou zerou o preco e havia preco anterior'
        '  if ((preco is not null) or'
        
          '     ((tabela_id in ('#39'ATACADO'#39', '#39'30_DIAS'#39', '#39'60_DIAS'#39', '#39'90_DIAS'#39',' +
          ' '#39'PROMOCAO'#39')) and (old_preco > 0) and (new_preco <= 0))) then'
        '  begin'
        
          '    select substring(coalesce(RDB$GET_CONTEXT('#39'USER_SESSION'#39', '#39'U' +
          'SERNAME'#39'), '#39#39') from 1 for 32) from RDB$DATABASE'
        '      into :usuario;'
        ''
        
          '    insert into PRODUTOS_HISTORICO_PRECO(id, cod_empresa, data, ' +
          ' grupo_prod, cod_prod, tabela_id, custo, preco, quantidade, usua' +
          'rio)'
        
          '    values ((select guid from SPDB_GUID), :empresa_id, (select c' +
          'urrent_ts from sp_current_ts(:empresa_id)),'
        
          '            :grupo_prod,  :cod_prod, :tabela_id, :new_custo, :ne' +
          'w_preco, :quantidade, trim(:usuario));'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger PRODUTOS_BU_CALC_DIF_MKT for PRODUTOS'
        'active after update position 9'
        'as'
        '  declare variable DIG integer;'
        'begin'
        ''
        '  if (coalesce(new.PREC_CUSM_PROD, 0) > 0) then'
        
          '    if (round(coalesce(old.PREC_CUSM_PROD, 0), 2) <> round(coale' +
          'sce(new.PREC_CUSM_PROD, 0), 2)) then'
        '    begin'
        '      select CASAS_DECIMAIS'
        '      from EMPRESA'
        '      where COD_EMPRESA = new.COD_EMPRESA'
        '        into :DIG;'
        ''
        '      DIG = iif(coalesce(DIG, 0) <= 0, 2, DIG);'
        '      DIG = iif(DIG > 10, 3, DIG);'
        ''
        '      update PROMOCAO_PRODUTO PP'
        
          '      set PP.VALOR_PROMOCAO = round(new.PREC_CUSM_PROD * (1 + (P' +
          'P.MARKUP / 100)), :DIG),'
        '          PP.PORCENTAGEM = 0'
        '      where PP.GRUPO_PROD = new.GRUPO_PROD and'
        '            PP.COD_PROD = new.COD_PROD and'
        '            PP.COD_EMPRESA = new.COD_EMPRESA and'
        '            coalesce(PP.MARKUP, 0) > 0;'
        '    end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger PROMOCAO_PRODUTO_BU_CALC_MKT for PROMOCA' +
          'O_PRODUTO'
        'active before insert or update position 9'
        'as'
        '  declare variable CUSTO T_VL_TODOS;'
        '  declare variable PRECO T_VL_TODOS;'
        '  declare variable DIG integer;'
        'begin'
        ''
        '  if (round(coalesce(new.MARKUP, 0), 2) > 0) then'
        '  begin'
        ''
        '    select P.PREC_CUSM_PROD, E.CASAS_DECIMAIS'
        '    from PRODUTOS P'
        '      inner join EMPRESA E on E.COD_EMPRESA = P.COD_EMPRESA'
        '    where P.GRUPO_PROD = new.GRUPO_PROD and'
        '          P.COD_PROD = new.COD_PROD and'
        '          P.COD_EMPRESA = new.COD_EMPRESA'
        '      into :CUSTO, :DIG;'
        ''
        '    if (coalesce(CUSTO, 0) <= 0) then'
        '      exit;'
        ''
        '    DIG = iif(coalesce(DIG, 0) <= 0, 2, DIG);'
        '    DIG = iif(DIG > 10, 3, DIG);'
        '    PRECO = round(CUSTO * (1 + (new.MARKUP / 100)), :DIG);'
        ''
        '    if (abs(new.VALOR_PROMOCAO - PRECO) > 0.01) then'
        '      new.VALOR_PROMOCAO = PRECO;'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger TI_PROM_PROD_BI_PROPORC_PREC for PROMOCA' +
          'O_PRODUTO'
        'active before insert or update position 0'
        'as'
        '  declare variable VPREC_TAB_PROD T_VL_TODOS;'
        '  declare variable VPREC_CUSM_PROD T_VL_TODOS;'
        'begin'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) and (coalesce(new.' +
          'MARKUP, 0) > 0)) then'
        '    new.PROPORCAO_TABELA = 0;'
        ''
        '  else'
        '  if ((coalesce(new.PROPORCAO_TABELA, 0) <= 0) and'
        '      (coalesce(new.VALOR_PROMOCAO, 0) > 0) and'
        '      (coalesce(new.COD_TPPRECO, 0) > 1)) then'
        '  begin'
        '    select PREC_CUSM_PROD, PREC_TAB_PROD'
        '    from PRODUTOS'
        '    where GRUPO_PROD = new.GRUPO_PROD and'
        '          COD_PROD = new.COD_PROD and'
        '          COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_CUSM_PROD, :VPREC_TAB_PROD;'
        ''
        '    if (coalesce(VPREC_TAB_PROD, 0) > 0.1) then'
        '    begin'
        
          '      if (coalesce(VPREC_CUSM_PROD, 0) >= coalesce(VPREC_TAB_PRO' +
          'D, 0)) then'
        '        new.PROPORCAO_TABELA = 0;'
        '      else'
        '      begin'
        '        if (coalesce(VPREC_TAB_PROD, 0) > 0) then'
        
          '          new.PROPORCAO_TABELA = new.VALOR_PROMOCAO / VPREC_TAB_' +
          'PROD;'
        '        else'
        '          new.PROPORCAO_TABELA = 0;'
        '      end'
        '    end'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'CREATE OR ALTER TRIGGER TI_PROM_PROD_PPRECO FOR PROMOCAO_PRODUTO'
        'ACTIVE BEFORE INSERT OR UPDATE POSITION 1'
        'AS'
        '  DECLARE VARIABLE VRECALCULAR_PRECOS INTEGER;'
        '  DECLARE VARIABLE VCASAS_DECIMAIS INTEGER;  '
        '  DECLARE VARIABLE VPREC_TAB_PROD T_VL_TODOS;  '
        'begin'
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) and (coalesce(new.' +
          'MARKUP, 0) > 0)) then'
        '    new.PROPORCAO_TABELA = 0;'
        #9
        
          '  if ((COALESCE(new.PROPORCAO_TABELA, 0) > 0) AND (COALESCE(new.' +
          'COD_TPPRECO, 0) > 1)) then'
        '  begin'
        '    SELECT COALESCE(VALUE1_F, 0) FROM CONFIG_SISTEMA'
        '    WHERE CHAVE = '#39'prod_cad_recalcular_preco_diferenciado'#39
        '    AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VRECALCULAR_PRECOS;'
        ''
        
          '    if ((COALESCE(new.VALOR_PROMOCAO, 0) > 0) and (COALESCE(VREC' +
          'ALCULAR_PRECOS, 0) <= 0)) then'
        '      exit;'
        ''
        '    SELECT CASAS_DECIMAIS FROM EMPRESA'
        '    WHERE COD_EMPRESA = new.COD_EMPRESA'
        '      into :VCASAS_DECIMAIS;           '
        ''
        '    VCASAS_DECIMAIS = COALESCE(VCASAS_DECIMAIS, 0);'
        '    if (COALESCE(VCASAS_DECIMAIS, 0) <= 0) then'
        '      VCASAS_DECIMAIS = 2;'
        ''
        '    SELECT PREC_TAB_PROD FROM PRODUTOS'
        
          '    WHERE GRUPO_PROD = new.GRUPO_PROD AND COD_PROD = new.COD_PRO' +
          'D AND COD_EMPRESA = new.COD_EMPRESA'
        '      into :VPREC_TAB_PROD;'
        ''
        '    if (COALESCE(new.PROPORCAO_TABELA, 0) > 0) then'
        
          '      if (COALESCE(new.VALOR_PROMOCAO, 0) <> ROUND((new.PROPORCA' +
          'O_TABELA * VPREC_TAB_PROD), VCASAS_DECIMAIS)) then'
        '        if (COALESCE(VPREC_TAB_PROD, 0) <= 0.1) then'
        '          new.VALOR_PROMOCAO = 0;'
        '        else'
        
          '          new.VALOR_PROMOCAO = ROUND((new.PROPORCAO_TABELA * VPR' +
          'EC_TAB_PROD), :VCASAS_DECIMAIS);'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        'create or alter trigger PRODUTOS_BIU_HIST_PRECO for PRODUTOS'
        'active after insert or update position 10'
        'as'
        '  declare variable perc t_vl_todos;'
        '  declare variable preco t_vl_todos;'
        '  declare variable qtde t_vl_todos;'
        '  declare variable tabela_id char(36);'
        'begin'
        ''
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.prec_tab_prod, old.prec_tab_prod, new' +
          '.prec_cusm_prod, old.prec_cusm_prod, 0, '#39'VAREJO'#39', new.cod_empres' +
          'a, new.grupo_prod, new.cod_prod);'
        '                   '
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.prec_publico, old.prec_publico, new.p' +
          'rec_cusm_prod, old.prec_cusm_prod, 0, '#39'ATACADO'#39', new.cod_empresa' +
          ', new.grupo_prod, new.cod_prod);'
        '                   '
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.prec_30_prod, old.prec_30_prod, new.p' +
          'rec_cusm_prod, old.prec_cusm_prod, 0, '#39'30_DIAS'#39', new.cod_empresa' +
          ', new.grupo_prod, new.cod_prod);'
        '                   '
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.prec_60_prod, old.prec_60_prod, new.p' +
          'rec_cusm_prod, old.prec_cusm_prod, 0, '#39'60_DIAS'#39', new.cod_empresa' +
          ', new.grupo_prod, new.cod_prod);'
        '                   '
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.prec_90_prod, old.prec_90_prod, new.p' +
          'rec_cusm_prod, old.prec_cusm_prod, 0, '#39'90_DIAS'#39', new.cod_empresa' +
          ', new.grupo_prod, new.cod_prod);'
        '                   '
        '  EXECUTE PROCEDURE'
        
          '  sp_handle_hist_preco(new.preco_promocao, old.preco_promocao, n' +
          'ew.prec_cusm_prod, old.prec_cusm_prod, 0, '#39'PROMOCAO'#39', new.cod_em' +
          'presa, new.grupo_prod, new.cod_prod);'
        ''
        '  if (coalesce(new.prec_cusm_prod, 0) > 0) then'
        
          '    if (round(coalesce(old.prec_cusm_prod, 0), 2) <> round(coale' +
          'sce(new.prec_cusm_prod, 0), 2)) then'
        '    begin'
        ''
        
          '      update promocao_produto set guidt = (select guid from spdb' +
          '_guid)'
        
          '        where grupo_prod = new.grupo_prod and cod_prod = new.cod' +
          '_prod and cod_empresa = new.cod_empresa and guidt is null;'
        '      '
        
          '      for select pp.porcentagem, pp.valor_promocao, pp.guidt fro' +
          'm promocao_produto pp'
        
          '            where grupo_prod = new.grupo_prod and cod_prod = new' +
          '.cod_prod and cod_empresa = new.cod_empresa and guidt is not nul' +
          'l'
        '            into :perc, :preco, :tabela_id'
        '      do'
        '      begin'
        '        preco = coalesce(preco, 0);'
        '        perc = coalesce(perc, 0);'
        
          '        if ((preco = 0) and (perc > 0) and (coalesce(new.prec_ta' +
          'b_prod, 0) > 0)) then'
        
          '          preco = coalesce(new.prec_tab_prod, 0) * (1 - (perc / ' +
          '100));'
        ''
        '        if (preco > 0) then   '
        '          EXECUTE PROCEDURE'
        
          '          sp_handle_hist_preco(:preco, :preco, coalesce(new.prec' +
          '_cusm_prod, 0), 0, 0, :tabela_id, new.cod_empresa, new.grupo_pro' +
          'd, new.cod_prod);'
        ''
        '      end'
        ''
        
          '      update preco_produtos_qtde set guidt = (select guid from s' +
          'pdb_guid)'
        
          '        where grupo_prod = new.grupo_prod and cod_prod = new.cod' +
          '_prod and cod_empresa = new.cod_empresa and guidt is null;'
        ''
        
          '      for select pq.quant, pq.preco_venda, pq.guidt from preco_p' +
          'rodutos_qtde pq'
        
          '            where grupo_prod = new.grupo_prod and cod_prod = new' +
          '.cod_prod and cod_empresa = new.cod_empresa and guidt is not nul' +
          'l'
        '            into :qtde, :preco, :tabela_id'
        '      do'
        '      begin'
        '        preco = coalesce(preco, 0);'
        '        qtde = coalesce(qtde, 0);'
        ''
        '        if (preco > 0) then   '
        '          EXECUTE PROCEDURE'
        
          '          sp_handle_hist_preco(:preco, :preco, coalesce(new.prec' +
          '_cusm_prod, 0), 0, :qtde, :tabela_id, new.cod_empresa, new.grupo' +
          '_prod, new.cod_prod);'
        '      end'
        '    end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger PROMOCAO_PRODUTO_BIU_HIST_PREC for PROMO' +
          'CAO_PRODUTO'
        'active before insert or update or delete position 10'
        'as'
        '  declare variable perc t_vl_todos;'
        '  declare variable preco t_vl_todos;'
        '  declare variable custo t_vl_todos;'
        '  declare variable preco_produto t_vl_todos;'
        'begin'
        ''
        '  if (deleting) then'
        '  begin'
        '    if (coalesce(old.guidt, '#39#39') <> '#39#39') then'
        '    begin'
        ''
        '      update PRODUTOS_HISTORICO_PRECO'
        '      set DESCRICAO = (select tp.detalhe || '#39' - '#39' || tp.tipo'
        '                       from vw_tabela_precos tp'
        
          '                       where tp.grupo_prod = old.grupo_prod and ' +
          'tp.cod_prod = old.cod_prod and tp.cod_empresa = old.cod_empresa ' +
          'and'
        
          '                             tp.cod_promocao = old.cod_promocao ' +
          'and'
        
          '                             tp.cod_localidade = old.cod_localid' +
          'ade and tp.cod_setor = old.cod_setor and tp.cod_cidade = old.cod' +
          '_cidade)'
        '      where tabela_id = old.guidt and'
        
          '            grupo_prod = old.grupo_prod and cod_prod = old.cod_p' +
          'rod and cod_empresa = old.cod_empresa;'
        '    end'
        ''
        '    exit;'
        '  end'
        ''
        
          '  if ((round(coalesce(old.valor_promocao, 0), 2) <> round(coales' +
          'ce(new.valor_promocao, 0), 2))'
        
          '   or (round(coalesce(old.porcentagem, 0), 2) <> round(coalesce(' +
          'new.porcentagem, 0), 2)))  then'
        '  begin'
        '    preco = coalesce(new.valor_promocao, 0);'
        '    perc = coalesce(new.porcentagem, 0);'
        ''
        
          '    select prec_tab_prod, prec_cusm_prod from produtos where gru' +
          'po_prod = new.grupo_prod and cod_prod = new.cod_prod and cod_emp' +
          'resa = new.cod_empresa'
        '      into :preco_produto, :custo;'
        ''
        
          '    if ((preco = 0) and (perc > 0) and (coalesce(preco_produto, ' +
          '0) > 0)) then'
        '      preco = coalesce(preco_produto, 0) * (1 - (perc / 100));'
        '  '
        '    if (coalesce(new.guidt, '#39#39') = '#39#39') then'
        '      new.guidt = (select guid from spdb_guid);'
        '  '
        '    EXECUTE PROCEDURE'
        
          '    sp_handle_hist_preco(preco, 0, :custo, 0, 0, new.guidt, new.' +
          'cod_empresa, new.grupo_prod, new.cod_prod);'
        '  end'
        'end'
        '|/BLOCO|'
        ''
        '|BLOCO|'
        
          'create or alter trigger PRECO_PRODUTOS_QTDE_BIU_HIST_PR for PREC' +
          'O_PRODUTOS_QTDE'
        'active before insert or update position 10'
        'AS'
        '  declare variable custo t_vl_todos;'
        'begin'
        
          '  if (round(coalesce(old.preco_venda, 0), 2) <> round(coalesce(n' +
          'ew.preco_venda, 0), 2)) then'
        '  begin'
        
          '    select prec_cusm_prod from produtos where grupo_prod = new.g' +
          'rupo_prod and cod_prod = new.cod_prod and cod_empresa = new.cod_' +
          'empresa'
