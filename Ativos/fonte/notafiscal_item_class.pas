{ TNotafiscal_item_classList }

function TNotafiscal_item_classList.GetItem(Index: Integer): TNotafiscal_item_class;
begin
  Result := TNotafiscal_item_class(inherited Items[Index]);
end;

function TNotafiscal_item_classList.New: TNotafiscal_item_class;
begin
  Result := TNotafiscal_item_class.Create;
  Add(Result);
end;

procedure TNotafiscal_item_classList.SetItem(Index: Integer; const Value: TNotafiscal_item_class);
begin
  Put(Index, Value);
end;

procedure TNotafiscal_item_classList.SetValuesFrom(ADataSet: TDataSet; AcheckFields: Boolean);
begin
  ADataSet.First;
  while not ADataSet.Eof do
  begin
    Self.New.SetValuesFrom(ADataSet, AcheckFields);
    ADataSet.Next;
  end;
end;

end.

