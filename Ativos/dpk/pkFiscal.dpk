  opfiscal_model in '..\fonte\opfiscal_model.pas',
  faturamento_hw_class in '..\fonte\faturamento_hw_class.pas',
  efd_ajustes in '..\fonte\efd_ajustes.pas',
  gs1prefix in '..\fonte\gs1prefix.pas',
  hw_pedido_cliente in '..\fonte\hw_pedido_cliente.pas',
  TributosDFeInMemoryHandler in '..\fonte\Fiscal\TributosDFe\TributosDFeInMemoryHandler.pas',
  TributosDFePersistentHandler in '..\fonte\Fiscal\TributosDFe\TributosDFePersistentHandler.pas',
  ConfigGlobalNF_RTC in '..\fonte\Fiscal\TributosDFe\ConfigGlobalNF_RTC.pas',
  CallerNFSeFeaturesUnit in '..\fonte\DLLNFe\CallerNFSeFeaturesUnit.pas',
  DFeEnums in '..\fonte\Fiscal\Tipos\DFeEnums.pas',
  DFeNTManageUnit in '..\fonte\Fiscal\Utils\DFeNTManageUnit.pas',
  AlertasDFeUtils in '..\fonte\Fiscal\Utils\AlertasDFeUtils.pas',
  CriadorCompraGovernamentalUtilsUnit in '..\fonte\Fiscal\Utils\CriadorCompraGovernamentalUtilsUnit.pas';

