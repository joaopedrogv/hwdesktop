package PkFormularios;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}
{%File 'PkFormularios_INFO.txt'}

requires
  dbrtl,
  dsnap,
  vcldb,
  ibxpress,
  vcljpg,
  VclSmp,
  pkEditMoeda;

contains
  uCadPadrao in '..\uCadPadrao.pas' {frmCadPadrao},
  UFormPadrao in '..\UFormPadrao.pas' {frmInc},
  uPadrao in '..\uPadrao.pas' {frmPadrao},
  uCadPadraoModal in '..\uCadPadraoModal.pas' {frmCadPadraoM},
  uColunasExcel in '..\uColunasExcel.pas' {frmColunasExcel},
  uExportPadrao in '..\uExportPadrao.pas';

end.
