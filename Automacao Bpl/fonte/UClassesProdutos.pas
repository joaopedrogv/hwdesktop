function TProdutosPerfilTribAdicional._abreTodos: Boolean;
begin
  Result := montaSelect('select * from PRODUTOS_TRIB_PF' +
    ' where COD_EMPRESA = ' + vDadosIni.codEmpresa + ' and ativo = 1');
end;

procedure TProdutosPerfilTribAdicional._cadPerfilTribAdicional(pTipoForm: integer);
begin
  try
    vDadosIni.abreStatusProcessamento('','Abrindo Cadastro de Perfil de Tributação Adicional');
    if dtmProdutos = nil then
      dtmProdutos := TdtmProdutos.Create(dtmProdutos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('PRO271', 'CONSULTA', '', 'PRODUTOS_TRIB_PF', '',
      dtmProdutos.qrBuscasP, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadPerfTribAd = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadPerfTribAd, frmCadPerfTribAd);
    end;

    if (pTipoForm > 0) and (not frmCadPerfTribAd.Visible) then
    	frmCadPerfTribAd.ShowModal
    else if (not frmCadPerfTribAd.Visible) then
    	frmCadPerfTribAd.Show
    else if frmCadPerfTribAd.FormStyle = fsMDIChild then
      frmCadPerfTribAd.Show
    else
      frmCadPerfTribAd.ShowModal;
  finally
   	vDadosIni.fechaStatusProcessamento;
  end;
end;

function TProdutosPerfilTribAdicional._lixeiraVazia: Boolean;
begin
  Result := not ExecutaComandosSql('Select first 1 COD_TRIB_PF from PRODUTOS_TRIB_PF' +
    ' where COD_TRIB_PF > 0 and ativo = 0 and cod_empresa = ' + vDadosIni.codEmpresa );
end;

function TProdutosPerfilTribAdicional._restaurarRegistroDaLixeira: Boolean;
begin
  if dataSet.IsEmpty then
    Exit;

  if dataSet.FieldByName('ativo').asInteger = 1 then
    Exit;

  if not vDadosIni.PesqPros('PRO276', 'RESTAURAR', 'COD PERF TRIB AD ' + dataSet.FieldByName('COD_TRIB_PF').AsString, 'PRODUTOS_TRIB_PF',
    dataSet.FieldByName('COD_TRIB_PF').AsString, buscas, True) then
    exit;

  if Application.MessageBox('Tem certeza que deseja restaurar este registro da Lixeira?',
    'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
    Exit;

  dataSet.Edit;
  dataSet.FieldByName('Ativo').asString := '1';
  result := inherited Post;
  if Apply then
  begin
    CommitaTransacao;
    vDadosIni.GravaAuditoria('PRO276', 'RESTAURAR', 'SUCESSO', 'PRODUTOS_TRIB_PF', dataSet.FieldByName('COD_TRIB_PF').AsString, buscas);
  end
  else
  begin
    RollBackTransacao;
    vDadosIni.GravaAuditoria('PRO276', 'RESTAURAR', 'FALHA', 'PRODUTOS_TRIB_PF', dataSet.FieldByName('COD_TRIB_PF').AsString, buscas);
  end;
  Result := true;
  Refresh;
end;

function TProdutosPerfilTribAdicional._verLixeira: Boolean;
begin
  if not vDadosIni.PesqPros('PRO278', 'VER LIXEIRA', '', 'PRODUTOS_TRIB_PF', '', buscas, true) then
    Exit;

  if _lixeiraVazia then
    Exit;

  montaSelect('select * from PRODUTOS_TRIB_PF' +
      ' where COD_EMPRESA = ' + vDadosIni.codEmpresa + ' and ativo = 0');
  Result := not dataSet.IsEmpty;
end;

{ TProdutosAlteracaoSPED0205 }

function TProdutosAlteracaoSPED0205.abreRegistros(pGrupo: Integer; pCodProd: string; pQuery: TIBQuery): Boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO284', 'VISUALIZAR', '', 'PRODUTOS_ALTERACOES', IntToStr(pGrupo) + '-' + pCodProd, vQrProcesso, True) then
    Exit;

  pQuery.Close;
  pQuery.SQL.Text :=
    'select p.seqid "ID", p.data_ini "Data Inicial Uso", p.data_alteracao "Data Final Uso", p.tipo_alt "Tipo Alt", MOV_SPED "Mes Sped",' +
    ' p.valor_anterior "Codigo", p.descr_prod_anterior "Descricao" from produtos_alteracoes p' +
    ' where p.grupo_prod = :grupo_prod and p.cod_prod = :cod_prod and p.cod_empresa = :cod_empresa' +
    ' order by p.data_alteracao';
  pQuery.ParamByName('grupo_prod').AsInteger := pGrupo;
  pQuery.ParamByName('cod_prod').AsString := pCodProd;
  pQuery.ParamByName('cod_empresa').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
  pQuery.Open;
  Result := True;
  fID := pQuery.FieldByName('id').AsInteger;
  fGRUPO_PROD := pGrupo;
  fCOD_PROD := pCodProd;
  Result := True;
end;

function TProdutosAlteracaoSPED0205.alterarRegistro(pQuery: TIBQuery): Boolean;
var
  vStringAudit: string;
begin
  Result := False;
  try

    if fID = 0 then
      raise exception.Create('Registro não selecionado ou sem dados');
    if StrToIntDef(fGrupo, 0) <= 0 then
      raise exception.Create('Grupo do produto não informado ou inválido');
    if StrToIntDef(Trim(fCodigo), 0) = 0 then
      raise exception.Create('Código do produto não informado ou inválido');
    if Trim(fDescricao) = '' then
      raise exception.Create('Decsrição do produto não informada');
    if Trim(fTipoAlt) = '' then
      raise exception.Create('Tipo de alteração do produto não informada');
    if fDataIni > fDataFim then
      raise exception.Create('Data inicial de uso não pode ser maior que a data final de uso');
    if (fDataIni = 0) or (fDataFim = 0) then
      raise exception.Create('Data inicial de uso ou data final inválida');

    pQuery.Close;
    pQuery.SQL.Text := 'select seqid from produtos_alteracoes' +
      ' where seqid <> ' + IntToStr(fID) +
      ' and grupo_prod = :grupo_prod' +
      ' and cod_prod = :cod_prod' +
      ' and cod_empresa =  ' + vDadosIni.codEmpresa +
      ' and ((data_alteracao >= :dataIni and data_alteracao <= :dataFim)' +
      ' or (data_ini >= :dataIni and data_ini <= :dataFim))';
    pQuery.ParamByName('dataIni').AsDate := DataIni;
    pQuery.ParamByName('dataFim').AsDate := DataFim;
    pQuery.ParamByName('grupo_prod').AsInteger := fGRUPO_PROD;
    pQuery.ParamByName('cod_prod').AsString := fCOD_PROD;
    pQuery.Open;
    if not pQuery.IsEmpty then
      raise exception.Create('Datas informadas estão em um intervalo que ja existe registro de alteração');

    pQuery.Close;
    pQuery.SQL.Text := 'update produtos_alteracoes set' +
      ' tipo_alt = :tipo_alt' +
      ', valor_anterior = :valor_anterior' +
      ', descr_prod_anterior = :descr_prod_anterior' +
      ', DATA_INI = :DATA_INI' +
      ', DATA_ALTERACAO = :DATA_ALTERACAO' +
      ', MOV_SPED = :MOV_SPED' +
      ' where seqid = :seqid' +
      ' and grupo_prod = :grupo_prod' +
      ' and cod_prod = :cod_prod' +
      ' and cod_empresa =  ' + vDadosIni.codEmpresa;
    pQuery.ParamByName('seqid').AsInteger := fID;
    pQuery.ParamByName('grupo_prod').AsInteger := fGRUPO_PROD;
    pQuery.ParamByName('cod_prod').AsString := fCOD_PROD;
    pQuery.ParamByName('tipo_alt').AsString := fTipoAlt;
    pQuery.ParamByName('valor_anterior').AsString := fGrupo + '|' + fCodigo + '|';
    pQuery.ParamByName('data_ini').AsDate := fDataIni;
    pQuery.ParamByName('data_alteracao').AsDate := fDataFim;
    pQuery.ParamByName('descr_prod_anterior').AsString := Copy(fDescricao, 1, 75);
    if StrToDateDef('01/' + fMesSped, 0) > 0 then
      pQuery.ParamByName('mov_sped').AsString := fMesSped
    else
      pQuery.ParamByName('mov_sped').Value := Null;
    pQuery.ExecSQL;

    vStringAudit := 'SUCESSO - ' +
      IntToStr(fID) + '|' +
      fGrupo + '|' + fCodigo + '|' +
      DateToStr(fDataIni) + '|' +
      DateToStr(fDataFim) + '|' +
      fTipoAlt + '|' +
      fMesSped + '|' +
      fDescricao + '|';

    if pQuery.Transaction.InTransaction then
      pQuery.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO286', 'INCLUIR', vStringAudit,
      'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);

    Result := True;
  except
    on e: Exception do
    begin
      pQuery.Transaction.Rollback;
      vDadosIni.GravaAuditoria('PRO286', 'INCLUIR', 'FALHA',
        'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);
      Result := False;
      Application.MessageBox(PChar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

constructor TProdutosAlteracaoSPED0205.create;
begin
  fID := 0;
  fGRUPO_PROD := 0;
  fCOD_PROD := '';
  vQrProcesso := TIBQuery(dtmProdutos.qrBuscasCB);
end;

function TProdutosAlteracaoSPED0205.excluirRegistro(pQuery: TIBQuery): Boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO287', 'EXCLUIR',
    pQuery.FieldByName('id').AsString + '|' +
    pQuery.FieldByName('Codigo').AsString + '|' +
    pQuery.FieldByName('Data Inicial Uso').AsString + '|' +
    pQuery.FieldByName('Data Final Uso').AsString + '|' +
    pQuery.FieldByName('Tipo Alt').AsString + '|' +
    pQuery.FieldByName('Mes Sped').AsString + '|' +
    pQuery.FieldByName('Descricao').AsString + '|',
    'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso, True) then
    Exit;

  if Application.MessageBox('Deseja mesmo excluir o registro selecionado?', 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
    Exit;

  try
    fID := pQuery.FieldByName('id').AsInteger;
    vQrProcesso.Close;
    vQrProcesso.SQL.Text := 'delete from produtos_alteracoes' +
      ' where seqid = ' + IntToStr(fID) +
      ' and cod_empresa =  ' + vDadosIni.codEmpresa;
    vQrProcesso.ExecSQL;

    if vQrProcesso.Transaction.InTransaction then
      vQrProcesso.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO287', 'EXCLUIR', 'SUCESSO',
      'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);
    Result := True;
  except
    on e: Exception do
    begin
      vQrProcesso.Transaction.Rollback;
      vDadosIni.GravaAuditoria('PRO287', 'EXCLUIR', 'FALHA',
        'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);
      Result := False;
      Application.MessageBox(PChar('Erro a excluir registro. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TProdutosAlteracaoSPED0205.incluirRegistro(pQuery: TIBQuery): Boolean;
var
  vStringAudit: string;
begin
  Result := False;

  try
    if StrToIntDef(fGrupo, 0) <= 0 then
      raise exception.Create('Grupo do produto não informado ou inválido');
    if StrToIntDef(Trim(fCodigo), 0) = 0 then
      raise exception.Create('Código do produto não informado ou inválido');
    if Trim(fDescricao) = '' then
      raise exception.Create('Descrição do produto não informada');
    if Trim(fTipoAlt) = '' then
      raise exception.Create('Tipo de alteração do produto não informada');
    if fDataIni > fDataFim then
      raise exception.Create('Data inicial de uso não pode ser maior que a data final de uso');

    pQuery.Close;
    pQuery.SQL.Text := 'select seqid from produtos_alteracoes' +
      ' where seqid <> 0' +
      ' and grupo_prod = :grupo_prod' +
      ' and cod_prod = :cod_prod' +
      ' and cod_empresa =  ' + vDadosIni.codEmpresa +
      ' and ((data_alteracao >= :dataIni and data_alteracao <= :dataFim)' +
      ' or (data_ini >= :dataIni and data_ini <= :dataFim))';
    pQuery.ParamByName('dataIni').AsDate := DataIni;
    pQuery.ParamByName('dataFim').AsDate := DataFim;
    pQuery.ParamByName('grupo_prod').AsInteger := fGRUPO_PROD;
    pQuery.ParamByName('cod_prod').AsString := fCOD_PROD;
    pQuery.Open;
    if not pQuery.IsEmpty then
      raise exception.Create('Datas informadas estão em um intervalo que ja existe registro de alteração');

    pQuery.Close;
    pQuery.SQL.Text := 'select cod from incrementa_codigo(' + vDadosIni.codEmpresa + ', ''PRODUTOS_ALTERACOES'')';
    pQuery.Open;

    fID := pQuery.FieldByName('cod').AsInteger;

    pQuery.Close;
    pQuery.SQL.Text := 'insert into produtos_alteracoes' +
      ' (seqid, grupo_prod, cod_prod, cod_empresa, tipo_alt, valor_anterior, data_alteracao, data_ini, descr_prod_anterior, mov_sped)' +
      ' values ( :seqid, :grupo_prod, :cod_prod, :cod_empresa, :tipo_alt, :valor_anterior, :data_alteracao, :data_ini, :descr_prod_anterior, :mov_sped)';
    pQuery.ParamByName('seqid').AsInteger := fID;
    pQuery.ParamByName('grupo_prod').AsInteger := fGRUPO_PROD;
    pQuery.ParamByName('cod_prod').AsString := fCOD_PROD;
    pQuery.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    pQuery.ParamByName('tipo_alt').AsString := fTipoAlt;
    pQuery.ParamByName('valor_anterior').AsString := fGrupo + '|' + fCodigo + '|';
    pQuery.ParamByName('data_ini').AsDate := fDataIni;
    pQuery.ParamByName('data_alteracao').AsDate := fDataFim;
    pQuery.ParamByName('descr_prod_anterior').AsString := Copy(fDescricao, 1, 75);
    if StrToDateDef('01/' + fMesSped, 0) > 0 then
      pQuery.ParamByName('mov_sped').AsString := fMesSped
    else
      pQuery.ParamByName('mov_sped').Value := Null;
    pQuery.ExecSQL;

    vStringAudit := 'SUCESSO - ' +
      IntToStr(fID) + '|' +
      fGrupo + '|' + fCodigo + '|' +
      DateToStr(fDataIni) + '|' +
      DateToStr(fDataFim) + '|' +
      fTipoAlt + '|' +
      fMesSped + '|' +
      fDescricao + '|';

    if pQuery.Transaction.InTransaction then
      pQuery.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO285', 'INCLUIR', vStringAudit,
      'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);

    Result := True;
  except
    on e: Exception do
    begin
      fID := 0;
      pQuery.Transaction.Rollback;
      vDadosIni.GravaAuditoria('PRO285', 'INCLUIR', 'FALHA',
        'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso);
      Result := False;
      Application.MessageBox(PChar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TProdutosAlteracaoSPED0205.iniciarAlteracaoRegistro(pQuery: TIBQuery): Boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO286', 'ALTERAR',
    pQuery.FieldByName('id').AsString + '|' +
    pQuery.FieldByName('Codigo').AsString + '|' +
    pQuery.FieldByName('Data Inicial Uso').AsString + '|' +
    pQuery.FieldByName('Data Final Uso').AsString + '|' +
    pQuery.FieldByName('Tipo Alt').AsString + '|' +
    pQuery.FieldByName('Mes Sped').AsString + '|' +
    pQuery.FieldByName('Descricao').AsString + '|',
    'PRODUTOS_ALTERACOES', IntToStr(fGRUPO_PROD) + '-' + fCOD_PROD, vQrProcesso, True) then
    Exit;

  fID := pQuery.FieldByName('id').AsInteger;
  fGrupo := vDadosIni.getCampoPipe(pQuery.FieldByName('Codigo').AsString, 1);
  fCodigo := vDadosIni.getCampoPipe(pQuery.FieldByName('Codigo').AsString, 2);
  fDescricao := pQuery.FieldByName('Descricao').AsString;
  fDataIni := pQuery.FieldByName('Data Inicial Uso').AsDateTime;
  fDataFim := pQuery.FieldByName('Data Final Uso').AsDateTime;
  fTipoAlt := pQuery.FieldByName('Tipo Alt').AsString;
  fMesSped := pQuery.FieldByName('Mes Sped').AsString;
  Result := True;
end;

function TProdutosAlteracaoSPED0205.iniciarInclusaoRegistro(pQuery: TIBQuery): Boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO285', 'INCLUIR', '',
