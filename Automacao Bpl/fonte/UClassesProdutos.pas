function TImagemsProd.getFileNameWithOutPath(FileName: string): string;
begin
  // metodo para retornar o nome do arquivo antes de gravar no banco, sendo assim se o diretorio onde esta a imagem for o mesmo
  // do padrao entao o sistema salva sem o diretorio
  if fPathPadrao <> '' then
    if Copy(LowerCase(FileName), 1, Length(fPathPadrao)) = LowerCase(fPathPadrao) then
      Delete(FileName, 1, Length(fPathPadrao));
  Result := FileName;
end;

function TImagemsProd.getFileNameWithPath(FileName: string): string;
begin
  // metodo usado para retornar com o diretorio, as imagens salvas no diretorio padrao serao retornadas com o diretorio padrao + nome da imagem
  // assim que o produto setar os dados este metodo é chamado para retornar a classe de imagens com o diretorio padrao ja adicionado
  // caso as imagens esteja salvas la
  if fPathPadrao = '' then
    Result := FileName
  else if vDadosIni.strIn(Copy(FileName, 2, 1), ['\', ':']) then
    Result := FileName
  else
    Result := fPathPadrao + FileName;
end;

function TImagemsProd.GetListImg: TStrings;
var
  I: Integer;
begin
  // metodo que retorna a lista com o nome dos arquivos para salvar
  fListImg.Clear;

  if fPathPadrao = 'nopath' then
    raise Exception.Create('Path padrão não foi setado');

  for I := 0 to fImg.Count - 1 do
    fListImg.Add(getFileNameWithOutPath(fImg.Items[I].fileNameImagem));
  Result := fListImg;
end;

function TImagemsProd.GetListUrlImg: TStrings;
var
  I: Integer;
begin
  // metodo que retorna a lista com o nome dos arquivos para salvar
  fListUrlImg.Clear;

  if fPathPadrao = 'nopath' then
    raise Exception.Create('Path padrão não foi setado');

  for I := 0 to fImg.Count - 1 do
    fListUrlImg.Add(vDadosIni.IfThen(trim(fImg.Items[I].urlImagem) = '',
    	'sem url', trim(fImg.Items[I].urlImagem)));
  Result := fListUrlImg;
end;

procedure TImagemsProd.SetListImg(Value: string; pUrl: string);
var
  I: Integer;
begin
  // metodo que seta do cadastro do produto para as imagens logo que o registro do produto inicia o cadastro
  fListImg.Clear;
  fListUrlImg.Clear;
  fImg.Clear;

  if fPathPadrao = 'nopath' then
    raise Exception.Create('Path padrão não foi setado');

  fListImg.Text := Value;
  fListUrlImg.Text := pUrl;
  for I := 0 to fListImg.Count - 1 do
    with fImg.New do
    begin
      fileNameImagem := getFileNameWithPath(fListImg[I]);
	    if (I + 1 > fListUrlImg.Count) then
      	urlImagem := 'sem url'
      else if trim(fListUrlImg[I]) = '' then
      	urlImagem := 'sem url'
      else
	      urlImagem := fListUrlImg[I];
    end;
end;

procedure TImagemsProd.SetPathPadraoImagens(Path: string);
begin
  if Trim(Path) <> '' then
    fPathPadrao := IncludeTrailingPathDelimiter(Trim(Path))
  else
    fPathPadrao := '';
end;

