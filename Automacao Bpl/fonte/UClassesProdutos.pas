function TTipoServBox.existeExcecaoBox(cod_servico, cod_box: string): boolean;
begin
  buscas.Close;
  buscas.SQL.Clear;
  buscas.SQL.Add('select count(*) as qtReg from TIPO_SERVICO_BOX where COD_SERVICO= ' +
    cod_servico + ' and COD_BOX = ' + cod_box);
  buscas.Open;
  if buscas.FieldByName('qtreg').AsInteger > 0 then
    result := true
  else
    result := false;
end;

function TTipoServBox.insert: boolean;
begin
  if not dataSet.Active then
    montaSelect('select * from TIPO_SERVICO_BOX where 1 = 0');

  if inherited insert then
  begin
    dataSet.FieldByName('USUARIO_AUTORIZOU').AsString := vDadosIni.vNomeUsuario;
    dataSet.FieldByName('DATA_EXECAO').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    result := true;
  end;
end;

function TTipoServBox.post(cod_servico, cod_box: string): boolean;
begin
  try
    dataSet.FieldByName('COD_SERVICO').AsString := cod_servico;
    dataSet.FieldByName('COD_BOX').AsString := cod_box;

    if dataSet.FieldByName('COD_BOX').AsString = '' then
      raise exception.Create('Box não informado.');

    result := inherited post;

    if dataset.ChangeCount = 0 then
    begin
      result := true;
      exit;
    end;

    if apply then
      CommitaTransacao
    else begin
      dataset.Cancel;
      RollBackTransacao;
      result := false;
    end;
    dataSet.Refresh;
  except
    on e: Exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
  Refresh;
end;

