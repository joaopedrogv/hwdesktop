          'MODELOETITERMICA', dataSet.FieldByName('CODIGO').AsString, buscas);
    end;
  end;
end;

function TModeloEtiTermica.post: boolean;
var
  acao: string;
  codigoMax: Integer;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
    	acao := 'INCLUIR';

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição do modelo de etiqueta não informado', 'dbedit2');
    if trim(dataSet.FieldByName('LSCRIPT').AsString) = '' then
      raiseExceptionCreate('Linguagem de script de programação da impressora não informado',
        'dbcombobox3');
    if dataSet.FieldByName('NUMCOLUNAS').IsNull then
      raiseExceptionCreate('Número de colunas informado', 'dbedit6');
    if dataSet.FieldByName('NUMCOLUNAS').AsInteger = 0 then
      raiseExceptionCreate('Número de colunas deve ser maior que zero.', 'dbedit6');
    if trim(dataSet.FieldByName('CONFIGMODELOETI').AsString) = '' then
      raiseExceptionCreate('Configuração do modelo de etiqueta não informado', 'dbmemo1');
    if dataSet.State in [dsInsert] then
    begin
      dataSet.FieldByName('codigo').AsInteger := Gencodigo('MODELOETITERMICA', SpIncCod, vDadosIni.codEmpresa);

      buscas.Close;
      buscas.SQL.Text := ' select max(coalesce(codigo, 0)) codigo from modeloetitermica ' +
      	' where cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      codigoMax := buscas.FieldByName('codigo').AsInteger;

      if (codigoMax + 1 > dataSet.FieldByName('codigo').AsInteger) then
      	dataSet.FieldByName('codigo').AsInteger := codigoMax + 1;

      dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
      dataSet.FieldByName('ativo').AsInteger := 1;
    end;

    Result := inherited post;

    if result then
      Result := Apply;
    if result then
      Result := CommitaTransacao
    else RollBackTransacao;

    if result then
      vDadosIni.GravaAuditoria('PRO206', acao + ' TRANSAÇÃO CONFIRMADA', 'SUCESSO',
        'MODELOETITERMICA',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('PRO206', acao + ' TRANSAÇÃO NAO CONFIRMADA', 'FALHA',
        'MODELOETITERMICA',
        dataSet.FieldByName('CODIGO').AsString, buscas);
    if Result then
      Refresh;
  except
    on e: exception do
    begin
      Result := false; RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TModeloEtiTermica._RestaurarRegistro: boolean;
begin
  result := false;
  if not vDadosIni.PesqPros('PRO205', 'RESTAURAR', '', 'MODELOETITERMICA',
    dataSet.FieldByName('CODIGO').AsString, buscas, true) then
    exit;
  if dataSet.IsEmpty then
    exit;
  if dataSet.FieldByName('ATIVO').asinteger = 0 then
  begin
    if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
      'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      if inherited Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 1;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
        begin
          vDadosIni.GravaAuditoria('PRO205', 'RESTAURAR REGISTRO', 'SUCESSO', 'MODELOETITERMICA',
            dataSet.FieldByName('CODIGO').AsString, buscas);
          Refresh;
        end
        else
          vDadosIni.GravaAuditoria('PRO205', 'RESTAURAR REGISTRO', 'FALHA', 'MODELOETITERMICA',
            dataSet.FieldByName('CODIGO').AsString, buscas);
      end;
    end;
  end;
end;

