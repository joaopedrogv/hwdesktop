procedure TFichaInventario.ImprimirFichaInventarioComEtiquetaqrp(ApenasConsumo, OrdemAlfabetica:
  boolean; NumAlocacao: integer; Alocacao: string; vgri, vgrf: string; comGrade: boolean);
begin
  vitbal := 0;
  queryProd := TIBQuery(dtmProdutos.qrFichaInvBal);
  queryProd.Close;
  if comGrade then
    queryProd.SQL.Text :=
      'select pr.grupo_prod,pr.cod_prod,cast(0.00 as double precision) as est_r,case when grcomp.QTDE is null then pr.est_f else grcomp.qtde end as est_f, ' +
      'pr.descr_prod,pr.locacao_prod,pr.locacao_prod_1,pr.num_fab_prod,pr.unidade,' +
      'case when gra.cod_grade is null then 0 else gra.cod_grade end as cod_grade ' +
      'from PRODUTOS pr left join cod_grade_prod grcomp on ' +
      'pr.grupo_prod = grcomp.grupo_prod and pr.cod_prod = grcomp.cod_prod and pr.cod_empresa = grcomp.cod_empresa ' +
      'left join grade gra on grcomp.cod_grade = gra.cod_grade and grcomp.cod_empresa = gra.cod_empresa ' +
      ' where pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1'
  else
    queryProd.SQL.Text := 'select pr.GRUPO_PROD,pr.COD_PROD,pr.EST_R,pr.EST_F,' +
      ' pr.DESCR_PROD,pr.LOCACAO_PROD,pr.LOCACAO_PROD_1,pr.NUM_FAB_PROD, pr.UNIDADE,0 as cod_grade ' +
      ' from produtos pr ' +
      ' WHERE pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1';

  if ApenasConsumo then
    queryProd.SQL.Text := queryProd.SQL.Text + ' and PR.consumo = ''S'' '
  else
    queryProd.SQL.Text := queryProd.SQL.Text + ' and (coalesce(PR.consumo, ''N'') <> ''S'') ';

  if vgri <> '' then
    queryProd.SQL.Text := queryProd.SQL.Text + ' and pr.grupo_prod >= ' + vgri +
      ' and pr.grupo_prod <= ' + vgrf;

  if trim(Alocacao) <> '' then
  begin
    if NumAlocacao = 1 then
      queryProd.SQL.Text := queryProd.SQL.Text + ' and pr.locacao_prod like ''' + trim(Alocacao) +
        '%'' '
    else
      queryProd.SQL.Text := queryProd.SQL.Text + ' and pr.locacao_prod_1 like ''' + trim(Alocacao) +
        '%'' ';
  end;

  if OrdemAlfabetica then
    queryProd.SQL.Text := queryProd.SQL.Text + ' order by pr.locacao_prod,pr.descr_prod'
  else
    queryProd.SQL.Text := queryProd.SQL.Text +
      ' order by pr.locacao_prod,pr.grupo_prod,pr.cod_prod';

  queryProd.Prepare;
  queryProd.Open;
  FrmFichaInv.QRLabel10.Caption := vDadosIni.vEmp.vnomeEmpresa;
  FrmFichaInv.DetailBandFichaInv.BeforePrint := FichaInventarioBeforePrint;
  FrmFichaInv.qrpFichaInventario.AfterPreview := FichaInventarioSemEtiquetaAfterPreview;
  FrmFichaInv.qrpFichaInventario.Preview;
end;

