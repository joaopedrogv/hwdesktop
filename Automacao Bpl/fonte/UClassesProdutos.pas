function TProdutos.filtrarFichaProdutos(pReq, pOs, pOrc, pNota, pDev, pProd, pCorr,
   pBalD, pBalG, pExcCanReab, pAlterarEst, pNAlterarEst, pEstDia, pCupom, pNotaD,
   pNotaS, pNotaC, pConfirmados, pPendentes: boolean): boolean;
var
  vFilter: string;
 begin
   try
     try
       Result := true;

       vFilter := '';
       if not ((pReq) or (pOs) or (pOrc) or (pNota) or (pDev) or (pProd)
         or (pCorr) or (pBalD) or (pBalG) or (pExcCanReab)
         or (pAlterarEst) or (pNAlterarEst) or (pEstDia)
         or (pCupom) or (pNotaD) or (pNotaS) or (pNotaC)
         or (pConfirmados) or (pPendentes)) then
       begin
         cFichaC.Filtered := false;
         exit;
       end;

       if pEstDia then
         if not cdsEstoqueDiarioC.IsEmpty then
         begin
           if trim(vFilter) <> '' then
             vFilter := vFilter + ' and ';
           vFilter := vFilter + ' data_estoque = ' + QuotedStr(FormatDateTime('DD/MM/YYYY', cdsEstoqueDiarioC.FieldByName('data').AsDateTime));
         end;

//       if ((pAlterarEst) or (pNAlterarEst)) then
         if ((pReq) or (pOs) or (pOrc) or (pNota) or (pDev) or (pProd)
           or (pCorr) or (pBalD) or (pBalG) or (pExcCanReab) or (pCupom) or (pNotaD) or (pNotaS) or (pNotaC)) then
         begin
           if trim(vFilter) <> '' then
             vFilter := vFilter + ' and ';
           vFilter := vFilter + ' tipo2 in (';
           if pReq then
             vFilter := vFilter + ' ''REQ'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''REQX'', ';
           if pOs then
             vFilter := vFilter + ' ''OS'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''OSX'', ';
           if pOrc then
             vFilter := vFilter + ' ''ORC'', ';
           if pNota then
             vFilter := vFilter + ' ''NFE'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''NFEX'', ';
           if pDev then
             vFilter := vFilter + ' ''DEV'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''DEVX'', ';  
           if pProd then
             vFilter := vFilter + ' ''PDC'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''PDCX'', ';
           if pCorr then
             vFilter := vFilter + ' ''COR'', ';
           if pBalD then
             vFilter := vFilter + ' ''BALD'', ';
           if pBalG then
             vFilter := vFilter + ' ''BALG'', ';
           if pCupom then
             vFilter := vFilter + ' ''CP'', ';
           if pNotaD then
             vFilter := vFilter + ' ''NFD'', ';
           if pNotaS then
             vFilter := vFilter + ' ''NFS'', ';
           if pExcCanReab then
             vFilter := vFilter + ' ''NFSX'', ';
           if pNotaC then
             vFilter := vFilter + ' ''NFC'', ';
           vFilter := Copy(vFilter, 1, Length(vFilter) - 2) + ')';
         end;

       if ((pConfirmados) <> (pPendentes)) then
       begin
         if trim(vFilter) <> '' then
           vFilter := vFilter + ' and ';
         if pConfirmados then
           vFilter := vFilter + ' (status in (''FECHADO'', ''FECHADA'', '
         else if pPendentes then
           vFilter := vFilter + ' not (status in (''FECHADO'', ''FECHADA'', ';
         vFilter := Copy(vFilter, 1, Length(vFilter) - 2) + '))';  
       end;

       if ((pAlterarEst) or (pNAlterarEst)) then
       begin
         if trim(vFilter) <> '' then
           vFilter := vFilter + ' and ';
         vFilter := vFilter + ' altera_estoque in (';
         if pAlterarEst then
           vFilter := vFilter + ' ''S'', ';
         if pNAlterarEst then
           vFilter := vFilter + ' ''N'', ';
         vFilter := Copy(vFilter, 1, Length(vFilter) - 2) + ')';
       end;
       cFichaC.Filter := vFilter;
       cFichaC.Filtered := true;
     finally
       recalcularQtdeEntradaSaidaC;
     end;
   except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.filtrarFichaProdutos. Erro: ' + e.Message);
    end;
  end;
end;

