  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    result := montaSelect('SELECT * FROM COD_BARRA WHERE ativo=1' +
      ' and COD_EMPRESA=' + vDadosIni.codEmpresa);
