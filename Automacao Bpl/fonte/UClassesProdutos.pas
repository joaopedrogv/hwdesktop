      ' and COD_EMPRESA=' + vDadosIni.codEmpresa);
end;

function TCodBarras.BuscarGrade(CodGrade: Integer): Boolean;
begin
  Result := false;

  buscas.Close;
  buscas.SQL.Text := 'SELECT * FROM GRADE ' +
    ' WHERE COD_GRADE =' + IntToStr(CodGrade) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' AND ATIVO =1';
  buscas.Open;

  if (((CodGrade > 0) and (buscas.IsEmpty)) or (CodGrade < 0)) then
  begin
    Application.MessageBox('Grade não encontrada', 'Atenção', MB_ICONWARNING + MB_OK);
    exit;
  end;

  Result := true;

end;

function TCodBarras.ChecaCaracteresCodBarras(CodBarra: string): boolean;
var
  i: integer;
begin
  for i := 1 to length(CodBarra) do
    if (CodBarra[i] = '*') or
      (CodBarra[i] = 'x') or
      (CodBarra[i] = 'X') then
    begin
      Application.MessageBox('Código de barras não pode conter os ''*'' , ''x''  ou ''X'' .' +
        chr(13) + 'É necessário alterá-lo.', 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      result := true;
      exit;
    end;
end;

