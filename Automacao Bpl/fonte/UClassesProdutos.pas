function TProdutos.DefinirClassesProdutos(ProgressBar: TProgressBar;
  Panel: TPanel): boolean;
var
  totalA, totalB, totalC, somap, somaqt, somat: currency;
  totalX, totalY, totalZ: currency;
  totalPA, totalPB, totalPC: currency;
  totalP1, totalP2, totalP3: real;
  totalQ1, totalQ2, totalQ3: real;
  totalF1, totalF2, totalF3: real;
  qtdGeral: real;
  i, qtdItem: integer;
  qrProd: TIBQuery;
  Qrprodupdate: TIBQuery;
  ibtransprodup: TIBTransaction;
  vdataatual: Tdate;
begin
  result := true;
  Application.ProcessMessages;
  qrProd := TIBQuery(dtmProdutos.qrProd);
  Qrprodupdate := TIBQuery(dtmProdutos.QrprodUpdate);
  ibtransprodup := TIBTransaction(dtmProdutos.IbTrProdUpdate);
  vdataatual := vDadosIni.getDataBanco(buscas);
  somat := 0;
  CurvaABCVariaveis;
  buscas.Close;
  buscas.SQL.Text := 'select grupo_prod,cod_prod,sum(vtot_venda) as vtot_venda' +
    ' from vendasmeses4 where data_os_rq >= :vdata' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1' +
    ' group by grupo_prod,cod_prod order by 3 desc';
  buscas.ParamByName('vdata').AsDate := date - (QtdMesEmpresa * 30);
  buscas.Prepare;
  buscas.Open;
  ProgressBar.min := 0;
  ProgressBar.position := 0;
  buscas.Last;
  ProgressBar.max := buscas.RecordCount;
  Panel.caption := 'Somando Valor das vendas de produtos no(s) Último(s)' + inttostr(QtdMesEmpresa)
    + 'mês(es)';
  buscas.First;
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    somat := somat + buscas.FieldByName('vtot_venda').AsFloat;
    buscas.next;
    if Parar = 1 then
    begin
      if Application.MessageBox('Deseja Cancelar Processamento?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        break
      else
        Parar := 0;
    end;
    ProgressBar.Position := ProgressBar.Position + 1;
  end;
  if Parar = 1 then
  begin
    result := false;
    exit;
  end;

  // Produtos Classificação ''D''
  Panel.caption := 'Produtos Classificação. ''D''';
  qrProd.Close;
  qrProd.SQL.Text :=
    'select GRUPO_PROD,COD_PROD,EST_F,CLASSE_PROD from produtos where cod_empresa = ' +
    vDadosIni.codEmpresa;
  qrProd.Open;
  qrProd.FetchAll;
  //  abreProdutos;
  ProgressBar.min := 0;
  ProgressBar.max := qrProd.RecordCount;
  ProgressBar.position := 0;
  qrProd.first;
  while not qrProd.eof do
  begin
    Application.ProcessMessages;
//    if  (qrProd.FieldByName('GRUPO_PROD').AsInteger = 1) and
//    (trim(qrProd.FieldByName('COD_PROD').asstring) = '00105') then
//     ShowMessage('OK');

    buscas.Close;
    buscas.SQL.Text := 'select count(pp.grupo_prod) as qtdVendaProd from pedvenda_prod pp,pedvenda p ' +
      ' where pp.grupo_prod = ' + IntToStr(qrProd.FieldByName('GRUPO_PROD').AsInteger) +
      ' and pp.cod_prod = ' + quotedstr(qrProd.FieldByName('COD_PROD').AsString) +
      ' and pp.nped = p.nped and pp.tipo = p.tipo and p.data_fech >= :vdata' +
      ' and p.cod_empresa = pp.cod_empresa' +
      ' and ((pp.status is null) or (pp.status <> ''CANCELADO'')) ' +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1';
    buscas.ParamByName('vdata').AsDate := vdataatual - (QtdMesEmpresa * 30);
    buscas.Prepare;
    buscas.Open;
    if buscas.FieldByName('qtdVendaProd').AsInteger = 0 then
    begin
      buscas.Close;
      {      buscas.SQL.Text := 'select max(nf.data_lanc_nfe) as data_lanc_nfe' +
              ' from nf_entrada nf,item_nf_entrada it' +
              ' where it.grupo_prod = ' + qrProd.FieldByName('GRUPO_PROD').asstring +
              ' and it.cod_prod = ' + quotedstr(qrProd.FieldByName('COD_PROD').asstring) +
              ' and it.num_nota_nfe = nf.num_nota_nfe and it.cod_forn_nfe =nf.cod_forn_nfe' +
              ' and nf.cod_empresa = it.cod_empresa and ' +
              ' nf.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf.ativo=1';}
      buscas.SQL.Text := 'select max(data) as data_lanc_nfe from custos ' +
        ' where grupo_prod = ' + IntToStr(qrProd.FieldByName('GRUPO_PROD').AsInteger) +
        ' and cod_prod = ' + quotedstr(qrProd.FieldByName('COD_PROD').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo=1';
      buscas.Open;
      Qrprodupdate.SQL.text := 'update produtos set ' +
      	' CLATL = :CLATL,CLASSE_PROD = :CLASSE_PROD, ' +
        ' CLPOP = :CLPOP, CLFRV = :CLFRV, CLQTV = :CLQTV ' +
        ' WHERE GRUPO_PROD = ' + IntToStr(qrProd.FieldByName('GRUPO_PROD').AsInteger) +
        ' AND COD_PROD = ' + quotedstr(qrProd.FieldByName('COD_PROD').asstring) +
        ' AND COD_EMPRESA = ' +
        vDadosIni.codEmpresa;
      if buscas.isempty then
        Qrprodupdate.ParamByName('CLATL').AsString := 'T4'
      else
      begin
        if (vdataatual - buscas.FieldByName('DATA_LANC_NFE').AsDateTime) <= 360 then
          Qrprodupdate.ParamByName('CLATL').AsString := 'R'
        else
          Qrprodupdate.ParamByName('CLATL').AsString := 'T4';
      end;
      Qrprodupdate.ParamByName('CLASSE_PROD').AsString := 'D';
      Qrprodupdate.ParamByName('CLPOP').AsString := 'P4';
      Qrprodupdate.ParamByName('CLFRV').AsString := 'F4';
      if qrProd.FieldByName('EST_F').AsFloat > 0 then
        Qrprodupdate.ParamByName('CLQTV').AsString := 'Q4'
      else
        Qrprodupdate.ParamByName('CLQTV').AsString := '';
      Qrprodupdate.Prepare;
      Qrprodupdate.ExecSQL;
      ibtransprodup.Commit;
    end;
    qrProd.next;
    //    CommitaTransacao;
    if Parar = 1 then
    begin
      if Application.MessageBox('Deseja Cancelar Processamento?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        break
      else
        Parar := 0;
    end;
    ProgressBar.Position := ProgressBar.Position + 1;
    Panel.Caption := 'Produtos Classificação. ''D''  ' + vDadosIni.strzero(ProgressBar.Position,
      5);
  end;
  if Parar = 1 then
  begin
    result := false;
    exit;
  end;
  //  qrProd.Close;
  //  qrProd.SQL.Text := 'select * from produtos where cod_empresa = ' + vDadosIni.codEmpresa;
  //  qrProd.Open;
  qrProd.Close;
  qrProd.SQL.Text :=
    'select GRUPO_PROD,COD_PROD,EST_F,CLASSE_PROD from produtos where cod_empresa = ' +
    vDadosIni.codEmpresa;
  qrProd.Open;

  // Classes A,B,C
  buscas.Close;
  buscas.SQL.Text := 'select grupo_prod,cod_prod,sum(vtot_venda) as vtot_venda' +
    ' from vendasmeses4 where data_os_rq >= :vdata' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1' +
    ' group by grupo_prod,cod_prod order by 3 desc';
  buscas.ParamByName('vdata').AsDate := vdataatual - (QtdMesEmpresa * 30);
  buscas.Prepare;
  buscas.Open;
  ProgressBar.min := 0;
  ProgressBar.position := 0;
  buscas.FetchAll;
  ProgressBar.max := buscas.RecordCount;
  Panel.caption := 'Classificando Produtos: ''A'',''B'',''C''';
  buscas.First;
  totalA := ((somat * 70) / 100);
  totalB := ((somat * 20) / 100);
  somap := 0.00;
  i := 1;

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    begin
      Qrprodupdate.SQL.text := 'update produtos set CLASSE_PROD = :CLASSE_PROD ' +
        ' WHERE GRUPO_PROD = ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
        ' AND COD_PROD = ' + quotedstr(buscas.FieldByName('COD_PROD').AsString) +
        ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
      if i = 1 then
        Qrprodupdate.ParamByName('CLASSE_PROD').AsString := 'A'
      else if i = 2 then
        Qrprodupdate.ParamByName('CLASSE_PROD').AsString := 'B'
      else
        Qrprodupdate.ParamByName('CLASSE_PROD').AsString := 'C';
      Qrprodupdate.Prepare;
      Qrprodupdate.ExecSQL;
      ibtransprodup.Commit;
    end;
    somap := somap + buscas.FieldByName('vtot_venda').AsFloat;
    if i = 1 then
    begin
      if somap >= totalA then
      begin
        somap := 0.00;
        i := 2;
      end;
    end
    else
    begin
      if i = 2 then
      begin
        if somap >= totalB then
        begin
          somap := 0.00;
          i := 3;
        end;
      end;
    end;
    buscas.Next;
    if Parar = 1 then
    begin
      if Application.MessageBox('Deseja Cancelar Processamento?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        break
      else
        Parar := 0;
    end;
    ProgressBar.Position := ProgressBar.Position + 1;
    Panel.Caption := 'Classificando Produtos: ''A'',''B'',''C''  ' +
      vDadosIni.strzero(ProgressBar.Position, 5);
  end;
  if Parar = 1 then
  begin
    result := false;
    exit;
  end;

  // Classes X,Y,Z e W
