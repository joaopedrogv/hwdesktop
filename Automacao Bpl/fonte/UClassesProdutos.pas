      	vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

        if porcentagem > 0 then
          vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
        else
          vproporcao_tabela := 1 - (Abs(porcentagem) / 100);

        valor := dataSet.FieldByName('PREC_TAB_PROD').AsFloat + ((dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * porcentagem);
	      porcentagem := 0;
