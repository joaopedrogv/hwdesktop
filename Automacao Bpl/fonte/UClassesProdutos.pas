function TProdutos.getQuantidadePendente1(pGrupoProd: Integer; pCodProd, pTipo: string; pCodGrade: Integer): Extended;
begin
  buscas.close;
  buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = :cod_prod and ipv.grupo_prod = :grupo_prod and pv.tipo <> ''ORC''' +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa =' + vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  if Trim(pTipo) = 'REQ' then
    buscas.SQL.Text := buscas.SQL.Text + ' and pv.tipo = ''REQ'''
  else if Trim(pTipo) = 'OS' then
    buscas.SQL.Text := buscas.SQL.Text + ' and pv.tipo = ''OS'''
  else
    buscas.SQL.Text := buscas.SQL.Text + ' and pv.tipo <> ''ORC''';

  if pCodGrade > 0 then
    buscas.SQL.Text := buscas.SQL.Text + ' and ipv.cod_grade = ' + IntToStr(pCodGrade);

  buscas.ParamByName('grupo_prod').AsInteger := pGrupoProd;
  buscas.ParamByName('cod_prod').AsString := pCodProd;
  buscas.Prepare;
  buscas.Open;
  Result := buscas.FieldByName('valor').AsFloat;

  if (Trim(pTipo) <> 'REQ') and (Trim(pTipo) <> 'OS') then
  begin

    buscas.Close;
    buscas.SQL.Text :=
      'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as valor from producao pd, producao_item_indice pi' +
      ' where pi.grupo_prod = ' + IntToStr(pGrupoProd) + ' and pi.cod_prod = ' + QuotedStr(pCodProd) +
      ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
      ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    Result := Result + buscas.FieldByName('valor').AsFloat;
  end;

  buscas.Close;
  buscas.UnPrepare;
end;
}

