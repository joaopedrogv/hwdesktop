function TGrade.post: boolean;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição da grade não informada!', 'DBEdit2');

    if ((dataSet.State = dsInsert) or ((dataSet.State = dsEdit) and (dataSet.FieldByName('cod_grade').AsInteger > 0)))
     and (vDadosIni.vEcommerce.vHabilitarEcommerce) then
    begin
//    	if trim(dataSet.FieldByName('DESCRICAO1').AsString) = '' then
//      	raiseExceptionCreate('Descrição da grade 2 não informada!', 'DBEdit3');

      if trim(dataSet.FieldByName('TIPO_EC').AsString) = '' then
        raiseExceptionCreate('Tipo da grade (E-Commerce) não informada', 'DBComboBox1');

      if trim(dataSet.FieldByName('DESCRICAO_EC').AsString) = '' then
        raiseExceptionCreate('Descrição da grade (E-Commerce) não informada', 'DBEdit4');

      if trim(dataSet.FieldByName('DESCRICAO_EC1').AsString) <> '' then
        if trim(dataSet.FieldByName('TIPO_EC1').AsString) = '' then
          raiseExceptionCreate('Descrição da grade 2 (E-Commerce) foi informada, o Tipo da grade 2 (E-Commerce) deve ser informado', 'DBComboBox2');

      if trim(dataSet.FieldByName('TIPO_EC1').AsString) <> '' then
        if trim(dataSet.FieldByName('DESCRICAO_EC1').AsString) = '' then
          raiseExceptionCreate('Tipo da grade 2 (E-Commerce) foi informado, a Descrição da grade 2 (E-Commerce) deve ser informada', 'DBEdit5');
    end;

    if not testarGradesTipoEC then
      exit;
      
    if not testarTipoEC then
      exit;

    buscas.close;
    buscas.SQL.text := 'select count(*) as qtde from grade ' +
     ' where descricao = ' +  QuotedStr(dataSet.FieldByName('descricao').AsString) +
     ' and cod_grade <> ' +  inttostr(dataSet.FieldByName('cod_grade').AsInteger) +
     ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if buscas.FieldByName('qtde').AsInteger > 0 then
      raise exception.create('Já existe grade com o mesmo nome');

    if dataSet.State in [dsInsert] then
    begin
      dataSet.FieldByName('COD_GRADE').AsInteger := Gencodigo('GRADE', dtmProdutos.SpIncCodigo,
        vDadosIni.codEmpresa);
      dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_GRADE').AsString;
    end;

    dataSet.FieldByName('DESCRICAO').AsString := trim(dataSet.FieldByName('DESCRICAO').AsString);
    if (vDadosIni.vEcommerce.vHabilitarEcommerce) then
    begin
    	dataSet.FieldByName('TIPO_EC').AsString       := trim(dataSet.FieldByName('TIPO_EC').AsString);
      dataSet.FieldByName('DESCRICAO_EC').AsString  := trim(dataSet.FieldByName('DESCRICAO_EC').AsString);
      dataSet.FieldByName('TIPO_EC1').AsString      := trim(dataSet.FieldByName('TIPO_EC1').AsString);
      dataSet.FieldByName('DESCRICAO_EC1').AsString := trim(dataSet.FieldByName('DESCRICAO_EC1').AsString);
    end;

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if Apply then
    begin
      fOldCodGrade := dataSet.FieldByName('cod_grade').AsInteger;
      if CommitaTransacao then
      begin
        vDadosIni.GravaAuditoria('PRO102', 'TRANSAÇÃO CONFIRMADA', 'SUCESSO', 'GRADE',
          dataSet.FieldByName('COD_GRADE').AsString, buscas);
        replicaGrade;
      end;
      //        vDadosIni.GravaAuditoria('PRO102', 'TRANSACAO CONFIRMADA' +
//          dataSet.FieldByName('COD_GRADE').AsString, buscas);
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO102', 'TRANSAÇÃO NAO CONFIRMADA', 'FALHA', 'GRADE',
        dataSet.FieldByName('COD_GRADE').AsString, buscas);
      //      vDadosIni.GravaAuditoria('PRO102', 'TRANSACAO NAO CONFIRMADA' +
      //        dataSet.FieldByName('COD_GRADE').AsString, buscas);
      Result := FALSE;
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

