function TProdutos._abreFormEtiquetasEs: boolean;
var
  formulario: TfrmPadrao;
  I: Integer;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 822;
    formulario.Height := 574;
    formulario.Position := poMainFormCenter;
    formulario.Caption := 'Seleção de produtos da etiqueta';
    FrmCadProdutos.pnEtiquetasEs.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;

    try
    	FrmCadProdutos.DBGrid17.DataSource.DataSet.DisableControls;
      FrmCadProdutos.DBGrid17.DataSource.DataSet.First;
      while not FrmCadProdutos.DBGrid17.DataSource.DataSet.Eof do
      begin
        FrmCadProdutos.DBGrid17.DataSource.DataSet.Edit;
        FrmCadProdutos.DBGrid17.DataSource.DataSet.FieldByName('SEL').Value := Null;
        FrmCadProdutos.DBGrid17.DataSource.DataSet.Post;

        FrmCadProdutos.DBGrid17.DataSource.DataSet.Next;
      end;
    finally
      FrmCadProdutos.DBGrid17.DataSource.DataSet.First;
      FrmCadProdutos.DBGrid17.DataSource.DataSet.EnableControls;
    end;

    for I := 0 to FrmCadProdutos.DBGrid17.Columns.Count - 1 do
      if FrmCadProdutos.DBGrid17.Columns[I].FieldName = 'SEL' then
      begin
        if FrmCadProdutos.DBGrid17.Columns[I].Index <> 0 then
          FrmCadProdutos.DBGrid17.Columns[I].Index := 0;
        if FrmCadProdutos.DBGrid17.Columns[I].Width <> 18 then
          FrmCadProdutos.DBGrid17.Columns[I].Width := 18;
        Break;
      end;

      for I := 0 to FrmCadProdutos.DBGrid17.Columns.Count - 1 do
	      if FrmCadProdutos.DBGrid17.Columns[I].FieldName = 'BARCODE' then
        begin
					FrmCadProdutos.DBGrid17.Columns[I].Index := 1;
          Break;
        end;

      for I := 0 to FrmCadProdutos.DBGrid17.Columns.Count - 1 do
	      if FrmCadProdutos.DBGrid17.Columns[I].FieldName = 'BARCODE_EAN' then
        begin
					FrmCadProdutos.DBGrid17.Columns[I].Index := 2;
          Break;
        end;

    	for I := 0 to FrmCadProdutos.DBGrid17.Columns.Count - 1 do
      	if FrmCadProdutos.DBGrid17.Columns[I].FieldName = 'QTDE' then
        begin
      		FrmCadProdutos.DBGrid17.Columns[I].Index := 3;
          Break;
        end;

    result := formulario.ShowModal = mrOk;
  finally
    FrmCadProdutos.pnEtiquetasEs.Parent := FrmCadProdutos.tsEster;
    formulario.Free;
    formulario := nil;
  end;
end;

