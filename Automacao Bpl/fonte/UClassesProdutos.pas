function TEmpresasTipoServ._abreTodosEmpresas(pCodServico: Integer): Boolean;
begin
  Result := montaSelect(' select emp.cod_empresa, ' +
  	' (coalesce(emp.identificacao_emp, emp.nome_emp) ||'' - ''|| emp.cgc_emp) identificacao_emp from empresa emp ' +
    ' where emp.ativo = 1 ' +
    ' order by emp.cod_empresa');

  try
  	dataset.DisableControls;
    dataset.First;
    while not dataset.Eof do
    begin
    	if pCodServico > 0 then
      begin
      	buscas.Close;
        buscas.SQL.Text := 'select cod_servico, cod_empresa from tipo_servico_empresa ' +
        	' where cod_servico = ' + IntToStr(pCodServico) +
          ' and cod_empresa = ' + IntToStr(dataset.FieldByName('cod_empresa').AsInteger);
        buscas.Open;

        if not buscas.IsEmpty then
        begin
	        dataset.Edit;
  	      dataset.FieldByName('sel').AsString := 'S';
    	    dataset.Post;
        end;
      end
      else if dataset.FieldByName('cod_empresa').AsInteger = StrToInt(vDadosIni.codEmpresa) then
      begin
      	dataset.Edit;
        dataset.FieldByName('sel').AsString := 'S';
        dataset.Post;
      end;

    	dataset.Next;
    end;
  finally
    dataset.First;
    dataset.EnableControls;
  end;
end;

