procedure TProdutos.ImprimirFichaInventario_semUso(dataI, dataF: string);
var
  vFichaInv: TRelFichaInventario;
begin
  vFichaInv.dataIni := dataI;
  vFichaInv.dataFim := dataF;
  vFichaInv.buscas.Close;
  vFichaInv.buscas.SQL.Text := 'select PR.* from produtos pr ' +
    ' WHERE pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1  ' +
    ' and (((select count(pp.cod_prod) from pedvenda p inner join pedvenda_prod pp ' +
    ' on p.nped=pp.nped and p.cod_empresa=pp.cod_empresa and p.tipo=pp.tipo ' +
    ' where pp.grupo_prod = pr.grupo_prod and ' +
    ' pp.cod_prod = pr.cod_prod and p.cod_empresa = pr.cod_empresa and ((pp.status is null) or (pp.status <> ''CANCELADO'')) and  p.ativo = 1 ' +
    ' and ((p.tipo=''REQ'') or (p.tipo=''OS'')) and p.data_fech >= :vdat1 and p.data_fech <= :vdat2) > 0)' +
    ' or ' +
    ' ((select count(ni.cod_prod) from notafiscal n inner join notafiscal_item ni ' +
    ' on n.cod_nf=ni.cod_nf and n.cod_empresa=ni.cod_empresa ' +
    ' where ni.grupo_prod = pr.grupo_prod and ni.cod_prod = pr.cod_prod ' +
    ' and ni.cod_empresa = pr.cod_empresa and n.ativo = 1) > 0))';
  vFichaInv.buscas.ParamByName('vdat1').AsDate := StrToDate(dataI);
  vFichaInv.buscas.ParamByName('vdat2').AsDate := StrToDate(dataF);
  vFichaInv.buscas.Prepare;
  vFichaInv.buscas.Open;
  //  vFichaInv.rdp := TRDprint(rdprint);
  vFichaInv.rdp := TRDprint.Create(dtmProdutos);
  vFichaInv.rdp.OpcoesPreview.CaptionPreview := 'Ficha de Inventário dos Produtos';
  vFichaInv.rdp.CaptionSetup := 'Configurar impressão da Ficha de Inventário';
  vFichaInv.rdp.TitulodoRelatorio := 'Ficha de Inventário';
  vDadosIni._LimparVarSendEmail;
  vFichaInv.rdp.OnSendMail := vDadosini._SendMailRdPrint;
  vFichaInv.rdp.OpcoesPreview.Preview := true;
  vFichaInv.rdp.FonteTamanhoPadrao := S17cpp;
  vFichaInv.rdp.TamanhoQteColunas := 132;
  vFichaInv.rdp.TamanhoQteLinhas := 66;
  vFichaInv.linha := 1;
  vFichaInv.vPagina := 1;
  if not vDadosIni.ModImp(vFichaInv.rdp) then
    exit;
  vFichaInv.rdp.Abrir;
  while not vFichaInv.buscas.eof do
  begin
    {Select sum(itos.quant_os_prod) from os_item_prod itos,ordem_serv os where
itos.cod_prod = :vcod and itos.grupo_prod = :vgrup and itos.n_os = os.n_os
and (os.data_fec_os is null or os.data_fec_os < '01/01/1899') and OS.COD_EMPRESA = :cod_empresa and OS.ATIVO=1
and os.COD_EMPRESA = itos.COD_EMPRESA
}
    vFichaInv.rdp.Imp(linha, 1, vFichaInv.buscas.FieldByName('LOCACAO_PROD').AsString);
    vFichaInv.rdp.Imp(linha, 14, vFichaInv.buscas.FieldByName('LOCACAO_PROD_1').AsString);
    vFichaInv.rdp.Imp(linha, 24, vFichaInv.buscas.FieldByName('DESCR_PROD').AsString);
    vFichaInv.rdp.Imp(linha, 86, UpperCase(trim(vFichaInv.buscas.FieldByName('UNIDADE').AsString)));
    vFichaInv.rdp.Imp(linha, 90, '_____________');
    vFichaInv.rdp.Imp(linha, 107, Floattostr(vFichaInv.buscas.FieldByName('Est_R').AsFloat +
      vFichaInv.buscas.FieldByName('Est_F').AsFloat -
      (Produto.getQuantidadePendenteReqOS(vFichaInv.buscas.FieldByName('GRUPO_PROD').asinteger,
      trim(vFichaInv.buscas.FieldByName('COD_PROD').AsString)))));
    //      dtm1.QrprodTr.close;
    //      dtm1.QrProdRq.close;
    vFichaInv.rdp.Imp(linha, 118, vFichaInv.buscas.FieldByName('NUM_FAB_PROD').AsString);
    vFichaInv.buscas.next;
    linha := linha + 1;
    if linha >= 58 then
    begin
      linha := 1;
      vFichaInv.rdp.Novapagina;
    end;
  end;
  vFichaInv.rdp.Fechar;
  vFichaInv.buscas.UnPrepare;
  vFichaInv.buscas.close;

end;

function TProdutos.inserirHistoricoAltCustoMed(acao: string): boolean;
var
	vDataBanco: TDateTime;
	buscas2: TIBQuery;
begin
	try
  	Result := False;

    if (acao = 'EDITAR')
    	and ((vEst_f_prod <> dataSet.FieldByName('EST_F').AsFloat)
         	 or (vPrec_cusm_prod <> dataSet.FieldByName('PREC_CUSM_PROD').AsFloat)) then
    begin
      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      vDataBanco := vDadosIni.getDataBanco(buscas);

      if (vEst_f_prod <> dataSet.FieldByName('EST_F').AsFloat) then
      begin
        buscas.Close;
        buscas.SQL.Text :=
           ' insert into HIST_ESTOQUE_DIARIO_PROD ' +
           ' (TIPO, SEQID, COD_EMPRESA,  TIPOR, NATUREZA, DATA, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE, CUSTO_MED) ' +
           ' VALUES ' +
           ' (:TIPO, :SEQID, :COD_EMPRESA, :TIPOR, :NATUREZA, :DATA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE, :CUSTO_MED);';
        buscas.ParamByName('TIPO').AsString := 'P';
        buscas.ParamByName('SEQID').AsInteger := Gencodigo('HIST_ESTOQUE_DIARIO_PROD', dtmProdutos.SpIncCodigo, vDadosIni.codEmpresa);
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ParamByName('TIPOR').AsString := 'COR';
        if (dataSet.FieldByName('EST_F').AsFloat <= 0) then
        	buscas.ParamByName('NATUREZA').AsString := 'S'
        else
        	buscas.ParamByName('NATUREZA').AsString := 'E';
        buscas.ParamByName('DATA').AsDateTime := vDataBanco;
        buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('QTDE').AsFloat := dataSet.FieldByName('EST_F').AsFloat;
        buscas.ParamByName('CUSTO_MED').AsFloat := 0;
        buscas.ExecSQL;
      end;

      if (vPrec_cusm_prod <> dataSet.FieldByName('PREC_CUSM_PROD').AsFloat) then
      begin
        buscas.Close;
        buscas.SQL.Text :=
           ' insert into HIST_ESTOQUE_DIARIO_PROD ' +
           ' (TIPO, SEQID, COD_EMPRESA,  TIPOR, NATUREZA, DATA, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE, CUSTO_MED) ' +
           ' VALUES ' +
           ' (:TIPO, :SEQID, :COD_EMPRESA, :TIPOR, :NATUREZA, :DATA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE, :CUSTO_MED);';
        buscas.ParamByName('TIPO').AsString := 'P';
        buscas.ParamByName('SEQID').AsInteger := Gencodigo('HIST_ESTOQUE_DIARIO_PROD', dtmProdutos.SpIncCodigo, vDadosIni.codEmpresa);
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ParamByName('TIPOR').AsString := 'COR';
        buscas.ParamByName('NATUREZA').AsString := 'E';
        buscas.ParamByName('DATA').AsDateTime := vDataBanco;
        buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('QTDE').AsFloat := 0;
        buscas.ParamByName('CUSTO_MED').AsFloat := dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
        buscas.ExecSQL;
      end;

      buscas.Close;
      buscas.SQL.Text :=
        ' select FIRST 1 * from ESTOQUE_DIARIO ' +
        ' where TIPO = :TIPO ' +
        ' and GRUPO_PROD = :GRUPO_PROD ' +
        ' and COD_PROD = :COD_PROD ' +
        ' and COD_EMPRESA = :COD_EMPRESA ' +
        ' and DIA = :DIA ';
      buscas.ParamByName('TIPO').AsString := 'P';
      buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('DIA').AsDateTime := vDataBanco;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        buscas.Close;
        buscas.SQL.Text :=
          ' UPDATE ESTOQUE_DIARIO SET ' +
          '		CUSTO_MEDIO = :CUSTO_MEDIO ' +
          ' where GRUPO_PROD = :GRUPO_PROD ' +
          ' and COD_PROD = :COD_PROD ' +
          ' and COD_EMPRESA = :COD_EMPRESA ' +
          ' and DIA = :DIA ' +
          ' and TIPO = :TIPO; ';
        buscas.ParamByName('TIPO').AsString := 'P';
        buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ParamByName('DIA').AsDateTime := vDataBanco;
        buscas.ParamByName('CUSTO_MEDIO').AsFloat := dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
        buscas.ExecSQL;
      end
      else
      begin
        buscas2.Close;
        buscas2.SQL.Text :=
          ' SELECT COALESCE(GP.COD_GRADE, 0) COD_GRADE, ' +
          ' CASE WHEN COALESCE(GP.COD_GRADE, 0) > 0 THEN ' +
          '        COALESCE(GP.QTDE, 0) ' +
          '      ELSE ' +
          '        COALESCE(P.EST_F, 0) ' +
          ' END EST_F, ' +
          ' COALESCE(P.PREC_CUSM_PROD, 0) PREC_CUSM_PROD FROM PRODUTOS P ' +
          ' LEFT JOIN COD_GRADE_PROD GP ON ' +
          '   GP.GRUPO_PROD = P.GRUPO_PROD ' +
          '   AND GP.COD_PROD = P.COD_PROD ' +
          '   AND GP.COD_EMPRESA = P.COD_EMPRESA ' +
          ' WHERE P.GRUPO_PROD = :GRUPO_PROD ' +
          ' AND P.COD_PROD = :COD_PROD ' +
          ' AND P.COD_EMPRESA = :COD_EMPRESA ';
        buscas2.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas2.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
        buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas2.Open;

        buscas2.First;
        while not buscas2.Eof do
        begin
          buscas.Close;
          buscas.SQL.Text :=
            ' INSERT INTO ESTOQUE_DIARIO ' +
            ' (GRUPO_PROD, COD_PROD, COD_EMPRESA, COD_GRADE, DIA, ESTOQUE, CUSTO_MEDIO, TIPO, SEQID) ' +
            ' VALUES (:GRUPO_PROD, :COD_PROD, :COD_EMPRESA, :COD_GRADE, :DIA, :ESTOQUE, :CUSTO_MEDIO, :TIPO, gen_id(INC_ESTOQUE_DIARIO, 1)); ';
          buscas.ParamByName('TIPO').AsString := 'P';
          buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          buscas.ParamByName('COD_GRADE').AsInteger := buscas2.FieldByName('COD_GRADE').AsInteger;
          buscas.ParamByName('DIA').AsDateTime := vDataBanco;
          buscas.ParamByName('ESTOQUE').AsFloat := buscas2.FieldByName('EST_F').AsFloat;
          buscas.ParamByName('CUSTO_MEDIO').AsFloat := dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
          buscas.ExecSQL;

          buscas2.Next;
        end;
      end
    end;

    Result := True;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutos.InserirInsumoOutroProd(
	pGrupoProdIns: Integer;
  pCodProdIns: string;
  pQuantIns: Double): boolean;
begin
  try
    Result := False;

    if dataSet.IsEmpty then
    	Exit;

    vIndTec.vProduto.buscas.Close;
    vIndTec.vProduto.buscas.SQL.Text :=
      ' select grupo_prod, cod_prod, num_fab_prod, descr_prod, unidade, cod_recprod from produtos ' +
      ' where grupo_prod = ' + IntToStr(pGrupoProdIns) +
      ' and cod_prod = ' + QuotedStr(pCodProdIns) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    vIndTec.vProduto.buscas.Open;

    vIndTec.vgrupo_prod_acabado := dataSet.FieldByName('grupo_prod').AsString;
    vIndTec.vcod_prod_acabado := dataSet.FieldByName('cod_prod').AsString;
    vIndTec.vgrupo_prod_mp := vIndTec.vProduto.buscas.FieldByName('grupo_prod').AsString;
    vIndTec.vcod_prod_mp := vIndTec.vProduto.buscas.FieldByName('cod_prod').AsString;
    vIndTec.vdescr_prod_mp := vIndTec.vProduto.buscas.FieldByName('descr_prod').AsString;
    vIndTec.vcodprod := vIndTec.vProduto.buscas.FieldByName('num_fab_prod').AsString;
    vIndTec.vquant_mp := pQuantIns;

    if not vDadosIni.PesqPros('ITEC003', 'CONFIRMAR',
      'ACAB ' +
      'Grupo: ' + vIndTec.vgrupo_prod_acabado + ' ' +
      'Codigo: ' + vIndTec.vcod_prod_acabado + ' ' +
      'INS ' +
      'Grupo: ' + vIndTec.vgrupo_prod_mp + ' ' +
      'Codigo: ' + vIndTec.vcodprod,
      'INDICE_TECNICO',
      vIndTec.vgrupo_prod_acabado + ' ' +
      vIndTec.vcod_prod_acabado,
      buscas, True) then
        Exit;

    if not vIndTec.inserirItem then
    	Exit;

    Result := True;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.InserirInsumoOutroProd. Erro: ' + e.Message);
    end;
  end;
end;

