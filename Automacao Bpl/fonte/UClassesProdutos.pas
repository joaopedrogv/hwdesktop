//          CommitaTransacao;
  //        GravaLogConfirmacao(statusRegistro, 'PRO009', true);

          vcodEmpTemp := vdadosini.codempresa;
          try
            for I := 0 to Length(RepliProdutos.RepliEmp) - 1 do
