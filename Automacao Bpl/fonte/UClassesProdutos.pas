function TGrade.delete: boolean;
var
	vApagar: boolean;
	vCodGrade: string;
  vDescricao1, vDescricao2: string;
  vTipo1, vTipo2: string;
  vtemp: string;
begin
	Result := False;
  
  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  try
  	vApagar     := dataSet.FieldByName('ATIVO').AsInteger <> 1;
    vCodGrade   := trim(dataSet.FieldByName('COD_GRADE').AsString);
    vDescricao1 := trim(dataSet.FieldByName('DESCRICAO').AsString);
    vDescricao2 := trim(dataSet.FieldByName('DESCRICAO1').AsString);
    vTipo1      := trim(dataSet.FieldByName('TIPO_EC').AsString);
    vTipo2      := trim(dataSet.FieldByName('TIPO_EC1').AsString);

    prepare_loop('SEL = ''S''');
    if not dataset.IsEmpty then
    begin
    	vApagar     := dataSet.FieldByName('ATIVO').AsInteger <> 1;
    	vCodGrade   := '';
      vDescricao1 := '';
      vDescricao2 := '';
      vTipo1      := '';
      vTipo2      := '';
    end;
  finally
    prepare_loop_done;
  end;

  try
  	try
      if trim(vCodGrade) <> '' then
        prepare_loop('COD_GRADE = ' + vCodGrade)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'GRADE' + #13 +
          'Cod Grade: ' + trim(vCodGrade) + #13+
          'Descrição 1: ' + trim(vDescricao1) +
          vDadosIni.IfThen(trim(vDescricao2) <> '', #13 + 'Descrição 2: ' + trim(vDescricao2), '') +
          vDadosIni.IfThen(trim(vTipo1) <> '', #13 + 'Tipo 1: ' + trim(vTipo1), '') +
          vDadosIni.IfThen(trim(vTipo2) <> '', #13 + 'Tipo 2: ' + trim(vTipo2), '');

        if (trim(vCodGrade) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO098', 'EXCLUIR', '', 'GRADE',
          vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
          exit;
      end
      else
      begin
      	vtemp := 'Tem certeza que deseja mover este registro para a Lixeira?' + #13 + #13 +
          'GRADE' + #13 +
          'Cod Grade: ' + trim(vCodGrade) + #13+
          'Descrição 1: ' + trim(vDescricao1) +
          vDadosIni.IfThen(trim(vDescricao2) <> '', #13 + 'Descrição 2: ' + trim(vDescricao2), '') +
          vDadosIni.IfThen(trim(vTipo1) <> '', #13 + 'Tipo 1: ' + trim(vTipo1), '') +
          vDadosIni.IfThen(trim(vTipo2) <> '', #13 + 'Tipo 2: ' + trim(vTipo2), '');

        if (trim(vCodGrade) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO099', 'EXCLUIR', '', 'BOLETAS',
          vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo grade(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo grade(s) para lixeira');

      try
        dataset.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
        	if vApagar then
            vDadosIni.abreStatusProcessamento('', 'Excluíndo grade(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
          else
            vDadosIni.abreStatusProcessamento('', 'Movendo grade(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          if vApagar then
          begin
//          	if dataset.FieldByName('COD_GRADE').AsInteger <= 0 then
//            begin
//              Application.MessageBox(PChar('Grade ' +
//              	IntToStr(dataset.FieldByName('COD_GRADE').AsInteger) + ' - ' +
//                trim(dataset.FieldByName('DESCRICAO').AsString) +
//                ' não pode ser apagada'), 'Atenção', MB_ICONERROR + MB_OK);
//              Exit;
//            end;

            buscas.Close;
            buscas.SQL.Text := ' select first 1 cod_grade from cod_grade_prod ' +
              ' where cod_grade = :cod_grade ' +
              ' and cod_empresa = :cod_empresa ' +
              ' union ' +
              ' select first 1 cod_grade from produtos_ec_grade ' +
              ' where cod_grade = :cod_grade ' +
              ' and cod_empresa = :cod_empresa ' +
              ' union ' +
              ' select first 1 cod_grade from produtos_pdc_var ' +
              ' where cod_grade = :cod_grade ' +
              ' and cod_empresa = :cod_empresa ' +
              ' union ' +
              ' select first 1 cod_grade from produtos_pdc_var_it ' +
              ' where cod_grade = :cod_grade ' +
              ' and cod_empresa = :cod_empresa ' +
              ' union ' +
              ' select first 1 cod_grade from produtos_grade_imagens ' +
              ' where cod_grade = :cod_grade ' +
              ' and cod_empresa = :cod_empresa ';
            buscas.ParamByName('COD_GRADE').AsInteger := dataset.FieldByName('COD_GRADE').AsInteger;
            buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
            buscas.Open;

            if not buscas.IsEmpty then
            begin
              Application.MessageBox(PChar('Grade ' +
                IntToStr(dataset.FieldByName('COD_GRADE').AsInteger) + ' - ' +
                trim(dataset.FieldByName('DESCRICAO').AsString) +
                ' foi movimentada não pode ser apagada'), 'Atenção', MB_ICONERROR + MB_OK);
              Exit;
            end;

            if fint('cod_grade') = 0 then
          	begin
            	SqlExec(' update grade set ativo = 99 ' +
                ' where cod_grade = %d and cod_empresa = %d ',
                [fint('cod_grade'), fint('cod_empresa')], buscas);
            end
            else
            begin
              SqlExec(' delete from grade ' +
                ' where cod_grade = %d and cod_empresa = %d ',
                [fint('cod_grade'), fint('cod_empresa')], buscas);
            end;

            if (trim(vCodGrade) = '') then
              vDadosIni.GravaAuditoria('PRO098', 'EXCLUIR', '', 'GRADE',
                dataSet.FieldByName('COD_GRADE').AsString, buscas);
          end
          else
          begin
            SqlExec(' update grade set ativo = 0 ' +
              ' where cod_grade = %d and cod_empresa = %d ',
              [fint('cod_grade'), fint('cod_empresa')], buscas);

            if (trim(vCodGrade) = '') then
              vDadosIni.GravaAuditoria('PRO099', 'EXCLUIR', '', 'GRADE',
                dataSet.FieldByName('COD_GRADE').AsString, buscas);
          end;

          dataset.Next;
        end;
      finally
        dataset.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO098', 'PRO099'),
        'EXCLUIR', 'SUCESSO', 'GRADE',
        vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO098', 'PRO099'),
        'EXCLUIR', 'FALHA', 'GRADE',
        vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas);
    end;

    if Result then
    	Refresh;

  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO098', 'PRO099'),
      	'EXCLUIR', 'FALHA', 'GRADE',
      	vDadosIni.IfThen(trim(vCodGrade) <> '', trim(vCodGrade), ''), buscas);
      Application.MessageBox(pchar('Erro ao excluir grade. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

