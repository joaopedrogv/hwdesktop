function TSubGrupos.SubGrupoVinculado(DatasetProduto: TProdutos; MostrarMsg: boolean): Boolean;
begin
  if UpperCase(vDadosIni.vSubGrupoVinc) = 'S' then
  begin
    result := montaSelect('select * from sub_grupo where ativo = 1 and cod_grupo = ' +
      intTostr(DatasetProduto.dataSet.FieldByName('GRUPO_PROD').asinteger));
    if MostrarMsg then
      if not ExecutaComandosSql('select * from sub_grupo where ativo=1 and cod_grupo = ' +
        inttostr(DatasetProduto.dataSet.FieldByName('GRUPO_PROD').asinteger) + ' and CODIGO_SUBGR= '
        +
        intTostr(DatasetProduto.dataSet.FieldByName('SUB_G_PROD').asinteger)) then
      begin
        Application.MessageBox('O subgrupo informado não está vinculado ao grupo deste produto.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        DatasetProduto.dataSet.FieldByName('SUB_G_PROD').value := null;
      end
      else
        DatasetProduto.dataSet.FieldByName('SUB_G_PROD').Value :=
          dataSet.FieldByName('CODIGO_SUBGR').Value;
  end;
end;

