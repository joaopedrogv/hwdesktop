procedure TCadCategorias.montarTreeView(pTreeView: TTreeView);
var
  I: Integer;
  ANode, ANode2, ANode3: TtreeNode;
  vcategoria: string;
  buscas2: TIBQuery;
begin
	pTreeView.Items.Clear;
	if pTreeView.Items.Count > 0 then
    while pTreeView.Items.Count > 0 do
      pTreeView.Items[0].Delete;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;
  
  abreConsCategorias(buscas2);

  buscas2.First;
  while not buscas2.Eof do
  begin
    if (Pos('-', buscas2.FieldByName('ordem').AsString) <= 0)
    	and (Pos('.', buscas2.FieldByName('ordem').AsString) <= 0) then
    begin
    	vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode := pTreeView.Items.AddChild(nil, trim(vcategoria));
    end
    else if (Pos('.', buscas2.FieldByName('ordem').AsString) > 0) then
    begin
    	vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode3 := pTreeView.Items.AddChild(ANode2, trim(vcategoria));
    end
    else if (Pos('-', buscas2.FieldByName('ordem').AsString) > 0) then
    begin
    	vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode2 := pTreeView.Items.AddChild(ANode, trim(vcategoria));
    end;
    buscas2.Next;
  end;

  for I := 0 to pTreeView.Items.Count - 1 do
    pTreeView.Items[I].Selected := true;

  for I := 0 to pTreeView.Items.Count - 1 do
  begin
    if pTreeView.Items[I].Level = 0 then
    begin
      pTreeView.Items[I].Selected := true;
      Break;
    end;    
  end;
end;

function TCadCategorias.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS417', 'SALVAR', '', 'CATEGORIA',
      dataSet.FieldByName('COD_CATEGORIA').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not vCategoriaPai.dataSet.Locate('COD_CATEGORIA',
     dataSet.FieldByName('COD_CATEGORIA_PAI').AsInteger, []) then
      raiseExceptionCreate('Nível da categoria deve ser informada', 'DBLookupComboBox1');
        
    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição deve ser informada', 'DBEdit2');

    if vCategoriaPai.dataSet.FieldByName('NIVEL').AsInteger >= 3 then
      raiseExceptionCreate('Categoria pode ser incluída somente até o 2º nível', 'DBLookupComboBox1');

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('COD_CATEGORIA').AsInteger :=
        Gencodigo('CATEGORIA', dtmProdutos.SpIncCodigo, vDadosIni.codEmpresa);
    end;

    dataSet.FieldByName('DESCRICAO').AsString := trim(dataSet.FieldByName('DESCRICAO').AsString);

    if dataSet.FieldByName('COD_CATEGORIA_PAI').IsNull then
      dataSet.FieldByName('COD_CATEGORIA_PAI').AsInteger := 0;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS417', acao, 'SUCESSO', 'CATEGORIA',
        dataSet.FieldByName('COD_CATEGORIA').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS417', acao, 'FALHA', 'CATEGORIA',
        dataSet.FieldByName('COD_CATEGORIA').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadCategorias.sincronizarCategoriasEmLote: boolean;
var
  vIndexFieldNames: string;
  vIndexName: string;
  vRecNo: Integer;
  vSQL: string;
  vtempMensagem: string;
begin
	Result := false;
  vSQL := '';
  vtempMensagem := 'SALVAR';

  if not vDadosIni.PesqPros('PRO455', vtempMensagem, '', 'CATEGORIA', '', buscas, False) then
  	Exit;
	try
  	try
      vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum categoria selecionada.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          exit;
        end;

        if Application.MessageBox('Deseja sincronizar as categorias selecionadas?',
        	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
          	exit;

        vSQL := dataSet.CommandText;
      finally
      	dataSet.Filtered := false;
      end;

      try
        dataSet.DisableControls;
        dataSet.First;
        while not dataSet.Eof do
        begin
          Application.ProcessMessages;
          vDadosIni.abreStatusProcessamento('', 'Sincronizando categorias (' +
            IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        	SqlExec(' update categoria set ativo = ativo ' +
            ' where cod_categoria = %d and cod_empresa = %d ',
            [fint('cod_categoria'), fint('cod_empresa')], buscas);

          vDadosIni.GravaAuditoria('PRO455', vtempMensagem, '',
          	'CATEGORIA',
            IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger), buscas);

          dataSet.Next;
        end;
      finally
      	dataSet.First;
      	dataSet.EnableControls;
      end;

      CommitaTransacao;

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      vDadosIni.GravaAuditoria('PRO455', vtempMensagem,	'SUCESSO', 'CATEGORIA', '', buscas);

      Result := true;

      if Result then
      	dataSet.Refresh;
    finally
      dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;

  except
    on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO455', vtempMensagem,	'FALHA', 'CATEGORIA', '', buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TCadCategorias._cadCategoria(pTipoForm: Integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Categorias');
    if dtmProdutos = nil then
      dtmProdutos := TdtmProdutos.Create(dtmProdutos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS412', 'CONSULTA', '', 'CATEGORIA', '',
      dtmProdutos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadCategoria = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadCategoria, frmCadCategoria);
    end;

    if (pTipoForm > 0) and (not frmCadCategoria.Visible) then
    	frmCadCategoria.ShowModal
    else if (not frmCadCategoria.Visible) then
    	frmCadCategoria.Show
    else if frmCadCategoria.FormStyle = fsMDIChild then
      frmCadCategoria.Show
    else
      frmCadCategoria.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TCadCategorias._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TCadCategorias._imprimirCategorias(pListarProd: boolean; pImprimirSel: boolean): boolean;
var
	variavel_parar: boolean;
  vpag: Integer;
  linha: integer;

  procedure menuProd(pListarProd: boolean);
  begin
    //Impressão do Menu.
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);

    linha := linha + 1;

    Rdp.ImpD(linha, 1, 'CODIGO', [comp17, negrito]);
    Rdp.ImpF(linha, 22, 'DESCRICAO', [comp17, negrito]);

    if pListarProd then
    begin
      Rdp.ImpD(linha, 90, 'CUSTO M', [comp17, negrito]);
      Rdp.ImpD(linha, 104, 'TABELA', [comp17, negrito]);
      Rdp.ImpD(linha, 118, 'ATACADO', [comp17, negrito]);
      Rdp.ImpD(linha, 132, 'ESTOQUE', [comp17, negrito]);
    end;

    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    linha := linha + 1;
  end;

	procedure CabNovaPaginaCat(pListarProd: boolean);
  begin
    //  if Rdp.UltimaPagina > 1 then
    if vpag > 0 then
      Rdp.Novapagina;
    Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'RELATORIO CATEGORIAS DE PRODUTOS', [normal, negrito]);

    vpag := vpag + 1;
    Rdp.ImpF(linha, 116, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal]);
    linha := linha + 1;

    menuProd(pListarProd);
  end;
begin
	inherited;
  vpag := 0;
  //Inicia a Impressão.
//  Refresh;
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Categoria';
  rdp.TitulodoRelatorio := 'Categoria';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  CabNovaPaginaCat(pListarProd);
  // Inicio da Impressão dos Itens.
  try
    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.eof do
    begin
      linha := linha + 1;
      Application.ProcessMessages;

      if (not pImprimirSel) or (dataSet.FieldByName('SEL').AsString = 'S') then
      begin
        if not pListarProd then
        begin
          Rdp.ImpF(linha, 1, IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger), [normal]);
          Rdp.ImpF(linha, 22, trim(dataSet.FieldByName('DESCRICAO').AsString), [normal]);
        end
        else
          Rdp.ImpF(linha, 1, 'CATEGORIA ' + IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger) + ' - ' +
           trim(dataSet.FieldByName('DESCRICAO').AsString), [normal, negrito]);

        if pListarProd then
        begin
          buscas.Close;
          buscas.Sql.Text := ' select produtos.grupo_prod, produtos.cod_prod, produtos.num_fab_prod, ' +
            ' produtos.descr_prod, ' +
            ' coalesce(produtos.prec_cus_prod, 0) prec_cus_prod, ' +
            ' coalesce(produtos.prec_cusm_prod, 0) prec_cusm_prod, ' +
            ' coalesce(produtos.prec_tab_prod, 0) prec_tab_prod, ' +
            ' coalesce(produtos.prec_publico, 0) prec_publico, ' +
            ' coalesce(produtos.prec_30_prod, 0) prec_30_prod, ' +
            ' coalesce(produtos.prec_60_prod, 0) prec_60_prod,' +
            ' coalesce(produtos.prec_90_prod, 0) prec_90_prod, ' +
            ' coalesce(produtos.est_f, 0) est_f from produtos_ec ' +
            ' inner join produtos on produtos.grupo_prod = produtos_ec.grupo_prod ' +
            ' 	and produtos.cod_prod = produtos_ec.cod_prod ' +
            '   and produtos.cod_empresa = produtos_ec.cod_empresa ' +
            ' where produtos_ec.cod_categoria = ' + IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger) +
            ' and produtos_ec.cod_empresa = ' + vDadosIni.codEmpresa +
            ' union ' +
            ' select produtos.grupo_prod, produtos.cod_prod, produtos.num_fab_prod, ' +
            '	produtos.descr_prod, ' +
            ' coalesce(produtos.prec_cus_prod, 0) prec_cus_prod, ' +
            ' coalesce(produtos.prec_cusm_prod, 0) prec_cusm_prod, ' +
            ' coalesce(produtos.prec_tab_prod, 0) prec_tab_prod, ' +
            ' coalesce(produtos.prec_publico, 0) prec_publico, ' +
            ' coalesce(produtos.prec_30_prod, 0) prec_30_prod, ' +
            ' coalesce(produtos.prec_60_prod, 0) prec_60_prod,' +
            ' coalesce(produtos.prec_90_prod, 0) prec_90_prod, ' +
            ' coalesce(produtos.est_f, 0) est_f  from produtos_categoria ' +
            ' inner join produtos on produtos.grupo_prod = produtos_categoria.grupo_prod ' +
            '	  and produtos.cod_prod = produtos_categoria.cod_prod ' +
            '   and produtos.cod_empresa = produtos_categoria.cod_empresa ' +
            ' where produtos_categoria.cod_categoria = ' + IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger) +
            ' and produtos_categoria.cod_empresa = ' + vDadosIni.codEmpresa +
            ' order by 4 ';
          buscas.Open;

          if not buscas.IsEmpty then
          begin
            linha := linha + 2;

            buscas.First;
            while not buscas.eof do
            begin
              Application.ProcessMessages;
              try
                Rdp.Imp(linha, 1, buscas.FieldByName('num_fab_prod').asstring);
                Rdp.Imp(linha, 22, Copy(trim(buscas.FieldByName('descr_prod').AsString), 1, 50));
                if buscas.FieldByName('prec_cusm_prod').Visible then
                  Rdp.ImpD(linha, 90, format('%n', [buscas.FieldByName('prec_cusm_prod').AsCurrency]), [comp17]);
                Rdp.ImpD(linha, 104, format('%n', [buscas.FieldByName('prec_tab_prod').AsCurrency]), [comp17]);
                Rdp.ImpD(linha, 118, format('%n', [buscas.FieldByName('prec_publico').AsCurrency]), [comp17]);
                Rdp.ImpD(linha, 132, format('%n', [buscas.FieldByName('est_f').AsCurrency]), [comp17]);
                linha := linha + 1;
              except
              end;
              buscas.Next;
              if linha >= 60 then
              begin
                Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
                linha := 2;
                CabNovaPaginaCat(pListarProd);
              end;
            end;
          end;

          linha := linha + 1;
        end;
      end;

      dataSet.Next;

      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := 2;
        CabNovaPaginaCat(pListarProd);
      end;
    end;
  finally
    dataSet.First;
    dataSet.EnableControls;
  end;

  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.fechaStatusProcessamento;
end;

