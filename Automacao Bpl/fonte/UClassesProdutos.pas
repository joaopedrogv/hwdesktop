function TProdutos._verificarProdutosSemCodigo: boolean;
begin
	result := true;

  try
  	dataSet.DisableControls;
 	  vDadosIni.abreStatusProcessamento('', 'Aguarde.');

    if dataSet.RecordCount > 0 then
      storeRecNo;

    dataSet.First;
    while not dataSet.Eof do
    begin
      if dataSet.FieldByName('grupo_prod').AsInteger <= 0 then
      begin
        result := false;
        break;
      end;

      dataSet.Next;
    end;
  finally
    if dataSet.RecordCount > 0 then
      restoreRecNo;
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

