function TPromocao.abreRepliPromocao(pCodPromocao, pCodempresa, pCodTpPreco: Integer): Boolean;
begin
  dataSet.Close;
  dataSet.CommandText := ' select p.*, t.descr_tipo, t.tipo from promocao p ' +
    ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa ' +
  	' where p.cod_promocao = :cod_promocao ' +
    ' and p.cod_empresa = :cod_empresa ' +
    ' and p.cod_tppreco = :cod_tppreco ';
  dataSet.Params.ParamByName('cod_promocao').AsInteger := pCodPromocao;
  dataSet.Params.ParamByName('cod_empresa').AsInteger := pCodempresa;
  dataSet.Params.ParamByName('cod_tppreco').AsInteger := pCodTpPreco;
  result := Open;
end;

function TPromocao.ConsultaPromocao(pDateINI, pDateFIM: string; pDataFim: boolean = false): boolean;
var
 vSqlAdc: string;
begin
  try
  Result := false;

  if vDadosIni.vtpPreco = 'P' then
    vSqlAdc := ' WHERE ((PROMOCAO.DATA_INI >= :DATA_INI) AND (PROMOCAO.DATA_FIM <= :DATA_FIM)) ' +
      ' AND T.TIPO = :TIPO AND PROMOCAO.COD_EMPRESA = :COD_EMPRESA'
  else
    vSqlAdc := ' WHERE ((PROMOCAO.DATA_INI >= :DATA_INI) AND (PROMOCAO.DATA_FIM <= :DATA_FIM)) ' +
     ' AND T.TIPO >= :TIPO AND T.COD_TPPRECO >= 5 AND PROMOCAO.COD_EMPRESA = :COD_EMPRESA';

  dataSet.Close;
  dataSet.CommandText := 'SELECT PROMOCAO.*, T.DESCR_TIPO, T.TIPO FROM PROMOCAO' +
  ' INNER JOIN TIPO_PRECO T ON T.COD_TPPRECO = PROMOCAO.COD_TPPRECO AND T.COD_EMPRESA = PROMOCAO.COD_EMPRESA ' + vSqlAdc;
  if vDadosIni.vtpPreco = 'P' then
  begin
    dataSet.Params.ParamByName('DATA_INI').AsDateTime := StrToDate(pDateINI) + StrToTime('00:00:00');
    dataSet.Params.ParamByName('DATA_FIM').AsDateTime := StrToDate(pDateFIM) + StrToTime('23:59:59');
  end;
  dataSet.Params.ParamByName('COD_EMPRESA').AsInteger := StrtoInt(vDadosIni.CodEmpresa);
  dataSet.Params.ParamByName('TIPO').AsString := vDadosIni.vtpPreco;
  dataSet.Open;

  Result := not dataSet.IsEmpty;
  except
    on e: exception do
    begin
      Result := false;
      MessageDlg('E0009 Erro ao efetuar consulta. Erro: ' + e.Message + DataSet.CommandText,
        mtInformation, [mbOK], 0);
      registraErro('E0009 ' + e.Message + DataSet.CommandText);
    end;
  end;
end;

