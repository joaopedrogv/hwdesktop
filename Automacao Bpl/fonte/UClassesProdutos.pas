procedure TBalancoProduto._CadBalanco;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Balanço Geral');
    if dtmBalanco = nil then
      dtmBalanco := TdtmBalanco.Create(dtmBalanco);
    if not vDadosIni.PesqPros('BAL007', 'ABRIR', '', 'BALANCO_PRODUTOS', '', dtmBalanco.qrBuscas,
      False) then
      Exit;
    if frmBalanco = nil then
    begin
      Application.CreateForm(TfrmBalanco, frmBalanco);
      vDadosIni.fechaStatusProcessamento;
      frmBalanco.ShowModal;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
    frmBalanco.Free;
    frmBalanco := nil;
  end;
end;

function TBalancoProduto._ConfirmarBalanco: Boolean;
var
  QtdEstDifEstini: Double;
  QtdEstOld, QtdEstNew: Double;
  //Variavel utilizada para assumir o valor da quantidade do estoque para inserir na diferença do ESTOQUE_INI
begin
  //vDadosIni.progressoFuncao('Balanço','Alterando informações do produto...','Etapa 2 de 4');
  dataSet.First;
  while not (dataSet.Eof) do
  begin
    //Preencher lista se tiver item no estoque inicial já feito por algum balanco geral ou diario
    Application.ProcessMessages;
    QtdEstOld := dataSet.FieldByName('EST_F').AsFloat;
    
    _vEstoqueINI._AbreEstoqueINI(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString);

    //Se item já foi contado no balanço
    if (_vContadoBalanco._AbreContado(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString)) then
    begin
      if not (Edit) then
        raise Exception.Create('Erro ao editar produto');
      {!!!# Inserir no diagrama}
      if (_SubstituiDiferencaEstoque) then
      begin
        dataSet.FieldByName('EST_F').AsFloat := dataSet.FieldByName('EST_F').AsFloat +
          _vContadoBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat;
      end
      else
      begin
        if (vDadosIni.vSupermercado = 'S') then
        begin
          //Substituir a quantidade que do estoque pe la que foi contado no balanço
          dataSet.FieldByName('EST_F').AsFloat :=
            _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat;
        end
        else
        begin
          //Códigodo programa antigo
          //           vest := (QrProdutosEST_F.value - (QrProdTrSUM.value + QrProdRqSUM.value));
          //          QrProdutos.edit;
          //          QrProdutosEST_F.value := QrProdutosEST_F.value + (QrContadoQTDE_PROD.value - vest);
          //
          //          if QrContadoQTDE_PROD.value > vest then
          //          begin
          //            vdifest := (QrContadoQTDE_PROD.value - vest);
          //            // Alterar QrProdutosESTS para QrProdutosEST_F - Herbert 11:20 13/10/2011
          //            QrProdutosESTS.value := QrProdutosESTS.value - vdifest;
          //          end;

          //Soma a quantidade de itens em Os abertas com Req abertas com a quantidade contada e coloca no estoque
          _AlterarQuantEst(_vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat);
        end;
      end;

      //Verificar se a alocacao do que foi contado no balanco nao e nulo
      if trim(_vContadoBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString) <> '' then
      begin
        //Substituir a alocacao do produto pela que foi informada no balanco
        dataSet.FieldByName('LOCACAO_PROD').AsString :=
          _vContadoBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString;
      end;

      //Verificar se a alocacao do que foi contado no balanco nao e nulo
      if trim(_vContadoBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString) <> '' then
      begin
        //Substituir a alocacao do produto pela que foi informada no balanco
        dataSet.FieldByName('LOCACAO_PROD_1').AsString :=
          _vContadoBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString;
      end;

      QtdEstNew := dataSet.FieldByName('EST_F').AsFloat;

      if not (Post) then
        raise Exception.Create('Erro ao editar produto');

      if dataSet.ChangeCount > 0 then
        if not Apply then
          registraErro('GRUPO_PROD: ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
            ' COD_PROD: ' + trim(dataSet.FieldByName('COD_PROD').AsString) +
          	' EST_F OLD: ' + FormatFloat('0.000', QtdEstOld) +
            ' EST_F NEW: ' + FormatFloat('0.000', QtdEstNew) +
            ' SQL: ' + dataSet.CommandText);

      //Preencher estoque INI e gravar
      _InserirEstoqueINI(_vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat,
        (_vContadoBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat));

    end
    else
    begin //Se o item não foi contado no balanço
      QtdEstDifEstini := 0;
      QtdEstDifEstini := dataSet.FieldByName('EST_F').AsFloat -
      	_PegarReqOs(dataSet.FieldByName('COD_PROD').AsString, dataSet.FieldByName('GRUPO_PROD').AsString);
      if not (Edit) then
        raise Exception.Create('Erro ao editar produto');
      //Zera o estoque de produtos não contados caso a no config Supermercado=S ou ZerarEstFNaoContNoBalanco=S
      if (vDadosIni.vSupermercado = 'S') then
      //or (vDadosIni.vZerarEstFNaoContNoBalanco = 'S') then
      begin
        dataSet.FieldByName('EST_F').AsFloat := 0;
      end
      else
      begin
        _AlterarQuantEst(0);
      end;

      QtdEstNew := dataSet.FieldByName('EST_F').AsFloat;
      
      if not (Post) then
        raise Exception.Create('Erro ao editar produto');

      if dataSet.ChangeCount > 0 then
        if not Apply then
          registraErro('GRUPO_PROD: ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
            ' COD_PROD: ' + trim(dataSet.FieldByName('COD_PROD').AsString) +
            ' EST_F OLD: ' + FormatFloat('0.000', QtdEstOld) +
            ' EST_F NEW: ' + FormatFloat('0.000', QtdEstNew) +
            ' SQL: ' + dataSet.CommandText);

      //Preencher estoque INI e gravar
      _InserirEstoqueINI(0, (QtdEstDifEstini * (-1)));
    end;
    dataSet.Next;
    vInc := vInc + 1;
//    _vGContador := _vContador + _vGContador;
    if (vInc mod 100) = 0 then
      vDadosIni.abreStatusProcessamento('Finalizando balanço', 'Alterando estoque de produto. ' + IntToStr(vInc) + ' de ' + IntToStr(Trunc(_vContador)));
    _GaugeBalanco.Progress := trunc(100 / _vContador * vInc);
  end;
end;

function TBalancoProduto._ConfirmarGradeBalanco: Boolean;
var
	QtdEstOld, QtdEstNew: Double;
begin
  //vDadosIni.progressoFuncao('Finalizando o balanço...','Alterando informações do produto com grade','Etapa 2 de 2');
  _vGradeBalanco.dataSet.First;
  while not (_vGradeBalanco.dataSet.Eof) do
  begin
    Application.ProcessMessages;

    QtdEstOld := _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat;
    //Preencher lista se tiver item no estoque inicial com grade já feito por algum balanco geral ou diario
    _vEstoqueINIGrade._AbreEstoqueINIGrade(
      _vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString);

    //Preenche lista dos itens e verifica se tem algum item contado com grade
    if (_vGradeContadosBalanco._AbreGradeContBalanco(
      _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString)) then
    begin
      {!!!# Inserir no diagrama}
      if (_SubstituiDiferencaEstoque) then
      begin
        //Inserir item no estoque inicial com grade
        _InserirEstoqueINIGrade(_vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat +
          _vGradeContadosBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat,
          _vGradeContadosBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('COD_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('COD_GRADE').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString);

        if not (_vGradeBalanco.Edit) then
          raise Exception.Create('Erro ao editar grade do produto');

        _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat :=
           _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat +
           _vGradeContadosBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat;

        QtdEstNew := _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat;

        if not (_vGradeBalanco.Post) then
          raise Exception.Create('Erro ao editar grade do produto');

        if _vGradeBalanco.dataSet.ChangeCount > 0 then
	        if not _vGradeBalanco.Apply then
          	registraErro('GRUPO_PROD: ' + IntToStr(_vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
              ' COD_PROD: ' + trim(_vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString) +
              ' COD_GRADE: ' + IntToStr(_vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsInteger) +
              ' QTDE OLD: ' + FormatFloat('0.000', QtdEstOld) +
	            ' QTDE NEW: ' + FormatFloat('0.000', QtdEstNew) +
              ' SQL: ' + _vGradeBalanco.dataSet.CommandText);
      end
      else
      begin
        //Inserir item no estoque INI com grade
        _InserirEstoqueINIGrade(_vGradeContadosBalanco.dataSet.FieldByName('QTDE').AsFloat,
          _vGradeContadosBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('COD_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('COD_GRADE').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString,
          _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString);

        //Alterar a quantidade dos itens contado no balanço com grade
        _InserirGradeProduto(_vGradeContadosBalanco.dataSet.FieldByName('QTDE').AsFloat);
      end;
    end
    else
    begin
      //Inserir item no estoque inicial com grade zerando a quantidade
      if (_SubstituiDiferencaEstoque) then
      begin
        //Inserir item no estoque inicial com grade
        _InserirEstoqueINIGrade(0,
          _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString,
          '',
          '');
        if not (_vGradeBalanco.Edit) then
          raise Exception.Create('Erro ao editar grade do produto');

        _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat :=
          strtofloat(_PegarReqOSGrade(_vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString));

        QtdEstNew := _vGradeBalanco.dataSet.FieldByName('QTDE').AsFloat;
        
        if not (_vGradeBalanco.Post) then
          raise Exception.Create('Erro ao editar grade do produto');

        if _vGradeBalanco.dataSet.ChangeCount > 0 then
          if not _vGradeBalanco.Apply then
            registraErro('GRUPO_PROD: ' + IntToStr(_vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
              ' COD_PROD: ' + trim(_vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString) +
              ' COD_GRADE: ' + IntToStr(_vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsInteger) +
              ' QTDE OLD: ' + FormatFloat('0.000', QtdEstOld) +
	            ' QTDE NEW: ' + FormatFloat('0.000', QtdEstNew) +
              ' SQL: ' + _vGradeBalanco.dataSet.CommandText);
      end
      else
      begin
      	//Inserir item no estoque INI com grade
        _InserirEstoqueINIGrade(0,
          _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
          _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString,
          '',
          '');
          
        //Alterar a quantidade dos itens contado no balanço com grade zerando a quantidade
        _InserirGradeProduto(0);
      end;
    end;
    _vGradeBalanco.dataSet.Next;
    vInc := vInc + 1;
//    _vGContador := _vContador + _vGContador;
    if (vInc mod 100) = 0 then
      vDadosIni.abreStatusProcessamento('Finalizando balanço', 'Alterando estoque de Grade de produto. ' + IntToStr(vInc) + ' de ' + IntToStr(Trunc(_vContador)));
    _GaugeBalanco.Progress := trunc(100 / _vContador * vInc);
//    _vGContador := _vContador + _vGContador;
//    _GaugeBalanco.Progress := trunc(_vGContador);
  end;
end;

