  if not dataSet.Active then
    montaSelect('select * from TIPO_SERVICO_MECANICO where 1 = 0');

  if inherited insert then
  begin
    dataSet.FieldByName('USUARIO_AUTORIZOU').AsString := vDadosIni.vNomeUsuario;
    dataSet.FieldByName('DATA_EXECAO').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    result := true;
  end;
end;

function TTipoServMecanico.post(cod_servico, cod_vendedor: string): boolean;
begin
  try
    dataSet.FieldByName('COD_SERVICO').AsString := cod_servico;
    dataSet.FieldByName('COD_VENDEDOR').AsString := cod_vendedor;

    if dataSet.FieldByName('COD_VENDEDOR').AsString = '' then
      if vDadosIni.vEmp.vUsarAparelho = 'S' then
        raise exception.Create('Técnico não informado.')
      else
        raise exception.Create('Mecânico não informado.');

    result := inherited post;

    if dataset.ChangeCount = 0 then
    begin
      result := true;
      exit;
    end;

    if apply then
      CommitaTransacao
    else begin
      dataset.Cancel;
      RollBackTransacao;
      result := false;
    end;
    dataSet.Refresh;
  except
    on e: Exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
  Refresh;
end;

{ TProdutosConversao }

function TProdutosConversao.cancel: Boolean;
begin
  inherited cancel;
  RollBackTransacao;
end;

constructor TProdutosConversao.create;
begin
  DataSet := TClientDataSet(dtmProdutos.cdsProdutosConversao);
  transacao := TIBTransaction(dtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(dtmProdutos.qrBuscas);

  (dataSet.FieldByName('QUANTIDADE') as TFloatField).DisplayFormat :=
  	'#,##0.' + PadL(0, vDadosIni.vEmp.vCasasDecimais);
end;

function TProdutosConversao.Delete(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vcodigo_ean: string): boolean;
begin
  Result := False;

  _abreProdutosConversao(vgrupo_prod, vcod_prod, vcodigo_ean);

  if dataSet.IsEmpty then
    exit;

  if not vDadosIni.PesqPros('PRO250', 'EXCLUIR',
  	'EAN: ' + trim(vcodigo_ean), 'PRODUTOS_CONVERSAO',
    IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja apagar este registro?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  result := inherited Delete;
  if Result then
    result := Apply;

  if result then
    result := CommitaTransacao;

  if Result then
    vDadosIni.GravaAuditoria('PRO250', 'EXCLUIR',
    	'SUCESSO - EAN: ' + trim(vcodigo_ean), 'PRODUTOS_CONVERSAO',
      IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas)
  else
    vDadosIni.GravaAuditoria('PRO250', 'EXCLUIR',
    	'FALHA - EAN: ' + trim(vcodigo_ean), 'PRODUTOS_CONVERSAO',
      IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas);

  Result := true;
  Refresh;

end;

function TProdutosConversao.edit(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vcodigo_ean: string): boolean;
begin
	Result := False;
  if not vDadosIni.PesqPros('PRO450', 'ALTERAR', '', 'PRODUTOS_CONVERSAO',
    '', buscas, True) then
    Exit;

  _abreProdutosConversao(vgrupo_prod, vcod_prod, vcodigo_ean);

  if dataSet.IsEmpty then
    exit;

  if inherited Edit then
    Result := True;
end;

function TProdutosConversao.Insert(
	vgrupo_prod: Integer;
  vcod_prod: string): boolean;
begin
	Result := False;
  if not vDadosIni.PesqPros('PRO249', 'INCLUIR', '', 'PRODUTOS_CONVERSAO',
    '', buscas, True) then
    Exit;

  _abreProdutosConversao(vgrupo_prod, vcod_prod, '');

  if inherited Insert then
  begin
    Result := True;
    dataSet.FieldByName('GRUPO_PROD').AsInteger := vgrupo_prod;
    dataSet.FieldByName('COD_PROD').AsString := vcod_prod;
    dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
  end;
end;

function TProdutosConversao.post: boolean;
var
  acao: string;
  vgrupo_prod: Integer;
  vcod_prod: string;
  vean: string;
begin
  try
    Result := false;

    vgrupo_prod := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    vcod_prod := trim(dataSet.FieldByName('COD_PROD').AsString);
    vean := trim(dataSet.FieldByName('CODIGO_EAN').AsString);

    if not vDadosIni.PesqPros('PRO251', 'SALVAR',
    	vean, 'PRODUTOS_CONVERSAO',
      IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if vFatorPrinc <= 0 then
      raiseExceptionCreate('Fator da unidade principal deve ser informado', 'EditMoedaFatorPrinc');

    if vFatorConv <= 0 then
			raiseExceptionCreate('Fator da unidade convertida deve ser informado', 'EditMoedaFatorConv');

    if (vFatorPrinc <= 1) and (vFatorConv <= 1) then
			raiseExceptionCreate('Fator da unidade principal deve ser diferente do fator da unidade convertida', 'EditMoedaFatorPrinc');

    if vFatorPrinc > 1 then
    	dataSet.FieldByName('QUANTIDADE').AsFloat := (vFatorPrinc)
    else if vFatorConv > 1 then
    	dataSet.FieldByName('QUANTIDADE').AsFloat := (1 / vFatorConv);

    if trim(dataSet.FieldByName('CODIGO_EAN').AsString) = '' then
      raiseExceptionCreate('Código EAN deve ser informada', 'DBEditCodigoEAN');

    if trim(dataSet.FieldByName('UNIDADE').AsString) = '' then
      raiseExceptionCreate('Unidade de medida deve ser informada', 'DBComboBoxUnidadeConv');

    if dataSet.FieldByName('QUANTIDADE').AsFloat <= 0 then
      raiseExceptionCreate('Quantidade deve ser informada', 'EditMoedaFatorConv');

    if not SqlOpen(' select grupo_prod, cod_prod, cod_empresa, unidade from produtos ' +
    	' where grupo_prod = ' + IntToStr(vgrupo_prod) +
      ' and cod_prod = ' + QuotedStr(vcod_prod) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).IsEmpty then
    begin
      if UpperCase(trim(buscas.FieldByName('unidade').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) then
        raiseExceptionCreate('Unidade principal deve ser diferente da unidade convertida', 'DBComboBoxUnidadeConv');
    end;


    if acao = 'INSERIR' then
      if not _existeProduto(
        dataSet.FieldByName('GRUPO_PROD').AsInteger,
        dataSet.FieldByName('COD_PROD').AsString,
        dataSet.FieldByName('CODIGO_EAN').AsString) then
      begin
      Application.MessageBox('Código EAN já consta nesta conversão', 'Atenção', MB_ICONWARNING + MB_OK);
      exit;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('PRO251', acao,
      	'SUCESSO - ' + vean,
        'PRODUTOS_CONVERSAO',
        IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas)
    else
      vDadosIni.GravaAuditoria('PRO251', acao,
      	'FALHA - ' + vean,
        'PRODUTOS_CONVERSAO',
        IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;

end;

function TProdutosConversao._abreProdutosConversao(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vcodigoean: string = ''): boolean;
begin
  result := montaSelect('select p.* from produtos_conversao p ' +
    ' where p.grupo_prod = ' + IntToStr(vgrupo_prod) +
    ' and p.cod_prod = ' + QuotedStr(vcod_prod) +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
    vDadosIni.IfThen(trim(vcodigoean) <> '',
    	' and p.codigo_ean = ' + QuotedStr(vcodigoean), ''));
end;

function TProdutosConversao._existeProduto(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vean: string): boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select grupo_prod, cod_prod from produtos_conversao where ' +
    ' grupo_prod = ' + IntToStr(vgrupo_prod) +
    ' and cod_prod = ' + QuotedStr(vcod_prod) +
    ' and codigo_ean = ' + QuotedStr(vean) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  Result := buscas.IsEmpty;

end;

