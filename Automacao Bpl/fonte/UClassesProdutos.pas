function TPromocao._restauralixeira: boolean;
var
	vCodPromTab: string;
	vDescPromTab: string;
  vtemp: string;
  I: Integer;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCodPromTab  := trim(dataSet.FieldByName('COD_PROMOCAO').AsString);
      vDescPromTab := trim(dataSet.FieldByName('DESCR_PROMOCAO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCodPromTab  := '';
        vDescPromTab := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCodPromTab) <> '') then
      	prepare_loop('COD_PROMOCAO = ' + vCodPromTab)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'TABELA') + #13 +
        'Código: ' + vCodPromTab + #13 +
        'Descrição: ' + vDescPromTab;

      if (trim(vDescPromTab) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO228', 'RESTAURAR', '', 'PROMOCAO',
        vDadosIni.IfThen(trim(vCodPromTab) <> '', vCodPromTab, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)'));

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)') + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        vDadosIni.verificarReplicacaoInterna(buscas, true);
        if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
        begin
          for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
          begin
            SqlExec(' update promocao set ativo = 1 ' +
              ' where cod_promocao = %d and cod_tppreco = %d and cod_empresa = %d ',
              [fint('cod_promocao'), fint('cod_tppreco'), StrToInt(vDadosIni.vReplicaoInternaEmpresa[i])], buscas);
          end;

        	if (trim(vCodPromTab) = '') then
	          vDadosIni.GravaAuditoria('PRO228', 'RESTAURAR', '', 'PROMOCAO',
  	          dataSet.FieldByName('COD_PROMOCAO').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO228', 'RESTAURAR', 'SUCESSO', 'PROMOCAO',
        vDadosIni.IfThen(trim(vCodPromTab) <> '', vCodPromTab, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO228', 'RESTAURAR', 'FALHA', 'PROMOCAO',
        vDadosIni.IfThen(trim(vCodPromTab) <> '', vCodPromTab, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

