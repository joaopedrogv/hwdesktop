function TEtiquetasComum.existeProduto(pCodigo: string): string;
var
  fOldGrupo: integer;
  fOldCodigo: string;
begin
	fOldGrupo := 0;
  fOldCodigo := '';

  if not fGrade.Active then
  begin
    fGrade.Close;
    fGrade.CommandText :=
      ' select 0 ordem, 0 cod_grade, ''SEM GRADE'' DESCRICAO, ''SEM GRADE'' DESCRICAO1, ' + vDadosIni.codEmpresa + ' cod_empresa, 1 ativo from rdb$database' +
      ' union ' +
      ' select 1 ordem, cod_grade, descricao, descricao1, cod_empresa, ativo from grade ' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cod_grade > 0 ' +
      ' order by 1, 3 ';
    fGrade.Open;
  end;
  if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
  begin
    fBuscas2.Close;
    fBuscas2.SQL.Text := 'select grupo_prod, cod_prod, descr_prod, aplicacao_prod, prec_tab_prod,' +
      ' prec_30_prod, num_fab_prod from produtos where cod_prod = ' + QuotedStr(pCodigo) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    fBuscas2.Open;
    fOldGrupo := fBuscas2.FieldByName('grupo_prod').AsInteger;
    fOldCodigo := trim(fBuscas2.FieldByName('cod_prod').AsString);
  end
  else
  begin
    fBuscas2.Close;
    fBuscas2.SQL.Text := 'select grupo_prod, cod_prod from cod_barra' +
      ' where cod_barra = ' + QuotedStr(pCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    fBuscas2.Open;
    fOldGrupo := fBuscas2.FieldByName('grupo_prod').AsInteger;
    fOldCodigo := trim(fBuscas2.FieldByName('cod_prod').AsString);

    fBuscas2.Close;
    fBuscas2.SQL.Text := 'select grupo_prod, cod_prod, descr_prod, aplicacao_prod, prec_tab_prod,' +
      ' prec_30_prod, num_fab_prod from produtos where grupo_prod = ' + IntToStr(fOldGrupo) +
      ' and cod_prod = ' + QuotedStr(fOldCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    fBuscas2.Open;
  end;
  if fBuscas2.IsEmpty then
    Result := 'PRODUTO NÃO ENCONTRADO'
  else
    Result := Trim(fBuscas2.FieldByName('cod_prod').AsString) + ' ' +
      Trim(fBuscas2.FieldByName('descr_prod').AsString) + ' Ref. ' +
      Trim(fBuscas2.FieldByName('aplicacao_prod').AsString);
  fBuscas2.Close;
  fBuscas2.SQL.Text := 'select first 1 cgp.cod_grade from cod_grade_prod cgp' +
    ' inner join grade g on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa' +
    ' where cgp.grupo_prod = ' + IntToStr(fOldGrupo) +
    ' and cgp.cod_prod = ' + QuotedStr(fOldCodigo) +
    ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa;
  fBuscas2.Open;
  vProdComGrade := fBuscas2.IsEmpty;
  fBuscas2.Close;
end;

function TEtiquetasComum.getCodigo(pCodigo: string): string;
var
  fOldGrupo: Integer;
  fOldCodigo: string;
begin
  if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod from cod_barra' +
      ' where cod_barra = ' + QuotedStr(pCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    fOldGrupo := buscas.FieldByName('grupo_prod').AsInteger;
    fOldCodigo := buscas.FieldByName('cod_prod').AsString;

    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod, descr_prod, aplicacao_prod, prec_tab_prod,' +
      ' prec_30_prod, num_fab_prod from produtos where grupo_prod = ' + IntToStr(fOldGrupo) +
      ' and cod_prod = ' + QuotedStr(fOldCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    Result := Trim(buscas.FieldByName('cod_prod').AsString);
  end
  else
  begin
    Result := Trim(pCodigo);
  end;
end;

function TEtiquetasComum.montarDataSetNF(pUmProd: Boolean; pTelaCadastro: Integer): boolean;
var
	I, J, vQtde: Integer;
begin
	Result := False;
	if pTelaCadastro = 6 then
  begin
  	fEtiquetaC.EmptyDataSet;
    
    buscas.Close;
    buscas.SQL.Text := 'select coalesce(grcomp.qtde,it4.quantidade,1) as qtde, ' +
      ' coalesce(grcomp.cod_grade,0) as cod_grade, ' +
      ' (case when ((grcomp.cod_grade is null) or (grcomp.cod_grade=0)) then ''SEM GRADE'' else gra.descricao end) as DESCRICAO, ' +
      ' pr.*, ' +
      ' (case when ((grcomp.cod_grade is null) or (grcomp.cod_grade=0)) then ''SEM GRADE'' else gra.descricao1 end) as DESCRICAO1 ' +
      ' from notafiscal nf4 inner join notafiscal_item it4 ' +
      ' on nf4.cod_nf=it4.cod_nf and nf4.cod_empresa=it4.cod_empresa ' +
      ' inner join produtos pr ' +
      ' on it4.grupo_prod=pr.grupo_prod and it4.cod_prod=pr.cod_prod and it4.cod_empresa = pr.cod_empresa ' +
      ' left join cod_grade_prod_compra grcomp ' +
      ' on it4.grupo_prod = grcomp.grupo_prod and it4.cod_prod = grcomp.cod_prod ' +
      ' and it4.cod_empresa = grcomp.cod_empresa and it4.cod_nf = grcomp.num_nota_nfe and it4.nitem = grcomp.cod_forn_nfe ' +
      ' left join grade gra on grcomp.cod_grade = gra.cod_grade and grcomp.cod_empresa = gra.cod_empresa ' +
      ' where nf4.cod_nf=' + inttostr(vDadosIni.vTagCodNF) +
      ' and nf4.cod_empresa=' + vDadosIni.codEmpresa;
    buscas.Open;

    while not buscas.Eof do
    begin
    	vQtde := Trunc(buscas.FieldByName('QTDE').AsFloat);
      if pUmProd then
        vQtde := 1;

    	for J := 0 to vQtde - 1 do
      begin
        fEtiquetaC.Insert;
        for I := 0 to buscas.Fields.Count - 1 do
        begin
          if fEtiquetaC.Fields.FindField(buscas.Fields[I].FieldName) is TField then
            if buscas.Fields[i].FieldName = 'NUM_FAB_PROD' then
              fEtiquetaC.FieldByName('NUM_FAB_PROD').AsString := trim(Buscas.FieldByName('NUM_FAB_PROD').AsString)
            else
            if fEtiquetaC.Fields.FindField(buscas.Fields[i].FieldName).FieldName =
              buscas.Fields[i].FieldName then
            begin
              if UpperCase(buscas.Fields[i].FieldName) = 'QTDE' then
                fEtiquetaC.Fields.FindField(buscas.Fields[i].FieldName).AsVariant := 1
              else
                fEtiquetaC.Fields.FindField(buscas.Fields[i].FieldName).AsVariant := buscas.Fields[i].AsVariant;
            end;
        end;

        fEtiquetaC.FieldByName('BARCODE').AsString :=
          vDadosIni.retornaCodBarraEtiqueta(
            buscas,
            buscas.FieldByName('GRUPO_PROD').AsInteger,
            buscas.FieldByName('COD_PROD').AsString,
            buscas.FieldByName('COD_GRADE').AsInteger,
            buscas.FieldByName('NUM_FAB_PROD').AsString);

        fEtiquetaC.FieldByName('BARCODE_EAN').AsString :=
          vDadosIni.retornaCodBarraEtiqueta(
            buscas,
            buscas.FieldByName('GRUPO_PROD').AsInteger,
            buscas.FieldByName('COD_PROD').AsString,
            buscas.FieldByName('COD_GRADE').AsInteger,
            buscas.FieldByName('NUM_FAB_PROD').AsString,
            False,
            True);

        fEtiquetaC.Post;
      end;
      buscas.Next;
    end;
  end;

  Result := True;
end;

