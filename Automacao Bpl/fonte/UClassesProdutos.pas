function TPromocao.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_PromTab: string;
  vDesc_Prom_Tab: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_PromTab   := trim(dataSet.FieldByName('COD_PROMOCAO').AsString);
      vDesc_Prom_Tab := trim(dataSet.FieldByName('DESCR_PROMOCAO').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_PromTab   := '';
        vDesc_Prom_Tab := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_PromTab) <> '') then
        prepare_loop('COD_PROMOCAO = ' + vCod_PromTab)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'TABELA') + #13 +
          'Código: ' + vCod_PromTab + #13 +
          'Descrição: ' + vDesc_Prom_Tab;

        if (trim(vCod_PromTab) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO226', 'EXCLUIR', '', 'PROMOCAO',
          vDadosIni.IfThen(trim(vCod_PromTab) <> '', vCod_PromTab, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'TABELA') + #13 +
          'Código: ' + vCod_PromTab + #13 +
          'Descrição: ' + vDesc_Prom_Tab;

        if (trim(vCod_PromTab) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO227', 'EXCLUIR', '', 'PROMOCAO',
           vDadosIni.IfThen(trim(vCod_PromTab) <> '', vCod_PromTab, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)') + ' permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)') + ' para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if ExecutaComandosSql('select 1 first from promocao_produto ' +
          ' where cod_promocao = ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger) +
          ' and cod_empresa =  ' + vDadosIni.codEmpresa) then
        begin
        	vtemp := vDadosIni.IfThen(dataSet.FieldByName('TIPO').AsString = 'P',  'Promoção', 'Tabela de Preço') +
              '	não pode ser excluída pois está vinculado a um produto' + #13 + #13 +
            vDadosIni.IfThen(dataSet.FieldByName('TIPO').AsString = 'P', 'PROMOCAO', 'TABELA') + #13 +
            'Código: ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger) + #13 +
            'Descrição: ' + trim(dataSet.FieldByName('DESCR_PROMOCAO').AsString);

          Application.MessageBox(PChar(vtemp), 'Atenção', 0 + 64);
          Exit;
        end;

        dataset.Next;
      end;

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)') + ' permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'promoção (ões)', 'tabela (s)') + ' para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
        	vDadosIni.verificarReplicacaoInterna(buscas, true);
          if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
          begin
          	for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
        		begin
              SqlExec(' delete from promocao ' +
                ' where cod_promocao = %d and cod_tppreco = %d and cod_empresa = %d ',
                [fint('cod_promocao'), fint('cod_tppreco'), StrToInt(vDadosIni.vReplicaoInternaEmpresa[i])], buscas);
            end;

            if (trim(vCod_PromTab) = '') then
              vDadosIni.GravaAuditoria('PRO226', 'EXCLUIR', '', 'PROMOCAO',
                dataSet.FieldByName('COD_PROMOCAO').AsString, buscas);
          end;
        end
        else
        begin
        	vDadosIni.verificarReplicacaoInterna(buscas, true);
          if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
          begin
          	for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
        		begin
              SqlExec(' update promocao set ativo = 0 ' +
                ' where cod_promocao = %d and cod_tppreco = %d and cod_empresa = %d ',
                [fint('cod_promocao'), fint('cod_tppreco'), StrToInt(vDadosIni.vReplicaoInternaEmpresa[i])], buscas);
            end;

            if (trim(vCod_PromTab) = '') then
              vDadosIni.GravaAuditoria('PRO227', 'EXCLUIR', '', 'PROMOCAO',
                dataSet.FieldByName('COD_PROMOCAO').AsString, buscas);
          end;
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO226', 'PRO227'),
        'EXCLUIR', 'SUCESSO', 'PROMOCAO',
        vDadosIni.IfThen(trim(vCod_PromTab) <> '', vCod_PromTab, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO226', 'PRO227'),
        'EXCLUIR', 'FALHA', 'PROMOCAO',
        vDadosIni.IfThen(trim(vCod_PromTab) <> '', vCod_PromTab, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocao.edit: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('PRO225', 'ALTERAR', '', 'PROMOCAO',
    '', buscas, false) then
    Exit;

  if inherited Edit then
  begin
    Result := True;
    dataSet.FieldByName('DESCR_PROMOCAO').AsString := dataSet.FieldByName('DESCR_PROMOCAO').AsString;
    dataSet.FieldByName('COD_TPPRECO').AsInteger := dataSet.FieldByName('COD_TPPRECO').AsInteger;

    if trim(dataSet.FieldByName('USAR_DEBCRED').AsString) <> 'N' then
    	dataSet.FieldByName('USAR_DEBCRED').AsString := 'S';

    dataSet.FieldByName('DATA_INI').AsString := dataSet.FieldByName('DATA_INI').AsString;
    dataSet.FieldByName('DATA_FIM').AsString := dataSet.FieldByName('DATA_FIM').AsString;
    dataSet.FieldByName('HORA_INI').AsString := dataSet.FieldByName('HORA_INI').AsString;
    dataSet.FieldByName('HORA_FIM').AsString := dataSet.FieldByName('HORA_FIM').AsString;

    if (Length(dataSet.FieldByName('HORA_INI').AsString) > 4) and (Length(dataSet.FieldByName('HORA_INI').AsString) < 8) then
      dataSet.FieldByName('HORA_INI').AsString := dataSet.FieldByName('HORA_INI').AsString + ':' + Copy(dataSet.FieldByName('HORA_INI').AsString, 4, 2);
    if (Length(dataSet.FieldByName('HORA_FIM').AsString) > 4) and (Length(dataSet.FieldByName('HORA_FIM').AsString) < 8) then
      dataSet.FieldByName('HORA_FIM').AsString := dataSet.FieldByName('HORA_FIM').AsString + ':' + Copy(dataSet.FieldByName('HORA_FIM').AsString, 4, 2);
    vTipoPreco._abreTipoPrecoPromocao;
  end;
end;

function TPromocao.Insert: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('PRO224', 'INCLUIR', '', 'PROMOCAO', '', buscas, False) then
    Exit;

  if not dataSet.Active then
    montaSelect('select p.*,t.tipo, t.descr_tipo from promocao p ' +
      ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa ' +
      ' where p.cod_promocao = 0 ' +
      ' and p.cod_empresa = 0 ' +
      ' and p.ativo = 0');

