function TPromocaoProduto.DeletePrecoProduto(pPergura: Boolean = True): boolean;
var
	I: Integer;
	vDesTipo: string;
  vCodigo: string;
  vTipo: string;
  vCodPromocao: string;
  vCodTpPreco: string;
  vGrupoProd: string;
  vCodProd: string;
  vCodLocalidade: string;
  vCodSetor: string;
  vCodCidade: string;
  vSigla: string;
  vTemp: string;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
  	  vCodPromocao   := dataSet.FieldByName('COD_PROMOCAO').AsString;
      vCodTpPreco    := dataSet.FieldByName('COD_TPPRECO').AsString;
      vGrupoProd     := dataSet.FieldByName('GRUPO_PROD').AsString;
      vCodProd       := dataSet.FieldByName('COD_PROD').AsString;
      vCodLocalidade := IntToStr(dataSet.FieldByName('COD_LOCALIDADE').AsInteger);
      vCodSetor      := IntToStr(dataSet.FieldByName('COD_SETOR').AsInteger);
      vCodCidade     := IntToStr(dataSet.FieldByName('COD_CIDADE').AsInteger);
      vSigla         := dataSet.FieldByName('SIGLA').AsString;

      vTipo := '';
      if dataSet.FieldByName('COD_TPPRECO').AsInteger = 1 then
      begin
        vCodigo  := dataSet.FieldByName('COD_PROMOCAO').AsString;
        vDesTipo := 'PROMOCAO';
        vTipo    := 'PROMOCAO: ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger);
      end
      else if dataSet.FieldByName('COD_TPPRECO').AsInteger = 2 then
      begin
        vCodigo  := dataSet.FieldByName('COD_LOCALIDADE').AsString;
        vDesTipo := 'LOCALIDADE';
        vTipo    := 'LOCALIDADE: ' + IntToStr(dataSet.FieldByName('COD_LOCALIDADE').AsInteger);
      end
      else if dataSet.FieldByName('COD_TPPRECO').AsInteger = 3 then
      begin
      	vCodigo  := dataSet.FieldByName('COD_SETOR').AsString;
        vDesTipo := 'SETOR';
        vTipo    := 'SETOR: ' + IntToStr(dataSet.FieldByName('COD_SETOR').AsInteger);
      end
      else if dataSet.FieldByName('COD_TPPRECO').AsInteger = 4 then
      begin
        vCodigo  := dataSet.FieldByName('COD_CIDADE').AsString;
        vDesTipo := 'CIDADE';
        vTipo    := 'CIDADE: ' + IntToStr(dataSet.FieldByName('COD_CIDADE').AsInteger);
      end
      else if dataSet.FieldByName('COD_TPPRECO').AsInteger = 5 then
      begin
      	vCodigo  := dataSet.FieldByName('COD_PROMOCAO').AsString;
        vDesTipo := 'AVULSO';
        vTipo    := 'AVULSO: ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger);
      end;

      prepare_loop('Sel = ''S''');

      if not dataset.IsEmpty then
      begin
        vCodPromocao   := '';
        vGrupoProd     := '';
        vCodProd       := '';
        vCodLocalidade := '';
        vCodSetor      := '';
        vCodCidade     := '';
        vSigla         := '';
      end;
    finally
      prepare_loop_done;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas, true);

    try
      if (trim(vCodPromocao) <> '') then
        prepare_loop('COD_PROMOCAO = ' + vCodPromocao +
        	' AND COD_TPPRECO = ' + vCodTpPreco +
        	' AND GRUPO_PROD = ' + vGrupoProd +
          ' AND COD_PROD = ' + vCodProd +
          ' AND COD_LOCALIDADE = ' + vCodLocalidade +
          ' AND COD_SETOR = ' + vCodSetor +
          ' AND COD_CIDADE = ' + vCodCidade +
          ' AND SIGLA = ' + QuotedStr(vSigla))
      else
        prepare_loop('Sel = ''S''');

      vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
        vDesTipo + #13 +
        'Código: ' + vCodigo + #13 +
        'Tipo Venda: ' + retornaSigla(dataSet.FieldByName('SIGLA').AsString) + #13 + #13 +
        'PRODUTO' + #13 +
        'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString + #13 +
        'Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString;

      if (trim(vGrupoProd) = '') then
        vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente' +
          vDadosIni.IfThen(Length(vDadosIni.vReplicaoInternaEmpresa) > 1, ' em todas empresas', '') + '?';

      if not vDadosIni.PesqPros('PRO236', 'EXCLUIR',
      	'', 'PROMOCAO_PRODUTO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd, ''), buscas, false) then
            Exit;

      if pPergura then
        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;

      try
      	dataSet.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
          for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
          begin
            buscas.Close;
            buscas.SQL.Text := 'DELETE FROM PROMOCAO_PRODUTO ' +
              ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
              ' AND COD_TPPRECO = :COD_TPPRECO ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
              ' AND COD_SETOR = :COD_SETOR ' +
              ' AND COD_CIDADE = :COD_CIDADE; ';
            buscas.ParamByName('COD_PROMOCAO').AsInteger := dataSet.FieldByName('COD_PROMOCAO').AsInteger;
            buscas.ParamByName('COD_TPPRECO').AsInteger := dataSet.FieldByName('COD_TPPRECO').AsInteger;
            buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
            buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
            buscas.ParamByName('COD_LOCALIDADE').AsInteger := dataSet.FieldByName('COD_LOCALIDADE').AsInteger;
            buscas.ParamByName('COD_SETOR').AsInteger := dataSet.FieldByName('COD_SETOR').AsInteger;
            buscas.ParamByName('COD_CIDADE').AsInteger := dataSet.FieldByName('COD_CIDADE').AsInteger;
            buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
            buscas.ExecSQL;
          end;

          vDadosIni.GravaAuditoria('PRO236', 'EXCLUIR',
            trim(dataSet.FieldByName('GRUPO_PROD').AsString) + '-' +
            trim(dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
            vTipo,
            'PROMOCAO_PRODUTO',
            IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger), buscas);

          dataset.Next;
        end;
      finally
        dataSet.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    	prepare_loop_done;
    end;

    Result := CommitaTransacao;

    if Result then
    begin
			vDadosIni.GravaAuditoria('PRO236', 'EXCLUIR', 'SUCESSO',
      	'PROMOCAO_PRODUTO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd, ''), buscas);
    end
    else
    begin
      vDadosIni.GravaAuditoria('PRO236', 'EXCLUIR', 'FALHA',
      	'PROMOCAO_PRODUTO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd, ''), buscas);
    end;

  except on E: Exception do
    begin
      buscas.Transaction.Rollback;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO236', 'EXCLUIR', 'FALHA',
      	'PROMOCAO_PRODUTO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd, ''), buscas);
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end; 
end;

function TPromocaoProduto.DeletePrecoProduto(pDateSetProd: TDataSet): boolean;
var
	I: Integer;
  vTipo: string;
  vCodPromocao: Integer;
  vCodTpPreco: Integer;
  vCodLocalidade: Integer;
  vCodSetor: Integer;
  vCodCidade: Integer;
begin
	try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    vCodPromocao   := dataSet.FieldByName('COD_PROMOCAO').AsInteger;
    vCodTpPreco    := dataSet.FieldByName('COD_TPPRECO').AsInteger;
    vCodLocalidade := dataSet.FieldByName('COD_LOCALIDADE').AsInteger;
    vCodSetor      := dataSet.FieldByName('COD_SETOR').AsInteger;
    vCodCidade     := dataSet.FieldByName('COD_CIDADE').AsInteger;

    try
      pDateSetProd.Filtered := false;
      pDateSetProd.Filter := 'sel = ''S'' ';
      pDateSetProd.Filtered := true;

      if pDateSetProd.IsEmpty then
      begin
        Application.MessageBox(pchar('Nenhum produto selecionado'), 'Atenção', 0 + 64);
        exit;
