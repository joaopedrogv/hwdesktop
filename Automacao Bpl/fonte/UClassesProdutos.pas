procedure TProdutosECgrade.montarTreeView(pTipo: string; Produto: TProdutos; pTreeView: TTreeView);
var
  I: Integer;
  vgrade: string;
  buscas2: TIBQuery;
begin
	pTreeView.Items.Clear;
	if pTreeView.Items.Count > 0 then
    while pTreeView.Items.Count > 0 do
      pTreeView.Items[0].Delete;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  abreConsGrade(Produto.dataset, buscas2);

  buscas2.First;
  while not buscas2.Eof do
  begin
    if (pTipo = 'E') then
    begin
      vgrade := IntToStr(buscas2.FieldByName('cod_grade').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString) +
        IfThen(trim(buscas2.FieldByName('tipo_ec').AsString) <> '', ' (' + trim(buscas2.FieldByName('tipo_ec').AsString) + ')', '') +
        IfThen(trim(buscas2.FieldByName('tipo_ec1').AsString) <> '', ' | ' + trim(buscas2.FieldByName('descricao1').AsString) + ' (' + trim(buscas2.FieldByName('tipo_ec1').AsString) + ')', '')  ;

      pTreeView.Items.AddChild(nil, trim(vgrade));
    end
    else if (pTipo = 'C') then
    begin
      vgrade := IntToStr(buscas2.FieldByName('cod_grade').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricaoGrade').AsString);

      pTreeView.Items.AddChild(nil, trim(vgrade));
    end;

    buscas2.Next;
  end;

  for I := 0 to pTreeView.Items.Count - 1 do
    pTreeView.Items[I].Selected := true;

  for I := 0 to pTreeView.Items.Count - 1 do
  begin
    if pTreeView.Items[I].Level = 0 then
    begin
      pTreeView.Items[I].Selected := true;
      Break;
    end;
  end;

end;

procedure TProdutosECgrade.montarTreeViewDB(pTipo: string; Produto: TProdutos;
  pTreeView: TTreeView);
var
  I: Integer;
  vQtde: Integer;
  vgrade: string;
  buscas2: TIBQuery;
begin
	pTreeView.Items.Clear;
	if pTreeView.Items.Count > 0 then
    while pTreeView.Items.Count > 0 do
      pTreeView.Items[0].Delete;

  if pTipo = 'E' then
  begin
    if not vDadosIni.vEcommerce.vHabilitarEcommerce then
      exit;
  end
  else if pTipo = 'C' then
  begin
  	if not vDadosIni.vComercioAberto.vHabilitarComercioAberto then
    	exit;
  end;

  if not (Produto.dataSet.State = dsEdit) then
    exit;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  try
    storeRecNo;
    dataSet.First;
    while not dataSet.Eof do
    begin
      if (pTipo = 'E') and (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
      begin
        SqlOpen('select grade.cod_grade, ' +
          ' coalesce(descricao_ec, grade.descricao) descricao, ' +
          ' coalesce(tipo_ec, '''') tipo_ec, ' +
          ' coalesce(descricao_ec1, '''') descricao1, ' +
          ' coalesce(tipo_ec1, '''') tipo_ec1 from grade ' +
          ' where cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2);
        vgrade := IntToStr(buscas2.FieldByName('cod_grade').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString) +
          IfThen(buscas2.FieldByName('tipo_ec').AsString <> '', ' (' + buscas2.FieldByName('tipo_ec').AsString + ')', '') +
          IfThen(buscas2.FieldByName('tipo_ec1').AsString <> '', ' | ' + trim(buscas2.FieldByName('descricao1').AsString) + ' (' + buscas2.FieldByName('tipo_ec1').AsString + ')', '');

        pTreeView.Items.AddChild(nil, trim(vgrade));
      end
      else if (pTipo = 'C') and (dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S') then
      begin
        SqlOpen('select grade.cod_grade, ' +
          ' coalesce(descricao, '''') descricao, ' +
          ' coalesce(tipo_ec, '''') tipo_ec, ' +
          ' coalesce(descricao1, '''') descricao1, ' +
          ' coalesce(tipo_ec1, '''') tipo_ec1 from grade ' +
          ' where cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2);

        vgrade := IntToStr(buscas2.FieldByName('cod_grade').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

        pTreeView.Items.AddChild(nil, trim(vgrade));
      end;

      dataSet.Next;
    end;

  finally
    restoreRecNo;
  end;
end;

function TProdutosECgrade.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    Result := inherited post;
    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosECgrade.salvarAltEst(pTipo: string; Produto: TProdutos; ProdutosEC: TProdutosEC): boolean;
var
  vEstoque: Double;
  buscas2: TIBQuery;
begin
  try
  	buscas2 := TIBQuery.Create(Application);
	  buscas2.Database := buscas.Database;
  	buscas2.Transaction := buscas.Transaction;

    vEstoque := 0;
    Result := true;

    storeRecNo;

    dataSet.Post;
    Apply;

    abreConsGrade(Produto.dataSet, buscas2);
    dataSet.First;
    while not dataSet.Eof do
    begin
      vEstoque := vEstoque + dataSet.FieldByName('ESTOQUE_EC').AsFloat;

      dataSet.Next;
    end;
    dataSet.First;

    restoreRecNo;

    ProdutosEC.dataSet.FieldByName('ESTOQUE_EC').AsFloat := vEstoque;

    vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO315', 'PRO379'),
    	 'ALTERAR',
      'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
      ' Codigo: ' + dataSet.FieldByName('COD_PROD').AsString +
      ' Grade: ' + dataSet.FieldByName('COD_GRADE').AsString +
      ' Old Est: ' + FloatToStr(vOldEst) +
      ' New Est: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_EC').AsFloat) +
      ' - SUCESSO', 'PRODUTOS_EC_GRADE', '', buscas);
  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO315', 'PRO379'),
       'ALTERAR',
       'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
       ' Codigo: ' + dataSet.FieldByName('COD_PROD').AsString +
       ' Grade: ' + dataSet.FieldByName('COD_GRADE').AsString +
       ' Old Est: ' + FloatToStr(vOldEst) +
       ' New Est: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_EC').AsFloat) +
       ' - FALHA', 'PRODUTOS_EC_GRADE', '', buscas);
      Application.MessageBox(PChar(e.Message), 'Erro', MB_OK + MB_ICONASTERISK);
      registraErro(e.Message);
    end;
  end;
end;

