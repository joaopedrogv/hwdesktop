function TTipoServ._replicarTipoServ: Boolean;
var
	buscas2: TIBQuery;
  J: Integer;
  vTipoServ: Integer;
  vTipoServOrig, vProces, acao, vtemp: string;
begin
	Result := False;

  if dataSet.IsEmpty then
    Exit;

  if Application.MessageBox(pchar('Deseja copiar dados do tipo de serviço' + #13 + #13 +
    dataSet.FieldByName('COD_SERVICO').AsString + ' - ' + dataSet.FieldByName('DESC_SERVICO').AsString), 'Atenção',
    MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> IDYES then
     Exit;

  vProces := 'BAS531';
  acao := 'COPIAR';
  vtemp := dataSet.FieldByName('COD_SERVICO').AsString;

  try
    vTipoServOrig := dataSet.FieldByName('COD_SERVICO').AsString;
    if not vDadosIni.PesqPros(vProces, acao, '',
      'TIPO_SERVICO', vTipoServOrig, buscas, True) then
      Exit;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas.Close;
    buscas.SQL.Text := 'select * from TIPO_SERVICO ' +
      ' where COD_SERVICO = :COD_SERVICO ';
    buscas.ParamByName('COD_SERVICO').AsInteger := StrToInt(vTipoServOrig);
    buscas.Open;

    if buscas.IsEmpty then
      raiseExceptionCreate('Não encontrado o tipo de serviço', '');

    buscas2.close;
    buscas2.SQL.Text := 'select GEN_ID(INC_COD_TIPOSERV,1) from rdb$database';
    buscas2.Open;

    vtemp := IntToStr(buscas2.FieldByName('GEN_ID').asinteger);

    try
       StrToFloat(vtemp);
       if StrToFloat(vtemp) <= 0 then
         raiseExceptionCreate('Código do tipo de serviço informado inválido', '');
    except
      Application.MessageBox('Código do tipo de serviço informado inválido.', 'Atenção', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
      exit;
    end;

    buscas2.Close;
    buscas2.SQL.Text := 'select COD_SERVICO from TIPO_SERVICO ' +
      ' where COD_SERVICO = :COD_SERVICO ';
    buscas2.ParamByName('COD_SERVICO').AsInteger := StrToInt(vtemp);
    buscas2.Open;

    if not buscas2.IsEmpty then
      raiseExceptionCreate('Código do tipo de serviço informado já existe', '');

    vTipoServ := StrToInt(vtemp);

    dataSet.Insert;
    for J := 0 to dataSet.FieldCount - 1 do
    begin
      if dataSet.Fields[J].FieldKind = fkData then
        if buscas.FindField(dataSet.Fields[J].FieldName) <> nil then
          if dataSet.Fields[J].FieldName = 'COD_SERVICO' then
            dataSet.FieldByName(dataSet.Fields[J].FieldName).AsInteger := vTipoServ
          else if dataSet.Fields[J].FieldName = 'DESC_SERVICO' then
            dataSet.FieldByName(dataSet.Fields[J].FieldName).Value := trim(buscas.FieldByName(dataSet.Fields[J].FieldName).Value) + ' COPIA'
          else if dataSet.Fields[J].FieldName = 'COD_EMPRESA' then
          	dataSet.FieldByName(dataSet.Fields[J].FieldName).Value := Null
          else
            dataSet.FieldByName(dataSet.Fields[J].FieldName).Value := buscas.FieldByName(dataSet.Fields[J].FieldName).Value;
    end;
    Result := inherited Post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;
    
    if not Result then
      raiseExceptionCreate('Operação será abortada', '');

    vTipoServEmpresa._abreTodosEmpresas(-1);

    buscas2.Close;
    buscas2.SQL.Text := ' select * from TIPO_SERVICO_EMPRESA ' +
    	' where COD_SERVICO = :COD_SERVICO ';
    buscas2.ParamByName('COD_SERVICO').AsInteger := StrToInt(vTipoServOrig);
    buscas2.Open;
    buscas2.FetchAll;

    buscas2.First;
    while not buscas2.Eof do
    begin
    	buscas.Close;
      buscas.SQL.Text := ' UPDATE OR INSERT INTO TIPO_SERVICO_EMPRESA (COD_SERVICO, COD_EMPRESA) ' +
      	' VALUES (:COD_SERVICO, :COD_EMPRESA) ' +
        ' MATCHING (COD_SERVICO, COD_EMPRESA); ';
			buscas.ParamByName('COD_SERVICO').AsInteger := vTipoServ;
      buscas.ParamByName('COD_EMPRESA').AsInteger := buscas2.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ExecSQL;

    	buscas2.Next;
    end;

    if Result then
      Result := CommitaTransacao
    else
    	RollBackTransacao;

    if Result then
      vDadosIni.GravaAuditoria(vProces, acao, 'SUCESSO', 'TIPO_SERVICO', vTipoServOrig, buscas)
    else
      vDadosIni.GravaAuditoria(vProces, acao, 'FALHA', 'TIPO_SERVICO', vTipoServOrig, buscas);

    Result := abreTipoServ(vTipoServ);
  except
    on e: exception do
    begin
      vDadosIni.GravaAuditoria(vProces, acao, 'FALHA', 'TIPO_SERVICO', vTipoServOrig, buscas);
      RollBackTransacao;
      dataSet.Refresh;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TTipoServ._replicarTipoServ. Erro: ' + e.Message);
    end;
  end;
end;

