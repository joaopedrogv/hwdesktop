    except
      vDadosIni.GravaAuditoria('PRO357', 'EXCLUIR', 'FALHA - ' +
      	'Grupo: ' + IntToStr(grupoprod) + ' Cod Prod: ' + codprod,
        'PROD_SIMILARES_GRUPOS_ITENS', IntToStr(codigo), buscas);
      result := false;
    end;
  end;
  Grupo.dataSet.Cancel;
  Grupo.abreGrupoProdSimilares(codigo);
  abreGrupoProdSimilaresItens(codigo);
  if not (Grupo.dataSet.State in [dsInsert, dsEdit]) then
	  Grupo.dataSet.Edit;                                    	
