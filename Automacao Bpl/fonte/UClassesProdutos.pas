function TGrupos.post: boolean;
var
  statusDataset: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      statusDataset := 'E'
    else
      statusDataset := 'I';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raise exception.create('Descrição do grupo não informada');

    if trim(dataSet.FieldByName('CODIGO_GRUP').AsString) = '0' then
      raise exception.create('Grupo não pode ficar com código 0');

    if trim(dataSet.FieldByName('CODIGO_GRUP').AsString) = '' then
      dataSet.FieldByName('CODIGO_GRUP').AsInteger := IncrementaGodigo;

    vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_GRUP').asstring;

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := TRUE;
      Exit;
    end;

    if Apply then
    begin
      if CommitaTransacao then
      begin
        //        IncrementaGodigo;
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO048', 'ALTERAÇÃO CONFIRMADA ', 'SUCESSO', 'GRUPOS',
            dataSet.FieldByName('CODIGO_GRUP').asstring, buscas)

          //          vDadosIni.GravaAuditoria('PRO048', 'ALTEREÇÃO CONFIRMADA ' +
          //            dataSet.FieldByName('CODIGO_GRUP').asstring,
          //          'SUCESSO', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO048', 'INCLUSÃO CONFIRMADA ' +
            dataSet.FieldByName('CODIGO_GRUP').asstring,
            'SUCESSO', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas);
      end
      else
      begin
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO048', 'ALTEREÇÃO NÃO CONFIRMADA ' +
            dataSet.FieldByName('CODIGO_GRUP').asstring,
            'FALHA', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO048', 'INCLUSÃO NÃO CONFIRMADA ' +
            dataSet.FieldByName('CODIGO_GRUP').asstring,
            'FALHA', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas);
      end;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      if statusDataset = 'E' then
        vDadosIni.GravaAuditoria('PRO048', 'ALTEREÇÃO NÃO CONFIRMADA ' +
          dataSet.FieldByName('CODIGO_GRUP').asstring,
          'FALHA', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas)
      else if statusDataset = 'I' then
        vDadosIni.GravaAuditoria('PRO048', 'INCLUSÃO NÃO CONFIRMADA ' +
          dataSet.FieldByName('CODIGO_GRUP').asstring,
          'FALHA', 'GRUPOS', dataSet.FieldByName('CODIGO_GRUP').asstring, buscas);
      //      IncrementaGodigo;
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

