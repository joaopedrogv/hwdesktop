function TProdutosPrecoQtde._abrePrecoProdutos(pDateSet: TDataSet): boolean;
begin
	Result := montaSelect(' SELECT PRECO_PRODUTOS_QTDE.*, ' +
  	' PRODUTOS.PREC_TAB_PROD, PRODUTOS.PREC_CUSM_PROD FROM PRECO_PRODUTOS_QTDE ' +
  	' INNER JOIN PRODUTOS ON ' +
    '		PRODUTOS.GRUPO_PROD = PRECO_PRODUTOS_QTDE.GRUPO_PROD ' +
    '   AND PRODUTOS.COD_PROD = PRECO_PRODUTOS_QTDE.COD_PROD ' +
    '   AND PRODUTOS.COD_EMPRESA = PRECO_PRODUTOS_QTDE.COD_EMPRESA ' +
  	' WHERE PRECO_PRODUTOS_QTDE.GRUPO_PROD = ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' AND PRECO_PRODUTOS_QTDE.COD_PROD = ' + QuotedStr(pDateSet.FieldByName('COD_PROD').AsString) +
    ' AND PRECO_PRODUTOS_QTDE.COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' ORDER BY PRECO_PRODUTOS_QTDE.SIGLA ASC, PRECO_PRODUTOS_QTDE.QUANT ASC');

  try
  	dataset.DisableControls;
    dataset.First;
    while not dataset.Eof do
    begin
    	dataset.Edit;
    	if dataset.FieldByName('PRECO_VENDA').AsFloat > 0 then
          dataSet.FieldByName('PRECO_VENDA_TEMP').AsFloat := dataset.FieldByName('PRECO_VENDA').AsFloat
      else if dataset.FieldByName('PORCENTAGEM').AsFloat <> 0 then
      begin
      	if dataset.FieldByName('PORCENTAGEM').AsFloat > 0 then
        	dataSet.FieldByName('PRECO_VENDA_TEMP').AsFloat := (dataset.FieldByName('PREC_TAB_PROD').AsFloat / 100) *
            (100 + Abs(dataset.FieldByName('PORCENTAGEM').AsFloat))
        else
          dataSet.FieldByName('PRECO_VENDA_TEMP').AsFloat := (dataset.FieldByName('PREC_TAB_PROD').AsFloat / 100) *
            (100 - Abs(dataset.FieldByName('PORCENTAGEM').AsFloat));
      end
      else
          dataSet.FieldByName('PRECO_VENDA_TEMP').AsFloat := 0;

      if dataset.FieldByName('PORCENTAGEM').AsFloat <> 0 then
      begin
        	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := dataset.FieldByName('PORCENTAGEM').AsFloat;
      end
      else if (dataset.FieldByName('PROPORCAO_TABELA').AsFloat > 1) and (vDadosIni.vProduto.vRecalcularPrecoPorQuantidade) then
      begin
          dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := Abs(1 - Abs(dataset.FieldByName('PROPORCAO_TABELA').AsFloat)) * 100;
      end
      else if (dataset.FieldByName('PROPORCAO_TABELA').AsFloat > 0) and (vDadosIni.vProduto.vRecalcularPrecoPorQuantidade) then
      begin
          dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := - Abs(1 - Abs(dataset.FieldByName('PROPORCAO_TABELA').AsFloat)) * 100;
      end
      else if (dataset.FieldByName('PRECO_VENDA').AsFloat > 0)
        and (dataset.FieldByName('PREC_TAB_PROD').AsFloat > 0)
        and (dataset.FieldByName('PREC_TAB_PROD').AsFloat > dataset.FieldByName('PRECO_VENDA').AsFloat) then
          dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := - Abs(
            ((dataset.FieldByName('PRECO_VENDA').AsFloat / dataset.FieldByName('PREC_TAB_PROD').AsFloat) - 1) * 100)
      else if (dataset.FieldByName('PRECO_VENDA').AsFloat > 0)
        and (dataset.FieldByName('PREC_TAB_PROD').AsFloat > 0)
        and (dataset.FieldByName('PRECO_VENDA').AsFloat > dataset.FieldByName('PREC_TAB_PROD').AsFloat) then
          dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := Abs(
            ((dataset.FieldByName('PRECO_VENDA').AsFloat / dataset.FieldByName('PREC_TAB_PROD').AsFloat) - 1) * 100)
      else
          dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := 0;

      if dataset.FieldByName('MAX_DESC').IsNull then
        dataset.FieldByName('MAX_DESC').AsFloat := 0;

      if dataset.FieldByName('MARKUP').IsNull then
        dataset.FieldByName('MARKUP').AsFloat := 0;

    	if dataset.FieldByName('MARGEM').IsNull then
        dataset.FieldByName('MARGEM').AsFloat := 0;

    	dataSet.FieldByName('MARGEM').AsFloat := 0;
    	if (ffloat('markup') > 0) and (ffloat('prec_cusm_prod') > 0) then
      	dataSet.FieldByName('MARGEM').AsFloat := CalcUtils.MargemLucro(ffloat('markup'), DIGROUNDMAX);

      dataset.Post;

      dataset.Next;
    end;

    ffDisplayFormat('PRECO_VENDA', DisplayNumber(vDadosIni.vEmp.vCasasDecimais));
    ffDisplayFormat('MARKUP', DisplayNumber(vDadosIni.vProduto.Precos.DigMrkMrg));
  	ffDisplayFormat('MARGEM', DisplayNumber(vDadosIni.vProduto.Precos.DigMrkMrg));
  finally
    dataset.First;
    dataset.EnableControls;
  end;
end;

