  Result := not FQuery.IsEmpty;	
end;

function TBalancoProduto.arquivoBalancoGeradoEmOutraData(var pData: string): boolean;
var
	vDataBanco, lData: TDateTime;
begin
	Result := False;

  vDataBanco := vDadosIni.getDataBanco(buscas);

  if SqlScalar('select first 1 1 from balanco_produtos b where b.cod_empresa = %d and' +
               ' data_hora_leitura >= (select ts.current_d from sp_current_ts(b.cod_empresa) ts)',
               [vDadosIni.cod_empresa], buscas)
               .AsInteger = 1 then
    Exit;

	buscas.Close;
  buscas.SQL.Text := ' select first 1 grupo_prod, cod_prod, cod_empresa, data_hora_leitura from balanco_produtos ' +
  	' where cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cast(data_hora_leitura as date) <> ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDataBanco)) +
    ' order by data_hora_leitura asc ';
  buscas.Open;

  pData := FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_hora_leitura').AsDateTime);

  Result := not buscas.IsEmpty;
end;

constructor TBalancoProduto.create;
begin
  if dtmBalanco = nil then
    dtmBalanco := TdtmBalanco.Create(dtmBalanco);
  DataSet := TClientDataSet(dtmBalanco.cdsBalanco);
  transacao := TIBTransaction(dtmBalanco.IBTransBalanco);
  Buscas := TIBQuery(dtmBalanco.qrBuscas);
  vMovimentaEstoque := TIBStoredProc(dtmBalanco.SpMovEst);
  FQuery := TIBQuery.Create(nil);
  FQuery.Database := dtmBalanco.qrBuscas.Database;
  FQuery.Transaction := transacao;
  FQuery.Close;
  FQuery.SQL.Text := 'select first 5 bl.cod_barra "Num. Fabricação", ' +
    ' bl.data_hora_leitura "Data e Hora",bl.qtde_prod "Qtd Contada", ' +
    ' bl.grupo_prod "Grupo",bl.cod_prod "Cod. Produto" ,' +
    ' bl.codusuario "Cod. Usuário", pr.descr_prod "Descrição Produto" ' +
    ' from balanco_produtos bl ' +
    ' inner join produtos pr on pr.grupo_prod = bl.grupo_prod and pr.cod_prod = bl.cod_prod and pr.cod_empresa = bl.cod_empresa ' +
    ' where bl.ativo=1 and bl.cod_empresa=' + vDadosIni.codEmpresa +
    ' and bl.codusuario=' + inttostr(vDadosIni.vCodUsuario) +
    ' order by bl.data_hora_leitura desc';
  FQuery.Prepare;
  FQuery.Open;
  if FdsSource = nil then
    FdsSource := TDataSource.Create(nil);
  FdsSource.DataSet := FQuery;
{$REGION 'Relatórios'}

  qrZerados := TIBQuery(dtmBalanco.qrZerados);
  rdZerados := TRDprint(dtmBalanco.rdZerados);
  rdRelCont := TRDprint(dtmBalanco.rdRelCont);
  qrDiferenca := TIBQuery(dtmBalanco.qrDiferenca);
  qrProdutosRel := TIBQuery(dtmBalanco.qrProdutosRel);
  qrTransfArqBal := TIBQuery(dtmBalanco.qrTranfArqBal);
  qrContRel := TIBQuery(dtmBalanco.qrContRel);
  qrSomasProd := TIBQuery(dtmBalanco.qrSomasProd);

{$ENDREGION}

{$REGION 'Variáveis'}

  _vData := vDadosIni.getDataBanco(dtmBalanco.qrBuscas);
  _ItensProd_CodCodbarraCodGradeGrupo_SL := TStringList.Create;
{$ENDREGION}

{$REGION 'Classes'}

  if _vGradeBalanco = nil then
    _vGradeBalanco := TGradeBalanco.create;

  if _vGradeContadosBalanco = nil then
    _vGradeContadosBalanco := TGradeContadosBalanco.create;

  if _vContadoBalanco = nil then
    _vContadoBalanco := TContadoBalanco.create;

  if _vEstoqueINI = nil then
