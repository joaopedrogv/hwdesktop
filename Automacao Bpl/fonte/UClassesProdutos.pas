function TProdutosFretePorPeso.GetDataSetFonecedor(
  idFonec: Integer): TDataSet_OOP;
var
  str: string;
  I: Integer;
begin
  Result := dataFornecedor;

  listClientes.Add(IntToStr(idFonec));

  str := ReplaceText(listClientes.Text + ',', ',,', '');

  dataSet.FieldByName('cod_cliente').OnGetText := nil;
  dataFornecedor.ClientOpen('select cl.cod_cliente, cl.nome_cliente, cl.razao from clientes cl' +
                            ' where cl.cod_cliente in (%s) and cl.cod_empresa = %d' +
                            ' order by cl.nome_cliente', [str, vDadosIni.cod_empresa]);
  dataSet.FieldByName('cod_cliente').OnGetText := GetText;
end;

