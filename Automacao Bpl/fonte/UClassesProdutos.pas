      ' f.aliq_ipi "Aliq IPI", f.base_ipi "Base IPI", f.valor_ipi "Valor IPI", f.data_estoque ' +
      ' from fichaprodutosdetalhada2 f ' +
      ' where f.grupo_prod = :grupo_prod ' +
      ' and f.cod_prod = :cod_prod ' +
      ' and f.cod_empresa = :cod_empresa ' +
      ' and f.data_estoque >= :dataInicio ' +
      ' and f.data_estoque <= :dataFim ' +
      ' order by 6, 4, 1, 2, 5, 13';
   //   3, 1, 2, 5, 4, 10';
     cFichaC.Params.ParamByName('grupo_prod').AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
     cFichaC.Params.ParamByName('cod_prod').AsString := dataSet.FieldByName('cod_prod').AsString;
     cFichaC.Params.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;
     cFichaC.Params.ParamByName('dataInicio').AsDate := StrToDate(dataIni);
     cFichaC.Params.ParamByName('dataFim').AsDate := StrToDate(dataFim);
     cFichaC.Open;

     cFichaC.FieldByName('altera_estoque').DisplayLabel := 'Alterou Estoque';
     cFichaC.FieldByName('data_estoque').DisplayLabel := 'Data Confirmação';

     cFichaC.FieldByName('tipo2').Visible := False;
     cFichaC.FieldByName('ordem').Visible := False;
     cFichaC.FieldByName('data_estoque').Visible := False;
     cFichaC.FieldByName('altera_estoque').Visible := False;

     for I := 0 to cFichaC.Fields.Count - 1 do
       if cFichaC.Fields[i].DataType = ftFloat then
         if (pos('Custo', TFloatField(cFichaC.Fields[i]).DisplayLabel) > 0) or (pos('Quantidade', TFloatField(cFichaC.Fields[i]).DisplayLabel) > 0) then
           TFloatField(cFichaC.Fields[i]).DisplayFormat := '##0.0000'
         else if pos('Valor Unit', TFloatField(cFichaC.Fields[i]).DisplayLabel) > 0 then
           TFloatField(cFichaC.Fields[i]).DisplayFormat := '##0.000'
         else if pos('Custo Med', TFloatField(cFichaC.Fields[i]).DisplayLabel) > 0 then
           TFloatField(cFichaC.Fields[i]).DisplayFormat := '##0.000'
         else TFloatField(cFichaC.Fields[i]).DisplayFormat := '##0.00';

     recalcularQtdeEntradaSaidaC;

     Result := (not cFichaC.IsEmpty);

   except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.abrirComprasEVendasC. Erro: ' + e.Message);
    end;
  end;
end;

