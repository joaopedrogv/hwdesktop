function TProdutos.validarCadastrosSimplificado: Boolean;
var
 vMensagem: string;
begin
  try
    Result := false;

    checkFieldEmpty('grupo_prod'       , 'Grupo do produto de preenchimento obrigatório', 'DBLookupComboBox11');
    checkFieldEmpty('num_fab_prod'     , 'Numero do fabricante do produto de preenchimento obrigatório', 'DBEdit119');
    checkFieldEmpty('descr_prod'       , 'Descrição completa do produto de preenchimento obrigatório', 'DBEdit120');
    checkFieldEmpty('descr_prod_red'   , 'Descrição reduzida do produto utilizada no PAF-ECF de preenchimento obrigatório', 'DBEdit121');
    checkFieldEmpty('unidade'          , 'Unidade de medida do produto de preenchimento obrigatório', 'DBComboBox24');
    checkFieldEmpty('prec_tab_prod'    , 'Preço de varejo do produto de preenchimento obrigatório', 'DBEdit136');

    checkFieldEmpty('codigo_nop'       , 'CFOP de venda de mercadorias dentro do estado de preenchimento obrigatório', 'DBEdit134');
    checkFieldEmpty('cfop_inter_n_cont', 'CFOP de venda de mercadorias para fora do estado a clientes nao contribuintes ou consumidor final de preenchimento obrigatório', 'DBEdit139');
    checkFieldEmpty('cst_prod'         , 'CST de ICMS de preenchimento obrigatório', 'DBEdit143');

    if not TestarCFOP(vMensagem) then
    begin
      Result := False;
      vMensagemErro := vMensagem;
      vNomeCampoErro := 'DBEdit134';
      Exit;
    end;

    if not TestarCFOPInter(vMensagem) then
    begin
      Result := False;
      vMensagemErro := vMensagem;
      vNomeCampoErro := 'DBEdit139';
      Exit;
    end;

    if not TestarCST(dataSet.FieldByName('cst_prod').AsString, vMensagem) then
    begin
      Result := False;
      vMensagemErro := vMensagem;
      vNomeCampoErro := 'DBEdit143';
      Exit;
    end;

    if not validarCamposPersonalizados then
      Exit;

    if (vDadosIni.vEmp.vVersaoVeiculos = '4') and (trim(vDadosIni.vEmp.vTipoEmpVeiculos) = 'C') then
      checkFieldEmpty('tip_prod_ind' , 'Tipo produto de preenchimento obrigatório', 'DBLookupComboBox21');

    if not TestarCSOSN(vMensagem) then
    begin
      Result := False;
      vMensagemErro := vMensagem;
      vNomeCampoErro := 'DBEdit189';
      Exit;
    end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
      if vProdutosEC.dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S' then
      begin
        if dataSet.FieldByName('PESO_BRUT_PROD').AsFloat <= 0 then
        begin
          FrmCadProdutos.pageCadSimples.ActivePage := FrmCadProdutos.tsS_Cadastro;
  	      raiseExceptionCreate('Campo peso bruto não informado', 'DBEdit125');
        end;

        if (dataSet.FieldByName('COMPRIMENTO_PROD').AsInteger <= 0) then
        begin
        	FrmCadProdutos.pageCadSimples.ActivePage := FrmCadProdutos.tsS_Cadastro;
          raiseExceptionCreate('Campo comprimento não informado', 'DBEdit215');
        end;

        if (dataSet.FieldByName('ALTURA_PROD').AsInteger <= 0) then
        begin
          FrmCadProdutos.pageCadSimples.ActivePage := FrmCadProdutos.tsS_Cadastro;
          raiseExceptionCreate('Campo altura não informado', 'DBEdit216');
        end;

        if (dataSet.FieldByName('LARGURA_PROD').AsInteger <= 0) then
        begin
          FrmCadProdutos.pageCadSimples.ActivePage := FrmCadProdutos.tsS_Cadastro;
          raiseExceptionCreate('Campo largura não informado', 'DBEdit217');
        end;
      end;

//    if not ValidaInscEstadual then
//    begin
//      vNomeCampoErro := 'DBEdit128';
//      exit;
//    end;

    Result := True;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

