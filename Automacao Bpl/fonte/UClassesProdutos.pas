        end;
        //    linha := linha + 1;
        Rdp.ImpF(linha, 1, 'QUANT. ITENS:', [comp17, negrito]);
        Rdp.ImpF(linha, 15, IntToStr(buscas2.RecordCount), [comp17, negrito]);
        Rdp.ImpF(linha, 57, 'TOTAIS:', [comp17, negrito]);
