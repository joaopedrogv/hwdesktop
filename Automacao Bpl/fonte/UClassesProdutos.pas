function TProdutos.GetOperacoesFiscaisProduto(opf: TOpfProduto): TDataSet_OOP;
begin
  Result := OpfDataSetView;
  OpfDataSetView.Close;
  case opf of
    opfIcms:
      OpfDataSetView
        .SQLClient('select o.id, o.descricao, p.aliq_icms, p.aliq_red_bc, p.aliq_fcp, p.aliq_icms_dif, p.aliq_fcp_dif, p.ufs,' +
                   ' d.cfop, n.ncm_ini, n.ncm_fim, ot.descricao trib' +
                   ' from opf_cond_ncm  n' +
                   ' inner join opf o on o.id = n.opf_id and o.cod_empresa = n.cod_empresa and o.ativo = 1' +
                   ' inner join opf_icms i on i.opf_id = n.opf_id and i.cod_empresa = n.cod_empresa and i.ativo = 1' +
                   ' left join sp_opf_icm_tabtributacao(i.tributacao) ot on 1=1' +
                   ' inner join opf_icms_dest d on d.opf_icms_id = i.id and d.cod_empresa = i.cod_empresa and d.ativo = 1' +
                   ' inner join opf_icms_dest_params p on p.opf_icms_dest_id = d.id and p.cod_empresa = d.cod_empresa ' +
                   ' where :ncm >= n.ncm_ini and :ncm <= n.ncm_fim and n.cod_empresa = :cod_empresa' +
                   ' order by o.descricao')
        .ParamValue('ncm', fstr('nbm'))
        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
        .Open;

    opfPISCOFINS:
      OpfDataSetView
        .SQLClient('select o.id, o.descricao, pc.aliq_pis, pc.aliq_cofins, n.ncm_ini, n.ncm_fim, pc.cst, pc.nat_rec' +
                   ' from opf_cond_ncm  n' +
                   ' inner join opf o on o.id = n.opf_id and o.cod_empresa = n.cod_empresa and o.ativo = 1' +
                   ' inner join opf_pc pc on pc.opf_id = n.opf_id and pc.cod_empresa = n.cod_empresa and pc.ativo = 1' +
                   ' where :ncm >= n.ncm_ini and :ncm <= n.ncm_fim and n.cod_empresa = :cod_empresa' +
                   ' order by o.descricao')
        .ParamValue('ncm', fstr('nbm'))
        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
        .Open;

    opfRetencao:
      begin
        OpfDataSetView
          .SQLClient('select o.id, o.descricao, rt.pir, rt.pcsll, rt.ppis, rt.pcofins, n.ncm_ini, n.ncm_fim' +
                     ' from opf_cond_ncm  n' +
                     ' inner join opf o on o.id = n.opf_id and o.cod_empresa = n.cod_empresa and o.ativo = 1' +
                     ' inner join opf_rettrib rt on rt.opf_id = n.opf_id and rt.cod_empresa = n.cod_empresa and rt.ativo = 1' +
                     ' where :ncm >= n.ncm_ini and :ncm <= n.ncm_fim and n.cod_empresa = :cod_empresa' +
                     ' order by o.descricao')
          .ParamValue('ncm', fstr('nbm'))
          .ParamValue('cod_empresa', vDadosIni.cod_empresa)
          .Open;
        OpfDataSetView.dataSet.FieldByName('pir').DisplayLabel := 'Aliq IR';
        OpfDataSetView.dataSet.FieldByName('pcsll').DisplayLabel := 'Aliq CSLL';
        OpfDataSetView.dataSet.FieldByName('ppis').DisplayLabel := 'Aliq PIS';
        OpfDataSetView.dataSet.FieldByName('pcofins').DisplayLabel := 'Aliq COFINS';
      end;

  end;

end;

