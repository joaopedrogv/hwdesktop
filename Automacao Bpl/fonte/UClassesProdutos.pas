          buscas.SQL.Text := buscas.SQL.Text + ' PREC_30_PROD = :PREC_30_PROD, ';
        if FpermitAltPrec60 then
          buscas.SQL.Text := buscas.SQL.Text + ' PREC_60_PROD = :PREC_60_PROD, ';
        if FpermitAltPrec90 then
          buscas.SQL.Text := buscas.SQL.Text + ' PREC_90_PROD = :PREC_90_PROD, ';
      end;
      buscas.SQL.Text := buscas.SQL.Text + ' COD_EMPRESA = COD_EMPRESA ';
      buscas.SQL.Text := buscas.SQL.Text + ' WHERE GRUPO_PROD = :GRUPO_PROD ';
      buscas.SQL.Text := buscas.SQL.Text + ' AND COD_PROD = :COD_PROD';
      buscas.SQL.Text := buscas.SQL.Text + ' AND COD_EMPRESA = ' + vDadosIni.vReplicaoInternaEmpresa[i];

      if FpermitAltPerc30 then
        buscas.ParamByName('PERC_AD_30').AsFloat := dataSet.FieldByName('PERC_AD_30').AsFloat;
