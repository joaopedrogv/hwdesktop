var
	grupoProdTmp: Integer;
  codProdTmp: string;
begin
  result := false;
  NumFabricacao := trim(NumFabricacao);
  if ValorPromocao <= 0 then
  begin
    Application.MessageBox('Valor do Produto para preço promocional deve ser maior que zero',
      'Aviso', MB_ICONINFORMATION + MB_OK);
    exit;
  end;
  if trim(NumFabricacao) = '' then
  begin
    Application.MessageBox('Código de barras do Produto não informado.', 'Aviso',
      MB_ICONINFORMATION + MB_OK);
    exit;
  end;

//  if Copy(NumFabricacao, 1, 2) = 'G-' then
//  begin
//    try
//      NumFabricacao := Copy(NumFabricacao, 5, pos(';', NumFabricacao) - 5);
//    except
//      raise exception.create('Produto não encontrado');
//    end;
//  end;
  vDadosIni.vEtiqProd := vDadosIni.retornaDadosEtiqueta(
    buscas,
    NumFabricacao);

  grupoProdTmp := vDadosIni.vEtiqProd.GrupoProd;
  codProdTmp := vDadosIni.vEtiqProd.CodProd;
  NumFabricacao := vDadosIni.vEtiqProd.CodBarra;

  if trim(codProdTmp) <> '' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select p.num_fab_prod from produtos p ' +
      ' inner join cod_barra cb on ' +
      '		p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
      ' where p.grupo_prod = ' + IntToStr(grupoProdTmp) +
      ' and p.cod_prod = ' + QuotedStr(codProdTmp) +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and p.ativo = 1 ' +
      ' and cb.cod_barra = ' + quotedstr(trim(NumFabricacao));
    buscas.Open;
  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text := ' select p.num_fab_prod from produtos p ' +
      ' inner join cod_barra cb on ' +
      '		p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
      ' where cb.cod_barra = ' + quotedstr(trim(NumFabricacao)) +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and p.ativo=1';
    buscas.Open;
  end;
  if not buscas.IsEmpty then
  begin
    try
      NumFabricacao := trim(buscas.FieldByName('num_fab_prod').AsString);

      if trim(codProdTmp) <> '' then
      begin
        buscas.Close;
        buscas.SQL.Text := ' update produtos p set p.rep_int_active = 1, p.em_promocao = ''S'' , ' +
          ' p.preco_promocao = :valor, p.num_banca =' + inttostr(numbanca) +
          ' where p.grupo_prod = ' + IntToStr(grupoProdTmp) +
          ' and p.cod_prod = ' + QuotedStr(codProdTmp) +
          ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and p.ativo = 1 ';
        buscas.ParamByName('valor').AsCurrency := ValorPromocao;
        buscas.Prepare;
        buscas.ExecSQL;
      end
      else
      begin
        buscas.Close;
        buscas.SQL.Text := ' update produtos p set p.rep_int_active = 1, p.em_promocao = ''S'' , ' +
          ' p.preco_promocao = :valor, p.num_banca =' + inttostr(numbanca) +
          ' where p.num_fab_prod = ' + quotedstr(NumFabricacao) +
          ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and p.ativo = 1 ';
        buscas.ParamByName('valor').AsCurrency := ValorPromocao;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
      if CommitaTransacao then
        Refresh;
      buscas.close;
      result := true;
    except
      on E: Exception do
      begin
        result := false;
        RollBackTransacao;
        result := false;
        Application.MessageBox(Pchar('Erro ao ativar promoção do produto ' + trim(NumFabricacao)),
          'Aviso', MB_ICONINFORMATION + MB_OK);
        registraErro('E0006 ' + e.Message + ' ' + buscas.SQL.Text);
      end;
    end;
  end
  else
    Application.MessageBox('Produto não encontrado na base de dados', 'Aviso', MB_ICONINFORMATION +
      MB_OK);
end;

constructor TPromocaoProd.create;
begin
  if DtmProdutos = nil then
    DtmProdutos := TDtmProdutos.Create(DtmProdutos);
  DataSet := TClientDataSet(DtmProdutos.cdsPromocao);
  transacao := TIBTransaction(DtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(DtmProdutos.qrBuscasP);
  query := TIBQuery(DtmProdutos.qrBanca);
end;

function TPromocaoProd.ListaBancas(Listar: boolean): boolean;
begin
  query.Close;
