function TTipoServ.AtualizarTiposServicosEmLote: boolean;
var
  fTempListaTiposServicos: TClientDataSet;
  vIndexFieldNames: string;
  vIndexName: string;
  vRecNo: Integer;
  vMensagemTmp: string;
  vmensagemP, vmensagem: string;
  vtempMensagem: string;
  vSQL: string;
  vUpdate: string;
  buscas2: TIBQuery;
  buscasU: TIBQuery;
  I: Integer;
  campo: CampoServInput;
  campos: CamposServInput;
  vinc_a_cada_reg: Integer;
  vsalvar_a_cada_reg: Integer;

  procedure AddCampoValue(pNomeCampo: string; pValorCampo: Variant);
  begin
  	 vUpdate := vUpdate + ', ' + pNomeCampo + ' = :' + pNomeCampo;

  	 SetLength(campos, Length(campos) + 1);

    campo.NomeCampo  := pNomeCampo;
    campo.ValorCampo := pValorCampo;

    campos[High(campos)] := campo;
  end;
begin
  Result := false;
  vSQL := '';
  vUpdate := '';

  vtempMensagem := 'SALVAR';

  if not vDadosIni.PesqPros('BAS561', vtempMensagem, '', 'TIPO_SERVICO', '', buscas, False) then
  	 Exit;

  try
    buscas2 := TIBQuery.Create(nil);
    buscasU := TIBQuery.Create(nil);

  	 try
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      buscasU.Database := buscas.Database;
      buscasU.Transaction := buscas.Transaction;

      vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum produto selecionado.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          exit;
        end;

        with vAtualizarServ do
        begin
          if (not vHabCfop)
          	and (not vHabAliqIss)
            and (not vHabServIsento)
            and (not vHabNaoIncidencia)
            and (not vHabTmoSimult)
            and (not vHabTmo)
            and (not vHabAltValorCupom)
            and (not vHabAltDescr)
            and (not vHabServGarantia)
            and (not vHabOrigemServ)
            and (not vHabSeqRevisao)
            and (not vHabServPropTerc)
            and (not vHabEspecieVap)
            and (not vHabUnidade)
            and (not vHabVendaOnline)
            and (not vHabCnaeServ)
            and (not vHabLc116)
            and (not vHabTribNac)
            and (not vHabTribMun)
            and (not vHabNbs)
            and (not vHabIndOp)
            and (not vHabIssRetido)
            and (not vHabCstPisCofins)
            and (not vHabCstPisCofinsEnt) then
              raiseExceptionCreate('Nenhum opção selecionada!', '');
        end;

        fTempListaTiposServicos := TClientDataSet.Create(nil);
        fTempListaTiposServicos.Close;
        fTempListaTiposServicos.FieldDefs.Clear;
        for I := 0 to dataSet.Fields.Count - 1 do
        	fTempListaTiposServicos.FieldDefs.Add(
          dataSet.Fields[i].FieldName,
          dataSet.Fields[i].DataType,
          dataSet.Fields[i].Size, false);
        fTempListaTiposServicos.close;
        fTempListaTiposServicos.CreateDataSet;
        fTempListaTiposServicos.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
          	Application.ProcessMessages;
            vDadosIni.abreStatusProcessamento('', 'Lendo dados tipo serviço (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempListaTiposServicos.Insert;
              for I := 0 to dataSet.Fields.Count - 1 do
              	fTempListaTiposServicos.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
              fTempListaTiposServicos.Post;
            end;

            dataSet.Next;
          end;

        finally
        	 vDadosIni.fechaStatusProcessamento;
          dataSet.EnableControls;
        end;

        vSQL := dataSet.CommandText;
      finally
        dataSet.Filtered := false;
      end;

      vDadosIni.vDataHora := vDadosIni.getDataHoraBanco(buscas);
      
      vsalvar_a_cada_reg := vDadosIni.getConfSisInt('tpserv_alt_lote_reg', buscas);

      with vAtualizarServ do
      begin
        if vHabCfop then
        begin
          if vCodCfopLote <= 0 then
            raiseExceptionCreate('CFOP deve ser informado', 'EdCodCFOP');

          if not ExecutaComandosSql('select CODIGO_NOP from nat_op ' +
            ' where codigo_nop = ' + IntToStr(Trunc(vCodCfopLote)) +
            ' and ativo = 1 ') then
              raiseExceptionCreate('CFOP não encontrado', 'EdCodCFOP');
        end;

        if vHabOrigemServ then
        begin
          if trim(vOrigemServ) = '' then
            raiseExceptionCreate('Origem Serviço deve ser informado', 'DbLOrigemServ');

          if not ExecutaComandosSql('select cod_tipo_servico, sigla from tipo_tipo_servico ' +
            ' where sigla = ' + QuotedStr(trim(vOrigemServ))) then
              raiseExceptionCreate('Origem Serviço não encontrado', 'DbLOrigemServ');
        end;

        if vHabEspecieVap then
        begin
          if vCodEspecieVap <= 0 then
            raiseExceptionCreate('Espécie V/Ap deve ser informado', 'DbLEspecieVap');

          if not ExecutaComandosSql('select codigo_esp from especie_veiculo ' +
            ' where codigo_esp = ' + IntToStr(vCodEspecieVap)) then
              raiseExceptionCreate('Espécie V/Ap não encontrado', 'DbLEspecieVap');
        end;
        
        if vHabIssRetido then
        begin
          if trim(vIssRetido) <> '' then
            if (StrToInt(trim(vIssRetido)) <> 1) and (StrToInt(trim(vIssRetido)) <> 2) then
              raiseExceptionCreate('Iss Retido informado deve ser 1 ou 2', 'edIssRetido');
        end;

        try
          fTempListaTiposServicos.DisableControls;
          fTempListaTiposServicos.First;
          while not fTempListaTiposServicos.Eof do
          begin
            Application.ProcessMessages;
            vDadosIni.abreStatusProcessamento('', 'Atualizando dados tipo de serviço (' +
              IntToStr(fTempListaTiposServicos.RecNo) + '/' + IntToStr(fTempListaTiposServicos.RecordCount) + ')');

            vUpdate := 'UPDATE TIPO_SERVICO SET ATIVO = 1 ';

            SetLength(campos, 0);

            oldCodServico := IntToStr(fTempListaTiposServicos.FieldByName('COD_SERVICO').AsInteger);

            AddCampoValue('DATA_MOD_TIPO', DateOf(vDadosIni.vDataHora));

            if vHabCfop then
              AddCampoValue('CODIGO_NOP', vCodCfopLote);

            if vHabAliqIss then
              AddCampoValue('ALIQ_ISS', vAliqIss);

            if vHabServIsento then
              AddCampoValue('ISENTO_SERV', Trim(vServIsento));

            if vHabNaoIncidencia then
              AddCampoValue('N_INCIDENCIA_SERV', Trim(vNaoIncidencia));

            if vHabTmoSimult then
              AddCampoValue('TMOSERVSIMULT', Trim(vTmoSimult));

            if vHabTmo then
              AddCampoValue('TMO', vTmo);

            if vHabAltValorCupom then
              AddCampoValue('ALTCOD', Trim(vAltValorCupom));

            if vHabAltDescr then
              AddCampoValue('ALT_DESC', Trim(vAltDescricao));

            if vHabServGarantia then
              AddCampoValue('SHONDA', Trim(vServGarantia));

            if vHabOrigemServ then
              AddCampoValue('STIPO', Trim(vOrigemServ));

            if vHabSeqRevisao then
              AddCampoValue('SEQ_REVISAO', vSeqRevisao);

            if vHabServPropTerc then
              AddCampoValue('SERV_PROP_TERC', Trim(vServPropTerc));

            if vHabEspecieVap then
              AddCampoValue('COD_ESPE_SEG', vCodEspecieVap);

            if vHabUnidade then
              AddCampoValue('UNIDADE', Trim(vUnidade));

            if vHabVendaOnline then
              AddCampoValue('SINC_HW_CLOUD', Trim(vVendaOnline));

            if vHabCnaeServ then
              if vDadosIni.apenasNumeros(Trim(vCnaeServ)) = '' then
                AddCampoValue('CNAE_SERV', Null)
              else
              	 AddCampoValue('CNAE_SERV', StrToInt(Trim(vCnaeServ)));

            if vHabLc116 then
               if Trim(vLc116) = '' then
                  AddCampoValue('NFS_SERVICO', Null)
               else
            		AddCampoValue('NFS_SERVICO', Trim(vLc116));

            if vHabTribNac then
               if vDadosIni.apenasNumeros(Trim(vTribNac)) = '' then
                  AddCampoValue('CTRIBNAC', Null)
               else
            		AddCampoValue('CTRIBNAC', vDadosIni.apenasNumeros(Trim(vTribNac)));

            if vHabTribMun then
               if vDadosIni.apenasNumeros(Trim(vTribMun)) = '' then
                  AddCampoValue('CTRIBMUN', Null)
               else
            		AddCampoValue('CTRIBMUN', vDadosIni.apenasNumeros(Trim(vTribMun)));

            if vHabNbs then
               if vDadosIni.apenasNumeros(Trim(vNbs)) = '' then
                  AddCampoValue('CNBS', Null)
               else
            		AddCampoValue('CNBS', vDadosIni.apenasNumeros(Trim(vNbs)));

            if vHabIndOp then
               if vDadosIni.apenasNumeros(Trim(vIndOp)) = '' then
                  AddCampoValue('CINDOP', Null)
               else
            		AddCampoValue('CINDOP', vDadosIni.apenasNumeros(Trim(vIndOp)));

            if vHabIssRetido then
               if trim(vIssRetido) = '' then
                  AddCampoValue('ISS_RETIDO', Null)
               else
                  AddCampoValue('ISS_RETIDO', StrToInt(trim(vIssRetido)));

            if vHabCstPisCofins then
               if trim(vCstPisCofins) = '' then
               begin
                  AddCampoValue('CST_PIS', Null);
                  AddCampoValue('CST_COFINS', Null);
               end
               else
               begin
                  AddCampoValue('CST_PIS', Copy(trim(vCstPisCofins), 1, 2));
                  AddCampoValue('CST_COFINS', Copy(trim(vCstPisCofins), 1, 2));
               end;

            if vHabCstPisCofinsEnt then
               if trim(vCstPisCofinsEnt) = '' then
               begin
                  AddCampoValue('CST_PIS_ENT', Null);
                  AddCampoValue('CST_COFINS_ENT', Null)
               end
               else
               begin
                  AddCampoValue('CST_PIS_ENT', Copy(trim(vCstPisCofinsEnt), 1, 2));
                  AddCampoValue('CST_COFINS_ENT', Copy(trim(vCstPisCofinsEnt), 1, 2));
               end;

            vUpdate := vUpdate +
              ' WHERE COD_SERVICO = :PCOD_SERVICO ';

            buscasU.Close;
            buscasU.SQL.Text := vUpdate;

            for I := Low(campos) to High(campos) do
              buscasU.ParamByName(campos[I].NomeCampo).Value := campos[I].ValorCampo;

            buscasU.ParamByName('PCOD_SERVICO').AsInteger := fTempListaTiposServicos.FieldByName('COD_SERVICO').AsInteger;
            buscasU.ExecSQL;

            vDadosIni.GravaAuditoria('BAS561', vtempMensagem, '',
              'TIPO_SERVICO', oldCodServico, buscas);

            Inc(vinc_a_cada_reg);

            if (vsalvar_a_cada_reg > 0) and (vinc_a_cada_reg >= vsalvar_a_cada_reg) then
            begin
              Application.ProcessMessages;
              vDadosIni.abreStatusProcessamento('', 'Salvando dados tipo de serviço (' +
                IntToStr(fTempListaTiposServicos.RecNo) + '/' + IntToStr(fTempListaTiposServicos.RecordCount) + ')');

              vinc_a_cada_reg := 0;

              CommitaTransacao;
            end;

            fTempListaTiposServicos.Next;
          end;
        finally
          fTempListaTiposServicos.First;
          fTempListaTiposServicos.EnableControls;
        end;

        Application.ProcessMessages;
        vDadosIni.abreStatusProcessamento('', 'Atualizando dados tipo de serviço (' +
        IntToStr(fTempListaTiposServicos.RecordCount) + '/' + IntToStr(fTempListaTiposServicos.RecordCount) + ')');

        CommitaTransacao;

        dataSet.Close;
        dataSet.CommandText := vSQL;
        dataSet.Open;

        vDadosIni.GravaAuditoria('BAS561', vtempMensagem,	'SUCESSO', 'TIPO_SERVICO', '', buscas);
      end;

      Result := true;

      if Result then
        dataSet.Refresh;
    finally
      dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
        dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;

      if Assigned(buscas2) then
        FreeAndNil(buscas2);

      if Assigned(buscasU) then
        FreeAndNil(buscasU);

      vDadosIni.fechaStatusProcessamento;
    end;
    
  except
    on e: exception do
    begin
      Result := false;
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
	      dataSet.Close;
  	    dataSet.CommandText := vSQL;
    	  dataSet.Open;
      end;

      vDadosIni.GravaAuditoria('BAS561', vtempMensagem,	'FALHA', 'TIPO_SERVICO', '', buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TTipoServ.atualizarServicoEmpresa: boolean;
var
	vCodTipoServ: Integer;
  vTmp: string;
begin
	try
  	Result := False;

    if vTipoServEmpresa.dataSet.IsEmpty then
    begin
      Application.MessageBox('Nenhuma empresa selecionada.', 'Informação', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
      exit;
    end;

    vCodTipoServ := dataSet.FieldByName('COD_SERVICO').AsInteger;

    try
      vTipoServEmpresa.dataSet.DisableControls;
      vTipoServEmpresa.dataSet.First;
      while not vTipoServEmpresa.dataSet.Eof do
      begin
        if vTipoServEmpresa.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
        	vTmp := 'HABILITAR';

          buscas.Close;
          buscas.SQL.Text := ' UPDATE OR INSERT INTO TIPO_SERVICO_EMPRESA (COD_SERVICO, COD_EMPRESA) ' +
            ' VALUES (' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) + ',' +
            IntToStr(vTipoServEmpresa.dataSet.FieldByName('COD_EMPRESA').AsInteger) + ')' +
            ' MATCHING (COD_SERVICO, COD_EMPRESA); ';
          buscas.ExecSQL;
        end
        else
        begin
        	vTmp := 'DESABILITAR';

          buscas.Close;
          buscas.SQL.Text := ' DELETE FROM TIPO_SERVICO_EMPRESA ' +
            ' WHERE COD_SERVICO = ' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(vTipoServEmpresa.dataSet.FieldByName('COD_EMPRESA').AsInteger);
          buscas.ExecSQL;
        end;

        vDadosIni.GravaAuditoria(
        	'BAS530',
        	vTmp,
          'Emp: ' + IntToStr(vTipoServEmpresa.dataSet.FieldByName('COD_EMPRESA').AsInteger),
          'TIPO_SERVICO',
          IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger),
          buscas);

        vTipoServEmpresa.dataSet.Next;
      end;

      if buscas.Transaction.InTransaction then
      begin
        buscas.Transaction.Commit;
        vDadosIni.GravaAuditoria('BAS530', 'DEFINIR',	'SUCESSO',
        	'TIPO_SERVICO', IntToStr(vCodTipoServ), buscas);
      end
      else
      begin
        buscas.Transaction.Commit;
        vDadosIni.GravaAuditoria('BAS530', 'DEFINIR',	'FALHA',
        	'TIPO_SERVICO', IntToStr(vCodTipoServ), buscas);
      end;

      vTipoServEmpresa._abreTodosEmpresas(vCodTipoServ);

      Result := True;
    finally
      vTipoServEmpresa.First;
      vTipoServEmpresa.dataSet.EnableControls;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox('Erro definir tipo de serviço por empresa.',
      	'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      vDadosIni.GravaAuditoria('BAS530', 'DEFINIR',	'FALHA', 'TIPO_SERVICO', '', buscas);
    end;
  end;
end;

procedure TTipoServ.CadTipoServ(TipoForm: integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Tipo de Serviço');

    vDadosIni.vTipoForm := TipoForm;
    vDadosIni.vModalOuChild := '';
    if (TipoForm = 1) or (TipoForm = 2) then
      vDadosIni.vModalOuChild := 'M';
    if dtmProdutos = nil then
      dtmProdutos := TDtmProdutos.Create(dtmProdutos);
    if FrmCadTipoServ = nil then
      Application.CreateForm(TFrmCadTipoServ, FrmCadTipoServ);

    if (TipoForm > 0) and (not FrmCadTipoServ.Visible) then
      FrmCadTipoServ.ShowModal
    else if (TipoForm = 1) or (TipoForm = 2) then
      FrmCadTipoServ.ShowModal
    else
      FrmCadTipoServ.Show;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

