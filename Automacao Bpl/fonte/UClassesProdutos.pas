                    begin
                      Result := False;
                      exit;
                    end;
                  end;

                  if not vDadosIni.PesqPros('PRO234', 'ALTERAR', '', 'PROMOCAO_PRODUTO',
                    dataSet.FieldByName('GRUPO_PROD').AsString + '-' + dataSet.FieldByName('COD_PROD').AsString + '-' + dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, False) then
                    Exit;

                  acao := 'EDITAR';
                  editar := true;
                end;
              end;

              buscas.Close;
              buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO ' +
                ' SET VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
                ' PORCENTAGEM = :PORCENTAGEM, ' +
                ' MAX_DESC = :MAX_DESC, ' +
                ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
                ' MARKUP = :MARKUP, ' +
                ' INF = :INF ';

              if trim(debcred) <> '' then
                buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED = :USAR_DEBCRED ';

              buscas.SQL.Text := buscas.SQL.Text +
                ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
                ' AND SIGLA = :SIGLA ' +
                ' AND COD_TPPRECO = :COD_TPPRECO ' +
                ' AND GRUPO_PROD = :GRUPO_PROD ' +
                ' AND COD_PROD = :COD_PROD ' +
                ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
                ' AND COD_SETOR = :COD_SETOR ' +
                ' AND COD_CIDADE = :COD_CIDADE ' +
                ' AND COD_EMPRESA = :COD_EMPRESA; ';
              buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
              buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
              buscas.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
              buscas.ParamByName('COD_SETOR').AsInteger := 0;
              buscas.ParamByName('COD_CIDADE').AsInteger := 0;
              buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
              buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
              buscas.ParamByName('MAX_DESC').AsFloat := max_desc;
              buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
              buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
              if markup > 0 then
                buscas.ParamByName('VALOR_PROMOCAO').AsFloat := CalcUtils.Preco(vProduto.ffloat('prec_cusm_prod'), markup, 0 - vDadosIni.vEmp.vCasasDecimais);
              buscas.ParamByName('INF').AsString := vinf;

              if trim(debcred) <> '' then
                if trim(debcred) = 'Z' then
                  buscas.ParamByName('USAR_DEBCRED').Value := Null
                else
                  buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

              if Tabela = 'LOCALIDADE' then
                buscas.ParamByName('COD_LOCALIDADE').AsInteger := cod_tipo
              else if Tabela = 'SETOR' then
                buscas.ParamByName('COD_SETOR').AsInteger := cod_tipo
              else if Tabela = 'CIDADE' then
                buscas.ParamByName('COD_CIDADE').AsInteger := cod_tipo;
              if (buscas2.FieldByName('first').AsInteger = 0) then
                buscas.ParamByName('SIGLA').AsString := sigla
              else
                buscas.ParamByName('SIGLA').AsString := '0';
              buscas.ExecSQL;

              vDadosIni.GravaAuditoria('PRO235', acao,
              	IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + '-' +
                trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
                trim(Tabela) + ': ' + IfThen(Tabela = 'AVULSO', IntToStr(cod_promocao), IntToStr(cod_tipo)) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
                'PROMOCAO_PRODUTO',
              	IntToStr(cod_promocao), buscas);
            end;
          end;
          vProduto.dataSet.Next;
        end;
      finally
      	vDadosIni.fechaStatusProcessamento;
        vProduto.dataSet.First;
        vProduto.dataSet.EnableControls;
      end;
    finally
      vProduto.dataSet.Filtered := False;
    end;
    if (vselecionado = 'S') then
    begin
      Result := True;

      buscas.Transaction.Commit;

      if Result then
      begin
        CommitaTransacao;
        vDadosIni.GravaAuditoria('PRO235', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
      end;
    end
    else
    begin
      raiseExceptionCreate('Nenhum produto selecionado, favor selecionar!', 'DBGrid1');
    end;

  except on E: Exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO235', acao, 'FALHA', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.postPrecoDifS(
	cod_promocao, cod_tipo, tipo: Integer;
  valor, porcentagem, max_desc, markup: Double;
  debcred, sigla, grupo_prod, cod_prod: string;
  vProduto: TProdutos; CodTabela, Tabela: string): Boolean;
var
  acao, vSql: string;
  vproporcao_tabela: Double;
  I: Integer;
  vvalortemp: Double;
  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;

  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO235', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    grupo_prod + '-' + cod_prod, buscas, False) then
    Exit;

  try
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if tipo <= 0 then
      raiseExceptionCreate('Tipo deve ser informado!', 'DBLookupComboBox9');

    if max_desc < 0 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser menor que 0%!', 'EditHw8');

    if max_desc >= 100 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser maior ou igual a 100%!', 'EditHw8'); 

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
      raiseExceptionCreate('Valor, Markup, Margem ou ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) deve ser informado!', 'EditHw2');
   
    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior ou igual a 100%!', 'EditHw3');
        
    if vDadosIni.vtpPreco = 'P' then
		  if (valor >= vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat) then
      	raiseExceptionCreate('Valor informado não deve ser maior ou igual ao preço de varejo!', 'EditHw2');

    valor := vvalortemp;
    porcentagem := vporcentagemtemp;
    vproporcao_tabela := 0;
    if markup > 0 then
    begin
      porcentagem := 0;

      vinf := 'M';
    end
    else if porcentagem <> 0 then
    begin
    	if vDadosIni.vtpPreco = 'P' then
      begin
      	porcentagem := Abs(porcentagem);
      	if valor > 0 then
        	porcentagem := 0;
        vproporcao_tabela := 0;

        vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');
      end
      else
      begin
      	vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

        if porcentagem > 0 then
          vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
        else
          vproporcao_tabela := 1 - (Abs(porcentagem) / 100);

        valor := vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat + ((vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * porcentagem);
	      porcentagem := 0;
      end;
    end
    else
    begin
      porcentagem := 0;

      vinf := 'V';
    end;

//    if dataSet.FieldByName('MAX_DESC').AsFloat > 0 then
//      if ((valor) < (vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat - (vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * dataSet.FieldByName('MAX_DESC').AsFloat)) then
//      begin
//        raiseExceptionCreate('Desconto maior que permitido', 'EditHw4');
//        Result := False;
//        exit;
//      end;

    if (sigla = '') then
    begin
      raiseExceptionCreate('Tipo de venda deve ser informado!', 'DBLookupComboBox1');
      exit;
    end;

    try
    	vDadosIni.abreStatusProcessamento('', 'Replicando produto para outras empresas - 1/1');
      // Replicar produtos para outras empresas
      if not vDadosIni.produtos_replicacao_interna(StrToInt(grupo_prod), cod_prod) then
      begin
       Result := false;
       exit;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas, true);
    if Tabela = 'AVULSO' then
	    vDadosIni.verificarPromocao(buscas, cod_promocao, 5);
    vDadosIni.verificarTabPreco(buscas, Tabela, cod_tipo);

	  try
    	if (tipo = 2) then
        vDadosIni.abreStatusProcessamento('', 'Atualizando preços por localidade - 1/1')
      else if (tipo = 3) then
        vDadosIni.abreStatusProcessamento('', 'Atualizando preços por setor - 1/1')
      else if (tipo = 4) then
        vDadosIni.abreStatusProcessamento('', 'Atualizando preços por cidade - 1/1')
      else if (tipo = 5) then
        vDadosIni.abreStatusProcessamento('', 'Atualizando preços tabela avulsa - 1/1');

      for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
      begin
        vSql := '';
        if Tabela = 'LOCALIDADE' then
          vSql := ' AND COD_LOCALIDADE = ' + IntToStr(cod_tipo) +
          	' AND COD_SETOR = 0 ' +
            ' AND COD_CIDADE = 0 '
        else if Tabela = 'SETOR' then
          vSql := ' AND COD_LOCALIDADE = 0 ' +
          	' AND COD_SETOR = ' + IntToStr(cod_tipo) +
            ' AND COD_CIDADE = 0 '
        else if Tabela = 'CIDADE' then
          vSql := ' AND COD_LOCALIDADE = 0 ' +
          	' AND COD_SETOR = 0 ' + 
          	' AND COD_CIDADE = ' + IntToStr(cod_tipo);

        buscas.Close;
        if Tabela = 'AVULSO' then
          buscas.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
            ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
            ' AND COD_TPPRECO = :COD_TPPRECO ' +
            ' AND GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ' + vSql +
            ' AND (SIGLA = :SIGLA OR SIGLA = ''0'') '
        else
          buscas.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
            ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
            ' AND COD_TPPRECO = :COD_TPPRECO ' +
            ' AND GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ' + vSql +
            ' AND (SIGLA = :SIGLA OR SIGLA = ''0'') ';
        buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
        buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
        buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
        buscas.ParamByName('COD_PROD').AsString := cod_prod;
        buscas.ParamByName('SIGLA').AsString := sigla;
        buscas.Open;

        // Verifica se o registro existe
        if (buscas.FieldByName('FIRST').AsInteger = 0) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' INSERT INTO PROMOCAO_PRODUTO ' +
            ' (COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, VALOR_PROMOCAO, PORCENTAGEM, ' +
            ' GRUPO_PROD, COD_PROD, COD_LOCALIDADE, COD_SETOR, COD_CIDADE, SIGLA, MAX_DESC, ' +
            ' PROPORCAO_TABELA, MARKUP, INF';

          if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED';

          buscas.SQL.Text := buscas.SQL.Text + ') ';

          buscas.SQL.Text := buscas.SQL.Text +
            ' VALUES (:COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA, :VALOR_PROMOCAO, :PORCENTAGEM, ' +
            ' :GRUPO_PROD, :COD_PROD, :COD_LOCALIDADE, :COD_SETOR, :COD_CIDADE, :SIGLA, :MAX_DESC, ' +
            ' :PROPORCAO_TABELA, :MARKUP, :INF';

          if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ', :USAR_DEBCRED';

          buscas.SQL.Text := buscas.SQL.Text + '); ';
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO ' +
          	' SET VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
            ' PORCENTAGEM = :PORCENTAGEM, ' +
            ' MAX_DESC = :MAX_DESC, ' +
            ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
            ' MARKUP = :MARKUP, INF = :INF ';

          if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED = :USAR_DEBCRED ';

          buscas.SQL.Text := buscas.SQL.Text +
            ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
            ' AND COD_TPPRECO = :COD_TPPRECO ' +
            ' AND SIGLA = :SIGLA ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ' +
            ' AND GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
            ' AND COD_SETOR = :COD_SETOR ' +
            ' AND COD_CIDADE = :COD_CIDADE; ';
        end;
        buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
        buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.vReplicaoInternaEmpresa[i];
        buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
        buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
        buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
        buscas.ParamByName('MAX_DESC').AsFloat := max_desc;
        buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
        buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
        buscas.ParamByName('INF').AsString := vinf;

        if trim(debcred) <> '' then
          if trim(debcred) = 'Z' then
            buscas.ParamByName('USAR_DEBCRED').Value := Null
          else
            buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

        buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
        buscas.ParamByName('COD_SETOR').AsInteger := 0;
        buscas.ParamByName('COD_CIDADE').AsInteger := 0;
        buscas.ParamByName('GRUPO_PROD').AsString := grupo_prod;
        buscas.ParamByName('COD_PROD').AsString := cod_prod;

        buscas.ParamByName('SIGLA').AsString := sigla;

        if Tabela = 'AVULSO' then
          buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao
        else if Tabela = 'LOCALIDADE' then
          buscas.ParamByName('COD_LOCALIDADE').AsInteger := cod_tipo
        else if Tabela = 'SETOR' then
          buscas.ParamByName('COD_SETOR').AsInteger := cod_tipo
        else if Tabela = 'CIDADE' then
          buscas.ParamByName('COD_CIDADE').AsInteger := cod_tipo;
        buscas.ExecSQL;

        vDadosIni.GravaAuditoria('PRO235', acao,
          trim(grupo_prod) + '-' +
          trim(cod_prod) + ' - ' +
          trim(Tabela) + ': ' + IfThen(Tabela = 'AVULSO', IntToStr(cod_promocao), IntToStr(cod_tipo)) + ' - ' +
          IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
          'PROMOCAO_PRODUTO',
          IntToStr(cod_promocao), buscas);
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    end;

    Result := True;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO235', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
    end;

  except on E: Exception do
    begin
      vProduto.dataSet.Filtered := false;
      Result := false;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO235', acao, 'FALHA', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.postPromocao(
	cod_promocao, tipo: Integer; valor, porcentagem, markup: Double; debcred: string;
  dataini, datafim, horaini, horafim, sigla: string;
  vProduto: TProdutos): Boolean;
var
  vselecionado, acao: string;
  vproporcao_tabela: Double;
  buscas2: TIBQuery;
  editar: Boolean;
  I: Integer;
  vvalortemp: Double;
  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;

  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO240', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    '', buscas, False) then
    Exit;

  try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;
    editar := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if (cod_promocao <= 0) then
      raiseExceptionCreate('Promoção deve ser informado!', 'DBLookupComboBox6');

    if not existePromocao(IntToStr(cod_promocao)) then
      raiseExceptionCreate('Promoção deve ser informado!', 'DBLookupComboBox6');

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
      raiseExceptionCreate('Valor, Markup, Margem ou ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' deve ser informado!', 'EditHw2');

    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior que 100%!', 'EditHw3');

    if (tipo <= 0) then
      raiseExceptionCreate('Tipo deve ser informado!', 'DBEdit97');

    if (Trim(sigla) = '') then
      raiseExceptionCreate('Tipo de Venda deve ser informado!', 'DBLookupComboBox7');

    if (Trim(dataini) = '') then
      raiseExceptionCreate('Data Inicial deve ser informado!', 'MaskEdit19');

    if (Trim(datafim) = '') then
      raiseExceptionCreate('Data Final deve ser informado!', 'MaskEdit20');

    if (StrToDate(dataini) > StrToDate(datafim)) then
      raiseExceptionCreate('Data final menor que data inicial!', 'MaskEdit19');

    if ((StrToDate(dataini) = StrToDate(datafim)) and (StrToTime(horaini) >= (StrToTime(horafim)))) then
      raiseExceptionCreate('Data Inicial e Final são iguais, hora inicial não pode ser maior ou igual a hora final!', 'MaskEdit19');

    if (Trim(horaini) = ' : ') then
      raiseExceptionCreate('Hora Inicial deve ser informado!', 'MaskEdit21');

    if (Trim(horafim) = ' : ') then
      raiseExceptionCreate('Hora Final deve ser informado!', 'MaskEdit22');

    valor := vvalortemp;
	  porcentagem := vporcentagemtemp;
    vproporcao_tabela := 0;
    if markup > 0 then
    begin
      porcentagem := 0;

      vinf := 'M';
    end
    else if porcentagem <> 0 then
    begin
      if vDadosIni.vtpPreco = 'P' then
      begin
      	porcentagem := Abs(porcentagem);
      	if valor > 0 then
        	porcentagem := 0;
        vproporcao_tabela := 0;

        vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');
      end
      else
      begin
      	vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

        if porcentagem > 0 then
          vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
        else
          vproporcao_tabela := 1 - (Abs(porcentagem) / 100);
      end;
    end
    else
    begin
      vporcentagemtemp := 0;

      vinf := 'V';
    end;

    try
      vProduto.dataSet.Filter := 'SEL = ''S''';
      vProduto.dataSet.Filtered := true;

      if vProduto.dataSet.IsEmpty then
      begin
        raiseExceptionCreate('Nenhum produto selecionado, favor selecionar!', 'DBGrid1');
      end;

      try
        // Replicar produtos para outras empresas
        vProduto.dataSet.DisableControls;
        vProduto.dataSet.First;
        while not vProduto.dataSet.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Replicando produtos para outras empresas - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount));

          if not vDadosIni.produtos_replicacao_interna(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger, vProduto.dataSet.FieldByName('COD_PROD').AsString) then
          begin
           Result := false;
           exit;
          end;
          vProduto.dataSet.Next;
        end;
      finally
      	vDadosIni.fechaStatusProcessamento;
        vProduto.dataSet.EnableControls;
      end;

      vDadosIni.verificarReplicacaoInterna(buscas, true);
      vDadosIni.verificarPromocao(buscas, cod_promocao, tipo);

      try
        vProduto.dataSet.DisableControls;
        vProduto.dataSet.First;
        while not vProduto.dataSet.Eof do
        begin
          if ((vProduto.ffloat('prec_cusm_prod') <= 0) and (markup > 0)) then
          begin
            if ShowConfirmacao('Markup ou Margem informada e o produto não possui custo para continuar com o calculo. Deseja passar para o próximo produto ou cancelar a operação, para continuar aperte Sim, para Cancelar aperte Não ?' + #13 +
              'Grupo Prod: ' + vProduto.fstr('GRUPO_PROD') + sLineBreak +
              'Cod Prod: ' + vProduto.fstr('COD_PROD') + sLineBreak +
              'Num Fabr: ' + vProduto.fstr('NUM_FAB_PROD')) <> IDYES then
            begin
              Result := False;
              exit;
            end
            else
            begin
              vProduto.dataSet.Next;
              Continue;
            end;
          end;

          if tipo = 1 then
          	vDadosIni.abreStatusProcessamento('', 'Atualizando dados da promoção - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if tipo = 2 then
            vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por localidade - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if tipo = 3 then
          	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por setor - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
        	else if tipo = 4 then
          	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por cidade - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if tipo = 5 then
          	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preço tabela avulsa - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount));

          for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
          begin
          	vselecionado := 'S';

            buscas2.Close;
            buscas2.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
              ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
              ' AND COD_TPPRECO = :COD_TPPRECO ' +
              ' AND GRUPO_PROD  = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND (SIGLA = :SIGLA OR SIGLA =''0'')';
            buscas2.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
            buscas2.ParamByName('COD_TPPRECO').AsInteger := tipo;
            buscas2.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
            buscas2.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
            buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
            buscas2.ParamByName('SIGLA').AsString := sigla;
            buscas2.Open;

            // Verifica se o registro existe
            if (buscas2.FieldByName('FIRST').AsInteger = 0) then
            begin
              acao := 'INSERIR';

              buscas.Close;
              buscas.SQL.Text := ' INSERT INTO PROMOCAO_PRODUTO ' +
                ' (COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, VALOR_PROMOCAO, PORCENTAGEM, ' +
                ' GRUPO_PROD, COD_PROD, COD_LOCALIDADE, COD_SETOR, COD_CIDADE, ' +
                ' DATA_INI, DATA_FIM, HORA_INI, HORA_FIM, SIGLA, ' +
                ' PROPORCAO_TABELA, MARKUP, INF';

              if trim(debcred) <> '' then
	            	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED';

              buscas.SQL.Text := buscas.SQL.Text + ') ';

              buscas.SQL.Text := buscas.SQL.Text +
                ' VALUES (:COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA , :VALOR_PROMOCAO, :PORCENTAGEM, ' +
                ' :GRUPO_PROD, :COD_PROD, :COD_LOCALIDADE, :COD_SETOR, :COD_CIDADE, ' +
                ' :DATA_INI, :DATA_FIM, :HORA_INI, :HORA_FIM, :SIGLA, ' +
                ' :PROPORCAO_TABELA, :MARKUP, :INF';

	            if trim(debcred) <> '' then
            		buscas.SQL.Text := buscas.SQL.Text + ', :USAR_DEBCRED';

              buscas.SQL.Text := buscas.SQL.Text + '); ';

              buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
              buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
              buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
              buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
              buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
              buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
              buscas.ParamByName('INF').AsString := vinf;

              if trim(debcred) <> '' then
                if trim(debcred) = 'Z' then
                  buscas.ParamByName('USAR_DEBCRED').Value := Null
                else
                  buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

              buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
              buscas.ParamByName('COD_SETOR').AsInteger := 0;
              buscas.ParamByName('COD_CIDADE').AsInteger := 0;

              if vDadosIni.vtpPreco = 'P' then
              begin
              	if (Length(horaini) > 4) and (Length(horaini) < 8) then
                  horaini := horaini + ':' + Copy(horaini, 4, 2);
                if (Length(horafim) > 4) and (Length(horafim) < 8) then
                  horafim := horafim + ':' + Copy(horafim, 4, 2);
                try
                  buscas.ParamByName('DATA_INI').AsDateTime :=
                  	StrToDate(dataini) +
                    StrToTime(vDadosIni.IfThen((horaini = '00:00') or (horaini = '00:00:00'),
                    	'00:00:01', horaini));
                except
                 raiseExceptionCreate('Hora Inicial incorreta!', 'DBEdit6');
                end;
                try
                  buscas.ParamByName('DATA_FIM').AsDateTime :=
                  	StrToDate(datafim)+
                    StrToTime(vDadosIni.IfThen((horafim = '00:00') or (horafim = '00:00:00'),
                    	'23:59:59', horafim));
                except
                  raiseExceptionCreate('Hora Final incorreta!', 'DBEdit7');
                end;
                buscas.ParamByName('HORA_INI').AsString := FormatDateTime('HH:MM:SS', StrToDateTime(horaini));
	              buscas.ParamByName('HORA_FIM').AsString := FormatDateTime('HH:MM:SS', StrToDateTime(horafim));
              end;

              buscas.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('SIGLA').AsString := sigla;

              buscas.ExecSQL;

              vDadosIni.GravaAuditoria('PRO240', acao,
                IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + '-' +
                trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
                IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'AVULSO') + ': ' + IntToStr(cod_promocao) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
                'PROMOCAO_PRODUTO',
                IntToStr(cod_promocao), buscas);
            end
            else
            begin
              if StrToInt(vDadosIni.codEmpresa) = StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]) then
              begin
                buscas2.Close;
                buscas2.SQL.Text := 'SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
                  ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
                  ' AND COD_TPPRECO = :COD_TPPRECO ' +
                  ' AND GRUPO_PROD  = :GRUPO_PROD ' +
                  ' AND COD_PROD = :COD_PROD ' +
                  ' AND COD_EMPRESA = :COD_EMPRESA ' +
                  ' AND SIGLA =''0''';
                buscas2.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
                buscas2.ParamByName('COD_TPPRECO').AsInteger := tipo;
                buscas2.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
                buscas2.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
                buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
                buscas2.Open;

                if (buscas2.FieldByName('FIRST').AsInteger > 0) then
                begin
                  if Application.MessageBox(pchar('Produto com tipo de venda ''0 - TODOS'' incluído, deseja atualizar as informações ?' + #13 +
                    'Grupo Prod: ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
                    'Cod Prod: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + #13 +
                    'Num Fabr: ' + trim(vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString)),
                    'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
                  begin
                    Result := False;
                    exit;
                  end;
                end
                else if Application.MessageBox(pchar('Produto com este tipo de venda já incluído nesta promoção nesta promoção, deseja atualizar as informações ?' + #13 +
                  'Grupo Prod: ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
                  'Cod Prod: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + #13 +
                  'Num Fabr: ' + trim(vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString)),
                  'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
                begin
                  Result := False;
                  exit;
                end;


                if not vDadosIni.PesqPros('PRO239', 'ALTERAR', '', 'PROMOCAO_PRODUTO',
                  dataSet.FieldByName('GRUPO_PROD').AsString + '-' + dataSet.FieldByName('COD_PROD').AsString + '-' + dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, False) then
                  Exit;
              end;

              acao := 'EDITAR';
              editar := true;

              buscas.Close;
              buscas.SQL.Text :=  ' UPDATE PROMOCAO_PRODUTO SET ' +
              	' VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
              	' PROPORCAO_TABELA = :PROPORCAO_TABELA,' +
                ' PORCENTAGEM = :PORCENTAGEM, ' +
                ' MARKUP = :MARKUP, ' +
                ' INF = :INF, ';

              if trim(debcred) <> '' then
                buscas.SQL.Text := buscas.SQL.Text + ' USAR_DEBCRED = :USAR_DEBCRED, ';

              buscas.SQL.Text := buscas.SQL.Text +
                ' DATA_INI = :DATA_INI, ' +
                ' DATA_FIM = :DATA_FIM, ' +
                ' HORA_INI =:HORA_INI, ' +
                ' HORA_FIM =:HORA_FIM ' +
                ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
                ' AND SIGLA = :SIGLA ' +
                ' AND COD_TPPRECO = :COD_TPPRECO ' +
                ' AND GRUPO_PROD = :GRUPO_PROD ' +
                ' AND COD_PROD = :COD_PROD ' +
                ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
                ' AND COD_SETOR = :COD_SETOR ' +
                ' AND COD_CIDADE = :COD_CIDADE ' +
                ' AND COD_EMPRESA = :COD_EMPRESA; ';

              buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
              buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
              buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
              buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
              buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
              buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
              buscas.ParamByName('INF').AsString := vinf;

            	if trim(debcred) <> '' then
                if trim(debcred) = 'Z' then
                  buscas.ParamByName('USAR_DEBCRED').Value := Null
                else
                  buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

              buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
              buscas.ParamByName('COD_SETOR').AsInteger := 0;
              buscas.ParamByName('COD_CIDADE').AsInteger := 0;

              buscas.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;

              if vDadosIni.vtpPreco = 'P' then
              begin
              	if (Length(horaini) > 4) and (Length(horaini) < 8) then
                  horaini := horaini + ':' + Copy(horaini, 4, 2);
                if (Length(horafim) > 4) and (Length(horafim) < 8) then
                  horafim := horafim + ':' + Copy(horafim, 4, 2);
                try
                  buscas.ParamByName('DATA_INI').AsDateTime := StrToDate(dataini) + StrToTime(horaini);
                except
                 raiseExceptionCreate('Hora Inicial incorreta!', 'DBEdit6');
                end;
                try
                  buscas.ParamByName('DATA_FIM').AsDateTime := StrToDate(datafim)+ StrToTime(horafim);
                except
                  raiseExceptionCreate('Hora Final incorreta!', 'DBEdit7');
                end;
                buscas.ParamByName('HORA_INI').AsString := FormatDateTime('HH:MM:SS', StrToDateTime(horaini));
	              buscas.ParamByName('HORA_FIM').AsString := FormatDateTime('HH:MM:SS', StrToDateTime(horafim));
              end;
              
              if (buscas2.FieldByName('first').AsInteger = 0) then
                buscas.ParamByName('SIGLA').AsString := sigla
              else
                buscas.ParamByName('SIGLA').AsString := '0';
              buscas.ExecSQL;   

              vDadosIni.GravaAuditoria('PRO240', acao,
                IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + '-' +
                trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
                IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'AVULSO') + ': ' + IntToStr(cod_promocao) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
                'PROMOCAO_PRODUTO',
                IntToStr(cod_promocao), buscas);
            end;
          end;
          vProduto.dataSet.Next;
        end;
      finally
      	vDadosIni.fechaStatusProcessamento;
        vProduto.dataSet.First;
        vProduto.dataSet.EnableControls;
      end;
    finally
      vProduto.dataSet.Filtered := False;
      vDadosIni.fechaStatusProcessamento;
    end;

    if (vselecionado = 'S') then
    begin
      Result := True;

      buscas.Transaction.Commit;

      if Result then
      begin
        CommitaTransacao;
        vDadosIni.fechaStatusProcessamento;
        vDadosIni.GravaAuditoria('PRO240', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
      end;
    end;

  except on E: Exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO240', acao, 'FALHA', 'PROMOCAO_PRODUTO', IntToStr(cod_promocao), buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.postPromocaoProduto(
	cod_promocao, tipo, grupo_prod, cod_prod, data_ini, data_fim, hora_ini, hora_fim, sigla: string;
  valor, porcentagem, markup: Double;
  debcred: string): Boolean;
var
  acao: string;
  vproporcao_tabela: Double;
  vprecotabela: Double;
  I: Integer;
  vvalortemp: Double;
  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;

  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO240', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    grupo_prod + '-' + cod_prod + '-' + cod_promocao, buscas, False) then
    Exit;

  try
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if (cod_promocao = '') then
    begin
      raiseExceptionCreate('Promoção deve ser informado!', 'DBLookupComboBox6');
      exit;
    end;

    if not existePromocao(cod_promocao) then
    begin
      raiseExceptionCreate('Promoção não encontrada!', 'DBLookupComboBox6');
      exit;
    end;

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
    begin
      raiseExceptionCreate('Valor, Markup, Margem ou Porcentagem deve ser informado!', 'EditHw2');
      exit;
    end;

    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior que 100%!', 'EditHw3');

    if (data_ini = '') then
    begin
      raiseExceptionCreate('Data Inicial deve ser informado!', 'DBEdit100');
      exit;
    end;

    if (data_fim = '') then
    begin
      raiseExceptionCreate('Data Final deve ser informado!', 'DBEdit101');
      exit;
    end;

    if (sigla = '') then
    begin
      raiseExceptionCreate('Tipo de venda deve ser informado!', 'DBLookupComboBox1');
      exit;
    end;

    if (hora_ini = '') then
    begin
      raiseExceptionCreate('Hora  Inicial deve ser informado!', 'DBEdit102');
      exit;
    end;

    if (hora_fim = '') then
    begin
      raiseExceptionCreate('Hora Final deve ser informado!', 'DBEdit103');
      exit;
    end;

    if vDadosIni.vtpPreco = 'P' then
    begin
	    vprecotabela := retornaPrecoTabela(grupo_prod, cod_prod);
      if (valor > vprecotabela) then
      	raiseExceptionCreate('Valor informado não deve ser maior ou igual ao preço de varejo!', 'EditHw2');
    end;

    if (markup > 0) then
      if SqlScalar('select prec_cusm_prod from produtos where grupo_prod = %s and cod_prod = ''%s'' and cod_empresa = %d',
                   [grupo_prod, cod_prod, vDadosIni.cod_empresa]).AsFloat <= 0 then
        raiseExceptionCreate('Markup ou Margem informada e o produto não possui custo para continuar com o calculo');

    try
    	vDadosIni.abreStatusProcessamento('', 'Replicando produto para outras empresas - 1/1');
      // Replicar produtos para outras empresas
      if not vDadosIni.produtos_replicacao_interna(StrToInt(grupo_prod), cod_prod) then
      begin
       Result := false;
       exit;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas, true);
    vDadosIni.verificarPromocao(buscas, StrToInt(cod_promocao), 1);

    try
    	if StrToInt(tipo) = 1 then
      	vDadosIni.abreStatusProcessamento('', 'Atualizando dados da promoção - 1/1')
      else if StrToInt(tipo) = 2 then
      	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por localidade - 1/1')
      else if StrToInt(tipo) = 3 then
      	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por setor - 1/1')
			else if StrToInt(tipo) = 4 then
      	vDadosIni.abreStatusProcessamento('', 'Atualizando dados preços por cidade - 1/1')
			else if StrToInt(tipo) = 5 then
				vDadosIni.abreStatusProcessamento('', 'Atualizando dados preço tabela avulsa - 1/1');

      for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
      begin
        valor := vvalortemp;
			  porcentagem := vporcentagemtemp;
        vproporcao_tabela := 0;
        if markup > 0 then
        begin
          porcentagem := 0;

          vinf := 'M';
        end
        else if porcentagem <> 0 then
        begin
          if vDadosIni.vtpPreco = 'P' then
          begin
          	porcentagem := Abs(porcentagem);
          	if valor > 0 then
		        	porcentagem := 0;
          	vproporcao_tabela := 0;

            vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');
          end
          else
          begin
            vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

            if porcentagem > 0 then
              vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
            else
              vproporcao_tabela := 1 - (Abs(porcentagem) / 100);
          end;
        end
        else
        begin
          vporcentagemtemp := 0;

          vinf := 'V';
        end;

        buscas.Close;
        buscas.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
           ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
           ' AND COD_TPPRECO = 1 ' +
           ' AND GRUPO_PROD  = :GRUPO_PROD ' +
           ' AND COD_PROD = :COD_PROD ' +
           ' AND COD_EMPRESA = :COD_EMPRESA ' +
           ' AND (SIGLA = :SIGLA OR SIGLA =''0'') ';
        buscas.ParamByName('COD_PROMOCAO').AsInteger := StrToInt(cod_promocao);
        buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
        buscas.ParamByName('COD_PROD').AsString := cod_prod;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
        buscas.ParamByName('SIGLA').AsString := sigla;
        buscas.Open;

        // Verifica se o registro existe
        if (buscas.FieldByName('FIRST').AsInteger = 0) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' INSERT INTO PROMOCAO_PRODUTO ' +
          	' (COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, VALOR_PROMOCAO, PORCENTAGEM, ' +
            ' GRUPO_PROD, COD_PROD, COD_LOCALIDADE, COD_SETOR, COD_CIDADE, ' +
            ' DATA_INI, DATA_FIM, HORA_INI, HORA_FIM, SIGLA, ' +
            ' PROPORCAO_TABELA, MARKUP, INF';

          if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED';

          buscas.SQL.Text := buscas.SQL.Text + ') ';

          buscas.SQL.Text := buscas.SQL.Text +
            ' VALUES (:COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA, :VALOR_PROMOCAO, :PORCENTAGEM, ' +
            ' :GRUPO_PROD, :COD_PROD, :COD_LOCALIDADE, :COD_SETOR, :COD_CIDADE, :DATA_INI, ' +
            ' :DATA_FIM, :HORA_INI, :HORA_FIM, :SIGLA, ' +
            ' :PROPORCAO_TABELA, :MARKUP, :INF';

          if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ', :USAR_DEBCRED';

          buscas.SQL.Text := buscas.SQL.Text + '); ';

          buscas.ParamByName('COD_PROMOCAO').AsInteger := StrToInt(cod_promocao);
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
          buscas.ParamByName('COD_TPPRECO').AsInteger := 1;
          buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
          buscas.ParamByName('COD_PROD').AsString := cod_prod;
          buscas.ParamByName('SIGLA').AsString := sigla;
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO SET ' +
            ' VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
            ' PORCENTAGEM = :PORCENTAGEM, ' +
            ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
            ' MARKUP = :MARKUP, ' +
            ' INF = :INF, ';

        	if trim(debcred) <> '' then
          	buscas.SQL.Text := buscas.SQL.Text + ' USAR_DEBCRED = :USAR_DEBCRED, ';

          buscas.SQL.Text := buscas.SQL.Text +
            ' DATA_INI = :DATA_INI, DATA_FIM = :DATA_FIM, ' +
            ' HORA_INI = :HORA_INI, HORA_FIM = :HORA_FIM ' +
            ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
            ' AND COD_TPPRECO = :COD_TPPRECO ' +
            ' AND SIGLA = :SIGLA ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ' +
            ' AND GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
            ' AND COD_SETOR = :COD_SETOR ' +
            ' AND COD_CIDADE = :COD_CIDADE; ';
          buscas.ParamByName('COD_PROMOCAO').AsInteger := StrToInt(cod_promocao);
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
          buscas.ParamByName('COD_TPPRECO').AsInteger := 1;
          buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
          buscas.ParamByName('COD_PROD').AsString := cod_prod;
          buscas.ParamByName('SIGLA').AsString := sigla;
        end;

        buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
        buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
        buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
        buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
        buscas.ParamByName('INF').AsString := vinf;

        if trim(debcred) <> '' then
          if trim(debcred) = 'Z' then
            buscas.ParamByName('USAR_DEBCRED').Value := Null
          else
            buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

        buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
        buscas.ParamByName('COD_SETOR').AsInteger := 0;
        buscas.ParamByName('COD_CIDADE').AsInteger := 0;

        if vDadosIni.vtpPreco = 'P' then
        begin
        	if (Length(hora_ini) > 4) and (Length(hora_ini) < 8) then
            hora_ini := hora_ini + ':' + Copy(hora_ini, 4, 2);
          if (Length(hora_fim) > 4) and (Length(hora_fim) < 8) then
            hora_fim := hora_fim + ':' + Copy(hora_fim, 4, 2);
          try
            buscas.ParamByName('DATA_INI').AsDateTime :=
            	StrToDate(data_ini) +
              StrToTime(vDadosIni.IfThen((hora_ini = '00:00') or (hora_ini = '00:00:00'),
              	'00:00:01', hora_ini));
          except
           raiseExceptionCreate('Hora Inicial incorreta!', 'DBEdit6');
          end;
          try
            buscas.ParamByName('DATA_FIM').AsDateTime :=
            	StrToDate(data_fim)+
              StrToTime(vDadosIni.IfThen((hora_fim = '00:00') or (hora_fim = '00:00:00'),
              	'23:59:59', hora_fim));
          except
            raiseExceptionCreate('Hora Final incorreta!', 'DBEdit7');
          end;
          buscas.ParamByName('HORA_INI').AsString := vDadosIni.IfThen((hora_ini = '00:00') or (hora_ini = '00:00:00'),
          	'00:00:01', hora_ini);
          buscas.ParamByName('HORA_FIM').AsString := vDadosIni.IfThen((hora_fim = '00:00') or (hora_fim = '00:00:00'),
          	'23:59:59', hora_fim);
        end;

        buscas.ExecSQL;

        vDadosIni.GravaAuditoria('PRO240', acao,
          grupo_prod + '-' +
          trim(cod_prod) + ' - ' +
          IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'AVULSO') + ': ' + cod_promocao + ' - ' +
          IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
          'PROMOCAO_PRODUTO',
          cod_promocao, buscas);
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    end;
    Result := True;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO240', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', cod_promocao, buscas);
    end;

  except on E: Exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO240', acao, 'FALHA', 'PROMOCAO_PRODUTO', cod_promocao, buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.postPromocaoProdutoS(
