function TGrupos.RestaurarRegistro: boolean;
var
	vCod_Gr: string;
	vDesc_Gr: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCod_Gr  := trim(dataSet.FieldByName('CODIGO_GRUP').AsString);
      vDesc_Gr := trim(dataSet.FieldByName('DESCRICAO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCod_Gr  := '';
        vDesc_Gr := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCod_Gr) <> '') then
      	prepare_loop('CODIGO_GRUP = ' + vCod_Gr)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'GRUPO' + #13 +
        'Código: ' + vCod_Gr + #13 +
        'Descrição: ' + vDesc_Gr;

      if (trim(vCod_Gr) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO046', 'RESTAURAR', '', 'GRUPOS',
        vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando grupo(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando grupo(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update grupos set ativo = 1 ' +
          ' where codigo_grup = %d ',
          [fint('codigo_grup')], buscas);

        if (trim(vCod_Gr) = '') then
          vDadosIni.GravaAuditoria('PRO046', 'RESTAURAR', '', 'GRUPOS',
            dataSet.FieldByName('CODIGO_GRUP').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO046', 'RESTAURAR', 'SUCESSO', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO046', 'RESTAURAR', 'FALHA', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

