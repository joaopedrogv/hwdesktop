function TPromocaoProduto._buscarProduto(num_fab_prod: string; grupo_prod: Integer; cod_prod: string): Boolean;
begin
	Result := false;
  vPequisaPorDescr := false;

  buscas.Close;
  if (grupo_prod > 0) or (trim(cod_prod) <> '') then
  	buscas.SQL.Text :=
      ' select distinct pr.*, ' +
			' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
      ' inner join cod_barra cb on cb.grupo_prod = pr.grupo_prod and cb.cod_prod = pr.cod_prod and cb.cod_empresa = pr.cod_empresa ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where pr.ativo =1 and cb.cod_barra = ' + QuotedStr(trim(num_fab_prod)) +
      ' and cb.grupo_prod = ' + IntToStr(grupo_prod) +
      ' and cb.cod_prod = ' + QuotedStr(cod_prod) +
      ' and pr.cod_empresa =' + vDadosIni.codEmpresa
  else
    buscas.SQL.Text :=
      ' select distinct pr.*, ' +
      ' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
      ' inner join cod_barra cb on cb.grupo_prod = pr.grupo_prod and cb.cod_prod = pr.cod_prod and cb.cod_empresa = pr.cod_empresa ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where pr.ativo =1 and cb.cod_barra = ' + QuotedStr(trim(num_fab_prod)) +
      ' and pr.cod_empresa =' + vDadosIni.codEmpresa;
  buscas.Open;
  buscas.FetchAll;

  if buscas.IsEmpty then
  begin
  	buscas.Close;
    buscas.SQL.Text :=
      ' select distinct pr.*, ' +
      ' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
      ' inner join cod_barra cb on cb.grupo_prod = pr.grupo_prod and cb.cod_prod = pr.cod_prod and cb.cod_empresa = pr.cod_empresa ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where pr.ativo =1 and pr.descr_prod like ' + QuotedStr(trim(num_fab_prod) + '%') +
      ' and pr.cod_empresa =' + vDadosIni.codEmpresa +
      ' order by PR.descr_prod ';
    buscas.Open;
    buscas.FetchAll;

    if not buscas.IsEmpty then
    	vPequisaPorDescr := true;
  end;

  if buscas.IsEmpty then
  begin
    Result := false;
    exit;
  end;

  if not buscas.IsEmpty then
    if buscas.RecordCount > 1 then
    begin
    	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
      TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
      TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
      TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
      TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
      if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
      begin
        Result := false;
        exit;
      end;
    end;

  dataSet.Open;
  dataSet.EmptyDataSet;

  dataSet.Insert;
  dataSet.FieldByName('GRUPO_PROD').AsInteger :=
    buscas.FieldByName('GRUPO_PROD').AsInteger;
  dataSet.FieldByName('COD_PROD').AsString :=
    buscas.FieldByName('COD_PROD').AsString;
  dataSet.FieldByName('DESCR_PROD').AsString := buscas.FieldByName('DESCR_PROD').AsString;
  dataSet.FieldByName('NUM_FAB_PROD').AsString := vDadosIni.IfThen(vPequisaPorDescr,
  	buscas.FieldByName('NUM_FAB_PROD').AsString, num_fab_prod);
  dataSet.FieldByName('PREC_TAB_PROD').AsFloat := buscas.FieldByName('PREC_TAB_PROD').AsFloat;
  dataSet.FieldByName('PREC_PUBLICO').AsFloat := buscas.FieldByName('PREC_PUBLICO').AsFloat;
  dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
  dCusto := ffloat('PREC_CUSM_PROD');
  
  Result := true;
end;

procedure TPromocaoProduto._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

