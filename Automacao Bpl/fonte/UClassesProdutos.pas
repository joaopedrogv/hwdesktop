      end;

    finally
      pDateSetProd.Filtered := false;
      pDateSetProd.First;
      pDateSetProd.EnableControls;
    end;

    buscas.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO241', 'EXCLUIR - ' + vTipo, 'SUCESSO', 'PROMOCAO_PRODUTO', IntToStr(vCodPromocao), buscas);
