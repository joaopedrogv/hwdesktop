        vprec_cusm_prodTot := 0;
        vprec_tab_prodTot := 0;
        vprec_publicoTot := 0;
        vest_fTot := 0;

        buscas2.First;
        while not buscas2.eof do
        begin
          Application.ProcessMessages;
          try
            Rdp.Imp(linha, 1, buscas2.FieldByName('num_fab_prod').asstring);
            Rdp.Imp(linha, 22, Copy(trim(buscas2.FieldByName('descr_prod_kit').AsString), 1, 50));
            Rdp.ImpD(linha, 75, format('%n', [buscas2.FieldByName('quant_prod_kit').AsCurrency]), [comp17]);
            if pDateSet.FieldByName('prec_cusm_prod').Visible then
      		  	Rdp.ImpD(linha, 90, format('%n', [buscas2.FieldByName('prec_cusm_prod').AsCurrency]), [comp17]);
            Rdp.ImpD(linha, 104, format('%n', [buscas2.FieldByName('prec_tab_prod').AsCurrency]), [comp17]);
            Rdp.ImpD(linha, 118, format('%n', [buscas2.FieldByName('prec_publico').AsCurrency]), [comp17]);
            Rdp.ImpD(linha, 132, format('%n', [buscas2.FieldByName('est_f').AsCurrency]), [comp17]);

