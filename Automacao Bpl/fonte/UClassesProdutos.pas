function TVisualizarGradeBalanco._PegarReqOsGrade(CodProd, GrupoProd,
  Grade: string): string;
begin
  Result := FloatToStr(vDadosIni.getPendenciasEstoque(StrToIntDef(Trim(GrupoProd), 0), CodProd, StrToIntDef(Trim(Grade), 0), '', buscas, True));
  Exit;

  Result := '0';
  buscas.close;
  buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = ' + quotedstr(trim(CodProd)) +
    ' and ipv.grupo_prod = ' + IntToStr(StrToIntDef(trim(GrupoProd), 0)) +
    ' and ipv.COD_GRADE = ' + IntToStr(StrToIntDef(trim(Grade), 0)) +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and pv.tipo <> ''ORC''' + //esta data é a inicial do banco quando tem migração
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' +
    vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  //  buscas.ParamByName('vgrup').AsInteger := grupo_prod;
  //  buscas.ParamByName('vcod').AsString := cod_prod;
  buscas.Prepare;
  buscas.Open;
  Result := floattostr(buscas.FieldByName('valor').AsFloat);
  buscas.Close;
  buscas.UnPrepare;
end;

procedure TVisualizarGradeBalanco._VisGradeAfterScroll(DataSet: TDataSet);
begin
  _EditQuant.Text := retornaValor(
    'select coalesce(qtde,0) as valor from cod_grade_balanco ' +
    'where grupo_prod = ' + IntToStr(dataset.FieldByName('grupo_prod').AsInteger)
    + ' and cod_prod = ' + quotedstr(dataset.FieldByName('cod_prod').asstring) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cod_grade = ' + IntToStr(dataset.FieldByName('cod_grade').AsInteger));
  if (_EditQuant.Text = '') then
  begin
    _EditQuant.Text := '0';
  end;

  _EditEstRealGrade.Text := retornaValor(
    'select coalesce(qtde,0) as valor from cod_grade_prod ' +
    'where grupo_prod = ' + IntToStr(dataset.FieldByName('grupo_prod').AsInteger)
    + ' and cod_prod = ' + quotedstr(dataset.FieldByName('cod_prod').asstring) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cod_grade = ' + IntToStr(dataset.FieldByName('cod_grade').AsInteger));
  if (_EditEstRealGrade.Text = '') then
  begin
    _EditEstRealGrade.Text := '0';
  end;

  _EditEstRealGrade.Text := floattostr(strtofloat(_EditEstRealGrade.Text) -
    strtofloat(_PegarReqOsGrade(dataset.FieldByName('grupo_prod').asstring,
    dataset.FieldByName('cod_prod').asstring,
    dataset.FieldByName('cod_grade').asstring)));
end;

