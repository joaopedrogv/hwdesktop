function TGradeEstoque.delete: Boolean;
var
  vCodGrade: string;
  vListaCtr: TStringList;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodGrade := dataSet.FieldByName('cod_grade').AsString;

  SqlOpen(' select first 11 distinct cp.cod_contrato from clientes_com_contrato_prod cp ' +
  	' where cp.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cp.cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
    ' and cp.cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
    ' and cp.cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger), buscas).FetchAll;

  if not buscas.IsEmpty then
  begin
  	try
      vListaCtr := TStringList.Create;
      vListaCtr.Duplicates := dupIgnore;
      vListaCtr.Clear;

      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.RecNo >= 11 then
        begin
          vListaCtr.Add('...');
          Break;
        end;

        vListaCtr.Add(IntToStr(buscas.FieldByName('cod_contrato').AsInteger));

        buscas.Next;
      end;

      Application.MessageBox(PChar('Produto foi vinculado na grade ' + vCodGrade + ' ao(s) contrato(s): '+ #13 + #13 +
      	'CONTRATO(S): ' + #13 +
        trim(vListaCtr.Text) + #13 +
        'Favor verificar antes de continuar.'), 'Atenção', MB_ICONWARNING + MB_OK);
      Result := False;
      exit;
    finally
    	if Assigned(vListaCtr) then
      	vListaCtr.Free;
    end;
  end;

  buscas.Close;
  buscas.SQL.Text := 'delete from cod_grade_prod' +
    ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
    ' and cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
    ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
  buscas.ExecSQL;

  dataSet.Refresh;

//  result := inherited Delete;
//  if Result then
//    result := Apply;

  if buscas.RowsAffected > 0 then
  begin
    buscas.Transaction.Commit;
    Result := True;
  end;

  if Result then
    vDadosIni.GravaAuditoria('PRO088', 'EXCLUIR', 'SUCESSO', 'COD_GRADE_PROD', vCodGrade,
      buscas)
  else
    vDadosIni.GravaAuditoria('PRO088', 'EXCLUIR', 'FALHA', 'COD_GRADE_PROD', vCodGrade,
      buscas);

  Result := true;
  Refresh;
end;

