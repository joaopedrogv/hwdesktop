              ' GRUPO_PROD, COD_PROD, COD_LOCALIDADE, COD_SETOR, COD_CIDADE, SIGLA, ' +
              ' PROPORCAO_TABELA, MARKUP, INF';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED';

            buscas.SQL.Text := buscas.SQL.Text + ') ';

            buscas.SQL.Text := buscas.SQL.Text +
              ' VALUES (:COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA, :VALOR_PROMOCAO, :PORCENTAGEM, :MAX_DESC, ' +
              ' :GRUPO_PROD, :COD_PROD, :COD_LOCALIDADE, :COD_SETOR, :COD_CIDADE, ''0'', ' +
              ' :PROPORCAO_TABELA, :MARKUP, :INF';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ', :USAR_DEBCRED';

            buscas.SQL.Text := buscas.SQL.Text + '); ';
          end;
        end
        else
        begin
          buscas.Close;
          if vDadosIni.vtpPreco = 'P' then
          begin
            buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO SET ' +
            	' VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
              ' PORCENTAGEM = :PORCENTAGEM,  ' +
              ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
              ' MARKUP = :MARKUP, ' +
              ' INF = :INF, ';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ' USAR_DEBCRED = :USAR_DEBCRED, ';

          	buscas.SQL.Text := buscas.SQL.Text +
              '	DATA_INI = :DATA_INI, ' +
              ' DATA_FIM = :DATA_FIM, ' +
              ' HORA_INI = :HORA_INI, ' +
              ' HORA_FIM = :HORA_FIM ' +
              ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
              ' AND COD_TPPRECO = :COD_TPPRECO ' +
              ' AND SIGLA = :SIGLA ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
              ' AND COD_SETOR = :COD_SETOR ' +
              ' AND COD_CIDADE = :COD_CIDADE; ';
          end
          else
          begin
            buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO SET ' +
           	  ' VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
              ' PORCENTAGEM = :PORCENTAGEM, ' +
              ' MAX_DESC = :MAX_DESC, ' +
              ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
              ' MARKUP = :MARKUP, ' +
              ' INF = :INF ';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED = :USAR_DEBCRED ';

            buscas.SQL.Text := buscas.SQL.Text +
              ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
              ' AND COD_TPPRECO = :COD_TPPRECO ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
              ' AND COD_SETOR = :COD_SETOR ' +
              ' AND COD_CIDADE = :COD_CIDADE; ';
          end;
        end;
        buscas.ParamByName('COD_PROMOCAO').AsInteger := StrToInt(cod_promocao);
        buscas.ParamByName('COD_TPPRECO').AsInteger := vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 1, cod_tipo);
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
        buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
        buscas.ParamByName('COD_PROD').AsString := cod_prod;
        buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
        buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
        buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
        buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
        buscas.ParamByName('INF').AsString := vinf;

        if trim(debcred) <> '' then
        	if trim(debcred) = 'Z' then
          	buscas.ParamByName('USAR_DEBCRED').Value := Null
          else
        		buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

        buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
        buscas.ParamByName('COD_SETOR').AsInteger := 0;
        buscas.ParamByName('COD_CIDADE').AsInteger := 0;

        if vDadosIni.vtpPreco = 'T' then
          buscas.ParamByName('MAX_DESC').AsFloat := desc_max;
        if vDadosIni.vtpPreco = 'P' then
        begin
          if (Length(hora_ini) > 4) and (Length(hora_ini) < 8) then
            hora_ini := hora_ini + ':' + Copy(hora_ini, 4, 2);
          if (Length(hora_fim) > 4) and (Length(hora_fim) < 8) then
            hora_fim := hora_fim + ':' + Copy(hora_fim, 4, 2);
          try
            buscas.ParamByName('DATA_INI').AsDateTime :=
              StrToDate(data_ini) +
              StrToTime(vDadosIni.IfThen((hora_ini = '00:00') or (hora_ini = '00:00:00'),
                '00:00:01', hora_ini));
          except
            raiseExceptionCreate('Hora Inicial incorreta!', 'DBEdit6');
          end;
          try
            buscas.ParamByName('DATA_FIM').AsDateTime :=
              StrToDate(data_fim)+
              StrToTime(vDadosIni.IfThen((hora_fim = '00:00') or (hora_fim = '00:00:00'),
                '23:59:59', hora_fim));
          except
            raiseExceptionCreate('Hora Final incorreta!', 'DBEdit7');
          end;

          buscas.ParamByName('HORA_INI').AsString := vDadosIni.IfThen((hora_fim = '00:00') or (hora_fim = '00:00:00'),
            '00:00:01', hora_ini);
          buscas.ParamByName('HORA_FIM').AsString := vDadosIni.IfThen((hora_fim = '00:00') or (hora_fim = '00:00:00'),
            '23:59:59', hora_fim);
          buscas.ParamByName('SIGLA').AsString := sigla;
        end;

        buscas.ExecSQL;

        vDadosIni.GravaAuditoria('PRO240', acao,
          grupo_prod + '-' +
          trim(cod_prod) + ' - ' +
          IfThen(vDadosIni.vtpPreco = 'P', 'PROMOCAO', 'AVULSO') + ': ' + cod_promocao + ' - ' +
          IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
          'PROMOCAO_PRODUTO',
          cod_promocao, buscas);
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    end;

    Result := True;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO240', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', cod_promocao, buscas);
    end;

  except on E: Exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO240', acao, 'FALHA', 'PROMOCAO_PRODUTO', cod_promocao, buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.postTabela(
	grupo_prod, cod_prod: string;
  valor, porcentagem, prec_tab, max_desc, markup: Double;
  debcred: string;
  tipo: Integer): Boolean;
var
  acao: string;
  editar: Boolean;
  buscas2: TIBQuery;
  I, J: Integer;
  vproporcao_tabela: Double;
  vvalortemp: Double;
  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;
  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO235', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    grupo_prod + '-' + cod_prod, buscas, False) then
    Exit;

  try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    editar := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if max_desc < 0 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser menor que 0%!', 'EditHw7');

    if max_desc >= 100 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser maior ou igual a 100%!', 'EditHw7');

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
      raiseExceptionCreate('Valor, Markup, Margem ou ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	'(%) deve ser informado!', 'EditHw2');

    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior ou igual a 100%!', 'EditHw3');

    if vDadosIni.vtpPreco = 'P' then
		  if (valor >= vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat) then
      	raiseExceptionCreate('Valor informado não deve ser maior ou igual ao preço de varejo!', 'EditHw2');


//    if dataSet.FieldByName('MAX_DESC').AsFloat > 0 then
//      if ((valor) < (prec_tab - (prec_tab / 100) * dataSet.FieldByName('MAX_DESC').AsFloat)) then
//      begin
//        raiseExceptionCreate('Desconto maior que permitido!', 'DBEdit97');
//        Result := false;
//        exit;
//      end;

  	try
      vRegiao.dataSet.Filter := 'SEL = ''S''';
      vRegiao.dataSet.Filtered := true;

      if vRegiao.dataSet.IsEmpty then
        raiseExceptionCreate('Nenhum tipo de preço selecionado, favor selecionar!', 'DBGrid24');

      try
      	vDadosIni.abreStatusProcessamento('', 'Replicando produto para outras empresas - 1/1');
        // Replicar produtos para outras empresas
        if not vDadosIni.produtos_replicacao_interna(StrToInt(grupo_prod), cod_prod) then
        begin
         Result := false;
         exit;
        end;
      finally
      	vDadosIni.fechaStatusProcessamento;
      end;

      vDadosIni.verificarReplicacaoInterna(buscas, true);
      if vRegiao.dataSet.FieldByName('TIPO').AsString = 'AVULSO' then
        vDadosIni.verificarPromocao(buscas, vRegiao.dataSet.FieldByName('CODIGO').AsInteger, 5);
      vDadosIni.verificarTabPreco(buscas, vRegiao.dataSet.FieldByName('TIPO').AsString, vRegiao.dataSet.FieldByName('CODIGO').AsInteger);

      valor := vvalortemp;
			porcentagem := vporcentagemtemp;
      vproporcao_tabela := 0;
      if markup > 0 then
      begin
        porcentagem := 0;

        vinf := 'M';
      end
      else if porcentagem <> 0 then
      begin
      	if vDadosIni.vtpPreco = 'P' then
        begin
          porcentagem := Abs(porcentagem);
          if valor > 0 then
            porcentagem := 0;
          vproporcao_tabela := 0;

          vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');
        end
        else
        begin
          vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

          if porcentagem > 0 then
            vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
          else
            vproporcao_tabela := 1 - (Abs(porcentagem) / 100);

          valor := vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat + ((vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * porcentagem);
          porcentagem := 0;
        end;
      end
      else
      begin
        porcentagem := 0;

        vinf := 'V';
      end;

      try
        vRegiao.dataSet.DisableControls;
        vRegiao.dataSet.First;
        while not vRegiao.dataSet.Eof do
        begin
        	if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'LOCALIDADE') then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por localidade - ' + IntToStr(vRegiao.dataSet.RecNo) + '/' + IntToStr(vRegiao.dataSet.RecordCount))
          else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'SETOR') then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por setor - ' + IntToStr(vRegiao.dataSet.RecNo) + '/' + IntToStr(vRegiao.dataSet.RecordCount))
          else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'CIDADE') then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por cidade - ' + IntToStr(vRegiao.dataSet.RecNo) + '/' + IntToStr(vRegiao.dataSet.RecordCount))
          else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'AVULSO') then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços tabela avulsa - ' + IntToStr(vRegiao.dataSet.RecNo) + '/' + IntToStr(vRegiao.dataSet.RecordCount));

        	for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
        	begin
            buscas.Close;
            buscas.SQL.Text := ' INSERT INTO PROMOCAO_PRODUTO ' +
              ' (COD_PROMOCAO, COD_TPPRECO, COD_EMPRESA, VALOR_PROMOCAO, ' +
              ' PORCENTAGEM, GRUPO_PROD, COD_PROD, ' +
              ' COD_LOCALIDADE, COD_SETOR, COD_CIDADE, SIGLA, ' +
              ' PROPORCAO_TABELA, MAX_DESC, MARKUP, INF';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED';

            buscas.SQL.Text := buscas.SQL.Text + ') ';

            buscas.SQL.Text := buscas.SQL.Text +
              ' VALUES (:COD_PROMOCAO, :COD_TPPRECO, :COD_EMPRESA, :VALOR_PROMOCAO, ' +
              ' :PORCENTAGEM, :GRUPO_PROD, :COD_PROD, ' +
              ' :COD_LOCALIDADE, :COD_SETOR, :COD_CIDADE, :SIGLA, ' +
              ' :PROPORCAO_TABELA, :MAX_DESC, :MARKUP, :INF';

            if trim(debcred) <> '' then
            	buscas.SQL.Text := buscas.SQL.Text + ', :USAR_DEBCRED';

            buscas.SQL.Text := buscas.SQL.Text + ');';

            buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
            buscas.ParamByName('COD_SETOR').AsInteger := 0;
            buscas.ParamByName('COD_CIDADE').AsInteger := 0;
            buscas.ParamByName('COD_PROMOCAO').AsInteger := 0;

            if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'LOCALIDADE') then
              buscas.ParamByName('COD_LOCALIDADE').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
            else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'SETOR') then
              buscas.ParamByName('COD_SETOR').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
            else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'CIDADE') then
              buscas.ParamByName('COD_CIDADE').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
            else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'AVULSO') then
              buscas.ParamByName('COD_PROMOCAO').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger;

            buscas.ParamByName('SIGLA').AsString := '0';
            buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
            buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
            buscas.ParamByName('MAX_DESC').AsFloat := max_desc;
            buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
            buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
            if markup > 0 then
              buscas.ParamByName('VALOR_PROMOCAO').AsFloat := CalcUtils.Preco(vProduto.ffloat('prec_cusm_prod'), markup, 0 - vDadosIni.vEmp.vCasasDecimais);
            buscas.ParamByName('INF').AsString := vinf;

          	if trim(debcred) <> '' then
              if trim(debcred) = 'Z' then
                buscas.ParamByName('USAR_DEBCRED').Value := Null
              else
                buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

            buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
            buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
            buscas.ParamByName('COD_PROD').AsString := cod_prod;
            buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);

            buscas2.Close;
            buscas2.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
              ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
              ' AND COD_TPPRECO = :COD_TPPRECO ' +
              ' AND GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
              ' AND COD_SETOR = :COD_SETOR ' +
              ' AND COD_CIDADE = :COD_CIDADE ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ';
            buscas2.ParamByName('COD_PROMOCAO').AsInteger := buscas.ParamByName('COD_PROMOCAO').AsInteger;
            buscas2.ParamByName('COD_TPPRECO').AsInteger := tipo;
            buscas2.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
            buscas2.ParamByName('COD_PROD').AsString := cod_prod;
            buscas2.ParamByName('COD_LOCALIDADE').AsInteger := buscas.ParamByName('COD_LOCALIDADE').AsInteger;
            buscas2.ParamByName('COD_SETOR').AsInteger := buscas.ParamByName('COD_SETOR').AsInteger;
            buscas2.ParamByName('COD_CIDADE').AsInteger := buscas.ParamByName('COD_CIDADE').AsInteger;
            buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
            buscas2.Open;
            // Verifica se o registro existe
            if (buscas2.FieldByName('FIRST').AsInteger = 0) then
            begin
              acao := 'INSERIR';
              buscas.ExecSQL;

              vDadosIni.GravaAuditoria('PRO235', acao,
              	trim(grupo_prod) + '-' +
              	trim(cod_prod) + ' - ' +
              	trim(vRegiao.dataSet.FieldByName('TIPO').AsString) + ': ' + IntToStr(vRegiao.dataSet.FieldByName('CODIGO').AsInteger) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp),	'VALOR: ' + FormatFloat('0.000', vvalortemp)),
              	'PROMOCAO_PRODUTO',
              	'0', buscas);
            end
            else
            begin
              if StrToInt(vDadosIni.codEmpresa) = StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]) then
              begin
                if editar = false then
                  if Application.MessageBox(pchar('Preço de tabela já incluído nesta tipo, deseja atualizar as informações ?' + #13 +
                    'Grupo Prod: ' + trim(grupo_prod) + #13 +
                    'Cod Prod: ' + trim(cod_prod)), 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
                  begin
                    Result := False;
                    exit;
                  end;

                if not vDadosIni.PesqPros('PRO234', 'ALTERAR',
                	grupo_prod + '-' + cod_prod, 'PROMOCAO_PRODUTO',
                  '', buscas2, False) then
                  Exit;
              end;

              editar := true;
              acao := 'EDITAR';

              buscas.Close;
              buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO ' +
                ' SET VALOR_PROMOCAO = :VALOR_PROMOCAO, ' +
                ' PORCENTAGEM = :PORCENTAGEM, ' +
                ' MAX_DESC = :MAX_DESC, ' +
                ' PROPORCAO_TABELA = :PROPORCAO_TABELA, ' +
                ' MARKUP = :MARKUP, ' +
                ' INF = :INF ';

		          if trim(debcred) <> '' then
    	        	buscas.SQL.Text := buscas.SQL.Text + ', USAR_DEBCRED = :USAR_DEBCRED ';

              buscas.SQL.Text := buscas.SQL.Text +
                ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
                ' AND SIGLA = :SIGLA ' +
                ' AND COD_TPPRECO = :COD_TPPRECO ' +
                ' AND GRUPO_PROD = :GRUPO_PROD ' +
                ' AND COD_PROD = :COD_PROD ' +
                ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
                ' AND COD_SETOR = :COD_SETOR ' +
                ' AND COD_CIDADE = :COD_CIDADE ' +
                ' AND COD_EMPRESA = :COD_EMPRESA; ';
              buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
              buscas.ParamByName('COD_SETOR').AsInteger := 0;
              buscas.ParamByName('COD_CIDADE').AsInteger := 0;
              buscas.ParamByName('COD_PROMOCAO').AsInteger := 0;

              if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'LOCALIDADE') then
                buscas.ParamByName('COD_LOCALIDADE').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
              else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'SETOR') then
                buscas.ParamByName('COD_SETOR').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
              else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'CIDADE') then
                buscas.ParamByName('COD_CIDADE').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger
              else if (vRegiao.dataSet.FieldByName('TIPO').AsString = 'AVULSO') then
                buscas.ParamByName('COD_PROMOCAO').AsInteger := vRegiao.dataSet.FieldByName('CODIGO').AsInteger;

              buscas.ParamByName('SIGLA').AsString := '0';
              buscas.ParamByName('VALOR_PROMOCAO').AsFLoat := valor;
              buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
              buscas.ParamByName('MAX_DESC').AsFLoat := max_desc;
              buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
              if markup > 0 then
                buscas.ParamByName('VALOR_PROMOCAO').AsFloat := CalcUtils.Preco(vProduto.ffloat('prec_cusm_prod'), markup, 0 - vDadosIni.vEmp.vCasasDecimais);
              buscas.ParamByName('INF').AsString := vinf;

            	if trim(debcred) <> '' then
                if trim(debcred) = 'Z' then
                  buscas.ParamByName('USAR_DEBCRED').Value := Null
                else
                  buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

              buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
              buscas.ParamByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
              buscas.ParamByName('COD_PROD').AsString := cod_prod;
              buscas.ExecSQL;

              vDadosIni.GravaAuditoria('PRO235', acao,
              	trim(grupo_prod) + '-' +
              	trim(cod_prod) + ' - ' +
              	trim(vRegiao.dataSet.FieldByName('TIPO').AsString) + ': ' + IntToStr(vRegiao.dataSet.FieldByName('CODIGO').AsInteger) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: ' + FormatFloat('0.000', vvalortemp)),
              	'PROMOCAO_PRODUTO',
              	'0', buscas);
            end;
          end;

          vRegiao.dataSet.Next;
        end;
      finally
        vDadosIni.fechaStatusProcessamento;
        vRegiao.dataSet.First;
        vRegiao.dataSet.EnableControls;
      end;
    finally
      vRegiao.dataSet.Filtered := False;
    end;

    if not vRegiao.dataSet.IsEmpty then
    begin
      buscas.Transaction.Commit;
      _abrePrecoProdutos(grupo_prod, cod_prod);

      Result := True;

      if Result then
      begin
        vDadosIni.fechaStatusProcessamento;
        CommitaTransacao;
        vDadosIni.GravaAuditoria('PRO235', acao, 'SUCESSO', 'PROMOCAO_PRODUTO', '0', buscas);
      end;
    end;

  except on E: Exception do
    begin
      Result := false;
      vDadosIni.fechaStatusProcessamento;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO235', acao, 'FALHA', 'PROMOCAO_PRODUTO', '0', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.retornaPrecoTabela(grupoprod: string;
  codprod: string): Double;
begin
	Result := 0;

  SqlOpen('select prec_tab_prod from produtos ' +
  	' where grupo_prod = ' + grupoprod +
    ' and cod_prod = ' + QuotedStr(trim(codprod)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);

  Result := buscas.FieldByName('prec_tab_prod').AsFloat;
end;

function TPromocaoProduto.retornaSigla(pTipo: string): string;
begin
	if (trim(pTipo) = '') or (trim(pTipo) = '0') then
  begin
  	Result := '0 - TODOS';
  	Exit;
  end;

	buscas.Close;
  buscas.SQL.Text := 'select descricao from tipo_vendas ' +
  	' where tipo = ''REQ'' ' +
    ' and sigla = :sigla ';
  buscas.ParamByName('sigla').AsString := pTipo;
  buscas.Open;

  Result := trim(buscas.FieldByName('DESCRICAO').AsString);
end;

function TPromocaoProduto._abrePrecoProdutos(grupo_prod,
  cod_prod: string; cod_promocao: string = ''): Boolean;
var
  vproporcao_temp, vporcentagem_temp: Double;
begin
  if ((Trim(grupo_prod) <> '') and (trim(cod_prod) <> '')) then
  begin
    buscas.Close;
    buscas.SQL.Text :=
      ' select pe.descr_promocao, ' +
      ' pr.descr_prod, ' +
      ' pr.prec_tab_prod, ' +
      ' pr.prec_publico, ' +
      ' pr.prec_cusm_prod, ' +
      ' tp.descr_tipo, ' +
      ' tp.tipo, ' +
      ' p.*, ' +
      ' l.localidade, ' +
      ' st.setor, ' +
      ' cd.nome_cidade ' +
      ' from promocao_produto p ' +
      ' inner join promocao pe on pe.cod_promocao = p.cod_promocao and pe.cod_empresa = p.cod_empresa and pe.cod_tppreco = p.cod_tppreco ' +
      ' inner join tipo_preco tp on tp.cod_tppreco = p.cod_tppreco and tp.cod_empresa = p.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = p.grupo_prod and pr.cod_prod = p.cod_prod and pr.cod_empresa = p.cod_empresa ' +
      ' left join localidade l on l.cod_localidade = p.cod_localidade and l.cod_empresa = p.cod_empresa ' +
      ' left join setor st on st.cod_setor = p.cod_setor and st.cod_empresa = p.cod_empresa ' +
      ' left join cidades cd on cd.cod_cidade = p.cod_cidade ' +
      ' where pr.ativo = 1 ' +
      ' and tp.tipo = ''T'' ' +
      ' and pr.grupo_prod = ' + grupo_prod +
      ' and pr.cod_prod = ' + QuotedStr(cod_prod) +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by tp.tipo, tp.descr_tipo, pe.descr_promocao ';
    buscas.Open;
  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text :=
      ' select pe.descr_promocao, ' +
      ' pr.descr_prod, ' +
      ' pr.prec_tab_prod, ' +
      ' pr.prec_publico, ' +
      ' pr.prec_cusm_prod, ' +
      ' tp.descr_tipo, ' +
      ' tp.tipo, ' +
      ' p.*, ' +
      ' l.localidade, ' +
      ' st.setor, ' +
      ' cd.nome_cidade ' +
      ' from promocao_produto p ' +
      ' inner join promocao pe on pe.cod_promocao = p.cod_promocao and pe.cod_empresa = p.cod_empresa and pe.cod_tppreco = p.cod_tppreco ' +
      ' inner join tipo_preco tp on tp.cod_tppreco = p.cod_tppreco and tp.cod_empresa = p.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = p.grupo_prod and pr.cod_prod = p.cod_prod and pr.cod_empresa = p.cod_empresa ' +
      ' left join localidade l on l.cod_localidade = p.cod_localidade and l.cod_empresa = p.cod_empresa ' +
      ' left join setor st on st.cod_setor = p.cod_setor and st.cod_empresa = p.cod_empresa ' +
      ' left join cidades cd on cd.cod_cidade = p.cod_cidade ' +
      ' where pr.ativo = 1 ' +
      ' and tp.tipo = ''T'' ' +
      ' and p.cod_empresa = 0 ' +
      ' order by tp.tipo, tp.descr_tipo, pe.descr_promocao ';
    buscas.Open;
  end;

  dataSet.Open;
  dataSet.EmptyDataSet;

  buscas.First;
  while not buscas.Eof do
  begin
    dataSet.Insert;

  	if buscas.FieldByName('VALOR_PROMOCAO').AsFloat > 0 then
	    	dataSet.FieldByName('VALOR_PROMOCAO_TEMP').AsFloat := buscas.FieldByName('VALOR_PROMOCAO').AsFloat
    else if buscas.FieldByName('PORCENTAGEM').AsFloat <> 0 then
    begin
    	if buscas.FieldByName('TIPO').AsString = 'P' then
      	dataSet.FieldByName('VALOR_PROMOCAO_TEMP').AsFloat := (buscas.FieldByName('PREC_TAB_PROD').AsFloat / 100) *
      		(100 - Abs(buscas.FieldByName('PORCENTAGEM').AsFloat))
      else
      begin
      	if buscas.FieldByName('PORCENTAGEM').AsFloat > 0 then
        	dataSet.FieldByName('VALOR_PROMOCAO_TEMP').AsFloat := (buscas.FieldByName('PREC_TAB_PROD').AsFloat / 100) *
            (100 + Abs(buscas.FieldByName('PORCENTAGEM').AsFloat))
        else
          dataSet.FieldByName('VALOR_PROMOCAO_TEMP').AsFloat := (buscas.FieldByName('PREC_TAB_PROD').AsFloat / 100) *
            (100 - Abs(buscas.FieldByName('PORCENTAGEM').AsFloat));
      end;
    end
  	else
      	dataSet.FieldByName('VALOR_PROMOCAO_TEMP').AsFloat := 0;

    if buscas.FieldByName('PORCENTAGEM').AsFloat <> 0 then
    begin
    	if buscas.FieldByName('TIPO').AsString = 'P' then
      	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := 0 - Abs(buscas.FieldByName('PORCENTAGEM').AsFloat)
      else
	    	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := buscas.FieldByName('PORCENTAGEM').AsFloat;
    end
    else if (buscas.FieldByName('PROPORCAO_TABELA').AsFloat > 1) and (vDadosIni.vProduto.vRecalcularPrecoDiferenciado) then
    begin
      	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := Abs(1 - Abs(buscas.FieldByName('PROPORCAO_TABELA').AsFloat)) * 100;
    end
    else if (buscas.FieldByName('PROPORCAO_TABELA').AsFloat > 0) and (vDadosIni.vProduto.vRecalcularPrecoDiferenciado) then
    begin
      	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := - Abs(1 - Abs(buscas.FieldByName('PROPORCAO_TABELA').AsFloat)) * 100;
    end
    else if (buscas.FieldByName('VALOR_PROMOCAO').AsFloat > 0)
    	and (buscas.FieldByName('PREC_TAB_PROD').AsFloat > 0)
      and (buscas.FieldByName('PREC_TAB_PROD').AsFloat > buscas.FieldByName('VALOR_PROMOCAO').AsFloat) then
       	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := - Abs(
          ((buscas.FieldByName('VALOR_PROMOCAO').AsFloat / buscas.FieldByName('PREC_TAB_PROD').AsFloat) - 1) * 100)
    else if (buscas.FieldByName('VALOR_PROMOCAO').AsFloat > 0)
    	and (buscas.FieldByName('PREC_TAB_PROD').AsFloat > 0)
      and (buscas.FieldByName('VALOR_PROMOCAO').AsFloat > buscas.FieldByName('PREC_TAB_PROD').AsFloat) then
      	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := Abs(
          ((buscas.FieldByName('VALOR_PROMOCAO').AsFloat / buscas.FieldByName('PREC_TAB_PROD').AsFloat) - 1) * 100)
    else
      	dataSet.FieldByName('PORCENTAGEM_TEMP').AsFloat := 0;
    
    dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := buscas.FieldByName('VALOR_PROMOCAO').AsFloat;
    dataSet.FieldByName('PORCENTAGEM').AsFloat := buscas.FieldByName('PORCENTAGEM').AsFloat;
    dataSet.FieldByName('MAX_DESC').AsFloat := buscas.FieldByName('MAX_DESC').AsFloat;
    dataSet.FieldByName('PREC_TAB_PROD').AsFloat := buscas.FieldByName('PREC_TAB_PROD').AsFloat;
    dataSet.FieldByName('PREC_PUBLICO').AsFloat  := buscas.FieldByName('PREC_PUBLICO').AsFloat;
    
    dataSet.FieldByName('COD_TPPRECO').AsInteger := buscas.FieldByName('COD_TPPRECO').AsInteger;
    dataSet.FieldByName('GRUPO_PROD').AsInteger := StrToInt(grupo_prod);
    dataSet.FieldByName('COD_PROD').AsString := cod_prod;
    dataSet.FieldByName('TIPO').AsString := buscas.FieldByName('TIPO').AsString;

    dataSet.FieldByName('COD_LOCALIDADE').AsInteger := 0;
    dataSet.FieldByName('COD_SETOR').AsInteger := 0;
    dataSet.FieldByName('COD_CIDADE').AsInteger := 0;

    if (buscas.FieldByName('DESCR_TIPO').AsString = 'LOCALIDADE') then
    begin
    	dataSet.FieldByName('COD_PROMOCAO').AsInteger := buscas.FieldByName('COD_PROMOCAO').AsInteger;
      dataSet.FieldByName('COD_LOCALIDADE').AsInteger := buscas.FieldByName('COD_LOCALIDADE').AsInteger;
      dataSet.FieldByName('DESCR_TIPO').AsString := 'LOCALIDADE';
      dataSet.FieldByName('DESCRICAO').AsString := buscas.FieldByName('LOCALIDADE').AsString;
    end
    else if (buscas.FieldByName('DESCR_TIPO').AsString = 'SETOR') then
    begin
    	dataSet.FieldByName('COD_PROMOCAO').AsInteger := buscas.FieldByName('COD_PROMOCAO').AsInteger;
      dataSet.FieldByName('COD_SETOR').AsInteger := buscas.FieldByName('COD_SETOR').AsInteger;
      dataSet.FieldByName('DESCR_TIPO').AsString := 'SETOR';
      dataSet.FieldByName('DESCRICAO').AsString := buscas.FieldByName('SETOR').AsString;
    end
    else if (buscas.FieldByName('DESCR_TIPO').AsString = 'CIDADE') then
    begin
    	dataSet.FieldByName('COD_PROMOCAO').AsInteger := buscas.FieldByName('COD_PROMOCAO').AsInteger;
      dataSet.FieldByName('COD_CIDADE').AsInteger := buscas.FieldByName('COD_CIDADE').AsInteger;
      dataSet.FieldByName('DESCR_TIPO').AsString := 'CIDADE';
      dataSet.FieldByName('DESCRICAO').AsString := buscas.FieldByName('NOME_CIDADE').AsString;
    end
    else if (buscas.FieldByName('DESCR_TIPO').AsString = 'AVULSO') then
    begin
      dataSet.FieldByName('COD_PROMOCAO').AsInteger := buscas.FieldByName('COD_PROMOCAO').AsInteger;
      dataSet.FieldByName('DESCR_TIPO').AsString := 'AVULSO';
      dataSet.FieldByName('DESCRICAO').AsString := buscas.FieldByName('DESCR_PROMOCAO').AsString;
    end;         

    dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
    dataSet.FieldByName('MARKUP').AsFloat := buscas.FieldByName('MARKUP').AsFloat;
    dataSet.FieldByName('MARGEM').AsFloat := 0;
    if (ffloat('markup') > 0) and (ffloat('prec_cusm_prod') > 0) then
      dataSet.FieldByName('MARGEM').AsFloat := CalcUtils.MargemLucro(ffloat('markup'), DIGROUNDMAX);
		dataSet.FieldByName('USAR_DEBCRED').AsString := buscas.FieldByName('USAR_DEBCRED').AsString;    
    dataSet.Post;

    buscas.Next;
  end;
  vRegiao._abreRegiao('');

  dataSet.IndexFieldNames := 'GRUPO_PROD;COD_PROD;DESCR_TIPO;DESCRICAO';
  dataSet.First;

  ffDisplayFormat('VALOR_PROMOCAO', DisplayNumber(vDadosIni.vEmp.vCasasDecimais));
  ffDisplayFormat('PREC_TAB_PROD', DisplayNumber(vDadosIni.vEmp.vCasasDecimais));
  ffDisplayFormat('PREC_PUBLICO', DisplayNumber(vDadosIni.vEmp.vCasasDecimais));
  ffDisplayFormat('MARKUP', DisplayNumber(vDadosIni.vProduto.Precos.DigMrkMrg));
  ffDisplayFormat('MARGEM', DisplayNumber(vDadosIni.vProduto.Precos.DigMrkMrg));

  dataSet.FieldByName('markup').Visible := vDadosIni.PesqPros('PRO439', 'HABILITAR', '', 'PROMOCAO_PRODUTO', '', buscas, false, False, True);
  dataSet.FieldByName('margem').Visible := dataSet.FieldByName('markup').Visible;
end;

