procedure TEtiquetas_Es._desmarcarTodosTemp(pDataset: TDataSet);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not pDataset.Active then
      Exit;

    pDataset.DisableControls;
    pDataset.First;
    while not pDataset.Eof do
    begin
      pDataset.Edit;
      pDataset.FieldByName('sel').AsString := '';
      pDataset.Post;
      pDataset.Next;
    end;
    pDataset.First;

  finally
  	pDataset.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TEtiquetas_Es._marcaDesmarcaLinha(pDataset: TDataSet);
begin
	if pDataset.IsEmpty then
    exit;

  pDataset.Edit;
  if pDataset.FieldByName('SEL').AsString = 'S' then
    pDataset.FieldByName('SEL').AsString := ''
  else
    pDataset.FieldByName('SEL').AsString := 'S';
  pDataset.Post;
end;

procedure TEtiquetas_Es._marcaTodosTemp(pDataset: TDataSet);
