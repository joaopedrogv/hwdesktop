    result := montaSelect('select ps.*, pr.num_fab_prod, pr.descr_prod, ' +
      ' prs.num_fab_prod as num_fab_prod_sim from prod_similares ps ' +
      ' left join produtos pr on ps.grupo_prod = pr.grupo_prod and ps.cod_prod = pr.cod_prod and ps.cod_empresa = pr.cod_empresa ' +
      ' left join produtos prs on ps.grupo_ps = prs.grupo_prod and ps.cod_ps = prs.cod_prod and ps.cod_empresa = prs.cod_empresa ' +
    	' where ps.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ps.ativo<>1');
end;

procedure TProdSimilares.CadProdSimilar(TipoForm: integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo cadastro de Produtos / Grupos Similares');
    vDadosIni.vTipoForm := TipoForm;
    if DtmProdutos = nil then
      DtmProdutos := TDtmProdutos.Create(DtmProdutos);

  	if not vDadosIni.PesqPros('PRO344', 'ABRIR', '', 'PROD_SIMILARES', '', DtmProdutos.qrBuscasP, true) then
    begin
    	vDadosIni.fechaStatusProcessamento;
    	exit;
    end;

    if FrmCadProdSimilares = nil then
    begin
        if TipoForm > 0 then
          vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TFrmCadProdSimilares, FrmCadProdSimilares);
		end;

    if (TipoForm > 0) and (not FrmCadProdSimilares.Visible) then
    	FrmCadProdSimilares.ShowModal
    else if (not FrmCadProdSimilares.Visible) then
    	FrmCadProdSimilares.Show
    else if FrmCadProdSimilares.FormStyle = fsMDIChild then
      FrmCadProdSimilares.Show
    else
      FrmCadProdSimilares.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

