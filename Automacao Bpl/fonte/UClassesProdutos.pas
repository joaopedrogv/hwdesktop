function TGrade.testarGradesTipoEC: boolean;
var
  vLista: TStringList;
  buscas2: TIBQuery;
  I: Integer;
begin
  try
    Result := true;
    
    if not (vDadosIni.vEcommerce.vHabilitarEcommerce) then
      exit;

    if (dataSet.State <> dsEdit) then
      exit;

    if (dataSet.FieldByName('TIPO_EC').OldValue = dataSet.FieldByName('TIPO_EC').NewValue)
    	and (dataSet.FieldByName('TIPO_EC1').OldValue = dataSet.FieldByName('TIPO_EC1').NewValue) then
     exit;

    vLista := TStringList.Create;
    vLista.Clear;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas2.Close;
    buscas2.SQL.Text := ' select distinct pg.grupo_prod, pg.cod_prod, pg.cod_empresa from produtos_ec_grade pg ' +
      ' inner join grade g on g.cod_grade = pg.cod_grade and g.cod_empresa = pg.cod_empresa ' +
      ' where g.cod_grade = :cod_grade and g.cod_empresa = :cod_empresa ';
    buscas2.ParamByName('cod_grade').AsInteger := dataSet.FieldByName('cod_grade').AsInteger;
    buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas2.Open;

    buscas2.First;
    while not buscas2.Eof do
    begin
      buscas.Close;
      buscas.SQL.Text := ' select pg.grupo_prod, pg.cod_prod, pg.cod_empresa, pg.cod_grade from produtos_ec_grade pg ' +
        ' where pg.grupo_prod = :grupo_prod and pg.cod_prod = :cod_prod and pg.cod_empresa = :cod_empresa ';
      buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
      buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.FieldByName('cod_grade').AsInteger <> dataSet.FieldByName('cod_grade').AsInteger then
          if (vLista.IndexOf(buscas.FieldByName('cod_grade').AsString) <= -1) then
            vLista.Add(buscas.FieldByName('cod_grade').AsString);

        buscas.Next;
      end;

      buscas2.Next;
    end;

    for I := 0 to vLista.Count - 1 do
    begin
      buscas.Close;
      buscas.SQL.Text := ' update grade set tipo_ec = :tipo_ec, tipo_ec1 = :tipo_ec1 ';

      if trim(dataSet.FieldByName('tipo_ec1').AsString) = '' then
      	buscas.SQL.Text := buscas.SQL.Text + ', descricao_ec1 = null ';

    	buscas.SQL.Text := buscas.SQL.Text +
        ' where cod_grade = :cod_grade and cod_empresa = :cod_empresa ';
      buscas.ParamByName('tipo_ec').Value := dataSet.FieldByName('tipo_ec').Value;
      buscas.ParamByName('tipo_ec1').Value := dataSet.FieldByName('tipo_ec1').Value;
      buscas.ParamByName('cod_grade').AsInteger := StrToInt(vLista[i]);
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;

      if trim(dataSet.FieldByName('tipo_ec1').AsString) <> '' then
      begin
      	buscas.Close;
        buscas.SQL.Text := ' update grade set descricao_ec1 = descricao_ec ' +
          ' where cod_grade = :cod_grade and cod_empresa = :cod_empresa ' +
          ' and coalesce(descricao_ec1, '''') = '''' ';
        buscas.ParamByName('cod_grade').AsInteger := StrToInt(vLista[i]);
        buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ExecSQL;
      end;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

