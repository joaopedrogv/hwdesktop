function TPromocaoProduto.existePromocao(cod_promocao: string): Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select cod_promocao from promocao where ' +
    ' cod_promocao =' + cod_promocao + ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  Result := not buscas.IsEmpty;
end;

function TPromocaoProduto.existeTipoTabela(pcodTipo, pCodTabela, pTabela: string): Boolean;
begin
  buscas.Close;
  if pTabela = 'AVULSO' then
    buscas.SQL.Text := 'select cod_promocao from promocao where ' +
      ' cod_promocao =' + pcodTipo + ' and cod_empresa = ' + vDadosIni.codEmpresa
  else if pTabela = 'LOCALIDADE' then
    buscas.SQL.Text := 'select cod_localidade from localidade where ' +
      ' cod_localidade =' + pcodTipo + ' and cod_empresa = ' + vDadosIni.codEmpresa
  else if pTabela = 'SETOR' then
    buscas.SQL.Text := 'select cod_setor from setor where ' +
      ' cod_setor =' + pcodTipo + ' and cod_empresa = ' + vDadosIni.codEmpresa
  else if pTabela = 'CIDADE' then
    buscas.SQL.Text := 'select cod_cidade from cidades where ' +
      ' cod_cidade =' + pcodTipo + '';
  buscas.Open;

  Result := not buscas.IsEmpty;
end;

function TPromocaoProduto.Insert: boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO238', 'INCLUIR', '', 'PROMOCAO_PRODUTO', '', buscas, False) then
    Exit;

  if not dataSet.Active then
    montaSelect('select pr.grupo_prod, pr.descr_prod, tp.descr_tipo, tp.tipo, p.*, l.localidade, st.setor, cd.nome_cidade,pr.tab_prod, pr.prec_publico from promocao_produto p ' +
      ' inner join tipo_preco tp on tp.cod_tppreco = p.cod_tppreco and tp.cod_empresa = p.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = p.grupo_prod and pr.cod_prod = p.cod_prod and pr.cod_empresa = p.cod_empresa ' +
      ' left join localidade l on l.cod_localidade = p.cod_localidade and l.cod_empresa = p.cod_empresa ' +
      ' left join setor st on st.cod_setor = p.cod_setor and st.cod_empresa = p.cod_empresa ' +
      ' left join cidades cd on cd.cod_cidade = p.cod_cidade ' +
      ' where pr.ativo = 1 ' +
      ' and tp.tipo = ''T'' ' +
      ' and p.cod_promocao = 0 ' +
      ' and pr.cod_empresa = 0');

  if inherited insert then
  begin
    Result := True;

    vTipoPreco._abreTipoPrecoPromocao;
    vPromocao._abrePromocao;
    dataSet.FieldByName('markup').AsFloat := 0;
    dataSet.FieldByName('margem').AsFloat := 0;
    // vTipoVenda._abreTipoVenda;
  end;

end;

