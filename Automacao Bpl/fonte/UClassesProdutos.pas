procedure TImagemList.Clear;
begin
  inherited;
  fIndex := -1;
end;

constructor TImagemList.create;
begin
  fIndex := -1;
end;

function TImagemList.DeleteR: Boolean;
begin
  Result := False;
  if fIndex > -1 then
  begin
    Delete(fIndex);
    if (fIndex - 1) > -1 then
      fIndex := fIndex - 1;
    Result := True;
  end;
  if Self.Count = 0 then
    fIndex := -1;
end;

function TImagemList.First: TImagem;
begin
  if (Self.Count > 0) then
  begin
    fIndex := 0;
    Result := GetItem(fIndex);
  end;
end;

function TImagemList.GetItem(Index: Integer): TImagem;
begin
  Result := TImagem(Inherited Items[Index]);
end;

function TImagemList.ItemSelected: TImagem;
begin
  Result := GetItem(fIndex);
end;

function TImagemList.Last: TImagem;
begin
  if (Self.Count > 0) then
  begin
    fIndex := Self.Count - 1;
    Result := GetItem(fIndex);
  end;
end;

function TImagemList.New: TImagem;
begin
  Result := TImagem.Create();
  Add(Result);

  fIndex := Self.Count - 1;
end;

function TImagemList.Next: TImagem;
begin
  if (fIndex > -1) and (Self.Count > 0) then
  begin
    if (fIndex + 1)  <= (Self.Count -1) then
      fIndex := fIndex + 1;
    Result := GetItem(fIndex);
  end;
end;

function TImagemList.Previous: TImagem;
begin
  if (fIndex > -1) and (Self.Count > 0) then
  begin
    if (fIndex - 1) >= (0) then
      fIndex := fIndex - 1;
    Result := GetItem(fIndex);
  end;
end;

procedure TImagemList.SetItem(Index: Integer; const Value: TImagem);
begin
  Put(Index, Value);
end;

