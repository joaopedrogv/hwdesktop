function TProdutos.marcarProdutoEtiqueta(modoSilencioso, qtdeIgual1: Boolean): boolean;
var
  i: integer;
  HandleRel: THandle;
  vMarcarProdEtiqueta: TRelatoriosSimples;
begin
  try
    result := false;
    if ExecutaComandosSql(' select first 1 nitem from IMP_BAR_PROD ' +
    	' where grupo_prod = ' + IntToStr(DataSet.FieldByName('GRUPO_PROD').AsInteger) +
      ' and cod_prod = ' + QuotedStr(trim(DataSet.FieldByName('COD_PROD').AsString)) +
      ' and ativo = 1' +
      ' and cod_empresa = ' + vDadosIni.codEmpresa) then
    begin
      if not modoSilencioso then
        if not Application.MessageBox('Este produto já está marcado.' + chr(13) +
          'Deseja remarcá-lo?', 'Confirmação', MB_YESNO + MB_ICONQUESTION +
          MB_DEFBUTTON1) = mrYES then
          exit;

      ExecutaComandosSqlExec(' delete from IMP_BAR_PROD ' +
        ' where grupo_prod = ' + IntToStr(DataSet.FieldByName('GRUPO_PROD').AsInteger) +
        ' and cod_prod = ' + QuotedStr(trim(DataSet.FieldByName('COD_PROD').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa);
      CommitaTransacao;
    end;

    vMarcarProdEtiqueta := TRelatoriosSimples.create;

    vMarcarProdEtiqueta.QtdeEmt := Floattostr(dataSet.FieldByName('Est_F').AsFloat);
    vMarcarProdEtiqueta.QtdTemp := dataSet.FieldByName('Est_F').AsFloat;
    if qtdeIgual1 then
    begin
      vMarcarProdEtiqueta.QtdeEmt := '1';
      vMarcarProdEtiqueta.QtdTemp := 1;
    end
    else
    begin
      vDadosIni.InputValoReal('Quantidade de Etiqueta',
        copy(dataSet.FieldByName('DESCR_PROD').AsString, 1, 15) + ' - Quantidade:',
        vMarcarProdEtiqueta.QtdTemp);
      if dataSet.FieldByName('Est_F').AsFloat <> vMarcarProdEtiqueta.QtdTemp then
        vMarcarProdEtiqueta.QtdeEmt := inttostr(round(vMarcarProdEtiqueta.QtdTemp));
    end;

    if strtofloat(vMarcarProdEtiqueta.QtdeEmt) >= 1 then
      for I := 1 to strtoint(vMarcarProdEtiqueta.QtdeEmt) do
        MarcaProdutoParaEtiquetaQRP(DataSet.FieldByName('GRUPO_PROD').AsInteger, DataSet.FieldByName('COD_PROD').AsString, 1);

	 result := true;
  finally
    if vMarcarProdEtiqueta <> nil then
    begin
      vMarcarProdEtiqueta.Free;
      vMarcarProdEtiqueta := nil;
    end;
  end;

  {if dtSetProdTemp = nil then
  begin
    dtSetProdTemp := TClientDataSet(dtmProdutos.cdsProdTemp);
    dtSetProdTemp.Close;
    dtSetProdTemp.FieldDefs.Clear;
    buscas.Close;
    buscas.SQL.Text := 'select first 0  p.* from produtos p where p.cod_empresa= ' + vDadosIni.codEmpresa;
    buscas.Open;
    dtSetProdTemp.FieldDefs.Add('NITEM', ftInteger, 0, false);
    dtSetProdTemp.FieldDefs.Add('DT_MARCACAO', ftDateTime, 0, false);
    for I := 0 to buscas.FieldDefs.Count - 1 do
      dtSetProdTemp.FieldDefs.Add(
        dataSet.FieldDefs[i + 2].Name,
        dataSet.FieldDefs[i + 2].DataType,
        dataSet.FieldDefs[i + 2].Size,
        false);
    dtSetProdTemp.close;
    dtSetProdTemp.CreateDataSet;
  end;}

end;

