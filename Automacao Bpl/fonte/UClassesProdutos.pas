begin
	vnf_icmsst_cest_v2 := vDadosIni.getConfSisObject('nf_icmsst_cest_v2', buscas);

  if vnf_icmsst_cest_v2.value1_f = 1 then
    SqlOpen(' select cest from cest_ ' +
