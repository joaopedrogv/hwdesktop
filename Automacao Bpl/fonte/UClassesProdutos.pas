function TCategorias.abreConsCategorias(pBuscas: TIBQuery): boolean;
begin
   SqlOpen(' select (c.cod_categoria) ordem, c.cod_categoria, c.descricao, ' +
   	' (c.cod_categoria || '' - '' || trim(coalesce(c.descricao, ''''))) descricao2, ' +
    ' c.cod_empresa from categoria c ' +
    ' where coalesce(c.cod_categoria_pai, 0) = 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' union ' +
    ' select (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then '''' ' +
    '              else (coalesce(c2.cod_categoria_pai, 0) || ''-'') end ' +
    ' || c2.cod_categoria || ' +
    ' 			  case when (coalesce(c2.cod_categoria_pai, 0) = 0) then ''-'' ' +
    '              else ''.'' end ' +
    ' || c.cod_categoria) ordem, c.cod_categoria, c.descricao, ' +
    '         (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then (''    >  '' ||c.cod_categoria) ' +
    '               else (''         >  ''||c.cod_categoria) end ' +
    ' ||'' - '' || trim(coalesce(c.descricao, ''''))) descricao2, c.cod_empresa ' +
    '  from categoria c ' +
    ' inner join categoria c2 on c.cod_categoria_pai = c2.cod_categoria and c.cod_empresa = c2.cod_empresa ' +
    ' where coalesce(c.cod_categoria_pai, 0) > 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by 1 asc ', pBuscas).FetchAll;

   Result := not pBuscas.IsEmpty;
end;

function TCategorias.addItemTreeView(Produto: TProdutos; pTreeView: TTreeView; pTreeView2: TTreeView; pCategoria: string): boolean;
var
  I: Integer;
  vcodcategoria: Integer;
  ANode: TtreeNode;
begin
  try
    Result := true;
    vcodcategoria := 0;

    if pTreeView.Items.Count <= 0 then
      exit;

    for I := 0 to pTreeView2.Items.Count - 1 do
      if trim(pTreeView2.Items[I].Text) = trim(pCategoria) then
      begin
        Application.MessageBox(PChar('Categoria "' + trim(pCategoria) + '" já adicionada!'), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

    try
      vcodcategoria := StrToInt(trim(Copy(pCategoria, 1, Pos('-', pCategoria) - 1)));
    except
      Application.MessageBox(PChar('Falha ao selecionar categoria: ' + trim(pCategoria)), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      Exit;
    end;

    SqlOpen(' select categoria.cod_categoria from categoria ' +
      ' where categoria.cod_categoria = ' + IntToStr(vcodcategoria) +
      ' and categoria.cod_empresa = ' + vDadosIni.codEmpresa);
    vcodcategoria := buscas.FieldByName('cod_categoria').AsInteger;

    if vcodcategoria <= 0 then
      exit;

    try
      dataSet.Filtered := false;
      dataSet.Filter := 'grupo_prod = ' + IntToStr(Produto.dataSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(Produto.dataSet.FieldByName('cod_prod').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_categoria = ' + IntToStr(vcodcategoria);
      dataSet.Filtered := true;

      if dataSet.IsEmpty then
      begin
        dataSet.Insert;
        dataSet.FieldByName('GRUPO_PROD').AsInteger := Produto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
        dataSet.FieldByName('COD_PROD').AsString := Produto.dataSet.FieldByName('COD_PROD').AsString;
        dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        dataSet.FieldByName('COD_CATEGORIA').AsInteger := vcodcategoria;
        dataSet.Post;
        Apply;

        ANode := pTreeView2.Items.AddChild(nil, trim(pCategoria));
      end;
    finally
      dataSet.Filtered := false;
    end;

    for I := 0 to pTreeView.Items.Count - 1 do
      pTreeView.Items[I].Selected := True;

    for I := 0 to pTreeView.Items.Count - 1 do
      if trim(pTreeView.Items[I].Text) = trim(pCategoria) then
      begin
        pTreeView.Items[I].Selected := True;
        break;
      end;
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar(e.Message), 'Erro', MB_OK + MB_ICONASTERISK);
      registraErro(e.Message);
    end;
  end;
end;

