function TKitsProdutos.limiteProdutoEcommerce: boolean;
var
	vLimiteProd: Integer;
begin
	Result := true;
	if vDadosIni.vEcommerce.vLimiteProdutos <= 0 then
  	exit;

  buscas.Close;
  buscas.SQL.Text := ' select count(*) from produtos_ec ' +
  	' where cod_empresa = ' + vDadosIni.codEmpresa +
    ' and sinc_ecommerce = ''S'' ' +
		' union ' +
    ' select count(*) from kits_prod_ec ' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa +
    ' and sinc_ecommerce = ''S'' ';
  buscas.Open;

  vLimiteProd := 0;
  buscas.First;
  while not buscas.Eof do
  begin
	  vLimiteProd := buscas.FieldByName('count').AsInteger;

    buscas.Next;
  end;

  if (vLimiteProd > 0) and (vLimiteProd > vDadosIni.vEcommerce.vLimiteProdutos) then
  begin
  	Application.MessageBox(PChar('Limite de produtos atingido E-Commerce:' + #13 + #13 +
    	'Quantidade de produtos utilizada.....: ' + IntToStr(vLimiteProd) + #13 +
      'Limite produtos no plano E-Commerce: ' + IntToStr(vDadosIni.vEcommerce.vLimiteProdutos) + #13 + #13 +
      'Favor verificar antes de continuar!'), 'Atenção', MB_ICONWARNING + MB_OK);
  	Result := false;
    exit;
  end;
end;

function TKitsProdutos.post: boolean;
var
  acao: string;
  I: Integer;
  vListTmp: TStrings;
  vListTmpUrl: TStrings;

  function testarImagem: boolean;
  var
    I: Integer;
  begin
    Result := true;
    
  	for I := 0 to vListTmp.Count - 1 do
    begin
      if (UpperCase(ExtractFileExt(vListTmp[i])) <> '.JPG')
        and (UpperCase(ExtractFileExt(vListTmp[i])) <> '.JPEG')
        {and (UpperCase(ExtractFileExt(vListTmp[i])) <> '.PNG')} then
      begin
        Application.MessageBox(PChar('Imagem informada não esta no formato aceito pelo E-Commerce ' +
        '(' + IntToStr(I + 1) + '/' + IntToStr(vListTmp.Count) + '):' + #13 +
        'Formatos suportados: JPG e JPEG '+ #13 +
        'Imagem: ' + ExtractFileName(vListTmp[I])), 'Atenção', MB_ICONERROR + MB_DEFBUTTON1);
        Result := false;
        exit;
      end;
    end;
  end;
begin
  try
    Result := false;
    vListTmp := TStringList.Create;
    vListTmpUrl := TStringList.Create;

    campoComErro := '';
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';
    
    if dataSet.FieldByName('CODIGO_KIT').AsInteger <= 0 then
    begin
    	FrmCadKits.TabSheet3.Show;
      raiseExceptionCreate('Código do Kit não informado.', 'DBEdit1');
    end;

    if (dataSet.State = dsInsert) or ((dataSet.State = dsEdit)
    	and dataSet.FieldByName('CODIGO_KIT').OldValue <> dataSet.FieldByName('CODIGO_KIT').NewValue) then
    begin
      if ExecutaComandosSql('select * from kits_prod k ' +
      	' where k.ativo = 1 ' +
        ' and k.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and codigo_kit=' + inttostr(dataSet.FieldByName('CODIGO_KIT').AsInteger)) then
      begin
      	FrmCadKits.TabSheet3.Show;
        raiseExceptionCreate('Código de Kit já cadastrado.', 'DBEdit1');
      end;
    end;

    if trim(dataSet.FieldByName('DESCRICAO_KIT').AsString) = '' then
    begin
    	FrmCadKits.TabSheet3.Show;
      raiseExceptionCreate('Descrição do Kit não informada.', 'DBEdit2');
    end;

   if acao = 'INSERIR' then
      dataSet.FieldByName('CODIGO_KIT').AsInteger := Gencodigo('KITS_PROD', DtmProdutos.SpIncCodKits, vDadosIni.codEmpresa);

    Result := inherited post;

    if not result then
    begin
      Application.MessageBox('Erro ao gravar registro.', 'Aviso', MB_OK + MB_ICONQUESTION +
        MB_DEFBUTTON1);
      exit;
    end;
    if dataSet.ChangeCount = 0 then
    begin
      if vCategorias.dataSet.ChangeCount > 0 then
      	vCategorias.Apply;

      if vItKit.dataSet.ChangeCount > 0 then
      	vItKit.Apply;

      if vKitEC.dataSet.ChangeCount > 0 then
      	vKitEC.Apply;

      CommitaTransacao;
      Refresh;
      Result := true;
      Exit;
    end;

    if Result then
	    Result := Apply;
    if Result then
    	Result := CommitaTransacao;

    if Result then
    	vDadosIni.GravaAuditoria('PRO117', acao, 'SUCESSO', 'KITS_PROD',
      	dataSet.FieldByName('CODIGO_KIT').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('PRO117', acao, 'FALHA', 'KITS_PROD',
        dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

