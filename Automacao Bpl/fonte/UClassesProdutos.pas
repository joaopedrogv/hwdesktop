function TNBM.edit: Boolean;
begin
  Result := False;
  if inherited edit then
  begin
    existeInformacaoComplementar(dataSet.FieldByName('cod_inf').AsInteger);
    if (dataSet.FieldByName('MVA').AsFloat > 0) or (dataSet.FieldByName('MVA_INTER').AsFloat > 0) then
      dataSet.FieldByName('MODBCST').AsInteger := 4;
    Result := true;
  end;
end;

function TNBM.existeInformacaoComplementar(pCodigo: Integer): Boolean;
begin
  Result := False;
  vTextoInfComplementar.Text := '';
  if pCodigo = 0 then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select * from SPED_INFORMACAO_COMPLEMENTAR' +
    ' where cod_inf = ' + IntToStr(pCodigo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1';
  buscas.Open;

  if buscas.IsEmpty then
  begin
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_inf').Value := Null;
  end
  else
  begin
    vTextoInfComplementar.Add(buscas.FieldByName('TXT').AsString);
    vTextoInfComplementar.Add(buscas.FieldByName('TXT_COMPL').AsString);
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_inf').AsInteger := pCodigo;
    Result := True;
  end;
end;

