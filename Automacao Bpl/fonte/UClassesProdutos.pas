end;

procedure TRepliProdutos.defineSQL(DataSetProd: TProdutos);
var
  I: Integer;
  vcamps: string;
  vTemp: string;
begin
  fSQLInsert := '';
  fSQLUpdate := '';
  fSQLCampos := '';

  buscas.close;
  buscas.sql.Text := 'select * from TAB_REP where TABELA = ''PRODUTOS''';
  buscas.Open;
  vcamps := Trim(Buscas.fieldbyname('EXCTO_CAMPO').asstring);

  buscas.close;
  buscas.sql.Text := 'select * from TAB_ALT ' +
  	' where TABELA = ''PRODUTOS'' ' +
    ' and CAMPO_ALT not in (''GRUPO_PROD'', ''COD_PROD'', ''COD_EMPRESA'') ';
  buscas.Open;

  fList.Clear;
  fList.Duplicates := dupIgnore;
  fList.Add('GRUPO_PROD');
  fList.Add('COD_PROD');
  fList.Add('COD_EMPRESA');
  buscas.First;
  while not buscas.Eof do
  begin
    if DataSetProd.dataSet.FindField(UpperCase(Trim(buscas.FieldByName('CAMPO_ALT').AsString))) <> nil then
      if (pos(UpperCase(Trim(buscas.FieldByName('CAMPO_ALT').AsString)), vcamps) = 0) then
        fList.Add(UpperCase(Trim(buscas.FieldByName('CAMPO_ALT').AsString)));
    buscas.Next;
  end;

  for I := 0 to fList.Count - 1 do
  begin
    fSQLInsert := fSQLInsert + ', ' + fList[I];
    fSQLUpdate := fSQLUpdate + ', ' + fList[I] + ' = :' + fList[I];
  end;

  vTemp := StringReplace(fSQLInsert, ', ', ', :', [rfReplaceAll, rfIgnoreCase]);
  System.Delete(fSQLInsert, 1, 1);
  System.Delete(vTemp, 1, 1);

  fSQLCampos := fSQLInsert;
  fSQLInsert := 'insert into PRODUTOS (' + fSQLInsert + ') values (' + vTemp + ')';
//  fSQLUpdate := StringReplace(fSQLUpdate, ', COD_EMPRESA = :COD_EMPRESA', '', [rfReplaceAll, rfIgnoreCase]);
  System.Delete(fSQLUpdate, 1, 1);
  fSQLUpdate := 'update PRODUTOS set ' + fSQLUpdate +
    ' where GRUPO_PROD = :GRUPO_PROD_W and COD_PROD = :COD_PROD_W and COD_EMPRESA = :COD_EMPRESA_W';
end;

destructor TRepliProdutos.destroy;
begin
  close;
  inherited;
end;

function TRepliProdutos.ReplicaProdutos(DataSetProd: TProdutos;
  status: string): boolean;
var
  i, j, k: integer;
  vcamps: string;
begin
  Result := ReplicaProdutos2(DataSetProd, status);
  exit;

  teveReplicacao := false;
  result := true;

  if dataSet.Tag = 0 then
  begin
    dataSet.FieldDefs.Clear;

    for I := 0 to DataSetProd.dataSet.Fields.Count - 1 do
    begin
      if DataSetProd.dataSet.FindField(DataSetProd.dataSet.FieldDefs[i].Name) <> nil then
        if DataSetProd.dataSet.FieldByName(DataSetProd.dataSet.FieldDefs[i].Name).FieldKind = fkData
          then
          dataSet.FieldDefs.Add(
            DataSetProd.dataSet.FieldDefs[i].Name,
            DataSetProd.dataSet.FieldDefs[i].DataType,
            DataSetProd.dataSet.FieldDefs[i].Size, false);
    end;
    dataSet.Tag := 1;
  end;

  buscas.close;
  buscas.sql.Text := 'select * from TAB_REP where TABELA = ''PRODUTOS''';
  buscas.Open;
  //  if not Buscas.isempty then
  //  begin
  vcamps := Buscas.fieldbyname('EXCTO_CAMPO').asstring;
  incluirNaEdicao := Buscas.fieldbyname('INCLUIRNAALTERACAO').asstring;

  vDadosIni.verificarReplicacaoInterna(buscas);

  //  if buscas.FieldByName('QTDEMP').asinteger <> 0 then
  if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
  begin
    //    buscas.close;
    //    buscas.sql.Text := 'select cod_empresa from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
    //      vDadosIni.codEmpresa;
    //    buscas.Open;
    //    for I := 0 to Length(RepliEmp) - 1 do
    //    begin
    //      RepliEmp[i] := buscas.FieldByName('cod_empresa').AsString;
    //    end;
    if status = 'I' then
    begin
      for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
      begin
        //        if abreRepliProdutos(DataSetProd.dataSet.FieldByName('GRUPO_PROD').asstring,
        //          TRIM(DataSetProd.dataSet.FieldByName('COD_PROD').asstring), RepliEmp[i]) then
//        if abreRepliProdutos(DataSetProd.dataSet.FieldByName('GRUPO_PROD').OldValue,
//          TRIM(DataSetProd.dataSet.FieldByName('COD_PROD').OldValue), RepliEmp[i]) then
        if abreRepliProdutos(DataSetProd.oldGrupoProd, TRIM(DataSetProd.oldCodProd), RepliEmp[i])
          then
        begin
          if dataSet.IsEmpty then
          begin
            dataSet.Insert;
            for j := 0 to DataSetProd.dataSet.FieldCount - 1 do
            begin
              if (pos(DataSetProd.dataSet.Fields[j].FieldName, vcamps) = 0) and
                (DataSetProd.dataSet.Fields[j].FieldKind = fkData) then
              begin
                if Dataset.FieldByName(DataSetProd.dataSet.Fields[j].FieldName) is TFloatField then
                  Dataset.FieldByName(DataSetProd.dataSet.Fields[j].FieldName).AsFloat :=
                    DataSetProd.dataSet.FieldByName(DataSetProd.dataSet.Fields[j].FieldName).AsFloat
                else if not
                  DataSetProd.dataSet.FieldByName(DataSetProd.dataSet.Fields[j].FieldName).IsNull
                  then
                  Dataset.FieldByName(DataSetProd.dataSet.Fields[j].FieldName).value :=
                    DataSetProd.dataSet.FieldByName(DataSetProd.dataSet.Fields[j].FieldName).value;
              end;
            end;
            dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
            dataSet.FieldByName('ATIVO').asinteger := 1;
            if not post then
            begin
              Cancel;
              result := false;
              exit;
            end;
            if dataSet.ChangeCount > 0 then
            begin
              result := apply;
              teveReplicacao := true;
            end
            else
              result := true;
          end
          else
            result := false;
        end
        else
          result := false;
      end;
    end
    else if status = 'E' then
    begin
      buscas.close;
      buscas.sql.Text := 'select * from TAB_ALT where TABELA = ''PRODUTOS''';
      buscas.Open;
      for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
      begin
        //        if abreRepliProdutos(DataSetProd.dataSet.FieldByName('GRUPO_PROD').asstring,
        //          TRIM(DataSetProd.dataSet.FieldByName('COD_PROD').asstring), RepliEmp[i]) then
//        if abreRepliProdutos(DataSetProd.oldGrupoProd,
//          TRIM(DataSetProd.oldCodProd), RepliEmp[i]) then
//        if abreRepliProdutos(DataSetProd.dataSet.FieldByName('GRUPO_PROD').OldValue,
//          TRIM(DataSetProd.dataSet.FieldByName('COD_PROD').OldValue), RepliEmp[i]) then
        if abreRepliProdutos(DataSetProd.oldGrupoProd, TRIM(DataSetProd.oldCodProd), vDadosIni.vReplicaoInternaEmpresa[i]) then
        begin
          if not dataSet.IsEmpty then
          begin
            dataset.Edit;
            buscas.First;
            while not buscas.eof do
            begin
              for k := 0 to dataSet.FieldCount - 1 do
                if dataSet.Fields[k].FieldName = trim(buscas.fieldbyname('CAMPO_ALT').asstring) then
                begin
                  for j := 0 to DataSetProd.dataSet.FieldCount - 1 do
                  begin
                    if DataSetProd.dataSet.Fields[j].FieldName =
                      trim(buscas.fieldbyname('CAMPO_ALT').asstring) then
                    begin
                      dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                        DataSetProd.dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
                      break;
                    end;
                  end;
                  break;
                end;
              buscas.next;
            end;
            //campos chave com obrigatoriedade de replicação
            dataSet.FieldByName('GRUPO_PROD').asinteger :=
              DataSetProd.dataSet.FieldByName('GRUPO_PROD').asinteger;
            dataSet.FieldByName('COD_PROD').asstring :=
              DataSetProd.dataSet.FieldByName('COD_PROD').asstring;
            dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(vDadosIni.vReplicaoInternaEmpresa[i]);
            if not Post then
            begin
              Cancel;
              result := false;
              exit;
            end;
          end
          else
          begin
            if incluirNaEdicao = 'S' then
            begin
              dataSet.insert;
              buscas.First;
              while not buscas.eof do
              begin
                for k := 0 to dataSet.FieldCount - 1 do
                  if dataSet.Fields[k].FieldName = trim(buscas.fieldbyname('CAMPO_ALT').asstring)
                    then
                  begin
                    for j := 0 to DataSetProd.dataSet.FieldCount - 1 do
                    begin
                      if DataSetProd.dataSet.Fields[j].FieldName =
                        trim(buscas.fieldbyname('CAMPO_ALT').asstring) then
                      begin
                        dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                          DataSetProd.dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
                        break;
                      end;
                    end;
                    break;
                  end;
                buscas.next;
              end;
              dataSet.FieldByName('GRUPO_PROD').asinteger :=
                DataSetProd.dataSet.FieldByName('GRUPO_PROD').asinteger;
              dataSet.FieldByName('COD_PROD').asstring :=
                DataSetProd.dataSet.FieldByName('COD_PROD').asstring;
              dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(vDadosIni.vReplicaoInternaEmpresa[i]);
              if not Post then
              begin
                Cancel;
                result := false;
                exit;
              end;
            end
            else
            begin
              result := false;
              exit;
            end;
          end;
          if dataSet.ChangeCount > 0 then
          begin
            result := apply;
            teveReplicacao := true;
          end
          else
            result := true;
        end;
      end;
    end;
  end;
end;

function TRepliProdutos.ReplicaProdutos2(DataSetProd: TProdutos;
  status: string): boolean;
var
  vcamps, incluirNaEdicao, tpSQL: string;
  I: Integer;
  J: Integer;
begin
  teveReplicacao := false;
  result := true;
  try

    buscas.close;
    buscas.sql.Text := 'select * from TAB_REP where TABELA = ''PRODUTOS''';
    buscas.Open;
    if buscas.IsEmpty then
      Exit;

    incluirNaEdicao := Buscas.fieldbyname('INCLUIRNAALTERACAO').asstring;

    defineSQL(DataSetProd);

    if fList.Count = 3 then
    begin
      Application.MessageBox('Sem campos definidos para replicação interna na tabela "TAB_ALT"',
        'Atenção', 0 + 64);
      Exit;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas);
    for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
    begin
      buscas.Close;
      buscas.SQL.Text := 'select grupo_prod, cod_prod, cod_empresa from produtos' +
        ' where grupo_prod = ' + DataSetProd.oldGrupoProd +
        ' and cod_prod = ' + QuotedStr(Trim(DataSetProd.oldCodProd)) +
        ' and cod_empresa = ' + vDadosIni.vReplicaoInternaEmpresa[i];
      buscas.Open;
      if buscas.IsEmpty then
        tpSQL := 'I'
      else
        tpSQL := 'U';
      if status = 'E' then // status do dataset do produto
        if incluirNaEdicao <> 'S' then
          if tpSQL = 'I' then
            Continue;

      buscas.Close;
      if tpSQL = 'I' then
        buscas.SQL.Text := fSQLInsert
      else
        buscas.SQL.Text := fSQLUpdate;
      for J := 0 to fList.Count - 1 do
        buscas.ParamByName(fList[J]).Value := DataSetProd.dataSet.FieldByName(fList[J]).Value;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
      if tpSQL = 'U' then
      begin
        buscas.ParamByName('grupo_prod_w').AsInteger  := StrToInt(DataSetProd.oldGrupoProd);
        buscas.ParamByName('cod_prod_w').AsString     := DataSetProd.oldCodProd;
        buscas.ParamByName('cod_empresa_w').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
      end;
      buscas.ExecSQL;
      teveReplicacao := True;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('TRepliProdutos.ReplicaProdutos2. Erro: ' + e.Message + ' SQL.Text ' + buscas.SQL.Text);
      Application.MessageBox(PChar('Erro ao replicar produtos. Erro: ' + e.Message) , 'Atenção', 0 + 64);
    end;
  end;
end;

