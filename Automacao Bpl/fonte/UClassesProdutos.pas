function TRepliCodBarras.ReplicaCodBarras(DataSetProduto: TProdutos;
  status: string): boolean;
var
  i, j: integer;
  vcamps: string;
  deletaCodBarra: boolean;
  buscas2: TIBQuery;
begin
  result := true;
  //  if DataSetCodBarras.AlterarGrupo = false then //Caso o grupo já tenha sido alterado através do próprio banco o a tabela codbarra já é alterada.
  //  begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  vDadosIni.verificarReplicacaoInterna(buscas);
  
  buscas.close;
  buscas.sql.Text := 'select * from COD_BARRA ' +
    ' where grupo_prod = ' + trim(DataSetProduto.dataSet.FieldByName('GRUPO_PROD').NewValue) +
    ' and cod_prod = ' + quotedstr(trim(DataSetProduto.dataSet.FieldByName('COD_PROD').NewValue)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ';
  buscas.Open;

  if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
  begin
    for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
    begin
      if abreRepliCodBarras(trim(DataSetProduto.dataSet.FieldByName('GRUPO_PROD').NewValue),
        TRIM(DataSetProduto.dataSet.FieldByName('COD_PROD').NewValue), vDadosIni.vReplicaoInternaEmpresa[i]) then
      begin
        buscas.First;
        while not buscas.eof do
        begin
          IndexFieldNames := 'COD_BARRA;GRUPO_PROD;COD_PROD;COD_EMPRESA';
          FindNearest([buscas.FieldByName('COD_BARRA').AsString,
            buscas.FieldByName('GRUPO_PROD').AsInteger, buscas.FieldByName('COD_PROD').AsString,
              strtoint(vDadosIni.vReplicaoInternaEmpresa[i])]);
          if (dataSet.FieldByName('COD_BARRA').AsString = buscas.FieldByName('COD_BARRA').AsString)
            and
            (dataSet.FieldByName('GRUPO_PROD').AsInteger =
            buscas.FieldByName('GRUPO_PROD').AsInteger) and
            (dataSet.FieldByName('COD_PROD').AsString = buscas.FieldByName('COD_PROD').AsString) and
            (dataSet.FieldByName('COD_EMPRESA').AsInteger = strtoint(vDadosIni.vReplicaoInternaEmpresa[i])) then
          begin
            dataSet.Edit;
          end
          else
            dataSet.insert;

          {for j := 0 to buscas.FieldCount - 1 do
          begin
            if dataSet.FindField(buscas.Fields[j].FieldName)
            if dataSet.FindField(buscas.Fields[j].FieldName).FieldName = buscas.Fields[j].FieldName then
              if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
                if Dataset.Fields[j].FieldName = buscas.Fields[j].FieldName then
                  Dataset.Fields[j].value := buscas.Fields[j].value;
          end;}

          for j := 0 to dataSet.FieldCount - 1 do
          begin
            if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
              Dataset.Fields[j].value := buscas.FindField(Dataset.Fields[j].FieldName).Value;
          end;

          dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(vDadosIni.vReplicaoInternaEmpresa[i]);

          buscas2.Close;
          buscas2.SQL.Text := 'SELECT COUNT(*) contador FROM COD_BARRA ' +
           ' WHERE COD_BARRA = :COD_BARRA ' +
           ' AND GRUPO_PROD = :GRUPO_PROD ' +
           ' AND COD_PROD = :COD_PROD ' +
           ' AND COD_EMPRESA = :COD_EMPRESA ';
          buscas2.ParamByName('COD_BARRA').AsString := dataSet.FieldByName('COD_BARRA').AsString;
          buscas2.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas2.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
          buscas2.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
          buscas2.Open;

//          if not buscas2.IsEmpty then
          if buscas2.FieldByName('contador').AsInteger > 0 then
          begin
            Cancel;
            result := true;
          end
          else
          if not Post then
          begin
            Cancel;
            result := false;
            exit;
          end;
          buscas.next;
        end;

        dataset.first; //deleta os códigos de barra que foram deletados na empresa replicadora.
        while not dataset.Eof do
        begin
          DataSetProduto.buscas.Close;
          DataSetProduto.buscas.SQL.Text := 'select * from COD_BARRA ' +
            ' where cod_barra = ' + quotedstr(trim(dataset.FieldByName('COD_BARRA').AsString) +
            ' and grupo_prod = ' + IntToStr(dataset.FieldByName('GRUPO_PROD').AsInteger) +
            ' and cod_prod = ' + quotedstr(trim(dataset.FieldByName('COD_PROD').AsString)) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ativo = 1 ');
          DataSetProduto.buscas.Open;
          if DataSetProduto.buscas.IsEmpty then
          begin
            dataset.delete;
            dataset.First;
          end
          else
            dataset.next;
        end;

        if dataSet.ChangeCount > 0 then
        begin
          if apply then
            result := true
          else
          begin
            result := false;
            exit;
          end;
        end
        else
          result := true;
      end;
    end;
  end;
  //  end;
end;

function TRepliCodBarras.ReplicaCodBarras2(DataSetProduto: TProdutos;
  status: string): boolean;
var
  vcamps, incluirNaEdicao, tpSQL: string;
  I: Integer;
  J: Integer;
  buscas2: TIBQuery;
begin
	buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  teveReplicacao := false;
  result := true;
  try

    buscas.close;
    buscas.sql.Text := 'select * from TAB_REP where TABELA = ''PRODUTOS''';
    buscas.Open;
    if buscas.IsEmpty then
      Exit;

    incluirNaEdicao := Buscas.fieldbyname('INCLUIRNAALTERACAO').asstring;

    defineSQL(DataSetProduto);

    if fList.Count = 4 then
    begin
      Application.MessageBox('Sem campos definidos para replicação interna na tabela "TAB_ALT"',
        'Atenção', 0 + 64);
      Exit;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas);
    for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
    begin
      buscas.Close;
      buscas.SQL.Text := 'select ' + fSQLCampos + ' from cod_barra' +
        ' where grupo_prod = ' + DataSetProduto.oldGrupoProd +
        ' and cod_prod = ' + QuotedStr(Trim(DataSetProduto.oldCodProd)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
      	buscas2.Close;
        buscas2.SQL.Text := 'select ' + fSQLCampos + ' from cod_barra' +
          ' where cod_barra = ' + QuotedStr(Trim(buscas.FieldByName('cod_barra').AsString)) +
          ' and grupo_prod = ' + IntToStr(buscas.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(Trim(buscas.FieldByName('cod_prod').AsString)) +
          ' and cod_empresa = ' + vDadosIni.vReplicaoInternaEmpresa[i];
        buscas2.Open;

        if buscas2.IsEmpty then
          tpSQL := 'I'
        else
          tpSQL := 'U';
        if status = 'E' then // status do dataset do produto
          if incluirNaEdicao <> 'S' then
            if tpSQL = 'I' then
              Continue;

        buscas2.Close;
        if tpSQL = 'I' then
          buscas2.SQL.Text := fSQLInsert
        else
          buscas2.SQL.Text := fSQLUpdate;
        for J := 0 to buscas.Fields.Count - 1 do
          buscas2.ParamByName(buscas.Fields[J].FieldName).Value := buscas.Fields[J].Value;
        buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
        if tpSQL = 'U' then
        begin
        	buscas2.ParamByName('cod_barra_w').AsString    := buscas.FieldByName('cod_barra').AsString;
          buscas2.ParamByName('grupo_prod_w').AsInteger  := buscas.FieldByName('grupo_prod').AsInteger;
          buscas2.ParamByName('cod_prod_w').AsString     := buscas.FieldByName('cod_prod').AsString;
          buscas2.ParamByName('cod_empresa_w').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
        end;
        buscas2.ExecSQL;
        teveReplicacao := True;

        buscas.Next;
      end;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('TRepliCodBarras.ReplicaCodBarras2. Erro: ' + e.Message + ' SQL.Text ' + buscas.SQL.Text);
      Application.MessageBox(PChar('Erro ao replicar codbarras. Erro: ' + e.Message) , 'Atenção', 0 + 64);
    end;
  end;
end;

