      ' f.numdoc "Numero", f.data "Data", f.status "Status", f.data_confirm "Data Confirmação", f.qtde "Qtde/Dif. Bal", ' +
      ' f.valor_unit "Valor Unit", f.valor_total "Valor Total", ' +
