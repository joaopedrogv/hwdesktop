              buscas.SQL.Text := buscas.SQL.Text + ');';

              buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
              buscas.ParamByName('COD_TPPRECO').AsInteger := tipo;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
              buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
              buscas.ParamByName('COD_SETOR').AsInteger := 0;
              buscas.ParamByName('COD_CIDADE').AsInteger := 0;
              buscas.ParamByName('VALOR_PROMOCAO').AsFloat := valor;
              buscas.ParamByName('PORCENTAGEM').AsFloat := porcentagem;
              buscas.ParamByName('MAX_DESC').AsFloat := max_desc;
              buscas.ParamByName('PROPORCAO_TABELA').AsFloat := vproporcao_tabela;
              buscas.ParamByName('MARKUP').AsFloat := IfThen(markup > 0, markup);
              if markup > 0 then
                buscas.ParamByName('VALOR_PROMOCAO').AsFloat := CalcUtils.Preco(vProduto.ffloat('prec_cusm_prod'), markup, 0 - vDadosIni.vEmp.vCasasDecimais);
              buscas.ParamByName('INF').AsString := vinf;

            	if trim(debcred) <> '' then
                if trim(debcred) = 'Z' then
                  buscas.ParamByName('USAR_DEBCRED').Value := Null
                else
                  buscas.ParamByName('USAR_DEBCRED').AsString := trim(debcred);

              if Tabela = 'AVULSO' then
                buscas.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao
              else if Tabela = 'LOCALIDADE' then
                buscas.ParamByName('COD_LOCALIDADE').AsInteger := cod_tipo
              else if Tabela = 'SETOR' then
                buscas.ParamByName('COD_SETOR').AsInteger := cod_tipo
              else if Tabela = 'CIDADE' then
                buscas.ParamByName('COD_CIDADE').AsInteger := cod_tipo;

              buscas.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('SIGLA').AsString := sigla;
              buscas.ExecSQL;

              vDadosIni.GravaAuditoria('PRO235', acao,
              	IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + '-' +
                trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
                trim(Tabela) + ': ' + IfThen(Tabela = 'AVULSO', IntToStr(cod_promocao), IntToStr(cod_tipo)) + ' - ' +
                IfThen(vporcentagemtemp <> 0, 'PERC: ' + FormatFloat('0.000', vporcentagemtemp), 'VALOR: '  + FormatFloat('0.000', vvalortemp)),
                'PROMOCAO_PRODUTO',
              	IntToStr(cod_promocao), buscas);
            end
            else
            begin
            	if StrToInt(vDadosIni.codEmpresa) = StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]) then
              begin
                if not editar then
                begin
                  buscas2.Close;
                  buscas2.SQL.Text := ' SELECT 1 FIRST FROM PROMOCAO_PRODUTO ' +
                    ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
                    ' AND COD_TPPRECO = :COD_TPPRECO ' + vSql +
                    ' AND GRUPO_PROD  = :GRUPO_PROD ' +
                    ' AND COD_PROD = :COD_PROD ' +
                    ' AND COD_EMPRESA = :COD_EMPRESA ' +
                    ' AND SIGLA =''0''';
                  buscas2.ParamByName('COD_PROMOCAO').AsInteger := cod_promocao;
                  buscas2.ParamByName('COD_TPPRECO').AsInteger := tipo;
                  buscas2.ParamByName('GRUPO_PROD').AsInteger := vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
                  buscas2.ParamByName('COD_PROD').AsString := vProduto.dataSet.FieldByName('COD_PROD').AsString;
                  buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
                  buscas2.Open;

                  if (buscas2.FieldByName('FIRST').AsInteger > 0) then
                  begin
                    if Application.MessageBox(pchar('Produto com este tipo de preço já incluso, deseja atualizar as informações ?' + #13 +
                      'Grupo Prod: ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
                      'Cod Prod: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + #13 +
                      'Num Fabr: ' + trim(vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString)),
