procedure TCategorias.montarTreeViewDB(Produto: TProdutos;
  pTreeView: TTreeView);
var
  I: Integer;
  vcategoria: string;
  buscas2: TIBQuery;
begin
	pTreeView.Items.Clear;
	if pTreeView.Items.Count > 0 then
    while pTreeView.Items.Count > 0 do
      pTreeView.Items[0].Delete;

  if not vDadosIni.vEcommerce.vHabilitarEcommerce then
    exit;

  if not (Produto.dataSet.State = dsEdit) then
    exit;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if not dataSet.IsEmpty then
  begin
    try
      storeRecNo;
      dataSet.First;
      while not dataSet.Eof do
      begin
        SqlOpen('select cod_categoria, descricao from categoria ' +
          ' where cod_categoria = ' + IntToStr(dataSet.FieldByName('cod_categoria').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2);
        vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

        pTreeView.Items.AddChild(nil, trim(vcategoria));

        dataSet.Next;
      end;

    finally
      restoreRecNo;
    end;
  end;
end;

procedure TCategorias.montarTreeView(pTreeView: TTreeView);
var
  I: Integer;
  ANode, ANode2, ANode3: TtreeNode;
  vcategoria: string;
  buscas2: TIBQuery;
begin
	pTreeView.Items.Clear;
	if pTreeView.Items.Count > 0 then
    while pTreeView.Items.Count > 0 do
      pTreeView.Items[0].Delete;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  abreConsCategorias(buscas2);

  buscas2.First;
  while not buscas2.Eof do
  begin
    if (Pos('-', buscas2.FieldByName('ordem').AsString) <= 0)
    	and (Pos('.', buscas2.FieldByName('ordem').AsString) <= 0) then
    begin
      vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode := pTreeView.Items.AddChild(nil, trim(vcategoria));
    end
    else if (Pos('.', buscas2.FieldByName('ordem').AsString) > 0) then
    begin
    	vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode3 := pTreeView.Items.AddChild(ANode2, trim(vcategoria));
    end
    else if (Pos('-', buscas2.FieldByName('ordem').AsString) > 0) then
    begin
    	vcategoria := IntToStr(buscas2.FieldByName('cod_categoria').AsInteger) + ' - ' + trim(buscas2.FieldByName('descricao').AsString);

      ANode2 := pTreeView.Items.AddChild(ANode, trim(vcategoria));
    end;
    buscas2.Next;
  end;

  for I := 0 to pTreeView.Items.Count - 1 do
    pTreeView.Items[I].Selected := true;

  for I := 0 to pTreeView.Items.Count - 1 do
  begin
    if pTreeView.Items[I].Level = 0 then
    begin
      pTreeView.Items[I].Selected := true;
      Break;
    end;    
  end;
  
end;


{ TConsCategorias }

function TConsCategorias.abreCategorias: boolean;
begin
   Result := montaSelect(' select (c.cod_categoria) ordem, c.cod_categoria, c.descricao, ' +
   	' (c.cod_categoria || '' - '' || trim(coalesce(c.descricao, ''''))) descricao2, '+
    ' c.cod_empresa from categoria c ' +
    ' where coalesce(c.cod_categoria_pai, 0) = 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' union ' +
    ' select (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then '''' ' +
    '              else (coalesce(c2.cod_categoria_pai, 0) || ''-'') end ' +
    ' || c2.cod_categoria || ' +
    ' 			  case when (coalesce(c2.cod_categoria_pai, 0) = 0) then ''-'' ' +
    '              else ''.'' end ' +
    ' || c.cod_categoria) ordem, c.cod_categoria, c.descricao, ' +
    '         (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then (''    >  '' ||c.cod_categoria) ' +
    '               else (''         >  ''||c.cod_categoria) end ' +
    ' ||'' - '' || trim(coalesce(c.descricao, ''''))) descricao2, c.cod_empresa ' +
    '  from categoria c ' +
    ' inner join categoria c2 on c.cod_categoria_pai = c2.cod_categoria and c.cod_empresa = c2.cod_empresa ' +
    ' where coalesce(c.cod_categoria_pai, 0) > 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by 1 asc ');
end;

