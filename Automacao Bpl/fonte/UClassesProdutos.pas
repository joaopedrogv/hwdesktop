function TPromocaoProduto.DeleteProdutosPromocao: boolean;
var
	vTipo: string;
	I: Integer;
  vCodFormula: string;
  vTemp: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('COD_PROMOCAO').AsString;

  if not vDadosIni.PesqPros('PRO258', 'EXCLUIR', '', 'PROMOCAO_PRODUTO',
    dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, false) then
    Exit;

  if dataSet.FieldByName('COD_TPPRECO').AsInteger = 1 then
    vTemp := 'promoção'
  else
    vTemp := 'tabela';

  if Application.MessageBox(PChar('Tem certeza que deseja excluir todos produtos desta ' + vTemp + '?'),
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
    Exit;

  try
  	vDadosIni.verificarReplicacaoInterna(buscas, true);
  	for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
    begin
      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM PROMOCAO_PRODUTO ' +
        ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
        ' AND COD_TPPRECO = :COD_TPPRECO ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ';
    	buscas.ParamByName('COD_PROMOCAO').AsInteger := dataSet.FieldByName('COD_PROMOCAO').AsInteger;
      buscas.ParamByName('COD_TPPRECO').AsInteger := dataSet.FieldByName('COD_TPPRECO').AsInteger;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);
      buscas.ExecSQL;
    end;

    vTipo := 'AVULSO: TODAS';
	  if vDadosIni.vtpPreco = 'P' then
  	  vTipo := 'PROMOCAO: TODAS';

    vDadosIni.GravaAuditoria('PRO258', 'EXCLUIR',
      vTipo,
      'PROMOCAO_PRODUTO',
      vCodFormula, buscas);
    
    if buscas.Transaction.InTransaction then
	    buscas.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO258', 'EXCLUIR', 'SUCESSO', 'PROMOCAO_PRODUTO', vCodFormula, buscas);

    Result := True;

  except on E: Exception do
    begin
      buscas.Transaction.Rollback;
      vDadosIni.GravaAuditoria('PRO258', 'EXCLUIR', 'FALHA', 'PROMOCAO_PRODUTO', vCodFormula,
        buscas);
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocaoProduto.DeletePromocaoProduto(pPergura: Boolean = True): boolean;
