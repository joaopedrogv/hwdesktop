function TProdutosFretePorPeso.Insert: Boolean;
begin
  if not Auditor.Processo('PRO434').Inserir
    .Permitido then
    Exit;

  if fint('cod_cliente') > 0 then
    idUltimoCliente := fint('cod_cliente');

  Result := False;
  if inherited Insert then
  begin
    Result := True;

    dataSet.FieldByName('ID').AsInteger := 0 - seq;
    dataSet.FieldByName('GRUPO_PROD').AsInteger := Owner.fint('GRUPO_PROD');
    dataSet.FieldByName('COD_PROD').AsString := Owner.fstr('COD_PROD');
    dataSet.FieldByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
    dataSet.FieldByName('COD_CLIENTE').AsInteger := idUltimoCliente;
  end;

  seq := seq + 1;
end;

function TProdutosFretePorPeso.Post: Boolean;
begin
  Result := False;

  if not Auditor.Processo('PRO436').Alterar.Key(GetKeys).Msg(GetMsg)
    .Permitido then
    Exit;

  try

    checkFieldEmpty('cod_cliente', 'Fornecedor precisa preenchido');
    checkFieldEmpty('unidade'    , 'Unidade precisa ser preenchida');
    checkFieldEmpty('peso'       , 'Peso inválido. Campo obrigatório, preencher com valor maior que zero');
    checkFieldEmpty('valor'      , 'Valor inválido. Campo obrigatório, preencher com valor maior que zero');

    inherited Post;

    Auditor.GravarMensagemProcesso('AGUARD. SALV. PROD.');

    Result := True;

  except
    on e: Exception do
    begin
      registraErro(e.Message);
      ShowErro(e.Message);
    end;
  end;
end;

{ TProdutosAcabado }

function TProdutosAcabado.abreProdutosAcabado(pGrupoProd: Integer;
  pCodProd: string): boolean;
begin
	Result := montaSelect(' select ac.*, pr.num_fab_prod from produtos pr ' +
  	' left join produtos_pdc_var ac on ' +
    '		ac.grupo_prod = pr.grupo_prod ' +
    '   and ac.cod_prod = pr.cod_prod ' +
    '   and ac.cod_empresa = pr.cod_empresa ' +
  	' where pr.grupo_prod = ' + IntToStr(pGrupoProd) +
    ' and pr.cod_prod = ' + QuotedStr(pCodProd) +
    ' and pr.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and (select count(*) from produtos_pdc_var ac2 ' +
    '      where ac2.grupo_prod = pr.grupo_prod ' +
    '      and ac2.cod_prod = pr.cod_prod ' +
    '      and ac2.cod_empresa = pr.cod_empresa) = 0 ');
end;

function TProdutosAcabado.abreProdutosAcabado(pIdInd: Integer): boolean;
begin
	Result := montaSelect(' select first 1 ac.*, pr.num_fab_prod from produtos_pdc_var ac ' +
  	' inner join produtos pr on ' +
    '		pr.grupo_prod = ac.grupo_prod ' +
    '   and pr.cod_prod = ac.cod_prod ' +
    '   and pr.cod_empresa = ac.cod_empresa ' +
  	' where ac.id_ind = ' + IntToStr(pIdInd) +
    ' and ac.cod_empresa = ' + vDadosIni.codEmpresa);
end;

