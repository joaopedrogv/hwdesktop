{ TProdutosPrecoQtde }

function TProdutosPrecoQtde.abreRepliPrecoQtde(grupoprod, codProd, codempresa,
  sigla: string; quant: Double): Boolean;
begin
  dataSet.Close;
  dataSet.CommandText := ' SELECT PRECO_PRODUTOS_QTDE.*, ' +
    ' PRODUTOS.PREC_TAB_PROD, PRODUTOS.PREC_CUSM_PROD FROM PRECO_PRODUTOS_QTDE ' +
  	' INNER JOIN PRODUTOS ON ' +
    '		PRODUTOS.GRUPO_PROD = PRECO_PRODUTOS_QTDE.GRUPO_PROD ' +
    '   AND PRODUTOS.COD_PROD = PRECO_PRODUTOS_QTDE.COD_PROD ' +
    '   AND PRODUTOS.COD_EMPRESA = PRECO_PRODUTOS_QTDE.COD_EMPRESA ' +
  	' WHERE PRECO_PRODUTOS_QTDE.GRUPO_PROD = :GRUPO_PROD ' +
    '	AND PRECO_PRODUTOS_QTDE.COD_PROD = :COD_PROD ' +
    ' AND PRECO_PRODUTOS_QTDE.COD_EMPRESA = :COD_EMPRESA ' +
    ' AND PRECO_PRODUTOS_QTDE.QUANT = :QUANT ' +
    ' AND PRECO_PRODUTOS_QTDE.SIGLA = :SIGLA ';
  dataSet.Params.ParamByName('grupo_prod').AsInteger := StrToInt(grupoprod);
  dataSet.Params.ParamByName('cod_prod').AsString := codprod;
  dataSet.Params.ParamByName('cod_empresa').AsInteger := StrToInt(codempresa);
  dataSet.Params.ParamByName('sigla').AsString := sigla;
  dataSet.Params.ParamByName('quant').AsFloat := quant;
  result := Open;
end;

