        DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').AsString;
      dataSet.FieldByName('GRUPO_PROD').AsInteger :=
        DatasetProd.dataSet.FieldByName('GRUPO_PROD').NewValue;//OldValue;
      dataSet.FieldByName('COD_PROD').AsString :=
        DatasetProd.dataSet.FieldByName('COD_PROD').NewValue;//OldValue;
      dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      dataSet.FieldByName('DAT_MOD_CDBAR').AsString := DateToStr(date);
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      post;
      codbarraRecente := dataSet.FieldByName('COD_BARRA').AsString;
    end
    else if (dataSet.Locate('COD_BARRA', trim(codbarraRecente), [])) then
    begin
      dataSet.Edit;
      dataSet.FieldByName('COD_BARRA').AsString :=
        DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').AsString;
      dataSet.FieldByName('GRUPO_PROD').AsInteger :=
        DatasetProd.dataSet.FieldByName('GRUPO_PROD').NewValue;//OldValue;
      dataSet.FieldByName('COD_PROD').AsString :=
        DatasetProd.dataSet.FieldByName('COD_PROD').NewValue;//OldValue;
      dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      dataSet.FieldByName('DAT_MOD_CDBAR').AsString := DateToStr(date);
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      post;
      codbarraRecente := dataSet.FieldByName('COD_BARRA').AsString;
    end
    else
    begin
      dataSet.Insert;
      dataSet.FieldByName('COD_BARRA').AsString :=
        DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').AsString;
      dataSet.FieldByName('GRUPO_PROD').AsInteger :=
      // Ocorria erro no replicador, e ao cadastrar produto com mesmo número de fabricação
        DatasetProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;//DatasetProd.dataSet.FieldByName('GRUPO_PROD').OldValue;
      dataSet.FieldByName('COD_PROD').AsString :=
        DatasetProd.dataSet.FieldByName('COD_PROD').AsString;//DatasetProd.dataSet.FieldByName('COD_PROD').OldValue;
      dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      dataSet.FieldByName('DAT_CAD_CDBAR').AsString := DateToStr(date);
      dataSet.FieldByName('DAT_MOD_CDBAR').AsString := DateToStr(date);
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      post;
      codbarraRecente := dataSet.FieldByName('COD_BARRA').AsString;
    end;
  except
    result := false;
  end;
end;

