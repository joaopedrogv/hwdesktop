procedure TTipoServ.verificarTipoServEmpresas;
var
	vListaTpServ: TStringList;
  I: Integer;
begin
	try
  	vListaTpServ := TStringList.Create;
    vListaTpServ.Clear;

    try
      buscas.Close;
      buscas.SQL.Text := ' select cod_servico, cod_empresa from tipo_servico ' +
        ' where cod_empresa > 0 ';
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
      	vListaTpServ.Add(IntToStr(buscas.FieldByName('COD_SERVICO').AsInteger) + '|' +
        	IntToStr(buscas.FieldByName('COD_EMPRESA').AsInteger) + '|');

        buscas.Next;
      end;

      for I := 0 to vListaTpServ.Count - 1 do
      begin
        buscas.Close;
        buscas.SQL.Text := ' UPDATE OR INSERT INTO TIPO_SERVICO_EMPRESA (COD_SERVICO, COD_EMPRESA) ' +
          ' VALUES (:COD_SERVICO, :COD_EMPRESA) ' +
          ' MATCHING (COD_SERVICO, COD_EMPRESA); ';
        buscas.ParamByName('COD_SERVICO').AsInteger := StrToInt(vDadosIni.getCampoPipe(vListaTpServ[I], 1));
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.getCampoPipe(vListaTpServ[I], 2));
        buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := ' UPDATE TIPO_SERVICO SET COD_EMPRESA = NULL ' +
          ' WHERE COD_SERVICO = :COD_SERVICO ';
        buscas.ParamByName('COD_SERVICO').AsInteger := StrToInt(vDadosIni.getCampoPipe(vListaTpServ[I], 1));
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;
      end;

    except
      on E: Exception do
      begin
        Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
        registraErro('procedure TTipoServ.verificarTipoServEmpresas. Erro: ' + e.Message);
      end;
    end;
  finally
    if Assigned(vListaTpServ) then
    	FreeAndNil(vListaTpServ);
  end;
end;

