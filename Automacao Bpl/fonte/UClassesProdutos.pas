function TProdutosRastro.abreProdutosRastro: Boolean;
begin
	Result := montaSelect(' select ' +
    ' PRODUTOS_RASTRO.GRUPO_PROD, PRODUTOS_RASTRO.COD_PROD, PRODUTOS_RASTRO.COD_GRADE, PRODUTOS_RASTRO.COD_EMPRESA, ' +
    ' PRODUTOS_RASTRO.NLOTE, PRODUTOS_RASTRO.QLOTE, PRODUTOS_RASTRO.DFAB, PRODUTOS_RASTRO.DVAL, ' +
    ' PRODUTOS_RASTRO.COD_CLIENTE, ' +
    ' PRODUTOS_RASTRO.QTDE_COMPRA, ' +
    ' CASE WHEN (PRODUTOS_RASTRO.COD_NF > 0) THEN SP_PRODUTOS_RASTRO_NF.QTDE_COMPRA ELSE PRODUTOS_RASTRO.QTDE_COMPRA END QTDE_COMPRA2, ' +
    ' PRODUTOS_RASTRO.COD_NF, ' +
    ' CASE WHEN (COD_GRADE_PROD.COD_GRADE > 0) THEN ' +
    '        COALESCE(COD_GRADE_PROD.QTDE, 0) ' +
    '      ELSE ' +
    '        COALESCE(PRODUTOS.EST_F, 0) ' +
    ' END ESTOQUE, ' +
    ' PRODUTOS.NUM_FAB_PROD, PRODUTOS.DESCR_PROD,' +
    ' GRADE.DESCRICAO GRADE, ' +
    ' GRUPOS.DESCRICAO GRUPO, ' +
    ' SUB_GRUPO.DESCRICAO SUBGRUPO, ' +
    ' MARCA_PROD.DESCRICAO_MARCA MARCA, ' +
    ' CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO RAZAO_CLIENTE, CLIENTES.CPFCGC CPFCGC_CLIENTE, ' +
    ' NOTAFISCAL.NUM_NF, NOTAFISCAL.SERIE, NOTAFISCAL.DATA_LANC, NOTAFISCAL.VALOR_TOTAL from PRODUTOS_RASTRO ' +
    ' INNER JOIN PRODUTOS ON ' +
    '		PRODUTOS_RASTRO.GRUPO_PROD = PRODUTOS.GRUPO_PROD AND PRODUTOS_RASTRO.COD_PROD = PRODUTOS.COD_PROD AND PRODUTOS_RASTRO.COD_EMPRESA = PRODUTOS.COD_EMPRESA ' +
		' LEFT JOIN COD_GRADE_PROD ON ' +
    '		COD_GRADE_PROD.GRUPO_PROD = PRODUTOS_RASTRO.GRUPO_PROD AND COD_GRADE_PROD.COD_PROD = PRODUTOS_RASTRO.COD_PROD AND COD_GRADE_PROD.COD_GRADE = PRODUTOS_RASTRO.COD_GRADE AND COD_GRADE_PROD.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN GRADE ON ' +
    '		GRADE.COD_GRADE = PRODUTOS_RASTRO.COD_GRADE AND GRADE.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN NOTAFISCAL ON ' +
    '		NOTAFISCAL.COD_NF = PRODUTOS_RASTRO.COD_NF AND NOTAFISCAL.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN CLIENTES ON ' +
    '		CLIENTES.COD_CLIENTE = CASE WHEN (PRODUTOS_RASTRO.COD_NF > 0) THEN NOTAFISCAL.COD_CLIENTE ELSE PRODUTOS_RASTRO.COD_CLIENTE END AND CLIENTES.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN SP_PRODUTOS_RASTRO_NF ' +
    '		(PRODUTOS_RASTRO.GRUPO_PROD, PRODUTOS_RASTRO.COD_PROD, PRODUTOS_RASTRO.COD_GRADE, PRODUTOS_RASTRO.COD_EMPRESA, PRODUTOS_RASTRO.COD_NF) ON 1 = 1 ' +
		' LEFT JOIN GRUPOS ON ' +
    '		GRUPOS.CODIGO_GRUP = PRODUTOS.GRUPO_PROD ' +
    ' LEFT JOIN SUB_GRUPO ON ' +
    '		SUB_GRUPO.CODIGO_SUBGR = PRODUTOS.SUB_G_PROD ' +
    ' LEFT JOIN MARCA_PROD ON ' +
    '		MARCA_PROD.COD_MARCA = PRODUTOS.COD_MARCA ' +
    ' where PRODUTOS_RASTRO.GRUPO_PROD = 0 ' +
    ' and PRODUTOS_RASTRO.COD_PROD = ''0'' ' +
    ' and PRODUTOS_RASTRO.COD_EMPRESA = 0 ');
end;

function TProdutosRastro.buscaCliente(codCliente: Integer): boolean;
begin
  try
  	Result := true;

    buscas.Close;
    buscas.SQL.Text := 'select cod_cliente, nome_cliente, razao, cpfcgc from clientes ' +
      ' where cod_cliente = ' + IntToStr(codCliente) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ativo = 1 ';
    buscas.Open;

    dataSet.FieldByName('COD_CLIENTE').AsInteger := buscas.FieldByName('COD_CLIENTE').AsInteger;
    dataSet.FieldByName('NOME_CLIENTE_CALC').AsString := trim(buscas.FieldByName('NOME_CLIENTE').AsString);
    dataSet.FieldByName('RAZAO_CLIENTE_CALC').AsString := trim(buscas.FieldByName('RAZAO').AsString);
    dataSet.FieldByName('CPFCGC_CLIENTE_CALC').AsString := trim(buscas.FieldByName('CPFCGC').AsString);

  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

