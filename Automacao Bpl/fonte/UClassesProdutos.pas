function TProdutos.alterarEstoque(estF, estD: Double): boolean;
var
  vEstoqueContado, vEstoqueDisponivel: Extended;
  vExisteEstoqIni: Boolean;
  vDataBanco: TDateTime;
begin
  try
    result:=false;


  try

    vEstoqueContado := estF;
    vExisteEstoqIni := False;

    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod from estoque_ini' +
      ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
      ' and data_cadastro = ' + vDadosIni.FusoSqlDate + ' ' +
      ' union ' +
      ' select grupo_prod, cod_prod from hist_estoque_diario ' +
      ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
      ' and data = ' + vDadosIni.FusoSqlDate + ' and tipor = ''COR'' ' +
      ' union ' +
      ' select grupo_prod, cod_prod from hist_estoque_diario_prod ' +
      ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
      ' and data = ' + vDadosIni.FusoSqlDate + ' and tipor = ''COR''';
    buscas.Open;

    if not buscas.IsEmpty then
    begin
      vExisteEstoqIni := True;
      Application.MessageBox('Já existe um registro de alteração de estoque nesta data',
        'Atenção', 0 + 64);
      if not vDadosIni.PesqPros('PRO282', 'ALTERAR', '', 'PRODUTOS',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        dataSet.FieldByName('COD_PROD').AsString, buscas, true, True) then
      Exit;
    end;

//    vPendOS := getQuantidadePendente(
//      dataSet.FieldByName('grupo_prod').AsInteger,
//      dataSet.FieldByName('cod_prod').AsString,
//      'OS', 0);

//    vPendREQ := getQuantidadePendente(
//      dataSet.FieldByName('grupo_prod').AsInteger,
//      dataSet.FieldByName('cod_prod').AsString,
//      'REQ', 0);

    vEstoqueDisponivel := vDadosIni.getEstoqueDisponivel(buscas,
      dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString);

    vDataBanco := vDadosIni.getDataBanco(buscas);
    buscas.Close;
    buscas.SQL.Text :=
       ' insert into HIST_ESTOQUE_DIARIO_PROD ' +
       ' (TIPO, SEQID, COD_EMPRESA,  TIPOR, NATUREZA, DATA, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE) ' +
       ' VALUES ' +
       ' (:TIPO, :SEQID, :COD_EMPRESA, :TIPOR, :NATUREZA, :DATA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE);';
    buscas.ParamByName('TIPO').AsString := 'P';
    buscas.ParamByName('SEQID').AsInteger := Gencodigo('HIST_ESTOQUE_DIARIO_PROD', dtmProdutos.SpIncCodigo, vDadosIni.codEmpresa);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('TIPOR').AsString := 'COR';
    if ((vEstoqueContado - vEstoqueDisponivel) > 0) then
      buscas.ParamByName('NATUREZA').AsString := 'E'
    else
      buscas.ParamByName('NATUREZA').AsString := 'S';
    buscas.ParamByName('DATA').AsDateTime := vDataBanco;
    buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    if ((vEstoqueContado - vEstoqueDisponivel) > 0) then
      buscas.ParamByName('QTDE').AsFloat := vEstoqueContado - vEstoqueDisponivel
    else
      buscas.ParamByName('QTDE').AsFloat := (vEstoqueContado - vEstoqueDisponivel) * -1;
    buscas.ExecSQL;

    vMovimentaEstoque.Close;
    vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := dataSet.Fieldbyname('GRUPO_PROD').AsInteger;
    vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := dataSet.Fieldbyname('COD_PROD').AsString;
    vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := dataSet.Fieldbyname('COD_EMPRESA').AsInteger;
    vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := 0;
    if vEstoqueContado > vEstoqueDisponivel then
    begin
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := abs(vEstoqueContado - vEstoqueDisponivel);
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := 0;
    end
    else
    begin
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := abs(vEstoqueContado - vEstoqueDisponivel);
    end;
    vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
    vMovimentaEstoque.Prepare;
    vMovimentaEstoque.ExecProc;

    CommitaTransacao;

    Result := True;

  except
    on E: Exception do
    begin
      result := False;
      RollBackTransacao;
      Application.MessageBox(pchar('Erro ao alterar estoque. Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.alterarEstoque. Erro: ' + e.Message);
    end;
  end;
  Exit;




    FalterarEstProd_Grade := _produtoPossuiGrade(dataSet.FieldByName('GRUPO_PROD').AsInteger,
        dataSet.FieldByName('COD_PROD').AsString);
    if Edit then
    begin
      dataSet.FieldByName('est_f').AsFloat := estF;
      dataSet.FieldByName('est_r').AsFloat := estD;
      dataSet.Post;
      result := Apply;
      if result then
      begin
        if not FalterarEstProd_Grade then
        begin
          if CommitaTransacao then
          begin
            vDadosIni.GravaAuditoria('PRO092', 'TRANSACAO CONFIRMADA', 'SUCESSO', 'PRODUTOS',
              dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
              dataSet.FieldByName('COD_PROD').AsString, buscas);
            Result := true;
            vMD5Func._gravaMD5_Produtos(buscas, dataSet.FieldByName('grupo_prod').AsInteger,
              dataSet.FieldByName('cod_prod').AsString);
          end else vDadosIni.GravaAuditoria('PRO092', 'TRANSACAO CONFIRMADA', 'FALHA', 'PRODUTOS',
              dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
              dataSet.FieldByName('COD_PROD').AsString, buscas);
        end;
      end;
    end;
  except
    RollBackTransacao;
    vDadosIni.GravaAuditoria('PRO092', 'ROOLBACK TRANSACAO', 'FALHA', 'PRODUTOS',
      dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
      dataSet.FieldByName('COD_PROD').AsString, buscas);
  end;
end;

function TProdutos.alterarGrupoECodigoOutrasEmpresasReplicacaoInterna: Boolean;
var
  vRepliEmp: array of string;
  I: Integer;
begin
  Result := True;
  if not Replicar then
    Exit;
  try
    buscas.close;
    buscas.sql.Text := ' select cod_empresa from EMPRESA ' +
    	' where ativo = 1 and COD_EMPRESA <> ' + vDadosIni.codEmpresa;
    buscas.Open;
    buscas.FetchAll;
    SetLength(vRepliEmp, buscas.RecordCount);
    buscas.First;
    I := 0;
    while not buscas.Eof do
    begin
      vRepliEmp[i] := buscas.FieldByName('cod_empresa').AsString;
      Inc(I);
      buscas.Next;
    end;
    for I := 0 to Length(vRepliEmp) - 1 do
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_prod from produtos' +
        ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
        ' and cod_empresa = ' + vRepliEmp[I];
      buscas.Open;
      if buscas.IsEmpty then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update produtos set grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
          ', cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
          ' where grupo_prod = ' + IntToStr(StrToIntDef( oldGrupoProd , 0)) +
          ' and cod_prod = ' + QuotedStr(Trim(oldCodProd)) +
          ' and cod_empresa = ' + vRepliEmp[I];
        buscas.ExecSQL;
      end;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('function TProdutos.alterarGrupoECodigoOutrasEmpresasReplicacaoInterna. Erro: ' + e.Message);
      Application.MessageBox(PChar('Erro na replicação interna ao alterar grupo e código do produto. Err: ' + #13 + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TProdutos.AlterarInsumoOutroProd (
	pQuantIns: Double): boolean;
begin
	try
    Result := False;

    if dataSet.IsEmpty then
    	Exit;
      
    if vIndTec.dataSet.IsEmpty then
  		Exit;

    vIndTec.vgrupo_prod_acabado := dataSet.FieldByName('grupo_prod').AsString;
    vIndTec.vcod_prod_acabado := dataSet.FieldByName('cod_prod').AsString;
    vIndTec.vgrupo_prod_mp := vIndTec.dataSet.FieldByName('grupo_prod_mprima').AsString;
    vIndTec.vcod_prod_mp := vIndTec.dataSet.FieldByName('cod_prod_mprima').AsString;
    vIndTec.vcodprod := vIndTec.dataSet.FieldByName('num_fab_mprima').AsString;
    vIndTec.vquant_mp := pQuantIns;

    if not vDadosIni.PesqPros('ITEC003', 'CONFIRMAR',
      'ACAB ' +
      'Grupo: ' + vIndTec.vgrupo_prod_acabado + ' ' +
      'Codigo: ' + vIndTec.vcod_prod_acabado + ' ' +
      'INS ' +
      'Grupo: ' + vIndTec.vgrupo_prod_mp + ' ' +
      'Codigo: ' + vIndTec.vcodprod,
      'INDICE_TECNICO',
      vIndTec.vgrupo_prod_acabado + ' ' +
      vIndTec.vcod_prod_acabado,
      buscas, True) then
        Exit;

    if not vIndTec._AlterarItem then
    	Exit;

    Result := True;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.AlterarInsumoOutroProd. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.AlterarQtdeCustoNfProd(pNum: Integer; pTipo: string;
  pNitem: Integer; pData: TDateTime; pGrupoProd: Integer; pCodProd: string;
  pCodGrade: Integer; pQuantidade, pCustoMed: Double): boolean;
begin
  try
  	try
      Result := true;

      vDadosIni.abreStatusProcessamento('', 'Corrigindo estoque/custo da matéria prima/insumo/embalagem');

      buscas.Close;
      buscas.SQL.Text := ' select * from corrigir_est_qtde_custo_nf_pdc ( ' +
        ' :grupo_prod,' +
        ' :cod_prod,' +
        ' :cod_grade,' +
        ' :cod_empresa,' +
        ' :tipo,' +
        ' :num,' +
        ' :nitem,' +
        ' :quantidade, ' +
        ' :custo_med) ';
      buscas.ParamByName('grupo_prod').AsInteger := pGrupoProd;
      buscas.ParamByName('cod_prod').AsString := pCodProd;
      buscas.ParamByName('cod_grade').AsInteger := pCodGrade;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('tipo').AsString := pTipo;
      buscas.ParamByName('num').AsInteger := pNum;
      buscas.ParamByName('nitem').AsInteger := pNitem;
