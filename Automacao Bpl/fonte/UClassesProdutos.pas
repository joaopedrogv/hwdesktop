function TProdutos._GetDadosRelatorio(pIndiceRel: Integer): Boolean;
var
  vInd: TIndiceTec;
begin
  vInd := TIndiceTec.create;

  vInd.dtSet := TClientDataSet(dataset);
  vInd._CodProd := '';
  vInd._GrupoProd := 0;
  vInd._pIndiceRel := pIndiceRel;

  {Se pIndiceRel = 3 ele insere em um datset temporário os produtos}

  vInd.grid := Tdbgrid(FrmCadProdutos.DBGrid1);
  vInd._SomenteSelecionado := Application.MessageBox('Imprimir somente selecionados?', 'Confirmação', MB_YESNO + MB_ICONQUESTION) = ID_YES;
  if (pIndiceRel = 3) then
  begin
    {8}if vind.dtSetProdVal.Tag <> 1 then
    begin
      vind.dtSetProdVal.CreateDataSet;
      vind.dtSetProdVal.Tag := 1;
    end; {8}
    vind.dtSetProdVal.EmptyDataSet;

    vInd._QRBand_SubRel := TQRBand(FrmCadProdutos.QRBand_Indice3);
    vind.dtSetProdVal.AfterScroll := vind._RelCabecalhoAfterScroll;
    vind.dtSetProdVal.first;
  end
  else
  begin
    vind.dtSet.AfterScroll := vind._RelCabecalhoAfterScroll;
    vind.dtset.first;
  end;

  if (pIndiceRel = 1) then
  begin
    FrmCadProdutos.detailband_Indice.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.QRSubDetail_Itens.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.QRBand_Itens.BeforePrint := vInd.bandaDetalheBeforePrint;
  end
  else if (pIndiceRel = 2) then
  begin
    vInd._ValorReqOs := 0;
    vInd._Label_SumReqOs := TQRLabel(FrmCadProdutos.qrlabel_somapend);
    vind._Label_SumReqOs.Caption := '0';
    FrmCadProdutos.detailband_Indice2.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.QRSubDetail_Itens2.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.DetailBand_Indice2.AfterPrint := vInd._QRBandAfterPrint;
    FrmCadProdutos.QuickRep_IndiceEst.BeforePrint := vInd._QuickRep_IndiceEstBeforePrint;
    FrmCadProdutos.QRBand_Itens2.BeforePrint := vInd.bandaDetalheBeforePrint;
  end
  else if (pIndiceRel = 3) then
  begin
    vInd._PreencherNFProd;
    FrmCadProdutos.QRBand_Indice3.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.QRSubDetail_itens3.BeforePrint := vInd.bandaDetalheBeforePrint;
    FrmCadProdutos.QRBand_Itens3.BeforePrint := vInd.bandaDetalheBeforePrint;
  end;
end;

