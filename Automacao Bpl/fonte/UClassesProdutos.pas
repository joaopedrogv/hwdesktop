function TProdutosPrecoQtde.post(pDateSet: TDataSet): boolean;
var
  acao: string;
  vTemp: string;
  statusRegistro: string;
begin
  try
    Result := false;

    vTemp := 'Grupo ' + dataSet.FieldByName('GRUPO_PROD').AsString +
  		' Cod ' + dataSet.FieldByName('COD_PROD').AsString;

    if not vDadosIni.PesqPros('PRO305', 'SALVAR', '', 'PRECO_PRODUTOS_QTDE',
      vTemp, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
    begin
      statusRegistro := 'E';
      acao := 'EDITAR';

      if vMarkup > 0 then
        if dataSet.FieldByName('MARKUP').AsFloat <= 0 then
          dataSet.FieldByName('MARKUP').AsFloat := vMarkup;
    end
    else
    begin
      statusRegistro := 'I';
      acao := 'INSERIR';
    end;

    acao := acao + ' - ' + vDadosIni.IfThen(dataSet.State = dsInsert,
    	' Us Cad ' + IntToStr(dataSet.FieldByName('US_CAD').AsInteger),
      ' Us Alt ' + IntToStr(dataSet.FieldByName('US_MOD').AsInteger));

    if trim(dataSet.FieldByName('SIGLA').AsString) = '' then
      raiseExceptionCreate('Tipo Venda deve ser informado', 'DBLookupComboBox22');

     if dataSet.FieldByName('MAX_DESC').AsFloat < 0 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser menor que 0%!', 'DbeditDescontoMaxProdQtde');

    if dataSet.FieldByName('MAX_DESC').AsFloat >= 100 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser maior ou igual a 100%!', 'DbeditDescontoMaxProdQtde');

    if dataSet.FieldByName('QUANT').AsFloat <= 0 then
      raiseExceptionCreate('Quantidade deve ser informada', 'DBEdit54');

    if (dataSet.FieldByName('PRECO_VENDA').AsFloat <= 0)
    	and (dataSet.FieldByName('PORCENTAGEM').AsFloat = 0)
      and (dataSet.FieldByName('MARKUP').AsFloat <= 0) then
      	raiseExceptionCreate('Valor, Markup, Margem ou Desconto (%) deve ser informado!', 'DBEdit148');

    if (Abs(dataSet.FieldByName('PORCENTAGEM').AsFloat) >= 100) then
      raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior ou igual a 100%', 'DBEdit211');

	  if dataSet.State = dsInsert then
    begin
    	buscas.Close;
     	buscas.SQL.Text := ' select first 1 grupo_prod, cod_prod from preco_produtos_qtde ' +
        ' where grupo_prod = :grupo_prod ' +
        ' and cod_prod = :cod_prod ' +
        ' and cod_empresa = :cod_empresa ' +
        ' and quant = :quant and sigla = :sigla ';
      buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    	buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('QUANT').AsFloat := dataSet.FieldByName('QUANT').AsFloat;
    	buscas.ParamByName('SIGLA').AsString := dataSet.FieldByName('SIGLA').AsString;
      buscas.Open;

      if not buscas.IsEmpty then  
      begin
        Application.MessageBox(PChar('Preço para essa quantidade já cadastrado para esse produto, ' +
          'para o tipo de venda "' + dataSet.FieldByName('SIGLA').AsString + '", ' +
          'favor verificar!'), 'Erro', 0 + 64);
        Exit;
      end;

      buscas.Close;
      buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    	buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('QUANT').AsFloat := dataSet.FieldByName('QUANT').AsFloat;
    	buscas.ParamByName('SIGLA').AsString := '0';
     	buscas.Open;

      if not buscas.IsEmpty then
      begin
        Application.MessageBox(PChar('Preço para essa quantidade já cadastrado para esse produto, ' +
          'para o tipo de venda "0 - TODOS", ' +
          'favor verificar!'), 'Erro', 0 + 64);
        Exit;
      end;
    end;

    if (dataSet.FieldByName('PRECO_VENDA').AsFloat > 0) then
    begin
    	dataSet.FieldByName('PORCENTAGEM').AsFloat := 0;
      dataSet.FieldByName('MARKUP').AsFloat := 0;
    end
    else if dataSet.FieldByName('PORCENTAGEM').AsFloat <> 0 then
    begin
      dataSet.FieldByName('PRECO_VENDA').AsFloat := 0;
      dataSet.FieldByName('MARKUP').AsFloat := 0;
    end     
    else if (dataSet.FieldByName('MARKUP').AsFloat > 0) then
    begin
    	dataSet.FieldByName('PRECO_VENDA').AsFloat := 0;
    	dataSet.FieldByName('PORCENTAGEM').AsFloat := 0;
    end;

    dataSet.FieldByName('PROPORCAO_TABELA').AsFloat := 0;
    if dataSet.FieldByName('MARKUP').AsFloat > 0 then
    begin
      dataSet.FieldByName('PRECO_VENDA').AsFloat :=
      	CalcUtils.Preco(pDateSet.FieldByName('PREC_CUSM_PROD').AsFloat,
        	dataSet.FieldByName('MARKUP').AsFloat, 0 - vDadosIni.vEmp.vCasasDecimais);
    end
    else if dataSet.FieldByName('PORCENTAGEM').AsFloat <> 0 then
    begin
    	dataSet.FieldByName('PORCENTAGEM').AsFloat := - Abs(dataSet.FieldByName('PORCENTAGEM').AsFloat);
      if dataSet.FieldByName('PORCENTAGEM').AsFloat > 0 then
      	dataSet.FieldByName('PROPORCAO_TABELA').AsFloat := 1 + (Abs(dataSet.FieldByName('PORCENTAGEM').AsFloat) / 100)
      else
        dataSet.FieldByName('PROPORCAO_TABELA').AsFloat := 1 - (Abs(dataSet.FieldByName('PORCENTAGEM').AsFloat) / 100);
      dataSet.FieldByName('PORCENTAGEM').AsFloat := 0;

      dataSet.FieldByName('PRECO_VENDA').AsFloat :=
      	dataSet.FieldByName('PROPORCAO_TABELA').AsFloat * pDateSet.FieldByName('PREC_TAB_PROD').AsFloat;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;
      
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('PRO305', acao, 'SUCESSO', 'PRECO_PRODUTOS_QTDE', vTemp, buscas)
    else
      vDadosIni.GravaAuditoria('PRO305', acao, 'FALHA', 'PRECO_PRODUTOS_QTDE', vTemp, buscas);

    // Replicar produtos para outras empresas
    if not vDadosIni.produtos_replicacao_interna(dataSet.FieldByName('GRUPO_PROD').AsInteger, dataSet.FieldByName('COD_PROD').AsString) then
    begin
      Result := false;
      exit;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas);
    if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
    begin
       vDadosIni.abreStatusProcessamento('', 'Replicando dados do preço do produto por qtde');

       if not ReplicaPrecoQtde(Self, statusRegistro) then
       begin
         RollBackTransacao;
         if teveReplicacao then
         begin
           Application.MessageBox('Erro ao replicar dados do preço produto por qtde para as outras empresas' +
             chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
             MB_ICONERROR + MB_DEFBUTTON1);
         end;
       end
       else
       begin
         CommitaTransacao;
       end;
    end;

    if Result then
      _abrePrecoProdutos(pDateSet);

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosPrecoQtde.ReplicaPrecoQtde(
