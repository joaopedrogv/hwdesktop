	buscas.Close;
  buscas.SQL.Text := 'select grupo_prod, cod_prod, cod_empresa, unidade, ' +
  	' disponivel_venda, padrao_venda from produtos_conversao_saida ' +
  	' where grupo_prod = ' + IntToStr(vgrupo_prod) +
    ' and cod_prod = ' + QuotedStr(vcod_prod) +
    ' and unidade <> ' + QuotedStr(vunidade) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  buscas.First;
  while not buscas.Eof do
  begin
  	if buscas.FieldByName('padrao_venda').AsString = 'S' then
    begin
    	Result := False;
      Exit;
    end;

    buscas.Next;
  end;

  Result := True;
end;

