function TItModeloEtiTermica.delete: boolean;
var
  vNItem: integer;
  itemDel, codTab: string;
begin
  try
    result := false;
    if IsEmpty then
      exit;
    if Application.MessageBox('Deseja mesmo apagar este registro?',
      'Apagar item da etiqueta', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
      exit;
    if not vDadosIni.PesqPros('PRO208', 'DELETAR', 'CONFIG. ' +
      dataSet.FieldByName('PARAMETROS_IMP').AsString +
      ' COLUNA: ' + dataSet.FieldByName('INDICECOLUNA').AsString +
      ' TEXTO: ' + dataSet.FieldByName('TEXTO').AsString, 'ITMODELOETITERMICA',
      dataSet.FieldByName('CODIGO').AsString + '-' + dataSet.FieldByName('NITEM').AsString, buscas,
      true) then
      exit;
    itemDel := 'CONFIG. ' + dataSet.FieldByName('PARAMETROS_IMP').AsString +
      ' COLUNA: ' + dataSet.FieldByName('INDICECOLUNA').AsString +
      ' TEXTO: ' + dataSet.FieldByName('TEXTO').AsString;
    codTab := dataSet.FieldByName('CODIGO').AsString + '-' + dataSet.FieldByName('NITEM').AsString;
    result := inherited Delete;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao
    else RollBackTransacao;
    if result then
    begin
      vNItem := 0;
      dataSet.IndexFieldNames := 'NITEM';
      First;
      while not Eof do
      begin
        inc(vNItem);
        Edit;
        dataSet.FieldByName('NITEM').AsInteger := vNItem;
        result := inherited Post;
        Next;
      end;
      Apply;
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO208', 'DELETAR SUCESSO', itemDel, 'ITMODELOETITERMICA', codTab,
        buscas);
    end else
      vDadosIni.GravaAuditoria('PRO208', 'DELETAR FALHA', itemDel, 'ITMODELOETITERMICA', codTab,
        buscas);
    Refresh;
  except
    result := false;
  end;
end;

