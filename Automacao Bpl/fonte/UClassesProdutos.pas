function TCategoriasKit.addItemTreeView(Kit: TKitsProdutos; pTreeView, pTreeView2: TTreeView; pCategoria: string): boolean;
var
  I: Integer;
  vcodcategoria: Integer;
  ANode: TtreeNode;
begin
  try
    Result := true;
    vcodcategoria := 0;

    if pTreeView.Items.Count <= 0 then
      exit;

    for I := 0 to pTreeView2.Items.Count - 1 do
      if trim(pTreeView2.Items[I].Text) = trim(pCategoria) then
      begin
        Application.MessageBox(PChar('Categoria "' + trim(pCategoria) + '" já adicionada!'), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

    try
      vcodcategoria := StrToInt(trim(Copy(pCategoria, 1, Pos('-', pCategoria) - 1)));
    except
      Application.MessageBox(PChar('Falha ao selecionar categoria: ' + trim(pCategoria)), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      Exit;
    end;
    
    SqlOpen(' select categoria.cod_categoria from categoria ' +
      ' where categoria.cod_categoria = ' + IntToStr(vcodcategoria) +
      ' and categoria.cod_empresa = ' + vDadosIni.codEmpresa);
    vcodcategoria := buscas.FieldByName('cod_categoria').AsInteger;

    if vcodcategoria <= 0 then
      exit;

    try
      dataSet.Filtered := false;
      dataSet.Filter := 'codigo_kit = ' + IntToStr(Kit.dataSet.FieldByName('codigo_kit').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_categoria = ' + IntToStr(vcodcategoria);
      dataSet.Filtered := true;

      if dataSet.IsEmpty then
      begin
        dataSet.Insert;
        dataSet.FieldByName('CODIGO_KIT').AsInteger := Kit.dataSet.FieldByName('CODIGO_KIT').AsInteger;
        dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        dataSet.FieldByName('COD_CATEGORIA').AsInteger := vcodcategoria;
        dataSet.Post;
        Apply;

        ANode := pTreeView2.Items.AddChild(nil, trim(pCategoria));
      end;
    finally
      dataSet.Filtered := false;
    end;

    for I := 0 to pTreeView.Items.Count - 1 do
      pTreeView.Items[I].Selected := True;

    for I := 0 to pTreeView.Items.Count - 1 do
      if trim(pTreeView.Items[I].Text) = trim(pCategoria) then
      begin
        pTreeView.Items[I].Selected := True;
        break;
      end;
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar(e.Message), 'Erro', MB_OK + MB_ICONASTERISK);
      registraErro(e.Message);
    end;
  end;
end;

