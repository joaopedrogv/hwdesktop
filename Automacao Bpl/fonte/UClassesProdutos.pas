      Application.MessageBox('Código DSGS não informado.' + chr(13) + 'Campo requerido.',
        'Informação', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      result := false;
    end
    else
    begin
      if ((dataSet.State = dsEdit) and (dataSet.FieldByName('COD_DSGS').NewValue <>
        dataSet.FieldByName('COD_DSGS').OldValue)) or (dataSet.State = dsInsert) then
      begin
        Application.MessageBox('Código DSGS já existe.' + chr(13) +
          'Favor informar um novo código.', 'Informação', MB_OK + MB_ICONWARNING +
          MB_DEFBUTTON1);
        result := false;
