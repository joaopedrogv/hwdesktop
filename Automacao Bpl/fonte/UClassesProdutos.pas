  end;

  dtSetProdTemp.FieldByName('COD_GRADE').DisplayLabel := 'Cod Grade';
  dtSetProdTemp.FieldByName('DESCRICAO').DisplayLabel := 'Descrição Grade';
  dtSetProdTemp.FieldByName('DESCRICAO1').DisplayLabel := 'Descrição 2 Grade';
  dtSetProdTemp.FieldByName('BARCODE').DisplayLabel := 'Codigo de Barras';
  dtSetProdTemp.FieldByName('BARCODE_EAN').DisplayLabel := 'Codigo de Barras 2';

  buscas.Close;
  buscas.SQL.Text := ' select ibp.nitem, ibp.dt_marcacao, ' +
    ' coalesce(ibp.cod_grade, 0) cod_grade, ' +
    ' coalesce(gr.descricao, ''SEM GRADE'') descricao, ' +
