            ' P.PREC_90_PROD, P.PREC_PUBLICO, P.PERC_AD_30, P.PERC_AD_60, P.PERC_AD_90 FROM PROMOCAO_PRODUTO PP ' +
            ' INNER JOIN PROMOCAO PR ON PR.COD_PROMOCAO = PP.COD_PROMOCAO AND PR.COD_TPPRECO = PP.COD_TPPRECO AND PR.COD_EMPRESA = PP.COD_EMPRESA ' +
            ' INNER JOIN PRODUTOS P ON P.GRUPO_PROD = PP.GRUPO_PROD AND P.COD_PROD = PP.COD_PROD AND P.COD_EMPRESA = PP.COD_EMPRESA ' +
            ' LEFT JOIN LOCALIDADE L ON L.COD_LOCALIDADE = PP.COD_LOCALIDADE AND L.COD_EMPRESA = PP.COD_EMPRESA ' +
            ' LEFT JOIN SETOR S ON S.COD_SETOR = PP.COD_SETOR AND S.COD_EMPRESA = PP.COD_EMPRESA ' +
            ' LEFT JOIN CIDADES C ON C.COD_CIDADE = PP.COD_CIDADE AND C.COD_CIDADE = PP.COD_CIDADE ' +
            ' INNER JOIN TIPO_PRECO TP ON TP.COD_TPPRECO = PR.COD_TPPRECO AND TP.COD_EMPRESA = PR.COD_EMPRESA ' +
            ' where pp.GRUPO_PROD = :GRUPO_PROD and pp.COD_PROD = :COD_PROD ' +
            ' and pp.COD_EMPRESA = :COD_EMPRESA and pp.VALOR_PROMOCAO > 0 and pp.PROPORCAO_TABELA > 0 ';
          buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := Trim(dataSet.FieldByName('COD_PROD').AsString);
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
          buscas.Open;
