function TAlteracaoPreco.existeProduto(pGrupo, pCodigo: string): string;
begin
  try
    StrToInt(Trim(pGrupo));
  except
    Result := 'Grupo Inválido';
    exit;
  end;

  if Trim(pCodigo) = '' then
  begin
    Result := 'Código não informado';
    exit;
  end;

  result :=
    Trim(retornaValor('select ''Grupo/Código: ''||grupo_prod||''/''||cod_prod||'' - ''||descr_prod as valor' +
    ' from produtos ' +
    ' where cod_prod = ' + QuotedStr(pCodigo) +
    ' and grupo_prod = ' + Trim(pGrupo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa));
end;

procedure TAlteracaoPreco.montarEExecutarUpdate;
var
	I: Integer;
begin
  vDadosIni.verificarReplicacaoInterna(buscas, true);
  for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
  begin
    if StrToInt(vDadosIni.codEmpresa) <> StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]) then
    	vDadosIni.abreStatusProcessamento('', 'Replicando dados da promocao ');

    buscas.Close;
    if ((FpermitAltPrecDiferenciado) or (FpermitAltPercDiferenciado) or (FpermitAltPrecPromocao) or (FpermitAltPercPromocao)) then
      buscas.SQL.Text := ' UPDATE PROMOCAO_PRODUTO SET '
    else
      buscas.SQL.Text := ' UPDATE PRODUTOS SET REP_INT_ACTIVE = 1, ';

    if vFinalidade = 'AJUSTE' then
    begin
      if FpermitAltPerc30 then
        buscas.SQL.Text := buscas.SQL.Text + ' PERC_AD_30 = :PERC_AD_30, ';
