function TProdSimilares.RestaurarRegistro: boolean;
var
	vGrupoProd: string;
	vCodProd: string;
  vGrupoSim: string;
  vCodSim: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vGrupoProd := trim(dataSet.FieldByName('GRUPO_PROD').AsString);
      vCodProd   := trim(dataSet.FieldByName('COD_PROD').AsString);
      vGrupoSim  := trim(dataSet.FieldByName('GRUPO_PS').AsString);
      vCodSim    := trim(dataSet.FieldByName('COD_PS').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vGrupoProd := '';
        vCodProd   := '';
        vGrupoSim  := '';
        vCodSim    := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vGrupoProd) <> '') then
      	prepare_loop('GRUPO_PROD = ' + vGrupoProd +
        	' AND COD_PROD = ' + QuotedStr(vCodProd) +
          ' AND GRUPO_PS = ' + vGrupoSim +
          ' AND COD_PS = ' + QuotedStr(vCodSim))
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'PRODUTO' + #13 +
        'Grupo: ' + vGrupoProd + #13 +
        'Codigo: ' + vCodProd + #13 + #13 +
        'SIMILAR' + #13 +
        'Grupo: ' + vGrupoSim + #13 +
        'Codigo: ' + vCodSim;

      if (trim(vCodProd) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO144', 'RESTAURAR', '', 'PROD_SIMILARES',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
          'Gr Prod: ' + vGrupoProd +
          ' Cod Prod: ' + vCodProd +
          ' Gr Ps: ' + vGrupoSim +
          ' Cod Ps: ' + vCodSim, ''), buscas, true) then
          	exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando produto(s) similar(es)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando produto(s) similar(es) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update prod_similares set ativo = 1 ' +
          ' where grupo_prod = %d ' +
            ' and cod_prod = %s ' +
            ' and grupo_ps = %d ' +
            ' and cod_ps = %s ' +
            ' and cod_empresa = %d ',
          [fint('grupo_prod'), fstrq('cod_prod'), fint('grupo_ps'), fstrq('cod_ps'), fint('cod_empresa')], buscas);

        if (trim(vGrupoProd) = '') then
          vDadosIni.GravaAuditoria('PRO144', 'RESTAURAR', '', 'PROD_SIMILARES',
            'Gr Prod: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
            ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString +
            ' Gr Ps: ' + dataSet.FieldByName('GRUPO_PS').AsString +
            ' Cod Ps: ' + dataSet.FieldByName('COD_PS').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO144', 'RESTAURAR', 'SUCESSO', 'PROD_SIMILARES',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	'Gr Prod: ' + vGrupoProd +
          ' Cod Prod: ' + vCodProd +
          ' Gr Ps: ' + vGrupoSim +
          ' Cod Ps: ' + vCodSim, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO144', 'RESTAURAR', 'FALHA', 'PROD_SIMILARES',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	'Gr Prod: ' + vGrupoProd +
          ' Cod Prod: ' + vCodProd +
          ' Gr Ps: ' + vGrupoSim +
          ' Cod Ps: ' + vCodSim, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

