  if not vDadosIni.PesqPros('PRO357', 'EXCLUIR', '',
    'PROD_SIMILARES_GRUPOS_ITENS', IntToStr(codigo), buscas, true) then
    exit;

  if Application.MessageBox('Tem certeza que deseja remover este produto ?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
  begin
    buscas.Close;
    buscas.SQL.Text := 'DELETE FROM PROD_SIMILARES_GRUPOS_ITENS ' +
      ' WHERE COD_GRUPO_SIM = :COD_GRUPO_SIM AND COD_EMPRESA = :COD_EMPRESA ' +
      ' AND GRUPO_PROD = :GRUPO_PROD AND COD_PROD = :COD_PROD ';
    buscas.ParamByName('COD_GRUPO_SIM').AsInteger := dataSet.FieldByName('COD_GRUPO_SIM').AsInteger;
    buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
    buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    try
      buscas.ExecSQL;
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO357', 'EXCLUIR', 'SUCESSO - ' +
				'Grupo: ' + IntToStr(grupoprod) + ' Cod Prod: ' + codprod,
        'PROD_SIMILARES_GRUPOS_ITENS', IntToStr(codigo), buscas);
