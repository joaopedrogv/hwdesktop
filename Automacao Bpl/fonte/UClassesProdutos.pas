function TProdutos.CalculaGiroEstoque(lb: TLabel; ProgressBar: TProgressBar;
  DataReferencia: string; EstoqueSeguranca, TempoProcess, TempoEntrega,
  TempoAloc, Freq_Pedido, QtdMesSugestao: integer): boolean;
var
  vQtdItemVnd, vQtdItemVndPerd, media, dmd, vEs, EstMin, EstMax, Est, vprCons, vEstMedioProd,
    vEstMedioProdTotal, vCustoMedioProd, vCustoMedioGrupo, vEstMedioGrupo: double;
  vQtdItemVnd1, vQtdItemVndAberta, vCustoMedio, vCustoMedioTemp, qtdItemDevolvido, qtdItemNFE,
    vCustoMedioTotal, vPME, vGE, vPMEGrupo, vGEGrupo, vQtdPedido: double;
  qtdExcesso, qtdDiasExcesso, vcusttemp: double;
  vCc, i, j, grupoatual: integer;
  DataTemp: TDateTime;
  vteprod: integer;
  passo: Integer;
begin
  Result := FAlse;
  i := 0;

  if not vDadosIni.PesqPros('PRO029', 'CALCULAR GIRO ESTOQUE', '', 'PRODUTOS', '', buscas, true) then
    exit;

  try


  passo := 1;
  QtdMesEmpresa := QtdMesSugestao;
  result := true;
  if ClasseGE = nil then
    ClasseGE := TConsultasGE.create;
  if BuscaClasse = nil then
    BuscaClasse := TBuscasClasses.create;
  lb.Caption := 'Abrindo Bases de Produtos...';
  buscas.Close;
  buscas.SQL.Text := 'select count(pr.cod_prod) as qtdregistros from produtos pr where ' +
    ' ((((select count(cod_prod) ' +
    'from pedvenda_prod where grupo_prod = pr.grupo_prod and ' +
    'cod_prod = pr.cod_prod and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ((status is null) or (status <> ''CANCELADO'')) and ativo=1) >= 1 ) ' +
    'or ' +
    ' ((select count(cod_prod) from item_nf_entrada where ' +
    'grupo_prod = pr.grupo_prod and ' +
    'cod_prod = pr.cod_prod and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1) >= 1 )' +
    ' or ' +
    ' ((select count(nfit.cod_prod) from notafiscal_item nfit inner join notafiscal nf on ' +
    ' nf.cod_nf=nfit.cod_nf and nf.cod_empresa=nfit.cod_empresa  where nf.natureza_nf=''E'' and ' +
    ' nfit.grupo_prod = pr.grupo_prod and nfit.cod_prod = pr.cod_prod and  nfit.cod_empresa = ' +
    vDadosIni.codEmpresa + ' and nfit.ativo=1) >= 1 ) ' +
    ') or (est_f+est_r) > 0) and ' +
    'pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1'; // order by grupo_prod';
  buscas.Open;
  passo := 2;
  //  buscas.FetchAll;
  //  ProgressBar.max := buscas.RecordCount;
  ProgressBar.max := buscas.FieldByName('qtdregistros').AsInteger;
  vGrupo.montaSelect('select * from grupos g where g.ativo=1 order by g.codigo_grup');
  vgrupo.first;
  //  ClasseProd.buscas.Close;
  //  ClasseProd.buscas.SQL.Text := 'select * from grupos g where g.ativo=1 order by g.codigo_grup';
  //  ClasseProd.buscas.open;
  while not vGrupo.Eof do
    //  ClasseProd.buscas.Eof do
  begin
    buscas.Close;
    buscas.SQL.Text :=
      'select GRUPO_PROD,COD_PROD,NUM_FAB_PROD,EST_F,EST_R,PREC_CUSM_PROD,FREQ_PEDIDO,EST_SEGURANCA,QUANT_PED_PROD,QTDEMB,TEMPO_ENTREGASUG from produtos pr where ' +
      ' ((((select count(cod_prod) ' +
      'from pedvenda_prod where grupo_prod = pr.grupo_prod and ' +
      'cod_prod = pr.cod_prod and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ((status is null) or (status <> ''CANCELADO'')) and ativo=1) >= 1 ) ' +
      'or ' +
      ' ((select count(cod_prod) from item_nf_entrada where ' +
      'grupo_prod = pr.grupo_prod and ' +
      'cod_prod = pr.cod_prod and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1) >= 1 )' +
      ' or ' +
      ' ((select count(nfit.cod_prod) from notafiscal_item nfit inner join notafiscal nf on ' +
      ' nf.cod_nf=nfit.cod_nf and nf.cod_empresa=nfit.cod_empresa  where nf.natureza_nf=''E'' and ' +
      ' nfit.grupo_prod = pr.grupo_prod and nfit.cod_prod = pr.cod_prod and  nfit.cod_empresa = ' +
      vDadosIni.codEmpresa + ' and nfit.ativo=1) >= 1 ) ' +
      ' ) or (est_f+est_r) > 0) and ' +
      'pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1 and pr.grupo_prod =' +
      vGrupo.dataSet.FieldByName('CODIGO_GRUP').AsString;
    buscas.Open;
    passo := 3;

    vEstMedioGrupo := 0;
    vCustoMedioGrupo := 0;
    while not buscas.Eof do
    begin
      Application.ProcessMessages;
      DataTemp := strtodate(DataReferencia);
      vEstMedioProdTotal := 0;
      vCustoMedio := 0;
      for j := 1 to QtdMesEmpresa do
      begin
        vQtdItemVnd1 :=
          BuscaClasse.RetornaQtdItensVendaGlobal(buscas.FieldByName('COD_PROD').asstring,
          buscas.FieldByName('GRUPO_PROD').asinteger,
          DataTemp,
          vDadosIni.codEmpresa);
        passo := 4;
        qtdItemDevolvido :=
          BuscaClasse.RetornaQtdItensDevolvidos(buscas.FieldByName('COD_PROD').asstring,
          buscas.FieldByName('GRUPO_PROD').asinteger,
          DataTemp,
          vDadosIni.codEmpresa);
        passo := 5;
        qtdItemNFE := BuscaClasse.RetornaQtdItensCompra(buscas.FieldByName('COD_PROD').asstring,
          buscas.FieldByName('GRUPO_PROD').asinteger, DataTemp);
        passo := 6;
        vEstMedioProd := ((((buscas.FieldByName('EST_F').asfloat +
          buscas.FieldByName('EST_R').asfloat) - (qtdItemNFE + qtdItemDevolvido)) + vQtdItemVnd1));
        passo := 7;

        ClasseProd.buscas.Close;
        ClasseProd.buscas.SQL.Text := 'SELECT data,valor,prec_cus_med,pr_cusc_prod FROM CUSTOS ' +
          ' WHERE GRUPO_PROD = ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
          ' AND COD_PROD = ' + quotedstr(trim(Buscas.FieldByName('COD_PROD').AsString)) +
          ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
          ' AND DATA < :vdata ' +
          ' AND ATIVO = 1 ' +
          ' order by data desc';
        ClasseProd.buscas.ParamByName('vData').AsDate := DataTemp + 1;
        ClasseProd.buscas.Open;
        passo := 8;
        if ClasseProd.buscas.IsEmpty then
          vcusttemp := buscas.FieldByName('PREC_CUSM_PROD').asfloat
        else if ClasseProd.buscas.FieldByName('PREC_CUS_MED').AsFloat = 0 then
          vcusttemp := ClasseProd.buscas.FieldByName('VALOR').AsFloat
        else
          vcusttemp := ClasseProd.buscas.FieldByName('PREC_CUS_MED').AsFloat;

        vEstMedioProdTotal := vEstMedioProdTotal + (vEstMedioProd * vcusttemp);
        vEstMedioGrupo := vEstMedioGrupo + (vEstMedioProd * vcusttemp);

        vCustoMedioTemp :=
          BuscaClasse.RetornaCustoMedioVendaItem(buscas.FieldByName('COD_PROD').asstring,
          buscas.FieldByName('GRUPO_PROD').asinteger, DataTemp);
        passo := 9;
        vCustoMedio := vCustoMedio + vCustoMedioTemp;
        vCustoMedioGrupo := vCustoMedioGrupo + vCustoMedioTemp;
        DataTemp := DataTemp - 30;
      end;
      //    vEstMedioProd := ((((buscas.FieldByName('EST_F').asfloat + buscas.FieldByName('EST_R').asfloat) - (qtdItemNFE + qtdItemDevolvido)) + vQtdItemVnd1)) / QtdMesEmpresa;
      vEstMedioProdTotal := vEstMedioProdTotal / QtdMesEmpresa;

      if (vEstMedioProdTotal <> 0) and (vCustoMedio <> 0) then
      begin
        vGE := vCustoMedio / vEstMedioProdTotal;
        vPME := (QtdMesEmpresa * 30) / vGE;
      end
      else //Checar este else;
      begin
        vGE := 0;
        vPME := 0;
      end;

      vQtdItemVnd := BuscaClasse.RetornaQtdItensVenda(buscas.FieldByName('COD_PROD').asstring,
        buscas.FieldByName('GRUPO_PROD').asinteger,
        QtdMesEmpresa,
        vDadosIni.codEmpresa);
      passo := 10;

      vQtdItemVndPerd :=
        BuscaClasse.RetornaQtdItensVendaPerdida(buscas.FieldByName('COD_PROD').asstring,
        buscas.FieldByName('GRUPO_PROD').asinteger,
        QtdMesEmpresa,
        vDadosIni.codEmpresa);
      passo := 11;

      Media := (vQtdItemVnd + vQtdItemVndPerd) / QtdMesEmpresa;
      dmd := media / 30;
      if buscas.FieldByName('TEMPO_ENTREGASUG').asinteger > 0 then
        vteprod := buscas.FieldByName('TEMPO_ENTREGASUG').asinteger
      else
        vteprod := TempoEntrega;

      if buscas.FieldByName('FREQ_PEDIDO').asinteger > 0 then
      begin
        vCc := TempoProcess + vteprod + TempoAloc + buscas.FieldByName('FREQ_PEDIDO').asinteger;
        vprcons := (buscas.FieldByName('FREQ_PEDIDO').asinteger * dmd);
      end
      else
      begin
        vCc := TempoProcess + vteprod + TempoAloc + FreqPedido;
        vprcons := (FreqPedido * dmd);
      end;
      if buscas.FieldByName('EST_SEGURANCA').asinteger > 0 then
        vEs := dmd * vCc * (buscas.FieldByName('EST_SEGURANCA').asinteger / 100)
      else
        vEs := dmd * vCc * (EstoqueSeguranca / 100);
      //      EstMin := vEs + (vcc * dmd); //EstMin=vNOE
      EstMin := (vcc * dmd);
      vQtdItemVndAberta := BuscaClasse.RetornaQtdItensVendaAberta(
        buscas.FieldByName('COD_PROD').asstring,
        buscas.FieldByName('GRUPO_PROD').asinteger,
        vDadosIni.codEmpresa);
      passo := 12;
      //      Est := buscas.FieldByName('Est_F').AsFloat - ClasseGE.buscas.FieldByName('qtdItemReqOs').AsFloat + buscas.FieldByName('QUANT_PED_PROD').AsFloat;
      Est := buscas.FieldByName('Est_F').AsFloat - vQtdItemVndAberta + buscas.FieldByName('QUANT_PED_PROD').AsFloat;

      vQtdPedido := BuscaClasse.RetornaQtdItensPedidoNaoRecebido(
      	buscas.FieldByName('COD_PROD').asstring,
        buscas.FieldByName('GRUPO_PROD').asinteger,
        vDadosIni.codEmpresa);
      passo := 13;

      EstMax := EstMin + vEs; //EstMin=vNOE(Nível ótimo de estoque...

      if (Est <= EstMin) and (EstMin <> 0) then
      begin
        if EstMax > 0 then
          if EstMax < buscas.FieldByName('QTDEMB').AsFloat then
            EstMax := buscas.FieldByName('QTDEMB').AsFloat;
        // Tem que colocar aqui o cálculo de qtde de embalagem caso o estmax > qtdeemb
        // fazer uma matriz Herbert.
      end;
      EstMax := round(EstMax);

      //    Qtde Excesso: estAtual - Emax. Se o qtdeExcesso for menor que 0 entao é igual a 0;
      if (Est - EstMax) < 0 then
        qtdExcesso := 0
      else
        qtdExcesso := Est - EstMax;

      //DiasExcesso: qtdeExcesso / dmd(sugestao).
      if dmd <> 0 then
        qtdDiasExcesso := qtdExcesso / dmd
      else
        qtdDiasExcesso := 0;

      try
        ClasseGE.buscas.Close;
        ClasseGE.buscas.SQL.Text := 'update produtos p ' +
          ' set p.valorge= :vGe' +
          ' ,p.valorpme= :vPME' +
          ' ,p.qtdprod_excesso= :qtdExcesso' +
          ' ,p.qtddias_excesso= :diasExcesso' +
          ' ,p.n_min_prod= :estoqueMin' +
          ' ,p.n_max_prod= :estoqueMax' +
          ' ,p.dmd= :dmd' +
          ' ,p.tcutilizado = :tcutilizado ' +
          ' where p.grupo_prod= ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
          ' and p.cod_prod= ' + quotedstr(trim(buscas.FieldByName('COD_PROD').asstring)) +
          ' and p.cod_empresa =' + vDadosIni.codEmpresa +
          ' and p.ativo=1';
        ClasseGE.buscas.ParamByName('vGE').AsFloat := vGE;
        ClasseGE.buscas.ParamByName('vPME').AsFloat := vPME;
        ClasseGE.buscas.ParamByName('qtdExcesso').AsFloat := qtdExcesso;
        ClasseGE.buscas.ParamByName('diasExcesso').AsFloat := qtdDiasExcesso;
        ClasseGE.buscas.ParamByName('estoqueMin').AsFloat := EstMin;
        ClasseGE.buscas.ParamByName('estoqueMax').AsFloat := EstMax;
        ClasseGE.buscas.ParamByName('dmd').AsFloat := dmd;
        ClasseGE.buscas.ParamByName('tcutilizado').AsInteger := vCc;
        ClasseGE.buscas.Prepare;
        ClasseGE.buscas.ExecSQL;
        lb.Caption := 'Item: ' + vDadosIni.StrZero(i, 6) + vDadosIni.Space(10) + vDadosIni.Space(10)
          + 'Produto: ' + trim(Buscas.FieldByName('NUM_FAB_PROD').asstring) + vDadosIni.Space(10) +
          'Total :' + inttostr(ProgressBar.Max);
        passo := 14;
        //        lb.Refresh;
        i := i + 1;
        if (i mod 50) = 0 then
          ClasseGE.CommitaTransacao;
      except
        on E: Exception do
        begin
          result := false;
          if inibeErro <> 'S' then
            Application.MessageBox(PChar('E0006 ' + 'Erro ao ler executar comandos sql: ' +
              ClasseGE.buscas.SQL.Text), 'Atenção', MB_ICONWARNING + MB_OK);
          inibeErro := 'N';
          registraErro('E0006 ' + e.Message + ' ' + ClasseGE.buscas.SQL.Text);
          ClasseGE.RollBackTransacao;
          exit;
        end;
      end;
      if Parar = 1 then
      begin
        Result := false;
        ProgressBar.Position := 0;
        Parar := 0;
        if ClasseGE.transacao.InTransaction then
          ClasseGE.RollBackTransacao;
        exit;
      end;
      buscas.Next;
      ProgressBar.Position := ProgressBar.Position + 1;
    end;
    vEstMedioGrupo := vEstMedioGrupo / QtdMesEmpresa;
    if (vEstMedioGrupo <> 0) and (vCustoMedioGrupo <> 0) then
    begin
      vGEGrupo := vCustoMedioGrupo / vEstMedioGrupo;
      vPMEGrupo := (QtdMesEmpresa * 30) / vGEGrupo;
    end
    else //Checar este else;
    begin
      vGEGrupo := 0;
      vPMEGrupo := 0;
    end;

    try
      ClasseGE.buscas.Close;
      ClasseGE.buscas.SQL.Text := 'update grupos g ' +
        ' set g.valorge= :vlGE ' +
        ' ,g.valorpme= :vlPME ' +
        ' where g.codigo_grup = ' + vGrupo.dataSet.FieldByName('CODIGO_GRUP').AsString +
        //        ClasseProd.buscas.FieldByName('CODIGO_GRUP').asstring +
      ' and g.ativo=1';
      ClasseGE.buscas.ParamByName('vlGE').AsFloat := vGEGrupo;
      ClasseGE.buscas.ParamByName('vlPME').AsFloat := vPMEGrupo;
      ClasseGE.buscas.Prepare;
      ClasseGE.buscas.ExecSQL;
      ClasseGE.CommitaTransacao;
      passo := 15;
    except
      on E: Exception do
      begin
        result := false;
        if inibeErro <> 'S' then
          Application.MessageBox(PChar('Erro ao gravar valor do Giro de Estoque por grupo na tabela Grupos.' + Chr(13) + 'SQL: ' + ClasseGE.buscas.SQL.Text), 'Atenção', MB_ICONWARNING + MB_OK);
        inibeErro := 'N';
        registraErro('E0006 ' + e.Message + ' ' + ClasseGE.buscas.SQL.Text);
        ClasseGE.RollBackTransacao;
        exit;
      end;
    end;
    vGrupo.Next;
    //    ClasseProd.buscas.Next;
  end;
  ClasseGE.CommitaTransacao;

  try
    ClasseGE.buscas.Close;
    ClasseGE.buscas.SQL.Text := 'update empresa e ' +
      ' set e.dtdefinicao_ge= :vData' +
      ' ,e.qtdmes_ge = ' + inttostr(QtdMesEmpresa) +
      ' where e.cod_empresa =' + vDadosIni.codEmpresa +
      ' and e.ativo=1';
    ClasseGE.buscas.ParamByName('vData').AsDate := strtodate(DataReferencia);
    ClasseGE.buscas.Prepare;
    ClasseGE.buscas.ExecSQL;
    ClasseGE.CommitaTransacao;
    passo := 16;
  except
    on E: Exception do
    begin
      result := false;
      if inibeErro <> 'S' then
        Application.MessageBox(PChar('Erro ao gravar data e quantidade de meses de referência do GE na tabela empresa. SQL: ' + ClasseGE.buscas.SQL.Text), 'Atenção', MB_ICONWARNING + MB_OK);
      inibeErro := 'N';
      registraErro('E0006 ' + e.Message + ' ' + ClasseGE.buscas.SQL.Text);
      ClasseGE.RollBackTransacao;
      exit;
    end;
  end;
  ProgressBar.Position := 0;
  lb.Caption := '0';
  ClasseGE.buscas.Close;
  //  ClasseProd.buscas.close;
  vGrupo.Close;

   vDadosIni.Auditoria('PRO029', 'IMPRIMIR', 'SUCESSO - ' +
  	' GIRO EST - QT MES SUG: ' + IntToStr(QtdMesSugestao) +
  	' REF: ' + FormatDateTime('dd/mm/yyyy', strtodate(DataReferencia)) +
    ' EMISSAO: ' + FormatDateTime('dd/mm/yyyy', Date), 'PRODUTOS', '');

  buscas.Close;
  Application.MessageBox(PChar('Giro de Estoque Definido com Sucesso!'), 'Atenção', MB_ICONWARNING
    + MB_OK);

    Result := True;
  except on E: Exception do
    begin    ;
      if inibeErro <> 'S' then
        ShowAtencao('Erro ao calcular giro. Passo %d. Erro: %s', [passo, e.Message]);
      inibeErro := 'N';
      registraErro('TProdutos.CalculaGiroEstoque Passo: %d - Erro: %s', [passo, e.Message]);
    end;
  end;
end;

function TProdutos.Cancel: boolean;
begin              
  dataSet.FieldByName('isento_pis').OnChange := nil;
  dataSet.FieldByName('cst_pis').OnChange    := nil;
  inherited Cancel;
end;

procedure TProdutos.CatalogoPrecos(pPrecoVenda: Boolean = False; pDiferenciado: Boolean = False; pPromocao: Boolean = False; pPrecoPorQtde: Boolean = False; pWhere: string = ''; pIndex: string = '');
var
  pNumFabr: string;
  pLinha: Integer;
  buscas2: TIBQuery;
  vOrdem: string;
  vIndex: string;
begin

  if ((pDiferenciado) or (pPromocao) or (pPrecoPorQtde)) then
    pLinha := 64
  else
    pLinha := 66;

  if ClasseProd = nil then
    ClasseProd := TPesquisaProd.create;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  buscas.Close;
  buscas.SQL.Text := 'select NOME_EMP from empresa where cod_empresa=' + vDadosIni.codEmpresa;
  buscas.Open;
  DtmProdutos.RdpProdutos.OpcoesPreview.CaptionPreview := 'Catálogo de Preço de Peças';
  DtmProdutos.RdpProdutos.CaptionSetup := 'Catálogo de Preço de Peças';
  DtmProdutos.RdpProdutos.TitulodoRelatorio := 'Catálogo de Preço de Peças';
  vDadosIni._LimparVarSendEmail;
  DtmProdutos.RdpProdutos.OnSendMail := vDadosini._SendMailRdPrint;
  DtmProdutos.RdpProdutos.OpcoesPreview.Preview := true;
  DtmProdutos.RdpProdutos.FonteTamanhoPadrao := S17cpp;
  DtmProdutos.RdpProdutos.TamanhoQteColunas := 132;
  DtmProdutos.RdpProdutos.Abrir;
  linha := 1;
  pagina := 1;
  DtmProdutos.RdpProdutos.ImpC(linha, 66, 'Loja: ' + vDadosIni.StrZero(vDadosIni.codEmpresa, 3) + ' '
    + trim(buscas.FieldByName('NOME_EMP').asstring), [comp17, Negrito]);

  buscas.Close;

  if ((not pDiferenciado) and (not pPromocao) and (not pPrecoPorQtde)) then
  begin
    while pos('IDX$', pIndex) > 0 do
    begin
      if pos('IDX$D', pIndex) > 0 then
        pIndex := Copy(pIndex, 6, Length(pIndex)) + ' desc';

      if pos('IDX$A', pIndex) > 0 then
        pIndex := Copy(pIndex, 6, Length(pIndex)) + ' asc';
    end;

    while pos(';', pIndex) > 0 do
    begin
      pIndex := StringReplace(pIndex, ';', ',', [rfReplaceAll]);
    end;

    if pIndex <> '' then
      buscas.SQL.Text := dataSet.CommandText + ' ORDER BY ' + pIndex + ''
    else
      buscas.SQL.Text := dataSet.CommandText;
  end
  else
  begin
    vOrdem := '';
    vIndex := '';
    
    if (pIndex = '') then
    begin
      vOrdem := ' ASC ';
    	pIndex := 'NUM_FAB_PROD';

      vIndex := 'IDX$ANUM_FAB_PROD';
    end
    else if (Pos('IDX$A', UpperCase(pIndex)) > 0) then
    begin
      vOrdem := ' ASC ';
      pIndex := trim(StringReplace(UpperCase(pIndex), 'IDX$A', '', [rfReplaceAll]));

      vIndex := 'IDX$A' + pIndex;
    end
    else if (Pos('IDX$D', UpperCase(pIndex)) > 0) then
    begin
      vOrdem := ' DESC ';
      pIndex := trim(StringReplace(UpperCase(pIndex), 'IDX$A', '', [rfReplaceAll]));

      vIndex := 'IDX$D' + pIndex;
    end;

    buscas2.Close;
    buscas2.SQL.Text := ' select a.rdb$field_position ordem, a.rdb$field_name campo from rdb$relation_fields a ' +
    	' inner join rdb$fields b on a.rdb$field_source = b.rdb$field_name ' +
      ' where a.rdb$relation_name = ''PRODUTOS'' and a.rdb$field_name = :index ';
    buscas2.ParamByName('INDEX').AsString := pIndex;
    buscas2.Open;

    if buscas2.IsEmpty then
    begin
    	buscas2.Close;
      buscas2.SQL.Text := ' select a.rdb$field_position ordem, a.rdb$field_name campo from rdb$relation_fields a ' +
        ' inner join rdb$fields b on a.rdb$field_source = b.rdb$field_name ' +
        ' where a.rdb$relation_name = ''PRODUTOS'' and a.rdb$field_name = :index ';
      buscas2.ParamByName('INDEX').AsString := vDadosIni.apenasNumeros(pIndex);
      buscas2.Open;
    end;

    if not buscas2.IsEmpty then
    begin
    	pIndex := trim(buscas2.FieldByName('CAMPO').AsString);
      vOrdem := IntToStr(buscas2.FieldByName('ORDEM').AsInteger + 2) + vOrdem;

      vIndex := vDadosIni.IfThen(vOrdem = ' DESC ', 'IDX$D', 'IDX$A') + pIndex;
    end;

    vProdutosRel._abreRelProdutos(pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, pWhere, vIndex);

    while pos('IDX$', pIndex) > 0 do
    begin
      if pos('IDX$D', pIndex) > 0 then
        pIndex := Copy(pIndex, 6, Length(pIndex)) + ' desc';

      if pos('IDX$A', pIndex) > 0 then
        pIndex := Copy(pIndex, 6, Length(pIndex)) + ' asc';
    end;

    while pos(';', pIndex) > 0 do
      pIndex := StringReplace(pIndex, ';', ',', [rfReplaceAll]);

    if (vOrdem <> '') then
      buscas.SQL.Text := vProdutosRel.dataSet.CommandText + Copy(vProdutosRel.dataSet.CommandText, 1, pos(' order by', vProdutosRel.dataSet.CommandText)) + ' order by ' + vOrdem
    else
      buscas.SQL.Text := vProdutosRel.dataSet.CommandText;
  end;
  buscas.Open;

  inc(linha);
  DtmProdutos.RdpProdutos.ImpC(linha, 66, 'Catálogo de Preço de Peças', [comp17, Negrito]);
  inc(linha);
  DtmProdutos.RdpProdutos.ImpF(linha, 01, datetostr(date), [comp12, Negrito]);
  DtmProdutos.RdpProdutos.ImpF(linha, 124, 'PAG: ' + vDadosIni.StrZero(pagina, 3), [comp17,
    Negrito]);
  inc(linha);
  DtmProdutos.RdpProdutos.FonteTamanhoPadrao := S17cpp;
  DtmProdutos.RdpProdutos.ImpF(linha, 01, vDadosIni.Replicate('=', 132), [comp17]);
  inc(linha);
  DtmProdutos.RdpProdutos.ImpF(linha, 1, 'Nº de Fabricação', [comp17, Negrito]);
  DtmProdutos.RdpProdutos.ImpF(linha, 31, 'Descrição', [comp17, Negrito]);
  if ((not pDiferenciado) and (not pPromocao) and (not pPrecoPorQtde)) then
  begin
  	if (pPrecoVenda) then
    begin
      DtmProdutos.RdpProdutos.ImpF(linha, 100, 'Preço de Venda', [comp17, Negrito]);
      DtmProdutos.RdpProdutos.ImpF(linha, 116, 'Preço de Atacado', [comp17, Negrito]);
    end;
  end
  else
  begin
    if (pPrecoVenda) then
	    DtmProdutos.RdpProdutos.ImpF(linha, 93, 'Preço de Venda', [comp17, Negrito]);
    inc(linha);
    DtmProdutos.RdpProdutos.ImpF(linha, 93, 'Preco Dif (Liq)', [comp17]);
    DtmProdutos.RdpProdutos.ImpF(linha, 112, 'Desc (%)', [comp17]);
    DtmProdutos.RdpProdutos.ImpF(linha, 125, 'Max (%)', [comp17]);
    DtmProdutos.RdpProdutos.ImpF(linha, 6, ' Tipo', [comp17]);
    DtmProdutos.RdpProdutos.ImpF(linha, 36, 'Descrição Tipo', [comp17]);
  end;


  Inc(linha);
  DtmProdutos.RdpProdutos.ImpF(linha, 01, vDadosIni.Replicate('=', 132), [comp17]);
  pNumFabr := '';
  buscas.First;
  while not buscas.Eof do
    //  repeat
  begin
    if ((pNumFabr <> buscas.FieldByName('NUM_FAB_PROD').AsString) or (pNumFabr = '')) then
    begin
      if ((pNumFabr <> buscas.FieldByName('NUM_FAB_PROD').AsString) and ((pDiferenciado) or (pPromocao) or (pPrecoPorQtde))) then
        inc(linha)
      else if ((not pDiferenciado) or (not pPromocao) or (not pPrecoPorQtde)) then
        inc(linha);

      DtmProdutos.RdpProdutos.ImpF(linha, 1, buscas.FieldByName('NUM_FAB_PROD').AsString +
        '          ', [comp17, Negrito]); //, Sublinhado]);
      DtmProdutos.RdpProdutos.ImpF(linha, 31, Copy(buscas.FieldByName('DESCR_PROD').AsString, 1, 66) + '          ', [comp17, Negrito]); //, Sublinhado]);

      if ((pDiferenciado) or (pPromocao)) then
      	if (pPrecoVenda) then
          DtmProdutos.RdpProdutos.impF(linha, 88, AlnDir(format('%8.2m',
            [buscas.FieldByName('PREC_TAB_PROD').asfloat]), 16), [comp17, Negrito]); //, Sublinhado]);
    end;

    pNumFabr := buscas.FieldByName('NUM_FAB_PROD').AsString;

    if ((not pDiferenciado) and (not pPromocao) and (not pPrecoPorQtde)) then
    begin
      if (pPrecoVenda) then
      begin
        DtmProdutos.RdpProdutos.impF(linha, 98, AlnDir(format('%8.2m',
          [buscas.FieldByName('PREC_TAB_PROD').asfloat]), 16), [comp17, Negrito]); //, Sublinhado]);
        DtmProdutos.RdpProdutos.impF(linha, 116, AlnDir(format('%8.2m',
          [buscas.FieldByName('PREC_PUBLICO').asfloat]), 16), [comp17, Negrito]); //, Sublinhado]);
      end;
    end
    else
    begin
      if buscas.FieldByName('TIPO').AsString <> '' then
      begin
        inc(linha);

        DtmProdutos.RdpProdutos.ImpF(linha, 6, buscas.FieldByName('TIPO').AsString +
          '          ', [comp17]); //, Sublinhado]);
        DtmProdutos.RdpProdutos.ImpF(linha, 36, Copy(buscas.FieldByName('DESCR_TIPO').AsString, 1, 66) + '          ',
          [comp17]); //, Sublinhado]);

        DtmProdutos.RdpProdutos.impF(linha, 88, AlnDir(format('%8.2m',
          [buscas.FieldByName('VALOR_PROMOCAO').asfloat]), 16), [comp17]); //, Sublinhado]);

        DtmProdutos.RdpProdutos.impF(linha, 112, AlnDir(format('%n',
          [buscas.FieldByName('PORCENTAGEM').asfloat]), 8), [comp17]); //, Sublinhado]);

        DtmProdutos.RdpProdutos.impF(linha, 123, AlnDir(format('%n',
          [buscas.FieldByName('MAX_DESC').asfloat]), 8), [comp17]); //, Sublinhado]);

      end
      else if (pPrecoVenda) then
        DtmProdutos.RdpProdutos.impF(linha, 88, AlnDir(format('%8.2m',
          [buscas.FieldByName('PREC_TAB_PROD').asfloat]), 16), [comp17, Negrito]); //, Sublinhado]);
    end;

    if linha >= pLinha then
    begin
      inc(pagina);
      linha := 1;
      DtmProdutos.RdpProdutos.Novapagina;
      inc(linha);
      DtmProdutos.RdpProdutos.ImpC(linha, 66, 'Catálogo de Preço de Peças', [comp17, Negrito]);
      inc(linha);
      DtmProdutos.RdpProdutos.ImpF(linha, 01, datetostr(date), [comp17, Negrito]);
      DtmProdutos.RdpProdutos.ImpF(linha, 124, 'PAG: ' + vDadosIni.StrZero(pagina, 3), [comp17,
        Negrito]);
      inc(linha);
      DtmProdutos.RdpProdutos.FonteTamanhoPadrao := S17cpp;
      DtmProdutos.RdpProdutos.ImpF(linha, 01, vDadosIni.Replicate('=', 132), [comp17]);
      inc(linha);
      DtmProdutos.RdpProdutos.ImpF(linha, 1, 'Nº de Fabricação', [comp17, Negrito]);
      DtmProdutos.RdpProdutos.ImpF(linha, 32, 'Descrição', [comp17, Negrito]);
      if ((not pDiferenciado) and (not pPromocao) and (not pPrecoPorQtde)) then
      begin
      	if (pPrecoVenda) then
        begin
          DtmProdutos.RdpProdutos.ImpF(linha, 100, 'Preço de Varejo', [comp17, Negrito]);
          DtmProdutos.RdpProdutos.ImpF(linha, 116, 'Preço de Atacado', [comp17, Negrito]);
        end;
      end
      else
      begin
        DtmProdutos.RdpProdutos.ImpF(linha, 95, 'Prec. Venda', [comp17, Negrito]);
        DtmProdutos.RdpProdutos.ImpF(linha, 110, 'Desc (%)', [comp17, Negrito]);
        DtmProdutos.RdpProdutos.ImpF(linha, 125, 'Max (%)', [comp17, Negrito]);
      end;
      inc(linha);
      DtmProdutos.RdpProdutos.ImpF(linha, 01, vDadosIni.Replicate('=', 132), [comp17]);
      inc(linha);
    end;
    buscas.Next;
  end;
  //  until buscas.Eof;
  DtmProdutos.RdpProdutos.Fechar;
end;

procedure TProdutos.CatalogoPrecosGrafico;
var
  vCataloto: TCatalogo;
begin
  vCataloto := TCatalogo.create;
  vCataloto.quickRep := TquickRep(FrmCadProdutos.qrpCatalogo);
  vCataloto.grid := TDBGrid(FrmCadProdutos.DBGrid1);
  vCataloto.somenteSelecionado := Application.MessageBox('Imprimir somente selecionados?',
