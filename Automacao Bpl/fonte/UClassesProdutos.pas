          ' coalesce(est.estoque, 0) estoque_disponivel, ' +
          ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
          ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
          ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
          ' where p.grupo_prod = ' + IntToStr(vGrupoProd) +
          ' and p.cod_prod = ' + QuotedStr(vCodProd) +
          ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and p.ativo = 1 ' +
          ' and cb.cod_barra = ' + QuotedStr(codBarra);
        buscas.Open;
      end
      else
      begin
        buscas.Close;
        buscas.SQL.Text := 'select distinct p.*, ' +
          ' coalesce(est.estoque, 0) estoque_disponivel, ' +
          ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
          ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
          ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
          ' where cb.cod_barra = ' + QuotedStr(codBarra) +
          ' and cb.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and p.ativo = 1';
        buscas.Open;
      end;
      buscas.FetchAll;

      if (buscas.IsEmpty) and (trim(vCodProd) = '') then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select distinct p.*, ' +
          ' coalesce(est.estoque, 0) estoque_disponivel, ' +
			 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        	' inner join cod_barra cb on p.grupo_prod=cb.grupo_prod and p.cod_prod=cb.cod_prod and p.cod_empresa=cb.cod_empresa ' +
          ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
          ' where p.cod_empresa=' + vDadosIni.codEmpresa +
          ' and p.descr_prod like ' + QuotedStr(codBarra + '%') + ' and p.ativo = 1' +
          ' order by p.descr_prod ';
        buscas.Open;
        buscas.FetchAll;
      end;

      if not buscas.IsEmpty then
        if buscas.RecordCount > 1 then
        begin
        	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
          TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
        	TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
        	TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
          TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
          if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
          begin
            Result := false;
            raise exception.create('Produto não encontrado');
            exit;
          end;
        end;

      if buscas.IsEmpty then
      begin
        Result := false;
        raise exception.create('Produto não encontrado');
        exit;
      end
      else
      begin
        vCodProd := trim(buscas.FieldByName('cod_prod').AsString);
        vGrupoProd := buscas.FieldByName('grupo_prod').AsInteger;
      end;
      buscas.close;
    end
    else
    begin
    	if (vGrupoProd > 0) or (trim(vCodProd) <> '') then
      begin
      	Result := true;
        exit;
      end;
      Result := false;
      raise exception.create('Produto não encontrado');
    end;

    if not Result then
      exit;

    if codGrade > 0 then
    	dataSet.FieldByName('cod_grade').AsInteger := codGrade
    else
    begin
      if (not GradeNoCodigo) and ExecutaComandosSql(
        ' select first 1 cgp.cod_grade from cod_grade_prod cgp' +
        ' inner join grade g on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
        ' where cgp.grupo_prod = ' + IntToStr(vGrupoProd) +
        ' and cgp.cod_prod = ' + QuotedStr(trim(vCodProd)) +
        ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa) then
      		_abreFormSelecionaGradeProd(vGrupoProd, vCodProd);

      if nGradeSelecionada <> 0 then
        dataSet.FieldByName('cod_grade').AsInteger := nGradeSelecionada
      else
        dataSet.FieldByName('cod_grade').AsInteger := vCodGrade;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select GRUPO_PROD,COD_PROD,DESCR_PROD,NUM_FAB_PROD,VL_ULT_COMPRA,PREC_CUS_PROD,' +
      ' PREC_TAB_PROD,PREC_PUBLICO,CUSTO_HONDA from produtos ' +
      '	where grupo_prod = ' + IntToStr(vGrupoProd) +
      ' and cod_prod = ' + QuotedStr(vCodProd) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ativo = 1 ';
    buscas.Open;

    dataSet.FieldByName('DESCR_PROD_CALC').AsString := buscas.FieldByName('DESCR_PROD').AsString;
    dataSet.FieldByName('NUM_FAB_PROD_CALC').AsString := trim(buscas.FieldByName('NUM_FAB_PROD').AsString);
    dataSet.FieldByName('GRUPO_PROD').AsInteger := buscas.FieldByName('GRUPO_PROD').AsInteger;
    dataSet.FieldByName('COD_PROD').AsString := trim(buscas.FieldByName('COD_PROD').AsString);

    buscas.Close;
    buscas.SQL.Text := ' select coalesce(cod_grade, 0) cod_grade, coalesce(descricao, ''SEM GRADE'') descricao from grade ' +
    	' where cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if buscas.IsEmpty then
    	dataSet.FieldByName('GRADE_CALC').AsString := 'SEM GRADE'
    else
    	dataSet.FieldByName('GRADE_CALC').AsString := buscas.FieldByName('DESCRICAO').AsString;

    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

constructor TProdutosRastro.create;
begin
	inherited Create;
	if DtmProdutos = nil then
    DtmProdutos := TDtmProdutos.Create(DtmProdutos);
  DataSet := TClientDataSet(DtmProdutos.CdsProdutosRastro);
  transacao := TIBTransaction(DtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(DtmProdutos.qrBuscasP);

  SQLMaker.Build('PRODUTOS_RASTRO',
    '', // alias
    ' PRODUTOS_RASTRO.GRUPO_PROD, PRODUTOS_RASTRO.COD_PROD, PRODUTOS_RASTRO.COD_GRADE, PRODUTOS_RASTRO.COD_EMPRESA, ' +
    ' PRODUTOS_RASTRO.NLOTE, PRODUTOS_RASTRO.QLOTE, PRODUTOS_RASTRO.DFAB, PRODUTOS_RASTRO.DVAL, ' +
    ' PRODUTOS_RASTRO.COD_CLIENTE, ' +
    ' PRODUTOS_RASTRO.QTDE_COMPRA, ' +
    ' CASE WHEN (PRODUTOS_RASTRO.COD_NF > 0) THEN SP_PRODUTOS_RASTRO_NF.QTDE_COMPRA ELSE PRODUTOS_RASTRO.QTDE_COMPRA END QTDE_COMPRA2, ' +
    ' PRODUTOS_RASTRO.COD_NF, ' +
    ' CASE WHEN (COD_GRADE_PROD.COD_GRADE > 0) THEN ' +
    '        COALESCE(COD_GRADE_PROD.QTDE, 0) ' +
    '      ELSE ' +
    '        COALESCE(PRODUTOS.EST_F, 0) ' +
    ' END ESTOQUE, ' +
    ' PRODUTOS.NUM_FAB_PROD, PRODUTOS.DESCR_PROD,' +
    ' GRADE.DESCRICAO GRADE, ' +
    ' GRUPOS.DESCRICAO GRUPO, ' +
    ' SUB_GRUPO.DESCRICAO SUBGRUPO, ' +
    ' MARCA_PROD.DESCRICAO_MARCA MARCA, ' +
    ' CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO RAZAO_CLIENTE, CLIENTES.CPFCGC CPFCGC_CLIENTE, ' +
    ' NOTAFISCAL.NUM_NF, NOTAFISCAL.SERIE, NOTAFISCAL.DATA_LANC, NOTAFISCAL.VALOR_TOTAL', //campos
    ' INNER JOIN PRODUTOS ON ' +
    '		PRODUTOS_RASTRO.GRUPO_PROD = PRODUTOS.GRUPO_PROD AND PRODUTOS_RASTRO.COD_PROD = PRODUTOS.COD_PROD AND PRODUTOS_RASTRO.COD_EMPRESA = PRODUTOS.COD_EMPRESA ' +
		' LEFT JOIN COD_GRADE_PROD ON ' +
    '		COD_GRADE_PROD.GRUPO_PROD = PRODUTOS_RASTRO.GRUPO_PROD AND COD_GRADE_PROD.COD_PROD = PRODUTOS_RASTRO.COD_PROD AND COD_GRADE_PROD.COD_GRADE = PRODUTOS_RASTRO.COD_GRADE AND COD_GRADE_PROD.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN GRADE ON ' +
    '		GRADE.COD_GRADE = PRODUTOS_RASTRO.COD_GRADE AND GRADE.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN NOTAFISCAL ON ' +
    '		NOTAFISCAL.COD_NF = PRODUTOS_RASTRO.COD_NF AND NOTAFISCAL.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN CLIENTES ON ' +
    '		CLIENTES.COD_CLIENTE = CASE WHEN (PRODUTOS_RASTRO.COD_NF > 0) THEN NOTAFISCAL.COD_CLIENTE ELSE PRODUTOS_RASTRO.COD_CLIENTE END AND CLIENTES.COD_EMPRESA = PRODUTOS_RASTRO.COD_EMPRESA ' +
    ' LEFT JOIN SP_PRODUTOS_RASTRO_NF ' +
    '		(PRODUTOS_RASTRO.GRUPO_PROD, PRODUTOS_RASTRO.COD_PROD, PRODUTOS_RASTRO.COD_GRADE, PRODUTOS_RASTRO.COD_EMPRESA, PRODUTOS_RASTRO.COD_NF) ON 1 = 1 ' +
		' LEFT JOIN GRUPOS ON ' +
    '		GRUPOS.CODIGO_GRUP = PRODUTOS.GRUPO_PROD ' +
    ' LEFT JOIN SUB_GRUPO ON ' +
    '		SUB_GRUPO.CODIGO_SUBGR = PRODUTOS.SUB_G_PROD ' +
    ' LEFT JOIN MARCA_PROD ON ' +
    '		MARCA_PROD.COD_MARCA = PRODUTOS.COD_MARCA ', // joins
    ' ', // where
    ' GRUPO_PROD, COD_PROD, COD_GRADE, DVAL '); // order
end;

function TProdutosRastro.Delete: boolean;
var
  vTemp: string;
	vGrupoProd, vCodProd, vCodGrade, vDescrProd, vNumFabProd, vNlote: string;
begin
	try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vGrupoProd := trim(dataSet.FieldByName('GRUPO_PROD').AsString);
      vCodProd := trim(dataSet.FieldByName('COD_PROD').AsString);
      vCodGrade := IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger);
      vNumFabProd := trim(dataSet.FieldByName('NUM_FAB_PROD').AsString);
      vDescrProd := trim(dataSet.FieldByName('DESCR_PROD').AsString);
      vNlote := trim(dataSet.FieldByName('NLOTE').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
      	vGrupoProd := '';
	      vCodProd := '';
        vCodGrade := '';
        vNumFabProd := '';
        vDescrProd := '';
        vNlote := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vGrupoProd) <> '') and (trim(vCodProd) <> '') and (trim(vCodGrade) <> '') and (trim(vNlote) <> '') then
      	prepare_loop('GRUPO_PROD = ' + vGrupoProd +
                     ' AND COD_PROD = ' + QuotedStr(vCodProd) +
                     ' AND COD_GRADE = ' + vCodGrade +
                     ' AND NLOTE = ' + QuotedStr(vNlote))
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja excluir este registro permanentemente' + #13 + #13 +
        'PRODUTO VALIDADE' + #13 +
        'Grupo: ' + vGrupoProd + #13 +
        'Cod Prod: ' + vCodProd + #13 +
        'Cod Grade: ' + vCodGrade + #13 +
        'Num Lote: ' + vNlote + #13 +
        'Num Fabricante: ' + vNumFabProd + #13 +
        'Descrição: ' + vDescrProd;

      if (trim(vGrupoProd) = '') then
        vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) +
        	' registros selecionados permanentemente?';

      if not vDadosIni.PesqPros('PRO005', 'EXCLUIR', '', 'PRODUTOS_RASTRO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd + '-' + vCodGrade + vNlote, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;


      vDadosIni.abreStatusProcessamento('', 'Excluíndo validade do(s) produto(s) permanentemente');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Excluíndo validade do(s) produto(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if dataSet.FieldByName('COD_NF').AsInteger > 0 then
        begin
        	vtemp := 'Este registro esta vinculado a uma nota fiscal, não é possível excluir.' + #13 + #13 +
            'Produto Validade' + #13 +
            'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
            'Cod Prod: ' + trim(dataSet.FieldByName('cod_prod').AsString) + #13 +
            'Cod Grade: ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) + #13 +
            'Num Fabricante: ' + trim(dataSet.FieldByName('num_fab_prod').AsString) + #13 +
            'Descrição: ' + trim(dataSet.FieldByName('descr_prod').AsString) + #13 +
            'Num Lote: ' + trim(dataSet.FieldByName('nlote').AsString) + #13 +
            'Num NF: ' + IntToStr(dataSet.FieldByName('num_nf').AsInteger) + #13 +
            'Serie NF: ' + trim(dataSet.FieldByName('serie').AsString);

          Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          RollBackTransacao;
          exit;
        end;        

        SqlExec(' delete from produtos_rastro ' +
            ' where grupo_prod = %d ' +
            ' and cod_prod = %s ' +
            ' and cod_grade = %d ' +
            ' and cod_empresa = %d ' +
            ' and nlote = %s ',
            [fint('grupo_prod'),
             fstr('cod_prod'),
             fint('cod_grade'),
             fint('cod_empresa'),
             fstr('nlote')], buscas);

        vDadosIni.GravaAuditoria('PRO005', 'EXCLUIR', '', 'PRODUTOS_RASTRO',
          dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
          dataSet.FieldByName('COD_PROD').AsString + '-' +
          dataSet.FieldByName('COD_GRADE').AsString + '-' +
          dataSet.FieldByName('NLOTE').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO006',
      	'EXCLUIR', 'SUCESSO', 'PRODUTOS_RASTRO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd + '-' + vCodGrade + '-' + vNlote, ''),
        buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO005',
      	'EXCLUIR', 'FALHA', 'PRODUTOS_RASTRO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd + '-' + vCodGrade + '-' + vNlote, ''),
        buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

