procedure TProdutos.isento_pis_Change(Sender: TField);
begin
  if (Sender.AsString = 'S') and (fstr('cst_pis') <> '07') then
  begin                                                
    dataSet.FieldByName('cst_cofins').AsString := '07';
    dataSet.FieldByName('cst_pis').AsString    := '07';
  end
  else if (Sender.AsString = 'N') and (fstr('cst_pis') = '07') then
  begin                                              
    dataSet.FieldByName('cst_cofins').AsString := '';
    dataSet.FieldByName('cst_pis').AsString    := '';
  end;
end;

procedure TProdutos.lerConfigAdc;
var
	Config: TConfig_sistema_class;
  vEmpresas: TStringList;
  I: Integer;
begin
	try
		Config := TConfig_sistema_class.getConf('prod_cad_est_por_emp', buscas, vDadosIni.cod_empresa);

    if (trim(UpperCase(Config.ReadString('Conf', 'Empresas'))) <> '')
    	and (trim(UpperCase(Config.ReadString('Conf', 'Empresas'))) <> '0') then
   	    vEstoquePorEmpresa.vExibirEmpresas := trim(UpperCase(Config.ReadString('Conf', 'Empresas')))
    else
      	vEstoquePorEmpresa.vExibirEmpresas := '';
    vEstoquePorEmpresa.vExibirEmpresas := StringReplace(vEstoquePorEmpresa.vExibirEmpresas, ' ', '', [rfReplaceAll]);

    try
    	vEmpresas := vDadosIni.Split(vEstoquePorEmpresa.vExibirEmpresas, ',');

      vEstoquePorEmpresa.vExibirEmpresas := '';
      for I := 0 to vEmpresas.Count - 1 do
      begin
        try
          if (StrToInt(vEmpresas[I]) > 0) then
            vEstoquePorEmpresa.vExibirEmpresas :=
              vEstoquePorEmpresa.vExibirEmpresas +
              vDadosIni.IfThen(trim(vEstoquePorEmpresa.vExibirEmpresas) = '', '', ',') +
                trim(vEmpresas[I]);
        except
        end;
      end;

    finally
      if Assigned(vEmpresas) then
      	FreeAndNil(vEmpresas);
    end;

    if (trim(UpperCase(Config.ReadString('Conf', 'SomarEmpresaSemEstoque'))) = 'S') then
      	vEstoquePorEmpresa.vSomarEmpresaSemEstoque := True
    else
      	vEstoquePorEmpresa.vSomarEmpresaSemEstoque := False;

    if (trim(UpperCase(Config.ReadString('Conf', 'ExibirSomaTotalEstoque'))) = 'S') then
   	    vEstoquePorEmpresa.vExibirSomaTotalEstoque := True
    else if (trim(UpperCase(Config.ReadString('Conf', 'UtilizarSomaTotalEstoque'))) = 'S') then
        vEstoquePorEmpresa.vExibirSomaTotalEstoque := True 
