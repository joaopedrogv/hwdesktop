function TProdutosFretePorPeso.GetDataSet: TProdutosFretePorPeso;
var
  field: TStringField;
begin
  Result := Self;
  if dataSet.Active then
    dataSet.FieldByName('cod_cliente').OnGetText := nil;
  ClientOpen('select fp.* from' + //, cl.nome_cliente from' +
             ' produtos_frete_peso fp' +
//             ' left join clientes cl on cl.cod_cliente = fp.cod_cliente and cl.cod_empresa = fp.cod_empresa' +
             ' where fp.grupo_prod = %d and fp.cod_prod = %s and fp.cod_empresa = %d',
             [Owner.fint('grupo_prod'), Owner.fstrq('cod_prod'), vDadosIni.cod_empresa]);

  dataSet.IndexFieldNames := 'ID';

  dataSet.FieldByName('id').Visible := False;
  dataSet.FieldByName('grupo_prod').Visible := False;
  dataSet.FieldByName('cod_prod').Visible := False;
  dataSet.FieldByName('cod_empresa').Visible := False;
  dataSet.FieldByName('ativo').Visible := False;
  dataSet.FieldByName('cod_cliente').Alignment := taLeftJustify;
  dataSet.FieldByName('cod_cliente').DisplayWidth := 48;
  dataSet.FieldByName('cod_cliente').DisplayLabel := 'Fornecedor';
  TFloatField(dataSet.FieldByName('peso')).DisplayFormat := '#0.000';
  TFloatField(dataSet.FieldByName('valor')).DisplayFormat := '#0.000';

  prepare_loop();
  try

    listClientes.Clear;
    while not DataSet.Eof do
    begin
      listClientes.Add(fstr('cod_cliente'));
      DataSet.Next;
    end;

    GetDataSetFonecedor(0);                             

  finally
    prepare_loop_done();
  end;
