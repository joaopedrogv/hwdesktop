{ TEstoquePorEmpresa }

function TEstoquePorEmpresa.abreEstoquePorEmpresa(pDateSet: TDataSet): boolean;
var
	vEst: Double;
begin
	Result := montaSelect(' select pr.grupo_prod, ' +
  	' pr.cod_prod, ' +
  	' pr.cod_empresa, ' +
  	' emp.identificacao_emp, ' +
    ' est.estoque disponivel, ' +
    ' (est.est_f - est.estoque) pendencias, ' +
    ' coalesce(pr.prec_tab_prod, 0) prec_tab_prod, ' +
    ' coalesce(pr.prec_publico, 0) prec_publico, ' +
    ' coalesce(pr.prec_30_prod, 0) prec_30_prod, ' +
    ' coalesce(pr.prec_60_prod, 0) prec_60_prod, ' +
    ' coalesce(pr.prec_90_prod, 0) prec_90_prod ' +
    ' from empresa emp ' +
  	' inner join produtos pr on emp.cod_empresa = pr.cod_empresa ' +
    ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
    ' where pr.grupo_prod = ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and pr.cod_prod = ' + QuotedStr(pDateSet.FieldByName('COD_PROD').AsString) +
    vDadosIni.IfThen(trim(vExibirEmpresas) <> '',
    	' and pr.cod_empresa in (' + trim(vExibirEmpresas) + ')', '') +
    ' and pr.ativo = 1 ' +
    ' order by pr.grupo_prod, pr.cod_prod, pr.cod_empresa ');

  if (Assigned(FrmCadProdutos)) and (vExibirSomaTotalEstoque) then
  begin
  	try
    	vEst := 0;

      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if (vSomarEmpresaSemEstoque) then
        	vEst := vEst + dataSet.FieldByName('disponivel').AsFloat
        else if (dataSet.FieldByName('disponivel').AsFloat > 0) then
      	  vEst := vEst + dataSet.FieldByName('disponivel').AsFloat;

      	dataSet.Next;
      end;
    finally
    	dataSet.First;
    	dataSet.EnableControls;

      FrmCadProdutos.lbQtdeEstEmpresas.Caption := 'Disponível: ' + FormatFloat('0.0000', vEst);

      FrmCadProdutos.pnTotEstEmp.Visible := vExibirSomaTotalEstoque;
    end;
  end;
end;

