function TKitsProdutos._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
begin
  result := true;
  rKit.vSqlAdicional := '';

  if rKit.vAdicional then
  begin
    if rKit.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rKit.vDataIniAd);
      except
        rKit.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rKit.vDataFimAd);
      except
        rKit.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rKit.vDataIniAd <> '' then
          rKit.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rKit.vDataIniAd)));
        if rKit.vDataFimAd <> '' then
          rKit.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rKit.vDataFimAd)));
      end;
    end
    else if rKit.vValorAd = '' then
      exit;
    if rKit.vCondicaoAd = 'Igual' then
      rKit.vCondicaoAd := '='
    else if rKit.vCondicaoAd = 'Maior' then
      rKit.vCondicaoAd := '>'
    else if rKit.vCondicaoAd = 'Maior ou Igual' then
      rKit.vCondicaoAd := '>='
    else if rKit.vCondicaoAd = 'Menor' then
      rKit.vCondicaoAd := '<'
    else if rKit.vCondicaoAd = 'Menor ou Igual' then
      rKit.vCondicaoAd := '<='
    else if rKit.vCondicaoAd = 'Diferente' then
      rKit.vCondicaoAd := '<>'
    else if (rKit.vCondicaoAd = 'Esta contido') then
      rKit.vCondicaoAd := 'like'
    else if (rKit.vCondicaoAd = 'Começa') then
      rKit.vCondicaoAd := 'Começa'
    else
      rKit.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rKit.vCampoAd) then
        begin
          if rKit.vCampo = rKit.vCampoAd then
          begin
            rKit.vsqlAdicional := '';
            exit;
          end;
          rKit.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rKit.vCondicaoAd = 'Começa') or (rKit.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rKit.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rKit.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rKit.vCondicaoAd := '=';
            rKit.vValorAd := vDadosIni.trocaVirgulaPorPonto(rKit.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (rKit.vDataIniAd <> '') and (rKit.vDataFimAd <> '') then
              rKit.vSqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd +
                ' >= ' + rKit.vDataIniAd + ' and ' + rKit.vCampoAd + ' <= ' + rKit.vDataFimAd
            else if (rKit.vDataFimAd <> '') then
              rKit.vsqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd +
                ' <= ' + rKit.vDataIniAd
            else if (rKit.vDataIniAd <> '') and (rKit.vDataFimAd <> '') then
              rKit.vsqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd +
                ' >= ' + rKit.vDataIniAd;
            Break;
          end;
          if rKit.vCondicaoAd = 'like' then
            rKit.vsqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd +
              ' like ' + QuotedStr('%' +
              rKit.vValorAd +
              '%')
          else if rKit.vCondicaoAd = 'Começa' then
            rKit.vsqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd +
              ' like ' +
              QuotedStr(rKit.vValorAd + '%')
          else
            rKit.vsqlAdicional := rKit.vsqlAdicional + rKit.vCampoAd + ' '
              + rKit.vCondicaoAd + ' ' +
              QuotedStr(rKit.vValorAd);

          if rKit.vCondicaoAd <> 'Começa' then
          begin
            if ((rKit.vCampoAd = 'PREC_CUS_PROD') or (rKit.vCampoAd = 'PREC_CUSM_PROD') or (rKit.vCampoAd = 'PREC_TAB_PROD')
              or (rKit.vCampoAd = 'PREC_PUBLICO') or (rKit.vCampoAd = 'PREC_30_PROD') or (rKit.vCampoAd = 'PREC_60_PROD')
              or (rKit.vCampoAd = 'PREC_90_PROD') or (rKit.vCampoAd = 'EST_F') or (rKit.vCampoAd = 'QUANT_PROD_KIT')) then
              rKit.vsqlAdicional := 'COALESCE(KITS_PROD_TOT.' + rKit.vCampoAd + ', 0) ' + rKit.vCondicaoAd + ' ' + QuotedStr(rKit.vValorAd)
            else
              rKit.vsqlAdicional := 'KITS_PROD.' + rKit.vCampoAd + ' ' + rKit.vCondicaoAd + ' ' + QuotedStr(rKit.vValorAd);
          end
          else
          begin
            if ((rKit.vCampoAd = 'PREC_CUS_PROD') or (rKit.vCampoAd = 'PREC_CUSM_PROD') or (rKit.vCampoAd = 'PREC_TAB_PROD')
              or (rKit.vCampoAd = 'PREC_PUBLICO') or (rKit.vCampoAd = 'PREC_30_PROD') or (rKit.vCampoAd = 'PREC_60_PROD')
              or (rKit.vCampoAd = 'PREC_90_PROD') or (rKit.vCampoAd = 'EST_F') or (rKit.vCampoAd = 'QUANT_PROD_KIT')) then
              rKit.vsqlAdicional := 'COALESCE(KITS_PROD_TOT.' + rKit.vCampoAd + ', 0) LIKE ' + QuotedStr(rKit.vValorAd + '%')
            else
              rKit.vsqlAdicional := 'KITS_PROD.' + rKit.vCampoAd + ' LIKE' + QuotedStr(rKit.vValorAd + '%');
          end;

          Break;
        end;
      end;
    end;
  end;

  tempSql := '';

  if rKit.vCampo = 'Total Quantidade' then
    tempSql := 'COALESCE(KITS_PROD_TOT.QUANT_PROD_KIT, 0) '
  else if rKit.vCampo = 'Total Preco Custo' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_CUS_PROD, 0) '
  else if rKit.vCampo = 'Total Preco Custo Medio' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_CUSM_PROD, 0) '
  else if rKit.vCampo = 'Total Preco de Tabela' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_TAB_PROD, 0) '
  else if rKit.vCampo = 'Total Preco Publico' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_PUBLICO, 0) '
  else if rKit.vCampo = 'Total Preco 30 dias' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_30_PROD, 0) '
  else if rKit.vCampo = 'Total Preco 60 dias' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_60_PROD, 0) '
  else if rKit.vCampo = 'Total Preco 90 dias' then
    tempSql := 'COALESCE(KITS_PROD_TOT.PREC_90_PROD, 0) '
  else if rKit.vCampo = 'Total Estoque Fisico' then
    tempSql := 'COALESCE(KITS_PROD_TOT.EST_F, 0) ';
  if tempSql  <> '' then
  begin
    if rKit.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rKit.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rKit.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rKit.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rKit.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rKit.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rKit.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rKit.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + rKit.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(rKit.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(rKit.vValor);
    rKit.vValor := '';
    if Trim(rKit.vSqlAdicional) <> '' then
      rKit.vSqlAdicional := rKit.vSqlAdicional + ' and ' + tempSql
    else
      rKit.vSqlAdicional := tempSql;
  end;
end;

procedure TKitsProdutos._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

  	if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TKitsProdutos._imprimirKit(pTodos: boolean): boolean;
var
  variavel_parar: boolean;
  vpag: Integer;
  linha: integer;

  procedure menuKit;
  begin
    //Impressão do Menu.
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);

    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'CODIGO', [comp17, negrito]);
    Rdp.ImpF(linha, 22, 'DESCRICAO', [comp17, negrito]);
    Rdp.ImpD(linha, 75, 'QUANTIDADE', [comp17, negrito]);
