    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TGradeEstoque._incluirGradeEstoque(prod: TProdutos): boolean;
var
  vCodGRade: Integer;
  vGradeSelec: boolean;
  vParar, vTem: Boolean;
  vListaCtr: TStringList;
  procedure _fazInsert;
  begin
    vParar := True;
    dataSet.First;
    vTem := False;
    while not dataSet.Eof do
    begin
      if dataSet.FieldByName('cod_grade').AsInteger =
        vGrade.dataSet.FieldByName('cod_grade').AsInteger then
      begin
        vTem := true;
        Break;
      end;
      dataSet.Next;
    end;

    if not vTem then
    begin
      if inherited insert then
      begin
        dataSet.FieldByName('grupo_prod').AsInteger :=
          prod.dataSet.FieldByName('grupo_prod').AsInteger;
        dataSet.FieldByName('cod_prod').AsString :=
          prod.dataSet.FieldByName('cod_prod').AsString;
        dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codempresa;
        dataSet.FieldByName('cod_grade').AsInteger :=
          vGrade.dataSet.FieldByName('cod_grade').AsInteger;
        dataSet.FieldByName('qtde').AsFloat := 0;
        Post;
      end;
    end;
  end;
begin
  if dataSet.State in [dsEdit, dsInsert] then
    if not Post then
      Exit;
  Result      := False;
  vGradeSelec := False;
  vGrade.abreGradeParaDistribuir;

  SqlOpen(' select first 11 distinct cp.cod_contrato from clientes_com_contrato_prod cp ' +
  	' where cp.grupo_prod = ' + IntToStr(prod.dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cp.cod_prod = ' + QuotedStr(prod.dataSet.FieldByName('cod_prod').AsString) +
    ' and cp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cp.cod_grade = 0 ', buscas).FetchAll;

  if not buscas.IsEmpty then
  begin
  	try
      vListaCtr := TStringList.Create;
      vListaCtr.Duplicates := dupIgnore;
      vListaCtr.Clear;

      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.RecNo >= 11 then
        begin
          vListaCtr.Add('...');
          Break;
        end;

        vListaCtr.Add(IntToStr(buscas.FieldByName('cod_contrato').AsInteger));

        buscas.Next;
      end;

      Application.MessageBox(PChar('Produto foi vinculado sem grade ao(s) contrato(s): '+ #13 + #13 +
      	'CONTRATO(S): ' + #13 +
        trim(vListaCtr.Text) + #13 +
        'Favor verificar antes de continuar.'), 'Atenção', MB_ICONWARNING + MB_OK);
      Result := False;
      exit;
    finally
    	if Assigned(vListaCtr) then
      	vListaCtr.Free;
    end;
  end;
  
  vGrade.dataSet.Filtered := False;
  vGrade.dataSet.Filter := '';

  if not _abreFormEscolhaGrade(prod) then
    exit;
  vCodGRade := vGrade.dataSet.FieldByName('cod_grade').AsInteger;

  dataSet.AfterScroll := nil;
  try
    vGrade.dataSet.First;
    while not vGrade.dataSet.Eof do
    begin
    	if (vGrade.dataSet.FieldByName('SEL').AsString = 'S') then
	    	vGradeSelec := True;

    	vGrade.dataSet.Next;
    end;
  finally
    dataSet.AfterScroll := AfterScroll;
  end;

  if not vGradeSelec then
  begin
  	Application.MessageBox('Nenhuma grade selecionada', 'Atenção', MB_ICONWARNING + MB_OK);
  	Result := False;
    exit;
  end;

  dataSet.AfterScroll := nil;
  try
    vParar := False;
    vGrade.dataSet.First;
    while not vGrade.dataSet.Eof do
    begin
      if (vGrade.dataSet.FieldByName('SEL').AsString = 'S') then
        _fazInsert;

      vGrade.dataSet.Next;
    end;
  finally
    dataSet.AfterScroll := AfterScroll;
  end;

  vGrade.dataSet.Filtered := False;
  vGrade.dataSet.Filter := '';

  if vParar then
  begin
    if dataSet.ChangeCount > 0 then
      if Apply then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update config_sistema set value1_vc = null' +
          ' where cod_empresa = ' + vDadosIni.codEmpresa +
          ' and chave = ' + QuotedStr('prcss_montar_estoque_diario_30_12_1899') +
          ' and value1_vc is not null';
        buscas.ExecSQL;

        Result := CommitaTransacao;
        fOldGrupo := prod.dataSet.FieldByName('grupo_prod').AsInteger;
        fOldCodigo := prod.dataSet.FieldByName('cod_prod').AsString;
        replicaGradeEstoque;
        if Result then
          vDadosIni.GravaAuditoria('PRO089', 'TRANSACAO CONFIRMADA', 'SUCESSO', 'PRODUTOS',
            prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
            prod.dataSet.FieldByName('COD_PROD').AsString, buscas)
        else
          vDadosIni.GravaAuditoria('PRO089', 'TRANSACAO CONFIRMADA', 'FALHA', 'PRODUTOS',
            prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
            prod.dataSet.FieldByName('COD_PROD').AsString, buscas);

        if Result then
        begin
          if (vDadosIni.vEmp.vUsarProducao = 'S')
          	and (vDadosIni.existeMateriaPrima(prod.buscas,
				          prod.dataSet.FieldByName('grupo_prod').AsInteger,
        				  prod.dataSet.FieldByName('cod_prod').AsString)) then
          begin
          	if vDadosIni.produtoAcabadoPrimaTemGrade(
              prod.buscas,
              prod.dataSet.FieldByName('grupo_prod').AsInteger,
              prod.dataSet.FieldByName('cod_prod').AsString,
              0,
              '') then
            begin
              if vDadosIni.existeGradeProducao(
                prod.buscas,
                prod.dataSet.FieldByName('grupo_prod').AsInteger,
                prod.dataSet.FieldByName('cod_prod').AsString,
                0,
                '') then
              begin
                if not vDadosIni.vincularProdutoAcabadoMateriaPrima(
                	prod.buscas,
                  prod.dataSet.FieldByName('grupo_prod').AsInteger,
                  prod.dataSet.FieldByName('cod_prod').AsString,
                  0,
                  0,
                  '',
                  0,
                  true) then
                    exit;
              end;
            end;
          end
          else if (vDadosIni.vEmp.vUsarProducao = 'S') then
          begin
            if vDadosIni.retornaProdutosAcabado(
              prod.buscas,
              prod.dataSet.FieldByName('grupo_prod').AsInteger,
              prod.dataSet.FieldByName('cod_prod').AsString) then
            begin
              vDadosIni.vDtSetTmpProducao.First;
              while not vDadosIni.vDtSetTmpProducao.Eof do
              begin
              	if vDadosIni.produtoAcabadoPrimaTemGrade(
                  prod.buscas,
                  vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
                  vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
                  0,
                  '') then
                begin
                  if vDadosIni.existeGradeProducao(
                    prod.buscas,
                    vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
                    vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
                    0,
                    '') then
                  begin
                    if not vDadosIni.vincularProdutoAcabadoMateriaPrima(
                    	prod.buscas,
                      vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
                      vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
                      0,
                      0,
                      '',
                      0,
                      true) then
                        exit;
                  end;
                end;

                vDadosIni.vDtSetTmpProducao.Next;
              end;
            end;
          end;
        end;
      end;

    Exit;
  end;

  dataSet.First;
  if not dataSet.IsEmpty then
    while not dataSet.Eof do
    begin
      if dataSet.FieldByName('cod_grade').AsInteger = vCodGRade then
      begin
        dataSet.Edit;
        Result := True;
        exit;
      end;
      dataSet.Next;
    end;

  if inherited insert then
  begin
    dataSet.FieldByName('grupo_prod').AsInteger := prod.dataSet.FieldByName('grupo_prod').AsInteger;
    dataSet.FieldByName('cod_prod').AsString := prod.dataSet.FieldByName('cod_prod').AsString;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codempresa;
    dataSet.FieldByName('cod_grade').AsInteger := vCodGRade;
    dataSet.FieldByName('qtde').AsFloat := 0;
    Post;
    Result := True;
  end;

  if Apply then
  begin
    buscas.Close;
    buscas.SQL.Text := 'update config_sistema set value1_vc = null' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and chave = ' + QuotedStr('prcss_montar_estoque_diario_30_12_1899') +
      ' and value1_vc is not null';
    buscas.ExecSQL;

    Result := CommitaTransacao;
    fOldGrupo := prod.dataSet.FieldByName('grupo_prod').AsInteger;
    fOldCodigo := prod.dataSet.FieldByName('cod_prod').AsString;
    replicaGradeEstoque;
    if Result then
      vDadosIni.GravaAuditoria('PRO089', 'TRANSACAO CONFIRMADA', 'SUCESSO', 'PRODUTOS',
        prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        prod.dataSet.FieldByName('COD_PROD').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('PRO089', 'TRANSACAO CONFIRMADA', 'FALHA', 'PRODUTOS',
        prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        prod.dataSet.FieldByName('COD_PROD').AsString, buscas);
  end;
end;

