    		Rdp.ImpD(linha, 104, format('%n', [vprec_tab_prodTot]), [comp17, negrito]);
        Rdp.ImpD(linha, 118, format('%n', [vprec_publicoTot]), [comp17, negrito]);
        Rdp.ImpD(linha, 132, format('%n', [vest_fTot]), [comp17, negrito]);
        linha := linha + 1;

        buscas.Next;

        if linha >= 60 then
