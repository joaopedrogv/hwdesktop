function TTipoTipoServ.Delete: Boolean;
begin
	Result := False;
  if dataSet.IsEmpty then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir a origem do tipo de serviço?',
  	'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

  if SqlOpen('select count(*) as contador from tipo_servico '+
  	' where upper(trim(stipo)) = %s',
    [fstrq('sigla')]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Origem do Tipo de Serviço está sendo usado em %d registros. ' +
    	' Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  dataSet.Delete;
  if Apply then
  begin
    CommitaTransacao;
    Auditor.Sucesso.Salvar.GravarMensagem('');
    Refresh;
    Result := True;
  end
  else
  begin
    RollBackTransacao;
    Auditor.Falha.Salvar.GravarMensagem('');
    Result := False;
  end;
end;

function TTipoTipoServ.Post: Boolean;
var
	acao: string;
  vcodigo: Integer;
begin
	Result := False;

  if dataSet.State = dsEdit then
    acao := 'EDITAR'
  else
    acao := 'INSERIR';

  vcodigo := 0;
  try
    if fempty('descricao') then
      raiseExceptionCreate('Descricao deve ser preenchida');

    if fempty('sigla') then
      raiseExceptionCreate('Sigla deve ser preenchida');

    if not SqlOpen('select descricao from tipo_tipo_servico ' +
    							 'where sigla = %s ' +
                   'and cod_tipo_servico <> %d',
                   [fstrq('sigla'), fint('cod_tipo_servico')]).IsEmpty then
      raiseExceptionCreate('Já existe uma origem do tipo de serviço com a mesma sigla');

    fdata('ativo').Put(1);

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_TIPO_SERVICO,1) from rdb$database';
      buscas.Open;

      vcodigo := buscas.FieldByName('GEN_ID').AsInteger;
    end
    else
    	vcodigo := dataSet.FieldByName('cod_tipo_servico').AsInteger;

    fdata('cod_tipo_servico').Put(vcodigo);

    if inherited Post then
    begin
      Result := Apply;
      CommitaTransacao;
      with Auditor.Salvar.Sucesso do
      begin
      	SetChave(IntToStr(vcodigo));
      	GravarMensagem(fstr('descricao'));
      end;
      Refresh;
    end
    else
    begin
      Result := False;
      RollBackTransacao;
      with Auditor.Salvar.Falha do
      begin
      	SetChave(IntToStr(vcodigo));
      	GravarMensagem(fstr('descricao'));
      end;
    end;
  except on E: Exception do
    begin
      RollBackTransacao;
      Auditor.Salvar.Falha.GravarMensagem(fstr('descricao'));
      registraErro('TTipoTipoServ.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);    
    end;
  end;
end;

{ TProdutosFretePorPeso }

function TProdutosFretePorPeso.Apply: Boolean;
begin
  if not dataSet.Active then
  begin
    Result := True;
    Exit;
  end;   

  prepare_loop();
  try

    dataSet.Last;
    while not dataSet.Bof do
    begin
      if fint('id') <= 0 then
      begin
        dataSet.Edit;
        dataSet.FieldByName('GRUPO_PROD').AsInteger := Owner.fint('GRUPO_PROD');
        dataSet.FieldByName('COD_PROD').AsString := Owner.fstr('COD_PROD');
        dataSet.FieldByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        dataSet.FieldByName('ID').AsInteger := Gencodigo('PRODUTOS_FRETE_PESO', buscas, vDadosIni.codEmpresa);
        dataSet.Post;
      end;

      dataSet.Prior;
    end;

    if dataSet.ChangeCount > 0  then
      Result  := inherited Apply
    else
      Result := True;

  finally
    prepare_loop_done();
  end;
end;

constructor TProdutosFretePorPeso.Create(AOwner: TProdutos);
