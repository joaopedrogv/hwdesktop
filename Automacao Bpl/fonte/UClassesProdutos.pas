function TProdSimilares.LocProduto(grupoprod: integer; codprod: string;
  PSimilar: boolean; exibirmensagem: boolean): boolean;
begin
  codprod := trim(codprod);
  result := false;
  if codprod <> '' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select p.*, cb.cod_barra from produtos p ' +
    	' inner join cod_barra cb on p.grupo_prod=cb.grupo_prod and p.cod_prod=cb.cod_prod and p.cod_empresa=cb.cod_empresa ' +
      ' where p.grupo_prod =' + inttostr(grupoprod) +
      ' and p.cod_prod=' + quotedstr(codprod) +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1';
    buscas.Open;
    if PSimilar then
    begin
      if buscas.IsEmpty then
      begin
      	mensagemErro := 'Produto similar não Encontrado no Estoque' + chr(13) +
        	'Favor Verificar Cadastro de Estoque';
      	if exibirmensagem then
	        Application.MessageBox(PChar(mensagemErro), 'Atenção', MB_ICONWARNING + MB_OK);
        dataSet.FieldByName('GRUPO_PS').AsVariant := null;
        dataSet.FieldByName('COD_PS').AsVariant := null;
//        NumFabrProdSim := '';
        exit;
      end
      else
      begin
        dataSet.FieldByName('GRUPO_PS').Asinteger := buscas.FieldByName('GRUPO_PROD').asinteger;
        dataSet.FieldByName('COD_PS').AsString := buscas.FieldByName('COD_PROD').asstring;
        dataSet.FieldByName('DESCPSIM').AsString := buscas.FieldByName('DESCR_PROD').asstring;
        NumFabrProdSim := buscas.FieldByName('COD_BARRA').asstring;
      end;
    end
    else
    begin
      if buscas.IsEmpty then
      begin
      	mensagemErro := 'Produto não Encontrado no Estoque' + chr(13) +
        	'Favor Verificar Cadastro de Estoque';
      	if exibirmensagem then
          Application.MessageBox(PChar(mensagemErro), 'Atenção', MB_ICONWARNING + MB_OK);
        dataSet.FieldByName('GRUPO_PROD').AsVariant := null;
        dataSet.FieldByName('COD_PROD').AsVariant := null;
        DescrProd := '';
//        NumFabrProd := '';
        exit;
      end
      else
      begin
        dataSet.FieldByName('GRUPO_PROD').Asinteger := buscas.FieldByName('GRUPO_PROD').asinteger;
        dataSet.FieldByName('COD_PROD').AsString := buscas.FieldByName('COD_PROD').asstring;
        DescrProd := buscas.FieldByName('DESCR_PROD').asstring;
        NumFabrProd := buscas.FieldByName('COD_BARRA').asstring;
      end;
    end;

    if ((dataSet.State = dsEdit) and
      ((trim(dataSet.FieldByName('GRUPO_PROD').NewValue)) <>
      (trim(dataSet.FieldByName('GRUPO_PROD').OldValue)))
      or ((trim(dataSet.FieldByName('COD_PROD').NewValue)) <>
      (trim(dataSet.FieldByName('COD_PROD').OldValue)))
      or ((trim(dataSet.FieldByName('GRUPO_PS').NewValue)) <>
      (trim(dataSet.FieldByName('GRUPO_PS').OldValue)))
      or ((trim(dataSet.FieldByName('COD_PS').NewValue)) <>
      (trim(dataSet.FieldByName('COD_PS').OldValue))))
      or (dataSet.State = dsInsert) then
    begin
      if ExecutaComandosSql('Select * from PROD_SIMILARES ' +
        ' where GRUPO_PROD =' + inttostr(dataSet.FieldByName('GRUPO_PROD').asinteger) +
        ' and COD_PROD = ' + quotedstr(dataSet.FieldByName('COD_PROD').asstring) +
        ' and GRUPO_PS = ' + inttostr(dataSet.FieldByName('GRUPO_PS').asinteger) +
        ' and COD_PS =' + quotedstr(dataSet.FieldByName('COD_PS').asstring) +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa) then
      begin
      	mensagemErro := 'Produto similar já existe cadastrado.';
      	if exibirmensagem then
          Application.MessageBox(PChar(mensagemErro), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
        if PSimilar then
        begin
//          dataSet.FieldByName('GRUPO_PS').AsVariant := null;
//          dataSet.FieldByName('COD_PS').AsVariant := null;
//          dataSet.FieldByName('DESCPSIM').AsVariant := null;
//          NumFabrProdSim := '';
        end;
        exit;
      end;
    end;
  end;
  result := true;
end;

function TProdSimilares.LocProduto(pnumfabrica: string; PSimilar: boolean; grupoprod: Integer; cod_prod: string): boolean;
begin
	vPesqDescrProd := false;
	if PSimilar then
	  NumFabrProdSim := trim(pnumfabrica)
  else
		NumFabrProd := trim(pnumfabrica);
  pnumfabrica := trim(pnumfabrica);
  result := false;
  if pnumfabrica <> '' then
  begin
    buscas.Close;
    if (grupoprod > 0) or (trim(cod_prod) <> '') then
    	buscas.SQL.Text := 'select distinct p.*, ' +
      	' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
        ' where cb.cod_barra = ' + quotedstr(pnumfabrica) +
        ' and cb.grupo_prod = ' + IntToStr(grupoprod) +
        ' and cb.cod_prod = ' + QuotedStr(cod_prod) +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and p.ativo=1'
    else
      buscas.SQL.Text := 'select distinct p.*, ' +
      	' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
        ' where cb.cod_barra = ' + quotedstr(pnumfabrica) +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and p.ativo=1';
    buscas.Open;
    buscas.FetchAll;

    if buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select distinct p.*, ' +
      	' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
        ' where p.descr_prod like ' + QuotedStr(pnumfabrica + '%') +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and p.ativo=1 '+
        ' order by p.descr_prod ';
      buscas.Open;
      buscas.FetchAll;

      if not buscas.IsEmpty then
	    	vPesqDescrProd := true;
    end;

    if not buscas.IsEmpty then
      if buscas.RecordCount > 1 then
      begin
      	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
        TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
        TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
        TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
        TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
        if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
        begin
          Result := false;
          exit;
        end;
      end;

    if PSimilar then
    begin
      if buscas.IsEmpty then
      begin
        Application.MessageBox(PChar('Produto não Encontrado no Estoque' + chr(13) +
          'Favor Verificar Cadastro de Estoque'), 'Atenção', MB_ICONWARNING + MB_OK);
        dataSet.FieldByName('GRUPO_PS').AsVariant := null;
        dataSet.FieldByName('COD_PS').AsVariant := null;
        dataSet.FieldByName('DESCPSIM').AsVariant := null;
//        NumFabrProdSim := '';
        exit;
      end
      else
      begin
        dataSet.FieldByName('GRUPO_PS').Asinteger := buscas.FieldByName('GRUPO_PROD').asinteger;
        dataSet.FieldByName('COD_PS').AsString := buscas.FieldByName('COD_PROD').asstring;
        dataSet.FieldByName('DESCPSIM').AsString := buscas.FieldByName('DESCR_PROD').asstring;
        NumFabrProdSim := IfThen(vPesqDescrProd,
        	buscas.FieldByName('NUM_FAB_PROD').asstring, pnumfabrica);
      end;
    end
    else
    begin
      if buscas.IsEmpty then
      begin
        Application.MessageBox(PChar('Produto não Encontrado no Estoque' + chr(13) +
          'Favor Verificar Cadastro de Estoque'), 'Atenção', MB_ICONWARNING + MB_OK);
        dataSet.FieldByName('GRUPO_PROD').AsVariant := null;
        dataSet.FieldByName('COD_PROD').AsVariant := null;
        DescrProd := '';
//        NumFabrProd := '';
        exit;
      end
      else
      begin
        dataSet.FieldByName('GRUPO_PROD').Asinteger := buscas.FieldByName('GRUPO_PROD').asinteger;
        dataSet.FieldByName('COD_PROD').AsString := buscas.FieldByName('COD_PROD').asstring;
        DescrProd := buscas.FieldByName('DESCR_PROD').asstring;
        NumFabrProd := IfThen(vPesqDescrProd,
        	buscas.FieldByName('NUM_FAB_PROD').asstring, pnumfabrica);

        result := true;
      end;
    end;

    if ((dataSet.State = dsEdit) and
      ((trim(dataSet.FieldByName('GRUPO_PROD').NewValue)) <>
      (trim(dataSet.FieldByName('GRUPO_PROD').OldValue)))
      or ((trim(dataSet.FieldByName('COD_PROD').NewValue)) <>
      (trim(dataSet.FieldByName('COD_PROD').OldValue)))
      or ((trim(dataSet.FieldByName('GRUPO_PS').NewValue)) <>
      (trim(dataSet.FieldByName('GRUPO_PS').OldValue)))
      or ((trim(dataSet.FieldByName('COD_PS').NewValue)) <>
      (trim(dataSet.FieldByName('COD_PS').OldValue))))
      or (dataSet.State = dsInsert) then
    begin
      if ExecutaComandosSql('Select * from PROD_SIMILARES ' +
        ' where GRUPO_PROD =' + inttostr(dataSet.FieldByName('GRUPO_PROD').asinteger) +
        ' and COD_PROD = ' + quotedstr(dataSet.FieldByName('COD_PROD').asstring) +
        ' and GRUPO_PS = ' + inttostr(dataSet.FieldByName('GRUPO_PS').asinteger) +
        ' and COD_PS =' + quotedstr(dataSet.FieldByName('COD_PS').asstring) +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa) then
      begin
        Application.MessageBox('Produto similar já existe cadastrado.', 'Atenção', MB_OK +
          MB_ICONWARNING +
          MB_DEFBUTTON1);
        if PSimilar then
        begin
//          dataSet.FieldByName('GRUPO_PS').AsVariant := null;
//          dataSet.FieldByName('COD_PS').AsVariant := null;
//          dataSet.FieldByName('DESCPSIM').AsVariant := null;
//          NumFabrProdSim := '';
        end;
        exit;
      end;
    end;
  end;
  Result := true;
end;

function TProdSimilares.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('PRO145', 'SALVAR', '', 'PROD_SIMILARES',
      '', buscas, true) then
      exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if (dataSet.FieldByName('GRUPO_PROD').AsInteger <= 0)
    	or (trim(dataSet.FieldByName('COD_PROD').AsString) = '') then
    	raiseExceptionCreate('Produto deve ser informada.', 'EditNumFab');

    if not LocProduto(dataSet.FieldByName('GRUPO_PROD').AsInteger,
      dataSet.FieldByName('COD_PROD').asstring, false, false) then
	    raiseExceptionCreate(mensagemErro, 'EditNumFab');  

    if trim(dataSet.FieldByName('DESCPSIM').AsString) = '' then
    	raiseExceptionCreate('Produto similar deve ser informada.', 'EditNumFabSim');

    if not LocProduto(dataSet.FieldByName('GRUPO_PS').AsInteger,
      dataSet.FieldByName('COD_PS').asstring, true, false) then
	    raiseExceptionCreate(mensagemErro, 'EditNumFabSim');

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;
    if Apply then
    begin
      CommitaTransacao;
      result := True;
    end
    else
    begin
    	Cancel;
      RollBackTransacao;
      Result := False;
    end;

    if Result then
      vDadosIni.Auditoria('PRO145', acao, 'SUCESSO - ' +
        'Gr Prod: ' + dataSet.FieldByName('GRUPO_PROD').asstring +
        ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').asstring +
        ' Gr Ps: ' + dataSet.FieldByName('GRUPO_PS').asstring +
        ' Cod Ps: ' + dataSet.FieldByName('COD_PS').asstring, 'PROD_SIMILARES', '')
    else
      vDadosIni.Auditoria('PRO145', acao, 'FALHA - ' +
      	'Gr Prod: ' + dataSet.FieldByName('GRUPO_PROD').asstring +
        ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').asstring +
        ' Gr Ps: ' + dataSet.FieldByName('GRUPO_PS').asstring +
        ' Cod Ps: ' + dataSet.FieldByName('COD_PS').asstring, 'PROD_SIMILARES', '');
        
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

