procedure TEtiquetasTermicas.addItem(pCodigo: string);
var
  fOldGrupo, i: integer;
  fOldCodigo: string;
  vHouveInclusao: Boolean;
  vrecno: Integer;
  CodGradeTmp: Integer;
begin
  vHouveInclusao := False;
  
  vrecno := fGrade.RecNo;
  fGrade.First;
  while not fGrade.Eof do
  begin
    if fGrade.FieldByName('qtde').AsInteger > 0 then
    begin
      if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
      begin
        fBuscas2.Close;
        fBuscas2.SQL.Text := ' select * from produtos ' +
        	' where ativo = 1 ' +
          ' and cod_prod = ' + QuotedStr(pCodigo) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        fBuscas2.Open;
        fOldGrupo := fBuscas2.FieldByName('grupo_prod').AsInteger;
        fOldCodigo := fBuscas2.FieldByName('cod_prod').AsString;
      end
      else
      begin
        fBuscas2.Close;
        fBuscas2.SQL.Text := 'select grupo_prod, cod_prod from cod_barra' +
          ' where cod_barra = ' + QuotedStr(pCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
        fBuscas2.Open;
        fOldGrupo := fBuscas2.FieldByName('grupo_prod').AsInteger;
        fOldCodigo := fBuscas2.FieldByName('cod_prod').AsString;

        fBuscas2.Close;
        fBuscas2.SQL.Text := 'select * from produtos ' +
          ' where ativo = 1 ' +
          ' and grupo_prod = ' + IntToStr(fOldGrupo) +
          ' and cod_prod = ' + QuotedStr(fOldCodigo) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        fBuscas2.Open;
      end;
      if not fBuscas2.IsEmpty then
      begin
        vHouveInclusao := True;

        fEtiquetaT.Insert;
        for i := 0 to fBuscas2.Fields.Count - 1 do
        begin
          if fEtiquetaT.Fields.FindField(fBuscas2.Fields[I].FieldName) is TField then
            if fEtiquetaT.Fields.FindField(fBuscas2.Fields[I].FieldName).Name =
              fBuscas2.Fields[I].Name then
              fEtiquetaT.FieldByName(fBuscas2.Fields[I].FieldName).Value :=
                fBuscas2.Fields[I].Value;
        end;

        fEtiquetaT.FieldByName('BARCODE').AsString :=
          vDadosIni.retornaCodBarraEtiqueta(
            fBuscas2,
            fBuscas2.FieldByName('GRUPO_PROD').AsInteger,
            fBuscas2.FieldByName('COD_PROD').AsString,
            fGrade.FieldByName('COD_GRADE').AsInteger,
            fBuscas2.FieldByName('NUM_FAB_PROD').AsString);

        fEtiquetaT.FieldByName('BARCODE_EAN').AsString :=
          vDadosIni.retornaCodBarraEtiqueta(
            fBuscas2,
            fBuscas2.FieldByName('GRUPO_PROD').AsInteger,
            fBuscas2.FieldByName('COD_PROD').AsString,
            fGrade.FieldByName('COD_GRADE').AsInteger,
            fBuscas2.FieldByName('NUM_FAB_PROD').AsString,
            False,
            True);

//        if (fGrade.FieldByName('cod_grade').AsInteger > 0) then
//        begin
//          if (vDadosIni.vEmp.vDigitosEmp = 2) or (vDadosIni.vEmp.vDigitosEmp = 1) then
//            fEtiquetaT.FieldByName('BARCODE').AsString :=
//              'G-' + vDadosIni.StrZero(vDadosIni.CodEmpresa, vDadosIni.vEmp.vDigitosEmp) +
//              vDadosIni.StrZero(fBuscas2.FieldByName('GRUPO_PROD').AsString,
//              vDadosIni.vEmp.vDidgitosGrup) +
//              trim(fBuscas2.FieldByName('COD_PROD').AsString) +
//              fGrade.FieldByName('cod_grade').AsString
//          else
//            fEtiquetaT.FieldByName('BARCODE').AsString :=
//              'G-' + vDadosIni.StrZero(fBuscas2.FieldByName('GRUPO_PROD').AsString,
//              vDadosIni.vEmp.vDidgitosGrup) +
//              trim(fBuscas2.FieldByName('COD_PROD').AsString) +
//              fGrade.FieldByName('COD_GRADE').AsString;
//        end
//        else
//          fEtiquetaT.FieldByName('BARCODE').AsString :=
//            trim(fBuscas2.FieldByName('NUM_FAB_PROD').AsString);

        fEtiquetaT.FieldByName('cod_grade').AsInteger := fGrade.FieldByName('cod_grade').AsInteger;
        fEtiquetaT.FieldByName('DESCRICAO').AsString := fGrade.FieldByName('DESCRICAO').AsString;
        fEtiquetaT.FieldByName('DESCRICAO1').AsString := fGrade.FieldByName('DESCRICAO1').AsString;
        fEtiquetaT.FieldByName('QTDE').AsInteger := fGrade.FieldByName('QTDE').AsInteger;
        fEtiquetaT.Post;

        if (fGrade.FieldByName('cod_grade').AsInteger > 0) then
        begin
          fBuscas2.Close;
          fBuscas2.SQL.Text := 'select first 1 cgp.cod_grade from cod_grade_prod cgp' +
            ' inner join grade g on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa' +
            ' where cgp.grupo_prod = ' + IntToStr(fOldGrupo) +
            ' and cgp.cod_prod = ' + QuotedStr(trim(fOldCodigo)) +
            ' and cgp.cod_grade = ' + IntToStr(fGrade.FieldByName('cod_grade').AsInteger) +
            ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa;
          fBuscas2.Open;
          if fBuscas2.IsEmpty then
          begin
            try
              fBuscas2.Close;
              fBuscas2.SQL.Text :=
                'INSERT INTO COD_GRADE_PROD (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA, QTDE, ATIVO) ' +
                ' VALUES (' + IntToStr(fOldGrupo) +
                ' , ' + QuotedStr(trim(fOldCodigo)) +
                ' , ' + IntToStr(fGrade.FieldByName('cod_grade').AsInteger) +
                ' , ' + vDadosIni.codEmpresa +
                ' , 0, 1)';
              fBuscas2.Prepare;
              fBuscas2.ExecSQL;
            finally
              CommitaTransacao;
            end;
          end;
        end;
      end;
    end;
    fGrade.Next;
  end;
  if not vHouveInclusao then
  begin
    if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
    begin
      fBuscas2.Close;
      fBuscas2.SQL.Text := 'select * from produtos ' +
        ' where ativo = 1 ' +
        ' and cod_prod = ' + QuotedStr(pCodigo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      fBuscas2.Open;
    end
    else
    begin
      fBuscas2.Close;
      fBuscas2.SQL.Text := 'select grupo_prod, cod_prod from cod_barra' +
        ' where cod_barra = ' + QuotedStr(pCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
      fBuscas2.Open;
      fOldGrupo := fBuscas2.FieldByName('grupo_prod').AsInteger;
      fOldCodigo := fBuscas2.FieldByName('cod_prod').AsString;

      fBuscas2.Close;
      fBuscas2.SQL.Text := 'select * from produtos ' +
        ' where ativo = 1 ' +
        ' and grupo_prod = ' + IntToStr(fOldGrupo) +
        ' and cod_prod = ' + QuotedStr(fOldCodigo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      fBuscas2.Open;
    end;
    if not fBuscas2.IsEmpty then
    begin
      vHouveInclusao := True;

      fEtiquetaT.Insert;
      for i := 0 to fBuscas2.Fields.Count - 1 do
      begin
        if fEtiquetaT.Fields.FindField(fBuscas2.Fields[I].FieldName) is TField then
          if fEtiquetaT.Fields.FindField(fBuscas2.Fields[I].FieldName).Name = fBuscas2.Fields[I].Name
            then
            fEtiquetaT.FieldByName(fBuscas2.Fields[I].FieldName).Value := fBuscas2.Fields[I].Value;
      end;

      fEtiquetaT.FieldByName('BARCODE').AsString :=
        vDadosIni.retornaCodBarraEtiqueta(
          fBuscas2,
          fBuscas2.FieldByName('GRUPO_PROD').AsInteger,
          fBuscas2.FieldByName('COD_PROD').AsString,
          0,
          fBuscas2.FieldByName('NUM_FAB_PROD').AsString);

      fEtiquetaT.FieldByName('BARCODE_EAN').AsString :=
        vDadosIni.retornaCodBarraEtiqueta(
          fBuscas2,
          fBuscas2.FieldByName('GRUPO_PROD').AsInteger,
          fBuscas2.FieldByName('COD_PROD').AsString,
          0,
          fBuscas2.FieldByName('NUM_FAB_PROD').AsString,
          False,
          True);

      fEtiquetaT.FieldByName('cod_grade').AsInteger := 0;
      fEtiquetaT.FieldByName('DESCRICAO').AsString := 'SEM GRADE';
      fEtiquetaT.FieldByName('DESCRICAO1').AsString := 'SEM GRADE';
      if (fGrade.FieldByName('DESCRICAO').AsString = 'SEM GRADE') and
        (fGrade.FieldByName('QTDE').AsInteger > 0) then
        fEtiquetaT.FieldByName('QTDE').AsInteger := fGrade.FieldByName('QTDE').AsInteger
      else fEtiquetaT.FieldByName('QTDE').AsInteger := 1;
      fEtiquetaT.Post;

    end;

  end;

  if vHouveInclusao then
  begin
    buscas.Close;
    buscas.SQL.Text := 'update config_sistema set value1_vc = null' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and chave = ' + QuotedStr('prcss_montar_estoque_diario_30_12_1899') +
      ' and value1_vc is not null';
    buscas.ExecSQL;
    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    try
       fGrade.Refresh;
    finally
       if fGrade.RecordCount >= vrecno then
         fGrade.RecNo := vrecno;
    end;
//     fGrade.Close;
//     fGrade.Open;
  end;
end;

