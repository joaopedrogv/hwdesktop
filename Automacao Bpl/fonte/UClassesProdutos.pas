function TNBM.aplicarValoresNcmMercadorias(
  AmanutNCM: TNBM_ManutencaoDados): Boolean;
var
  AlistEmp: array of Integer;
  I: Integer;
  Asql, AempSql: string;
begin
  Result := True;
  try
    try
      if (not AmanutNCM.check_ncm) and (not AmanutNCM.check_mercadorias) then
        raise Exception.Create('Por favor marque onde deseja aplicar os dados (NCMS e Mercadorias)');

      if (AmanutNCM.listNCM.Count = 0) then
        raise Exception.Create('Nenhum NCM selecionado');
      
      vDadosIni.abreStatusProcessamento('Processamento ' + IfThen(AmanutNCM.check_ncm and AmanutNCM.check_mercadorias, '1 de 2', '1 de 1'),
                                        'Inicializado');

      SetLength(AlistEmp, 1);
      if Trim(SqlOpen('select tabela from TAB_REP where tabela = ''PRODUTOS''').FieldByName('tabela').AsString) = 'PRODUTOS' then
      begin
        SqlOpen('select cod_empresa from empresa where cod_empresa <> ' + vDadosIni.codEmpresa).FetchAll;
        SetLength(AlistEmp, buscas.RecordCount + 1);
        I := 0;

        buscas.First;
        while not buscas.Eof do
        begin
          AlistEmp[I] := buscas.FieldByName('cod_empresa').AsInteger;
          I := I + 1;
          buscas.Next;
        end;
      end;
      AlistEmp[High(AlistEmp)] := StrToInt(vDadosIni.codEmpresa);

      with AmanutNCM do
        for I := 0 to AmanutNCM.listNCM.Count - 1 do
          AmanutNCM.listNCM.Items[I].referencia := 'ncm=' + AmanutNCM.listNCM.Items[I].cod_ncm + ','+
                   IfThen(check_mva                     , Format('mva=%f', [dadosNCM.mva]) + ',') +
                   IfThen(check_mva_inter               , Format('mva_inter=%f', [dadosNCM.mva_inter]) + ',') +
                   IfThen(check_aliq_intra              , Format('aliq_intra=%f', [dadosNCM.aliq_intra]) + ',') +
                   IfThen(check_cst_piscofins           , Format('cst_pis=%s', [dadosNCM.cst_pis]) + ',') +
                   IfThen(check_cst_piscofins           , Format('cst_cofins=%s', [dadosNCM.cst_cofins]) + ',') +
                   IfThen(check_cst_piscofins_ent       , Format('cst_pis_ent=%s', [dadosNCM.cst_pis_ent]) + ',') +
                   IfThen(check_cst_piscofins_ent       , Format('cst_cofins_ent=%s', [dadosNCM.cst_cofins_ent]) + ',') +
                   IfThen(check_aliq_pis_diferenciada   , Format('aliq_pis_diferenciada=%f', [dadosNCM.aliq_pis_diferenciada]) + ',') +
                   IfThen(check_aliq_cofins_diferenciada, Format('aliq_cofins_diferenciada=%f', [dadosNCM.aliq_cofins_diferenciada]) + ',') +
                   IfThen(check_nat_rec                 , Format('nat_rec=%s', [dadosNCM.nat_rec]) + ',') +
                   IfThen(check_aliq_cred_pis           , Format('aliq_cred_pis=%f', [dadosNCM.aliq_cred_pis]) + ',') +
                   IfThen(check_aliq_cred_cofins        , Format('aliq_cred_cofins=%f', [dadosNCM.aliq_cred_cofins]) + ',') +
                   IfThen(check_cenq_ipi_nfe            , Format('cenq_ipi_nfe=%s', [dadosNCM.cenq_ipi_nfe]) + ',') +
                   IfThen(check_cest                    , Format('cest=%s', [dadosNCM.cest]) + ',') +
                   IfThen(check_fcp_aliq                , Format('fcp_aliq=%f', [dadosNCM.fcp_aliq]) + ',');

      //NCM
      if AmanutNCM.check_ncm then
      begin
        with AmanutNCM do
          Asql := 'update nbm set' + IfThen(check_mva                     , ' mva = :mva,') +
                                     IfThen(check_mva_inter               , ' mva_inter = :mva_inter,') +
                                     IfThen(check_aliq_intra              , ' aliq_intra = :aliq_intra,') +
                                     IfThen(check_cst_piscofins           , ' cst_pis = :cst_pis,') +
                                     IfThen(check_cst_piscofins           , ' cst_cofins = :cst_cofins,') +
                                     IfThen(check_cst_piscofins_ent       , ' cst_pis_ent = :cst_pis_ent,') +
                                     IfThen(check_cst_piscofins_ent       , ' cst_cofins_ent = :cst_cofins_ent,') +
                                     IfThen(check_aliq_pis_diferenciada   , ' aliq_pis_diferenciada = :aliq_pis_diferenciada,') +
                                     IfThen(check_aliq_cofins_diferenciada, ' aliq_cofins_diferenciada = :aliq_cofins_diferenciada,') +
                                     IfThen(check_nat_rec                 , ' nat_rec = :nat_rec,') +
                                     IfThen(check_aliq_cred_pis           , ' aliq_cred_pis = :aliq_cred_pis,') +
                                     IfThen(check_aliq_cred_cofins        , ' aliq_cred_cofins = :aliq_cred_cofins,') +
                                     IfThen(check_cenq_ipi_nfe            , ' cenq_ipi_nfe = :cenq_ipi_nfe,') +
                                     IfThen(check_cest                    , ' cest = :cest,') +
                                     IfThen(check_fcp_aliq                , ' fcp_aliq = :fcp_aliq,');
        if Pos(':', Asql) <= 0 then
          raise Exception.Create('Não foi marcado nenhum campo para alteração');

        Asql := Copy(Asql, 1, Length(Asql) - 1) + ' where cod_ncm = :cod_ncm';

        buscas.Close;
        buscas.SQL.Text := Asql;

        for I := 0 to AmanutNCM.listNCM.Count - 1 do
        begin
          vDadosIni.abreStatusProcessamento('', Format('Aplicando no cadastro de NCM %d de %d', [(I + 1), AmanutNCM.listNCM.Count]));

          buscas.ParamByName('cod_ncm').AsString := AmanutNCM.listNCM.Items[I].cod_ncm;
          with AmanutNCM do
          begin
            if check_mva                      then buscas.ParamByName('mva').AsFloat                      := dadosNCM.mva;
            if check_mva_inter                then buscas.ParamByName('mva_inter').AsFloat                := dadosNCM.mva_inter;
            if check_aliq_intra               then buscas.ParamByName('aliq_intra').AsFloat               := dadosNCM.aliq_intra;
            if check_cst_piscofins            then buscas.ParamByName('cst_pis').AsString                 := Trim(dadosNCM.cst_pis);
            if check_cst_piscofins            then buscas.ParamByName('cst_cofins').AsString              := Trim(dadosNCM.cst_cofins);
            if check_cst_piscofins_ent        then buscas.ParamByName('cst_pis_ent').AsString             := Trim(dadosNCM.cst_pis_ent);
            if check_cst_piscofins_ent        then buscas.ParamByName('cst_cofins_ent').AsString          := Trim(dadosNCM.cst_cofins_ent);
            if check_aliq_pis_diferenciada    then buscas.ParamByName('aliq_pis_diferenciada').AsFloat    := dadosNCM.aliq_pis_diferenciada;
            if check_aliq_cofins_diferenciada then buscas.ParamByName('aliq_cofins_diferenciada').AsFloat := dadosNCM.aliq_cofins_diferenciada;
            if check_nat_rec                  then buscas.ParamByName('nat_rec').AsString                 := Trim(dadosNCM.nat_rec);
            if check_aliq_cred_pis            then buscas.ParamByName('aliq_cred_pis').AsFloat            := dadosNCM.aliq_cred_pis;
            if check_aliq_cred_cofins         then buscas.ParamByName('aliq_cred_cofins').AsFloat         := dadosNCM.aliq_cred_cofins;
            if check_cenq_ipi_nfe             then buscas.ParamByName('cenq_ipi_nfe').AsString            := Trim(dadosNCM.cenq_ipi_nfe);
            if check_cest                     then buscas.ParamByName('cest').AsString                    := Trim(dadosNCM.cest);
            if check_fcp_aliq                 then buscas.ParamByName('fcp_aliq').AsFloat                 := dadosNCM.fcp_aliq;

            if not buscas.Prepared then
              buscas.Prepare;

            buscas.ExecSQL;
          end;
        end;
      end;

      //PRODUTOS
      if AmanutNCM.check_mercadorias then
      begin
        vDadosIni.abreStatusProcessamento('Processamento ' + IfThen(AmanutNCM.check_ncm and AmanutNCM.check_mercadorias, '2 de 2', '1 de 1'),
                                          'Inicializado');

        with AmanutNCM do
          Asql := 'update produtos set rep_int_active = 1, ' +
                                          IfThen(check_aliq_intra              , ' icm_prod = :icm_prod,') +
                                          IfThen(check_cst_piscofins           , ' cst_pis = :cst_pis,') +
                                          IfThen(check_cst_piscofins           , ' cst_cofins = :cst_cofins,') +
                                          IfThen(check_cst_piscofins_ent       , ' cst_pis_ent = :cst_pis_ent,') +
                                          IfThen(check_cst_piscofins_ent       , ' cst_cofins_ent = :cst_cofins_ent,') +
                                          IfThen(check_aliq_pis_diferenciada   , ' aliq_pis_diferenciada = :aliq_pis_diferenciada,') +
                                          IfThen(check_aliq_cofins_diferenciada, ' aliq_cofins_diferenciada = :aliq_cofins_diferenciada,') +
                                          IfThen(check_nat_rec                 , ' nat_rec = :nat_rec,') +
                                          IfThen(check_aliq_cred_pis           , ' aliq_cred_pis = :aliq_cred_pis,') +
                                          IfThen(check_aliq_cred_cofins        , ' aliq_cred_cofins = :aliq_cred_cofins,') +
                                          IfThen(check_cenq_ipi_nfe            , ' cenq_ipi_nfe = :cenq_ipi_nfe,') +
                                          IfThen(check_cest                    , ' cest = :cest,') +
                                          IfThen(check_fcp_aliq                , ' fcp_aliq = :fcp_aliq,');
        if Pos(':', Asql) <= 0 then
          if not AmanutNCM.check_ncm then
            raise Exception.Create('Não foi marcado nenhum campo das mercadorias para alteração')
          else
            AmanutNCM.check_mercadorias := False;

        if AmanutNCM.check_mercadorias then
        begin
          AempSql := '';
          for I := Low(AlistEmp) to High(AlistEmp) do
            AempSql := AempSql + IfThen(AempSql <> '', ',') + IntToStr(AlistEmp[I]);

          Asql := Copy(Asql, 1, Length(Asql) - 1) + ' where nbm = :nbm and cod_empresa in (' + AempSql + ')';

          buscas.Close;
          buscas.SQL.Text := Asql;

          for I := 0 to AmanutNCM.listNCM.Count - 1 do
          begin
            vDadosIni.abreStatusProcessamento('', Format('Aplicando no cadastro de Produtos %d de %d', [(I + 1), AmanutNCM.listNCM.Count]));

            buscas.ParamByName('nbm').AsString := AmanutNCM.listNCM.Items[I].cod_ncm;
            with AmanutNCM do
            begin
              if check_aliq_intra               then buscas.ParamByName('icm_prod').AsFloat                 := dadosNCM.aliq_intra;
              if check_cst_piscofins            then buscas.ParamByName('cst_pis').AsString                 := dadosNCM.cst_pis;
              if check_cst_piscofins            then buscas.ParamByName('cst_cofins').AsString              := dadosNCM.cst_cofins;
              if check_cst_piscofins_ent        then buscas.ParamByName('cst_pis_ent').AsString             := dadosNCM.cst_pis_ent;
              if check_cst_piscofins_ent        then buscas.ParamByName('cst_cofins_ent').AsString          := dadosNCM.cst_cofins_ent;
              if check_aliq_pis_diferenciada    then buscas.ParamByName('aliq_pis_diferenciada').AsFloat    := dadosNCM.aliq_pis_diferenciada;
              if check_aliq_cofins_diferenciada then buscas.ParamByName('aliq_cofins_diferenciada').AsFloat := dadosNCM.aliq_cofins_diferenciada;
              if check_nat_rec                  then buscas.ParamByName('nat_rec').AsString                 := dadosNCM.nat_rec;
              if check_aliq_cred_pis            then buscas.ParamByName('aliq_cred_pis').AsFloat            := dadosNCM.aliq_cred_pis;
              if check_aliq_cred_cofins         then buscas.ParamByName('aliq_cred_cofins').AsFloat         := dadosNCM.aliq_cred_cofins;
              if check_cenq_ipi_nfe             then buscas.ParamByName('cenq_ipi_nfe').AsString            := dadosNCM.cenq_ipi_nfe;
              if check_cest                     then buscas.ParamByName('cest').AsString                    := dadosNCM.cest;
              if check_fcp_aliq                 then buscas.ParamByName('fcp_aliq').AsFloat                 := dadosNCM.fcp_aliq;

              if not buscas.Prepared then
                buscas.Prepare;

              buscas.ExecSQL;
            end;
          end;
        end;
      end;
      
      if buscas.Transaction.InTransaction then
      begin
        buscas.Transaction.Commit;

        if AmanutNCM.check_ncm then
          for I := 0 to AmanutNCM.listNCM.Count - 1 do
            vDadosIni.GravaAuditoria('PRO171', 'EDITAR', 'TAB=NCM,' + AmanutNCM.listNCM.Items[I].referencia, 'PRODUTOS', '', buscas);

        if AmanutNCM.check_mercadorias then
          for I := 0 to AmanutNCM.listNCM.Count - 1 do
            vDadosIni.GravaAuditoria('PRO171', 'EDITAR', 'TAB=PROD,' + AmanutNCM.listNCM.Items[I].referencia, 'PRODUTOS', '', buscas);

        vDadosIni.ShowAtencao('Dados alterados com sucesso');

      end;

    except on E: Exception do
      begin
        RollBackTransacao;
        Result := False;
        vDadosIni.ShowErro('Erro ao aplicar dados fiscais. ' + e.Message);
      end;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

constructor TNBM.create;
begin
  DataSet := TClientDataSet(DtmProdutos.cdsNBM);
  transacao := TIBTransaction(DtmProdutos.IBTransNBM);
  Buscas := TIBQuery(DtmProdutos.qrBuscasNBM);
  NbmUF := TNbmUF.Create;
