  HandleMarkupMargemCalculados;
end;

procedure TProdutos.HandleAlteracaoMarkupAtacado;
var
  preco, margem, markup, markupTmp: Double;
begin

  markup := ffloat('perc_tb_proda', -2);

  dataSet.FieldByName('perc_tb_proda').AsFloat  := IfThen(markup > 0, markup); // MARKUP

  if (vDadosIni.vEmp.vALT_PERC_MARGEM = 'S') and (ffloat('prec_cusm_prod') > 0) and (markup > 0) then
  begin

    preco := RoundTo(ffloat('prec_cusm_prod') * (1 + markup / 100), 0 - vDadosIni.vEmp.vCasasDecimais);
    margem := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);

    markupTmp := RoundTo((preco / ffloat('prec_cusm_prod') - 1) * 100, -2);
    if markupTmp < markup then
      preco := preco + 0.01;

    dataSet.FieldByName('prec_publico').AsFloat   := preco;  // PRECO
    dataSet.FieldByName('margem_a_desej').AsFloat := margem; // MARGEM

  end;

  HandleMarkupMargemCalculados;
end;

procedure TProdutos.HandleAlteracaoMarkupVarejo;
var
  preco, margem, markup, markupTmp: Double;
begin

  markup := ffloat('perc_tb_prod', -2);

  dataSet.FieldByName('perc_tb_prod').AsFloat  := IfThen(markup > 0, markup); // MARKUP

  if (vDadosIni.vEmp.vALT_PERC_MARGEM = 'S') and (ffloat('prec_cusm_prod') > 0) and (markup > 0) then
  begin

    preco := RoundTo(ffloat('prec_cusm_prod') * (1 + markup / 100), 0 - vDadosIni.vEmp.vCasasDecimais);
    margem := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);

    markupTmp := RoundTo((preco / ffloat('prec_cusm_prod') - 1) * 100, -2);
    if markupTmp < markup then
      preco := preco + 0.01;

    dataSet.FieldByName('prec_tab_prod').AsFloat  := preco;  // PRECO
    dataSet.FieldByName('margem_v_desej').AsFloat := margem; // MARGEM

  end;

  HandleAlteracaoPercentualAd_30;
  HandleAlteracaoPercentualAd_60;
  HandleAlteracaoPercentualAd_90;
  HandleMarkupMargemCalculados;
end;

