function TProdutosRastro.JaExisteItem(vGrupoProd: integer; vCodProd: string;
  usarCodbarra: boolean): boolean;
begin
	prodDiferente := false;
  Result := false;
  if usarCodbarra then
  begin
    if (dataSet.State = dsEdit) and (trim(dataSet.FieldByName('NUM_FAB_PROD').NewValue) = trim(dataSet.FieldByName('NUM_FAB_PROD').OldValue)) then
    begin
      Result := true;
      exit;
    end
    else if (dataSet.State = dsEdit) and (trim(dataSet.FieldByName('NUM_FAB_PROD').NewValue) <> trim(dataSet.FieldByName('NUM_FAB_PROD').OldValue)) then
      prodDiferente := true;
  end
  else
  begin
    if (dataSet.State = dsEdit) and
      (trim(dataSet.FieldByName('GRUPO_PROD').NewValue) = trim(dataSet.FieldByName('GRUPO_PROD').OldValue))
      and (trim(dataSet.FieldByName('COD_PROD').NewValue) = trim(dataSet.FieldByName('COD_PROD').OldValue)) then
    begin
      Result := true;
      exit;
    end
    else if (dataSet.State = dsEdit) and
      ((trim(dataSet.FieldByName('GRUPO_PROD').NewValue) <> trim(dataSet.FieldByName('GRUPO_PROD').OldValue))
      or (trim(dataSet.FieldByName('COD_PROD').NewValue) <> trim(dataSet.FieldByName('COD_PROD').OldValue))) then
      prodDiferente := true;
  end;
  dataSet.Cancel;
  try
  	dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      if (trim(vCodProd) = trim(dataSet.FieldByName('COD_PROD').AsString)) and
        (vGrupoProd = dataSet.FieldByName('GRUPO_PROD').Asinteger) then
      begin
        if not modoEdit then
          Application.MessageBox(Pchar('Produto duplicado.' + chr(13) + 'Altere o registro se assim desejar.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        Result := true;
        exit;
      end;
      dataSet.Next;
    end;
  finally
    dataSet.EnableControls;
  end;
  prodDiferente := false;
end;

function TProdutosRastro.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('MOB008', 'SALVAR',
      'LOTE ' + trim(dataSet.FieldByName('NLOTE').AsString) +
    	' CLI ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger),
      'PRODUTOS_RASTRO',
      dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
      dataSet.FieldByName('COD_PROD').AsString + '-' +
      dataSet.FieldByName('COD_GRADE').AsString, buscas, true) then
      	Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

		if trim(dataSet.FieldByName('GRUPO_PROD').AsString) = '' then
      raiseExceptionCreate('Produto deve ser informado', 'DBEditNumFabProd');

    if trim(dataSet.FieldByName('COD_PROD').AsString) = '' then
      raiseExceptionCreate('Produto deve ser informado', 'DBEditNumFabProd');

    if trim(dataSet.FieldByName('COD_GRADE').AsString) = '' then
      raiseExceptionCreate('Grade deve ser informado', 'DBEditNumFabProd');

    if trim(dataSet.FieldByName('NLOTE').AsString) = '' then
      raiseExceptionCreate('Número do lote deve ser informado', 'DBEditNumLote');

    if dataSet.FieldByName('QLOTE').AsFloat <= 0 then
      raiseExceptionCreate('Quantidade do lote deve ser informado', 'DBEditQtdeLote');

    if trim(dataSet.FieldByName('DFAB').AsString) = '' then
      raiseExceptionCreate('Data de fabricação lote deve ser informado', 'DBEditDataFabricante');

    if trim(dataSet.FieldByName('DVAL').AsString) = '' then
      raiseExceptionCreate('Data de validade lote deve ser informado', 'DBEditDataValidade');

    if dataSet.FieldByName('QTDE_COMPRA').AsFloat <= 0 then
    	raiseExceptionCreate('Quantidade de compra deve ser informado', 'DBEditQtdeCompra');

    if dataSet.FieldByName('COD_CLIENTE').AsInteger <= 0 then
    	raiseExceptionCreate('Fornecedor deve ser informado', 'DBEditCodCliente');

    if acao = 'INSERIR' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select ' +
      	' GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA, NLOTE, COD_CLIENTE from PRODUTOS_RASTRO ' +
        ' where GRUPO_PROD = :GRUPO_PROD ' +
        ' and COD_PROD = :COD_PROD ' +
        ' and COD_GRADE = :COD_GRADE ' +
        ' and COD_EMPRESA = :COD_EMPRESA ' +
        ' and NLOTE = :NLOTE ' +
        ' and COD_CLIENTE = :COD_CLIENTE ';
      buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
      buscas.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
      buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ParamByName('NLOTE').AsString := dataSet.FieldByName('NLOTE').AsString;
      buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        raiseExceptionCreate('Já existe uma locação para esse produto/lote/fornecedor deve ser informado', 'DBEditDataValidade');
        exit;
      end;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('MOB008', acao, 'SUCESSO - '+
      	' LOTE ' + trim(dataSet.FieldByName('NLOTE').AsString) +
    		' CLI ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger),
        'PRODUTOS_RASTRO',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        dataSet.FieldByName('COD_PROD').AsString + '-' +
        dataSet.FieldByName('COD_GRADE').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('MOB008', acao, 'FALHA - ' +
      	' LOTE ' + trim(dataSet.FieldByName('NLOTE').AsString) +
    		' CLI ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger),
       	'PRODUTOS_RASTRO',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        dataSet.FieldByName('COD_PROD').AsString + '-' +
        dataSet.FieldByName('COD_GRADE').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosRastro._abreFormSelecionaGradeProd(grupo: integer;
  codProd: string): boolean;
var
  formulario: TfrmPadrao;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 800;
    formulario.Height := 600;
    formulario.Position := poScreenCenter;
    formulario.BorderIcons := [];
    formulario.Caption := 'Selecionar Grade do produto';
    FrmCadProdutosValidade.pnSelecionaGradeProd.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.KeyPreview := True;

    FrmCadProdutosValidade.Label38.Caption := '';
    FrmCadProdutosValidade.Label39.Caption := '';
    FrmCadProdutosValidade.Label40.Caption := '';

    buscas.Close;
    buscas.SQL.Text := 'select pr.descr_prod, g.cod_grade,g.descricao,g.descricao1,' +
      ' (cgp.qtde - coalesce((select sum(pp.quant_ped_item) from  pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped=pp.nped and v.cod_empresa=pp.cod_empresa and pp.tipo=v.tipo' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade=cgp.cod_grade ' +
      ' and pp.cod_empresa =cgp.cod_empresa ' +
      ' and ((v.status_ped <>''FECHADA'') or (v.status_ped is null))' +
      ' and (pp.status<>''CANCELADO'' or pp.status is null)' +
      //' and v.NPED<>' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
    ' and v.tipo<>''ORC''),0)) as qtd_item_disponivel, ' +
      ' cgp.qtde, ' +
      '(coalesce((select sum(pp.quant_ped_item) from  pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped=pp.nped and v.cod_empresa=pp.cod_empresa and pp.tipo=v.tipo' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade=cgp.cod_grade ' +
      ' and pp.cod_empresa =cgp.cod_empresa ' +
      ' and ((v.status_ped <>''FECHADA'') or (v.status_ped is null))' +
      ' and (pp.status<>''CANCELADO'' or pp.status is null)' +
      //' and v.NPED<>' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
      ' and v.tipo<>''ORC''),0)) as qtd_item_pedAberto from grade g' +
      ' inner join cod_grade_prod cgp on g.cod_grade=cgp.cod_grade and g.cod_empresa =cgp.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = cgp.grupo_prod and pr.cod_prod = cgp.cod_prod and pr.cod_empresa = cgp.cod_empresa' +
      ' where cgp.grupo_prod = ' + inttostr(grupo) +
      ' and cgp.cod_prod = ' + QuotedStr(codProd) +
      ' and cgp.cod_empresa =' + vDadosIni.codEmpresa +
      ' order by g.cod_grade';
    buscas.open;
    buscas.FieldByName('cod_grade').DisplayLabel := 'Grade';
    buscas.FieldByName('descricao').DisplayLabel := 'Descrição 1';
    buscas.FieldByName('descricao1').DisplayLabel := 'Descrição 2';
    buscas.FieldByName('qtde').DisplayLabel := 'Qtd. total da grade';
    buscas.FieldByName('qtd_item_pedAberto').DisplayLabel := 'Qtd. em Vendas em Aberto';
    buscas.FieldByName('qtd_item_disponivel').DisplayLabel := 'Qtd. Disponível';
    buscas.FieldByName('descr_prod').Visible := false;
    FrmCadProdutosValidade.dsSelecionaGradeProd.dataSet := buscas;
    FrmCadProdutosValidade.Label38.Caption := buscas.FieldByName('descr_prod').Text;
    FrmCadProdutosValidade.Label39.Caption := IntToStr(grupo);
    FrmCadProdutosValidade.Label40.Caption := codProd;
    result := (formulario.ShowModal = IDOK);
    nGradeSelecionada := buscas.FieldByName('cod_grade').AsInteger;

  finally
    buscas.close;
    FrmCadProdutosValidade.pnSelecionaGradeProd.Parent := FrmCadProdutosValidade.tsSelecionaGradeProd;
    formulario.Free;
    formulario := nil;
  end;
end;

procedure TProdutosRastro._cadProdutosRastro(pTipoForm: Integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Produtos Validade');
    if dtmProdutos = nil then
      dtmProdutos := TdtmProdutos.Create(dtmProdutos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('MOB001', 'CONSULTA', '', 'PRODUTOS_RASTRO', '',
      dtmProdutos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadProdutosValidade = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadProdutosValidade, frmCadProdutosValidade);
    end;

    if (pTipoForm > 0) and (not frmCadProdutosValidade.Visible) then
    	frmCadProdutosValidade.ShowModal
    else if (not frmCadProdutosValidade.Visible) then
    	frmCadProdutosValidade.Show
    else if frmCadProdutosValidade.FormStyle = fsMDIChild then
      frmCadProdutosValidade.Show
    else
      frmCadProdutosValidade.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TProdutosRastro._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TProdutosRastro._marcaDesmarcaLinha;
begin
	if dataSet.IsEmpty then
    exit;

  dataSet.Edit;
  if dataSet.FieldByName('sel').AsString = 'S' then
    dataSet.FieldByName('sel').AsString := ''
  else
    dataSet.FieldByName('sel').AsString := 'S';
  dataSet.Post;
end;

procedure TProdutosRastro._marcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := 'S';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

{ AlteracaoPrecoInput }

function AlteracaoPrecoInput.GetValor(const ACampo: string): Double;
var
  sCampo: string;
begin
  Result := 0;
  sCampo := Trim(UpperCase(ACampo));

  if (sCampo = 'PREC_TAB_PROD') then
    Result := Self.PrecoVarejo

  else if (sCampo = 'PREC_PUBLICO') then
    Result := Self.PrecoAtacado

  else if (sCampo = 'PREC_30_PROD') then
    Result := Self.Preco30

  else if (sCampo = 'PREC_60_PROD') then
    Result := Self.Preco60

  else if (sCampo = 'PREC_90_PROD') then
    Result := Self.Preco90      

  else if (sCampo = 'PRECO_PROMOCAO') then
    Result := Self.PrecoPromocao

  else if (sCampo = 'PERC_TB_PROD') then
    Result := Self.MarkUpVarejo

  else if (sCampo = 'PERC_TB_PRODA') then
    Result := Self.MarkUpAtacado

  else if (sCampo = 'PERC_TB_PROD3') then
    Result := Self.MarkUp30

  else if (sCampo = 'PERC_TB_PROD6') then
    Result := Self.MarkUp60

  else if (sCampo = 'PERC_TB_PROD9') then
    Result := Self.MarkUp90

  else if (sCampo = 'MARGEM_V_DESEJ') then
    Result := Self.MargemVarejo

  else if (sCampo = 'MARGEM_A_DESEJ') then
    Result := Self.MargemAtacado

  else if (sCampo = 'MARGEM_30_DESEJ') then
    Result := Self.Margem30

  else if (sCampo = 'MARGEM_60_DESEJ') then
    Result := Self.Margem60

  else if (sCampo = 'MARGEM_90_DESEJ') then
    Result := Self.Margem90

  else if (sCampo = 'PERC_AD_30') then
    Result := Self.PercentualAdd30

  else if (sCampo = 'PERC_AD_60') then
    Result := Self.PercentualAdd60

  else if (sCampo = 'PERC_AD_90') then
    Result := Self.PercentualAdd90

  else if (sCampo = 'PDESC_PR30_VAREJO') then
    Result := Self.PercDesconto30paraVarejo

  else
    raise Exception.CreateFmt('Get %s - Campo não implementado', [ sCampo ]);
end;

class function AlteracaoPrecoInput.New(ADataSet: TDataSet;
  const ACampo: string): AlteracaoPrecoInput;
begin
  Result.NomeCampo := Trim(UpperCase(ACampo));
  Result.AlterarCamposCalculados := False;

  Result.CustoMedio := ADataSet.FieldByName('prec_cusm_prod').AsFloat;
  Result.PrecoVarejo := ADataSet.FieldByName('prec_tab_prod').AsFloat;
  Result.PrecoAtacado := ADataSet.FieldByName('prec_publico').AsFloat;
  Result.Preco30 := ADataSet.FieldByName('prec_30_prod').AsFloat;
  Result.Preco60 := ADataSet.FieldByName('prec_60_prod').AsFloat;
  Result.Preco90 := ADataSet.FieldByName('prec_90_prod').AsFloat;
  Result.PrecoPromocao := ADataSet.FieldByName('preco_promocao').AsFloat;
  Result.MarkUpVarejo := ADataSet.FieldByName('perc_tb_prod').AsFloat;
  Result.MarkUpAtacado := ADataSet.FieldByName('perc_tb_proda').AsFloat;
  Result.MarkUp30 := ADataSet.FieldByName('perc_tb_prod3').AsFloat;
  Result.MarkUp60 := ADataSet.FieldByName('perc_tb_prod6').AsFloat;
  Result.MarkUp90 := ADataSet.FieldByName('perc_tb_prod9').AsFloat;
  Result.MargemVarejo := ADataSet.FieldByName('margem_v_desej').AsFloat;
  Result.MargemAtacado := ADataSet.FieldByName('margem_a_desej').AsFloat;
  Result.Margem30 := ADataSet.FieldByName('margem_30_desej').AsFloat;
  Result.Margem60 := ADataSet.FieldByName('margem_60_desej').AsFloat;
  Result.Margem90 := ADataSet.FieldByName('margem_90_desej').AsFloat;
  Result.PercentualAdd30 := ADataSet.FieldByName('perc_ad_30').AsFloat;
  Result.PercentualAdd60 := ADataSet.FieldByName('perc_ad_60').AsFloat;
  Result.PercentualAdd90 := ADataSet.FieldByName('perc_ad_90').AsFloat;
