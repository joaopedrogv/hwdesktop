function TProdutos.abrirComprasEVendas(dataIni, dataFim: string): boolean;
var
  I, vcDe: Integer;
  vSqlTmp: string;
  queryTmp: TIBQuery;
  transacTmp: TIBTransaction;
begin
   try
     try
       StrToDate(dataIni);
       StrToDate(dataFim);
     except
       Application.MessageBox('Data informada inválida', 'Atenção', MB_ICONWARNING + MB_OK);
       exit;
     end;
   //  cCompras := TClientDataSet(dtmProdutos.cdsFichCompras);
   //  cEntProducao := TClientDataSet(dtmProdutos.cdsFichEProducao);
   //  cDevolucoes := TClientDataSet(dtmProdutos.cdsFichDevolucao);
   //  cVendas := TClientDataSet(dtmProdutos.cdsFichVendas);
   //  cSaiProducao := TClientDataSet(dtmProdutos.cdsFichSProducao);
     cdsEstoqueDiario := TClientDataSet(dtmProdutos.cdsEstoqueDiario);
     cFicha := TClientDataSet(dtmProdutos.cdsFicha);
     {
     cdsEstoqueDiario.Close;
     cdsEstoqueDiario.CommandText := ' select distinct est.dia "Data", ' +
      ' sum(coalesce(est.estoque, 0)) "Estoque", ' +
      ' avg(coalesce(est.custo_medio, 0)) "CustoMedio" from estoque_diario est ' +
      ' where est.tipo = ''P'' and est.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
      ' and est.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and est.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and est.dia >= :dataInicio and est.dia <= :dataFim ' +
      ' group by est.dia ' + // ' group by est.dia, est.custo_medio ' +
      ' order by est.dia asc ';
     cdsEstoqueDiario.Params.ParamByName('dataInicio').AsDate := StrToDate(dataIni);
     cdsEstoqueDiario.Params.ParamByName('dataFim').AsDate := StrToDate(dataFim);
     cdsEstoqueDiario.Open;
     }

     transacTmp := Create_new_fb_transaction(buscas.Database);
     queryTmp := Create_new_fb_query(transacTmp);
     try
       SqlOpen('select * from sp_handle_est_ini_dif(%d, %s, %d, %s, %s)',
         [fint('grupo_prod'), fstrq('cod_prod'), vDadosIni.cod_empresa,
         date_fb(StrToDate(dataIni)), date_fb(StrToDate(dataFim))], queryTmp).Transaction.Commit;
     finally
       FreeAndNil(queryTmp);
       FreeAndNil(transacTmp);
     end;
     //select * from sp_handle_est_ini_dif(32, '43571', 1, '20.05.2022', '20.05.2022')

     ClientOpen(' select est.dia "Data", ' +
      ' sum(coalesce(est.estoque, 0)) "Estoque", ' +
      ' avg(coalesce(est.custo_medio, 0)) "CustoMedio" from sp_estoque_diario_grade(' +
      ' %d, %s, %d, %s, %s) est ' +
      ' group by 1' +
      ' order by est.dia asc',
      [fint('grupo_prod'), fstrq('cod_prod'), vDadosIni.cod_empresa,
       date_fb(StrToDate(dataIni)), date_fb(StrToDate(dataFim))], cdsEstoqueDiario);

     cdsEstoqueDiario.FieldByName('customedio').DisplayLabel := 'Custo Medio';

     for I := 0 to cdsEstoqueDiario.Fields.Count - 1 do
       if cdsEstoqueDiario.Fields[i].DataType = ftFloat then
         if (pos('Custo Medio', TFloatField(cdsEstoqueDiario.Fields[i]).DisplayLabel) > 0) then
           TFloatField(cdsEstoqueDiario.Fields[i]).DisplayFormat := '##0.0000'
         else if (pos('Estoque', TFloatField(cdsEstoqueDiario.Fields[i]).DisplayLabel) > 0) then
           TFloatField(cdsEstoqueDiario.Fields[i]).DisplayFormat := '##0.0000'
         else
         	 TFloatField(cdsEstoqueDiario.Fields[i]).DisplayFormat := '##0.00';

     cFicha.Close;
     cFicha.CommandText := ' select f.ordem "Ordem", f.tipo "Tipo", f.natureza "Natureza", ' +
      ' f.numdoc "Numero", f.data "Data", f.data_estoque, f.qtde "Qtde/Dif. Bal", ' +
      ' f.valor_unit "Valor Unit", f.valor_total "Valor Total", ' +
