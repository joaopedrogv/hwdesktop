                  buscasU.ParamByName('PCOD_BARRA').AsString := trim(oldCodProd)
                else
                  buscasU.ParamByName('PCOD_BARRA').AsString := trim(oldGrupoProd) + trim(oldCodProd);
                buscasU.ParamByName('PGRUPO_PROD').AsInteger := vCodGrupoLote;
                buscasU.ParamByName('PCOD_PROD').AsString := vCodProdTemp;
                buscasU.ParamByName('PCOD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

                buscasU.ParamByName('DAT_MOD_CDBAR').AsDateTime := DateOf(vDadosIni.vDataHora);
                if not vManterNumeroFabricante then
                  buscasU.ParamByName('COD_BARRA').AsString := vNumFabProdTemp;
                buscasU.ExecSQL;

//                if not vManterNumeroFabricante then
//                  vListaProdutosCodBarra.Add(
//                    IntToStr(vCodGrupoLote) + '|' +
//                    trim(vCodProdTemp) + '|' +
//                    vDadosIni.IfThen(vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S', trim(oldCodProd), trim(oldGrupoProd) + trim(oldCodProd)) + '|');
              end;
            end;

            vDadosIni.GravaAuditoria('PRO362', vtempMensagem,
              vDadosIni.IfThen((vHabGrupo) and (StrToInt(oldGrupoProd) <> vCodGrupoLote),
                'Gr Ant: ' + oldGrupoProd +
                ' Cod Ant: ' + trim(oldCodProd) +
                ' Gr Novo: ' + IntToStr(vCodGrupoLote) +
                ' Cod Novo: ' + trim(vCodProdTemp), ''),
              'PRODUTOS', IntToStr(vGrupoProdTemp) + '-' + trim(vCodProdTemp), buscas);

            Inc(vinc_a_cada_reg);

            if (vsalvar_a_cada_reg > 0) and (vinc_a_cada_reg >= vsalvar_a_cada_reg) then
            begin
            	Application.ProcessMessages;
              vDadosIni.abreStatusProcessamento('', 'Salvando dados produto (' +
                IntToStr(fTempListaProdutos.RecNo) + '/' + IntToStr(fTempListaProdutos.RecordCount) + ')');

              vinc_a_cada_reg := 0;

              if not verificarNumFabExiste then
                Exit;

              if not verificarCodBarrasExiste then
                Exit;

              CommitaTransacao;
            end;

            fTempListaProdutos.Next;
          end;
        finally
        	 fTempListaProdutos.First;
	       fTempListaProdutos.EnableControls;
        end;

        if not verificarNumFabExiste then
          Exit;

        if not verificarCodBarrasExiste then
          Exit;

		  Application.ProcessMessages;
        vDadosIni.abreStatusProcessamento('', 'Atualizando dados produto (' +
        IntToStr(fTempListaProdutos.RecordCount) + '/' + IntToStr(fTempListaProdutos.RecordCount) + ')');

        CommitaTransacao;

        dataSet.Close;
		  dataSet.CommandText := vSQL;
		  dataSet.Open;

        vDadosIni.GravaAuditoria('PRO362', vtempMensagem,	'SUCESSO', 'PRODUTOS', '', buscas);
      end;

      Result := true;

      if Result then
        dataSet.Refresh;
    finally
      dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;

      if Assigned(buscas2) then
      	FreeAndNil(buscas2);

      if Assigned(buscasU) then
      	FreeAndNil(buscasU);

      vDadosIni.fechaStatusProcessamento;
    end;

  except
    on e: exception do
    begin
      Result := false;
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
	      dataSet.Close;
  	    dataSet.CommandText := vSQL;
    	  dataSet.Open;
      end;

      vDadosIni.GravaAuditoria('PRO362', vtempMensagem,	'FALHA', 'PRODUTOS', '', buscas);
      GravaLogConfirmacao(statusRegistro, 'PRO362', false);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutos.buscasCESTProduto(pCEST: string): boolean;
