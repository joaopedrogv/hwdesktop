function TNBM.definirDadosPISCOFINSnosProdutos(pGrid: TDBGrid): boolean;
var
  vSomenteSelecionados, vYes, vSalvar: Boolean;
  vlista, vListaEmpresasRepl: TStringList;
  I: Integer;

  procedure defineReplicacaoInterna;
  begin
    buscas.Close;
    buscas.SQL.Text := 'select tabela from TAB_REP where tabela = ''PRODUTOS''';
    buscas.Open;

    vListaEmpresasRepl := TStringList.Create;
    vListaEmpresasRepl.Clear;

    if UpperCase(Trim(buscas.FieldByName('tabela').AsString)) = 'PRODUTOS' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_empresa from empresa where cod_empresa <> ' + vDadosIni.codEmpresa;
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
        vListaEmpresasRepl.Add(IntToStr(buscas.FieldByName('cod_empresa').AsInteger));
        buscas.Next;
      end;
    end;
  end;

begin
  vSomenteSelecionados := Application.MessageBox('Somente registros selecionados', 'Confirmação',
    MB_ICONQUESTION + MB_YESNO) = IDYES;

  defineReplicacaoInterna;

  buscas.Close;
  buscas.SQL.Text := 'update produtos set rep_int_active = 1, CST_PIS = :CST_PIS, CST_COFINS = :CST_COFINS,' +
    ' CST_PIS_ENT = :CST_PIS_ENT, CST_COFINS_ENT = :CST_COFINS_ENT, NAT_REC = :NAT_REC,' +
    ' ALIQ_PIS_DIFERENCIADA = :ALIQ_PIS_DIFERENCIADA, ALIQ_COFINS_DIFERENCIADA = :ALIQ_COFINS_DIFERENCIADA,' +
    ' ALIQ_CRED_PIS = :ALIQ_CRED_PIS, ALIQ_CRED_COFINS = :ALIQ_CRED_COFINS ' +
    ' where not nbm is null and nbm <> '''' and nbm = :nbm and cod_empresa = :cod_empresa';
  vYes := False;
  vSalvar := False;
  vlista := TStringList.Create;
  vlista.Clear;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if (pGrid.SelectedRows.CurrentRowSelected) or (not vSomenteSelecionados) then
    begin
      try
        buscas.Close;
        buscas.ParamByName('CST_PIS').AsString := dataSet.FieldByName('CST_PIS').AsString;
        buscas.ParamByName('CST_COFINS').AsString := dataSet.FieldByName('CST_COFINS').AsString;
        buscas.ParamByName('CST_PIS_ENT').AsString := dataSet.FieldByName('CST_PIS_ENT').AsString;
        buscas.ParamByName('CST_COFINS_ENT').AsString :=
          dataSet.FieldByName('CST_COFINS_ENT').AsString;
        buscas.ParamByName('NAT_REC').AsString := dataSet.FieldByName('NAT_REC').AsString;
        buscas.ParamByName('ALIQ_PIS_DIFERENCIADA').AsFloat :=
          dataSet.FieldByName('ALIQ_PIS_DIFERENCIADA').AsFloat;
        buscas.ParamByName('ALIQ_COFINS_DIFERENCIADA').AsFloat :=
          dataSet.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsFloat;
        buscas.ParamByName('ALIQ_CRED_PIS').AsFloat := dataSet.FieldByName('ALIQ_CRED_PIS').AsFloat;
        buscas.ParamByName('ALIQ_CRED_COFINS').AsFloat :=
          dataSet.FieldByName('ALIQ_CRED_COFINS').AsFloat;
        buscas.ParamByName('nbm').AsString := dataSet.FieldByName('COD_NCM').AsString;
        buscas.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;
        buscas.ExecSQL;

        for I := 0 to vListaEmpresasRepl.Count - 1 do
        begin
          buscas.ParamByName('cod_empresa').AsInteger := StrToIntDef(vListaEmpresasRepl[i], 0);
          buscas.ExecSQL;
        end;

        vlista.Add('NCM ' + dataSet.FieldByName('COD_NCM').AsString +
          '. CST PIS/COFINS Vend/Ent ' + dataSet.FieldByName('CST_PIS').AsString +
          ', ' + dataSet.FieldByName('CST_COFINS').AsString +
          ', ' + dataSet.FieldByName('CST_PIS_ENT').AsString +
          ', ' + dataSet.FieldByName('CST_COFINS_ENT').AsString +
          '. NAT REC PIS/COFINS ' + Trim(dataSet.FieldByName('NAT_REC').AsString) +
          '. AL PIS/COFINS ' + dataSet.FieldByName('ALIQ_PIS_DIFERENCIADA').AsString +
          ', ' + dataSet.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsString +
          '. AL CRED PIS/COFINS ' + dataSet.FieldByName('ALIQ_CRED_PIS').AsString +
          ', ' + dataSet.FieldByName('ALIQ_CRED_COFINS').AsString);
        vSalvar := True;
      except
        on e: exception do
        begin
          vYes :=
            Application.MessageBox(pchar('Erro ao tentar modificar dados de PIS/COFINS nos produtos de NCM igual a: ' +
            dataSet.FieldByName('COD_NCM').AsString + #13 +
            'Erro: ' + e.Message + #13 +
            'Deseja cancelar Operação?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES;
          if vYes then
            Break;
        end;
      end;
    end;
    dataSet.Next;
  end;

  if vYes then
  begin
    RollBackTransacao;
    Exit;
  end;

  if vSalvar then
    vYes := Application.MessageBox(pchar('Deseja mesmo salvar modifições nos produtos?'),
      'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES;
  if vYes then
  begin
    CommitaTransacao;
    for I := 0 to vlista.Count - 1 do
      vDadosIni.GravaAuditoria('PRO171', 'EDITAR', vlista[I], 'PRODUTOS', '', buscas);
  end
  else
    RollBackTransacao;
end;

