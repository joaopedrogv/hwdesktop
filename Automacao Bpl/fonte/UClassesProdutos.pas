function TProdutos.setaCamposVariaveisPost: boolean;
var
  I: Integer;
begin
  try
    Result := true;

    if dataSet.FieldByName('PREC_CUSM_PROD').AsFloat = 0 then
      dataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
        dataSet.FieldByName('PREC_CUS_PROD').AsFloat;

    if dataSet.FieldByName('CST_PIS').AsString = '07' then
      dataSet.FieldByName('ISENTO_PIS').AsString := 'S'
    else
      dataSet.FieldByName('ISENTO_PIS').AsString := 'N';

    dataSet.FieldByName('CST_COFINS').AsString := dataSet.FieldByName('CST_PIS').AsString;
    dataSet.FieldByName('CST_COFINS_ENT').AsString := dataSet.FieldByName('CST_PIS_ENT').AsString;
    dataSet.FieldByName('cfop_nfce').AsInteger := IfThen( (fint('cfop_nfce') <> 0) and (fint('codigo_nop') <> fint('cfop_nfce')), fint('cfop_nfce'));
    if fint('cfop_nfce') = 0 then
      dataSet.FieldByName('cfop_nfce').Value := Null;

    if vDadosIni.strIn(Copy(dataSet.FieldByName('cst_prod').AsString, 2, 2), ['40', '41', '50', '51', '60']) then
      if dataSet.FieldByName('icm_prod').AsFloat > 0 then
        dataSet.FieldByName('icm_prod').AsFloat := 0;

    if cadastroSimplificado then
    begin
      dataSet.FieldByName('ISENTO_PROD').AsString := vDadosIni.IfThen(Copy(dataSet.FieldByName('cst_prod').AsString, 2,2) = '40', 'S', 'N');
      dataSet.FieldByName('N_INCIDENCIA_PROD').AsString := vDadosIni.IfThen(Copy(dataSet.FieldByName('cst_prod').AsString, 2,2) = '41', 'S', 'N');
    end
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.setaCamposVariaveisPost. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.sincronizarProdutosEmLote: boolean;
var
	fTempListaProdutos: TClientDataSet;
  vIndexFieldNames: string;
  vIndexName: string;
  vRecNo: Integer;
  vSQL: string;
  buscasU: TIBQuery;
  vReplicaoInterna: boolean;
  vtempMensagem: string;
  vinc_a_cada_reg: Integer;
  vsalvar_a_cada_reg: Integer;
begin
	Result := false;
  vSQL := '';
  vtempMensagem := 'SALVAR';

  if not vDadosIni.PesqPros('PRO442', vtempMensagem, '', 'PRODUTOS', '', buscas, False) then
  	Exit;
	try
  	buscasU := TIBQuery.Create(nil);

  	try
      buscasU.Database := buscas.Database;
      buscasU.Transaction := buscas.Transaction;

      vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

    	try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum produto selecionado.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          exit;
        end;

        if Application.MessageBox('Deseja sincronizar os produtos selecionados?',
        	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
          	exit;

        vDadosIni.vDataHora := vDadosIni.getDataHoraBanco(buscas);

        vsalvar_a_cada_reg := vDadosIni.getConfSisInt('prod_cad_alt_lote_reg', buscas);

        buscas.Close;
        buscas.SQL.Text := ' select * from TAB_REP where TABELA = ''PRODUTOS'' ';
        buscas.open;
        vReplicaoInterna := not buscas.IsEmpty;

        fTempListaProdutos := TClientDataSet.Create(nil);
        fTempListaProdutos.Close;
        fTempListaProdutos.FieldDefs.Clear;
        fTempListaProdutos.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
        fTempListaProdutos.FieldDefs.Add('COD_PROD', ftString, 6, false);
        fTempListaProdutos.close;
        fTempListaProdutos.CreateDataSet;
        fTempListaProdutos.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
          	Application.ProcessMessages;
            vDadosIni.abreStatusProcessamento('', 'Lendo dados produtos (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempListaProdutos.Insert;
              fTempListaProdutos.FieldByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
              fTempListaProdutos.FieldByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
              fTempListaProdutos.Post;
            end;

            dataSet.Next;
          end;
        finally
          dataSet.EnableControls;
        end;

        vSQL := dataSet.CommandText;
      finally
        dataSet.Filtered := false;
      end;

      vinc_a_cada_reg := 0;

      try
        fTempListaProdutos.DisableControls;
        fTempListaProdutos.First;
        while not fTempListaProdutos.Eof do
        begin
          Application.ProcessMessages;
          vDadosIni.abreStatusProcessamento('', 'Sincronizando produtos (' +
            IntToStr(fTempListaProdutos.RecNo) + '/' + IntToStr(fTempListaProdutos.RecordCount) + ')');

          buscasU.Close;
          buscasU.SQL.Text := ' UPDATE PRODUTOS SET ' +
          	' REP_INT_ACTIVE = 1, ' +
            '	ATIVO = 1, ' +
          	' DAT_MOD_PROD = :DAT_MOD_PROD, ' +
            ' DATA_MOD_PR = :DATA_MOD_PR ' +
          	' WHERE GRUPO_PROD = :PGRUPO_PROD ' +
            ' AND COD_PROD = :PCOD_PROD ' +
            ' AND COD_EMPRESA = :PCOD_EMPRESA ';
          buscasU.ParamByName('PGRUPO_PROD').AsInteger := fTempListaProdutos.FieldByName('GRUPO_PROD').AsInteger;
          buscasU.ParamByName('PCOD_PROD').AsString := fTempListaProdutos.FieldByName('COD_PROD').AsString;
          buscasU.ParamByName('PCOD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          buscasU.ParamByName('DAT_MOD_PROD').AsDateTime := DateOf(vDadosIni.vDataHora);
          buscasU.ParamByName('DATA_MOD_PR').AsDateTime := vDadosIni.vDataHora;
          buscasU.ExecSQL;

        	buscasU.Close;
          buscasU.SQL.Text := ' UPDATE COD_BARRA SET ' +
          	'	ATIVO = 1, ' +
            '	DAT_MOD_CDBAR = :DAT_MOD_CDBAR ' +
            ' WHERE GRUPO_PROD = :PGRUPO_PROD ' +
            ' AND COD_PROD = :PCOD_PROD ' +
            ' AND COD_EMPRESA = :PCOD_EMPRESA ';
          buscasU.ParamByName('PGRUPO_PROD').AsInteger := fTempListaProdutos.FieldByName('GRUPO_PROD').AsInteger;
          buscasU.ParamByName('PCOD_PROD').AsString := fTempListaProdutos.FieldByName('COD_PROD').AsString;
          buscasU.ParamByName('PCOD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          buscasU.ParamByName('DAT_MOD_CDBAR').AsDateTime := DateOf(vDadosIni.vDataHora);
          buscasU.ExecSQL;

          vDadosIni.GravaAuditoria('PRO442', vtempMensagem, '',
            'PRODUTOS',
            IntToStr(fTempListaProdutos.FieldByName('GRUPO_PROD').AsInteger) + '-' +
            trim(fTempListaProdutos.FieldByName('COD_PROD').AsString), buscas);

          Inc(vinc_a_cada_reg);

          if (vsalvar_a_cada_reg > 0) and (vinc_a_cada_reg >= vsalvar_a_cada_reg) then
          begin
            Application.ProcessMessages;
            vDadosIni.abreStatusProcessamento('', 'Salvando dados produto (' +
              IntToStr(fTempListaProdutos.RecNo) + '/' + IntToStr(fTempListaProdutos.RecordCount) + ')');

            vinc_a_cada_reg := 0;

            CommitaTransacao;
          end;

          fTempListaProdutos.Next;
        end;
      finally
      	fTempListaProdutos.First;
      	fTempListaProdutos.EnableControls;
      end;

      Application.ProcessMessages;
      vDadosIni.abreStatusProcessamento('', 'Atualizando dados produto (' +
        IntToStr(fTempListaProdutos.RecordCount) + '/' + IntToStr(fTempListaProdutos.RecordCount) + ')');

      CommitaTransacao;

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      vDadosIni.GravaAuditoria('PRO442', vtempMensagem,	'SUCESSO', 'PRODUTOS', '', buscas);

      Result := true;

      if Result then
      	dataSet.Refresh;
    finally
      dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;

      if Assigned(buscasU) then
      	FreeAndNil(buscasU);

      vDadosIni.fechaStatusProcessamento;
    end;

  except
    on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO442', vtempMensagem,	'FALHA', 'PRODUTOS', '', buscas);
      GravaLogConfirmacao(statusRegistro, 'PRO442', false);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

