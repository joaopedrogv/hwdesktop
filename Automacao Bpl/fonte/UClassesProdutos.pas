function TPromocaoProduto.postPrecoDif(
	cod_promocao, cod_tipo, tipo: Integer;
  valor, porcentagem, max_desc, markup: Double;
  debcred, sigla: string;
  vProduto: TProdutos;
  CodTabela, Tabela: string): Boolean;
var
  vselecionado, acao, vSql: string;
  vproporcao_tabela: Double;
  buscas2: TIBQuery;
  editar: Boolean;
  I: Integer;
  vvalortemp: Double;
  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;

  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO235', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    '', buscas, False) then
    Exit;

  try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;
    editar := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if Tabela = '' then
      raiseExceptionCreate('Tipo deve ser informado!', 'DBLookupComboBox9');
      
    if not existeTipoTabela(IntToStr(cod_tipo), IntToStr(cod_promocao), Tabela) then
    begin
      if Tabela = 'AVULSO' then
        raiseExceptionCreate('Tabela não encontrada!', 'DBLookupComboBox8')
      else if Tabela = 'LOCALIDADE' then
        raiseExceptionCreate('Localidade não encontrada!', 'DBLookupComboBox8')
      else if Tabela = 'SETOR' then
        raiseExceptionCreate('Setor não encontrado!', 'DBLookupComboBox8')
      else if Tabela = 'CIDADE' then
        raiseExceptionCreate('Cidade não encontrada!', 'DBLookupComboBox8');
    end;

  	if max_desc < 0 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser menor que 0%!', 'EditHw8');

    if max_desc >= 100 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser maior ou igual a 100%!', 'EditHw8');    

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
      raiseExceptionCreate('Valor, Markup, Margem ou ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	'(%) deve ser informado!', 'EditHw2');

    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior ou igual a 100%!', 'EditHw3');

    if (Trim(sigla) = '') then
      raiseExceptionCreate('Tipo de Venda deve ser informado!', 'DBLookupComboBox7');

    if vDadosIni.vtpPreco = 'P' then
		  if (valor >= vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat) then
      	raiseExceptionCreate('Valor informado não deve ser maior ou igual ao preço de varejo!', 'EditHw2');

    try
      vProduto.dataSet.Filter := 'SEL = ''S''';
      vProduto.dataSet.Filtered := true;

      try
        // Replicar produtos para outras empresas
        vProduto.dataSet.DisableControls;
        vProduto.dataSet.First;
        while not vProduto.dataSet.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Replicando produtos para outras empresas - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount));

          if not vDadosIni.produtos_replicacao_interna(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger, vProduto.dataSet.FieldByName('COD_PROD').AsString) then
          begin
           Result := false;
           exit;
          end;
          vProduto.dataSet.Next;
        end;
      finally
      	vDadosIni.fechaStatusProcessamento;
        vProduto.dataSet.EnableControls;
      end;

      vDadosIni.verificarReplicacaoInterna(buscas, true);
      if Tabela = 'AVULSO' then
        vDadosIni.verificarPromocao(buscas, cod_promocao, 5);
      vDadosIni.verificarTabPreco(buscas, Tabela, cod_tipo);

      try
        vProduto.dataSet.DisableControls;
        vProduto.dataSet.First;
        while not vProduto.dataSet.Eof do
        begin
          vselecionado := 'S';

          if (cod_tipo) = 1 then
      			vDadosIni.abreStatusProcessamento('', 'Atualizando dados da promoção - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
    			else if (cod_tipo = 2) then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por localidade - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if (cod_tipo = 3) then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por setor - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if (cod_tipo = 4) then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços por cidade - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount))
          else if (cod_tipo = 5) then
            vDadosIni.abreStatusProcessamento('', 'Atualizando preços tabela avulsa - ' + IntToStr(vProduto.dataSet.RecNo) + '/' + IntToStr(vProduto.dataSet.RecordCount));

          valor := vvalortemp;
				  porcentagem := vporcentagemtemp;
          vproporcao_tabela := 0;
          if markup > 0 then
          begin
            porcentagem := 0;

            vinf := 'M';
          end
    			else if porcentagem <> 0 then
          begin
          	if vDadosIni.vtpPreco = 'P' then
            begin
            	porcentagem := Abs(porcentagem);
            	if valor > 0 then
			        	porcentagem := 0;
              vproporcao_tabela := 0;

              vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');
            end
            else
            begin
            	vinf := vDadosIni.IfThen(porcentagem <> 0, 'P', 'V');

	          	if porcentagem > 0 then
		          	vproporcao_tabela := 1 + (Abs(porcentagem) / 100)
    	        else
      	      	vproporcao_tabela := 1 - (Abs(porcentagem) / 100);

              valor := vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat + ((vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * porcentagem);
	            porcentagem := 0;
            end;
          end
          else
          begin
            porcentagem := 0;

            vinf := 'V';
          end;

    //      if dataSet.FieldByName('MAX_DESC').AsFloat > 0 then
    //        if ((valor) < (vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat - (vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat / 100) * dataSet.FieldByName('MAX_DESC').AsFloat)) then
    //        begin
    //          raiseExceptionCreate('Desconto maior que permitido!', 'EditHw4');
    //          Result := False;
    //          exit;
    //        end;

          if ((vProduto.ffloat('prec_cusm_prod') <= 0) and (markup > 0)) then
          begin
            if ShowConfirmacao('Markup ou Margem informada e o produto não possui custo para continuar com o calculo. Deseja passar para o próximo produto ou cancelar a operação, para continuar aperte Sim, para Cancelar aperte Não ?' + #13 +
              'Grupo Prod: ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
              'Cod Prod: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + #13 +
              'Num Fabr: ' + trim(vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString)) <> IDYES then
            begin
              Result := False;
              exit;
            end
            else
            begin
              vProduto.dataSet.Next;
              Continue;
            end;
          end
          else
          if ((valor <= 0) and (porcentagem = 0) and (vproporcao_tabela = 0) and (markup = 0)) then
          begin
            if Application.MessageBox(pchar(' Valor do Produto deve ser menor ou igual zero, deseja passar para o próximo produto ou cancelar a operação, para continuar aperte Sim, para Cancelar aperte Não ?' + #13 +
              'Grupo Prod: ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
              'Cod Prod: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) + #13 +
