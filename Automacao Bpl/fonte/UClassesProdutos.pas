function TProdutos.abreListaProdutos(vcomb: TDbCombobox): boolean;
begin
  buscas.Close;
  buscas.SQL.Text := ' SELECT SIGLA FROM TIPO_LISTA_FABRICA ' +
    ' WHERE ATIVO = 1';
  buscas.Open;
  buscas.FetchAll;

  vcomb.Items.Clear;
  buscas.First;
  while not buscas.Eof do
  begin
   vcomb.Items.Add(buscas.FieldByName('SIGLA').AsString);
   buscas.Next;
  end;
end;

