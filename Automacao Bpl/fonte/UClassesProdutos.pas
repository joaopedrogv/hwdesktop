function TReducaoProd.abreReducaoProd(vProd: TProdutos): boolean;
begin
  if vProd.dataSet.IsEmpty then
    exit;
  Result := montaSelect('select * from reducao ' +
    ' where grupo_prod = ' + IntToStr(vProd.dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(vProd.dataSet.FieldByName('cod_prod').AsString) +
    ' and cod_empresa  = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ' +
    ' and cod_reducao <> 0');
end;

constructor TReducaoProd.create;
begin
  DataSet := TClientDataSet(DtmProdutos.cdsRed);
  transacao := TIBTransaction(DtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(DtmProdutos.qrBuscasP);
end;

function TReducaoProd.insert(vprod: TProdutos): boolean;
begin
  if inherited insert then
  begin
    dataSet.FieldByName('grupo_prod').AsString := vprod.dataSet.FieldByName('grupo_prod').AsString;
    dataSet.FieldByName('cod_prod').AsString := vprod.dataSet.FieldByName('cod_prod').AsString;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('dentro_est').AsString := '1';
    dataSet.FieldByName('isento').AsString := '1';
    Result := true;
  end;
end;

function TReducaoProd.post: boolean;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('aliquota').AsString) = '' then
      raise exception.create('Alíquota não informada');

    if trim(dataSet.FieldByName('percentual').AsString) = '' then
      raise exception.create('Percentual de redução não informado');

    if dataSet.State in [dsInsert] then
      dataSet.FieldByName('cod_reducao').AsInteger := Gencodigo('reducao', dtmProdutos.SpIncCodigo,
        vDadosIni.codEmpresa);

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if Apply then
    begin
      if CommitaTransacao then
        vDadosIni.GravaAuditoria('PRO104', 'TRANSAÇÃO CONFIRMADA', 'SUCESSO', 'REDUCAO',
          dataSet.FieldByName('cod_reducao').AsString, buscas);
      //        vDadosIni.GravaAuditoria('PRO104', 'TRANSACAO CONFIRMADA' +
      //          dataSet.FieldByName('cod_reducao').AsString, buscas);
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO104', 'TRANSAÇÃO NAO CONFIRMADA', 'FALHA', 'REDUCAO',
        dataSet.FieldByName('cod_reducao').AsString, buscas);
      //      vDadosIni.GravaAuditoria('PRO014', 'TRANSACAO NAO CONFIRMADA' +
      //        dataSet.FieldByName('cod_reducao').AsString, buscas);
      Result := FALSE;
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

