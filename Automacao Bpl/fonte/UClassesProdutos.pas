function TProdutos.utilizarInsumoOutroProd(
	pGrupoProd: Integer;
  pCodProd: string): boolean;
var
	fTempProdutos: TClientDataSet;
  fTempProdutosDtSource: TDataSource;
begin
	try
    Result := False;

    if dataSet.IsEmpty then
      Exit;

    buscas.Close;
    buscas.SQL.Text := ' select indice_tecnico.*, ' +
    	' produtos.num_fab_prod as num_fab_prod_mprima, ' +
      ' produtos.descr_prod as descr_prod_mprima from indice_tecnico ' +
      ' inner join produtos on ' +
      '		indice_tecnico.grupo_prod_mprima = produtos.grupo_prod ' +
      '		and indice_tecnico.cod_prod_mprima = produtos.cod_prod ' +
      '		and indice_tecnico.cod_empresa = produtos.cod_empresa ' +
      ' where indice_tecnico.grupo_prod_acabado = ' + IntToStr(pGrupoProd) +
      ' and indice_tecnico.cod_prod_acabado = ' + QuotedStr(pCodProd) +
      ' and indice_tecnico.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    buscas.FetchAll;

    if buscas.IsEmpty then
    begin
      Application.MessageBox('Produto informado sem Matérias Primas/Insumos/Embalagens', 'Atenção', MB_ICONWARNING + MB_OK);
      Result := True;
      exit;
    end;

    try
      fTempProdutos := TClientDataSet.Create(nil);
      fTempProdutos.Close;
      fTempProdutos.FieldDefs.Clear;
      fTempProdutos.FieldDefs.Add('SEL', ftString, 1, false);
      fTempProdutos.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
      fTempProdutos.FieldDefs.Add('COD_PROD', ftString, 6, false);
      fTempProdutos.FieldDefs.Add('NUM_FAB_PROD', ftString, 20, false);
      fTempProdutos.FieldDefs.Add('QTDE', ftFloat, 0, false);
      fTempProdutos.FieldDefs.Add('DESCR_PROD', ftString, 75, false);

      if fTempProdutos.Tag = 0 then
      try
        fTempProdutos.CreateDataSet;
        fTempProdutos.FieldByName('SEL').DisplayLabel := 'Sel';
        fTempProdutos.FieldByName('GRUPO_PROD').DisplayLabel := 'Grupo Prod';
        fTempProdutos.FieldByName('COD_PROD').DisplayLabel := 'Cod Prod';
        fTempProdutos.FieldByName('NUM_FAB_PROD').DisplayLabel := 'Num Fab Prod';
        fTempProdutos.FieldByName('QTDE').DisplayLabel := 'Qtde';
        fTempProdutos.FieldByName('DESCR_PROD').DisplayLabel := 'Descr Prod';

        TFloatField(fTempProdutos.FieldByName('QTDE')).DisplayFormat := '##0.000';

        fTempProdutos.EmptyDataSet;

        fTempProdutosDtSource := TDataSource.Create(nil);
        fTempProdutosDtSource.DataSet := fTempProdutos;
      except
      end;

      buscas.First;
      while not buscas.Eof do
      begin
        fTempProdutos.Insert;
        fTempProdutos.FieldByName('SEL').AsString := 'S';
        fTempProdutos.FieldByName('GRUPO_PROD').AsInteger := buscas.FieldByName('GRUPO_PROD_MPRIMA').AsInteger;
        fTempProdutos.FieldByName('COD_PROD').AsString := buscas.FieldByName('COD_PROD_MPRIMA').AsString;
        fTempProdutos.FieldByName('NUM_FAB_PROD').AsString := buscas.FieldByName('NUM_FAB_PROD_MPRIMA').AsString;
        fTempProdutos.FieldByName('DESCR_PROD').AsString := buscas.FieldByName('DESCR_PROD_MPRIMA').AsString;
        fTempProdutos.FieldByName('QTDE').AsFloat := buscas.FieldByName('QUANT').AsFloat;
        fTempProdutos.Post;

        buscas.Next;
      end;

      FrmCadProdutos.DBGridInsumosOutrosProd.DataSource := fTempProdutosDtSource;
      if not vDadosIni.abreForm('Matérias Primas/Insumos/Embalagens', FrmCadProdutos.pnInsumosOutrosProd, [ofEscapeExit, ofAlignAllClientWinCtrl]) then
        exit;

      fTempProdutos.First;
      while not fTempProdutos.Eof do
      begin
        if fTempProdutos.FieldByName('SEL').AsString = 'S' then
        begin
          vIndTec.vgrupo_prod_acabado := dataSet.FieldByName('grupo_prod').AsString;
          vIndTec.vcod_prod_acabado := dataSet.FieldByName('cod_prod').AsString;
          vIndTec.vgrupo_prod_mp := fTempProdutos.FieldByName('grupo_prod').AsString;
          vIndTec.vcod_prod_mp := fTempProdutos.FieldByName('cod_prod').AsString;
          vIndTec.vdescr_prod_mp := fTempProdutos.FieldByName('descr_prod').AsString;
          vIndTec.vcodprod := fTempProdutos.FieldByName('num_fab_prod').AsString;
          vIndTec.vquant_mp := fTempProdutos.FieldByName('qtde').AsFloat;

          if not vDadosIni.PesqPros('ITEC003', 'CONFIRMAR',
            'ACAB ' +
            'Grupo: ' + vIndTec.vgrupo_prod_acabado + ' ' +
            'Codigo: ' + vIndTec.vcod_prod_acabado + ' ' +
            'INS ' +
            'Grupo: ' + vIndTec.vgrupo_prod_mp + ' ' +
            'Codigo: ' + vIndTec.vcodprod,
            'INDICE_TECNICO',
            vIndTec.vgrupo_prod_acabado + ' ' +
            vIndTec.vcod_prod_acabado,
            buscas, True) then
              Exit;

          if not vIndTec.inserirItem then
            Exit;
        end;

        fTempProdutos.Next;
      end;

      vIndTec.Refresh;

    	Result := True;
  	finally
  		if Assigned(fTempProdutos) then
      	FreeAndNil(fTempProdutos);
    end;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.utilizarInsumoOutroProd. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.VendasMes(dataIni: string): boolean;
begin
  try
    result := true;
    buscas.close;
    buscas.SQL.Text :=
      'select extract(year from p.data_fech) as ANO, extract(month from p.data_fech) as MES,' +
      ' sum(pp.quant_ped_item) as QUANTIDADE' +
      ' from pedvenda p' +
      ' inner join pedvenda_prod pp on p.nped = pp.nped and p.cod_empresa = pp.cod_empresa and p.tipo = pp.tipo' +
      ' where ( (p.tipo = ''OS'' and p.tipo_os in ' + vDadosIni.vTipoVendaOS + ')' +
      ' or (p.tipo = ''REQ'' and p.tipv in ' + vDadosIni.vTipoVendaREQ + ') )' +
      ' and p.status_ped = ''FECHADA'' and p.ativo = 1 and p.tipo <> ''ORC'' and' +
      ' pp.cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and pp.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and p.data_fech >= :vdata and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and p.ativo = 1 group by 2,1 order by 2,1';
    buscas.ParamByName('vdata').AsDate := StrToDate(dataIni);
    buscas.Prepare;
    buscas.Open;
  except
    result := false;
  end;
end;

procedure TProdutos.VerificacaoGeralReplicacaoInternaProdutos;
var
  I, CountEmp: Integer;
  StrEmps: string;
  Aprods: TDataSet_OOP;
begin
  if not vDadosIni.PesqPros('PRO360', 'VERIFICACAO', '', 'PRODUTOS', '', buscas) then
    Exit;

  vDadosIni.verificarReplicacaoInterna(buscas);
  CountEmp := Length(vDadosIni.vReplicaoInternaEmpresa) + 1;
  if CountEmp <= 1 then
  begin
    ShowErro('Não existe configuração para replicação interna ou somente existe 1 empresa configurada no banco de dados');
    Exit;
  end;

  for I := Low(vDadosIni.vReplicaoInternaEmpresa) to High(vDadosIni.vReplicaoInternaEmpresa) do
    StrEmps := IfThen(I = Low(vDadosIni.vReplicaoInternaEmpresa), '', StrEmps + ',') +
               vDadosIni.vReplicaoInternaEmpresa[I];

  Aprods := TDataSet_OOP.Create(buscas.Database);

  try
    vDadosIni.abreStatusProcessamento('Replicação interna de produtos', 'Obtendo dados', True);
    Aprods.ClientOpen('select pr.grupo_prod, pr.cod_prod, count(pr.cod_empresa) qtde' +
                      ' from (select g.codigo_grup from grupos g) as gr' +
                      ' inner join produtos pr on pr.grupo_prod = gr.codigo_grup' +
                      ' where pr.cod_empresa in (%s)' +
                      ' group by 1, 2' +
                      ' having count(pr.cod_empresa) < %d', [StrEmps, CountEmp]).Last;

    if ShowConfirmacao('Total de %d produtos encontrados. Continuar?', [Aprods.dataSet.RecordCount]) <> IDYES then
      Exit;    

    vDadosIni.abreStatusProcessamento('Replicação interna de produtos = [' + IntToStr(Aprods.dataSet.RecordCount) + ']', 'Obtendo dados', True);

    Aprods.dataSet.First;
    while not Aprods.dataSet.Eof do
    begin
      vDadosIni.abreStatusProcessamento('',
        Format('Produto %d - Grupo: %d - Código: %s', [Aprods.dataSet.RecNo, Aprods.fint('grupo_prod'), Aprods.fstr('cod_prod')]), True);
      vDadosIni.produtos_replicacao_interna(Aprods.fint('grupo_prod'), Aprods.fstr('cod_prod'));

      Aprods.dataSet.Next;
    end;

  finally
    vDadosIni.fechaStatusProcessamento;
    FreeAndNil(Aprods);
  end;
end;

