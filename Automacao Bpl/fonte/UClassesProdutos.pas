  end
  else if dataSet.State = dsInsert then
  begin
    dataSet.FieldByName('GRUPO_PROD').AsInteger :=
      DatasetProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
    dataSet.FieldByName('COD_PROD').AsString :=
      DatasetProd.dataSet.FieldByName('COD_PROD').AsString;
    dataSet.FieldByName('COD_EMPRESA').AsInteger := strToInt(vDadosIni.codEmpresa);
    dataSet.FieldByName('COD_GRADE').AsInteger := 0;
    dataSet.FieldByName('DAT_CAD_CDBAR').AsDateTime := date;
    dataSet.FieldByName('DAT_MOD_CDBAR').AsDateTime := date;
    dataSet.FieldByName('ATIVO').AsInteger := 1;
  end;
end;

