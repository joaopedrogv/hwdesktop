function TProdutos.PesquisaAdicional(comEstoque: boolean; valorConsultaDtIni,
  valorConsultaDtFim, Campo, condicao, classe_prod, clinv, clpreco, clpop,
  clqtv, clfrv, clatl, PrimIndTec, SegIndTec, TercIndTec: string): string;
var
  sql, tipo, TipoItem, formatodata: string;
  i: integer;
begin
  sql := '';
  if comEstoque = True then
    sql := ' and PRODUTOS.est_f > 0';
  if classe_prod <> '' then
    sql := sql + ' and PRODUTOS.classe_prod =' + quotedstr(classe_prod);
  if clinv <> '' then
    sql := sql + ' and PRODUTOS.clinv =' + quotedstr(clinv);
  if clpreco <> '' then
    sql := sql + ' and PRODUTOS.clpreco =' + quotedstr(clpreco);
  if clpop <> '' then
    sql := sql + ' and PRODUTOS.clpop =' + quotedstr(clpop);
  if clqtv <> '' then
    sql := sql + ' and PRODUTOS.clqtv =' + quotedstr(clqtv);
  if clfrv <> '' then
    sql := sql + ' and PRODUTOS.clfrv =' + quotedstr(clfrv);
  if clatl <> '' then
    sql := sql + ' and PRODUTOS.clatl =' + quotedstr(clatl);
  if ((PrimIndTec <> '') or (SegIndTec <> '') or (TercIndTec <> '')) then
  begin
    sql := sql + 'and ( ';
    if (PrimIndTec <> '') then
    begin
      TipoItem := Copy(PrimIndTec, 0, 2);
      sql := sql + ' PRODUTOS.TIPO_ITEM =' + QuotedStr(TipoItem);
    end;
    if (SegIndTec <> '') then
    begin
      TipoItem := Copy(SegIndTec, 0, 2);
      if (PrimIndTec <> '') then
        sql := sql + ' or ';
      sql := sql + ' PRODUTOS.TIPO_ITEM =' + QuotedStr(TipoItem);
    end;
    if (TercIndTec <> '') then
    begin
      TipoItem := Copy(TercIndTec, 0, 2);
      if ((SegIndTec <> '') or (PrimIndTec <> '')) then
        sql := sql + ' or ';
      sql := sql + ' PRODUTOS.TIPO_ITEM =' + QuotedStr(TipoItem);
    end;
    sql := sql + ' )';
  end;
  if condicao = 'Igual' then
    condicao := '='
  else if condicao = 'Maior' then
    condicao := '>'
  else if condicao = 'Menor' then
    condicao := '<'
  else if condicao = 'Diferente' then
    condicao := '<>'
  else if (condicao = 'Esta contido') then
    condicao := 'like'
  else if (condicao = 'Começa') then
    condicao := 'Começa'
  else
    condicao := '=';
  for I := 0 to DataSet.FieldCount - 1 do
  begin
    if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(Campo) then
    begin
      Campo := DataSet.Fields[I].FieldName;
      if (Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
        (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField) then
        tipo := 'F'
      else if DataSet.Fields[i] is TStringField then
        tipo := 'S'
      else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
        tipo := 'D'
      else
        tipo := 'I';
      break;
    end;
  end;

  if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
    formatodata := 'mm/dd/yyyy'
  else if pos('.', ShortDateFormat) <> 0 then
    formatodata := 'dd.mm.yyyy';

  if valorConsultaDtIni <> '' then
    valorConsultaDtIni := QuotedStr(FormatDateTime(formatodata, strtodate(valorConsultaDtIni)));
  if valorConsultaDtFim <> '' then
    valorConsultaDtFim := QuotedStr(FormatDateTime(formatodata, strtodate(valorConsultaDtFim)));
    
  if trim(valorConsultaDtIni) <> '' then
  begin
    sql := sql + ' and PRODUTOS' + '.' + Campo + ' >= ' + valorConsultaDtIni +
    	' and PRODUTOS' + '.' + Campo + ' <= ' + valorConsultaDtFim;
  end;
  if trim(sql) <> '' then
    result := sql
  else
    result := '';
end;

