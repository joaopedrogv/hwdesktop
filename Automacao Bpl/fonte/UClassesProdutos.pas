begin

  vLista := TStringList.Create;
  vLista2 := TStringList.Create;
  vLista.Clear;
  vLista2.Clear;
  buscas.Close;
  buscas.SQL.Text:= 'select ARQUIVOS_BUSCA_PRECO from empresa' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;
  vLista.Text := buscas.FieldByName('ARQUIVOS_BUSCA_PRECO').AsString;

  vOK := False;
  for I := 0 to vLista.Count - 1 do
  begin
    if (UpperCase(pString) = UpperCase(vLista[I])) and (not vOK) then
      vOK := True
    else
      vLista2.Add(vLista[I]);
  end;

  buscas.Close;
  buscas.SQL.Text := 'update empresa set ARQUIVOS_BUSCA_PRECO = :ARQUIVOS_BUSCA_PRECO' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.ParamByName('ARQUIVOS_BUSCA_PRECO').AsString := vLista2.Text;
  buscas.ExecSQL;

  if buscas.Transaction.InTransaction then
  begin
    buscas.Transaction.Commit;
    Result := True;
  end;
end;

