function TPromocao.OrdenarDownGrid: boolean;
var
  vOrdem: Integer;
begin
  if not vDadosIni.PesqPros('PRO225', 'ORDENAR_BAIXO', '', 'PROMOCAO',
    dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, true) then
    Exit;

  vOrdem := dataSet.FieldByName('ORDEM').AsInteger;

  if (vOrdem = dataSet.RecordCount) then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' update promocao set ordem = ordem - 1 '
    + '  where  ordem = ' + IntToStr(dataSet.FieldByName('ORDEM').AsInteger + 1)
    + ' and cod_empresa = ' + vDadosIni.codEmpresa + '';
  buscas.ExecSQL;

  buscas.Close;
  buscas.SQL.Text := ' update promocao set ordem = ordem + 1 '
    + '  where  cod_promocao = ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger) +
    ' and cod_empresa = ' +
    vDadosIni.codEmpresa + ';';
  buscas.ExecSQL;

  buscas.Transaction.Commit;
  _abrePromocao;
  IndexFieldNames := 'ORDEM';
  FindNearest([vOrdem + 1]);
end;

function TPromocao.OrdenarUpGrid: boolean;
var
  vOrdem: Integer;
begin
  if not vDadosIni.PesqPros('PRO243', 'ORDENAR_CIMA', '', 'PROMOCAO',
    dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, true) then
    Exit;

  vOrdem := dataSet.FieldByName('ORDEM').AsInteger;

  if (vOrdem = 1) then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' update promocao set ordem = ordem + 1 '
    + '  where ordem = ' + IntToStr(dataSet.FieldByName('ORDEM').AsInteger - 1)
    + ' and cod_empresa = ' + vDadosIni.codEmpresa + '';
  buscas.ExecSQL;

  buscas.Close;
  buscas.SQL.Text := ' update promocao set ordem = ordem - 1 '
    + '  where  cod_promocao = ' + IntToStr(dataSet.FieldByName('COD_PROMOCAO').AsInteger) +
    ' and cod_empresa = ' +
    vDadosIni.codEmpresa + ';';
  buscas.ExecSQL;

  buscas.Transaction.Commit;
  _abrePromocao;
  IndexFieldNames := 'ORDEM';
  FindNearest([vOrdem - 1]);
end;

function TPromocao.post: boolean;
var
  acao: string;
  statusRegistro: string;
  vtestarcampovencimento: boolean;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO229', 'SALVAR', '', 'PROMOCAO',
    dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, False) then
    Exit;

  try

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsEdit then
    begin
      acao := 'EDITAR';
      statusRegistro := 'E';
    end
    else
    begin
      acao := 'INSERIR';
      statusRegistro := 'I';
    end;

    vtestarcampovencimento := (vDadosIni.vtpPreco = 'P')//(vTipoPreco.dataSet.FieldByName('TIPO').AsString = 'P')
      or (trim(dataSet.FieldByName('DATA_INI').AsString) <> '')
      or (trim(dataSet.FieldByName('DATA_FIM').AsString) <> '')
      or (trim(dataSet.FieldByName('HORA_INI').AsString) <> '')
      or (trim(dataSet.FieldByName('HORA_FIM').AsString) <> '');

    if Trim(dataSet.FieldByName('COD_TPPRECO').AsString) = '' then
      raiseExceptionCreate('Tipo de Preço não informada', 'DBEdit3');

    if Trim(dataSet.FieldByName('DESCR_PROMOCAO').AsString) = '' then
      raiseExceptionCreate('Descrição não informada', 'DBEdit2');

    if vtestarcampovencimento then
      if Trim(dataSet.FieldByName('DATA_INI').AsString) = '' then
        raiseExceptionCreate('Data Inicial deve ser informado!', 'DBEdit4');

    if vtestarcampovencimento then
      if Trim(dataSet.FieldByName('DATA_FIM').AsString) = '' then
        raiseExceptionCreate('Data Final deve ser informado!', 'DBEdit5');

    if vtestarcampovencimento then
      if (dataSet.FieldByName('DATA_INI').AsDateTime > dataSet.FieldByName('DATA_FIM').AsDateTime) then
        raiseExceptionCreate('Data final menor que data inicial!', 'DBEdit4');

    if vtestarcampovencimento then
      if (Trim(dataSet.FieldByName('HORA_INI').AsString) = '') then
        raiseExceptionCreate('Hora Inicial deve ser informado!', 'DBEdit6');

    if vtestarcampovencimento then
      if (Trim(dataSet.FieldByName('HORA_FIM').AsString) = '') then
        raiseExceptionCreate('Hora Final deve ser informado!', 'DBEdit7');

    if vtestarcampovencimento then
      if (dataSet.FieldByName('DATA_INI').AsDateTime = dataSet.FieldByName('DATA_FIM').AsDateTime)
       and (StrToTime(dataSet.FieldByName('HORA_INI').AsString) >= StrToTime(dataSet.FieldByName('HORA_FIM').AsString)) then
          raiseExceptionCreate('Data Inicial e Final são iguais, hora inicial não pode ser maior ou igual a hora final!', 'DBEdit4');

    if (acao = 'INSERIR') then
    begin
      if (vDadosIni.vtpPreco = 'P') then //(vTipoPreco.dataSet.FieldByName('TIPO').AsString = 'P') then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select coalesce(p.ordem, 0) ordem from promocao p' +
         ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa ' +
         ' where t.tipo = ''P'' ' +
         ' and p.cod_promocao > 0 ' +
         ' and p.cod_empresa= ' + vDadosIni.codEmpresa +
         ' order by p.ordem desc';
        buscas.Open;
        dataSet.FieldByName('ORDEM').AsInteger := buscas.FieldByName('ORDEM').AsInteger + 1;
      end
      else
        dataSet.FieldByName('ORDEM').AsInteger := 0;
    end
    else if (acao = 'EDITAR') then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select pr.cod_promocao,pr.grupo_prod, pr.cod_prod, ' +
        ' pr.data_ini, cast(cast(p.data_ini as date) ||'' ''||p.hora_ini as timestamp) as data_ini_p,' +
        ' pr.data_fim, cast(cast(p.data_fim as date) ||'' ''||p.hora_fim as timestamp) as data_fim_p  ' +
        ' from promocao_produto pr  inner join promocao p ' +
        ' on pr.cod_promocao = p.cod_promocao and pr.cod_tppreco = p.cod_tppreco and pr.cod_empresa = p.cod_empresa ' +
        ' where (cast(cast(p.data_ini as date) ||'' ''||p.hora_ini as timestamp) = pr.data_ini) ' +
        ' and   (cast(cast(p.data_fim as date) ||'' ''||p.hora_fim as timestamp) = pr.data_fim) ' +
        ' and pr.cod_promocao = ' + dataSet.FieldByName('COD_PROMOCAO').AsString +
        ' and pr.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
    end;

    if (vDadosIni.vtpPreco = 'P') then //(vTipoPreco.dataSet.FieldByName('TIPO').AsString = 'P') then
    begin
    	if (Length(dataSet.FieldByName('HORA_INI').AsString) > 4) and (Length(dataSet.FieldByName('HORA_INI').AsString) < 8) then
	    	dataSet.FieldByName('HORA_INI').AsString := dataSet.FieldByName('HORA_INI').AsString + ':' + Copy(dataSet.FieldByName('HORA_INI').AsString, 4, 2);
      if (Length(dataSet.FieldByName('HORA_FIM').AsString) > 4) and (Length(dataSet.FieldByName('HORA_FIM').AsString) < 8) then
	    	dataSet.FieldByName('HORA_FIM').AsString := dataSet.FieldByName('HORA_FIM').AsString + ':' + Copy(dataSet.FieldByName('HORA_FIM').AsString, 4, 2);
        
    	dataSet.FieldByName('HORA_INI').AsString := vDadosIni.IfThen((dataSet.FieldByName('HORA_INI').AsString = '00:00') or (dataSet.FieldByName('HORA_INI').AsString = '00:00:00'),
        '00:00:01', dataSet.FieldByName('HORA_INI').AsString);
      dataSet.FieldByName('HORA_FIM').AsString := vDadosIni.IfThen((dataSet.FieldByName('HORA_FIM').AsString = '00:00') or (dataSet.FieldByName('HORA_FIM').AsString = '00:00:00'),
        '23:59:59', dataSet.FieldByName('HORA_FIM').AsString);
      try
        dataSet.FieldByName('DATA_INI').AsDateTime :=
        	StrToDate(DateToStr(dataSet.FieldByName('DATA_INI').AsDateTime)) +
          StrToTime(vDadosIni.IfThen((dataSet.FieldByName('HORA_INI').AsString = '00:00') or (dataSet.FieldByName('HORA_INI').AsString = '00:00:00'),
          	'00:00:01', dataSet.FieldByName('HORA_INI').AsString));
      except
       raiseExceptionCreate('Hora Inicial incorreta!', 'DBEdit6');
      end;
      try
        dataSet.FieldByName('DATA_FIM').AsDateTime :=
        	StrToDate(DateToStr(dataSet.FieldByName('DATA_FIM').AsDateTime)) +
          StrToTime(vDadosIni.IfThen((dataSet.FieldByName('HORA_FIM').AsString = '00:00') or (dataSet.FieldByName('HORA_FIM').AsString = '00:00:00'),
          	'23:59:59', dataSet.FieldByName('HORA_FIM').AsString));
      except
        raiseExceptionCreate('Hora Final incorreta!', 'DBEdit7');
      end;
    end;

    if dataSet.State = dsInsert then
      dataSet.FieldByName('COD_PROMOCAO').AsInteger := Gencodigo('PROMOCAO', dtmProdutos.SpIncCodPromocao, vDadosIni.codEmpresa);

    Result := inherited Post;
    
    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO229', acao, 'SUCESSO', 'PROMOCAO',
        dataSet.FieldByName('COD_PROMOCAO').AsString, buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO229', acao, 'FALHA', 'PROMOCAO',
        dataSet.FieldByName('COD_PROMOCAO').AsString, buscas);
    end;

    vDadosIni.verificarReplicacaoInterna(buscas);
    if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
    begin
       vDadosIni.abreStatusProcessamento('', 'Replicando dados da promocao ');

       if not ReplicaPromocao(Self, statusRegistro) then
       begin
         RollBackTransacao;
         if teveReplicacao then
         begin
           Application.MessageBox('Erro ao replicar dados da promoção para as outras empresas' +
             chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
             MB_ICONERROR + MB_DEFBUTTON1);
         end;
       end
       else
       begin
         CommitaTransacao;
       end;
    end;

    vDadosIni.fechaStatusProcessamento;
    Result := true;
//    if Result then
//      _abrePrecoProdutos(pDateSet);

    if Result then
      Refresh;

  except on E: Exception do
    begin
      Result := false;
      vDadosIni.fechaStatusProcessamento;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TPromocao.ReplicaPromocao(DataSetPromocao: TPromocao;
  status: string): boolean;
var
  i, j, z: integer;
  vcamps: string;
  deletaCodBarra: boolean;
  buscas2: TIBQuery;
begin
  teveReplicacao := false;

  result := true;
  //  if DataSetCodBarras.AlterarGrupo = false then //Caso o grupo já tenha sido alterado através do próprio banco o a tabela codbarra já é alterada.
  //  begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  vDadosIni.verificarReplicacaoInterna(buscas);

  buscas.close;
  buscas.sql.Text := 'select * from PROMOCAO ' +
    ' where cod_promocao = :cod_promocao ' +
    ' and cod_empresa = :cod_empresa ' +
    ' and cod_tppreco = :cod_tppreco ';
  buscas.ParamByName('cod_promocao').AsInteger := DataSetPromocao.dataSet.FieldByName('COD_PROMOCAO').NewValue;
  buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('cod_tppreco').AsInteger := DataSetPromocao.dataSet.FieldByName('COD_TPPRECO').NewValue;
  buscas.Open;

  if Length(vDadosIni.vReplicaoInternaEmpresa) > 0 then
  begin
    for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
    begin
      if abreRepliPromocao(DataSetPromocao.dataSet.FieldByName('COD_PROMOCAO').NewValue,
      	StrtoInt(vDadosIni.vReplicaoInternaEmpresa[i]),
        DataSetPromocao.dataSet.FieldByName('COD_TPPRECO').NewValue) then
      begin
        buscas.First;
        while not buscas.eof do
        begin
          IndexFieldNames := 'COD_PROMOCAO;COD_EMPRESA;COD_TPPRECO';
          FindNearest([buscas.FieldByName('COD_PROMOCAO').AsInteger,
          	strtoint(vDadosIni.vReplicaoInternaEmpresa[i]),
            buscas.FieldByName('COD_TPPRECO').AsInteger]);
          if (dataSet.FieldByName('COD_PROMOCAO').AsInteger = buscas.FieldByName('COD_PROMOCAO').AsInteger)
          	and (dataSet.FieldByName('COD_EMPRESA').AsInteger = StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]))
            and (dataSet.FieldByName('COD_TPPRECO').AsInteger = buscas.FieldByName('COD_TPPRECO').AsInteger) then
          begin
            dataSet.Edit;
          end
          else
            dataSet.insert;

          for j := 0 to dataSet.FieldCount - 1 do
          begin
            for z := 0 to buscas.FieldCount - 1 do
          	begin
              if Dataset.Fields[j].FieldName = buscas.Fields[z].FieldName then
              begin
                if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
                  Dataset.Fields[j].value := buscas.FindField(Dataset.Fields[j].FieldName).Value;
                break;
              end;
            end;
          end;
          dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(vDadosIni.vReplicaoInternaEmpresa[i]);
		    dataSet.Post;

          if dataSet.ChangeCount > 0 then
          begin
            if apply then
              result := true
            else
            begin
              result := false;
              exit;
            end;
          end
          else
            result := true;

          buscas.Next;
        end;
      end;
    end;
    teveReplicacao := True;

  end;
  //  end;
end;

