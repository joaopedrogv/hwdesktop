function TNBS.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS329', 'SALVAR', '', 'NBS',
      dataSet.FieldByName('COD_NBS').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('COD_NBS').AsString) = '' then
      raiseExceptionCreate('Código NBS deve ser informado', 'DBEdit1');

    if acao = 'INSERIR' then
      if trim(dataSet.FieldByName('COD_NBS').AsString) <> '' then
      begin
        if _buscarNBS(dataSet.FieldByName('COD_NBS').AsString) then
          raiseExceptionCreate('Código NBS já existe no cadastro', 'DBEdit1');
      end;

    if trim(dataSet.FieldByName('DESCRICAO_NBS').AsString) = '' then
      raiseExceptionCreate('Descrição do NBS deve ser informado', 'DBEdit2');

    vDadosIni.vPesquisa := dataSet.FieldByName('COD_NBS').AsString;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS329', acao, 'SUCESSO', 'NBS',
        dataSet.FieldByName('COD_NBS').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS329', acao, 'FALHA', 'NBS',
        dataSet.FieldByName('COD_NBS').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

