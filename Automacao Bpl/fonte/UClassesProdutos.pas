procedure TProdutos._retornarIndice;
var
  vInd: string;
begin
  Vind := '';
  dataSet.IndexDefs.Clear;
  while pos('IDX$', pIndex) > 0 do
  begin
    if pos('IDX$D', pIndex) > 0 then
    begin
      pIndex := Copy(pIndex, 6, Length(pIndex));
      dataSet.IndexDefs.Add(pIndex, pIndex, [ixDescending]);
    end;
    if pos('IDX$A', pIndex) > 0 then
    begin
      pIndex := Copy(pIndex, 6, Length(pIndex));
      dataSet.IndexDefs.Add(pIndex, pIndex, []);
    end;
    vInd := 'S';
  end;

  try
    if vInd = 'S' then
      dataSet.IndexName := pIndex;
  except
  end;
end;

function TProdutos._retornaValorCalculadoEtiqueta(pObsEtiq: string): string;
var
	vtemp: string;
  vtempcampo: string;
  vcampo: string;
  vvalor: string;
  vresto: string;
	vObs: string;
  I: Integer;
  vtempini: string;
  vtempfim: string;
  voperador: string;
  vcampoenc: boolean;
begin
	try
  	vobs := pObsEtiq;
		if Pos('[@', vObs) = 0 then
    	Result := vObs
    else
    begin
      vtemp := vObs;
      while (Pos('[@', vtemp) > 0) and (Pos(']', vtemp) > 0) do
      begin
        vcampoenc:= false;
        vtempini := Copy(vtemp, 1, Pos('[@', vtemp) - 1);
        vtempfim := Copy(vtemp, Pos(']', vtemp) + 1, Length(vtemp) - Pos(']', vtemp));

        vcampo := Copy(vtemp, Pos('[@', vtemp), Pos(']', vtemp) + 1 - Pos('[@', vtemp));

        vvalor := '';
        if trim(vcampo) <> '' then
        begin
          vcampo := Copy(vcampo, 3, Length(vcampo) - 3);
          vtempcampo := vcampo;

          voperador := '';
          if (Pos('*', vcampo) > 0) then
          begin
          	voperador := '*';
          	vcampo := Copy(vcampo, 1, Pos('*', vcampo) - 1);
            vresto := Copy(vtempcampo,
            								Length(vcampo + voperador) + 1,
                            Length(vtempcampo) - Length(vcampo + voperador));
          end
          else if (Pos('/', vcampo) > 0) then
          begin
          	voperador := '/';
          	vcampo := Copy(vcampo, 1, Pos('/', vcampo) - 1);
            vresto := Copy(vtempcampo,
            								Length(vcampo + voperador) + 1,
              							Length(vtempcampo) - Length(vcampo + voperador));
          end
          else if (Pos('+', vcampo) > 0) then
          begin
          	voperador := '+';
          	vcampo := Copy(vcampo, 1, Pos('+', vcampo) - 1);
            vresto := Copy(vtempcampo,
            							  Length(vcampo + voperador) + 1,
                            Length(vtempcampo) - Length(vcampo + voperador));
          end
          else if (Pos('-', vcampo) > 0) then
          begin
          	voperador := '-';
          	vcampo := Copy(vcampo, 1, Pos('-', vcampo) - 1);
            vresto := Copy(vtempcampo,
            						    Length(vcampo + voperador) + 1,
                            Length(vtempcampo) - Length(vcampo + voperador));
          end;

          if ContainsStr(vresto, '*') then
          begin
            Result := pObsEtiq;
            Exit;
          end
          else if ContainsStr(vresto, '/') then
          begin
            Result := pObsEtiq;
            Exit;
          end
          else if ContainsStr(vresto, '+') then
          begin
            Result := pObsEtiq;
            Exit;
          end
          else if ContainsStr(vresto, '-') then
          begin
            Result := pObsEtiq;
            Exit;
          end;

          for I := 0 to DataSet.FieldCount - 1 do
          begin
            if UpperCase(Dataset.Fields[I].FieldName) = UpperCase(vcampo) then
            begin
              vcampoenc := true;
              if dataSet.Fields[i].DataType = ftCurrency then
              begin
              	if (voperador = '*') and (trim(vresto) <> '') then
                	vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat * StrToFloat(vresto))
                else if (voperador = '/') and (trim(vresto) <> '') then
                	vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat / StrToFloat(vresto))
                else if (voperador = '+') and (trim(vresto) <> '') then
                	vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat + StrToFloat(vresto))
                else if (voperador = '-') and (trim(vresto) <> '') then
                	vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat - StrToFloat(vresto))
                else
                	vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat);
              end
              else if dataSet.Fields[i].DataType = ftFloat then
              begin
                if trim(dataSet.Fields[i].EditMask) <> '' then
                begin
                  if (voperador = '*') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat * StrToFloat(vresto))
                  else if (voperador = '/') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat / StrToFloat(vresto))
                  else if (voperador = '+') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat + StrToFloat(vresto))
                  else if (voperador = '-') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat - StrToFloat(vresto))
                  else
                		vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat);
                end
                else
                begin
                	if (voperador = '*') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat * StrToFloat(vresto))
                  else if (voperador = '/') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat / StrToFloat(vresto))
                  else if (voperador = '+') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat + StrToFloat(vresto))
                  else if (voperador = '-') and (trim(vresto) <> '') then
                  	vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat - StrToFloat(vresto))
                  else
                  	vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat);
                end;
              end
              else if dataSet.Fields[i].DataType = ftInteger then
                vvalor := IntToStr(Dataset.Fields[I].AsInteger)
              else if not Dataset.Fields[I].IsNull then
              begin
                if dataSet.Fields[i].DataType = ftDateTime then
                  vvalor := FormatDateTime('dd/mm/yyyy', Dataset.Fields[I].AsDateTime)
                else if dataSet.Fields[i].DataType = ftDate then
                  vvalor := FormatDateTime('dd/mm/yyyy', Dataset.Fields[I].AsDateTime)
                else if dataSet.Fields[i].DataType = ftString then
                  vvalor := trim(Dataset.Fields[I].AsString)
                else
                  vvalor := Dataset.Fields[I].Value;
              end;
              Break;
            end;
          end;

          if not vcampoenc then
          begin
            vvalor := '[@' + vcampo + ']';
            Break;
          end;
        end;

        vtemp := vtempini + vvalor + vtempfim;
      end;

      Result := vtemp;
    end;
  except
    on e: exception do
    begin
    	Result := '';
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('TProdutos._retornaValorCalculadoEtiqueta. Erro: ' + e.Message);
    end;
  end;
end;

