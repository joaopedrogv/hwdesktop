function TAlteracaoPreco.calcularAlteracao: boolean;
var
  vValorCalcAVista, vValorCalc30Dias, vValorCalc60Dias, vValorCalc90Dias, vValorCalcAtacado, vValorCalcDiferenciado, vValorCalcPromocao: Double;
  mk, pr: Double;
begin

  try
    if not (dataSet.State in [dsinsert, dsEdit]) then
      dataSet.Edit;
    try

      if vFinalidade = 'AJUSTE' then
      begin
        if FpermitAltPerc30 then
          dataSet.FieldByName('PERC_AD_30').AsFloat := vCampo30Dias;
        if FpermitAltPerc60 then
          dataSet.FieldByName('PERC_AD_60').AsFloat := vCampo60Dias;
        if FpermitAltPerc90 then
          dataSet.FieldByName('PERC_AD_90').AsFloat := vCampo90Dias;

        if vEfetuarAlteracaoPeloAjuste then
        begin
          if FpermitAltPrec30 then
            dataSet.FieldByName('PREC_30_PROD').AsFloat :=
              dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
              (dataSet.FieldByName('PREC_TAB_PROD').AsFloat * vCampo30Dias / 100);
          if FpermitAltPrec60 then
            dataSet.FieldByName('PREC_60_PROD').AsFloat :=
              dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
              (dataSet.FieldByName('PREC_TAB_PROD').AsFloat * vCampo60Dias / 100);
          if FpermitAltPrec90 then
            dataSet.FieldByName('PREC_90_PROD').AsFloat :=
              dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
              (dataSet.FieldByName('PREC_TAB_PROD').AsFloat * vCampo90Dias / 100);
        end;
      end
      else
      begin
        vValorCalcAVista := 0;
        vValorCalc30Dias := 0;
        vValorCalc60Dias := 0;
        vValorCalc90Dias := 0;
        vValorCalcDiferenciado := 0;
        vValorCalcPromocao := 0;
        vValorCalcAtacado := 0;

        if FpermitAltPrecAvista then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (not vValorFixo) then
            vValorCalcAVista := dataSet.FieldByName('PREC_TAB_PROD').AsFloat * vCampoAVista / 100
          else
            vValorCalcAVista := vCampoAVista;
        end;

        if FpermitAltPrec30 then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (not vValorFixo) then
            vValorCalc30Dias := dataSet.FieldByName('PREC_30_PROD').AsFloat * vCampo30Dias / 100
          else
            vValorCalc30Dias := vCampo30Dias;
        end;

        if FpermitAltPrec60 then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (not vValorFixo) then
            vValorCalc60Dias := dataSet.FieldByName('PREC_60_PROD').AsFloat * vCampo60Dias / 100
          else
            vValorCalc60Dias := vCampo60Dias;
        end;

        if FpermitAltPrec90 then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (not vValorFixo) then
            vValorCalc90Dias := dataSet.FieldByName('PREC_90_PROD').AsFloat * vCampo90Dias / 100
          else
            vValorCalc90Dias := vCampo90Dias;
        end;

        if FpermitAltPrecAtacado then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (not vValorFixo) then
            vValorCalcAtacado := dataSet.FieldByName('PREC_PUBLICO').AsFloat * vCampoAtacado / 100
          else
            vValorCalcAtacado := vCampoAtacado;
        end;

        if ((FpermitAltPrecDiferenciado) and (vTipoDifPro = 'T')) then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (vDiferenciado) and (not vValorFixo) then
            vValorCalcDiferenciado := dataSet.FieldByName('VALOR_PROMOCAO').AsFloat * vCampoDiferenciado / 100
          else
          	vValorCalcDiferenciado := vCampoDiferenciado;
        end;

        if ((FpermitAltPrecPromocao) and (vTipoDifPro = 'P')) then
        begin
          if (pos('PERCENTUAL', vModalidade) > 0) and (vPromocao) and (not vValorFixo) then
          begin
          	if (dataSet.FieldByName('VALOR_PROMOCAO').AsFloat > 0) then
              vValorCalcPromocao := dataSet.FieldByName('VALOR_PROMOCAO').AsFloat * vCampoPromocao / 100
            else
              vValorCalcPromocao := vCampoPromocao;
          end;
        end;

        if vReducao then
        begin
          vValorCalcAVista := vValorCalcAVista * (-1);
          vValorCalc30Dias := vValorCalc30Dias * (-1);
          vValorCalc60Dias := vValorCalc60Dias * (-1);
          vValorCalc90Dias := vValorCalc90Dias * (-1);
          vValorCalcAtacado := vValorCalcAtacado * (-1);
          vValorCalcDiferenciado := vValorCalcDiferenciado * (-1);
          vValorCalcPromocao := vValorCalcPromocao * (-1);
        end;

        if FpermitAltPrecAvista then
          if ((dataSet.FieldByName('PREC_TAB_PROD').AsFloat + vValorCalcAVista) > 0) or (vValorCalcAVista > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('PREC_TAB_PROD').AsFloat := vCampoAVista
            else
	            dataSet.FieldByName('PREC_TAB_PROD').AsFloat := dataSet.FieldByName('PREC_TAB_PROD').AsFloat + vValorCalcAVista;
          end;

        if FpermitAltPrec30 then
        begin
          if ((dataSet.FieldByName('PREC_30_PROD').AsFloat + vValorCalc30Dias) > 0) or (vValorCalc30Dias > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('PREC_30_PROD').AsFloat := vCampo30Dias
            else
	            dataSet.FieldByName('PREC_30_PROD').AsFloat := dataSet.FieldByName('PREC_30_PROD').AsFloat + vValorCalc30Dias;
          end;
          {
          if (FpermitAltPrec30)
          	and (not FpermitAltPrecAvista)
          	and (dataSet.FieldByName('PREC_30_PROD').AsFloat > 0)
         		and (dataSet.FieldByName('MAX_DESC_ITEM').AsFloat > 0)
          	and (vDadosIni.vProduto.vMaxDescPrecoAVista = 'S') then
          begin
            dataSet.FieldByName('PREC_TAB_PROD').AsFloat := RoundTo(
              dataSet.FieldByName('PREC_30_PROD').AsFloat -
              (dataSet.FieldByName('PREC_30_PROD').AsFloat *
               dataSet.FieldByName('MAX_DESC_ITEM').AsFloat / 100), -2);
          end;
          }
        end
      	else if (not FpermitAltPrec30)
        	and (FpermitAltPrecAvista)
        	and (not dataSet.FieldByName('PERC_AD_30').IsNull)
          and (dataSet.FieldByName('PERC_AD_30').AsFloat <> 0) then
        begin
				  dataSet.FieldByName('PREC_30_PROD').AsFloat := RoundTo(
          	dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
          	((dataSet.FieldByName('PREC_TAB_PROD').AsFloat * dataSet.FieldByName('PERC_AD_30').AsFloat ) / 100), -2);
        end;

        if FpermitAltPrec60 then
        begin
          if ((dataSet.FieldByName('PREC_60_PROD').AsFloat + vValorCalc60Dias) > 0) or (vValorCalc60Dias > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('PREC_60_PROD').AsFloat := vCampo60Dias
            else
	            dataSet.FieldByName('PREC_60_PROD').AsFloat := dataSet.FieldByName('PREC_60_PROD').AsFloat + vValorCalc60Dias;
          end;
        end
        else if (not FpermitAltPrec60)
        	and (FpermitAltPrecAvista)
        	and (not dataSet.FieldByName('PERC_AD_60').IsNull)
          and (dataSet.FieldByName('PERC_AD_60').AsFloat <> 0) then
        begin
          dataSet.FieldByName('PREC_60_PROD').AsFloat := RoundTo(
          	dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
          	((dataSet.FieldByName('PREC_TAB_PROD').AsFloat * dataSet.FieldByName('PERC_AD_60').AsFloat) / 100), -2);
        end;

        if FpermitAltPrec90 then
        begin
          if ((dataSet.FieldByName('PREC_90_PROD').AsFloat + vValorCalc90Dias) > 0) or (vValorCalc90Dias > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('PREC_90_PROD').AsFloat := vCampo90Dias
            else
	            dataSet.FieldByName('PREC_90_PROD').AsFloat := dataSet.FieldByName('PREC_90_PROD').AsFloat + vValorCalc90Dias;
          end;
        end
        else if (not FpermitAltPrec90)
        	and (FpermitAltPrecAvista)
        	and (not dataSet.FieldByName('PERC_AD_90').IsNull)
          and (dataSet.FieldByName('PERC_AD_90').AsFloat <> 0) then
        begin
			    dataSet.FieldByName('PREC_90_PROD').AsFloat := RoundTo(
          	dataSet.FieldByName('PREC_TAB_PROD').AsFloat +
			      ((dataSet.FieldByName('PREC_TAB_PROD').AsFloat * dataSet.FieldByName('PERC_AD_90').AsFloat) / 100), -2);
        end;

        if FpermitAltPrecAtacado then
        begin
          if ((dataSet.FieldByName('PREC_PUBLICO').AsFloat + vValorCalcAtacado) > 0) or (vValorCalcAtacado > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('PREC_PUBLICO').AsFloat := vCampoAtacado
            else
	            dataSet.FieldByName('PREC_PUBLICO').AsFloat := dataSet.FieldByName('PREC_PUBLICO').AsFloat + vValorCalcAtacado;
          end;

          if (FpermitAltPrecAtacado)
          	and (not dataSet.FieldByName('PERC_TB_PRODA').IsNull)
            and (dataSet.FieldByName('PERC_TB_PRODA').AsFloat <> 0)
//          	and (trim(vDadosIni.vEmp.vALT_PERC_MARGEM) = 'S') then
          	and (vDadosIni.vProduto.Precos.ManterPrecoMarkupProporcional) then
          begin
            if (dataSet.FieldByName('PREC_CUSM_PROD').AsFloat > 0)
            	and (dataSet.FieldByName('PREC_PUBLICO').AsFloat > 0) then //PERC_TB_PRODA
            begin
              mk := RoundTo((((dataSet.FieldByName('PREC_PUBLICO').AsFloat -
              	dataSet.FieldByName('PREC_CUSM_PROD').AsFloat) * 100) /
                dataSet.FieldByName('PREC_CUSM_PROD').AsFloat), -2);

              //Preco com o markup antigo
              pr := RoundTo(dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
              	(1 + (dataSet.FieldByName('PERC_TB_PRODA').AsFloat / 100)), 0 - vDadosIni.vEmp.vCasasDecimais) + 0.01;
                
              if RoundTo(dataSet.FieldByName('PREC_PUBLICO').AsFloat, 0 - vDadosIni.vEmp.vCasasDecimais) <> RoundTo(pr, 0 - vDadosIni.vEmp.vCasasDecimais) then
              	dataSet.FieldByName('PERC_TB_PRODA').AsFloat := mk;
            end;
          end;
        end;

        if ((FpermitAltPrecDiferenciado) and (vTipoDifPro = 'T')) then
          if ((dataSet.FieldByName('VALOR_PROMOCAO').AsFloat + vValorCalcDiferenciado) > 0) or (vValorCalcDiferenciado > 0) then
          begin
          	if vValorFixo then
            	dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := vCampoDiferenciado
            else
	            dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := dataSet.FieldByName('VALOR_PROMOCAO').AsFloat + vValorCalcDiferenciado;
          end;

        if ((FpermitAltPrecPromocao) and (vTipoDifPro = 'P')) then
          if dataSet.FieldByName('VALOR_PROMOCAO').AsFloat > 0 then
          begin
            if ((dataSet.FieldByName('VALOR_PROMOCAO').AsFloat + vValorCalcPromocao) > 0) or (vValorCalcPromocao > 0) then
            begin
            	if vValorFixo then
              	dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := vCampoPromocao
              else
	              dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := dataSet.FieldByName('VALOR_PROMOCAO').AsFloat + vValorCalcPromocao;
            end;
          end
          else if dataSet.FieldByName('PORCENTAGEM').AsFloat > 0 then
          begin
            if ((dataSet.FieldByName('PORCENTAGEM').AsFloat + vValorCalcPromocao) > 0) or (vValorCalcPromocao > 0) then
            begin
            	if vValorFixo then
              begin
              	dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := vCampoPromocao;
                dataSet.FieldByName('PORCENTAGEM').AsFloat := 0;
              end
              else
	              dataSet.FieldByName('PORCENTAGEM').AsFloat := dataSet.FieldByName('PORCENTAGEM').AsFloat + vValorCalcPromocao;
            end;
          end;
      end;

      Result := True;

    finally

      if (dataSet.State in [dsinsert, dsEdit]) then
        dataSet.Post;

      aplicarCasasDecimaisEmpresa;

      montarEExecutarUpdate;

    end;
  except
    on e: exception do
    begin
      Result := False;
      cancelar;
      Application.MessageBox(pchar('Erro na alteração/ajuste de preços. Erro: ' + e.Message),
        'Atenção', 0 + 64);
    end;
  end;
end;

