function TKitsProdutos.delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Kit: string;
  vDesc_Kit: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar   := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Kit  := trim(dataSet.FieldByName('CODIGO_KIT').AsString);
      vDesc_Kit := trim(dataSet.FieldByName('DESCRICAO_KIT').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar   := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Kit  := '';
        vDesc_Kit := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Kit) <> '') then
        prepare_loop('CODIGO_KIT = ' + vCod_Kit)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'KIT' + #13 +
          'Código: ' + vCod_Kit + #13 +
          'Descrição: ' + vDesc_Kit;

        if (trim(vCod_Kit) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO113', 'EXCLUIR', '', 'KITS_PROD',
          vDadosIni.IfThen(trim(vCod_Kit) <> '', vCod_Kit, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'KIT' + #13 +
          'Código: ' + vCod_Kit + #13 +
          'Descrição: ' + vDesc_Kit;

        if (trim(vCod_Kit) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO114', 'EXCLUIR', '', 'KITS_PROD',
           vDadosIni.IfThen(trim(vCod_Kit) <> '', vCod_Kit, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo kit(s) de produto permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo kit(s) de produto para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo kit(s) de produto permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo kit(s) de produto para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' update kits_prod set ativo = 99 ' +
            ' where codigo_kit = %d ' +
            ' and cod_empresa = %d ',
            [fint('codigo_kit'), fint('cod_empresa')], buscas);
          if (trim(vCod_Kit) = '') then
            vDadosIni.GravaAuditoria('PRO113', 'EXCLUIR', '', 'KITS_PROD',
              dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
        end
        else
        begin
          SqlExec(' update kits_prod set ativo = 0 ' +
            ' where codigo_kit = %d ' +
            ' and cod_empresa = %d ',
            [fint('codigo_kit'), fint('cod_empresa')], buscas);

          if (trim(vCod_Kit) = '') then
            vDadosIni.GravaAuditoria('PRO114', 'EXCLUIR', '', 'KITS_PROD',
              dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO113', 'PRO114'),
        'EXCLUIR', 'SUCESSO', 'KITS_PROD',
        vDadosIni.IfThen(trim(vCod_Kit) <> '', vCod_Kit, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO113', 'PRO114'),
        'EXCLUIR', 'FALHA', 'KITS_PROD',
        vDadosIni.IfThen(trim(vCod_Kit) <> '', vCod_Kit, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

