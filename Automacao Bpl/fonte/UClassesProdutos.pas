procedure TProdutos.ChecarCestCompativel;
var
  Cests: TCestsM;
  FoundCEST: Boolean;
  I: Integer;
begin
  if str_empty('nbm') then
    Exit;

  Cests := TCest_Builder.GetCest(fstr('nbm'), dtmAtivo.bancoHw, vDadosIni.codEmpresa);
  try
    for I := Cests.Count - 1 downto 0 do
      if StartsText('28', Cests.Items[I].cest) then
        Cests.Delete(I);

    if Cests.Count = 1 then
    begin
      if fdif('CEST', Cests.Items[0].cest) then
        if ShowConfirmacao('CEST divergente. Alterar de %s para %s?',
                           [FormatMaskText('00\.000\.00;0;', fstr('CEST')),
                            FormatMaskText('00\.000\.00;0;', Cests.Items[0].cest)]) = IDYES then
        dataSet.FieldByName('CEST').AsString := Cests.Items[0].cest;
    end
    else if Cests.Count > 1 then
    begin
      FoundCEST := False;
      for I := 0 to Cests.Count - 1 do
        if FoundCEST then
          Break
        else
          FoundCEST := not fdif('cest', Cests.Items[I].cest);

      if not FoundCEST then
        if ShowConfirmacao('CEST divergente. Selecionar o correto?') = IDYES then
          if Assigned(FCestChange) then
            FCestChange(Cests);
    end;

  finally
    FreeAndNil(Cests);
  end;
end;

