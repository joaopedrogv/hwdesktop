  query.SQL.Text := 'SELECT distinct(NUM_BANCA) FROM PRODUTOS WHERE EM_PROMOCAO=''S'' and ativo=1' +
    ' and COD_EMPRESA =' + vDadosIni.codEmpresa;
  query.Open;
  query.FetchAll;
end;

