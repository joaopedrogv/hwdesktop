  		      vprec_cusm_prodTot := vprec_cusm_prodTot + buscas2.FieldByName('prec_cusm_prod').AsCurrency;
	   	  	  vprec_tab_prodTot := vprec_tab_prodTot + buscas2.FieldByName('prec_tab_prod').AsCurrency;
    		    vprec_publicoTot := vprec_publicoTot + buscas2.FieldByName('prec_publico').AsCurrency;
       			vest_fTot := vest_fTot + buscas2.FieldByName('est_f').AsCurrency;

