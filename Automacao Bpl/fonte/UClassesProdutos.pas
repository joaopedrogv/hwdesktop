function TGrupoProdSimilaresItens.AlterarProdPrincipal(Grupo: TGrupoProdSimilares): boolean;
var
  codigo: Integer;
  grupoprod: Integer;
  codprod: string;
  descrprod: string;
begin
  try
    Result := false;

    if dataSet.IsEmpty then
    	exit;

    codigo := dataset.FieldByName('COD_GRUPO_SIM').AsInteger;
    grupoprod := dataset.FieldByName('GRUPO_PROD').AsInteger;
    codprod := dataset.FieldByName('COD_PROD').AsString;
    descrprod := dataset.FieldByName('DESCR_PROD').AsString;

    if not vDadosIni.PesqPros('PRO359', 'ALTERAR', '', 'PROD_SIMILARES_GRUPOS_ITENS', '', buscas, true) then
      exit;

    dataSet.First;
    while not dataSet.Eof do
    begin
    	dataSet.Edit;
      if (grupoprod = dataset.FieldByName('GRUPO_PROD').AsInteger)
      	and (trim(codprod) = trim(dataset.FieldByName('COD_PROD').AsString)) then
        dataSet.FieldByName('PRINCIPAL').Value := 'S'	
      else
      	dataSet.FieldByName('PRINCIPAL').Value := 'N';
      dataSet.Post;

    	dataSet.Next;
