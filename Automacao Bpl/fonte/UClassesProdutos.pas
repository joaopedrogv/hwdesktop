function TDsgs.ChecaDsgs: boolean;
begin
  result := true;
  if ExecutaComandosSql('SELECT * FROM G_DSGS WHERE COD_DSGS = ' +
    quotedstr(dataSet.FieldByName('COD_DSGS').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1') or
    (dataset.FieldByName('COD_DSGS').AsString = '') then
  begin
    if dataset.FieldByName('COD_DSGS').AsString = '' then
