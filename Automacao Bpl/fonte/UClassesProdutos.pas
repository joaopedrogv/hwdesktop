function TProdutosPrecoQtde.Delete(pDateSet: TDataSet): boolean;
var
  vTemp: string;
  I: Integer;
  vGrupoProd: string;
  vCodProd: string;
  vQuant: string;
  vSigla: string;
begin
	try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    try
  	  vGrupoProd     := dataSet.FieldByName('GRUPO_PROD').AsString;
      vCodProd       := dataSet.FieldByName('COD_PROD').AsString;
      vQuant         := FloatToStr(dataSet.FieldByName('QUANT').AsFloat);
      vSigla         := dataSet.FieldByName('SIGLA').AsString;

      prepare_loop('Sel = ''S''');

      if not dataset.IsEmpty then
      begin
        vGrupoProd     := '';
        vCodProd       := '';
        vQuant         := '';
        vSigla         := '';
      end;
    finally
      prepare_loop_done;
    end;

    vDadosIni.verificarReplicacaoInterna(buscas, true);

    try
      if (trim(vGrupoProd) <> '') then
        prepare_loop('GRUPO_PROD = ' + vGrupoProd +
          ' AND COD_PROD = ' + vCodProd +
          ' AND QUANT = ' + vQuant +
          ' AND SIGLA = ' + QuotedStr(vSigla))
      else
        prepare_loop('Sel = ''S''');

      vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
        'Tipo Venda: ' + retornaSigla(trim(dataSet.FieldByName('SIGLA').AsString)) + #13 + #13 +
        'PRODUTO' + #13 +
        'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString + #13 +
        'Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString + #13 +
        'Quant: ' + FormatFloat('0.000', dataSet.FieldByName('QUANT').AsFloat);

      if (trim(vGrupoProd) = '') then
        vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente' +
          vDadosIni.IfThen(Length(vDadosIni.vReplicaoInternaEmpresa) > 1, ' em todas empresas', '') + '?';

      if not vDadosIni.PesqPros('PRO306', 'EXCLUIR',
      	'', 'PROMOCAO_PRODUTO',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd + '-' +
          vSigla + '-' +
          vQuant, ''), buscas, false) then
            Exit;

//      if pPergura then
        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;

      try
      	dataSet.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
          for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
          begin
            buscas.Close;
            buscas.SQL.Text := ' DELETE FROM PRECO_PRODUTOS_QTDE ' +
              ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND QUANT = :QUANT ' +
              ' AND SIGLA = :SIGLA ';
            buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
            buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
            buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
            buscas.ParamByName('QUANT').AsFloat := dataSet.FieldByName('QUANT').AsFloat;
            buscas.ParamByName('SIGLA').AsString := dataSet.FieldByName('SIGLA').AsString;
            buscas.ExecSQL;
          end;

          vDadosIni.GravaAuditoria('PRO306', 'EXCLUIR', '',
            'PRECO_PRODUTOS_QTDE',
            trim(dataSet.FieldByName('GRUPO_PROD').AsString) + '-' +
            trim(dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
            trim(dataSet.FieldByName('SIGLA').AsString) + ' - ' +
            FloatToStr(dataSet.FieldByName('QUANT').AsFloat), buscas);

          dataset.Next;
        end;
      finally
        dataSet.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
    	prepare_loop_done;
    end;

    Result := CommitaTransacao;

    if Result then
    begin
			vDadosIni.GravaAuditoria('PRO306', 'EXCLUIR', 'SUCESSO',
      	'PRECO_PRODUTOS_QTDE',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd + '-' +
          vSigla + '-' +
          vQuant, ''), buscas);
    end
    else
    begin
      vDadosIni.GravaAuditoria('PRO306', 'EXCLUIR', 'FALHA',
      	'PRECO_PRODUTOS_QTDE',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd + '-' +
          vSigla + '-' +
          vQuant, ''), buscas);
    end;

    _abrePrecoProdutos(pDateSet);
  except on E: Exception do
    begin
      buscas.Transaction.Rollback;
      vDadosIni.fechaStatusProcessamento;
      vDadosIni.GravaAuditoria('PRO306', 'EXCLUIR', 'FALHA',
      	'PRECO_PRODUTOS_QTDE',
        vDadosIni.IfThen(trim(vGrupoProd) <> '',
        	vGrupoProd + '-' +
        	vCodProd + '-' +
          vSigla + '-' +
          vQuant, ''), buscas);
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosPrecoQtde.DeleteTodosPrecoPorQtde: boolean;
var
  vTemp: string;
begin
  Result := False;

  if dataSet.IsEmpty then
    exit;

  vTemp := 'Grupo ' + dataSet.FieldByName('GRUPO_PROD').AsString +
  	' Cod ' + dataSet.FieldByName('COD_PROD').AsString;

  if not vDadosIni.PesqPros('PRO307', 'EXCLUIR', vTemp, 'PROMOCAO_PRODUTO',
