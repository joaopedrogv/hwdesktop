  vporcentagemtemp: Double;
  vinf: string;
begin
  Result := False;

  vinf := 'P';
  vvalortemp := valor;
  vporcentagemtemp := porcentagem;

  if not vDadosIni.PesqPros('PRO240', 'SALVAR', '', 'PROMOCAO_PRODUTO',
    grupo_prod + '-' + cod_prod + '-' + cod_promocao, buscas, False) then
    Exit;

  try
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if (cod_promocao = '') then
    begin
      if vPromocao.dataSet.FieldByName('TIPO').AsString = 'P' then
        raiseExceptionCreate('Promoção deve ser informado!', 'DBLookupComboBox6')
      else
        raiseExceptionCreate('Preço Tabela deve ser informado!', 'DBLookupComboBox6');
      exit;
    end;

    if not existePromocao(cod_promocao) then
    begin
      if vDadosIni.vtpPreco = 'P' then
        raiseExceptionCreate('Promoção deve ser informado!', 'DBLookupComboBox6')
      else
        raiseExceptionCreate('Preço Tabela deve ser informado!', 'DBLookupComboBox6');
    end;

    if ((valor <= 0) and (porcentagem = 0) and (markup <= 0)) then
      raiseExceptionCreate('Valor, Markup, Margem ou ' + vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' deve ser informado!', 'EditHw2');

    if Abs(porcentagem) >= 100 then
    	raiseExceptionCreate(vDadosIni.IfThen(vDadosIni.vtpPreco = 'P', 'Desconto', 'Acresc/Desc') +
      	' (%) não deve ser maior ou igual a 100%!', 'EditHw3');

    if desc_max < 0 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser menor que 0%!', 'EditHw1');

    if desc_max >= 100 then
    	raiseExceptionCreate('Desconto máximo (%) não dever ser maior ou igual a 100%!', 'EditHw1');

    if vDadosIni.vtpPreco = 'P' then
      if (data_ini = '') then
        raiseExceptionCreate('Data Inicial deve ser informado!', 'DBEdit100');

    if vDadosIni.vtpPreco = 'P' then
      if (data_fim = '') then
        raiseExceptionCreate('Data Final deve ser informado!', 'DBEdit101');

    if vDadosIni.vtpPreco = 'P' then
      if (sigla = '') then
