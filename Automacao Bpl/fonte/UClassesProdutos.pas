//	    Grupo.dataSet.Edit;
//    Grupo.dataSet.FieldByName('DESCR_GRUPO').AsString := Copy(trim(descrprod), 1, 75);
//    Grupo.dataSet.Post;
//    Grupo.Apply;
//
    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;

    if Apply then
    begin
      CommitaTransacao;
      result := True;
    end
    else
    begin
    	Cancel;
      RollBackTransacao;
      Result := False;
    end;

    if Result then
      vDadosIni.GravaAuditoria('PRO359', 'ALTERAR', 'SUCESSO - ' +
      	'Grupo Prod: ' + IntToStr(grupoprod) +
        'Cod Prod: ' + trim(codprod),
