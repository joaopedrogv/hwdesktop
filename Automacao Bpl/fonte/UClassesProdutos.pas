function TItKitsProdutos.delete(pKit: TKitsProdutos; pCommitar: boolean): boolean;
var
	vCodigo: string;
  vGrupoProd: string;
  vCodProd: string;
  vtemp: string;
begin
	Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodigo := dataSet.FieldByName('CODIGO_KIT').AsString;
  vGrupoProd := dataSet.FieldByName('GRUPO_PROD').AsString;
  vCodProd := dataSet.FieldByName('COD_PROD').AsString;
  
  if not vDadosIni.PesqPros('PRO122', 'EXCLUIR',
  	vGrupoProd + ' - ' + vCodProd,
    'KITS_PROD_KITS', vCodigo, buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja remover este produto ?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
  begin
  	if vDadosIni.vEcommerce.vHabilitarEcommerce then
    begin
    	buscas.Close;
      buscas.SQL.Text := ' select id_commerce, sinc_ecommerce from kits_prod_ec ' +
        ' where codigo_kit = ' + vCodigo +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if ((buscas.FieldByName('id_commerce').AsInteger > 0) or (buscas.FieldByName('sinc_ecommerce').AsString = 'S')) then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select count(*) qtde from kits_prod_kits ' +
          ' where codigo_kit = ' + vCodigo +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          vDadosIni.IfThen(not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos,
	        ' and sinc_ecommerce = ''S'' ', '');
        buscas.Open;

        if buscas.FieldByName('qtde').AsInteger <= 2 then
        begin
        	vtemp := 'Produto não pode ser removido pois no E-Commerce é obrigatório ter dois ou mais produtos no kit.';
          if not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos then
          	vtemp := 'Produto não pode ser removido pois no E-Commerce é obrigatório ter dois ou mais produtos no kit marcados para sincronizar.';
          Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK +  MB_ICONERROR + MB_DEFBUTTON1);
          Result := false;
          exit;
        end;
      end;
    end;

    buscas.Close;
    buscas.SQL.Text := ' delete from kits_prod_kits ' +
    	' where codigo_kit = :codigo_kit ' +
      ' and grupo_prod = :grupo_prod ' +
      ' and cod_prod = :cod_prod ' +
      ' and cod_empresa = :cod_empresa ';
    buscas.ParamByName('codigo_kit').AsInteger := StrToInt(vCodigo);
    buscas.ParamByName('grupo_prod').AsInteger := StrToInt(vGrupoProd);
    buscas.ParamByName('cod_prod').AsString := vCodProd;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;

//    result := inherited Delete;
//
//    if Result then
//      result := Apply;

    AtualizarRateioDesc(pKit, false);

    if pCommitar then
      result := CommitaTransacao;

//    if pCommitar then
//      if result then
//        result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('PRO122', 'EXCLUIR', 'SUCESSO ' + vGrupoProd + ' - ' + vCodProd, 'KITS_PROD_KITS', vCodigo, buscas)
    else
      vDadosIni.GravaAuditoria('PRO122', 'EXCLUIR', 'FALHA '  + vGrupoProd + ' - ' + vCodProd, 'KITS_PROD_KITS', vCodigo, buscas);

    Result := true;
    verificarPesoDimensoesProdutos('DELETAR', StrToInt(vCodigo));
  end;
end;

