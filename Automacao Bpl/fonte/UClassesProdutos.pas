function TProdutosConversaoSaida.Delete(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vunidade_prod: string;
  vunidade: string): Boolean;
begin
  Result := False;

  _abreProdutosConversao(vgrupo_prod, vcod_prod, vunidade);

  if dataSet.IsEmpty then
    exit;

  if not vDadosIni.PesqPros('PRO250', 'EXCLUIR',
  	'UN: ' + trim(vunidade), 'PRODUTOS_CONVERSAO_SAIDA',
    IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja apagar este registro?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  if (trim(vDadosIni.vEmp.vRegime) = 'LUCRO REAL')
  	or (trim(vDadosIni.vEmp.vRegime) = 'LUCRO PRESUMIDO')
    or (trim(vDadosIni.vEmp.vRegime) = 'SIMPLES / EXCESSO') then
  begin
  	if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 nped from pedvenda_prod ' +
        ' where cod_empresa = %s ' +
        ' and upper(unidade) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('nped').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em vendas.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;

    if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 nped from pedvenda_prod ' +
        ' where cod_empresa = %s ' +
        ' and upper(unidade_conv) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('nped').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em vendas.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;

    if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 cod_nfce from nfce_item ' +
        ' where cod_empresa = %s ' +
        ' and upper(ucom) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('cod_nfce').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em NFCe.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;

    if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 cod_nfce from nfce_item ' +
        ' where cod_empresa = %s ' +
        ' and upper(uvnd) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('cod_nfce').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em NFCe.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;

    if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 cod_nf from notafiscal_item ' +
        ' where cod_empresa = %s ' +
        ' and upper(unidade_nf) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('cod_nf').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em Nota Fiscal.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;

    if (trim(vunidade_prod) <> trim(vunidade)) then
      if SqlOpen(' select first 1 cod_nf from notafiscal_item ' +
        ' where cod_empresa = %s ' +
        ' and upper(referencia) = %s ',
        [vDadosIni.codEmpresa, UpperCase(trim(fstrq('unidade')))]).FieldByName('cod_nf').AsInteger > 0 then
      begin
        ShowErro('Regime da empresa: ' + trim(vDadosIni.vEmp.vRegime) + #13 + #13 +
          'Conversão para venda está sendo utilizada em Nota Fiscal.' + #13 + #13 +
          'Não é permitido excluir');
        Exit;
      end;
  end;

  result := inherited Delete;
  if Result then
    result := Apply;

  if result then
    result := CommitaTransacao;

  if Result then
    vDadosIni.GravaAuditoria('PRO250', 'EXCLUIR',
    	'SUCESSO - UN: ' + trim(vunidade), 'PRODUTOS_CONVERSAO_SAIDA',
    	IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas)
  else
    vDadosIni.GravaAuditoria('PRO250', 'EXCLUIR',
    	'FALHA - UN: ' + trim(vunidade), 'PRODUTOS_CONVERSAO_SAIDA',
      IntToStr(vgrupo_prod) + '-' + trim(vcod_prod), buscas);

  Result := true;
  Refresh;

end;

