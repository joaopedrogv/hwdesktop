function TBalancoProdutoRegistro._AbreProdutoReg: boolean;
begin
	result := montaSelect(' select b.data_hora_leitura, b.grupo_prod, b.cod_prod, b.cod_empresa, b.cod_barra, ' +
  	' coalesce(codgra.cod_grade, 0) cod_grade, ' +
    ' coalesce(gr.descricao,  ''SEM GRADE'') descricao, ' +
    ' coalesce(gr.descricao1, ''SEM GRADE'') descricao1, ' +
    ' case when (codgra.cod_grade > 0) then ' +
    '       codgra.qtde ' +
    '      else ' +
    '        b.qtde_prod ' +
    ' end qtde_cont, ' +
    ' pr.descr_prod from balanco_produtos b ' +
    ' inner join produtos pr on ' +
    '			pr.grupo_prod = b.grupo_prod ' +
    '     and pr.cod_prod = b.cod_prod ' +
    ' 	  and pr.cod_empresa = b.cod_empresa ' +  
    ' left join cod_grade_balanco codgra on ' +
    '     codgra.grupo_prod = b.grupo_prod ' +
    '     and codgra.cod_prod = b.cod_prod ' +
    '     and codgra.cod_empresa = b.cod_empresa ' +
    ' left join grade gr on ' +
    '     gr.cod_grade = codgra.cod_grade ' +
    '     and gr.cod_empresa = codgra.cod_empresa ' +
    ' where b.cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by b.data_hora_leitura desc, gr.descricao ');
end;

{ TImagensProd }

function TImagensProd.abreImagem(
  pDateSet: TDataSet): boolean;
begin
	Result := montaSelect('	select imagens_doc.*, ' +
  	' produtos_grade_imagens.grupo_prod, ' +
    ' produtos_grade_imagens.cod_prod, ' +
    ' produtos_grade_imagens.cod_grade, ' +
    ' case when (coalesce(produtos_grade_imagens.cod_grade, 0) <= 0) then ' +
    '        ''PRINCIPAL'' ' +
    '      else ' +
    '        trim(coalesce(grade.descricao, '''')) ' +
    ' end descr_grade from produtos_grade_imagens ' +
    ' left join grade on ' +
    ' 	  grade.cod_grade = produtos_grade_imagens.cod_grade ' +
    '     and grade.cod_empresa = produtos_grade_imagens.cod_empresa ' +
    ' inner join imagens_doc on ' +
    '			imagens_doc.cod_img = produtos_grade_imagens.cod_img ' +
    '     and imagens_doc.cod_empresa = produtos_grade_imagens.cod_empresa ' +
    ' where produtos_grade_imagens.grupo_prod = ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and produtos_grade_imagens.cod_prod = ' + QuotedStr(pDateSet.FieldByName('COD_PROD').AsString) +
    ' and produtos_grade_imagens.cod_empresa = ' + IntToStr(pDateSet.FieldByName('COD_EMPRESA').AsInteger) +
    ' order by produtos_grade_imagens.cod_grade, imagens_doc.cod_img ');
end;

function TImagensProd.adicionarImagem(
	pDateSet: TDataSet;
  pCodGrade: Integer;
  pDescrGrade: string;
  var pImagensOrigem: string;
  var pImagensDestino: string;
  pSetPathPadrao: string): string;
var
	vCodigoImg: Integer;
  vMd5Img: string;
  buscas2: TIBQuery;

  SearchRec: TSearchRec;
  compressao: Integer;
begin
	try
  	Result := pImagensDestino;

    if pDateSet.IsEmpty then
      exit;

    try
      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      try
        if SysUtils.FindFirst(pImagensOrigem, faAnyFile, SearchRec) <> 0 then
          exit;

        if SearchRec.Size >= 1024000 then
          compressao := 30
        else if SearchRec.Size >= 300000 then
          compressao := 50
        else
          compressao := 100;
      finally
        SysUtils.FindClose(SearchRec);
      end;

      vCodigoImg := vDadosIni.verificaImagemBD(
        buscas2,
        vDadosIni.cod_empresa,
        compressao,
        pImagensOrigem,
        pImagensDestino);

      if vCodigoImg <= 0 then
      begin
        if not vDadosIni.SetJPGCompression(
          compressao,
          pImagensOrigem,
          pImagensDestino) then
            exit;

        Result := pImagensDestino;

        vMd5Img := _getMd5File(pImagensDestino);
        if trim(pSetPathPadrao) <> '' then
          pImagensDestino := ExtractFileName(pImagensDestino);

        Result := pImagensDestino;

        vCodigoImg := Gencodigo('IMAGENS_DOC', buscas, vDadosIni.codEmpresa);

        if (vCodigoImg <= 0) then
          exit;

        if trim(pImagensDestino) = '' then
          exit;

        if trim(vMd5Img) = '' then
          exit;

        buscas.Close;
        buscas.SQL.Text := ' INSERT INTO IMAGENS_DOC ' +
          ' (COD_IMG, COD_EMPRESA, IMAGEM, MD5, US_CAD, DATA_CAD) ' +
          ' VALUES (:COD_IMG, :COD_EMPRESA, :IMAGEM, :MD5, :US_CAD, :DATA_CAD); ';
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('IMAGEM').AsString := pImagensDestino;
        buscas.ParamByName('MD5').AsString := vMd5Img;
        buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
        buscas.ParamByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas2);
        buscas.ExecSQL;
      end;

      if vCodigoImg > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := ' SELECT COD_IMG FROM PRODUTOS_GRADE_IMAGENS ' +
          ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
          ' AND COD_PROD = :COD_PROD ' +
          ' AND COD_GRADE = :COD_GRADE ' +
          '	AND COD_EMPRESA = :COD_EMPRESA ' +
          ' AND COD_IMG = :COD_IMG ';
        buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_GRADE').AsInteger := pCodGrade;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.Open;

        if not buscas.IsEmpty then
        begin
          Application.MessageBox(PChar('Imagem ' + trim(ExtractFileName(pImagensDestino)) +
            ' já foi adicionada ao produto: ' + #13 + #13 +
            'PRODUTO' + #13 +
            'Grupo Prod: ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) + #13 +
            'Cod Prod: ' + trim(pDateSet.FieldByName('COD_PROD').AsString) + #13 +
            'Cod Grade: ' + IntToStr(pCodGrade) + #13 +
            'Cod Empresa: ' + IntToStr(vDadosIni.cod_empresa) + #13 + #13 +
            'Favor verificar antes de continuar.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
          exit;
        end;

        buscas.Close;
        buscas.SQL.Text := ' INSERT INTO PRODUTOS_GRADE_IMAGENS ' +
          ' (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA, COD_IMG) ' +
          ' VALUES (:GRUPO_PROD, :COD_PROD, :COD_GRADE, :COD_EMPRESA, :COD_IMG); ';
        buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_GRADE').AsInteger := pCodGrade;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.ExecSQL;
      end;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      abreImagem(pDateSet);
    finally
      if Assigned(buscas2) then
        FreeAndNil(buscas2);
    end;

  except
    on e: Exception do
    begin
      Result := '';
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TImagensProd.alterarImagemNovaTab(
	pDateSet: TDataSet;
  pSetPathPadrao: string): boolean;
var
	vListaImagens: TStringList;
  vListaUrl: TStringList;
	buscas2: TIBQuery;
  I: Integer;

  vCodigoImg: Integer;
  vUsuarioImg: Integer;
  vDataImg: TDateTime;
  vMd5Img: string;

  vImagensOrigem: string;
  vImagensDestino: string;
  vUrlDestino: string;

  SearchRec: TSearchRec;
  compressao: Integer;
begin
  Result := True;

  if pDateSet.IsEmpty then
    exit;

  try
    vListaImagens := TStringList.Create;
    vListaUrl := TStringList.Create;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    try
      buscas2.Close;
      buscas2.SQL.Text := ' select pimg.grupo_prod, ' +
        ' pimg.cod_prod, ' +
        ' pimg.cod_grade, ' +
        ' pimg.cod_empresa, ' +
        ' pimg.lista_imagens, ' +
        ' pimg.url_imagens, ' +
        ' pimg.data_cad from produtos_imagens pimg ' +
        ' where pimg.grupo_prod = :grupo_prod ' +
        ' and pimg.cod_prod = :cod_prod ' +
        ' and pimg.cod_empresa = :cod_empresa ' +
        ' order by pimg.grupo_prod, pimg.cod_prod, pimg.cod_grade ';
      buscas2.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas2.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
      buscas2.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
      buscas2.Open;

      buscas2.First;
      while not buscas2.Eof do
      begin
        vListaImagens.Clear;
        vListaUrl.Clear;

        if trim(buscas2.FieldByName('lista_imagens').AsString) <> '' then
          vListaImagens.Text := buscas2.FieldByName('lista_imagens').AsString;

        if (buscas2.FieldByName('url_imagens').AsString) <> '' then
          vListaUrl.Text     := buscas2.FieldByName('url_imagens').AsString;

        for I := 0 to vListaImagens.Count - 1 do
        begin
          vImagensOrigem  := vListaImagens[I];
          if trim(ExtractFileName(vImagensOrigem)) = trim(vImagensOrigem) then
            vImagensOrigem := pSetPathPadrao + vImagensOrigem;

          vImagensDestino := vListaImagens[I];
          if (trim(pSetPathPadrao) <> '') then
            vImagensDestino := pSetPathPadrao + ExtractFileName(vImagensDestino);

          if vListaUrl.Count <= 0 then
            vUrlDestino   := ''
          else if vListaImagens.Count <> vListaUrl.Count then
            vUrlDestino   := ''
          else if trim(vListaUrl[I]) = '' then
            vUrlDestino   := ''
          else
            vUrlDestino   := vListaUrl[I];

          vCodigoImg := 0;

          try
            if SysUtils.FindFirst(vImagensOrigem, faAnyFile, SearchRec) = 0 then
            begin
              if SearchRec.Size >= 1024000 then
                compressao := 30
              else if SearchRec.Size >= 300000 then
                compressao := 50
              else
                compressao := 100;

              if FileExists(vImagensDestino) then
              begin
                vCodigoImg := vDadosIni.verificaImagemBD(
                  buscas,
                  vDadosIni.cod_empresa,
                  compressao,
                  vImagensOrigem,
                  vImagensDestino);

                if vCodigoImg <= 0 then
                begin
                  if not vDadosIni.SetJPGCompression(
                    compressao,
                    vImagensOrigem,
                    vImagensDestino) then
                      exit;
                end;
              end;
            end;
          finally
            SysUtils.FindClose(SearchRec);
          end;

          if vCodigoImg <= 0 then
          begin
            vCodigoImg  := Gencodigo('IMAGENS_DOC', buscas, vDadosIni.codEmpresa);
            vUsuarioImg := vDadosIni.vCodUsuario;
            vDataImg    := vDadosIni.getDataBanco(buscas);
            if FileExists(vImagensDestino) then
              vMd5Img   := _getMd5File(vImagensDestino)
            else
              vMd5Img   := '';

            if (vCodigoImg <= 0) then
              exit;

            if trim(vImagensDestino) = '' then
              exit;

            if trim(vMd5Img) = '' then
              exit;

            buscas.Close;
            buscas.SQL.Text := ' INSERT INTO IMAGENS_DOC ' +
              ' (COD_IMG, COD_EMPRESA, IMAGEM, URL, MD5, US_CAD, DATA_CAD) ' +
              ' VALUES (:COD_IMG, :COD_EMPRESA, :IMAGEM, :URL, :MD5, :US_CAD, :DATA_CAD); ';
            buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
            buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
            if trim(pSetPathPadrao) <> '' then
              buscas.ParamByName('IMAGEM').Value := IfThen(trim(vImagensDestino) = '', Null, ExtractFileName(vImagensDestino))
            else
              buscas.ParamByName('IMAGEM').Value := IfThen(trim(vImagensDestino) = '', Null, vImagensDestino);
            buscas.ParamByName('URL').Value := IfThen(trim(vUrlDestino) = '', Null, vUrlDestino);
            buscas.ParamByName('MD5').Value := IfThen(trim(vMd5Img) = '', Null, vMd5Img);
            buscas.ParamByName('US_CAD').AsInteger := vUsuarioImg;
            buscas.ParamByName('DATA_CAD').AsDateTime := vDataImg;
            buscas.ExecSQL;
          end;

          if vCodigoImg > 0 then
          begin
            buscas.Close;
            buscas.SQL.Text := ' SELECT COD_IMG FROM PRODUTOS_GRADE_IMAGENS ' +
              ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
              ' AND COD_PROD = :COD_PROD ' +
              ' AND COD_GRADE = :COD_GRADE ' +
              '	AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND COD_IMG = :COD_IMG ';
            buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
            buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
            buscas.ParamByName('COD_GRADE').AsInteger := buscas2.FieldByName('COD_GRADE').AsInteger;
            buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
            buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
            buscas.Open;

            if buscas.IsEmpty then
            begin
              buscas.Close;
              buscas.SQL.Text := ' INSERT INTO PRODUTOS_GRADE_IMAGENS ' +
                ' (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA, COD_IMG) ' +
                ' VALUES (:GRUPO_PROD, :COD_PROD, :COD_GRADE, :COD_EMPRESA, :COD_IMG); ';
              buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('COD_GRADE').AsInteger := buscas2.FieldByName('COD_GRADE').AsInteger;
              buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
              buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
              buscas.ExecSQL;
            end;
          end;
        end;

        // Remover imagem tabela antiga
        if vListaImagens.Count > 0 then
        begin
          buscas.Close;
          buscas.SQL.Text := ' DELETE FROM PRODUTOS_IMAGENS ' +
            ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_GRADE = :COD_GRADE ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ';
          buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('COD_GRADE').AsInteger := buscas2.FieldByName('COD_GRADE').AsInteger;
          buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
          buscas.ExecSQL;
        end;
      
        buscas2.Next;
      end;

      if buscas2.RecordCount > 0 then
      begin
        // Remover imagem tabela antiga
        buscas.Close;
        buscas.SQL.Text := ' UPDATE PRODUTOS SET ' +
          ' LISTA_IMAGENS = NULL ' +
          ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
          ' AND COD_PROD = :COD_PROD ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ';
        buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := pDateSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;
      end;

    except
      on E: Exception do
      begin
        result := False;
        Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('function TProdutos.alterarImagemNovaTab. Erro: ' + e.Message);
      end;
    end;
  finally
    if Assigned(buscas2) then
      FreeAndNil(buscas2);
    if Assigned(vListaImagens) then
      vListaImagens.Free;
    if Assigned(vListaUrl) then
      vListaUrl.Free;
  end;
end;

constructor TImagensProd.create;
begin
  DataSet := TClientDataSet(dtmProdutos.cdsImagensProd);
  transacao := TIBTransaction(dtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(dtmProdutos.qrImagensProd);
end;

function TImagensProd.removerImagem(pDateSet: TDataSet): boolean;
begin
	try
  	Result := False;

    if pDateSet.IsEmpty then
      exit;

    if dataSet.IsEmpty then
      exit;

    buscas.Close;
    buscas.SQL.Text := ' DELETE FROM PRODUTOS_GRADE_IMAGENS ' +
      ' WHERE GRUPO_PROD = :GRUPO_PROD ' +
      ' AND COD_PROD = :COD_PROD ' +
      ' AND COD_EMPRESA = :COD_EMPRESA ' +
      ' AND COD_GRADE = :COD_GRADE ' +
      ' AND COD_IMG = :COD_IMG; ';
    buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    buscas.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
    buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
    buscas.ParamByName('COD_IMG').AsInteger := dataSet.FieldByName('COD_IMG').AsInteger;
    buscas.ExecSQL;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    abreImagem(pDateSet);
  except
    on e: Exception do
    begin
      Result := False;
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

{ TImagensKit }

function TImagensKit.abreImagem(pDateSet: TDataSet): boolean;
begin
	Result := montaSelect(' select imagens_doc.*, ' +
    ' kits_prod_imagens.codigo_kit, ' +
    ' 0 cod_grade, ' +
    ' ''PRINCIPAL'' descr_grade from kits_prod_imagens ' +
  	' inner join imagens_doc on ' +
    '     imagens_doc.cod_img = kits_prod_imagens.cod_img ' +
    '     and imagens_doc.cod_empresa = kits_prod_imagens.cod_empresa ' +
    ' where kits_prod_imagens.codigo_kit = ' + IntToStr(pDateSet.FieldByName('CODIGO_KIT').AsInteger) +
    ' and kits_prod_imagens.cod_empresa =  ' + vDadosIni.codEmpresa +
    ' order by imagens_doc.cod_img ');
end;

function TImagensKit.adicionarImagem(
  pDateSet: TDataSet;
  var pImagensOrigem: string;
  var pImagensDestino: string;
  pSetPathPadrao: string): string;
var
	vCodigoImg: Integer;
  vMd5Img: string;
  buscas2: TIBQuery;

  SearchRec: TSearchRec;
  compressao: Integer;
begin
	try
  	Result := pImagensDestino;

    if pDateSet.IsEmpty then
      exit;

    try
      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      try
        if SysUtils.FindFirst(pImagensOrigem, faAnyFile, SearchRec) <> 0 then
          exit;

        if SearchRec.Size >= 1024000 then
          compressao := 30
        else if SearchRec.Size >= 300000 then
          compressao := 50
        else
          compressao := 100;
      finally
        SysUtils.FindClose(SearchRec);
      end;

      vCodigoImg := vDadosIni.verificaImagemBD(
        buscas2,
        vDadosIni.cod_empresa,
        compressao,
        pImagensOrigem,
        pImagensDestino);

      if vCodigoImg <= 0 then
      begin
        if not vDadosIni.SetJPGCompression(
          compressao,
          pImagensOrigem,
          pImagensDestino) then
            exit;

        Result := pImagensDestino;

        vMd5Img := _getMd5File(pImagensDestino);
        if trim(pSetPathPadrao) <> '' then
          pImagensDestino := ExtractFileName(pImagensDestino);

        Result := pImagensDestino;

        vCodigoImg := Gencodigo('IMAGENS_DOC', buscas, vDadosIni.codEmpresa);

        if (vCodigoImg <= 0) then
          exit;

        if trim(pImagensDestino) = '' then
          exit;

        if trim(vMd5Img) = '' then
          exit;

        buscas.Close;
        buscas.SQL.Text := ' INSERT INTO IMAGENS_DOC ' +
          ' (COD_IMG, COD_EMPRESA, IMAGEM, MD5, US_CAD, DATA_CAD) ' +
          ' VALUES (:COD_IMG, :COD_EMPRESA, :IMAGEM, :MD5, :US_CAD, :DATA_CAD); ';
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('IMAGEM').AsString := pImagensDestino;
        buscas.ParamByName('MD5').AsString := vMd5Img;
        buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
        buscas.ParamByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas2);
        buscas.ExecSQL;
      end;

      if vCodigoImg > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := ' SELECT COD_IMG FROM KITS_PROD_IMAGENS ' +
          ' WHERE CODIGO_KIT = :CODIGO_KIT ' +
          '	AND COD_EMPRESA = :COD_EMPRESA ' +
          ' AND COD_IMG = :COD_IMG ';
        buscas.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.Open;

        if not buscas.IsEmpty then
        begin
          Application.MessageBox(PChar('Imagem ' + trim(ExtractFileName(pImagensDestino)) +
            ' já foi adicionada ao kit: ' + #13 + #13 +
            'KIT' + #13 +
            'Cod Kit: ' + IntToStr(pDateSet.FieldByName('CODIGO_KIT').AsInteger) + #13 +
            'Cod Empresa: ' + IntToStr(vDadosIni.cod_empresa) + #13 + #13 +
            'Favor verificar antes de continuar.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
          exit;
        end;

        buscas.Close;
        buscas.SQL.Text := ' INSERT INTO KITS_PROD_IMAGENS ' +
          ' (CODIGO_KIT, COD_EMPRESA, COD_IMG) ' +
          ' VALUES (:CODIGO_KIT, :COD_EMPRESA, :COD_IMG); ';
        buscas.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
        buscas.ExecSQL;
      end;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      abreImagem(pDateSet);
    finally
      if Assigned(buscas2) then
        FreeAndNil(buscas2);
    end;
  except
    on e: Exception do
    begin
      Result := '';
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TImagensKit.alterarImagemNovaTab(
	pDateSet: TDataSet;
  pSetPathPadrao: string): boolean;
var
	vListaImagens: TStringList;
  vListaUrl: TStringList;
	buscas2: TIBQuery;
  I: Integer;

  vCodigoImg: Integer;
  vUsuarioImg: Integer;
  vDataImg: TDateTime;
  vMd5Img: string;

  vImagensOrigem: string;
  vImagensDestino: string;
  vUrlDestino: string;

  SearchRec: TSearchRec;
  compressao: Integer;
begin
  Result := True;

  if pDateSet.IsEmpty then
    exit;

	try
    vListaImagens := TStringList.Create;
    vListaUrl := TStringList.Create;

    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := buscas.Database;
	  buscas2.Transaction := buscas.Transaction;

    try
      buscas2.Close;
      buscas2.SQL.Text := ' select kimg.codigo_kit, ' +
        ' kimg.cod_empresa, ' +
        ' kimg.lista_imagens, ' +
        ' kimg.url_imagens from kits_prod kimg ' +
        ' where kimg.codigo_kit = :codigo_kit ' +
        ' and kimg.cod_empresa = :cod_empresa ' +
        ' and kimg.lista_imagens is not null ';
      buscas2.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
      buscas2.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
      buscas2.Open;

      buscas2.First;
      while not buscas2.Eof do
      begin
        vListaImagens.Clear;
        vListaUrl.Clear;

        if trim(buscas2.FieldByName('lista_imagens').AsString) <> '' then
          vListaImagens.Text := buscas2.FieldByName('lista_imagens').AsString;

        if (buscas2.FieldByName('url_imagens').AsString) <> '' then
          vListaUrl.Text     := buscas2.FieldByName('url_imagens').AsString;

        for I := 0 to vListaImagens.Count - 1 do
        begin
          vImagensOrigem  := vListaImagens[I];
          if trim(ExtractFileName(vImagensOrigem)) = trim(vImagensOrigem) then
            vImagensOrigem := pSetPathPadrao + vImagensOrigem;

          vImagensDestino := vListaImagens[I];
          if (trim(pSetPathPadrao) <> '') then
            vImagensDestino := pSetPathPadrao + ExtractFileName(vImagensDestino);

          if vListaUrl.Count <= 0 then
            vUrlDestino   := ''
          else if vListaImagens.Count <> vListaUrl.Count then
            vUrlDestino   := ''
          else if trim(vListaUrl[I]) = '' then
            vUrlDestino   := ''
          else
            vUrlDestino   := vListaUrl[I];

          vCodigoImg := 0;

          try
            if SysUtils.FindFirst(vImagensOrigem, faAnyFile, SearchRec) = 0 then
            begin
              if SearchRec.Size >= 1024000 then
                compressao := 30
              else if SearchRec.Size >= 300000 then
                compressao := 50
              else
                compressao := 100;

              if FileExists(vImagensDestino) then
              begin
                vCodigoImg := vDadosIni.verificaImagemBD(
                  buscas,
                  vDadosIni.cod_empresa,
                  compressao,
                  vImagensOrigem,
                  vImagensDestino);

                if vCodigoImg <= 0 then
                begin
                  if not vDadosIni.SetJPGCompression(
                    compressao,
                    vImagensOrigem,
                    vImagensDestino) then
                      exit;
                end;
              end;
            end
          finally
            SysUtils.FindClose(SearchRec);
          end;

          if vCodigoImg <= 0 then
          begin
            vCodigoImg  := Gencodigo('IMAGENS_DOC', buscas, vDadosIni.codEmpresa);
            vUsuarioImg := vDadosIni.vCodUsuario;
            vDataImg    := vDadosIni.getDataBanco(buscas);
            if FileExists(vImagensDestino) then
              vMd5Img   := _getMd5File(vImagensDestino)
            else
              vMd5Img   := '';

            if (vCodigoImg <= 0) then
              exit;

            if trim(vImagensDestino) = '' then
              exit;

            if trim(vMd5Img) = '' then
              exit;

            buscas.Close;
            buscas.SQL.Text := ' INSERT INTO IMAGENS_DOC ' +
              ' (COD_IMG, COD_EMPRESA, IMAGEM, URL, MD5, US_CAD, DATA_CAD) ' +
              ' VALUES (:COD_IMG, :COD_EMPRESA, :IMAGEM, :URL, :MD5, :US_CAD, :DATA_CAD); ';
            buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
            buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
            if trim(pSetPathPadrao) <> '' then
              buscas.ParamByName('IMAGEM').Value := IfThen(trim(vImagensDestino) = '', Null, ExtractFileName(vImagensDestino))
            else
              buscas.ParamByName('IMAGEM').Value := IfThen(trim(vImagensDestino) = '', Null, vImagensDestino);
            buscas.ParamByName('URL').Value := IfThen(trim(vUrlDestino) = '', Null, vUrlDestino);
            buscas.ParamByName('MD5').Value := IfThen(trim(vMd5Img) = '', Null, vMd5Img);
            buscas.ParamByName('US_CAD').AsInteger := vUsuarioImg;
            buscas.ParamByName('DATA_CAD').AsDateTime := vDataImg;
            buscas.ExecSQL;
          end;

          if vCodigoImg > 0 then
          begin
            buscas.Close;
            buscas.SQL.Text := ' SELECT COD_IMG FROM KITS_PROD_IMAGENS ' +
              ' WHERE CODIGO_KIT = :CODIGO_KIT ' +
              '	AND COD_EMPRESA = :COD_EMPRESA ' +
              ' AND COD_IMG = :COD_IMG ';
            buscas.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
            buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
            buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
            buscas.Open;

            if buscas.IsEmpty then
            begin
              buscas.Close;
              buscas.SQL.Text := ' INSERT INTO KITS_PROD_IMAGENS ' +
                ' (CODIGO_KIT, COD_EMPRESA, COD_IMG) ' +
                ' VALUES (:CODIGO_KIT, :COD_EMPRESA, :COD_IMG); ';
              buscas.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
              buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
              buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
              buscas.ExecSQL;
            end;
          end;
        end;

        buscas2.Next;
      end;

      if buscas2.RecordCount > 0 then
      begin
        // Remover imagem tabela antiga
        buscas.Close;
        buscas.SQL.Text := ' UPDATE KITS_PROD SET ' +
          ' LISTA_IMAGENS = NULL, ' +
          ' URL_IMAGENS = NULL ' +
          ' WHERE CODIGO_KIT = :CODIGO_KIT ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ';
        buscas.ParamByName('CODIGO_KIT').AsInteger := pDateSet.FieldByName('CODIGO_KIT').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;
      end;

    except
      on E: Exception do
      begin
        result := False;
        Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('function TImagensKit.alterarImagemNovaTab. Erro: ' + e.Message);
      end;
    end;
  finally
    if Assigned(buscas2) then
      FreeAndNil(buscas2);
    if Assigned(vListaImagens) then
      vListaImagens.Free;
    if Assigned(vListaUrl) then
      vListaUrl.Free;
  end;
end;

