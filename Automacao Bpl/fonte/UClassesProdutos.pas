function TAlteracaoPreco.efetuarAlteracao: boolean;
var
  buscas2: TIBQuery;
  I: Integer;
  pWhere: string;
begin

  try

    vParar := 0;

    vLabel.Caption := 'Aguarde processamento';
    buscas2 := TIBQuery(dtmProdutos.qrBuscasCB);
    if ((vFinalidade = 'CONSULTADOS') or (vFinalidade = 'SELECIONADOS')) and (FGrid <> nil) then
    begin
      if not vDadosIni.PesqPros('PRO181', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        Exit;

      vProgresso.Min := 0;
      vProgresso.Max := FGrid.DataSource.DataSet.RecordCount;
      vProgresso.Position := 0;

      try
      	FGrid.DataSource.DataSet.DisableControls;
        FGrid.DataSource.DataSet.First;
        while not FGrid.DataSource.DataSet.Eof do
        begin
          if vParar = 1 then
            if Application.MessageBox('Deseja mesmo para o processamento?', 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDYES then
            begin
              Result := false;
              cancelar;
              Exit;
            end
            else
              vParar := 0;

          Application.ProcessMessages;
          vCodPromocao := 0;
          vTipoDifPro := '';
          vLabel.Caption := 'Produto: ' +
            Trim(FGrid.DataSource.DataSet.FieldByName('DESCR_PROD').AsString);
          if (vFinalidade = 'CONSULTADOS') or (FGrid.DataSource.DataSet.FieldByName('sel').AsString = 'S') then
          //if (vFinalidade = 'CONSULTADOS') or (FGrid.SelectedRows.CurrentRowSelected) then
          begin
            dataSet.Insert;
            dataSet.FieldByName('GRUPO_PROD').AsInteger :=
              FGrid.DataSource.DataSet.FieldByName('GRUPO_PROD').AsInteger;
            dataSet.FieldByName('COD_PROD').AsString :=
              FGrid.DataSource.DataSet.FieldByName('COD_PROD').AsString;
            dataSet.FieldByName('DESCR_PROD').AsString :=
              FGrid.DataSource.DataSet.FieldByName('DESCR_PROD').AsString;
            dataSet.FieldByName('PREC_TAB_PROD').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PREC_TAB_PROD').AsFloat;
            dataSet.FieldByName('PREC_30_PROD').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PREC_30_PROD').AsFloat;
            dataSet.FieldByName('PREC_60_PROD').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PREC_60_PROD').AsFloat;
            dataSet.FieldByName('PREC_90_PROD').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PREC_90_PROD').AsFloat;
            dataSet.FieldByName('PREC_PUBLICO').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PREC_PUBLICO').AsFloat;
            dataSet.FieldByName('PERC_AD_30').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_AD_30').AsFloat;
            dataSet.FieldByName('PERC_AD_60').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_AD_60').AsFloat;
            dataSet.FieldByName('PERC_AD_90').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_AD_90').AsFloat;
            dataSet.FieldByName('MAX_DESC_ITEM').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('MAX_DESC_ITEM').AsFloat;
            dataSet.FieldByName('PERC_TB_ATAC').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_ATAC').AsFloat;
            dataSet.FieldByName('PERC_TB_PRODA').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_PRODA').AsFloat;
            dataSet.FieldByName('PERC_TB_PROD').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_PROD').AsFloat;
            dataSet.FieldByName('PERC_TB_PROD3').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_PROD3').AsFloat;
            dataSet.FieldByName('PERC_TB_PROD6').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_PROD6').AsFloat;
            dataSet.FieldByName('PERC_TB_PROD9').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_PROD9').AsFloat;
            dataSet.FieldByName('PERC_TB_VARE').AsFloat :=
              FGrid.DataSource.DataSet.FieldByName('PERC_TB_VARE').AsFloat;

            if not calcularAlteracao then
            begin
              Result := False;
              Exit;
            end;

          end;
          FGrid.DataSource.DataSet.Next;
          vProgresso.Position := vProgresso.Position + 1;
        end;
      finally
        FGrid.DataSource.DataSet.EnableControls;
      end;
    end
    else
    begin
      if vFinalidade = 'AJUSTE' then
      begin
        if not vDadosIni.PesqPros('PRO183', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
          Exit;
      end
      else
      begin
        if not vDadosIni.PesqPros('PRO182', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
          Exit;
      end;

