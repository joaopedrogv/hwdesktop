  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;
//  vRelProd.labelTotal := TQRLabel(FrmCadProdutos.qrLabelTotal);
//  vRelProd.labelEstoque := TQRLabel(FrmCadProdutos.qrLabelEstoque);
//  vRelProd.labelVenda := TQRLabel(FrmCadProdutos.qrLabelVenda);
//  vRelProd.labelCusto := TQRLabel(FrmCadProdutos.qrLabelCusto);
//  vRelProd.labelCustoR := TQRLabel(FrmCadProdutos.qrLabelCustoR);
  if ((not pDiferenciado) and (not pPromocao) and (not pPrecoPorQtde)) then
  begin
    vRelProd.quickRep := TquickRep(FrmCadProdutos.QuickRep2);
    FrmCadProdutos.DetailBand2.BeforePrint := vRelProd.bandaDetalheBeforePrint;
    FrmCadProdutos.PageFooterBand2.BeforePrint := vRelProd.bandaFooterBeforePrint;
    Screen.Cursor := crDefault;
    vRelProd.quickRep.Preview;
  end
  else
  begin
    vOrdem := '';
    vIndex := '';
    
    if (pIndex = '') then
    begin
      vOrdem := ' ASC ';
    	pIndex := 'NUM_FAB_PROD';

      vIndex := 'IDX$ANUM_FAB_PROD';
    end
    else if (Pos('IDX$A', UpperCase(pIndex)) > 0) then
    begin
      vOrdem := ' ASC ';
      pIndex := trim(StringReplace(UpperCase(pIndex), 'IDX$A', '', [rfReplaceAll]));

      vIndex := 'IDX$A' + pIndex;
    end
    else if (Pos('IDX$D', UpperCase(pIndex)) > 0) then
    begin
      vOrdem := ' DESC ';
      pIndex := trim(StringReplace(UpperCase(pIndex), 'IDX$A', '', [rfReplaceAll]));

      vIndex := 'IDX$D' + pIndex;
    end;

    buscas2.Close;
    buscas2.SQL.Text := ' select a.rdb$field_position ordem, a.rdb$field_name campo from rdb$relation_fields a ' +
    	' inner join rdb$fields b on a.rdb$field_source = b.rdb$field_name ' +
      ' where a.rdb$relation_name = ''PRODUTOS'' and a.rdb$field_name = :index ';
    buscas2.ParamByName('INDEX').AsString := pIndex;
    buscas2.Open;

    if buscas2.IsEmpty then
    begin
    	buscas2.Close;
      buscas2.SQL.Text := ' select a.rdb$field_position ordem, a.rdb$field_name campo from rdb$relation_fields a ' +
        ' inner join rdb$fields b on a.rdb$field_source = b.rdb$field_name ' +
        ' where a.rdb$relation_name = ''PRODUTOS'' and a.rdb$field_name = :index ';
      buscas2.ParamByName('INDEX').AsString := vDadosIni.apenasNumeros(pIndex);
      buscas2.Open;
    end;

    if not buscas2.IsEmpty then
    begin
    	pIndex := trim(buscas2.FieldByName('CAMPO').AsString);
      vOrdem := IntToStr(buscas2.FieldByName('ORDEM').AsInteger + 2) + vOrdem;

      vIndex := vDadosIni.IfThen(vOrdem = ' DESC ', 'IDX$D', 'IDX$A') + pIndex;
    end;

    vProdutosRel._abreRelProdutos(pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, pWhere, vIndex);
    if pTipo = 'TAB_PRECO' then
    begin
      vRelProd.quickRep := TquickRep(FrmCadProdutos.QuickRep5);
      FrmCadProdutos.DetailBand5.BeforePrint := vRelProd.bandaDetalheBeforePrint;
      FrmCadProdutos.PageFooterBand5.BeforePrint := vRelProd.bandaFooterBeforePrint;
    end
    else if pTipo = 'CATALAGO_PRECO_G' then
    begin
      vRelProd.quickRep := TquickRep(FrmCadProdutos.qrpCatalogo2);
      FrmCadProdutos.DetailCatalogo2.BeforePrint := vRelProd.bandaDetalheBeforePrint;
      FrmCadProdutos.PageFooterBand4.BeforePrint := vRelProd.bandaFooterBeforePrint;
    end;
    Screen.Cursor := crDefault;
    vRelProd.quickRep.Preview;
  end
end;

