  try
     try
       StrToDate(dataIni);
       StrToDate(dataFim);
     except
       Application.MessageBox('Data informada inválida', 'Atenção', MB_ICONWARNING + MB_OK);
       exit;
     end;
     cdsEstoqueDiarioC := TClientDataSet(dtmProdutos.cdsEstoqueDiarioC);
     cFichaC := TClientDataSet(dtmProdutos.cdsFichaC);

     cdsEstoqueDiarioC.Close;
     cdsEstoqueDiarioC.CommandText := ' select distinct est.dia "Data", sum(est.estoque) "Estoque", ' +
      ' avg(coalesce(est.custo_medio, 0)) "CustoMedio" from estoque_diario est ' +
      ' where est.tipo = ''P'' ' +
      ' and est.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and est.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and est.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and est.dia >= :dataInicio and est.dia <= :dataFim ' +
      ' group by est.dia ' + //' group by est.dia, est.custo_medio ' +
      ' order by est.dia asc ';
     cdsEstoqueDiarioC.Params.ParamByName('dataInicio').AsDate := StrToDate(dataIni);
     cdsEstoqueDiarioC.Params.ParamByName('dataFim').AsDate := StrToDate(dataFim);
     cdsEstoqueDiarioC.Open;

     cFichaC.Close;
