function TSubGrupos.post: boolean;
var
  statusDataset: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      statusDataset := 'E'
    else
      statusDataset := 'I';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raise exception.create('Descrição do Subgrupo não informada');

    if trim(dataSet.FieldByName('CODIGO_SUBGR').AsString) = '' then
      dataSet.FieldByName('CODIGO_SUBGR').AsInteger := IncrementaGodigo;

    vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_SUBGR').AsString;
    //    if trim(dataSet.FieldByName('CODIGO_SUBGR').AsString) = '' then
    //      raise exception.create('Código do Subgrupo não informado');

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := TRUE;
      Exit;
    end;

    if Apply then
    begin
      if CommitaTransacao then
      begin
        //        IncrementaGodigo;
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO071', 'ALTERAÇÃO CONFIRMADA ', 'SUCESSO', 'SUB_GRUPO',
            dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO071', 'ALTEREÇÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_SUBGR').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO CONFIRMADA', 'SUCESSO', 'SUB_GRUPO',
            dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_SUBGR').asstring, buscas);
      end
      else
      begin
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO071', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA', 'SUB_GRUPO',
            dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO071', 'ALTEREÇÃO NÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_SUBGR').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO NÃO CONFIRMADA', 'FALHA', 'SUB_GRUPO',
            dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO NÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_SUBGR').asstring, buscas);
      end;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      if statusDataset = 'E' then
        vDadosIni.GravaAuditoria('PRO071', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA', 'SUB_GRUPO',
          dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
      else if statusDataset = 'I' then
        vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO NÃO CONFIRMADA', 'FALHA', 'SUB_GRUPO',
          dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas)
          //        vDadosIni.GravaAuditoria('PRO071', 'INCLUSÃO NÃO CONFIRMADA ' +
//          dataSet.FieldByName('CODIGO_SUBGR').asstring, buscas);
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
