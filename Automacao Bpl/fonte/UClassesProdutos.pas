        end;
//        else if FpermitAltPrecAvista then
//        begin
//          buscas.Close;
//          buscas.SQL.Text := 'update PROMOCAO_PRODUTO set PROPORCAO_TABELA = 0' +
//            ' where GRUPO_PROD = :GRUPO_PROD and COD_PROD = :COD_PROD ' +
//            ' and COD_EMPRESA = :COD_EMPRESA and VALOR_PROMOCAO > 0 and PROPORCAO_TABELA > 0 ';
//          buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
//          buscas.ParamByName('COD_PROD').AsString := Trim(dataSet.FieldByName('COD_PROD').AsString);
//          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
