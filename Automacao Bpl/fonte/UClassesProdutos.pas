function TProdutos.ObterAlteracaoPreco(input: AlteracaoPrecoInput): AlteracoesPrecoOutput;
  {$REGION 'AddResult'}
  procedure AddResult(const ANomeCampo: string; AValorCampo: Double);
  var
    novoItem: AlteracaoPrecoOutput;
    iResults, iFound: Integer;
  begin
    iFound := -1;
    for iResults := Low(Result) to High(Result) do
      if Result[iResults].NomeCampo = UpperCase(ANomeCampo) then
      begin
        iFound := iResults;
        Break;
      end;

    if iFound = -1 then
    begin
      SetLength(Result, Length(Result) + 1);
      iFound := High(Result);
    end;

    novoItem.NomeCampo := UpperCase(ANomeCampo);
    novoItem.ValorCampo := AValorCampo;

    Result[iFound] := novoItem;

    input.SetValor(novoItem.NomeCampo, novoItem.ValorCampo);

  end;

  procedure AddResults(inputResult: AlteracoesPrecoOutput);
  var
    iInputs: Integer;
  begin
    for iInputs := Low(inputResult) to High(inputResult) do
      AddResult(inputResult[iInputs].NomeCampo, inputResult[iInputs].ValorCampo);
  end;
  {$ENDREGION}
var
  DIGITOS_PRECO: Integer;
  lockPrecoMarkup: Boolean;
  fieldPreco, fieldMarkup, fieldMargem, fieldPercen: string;
  preco, markup, margem, custo, percentual: Double;
  calc, ajust: Double;
begin

  SetLength(Result, 0);

  DIGITOS_PRECO := 0 - vDadosIni.vEmp.vCasasDecimais;
  ajust := 1 / StrToInt('1' + PadL(0, vDadosIni.vEmp.vCasasDecimais));
  lockPrecoMarkup := vDadosIni.vProduto.Precos.ManterPrecoMarkupProporcional;//;(vDadosIni.vEmp.vALT_PERC_MARGEM = 'S');
  custo := input.CustoMedio;

  {$REGION 'CUSTO'}
  if input.NomeCampo = 'PREC_CUSM_PROD' then
  begin
    AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_TB_PROD' ) ));
    AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_TB_PRODA') ));
    AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_TB_PROD3') ));
    AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_TB_PROD6') ));
    AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_TB_PROD9') ));
  end
  {$ENDREGION}

  {$REGION 'PRECO'}
  else if MatchText(input.NomeCampo, ['PREC_TAB_PROD', 'PREC_PUBLICO', 'PREC_30_PROD', 'PREC_60_PROD', 'PREC_90_PROD']) then
  begin
    fieldPreco  := input.NomeCampo;
    fieldMarkup := IfThen(fieldPreco = 'PREC_TAB_PROD', 'PERC_TB_PROD') +
                   IfThen(fieldPreco = 'PREC_PUBLICO', 'PERC_TB_PRODA') +
                   IfThen(fieldPreco = 'PREC_30_PROD', 'PERC_TB_PROD3') +
                   IfThen(fieldPreco = 'PREC_60_PROD', 'PERC_TB_PROD6') +
                   IfThen(fieldPreco = 'PREC_90_PROD', 'PERC_TB_PROD9');
    fieldMargem := IfThen(fieldPreco = 'PREC_TAB_PROD', 'MARGEM_V_DESEJ') +
                   IfThen(fieldPreco = 'PREC_PUBLICO', 'MARGEM_A_DESEJ') +
                   IfThen(fieldPreco = 'PREC_30_PROD', 'MARGEM_30_DESEJ') +
                   IfThen(fieldPreco = 'PREC_60_PROD', 'MARGEM_60_DESEJ') +
                   IfThen(fieldPreco = 'PREC_90_PROD', 'MARGEM_90_DESEJ');
    fieldPercen := IfThen(fieldPreco = 'PREC_30_PROD', 'PERC_AD_30') +
                   IfThen(fieldPreco = 'PREC_60_PROD', 'PERC_AD_60') +
                   IfThen(fieldPreco = 'PREC_90_PROD', 'PERC_AD_90');

    preco := RoundTo( input.GetValor(input.NomeCampo), DIGITOS_PRECO);
    preco := IfThen(preco > 0, preco);

    AddResult(fieldPreco, preco); // PRECO

    if (lockPrecoMarkup) and (custo > 0) and (preco > 0) then
    begin
      // markup e margem
      markup := RoundTo(input.GetValor(fieldMarkup), DIGROUNDMAX);
      calc := CalcUtils.Preco(custo, markup, DIGITOS_PRECO);
      if (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc, DIGITOS_PRECO)) and
         (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc + ajust, DIGITOS_PRECO)) then
      begin
        markup := CalcUtils.Markup(preco, custo, DIGROUNDMAX);

        if CalcUtils.Preco(custo, markup, DIGITOS_PRECO) < preco then // Ajustando o markup para evitar erros de arredondamento nos testes da venda
          markup := markup - (1 / StrToInt('1' + PadL(0, DIGROUNDMAX)));

        margem := CalcUtils.MargemLucro(markup, DIGROUNDMAX);
      end
      else
      begin
        margem := RoundTo(input.GetValor(fieldMargem), DIGROUNDMAX);
        calc := CalcUtils.Preco(custo, CalcUtils.Markup(margem, DIGROUNDMAX), DIGITOS_PRECO);
        if (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc, DIGITOS_PRECO)) and
           (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc + ajust, DIGITOS_PRECO)) then
        begin
          margem := CalcUtils.MargemLucro(preco, custo, DIGROUNDMAX);
          if CalcUtils.Preco(custo, CalcUtils.Markup(margem, DIGROUNDMAX), DIGITOS_PRECO) < preco then // Ajustando o markup para evitar erros de arredondamento nos testes da venda
            margem := margem - (1 / StrToInt('1' + PadL(0, DIGROUNDMAX)));
        end;
      end;

      if margem > 99.99 then
        margem := 99.99;

      AddResult(fieldMarkup, markup); // MARKUP
      AddResult(fieldMargem, margem); // MARGEM

      // percentual adicional
      percentual := 0;
      if (fieldPercen <> '') and (RoundTo(input.GetValor(fieldPercen), DIGROUNDMAX) <> 0) then
      begin
        percentual := RoundTo(input.GetValor(fieldPercen), DIGROUNDMAX);
        calc := CalcUtils.Preco(RoundTo(input.PrecoVarejo, DIGITOS_PRECO), percentual, DIGITOS_PRECO);

        if (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc, DIGITOS_PRECO)) and
           (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc + ajust, DIGITOS_PRECO)) then
          percentual := CalcUtils.Markup(preco, RoundTo(input.PrecoVarejo, DIGITOS_PRECO), DIGROUNDMAX);

        AddResult(fieldPercen, percentual); // PERCENTUAL ADICIONAL
      end;

      // percentual desconto 30 dias
      fieldPercen := IfThen(fieldPreco = 'PREC_TAB_PROD', 'PDESC_PR30_VAREJO');
      if (fieldPercen <> '') and (RoundTo(input.GetValor(fieldPercen), DIGROUNDMAX) <> 0) then
      begin
        preco := RoundTo(input.PrecoVarejo, DIGROUNDMAX);
        percentual := RoundTo(input.GetValor(fieldPercen), DIGROUNDMAX);
        calc := RoundTo(RoundTo(input.Preco30, DIGITOS_PRECO) - (RoundTo(input.Preco30, DIGITOS_PRECO) * percentual / 100), DIGITOS_PRECO);

        if (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc, DIGITOS_PRECO)) and
           (RoundTo(preco, DIGITOS_PRECO) <> RoundTo(calc + ajust, DIGITOS_PRECO)) then
          percentual := RoundTo((RoundTo(input.Preco30, DIGITOS_PRECO) - preco) / RoundTo(input.Preco30, DIGITOS_PRECO) * 100, DIGROUNDMAX);

        percentual := IfThen(percentual > 0, percentual);

        AddResult(fieldPercen, percentual); // PERCENTUAL DESCONTO
      end;

    end;

    if input.AlterarCamposCalculados then
      HandleMarkupMargemCalculados(input);

    if (input.NomeCampo = 'PREC_30_PROD') then
      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PDESC_PR30_VAREJO') ));

    if (input.NomeCampo = 'PREC_TAB_PROD') then
    begin
      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_AD_30') ));
      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_AD_60') ));
      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PERC_AD_90') ));
    end;

  end
  {$ENDREGION}

  {$REGION 'MARKUP'}
  else if MatchText(input.NomeCampo, ['PERC_TB_PROD', 'PERC_TB_PRODA', 'PERC_TB_PROD3', 'PERC_TB_PROD6', 'PERC_TB_PROD9']) then
  begin
    fieldMarkup := input.NomeCampo;
    fieldPreco := IfThen(fieldMarkup = 'PERC_TB_PROD', 'PREC_TAB_PROD') +
                  IfThen(fieldMarkup = 'PERC_TB_PRODA', 'PREC_PUBLICO') +
                  IfThen(fieldMarkup = 'PERC_TB_PROD3', 'PREC_30_PROD') +
                  IfThen(fieldMarkup = 'PERC_TB_PROD6', 'PREC_60_PROD') +
                  IfThen(fieldMarkup = 'PERC_TB_PROD9', 'PREC_90_PROD');
    fieldMargem := IfThen(fieldPreco = 'PREC_TAB_PROD', 'MARGEM_V_DESEJ') +
                   IfThen(fieldPreco = 'PREC_PUBLICO', 'MARGEM_A_DESEJ') +
                   IfThen(fieldPreco = 'PREC_30_PROD', 'MARGEM_30_DESEJ') +
                   IfThen(fieldPreco = 'PREC_60_PROD', 'MARGEM_60_DESEJ') +
                   IfThen(fieldPreco = 'PREC_90_PROD', 'MARGEM_90_DESEJ');

    markup := RoundTo(input.GetValor(fieldMarkup), DIGROUNDMAX);
    markup := IfThen(markup > 0, markup);

    AddResult(fieldMarkup, markup); // MARKUP

    if (lockPrecoMarkup) and (custo > 0) and (markup > 0) then
    begin
      preco := RoundTo(input.GetValor(fieldPreco), DIGITOS_PRECO);
      calc := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

      margem := CalcUtils.MargemLucro(markup, DIGROUNDMAX);
      preco  := CalcUtils.Preco(custo, markup, DIGITOS_PRECO);

      // valores muito baixos causam divergencias
      //if CalcUtils.Markup(preco, custo, DIGITOS_MARKUP) < markup then // Ajustando o preço para evitar erros de arredondamento nos testes da venda
        //preco := preco + ajust;

      //dataSet.FieldByName(fieldMargem).AsFloat := margem; // MARGEM
      AddResult(fieldPreco, preco);  // PRECO

      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, fieldPreco) ));
    end;
  end
  {$ENDREGION}

  {$REGION 'MARGEM'}
  else if MatchText(input.NomeCampo, ['MARGEM_V_DESEJ', 'MARGEM_A_DESEJ', 'MARGEM_30_DESEJ', 'MARGEM_60_DESEJ', 'MARGEM_90_DESEJ']) then
  begin
    fieldMargem := input.NomeCampo;
    fieldPreco := IfThen(fieldMargem = 'MARGEM_V_DESEJ', 'PREC_TAB_PROD') +
                  IfThen(fieldMargem = 'MARGEM_A_DESEJ', 'PREC_PUBLICO') +
                  IfThen(fieldMargem = 'MARGEM_30_DESEJ', 'PREC_30_PROD') +
                  IfThen(fieldMargem = 'MARGEM_60_DESEJ', 'PREC_60_PROD') +
                  IfThen(fieldMargem = 'MARGEM_90_DESEJ', 'PREC_90_PROD');
    fieldMarkup := IfThen(fieldPreco = 'PREC_TAB_PROD', 'PERC_TB_PROD') +
                   IfThen(fieldPreco = 'PREC_PUBLICO', 'PERC_TB_PRODA') +
                   IfThen(fieldPreco = 'PREC_30_PROD', 'PERC_TB_PROD3') +
                   IfThen(fieldPreco = 'PREC_60_PROD', 'PERC_TB_PROD6') +
                   IfThen(fieldPreco = 'PREC_90_PROD', 'PERC_TB_PROD9');

    margem := RoundTo(input.GetValor(fieldMargem), DIGROUNDMAX);
    margem := IfThen(margem > 0, margem);

    AddResult(fieldMargem, margem); // MARGEM
    // 1 - Alterei margem, 2 get markup, 3 calc preco
    if lockPrecoMarkup and (custo > 0) and (margem > 0) then
    begin
      preco := RoundTo(input.GetValor(fieldPreco), DIGITOS_PRECO);
      markup := CalcUtils.Markup(preco, custo, DIGROUNDMAX);
      calc := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

      if (RoundTo(margem, DIGROUNDMAX) <> RoundTo(calc, DIGROUNDMAX)) and
         (RoundTo(margem, DIGROUNDMAX) <> RoundTo(calc + 0.001, DIGROUNDMAX)) and
         (RoundTo(margem, DIGROUNDMAX) <> RoundTo(calc - 0.001, DIGROUNDMAX)) then
      begin
        markup := CalcUtils.Markup(margem, DIGROUNDMAX);
        preco  := CalcUtils.Preco(custo, markup, DIGITOS_PRECO);

        // valores muito baixos causam divergencias
        //if CalcUtils.Markup(preco, custo, DIGITOS_MARKUP) < markup then // Ajustando o preço para evitar erros de arredondamento nos testes da venda
          //preco := preco + ajust;

        AddResult(fieldMarkup, markup); // MARKUP
      end;

      AddResult(fieldPreco, preco);  // PRECO
      //dataSet.FieldByName(fieldMarkup).AsFloat := markup; // MARKUP

      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, fieldPreco) ));
    end;
  end
  {$ENDREGION}

  {$REGION '% DESCONTO 30 DIAS'}
  else if MatchText(input.NomeCampo, ['PDESC_PR30_VAREJO']) then
  begin
    preco := RoundTo(input.GetValor('PREC_30_PROD'), DIGITOS_PRECO);
    preco := IfThen(preco > 0, preco);
    percentual := input.GetValor(input.NomeCampo);
    percentual := IfThen(percentual > 0, percentual);
    if (percentual > 0) and (preco > 0) then
    begin
      preco := RoundTo(preco - (preco * percentual / 100), DIGITOS_PRECO);
      AddResult('PREC_TAB_PROD', preco);  // PRECO
      AddResult('PERC_AD_30', 0);

      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, 'PREC_TAB_PROD') ));
    end;

  end
  {$ENDREGION}

  {$REGION '% ADICIONAL'}
  else if MatchText(input.NomeCampo, ['PERC_AD_30', 'PERC_AD_60', 'PERC_AD_90']) then
  begin

    fieldMarkup := input.NomeCampo;
    fieldPreco := IfThen(fieldMarkup = 'PERC_AD_30', 'PREC_30_PROD') +
                  IfThen(fieldMarkup = 'PERC_AD_60', 'PREC_60_PROD') +
                  IfThen(fieldMarkup = 'PERC_AD_90', 'PREC_90_PROD');

    calc       := RoundTo(input.GetValor('PREC_TAB_PROD'), DIGITOS_PRECO);
    percentual := RoundTo(input.GetValor(fieldMarkup), DIGROUNDMAX);
    percentual := IfThen(percentual > 0, percentual);

    AddResult(fieldMarkup, percentual); // percentual

    if (calc > 0) and (percentual > 0) then
    begin
      if input.NomeCampo = 'PERC_AD_30' then
        AddResult('PDESC_PR30_VAREJO', 0);

      preco := CalcUtils.Preco(calc, percentual, DIGITOS_PRECO);

      // valores muito baixos causam divergencias
      //if CalcUtils.Markup(preco, calc, DIGITOS_MARKUP) < percentual then // Ajustando o preço para evitar erros de arredondamento nos testes da venda
        //preco := preco + ajust;

      AddResult(fieldPreco, preco);  // PRECO

      AddResults( ObterAlteracaoPreco( AlteracaoPrecoInput.New(input, fieldPreco) ));
    end;
  end
  {$ENDREGION}

  {$REGION 'PROMOCIONAL'}
  else if input.NomeCampo = 'PRECO_PROMOCAO' then
  begin
    AddResult(input.NomeCampo, input.GetValor(input.NomeCampo));
    if input.AlterarCamposCalculados then
      HandleMarkupMargemCalculados(input);
  end;
  {$ENDREGION}

end;

procedure TProdutos.HandleAlteracaoPreco(fieldName: string);
var
  input: AlteracaoPrecoInput;
  respItem: AlteracaoPrecoOutput;
  resposta: AlteracoesPrecoOutput;
begin

  input := AlteracaoPrecoInput.New(Self.dataSet, fieldName);
  input.AlterarCamposCalculados := True;// ???

  resposta := ObterAlteracaoPreco(input);

  for respItem in resposta do
    dataSet.FieldByName(respItem.NomeCampo).AsFloat := respItem.ValorCampo;
end;
{
procedure TProdutos.HandleAlteracaoPrecoAtacado;
var
  preco, margem, markup, precoTmp: Double;
begin

  preco := ffloat('prec_publico', 0 - vDadosIni.vEmp.vCasasDecimais);

  dataSet.FieldByName('prec_publico').AsFloat := IfThen(preco > 0, preco);  // PRECO

  if (vDadosIni.vEmp.vALT_PERC_MARGEM = 'S') and (ffloat('prec_cusm_prod') > 0) and (preco > 0) then
  begin

    margem := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);
    markup := RoundTo((preco / ffloat('prec_cusm_prod') - 1) * 100, -2);

    precoTmp := RoundTo(ffloat('prec_cusm_prod') / ( 1 - margem / 100), 0 - vDadosIni.vEmp.vCasasDecimais);

    if (precoTmp > preco) and (margem > 0.01)   then
      margem := margem - 0.01;

    if margem > 99.99 then
      margem := 99.99;

    dataSet.FieldByName('perc_tb_proda').AsFloat  := markup; // MARKUP
    dataSet.FieldByName('margem_a_desej').AsFloat := margem; // MARGEM
  end;

  HandleMarkupMargemCalculados;

end;

procedure TProdutos.HandleAlteracaoPrecoVarejo;
var
  preco, margem, markup: Double;
begin

  preco := ffloat('prec_tab_prod', 0 - vDadosIni.vEmp.vCasasDecimais);

  dataSet.FieldByName('prec_tab_prod').AsFloat := IfThen(preco > 0, preco);  // PRECO

  if (vDadosIni.vEmp.vALT_PERC_MARGEM = 'S') and (ffloat('prec_cusm_prod') > 0) and (preco > 0) then
  begin

    margem := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);
    markup := RoundTo((preco / ffloat('prec_cusm_prod') - 1) * 100, -2);

    if margem > 99.99 then
      margem := 99.99;

    dataSet.FieldByName('perc_tb_prod').AsFloat   := markup; // MARKUP
    dataSet.FieldByName('margem_v_desej').AsFloat := margem; // MARGEM

  end;

  HandleAlteracaoPercentualAd_30;
  HandleAlteracaoPercentualAd_60;
  HandleAlteracaoPercentualAd_90;
  HandleMarkupMargemCalculados;
end;
}
procedure TProdutos.HandleMarkupMargemCalculados(input: AlteracaoPrecoInput);
var
  custo, preco, markup: Double;
begin
  custo := input.CustoMedio;

  preco  := input.GetValor('prec_tab_prod');
  markup := input.GetValor('perc_tb_prod');
  DataSet.FieldByName('markup_v_calc').AsFloat  := CalcUtils.Markup(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_v_calc').AsFloat  := CalcUtils.MargemLucro(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_v_desej').AsFloat := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

  preco  := input.GetValor('prec_publico');
  markup := input.GetValor('perc_tb_proda');
  DataSet.FieldByName('markup_a_calc').AsFloat  := CalcUtils.Markup(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_a_calc').AsFloat  := CalcUtils.MargemLucro(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_a_desej').AsFloat := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

  preco  := input.GetValor('prec_30_prod');
  markup := input.GetValor('perc_tb_prod3');
  DataSet.FieldByName('markup_30_calc').AsFloat  := CalcUtils.Markup(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_30_calc').AsFloat  := CalcUtils.MargemLucro(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_30_desej').AsFloat := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

  preco  := input.GetValor('prec_60_prod');
  markup := input.GetValor('perc_tb_prod6');
  DataSet.FieldByName('markup_60_calc').AsFloat  := CalcUtils.Markup(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_60_calc').AsFloat  := CalcUtils.MargemLucro(preco, custo, DIGROUNDMAX);
  DataSet.FieldByName('margem_60_desej').AsFloat := CalcUtils.MargemLucro(markup, DIGROUNDMAX);

  preco  := input.GetValor('prec_90_prod');
