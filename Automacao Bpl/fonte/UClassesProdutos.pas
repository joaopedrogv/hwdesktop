    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1' +
    ' group by grupo_prod, cod_prod order by 3 desc';
  buscas.ParamByName('vdata').AsDate := vdataatual - (QtdMesEmpresa * 30);
  buscas.Prepare;
  buscas.Open;
  progressBar.min := 0;
  progressBar.position := 0;
  buscas.FetchAll;
  qtdGeral := buscas.RecordCount;
  totalF1 := ((qtdGeral * 10) / 100);
  totalF2 := ((qtdGeral * 20) / 100);
  totalF3 := ((qtdGeral * 70) / 100);
  i := 1;
  qtdItem := 0;
  ProgressBar.max := buscas.RecordCount;
  buscas.First;
  Panel.Caption := 'Classificando Frequência de Produtos: ''F1'',''F2'',''F3'' ou ''F4''  ' +
    vDadosIni.strzero(ProgressBar.Position, 5);
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    begin
      Qrprodupdate.SQL.text := 'update produtos set CLFRV = :CLFRV ' +
        ' WHERE GRUPO_PROD = ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
        ' AND COD_PROD = ' + quotedstr(buscas.FieldByName('COD_PROD').AsString) +
        ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
      if i = 1 then
        Qrprodupdate.ParamByName('CLFRV').AsString := 'F1'
      else if i = 2 then
        Qrprodupdate.ParamByName('CLFRV').AsString := 'F2'
      else
        Qrprodupdate.ParamByName('CLFRV').AsString := 'F3';
      Qrprodupdate.Prepare;
      Qrprodupdate.ExecSQL;
      ibtransprodup.Commit;
    end;
    qtdItem := qtdItem + 1;
    if i = 1 then
    begin
      if qtdItem >= totalF1 then
      begin
        qtdItem := 0;
        i := 2;
      end;
    end
    else
    begin
      if i = 2 then
      begin
        if qtdItem >= totalF2 then
        begin
          qtdItem := 0;
          i := 3;
        end;
      end;
    end;
    buscas.next;
    if Parar = 1 then
    begin
      if Application.MessageBox('Deseja Cancelar Processamento?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        break
      else
        Parar := 0;
    end;
    ProgressBar.Position := ProgressBar.Position + 1;
    Panel.Caption := 'Classificando Produtos: ''F1'',''F2'',''F3'' ou ''F4''  ' +
      vDadosIni.strzero(ProgressBar.Position, 5);
  end;
  //  ClasseProd.ExecutaComandosSqlExec('delete from FREQTEMP where cod_empresa=' +
  //    vDadosIni.codEmpresa);
  if Parar = 1 then
  begin
    result := false;
    exit;
  end;
  //T1,T2,T3,T4
  buscas.Close;
  buscas.SQL.Text := 'select grupo_prod,cod_prod,max(data_os_rq) as UltimaData' +
    ' from demandap4 where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1' +
    ' group by grupo_prod,cod_prod';
  buscas.Open;
  progressBar.min := 0;
  progressBar.position := 0;
  buscas.FetchAll;
  ProgressBar.max := buscas.RecordCount;
  buscas.First;
  Panel.Caption := 'Classificando Frequência de Produtos: ''T1'',''T2'',''T3'' ou ''T4''  ' +
    vDadosIni.strzero(ProgressBar.Position, 5);
  while not buscas.eof do
  begin
//      if  (buscas.FieldByName('GRUPO_PROD').AsInteger = 1) and
//    (trim(buscas.FieldByName('COD_PROD').asstring) = '00105') then
//     ShowMessage('OK');

    Application.ProcessMessages;
    begin
      Qrprodupdate.SQL.text := 'update produtos set CLATL = :CLATL ' +
        ' WHERE GRUPO_PROD = ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
        ' AND COD_PROD = ' + quotedstr(buscas.FieldByName('COD_PROD').AsString) +
        ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;

      if (vdataatual - buscas.FieldByName('UltimaData').AsDateTime) <= 90 then
        Qrprodupdate.ParamByName('CLATL').AsString := 'T1'
      else if (vdataatual - buscas.FieldByName('UltimaData').AsDateTime > 90) and (vdataatual -
        buscas.FieldByName('UltimaData').AsDateTime <= 180) then
        Qrprodupdate.ParamByName('CLATL').AsString := 'T2'
      else if (vdataatual - buscas.FieldByName('UltimaData').AsDateTime > 180) and (vdataatual -
        buscas.FieldByName('UltimaData').AsDateTime <= 360) then
        Qrprodupdate.ParamByName('CLATL').AsString := 'T3'
      else
      begin
        ClasseProd.buscas.close;
        ClasseProd.buscas.SQL.Text := 'select max(data) as data_lanc_nfe' +
          ' from custos ' +
          ' where grupo_prod = ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + quotedstr(buscas.FieldByName('COD_PROD').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
        {'select max(nf.data_lanc_nfe) as data_lanc_nfe' +
          ' from nf_entrada nf,item_nf_entrada it' +
          ' where it.grupo_prod = ' + qrProd.FieldByName('GRUPO_PROD').asstring +
          ' and it.cod_prod = ' + quotedstr(qrProd.FieldByName('COD_PROD').asstring) +
          ' and it.num_nota_nfe = nf.num_nota_nfe and it.cod_forn_nfe =nf.cod_forn_nfe' +
          ' and nf.cod_empresa = it.cod_empresa and ' +
          ' nf.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf.ativo=1';}
        //          ' order by nf.data_lanc_nfe desc';
        ClasseProd.buscas.Open;
        if ClasseProd.buscas.IsEmpty then
          Qrprodupdate.ParamByName('CLATL').AsString := 'T4'
        else
        begin
          if (vdataatual - ClasseProd.buscas.FieldByName('DATA_LANC_NFE').AsDateTime) <= 360 then
            Qrprodupdate.ParamByName('CLATL').AsString := 'R'
          else
            Qrprodupdate.ParamByName('CLATL').AsString := 'T4';
        end;
      end;
      Qrprodupdate.Prepare;
      Qrprodupdate.ExecSQL;
      ibtransprodup.Commit;
    end;
    buscas.next;
    if Parar = 1 then
    begin
      if Application.MessageBox('Deseja Cancelar Processamento?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        break
      else
        Parar := 0;
    end;
    ProgressBar.Position := ProgressBar.Position + 1;
    Panel.Caption := 'Classificando Produtos: ''T1'',''T2'',''T3'' ou ''T4''  ' +
      vDadosIni.strzero(ProgressBar.Position, 5);
  end;
  if qrProd.UpdatesPending then
    qrProd.ApplyUpdates;

  try
    ClasseProd.buscas.Close;
    ClasseProd.buscas.SQL.Text := 'update empresa e ' +
      ' set e.DTDEF_CLASSEP= :vData' +
      ' ,e.QTDMES_CLASSEP = ' + inttostr(QtdMesEmpresa) +
      ' where e.cod_empresa =' + vDadosIni.codEmpresa +
      ' and e.ativo=1';
    ClasseProd.buscas.ParamByName('vData').AsDate := vDadosIni.getDataBanco(buscas);
    ClasseProd.buscas.Prepare;
    ClasseProd.buscas.ExecSQL;
  except
    on E: Exception do
    begin
      result := false;
      if inibeErro <> 'S' then
        Application.MessageBox(PChar('Erro ao gravar data e quantidade de meses de referência para a definição classes na tabela empresa. SQL: ' + ClasseProd.buscas.SQL.Text), 'Atenção', MB_ICONWARNING + MB_OK);
      inibeErro := 'N';
      registraErro('E0006 ' + e.Message + ' ' + ClasseProd.buscas.SQL.Text);
      exit;
    end;
  end;
  buscas.Close;
  qrProd.Close;
  ClasseProd.buscas.Close;
  if Parar = 1 then
  begin
    result := false;
    exit;
  end
  else
    Application.MessageBox(PChar('Definição de Classes Concluída com sucesso! '), 'Atenção',
      MB_ICONWARNING + MB_OK);
end;

procedure TProdutos.CurvaABCVariaveis;
begin
  if ClasseProd = nil then
    ClasseProd := TPesquisaProd.create;
  buscas.Close;
  buscas.SQL.Text :=
    'select QTMESSUG,CASAS_DECIMAIS,TP_SUG,TE_SUG,TA_SUG,FP_SUG,EST_SEGURACAPROD from empresa where cod_empresa = ' +
    vDadosIni.codEmpresa;
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    QtdMesEmpresa := buscas.FieldByName('QTMESSUG').AsInteger;
    NumeroCasasDecimais := buscas.FieldByName('CASAS_DECIMAIS').AsInteger;
    TpProcessamento := buscas.FieldByName('TP_SUG').AsInteger;
    TpEntrega := buscas.FieldByName('TE_SUG').AsInteger;
    TpAlocacao := buscas.FieldByName('TA_SUG').AsInteger;
    FreqPedido := buscas.FieldByName('FP_SUG').AsInteger;
    EstSeguracaPadrao := buscas.FieldByName('EST_SEGURACAPROD').AsInteger;
  end;
  buscas.Close;
end;

function TProdutos.DadosProdutoObrigatorios: boolean;
var
 vMensagem: string;
begin
  try
    Result := False;

    if (dataSet.FieldByName('GRUPO_PROD').AsInteger <= 0) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Grupo do Produto não Informado.' + chr(13) + 'Campo Requerido.', 'DBEdit16');
    end;

    if trim(dataSet.FieldByName('COD_PROD').AsString) = '' then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Código do Produto não Informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox1');
    end;

    if trim(dataSet.FieldByName('NUM_FAB_PROD').AsString) = '' then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Número de Fabricação não Informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox1');
    end;

    if trim(dataSet.FieldByName('DESCR_PROD').asstring) = '' then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Descrição do produto é obrigatória.', 'DBEdit28');
    end;

    if trim(dataSet.FieldByName('DESCR_PROD_RED').asstring) = '' then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Descrição Reduzida do produto é obrigatória.', 'DBEdit77');
    end;

    if not TestarCFOP(vMensagem) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate(vMensagem, 'DBEdit3');
    end;

    if not TestarCFOPInter(vMensagem) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate(vMensagem, 'DBEdit25');
    end;

    if not TestarCST(trim(dataSet.FieldByName('CST_PROD').AsString), vMensagem) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate(vMensagem, 'DBEdit48');
    end;

    if trim(dataSet.FieldByName('UNIDADE').AsString) = '' then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Unidade não Informado.' + chr(13) + 'Favor corrigir.', 'DBComboBox23');
    end;

    if not validarCamposPersonalizados then
      Exit;

    if ((trim(dataSet.FieldByName('TIP_PROD_IND').asstring) = '') and
       (vDadosIni.vEmp.vVersaoVeiculos = '4') and
      (trim(vDadosIni.vEmp.vTipoEmpVeiculos) = 'C')) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Tipo do produto não informado.' + chr(13) + 'Favor corrigir.', 'DBLookupComboBox15');
    end;

    if (trim(dataSet.FieldByName('TIP_PROD_IND').asstring) <> '') then
    begin
      if not TipoProdInd(trim(dataSet.FieldByName('TIP_PROD_IND').asstring)) then
      begin
        FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
        raiseExceptionCreate('Tipo do produto não encontrado.' + chr(13) + 'Favor corrigir.', 'DBLookupComboBox15');
      end;
    end;

    if not TestarCSOSN(vMensagem) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate(vMensagem, 'DBEdit189');
    end;

    if (dataSet.FieldByName('PREC_TAB_PROD').IsNull) or (dataSet.FieldByName('PREC_TAB_PROD').AsFloat <= 0) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
      raiseExceptionCreate('Valor do produto inválido.' + chr(13) + 'Favor corrigir.', 'DBEdit8');
    end;

    if ((trim(dataSet.FieldByName('TIPO_ITEM').asstring) = '') and
      ((vDadosIni.vEmp.vUsarProducao = 'S') or (vDadosIni.vEmp.vUsarProducao = 'D'))) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.tsSped;
      raiseExceptionCreate('Tipo de item não Informado.' + chr(13) + 'Campo Requerido', 'DBComboBox11');
    end;

    if (dataSet.FieldByName('EM_PROMOCAO').AsString = 'S') and (dataSet.FieldByName('PRECO_PROMOCAO').AsFloat <= 0) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet4;
      raiseExceptionCreate('Preço do produto para promoção inválido.' + chr(13) +
        'Informe o preço de Promoção corretamente.', 'DBEdit76');
    end;

    if (Trim(dataSet.FieldByName('NBM').AsString) <> '') and (Length(Trim(dataSet.FieldByName('NBM').AsString)) <> 8) then
    begin
      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.tssped;
      raiseExceptionCreate('NCM inválido.' + chr(13) + 'O NCM deve conter 8 dígitos.', 'DBEdit63');
    end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
      if vProdutosEC.dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S' then
      begin
        if dataSet.FieldByName('PESO_BRUT_PROD').AsFloat <= 0 then
        begin
          FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
          raiseExceptionCreate('Campo peso bruto não informado', 'DBEdit69');
        end;

        if (dataSet.FieldByName('COMPRIMENTO_PROD').AsInteger <= 0) then
        begin
        	FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
  	      raiseExceptionCreate('Campo comprimento não informado', 'DBEdit212');
        end;

        if (dataSet.FieldByName('ALTURA_PROD').AsInteger <= 0) then
        begin
        	FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
          raiseExceptionCreate('Campo altura não informado', 'DBEdit213');
        end;

        if (dataSet.FieldByName('LARGURA_PROD').AsInteger <= 0) then
        begin
        	FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet3;
          raiseExceptionCreate('Campo largura não informado', 'DBEdit214');
        end;
      end;

//    if trim(dataSet.FieldByName('CST_PIS').AsString) <> trim(dataSet.FieldByName('CST_COFINS').AsString) then
//    begin
//      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.tssped;
//      raiseExceptionCreate('CST de Venda PIS Diferente de CST COFINS.', 'DBComboBox12');
//    end;

//    if trim(dataSet.FieldByName('CST_PIS_ENT').AsString) <> trim(dataSet.FieldByName('CST_COFINS_ENT').AsString) then
//    begin
//      FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.tssped;
//      raiseExceptionCreate('CST de Compra PIS Diferente de CST COFINS.', 'DBComboBox13');
//    end;

    if (dataSet.FieldByName('N_INCIDENCIA_PROD').AsString = 'S') or (dataSet.FieldByName('ISENTO_PROD').AsString = 'S') then
        dataSet.FieldByName('ICM_PROD').AsFloat := 0;

    if (dataSet.FieldByName('ICM_PROD').AsFloat = 0)
      and ((dataSet.FieldByName('ALIQ_RED_PROD').AsFloat <> 0) or (Trim(dataSet.FieldByName('TOT_ALIQ').AsString) <> '')) then
       if Application.MessageBox(pchar('Campo(s) de redução da aliquota no ECF preenchido(s)!' + #13 +
          'Deseja que o sistema remova os valores deste(s) campo(s)?'),
          'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          dataSet.FieldByName('ALIQ_RED_PROD').AsString := '';
          dataSet.FieldByName('TOT_ALIQ').AsString := '';
        end
        else
        begin
          FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.TabSheet4;
          if FrmCadProdutos.DBEdit32.CanFocus then
          	FrmCadProdutos.DBEdit32.SetFocus;
        end;

    if (dataSet.State in [dsInsert, dsEdit]) then
      dataSet.FieldByName('CEST').AsString := vDadosIni.apenasNumeros(Trim(dataSet.FieldByName('CEST').AsString));

    if Trim(dataSet.FieldByName('CEST').AsString) <> '' then
      if Length(Trim(dataSet.FieldByName('CEST').AsString)) <> 7 then
      begin
        FrmCadProdutos.PageControl3.ActivePage := FrmCadProdutos.tsSped;
        raiseExceptionCreate('Campo CEST com preenchimento inválido. Se preenchido deve conter 7 dígitos', 'DBEdit116');
      end;

    if vConsProdutosConversao.dataSet.Active then    
      try

        if vConsProdutosConversao.filterStr('unidade = ''%s''', [fstr('unidade')]).dataSet.RecordCount > 0 then
          raise Exception.Create('Produto possui uma conversão com unidade igual a unidade do estoque. Por favor corrija antes de prosseguir');
      finally
        vConsProdutosConversao.filterClear;
      end;    

    Result := True;  
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutos.deletaEtiProdTemp(pNITEM: integer; desmarcartodas: boolean): boolean;
begin
  if desmarcartodas then
  begin
    ExecutaComandosSqlExec('delete  from IMP_BAR_PROD where cod_empresa=' + vDadosIni.codEmpresa);
    ExecutaComandosSqlExec('update CODIGO set VALOR =0 where tabela=''IMP_BAR_PROD'' and cod_empresa='
      + vDadosIni.codEmpresa);
    result := CommitaTransacao;
    if Result then
      dtSetProdTemp.EmptyDataSet;
  end
  else
  begin
    ExecutaComandosSqlExec('delete  from IMP_BAR_PROD where cod_empresa=' + vDadosIni.codEmpresa +
      ' and NITEM=' + inttostr(pNITEM));
    result := CommitaTransacao;
    if Result then
      dtSetProdTemp.Delete;
  end;
end;

function TProdutos.delete: boolean;
var
	vReplicacaoInterna: boolean;
  vtemp: string;
  vListaEmp: TStringList;
  vApagar: boolean;
  vGrupoProd, vCodProd, vDescrProd, vNumFabProd: string;
  vEcommerceHab, vComercioHab: boolean;
  I: Integer;
begin
	try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    vListaEmp := TStringList.Create;
    vListaEmp.Duplicates := dupIgnore;
    vListaEmp.Clear;

    buscas.Close;
    buscas.SQL.Text := ' select * from TAB_REP where TABELA = ''PRODUTOS'' ';
    buscas.open;
    vReplicacaoInterna := not buscas.IsEmpty;

    vListaEmp.Add(IntToStr(vDadosIni.cod_empresa));
    if vReplicacaoInterna then
    begin
      buscas.close;
      buscas.sql.Text := ' select cod_empresa, ' +
       ' coalesce(emp_repl_interna, ' + IntToStr(vDadosIni.cod_empresa) + ') emp_repl_interna from EMPRESA ' +
       ' where ativo = 1 and COD_EMPRESA <> ' + IntToStr(vDadosIni.cod_empresa);
      buscas.Open;
      buscas.FetchAll;

      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.FieldByName('EMP_REPL_INTERNA').AsInteger = vDadosIni.cod_empresa then
          vListaEmp.Add(IntToStr(buscas.FieldByName('COD_EMPRESA').AsInteger));

        buscas.Next;
      end;
    end;

    try
      vApagar := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vGrupoProd := trim(dataSet.FieldByName('GRUPO_PROD').AsString);
      vCodProd := trim(dataSet.FieldByName('COD_PROD').AsString);
      vNumFabProd := trim(dataSet.FieldByName('NUM_FAB_PROD').AsString);
      vDescrProd := trim(dataSet.FieldByName('DESCR_PROD').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
      	vApagar := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vGrupoProd := '';
	      vCodProd := '';
        vNumFabProd := '';
        vDescrProd := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vGrupoProd) <> '') or (trim(vCodProd) <> '') then
      	prepare_loop('GRUPO_PROD = ' + vGrupoProd + ' AND COD_PROD = ' + QuotedStr(vCodProd))
      else
		    prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente' +
          vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + vGrupoProd + #13 +
          'Cod Prod: ' + vCodProd + #13 +
          'Num Fabricante: ' + vNumFabProd + #13 +
          'Descrição: ' + vDescrProd;

        if (trim(vGrupoProd) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente' +
            vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?';

        if not vDadosIni.PesqPros('PRO005', 'EXCLUIR', '', 'PRODUTOS',
          vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira' +
          vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + vGrupoProd + #13 +
          'Cod Prod: ' + vCodProd + #13 +
          'Num Fabricante: ' + vNumFabProd + #13 +
          'Descrição: ' + vDescrProd;

        if (trim(vGrupoProd) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira' +
            vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?';

        if not vDadosIni.PesqPros('PRO006', 'EXCLUIR', '', 'PRODUTOS',
           vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo produto(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo produto(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
      	if vApagar then
	      	vDadosIni.abreStatusProcessamento('', 'Excluíndo produto(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
        	vDadosIni.abreStatusProcessamento('', 'Movendo produto(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          for I := 0 to vListaEmp.Count - 1 do
          begin
            SqlOpen(' select grupo_prod, cod_prod, cod_empresa from estoque_diario ' +
              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d and dia <> ''30.12.1899''',
              [fint('grupo_prod'), fstr('cod_prod'), StrToInt(vListaEmp[I])], buscas);

            if not buscas.IsEmpty then
            begin
            	vtemp := 'Produto com estoque diário movimentado' +
                vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' emp ' + vListaEmp[I], '') +
                ', não é possível excluir.' + #13 + #13 +
                'Produto' + #13 +
                'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

              Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              RollBackTransacao;
              exit;
            end;

            SqlOpen(' select nped, tipo, cod_empresa from pedvenda_prod ' +
            	' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstr('cod_prod'), StrToInt(vListaEmp[I])], buscas);

            if not buscas.IsEmpty then
            begin
            	vtemp := 'Produto utilizado em vendas' +
                vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' emp ' + vListaEmp[I], '') +
                ', não é possível excluir.' + #13 + #13 +
                'Produto' + #13 +
                'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

              Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              RollBackTransacao;
              exit;
            end;

            SqlOpen(' select cod_nf, cod_empresa from notafiscal_item ' +
            	' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstr('cod_prod'), StrToInt(vListaEmp[I])], buscas);

            if not buscas.IsEmpty then
            begin
            	vtemp := 'Produto utilizado em nota fiscal' +
                vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' emp ' + vListaEmp[I], '') +
                ', não é possível excluir.' + #13 + #13 +
                'Produto' + #13 +
                'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

              Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              RollBackTransacao;
              exit;
            end;

            SqlOpen(' select chave, cod_empresa, value1_f from config_sistema ' +
              ' where chave = ' + QuotedStr('e-commerce_hab') +
              ' and cod_empresa = ' + vListaEmp[I], buscas);

            if buscas.IsEmpty then
              vEcommerceHab := false
            else
              vEcommerceHab := buscas.FieldByName('value1_f').AsInteger = 1;

            SqlOpen(' select chave, cod_empresa, value1_f from config_sistema ' +
              ' where chave = ' + QuotedStr('comercio_aberto_hab') +
              ' and cod_empresa = ' + vListaEmp[I], buscas);

            if buscas.IsEmpty then
              vComercioHab := false
            else
              vComercioHab := buscas.FieldByName('value1_f').AsInteger = 1;

            if ((vEcommerceHab) or (vComercioHab)) then
            begin
              SqlOpen(' select grupo_prod, cod_prod, cod_empresa, ' +
                ' sinc_ecommerce, env_comercio_aberto from produtos_ec ' +
                ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
                ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
                ' and cod_empresa = ' + vListaEmp[I], buscas);

              if not buscas.IsEmpty then
              begin
                if buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S' then
                begin
                  vtemp := 'Produto utilizado no E-Commerce' +
                    vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' Emp ' + vListaEmp[I], '') + ',' +
                    ' deseja excluir assim mesmo?' + #13 + #13 +
                    'Produto' + #13 +
                    'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                    'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                    'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                    'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

                  if Application.MessageBox(PChar(vtemp), 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
                  begin
                    RollBackTransacao;
                    Exit;
                  end;

                  if not vDadosIni.PesqPros('PRO310', 'APAGAR',
                    vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), 'EMP ' + vListaEmp[I], ''), 'PRODUTOS',
                    dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
                    dataSet.FieldByName('COD_PROD').AsString, buscas, True) then
                  begin
                    RollBackTransacao;
                    Exit;
                  end;
                end;

                if buscas.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S' then
                begin
                  vtemp := 'Produto utilizado no Comércio Aberto' +
                    vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' Emp ' + vListaEmp[I], '') + ',' +
                    ' deseja excluir assim mesmo?' + #13 + #13 +
                    'Produto' + #13 +
                    'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                    'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                    'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                    'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

                  if Application.MessageBox(PChar(vtemp), 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
                  begin
                    RollBackTransacao;
                    Exit;
                  end;

                  if not vDadosIni.PesqPros('PRO380', 'APAGAR',
                    vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), 'EMP ' + vListaEmp[I], ''), 'PRODUTOS',
                    dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
                    dataSet.FieldByName('COD_PROD').AsString, buscas, True) then
                  begin
                    RollBackTransacao;
                    Exit;
                  end;
                end;

                if (buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S')
                  or (buscas.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S') then
                begin
                  SqlOpen(' select pd.id_commerce from pedvenda pd ' +
                    ' inner join pedvenda_prod pp on pp.nped = pd.nped and pp.tipo = pd.tipo and pp.cod_empresa = pd.cod_empresa ' +
                    ' where pp.tipo = ''REQ'' ' +
                    ' and pp.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
                    ' and pp.cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
                    ' and pp.cod_empresa = ' + vListaEmp[I] +
                    ' and pd.id_commerce > 0 ', buscas);

                  if not buscas.IsEmpty then
                  begin
                    if (buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S')
                     and (buscas.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S') then
                      vtemp := 'E-Commerce e Comércio Aberto'
                    else if (buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
                      vtemp := 'E-Commerce'
                    else if (buscas.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S') then
                      vtemp := 'Comércio Aberto';

                    vtemp := 'Produto ' +
                      vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' Emp ' + vListaEmp[I], '') +
                      'pertence ao ' + vtemp + ' foi vendido no ERP, não é possível enviar registro para a lixeira.' + #13 + #13 +
                      'Produto' + #13 +
                      'Grupo Prod: ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) + #13 +
                      'Cod Prod: ' + dataSet.FieldByName('cod_prod').AsString + #13 +
                      'Num Fabricante: ' + dataSet.FieldByName('num_fab_prod').AsString + #13 +
                      'Descrição: ' + dataSet.FieldByName('descr_prod').AsString;

                    Application.MessageBox(PChar(vtemp), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
                    RollBackTransacao;
                    exit;
                  end;
                end;
              end;
            end;
          end;

//          buscas.Close;
//          buscas.SQL.Text := 'insert into evidencias_paf (cod_empresa, registro, data_movimento, campos_chave, valores_campos)' +
//            ' values (' + vDadosIni.codEmpresa + ', ' + QuotedStr('PRD') + ', asdasdasd, '''', ' + //PRD: PRODUTOS DELETE
//            QuotedStr('P|' + dataSet.FieldByName('GRUPO_PROD').AsString + '|' +
//            Trim(dataSet.FieldByName('COD_PROD').AsString) + '|') + ')';
//          buscas.ExecSQL;

          for I := 0 to vListaEmp.Count - 1 do
          begin
//            SqlExec(' delete from estoque_diario ' +
//              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d and dia = ''30.12.1899''',
//              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);
//
//            SqlExec(' delete from produtos ' +
//              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
//              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);
          	SqlExec(' update produtos set ativo = 99, rep_int_active = 1 ' +
              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);

            SqlExec(' update cod_barra set ativo = 99 ' +
              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);
          end;
          if (trim(vGrupoProd) = '') then
            vDadosIni.GravaAuditoria('PRO005', 'EXCLUIR', '', 'PRODUTOS',
              dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
              dataSet.FieldByName('COD_PROD').AsString, buscas);
        end
        else
        begin
          for I := 0 to vListaEmp.Count - 1 do
          begin
            SqlExec(' update produtos set ativo = 0, rep_int_active = 1 ' +
              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);

            SqlExec(' update cod_barra set ativo = 0 ' +
              ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d ',
              [fint('grupo_prod'), fstrq('cod_prod'), StrToInt(vListaEmp[I])], buscas);
          end;
          if (trim(vGrupoProd) = '') then
            vDadosIni.GravaAuditoria('PRO006', 'EXCLUIR', '', 'PRODUTOS',
              dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
              dataSet.FieldByName('COD_PROD').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO005', 'PRO006'),
      	'EXCLUIR', 'SUCESSO', 'PRODUTOS',
        vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO005', 'PRO006'),
      	'EXCLUIR', 'FALHA', 'PRODUTOS',
        vDadosIni.IfThen(trim(vGrupoProd) <> '', vGrupoProd + '-' + vCodProd, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

