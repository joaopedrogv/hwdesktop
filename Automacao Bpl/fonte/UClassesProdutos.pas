function TGrupos.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Gr: string;
  vDesc_Gr: string;
  I: Integer;
begin
  try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Gr     := trim(dataSet.FieldByName('CODIGO_GRUP').AsString);
      vDesc_Gr    := trim(dataSet.FieldByName('DESCRICAO').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Gr     := '';
        vDesc_Gr    := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Gr) <> '') then
        prepare_loop('CODIGO_GRUP = ' + vCod_Gr)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'GRUPO' + #13 +
          'Código: ' + vCod_Gr + #13 +
          'Descrição: ' + vDesc_Gr;

        if (trim(vCod_Gr) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO044', 'EXCLUIR', '', 'GRUPOS',
          vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'GRUPO' + #13 +
          'Código: ' + vCod_Gr + #13 +
          'Descrição: ' + vDesc_Gr;

        if (trim(vCod_Gr) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO045', 'EXCLUIR', '', 'GRUPOS',
           vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo grupo(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo grupo(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo grupo(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo grupo(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
//        	if dataset.FieldByName('CODIGO_GRUP').AsInteger <= 0 then
//          begin
//            Application.MessageBox(PChar('Grupo ' +
//              IntToStr(dataset.FieldByName('CODIGO_GRUP').AsInteger) + ' - ' +
//              trim(dataset.FieldByName('DESCRICAO').AsString) +
//              ' não pode ser apagada'), 'Atenção', MB_ICONERROR + MB_OK);
//            Exit;
//          end;

        	if dataset.FieldByName('CODIGO_GRUP').AsInteger > 0 then
          begin
            buscas.Close;
            buscas.SQL.Text := ' select count(*) as qtde from produtos ' +
              ' where grupo_prod = :grupo_prod ';
            buscas.ParamByName('grupo_prod').AsInteger := fint('codigo_grup');
            buscas.Open;

            if buscas.FieldByName('qtde').AsInteger > 0 then
            begin
              Application.MessageBox('Não é possível excluir grupo, pois existem produtos vinculados.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              exit;
            end;
          end;

          if fint('codigo_grup') = 0 then
          begin
          	SqlExec(' update grupos set ativo = 99 ' +
            ' where codigo_grup = %d ',
            [fint('codigo_grup')], buscas);
          end
          else
          begin
        		SqlExec(' delete from grupos ' +
              ' where codigo_grup = %d ',
              [fint('codigo_grup')], buscas);
          end;

          if (trim(vCod_Gr) = '') then
            vDadosIni.GravaAuditoria('PRO044', 'EXCLUIR', '', 'GRUPOS',
              dataSet.FieldByName('CODIGO_GRUP').AsString, buscas);
        end
        else
        begin
          SqlExec(' update grupos set ativo = 0 ' +
            ' where codigo_grup = %d ',
            [fint('codigo_grup')], buscas);

          if (trim(vCod_Gr) = '') then
            vDadosIni.GravaAuditoria('PRO045', 'EXCLUIR', '', 'GRUPOS',
              dataSet.FieldByName('CODIGO_GRUP').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

		Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO044', 'PRO045'),
        'EXCLUIR', 'SUCESSO', 'GRUPOS',
        vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO044', 'PRO045'),
        'EXCLUIR', 'FALHA', 'GRUPOS',
        vDadosIni.IfThen(trim(vCod_Gr) <> '', vCod_Gr, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

