  vitbal := vitbal + 1;
  vDadosIni.abreStatusProcessamento('', 'Item: ' + IntToStr(vitbal));
  if EstoqueAtual > 0 then
  begin
    FrmFichaInv.Qrlabel7.caption := floattostr(EstoqueAtual);
    printband := true
  end
  else
    printband := false;
end;

