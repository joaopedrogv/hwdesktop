function TPromocaoProd.alterarValorPromocao(ValorPromocao: currency; NumBanca: integer): boolean;
begin
  result := false;
  if ValorPromocao <= 0 then
  begin
    Application.MessageBox('Valor do Produto para preço promocional deve ser maior que zero',
      'Aviso', MB_ICONINFORMATION + MB_OK);
    exit;
  end;
  if not IsEmpty then
  begin
    try
      buscas.Close;
      buscas.SQL.Text := 'update produtos p set p.rep_int_active = 1, ' +
        ' p.preco_promocao = :valor ' +
        ' where p.cod_empresa=' + vDadosIni.codEmpresa + ' and p.ativo=1 ' +
        ' and p.EM_PROMOCAO=''S'' and p.num_banca =' + inttostr(NumBanca);
      buscas.ParamByName('valor').AsCurrency := ValorPromocao;
      buscas.Prepare;
      buscas.ExecSQL;
      if CommitaTransacao then
        Refresh;
      buscas.close;
      result := true;
    except
      on E: Exception do
      begin
        result := false;
        RollBackTransacao;
        result := false;
        Application.MessageBox(Pchar('Erro ao alterar preço de promoção dos produtos da banca' +
          inttostr(dataSet.FieldByName('NUM_BANCA').AsInteger)), 'Aviso', MB_ICONINFORMATION +
          MB_OK);
        registraErro('E0006 ' + e.Message + ' ' + buscas.SQL.Text);
      end;
    end;
  end;
end;

function TPromocaoProd.ativarPromocao(NumFabricacao: string; ValorPromocao: currency; NumBanca:
