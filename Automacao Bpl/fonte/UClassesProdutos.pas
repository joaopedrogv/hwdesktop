  transacao := TIBTransaction(dtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(dtmProdutos.qrBuscas);
end;

{ TProdutosEC }

function TProdutosEC.abreProdutosEC(pDateSet: TDataSet): boolean;
begin
  Result := montaSelect(' select * from produtos_ec ' +
  	' where grupo_prod = ' + IntToStr(pDateSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(pDateSet.FieldByName('cod_prod').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);

  TFloatField(dataSet.FieldByName('ESTOQUE_EC')).DisplayFormat := '##0.000';
  TFloatField(dataSet.FieldByName('ESTOQUE_MIN_EC')).DisplayFormat := '##0.000';
end;

constructor TProdutosEC.create;
begin
  DataSet := TClientDataSet(dtmProdutos.cdsProdutosEC);
  transacao := TIBTransaction(dtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(dtmProdutos.qrBuscas);

  vProdutosECgrade := TProdutosECgrade.create;
end;

destructor TProdutosEC.destroy;
begin
  vProdutosECgrade.Free;
  vProdutosECgrade := nil;
  inherited;
end;

function TProdutosEC.edit(pDataSet: TDataSet): boolean;
begin
  Result := inherited edit;

  if trim(dataSet.FieldByName('DESCR_PROD_RES').AsString) = '' then
    	dataSet.FieldByName('DESCR_PROD_RES').AsString :=
      	vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(pDataSet.FieldByName('DESCR_PROD').AsString));

	if dataSet.FieldByName('PRECO_A_COMBINAR_EC').IsNull then
  	dataSet.FieldByName('PRECO_A_COMBINAR_EC').AsString := 'N';
  if dataSet.FieldByName('PRECO_A_COMBINAR_CA').IsNull then
	  dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString := 'N';
  if dataSet.FieldByName('ESTOQUE_EC').IsNull then
    dataSet.FieldByName('ESTOQUE_EC').AsFloat := 0;
  if dataSet.FieldByName('ESTOQUE_MIN_EC').IsNull then
    dataSet.FieldByName('ESTOQUE_MIN_EC').AsFloat := 0;
end;

function TProdutosEC.existeGrade(pDataset: TDataSet): boolean;
begin
  Result := false;
  SqlOpen(' select first 1 grupo_prod, cod_prod, cod_empresa, qtde from cod_grade_prod ' +
		' where grupo_prod = ' + IntToStr(pDataset.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(pDataset.FieldByName('cod_prod').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);
  Result := not buscas.IsEmpty;
end;

function TProdutosEC.insert(pDataSet: TDataSet): boolean;
begin
  Result := inherited Insert;
  if Result then
  begin
    dataSet.FieldByName('GRUPO_PROD').AsInteger := pDataSet.FieldByName('GRUPO_PROD').AsInteger;
    dataSet.FieldByName('COD_PROD').AsString := pDataSet.FieldByName('COD_PROD').AsString;
    dataSet.FieldByName('COD_EMPRESA').AsInteger := pDataSet.FieldByName('COD_EMPRESA').AsInteger;

    if trim(dataSet.FieldByName('DESCR_PROD_RES').AsString) = '' then
    	dataSet.FieldByName('DESCR_PROD_RES').AsString :=
      	vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(pDataSet.FieldByName('DESCR_PROD').AsString));

    dataSet.FieldByName('SINC_ECOMMERCE').AsString := 'N';
    dataSet.FieldByName('DISPONIVEL').AsString := 'N';
    dataSet.FieldByName('PRECO_A_COMBINAR_EC').AsString := 'N';
    dataSet.FieldByName('PROMOCIONAL').AsString := 'N';
    dataSet.FieldByName('FRETE_GRATIS').AsString := 'N';
    dataSet.FieldByName('LANCAMENTO').AsString := 'N';
    dataSet.FieldByName('DESTAQUE').AsString := 'N';
    dataSet.FieldByName('VARIACAO').AsString := 'N';
    dataSet.FieldByName('TERMOS_ACEITE').AsString := 'N';
    dataSet.FieldByName('COMPREJUNTO').AsString := 'N';
    dataSet.FieldByName('VIRTUAL').AsString := 'N';
    dataSet.FieldByName('ESTOQUE_EC').AsFloat := 0;
    dataSet.FieldByName('ESTOQUE_MIN_EC').AsFloat := 0;
    dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString := 'N';
    dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString := 'N';
  end;
end;

function TProdutosEC.post(pTipo: string; pCommitar: boolean = False): boolean;
var
  acao: string;
  codigo: integer;
  vtemp: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if ((pTipo = 'E') and (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S'))
    	or ((pTipo = 'C') and (dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S')) then
    begin
      if trim(dataSet.FieldByName('DESCR_PROD_RES').AsString) = '' then
      begin
      	if (pTipo = 'E') then
	        FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC1
        else if (pTipo = 'C') then
        	FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;
        FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
        raiseExceptionCreate('Descrição do produto não informada!',
        	vDadosIni.IfThen(pTipo = 'E', 'DBEditDescrEC', 'DBEditDescrCA'));
      end;

      if pTipo = 'E' then
      	if (trim(vDadosIni.vEcommerce.vEcommerceIntegrado) = 'TRAY') then
          if dataSet.FieldByName('COD_CATEGORIA').AsInteger <= 0 then
          begin
              if (pTipo = 'E') then
                FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC1
              else if (pTipo = 'C') then
                FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;
              FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
              raiseExceptionCreate('Categoria principal não informada!', 'DBLookupComboBoxCategoria');
          end;

      if pTipo = 'E' then
      	if trim(vDadosIni.vEcommerce.vEcommerceIntegrado) = 'TRAY' then
        begin
          if trim(dataSet.FieldByName('URL_ACESSO').AsString) = '' then
          begin
            FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC3;
            FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
            raiseExceptionCreate('Url de Acesso não informado!', 'DBEditURLAcesso');
          end;

          if trim(dataSet.FieldByName('URL_ACESSO').AsString) <> '' then
          begin
            buscas.Close;
            buscas.SQL.Text := ' SELECT PRODUTOS_EC.GRUPO_PROD, PRODUTOS_EC.COD_PROD, 0 CODIGO_KIT, PRODUTOS_EC.COD_EMPRESA, ' +
            	' PRODUTOS.NUM_FAB_PROD, PRODUTOS.DESCR_PROD FROM PRODUTOS_EC ' +
            	' INNER JOIN PRODUTOS ON PRODUTOS.GRUPO_PROD = PRODUTOS_EC.GRUPO_PROD ' +
              ' 	AND PRODUTOS.COD_PROD = PRODUTOS_EC.COD_PROD ' +
            	' 	AND PRODUTOS.COD_EMPRESA = PRODUTOS_EC.COD_EMPRESA ' +
              ' WHERE NOT((PRODUTOS_EC.GRUPO_PROD = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
              ' AND PRODUTOS_EC.COD_PROD = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) + ')) ' +
              ' AND PRODUTOS_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
              ' AND UPPER(PRODUTOS_EC.URL_ACESSO) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('URL_ACESSO').AsString))) +
              ' UNION ' +
              ' SELECT 0 GRUPO_PROD, '''' COD_PROD, KITS_PROD_EC.CODIGO_KIT, KITS_PROD_EC.COD_EMPRESA, ' +
              ' '''' NUM_FAB_PROD, KITS_PROD.DESCRICAO_KIT FROM KITS_PROD_EC ' +
              ' INNER JOIN KITS_PROD ON KITS_PROD.CODIGO_KIT = KITS_PROD_EC.CODIGO_KIT ' +
              '   AND KITS_PROD.COD_EMPRESA = KITS_PROD_EC.COD_EMPRESA ' +
              ' WHERE KITS_PROD_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
              ' AND UPPER(KITS_PROD_EC.URL_ACESSO) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('URL_ACESSO').AsString)));
            buscas.Open;

            if not buscas.IsEmpty then
            begin
            	vtemp := 'Url de Acesso não pode repetir, já existe outro produto/kit com a mesma url: ' + #13 + #13 +
              	vDadosIni.IfThen(buscas.FieldByName('GRUPO_PROD').AsInteger > 0,
	              	'PRODUTO' + #13 +
  	              'Grupo Prod: ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) + #13 +
    	            'Cod Prod: ' + trim(buscas.FieldByName('COD_PROD').AsString) + #13 +
      	          'Num Fab: ' + trim(buscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
        	        'Descr Prod: ' + trim(buscas.FieldByName('DESCR_PROD').AsString) + #13 + #13,
                  'KIT PRODUTO: ' + #13 +
                  'Cod Kit: ' + IntToStr(buscas.FieldByName('CODIGO_KIT').AsInteger) + #13 +
                  'Descr Kit: ' + trim(buscas.FieldByName('DESCR_PROD').AsString) + #13 + #13) +
              	'Favor verificar antes de continuar!';
            	if (pTipo = 'E') then
                FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC3
              else if (pTipo = 'C') then
                FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;
              FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
              raiseExceptionCreate(vtemp, 'DBEditURLAcesso');
            end;
          end;
        end;
      end;


    if (pTipo = 'E') then
      if (dataSet.FieldByName('ID_COMMERCE').AsInteger > 0)
        and (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'N') then
      begin
          FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC1;
          FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);

          if Application.MessageBox('Produto foi sincronizado com E-Commerce: ' + #13 + #13 +
            'Caso queria continuar o produto será removido do E-Commerce, ' + chr(13) +
		        'deseja continuar assim mesmo?', 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
          begin
          	if (pTipo = 'E') then
              FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC1
            else if (pTipo = 'C') then
              FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;
            FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
            raiseExceptionCreate('Produto foi sincronizado com E-Commerce, favor informar Sim na opção Sincronizar!', 'DBComboBoxSincEC');
			      Exit;
          end;

          if not vDadosIni.PesqPros('PRO381', 'PERMITIR', '', 'PRODUTOS_EC',
        	  dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
        	  dataSet.FieldByName('COD_PROD').AsString, buscas, true) then
          begin
          	if (pTipo = 'E') then
              FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC1
            else if (pTipo = 'C') then
              FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;
            FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);
         	  raiseExceptionCreate('Produto foi sincronizado com E-Commerce, favor informar Sim na opção Sincronizar!', 'DBComboBoxSincEC');
			      Exit;
          end;
      end;

    dataSet.FieldByName('VARIACAO').AsString := vDadosIni.IfThen(existeGrade(dataSet), 'S', 'N');

    if not testarGrade(pTipo) then
     exit;

    if SqlOpen('select env_comercio_aberto from vw_produtos_ec ec' +
               ' where ec.env_comercio_aberto = ''N'' and ec.api = ''COMERCIOABERTO''' +
               ' and ec.grupo_prod = %d and ec.cod_prod = %s and ec.cod_empresa = %d',
               [fint('grupo_prod'), fstrq('cod_prod'), vDadosIni.cod_empresa]
               ).FieldByName('env_comercio_aberto').AsString = 'N' then
      if fequals('env_comercio_aberto', 'S') then
        if SqlOpen('select count(ec.grupo_prod) contador from vw_produtos_ec ec' +
                   ' where ec.env_comercio_aberto = ''S'' and ec.api = ''COMERCIOABERTO''' +
                   ' and ec.cod_empresa = %d', [vDadosIni.cod_empresa]).FieldByName('contador').AsInteger + 1 > LIMITE_COMERCIOABERTO then
          raiseExceptionCreate(LIMITE_COMERCIOABERTO_MENSAGEM); 
     
    Result := inherited post;
    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if pCommitar then
    	if Result then
      	Result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO312', 'PRO377'),
      	'SALVAR', 'SUCESSO', 'PRODUTOS_EC',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
     	  dataSet.FieldByName('COD_PROD').AsString, buscas)
    else
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO312', 'PRO377'),
      	'SALVAR', 'FALHA', 'PRODUTOS_EC',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
     	  dataSet.FieldByName('COD_PROD').AsString, buscas);
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO312', 'PRO377'),
      	'SALVAR', 'FALHA', 'PRODUTOS_EC',
        dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
     	  dataSet.FieldByName('COD_PROD').AsString, buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosEC.testarEst(pTipo: string): boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';


    if dataSet.FieldByName('ESTOQUE_MIN_EC').IsNull then
    	dataSet.FieldByName('ESTOQUE_MIN_EC').AsFloat := 0;

    if dataSet.FieldByName('ESTOQUE_EC').IsNull then
    	dataSet.FieldByName('ESTOQUE_EC').AsFloat := 0;

    Result := true;

    vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO314', 'PRO378'),
     'ALTERAR',
     'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
     ' Codigo: ' + dataSet.FieldByName('COD_PROD').AsString +
     ' Old Est Min: ' + FloatToStr(vOldEst) +
     ' Old Est: ' + FloatToStr(vOldEstMin) +
     ' New Est Min: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_MIN_EC').AsFloat) +
     ' New Est: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_EC').AsFloat) +
     ' - SUCESSO', 'PRODUTOS_EC', '', buscas);
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pTipo = 'E', 'PRO314', 'PRO378'),
       'ALTERAR',
       'Grupo: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
       ' Codigo: ' + dataSet.FieldByName('COD_PROD').AsString +
       ' Old Est Min: ' + FloatToStr(vOldEst) +
       ' Old Est: ' + FloatToStr(vOldEstMin) +
       ' New Est Min: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_MIN_EC').AsFloat) +
       ' New Est: ' + FloatToStr(dataSet.FieldByName('ESTOQUE_EC').AsFloat) +
       ' - FALHA', 'PRODUTOS_EC', '', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosEC.testarGrade(pTipo: string): boolean;
begin
  try
    Result := false;

    SqlOpen(' select first 1 grupo_prod, cod_prod, cod_empresa from cod_grade_prod ' +
      ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa);
    if buscas.IsEmpty then
    begin
      Result := true;
      exit;
    end;

    if vProdutosECgrade.IsEmpty then
    begin
    	if pTipo = 'E' then
	      FrmCadProdutos.PageControlEC.ActivePage := FrmCadProdutos.TabSheetEC3
      else if pTipo = 'C' then
      	FrmCadProdutos.PageControlCA.ActivePage := FrmCadProdutos.TabSheetCA1;

      FrmCadProdutos.verificarAbaEcommerceComercioAberto(pTipo);

      if pTipo = 'E' then
      Application.MessageBox('Produto possui grade,' +
      	' favor selecionar as grades/variações que serão enviadas ao E-Commerce.',
	  	    'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1)
      else if pTipo = 'C' then
      	Application.MessageBox('Produto possui grade,' +
  	    	' favor selecionar as grades que serão enviadas ao Comércio Aberto.',
	      'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      Result := false;
      exit;
    end;

    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosEC.verificarTipoGradesEC(pVerificar: Boolean = True): boolean;
var
  vtemp: string;
  vStringListTipoGrade: TStringList;
  I: Integer;
begin
  Result := True;

  if not vDadosIni.vEcommerce.vHabilitarEcommerce then
    Exit;

  if dataSet.FieldByName('sinc_ecommerce').AsString <> 'S' then
    Exit;

  if vProdutosECgrade.dataSet.IsEmpty then
    Exit;

  try
    vStringListTipoGrade := TStringList.Create;
    vStringListTipoGrade.Sorted := True;
    vStringListTipoGrade.Duplicates := dupIgnore;
    vStringListTipoGrade.Clear;

    vProdutosECgrade.storeRecNo;
    vProdutosECgrade.dataSet.First;
    while not vProdutosECgrade.dataSet.Eof do
    begin
      SqlOpen(' select coalesce(tipo_ec, '''') tipo_ec, coalesce(tipo_ec1, '''') tipo_ec1 from grade ' +
        ' where cod_grade = ' + IntToStr(vProdutosECgrade.dataSet.FieldByName('cod_grade').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);

      vStringListTipoGrade.Add(trim(buscas.FieldByName('tipo_ec').AsString) + '|' + trim(buscas.FieldByName('tipo_ec1').AsString) + '|');

      vProdutosECgrade.dataSet.Next;
    end;

    if (vStringListTipoGrade.Count > 1) then
    begin
      vtemp := 'Empresa utiliza o E-Commerce: '+ #13 + #13 +
        'Este produto está vinculado mais de uma tipo de Grade/Variação (E-Commerce). ' + #13 + #13 +
        'TIPOS:' + #13;

      for I := 0 to vStringListTipoGrade.Count - 1 do
        vtemp := vtemp +
          trim(vDadosIni.getCampoPipe(vStringListTipoGrade[I], 1)) +
          vDadosIni.IfThen(trim(vDadosIni.getCampoPipe(vStringListTipoGrade[I], 2)) <> '', '|' + trim(vDadosIni.getCampoPipe(vStringListTipoGrade[I], 2)), '') + #13;

      vtemp := vtemp + #13 +
        'Não é possível utilizar tipos de Grade/Variação diferentes para o mesmo produto.';

      vtemp := vtemp +
        vDadosIni.IfThen(pVerificar, #13 + #13 + 'Favor verificar antes de continuar!', '');

      if not pVerificar then
        Application.MessageBox(PChar(vtemp), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1)
      else
        Application.MessageBox(PChar(vtemp), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      Result := False;
      exit;
    end;

  finally
    vProdutosECgrade.restoreRecNo;

    if Assigned(vStringListTipoGrade) then
      FreeAndNil(vStringListTipoGrade);
  end;
end;

{ TProdutosECgrade }

function TProdutosECgrade.abreConsGrade(pDateSet: TDataSet; pBuscas: TIBQuery): boolean;
begin
  SqlOpen(' select grade.cod_grade, grade.cod_empresa, ' +
   ' coalesce(grade.descricao, '''') descricaoGrade, ' +
   ' coalesce(grade.descricao_ec, grade.descricao) descricao, ' +
   ' coalesce(grade.tipo_ec, '''') tipo_ec, ' +
   ' coalesce(grade.descricao_ec1, '''') descricao1, ' +
   ' coalesce(grade.tipo_ec1, '''') tipo_ec1, ' +
   ' coalesce(produtos_ec_grade.sinc_ecommerce, ''N'') sinc_ecommerce, ' +
   ' coalesce(produtos_ec_grade.env_comercio_aberto, ''N'') env_comercio_aberto ' +
   ' from cod_grade_prod ' +
   ' inner join grade on grade.cod_grade = cod_grade_prod.cod_grade ' +
   ' 		and grade.cod_empresa = cod_grade_prod.cod_empresa and grade.ativo = 1 ' +
   ' left join produtos_ec_grade on produtos_ec_grade.grupo_prod = cod_grade_prod.grupo_prod ' +
   '    and produtos_ec_grade.cod_prod = cod_grade_prod.cod_prod ' +
   '    and produtos_ec_grade.cod_grade = cod_grade_prod.cod_grade ' +
   '    and produtos_ec_grade.cod_empresa = cod_grade_prod.cod_empresa ' +
   ' where cod_grade_prod.grupo_prod = ' + IntToStr(pDateSet.FieldByName('grupo_prod').AsInteger) +
   ' and cod_grade_prod.cod_prod = ' + QuotedStr(pDateSet.FieldByName('cod_prod').AsString) +
   ' and cod_grade_prod.cod_empresa = ' + vDadosIni.codEmpresa +
   ' and cod_grade_prod.cod_grade > 0 ' +
   ' order by cod_grade_prod.cod_grade ', pBuscas).FetchAll;
  Result := not pBuscas.IsEmpty; 
end;

function TProdutosECgrade.abreProdutosECgrade(pDateSet: TDataSet; pCodGrade: Integer = 0): boolean;
begin
  Result := montaSelect(' select produtos_ec_grade.* from produtos_ec_grade ' +
  	' where produtos_ec_grade.grupo_prod = ' +  IntToStr(pDateSet.FieldByName('grupo_prod').AsInteger) +
    ' and produtos_ec_grade.cod_prod = ' + QuotedStr(pDateSet.FieldByName('cod_prod').AsString) +
    vDadosIni.IfThen(pCodGrade > 0, ' and produtos_ec_grade.cod_grade = ' + IntToStr(pCodGrade), '') +
    ' and produtos_ec_grade.cod_empresa = ' + vDadosIni.codEmpresa);

  TFloatField(dataSet.FieldByName('ESTOQUE_EC')).DisplayFormat := '##0.000';
  TFloatField(dataSet.FieldByName('ESTOQUE_MIN_EC')).DisplayFormat := '##0.000';
  
  dataSet.First;
  while not dataSet.Eof do
  begin
    dataSet.Edit;
    dataSet.FieldByName('descricao').AsString :=
    	retornaValor(' select descricao as valor from grade ' +
        ' where cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
      	' and cod_empresa = ' + vDadosIni.codEmpresa);
    dataSet.Post;

    dataSet.Next;
  end;
  dataSet.First;
end;

function TProdutosECgrade.addItemTreeView(pTipo: string; Produto: TProdutos; pTreeView,
  pTreeView2: TTreeView; pGrade: string): boolean;
var
  I: Integer;
  vcodgrade, contador: Integer;
  vtipoEC, vtipoEC1: string;
  vdescricaoEc, vdescricaoEc1: string;
  ANode: TtreeNode;
  vtemptipoec, vtemptipoec1: string;
begin
  try
    Result := true;
    vcodgrade := 0;

    if pTreeView.Items.Count <= 0 then
      exit;

    for I := 0 to pTreeView2.Items.Count - 1 do
      if trim(pTreeView2.Items[I].Text) = trim(pGrade) then
      begin
        Application.MessageBox(PChar('Grade "' + trim(pGrade) + '" já adicionada!'), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

    try
      vcodgrade := StrToInt(trim(Copy(pGrade, 1, Pos('-', pGrade) - 1)));
    except
      Application.MessageBox(PChar('Falha ao selecionar grade: ' + trim(pGrade)), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      Exit;
    end;

    SqlOpen(' select grade.cod_grade, ' +
    	' coalesce(grade.tipo_ec, '''') tipo_ec, grade.descricao_ec, ' +
      ' coalesce(grade.tipo_ec1, '''') tipo_ec1, grade.descricao_ec1 from grade ' +
      ' where grade.cod_grade = ' + IntToStr(vcodgrade) +
      ' and grade.cod_empresa = ' + vDadosIni.codEmpresa);
    vcodgrade := buscas.FieldByName('cod_grade').AsInteger;
    vtipoEC := trim(buscas.FieldByName('tipo_ec').AsString);
    vdescricaoEc := trim(buscas.FieldByName('descricao_ec').AsString);
    vtipoEC1 := trim(buscas.FieldByName('tipo_ec1').AsString);
    vdescricaoEc1 := trim(buscas.FieldByName('descricao_ec1').AsString);

    if vcodgrade <= 0 then
      exit;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
      if (trim(vtipoEC) = '') or (trim(vdescricaoEc) = '') then //or (trim(vtipoEC1) = '') or (trim(vdescricaoEc1) = '') then
      begin
        Application.MessageBox(PChar('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	 'Algumas informações da Grade "' + pGrade + '" são necessárias!' + #13 +
          'Favor entrar no cadastro de Grades e informar os campos do E-Commerce'), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
        exit;
      end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
      if not dataSet.IsEmpty then
      begin
        try
          dataSet.First;
          while not dataSet.Eof do
          begin
          	if ((pTipo = 'E') and (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S'))
            	or ((pTipo = 'C') and (dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString = 'S')) then
            begin
              SqlOpen(' select coalesce(tipo_ec, '''') tipo_ec, coalesce(tipo_ec1, '''') tipo_ec1 from grade ' +
                ' where cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
                ' and cod_empresa = ' + vDadosIni.codEmpresa);

              vtemptipoec := trim(buscas.FieldByName('tipo_ec').AsString);
              vtemptipoec1 := trim(buscas.FieldByName('tipo_ec1').AsString);

              if (UpperCase(trim(vtemptipoec)) <> UpperCase(trim(vtipoEC))) or (UpperCase(trim(vtemptipoec1)) <> UpperCase(trim(vtipoEC1))) then
              begin
                Application.MessageBox(PChar('Empresa utiliza o E-Commerce: '+ #13 + #13 +
                  'Este produto está vinculado a uma Grade/Variação do tipo ' + QuotedStr(vtemptipoec + IfThen(trim(vtemptipoec1) = '', '', ' | ' + vtemptipoec1)) + '.' + #13 +
                  'A Grade/Variação selecionada é do tipo ' + QuotedStr(vtipoEC + IfThen(trim(vtipoEC1) = '', '', ' | ' + vtipoEC1)) + '.' + #13 +
                  'Não é possível utilizar tipos de Grade/Variação diferentes para o mesmo produto.' + #13 + #13 +
                  'Favor verificar antes de continuar!'), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
                exit;
              end;
            end;

            dataSet.Next;
          end;
        finally
          dataSet.First;
        end;
      end;

    try
      if pTipo = 'C' then
      begin

        contador := filterStr('env_comercio_aberto = ''S''').dataSet.RecordCount + 1;
        filterClear;

        with SqlOpen('select sum(iif(ec.grupo_prod = %d and ec.cod_prod = %s, 1, 0 )) menos,' +
                     ' count(ec.grupo_prod) contador from vw_produtos_ec ec' +
                     ' where ec.env_comercio_aberto = ''S'' and ec.api = ''COMERCIOABERTO''' +
                     ' and ec.cod_empresa = %d',
                     [fint('grupo_prod'), fstrq('cod_prod'), vDadosIni.cod_empresa]) do
          if (FieldByName('contador').AsInteger - FieldByName('menos').AsInteger) + contador > LIMITE_COMERCIOABERTO then
                     raiseExceptionCreate(LIMITE_COMERCIOABERTO_MENSAGEM);
      end;

      dataSet.Filtered := false;
      dataSet.Filter := 'grupo_prod = ' + IntToStr(Produto.dataSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(Produto.dataSet.FieldByName('cod_prod').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_grade = ' + IntToStr(vcodgrade);
      dataSet.Filtered := true;

      if dataSet.IsEmpty then
      begin
        dataSet.Insert;
        dataSet.FieldByName('GRUPO_PROD').AsInteger := Produto.dataSet.FieldByName('GRUPO_PROD').AsInteger;
        dataSet.FieldByName('COD_PROD').AsString := Produto.dataSet.FieldByName('COD_PROD').AsString;
        dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        dataSet.FieldByName('COD_GRADE').AsInteger := vcodgrade;
        dataSet.FieldByName('ESTOQUE_EC').AsFloat := 0;
      end
      else
      	dataSet.Edit;

      if pTipo = 'E' then
        dataSet.FieldByName('SINC_ECOMMERCE').AsString := 'S'
      else if pTipo = 'C' then
        dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString := 'S';
      dataSet.Post;
      Apply;

      ANode := pTreeView2.Items.AddChild(nil, trim(pGrade));
    finally
      dataSet.Filtered := false;
      abreProdutosECgrade(Produto.dataSet);
      dataSet.First;
    end;

    for I := 0 to pTreeView.Items.Count - 1 do
      pTreeView.Items[I].Selected := True;

    for I := 0 to pTreeView.Items.Count - 1 do
      if trim(pTreeView.Items[I].Text) = trim(pGrade) then
      begin
        pTreeView.Items[I].Selected := True;
        break;
      end;
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar(e.Message), 'Erro', MB_OK + MB_ICONASTERISK);
      registraErro(e.Message);
    end;
  end;
end;

