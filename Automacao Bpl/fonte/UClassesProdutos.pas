procedure TConsProdutosConversao.dataSetCalcFields(DataSet: TDataSet);
var
	buscas2: TIBQuery;
begin
	try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if (trim(DataSet.FieldByName('OPERACAO').AsString) = 'Multiplicacao') then
    begin
      if not SqlOpen(' select grupo_prod, cod_prod, cod_empresa, unidade from produtos ' +
        ' where grupo_prod = ' + IntToStr(DataSet.FieldByName('GRUPO_PROD').AsInteger) +
        ' and cod_prod = ' + QuotedStr(DataSet.FieldByName('COD_PROD').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).IsEmpty then
      begin
          DataSet.FieldByName('FATOR_CONV_TEMP').AsString :=
            FloatToStr(RoundTo(1, -4)) + ' ' +
            UpperCase(trim(buscas2.FieldByName('UNIDADE').AsString)) + ' = ' +
            FloatToStr(RoundTo(DataSet.FieldByName('QUANTIDADE').AsFloat, -4)) +
            ' ' + UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString));
      end
      else
          DataSet.FieldByName('FATOR_CONV_TEMP').AsString := '';
    end
    else if (trim(DataSet.FieldByName('OPERACAO').AsString) = 'Divisao') then
    begin
      if not SqlOpen(' select grupo_prod, cod_prod, cod_empresa, unidade from produtos ' +
        ' where grupo_prod = ' + IntToStr(DataSet.FieldByName('GRUPO_PROD').AsInteger) +
        ' and cod_prod = ' + QuotedStr(DataSet.FieldByName('COD_PROD').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).IsEmpty then
      begin
          DataSet.FieldByName('FATOR_CONV_TEMP').AsString :=
            FloatToStr(RoundTo(1, -4)) + ' ' +
            UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) + ' = ' +
            FloatToStr(RoundTo(DataSet.FieldByName('QUANTIDADE').AsFloat, -4)) +
            ' ' + UpperCase(trim(buscas2.FieldByName('UNIDADE').AsString));
      end
      else
          DataSet.FieldByName('FATOR_CONV_TEMP').AsString := '';
    end
    else
      DataSet.FieldByName('FATOR_CONV_TEMP').AsString := '';
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

