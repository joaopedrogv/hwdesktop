function TGrupoProdSimilares.RestaurarRegistro: boolean;
var
	vGrupoSim: string;
	vDescSim: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vGrupoSim := trim(dataSet.FieldByName('COD_GRUPO_SIM').AsString);
      vDescSim  := trim(dataSet.FieldByName('DESCR_GRUPO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vGrupoSim := '';
        vDescSim := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vGrupoSim) <> '') then
      	prepare_loop('COD_GRUPO_SIM = ' + vGrupoSim)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'GRUPO SIMILAR' + #13 +
        'Código: ' + vGrupoSim + #13 +
        'Descrição: ' + vDescSim;

      if (trim(vDescSim) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO351', 'RESTAURAR', '', 'PROD_SIMILARES_GRUPOS',
        vDadosIni.IfThen(trim(vGrupoSim) <> '', vGrupoSim, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando grupo(s) de similar');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando grupo(s) de similar (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update prod_similares_grupos set ativo = 1 ' +
          ' where cod_grupo_sim = %d ' +
          ' and cod_empresa = %d ',
          [fint('cod_grupo_sim'), fint('cod_empresa')], buscas);

        if (trim(vGrupoSim) = '') then
          vDadosIni.GravaAuditoria('PRO351', 'RESTAURAR', '', 'PROD_SIMILARES_GRUPOS',
            dataSet.FieldByName('COD_GRUPO_SIM').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO351', 'RESTAURAR', 'SUCESSO', 'PROD_SIMILARES_GRUPOS',
        vDadosIni.IfThen(trim(vGrupoSim) <> '', vGrupoSim, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO351', 'RESTAURAR', 'FALHA', 'PROD_SIMILARES_GRUPOS',
        vDadosIni.IfThen(trim(vGrupoSim) <> '', vGrupoSim, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

