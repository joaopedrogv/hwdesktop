function TBalancoProduto.abrirUltimosRegBalanco: boolean;
begin
	FQuery.Close;
  FQuery.SQL.Text := 'select first 5 bl.cod_barra "Num. Fabricação", ' +
    ' bl.data_hora_leitura "Data e Hora",bl.qtde_prod "Qtd Contada", ' +
    ' bl.grupo_prod "Grupo",bl.cod_prod "Cod. Produto" ,' +
    ' bl.codusuario "Cod. Usuário", pr.descr_prod "Descrição Produto" ' +
    ' from balanco_produtos bl ' +
    ' inner join produtos pr on pr.grupo_prod = bl.grupo_prod and pr.cod_prod = bl.cod_prod and pr.cod_empresa = bl.cod_empresa ' +
    ' where bl.ativo=1 and bl.cod_empresa=' + vDadosIni.codEmpresa +
