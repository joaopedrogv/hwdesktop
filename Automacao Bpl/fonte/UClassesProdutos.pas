function TProdutos.validarDesmembramento: Boolean;
var
  vPercentual: Extended;
begin
  Result := True;
  if dataSet.State = dsInsert then
    Exit;

  if vProdutosDesmembramento.dataSet.IsEmpty then
    Exit;

  vPercentual := 0;
  vProdutosDesmembramento.dataSet.First;
  while not vProdutosDesmembramento.dataSet.Eof do
  begin
    vPercentual := vPercentual + vProdutosDesmembramento.dataSet.FieldByName('QUANT').AsFloat;
    vProdutosDesmembramento.dataSet.Next;
  end;

  if vDadosIni.StrToFloatFormat(vPercentual, 2) > 100 then
  begin
    Result := False;
    Application.MessageBox(PChar('O percentual do desmembramento deve ser igual ou inferior a 100%' + #13 +
      'O percentual atingido foi ' + Format('%0.2f', [vPercentual])), 'Atenção', 64);
  end
  else if vDadosIni.StrToFloatFormat(vPercentual, 2) < 100 then
  begin
    Application.MessageBox(PChar('O percentual do restante do desmembramento será considerado como perda' + #13 +
      'O percentual atingido foi ' + Format('%0.2f', [vPercentual]) + #13 +
      'O percentual de perda será ' + Format('%0.2f', [100 - vPercentual]) + #13 +
      'Total 100%'), 'Atenção', 64);

  end;
end;

function TProdutos.validarRegrasCFOP_CST: boolean;
var
  buscas2: TIBQuery;
begin
  buscas2 := TIBQuery(dtmProdutos.qrBuscasCB);
  Result := False;
//  if (vDadosIni.vEmp.vUsarRegraNCM = 'S')
//    (vDadosIni.vEmp.vUsarRegraCFOPCSTEntrada = 'S') or
//    (vDadosIni.vEmp.vUsarRegraCFOPCSTSaida = 'S')
//    then
  begin

    try
      if (vDadosIni.vEmp.vUsarRegraNCM = 'S') then
        if Trim(dataSet.FieldByName('nbm').AsString) <> '' then
        begin

        //Pesquisa na tabela de ncm se o o produto com este ncm tem ST
          buscas.Close;
          buscas.SQL.Text := 'select * from nbm where cod_ncm = ' +
            QuotedStr(dataSet.FieldByName('nbm').AsString);
          buscas.Open;

        /// Se exister MVA(ST) no NCM e o produto nao for cadastrado como ST o sistema não deixa o
        ///   usuário concluir o cadastro

          vDadosIni.vInibeMensPesqPros := 'S';
          if vDadosIni.PesqPros('PRO175', 'VALIDAR', '', 'PRODUTOS',
            dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
            dataSet.FieldByName('COD_PROD').AsString, buscas2, False) then
            if (dataSet.FieldByName('ICM_PROD').AsFloat > 0) and
              (buscas.FieldByName('mva').AsFloat > 0) then
              raiseExceptionCreate('NCM ' + dataSet.FieldByName('nbm').AsString +
                ' tem substituição tributária' + #13 +
                'Aliquota de ICMS não deve ser informada para produtos com este NCM', '');

          //Removido o teste pois o campo tambem foi removido
        end;

      if (vDadosIni.vEmp.vUsarRegraCFOPCSTSaida = 'S') then
      begin

        buscas.Close;
        buscas.SQL.Text := 'select * from CFOP_CST_ENTRADA where cfop = :cfop and cst = ' +
          QuotedStr(Copy(dataSet.FieldByName('cst_prod').AsString, 2, 2)) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ParamByName('cfop').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
        buscas.Open;

        if buscas.IsEmpty then
          raiseExceptionCreate('Combinação de CFOP com CST não encontrada' + #13 +
            'Por favor entre no cadastro de CFOP e verifique as combinações', '');

        vDadosIni.vInibeMensPesqPros := 'S';
        if vDadosIni.PesqPros('PRO177', 'VALIDAR', '', 'PRODUTOS',
          dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
          dataSet.FieldByName('COD_PROD').AsString, buscas2, False) then
        begin

          if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'S' then
          begin
            if dataSet.FieldByName('icm_prod').AsFloat <= 0 then
              raiseExceptionCreate('Aliquota de ICMS de preenchimento obrigatório conforme regras estabelecidas', '');
          end
          else if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'N' then
            if dataSet.FieldByName('icm_prod').AsFloat > 0 then
              raiseExceptionCreate('Aliquota de ICMS deve ser preenchida zerada conforme regras estabelecidas', '');

        end;

      end;
      {vDadosIni.vInibeMensPesqPros := 'S';
      if vDadosIni.PesqPros('PRO178', 'VALIDAR', '', 'PRODUTOS',
        dataSet.FieldByName('GRUPO_PROD').AsString +'-'+
        dataSet.FieldByName('COD_PROD').AsString , buscas2, False) then
      begin

      end;   }

    except
      on e: exception do
      begin
        Result := False;
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
        Exit;
      end;
    end;

  end;

  Result := True;
end;

