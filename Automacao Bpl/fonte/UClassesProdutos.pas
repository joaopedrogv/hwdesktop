    buscas.Close;
    buscas.SQL.Text := ' select first 1 nfi.quantidade, nfi.prec_cus_cnt from notafiscal nf ' +
      ' inner join notafiscal_item nfi on ' +
      '   nfi.cod_nf = nf.cod_nf ' +
      '   and nfi.cod_empresa = nfi.cod_empresa ' +
      ' where nf.num_nf = :num_nf ' +
      ' and nf.natureza_nf = :natureza_nf ' +
      ' and nf.cod_cliente = :cod_cliente ' +
      ' and nfi.grupo_prod = :grupo_prod ' +
      ' and nfi.cod_prod = :cod_prod ' +
      ' and nfi.cod_empresa = :cod_empresa ';
