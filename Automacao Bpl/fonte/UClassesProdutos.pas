procedure TPromocao._cadPromocao(pTipoForm: Integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Promoção / Tabela de Preços');
    if dtmProdutos = nil then
      dtmProdutos := TdtmProdutos.Create(dtmProdutos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('PRO222', 'CONSULTA', '', 'PROMOCAO', '',
      dtmProdutos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadPromocao = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadPromocao, frmCadPromocao);
    end;

    if (pTipoForm > 0) and (not frmCadPromocao.Visible) then
      frmCadPromocao.ShowModal
    else if (not frmCadPromocao.Visible) then
    	frmCadPromocao.Show
    else if frmCadPromocao.FormStyle = fsMDIChild then
      frmCadPromocao.Show
    else
      frmCadPromocao.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

