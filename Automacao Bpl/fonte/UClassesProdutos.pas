function TProdutos.abrirUltimasCompras: boolean;
begin
  vfichcomgrade := False;
  buscas.close;
  buscas.sql.text := ' select count(*) as total from cod_grade_prod ' +
  	' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.open;
  if buscas.FieldByName('total').AsInteger > 1 then
  begin
    vfichcomgrade := Application.MessageBox('Visualizar com grade?',
      'Confirmação', MB_YESNO +
      MB_ICONQUESTION) = ID_YES;
  end;
  ultCompras.Close;
  if not vfichcomgrade then
    ultCompras.SQL.Text :=
      ' select nf4.num_nf,fr.nome_cliente,nf4.data_lanc,cond.desc_cond_pag,' +
      ' it4.quantidade,it4.valor_unitario,it4.prec_cusm_prod,it4.aliq_icm,it4.valor_ipi,' +
      ' it4.vl_multp,it4.qtdemb,it4.prec_vnd_prod,it4.PRCTB_ITEM,it4.RATEIO_DESCONTO,it4.PMARGFIM,' +
      ' it4.PERC_FRETE,nf4.da,it4.mnf,it4.nitem,it4.codigo_nop,it4.PR_CUSC_PROD,it4.descricao_item ' +
      ' from notafiscal nf4 ' +
      ' inner join notafiscal_item it4 on ' +
      '		nf4.cod_nf = it4.cod_nf ' +
      '   and nf4.cod_empresa = it4.cod_empresa ' +
      ' inner join cond_pag cond on ' +
      ' 	nf4.cod_cond_pag = cond.cod_cond_pag ' +
      '	inner join clientes fr on ' +
      '		nf4.cod_cliente = fr.cod_cliente ' +
      '		and nf4.cod_empresa = fr.cod_empresa ' +
      ' where nf4.natureza_nf=''E'' ' +
      ' and it4.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and it4.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and (nf4.status = ''Fechada'') ' +
      ' and nf4.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and coalesce(it4.ALTERA_ESTOQUE_CFOP, ''S'') <> ''N''' +
      ' and nf4.ativo = 1 ' +
      ' order by 3 desc, 1 desc '
  else
    ultCompras.SQL.Text :=
      ' select nf4.num_nf,fr.nome_cliente,nf4.data_lanc,cond.desc_cond_pag,' +
      ' case when grcomp.QTDE is null then it4.quantidade else grcomp.qtde end as quantidade,it4.valor_unitario,it4.prec_cusm_prod,it4.aliq_icm,it4.valor_ipi,' +
      ' it4.vl_multp,it4.qtdemb,it4.prec_vnd_prod,it4.PRCTB_ITEM,it4.RATEIO_DESCONTO,it4.PMARGFIM,' +
      ' it4.PERC_FRETE,nf4.da,it4.mnf,it4.nitem,it4.codigo_nop,it4.PR_CUSC_PROD,it4.descricao_item||'' - ''||coalesce(gra.cod_grade,0)||''. ''||coalesce(trim(gra.descricao),'''') as descricao_item ' +
      ' from notafiscal nf4 ' +
      ' inner join notafiscal_item it4 on ' +
      '		nf4.cod_nf = it4.cod_nf ' +
      ' 	and nf4.cod_empresa = it4.cod_empresa ' +
      ' left join cod_grade_prod_compra grcomp on ' +
      ' 	it4.grupo_prod = grcomp.grupo_prod ' +
      '		and it4.cod_prod = grcomp.cod_prod ' +
      '		and it4.cod_empresa = grcomp.cod_empresa ' +
      '		and it4.cod_nf = grcomp.num_nota_nfe ' +
      '		and it4.nitem = grcomp.cod_forn_nfe ' +
      ' left join grade gra on ' +
      '		grcomp.cod_grade = gra.cod_grade ' +
      '		and grcomp.cod_empresa = gra.cod_empresa ' +
      ' inner join cond_pag cond on ' +
      '		nf4.cod_cond_pag = cond.cod_cond_pag ' +
      '	inner join clientes fr on ' +
      '		nf4.cod_cliente = fr.cod_cliente ' +
      '		and nf4.cod_empresa = fr.cod_empresa ' +
      '	where nf4.natureza_nf = ''E'' ' +
      '	and it4.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and it4.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and (nf4.status = ''Fechada'') ' +
      '	and nf4.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and coalesce(it4.ALTERA_ESTOQUE_CFOP, ''S'') <> ''N''' +
      ' and nf4.ativo = 1 '+
      ' order by 3 desc, 1 desc';

  {  'select infe.num_nota_nfe,fr.nome,nfe.data_lanc_nfe,cond.desc_cond_pag,' +
      ' infe.quant_item_nfe,infe.vlun_item_nfe,infe.prec_cus_cnt,infe.alicm_item_nfe,' +
      ' infe.ipi_item_nfe,infe.vl_multp,infe.qtdemb,infe.prec_cus_r,infe.prec_vnd_prod,' +
      ' infe.prctb_item_nfe,infe.vlr_desc,infe.pmargfim,infe.perc_frete_nfe,nfe.da,infe.mnf,' +
      ' nfe.CODIGO_NOP, infe.pr_cusc_prod from nf_entrada nfe inner join item_nf_entrada infe on' +
      ' infe.num_nota_nfe = nfe.num_nota_nfe and infe.cod_forn_nfe = nfe.cod_forn_nfe and' +
      ' infe.cod_empresa = nfe.cod_empresa inner join fornecedor fr on' +
      ' fr.codigo_f = nfe.cod_forn_nfe and fr.cod_empresa = nfe.cod_empresa' +
      ' inner join cond_pag cond on cond.cod_cond_pag = nfe.cod_cond_pag' +
      ' where infe.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and infe.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
      ' and nfe.cod_empresa = ' + vDadosIni.codEmpresa + ' order by nfe.data_lanc_nfe';}
  ultCompras.Open;
  result := not ultCompras.IsEmpty;
end;

