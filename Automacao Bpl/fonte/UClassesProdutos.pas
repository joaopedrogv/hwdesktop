procedure TProdutos.alterar_dados_ult_entrada;
var
  Aprod: TProdutos_class;
begin
  if dataSet.IsEmpty then
    Exit;

  Aprod := TProdutos_class.Create;
  try
    Aprod.SetValuesFrom(SqlOpen('select %s from produtos where grupo_prod = %d and cod_prod = %s and cod_empresa = %d',
                                [TProdutos_class.GetFieldsSql(), fint('grupo_prod'), fstr('cod_prod'), fint('cod_empresa')]));

    with Aprod do
      if not vDadosIni.PesqPros('PRO321', 'ALTERAR',
        Format('[ICM:%n][ST>B:%n|P:%n|V:%n][FCP>B:%n|P:%n|V:%n]',
               [ant_vicmssubstituto, baseicmant_sub, ant_pst,  icmant_sub, fcp_vbcfcpstret, fcp_pfcpstret, fcp_vfcpstret]),
        'PRODUTOS', fstr('GRUPO_PROD') + '-' + fstr('COD_PROD'), buscas) then
        Exit;

    Application.CreateForm(TfrmCadProdutos_nfe_dados_entrada, frmCadProdutos_nfe_dados_entrada);
    with frmCadProdutos_nfe_dados_entrada do
    begin
      produto := Aprod;
      if ShowModal = IDOK then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update produtos set baseicmant_sub = :baseicmant_sub,' +
                           ' ant_pst = :ant_pst, ant_vicmssubstituto = :ant_vicmssubstituto,' +
                           ' icmant_sub = :icmant_sub, fcp_vbcfcpstret = :fcp_vbcfcpstret,' +
                           ' fcp_pfcpstret = :fcp_pfcpstret, fcp_vfcpstret = :fcp_vfcpstret,' +
                           ' vicmsmonoret = :vicmsmonoret, adremicmsret = :adremicmsret' +
                           ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod and cod_empresa = :cod_empresa';
        Aprod.SetValuesInParams(buscas, True).ExecSQL;
        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;

        with Aprod do
          vDadosIni.GravaAuditoria('PRO321', 'ALTERAR', 'SUCESSO>' +
            Format('[ICM:%n][ST>B:%n|P:%n|V:%n][FCP>B:%n|P:%n|V:%n]',
               [ant_vicmssubstituto, baseicmant_sub, ant_pst,  icmant_sub, fcp_vbcfcpstret, fcp_pfcpstret, fcp_vfcpstret]),
                   'PRODUTOS', fstr('GRUPO_PROD') + '-' + fstr('COD_PROD'), buscas);
      end;
    end;

  finally
    FreeAndNil(Aprod);
  end;
end;

function TProdutos.ApagarInsumoOutroProd: boolean;
var
	vGrupoTmp, vCodTmp, vNumFabTmp, vDescrTmp: string;
  vtemp: string;
begin
  try
    Result := False;

    if dataSet.IsEmpty then
    	Exit;

    if vIndTec.dataSet.IsEmpty then
  		Exit;

    try
      vGrupoTmp  := vIndTec.dataSet.FieldByName('grupo_prod_mprima').AsString;
      vCodTmp    := vIndTec.dataSet.FieldByName('cod_prod_mprima').AsString;
      vNumFabTmp := vIndTec.dataSet.FieldByName('num_fab_mprima').AsString;
      vDescrTmp  := vIndTec.dataSet.FieldByName('descr_prod').AsString;

      vIndTec.prepare_loop('SEL = ''S''');
      if not vIndTec.dataset.IsEmpty then
      begin
        vGrupoTmp  := '';
        vCodTmp    := '';
        vNumFabTmp := '';
        vDescrTmp  := '';
      end;
    finally
      vIndTec.prepare_loop_done;
    end;

    try
      if (trim(vGrupoTmp) <> '') then
        vIndTec.prepare_loop('GRUPO_PROD_MPRIMA = ' + vGrupoTmp + ' AND COD_PROD_MPRIMA = ' + QuotedStr(vCodTmp))
      else
        vIndTec.prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
        'PRODUTO' + #13 +
        'Grupo Prod: ' + vGrupoTmp + #13 +
        'Cod Prod: ' + vCodTmp + #13 +
        'Num Fab Prod: ' + vNumFabTmp + #13 +
        'Descr Prod: ' + vDescrTmp;

      if (trim(vGrupoTmp) = '') then
      	vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(vIndTec.dataSet.RecordCount) + ' registros selecionados permanentemente?';

      if Application.MessageBox(PChar(vtemp),
        'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
        exit;

      while not vIndTec.dataSet.IsEmpty do
      begin
        vIndTec.vgrupo_prod_acabado := dataSet.FieldByName('grupo_prod').AsString;
        vIndTec.vcod_prod_acabado := dataSet.FieldByName('cod_prod').AsString;
        vIndTec.vgrupo_prod_mp := vIndTec.dataSet.FieldByName('grupo_prod_mprima').AsString;
        vIndTec.vcod_prod_mp := vIndTec.dataSet.FieldByName('cod_prod_mprima').AsString;
        vIndTec.vcodprod := vIndTec.dataSet.FieldByName('num_fab_mprima').AsString;

        if not vDadosIni.PesqPros('ITEC002', 'EXCLUIR',
          'ACAB ' +
          'Grupo: ' + vIndTec.vgrupo_prod_acabado + ' ' +
          'Codigo: ' + vIndTec.vcod_prod_acabado + ' ' +
          'INS ' +
          'Grupo: ' + vIndTec.vgrupo_prod_mp + ' ' +
          'Codigo: ' + vIndTec.vcodprod,
          'INDICE_TECNICO',
          vIndTec.vgrupo_prod_acabado + ' ' +
          vIndTec.vcod_prod_acabado,
          buscas, True) then
            Exit;

        if not vIndTec._ExcluirItem then
          Exit;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      vIndTec.prepare_loop_done;
    end;

    Result := True;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.ApagarInsumoOutroProd. Erro: ' + e.Message);
    end;
  end;
end;

procedure TProdutos.AtribuirPerfilProd(codperfil: integer);
var
  i, j: integer;
begin
  if LocPerfilProd = nil then
    LocPerfilProd := TLocPerfilProd.create;
  if not LocPerfilProd.buscas.Active then
    LocPerfilProd.abreLocPerfilProd(codperfil);
  if not LocPerfilProd.buscas.IsEmpty then
  begin
    for i := 0 to dataSet.FieldCount - 1 do
    begin
      if (dataSet.Fields[i].FieldName <> 'COD_EMPRESA') then
      begin
        for j := 0 to LocPerfilProd.buscas.FieldCount - 1 do
        begin
          if (dataSet.Fields[i].FieldName = LocPerfilProd.buscas.Fields[j].FieldName) then
          begin
            if Trim(LocPerfilProd.buscas.Fields[j].AsString) <> '' then
              dataset.Fields[i].Value := LocPerfilProd.buscas.Fields[j].Value;
            continue;
          end;
        end;
      end;
    end;
  end;
end;

function TProdutos.verProdutosAcabadosProducao(
  pNatureza: string;
	pGrupoProd: Integer;
  pCodProd: string;
  pCodProducao: Integer = 0;
  pNitem: Integer = 0): boolean;
var
  I: Integer;
begin
	try
  	try
      Result := true;


      cdsProdutosAcabados := TClientDataSet(dtmProdutos.cdsProdutosAcabados);
      cdsEstoqueDiarioAcabados := TClientDataSet(dtmProdutos.cdsEstoqueDiarioAcabados);
      cdsEstoqueDiarioAcabadosProducao := TClientDataSet(dtmProdutos.cdsProdutosAcabadosProducao);

    	if pNatureza = 'S' then
      begin
      	FrmCadProdutos.lbInsGrupo.Caption := IntToStr(dataSet.FieldByName('grupo_prod').AsInteger);
      	FrmCadProdutos.lbInsCod.Caption := trim(dataSet.FieldByName('cod_prod').AsString);
      	FrmCadProdutos.lbInsNum.Caption := trim(dataSet.FieldByName('num_fab_prod').AsString);
      end
      else
      begin
        buscas.Close;
        buscas.SQL.Text := ' select first 1 pii.grupo_prod, pii.cod_prod, pr.num_fab_prod from producao p ' +
        	' inner join producao_item_indice pii on ' +
          '   pii.cod_producao = p.cod_producao ' +
          '   and pii.cod_empresa = p.cod_empresa ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pii.grupo_prod ' +
          '   and pr.cod_prod = pii.cod_prod ' +
          '   and pr.cod_empresa = pii.cod_empresa ' +
          ' inner join producao_item pi on ' +
          '   pi.cod_producao = pii.cod_producao ' +
          '   and pi.cod_empresa = pii.cod_empresa ' +
          '   and pi.nitem = pii.nitem ' +
          ' where pi.cod_producao = :cod_producao ' +
          ' and pi.nitem = :nitem ' +
          ' and pi.grupo_prod = :grupo_prod ' +
          ' and pi.cod_prod = :cod_prod ' +
          ' and pi.cod_empresa = :cod_empresa ';
        buscas.ParamByName('cod_producao').AsInteger := pCodProducao;
        buscas.ParamByName('nitem').AsInteger := pNitem;
        buscas.ParamByName('grupo_prod').AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
        buscas.ParamByName('cod_prod').AsString := dataSet.FieldByName('cod_prod').AsString;
        buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.Open;

        FrmCadProdutos.lbInsGrupo.Caption := IntToStr(buscas.FieldByName('grupo_prod').AsInteger);
      	FrmCadProdutos.lbInsCod.Caption := trim(buscas.FieldByName('cod_prod').AsString);
      	FrmCadProdutos.lbInsNum.Caption := trim(buscas.FieldByName('num_fab_prod').AsString);
      end;

      if pCodProducao > 0 then
      begin
        cdsProdutosAcabados.Close;
        cdsProdutosAcabados.CommandText := ' select ' +
          ' pi.grupo_prod, pi.cod_prod, pi.num_fab_prod, ' +
          ' coalesce(pi.quantidade, 0) quantidade, ' +
					' (coalesce(pi.quantidade, 0) * coalesce(pi.prec_cusm_prod, 0)) custo, ' +
          ' coalesce(pi.prec_cus_prod, 0) prec_cus_prod, ' +
          ' coalesce(pi.prec_cusm_prod, 0) prec_cusmr_prod, ' +
          ' pi.descr_prod from producao p ' +
          ' inner join producao_item pi on ' +
          '   p.cod_producao = pi.cod_producao ' +
          '   and p.cod_empresa = pi.cod_empresa ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pi.grupo_prod ' +
          '   and pr.cod_prod = pi.cod_prod ' +
          '   and pr.cod_empresa = pi.cod_empresa ' +
          ' where pi.cod_producao = :cod_producao ' +
          ' and pi.nitem = :nitem ' +
          ' and pi.cod_empresa = :cod_empresa ' +
          ' and p.status = ''FECHADO'' ';
        cdsProdutosAcabados.Params.ParamByName('cod_producao').AsInteger := pCodProducao;
        cdsProdutosAcabados.Params.ParamByName('nitem').AsInteger := pNitem;
        cdsProdutosAcabados.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        cdsProdutosAcabados.Open;
      end
      else
      begin
        cdsProdutosAcabados.Close;
        cdsProdutosAcabados.CommandText := ' select ' +
          ' pi.grupo_prod, pi.cod_prod, pr.num_fab_prod, ' +
          ' 0.000 quantidade, ' +
          ' 0.000 custo, ' +
          ' coalesce(pr.prec_cus_prod, 0) prec_cus_prod, ' +
          ' coalesce(pr.prec_cusm_prod, 0) prec_cusmr_prod, ' +
          ' pr.descr_prod from producao p ' +
          ' inner join producao_item pi on ' +
          '   p.cod_producao = pi.cod_producao ' +
          '   and p.cod_empresa = pi.cod_empresa ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pi.grupo_prod ' +
          '   and pr.cod_prod = pi.cod_prod ' +
          '   and pr.cod_empresa = pi.cod_empresa ' +
          ' inner join producao_item_indice pii on ' +
          '   pi.cod_producao = pii.cod_producao ' +
          '   and pi.cod_empresa = pii.cod_empresa ' +
          '   and pi.nitem = pii.nitem ' +
          ' where pii.grupo_prod = :grupo_prod '+
          ' and pii.cod_prod = :cod_prod ' +
          ' and pii.cod_empresa = :cod_empresa ' +
          ' and p.status = ''FECHADO'' ';
        cdsProdutosAcabados.Params.ParamByName('grupo_prod').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        cdsProdutosAcabados.Params.ParamByName('cod_prod').AsString := dataSet.FieldByName('COD_PROD').AsString;
        cdsProdutosAcabados.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        cdsProdutosAcabados.Open;
      end;

      if not cdsProdutosAcabados.IsEmpty then
      begin
      	abreEstoqueDiarioAcabados (
          cdsProdutosAcabados.FieldByName('grupo_prod').AsInteger,
          cdsProdutosAcabados.FieldByName('cod_prod').AsString,
          StrToDateTime('01/01/1900'),
          Date);

        if not cdsEstoqueDiarioAcabados.IsEmpty then
        begin
        	abreEstoqueDiarioAcabadosProducao (
            cdsEstoqueDiarioAcabados.FieldByName('grupo_prod').AsInteger,
            cdsEstoqueDiarioAcabados.FieldByName('cod_prod').AsString,
            cdsEstoqueDiarioAcabados.FieldByName('data').AsDateTime);
        end
        else
        begin
          abreEstoqueDiarioAcabadosProducao (
            0,
            '',
            StrToDateTime('01/01/1900'));
        end;
      end
      else
      begin
        abreEstoqueDiarioAcabados (
          0,
          '',
          StrToDateTime('01/01/1900'),
          StrToDateTime('01/01/1900'));

        abreEstoqueDiarioAcabadosProducao (
          0,
          '',
          StrToDateTime('01/01/1900'));
      end;

      cdsProdutosAcabados.AfterScroll := datasetAfterScrollProdutosAcabados;
      cdsEstoqueDiarioAcabados.AfterScroll := datasetAfterScrollEstoqueAcabados;

      if pCodProducao > 0 then
      begin
        if not vDadosIni.abreForm('PRODUÇÃO Nº ' + IntToStr(pCodProducao), FrmCadProdutos.pnProdutosAcabados, [ofEscapeExit, ofAlignAllClientWinCtrl]) then
        	exit;
      end
      else
      begin
      	if not vDadosIni.abreForm('Produtos acabados', FrmCadProdutos.pnProdutosAcabados, [ofEscapeExit, ofAlignAllClientWinCtrl]) then
        	exit;
      end;

      cdsProdutosAcabados.AfterScroll := nil;
      cdsEstoqueDiarioAcabados.AfterScroll := nil;

    finally
    	vDadosIni.fechaStatusProcessamento;
    end;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.verProdutosAcabadosProducao. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.AtualizarProdutosEmLote: boolean;
var
  fTempListaProdutos: TClientDataSet;
  vIndexFieldNames: string;
  vIndexName: string;
  vRecNo: Integer;
  vMensagemTmp: string;
  vGrupoCodProdTemp, vCodProdTemp, vNumFabProdTemp: string;
  vManterNumeroFabricante: boolean;
  vReplicaoInterna: boolean;
  vUsaReplicador: boolean;
  vCodMax, vCodMaxCodigo, vCodMaxProd: Integer;
  I: Integer;
  vListaEmp: TStringList;
  vnf_icmsst_cest_v2: Tconfig_sistema_class;
  vProdutosNumFab: boolean;
  vListaProdutosNumFab: TStringList;
  vProdutosCodBarra: boolean;
  vListaProdutosCodBarra: TStringList;
  vListaTmp: TStringList;
  vCodBarrasExiste: boolean;
  vNumFabExiste: boolean;
  vmensagemP, vmensagem: string;
  vtempMensagem: string;
  vSQL: string;
  vUpdate: string;
  buscas2: TIBQuery;
  buscasU: TIBQuery;
  vDataFicha: TDateTime;
  vDataCodBar: TDateTime;
  input: AlteracaoPrecoInput;
  respItem: AlteracaoPrecoOutput;
  resposta: AlteracoesPrecoOutput;
  respostaPrecos: AlteracoesPrecoOutput;
  campo: CampoProdInput;
  campos: CamposProdInput;
  vnomecampo: string;
  vinc_a_cada_reg: Integer;
  vsalvar_a_cada_reg: Integer;

  procedure AddCampoValue(pNomeCampo: string; pValorCampo: Variant);
  begin
  	 vUpdate := vUpdate + ', ' + pNomeCampo + ' = :' + pNomeCampo;

  	 SetLength(campos, Length(campos) + 1);

    campo.NomeCampo  := pNomeCampo;
    campo.ValorCampo := pValorCampo;

    campos[High(campos)] := campo;
  end;

  procedure AddPrecoGeral(const ANomeCampo: string; AValorCampo: Double);
  var
    novoItem: AlteracaoPrecoOutput;
    iResults, iFound: Integer;
  begin
    iFound := -1;
    for iResults := Low(respostaPrecos) to High(respostaPrecos) do
      if respostaPrecos[iResults].NomeCampo = UpperCase(ANomeCampo) then
      begin
        iFound := iResults;
        Break;
      end;

    if iFound = -1 then
    begin
      SetLength(respostaPrecos, Length(respostaPrecos) + 1);
      iFound := High(respostaPrecos);
    end;

    novoItem.NomeCampo := UpperCase(ANomeCampo);
    novoItem.ValorCampo := AValorCampo;

    respostaPrecos[iFound] := novoItem;

    input.SetValor(novoItem.NomeCampo, novoItem.ValorCampo);
  end;

  procedure AddPrecosGeral(inputResult: AlteracoesPrecoOutput);
  var
    iInputs: Integer;
  begin
    for iInputs := Low(inputResult) to High(inputResult) do
      AddPrecoGeral(inputResult[iInputs].NomeCampo, inputResult[iInputs].ValorCampo);
  end;

  procedure obterDadosReplicacaoInterna;
  begin
  	vListaEmp := TStringList.Create;
    vListaEmp.Duplicates := dupIgnore;
    vListaEmp.Clear;

    buscas.close;
    buscas.sql.Text := ' select cod_empresa, ' +
     ' coalesce(emp_repl_interna, ' + vDadosIni.codEmpresa + ') emp_repl_interna from EMPRESA ' +
     ' where ativo = 1 and COD_EMPRESA <> ' + vDadosIni.codEmpresa;
    buscas.Open;
    buscas.FetchAll;
    vListaEmp.Add(vDadosIni.codEmpresa);

    buscas.First;
    while not buscas.Eof do
    begin
      if buscas.FieldByName('EMP_REPL_INTERNA').AsInteger = StrToInt(vDadosIni.codEmpresa) then
        vListaEmp.Add(IntToStr(buscas.FieldByName('COD_EMPRESA').AsInteger));

      buscas.Next;
    end;
  end;

  function verificarNumFabExiste: boolean;
  var
  	Z: Integer;
  begin
  	Result := True;

    if vProdutosNumFab then
      Exit;

  	vNumFabExiste := false;
    if vListaProdutosNumFab.Count > 0 then
    begin
      vProdutosNumFab := True;
      vListaTmp.Clear;
      vmensagemP := 'Número(s) de fabricação abaixo já existe(m) para outro(s) produto(s):' + chr(13);
      vmensagem := 'Número(s) de fabricação já existe(m) para outro(s) produto(s).' + chr(13) +
        'Favor verificar.';
      for Z := 0 to vListaProdutosNumFab.Count - 1 do
      begin
        if ExecutaComandosSql('select first 1 num_fab_prod from produtos ' +
           ' where cod_empresa=' + vDadosIni.codEmpresa +
           ' and not (grupo_prod =' + vDadosIni.getCampoPipe(trim(vListaProdutosNumFab[Z]), 1) +
           ' and cod_prod=' + quotedstr(vDadosIni.getCampoPipe(trim(vListaProdutosNumFab[Z]), 2)) +') ' +
           ' and num_fab_prod =' + quotedstr(vDadosIni.getCampoPipe(trim(vListaProdutosNumFab[Z]), 3))) then
         begin
