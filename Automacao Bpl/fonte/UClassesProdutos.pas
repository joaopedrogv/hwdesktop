function TCEST.delete: Boolean;
begin
  if dataSet.IsEmpty then
    Exit;

  if not vDadosIni.PesqPros('PRO295', 'EXCLUIR', 'CST/NCM ' + dataSet.FieldByName('CEST').AsString + '/' + dataSet.FieldByName('NCM').AsString,
    'CEST', dataSet.FieldByName('CEST').AsString + '/' + dataSet.FieldByName('NCM').AsString, buscas, False) then
    Exit;

  if Application.MessageBox('Deseja realmente excluir o registro?',
    'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
  begin
    buscas.Close;
    buscas.SQL.Text := 'delete from cest' +
      ' where cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString) +
      ' and ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString);
    buscas.Open;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    vDadosIni.GravaAuditoria('PRO295', 'EXCLUIR', 'SUCESSO', 'CEST',
      dataSet.FieldByName('CEST').AsString + '/' + dataSet.FieldByName('NCM').AsString, buscas);
    dataSet.Refresh;
  end;
