            ' where GRUPO_PROD = :GRUPO_PROD and COD_PROD = :COD_PROD ' +
            ' and COD_EMPRESA = :COD_EMPRESA and VALOR_PROMOCAO > 0 and PROPORCAO_TABELA > 0';
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
