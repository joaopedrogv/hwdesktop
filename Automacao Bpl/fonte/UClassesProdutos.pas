function TProdutos.VerificaNumFabProd(var pMensagem: string; pExibirMensagem: boolean = true): boolean;
var
	buscas2: TIBQuery;
begin
	if not (dataSet.State in [dsInsert, dsEdit]) then
    Exit;

	buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if pExibirMensagem then
  	vLiberarNumFabProdExistente := false;

  dataSet.FieldByName('NUM_FAB_PROD').AsString := StringReplace(fstr('num_fab_prod'), '''', '', [rfReplaceAll]);

  if dataSet.FieldByName('NUM_FAB_PROD').AsString = '' then
  begin
    pMensagem := 'Número de fabricação está vazio.' + chr(13) + 'Campo requerido.';
    if pExibirMensagem then
      Application.MessageBox(PChar(pMensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    result := false;
  end
  else if Length(Trim(dataSet.FieldByName('NUM_FAB_PROD').AsString)) > 14 then
  begin
    if (not ProcessamentoFabrica) and (vDadosIni.vSupermercado <> 'S') then
    begin
      pMensagem := 'Número de fabricação não deve ter mais que 14 caracteres.';
      if pExibirMensagem then
        Application.MessageBox(PChar(pMensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      result := false;
    end;
  end;

  buscas.close;
  if dataSet.State = dsEdit then
    buscas.SQL.text := 'select grupo_prod, cod_prod, num_fab_prod from produtos ' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and not (grupo_prod =' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
      ' and cod_prod = ' + quotedstr(trim(dataSet.FieldByName('COD_PROD').NewValue)) +
      ') and num_fab_prod = ' + quotedstr(dataSet.FieldByName('NUM_FAB_PROD').AsString) +
      ' and ativo <> 99 '
  else
  	buscas.SQL.text := 'select grupo_prod, cod_prod, num_fab_prod from produtos ' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and num_fab_prod = ' + quotedstr(dataSet.FieldByName('NUM_FAB_PROD').AsString) +
      ' and ativo <> 99 ';
  buscas.open;
  if (not buscas.IsEmpty) and
    ((dataset.FieldByName('GRUPO_PROD').AsString + trim(dataSet.FieldByName('COD_PROD').AsString))
    <> (buscas.FieldByName('GRUPO_PROD').AsString + trim(buscas.FieldByName('COD_PROD').AsString))) then
  begin
    pMensagem := 'Número de fabricação ' + QuotedStr(trim(buscas.FieldByName('NUM_FAB_PROD').AsString)) +
    	' já existe para outro produto.' + chr(13) + 'Deseja continuar assim mesmo?';
    if (pExibirMensagem) or (not vLiberarNumFabProdExistente) then
    	if Application.MessageBox(PChar(pMensagem), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = mrYES then
      begin
         if vDadosIni.PesqPros('PRO403', 'PERMITIR',
           'PERMITIR - NUMFAB ' + trim(dataSet.FieldByName('NUM_FAB_PROD').AsString),
           'PRODUTOS',
           trim(dataSet.FieldByName('GRUPO_PROD').AsString) + ' - ' +
           trim(dataSet.FieldByName('COD_PROD').AsString), buscas2, true) then
         begin
         	 vLiberarNumFabProdExistente := true;
           Result := true;
           exit;
         end;
      end;

    CodBarra.dataSet.First;
    while not CodBarra.dataSet.Eof do
    begin
      if ((CodBarra.dataSet.FieldByName('GRUPO_PROD').AsString + trim(CodBarra.dataSet.FieldByName('COD_PROD').AsString)) =
        (buscas.FieldByName('GRUPO_PROD').AsString + trim(buscas.FieldByName('COD_PROD').AsString))) then
         CodBarra.Delete
      else
         CodBarra.dataSet.Next;
    end;
    CodBarra.dataSet.First;

    if vLiberarNumFabProdExistente then
    begin
      result := true;
      exit;
    end;

    pMensagem := 'Número de fabricação ' + QuotedStr(trim(buscas.FieldByName('NUM_FAB_PROD').AsString)) +
    	' já existe.' + chr(13) + 'Favor alterá-lo.';
    if pExibirMensagem then
      Application.MessageBox(PChar(pMensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    result := false;
    exit;
  end
  else
    result := true;
  buscas.Close;
	result := true;
end;

procedure TProdutos.verificarGradezero;
begin
	try
   	buscas.Close;
    buscas.SQL.Text := ' select cod_grade, cod_empresa from grade ' +
    	' where cod_grade = 0 ' +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if buscas.IsEmpty then
    begin
    	buscas.Close;
	    buscas.SQL.Text := ' INSERT INTO GRADE ' +
      	' (COD_GRADE, COD_EMPRESA, DESCRICAO, DESCRICAO1, ATIVO) ' +
      	'	VALUES (:COD_GRADE, :COD_EMPRESA, :DESCRICAO, :DESCRICAO1, :ATIVO) ';
      buscas.ParamByName('COD_GRADE').AsInteger := 0;
    	buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    	buscas.ParamByName('DESCRICAO').AsString := 'SEM GRADE';
			buscas.ParamByName('DESCRICAO1').AsString := 'SEM GRADE';
      buscas.ParamByName('ATIVO').AsInteger := 0;
      buscas.ExecSQL;

      if buscas.Transaction.InTransaction then
      	buscas.Transaction.Commit;
    end;
  except
    on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('procedure TProdutos.verificarGradezero. Erro: ' + e.Message);
    end;
  end;
end;

