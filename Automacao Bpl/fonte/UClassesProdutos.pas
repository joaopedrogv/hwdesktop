procedure TCodBarras.TrataCodBarras(DatasetProd: TProdutos; CodBarra: string; CodGrade: string = '');
var
	buscas2: TIBQuery;
  modoEdit: boolean;
  vmensagemP, vmensagem: string;
  //  codBarraTemp: string;
begin
  //  result := false;
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if dataSet.State in [dsEdit, dsInsert] then  
    dataSet.FieldByName('COD_BARRA').AsString := StringReplace(fstr('COD_BARRA'), '''', '', [rfReplaceAll]);

  CodBarra := StringReplace(CodBarra, '''', '', [rfReplaceAll]);

  if trim(dataSet.FieldByName('COD_BARRA').asstring) = '' then
  begin
    Application.MessageBox('Código de barras está vazio.' +
      chr(13) + 'O código de barras não pode ser em branco.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    cancel;
    exit;
  end;

  if (trim(dataSet.FieldByName('COD_BARRA').AsString) =
    trim(codbarraAnterior))
    and (dataSet.State = dsEdit) then
  begin
    post;
    exit;
  end;

  if (dataSet.State = dsEdit) and (trim(codbarraAnterior) =
    trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').NewValue)) then
  begin
    Application.MessageBox('Código de barras igual ao número de fabricação do produto.' +
      chr(13) + 'Este código de barras não pode ser alterado.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    cancel;
    exit;
  end;

  if dataSet.State = dsEdit then
    modoEdit := true
  else
    modoEdit := false;
  //  codBarraTemp := trim(dataSet.FieldByName('COD_BARRA').asstring);
  cancel;
  while not dataSet.Eof do
  begin
    if CodBarra = trim(dataSet.FieldByName('COD_BARRA').AsString) then
    begin
      Application.MessageBox('Código de barras já existe para este produto.', 'Aviso', MB_OK +
        MB_ICONWARNING + MB_DEFBUTTON1);
      //      Result := false;
      exit;
    end;
    dataSet.Next;
  end;

  if (vDadosIni.vEcommerce.vHabilitarEcommerce)
  	and (vDadosIni.vEcommerce.vHabilitarGradeCodBarras) then
  begin
    try
      StrToInt(CodGrade);
    except
      CodGrade := '0';
    end;

    if StrToInt(CodGrade) > 0 then
    begin
    	storeRecNo;
      dataset.First;
      while not dataset.Eof do
      begin
      	if (dataset.FieldByName('cod_grade').AsInteger > 0)
        	and (dataset.FieldByName('cod_grade').AsInteger = StrToInt(CodGrade))
        	and (trim(dataset.FieldByName('cod_barra').AsString) <> trim(CodBarra)) then
        begin
          Application.MessageBox('Já existe um código de barras para esta grade neste produto.',
            'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
          restoreRecNo;
          exit;
        end;

        dataset.Next;
      end;
      restoreRecNo;
    end;
  end;

  if trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').OldValue) <> trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').NewValue) then
  begin
    if ExecutaComandosSql(' select cod_barra from cod_barra ' +
      ' where COD_BARRA = ' + quotedstr(CodBarra) +
      ' and COD_BARRA <> ' + quotedstr(trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').OldValue)) +
      ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' and ATIVO <> 99 ') then
    begin
    	vmensagemP := 'Código de barras ' + QuotedStr(trim(CodBarra)) +
      	' já existe para outro produto.' + chr(13) +
        'Deseja continuar assim mesmo?';
      vmensagem := 'Código de barras ' + QuotedStr(trim(CodBarra)) +
        ' já existe para outro produto.' + chr(13) +
        'Esta operação será cancelada.';

    	if Application.MessageBox(PChar(vmensagemP), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
      begin
      	Application.MessageBox(PChar(vmensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
	      exit;
      end;

      if not vDadosIni.PesqPros('PRO404', 'PERMITIR',
        'PERMITIR - CODBARRA ' + trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').NewValue),
        'PRODUTOS',
        trim(DatasetProd.dataSet.FieldByName('GRUPO_PROD').NewValue) + ' - ' +
        trim(DatasetProd.dataSet.FieldByName('COD_PROD').NewValue), buscas2, true) then
      begin
        Application.MessageBox(PChar(vmensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
        exit;
      end;
      //      result := false;
    end;
  end
  else if ExecutaComandosSql(' select cod_barra from cod_barra ' +
    ' where COD_BARRA = ' + quotedstr(CodBarra) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and ATIVO <> 99 ') then
  begin
  	vmensagemP := 'Código de barras ' + QuotedStr(trim(CodBarra)) +
      ' já existe para outro produto.' + chr(13) +
      'Deseja continuar assim mesmo?';
    vmensagem := 'Código de barras ' + QuotedStr(trim(CodBarra)) +
      ' já existe para outro produto.' + chr(13) +
      'Esta operação será cancelada.';

  	if Application.MessageBox(PChar(vmensagemP), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
    begin
      Application.MessageBox(PChar(vmensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      exit;
    end;

    if not vDadosIni.PesqPros('PRO404', 'PERMITIR',
      'PERMITIR - CODBARRA ' + trim(DatasetProd.dataSet.FieldByName('NUM_FAB_PROD').NewValue),
      'PRODUTOS',
      trim(DatasetProd.dataSet.FieldByName('GRUPO_PROD').NewValue) + ' - ' +
      trim(DatasetProd.dataSet.FieldByName('COD_PROD').NewValue), buscas2, true) then
    begin
      Application.MessageBox(PChar(vmensagem), 'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
      exit;
    end;
    //    result := false;
  end;

  if modoEdit then
  begin
    if (dataSet.Locate('COD_BARRA', trim(dataSet.FieldByName('COD_BARRA').OldValue){trim(codBarraTemp)}, [])) then
      if Edit then
        PreencheCampos(DatasetProd);
  end
  else if insert then
    PreencheCampos(DatasetProd);
  dataSet.FieldByName('COD_BARRA').AsString := CodBarra;
  dataSet.FieldByName('COD_GRADE').AsString := CodGrade;
  if (dataSet.State in [dsEdit, dsInsert]) {and (result = false)} then
    post;
end;

function TCodBarras.VerificarGrade(pGrupo: Integer; pCodProd: string;
  pCodGrade: Integer): boolean;
begin
	Result := true;
  {
  if not vDadosIni.vEcommerce.vHabilitarEcommerce then
  	exit;

  if not vDadosIni.vEcommerce.vHabilitarGradeCodBarras then
  	exit;
  }
  if pCodGrade = 0 then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' select cod_grade, cod_empresa from grade ' +
  	' where cod_grade = ' + IntToStr(pCodGrade) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ';
  buscas.Open;

  if buscas.IsEmpty then
  begin
 		Application.MessageBox('Grade informada não encontrada.',
    	'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    Result := false;
    exit;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select grupo_prod, cod_prod, cod_grade, cod_empresa from cod_grade_prod ' +
  	' where grupo_prod = ' + IntToStr(pGrupo) +
    ' and cod_prod = ' + QuotedStr(pCodProd) +
    ' and cod_grade = ' + IntToStr(pCodGrade) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ';
  buscas.Open;

  if buscas.IsEmpty then
  begin
 		Application.MessageBox('Grade informada não vinculada ao Produto',
    	'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    Result := false;
    exit;
  end;
end;

