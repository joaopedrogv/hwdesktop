function TProdutosDesmembramento.insert: Boolean;
begin
  Result := False;

  if not dataSet.Active then
    montaSelect('select d.*, pp.descr_prod' +
      ' from PRODUTOS_DESMEMBRAMENTO d' +
      ' inner join produtos pp on pp.grupo_prod = d.grupo_prod_mprima and' +
      ' pp.cod_prod = d.cod_prod_mprima and pp.cod_empresa = d.cod_empresa' +
      ' where d.grupo_prod_acabado = 0 and d.cod_prod_acabado = '''' and' +
      ' d.grupo_prod_mprima = 0 and d.cod_prod_mprima = ''''');
  if inherited Insert then
    result := True;

  dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
end;

function TProdutosDesmembramento.InsertItem: boolean;
begin

  vInseriuItem := False;

  if not vDadosIni.PesqPros('PRO251', 'SALVAR', '', 'PRODUTOS_DESMEMBRAMENTO',
    dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
    dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas, true) then
    Exit;

  if not vDadosIni.PesqPros('PRO253', 'SALVAR', '', 'PRODUTOS_DESMEMBRAMENTO',
    dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
    dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas, true) then
    Exit;

  try
    if Trim(vcod_prod_acabado) = '' then
    begin
      Application.MessageBox('Produto acabado não selecionado, verifique!', 'Atenção',
        MB_ICONINFORMATION + MB_OK);
      Result := False;
      exit;
    end;

    if Trim(vcod_prod_mp) = '' then
    begin
      Application.MessageBox('Produto matéria-prima não selecionado, verifique!', 'Atenção',
        MB_ICONINFORMATION + MB_OK);
      Result := False;
      exit;
    end;

    dataSet.First;
    while not dataSet.Eof do
    begin
      if (dataSet.FieldByName('grupo_prod_mprima').AsString = vgrupo_prod_mp) and
        (Trim(dataSet.FieldByName('cod_prod_mprima').AsString) = Trim(vcod_prod_mp)) then
      begin
        Application.MessageBox('Item informado já existe, verifique!', 'Atenção',
          MB_ICONINFORMATION + MB_OK);
        Result := False;
        exit;
      end;
      dataSet.Next;
    end;

    if Insert then
    begin
      dataSet.FieldByName('grupo_prod_acabado').AsString := vgrupo_prod_acabado;
      dataSet.FieldByName('cod_prod_acabado').AsString := vcod_prod_acabado;
      dataSet.FieldByName('grupo_prod_mprima').AsString := vgrupo_prod_mp;
      dataSet.FieldByName('cod_prod_mprima').AsString := vcod_prod_mp;
      dataSet.FieldByName('descr_prod').AsString := vdescr_prod_mp;
      dataSet.FieldByName('quant').AsCurrency := vquant;
      dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    end;

    inherited Post;
    Result := True;
    vInseriuItem := True;

    if Result then
    begin
      vDadosIni.GravaAuditoria('PRO251', 'INSERIR', 'SUCESSO', 'PRODUTOS_DESMEMBRAMENTO',
        dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
        dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas);

      vDadosIni.GravaAuditoria('PRO253', 'INSERIR', 'SUCESSO', 'PRODUTOS_DESMEMBRAMENTO',
        dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
        dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas);
    end
    else
    begin
      vDadosIni.GravaAuditoria('PRO251', 'INSERIR', 'FALHA', 'PRODUTOS_DESMEMBRAMENTO',
        dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
        dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas);

      vDadosIni.GravaAuditoria('PRO253', 'INSERIR', 'FALHA', 'PRODUTOS_DESMEMBRAMENTO',
        dataSet.FieldByName('GRUPO_PROD_ACABADO').AsString + ',' +
        dataSet.FieldByName('COD_PROD_ACABADO').AsString, buscas);
    end;

  except
    on E: Exception do
    begin
      Result := False;
      vDadosIni.registraErro(e.Message);
      Application.MessageBox('Erro ao tentar inserir Indice Desmembramento', 'Atenção',
        MB_ICONINFORMATION + MB_OK);
    end;
  end;
end;

function TProdutosDesmembramento.post: boolean;
begin
  vInseriuItem := False;
  try
    if dataSet.ChangeCount = 0 then
    begin
      Result := True;
      exit;
    end;

    if Apply then
    begin
      CommitaTransacao;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      Result := False;
    end;
    Refresh;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

