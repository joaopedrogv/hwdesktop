        buscas.SQL.Text := 'update COD_GRADE_PROD set QTDE = QTDE+:QTD_DIF_BAL ' +
          ' where grupo_prod = ' + IntToStr(qrEstIniGrade.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + quotedstr(trim(qrEstIniGrade.FieldByName('COD_PROD').AsString)) +
          ' and cod_grade = ' + IntToStr(qrEstIniGrade.FieldByName('COD_GRADE').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ativo = 1 ';
        buscas.ParamByName('QTD_DIF_BAL').AsFloat := qrEstIniGrade.FieldByName('QTD_DIF_BAL').AsFloat;
        buscas.ExecSQL;
        break;
      except
        //     messagedlg('Erro ao corrigir o Estoque Produto pode estar sendo usado',mtinformation,[mbOK],0);
      end;
    end;
    qrEstIniGrade.Next;
  end;

  while true do
  begin
    try
      buscas.Close;
      buscas.SQL.Text := 'update ESTOQUE_INI_GRADE set DATA_CONFIRM = :data_confirm' +
        ' where data_confirm is null and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo=1';
      buscas.ParamByName('data_confirm').AsDate := data;
      buscas.ExecSQL;
      break;
    except
      //        messagedlg('Erro ao Confirmar Data do Balanço', mtinformation, [mbOK], 0);
    end;
  end;
  qrEstIniGrade.close;
  buscas.close;

  buscas.Close;
  buscas.SQL.Text := 'select e.grupo_prod,  e.cod_prod, e.cod_empresa, coalesce(g.cod_grade, 0) cod_grade from estoque_ini e' +
    ' left join estoque_ini_grade g on e.grupo_prod = g.grupo_prod and e.cod_prod = g.cod_prod and e.cod_empresa = g.cod_empresa' +
    ' and g.data_cadastro = e.data_cadastro and g.DATA_CONFIRM = e.DATA_CONFIRM' +
    ' where e.tip_bal = ''D'' and e.data_cadastro = :DATA_CONFIRM and e.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.ParamByName('DATA_CONFIRM').AsDate := data;
  buscas.Open;
  buscas.First;
  while not buscas.Eof do
  begin

    while True do
    begin
      try
        vMovimentaEstoque.Close;
        vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := buscas.Fieldbyname('GRUPO_PROD').AsInteger;
        vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := buscas.Fieldbyname('COD_PROD').AsString;
        vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := buscas.Fieldbyname('COD_EMPRESA').AsInteger;
        vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := buscas.Fieldbyname('COD_GRADE').AsInteger;
        vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
        vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := 0;
        vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
        vMovimentaEstoque.Prepare;
        vMovimentaEstoque.ExecProc;
        Break;
      except
      end;
    end;
    buscas.Next;
  end;

  result:= CommitaTransacao;
  if result then
    Application.MessageBox('Confirmação do Balanco Concluído com Sucesso', 'Informação', MB_OK +
    MB_ICONINFORMATION)
  else Application.MessageBox('Ocorreu uma falha na Confirmação do Balanco', 'Informação', MB_OK +
    MB_ICONINFORMATION);
end;

