destructor TReceitasProd.destroy;
begin

  inherited;
end;

function TReceitasProd.post: boolean;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.FieldByName('PROCESSO_PRODUCAO').AsString = '' then
      raise exception.create('Receita precisa ser preenchida');
    if (dataSet.State in [dsInsert]) then
      dataSet.FieldByName('cod_receita').AsInteger := Gencodigo('REC_ASS',
        DtmProdutos.spIcoCodRecProd, '0');
    dataSet.FieldByName('TIPO_UTIL').AsString := 'P';
    Result := inherited post;
    if Apply then
      CommitaTransacao;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.registraErro(e.Message);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TReceitasProd.utilizar: boolean;
begin
  buscas.Transaction.InTransaction;
  ExecutaComandosSqlExec('update produtos p ' +
    ' set p.rep_int_active = 1, p.cod_recprod = ' + dataset.FieldByName('cod_receita').asstring +
    ' where p.grupo_prod= ' + inttostr(_vGrupoProd_I) +
    ' and p.cod_prod= ' + QuotedStr(trim(_vCodProd_I)) +
    ' and p.cod_empresa =' + vDadosIni.codEmpresa +
    ' and p.ativo=1');
  buscas.Transaction.Commit;

end;

