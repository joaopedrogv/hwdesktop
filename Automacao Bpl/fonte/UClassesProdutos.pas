procedure TNBM.setCodEmpresaUpdateRepInterna;
begin
  if vListaCamposRep = nil then
    vListaCamposRep := TStringList.Create;
  vListaCamposRep.Clear;
  if retornaValor('select tabela as valor from TAB_REP where TABELA = ''PRODUTOS''') = 'PRODUTOS' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select cod_empresa from empresa' +
      ' where cod_empresa <> ' + vDadosIni.codEmpresa;
    buscas.Open;
    if not buscas.IsEmpty then
    begin
      fCodEmpresaRepInterna := '(' + vDadosIni.codEmpresa + ',';
      buscas.First;
      while not buscas.Eof do
      begin

        fCodEmpresaRepInterna := fCodEmpresaRepInterna + buscas.FieldByName('cod_empresa').AsString + ',';
        buscas.Next;
      end;
      fCodEmpresaRepInterna := fCodEmpresaRepInterna + ')';
      fCodEmpresaRepInterna := StringReplace(fCodEmpresaRepInterna, ',)', ')', [rfReplaceAll]);
      buscas.Close;
      buscas.SQL.Text := 'select campo_alt from tab_alt' +
        ' where tabela = ''PRODUTOS''';
      buscas.Open;
      while not buscas.Eof do
      begin
        vListaCamposRep.Add('|' + Trim(buscas.FieldByName('campo_alt').AsString) + '|');
        buscas.Next;
      end;
    end
    else
      fCodEmpresaRepInterna := '(' + vDadosIni.codEmpresa + ')';
  end
  else
    fCodEmpresaRepInterna := '(' + vDadosIni.codEmpresa + ')';
end;

