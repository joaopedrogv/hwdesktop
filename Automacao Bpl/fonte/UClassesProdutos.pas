function TKitsProdutosEC.checarCamposEcommerce(pKit: TKitsProdutos; pItKit: TItKitsProdutos;
	pTestarProd: boolean = false; pTestarQtdeProd: boolean = false): boolean;
var
	vItemAdc: boolean;
	vtemp: string;
  vRecNo: Integer;
  buscas2: TIBQuery;
begin
	try
  	Result := false;

    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := buscas.Database;
  	buscas2.Transaction := buscas.Transaction;

		if dataSet.FieldByName('DESCONTO_VALOR').AsFloat < 0 then
  		dataSet.FieldByName('DESCONTO_VALOR').AsFloat := 0;
    if dataSet.FieldByName('DESCONTO_PERC').AsFloat < 0 then
  		dataSet.FieldByName('DESCONTO_PERC').AsFloat := 0;

    if dataSet.FieldByName('DESCONTO_VALOR').AsFloat > 0 then
  		dataSet.FieldByName('DESCONTO_PERC').AsFloat := 0;
    if dataSet.FieldByName('DESCONTO_PERC').AsFloat > 0 then
  		dataSet.FieldByName('DESCONTO_VALOR').AsFloat := 0;

    if (dataSet.FieldByName('DESCONTO_VALOR').AsFloat > 0)
    	and (dataSet.FieldByName('DESCONTO_VALOR').AsFloat > pKit.dataSet.FieldByName('VALOR_TAB_PROKIT').AsFloat) then
    begin
      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
      FrmCadKits.verificarAbaEcommerceComercioAberto;
      raiseExceptionCreate('Valor do desconto não deve ser maior que o valor do kit no E-Commerce!', 'DBEditDescValor');
    end;

    if dataSet.FieldByName('DESCONTO_PERC').AsFloat > 100 then
    begin
      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
      FrmCadKits.verificarAbaEcommerceComercioAberto;
      raiseExceptionCreate('Percentual de desconto não deve ser maior que 100!', 'DBEditDescPerc');
    end;

    if (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
    begin
      if trim(dataSet.FieldByName('DESCR_KIT_RES').AsString) = '' then
      begin
	      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Descrição do kit não informada!', 'DBEditDescrEC');
      end;

      if (trim(vDadosIni.vEcommerce.vEcommerceIntegrado) = 'TRAY') then
        if dataSet.FieldByName('COD_CATEGORIA').AsInteger <= 0 then
        begin
          FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
          FrmCadKits.verificarAbaEcommerceComercioAberto;
          raiseExceptionCreate('Categoria principal não informada!', 'DBLookupComboBoxCategoria');
        end;

      if (trim(dataSet.FieldByName('REGRA_PESO_DIM').AsString) = 'SOMARPESODIM')
      	or (trim(dataSet.FieldByName('REGRA_PESO_DIM').AsString) = 'SOMARPESO_CADDIM') then
      	dataSet.FieldByName('PESO_BRUT_KIT').AsFloat := pKit.vKitCons.dataSet.FieldByName('PESO_BRUT_PROD').AsFloat;

      if (trim(dataSet.FieldByName('REGRA_PESO_DIM').AsString) = 'SOMARPESODIM') then
      begin
        dataSet.FieldByName('COMPRIMENTO_KIT').AsFloat := pKit.vKitCons.dataSet.FieldByName('COMPRIMENTO_PROD').AsFloat;
        dataSet.FieldByName('ALTURA_KIT').AsFloat := pKit.vKitCons.dataSet.FieldByName('ALTURA_PROD').AsFloat;
        dataSet.FieldByName('LARGURA_KIT').AsFloat := pKit.vKitCons.dataSet.FieldByName('LARGURA_PROD').AsFloat;
      end;

      if trim(dataSet.FieldByName('REGRA_PESO_DIM').AsString) = '' then
      begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Regra de peso e dimensão não informada!', 'DBComboBoxRegra');
      end;

      if dataSet.FieldByName('PESO_BRUT_KIT').AsFloat <= 0 then
      begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Campo peso não informado', 'DBEditPeso');
      end;

      if (dataSet.FieldByName('COMPRIMENTO_KIT').AsFloat <= 0) then
      begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Campo comprimento não informado', 'DBEditComprimento');
      end;

      if (dataSet.FieldByName('ALTURA_KIT').AsFloat <= 0) then
      begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Campo altura não informado', 'DBEditAltura');
      end;

      if (dataSet.FieldByName('LARGURA_KIT').AsFloat <= 0) then
      begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;
        raiseExceptionCreate('Campo largura não informado', 'DBEditLargura');
      end;

      if (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select count(*) from kits_prod_kits ' +
          ' where codigo_kit = ' + IntToStr(dataset.FieldByName('CODIGO_KIT').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          vDadosIni.IfThen(not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos,
            ' and sinc_ecommerce = ''S'' ', '');
        buscas.Open;

        if buscas.FieldByName('count').AsInteger <= 1 then
        begin
          FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
          FrmCadKits.verificarAbaEcommerceComercioAberto;
          vtemp := 'Para sincronizar os produtos do kit ao E-Commerce é necessário ter dois ou mais produtos no kit!';
          if not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos then
            vtemp := 'Para sincronizar os produtos do kit ao E-Commerce é necessário ter dois ou mais produtos no kit marcados para sincronizar!';
          raiseExceptionCreate(vtemp, 'DBGrid2');
        end;
      end;

      if (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') and (pTestarProd) then
      begin
      	vRecNo := pItKit.dataSet.RecNo;
        pItKit.dataSet.DisableControls;
        pItKit.dataSet.First;
        while not pItKit.dataSet.Eof do
        begin
          if (vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos)
            and (pItKit.dataset.FieldByName('id_commerce_prod').AsInteger <= 0) then
          begin
          	buscas2.Close;
            buscas2.SQL.Text := ' select id_commerce from produtos_ec ' +
            	' where grupo_prod = ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(pItKit.dataset.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa;
            buscas2.Open;

            if buscas2.IsEmpty then
            begin
              FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
              FrmCadKits.verificarAbaEcommerceComercioAberto;
              raiseExceptionCreate('Produto do kit sem o Id Ecommerce, o mesmo não será sincronizado: ' + #13 + #13 +
                'Grupo: ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) + #13 +
                'Código: ' + pItKit.dataset.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + pItKit.dataset.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + pItKit.dataset.FieldByName('descr_prod_kit').AsString + #13 + #13 +
                'Favor verificar antes de continuar!', 'DBGrid2');
            end
            else if buscas2.FieldByName('ID_COMMERCE').AsInteger <= 0 then
            begin
            	FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
              FrmCadKits.verificarAbaEcommerceComercioAberto;
              raiseExceptionCreate('Produto do kit sem o Id Ecommerce, o mesmo não será sincronizado: ' + #13 + #13 +
                'Grupo: ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) + #13 +
                'Código: ' + pItKit.dataset.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + pItKit.dataset.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + pItKit.dataset.FieldByName('descr_prod_kit').AsString + #13 + #13 +
                'Favor verificar antes de continuar!', 'DBGrid2');
            end;
          end
          else if (not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos)
            and (pItKit.dataset.FieldByName('id_commerce_prod').AsInteger <= 0)
            and (pItKit.dataset.FieldByName('sinc_ecommerce').AsString = 'S') then
          begin
          	buscas2.Close;
            buscas2.SQL.Text := ' select id_commerce from produtos_ec ' +
            	' where grupo_prod = ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(pItKit.dataset.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa;
            buscas2.Open;

            if buscas2.IsEmpty then
            begin
              FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
              FrmCadKits.verificarAbaEcommerceComercioAberto;
              raiseExceptionCreate('Produto do kit sem o Id Ecommerce, o mesmo não será sincronizado: ' + #13 + #13 +
                'Grupo: ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) + #13 +
                'Código: ' + pItKit.dataset.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + pItKit.dataset.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + pItKit.dataset.FieldByName('descr_prod_kit').AsString + #13 + #13 +
                'Favor verificar antes de continuar!', 'DBGrid2');
            end
            else if buscas2.FieldByName('ID_COMMERCE').AsInteger <= 0 then
            begin
              FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
              FrmCadKits.verificarAbaEcommerceComercioAberto;
              raiseExceptionCreate('Produto do kit sem o Id Ecommerce, o mesmo não será sincronizado: ' + #13 + #13 +
                'Grupo: ' + IntToStr(pItKit.dataset.FieldByName('grupo_prod').AsInteger) + #13 +
                'Código: ' + pItKit.dataset.FieldByName('cod_prod').AsString + #13 +
                'Num Fabricante: ' + pItKit.dataset.FieldByName('num_fab_prod').AsString + #13 +
                'Descrição: ' + pItKit.dataset.FieldByName('descr_prod_kit').AsString + #13 + #13 +
                'Favor verificar antes de continuar!', 'DBGrid2');
            end;
          end;
          pItKit.dataset.Next;
        end;
        pItKit.dataSet.First;
        pItKit.dataSet.EnableControls;
        pItKit.dataSet.RecNo := vRecNo;
      end;

      if (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') and (pTestarQtdeProd) then
      begin
        if not vDadosIni.vEcommerce.vKitsSincronizarTodosProdutos then
        begin
          vItemAdc := false;
          vRecNo := pItKit.dataSet.RecNo;
          pItKit.dataSet.DisableControls;
          pItKit.dataSet.First;
          while not pItKit.dataSet.Eof do
          begin
            if (pItKit.dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
            begin
              vItemAdc := true;
              break;
            end;

            pItKit.dataSet.Next;
          end;
          pItKit.First;
          pItKit.dataSet.EnableControls;
          pItKit.dataSet.RecNo := vRecNo;

          if not vItemAdc then
          begin
            if Application.MessageBox('Nenhum produto do kit foi adicionado para sincronização com E-Commerce: ' + #13 + #13 +
              'Deseja continuar assim mesmo?',
              'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
            begin
              FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
              raiseExceptionCreate('Nenhum produto do kit adiconado!', 'DBGrid2');
              Exit;
            end;
          end;
        end;
      end;
    end;
    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('PRO412', 'SALVAR', 'FALHA', 'PRODUTOS_EC',
    	  dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

constructor TKitsProdutosEC.create;
begin
	DataSet := TClientDataSet(dtmProdutos.cdsKitsEC);
  transacao := TIBTransaction(dtmProdutos.IBTransKits);
  Buscas := TIBQuery(dtmProdutos.qrBuscasKits);
end;

function TKitsProdutosEC.edit(pDataSet: TDataSet): boolean;
begin
	Result := inherited edit;

  if trim(dataSet.FieldByName('DESCR_KIT_RES').AsString) = '' then
    	dataSet.FieldByName('DESCR_KIT_RES').AsString :=
      	vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(pDataSet.FieldByName('DESCRICAO_KIT').AsString));

	if dataSet.FieldByName('DESCONTO_VALOR').IsNull then
		dataSet.FieldByName('DESCONTO_VALOR').AsFloat := 0;
  if dataSet.FieldByName('DESCONTO_PERC').IsNull then
	  dataSet.FieldByName('DESCONTO_PERC').AsFloat := 0;
  if dataSet.FieldByName('PESO_BRUT_KIT').IsNull then
	  dataSet.FieldByName('PESO_BRUT_KIT').AsFloat := 0;
  if dataSet.FieldByName('COMPRIMENTO_KIT').IsNull then
	  dataSet.FieldByName('COMPRIMENTO_KIT').AsFloat := 0;
  if dataSet.FieldByName('ALTURA_KIT').IsNull then
	  dataSet.FieldByName('ALTURA_KIT').AsFloat := 0;
  if dataSet.FieldByName('LARGURA_KIT').IsNull then
	  dataSet.FieldByName('LARGURA_KIT').AsFloat := 0;
end;

function TKitsProdutosEC.insert(pDataSet: TDataSet): boolean;
begin
	Result := inherited Insert;
  if Result then
  begin
    dataSet.FieldByName('CODIGO_KIT').AsInteger := pDataSet.FieldByName('CODIGO_KIT').AsInteger;
    dataSet.FieldByName('COD_EMPRESA').AsInteger := pDataSet.FieldByName('COD_EMPRESA').AsInteger;

    if trim(dataSet.FieldByName('DESCR_KIT_RES').AsString) = '' then
    	dataSet.FieldByName('DESCR_KIT_RES').AsString :=
      	vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(pDataSet.FieldByName('DESCRICAO_KIT').AsString));

    dataSet.FieldByName('SINC_ECOMMERCE').AsString := 'N';
    dataSet.FieldByName('DISPONIVEL').AsString := 'N';
    dataSet.FieldByName('PROMOCIONAL').AsString := 'N';
    dataSet.FieldByName('FRETE_GRATIS').AsString := 'N';
    dataSet.FieldByName('LANCAMENTO').AsString := 'N';
    dataSet.FieldByName('DESTAQUE').AsString := 'N';
    dataSet.FieldByName('VARIACAO').AsString := 'N';
    dataSet.FieldByName('TERMOS_ACEITE').AsString := 'N';
    dataSet.FieldByName('COMPREJUNTO').AsString := 'N';
    dataSet.FieldByName('VIRTUAL').AsString := 'N';
    dataSet.FieldByName('DESCONTO_VALOR').AsFloat := 0;
    dataSet.FieldByName('DESCONTO_PERC').AsFloat := 0;
    dataSet.FieldByName('PESO_BRUT_KIT').AsFloat := 0;
    dataSet.FieldByName('COMPRIMENTO_KIT').AsFloat := 0;
    dataSet.FieldByName('ALTURA_KIT').AsFloat := 0;
    dataSet.FieldByName('LARGURA_KIT').AsFloat := 0;
  end;
end;

function TKitsProdutosEC.post(pKit: TKitsProdutos; pItKit: TItKitsProdutos; pCommitar: boolean = False): boolean;
var
  acao: string;
  codigo: integer;
  vValorProdEcommerce: Double;
  vPercProdEcommerce: Double;
  vRecNo: Integer;
  vtemp: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('DESCR_KIT_RES').AsString) = '' then
    begin
      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
      raiseExceptionCreate('Descrição do kit não informada!', 'DBEditDescrEC');
    end;

    if dataSet.FieldByName('COD_CATEGORIA').AsInteger <= 0 then
    begin
      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
      raiseExceptionCreate('Categoria principal não informada!', 'DBLookupComboBoxCategoria');
    end;

    if trim(dataSet.FieldByName('URL_ACESSO').AsString) = '' then
    begin
      FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
      raiseExceptionCreate('Url de Acesso não informado!', 'DBEditURLAcesso');
    end;

    if trim(dataSet.FieldByName('URL_ACESSO').AsString) <> '' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' SELECT PRODUTOS_EC.GRUPO_PROD, PRODUTOS_EC.COD_PROD, 0 CODIGO_KIT, PRODUTOS_EC.COD_EMPRESA, ' +
        ' PRODUTOS.NUM_FAB_PROD, PRODUTOS.DESCR_PROD FROM PRODUTOS_EC ' +
        ' INNER JOIN PRODUTOS ON PRODUTOS.GRUPO_PROD = PRODUTOS_EC.GRUPO_PROD ' +
        ' 	AND PRODUTOS.COD_PROD = PRODUTOS_EC.COD_PROD ' +
        ' 	AND PRODUTOS.COD_EMPRESA = PRODUTOS_EC.COD_EMPRESA ' +
        ' WHERE PRODUTOS_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' AND UPPER(PRODUTOS_EC.URL_ACESSO) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('URL_ACESSO').AsString))) +
        ' UNION ' +
        ' SELECT 0 GRUPO_PROD, '''' COD_PROD, KITS_PROD_EC.CODIGO_KIT, KITS_PROD_EC.COD_EMPRESA, ' +
        ' '''' NUM_FAB_PROD, KITS_PROD.DESCRICAO_KIT FROM KITS_PROD_EC ' +
        ' INNER JOIN KITS_PROD ON KITS_PROD.CODIGO_KIT = KITS_PROD_EC.CODIGO_KIT ' +
        '   AND KITS_PROD.COD_EMPRESA = KITS_PROD_EC.COD_EMPRESA ' +
        ' WHERE NOT (KITS_PROD_EC.CODIGO_KIT = ' + IntToStr(dataSet.FieldByName('CODIGO_KIT').AsInteger) + ')' +
        ' AND KITS_PROD_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' AND UPPER(KITS_PROD_EC.URL_ACESSO) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('URL_ACESSO').AsString)));
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        vtemp := 'Url de Acesso não pode repetir, já existe outro produto/kit com a mesma url: ' + #13 + #13 +
          vDadosIni.IfThen(buscas.FieldByName('GRUPO_PROD').AsInteger > 0,
            'PRODUTO' + #13 +
            'Grupo Prod: ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) + #13 +
            'Cod Prod: ' + trim(buscas.FieldByName('COD_PROD').AsString) + #13 +
            'Num Fab: ' + trim(buscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
            'Descr Prod: ' + trim(buscas.FieldByName('DESCR_PROD').AsString) + #13 + #13,
            'KIT PRODUTO: ' + #13 +
            'Cod Kit: ' + IntToStr(buscas.FieldByName('CODIGO_KIT').AsInteger) + #13 +
            'Descr Kit: ' + trim(buscas.FieldByName('DESCR_PROD').AsString) + #13 + #13) +
          'Favor verificar antes de continuar!';
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC3;
        raiseExceptionCreate(vtemp, 'DBEditURLAcesso');
      end;
    end;

    if (vDadosIni.vEcommerce.vKitDescontoPerm > 0) then
    begin
       if (dataSet.FieldByName('DESCONTO_PERC').AsFloat > 0)
       	 and (RoundTo(dataSet.FieldByName('DESCONTO_PERC').AsFloat, -3) > RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) then
       begin
       	 Application.MessageBox(PChar('Desconto no kit maior que o permitido: ' + #13 + #13 +
      	   'Desconto do kit: ' + FormatFloat('0.000', RoundTo(dataSet.FieldByName('DESCONTO_PERC').AsFloat, -3)) + '%' + #13 +
         	 'Desconto permitido: ' + FormatFloat('0.000', RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) + '%'), 'Atenção', MB_OK +
	         MB_ICONWARNING + MB_DEFBUTTON1);

         if not vDadosIni.PesqPros('PRO426', 'PERMITIR',
         		'Desc Inf: ' +  FormatFloat('0.000', RoundTo(dataSet.FieldByName('DESCONTO_PERC').AsFloat, -3)) + '% ' +
            'Desc Perm: '+ FormatFloat('0.000', RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) + '%',
            'KITS_PROD_EC', dataSet.FieldByName('CODIGO_KIT').AsString, buscas, true, True) then
           exit;
       end
       else if (dataSet.FieldByName('DESCONTO_VALOR').AsFloat > 0)
         and (vDadosIni.vEcommerce.vKitDescontoPerm > 0) then
       begin
       	 vValorProdEcommerce := 0;
         vRecNo := pItKit.dataSet.RecNo;
         pItKit.dataSet.DisableControls;
         pItKit.dataSet.First;
         while not pItKit.dataSet.Eof do
         begin
         	 vValorProdEcommerce := vValorProdEcommerce + pItKit.dataSet.FieldByName('PRECO_ECOMMERCE').AsFloat;
           pItKit.dataSet.Next;
         end;
         pItKit.dataSet.First;
         pItKit.dataSet.EnableControls;
         pItKit.dataSet.RecNo := vRecNo;

         vPercProdEcommerce := (dataSet.FieldByName('DESCONTO_VALOR').AsFloat / vValorProdECommerce) * 100;
         if (RoundTo(vPercProdEcommerce, -3) > RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) then
         begin
         	 Application.MessageBox(PChar('Desconto no kit maior que o permitido: ' + #13 + #13 +
      	     'Desconto do kit: ' + FormatFloat('0.000', RoundTo(vPercProdEcommerce, -3)) + '%' + #13 +
         	   'Desconto permitido: ' + FormatFloat('0.000', RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) + '%'), 'Atenção', MB_OK +
	           MB_ICONWARNING + MB_DEFBUTTON1);

	         if not vDadosIni.PesqPros('PRO426', 'PERMITIR',
           	 'Desc Inf: ' +  FormatFloat('0.000', RoundTo(vPercProdEcommerce, -3)) + '% ' +
             'Desc Perm: '+ FormatFloat('0.000', RoundTo(vDadosIni.vEcommerce.vKitDescontoPerm, -3)) + '%',
           	 'KITS_PROD_EC', dataSet.FieldByName('CODIGO_KIT').AsString, buscas, true, True) then
           	 exit;
         end;
       end;
    end;

    if (dataSet.FieldByName('ID_COMMERCE').AsInteger > 0)
      and (dataSet.FieldByName('SINC_ECOMMERCE').AsString = 'N') then
    begin
        FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
        FrmCadKits.verificarAbaEcommerceComercioAberto;

        if Application.MessageBox('Kit foi sincronizado com E-Commerce: ' + #13 + #13 +
          'Caso queria continuar o kit será removido do E-Commerce, ' + chr(13) +
          'deseja continuar assim mesmo?', 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYES then
        begin
        	FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
          raiseExceptionCreate('Kit foi sincronizado com E-Commerce, favor informar Sim na opção Sincronizar!', 'DBComboBoxSincEC');
          Exit;
        end;

        if not vDadosIni.PesqPros('PRO413', 'PERMITIR', '', 'KITS_PROD_EC',
          dataSet.FieldByName('CODIGO_KIT').AsString, buscas, true) then
        begin
        	FrmCadKits.PageControlEC.ActivePage := FrmCadKits.TabSheetEC1;
          raiseExceptionCreate('Kit foi sincronizado com E-Commerce, favor informar Sim na opção Sincronizar!', 'DBComboBoxSincEC');
          Exit;
        end;
    end;

    dataSet.FieldByName('VARIACAO').AsString := 'N';
//
//    if not testarGrade(pTipo) then
//     exit;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    pItKit.AtualizarRateioDesc(pKit, false);

  	if pCommitar then
    	if Result then
      	Result := CommitaTransacao;
      
    if Result then
      vDadosIni.GravaAuditoria('PRO412', 'SALVAR', 'SUCESSO', 'KITS_PROD_EC',
  	    dataSet.FieldByName('CODIGO_KIT').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('PRO412', 'SALVAR', 'FALHA', 'KITS_PROD_EC',
	      dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('PRO412', 'SALVAR', 'FALHA', 'PRODUTOS_EC',
    	  dataSet.FieldByName('CODIGO_KIT').AsString, buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

