procedure TProdutos.GeraCodProd(GrupoProd: string);
var
  qtdDigitos, i: integer;
  grupoProdTemp: Integer;
  codProdTemp: string;
  vCodMax, vCodMaxCodigo: Integer;
begin
  if not (dataSet.State in [dsEdit, dsInsert]) then
    exit;	

  for i := 1 to Length(vDadosIni.vProduto.vDigitosProd) do
    if (vDadosIni.vProduto.vDigitosProd[i] <> '0') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '1') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '2') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '3') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '4') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '5') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '6') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '7') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '8') and
      (vDadosIni.vProduto.vDigitosProd[i] <> '9') then
    begin
      Application.MessageBox(Pchar('Verifique a variável ''DigitosProd'' no arquivo de configuração do sistema.' + chr(13) + 'O seu valor ''' + vDadosIni.vProduto.vDigitosProd +
        ''' está incorreto e por esse motivo será setado para 5.'), 'Aviso', MB_OK + MB_ICONWARNING
        + MB_DEFBUTTON1);
      vDadosIni.vProduto.vDigitosProd := '5';
    end;
  if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
  begin
    if dataSet.State <> dsInsert then
      Exit;

    try
      vDadosIni.abreStatusProcessamento('', 'Obtendo provável código do produto');

      buscas.Close;
      buscas.SQL.Text := ' SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS ' +
        '	WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME = ''PRODUTOS'' ' +
        ' AND RDB$RELATION_FIELDS.RDB$FIELD_NAME IN (''UNQ_GRUPO_PROD'', ''UNQ_COD_PROD'') ';
      buscas.open;

      if not buscas.IsEmpty then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select max(cast(UNQ_COD_PROD as integer)) as MAXIMOCOD from produtos' +
          ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
          ' and CHAR_LENGTH(TRIM(UNQ_COD_PROD))=' + vDadosIni.vProduto.vDigitosProd +
          ' union ' +
          ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
          ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
          ' and CHAR_LENGTH(TRIM(COD_PROD))=' + vDadosIni.vProduto.vDigitosProd +
          ' order by 1 desc ';
        buscas.open;
      end
      else
      begin
        buscas.Close;
        buscas.SQL.Text := ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
          ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
          ' and CHAR_LENGTH(TRIM(COD_PROD))=' + vDadosIni.vProduto.vDigitosProd;
        buscas.open;
      end;

      vCodMax := buscas.FieldByName('MAXIMOCOD').AsInteger;

      buscas.Close;
      buscas.SQL.Text := 'select valor as MAXIMOCOD from codigo' +
        ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
        ' and tabela = ''PRODUTOS''';
      buscas.open;

      vCodMaxCodigo := buscas.FieldByName('MAXIMOCOD').AsInteger;

      // Atualizar tabela código
      if (vCodMax > vCodMaxCodigo) then
      begin
        SqlExec(' update codigo set valor = ' + IntToStr(vCodMax) +
          ' where tabela = ''PRODUTOS'' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);
        if buscas.Transaction.InTransaction then
        	buscas.Transaction.Commit;

        buscas.Close;
        buscas.SQL.Text := 'select valor as MAXIMOCOD from codigo' +
          ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
          ' and tabela = ''PRODUTOS''';
        buscas.open;
      end;

    finally
      vDadosIni.fechaStatusProcessamento;
    end;

  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text := ' SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS ' +
    	'	WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME = ''PRODUTOS'' ' +
      ' AND RDB$RELATION_FIELDS.RDB$FIELD_NAME IN (''UNQ_GRUPO_PROD'', ''UNQ_COD_PROD'') ';
    buscas.open;

    if not buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select max(cast(UNQ_COD_PROD as integer)) as MAXIMOCOD from produtos ' +
        ' where UNQ_GRUPO_PROD=' + GrupoProd +
        ' and COD_EMPRESA=' + vDadosIni.codEmpresa +
        ' union ' +
        ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
        ' where GRUPO_PROD=' + GrupoProd +
        ' and COD_EMPRESA=' + vDadosIni.codEmpresa +
        ' order by 1 desc ';
      buscas.open;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
        ' where GRUPO_PROD=' + GrupoProd +
        ' and COD_EMPRESA=' + vDadosIni.codEmpresa;
      buscas.open;
    end;
  end;

  if buscas.FieldByName('MAXIMOCOD').AsInteger = 0 then
    dataSet.FieldByName('COD_PROD').AsString := vDadosIni.StrZero(1,
      strtoint(vDadosIni.vProduto.vDigitosProd))
  else if dataSet.FieldByName('COD_PROD').AsString <>
    vDadosIni.StrZero(strToInt(trim(buscas.FieldByName('MAXIMOCOD').AsString)) + 1,
    strtoint(vDadosIni.vProduto.vDigitosProd)) then
    //dataSet.State = dsInsert then
    dataSet.FieldByName('COD_PROD').AsString :=
      vDadosIni.StrZero(strToInt(trim(buscas.FieldByName('MAXIMOCOD').AsString)) + 1,
      strtoint(vDadosIni.vProduto.vDigitosProd));
  //  else if (dataSet.FieldByName('GRUPO_PROD').NewValue <> dataSet.FieldByName('GRUPO_PROD').OldValue) and
  //    (vDadosIni.vEmp.vUsarCodigoSequencialProduto <> 'S') then
  //    dataSet.FieldByName('COD_PROD').AsString :=
  //      vDadosIni.StrZero(strToInt(trim(buscas.FieldByName('MAXIMOCOD').AsString)) + 1,
  //      strtoint(vDadosIni.vProduto.vDigitosProd));

	if AtualizarProduto then
  begin
    grupoProdTemp := dataSet.FieldByName('GRUPO_PROD').OldValue;
    codProdTemp := dataSet.FieldByName('COD_PROD').OldValue;
  end;

  if dataSet.State = dsInsert then
  begin
    if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
    begin
      if dataSet.FieldByName('NUM_FAB_PROD').AsString = '' then
        dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString
    end
    else if dataSet.FieldByName('NUM_FAB_PROD').AsString = '' then
      dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('GRUPO_PROD').AsString +
        dataSet.FieldByName('COD_PROD').AsString;
  end
  else if dataSet.FieldByName('GRUPO_PROD').NewValue <> dataSet.FieldByName('GRUPO_PROD').OldValue then
  begin
  	if AtualizarProduto then
    begin
      if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
      begin
        if dataSet.FieldByName('NUM_FAB_PROD').AsString = '' then
          dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString
        else if (trim(dataSet.FieldByName('NUM_FAB_PROD').AsString) = trim(codProdTemp)) then
        	dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString
      end
      else
      begin
        if dataSet.FieldByName('NUM_FAB_PROD').AsString = '' then
          dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('GRUPO_PROD').AsString +
            trim(dataSet.FieldByName('COD_PROD').AsString)
        else if (trim(dataSet.FieldByName('NUM_FAB_PROD').AsString) = IntToStr(grupoProdTemp) + trim(codProdTemp)) then
        	dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('GRUPO_PROD').AsString +
            trim(dataSet.FieldByName('COD_PROD').AsString);
      end;
    end;
    //    AlterarGrupo := true;
    inherited post;
    //    Apply;
    if AtualizarProduto then
    begin
    	Apply;
      if not (dataSet.State in [dsInsert, dsEdit]) then
	  	  edit;
    	CodBarra.dataSet.First;
      while not CodBarra.dataSet.Eof do
      begin
        CodBarra.dataSet.Edit;
        if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
        begin
        	if (trim(CodBarra.dataSet.FieldByName('COD_BARRA').AsString) = trim(codProdTemp)) then
          begin
	          CodBarra.dataSet.FieldByName('COD_BARRA').AsString := dataSet.FieldByName('COD_PROD').AsString;
            Break;
          end;
        end
        else
        begin
        	if (trim(CodBarra.dataSet.FieldByName('COD_BARRA').AsString) = IntToStr(grupoProdTemp) + trim(codProdTemp)) then
          begin
            CodBarra.dataSet.FieldByName('COD_BARRA').AsString := dataSet.FieldByName('GRUPO_PROD').AsString + trim(dataSet.FieldByName('COD_PROD').AsString);
            Break;
          end;
        end;
        CodBarra.dataSet.Post;
        
        CodBarra.dataSet.Next;
      end;
    	CodBarra.dataSet.First;
    end;
    if not (dataSet.State in [dsInsert, dsEdit]) then
  	  edit;
    //    if Application.MessageBox(PChar('Deseja alterar o Nº de Fabricação para ' +
    //      dataSet.FieldByName('GRUPO_PROD').AsString + dataSet.FieldByName('COD_PROD').asstring + ' ?'),
    //      'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
    //      dataSet.FieldByName('NUM_FAB_PROD').AsString := dataSet.FieldByName('GRUPO_PROD').AsString +
    //        dataSet.FieldByName('COD_PROD').AsString;
  end
  else
  begin
    //    dataSet.FieldByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').OldValue;
    edit;
  end;
end;

