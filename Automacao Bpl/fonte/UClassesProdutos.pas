function TItKitsProdutos.abreItKitsProd(pDateSet: TDataSet): Boolean;
begin
  KitAtual := pDateSet.FieldByName('codigo_kit').AsInteger;

  result := montaSelect(' select ik.*, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_cus_prod, 0)) prec_cus_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_cusm_prod, 0)) prec_cusm_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_tab_prod, 0)) prec_tab_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_publico, 0)) prec_publico, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_30_prod, 0)) prec_30_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_60_prod, 0)) prec_60_prod,' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.prec_90_prod, 0)) prec_90_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.peso_brut_prod, 0)) peso_brut_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.comprimento_prod, 0)) comprimento_prod, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.largura_prod, 0)) largura_prod, ' +
	 ' (coalesce(ik.quant_prod_kit, 0) * coalesce(pr.altura_prod, 0)) altura_prod, ' +
   ' (coalesce(pr.est_f, 0)) est_f, ' +
   ' (coalesce(pe.id_commerce, 0)) id_commerce_prod, ' +
   ' (select valor_tab_pro FROM retorna_ec_vltb_prom(ik.grupo_prod, ik.cod_prod, ik.cod_empresa)) preco_un_ecommerce, ' +
   ' (coalesce(ik.quant_prod_kit, 0) * (select valor_tab_pro FROM retorna_ec_vltb_prom(ik.grupo_prod, ik.cod_prod, ik.cod_empresa))) preco_ecommerce, ' +
   ' (select desc_tabela from retorna_ec_vltb_prom(ik.grupo_prod, ik.cod_prod, ik.cod_empresa)) tab_preco_ecommerce, ' +
   ' ((coalesce(ik.quant_prod_kit, 0) * (select valor_tab_pro FROM retorna_ec_vltb_prom(ik.grupo_prod, ik.cod_prod, ik.cod_empresa))) - coalesce(ik.rateio_desc, 0)) preco_desc_ecommerce ' +
   ' from kits_prod_kits ik ' +
   ' left join produtos pr on pr.grupo_prod = ik.grupo_prod and pr.cod_prod = ik.cod_prod and pr.cod_empresa = ik.cod_empresa ' +
   ' left join produtos_ec pe on pe.grupo_prod = ik.grupo_prod and pe.cod_prod = ik.cod_prod and pe.cod_empresa = ik.cod_empresa ' +
   ' where ik.codigo_kit = ' + inttostr(pDateSet.FieldByName('codigo_kit').AsInteger) +
   ' and ik.cod_empresa = ' + vDadosIni.codEmpresa +
   ' and ik.ativo =1 ');
//   IfThen(SemGrade,
//	   ' and (select count(*) from cod_grade_prod gr where gr.grupo_prod = ik.grupo_prod and gr.cod_prod = ik.cod_prod and gr.cod_empresa = ik.cod_empresa) = 0 ', ''));
end;

function TItKitsProdutos.AddRemoverProduto(pKit: TKitsProdutos; pAdd: boolean; pTodos: boolean): boolean;
var
 vSincronizados: Integer;
 vRecno: Integer;
begin
	try
    result := true;

    if dataSet.IsEmpty then
      exit;

    vRecno := dataset.RecNo;
    vSincronizados := 0;

    if not vDadosIni.PesqPros(vDadosIni.IfThen(pAdd, 'PRO423', 'PRO424'),
      vDadosIni.IfThen(pAdd, 'SINCR', 'REMOVER SINCR'),
      vDadosIni.IfThen(not pTodos,
        dataSet.FieldByName('GRUPO_PROD').AsString + ' - ' + dataSet.FieldByName('COD_PROD').AsString, ''),
      'KITS_PROD_KITS',
      pKit.dataSet.FieldByName('CODIGO_KIT').AsString, buscas, true) then
      exit;

    try
    	vRecno := dataset.RecNo;
      dataset.First;
      while not dataset.Eof do
      begin
        if (dataset.FieldByName('SINC_ECOMMERCE').AsString = 'S') then
          vSincronizados := vSincronizados + 1;

        dataset.Next;
      end;
      dataset.First;
      dataSet.RecNo := vRecno;
    except
    end;

    if (not pTodos )then
    begin
      if (not pAdd) and (vSincronizados <= 2) then
      begin
        Application.MessageBox(PChar('Produto não pode ser removido da sincronização do E-Commerce, pois é obrigatório ter dois ou mais produtos no kit.'),
         'Aviso', MB_OK +  MB_ICONERROR + MB_DEFBUTTON1);
        Result := false;
        exit;
      end;

      dataset.Edit;
      dataset.FieldByName('SINC_ECOMMERCE').AsString := IfThen(pAdd, 'S', 'N');
      dataset.Post;
    end
    else
    begin
      dataset.First;
      while not dataset.Eof do
      begin
        if (not pAdd) and (vSincronizados <= 2) then
        begin
          Application.MessageBox(PChar('Todos os Produtos não podem ser removidos da sincronização do E-Commerce, pois é obrigatório ter dois ou mais produtos no kit.'),
           'Aviso', MB_OK +  MB_ICONERROR + MB_DEFBUTTON1);
          break;
        end;

        dataset.Edit;
        dataset.FieldByName('SINC_ECOMMERCE').AsString := IfThen(pAdd, 'S', 'N');
        dataset.Post;

        vDadosIni.GravaAuditoria(vDadosIni.IfThen(pAdd, 'PRO423', 'PRO424'),
          vDadosIni.IfThen(pAdd, 'SINCR', 'REMOVER SINCR'),
          dataSet.FieldByName('GRUPO_PROD').AsString + ' - ' + dataSet.FieldByName('COD_PROD').AsString + vDadosIni.IfThen(pTodos, ' (todos)', ''),
          'KITS_PROD_KITS',
          pKit.dataset.FieldByName('CODIGO_KIT').AsString, buscas);

        dataset.Next;

        vSincronizados := vSincronizados - 1;
      end;
      dataset.First;
    end;
    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;
    if result then
      result := CommitaTransacao;

    if result then
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pAdd, 'PRO423', 'PRO424'),
        vDadosIni.IfThen(pAdd, 'SINCR', 'REMOVER SINCR'),
        'SUCESSO', 'KITS_PROD_KITS', '', buscas)
    else
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pAdd, 'PRO423', 'PRO424'),
        vDadosIni.IfThen(pAdd, 'SINCR', 'REMOVER SINCR'),
        'FALHA', 'KITS_PROD_KITS', '', buscas);

    Kit.Refresh;
    Refresh;

    dataSet.RecNo := vRecno;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(pAdd, 'PRO423', 'PRO424'),
        vDadosIni.IfThen(pAdd, 'SINCR', 'REMOVER SINCR'),
        'FALHA', 'KITS_PROD_KITS', '', buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TItKitsProdutos.AtualizarRateioDesc(pKit: TKitsProdutos; pComitar: boolean): boolean;
var
	vRateioDesc: Double;
  vDifRateio: Double;
begin
  try
  	try
      vRateioDesc := 0;

      Result := true;

      if not vDadosIni.vEcommerce.vHabilitarEcommerce then
        exit;

      if (pKit.dataSet.State in [dsInsert, dsEdit]) then
      begin
        pKit.dataset.Post;
        pKit.Apply;
      end;

      pKit.abreKitsProd(pKit.dataset);
      abreItKitsProd(pKit.dataset);

      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        dataSet.Edit;
        if pKit.vKitEC.dataset.FieldByName('DESCONTO_PERC').AsFloat > 0 then
          dataSet.FieldByName('RATEIO_DESC').AsFloat :=
            RoundTo((dataSet.FieldByName('QUANT_PROD_KIT').AsFloat) *
            RoundTo(((dataSet.FieldByName('PRECO_UN_ECOMMERCE').AsFloat) *
              (pKit.vKitEC.dataset.FieldByName('DESCONTO_PERC').AsFloat / 100)), -2), -2)
        else if pKit.vKitEC.dataset.FieldByName('DESCONTO_VALOR').AsFloat > 0 then
          dataSet.FieldByName('RATEIO_DESC').AsFloat :=
            RoundTo((dataSet.FieldByName('QUANT_PROD_KIT').AsFloat) *
              RoundTo((((dataSet.FieldByName('PRECO_UN_ECOMMERCE').AsFloat) /
                pKit.dataSet.FieldByName('VALOR_TAB_PROKIT').AsFloat) *
                  pKit.vKitEC.dataset.FieldByName('DESCONTO_VALOR').AsFloat), -2), -2)
        else
          dataSet.FieldByName('RATEIO_DESC').AsFloat := 0;
        dataSet.Post;

        vRateioDesc := vRateioDesc + dataSet.FieldByName('RATEIO_DESC').AsFloat;

        dataSet.Next;
      end;
      dataSet.First;
      dataSet.EnableControls;

      if (pKit.vKitEC.dataset.FieldByName('DESCONTO_VALOR').AsFloat > 0)
        and ((pKit.vKitEC.dataset.FieldByName('DESCONTO_VALOR').AsFloat <> vRateioDesc)) then
      begin
        vDifRateio := pKit.vKitEC.dataset.FieldByName('DESCONTO_VALOR').AsFloat - vRateioDesc;

        dataSet.DisableControls;
        dataSet.First;
        while not dataSet.Eof do
        begin
          // Inserir diferença do rateio último produto
          if dataSet.Eof then
          begin
            dataSet.Edit;
            dataSet.FieldByName('RATEIO_DESC').AsFloat := dataSet.FieldByName('RATEIO_DESC').AsFloat + vDifRateio;
            dataset.Post;
            break;
          end
          else if ((Trunc(vDifRateio * 100) mod Trunc(dataSet.FieldByName('QUANT_PROD_KIT').AsFloat)) = 0) then // Inserir diferença do rateio no produto que o resto da divisão é zero
          begin
            dataSet.Edit;
            dataSet.FieldByName('RATEIO_DESC').AsFloat := dataSet.FieldByName('RATEIO_DESC').AsFloat + vDifRateio;
            dataset.Post;
            break;
          end;

          dataSet.Next;
        end;

        dataSet.First;
        dataSet.EnableControls;
      end;

      Result := inherited post;

      if (DataSet.ChangeCount = 0) then
        Result := True
      else
        Result := Apply;

      if pComitar then
        if result then
          result := CommitaTransacao;
    finally
      pKit.abreKitsProd(pKit.dataset);
      abreItKitsProd(pKit.dataset);

      if not (pKit.dataSet.State in [dsInsert, dsEdit]) then
        pKit.dataSet.Edit;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

