function TAlteracaoPreco.salvarAlteracoes: boolean;
begin
  Result := CommitaTransacao;
  if (FGrid <> nil) then
    if FGrid.DataSource.DataSet.state = dsBrowse then
      FGrid.DataSource.DataSet.Refresh;

  vProgresso.Min := 0;
  vProgresso.Max := dataSet.RecordCount;
  vProgresso.Position := 0;

  dataSet.First;

  vLabel.Caption := 'Aguarde conclusão de operação';
  while not dataSet.Eof do
  begin
    Application.ProcessMessages;

    vMD5Func._gravaMD5_Produtos(buscas, dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString);

    dataSet.Next;
    vProgresso.Position := vProgresso.Position + 1;
  end;

  dataSet.EmptyDataSet;

end;

function TAlteracaoPreco.validaDadosDigitados: boolean;
var
  vTemp: string;
begin
  Result := False;
  try
    if vModalidade = '' then
      raise Exception.Create('Modalidade não informada');

    if Pos('ITEM', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('Grupo do Produto não informado');
      if (vCampoFimOuCodigo = '') then
        raise Exception.Create('Código do Produto não informado');
      try
        StrToInt(Trim(vCampoIniOuGrupo));
      except
        raise Exception.Create('Grupo do Produto inválido');
      end;

      if not ExecutaComandosSql('select grupo_prod, cod_prod, descr_prod from produtos' +
        ' where cod_prod = ' + QuotedStr(vCampoFimOuCodigo) +
        ' and grupo_prod = ' + Trim(vCampoIniOuGrupo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa) then
        raise Exception.Create('Produto não encontrado');

    end
    else if Pos('SUBGRUPO', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('SubGrupo Inicial não informado');
      if (vCampoFimOuCodigo = '') then
        vCampoFimOuCodigo := vCampoIniOuGrupo;
    end
    else if Pos('GRUPO', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('Grupo Inicial não informado');
      if (vCampoFimOuCodigo = '') then
        vCampoFimOuCodigo := vCampoIniOuGrupo;
    end
    else if Pos('MARCA', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('SubGrupo Inicial não informado');
      if (vCampoFimOuCodigo = '') then
        vCampoFimOuCodigo := vCampoIniOuGrupo;
    end
    else if Pos('DIFERENCIADO', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('Preço Diferenciado Inicial não informado');
      if (vCampoFimOuCodigo = '') then
        vCampoFimOuCodigo := vCampoIniOuGrupo;
    end
    else if Pos('PROMOCAO', vModalidade) > 0 then
    begin
      if (vCampoIniOuGrupo = '') then
        raise Exception.Create('Promoção Inicial não informado');
      if (vCampoFimOuCodigo = '') then
        vCampoFimOuCodigo := vCampoIniOuGrupo;
    end
    else if Pos('TODOS', vModalidade) > 0 then
      if not vDadosIni.PesqPros('PRO185', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        raise Exception.Create('Alteração de preço de todos os produtos não permitida');

    if (not vAVista) and (not v30Dias) and (not v60Dias) and (not v90Dias) and (not vAtacado)and (not vDiferenciado) and (not vPromocao) and (not vDiferenciadoProporcional) then
      raise Exception.Create('Nenhum preço ou ajuste selecionado. Seleciona pelo menos uma das opções' + #13 +
        'Varejo, 30 Dias, 60 Dias, 90 Dias, Atacado, Preço Diferenciado ou Promoção');

    if (vAVista) and (vCampoAVista <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('Varejo foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (v30Dias) and (vCampo30Dias <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('30 Dias foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (v60Dias) and (vCampo60Dias <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('60 Dias foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (v90Dias) and (vCampo90Dias <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('90 Dias foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (vAtacado) and (vCampoAtacado <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('Atacado foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (vDiferenciado) and (vCampoDiferenciado <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('Preço Diferenciado foi selecionado, o conteúdo do campo deve ser maior que 0');

    if (vPromocao) and (vCampoPromocao <= 0) and (vFinalidade <> 'AJUSTE') then
      raise Exception.Create('Preço de Promoção foi selecionado, o conteúdo do campo deve ser maior que 0');

    if vEfetuarAlteracaoPeloAjuste then
    begin
      if not vDadosIni.PesqPros('PRO184', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        raise Exception.Create('Efetuar alteração de preço pelo percentual de ajuste não permitido');
    end;

    if vAumento then
    begin
      if not vDadosIni.PesqPros('PRO186', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        raise Exception.Create('Aumento de preço não permitido');
    end
    else if vReducao then
    begin
      if not vDadosIni.PesqPros('PRO187', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        raise Exception.Create('Redução de preço não permitida');
    end
    else if vValorFixo then
    begin
      if not vDadosIni.PesqPros('PRO428', 'ABRIR', '', 'PRODUTOS', '', buscas, False) then
        raise Exception.Create('Alterar preços de venda para valor fixo não permitido');
    end;

    FpermitAltPrecAvista := vAVista;
    FpermitAltPrec30 := v30Dias;
    FpermitAltPrec60 := v60Dias;
    FpermitAltPrec90 := v90Dias;
    FpermitAltPrecAtacado:= vAtacado;
    FpermitAltPrecDiferenciado := vDiferenciado;
    FpermitAltPrecPromocao := vPromocao;
    FpermitAltPrecDiferenciadoProporcional := vDiferenciadoProporcional;
    FpermitAltPerc30 := False;
    FpermitAltPerc60 := False;
    FpermitAltPerc90 := False;
    FpermitAltPercDiferenciado := False;
    FpermitAltPercPromocao := False;

    if vFinalidade = 'AJUSTE' then
    begin

      FpermitAltPrecAvista := False;
      FpermitAltPrecAtacado := False;

      FpermitAltPerc30 := v30Dias;
      FpermitAltPerc60 := v60Dias;
      FpermitAltPerc90 := v90Dias;
      FpermitAltPercDiferenciado := vDiferenciado;
      FpermitAltPercPromocao := vPromocao;

      if not vEfetuarAlteracaoPeloAjuste then
      begin
        FpermitAltPrec30 := False;
        FpermitAltPrec60 := False;
        FpermitAltPrec90 := False;
        FpermitAltPrecDiferenciado := False;
        FpermitAltPrecPromocao := False;
      end
      else
      begin
        FpermitAltPrec30 := v30Dias;
        FpermitAltPrec60 := v60Dias;
        FpermitAltPrec90 := v90Dias;
        FpermitAltPrecDiferenciado := vDiferenciado;
        FpermitAltPrecPromocao := vPromocao;

        vDadosIni.vInibeMensPesqPros := 'S';
        if (FpermitAltPrec30) and (not vDadosIni.PesqPros('PRO189', 'VALIDAR', '', 'PRODUTOS', '',
          buscas, False)) then
          FpermitAltPrec30 := False;

        vDadosIni.vInibeMensPesqPros := 'S';
        if (FpermitAltPrec60) and (not vDadosIni.PesqPros('PRO190', 'VALIDAR', '', 'PRODUTOS', '',
          buscas, False)) then
          FpermitAltPrec60 := False;

        vDadosIni.vInibeMensPesqPros := 'S';
        if (FpermitAltPrec90) and (not vDadosIni.PesqPros('PRO191', 'VALIDAR', '', 'PRODUTOS', '',
          buscas, False)) then
          FpermitAltPrec90 := False;

        vDadosIni.vInibeMensPesqPros := 'S';
        if (FpermitAltPrecDiferenciado) and (not vDadosIni.PesqPros('PRO259', 'VALIDAR', '', 'PRODUTOS', '',
          buscas, False)) then
          FpermitAltPrecDiferenciado := False;

        vDadosIni.vInibeMensPesqPros := 'S';
        if (FpermitAltPrecPromocao) and (not vDadosIni.PesqPros('PRO260', 'VALIDAR', '', 'PRODUTOS', '',
          buscas, False)) then
          FpermitAltPrecPromocao := False;
      end;

      if (FpermitAltPerc30) and (not vDadosIni.PesqPros('PRO192', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de Percentual de ajuste para o preço de 30 dias não permitida');

      if (FpermitAltPerc60) and (not vDadosIni.PesqPros('PRO193', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de Percentual de ajuste para o preço de 60 dias não permitida');

      if (FpermitAltPerc90) and (not vDadosIni.PesqPros('PRO194', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de Percentual de ajuste para o preço de 90 dias não permitida');

      if (FpermitAltPercDiferenciado) and (not vDadosIni.PesqPros('PRO261', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de Percentual de ajuste para o preço diferenciado não permitida');

      if (FpermitAltPercPromocao) and (not vDadosIni.PesqPros('PRO262', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de Percentual de ajuste para o preço promocional não permitida');

    end
    else
    begin
      if (FpermitAltPrecAvista) and (not vDadosIni.PesqPros('PRO188', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço de varejo não permitida');

      if (FpermitAltPrec30) and (not vDadosIni.PesqPros('PRO189', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço de 30 dias não permitida');

      if (FpermitAltPrec60) and (not vDadosIni.PesqPros('PRO190', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço de 60 dias não permitida');

      if (FpermitAltPrec90) and (not vDadosIni.PesqPros('PRO191', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço de 90 dias não permitida');

      if (FpermitAltPrecAtacado) and (not vDadosIni.PesqPros('PRO270', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço atacado não permitida');

      if (FpermitAltPrecDiferenciado) and (not vDadosIni.PesqPros('PRO259', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço diferenciado não permitida');

      if (FpermitAltPrecPromocao) and (not vDadosIni.PesqPros('PRO260', 'VALIDAR', '', 'PRODUTOS', '', buscas, False)) then
        raise Exception.Create('Alteração de preço promocional não permitida');

    end;

    Result := True;

  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;

end;

