function TEtiquetas_Es.existeProduto(pCodigo, pModelo: string): string;
var
  fOldGrupo: integer;
  fOldCodigo: string;
begin
  if not fGrade.Active then
  begin
    fGrade.Close;
    fGrade.CommandText :=
      ' select 0 ordem, 0 cod_grade, ''SEM GRADE'' DESCRICAO, ''SEM GRADE'' DESCRICAO1, ' + vDadosIni.codEmpresa + ' cod_empresa, 1 ativo from rdb$database' +
      ' union ' +
      ' select 1 ordem, cod_grade, descricao, descricao1, cod_empresa, ativo from grade ' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cod_grade > 0 ' +
      ' order by 1, 3 ';
    fGrade.Open;
  end;
  if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod, descr_prod, aplicacao_prod, prec_tab_prod,' +
      ' prec_30_prod, num_fab_prod from produtos where cod_prod = ' + QuotedStr(pCodigo) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod from cod_barra' +
      ' where cod_barra = ' + QuotedStr(pCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    fOldGrupo := buscas.FieldByName('grupo_prod').AsInteger;
    fOldCodigo := buscas.FieldByName('cod_prod').AsString;

    buscas.Close;
    buscas.SQL.Text := 'select grupo_prod, cod_prod, descr_prod, aplicacao_prod, prec_tab_prod,' +
      ' prec_30_prod, num_fab_prod from produtos where grupo_prod = ' + IntToStr(fOldGrupo) +
      ' and cod_prod = ' + QuotedStr(fOldCodigo) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
  end;
  if buscas.IsEmpty then
    Result := 'PRODUTO NÃO ENCONTRADO'
  else
    Result := Trim(buscas.FieldByName('cod_prod').AsString) + ' ' +
      Trim(buscas.FieldByName('descr_prod').AsString) + ' Ref. ' +
      Trim(buscas.FieldByName('aplicacao_prod').AsString);
end;

