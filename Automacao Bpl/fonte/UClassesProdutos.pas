  if dtmProdutos = nil then
    dtmProdutos := TDtmProdutos.Create(dtmProdutos);
  DataSet := TClientDataSet(dtmProdutos.cdsTipoServ);
  transacao := TIBTransaction(dtmProdutos.IBTransTipoServ);
  Buscas := TIBQuery(dtmProdutos.qrBuscasTipoServ);
  TipoTipoServ := TTipoTipoServ.Create(dtmAtivo.bancoHw);
  LocTipoTipoServ := TLocTipoTipoServ.create;
  LocEspecieSeg := TLocEspecieSeg.create;
  LocCFOP := TLocCFOP.create;
  buscas.Close;
  buscas.SQL.Text := 'select USPREVENDA_OS,SEG_PROD_SERV from empresa where ativo=1 and cod_empresa='
    + vDadosIni.codEmpresa;
  buscas.Open;
  UsarPreVendaOS := buscas.FieldByName('USPREVENDA_OS').AsString;
  SegmentarPROD_SERV := buscas.FieldByName('SEG_PROD_SERV').AsString;
  buscas.Close;
  montaSelect('SELECT * FROM TIPO_SERVICO WHERE 1=0');
  codtiposervLC := TTipoServLC.create;
  vUsuario := TUsuario.create;
  vTipoServMecanico := TTipoServMecanico.create;
  vBox := TBox.create;
  vTipoServBox := TTipoServBox.create;
  vTipoServEmpresa := TEmpresasTipoServ.create;
  vEmpresa := TDataSet_OOP.Create;
  vEmpresa.dataSet := TClientDataSet(dtmProdutos.cdsEmpresa);
  vEmpresa.buscas := TIBQuery(dtmProdutos.qrBuscas);
  vEmpresa.transacao := TIBTransaction(dtmProdutos.IBTransTipoServ);
end;

function TTipoServ.delete: boolean;
var
	vtemp: string;
	vListaEmp: TStringList;
	vApagar: boolean;
  vCod_Servico: string;
  vDesc_Servico: string;
  I: Integer;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    vListaEmp := TStringList.Create;
    vListaEmp.Duplicates := dupIgnore;
    vListaEmp.Clear;

    buscas.close;
    buscas.sql.Text := ' select cod_empresa from EMPRESA ' +
     ' where ativo = 1 ';
    buscas.Open;
    buscas.FetchAll;

    buscas.First;
    while not buscas.Eof do
    begin
      vListaEmp.Add(IntToStr(buscas.FieldByName('COD_EMPRESA').AsInteger));

      buscas.Next;
    end;

    try
      vApagar      := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Servico := trim(dataSet.FieldByName('COD_SERVICO').AsString);
      vDesc_Servico:= trim(dataSet.FieldByName('DESC_SERVICO').AsString); 
    
      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar      := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Servico := '';
        vDesc_Servico:= '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Servico) <> '') then
        prepare_loop('COD_SERVICO = ' + vCod_Servico)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente' +
        	vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?' + #13 + #13 +
          'SERVICO' + #13 +
          'Código: ' + vCod_Servico + #13 +
          'Descrição: ' + vDesc_Servico;

        if (trim(vCod_Servico) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente' +
	          vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?';

        if not vDadosIni.PesqPros('BAS017', 'EXCLUIR', '', 'TIPO_SERVICO',
          vDadosIni.IfThen(trim(vCod_Servico) <> '', vCod_Servico, ''), buscas, true) then
            exit;
            
        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira' + 
        	vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?' + #13 + #13 +
          'SERVICO' + #13 +
          'Código: ' + vCod_Servico + #13 +
          'Descrição: ' + vDesc_Servico;

        if (trim(vCod_Servico) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira' +
          	vDadosIni.IfThen(vListaEmp.Count > 1, ' em todas empresas', '') + '?';

        if not vDadosIni.PesqPros('BAS085', 'EXCLUIR', '', 'TIPO_SERVICO',
           vDadosIni.IfThen(trim(vCod_Servico) <> '', vCod_Servico, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo tipo(s) de serviço permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo tipo(s) de serviço para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo tipo(s) de serviço permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo tipo(s) de serviço para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          for I := 0 to vListaEmp.Count - 1 do
          begin
            SqlOpen(' select nped, tipo, cod_empresa from pedvenda_serv ' +
              ' where cod_servico = %d and cod_empresa = %d ',
              [fint('cod_servico'), StrToInt(vListaEmp[I])], buscas);

            if not buscas.IsEmpty then
            begin
              vtemp := 'Tipo de serviço utilizado em vendas' +
                vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' emp ' + vListaEmp[I], '') +
                ', não é possível excluir.' + #13 + #13 +
                'SERVICO' + #13 +
                'Código: ' + IntToStr(dataSet.FieldByName('cod_servico').AsInteger) + #13 +
                'Descrição: ' + dataSet.FieldByName('desc_servico').AsString;

              Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              RollBackTransacao;
              exit;
            end;

            SqlOpen(' select cod_nf, cod_empresa from notafiscal_item ' +
              ' where cod_servico = %d and cod_empresa = %d ',
              [fint('cod_servico'), StrToInt(vListaEmp[I])], buscas);

            if not buscas.IsEmpty then
            begin
              vtemp := 'Tipo de serviço utilizado em nota fiscal' +
                vDadosIni.IfThen(vDadosIni.cod_empresa <> StrToInt(vListaEmp[I]), ' emp ' + vListaEmp[I], '') +
                ', não é possível excluir.' + #13 + #13 +
                'SERVICO' + #13 +
                'Código: ' + IntToStr(dataSet.FieldByName('cod_servico').AsInteger) + #13 +
                'Descrição: ' + dataSet.FieldByName('desc_servico').AsString;

              Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              RollBackTransacao;
              exit;
            end;
          end;

        	SqlExec(' update tipo_servico set ativo = 99 ' +
            ' where cod_servico = %d ',
            [fint('cod_servico')], buscas);
          if (trim(vCod_Servico) = '') then
            vDadosIni.GravaAuditoria('BAS017', 'EXCLUIR', '', 'TIPO_SERVICO',
              dataSet.FieldByName('COD_SERVICO').AsString, buscas);
        end
        else
        begin
          SqlExec(' update tipo_servico set ativo = 0 ' +
            ' where cod_servico = %d ',
            [fint('cod_servico')], buscas);

          if (trim(vCod_Servico) = '') then
            vDadosIni.GravaAuditoria('BAS085', 'EXCLUIR', '', 'TIPO_SERVICO',
              dataSet.FieldByName('COD_SERVICO').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS017', 'BAS085'),
        'EXCLUIR', 'SUCESSO', 'TIPO_SERVICO',
        vDadosIni.IfThen(trim(vCod_Servico) <> '', vCod_Servico, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS017', 'BAS085'),
        'EXCLUIR', 'FALHA', 'TIPO_SERVICO',
        vDadosIni.IfThen(trim(vCod_Servico) <> '', vCod_Servico, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

