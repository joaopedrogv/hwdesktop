procedure TKitsProdutos.CadKits(TipoForm: integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Kits');
    vDadosIni.vTipoForm := TipoForm;

    if DtmProdutos = nil then
      DtmProdutos := TDtmProdutos.Create(DtmProdutos);

    if FrmCadKits = nil then
    begin
      if TipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TFrmCadKits, FrmCadKits);
    end;

    if (TipoForm > 0) and (not FrmCadKits.Visible) then
      FrmCadKits.ShowModal
    else if (not FrmCadKits.Visible) then
      FrmCadKits.Show
    else if FrmCadKits.FormStyle = fsMDIChild then
      FrmCadKits.Show
    else
      FrmCadKits.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

