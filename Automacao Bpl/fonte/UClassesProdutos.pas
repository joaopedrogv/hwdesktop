        + MB_ICONERROR + MB_DEFBUTTON1)
    end;
  end;
end;

function TPerfilProduto.post: boolean;
var
  statusDataset: string;
begin
  try
    Result := false;
    if dataSet.State = dsEdit then
      statusDataset := 'E'
    else
      statusDataset := 'I';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('DESCR_PERFIL').AsString) = '' then
      raise exception.create('Descrição do perfil do produto não informada!');

    Result := inherited post;
    if not result then
    begin
      Application.MessageBox('Erro ao gravar registro.', 'Aviso', MB_OK + MB_ICONQUESTION +
        MB_DEFBUTTON1);
      exit;
    end;
    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;
    if Apply then
    begin
      if CommitaTransacao then
      begin
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO132', 'ALTERAÇÃO CONFIRMADA', 'SUCESSO', 'PERFIL_PRODUTOS',
            dataSet.FieldByName('COD_PERFIL').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO132', 'ALTEREÇÃO CONFIRMADA ' +
//            dataSet.FieldByName('COD_PERFIL').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO CONFIRMADA', 'SUCESSO', 'PERFIL_PRODUTOS',
            dataSet.FieldByName('COD_PERFIL').AsString, buscas);
        //          vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO CONFIRMADA ' +
        //            dataSet.FieldByName('COD_PERFIL').asstring, buscas);
      end
      else
      begin
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('PRO132', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA',
            'PERFIL_PRODUTOS',
            dataSet.FieldByName('COD_PERFIL').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO132', 'ALTEREÇÃO NÃO CONFIRMADA ' +
//            dataSet.FieldByName('COD_PERFIL').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO NÃO CONFIRMADA', 'FALHA',
            'PERFIL_PRODUTOS',
            dataSet.FieldByName('COD_PERFIL').AsString, buscas)
            //          vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO NÃO CONFIRMADA ' +
//            dataSet.FieldByName('COD_PERFIL').asstring, buscas);
      end;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      if statusDataset = 'E' then
        vDadosIni.GravaAuditoria('PRO132', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA',
          'PERFIL_PRODUTOS',
          dataSet.FieldByName('COD_PERFIL').AsString, buscas)
          //        vDadosIni.GravaAuditoria('PRO132', 'ALTEREÇÃO NÃO CONFIRMADA ' +
//          dataSet.FieldByName('COD_PERFIL').asstring, buscas)
      else if statusDataset = 'I' then
        vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO NÃO CONFIRMADA', 'FALHA', 'PERFIL_PRODUTOS',
          dataSet.FieldByName('COD_PERFIL').AsString, buscas)
          //        vDadosIni.GravaAuditoria('PRO132', 'INCLUSÃO NÃO CONFIRMADA ' +
//          dataSet.FieldByName('COD_PERFIL').asstring, buscas);
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

