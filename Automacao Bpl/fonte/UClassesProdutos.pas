procedure TBalancoProduto._AbreEstoqueDiferente(GrupoIni, GrupoFim: string);
var
  GrupoInfo: string;
  vsomcons: string;
begin
  GrupoInfo := '';
  if (GrupoIni <> '') then
  begin
    GrupoInfo := ' and pr.grupo_prod >= ' +
      GrupoIni + ' and pr.grupo_prod <= ' + GrupoFim;
  end;

  if vsomenteconsumo then
    vsomcons := 'N'
  else
    vsomcons := 'S';

  qrDiferenca.close;
  qrDiferenca.sql.text := 'select pr.grupo_prod,pr.cod_prod,pr.descr_prod,pr.est_f,bl.qtde_prod,' +
    'pr.num_fab_prod,pr.locacao_prod,pr.prec_cusm_prod,pr.prec_cus_prod from balanco_produtos bl,produtos pr ' +
    'where bl.grupo_prod = pr.grupo_prod and bl.cod_prod = pr.cod_prod and ' +
    'bl.cod_empresa = pr.cod_empresa and pr.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and (coalesce(pr.consumo, ''N'') <> ' + QuotedStr(vsomcons) + ')' + GrupoInfo +
    ' order by pr.' + _vOrdem;
  qrDiferenca.open;

end;

procedure TBalancoProduto._AbreNaoContados(GrupoIni, GrupoFim: string);
var
  GrupoInfo: string;
  vsomcons: string;
begin

  if (GrupoIni <> '') then
  begin
    GrupoInfo := ' and pr.grupo_prod >= ' +
      GrupoIni + ' and pr.grupo_prod <= ' + GrupoFim;
  end;
  if vsomenteconsumo then
    vsomcons := 'N'
  else
    vsomcons := 'S';

  QrZerados.close;
  QrZerados.sql.text :=
    'select pr.grupo_prod,pr.cod_prod,pr.descr_prod,pr.est_f,bl.cod_prod,pr.num_fab_prod,' +
    ' pr.locacao_prod,pr.prec_cusm_prod,pr.prec_cus_prod from balanco_produtos bl right join produtos pr on ' +
    ' pr.grupo_prod = bl.grupo_prod and pr.cod_prod = bl.cod_prod and ' +
    ' pr.cod_empresa = bl.cod_empresa ' +
    ' where (coalesce(pr.consumo, ''N'') <> ' + QuotedStr(vsomcons) + ') and pr.est_f > 0 and pr.cod_empresa = '
    + vDadosIni.codEmpresa + ' and bl.cod_prod is null ' + GrupoInfo +
    ' order by pr.' + _vOrdem;
  QrZerados.open;
  //vDadosIni.ModImp();

end;

function TBalancoProduto._AbreProduto(GrupoProd: string; CodProd: string; CodBarra: string): boolean;
begin
	vPesqDescrProd := false;
	if (trim(GrupoProd) <> '') or (trim(CodProd) <> '') then
    Result := montaSelect(' select distinct pr.grupo_prod, pr.cod_prod, pr.cod_empresa, ' +
      ' pr.num_fab_prod, pr.descr_prod, pr.descr_prod_red, pr.prec_cusm_prod, pr.prec_tab_prod, pr.prec_publico, pr.nbm, ' +
      ' pr.cst_prod, pr.icm_prod, pr.codigo_nop, pr.marca_p, pr.unidade, pr.em_promocao, ' +
      ' pr.preco_promocao, pr.prec_30_prod, pr.prec_60_prod, pr.prec_90_prod,' +
      ' pr.est_f, pr.locacao_prod, pr.locacao_prod_1, ' +              
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
   	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
      ' inner join cod_barra cdb on cdb.grupo_prod = pr.grupo_prod and cdb.cod_prod = pr.cod_prod and cdb.cod_empresa = pr.cod_empresa  ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where cdb.cod_barra = ' + QuotedStr(trim(CodBarra)) +
      ' and cdb.grupo_prod = ' + GrupoProd +
      ' and cdb.cod_prod = ' + QuotedStr(CodProd) +
      ' and cdb.cod_empresa =' + vDadosIni.codEmpresa +
      ' and pr.ativo = 1 ' +
      ' and cdb.ativo = 1 ')
  else
    Result := montaSelect(' select distinct pr.grupo_prod, pr.cod_prod, pr.cod_empresa, ' +
      ' pr.num_fab_prod, pr.descr_prod, pr.descr_prod_red, pr.prec_cusm_prod, pr.prec_tab_prod, pr.prec_publico, pr.nbm, ' +
      ' pr.cst_prod, pr.icm_prod, pr.codigo_nop, pr.marca_p, pr.unidade, pr.em_promocao, ' +
      ' pr.preco_promocao, pr.prec_30_prod, pr.prec_60_prod, pr.prec_90_prod,' +
      ' pr.est_f, pr.locacao_prod, pr.locacao_prod_1, ' +
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
   	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
      ' inner join cod_barra cdb on cdb.grupo_prod = pr.grupo_prod and cdb.cod_prod = pr.cod_prod and cdb.cod_empresa = pr.cod_empresa  ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where cdb.cod_barra = ' + QuotedStr(trim(CodBarra)) +
      ' and cdb.cod_empresa =' + vDadosIni.codEmpresa +
      ' and pr.ativo = 1 ' +
      ' and cdb.ativo = 1 ');

  if not Result then
    raise Exception.Create('Erro ao selecionar produtos');

  if dataSet.IsEmpty then
  begin
    Result := montaSelect(' select distinct pr.grupo_prod, pr.cod_prod, pr.cod_empresa, ' +
      ' pr.num_fab_prod, pr.descr_prod, pr.descr_prod_red, pr.prec_cusm_prod, pr.prec_tab_prod, pr.prec_publico, pr.nbm, ' +
      ' pr.cst_prod, pr.icm_prod, pr.codigo_nop, pr.marca_p, pr.unidade, pr.em_promocao, ' +
      ' pr.preco_promocao, pr.prec_30_prod, pr.prec_60_prod, pr.prec_90_prod,' +
      ' pr.est_f, pr.locacao_prod, pr.locacao_prod_1, ' +              
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
   	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos pr ' +
	    ' inner join cod_barra cdb on cdb.grupo_prod = pr.grupo_prod and cdb.cod_prod = pr.cod_prod and cdb.cod_empresa = pr.cod_empresa  ' +
      ' left join getestoquedisponivel(pr.grupo_prod, pr.cod_prod, 0, pr.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
  	  ' where pr.descr_prod like ' + QuotedStr(CodBarra + '%') +
    	' and pr.cod_empresa =' + vDadosIni.codEmpresa +
   		' and pr.ativo = 1 ' +
   	  ' and cdb.ativo = 1 ' +
      ' order by pr.descr_prod ');

    if not dataSet.IsEmpty then
    	vPesqDescrProd := true;
  end;

  if not dataSet.IsEmpty then
    if dataSet.RecordCount > 1 then
    begin
  		TFloatField(dataSet.FieldByName('PREC_TAB_PROD')).currency := True;
      TFloatField(dataSet.FieldByName('PREC_PUBLICO')).currency := True;
      TFloatField(dataSet.FieldByName('PRECO_PROMOCAO')).currency := True;
      TFloatField(dataSet.FieldByName('PREC_30_PROD')).currency := True;
      TFloatField(dataSet.FieldByName('PREC_60_PROD')).currency := True;
      TFloatField(dataSet.FieldByName('PREC_90_PROD')).currency := True;
      TFloatField(dataSet.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
      TFloatField(dataSet.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
      if not vDadosIni._abreFormEscolhaProdutosIni(dataSet) then
      begin
        Result := false;
        exit;
      end;
    end;

  Result := not dataSet.isEmpty;
end;

function TBalancoProduto._AbreProdutoRel(CodBarra: string): boolean;
begin
  qrProdutosRel.close;
  qrProdutosRel.sql.text := ' select * from produtos ' +
    ' where num_fab_prod = ' + QuotedStr(trim(CodBarra)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  qrProdutosRel.open;

  Result := not qrProdutosRel.isEmpty;
end;

procedure TBalancoProduto._AbreSomasProd;
begin
  qrSomasProd.close;
  qrSomasProd.sql.text := 'select pr.sub_g_prod,sbg.descricao, ' +
    ' sum(bl.qtde_prod*pr.prec_cus_prod), ' +
    ' sum(bl.qtde_prod*pr.prec_cusr_prod) as sum_1,sum(bl.qtde_prod*pr.prec_tab_prod) as sum_2, ' +
    ' sum(bl.qtde_prod*pr.prec_cusm_prod) as sum_3 ' +
    ' from balanco_produtos bl,produtos pr,sub_grupo sbg where ' +
    ' bl.grupo_prod = pr.grupo_prod and bl.cod_prod = pr.cod_prod and ' +
    ' coalesce(pr.sub_g_prod,0) = sbg.codigo_subgr ' +
    ' and bl.cod_empresa = pr.cod_empresa and pr.cod_empresa = ' + vDadosIni.codEmpresa +
    ' group by pr.sub_g_prod,sbg.descricao';
  qrSomasProd.open;
end;

