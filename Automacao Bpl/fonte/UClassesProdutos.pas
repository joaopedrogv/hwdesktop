function TGradeEstoque.confirmaConfereQtde(prod: TProdutos): boolean;
var
  vrEstGr, vrEstProd: Double;
  i:integer;
begin
  try
    Result := false;
    if dataSet.State in [dsEdit, dsInsert] then
      if not Post then
        Exit;
    dataSet.OnReconcileError := renconciliaErro;
    if not dataset.IsEmpty then
    begin
      vrEstGr := 0;
      dataSet.First;
      while not dataSet.Eof do
      begin
        vrEstGr := vrEstGr + dataSet.FieldByName('qtde').AsFloat;
        dataSet.Next;
      end;
      try
        vrEstProd := prod.dataSet.FieldByName('est_f').AsFloat +
          prod.dataSet.FieldByName('est_r').AsFloat;
        if (vrEstProd) > vrEstGr then
          raise exception.create('Valor do estoque maior que a grade informada. Diferença de ' +
            FloatToStr(vrEstProd - vrEstGr))
        else if (vrEstProd) < vrEstGr then
          raise exception.create('Valor do estoque menor que a grade informada. Diferença de ' +
            FloatToStr(vrEstProd - vrEstGr));
      except
        on e: exception do
        begin
          Result := false;
          Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION +
            MB_OK);
          exit;
        end;
      end;
    end;
    if dataSet.ChangeCount = 0 then
    begin
      fOldGrupo := prod.dataSet.FieldByName('grupo_prod').AsInteger;
      fOldCodigo := prod.dataSet.FieldByName('cod_prod').AsString;
      replicaGradeEstoque;
      Result := true;
      Exit;
    end;

    if dataSet.ApplyUpdates(-1) = 0 then
    begin
      fOldGrupo := prod.dataSet.FieldByName('grupo_prod').AsInteger;
      fOldCodigo := prod.dataSet.FieldByName('cod_prod').AsString;
      Result := CommitaTransacao;
      if Result then
      begin
        if prod.alterarEstProd_Grade then
        begin
          vDadosIni.GravaAuditoria('PRO092', 'TRANSACAO CONFIRMADA', 'SUCESSO', 'PRODUTOS',
                prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
                prod.dataSet.FieldByName('COD_PROD').AsString, buscas);
          vMD5Func._gravaMD5_Produtos(buscas, prod.dataSet.FieldByName('grupo_prod').AsInteger,
                prod.dataSet.FieldByName('cod_prod').AsString);
        end;
        for I := 0 to vRelacaoAltGrades.Count - 1 do
            vDadosIni.GravaAuditoria('PRO090', 'TRANSACAO CONFIRMADA', vRelacaoAltGrades.Strings[i]+'  SUCESSO', 'COD_GRADE_PROD',
                '', buscas);
        replicaGradeEstoque;
      end else begin
         vDadosIni.GravaAuditoria('PRO092', 'TRANSACAO CONFIRMADA', 'FALHA', 'PRODUTOS',
                prod.dataSet.FieldByName('GRUPO_PROD').AsString + '-' +
                prod.dataSet.FieldByName('COD_PROD').AsString, buscas);
      end;
    end
    else
      Result := false;
  finally
    dataSet.OnReconcileError := nil;
  end;
end;

constructor TGradeEstoque.create;
begin
