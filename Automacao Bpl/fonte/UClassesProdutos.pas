function TUnidadeProd.Delete: Boolean;
begin
	Result := False;
  if dataSet.IsEmpty then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir esse unidade?',
  	'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

  if SqlOpen(' select count(*) as contador from produtos ' +
  	' where upper(unidade) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo usado em %d produtos.' + #13 + #13 +
    	'Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  if SqlOpen(' select first 1 nped from pedvenda_prod ' +
		' where upper(unidade) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('nped').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em vendas.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

  if SqlOpen(' select first 1 nped from pedvenda_prod ' +
		' where upper(unidade_conv) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('nped').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em vendas.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

	if SqlOpen(' select first 1 cod_nfce from nfce_item ' +
		' where upper(ucom) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('cod_nfce').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em NFCe.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

  if SqlOpen(' select first 1 cod_nfce from nfce_item ' +
		' where upper(uvnd) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('cod_nfce').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em NFCe.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

	if SqlOpen(' select first 1 cod_nf from notafiscal_item ' +
		' where upper(unidade_nf) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('cod_nf').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em Nota Fiscal.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

  if SqlOpen(' select first 1 cod_nf from notafiscal_item ' +
		' where upper(referencia) = %s ',
    [UpperCase(trim(fstrq('sigla')))]).FieldByName('cod_nf').AsInteger > 0 then
  begin
    ShowErro('Unidade está sendo utilizada em Nota Fiscal.' + #13 + #13 +
    	'Não é permitido excluir');
    Exit;
  end;

  dataSet.Delete;
  if Apply then
  begin
    CommitaTransacao;
    Auditor.Sucesso.Salvar.GravarMensagem('');
    Refresh;
    Result := True;
  end
  else
  begin
    RollBackTransacao;
    Auditor.Falha.Salvar.GravarMensagem('');
    Result := False;
  end;
end;

function TUnidadeProd.Post: Boolean;
var
  vsigla: string;
begin
	Result := False;
  vsigla := '';
  try
  	if fempty('sigla') then
      raiseExceptionCreate('Sigla deve ser preenchida');
    if fempty('descricao') then
      raiseExceptionCreate('Descricao deve ser preenchida');

    if dataSet.State = dsInsert then
      if not SqlOpen(' select descricao from unidades ' +
                     ' where sigla = %s ',
                     [fstrq('sigla')]).IsEmpty then
        raiseExceptionCreate('Já existe uma unidade com esta sigla');

    vsigla := fstr('sigla');
    if inherited Post then
    begin
      Result := Apply;
      CommitaTransacao;
      with Auditor.Salvar.Sucesso do
      begin
      	SetChave(Trim(vsigla));
      	GravarMensagem(fstr('sigla'));
      end;
      Refresh;
    end
    else
    begin
      Result := False;
      RollBackTransacao;
      with Auditor.Salvar.Falha do
      begin
      	SetChave(Trim(vsigla));
      	GravarMensagem(fstr('sigla'));
      end;
    end;

  except on E: Exception do
    begin
      RollBackTransacao;
      Auditor.Salvar.Falha.GravarMensagem(fstr('descricao'));
      registraErro('TUnidadeProd.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);
    end;
  end;
end;

