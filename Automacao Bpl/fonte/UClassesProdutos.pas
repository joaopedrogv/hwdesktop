function TProdutos._produtosSemCodigo: boolean;
var
  I: Integer;
  vRepliEmp: TStringList;
begin
	try
    Result := true;
    vRepliEmp := TStringList.Create;
    vRepliEmp.Duplicates := dupIgnore;
    vRepliEmp.Clear;
    try
    	dataSet.DisableControls;
      vDadosIni.abreStatusProcessamento('', 'Aguarde.');

      if dataSet.RecordCount > 0 then
      	storeRecNo;

      buscas.close;
      buscas.sql.Text := ' select cod_empresa, ' +
    		' coalesce(emp_repl_interna, ' + vDadosIni.codEmpresa + ') emp_repl_interna from EMPRESA ' +
      	' where ativo = 1 and COD_EMPRESA <> ' + vDadosIni.codEmpresa;
      buscas.Open;
      buscas.FetchAll;

      vRepliEmp.Add(vDadosIni.codEmpresa);

      buscas.First;
      while not buscas.Eof do
      begin
      	if buscas.FieldByName('EMP_REPL_INTERNA').AsInteger = StrToInt(vDadosIni.codEmpresa) then
	        vRepliEmp.Add(buscas.FieldByName('cod_empresa').AsString);
          
        buscas.Next;
      end;

      dataSet.First;
      while not dataSet.Eof do
      begin
      	if dataSet.FieldByName('grupo_prod').AsInteger <= 0 then
          for I := 0 to vRepliEmp.Count - 1 do
          begin
//            buscas.Close;
//            buscas.SQL.Text := ' delete from estoque_diario ' +
//              ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
//              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
//              ' and cod_empresa = ' + vRepliEmp[I];
//            buscas.ExecSQL;
//
//            buscas.Close;
//            buscas.SQL.Text := ' delete from produtos ' +
//              ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
//              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
//              ' and cod_empresa = ' + vRepliEmp[I];
//            buscas.ExecSQL;

            buscas.Close;
            buscas.SQL.Text := ' update produtos set ativo = 99, rep_int_active = 1 ' +
              ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vRepliEmp[I];
            buscas.ExecSQL;

            buscas.Close;
            buscas.SQL.Text := ' update cod_barra set ativo = 99 ' +
              ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vRepliEmp[I];
            buscas.ExecSQL;
          end;
          
        dataSet.Next;
      end;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;
    finally
    	if dataSet.RecordCount > 0 then
      	restoreRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('Erro ao remover produtos sem grupo. Erro: ' + e.Message + ' SQL: ' + buscas.SQL.Text);
      Application.MessageBox(PChar('Erro ao remover produtos sem grupo. Erro: ' + e.Message+ ' SQL: ' + buscas.SQL.Text), 'Atenção', 0 + 64);
    end;
  end;
end;

function TProdutos.PesquisaAdicional(comEstoque: boolean; valorConsultaDtIni,
  valorConsultaDtFim, Campo, condicao, classe_prod, clinv, clpreco, clpop,
  clqtv, clfrv, clatl: string): string;
var
  sql, tipo, formatodata: string;
  i: integer;
begin
  sql := '';
  if comEstoque then
    sql := ' and PRODUTOS.est_f > 0';
  if classe_prod <> '' then
    sql := sql + ' and PRODUTOS.classe_prod =' + quotedstr(classe_prod);
  if clinv <> '' then
    sql := sql + ' and PRODUTOS.clinv =' + quotedstr(clinv);
  if clpreco <> '' then
    sql := sql + ' and PRODUTOS.clpreco =' + quotedstr(clpreco);
  if clpop <> '' then
    sql := sql + ' and PRODUTOS.clpop =' + quotedstr(clpop);
  if clqtv <> '' then
    sql := sql + ' and PRODUTOS.clqtv =' + quotedstr(clqtv);
  if clfrv <> '' then
    sql := sql + ' and PRODUTOS.clfrv =' + quotedstr(clfrv);
  if clatl <> '' then
    sql := sql + ' and PRODUTOS.clatl =' + quotedstr(clatl);
  if condicao = 'Igual' then
    condicao := '='
  else if condicao = 'Maior' then
    condicao := '>'
  else if condicao = 'Menor' then
    condicao := '<'
  else if condicao = 'Diferente' then
    condicao := '<>'
  else if (condicao = 'Esta contido') then
    condicao := 'like'
  else if (condicao = 'Começa') then
    condicao := 'Começa'
  else
    condicao := '=';
  for I := 0 to DataSet.FieldCount - 1 do
  begin
    if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(Campo) then
    begin
      Campo := DataSet.Fields[I].FieldName;
      if (Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
        (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField) then
        tipo := 'F'
      else if DataSet.Fields[i] is TStringField then
        tipo := 'S'
      else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
        tipo := 'D'
      else
        tipo := 'I';
      break;
    end;
  end;

  if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
    formatodata := 'mm/dd/yyyy'
  else if pos('.', ShortDateFormat) <> 0 then
    formatodata := 'dd.mm.yyyy';

  if valorConsultaDtIni <> '' then
    valorConsultaDtIni := QuotedStr(FormatDateTime(formatodata, strtodate(valorConsultaDtIni)));
  if valorConsultaDtFim <> '' then
    valorConsultaDtFim := QuotedStr(FormatDateTime(formatodata, strtodate(valorConsultaDtFim)));

  if trim(valorConsultaDtIni) <> '' then
  begin
    sql := sql + ' and PRODUTOS' + '.' + Campo + ' >= ' + valorConsultaDtIni +
    	' and PRODUTOS' + '.' + Campo + ' <= ' + valorConsultaDtFim;
  end;
  if trim(sql) <> '' then
    result := sql
  else
    result := '';
end;

