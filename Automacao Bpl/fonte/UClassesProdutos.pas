function TReceitasAssociadas.delete: boolean;
var
  temp: string;
begin
  temp := retornaValor('select first 1 (grupo_prod||''-''||cod_prod) as valor from' +
    ' produtos where cod_receita = ' + dataSet.FieldByName('cod_receita').AsString);
  if temp <> '' then
  begin
    Application.MessageBox(pchar('Receita associada ao produto Grupo-Código = ' + temp),
      'Atenção', MB_ICONWARNING + MB_OK);
    exit;
  end;
  inherited Delete;
  if Apply then
    CommitaTransacao;
end;

function TReceitasAssociadas.post: boolean;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.FieldByName('descricao').AsString = '' then
      raise exception.create('Descrição precisa ser preenchida');
    if (dataSet.State in [dsInsert]) then
      dataSet.FieldByName('cod_receita').AsInteger := Gencodigo('REC_ASS',
        DtmProdutos.spIncCodREcASS, '0');

    dataSet.FieldByName('TIPO_UTIL').AsString := 'B';
    Result := inherited post;
    if Apply then
      CommitaTransacao;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TReceitasAssociadas.utilizar(prod: Tprodutos; darPost: boolean): boolean;
begin
  if dataSet.IsEmpty then
    exit;
  prod.Edit;
  if prod.dataset.state in [dsInsert, dsEdit] then
  begin
    prod.dataSet.FieldByName('cod_receita').AsInteger :=
      dataSet.FieldByName('cod_receita').AsInteger;
    if darPost then
    begin
      prod.dataSet.Post;
      if prod.Apply then
        prod.CommitaTransacao;
    end;
    result := true;
  end;
end;

