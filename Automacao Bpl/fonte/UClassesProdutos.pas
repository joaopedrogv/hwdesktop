function abreFormImagensProduto(pDescProd, grupoProd, codProd, numFabProd: string; PrecTab, PrecPub: Double; AUseQueryIni: Boolean = False): boolean;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo fotos do produto');
    Application.CreateForm(TfrmFotosProdutos, frmFotosProdutos);
    frmFotosProdutos.Label1.Caption := pDescProd;
    frmFotosProdutos.Label2.Caption := grupoProd;
    frmFotosProdutos.Label3.Caption := codProd;
    frmFotosProdutos.Label4.Caption := numFabProd;
    frmFotosProdutos.Label5.Caption := Format('%8.2n', [PrecTab]);
    frmFotosProdutos.Label6.Caption := Format('%8.2n', [PrecPub]);
    vDadosIni.vPesquisa := 'LISTA_IMAGENS||';
    if AUseQueryIni then
    begin
      frmFotosProdutos.buscas.Database := vDadosIni.vQueryTmp.Database;
      frmFotosProdutos.buscas.Transaction := vDadosIni.vQueryTmp.Transaction;
    end;
    frmFotosProdutos.ShowModal;
  finally
    vDadosIni.vPesquisa := '';
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure produtos_replicacao_interna(AGrupoProd: Integer; ACodProd: string; AUseTransactionIni: Boolean = False);
var
  AProdutos: TProdutos;
  ABuscas: TIBQuery;
begin
  if DtmProdutos = nil then
    DtmProdutos := TDtmProdutos.Create(DtmProdutos);
  AProdutos := TProdutos.createForRepli;
  ABuscas   := TIBQuery.Create(AProdutos.buscas);
  ABuscas.Database := AProdutos.buscas.Database;
  ABuscas.Transaction := AProdutos.buscas.Transaction;
  try
    AProdutos.buscas                   := ABuscas;
    if AUseTransactionIni then
    begin
      AProdutos.transacao                := vDadosIni.vTransactionTmp;
      AProdutos.buscas.Transaction       := AProdutos.transacao;
      AProdutos._queryOOP.Transaction    := AProdutos.transacao;
      AProdutos.RepliProdutos.transacao  := AProdutos.transacao;
      AProdutos.RepliProdutos.buscas     := AProdutos.buscas;
      AProdutos.RepliCodBarras.transacao := AProdutos.transacao;
      AProdutos.RepliCodBarras.buscas    := AProdutos.buscas
    end;

    AProdutos.dataSet.Close;
    AProdutos.dataSet.CommandText := ' SELECT PRODUTOS.*, CAST(0 AS FLOAT) ESTOQUE, CAST(0 AS FLOAT) EST_PRIMA FROM PRODUTOS ' +
    	' WHERE PRODUTOS.GRUPO_PROD = ' + IntToStr(AGrupoProd) +
      ' AND PRODUTOS.COD_PROD = ' + QuotedStr(ACodProd) +
      ' AND PRODUTOS.COD_EMPRESA = ' + vDadosIni.codEmpresa;
    AProdutos.dataSet.Open;

    AProdutos.oldGrupoProd := AProdutos.dataSet.FieldByName('GRUPO_PROD').AsString;
    AProdutos.oldCodProd := AProdutos.dataSet.FieldByName('COD_PROD').AsString;
    AProdutos.oldNumFabProd := AProdutos.dataSet.FieldByName('NUM_FAB_PROD').AsString;
    try
      if not AProdutos.RepliProdutos.ReplicaProdutos2(AProdutos, 'I') then
      begin
        if not AUseTransactionIni then
          AProdutos.RollBackTransacao;
        Application.MessageBox('Erro ao replicar dados do produto para as outras empresas' +
         chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
         MB_ICONERROR + MB_DEFBUTTON1);
      end
      else if not AUseTransactionIni then
        AProdutos.CommitaTransacao;
      if not AProdutos.RepliCodBarras.ReplicaCodBarras2(AProdutos, 'I') then
      begin
        if not AUseTransactionIni then
          AProdutos.RollBackTransacao;
        Application.MessageBox('Erro ao replicar dados do produto para as outras empresas' +
          chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
          MB_ICONERROR + MB_DEFBUTTON1);
      end
      else if not AUseTransactionIni then
        AProdutos.CommitaTransacao;

    finally
      AProdutos.Close;
    end;
  finally
    if AUseTransactionIni then
      AProdutos._queryOOP.Transaction := dtmProdutos.IBTransProdutos;
  end;
end;

function produtos_vincularProdutoCadXML(chavenfe: string): boolean;
var
  AProdutos: TProdutos;
  ABuscas: TIBQuery;
begin
	try
    if DtmProdutos = nil then
      DtmProdutos := TDtmProdutos.Create(DtmProdutos);
    AProdutos := TProdutos.create;
    ABuscas   := TIBQuery.Create(AProdutos.buscas);
    ABuscas.Database := AProdutos.buscas.Database;
    ABuscas.Transaction := AProdutos.buscas.Transaction;

//    if not vDadosIni._mdiAberto('TFrmCadProdutos',
//    	'Cadastro do produto ja esta aberto, feche o cadastro para cadastrar o produto pelo XML') then
//      exit;
    if Assigned(FrmCadProdutos) then
    	FreeAndNil(FrmCadProdutos);
      
    ABuscas.Close;
    ABuscas.SQL.Text := 'SELECT GRUPO_PROD, COD_PROD, COD_EMPRESA FROM PRODUTOS ' +
    	' WHERE ATIVO <> 99 ' +
      ' AND CHAVE_NFE = ' + QuotedStr(chavenfe) +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    ABuscas.Open;

    if ABuscas.IsEmpty then
    	exit;

    vDadosIni.vPesquisaChaveNF := chavenfe;
    AProdutos.CadProdutos(4);
  finally
    vDadosIni.vPesquisaChaveNF := '';
    vDadosIni.fechaStatusProcessamento;
  end;
end;

