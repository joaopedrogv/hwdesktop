function TCadCategorias.Delete: boolean;
var
  vCodFormula: string;
  vCodCategoria: string;
  vNomeCategoria: string;
  vtemp: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  try
    vCodCategoria := dataSet.FieldByName('COD_CATEGORIA').AsString;
    vNomeCategoria := dataSet.FieldByName('DESCRICAO').AsString;
    prepare_loop('Sel = ''S''');
    if not dataset.IsEmpty then
    begin
      vCodCategoria   := '';
      vNomeCategoria  := '';
    end;
  finally
    prepare_loop_done;
  end;

  try
    if (trim(vCodCategoria) <> '') then
      prepare_loop('COD_CATEGORIA = ' + vCodCategoria)
    else
      prepare_loop('Sel = ''S''');

    dataset.First;
    while not dataset.Eof do
    begin
    	buscas.Close;
      buscas.SQL.Text := ' select first 1 ' +
        ' produtos_ec.grupo_prod, ' +
        ' produtos_ec.cod_prod, ' +
        ' produtos.num_fab_prod, ' +
        ' produtos.descr_prod, ' +
        ' produtos_ec.cod_categoria from produtos_ec ' +
        ' inner join produtos on produtos.grupo_prod = produtos_ec.grupo_prod ' +
        '		and produtos.cod_prod = produtos_ec.cod_prod ' +
        '		and produtos.cod_empresa = produtos_ec.cod_empresa ' +
        ' where produtos_ec.cod_categoria = ' + IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger) +
        ' and produtos_ec.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        Application.MessageBox(PChar('A categoria não pode ser excluída pois está vinculado a um ou mais produtos:' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) + #13 +
          'Cod Prod: ' + trim(buscas.FieldByName('COD_PROD').AsString) + #13 +
          'Num Fabricante: ' + trim(buscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
          'Descrição: ' + trim(buscas.FieldByName('DESCR_PROD').AsString)),
          'Atenção', 0 + 64);
        Exit;
      end;

      buscas.Close;
      buscas.SQL.Text := ' select first 1 ' +
        ' produtos_categoria.grupo_prod, ' +
        ' produtos_categoria.cod_prod, ' +
        ' produtos.num_fab_prod, ' +
        ' produtos.descr_prod, ' +
        ' produtos_categoria.cod_categoria from produtos_categoria ' +
        ' inner join produtos on produtos.grupo_prod = produtos_categoria.grupo_prod ' +
        '		and produtos.cod_prod = produtos_categoria.cod_prod ' +
        '		and produtos.cod_empresa = produtos_categoria.cod_empresa ' +
        ' where produtos_categoria.cod_categoria = ' + IntToStr(dataSet.FieldByName('COD_CATEGORIA').AsInteger) +
        ' and produtos_categoria.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        Application.MessageBox(PChar('A categoria não pode ser excluída pois está vinculado a um ou mais produtos:' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + IntToStr(buscas.FieldByName('GRUPO_PROD').AsInteger) + #13 +
          'Cod Prod: ' + trim(buscas.FieldByName('COD_PROD').AsString) + #13 +
          'Num Fabricante: ' + trim(buscas.FieldByName('NUM_FAB_PROD').AsString) + #13 +
          'Descrição: ' + trim(buscas.FieldByName('DESCR_PROD').AsString)),
          'Atenção', 0 + 64);
        Exit;
      end;

    	dataset.Next;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
    prepare_loop_done;
  end;

  try
    if (trim(vCodCategoria) <> '') then
      prepare_loop('COD_CATEGORIA = ' + vCodCategoria)
    else
      prepare_loop('Sel = ''S''');

    vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
      'CATEGORIA' + #13 +
      'Código: ' + vCodCategoria + #13 +
      'Descrição: ' + vNomeCategoria;

    if (trim(vCodCategoria) = '') then
      vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

    if not vDadosIni.PesqPros('BAS416', 'EXCLUIR', '', 'CATEGORIA',
      vDadosIni.IfThen(trim(vCodCategoria) <> '', vCodCategoria, ''), buscas, false) then
      exit;

    if Application.MessageBox(PChar(vtemp),
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
      exit;

    vDadosIni.abreStatusProcessamento('', 'Excluíndo categoria(s) permanentemente');

    dataset.First;
    while not dataset.Eof do
    begin
      vDadosIni.abreStatusProcessamento('', 'Excluíndo categoria(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

      SqlExec(' delete from categoria ' +
        ' where cod_categoria = %d and cod_empresa = %d ',
        [fint('cod_categoria'), fint('cod_empresa')], buscas);

      if (trim(vCodCategoria) = '') then
        vDadosIni.GravaAuditoria('BAS416', 'EXCLUIR', '', 'CATEGORIA',
          dataSet.FieldByName('COD_CATEGORIA').AsString, buscas);

      dataset.Next;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
    prepare_loop_done;
  end;
  Result := CommitaTransacao;

  if Result then
  begin
    vDadosIni.GravaAuditoria('BAS416', 'EXCLUIR', 'SUCESSO', 'CATEGORIA',
      vDadosIni.IfThen(trim(vCodCategoria) <> '', vCodCategoria, ''), buscas);
  end
  else
  begin
    RollBackTransacao;
    vDadosIni.GravaAuditoria('BAS416', 'EXCLUIR', 'FALHA', 'CATEGORIA',
      vDadosIni.IfThen(trim(vCodCategoria) <> '', vCodCategoria, ''), buscas);
  end;

  if Result then
    Refresh;
end;

