            dataSet.FieldByName('PREC_60_PROD').AsFloat := buscas.FieldByName('PREC_60_PROD').AsFloat;
            dataSet.FieldByName('PREC_90_PROD').AsFloat := buscas.FieldByName('PREC_90_PROD').AsFloat;
            dataSet.FieldByName('PREC_PUBLICO').AsFloat := buscas.FieldByName('PREC_PUBLICO').AsFloat;
            dataSet.FieldByName('PERC_AD_30').AsFloat := buscas.FieldByName('PERC_AD_30').AsFloat;
            dataSet.FieldByName('PERC_AD_60').AsFloat := buscas.FieldByName('PERC_AD_60').AsFloat;
            dataSet.FieldByName('PERC_AD_90').AsFloat := buscas.FieldByName('PERC_AD_90').AsFloat;
            dataSet.FieldByName('VALOR_PROMOCAO').AsFloat := buscas.FieldByName('VALOR_PROMOCAO').AsFloat;
            dataSet.FieldByName('PORCENTAGEM').AsFloat := buscas.FieldByName('PORCENTAGEM').AsFloat;
            dataSet.FieldByName('COD_PROMOCAO').AsInteger := buscas.FieldByName('COD_PROMOCAO').AsInteger;
            dataSet.FieldByName('COD_LOCALIDADE').AsInteger := buscas.FieldByName('COD_LOCALIDADE').AsInteger;
            dataSet.FieldByName('COD_SETOR').AsInteger := buscas.FieldByName('COD_SETOR').AsInteger;
            dataSet.FieldByName('COD_CIDADE').AsInteger := buscas.FieldByName('COD_CIDADE').AsInteger;
            dataSet.FieldByName('MAX_DESC').AsFloat := buscas.FieldByName('MAX_DESC').AsFloat;
            dataSet.FieldByName('LOCALIDADE').AsString := buscas.FieldByName('LOCALIDADE').AsString;
            dataSet.FieldByName('SETOR').AsString := buscas.FieldByName('SETOR').AsString;
            dataSet.FieldByName('NOME_CIDADE').AsString := buscas.FieldByName('NOME_CIDADE').AsString;
            dataSet.FieldByName('DESCR_PROMOCAO').AsString := buscas.FieldByName('DESCR_PROMOCAO').AsString;
            dataSet.FieldByName('DESCR_TIPO').AsString := buscas.FieldByName('DESCR_TIPO').AsString;
            dataSet.FieldByName('TIPO').AsString := buscas.FieldByName('TIPO').AsString;
            dataSet.Post;
            aplicarCasasDecimaisEmpresa;
            buscas.Next;
