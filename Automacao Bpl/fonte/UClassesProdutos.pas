          if (dataSet.FieldByName('GRUPO_PROD').AsInteger = buscas.FieldByName('GRUPO_PROD').AsInteger) and
            (dataSet.FieldByName('COD_PROD').AsString = buscas.FieldByName('COD_PROD').AsString) and
            (dataSet.FieldByName('COD_EMPRESA').AsInteger = StrToInt(vDadosIni.vReplicaoInternaEmpresa[i])) and
            (dataSet.FieldByName('QUANT').AsFloat = buscas.FieldByName('QUANT').AsFloat) and
            (dataSet.FieldByName('SIGLA').AsString = buscas.FieldByName('SIGLA').AsString) then
          begin
            dataSet.Edit;
          end
          else
            dataSet.insert;

          {for j := 0 to buscas.FieldCount - 1 do
          begin
            if dataSet.FindField(buscas.Fields[j].FieldName)
            if dataSet.FindField(buscas.Fields[j].FieldName).FieldName = buscas.Fields[j].FieldName then
              if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
                if Dataset.Fields[j].FieldName = buscas.Fields[j].FieldName then
                  Dataset.Fields[j].value := buscas.Fields[j].value;
          end;}

          for j := 0 to dataSet.FieldCount - 1 do
          begin
             for z := 0 to buscas.FieldCount - 1 do
             begin
               if Dataset.Fields[j].FieldName = buscas.Fields[z].FieldName then
              	begin
                 if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
                   Dataset.Fields[j].value := buscas.FindField(Dataset.Fields[j].FieldName).Value;
               end;
             end;
          end;

          dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(vDadosIni.vReplicaoInternaEmpresa[i]);
          dataSet.Post;

          if dataSet.ChangeCount > 0 then
          begin
            if apply then
              result := true
            else
            begin
              result := false;
              exit;
            end;
          end
          else
            result := true;

          buscas.next;
        end;
        
        if dataSet.ChangeCount > 0 then
        begin
          if apply then
            result := true
          else
          begin
            result := false;
            exit;
          end;
        end
        else
          result := true;
      end;
    end;
    teveReplicacao := True;
  end;
  //  end;
