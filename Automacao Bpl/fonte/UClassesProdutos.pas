function TGradeEstoque.abreGradeEstoque(vGrupo, codigo: string): boolean;
var
  vBuscasTemp: TIBQuery;
begin
  Result := montaSelect('select * from cod_grade_prod ' +
  	' where grupo_prod = ' + vGrupo +
    ' and cod_prod = ' + QuotedStr(codigo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);

  try
    vBuscasTemp := TIBQuery(dtmProdutos.qrBuscasCB);

    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('disponivel').AsFloat := vDadosIni.getEstoqueDisponivel(vBuscasTemp,
        dataSet.FieldByName('grupo_prod').AsInteger,
        dataSet.FieldByName('cod_prod').AsString,
        dataSet.FieldByName('cod_grade').AsInteger);
      dataSet.Post;
      dataSet.Next;
    end;
  finally
    vBuscasTemp := nil;
  end;

  vGrade.abreGrade;
end;

