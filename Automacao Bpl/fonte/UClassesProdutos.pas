procedure TBalancoProduto._InserirEstoqueINI(QuantEst, QuantDifBal: Double);
begin
  if not (_vEstoqueINI.Insert) then
    raise Exception.Create('Erro na tentativa de inserir estoque inicial');

  _vEstoqueINI.dataSet.FieldByName('GRUPO_PROD').AsString :=
    dataSet.FieldByName('GRUPO_PROD').AsString;
  _vEstoqueINI.dataSet.FieldByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
  _vEstoqueINI.dataSet.FieldByName('LOCACAO_PROD').Value :=
    dataSet.FieldByName('LOCACAO_PROD').Value;
  _vEstoqueINI.dataSet.FieldByName('LOCACAO_PROD_1').Value :=
    dataSet.FieldByName('LOCACAO_PROD_1').Value;
  _vEstoqueINI.dataSet.FieldByName('QUANT_EST').Value := QuantEst;
  _vEstoqueINI.dataSet.FieldByName('QUANT_TRANS').AsFloat :=
    _PegarReqOS(dataSet.FieldByName('COD_PROD').AsString,
    dataSet.FieldByName('GRUPO_PROD').AsString, 'OS');
  _vEstoqueINI.dataSet.FieldByName('QUANT_REQ').AsFloat :=
    _PegarReqOS(dataSet.FieldByName('COD_PROD').AsString,
    dataSet.FieldByName('GRUPO_PROD').AsString, 'REQ');
  _vEstoqueINI.dataSet.FieldByName('QUANT_PRODUCAO').AsFloat :=
    _PegarReqOS(dataSet.FieldByName('COD_PROD').AsString,
    dataSet.FieldByName('GRUPO_PROD').AsString, 'PRODUCAO');
  _vEstoqueINI.dataSet.FieldByName('DATA_CADASTRO').Value := _objBalanco._vData;
  _vEstoqueINI.dataSet.FieldByName('NUM_FAB_PROD').Value :=
    dataSet.FieldByName('NUM_FAB_PROD').Value;
  _vEstoqueINI.dataSet.FieldByName('DATA_CONFIRM').value := _objBalanco._vData;
  _vEstoqueINI.dataSet.FieldByName('TIP_BAL').AsString := 'G';
  _vEstoqueINI.dataSet.FieldByName('PCUST_MC').Value := dataSet.FieldByName('PREC_CUSM_PROD').Value;
  _vEstoqueINI.dataSet.FieldByName('QTD_DIF_BAL').AsFloat := QuantDifBal;
  _vEstoqueINI.dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;

  if not (_vEstoqueINI.Post) then
    raise Exception.Create('Erro ao inserir estoque inicial');

  if not (_vEstoqueINI.Apply) then
    raise Exception.Create('Erro ao gravar estoque inicial');
end;

procedure TBalancoProduto._InserirEstoqueINIGrade(QuantEst: Double; GrupoProd,
  CodProd, CodGrade, Locacao1, Locacao2: string);
begin

  if not (_vEstoqueINIGrade.Insert) then
    raise Exception.Create('Erro na tentativa de inserir estoque inicial com grade');

  _vEstoqueINIGrade.dataSet.FieldByName('GRUPO_PROD').AsString :=
    GrupoProd; //_vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString;
  _vEstoqueINIGrade.dataSet.FieldByName('COD_PROD').AsString :=
    CodProd; //_vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString;
  _vEstoqueINIGrade.dataSet.FieldByName('COD_GRADE').AsString :=
    CodGrade; //_vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString;
  _vEstoqueINIGrade.dataSet.FieldByName('LOCACAO_PROD').AsString :=
    Locacao1; //_vGradeBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString;
  _vEstoqueINIGrade.dataSet.FieldByName('LOCACAO_PROD_1').AsString :=
    Locacao2; //_vGradeBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString;
  _vEstoqueINIGrade.dataSet.FieldByName('COD_EMPRESA').AsString :=
    vDadosIni.codEmpresa;
  _vEstoqueINIGrade.dataSet.FieldByName('NUM_FAB_PROD').AsString :=
    retornaValor('select num_fab_prod as valor from produtos where cod_prod = '
    + Quotedstr(trim(CodProd))
    + ' and grupo_prod = '
    + trim(GrupoProd) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);
  _vEstoqueINIGrade.dataSet.FieldByName('QUANT_EST').Value :=
    QuantEst; //_vGradeContadosBalanco.dataSet.FieldByName('QTDE').Value;
  _vEstoqueINIGrade.dataSet.FieldByName('QUANT_TRANS').AsFloat :=
    _PegarReqOsGradeTipo(CodProd, GrupoProd, CodGrade, 'OS');
  _vEstoqueINIGrade.dataSet.FieldByName('QUANT_REQ').AsFloat :=
    _PegarReqOsGradeTipo(CodProd, GrupoProd, CodGrade, 'REQ');
  _vEstoqueINIGrade.dataSet.FieldByName('DATA_CADASTRO').Value :=
    _objBalanco._vData;
  _vEstoqueINIGrade.dataSet.FieldByName('DATA_CONFIRM').Value :=
    _objBalanco._vData;

  if not (_vEstoqueINIGrade.Post) then
    raise Exception.Create('Erro ao inserir estoque inicial com grade');

  if not (_vEstoqueINIGrade.Apply) then
    raise Exception.Create('Erro ao gravar estoque inicial com grade');
end;

procedure TBalancoProduto._InserirGradeProduto(Quantidade: Double);
begin
  if not (_vGradeBalanco.Edit) then
    raise Exception.Create('Erro ao editar produto');

  {1-1 - 1}if (vDadosIni.vSupermercado = 'S') then
  begin

    {Substituir a quantidade que do estoque
    pe la que foi contado no balanço
    }
    _vGradeBalanco.dataSet.FieldByName('QTDE').Value :=
      Quantidade;

  end
  else {1-1 - 1}
  begin
    {Soma a quantidade de itens em Os abertas com Req
    abertas com a quantidade contada e coloca mo estoque
    }
    _vGradeBalanco.dataSet.FieldByName('QTDE').Value :=
      Quantidade + strtofloat(_PegarReqOsGrade(
      _vGradeBalanco.dataSet.FieldByName('COD_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
      _vGradeBalanco.dataSet.FieldByName('COD_GRADE').AsString));

  end; {1-1 - 1}

  if not (_vGradeBalanco.Post) then
    raise Exception.Create('Erro ao editar produto com grade');
  _vGradeBalanco.Apply
    //    raise Exception.Create('Erro ao gravar produto com grade');

end;

procedure TBalancoProduto._InserirGradeProduto(Quantidade, AlocQtd1,
  AlocQtd2, CodGrade: string);
begin
//  Verificar grade
  if not (_vGradeBalanco._AbreGradeBalancoGrupo(
    dataSet.FieldByName('COD_PROD').AsString,
    dataSet.FieldByName('GRUPO_PROD').AsString,
    CodGrade)) then
  begin
    exit;
  end;

//  _objBalanco._vGradeContadosBalanco.dataSet.Append;

//  Verificar se o item com grade ja foi contado no balanço
  if not (_vGradeContadosBalanco._AbreGradeContBalanco(
    _vGradeBalanco.dataSet.FieldByName('GRUPO_PROD').AsString,
    dataSet.FieldByName('COD_PROD').AsString,
    CodGrade)) then
  begin
//    Inserir itens padroes do produto no contado com grade do balanco
    _vGradeContadosBalanco.dataSet.Append;
    _vGradeContadosBalanco.dataSet.FieldByName('COD_PROD').AsString
      := dataSet.FieldByName('COD_PROD').AsString;
    _vGradeContadosBalanco.dataSet.FieldByName('GRUPO_PROD').AsString
      := dataSet.FieldByName('GRUPO_PROD').AsString;
    _vGradeContadosBalanco.dataSet.FieldByName('COD_EMPRESA').AsString :=
      vDadosIni.codEmpresa;
    _vGradeContadosBalanco.dataSet.FieldByName('COD_GRADE').AsString :=
      CodGrade;
    _vGradeContadosBalanco.dataSet.FieldByName('DESCRICAO').AsString :=
      retornaValor(
      'select descricao as valor from grade where cod_grade = '
      + CodGrade);
  end
  else
  begin
    _vGradeContadosBalanco.dataSet.Edit;
  end;
//  Verificar se e para substituir o valor do estoque ou somar com o que  esta contado no balanço
  if (_objBalanco._SubstituirOuSomar) then
  begin
//    Inserir quantidade informada mais o que foi contado no balanço
    _vGradeContadosBalanco.dataSet.FieldByName('QTDE').AsString
      := trim(Quantidade);

    _vGradeContadosBalanco.dataSet.FieldByName('QTD_DIF_BAL').Value :=
      trim(Quantidade) -
      (_vGradeBalanco.dataSet.FieldByName('QTDE').Value -
      strtofloat(_PegarReqOsGrade(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString,
      trim(CodGrade))));

  end
  else
  begin
//    Inserir a difereça do estoque da quantidade informada mais  o que já foi contado no balanço
    _vGradeContadosBalanco.dataSet.FieldByName('QTDE').Asfloat :=
      _vGradeContadosBalanco.dataSet.FieldByName('QTDE').Asfloat +
      StrToFloat(trim(Quantidade));

    _vGradeContadosBalanco.dataSet.FieldByName('QTD_DIF_BAL').Value :=
      (_vGradeContadosBalanco.dataSet.FieldByName('QTDE').Asfloat) -
      (_vGradeBalanco.dataSet.FieldByName('QTDE').Value -
      strtofloat(_PegarReqOsGrade(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString,
      trim(CodGrade))));

  end;

  if (trim(AlocQtd1) <> '') then
  begin
    _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString :=
      AlocQtd1;
  end;
  if (trim(AlocQtd2) <> '') then
  begin
    _vGradeContadosBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString :=
      AlocQtd2;
  end;

  if not _vGradeContadosBalanco.Post then
    raise Exception.Create('Erro na tentativa de inserir itens com grade');
  _vGradeContadosBalanco.Apply;
  //raise Exception.Create('Erro na tentativa de gravar itens com grade');

end;

procedure TBalancoProduto._InserirProduto(Quantidade, AlocQtd1,
  AlocQtd2: string);
begin
  //Verificar se produto foi contado anteriormente neste balanco
  if not (_vContadoBalanco._AbreContado(dataSet.FieldByName('COD_PROD').AsString,
    dataSet.FieldByName('GRUPO_PROD').AsString)) then
  begin
    _vContadoBalanco.dataSet.Append;
    _vContadoBalanco.dataSet.FieldByName('COD_PROD').AsString
      := dataSet.FieldByName('COD_PROD').AsString;
    _vContadoBalanco.dataSet.FieldByName('GRUPO_PROD').AsString
      := dataSet.FieldByName('GRUPO_PROD').AsString;
    _vContadoBalanco.dataSet.FieldByName('COD_BARRA').AsString
      := dataSet.FieldByName('NUM_FAB_PROD').AsString;
    _vContadoBalanco.dataSet.FieldByName('COD_EMPRESA').AsString :=
      vDadosIni.codEmpresa;
    _vContadoBalanco.dataSet.FieldByName('PREC_CUSM_PROD').AsString :=
      dataSet.FieldByName('PREC_CUSM_PROD').AsString;
  end
  else _vContadoBalanco.dataSet.Edit;

  //Verificar se e para substituir o valor do estoque ou somar com o que esta contado no balanço
  if (_objBalanco._SubstituirOuSomar) then
  begin
    //Inserir quantidade informada mais o que foi contado no balanço
    if (_vGradeContadosBalanco._AbreGradeContBalanco(dataSet.FieldByName('GRUPO_PROD').AsString,
      dataSet.FieldByName('COD_PROD').AsString)) then
    begin
      _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat := 0;
      _vGradeContadosBalanco.dataSet.First;
      while (not (_vGradeContadosBalanco.dataSet.Eof)) do
      begin
        _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat :=
          _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat +
          _vGradeContadosBalanco.dataSet.FieldByName('QTDE').AsFloat;
        _vGradeContadosBalanco.dataSet.Next;
      end;
      Quantidade := _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsString;
    end
    else
      _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').AsFloat := StrToFloat(trim(Quantidade));

    {!!!# Inserir no diagrama}

    //Inserir a diferença do balanço no estoque, quantidade contada menos o que tinha no estoque.

    _vContadoBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat :=
      strtofloat(trim(Quantidade)) -
      (dataSet.FieldByName('EST_F').AsFloat - _PegarReqOs(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString));

  end
  else
  begin
    //Inserir a difereça do estoque da quantidade informada mais o que já foi contado no balanço
    _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').Asfloat :=
      _vContadoBalanco.dataSet.FieldByName('QTDE_PROD').Asfloat + StrToFloat(trim(Quantidade));

    {!!!# Inserir no diagrama}

    //Inserir a diferença do balanço no estoque, quantidade contada menos o que tinha no estoque.

    _vContadoBalanco.dataSet.FieldByName('QTD_DIF_BAL').AsFloat :=
      (_vContadoBalanco.dataSet.FieldByName('QTDE_PROD').Asfloat) -
      (dataSet.FieldByName('EST_F').AsFloat - _PegarReqOs(dataSet.FieldByName('COD_PROD').AsString,
      dataSet.FieldByName('GRUPO_PROD').AsString));

  end;

  if (trim(AlocQtd1) <> '') then
  begin
    _vContadoBalanco.dataSet.FieldByName('LOCACAO1_PROD').AsString :=
      AlocQtd1;
  end;
  if (trim(AlocQtd2) <> '') then
  begin
    _vContadoBalanco.dataSet.FieldByName('LOCACAO2_PROD').AsString :=
      AlocQtd2;
  end;
  _vContadoBalanco.dataSet.FieldByName('DATA_HORA_LEITURA').AsDateTime :=
    vDadosIni.getDataHoraBanco(buscas);
  _vContadoBalanco.dataSet.FieldByName('CODUSUARIO').AsInteger := vDadosIni.vCodUsuario;
  if not _vContadoBalanco.Post then
    raise Exception.Create('Erro na tentativa de inserir itens no balanço');
  _vContadoBalanco.Apply
    //  raise Exception.Create('Erro na tentativa de gravar itens no balanço');

end;

