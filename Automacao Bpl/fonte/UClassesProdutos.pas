constructor TEtiquetas_Es.create;
begin
  if DtmProdutos = nil then
    DtmProdutos := TDtmProdutos.Create(DtmProdutos);

  DataSet := TClientDataSet(DtmProdutos.cdsGradEt2);
  fEtiqueta := TClientDataSet(DtmProdutos.cdsEtiqueta);
  fGrade := TClientDataSet(DtmProdutos.cdsGradEt2);
  fGrade.CommandText := 'select * from grade where cod_empresa = ' + vDadosIni.codEmpresa;

  transacao := TIBTransaction(DtmProdutos.IBTransProdutos);
  Buscas := TIBQuery(DtmProdutos.qrBuscasP);

  try
    fEtiqueta.CreateDataSet;
  except
  end;
  fEtiqueta.EmptyDataSet;
  fEtiqueta.IndexFieldNames := 'COD_PROD';
  if FileExists(ExtractFilePath(Application.ExeName) + 'tempEtiq4.cds') then
    fEtiqueta.LoadFromFile(ExtractFilePath(Application.ExeName) + 'tempEtiq4.cds');
end;

