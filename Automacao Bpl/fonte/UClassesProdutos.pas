function TProdutosConversaoSaida.post: boolean;
var
  acao: string;
	vgrupo_prod: Integer;
  vcod_prod: string;
  vunidade: string;
begin
  try
    Result := false;

    vgrupo_prod := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    vcod_prod := trim(dataSet.FieldByName('COD_PROD').AsString);
    vunidade := UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString));

    if not vDadosIni.PesqPros('PRO251', 'SALVAR',
    	vunidade, 'PRODUTOS_CONVERSAO_SAIDA',
      IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas, true) then
      	Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if vFatorPrinc <= 0 then
      raiseExceptionCreate('Fator da unidade principal deve ser informado', 'EditMoedaFatorPrincSaida');

    if vFatorConv <= 0 then
			raiseExceptionCreate('Fator da unidade convertida deve ser informado', 'EditMoedaFatorConvSaida');

//    if (vFatorPrinc <= 1) and (vFatorConv <= 1) then
//			raiseExceptionCreate('Fator da unidade principal deve ser diferente do fator da unidade convertida', 'EditMoedaFatorPrincSaida');

    if vFatorPrinc <> 1 then
    begin
    	dataSet.FieldByName('OPERACAO').AsString := 'D';
      dataSet.FieldByName('QUANTIDADE').AsFloat := vFatorPrinc;
    end
    else if vFatorConv <> 1 then
    begin
    	dataSet.FieldByName('OPERACAO').AsString := 'M';
      dataSet.FieldByName('QUANTIDADE').AsFloat := vFatorConv;
    end
    else
    begin
    	dataSet.FieldByName('OPERACAO').AsString := 'D';
      dataSet.FieldByName('QUANTIDADE').AsFloat := 1;
    end;

    if trim(dataSet.FieldByName('UNIDADE').AsString) = '' then
      raiseExceptionCreate('Unidade de medida deve ser informada', 'DBComboBoxUnidadeConvSaida');

  	if trim(dataSet.FieldByName('OPERACAO').AsString) = '' then
    	raiseExceptionCreate('Unidade de medida deve ser informada', 'DBComboBox18');

    if dataSet.FieldByName('QUANTIDADE').AsFloat <= 0 then
      raiseExceptionCreate('Fator de conversão deve ser informada', 'EditMoedaFatorPrincSaida');

    if trim(dataSet.FieldByName('DISPONIVEL_VENDA').AsString) = '' then
    	raiseExceptionCreate('Disponível para venda deve ser informada', 'DBComboBoxDisVendaSaida');

    if trim(dataSet.FieldByName('PADRAO_VENDA').AsString) = '' then
    	raiseExceptionCreate('Padrão na venda deve ser informada', 'DBComboBoxPadraoVndSaida');

    if not SqlOpen(' select grupo_prod, cod_prod, cod_empresa, unidade from produtos ' +
    	' where grupo_prod = ' + IntToStr(vgrupo_prod) +
      ' and cod_prod = ' + QuotedStr(vcod_prod) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).IsEmpty then
    begin
      if UpperCase(trim(buscas.FieldByName('unidade').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) then
        raiseExceptionCreate('Unidade principal deve ser diferente da unidade convertida', 'DBComboBoxUnidadeConv');
    end;

    if not fempty('codigo_ean') then
      if SqlScalar(' select count(cod_prod) from vw_produtos_conversao' +
        ' where grupo_prod = %d ' +
        ' and cod_prod = ''%s'' ' +
        ' and cod_empresa = %d' +
        ' and codigo_ean = ''%s'' ' +
        ' and upper(unidade) <> ''%s''',
        [vgrupo_prod, vcod_prod, vDadosIni.cod_empresa,
         fstr('codigo_ean'), UpperCase(trim(fstr('unidade')))], buscas).AsInteger > 0
      then
        raiseExceptionCreate('EAN informado já está presente em outra unidade de medida', 'DBEditCodigoEanSaida');

    if acao = 'INSERIR' then
      if not _existeProduto(
        dataSet.FieldByName('GRUPO_PROD').AsInteger,
        dataSet.FieldByName('COD_PROD').AsString,
        UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
      begin
        Application.MessageBox('Unidade medida já consta nesta conversão', 'Atenção', MB_ICONWARNING + MB_OK);
        exit;
      end;

//    if trim(dataSet.FieldByName('PADRAO_VENDA').AsString) = 'S' then
//      if not _existeUnidadePadrao(
//        dataSet.FieldByName('GRUPO_PROD').AsInteger,
//        dataSet.FieldByName('COD_PROD').AsString,
//        UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
//      begin
//        Application.MessageBox('Já existe uma conversão para venda definida como padrão venda', 'Atenção', MB_ICONWARNING + MB_OK);
//        exit;
//      end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('PRO251', acao,
      	'SUCESSO - ' + vunidade,
        'PRODUTOS_CONVERSAO_SAIDA',
        IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas)
    else
      vDadosIni.GravaAuditoria('PRO251', acao,
      	'FALHA - ' + vunidade,
        'PRODUTOS_CONVERSAO_SAIDA',
        IntToStr(vgrupo_prod) + '-' + vcod_prod, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosConversaoSaida._abreProdutosConversao(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vunidade: string = ''): boolean;
begin
	result := montaSelect('select p.* from produtos_conversao_saida p ' +
    ' where p.grupo_prod = ' + IntToStr(vgrupo_prod) +
    ' and p.cod_prod = ' + QuotedStr(vcod_prod) +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
    vDadosIni.IfThen(trim(vunidade) <> '',
    	' and p.unidade = ' + QuotedStr(vunidade), ''));
end;

function TProdutosConversaoSaida._existeProduto(
	vgrupo_prod: Integer;
  vcod_prod: string;
  vunidade: string): boolean;
begin
	buscas.Close;
  buscas.SQL.Text := 'select grupo_prod, cod_prod, cod_empresa, unidade, ' +
  	' disponivel_venda, padrao_venda from produtos_conversao_saida ' +
  	' where grupo_prod = ' + IntToStr(vgrupo_prod) +
    ' and cod_prod = ' + QuotedStr(vcod_prod) +
