procedure TProdutos.relEtiArgox(ImprimirQtdEmEstoque,
  pImprimirProdutosMarcados: Boolean; grid: TDBGrid; pModelo: string);
var
  vRelArgox: TRelatoriosEtiTermica;
begin
  inherited;
  if trim(pModelo) = '' then
  begin
    Application.MessageBox('Favor selecionar um modelo de etiqueta.',
      'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;
  vRelArgox := TRelatoriosEtiTermica.create;
  vRelArgox.grid := TDBGrid(grid);
  vRelArgox.somenteSelecionado := Application.MessageBox('Imprimir somente selecionados?',
    'Confirmação', MB_YESNO +
    MB_ICONQUESTION) = ID_YES;
  vRelArgox.ImprimirProdutosMarcados := pImprimirProdutosMarcados;
  vRelArgox.ImprimirQtdEstoque := ImprimirQtdEmEstoque;
  vRelArgox.imprimirARGOX(pModelo);
end;

procedure TProdutos.relEtiCodBarras(printProdutosMarcados, printQtdEstoque: boolean; grid: TDBGrid);
var
  vEtiCodBarras: TRelatoriosSimples;
  vPacketRecords: Integer;
  vSomenteSelecionado: Boolean;
  vOK: Boolean;
begin
	if grid.DataSource.DataSet.IsEmpty then
  begin
  	Application.MessageBox(PChar('Nenhum produto informado.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  vSomenteSelecionado := Application.MessageBox('Imprimir somente selecionados?',
  	'Confirmação', MB_YESNO + MB_ICONQUESTION) = ID_YES;

  if vSomenteSelecionado then
  begin
  	vOK := False;

    try
      grid.DataSource.DataSet.DisableControls;
      grid.DataSource.DataSet.First;
      while not grid.DataSource.DataSet.Eof do
      begin
        if grid.DataSource.DataSet.FieldByName('sel').AsString = 'S' then
        begin
          vOK := True;
          Break;
        end;

        grid.DataSource.DataSet.Next;
      end;
    finally
      grid.DataSource.DataSet.First;
  		grid.DataSource.DataSet.EnableControls;
    end;

    if not vOK then
    begin
    	Application.MessageBox(PChar('Nenhum produto selecionado.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      Exit;
    end;
  end;

  try
    vEtiCodBarras := TRelatoriosSimples.create;
    FrmCadProdutos.DetailBandEtiCodBarras.Visible := FrmCadProdutos.RadioGroupOpcaoLinha.ItemIndex = 0;
    FrmCadProdutos.DetailBandEtiCodBarras2.Visible := FrmCadProdutos.RadioGroupOpcaoLinha.ItemIndex = 1;

    if FrmCadProdutos.DetailBandEtiCodBarras.Visible then
      vEtiCodBarras.quickRep := TquickRep(FrmCadProdutos.qrpEtiCodBarras)
    else
      vEtiCodBarras.quickRep := TquickRep(FrmCadProdutos.qrpEtiCodBarras2);
    vEtiCodBarras.grid := TDBGrid(grid); // TDBGrid(FrmCadProdutos.DBGrid15);

    if FrmCadProdutos.DetailBandEtiCodBarras.Visible then
      vEtiCodBarras.vBarcode := TQRBarcode(FrmCadProdutos.QRBarcode1)
    else
      vEtiCodBarras.vBarcode := TQRBarcode(FrmCadProdutos.QRBarcode2);
    vEtiCodBarras.ImprimirProdutosMarcados := printProdutosMarcados;
    vEtiCodBarras.ImprimirQtdEstoque := printQtdEstoque;
    vEtiCodBarras.dtSet := TClientDataSet(dataset);
    vEtiCodBarras.somenteSelecionado := vSomenteSelecionado;

    if (not vEtiCodBarras.ImprimirProdutosMarcados) or vEtiCodBarras.somenteSelecionado then
    begin
      vEtiCodBarras.ImprimirEtiCodBarras;
    end;

    try
    	vPacketRecords := dataSet.PacketRecords;
      dataSet.PacketRecords := -1;

      try
      	vDadosIni.abreStatusProcessamento('', 'Montando consulta impressão de etiquetas');

        if vEtiCodBarras.somenteSelecionado then
          montaSelect(' select p.*, cast(0 as float) estoque, cast(0 as float) est_prima from imp_bar_prod ibp ' +
            ' inner join produtos p on ' +
            '		ibp.cod_empresa = p.cod_empresa ' +
            '		and ibp.grupo_prod = p.grupo_prod ' +
            '		and ibp.cod_prod = p.cod_prod ' +
            ' where p.ativo = 1 ' +
            ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ibp.selecionado = ''S''')
        else
          montaSelect('select p.*, cast(0 as float) estoque, cast(0 as float) est_prima from imp_bar_prod ibp ' +
            '	inner join produtos p on ' +
            '		ibp.cod_empresa = p.cod_empresa ' +
            '		and ibp.grupo_prod = p.grupo_prod ' +
            '		and ibp.cod_prod = p.cod_prod ' +
            ' where p.ativo = 1 ' +
            ' and p.cod_empresa = ' + vDadosIni.codEmpresa);
      finally
      	vDadosIni.fechaStatusProcessamento;
      end;

      vEtiCodBarras.somenteSelecionado := false;
      if FrmCadProdutos.DetailBandEtiCodBarras.Visible then
        FrmCadProdutos.DetailBandEtiCodBarras.BeforePrint := vEtiCodBarras.bandaDetalheBeforePrint
      else
        FrmCadProdutos.DetailBandEtiCodBarras2.BeforePrint := vEtiCodBarras.bandaDetalheBeforePrint;
      vEtiCodBarras.quickRep.Preview;
      //    Produto.CommitaTransacao;
    finally
      dataSet.PacketRecords := vPacketRecords; 
    end;
  finally
    if not vEtiCodBarras.ImprimirProdutosMarcados then
      montaSelect(ultimasql);
  end;
end;

function TProdutos.exibeItensPedidoAberto: boolean;
var
  vSqlAd:string;
begin
  vSqlAd := '';

//  if vDadosIni.vEmp.vAlmox = 'S2' then
  begin
    vSqlAd := ' union all' +
    ' select ''EST. FECHADO'' , coalesce(c.quant,0),' +
    ' c.cod_pedido, c.data_pedido, c.filtro, c.tipv, '''', c.nitem' +
    ' from controle_almoxarifado c ' +
    ' left join grade grd on c.cod_grade = grd.cod_grade and c.cod_empresa = grd.cod_empresa' +
    ' where c.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and c.cod_prod = ' + quotedstr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
    ' and c.cod_empresa =' + vDadosIni.codEmpresa;
  end;
  buscas.Close;
  buscas.SQL.Text := 'SELECT case ' +
    ' when (p.tipo=''REQ'') then ''REQUISIÇÃO'' ' +
    ' else ''ORDEM DE SERVIÇO'' ' +
    ' end as TipoVenda,pp.quant_ped_item,pp.nped,p.data_ped,c.nome_cliente,p.tipv, p.tipo_os,pp.nitem ' +
    ' from pedvenda p INNER JOIN pedvenda_prod pp ' +
    ' on p.nped = pp.nped and p.cod_empresa = pp.cod_empresa and p.tipo = pp.tipo ' +
    ' INNER JOIN clientes c on p.cod_empresa=c.cod_empresa and p.cod_cliente=c.cod_cliente ' +
    ' where p.data_fech is null and p.ativo = 1 and ((p.tipo = ''OS'') or (p.tipo=''REQ'')) ' +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and pp.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and pp.cod_prod = ' + quotedstr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
    ' and ((pp.status is null) or (pp.status <> ''CANCELADO'')) ' + vSqlAd +
    ' union all' +
    ' select ''PRODUÇÃO'', (coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)),' +
    ' pd.cod_producao, pd.data, c.nome_cliente, '''','''',pi.seq nitem from producao pd' +
    ' inner join producao_item_indice pi on pi.cod_producao = pd.cod_producao and pi.cod_empresa = pd.cod_empresa' +
    ' left join clientes c on c.cod_cliente = pd.cod_cliente and c.cod_empresa = pd.cod_empresa' +
    ' where pd.data_fechamento is null and pd.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and pi.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and pi.cod_prod = ' + quotedstr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
    ' order by 1,4';
  buscas.Open;
  buscas.FieldByName('TipoVenda').DisplayLabel := 'Tipo do Pedido';
  buscas.FieldByName('quant_ped_item').DisplayLabel := 'Qtde Pendências';
  buscas.FieldByName('nped').DisplayLabel := 'Número de Pedido';
  buscas.FieldByName('data_ped').DisplayLabel := 'Data do Pedido';
  buscas.FieldByName('nome_cliente').DisplayLabel := 'Nome do Cliente';
  buscas.FieldByName('tipv').DisplayLabel := 'Tipo de Venda';
  buscas.FieldByName('Tipo_os').DisplayLabel := 'Tipo de OS';
end;

function TProdutos.existeInformacaoComplementar(pCodigo: Integer): Boolean;
begin
  Result := False;
  vTextoInfComplementar.Text := '';
  if pCodigo = 0 then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select * from SPED_INFORMACAO_COMPLEMENTAR' +
    ' where cod_inf = ' + IntToStr(pCodigo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1';
  buscas.Open;

  if buscas.IsEmpty then
  begin
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_inf').Value := Null;
  end
  else
  begin
    vTextoInfComplementar.Add(buscas.FieldByName('TXT').AsString);
    vTextoInfComplementar.Add(buscas.FieldByName('TXT_COMPL').AsString);
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_inf').AsInteger := pCodigo;
    Result := True;
  end;

  buscas.Close;
end;

