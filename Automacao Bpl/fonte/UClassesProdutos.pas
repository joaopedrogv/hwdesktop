function TGrupoProdSimilaresItens.LocProduto(pNumFab: string; pGrupo: Integer = 0; pCodProd: string = ''; pProc: boolean = false): boolean;
begin
  NumFabr := trim(pNumFab);
  pNumFab := trim(pNumFab);
  vPesqDescrProd := false;
  result := false;                
  if (pNumFab <> '') or (pGrupo > 0) then
  begin
    buscas.Close;
    buscas.SQL.Text := ' select distinct p.*, ' +
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	 	' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
    	' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
      ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where ';
    if pGrupo > 0 then
    	buscas.SQL.Text := buscas.SQL.Text + ' p.grupo_prod = ' + IntToStr(pGrupo) + ' AND p.cod_prod = ' + QuotedStr(pCodProd)
    else
      buscas.SQL.Text := buscas.SQL.Text + ' cb.cod_barra = ' + QuotedStr(pNumFab);

    buscas.SQL.Text := buscas.SQL.Text +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1';
    buscas.Open;
    buscas.FetchAll;

    if buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select distinct p.*, ' +
       	' coalesce(est.estoque, 0) estoque_disponivel, ' +
	  	 	' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        ' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
        ' where p.descr_prod like ' + QuotedStr(pNumFab + '%') +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1';
      buscas.Open;
      buscas.FetchAll;

      if not buscas.IsEmpty then
	    	vPesqDescrProd := true;
    end;

    if not buscas.IsEmpty then
      if buscas.RecordCount > 1 then
      begin
      	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
        TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
        TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
        TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
        TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
        TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
        if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
        begin
          Result := false;
          exit;
        end;
      end;
        
    if buscas.IsEmpty then
    begin
    	dataSet.FieldByName('GRUPO_PROD').AsVariant := null;
      dataSet.FieldByName('COD_PROD').AsVariant := null;
      DescrProd := '';
//      NumFabr := '';
      Application.MessageBox(PChar('Produto não encontrado no estoque' + chr(13) +
        'Favor Verificar Cadastro de Estoque'), 'Atenção', MB_ICONWARNING + MB_OK);
      exit;
    end
    else
    begin
    	dataSet.FieldByName('GRUPO_PROD').AsInteger := buscas.FieldByName('GRUPO_PROD').AsInteger;
      dataSet.FieldByName('COD_PROD').AsString := buscas.FieldByName('COD_PROD').AsString;
      NumFabr := IfThen(vPesqDescrProd,
      	buscas.FieldByName('NUM_FAB_PROD').AsString, pNumFab);
      DescrProd := buscas.FieldByName('DESCR_PROD').AsString;
    end;

    if ExecutaComandosSql('select * from PROD_SIMILARES_GRUPOS_ITENS ' +
      ' where COD_GRUPO_SIM = ' + IntToStr(dataSet.FieldByName('COD_GRUPO_SIM').AsInteger) +
      ' and GRUPO_PROD =' + IntToStr(dataSet.FieldByName('GRUPO_PROD').asinteger) +
      ' and COD_PROD = ' + QuotedStr(dataSet.FieldByName('COD_PROD').asstring) +
      ' and COD_EMPRESA = ' + vDadosIni.codEmpresa) then
    begin
      Application.MessageBox('Produto já existe neste grupo de similar.', 'Atenção', MB_OK +
        MB_ICONWARNING + MB_DEFBUTTON1);

//      dataSet.FieldByName('GRUPO_PROD').AsVariant := null;
//      dataSet.FieldByName('COD_PROD').AsVariant := null;
//      NumFabr := '';
//      DescrProd := '';
    	exit;
    end;

    SqlOpen('select PROD.*, GRUPO.DESCR_GRUPO from PROD_SIMILARES_GRUPOS_ITENS PROD ' +
      ' inner join PROD_SIMILARES_GRUPOS GRUPO ON GRUPO.COD_GRUPO_SIM = PROD.COD_GRUPO_SIM ' +
      '		AND GRUPO.COD_EMPRESA = PROD.COD_EMPRESA ' +
      ' where PROD.COD_GRUPO_SIM <> ' + IntToStr(dataSet.FieldByName('COD_GRUPO_SIM').AsInteger) +
      ' and PROD.GRUPO_PROD =' + IntToStr(dataSet.FieldByName('GRUPO_PROD').asinteger) +
      ' and PROD.COD_PROD = ' + QuotedStr(dataSet.FieldByName('COD_PROD').asstring) +
      ' and PROD.COD_EMPRESA = ' + vDadosIni.codEmpresa);
    if not buscas.IsEmpty then
    begin
    	if ((not pProc) and (vDadosIni.vProdSimilar.vIncluirSimilarGruposDis)) then
      begin
      	if Application.MessageBox(PChar('Produto já existe em outro grupo de similar: ' + #13 +
          'Grupo: ' + IntToStr(buscas.FieldByName('COD_GRUPO_SIM').AsInteger) +
          ' - ' + trim(buscas.FieldByName('DESCR_GRUPO').AsString) + chr(13) +
          'Deseja continuar assim mesmo?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
          MB_DEFBUTTON1)<> mrYES then
          	exit;
      end
      else
        Application.MessageBox(PChar('Produto já existe em outro grupo de similar: ' + #13 +
          'Grupo: ' + IntToStr(buscas.FieldByName('COD_GRUPO_SIM').AsInteger) +
          ' - ' + trim(buscas.FieldByName('DESCR_GRUPO').AsString)), 'Atenção', MB_OK +
          MB_ICONWARNING + MB_DEFBUTTON1);

    	if not vDadosIni.vProdSimilar.vIncluirSimilarGruposDis then
	      exit;

      if pProc then
        if not vDadosIni.PesqPros('PRO358', 'PERMITIR',
           'Grupo Prod: ' +  IntToStr(dataSet.FieldByName('GRUPO_PROD').asinteger) +
           ' Cod Prod: ' + trim(dataSet.FieldByName('COD_PROD').asstring),
           'PROD_SIMILARES_GRUPOS_ITENS', '',
          buscas, true) then
            exit;
    end;
  end;
  result := true;
end;

function TGrupoProdSimilaresItens.post(Grupo: TGrupoProdSimilares): boolean;
var
  acao: string;
  codigo: Integer;
  grupoprod: Integer;
  codprod: string;
begin
  try
    Result := false;

    codigo := dataSet.FieldByName('COD_GRUPO_SIM').AsInteger;
    grupoprod := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    codprod := dataSet.FieldByName('COD_PROD').AsString;

    if not vDadosIni.PesqPros('PRO356', 'SALVAR', '', 'PROD_SIMILARES_GRUPOS_ITENS', '', buscas, true) then
      exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.FieldByName('GRUPO_PROD').AsInteger <= 0 then
    	raiseExceptionCreate('Produto deve ser informada.', 'DBEditNumFabProd');

    if trim(dataSet.FieldByName('COD_PROD').AsString) = '' then
    	raiseExceptionCreate('Produto deve ser informada.', 'DBEditNumFabProd');

    if not buscarProduto(dataSet.FieldByName('GRUPO_PROD').AsInteger,
    	trim(dataSet.FieldByName('COD_PROD').AsString)) then
    	raiseExceptionCreate('Produto não encontrado.', 'DBEditNumFabProd');

    if not LocProduto('', dataSet.FieldByName('GRUPO_PROD').AsInteger, dataSet.FieldByName('COD_PROD').AsString, true) then
      exit;

    if (Grupo.dataSet.State in [dsInsert, dsEdit]) then
    begin
      if (trim(Grupo.dataSet.FieldByName('DESCR_GRUPO').AsString) = '')
      	and (dataset.FieldByName('PRINCIPAL').AsString = 'S') then
      begin
      	SqlOpen(' SELECT GRUPO_PROD, COD_PROD, COD_EMPRESA, DESCR_PROD FROM PRODUTOS  ' +
        	' WHERE GRUPO_PROD = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' AND COD_PROD = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa);

        Grupo.dataSet.FieldByName('DESCR_GRUPO').AsString :=
          Copy(trim(buscas.FieldByName('DESCR_PROD').AsString), 1, 50);
      end;

    	if not Grupo.Post(false) then
      	if trim(Grupo.vmensamErro) <> '' then
	      	raiseExceptionCreate(Grupo.vmensamErro, 'DBEditDescricao');
    end;

    dataSet.FieldByName('COD_GRUPO_SIM').AsInteger :=
    	Grupo.dataSet.FieldByName('COD_GRUPO_SIM').AsInteger;

    codigo := dataSet.FieldByName('COD_GRUPO_SIM').AsInteger;

    Result := inherited post;
    
    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;
    
    if Apply then
    begin
      CommitaTransacao;
      result := True;
    end
    else
    begin
    	Cancel;
      RollBackTransacao;
      Result := False;
    end;

    if Result then
      vDadosIni.GravaAuditoria('PRO356', acao, 'SUCESSO - ' +
      	'Grupo Prod: ' + IntToStr(grupoprod) +
        'Cod Prod: ' + codprod,
        'PROD_SIMILARES_GRUPOS_ITENS', IntToStr(codigo), buscas)
    else
      vDadosIni.GravaAuditoria('PRO356', acao, 'FALHA - ' +
      	'Grupo Prod: ' + IntToStr(grupoprod) +
        'Cod Prod: ' + codprod, 'PROD_SIMILARES_GRUPOS_ITENS', IntToStr(codigo), buscas);

    abreGrupoProdSimilaresItens(codigo);
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

