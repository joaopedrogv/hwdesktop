function TGrupoProdSimilares.post(pAtualizar: boolean): boolean;
var
  acao: string;
  codigo: string;
begin
  try
    Result := false;

    vmensamErro := '';

    if not vDadosIni.PesqPros('PRO352', 'SALVAR', '', 'PROD_SIMILARES_GRUPOS', '', buscas, true) then
      exit;
      
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

//    if not (dataSet.State in [dsInsert, dsEdit]) then
//    begin
//      result := true;
//      exit;
//    end;
  	if not (dataSet.State in [dsInsert, dsEdit]) then
      dataSet.Edit;

    if trim(dataSet.FieldByName('DESCR_GRUPO').AsString) = '' then
    begin
    	vmensamErro := 'Descrição do grupo deve ser informada.';
      if not pAtualizar then
      	exit
      else
	    	raiseExceptionCreate(vmensamErro, 'DBEditDescricao');
    end;

    if dataSet.State = dsInsert then
      dataSet.FieldByName('COD_GRUPO_SIM').asInteger :=
      	Gencodigo('PROD_SIMILARES_GRUPOS', dtmProdutos.SpIncCodigo, vDadosIni.codEmpresa);

    codigo := dataSet.FieldByName('COD_GRUPO_SIM').asstring;

    Result := inherited post;
    
    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;
    
    if Apply then
    begin
      CommitaTransacao;
      result := True;
    end
    else
    begin
    	Cancel;
      RollBackTransacao;
      Result := False;
    end;

    if Result then
      vDadosIni.GravaAuditoria('PRO352', acao, 'SUCESSO', 'PROD_SIMILARES_GRUPOS', codigo, buscas)
    else
      vDadosIni.GravaAuditoria('PRO352', acao, 'FALHA', 'PROD_SIMILARES_GRUPOS', codigo, buscas);

    if pAtualizar then
	    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

