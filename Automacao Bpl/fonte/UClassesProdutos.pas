function TTipoServ.EnviarDadosComercioAberto(pRemover: boolean = false): boolean;
var
  acao: string;
begin
  Result := False;

	try
   prepare_loop('sel = ''S''');
  	try

      if dataSet.IsEmpty then
      begin
        Application.MessageBox('Nenhum tipo de serviço selecionado.', 'Atenção',
          MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not vDadosIni.PesqPros('BAS431', 'ATUALIZAR', '', 'TIPO_SERVICO', '', buscas, true) then
   			Exit;

      acao := 'ENVIAR';
      if pRemover then acao := 'REMOVER';

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Atualizar dados do Comércio Aberto (' +
          	IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        dataset.Edit;
        if trim(dataSet.FieldByName('DESC_SERV_RES').AsString) = '' then
        	dataSet.FieldByName('DESC_SERV_RES').AsString :=
            vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(dataSet.FieldByName('DESC_SERVICO').AsString));
        dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString :=
        	vDadosIni.IfThen(pRemover or (fint('ativo') = 0), 'N', 'S');
        if trim(dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString) = '' then
        	dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString := 'N';
        dataSet.Post;

        vDadosIni.GravaAuditoria('BAS431', acao, '', 'TIPO_SERVICO',
        	IntToStr(dataset.FieldByName('COD_SERVICO').AsInteger), buscas);

        dataset.Next;
      end;

      if dataSet.ChangeCount > 0 then
       	Apply;

      if SqlOpen('select count(ec.grupo_prod) contador from vw_produtos_ec ec' +
                 ' where ec.env_comercio_aberto = ''S'' and ec.api = ''COMERCIOABERTO''' +
                 ' and ec.cod_empresa = %d and ec.ativo = 1', [vDadosIni.cod_empresa]).FieldByName('contador').AsInteger > LIMITE_COMERCIOABERTO then
      begin
        RollBackTransacao;

        ShowErro(LIMITE_COMERCIOABERTO_MENSAGEM);

        Exit;
      end;

      CommitaTransacao;

      vDadosIni.GravaAuditoria('BAS431', 'ATUALIZAR', 'SUCESSO', 'TIPO_SERVICO', '', buscas);

      Result := true;

      try
        vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Api');

        dataSet.First;
        while not dataSet.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Api (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          hw_comercio_produto_enviar(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa, fint('cod_servico'), WideString('SERV'), 0);

          dataSet.Next;
        end;

        hw_comercio_consulta_periodica(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa);

      except on E: Exception do
        begin
          registraErro('TProdutos.EnviarDadosComercioAberto %s', [e.Message]);
          ShowErro('Erro ao enviar dados para Api ' + sLineBreak + E.Message);
        end;
      end;

    finally
      prepare_loop_done;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on E: Exception do
    begin
      result := False;
      vDadosIni.GravaAuditoria('BAS431', 'ATUALIZAR', 'ERRO', 'TIPO_SERVICO', '', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.abrirComprasEVendasC. Erro: ' + e.Message);
    end;
  end;
end;

