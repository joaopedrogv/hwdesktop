function TItKitsProdutos.VerificaItKit(Kit: TKitsProdutos): boolean;
var
  numfabrica: string;
begin
  //  if trim(dataSet.FieldByName('NUM_FAB_PROD').asstring)='' then
  numfabrica := '';
  result := false;
  buscas.Close;
  buscas.SQL.Text := 'select * from produtos ' +
    ' where NUM_FAB_PROD =' + quotedstr(dataSet.FieldByName('NUM_FAB_PROD').asstring) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
  buscas.Open;
  if buscas.IsEmpty then
  begin
    Application.MessageBox(PChar('Produto não Encontrado no Estoque' + chr(13) +
      'Favor Verificar Cadastro de Estoque'), 'Atenção', MB_ICONWARNING + MB_OK);
    dataSet.FieldByName('GRUPO_PROD').AsVariant := null;
    dataSet.FieldByName('COD_PROD').AsVariant := null;
    dataSet.FieldByName('DESCR_PROD_KIT').AsVariant := null;
    exit;
  end
  else
  begin
    dataSet.FieldByName('GRUPO_PROD').Asinteger := buscas.FieldByName('GRUPO_PROD').asinteger;
    dataSet.FieldByName('COD_PROD').AsString := buscas.FieldByName('COD_PROD').asstring;
    dataSet.FieldByName('DESCR_PROD_KIT').asstring := buscas.FieldByName('DESCR_PROD').AsString;
  end;

  if ((dataSet.State = dsEdit) and ((trim(dataSet.FieldByName('NUM_FAB_PROD').NewValue)) <>
    (trim(dataSet.FieldByName('NUM_FAB_PROD').OldValue))))
    or (dataSet.State = dsInsert) then
  begin
    if ExecutaComandosSql('Select * from kits_prod_kits ' +
      ' where codigo_kit =' + inttostr(KitAtual) +
      ' and NUM_FAB_PROD =' + quotedstr(dataSet.FieldByName('NUM_FAB_PROD').asstring) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1') then
    begin
      if Application.MessageBox('Produto já cadastrado para este Kit.' + chr(13) +
        'Deseja alterar sua quantidade?', 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = mrYES then
      begin
        numfabrica := dataSet.FieldByName('NUM_FAB_PROD').asstring;
        Cancel;
        if dataSet.Locate('NUM_FAB_PROD;CODIGO_KIT', VarArrayOf([numfabrica, KitAtual]), []) then
          Edit(Kit.dataset);
        result := true;
      end
      else
      begin
        dataSet.FieldByName('GRUPO_PROD').Value := dataSet.FieldByName('GRUPO_PROD').OldValue;
        dataSet.FieldByName('COD_PROD').Value := dataSet.FieldByName('COD_PROD').OldValue;
        dataSet.FieldByName('DESCR_PROD_KIT').Value :=
          dataSet.FieldByName('DESCR_PROD_KIT').OldValue;
        dataSet.FieldByName('NUM_FAB_PROD').Value := dataSet.FieldByName('NUM_FAB_PROD').OldValue;
      end;
    end
    else
      result := true;
  end
  else
    result := true;
end;

procedure TItKitsProdutos.verificarPesoDimensoesProdutos(pTipo: string; pCodigoKit: Integer);
var
	vtemp: string;
  vtemp2: string;
begin         
	vtemp := 'Produto no kit foi adicionado: ';
  if (pTipo = 'EDITAR') then
  	vtemp := 'Produto no kit foi alterado: '
  else if (pTipo = 'DELETAR') then
  	vtemp := 'Produto no kit foi deletado: ';
  
	if not vDadosIni.vEcommerce.vHabilitarEcommerce then
  	exit;

  buscas.Close;
  buscas.SQL.Text := ' select kits_prod_ec.codigo_kit, kits_prod_ec.cod_empresa, ' +
  	' kits_prod_ec.sinc_ecommerce, kits_prod_ec.regra_peso_dim, ' +
    ' kits_prod_tot.peso_brut_prod, kits_prod_tot.comprimento_prod, ' +
    ' kits_prod_tot.largura_prod, kits_prod_tot.altura_prod from kits_prod_ec ' +
  	' left join kits_prod_tot on ' +
    '		kits_prod_tot.codigo_kit = kits_prod_ec.codigo_kit ' +
    '		and kits_prod_tot.cod_empresa = kits_prod_ec.cod_empresa ' +
  	' where kits_prod_ec.codigo_kit = :codigo_kit ' +
    ' and kits_prod_ec.cod_empresa = :cod_empresa; ';
  buscas.ParamByName('codigo_kit').AsInteger := pCodigoKit;
  buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.Open;

  if (buscas.FieldByName('PESO_BRUT_PROD').AsFloat > 0)
		or (buscas.FieldByName('COMPRIMENTO_PROD').AsFloat > 0)
    or (buscas.FieldByName('LARGURA_PROD').AsFloat > 0)
    or (buscas.FieldByName('ALTURA_PROD').AsFloat > 0) then
  begin
	  vtemp := vtemp + #13 + #13 +
    	'Soma do peso dos produtos do kit: ' + FloatToStr(buscas.FieldByName('PESO_BRUT_PROD').AsFloat) + ' (Kg)' + #13 +
      'Soma do comprimento dos produtos do kit: ' + FloatToStr(buscas.FieldByName('COMPRIMENTO_PROD').AsFloat) + ' (cm)' + #13 +
      'Soma da largura dos produtos do kit: ' + FloatToStr(buscas.FieldByName('LARGURA_PROD').AsFloat) + ' (cm)' +  #13 +
      'Soma da altura dos produtos do kit: ' + FloatToStr(buscas.FieldByName('ALTURA_PROD').AsFloat) + ' (cm)' + #13 + #13;
  end;

  if trim(vRegraPesoDim) <> '' then
  begin
    if (buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S')
      and (vRegraPesoDim <> 'SOMARPESODIM') then
    begin
      vtemp2 := 'Favor atualizar o peso e dimensões do kit.';
      if buscas.FieldByName('REGRA_PESO_DIM').AsString = 'SOMARPESO_CADDIM' then
        vtemp2 := 'Favor atualizar as dimensões do kit.';

      Application.MessageBox(PChar(vtemp +
           chr(13) + vtemp2), 'Atenção', MB_OK +
           MB_ICONWARNING + MB_DEFBUTTON1);
    end;
  end	
  else
  begin
    if (buscas.FieldByName('SINC_ECOMMERCE').AsString = 'S')
      and (buscas.FieldByName('REGRA_PESO_DIM').AsString <> 'SOMARPESODIM') then
    begin
      vtemp2 := 'Favor atualizar o peso e dimensões do kit.';
      if buscas.FieldByName('REGRA_PESO_DIM').AsString = 'SOMARPESO_CADDIM' then
        vtemp2 := 'Favor atualizar as dimensões do kit.';

      Application.MessageBox(PChar(vtemp +
           chr(13) + vtemp2), 'Atenção', MB_OK +
           MB_ICONWARNING + MB_DEFBUTTON1);
    end;
  end;
end;

