procedure TProdutos.dataSetReconcileError(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  try
    try
      inherited;
    except
    end;
    if (Pos('CHK_NFABRICANTE', e.Message) <> 0) then
    begin
      Application.MessageBox('Número do Fabricante Inválido', 'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_ITEM_NFV_PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) + 'Item em uso em Nota Fiscal Venda',
        'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_ITEM_NF__PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) +
        'Item em uso em Nota Fiscal Entrada',
        'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_ITEM_PED_PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) + 'Item em uso em Pedido', 'Erro',
        MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_ITEMPROD_PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) + 'Item em uso em Orçamentos',
        'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_PROD_SIM_PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      if Application.MessageBox('Erro ao Deletar Item' + chr(13) +
        'Item em uso em Produtos Similares', 'Erro', MB_OK + MB_ICONERROR) = IDOK then
        Abort;
    end;
    if Pos('FK_VENDA_PE_PRODUTOS__PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) + 'Item em uso em Vendas Perdidas',
        'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('FK_PEDVENDA_PROD_PRODUTOS', e.Message) <> 0 then
    begin
      Application.MessageBox('Erro ao Deletar Item' + chr(13) + 'Item em uso em Vendas', 'Erro',
        MB_OK + MB_ICONERROR);
      Abort;
    end;
    if Pos('IDX_NUM_FAB_PROD_UNICO', e.Message) <> 0 then
    begin
      Application.MessageBox('Numero de fabricante já existe em outro produto', 'Erro',
        MB_OK + MB_ICONERROR);
      Abort;
    end;
  finally
    Self.dataSet.OnReconcileError := nil;
    //    RollBackTransacao;
    //    Self.DataSet.CancelUpdates;
  end;
end;

