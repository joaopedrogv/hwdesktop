function TTipoGrade.Abrir: TTipoGrade;
begin
	Result := Self;
  ClientOpen('select * from tipo_grade_ec ' +
  	' where cod_empresa = %d and ativo = 1 ' +
    ' order by descricao ', [vDadosIni.cod_empresa]);
  TableName := 'TIPO_GRADE_EC';
  dataSet.FieldByName('cod_tipo').Visible := false;
  dataSet.FieldByName('cod_empresa').Visible := false;
  dataSet.FieldByName('ativo').Visible := false;
end;

function TTipoGrade.Delete: Boolean;
begin
	Result := False;
  if dataSet.IsEmpty then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir esse tipo de grade?',
  	'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

  if SqlOpen('select count(*) as contador from grade '+
  	' where cod_empresa = %d and tipo_ec = %s',
    [vDadosIni.cod_empresa, fstrq('descricao')]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Tipo de grade (E-commerce) está sendo usado em %d registros. ' +
    	' Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  if SqlOpen('select count(*) as contador from grade '+
  	' where cod_empresa = %d and tipo_ec1 = %s',
    [vDadosIni.cod_empresa, fstrq('descricao')]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Tipo de grade 2 (E-commerce) está sendo usado em %d registros. ' +
    	' Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  dataSet.Delete;
  if Apply then
  begin
    CommitaTransacao;
    Auditor.Sucesso.Salvar.GravarMensagem('');
    Refresh;
    Result := True;
  end
  else
  begin
    RollBackTransacao;
    Auditor.Falha.Salvar.GravarMensagem('');
    Result := False;
  end;
end;

function TTipoGrade.Post: Boolean;
var
  vcodigo: Integer;
begin
	Result := False;
  vcodigo := 0;
  try
    if fempty('descricao') then
      raiseExceptionCreate('Descricao deve ser preenchida');

    if not SqlOpen('select descricao from tipo_grade_ec where cod_empresa = %d and descricao = %s and cod_tipo <> %d',
                   [vDadosIni.cod_empresa, fstrq('descricao'), fint('cod_tipo')]).IsEmpty then
      raiseExceptionCreate('Já existe um tipo com a mesma descrição');

    fdata('cod_empresa').Put(vDadosIni.cod_empresa);
    fdata('ativo').Put(1);
    vcodigo := Gencodigo('TIPO_GRADE_EC', buscas, vDadosIni.codEmpresa);
    fdata('cod_tipo').Put(vcodigo);

    if inherited Post then
    begin
      Result := Apply;
      CommitaTransacao;
      with Auditor.Salvar.Sucesso do
      begin
      	SetChave(IntToStr(vcodigo));
      	GravarMensagem(fstr('descricao'));
      end;
      Refresh;
    end
    else
    begin
      Result := False;
      RollBackTransacao;
      with Auditor.Salvar.Falha do
      begin
      	SetChave(IntToStr(vcodigo));
      	GravarMensagem(fstr('descricao'));
      end;
    end;

  except on E: Exception do
    begin
      RollBackTransacao;
      Auditor.Salvar.Falha.GravarMensagem(fstr('descricao'));
      registraErro('TTipoGrade.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);
    end;
  end;
end;

