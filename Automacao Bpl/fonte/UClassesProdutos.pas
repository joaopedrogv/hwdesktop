  procedure GeraCodProdLote(AtualizarProduto: boolean; GrupoProd: string; CodProd: string; ManterNumeroFabricante: boolean; Acao: string;
  	var vGrupoProd: string; var vCodProd: string; var vNumFabProd: string);
	var
    qtdDigitos, i: integer;
    vOldGrupoProd, vOldCodProd, vOldNumFabProd: string;
  begin
  	vOldGrupoProd  := vGrupoProd;
    vOldCodProd 	 := vCodProd;
    vOldNumFabProd := vNumFabProd;

    if not vDadosIni.strIn(Acao, ['I', 'U']) then
      exit;

    for i := 1 to Length(vDadosIni.vProduto.vDigitosProd) do
      if (vDadosIni.vProduto.vDigitosProd[i] <> '0') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '1') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '2') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '3') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '4') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '5') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '6') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '7') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '8') and
        (vDadosIni.vProduto.vDigitosProd[i] <> '9') then
      begin
        Application.MessageBox(Pchar('Verifique a variável ''DigitosProd'' no arquivo de configuração do sistema.' + chr(13) + 'O seu valor ''' + vDadosIni.vProduto.vDigitosProd +
          ''' está incorreto e por esse motivo será setado para 5.'), 'Aviso', MB_OK + MB_ICONWARNING
          + MB_DEFBUTTON1);
        vDadosIni.vProduto.vDigitosProd := '5';
      end;
    if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
    begin
    	if Acao <> 'I' then
      begin
      	if not ManterNumeroFabricante then
        	vNumFabProd := vCodProd;
	      Exit;
      end;

      try
        vDadosIni.abreStatusProcessamento('', 'Obtendo provável código do produto');

        buscas.Close;
	      buscas.SQL.Text := ' SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS ' +
  	      '	WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME = ''PRODUTOS'' ' +
    	    ' AND RDB$RELATION_FIELDS.RDB$FIELD_NAME IN (''UNQ_GRUPO_PROD'', ''UNQ_COD_PROD'') ';
     		buscas.open;

      	vUsaReplicador := not buscas.IsEmpty;
        if vUsaReplicador then
        begin
          buscas.Close;
          buscas.SQL.Text := ' select max(cast(UNQ_COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
            ' and CHAR_LENGTH(TRIM(UNQ_COD_PROD))=' + vDadosIni.vProduto.vDigitosProd +
            ' union ' +
            ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
            ' and CHAR_LENGTH(TRIM(COD_PROD))=' + vDadosIni.vProduto.vDigitosProd +
            ' order by 1 desc ';
          buscas.open;
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
            ' and CHAR_LENGTH(TRIM(COD_PROD))=' + vDadosIni.vProduto.vDigitosProd;
          buscas.open;
        end;

        vCodMaxProd := buscas.FieldByName('MAXIMOCOD').AsInteger;

	      vCodMaxCodigo := Gencodigo('PRODUTOS', buscas, vDadosIni.codEmpresa) - 1;
        if buscas.Transaction.InTransaction then
        	buscas.Transaction.Commit;

        if (vCodMaxProd > vCodMaxCodigo) then
        	vCodMax := vCodMaxProd
        else
        	vCodMax := vCodMaxCodigo;

        for I := 0 to vListaEmp.Count - 1 do
	        if (StrToInt(vListaEmp[I]) <> StrToInt(vDadosIni.codEmpresa)) then
          begin
            buscas.Close;
            buscas.SQL.Text := 'select valor as MAXIMOCOD from codigo' +
              ' where COD_EMPRESA=' + vListaEmp[I] +
              ' and tabela = ''PRODUTOS''';
            buscas.open;

            if buscas.FieldByName('MAXIMOCOD').AsInteger > vCodMax then
              vCodMax := buscas.FieldByName('MAXIMOCOD').AsInteger;

            if not vReplicaoInterna then
              break;
          end;

        // Atualizar tabela código
        if (vCodMax > vCodMaxCodigo) then
        begin
          SqlExec(' update codigo set valor = ' + IntToStr(vCodMax + 1) +
            ' where tabela = ''PRODUTOS'' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);

          if buscas.Transaction.InTransaction then
            buscas.Transaction.Commit;

          buscas.Close;
          buscas.SQL.Text := 'select valor as MAXIMOCOD from codigo' +
            ' where COD_EMPRESA=' + vDadosIni.codEmpresa +
            ' and tabela = ''PRODUTOS''';
          buscas.open;
        end;

      finally
        vDadosIni.fechaStatusProcessamento;
      end;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := ' SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS ' +
        '	WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME = ''PRODUTOS'' ' +
        ' AND RDB$RELATION_FIELDS.RDB$FIELD_NAME IN (''UNQ_GRUPO_PROD'', ''UNQ_COD_PROD'') ';
      buscas.open;

      vUsaReplicador := not buscas.IsEmpty;

      vCodMax := 0;
      for I := 0 to vListaEmp.Count - 1 do
      begin
        if vUsaReplicador then
        begin
          buscas.Close;
          buscas.SQL.Text := ' select max(cast(UNQ_COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where UNQ_GRUPO_PROD=' + GrupoProd +
            ' and COD_EMPRESA=' + vListaEmp[I] +
            ' union ' +
            ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where GRUPO_PROD=' + GrupoProd +
            ' and COD_EMPRESA=' + vListaEmp[I] +
            ' order by 1 desc ';
          buscas.open;
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := ' select max(cast(COD_PROD as integer)) as MAXIMOCOD from produtos ' +
            ' where GRUPO_PROD=' + GrupoProd +
            ' and COD_EMPRESA=' + vListaEmp[I];
          buscas.open;
        end;
        if buscas.FieldByName('MAXIMOCOD').AsInteger > vCodMax then
        	vCodMax := buscas.FieldByName('MAXIMOCOD').AsInteger;

        if not vReplicaoInterna then
         	break;
      end;
    end;

    if vCodMax = 0 then
    	vCodProd := vDadosIni.StrZero(1, strtoint(vDadosIni.vProduto.vDigitosProd))
    else if vCodProd <> vDadosIni.StrZero(vCodMax + 1, strtoint(vDadosIni.vProduto.vDigitosProd)) then
      vCodProd := vDadosIni.StrZero(vCodMax + 1, strtoint(vDadosIni.vProduto.vDigitosProd));

    if Acao = 'I' then
    begin
      if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
      begin
        if trim(vOldNumFabProd) = trim(oldCodProd) then
					vNumFabProd := trim(vCodProd)
        else
          vNumFabProd := trim(vOldNumFabProd)
      end
      else
      begin
      	if trim(vOldNumFabProd) = trim(vOldGrupoProd) + trim(oldCodProd) then
      	  vNumFabProd := trim(GrupoProd) + trim(vCodProd)
        else
          vNumFabProd := trim(vOldNumFabProd);
      end;
    end
    else if trim(vCodProd) <> trim(CodProd) then
    begin
      if AtualizarProduto then
      begin
        if vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S' then
        begin
        	if trim(vOldNumFabProd) = trim(oldCodProd) then
						vNumFabProd := trim(vCodProd)
          else 
            vNumFabProd := trim(vOldNumFabProd)
        end
        else
        begin
          if trim(vOldNumFabProd) = trim(vOldGrupoProd) + trim(oldCodProd) then
            vNumFabProd := trim(GrupoProd) + trim(vCodProd)
          else
            vNumFabProd := trim(vOldNumFabProd);
        end;
      end;
    end;
	end;

