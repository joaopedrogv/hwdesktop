function TGrupoProdSimilares.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vGrupo_Sim: string;
  vDesc_Sim: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar    := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vGrupo_Sim := trim(dataSet.FieldByName('COD_GRUPO_SIM').AsString);
      vDesc_Sim  := trim(dataSet.FieldByName('DESCR_GRUPO').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar    := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vGrupo_Sim := '';
        vDesc_Sim  := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vGrupo_Sim) <> '') then
        prepare_loop('COD_GRUPO_SIM = ' + vGrupo_Sim)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'GRUPO SIMILAR' + #13 +
          'Código: ' + vGrupo_Sim + #13 +
          'Descrição: ' + vDesc_Sim;

        if (trim(vGrupo_Sim) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO348', 'EXCLUIR', '', 'PROD_SIMILARES_GRUPOS',
          vDadosIni.IfThen(trim(vGrupo_Sim) <> '', vGrupo_Sim, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'GRUPO SIMILAR' + #13 +
          'Código: ' + vGrupo_Sim + #13 +
          'Descrição: ' + vDesc_Sim;

        if (trim(vGrupo_Sim) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO349', 'EXCLUIR', '', 'PROD_SIMILARES_GRUPOS',
           vDadosIni.IfThen(trim(vGrupo_Sim) <> '', vGrupo_Sim, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo grupo(s) de similar permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo grupo(s) de similar para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo grupo(s) de similar permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo grupo(s) de similar para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' delete from prod_similares_grupos ' +
            ' where cod_grupo_sim = %d ' +
            ' and cod_empresa = %d ',
            [fint('cod_grupo_sim'), fint('cod_empresa')], buscas);
          if (trim(vGrupo_Sim) = '') then
            vDadosIni.GravaAuditoria('PRO348', 'EXCLUIR', '', 'PROD_SIMILARES_GRUPOS',
              dataSet.FieldByName('COD_GRUPO_SIM').AsString, buscas);
        end
        else
        begin
          SqlExec(' update prod_similares_grupos set ativo = 0 ' +
            ' where cod_grupo_sim = %d ' +
            ' and cod_empresa = %d ',
            [fint('cod_grupo_sim'), fint('cod_empresa')], buscas);

          if (trim(vGrupo_Sim) = '') then
            vDadosIni.GravaAuditoria('PRO349', 'EXCLUIR', '', 'PROD_SIMILARES_GRUPOS',
              dataSet.FieldByName('COD_GRUPO_SIM').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO348', 'PRO349'),
        'EXCLUIR', 'SUCESSO', 'PROD_SIMILARES_GRUPOS',
        vDadosIni.IfThen(trim(vGrupo_Sim) <> '', vGrupo_Sim, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO348', 'PRO349'),
        'EXCLUIR', 'FALHA', 'PROD_SIMILARES_GRUPOS',
        vDadosIni.IfThen(trim(vGrupo_Sim) <> '', vGrupo_Sim, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

