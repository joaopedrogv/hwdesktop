function TProdSimilares._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
begin
  result := true;
  rProdSim.vSqlAdicional := '';

  if rProdSim.vAdicional then
  begin
    if rProdSim.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rProdSim.vDataIniAd);
      except
        rProdSim.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rProdSim.vDataFimAd);
      except
        rProdSim.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rProdSim.vDataIniAd <> '' then
          rProdSim.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rProdSim.vDataIniAd)));
        if rProdSim.vDataFimAd <> '' then
          rProdSim.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rProdSim.vDataFimAd)));
      end;
    end
    else if rProdSim.vValorAd = '' then
      exit;
    if rProdSim.vCondicaoAd = 'Igual' then
      rProdSim.vCondicaoAd := '='
    else if rProdSim.vCondicaoAd = 'Maior' then
      rProdSim.vCondicaoAd := '>'
    else if rProdSim.vCondicaoAd = 'Maior ou Igual' then
      rProdSim.vCondicaoAd := '>='
    else if rProdSim.vCondicaoAd = 'Menor' then
      rProdSim.vCondicaoAd := '<'
    else if rProdSim.vCondicaoAd = 'Menor ou Igual' then
      rProdSim.vCondicaoAd := '<='
    else if rProdSim.vCondicaoAd = 'Diferente' then
      rProdSim.vCondicaoAd := '<>'
    else if (rProdSim.vCondicaoAd = 'Esta contido') then
      rProdSim.vCondicaoAd := 'like'
    else if (rProdSim.vCondicaoAd = 'Começa') then
      rProdSim.vCondicaoAd := 'Começa'
    else
      rProdSim.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rProdSim.vCampoAd) then
        begin
          rProdSim.vValorAd := ajustar_consulta_incasesensitive(DataSet.Fields[I], '', rProdSim.vValorAd);
//          if rProdSim.vCampo = rProdSim.vCampoAd then
//          begin
//            rProdSim.vsqlAdicional := '';
//            exit;
//          end;
          if (UpperCase(rProdSim.vCampoAd) <> 'NUMERO FABRICACAO PRODUTO')
            and	(UpperCase(rProdSim.vCampoAd) <> 'DESCRICAO PRODUTO')
            and (UpperCase(rProdSim.vCampoAd) <> 'NUMERO FABRICACAO PRODUTO SIMILAR') then
            rProdSim.vCampoAd := DataSet.Fields[I].FieldName;

          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rProdSim.vCondicaoAd = 'Começa') or (rProdSim.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rProdSim.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rProdSim.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rProdSim.vCondicaoAd := '=';
            rProdSim.vValorAd := vDadosIni.trocaVirgulaPorPonto(rProdSim.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (rProdSim.vDataIniAd <> '') and (rProdSim.vDataFimAd <> '') then
              rProdSim.vSqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd +
                ' >= ' + rProdSim.vDataIniAd + ' and ' + rProdSim.vCampoAd + ' <= ' + rProdSim.vDataFimAd
            else if (rProdSim.vDataFimAd <> '') then
              rProdSim.vsqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd +
                ' <= ' + rProdSim.vDataIniAd
            else if (rProdSim.vDataIniAd <> '') and (rProdSim.vDataFimAd <> '') then
              rProdSim.vsqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd +
                ' >= ' + rProdSim.vDataIniAd;
            Break;
          end;
          if rProdSim.vCondicaoAd = 'like' then
            rProdSim.vsqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd +
              ' like ' + QuotedStr('%' +
              rProdSim.vValorAd +
              '%')
          else if rProdSim.vCondicaoAd = 'Começa' then
            rProdSim.vsqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd +
              ' like ' +
              QuotedStr(rProdSim.vValorAd + '%')
          else
            rProdSim.vsqlAdicional := rProdSim.vsqlAdicional + rProdSim.vCampoAd + ' '
              + rProdSim.vCondicaoAd + ' ' +
              QuotedStr(rProdSim.vValorAd);

          if rProdSim.vCondicaoAd <> 'Começa' then
          begin
            if (UpperCase(rProdSim.vCampoAd) = 'NUMERO FABRICACAO PRODUTO') then
              rProdSim.vsqlAdicional := 'PRODUTOS.NUM_FAB_PROD ' + rProdSim.vCondicaoAd + ' ' + QuotedStr(rProdSim.vValorAd)
            else if (UpperCase(rProdSim.vCampoAd) = 'DESCRICAO PRODUTO') then
              rProdSim.vsqlAdicional := 'PRODUTOS.DESCR_PROD ' + rProdSim.vCondicaoAd + ' ' + QuotedStr(rProdSim.vValorAd)
            else if (UpperCase(rProdSim.vCampoAd) = 'NUMERO FABRICACAO PRODUTO SIMILAR') then
              rProdSim.vsqlAdicional := 'PR.NUM_FAB_PROD ' + rProdSim.vCondicaoAd + ' ' + QuotedStr(rProdSim.vValorAd)
            else
              rProdSim.vsqlAdicional := 'PROD_SIMILARES.' + rProdSim.vCampoAd + ' ' + rProdSim.vCondicaoAd + ' ' + QuotedStr(rProdSim.vValorAd);
          end
          else
          begin
            if (UpperCase(rProdSim.vCampoAd) = 'NUMERO FABRICACAO PRODUTO') then
              rProdSim.vsqlAdicional := 'PRODUTOS.NUM_FAB_PROD LIKE ' + QuotedStr(rProdSim.vValorAd + '%')
            else if (UpperCase(rProdSim.vCampoAd) = 'DESCRICAO PRODUTO') then
              rProdSim.vsqlAdicional := 'PRODUTOS.DESCR_PROD LIKE ' + QuotedStr(rProdSim.vValorAd + '%')
            else if (UpperCase(rProdSim.vCampoAd) = 'NUMERO FABRICACAO PRODUTO SIMILAR') then
              rProdSim.vsqlAdicional := 'PR.NUM_FAB_PROD LIKE ' + QuotedStr(rProdSim.vValorAd + '%')
            else
              rProdSim.vsqlAdicional := 'PROD_SIMILARES.' + rProdSim.vCampoAd + ' LIKE' + QuotedStr(rProdSim.vValorAd + '%');
          end;

          Break;
        end;
      end;
    end;
  end;

  tempSql := '';

  if Trim(rProdSim.vValor) <> '' then
    for I := 0 to dataSet.FieldCount - 1 do
      if Dataset.Fields[I].FieldKind = fkData then
        if ContainsText(dataset.Fields[I].DisplayName, rProdSim.vCampo) then
        begin
          rProdSim.vValor := ajustar_consulta_incasesensitive(DataSet.Fields[I], '', rProdSim.vValor);
          Break;
        end;

  if UpperCase(rProdSim.vCampo) = 'NUMERO FABRICACAO PRODUTO' then
    tempSql := 'PRODUTOS.NUM_FAB_PROD '
  else if UpperCase(rProdSim.vCampo) = 'DESCRICAO PRODUTO' then
    tempSql := 'PRODUTOS.DESCR_PROD '
  else if UpperCase(rProdSim.vCampo) = 'NUMERO FABRICACAO PRODUTO SIMILAR' then
    tempSql := 'PR.NUM_FAB_PROD ';

  if tempSql  <> '' then
  begin
    if rProdSim.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rProdSim.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rProdSim.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rProdSim.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rProdSim.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rProdSim.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rProdSim.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rProdSim.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + rProdSim.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(rProdSim.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(rProdSim.vValor);
    rProdSim.vValor := '';
    if Trim(rProdSim.vSqlAdicional) <> '' then
      rProdSim.vSqlAdicional := rProdSim.vSqlAdicional + ' and ' + tempSql
    else
      rProdSim.vSqlAdicional := tempSql;
  end;
end;

