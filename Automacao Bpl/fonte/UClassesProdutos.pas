function TProdutos.relEtiquetaX(ImprimirQtdEmEstoque,
  pImprimirProdutosMarcados: Boolean; grid: TDBGrid): boolean;
var
  formulario: TfrmPadrao;
  vSomenteSelecionado: boolean;
  i: integer;
  vOK: Boolean;
begin
	if grid.DataSource.DataSet.IsEmpty then
  begin
  	Application.MessageBox(PChar('Nenhum produto informado.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  vSomenteSelecionado := Application.MessageBox('Imprimir somente selecionados?',
  	'Confirmação', MB_YESNO + MB_ICONQUESTION) = ID_YES;

  if vSomenteSelecionado then
  begin
  	vOK := False;

    try
      grid.DataSource.DataSet.DisableControls;
      grid.DataSource.DataSet.First;
      while not grid.DataSource.DataSet.Eof do
      begin
        if grid.DataSource.DataSet.FieldByName('sel').AsString = 'S' then
        begin
          vOK := True;
          Break;
        end;

        grid.DataSource.DataSet.Next;
      end;
    finally
      grid.DataSource.DataSet.First;
  		grid.DataSource.DataSet.EnableControls;
    end;

    if not vOK then
    begin
    	Application.MessageBox(PChar('Nenhum produto selecionado.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      Exit;
    end;
  end;

  if not vDadosIni.testarCodBarrasEtiqueta(vSomenteSelecionado, grid, True) then
    exit;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 800;
    formulario.Height := 600;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Seleção do modelo de etiqueta';
    if dsModEtiTermicaTemp = nil then
      dsModEtiTermicaTemp := TDataSource.Create(nil);
    FrmCadProdutos.DBEditCodModEti.DataSource := dsModEtiTermicaTemp;
    FrmCadProdutos.DBEditModImp.DataSource := dsModEtiTermicaTemp;
    FrmCadProdutos.DBEditScript.DataSource := dsModEtiTermicaTemp;
    FrmCadProdutos.DBLookupComboBoxModEtiT.ListSource := dsModEtiTermicaTemp;
    FrmCadProdutos.DBEditCodModEti.DataField := 'CODIGO';
    FrmCadProdutos.DBEditModImp.DataField := 'MODELOIMP';
    FrmCadProdutos.DBEditScript.DataField := 'LSCRIPT';
    FrmCadProdutos.DBLookupComboBoxModEtiT.ListField := 'DESCRICAO';
    FrmCadProdutos.DBLookupComboBoxModEtiT.KeyField := 'CODIGO';

    buscas.Close;
    buscas.SQL.Text := ' SELECT * FROM MODELOETITERMICA ' +
    	' WHERE ATIVO = 1 ' +
      ' AND COD_EMPRESA = ' +  vDadosIni.codEmpresa +
      ' ORDER BY CODIGO ';
    buscas.Open;
    buscas.FetchAll;
    dsModEtiTermicaTemp.DataSet := buscas;
    if buscas.IsEmpty then
    begin
      Application.MessageBox('Nenhum modelo de etiqueta foi cadastrado.' + chr(13) +
        'Favor verificar.', 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;
    if buscas.FieldByName('codigo').IsNull then
    begin
      Application.MessageBox('Favor selecionar um modelo de etiqueta.', 'Atenção', MB_OK +
        MB_ICONEXCLAMATION);
      exit;
    end;
    FrmCadProdutos.DBLookupComboBoxModEtiT.KeyValue := buscas.FieldByName('codigo').AsInteger;
    FrmCadProdutos.pnModEtiTermica.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.KeyPreview := True;
    result := (formulario.ShowModal = IDOK);
  finally
    dsModEtiTermicaTemp := nil;
    FrmCadProdutos.DBEditCodModEti.DataSource := nil;
    FrmCadProdutos.DBEditModImp.DataSource := nil;
    FrmCadProdutos.DBEditScript.DataSource := nil;
    FrmCadProdutos.DBLookupComboBoxModEtiT.ListSource := nil;
    if result then
    begin
      if vRelEtiquetaX = nil then
        vRelEtiquetaX := TRelatoriosEtiTermica.create;
      vRelEtiquetaX.grid := TDBGrid(grid);
      vRelEtiquetaX.somenteSelecionado := vSomenteSelecionado;
      vRelEtiquetaX.ImprimirProdutosMarcados := pImprimirProdutosMarcados;
      vRelEtiquetaX.ImprimirQtdEstoque := ImprimirQtdEmEstoque;
      vRelEtiquetaX._imprimirTermicaX(buscas.FieldByName('codigo').AsInteger);
    end;
    buscas.Close;
    FrmCadProdutos.pnModEtiTermica.Parent := FrmCadProdutos.tsModEtiTermica;
    formulario.Free;
    formulario := nil;
  end;
end;

