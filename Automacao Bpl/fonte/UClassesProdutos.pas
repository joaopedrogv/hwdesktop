constructor TNBS.create;
begin
  DataSet := TClientDataSet(DtmProdutos.cdsNBS);
  transacao := TIBTransaction(DtmProdutos.IBTransNBS);
  Buscas := TIBQuery(DtmProdutos.qrBuscasP);
