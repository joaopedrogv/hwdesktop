function TProdutos.verMatInsumosProducao(
	pNatureza: string;
  pGrupoProd: Integer;
  pCodProd: string;
  pCodProducao: Integer = 0;
  pNitem: Integer = 0): boolean;
var
  I: Integer;
begin
	try
  	try
      Result := true;

      cdsProdutosMatInsumos := TClientDataSet(dtmProdutos.cdsProdutosMatInsumo);
      cdsEstoqueDiarioMatInsumos := TClientDataSet(dtmProdutos.cdsEstoqueDiarioMatInsumo);
      cdsEstoqueDiarioMatInsumosProducao := TClientDataSet(dtmProdutos.cdsProdutosMatInsumoProducao);

      if pNatureza = 'E' then
      begin
      	FrmCadProdutos.lbAcabGrupo.Caption := IntToStr(dataSet.FieldByName('grupo_prod').AsInteger);
      	FrmCadProdutos.lbAcabCod.Caption := trim(dataSet.FieldByName('cod_prod').AsString);
      	FrmCadProdutos.lbAcabNum.Caption := trim(dataSet.FieldByName('num_fab_prod').AsString);
      end
      else
      begin
      	buscas.Close;
        buscas.SQL.Text := ' select pi.grupo_prod, pi.cod_prod, pr.num_fab_prod from producao p ' +
        	' inner join producao_item pi on ' +
          '   pi.cod_producao = p.cod_producao ' +
          '   and pi.cod_empresa = p.cod_empresa ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pi.grupo_prod ' +
          '   and pr.cod_prod = pi.cod_prod ' +
          '   and pr.cod_empresa = pi.cod_empresa ' +
          ' inner join producao_item_indice pii on ' +
          '   pii.cod_producao = pi.cod_producao ' +
          '   and pii.cod_empresa = pi.cod_empresa ' +
          '   and pii.nitem = pi.nitem ' +
          ' where pii.cod_producao = :cod_producao ' +
          ' and pii.nitem = :nitem ' +
          ' and pii.grupo_prod = :grupo_prod ' +
          ' and pii.cod_prod = :cod_prod ' +
          ' and pii.cod_empresa = :cod_empresa ';
        buscas.ParamByName('cod_producao').AsInteger := pCodProducao;
        buscas.ParamByName('nitem').AsInteger := pNitem;
        buscas.ParamByName('grupo_prod').AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
        buscas.ParamByName('cod_prod').AsString := dataSet.FieldByName('cod_prod').AsString;
        buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.Open;

        FrmCadProdutos.lbAcabGrupo.Caption := IntToStr(buscas.FieldByName('grupo_prod').AsInteger);
      	FrmCadProdutos.lbAcabCod.Caption := trim(buscas.FieldByName('cod_prod').AsString);
      	FrmCadProdutos.lbAcabNum.Caption := trim(buscas.FieldByName('num_fab_prod').AsString);
      end;

      if pCodProducao > 0 then
      begin
        cdsProdutosMatInsumos.Close;
        cdsProdutosMatInsumos.CommandText := ' select distinct ' +
          ' pii.grupo_prod, pii.cod_prod, pii.num_fab_prod, ' +
          ' coalesce(pii.quantidade_utilizada, 0) quantidade, ' +
          ' (coalesce(pii.quantidade_utilizada, 0) * coalesce(pii.prec_cusm_prod, 0)) custo, ' +
          ' coalesce(pii.prec_cusm_prod, 0) prec_cus_prod, ' +
          ' coalesce(pii.prec_cusm_prod, 0) prec_cusmr_prod, ' +
          ' pii.descr_prod from producao p ' +
          ' inner join producao_item_indice pii on ' +
          '   p.cod_producao = pii.cod_producao ' +
          '   and p.cod_empresa = pii.cod_empresa ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pii.grupo_prod ' +
          '   and pr.cod_prod = pii.cod_prod ' +
          '   and pr.cod_empresa = pii.cod_empresa ' +
          ' where pii.cod_producao = :cod_producao ' +
          ' and pii.nitem = :nitem ' +
          ' and pii.cod_empresa = :cod_empresa ' +
          ' and p.status = ''FECHADO'' ';
        cdsProdutosMatInsumos.Params.ParamByName('cod_producao').AsInteger := pCodProducao;
        cdsProdutosMatInsumos.Params.ParamByName('nitem').AsInteger := pNitem;
        cdsProdutosMatInsumos.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        cdsProdutosMatInsumos.Open;
      end
      else
      begin
        cdsProdutosMatInsumos.Close;
        cdsProdutosMatInsumos.CommandText := ' select distinct ' +
          ' pii.grupo_prod, pii.cod_prod, pr.num_fab_prod, ' +
          ' 0.000 quantidade, ' +
          ' 0.000 custo, ' +
          ' coalesce(pr.prec_cus_prod, 0) prec_cus_prod, ' +
          ' coalesce(pr.prec_cusm_prod, 0) prec_cusmr_prod, ' +
          ' pr.descr_prod from producao p ' +
          ' inner join producao_item pi on ' +
          '   p.cod_producao = pi.cod_producao ' +
          '   and p.cod_empresa = pi.cod_empresa ' +
          ' inner join producao_item_indice pii on ' +
          '   pi.cod_producao = pii.cod_producao ' +
          '   and pi.cod_empresa = pii.cod_empresa ' +
          '   and pi.nitem = pii.nitem ' +
          ' inner join produtos pr on ' +
          '   pr.grupo_prod = pii.grupo_prod ' +
          '   and pr.cod_prod = pii.cod_prod ' +
          '   and pr.cod_empresa = pii.cod_empresa ' +
          ' where pi.grupo_prod = :grupo_prod '+
          ' and pi.cod_prod = :cod_prod ' +
          ' and pi.cod_empresa = :cod_empresa ' +
          ' and p.status = ''FECHADO'' ';
        cdsProdutosMatInsumos.Params.ParamByName('grupo_prod').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        cdsProdutosMatInsumos.Params.ParamByName('cod_prod').AsString := dataSet.FieldByName('COD_PROD').AsString;
        cdsProdutosMatInsumos.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        cdsProdutosMatInsumos.Open;
      end;

      if not cdsProdutosMatInsumos.IsEmpty then
      begin
        abreEstoqueDiarioMatInsumos (
          cdsProdutosMatInsumos.FieldByName('grupo_prod').AsInteger,
          cdsProdutosMatInsumos.FieldByName('cod_prod').AsString,
          StrToDateTime('01/01/1900'),
        	Date);

        if not cdsEstoqueDiarioMatInsumos.IsEmpty then
        begin
					abreEstoqueDiarioMatInsumosProducao (
            cdsEstoqueDiarioMatInsumos.FieldByName('grupo_prod').AsInteger,
            cdsEstoqueDiarioMatInsumos.FieldByName('cod_prod').AsString,
            cdsEstoqueDiarioMatInsumos.FieldByName('data').AsDateTime);
        end
        else
        begin
          abreEstoqueDiarioMatInsumosProducao (
            0,
            '',
            StrToDateTime('01/01/1900'));
        end;
      end
      else
      begin
        abreEstoqueDiarioMatInsumos (
          0,
          '',
          StrToDateTime('01/01/1900'),
        	StrToDateTime('01/01/1900'));

        abreEstoqueDiarioMatInsumosProducao (
          0,
          '',
          StrToDateTime('01/01/1900'))
      end;

      cdsProdutosMatInsumos.AfterScroll := datasetAfterScrollProdutosMatInsumo;
      cdsEstoqueDiarioMatInsumos.AfterScroll := datasetAfterScrollEstoqueMatInsumo;
      if pCodProducao > 0 then
      begin
        if not vDadosIni.abreForm('PRODUÇÃO Nº ' + IntToStr(pCodProducao), FrmCadProdutos.pnProdutosMatInsumos, [ofEscapeExit, ofAlignAllClientWinCtrl]) then
        	exit;
      end
      else
      begin
      	if not vDadosIni.abreForm('Matérias Primas/Insumos/Embalagens', FrmCadProdutos.pnProdutosMatInsumos, [ofEscapeExit, ofAlignAllClientWinCtrl]) then
        	exit;
      end;

      cdsProdutosMatInsumos.AfterScroll := nil;
      cdsEstoqueDiarioMatInsumos.AfterScroll := nil;

    finally
    	vDadosIni.fechaStatusProcessamento;
    end;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.verMatInsumosProducao. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.verProdutosMarcadosParaEtiqueta: boolean;
var
  i: integer;
begin
  result := false;

  if not ExecutaComandosSql('select first 1 ibp.nitem from imp_bar_prod ibp ' +
    ' inner join produtos p on ' +
    '		ibp.cod_empresa = p.cod_empresa ' +
    ' 	and ibp.grupo_prod = p.grupo_prod ' +
    '		and ibp.cod_prod=p.cod_prod ' +
    ' where p.ativo=1 and p.cod_empresa=' + vDadosIni.codEmpresa) then
  begin
    Application.MessageBox('Não existe nenhum produto marcado.',
      'Aviso', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  if dtSetProdTemp = nil then
  begin
    dtSetProdTemp := TClientDataSet(dtmProdutos.cdsProdTemp);
    dtSetProdTemp.Close;
    dtSetProdTemp.FieldDefs.Clear;
    //    buscas.Close;
    //    buscas.SQL.Text := 'select first 0  p.* from produtos p where p.cod_empresa= ' + vDadosIni.codEmpresa;
    //    buscas.Open;
    dtSetProdTemp.FieldDefs.Add('SEL', ftString, 1, false);
    dtSetProdTemp.FieldDefs.Add('NITEM', ftInteger, 0, false);
    dtSetProdTemp.FieldDefs.Add('DT_MARCACAO', ftDateTime, 0, false);
    for I := 0 to dataSet.FieldDefs.Count - 1 do
    begin
      if dataSet.FieldDefs[i].Name <> 'SEL' then
        dtSetProdTemp.FieldDefs.Add(
          dataSet.FieldDefs[i].Name,
          dataSet.FieldDefs[i].DataType,
          dataSet.FieldDefs[i].Size,
          false);
    end;
    dtSetProdTemp.FieldDefs.Add('COD_GRADE', ftInteger, 0, false);
    dtSetProdTemp.FieldDefs.Add('DESCRICAO', ftString, 32, false);
    dtSetProdTemp.FieldDefs.Add('DESCRICAO1', ftString, 32, false);
    dtSetProdTemp.FieldDefs.Add('BARCODE', ftString, 20, false);
    dtSetProdTemp.FieldDefs.Add('BARCODE_EAN', ftString, 20, false);
    dtSetProdTemp.close;
    dtSetProdTemp.CreateDataSet;
  end;
  dtSetProdTemp.EmptyDataSet;
  dtSetProdTemp.Fields.FindField('NITEM').DisplayLabel := 'Num. Item';
  dtSetProdTemp.Fields.FindField('DT_MARCACAO').DisplayLabel := 'Data Marcação';
  for i := 0 to dataSet.Fields.Count - 1 do
  begin
    dtSetProdTemp.Fields.FindField(dataSet.Fields[I].FieldName).DisplayLabel :=
      dataSet.Fields[I].DisplayLabel;
    
