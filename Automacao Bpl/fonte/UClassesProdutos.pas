function TTipoVenda._abreTipoVenda(cod_promocao, tipo, grupo_prod, cod_prod: string): Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select 1 first from promocao_produto ' +
    ' where cod_promocao = ' + cod_promocao +
    ' and cod_tppreco = ' + tipo +
    ' and grupo_prod  = ' + grupo_prod +
    ' and cod_prod = ' + QuotedStr(cod_prod) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (buscas.FieldByName('first').AsInteger = 0) then
    Result := montaSelect(' select t.cod_tipo, t.sigla, t.descricao from tipo_vendas t ' +
      ' where t.tipo = ''REQ'' ' +
      ' union ' +
      ' select 0, ''0'', ''0 - TODOS'' from rdb$database')
  else
    Result := montaSelect('select t.cod_tipo, t.sigla, t.descricao from tipo_vendas t ' +
      ' where t.tipo = ''REQ'' ');
end;

function TTipoVenda._abreTipoVenda: boolean;
begin
 Result := montaSelect('select t.cod_tipo, t.sigla, t.descricao from tipo_vendas t ' +
      ' where t.tipo = ''REQ'' ' +
      ' union ' +
      ' select 0, ''0'', ''0 - TODOS'' from rdb$database');
end;

function TTipoVenda._abreTipoVenda(grupo_prod, cod_prod: string; qtde: Double): boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select first 1 grupo_prod, cod_prod from preco_produtos_qtde ' +
    ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod and cod_empresa = :cod_empresa ' +
    ' and quant = :quant ';
  buscas.ParamByName('grupo_prod').AsString := grupo_prod;
  buscas.ParamByName('cod_prod').AsString := cod_prod;
  buscas.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;
  buscas.ParamByName('quant').AsFloat := qtde;
  buscas.Open;

  if buscas.IsEmpty then
    Result := montaSelect('select t.cod_tipo, t.sigla, t.descricao from tipo_vendas t ' +
      ' where t.tipo = ''REQ'' ' +
      ' union ' +
      ' select 0,''0'', ''0 - TODOS'' from rdb$database ')
  else
    Result := montaSelect('select t.cod_tipo, t.sigla, t.descricao from tipo_vendas t ' +
      ' where t.tipo = ''REQ'' ');
end;

