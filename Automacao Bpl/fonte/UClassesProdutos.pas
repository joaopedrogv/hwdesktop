function TGradeEstoque._verificarEstProdSemGradeVinc(prod: TProdutos): boolean;
var
  vEstoque, vEstoqueG: Extended;
begin
  Result := True;

//  buscas.Close;
//  buscas.SQL.Text := 'select est_f from produtos' +
//    ' where grupo_prod = ' + IntToStr(prod.dataSet.FieldByName('grupo_prod').AsInteger) +
//    ' and cod_prod = ' + QuotedStr(prod.dataSet.FieldByName('cod_prod').AsString) +
//    ' and cod_empresa = ' + IntToStr(prod.dataSet.FieldByName('cod_empresa').AsInteger);
//  buscas.Open;
//
//  if buscas.FieldByName('est_f').AsFloat = 0 then // caso seja positivo ou negativo as grades deverão ser vinculadas
//    Exit;
//  vEstoque := buscas.FieldByName('est_f').AsFloat;

  vEstoque := vDadosIni.getEstoqueDisponivel(buscas,
    prod.dataSet.FieldByName('grupo_prod').AsInteger,
    prod.dataSet.FieldByName('cod_prod').AsString);

  if vEstoque = 0 then // caso seja positivo ou negativo as grades deverão ser vinculadas
    Exit;

  vEstoqueG := 0;

  buscas.Close;
  buscas.SQL.Text := 'select qtde from cod_grade_prod' +
    ' where grupo_prod = ' + IntToStr(prod.dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(prod.dataSet.FieldByName('cod_prod').AsString) +
    ' and cod_empresa = ' + IntToStr(prod.dataSet.FieldByName('cod_empresa').AsInteger);
  buscas.Open;

  if not buscas.IsEmpty then // caso seja positivo ou negativo as grades deverão ser vinculadas
    Exit;

  Application.MessageBox(pchar('Produto selecionado já possui estoque. Será necessário distribuir o estoque entre as grades.'+
    ' Feito isso a alteração de estoque somente poderá ser realizada no dia seguinte!' + #13 +
    'Estoque: ' + Format('%0.3f', [vEstoque])), 'Atenção', 0 + 64);

  vEstoque := prod.getQuantidadePendenteReqOS(prod.dataSet.FieldByName('grupo_prod').AsInteger,
    prod.dataSet.FieldByName('cod_prod').AsString);

  if vEstoque > 0 then
  begin
    Result := False;
    Application.MessageBox(pchar('Produto selecionado possui pendências em saídas (Pedidos de Venda, Ordens de Serviço ou Produção própria).'+
      ' Enquanto houver pendências não será possível vincular as grades!' + #13 +
      'Pendências: ' + Format('%0.3f', [vEstoque])), 'Atenção', 0 + 64);
    Exit;
  end;

  vGrade.montaSelect('SELECT * FROM GRADE WHERE ativo = 1 and cod_grade > 0 and cod_empresa = ' +
    vDadosIni.codEmpresa);

  Result := False;

  if not _abreFormEscolhaGradeComCampoEstoque(prod) then
    Exit;

  if prod.getQuantidadePendenteReqOS(prod.fint('grupo_prod'), prod.fstr('cod_prod')) > 0 then 
  begin
    Result := False;
    Application.MessageBox(pchar('Produto selecionado possui pendências em saídas (Pedidos de Venda, Ordens de Serviço ou Produção própria).'+
      ' Enquanto houver pendências não será possível vincular as grades!' + #13 +
      'Pendências: ' + Format('%0.3f', [vEstoque])), 'Atenção', 0 + 64);
    Exit;
  end;

//  buscas.Close;
//  buscas.SQL.Text := 'select est_f from produtos' +
//    ' where grupo_prod = ' + IntToStr(prod.dataSet.FieldByName('grupo_prod').AsInteger) +
//    ' and cod_prod = ' + QuotedStr(prod.dataSet.FieldByName('cod_prod').AsString) +
//    ' and cod_empresa = ' + IntToStr(prod.dataSet.FieldByName('cod_empresa').AsInteger);
//  buscas.Open;
//
//  vEstoque := buscas.FieldByName('est_f').AsFloat; // caso tenha alguma alteracao de estoque no momento que o usuario estava distribuindo as grades

  // caso tenha alguma alteracao de estoque no momento que o usuario estava distribuindo as grades
  vDadosIni.vDataHora := vDadosIni.getDataHoraBanco(buscas);
  vEstoque := vDadosIni.getEstoqueDisponivel(buscas,
    prod.dataSet.FieldByName('grupo_prod').AsInteger,
    prod.dataSet.FieldByName('cod_prod').AsString);

  try

    try
      vGrade.dataSet.Filter := 'EST_TEMP < 0 OR EST_TEMP > 0';
      vGrade.dataSet.Filtered := True;

      vGrade.dataSet.First;
      while not vGrade.dataSet.Eof do
      begin
        vEstoqueG := vEstoqueG + vGrade.dataSet.FieldByName('est_temp').AsFloat;
        vGrade.dataSet.Next;
      end;

      if vDadosIni.StrToFloatFormat(vEstoque, 3) <>
        vDadosIni.StrToFloatFormat(vEstoqueG, 3) then
        raiseExceptionCreate('Estoque distribuido entre as grades difere do estoque do produto' + #13 +
          'Estoque do Produto: ' + Format('%0.3f', [vEstoque]) + #13 +
          'Estoque distribuido: ' + Format('%0.3f', [vEstoqueG]), '');

      // zerando o produto
      vMovimentaEstoque.Close;
      vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := prod.dataSet.Fieldbyname('GRUPO_PROD').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := prod.dataSet.Fieldbyname('COD_PROD').AsString;
      vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := prod.dataSet.Fieldbyname('COD_EMPRESA').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := 0;
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := vEstoque;
      vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
      vMovimentaEstoque.Prepare;
      vMovimentaEstoque.ExecProc;

      //historico ao zerar
      buscas.Close;
      buscas.SQL.Text :=
         ' insert into HIST_ESTOQUE_DIARIO_PROD ' +
         ' (TIPO, SEQID, COD_EMPRESA, TIPOR, NATUREZA, DATA, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE) ' +
         ' VALUES ' +
         ' (:TIPO, (select cod from incrementa_codigo(:COD_EMPRESA, ''HIST_ESTOQUE_DIARIO_PROD'')),' +
         '  :COD_EMPRESA, :TIPOR, :NATUREZA, :DATA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE)';
      buscas.ParamByName('TIPO').AsString := 'P';
      buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
      buscas.ParamByName('TIPOR').AsString := 'COR';
      buscas.ParamByName('NATUREZA').AsString := 'S';
      buscas.ParamByName('DATA').AsDateTime := DateOf(vDadosIni.vDataHora);
      buscas.ParamByName('GRUPO_PROD').AsInteger := prod.dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := prod.dataSet.FieldByName('COD_PROD').AsString;
      buscas.ParamByName('COD_GRADE').AsInteger := 0;
      buscas.ParamByName('QTDE').AsFloat := vEstoque;
      buscas.ExecSQL;

      vGrade.dataSet.First;
      while not vGrade.dataSet.Eof do
      begin
        {
        buscas.Close;
        buscas.SQL.Text := 'insert into cod_grade_prod (grupo_prod, cod_prod, cod_grade, cod_empresa, qtde)' +
          ' values (:grupo_prod, :cod_prod, :cod_grade, :cod_empresa, :qtde)';
        buscas.ParamByName('grupo_prod').AsInteger := prod.dataSet.Fieldbyname('grupo_prod').AsInteger;
        buscas.ParamByName('cod_prod').AsString := prod.dataSet.Fieldbyname('cod_prod').AsString;
        buscas.ParamByName('cod_grade').AsInteger := vGrade.dataSet.Fieldbyname('cod_grade').AsInteger;
        buscas.ParamByName('cod_empresa').AsInteger := prod.dataSet.Fieldbyname('cod_empresa').AsInteger;
        buscas.ParamByName('qtde').AsFloat := vGrade.dataSet.FieldByName('est_temp').AsFloat;
        buscas.ExecSQL;
        }

        vGrade.dataSet.Next;
      end;

      vGrade.dataSet.First;
      while not vGrade.dataSet.Eof do
      begin

        vMovimentaEstoque.Close;
        vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := prod.dataSet.Fieldbyname('GRUPO_PROD').AsInteger;
        vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := prod.dataSet.Fieldbyname('COD_PROD').AsString;
        vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := prod.dataSet.Fieldbyname('COD_EMPRESA').AsInteger;
        vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := vGrade.dataSet.Fieldbyname('COD_GRADE').AsInteger;
        vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := Abs(IfThen(vGrade.ffloat('est_temp') > 0, vGrade.ffloat('est_temp')));
        vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := Abs(IfThen(vGrade.ffloat('est_temp') < 0, vGrade.ffloat('est_temp')));
        vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
        vMovimentaEstoque.Prepare;
        vMovimentaEstoque.ExecProc;

        buscas.Close;
        buscas.SQL.Text :=
           ' insert into HIST_ESTOQUE_DIARIO_PROD ' +
           ' (TIPO, SEQID, COD_EMPRESA, TIPOR, NATUREZA, DATA, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE) ' +
           ' VALUES ' +
           ' (:TIPO, (select cod from incrementa_codigo(:COD_EMPRESA, ''HIST_ESTOQUE_DIARIO_PROD'')),' +
           '  :COD_EMPRESA, :TIPOR, :NATUREZA, :DATA, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE)';
        buscas.ParamByName('TIPO').AsString := 'P';
        buscas.ParamByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('TIPOR').AsString := 'COR';
        buscas.ParamByName('NATUREZA').AsString := IfThen(vGrade.ffloat('est_temp') > 0, 'E', 'S');
        buscas.ParamByName('DATA').AsDateTime := DateOf(vDadosIni.vDataHora);
        buscas.ParamByName('GRUPO_PROD').AsInteger := prod.dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := prod.dataSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_GRADE').AsInteger := vGrade.dataSet.FieldByName('COD_GRADE').AsInteger;
        buscas.ParamByName('QTDE').AsFloat := Abs(vGrade.ffloat('est_temp'));
        buscas.ExecSQL;

        vGrade.dataSet.Next;
      end;

//      buscas.Close;
//      buscas.SQL.Text := 'select est_f from produtos' +
//        ' where grupo_prod = ' + IntToStr(prod.dataSet.FieldByName('grupo_prod').AsInteger) +
//        ' and cod_prod = ' + QuotedStr(prod.dataSet.FieldByName('cod_prod').AsString) +
//        ' and cod_empresa = ' + IntToStr(prod.dataSet.FieldByName('cod_empresa').AsInteger);
//      buscas.Open;
//
//      vEstoque := buscas.FieldByName('est_f').AsFloat; //teste final para saber se nao houve alteração por outro usuario

      //teste final para saber se nao houve alteração por outro usuario
      vEstoque := vDadosIni.getEstoqueDisponivel(buscas,
        prod.dataSet.FieldByName('grupo_prod').AsInteger,
        prod.dataSet.FieldByName('cod_prod').AsString);

      if vDadosIni.StrToFloatFormat(vEstoque, 3) <>
        vDadosIni.StrToFloatFormat(vEstoqueG, 3) then
        raiseExceptionCreate('Estoque distribuido entre as grades difere do estoque do produto' + #13 +
          'Estoque do Produto: ' + Format('%0.3f', [vEstoque]) + #13 +
          'Estoque distribuido: ' + Format('%0.3f', [vEstoqueG]), '');

      buscas.Close;
      buscas.SQL.Text := 'update config_sistema set value1_vc = null' +
        ' where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and chave = ' + QuotedStr('prcss_montar_estoque_diario_30_12_1899') +
        ' and value1_vc is not null';
      buscas.ExecSQL;

      CommitaTransacao;

      if (vDadosIni.vEmp.vUsarProducao = 'S')
      	and (vDadosIni.existeMateriaPrima(prod.buscas,
          		prod.dataSet.FieldByName('grupo_prod').AsInteger,
		          prod.dataSet.FieldByName('cod_prod').AsString)) then
      begin
      	if vDadosIni.produtoAcabadoPrimaTemGrade(
          prod.buscas,
          prod.dataSet.FieldByName('grupo_prod').AsInteger,
          prod.dataSet.FieldByName('cod_prod').AsString,
          0,
          '') then
        begin
          if vDadosIni.existeGradeProducao(
            prod.buscas,
            prod.dataSet.FieldByName('grupo_prod').AsInteger,
            prod.dataSet.FieldByName('cod_prod').AsString,
            0,
            '') then
          begin
            if not vDadosIni.vincularProdutoAcabadoMateriaPrima(
            	prod.buscas,
              prod.dataSet.FieldByName('grupo_prod').AsInteger,
              prod.dataSet.FieldByName('cod_prod').AsString,
              0,
              0,
              '',
              0,
              true) then
                exit;
          end;
        end;
      end
      else if (vDadosIni.vEmp.vUsarProducao = 'S') then
      begin
        if vDadosIni.retornaProdutosAcabado(
          prod.buscas,
	        prod.dataSet.FieldByName('grupo_prod').AsInteger,
  	      prod.dataSet.FieldByName('cod_prod').AsString) then
        begin
       	  vDadosIni.vDtSetTmpProducao.First;
          while not vDadosIni.vDtSetTmpProducao.Eof do
          begin
          	if vDadosIni.produtoAcabadoPrimaTemGrade(
              prod.buscas,
              vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
              vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
              0,
              '') then
        		begin
              if vDadosIni.existeGradeProducao(
                prod.buscas,
                vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
                vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
                0,
                '') then
              begin
                if not vDadosIni.vincularProdutoAcabadoMateriaPrima(
                	prod.buscas,
                  vDadosIni.vDtSetTmpProducao.FieldByName('grupo_prod').AsInteger,
                  vDadosIni.vDtSetTmpProducao.FieldByName('cod_prod').AsString,
                  0,
                  0,
                  '',
                  0,
                  true) then
                    exit;
              end;
            end;

            vDadosIni.vDtSetTmpProducao.Next;
          end;
        end;
      end;

      Result := True;

    finally
      vGrade.dataSet.Filtered := False;
      vGrade.dataSet.Filter := '';
    end;
  except
    on E: Exception do
    begin
      RollBackTransacao;
      Result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_OK + MB_ICONERROR);
      registraErro('function TGradeEstoque._verificarEstProdSemGradeVinc. Erro: ' + e.Message);
    end;
  end;
end;

