procedure TFichaInventario.FichaInventarioBeforePrint(Sender: TQRCustomBand;
  var PrintBand: Boolean);
begin
  if queryProd.FieldByName('COD_GRADE').AsInteger <> 0 then
  begin
    EstoqueAtual := ((queryProd.FieldByName('Est_R').AsFloat +
      queryProd.FieldByName('Est_F').AsFloat) -
      (_PegarReqOsGrade(queryProd.FieldByName('COD_PROD').AsString,
      queryProd.FieldByName('GRUPO_PROD').asstring, queryProd.FieldByName('COD_GRADE').AsString)));
    buscas.close;
    buscas.SQL.Text := 'SELECT DESCRICAO FROM GRADE WHERE COD_GRADE = ' +
      queryProd.FieldByName('COD_GRADE').AsString + ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;
    FrmFichaInv.QrLbGradComEti.Caption := buscas.FieldByName('DESCRICAO').AsString;
  end
  else
  begin
    EstoqueAtual := ((queryProd.FieldByName('Est_R').AsFloat +
      queryProd.FieldByName('Est_F').AsFloat) -
      (getQuantidadePendenteReqOS(queryProd.FieldByName('GRUPO_PROD').AsInteger,
