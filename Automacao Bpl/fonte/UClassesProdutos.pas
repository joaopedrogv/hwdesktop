function TTipoServicoNFSE.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS337', 'SALVAR', '', 'TIPOSERVICONFSE',
      dataSet.FieldByName('COD_TPSERVICO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('COD_TPSERVICO').AsString) = '' then
      raiseExceptionCreate('Código Tipo de Serviço NFSE deve ser informado', 'DBEdit1');

    if acao = 'INSERIR' then
      if trim(dataSet.FieldByName('COD_TPSERVICO').AsString) <> '' then
      begin
        if _buscarTipoServicoNFSE(dataSet.FieldByName('COD_TPSERVICO').AsString) then
          raiseExceptionCreate('Código Tipo de Serviço NFS já existe no cadastro', 'DBEdit1');
      end;

    if trim(dataSet.FieldByName('DESC_TPSERVICO').AsString) = '' then
      raiseExceptionCreate('Descrição Tipo de Serviço deve ser informado', 'DBMemo1');

    if trim(dataSet.FieldByName('COD_NBS').AsString) <> '' then
    begin
      if not vNBS._buscarNBS(dataSet.FieldByName('COD_NBS').AsString) then
        raiseExceptionCreate('Código NBS não encontrado no cadastro', 'DBEdit3');
    end;
         
    dataSet.FieldByName('VL_TETO_IRRF').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('VL_TETO_IRRF').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('VL_TETO_IRRF').AsFloat, 2));
    dataSet.FieldByName('IRRF_SERVICO').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('IRRF_SERVICO').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('IRRF_SERVICO').AsFloat, 3));
    if dataSet.FieldByName('VL_TETO_IRRF').AsFloat > 0 then
      if dataSet.FieldByName('VL_TETO_IRRF').AsFloat <> 0 then
        if dataSet.FieldByName('IRRF_SERVICO').AsFloat <= 0 then
          raiseExceptionCreate('Aliquota IR deve ser preenchida quando o Teto retencao IR for preenchido', 'DBEdit5');

    dataSet.FieldByName('VL_TETO_CONTRIB').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('VL_TETO_CONTRIB').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('VL_TETO_CONTRIB').AsFloat, 2));
    dataSet.FieldByName('ALIQ_PIS_RET').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('ALIQ_PIS_RET').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('ALIQ_PIS_RET').AsFloat, 3));
    dataSet.FieldByName('ALIQ_COFINS_RET').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('ALIQ_COFINS_RET').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('ALIQ_COFINS_RET').AsFloat, 3));
    dataSet.FieldByName('ALIQ_CSSL_RET').AsFloat :=
      vDadosIni.retornoPorCondicao( dataSet.FieldByName('ALIQ_CSSL_RET').AsFloat < 0, 0.00,
        vDadosIni.StrToFloatFormat( dataSet.FieldByName('ALIQ_CSSL_RET').AsFloat, 3));
    if dataSet.FieldByName('VL_TETO_CONTRIB').AsFloat > 0 then
      if (dataSet.FieldByName('ALIQ_PIS_RET').AsFloat <= 0) and
        (dataSet.FieldByName('ALIQ_COFINS_RET').AsFloat <= 0) and
        (dataSet.FieldByName('ALIQ_CSSL_RET').AsFloat <= 0) then
        raiseExceptionCreate('Aliquota PIS/COFINS/CSSL deve ser preenchida quando o Teto retencao Contribuicao for preenchido', 'DBEdit7');

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS337', acao, 'SUCESSO', 'TIPOSERVICONFSE',
        dataSet.FieldByName('COD_TPSERVICO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS337', acao, 'FALHA', 'TIPOSERVICONFSE',
        dataSet.FieldByName('COD_TPSERVICO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

