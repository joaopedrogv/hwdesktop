function TKitsProduto._abreKitsProdutos(pDateSet: TDataSet): boolean;
begin
	Result := montaSelect(' select k.codigo_kit, ' +
  	' ki.grupo_prod, ' +
    ' ki.cod_prod, ' +
    ' ki.cod_empresa, ' +
    ' ki.num_fab_prod, ' +
    ' ki.quant_prod_kit, ' +
    ' ki.descr_prod_kit, ' +
    ' ki.ativo, ' +
    ' k.descricao_kit, ' +
    ' coalesce((select sum(coalesce(ik.quant_prod_kit, 0)) from kits_prod_kits ik ' +
    '           where ik.codigo_kit = k.codigo_kit ' +
    '           and ik.grupo_prod = ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) +
    '           and ik.cod_prod = ' + QuotedStr(pDateSet.FieldByName('COD_PROD').AsString) +
    '           and ik.cod_empresa = ' + IntToStr(pDateSet.FieldByName('COD_EMPRESA').AsInteger) + '), 0) quant_prod ' +
    ' from kits_prod k ' +
    ' left join kits_prod_kits ki on ' +
    '     ki.codigo_kit = k.codigo_kit ' +
    '     and ki.grupo_prod = ' + IntToStr(pDateSet.FieldByName('GRUPO_PROD').AsInteger) +
    '     and ki.cod_prod = ' + QuotedStr(pDateSet.FieldByName('COD_PROD').AsString) +
    '     and ki.cod_empresa = ' + IntToStr(pDateSet.FieldByName('COD_EMPRESA').AsInteger) +
    ' where k.cod_empresa = ' + IntToStr(pDateSet.FieldByName('COD_EMPRESA').AsInteger) +
    ' and k.ativo = 1 ' +
    ' order by k.descricao_kit ');
end;

