function TProdSimilares.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vGrupo_Prod: string;
  vCod_Prod: string;
  vGrupo_Sim: string;
  vCod_Sim: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vGrupo_Prod := trim(dataSet.FieldByName('GRUPO_PROD').AsString);
      vCod_Prod   := trim(dataSet.FieldByName('COD_PROD').AsString);
      vGrupo_Sim  := trim(dataSet.FieldByName('GRUPO_PS').AsString);
      vCod_Sim    := trim(dataSet.FieldByName('COD_PS').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vGrupo_Prod := '';
        vCod_Prod   := '';
        vGrupo_Sim  := '';
        vCod_Sim    := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vGrupo_Prod) <> '') then
        prepare_loop('GRUPO_PROD = ' + vGrupo_Prod +
        	' AND COD_PROD = ' + QuotedStr(vCod_Prod) +
          ' AND GRUPO_PS = ' + vGrupo_Sim +
          ' AND COD_PS = ' + QuotedStr(vCod_Sim))
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + vGrupo_Prod + #13 +
          'Codigo: ' + vCod_Prod + #13 + #13 +
          'SIMILAR' + #13 +
          'Grupo: ' + vGrupo_Sim + #13 +
          'Codigo: ' + vCod_Sim;

        if (trim(vGrupo_Prod) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO141', 'EXCLUIR', '', 'PROD_SIMILARES',
          vDadosIni.IfThen(trim(vGrupo_Prod) <> '',
          	'Gr Prod: ' + vGrupo_Prod +
            ' Cod Prod: ' + vCod_Prod +
            ' Gr Ps: ' + vGrupo_Sim +
            ' Cod Ps: ' + vCod_Sim, ''), buscas, true) then
            	exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'PRODUTO' + #13 +
          'Grupo: ' + vGrupo_Prod + #13 +
          'Codigo: ' + vCod_Prod + #13 + #13 +
          'SIMILAR' + #13 +
          'Grupo: ' + vGrupo_Sim + #13 +
          'Codigo: ' + vCod_Sim;

        if (trim(vGrupo_Prod) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO142', 'EXCLUIR', '', 'PROD_SIMILARES',
          vDadosIni.IfThen(trim(vGrupo_Prod) <> '',
           	'Gr Prod: ' + vGrupo_Prod +
            ' Cod Prod: ' + vCod_Prod +
            ' Gr Ps: ' + vGrupo_Sim +
            ' Cod Ps: ' + vCod_Sim, ''), buscas, true) then
            	exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo produto(s) similar(es) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo produto(s) similar(es) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo produto(s) similar(es) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo produto(s) similar(es) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' delete from prod_similares ' +
            ' where grupo_prod = %d ' +
            ' and cod_prod = %s ' +
            ' and grupo_ps = %d ' +
            ' and cod_ps = %s ' +
            ' and cod_empresa = %d ',
            [fint('grupo_prod'), fstrq('cod_prod'), fint('grupo_ps'), fstrq('cod_ps'), fint('cod_empresa')], buscas);
          if (trim(vGrupo_Prod) = '') then
            vDadosIni.GravaAuditoria('PRO141', 'EXCLUIR', '', 'PROD_SIMILARES',
              'Gr Prod: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
              ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString +
              ' Gr Ps: ' + dataSet.FieldByName('GRUPO_PS').AsString +
              ' Cod Ps: ' + dataSet.FieldByName('COD_PS').AsString, buscas);
        end
        else
        begin
          SqlExec(' update prod_similares set ativo = 0 ' +
            ' where grupo_prod = %d ' +
            ' and cod_prod = %s ' +
            ' and grupo_ps = %d ' +
            ' and cod_ps = %s ' +
            ' and cod_empresa = %d ',
            [fint('grupo_prod'), fstrq('cod_prod'), fint('grupo_ps'), fstrq('cod_ps'), fint('cod_empresa')], buscas);

          if (trim(vGrupo_Prod) = '') then
            vDadosIni.GravaAuditoria('PRO142', 'EXCLUIR', '', 'PROD_SIMILARES',
              'Gr Prod: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
              ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString +
              ' Gr Ps: ' + dataSet.FieldByName('GRUPO_PS').AsString +
              ' Cod Ps: ' + dataSet.FieldByName('COD_PS').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO141', 'PRO142'),
        'EXCLUIR', 'SUCESSO', 'PROD_SIMILARES',
        vDadosIni.IfThen(trim(vGrupo_Prod) <> '',
        	'Gr Prod: ' + vGrupo_Prod +
          ' Cod Prod: ' + vCod_Prod +
          ' Gr Ps: ' + vGrupo_Sim +
          ' Cod Ps: ' + vCod_Sim, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO141', 'PRO142'),
        'EXCLUIR', 'FALHA', 'PROD_SIMILARES',
        vDadosIni.IfThen(trim(vGrupo_Prod) <> '',
        	'Gr Prod: ' + vGrupo_Prod +
          ' Cod Prod: ' + vCod_Prod +
          ' Gr Ps: ' + vGrupo_Sim +
          ' Cod Ps: ' + vCod_Sim, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

