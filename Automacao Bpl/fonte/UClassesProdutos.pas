function TUsuario._abreMecanico: Boolean;
begin
  try
    buscas.Close;
    buscas.SQL.Clear;
    if vDadosIni.vEmp.vUsarAparelho = 'S' then
      buscas.SQL.Add('select col.cod_vendedor, col.nome_vendedor from colaborador col '
        + ' inner join funcoes f on f.cod_funcao = col.cod_funcao '
        + ' where col.ativo = 1 and f.ativo = 1 and ((f.desc_funcao like ''%TECNICO%'') or (f.desc_funcao like ''%TÉCNICO%''))'
        + ' and col.cod_Empresa = ' +
        vdadosini.codEmpresa
        + ' order by col.nome_vendedor')
    else
      buscas.SQL.Add('select col.cod_vendedor, col.nome_vendedor from colaborador col '
        + ' inner join funcoes f on f.cod_funcao = col.cod_funcao '
        + ' where col.ativo = 1 and f.ativo = 1 and ((f.desc_funcao like ''%MECANICO%'') or (f.desc_funcao like ''%MECÂNICO%''))'
        + ' and col.cod_Empresa = ' +
        vdadosini.codEmpresa
        + ' order by col.nome_vendedor');
    buscas.Open;
    result := true;
  except
    result := false;
  end;
end;

function TUsuario._abreTipoServicoMecanico(cod_servico: string): Boolean;
begin
  try
    buscas2.Close;
    buscas2.SQL.Clear;
    buscas2.SQL.Add('select * from TIPO_SERVICO_MECANICO tm'
      + ' inner join colaborador col on col.cod_vendedor = tm.cod_vendedor and col.cod_empresa = tm.cod_empresa '
      + '  where tm.COD_SERVICO = ' + cod_servico + ' AND tm.COD_EMPRESA = ' + vDadosIni.codEmpresa
      + ' order by col.nome_vendedor ');
    buscas2.Open;
    result := true;
  except
    result := false;
  end;
end;

