function TPaiCategorias.abreCategorias(pCodCategoria: Integer): boolean;
begin
  Result := montaSelect(' select 0 ordem, 0 cod_categoria, ' +
    vDadosIni.codEmpresa + ' cod_empresa, ''Cadastrar como categoria principal (N. 0)'' descricao, 0 nivel from rdb$database ' +
  	' union ' +
    ' select (c.cod_categoria) ordem, c.cod_categoria, c.cod_empresa, ' +
    '    (trim(coalesce(c.descricao, '''')) ||'' (N. 1)'' ) descricao, 1 nivel from categoria c ' +
    ' where coalesce(c.cod_categoria_pai, 0) = 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' union ' +
    ' select (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then '''' ' +
    '              else (coalesce(c2.cod_categoria_pai, 0) || ''-'') end ' +
    '||c2.cod_categoria || ' +
    '         case when (coalesce(c2.cod_categoria_pai, 0) = 0) then ''-'' ' +
    '             else ''.'' end ' +
    ' || c.cod_categoria) ordem, c.cod_categoria, c.cod_empresa, ' +
    ' (case when (coalesce(c2.cod_categoria_pai, 0) = 0) then (''    > '') ' +
    '               else (''         >  '') end ' +
    ' || trim(coalesce(c.descricao, '''')) ' +
    ' ||case when (coalesce(c2.cod_categoria_pai, 0) = 0) then '' (N. 2)'' else '' (N. 3)'' end ) descricao, ' +
    ' case when (coalesce(c2.cod_categoria_pai, 0) = 0) then 2 else 3 end nivel from categoria c ' +
    ' inner join categoria c2 on c.cod_categoria_pai = c2.cod_categoria and c.cod_empresa = c2.cod_empresa ' +
    ' where coalesce(c.cod_categoria_pai, 0) > 0 and c.cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by 1 asc ');
end;

