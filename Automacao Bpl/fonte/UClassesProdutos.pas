procedure TRepliCodBarras.defineSQL(DataSetProd: TProdutos);
var
  I: Integer;
  vcamps: string;
  vTemp: string;
begin
  fSQLInsert := '';
  fSQLUpdate := '';
  fSQLCampos := '';

  buscas.close;
  buscas.sql.Text := 'select * from TAB_REP where TABELA = ''PRODUTOS''';
  buscas.Open;
  vcamps := Trim(Buscas.fieldbyname('EXCTO_CAMPO').asstring);

  fList.Clear;
  fList.Duplicates := dupIgnore;
  fList.Add('COD_BARRA');
  fList.Add('GRUPO_PROD');
  fList.Add('COD_PROD');
  fList.Add('COD_EMPRESA');
  fList.Add('DAT_CAD_CDBAR');
  fList.Add('DAT_MOD_CDBAR');
  fList.Add('ATIVO');
  fList.Add('PADRAO_GTIN');
  fList.Add('COD_GRADE');

  buscas.close;
  buscas.sql.Text := ' select rdb$relation_fields.rdb$field_name as campo from rdb$relation_fields ' +
  	' where rdb$relation_fields.rdb$relation_name = ''COD_BARRA'' ' +
    ' and rdb$relation_fields.rdb$field_name in (''UNQ_GRUPO_PROD'', ''UNQ_COD_PROD'', ''EMP_ALT_WS'') ';
  buscas.Open;

  buscas.First;
  while not buscas.Eof do
  begin
    fList.Add(trim(buscas.FieldByName('CAMPO').AsString));

    buscas.Next;
  end;

  for I := 0 to fList.Count - 1 do
  begin
    fSQLInsert := fSQLInsert + ', ' + fList[I];
    fSQLUpdate := fSQLUpdate + ', ' + fList[I] + ' = :' + fList[I];
  end;

  vTemp := StringReplace(fSQLInsert, ', ', ', :', [rfReplaceAll, rfIgnoreCase]);
  System.Delete(fSQLInsert, 1, 1);
  System.Delete(vTemp, 1, 1);

  fSQLCampos := fSQLInsert;
  fSQLInsert := 'insert into COD_BARRA (' + fSQLInsert + ') values (' + vTemp + ')';
//  fSQLUpdate := StringReplace(fSQLUpdate, ', COD_EMPRESA = :COD_EMPRESA', '', [rfReplaceAll, rfIgnoreCase]);
  System.Delete(fSQLUpdate, 1, 1);
  fSQLUpdate := 'update COD_BARRA set ' + fSQLUpdate +
    ' where COD_BARRA = :COD_BARRA_W AND GRUPO_PROD = :GRUPO_PROD_W and COD_PROD = :COD_PROD_W and COD_EMPRESA = :COD_EMPRESA_W';
end;

