function TProdutos.relTabPreco(tabelaAng: boolean; pPrecoVenda: Boolean = False; pDiferenciado: Boolean = False; pPromocao: Boolean = False; pPrecoPorQtde: Boolean = False; pWhere: string = ''; pNaoExecutar: boolean = false): boolean;
var
  relTabPreco: TTabPreco;
begin
  relTabPreco := TTabPreco.Create;
  if ((pDiferenciado) or (pPromocao) or (pPrecoPorQtde)) then
  begin
    vProdutosRel._abreRelProdutos(pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, pWhere, '', pNaoExecutar);

    if not relTabPreco.montaSqlTabPreco(dtmProdutos.qrTabPr2, FrmCadProdutos.cbxComEst.Checked,
      FrmCadProdutos.cbxSemEst.Checked,
      FrmCadProdutos.cbxGrupo.Checked, FrmCadProdutos.cbxSubGrupo.Checked,
      FrmCadProdutos.cbxLoc.Checked,
      FrmCadProdutos.cbxDescGr.Checked, FrmCadProdutos.cbxValGr.Checked, tabelaAng,
      FrmCadProdutos.cbOrdem.Text,
      FrmCadProdutos.cbGrupoOrdem.Text, FrmCadProdutos.mkDescGr.Text, FrmCadProdutos.mkDescSubGr.Text,
      dataSet.CommandText, pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, vProdutosRel.vSql,
      FrmCadProdutos.GroupBox73.Caption, FrmCadProdutos.mkTipo.Text, FrmCadProdutos.mkPromocao.Text,
      vProdutosRel.vSqlProd, vProdutosRel.vSqlPromTab, vProdutosRel.vSqlPrecoQtde) then
      exit;
  end
  else
  begin
    if not relTabPreco.montaSqlTabPreco(dtmProdutos.qrTabPr, FrmCadProdutos.cbxComEst.Checked,
      FrmCadProdutos.cbxSemEst.Checked,
      FrmCadProdutos.cbxGrupo.Checked, FrmCadProdutos.cbxSubGrupo.Checked,
      FrmCadProdutos.cbxLoc.Checked,
      FrmCadProdutos.cbxDescGr.Checked, FrmCadProdutos.cbxValGr.Checked, tabelaAng,
      FrmCadProdutos.cbOrdem.Text,
      FrmCadProdutos.cbGrupoOrdem.Text, FrmCadProdutos.mkDescGr.Text, FrmCadProdutos.mkDescSubGr.Text,
      dataSet.CommandText, pPrecoVenda) then
      exit;
  end;

  if ((pDiferenciado) or (pPromocao) or (pPrecoPorQtde)) then
  begin
    if tabelaAng then
      relTabPreco.imprimirRelatorioAng(dtmProdutos.qrTabPr2, dtmProdutos.rdpTabPreco, dtmProdutos.cdsGrTab, pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, FrmCadProdutos.cbxsomenteDifPro.Checked)
    else
      relTabPreco.imprimirRelatorio(dtmProdutos.qrTabPr2, dtmProdutos.rdpTabPreco, pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde, FrmCadProdutos.cbxsomenteDifPro.Checked);
  end
  else
  begin
    if tabelaAng then
      relTabPreco.imprimirRelatorioAng(dtmProdutos.qrTabPr, dtmProdutos.rdpTabPreco, dtmProdutos.cdsGrTab, pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde)
    else
      relTabPreco.imprimirRelatorio(dtmProdutos.qrTabPr, dtmProdutos.rdpTabPreco, pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde);
  end;

end;

