function TProdutos.TestarCFOP(var pMensagem: string): boolean;
begin
  result := false;
  if dataset.FieldByName('CODIGO_NOP').AsFloat = 0 then
  begin
    pMensagem := 'Natureza de operação informada é inválida.' + chr(13) + 'Campo requerido.';
    exit;
  end
  else if (copy(dataset.FieldByName('CODIGO_NOP').AsString, 1, 1) <> '5') then
  begin
    pMensagem := 'Natureza de operação deve ser de saída.Iniciando em "5"';
    exit;
  end;
  result := ExecutaComandosSql('select codigo_nop from nat_op ' +
    ' where codigo_nop = ' + FloatToStr(dataset.FieldByName('CODIGO_NOP').AsFloat));
    
  if not result then
    pMensagem := 'Natureza de operação informada não existe no cadastro.' + chr(13) +  'Campo requerido.';
end;

function TProdutos.TestarCFOPInter(var pMensagem: string): boolean;
begin
  result := false;
  if dataset.FieldByName('CFOP_INTER_N_CONT').AsFloat = 0 then
  begin
