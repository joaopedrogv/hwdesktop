end;

function TProdutos.TestarCSOSN(var pMensagem: string): boolean;
var
  vCst, vCsosn: string;
  List: TStrings;
  I: Integer;
begin
  Result := True;
  if vDadosIni.vEmp.vRegime <> 'SIMPLES' then
    Exit;

  if Trim(dataSet.FieldByName('csosn').AsString) = '' then
    Exit;  

  List := TStringList.Create;
  List := vDadosIni.getConfSisBlob('prod_cad_relacao_cst_csosn', buscas);
  vCst := Copy(dataSet.FieldByName('cst_prod').AsString, 2, 2);
  vCsosn := dataSet.FieldByName('csosn').AsString;
  for I := 0 to List.Count - 1 do
    if vDadosIni.getValue(List[i], 1) = vCst then
      if Pos('|' + vCsosn + '|', List[i]) > 0 then
        Exit
      else
      begin
        vCsosn := Copy(List[i], 5, Length(List[i]) - 5);
        vCsosn := StringReplace(vCsosn, '|', ', ', [rfReplaceAll]);
        if cadastroSimplificado then
          raiseExceptionCreate('CSOSN informado não tem relação com o CST de ICMS. Valores validos: "' + vCsosn + '"', 'DBEdit144')
        else
        begin
          pMensagem := 'CSOSN informado não tem relação com o CST de ICMS. Valores validos: "' + vCsosn + '"';
          Result := False;
          Exit;
        end;
      end;
end;

function TProdutos.TestarCST(vcst: string; var pMensagem: string): boolean;
begin
  TestarCst := true;
  if vcst = '' then
  begin
    pMensagem := 'Cst Não Informado.' + chr(13) + 'Campo Requerido.';
    TestarCst := false;
  end
  else if copy(vcst, 1, 1) = '' then
  begin
    pMensagem := 'Primeiro Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end
  else if pos(copy(vcst, 1, 1), '012345678') = 0 then
  begin
    pMensagem := 'Primeiro Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end
  else if copy(vcst, 2, 1) = '' then
  begin
    pMensagem := 'Segundo Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end
  else if pos(copy(vcst, 2, 1), '012345679') = 0 then
  begin
    pMensagem := 'Segundo Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end
  else if copy(vcst, 3, 1) = '' then
  begin
    pMensagem := 'Terceiro Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end
  else if pos(copy(vcst, 3, 1), '01') = 0 then
  begin
    pMensagem := 'Terceiro Digito do CST Incorreto.' + chr(13) + 'Favor corrigir.';
    TestarCst := false;
  end;
end;

