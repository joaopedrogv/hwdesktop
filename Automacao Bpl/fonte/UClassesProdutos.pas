constructor TProdutosTribAdicional.create;
var
  I: Integer;
begin
  if DtmProdutos = nil then
    DtmProdutos := TDtmProdutos.Create(DtmProdutos);
  DataSet := TClientDataSet(DtmProdutos.cdsTribAd);
  transacao := TIBTransaction(DtmProdutos.IBTransProdutos);
  buscas := TIBQuery(dtmProdutos.qrBuscasP);

  vPerfAd := TProdutosPerfilTribAdicional.create;
  vPerfAd.DataSet := TClientDataSet(DtmProdutos.cdsConsPFTribAd);

end;

function TProdutosTribAdicional.delete: boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'delete from produtos_trib_ad ad' +
    ' where ad.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and ad.cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
    ' and ad.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ad.cod_trib_pf = ' + IntToStr(dataSet.FieldByName('cod_trib_pf').AsInteger);
  buscas.ExecSQL;

  _selecionaTribAdicional(fGRUPO_PROD, fCOD_PROD);

  Result := True;

end;

destructor TProdutosTribAdicional.Destroy;
begin
  vPerfAd.Free;
  vPerfAd := nil;
  inherited;
end;

function TProdutosTribAdicional.inserirDoPerfilSelecionado: Boolean;
var
  vListaRep: TStringList;
  I, vCountEstados: Integer;
  vUF: string;
begin
  vListaRep := TStringList.Create;
  vListaRep.Sorted := True;
  vListaRep.Duplicates := dupIgnore;
  vListaRep.Clear;

  dataSet.First;
  while not dataSet.Eof do
  begin
    vListaRep.Add(IntToStr(dataSet.FieldByName('COD_TRIB_PF').AsInteger));
    dataSet.Next;
  end;

  I:= vListaRep.Count;
  vListaRep.Add(IntToStr(vPerfAd.dataSet.FieldByName('COD_TRIB_PF').AsInteger));
  if vListaRep.Count = I then
  begin
    Application.MessageBox('Perfil selecionado já existe esta vinculado a este produto', 'Atenção', 0 + 64);
    Exit
  end;

  vCountEstados := Trunc(Length(vPerfAd.dataSet.FieldByName('sigla_uf').AsString) / 3);

  for I := 1 to vCountEstados do
  begin
    vUF:= vDadosIni.getCampoPipe(vPerfAd.dataSet.FieldByName('sigla_uf').AsString, I);
    dataSet.First;
    while not dataSet.Eof do
    begin
      if pos(vUF + '|', dataSet.FieldByName('sigla_uf').AsString) > 0 then
        if Application.MessageBox(pchar('Estado ' + vUF + ' já consta no perfil: ' +
          dataSet.FieldByName('descricao_pf').AsString + #13 +
          'Na emissão da nota fiscal o sistema irá utilizar o primeiro registro que ele encontrar' + #13 +
          'Deseja continuar mesmo assim?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
          Exit;
      dataSet.Next;
    end;
  end;


  if inherited insert then
  begin
    SqlExec('insert into produtos_trib_ad (grupo_prod, cod_prod, cod_empresa, cod_trib_pf)' +
            ' values (%d, ''%s'', %d, %d)', [fGRUPO_PROD, fCOD_PROD, vDadosIni.cod_empresa, vPerfAd.fint('COD_TRIB_PF')]);
    {
    dataSet.FieldByName('grupo_prod').AsInteger := fGRUPO_PROD;
    dataSet.FieldByName('cod_prod').AsString := fCOD_PROD;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('cod_trib_pf').AsInteger := vPerfAd.dataSet.FieldByName('COD_TRIB_PF').AsInteger;

//    for I := 0 to vPerfAd.dataSet.FieldCount - 1 do
//      if dataSet.FindField(vPerfAd.dataSet.Fields[i].FieldName) <> nil then
//        dataSet.FieldByName(vPerfAd.dataSet.Fields[i].FieldName).Value :=
//        vPerfAd.dataSet.FieldByName(vPerfAd.dataSet.Fields[i].FieldName).Value;

    dataSet.Post;
    Result := Apply;
    }
    Result := True;

    _selecionaTribAdicional(fGRUPO_PROD, fCOD_PROD);
  end;
end;

function TProdutosTribAdicional._selecionaTribAdicional(pGrupo: Integer;
  pCodProd: string): Boolean;
begin
  Result := montaSelect(
    'select ad.*, pf.*, fi.descricao from produtos_trib_ad ad' +
    ' inner join produtos_trib_pf pf on ad.cod_trib_pf = pf.cod_trib_pf and ad.cod_empresa = pf.cod_empresa and pf.ativo = 1' +
    ' left join finalidade fi on fi.id = pf.finalidadeid and fi.cod_empresa = pf.cod_empresa' +
    ' where ad.GRUPO_PROD = ' + IntToStr(pGrupo) +
    ' and ad.cod_prod = ' + QuotedStr(Trim(pCodProd)) +
    ' and ad.cod_empresa = ' + vDadosIni.codEmpresa);
  fGRUPO_PROD := pGrupo;
  fCOD_PROD := Trim(pCodProd);
end;

