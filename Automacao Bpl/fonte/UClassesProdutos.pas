    vcusto_medio_ant := buscas.FieldByName('custo_medio').AsFloat;

    buscas.Close;
    buscas.SQL.Text := ' select first 1 estoque, custo_medio from estoque_diario ' +
    	' where grupo_prod = :grupo_prod ' +
      ' and cod_prod = :cod_prod ' +
      ' and cod_grade = :cod_grade ' +
      ' and cod_empresa = :cod_empresa ' +
      ' and dia = :dia ' +
      ' order by dia desc ';
    buscas.ParamByName('grupo_prod').AsInteger := pGrupoProd;
    buscas.ParamByName('cod_prod').AsString := pCodProd;
    buscas.ParamByName('cod_grade').AsInteger := pCodGrade;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('dia').AsDateTime := pData;
    buscas.Open;

    vestoque_at      := buscas.FieldByName('estoque').AsFloat;
    vcusto_medio_at  := buscas.FieldByName('custo_medio').AsFloat;

    buscas.Close;
    buscas.SQL.Text := ' select f.qtde, f.custo_medio from fichaprodutosdetalhada f ' +
      ' where f.numdoc = :numdoc ' +
      ' and f.tipo = :tipo ' +
      ' and f.grupo_prod = :grupo_prod ' +
      ' and f.cod_prod = :cod_prod ' +
      ' and f.cod_grade = :cod_grade ' +
      ' and f.cod_cfop = :cod_cfop ' +
      ' and f.cod_cliente_fornecedor = :cod_cliente ' +
