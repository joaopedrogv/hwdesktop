    buscas.ParamByName('natureza_nf').AsString := 'E';
    buscas.ParamByName('grupo_prod').AsInteger := pGrupoProd;
    buscas.ParamByName('cod_prod').AsString := pCodProd;
    buscas.ParamByName('cod_cliente').AsInteger := pCodCliente;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    if not buscas.IsEmpty then
      pCustMed := buscas.FieldByName('prec_cus_cnt').AsFloat;
  except
    on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.retornaQtdeCustoMedNF. Erro: ' + e.Message);
    end;
  end;
