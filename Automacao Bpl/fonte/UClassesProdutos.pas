function TBalancoProduto.existeProdutoContadoSemGrade(grupo_prod: Integer;
  cod_prod: string; cod_grade: Integer): Boolean;
begin
  Result := False;

  try
    try
      buscas.Close;
      buscas.SQL.Text := 'select qtde_prod from BALANCO_PRODUTOS' +
        ' where grupo_prod = ' + IntToStr(grupo_prod) +
        ' and cod_prod = ' + QuotedStr(cod_prod) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      Result := not buscas.IsEmpty;

      if Result then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select qtde from COD_GRADE_BALANCO' +
          ' where grupo_prod = ' + IntToStr(grupo_prod) +
          ' and cod_prod = ' + QuotedStr(cod_prod) +
          //' and cod_grade = ' + IntToStr(cod_grade) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;

        Result := buscas.IsEmpty;
      end;

    finally
      buscas.Close;
    end;
  except on E: Exception do
    begin
      raise Exception.Create('Erro ao verificar grade contada. Erro: ' + e.Message);
    end;
  end;
end;

function TBalancoProduto.inserirProdutoContadoSemGrade(grupo_prod: Integer;
  cod_prod: string; cod_grade: Integer): Boolean;
var
  trans: TIBTransaction;
  qr: TIBQuery;
begin
  Result := False;

  try

    trans := TIBTransaction.Create(Application);
    qr := TIBQuery.Create(Application);

    trans.DefaultDatabase := buscas.Database;
    trans.Params.Clear;
    trans.Params.Add('read_committed');
    trans.Params.Add('rec_version');
    trans.Params.Add('nowait');

    qr             := TIBQuery.Create(Application);
    qr.Database    := trans.DefaultDatabase;
    qr.Transaction := trans;

    try
      qr.Close;
      qr.SQL.Text := 'select cod_grade from COD_GRADE_PROD' +
        ' where grupo_prod = ' + IntToStr(grupo_prod) +
        ' and cod_prod = ' + QuotedStr(cod_prod) +
        ' and cod_grade = ' + IntToStr(cod_grade) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      qr.Open;
      if qr.IsEmpty then
      begin
        qr.Close;
        qr.SQL.Text := 'insert into cod_grade_prod ' +
          ' (grupo_prod, cod_prod, cod_grade, cod_empresa, qtde)' +
          ' values ' +
          ' (:grupo_prod, :cod_prod, :cod_grade, :cod_empresa, 0)';
        qr.ParamByName('grupo_prod').AsInteger := grupo_prod;
        qr.ParamByName('cod_prod').AsString := cod_prod;
        qr.ParamByName('cod_grade').AsInteger := cod_grade;
        qr.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        qr.ExecSQL;

        if qr.Transaction.InTransaction then
          qr.Transaction.Commit;
        Result := True;
      end
      else
        qr.Close;
    finally
      FreeAndNil(qr);
      FreeAndNil(trans);
    end;
  except on E: Exception do
    begin
      raise Exception.Create('Erro ao verificar grade contada. Erro: ' + e.Message);
    end;
  end;
end;

