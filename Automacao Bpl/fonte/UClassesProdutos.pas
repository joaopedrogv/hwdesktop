procedure TFichaInventario.ImprimirFichaMovimentacao(dataI, dataF: string; ProgressBar:
  TProgressBar);
var
  vRelFichaInv: TRelFichaInventario;
begin
  vRelFichaInv := TRelFichaInventario.create;
  vRelFichaInv.dataIni := dataI;
  vRelFichaInv.dataFim := dataF;
  vRelFichaInv.buscas.Close;
  vRelFichaInv.buscas.SQL.Text := 'select PR.LOCACAO_PROD,PR.LOCACAO_PROD_1,PR.DESCR_PROD,'+
    ' PR.UNIDADE,PR.Est_R,PR.Est_F,PR.GRUPO_PROD,PR.COD_PROD,PR.NUM_FAB_PROD from produtos pr ' +
    ' WHERE pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1  ' +
    ' and (((select count(pp.cod_prod) from pedvenda p inner join pedvenda_prod pp ' +
    ' on p.nped=pp.nped and p.cod_empresa=pp.cod_empresa and p.tipo=pp.tipo ' +
    ' where pp.grupo_prod = pr.grupo_prod and ' +
    ' pp.cod_prod = pr.cod_prod and p.cod_empresa = pr.cod_empresa and ((pp.status is null) or (pp.status <> ''CANCELADO'')) and  p.ativo = 1 ' +
    ' and ((p.tipo=''REQ'') or (p.tipo=''OS'')) and p.data_fech >= :vdat1 and p.data_fech <= :vdat2) > 0)' +
    ' or ' +
    ' ((select count(nfit.cod_prod) from notafiscal_item nfit inner join notafiscal nf on nf.cod_nf=nfit.cod_nf and nf.cod_empresa=nfit.cod_empresa where ' +
    ' nf.natureza_nf=''E'' and nf.data_lanc >= :vdat1 and nf.data_lanc <= :vdat2 and status = ''Fechada'' and  ' +
    ' nfit.grupo_prod = pr.grupo_prod and nfit.cod_prod = pr.cod_prod and  nfit.cod_empresa = ' +
    vDadosIni.codEmpresa + ' and nfit.ativo=1) >= 1 )' +
    ' or ((select count(c.cod_prod) from controle_almoxarifado c where c.grupo_prod = pr.grupo_prod and c.cod_prod = pr.cod_prod' +
    ' and c.cod_empresa = pr.cod_empresa and c.sit_atd = ''AT'' and c.data_atd >= :vdat1 and c.data_atd <= :vdat2) > 0)' +
    ')';
  vRelFichaInv.buscas.ParamByName('vdat1').AsDate := StrToDate(dataI);
  vRelFichaInv.buscas.ParamByName('vdat2').AsDate := StrToDate(dataF);
  vRelFichaInv.buscas.Prepare;
  vRelFichaInv.buscas.Open;
  vRelFichaInv.buscas.FetchAll;
  ProgressBar.max := vRelFichaInv.buscas.RecordCount;
  ProgressBar.position := 0;

  if not vDadosIni.ModImp(vRelFichaInv.rdp) then
    exit;
  vRelFichaInv.rdp.Abrir;
  vRelFichaInv.novaPaginaPrint;
  while not vRelFichaInv.buscas.eof do
  begin
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 1,
      vRelFichaInv.buscas.FieldByName('LOCACAO_PROD').AsString);
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 11,
      vRelFichaInv.buscas.FieldByName('LOCACAO_PROD_1').AsString);
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 21,
      vRelFichaInv.buscas.FieldByName('DESCR_PROD').AsString);
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 81,
      UpperCase(trim(vRelFichaInv.buscas.FieldByName('UNIDADE').AsString)));
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 85, '_____________');
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 101,
      Floattostr(vRelFichaInv.buscas.FieldByName('Est_R').AsFloat +
      vRelFichaInv.buscas.FieldByName('Est_F').AsFloat -
      (getQuantidadePendenteReqOS(vRelFichaInv.buscas.FieldByName('GRUPO_PROD').asinteger,
      trim(vRelFichaInv.buscas.FieldByName('COD_PROD').AsString)))));
    vRelFichaInv.rdp.Imp(vRelFichaInv.linha, 112,
      vRelFichaInv.buscas.FieldByName('NUM_FAB_PROD').AsString);
    vRelFichaInv.buscas.next;
    vRelFichaInv.linha := vRelFichaInv.linha + 1;
    if vRelFichaInv.linha >= 58 then
    begin
      vRelFichaInv.linha := 1;
      vRelFichaInv.novaPaginaPrint;
    end;
    ProgressBar.position := ProgressBar.position + 1;
    Application.ProcessMessages;
  end;
  vRelFichaInv.rdp.Fechar;
  ProgressBar.position := 0;
  vRelFichaInv.buscas.close;
  vRelFichaInv.buscas.UnPrepare;
end;

function TFichaInventario.ProdJaContado(pGrupoProd: Integer; pCodProd: string): boolean;
var
  vDescProdTemp: string;
begin
  result := false;
  editarEstoque := false;
  editarEstoqueGrade := false;
  vContar := false;
  buscas.Close;
  buscas.SQL.Text := 'select * from ESTOQUE_INI ' +
  	' where grupo_prod = ' + inttostr(pGrupoProd) +
    ' and cod_prod = ' + quotedstr(pCodProd) +
    ' and (data_confirm is null) ' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo=1';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    try
      vContar := true;
      FrmFichaInv.lbLocacao.Caption := 'LOCACAO 1: ' + buscas.FieldByName('LOCACAO_PROD').asstring +
        chr(13) + 'LOCACAO 2: ' + buscas.FieldByName('LOCACAO_PROD_1').asstring;
      FrmFichaInv.lbContado.Caption := 'Contado: ' + buscas.FieldByName('QUANT_EST').AsString;
      FrmFichaInv.MaskEdit4.Text := buscas.FieldByName('LOCACAO_PROD').asstring;
      FrmFichaInv.MaskEdit5.Text := buscas.FieldByName('LOCACAO_PROD_1').asstring;
//      FrmFichaInv.EditMoeda1.Valor := buscas.FieldByName('QUANT_EST').AsFloat;
      FrmFichaInv.lbQtdGrade.Caption := '';
      vDescProdTemp := DescProd + chr(13) +
        'LOCACAO 1: ' + buscas.FieldByName('LOCACAO_PROD').asstring + chr(13) +
        'LOCACAO 2: ' + buscas.FieldByName('LOCACAO_PROD_1').asstring + chr(13) +
        'Contado: ' + buscas.FieldByName('QUANT_EST').AsString;

      Application.ProcessMessages;
      if _ValidaGrade then
      begin
        buscas.Close;
        buscas.SQL.Text :=
          ' select ei.*,eig.cod_grade,g.descricao from ESTOQUE_INI ei left join estoque_ini_grade eig ' +
          ' on ei.grupo_prod=eig.grupo_prod and ei.cod_prod= eig.COD_PROD ' +
          ' and ei.cod_empresa = eig.cod_empresa ' + //and ei.data_cadastro=eig.data_cadastro
          ' inner join grade g on eig.cod_grade=g.cod_grade and eig.cod_empresa=g.cod_empresa ' +
          ' where ei.grupo_prod = ' + inttostr(pGrupoProd) +
          ' and ei.cod_prod = ' + quotedstr(pCodProd) +
          ' and eig.cod_grade =' + inttostr(FcodGrade) +
          ' and (ei.data_confirm is null) and (eig.data_confirm is null) ' +
          ' and ei.cod_empresa = ' + vDadosIni.codEmpresa + ' and ei.ativo=1';
        buscas.Open;
        if not buscas.isempty then
        begin
          vDescProdTemp := vDescProdTemp + chr(13) +
            'Grade: ' + trim(buscas.FieldByName('DESCRICAO').AsString);
          FrmFichaInv.lbQtdGrade.Caption := 'Produto já contado para a grade selecionada. Quantidade contada = ' + retornaValor(
            'select QUANT_EST as valor from ESTOQUE_INI_GRADE where ' +
            ' grupo_prod = ' + inttostr(pGrupoProd) +
            ' and cod_prod = ' + quotedstr(pCodProd) +
            ' and cod_grade = ' + inttostr(FcodGrade) +
            ' and data_confirm is null ' +
            ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1', true);
          if Application.MessageBox(Pchar(FrmFichaInv.lbQtdGrade.Caption + chr(13)+'Deseja continuar e editar os valores para esta grade?'), 'Confirmação', MB_YESNO +
            MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
          begin
            editarEstoqueGrade := true;
            editarEstoque := true;
            result := true;
          end else
          begin
            result := false;
            vContar := false;
            exit;
          end;
        end else
          editarEstoque := true;   // tem que editar o produto aqui pois a grade ainda não tinha sido contada
      end else
      begin
        if Application.MessageBox(Pchar('Produto já contado. Deseja continuar e editar os valores para o produto?' + chr(13) +
          vDescProdTemp), 'Confirmação', MB_YESNO +
          MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
        begin
          editarEstoque := true;
          vContar := true;
          result := true;
        end else
        begin
          vContar := false;
          exit;
        end;
      end;
    finally
      if not result and not vContar then
      begin
        FrmFichaInv.lbLocacao.Caption := '';
        FrmFichaInv.lbContado.Caption := '';
        FrmFichaInv.MaskEdit4.Text := '';
        FrmFichaInv.MaskEdit5.Text := '';
        FrmFichaInv.EditMoeda1.Valor := 0;
        FrmFichaInv.lbQtdGrade.Caption := '';
        FrmFichaInv.lbCodGrupo.Caption := '';
        FrmFichaInv.lbCodProd.Caption := '';
        FrmFichaInv.lbDescProd.caption := '';
        vDescProdTemp := '';
      end;
    end;
  end else vContar := true;
  // se o produto ainda não foi contado nenhuma grade sua também foi  (result = false)
end;

procedure TFichaInventario.RelProdutosContados(
	ImprimirCustoMedio: boolean;
  ImprimirLocacao: boolean;
  lb: Tlabel;
  ProgressBar: TProgressBar);
var
  vRelProdContados: TRelFichaInventario;
  vtotC, vtotV, vtotgC, vtotgV: currency;
  ivsubg, itc: integer;
  vit: integer;
  procedure Cabecalho;
  begin
    vRelProdContados.rdp.impf(vRelProdContados.linha, 1, 'Num.Fabrica', [comp17, negrito]);
    vRelProdContados.rdp.impf(vRelProdContados.linha, 15, 'Descrição do Produto/Descrição das Grades', [comp17, negrito]);
    if ImprimirLocacao then
    begin
    	vRelProdContados.rdp.impd(vRelProdContados.linha, 68, 'Locação 1', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 78, 'Locação 2', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 88, 'Contado', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 98, 'Diferença', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 110, 'Pr Tabela', [comp17, negrito]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 124, 'Valor Total', [comp17, negrito]);
      if ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 138, 'Pr.Custo', [comp17, negrito]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 152, 'Custo Total', [comp17, negrito]);
      end;
    end
    else
    begin
      vRelProdContados.rdp.impd(vRelProdContados.linha, 68, 'Contado', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 78, 'Diferença', [comp17, negrito]);
      vRelProdContados.rdp.impd(vRelProdContados.linha, 90, 'Pr Tabela', [comp17, negrito]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 104, 'Valor Total', [comp17, negrito]);
      if ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 118, 'Pr.Custo', [comp17, negrito]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 132, 'Custo Total', [comp17, negrito]);
      end;
    end;
    vRelProdContados.linha := vRelProdContados.linha + 1;
  end;
begin
  vRelProdContados := TRelFichaInventario.create;
  vRelProdContados.rdp.OpcoesPreview.CaptionPreview := 'Retatório dos Produtos já Contados';
  if ImprimirLocacao then
  	vRelProdContados.rdp.TamanhoQteColunas := 152
  else
  	vRelProdContados.rdp.TamanhoQteColunas := 132;
  vRelProdContados.rdp.CaptionSetup := 'Configurar impressão do Retatório dos Produtos Contados';
  vRelProdContados.rdp.TitulodoRelatorio := 'Relatório de Produtos já Contados';
  vDadosIni._LimparVarSendEmail;
  vRelProdContados.rdp.OnSendMail := vDadosini._SendMailRdPrint; 
  vtotC := 0;
  vtotV := 0;
  vtotgC := 0;
  vtotgV := 0;
  vRelProdContados.linha := 1;

  vRelProdContados.buscas.Close;
  vRelProdContados.buscas.SQL.Text := 'select bl.locacao_prod, bl.locacao_prod_1, pr.grupo_prod,pr.cod_prod,pr.descr_prod,' +
    ' pr.est_f,bl.quant_est,pr.num_fab_prod,pr.locacao_prod,pr.sub_g_prod,pr.prec_cus_prod,' +
    ' pr.prec_cusr_prod,sbg.descricao,pr.prec_tab_prod,pr.emb_prod,pr.prec_cusm_prod,bl.QTD_DIF_BAL from estoque_ini bl ' +
    ' inner join produtos pr on ' +
    '		bl.grupo_prod = pr.grupo_prod ' +
    '		and bl.cod_prod = pr.cod_prod ' +
    '		and bl.cod_empresa = pr.cod_empresa ' +
    ' inner join sub_grupo sbg on coalesce(pr.sub_g_prod,0) = sbg.codigo_subgr ' +
    ' where bl.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1 ' +
    ' and (bl.data_confirm is null) order by pr.sub_g_prod,pr.descr_prod';
  vRelProdContados.buscas.Prepare;
  vRelProdContados.buscas.Open;
  vRelProdContados.buscas.FetchAll;
  ProgressBar.max := vRelProdContados.buscas.RecordCount;
  ProgressBar.position := 0;
  if not vDadosIni.ModImp(vRelProdContados.rdp) then
    exit;
  if vRelProdContados.rdp.EstaAberto then
    vRelProdContados.rdp.Fechar;
  vRelProdContados.rdp.abrir;
  vRelProdContados.linha := 1;
  Cabecalho;
  vRelProdContados.rdp.impf(vRelProdContados.linha, 2, 'SUB GRUPO: '+
    vRelProdContados.buscas.FieldByName('SUB_G_PROD').asstring + ' - ' +
    vRelProdContados.buscas.FieldByName('DESCRICAO').asstring, [normal, negrito]);
  vRelProdContados.linha := vRelProdContados.linha + 1;
  ivsubg := vRelProdContados.buscas.FieldByName('SUB_G_PROD').asinteger;
  while not vRelProdContados.buscas.eof do
  begin
    if vRelProdContados.buscas.FieldByName('SUB_G_PROD').AsInteger <> ivsubg then
    begin
      vRelProdContados.rdp.imp(vRelProdContados.linha, 2, 'Total da Secao: ');
      vRelProdContados.rdp.imp(vRelProdContados.linha, 92, vDadosIni.AlnDir(format('%n', [vtotV]),
        10));
      vRelProdContados.rdp.imp(vRelProdContados.linha, 112, vDadosIni.AlnDir(format('%n', [vtotC]),
        10));
      vRelProdContados.linha := vRelProdContados.linha + 2;
      vRelProdContados.rdp.impf(vRelProdContados.linha, 2,'SUB GRUPO: '+
        vRelProdContados.buscas.FieldByName('SUB_G_PROD').asstring + ' - ' +
        vRelProdContados.buscas.FieldByName('DESCRICAO').asstring, [normal, negrito]);
      ivsubg := vRelProdContados.buscas.FieldByName('SUB_G_PROD').asinteger;
      vRelProdContados.linha := vRelProdContados.linha + 1;
      vtotC := 0;
      vtotV := 0;
    end;
    vRelProdContados.rdp.imp(vRelProdContados.linha, 1,
      trim(vRelProdContados.buscas.FieldByName('NUM_FAB_PROD').AsString));
    vRelProdContados.rdp.imp(vRelProdContados.linha, 15,
      copy(vRelProdContados.buscas.FieldByName('DESCR_PROD').AsString, 1, 33));

    vRelProdContados.rdp.imp(vRelProdContados.linha, 50,
      trim(vRelProdContados.buscas.FieldByName('EMB_PROD').AsString));

    if ImprimirLocacao then
    begin
    	vRelProdContados.rdp.ImpD(vRelProdContados.linha, 68,
        vRelProdContados.buscas.FieldByName('LOCACAO_PROD').AsString, [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 78,
      	vRelProdContados.buscas.FieldByName('LOCACAO_PROD_1').AsString, [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 88, format('%8.3f',
        [vRelProdContados.buscas.FieldByName('QUANT_EST').asfloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 98, format('%8.3f',
          [vRelProdContados.buscas.FieldByName('QTD_DIF_BAL').asfloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 110, format('%n',
        [vRelProdContados.buscas.FieldByName('PREC_TAB_PROD').AsFloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 124, format('%n',
        [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_TAB_PROD').AsFloat)]), [comp17]);
      if not ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 138, format('%n',
          [vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat]), [comp17]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 152, format('%n',
          [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
            vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat)]), [comp17]);
        vtotC := vtotC + (vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat);
      end
      else
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 138, format('%n',
          [vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat]), [comp17]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 152, format('%n',
          [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
            vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat)]), [comp17]);
        vtotC := vtotC + (vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat);
      end;
    end
    else
    begin
      vRelProdContados.rdp.impD(vRelProdContados.linha, 68, format('%8.3f',
        [vRelProdContados.buscas.FieldByName('QUANT_EST').asfloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 78, format('%8.3f',
          [vRelProdContados.buscas.FieldByName('QTD_DIF_BAL').asfloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 90, format('%n',
        [vRelProdContados.buscas.FieldByName('PREC_TAB_PROD').AsFloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 104, format('%n',
        [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_TAB_PROD').AsFloat)]), [comp17]);
      if not ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 118, format('%n',
          [vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat]), [comp17]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 132, format('%n',
          [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
            vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat)]), [comp17]);
        vtotC := vtotC + (vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_CUS_PROD').AsFloat);
      end
      else
      begin
        vRelProdContados.rdp.impD(vRelProdContados.linha, 118, format('%n',
          [vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat]), [comp17]);
        vRelProdContados.rdp.impD(vRelProdContados.linha, 132, format('%n',
          [(vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
            vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat)]), [comp17]);
        vtotC := vtotC + (vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
          vRelProdContados.buscas.FieldByName('PREC_CUSM_PROD').AsFloat);
      end;
    end;
    vtotV := vtotv + (vRelProdContados.buscas.FieldByName('QUANT_EST').AsFloat *
      vRelProdContados.buscas.FieldByName('PREC_TAB_PROD').AsFloat);
    vit := vit + 1;
    vRelProdContados.linha := vRelProdContados.linha + 1;

    buscas.Close;
    buscas.SQL.Text := 'select eig.cod_grade, eig.quant_est, g.descricao, eig.qtd_dif_bal from estoque_ini_grade eig ' +
      ' inner join grade g on eig.cod_grade = g.cod_grade and eig.cod_empresa = g.cod_empresa' +
      ' where eig.grupo_prod = ' + inttostr(vRelProdContados.buscas.FieldByName('grupo_prod').AsInteger) +
      ' and eig.cod_prod = ' + quotedstr(trim(vRelProdContados.buscas.FieldByName('cod_prod').AsString)) +
      ' and eig.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and eig.data_confirm is null ' +
      ' and eig.ativo = 1 ';
    buscas.Open;
    buscas.First;
    while not buscas.Eof do
    begin
      vRelProdContados.rdp.imp(vRelProdContados.linha, 15, 'Grade: ' +
        copy(buscas.FieldByName('descricao').AsString, 1, 26));
      vRelProdContados.rdp.impD(vRelProdContados.linha, 68, format('%8.3f',
        [buscas.FieldByName('QUANT_EST').asfloat]), [comp17]);
      vRelProdContados.rdp.impD(vRelProdContados.linha, 78, format('%8.3f',
        [buscas.FieldByName('QTD_DIF_BAL').asfloat]), [comp17]);
      inc(vRelProdContados.linha);
      buscas.Next;
    end;

    itc := itc + 1;
    lb.Caption := inttostr(itc) + ' ' + vRelProdContados.buscas.FieldByName('GRUPO_PROD').asstring +
      ' ' + vRelProdContados.buscas.FieldByName('COD_PROD').asstring;
    ProgressBar.position := ProgressBar.position + 1;
    Application.ProcessMessages;
    //    lb.refresh;
    vRelProdContados.buscas.next;
    if vRelProdContados.linha >= 60 then
    begin
      vRelProdContados.linha := 1;
      vRelProdContados.rdp.Novapagina;
      Cabecalho;
    end;
  end;

  if ImprimirLocacao then
  	vRelProdContados.rdp.impF(vRelProdContados.linha, 1, vDadosIni.Replicate('-', 152), [comp17])
  else
  	vRelProdContados.rdp.impF(vRelProdContados.linha, 1, vDadosIni.Replicate('-', 132), [comp17]);

  vRelProdContados.linha := vRelProdContados.linha + 1;
  vRelProdContados.rdp.ImpF(vRelProdContados.linha, 1, 'TOTAL POR SECAO ', [normal, negrito]);
  vRelProdContados.linha := vRelProdContados.linha + 1;
  vRelProdContados.rdp.ImpF(vRelProdContados.linha, 1, 'CODIGO',[comp17, negrito]);
  vRelProdContados.rdp.ImpF(vRelProdContados.linha, 30, 'DESCRICAO',[comp17, negrito]);
  if ImprimirLocacao then
  begin
    vRelProdContados.rdp.ImpD(vRelProdContados.linha, 124, 'VALOR',[comp17, negrito]);
  	vRelProdContados.rdp.ImpD(vRelProdContados.linha, 152, 'CUSTO',[comp17, negrito]);
  end
  else
  begin
  	vRelProdContados.rdp.ImpD(vRelProdContados.linha, 104, 'VALOR',[comp17, negrito]);
  	vRelProdContados.rdp.ImpD(vRelProdContados.linha, 132, 'CUSTO',[comp17, negrito]);
  end;
  vRelProdContados.linha := vRelProdContados.linha + 1;

  vRelProdContados.buscas.Close;
  vRelProdContados.buscas.SQL.Text := 'select pr.sub_g_prod,sbg.descricao,' +
    ' sum(bl.quant_est*pr.prec_cus_prod) as soma, ' +
    ' sum(bl.quant_est*pr.prec_cusr_prod) as soma1, ' +
    ' sum(bl.quant_est*pr.prec_tab_prod) as soma2, ' +
    ' sum(bl.quant_est*pr.prec_cusm_prod) as soma3 from estoque_ini bl ' +
    ' inner join produtos pr on ' +
    ' 	bl.grupo_prod = pr.grupo_prod ' +
    '		and bl.cod_prod = pr.cod_prod ' +
    ' 	and bl.cod_empresa = pr.cod_empresa ' +
    ' inner join sub_grupo sbg on coalesce(pr.sub_g_prod,0) = sbg.codigo_subgr ' +
    ' where bl.data_confirm is null ' +
    ' and pr.ativo = 1 ' +
    ' and pr.cod_empresa = ' + vDadosIni.codEmpresa +
    ' group by pr.sub_g_prod, sbg.descricao ';
  vRelProdContados.buscas.Prepare;
  vRelProdContados.buscas.Open;

  while not vRelProdContados.buscas.eof do
  begin
    vRelProdContados.rdp.Imp(vRelProdContados.linha, 2, 'SUB GRUPO: '+
      vRelProdContados.buscas.FieldByName('SUB_G_PROD').asstring + ' - ');
    vRelProdContados.rdp.Imp(vRelProdContados.linha, 30,
      vRelProdContados.buscas.FieldByName('DESCRICAO').asstring);

    if ImprimirLocacao then
    begin
    	vRelProdContados.rdp.ImpD(vRelProdContados.linha, 124, format('%n',
        [vRelProdContados.buscas.FieldByName('SOMA2').AsFloat]),[comp17]);
      if ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.ImpD(vRelProdContados.linha, 152, format('%n',
          [vRelProdContados.buscas.FieldByName('SOMA').AsFloat]) ,[comp17]);
        vtotgC := vtotgC + vRelProdContados.buscas.FieldByName('SOMA').AsFloat;
      end
      else
      begin
        vRelProdContados.rdp.ImpD(vRelProdContados.linha, 152, format('%n',
          [vRelProdContados.buscas.FieldByName('SOMA3').AsFloat]), [comp17]);
        vtotgC := vtotgC + vRelProdContados.buscas.FieldByName('SOMA3').AsFloat;
      end;
    end
    else
    begin
      vRelProdContados.rdp.ImpD(vRelProdContados.linha, 104, format('%n',
        [vRelProdContados.buscas.FieldByName('SOMA2').AsFloat]),[comp17]);
      if ImprimirCustoMedio then
      begin
        vRelProdContados.rdp.ImpD(vRelProdContados.linha, 132, format('%n',
          [vRelProdContados.buscas.FieldByName('SOMA').AsFloat]) ,[comp17]);
        vtotgC := vtotgC + vRelProdContados.buscas.FieldByName('SOMA').AsFloat;
      end
      else
      begin
        vRelProdContados.rdp.ImpD(vRelProdContados.linha, 132, format('%n',
          [vRelProdContados.buscas.FieldByName('SOMA3').AsFloat]), [comp17]);
        vtotgC := vtotgC + vRelProdContados.buscas.FieldByName('SOMA3').AsFloat;
      end;
    end;
    vtotgV := vtotgV + vRelProdContados.buscas.FieldByName('SOMA2').AsFloat;
    vRelProdContados.linha := vRelProdContados.linha + 1;
    if vRelProdContados.linha >= 60 then
    begin
      if ImprimirLocacao then
      	vRelProdContados.rdp.Imp(vRelProdContados.linha, 1, vDadosIni.replicate('=', 152))
      else
      	vRelProdContados.rdp.Imp(vRelProdContados.linha, 1, vDadosIni.replicate('=', 132));
      vRelProdContados.linha := 1;
      vRelProdContados.rdp.Novapagina;
      Cabecalho;
    end;
    vRelProdContados.buscas.next;
  end;
  vRelProdContados.rdp.imp(vRelProdContados.linha, 1, 'TOTAIS :');
  if ImprimirLocacao then
  begin
    vRelProdContados.rdp.ImpD(vRelProdContados.linha, 124, format('%n', [VtotgV]),[comp17]);
    vRelProdContados.rdp.ImpD(vRelProdContados.linha, 152, format('%n', [vtotgC]),[comp17]);
  end
  else
  begin
    vRelProdContados.rdp.ImpD(vRelProdContados.linha, 104, format('%n', [VtotgV]),[comp17]);
    vRelProdContados.rdp.ImpD(vRelProdContados.linha, 132, format('%n', [vtotgC]),[comp17]);
  end;
  vRelProdContados.linha := vRelProdContados.linha + 1;

  lb.Caption := '';
  lb.refresh;
  if vRelProdContados.rdp.EstaAberto then
    vRelProdContados.rdp.Fechar;
  ProgressBar.position := 0;
  vRelProdContados.buscas.close;
  vRelProdContados.buscas.UnPrepare;
end;

function TFichaInventario.ValidaInclusaoProd(pGrupoProd: Integer; pCodProd: string; numFabProd: string; qtdEstoque: double): boolean;
var
  data: TDate;
  qtdEstoqueTotalGrades, qtdEstoqueProdutosNaoCont,
    pendReqOSGrade, pendReqOS, vdifVlContVlReal,
    vdifVlContVlRealGrade, qtdTrans, qtdReq: double;
  vPrecoCusM, estoqueCont: currency;
  qtdProducao,vqtdEstoqueProd: Double;
begin
  //Verifica se o balanço já foi confirmado
  result := true;
  vqtdEstoqueProd:=0;
  data := vDadosIni.getDataBanco(buscas);
  buscas.close;
  buscas.SQL.Text := ' select first 1 * from ESTOQUE_INI ' +
  	' where data_cadastro = :vdata ' +
    ' and (not data_confirm is null) and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.ParamByName('vdata').AsDate := data;
  buscas.Prepare;
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    Application.MessageBox('Balanço para hoje já confirmado, tente amanhã!', 'Aviso', MB_OK +
      MB_ICONINFORMATION);
    buscas.Close;
    result := false;
    exit;
  end;
  //'Grade'
  if (_ValidaGrade) then
  begin
    buscas.close;
    buscas.SQL.Text := 'select first 1 eig.* from ESTOQUE_INI_GRADE as eig ' +
      ' inner join PRODUTOS as p on p.GRUPO_PROD = eig.GRUPO_PROD ' +
      ' and p.COD_PROD = eig.COD_PROD and eig.cod_empresa = p.cod_empresa ' +
      ' where (eig.data_confirm = :vdata) and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and eig.cod_grade= ' + inttostr(FcodGrade) +
      ' and p.grupo_prod = '+inttostr(pGrupoProd) +
      ' and p.cod_prod =' + quotedstr(trim(pCodProd));
    buscas.ParamByName('vdata').AsDate := data;
    buscas.Prepare;
    buscas.Open;
    if not buscas.IsEmpty then
    begin
      Application.MessageBox('Balanço já confirmado, tente amanhã!', 'Aviso', MB_OK +
        MB_ICONINFORMATION);
      buscas.Close;
      result := false;
      exit;
    end;
  end;

  if Trim(numFabProd) = '' then
  begin
    Application.MessageBox('Código do Produto Vazio!', 'Aviso', MB_OK + MB_ICONINFORMATION);
    buscas.Close;
    result := false;
    exit;
  end;

//  if qtdEstoque < 0 then
//  begin
//    Application.MessageBox('Quantidade informada não pode ser negativa!', 'Aviso', MB_OK + MB_ICONINFORMATION);
//    buscas.Close;
//    result := false;
//    exit;
//  end;

  if (_ValidaGrade) then
  begin
    pendReqOS := 0;
    pendReqOSGrade := 0;
    qtdProducao := 0;
    qtdReq := 0;
    qtdTrans := 0;
    //Inserir com grade'
    if (editarEstoqueGrade) then
    begin
      if (vDadosIni.vEmp.vApresentarEstR = 'O') or (vDadosIni.vEmp.vApresentarEstR = 'R')
        or (vDadosIni.vEmp.vApresentarEstR = 'P') or (vDadosIni.vEmp.vApresentarEstR = 'S') then
      begin
        pendReqOSGrade := _PegarReqOsGrade(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade));
        qtdReq := _PegarReqOsGradeTipo(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade), 'REQ');
        qtdTrans := _PegarReqOsGradeTipo(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade), 'OS');
      end;

      buscas.Close;
      buscas.SQL.Text := 'select p.GRUPO_PROD,cgp.QTDE,p.COD_PROD,p.num_fab_prod,p.DESCR_PROD,' +
        ' p.Est_R,p.Est_F,p.LOCACAO_PROD,p.LOCACAO_PROD_1,p.PREC_CUSM_PROD' +
        ' from produtos as p ' +
        ' inner join cod_grade_prod as cgp ' +
        ' on p.GRUPO_PROD = cgp.GRUPO_PROD and p.COD_PROD = cgp.COD_PROD ' +
        ' and p.cod_empresa = cgp.cod_empresa ' +
        ' where p.cod_empresa =' + vDadosIni.codEmpresa +
        ' and cgp.cod_grade =' + inttostr(vcodGrade) +
        ' and p.ativo =1 and p.grupo_prod = '+inttostr(pGrupoProd) +
        ' and p.cod_prod =' + quotedstr(trim(pCodProd));
      buscas.Open;
      vPrecoCusM := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
      vdifVlContVlRealGrade := qtdEstoque - (buscas.FieldByName('QTDE').AsFloat - pendReqOSGrade);

      if qtdEstoque < 0 then
      begin
        Application.MessageBox('Ao informar uma quantidade negativa para uma grade de produto já contada fará com que esta grade seja excluída da contagem.', 'Aviso', MB_OK + MB_ICONINFORMATION);
        buscas.close;
        buscas.SQL.Text := 'DELETE FROM ESTOQUE_INI_GRADE '+
          ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
          ' and COD_PROD = ' + quotedstr(pCodProd) +
          ' and COD_GRADE = ' + inttostr(FcodGrade) +
          ' and data_confirm is null ' +
          ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
        buscas.Prepare;
        buscas.ExecSQL;
      end else begin
        buscas.close;
        buscas.SQL.Text := 'UPDATE ESTOQUE_INI_GRADE SET ' +
          ' NUM_FAB_PROD = ' + quotedstr(trim(numFabProd)) +
          ' ,LOCACAO_PROD = ' + quotedstr(Loc1) +
          ' ,LOCACAO_PROD_1 = ' + quotedstr(Loc2) +
          ' ,QUANT_EST = :qtdEst' +
          ' ,QTD_DIF_BAL = :qtdDifBal, ATIVO = 1 ' +
          ' ,DATA_CADASTRO = :DATA_CADASTRO '+
          ' ,QUANT_TRANS = :QUANT_TRANS'+
          ' , QUANT_REQ = :QUANT_REQ '+
          ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
          ' and COD_PROD = ' + quotedstr(pCodProd) +
          ' and COD_GRADE = ' + inttostr(FcodGrade) +
          ' and data_confirm is null ' +
          ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
        buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
        buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
        buscas.ParamByName('qtdEst').AsFloat := qtdEstoque;
        buscas.ParamByName('DATA_CADASTRO').AsDate := data;
        buscas.ParamByName('qtdDifBal').AsFloat := vdifVlContVlRealGrade;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
    end
    else
    begin
      if (vDadosIni.vEmp.vApresentarEstR = 'O') or (vDadosIni.vEmp.vApresentarEstR = 'R')
        or (vDadosIni.vEmp.vApresentarEstR = 'P') or (vDadosIni.vEmp.vApresentarEstR = 'S') then
      begin
        //'Grade'
        pendReqOSGrade := _PegarReqOsGrade(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade));
        qtdReq := _PegarReqOsGradeTipo(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade), 'REQ');
        qtdTrans := _PegarReqOsGradeTipo(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade), 'OS');
        qtdProducao := _PegarReqOsGradeTipo(pCodProd, inttostr(pGrupoProd), inttostr(FcodGrade), 'PRODUCAO');
      end;

      buscas.Close;
      buscas.SQL.Text := 'select p.GRUPO_PROD,p.COD_PROD,cgp.QTDE,p.num_fab_prod,p.DESCR_PROD,' +
        ' p.Est_R,p.Est_F,p.LOCACAO_PROD,p.LOCACAO_PROD_1,p.PREC_CUSM_PROD' +
        ' from produtos as p inner join cod_grade_prod as cgp ' +
        ' on p.GRUPO_PROD = cgp.GRUPO_PROD and p.COD_PROD = cgp.COD_PROD ' +
        ' and p.cod_empresa = cgp.cod_empresa ' +
        ' where p.cod_empresa =' + vDadosIni.codEmpresa +
        ' and cgp.cod_grade =' + inttostr(FcodGrade) +
        ' and p.ativo =1 and p.grupo_prod = '+inttostr(pGrupoProd) +
        ' and p.cod_prod =' + quotedstr(trim(pCodProd));
      buscas.Open;
      vPrecoCusM := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
      vdifVlContVlRealGrade := qtdEstoque - (buscas.FieldByName('QTDE').AsFloat - pendReqOSGrade);

      if qtdEstoque < 0 then
      begin
        Application.MessageBox('Quantidade informada não pode ser negativa!', 'Aviso', MB_OK + MB_ICONINFORMATION);
        buscas.Close;
        result := false;
        exit;
      end;
      buscas.close;
      buscas.SQL.Text :=
        'INSERT INTO ESTOQUE_INI_GRADE (GRUPO_PROD, COD_PROD,COD_GRADE, DATA_CADASTRO ' +
        ' ,COD_EMPRESA, NUM_FAB_PROD, LOCACAO_PROD, LOCACAO_PROD_1, QUANT_EST ' +
        ' ,QUANT_TRANS, QUANT_REQ, DATA_CONFIRM, QTD_DIF_BAL, ATIVO) ' +
        ' VALUES (' + inttostr(pGrupoProd) +
        ' ,' + quotedstr(trim(pCodProd)) +
        ' ,' + inttostr(FcodGrade) +
        ' ,:vdata , ' + vDadosIni.codEmpresa +
        ' ,' + quotedstr(trim(numFabProd)) +
        ' ,' + quotedstr(Loc1) +
        ' ,' + quotedstr(Loc2) +
        ' ,:QUANT_EST ,:QUANT_TRANS, :QUANT_REQ ,null,:qtdDifBal, 1)';
      buscas.ParamByName('QUANT_EST').AsFloat := qtdEstoque;
      buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
      buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
      buscas.ParamByName('vdata').AsDate := data;
      buscas.ParamByName('qtdDifBal').AsFloat := vdifVlContVlRealGrade;
      buscas.Prepare;
      buscas.ExecSQL;
    end;


    //Inserido ou Editando estoque_ini (produtos)
    if editarEstoque then
    begin
      if editarEstoqueGrade and (qtdEstoque >= 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select sum(QUANT_EST) as QUANT_EST, sum(QTD_DIF_BAL) as QTD_DIF_BAL '+
          ' ,sum(QUANT_TRANS) as QUANT_TRANS,sum(QUANT_REQ) as QUANT_REQ '+
          ' from ESTOQUE_INI_GRADE ' +
          ' where grupo_prod = ' + inttostr(pGrupoProd) +
          ' and cod_prod = ' + QuotedStr(trim(pCodProd)) +
          ' and data_confirm is null ' +
          ' and COD_GRADE <> '+ inttostr(FcodGrade) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;
        qtdTrans := buscas.FieldByName('QUANT_TRANS').AsFloat;
        qtdReq := buscas.FieldByName('QUANT_REQ').AsFloat;
        vqtdEstoqueProd := qtdEstoque + buscas.FieldByName('QUANT_EST').AsFloat;
        vdifVlContVlReal := buscas.FieldByName('QTD_DIF_BAL').AsFloat;
        buscas.Close;
        buscas.SQL.Text := 'select p.GRUPO_PROD,cgp.QTDE,p.COD_PROD,p.num_fab_prod,p.DESCR_PROD,' +
          ' p.Est_R,p.Est_F,p.LOCACAO_PROD,p.LOCACAO_PROD_1,p.PREC_CUSM_PROD' +
          ' from produtos as p inner join cod_grade_prod as cgp ' +
          ' on p.GRUPO_PROD = cgp.GRUPO_PROD and p.COD_PROD = cgp.COD_PROD ' +
          ' and p.cod_empresa = cgp.cod_empresa ' +
          ' where p.cod_empresa =' + vDadosIni.codEmpresa +
          ' and cgp.cod_grade =' + inttostr(vcodGrade) +
          ' and p.ativo =1 and p.grupo_prod = '+inttostr(pGrupoProd) +
          ' and p.cod_prod =' + quotedstr(trim(pCodProd));
        buscas.Open;
        vdifVlContVlRealGrade := qtdEstoque - (buscas.FieldByName('QTDE').AsFloat - pendReqOSGrade);
        vdifVlContVlReal := vdifVlContVlReal + vdifVlContVlRealGrade;
      end else begin
        buscas.Close;
        buscas.SQL.Text := 'select sum(QUANT_EST) as QUANT_EST, sum(QTD_DIF_BAL) as QTD_DIF_BAL '+
          ' ,sum(QUANT_TRANS) as QUANT_TRANS,sum(QUANT_REQ) as QUANT_REQ '+
          ' from ESTOQUE_INI_GRADE ' +
          ' where grupo_prod = ' + inttostr(pGrupoProd) +
          ' and cod_prod = ' + QuotedStr(trim(pCodProd)) +
          ' and data_confirm is null ' +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;
        qtdTrans := buscas.FieldByName('QUANT_TRANS').AsFloat;
        qtdReq := buscas.FieldByName('QUANT_REQ').AsFloat;
        vqtdEstoqueProd := buscas.FieldByName('QUANT_EST').AsFloat;
        vdifVlContVlReal := buscas.FieldByName('QTD_DIF_BAL').AsFloat;
      end;

      //Quando a quantidade for informada for negativa será apagado o estoque ini do produto caso não tenha nenhuma grade contada
      if qtdEstoque<0 then
      begin
        buscas.close;
        buscas.SQL.Text := 'select count(*) as qtd FROM ESTOQUE_INI_GRADE '+
          ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
          ' and COD_PROD = ' + quotedstr(pCodProd) +
          ' and data_confirm is null ' +
          ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
        buscas.open;
        if buscas.FieldByName('qtd').AsInteger=0 then
        begin
          Application.MessageBox('Para a única grade do produto que havia sido contada foi informado uma quantidade negativa.'+chr(13)+'Este produto será excluído da contagem.', 'Aviso', MB_OK + MB_ICONINFORMATION);
          buscas.close;
          buscas.SQL.Text := 'DELETE FROM ESTOQUE_INI '+
            ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
            ' and COD_PROD = ' + quotedstr(pCodProd) +
            ' and data_confirm is null ' +
            ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
          buscas.Prepare;
          buscas.ExecSQL;
          CommitaTransacao;
          exit;
        end;
      end;


      buscas.close;
      buscas.SQL.Text := 'UPDATE ESTOQUE_INI SET ' +
        ' NUM_FAB_PROD = ' + quotedstr(trim(numFabProd)) +
        ' ,LOCACAO_PROD = ' + quotedstr(Loc1) +
        ' ,LOCACAO_PROD_1 = ' + quotedstr(Loc2) +
        ' ,QUANT_EST = :QUANT_EST' +
        ' ,DATA_CONFIRM = NULL, TIP_BAL = ''D''' +
        ' ,DATA_CADASTRO = :vdata ' +
        ' ,QTD_DIF_BAL = :QTD_DIF_BAL, ATIVO = 1,PCUST_MC = :PCUST_MC ' +
        ' ,QUANT_TRANS = :QUANT_TRANS, QUANT_REQ = :QUANT_REQ '+
        ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
        ' and COD_PROD = ' + quotedstr(pCodProd) +
        ' and (data_confirm is null) ' +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
      buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
      buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
      buscas.ParamByName('QUANT_EST').AsFloat := vqtdEstoqueProd;
      buscas.ParamByName('QTD_DIF_BAL').AsFloat := vdifVlContVlReal;
      buscas.ParamByName('PCUST_MC').AsFloat := vPrecoCusM;
      buscas.ParamByName('vdata').AsDate := data;
      buscas.Prepare;
      buscas.ExecSQL;
      CommitaTransacao;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := 'select sum(QUANT_EST) as QUANT_EST, sum(QTD_DIF_BAL) as QTD_DIF_BAL '+
        ' ,sum(QUANT_TRANS) as QUANT_TRANS, sum(QUANT_REQ) as QUANT_REQ '+//, sum(QUANT_PRODUCAO) as QUANT_PRODUCAO '+
        ' from ESTOQUE_INI_GRADE ' +
        ' where grupo_prod = ' + inttostr(pGrupoProd) +
        ' and cod_prod = ' + QuotedStr(trim(pCodProd)) +
        ' and data_confirm is null ' +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      qtdReq := buscas.FieldByName('QUANT_REQ').AsFloat;
      qtdTrans := buscas.FieldByName('QUANT_TRANS').AsFloat;
//      qtdProducao := buscas.FieldByName('QUANT_PRODUCAO').AsFloat;
      vqtdEstoqueProd := buscas.FieldByName('QUANT_EST').AsFloat;
      vdifVlContVlReal := buscas.FieldByName('QTD_DIF_BAL').AsFloat;

      buscas.close;
      buscas.SQL.Text := 'INSERT INTO ESTOQUE_INI (GRUPO_PROD, COD_PROD, DATA_CADASTRO ' +
        ' ,COD_EMPRESA, NUM_FAB_PROD, LOCACAO_PROD, LOCACAO_PROD_1, QUANT_EST ' +
        ' ,QUANT_TRANS, QUANT_REQ, DATA_CONFIRM, TIP_BAL, QTD_DIF_BAL, ATIVO, PCUST_MC, QUANT_PRODUCAO) ' +
        ' VALUES (' + inttostr(pGrupoProd) +
        ' ,' + quotedstr(trim(pCodProd)) +
        ' ,:vdata , ' + vDadosIni.codEmpresa +
        ' ,' + quotedstr(trim(numFabProd)) +
        ' ,' + quotedstr(Loc1) +
        ' ,' + quotedstr(Loc2) +
        ' ,:QUANT_EST ,:QUANT_TRANS, :QUANT_REQ , NULL,''D'',:qtdDifBal, 1,:pcustM, :QUANT_PRODUCAO )';
      buscas.ParamByName('QUANT_EST').AsFloat := vqtdEstoqueProd;
      buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
      buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
      buscas.ParamByName('vdata').AsDate := data;
      buscas.ParamByName('qtdDifBal').AsFloat := vdifVlContVlReal;
      buscas.ParamByName('pcustM').AsFloat := vPrecoCusM;
      buscas.ParamByName('QUANT_PRODUCAO').AsFloat := 0;//qtdProducao;   Produto com grade por enquanto não tem a parte de produção
      buscas.Prepare;
      buscas.ExecSQL;
      CommitaTransacao;
    end;
  end
  else
  begin  //aqui o produto não tem grade
    pendReqOS := 0;
    qtdReq := 0;
    qtdTrans := 0;
    qtdProducao := 0;
    if (vDadosIni.vEmp.vApresentarEstR = 'O') or (vDadosIni.vEmp.vApresentarEstR = 'R')
      or (vDadosIni.vEmp.vApresentarEstR = 'P') or (vDadosIni.vEmp.vApresentarEstR = 'S') then
    begin
      pendReqOS := getQuantidadePendenteReqOS(pGrupoProd, pCodProd);
      qtdReq := getQuantidadePendenteReqOS(pGrupoProd, pCodProd, 'REQ');
      qtdTrans := getQuantidadePendenteReqOS(pGrupoProd, pCodProd, 'OS');
      qtdProducao := getQuantidadePendenteReqOS(pGrupoProd, pCodProd, 'PRODUCAO');
    end;

    //Variável verifica se o produto já foi contado : editarEstoque
    if editarEstoque then
    begin
      if qtdEstoque<0 then
      begin
        Application.MessageBox('Foi informado uma quantidade negativa para um produto já contado.'+chr(13)+'O mesmo será excluído da contagem.', 'Aviso', MB_OK + MB_ICONINFORMATION);
        buscas.close;
        buscas.SQL.Text := 'DELETE FROM ESTOQUE_INI '+
          ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
          ' and COD_PROD = ' + quotedstr(pCodProd) +
          ' and data_confirm is null ' +
          ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
        buscas.Prepare;
        buscas.ExecSQL;
        CommitaTransacao;
        exit;
      end;

      buscas.Close;
      buscas.SQL.Text := 'select GRUPO_PROD,COD_PROD,num_fab_prod,DESCR_PROD,' +
        ' Est_R,Est_F,LOCACAO_PROD,LOCACAO_PROD_1,PREC_CUSM_PROD' +
        ' from produtos where grupo_prod = '+inttostr(pGrupoProd) +
        ' and cod_prod =' + quotedstr(trim(pCodProd)) +
        ' and cod_empresa =' + vDadosIni.codEmpresa + ' and ativo =1 ';
      buscas.Open;
      vdifVlContVlReal := qtdEstoque - (buscas.FieldByName('EST_F').AsFloat - pendReqOS);
      vPrecoCusM := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;

      buscas.close;
      buscas.SQL.Text := 'UPDATE ESTOQUE_INI SET ' +
        ' NUM_FAB_PROD = ' + quotedstr(trim(numFabProd)) +
        ' ,LOCACAO_PROD = ' + quotedstr(Loc1) +
        ' ,LOCACAO_PROD_1 = ' + quotedstr(Loc2) +
        ' ,QUANT_EST = :QUANT_EST' +
        ' ,DATA_CONFIRM = NULL, TIP_BAL = ''D''' +
        ' ,QTD_DIF_BAL = :QTD_DIF_BAL, ATIVO = 1,PCUST_MC = :pcustM ' +
        ' ,DATA_CADASTRO = :DATA_CADASTRO '+
        ' ,QUANT_TRANS= :QUANT_TRANS, QUANT_REQ= :QUANT_REQ, QUANT_PRODUCAO = :QUANT_PRODUCAO ' +
        ' WHERE GRUPO_PROD = ' + inttostr(pGrupoProd) +
        ' and COD_PROD = ' + quotedstr(pCodProd) +
        ' and (data_confirm is null) ' +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
      buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
      buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
      buscas.ParamByName('QUANT_PRODUCAO').AsFloat := qtdProducao;
      buscas.ParamByName('QUANT_EST').AsFloat := qtdEstoque;
      buscas.ParamByName('QTD_DIF_BAL').AsFloat := vdifVlContVlReal;
      buscas.ParamByName('pcustM').AsFloat := vPrecoCusM;
      buscas.ParamByName('DATA_CADASTRO').AsDate:=data;
      buscas.Prepare;
      buscas.ExecSQL;
      CommitaTransacao;
    end
    else
    begin
      if qtdEstoque < 0 then
      begin
        Application.MessageBox('Quantidade informada não pode ser negativa!', 'Aviso', MB_OK + MB_ICONINFORMATION);
        buscas.Close;
        result := false;
        exit;
      end;
      buscas.Close;
      buscas.SQL.Text := 'select GRUPO_PROD,COD_PROD,num_fab_prod,DESCR_PROD,' +
        ' Est_R,Est_F,LOCACAO_PROD,LOCACAO_PROD_1,PREC_CUSM_PROD' +
        ' from produtos where grupo_prod = '+inttostr(pGrupoProd) +
        ' and cod_prod =' + quotedstr(trim(pCodProd)) +
        ' and cod_empresa =' + vDadosIni.codEmpresa + ' and ativo =1 ';
      buscas.Open;
      vdifVlContVlReal := qtdEstoque - (buscas.FieldByName('EST_F').AsFloat - pendReqOS);
      vPrecoCusM := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;

      buscas.close;
      buscas.SQL.Text := 'INSERT INTO ESTOQUE_INI (GRUPO_PROD, COD_PROD, DATA_CADASTRO ' +
        ' ,COD_EMPRESA, NUM_FAB_PROD, LOCACAO_PROD, LOCACAO_PROD_1, QUANT_EST ' +
        ' ,QUANT_TRANS, QUANT_REQ, DATA_CONFIRM, TIP_BAL, QTD_DIF_BAL, ATIVO, PCUST_MC, QUANT_PRODUCAO) ' +
        ' VALUES (' + inttostr(pGrupoProd) +
        ' ,' + quotedstr(trim(pCodProd)) +
        ' ,:vdata , ' + vDadosIni.codEmpresa +
        ' ,' + quotedstr(trim(numFabProd)) +
        ' ,' + quotedstr(Loc1) +
        ' ,' + quotedstr(Loc2) +
        ' ,:QUANT_EST ,:QUANT_TRANS, :QUANT_REQ , NULL,''D'',:qtdDifBal, 1,:pcustM, :QUANT_PRODUCAO )';
      buscas.ParamByName('QUANT_EST').AsFloat := qtdEstoque;
      buscas.ParamByName('QUANT_TRANS').AsFloat := qtdTrans;
      buscas.ParamByName('QUANT_REQ').AsFloat := qtdReq;
      buscas.ParamByName('vdata').AsDate := data;
      buscas.ParamByName('qtdDifBal').AsFloat := vdifVlContVlReal;
      buscas.ParamByName('pcustM').AsFloat := vPrecoCusM;
      buscas.ParamByName('QUANT_PRODUCAO').AsFloat := qtdProducao;
      buscas.Prepare;
      buscas.ExecSQL;
      CommitaTransacao;
    end;
  end;
end;

function TFichaInventario._AbreGradeProduto(pGrupoProd: Integer; pCodProd: string; NumFab: string): boolean;
begin
	vPesqDescrProd := false;
  vEncontrouProd := false;
  buscas.Close;
  if (pGrupoProd > 0) or (trim(pCodProd) <> '') then
  	buscas.SQL.Text := 'select distinct p.*, ' +
	    ' coalesce(est.estoque, 0) estoque_disponivel, ' +
  	  ' coalesce(est.est_prima, 0) estoque_produzir	 from cod_barra cb ' +
      ' inner join produtos p on cb.grupo_prod = p.grupo_prod and cb.cod_prod = p.cod_prod and cb.cod_empresa = p.cod_empresa ' +
      ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where cb.cod_barra = ' + QuotedStr(trim(NumFab)) +
      ' and cb.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and cb.cod_prod = ' + QuotedStr(pCodProd) +
      ' and cb.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1'
  else
    buscas.SQL.Text := 'select distinct p.*, ' +
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
 	 	  ' coalesce(est.est_prima, 0) estoque_produzir from cod_barra cb ' +
      ' inner join produtos p on cb.grupo_prod = p.grupo_prod and cb.cod_prod = p.cod_prod and cb.cod_empresa = p.cod_empresa ' +
      ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where cb.cod_barra = ' + QuotedStr(trim(NumFab)) +
      ' and cb.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1';
  buscas.Open;
  buscas.FetchAll;

  if buscas.IsEmpty then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select distinct p.*, ' +
    	' coalesce(est.estoque, 0) estoque_disponivel, ' +
 	 	  ' coalesce(est.est_prima, 0) estoque_produzir from cod_barra cb ' +
      ' inner join produtos p on cb.grupo_prod = p.grupo_prod and cb.cod_prod = p.cod_prod and cb.cod_empresa = p.cod_empresa ' +
      ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where p.descr_prod like ' + QuotedStr(NumFab + '%') +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1 ' +
      ' order by p.descr_prod ';
    buscas.Open;
    buscas.FetchAll;

    if not buscas.IsEmpty then
    	vPesqDescrProd := true;
  end;

  if not buscas.IsEmpty then
    if buscas.RecordCount > 1 then
    begin
    	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
      TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
      TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
      TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
      TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
      TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
      if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
      begin
        Result := false;
        exit;
      end;
    end;

  vEncontrouProd := not buscas.isEmpty;
  Result := not buscas.isEmpty;
end;

function TFichaInventario._PegarReqOsGrade(CodProd, GrupoProd,
  Grade: string): double;
begin
  Result := vDadosIni.getPendenciasEstoque(StrToIntDef(Trim(GrupoProd), 0), CodProd, StrToIntDef(Trim(Grade), 0), '', buscas, True);
  Exit;

  Result := 0;
  buscas.close;
  buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = ' + quotedstr(trim(CodProd)) +
    ' and ipv.grupo_prod = ' + trim(GrupoProd) +
    ' and ipv.COD_GRADE = ' + trim(Grade) +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and pv.tipo <> ''ORC''' + //esta data é a inicial do banco quando tem migração
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' +
    vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  buscas.Prepare;
  buscas.Open;
  Result := buscas.FieldByName('valor').AsFloat;
  buscas.Close;
  buscas.UnPrepare;
end;

function TFichaInventario._PegarReqOsGradeTipo(CodProd, GrupoProd, Grade,
  Tipo: string): Double;
begin
  Result := vDadosIni.getPendenciasEstoque(StrToIntDef(Trim(GrupoProd), 0), CodProd, StrToIntDef(Trim(Grade), 0), Tipo, buscas, True);
  Exit;

  Result := 0;
  buscas.close;
  buscas.SQL.Text := 'select coalesce(sum(ipv.quant_ped_item),0) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = ' + quotedstr(trim(CodProd)) +
    ' and ipv.grupo_prod = ' + trim(GrupoProd) +
    ' and ipv.COD_GRADE = ' + trim(Grade) +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and pv.tipo = ' + quotedstr(trim(tipo)) +
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' +
    vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  buscas.Prepare;
  buscas.Open;
  Result := buscas.FieldByName('valor').AsFloat;
  buscas.Close;
  buscas.UnPrepare;
end;

