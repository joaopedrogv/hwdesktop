procedure TProdutos._desmarcaLinha;
begin
  if dataSet.IsEmpty then
    exit;

  dataSet.Edit;
  dataSet.FieldByName('SEL').AsString := '';
  dataSet.Post;
end;

procedure TProdutos._desmarcarTodos;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    checkUnCheckAllRows(False);
    {
    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;
    }
  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;


procedure TProdutos._desmarcarTodosTemp(pDataset: TDataSet);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not pDataset.Active then
      Exit;

    pDataset.DisableControls;
    pDataset.First;
    while not pDataset.Eof do
    begin
      pDataset.Edit;
      pDataset.FieldByName('sel').AsString := '';
      pDataset.Post;
      pDataset.Next;
    end;
    pDataset.First;

  finally
  	pDataset.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

