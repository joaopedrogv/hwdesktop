function TGradeEstoque.post: boolean;
var
  vOldvalueqtdgrade:double;
  i:integer;
  vJaregistrado:boolean;
begin
  try
    Result := false;
    vJaregistrado:=false;
    buscas.Close;
    buscas.SQL.Text:= 'select qtde from cod_grade_prod ' +
     ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
     ' and cod_prod = ' + trim(dataSet.FieldByName('cod_prod').AsString) +
     ' and cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
     ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vOldvalueqtdgrade := buscas.FieldByName('qtde').AsFloat;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.FieldByName('cod_grade').AsString = '' then
      raise exception.create('Grade precisa ser preenchida');
    if dataSet.FieldByName('qtde').AsString = '' then
      raise exception.create('Quantidade precisa ser preenchida');
    try
      dataSet.Post
    except
      on e: exception do
      begin
        if Pos('KEY VIOLATION', UpperCase(e.Message)) > 0 then
        begin
          dataSet.Delete;
          raise exception.create('Itens repetidos');
        end;
      end;

    end;
    Result := TRUE;

    for I := 0 to vRelacaoAltGrades.Count - 1 do
      if pos('Grupo:'+dataSet.FieldByName('grupo_prod').AsString+
        ' CodProd:'+trim(dataSet.FieldByName('cod_prod').AsString)+
        ' GRADE:'+dataSet.FieldByName('cod_grade').AsString, vRelacaoAltGrades.Strings[i])>0 then
      begin
        vJaregistrado:=true;
        break;
      end;

    if vJaregistrado then
      vRelacaoAltGrades.Strings[i]:=('Grupo:'+dataSet.FieldByName('grupo_prod').AsString+
        ' CodProd:'+trim(dataSet.FieldByName('cod_prod').AsString)+
        ' GRADE:'+dataSet.FieldByName('cod_grade').AsString+
        ' OLDQTD:'+FloatToStr(vOldvalueqtdgrade)+
        ' NEWQTD:'+dataSet.FieldByName('qtde').AsString)
    else vRelacaoAltGrades.Add('Grupo:'+dataSet.FieldByName('grupo_prod').AsString+
        ' CodProd:'+trim(dataSet.FieldByName('cod_prod').AsString)+
        ' GRADE:'+dataSet.FieldByName('cod_grade').AsString+
        ' OLDQTD:'+FloatToStr(vOldvalueqtdgrade)+
        ' NEWQTD:'+dataSet.FieldByName('qtde').AsString);
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

procedure TGradeEstoque.renconciliaErro(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  try
    if (Pos('PK_COD_GRADE_PROD', e.Message) <> 0) then
    begin
      Application.MessageBox('Itens repetidos', 'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end
    else if (Pos('KEY VIOLATION', UpperCase(e.Message)) <> 0) then
    begin
      Application.MessageBox('Itens repetidos', 'Erro', MB_OK + MB_ICONERROR);
      Abort;
    end;
  finally
    //    RollBackTransacao;
    Self.DataSet.Cancel;
  end;
end;

function TGradeEstoque.replicaGradeEstoque: boolean;
var
  buscas2: TIBQuery;
  I: Integer;
  J: Integer;
begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  vDadosIni.verificarReplicacaoInterna(buscas, false, 'COD_GRADE_PROD');

  buscas.Close;
  buscas.SQL.Text :=
    'INSERT INTO COD_GRADE_PROD (GRUPO_PROD, COD_PROD, COD_GRADE, COD_EMPRESA, QTDE, ATIVO, QTD_ETIQUETAS)' +
    ' VALUES (:GRUPO_PROD, :COD_PROD, :COD_GRADE, :COD_EMPRESA, :QTDE, :ATIVO, :QTD_ETIQUETAS)';
  for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
  begin
    abreGradeEstoque(IntToStr(fOldGrupo), fOldCodigo);
    dataSet.First;

    while not dataSet.Eof do
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select * from COD_GRADE_PROD' +
        ' where GRUPO_PROD = :GRUPO_PROD ' +
        ' and COD_PROD = :COD_PROD ' +
        ' and COD_GRADE = :COD_GRADE ' +
        ' and COD_EMPRESA = :COD_EMPRESA ';
      buscas2.ParamByName('GRUPO_PROD').AsInteger := fOldGrupo;
      buscas2.ParamByName('COD_PROD').AsString := fOldCodigo;
      buscas2.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
      buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);
      buscas2.Open;

      if buscas2.IsEmpty then
      begin
        buscas2.Close;
        buscas2.SQL.Text := 'select * from COD_GRADE_PROD' +
          ' where GRUPO_PROD = :GRUPO_PROD ' +
          ' and COD_PROD = :COD_PROD ' +
          ' and COD_GRADE = :COD_GRADE ' +
          ' and COD_EMPRESA = :COD_EMPRESA ';
        buscas2.ParamByName('GRUPO_PROD').AsInteger := fOldGrupo;
        buscas2.ParamByName('COD_PROD').AsString := fOldCodigo;
        buscas2.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
        buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas2.Open;

        buscas.Close;

        if not buscas2.IsEmpty then
          for J := 0 to buscas2.FieldCount - 1 do
            buscas.ParamByName(buscas2.Fields[J].FieldName).Value :=
              buscas2.FieldByName(buscas2.Fields[J].FieldName).Value;

        buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);
        buscas.ParamByName('qtde').AsFloat := 0;

        try
          buscas.ExecSQL;
        except
          on e: exception do
          begin
            Result := false;
            Application.MessageBox(pchar('Erro na replicação de grades entre empresas. Erro: ' +
              e.Message), 'Atenção', MB_ICONEXCLAMATION +
              MB_OK);
            exit;
          end;
        end;
      end;
      dataSet.Next;
    end;
  end;

  CommitaTransacao;
end;

