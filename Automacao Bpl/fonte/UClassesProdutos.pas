procedure TProdutos.PreencherCamposDisplay(pBuscas: TIBQuery);
var
	I: Integer;
  vbuscas: TIBQuery;
begin
	try
    vbuscas := TIBQuery.Create(Application);
    vbuscas.Database := pBuscas.Database;
    vbuscas.Transaction := pBuscas.Transaction;

    if DtmProdutos = nil then
      DtmProdutos := TDtmProdutos.Create(DtmProdutos);

    if DtmProdutos.CdsProdutos.FieldCount > 0 then
    begin
      for I := 0 to DtmProdutos.CdsProdutos.FieldCount - 1 do
      begin
      	vbuscas.Close;
        vbuscas.SQL.Text := ' select rdb$relation_name, rdb$field_name from rdb$relation_fields ' +
        	' where rdb$relation_name = :NOME_TABELA ' +
          ' and rdb$field_name = :CAMPO ';
        vbuscas.ParamByName('NOME_TABELA').AsString := 'PRODUTOS';
        vbuscas.ParamByName('CAMPO').AsString := DtmProdutos.CdsProdutos.Fields[I].FieldName;
        vbuscas.Open;

        if not vbuscas.IsEmpty then
        begin
          vbuscas.Close;
          vbuscas.SQL.Text := ' UPDATE OR INSERT INTO CAMPOS_DISPLAY (NOME_TABELA, CAMPO, DISPLAY, TAMANHO, TAG) ' +
            ' VALUES (:NOME_TABELA, :CAMPO, :DISPLAY, :TAMANHO, :TAG) ' +
            ' MATCHING (NOME_TABELA, CAMPO); ';
          vbuscas.ParamByName('NOME_TABELA').AsString := 'PRODUTOS';
          vbuscas.ParamByName('CAMPO').AsString := DtmProdutos.CdsProdutos.Fields[I].FieldName;
          vbuscas.ParamByName('DISPLAY').AsString := DtmProdutos.CdsProdutos.Fields[I].DisplayLabel;
          vbuscas.ParamByName('TAMANHO').AsInteger := DtmProdutos.CdsProdutos.Fields[I].Size;
          if UpperCase(trim(DtmProdutos.CdsProdutos.Fields[I].FieldName)) = 'COD_BARRA_ETI' then
          	vbuscas.ParamByName('TAG').AsInteger := 0
          else
          	vbuscas.ParamByName('TAG').AsInteger := DtmProdutos.CdsProdutos.Fields[I].Tag;
          vbuscas.ExecSQL;
        end;
      end;

      if vbuscas.Transaction.InTransaction then
        vbuscas.Transaction.Commit;
    end;


    if DtmProdutos.cdsGrade.FieldCount > 0 then
    begin
      for I := 0 to DtmProdutos.cdsGrade.FieldCount - 1 do
      begin
        vbuscas.Close;
        vbuscas.SQL.Text := ' select rdb$relation_name, rdb$field_name from rdb$relation_fields ' +
          ' where rdb$relation_name = :NOME_TABELA ' +
          ' and rdb$field_name = :CAMPO ';
        vbuscas.ParamByName('NOME_TABELA').AsString := 'GRADE';
        vbuscas.ParamByName('CAMPO').AsString := DtmProdutos.cdsGrade.Fields[I].FieldName;
        vbuscas.Open;

        if not vbuscas.IsEmpty then
        begin
          vbuscas.Close;
          vbuscas.SQL.Text := ' UPDATE OR INSERT INTO CAMPOS_DISPLAY (NOME_TABELA, CAMPO, DISPLAY, TAMANHO, TAG) ' +
            ' VALUES (:NOME_TABELA, :CAMPO, :DISPLAY, :TAMANHO, :TAG) ' +
            ' MATCHING (NOME_TABELA, CAMPO); ';
          vbuscas.ParamByName('NOME_TABELA').AsString := 'GRADE';
          vbuscas.ParamByName('CAMPO').AsString := DtmProdutos.cdsGrade.Fields[I].FieldName;
          vbuscas.ParamByName('DISPLAY').AsString := DtmProdutos.cdsGrade.Fields[I].DisplayLabel;
          vbuscas.ParamByName('TAMANHO').AsInteger := DtmProdutos.cdsGrade.Fields[I].Size;
          vbuscas.ParamByName('TAG').AsInteger := DtmProdutos.cdsGrade.Fields[I].Tag;
          vbuscas.ExecSQL;
        end;
      end;

      if vbuscas.Transaction.InTransaction then
        vbuscas.Transaction.Commit;
    end;

  except
    on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.PreencherCamposDisplay. Erro: ' + e.Message);
    end;
  end;
end;

