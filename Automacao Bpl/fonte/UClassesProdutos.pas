function TProdutos.edit: boolean;
var
  Config: TConfig_sistema_class;
  I: Integer;
  payload: TConvProdutoInput;
begin
  Result := inherited edit;
  if Result then
  begin
  	dataSet.FieldByName('DESCR_PROD').AsString := UpperCase(trim(dataSet.FieldByName('DESCR_PROD').AsString));
    dataSet.FieldByName('DESCR_PROD_RED').AsString := UpperCase(trim(dataSet.FieldByName('DESCR_PROD_RED').AsString));
  	dataSet.FieldByName('UNIDADE').AsString := UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString));

  	if trim(dataSet.FieldByName('USAR_DEBCRED').AsString) <> 'N' then
    	dataSet.FieldByName('USAR_DEBCRED').AsString := 'S';

    try
    	Config := TConfig_sistema_class.getConf('cashback_conf_prod', buscas, vDadosIni.cod_empresa);

      if dataSet.FieldByName('PERC_COMISSAO_CASHBACK').AsFloat <= 0 then
      begin
        try
          dataSet.FieldByName('PERC_COMISSAO_CASHBACK').AsFloat := StrToFloat(Config.ReadString('Conf', 'PercComissao'))
        except
          dataSet.FieldByName('PERC_COMISSAO_CASHBACK').AsFloat := 10;
        end;
      end;

      if dataSet.FieldByName('DIAS_VENC_CASHBACK').AsInteger <= 0 then
      begin
        try
          dataSet.FieldByName('DIAS_VENC_CASHBACK').AsInteger := StrToInt(Config.ReadString('Conf', 'DiasVencimento'))
        except
          dataSet.FieldByName('DIAS_VENC_CASHBACK').AsInteger := 365;
        end;
      end;
    finally
      if Assigned(Config) then
        FreeAndNil(Config);
    end;
    
  	vEst_f_prod := dataSet.FieldByName('EST_F').AsFloat;
  	vPrec_cusm_prod := dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
  	oldForaLinha := dataSet.FieldByName('FORA_LINHA').AsString;

  	montarTreeViewEC := true;
    montarTreeViewCA := true;
  	vLiberarNumFabProdExistente := false;

//    CalcUsandoMagem := TCfg_sis.getConf('nf_e_alteracao_preco', buscas, vDadosIni.cod_empresa).ReadString('Conf', 'TelaProdutoTrocarCampoMarkupParaMargem') = 'S';
    setaCamposVariaveisEdit;
//    if not vGrupo.dataSet.Active then
//      vGrupo.abreGrupos;
    if not AlterarGrupo then
    begin
    	vGrupo.abreGrupos;

      payload := TConvProdutoInput.Create;
      try
        payload.grupo_prod := fint('grupo_prod');
        payload.cod_prod := fstr('cod_prod');
        payload.cod_empresa := fint('cod_empresa');
        payload.usuario := vDadosIni.vNomeUsuario;
        if ConversaoUnidadeUtils.HandleCadastroEanEprodutoSilent(buscas.Database, payload) > 0 then
          dataSet.FieldByName('INF_UNIDADE').AsString := 'S';
      finally
        payload.Free;
      end;

    end
    else
      vGrupo.montaSelect(' SELECT * FROM GRUPOS WHERE ATIVO = 1 AND CODIGO_GRUP <> ' + IntToStr(StrToIntDef(oldGrupoProd,0)));
//    if not vSubGrupo.dataSet.Active then
      vSubGrupo.abreSubGrupos;
//    if not MarcaProd.dataset.Active then
    	MarcaProd.abreMarca;
//    if not vComissaoFaixaDesconto.Active then
	    vComissaoFaixaDesconto.abreComissaoFaixaDesconto;
    if LocPPSProduto = nil then
      LocPPSProduto := TLocPPSProdutos.create;
    if not LocPPSProduto.buscas.Active then
      LocPPSProduto.abreLocPPSProduto;
    CodBarra.abreCodBarrasProd(
    	dataSet.FieldByName('GRUPO_PROD').asinteger,
      dataSet.FieldByName('COD_PROD').asstring);
    existeInformacaoComplementar(dataSet.FieldByName('cod_inf').AsInteger);
    vIndTec.PesquisaIndice_materiaPrima(
    	dataSet.FieldByName('cod_prod').AsString,
      dataSet.FieldByName('grupo_prod').AsString);
    vTipoPreco._abreTipoPrecoTabela;
    vRegiao._abreRegiao('');
    vPromocaoProduto._abrePrecoProdutos(
    	Trim(dataSet.FieldByName('grupo_prod').AsString),
      Trim(dataSet.FieldByName('cod_prod').AsString));
    vPromocaoProduto.vProduto := Self;
    vConsProdutosConversao._abreProdutosConversao(
    	dataSet.FieldByName('GRUPO_PROD').AsString,
      dataSet.FieldByName('COD_PROD').AsString);
    vProdutosDesmembramento._abreProdutosDesmembramento(
    	dataSet.FieldByName('GRUPO_PROD').AsString,
      dataSet.FieldByName('COD_PROD').AsString);
    vProdutosTribAd._selecionaTribAdicional(
    	dataSet.FieldByName('GRUPO_PROD').AsInteger,
      dataSet.FieldByName('COD_PROD').AsString);
    vKitsProduto._abreKitsProdutos(dataSet);
    vProdutosPrecoQtde._abrePrecoProdutos(dataSet);
    vCategorias.abreCategorias(dataSet);
    vProdutosEC.abreProdutosEC(dataSet);
    vGradeProd.abreGradeProd(dataSet);
    vImagensProd.abreImagem(dataSet);
    vUnidadeProd.Abrir;
    FFretePorPeso.GetDataSet();
    fPrecTabAnter := vDadosIni.StrToFloatFormat(dataSet.FieldByName('prec_tab_prod').AsFloat, vDadosIni.vEmp.vCasasDecimais);
    if not vGradeProd.dataSet.IsEmpty then
      vGradeProd.dataSet.First;

    FEstadoCodSeq := enEdit;
    dataSet.FieldByName('isento_pis').OnChange := isento_pis_Change;
    dataSet.FieldByName('cst_pis').OnChange := cst_pis_Change;
    //    if not PerfilProd.dataSet.Active then
    //      PerfilProd.abrePerfilProd(false);
  end;
end;

function TProdutos.EnviarDadosComercioAberto(pRemover: boolean = false): boolean;
var
  acao: string;
begin
  Result := false;

  acao := 'ENVIAR';
  if pRemover then acao := 'REMOVER';

	try
    prepare_loop('SEL = ''S''');
  	try
      if dataSet.IsEmpty then
      begin
        Application.MessageBox('Nenhum produto selecionado.', 'Atenção',
          MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not vDadosIni.PesqPros('PRO438', 'ATUALIZAR', '', 'PRODUTOS_EC', '', buscas, true) then
        Exit;

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Atualizar dados do Comércio Aberto (' +
          	IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        vProdutosEC.abreProdutosEC(dataSet);
        if vProdutosEC.dataSet.IsEmpty then
          vProdutosEC.insert(dataSet)
        else
          vProdutosEC.Edit(dataset);
        if trim(vProdutosEC.dataSet.FieldByName('DESCR_PROD_RES').AsString) = '' then
        	vProdutosEC.dataSet.FieldByName('DESCR_PROD_RES').AsString :=
            vDadosIni.PrimeiraLetrasMaiusculaCadaPalavra(trim(dataSet.FieldByName('DESCR_PROD').AsString));
        vProdutosEC.dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString :=
        	vDadosIni.IfThen(pRemover or (fint('ativo') = 0), 'N', 'S');
        if trim(vProdutosEC.dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString) = '' then
        	vProdutosEC.dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString := 'N';
        vProdutosEC.dataSet.Post;

        SqlOpen(' select grupo_prod, cod_prod, cod_grade, cod_empresa from cod_grade_prod ' +
          ' where cod_grade > 0 and grupo_prod = ' + IntToStr(dataset.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).FetchAll;

        buscas.First;
        while not buscas.Eof do
        begin
          vProdutosEC.vProdutosECgrade.abreProdutosECgrade(dataset, buscas.FieldByName('cod_grade').AsInteger);
          if vProdutosEC.vProdutosECgrade.dataSet.IsEmpty then
            vProdutosEC.vProdutosECgrade.insert(dataSet)
          else
            vProdutosEC.vProdutosECgrade.Edit;
          vProdutosEC.vProdutosECgrade.dataSet.FieldByName('COD_GRADE').AsInteger :=
            buscas.FieldByName('cod_grade').AsInteger;
          vProdutosEC.vProdutosECgrade.dataSet.FieldByName('ENV_COMERCIO_ABERTO').AsString :=
          	vDadosIni.IfThen(pRemover or (fint('ativo') = 0), 'N', 'S');
          vProdutosEC.vProdutosECgrade.Post;

          buscas.Next;
        end;

        if vProdutosEC.dataSet.ChangeCount > 0 then
        	vProdutosEC.Apply;

        if vProdutosEC.vProdutosECgrade.dataSet.ChangeCount > 0 then
          vProdutosEC.vProdutosECgrade.Apply;


        vDadosIni.GravaAuditoria('PRO438', acao, '', 'PRODUTOS_EC',
        	IntToStr(dataset.FieldByName('grupo_prod').AsInteger) + ' - ' +
          trim(dataSet.FieldByName('cod_prod').AsString), buscas);

        dataset.Next;
      end;

      if SqlOpen('select count(ec.grupo_prod) contador from vw_produtos_ec ec' +
                 ' where ec.env_comercio_aberto = ''S'' and ec.api = ''COMERCIOABERTO''' +
                 ' and ec.cod_empresa = %d and ec.ativo = 1', [vDadosIni.cod_empresa]).FieldByName('contador').AsInteger > LIMITE_COMERCIOABERTO then
      begin
        RollBackTransacao;

        ShowErro(LIMITE_COMERCIOABERTO_MENSAGEM);

        Exit;
      end;

      CommitaTransacao;

      vDadosIni.GravaAuditoria('PRO438', 'ATUALIZAR', 'SUCESSO', 'PRODUTOS_EC', '', buscas);

      Result := true;

      {$REGION 'chamada da dll para enviar'}
      try
        vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Api');

        dataSet.First;
        while not dataSet.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Ap (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          SqlOpen(' select grupo_prod, cod_prod, cod_grade, cod_empresa from cod_grade_prod ' +
                  ' where cod_grade > 0 and grupo_prod = %d and cod_prod = %s and cod_empresa = %d',
                  [fint('grupo_prod'), fstrq('cod_prod'), vDadosIni.cod_empresa], buscas).FetchAll;

          if buscas.IsEmpty then
            hw_comercio_produto_enviar(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa, fint('grupo_prod'), WideString(fstr('cod_prod')), 0);

          buscas.First;
          while not buscas.Eof do
          begin
            hw_comercio_produto_enviar(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa,
                                       fint('grupo_prod'), WideString(fstr('cod_prod')),
                                       buscas.FieldByName('cod_grade').AsInteger);
            buscas.Next;
          end;

          dataSet.Next;
        end;
        buscas.Close;

        hw_comercio_consulta_periodica(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa);

      except on E: Exception do
        begin
          registraErro('TProdutos.EnviarDadosComercioAberto %s', [e.Message]);
          ShowErro('Erro ao enviar dados para Api ' + sLineBreak + E.Message);
        end;
      end;
      {$ENDREGION}

    finally
      prepare_loop_done;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on E: Exception do
    begin
      result := False;
      vDadosIni.GravaAuditoria('PRO438', 'ATUALIZAR', 'ERRO', 'PRODUTOS_EC', '', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.abrirComprasEVendasC. Erro: ' + e.Message);
    end;
  end;
end;

function TProdutos.EnviarRegistroLixeira: boolean;
begin
  result := true;
  if Edit then
  begin
    dataSet.FieldByName('ATIVO').asinteger := 0;
    if inherited Post then
      if Apply then
      begin
        if ExecutaComandosSqlExec('update cod_barra cb set cb.ativo=0 where ' +
          ' cb.GRUPO_PROD=' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cb.COD_PROD=' + quotedstr(trim(dataSet.FieldByName('COD_PROD').asstring)) +
          ' and cb.cod_empresa=' + vDadosIni.codEmpresa) then
        begin
          if not CommitaTransacao then
          begin
            result := false;
            Application.MessageBox('Não foi possível enviar registro para a lixeira.', 'Aviso',
              MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          end;
        end
        else
        begin
          RollBackTransacao;
          result := false;
          Application.MessageBox('Não foi possível enviar registro para a lixeira.', 'Aviso', MB_OK
            + MB_ICONERROR + MB_DEFBUTTON1)
        end;
      end
      else
      begin
        RollBackTransacao;
        result := false;
        Application.MessageBox('Não foi possível enviar registro para a lixeira.', 'Aviso', MB_OK
          + MB_ICONERROR + MB_DEFBUTTON1)
      end;
  end;
end;

