        Result := False;
        Exit;
      end;

//      RollBackTransacao;
//      GravaLogConfirmacao(statusRegistro, 'PRO009', false);

    end
    else
    begin
      oldGrupoProd := dataSet.FieldByName('GRUPO_PROD').AsString;
      oldCodProd := dataSet.FieldByName('COD_PROD').AsString;
      oldNumFabProd := dataSet.FieldByName('NUM_FAB_PROD').AsString;

