      vMD5Func._gravaMD5_Produtos(buscas, dataSet.FieldByName('grupo_prod').AsInteger,
        dataSet.FieldByName('cod_prod').AsString, false);
//      GravaLogConfirmacao(statusRegistro, 'PRO009', true);

      if (vDadosIni.vEmp.vUsarCodigoSequencialProduto = 'S') and
        (FEstadoCodSeq = enInserError) and (Trim(vAntigoCodigo) <> '') then
        Application.MessageBox(pchar('O código do produto gravado não foi o mesmo que foi mostrado inicialmente' + #13 +
          'Entre no cadastro novamente e confira o numero de fabricante'), 'Atenção', 0 + 64);

      if Replicar then
      begin

        vDadosIni.abreStatusProcessamento('', 'Replicando dados do produto');

        if not RepliProdutos.ReplicaProdutos(Self, statusRegistro) then
          //seff aqui é o dataset de produtos
        begin
//          RollBackTransacao;
          if RepliProdutos.teveReplicacao then
          begin
            if (statusRegistro = 'E') and (RepliProdutos.incluirNaEdicao = 'S') then
            begin
              GravaLogConfirmacao(statusRegistro, 'PRO009', false);
              Application.MessageBox('Erro ao replicar dados do produto para as outras empresas' +
                chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
                MB_ICONERROR + MB_DEFBUTTON1);
            end
            else if statusRegistro = 'I' then
            begin
              GravaLogConfirmacao(statusRegistro, 'PRO009', false);
              Application.MessageBox('Erro ao replicar dados do produto para as outras empresas' +
                chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
                MB_ICONERROR + MB_DEFBUTTON1);
            end;
          end;
        end
        else if not RepliCodBarras.ReplicaCodBarras(Self, statusRegistro) then
        begin
//          RollBackTransacao;
          if RepliProdutos.teveReplicacao then
          begin
//            GravaLogConfirmacao(statusRegistro, 'PRO009', false);
            Application.MessageBox('Erro ao replicar dados do produto para as outras empresas' +
              chr(13) + 'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK +
              MB_ICONERROR + MB_DEFBUTTON1);
          end;
        end
        else
