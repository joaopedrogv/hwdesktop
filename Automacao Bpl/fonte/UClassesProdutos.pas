function TItModeloEtiTermica.post: boolean;
begin
  try
    try
      result := true;
      if not (dataSet.State in [dsEdit, dsinsert]) then
        exit;

      if (trim(dataSet.FieldByName('INDICECOLUNA').Asstring) = '') then
        raiseExceptionCreate('Coluna de impressão não informada.', 'DBComboBox2');
      if trim(dataSet.FieldByName('PARAMETROS_IMP').Asstring) = '' then
        raiseExceptionCreate('Parâmetros de configuração de impressão do campo da etiqueta não informado.', 'DBEdit7');
      if trim(dataSet.FieldByName('TIPOTEXTOIMPRESSO').Asstring) = '' then
        raiseExceptionCreate('Tipo de texto a ser impresso no campo da etiqueta não informado.',
          'DBComboBox1');
      if (trim(dataSet.FieldByName('TEXTO').Asstring) = '') and
        not ((trim(dataSet.FieldByName('TIPOTEXTOIMPRESSO').Asstring) = 'BARCODE') or
        (trim(dataSet.FieldByName('TIPOTEXTOIMPRESSO').Asstring) = 'IMAGEM')) then
        raiseExceptionCreate('Texto fixo ou nome do campo do banco de dados para texto variável ou calculado não informado.', 'DBEdit9');
      if trim(dataSet.FieldByName('TIPOTEXTOIMPRESSO').Asstring) = 'BARCODE' then
      begin
        dataSet.FieldByName('TEXTO').AsVariant := null;
        dataSet.FieldByName('NUMCARACTERES').AsInteger := 0;
      end;
      if dataSet.FieldByName('NUMCARACTERES').IsNull then
        dataSet.FieldByName('NUMCARACTERES').AsInteger := 0;
      if trim(dataSet.FieldByName('TIPOTEXTOIMPRESSO').Asstring) <> 'IMAGEM' then
        dataSet.FieldByName('CAMPOIMAGEM').AsVariant := null;
      if not FMascararPreco then
        dataSet.FieldByName('MASCARARPRECO').AsString := 'N'
      else
        dataSet.FieldByName('MASCARARPRECO').AsString := 'S';

      result := inherited post;
      if dataSet.ChangeCount = 0 then
      begin
        result := true;
        cancel;
        exit;
      end;

      if Result then
        result := Apply;
      if Result then
        result := CommitaTransacao;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
    if Result then
      vDadosIni.GravaAuditoria('PRO210', 'TRANSAÇÃO CONFIRMADA', 'SUCESSO', 'ITMODELOETITERMICA',
        '', buscas)
    else
      vDadosIni.GravaAuditoria('PRO210', 'TRANSAÇÃO NAO CONFIRMADA', 'FALHA',
        'ITMODELOETITERMICA',
        '', buscas);
  end;
end;

