function TModeloEtiTermica.delete: boolean;
var
  codigo: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;
  codigo := dataSet.FieldByName('CODIGO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 0 then
  begin
    if not vDadosIni.PesqPros('PRO202', 'DELETAR REGISTRO', '', 'MODELOETITERMICA',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      exit;
    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
    begin
      result := inherited Delete;
      if Result then
        result := Apply;
      if result then
        result := CommitaTransacao;
      if Result then
      begin
        vDadosIni.GravaAuditoria('PRO202', 'EXCLUIR', 'SUCESSO', 'MODELOETITERMICA', codigo,
          buscas);
        Refresh;
      end
      else
        vDadosIni.GravaAuditoria('PRO202', 'EXCLUIR', 'FALHA', 'MODELOETITERMICA', codigo, buscas);
    end;
  end
  else
    result := _EnviarRegistroLixeira;
end;

