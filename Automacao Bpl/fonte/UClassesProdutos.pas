function TKitsProdutos.RestaurarRegistro: boolean;
var
	vCodKit: string;
	vDescKit: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCodKit := trim(dataSet.FieldByName('CODIGO_KIT').AsString);
      vDescKit := trim(dataSet.FieldByName('DESCRICAO_KIT').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCodKit := '';
        vDescKit := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCodKit) <> '') then
      	prepare_loop('CODIGO_KIT = ' + vCodKit)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'KIT' + #13 +
        'Código: ' + vCodKit + #13 +
        'Descrição: ' + vDescKit;

      if (trim(vDescKit) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO115', 'RESTAURAR', '', 'KITS_PROD',
        vDadosIni.IfThen(trim(vCodKit) <> '', vCodKit, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando kit(s) de produto');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando kit(s) de produto(' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update kits_prod set ativo = 1 ' +
          ' where codigo_kit = %d ' +
          ' and cod_empresa = %d ',
          [fint('codigo_kit'), fint('cod_empresa')], buscas);

        if (trim(vCodKit) = '') then
          vDadosIni.GravaAuditoria('PRO115', 'RESTAURAR', '', 'KITS_PROD',
            dataSet.FieldByName('CODIGO_KIT').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO115', 'RESTAURAR', 'SUCESSO', 'KITS_PROD',
        vDadosIni.IfThen(trim(vCodKit) <> '', vCodKit, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO115', 'RESTAURAR', 'FALHA', 'COND_PAG',
        vDadosIni.IfThen(trim(vCodKit) <> '', vCodKit, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

