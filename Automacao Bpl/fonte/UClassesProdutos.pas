function TSubGrupos.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Subgr: string;
  vDesc_Subgr: string;
  I: Integer;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Subgr     := trim(dataSet.FieldByName('CODIGO_SUBGR').AsString);
      vDesc_Subgr    := trim(dataSet.FieldByName('DESCRICAO').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Subgr     := '';
        vDesc_Subgr    := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Subgr) <> '') then
        prepare_loop('CODIGO_SUBGR = ' + vCod_Subgr)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'SUB GRUPO' + #13 +
          'Código: ' + vCod_Subgr + #13 +
          'Descrição: ' + vDesc_Subgr;

        if (trim(vCod_Subgr) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('PRO067', 'EXCLUIR', '', 'SUB_GRUPO',
          vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'SUB GRUPO' + #13 +
          'Código: ' + vCod_Subgr + #13 +
          'Descrição: ' + vDesc_Subgr;

        if (trim(vCod_Subgr) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('PRO068', 'EXCLUIR', '', 'SUB_GRUPO',
           vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo sub grupo(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo sub grupo(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo sub grupo(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo sub grupo(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
//        	if dataset.FieldByName('CODIGO_SUBGR').AsInteger <= 0 then
//          begin
//            Application.MessageBox(PChar('Sub Grupo ' +
//              IntToStr(dataset.FieldByName('CODIGO_SUBGR').AsInteger) + ' - ' +
//              trim(dataset.FieldByName('DESCRICAO').AsString) +
//              ' não pode ser apagada'), 'Atenção', MB_ICONERROR + MB_OK);
//            Exit;
//          end;

        	buscas.Close;
          buscas.SQL.Text := ' select count(*) as qtde from produtos ' +
            ' where sub_g_prod = :sub_g_prod ';
          buscas.ParamByName('sub_g_prod').AsInteger := fint('codigo_subgr');
          buscas.Open;

          if buscas.FieldByName('qtde').AsInteger > 0 then
          begin
            Application.MessageBox('Não é possível excluir subgrupo, pois existem produtos vinculados.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      			exit;
          end;

          if fint('codigo_subgr') = 0 then
          begin
          	SqlExec(' update sub_grupo set ativo = 99 ' +
            ' where codigo_subgr = %d ',
            [fint('codigo_subgr')], buscas);
          end
          else
          begin
            SqlExec(' delete from sub_grupo ' +
              ' where codigo_subgr = %d ',
              [fint('codigo_subgr')], buscas);
          end;

          if (trim(vCod_Subgr) = '') then
            vDadosIni.GravaAuditoria('PRO067', 'EXCLUIR', '', 'SUB_GRUPO',
              dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas);
        end
        else
        begin
          SqlExec(' update sub_grupo set ativo = 0 ' +
            ' where codigo_subgr = %d ',
            [fint('codigo_subgr')], buscas);

          if (trim(vCod_Subgr) = '') then
            vDadosIni.GravaAuditoria('PRO068', 'EXCLUIR', '', 'SUB_GRUPO',
              dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

		Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO067', 'PRO068'),
        'EXCLUIR', 'SUCESSO', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'PRO067', 'PRO068'),
        'EXCLUIR', 'FALHA', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

