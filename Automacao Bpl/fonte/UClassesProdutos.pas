  montaSelect('select * from nbm where cod_ncm = ''0''');
end;

function TNBM.definirAliqCreditoCOFINS(pAliq: Double): boolean;
var
  vUpdateProdutos: Boolean;
begin
  vUpdateProdutos := False;
  if (fCodEmpresaRepInterna <> '') and (pos('|ALIQ_CRED_COFINS|', vListaCamposRep.Text) > 0) then
    vUpdateProdutos := Application.MessageBox('Alterar "Aliq COFINS Diferenciada Entrada" nas mercadorias com base neste(s) NCM(s)?',
      'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDYES;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if (vUpdateProdutos) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'update produtos set rep_int_active = 1, ALIQ_CRED_COFINS = :ALIQ_CRED_COFINS ' +
        ' where NBM = ' + QuotedStr(dataSet.FieldByName('cod_ncm').AsString) +
        ' and coalesce(ALIQ_CRED_COFINS,-987) <> :ALIQ_CRED_COFINSW' +
        ' and cod_empresa in ' + fCodEmpresaRepInterna;
      if pAliq <= 0 then
        buscas.ParamByName('ALIQ_CRED_COFINS').Value := Null
      else
        buscas.ParamByName('ALIQ_CRED_COFINS').AsFloat := pAliq;
      buscas.ParamByName('ALIQ_CRED_COFINSW').AsFloat := pAliq;
      buscas.ExecSQL;
    end;
    dataSet.Edit;
    if pAliq <= 0 then
      dataSet.FieldByName('ALIQ_CRED_COFINS').Value := Null
    else
      dataSet.FieldByName('ALIQ_CRED_COFINS').AsFloat := pAliq;
    dataSet.Post;
    dataSet.Next;
  end;
  if (DataSet.ChangeCount = 0) and (vUpdateProdutos) then
    CommitaTransacao
  else if Apply then
    CommitaTransacao
  else
  begin
    RollBackTransacao;
  end;
end;

