function TRegiao._abreGruposSubgruposMarcas(pValor: string): Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select t.* from tipo_preco as t where tipo = ''P''';
  buscas.Open;
end;

function TRegiao._abreRegiao(pValor: string): Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := ' select t.* from tipo_preco as t ' +
  	' where tipo = ''T'' ' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (pValor = 'SETOR') then
    Result := montaSelect('select ''SETOR'' TIPO, st.cod_setor as CODIGO, st.setor as DESCRICAO from setor st ' +
      ' where st.ativo = 1 ' +
      ' and st.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by st.setor ')
  else if (pValor = 'CIDADE') then
    Result := montaSelect(' select ''CIDADE'' TIPO, cd.cod_cidade as CODIGO, cd.nome_cidade as DESCRICAO from cidades cd ' +
      ' where cd.ativo = 1 ' +
      ' order by cd.nome_cidade ')
  else if (pValor = 'LOCALIDADE') then
    Result := montaSelect(' select ''LOCALIDADE'' TIPO, l.cod_localidade as CODIGO, l.localidade as DESCRICAO from localidade l ' +
      ' where l.ativo = 1 ' +
      ' and l.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by l.localidade ')
  else if (pValor = 'AVULSO') then
    Result := montaSelect(' select ''AVULSO'' TIPO, p.cod_promocao as CODIGO, p.descr_promocao as DESCRICAO from promocao p ' +
      ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa ' +
      ' where t.tipo = ''T'' ' +
      ' and p.cod_promocao > 0 ' +
      ' and p.ativo = 1 ' +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by p.descr_promocao ')
  else
    Result := montaSelect('select ''LOCALIDADE'' TIPO, l.cod_localidade as CODIGO, l.localidade as DESCRICAO from localidade l ' +
      ' where l.cod_localidade = 0 ' +
      ' and l.ativo = 1 ' +
      ' and l.cod_empresa = 0 ');
end;

