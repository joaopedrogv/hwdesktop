function TPromocaoProduto.DeleteTodasPrecoDiferenciadoProduto: boolean;
var
	vTipo: string;
  buscas2: TIBQuery;
  I: Integer;
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  if not vDadosIni.PesqPros('PRO256', 'EXCLUIR', '', 'PROMOCAO_PRODUTO',
    dataSet.FieldByName('COD_PROMOCAO').AsString, buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir todos preços diferenciados para este produto?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
    Exit;

  try
    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := buscas.Database;
  	buscas2.Transaction := buscas.Transaction;

    vDadosIni.verificarReplicacaoInterna(buscas2, true);

    buscas2.Close;
    buscas2.SQL.Text := ' SELECT COD_TPPRECO FROM TIPO_PRECO ' +
      ' WHERE COD_EMPRESA = :COD_EMPRESA ' +
      ' AND TIPO = ''T'' ';
    buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas2.Open;
    buscas2.FetchAll;

    buscas2.First;
    while not buscas2.Eof do
    begin
    	for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
      begin
        buscas.Close;
        buscas.SQL.Text := 'DELETE FROM PROMOCAO_PRODUTO ' +
          ' WHERE COD_TPPRECO = :COD_TPPRECO ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ' +
          ' AND GRUPO_PROD = :GRUPO_PROD ' +
          ' AND COD_PROD = :COD_PROD; ';
        buscas.ParamByName('COD_TPPRECO').AsInteger := buscas2.FieldByName('COD_TPPRECO').AsInteger;
        buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
        buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);
        buscas.ExecSQL;
      end;

      vTipo := '';
      if buscas2.FieldByName('COD_TPPRECO').AsInteger = 2 then
        vTipo := 'LOCALIDADE: TODAS'
      else if buscas2.FieldByName('COD_TPPRECO').AsInteger = 3 then
        vTipo := 'SETOR: TODOS'
      else if buscas2.FieldByName('COD_TPPRECO').AsInteger = 4 then
        vTipo := 'CIDADE: TODAS'
      else if buscas2.FieldByName('COD_TPPRECO').AsInteger = 5 then
        vTipo := 'AVULSO: TODAS';

      vDadosIni.GravaAuditoria('PRO256', 'EXCLUIR',
        trim(dataSet.FieldByName('GRUPO_PROD').AsString) + '-' +
        trim(dataSet.FieldByName('COD_PROD').AsString) + ' - ' +
        vTipo,
        'PROMOCAO_PRODUTO',
        '', buscas);

      buscas2.Next;
    end;
    
    if buscas.Transaction.InTransaction then
	    buscas.Transaction.Commit;

    _abrePrecoProdutos(dataSet.FieldByName('GRUPO_PROD').AsString, dataSet.FieldByName('COD_PROD').AsString);

    vDadosIni.GravaAuditoria('PRO256', 'EXCLUIR', 'SUCESSO', 'PROMOCAO_PRODUTO', vCodFormula, buscas);

    Result := True;

  except on E: Exception do
    begin
      buscas.Transaction.Rollback;
      vDadosIni.GravaAuditoria('PRO256', 'EXCLUIR', 'FALHA', 'PROMOCAO_PRODUTO', vCodFormula, buscas);
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

