      buscas.Close;
      buscas.SQL.Text := ' select pg.grupo_prod, pg.cod_prod, pg.cod_empresa, pg.cod_grade from produtos_ec_grade pg ' +
        ' where pg.grupo_prod = :grupo_prod and pg.cod_prod = :cod_prod and pg.cod_empresa = :cod_empresa ';
      buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
      buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
        vLista.Add(buscas.FieldByName('cod_grade').AsString);

        buscas.Next;
      end;

      buscas.Close;
      buscas.SQL.Text := ' delete from produtos_ec_grade ' +
      	' where grupo_prod = :grupo_prod and cod_prod = :cod_prod and cod_empresa = :cod_empresa ';
      buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
      buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;

      for I := 0 to vLista.Count - 1 do
      begin
        buscas.Close;
        buscas.SQL.Text := ' insert into produtos_ec_grade (grupo_prod, cod_prod, cod_grade, cod_empresa) ' +
          ' values (:grupo_prod, :cod_prod, :cod_grade, :cod_empresa) ';
        buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
        buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
        buscas.ParamByName('cod_grade').AsInteger := StrToInt(vLista[i]);
        buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ExecSQL;
      end;

      buscas2.Next;
    end;
    buscas2.First;

  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

