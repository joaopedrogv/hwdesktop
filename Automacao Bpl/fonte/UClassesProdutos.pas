end;

function TCEST.post: Boolean;
var
  acao: string;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO294', 'SALVAR', 'CST/NCM ' + dataSet.FieldByName('CEST').AsString + '/' + dataSet.FieldByName('NCM').AsString, 'CEST', '', buscas, False) then
    Exit;

  try

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    dataSet.FieldByName('CEST').AsString := vDadosIni.apenasNumeros(Trim(dataSet.FieldByName('CEST').AsString));
    dataSet.FieldByName('NCM').AsString := vDadosIni.apenasNumeros(Trim(dataSet.FieldByName('NCM').AsString));

    if Trim(dataSet.FieldByName('CEST').AsString) = '' then
      raiseExceptionCreate('Código CEST não informado', 'DBEdit1');

    if Length(Trim(dataSet.FieldByName('CEST').AsString)) <> 7 then
      raiseExceptionCreate('Campo CEST com preenchimento inválido. Deve conter 7 dígitos', 'DBEdit1');

    if Trim(dataSet.FieldByName('NCM').AsString) = '' then
      raiseExceptionCreate('Código NCM não informado', 'DBEdit2');

    if Trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição do CEST não informada', 'DBMemo1');

    if Length(Trim(dataSet.FieldByName('NCM').AsString)) < 2 then
      raiseExceptionCreate('Campo NCM com preenchimento inválido. Deve conter 2 ou mais dígitos', 'DBEdit1');

    buscas.Close;
    buscas.SQL.Text := 'select cest from cest' +
      ' where cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString) +
      ' and ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString) +
      ' and seqid_ws <> ' + IntToStr(FSEQID_WS);
    buscas.Open;
    if Trim(buscas.FieldByName('cest').AsString) = Trim(dataSet.FieldByName('cest').AsString) then
      raiseExceptionCreate('Registro já existe no banco de dados para a combinação: "CEST e NCM"', 'DBEdit1');

    if Length(Trim(dataSet.FieldByName('NCM').AsString)) = 8 then
      if Application.MessageBox('Deseja atualizar o código CEST no cadastro de NCM e Produtos?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update nbm set cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString) +
          ' where cod_ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString);
        buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := 'update produtos set rep_int_active = 1, cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString) +
          ' where nbm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
      end;

    Result := inherited Post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := TRUE;
      Exit;
    end;

    Result := Apply;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO294', acao, 'SUCESSO', 'CEST', dataSet.FieldByName('CEST').AsString, buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO294', acao, 'FALHA', 'CEST', dataSet.FieldByName('CEST').AsString, buscas);
    end;

    dataSet.Refresh;

  except on E: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;


