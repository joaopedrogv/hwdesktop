      ' inner join tipo_preco tp on tp.cod_tppreco = p.cod_tppreco and tp.cod_empresa = p.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = p.grupo_prod and pr.cod_prod = p.cod_prod and pr.cod_empresa = p.cod_empresa ' +
      ' left join localidade l on l.cod_localidade = p.cod_localidade and l.cod_empresa = p.cod_empresa ' +
      ' left join setor st on st.cod_setor = p.cod_setor and st.cod_empresa = p.cod_empresa ' +
