      begin
        if vDadosIni.PesqPros('PRO131', 'RESTAURAR', '', 'PERFIL_PRODUTOS',
          dataSet.FieldByName('COD_PERFIL').AsString, buscas, true) then
          //        if vDadosIni.PesqPros('PRO131', dataSet.FieldByName('COD_PERFIL').AsString, buscas, false) then
        begin
          if inherited Edit then
          begin
            dataSet.FieldByName('ATIVO').asinteger := 1;
            if inherited Post then
            begin
              if Apply then
              begin
                if CommitaTransacao then
                begin
                  result := true;
                  vDadosIni.GravaAuditoria('PRO131', 'RESTAURAÇÃO CONFIRMADA', 'SUCESSO',
                    'PERFIL_PRODUTOS',
                    dataSet.FieldByName('COD_PERFIL').AsString, buscas)
                    //                  vDadosIni.GravaAuditoria('PRO131', dataSet.FieldByName('COD_PERFIL').AsString, buscas);
                end
                else
                begin
                  Application.MessageBox('Não foi possível restaurar o registro.', 'Aviso', MB_OK
                    +
                    MB_ICONERROR + MB_DEFBUTTON1);
                end;
              end
              else
              begin
                RollBackTransacao;
                Application.MessageBox('Não foi possível restaurar o registro.', 'Aviso', MB_OK +
                  MB_ICONERROR + MB_DEFBUTTON1)
              end;
            end
            else
            begin
              RollBackTransacao;
              Application.MessageBox('Não foi possível restaurar o registro.', 'Aviso', MB_OK +
                MB_ICONERROR + MB_DEFBUTTON1)
            end;
          end
          else
          begin
            RollBackTransacao;
            Application.MessageBox('Não foi possível restaurar o registro.', 'Aviso', MB_OK +
              MB_ICONERROR + MB_DEFBUTTON1)
          end;
        end;
      end
      else
        exit;
      Refresh;
    end
    else
      Application.MessageBox('Registro já está ativo' + chr(13) +
        'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION +
        MB_DEFBUTTON1);
  end
  else
    Application.MessageBox('Não há registros a serem restaurados.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
end;

function TPerfilProduto.RetornaMarca: boolean;
begin
  result := true;
  buscas.close;
  buscas.sql.text := 'select DESCRICAO_MARCA from Marca_prod where cod_marca=' +
    inttostr(dataSet.FieldByName('COD_MARCA').AsInteger);
  buscas.open;
  if Buscas.isempty then
  begin
    if dataSet.FieldByName('COD_MARCA').IsNull then
      dataSet.FieldByName('MARCA_P').AsVariant := null
    else
    begin
      Application.MessageBox('Marca não encontrada.', 'Informação', MB_OK + MB_ICONINFORMATION +
        MB_DEFBUTTON1);
      result := false;
    end;
  end
  else
    dataSet.FieldByName('MARCA_P').AsString := Buscas.fieldbyname('DESCRICAO_MARCA').asstring;
  buscas.close;
end;

function TPerfilProduto.StatusLixeira: boolean;
begin
  result := ExecutaComandosSql('SELECT * FROM Perfil_Produtos WHERE cod_empresa = ' +
    vDadosIni.codEmpresa + ' and ativo<>1');
end;

function TPerfilProduto.TipoProdInd(Tipo: string): boolean;
begin
  if not ((copy(Tipo, 0, 1) = 'P') or (copy(Tipo, 0, 1) = 'M') or
    (copy(Tipo, 0, 1) = 'E') or (copy(Tipo, 0, 1) = 'O')) and (trim(Tipo) <> '') then
  begin
    Application.MessageBox('Selecione ''P'' , ''M'' , ''E'' ou ''O''.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    result := false;
  end
  else
  begin
    if trim(Tipo) <> '' then
      dataSet.FieldByName('TIP_PROD_IND').AsString := copy(Tipo, 0, 1);
    result := true;
  end;
end;

function TPerfilProduto.ValidaNBM: boolean;
begin
  result := true;
  buscas.close;
  buscas.sql.text := 'select * from NBM where cod_ncm=' +
    quotedstr(dataSet.FieldByName('NBM').AsString);
  buscas.open;
  if Buscas.isempty then
  begin
    Application.MessageBox('NCM/SH não encontrado.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    result := false;
  end
  else
    dataSet.FieldByName('NBM').AsString := Buscas.fieldbyname('COD_NCM').asstring;
  buscas.close;
end;

