function TSubGrupos.RestaurarRegistro: boolean;
var
	vCod_Subgr: string;
	vDesc_Subgr: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCod_Subgr  := trim(dataSet.FieldByName('CODIGO_SUBGR').AsString);
      vDesc_Subgr := trim(dataSet.FieldByName('DESCRICAO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCod_Subgr  := '';
        vDesc_Subgr := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCod_Subgr) <> '') then
      	prepare_loop('CODIGO_SUBGR = ' + vCod_Subgr)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'SUB GRUPO' + #13 +
        'Código: ' + vCod_Subgr + #13 +
        'Descrição: ' + vDesc_Subgr;

      if (trim(vCod_Subgr) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO069', 'RESTAURAR', '', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando sub grupo(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando sub grupo(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update sub_grupo set ativo = 1 ' +
          ' where codigo_subgr = %d ',
          [fint('codigo_subgr')], buscas);

        if (trim(vCod_Subgr) = '') then
          vDadosIni.GravaAuditoria('PRO069', 'RESTAURAR', '', 'SUB_GRUPO',
            dataSet.FieldByName('CODIGO_SUBGR').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('PRO069', 'RESTAURAR', 'SUCESSO', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('PRO069', 'RESTAURAR', 'FALHA', 'SUB_GRUPO',
        vDadosIni.IfThen(trim(vCod_Subgr) <> '', vCod_Subgr, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

