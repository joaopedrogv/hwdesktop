    montaSelect('select * from PRODUTOS_TRIB_PF' +
      ' where COD_TRIB_PF  = 0 and COD_EMPRESA = 0');

  if inherited insert then
  begin
    Result := True;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('CONTRIBUINTE').AsString := 'Sim';
    dataSet.FieldByName('PESSOA').AsString := 'PJ';
    dataSet.FieldByName('USAR_MVA_ANEXOXV').AsString := 'N';

    buscas.Close;
    buscas.SQL.Text := 'select padrao_consumidor_final from empresa' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if Trim(buscas.FieldByName('padrao_consumidor_final').AsString) = 'N' then
      dataSet.FieldByName('CONSUMIDOR_FINAL').AsString := 'Nao'
    else if Trim(buscas.FieldByName('padrao_consumidor_final').AsString) = 'S' then
      dataSet.FieldByName('CONSUMIDOR_FINAL').AsString := 'Nao'
    else
      dataSet.FieldByName('CONSUMIDOR_FINAL').AsString := 'Ambos';

    dataSet.FieldByName('REDUCAO_CAD_PRODUTO').AsString := 'N';
  end;
end;

function TProdutosPerfilTribAdicional.post: Boolean;
var
  acao: string;
  Alist: TStrings;
  Aoperacao: string;
begin
  Result := False;

  if not vDadosIni.PesqPros('PRO277', 'SALVAR', '', 'PRODUTOS_TRIB_PF', dataSet.FieldByName('COD_TRIB_PF').AsString, buscas, False) then
    Exit;

  try

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if Trim(dataSet.FieldByName('DESCRICAO_PF').AsString) = '' then
      raiseExceptionCreate('Descrição não informada', 'DBEdit2');

    if Trim(dataSet.FieldByName('SIGLA_UF').AsString) = '' then
      raiseExceptionCreate('Estados não selecionados', 'ListBox1');

    Alist := vDadosIni.NewStringList(True, f_str('sigla_uf'), '|');
    try
      if Alist.IndexOf('**') >= 0 then
      begin
        Alist.Delete(Alist.IndexOf('**'));
        Aoperacao := IfThen(f_str('CODIGO_NOP')[1] = '5', 'interna', 'interestadual');

      end;

      if Alist.IndexOf(vDadosIni.vEmp.vSiglaUF) >= 0 then
      begin
        Aoperacao := 'interna';
        if Alist.Count > 1 then
          raiseExceptionCreate('Configuração inválida. Operações internas não podem ficar junto das interestaduais', 'ListBox1');
      end
      else if Alist.Count > 0 then
        Aoperacao := 'interestadual';
    finally
      FreeAndNil(Alist);
    end;

    //if pos(vDadosIni.vEmp.vSiglaUF + '|', trim(dataSet.FieldByName('SIGLA_UF').AsString)) > 0  then
      //raiseExceptionCreate('Uma da(s) sigla(s) informada(s) igual a da empresa. Configuração válida apenas para operações interestaduais', 'ListBox1');

    if Trim(dataSet.FieldByName('CST_ICMS').AsString) = '' then
      raiseExceptionCreate('CST de ICMS não informado', 'DBComboBox18');
      
    if trim(dataSet.FieldByName('REDUCAO_CAD_PRODUTO').AsString) <> 'S' then
      dataSet.FieldByName('REDUCAO_CAD_PRODUTO').AsString := 'N';

    if dataSet.FieldByName('REDUCAO_CAD_PRODUTO').AsString = 'S' then
      dataSet.FieldByName('PERC_RED_PROD').AsFloat := 0;

    dataSet.FieldByName('PERC_RED_PROD').AsFloat := vDadosIni.StrToFloatFormat(
      dataSet.FieldByName('PERC_RED_PROD').AsFloat, 2);

    dataSet.FieldByName('CODIGO_NOP').AsFloat := Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat);

    if dataSet.FieldByName('CODIGO_NOP').AsFloat <= 0 then
      raiseExceptionCreate('CFOP não informado', 'DBEdit4');

    if not ExecutaComandosSql('select codigo_nop from nat_op where codigo_nop = ' +
      IntToStr(Trunc(dataset.FieldByName('CODIGO_NOP').AsFloat))) then
      raiseExceptionCreate('Natureza de operação informada não existe no cadastro', 'DBEdit4');

    if Aoperacao = 'interna' then
      if (f_float('CODIGO_NOP') < 5000) or (f_float('CODIGO_NOP') > 5999) then
        raiseExceptionCreate('CFOP deve iniciar em 5', 'DBEdit4');

    if Aoperacao = 'interestadual' then
      if (f_float('CODIGO_NOP') < 6000) or (f_float('CODIGO_NOP') > 7999) then
      raiseExceptionCreate('CFOP deve iniciar em 6 ou 7', 'DBEdit4');

    if not validarRegrasCFOP_CST then
      Exit;

    if dataSet.FieldByName('ALIQ_INTER').AsFloat < 0 then
      raiseExceptionCreate('Aliquota Interestadual inválida ', 'DBEdit5');

    if dataSet.FieldByName('ALIQ_INTRA').AsFloat < 0 then
      raiseExceptionCreate('Aliquota Intraestadual inválida ', 'DBEdit7');

    if dataSet.FieldByName('MVA').AsFloat < 0 then
      raiseExceptionCreate('MVA inválido', 'DBEdit8');

    if dataSet.FieldByName('PERC_RED_PROD').AsFloat < 0 then
      raiseExceptionCreate('Percentual de Redução do ICMS inválido', 'DBEdit6');

    if dataSet.State = dsInsert then
      dataSet.FieldByName('COD_TRIB_PF').AsInteger := Gencodigo('PRODUTOS_TRIB_PF', dtmProdutos.SpIncCodigo,vDadosIni.codEmpresa);

    Result := inherited Post;
    Result := Apply;

    if Result then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('PRO277', acao, 'SUCESSO', 'PRODUTOS_TRIB_PF', dataSet.FieldByName('COD_TRIB_PF').AsString, buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO277', acao, 'FALHA', 'PRODUTOS_TRIB_PF', dataSet.FieldByName('COD_TRIB_PF').AsString, buscas);
    end;

    dataSet.Refresh;

  except on E: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TProdutosPerfilTribAdicional.validarRegrasCFOP_CST(pCST: string = '';
  pCFOP: Integer = 0; pAliq: Extended = 0): boolean;
var
  buscas2: TIBQuery;
  vCST: string;
  vCFOP: Integer;
  vAliq: Extended;
begin
  buscas2 := TIBQuery(dtmProdutos.qrBuscasCB);
  Result := False;
  if pCST <> '' then
    vCST := pCST
  else if Trim(dataSet.FieldByName('cst_icms').AsString) <> '' then
    vCST := Trim(dataSet.FieldByName('cst_icms').AsString)
  else
    Exit;

  if pCFOP > 0 then
    vCFOP := pCFOP
  else if dataSet.FieldByName('codigo_nop').AsFloat > 0 then
    vCFOP := Trunc(dataSet.FieldByName('codigo_nop').AsFloat)
  else
    Exit;

  vAliq := 0;
  if pAliq > 0 then
    vAliq := pAliq
  else if dataSet.FieldByName('aliq_inter').AsFloat > 0 then
    vAliq := dataSet.FieldByName('aliq_inter').AsFloat;

  try
    if (vDadosIni.vEmp.vUsarRegraCFOPCSTSaida = 'S') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select * from CFOP_CST_ENTRADA where cfop = :cfop and cst = ' +
        QuotedStr(Trim(vCST)) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.ParamByName('cfop').AsFloat := vCFOP;
      buscas.Open;

      if buscas.IsEmpty then
        raiseExceptionCreate('Combinação de CFOP com CST não encontrada' + #13 +
          'Por favor entre no cadastro de CFOP e verifique as combinações', '');

      vDadosIni.vInibeMensPesqPros := 'S';
      if vDadosIni.PesqPros('PRO177', 'VALIDAR', '', 'PRODUTOS_TRIB_PF',
        '', buscas2, False) then
      begin

        if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'S' then
        begin
          if vAliq <= 0 then
            raiseExceptionCreate('Aliquota de ICMS de preenchimento obrigatório conforme regras estabelecidas', '');
        end
        else if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'N' then
          if vAliq > 0 then
            raiseExceptionCreate('Aliquota de ICMS deve ser preenchida zerada conforme regras estabelecidas', '');
      end;
    end;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Exit;
    end;
  end;

  Result := True;
end;

