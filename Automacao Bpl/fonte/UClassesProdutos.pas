function TProdutosRel._abreRelProdutos(pPrecoVenda, pDiferenciado, pPromocao, pPrecoPorQtde: Boolean; pWhere: string = ''; pIndex: string = ''; pNaoExecutar: Boolean = false): Boolean;
var
  vSqlAdicionalPrecoVenda, vSqlAdicionalTabPromocao, vSqlAdicionalPrecoPorQtde, vInd, vAscDesc: string;
  vIndex: string;
begin
  vInd := '';

  vSql := '';
  vSqlProd := '';
  vSqlPromTab := '';
  vSqlPrecoQtde := '';
  vSqlAdicionalPrecoVenda := '';
  vSqlAdicionalTabPromocao := '';
  vSqlAdicionalPrecoPorQtde := '';

  if (pPrecoVenda) then
  begin
    if trim(pWhere) <> '' then
    begin
      if ((Pos('where', vSqlAdicionalPrecoVenda) > 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalPrecoVenda := vSqlAdicionalPrecoVenda + ' and ' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere))
      else if ((Pos('where', vSqlAdicionalPrecoVenda) = 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalPrecoVenda := 'where' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere));

      if (Pos(' order by', vSqlAdicionalPrecoVenda) >0) then
          vSqlAdicionalPrecoVenda := Copy(vSqlAdicionalPrecoVenda, 0, Pos(' order by', vSqlAdicionalPrecoVenda));
    end;

    vSqlProd := ' select 0 ordem, ' +
      ' grupos.descricao, produtos.grupo_prod, produtos.sub_g_prod, produtos.num_fab_prod, produtos.descr_prod, ' +
    	' produtos.*, null tp, null cod_promocao,  ' +
    	' null tipo, null descr_tipo, null valor_promocao, null porcentagem, null max_desc, ' +
      ' null quant, null valor_venda, ' +
      ' grupos.descricao, sub_grupo.descricao descSub from produtos ' +
      ' left join grupos on produtos.grupo_prod = grupos.codigo_grup ' +
      ' left join sub_grupo on sub_grupo.codigo_subgr = coalesce(produtos.sub_g_prod,0) ' +
      ' left join cod_barra on cod_barra.grupo_prod = produtos.grupo_prod and cod_barra.cod_prod = produtos.cod_prod and cod_barra.cod_empresa = produtos.cod_empresa ' +
      vSqlAdicionalPrecoVenda;

    if (pPrecoPorQtde) then
      vSqlProd := vSqlProd +
        ' and coalesce((select first 1 coalesce(pr.quant, 0) from preco_produtos_qtde pr ' +
        ' 							where pr.grupo_prod = produtos.grupo_prod and pr.cod_prod = produtos.cod_prod ' +
        ' 							and pr.cod_empresa = produtos.cod_empresa), 0) = 0 ';
    if (pDiferenciado) then
      vSqlProd := vSqlProd +
        ' and coalesce((select first 1 case when (coalesce(pp.porcentagem, 0) > 0) then coalesce(pp.porcentagem, 0) else coalesce(pp.valor_promocao, 0) end from promocao_produto pp ' +
        ' 							inner join promocao p on p.cod_promocao = pp.cod_promocao and p.cod_tppreco = pp.cod_tppreco and p.cod_empresa = pp.cod_empresa ' +
        ' 							inner join tipo_preco tp on tp.cod_tppreco = pp.cod_tppreco and tp.cod_empresa = pp.cod_empresa ' +
        ' 							where pp.grupo_prod = produtos.grupo_prod and pp.cod_prod = produtos.cod_prod and pp.cod_empresa = produtos.cod_empresa and p.cod_promocao is not null ' +
        ' 							and (tp.tipo = ''T'' AND p.ativo = 1)), 0) = 0 ';
    if (pPromocao) then
      vSqlProd := vSqlProd +
        ' and coalesce((select first 1 case when (coalesce(pp.porcentagem, 0) > 0) then coalesce(pp.porcentagem, 0) else coalesce(pp.valor_promocao, 0) end from promocao_produto pp ' +
        ' 							inner join promocao p on p.cod_promocao = pp.cod_promocao and p.cod_tppreco = pp.cod_tppreco and p.cod_empresa = pp.cod_empresa ' +
        ' 							inner join tipo_preco tp on tp.cod_tppreco = pp.cod_tppreco and tp.cod_empresa = pp.cod_empresa ' +
        ' 							where pp.grupo_prod = produtos.grupo_prod and pp.cod_prod = produtos.cod_prod and pp.cod_empresa = produtos.cod_empresa and p.cod_promocao is not null ' +
        ' 							and ((tp.tipo = ''P'' AND p.ativo = 1) ' +
        ' 							and (pp.data_ini <= ' + vDadosIni.FusoSqlDateTime + ' and pp.data_fim >= ' + vDadosIni.FusoSqlDateTime + '))),0 ) = 0 ';

    vSql := vSqlProd;

    if ((pDiferenciado) or (pPromocao) or (pPrecoPorQtde)) then
			vSql := vSql + ' union ';
  end;
  if ((pDiferenciado) or (pPromocao)) then
  begin
    if ((pDiferenciado) and (not pPromocao)) then
      vSqlAdicionalTabPromocao := ' where (tp.tipo = ''T'' and p.ativo = 1) '
    else if ((not pDiferenciado) and (pPromocao)) then
      vSqlAdicionalTabPromocao := ' where ((tp.tipo = ''P'' and p.ativo = 1) ' +
        ' and (pp.data_ini <= ' + vDadosIni.FusoSqlDateTime + ' and pp.data_fim >= ' + vDadosIni.FusoSqlDateTime + ')) '
    else
      vSqlAdicionalTabPromocao := ' where ( (tp.tipo = ''T'' and p.ativo = 1) ' +
      	' or ((tp.tipo = ''P'' and p.ativo = 1) ' +
        ' and (pp.data_ini <= ' + vDadosIni.FusoSqlDateTime + ' and pp.data_fim >= ' + vDadosIni.FusoSqlDateTime + ')) ) ';

    if trim(pWhere) <> '' then
    begin
      if ((Pos('where', vSqlAdicionalTabPromocao) > 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalTabPromocao := vSqlAdicionalTabPromocao + ' and ' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere))
      else if ((Pos('where', vSqlAdicionalTabPromocao) = 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalTabPromocao := 'where' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere));

      if (Pos(' order by', vSqlAdicionalTabPromocao) >0) then
          vSqlAdicionalTabPromocao := Copy(vSqlAdicionalTabPromocao, 0, Pos(' order by', vSqlAdicionalTabPromocao));
    end;

     vSqlPromTab := ' select case when (tp.tipo = ''P'') then 1 else 2 end ordem, ' +
     	' grupos.descricao, produtos.grupo_prod, produtos.sub_g_prod, produtos.num_fab_prod, produtos.descr_prod, ' +
      ' produtos.*, tp.tipo tp, p.cod_promocao, ' +
      ' case when (tp.tipo = ''P'') then ''PROMOCAO'' else tp.descr_tipo end tipo, ' +
      ' case when coalesce(l.cod_localidade, 0) > 0 then l.localidade ' +
      ' when coalesce(st.cod_setor, 0) > 0 then st.setor ' +
      ' when coalesce(cd.cod_cidade, 0) > 0 then cd.nome_cidade ' +
      ' else p.descr_promocao end descr_tipo, ' +
      ' case when pp.porcentagem <= 0 then pp.valor_promocao else (produtos.prec_tab_prod - (produtos.prec_tab_prod / 100) * pp.porcentagem) end valor_promocao, pp.porcentagem, pp.max_desc, ' +
      ' (select count(*) from produtos where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1) quant, ' +
      ' case when (p.cod_promocao is null) then produtos.prec_tab_prod ' +
      ' when ((p.cod_promocao is not null) and (pp.valor_promocao > 0)) then pp.valor_promocao ' +
      ' when ((p.cod_promocao is not null) and (pp.porcentagem > 0)) then ' +
      ' (produtos.prec_tab_prod - (produtos.prec_tab_prod / 100) * pp.porcentagem) ' +
      ' end valor_venda, grupos.descricao, sub_grupo.descricao descSub  from produtos ' +
      ' inner join promocao_produto pp on pp.grupo_prod = produtos.grupo_prod and pp.cod_prod = produtos.cod_prod and pp.cod_empresa = produtos.cod_empresa ' +
      ' inner join promocao p on p.cod_promocao = pp.cod_promocao and p.cod_tppreco = pp.cod_tppreco and p.cod_empresa = pp.cod_empresa ' +
      ' inner join tipo_preco tp on tp.cod_tppreco = pp.cod_tppreco and tp.cod_empresa = pp.cod_empresa ' +
      ' left join localidade l on l.cod_localidade = pp.cod_localidade and l.cod_empresa = pp.cod_empresa ' +
      ' left join setor st on st.cod_setor = pp.cod_setor and st.cod_empresa = pp.cod_empresa ' +
      ' left join cidades cd on cd.cod_cidade = pp.cod_cidade ' +
      ' left join grupos on produtos.grupo_prod = grupos.codigo_grup ' +
      ' left join sub_grupo on sub_grupo.codigo_subgr = coalesce(produtos.sub_g_prod,0) ' +
      ' left join cod_barra on cod_barra.grupo_prod = produtos.grupo_prod and cod_barra.cod_prod = produtos.cod_prod and cod_barra.cod_empresa = produtos.cod_empresa ' +
      vSqlAdicionalTabPromocao;

    vSql := vSql + vSqlPromTab;  

    if (pPrecoPorQtde) then
	    vSql := vSql + ' union ';
  end;

  if (pPrecoPorQtde) then
  begin
    vSqlAdicionalPrecoPorQtde := ' where (pq.sigla is not null) ';

  	if trim(pWhere) <> '' then
    begin
      if ((Pos('where', vSqlAdicionalPrecoPorQtde) > 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalPrecoPorQtde := vSqlAdicionalPrecoPorQtde + ' and ' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere))
      else if ((Pos('where', vSqlAdicionalPrecoPorQtde) = 0) and (Pos('where', pWhere) > 0)) then
        vSqlAdicionalPrecoPorQtde := 'where' + Copy(pWhere, Pos('where', pWhere) + 5, Length(pWhere));

      if (Pos(' order by', vSqlAdicionalPrecoPorQtde) >0) then
        vSqlAdicionalPrecoPorQtde := Copy(vSqlAdicionalPrecoPorQtde, 0, Pos(' order by', vSqlAdicionalPrecoPorQtde));
    end;

  	vSqlPrecoQtde :=	' select 3 ordem, ' +
    	' grupos.descricao, produtos.grupo_prod, produtos.sub_g_prod, produtos.num_fab_prod, produtos.descr_prod, ' +
    	' produtos.*, ''Q'' tp, 0 cod_promocao, ' +
      ' ''QUANTIDADE'' tipo, ' +
      ' (''QUANTIDADE MAIOR OU IGUAL ''||  replace(cast(pq.quant as numeric(8,3)), ''.'', '','')) descr_tipo, ' +
      ' pq.preco_venda valor_promocao, cast(0 as float)  porcentagem, cast(0 as float)  max_desc, 0 quant, ' +
      ' pq.preco_venda valor_venda, grupos.descricao, sub_grupo.descricao descSub from produtos ' +
      ' inner join preco_produtos_qtde pq on pq.grupo_prod = produtos.grupo_prod and pq.cod_prod = produtos.cod_prod and pq.cod_empresa = produtos.cod_empresa ' +
      ' left join grupos on produtos.grupo_prod = grupos.codigo_grup ' +
      ' left join sub_grupo on sub_grupo.codigo_subgr = coalesce(produtos.sub_g_prod,0) ' +
      ' left join cod_barra on cod_barra.grupo_prod = produtos.grupo_prod and cod_barra.cod_prod = produtos.cod_prod and cod_barra.cod_empresa = produtos.cod_empresa  ' +
      vSqlAdicionalPrecoPorQtde;

     vSql := vSql + vSqlPrecoQtde;
  end;

  if pNaoExecutar then
  	exit;

  Result := montaSelect(vSql);

  if ((pIndex <> '') and ((pos('IDX$A', pIndex) = 0) and (pos('IDX$D', pIndex) = 0))) then
  begin
    dataSet.IndexDefs.Clear;
    dataSet.IndexDefs.Add(pIndex, pIndex, []);
    vInd := 'S';
  end;

  if pos('IDX$', pIndex) > 0 then
    dataSet.IndexDefs.Clear;

  while pos('IDX$', pIndex) > 0 do
  begin
    if pos('IDX$D', pIndex) > 0 then
    begin
      pIndex := Copy(pIndex, 6, Length(pIndex));
      dataSet.IndexDefs.Add(pIndex, pIndex, [ixDescending]);
    end;
    if pos('IDX$A', pIndex) > 0 then
    begin
      pIndex := Copy(pIndex, 6, Length(pIndex));
      dataSet.IndexDefs.Add(pIndex, pIndex, []);
    end;

    vInd := 'S';
  end;

  try
    if vInd = 'S' then
      dataSet.IndexName := 'NUM_FAB_PROD';
  except
  end;
end;

