        buscas.SQL.Text := buscas.SQL.Text + ' VALOR_PROMOCAO = :VALOR_PROMOCAO, PORCENTAGEM = :PORCENTAGEM, PROPORCAO_TABELA = 0, ';

      buscas.SQL.Text := buscas.SQL.Text + ' COD_EMPRESA = COD_EMPRESA ';
      buscas.SQL.Text := buscas.SQL.Text + ' where GRUPO_PROD = :GRUPO_PROD ';
      buscas.SQL.Text := buscas.SQL.Text + ' and COD_PROD = :COD_PROD';
      buscas.SQL.Text := buscas.SQL.Text + ' and COD_EMPRESA = ' + vDadosIni.vReplicaoInternaEmpresa[i];

      if ((vDiferenciado) and (vTipoDifPro = 'T')) then
      begin
