function TTipoServ.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

//    if Trim(dataSet.FieldByName('COD_EMPRESA').AsString) = '' then
//      raiseExceptionCreate('Preencha a Empresa do Serviço!', 'DBLookupComboBox4');
            
    if trim(dataSet.FieldByName('DESC_SERVICO').AsString) = '' then
      raiseExceptionCreate('A descrição do tipo de serviço não informado!' + chr(13) +
        'Campo requerido.', 'DBEdit2');

    if acao = 'EDITAR' then
    begin
      if trim(dataSet.FieldByName('DESC_SERVICO').OldValue) <> trim(dataSet.FieldByName('DESC_SERVICO').NewValue) then
        if not SqlOpen('select ativo, DESC_SERVICO from TIPO_SERVICO ' +
                       ' where coalesce(cod_empresa, %d) = %d and DESC_SERVICO = %s',
                       [vDadosIni.cod_empresa, vDadosIni.cod_empresa, fstrq('DESC_SERVICO')]).IsEmpty then
          raiseExceptionCreate('Já existe um serviço cadastrado com este nome!' +
                               Ifthen(buscas.FieldByName('ativo').AsInteger = 0, sLineBreak + 'Serviço está na lixeira'), 'DBEdit2');
    end
    else if ExecutaComandosSql('select DESC_SERVICO from TIPO_SERVICO where DESC_SERVICO = ' +
      quotedstr(dataSet.FieldByName('DESC_SERVICO').AsString)) then
      raiseExceptionCreate('Já existe um serviço cadastrado com este nome!', 'DBEdit2');

    if not existeCFOP(dataSet.FieldByName('CODIGO_NOP').AsFloat) then
      raiseExceptionCreate('CFOP não encontrado no cadastro ou não informado!', 'DBEdit6');

    if (copy(dataset.FieldByName('CODIGO_NOP').AsString, 1, 1) <> '5') then
      raiseExceptionCreate('Natureza de operação deve ser de saída.Iniciando em "5"', 'DBEdit6');

    if dataSet.FieldByName('VALOR_SERVICO').AsFloat <= 0 then
    	raiseExceptionCreate('Valor do serviço deve ser informado e deve ser maior que zero.', 'DBEdit3');

    if trim(dataSet.FieldByName('STIPO').AsString) = '' then
      raiseExceptionCreate('Origem de serviço não informado!', 'DBComboBox3');

    if (trim(dataSet.FieldByName('STIPO').AsString) = 'V')
    	and (dataSet.FieldByName('SEQ_REVISAO').AsInteger = 0) then
      raiseExceptionCreate('Para Revisão Gratuita é necessario informar sequência da Revisão(ex.: 01,02,03,etc)!', 'DBEdit12');

    if (SegmentarPROD_SERV = 'S')	and (dataSet.FieldByName('COD_ESPE_SEG').isnull) then
      raiseExceptionCreate('Espécie de Veículo/Aparelho para segmetação deve ser informado!', 'DBLookupComboBox1');

		//if Trim(dataSet.FieldByName('CTISS').AsString) = '' then
			//raiseExceptionCreate('CTISS não informado!', 'DBEdit13');

    if not fempty('ctribnac') and (Length(fstr('ctribnac')) <> 6) then
      raiseExceptionCreate('Codigo de Tributação Nacional se preenchido precisa ser conter 6 dígitos!')
    else if fempty('ctribnac') then
      dataSet.FieldByName('ctribnac').Value := Null;

    if not fempty('ctribmun') and (Length(fstr('ctribmun')) <> 3) then
      raiseExceptionCreate('Codigo de Tributação do Município se preenchido precisa ser conter 3 dígitos!')
    else if fempty('ctribmun') then
      dataSet.FieldByName('ctribmun').Value := Null;

    if not fempty('cnbs') and (Length(fstr('cnbs')) <> 9) then
      raiseExceptionCreate('Codigo NBS se preenchido precisa ser conter 9 dígitos!')
    else if fempty('cnbs') then
      dataSet.FieldByName('cnbs').Value := Null;

		dataset.FieldByName('cst_cofins').AsString := dataset.FieldByName('cst_pis').AsString;
		dataset.FieldByName('cst_cofins_ent').AsString := dataset.FieldByName('cst_pis_ent').AsString;
		if (Trim(dataset.FieldByName('cst_pis').AsString) <> '') and
			(Trim(dataset.FieldByName('cst_cofins').AsString) <> '') then
    begin
			if not (dataset.FieldByName('cst_pis').AsString[1] in ['0', '4', '9']) then
        raiseExceptionCreate('CST de PIS ou COFINS inválido', 'DBComboBox12');

      if (dataset.FieldByName('cst_pis').AsString[1] = '0') then
        if not (dataset.FieldByName('cst_pis').AsString[2] in ['1', '2', '3', '4', '5', '6', '7', '8', '9']) then
          raiseExceptionCreate('CST de PIS ou COFINS inválido', 'DBComboBox12');

      if (dataset.FieldByName('cst_pis').AsString[1] in ['4', '9']) then
        if dataset.FieldByName('cst_pis').AsString[2] <> '9' then
        	raiseExceptionCreate('CST de PIS ou COFINS inválido','DBComboBox12');

      if (Trim(dataset.FieldByName('cst_pis').AsString) <> Trim(dataset.FieldByName('cst_cofins').AsString)) then
        raiseExceptionCreate('CST de PIS e COFINS devem ser iguais', 'DBComboBox12');
      end;

    if UsarPreVendaOS = 'S' then
      dataSet.FieldByName('ALTCOD').AsString := 'N';

    if not dataSet.FieldByName('COD_EMPRESA').IsNull then
    	dataSet.FieldByName('COD_EMPRESA').Value := Null;

    if not validarCamposPersonalizados then
      Exit;

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_TIPOSERV,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('COD_SERVICO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      buscas.close;
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_SERVICO').AsString;
    end;

    Result := inherited Post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;
      
    try
      vTipoServEmpresa.dataSet.DisableControls;
      vTipoServEmpresa.dataSet.First;
      while not vTipoServEmpresa.dataSet.Eof do
      begin
        if vTipoServEmpresa.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE OR INSERT INTO TIPO_SERVICO_EMPRESA (COD_SERVICO, COD_EMPRESA) ' +
          	' VALUES (' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) + ',' +
            IntToStr(vTipoServEmpresa.dataSet.FieldByName('COD_EMPRESA').AsInteger) + ')' +
            ' MATCHING (COD_SERVICO, COD_EMPRESA); ';
          buscas.ExecSQL;
        end
        else
        begin
        	buscas.Close;
          buscas.SQL.Text := ' DELETE FROM TIPO_SERVICO_EMPRESA ' +
          	' WHERE COD_SERVICO = ' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(vTipoServEmpresa.dataSet.FieldByName('COD_EMPRESA').AsInteger);
          buscas.ExecSQL;
        end;

        vTipoServEmpresa.dataSet.Next;
      end;
    finally
      vTipoServEmpresa.First;
      vTipoServEmpresa.dataSet.EnableControls;
    end;

//    if (result)
//    	and (dataSet.ChangeCount = 0)
//      and (vTipoServEmpresa.dataSet.ChangeCount = 0)
//      and (acao = 'EDITAR') then
//    begin
//      Cancel;
//      Result := true;
//      Exit;
//    end;
//    if result then
//      result := apply;
		if result then
			result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('BAS020', acao, 'SUCESSO', 'TIPO_SERVICO',
				dataSet.FieldByName('COD_SERVICO').AsString, buscas);
			vMD5Func._gravaMD5_Servicos(buscas, dataSet.FieldByName('cod_servico').AsInteger);
    end
    else
      vDadosIni.GravaAuditoria('BAS020', acao, 'FALHA', 'TIPO_SERVICO',
        dataSet.FieldByName('COD_SERVICO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código do Tipo de Serviço duplicado.' +
          chr(13) +
          'O código do Tipo de serviço será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        dataSet.FieldByName('COD_SERVICO').AsVariant := null;
      end;
    end;
  end;
end;

procedure TTipoServ.PreencheCampos;
begin
  if dataSet.State = dsEdit then
  begin
    if dataSet.FieldByName('DATA_CAD_TIPO').IsNull then
      dataSet.FieldByName('DATA_CAD_TIPO').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('DATA_MOD_TIPO').AsDateTime := vDadosIni.getDataBanco(buscas);
  end
  else
  begin
    //    buscas.close;
    //    buscas.SQL.Text := 'select GEN_ID(INC_COD_TIPOSERV,0) from rdb$database';
    //    buscas.Open;
    //    dataSet.FieldByName('COD_SERVICO').AsInteger := buscas.FindField('GEN_ID').asinteger + 1;
    dataSet.FieldByName('DATA_CAD_TIPO').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('DATA_MOD_TIPO').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    dataSet.FieldByName('ATIVO').AsInteger := 1;
    buscas.close;
  end;
end;

function TTipoServ.restaurarRegistro: boolean;
var
	vCodServico: string;
	vDescServico: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCodServico := trim(dataSet.FieldByName('COD_SERVICO').AsString);
      vDescServico := trim(dataSet.FieldByName('DESC_SERVICO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCodServico := '';
        vDescServico := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCodServico) <> '') then
      	prepare_loop('COD_SERVICO = ' + vCodServico)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'SERVICO' + #13 +
        'Código: ' + vCodServico + #13 +
        'Descrição: ' + vDescServico;

      if (trim(vDescServico) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('BAS019', 'RESTAURAR', '', 'TIPO_SERVICO',
        vDadosIni.IfThen(trim(vCodServico) <> '', vCodServico, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de serviço');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de serviço (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update tipo_servico set ativo = 1 ' +
          ' where cod_servico = %d ',
          [fint('cod_servico')], buscas);

        if (trim(vCodServico) = '') then
          vDadosIni.GravaAuditoria('BAS019', 'RESTAURAR', '', 'TIPO_SERVICO',
            dataSet.FieldByName('COD_SERVICO').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('BAS019', 'RESTAURAR', 'SUCESSO', 'TIPO_SERVICO',
        vDadosIni.IfThen(trim(vCodServico) <> '', vCodServico, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('BAS019', 'RESTAURAR', 'FALHA', 'TIPO_SERVICO',
        vDadosIni.IfThen(trim(vCodServico) <> '', vCodServico, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TTipoServ.StatusLixeira: boolean;
begin
  result := not SqlOpen('SELECT first 1 COD_SERVICO FROM TIPO_SERVICO' +
                        ' where coalesce(cod_empresa, %d) = %d and ativo = 0',
                        [vDadosIni.cod_empresa, vDadosIni.cod_empresa]).IsEmpty;
end;

function TTipoServ.validarCamposPersonalizados: Boolean;
var
  vLista: TStrings;
  I: Integer;
begin
  Result := True;
  vLista := TStringList.Create;
  vLista := vDadosIni.getConfSisBlob('tpserv_cad_campos_obrigatorios', buscas);

  if vLista.Count = 0 then
    Exit;

  Result := False;
  try

    for I := 0 to vLista.Count - 1 do
      if I > 0 then
      begin
        checkFieldEmpty(
          vDadosIni.getValue(vLista.Strings[I], 1),
          vDadosIni.getValue(vLista.Strings[I], 2),
          vDadosIni.getValue(vLista.Strings[I], 3));
      end;

