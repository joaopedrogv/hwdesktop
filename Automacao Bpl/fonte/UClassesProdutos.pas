function TProdutos.gravarUnidadeComoPadrao: boolean;
begin
	try
    Result := False;

    if (dataSet.State <> dsEdit) then
    begin
    	Result := True;
      Exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' update produtos set inf_unidade = ''S'', rep_int_active = 1 ' +
    	' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.ExecSQL;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    dataSet.FieldByName('INF_UNIDADE').AsString := 'S';

    Result := True;
  except
    on E: Exception do
    begin
      result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutos.verMatInsumosProducao. Erro: ' + e.Message);
    end;
  end;
end;

{
procedure TProdutos.HandleAlteracaoMargemAtacado;
var
  preco, margem, markup, margemTmp: Double;
begin

  margem := ffloat('margem_a_desej', -2);

  dataSet.FieldByName('margem_a_desej').AsFloat  := IfThen(margem > 0, margem); // MARGEM

  if (vDadosIni.vEmp.vALT_PERC_MARGEM = 'S') and (ffloat('prec_cusm_prod') > 0) and (margem > 0) then
  begin

    preco := RoundTo(ffloat('prec_cusm_prod') / ( 1 - margem / 100), 0 - vDadosIni.vEmp.vCasasDecimais);
    markup := RoundTo((preco / ffloat('prec_cusm_prod') - 1) * 100, -2);

    margemTmp := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);
    if margemTmp < margem then
      preco := preco + 0.01;

    dataSet.FieldByName('prec_publico').AsFloat  := preco;  // PRECO
    dataSet.FieldByName('perc_tb_proda').AsFloat := markup; // MARKUP

  end;

  HandleMarkupMargemCalculados;

end;

