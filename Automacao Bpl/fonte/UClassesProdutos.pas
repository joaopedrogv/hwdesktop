function TProdutos.salvarPathFileArquivosBuscaPreco(pString: string): Boolean;
var
  vLista: TStringList;
  I: Integer;
begin

  vLista := TStringList.Create;
  vLista.Clear;
  buscas.Close;
  buscas.SQL.Text:= 'select ARQUIVOS_BUSCA_PRECO from empresa' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;
  vLista.Text := buscas.FieldByName('ARQUIVOS_BUSCA_PRECO').AsString;

  for I := 0 to vLista.Count - 1 do
  begin
    if vDadosIni.getCampoPipe(UpperCase(pString),5, '>') = vDadosIni.getCampoPipe(UpperCase(vLista[I]),5, '>') then
    begin
      Result := False;
      Application.MessageBox('Arquivo informado já esta configurado!', 'Atenção', 0 + 64);
      Exit;
    end;
  end;

  buscas.Close;
  buscas.SQL.Text := 'update empresa set ARQUIVOS_BUSCA_PRECO = coalesce(ARQUIVOS_BUSCA_PRECO, '''')||:ARQUIVOS_BUSCA_PRECO || ASCII_CHAR(13)' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.ParamByName('ARQUIVOS_BUSCA_PRECO').AsString := pString;
  buscas.ExecSQL;

  if buscas.Transaction.InTransaction then
  begin
    buscas.Transaction.Commit;
    Result := True;
  end;
end;

