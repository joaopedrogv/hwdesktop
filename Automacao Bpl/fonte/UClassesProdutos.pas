function TGradeBalanco._CadastraGradeProduto(PcodProd, pCodGrupo,
  pCodigo: string): boolean;
var
  vCodEmpresa: array of Integer;
  I: Integer;
begin
  buscas.Close;
  buscas.SQL.Text := 'select cod_empresa from empresa ';
  buscas.Open;
  buscas.FetchAll;
  // já cadastra a grade de produto no balanco fazendo a replicacao para outras empresas....
  SetLength(vCodEmpresa, buscas.RecordCount);
  i := 0;
  buscas.First;
  while not buscas.Eof do
  begin
    vCodEmpresa[I] := buscas.FieldByName('cod_empresa').AsInteger;
    inc(I);
    buscas.Next;
  end;
  for I := 0 to Length(vCodEmpresa) - 1 do
  begin
    try
      buscas.Close;
      buscas.SQL.Text := 'INSERT INTO COD_GRADE_PROD (GRUPO_PROD,COD_PROD,COD_GRADE, COD_EMPRESA,QTDE)' +
        ' VALUES (' + pCodGrupo + ',''' + PcodProd + ''',' + pCodigo + ',' + inttostr(vcodempresa[i]) + ',0)';
      buscas.Prepare;
      buscas.ExecSQL;
      CommitaTransacao;
      result := true;
    except
      on E: Exception do
      begin
//        Application.MessageBox(PChar('E0006 ' + 'Erro ao tentar executar comandos sql: ' +
//          buscas.SQL.Text), 'Atenção', MB_ICONWARNING + MB_OK);
        if vcodempresa[i] = strtoint(vDadosIni.codempresa) then
          result := false
        else result := true;
      end;
    end;
  end;
  try
    buscas.Close;
    buscas.SQL.Text := 'update config_sistema set value1_vc = null' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and chave = ' + QuotedStr('prcss_montar_estoque_diario_30_12_1899') +
      ' and value1_vc is not null';
    buscas.ExecSQL;
    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;
  except
  end;
end;

function TGradeBalanco._existeGrade(pCodProd, pCodGrupo: string;
  pCodigo: string): Boolean;
begin
  Result := False;
  if Trim(pCodigo) = '' then
    Exit;

  try
    StrToInt(Trim(pCodigo));
  except
    exit;
  end;
  if not ExecutaComandosSql('select cod_grade from COD_GRADE_PROD where cod_empresa = '
    + vDadosIni.codEmpresa + ' and cod_prod = '
    + QuotedStr(trim(pCodProd))
    + ' and GRUPO_PROD = ' + pCodGrupo +
    ' and cod_grade = ' + pCodigo + ' and ativo = 1') then
  begin
    if not ExecutaComandosSql('select cod_grade from GRADE where cod_empresa = '
      + vDadosIni.codEmpresa +
      ' and cod_grade = ' + pCodigo + ' and ativo = 1') then
      result := false
    else
    begin
      if _CadastraGradeProduto(pCodProd, pCodGrupo, pCodigo) then
        result := true
      else
        result := false;
    end;
  end
  else
    Result := true;
end;

