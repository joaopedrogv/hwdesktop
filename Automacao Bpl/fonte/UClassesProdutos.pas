        IntToStr(vCodPromocao), buscas, false) then
        Exit;

      vDadosIni.verificarReplicacaoInterna(buscas, true);

      pDateSetProd.DisableControls;
      pDateSetProd.First;
      while not pDateSetProd.Eof do
      begin
        if vCodTpPreco = 1 then
          vDadosIni.abreStatusProcessamento('', 'Removendo dados da promoção ' + IntToStr(pDateSetProd.RecNo) + '/' + IntToStr(pDateSetProd.RecordCount))
        else if vCodTpPreco = 2 then
          vDadosIni.abreStatusProcessamento('', 'Removendo dados preço por localidade ' + IntToStr(pDateSetProd.RecNo) + '/' + IntToStr(pDateSetProd.RecordCount))
        else if vCodTpPreco = 3 then
          vDadosIni.abreStatusProcessamento('', 'Removendo dados preço por setor ' + IntToStr(pDateSetProd.RecNo) + '/' + IntToStr(pDateSetProd.RecordCount))
        else if vCodTpPreco = 4 then
          vDadosIni.abreStatusProcessamento('', 'Removendo dados preço por cidade ' + IntToStr(pDateSetProd.RecNo) + '/' + IntToStr(pDateSetProd.RecordCount))
        else if vCodTpPreco = 5 then
          vDadosIni.abreStatusProcessamento('', 'Removendo dados preço tabela avulsa ' + IntToStr(pDateSetProd.RecNo) + '/' + IntToStr(pDateSetProd.RecordCount));

        for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
        begin
          buscas.Close;
          buscas.SQL.Text := 'DELETE FROM PROMOCAO_PRODUTO ' +
            ' WHERE COD_PROMOCAO = :COD_PROMOCAO ' +
            ' AND COD_TPPRECO = :COD_TPPRECO ' +
            ' AND COD_EMPRESA = :COD_EMPRESA ' +
            ' AND GRUPO_PROD = :GRUPO_PROD ' +
            ' AND COD_PROD = :COD_PROD ' +
            ' AND COD_LOCALIDADE = :COD_LOCALIDADE ' +
            ' AND COD_SETOR = :COD_SETOR ' +
            ' AND COD_CIDADE = :COD_CIDADE ' +
            ' AND SIGLA = :SIGLA; ';
          buscas.ParamByName('COD_PROMOCAO').AsInteger := vCodPromocao;
          buscas.ParamByName('COD_TPPRECO').AsInteger := vCodTpPreco;
          buscas.ParamByName('GRUPO_PROD').AsInteger := pDateSetProd.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := pDateSetProd.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[i]);
          buscas.ParamByName('COD_LOCALIDADE').AsInteger := 0;
          buscas.ParamByName('COD_SETOR').AsInteger := 0;
          buscas.ParamByName('COD_CIDADE').AsInteger := 0;
          buscas.ParamByName('SIGLA').AsString := vSigla;
          buscas.ExecSQL;
        end;

        vDadosIni.GravaAuditoria('PRO241', 'EXCLUIR - ' + vTipo,
