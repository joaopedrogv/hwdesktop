function TBalancoProduto._validaQtdASubtrairGrade(pQuant: double;
  pCodGrade: integer): boolean;
begin
  result := true;
  try
    if pQuant < 0 then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select qtde from cod_grade_balanco ' +
        ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
        ' and cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_grade = ' + inttostr(pCodGrade);
      buscas.Open;
      if (buscas.FieldByName('QTDE').AsFloat + pQuant) < 0 then
      begin
        result := false;
        PlaySound(Pchar('erro.wav'), 0, SND_ASYNC);
        Application.MessageBox(Pchar('Quantidade a subtrair (' + floattostr(pQuant) + ') da grade informada é maior que quantidade que já foi contada (' + floattostr(buscas.FieldByName('QTDE').AsFloat) + ').' + chr(13)
          + 'Favor verificar e informar a quantidade correta.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end;
    end;
  finally
    buscas.Close;
  end;
end;

