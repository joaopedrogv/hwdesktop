function TGrade.replicaGrade: boolean;
var
  buscas2: TIBQuery;
  I: Integer;
  J: Integer;
  Fields: string;
begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  vDadosIni.verificarReplicacaoInterna(buscas, false, 'GRADE');
  {
  }
  Fields := '';
  for I := 0 to dataSet.FieldCount - 1 do with dataSet.Fields[I] do
    if FieldKind = fkData then
      Fields := Fields + IfThen(Fields <> '', ',') + dataSet.Fields[I].FieldName;
  buscas.Close;
  buscas.SQL.Text := Format('INSERT INTO GRADE (%s) VALUES (:%s)',
                            [Fields, StringReplace(Fields, ',', ',:', [rfReplaceAll])]);

  for I := 0 to Length(vDadosIni.vReplicaoInternaEmpresa) - 1 do
  begin
    buscas2.Close;
    buscas2.SQL.Text := 'select ' + Fields + ' from grade ' +
      ' where cod_grade = :cod_grade and cod_empresa = :cod_empresa ';
    buscas2.ParamByName('cod_grade').AsInteger := fOldCodGrade;
    buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);
    buscas2.Open;

    if buscas2.IsEmpty then
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select ' + Fields + ' from grade ' +
        ' where cod_grade = :cod_grade and cod_empresa = :cod_empresa ';
      buscas2.ParamByName('cod_grade').AsInteger := fOldCodGrade;
      buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas2.Open;

      buscas.Close;
      buscas.SQL.Text := 'INSERT INTO GRADE (';
      if not buscas2.IsEmpty then
	      for J := 0 to buscas2.FieldCount - 1 do
	        buscas.SQL.Text := buscas.SQL.Text + IfThen(J = 0, '', ', ') + buscas2.Fields[J].FieldName;

      buscas.SQL.Text := buscas.SQL.Text + ') VALUES (';

      if not buscas2.IsEmpty then
	      for J := 0 to buscas2.FieldCount - 1 do
          buscas.SQL.Text := buscas.SQL.Text + IfThen(J = 0, '', ', ') + ':' + buscas2.Fields[J].FieldName;
      buscas.SQL.Text := buscas.SQL.Text + ');';

      if not buscas2.IsEmpty then
        for J := 0 to buscas2.FieldCount - 1 do
          buscas.ParamByName(buscas2.Fields[J].FieldName).Value :=
            buscas2.FieldByName(buscas2.Fields[J].FieldName).Value;

      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.vReplicaoInternaEmpresa[I]);

      try
        buscas.ExecSQL;
      except
        on e: exception do
        begin
          Result := false;
          Application.MessageBox(pchar('Erro na replicação de grades entre empresas. Erro: ' +
            e.Message), 'Atenção', MB_ICONEXCLAMATION +
            MB_OK);
          exit;
        end;
      end;
    end;
  end;

  CommitaTransacao;

end;

function TGrade.RestaurarRegistro: boolean;
var
	vApagar: boolean;
	vCodGrade: string;
  vDescricao1, vDescricao2: string;
  vTipo1, vTipo2: string;
  vtemp: string;
begin
	try
    Result := false;
    if dataSet.IsEmpty then
    	exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vApagar     := dataSet.FieldByName('ATIVO').AsInteger <> 1;
      vCodGrade   := trim(dataSet.FieldByName('COD_GRADE').AsString);
      vDescricao1 := trim(dataSet.FieldByName('DESCRICAO').AsString);
      vDescricao2 := trim(dataSet.FieldByName('DESCRICAO1').AsString);
      vTipo1      := trim(dataSet.FieldByName('TIPO_EC').AsString);
      vTipo2      := trim(dataSet.FieldByName('TIPO_EC1').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vApagar     := dataSet.FieldByName('ATIVO').AsInteger <> 1;
        vCodGrade   := '';
        vDescricao1 := '';
        vDescricao2 := '';
        vTipo1      := '';
        vTipo2      := '';
      end;
    finally
    	prepare_loop_done;
    end;

    try
    	if (trim(vCodGrade) <> '') then
        prepare_loop('COD_GRADE = ' + vCodGrade)
      else
        prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
          'GRADE' + #13 +
          'Cod Grade: ' + trim(vCodGrade) + #13+
          'Descrição 1: ' + trim(vDescricao1) +
          vDadosIni.IfThen(trim(vDescricao2) <> '', #13 + 'Descrição 2: ' + trim(vDescricao2), '') +
          vDadosIni.IfThen(trim(vTipo1) <> '', #13 + 'Tipo 1: ' + trim(vTipo1), '') +
          vDadosIni.IfThen(trim(vTipo2) <> '', #13 + 'Tipo 2: ' + trim(vTipo2), '');

    	if (trim(vCodGrade) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('PRO101', 'RESTAURAR', '', 'GRADE',
      	vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas, false) then
  				exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando grade(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando grade(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update grade set ativo = 1 ' +
          ' where cod_grade = %d and cod_empresa = %d ',
          [fint('cod_grade'), fint('cod_empresa')], buscas);

        if (trim(vCodGrade) = '') then
          vDadosIni.GravaAuditoria('PRO101', 'RESTAURAR', '', 'GRADE',
            dataSet.FieldByName('COD_GRADE').AsString, buscas);

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria('PRO101', 'RESTAURAR REGISTRO', 'SUCESSO', 'GRADE',
        vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
      vDadosIni.GravaAuditoria('PRO101', 'RESTAURAR REGISTRO', 'FALHA', 'GRADE',
        vDadosIni.IfThen(trim(vCodGrade) <> '', vCodGrade, ''), buscas);
    end;

    if Result then
    	Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

