function TFichaInventario.getQuantidadePendenteReqOS(grupo_prod: integer;
  cod_prod, tipo: string): Double;
begin
  Result := vDadosIni.getPendenciasEstoque(grupo_prod, cod_prod, -1, tipo, buscas, True);
  Exit;

  if tipo = 'PRODUCAO' then
  begin
    buscas.Close;
    buscas.SQL.Text :=
      'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as valor from producao pd, producao_item_indice pi' +
      ' where pi.grupo_prod = ' + IntToStr(grupo_prod) + ' and pi.cod_prod = ' + QuotedStr(cod_prod) +
      ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
      ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    Result := buscas.FieldByName('valor').AsFloat;
    Exit;
  end;

  buscas.close;
  buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = ' + quotedstr(cod_prod) +
    ' and ipv.grupo_prod = ' + inttostr(grupo_prod) +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and pv.tipo = ' + quotedstr(tipo) +
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' +
    vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  //  buscas.ParamByName('vgrup').AsInteger := grupo_prod;
  //  buscas.ParamByName('vcod').AsString := cod_prod;
  buscas.Prepare;
  buscas.Open;
  Result := buscas.FieldByName('valor').AsFloat;
  buscas.Close;
  buscas.UnPrepare;
end;

function TFichaInventario.getQuantidadePendenteReqOS(grupo_prod: integer;
  cod_prod: string): Double;
begin
  Result := vDadosIni.getPendenciasEstoque(grupo_prod, cod_prod, -1, '', buscas, True);
  Exit;

  buscas.close;
  buscas.SQL.Text := 'select sum(ipv.quant_ped_item) as valor from pedvenda pv' +
    ' inner join pedvenda_prod ipv on ipv.nped = pv.nped' +
    ' and ipv.cod_empresa = pv.cod_empresa and ipv.tipo = pv.tipo' +
    ' where ipv.cod_prod = ' + quotedstr(cod_prod) +
    ' and ipv.grupo_prod = ' + inttostr(grupo_prod) +
    ' and ((ipv.status is null) or (ipv.status <> ''CANCELADO''))' +
    ' and pv.tipo <> ''ORC''' +
    ' and (pv.data_fech is null or pv.data_fech < ''01/01/1900'') and pv.cod_empresa = ' +
    vDadosIni.codEmpresa +
    ' and pv.ativo = 1';
  //  buscas.ParamByName('vgrup').AsInteger := grupo_prod;
  //  buscas.ParamByName('vcod').AsString := cod_prod;
  buscas.Prepare;
  buscas.Open;
  Result := buscas.FieldByName('valor').AsFloat;

  buscas.Close;
  buscas.SQL.Text :=
    'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as valor from producao pd, producao_item_indice pi' +
    ' where pi.grupo_prod = ' + IntToStr(grupo_prod) + ' and pi.cod_prod = ' + QuotedStr(cod_prod) +
    ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
    ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  Result := Result + buscas.FieldByName('valor').AsFloat;

  buscas.Close;
  buscas.UnPrepare;
end;
