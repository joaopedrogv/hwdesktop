    margemTmp := RoundTo((((preco - ffloat('prec_cusm_prod')) / preco) * 100), -2);
    if margemTmp < margem then
      preco := preco + 0.01;

    dataSet.FieldByName('prec_tab_prod').AsFloat := preco;  // PRECO
    dataSet.FieldByName('perc_tb_prod').AsFloat  := markup; // MARKUP

  end;

  HandleAlteracaoPercentualAd_30;
