function TItKitsProdutos.post(pKit: TKitsProdutos; pCommitar: boolean): boolean;
var
  acao: string;
  vCodigo: Integer;
begin
  try
    Result := false;
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    vCodigo := dataSet.FieldByName('CODIGO_KIT').AsInteger;

    if not vDadosIni.PesqPros('PRO123', 'INCLUIR', '','KITS_PROD_KITS',
  		IntToStr(vCodigo), buscas, true) then
	    exit;

    if trim(dataSet.FieldByName('NUM_FAB_PROD').AsString) = '' then
    	raiseExceptionCreate('Produto no Kit não informado', 'DBEdit4');

    if trim(dataSet.FieldByName('NUM_FAB_PROD').AsString) <> '' then
    begin
    	if (dataset.FieldByName('GRUPO_PROD').AsInteger > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select grupo_prod, cod_prod, cod_empresa from produtos ' +
          ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ativo=1';
        buscas.Open;
      end
      else
      begin
        buscas.Close;
        buscas.SQL.Text := 'select grupo_prod, cod_prod, cod_empresa from produtos ' +
          ' where num_fab_prod = ' + quotedstr(dataSet.FieldByName('NUM_FAB_PROD').asstring) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ativo = 1 ';
        buscas.Open;
      end;

      if buscas.IsEmpty then
    		raiseExceptionCreate('Produto no Kit não encontrado', 'DBEdit4');
    end;

    if (dataSet.FieldByName('QUANT_PROD_KIT').AsFloat <= 0) then
      raiseExceptionCreate('Quantidade do Item no Kit não informada', 'DBEdit3');
                               
    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    AtualizarRateioDesc(pKit, false);

    if pCommitar then
      if result then
        result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('PRO123', acao, 'SUCESSO - ' +
      	dataSet.FieldByName('GRUPO_PROD').asstring + ' - ' + dataSet.FieldByName('COD_PROD').asstring,
        'KITS_PROD_KITS', dataSet.FieldByName('CODIGO_KIT').asstring, buscas);

    Kit.Refresh;
    Refresh;

    verificarPesoDimensoesProdutos(acao, vCodigo);
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('PRO123', acao, 'FALHA - ' +
      	dataSet.FieldByName('GRUPO_PROD').asstring + ' - ' + dataSet.FieldByName('COD_PROD').asstring,
        'KITS_PROD_KITS', dataSet.FieldByName('CODIGO_KIT').asstring, buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

