begin
	 if trim(pBuscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS' then
   begin
    	ftempOrigemRec.Filter := 'TIPO = ''P'' AND CONTROLE = ' + QuotedStr(trim(pBuscas.FieldByName('TIPO').AsString));
      ftempOrigemRec.Filtered := True;
      if ftempOrigemRec.IsEmpty then
      begin
        ftempOrigemRec.Insert;
