       ' and coalesce(nat.compra, '''') <> ''N'' ' +
//       and (coalesce(nat.tipv_veiculo,'''') = ''V'') ' +
       ' and nf4.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf4.ativo=1 order by 2 desc ';
      buscas2.params[0].AsString := trim(buscas.FieldByName('CHASSI_CONC').AsString);
      buscas2.open;
      if buscas2.isempty then
      begin
        rdp.imp(linha, 1, trim(buscas.FieldByName('CHASSI_CONC').AsString));
        rdp.imp(linha, 22, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('VALOR_CTP').AsFloat]), 12));
        rdp.imp(linha, 36, trim(buscas2.FieldByName('DATA_LANC').AsString));
        rdp.imp(linha, 48, trim(buscas.FieldByName('DATQ_CTP').AsString));
        rdp.imp(linha, 60, trim(buscas.FieldByName('DATA_VENC_CTP').AsString));
        rdp.imp(linha, 72, trim(buscas.FieldByName('N_DOC_CTP').AsString));
        rdp.imp(linha, 94, trim(buscas.FieldByName('STATUS_HONDA').AsString));
        linha := linha + 1;
        vpagcont := vpagcont + buscas.FieldByName('VALOR_CTP').AsFloat;
        vlparc := vlparc + buscas.FieldByName('VALOR_CTP').AsFloat;
      end
      else
        if buscas2.FieldByName('DATA_LANC').AsDateTime > datafinal then
        begin
          rdp.imp(linha, 1, trim(buscas.FieldByName('CHASSI_CONC').AsString));
          rdp.imp(linha, 22, vDadosIni.Alndir(format('%n', [buscas.FieldByName('VALOR_CTP').AsFloat]), 12));
          rdp.imp(linha, 36, trim(buscas2.FieldByName('DATA_LANC').AsString));
          rdp.imp(linha, 48, trim(buscas.FieldByName('DATQ_CTP').AsString));
          rdp.imp(linha, 60, trim(buscas.FieldByName('DATA_VENC_CTP').AsString));
          rdp.imp(linha, 72, trim(buscas.FieldByName('N_DOC_CTP').AsString));
          rdp.imp(linha, 94, trim(buscas.FieldByName('STATUS_HONDA').AsString));
          linha := linha + 1;
          vpagcont := vpagcont + buscas.FieldByName('VALOR_CTP').AsFloat;
        end;
    end;
    if linha = 65 then
    begin
      linha := 1;
      rdp.Novapagina;
    end;
    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    buscas.next;
  end;
  linha := linha + 1;
  rdp.imp(linha, 1, 'TOTAL GERAL: ');
  rdp.imp(linha, 22, vDadosIni.Alndir(format('%n', [vpagcont]), 12));
  linha:=linha+1;
  rdp.imp(linha, 1, 'TOTAL S/CHG: ');
  rdp.imp(linha, 22, vDadosIni.Alndir(format('%n', [vlparc]), 12));
  linha:=linha+1;
  rdp.imp(linha, 1, 'TOTAL CHG..: ');
  rdp.imp(linha, 22, vDadosIni.Alndir(format('%n', [vpagcont-vlparc]), 12));

  buscas.close;
  buscas2.close;
  rdp.Fechar;
  vDadosIni.GravaAuditoria('REL037', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

