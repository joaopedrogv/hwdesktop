procedure TRelatorioComprasPorPeriodo.CabNovaPagina;
begin
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO COMPRAS DE PRODUTOS P/ PERIODO', [normal, negrito]);
