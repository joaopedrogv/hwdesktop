    ' (P.SUBTIPO_OS = ''EXPRESSO'' AND S.STIPO <> ''V'' AND S.STIPO <> ''R'') GROUP BY S.STIPO,SEQ_REVISAO';
  buscas.open;
  while not buscas.eof do
  begin
   vtotsexpress := vtotsexpress + buscas.FieldByName('QTDE').AsInteger;
   vtotpass := vtotpass + buscas.FieldByName('QTDE').AsInteger;
