        Rdp.impF(linha, 1, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_ped').AsDateTime), [comp17]);
        Rdp.ImpF(linha, 14, trim(buscas.FieldByName('tipo').AsString) + ' ' +
          vDadosIni.StrZero(buscas.FieldByName('nped').AsInteger, 6), [comp17]);
        Rdp.ImpF(linha, 26, vDadosIni.IfThen(ExibirRazaoFantasia = 0,
          Copy(trim(buscas.FieldByName('razao').AsString), 1, 38),
          Copy(trim(buscas.FieldByName('nome_cliente').AsString), 1, 38)), [comp17]);
        if not buscas.FieldByName('data_fech').IsNull then
          Rdp.impF(linha, 72, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_fech').AsDateTime), [comp17]);
        Rdp.ImpD(linha, 102, format('%n', [buscas.FieldByName('vltot_ped_item').asFloat]), [comp17]);
        Rdp.ImpD(linha, 116, format('%n', [buscas.FieldByName('perc_comissao_vend').AsFloat]), [comp17]);
        Rdp.impD(linha, 131, format('%n', [buscas.FieldByName('vl_comissao_vend').AsFloat]), [comp17]);
      end;
      inc(linha);

