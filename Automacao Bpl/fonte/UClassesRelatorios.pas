function TRelatorios.marcaDesmarca(pDataset: TDataSet): boolean;
begin
  if pDataset.IsEmpty then
    exit;

  pDataset.Edit;
  if pDataset.FieldByName('SEL').AsString = 'S' then
    pDataset.FieldByName('SEL').AsString := ''
  else
    pDataset.FieldByName('SEL').AsString := 'S';
  pDataset.Post;
end;

function TRelatorios.marcaTodos(pDataset: TDataSet): boolean;
begin
   try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');

    pDataset.First;
    while not pDataset.Eof do
    begin
      pDataset.Edit;
      pDataset.FieldByName('sel').AsString := 'S';
      pDataset.Post;
      pDataset.Next;
    end;
    pDataset.First;

  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TRelatorios.MontarListaParticipantes(pVouF: boolean;
  var CheckListBoxPart: TCheckListBox): boolean;
var
	vTemp: string;
begin
	Result := False;

  if not pVouF then
    exit;

	CheckListBoxPart.Clear;

  vTemp := '0 - SEM ' + trim(UpperCase(vDadosIni.vPedVnd.descricaoParticipante));
  CheckListBoxPart.Items.Add(vTemp);

  buscas.Close;
  buscas.SQL.Text := ' SELECT COD_PARTICIPANTE, NOME_PARTICIPANTE FROM PARTICIPANTE ' +
  	' WHERE COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' AND ATIVO = 1 ' +
    ' ORDER BY 2 ';
  buscas.Open;

  buscas.First;
  while not buscas.Eof do
  begin
    CheckListBoxPart.Items.Add(IntToStr(buscas.FieldByName('COD_PARTICIPANTE').AsInteger) + ' - ' +
    	trim(buscas.FieldByName('NOME_PARTICIPANTE').AsString));

    buscas.Next;
  end;

  Result := true;
end;

function TRelatorios.MontarListaVendedores(
	pVouF: boolean;
  var CheckListBoxVend: TCheckListBox): boolean;
begin
	Result := False;

  if not pVouF then
    exit;

	CheckListBoxVend.Clear;

  buscas.Close;
