function TRelatorioVendasGeral.RetornaQtdVendas(pTipo: string): integer;
begin
  try
    result := 0;
    if (pTipo <> 'REQ') and (pTipo <> 'OS') then
      exit;

    buscasGerais.Close;
    buscasGerais.SQL.Text := 'select count(distinct(vp.nped)) as qtdVendas from vendaprodutos vp ';
    if FiltrarAreaExec then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text  +
      ' inner join tipo_vendas tp on tp.tipo = vp.tipo and (tp.sigla = vp.tipv or (tp.tipo_os = vp.tipo_os)) ';

    buscasGerais.SQL.Text := buscasGerais.SQL.Text  +
    	' where vp.data_fech>= :dti ' +
      ' and vp.data_fech <= :dtf ' +
      ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and vp.tipo = ' + QuotedStr(trim(pTipo));

    if pTipo = 'REQ' then
    begin
      if FiltrarTipoVenda then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.TIPV = ' + QuotedStr(trim(TipoVenda))
      else
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.venda = ''S'' ';
    end
    else if pTipo = 'OS' then
      if FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.TIPO_OS = ' + QuotedStr(trim(TipoOs))
      else
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.venda = ''S'' ';

    if FiltrarVendedor then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor;

    if FiltrarGrupo then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

    if pTipo = 'OS' then
      if FiltrarAreaExec then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec));
     
    buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
    buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
    buscasGerais.Open;
    result := buscasGerais.FieldByName('qtdVendas').AsInteger;
    buscasGerais.close;
  except

  end;

end;

function TRelatorioVendasGeral.SelecionaDevolucao: Boolean;
var
  variavel: string;
begin

  with dtmRelatorios do
  begin
    qrBuscas.Close;
    qrBuscas.SQL.Clear;

    qrBuscas.Params.CreateParam(ftDate, 'dataini', ptUnknown);
    qrBuscas.Params.CreateParam(ftDate, 'datafin', ptUnknown);
    qrBuscas.Params.CreateParam(ftUnknown, 'cod_empresa', ptUnknown);
    qrBuscas.Params.CreateParam(ftUnknown, 'gruponum', ptUnknown);

    qrBuscas.Params.ParamByName('dataini').AsDate := Fdatainicial;
    qrBuscas.Params.ParamByName('datafin').AsDate := Fdatafinal;
    qrBuscas.Params.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    qrBuscas.Params.ParamByName('gruponum').AsString := FGrupoNum;

    variavel := variavel + ' select ' +
    	' sum(case when (coalesce(valor_tot, 0) > 0) then ' +
      '            coalesce(valor_tot, 0) ' +
      '          else ' +
      '            (coalesce(quant, 0) * coalesce(valor, 0)) ' +
      '    end ' +
      ' ) valor, ' +
      ' sum(coalesce(quant, 0) * coalesce(pcust_mc, 0)) as custo ' +
      ' from devolucao ' +
      ' where data >= :dataini ' +
      ' and data <= :datafin ' +
      ' and cod_empresa = :cod_empresa ' +
      ' and ativo = 1 ' +
      ' and coalesce(nf_gerou,'''') <> ''S''';

    if FGrupoNum <> 'Todos' then
      variavel := variavel + 'and grupo_prod = :gruponum ';

    qrBuscas.SQL.Text := variavel;
    qrBuscas.Open;
  end;
end;

