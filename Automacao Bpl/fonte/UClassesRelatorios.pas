procedure TRelatorioVeiculosemDemonstracao.ImprimeRelatorios;
var
 vcountg, vcount, vversao: integer;
  vtotcusto, vtotvenda: currency;
begin
  if not vDadosIni.PesqPros('REL031', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de Veículos em Demonstração';
  rdp.TitulodoRelatorio := 'Veículos em Demonstração';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if UpperCase(trim(TipoRelatorio)) = 'NÃO FATURADAS' then
    abreVeiculosemDemonstracao(1)
  else
    abreVeiculosemDemonstracao(2);
//  if buscas.IsEmpty then
//  begin
//   Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//   exit;
//  end;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

   linha := 1;
   vpag := 0;
   vcount := 0;
   vcountg := 0;
   vtotcusto := 0.00;
   vtotvenda := 0.00;
   vversao := buscas.FieldByName('codigo').AsInteger;
   CabNovaPagina; //cabeçalho

   buscas.First;
   while not buscas.eof do
   begin
     Application.ProcessMessages;
     if variavel_parar then
     begin
       if confirmaparar then
       begin
 //        Parar;
         Exit;
       end;
     end;
     if buscas.FieldByName('situacao').isnull then
     begin
       Rdp.Imp(linha, 1, trim(buscas.FieldByName('CHASSIV').AsString));
       buscas1.close;
       buscas1.SQL.Text := ' select * from est_moto where chassi_c = :vchass ' +
         ' and codigo = :codigo and cod_empresa = :cod_empresa and ativo = 1 ';
       buscas1.params[0].AsString := trim(buscas.FieldByName('CHASSIV').AsString);
       buscas1.params[1].AsInteger := buscas.FieldByName('COD_ESTMOTO').AsInteger;
       buscas1.params[2].AsInteger := StrToInt(vDadosIni.codEmpresa);
       buscas1.Open;

       buscas2.close;
       buscas2.SQL.Text := ' SELECT * FROM CLIENTES ' +
         ' where cod_cliente = :cod_cliente and cod_empresa = :cod_empresa and ativo = 1 order by nome_cliente';
       buscas2.params[0].AsInteger := buscas.FieldByName('CLIENTES_V').AsInteger;
       buscas2.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
       buscas2.open;

       Rdp.Imp(linha, 20, trim(buscas1.FieldByName('DESCRICAO_VERSAOEST').AsString));
       Rdp.Imp(linha, 37, copy(vDadosIni.strzero(buscas.FieldByName('CLIENTES_V').AsString, 5) + ' ' +
         trim(buscas2.FieldByName('NOME_CLIENTE').AsString), 1, 38));
       Rdp.Imp(linha, 77,  buscas.FieldByName('data_ven').asstring);
       Rdp.Imp(linha, 88, vDadosIni.Strzero(buscas.FieldByName('num_nota_v').AsString, 5));

       if buscas.FieldByName('NUM_NOTA').AsInteger > 0 then
       begin
         buscas2.close;
         buscas2.SQL.Text := ' select first 1 (et.custo) as custo from comprasmesesv40 et ' +
           ' where et.chassi = :vchass and et.cod_empresa = :cod_empresa and et.status_uso = :status_uso ' +
           ' order by data_ch_nota ';
         if trim(buscas.FieldByName('TIPO_VENDA_V').AsString) = 'U' then
           buscas2.SQL.Text := buscas2.SQL.Text + ' desc ';
         buscas2.params[0].value := trim(buscas.FieldByName('chassiv').AsString);
         buscas2.params[1].value := StrToInt(vDadosIni.codEmpresa);
         buscas2.params[2].Value := trim(buscas.FieldByName('tipo_venda_v').AsString);
         buscas2.open;

         if buscas2.FieldByName('Custo').AsFloat > 0 then
         begin
           Rdp.Imp(linha, 95, vDadosIni.AlnDir(format('%n', [buscas2.FieldByName('Custo').AsFloat]), 10));
           vtotcusto := vtotcusto + buscas2.FieldByName('Custo').AsFloat;
         end
         else
         begin
           Rdp.Imp(linha, 95, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('preco_custo').AsFloat]), 10));
           vtotcusto := vtotcusto + buscas.FieldByName('preco_custo').AsFloat;
         end;
       end
       else
       begin
         Rdp.Imp(linha, 95, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('preco_custo').AsFloat]), 10));
         vtotcusto := vtotcusto + buscas.FieldByName('preco_custo').AsFloat;
       end;
       Rdp.Imp(linha, 108, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('preco_tabest').AsFloat]), 10));
       vtotvenda := vtotvenda + buscas.FieldByName('preco_tabest').AsFloat;
       Rdp.Imp(linha, 120, copy(trim(buscas.FieldByName('nome_receb').AsString), 1, 14));
       linha := linha + 1;
       vcount := vcount + 1;
       vcountg := vcountg + 1;
       if linha >= 59 then
       begin
         linha := 1;
         CabNovaPagina;
       end;
       frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
       buscas.next;
       if buscas.FieldByName('codigo').AsInteger <> vversao then
       begin
         vversao := buscas.FieldByName('codigo').AsInteger;
         Rdp.Imp(linha, 1, '********** QTDE: ' + vDadosIni.Strzero(vcount, 5));
         linha := linha + 1;
         vcount := 0;
       end;
     end
     else
     begin
       frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
       buscas.next;
       if buscas.FieldByName('codigo').AsInteger <> vversao then
       begin
         vversao := buscas.FieldByName('codigo').AsInteger;
         if vcount <> 0 then
         begin
           Rdp.Imp(linha, 1, '********** QTDE: ' + vDadosIni.Strzero(vcount, 5));
           linha := linha + 1;
           vcount := 0;
         end;
       end;
     end;
     if buscas.eof then
     begin
       Rdp.Imp(linha, 1, '********** QTDE: ' + vDadosIni.Strzero(vcount, 5));
       linha := linha + 1;
     end;
   end;
   Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
   linha := linha + 1;
   Rdp.Imp(linha, 1, 'TOTAIS');
   Rdp.Imp(linha, 17, vDadosIni.Strzero(vcountg, 5));
   Rdp.Imp(linha, 95, vDadosIni.AlnDir(format('%n', [vtotcusto]), 10));
   Rdp.Imp(linha, 108, vDadosIni.AlnDir(format('%n', [vtotvenda]), 10));
   Rdp.fechar;
   buscas.close;
   buscas1.close;
   buscas2.close;
   vDadosIni.GravaAuditoria('REL031', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

