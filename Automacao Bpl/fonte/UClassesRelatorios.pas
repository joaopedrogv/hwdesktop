constructor TRelatorioApuracaoICMS.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrbuscas2);

  dtSetApuracaoTemp := TClientDataSet(dtmRelatorios.cdsApuracaoICMSTemp);
  if dtSetApuracaoTemp.Tag = 0 then
  try
    dtSetApuracaoTemp.CreateDataSet;
    dtSetApuracaoTemp.Tag := 22;
  except
  end;

  dtSetApuracaoTemp2 := TClientDataSet(dtmRelatorios.cdsApuracaoICMSTemp2);
  if dtSetApuracaoTemp2.Tag = 0 then
  try
    dtSetApuracaoTemp2.CreateDataSet;
    dtSetApuracaoTemp2.Tag := 21;
  except
  end;
end;

procedure TRelatorioApuracaoICMS.ImprimeRelatorios;
var
  vTipo, vCFOP, vUF, vDEBITO, vCREDITO, vInicia_E, vInicia_S, DiaS: string;
  vlcontabilE, base_calcE, vlicmsE, vlisentasE, vloutrasE, vlicmssubE: currency;
  vlcontabilS, base_calcS, vlicmsS, vlisentasS, vloutrasS, vlicmssubS: currency;
  vlicmsApagar, vlicmsTrans: currency;
  vlcontabil1, base_calc1, vlicms1, vlipi1, base_calcIpi1, vldesconto: currency;
  vlcontabil2, base_calc2, vlicms2: currency;
  vlcontabil3, base_calc3, vlicms3: currency;
  vlcontabil1t, base_calc1t, vlicms1t, vldescontot, vlipitot: currency;
  vlcontabil2t, base_calc2t, vlicms2t: currency;
  vlcontabil3t, base_calc3t, vlicms3t: currency;
  vlcontabilD, base_calcICMSD, vlicmsD, vlicmsSubD, vlisentosD, vloutrasD, vldescontoD, base_calcIPID, vlIPID: currency;
  vlContabilContr, vlContabilNContr, vlBaseCliContr, vlBaseCliNContr: currency;
  i, vLinhaTot: Integer;

  procedure ZerarVariaveis;
  begin
    vlcontabil1 := 0;
    vlcontabil2 := 0;
    vlcontabil3 := 0;
    base_calc1 := 0;
    base_calc2 := 0;
    base_calc3 := 0;
    vlicms1 := 0;
    vlicms2 := 0;
    vlicms3 := 0;
    vldesconto := 0;
    vlipi1 := 0;
    base_calcIpi1 := 0;
  end;

  procedure ZerarValorDia;
  begin
    vlcontabilD := 0;
    base_calcICMSD := 0;
    vlicmsD := 0;
    vldescontoD := 0;
    vlicmsSubD := 0;
    vlisentosD := 0;
    vloutrasD := 0;
  end;

  procedure ZerarVariaveisTotais(pNatureza: string; pTipo: string);
  begin
    if (pNatureza = 'E') and (pTipo = 'CFOP') then
    begin
      vlcontabilE := 0;
      base_calcE := 0;
      vlicmsE := 0;
      vlisentasE := 0;
      vloutrasE := 0;
      vlicmssubE := 0;

    end
    else if (pNatureza = 'S') and (pTipo = 'CFOP') then
    begin
      vlcontabilS := 0;
      base_calcS := 0;
      vlicmsS := 0;
      vlisentasS := 0;
      vloutrasS := 0;
      vlicmssubS := 0;
    end;
    vCFOP := '';
    vUF := '';
  end;

  procedure IniciarVariaveis;
  begin
    ZerarVariaveis;
    vpag := 0;
    vlicmsApagar := 0;
    vlicmsTrans := 0;

    vlcontabilD := 0;
    base_calcICMSD := 0;
    vlicmsD := 0;
    vldescontoD := 0;
    vlicmssubS := 0;
    vlisentosD := 0;
    vloutrasD := 0;

    vlcontabilE := 0;
    vlcontabilS := 0;
    vlcontabil1t := 0;
    vlcontabil2t := 0;
    vlcontabil3t := 0;
    base_calc1t := 0;
    base_calc2t := 0;
    base_calc3t := 0;
    vlicms1t := 0;
    vlicms2t := 0;
    vlicms3t := 0;
    vldesconto := 0;
    vldescontot := 0;
    vlipitot := 0;

    vlBaseCliContr := 0;
    vlBaseCliNContr := 0;
    vlContabilContr := 0;
    vlContabilNContr := 0;

    ZerarVariaveisTotais('E', 'CFOP');
    ZerarVariaveisTotais('S', 'CFOP');
  end;

  procedure FonteRelatorio;
  begin
    if (trim(dtSetApuracaoTemp.FieldByName('NATUREZA').AsString) = 'E') then
    begin
      Rdp.ImpF(linha, 1, 'COD. FISCAL', [comp17, negrito]);
      Rdp.ImpD(linha, 36, 'CONTABIL', [comp17, negrito]);
      Rdp.ImpD(linha, 64, 'BASE CALC.', [comp17, negrito]);
      Rdp.ImpD(linha, 92, 'VALOR ICMS', [comp17, negrito]);
      Rdp.ImpD(linha, 120, 'ISENTAS/N.TRIB', [comp17, negrito]);
      Rdp.ImpD(linha, 148, 'OUTRAS', [comp17, negrito]);
    end
    else
    begin
      Rdp.ImpF(linha, 1, 'COD. FISCAL', [comp17, negrito]);
      Rdp.ImpD(linha, 33, 'CONTABIL', [comp17, negrito]);
      Rdp.ImpD(linha, 56, 'BASE CALC.', [comp17, negrito]);
      Rdp.ImpD(linha, 81, 'VALOR ICMS', [comp17, negrito]);
      Rdp.ImpD(linha, 107, 'ISENTAS/N.TRIB', [comp17, negrito]);
      Rdp.ImpD(linha, 125, 'OUTRAS', [comp17, negrito]);
      Rdp.ImpD(linha, 148, 'SUB. TRIBUTARIA', [comp17, negrito]);
    end;
  end;

  procedure ApuracaoTotal;
  begin
    if ((OutrosCreditos + vlicmsE + SAnterior) > (OutrosDebitos + vlicmsS)) then
      vlicmsTrans := (OutrosCreditos + vlicmsE + SAnterior) - (OutrosDebitos + vlicmsS)
    else
      vlicmsApagar := (OutrosDebitos + vlicmsS) - (OutrosCreditos + vlicmsE + SAnterior);

    CabNovaPagina;
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'Anterior...........', [negrito]);
    Rdp.ImpD(linha, 36, format('%6.2f', [SAnterior]), [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Credito............', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [vlicmsE]) + '  CR', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Outros Creditos....', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [OutrosCreditos]) + '  CR', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Totais Credito.....', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [OutrosCreditos + vlicmsE + SAnterior]) + '  CR', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Debito.............', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [vlicmsS]) + '  DB', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Outros Debitos.....', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [OutrosDebitos]) + '  DB', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Totais Debito......', [comp17, negrito]);
    Rdp.ImpD(linha, 40, format('%6.2f', [OutrosDebitos + vlicmsS]) + '  DB', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'Icms a Transportar.', [comp17, negrito]);
    if vlicmsTrans > 0 then
      Rdp.ImpD(linha, 40, format('%6.2f', [vlicmsTrans]) + '  CR', [comp17, negrito])
    else
