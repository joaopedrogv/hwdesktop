function TRelatorioVendasPorVendedorAcrescCondPagVend.ImprimeDevolucao(pcodVendedor: integer; vDescriFuncao: string): boolean;
var
	ConfigImp: TConfig_sistema_class;
  vRelUsarValorLiquidoBruto: string;
	vvalor: Double;
begin
	try
  	ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscasGerais, vDadosIni.cod_empresa);

    try
      vRelUsarValorLiquidoBruto := UpperCase(trim(ConfigImp.ReadString('Configuracao', 'RelUsarValorLiquidoBruto')));
    except
      vRelUsarValorLiquidoBruto := 'BRUTO';
    end;

    buscasGerais.Close;
    buscasGerais.SQL.text := ' select vp.cod_vendedor, ' +
      ' vp.data_fech as data, vp.quant_ped_item as quant, vp.grupo_prod, ' +
      ' vp.cod_prod, vp.descr_prod_ped as descricao, ' +
      ' coalesce(vp.vlun_orig, 0) as vlun_orig, ' +
      ' coalesce(vp.vlun_ped_item, 0) as vlun_ped_item, ' +
      ' coalesce(vp.vltot_ped_item, 0) as vltot_ped_item, ';

    if UpperCase(trim(vRelUsarValorLiquidoBruto)) = 'ACRESC_BRUTO_DESC_LIQUIDO' then
    	buscasGerais.SQL.text := buscasGerais.SQL.text +
        ' coalesce(vp.comiss_prod_brut_liq, 0) as comiss_prod, ' +
        ' coalesce(vp.comiss_prod_ger_brut_liq, 0) as comiss_prod_ger, '
    else if UpperCase(trim(vRelUsarValorLiquidoBruto)) = 'LIQUIDO_MENOS_CONDPAG' then
      buscasGerais.SQL.text := buscasGerais.SQL.text +
        ' coalesce(vp.comiss_prod_liq_c, 0) as comiss_prod, ' +
        ' coalesce(vp.comiss_prod_ger_liq_c, 0) as comiss_prod_ger, '
    else if UpperCase(trim(vRelUsarValorLiquidoBruto)) = 'LIQUIDO_MENOS_VEND_CONDPAG' then
      buscasGerais.SQL.text := buscasGerais.SQL.text +
        ' coalesce(vp.comiss_prod_liq_v_c, 0) as comiss_prod, ' +
        ' coalesce(vp.comiss_prod_ger_liq_v_c, 0) as comiss_prod_ger, '
    else if UpperCase(trim(vRelUsarValorLiquidoBruto)) = 'LIQUIDO' then
      buscasGerais.SQL.text := buscasGerais.SQL.text +
        ' coalesce(vp.comiss_prod_liq, 0) as comiss_prod, ' +
        ' coalesce(vp.comiss_prod_ger_liq, 0) as comiss_prod_ger, '
    else
    	buscasGerais.SQL.text := buscasGerais.SQL.text +
        ' coalesce(vp.comiss_prod, 0) as comiss_prod, ' +
        ' coalesce(vp.comiss_prod_ger, 0) as comiss_prod_ger, ';

    buscasGerais.SQL.text := buscasGerais.SQL.text +
      ' vp.tipo, vp.nped as sequencia from vendaprodutos_ac_pag_vnd vp ';
    if FiltrarAreaExec then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
      ' inner join tipo_vendas tp on tp.tipo = vp.tipo and (tp.sigla = vp.tipv or (tp.tipo_os = vp.tipo_os)) ';

    buscasGerais.SQL.text := buscasGerais.SQL.text +
      ' where vp.data_fech >= :dti ' +
      ' and vp.data_fech <= :dtf ' +
      ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and vp.tipo = ''DEV'' ';

    if FiltrarTipoVenda and FiltrarTipoOS then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' )' +
        ' 	or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ')) '
    else if FiltrarTipoVenda then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ') ' +
        ' 	or (not vp.TIPO_OS is null and vp.venda = ''S'') )'
    else if FiltrarTipoOS then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' and ((not vp.TIPV is null and vp.venda = ''S'')' +
        ' 	or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + '))'
    else
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' and vp.venda = ''S'' ';

    if FiltrarAreaExec then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
      ' and ((vp.tipo = ''OS'' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (vp.tipo <> ''OS'')) ';

    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.cod_vendedor = ' + inttostr(pCodVendedor);
    buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
    buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
    buscasGerais.Open;
    buscasGerais.FetchAll;

    while not buscasGerais.eof do
    begin
      Rdp.ImpD(linha, 8, buscasGerais.FieldByName('COD_VENDEDOR').AsString {vDadosIni.StrZero(Buscas.FieldByName('N_NF').AsInteger, 8)}, [comp17]);
      Rdp.Imp(linha, 12, buscasGerais.FieldByName('DATA').asstring);
      Rdp.ImpD(linha, 28, Floattostr(buscasGerais.FieldByName('quant').AsCurrency {* (-1)}), [comp17]);
      Rdp.ImpD(linha, 37, buscasGerais.FieldByName('GRUPO_PROD').asstring, [comp17]);
      Rdp.ImpF(linha, 38, trim(buscasGerais.FieldByName('cod_Prod').asstring), [comp17]);
      Rdp.ImpF(linha, 45, Copy(trim(buscasGerais.FieldByName('descricao').AsString), 1, 32), [comp17]);

      if (TipoRelatorio = 'ANALÍTICO') and (ExibirValorBruto = 'SIM') then
      begin
        Rdp.ImpD(linha, 91, format('%n', [buscasGerais.FieldByName('vlun_orig').AsCurrency {* (-1)}]), [comp17]);
        Rdp.ImpD(linha, 108, format('%n', [buscasGerais.FieldByName('vlun_ped_item').AsCurrency {* (-1)}]), [comp17]);
        Rdp.ImpD(linha, 125, format('%n', [(buscasGerais.FieldByName('vlun_orig').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);
        Rdp.ImpD(linha, 142, format('%n', [(buscasGerais.FieldByName('vlun_ped_item').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);

        Rdp.ImpD(linha, 152, format('%n', [buscasGerais.FieldByName('comiss_prod').AsCurrency {* (-1)}]), [comp17]);

        Rdp.ImpD(linha, 162, 'DEV', [comp17]);
        Rdp.ImpD(linha, 170, vDadosIni.StrZero(buscasGerais.FieldByName('sequencia').AsInteger, 6), [comp17]);
      end
      else
      begin
        Rdp.ImpD(linha, 86, format('%n', [buscasGerais.FieldByName('vlun_ped_item').AsCurrency {* (-1)}]), [comp17]);
        Rdp.ImpD(linha, 103, format('%n', [(buscasGerais.FieldByName('vlun_ped_item').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);

        Rdp.ImpD(linha, 113, format('%n', [buscasGerais.FieldByName('comiss_prod').AsCurrency {* (-1)}]), [comp17]);

        Rdp.ImpD(linha, 124, 'DEV', [comp17]);
        Rdp.ImpD(linha, 132, vDadosIni.StrZero(buscasGerais.FieldByName('sequencia').AsInteger, 6), [comp17]);
      end;
      linha := linha + 1;
      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
        linha := 2;
        CabNovaPagina;
        if TipoRelatorio = 'ANALÍTICO' then
          MenuAnalitico;
      end;
      buscasGerais.next;
    end;
    buscasGerais.close;
    result := true;
  finally
  	if Assigned(ConfigImp) then
      FreeAndNil(ConfigImp);
  end;
end;

