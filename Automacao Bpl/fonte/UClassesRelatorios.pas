  if not vDadosIni.PesqPros('REL005', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not RelVendasOficina then
  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
  end;

  vpag := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  if (TotalProduto = 'SIM') or (TotalGrupo = 'SIM') then
    Rdp.TamanhoQteColunas := 150
  else
    Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Vendas e Faturamento de Produtos - Ordem de Serviço';
  rdp.TitulodoRelatorio := 'Vendas e Faturamento de Produtos - OS';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  CabNovaPagina; //cabeçalho

  // Inicio da Impressão dos Itens.
  if TipoRelatorio = 'ANALÍTICO' then
  begin
    MenuAnalitico;
    try
      Screen.Cursor := crHourGlass;
      variavel_parar := false;
      buscas.FetchAll;
    finally
      Screen.Cursor := crDefault;
      frmRelatorios.ProgressBar.Position := 0;
      frmRelatorios.ProgressBar.Min := 0;
      frmRelatorios.ProgressBar.Max := buscas.RecordCount;
      buscas.First;
    end;

    while not buscas.eof do
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end;
      end;
      try
        Rdp.Imp(linha, 1, Buscas.FieldByName('grupo_Prod').asstring);
        Rdp.ImpD(linha, 13, trim(Buscas.FieldByName('cod_Prod').asstring), [comp17]);
{        Rdp.Imp(linha, 14, Copy(Buscas.FieldByName('descr_prod_ped').AsString, 1, 37));
        Rdp.Imp(linha, 55, Buscas.FieldByName('nped').AsString);
        Rdp.ImpD(linha, 78, format('%n', [Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 94, format('%n', [Buscas.FieldByName('pcust_mc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 105, Format('%n', [Buscas.FieldByName('quant_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 119, format('%n', [Buscas.FieldByName('lucro').AsCurrency]), [comp17]);
}
        Rdp.Imp(linha, 14, Copy(Buscas.FieldByName('descr_prod_ped').AsString, 1, 35));
        Rdp.ImpD(linha, 59, Buscas.FieldByName('nped').AsString, [comp17]);
        Rdp.ImpD(linha, 72, format('%f', [Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 86, format('%f', [Buscas.FieldByName('pcust_mc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 95, Format('%f', [Buscas.FieldByName('quant_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 110, Format('%f', [Buscas.FieldByName('quant_ped_item').AsCurrency * Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);

        if pos('GERENTE', Buscas.FieldByName('desc_funcao').asString) > 0 then
          Rdp.ImpD(linha, 132, format('%n', [Buscas.FieldByName('comiss_prod_ger').AsCurrency]), [comp17]) //;// [comp17]);
        else
          Rdp.ImpD(linha, 132, format('%n', [Buscas.FieldByName('comiss_prod').AsCurrency]), [comp17]);
        linha := linha + 1;
      except
      end;
      buscas.Next;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := 2;
        CabNovaPagina;
        MenuAnalitico;
      end;
    end;
  end;

  //Impressão dos dados gerais
  Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DADOS GERAIS', [normal, negrito]);
