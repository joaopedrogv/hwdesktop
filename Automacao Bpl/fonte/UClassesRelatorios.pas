procedure TRelatorioVendaProdutosBalcaoParticipante.CabNovaPagina;
begin
 //  if Rdp.UltimaPagina > 1 then
  if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO DE VENDAS/FATURAMENTO DE PRODUTOS', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DADOS BALCAO', [normal, negrito]);
  linha := linha + 1;
  if FiltrarTipoVenda then
    Rdp.ImpF(linha, 1, trim(dtSetTipVenda.FieldByName('DESCRICAO').AsString), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'TODOS OS TIPOS DE VENDA', [normal, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  
  if FiltrarVendedor then
  begin
    linha := linha + 1;
    if trim(Vendedor) = '0' then
    	Rdp.ImpF(linha, 1, Copy(UpperCase(vDadosIni.vPedVnd.descricaoParticipante) + ': SEM ' + UpperCase(vDadosIni.vPedVnd.descricaoParticipante), 1, 78), [normal, negrito])
    else
    	Rdp.ImpF(linha, 1, Copy(UpperCase(vDadosIni.vPedVnd.descricaoParticipante) + ': ' + trim(Vendedor), 1, 78), [normal, negrito]);
  end
  else
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, UpperCase(vDadosIni.vPedVnd.descricaoParticipante) + ':TODOS', [normal, negrito]);
  end;

  vpag := vpag + 1;
