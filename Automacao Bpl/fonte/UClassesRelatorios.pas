procedure TRelatorioSituacaodoEstoqueFechado.ImprimeRelatorios;
var
 vReserva: boolean;
begin
  if not vDadosIni.PesqPros('REL029', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Situação do Estoque Fechado';
  rdp.TitulodoRelatorio := 'Situação do Estoque Fechado';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  abreSituacaodoEstoqueFechado;
//  if buscas.IsEmpty then
//  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
//  end;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;
  vquant := 0;
  vpag := 0;
  pCodVend := 0;
  vReserva := false;
  CabNovaPagina; //cabeçalho
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
       if confirmaparar then
       begin
//        Parar;
         Exit;
      end;
    end;
    if (buscas.FieldByName('COD_VENDEDOR').AsInteger <> pCodVend) then
    begin
     Imprimecabecalho;
     vReserva := false;
    end;
    if not vReserva then
    begin
      vReserva := trim(buscas.FieldByName('TIPO').AsString) = 'RES';
      if vReserva then
      begin
        if (buscas.FieldByName('COD_VENDEDOR').AsInteger = pCodVend) then
         Inc(linha);
        Rdp.imp(linha, 1, 'RESERVADOS (AGUARDANDO CHEGADA):');
        linha := linha + 2;
      end;
    end;

    Rdp.imp(linha, 1, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DATA_PEDIDO').AsDateTime));
    Rdp.imp(linha, 12, Copy(Trim(buscas.FieldByName('NUM_FAB_PROD').AsString), 1, 13));
    Rdp.imp(linha, 26, copy(Trim(buscas.FieldByName('DESCR_PROD').asstring), 1, 60));
    Rdp.imp(linha, 88, Trim(buscas.FieldByName('NDOC').asstring));
    Rdp.imp(linha, 95, Trim(buscas.FieldByName('TPDOC').asstring));
    Rdp.imp(linha, 99, vDadosIni.AlnDir(Trim(format('%12.2f', [buscas.FieldByName('quant').AsFloat])), 8));
    Rdp.imp(linha, 110, Trim(buscas.fieldbyname('LOCACAO_PROD').asstring));
    Rdp.imp(linha, 119, Trim(buscas.fieldbyname('LOCACAO_PROD_1').asstring));
    Rdp.imp(linha, 128, Trim(buscas.FieldByName('SIT_ATD').AsString));
    pCodVend := buscas.FieldByName('COD_VENDEDOR').AsInteger;
    vquant := vquant + buscas.FieldByName('quant').AsFloat;
    inc(linha);
    buscas.next;
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
    if linha >= 58 then
    begin
//     Rdp.ImpF(linha,1, vDadosIni.Replicate('=',132),[comp17]);
     linha := 2;
     CabNovaPagina;
     linha:=linha+1;
    end;
  end;
  Rdp.imp(linha, 1, vDadosIni.Replicate('-', 132));
  linha:=linha+1;
  buscas1.Close;
  buscas1.SQL.Text := 'select NOME_VENDEDOR from COLABORADOR'
   + ' where COD_VENDEDOR = ' + IntToStr(pCodVend)
   + ' and cod_empresa = ' + vDadosIni.CodEmpresa + ' and ativo=1 ';
  buscas1.Open;
  Rdp.ImpF(linha, 1, 'TOTAL DO VENDEDOR: ' + UpperCase(trim(buscas1.FieldByName('NOME_VENDEDOR').AsString)), [comp17, negrito]);
  Rdp.impF(linha, 99, vDadosIni.AlnDir(trim(format('%12.2f', [vquant])), 8), [comp17, negrito]);
  linha:=linha+2;
  Rdp.ImpF(linha,1, vDadosIni.Replicate('=',132),[comp17]);
  Rdp.Fechar;
  buscas.close;
  buscas1.close;
  vDadosIni.GravaAuditoria('REL029', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

