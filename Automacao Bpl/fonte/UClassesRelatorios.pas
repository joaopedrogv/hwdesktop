   if (Pos('AMBOS', Listar) > 0) or (UpperCase(trim(Listar)) = UpperCase(trim(vDadosIni.vPedVnd.descricaoParticipante))) then
   begin
     inc(linha);
     Rdp.ImpF(linha, 1, 'Total de ' + vDadosIni.vPedVnd.descricaoParticipante + ':  ', []);
     Rdp.ImpD(linha, 45, Format('%m', [vlComissPart]), []);
   end;
 end;
 if (Pos('AMBOS', Listar) > 0) then
 begin
   inc(linha);
   Rdp.ImpF(linha, 1, 'Total de Comissões:  ', [Negrito]);
   Rdp.ImpD(linha, 45, Format('%m', [vlComiss]), [Negrito]);
 end;

 if linha >= 57 then
 begin
   linha := 2;
   CabNovaPagina;
 end;

 vtotvend := 0;
 vtotpart := 0;
 if (Pos('AMBOS', Listar) > 0) or (UpperCase(trim(Listar)) = 'VENDEDOR') then
 begin
   fParcelas.Filtered := false;
   fParcelas.Filter := 'tipo = 1 ';
   fParcelas.Filtered := true;
   fParcelas.IndexFieldNames := 'tipo;nome_vendedor';
   inc(linha);
   inc(linha);
   Rdp.ImpF(linha, 1, 'Comissões por vencimento: ' + FormatDateTime('dd/mm/yyyy', datainicial) + ' até ' + FormatDateTime('dd/mm/yyyy', datafinal), [negrito]);
   inc(linha);
   fParcelas.First;
   while not fParcelas.Eof do
   begin
     inc(linha);
     vtotvend := vtotvend + RoundTo(fParcelas.FieldByName('comissao_vend').AsFloat, -2);
     Rdp.ImpF(linha, 1, Copy('Vendedor: ' + trim(fParcelas.FieldByName('nome_vendedor').AsString), 1, 63), []);
     Rdp.ImpD(linha, 65, Format('%m', [RoundTo(fParcelas.FieldByName('comissao_vend').AsFloat, -2)]), []);

     fParcelas.Next;

     if linha >= 60 then
     begin
       linha := 2;
       CabNovaPagina;
     end;
   end;

   // Total vendedor
   if linha >= 60 then
   begin
     linha := 2;
     CabNovaPagina;
   end;
   inc(linha);
   Rdp.ImpF(linha, 1, 'Total Vendedor', [negrito]);
   Rdp.ImpD(linha, 65, Format('%m', [vtotvend]), [negrito]);

   if linha >= 57 then
   begin
     linha := 2;
     CabNovaPagina;
   end;
 end;

 if (Pos('AMBOS', Listar) > 0) or (UpperCase(trim(Listar)) = UpperCase(trim(vDadosIni.vPedVnd.descricaoParticipante))) then
 begin
   if vDadosIni.vPedVnd.habPartipante then
   begin
     fParcelas.Filtered := false;
     fParcelas.Filter := 'tipo = 2 ';
     fParcelas.Filtered := true;
