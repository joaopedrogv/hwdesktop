  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  vpag := vpag + 1;
  Rdp.ImpF(linha, 80, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  linha := linha + 2;
end;

constructor TRelatorioComprasPorPeriodo.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas2 := TIBQuery(dtmRelatorios.qrbuscas2);

  fTempTotalCFOP := TClientDataSet.Create(nil);
  fTempTotalCFOP.Close;
  fTempTotalCFOP.FieldDefs.Clear;
  fTempTotalCFOP.FieldDefs.Add('CFOP', ftString, 10, false);
  fTempTotalCFOP.FieldDefs.Add('VALOR', ftFloat, 0, false);

  if fTempTotalCFOP.Tag = 0 then
  try
    fTempTotalCFOP.CreateDataSet;
    fTempTotalCFOP.Tag := 1;
  except
  end;
end;

procedure TRelatorioComprasPorPeriodo.ImprimeRelatorios;
var
  vCodNF, vCodNF2, vCodNF_AgrupaFornec: integer;
  vCodNfGrade, vNItemGrade: integer;
begin

  if not vDadosIni.PesqPros('REL010', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not SelecionaComprasPorPeriodo then
  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
  end;

  fTempTotalCFOP.EmptyDataSet;
  vpag := 0;
  vdesconto := 0;
  vComissaoF := 0;
  vComissaoG := 0;
  vMargemLucro := 0;
  vMargemLucroTemp := 0;
  vQuantOS := 0;
  vQuantRequisicao := 0;

  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;

  if (TipoRelatorio = 'ANALÍTICO') and (ListarProdutos = 'SIM') then
  	Rdp.TamanhoQteColunas := 150
  else
  	Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de Compras por Período';
  rdp.TitulodoRelatorio := 'Compras de produtos por periodo';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  CabNovaPagina; //cabeçalho
  Menu;

  // Inicio da Impressão dos Itens.

  vTotalItemNF := 0.00;
  vTotalNF := 0.00;
  vTotalFornec := 0.00;
  buscas.First;
  vFornec := trim(buscas.FieldByName('Nome_cliente').AsString);
  vCodNF := 0; 
  vCodNF2 := buscas.FieldByName('cod_nf').AsInteger;
  
  vCodNF_AgrupaFornec := 0;
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;

    fTempTotalCFOP.Filtered := false;
    fTempTotalCFOP.Filter := 'CFOP = ' + QuotedStr(trim(buscas.FieldByName('CODIGO_NOP_ITEM').AsString));
    fTempTotalCFOP.Filtered := true;

    if fTempTotalCFOP.IsEmpty then
    begin
    	fTempTotalCFOP.Insert;
      fTempTotalCFOP.FieldByName('CFOP').AsString := trim(buscas.FieldByName('CODIGO_NOP_ITEM').AsString);
      fTempTotalCFOP.FieldByName('VALOR').AsCurrency :=
      	(buscas.FieldByName('QUANTIDADE').AsCurrency * buscas.FieldByName('PREC_CUS_CNT').AsCurrency);
    	fTempTotalCFOP.Post;
    end
    else
    begin
    	fTempTotalCFOP.Edit;
      fTempTotalCFOP.FieldByName('VALOR').AsCurrency := fTempTotalCFOP.FieldByName('VALOR').AsCurrency +
      	(buscas.FieldByName('QUANTIDADE').AsCurrency * buscas.FieldByName('PREC_CUS_CNT').AsCurrency);
    	fTempTotalCFOP.Post;
    end;
    fTempTotalCFOP.Filtered := false;


    if TipoRelatorio = 'ANALÍTICO' then
    begin
      if ListarProdutos = 'SIM' then
      begin
        if not ((vCodNfGrade = buscas.FieldByName('cod_nf').AsInteger) and (vNItemGrade = buscas.FieldByName('nitem').AsInteger)) then
        begin
          Rdp.Imp(linha, 1, buscas.FieldByName('data_lanc').AsString);
          Rdp.ImpD(linha, 25, buscas.FieldByName('grupo_prod').AsString + ' ' + buscas.FieldByName('cod_prod').AsString, [comp17]);
          Rdp.Imp(linha, 27, copy(buscas.FieldByName('descricao_item').AsString, 1, 32));
          Rdp.ImpD(linha, 67, format('%n', [buscas.FieldByName('quantidade').AsCurrency]), [comp17]);
          Rdp.ImpD(linha, 79, format('%n', [buscas.FieldByName('estoque').AsCurrency]), [comp17]);
          Rdp.ImpD(linha, 87, vDadosIni.strzero(buscas.FieldByName('num_nf').AsString, 6), [comp17]);
          Rdp.ImpD(linha, 92, buscas.FieldByName('codigo_nop_item').AsString, [comp17]);
          Rdp.ImpD(linha, 105, format('%n', [buscas.FieldByName('valor_unitario').AsCurrency]), [comp17]);
          Rdp.ImpD(linha, 117, format('%n', [buscas.FieldByName('quantidade').AsCurrency * buscas.FieldByName('prec_cus_cnt').AsCurrency]), [comp17]);
          Rdp.ImpF(linha, 118, copy(buscas.FieldByName('nome_cliente').AsString, 1, 32), [comp17]);
        end;

        if trim(ComGrade) = 'SIM' then
        begin
          if buscas.FieldByName('cod_grade').AsInteger > 0 then
          begin
            if not ((vCodNfGrade = buscas.FieldByName('cod_nf').AsInteger) and (vNItemGrade = buscas.FieldByName('nitem').AsInteger)) then
             linha := linha + 1;
            Rdp.ImpD(linha, 38, (trim(buscas.FieldByName('cod_grade').AsString) + ' - ' + copy(trim(buscas.FieldByName('descr_grade').AsString), 1, 32)), [comp20]);
            Rdp.ImpD(linha, 66, format('%n', [buscas.FieldByName('qtde_grade').AsCurrency]), [comp20]);
          end;
        end;
        vCodNfGrade := buscas.FieldByName('cod_nf').AsInteger;
        vNItemGrade := buscas.FieldByName('nitem').AsInteger;
      end
      else
      begin
        if vCodNF_AgrupaFornec <> buscas.FieldByName('cod_nf').AsInteger then
        begin
          Rdp.Imp(linha, 2, buscas.FieldByName('data_lanc').AsString);
          Rdp.Imp(linha, 15, vDadosIni.strzero(buscas.FieldByName('num_nf').AsString, 6));
          Rdp.ImpD(linha, 38, format('%n', [buscas.FieldByName('valor_total').AsCurrency]), [comp17]);
          Rdp.Imp(linha, 49, buscas.FieldByName('serie').AsString);
          Rdp.Imp(linha, 56, copy(buscas.FieldByName('nome_cliente').AsString, 1, 30));
          Rdp.Imp(linha, 90, vDadosIni.alndir(buscas.FieldByName('codigo_nop').AsString, 4));
          vCodNF_AgrupaFornec := buscas.FieldByName('cod_nf').AsInteger;
        end
        else
        	linha := linha - 1;
      end;
    end;

    if AgrupaNF = 'SIM' then
    begin
     	vTotalItemNF := vTotalItemNF + buscas.FieldByName('quantidade').AsCurrency * buscas.FieldByName('prec_cus_cnt').AsCurrency;
    	vTotalNF := vTotalNF + buscas.FieldByName('valor_total').AsCurrency;
    end;

    if AgrupaFornec = 'SIM' then
    begin
    	if vCodNF <> buscas.FieldByName('cod_nf').AsInteger then
        vTotalFornec := vTotalFornec + buscas.FieldByName('valor_total').AsCurrency;
      vCodNF := buscas.FieldByName('cod_nf').AsInteger;
    end;

    if TipoRelatorio = 'ANALÍTICO' then
      linha := linha + 1;
    if linha >= 60 then
    begin
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
      linha := 2;
      Rdp.Novapagina;
      CabNovaPagina;
      Menu;
    end;

    buscas.Next;
    if (ListarProdutos = 'SIM') then
    begin
    	if (AgrupaNF = 'SIM') then
        if (vCodNF2 <> buscas.FieldByName('cod_nf').AsInteger) or (buscas.eof) then
        begin
//        	Rdp.ImpF(linha, 1, 'VALOR NF :', [comp17, negrito]);
//          Rdp.ImpD(linha, 25, format('%n', [vTotalItemNF]), [comp17, negrito]);
          Rdp.ImpD(linha, 117, format('%n', [vTotalItemNF]), [comp17, negrito]);
          linha := linha + 2;
          vCodNF2 := buscas.FieldByName('cod_nf').AsInteger;
          vTotalItemNF := 0;
          vTotalNF := 0;
        end;

      if (AgrupaFornec = 'SIM') then
        if (vFornec <> trim(buscas.FieldByName('Nome_cliente').AsString)) or (buscas.eof) then
        begin
          Rdp.ImpF(linha, 1, 'VALOR DO FORNECEDOR :' + vFornec, [comp17, negrito]);
          Rdp.ImpD(linha, 117, format('%n', [vTotalFornec]), [comp17, negrito]);
          linha := linha + 2;
          vFornec := trim(buscas.FieldByName('Nome_cliente').AsString);
          vTotalFornec := 0.00;
        end;
    end
    else if (ListarProdutos <> 'SIM') then
    begin
    	if (AgrupaFornec = 'SIM') then
        if (vFornec <> trim(buscas.FieldByName('Nome_cliente').AsString)) or (buscas.eof) then
        begin
        	if TipoRelatorio = 'ANALÍTICO' then
          begin
            Rdp.ImpF(linha, 1, 'VALOR DO FORNECEDOR :', [comp17, negrito]);
            Rdp.ImpD(linha, 38, format('%n', [vTotalFornec]), [comp17, negrito]);
          end
          else
          begin
          	Rdp.ImpF(linha, 1, 'VALOR DO FORNECEDOR :' + vFornec, [comp17, negrito]);
          	Rdp.ImpD(linha, 117, format('%n', [vTotalFornec]), [comp17, negrito]);
          end;
          linha := linha + 2;
          vFornec := trim(buscas.FieldByName('Nome_cliente').AsString);
          vTotalFornec := 0.00;
        end;
    end;


    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
  end;

  if (TotalPorCFOP = 'SIM') then
  begin
    fTempTotalCFOP.IndexFieldNames := 'CFOP';

    if not fTempTotalCFOP.IsEmpty then
    	linha := linha + 1;

    fTempTotalCFOP.First;
		while not fTempTotalCFOP.Eof do
    begin
      Rdp.ImpF(linha, 1, 'TOTAL CFOP ' + trim(fTempTotalCFOP.FieldByName('CFOP').AsString) + '.........................:', [normal, negrito]);
      Rdp.ImpD(linha, 85, format('%n', [fTempTotalCFOP.FieldByName('VALOR').AsFloat]), [comp17, negrito]);
      linha := linha + 1;

      fTempTotalCFOP.Next;
    end;
  end;


  MenuTotais;

  linha := linha + 1;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  //    buscas.SQL.Clear;

  vDadosIni.GravaAuditoria('REL010', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

{
procedure TRelatorioComprasPorPeriodo.ImprimeRelatorios;
begin
  with dtmRelatorios do
  begin

    if not SelecionaComprasPorPeriodo then
    begin
      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
      exit;
    end;

    frmRelatorios.ProgressBar.max := qrBuscas.RecordCount;
    frmRelatorios.ProgressBar.min := 0;
    frmRelatorios.ProgressBar.position := 0;

    vValortotal := 0;
    vdesconto := 0;
    vCustContabil := 0;
    vComissaoF := 0;
    vComissaoG := 0;
    vMargemLucro := 0;
    vMargemLucroTemp := 0;
    vQuantOS := 0;
    vQuantRequisicao := 0;

    qrBuscas.First;
    while not qrBuscas.Eof do
    begin

      vcustContabil := vcustContabil + (qrBuscas.FieldByName('quantidade').AsCurrency * qrBuscas.FieldByName('prec_cus_prod').AsCurrency);
      vvalortotal := vvalortotal + (qrBuscas.FieldByName('valor_total').AsCurrency - qrBuscas.FieldByName('soma').AsCurrency);

      qrBuscas.Next;
    end;

    //Inicia a Impressão.
    vDadosIni.ModImp(Frdp1);
    FRdp1.FonteTamanhoPadrao := S20cpp;
    FRdp1.TamanhoQteColunas := 160;
    Frdp1.Abrir;
    linha := 1;

    CabNovaPagina; //cabeçalho
    Menu;

    // Inicio da Impressão dos Itens.

    vTotalFornec := 0.00;
    vFornec := qrBuscas.FieldByName('cod_cliente').AsString;

    qrBuscas.First;
    while not qrBuscas.eof do
    begin
      Application.ProcessMessages;
      if variavel_parar = 1 then
      begin
        Parar;
        Exit;
      end;

      if FImpProduto = 'Sim' then
      begin
        FRdp1.Imp(linha, 2, qrBuscas.FieldByName('data_lanc').AsString);
        FRdp1.Imp(linha, 14, qrBuscas.FieldByName('grupo_prod').AsString + ' ' + qrBuscas.FieldByName('cod_prod').AsString);
        FRdp1.Imp(linha, 30, copy(qrBuscas.FieldByName('descricao_item').AsString, 1, 38));
        FRdp1.Imp(linha, 69, vDadosIni.AlnDir(format('%n', [qrBuscas.FieldByName('quantidade').AsCurrency]), 10));
        FRdp1.Imp(linha, 80, vDadosIni.AlnDir(format('%n', [qrBuscas.FieldByName('estoque').AsCurrency]), 12));
        FRdp1.Imp(linha, 95, vDadosIni.strzero(qrBuscas.FieldByName('num_nf').AsString, 6));
        FRdp1.Imp(linha, 102, vDadosIni.AlnDir(format('%n', [qrBuscas.FieldByName('valor_unitario').AsCurrency]), 12));
        FRdp1.Imp(linha, 116, vDadosIni.alndir(format('%n', [qrBuscas.FieldByName('prec_cus_med').AsCurrency]), 12));
        FRdp1.Imp(linha, 130, copy(qrBuscas.FieldByName('nome_cliente').AsString, 1, 28));
      end
      else
      begin
        FRdp1.Imp(linha, 2, qrBuscas.FieldByName('data_lanc').AsString);
        FRdp1.Imp(linha, 15, vDadosIni.strzero(qrBuscas.FieldByName('num_nf').AsString, 6));
        FRdp1.Imp(linha, 26, vDadosIni.alndir(format('%n', [qrBuscas.FieldByName('valor_total').AsCurrency]), 12));
        FRdp1.Imp(linha, 49, qrBuscas.FieldByName('serie').AsString);
        FRdp1.Imp(linha, 56, copy(qrBuscas.FieldByName('nome_cliente').AsString, 1, 30));
        FRdp1.Imp(linha, 90, vDadosIni.alndir(qrBuscas.FieldByName('codigo_nop').AsString, 4));

        vTotalFornec := vTotalFornec + qrBuscas.FieldByName('valor_total').AsCurrency;
      end;

      linha := linha + 1;
      if linha >= 60 then
      begin
        FRdp1.Imp(linha, 1, vDadosIni.Replicate('=', 132));
        linha := 1;
        FRdp1.Novapagina;
        CabNovaPagina;
        Menu;
      end;

      qrBuscas.Next;
      if ImpProduto = 'Não' then
      begin
        if FAgrupaFornec = 'Sim' then
        begin
          if (vFornec <> qrBuscas.FieldByName('cod_cliente').AsString) or (qrBuscas.eof) then
          begin
            vFornec := qrBuscas.FieldByName('cod_cliente').AsString;
            //                linha := linha + 1;
            FRdp1.Imp(linha, 2, 'VALOR FORNECEDOR');
            FRdp1.Imp(linha, 26, vDadosIni.alndir(format('%n', [vTotalFornec]), 12));
            linha := linha + 2;
            vTotalFornec := 0.00;
          end;
        end;
      end;

      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;

    end;

    MenuTotais;

    linha := linha + 1;
    FRdp1.Fechar;
    qrBuscas.SQL.Clear;
    frmRelatorios.ProgressBar.position := 0;
  end;
end;

}

