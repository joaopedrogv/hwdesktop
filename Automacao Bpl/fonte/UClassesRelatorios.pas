    Rdp.ImpF(linha, 1, 'CLIENTE: ' + trim(dtSetCliente.FieldByName('NOME_CLIENTE').AsString), [normal, negrito]);
    linha := linha + 2;
  end;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
  if trim(TipoRelatorio) = 'ANALÍTICO' then
  begin
    Rdp.Imp(linha, 1, 'NUM DOC');
    Rdp.Imp(linha, 10, 'TIPO');
    Rdp.Imp(linha, 15, 'CLIENTE');
    Rdp.Imp(linha, 83, 'DOC FISCAL');
    Rdp.impD(linha, 107, 'VALOR VALE', []);
    Rdp.ImpD(linha, 121, 'VALOR DOC', []);
    Rdp.ImpD(linha, 132, 'DATA FECH', []);
