procedure TRelatorioOrdensDeServicosEmitidasPorPeriodo.ImprimeRelatorios;
var
  vtotl, vtoto, vtotp, vcort, vtotpT, vdesconto, vacrescimo: currency;
  vtotind: Double;
  vcond: string;
  it: Integer;
begin

  if not vDadosIni.PesqPros('REL018', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  abreOSsPorPeriodo;//if not abreOSsPorPeriodo then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S20cpp;
  Rdp.TamanhoQteColunas := 166;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'O.S. EMITIDAS POR PERIODO';
  rdp.TitulodoRelatorio := 'O.S. EMITIDAS POR PERIODO';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho

  it := 0;
  vtoto := 0.00;
  vtotp := 0.00;
  vtotl := 0.00;
  vcort := 0.0;
  vtotpT := 0.00;
  vdesconto := 0.00;
  vacrescimo := 0.00;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  vcond := trim(buscas.FieldByName('DESC_COND_PAG').AsString);
  Rdp.impc(linha, 1, '* * * * *' + trim(buscas.FieldByName('DESC_COND_PAG').AsString) + '* * * * *', [comp20, negrito]);
  linha := linha + 1;
  vtotind := 0;

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    if vDadosIni.vEmp.vUsarDAVOS = 'S' then
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('NPED').AsInteger, 6) + '/' + vDadosIni.strzero(buscas.FieldByName('NPREVENDA').AsInteger, 7))
    else
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('NPED').AsInteger, 6));
    Rdp.imp(linha, 16, buscas.FieldByName('PLACA').asstring);
    Rdp.imp(linha, 28, buscas.FieldByName('DATA_PED').asstring);
    Rdp.impD(linha, 50, format('%n', [buscas.FieldByName('TOT_PROD').AsFloat]), []);
    Rdp.impD(linha, 62, format('%n', [buscas.FieldByName('TOT_SERV').AsFloat + buscas.FieldByName('ServGarantia').AsFloat]), []);
    Rdp.impD(linha, 72, format('%n', [IfThen(buscas.FieldByName('desconto').AsFloat > 0,
    	 buscas.FieldByName('desconto').AsFloat, 0)]), []);
    Rdp.impD(linha, 83, format('%n', [IfThen(buscas.FieldByName('acrescimo').AsFloat > 0,
    	 buscas.FieldByName('acrescimo').AsFloat, 0)]), []);
    Rdp.impD(linha, 92, format('%n', [buscas.FieldByName('totalServT').AsFloat]), []);
    Rdp.impD(linha, 101, format('%n', [buscas.FieldByName('totalProdT').AsFloat]), []);
    Rdp.impD(linha, 110, format('%n', [buscas.FieldByName('ServGarantia').AsFloat]), []);
    Rdp.impD(linha, 123, format('%n', [buscas.FieldByName('valor_total').AsFloat + buscas.FieldByName('ServGarantia').AsFloat {+buscas.FieldByName('totalServT').AsFloat+buscas.FieldByName('totalProdT').AsFloat}]), []);
    Rdp.imp(linha, 125, buscas.FieldByName('DATA_FECH').asstring);
    Rdp.imp(linha, 136, buscas.FieldByName('TIPO_OS').asstring);
    if not FiltrarCliente then
	    Rdp.Imp(linha, 147, vDadosIni.IfThen(ExibirRazaoFantasia = 0,
      	Copy(trim(buscas.FieldByName('RAZAO').AsString), 1, 20),
      	Copy(trim(buscas.FieldByName('NOME_CLIENTE').AsString), 1, 20)) );
    vtoto := vtoto + buscas.FieldByName('TOT_SERV').AsFloat + buscas.FieldByName('ServGarantia').AsFloat;
    vtotp := vtotp + buscas.FieldByName('TOT_PROD').AsFloat;
    vcort := vcort + buscas.FieldByName('totalServT').AsFloat;
    vtotpT := vtotpT + buscas.FieldByName('totalProdT').AsFloat;
    vtotl := vtotl + buscas.FieldByName('valor_total').AsFloat + buscas.FieldByName('ServGarantia').AsFloat {+buscas.FieldByName('totalServT').AsFloat+buscas.FieldByName('totalProdT').AsFloat};
    vdesconto := vdesconto + IfThen(buscas.FieldByName('desconto').AsFloat > 0,
    	 buscas.FieldByName('desconto').AsFloat, 0);
    vacrescimo := vacrescimo + IfThen(buscas.FieldByName('acrescimo').AsFloat > 0,
    	 buscas.FieldByName('acrescimo').AsFloat, 0);
    it := it + 1;
    linha := linha + 1;
    if linha >= 60 then
      CabNovaPagina;
    vtotind := vtotind + buscas.FieldByName('VALOR_TOTAL').AsFloat;
    buscas.next;
    if buscas.eof then
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end;
      end;

      Rdp.impF(linha, 1, 'Total da Condicao:', [negrito]);
      Rdp.impD(linha, 123, format('%m', [vtotind]), [negrito]);
      linha := linha + 1;
      Rdp.Imp(linha, 1, vDadosIni.replicate('=', 166));
      linha := linha + 2;

//      linha := linha + 1;
//      Rdp.Imp(linha, 1, vDadosIni.replicate('=', 166));
//      linha := linha + 1;
    end;
    if vcond <> trim(buscas.FieldByName('DESC_COND_PAG').AsString) then
    begin
      Rdp.impF(linha, 1, 'Total da Condicao:', [negrito]);
      Rdp.impD(linha, 123, format('%m', [vtotind]), [negrito]);
      linha := linha + 2;
      vtotind := 0;
      vcond := trim(buscas.FieldByName('DESC_COND_PAG').AsString);
      Rdp.impc(linha, 1, '* * * * *  ' + trim(buscas.FieldByName('DESC_COND_PAG').AsString) + '  * * * * *', [comp20, negrito]);
      linha := linha + 1;
    end;
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;
  Rdp.impF(linha, 1, 'Quantidade OS...........:', [negrito]);
  Rdp.impD(linha, 40, vDadosIni.strzero(it, 6), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total M.O...............:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vtoto]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total M.O. Terceiro.....:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vcort]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Produtos..........:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vtotp]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Produtos Terceiro.:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vtotpT]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Desconto..........:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vdesconto]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Acrescimo..........:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vacrescimo]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Liquido...........:', [negrito]);
  Rdp.impD(linha, 40, format('%n', [vtotl]), [negrito]);
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL018', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.close;
  frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatorioListaDeAlteracaoDePreco }

function TRelatorioListaDeAlteracaoDePreco.abreProdutosAterados: Boolean;
begin
  try
    Result := False;
    //Entrada de notas emitidas por período
    buscas.Close;
    if pos('ENTRADA', LitadeAltPrecos) > 0 then
      buscas.SQL.Text := 'select nf4.data_lanc,nfi.grupo_prod,nfi.cod_prod,p.sub_g_prod,' +
        ' p.descr_prod,p.emb_prod,p.prec_tab_prod,sg.descricao from notafiscal nf4 ' +
        ' inner join notafiscal_item nfi on nf4.cod_nf=nfi.cod_nf and nf4.cod_empresa=nfi.cod_empresa ' +
        ' inner join Produtos p on nfi.grupo_prod=p.grupo_prod and nfi.cod_prod=p.cod_prod ' +
        ' and nfi.cod_empresa=p.cod_empresa ' +
        ' left join sub_grupo sg on p.sub_g_prod= sg.codigo_subgr ' +
        ' where nf4.data_lanc >= :dti and nf4.data_lanc <= :dtf and nf4.status =''Fechada'' ' +
        ' and nf4.natureza_nf=''E'' and nf4.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and nf4.ativo=1 order by p.sub_g_prod,p.descr_prod'
    else
      buscas.SQL.Text := 'select p.dat_mod_prod,p.grupo_prod,p.cod_prod,p.sub_g_prod, ' +
        ' p.descr_prod,p.emb_prod,p.prec_tab_prod,sg.descricao ' +
        ' from Produtos p left join sub_grupo sg on p.sub_g_prod= sg.codigo_subgr ' +
        ' where p.dat_mod_prod >= :dti and p.dat_mod_prod <= :dtf ' +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa + ' and p.ativo=1 ' +
        ' order by p.sub_g_prod,p.descr_prod';

    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;
end;

