  Rdp.ImpF(linha, 136, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 150), [comp17, negrito]);
