   fTempRec.Filtered := True;

   if fTempRec.IsEmpty then
   begin
     fTempRec.Insert;
     fTempRec.FieldByName('TIPO').AsString := 'P';

     if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'RECIBO' then
       fTempRec.FieldByName('CONTROLE').AsString := '* RECIBO (APENAS INFORMATIVO)'
     else if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'DEVOLUCAO' then
       fTempRec.FieldByName('CONTROLE').AsString := '* DEVOLUCAO (APENAS INFORMATIVO)'
     else
	     fTempRec.FieldByName('CONTROLE').AsString := trim(pBuscas.FieldByName('NOME_CTRL').AsString);
     if trim(pBuscas.FieldByName('NOME_CTRL').AsString) = 'CONTAS A PAGAR' then
       fTempRec.FieldByName('DOCS').AsString := 'N'
     else
       fTempRec.FieldByName('DOCS').AsString := pBuscas.FieldByName('DOCS').AsString;
     fTempRec.FieldByName('NAO_GERA_FINAN').AsString := pBuscas.FieldByName('NAO_GERA_FINAN').AsString;
