      QuebraDePagina;
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('num_nf').AsInteger, 6));
      Rdp.imp(linha, 9, buscas.FieldByName('modelo_nf').asstring);
      Rdp.imp(linha, 13, buscas.FieldByName('codigo_nop').asstring);
      Rdp.imp(linha, 22, copy(buscas.FieldByName('nome_cliente').AsString, 1, 26));
      Rdp.imp(linha, 50, buscas.FieldByName('data_ent_saida').asstring);
      Rdp.ImpD(linha, 82, format('%n', [buscas.FieldByName('base_icmsub').asfloat]), []);
      Rdp.impD(linha, 94, format('%n', [buscas.FieldByName('valor_prod').asfloat]), []);
      Rdp.ImpD(linha, 119, format('%n', [buscas.FieldByName('valor_total').asfloat]), []);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('base_icm').AsFloat]), []);
      linha := linha + 1;
      //segunda linha
      Rdp.imp(linha, 1, copy(buscas.FieldByName('DESCRICAO_NOP').AsString, 1, 24));
      Rdp.imp(linha, 26, buscas.FieldByName('cpfcgc').AsString);
      Rdp.imp(linha, 41, buscas.FieldByName('insc_est').AsString);
      Rdp.imp(linha, 55, buscas.FieldByName('SIGLA_UF').AsString);
      //      Rdp.ImpVal(linha, 72, '###,##0.00', buscas.FieldByName('valor_icmsub').asfloat, []);
      Rdp.ImpD(linha, 82, format('%n', [buscas.FieldByName('valor_icmsub').asfloat]), []);
      Rdp.imp(linha, 84, buscas.FieldByName('DESC_COND_PAG').asstring);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('valor_icm').AsFloat]), []);

      vtotn  := vtotn  + buscas.FieldByName('valor_total').AsFloat;
      vtotnE := vtotnE + buscas.FieldByName('valor_total').AsFloat;

      vtotp  := vtotp  + buscas.FieldByName('valor_prod').AsFloat;
      vtotpE := vtotpE + buscas.FieldByName('valor_prod').AsFloat;

      vtotbci  := vtotbci  + buscas.FieldByName('base_icm').AsFloat;
      vtotbciE := vtotbciE + buscas.FieldByName('base_icm').AsFloat;

      vtotvci  := vtotvci  + buscas.FieldByName('valor_icm').AsFloat;
      vtotvciE := vtotvciE + buscas.FieldByName('valor_icm').AsFloat;

      vtotbciSub  := vtotbciSub  + buscas.FieldByName('base_icmsub').asfloat;
      vtotbciSubE := vtotbciSubE + buscas.FieldByName('base_icmsub').asfloat;

      vtotvciSub  := vtotvciSub  + buscas.FieldByName('valor_icmsub').asfloat;
      vtotvciSubE := vtotvciSubE + buscas.FieldByName('valor_icmsub').asfloat;

      linha := linha + 1;
      buscas.next;

      frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;

      if (buscas.FieldByName('CODIGO_NOP').AsFloat <> vnatop) and (vNaturezaNF = buscas.FieldByName('NATUREZA_NF').AsString) then
      	ImprimirTotalCFOP;

      if (buscas.eof) or (vNaturezaNF <> buscas.FieldByName('NATUREZA_NF').AsString) then
    	begin
      	ImprimirTotalCFOP;

        if not (buscas.eof) then
          if buscas.FieldByName('NATUREZA_NF').AsString = 'E' then
            Rdp.ImpF(linha, 1, 'NOTAS FISCAIS DE ENTRADA', [normal, negrito])
          else if buscas.FieldByName('NATUREZA_NF').AsString = 'S' then
          begin
          	ImprimirTotalEntrada;

            linha := linha + 1;
            Rdp.ImpF(linha, 1, 'NOTAS FISCAIS DE SAÍDA ' + vTemp, [normal, negrito]);
          end;
        linha := linha + 1;
      end;
    end // Saída
    else if vNaturezaNF = 'S' then
    begin
      QuebraDePagina;
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('NUM_NF').AsInteger, 6));
      Rdp.imp(linha, 9, buscas.FieldByName('MODELO_NF').asstring);
      Rdp.imp(linha, 13, buscas.FieldByName('CODIGO_NOP').asstring);
      Rdp.imp(linha, 22, copy(buscas.FieldByName('RAZAO').AsString, 1, 26));
      Rdp.imp(linha, 50, buscas.FieldByName('data_ent_saida').asstring);
      Rdp.impD(linha, 70, format('%n', [buscas.FieldByName('BASE_ISS').AsFloat]), [comp17]);
      Rdp.ImpD(linha, 82, format('%n', [buscas.FieldByName('BASE_ICMSUB').asfloat]), []);
      //      Rdp.ImpVal(linha, 82, '###,##0.00', buscas.FieldByName('BASE_ICMSUB').asfloat, []);
      Rdp.impD(linha, 94, format('%n', [buscas.FieldByName('VALOR_PROD').AsFloat - buscas.FieldByName('VALOR_DESC_P').AsFloat]), []);
      Rdp.impD(linha, 106, format('%n', [buscas.FieldByName('VALOR_SERV').AsFloat - buscas.FieldByName('VALOR_DESC_S').AsFloat]), []);
      Rdp.impD(linha, 119, format('%n', [buscas.FieldByName('VALOR_TOTAL').AsFloat]), []);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('BASE_ICM').AsFloat]), []);
      linha := linha + 1;
      //segunda linha
      Rdp.imp(linha, 1, copy(buscas.FieldByName('DESCRICAO_NOP').AsString, 1, 24));
      Rdp.imp(linha, 26, buscas.FieldByName('CPFCGC').AsString);
      Rdp.imp(linha, 41, buscas.FieldByName('INSC_EST').AsString);
      Rdp.imp(linha, 55, buscas.FieldByName('SIGLA_UF').AsString);
      Rdp.impD(linha, 70, format('%n', [buscas.FieldByName('VALOR_ISS').AsFloat]), []);
      //      Rdp.ImpVal(linha, 82, '###,##0.00', buscas.FieldByName('VALOR_ICMSUB').asfloat, []);
      Rdp.ImpD(linha, 82, format('%n', [buscas.FieldByName('VALOR_ICMSUB').asfloat]), []);
      Rdp.imp(linha, 84, buscas.FieldByName('DESC_COND_PAG').asstring);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('VALOR_ICM').AsFloat]), []);
      linha := linha + 1;

      vtotn := vtotn + buscas.FieldByName('VALOR_TOTAL').AsFloat;
      if vTipoDoc = 'NFC' then
      	vtotnS_NFC := vtotnS_NFC + buscas.FieldByName('VALOR_TOTAL').AsFloat
      else
      	vtotnS_NF := vtotnS_NF + buscas.FieldByName('VALOR_TOTAL').AsFloat;

      vtotp := vtotp + (buscas.FieldByName('VALOR_PROD').AsFloat - buscas.FieldByName('VALOR_DESC_P').AsFloat);
      if vTipoDoc = 'NFC' then
      	vtotpS_NFC := vtotpS_NFC + (buscas.FieldByName('VALOR_PROD').AsFloat - buscas.FieldByName('VALOR_DESC_P').AsFloat)
      else
      	vtotpS_NF := vtotpS_NF + (buscas.FieldByName('VALOR_PROD').AsFloat - buscas.FieldByName('VALOR_DESC_P').AsFloat);

      vtots := vtots + (buscas.FieldByName('VALOR_SERV').AsFloat - buscas.FieldByName('VALOR_DESC_S').AsFloat);
      if vTipoDoc = 'NFC' then
      	vtotsS_NFC := vtotsS_NFC + (buscas.FieldByName('VALOR_SERV').AsFloat - buscas.FieldByName('VALOR_DESC_S').AsFloat)
      else
      	vtotsS_NF := vtotsS_NF + (buscas.FieldByName('VALOR_SERV').AsFloat - buscas.FieldByName('VALOR_DESC_S').AsFloat);

      vtotbci := vtotbci + buscas.FieldByName('BASE_ICM').AsFloat;
      if vTipoDoc = 'NFC' then
      	vtotbciS_NFC := vtotbciS_NFC + buscas.FieldByName('BASE_ICM').AsFloat
      else
      	vtotbciS_NF := vtotbciS_NF + buscas.FieldByName('BASE_ICM').AsFloat;

      vtotvci := vtotvci + buscas.FieldByName('VALOR_ICM').AsFloat;
      if vTipoDoc = 'NFC' then
      	vtotvciS_NFC := vtotvciS_NFC + buscas.FieldByName('VALOR_ICM').AsFloat
      else
      	vtotvciS_NF := vtotvciS_NF + buscas.FieldByName('VALOR_ICM').AsFloat;

      vtotbcs := vtotbcs + buscas.FieldByName('BASE_ISS').AsFloat;
      if vTipoDoc = 'NFC' then
      	vtotbcsS_NFC := vtotbcsS_NFC + buscas.FieldByName('BASE_ISS').AsFloat
      else
      	vtotbcsS_NF := vtotbcsS_NF + buscas.FieldByName('BASE_ISS').AsFloat;

      Vtotvcs := Vtotvcs + buscas.FieldByName('VALOR_ISS').AsFloat;
      if vTipoDoc = 'NFC' then
      	VtotvcsS_NFC := VtotvcsS_NFC + buscas.FieldByName('VALOR_ISS').AsFloat
      else
      	VtotvcsS_NF := VtotvcsS_NF + buscas.FieldByName('VALOR_ISS').AsFloat;

      vtotbciSub := vtotbciSub + buscas.FieldByName('BASE_ICMSUB').asfloat;
      if vTipoDoc = 'NFC' then
      	vtotbciSubS_NFC := vtotbciSubS_NFC + buscas.FieldByName('BASE_ICMSUB').asfloat
      else
      	vtotbciSubS_NF := vtotbciSubS_NF + buscas.FieldByName('BASE_ICMSUB').asfloat;

      vtotvciSub := vtotvciSub + buscas.FieldByName('VALOR_ICMSUB').asfloat;
      if vTipoDoc = 'NFC' then
      	vtotvciSubS_NFC := vtotvciSubS_NFC + buscas.FieldByName('VALOR_ICMSUB').asfloat
      else
      	vtotvciSubS_NF := vtotvciSubS_NF + buscas.FieldByName('VALOR_ICMSUB').asfloat;

      linha := linha + 1;
      buscas.next;
      if (buscas.FieldByName('CODIGO_NOP').AsFloat <> vnatop) and (vNaturezaNF = buscas.FieldByName('NATUREZA_NF').AsString) then
      	ImprimirTotalCFOP;

      if (buscas.eof) or (vNaturezaNF <> buscas.FieldByName('NATUREZA_NF').AsString) then
      begin
      	ImprimirTotalCFOP;
        
        if not (buscas.eof) then
          if buscas.FieldByName('NATUREZA_NF').AsString = 'E' then
            Rdp.ImpF(linha, 1, 'NOTAS FISCAIS DE ENTRADA', [normal, negrito])
          else if buscas.FieldByName('NATUREZA_NF').AsString = 'S' then
          begin
            ImprimirTotalEntrada;

            linha := linha + 1;
            Rdp.ImpF(linha, 1, 'NOTAS FISCAIS DE SAÍDA ' + vTemp, [normal, negrito]);
          end;
        linha := linha + 1;
      end;
    end;

    // Total Saída (NFCe/NFe)
    if (buscas.eof) and (vNaturezaNF = 'S') then
      ImprimirTotalNFCeNFe;

    // Total Geral Saída
    if (buscas.eof) and (vNaturezaNF = 'S') then
      ImprimirTotalSaida;

  end;
  if Rdp.EstaAberto then
    Rdp.fechar;
  vDadosIni.GravaAuditoria('REL015', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.close;
  frmRelatorios.ProgressBar.Position := 0;
end;

procedure TRelatorioNotasEmitidasPorPeriodo.QuebraDePagina;
begin
  if linha >= 62 then
    CabNovaPagina;
end;

{ TRelatorioProdutosComPendenciaEmVendasREQOS }

function TRelatorioProdutosComPendenciaEmVendasREQOS.abreProdutosComPendencias: Boolean;
begin
  try
    Result := False;
    //Produtos com pendencia em OS e Requisição
    buscas.Close;
    buscas.SQL.Text := 'SELECT case when (v.tipo=''REQ'') then ''REQUISIÇÃO'' else ' +
      ' ''ORDEM DE SERVIÇO'' end as TipoVenda,vp.quant_ped_item,vp.nped,v.data_ped,' +
      ' c.nome_cliente,v.tipo, v.tipv, v.tipo_os,p.NUM_FAB_PROD,p.DESCR_PROD,p.PREC_CUS_PROD,' +
      ' p.PREC_CUSM_PROD,p.PREC_TAB_PROD, vp.cod_vendedor,vp.nitem, ''  '' ordem ' +
      ' from pedvenda v INNER JOIN pedvenda_prod vp ' +
      ' on v.nped = vp.nped and v.cod_empresa = vp.cod_empresa and v.tipo = vp.tipo ' +
      ' inner join produtos p on vp.grupo_prod= p.grupo_prod and vp.cod_prod=p.cod_prod ' +
      ' and vp.cod_empresa=p.cod_empresa ' +
      ' INNER JOIN clientes c on v.cod_empresa=c.cod_empresa and v.cod_cliente=c.cod_cliente ' +
      ' where v.data_ped >= :dti and v.data_ped <= :dtf and v.data_fech is null ' +
      ' and v.ativo = 1 and v.tipo <> ''ORC'' and p.cod_empresa=' + vDadosIni.codEmpresa +
      ' and /*p.ativo=1 and*/ ((vp.status is null) or (vp.status <> ''CANCELADO''))' +
      ' union' +
      ' select ''PRODUÇÃO'', (coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)),' +
      ' pd.cod_producao, pd.data, c.nome_cliente, ''PRD'', '''', '''', pi.num_fab_prod, pi.descr_prod, p.prec_cus_prod,' +
      ' p.prec_cusm_prod, p.prec_tab_prod, null,pi.nitem, ''  '' ordem from producao pd' +
      ' inner join producao_item_indice pi on pi.cod_producao = pd.cod_producao and pi.cod_empresa = pd.cod_empresa' +
      ' left join clientes c on c.cod_cliente = pd.cod_cliente and c.cod_empresa = pd.cod_empresa' +
      ' inner join produtos p on p.grupo_prod = pi.grupo_prod and p.cod_prod = pi.cod_prod and p.cod_empresa = pi.cod_empresa' +
      ' where pd.data_fechamento is null and pd.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pd.data >= :dti and pd.data <= :dtf' +
      ' union' +
      ' select ''EST. FECHADO'', c.quant, c.cod_pedido, c.data_pedido, cl.nome_cliente, ''ESF'',c.tipv, ' +
      ' case when (coalesce(c.cod_reserva, 0) > 0) then ''RES'' else c.sit_atd end sit_atd, p.NUM_FAB_PROD,rtrim(p.DESCR_PROD)||' +
      ' case when coalesce(g.cod_grade, 0) > 0 then ''-'' || coalesce(g.descricao, '''')' +
      ' else '''' end DESCR_PROD,p.PREC_CUS_PROD,' +
      ' p.PREC_CUSM_PROD,p.PREC_TAB_PROD, c.cod_vendedor,c.nitem, ' +
      ' case when (coalesce(c.cod_reserva, 0) > 0) then ''RES'' else c.sit_atd end sit_atd ' +
      ' from controle_almoxarifado c' +
      ' left join clientes cl on cl.cod_cliente = c.cod_cliente and cl.cod_empresa = c.cod_empresa' +
      ' inner join produtos p on p.grupo_prod = c.grupo_prod and p.cod_prod = c.cod_prod and p.cod_empresa = c.cod_empresa' +
      ' left join grade g on g.cod_grade = c.cod_grade' +
      ' where c.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and c.data_pedido >= :dti and c.data_pedido <= :dtf' +
      ' order by 1,16,4';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;
end;

