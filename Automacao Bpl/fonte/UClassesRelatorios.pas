function TRelatoriosExtratoContaCorrenteProgFid.abreExtratoContaCorrenteProgFid: Boolean;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      Result := False;
      //Recibos emitidos
      buscas.Close;
      buscas.SQL.Text := ' select cc.cod_cliente, ' +
        ' cc.data, ' +
        ' (trim(case when (coalesce(sum(case when(cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.pontos, 0)) else coalesce(cc.pontos, 0) end), 0) > 0) then ' +
        ' 	 ''CRÉDITO REF A'' ' +
        ' else ' +
        '    ''DÉBITO REF A'' ' +
        ' end) ||'' ''|| ' +
        ' trim(case when (cc.tipodoc = ''REQ'') then ''REQUISICAO'' ' +
        '      	    when (cc.tipodoc = ''OS'')  then ''ORDEM DE SERVICO'' ' +
        '           when (cc.tipodoc = ''MOT'') then ''COMANDO DE FATURAMENTO'' ' +
        '           when (cc.tipodoc = ''NF'')  then ''DEVOLUCAO'' ' +
        '      	    when (cc.tipodoc = ''DEV'') then ''DEVOLUCAO'' ' +
        '           when (cc.tipodoc = ''DEVV'')then ''DEVOLUCAO'' ' +
        '           when (cc.tipodoc = ''PRE'') then ''PRESTACAO'' ' +
        '           when (cc.tipodoc = ''REC'') then ''VALE COMPRA'' ' +
        ' end) ' +
        ' || '' Nº '' || ndoc) descricao, ' +
        ' coalesce(sum(case when(cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.pontos, 0)) else coalesce(cc.pontos, 0) end), 0) pontos, ' +
        ' coalesce(sum(case when(cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.valor, 0)) else coalesce(cc.valor, 0) end), 0) valor, ' +
        ' cc.ndoc, cc.tipodoc, cl.nome_cliente, cl.razao, cl.cpfcgc from conta_corrente_prog_fidelidade cc ' +
        ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
        ' where cc.data >= :data_ini and cc.data <= :data_fim and cc.cod_empresa = :cod_empresa ';
       if FiltrarCliente then
         buscas.SQL.Text := buscas.SQL.Text + ' and cc.cod_cliente = :cod_cliente ';
       buscas.SQL.Text := buscas.SQL.Text +
        ' and cc.tipodoc is not null and cc.tipodoc <> ''TRF'' ' +
        ' group by 1, 2, 6, 7, 8, 9, 10 ' +
        ' having sum(case when(cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.pontos, 0)) else coalesce(cc.pontos, 0) end) <> 0 ' +
        ' union ' +
        ' select cc.cod_cliente, ' +
        ' cc.data, ' +
        ' cc.descricao, ' +
        ' case when (cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.pontos, 0)) else coalesce(cc.pontos, 0) end pontos, ' +
        ' case when (cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.valor, 0)) else coalesce(cc.valor, 0) end valor, ' +
        ' cc.ndoc, cc.tipodoc, cl.nome_cliente, cl.razao, cl.cpfcgc from conta_corrente_prog_fidelidade cc ' +
        ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
        ' where cc.data >= :data_ini and cc.data <= :data_fim and cc.cod_empresa = :cod_empresa ';
       if FiltrarCliente then
         buscas.SQL.Text := buscas.SQL.Text + ' and cc.cod_cliente = :cod_cliente ';
       buscas.SQL.Text := buscas.SQL.Text +
        ' and cc.tipodoc is null ' +
        ' union ' +
        ' select cc.cod_cliente, ' +
        ' cc.data, ' +
        ' cc.descricao, ' +
        ' case when (cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.pontos, 0)) else coalesce(cc.pontos, 0) end pontos, ' +
        ' case when (cc.tipo = ''DÉBITO'') then (-1 * coalesce(cc.valor, 0)) else coalesce(cc.valor, 0) end valor, ' +
        ' cc.ndoc, cc.tipodoc, cl.nome_cliente, cl.razao, cl.cpfcgc from conta_corrente_prog_fidelidade cc ' +
        ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
        ' where cc.data >= :data_ini and cc.data <= :data_fim and cc.cod_empresa = :cod_empresa ';
       if FiltrarCliente then
         buscas.SQL.Text := buscas.SQL.Text + ' and cc.cod_cliente = :cod_cliente ';
       buscas.SQL.Text := buscas.SQL.Text +
        ' and cc.tipodoc = ''TRF'' ' +
        ' order by 2 ';
      buscas.Params.ParamByName('data_ini').AsDate := datainicial;
      buscas.Params.ParamByName('data_fim').AsDate := datafinal;
      buscas.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      if FiltrarCliente then
        buscas.Params.ParamByName('cod_cliente').AsInteger := dtSetCliente.FieldByName('cod_cliente').AsInteger;
      buscas.Open;
//      if not (buscas.IsEmpty) then
        result := true
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

