function TRelatorioDiarioDiretoria.ImprimirStringListLaboB(linhatemp: Integer): boolean;
var
 Z: Integer;
begin

 Z := 1;
 While Z <= linhatemp do
 begin
  if vContLista = vListaLadB.Count then
    break;
  if UpperCase(trim(vDadosIni.getCampoPipe(vListaLadB[vContLista], 1))) = '' then
    Rdp.Imp(Z, 65, '')
  else if (UpperCase(vDadosIni.getCampoPipe(vListaLadB[vContLista], 3)) = '[NORMAL, NEGRITO]') then
  begin
    if (UpperCase(vDadosIni.getCampoPipe(vListaLadB[vContLista], 4)) = 'D') then
      Rdp.ImpD(Z, StrToInt(trim(vDadosIni.getCampoPipe(vListaLadB[vContLista], 1))), vDadosIni.getCampoPipe(vListaLadB[vContLista], 2), [normal, negrito])
    else
      Rdp.ImpF(Z, StrToInt(trim(vDadosIni.getCampoPipe(vListaLadB[vContLista], 1))), vDadosIni.getCampoPipe(vListaLadB[vContLista], 2), [normal, negrito])
    end
  else if (UpperCase(vDadosIni.getCampoPipe(vListaLadB[vContLista], 4)) = 'D') then
    Rdp.ImpD(Z, StrToInt(vDadosIni.getCampoPipe(vListaLadB[vContLista], 1)), vDadosIni.getCampoPipe(vListaLadB[vContLista], 2), [])
  else
    Rdp.Imp(Z, StrToInt(vDadosIni.getCampoPipe(vListaLadB[vContLista], 1)), vDadosIni.getCampoPipe(vListaLadB[vContLista], 2));
  if UpperCase(trim(vDadosIni.getCampoPipe(vListaLadB[vContLista], 5))) = 'P' then
    Z := Z + 1;
  vContLista := vContLista + 1;
 end;
end;

