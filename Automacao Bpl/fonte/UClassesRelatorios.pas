  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|TOTAL GERAL:||||');
  vListaLadB.Add('123|'+vDadosIni.Alndir(format('%12.2f', [vtotmo]), 12)+'||D||');
end;

