constructor TRelatorioComissaoPorVenda.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);

  fParcelas := TClientDataSet.Create(nil);
  fParcelas.Close;
  fParcelas.FieldDefs.Clear;
  fParcelas.FieldDefs.Add('tipo', ftInteger, 0, false);
  fParcelas.FieldDefs.Add('cod_vendedor', ftInteger, 0, false);
  fParcelas.FieldDefs.Add('nome_vendedor', ftString, 100, false);
  fParcelas.FieldDefs.Add('comissao_vend', ftFloat, 0, false);

  if fParcelas.Tag = 0 then
  try
    fParcelas.CreateDataSet;
    fParcelas.Tag := 1;
  except
  end;
end;

procedure TRelatorioComissaoPorVenda.ImprimeRelatorios;
var
  vlProd, vlComiss, vtmpProdutos, vtmpComiss: Currency;
  vlComissVend, vlComissPart: Double;
  nOS, nServ: string;
  vnomevendedor: string;
  vcod_tipo: Integer;
  vcod_vendedor: Integer;
  vNped: Integer;
  vTipo: string;
  vNParc: Integer;
  vIncParc: Double;
  vcoluna: Integer;
  vtotvend, vtotpart: Double;

  procedure imprimirtotalporvendedorparceiro(pNaoVerificarVendParc: boolean = false);
  begin
      if (vcod_vendedor <> buscas.FieldByName('cod_vendedor').AsInteger)
        or (vcod_tipo <> buscas.FieldByName('cod_tipo').AsInteger)
        or (pNaoVerificarVendParc) then
      begin
        if (vcod_vendedor > 0) or (vcod_tipo <> 0) then
        begin
      	  if pNaoVerificarVendParc then
            linha := linha + 1;
          Rdp.ImpF(linha, 1, vDadosIni.IfThen(vcod_tipo = 2,
            'Total ' + vDadosIni.vPedVnd.descricaoParticipante + ': ' + vnomevendedor, 
          	'Total vendedor: ' + vnomevendedor), [comp17, negrito]);
          Rdp.ImpD(linha, 131, Format('%m', [vtmpComiss]), [comp17, negrito]);
          inc(linha);
          Rdp.Imp(linha, 1, vDadosIni.Replicate('-', 132));
          inc(linha);
          vtmpProdutos := 0;
          vtmpComiss := 0;
        end;
        if not pNaoVerificarVendParc then
        begin
          Rdp.ImpF(linha, 1, vDadosIni.IfThen(buscas.FieldByName('cod_tipo').AsInteger = 2,
            vDadosIni.vPedVnd.descricaoParticipante + ': ', 'Vendedor: ') +
            buscas.FieldByName('NOME_VENDEDOR').AsString, [Negrito]);
          linha := linha + 2;
        end;
      end;
   end;

   procedure ExibirParcela;
   begin
      if TipoRelatorio <> 'ANALÍTICO' then
        exit;

   	  if buscas.FieldByName('seqform').AsInteger > 0 then
      begin
        Inc(vNParc);

        vIncParc := vIncParc + RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2);
        if (vcoluna >= 3) then
          vcoluna := 0;
        vcoluna := vcoluna + 1;

        if (vcoluna = 3) then
        begin
          Rdp.ImpF(linha, 87, '|', [comp17, negrito]);
          Rdp.ImpF(linha, 89, IntToStr(vNParc) + 'ª', [comp17, negrito]);
          Rdp.ImpF(linha, 89 + Length(IntToStr(vNParc) + 'ª'),
          	Copy('-' + buscas.FieldByName('nome_ctrl').AsString, 1, 10 - Length(IntToStr(vNParc) + 'ª')), [comp17]);
          if not buscas.FieldByName('data_venc').IsNull then
            Rdp.ImpF(linha, 101, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc').AsDateTime), [comp17]);
          Rdp.ImpD(linha, 121, format('%n', [buscas.FieldByName('valordoc').asFloat]), [comp17]);
          if ((buscas.FieldByName('vl_comissao_vend').AsFloat > 0) and (buscas.FieldByName('qtde_reg').AsFloat > 0)
            and (buscas.FieldByName('qtde_reg').AsFloat = vNParc)
            and (RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc <> 0)) then
              Rdp.ImpD(linha, 130, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2) +
              	(RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc)]), [comp17])
          else
            Rdp.ImpD(linha, 130, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2)]), [comp17]);
        end
        else if (vcoluna = 1) then
        begin
          Rdp.ImpF(linha, 1, IntToStr(vNParc) + 'ª', [comp17, negrito]);
          Rdp.ImpF(linha, 1 + Length(IntToStr(vNParc) + 'ª'),
          	Copy('-' + buscas.FieldByName('nome_ctrl').AsString, 1, 10 - Length(IntToStr(vNParc) + 'ª')), [comp17]);
          if not buscas.FieldByName('data_venc').IsNull then
            Rdp.ImpF(linha, 12, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc').AsDateTime), [comp17]);
          Rdp.ImpD(linha, 32, format('%n', [buscas.FieldByName('valordoc').asFloat]), [comp17]);
          if ((buscas.FieldByName('vl_comissao_vend').AsFloat > 0) and (buscas.FieldByName('qtde_reg').AsFloat > 0)
            and (buscas.FieldByName('qtde_reg').AsFloat = vNParc)
            and (RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc <> 0)) then
              Rdp.ImpD(linha, 41, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2) +
                (RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc)]), [comp17])
          else
            Rdp.ImpD(linha, 41, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2)]), [comp17]);
        end
        else if (vcoluna = 2) then
        begin
          Rdp.ImpF(linha, 43, '|', [comp17, negrito]);
          Rdp.ImpF(linha, 45, IntToStr(vNParc) + 'ª', [comp17, negrito]);
          Rdp.ImpF(linha, 45 + Length(IntToStr(vNParc) + 'ª'),
          	Copy('-' + buscas.FieldByName('nome_ctrl').AsString, 1, 10 - Length(IntToStr(vNParc) + 'ª')), [comp17]);
          if not buscas.FieldByName('data_venc').IsNull then
            Rdp.ImpF(linha, 57, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc').AsDateTime), [comp17]);
          Rdp.ImpD(linha, 77, format('%n', [buscas.FieldByName('valordoc').asFloat]), [comp17]);
          if ((buscas.FieldByName('vl_comissao_vend').AsFloat > 0) and (buscas.FieldByName('qtde_reg').AsFloat > 0)
            and (buscas.FieldByName('qtde_reg').AsFloat = vNParc)
            and (RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc <> 0)) then
              Rdp.ImpD(linha, 86, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2) +
              	(RoundTo(buscas.FieldByName('vl_comissao_vend').AsFloat, -2) - vIncParc)]), [comp17])
          else
            Rdp.ImpD(linha, 86, format('%n', [RoundTo(buscas.FieldByName('valor_comissao_parc').asFloat, -2)]), [comp17]);
        end;

       if (vNParc = buscas.FieldByName('qtde_reg').AsFloat) then
          linha := linha + 1
       else if (vcoluna = 3) then 
          linha := linha + 1;
      end;
   end;
begin
  if not vDadosIni.PesqPros('REL054', 'IMPRIMIR', '', '', '', buscas, false) then
    Exit;
  inherited;
  vpag := 0;
  vnomevendedor := '';
  vcod_tipo := 0;
  vcod_vendedor := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Comissão de Venda por Recebimento';
  rdp.TitulodoRelatorio := 'Relatório Comissão de Venda por Recebimento';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho

  vlProd := 0;
  vlComiss := 0;
  vlComissVend := 0;
  vlComissPart := 0;
  vtmpComiss := 0;
  vtmpProdutos := 0;

  abreComissaoPorVenda;

  try
