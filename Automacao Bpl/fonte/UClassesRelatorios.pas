        Rdp.ImpD(linha, 102, format('%n', [buscas.FieldByName('vltot_ped_item').asFloat]), [comp17, negrito]);
        Rdp.ImpD(linha, 116, format('%n', [buscas.FieldByName('perc_comissao_vend').AsFloat]), [comp17, negrito]);
        Rdp.impD(linha, 131, format('%n', [buscas.FieldByName('vl_comissao_vend').AsFloat]), [comp17, negrito]);
      end
      else
