    FRdp1.Impf(linha, 1, 'DADOS GERAIS', [comp17, negrito]);
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'TOTAL VENDA(R$).........: ' + vDadosIni.AlnDir(format('%n', [vvalortotal]), 12));
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'TOTAL DESCONTO(R$)......: ' + vDadosIni.AlnDir(format('%n', [vdesconto]), 12));
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'TOTAL LIQUIDO(R$).......: ' + vDadosIni.AlnDir(format('%n', [vvalorLiquido]), 12));
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'TOT.CUSTO MED. CONT(R$).: ' + vDadosIni.AlnDir(format('%n', [vcustContabil]), 12));
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'LUCRO BRUTO(R$).........: ' + vDadosIni.AlnDir(format('%n', [vLucroBruto]), 12));
    linha := linha + 1;

    if vCustContabil <> 0 then
    begin
      FRdp1.Imp(linha, 1, 'MARK UP FATURAMENTO ....: ' + vDadosIni.AlnDir(format('%0.4f', [((vvalortotal - vdesconto) - vcustContabil) / vcustContabil]), 12));
      linha := linha + 1;
    end;

    FRdp1.Imp(linha, 1, 'MARGEM LUCRO(%).........: ' + vDadosIni.AlnDir(format('%n', [(((vvalortotal - vdesconto) - vcustContabil) / vvalortotal) * 100]), 12));
    linha := linha + 1;
    FRdp1.Imp(linha, 1, 'QUANTIDADE REQUISICOES...:      ' + vDadosIni.strzero(CurrToStr(vQuantOS), 6));
    linha := linha + 1;

    if vComissaoF <> 0 then
    begin
      FRdp1.Imp(linha, 1, 'COMISSAO FUNCIONARIO PR.: ' + vDadosIni.AlnDir(format('%n', [vComissaoF]), 12));
      linha := linha + 1;
    end;

    if vComissaoG <> 0 then
    begin
      FRdp1.Imp(linha, 1, 'COMISSAO GERENTE PRODUTO: ' + vDadosIni.AlnDir(format('%n', [vComissaoG]), 12));
      linha := linha + 1;
    end;
  end;
end;

