             buscas3.Open;
           end
           else if trim(buscas.FieldByName('TP_DOC').AsString) = 'CH' then
           begin
             buscas3.Close;
             buscas3.SQL.Text :=
               ' select ' +
               '    (select count(*) from controle_cheque ch ' +
               '		 left join empresa emp on ch.codigo_emp = emp.cod_empresa ' +
               '     left join clientes cl on ' +
               '		 	 cl.cod_cliente = ch.cod_cliente ' +
               '			 and cl.cod_empresa = ch.cod_emp_mult ' +
               '     where ch.lote_quit = :lote ' +
                     vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                        ' and ch.datq_ch = :datq_ch ', '') +
                     vtempSqlEmpresa +
                     vtempSqlCliente +
                     vtempSqlOrigControle +
                     vtempSqlUnificada +
               '    ) qtde_prest, ' +
               '    (case when coalesce((' +
               '        case when (coalesce((select controle_cheque.lote_quit from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '               coalesce((select controle_cheque.valor_ch from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) ' +
               '             else ' +
               '               (select sum(coalesce(controle_cheque.valor_ch, 0)) from controle_cheque ' +
               '								left join empresa on controle_cheque.codigo_emp = empresa.cod_empresa ' +
               '                left join clientes on ' +
               '									clientes.cod_cliente = controle_cheque.cod_cliente ' +
               '									and clientes.cod_empresa = controle_cheque.cod_emp_mult ' +
               '                where controle_cheque.lote_quit = :lote ' +
                                vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                  ' and controle_cheque.datq_ch = :datq_ch ', '') +
                                vtempSqlEmpresa2 +
                                vtempSqlCliente2 +
                                vtempSqlOrigControle2 +
                                vtempSqlUnificada2 +
               '               ) ' +
               '        end), 0) <= 0 then ' +
               '        0 ' +
               '      else ' +
               '        ((coalesce( ' +
               '            (case when (coalesce((select controle_cheque.lote_quit from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '                   coalesce((select controle_cheque.valor_ch from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) ' +
               '                 else ' +
               '                   (select sum(coalesce(controle_cheque.valor_ch, 0)) from controle_cheque ' +
               '									  left join empresa on controle_cheque.codigo_emp = empresa.cod_empresa ' +
               '                    left join clientes on ' +
               '									    clientes.cod_cliente = controle_cheque.cod_cliente ' +
               '									    and clientes.cod_empresa = controle_cheque.cod_emp_mult ' +
               '                    where controle_cheque.lote_quit = :lote ' +
                                    vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                      ' and controle_cheque.datq_ch = :datq_ch ', '') +
                                    vtempSqlEmpresa2 +
                                    vtempSqlCliente2 +
                                    vtempSqlOrigControle2 +
                                    vtempSqlUnificada2 +
               '                   ) ' +
               '            end) , 0) / ' +
               '          coalesce( ' +
               '            (case when (coalesce((select controle_cheque.lote_quit from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '                   coalesce((select controle_cheque.valor_ch from controle_cheque where controle_cheque.codigo_ch = :codigo_ch and controle_cheque.codigo_emp = :cod_emp_orig), 0) ' +
               '                 else ' +
               '                   (select sum(coalesce(controle_cheque.valor_ch, 0)) from controle_cheque ' +
               '										left join empresa on controle_cheque.codigo_emp = empresa.cod_empresa ' +
               '                    left join clientes on ' +
               '									    clientes.cod_cliente = controle_cheque.cod_cliente ' +
               '									    and clientes.cod_empresa = controle_cheque.cod_emp_mult ' +
               '                    where controle_cheque.lote_quit = :lote ' +
                                    vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                      ' and controle_cheque.datq_ch = :datq_ch ', '') +
                                    vtempSqlEmpresa2 +
               '                   ) ' +
               '            end) , 0)) ' +
               '        ) ' +
               '     end ' +
               '    ) valor_pago from rdb$database ';

             buscas3.ParamByName('codigo_emp').AsInteger     := buscas.FieldByName('cod_empresa').AsInteger;
             buscas3.ParamByName('codigo_ch').AsInteger      := buscas.FieldByName('cod_cred').AsInteger;
             buscas3.ParamByName('cod_emp_orig').AsInteger   := buscas.FieldByName('cod_emp_orig').AsInteger;

             if (FiltrarCliente) and (trim(buscas.FieldByName('cpfcgc_cliente').AsString) <> '') then
               buscas3.ParamByName('cpfcgc').AsString        := trim(buscas.FieldByName('cpfcgc_cliente').AsString)
             else if (FiltrarCliente) then
               buscas3.ParamByName('cod_cliente').AsInteger  := buscas.FieldByName('cod_cliente').AsInteger;

             if (FiltrarCliente) and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
               buscas3.ParamByName('cod_emp_mult').AsInteger := buscas.FieldByName('cod_emp_mult').AsInteger;

             if (FiltrarOrigControle)  then
               buscas3.ParamByName('codigo_ctrl').AsInteger  := buscas.FieldByName('cod_tipo').AsInteger;

             buscas3.ParamByName('lote').AsInteger           := buscas.FieldByName('loterec').AsInteger;

             if (vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0) then
               buscas3.ParamByName('datq_ch').AsDateTime     := buscas.FieldByName('data_conf').AsDateTime;

             buscas3.Open;
           end;

           if not buscas3.IsEmpty then
           begin
	           vQtdePrestRec := buscas3.FieldByName('qtde_prest').AsInteger;
					   vValorPagoRec := buscas3.FieldByName('valor_pago').AsCurrency * buscas.FieldByName('valor_pago').AsCurrency;
           end;
         end
       end;

       if (vSaida) and
        (((trim(vTipoRec) <> '') and (trim(vTipoRec) = 'SAIDAS')) or
        ((trim(vTipoRec) = '') and (trim(buscas.FieldByName('TP_REL').AsString) = 'SAIDAS'))) then
       begin
      	 if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           verificarTotais;
       end
       else if (vRecibo) and
        (((trim(vTipoRec) <> '') and (trim(vTipoRec) = 'RECIBO ANTECIPADO')) or
        ((trim(vTipoRec) = '') and (trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO'))) then
       begin
         if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           verificarTotais;
       end
       else if (vCrediario) and
        (((trim(vTipoRec) <> '') and (trim(vTipoRec) = 'CREDIARIO')) or
        ((trim(vTipoRec) = '') and (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO'))) then
       begin
         if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           verificarTotais;
       end;

       if (trim(vTipoRec) <> '')
        and (trim(vTipoRec) <> vDadosIni.IfThen(trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO', 'CREDIARIO',
          vDadosIni.IfThen(trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO', 'RECIBO ANTECIPADO',
           	'SAIDAS'))) then
       begin
         ImprimirControles;
       end;

       if (not vEmp) and ((AgruparEmpUnificada <> 'S') and (CodEmpUnificada <= 0)) then
       begin
         Rdp.ImpF(linha, 1, Copy(IntToStr(buscasEmp.FieldByName('COD_EMPRESA').AsInteger) +
         	' ' + trim(buscasEmp.FieldByName('IDENTIFICACAO_EMP').AsString), 1, 75), [normal, negrito]);
         linha := linha + 2;
         vEmp := true;
       end;

       if (not vCrediario) and (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') then
       begin
         Rdp.ImpF(linha, 1, 'CREDIÁRIO/CHEQUE', [normal, negrito]);
         linha := linha + 2;
         vCrediario := true;
       end
       else if (not vSaida) and (FiltrarVenda) and (trim(buscas.FieldByName('TP_REL').AsString) = 'SAIDAS') then
       begin
         if trim(Venda) = 'SIM' then
           Rdp.ImpF(linha, 1, 'VENDA', [normal, negrito])
         else
           Rdp.ImpF(linha, 1, 'NÃO É VENDA', [normal, negrito]);
         linha := linha + 2;
         vSaida := true;
       end
       else if (not vSaida) and (trim(buscas.FieldByName('TP_REL').AsString) = 'SAIDAS') then
       begin
         Rdp.ImpF(linha, 1, 'SAÍDAS/VENDA', [normal, negrito]);
         linha := linha + 2;
         vSaida := true;
       end
       else if (not vRecibo) and (trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO') then
       begin
         Rdp.ImpF(linha, 1, 'RECIBO ANTECIPADO', [normal, negrito]);
         linha := linha + 2;
         vRecibo := true;
       end;

        //INCPREST
        if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
          vTotValorPagoLote := 0;

        if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
        	and (FiltrarCliente) 
          and ((vLote = buscas.FieldByName('LOTEREC').AsInteger)
        	and (vSeqId <> buscas.FieldByName('SEQID').AsInteger)
          and (vQtdePrestRec > 1)) then
        begin
        	vInc := vInc + 1;
        end
        else if ((vLote = buscas.FieldByName('LOTEREC').AsInteger)
        	and (vSeqId <> buscas.FieldByName('SEQID').AsInteger)
          and (buscas.FieldByName('QTDE_PREST').AsInteger > 1)) then
        begin
          vInc := vInc + 1;
        end
        else if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
        begin
          vInc := 1;
          vIncTemp := 0;
        end;

        if vDadosIni.strIn(trim(buscas.FieldByName('TP_REL').AsString), ['SAIDAS', 'RECIBO ANTECIPADO']) then
        begin
          if ((vLote = buscas.FieldByName('LOTEREC').AsInteger) and (vSeqId <>  buscas.FieldByName('SEQID').AsInteger)) then
            vExibirInfCliente := false
          else
            vExibirInfCliente := true;
        end
        else
          vExibirInfCliente := true;

        if (vExibirInfCliente) then
        begin
          if (trim(vTipo) + '|' + trim(vNumDoc) + '|' + IntToStr(vSeqId) <>
            trim(Buscas.FieldByName('TIPO').asstring) + '|' +
            trim(Buscas.FieldByName('NUM_DOC').asstring) + '|' +
            IntToStr(Buscas.FieldByName('SEQID').AsInteger)) then
          begin
            if (trim(TipoRelatorio) = 'ANALÍTICO') then
            begin
              Rdp.Imp(linha, 1, Copy(trim(Buscas.FieldByName('NUM_DOC').asstring), 1, 11));
              Rdp.Imp(linha, 13, copy(trim(Buscas.FieldByName('TIPO').asstring), 1, 6));
              Rdp.Imp(linha, 21, Buscas.FieldByName('NOME_CLIENTE').asstring);
              Rdp.ImpD(linha, 72, Buscas.FieldByName('NCUPOM').AsString, [comp17]);
              Rdp.ImpD(linha, 83, Buscas.FieldByName('NUM_NF').AsString, [comp17]);
              Rdp.ImpD(linha, 104, Format('%f', [Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency]), [comp17]);
              Rdp.imp(linha, 109, buscas.FieldByName('DATA_CONF').AsString);
              if buscas.FieldByName('CODIGO_CTRL').AsInteger > 0 then
              	Rdp.imp(linha, 123, 'QUITADO');
              linha := linha + 1;

              if (trim(ExibirDetalhesRec) <> 'SIM') then
              	linha := linha + 1;
            end;
            vValorTotDoc := vValorTotDoc + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotPag := vValorTotPag + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotRel := vValorTotRel + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotDia := vValorTotDia + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
          end;
        end;

        if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
          and (FiltrarCliente) 
        	and (vQtdePrestRec > 1)
        	and (vInc = vQtdePrestRec) then
        begin
        	if (vLoteTemp <> buscas.FieldByName('LOTEREC').AsInteger) then
            vExibirTotInfCliente := true
          else
            vExibirTotInfCliente := false;     
        end
        else if (Buscas.FieldByName('QTDE_PREST').AsInteger > 1)
        	and (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
        begin
          if (vLoteTemp <> Buscas.FieldByName('LOTEREC').AsInteger) then
            vExibirTotInfCliente := true
          else
            vExibirTotInfCliente := false;
        end
        else
          vExibirTotInfCliente := false;

        if (vExibirTotInfCliente)
        	and (trim(TipoRelatorio) = 'ANALÍTICO')
          and (trim(ExibirDetalhesRec) = 'SIM') then
        begin
          Rdp.ImpD(linha, 104, Format('%f', [vValorTotDoc]), [comp17, negrito]);
          vValorTotDoc := 0;
          linha := linha + 1;
        end;

         //ATUALIZAR
        vLote := buscas.FieldByName('LOTEREC').AsInteger;
        vSeqId := buscas.FieldByName('SEQID').AsInteger;
        //
        vTipoRec := vDadosIni.IfThen(trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO', 'CREDIARIO',
        	vDadosIni.IfThen(trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO', 'RECIBO ANTECIPADO',
           	'SAIDAS'));
        vTipo := trim(buscas.FieldByName('TIPO').AsString);
        vNumDoc := buscas.FieldByName('NUM_DOC').asstring;

        //INCPREST
        if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
        begin
          vTotValorPagoLote := 0;
          vInc := 0;
        end;

        if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
          and (FiltrarCliente)
        	and (vLote = buscas.FieldByName('LOTEREC').AsInteger)
        	and (vSeqId <> buscas.FieldByName('SEQID').AsInteger)
          and (vQtdePrestRec > 1) then
        begin
          vInc := vInc + 1;
        end
        else if ((vLote = buscas.FieldByName('LOTEREC').AsInteger)
        	and (vSeqId <> buscas.FieldByName('SEQID').AsInteger)
          and (buscas.FieldByName('QTDE_PREST').AsInteger > 1)) then
        begin
          vInc := vInc + 1;
        end
        else if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
        begin
          vInc := 1;
          vIncTemp := 0;
        end;

        if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
        	and (FiltrarCliente) 
        	and (vInc = vQtdePrestRec) then
        begin
          if (vLoteTemp <> buscas.FieldByName('LOTEREC').AsInteger) then
          begin
            vLoteTemp := buscas.FieldByName('LOTEREC').AsInteger;
            vExibirInfRec := true;
          end
          else
            vExibirInfRec := false;
        end
        else if (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
        begin
          if (vLoteTemp <> Buscas.FieldByName('LOTEREC').AsInteger) then
          begin
            vLoteTemp := Buscas.FieldByName('LOTEREC').AsInteger;
            vExibirInfRec := true;
          end
          else
            vExibirInfRec := false;
        end
        else
          vExibirInfRec := false;

        if (vExibirInfRec)
        	and (trim(TipoRelatorio) = 'ANALÍTICO')
          and (trim(ExibirDetalhesRec) = 'SIM') then
        begin
          ChecarFimdePagina;
          Rdp.ImpF(linha, 21, vDadosIni.replicate('-', 113), [comp17, negrito]);
          linha := linha + 1;
          Rdp.Imp(linha, 21, '|TP RECEB');
          Rdp.Imp(linha, 37, 'CTRL');
          Rdp.Imp(linha, 53, 'N.DOC');
          Rdp.Imp(linha, 65, 'VL DOC');
          Rdp.Imp(linha, 77, 'N.PROC');
          Rdp.Imp(linha, 89, 'DATA VEN');
          Rdp.Imp(linha, 105, 'N.DATA MOV');
          linha := linha + 1;
          Rdp.Imp(linha, 21, '|');
          linha := linha + 1;
        end;

        if trim(Buscas.FieldByName('TP_REL').AsString) <> 'CREDIARIO' then
	          vExibirDadosRec := true
        else if (trim(Buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
	        and (FiltrarCliente)
          and (vInc = vQtdePrestRec) then
          	vExibirDadosRec := true
        else if (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
  	        vExibirDadosRec := true
        else
    	      vExibirDadosRec := false;

       if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO')
       	 and (FiltrarCliente)
         and (vInc = vQtdePrestRec) then
       begin
       	 if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
         begin
           vTotValorPagoLote     := vValorPagoRec;
           vTotValorPagoLoteOrig := buscas.FieldByName('VALOR_PAGO').AsFloat;
         end
         else
         begin
           vTotValorPagoLote     := vTotValorPagoLote     + vValorPagoRec;
           vTotValorPagoLoteOrig := vTotValorPagoLoteOrig + buscas.FieldByName('VALOR_PAGO').AsFloat;
         end;

         vDiaMov := FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DATA_CONF').AsDateTime);
         if trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO' then
           vTipoMov := 'CREDIARIO'
         else if trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO' then
           vTipoMov := 'RECIBO ANTECIPADO'
         else
           vTipoMov := 'SAIDAS';
       end
       else if (vInc = buscas.FieldByName('QTDE_PREST').AsInteger) then
       begin
         if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           vTotValorPagoLote := buscas.FieldByName('VALOR_PAGO').AsFloat
         else
           vTotValorPagoLote := vTotValorPagoLote + buscas.FieldByName('VALOR_PAGO').AsFloat;

         vDiaMov := FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DATA_CONF').AsDateTime);
         if trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO' then
           vTipoMov := 'CREDIARIO'
         else if trim(buscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO' then
           vTipoMov := 'RECIBO ANTECIPADO'
         else
           vTipoMov := 'SAIDAS';
       end;

       if (vExibirDadosRec) then
       begin
         if (trim(TipoRelatorio) = 'ANALÍTICO')
           and (trim(ExibirDetalhesRec) = 'SIM') then
         begin
           Rdp.Imp(linha, 21, '|' + buscas.FieldByName('TP_RECEBIMENTO2').AsString);
           Rdp.Imp(linha, 37, Copy(trim(buscas.FieldByName('NOME_CTRL').AsString), 1, 12));

           Rdp.Imp(linha, 53, Copy(trim((buscas.FieldByName('NUM_DOC2').AsString)), 1, 10));

           if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') and (FiltrarCliente) and (vValorPagoRec > 0) then
             Rdp.ImpD(linha, 71, Format('%f', [vValorPagoRec]), [comp17])
           else
             Rdp.ImpD(linha, 71, Format('%f', [buscas.FieldByName('VALOR_PAGO').AsCurrency]), [comp17]);

           Rdp.impD(linha, 83, buscas.FieldByName('LOTEREC').AsString, [comp17]);
           Rdp.imp(linha, 89, buscas.FieldByName('DATA_VENC').AsString);
           Rdp.imp(linha, 105, buscas.FieldByName('DATA_MOV').AsString);

           if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') and (FiltrarCliente) then
           begin
             if vValorPagoRec <> buscas.FieldByName('VALOR_PAGO').AsCurrency then
               Rdp.ImpD(linha, 133, '* ' + Format('%f', [buscas.FieldByName('VALOR_PAGO').AsCurrency]), [comp17]);
           end;

           linha := linha + 1;
         end;

         if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') and (FiltrarCliente) then
         begin
         	 vValorTotDoc := vValorTotDoc + vValorPagoRec;
//           if (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'RECIBO') and (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'DEVOLUCAO') then
           begin
             vValorRecPag := vValorRecPag + vValorPagoRec;
	           vValorRecDia := vValorRecDia + vValorPagoRec;
  	         vValorRecRel := vValorRecRel + vValorPagoRec;
           end;
         end
         else
         begin
           vValorTotDoc := vValorTotDoc + Buscas.FieldByName('VALOR_PAGO').AsCurrency;
//           if (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'RECIBO') and (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'DEVOLUCAO') then
           begin
             vValorRecPag := vValorRecPag + buscas.FieldByName('VALOR_PAGO').AsCurrency;
	           vValorRecDia := vValorRecDia + buscas.FieldByName('VALOR_PAGO').AsCurrency;
  	         vValorRecRel := vValorRecRel + buscas.FieldByName('VALOR_PAGO').AsCurrency;
           end;
         end;

         verificarDtSetTemp(buscas);
       end;

       ChecarFimdePagina;

       verificarFimdeRegistros;

       frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
       buscas.next;
     end;

     buscasEmp.Next;
   end;

   Rdp.Fechar;
   buscas.close;
   vDadosIni.GravaAuditoria('REL048', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
	 buscas.Close;
 	 frmRelatorios.ProgressBar.position := 0;
end;

procedure TRelatorioRecebimentosFinanceiro.ImprimirControles(totGeral: boolean);
var
 vValorTotTemp, vValorTotTempRec, vValorTotGTemp, vValorTotRTemp, vValorTotRNaoGeraFinancTemp: Double;
 vValorTemp: Double;
 vPercTemp: Double;
 vPerc: Double;
begin
	if trim(ExibirTotatis) <> 'SIM' then
  begin
  	if not totGeral then
    begin
    	if not buscas.Eof then
      begin
        linha := linha + 1;
		    Rdp.ImpF(linha,1, vDadosIni.Replicate('-',133),[comp17]);
  		  linha := linha + 1;
      end;
    end
    else if buscas.Eof then
    begin
    	linha := linha + 1;
    	Rdp.ImpF(linha,1, vDadosIni.Replicate('=',133),[comp17]);
    end;
    exit;
  end;

  vValorTotTemp := 0;
  vValorTotTempRec := 0;
  vValorTemp := 0;
  vPercTemp := 0;

  ChecarFimdePagina;

  if totGeral then
  begin
    fTempRecTot.Filtered := False;
    fTempRecTot.IndexFieldNames := 'CONTROLE;';
//    if trim(vTipoRec) = 'CREDIARIO' then
//   	  fTempRecTot.Filter := 'TIPO = ''C'' AND DOCS = ''N'' '
//    else if trim(vTipoRec) = 'RECIBO ANTECIPADO' then
//    	fTempRecTot.Filter := 'TIPO = ''R'' AND DOCS = ''N'' '
//    else
//    	fTempRecTot.Filter := 'TIPO = ''V'' AND DOCS = ''N'' ';
  	fTempRecTot.Filter := 'DOCS = ''N'' ';
    fTempRecTot.Filtered := true;
  end
  else
  begin
    if trim(vTipoRec) = 'CREDIARIO' then
    begin
       ftempOrigemRec.Filtered := False;
    	 ftempOrigemRec.IndexFieldNames := 'CONTROLE;';

       if (not totGeral) and (linha + ftempOrigemRec.RecordCount + 2 >= 60) then
       begin
         linha := 2;
         CabNovaPagina;
       end
       else if (not totGeral) then
	       linha := linha + 1;

       Rdp.ImpF(linha, 1, 'ORIGEM CREDI/CHEQUE', [comp17, negrito]);

       Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
		   Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
  		 Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);

       ftempOrigemRec.First;
       while not ftempOrigemRec.Eof do
       begin
         if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
         	 vValorTotTempRec := vValorTotTempRec + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
         	 vValorTotTempRec := vValorTotTempRec + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else
	         vValorTotTemp := vValorTotTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;
         ftempOrigemRec.Next;
       end;

       vValorTotGTemp := 0;
       ftempOrigemRec.First;
       while not ftempOrigemRec.Eof do
       begin
         vPerc := 0;
         if ftempOrigemRec.FieldByName('VALOR').AsCurrency <= 0 then
           vValorTemp := vValorTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else
         begin
           if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
             vValorTemp := vValorTemp + 0
           else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
             vValorTemp := vValorTemp + 0
           else
             vValorTemp := vValorTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;
         end;

         if (vValorTotTemp + vValorTotTempRec = 0) then
           vPerc := 0
         else if ftempOrigemRec.FieldByName('VALOR').AsCurrency <= 0 then
           vPerc := (ftempOrigemRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
         else if ftempOrigemRec.FieldByName('VALOR').AsCurrency > 0 then
           vPerc := (ftempOrigemRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
         vPercTemp := vPercTemp + vPerc;

         if (trim(ftempOrigemRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
         begin
         	 linha := linha + 1;
	         Rdp.Imp(linha, 21, ftempOrigemRec.FieldByName('CONTROLE').asstring);
  	       Rdp.ImpD(linha, 71, Format('%n', [ftempOrigemRec.FieldByName('VALOR').AsCurrency]), [comp17]);
    	     Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

           ChecarFimdePagina;
         end;

         vValorTotGTemp := vValorTotGTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;

         ftempOrigemRec.Next;
       end;

       linha := linha + 1;
       Rdp.ImpD(linha, 71, Format('%n', [vValorTotGTemp]), [comp17, negrito]); //vValorTemp
		   Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);
       linha := linha + 1;
       Rdp.Imp(linha, 1, '-------------------------');


       vValorTotTemp := 0;
       vValorTotTempRec := 0;
 		   vValorTemp := 0;
		   vPercTemp := 0;
    end;

    if trim(vTipoRec) = 'CREDIARIO' then
      fTempRec.Filter := 'TIPO = ''C'' '
    else if trim(vTipoRec) = 'RECIBO ANTECIPADO' then
      fTempRec.Filter := 'TIPO = ''R'' '
    else
      fTempRec.Filter := 'TIPO = ''V'' ';
    fTempRec.Filtered := True;
    fTempRec.IndexFieldNames := 'CONTROLE;';
  end;

  if (totGeral) and (linha + fTempRecTot.RecordCount + 2 >= 60) then
  begin
  	linha := 2;
    CabNovaPagina;
  end
  else if (not totGeral) and (linha + fTempRec.RecordCount + 2 >= 60) then
  begin
    linha := 2;
    CabNovaPagina;
  end
  else if (not totGeral) then//and (trim(vTipoRec) = 'CREDIARIO') then
	  linha := linha + 1;

  if totGeral then
  begin
//  	linha := linha + 1;
    Rdp.ImpF(linha, 1, 'TOTAL CONTROLES À VISTA', [normal, negrito]);
    linha := linha + 2;
  end
  else
  begin
  	if trim(vTipoRec) = 'CREDIARIO' then
      Rdp.ImpF(linha, 1, 'TOTAL CREDI/CHEQUE', [comp17, negrito])
    else if (not FiltrarVenda) and (trim(vTipoRec) = 'RECIBO ANTECIPADO') then
      Rdp.ImpF(linha, 1, 'TOTAL RECIBO ANT', [comp17, negrito])
    else if not FiltrarVenda then
      Rdp.ImpF(linha, 1, 'TOTAL SAÍDAS/VENDA', [comp17, negrito])
    else if trim(Venda) = 'SIM' then
      Rdp.ImpF(linha, 1, 'TOTAL VENDA', [comp17, negrito])
    else
      Rdp.ImpF(linha, 1, 'TOTAL NÃO É VENDA', [comp17, negrito]);
  end;
  Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
  Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
  Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);

  if totGeral then
  begin
    fTempRecTot.First;
    while not fTempRecTot.Eof do
    begin
    	if (fTempRecTot.FieldByName('DOCS').AsString = 'N')
      	and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> 'CONTAS A PAGAR')
      	and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
	      and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
      begin
        if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
          vValorTotTempRec := vValorTotTempRec + fTempRecTot.FieldByName('VALOR').AsCurrency
        else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
          vValorTotTempRec := vValorTotTempRec + fTempRecTot.FieldByName('VALOR').AsCurrency
        else
          vValorTotTemp := vValorTotTemp + fTempRecTot.FieldByName('VALOR').AsCurrency;
      end;

      fTempRecTot.Next;
    end;

    vValorTotGTemp              := 0;
    vValorTotRTemp              := 0;
    vValorTotRNaoGeraFinancTemp := 0;
    fTempRecTot.First;
    while not fTempRecTot.Eof do
    begin
    	if (fTempRecTot.FieldByName('DOCS').AsString = 'N')
      	and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> 'CONTAS A PAGAR')
      	and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
	      and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
      begin
        vPerc := 0;
        if fTempRecTot.FieldByName('VALOR').AsCurrency <= 0 then
          vValorTemp := vValorTemp + fTempRecTot.FieldByName('VALOR').AsCurrency
        else
        begin
          if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
            vValorTemp := vValorTemp + 0
          else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
            vValorTemp := vValorTemp + 0
          else
            vValorTemp := vValorTemp + fTempRecTot.FieldByName('VALOR').AsCurrency;
        end;

        if (vValorTotTemp + vValorTotTempRec = 0) then
          vPerc := 0
        else if fTempRecTot.FieldByName('VALOR').AsCurrency <= 0 then
        	vPerc := (fTempRecTot.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
        else if fTempRecTot.FieldByName('VALOR').AsCurrency > 0 then
          vPerc := (fTempRecTot.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
        vPercTemp := vPercTemp + vPerc;

        if (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
        begin
        	linha := linha + 1;
          if trim(fTempRecTot.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
            Rdp.Imp(linha, 21, fTempRecTot.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
          else
            Rdp.Imp(linha, 21, fTempRecTot.FieldByName('CONTROLE').asstring);
          Rdp.ImpD(linha, 71, Format('%n', [fTempRecTot.FieldByName('VALOR').AsCurrency]), [comp17]);
          Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

          ChecarFimdePagina;
        end;

        vValorTotGTemp := vValorTotGTemp + fTempRecTot.FieldByName('VALOR').AsCurrency;
        if (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> 'CONTAS A PAGAR')
        	and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
	        and (trim(fTempRecTot.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
		        vValorTotRTemp := vValorTotRTemp + fTempRecTot.FieldByName('VALOR').AsCurrency;

        if (trim(fTempRecTot.FieldByName('NAO_GERA_FINAN').asstring) = 'S') then
        	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + fTempRecTot.FieldByName('VALOR').AsCurrency;
      end;

      fTempRecTot.Next;
    end;
  end
  else
  begin
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else
	      vValorTotTemp := vValorTotTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      fTempRec.Next;
    end;

    vValorTotGTemp              := 0;
    vValorTotRTemp              := 0;
    vValorTotRNaoGeraFinancTemp := 0;
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      vPerc := 0;
      if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
        vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency
      else
      begin
        if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
          vValorTemp := vValorTemp + 0
        else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
          vValorTemp := vValorTemp + 0
        else
          vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      end;

      if (vValorTotTemp + vValorTotTempRec = 0) then
        vPerc := 0
      else if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
      	vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
      else if fTempRec.FieldByName('VALOR').AsCurrency > 0 then
      	vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
    	vPercTemp := vPercTemp + vPerc;

      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
      begin
      	linha := linha + 1;
        if trim(fTempRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
          Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
        else
       	  Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring);
        Rdp.ImpD(linha, 71, Format('%n', [fTempRec.FieldByName('VALOR').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

        ChecarFimdePagina;
      end;

      vValorTotGTemp := vValorTotGTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
        and (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
		      vValorTotRTemp := vValorTotRTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      if (trim(fTempRec.FieldByName('NAO_GERA_FINAN').asstring) = 'S') then
      	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      fTempRec.Next;
    end;
  end;
  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL RECEBIMENTO....: ' + Format('%n', [vValorTotRTemp]), [comp17, negrito]);
  Rdp.ImpD(linha, 71, Format('%n', [vValorTotGTemp]), [comp17, negrito]); //vValorTemp
  Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL GERA FINANCEIRO: ' + Format('%n', [vValorTotRTemp - vValorTotRNaoGeraFinancTemp]), [comp17, negrito]);

  if not totGeral then
  begin
  	linha := linha + 1;

    ImprimirTotalPagina(totGeral);
  end;

  if not totGeral then
    if (trim(vTipoRec) = 'CREDIARIO') or (trim(vTipoRec) = 'SAIDAS') then
    begin
      linha := linha + 2;
      if trim(vTipoRec) = 'CREDIARIO' then
        Rdp.ImpD(linha, 1, 'ATRASO MEDIO NO RECEBIMENTO (AMR) ' + vDadosIni.StrZero(MonthOf(datainicial), 2) + '/' + IntToStr(YearOf(datainicial)) + ': ' + vAtrasoMedioRec, [comp17, negrito])
      else if trim(vTipoRec) = 'SAIDAS' then
        Rdp.ImpD(linha, 1, 'PRAZO MEDIO DE VENDA (PMV) ' + vDadosIni.StrZero(MonthOf(datainicial), 2) + '/' + IntToStr(YearOf(datainicial)) + ': ' + vPrazoMedioVenda, [comp17, negrito]);
    end;

  if not totGeral then
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha,1, vDadosIni.Replicate('-',133),[comp17]);
    linha := linha + 1;
  end
  else
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha,1, vDadosIni.Replicate('=',133),[comp17]);
  end;
end;

procedure TRelatorioRecebimentosFinanceiro.ImprimirTotalDiario;
begin
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TOTAL ' + vDiaMov, [comp17, negrito]);
  if trim(vTipoRec) = 'CREDIARIO' then
  	 Rdp.ImpF(linha, 21, 'TOTAL CREDI/CHEQUE:', [comp17, negrito])
  else if (not FiltrarVenda) and (trim(vTipoRec) = 'RECIBO ANTECIPADO') then
     Rdp.ImpF(linha, 21, 'TOTAL RECIBO ANT:', [comp17, negrito])
  else if (not FiltrarVenda) then
     Rdp.ImpF(linha, 21, 'TOTAL SAÍDAS/VENDA:', [comp17, negrito])
  else if trim(Venda) = 'SIM' then
    Rdp.ImpF(linha, 21, 'TOTAL VENDA:', [comp17, negrito])
  else
    Rdp.ImpF(linha, 21, 'TOTAL NÃO É VENDA:', [comp17, negrito]);
  Rdp.ImpD(linha, 58, Format('%n', [vValorTotDia]), [comp17, negrito]);
  Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
  Rdp.ImpD(linha, 115, Format('%n', [vValorRecDia]), [comp17, negrito]);

  vValorTotDia := 0;
  vValorRecDia := 0;

  linha := linha + 1;
  ChecarFimdePagina;
end;

procedure TRelatorioRecebimentosFinanceiro.ImprimirTotalDocumento;
begin
  if (trim(TipoRelatorio) = 'ANALÍTICO')
	  and (trim(ExibirDetalhesRec) = 'SIM') then
  begin
    Rdp.Imp(linha, 21, '|');
    Rdp.ImpD(linha, 71, Format('%f', [vTotValorPagoLote]), [comp17, negrito]);

    if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') and (FiltrarCliente) then
    begin
      if vTotValorPagoLoteOrig <> vTotValorPagoLote then
        Rdp.ImpD(linha, 133, '* ' + Format('%f', [vTotValorPagoLoteOrig]), [comp17, negrito]);
      vTotValorPagoLoteOrig := 0;
    end;

    linha := linha + 1;
    Rdp.ImpF(linha, 21, vDadosIni.replicate('-', 113), [comp17, negrito]);
    linha := linha + 1;

    vValorTotDoc := 0;
  end;
end;

procedure TRelatorioRecebimentosFinanceiro.ImprimirTotalPagina(totaltipo: boolean);
begin
  linha := linha + 1;
  if (linha >= 58) then
    if totaltipo then
      Rdp.ImpF(linha, 1, 'TOTAL GERAL', [comp17, negrito]);

  if totaltipo then
    Rdp.ImpF(linha, 21, 'TOTAL GERAL:', [comp17, negrito])
  else if trim(vTipoRec) = 'CREDIARIO' then
    Rdp.ImpF(linha, 21, 'TOTAL CREDI/CHEQUE:', [comp17, negrito])
  else if (not FiltrarVenda) and (trim(vTipoRec) = 'RECIBO ANTECIPADO') then
    Rdp.ImpF(linha, 21, 'TOTAL RECIBO ANT:', [comp17, negrito])
  else if not FiltrarVenda then
    Rdp.ImpF(linha, 21, 'TOTAL SAÍDAS/VENDA:', [comp17, negrito])
  else if trim(Venda) = 'SIM' then
    Rdp.ImpF(linha, 21, 'TOTAL VENDA:', [comp17, negrito])
  else
    Rdp.ImpF(linha, 21, 'TOTAL NÃO É VENDA:', [comp17, negrito]);
 
  if totaltipo then
  	Rdp.ImpD(linha, 58, Format('%n', [vValorTotRel]), [comp17, negrito])
	else
  begin
	  Rdp.ImpD(linha, 58, Format('%n', [vValorTotPag]), [comp17, negrito]);
    vValorTotPag := 0;
  end;
  Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
  if totaltipo then
  	Rdp.ImpD(linha, 115, Format('%n', [vValorRecRel]), [comp17, negrito])
  else
  begin
	  Rdp.ImpD(linha, 115, Format('%n', [vValorRecPag]), [comp17, negrito]);
    vValorRecPag := 0;
  end;
end;

procedure TRelatorioRecebimentosFinanceiro.verificarDtSetTemp(pBuscas: TIBQuery);
begin
   if trim(pBuscas.FieldByName('TP_REL').AsString) = 'CREDIARIO' then
   begin
    	ftempOrigemRec.Filter := 'TIPO = ''C'' AND CONTROLE = ' + QuotedStr(trim(pBuscas.FieldByName('TIPO').AsString));
      ftempOrigemRec.Filtered := True;
      if ftempOrigemRec.IsEmpty then
      begin
        ftempOrigemRec.Insert;
        ftempOrigemRec.FieldByName('CONTROLE').AsString := trim(pBuscas.FieldByName('TIPO').AsString);
      end
      else
        ftempOrigemRec.Edit;
      if trim(pBuscas.FieldByName('TP_REL').AsString) = 'CREDIARIO' then
      	ftempOrigemRec.FieldByName('TIPO').AsString := 'C'
      else if trim(pBuscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO' then
      	ftempOrigemRec.FieldByName('TIPO').AsString := 'R'
      else
      	ftempOrigemRec.FieldByName('TIPO').AsString := 'V';  

      if (trim(pBuscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') and (FiltrarCliente) then
      	ftempOrigemRec.FieldByName('VALOR').AsFloat := ftempOrigemRec.FieldByName('VALOR').AsFloat + vValorPagoRec
      else if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'TROCO' then
      	ftempOrigemRec.FieldByName('VALOR').AsFloat := ftempOrigemRec.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO').AsCurrency
      else if pBuscas.FieldByName('VALOR_PAGO').AsCurrency > 0 then
      	ftempOrigemRec.FieldByName('VALOR').AsFloat := ftempOrigemRec.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO').AsCurrency;
	   ftempOrigemRec.Post;
   end;

   if trim(pBuscas.FieldByName('TP_REL').AsString) = 'CREDIARIO' then
     fTempRec.Filter := 'TIPO = ''C'' '
   else if trim(pBuscas.FieldByName('TP_REL').AsString) = 'RECIBO ANTECIPADO' then
     fTempRec.Filter := 'TIPO = ''R'' '
   else
     fTempRec.Filter := 'TIPO = ''V'' ';

   if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'RECIBO' then
	   fTempRec.Filter := fTempRec.Filter + ' AND CONTROLE = ''* RECIBO (APENAS INFORMATIVO)'' '
   else if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'DEVOLUCAO' then
