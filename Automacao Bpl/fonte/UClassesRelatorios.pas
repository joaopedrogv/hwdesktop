  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|CONSULTOR||||');
  vListaLadB.Add('111|QTDE||||');
  vtotpass:=0;
  while not buscas.eof do
  begin
   vListaLadB.Add('||||P|');
   vListaLadB.Add('65|'+buscas.FieldByName('NOME_VENDEDOR').AsString+'||||');
   vListaLadB.Add('111|'+vDadosIni.StrZero(buscas.FieldByName('valor').AsInteger,5)+'||||');
   vtotpass := vtotpass + buscas.FieldByName('valor').AsInteger;
   buscas.next;
  end;
  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|TOTAL||||');
  vListaLadB.Add('111|'+vDadosIni.StrZero(vtotpass,5)+'||||');
  vListaLadB.Add('||||P|');
  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|PASSAGENS POR MECÂNICOS|[normal, negrito]|||');
  buscas.close;
  buscas.sql.text := ' SELECT COL.NOME_VENDEDOR,COUNT(DISTINCT PD.NPED) AS VALOR FROM PEDVENDA PD,PEDVENDA_SERV PDS,COLABORADOR COL '+
    ' WHERE PD.DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datainicial)) +
    ' AND PD.DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datafinal)) +
