end;

procedure TRelatorioPosicaodeEstoqueVeiculos.ImprimeRelatorios;
var
  vdimn, vdim, vtotc, vtott, vtotd, vtotdv, vtotf, vtotg: integer;
  vtotrg, vtotrv, vtotng: integer;
  QrCasa, QrDemonst, QrDemovend, QrQtTransito, QrResGer, QrResGT, QrResVend, QrResNVend, QrResNVendT, QrResVndT: TIBQuery;
begin
  if not vDadosIni.PesqPros('REL033', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

 //Inicia a Impressão.
  QrCasa := TIBQuery.Create(Application);
  QrCasa.Database := buscas.Database;
  QrCasa.Transaction := buscas.Transaction;

  QrDemonst := TIBQuery.Create(Application);
  QrDemonst.Database := buscas.Database;
  QrDemonst.Transaction := buscas.Transaction;

  QrDemovend := TIBQuery.Create(Application);
  QrDemovend.Database := buscas.Database;
  QrDemovend.Transaction := buscas.Transaction;

  QrQtTransito := TIBQuery.Create(Application);
  QrQtTransito.Database := buscas.Database;
  QrQtTransito.Transaction := buscas.Transaction;

  QrResGer := TIBQuery.Create(Application);
  QrResGer.Database := buscas.Database;
  QrResGer.Transaction := buscas.Transaction;

  QrResGT := TIBQuery.Create(Application);
  QrResGT.Database := buscas.Database;
  QrResGT.Transaction := buscas.Transaction;

  QrResVend := TIBQuery.Create(Application);
  QrResVend.Database := buscas.Database;
  QrResVend.Transaction := buscas.Transaction;

  QrResNVendT := TIBQuery.Create(Application);
  QrResNVendT.Database := buscas.Database;
  QrResNVendT.Transaction := buscas.Transaction;

  QrResNVendT := TIBQuery.Create(Application);
  QrResNVendT.Database := buscas.Database;
  QrResNVendT.Transaction := buscas.Transaction;

  QrResNVend := TIBQuery.Create(Application);
  QrResNVend.Database := buscas.Database;
  QrResNVend.Transaction := buscas.Transaction;

  QrResVndT := TIBQuery.Create(Application);
  QrResVndT.Database := buscas.Database;
  QrResVndT.Transaction := buscas.Transaction;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Posição de Estoque Veículos';
  rdp.TitulodoRelatorio := 'Posição de Estoque Veículos';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  abrePosicaodeEstoqueVeiculos;
//  if dtmRelatorios.cds99.IsEmpty then
//  begin
//   Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//   exit;
//  end;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := dtmRelatorios.cds99.RecordCount;
    dtmRelatorios.cds99.First;
  end;
  vtotc := 0;
  vtott := 0;
  vtotd := 0;
  vtotf := 0;
  vtotg := 0;
  vtotrg := 0;
  vtotrv := 0;
  vtotng := 0;
  vtotdv := 0;
  vpag := 0;
  CabNovaPagina;

  dtmRelatorios.cds99.First;
  while not dtmRelatorios.cds99.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    vdim := 0;
    vdimn := 0;
    // Veículos Vivos com Estoque
    QrCasa.close;
    QrCasa.SQL.Text := ' select count(*) from Est_Moto ' +
     ' where versaoEst = :vversao and (coalesce(status_estoque, '''') = ''S'') ' +
     ' and (trim(coalesce(posicao, ''VIVO'')) <> ''MORTO'') ' +
     ' and  cod_empresa = :cod_empresa and ativo = 1';
    QrCasa.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
    QrCasa.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
    QrCasa.open;

    // Veículos em Demonstração
    QrDemonst.close;
    QrDemonst.SQL.Text := ' select count(*) from Est_Moto where versaoEst = :vversao ' +
     ' and (coalesce(status_demonst, '''') = ''S'') and (trim(coalesce(posicao, ''VIVO'')) <> ''MORTO'') ' +
     ' and cod_empresa = :cod_empresa and ativo = 1';
    QrDemonst.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
    QrDemonst.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
    QrDemonst.open;

    // Veículos em Demonstração reservados para venda
    QrDemovend.close;
    QrDemovend.SQL.Text := ' select count(*) from Est_Moto where versaoEst = :vversao ' +
     ' and (trim(coalesce(status_demonst, '''')) = ''S'') ' +
     ' and (trim(coalesce(status_res, '''')) = ''S'') ' +
     ' and (trim(coalesce(posicao, ''VIVO'')) <> ''MORTO'') ' +
     ' and sit_res = ''V'' and cod_empresa = :cod_empresa and ativo = 1';
    QrDemovend.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
    QrDemovend.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
    QrDemovend.open;

    // Veículos em Transito não reservados para venda
    QrQtTransito.close;
    QrQtTransito.SQL.Text := ' select count(*) from est_moto itr ' +
     ' inner join tipmodelo tpm on tpm.codigo = itr.versaoest and tpm.cod_empresa = itr.cod_empresa ' +
     ' left join nf_transito tr on tr.n_caixa = itr.n_caixa and tr.num_notat = itr.num_nota and tr.cod_empresa = itr.cod_empresa ' +
     ' where (((tr.statust is null or trim(tr.statust) = '''') and (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO''))' +
     ' or (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO'')) ' +
//     ' and ((trim(coalesce(itr.status_res, '''')) = '''') or (trim(coalesce(itr.status_res, '''')) = ''N'')) ' +
     ' and tpm.codigo = :vversao and tpm.cod_empresa = :COD_EMPRESA and itr.ativo = 1 ';
    QrQtTransito.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
    QrQtTransito.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
    QrQtTransito.open;

    linha := linha + 1;
    if trim(TipoRelatorio) = '1' then
    begin
      // Veículos não reservados para venda
      QrResGer.close;
      QrResGer.SQL.Text := ' select count(*) from Est_Moto est ' +
       ' where ((trim(coalesce(est.status_res, '''')) = '''') or (trim(coalesce(est.status_res, '''')) = ''N'')) ' +
       ' and est.versaoest = :vversao and est.cod_empresa = :cod_empresa and est.ativo = 1 ' +
       ' and (trim(coalesce(est.posicao, ''VIVO'')) <> ''MORTO'') and (trim(coalesce(est.posicao, ''VIVO'')) <> ''TRANSITO'') ';
      QrResGer.Params[0].value := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResGer.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResGer.open;

      // Veículos não reservados para venda e em trânsito
      QrResGT.close;
      QrResGT.SQL.Text := ' select count(*) from Est_Moto est ' +
       ' where((trim(coalesce(est.status_res, '''')) = '''') or (trim(coalesce(est.status_res, '''')) = ''N'')) ' +
       ' and est.versaoest = :vversao and est.cod_empresa = :cod_empresa and est.ativo = 1 ' +
       ' and (trim(coalesce(est.posicao, ''VIVO'')) = ''TRANSITO'') ';
      QrResGT.Params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResGT.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResGT.open;

      vdim := QrResGer.FieldByName('COUNT').AsInteger + QrResGT.FieldByName('COUNT').AsInteger;
      vtotrg := vtotrg + vdim;
      Rdp.ImpF(linha, 41, vDadosIni.Strzero(vdim, 3), [comp17]);
    end
    else
    begin
      // Veículos não vendidos, não reservados, e situacao da reserva "Vendido"
      QrResVend.close;
      QrResVend.SQL.Text := ' select count(*) from Est_Moto est ' +
       ' where ((trim(coalesce(est.status_res, '''')) = '''') or (trim(coalesce(est.status_res, '''')) = ''N'')) ' +
       ' and est.versaoest = :vversao and est.sit_res = ''V'' ' +
       ' and est.cod_empresa = :cod_empresa and est.ativo = 1 ' +
       ' and (trim(coalesce(est.posicao, ''VIVO'')) <> ''MORTO'') ';
      QrResVend.Params[0].value := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResVend.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResVend.open;

      // Veículos não vendidos, não reservados, e situacao da reserva "Vendido", e se encontra em transito
      QrResVndT.close;
      QrResVndT.SQL.Text := ' select count(*) from est_moto itr' +
       ' inner join tipmodelo tpm on tpm.codigo = itr.versaoest and tpm.cod_empresa = itr.cod_empresa ' +
       ' left join nf_transito tr on tr.n_caixa = itr.n_caixa and tr.num_notat = itr.num_nota and tr.cod_empresa = itr.cod_empresa ' +
       ' where tpm.codigo = :vversao  ' +
       //' and (trim(coalesce(itr.posicao, ''VIVO'')) <> ''MORTO'')
       ' and (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO'') ' +
       ' and tpm.cod_empresa = :COD_EMPRESA and itr.ativo = 1 ' +
       ' and (itr.status_res is null or trim(itr.status_res) = '''') and itr.sit_res = ''V'' ';
      QrResVndT.Params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResVndT.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResVndT.open;

      vdim := QrResVend.FieldByName('COUNT').AsInteger + QrResVndT.FieldByName('COUNT').AsInteger;
      if QrDemovend.FieldByName('COUNT').AsInteger <> 0 then
        vtotrv := vtotrv + (vdim - QrDemovend.FieldByName('COUNT').AsInteger)
      else
        vtotrv := vtotrv + vdim;
      if QrDemovend.FieldByName('COUNT').AsInteger <> 0 then
        Rdp.ImpF(linha, 30, vDadosIni.Strzero(vdim - QrDemovend.FieldByName('COUNT').AsInteger, 3), [comp17])
      else
        Rdp.ImpF(linha, 30, vDadosIni.Strzero(vdim, 3), [comp17]);

      // Veículos não vendidos, não reservados, e situacao da reserva "Não Vendido"
      QrResNVend.close;
      QrResNVend.SQL.Text := 'select count(*) from Est_Moto est ' +
       ' where ((trim(coalesce(est.status_res, '''')) = '''') or (trim(coalesce(est.status_res, '''')) = ''N'')) ' +
       ' and est.versaoest = :vversao and est.sit_res = ''N'' ' +
       ' and est.cod_empresa = :cod_empresa and est.ativo = 1 ' +
       ' and (trim(coalesce(est.posicao, ''VIVO'')) <> ''MORTO'')';
      QrResNVend.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResNVend.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResNVend.open;

      // Veículos não vendidos, não reservados, e situacao da reserva "Não Vendido", e se encontra em transito
      QrResNVendT.close;
      QrResNVendT.SQL.Text := ' select count(*) from est_moto itr ' +
        ' inner join tipmodelo tpm on tpm.codigo = itr.versaoest and tpm.cod_empresa = itr.cod_empresa ' +
        ' left join nf_transito tr on tr.n_caixa = itr.n_caixa and tr.num_notat = itr.num_nota and tr.cod_empresa = itr.cod_empresa ' +
        ' where ((trim(coalesce(itr.status_res, '''')) = '''') or (trim(coalesce(itr.status_res, '''')) = ''N'')) and itr.sit_res = ''N'' ' +
        ' and (tr.statust is null or trim(tr.statust) = '''') ' +
        ' and tpm.codigo = :vversao ' +
        ' and itr.cod_empresa = :COD_EMPRESA and itr.ativo = 1 and (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO'') ';
      QrResNVendT.params[0].AsInteger := dtmRelatorios.cds99.FieldByName('CODIGO').AsInteger;
      QrResNVendT.params[1].AsInteger := StrToInt(vDadosIni.codEmpresa);
      QrResNVendT.open;

      vdimn := QrResNVend.FieldByName('COUNT').AsInteger + QrResNVendT.FieldByName('COUNT').AsInteger;
      vtotng := vtotng + vdimn;
      Rdp.ImpF(linha, 51, vDadosIni.Strzero(vdimn, 3), [comp17]);
    end;
    Rdp.Imp(linha, 1, copy(trim(dtmRelatorios.cds99.FieldByName('DESCRICAO').AsString), 1, 18));
    Rdp.Imp(linha, 20, vDadosIni.Strzero(QrCasa.FieldByName('COUNT').AsInteger, 3));
    Rdp.Imp(linha, 61, vDadosIni.Strzero(QrQtTransito.FieldByName('COUNT').AsInteger, 3));
    //  if not RadioButton2.checked then
    Rdp.Imp(linha, 79, vDadosIni.Strzero(QrDemonst.FieldByName('COUNT').AsInteger, 3));
    Rdp.Imp(linha, 90, vDadosIni.Strzero(QrDemovend.FieldByName('COUNT').AsInteger, 3));
    //  else
    //   Rdp.Imp(linha,79,strzero(QrDemonstCOUNT.value-QrResVendCOUNT.value,3));
    Rdp.Imp(linha, 101, vDadosIni.Strzero(dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger, 3));
    if trim(TipoRelatorio) = '1' then
      Rdp.Imp(linha, 112, vDadosIni.Strzero((QrCasa.FieldByName('COUNT').AsInteger - vdim) + QrQtTransito.FieldByName('COUNT').AsInteger +
        QrDemonst.FieldByName('COUNT').AsInteger + dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger {-QrDemovendCOUNT.value}, 3))
    else
      Rdp.Imp(linha, 112, vDadosIni.Strzero(QrCasa.FieldByName('COUNT').AsInteger + QrQtTransito.FieldByName('COUNT').AsInteger
       + QrDemonst.FieldByName('COUNT').AsInteger + dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger {-QrDemovendCOUNT.value}, 3));
    //  if RadioButton2.checked then
    vtotc := vtotc + (QrCasa.FieldByName('COUNT').AsInteger);
    //  else
    //   vtotc:=vtotc+QrCasaCOUNT.value;
    vtott := vtott + QrQtTransito.FieldByName('COUNT').AsInteger;
    //if not RadioButton2.checked then
    vtotd := vtotd + QrDemonst.FieldByName('COUNT').AsInteger;
    vtotdv := vtotdv + QrDemovend.FieldByName('COUNT').AsInteger;
    //  else
    //   vtotd:=vtotd+(QrDemonstCOUNT.value-QrResVendCOUNT.value);

    vtotf := vtotf + dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger;
    if trim(TipoRelatorio) = '1' then
      vtotg := vtotg + ((QrCasa.FieldByName('COUNT').AsInteger - vdim) + QrQtTransito.FieldByName('COUNT').AsInteger +
        QrDemonst.FieldByName('COUNT').AsInteger + dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger {-QrDemovendCOUNT.value})
    else
      vtotg := vtotg + (QrCasa.FieldByName('COUNT').AsInteger + QrQtTransito.FieldByName('COUNT').AsInteger +
        QrDemonst.FieldByName('COUNT').AsInteger + dtmRelatorios.cds99.FieldByName('AFATURAR').AsInteger {-QrDemovendCOUNT.value});

    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;    
    dtmRelatorios.cds99.next;
    if linha >= 58 then
    begin
      linha := linha + 1;
      Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
      linha := 1;
      CabNovaPagina;
    end;
  end;
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.Impf(linha, 20, vDadosIni.Strzero(vtotc, 3), [comp17]);
  Rdp.ImpF(linha, 30, vDadosIni.Strzero(vtotrv, 3), [comp17]);
  Rdp.ImpF(linha, 41, vDadosIni.Strzero(vtotrg, 3), [comp17]);
  Rdp.ImpF(linha, 51, vDadosIni.Strzero(vtotng, 3), [comp17]);
  Rdp.Impf(linha, 61, vDadosIni.Strzero(vtott, 3), [comp17]);
  Rdp.Impf(linha, 79, vDadosIni.Strzero(vtotd, 3), [comp17]);
  Rdp.Impf(linha, 90, vDadosIni.Strzero(vtotdv, 3), [comp17]);
  Rdp.Impf(linha, 101, vDadosIni.Strzero(vtotf, 3), [comp17]);
  Rdp.Impf(linha, 112, vDadosIni.Strzero(vtotg, 3), [comp17]);
  Rdp.fechar;
  QrCasa.close;
  QrDemonst.close;
  QrQtTransito.close;
  QrResGer.Close;
  QrResGT.Close;
  QrResVend.Close;
  QrResNVend.Close;
  QrResNVendT.Close;
  QrResVndT.Close;
   vDadosIni.GravaAuditoria('REL033', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  frmRelatorios.ProgressBar.position := 0;
end;

{ TRelatorioVeiculosemTransito }

function TRelatorioVeiculosemTransito.abreVeiculosemTransito: Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := ' select itr.descricao_versaoest, itr.num_nota, itr.corest, itr.chassi_c, itr.ano_fabest, ' +
   ' itr.ano_modest, itr.data_res, itr.sit_res from est_moto itr ' +
   ' inner join tipmodelo tpm on tpm.codigo = itr.versaoest and tpm.cod_empresa = itr.cod_empresa ' +
   ' left join nf_transito tr on tr.n_caixa = itr.n_caixa and tr.num_notat = itr.num_nota and tr.cod_empresa = itr.cod_empresa ' +
   ' where (((tr.statust is null or trim(tr.statust) = '''') and (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO'')) ' +
   ' or (trim(coalesce(itr.posicao, ''VIVO'')) = ''TRANSITO'')) ' +
   ' and itr.cod_empresa = :COD_EMPRESA and itr.ativo = 1 ' +
   ' order by itr.descricao_versaoest, itr.corest';
  buscas.ParamByName('cod_empresa').AsInteger:= StrToInt(vDadosIni.codEmpresa);
  buscas.Open;
end;

