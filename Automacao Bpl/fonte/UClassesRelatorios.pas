 Rdp.ImpF(linha, 80, 'Data/Hora: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
 linha := linha + 2;
 Rdp.imp(linha, 1, 'CHASSI');
 Rdp.imp(linha, 22, '      VALOR');
 Rdp.imp(linha, 36, 'DT.CHEG.MT');
 Rdp.imp(linha, 48, 'DATA PAG');
 Rdp.imp(linha, 60, 'DATA VENC.');
 Rdp.imp(linha, 72, 'N. DOC');
 Rdp.imp(linha, 86, 'VALOR DO BEM');
 linha := linha + 2;
end;

