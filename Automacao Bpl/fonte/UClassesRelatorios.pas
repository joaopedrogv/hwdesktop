  Rdp.ImpD(linha, 42, vDadosIni.StrZero(buscas5.FieldByName('qtdREQ').AsInteger, 6), [comp17, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'QUANTIDADE TOTAL DE OS...........: ', [comp17, negrito]);
  Rdp.ImpD(linha, 42, vDadosIni.StrZero(buscas5.FieldByName('qtdOS').AsInteger, 6), [comp17, negrito]);
  //  end;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  frmRelatorios.ProgressBar.position := 0;

  frmRelatorios.ProgressBar.position := 0;
