    qrBuscas.SQL.Text := 'select sum ( pvp.pcust_mc * pvp.quant_ped_item ) valor ' +
      'from pedvenda pv ' +
      'inner join pedvenda_prod pvp on pv.nped = pvp.nped ' +
      'and pv.tipo = pvp.tipo and pv.cod_empresa = pvp.cod_empresa ' +
      'where pv.data_fech >= :dataini and pv.data_fech <= :datafin ' +
      'and (pv.tipo_os LIKE ''INTERN%'' or pv.tipo_os LIKE ''GARANTIA%'' or ' +
      'pv.tipo_os LIKE ''CORTE%'') ' +
      'and pv.cod_empresa = :cod_empresa ' +
      'and pv.tipo = ''OS'' ' +
      'and pv.ativo = 1 ';

    qrBuscas.Open;
  end;
end;

function TRelatorioVendasGeral.SelecionaVendasAgrupadas: Boolean;
var
  variavel: string;
begin
  with dtmRelatorios do
  begin

    variavel := '';
    qrBuscas.Close;
    qrBuscas.SQL.Clear;

    qrBuscas.Params.CreateParam(ftDate, 'dataini', ptUnknown);
    qrBuscas.Params.CreateParam(ftDate, 'datafin', ptUnknown);
    qrBuscas.Params.CreateParam(ftUnknown, 'cod_empresa', ptUnknown);

    qrBuscas.Params.ParamByName('dataini').AsDate := Fdatainicial;
    qrBuscas.Params.ParamByName('datafin').AsDate := Fdatafinal;
    qrBuscas.Params.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;

    variavel := 'select grupo_prod, cod_prod, ' +
      'sum (vtot_venda - desconto) valortotal, ' +
      'sum (vqt) quantidade ' +
      'from vendasmeses4 ' +
      'where data_os_rq >= :dataini ' +
      'and data_os_rq <= :datafin ' +
      'and cod_empresa = :cod_empresa ' +
      'and ativo = 1 ' +
      'group by 1,2 ' +
      'order by 1 ';

    qrBuscas.SQL.Text := variavel;
    qrBuscas.Open;

    if FtotalGrupo = 'Sim' then
    begin
      variavel := '';
      qrbuscas2.Close;
      qrbuscas2.SQL.Clear;

      qrbuscas2.Params.CreateParam(ftDate, 'dataini', ptUnknown);
      qrbuscas2.Params.CreateParam(ftDate, 'datafin', ptUnknown);
      qrbuscas2.Params.CreateParam(ftUnknown, 'cod_empresa', ptUnknown);

      qrbuscas2.Params.ParamByName('dataini').AsDate := Fdatainicial;
      qrbuscas2.Params.ParamByName('datafin').AsDate := Fdatafinal;
      qrbuscas2.Params.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;

      variavel := 'select it.grupo_prod, gr.descricao, ' +
        'sum (it.vqt ) quantidade, ' +
        'sum (it.vtot_venda - it.desconto) valortotal, ' +
        'count (it.ndoc) qtdeVendas ' +
        'from vendasmeses4 it,grupos gr ' +
        'where it.grupo_prod = gr.codigo_grup ' +
        'and data_os_rq >= :dataini and data_os_rq <= :datafin ' +
        'and it.cod_empresa = :cod_empresa ' +
        'and it.ativo=1 ' +
        'group by 1,2 ' +
        'order by 1 ';

      qrbuscas2.SQL.Text := variavel;
      qrbuscas2.Open;
    end;
  end;
end;

