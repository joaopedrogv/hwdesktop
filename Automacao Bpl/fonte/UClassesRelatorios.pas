procedure TRelatorioRecebimentosCaixaAuxiliar.ImprimirTotalOperador;
var
 vValorTotTemp, vValorTotTempRec, vValorTotGTemp, vValorTotRTemp, vValorTotRNaoGeraFinancTemp: Double;
 vValorTemp: Double;
 vPercTemp: Double;
 vPerc: Double;
begin
  if trim(ExibirTotatis) <> 'SIM' then
    exit;
    
	vValorTotTemp := 0;
  vValorTotTempRec := 0;
  vValorTemp := 0;
  vPercTemp := 0;

  ChecarFimdePagina;

  ftempOpRec.Filter := 'DIA_CXL = ' + QuotedStr(vDiaCXL);
  ftempOpRec.Filter := ftempOpRec.Filter + ' AND OP_CXL = ' + IntToStr(vOpCXL);
  ftempOpRec.Filtered := True;
  ftempOpRec.IndexFieldNames := 'CONTROLE;';

  if ftempOpRec.IsEmpty then
    exit;

  if (linha + ftempOpRec.RecordCount + 2 >= 60) then
  begin
    linha := 2;
    CabNovaPagina;
  end;

  if (vDadosIni.vEmp.vFinanceiroUnificado)
    and (AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0) then
  begin
    Rdp.ImpF(linha, 1, 'TOTAL CAIXA: ' + trim(vNomeOpCXL) +
      ' - EMP ' + IntToStr(vCodEmpMult), [normal, negrito]);
  end
  else
  begin
    Rdp.ImpF(linha, 1, 'TOTAL CAIXA: ' + trim(vNomeOpCXL), [normal, negrito]);
  end;

	linha := linha + 1;

  Rdp.ImpF(linha, 1, 'TOTAL DOCUMENTOS:', [comp17, negrito]);
  Rdp.ImpD(linha, 38, Format('%n', [vValorTotOp]), [comp17, negrito]);
  vValorTotOp := 0;
  Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
  Rdp.ImpD(linha, 115, Format('%n', [vValorRecOP]), [comp17, negrito]);
  vValorRecOP := 0;
  linha := linha + 1;

  Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
  Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
  Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);

  ftempOpRec.First;
  while not ftempOpRec.Eof do
  begin
    if ftempOpRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
      vValorTotTempRec := vValorTotTempRec + ftempOpRec.FieldByName('VALOR').AsCurrency
    else if ftempOpRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
      vValorTotTempRec := vValorTotTempRec + ftempOpRec.FieldByName('VALOR').AsCurrency
    else
      vValorTotTemp := vValorTotTemp + ftempOpRec.FieldByName('VALOR').AsCurrency;
    ftempOpRec.Next;
  end;

  vValorTotGTemp              := 0;
  vValorTotRTemp              := 0;
  vValorTotRNaoGeraFinancTemp := 0;
  ftempOpRec.First;
  while not ftempOpRec.Eof do
  begin
    vPerc := 0;
    if ftempOpRec.FieldByName('VALOR').AsCurrency <= 0 then
      vValorTemp := vValorTemp + ftempOpRec.FieldByName('VALOR').AsCurrency
    else
    begin
      if ftempOpRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
        vValorTemp := vValorTemp + 0
      else if ftempOpRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
        vValorTemp := vValorTemp + 0
      else
        vValorTemp := vValorTemp + ftempOpRec.FieldByName('VALOR').AsCurrency;
    end;

    if (vValorTotTemp + vValorTotTempRec = 0) then
    	vPerc := 0
    else if ftempOpRec.FieldByName('VALOR').AsCurrency <= 0 then
      vPerc := (ftempOpRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
    else if ftempOpRec.FieldByName('VALOR').AsCurrency > 0 then
      vPerc := (ftempOpRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
    vPercTemp := vPercTemp + vPerc;

    if (trim(ftempOpRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
    begin
      linha := linha + 1;
      if trim(ftempOpRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
        Rdp.Imp(linha, 21, ftempOpRec.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
      else
        Rdp.Imp(linha, 21, ftempOpRec.FieldByName('CONTROLE').asstring);
      Rdp.ImpD(linha, 71, Format('%n', [ftempOpRec.FieldByName('VALOR').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

      ChecarFimdePagina;
    end;

    vValorTotGTemp := vValorTotGTemp + ftempOpRec.FieldByName('VALOR').AsCurrency;
    if (trim(ftempOpRec.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
      and (trim(ftempOpRec.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
        vValorTotRTemp := vValorTotRTemp + ftempOpRec.FieldByName('VALOR').AsCurrency;

    if (trim(fTempRec.FieldByName('NAO_GERA_FINAN').asstring) = 'S') then
      	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + fTempRec.FieldByName('VALOR').AsCurrency;

    ftempOpRec.Next;
  end;
  ftempOpRec.EmptyDataSet;

  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL RECEBIMENTO....: ' + Format('%n', [vValorTotRTemp]), [comp17, negrito]);
  Rdp.ImpD(linha, 71, Format('%n', [vValorTotGTemp]), [comp17, negrito]); //vValorTemp
  Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL GERA FINANCEIRO: ' + Format('%n', [vValorTotRTemp - vValorTotRNaoGeraFinancTemp]), [comp17, negrito]);
  linha := linha + 1;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
  linha := linha + 1;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.ImprimirTotalPagina(
  totaltipo: boolean);
begin
	linha := linha + 1;
  if (linha >= 58) then
    if totaltipo then
      Rdp.ImpF(linha, 1, 'TOTAL GERAL', [comp17, negrito]);

  if trim(vTipoRec) = 'VEICULOS' then
  	Rdp.ImpF(linha, 21, 'TOTAL VEICULOS:', [comp17, negrito])
  else if trim(vTipoRec) = 'BALCAO' then
  	Rdp.ImpF(linha, 21, 'TOTAL BALCAO:', [comp17, negrito])
  else if trim(vTipoRec) = 'SERVICOS' then
  	Rdp.ImpF(linha, 21, 'TOTAL SERVICOS:', [comp17, negrito])
  else if trim(vTipoRec) = 'ECOMMERCE' then
  	Rdp.ImpF(linha, 21, 'TOTAL ECOMMERCE:', [comp17, negrito])
  else if trim(vTipoRec) = 'RECIBO ANTECIPADO' then
  	Rdp.ImpF(linha, 21, 'TOTAL RECIBO:', [comp17, negrito])
  else if trim(vTipoRec) = 'LANCAMENTO AVULSO' then
  	Rdp.ImpF(linha, 21, 'TOTAL LANCAMENTO:', [comp17, negrito])
  else if trim(vTipoRec) = 'PRESTACOES' then
  	Rdp.ImpF(linha, 21, 'TOTAL PRESTACOES:', [comp17, negrito]);

  if totaltipo then
  	Rdp.ImpD(linha, 58, Format('%n', [vValorTotRel]), [comp17, negrito])
	else
  begin
	  Rdp.ImpD(linha, 58, Format('%n', [vValorTotPag]), [comp17, negrito]);
    vValorTotPag := 0;
  end;
  Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
  if totaltipo then
  	Rdp.ImpD(linha, 115, Format('%n', [vValorRecRel]), [comp17, negrito])
  else
  begin
	  Rdp.ImpD(linha, 115, Format('%n', [vValorRecPag]), [comp17, negrito]);
    vValorRecPag := 0;
  end;
end;

