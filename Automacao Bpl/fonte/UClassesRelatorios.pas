procedure TRelatorioPagamentosRecebimentosFinanceiro.verificarFimdeRegistros(pBuscas: TIBQuery);
begin
	if (I = pBuscas.RecordCount) then
  begin
    ImprimirTotalDocumento(pBuscas);
    ImprimirTotalDiario;
    ImprimirControles;
    if not FiltrarPorTipo then
	    ImprimirControles(true);
  end;
end;

procedure TRelatorioPagamentosRecebimentosFinanceiro.verificarTotais(pBuscas: TIBQuery);
var
	vTipo: string;
begin
	if ((trim(pBuscas.FieldByName('TP_REL').AsString)) = 'PAGAMENTOS') then
  	vTipo := 'PAGAMENTOS'
  else if ((trim(pBuscas.FieldByName('TP_REL').AsString)) = 'CREDIARIO') then
  	 vTipo := 'CREDIARIO'
  else if ((trim(pBuscas.FieldByName('TP_REL').AsString)) = 'RECIBO ANTECIPADO') then
    vTipo := 'RECIBO ANTECIPADO'
  else
  	 vTipo := 'SAIDAS';

  if (trim(vTipo) <> '') and (vLote > 0) and (trim(vNumDoc) <> '') then
  begin
    ImprimirTotalDocumento(pBuscas);

    if ((trim(vDiaMov) <> '') and (trim(vDiaMov) <> FormatDateTime('dd/mm/yyyy', pBuscas.FieldByName('DATA_CONF').AsDateTime)))
    	or ((trim(vTipoMov) <> '') and (trim(vTipoMov) <> trim(vTipo))) then
    begin
      ImprimirTotalDiario;
    end;
  end;
end;

