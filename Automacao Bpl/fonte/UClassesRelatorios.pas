function TRelatorios.ListaCtrlTitulosRota(pCartao, pFinanc, pBoleta, pCheque, pOutros: boolean): boolean;
begin
  Result := True;
  if dtSetCtrlTitRota = nil then
    dtSetCtrlTitRota := TClientDataSet(dtmRelatorios.cdsCtrlTitRot);
  dtSetCtrlTitRota.Close;
  dtSetCtrlTitRota.CommandText := ' SELECT CTR.CODIGO_CTRL, CTR.NOME_CTRL, CTR.TP_PLANO FROM CONTROLES CTR ' +
    ' WHERE CTR.DOCS = ''S2'' AND CTR.CODIGO_EMP = ' + vDadosIni.codEmpresa +
    ' UNION ' +
    ' SELECT CTR.CODIGO_CTRL, CTR.NOME_CTRL, CTR.TP_PLANO FROM CONTROLES CTR ' +
    ' WHERE CTR.DOCS = ''S1'' AND CTR.CODIGO_EMP = ' + vDadosIni.codEmpresa +
    ' ORDER BY 1 ';
  try
    dtSetCtrlTitRota.Open;
    dtSetCtrlTitRota.First;
    while not dtSetCtrlTitRota.Eof do
    begin
      if ((pCartao) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = 'C')) or
        ((pFinanc) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = 'F')) or
        ((pBoleta) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = 'B')) or
        ((pCheque) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = 'E')) or
        ((pOutros) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = 'O')) or
        ((pOutros) and (trim(dtSetCtrlTitRota.FieldByName('tp_plano').AsString) = ''))  then
      begin
        dtSetCtrlTitRota.Edit;
        dtSetCtrlTitRota.FieldByName('sel').AsString := 'S';
        dtSetCtrlTitRota.Post;
      end
      else
      begin
        dtSetCtrlTitRota.Edit;
        dtSetCtrlTitRota.FieldByName('sel').AsString := '';
        dtSetCtrlTitRota.Post;
      end;



      dtSetCtrlTitRota.Next;
    end;
    dtSetCtrlTitRota.First;
  except
    on e: exception do
    begin
      result := false;
      Application.MessageBox(Pchar('E0013 Erro ao executar comandos sql.' + #13 + 'Comandos: ' + dtSetCtrlTitRota.CommandText + #13 +
        'Erro: ' + e.Message), 'Informação', MB_ICONERROR + MB_OK);
    end;
  end;
end;

