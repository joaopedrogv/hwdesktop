        ' select case  when (ndi.isento =  ''S'') then 2 when (ndi.base_icm > 0) then 1  else 3 end COD,' +
        ' '''' OBS, ''NFD'' TIPO_DOC,''S'' NATUREZA, nd.numeronota NUMDOC, nd.dataemissao DATA,' +
        ' nd.dataemissao DATA_EMISSAO, est.sigla_uf UF, nd.serie SERIE, nd.modelo MODELO, ndi.aliquota ALIQ_ICM, 0 ALIQ_ICMSUB, 0 ALIQ_IPI,' +
        ' substring((nd.cod_cliente ||'' - ''|| cl.nome_cliente) from 1 for 43) COD_CLI,' +
        ' case when ((cl.insc_est is null) or (cl.insc_est =''ISENTO'')) then ''N'' else ''S'' end CONTRIBUINTE,' +
