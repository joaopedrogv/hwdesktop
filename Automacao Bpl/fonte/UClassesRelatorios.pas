procedure TRelatorioFaturamentodeVeiculos.ImprimeRelatorios;
var
 I: Integer;
 DataBase, DNS, vPw, vUs, vtit, Formula, Formula1, Formula2, Formula3, Formula4: string;
 vForm: TForm;
 vPanel: TPanel;
 vSpeedButton: TSpeedButton;
begin
 try
   if not vDadosIni.PesqPros('REL039', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
    inherited;

   vDadosIni.mudaregistro; 
   obCrystal := TCrpe.Create(dtmRelatorios.Crpe1);
   Formula1 := '';
   Formula2 := '';
   Formula3 := '';
   Formula4 := '';
   if Estoque then
   begin
     Formula3 := '((TRIM({COM_FAT.TIPV_VEICULO}) <> ''C'') AND (TRIM({COM_FAT.TIPV_VEICULO}) <> ''I'')) ';
     vtit := 'ESTOQUE';
   end;
   if Consignado then
   begin
     Formula3 := '(TRIM({COM_FAT.TIPV_VEICULO}) = ''C'') ';
     vtit := 'CONSIGNADO';
   end;
   if Intermediacao then
   begin
     Formula3 := '(TRIM({COM_FAT.TIPV_VEICULO}) = ''I'') ';
     vtit := 'REAL';
   end;
   if Estoque and EstoqueReal then
   begin
     Formula3 := '((TRIM({COM_FAT.TIPV_VEICULO}) <> ''C'') AND (TRIM({COM_FAT.TIPV_VEICULO}) <> ''I'')) ' +
      ' AND (TRIM({EST_MOTO.ESTOQUE}) = ''P'') ';
     vtit := 'ESTOQUE REAL';
   end;
   if Concessionaria then
   begin
     Formula4 := '(TRIM({EST_MOTO.ESTOQUE}) = ''C'') ';
     vtit := vtit + ' -> CONCESSIONARIA';
   end;

   //Gera a Formula a ser aplicada ao relatório
   Formula := '{COM_FAT.COD_EMPRESA} IN ' + trim(vDadosIni.vPesquisa);
   Formula := Formula + ' AND {NAT_OP.FATURAMENTO} = ''S'' ';
   Formula := Formula + ' AND {COM_FAT.NATUREZA} = ''S'' ';
   Formula := Formula + ' AND Trim({COM_FAT.STATUS_V}) = ''FECHADO'' ';
   Formula := Formula + ' AND {COM_FAT.ATIVO} = 1 ';
   if FiltrarVendedor then
   begin
     if Gerente then
      Formula1 := '{COM_FAT.COD_GERENTE} = ' + CodVendedor
     else
      Formula1 := '{COM_FAT.COVEND_V} = ' + CodVendedor;
   end;

   if (Length(Trim(DateToStr(datainicial))) = 10) and (Length(Trim(DateToStr(datafinal))) = 10) then
     Formula2 := '{COM_FAT.DATA_VEN} >= DateValue(''' + FormatDateTime('dd/mm/yyyy', datainicial) + ''') ' +
       ' AND {COM_FAT.DATA_VEN} <= DateValue(''' + FormatDateTime('dd/mm/yyyy', datafinal) + ''')';
   if Trim(CodVendedor) <> '' then
     Formula := Formula + ' AND ' + Formula1;
   if (Length(Trim(DateToStr(datainicial))) = 10) and (Length(Trim(DateToStr(datafinal))) = 10) then
     Formula := Formula + ' AND ' + Formula2;
   if (EstoqueReal) or (Consignado) or (Intermediacao) then
     Formula := Formula + ' AND ' + Formula3;
   if Concessionaria then
     Formula := Formula + ' AND ' + Formula4;

   obCrystal.WindowButtonBar.GroupTree := true;
   obCrystal.WindowButtonBar.CancelBtn := true;
   obCrystal.WindowButtonBar.SearchBtn := true;
   obCrystal.WindowButtonBar.AllowDrillDown := true;
   obCrystal.WindowButtonBar.DocumentTips := true;
   obCrystal.WindowButtonBar.PrintSetupBtn := true;
   obCrystal.SummaryInfo.Title := 'RELATÓRIO DE VENDAS DE VEÍCULOS';
   obCrystal.SummaryInfo.AppName := 'RELATÓRIO DE VENDAS DE VEÍCULOS';
   obCrystal.WindowStyle.Title := 'RELATÓRIO DE VENDAS DE VEÍCULOS';
   obCrystal.WindowState := wsMaximized;
   obCrystal.WindowStyle.BorderStyle := bsNone;
   vDadosIni.crpeTmp := obCrystal;

   vForm:= TForm.Create(dtmRelatorios.Crpe1);
   vForm.bordericons:= [bisystemmenu];
   vForm.OnResize:= vDadosIni.OnCrpeViewerResize;
   vForm.ShowHint := true;
   vForm.Caption := obCrystal.SummaryInfo.Title;
   obCrystal.WindowParent:= vForm;

   vPanel := TPanel.Create(dtmRelatorios.Crpe1);
   vPanel.Parent := vForm;
   vPanel.Height := 19;
   vPanel.Width := 19;
   vPanel.Top := 4;
   vPanel.Left := 513;
   vPanel.TabOrder := 0;
   vPanel.BevelInner := bvNone;
   vPanel.BevelKind := bkNone;
   vPanel.BevelOuter := bvNone;
   vPanel.Name := 'vPanel';
   vPanel.Caption := '';

   vSpeedButton := TSpeedButton.Create(dtmRelatorios.Crpe1);
   vSpeedButton.Parent := vPanel;
   vSpeedButton.Flat := true;
   vSpeedButton.Align := alClient;
   vSpeedButton.Enabled := true;
   vSpeedButton.Visible := true;
   vSpeedButton.Name := 'vSpeedButton';
   vSpeedButton.Hint := 'Send E-mail';
   vSpeedButton.Caption := '';

   if not FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
 	 	 vDadosIni.saveResourceToFile('emailrel', 'bmp', ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

 	 if FileExists(ExtractFilePath(Application.ExeName) + 'emailrel.bmp') then
	 	 vSpeedButton.Glyph.LoadFromFile(ExtractFilePath(Application.ExeName) + 'emailrel.bmp');

   if Assigned(vSpeedButton) then
     vSpeedButton.OnClick := vDadosIni.onClickSendEmailCrystalReport;

   vDadosIni._AlterarFonteCrystalReport(obCrystal);

   obCrystal.ReportName := vDadosIni.vPastaRel + '\Veic4\CCIA\Faturamento Veiculos.rpt';
   obCrystal.ReportTitle := vtit;
   obCrystal.GroupSelection.Formula.Clear;
   obCrystal.GroupSelection.Formula.Text := Formula;
   obCrystal.LogOnServer.Retrieve;

   buscas.Close;
   buscas.SQL.Text := ' select * from EMPRESA ' +
     ' where COD_EMPRESA = ' + vDadosIni.codEmpresa;
   buscas.Open;

   if not buscas.IsEmpty then
   begin
     for i := 0 to (obCrystal.ParamFields.Count - 1) do
     begin
       if Pos('NOMEEMPRESA', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
    		 obCrystal.ParamFields[i].CurrentValue := vDadosIni.vEmp.vnomeEmpresa
       else if Pos('OUTROSDADOS', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
         obCrystal.ParamFields[i].CurrentValue := ''
       else if Pos('COD_EMPRESA', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
         obCrystal.ParamFields[i].CurrentValue := vDadosIni.codEmpresa
       else if Pos('GERENTE', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
         obCrystal.ParamFields[i].CurrentValue := vDadosIni.IfThen(Gerente, 'S', 'N');
     end;

     for i := 0 to obCrystal.Formulas.Count - 1 do
     begin
       if obCrystal.Formulas[i].Name = 'NomeEmpresa' then
         obCrystal.Formulas[i].Formula.Text := '"' + trim(buscas.FieldByName('IDENTIFICACAO_EMP').Text) + '"';
       if (obCrystal.Formulas[i].Name = 'Periodo')
         and (Length(Trim(DateToStr(datainicial))) = 10) and (Length(Trim(DateToStr(datafinal))) = 10) then
         obCrystal.Formulas[i].Formula.Text := '"DE  ' + DateToStr(datainicial) + '  A  ' + DateToStr(datafinal) + '"';
       if obCrystal.Formulas[i].Name = 'DataBase' then
         obCrystal.Formulas[i].Formula.Text := '"' + vtit + '"';
