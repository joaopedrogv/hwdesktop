      if FiltrarVendedor then
      begin
        if FBuscas8.IsEmpty then
        begin
      		result := False;
     		  exit;
    		end;
      end
      else
      begin
        result := False;
        exit;
      end;
    end;
    result := true;
  except
    Result := false;
  end;
end;

function TRelatorioVendasPorVendedor.AbreTotalServicosProdutos(pCodVendedor: integer): boolean;
var
  vCampoAgrupamentoServicos: string;
begin
  try
    buscas1.Close;
