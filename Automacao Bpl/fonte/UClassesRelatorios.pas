  Result := true;
end;

function TRelatorios.retornaStringParticipantes(
  CheckListBoxPart: TCheckListBox): string;
var
	I: Integer;
begin
	Result := '';
	for I := 0 to CheckListBoxPart.Items.Count - 1 do
  begin
    if CheckListBoxPart.Checked[I] then
    	if trim(Result) = '' then
      	Result := Copy(CheckListBoxPart.Items[I], 1, Pos(' - ', CheckListBoxPart.Items[I]) - 1)
      else
        Result := Result + ',' + Copy(CheckListBoxPart.Items[I], 1, Pos(' - ', CheckListBoxPart.Items[I]) - 1);
  end;

  if trim(Result) <> '' then
    Result := '(' + Result + ')'
  else
  begin
  	Application.MessageBox(PChar('Nenhum ' + vDadosIni.vPedVnd.descricaoParticipante + ' selecionado, favor verificar antes de continuar!'), 'Atenção', MB_OK);
  end;
end;

