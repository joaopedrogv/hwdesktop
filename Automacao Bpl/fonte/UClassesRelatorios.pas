  Rdp.ImpF(linha, 55, 'QTDE', [comp17, negrito]);
  Rdp.ImpF(linha, 61, 'DATA', [comp17, negrito]);
  Rdp.ImpF(linha, 73, 'OS/RQ', [comp17, negrito]);
  Rdp.ImpF(linha, 80, 'CLIENTE', [comp17, negrito]);
  Rdp.ImpF(linha, 102, 'TIPO VND', [comp17, negrito]);
  Rdp.ImpF(linha, 111, 'VL.CST.CNT', [comp17, negrito]);
  Rdp.ImpF(linha, 123, 'VL.CST.MED.', [comp17, negrito]);
  Rdp.ImpF(linha, 136, 'VL. VENDA', [comp17, negrito]);
  Rdp.ImpF(linha, 148, 'VND', [comp17, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 150), [comp17, negrito]);
  linha := linha + 1;
end;

constructor TRelatorioProdutosComPendenciaEmVendasREQOS.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
end;

procedure TRelatorioProdutosComPendenciaEmVendasREQOS.ImprimeRelatorios;
var
  vQtde, vQtdeT: real;
  vValorC, vValorR, vValorV: currency;
  vValorTC, vValorTR, vValorTV: currency;
  vTipo,vTipoOS: string;
  vQtdeTot, vValorCTot, vValorRTot, vValorVTot: real;
begin
  if not vDadosIni.PesqPros('REL016', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;


  abreProdutosComPendencias;//if not abreProdutosComPendencias then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 150;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Produtos com Pendências em Pedidos de Vendas';
  rdp.TitulodoRelatorio := 'Produtos com Pendências em Vendas';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho
  vqtde := 0;
  vQtdeT := 0;
  vValorR := 0;
  vValorTR := 0;
  vValorC := 0;
  vValorTC := 0;
  vValorV := 0;
  vValorTV := 0;
  vQtdeTot := 0;
  vValorCTot := 0;
  vValorRTot := 0;
  vValorVTot := 0;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  if trim(buscas.FieldByName('TIPO').AsString) = 'OS' then
    Rdp.impF(linha, 1, 'Produtos em O.S.', [negrito])
  else if trim(buscas.FieldByName('TIPO').AsString) = 'REQ' then
    Rdp.impF(linha, 1, 'Produtos em Requisicoes', [negrito])
  else if trim(buscas.FieldByName('TIPO').AsString) = 'PRD' then
    Rdp.impF(linha, 1, 'Produtos em Produções', [negrito])
  else if trim(buscas.FieldByName('TIPO').AsString) = 'ESF' then
  begin
    if trim(buscas.FieldByName('tipo_os').AsString) = 'NT' then
      Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor não atendidos', [negrito])
    else if trim(buscas.FieldByName('tipo_os').AsString) = 'AT' then
      Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor Atendidos', [negrito])
    else if trim(buscas.FieldByName('tipo_os').AsString) = 'DV' then
      Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor devolvidos', [negrito])
    else if trim(buscas.FieldByName('tipo_os').AsString) = 'RES' then
      Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor em reserva', [negrito]);
  end;
  linha := linha + 1;
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    vTipo := trim(buscas.FieldByName('TIPO').AsString);
    vTipoOS := trim(buscas.FieldByName('TIPO_os').AsString);
    Rdp.Imp(linha, 1, copy(buscas.FieldByName('NUM_FAB_PROD').AsString, 1, 15));
    Rdp.Imp(linha, 16, copy(buscas.FieldByName('DESCR_PROD').AsString, 1, 35));
    Rdp.ImpD(linha, 59, format('%6.2f', [buscas.FieldByName('quant_ped_item').AsFloat]), []);
    Rdp.Imp(linha, 61, buscas.FieldByName('data_ped').asstring);
    Rdp.Imp(linha, 73, vDadosIni.strzero(buscas.FieldByName('NPED').AsInteger, 5));
    Rdp.Imp(linha, 80, copy(buscas.FieldByName('NOME_CLIENTE').AsString, 1, 20));
    if trim(buscas.FieldByName('TIPO').AsString) = 'OS' then
      Rdp.Imp(linha, 102, buscas.FieldByName('TIPO_OS').AsString)
    else if trim(buscas.FieldByName('TIPO').AsString) = 'REQ' then
      Rdp.Imp(linha, 102, buscas.FieldByName('TIPV').AsString);
    Rdp.ImpD(linha, 121, format('%n', [buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_CUS_PROD').AsFloat]), []);
    Rdp.ImpD(linha, 134, format('%n', [buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_CUSM_PROD').AsFloat]), []);
    Rdp.ImpD(linha, 146, format('%n', [buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_TAB_PROD').AsFloat]), []);
    Rdp.Imp(linha, 148, vDadosIni.strzero(buscas.FieldByName('COD_VENDEDOR').AsInteger, 3));
    linha := linha + 1;
    if linha >= 62 then
      CabNovaPagina;
    vqtde := vqtde + buscas.FieldByName('quant_ped_item').AsFloat;
    vvalorc := vvalorc + (buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_CUS_PROD').AsFloat);
    vvalorR := vvalorR + (buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_CUSM_PROD').AsFloat);
    vvalorV := vvalorV + (buscas.FieldByName('quant_ped_item').AsFloat * buscas.FieldByName('PREC_TAB_PROD').AsFloat);
    vqtdeT := vqtdeT + vQtde;
    vValorTC := vValorTC + vValorC;
    vValorTR := vValorTR + vValorR;
    vValorTV := vValorTV + vValorV;
    buscas.next;
    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    if (vTipo <> trim(buscas.FieldByName('TIPO').AsString)) or (buscas.Eof) or
    ((vTipo = 'ESF') and (trim(buscas.FieldByName('tipo_os').AsString) <> vTipoOS))
     then
    begin
      Rdp.impF(linha, 1, vDadosIni.replicate('-', 150), [negrito]);
      linha := linha + 1;
      if vTipo = 'OS' then
        Rdp.imp(linha, 1, 'TOTAIS O.S.:')
      else if vTipo = 'REQ' then
        Rdp.imp(linha, 1, 'TOTAIS Requisicoes:');
      Rdp.ImpD(linha, 59, format('%6.2f', [vqtde]), [negrito]);
      Rdp.ImpD(linha, 121, format('%n', [vValorC]), [negrito]);
      Rdp.ImpD(linha, 134, format('%n', [vValorR]), [negrito]);
      Rdp.ImpD(linha, 146, format('%n', [vValorV]), [negrito]);
      linha := linha + 1;
      Rdp.impF(linha, 1, vDadosIni.replicate('-', 150), [negrito]);
      linha := linha + 2;
      vQtdeTot := vQtdeTot + vDadosIni.StrToFloatFormat(vQtde, 2);
      vValorCTot := vValorCTot + vDadosIni.StrToFloatFormat(vValorC, 2);
      vValorRTot := vValorRTot + vDadosIni.StrToFloatFormat(vValorR, 2);
      vValorVTot := vValorVTot + vDadosIni.StrToFloatFormat(vValorV, 2);
      vQtde := 0;
      vValorC := 0;
      vValorR := 0;
      vValorV := 0;
      if not buscas.Eof then
        if trim(buscas.FieldByName('TIPO').AsString) = 'OS' then
          Rdp.impF(linha, 1, 'Produtos em O.S.', [negrito])
        else if trim(buscas.FieldByName('TIPO').AsString) = 'REQ' then
          Rdp.impF(linha, 1, 'Produtos em Requisicoes', [negrito])
        else if trim(buscas.FieldByName('TIPO').AsString) = 'PRD' then
          Rdp.impF(linha, 1, 'Produtos em Produções', [negrito])
        else if trim(buscas.FieldByName('TIPO').AsString) = 'ESF' then
        begin
          if trim(buscas.FieldByName('tipo_os').AsString) = 'NT' then
            Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor não atendidos', [negrito])
          else if trim(buscas.FieldByName('tipo_os').AsString) = 'AT' then
            Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor Atendidos', [negrito])
          else if trim(buscas.FieldByName('tipo_os').AsString) = 'DV' then
            Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor devolvidos', [negrito])
          else if trim(buscas.FieldByName('tipo_os').AsString) = 'RES' then
            Rdp.impF(linha, 1, 'Produtos no Carrinho do Vendedor em reserva', [negrito]);
        end;
      linha := linha + 1;
    end;
  end;
  Rdp.imp(linha, 1, 'TOTAL GERAL:');
  Rdp.ImpD(linha, 59, format('%6.2f', [vQtdeTot]), [negrito]);
  Rdp.ImpD(linha, 121, format('%n', [vValorCTot]), [negrito]);
  Rdp.ImpD(linha, 134, format('%n', [vValorRTot]), [negrito]);
  Rdp.ImpD(linha, 146, format('%n', [vValorVTot]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, vDadosIni.replicate('-', 150), [negrito]);
      linha := linha + 1;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL016', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
end;

{ TRelatorioRequisicoesEmitidasPorPeriodo }

function TRelatorioRequisicoesEmitidasPorPeriodo.abreRequisicoesPorPeriodo: Boolean;
begin

  try
    Result := False;
    //Requisições emitidas por período
    buscas.Close;
    buscas.SQL.Text := 'select v.nped,v.nprevenda,v.data_ped,v.valor_total,v.status_ped,' +
      ' v.data_fech, v.tipv,cond.desc_cond_pag,v.datvenc,v.cod_cliente, c.nome_cliente, c.razao, v.NUM_NF, ' +
      ' coalesce((select sum(coalesce(vp1.vltot_ped_item, 0)) from pedvenda_prod vp1 ' +
      ' where vp1.nped=v.nped and vp1.tipo=v.tipo and vp1.cod_empresa=v.cod_empresa ' +
      ' and (vp1.status<>''CANCELADO'' or vp1.status is null)), 0) as totalprod, ' +
      ' coalesce(((select sum(coalesce(vp1.vltot_ped_item, 0)) from pedvenda_prod vp1 ' +
      ' where vp1.nped=v.nped and vp1.tipo=v.tipo and vp1.cod_empresa=v.cod_empresa ' +
      ' and (vp1.status<>''CANCELADO'' or vp1.status is null))-v.valor_total), 0) as desconto, ' +
      ' coalesce((v.valor_total - (select sum(coalesce(vp1.vltot_ped_item, 0)) from pedvenda_prod vp1 ' +
      ' where vp1.nped=v.nped and vp1.tipo=v.tipo and vp1.cod_empresa=v.cod_empresa ' +
      ' and (vp1.status<>''CANCELADO'' or vp1.status is null))), 0) as acrescimo ' +
      ' from pedvenda v ' +
      ' inner join clientes c on v.cod_cliente=c.cod_cliente and v.cod_empresa=c.cod_empresa ' +
      ' left join cond_pag cond on v.cod_cond_pag=cond.cod_cond_pag ' +
      ' where v.cod_empresa=' + vDadosIni.codEmpresa + ' and v.tipo=''REQ'' and v.ativo=1 ';

    if FiltrarCliente then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
    if StatusPed = 'ABERTA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf and ' +
        ' ((v.data_fech is null) or (v.data_fech > :dtf)) and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) '
    else if StatusPed = 'FECHADA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_fech >= :dti and v.data_fech <= :dtf and v.status_ped=''FECHADA'' '
    else
      buscas.SQL.Text := buscas.SQL.Text + ' and ((v.data_fech >= :dti and v.data_fech <= :dtf) or (v.data_ped >= :dti and v.data_ped <= :dtf)) ' +
        ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

    if FiltrarCondPagamento then
      buscas.SQL.Text := buscas.SQL.Text + ' and cond.desc_cond_pag = ' + QuotedStr(trim(dtSetCondPag.FieldByName('desc_cond_pag').AsString)); //cod_cond_pag ='+ dtSetCondPag.FieldByName('cod_cond_pag').AsString;

    if FiltrarTipoVenda then
      buscas.SQL.Text := buscas.SQL.Text + 'and v.tipv = ' + QuotedStr(trim(TipoVenda));

    buscas.SQL.Text := buscas.SQL.Text + ' order by cond.desc_cond_pag,v.data_ped,v.nped';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;
end;

procedure TRelatorioRequisicoesEmitidasPorPeriodo.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;
  Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vnomeEmpresa), [normal, negrito]);
  linha := linha + 1;
  if vDadosIni.vEmp.vUsarDAV = 'S' then
    Rdp.ImpF(linha, 1, 'RELATORIO DE DAV''s EMITIDAS POR PERIODO', [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'RELATORIO DE REQUISICOES EMITIDAS POR PERIODO', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'NO PERIODO DE: ' + datetostr(datainicial) + ' A ' + datetostr(datafinal), [normal, negrito]);
  linha := linha + 1;

  if StatusPed = 'ABERTA' then
  	Rdp.ImpF(linha, 1, 'STATUS DAS REQUISICOES: ABERTO', [normal, negrito])
  else if StatusPed = 'FECHADA' then
  	Rdp.ImpF(linha, 1, 'STATUS DAS REQUISICOES: FECHADO', [normal, negrito])
  else
  	Rdp.ImpF(linha, 1, 'STATUS DAS REQUISICOES: AMBOS (ABERTO / FECHADO)', [normal, negrito]);

  vpag := vpag + 1;
  linha := linha + 1;
  if FiltrarTipoVenda then
    Rdp.ImpF(linha, 1, 'TIPO DE VENDA: ' + trim(dtSetTipVenda.FieldByName('DESCRICAO').AsString), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'TIPO DE VENDA: TODOS', [normal, negrito]);
  if FiltrarCliente then
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CLIENTE: ' + trim(dtSetCliente.FieldByName('NOME_CLIENTE').AsString), [normal, negrito]);
  end;
  linha := linha + 2;
  Rdp.ImpF(linha, 1, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  Rdp.ImpF(linha, 130, 'PAG: ' + vDadosIni.strzero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 160), [comp20]);
  linha := linha + 1;
  if vDadosIni.vEmp.vUsarDAV = 'S' then
    Rdp.ImpF(linha, 1, 'DAV/REQ', [comp20])
  else
    Rdp.ImpF(linha, 1, 'REQ', [comp20]);
  Rdp.ImpF(linha, 17, 'DATA REC', [comp20]);
  Rdp.ImpD(linha, 40, 'TOTAL PRODS', [comp20]);
  Rdp.ImpD(linha, 52, 'DESCONTOS', [comp20]);
  Rdp.ImpD(linha, 63, 'ACRESCIMO', [comp20]);
  Rdp.ImpD(linha, 76, 'TL.LIQUIDO', [comp20]);
  Rdp.ImpF(linha, 78, 'STATUS', [comp20]);
  Rdp.ImpF(linha, 89, 'DT. FECH.', [comp20]);
  Rdp.ImpF(linha, 106, 'NF', [comp20]);
  Rdp.ImpF(linha, 111, 'DATA VENC', [comp20]);
  if not FiltrarCliente then
	  Rdp.ImpF(linha, 122, 'NOME CLIENTE', [comp20]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 160), [comp20]);
  linha := linha + 1;
end;

constructor TRelatorioRequisicoesEmitidasPorPeriodo.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
end;

procedure TRelatorioRequisicoesEmitidasPorPeriodo.ImprimeRelatorios;
var
  vcond: string;
  vtotind, vltot, vlliq, vacrescimo, vdesconto: currency;
  it: integer;
begin
  if not vDadosIni.PesqPros('REL017', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  abreRequisicoesPorPeriodo;//if not abreRequisicoesPorPeriodo then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S20cpp;
  Rdp.TamanhoQteColunas := 160;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  if vDadosIni.vEmp.vUsarDAV = 'S' then
  begin
    rdp.OpcoesPreview.CaptionPreview := 'DAV''s EMITIDAS POR PERIODO';
    rdp.TitulodoRelatorio := 'DAV''s EMITIDAS POR PERIODO';
  end
  else
  begin
    rdp.OpcoesPreview.CaptionPreview := 'REQUISICOES EMITIDAS POR PERIODO';
    rdp.TitulodoRelatorio := 'REQUISICOES EMITIDAS POR PERIODO';
  end;
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  it := 0;
  vltot := 0.00;
  vlliq := 0.00;
  vacrescimo := 0.00;
  vdesconto := 0.00;
  vcond := trim(buscas.FieldByName('DESC_COND_PAG').AsString);
  Rdp.impc(linha, 1, '* * * * *' + trim(buscas.FieldByName('DESC_COND_PAG').AsString) + '* * * * *', [comp20, negrito]);
  linha := linha + 1;
  vtotind := 0;

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    if vDadosIni.vEmp.vUsarDAV = 'S' then
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('NPREVENDA').AsInteger, 7) + '/' + vDadosIni.strzero(buscas.FieldByName('NPED').AsInteger, 6))
    else
      Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('NPED').AsInteger, 6));
    Rdp.imp(linha, 17, buscas.FieldByName('DATA_PED').asstring);
    Rdp.impD(linha, 40, format('%n', [buscas.FieldByName('totalprod').AsFloat]), []);
    Rdp.impD(linha, 52, format('%n', [IfThen(buscas.FieldByName('desconto').AsFloat > 0,
    	 buscas.FieldByName('desconto').AsFloat, 0)]), []);
    Rdp.impD(linha, 63, format('%n', [IfThen(buscas.FieldByName('acrescimo').AsFloat > 0,
    	 buscas.FieldByName('acrescimo').AsFloat, 0)]), []);
    Rdp.impD(linha, 76, format('%n', [buscas.FieldByName('VALOR_TOTAL').AsFloat]), []);
    Rdp.imp(linha, 78, trim(buscas.FieldByName('STATUS_PED').asstring));
    Rdp.imp(linha, 88, buscas.FieldByName('DATA_FECH').asstring);
    if buscas.FieldByName('NUM_NF').AsInteger <> 0 then
      Rdp.impD(linha, 108, vDadosIni.strzero(buscas.FieldByName('NUM_NF').asstring, 6), []);
    Rdp.imp(linha, 110, buscas.FieldByName('DATVENC').asstring);
    if not FiltrarCliente then
	    Rdp.Imp(linha, 122, vDadosIni.IfThen(ExibirRazaoFantasia = 0,
      	Copy(trim(buscas.FieldByName('RAZAO').AsString), 1, 38),
        Copy(trim(buscas.FieldByName('NOME_CLIENTE').AsString), 1, 38)) );
    it := it + 1;
    vltot := vltot + buscas.FieldByName('totalprod').AsFloat;
    vlliq := vlliq + buscas.FieldByName('VALOR_TOTAL').value;
    vdesconto := vdesconto + IfThen(buscas.FieldByName('desconto').AsFloat > 0,
    	 buscas.FieldByName('desconto').AsFloat, 0);
    vacrescimo := vacrescimo + IfThen(buscas.FieldByName('acrescimo').AsFloat > 0,
    	 buscas.FieldByName('acrescimo').AsFloat, 0);
    linha := linha + 1;
    if linha >= 60 then
      CabNovaPagina;
    vtotind := vtotind + buscas.FieldByName('VALOR_TOTAL').AsFloat;
    buscas.next;
    if buscas.eof then
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end;
      end;
      Rdp.impF(linha, 1, 'Total da Condicao:', [negrito]);
      Rdp.impD(linha, 76, format('%m', [vtotind]), [negrito]);
      linha := linha + 1;
      Rdp.Imp(linha, 1, vDadosIni.replicate('=', 160));
      linha := linha + 2;
    end;
    if vcond <> trim(buscas.FieldByName('DESC_COND_PAG').AsString) then
    begin
      Rdp.impF(linha, 1, 'Total da Condicao:', [negrito]);
      Rdp.impD(linha, 76, format('%m', [vtotind]), [negrito]);
      linha := linha + 2;
      vtotind := 0;
      vcond := trim(buscas.FieldByName('DESC_COND_PAG').AsString);
      Rdp.impc(linha, 1, '* * * * *  ' + trim(buscas.FieldByName('DESC_COND_PAG').AsString) + '  * * * * *', [comp20, negrito]);
      linha := linha + 1;
    end;
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;
  Rdp.impF(linha, 1, 'Quantidade Rqs:', [negrito]);
  Rdp.impD(linha, 30, vDadosIni.strzero(it, 6), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Geral...:', [negrito]);
  Rdp.impD(linha, 30, format('%n', [vltot]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Descontos.....:', [negrito]);
  Rdp.impD(linha, 30, format('%n', [vdesconto]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Acresimo......:', [negrito]);
  Rdp.impD(linha, 30, format('%n', [vacrescimo]), [negrito]);
  linha := linha + 1;
  Rdp.impF(linha, 1, 'Total Liquido.:', [negrito]);
  Rdp.impD(linha, 30, format('%n', [vlliq]), [negrito]);
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL017', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.close;
  frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatorioOrdensDeServicosEmitidasPorPeriodo }

function TRelatorioOrdensDeServicosEmitidasPorPeriodo.abreOSsPorPeriodo: Boolean;
begin
  try
    Result := False;
    //OSs emitidas por período
    buscas.Close;
    buscas.SQL.Text := 'select v.nped,v.nprevenda,v.data_ped,v.tot_prod,v.tot_serv,v.placa,' +
      ' v.valor_total,cond.desc_cond_pag, v.status_ped,v.data_fech, v.tipo_os,v.cod_cliente,c.NOME_CLIENTE, c.RAZAO,' +
      ' coalesce((select sum(coalesce(vpt.vl_total, 0)) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa), 0) as totalprodT,' +
      ' coalesce((select sum(coalesce(vst.vl_servt, 0)) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa), 0) as totalServT,' +
      ' coalesce((select sum(coalesce(vsg.prc_int_serv, 0)) from pedvenda_serv vsg ' +
      ' where vsg.nped=v.nped and vsg.tipo=v.tipo and vsg.cod_empresa=v.cod_empresa ' +
      ' and (vsg.status<>''CANCELADO'' or vsg.status is null)), 0) as ServGarantia,' +
      ' coalesce(((select coalesce(sum(vpt.vl_total),0) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa)+ ' +
      ' (select coalesce(sum(vst.vl_servt),0) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa )+ ' +
      ' coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) - coalesce(v.valor_total, 0)), 0) as desconto, ' +
      ' coalesce(0 - ((select coalesce(sum(vpt.vl_total),0) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa)+ ' +
      ' (select coalesce(sum(vst.vl_servt),0) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa)+ ' +
      ' coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) - coalesce(v.valor_total, 0)), 0) as acrescimo ' +
      ' from pedvenda v ';
     if FiltrarAreaExec then
       buscas.SQL.Text := buscas.SQL.Text  +
        ' inner join tipo_vendas tp on tp.tipo = v.tipo and (tp.sigla = v.tipv or (tp.tipo_os = v.tipo_os)) ';
     buscas.SQL.Text := buscas.SQL.Text +
      ' inner join clientes c on v.cod_cliente=c.cod_cliente and v.cod_empresa=c.cod_empresa ' +
      ' left join cond_pag cond on v.cod_cond_pag = cond.cod_cond_pag ' +
      ' where v.cod_empresa=' + vDadosIni.codEmpresa + ' and v.tipo=''OS'' and v.ativo=1 ';

    if FiltrarCliente then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;      
    if StatusPed = 'ABERTA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf and ' +
        ' ((v.data_fech is null) or (v.data_fech > :dtf)) and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) '
    else if StatusPed = 'FECHADA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_fech >= :dti and v.data_fech <= :dtf and v.status_ped=''FECHADA'' '
    else
      buscas.SQL.Text := buscas.SQL.Text + ' and ((v.data_fech >= :dti and v.data_fech <= :dtf) or (v.data_ped >= :dti and v.data_ped <= :dtf)) ' +
        ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

    if FiltrarCondPagamento then
      buscas.SQL.Text := buscas.SQL.Text + ' and cond.desc_cond_pag = ' + QuotedStr(trim(dtSetCondPag.FieldByName('desc_cond_pag').AsString)); //cod_cond_pag ='+ dtSetCondPag.FieldByName('cod_cond_pag').AsString;

    if FiltrarTipoOS then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo_os = ' + QuotedStr(trim(TipoOs)); //cod_cond_pag ='+ dtSetCondPag.FieldByName('cod_cond_pag').AsString;

    if FiltrarAreaExec then
        buscas.SQL.Text := buscas.SQL.Text + ' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec));
                                                           
    buscas.SQL.Text := buscas.SQL.Text + ' order by cond.desc_cond_pag,v.data_ped,v.nped';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;

end;

