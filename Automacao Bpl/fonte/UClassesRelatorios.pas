procedure TRelatorioVendasPorVendedorFaixaDesconto.CabNovaPagina;
begin
	if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO COMISSAO POR FAIXA DE DESCONTO', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TIPO DE O.S.: ' + TipoOs, [normal, negrito]);
  Rdp.ImpF(linha, 80, vDadosIni.IfThen(not ExibirComissaoTecMec, 'NAO ', '') +
  	'EXIBIR COMISSAO PARA ' + vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'TECNICO', 'MECANICO'), [normal, negrito]);
  if FiltrarVendedor then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, Copy('VENDEDOR: ' + trim(Vendedor), 1, 78), [normal, negrito]);
  end
  else
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + 'TODOS', [normal, negrito]);
  end;

  vpag := vpag + 1;
  Rdp.ImpF(linha, 80, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
end;

