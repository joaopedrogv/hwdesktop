          Rdp.ImpF(linha, 62, 'DEMONSTRATIVO POR ESTADO DE DESTINO DA MERCADORIA OU DA PRESTACAO DE SERVICO', [comp17, negrito]);
          CadLinha(false, false, false, false, false, false, false, true, true, true, true, true, true);
          Rdp.ImpF(linha, 62, '============================================================================', [comp17, negrito]);
          CadLinha;
          CadLinha(false, false, false, false, false, false, false, false, false, true, true, true);
          Rdp.ImpF(linha, 87, 'OPERACOES REALIZADAS COM CONTRIBUINTES', [comp17, negrito]);
          CadLinha(false, false, false, false, false, false, false, false, false, true, true, true);
          Rdp.ImpF(linha, 87, '======================================', [comp17, negrito]);
          CadLinha;
          Rdp.ImpF(linha, 39, vDadosIni.vEmp.vSiglaUF, [comp17, negrito]);
          Rdp.ImpF(linha, 87, 'ICMS', [comp17, negrito]);
          Rdp.ImpD(linha, 59, format('%6.2f', [vlContabilContr]), [comp17, negrito]);
          Rdp.ImpD(linha, 107, format('%6.2f', [vlBaseCliContr]), [comp17, negrito]);
          CadLinha(false, false, false, false, false, false, false, false, false, true, true, true);
          Rdp.ImpF(linha, 87, 'OPERACOES REALIZADAS COM NAO CONTRIBUINTES', [comp17, negrito]);
          CadLinha(false, false, false, false, false, false, false, false, false, true, true, true);
          Rdp.ImpF(linha, 87, '==========================================', [comp17, negrito]);
          CadLinha;
          Rdp.ImpF(linha, 39, vDadosIni.vEmp.vSiglaUF, [comp17, negrito]);
          Rdp.ImpF(linha, 87, 'ICMS', [comp17, negrito]);
          Rdp.ImpD(linha, 59, format('%6.2f', [vlContabilNContr]), [comp17, negrito]);
          Rdp.ImpD(linha, 107, format('%6.2f', [vlBaseCliNContr]), [comp17, negrito]);

          for i := linha to 63 do
          begin
            CadLinha;
          end;
          if ModeloP = 'SIM' then
          begin
            linha := linha + 1;
            Rdp.ImpD(linha, 1, '+', [comp17, negrito]);
            Rdp.ImpF(linha, 2, vDadosIni.replicate('-', 227), [comp17, negrito]);
            Rdp.ImpD(linha, 230, '+', [comp17, negrito]);
          end;

        end;

      end;
    end;
    if Rdp.EstaAberto then
      Rdp.Fechar;
  end;
  vDadosIni.GravaAuditoria('REL027', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
end;

{ TRelatorioVeiculosNegociados }

function TRelatorioVeiculosNegociados.abreVeiculosNegociados(vTp: Integer): Boolean;
begin
  if vTp = 1 then
  begin
    buscas.close;
    buscas.SQL.text := 'SELECT FT.CHASSIV,VV.DESCRICAO,FT.CLIENTES_V, ' +
     ' FT.DATA_VEN,FT.NUM_NOTA_V,FT.VALTOT_V AS PRVEN_V,FT.TIPO_V,VD.COD_VENDEDOR, FT.TIPO_VENDA_V, ' +
     ' VD.NOME_VENDEDOR, VV.CILINDRADA, VV.CODIGO, VV.ORDTIPO, COALESCE(EST.ESTOQUE, ''P'') ESTOQUE,FT.VALOR_REAL, ' +
     ' CASE WHEN COALESCE(EST.NUM_NOTA,0) > 0 THEN ' +
     '   CASE WHEN FT.TIPO_VENDA_V = ''U'' THEN ' +
     '     COALESCE((SELECT FIRST 1 (ET.CUSTO) FROM COMPRASMESESV40 ET ' +
     '      WHERE ET.CHASSI = FT.CHASSIV AND ET.COD_EMPRESA = FT.COD_EMPRESA AND ET.STATUS_USO = FT.TIPO_VENDA_V ' +
     '      ORDER BY ET.DATA_CH_NOTA DESC), COALESCE(EST.PRECO_CUSTO,0)) ' +
     '   ELSE                                                            ' +
     '     COALESCE((SELECT FIRST 1 (ET.CUSTO) FROM COMPRASMESESV40 ET ' +
     '      WHERE ET.CHASSI = FT.CHASSIV AND ET.COD_EMPRESA = FT.COD_EMPRESA AND ET.STATUS_USO = FT.TIPO_VENDA_V ' +
     '      ORDER BY ET.DATA_CH_NOTA), COALESCE(EST.PRECO_CUSTO,0)) ' +
     '   END ' +
     ' ELSE ' +
     '   COALESCE(EST.PRECO_CUSTO,0) ' +
     ' END AS CUSTO ' +
     ' FROM COM_FAT FT ' +
     ' INNER JOIN EST_MOTO EST ON EST.CODIGO = FT.COD_ESTMOTO AND EST.CHASSI_C = FT.CHASSIV AND EST.COD_EMPRESA = FT.COD_EMPRESA ' +
     ' INNER JOIN COLABORADOR VD ON VD.COD_VENDEDOR = FT.COVEND_V AND VD.COD_EMPRESA = FT.COD_EMPRESA ' +
     ' INNER JOIN tipmodelo VV ON VV.CODIGO = EST.VERSAOEST AND VV.COD_EMPRESA = EST.COD_EMPRESA ' +
     ' LEFT JOIN NAT_OP NT ON NT.CODIGO_NOP = FT.NATOP_V ' +
     ' WHERE FT.NATUREZA = ''S'' and (COALESCE(TRIM(FT.STATUS_V), '''') = ''FECHADO'') ' +
     ' AND FT.DATA_VEN >= :VDAT1 AND FT.DATA_VEN <= :VDAT2 ' +
     ' AND COALESCE(NT.FATURAMENTO, ''N'') = ''S'' ' +
     ' AND FT.COD_EMPRESA = :COD_EMPRESA AND FT.ATIVO = 1';
  end
  else
  begin
    buscas.close;
    buscas.SQL.text := ' SELECT VV.ORDTIPO,VV.CODIGO, VV.DESCRICAO, COUNT(*),SUM(FT.VALTOT_V), ' +
     ' SUM(FT.VALOR_REAL) AS VALOR_REAL FROM COM_FAT FT ' +
     ' INNER JOIN EST_MOTO EST ON EST.CODIGO = FT.COD_ESTMOTO AND EST.CHASSI_C = FT.CHASSIV AND EST.COD_EMPRESA = FT.COD_EMPRESA ' +
     ' INNER JOIN COLABORADOR VD ON VD.COD_VENDEDOR = FT.COVEND_V AND VD.COD_EMPRESA = FT.COD_EMPRESA ' +
     ' INNER JOIN tipmodelo VV ON VV.CODIGO = EST.VERSAOEST AND VV.COD_EMPRESA = EST.COD_EMPRESA ' +
     ' LEFT JOIN NAT_OP NT ON NT.CODIGO_NOP = FT.NATOP_V ' +
     ' WHERE FT.NATUREZA = ''S'' AND (COALESCE(TRIM(FT.STATUS_V), '''') = ''FECHADO'') ' +
     ' AND FT.DATA_VEN >= :VDAT1 AND FT.DATA_VEN <= :VDAT2 ' +
     ' AND COALESCE(NT.FATURAMENTO, ''N'') = ''S'' ' +
     ' AND FT.COD_EMPRESA = :COD_EMPRESA AND FT.ATIVO = 1';
  end;
  buscas.ParamByName('COD_EMPRESA').asstring:= vDadosIni.codEmpresa;
  buscas.ParamByName('vdat1').asdate := datainicial;
  buscas.ParamByName('vdat2').asdate := datafinal;
  if FiltrarTipoVeic then
    buscas.sql.text := buscas.sql.text + ' and tipo_venda_v = :vtip ';
  if FiltrarTipoVeic then
    if trim(TipoVeiculo) = 'NOVO' then
      buscas.ParamByName('vtip').asstring := 'N'
    else
      buscas.ParamByName('vtip').asstring := 'U';
  if FiltrarTipoVenda then
  begin
    buscas.sql.text := buscas.sql.text + ' and ft.tipo_v = :vtp ';
    buscas.ParamByName('vtp').asstring := TipoVenda;
  end;
  if FiltrarVendedor then
  begin
    buscas.sql.text := buscas.sql.text + ' and vd.cod_vendedor = :vcodv';
    buscas.ParamByName('vcodv').asinteger := StrToInt(Vendedor);
  end;
  if vTp <> 1 then
    buscas.sql.text := buscas.sql.text +  ' group by vv.ordtipo, vv.descricao, vv.codigo';//, ft.data_ven';

  if vTp = 1 then
    buscas.sql.text := buscas.sql.text + ' order by ft.tipo_venda_v, est.estoque, vv.ordtipo,vv.descricao, vv.codigo, ft.data_ven'
  else
    buscas.sql.text := buscas.sql.text + ' order by vv.ordtipo,vv.descricao, vv.codigo';
  buscas.open;
end;

procedure TRelatorioVeiculosNegociados.CabNovaPagina;
