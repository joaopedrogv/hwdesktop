   Rdp.ImpF(linha, 1, 'Total Geral', [negrito]);
   Rdp.ImpD(linha, 65, Format('%m', [vtotvend + vtotpart]), [negrito]);
 end;
 inc(linha);
 Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
 if Rdp.EstaAberto then
  Rdp.Fechar;
 vDadosIni.GravaAuditoria('REL054', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
 buscas.Close;
 frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatorioRequisicoesOrdensDeServicosEmitidasPorPeriodo }

function TRelatorioRequisicoesOrdensDeServicosEmitidasPorPeriodo.abreReqOSsPorPeriodo: Boolean;
begin
  try
    Result := False;
    //OSs emitidas por período
    buscas.Close;
    buscas.SQL.Text := 'select v.nped,v.tipo,v.nprevenda,v.data_ped,v.tot_prod,v.tot_serv,v.placa,' +
      ' v.valor_total,cond.desc_cond_pag, v.status_ped,v.data_fech, v.tipo_os,v.cod_cliente,c.NOME_CLIENTE, c.RAZAO,' +
      ' coalesce((select sum(coalesce(vpt.vl_total, 0)) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa), 0) as totalprodT,' +
      ' coalesce((select sum(coalesce(vst.vl_servt, 0)) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa), 0) as totalServT,' +
      ' coalesce((select sum(coalesce(vsg.prc_int_serv, 0)) from pedvenda_serv vsg ' +
      ' where vsg.nped=v.nped and vsg.tipo=v.tipo and vsg.cod_empresa=v.cod_empresa ' +
      ' and (vsg.status<>''CANCELADO'' or vsg.status is null)), 0) as ServGarantia,' +
      ' coalesce(((select coalesce(sum(vpt.vl_total),0) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa)+ ' +
      ' (select coalesce(sum(vst.vl_servt),0) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa )+ ' +
      ' coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) - coalesce(v.valor_total, 0)), 0) as desconto, ' +
      ' coalesce(0 - ((select coalesce(sum(vpt.vl_total),0) from pedvenda_prod_terc vpt ' +
      ' where vpt.nped=v.nped and vpt.tipo=v.tipo and vpt.cod_empresa=v.cod_empresa)+ ' +
      ' (select coalesce(sum(vst.vl_servt),0) from pedvenda_serv_terc vst ' +
      ' where vst.nped=v.nped and vst.tipo=v.tipo and vst.cod_empresa=v.cod_empresa)+ ' +
      ' coalesce(v.tot_prod, 0) + coalesce(v.tot_serv, 0) - coalesce(v.valor_total, 0)), 0) as acrescimo ' +
      ' from pedvenda v ';
     if FiltrarAreaExec then
       buscas.SQL.Text := buscas.SQL.Text  +
        ' inner join tipo_vendas tp on tp.tipo = v.tipo and (tp.sigla = v.tipv or (tp.tipo_os = v.tipo_os)) ';
     buscas.SQL.Text := buscas.SQL.Text +
      ' inner join clientes c on v.cod_cliente=c.cod_cliente and v.cod_empresa=c.cod_empresa ' +
      ' left join cond_pag cond on v.cod_cond_pag=cond.cod_cond_pag ' +
      ' where v.cod_empresa=' + vDadosIni.codEmpresa +
      ' and v.tipo in (''REQ'', ''OS'') and v.ativo=1 ';

    if FiltrarCliente then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
    if StatusPed = 'ABERTA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf and ' +
        ' ((v.data_fech is null) or (v.data_fech > :dtf)) and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) '
    else if StatusPed = 'FECHADA' then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.data_fech >= :dti and v.data_fech <= :dtf and v.status_ped=''FECHADA'' '
    else
      buscas.SQL.Text := buscas.SQL.Text + ' and ((v.data_fech >= :dti and v.data_fech <= :dtf) or (v.data_ped >= :dti and v.data_ped <= :dtf)) ' +
        ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

    if FiltrarCondPagamento then
      buscas.SQL.Text := buscas.SQL.Text + ' and cond.desc_cond_pag = ' + QuotedStr(trim(dtSetCondPag.FieldByName('desc_cond_pag').AsString)); //cod_cond_pag ='+ dtSetCondPag.FieldByName('cod_cond_pag').AsString;

    if (FiltrarTipoVenda) or (FiltrarTipoOS) then
    	buscas.SQL.Text := buscas.SQL.Text + ' and (((v.tipo = ''REQ'') and (v.tipv = ' + QuotedStr(trim(TipoVenda)) + ')) ' +
      	'																					or ((v.tipo = ''OS'') and (v.tipo_os = ' + QuotedStr(trim(TipoOs)) + '))) '
    else if FiltrarTipoVenda then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.tipv = ' + QuotedStr(trim(TipoVenda))
    else if FiltrarTipoOS then
      buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo_os = ' + QuotedStr(trim(TipoOs));

    if FiltrarAreaExec then
        buscas.SQL.Text := buscas.SQL.Text + ' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec));
                                                           
    buscas.SQL.Text := buscas.SQL.Text + ' order by cond.desc_cond_pag,v.data_ped,v.nped';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;

end;

