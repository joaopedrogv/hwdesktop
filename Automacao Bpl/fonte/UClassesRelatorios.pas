  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|PASSAGENS POR CONSULTORES|[normal, negrito]|||');
  buscas.close;
  buscas.sql.text := 'SELECT COL.NOME_VENDEDOR,COUNT(*) AS VALOR FROM PEDVENDA PD, COLABORADOR COL '+
   ' WHERE PD.DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datainicial)) +
   ' AND PD.DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datafinal)) +
   ' AND PD.TIPO = ''OS'' AND TIPO_OS <> ''OUTROS'' AND PD.STATUS_PED = ''FECHADA'' AND PD.COD_VENDEDOR = COL.COD_VENDEDOR ' +
   ' AND PD.COD_EMPRESA = COL.COD_EMPRESA AND PD.COD_EMPRESA = ' + vDadosIni.CodEmpresa + ' GROUP BY COL.NOME_VENDEDOR ';
