function TRelatorioVendasPorVendedor.ImprimeDevolucao(pcodVendedor: integer; vDescriFuncao: string): boolean;
begin
  buscasGerais.Close;
  buscasGerais.SQL.text := 'select vp.cod_vendedor,vp.data_fech as data,vp.quant_ped_item as quant,vp.grupo_prod,' +
    ' vp.cod_prod,vp.DESCR_PROD_PED as descricao,vp.VLUN_PED_ITEM as valor, coalesce(vp.comiss_prod,0) as comiss_prod, ' +
    ' coalesce(vp.comiss_prod_ger,0) as comiss_prod_ger, vp.tipo,vp.nped as sequencia from vendaprodutos vp ';
  if FiltrarAreaExec then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text +
    ' inner join tipo_vendas tp on tp.tipo = vp.tipo and (tp.sigla = vp.tipv or (tp.tipo_os = vp.tipo_os)) ';

  buscasGerais.SQL.text := buscasGerais.SQL.text +
    ' where vp.data_fech >= :dti ' +
    ' and vp.data_fech <= :dtf ' +
    ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and vp.tipo = ''DEV'' ';

  if FiltrarTipoVenda and FiltrarTipoOS then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' )' +
      ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ')) '
  else if FiltrarTipoVenda then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ') ' +
      ' or (not vp.TIPO_OS is null and vp.venda = ''S'') )'
  else if FiltrarTipoOS then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((not vp.TIPV is null and vp.venda = ''S'')' +
      ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + '))'
  else
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.venda = ''S'' ';

  if FiltrarAreaExec then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text +
    ' and ((vp.tipo = ''OS'' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (vp.tipo <> ''OS'')) ';

  buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.cod_vendedor = ' + inttostr(pCodVendedor);
  buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
  buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
  buscasGerais.Open;
  buscasGerais.FetchAll;

  while not buscasGerais.eof do
  begin
    Rdp.ImpD(linha, 8, buscasGerais.FieldByName('COD_VENDEDOR').AsString {vDadosIni.StrZero(Buscas.FieldByName('N_NF').AsInteger, 8)}, [comp17]);
    Rdp.Imp(linha, 12, buscasGerais.FieldByName('DATA').asstring);
    Rdp.ImpD(linha, 28, Floattostr(buscasGerais.FieldByName('quant').AsCurrency {* (-1)}), [comp17]);
    Rdp.ImpD(linha, 37, buscasGerais.FieldByName('GRUPO_PROD').asstring, [comp17]);
    Rdp.ImpF(linha, 38, trim(buscasGerais.FieldByName('cod_Prod').asstring), [comp17]);
    Rdp.ImpF(linha, 45, Copy(trim(buscasGerais.FieldByName('descricao').AsString), 1, 32), [comp17]);
    Rdp.ImpD(linha, 86, format('%n', [buscasGerais.FieldByName('valor').AsCurrency {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 103, format('%n', [(buscasGerais.FieldByName('valor').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);
    if pos('GERENTE', vDescriFuncao) > 0 then
      Rdp.ImpD(linha, 113, format('%n', [buscasGerais.FieldByName('comiss_prod_ger').AsCurrency {* (-1)}]), [comp17]) //;// [comp17]);
    else
      Rdp.ImpD(linha, 113, format('%n', [buscasGerais.FieldByName('comiss_prod').AsCurrency {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 124, 'DEV', [comp17]);
    Rdp.ImpD(linha, 132, vDadosIni.StrZero(buscasGerais.FieldByName('SEQUENCIA').AsInteger, 6), [comp17]);
    linha := linha + 1;
    if linha >= 60 then
    begin
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
      linha := 2;
      CabNovaPagina;
      if TipoRelatorio = 'ANALÍTICO' then
        MenuAnalitico;
    end;
    buscasGerais.next;
  end;
  buscasGerais.close;
  result := true;
end;

procedure TRelatorioVendasPorVendedor.ImprimeFuncComissionadosSemVendas;
var
  contTemp: integer;
begin
  try
    if not FListarFuncComissSemVND then
      exit;
    buscas6.Close;
    buscas6.SQL.Text := 'select c.nome_vendedor,c.cod_vendedor from colaborador c ' +
      ' where c.cod_empresa=' + vDadosIni.codEmpresa + //' and c.ativo=1 ' +
      ' and ((coalesce(c.pc_vend_serv,0)<>0) or (coalesce(c.PC_VEND_PROD,0)<>0))  ';
    if FiltrarVendedor then
      buscas6.SQL.Text := buscas6.SQL.Text +' and c.cod_vendedor in '+CodVendedor;
    buscas6.SQL.Text := buscas6.SQL.Text + ' order by c.nome_vendedor';
    buscas6.Open;
    buscas6.FetchAll;
    frmRelatorios.ProgressBar.Max := frmRelatorios.ProgressBar.Max + buscas6.RecordCount;
    vDadosIni.abreStatusProcessamento('', 'Imprimindo Funcionários comissionados sem vendas');
    while not buscas6.Eof do
    begin
      buscasGerais.Close;
      buscasGerais.SQL.Text := ' select first 1 vps.cod_vendedor from PROD_SERV_EMVENDAS vps ';
      if FiltrarAreaExec then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' inner join tipo_vendas tp on tp.tipo = vps.tipo and (tp.sigla = vps.sigla or (tp.tipo_os = vps.tipo_os)) ';
      buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' where vps.data_fech>=:dti and vps.data_fech<=:dtf ' +
        ' and vps.cod_empresa=' + vDadosIni.codEmpresa + ' and ((coalesce(vps.pc_vend_serv,0)<>0) or (coalesce(vps.PC_VEND_PROD,0)<>0)) ';

      if FiltrarTipoVenda and FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vps.SIGLA = ' + QuotedStr(trim(TipoVenda)) + ' and vps.tipo=''REQ'')' +
          ' or (vps.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vps.tipo=''OS''))'
      else if FiltrarTipoVenda then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vps.SIGLA = ' + QuotedStr(trim(TipoVenda)) + ' and vps.tipo=''REQ'')' +
          ' or (not vps.TIPO_OS is null and vps.tipo=''OS'' and vps.venda=''S''))'
      else if FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((not vps.SIGLA is null and vps.tipo=''REQ'' and vps.venda=''S'')' +
          ' or (vps.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vps.tipo=''OS''))'
      else
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vps.tipo<>''ORC'' and vps.venda=''S'' ';

      if FiltrarAreaExec then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text +
        ' and ((vps.tipo = ''OS'' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (vps.tipo <> ''OS'')) ';

      buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vps.cod_vendedor = ' + buscas6.FieldByName('cod_vendedor').AsString;

      buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
      buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
      buscasGerais.Open;
      buscasGerais.FetchAll;
      if buscasGerais.IsEmpty then
      begin
        FBuscas8.Close;
        FBuscas8.SQL.Text := ' select count(v.nped) as qtdVendasAbertas from tipo_vendas tv ' +
          ' inner join pedvenda v on v.tipo=tv.tipo and (v.tipv=tv.sigla or (v.tipo_os=tv.tipo_os)) '+
          ' inner join colaborador c on c.cod_vendedor=v.cod_vendedor and c.cod_empresa=v.cod_empresa ' +
          ' where v.status_ped=''FECHADA'' and v.data_fech>=:dti and '+
          ' v.data_fech<=:dtf  and v.cod_empresa= '+vDadosIni.codEmpresa+
          ' and v.ativo=1 and v.cod_vendedor=' +inttostr(buscas6.FieldByName('cod_vendedor').AsInteger);

        if FiltrarTipoVenda and FiltrarTipoOS then
          FBuscas8.SQL.Text := FBuscas8.SQL.Text + ' and ((v.tipv = ' + QuotedStr(trim(TipoVenda)) + ' and v.tipo=''REQ'')' +
            ' or (v.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and v.tipo=''OS''))'
        else if FiltrarTipoVenda then
          FBuscas8.SQL.Text := FBuscas8.SQL.Text + ' and ((v.tipv = ' + QuotedStr(trim(TipoVenda)) + ' and v.tipo=''REQ'')' +
            ' or (not v.TIPO_OS is null and v.tipo=''OS'' and tv.venda=''S''))'
        else if FiltrarTipoOS then
          FBuscas8.SQL.Text := FBuscas8.SQL.Text + ' and ((not v.tipv is null and v.tipo=''REQ'' and tv.venda=''S'')' +
            ' or (v.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and v.tipo=''OS''))'
        else
          FBuscas8.SQL.Text := FBuscas8.SQL.Text + ' and v.tipo<>''ORC'' and tv.venda=''S'' ';

        if FiltrarAreaExec then
          FBuscas8.SQL.Text := FBuscas8.SQL.Text +
          ' and ((v.tipo = ''OS'' and trim(tv.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (v.tipo <> ''OS'')) ';

        FBuscas8.Params.ParamByName('dti').AsDate := datainicial;
        FBuscas8.Params.ParamByName('dtf').AsDate := datafinal;
        FBuscas8.Open;
        FBuscas8.FetchAll;
        if FBuscas8.FieldByName('qtdVendasAbertas').AsInteger>0 then
        begin
        linha := linha + 1;
        Rdp.Imp(linha, 1, copy(buscas6.FieldByName('nome_vendedor').AsString, 1, 26));
//          Rdp.ImpD(linha, 39, '0,00', [comp17]);
//          Rdp.ImpD(linha, 51, '0,00', [comp17]);
//          Rdp.ImpD(linha, 65, '0,00', [comp17]);
//          Rdp.ImpD(linha, 78, '0,00', [comp17]);
//          Rdp.ImpD(linha, 88, '0,00', [comp17]);
//          Rdp.ImpD(linha, 110, '0,00', [comp17]);
//          Rdp.ImpD(linha, 121, '0,00', [comp17]);
//          Rdp.ImpD(linha, 96, '0,00', [comp17]);
//          Rdp.ImpD(linha, 126, vDadosIni.StrZero(0, 4), [comp17]);
//          Rdp.ImpD(linha, 132, vDadosIni.StrZero(0, 4), [comp17]);
          Rdp.ImpD(linha, 138, vDadosIni.StrZero(FBuscas8.FieldByName('qtdVendasAbertas').AsInteger, 4), [comp17]);
        linha := linha + 1;
        Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas - 1));
        if linha >= 60 then
        begin
          Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
          linha := 2;
          CabNovaPagina;
          Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas - 1));
          MenuSintetico;
  //          if TipoRelatorio = 'ANALÍTICO' then
  //            MenuAnalitico;
        end;
          FBuscas8.Close;
      end;
      end;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
      buscas6.Next;
    end;
    linha := linha + 1;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;

end;

procedure TRelatorioVendasPorVendedor.ImprimeRelatorios;
var
  vtipo, vNomeVendedor, vDescriFuncao: string;
  vNped: Integer;
  vTipoNped: string;
  vCodVendNped: Integer;
  vTotLiq, vTotBr: Double;
  vIncItensProd, vIncItensServ: Double;
  vQtdeItensProd, vQtdeItensServ: Double;
  vCodVendedor: integer;
  qtdGeralServ, vlGeralServ, vlGeralProd: double;
  vlGeralProdInfo: Extended; //Valor informativo de produtos usados pelo mecanico na OS, campo COL_COD_VENDEDOR
  buscasFP: TIBQuery;
  vTotRec: Double;
begin
	  if not vDadosIni.PesqPros('REL009', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not AbreItensProd then //abre query buscas
  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
  end;

  buscasFP := TIBQuery.Create(Application);
  buscasFP.Database := buscas.Database;
  buscasFP.Transaction := buscas.Transaction;

  vpag := 0;
  vNped := 0;
  vTipoNped := '';
  vCodVendedor := 0;
  vTotRec := 0;
  vTotLiq := 0;
  vTotBr := 0;
  vIncItensProd := 0;
  vIncItensServ := 0;
  vQtdeItensProd := 0;
  vQtdeItensServ := 0;
  vlGeralProd  := 0;
  vlGeralProdInfo := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 138;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Vendas e Faturamento de Produtos - Todos os Departamentos';
  rdp.TitulodoRelatorio := 'Vendas e Faturamento de Produtos - OS e REQ';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  CabNovaPagina; //cabeçalho
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  // Inicio da Impressão dos Itens.
  vtipo := '';
  if TipoRelatorio = 'ANALÍTICO' then
  begin
    Rdp.ImpF(linha, 1, trim(buscas.FieldByName('NOME_VENDEDOR').AsString), [comp17, negrito]);
    MenuAnalitico;
  end;
  vCodVendedor := Buscas.FieldByName('COD_VENDEDOR').asInteger;
  vNomeVendedor := trim(Buscas.FieldByName('NOME_VENDEDOR').AsString);
  vDescriFuncao := trim(Buscas.FieldByName('desc_funcao').asString);

  vNped := Buscas.FieldByName('nped').AsInteger;
  vTipoNped := trim(Buscas.FieldByName('tipo').AsString);
  vCodVendNped := Buscas.FieldByName('cod_vendedor').AsInteger;

  //    AbreTotalServicosProdutos(Buscas.FieldByName('COD_VENDEDOR').asInteger);
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    try
      if TipoRelatorio = 'ANALÍTICO' then
      begin
        if ListarProdutos = 'NÃO' then
        begin
          if Buscas.FieldByName('prod_serv').AsString = 'S' then
          begin
            Rdp.ImpD(linha, 8, Buscas.FieldByName('COD_VENDEDOR').AsString {vDadosIni.StrZero(Buscas.FieldByName('N_NF').AsInteger, 8)}, [comp17]);
            Rdp.Imp(linha, 12, Buscas.FieldByName('DATA_FECH').asstring);
            Rdp.ImpD(linha, 28, Floattostr(Buscas.FieldByName('quant_ped_item').ascurrency), [comp17]);
            Rdp.ImpD(linha, 37, Buscas.FieldByName('GRUPOP_CODSERV').asstring, [comp17]);
            Rdp.ImpF(linha, 38, trim(Buscas.FieldByName('cod_Prod').asstring), [comp17]);
            Rdp.ImpF(linha, 45, Copy(trim(Buscas.FieldByName('descr_item_ped').AsString), 1, 32), [comp17]);
            if Buscas.FieldByName('quant_ped_item').AsCurrency <> 0 then
              Rdp.ImpD(linha, 86, format('%n', [(Buscas.FieldByName('vlun_ped_item').AsCurrency) - (Buscas.FieldByName('rateio_desc').AsCurrency / Buscas.FieldByName('quant_ped_item').AsCurrency)]), [comp17])
            else
              Rdp.ImpD(linha, 86, format('%n', [(Buscas.FieldByName('vlun_ped_item').AsCurrency) - (Buscas.FieldByName('rateio_desc').AsCurrency / 1)]), [comp17]);
            Rdp.ImpD(linha, 103, format('%n', [(Buscas.FieldByName('vlun_ped_item').AsCurrency * Buscas.FieldByName('quant_ped_item').ascurrency) - Buscas.FieldByName('rateio_desc').AsCurrency]), [comp17]);
            if pos('GERENTE', vDescriFuncao) > 0 then
              Rdp.ImpD(linha, 113, format('%n', [Buscas.FieldByName('comiss_prod_ger').AsCurrency]), [comp17]) //;// [comp17]);
            else
              Rdp.ImpD(linha, 113, format('%n', [Buscas.FieldByName('comiss_prod').AsCurrency]), [comp17]);
            Rdp.ImpD(linha, 123, trim(Buscas.FieldByName('tipo').AsString), [comp17]);
            Rdp.ImpD(linha, 131, vDadosIni.StrZero(Buscas.FieldByName('nped').AsInteger, 6), [comp17]);
            linha := linha + 1;
          end;
        end
        else
        begin
          if (vNped <> Buscas.FieldByName('nped').AsInteger)
          	or (trim(vTipoNped) <> trim(Buscas.FieldByName('tipo').AsString))
            or (vCodVendNped <> Buscas.FieldByName('cod_vendedor').AsInteger) then
          begin
            ImprimirTotalDoc(vTotLiq, vTotBr, vIncItensProd, vIncItensServ, vQtdeItensProd, vQtdeItensServ);

            ImprimirReceb(vNped, vTipoNped, vIncItensProd, vIncItensServ, vQtdeItensProd, vQtdeItensServ, buscasFP);

            vIncItensProd := 0;
            vIncItensServ := 0;
          end;

          Rdp.ImpD(linha, 8, Buscas.FieldByName('COD_VENDEDOR').AsString {vDadosIni.StrZero(Buscas.FieldByName('N_NF').AsInteger, 8)}, [comp17]);
          Rdp.Imp(linha, 12, Buscas.FieldByName('DATA_FECH').asstring);
          Rdp.ImpD(linha, 28, Floattostr(Buscas.FieldByName('quant_ped_item').AsCurrency), [comp17]);
          Rdp.ImpD(linha, 37, Buscas.FieldByName('GRUPOP_CODSERV').asstring, [comp17]);
          Rdp.ImpF(linha, 38, trim(Buscas.FieldByName('cod_Prod').asstring), [comp17]);
          Rdp.ImpF(linha, 45, Copy(trim(Buscas.FieldByName('descr_item_ped').AsString), 1, 32), [comp17]);
          if Buscas.FieldByName('quant_ped_item').AsCurrency <> 0 then
            Rdp.ImpD(linha, 86, format('%n', [(Buscas.FieldByName('vlun_ped_item').AsCurrency) - (Buscas.FieldByName('rateio_desc').AsCurrency / Buscas.FieldByName('quant_ped_item').AsCurrency)]), [comp17])
          else
            Rdp.ImpD(linha, 86, format('%n', [(Buscas.FieldByName('vlun_ped_item').AsCurrency) - (Buscas.FieldByName('rateio_desc').AsCurrency / 1)]), [comp17]);
          Rdp.ImpD(linha, 103, format('%n', [((Buscas.FieldByName('vlun_ped_item').AsCurrency * Buscas.FieldByName('quant_ped_item').ascurrency)) - Buscas.FieldByName('rateio_desc').AsCurrency]), [comp17]);
          if pos('GERENTE', vDescriFuncao) > 0 then
            Rdp.ImpD(linha, 113, format('%n', [Buscas.FieldByName('comiss_prod_ger').AsCurrency]), [comp17]) //;// [comp17]);
          else
            Rdp.ImpD(linha, 113, format('%n', [Buscas.FieldByName('comiss_prod').AsCurrency]), [comp17]);
          Rdp.ImpD(linha, 124, trim(Buscas.FieldByName('tipo').AsString), [comp17]);
          Rdp.ImpD(linha, 132, vDadosIni.StrZero(Buscas.FieldByName('nped').AsInteger, 6), [comp17]);
          linha := linha + 1
        end;
      end;
    except
    end;

    vTotLiq := Buscas.FieldByName('valor_total_liquido').AsCurrency;
  	vTotBr := Buscas.FieldByName('valor_total_bruto').AsCurrency;
    vQtdeItensProd := Buscas.FieldByName('qtde_prod').AsFloat;
    vQtdeItensServ := Buscas.FieldByName('qtde_serv').AsFloat;

    if Buscas.FieldByName('PROD_SERV').AsString = 'P' then
    	vIncItensProd := vIncItensProd + Buscas.FieldByName('quant_ped_item').AsCurrency
    else if Buscas.FieldByName('PROD_SERV').AsString = 'S' then
    	vIncItensServ := vIncItensServ + Buscas.FieldByName('quant_ped_item').AsCurrency;

    vNped        := Buscas.FieldByName('nped').AsInteger;
    vTipoNped    := trim(Buscas.FieldByName('tipo').AsString);
    vCodVendNped := Buscas.FieldByName('cod_vendedor').AsInteger;

    buscas.Next;
    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    if (vCodVendedor <> Buscas.FieldByName('COD_VENDEDOR').asInteger) then
    begin
      if (linha >= 60) and (TipoRelatorio = 'ANALÍTICO') then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
        linha := 2;
        CabNovaPagina;
        linha := linha + 1;
        //        MenuAnalitico;
      end;

      if (TipoRelatorio = 'ANALÍTICO') then
      begin
    		ImprimirTotalDoc(vTotLiq, vTotBr, vIncItensProd, vIncItensServ, vQtdeItensProd, vQtdeItensServ);

        ImprimirReceb(vNped, vTipoNped, vIncItensProd, vIncItensServ, vQtdeItensProd, vQtdeItensServ, buscasFP);

        vNped        := buscas.FieldByName('nped').AsInteger;
        vTipoNped    := trim(buscas.FieldByName('tipo').AsString);
        vCodVendNped := buscas.FieldByName('cod_vendedor').AsInteger;

        vIncItensProd := 0;
        vIncItensServ := 0;
      end;

      if (TipoRelatorio = 'ANALÍTICO') then
        ImprimeDevolucao(vCodVendedor, vDescriFuncao);
      // Devoluções para este Colaborador
      //      MenuSintetico;
      if linha >= 57 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
        linha := 2;
        CabNovaPagina;
        if TipoRelatorio = 'ANALÍTICO' then
        begin
          if not buscas.IsEmpty then
          Rdp.ImpF(linha, 1, trim(buscas.FieldByName('NOME_VENDEDOR').AsString), [comp17, negrito]);
          MenuAnalitico;
        end;
      end;
      AbreTotalServicosProdutos(vCodVendedor); //abriu buscas1=produtos e buscas2=serviços
      MenuSintetico;
      Rdp.Imp(linha, 1, copy(vNomeVendedor, 1, 15)); //26));
      Rdp.ImpD(linha, 25, format('%f', [Buscas2.FieldByName('TotalValor').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 37, format('%f', [Buscas2.FieldByName('TotalDesc').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 51, format('%f', [Buscas2.FieldByName('TotalLiquido').AsCurrency]), [comp17]);
      if vCodVendedor = Buscas1.FieldByName('cod_vendedor').AsInteger then
      begin
        Rdp.ImpD(linha, 64, format('%f', [(Buscas1.FieldByName('TotalVAlor').AsCurrency + abs(buscasGerais.FieldByName('vltotaldevolvido').AsCurrency))]), [comp17]);
        Rdp.ImpD(linha, 74, format('%f', [Buscas1.FieldByName('TotalDesc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 84, format('%f', [Buscas1.FieldByName('TotalAcresc').AsCurrency]), [comp17]);
        //O valor devolvido já vem negativo
        Rdp.ImpD(linha, 106, format('%f', [Buscas1.FieldByName('TotalLiquido').AsCurrency {- ((-1)*buscasGerais.FieldByName('vltotaldevolvido').AsCurrency)}]), [comp17]);
        Rdp.ImpD(linha, 117, format('%f', [Buscas2.FieldByName('TotalLiquido').AsCurrency + Buscas1.FieldByName('TotalLiquido').AsCurrency {- ((-1)*buscasGerais.FieldByName('vltotaldevolvido').AsCurrency)}]), [comp17]);
        vlGeralProd := vlGeralProd + Buscas1.FieldByName('TotalLiquido').AsCurrency;
      end
      else if vCodVendedor = Buscas6.FieldByName('COL_COD_VENDEDOR').AsInteger then
      begin
        Rdp.ImpD(linha, 64, format('%f', [(Buscas6.FieldByName('TotalVAlor').AsCurrency + abs(buscasGerais.FieldByName('vltotaldevolvido').AsCurrency))]), [comp17]);
        Rdp.ImpD(linha, 74, format('%f', [Buscas6.FieldByName('TotalDesc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 84, format('%f', [Buscas1.FieldByName('TotalAcresc').AsCurrency]), [comp17]);
        //O valor devolvido já vem negativo
        Rdp.ImpD(linha, 106, format('%f', [Buscas6.FieldByName('TotalLiquido').AsCurrency {- ((-1)*buscasGerais.FieldByName('vltotaldevolvido').AsCurrency)}]), [comp17]);
        Rdp.ImpD(linha, 117, format('%f', [Buscas2.FieldByName('TotalLiquido').AsCurrency + Buscas6.FieldByName('TotalLiquido').AsCurrency {- ((-1)*buscasGerais.FieldByName('vltotaldevolvido').AsCurrency)}]), [comp17]);
        vlGeralProdInfo := vlGeralProdInfo + Buscas6.FieldByName('TotalLiquido').AsCurrency;
      end
      else
      begin
        Rdp.ImpD(linha, 64, '0,00', [comp17]);
        Rdp.ImpD(linha, 74, '0,00', [comp17]);
        Rdp.ImpD(linha, 84, '0,00', [comp17]);
        Rdp.ImpD(linha, 106, '0,00', [comp17]);
        Rdp.ImpD(linha, 117, format('%f', [Buscas2.FieldByName('TotalLiquido').AsCurrency]), [comp17]);
      end;

      Rdp.ImpD(linha, 94, format('%f', [buscasGerais.FieldByName('vltotaldevolvido').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 122, vDadosIni.StrZero(Buscas3.FieldByName('qtdOS').AsInteger, 4), [comp17]);
