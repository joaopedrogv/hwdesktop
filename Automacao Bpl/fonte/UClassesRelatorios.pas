function TRelatorioComissaoProdRecebimento.abreRecebimentos: Boolean;
var
  vTemp, vCodColabGer: string;
  vGerente: Boolean;
begin
  try
    Result := False;
    //Recebimentos à vista

    vGerente := False;
    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') and (FiltrarVendedor) then
    begin

      vCodColabGer := '';

      buscas.Close;
      buscas.SQL.Text := 'select cod_vendedor from colaborador' +
        ' where cod_gerente in ' + CodVendedor +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if not buscas.IsEmpty then
      begin

        vCodColabGer := '(' + CodVendedor;
        vGerente := True;
        buscas.First;
        while not buscas.Eof do
        begin

          if Trim(vCodColabGer) = '' then
            vCodColabGer := '(' + Trim(buscas.FieldByName('cod_vendedor').AsString)
          else
            vCodColabGer := vCodColabGer + ',' + Trim(buscas.FieldByName('cod_vendedor').AsString);

          buscas.Next;
        end;
        if Trim(vCodColabGer) <> '' then
          vCodColabGer := vCodColabGer + ')';

      end;
    end;

    vTemp := '';
    if vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S' then
      vTemp := 'fp.vl_baixa_comissao valordoc,';

    buscas.Close;
    buscas.SQL.Text := 'select ' + vTemp + 'fp.*,fp.valordoc valor_doc,c.nome_ctrl from formpagamento fp ' +
    	' left join controles c on fp.cod_controle = c.codigo_ctrl and fp.cod_empresa = c.codigo_emp ' +
      ' where fp.data_mov >= :dti and fp.data_mov <= :dtf ' +
      ' and fp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and fp.ativo = 1 ' +
      ' and c.docs = ''N'' ';

    if (FiltrarControle) then
     	buscas.SQL.Text := buscas.SQL.Text + ' and fp.cod_controle = ' + Controle;

    if vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S' then
      buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(fp.vl_baixa_comissao, 0) > 0';
    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') and (FiltrarVendedor) and (vGerente) then
      buscas.SQL.Text := buscas.SQL.Text + ' and fp.operador in ' + vCodColabGer + ' order by fp.seqform'
    else if FiltrarVendedor then
      buscas.SQL.Text := buscas.SQL.Text + ' and fp.operador in ' + CodVendedor + ' order by fp.seqform'
    else
      buscas.SQL.Text := buscas.SQL.Text + ' order by fp.seqform,fp.operador';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    //Recebimentos cheque
    vTemp := '';
    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') then
      vTemp := ' or ch.tip_baixa = ''A''';
    buscas1.Close;
    buscas1.SQL.Text := 'select ch.*,c.nome_ctrl from controle_cheque ch ' +
      ' left join controles c on ch.codigo_ctrl = c.codigo_ctrl and ch.codigo_emp = c.codigo_emp ' +
      ' where ch.dt_baixa_comissao >= :dti and ch.dt_baixa_comissao <= :dtf ' +
      ' and (ch.tip_baixa = '''' or ch.tip_baixa is null' + vTemp + ') ' +
      ' and ch.codigo_emp = ' + vDadosIni.codEmpresa;

    if vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S' then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and coalesce(ch.vl_baixa_comissao,0) > 0';

    if (FiltrarControle) then
     	buscas1.SQL.Text := buscas1.SQL.Text + ' and ch.codigo_ctrl = ' + Controle;

    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') and (FiltrarVendedor) and (vGerente) then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and ch.codigo_vend in ' + vCodColabGer + ' order by ch.codigo_ch'
    else if FiltrarVendedor then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and ch.codigo_vend in ' + CodVendedor + ' order by ch.codigo_ch'
    else
      buscas1.SQL.Text := buscas1.SQL.Text + ' order by ch.codigo_ch,ch.codigo_vend';

    buscas1.Params.ParamByName('dti').AsDate := datainicial;
    buscas1.Params.ParamByName('dtf').AsDate := datafinal;
    buscas1.Open;

    //Recebimentos crédito
    vTemp := '';
    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') then
      vTemp := ' or bc.tip_baixa = ''A''';
    buscas2.Close;
    buscas2.SQL.Text := 'select bc.*,c.nome_ctrl from baixa_creditos bc ' +
      ' left join controles c on bc.codigo_ctrl = c.codigo_ctrl and bc.codigo_emp = c.codigo_emp ' +
      ' where bc.dt_baixa_comissao >= :dti and bc.dt_baixa_comissao <= :dtf ' +
      ' and (bc.tip_baixa = '''' or bc.tip_baixa is null' + vTemp + ') ' +
      ' and bc.codigo_emp = ' + vDadosIni.codEmpresa;

    if vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S' then
      buscas2.SQL.Text := buscas2.SQL.Text + ' and coalesce(bc.vl_baixa_comissao,0) > 0';

    if (FiltrarControle) then
     	buscas2.SQL.Text := buscas2.SQL.Text + ' and bc.codigo_ctrl = ' + Controle;

    if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional = 'S') and (FiltrarVendedor) and (vGerente) then
      buscas2.SQL.Text := buscas2.SQL.Text + ' and bc.codigo_vend in ' + vCodColabGer + ' order by bc.cod_cred'
    else if FiltrarVendedor then
      buscas2.SQL.Text := buscas2.SQL.Text + ' and bc.codigo_vend in ' + CodVendedor + ' order by bc.cod_cred'
    else
      buscas2.SQL.Text := buscas2.SQL.Text + ' order by bc.cod_cred,bc.codigo_vend';

    buscas2.Params.ParamByName('dti').AsDate := datainicial;
    buscas2.Params.ParamByName('dtf').AsDate := datafinal;
    buscas2.Open;
    Result := (not buscas.IsEmpty) or (not buscas1.IsEmpty) or (not buscas2.IsEmpty);
//    if not (buscas.IsEmpty and buscas1.IsEmpty and buscas2.IsEmpty) then
//      result := true;
  except
  end;
end;

procedure TRelatorioComissaoProdRecebimento.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO DE COMISSAO POR RECEBIMENTOS', [normal, negrito]);
  linha := linha + 1;
  if FiltrarVendedor then
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + trim(Vendedor), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + 'TODOS', [normal, negrito]);
  linha := linha + 1;
  if FiltrarControle then
    Rdp.ImpF(linha, 1, 'CONTROLE: ' + trim(dtSetControles.FieldByName('nome_ctrl').AsString), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'CONTROLE: ' + 'TODOS', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  vpag := vpag + 1;
  if FiltrarVendedor then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, Copy('VENDEDOR: ' + trim(Vendedor), 1, 78), [normal, negrito]);
  end
  else
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + 'TODOS', [normal, negrito]);
  end;
  Rdp.ImpF(linha, 80, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 160), [comp17]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'CLIENTE', [comp17]);
//  Rdp.ImpF(linha, 036, 'TERCEIRO(CHQ)', [comp17]);
  if (vDadosIni.vEmp.vUsarComissaoPorRecebimentoProporcional <> 'S') then
  begin
    Rdp.ImpF(linha, 36, 'TERCEIRO(CHQ)', [comp17]);
    Rdp.ImpF(linha, 66, 'CONTROLE', [comp17]);
    Rdp.ImpF(linha, 85, 'HISTORICO', [comp17]);
    Rdp.ImpD(linha, 126, 'VALOR', [comp17]);
    Rdp.ImpD(linha, 138, 'DATA MOV', [comp17]);
    Rdp.ImpD(linha, 149, 'DATA VENC', [comp17]);
    Rdp.ImpD(linha, 160, 'DATA QUIT', [comp17]);
  end
  else
  begin
    Rdp.ImpF(linha, 036, 'CONTROLE', [comp17]);
    Rdp.ImpF(linha, 055, 'NUM DOC', [comp17]);
    Rdp.ImpF(linha, 065, 'TIPO', [comp17]);
    Rdp.ImpF(linha, 074, 'NUM', [comp17]);
    Rdp.ImpF(linha, 083, 'VLR DOC', [comp17]);
    Rdp.ImpF(linha, 091, 'COMISSAO', [comp17]);
    Rdp.ImpF(linha, 103, 'DATA MOV', [comp17]);
    Rdp.ImpF(linha, 113, 'DATA VENC', [comp17]);
    Rdp.ImpF(linha, 124, 'DATA QUIT', [comp17]);
    Rdp.ImpF(linha, 135, 'OBS', [comp17]);
  end;
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 160), [comp17]);
  linha := linha + 1;
end;

constructor TRelatorioComissaoProdRecebimento.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrBuscas1);
  buscas2 := TIBQuery(dtmRelatorios.qrBuscas2);
  buscas3 := TIBQuery(dtmRelatorios.qrbuscas3);
end;

procedure TRelatorioComissaoProdRecebimento.ImprimeRelatorios;
var
  vrecimed, vrecchq, vreccred: currency;
  vLista: TStringList;
  vCountRecursivo: Integer;

  procedure verificaPrestacaoRecursiva(pPrestacao: Integer);
  var
    vQuery: TIBQuery;
    I: Integer;
    vTem: Boolean;
  begin

    if vCountRecursivo >= 20 then
      Exit;

    vCountRecursivo := vCountRecursivo + 1;

    vQuery := TIBQuery.Create(Application);
    vQuery.Database := buscas.Database;
    vQuery.Transaction := buscas.Transaction;

    vQuery.Close;
    vQuery.SQL.Text := 'select cc.tp_doc_v, cc.n_doc_v from controle_creditos cc' +
      ' where cc.codigo_emp = ' + vDadosIni.codEmpresa+
      ' and cc.lote_cxl = ' + IntToStr(pPrestacao);
    vQuery.Open;

    vQuery.First;
    while not vQuery.Eof do
    begin
      if Trim(vQuery.FieldByName('tp_doc_v').AsString) = 'PRE' then
        verificaPrestacaoRecursiva(vQuery.FieldByName('n_doc_v').AsInteger)
      else
      begin
        vTem := False;
        for I := 0 to vLista.Count - 1 do
          if (Trim(vQuery.FieldByName('tp_doc_v').AsString) + ' - ' + Trim(vQuery.FieldByName('n_doc_v').AsString)) = vLista[I] then
          begin
            vTem :=  True;
            Break;
          end;
        if not vTem then
          vLista.Add(Trim(vQuery.FieldByName('tp_doc_v').AsString) + ' - ' + Trim(vQuery.FieldByName('n_doc_v').AsString));
      end;
      vQuery.Next;
    end;
  end;

  procedure verificaPrestacoes(pPrestacao: Integer);
  var
    I: Integer;
  begin

    vLista := TStringList.Create;
    vLista.Clear;

    vCountRecursivo := 0;

    verificaPrestacaoRecursiva(pPrestacao);

    if vLista.Count > 0 then

    for I := 0 to vLista.Count - 1 do
    begin
      Rdp.Imp( linha, 135, vLista[i]);
      if I <> (vLista.Count - 1) then
        linha := linha + 1;

      if linha >= 60 then
      begin
        linha := 1;
        CabNovaPagina;
      end;
    end;
  end;

begin
  if not vDadosIni.PesqPros('REL013', 'IMPRIMIR', '', '',
