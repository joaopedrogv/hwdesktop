procedure TRelatorioPagamentosFinanceiro.ImprimirControles(totGeral: boolean);
var
 vValorTotTemp, vValorTotTempRec, vValorTotGTemp, vValorTotRTemp, vValorTotRNaoGeraFinancTemp: Double;
 vValorTemp: Double;
 vPercTemp: Double;
 vPerc: Double;
begin
	if trim(ExibirTotatis) <> 'SIM' then
  begin
  	if not totGeral then
    begin
      linha := linha + 1;
      Rdp.ImpF(linha,1, vDadosIni.Replicate('=',133),[comp17]);
    end;
    exit;
  end;

  vValorTotTemp := 0;
  vValorTotTempRec := 0;
  vValorTemp := 0;
  vPercTemp := 0;

  ChecarFimdePagina;

  if totGeral then
  begin
    fTempRecTot.Filtered := False;
    fTempRecTot.IndexFieldNames := 'CONTROLE;';
    fTempRecTot.Filter := 'DOCS = ''N'' ';
    fTempRecTot.Filtered := true;
  end
  else
  begin
    if trim(vTipoRec) = 'PAGAMENTOS' then
    begin
       ftempOrigemRec.Filtered := False;
    	 ftempOrigemRec.IndexFieldNames := 'CONTROLE;';

       if (not totGeral) and (linha + ftempOrigemRec.RecordCount + 2 >= 60) then
       begin
         linha := 2;
         CabNovaPagina;
       end
       else if (not totGeral) then
         linha := linha + 1;
         
       Rdp.ImpF(linha, 1, 'ORIGEM CONTAS PAGAR', [comp17, negrito]);
       Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
		   Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
  		 Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);

       ftempOrigemRec.First;
       while not ftempOrigemRec.Eof do
       begin
         if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
         	 vValorTotTempRec := vValorTotTempRec + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
         	 vValorTotTempRec := vValorTotTempRec + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else
	         vValorTotTemp := vValorTotTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;
         ftempOrigemRec.Next;
       end;

       vValorTotGTemp := 0;
       ftempOrigemRec.First;
       while not ftempOrigemRec.Eof do
       begin
         vPerc := 0;
         if ftempOrigemRec.FieldByName('VALOR').AsCurrency <= 0 then
           vValorTemp := vValorTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency
         else
         begin
           if fTempRecTot.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
             vValorTemp := vValorTemp + 0
           else if fTempRecTot.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
             vValorTemp := vValorTemp + 0
           else
             vValorTemp := vValorTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;
         end;

         if (vValorTotTemp + vValorTotTempRec = 0) then
           vPerc := 0
         else if ftempOrigemRec.FieldByName('VALOR').AsCurrency <= 0 then
           vPerc := (ftempOrigemRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
         else if ftempOrigemRec.FieldByName('VALOR').AsCurrency > 0 then
           vPerc := (ftempOrigemRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
         vPercTemp := vPercTemp + vPerc;

         if (trim(ftempOrigemRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
         begin
         	 linha := linha + 1;
	         Rdp.Imp(linha, 21, ftempOrigemRec.FieldByName('CONTROLE').asstring);
  	       Rdp.ImpD(linha, 71, Format('%n', [ftempOrigemRec.FieldByName('VALOR').AsCurrency]), [comp17]);
    	     Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

        	 ChecarFimdePagina;
         end;

         vValorTotGTemp := vValorTotGTemp + ftempOrigemRec.FieldByName('VALOR').AsCurrency;

         ftempOrigemRec.Next;
       end;

       linha := linha + 1;
       Rdp.ImpD(linha, 71, Format('%n', [vValorTemp]), [comp17, negrito]);
		   Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);
       linha := linha + 1;
       Rdp.Imp(linha, 1, '-------------------------');
       
       
       vValorTotTemp := 0;
       vValorTotTempRec := 0;
 		   vValorTemp := 0;
		   vPercTemp := 0;
    end;

    fTempRec.Filter := 'TIPO = ''P'' ';
    fTempRec.Filtered := True;
    fTempRec.IndexFieldNames := 'CONTROLE;';
  end;

  if (not totGeral) and (linha + fTempRec.RecordCount + 2 >= 60) then
  begin
    linha := 2;
    CabNovaPagina;
  end
  else if (not totGeral) then
	  linha := linha + 1;

  if not totGeral then
  begin
  	Rdp.ImpF(linha, 1, 'TOTAL CONTAS PAGAR', [comp17, negrito]);

	  Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
	  Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
	  Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);
  end;

  if not totGeral then
  begin
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else
	      vValorTotTemp := vValorTotTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      fTempRec.Next;
    end;

    vValorTotGTemp              := 0;
    vValorTotRTemp              := 0;
    vValorTotRNaoGeraFinancTemp := 0;
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      vPerc := 0;
    	if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
        vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency
      else
      begin
        if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
          vValorTemp := vValorTemp + 0
        else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
          vValorTemp := vValorTemp + 0
        else
          vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      end;

      if (vValorTotTemp + vValorTotTempRec = 0) then
        vPerc := 0
      else if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
        vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
      else if fTempRec.FieldByName('VALOR').AsCurrency > 0 then
        vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
      vPercTemp := vPercTemp + vPerc;

      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
      begin
      	linha := linha + 1;
        if trim(fTempRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
          Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
        else
        	Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring);
        Rdp.ImpD(linha, 71, Format('%n', [fTempRec.FieldByName('VALOR').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

        ChecarFimdePagina;
      end;

      vValorTotGTemp := vValorTotGTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
        and (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
		      vValorTotRTemp := vValorTotRTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      if (trim(fTempRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S') then
      	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      fTempRec.Next;
    end;
  end;
  if not totGeral then
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha, 21, 'TOTAL PAGAMENTO......: ' + Format('%n', [vValorTotRTemp]), [comp17, negrito]);
	  Rdp.ImpD(linha, 71, Format('%n', [vValorTemp]), [comp17, negrito]);
	  Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);

    if not totGeral then
    begin
    	linha := linha + 1;
    	Rdp.ImpF(linha, 21, 'TOTAL GERA FINANCEIRO: ' + Format('%n', [vValorTotRTemp - vValorTotRNaoGeraFinancTemp]), [comp17, negrito]);
    end;
    
    linha := linha + 1;

  	ImprimirTotalPagina(totGeral);
  end;

  if not totGeral then
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha,1, vDadosIni.Replicate('=',133),[comp17]);
  end;
end;

procedure TRelatorioPagamentosFinanceiro.ImprimirTotalDiario;
begin
	linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TOTAL ' + vDiaMov, [comp17, negrito]);
  Rdp.ImpF(linha, 21, 'TOTAL CONTAS PAGAR:', [comp17, negrito]);
  Rdp.ImpD(linha, 58, Format('%n', [vValorTotDia]), [comp17, negrito]);
  Rdp.ImpF(linha, 77, 'TOTAL PAGAMENTO:', [comp17, negrito]);
  Rdp.ImpD(linha, 115, Format('%n', [vValorRecDia]), [comp17, negrito]);

  vValorTotDia := 0;
  vValorRecDia := 0;

  linha := linha + 1;
  ChecarFimdePagina;
end;

procedure TRelatorioPagamentosFinanceiro.ImprimirTotalDocumento;
begin
	if (trim(TipoRelatorio) = 'ANALÍTICO')
	  and (trim(ExibirDetalhesRec) = 'SIM') then
  begin
    Rdp.Imp(linha, 21, '|');
    Rdp.ImpD(linha, 71, Format('%f', [vTotValorPagoLote]), [comp17, negrito]);

    if (trim(buscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS') and ((FiltrarCliente) or (FiltrarOrigControle)) then
    begin
			if vTotValorPagoLoteOrig <> vTotValorPagoLote then
        Rdp.ImpD(linha, 133, '* ' + Format('%f', [vTotValorPagoLoteOrig]), [comp17, negrito]);
      vTotValorPagoLoteOrig := 0;
    end
    else if (trim(buscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS')
    	and (vDadosIni.vEmp.vFinanceiroUnificado)
      and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
    begin
      if vTotValorPagoLoteOrig <> vTotValorPagoLote then
        Rdp.ImpD(linha, 133, '* ' + Format('%f', [vTotValorPagoLoteOrig]), [comp17, negrito]);
      vTotValorPagoLoteOrig := 0;
    end;

    linha := linha + 1;
    Rdp.ImpF(linha, 21, vDadosIni.replicate('-', 113), [comp17, negrito]);
    linha := linha + 1;

    vValorTotDoc := 0;
  end;
end;

procedure TRelatorioPagamentosFinanceiro.ImprimirTotalPagina(
  totaltipo: boolean);
begin
	linha := linha + 1;
  if (linha >= 58) then
    if totaltipo then
      Rdp.ImpF(linha, 1, 'TOTAL GERAL', [comp17, negrito]);

  Rdp.ImpF(linha, 21, 'TOTAL CONTAS PAGAR:', [comp17, negrito]);
  if totaltipo then
  	Rdp.ImpD(linha, 58, Format('%n', [vValorTotRel]), [comp17, negrito])
	else
  begin
	  Rdp.ImpD(linha, 58, Format('%n', [vValorTotPag]), [comp17, negrito]);
    vValorTotPag := 0;
  end;
  Rdp.ImpF(linha, 77, 'TOTAL PAGAMENTO:', [comp17, negrito]);
  if totaltipo then
  	Rdp.ImpD(linha, 115, Format('%n', [vValorRecRel]), [comp17, negrito])
  else
  begin
	  Rdp.ImpD(linha, 115, Format('%n', [vValorRecPag]), [comp17, negrito]);
    vValorRecPag := 0;
  end;
end;

