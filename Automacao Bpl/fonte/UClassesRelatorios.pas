procedure TRelatorioListaDeAlteracaoDePreco.ImprimeRelatorios;
var
  vsubg: integer;
  vsql: string;
begin

  if not vDadosIni.PesqPros('REL020', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  abreProdutosAterados;//if not abreProdutosAterados then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S10cpp;
  Rdp.TamanhoQteColunas := 80;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  if pos('ENTRADA', LitadeAltPrecos) > 0 then
  begin
    rdp.OpcoesPreview.CaptionPreview := 'Relatório de Preço por Entrada';
    rdp.TitulodoRelatorio := 'Relatorio Preço por Entrada';
  end
  else
  begin
    rdp.OpcoesPreview.CaptionPreview := 'Relatório de Preço por Alteração';
    rdp.TitulodoRelatorio := 'Relatorio Preço por Alteração';
  end;
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho
  vsubg := buscas.FieldByName('SUB_G_PROD').AsInteger;
  Rdp.impf(linha, 1, vDadosIni.strzero(buscas.FieldByName('SUB_G_PROD').AsInteger, 2) + '  ' + buscas.FieldByName('DESCRICAO').AsString, [negrito]);
  linha := linha + 1;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
    if buscas.FieldByName('SUB_G_PROD').AsInteger <> vsubg then
    begin
      //      linha := 1;
      //      CabNovaPagina;
      linha := linha + 1;
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', 80));
      linha := linha + 1;
      Rdp.impf(linha, 1, vDadosIni.strzero(buscas.FieldByName('SUB_G_PROD').AsInteger, 2) + '  ' + buscas.FieldByName('DESCRICAO').AsString, [negrito]);
      linha := linha + 1;
      vsubg := buscas.FieldByName('SUB_G_PROD').AsInteger;
    end;
    Rdp.imp(linha, 1, vDadosIni.strzero(buscas.FieldByName('GRUPO_PROD').AsInteger, 3) + ' ' + buscas.FieldByName('COD_PROD').AsString);
    Rdp.imp(linha, 12, copy(buscas.FieldByName('DESCR_PROD').AsString, 1, 40));
    Rdp.imp(linha, 54, buscas.FieldByName('EMB_PROD').AsString);
    Rdp.impD(linha, 80, format('%n', [buscas.FieldByName('PREC_TAB_PROD').AsFloat]), []);
    linha := linha + 1;
    if linha >= 60 then
      CabNovaPagina;
    buscas.next;
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;
  vDadosIni.GravaAuditoria('REL020', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.close;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatoriosdeVendasPlacaCliente }

function TRelatoriosdeVendasPlacaCliente.abreVendasPlacaCliente: Boolean;
var
  vSqlTipoOS_ORC: string;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      FExibirDavORC := true;
      Result := False;
      //Entrada de notas emitidas por período
      buscas.Close;
      buscas.SQL.Text := 'select v.tipo, v.nped, vp.nitem, ''P'' as prodserv, v.data_ped, ' +
        ' v.data_fech, cl.cod_cliente, cl.nome_cliente, v.status_ped, v.placa, v.valor_total, v.km_v, ' +
        ' vp.descr_prod_ped as descrIt, vp.quant_ped_item as qtdItem, vp.vlun_ped_item as vluItem, ' +
        ' vp.tipooriginado, vp.npedoriginado ' +
        ' from pedvenda v inner join pedvenda_prod vp on v.nped = vp.nped and v.tipo=vp.tipo and ' +
        ' v.cod_empresa = vp.cod_empresa inner join clientes cl ' +
        ' on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
        ' where (vp.status<>''CANCELADO'' or vp.status is null) ' +
        ' and v.cod_empresa = ' + vDadosIni.codEmpresa;
      if ExibirVendaREQ and ExibirVendaOS and FExibirDavORC then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''REQ'') or (v.tipo=''OS'' and v.placa=' + quotedstr(Placa) + ') or (v.tipo=''ORC'' and v.placa=' + quotedstr(Placa) + '))'
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'') or (v.tipo=''REQ'') or ((v.tipo=''ORC'')and (v.ORCPARAVND=''S'')) ) ';
        vSqlTipoOS_ORC := ' and ( (v.tipo=''OS'') or ((v.tipo=''ORC'') and (v.ORCPARAVND=''S'')) ) ';
      end
      else if ExibirVendaREQ and ExibirVendaOS then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''REQ'') or (v.tipo=''OS'' and v.placa=' + quotedstr(Placa) + '))'
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'') or (v.tipo=''REQ'')) ';
        vSqlTipoOS_ORC := ' and v.tipo=''OS'' ';
      end
      else if ExibirVendaREQ and FExibirDavORC then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''REQ'') or (v.tipo=''ORC'' and v.placa=' + quotedstr(Placa) + '))'
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''REQ'') or ((v.tipo=''ORC'')and (v.ORCPARAVND=''S'')) ) ';
        vSqlTipoOS_ORC := ' and ((v.tipo=''ORC'')and (v.ORCPARAVND=''S'')) ';
      end
      else if ExibirVendaOS and FExibirDavORC then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'' and v.placa=' + quotedstr(Placa) + ') or ((v.tipo=''ORC'') and (v.ORCPARAVND=''S'') and v.placa=' + quotedstr(Placa) + '))'
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'') or ((v.tipo=''ORC'')and (v.ORCPARAVND=''S'')) ) ';
        vSqlTipoOS_ORC := ' and ((v.tipo=''OS'') or ((v.tipo=''ORC'')and (v.ORCPARAVND=''S'')) ) ';
      end
      else if ExibirVendaREQ then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo=''REQ'' '
      else if ExibirVendaOS then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'' and v.placa=' + quotedstr(Placa) + ')) '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo=''OS'' ';
        vSqlTipoOS_ORC := ' and v.tipo=''OS'' ';
      end
      else if FExibirDavORC then
      begin
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.tipo=''ORC'' and v.ORCPARAVND=''S'' and v.placa=' + quotedstr(Placa) + ') '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.tipo=''ORC'' and v.ORCPARAVND=''S'')';
        vSqlTipoOS_ORC := ' and (v.tipo=''ORC'' and v.ORCPARAVND=''S'')';
      end;

      if FiltrarCliente then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
      if FiltrarData then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
      if StatusPed = 'ABERTA' then
        buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(v.status_ped, '''')<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
      else if StatusPed = 'FECHADA' then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
      else
        buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

      if ExibirVendaOS or FExibirDavORC then
      begin
        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo, v.nped, 1 as nitem, ''PT'' as prodserv, v.data_ped, v.data_fech, ' +
          ' cl.cod_cliente, cl.nome_cliente, v.status_ped, v.placa, v.valor_total, v.km_v, ' +
          ' vpt.descricao as descrIt, vpt.qtde as qtdItem, vpt.vl_unit as vluItem, ' +
          ' vpt.tipooriginado, vpt.npedoriginado ' +
          ' from pedvenda v inner join pedvenda_prod_terc vpt on v.nped = vpt.nped and v.tipo=vpt.tipo ' +
          ' and v.cod_empresa = vpt.cod_empresa inner join clientes cl ' +
          ' on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
          ' where v.cod_empresa = ' + vDadosIni.codEmpresa + vSqlTipoOS_ORC;
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.placa=' + quotedstr(Placa);
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo,v.nped,vs.nitem,''S''  as prodserv,  v.data_ped,v.data_fech, ' +
          ' cl.cod_cliente, cl.nome_cliente, v.status_ped,v.placa, v.valor_total, v.km_v, ' +
          ' vs.desc_serv_ped as descrIt, vs.quant_serv_ped as qtdItem, vs.valor_un_serv as vluItem, ' +
          ' vs.tipooriginado, vs.npedoriginado ' +
          ' from pedvenda v inner join pedvenda_serv vs on v.nped = vs.nped and v.tipo=vs.tipo ' +
          ' and v.cod_empresa = vs.cod_empresa inner join clientes cl on v.cod_cliente = cl.cod_cliente ' +
          ' and v.cod_empresa = cl.cod_empresa ' +
          ' where (vs.status<>''CANCELADO'' or vs.status is null) ' +
          ' and v.cod_empresa = ' + vDadosIni.codEmpresa + vSqlTipoOS_ORC;
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.placa=' + quotedstr(Placa);
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and  coalesce(v.status_ped, '''')<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo,v.nped,1 as nitem, ''ST''  as prodserv,  v.data_ped, v.data_fech, ' +
          ' cl.cod_cliente, cl.nome_cliente, v.status_ped,v.placa, v.valor_total, v.km_v, ' +
          ' vst.descr_servt as descrIt, 1 as qtdItem, vst.vl_servt as vluItem, ' +
          ' vst.tipooriginado, vst.npedoriginado' +
          ' from pedvenda v inner join pedvenda_serv_terc vst ' +
          ' on v.nped = vst.nped and v.tipo=vst.tipo and v.cod_empresa = vst.cod_empresa ' +
          ' inner join clientes cl on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
          ' where v.cod_empresa = ' + vDadosIni.codEmpresa + vSqlTipoOS_ORC;
        if FiltrarPlaca then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.placa=' + quotedstr(Placa);
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and  coalesce(v.status_ped, '''')<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';
      end;
      if FiltrarData then
      begin
        buscas.Params.ParamByName('dti').AsDate := datainicial;
        buscas.Params.ParamByName('dtf').AsDate := datafinal;
      end;
      buscas.Open;
      if not (buscas.IsEmpty) then
        result := true;
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

procedure TRelatoriosdeVendasPlacaCliente.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;
  Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vnomeEmpresa), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'Relatório de Produtos e Serviços por Placa / Cliente', [normal, negrito]);
  linha := linha + 1;
  if FiltrarData then
    Rdp.ImpF(linha, 1, 'No período de: ' + datetostr(datainicial) + ' A ' + datetostr(datafinal), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'No período de:   /  /     A    /  /    ', [normal, negrito]);
  linha := linha + 1;

  if StatusPed = 'ABERTA' then
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Aberto', [normal, negrito])
  else if StatusPed = 'FECHADA' then
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Fechado', [normal, negrito])
  else
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Ambos (Aberto / Fechado)', [normal, negrito]);

  linha := linha + 1;
  if FiltrarCliente then
  begin
    Rdp.ImpF(linha, 1, 'Cliente: ' + trim(dtSetCliente.FieldByName('NOME_CLIENTE').AsString), [normal, negrito]);
    linha := linha + 2;
  end;
  vpag := vpag + 1;
  Rdp.ImpF(linha, 1, 'Data/Hora: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  Rdp.ImpF(linha, 100, 'Pag: ' + vDadosIni.strzero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.Imp(linha, 2, 'Nº Venda');
  Rdp.Imp(linha, 23, 'Data');
  Rdp.Imp(linha, 35, 'Placa / Cliente');
  Rdp.Imp(linha, 98, 'Status');
  Rdp.ImpD(linha, 115, 'Km', []);
  Rdp.ImpD(linha, 132, 'Data Fechamento', []);
  linha := linha + 1;
  Rdp.Imp(linha, 35, 'Produto / Serviço');
  Rdp.Imp(linha, 92, 'Qtde');
  Rdp.Imp(linha, 105, 'Valor Unit');
  Rdp.ImpD(linha, 132, 'Valor Total Item', []);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
end;

constructor TRelatoriosdeVendasPlacaCliente.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  if vDadosIni.vVerORCConvertidoVND = 'S' then
  begin
    FExibirDavORC := true;
    ExibirVendaOS := false;
  end
  else
  begin
    FExibirDavORC := false;
    FExibirVendaOS := true;
  end;

  FExibirVendaREQ := false;
  FFiltrarPlaca := false;
  FFiltrarData := true;
end;

//Relatório de vendas por Placa/Cliente  ---tbsRelatoriosdeVendasPlacaCliente

procedure TRelatoriosdeVendasPlacaCliente.ImprimeRelatorios;
var
  condicao: boolean;
  totBruto, totLiq, totDesc, qtdeItens, valorItens, qtdeTotal, valorTotal, vrtot: currency;
  sqlComandos: TStringList;
  ndoc, tpImp: integer;
begin

  if not vDadosIni.PesqPros('REL022', 'IMPRIMIR', '', '', '', buscas, false) then
    Exit;
  inherited;

  if (not ExibirVendaREQ) and (not ExibirVendaOS) and (not FExibirDavORC) then
  begin
    Application.MessageBox('Selecione pelo menos um tipo de relatório. Venda Requisição ou Venda Ordem de Serviço', 'Informação', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  abreVendasPlacaCliente;//if not abreVendasPlacaCliente then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de Produtos e Serviços por Placa / Cliente';
  rdp.TitulodoRelatorio := 'Relatório de Produtos e Serviços por Placa ou Cliente';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho

  totBruto := 0;
  totLiq := 0;
  totDesc := 0;
  qtdeTotal := 0;
  valorTotal := 0;
  tpImp := -1;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  while not buscas.Eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;

    qtdeItens := 0;
    valorItens := 0;
    vrtot := 0;
    ndoc := buscas.FieldByName('NPED').AsInteger;
    Rdp.impD(linha, 11, buscas.FieldByName('TIPO').Asstring + ' ' + vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6), []);
    if (trim(buscas.FieldByName('TIPO').AsString) = 'ORC') and (trim(buscas.FieldByName('TIPOORIGINADO').Asstring) <> '') then
      Rdp.impD(linha, 22, '>' + trim(buscas.FieldByName('TIPOORIGINADO').Asstring) + vDadosIni.StrZero(buscas.FieldByName('NPEDORIGINADO').AsInteger, 6), []);

    Rdp.imp(linha, 23, buscas.FieldByName('DATA_PED').AsString);
    Rdp.imp(linha, 35, trim(buscas.FieldByName('PLACA').AsString) + ' / ' + vDadosIni.StrZero(buscas.FieldByName('COD_CLIENTE').asInteger, 6) + '  ' + trim(buscas.FieldByName('NOME_CLIENTE').AsString));
    Rdp.imp(linha, 98, trim(buscas.FieldByName('STATUS_PED').AsString));
    Rdp.impD(linha, 115, IntToStr(buscas.FieldByName('KM_V').AsInteger), []);
    Rdp.impD(linha, 132, buscas.FieldByName('DATA_FECH').AsString, []);
    while ndoc = buscas.FieldByName('NPED').AsInteger do
    begin
      linha := linha + 1;
      if linha > 63 then
      begin
        Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
        CabNovaPagina;
        Rdp.impD(linha, 11, buscas.FieldByName('TIPO').Asstring + ' ' + vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6), []);
        if (trim(buscas.FieldByName('TIPO').AsString) = 'ORC') and (trim(buscas.FieldByName('TIPOORIGINADO').Asstring) <> '') then
          Rdp.impD(linha, 22, '>' + trim(buscas.FieldByName('TIPOORIGINADO').Asstring) + vDadosIni.StrZero(buscas.FieldByName('NPEDORIGINADO').AsInteger, 6), []);
        Rdp.imp(linha, 23, buscas.FieldByName('DATA_PED').AsString);
        Rdp.imp(linha, 40, vDadosIni.StrZero(buscas.FieldByName('COD_CLIENTE').asInteger, 6) + '  ' + trim(buscas.FieldByName('NOME_CLIENTE').AsString));
        Rdp.imp(linha, 98, trim(buscas.FieldByName('STATUS_PED').AsString));
        Rdp.impD(linha, 115, IntToStr(buscas.FieldByName('KM_V').AsInteger), []);
        Rdp.impD(linha, 132, buscas.FieldByName('DATA_FECH').AsString, []);
        linha := linha + 1;
      end;
      Rdp.imp(linha, 35, trim(buscas.FieldByName('prodserv').AsString));
      Rdp.imp(linha, 37, '-');
      Rdp.imp(linha, 39, Copy(trim(buscas.FieldByName('descrIt').AsString), 1, 51));
      Rdp.impD(linha, 96, Format('%n', [buscas.FieldByName('qtdItem').AsFloat]), []);
      Rdp.impD(linha, 115, format('%f', [buscas.FieldByName('vluItem').AsFloat]), []);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('vluItem').AsFloat * buscas.FieldByName('qtdItem').AsFloat]), []);
      qtdeItens := qtdeItens + buscas.FieldByName('qtdItem').AsFloat;
      valorItens := valorItens + (buscas.FieldByName('vluItem').AsFloat);
      vrtot := vrtot + (buscas.FieldByName('qtdItem').AsFloat * buscas.FieldByName('vluItem').AsFloat);
      buscas.Next;
      frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
      if buscas.Eof then
        Break;
    end;
    qtdeTotal := qtdeTotal + qtdeItens;
    valorTotal := valorTotal + vrtot;
    linha := linha + 1;
    Rdp.impD(linha, 96, Format('%n', [qtdeItens]), [Negrito]);
    Rdp.impD(linha, 132, format('%m', [vrtot]), [Negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 132), [comp17]);
    linha := linha + 1;
    if linha > 63 then
    begin
      Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
      CabNovaPagina;
    end;
  end;
  if linha + 5 > 63 then
  begin
    Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    CabNovaPagina;
  end;

  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.impf(linha, 1, 'Total..............................:', [Negrito]);
  Rdp.impD(linha, 96, Format('%n', [qtdeTotal]), [Negrito]);
  Rdp.impD(linha, 132, format('%m', [valorTotal]), [Negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  vDadosIni.GravaAuditoria('REL022', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
  buscas.close;

  if Rdp.EstaAberto then
    Rdp.Fechar;
  frmRelatorios.ProgressBar.Position := 0;
end;

