procedure TRelatorioVendasPorVendedorAcrescCondPagVend.ImprimirReceb(
  pNped: Integer; pTipoNped: string; pIncItensProd, pIncItensServ,
  pQtdeItensProd, pQtdeItensServ: Double; pBuscasFP: TIBQuery);
var
	vTotRec: Double;
begin
	if (TipoRelatorio = 'ANALÍTICO') and (ListarProdutos = 'SIM') and (RecebimentoVenda = 'SIM') then
  begin
    if (trim(pTipoNped) = 'REQ') or (trim(pTipoNped) = 'OS') then
    begin
    	if (TotalVenda <> 'SIM') then
        if (pIncItensProd + pIncItensServ <> pQtdeItensProd + pQtdeItensServ) then
          Rdp.ImpD(linha - 1, 135, '*', [comp17, negrito]);

      Rdp.ImpF(linha, 21, vDadosIni.replicate('-', Rdp.TamanhoQteColunas - 21), [comp17, negrito]);
      linha := linha + 1;
      Rdp.Imp(linha, 21, '|TP RECEB');
      Rdp.Imp(linha, 37, 'CTRL');
      Rdp.Imp(linha, 53, 'N.DOC');
      Rdp.Imp(linha, 65, 'VL DOC');
      Rdp.Imp(linha, 77, 'N.PROC');
      Rdp.Imp(linha, 89, 'DATA VEN');
      Rdp.Imp(linha, 105, 'N.DATA MOV');
      linha := linha + 1;
      Rdp.Imp(linha, 21, '|');
      linha := linha + 1;

      vTotRec := 0;

      pBuscasFP.Close;
      pBuscasFP.SQL.Text := ' select ''DIRETO'' tp_recebimento, ''DIRETO'' tp_recebimento2, ' +
        ' fp.cod_controle, ctr.nome_ctrl, ' +
        ' fp.ndoc as num_doc2, fp.historico, ' +
        ' fp.data_mov, fp.data_venc, fp.valordoc as valor_pago from formpagamento fp ' +
        ' left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and fp.cod_empresa = ctr.codigo_emp ' +
        ' where fp.nrequisicao = :num_doc ' +
        ' and fp.tpdocs = :tipo ' +
        ' and fp.cod_empresa = :cod_emp_mult ' +
        ' and fp.recibo is null ' +
        ' union all ' +
        ' select ''RECIBO'' tp_recebimento, ''RECIBO'' tp_recebimento2, ' +
        ' case when (select first 1 ctrl.nome_ctrl from controles ctrl ' +
        '            inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctrl and rc.cod_empresa = ctrl.codigo_emp ' +
        '            where rc.rec_numvend = fp.rec_numvend ' +
        '            and rc.cod_empresa = fp.cod_empresa ' +
        '            and rc.rec_tipvend = ''REC'' ' +
        '						 order by rc.valordoc asc) is null then ' +
        '        0 ' +
        '      else ' +
        '           (select first 1 ctrl.codigo_ctrl from controles ctrl ' +
        '            inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctrl and rc.cod_empresa = ctrl.codigo_emp ' +
        '            where rc.rec_numvend = fp.rec_numvend ' +
        '            and rc.cod_empresa = fp.cod_empresa ' +
        ' 					 and rc.rec_tipvend = ''REC'' ' +
        '						 order by rc.valordoc asc) ' +
        ' end as codigo_ctrl, ' +
        ' case when (select first 1 ctrl.nome_ctrl from controles ctrl ' +
        '            inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctrl and rc.cod_empresa = ctrl.codigo_emp ' +
        '            where rc.rec_numvend = fp.rec_numvend ' +
        '						 and rc.cod_empresa = fp.cod_empresa ' +
        '						 and rc.rec_tipvend = ''REC'' ' +
        '						 order by rc.valordoc asc) is null then ' +
        '        ''SEM FORMA'' ' +
        '      else ' +
        '        (select first 1 ctrl.nome_ctrl from controles ctrl ' +
        '         inner join formpagamento rc on rc.cod_controle = ctrl.codigo_ctrl and rc.cod_empresa = ctrl.codigo_emp ' +
        '         where rc.rec_numvend = fp.rec_numvend ' +
        '					and rc.cod_empresa = fp.cod_empresa ' +
        '					and rc.rec_tipvend = ''REC'' ' +
        '					order by rc.valordoc asc) ' +
        ' end as nome_ctrl, ' +
        ' fp.ndoc as num_doc2, fp.historico, ' +
        ' fp.data_mov, fp.data_venc, fp.valordoc as valor_pago from formpagamento fp ' +
        ' left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and fp.cod_empresa = ctr.codigo_emp ' +
        ' where fp.nrequisicao = :num_doc ' +
        ' and fp.tpdocs = :tipo ' +
        ' and fp.cod_empresa = :cod_emp_mult ' +
        ' and (not fp.recibo is null) ' +
        ' union all ' +
        ' select ''TROCO'' tp_recebimento, ''TROCO'' tp_recebimento2, ' +
        ' case when ctr.nome_ctrl is null then 0 else ctr.codigo_ctrl end codigo_ctrl, ' +
        ' case when ctr.nome_ctrl is null then ''SEM FORMA'' else ctr.nome_ctrl end nome_ctrl, ' +
        ' fp.ndoc as num_doc2, fp.historico, ' +
        ' fp.data_mov, fp.data_venc, fp.valordoc as valor_pago  from formpagamento fp ' +
        ' left join CONTROLES ctr on fp.cod_controle = ctr.codigo_ctrl and fp.cod_empresa = ctr.codigo_emp ' +
        ' where fp.rec_numvend = :num_doc ' +
        ' and fp.rec_tipvend = :tipo ' +
        ' and fp.cod_empresa = :cod_emp_mult ' +
        ' and fp.tpdocs = ''TRC'' ';
      pBuscasFP.ParamByName('num_doc').AsString := IntToStr(pNped);
      pBuscasFP.ParamByName('tipo').AsString := pTipoNped;
      pBuscasFP.ParamByName('cod_emp_mult').AsInteger := StrToInt(vDadosIni.codEmpresa);
      pBuscasFP.Open;

      if pBuscasFP.IsEmpty then
      begin
        Rdp.Imp(linha, 21, '|DIRETO');
        Rdp.Imp(linha, 37, 'SEM FORMA');

        Rdp.Imp(linha, 53, IntToStr(pNped));
        Rdp.ImpD(linha, 71, Format('%f', [0.00]), [comp17]);
        Rdp.impD(linha, 83, IntToStr(pNped), [comp17]);

        linha := linha + 1;
      end
      else
      begin
        pBuscasFP.First;
        while not pBuscasFP.Eof do
        begin
          Rdp.Imp(linha, 21, '|' + pBuscasFP.FieldByName('tp_recebimento2').AsString);
          Rdp.Imp(linha, 37, Copy(trim(pBuscasFP.FieldByName('nome_ctrl').AsString), 1, 12));

          Rdp.Imp(linha, 53, Copy(trim((pBuscasFP.FieldByName('num_doc2').AsString)), 1, 10));

          Rdp.ImpD(linha, 71, Format('%f', [pBuscasFP.FieldByName('valor_pago').AsCurrency]), [comp17]);

          Rdp.impD(linha, 83, IntToStr(pNped), [comp17]);
          Rdp.imp(linha, 89, pBuscasFP.FieldByName('data_venc').AsString);
          Rdp.imp(linha, 105, pBuscasFP.FieldByName('data_mov').AsString);

          linha := linha + 1;

          vTotRec := vTotRec + pBuscasFP.FieldByName('valor_pago').AsCurrency;

          pBuscasFP.Next;

          if (linha >= 60) and (TipoRelatorio = 'ANALÍTICO') then
          begin
            Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
            linha := 2;
            CabNovaPagina;
            linha := linha + 1;
            //        MenuAnalitico;
          end;
        end;
      end;

      Rdp.Imp(linha, 21, '|');
      Rdp.ImpD(linha, 71, Format('%f', [vTotRec]), [comp17, negrito]);
      linha := linha + 1;
      Rdp.ImpF(linha, 21, vDadosIni.replicate('-', Rdp.TamanhoQteColunas - 21), [comp17, negrito]);

      linha := linha + 1;
    end;
  end;
end;

procedure TRelatorioVendasPorVendedorAcrescCondPagVend.ImprimirTotalDoc(pTotLiq,
  pTotBr, pIncItensProd, pIncItensServ, pQtdeItensProd, pQtdeItensServ: Double);
begin
	if (TipoRelatorio = 'ANALÍTICO') and (ListarProdutos = 'SIM') and (TotalVenda = 'SIM') then
  begin
  	if (TipoRelatorio = 'ANALÍTICO') and (ExibirValorBruto = 'SIM') then
    	Rdp.ImpD(linha,  142, format('%n', [pTotLiq]), [comp17, negrito])
    else
  		Rdp.ImpD(linha,  103, format('%n', [pTotLiq]), [comp17, negrito]);

    if (pIncItensProd + pIncItensServ <> pQtdeItensProd + pQtdeItensServ) then
    	if (TipoRelatorio = 'ANALÍTICO') and (ExibirValorBruto = 'SIM') then
      	Rdp.ImpD(linha, 149, '*', [comp17, negrito])
      else
    		Rdp.ImpD(linha, 110, '*', [comp17, negrito]);

    if RecebimentoVenda = 'SIM' then
      linha := linha + 1
    else
      linha := linha + 2;
  end;
end;

