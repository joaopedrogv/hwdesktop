   buscasEmp.Close;
   buscasEmp.SQL.Text := ' select cod_empresa, identificacao_emp, cgc_emp from empresa ' +
   	 ' where ';
   if ((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0)) then
     buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' cod_empresa = ' + vDadosIni.codEmpresa
   else if (CodEmpUnificada > 0) then
     buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' cod_empresa = ' + IntToStr(CodEmpUnificada)
   else
   	 buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' financeiro_unificado = ''S'' ' +
     	 ' and codigo_unificadora = ' + vDadosIni.codEmpresa;
   buscasEmp.Open;
   buscasEmp.FetchAll;

   if not vDadosIni.ModImp(Rdp) then
     exit;

   Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
   Rdp.TamanhoQteColunas := 133;
   Rdp.CaptionSetup := 'Configurações de Impressão';
   rdp.OpcoesPreview.CaptionPreview := 'Relatório de Recebimentos (Financeiro)';
   rdp.TitulodoRelatorio := 'Recebimentos (Financeiro)';
   vDadosIni._LimparVarSendEmail;
   rdp.OnSendMail := vDadosini._SendMailRdPrint;
   rdp.OpcoesPreview.Preview := true;

   if not Rdp.EstaAberto then
     Rdp.Abrir;
   vpag := 0;
//   vquant := 0;
   linha := 1;

   CabNovaPagina; //cabeçalho
   linha := linha - 1;
   buscasEmp.First;
   while not buscasEmp.Eof do
   begin
     I := 0;
     ftempOrigemRec.EmptyDataSet;
     fTempRec.EmptyDataSet;
     fTempRecTot.EmptyDataSet;

     vSeqId := 0;
     vInc := 0;
     vIncTemp := 0;
     vLoteTemp := 0;

     vEmp := false;
     vSaida := false;
     vCrediario := false;
     vRecibo := false;
     
     vValorTotDoc := 0;
     vValorTotPag := 0;
     vValorTotRel := 0;
     vValorTotDia := 0;
     vValorRecPag := 0;
     vValorRecRel := 0;
     vValorRecDia := 0;

     vTotValorPagoLote     := 0;
     vTotValorPagoLoteOrig := 0;

     vDiaMov := '';
     vTipoMov := '';
     vTipoRec := '';
     vTipo := '';
     vNumDoc := '';

     vLote := 0;
     vInc := 0;
     vIncTemp := 0;
     vSeqId := 0;

     vExibirInfCliente := false;
     vExibirTotInfCliente := false;
     vExibirInfRec := false;
     vExibirDadosRec := false;

     try
       linha := linha + 1;
       vCodEmp := buscasEmp.FieldByName('COD_EMPRESA').AsInteger;
       abreRecebimentosFinanceiro(AgruparEmpUnificada, CodEmpUnificada, vCodEmp);
       Screen.Cursor := crHourGlass;
       variavel_parar := false;
  //   if buscas.IsEmpty then
  //   begin
  //    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  //    exit;
  //   end;
       buscas.Open;
       buscas.FetchAll;

       vvalvendaav := 0;
       vval := 0;
       vvalformas := 0;
       vvalponderacao := 0;
       
       buscas2.Close;
       buscas2.SQL.text:= ' select sum(coalesce(fp.valordoc, 0)) as valor from formpagamento fp ' +
         ' inner join empresa emp on fp.cod_empresa = emp.cod_empresa ' +
         ' where fp.data_mov >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(datainicial)) ) +
         ' and fp.data_mov <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(datainicial))) +
         ' and (fp.tipdoc = ''N'' or (fp.data_venc - fp.data_mov) <= 5) ' +
         vDadosIni.IfThen((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0),
          ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else fp.cod_empresa end) = ' + vDadosIni.codEmpresa,
          ' and fp.cod_empresa = ' + IntToStr(vCodEmp)) +
         ' and fp.tpdocs <> ''PRE''';
       buscas2.Open;

       buscas2.First;
       while not buscas2.Eof do
       begin
	       vvalvendaav := vvalvendaav + buscas2.FieldByName('valor').AsCurrency;

         buscas2.Next;
       end;

       // Vendas a Prazo e ponderação para achar os dias do prazo médio de venda
       buscas2.Close;
       if vDadosIni.vEmp.vmetodopmv <> 'CREDITOS' then
       begin
        buscas2.SQL.text := ' select sum(coalesce(fp.valordoc, 0)) as valorvenda, ' +
          ' sum((fp.data_venc-data_mov) * coalesce(fp.valordoc, 0)) as mult from formpagamento fp ' +
          ' inner join empresa emp on fp.cod_empresa = emp.cod_empresa ' +
          ' where fp.data_mov >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(datainicial))) +
          ' and fp.data_mov <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(datainicial))) +
          ' and (fp.tipdoc <> ''N'' and (fp.data_venc - fp.data_mov) > 5) ' +
          vDadosIni.IfThen((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0),
           ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else fp.cod_empresa end) = ' + vDadosIni.codEmpresa,
           ' and fp.cod_empresa = ' + IntToStr(vCodEmp)) +
          ' and fp.tpdocs <> ''PRE''';
       end
       else
       begin
        buscas2.SQL.text:= ' select sum(coalesce(cred.valor, 0)) as valorvenda,' +
          '	sum((cred.data_venc-cred.data_rec)*coalesce(cred.valor, 0)) as mult from cred_jur cred ' +
          ' inner join controles ctrl on cred.controle = ctrl.codigo_ctrl and cred.codigo_emp = ctrl.codigo_emp '+
          '	where cred.data_rec >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(datainicial))) +
          ' and cred.data_rec <= '+ QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(datainicial))) +
          ' and (cred.data_venc-cred.data_rec) > 5 and coalesce(ctrl.entra_pmv,'''') <> ''N'' ' +
          vDadosIni.IfThen((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0),
           ' and cred.codigo_emp = ' + vDadosIni.codEmpresa,
           ' and cred.cod_emp_mult = ' + IntToStr(vCodEmp));
       end;
       buscas2.Open;

       // Vendas gerais (a vista +prazo)
       buscas2.First;
       while not buscas2.Eof do
       begin
        	vval := vval + buscas2.FieldByName('valorvenda').AsCurrency;

          buscas2.Next;
       end;

       vval := vval + vvalvendaav;

       if vval <> 0 then
         vPrazoMedioVenda := Format('%n', [buscas2.FieldByName('mult').AsCurrency/(vval)])
       else
         vPrazoMedioVenda := Format('%n', [0.00]);

       // Caso a empresa não use o formpagamento para registrar pagamento de vendas
       buscas2.Close;
       buscas2.SQL.text := ' select sum(coalesce(valor_venda, 0)) as valorvenda from vendas_gerais ' +
        ' where data_venda >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(datainicial))) +
        ' and data_venda <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(datainicial))) +
        ' and venda = ''S'' ' +
        vDadosIni.IfThen((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0),
         ' and cod_empresa = ' + vDadosIni.codEmpresa,
         ' and cod_emp_mult = ' + IntToStr(vCodEmp));
       buscas2.Open;

       buscas2.First;
       while not buscas2.Eof do
       begin
      	 vvalformas := vvalformas + buscas2.FieldByName('valorvenda').AsCurrency;

         buscas2.Next;   
       end;

       if (vvalformas > vval) then
        	vval := vvalformas;

       buscas2.close;
       buscas2.SQL.text := ' select sum(coalesce(cr.valor_c, 0)) as valoratraso, '+
         ' (sum((cr.datq_c-cr.data_venc_c))/count(*)) as mediadias, '+
         ' (sum((cr.datq_c-cr.data_venc_c))/count(*)) * sum(coalesce(cr.valor_c, 0)) as ponderacao from controle_creditos cr' +
         ' left join empresa emp on cr.codigo_ctrl = emp.cod_empresa ' +
         ' inner join controles ctrl on cr.codigo_ctrl = ctrl.codigo_ctrl and cr.codigo_emp = ctrl.codigo_emp ' +
         ' where ctrl.compsaldo = ''S'' ' +
         ' and cr.datq_c >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(datainicial))) +
         ' and cr.datq_c <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(datainicial))) +
         ' and (cr.datq_c-cr.data_venc_c) > 1 ' +
         vDadosIni.IfThen((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0),
          ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else cr.codigo_emp end) = ' + vDadosIni.codEmpresa,
          ' and cr.cod_emp_mult = ' + IntToStr(vCodEmp));
       buscas2.open;

       buscas2.First;
       while not buscas2.Eof do
       begin
         vvalponderacao := vvalponderacao + buscas2.FieldByName('ponderacao').AsCurrency;

         buscas2.Next;
       end;

       if vval <> 0 then
         vAtrasoMedioRec := Format('%n', [vvalponderacao/(vval)])
       else
         vAtrasoMedioRec := Format('%n', [0.00]);

     finally
       Screen.Cursor := crDefault;
       frmRelatorios.ProgressBar.Position := 0;
       frmRelatorios.ProgressBar.Min := 0;
       frmRelatorios.ProgressBar.Max := buscas.RecordCount;
       buscas.First;
     end;
  
     vValorTotDoc := 0;
     vIncPrec := 0;
     vTipoRec := '';
     vLote := 0;
     vNumDoc := '';

     buscas.First;
     While not buscas.eof do
     begin
       Application.ProcessMessages;
       if variavel_parar then
       begin
         if confirmaparar then
         begin
  //         Parar;
           Exit;
         end;
       end;
       I := I + 1;

       vQtdePrestRec := 0;
		   vValorPagoRec := 0;
       if (trim(buscas.FieldByName('TP_REL').AsString) = 'CREDIARIO') then
       begin
         if (FiltrarCliente) or (FiltrarOrigControle) then
         begin
           if trim(buscas.FieldByName('TP_DOC').AsString) = 'CC' then
           begin
             vtempSqlEmpresa  := ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else bc.codigo_emp end) = :codigo_emp ';
             vtempSqlEmpresa2 := ' and (case when(empresa.financeiro_unificado = ''S'') then empresa.codigo_unificadora else baixa_creditos.codigo_emp end) = :codigo_emp ';
           end
           else if trim(buscas.FieldByName('TP_DOC').AsString) = 'CH' then
           begin
             vtempSqlEmpresa  := ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else ch.codigo_emp end) = :codigo_emp ';
             vtempSqlEmpresa2 := ' and (case when(empresa.financeiro_unificado = ''S'') then empresa.codigo_unificadora else controle_cheque.codigo_emp end) = :codigo_emp ';
           end
           else
           begin
             vtempSqlEmpresa  := '';
             vtempSqlEmpresa2 := '';
           end;

           if (FiltrarCliente) and (trim(buscas.FieldByName('CPFCGC_CLIENTE').AsString) <> '') then
           begin
             vtempSqlCliente  := ' and cl.cpfcgc = :cpfcgc ';
             vtempSqlCliente2 := ' and clientes.cpfcgc = :cpfcgc ';
           end
           else if (FiltrarCliente) and (trim(buscas.FieldByName('TP_DOC').AsString) = 'CC') then
           begin
             vtempSqlCliente  := ' and bc.cod_cliente = :cod_cliente ';
             vtempSqlCliente2 := ' and baixa_creditos.cod_cliente = :cod_cliente ';
           end
           else if (FiltrarCliente) and (trim(buscas.FieldByName('TP_DOC').AsString) = 'CH') then
           begin
             vtempSqlCliente  := ' and ch.cod_cliente = :cod_cliente ';
             vtempSqlCliente2 := ' and controle_cheque.cod_cliente = :cod_cliente ';
           end
           else
           begin
             vtempSqlCliente  := '';
             vtempSqlCliente2 := '';
           end;

           if (trim(buscas.FieldByName('TP_DOC').AsString) = 'CC')
           	and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
           begin
           	 vtempSqlUnificada  := ' and bc.cod_emp_mult = :cod_emp_mult ';
             vtempSqlUnificada2 := ' and baixa_creditos.cod_emp_mult = :cod_emp_mult ';
           end
           else if (trim(buscas.FieldByName('TP_DOC').AsString) = 'CH')
           	and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
           begin
           	 vtempSqlUnificada  := vtempSqlCliente  + ' and ch.cod_emp_mult = :cod_emp_mult ';
             vtempSqlUnificada2 := vtempSqlCliente2 + ' and controle_cheque.cod_emp_mult = :cod_emp_mult ';
           end
           else
           begin
             vtempSqlUnificada  := '';
             vtempSqlUnificada2 := '';
           end;

           if (FiltrarOrigControle) and (trim(buscas.FieldByName('TP_DOC').AsString) = 'CC') then
           begin
           	 vtempSqlOrigControle  := ' and bc.codigo_ctrl = :codigo_ctrl ';
             vtempSqlOrigControle2 := ' and baixa_creditos.codigo_ctrl = :codigo_ctrl ';
           end
           else if (FiltrarOrigControle) and (trim(buscas.FieldByName('TP_DOC').AsString) = 'CH') then
           begin
           	 vtempSqlOrigControle  := ' and ch.codigo_ctrl = :codigo_ctrl ';
             vtempSqlOrigControle2 := ' and controle_cheque.codigo_ctrl = :codigo_ctrl ';
           end
           else
           begin
             vtempSqlOrigControle  := '';
             vtempSqlOrigControle2 := '';
           end;

           if trim(buscas.FieldByName('TP_DOC').AsString) = 'CC' then
           begin
             buscas3.Close;
             buscas3.SQL.Text :=
               ' select ' +
               '    (select count(*) from baixa_creditos bc ' +
               '		 left join empresa emp on bc.codigo_emp = emp.cod_empresa ' +
               '     left join clientes cl on ' +
               '		 	 cl.cod_cliente = bc.cod_cliente ' +
               '			 and cl.cod_empresa = bc.cod_emp_mult ' +
               '     where bc.lote_quit = :lote ' +
                     vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                        ' and bc.datq_c = :datq_c ', '') +
                     vtempSqlEmpresa +
                     vtempSqlCliente +
                     vtempSqlOrigControle +
                     vtempSqlUnificada +
               '    ) qtde_prest, ' +
               '    (case when coalesce((' +
               '        case when (coalesce((select baixa_creditos.lote_quit from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '               coalesce((select baixa_creditos.valor_c from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) ' +
               '             else ' +
               '               (select sum(coalesce(baixa_creditos.valor_quitado, 0)) from baixa_creditos ' +
               '								left join empresa on baixa_creditos.codigo_emp = empresa.cod_empresa ' +
               '                left join clientes on ' +
               '									clientes.cod_cliente = baixa_creditos.cod_cliente ' +
               '									and clientes.cod_empresa = baixa_creditos.cod_emp_mult ' +
               '                where baixa_creditos.lote_quit = :lote ' +
                                vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                  ' and baixa_creditos.datq_c = :datq_c ', '') +
                                vtempSqlEmpresa2 +
                                vtempSqlCliente2 +
                                vtempSqlOrigControle2 +
                                vtempSqlUnificada2 +
               '               ) ' +
               '        end), 0) <= 0 then ' +
               '        0 ' +
               '      else ' +
               '        ((coalesce( ' +
               '            (case when (coalesce((select baixa_creditos.lote_quit from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '                   coalesce((select baixa_creditos.valor_c from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) ' +
               '                 else ' +
               '                   (select sum(coalesce(baixa_creditos.valor_quitado, 0)) from baixa_creditos ' +
               '									  left join empresa on baixa_creditos.codigo_emp = empresa.cod_empresa ' +
               '                    left join clientes on ' +
               '									    clientes.cod_cliente = baixa_creditos.cod_cliente ' +
               '									    and clientes.cod_empresa = baixa_creditos.cod_emp_mult ' +
               '                    where baixa_creditos.lote_quit = :lote ' +
                                    vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                      ' and baixa_creditos.datq_c = :datq_c ', '') +
                                    vtempSqlEmpresa2 +
                                    vtempSqlCliente2 +
                                    vtempSqlOrigControle2 +
                                    vtempSqlUnificada2 +
               '                   ) ' +
               '            end) , 0) / ' +
               '          coalesce( ' +
               '            (case when (coalesce((select baixa_creditos.lote_quit from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
               '                   coalesce((select baixa_creditos.valor_c from baixa_creditos where baixa_creditos.seq_bxcred = :seq_bxcred and baixa_creditos.codigo_emp = :cod_emp_orig), 0) ' +
               '                 else ' +
               '                   (select sum(coalesce(baixa_creditos.valor_quitado, 0)) from baixa_creditos ' +
               '										left join empresa on baixa_creditos.codigo_emp = empresa.cod_empresa ' +
               '                    left join clientes on ' +
               '									    clientes.cod_cliente = baixa_creditos.cod_cliente ' +
               '									    and clientes.cod_empresa = baixa_creditos.cod_emp_mult ' +
               '                    where baixa_creditos.lote_quit = :lote ' +
                                    vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                      ' and baixa_creditos.datq_c = :datq_c ', '') +
                                    vtempSqlEmpresa2 +
               '                   ) ' +
               '            end) , 0)) ' +
               '        ) ' +
               '     end ' +
               '    ) valor_pago from rdb$database ';

             buscas3.ParamByName('codigo_emp').AsInteger     := buscas.FieldByName('cod_empresa').AsInteger;
             buscas3.ParamByName('seq_bxcred').AsInteger     := buscas.FieldByName('cod_cred').AsInteger;
             buscas3.ParamByName('cod_emp_orig').AsInteger   := buscas.FieldByName('cod_emp_orig').AsInteger;

             if (FiltrarCliente) and (trim(buscas.FieldByName('cpfcgc_cliente').AsString) <> '') then
               buscas3.ParamByName('cpfcgc').AsString        := trim(buscas.FieldByName('cpfcgc_cliente').AsString)
             else if (FiltrarCliente) then
               buscas3.ParamByName('cod_cliente').AsInteger  := buscas.FieldByName('cod_cliente').AsInteger;

             if (FiltrarCliente) and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
               buscas3.ParamByName('cod_emp_mult').AsInteger := buscas.FieldByName('cod_emp_mult').AsInteger;

