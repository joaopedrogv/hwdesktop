procedure TRelatorioVendaProdutosBalcao.Parar;
begin
  frmRelatorios.BitBtn1.Enabled := True;
  frmRelatorios.BitBtn2.Enabled := True;
  frmRelatorios.BitBtn3.Enabled := False;
end;

function TRelatorioVendaProdutosBalcao.RelVendasBalcao: Boolean;
begin
  try
    result := false;
    if TipoRelatorio = 'ANALÍTICO' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select vp.nped, vp.grupo_prod, vp.cod_prod, vp.descr_prod_ped, ' +
        ' vp.vltot_ped_item,vp.rateio_desc, vp.vlun_ped_item,vp.pcust_mc,vp.quant_ped_item, ' +
        ' ((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-(vp.rateio_desc)+(vp.rateio_acresc)) as lucro,' +
        ' vp.comiss_prod,vp.comiss_prod_ger,vp.desc_funcao ' +
        ' from vendaprodutos vp ' +
        ' where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor;

      if FiltrarGrupo then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      if OrdenarPor = 'NUM PEDIDO' then
	      buscas.SQL.Text := buscas.SQL.Text + ' order by 1,2,3 '
      else if OrdenarPor = 'CODPRODUTO' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 3, 1 '
      else if OrdenarPor = 'DESCRICAO' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 4, 1, 2, 3 '
      else if OrdenarPor = 'GRUPO E CODIGO' then
        buscas.SQL.Text := buscas.SQL.Text + ' order by 2, 3, 1 ';
      buscas.Params.ParamByName('dti').AsDate := datainicial;
      buscas.Params.ParamByName('dtf').AsDate := datafinal;
      buscas.Open;
      buscas.FetchAll;
//      if buscas.IsEmpty then
//      begin
//        result := False;
//        exit;
//      end;
      end;

    // Dados Gerais
    buscas1.Close;
    buscas1.SQL.text := 'select ';

    if (FiltrarVendedor) and (Pos(',', CodVendedor) <= 0) then
    	buscas1.SQL.text := buscas1.SQL.text + ' vp.desc_funcao, ';

    buscas1.SQL.text := buscas1.SQL.text +
    	' count(distinct(vp.nped)) as qtdRequisicao, ' +
      ' sum(vp.vltot_ped_item+vp.RATEIO_ACRESC) as TotalValor,sum(vp.rateio_desc) as TotalDesc,sum(vp.rateio_acresc) as TotalAcresc,' +
      ' sum(vp.vltot_ped_item-vp.rateio_desc+vp.RATEIO_ACRESC) as TotalLiquido,sum(vp.quant_ped_item*vp.pcust_mc) as TotalCMC, ' +
      ' sum(((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-(vp.rateio_desc)+(vp.rateio_acresc))) as Totallucro, ' +
//      ' ((sum(((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-' +
//      '(vp.rateio_desc)+(vp.rateio_acresc)))/(case when sum(vp.pcust_mc)=0 then 1 else sum(vp.quant_ped_item*vp.pcust_mc) end ))*100) as markup, ' +
      ' ((sum(((vp.quant_ped_item * vp.vlun_ped_item)- ' +
      '(vp.rateio_desc)+(vp.rateio_acresc)))/(case when sum(vp.pcust_mc)=0 then 1 else sum(vp.quant_ped_item*vp.pcust_mc) end ))) as markup, ' +
      ' sum(vp.comiss_prod) as comiss_prod, sum(vp.comiss_prod_ger) as comiss_prod_ger ' +
      ' from vendaprodutos vp ' +
      '	where vp.data_fech >= :dti ' +
      '	and vp.data_fech <= :dtf ' +
      ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and vp.tipo = ''REQ'' ';

    if FiltrarTipoVenda then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.tipv = ' + QuotedStr(trim(TipoVenda))
    else
      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.venda = ''S'' ';

    if ObRel.FiltrarGrupo then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

    if FiltrarVendedor then
    begin
    	buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor;
//      buscas1.SQL.Text := StringReplace(buscas1.SQL.Text, 'from', ',vp.desc_funcao from ', [rfReplaceAll, rfIgnoreCase]);
//      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor + ' group by vp.desc_funcao';
    end;

    if (FiltrarVendedor) and (Pos(',', CodVendedor) <= 0) then
    	buscas1.SQL.text := buscas1.SQL.text + ' group by 1 ';

    buscas1.Params.ParamByName('dti').AsDate := datainicial;
    buscas1.Params.ParamByName('dtf').AsDate := datafinal;
    buscas1.Open;
    buscas1.FetchAll;
//    if buscas1.IsEmpty then
//      exit;

    // Total por Produto
    if TotalProduto = 'SIM' then
    begin
      buscas2.Close;
      buscas2.SQL.text := 'select vp.grupo_prod, vp.cod_prod, pr.descr_prod as descr_prod_ped, ' +
        ' sum(vp.vltot_ped_item - vp.rateio_desc + vp.RATEIO_ACRESC) as totalItem, ' +
        ' sum(vp.quant_ped_item) as qtdItem, ' +
        ' sum(vp.RATEIO_DESC) RATEIO_DESC, ' +
        ' sum(vp.pcust_mc * vp.quant_ped_item) pcust_mc' +
        ' from vendaprodutos vp ' +
        ' inner join produtos pr on pr.grupo_prod = vp.grupo_prod and pr.cod_prod = vp.cod_prod and pr.cod_empresa = vp.cod_empresa ' +
        ' where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas2.SQL.Text := buscas2.SQL.Text + 'and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
        buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor;

      if ObRel.FiltrarGrupo then
        buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      buscas2.SQL.Text := buscas2.SQL.Text + ' group by vp.grupo_prod, vp.cod_prod, pr.descr_prod ';//order by vp.DESCR_PROD_PED, vp.grupo_prod,vp.cod_prod ';

      if OrdenarPor = 'CODPRODUTO' then
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by vp.cod_prod '
      else if OrdenarPor = 'DESCRICAO' then
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by pr.descr_prod '
      else
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by vp.grupo_prod, vp.cod_prod ';

      buscas2.Params.ParamByName('dti').AsDate := datainicial;
      buscas2.Params.ParamByName('dtf').AsDate := datafinal;
      buscas2.Open;
      buscas2.FetchAll;
//      if buscas2.IsEmpty then
//        exit;
    end;

    if TotalGrupo = 'SIM' then
    begin
      buscas3.Close;
      buscas3.SQL.text := 'select vp.grupo_prod, vp.descricao_grupo, ' +
        ' sum(vp.vltot_ped_item-vp.rateio_desc+vp.RATEIO_ACRESC) as totalGrupo, ' +
        ' sum(vp.quant_ped_item) as qtdItem,' +
        ' sum(vp.RATEIO_DESC) RATEIO_DESC, sum(vp.pcust_mc * vp.quant_ped_item) pcust_mc' +
        ' from vendaprodutos vp ' +
        ' where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.cod_vendedor in ' + CodVendedor;

      if FiltrarGrupo then
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      buscas3.SQL.Text := buscas3.SQL.Text + ' group by vp.grupo_prod,vp.descricao_grupo ';//order by vp.grupo_prod';

      if OrdenarPor = 'DESCRICAO' then
         buscas3.SQL.Text := buscas3.SQL.Text + ' order by vp.descricao_grupo'
      else
        buscas3.SQL.Text := buscas3.SQL.Text + ' order by vp.grupo_prod';

      buscas3.Params.ParamByName('dti').AsDate := datainicial;
      buscas3.Params.ParamByName('dtf').AsDate := datafinal;
      buscas3.Open;
      buscas3.FetchAll;
//      if buscas3.IsEmpty then
//        exit;
    end;
    result := true;
  except
    Result := false;
  end;
end;

procedure TRelatorioVendaProdutosBalcao.CabNovaPagina;
begin
  //  if Rdp.UltimaPagina > 1 then
  if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO DE VENDAS/FATURAMENTO DE PRODUTOS', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DADOS BALCAO', [normal, negrito]);
  linha := linha + 1;
  if FiltrarTipoVenda then
    Rdp.ImpF(linha, 1, trim(dtSetTipVenda.FieldByName('DESCRICAO').AsString), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'TODOS OS TIPOS DE VENDA', [normal, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);

  if FiltrarVendedor then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, Copy('VENDEDOR: ' + trim(Vendedor), 1, 78), [normal, negrito]);
  end
  else
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + 'TODOS', [normal, negrito]);
  end;

  vpag := vpag + 1;
  Rdp.ImpF(linha, 80, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
end;

constructor TRelatorioVendaProdutosBalcao.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrBuscas1);
  buscas2 := TIBQuery(dtmRelatorios.qrBuscas2);
  buscas3 := TIBQuery(dtmRelatorios.qrBuscas3);
  buscasGerais := TIBQuery(dtmRelatorios.qrBuscasGerais);
end;

procedure TRelatorioVendaProdutosBalcao.ImprimeRelatorios;
begin
  if not vDadosIni.PesqPros('REL003', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not RelVendasBalcao then
  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
  end;

  vpag := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
  	exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  if (TotalProduto = 'SIM') or (TotalGrupo = 'SIM') then
    Rdp.TamanhoQteColunas := 150
  else
    Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Vendas e Faturamento de Produtos - Requisição';
  rdp.TitulodoRelatorio := 'Vendas e Faturamento de Produtos - REQ';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  CabNovaPagina; //cabeçalho

  // Inicio da Impressão dos Itens.
  if TipoRelatorio = 'ANALÍTICO' then
  begin
    Menu;
    try
      Screen.Cursor := crHourGlass;
      variavel_parar := false;
      buscas.FetchAll;
    finally
      Screen.Cursor := crDefault;
      frmRelatorios.ProgressBar.Position := 0;
      frmRelatorios.ProgressBar.Min := 0;
      frmRelatorios.ProgressBar.Max := buscas.RecordCount;
      buscas.First;
    end;

    while not buscas.eof do
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end
      end;
      try
        Rdp.Imp(linha, 1, Buscas.FieldByName('grupo_Prod').asstring);
        Rdp.ImpD(linha, 13, trim(Buscas.FieldByName('cod_Prod').asstring), [comp17]);
{        Rdp.Imp(linha, 14, Copy(Buscas.FieldByName('descr_prod_ped').AsString, 1, 37));
        Rdp.Imp(linha, 55, Buscas.FieldByName('nped').AsString);
        Rdp.ImpD(linha, 78, format('%n', [Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 94, format('%n', [Buscas.FieldByName('pcust_mc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 105, Format('%n', [Buscas.FieldByName('quant_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 119, format('%n', [Buscas.FieldByName('lucro').AsCurrency]), [comp17]);
}
        Rdp.Imp(linha, 14, Copy(Buscas.FieldByName('descr_prod_ped').AsString, 1, 35));
        Rdp.ImpD(linha, 59, Buscas.FieldByName('nped').AsString, [comp17]);
        Rdp.ImpD(linha, 72, format('%f', [Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 86, format('%f', [Buscas.FieldByName('pcust_mc').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 95, Format('%f', [Buscas.FieldByName('quant_ped_item').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 110, Format('%f', [Buscas.FieldByName('quant_ped_item').AsCurrency * Buscas.FieldByName('vlun_ped_item').AsCurrency]), [comp17]);

        Rdp.ImpD(linha, 122, format('%f', [Buscas.FieldByName('lucro').AsCurrency]), [comp17]);

        if pos('GERENTE', Buscas.FieldByName('desc_funcao').asString) > 0 then
          Rdp.ImpD(linha, 132, format('%f', [Buscas.FieldByName('comiss_prod_ger').AsCurrency]), [comp17]) //;// [comp17]);
        else
          Rdp.ImpD(linha, 132, format('%f', [Buscas.FieldByName('comiss_prod').AsCurrency]), [comp17]);
        linha := linha + 1;
      except
      end;
      buscas.Next;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := 2;
        CabNovaPagina;
        Menu;
      end;
    end;
  end;

  //Impressão dos dados gerais
  if not buscas.IsEmpty then
  begin
    Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
    linha := linha + 1;
  end;
  Rdp.ImpF(linha, 1, 'DADOS GERAIS', [normal, negrito]);
  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOTAL VENDA(R$).........: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('TotalValor').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOTAL DESCONTO(R$)......: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('TotalDesc').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOTAL ACRESCIMO(R$).....: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('TotalAcresc').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOTAL LIQUIDO(R$).......: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('TotalLiquido').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOT.CUSTO MED. CONT(R$).: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('TotalCMC').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'LUCRO BRUTO(R$).........: ');
  Rdp.ImpD(linha, 40, format('%n', [vDadosIni.StrToFloatFormat(Buscas1.FieldByName('Totallucro').AsCurrency, 2)]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'MARK UP FATURAMENTO.....: ');
  Rdp.ImpD(linha, 40, format('%0.4n', [Buscas1.FieldByName('MARKUP').AsCurrency]), [comp17]);

  linha := linha + 1;
  Rdp.Imp(linha, 1, 'QUANTIDADE REQUISICOES..: ');
  Rdp.ImpD(linha, 40, vDadosIni.StrZero(Buscas1.FieldByName('qtdRequisicao').AsInteger, 6), [comp17]);

  linha := linha + 1;
  if (FiltrarVendedor) and (Pos(',', CodVendedor) <= 0) then
  begin
    if pos('GERENTE', Buscas1.FieldByName('desc_funcao').asString) > 0 then
    begin
      Rdp.Imp(linha, 1, 'COMISSAO GERENTE PRODUTO: ');
      Rdp.ImpD(linha, 40, format('%n', [Buscas1.FieldByName('comiss_prod_ger').AsCurrency]), [comp17]);
    end
    else
    begin
      Rdp.Imp(linha, 1, 'COMISSAO FUNCIONARIO PR.: ');
      Rdp.ImpD(linha, 40, format('%n', [Buscas1.FieldByName('comiss_prod').AsCurrency]), [comp17]);
    end;
    linha := linha + 1;
  end;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));

  // Se Agrupado por Produto = Sim
  if UpperCase(TotalProduto) = 'SIM' then
  begin
    vquantidade := 0;
    vvalor := 0;

    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'TOTAL DOS PRODUTOS POR CODIGO ', [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 001, 'Grupo', [comp17, negrito]);
    Rdp.ImpF(linha, 008, 'Codigo', [comp17, negrito]);
    Rdp.ImpF(linha, 015, 'Descrição', [comp17, negrito]);
    Rdp.ImpD(linha, 080, 'Qtde', [comp17, negrito]);
    Rdp.ImpD(linha, 095, 'Vr Liq', [comp17, negrito]);
    Rdp.ImpD(linha, 105, 'Desc.Med', [comp17, negrito]);
    Rdp.ImpD(linha, 120, 'C.M.V', [comp17, negrito]);
    Rdp.ImpD(linha, 135, 'Markup', [comp17, negrito]);
    Rdp.ImpD(linha, 150, 'Lucro', [comp17, negrito]);
    linha := linha + 1;
    Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
    linha := linha + 1;

    try
      Screen.Cursor := crHourGlass;
      variavel_parar := false;
      buscas2.FetchAll;
    finally
      Screen.Cursor := crDefault;
      frmRelatorios.ProgressBar.Position := 0;
      frmRelatorios.ProgressBar.Min := 0;
      frmRelatorios.ProgressBar.Max := buscas2.RecordCount;
      if buscas2.Active then
        buscas2.First;
    end;

    while not buscas2.Eof do
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end;
      end;
      Rdp.Imp(linha, 001, buscas2.FieldByName('grupo_prod').AsString);
      Rdp.Imp(linha, 008, trim(buscas2.FieldByName('cod_prod').AsString));
      Rdp.Imp(linha, 015, copy((buscas2.FieldByName('descr_prod_ped').AsString), 1, 55));
      Rdp.ImpD(linha, 080, format('%12.3n', [buscas2.FieldByName('qtdItem').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 095, format('%n', [vDadosIni.StrToFloatFormat(buscas2.FieldByName('totalItem').AsCurrency, 2)]), [comp17]);
      if buscas2.FieldByName('qtdItem').AsCurrency <> 0 then
        Rdp.ImpD(linha, 105, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas2.FieldByName('RATEIO_DESC').AsCurrency / buscas2.FieldByName('qtdItem').AsCurrency
            , 3)]), [comp17])
      else
        Rdp.ImpD(linha, 105, format('%0.3n', [0.00]), [comp17]);
      Rdp.ImpD(linha, 120, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas2.FieldByName('pcust_mc').AsCurrency
          , 3)]), [comp17]);
      if buscas2.FieldByName('pcust_mc').AsCurrency <> 0 then
        Rdp.ImpD(linha, 135, format('%0.4n', [vDadosIni.StrToFloatFormat(((buscas2.FieldByName('totalItem').AsCurrency /
            buscas2.FieldByName('pcust_mc').AsCurrency) {- 1) * 100}), 4)]), [comp17])
      else
        Rdp.ImpD(linha, 135, 'SEM CUSTO', [comp17]);
      Rdp.ImpD(linha, 150, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas2.FieldByName('totalItem').AsCurrency - buscas2.FieldByName('pcust_mc').AsCurrency
          , 3)]), [comp17]);
      linha := linha + 1;

      vquantidade := vquantidade + buscas2.FieldByName('qtdItem').AsCurrency;
      vvalor := vvalor + vDadosIni.StrToFloatFormat(buscas2.FieldByName('totalItem').AsCurrency, 2);

      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := 2;
        CabNovaPagina;
        linha := linha + 1;
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := linha + 1;
        Rdp.ImpF(linha, 1, 'TOTAL DOS PRODUTOS POR CODIGO ', [normal, negrito]);
        linha := linha + 1;
        Rdp.ImpF(linha, 001, 'Grupo', [comp17, negrito]);
        Rdp.ImpF(linha, 008, 'Codigo', [comp17, negrito]);
        Rdp.ImpF(linha, 015, 'Descrição', [comp17, negrito]);
        Rdp.ImpD(linha, 080, 'Qtde', [comp17, negrito]);
        Rdp.ImpD(linha, 095, 'Vr Liq', [comp17, negrito]);
        Rdp.ImpD(linha, 105, 'Desc.Med', [comp17, negrito]);
        Rdp.ImpD(linha, 120, 'C.M.V', [comp17, negrito]);
        Rdp.ImpD(linha, 135, 'Markup', [comp17, negrito]);
        Rdp.ImpD(linha, 150, 'Lucro', [comp17, negrito]);
        linha := linha + 1;
      end;
      buscas2.Next;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    end;
    Rdp.ImpF(linha, 1, 'TOTAL', [comp17, negrito]);
    Rdp.ImpD(linha, 80, format('%12.3n', [vquantidade]), [comp17, negrito]);
    Rdp.ImpD(linha, 95, format('%0.3n', [vvalor]), [comp17, negrito]);
    linha := linha + 1;
  end;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));

  // Se Agrupado por Grupo = Sim
  if UpperCase(TotalGrupo) = 'SIM' then
  begin
    vquantidade := 0;
    vvalor := 0;

    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'TOTAL DOS PRODUTOS POR GRUPO ', [normal, negrito]);
    linha := linha + 1;
//    Rdp.ImpF(linha, 1, 'GRUPO', [comp17, negrito]);
//    Rdp.ImpF(linha, 30, 'DESCRICAO', [comp17, negrito]);
//    Rdp.ImpF(linha, 75, 'QUANTIDADE', [comp17, negrito]);
//    Rdp.ImpD(linha, 104, 'VALOR LIQUIDO', [comp17, negrito]);
    Rdp.ImpF(linha, 001, 'Grupo', [comp17, negrito]);
    Rdp.ImpF(linha, 015, 'Descrição', [comp17, negrito]);
    Rdp.ImpD(linha, 080, 'Qtde', [comp17, negrito]);
    Rdp.ImpD(linha, 095, 'Vr Liq', [comp17, negrito]);
    Rdp.ImpD(linha, 105, 'Desc.Med', [comp17, negrito]);
    Rdp.ImpD(linha, 120, 'C.M.V', [comp17, negrito]);
    Rdp.ImpD(linha, 135, 'Markup', [comp17, negrito]);
    Rdp.ImpD(linha, 150, 'Lucro', [comp17, negrito]);

    linha := linha + 1;
    Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
    linha := linha + 1;
    try
      Screen.Cursor := crHourGlass;
      variavel_parar := false;
      buscas3.FetchAll;
    finally
      Screen.Cursor := crDefault;
      frmRelatorios.ProgressBar.Position := 0;
      frmRelatorios.ProgressBar.Min := 0;
      frmRelatorios.ProgressBar.Max := buscas3.RecordCount;
      if buscas3.Active then
        buscas3.First;
    end;
    while not buscas3.Eof do
    begin
      Application.ProcessMessages;
      if variavel_parar then
      begin
        if confirmaparar then
        begin
//          Parar;
          Exit;
        end;
      end;
      Rdp.Imp(linha, 001, buscas3.FieldByName('grupo_prod').AsString);
      Rdp.Imp(linha, 015, buscas3.FieldByName('descricao_grupo').AsString);
      Rdp.ImpD(linha, 080, format('%n', [buscas3.FieldByName('qtdItem').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 095, format('%n', [buscas3.FieldByName('totalGrupo').AsCurrency]), [comp17]);
      if buscas3.FieldByName('qtdItem').AsCurrency <> 0 then
        Rdp.ImpD(linha, 105, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas3.FieldByName('RATEIO_DESC').AsCurrency / buscas3.FieldByName('qtdItem').AsCurrency
            , 3)]), [comp17])
      else
        Rdp.ImpD(linha, 105, format('%0.3n', [0.00]), [comp17]);
      Rdp.ImpD(linha, 120, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas3.FieldByName('pcust_mc').AsCurrency
          , 3)]), [comp17]);
      if buscas3.FieldByName('pcust_mc').AsCurrency <> 0 then
        Rdp.ImpD(linha, 135, format('%0.4n', [vDadosIni.StrToFloatFormat(((buscas3.FieldByName('totalGrupo').AsCurrency /
            buscas3.FieldByName('pcust_mc').AsCurrency) {- 1) * 100}), 4)]), [comp17])
      else
        Rdp.ImpD(linha, 135, 'SEM CUSTO', [comp17]);
      Rdp.ImpD(linha, 150, format('%0.3n', [vDadosIni.StrToFloatFormat(buscas3.FieldByName('totalGrupo').AsCurrency - buscas3.FieldByName('pcust_mc').AsCurrency
          , 3)]), [comp17]);
      linha := linha + 1;

      vquantidade := vquantidade + buscas3.FieldByName('qtdItem').AsCurrency;
      vvalor := vvalor + vDadosIni.StrToFloatFormat(buscas3.FieldByName('totalGrupo').AsCurrency, 2);

      if linha >= 60 then
      begin
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := 2;
        CabNovaPagina;
        linha := linha + 1;
        Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
        linha := linha + 1;
        Rdp.ImpF(linha, 1, 'TOTAL DOS PRODUTOS POR GRUPO ', [normal, negrito]);
        linha := linha + 1;
//        Rdp.ImpF(linha, 1, 'GRUPO', [comp17, negrito]);
//        Rdp.ImpF(linha, 30, 'DESCRICAO', [comp17, negrito]);
//        Rdp.ImpF(linha, 75, 'QUANTIDADE', [comp17, negrito]);
//        Rdp.ImpD(linha, 104, 'VALOR LIQUIDO', [comp17, negrito]);
        Rdp.ImpF(linha, 001, 'Grupo', [comp17, negrito]);
        Rdp.ImpF(linha, 015, 'Descrição', [comp17, negrito]);
        Rdp.ImpD(linha, 080, 'Qtde', [comp17, negrito]);
        Rdp.ImpD(linha, 095, 'Vr Liq', [comp17, negrito]);
        Rdp.ImpD(linha, 105, 'Desc.Med', [comp17, negrito]);
        Rdp.ImpD(linha, 120, 'C.M.V', [comp17, negrito]);
        Rdp.ImpD(linha, 135, 'Markup', [comp17, negrito]);
        Rdp.ImpD(linha, 150, 'Lucro', [comp17, negrito]);
        linha := linha + 1;
      end;
      buscas3.Next;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    end;
    Rdp.ImpF(linha, 1, 'TOTAL', [comp17, negrito]);
    Rdp.ImpD(linha, 80, format('%n', [vquantidade]), [comp17, negrito]);
    Rdp.ImpD(linha, 95, format('%n', [vvalor]), [comp17, negrito]);
    linha := linha + 1;
  end;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  frmRelatorios.ProgressBar.position := 0;

  vDadosIni.GravaAuditoria('REL003', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);

  buscas.Close;
  buscas1.Close;
  buscas2.Close;
  buscas3.Close;


end;

