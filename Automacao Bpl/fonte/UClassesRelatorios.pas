    if linha >= 60 then
      CabNovaPagina;
    buscas.next;
  end;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 160), [comp17]);
  linha := linha + 1;
  Rdp.Imp(linha, 2, '**** RECEBIMENTOS DE CREDITOS/FIADOS ****');
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
