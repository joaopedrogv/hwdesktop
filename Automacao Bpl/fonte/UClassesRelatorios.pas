begin
	buscasGerais.Close;
  buscasGerais.SQL.text := 'select vp.cod_vendedor,vp.data_fech as data,vp.quant_ped_item as quant,vp.grupo_prod,' +
    ' vp.cod_prod,vp.DESCR_PROD_PED as descricao,vp.VLUN_PED_ITEM as valor,vp.VLUN_ORIG as valor_orig, ' +
    ' - comissao.ivalor_comissao as comiss_prod, ' +
    ' - 0 as comiss_prod_ger, ' +
    ' - comissao.ipercentual_desc as perc_desc, ' +
    ' - comissao.ipercentual_regra as perc_comiss, ' +
    ' vp.tipo,vp.nped as sequencia from vendaprodutos vp ';
  if FiltrarAreaExec then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text +
    ' inner join tipo_vendas tp on tp.tipo = vp.tipo and (tp.sigla = vp.tipv or (tp.tipo_os = vp.tipo_os)) ';

  buscasGerais.SQL.Text := buscasGerais.SQL.Text +
    ' inner join produtos pr on pr.grupo_prod = vp.grupo_prod and pr.cod_prod = vp.cod_prod and pr.cod_empresa = vp.cod_empresa ' +
    ' left join retorna_comissao_faixadesc( ' +
    '     pr.cod_comissao_faixa_desc, ' +
    '     vp.cod_empresa, ' +
    '			case when (vp.tipo = ''DEV'') then ' +
    '     		round(case when (abs(coalesce(vp.vlun_orig, 0) * coalesce(vp.quant_ped_item, 0)) > (abs(coalesce(vp.vltot_ped_item, 0)) - abs(coalesce(vp.rateio_desc, 0)) + abs(coalesce(vp.rateio_acresc, 0)))) then ' +
    '                      abs(1 - (((coalesce(vp.vltot_ped_item, 0) - coalesce(vp.rateio_desc, 0) + coalesce(vp.rateio_acresc, 0))) / (coalesce(vp.vlun_orig, 0) * coalesce(vp.quant_ped_item, 0)))) * 100 ' +
    '           			   else ' +
    '                 	    0 ' +
    '           	  end, ' +
    '					2) ' +
    '     	else ' +
    '     		round(case when (coalesce(vp.vlun_orig, 0) * coalesce(vp.quant_ped_item, 0) > (coalesce(vp.vltot_ped_item, 0) - coalesce(vp.rateio_desc, 0) + coalesce(vp.rateio_acresc, 0))) then ' +
    '                      abs(1 - (((coalesce(vp.vltot_ped_item, 0) - coalesce(vp.rateio_desc, 0) + coalesce(vp.rateio_acresc, 0))) / (coalesce(vp.vlun_orig, 0) * coalesce(vp.quant_ped_item, 0)))) * 100 ' +
    '                    else ' +
    '                      0 ' +
    '          			end, ' +
    '    			2) ' +
    '			end, ' +
    '			case when (vp.tipo = ''DEV'') then ' +
    '       		 abs(coalesce(vp.vltot_ped_item, 0)) ' +
    '          else ' +
    '     	     (coalesce(vp.vltot_ped_item, 0) - coalesce(vp.rateio_desc, 0) + coalesce(vp.rateio_acresc, 0)) ' +
    '			end) comissao on 1 = 1 ';

  buscasGerais.SQL.text := buscasGerais.SQL.text +
    ' where vp.data_fech >= :dti ' +
    ' and vp.data_fech <= :dtf ' +
    ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and vp.tipo = ''DEV'' ';

  if FiltrarTipoVenda and FiltrarTipoOS then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' )' +
      ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ')) '
  else if FiltrarTipoVenda then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ') ' +
      ' or (not vp.TIPO_OS is null and vp.venda = ''S'') )'
  else if FiltrarTipoOS then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((not vp.TIPV is null and vp.venda = ''S'')' +
      ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + '))'
  else
    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.venda = ''S'' ';

  if FiltrarAreaExec then
    buscasGerais.SQL.Text := buscasGerais.SQL.Text +
    ' and ((vp.tipo = ''OS'' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (vp.tipo <> ''OS'')) ';

  buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.cod_vendedor = ' + inttostr(pCodVendedor);
  buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
  buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
  buscasGerais.Open;
  buscasGerais.FetchAll;

  buscasGerais.First;
  while not buscasGerais.eof do
  begin
    Rdp.Imp(linha, 1, buscasGerais.FieldByName('data').asstring);
    Rdp.ImpD(linha, 17, Floattostr(buscasGerais.FieldByName('quant').AsCurrency {* (-1)}), [comp17]);
    Rdp.ImpD(linha, 23, buscasGerais.FieldByName('grupo_prod').asstring, [comp17]);
    Rdp.ImpF(linha, 24, trim(buscasGerais.FieldByName('cod_Prod').asstring), [comp17]);
    Rdp.ImpF(linha, 31, Copy(trim(buscasGerais.FieldByName('descricao').AsString), 1, 32), [comp17]);
    Rdp.ImpD(linha, 75, format('%n', [(buscasGerais.FieldByName('valor_orig').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 90, format('%n', [buscasGerais.FieldByName('valor').AsCurrency {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 107, format('%n', [(buscasGerais.FieldByName('valor').AsCurrency * buscasGerais.FieldByName('quant').ascurrency) {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 117, format('%n', [Abs(buscasGerais.FieldByName('perc_desc').AsCurrency)]), [comp17]);
    Rdp.ImpD(linha, 129, format('%n', [Abs(buscasGerais.FieldByName('perc_comiss').AsCurrency)]), [comp17]);
//    if pos('GERENTE', vDescriFuncao) > 0 then
//      Rdp.ImpD(linha, 139, format('%n', [buscasGerais.FieldByName('comiss_prod_ger').AsCurrency {* (-1)}]), [comp17]) //;// [comp17]);
//    else
      Rdp.ImpD(linha, 139, format('%n', [buscasGerais.FieldByName('comiss_prod').AsCurrency {* (-1)}]), [comp17]);
    Rdp.ImpD(linha, 143, 'DEV', [comp17]);
    Rdp.ImpD(linha, 150, vDadosIni.StrZero(buscasGerais.FieldByName('sequencia').AsInteger, 6), [comp17]);
    linha := linha + 1;
    if linha >= 60 then
    begin
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas - 1));
      linha := 2;
      CabNovaPagina;
      if TipoRelatorio = 'ANALÍTICO' then
        MenuAnalitico;
    end;
    buscasGerais.next;
  end;
  buscasGerais.close;
  result := true;
end;

