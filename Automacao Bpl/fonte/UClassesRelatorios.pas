      buscas.SQL.Text := buscas.SQL.Text +
      ' and ((vps.tipo = ''OS'' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec)) + ') or (vps.tipo <> ''OS'')) ';

    buscas.SQL.Text := buscas.SQL.Text + ' union ' +
      ' select vps.col_cod_vendedor, vps.tipo, vps.nped, ' +
      ' vps.GRUPOP_CODSERV, vps.cod_prod, vps.descr_item_ped, ' +
      ' vps.vltot_ped_item, vps.valor_total_liquido, vps.valor_total_bruto, ' +
      ' vps.rateio_desc, vps.vlun_ped_item,vps.pcust_mc,vps.quant_ped_item, ' +
