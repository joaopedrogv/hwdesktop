procedure TRelatorioDiarioDiretoria.ImprimeRelatorios;
var
  i: integer;
begin
  if not vDadosIni.PesqPros('REL035', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Diário Diretoria';
  rdp.TitulodoRelatorio := 'Relatório Diário Diretoria';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  buscas.close;
  buscas.sql.clear;
  buscas.sql.text := ' select * from produtos ' +
  	' where grupo_prod = :vgrup ' +
    ' and cod_prod = :vcod ' +
    ' and cod_empresa = :cod_empresa ' +
    ' and ativo = 1 ';
  buscas.ParamByName('COD_EMPRESA').asstring := vDadosIni.CodEmpresa;
  buscas.params[0].DataType := ftstring;
  buscas.params[1].DataType := ftstring;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  vquantgnovo:=0;
  vvalgnovo:=0;
  vContLista:=0;
  MontarStringListLadoB;
  linha := 1;
  for i := 1 to 3 do
  begin
    Application.ProcessMessages;
    if (vDadosIni.vEmp.vVersaoVeiculos = '4') then
    begin
      buscas.close;
      buscas.sql.text := ' SELECT VV.ORDTIPO, VV.CODIGO, VV.DESCRICAO DESCRICAO_VERSAOV, COUNT(*), SUM(FT.PRVEN_V), ' +
       ' SUM(FT.VALOR_REAL) AS VALOR_REAL FROM COM_FAT FT ' +
       ' INNER JOIN EST_MOTO EST ON EST.CHASSI_C = FT.CHASSIV AND EST.CODIGO = FT.COD_ESTMOTO AND EST.COD_EMPRESA = FT.COD_EMPRESA ' +
       ' INNER JOIN TIPMODELO VV ON VV.CODIGO = EST.VERSAOEST AND VV.COD_EMPRESA = EST.COD_EMPRESA ' +
       ' LEFT JOIN NAT_OP NT ON FT.NATOP_V = NT.CODIGO_NOP ' +
       ' WHERE FT.NATUREZA = ''S'' and (COALESCE(TRIM(FT.STATUS_V), '''') = ''FECHADO'') ' +
       ' AND  FT.DATA_VEN >= :VDAT1 AND FT.DATA_VEN <= :VDAT2 ' +
       ' AND COALESCE(NT.FATURAMENTO, ''N'') = ''S'' ';
      buscas.ParamByName('VDAT1').asdate := datainicial;
      buscas.ParamByName('VDAT2').asdate := datafinal;
      buscas.sql.text := buscas.sql.text + ' AND FT.TIPO_VENDA_V = :VTIP ' +
        ' AND FT.COD_EMPRESA = :COD_EMPRESA AND FT.ATIVO = 1 ';
       if i = 1 then
         buscas.SQL.text := buscas.SQL.text + ' AND TIPO_V = ''CNH'' ';
       if i = 2 then
         buscas.SQL.text := buscas.SQL.text + ' AND TIPO_V <> ''CNH'' ';
       buscas.SQL.text:=buscas.SQL.text + ' GROUP BY VV.ORDTIPO, VV.DESCRICAO, VV.CODIGO';
      buscas.ParamByName('COD_EMPRESA').asstring := vDadosIni.CodEmpresa;
      if i <= 2 then
        buscas.ParamByName('VTIP').asstring := 'N'
      else
        buscas.ParamByName('VTIP').asstring := 'U';
      buscas.open;
      buscas.FetchAll;
    end
    else
    begin
      buscas.close;
      buscas.sql.text := ' SELECT VV.ORDTIPO, VV.CODIGO, VN.DESCRICAO_VERSAOV, COUNT(*), SUM(FT.PRVEN_V), ' +
        ' SUM(FT.VALOR_REAL) AS VALOR_REAL FROM COM_FAT FT, MOT_VEN VN, TIPMODELO VV, NAT_OP NT ' +
        ' where  FT.DATA_VEN >= :VDAT1 AND FT.DATA_VEN <= :VDAT2 ' +
        ' AND FT.CHASSIV = VN.CHASSIV AND FT.N_COMANDO = VN.N_COMANDO AND '+
        ' FT.NATOP_V = NT.CODIGO_NOP AND COALESCE(NT.FATURAMENTO, ''N'') = ''S'' AND VN.VERSAOV = VV.CODIGO ';
      buscas.ParamByName('VDAT1').asdate := datainicial;
      buscas.ParamByName('VDAT2').asdate := datafinal;
      buscas.sql.text := buscas.sql.text + ' AND FT.TIPO_VENDA_V = :VTIP ' +
        ' AND FT.COD_EMPRESA = VN.COD_EMPRESA AND VN.COD_EMPRESA = VV.COD_EMPRESA AND ' +
        ' FT.COD_EMPRESA = :COD_EMPRESA AND FT.ATIVO = 1 ';
       if i = 1 then
         buscas.SQL.text := buscas.SQL.text + ' AND TIPO_V = ''CNH'' ';
       if i = 2 then
         buscas.SQL.text := buscas.SQL.text + ' AND TIPO_V <> ''CNH'' ';
       buscas.SQL.text := buscas.SQL.text + ' GROUP BY VV.ORDTIPO, VN.DESCRICAO_VERSAOV, VV.CODIGO';
      buscas.ParamByName('COD_EMPRESA').asstring := vDadosIni.CodEmpresa;
      if i <= 2 then
        buscas.ParamByName('VTIP').asstring := 'N'
      else
        buscas.ParamByName('VTIP').asstring := 'U';
      buscas.open;
      buscas.FetchAll;
    end;
    linha := linha + 1;
    Rdp.Imp(linha, 1, vDadosIni.vEmp.vNomeEmpresa);
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'De: ' + FormatDateTime('dd/mm/yyyy', datainicial)+ ' a ' + FormatDateTime('dd/mm/yyyy', datafinal));
    linha := linha + 1;
    linha := linha + 2;
    if i = 1 then
      Rdp.Impf(linha, 1, 'NOVO -  CNH', [negrito]);
    if i = 2 then
      Rdp.Impf(linha, 1, 'NOVO -  SEM CNH', [negrito]);
    if i = 3 then
      Rdp.Impf(linha, 1, 'OUTRAS CONCESSIONARIAS/USADAS', [negrito]);
    linha := linha + 1;
    Rdp.Impf(linha, 1, 'MODELO', [negrito]);
    Rdp.Impf(linha, 20, 'QTDE', [negrito]);
    Rdp.Impf(linha, 28, 'TOTAL', [negrito]);
    Rdp.Impf(linha, 41, '  %   ', [negrito]);
//    if buscas.RecordCount > 0 then
//      linha := linha + 1;
    vquant := 0;
    vvalgmoto:=0;
    frmRelatorios.ProgressBar.max := buscas.RecordCount;
    frmRelatorios.ProgressBar.min := 0;
    frmRelatorios.ProgressBar.position := 0;
    buscas.First;
    while not buscas.eof do
    begin
      Application.ProcessMessages;
      linha := linha + 1;
      Rdp.imp(linha, 1, trim(buscas.FieldByName('DESCRICAO_VERSAOV').AsString));
      Rdp.imp(linha, 28, vDadosIni.Alndir(buscas.FieldByName('COUNT').Asstring, 4));
      Rdp.imp(linha, 34, vDadosIni.Alndir(format('%n', [buscas.FieldByName('VALOR_REAL').AsFloat]), 12));
      vvalgmoto := vvalgmoto + buscas.FieldByName('VALOR_REAL').AsFloat;
      Vquant := vquant + buscas.FieldByName('COUNT').AsInteger;
      if linha >= 59 then
      begin
        ImprimirStringListLaboB(linha);
        linha := 1;
        Rdp.Novapagina;
      end;
      buscas.next;
      frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    end;
    linha := linha + 1;
    Rdp.imp(linha, 28, vDadosIni.Alndir(inttostr(vquant), 4));
    Rdp.imp(linha, 34, vDadosIni.Alndir(format('%n', [vvalgmoto]), 12));
    buscas.close;

    if i <= 2 then
    begin
     vquantgnovo := vquantgnovo + vquant;
     vvalgnovo := vvalgnovo + vvalgmoto;
     if i = 2 then
     begin
      linha := linha + 1;
      Rdp.imp(linha, 1, 'Total Geral Veiculos: ');
      Rdp.imp(linha, 28, vDadosIni.Alndir(inttostr(vquantgnovo), 4));
      Rdp.imp(linha, 34, vDadosIni.Alndir(format('%n', [vvalgnovo]), 12));
     end;
    end;
  end;

  linha := linha + 2;
  Rdp.Imp(linha, 1, 'Qtde Cotas..............: ' + vDadosIni.Alndir(FloatToStr(QtdeCotas), 8));
  linha := linha + 1;

  vtotgb := 0.00;
  vtotcb := 0.00;
  vldesc := 0.00;
  vtotit := 0.00;
  vquantreq := 0;
  vquantos := 0;
  vrecep := 0;
  vldesco := 0.00;
  vldescop := 0.00;
  vtotvprd := 0.00;
  vtotvprdm := 0.00;
  vtotvs := 0.00;
  vldescmo := 0.00;
  vdprop := 0.00;
  vqtr := 0;
  vqto := 0;
  vflag := 0;

  buscas.close;
  buscas.sql.Text:='SELECT SUM(VTOT_VENDA-DESCONTO) AS VALOR,SUM(CUSTOMC) AS CUSTO FROM VENDASMESES4 AS '+
    'VENDASMESES WHERE VENDASMESES.data_os_rq >= :vdat1 and VENDASMESES.data_os_rq <= :vdat2 '+
    'and VENDASMESES.tipo = ''OS'' AND vendasmeses.cod_empresa = ' + vDadosIni.CodEmpresa;
  buscas.params[0].AsDate := datainicial;
  buscas.params[1].AsDate := datafinal;
  buscas.Open;
  buscas.FetchAll;

  frmRelatorios.ProgressBar.max := buscas.recordCount + 1;
  frmRelatorios.ProgressBar.min := 0;
  frmRelatorios.ProgressBar.position := 0;
  linha := linha + 1;
  Rdp.Imp(linha, 1, 'TOTAL OFICINA(R$).......: ' + vDadosIni.Alndir(format('%n', [buscas.FieldByName('VALOR').AsCurrency]), 12));
  linha := linha + 1;
  buscas.close;
  buscas.sql.text :='SELECT VENDASMESES.GRUPO_PROD,GR.DESCRICAO,SUM(VTOT_VENDA-DESCONTO) AS VALOR,SUM(CUSTOMC) AS CUSTO,sum(VENDASMESES.VQT) AS QTDE FROM VENDASMESES4 AS '+
    'VENDASMESES INNER JOIN GRUPOS GR ON VENDASMESES.GRUPO_PROD = GR.CODIGO_GRUP WHERE VENDASMESES.data_os_rq >= :vdat1 and VENDASMESES.data_os_rq <= :vdat2 '+
    'and VENDASMESES.tipo = ''OS'' AND vendasmeses.cod_empresa = ' + vDadosIni.CodEmpresa +
    ' GROUP BY VENDASMESES.GRUPO_PROD,GR.DESCRICAO';
  buscas.params[0].AsDate := datainicial;
  buscas.params[1].AsDate := datafinal;
  buscas.open;
  Rdp.ImpF(linha, 1, 'TOTAL DOS PRODUTOS POR GRUPO ', [normal, negrito]);
  linha := linha + 1;
  Rdp.Imp(linha, 1, 'CODIGO');
  Rdp.Imp(linha, 20, 'DESCRICAO');
  Rdp.Imp(linha, 46, 'QTDE');
  Rdp.Imp(linha, 57, 'VALOR');
  vtotprg := 0;
  buscas.first;
  while not buscas.eof do
  begin
    vtotprg := vtotprg + buscas.fieldbyname('VALOR').AsCurrency;
    buscas.next;
  end;
  vqtg := 0;
  vttg := 0;
  buscas.first;
  while not buscas.eof do
  begin
    linha := linha + 1;
    Rdp.Imp(linha, 1, buscas.fieldbyname('GRUPO_PROD').asstring + ' : ');
    Rdp.Imp(linha, 20, copy(buscas.fieldbyname('DESCRICAO').asstring, 1, 20));
    Rdp.Imp(linha, 42, vDadosIni.Alndir(format('%n', [buscas.fieldbyname('QTDE').ascurrency]), 8));
    Rdp.Imp(linha, 50, vDadosIni.Alndir(format('%n', [buscas.fieldbyname('VALOR').ascurrency]), 12));
