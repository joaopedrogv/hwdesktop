  buscas.sql.Text := 'SELECT S.STIPO, COALESCE(S.SEQ_REVISAO,0) AS SEQ_REVISAO, COUNT(*) AS QTDE,'+
    ' SUM(I.VALOR_TOT_SERV+I.RATEIO_ACRESC+I.PRC_INT_SERV-I.RATEIO_DESC) AS LIQUIDO '+
    ' FROM PEDVENDA_SERV I, PEDVENDA P, TIPO_SERVICO S  WHERE '+
    ' I.COD_SERVICO = S.COD_SERVICO AND I.NPED = P.NPED AND I.TIPO = P.TIPO AND '+
    ' I.COD_EMPRESA = P.COD_EMPRESA AND (I.STATUS IS NULL OR I.STATUS = '''') AND '+
    ' P.DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datainicial)) +
    ' AND P.DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', datafinal)) +
    ' AND P.COD_EMPRESA = ' + vDadosIni.CodEmpresa+
