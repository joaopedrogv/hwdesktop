procedure TRelatorioRecebimentosFinanceiro.verificarFimdeRegistros;
begin
  if (I = buscas.RecordCount) then
  begin
    ImprimirTotalDocumento;
    ImprimirTotalDiario;
    ImprimirControles;
    if not FiltrarPorTipo then
	    ImprimirControles(true);
  end;
end;

procedure TRelatorioRecebimentosFinanceiro.verificarTotais;
var
	vTipo: string;
begin
  if ((trim(buscas.FieldByName('TP_REL').AsString)) = 'CREDIARIO') then
  	 vTipo := 'CREDIARIO'
  else if ((trim(buscas.FieldByName('TP_REL').AsString)) = 'RECIBO ANTECIPADO') then
    vTipo := 'RECIBO ANTECIPADO'
  else
  	 vTipo := 'SAIDAS';

  if (trim(vTipo) <> '') and (vLote > 0) and (trim(vNumDoc) <> '') then
  begin
    ImprimirTotalDocumento;

    if ((trim(vDiaMov) <> '') and (trim(vDiaMov) <> FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DATA_CONF').AsDateTime)))
    	or ((trim(vTipoMov) <> '') and (trim(vTipoMov) <> trim(vTipo))) then
    begin
      ImprimirTotalDiario;
    end;
  end;
end;

