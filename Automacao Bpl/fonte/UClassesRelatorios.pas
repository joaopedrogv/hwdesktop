procedure TRelatorioRequisicoesOrdensDeServicosEmitidasPorPeriodo.ImprimeRelatorios;
var
  vtotl, vtoto, vtotp, vcort, vtotpT, vdesconto, vacrescimo: currency;
  vtotind: Double;
  vcond: string;
  it: Integer;
  buscas2: TIBQuery;
  vvalortotItem, vvalortotItemLiq, vtotfinanc: double;
  vTipoItem: string;
  vNDocTemp: Integer;
  vTpDocTemp: string;
begin

  if not vDadosIni.PesqPros('REL057', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
