  fTempRec.FieldDefs.Add('CONTROLE', ftString, 35, false);
  fTempRec.FieldDefs.Add('DOCS', ftString, 2, false);
  fTempRec.FieldDefs.Add('NAO_GERA_FINAN', ftString, 1, false);
  fTempRec.FieldDefs.Add('VALOR', ftFloat, 0, false);

  if fTempRec.Tag = 0 then
  try
    fTempRec.CreateDataSet;
    fTempRec.Tag := 1;
  except
  end;

  ftempOrigemRec := TClientDataSet.Create(nil);
  ftempOrigemRec.Close;
  ftempOrigemRec.FieldDefs.Clear;
  ftempOrigemRec.FieldDefs.Add('TIPO', ftString, 1, false);
  ftempOrigemRec.FieldDefs.Add('CONTROLE', ftString, 35, false);
  ftempOrigemRec.FieldDefs.Add('VALOR', ftFloat, 0, false);

  if ftempOrigemRec.Tag = 0 then
  try
    ftempOrigemRec.CreateDataSet;
    ftempOrigemRec.Tag := 1;
  except
  end;

  fTempRecTot := TClientDataSet.Create(nil);
  fTempRecTot.Close;
  fTempRecTot.FieldDefs.Clear;
  fTempRecTot.FieldDefs.Add('TIPO', ftString, 1, false);
  fTempRecTot.FieldDefs.Add('CONTROLE', ftString, 35, false);
  fTempRecTot.FieldDefs.Add('DOCS', ftString, 2, false);
  fTempRecTot.FieldDefs.Add('NAO_GERA_FINAN', ftString, 1, false);
  fTempRecTot.FieldDefs.Add('VALOR', ftFloat, 0, false);

  if fTempRecTot.Tag = 0 then
  try
    fTempRecTot.CreateDataSet;
    fTempRecTot.Tag := 1;
  except
  end;
end;

procedure TRelatorioPagamentosFinanceiro.ImprimeRelatorios;
var
  vEmp, vContas: boolean;
  vExibirInfCliente, vExibirTotInfCliente, vExibirInfRec, vExibirDadosRec, vExibirTotRec: boolean;
  vCodEmp: Integer;
  buscasEmp: TIBQuery;
  CodCliente: string;
  CpfCgcCliente: string;
  vtempSqlEmpresa, vtempSqlUnificada, vtempSqlCliente,  vtempSqlOrigControle : string;
  vtempSqlEmpresa2, vtempSqlUnificada2, vtempSqlCliente2, vtempSqlOrigControle2: string;
begin
  if not vDadosIni.PesqPros('REL060', 'IMPRIMIR', '', '',
     '', buscas, false) then
     Exit;
  inherited;

   buscasEmp := TIBQuery.Create(Application);
   buscasEmp.Database := buscas.Database;
   buscasEmp.Transaction := buscas.Transaction;

   vCodEmp := 0;

   AgruparEmpUnificada := trim(AgruparEmpUnificada);
   AgruparEmpUnificada := Copy(AgruparEmpUnificada, 1, 1);

   buscasEmp.Close;
   buscasEmp.SQL.Text := ' select cod_empresa, identificacao_emp, cgc_emp from empresa ' +
   	 ' where ';
   if ((AgruparEmpUnificada = 'S') and (CodEmpUnificada <= 0)) then
     buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' cod_empresa = ' + vDadosIni.codEmpresa
   else if (CodEmpUnificada > 0) then
     buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' cod_empresa = ' + IntToStr(CodEmpUnificada)
   else
   	 buscasEmp.SQL.Text := buscasEmp.SQL.Text + ' financeiro_unificado = ''S'' ' +
     	 ' and codigo_unificadora = ' + vDadosIni.codEmpresa;
   buscasEmp.Open;
   buscasEmp.FetchAll;

   if not vDadosIni.ModImp(Rdp) then
     exit;

   Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
   Rdp.TamanhoQteColunas := 133;
   Rdp.CaptionSetup := 'Configurações de Impressão';
   rdp.OpcoesPreview.CaptionPreview := 'Relatório de Pagamentos (Financeiro)';
   rdp.TitulodoRelatorio := 'Pagamentos (Financeiro)';
   vDadosIni._LimparVarSendEmail;
   rdp.OnSendMail := vDadosini._SendMailRdPrint;
   rdp.OpcoesPreview.Preview := true;

   if not Rdp.EstaAberto then
     Rdp.Abrir;
   vpag := 0;
//   vquant := 0;
   linha := 1;

   CabNovaPagina; //cabeçalho
   linha := linha - 1;
   buscasEmp.First;
   while not buscasEmp.Eof do
   begin
     I := 0;
     ftempOrigemRec.EmptyDataSet;
     fTempRec.EmptyDataSet;
     fTempRecTot.EmptyDataSet;

     vSeqId := 0;
     vInc := 0;
     vIncTemp := 0;
     vLoteTemp := 0;

     vEmp := false;
     vContas := false;
     
     vValorTotDoc := 0;
     vValorTotPag := 0;
     vValorTotRel := 0;
     vValorTotDia := 0;
     vValorRecPag := 0;
     vValorRecRel := 0;
     vValorRecDia := 0;

     vTotValorPagoLote     := 0;
     vTotValorPagoLoteOrig := 0;

     vDiaMov := '';
     vTipoMov := '';
     vTipoRec := '';
     vTipo := '';
     vNumDoc := '';

     vLote := 0;
     vInc := 0;
     vIncTemp := 0;
     vSeqId := 0;

     vExibirInfCliente := false;
     vExibirTotInfCliente := false;
     vExibirInfRec := false;
     vExibirDadosRec := false;

     try
       linha := linha + 1;
       vCodEmp := buscasEmp.FieldByName('COD_EMPRESA').AsInteger;
       abrePagamentosFinanceiro(AgruparEmpUnificada, CodEmpUnificada, vCodEmp);
       Screen.Cursor := crHourGlass;
       variavel_parar := false;
  //   if buscas.IsEmpty then
  //   begin
  //    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  //    exit;
  //   end;
       buscas.Open;
       buscas.FetchAll;

     finally
       Screen.Cursor := crDefault;
       frmRelatorios.ProgressBar.Position := 0;
       frmRelatorios.ProgressBar.Min := 0;
       frmRelatorios.ProgressBar.Max := buscas.RecordCount;
       buscas.First;
     end;
  //   ix := 0;
     vValorTotDoc := 0;
     vIncPrec := 0;
     vTipoRec := '';
     vLote := 0;
     vNumDoc := '';

     buscas.First;
     While not buscas.eof do
     begin
       Application.ProcessMessages;
       if variavel_parar then
       begin
         if confirmaparar then
         begin
  //         Parar;
           Exit;
         end;
       end;
       I := I + 1;

       vQtdePrestPag := 0;
		   vValorPagoPag := 0;
       if (trim(buscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS') then
       begin
         if (FiltrarCliente) or (FiltrarOrigControle)  then
         begin
           vtempSqlEmpresa  := ' and (case when(emp.financeiro_unificado = ''S'') then emp.codigo_unificadora else cp.codigo_emp end) = :codigo_emp ';
           vtempSqlEmpresa2 := ' and (case when(empresa.financeiro_unificado = ''S'') then empresa.codigo_unificadora else contas_a_pagar.codigo_emp end) = :codigo_emp ';

           if (trim(buscas.FieldByName('CPFCGC_CLIENTE').AsString) <> '') then
           begin
           	 vtempSqlCliente  := ' and cl.cpfcgc = :cpfcgc ';
             vtempSqlCliente2 := ' and clientes.cpfcgc = :cpfcgc ';
           end
           else
           begin
             vtempSqlCliente  := ' and cp.cod_forn_nfe = :cod_cliente ';
             vtempSqlCliente2 := ' and contas_a_pagar.cod_forn_nfe = :cod_cliente ';
           end;

           if ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
           begin
           	 vtempSqlUnificada  := ' and cp.cod_emp_mult = :cod_emp_mult ';
             vtempSqlUnificada2 := ' and contas_a_pagar.cod_emp_mult = :cod_emp_mult ';
           end
           else
           begin
             vtempSqlUnificada  := '';
             vtempSqlUnificada2 := '';
           end;

           if (FiltrarOrigControle) then
           begin
           	 vtempSqlOrigControle  := ' and cp.codigo_ctrl = :codigo_ctrl ';
             vtempSqlOrigControle2 := ' and contas_a_pagar.codigo_ctrl = :codigo_ctrl ';
           end
           else
           begin
             vtempSqlOrigControle  := '';
             vtempSqlOrigControle2 := '';
           end;

           if (FiltrarOrigControle) then
           begin
           	 vtempSqlOrigControle  := ' and cp.codigo_ctrl = :codigo_ctrl ';
             vtempSqlOrigControle2 := ' and contas_a_pagar.codigo_ctrl = :codigo_ctrl ';
           end
           else
           begin
             vtempSqlOrigControle  := '';
             vtempSqlOrigControle2 := '';
           end;

         	 buscas3.Close;
           buscas3.SQL.Text :=
             ' select ' +
             '    (select count(*) from contas_a_pagar cp ' +
             '		 left join empresa emp on cp.codigo_emp = emp.cod_empresa ' +
             '     left join clientes cl on ' +
             '		 	 cl.cod_cliente = cp.cod_forn_nfe ' +
             '			 and cl.cod_empresa = cp.cod_emp_mult ' +
             '     where cp.lote = :lote ' +
                   vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                      ' and cp.datq_ctp = :datq_ctp ', '') +
                   vtempSqlEmpresa +
                   vtempSqlCliente +
                   vtempSqlOrigControle +
                   vtempSqlUnificada +
             '    ) qtde_prest, ' +
             '    (case when coalesce((' +
             '        case when (coalesce((select contas_a_pagar.lote from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
             '               coalesce((select contas_a_pagar.valor_ctp from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) ' +
             '             else ' +
             '               (select sum(coalesce(contas_a_pagar.valor_pago, 0)) from contas_a_pagar ' +
             '								left join empresa on contas_a_pagar.codigo_emp = empresa.cod_empresa ' +
             '                left join clientes on ' +
             '									clientes.cod_cliente = contas_a_pagar.cod_forn_nfe ' +
             '									and clientes.cod_empresa = contas_a_pagar.cod_emp_mult ' +
             '                where contas_a_pagar.lote = :lote ' +
                              vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                ' and contas_a_pagar.datq_ctp = :datq_ctp ', '') +
                              vtempSqlEmpresa2 +
                              vtempSqlCliente2 +
                              vtempSqlOrigControle2 +
                              vtempSqlUnificada2 +
             '               ) ' +
             '        end), 0) <= 0 then ' +
             '        0 ' +
             '      else ' +
             '        ((coalesce( ' +
             '            (case when (coalesce((select contas_a_pagar.lote from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
             '                   coalesce((select contas_a_pagar.valor_ctp from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) ' +
             '                 else ' +
             '                   (select sum(coalesce(contas_a_pagar.valor_pago, 0)) from contas_a_pagar ' +
             '									  left join empresa on contas_a_pagar.codigo_emp = empresa.cod_empresa ' +
             '                    left join clientes on ' +
             '									    clientes.cod_cliente = contas_a_pagar.cod_forn_nfe ' +
             '									    and clientes.cod_empresa = contas_a_pagar.cod_emp_mult ' +
             '                    where contas_a_pagar.lote = :lote ' +
                                  vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                    ' and contas_a_pagar.datq_ctp = :datq_ctp ', '') +
                                  vtempSqlEmpresa2 +
                                  vtempSqlCliente2 +
                                  vtempSqlOrigControle2 +
                                  vtempSqlUnificada2 +
             '                   ) ' +
             '            end) , 0) / ' +
             '          coalesce( ' +
             '            (case when (coalesce((select contas_a_pagar.lote from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) <= 0) then ' +
             '                   coalesce((select contas_a_pagar.valor_ctp from contas_a_pagar where contas_a_pagar.cod_contrp = :cod_contrp and contas_a_pagar.codigo_emp = :cod_emp_orig), 0) ' +
             '                 else ' +
             '                   (select sum(coalesce(contas_a_pagar.valor_pago, 0)) from contas_a_pagar ' +
             '										left join empresa on contas_a_pagar.codigo_emp = empresa.cod_empresa ' +
             '                    left join clientes on ' +
             '									    clientes.cod_cliente = contas_a_pagar.cod_forn_nfe ' +
             '									    and clientes.cod_empresa = contas_a_pagar.cod_emp_mult ' +
             '                    where contas_a_pagar.lote = :lote ' +
                                  vDadosIni.IfThen((vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0),
                                    ' and contas_a_pagar.datq_ctp = :datq_ctp ', '') +
                                  vtempSqlEmpresa2 +
             '                   ) ' +
             '            end) , 0)) ' +
             '        ) ' +
             '     end ' +
             '    ) valor_pago from rdb$database ';

           buscas3.ParamByName('codigo_emp').AsInteger     := buscas.FieldByName('cod_empresa').AsInteger;
           buscas3.ParamByName('cod_contrp').AsInteger     := buscas.FieldByName('cod_contrp').AsInteger;
           buscas3.ParamByName('cod_emp_orig').AsInteger   := buscas.FieldByName('cod_emp_orig').AsInteger;

           if (FiltrarCliente) and (trim(buscas.FieldByName('cpfcgc_cliente').AsString) <> '') then
             buscas3.ParamByName('cpfcgc').AsString        := trim(buscas.FieldByName('cpfcgc_cliente').AsString)
           else if (FiltrarCliente) then
             buscas3.ParamByName('cod_cliente').AsInteger  := buscas.FieldByName('cod_cliente').AsInteger;

           if (FiltrarCliente) and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
             buscas3.ParamByName('cod_emp_mult').AsInteger := buscas.FieldByName('cod_emp_mult').AsInteger;

           if (FiltrarOrigControle)  then
             buscas3.ParamByName('codigo_ctrl').AsInteger  := buscas.FieldByName('cod_tipo').AsInteger;

           buscas3.ParamByName('lote').AsInteger           := buscas.FieldByName('loterec').AsInteger;

           if (vDadosIni.vEmp.vFinanceiroUnificado) and (buscas.FieldByName('data_conf').AsDateTime > 0) then
               buscas3.ParamByName('datq_ctp').AsDateTime      := buscas.FieldByName('data_conf').AsDateTime;

           buscas3.Open;

           if not buscas3.IsEmpty then
           begin
	           vQtdePrestPag := buscas3.FieldByName('qtde_prest').AsInteger;
					   vValorPagoPag := buscas3.FieldByName('valor_pago').AsCurrency * buscas.FieldByName('valor_pago').AsCurrency;
           end;
         end;
       end;

       if (vContas) and
        (((trim(vTipoRec) <> '') and (trim(vTipoRec) = 'PAGAMENTOS')) or
        ((trim(vTipoRec) = '') and (trim(buscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS'))) then
       begin
         if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           verificarTotais;
       end;

       if (trim(vTipoRec) <> '')
        and (trim(vTipoRec) <> trim(buscas.FieldByName('TP_REL').AsString)) then
       begin
         ImprimirControles;
       end;

       if (not vEmp) and ((AgruparEmpUnificada <> 'S') and (CodEmpUnificada <= 0)) then
       begin
         Rdp.ImpF(linha, 1, Copy(IntToStr(buscasEmp.FieldByName('COD_EMPRESA').AsInteger) +
         	' ' + trim(buscasEmp.FieldByName('IDENTIFICACAO_EMP').AsString), 1, 75), [normal, negrito]);
         linha := linha + 2;
         vEmp := true;
       end;  

