procedure TRelatorioVeiculosQueChegaramAntesDoPagamento.ImprimeRelatorios;
var
  vpagcont,vlveic: real;
  vlparc: real;
  itx,it: integer;
  vm,vn,vd: word;
  ResumoMes: TClientDataSet;
  vContaICMSVeiculo, vContaPISCOFINSVeiculo: Double;
begin
  if not vDadosIni.PesqPros('REL038', 'IMPRIMIR', '', '',
  '', buscas, false) then
   Exit;
  inherited;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Veículos que Chegaram Antes do Pagamento';
  rdp.TitulodoRelatorio := 'Relatório Veículos que Chegaram Antes do Pagamento';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  linha := 1;
  vpag := 0;

  vContaICMSVeiculo := 0;
  vContaPISCOFINSVeiculo := 0;

  buscas.Close;
  buscas.SQL.Text := ' SELECT FIRST 1 CONTA_ICM, CONTA_PIS FROM CONT_LIG ' +
    ' WHERE COD_EMP = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if not buscas.IsEmpty then
  begin
    vContaICMSVeiculo := buscas.FieldByName('CONTA_ICM').AsFloat;
    vContaPISCOFINSVeiculo := buscas.FieldByName('CONTA_PIS').AsFloat;
  end;

  ResumoMes := TClientDataSet.Create(nil);
  ResumoMes.Close;
  ResumoMes.FieldDefs.Clear;
  ResumoMes.FieldDefs.Add('ANO', ftInteger, 0, false);
  ResumoMes.FieldDefs.Add('MES', ftInteger, 0, false);
  ResumoMes.FieldDefs.Add('VALOR', ftFloat, 0, false);
  if ResumoMes.Tag = 0 then
  try
    ResumoMes.CreateDataSet;
    ResumoMes.Tag := 22;
  except
  end;

  ResumoMes.open;
  ResumoMes.IndexFieldNames:='ano;mes';
  buscas.close;
  buscas.SQL.Text := ' select it4.chassi,nf4.data_lanc, ' +
   ' (coalesce(it4.valor_total,0) - coalesce(it4.rateio_desconto,0) + coalesce(it4.rateio_seguro,0) ' +
   ' + coalesce(it4.rateio_outdesp,0) + case when nf4.frete_f_nfe = ''S'' then 0 else coalesce(it4.rateio_frete,0) end ' +
   ' + coalesce(it4.valor_ipi,0)) SOMA, ' +
  //  (it4.prec_cusm_prod-(it4.valor_icmsub+it4.piscofins)) SOMA, ' +
   ' nf4.num_nf from notafiscal nf4 ' +
   ' inner join notafiscal_item it4 on nf4.cod_nf=it4.cod_nf and nf4.cod_empresa=it4.cod_empresa ' +
   ' inner join notafiscal_item_veiculo itv4 on it4.cod_nf=itv4.cod_nf and it4.cod_empresa = itv4.cod_empresa and it4.chassi = itv4.chassi ' +
   ' inner join nat_op nat on nat.codigo_nop = it4.codigo_nop ' +
   ' where nf4.natureza_nf=''E'' and nf4.tipo_nf = ''V'' and nf4.data_lanc >= :vdat1 and nf4.data_lanc <= :vdat2 ' +
   ' and (nf4.status = ''Fechada'') ' +
   ' and (coalesce(nat.compra, '''') <> ''N'') ' +
// '  and (coalesce(nat.tipv_veiculo,'''') = ''V'') ' +
   ' and nf4.ativo=1 and nf4.cod_empresa = '+vDadosIni.codEmpresa+' order by 2 desc ';
  buscas.params[0].AsDate := datainicial;
  buscas.params[1].AsDate := datafinal;
  buscas.open;
  buscas.FetchAll;
  vpagcont := 0;
  vlveic:=0;
  rdp.impressora := Grafico;
  rdp.Abrir;
  vlparc := 0;
  linha := 1;
  vpag := 0;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina;
  frmRelatorios.ProgressBar.Position := 0;
  frmRelatorios.ProgressBar.Min := 0;
  frmRelatorios.ProgressBar.Max := buscas.RecordCount;
  buscas.First;
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
     end;
    end;
    buscas2.close;
    buscas2.SQL.Text := ' SELECT valor_ctp,chassi_conc,datq_ctp,data_venc_ctp,n_doc_ctp FROM contas_a_pagar ' +
     ' where num_nota_nfe = :vnum and n_conta_plc <> :n_conta_plc1 and n_conta_plc <> :n_conta_plc2 ' +
     ' and n_conta_plc <> 20 and codigo_emp = '+vDadosIni.codEmpresa+' order by n_doc_ctp ';
    buscas2.params[0].AsInteger := buscas.FieldByName('NUM_NF').AsInteger;
    buscas2.ParamByName('N_CONTA_PLC1').AsFloat := vContaICMSVeiculo;
    buscas2.ParamByName('N_CONTA_PLC2').AsFloat := vContaPISCOFINSVeiculo;
    buscas2.open;
    if buscas2.isempty then
    begin
      rdp.imp(linha, 1, trim(buscas.FieldByName('CHASSI').AsString));
      rdp.imp(linha, 22, vDadosIni.Alndir(format('%n', [buscas.FieldByName('SOMA').AsFloat]), 12));
      rdp.imp(linha, 36, trim(buscas.FieldByName('DATA_LANC').AsString));
      rdp.imp(linha, 48, trim(buscas2.FieldByName('DATQ_CTP').AsString));
      rdp.imp(linha, 60, trim(buscas2.FieldByName('DATA_VENC_CTP').AsString));
      rdp.imp(linha, 72, trim(buscas.FieldByName('NUM_NF').AsString));
      rdp.imp(linha, 86, vDadosIni.Alndir(format('%n', [buscas.FieldByName('SOMA').AsFloat]), 12));
      linha := linha + 1;
      vpagcont := vpagcont + buscas.FieldByName('SOMA').AsFloat;
      vlveic := vlveic + buscas.FieldByName('SOMA').AsFloat;
      vlparc := vlparc + buscas.FieldByName('SOMA').AsFloat;
      DecodeDate(buscas2.FieldByName('DATQ_CTP').AsDateTime,vn,vm,vd);
      if ResumoMes.FindKey([vn,vm]) then
      begin
         ResumoMes.edit;
         ResumoMes.FieldByName('VALOR').AsFloat := ResumoMes.FieldByName('VALOR').AsFloat + buscas.FieldByName('SOMA').AsFloat;
         ResumoMes.Post;
      end
      else
      begin
       ResumoMes.Append;
       ResumoMes.FieldByName('MES').AsInteger := vm;
       ResumoMes.FieldByName('ANO').AsInteger := vn;
       ResumoMes.FieldByName('VALOR').AsFloat := ResumoMes.FieldByName('VALOR').AsFloat + buscas.FieldByName('SOMA').AsFloat;
       ResumoMes.Post;
      end;
    end
    else
      it:=1;
      while not buscas2.eof do
      begin
       if ((buscas2.FieldByName('DATQ_CTP').AsDateTime > datafinal) and (buscas2.FieldByName('DATQ_CTP').AsDateTime <= dataReferencia)) or (buscas2.FieldByName('DATQ_CTP').IsNull) then
       begin
        rdp.imp(linha, 1, trim(buscas2.FieldByName('CHASSI_CONC').AsString));
        rdp.imp(linha, 22, vDadosIni.alndir(format('%n', [buscas2.FieldByName('VALOR_CTP').AsFloat]), 12));
        rdp.imp(linha, 36, trim(buscas.FieldByName('DATA_LANC').AsString));
        rdp.imp(linha, 48, trim(buscas2.FieldByName('DATQ_CTP').asstring));
        rdp.imp(linha, 60, trim(buscas2.FieldByName('DATA_VENC_CTP').AsString));
        rdp.imp(linha, 72, trim(buscas2.FieldByName('N_DOC_CTP').AsString));
        if it = 1 then
         rdp.imp(linha, 86, vDadosIni.Alndir(format('%n', [buscas.FieldByName('SOMA').AsFloat]), 12));
        linha := linha + 1;
        if linha = 65 then
        begin
         linha := 1;
         rdp.Novapagina;
        end;
         vpagcont := vpagcont + buscas2.FieldByName('VALOR_CTP').AsFloat;
        if it = 1 then
         vlveic := vlveic + buscas.FieldByName('SOMA').AsFloat;
        it:=it+1;
        if not buscas2.FieldByName('DATQ_CTP').IsNull then
        begin
         DecodeDate(buscas2.FieldByName('DATQ_CTP').AsDateTime,vn,vm,vd);
         if ResumoMes.FindKey([vn,vm]) then
         begin
          ResumoMes.Edit;
          ResumoMes.FieldByName('VALOR').AsFloat := ResumoMes.FieldByName('VALOR').AsFloat +buscas2.FieldByName('VALOR_CTP').AsFloat;
          ResumoMes.Post;
         end
         else
         begin
          ResumoMes.Append;
          ResumoMes.FieldByName('MES').AsInteger := vm;
          ResumoMes.FieldByName('ANO').AsInteger := vn;
          ResumoMes.FieldByName('VALOR').AsFloat := ResumoMes.FieldByName('VALOR').AsFloat +buscas2.FieldByName('VALOR_CTP').AsFloat;
          ResumoMes.Post;
         end;
        end
       end;
       buscas2.next;
      end;
    if linha = 65 then
    begin
      linha := 1;
      rdp.Novapagina;
    end;
    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    buscas.next;
  end;
  linha := linha + 1;
  rdp.imp(linha, 1, 'TOTAL GERAL: ' + vDadosIni.Alndir(format('%n', [vpagcont]), 12));
  linha := linha + 1;
  rdp.imp(linha, 1, 'TOTAL S/CHG: ' + vDadosIni.Alndir(format('%n', [vlparc]), 12));
  rdp.imp(linha, 86, vDadosIni.Alndir(format('%n', [vlveic]), 12));
  linha:=linha+2;
  rdp.imp(linha, 1, 'VALORES POR MES: ');
  linha:=linha+1;
  if linha >= 65 then
  begin
   linha := 1;
   rdp.Novapagina;
  end;
  ResumoMes.first;
  while not ResumoMes.Eof do
  begin
   rdp.imp(linha, 1, 'MES '+inttostr(ResumoMes.FieldByName('MES').AsInteger)+'/'+' ANO '+inttostr(ResumoMes.FieldByName('ANO').AsInteger)+':'+ vDadosIni.Alndir(format('%n', [ResumoMes.FieldByName('VALOR').AsFloat]), 12));
   linha:=linha+1;
   if linha >= 65 then
   begin
    linha := 1;
    rdp.Novapagina;
   end;
   ResumoMes.next;
  end;
  buscas.close;
  buscas2.close;
  ResumoMes.EmptyDataSet;
  ResumoMes.Close;
  rdp.Fechar;
  vDadosIni.GravaAuditoria('REL038', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

