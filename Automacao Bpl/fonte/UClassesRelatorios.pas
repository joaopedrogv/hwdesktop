  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;
  Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vnomeEmpresa), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vEndereco) + ' - ' + trim(vDadosIni.vEmp.vBairro) + ', ' +
    trim(vDadosIni.vEmp.vCidade) + ' CEP: ' + vDadosIni.vEmp.vCEP + 'FONE: ' +
    vDadosIni.vEmp.vTelefone + ' CGC: ' + vDadosIni.vEmp.vCNPJ, [comp17]);
