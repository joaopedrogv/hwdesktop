   if (trim(pBuscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS') and ((FiltrarCliente) or (FiltrarOrigControle)) then
   	 fTempRecTot.FieldByName('VALOR').AsFloat := fTempRecTot.FieldByName('VALOR').AsFloat + vValorPagoPag
   else if (trim(pBuscas.FieldByName('TP_REL').AsString) = 'PAGAMENTOS') and (vDadosIni.vEmp.vFinanceiroUnificado) and ((CodEmpUnificada > 0) or (AgruparEmpUnificada = 'N')) then
   	 fTempRecTot.FieldByName('VALOR').AsFloat := fTempRecTot.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO_PROP').AsCurrency
   else if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'TROCO' then
     fTempRecTot.FieldByName('VALOR').AsFloat := fTempRecTot.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO').AsCurrency
   else if pBuscas.FieldByName('VALOR_PAGO').AsCurrency > 0 then
	   fTempRecTot.FieldByName('VALOR').AsFloat := fTempRecTot.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO').AsCurrency;
