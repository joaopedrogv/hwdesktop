constructor TRelatoriosExtratoContaCorrenteProgFid.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrbuscas2);
  buscasGerais := TIBQuery(dtmRelatorios.qrBuscasGerais);

   //Faturamento
  ftempPeriodo := TClientDataSet.Create(nil);
  ftempPeriodo.Close;
  ftempPeriodo.FieldDefs.Clear;
  ftempPeriodo.FieldDefs.Add('ordem', ftInteger, 0, false);
  ftempPeriodo.FieldDefs.Add('data_venc_prog', ftTimeStamp, 0, false);
  ftempPeriodo.FieldDefs.Add('pontos', ftFloat, 0, false);
  ftempPeriodo.FieldDefs.Add('valor', ftFloat, 0, false);

  if ftempPeriodo.Tag = 0 then
  try
    ftempPeriodo.CreateDataSet;
    ftempPeriodo.Tag := 1;
  except
  end;

end;

procedure TRelatoriosExtratoContaCorrenteProgFid.ImprimeRelatorios;
var                                  
  vdata: string;
  buscas2: TIBQuery;
  totpontos, totvalor: Double;
  totpontosg, totvalorg: Double;
  totpontosv, totvalorv: Double;
  vok: boolean;
  I: integer;

  procedure imprimirdia;
  begin
    if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
     or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
      Rdp.ImpD(linha, 77, FormatFloat('#,##0', totpontos), [negrito])
    else
      Rdp.ImpD(linha, 77, FormatFloat('#,##0.00', RoundTo(totvalor, -2)), [negrito]);
    if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
      Rdp.ImpD(linha, 90, FormatFloat('#,##0.00', RoundTo(totvalor, -2)), [negrito]);
    linha := linha + 2;
    totpontos := 0;
    totvalor := 0;
  end;

begin
  if not vDadosIni.PesqPros('REL051', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  vok := false;
  variavel_parar := false;
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;
  totpontos := 0;
  totpontosv := 0;
  totpontosg := 0;
  totvalor := 0;
  totvalorv := 0;
  totvalorg := 0;

  if not abreExtratoContaCorrenteProgFid then //abre query buscas
      exit;
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Extrato Conta Corrente (Prog Fid)';
  rdp.TitulodoRelatorio := 'Extrato Conta Corrente (Prog Fid)';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;
  while not buscas.eof do
  begin
    if (trim(vdata) = '') or (trim(vdata) <> trim(buscas.FieldByName('data').AsString)) then
    begin
      if trim(vdata) <> '' then
        imprimirdia;
      vdata := buscas.FieldByName('data').AsString;
      Rdp.impF(linha, 1, buscas.FieldByName('data').AsString, [comp17, negrito]);
    end;

    Rdp.imp(linha, 13, Copy(trim(buscas.FieldByName('descricao').AsString), 1, 54));
    if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
     or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
      Rdp.impD(linha, 77, FormatFloat('#,##0', buscas.FieldByName('pontos').AsFloat), [])
    else
      Rdp.impD(linha, 77, FormatFloat('#,##0.00', RoundTo(buscas.FieldByName('valor').AsFloat, -2)), []);
    if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
      Rdp.impD(linha, 90, FormatFloat('#,##0.00', RoundTo(buscas.FieldByName('valor').AsFloat, -2)), []);
    if not FiltrarCliente then
      Rdp.Imp(linha, 92, trim(buscas.FieldByName('nome_cliente').AsString));
    totpontos := totpontos + buscas.FieldByName('pontos').AsFloat;
    totpontosg := totpontosg + buscas.FieldByName('pontos').AsFloat;
    totvalor := totvalor + RoundTo(buscas.FieldByName('valor').AsFloat, -2);
    totvalorg := totvalorg + RoundTo(buscas.FieldByName('valor').AsFloat, -2);
    linha := linha + 1;
    if linha >= 60 then
      CabNovaPagina;
    buscas.next;

    if buscas.Eof then
      imprimirdia;    
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TOTAL:', [comp17, negrito]);
  if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
   or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
    Rdp.ImpD(linha, 77, FormatFloat('#,##0', totpontosg), [negrito])
  else
    Rdp.ImpD(linha, 77, FormatFloat('#,##0.00', RoundTo(totvalorg, -2)), [negrito]);
  if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
    Rdp.ImpD(linha, 90, FormatFloat('#,##0.00', RoundTo(totvalorg, -2)), [negrito]);
  linha := linha + 1;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
  linha := linha + 1;
  
  if MediaVencimentos > 0 then
  begin
    buscas.Close;
    buscas.SQL.Text := ' select first ' + IntToStr(MediaVencimentos) + ' data_venc_prog, ' +
    	' coalesce(sum(case when (tipo = ''DÉBITO'') then (-1 * coalesce(pontos, 0)) else coalesce(pontos, 0) end), 0) pontos, ' +
      ' coalesce(sum(case when (tipo = ''DÉBITO'') then (-1 * coalesce(valor, 0)) else coalesce(valor, 0) end), 0) valor ' +
      ' from conta_corrente_prog_fidelidade ' +
      ' where data_venc_prog >= :data_ini and data_venc_prog <= :data_fim ' +
      ' and cod_empresa = :cod_empresa ' +
      ' group by 1 ' +
      ' order by 1 desc ';
    buscas.ParamByName('data_ini').AsDateTime := datainicial;
    buscas.ParamByName('data_fim').AsDateTime := datafinal;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    buscas.FetchAll;

    i := 0;
    ftempPeriodo.EmptyDataSet;
    buscas.First;
    while not buscas.Eof do
    begin
      Inc(I);
      ftempPeriodo.Insert;
      ftempPeriodo.FieldByName('ordem').AsInteger := I;
      ftempPeriodo.FieldByName('data_venc_prog').AsDateTime := buscas.FieldByName('data_venc_prog').AsDateTime;
      ftempPeriodo.FieldByName('pontos').AsInteger := buscas.FieldByName('pontos').AsInteger;
      ftempPeriodo.FieldByName('valor').AsFloat := buscas.FieldByName('valor').AsFloat;
      ftempPeriodo.Post;

      buscas.Next;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select first ' + IntToStr(MediaVencimentos) + ' data_venc_prog, ' +
   	' coalesce(sum(case when (tipo = ''DÉBITO'') then (-1 * coalesce(pontos, 0)) else coalesce(pontos, 0) end), 0) pontos, ' +
      ' coalesce(sum(case when (tipo = ''DÉBITO'') then (-1 * coalesce(valor, 0)) else coalesce(valor, 0) end), 0) valor ' +
      ' from conta_corrente_prog_fidelidade ' +
      ' where data_venc_prog > ' + vDadosIni.FusoSqlDate + 
      ' and cod_empresa = :cod_empresa ' +
      ' group by 1 ' +
      ' order by 1 asc ';
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    buscas.FetchAll;

    buscas.First;
    while not buscas.Eof do
    begin
      Inc(I);
      ftempPeriodo.Insert;
      ftempPeriodo.FieldByName('ordem').AsInteger := I;
      ftempPeriodo.FieldByName('data_venc_prog').AsDateTime := buscas.FieldByName('data_venc_prog').AsDateTime;
      ftempPeriodo.FieldByName('pontos').AsInteger := buscas.FieldByName('pontos').AsInteger;
      ftempPeriodo.FieldByName('valor').AsFloat := buscas.FieldByName('valor').AsFloat;
      ftempPeriodo.Post;

      buscas.Next;
    end;

    ftempPeriodo.IndexFieldNames := 'data_venc_prog';

    ftempPeriodo.First;
    if not ftempPeriodo.IsEmpty then
    begin
      if linha >= 56 then
        CabNovaPagina;
      Rdp.ImpF(linha, 1, 'VENCIMENTOS DO PERIODO:', [comp17, negrito]);
      linha := linha + 1;
      Rdp.ImpF(linha, 1, 'VENCIMENTO', []);
      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
       or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
        Rdp.ImpD(linha, 77, 'PONTOS', [])
      else
        Rdp.ImpD(linha, 77, 'VALOR', []);

      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
        Rdp.ImpD(linha, 90, 'VALOR', []);
      linha := linha + 1;
      Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
      linha := linha + 1;
    end;
    while not ftempPeriodo.Eof do
    begin
      if (not vok) and (ftempPeriodo.FieldByName('data_venc_prog').AsDateTime > Date) then
      begin
        vok := true;
        Rdp.ImpF(linha, 1, 'TOTAL:', [comp17, negrito]);
        if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
         or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
          Rdp.ImpD(linha, 77, FormatFloat('#,##0', totpontosv), [negrito])
        else
          Rdp.ImpD(linha, 77, FormatFloat('#,##0.00', RoundTo(totvalorv, -2)), [negrito]);
        if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
          Rdp.ImpD(linha, 90, FormatFloat('#,##0.00', RoundTo(totvalorv, -2)), [negrito]);
        linha := linha + 1;
        if ftempPeriodo.RecNo <> 1 then
        begin
          Rdp.impF(linha, 1, '**********', []);
          linha := linha + 1;
        end;
        totpontosv := 0;
        totvalorv := 0;
      end;

      Rdp.impF(linha, 1, ftempPeriodo.FieldByName('data_venc_prog').AsString, []);

      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
       or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
        Rdp.impD(linha, 77, FormatFloat('#,##0', ftempPeriodo.FieldByName('pontos').AsFloat), [])
      else
        Rdp.impD(linha, 77, FormatFloat('#,##0.00', RoundTo(ftempPeriodo.FieldByName('valor').AsFloat, -2)), []);
      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
        Rdp.impD(linha, 90, FormatFloat('#,##0.00', RoundTo(ftempPeriodo.FieldByName('valor').AsFloat, -2)), []);

      totpontosv := totpontosv + ftempPeriodo.FieldByName('pontos').AsFloat;
      totvalorv := totvalorv + RoundTo(ftempPeriodo.FieldByName('valor').AsFloat, -2);

      linha := linha + 1;
      if linha >= 60 then
        CabNovaPagina;

      ftempPeriodo.Next;
    end;
    if not ftempPeriodo.IsEmpty then
    begin
      Rdp.ImpF(linha, 1, 'TOTAL:', [comp17, negrito]);
      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
       or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
        Rdp.ImpD(linha, 77, FormatFloat('#,##0', totpontosv), [negrito])
      else
        Rdp.ImpD(linha, 77, FormatFloat('#,##0.00', RoundTo(totvalorv, -2)), [negrito]);
      if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A') then
        Rdp.ImpD(linha, 90, FormatFloat('#,##0.00', RoundTo(totvalorv, -2)), [negrito]);
      linha := linha + 1;
      Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
    end;
  end;
  buscas.close;
  ftempPeriodo.EmptyDataSet;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL051', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
  frmRelatorios.ProgressBar.Position := 0;
end;

