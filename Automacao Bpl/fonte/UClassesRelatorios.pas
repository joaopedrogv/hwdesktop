{ TRelatorioFinVendaModalidadePagReq }

function TRelatorioFinVendaModalidadePag.abreVendasModalidade: Boolean;
begin

  try
    Result := False;
    //Recebimentos por modalidade
    buscas.Close;
    buscas.SQL.Text := ' select ' +
    	' nome_ctrl, ' +
      ' nao_gera_finan, ' +
      ' exibir_resumo_financeiro, ' +
      ' sum(coalesce(valordoc, 0)) valordoc from ( ' +
    	' 	select c.nome_ctrl, ' +
    	' 	coalesce(c.nao_gera_finan, ''N'') nao_gera_finan, ' +
      ' 	coalesce(c.exibir_resumo_financeiro, ''S'') exibir_resumo_financeiro, ' +
    	' 	sum(coalesce(valordoc, 0)) as valordoc from formpagamento fp ' +
      ' 	left join controles c on fp.cod_controle = c.codigo_ctrl and fp.cod_empresa = c.codigo_emp ' +
      ' 	where fp.data_mov >= :dti ' +
      ' 	and fp.data_mov <= :dtf ' +
      ' 	and fp.cod_empresa = :cod_empresa ' +
      ' 	and fp.ativo = 1 ' +
      ' 	and coalesce(c.exibir_resumo_financeiro, ''S'') = ''S'' ' +
      ' 	and fp.recibo is null and fp.tpdocs <> ''TRC'' ' +
      ' 	group by 1, 2, 3 ' +
      ' 	union all ' +
      ' 	select ''RECIBO ANTECIPADO'' nome_ctrl, ' +
      ' 	coalesce(c.nao_gera_finan, ''N'') nao_gera_finan, ' +
      ' 	coalesce(c.exibir_resumo_financeiro, ''S'') exibir_resumo_financeiro, ' +
    	' 	sum(coalesce(valordoc, 0)) as valordoc from formpagamento fp ' +
      ' 	left join controles c on fp.cod_controle = c.codigo_ctrl and fp.cod_empresa = c.codigo_emp ' +
      ' 	where fp.data_mov >= :dti ' +
      ' 	and fp.data_mov <= :dtf ' +
      ' 	and fp.cod_empresa = :cod_empresa ' +
      ' 	and fp.ativo = 1 ' +
      ' 	and coalesce(c.exibir_resumo_financeiro, ''S'') = ''S'' ' +
      ' 	and fp.recibo is not null and fp.tpdocs <> ''LCS'' ' +
      ' 	group by 1, 2, 3 ' +
      ' 	union all ' +
      ' 	select c.nome_ctrl, ' +
    	' 	coalesce(c.nao_gera_finan, ''N'') nao_gera_finan, ' +
      ' 	coalesce(c.exibir_resumo_financeiro, ''S'') exibir_resumo_financeiro, ' +
    	' 	sum(coalesce(valordoc, 0)) as valordoc from formpagamento fp ' +
      ' 	left join controles c on fp.cod_controle = c.codigo_ctrl and fp.cod_empresa = c.codigo_emp ' +
      ' 	where fp.data_mov >= :dti ' +
      ' 	and fp.data_mov <= :dtf ' +
      ' 	and fp.cod_empresa = :cod_empresa ' +
      ' 	and fp.ativo = 1 ' +
      ' 	and coalesce(c.exibir_resumo_financeiro, ''S'') = ''S'' ' +
      ' 	and fp.tpdocs = ''TRC'' ' +
      ' 	group by 1, 2, 3) c ' +
      ' group by 1, 2, 3 ' +
      ' order by 1 ';
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
  except
  end;
end;

