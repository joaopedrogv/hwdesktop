procedure TRelatorioVendaVendedorComissaoServ.ImprimeRelatorios;
var
  pelomenos1: boolean;
  vlServ, vlComiss, vtmpComiss: Currency;
  nOS, nServ: string;
begin
  if not vDadosIni.PesqPros('REL014', 'IMPRIMIR', '', '', '', buscas, false) then
    Exit;
  inherited;

  pelomenos1 := false;
  dtSetColab.First;
  while not dtSetColab.eof do
  begin
    if frmRelatorios.DBGrid1.SelectedRows.CurrentRowSelected then
    begin
      pelomenos1 := true;
      Break;
    end;
    dtSetColab.Next;
  end;
  if not pelomenos1 then
  begin
    Application.MessageBox('Algum vendedor deve ser selecionado', 'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;
  vpag := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Vendas por Vendedor - Comissão por serviço';
  rdp.TitulodoRelatorio := 'Vendas por Vendedor - Comissão por serviço';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho

  vlServ := 0;
  vlComiss := 0;
  dtSetColab.First;
  while not dtSetColab.Eof do
  begin
    if frmRelatorios.DBGrid1.SelectedRows.CurrentRowSelected then
    begin
      buscas.close;
      buscas.sql.Text := ' select c.nome_vendedor,os.data_ped,os.data_fech,m.nped n_os,' +
        ' m.cod_servico,m.codigo_nop,sr.desc_serv_ped,sr.valor_tot_serv, m.per_comissao,' +
        ' ((m.per_comissao * sr.valor_tot_serv)/100) as valorcomissao ' +
        ' from colaborador c ' +
        ' inner join mecanico_os m on m.cod_vendedor = c.cod_vendedor and m.cod_empresa = c.cod_empresa ' +
        ' inner join pedvenda_serv sr on sr.cod_servico = m.cod_servico and sr.cod_empresa = m.cod_empresa ' +
        ' and sr.nped=m.nped and sr.tipo=m.tipo and sr.codigo_nop = m.codigo_nop ' +
        ' inner join pedvenda os on os.nped = sr.nped and os.cod_empresa = sr.cod_empresa and os.tipo=sr.tipo ';
        if FiltrarAreaExec then
          buscas.SQL.Text := buscas.SQL.Text  +
           ' inner join tipo_vendas tp on tp.tipo = os.tipo and (tp.sigla = os.tipv or (tp.tipo_os = os.tipo_os)) ';
      buscas.sql.Text := buscas.sql.Text + ' where os.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and c.cod_vendedor = ' + dtSetColab.FieldByName('COD_VENDEDOR').AsString;


      if ExibirDavORC then
      	buscas.sql.Text := buscas.sql.Text +
        	' and os.data_ped >= :dti and os.data_ped <= :dtf '
    	else if trim(OrdenarPor) = 'DATA FECHAMENTO' then
      	buscas.sql.Text := buscas.sql.Text +
        	' and os.data_fech >= :dti and os.data_fech <= :dtf '
      else
      	buscas.sql.Text := buscas.sql.Text +
        	' and os.data_ped >= :dti and os.data_ped <= :dtf ';

      if ExibirDavORC then
      	// Não fazer nada
      else if trim(StatusPed) = 'ABERTA' then
      	buscas.sql.Text := buscas.sql.Text + ' and coalesce(os.status_ped, '''') = '''' '
      else if trim(StatusPed) = 'FECHADA' then
        buscas.sql.Text := buscas.sql.Text + ' and os.status_ped = ''FECHADA'' ';

      if ExibirDavORC then
        buscas.sql.Text := buscas.sql.Text + ' and os.tipo = ''ORC'' and os.ORCPARAVND=''S'' '
      else
      begin
        buscas.sql.Text := buscas.sql.Text + ' and os.tipo = ''OS'' ';
        if FiltrarTipoOS then
          buscas.sql.Text := buscas.sql.Text + ' and os.tipo_os = ' + QuotedStr(trim(dtSetTipoOS.FieldByName('TIPO_OS').AsString));
      end;
      if FiltrarAreaExec then
        buscas.SQL.Text := buscas.SQL.Text + ' and trim(tp.area_exec) = ' + QuotedStr(trim(AreaExec));
      buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(os.status_ped, '''') <> ''CANCELADO'' ' +
      	' and (sr.status<>''CANCELADO'' or sr.status is null) ';
      buscas.sql.Text := buscas.sql.Text + ' order by m.n_os';
      buscas.ParamByName('dti').AsDate := datainicial;
      buscas.ParamByName('dtf').AsDate := datafinal;
      buscas.open;
      try
        Screen.Cursor := crHourGlass;
        variavel_parar := false;
        buscas.FetchAll;
      finally
        Screen.Cursor := crDefault;
        frmRelatorios.ProgressBar.Position := 0;
        frmRelatorios.ProgressBar.Min := 0;
        frmRelatorios.ProgressBar.Max := buscas.RecordCount;
        buscas.First;
      end;

      if not buscas.IsEmpty then
      begin
        Rdp.ImpF(linha, 1, 'Vendedor: ' + dtSetColab.FieldByName('COD_VENDEDOR').AsString + ' - ' + dtSetColab.FieldByName('NOME_VENDEDOR').AsString, [Negrito]);
        linha := linha + 2;
        if (linha + 4) >= 66 then
        begin
          CabNovaPagina;
          Rdp.ImpF(linha, 1, 'Vendedor: ' + dtSetColab.FieldByName('COD_VENDEDOR').AsString + ' - ' + dtSetColab.FieldByName('NOME_VENDEDOR').AsString, [Negrito]);
          linha := linha + 2;
        end;
      end;
      vtmpComiss := 0;
      while not buscas.eof do
      begin
        Application.ProcessMessages;
        if variavel_parar then
        begin
          if confirmaparar then
          begin
//            Parar;
            Exit;
          end;
        end;

        Rdp.imp(linha, 1, buscas.FieldByName('DATA_PED').AsString);
        Rdp.Imp(linha, 14, vDadosIni.StrZero(buscas.FieldByName('N_OS').AsInteger, 6));
        Rdp.Imp(linha, 24, buscas.FieldByName('DESC_SERV_PED').AsString);
        Rdp.ImpD(linha, 68, format('%n', [buscas.FieldByName('VALOR_TOT_SERV').asFloat]), [comp17]);
        Rdp.ImpD(linha, 82, format('%n', [buscas.FieldByName('PER_COMISSAO').AsFloat]), [comp17]);
        Rdp.impD(linha, 97, format('%n', [buscas.FieldByName('VALORCOMISSAO').AsFloat]), [comp17]);
        Rdp.imp(linha, 99, buscas.FieldByName('DATA_FECH').AsString);

        inc(linha);
        vlServ := vlServ + buscas.FieldByName('VALOR_TOT_SERV').AsFloat;
        vlComiss := vlComiss + buscas.FieldByName('VALORCOMISSAO').AsFloat;
        vtmpComiss := vtmpComiss + buscas.FieldByName('VALORCOMISSAO').AsFloat;
        buscas.next;
        if (linha + 4) >= 66 then
        begin
          CabNovaPagina;
          Rdp.ImpF(linha, 1, 'Vendedor: ' + dtSetColab.FieldByName('NOME_VENDEDOR').AsString, [Negrito]);
          linha := linha + 2;
        end;
        frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
      end;
      if not buscas.IsEmpty then
      begin
        Rdp.ImpF(linha, 49, 'Comissões........................: ', [comp17]);
        Rdp.ImpD(linha, 97, Format('%m', [vtmpComiss]), [comp17]);
        inc(linha);
        Rdp.Imp(linha, 1, vDadosIni.Replicate('-', 132));
        inc(linha);
      end;
    end;
    dtSetColab.Next;
  end;
  inc(linha);
  if (linha + 4) >= 66 then
    CabNovaPagina;
  Rdp.ImpF(linha, 1, 'Total de Serviços......:  ', [Negrito]);
  Rdp.ImpD(linha, 45, Format('%m', [vlServ]), [Negrito]);
  inc(linha);
  Rdp.ImpF(linha, 1, 'Total de Comissões.....:  ', [Negrito]);
  Rdp.ImpD(linha, 45, Format('%m', [vlComiss]), [Negrito]);
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL014', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.Position := 0;
  TForm(frmRelatorios.pnVendedores.Parent).ModalResult := IDOK;
end;

{ TRelatorioNotasEmitidasPorPeriodo }

function TRelatorioNotasEmitidasPorPeriodo.abreNotas: Boolean;
var
  i: integer;
begin
  try
    Result := False;
    //Notas emitidas por periodo
    if (Pos('AMBAS', Exibir) > 0) or (Pos('NFe', Exibir) > 0) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select nf4.natureza_nf,nf4.num_nf,nf4.serie,nf4.modelo_nf,nf4.codigo_nop,nt.descricao_nop,' +
        ' nf4.data_ent_saida,c.cod_cliente,c.nome_cliente,est.sigla_uf,nf4.valor_prod, ' +
        ' nf4.valor_total,nf4.base_icm,nf4.valor_icm,c.cpfcgc,c.insc_est,nf4.base_icm, ' +
        ' cp.desc_cond_pag,c.razao,nf4.valor_serv,nf4.valor_desc, ' +
        ' nf4.valor_desc_p,nf4.valor_desc_s,nf4.base_iss,nf4.valor_iss,nf4.base_icmsub,nf4.valor_icmsub, ''NF'' tipo_doc ' +
        ' from notafiscal nf4 ' +
        ' inner join nat_op nt on nf4.codigo_nop = nt.codigo_nop ' +
        ' inner join cond_pag cp on nf4.cod_cond_pag = cp.cod_cond_pag ' +
        ' inner join clientes c on nf4.cod_cliente = c.cod_cliente and nf4.cod_empresa = c.cod_empresa ' +
        ' inner join estados est on c.codigo_uf = est.codigo_uf ' +
        ' where nf4.data_contabil >= :dti ' +
        ' and nf4.data_contabil <= :dtf ' +
        ' and emissao_propria = ''S'' ' +
        ' and nf4.status = ''Fechada'' ' +
        ' and ((nf4.emissao_propria = ''S'' and nf4.modelo_nf = ''55'' and coalesce(nf4.situacao_nfe,'''') = ''Autorizada'' ) ' +
        ' 		  or (nf4.emissao_propria = ''S'' and nf4.modelo_nf <> ''55'') ' +
        '				or (nf4.emissao_propria = ''N'') ) ' +
        ' and nf4.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and nf4.ativo = 1 ';

      if FiltrarCFOP then
        buscas.SQL.Text := buscas.SQL.Text + ' and nf4.codigo_nop = :pCFOP ';

      if FiltrarTipoNF then
      begin
        if trim(TipoNF) = 'PRODUTOS/SERVICOS' then
          buscas.SQL.Text := buscas.SQL.Text + ' and nf4.tipo_nf = ''P'''
        else if trim(TipoNF) = 'VEICULOS' then
          buscas.SQL.Text := buscas.SQL.Text + ' and nf4.tipo_nf = ''V'''
        else if trim(TipoNF) = 'OUTRAS NOTAS' then
          buscas.SQL.Text := buscas.SQL.Text + ' and nf4.tipo_nf = ''O'''
        else if trim(TipoNF) = 'DESPESAS' then
          buscas.SQL.Text := buscas.SQL.Text + ' and nf4.tipo_nf = ''D''';
      end;
    end;

    if (Pos('AMBAS', Exibir) > 0) then
    	buscas.SQL.Text := buscas.SQL.Text +
      	' union ';

    if (Pos('AMBAS', Exibir) > 0) or (Pos('NFCe', Exibir) > 0) then
    begin
    	buscas.SQL.Text := vDadosIni.IfThen(Pos('AMBAS', Exibir) > 0, buscas.SQL.Text, '') +
        ' select ''S'' natureza_nf,nfc.num_nf,nfc.serie,nfc.modelo as modelo_nf,nfci.codigo_nop,nfci.descricao_nop, ' +
        ' nfc.data_lanc data_ent_saida,nfc.cod_cliente,c.nome_cliente,est.sigla_uf,nfci.valor_prod, ' +
        ' nfci.valor_total,nfci.base_icm,nfci.valor_icm,c.cpfcgc,c.insc_est,nfci.base_icm, ' +
        ' cp.desc_cond_pag,c.razao,nfci.valor_serv,nfci.valor_desc, ' +
        ' nfci.valor_desc_p,nfci.valor_desc_s,nfci.base_iss,nfci.valor_iss,nfci.base_icmsub,nfci.valor_icmsub, ''NFC'' tipo_doc ' +
        ' from nfce nfc ' +
        ' left join sp_nfce_tot(nfc.cod_nfce, nfc.cod_empresa) nfci on 1 = 1 ' +
        ' left join cond_pag cp on nfc.cod_cond_pag = cp.cod_cond_pag ' +
        ' left join clientes c on c.cod_cliente = nfc.cod_cliente and c.cod_empresa = nfc.cod_empresa ' +
        ' left join estados est on est.codigo_uf = c.codigo_uf ' +
        ' where nfc.status = ''Fechada'' and nfc.situacao_nfce = ''Autorizada'' ' +
        ' and nfc.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and nfc.data_lanc >= :dti ' +
        ' and nfc.data_lanc <= :dtf ';

      if FiltrarCFOP then
        buscas.SQL.Text := buscas.SQL.Text + ' and nfci.codigo_nop = :pCFOP ';
    end;

    if Trim(OrdenarPor) = 'CFOP' then
      buscas.SQL.Text := buscas.SQL.Text + ' order by 1,5,2,7 '
    else if Trim(OrdenarPor) = 'NUM NF' then
      buscas.SQL.Text := buscas.SQL.Text + ' order by 1,2,5,7 '
    else
      buscas.SQL.Text := buscas.SQL.Text + ' order by 1,7,5,2 ';


    ///*nf4.natureza_nf=''E'' and*/
    if FiltrarCFOP then
      buscas.Params.ParamByName('pCFOP').AsFloat := dtSetCFOP.FieldByName('CODIGO_NOP').AsFloat;
    buscas.Params.ParamByName('dti').AsDate := datainicial;
    buscas.Params.ParamByName('dtf').AsDate := datafinal;
    buscas.Open;
    if not (buscas.IsEmpty) then
      result := true;
//    else
//      Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
  except
  end;
end;

