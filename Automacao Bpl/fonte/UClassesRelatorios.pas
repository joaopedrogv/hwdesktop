  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 168), [comp20]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'CHASSI', [comp20]);
  Rdp.ImpF(linha, 20, 'MODELO', [comp20]);
  Rdp.ImpF(linha, 37, 'CLIENTE', [comp20]);
  Rdp.ImpF(linha, 69, 'DATA VENDA', [comp20]);
  Rdp.ImpF(linha, 80, 'NF VENDA', [comp20]);
  Rdp.ImpF(linha, 95, 'VALOR', [comp20]);
  Rdp.ImpF(linha, 101, 'VALOR REAL', [comp20]);
  Rdp.ImpF(linha, 117, 'CUSTO', [comp20]);
  Rdp.ImpF(linha, 123, 'TIPO', [comp20]);
  Rdp.ImpF(linha, 128, 'VENDEDOR', [comp20]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 168), [comp20]);
end;

constructor TRelatorioVeiculosNegociados.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrbuscas2);
end;

procedure TRelatorioVeiculosNegociados.ImprimeRelatorios;
var
  vquant, mversao: integer;
  Vtotv,vtotvr,vtotcst: currency;
  vperc: real;
  vtpmtu, vtpsatus: string;
begin
  if not vDadosIni.PesqPros('REL030', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 144;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de Veículos Negociados';
  rdp.TitulodoRelatorio := 'Veículos Negociados';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  abreVeiculosNegociados(1);
//  if buscas.IsEmpty then
//  begin
//   Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//   exit;
//  end;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  mversao := buscas.FieldByName('Codigo').AsInteger;
  linha := 1;
  vpag := 0;
  vtotv := 0.00;
  vtotvr:=0.00;
  vtotcst:=0.00;
  CabNovaPagina; //cabeçalho

//  if FiltrarTipoVenda then
//    if trim(TipoVenda) = 'USADO' then
//    begin
     vtpmtu := trim(buscas.FieldByName('estoque').AsString);
     vtpsatus := trim(buscas.FieldByName('tipo_venda_v').AsString);
     linha := linha + 1;
     if trim(buscas.FieldByName('tipo_venda_v').AsString) <> 'U' then
        rdp.Imp(linha, 1, '*** Estoque ***')
     else
     begin
     if trim(buscas.FieldByName('estoque').AsString) = 'P' then
       rdp.Imp(linha, 1, '*** Estoque ***')
     else
       if trim(buscas.FieldByName('estoque').AsString) = 'T' then
         rdp.Imp(linha, 1, '*** Estoque ***')
       else
         rdp.Imp(linha, 1, '*** Outras Concessionárias ***');
     end;
//     linha := linha + 1;
//    end;
  // Inicio da Impressão dos Itens.
  buscas.First;
  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;
//    if FiltrarTipoVenda then
//      if trim(TipoVenda) = 'USADO' then
         if ((vtpmtu <> trim(buscas.FieldByName('estoque').AsString))
           and (trim(buscas.FieldByName('tipo_venda_v').AsString) = 'U'))
          or (vtpsatus <> trim(buscas.FieldByName('tipo_venda_v').AsString)) then
        begin
          linha := linha + 2;
          if buscas.FieldByName('estoque').AsString = 'P' then
            rdp.Imp(linha, 1, '*** Estoque ***')
          else
            if buscas.FieldByName('estoque').AsString = 'T' then
              rdp.Imp(linha, 1, '*** Estoque ***')
            else
              rdp.Imp(linha, 1, '*** Outras Concessionárias ***');
          linha := linha + 1;
          vtpmtu := buscas.FieldByName('estoque').AsString;
           vtpsatus := buscas.FieldByName('tipo_venda_v').AsString;
         end;
//         else
//           linha := linha + 1;

    if mversao <> buscas.FieldByName('Codigo').AsInteger then
    begin
      linha := linha + 1;
      rdp.Imp(linha, 1, '**********');
      linha := linha + 1;
      mversao := buscas.FieldByName('Codigo').AsInteger;
    end
    else
      linha := linha + 1;
    rdp.Imp(linha, 1, trim(buscas.FieldByName('chassiv').asstring));
    rdp.Imp(linha, 20, copy(trim(buscas.FieldByName('descricao').AsString), 1, 15));
    rdp.Imp(linha, 37, vDadosIni.StrZero(buscas.FieldByName('clientes_v').AsInteger, 5));

    buscas1.close;
    buscas1.Sql.Text := ' select Nome_cliente from clientes where cod_cliente = :vcod ' +
     ' and cod_empresa = :cod_empresa and ativo = 1';
    buscas1.params[0].value := buscas.FieldByName('clientes_v').AsInteger;
    buscas1.params[1].value := vDadosIni.codEmpresa;
    buscas1.open;

    rdp.Imp(linha, 43, copy(trim(buscas1.FieldByName('NOME_CLIENTE').AsString), 1, 25));
    rdp.Imp(linha, 69, buscas.FieldByName('data_ven').asstring);
    rdp.Imp(linha, 80, vDadosIni.StrZero(buscas.FieldByName('num_nota_v').AsString, 5));
    rdp.Imp(linha, 90, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('prven_v').AsFloat]), 10));
    rdp.Imp(linha, 101, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('valor_real').AsFloat]), 10));
    rdp.Imp(linha, 112, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('custo').AsFloat]), 10));
    rdp.Imp(linha, 123, buscas.FieldByName('tipo_v').asstring);
    rdp.Imp(linha, 128, buscas.FieldByName('cod_vendedor').asstring);
    rdp.Imp(linha, 132, copy(buscas.FieldByName('nome_vendedor').AsString, 1, 12));
    Vtotv := Vtotv + buscas.FieldByName('prven_v').AsCurrency;
    Vtotvr := Vtotvr + buscas.FieldByName('VALOR_REAL').AsCurrency;
    Vtotcst:= Vtotcst+ buscas.FieldByName('CUSTO').AsCurrency;
    if linha >= 59 then
    begin
      linha := 1;
      CabNovaPagina;
    end;
    frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
    buscas.next;
  end;

  linha := linha + 1;
  rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 168), [comp20]);
  buscas.close;
  buscas1.close;

  abreVeiculosNegociados(2);

  linha := linha + 1;
  rdp.Imp(linha, 1, 'TOTAL DE PRODUTOS VENDIDOS: ');
  rdp.Imp(linha, 87, vDadosIni.Alndir(format('%n', [Vtotv]), 10));
  rdp.Imp(linha, 100, vDadosIni.Alndir(format('%n', [Vtotvr]), 10));
  rdp.Imp(linha, 114, vDadosIni.Alndir(format('%n', [Vtotcst]), 10));
  linha := linha + 1;
  rdp.Impf(linha, 1, 'MODELO', [negrito]);
  rdp.Impf(linha, 20, 'QTDE', [negrito]);
  rdp.Impf(linha, 29, 'TOTAL NF', [negrito]);
  rdp.Impf(linha, 43, 'TOTAL R', [negrito]);
  rdp.Impf(linha, 52, ' %REAL ', [negrito]);
  linha := linha + 1;
  vquant := 0;
  buscas.First;
  while not buscas.eof do
  begin
    rdp.imp(linha, 1, buscas.FieldByName('descricao').AsString);
    rdp.imp(linha, 20, vDadosIni.AlnDir(buscas.FieldByName('COUNT').AsString, 4));
    rdp.imp(linha, 28, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('SUM').AsFloat]), 10));
    rdp.imp(linha, 40, vDadosIni.AlnDir(format('%n', [buscas.FieldByName('valor_real').AsFloat]), 10));
    vperc := ((buscas.FieldByName('valor_real').AsFloat * 100) / vtotvr);
    rdp.imp(linha, 52, vDadosIni.AlnDir(format('%n', [vperc]), 6));
    Vquant := vquant + buscas.FieldByName('COUNT').AsInteger;
    linha := linha + 1;
    if linha >= 59 then
    begin
      linha := 1;
      CabNovaPagina;
      linha := linha + 1;
    end;
    buscas.next;
  end;
  rdp.imp(linha, 20, vDadosIni.AlnDir(inttostr(vquant), 4));
  rdp.Fechar;
  buscas.Close;
  buscas1.Close;

  linha := linha + 1;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  //    buscas.SQL.Clear;

  vDadosIni.GravaAuditoria('REL030', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

{ TRelatorioVeiculosemDemonstracao }

function TRelatorioVeiculosemDemonstracao.abreVeiculosemDemonstracao(
  vTp: Integer): Boolean;
begin
  if vTp = 1 then
  begin
    buscas.close;
    buscas.SQL.text := ' SELECT VN.COD_ESTMOTO, VN.CHASSIV,VN.DATA_VEN,VN.CLIENTES_V, VN.NUM_NOTA_V,VN.NOME_RECEB, ' +
     ' TPM.CODIGO,TPM.CILINDRADA,VN.SITUACAO, EST.PRECO_TABEST,TPM.DESCRICAO,TPM.ORDTIPO, VN.TIPO_VENDA_V, EST.NUM_NOTA, EST.PRECO_CUSTO FROM COM_FAT VN ' +
     ' INNER JOIN EST_MOTO EST ON EST.CODIGO = VN.COD_ESTMOTO AND EST.CHASSI_C = VN.CHASSIV AND EST.COD_EMPRESA = VN.COD_EMPRESA ' +
     ' INNER JOIN TIPMODELO TPM ON TPM.CODIGO = EST.VERSAOEST AND TPM.COD_EMPRESA = EST.COD_EMPRESA ' +
     ' WHERE VN.DATA_VEN >= :VDAT1 AND VN.DATA_VEN <= :VDAT2 ' +
     ' AND VN.NATUREZA = ''S'' AND (COALESCE(VN.TIPV_VEICULO, '''') = ''D'') ' +
     ' AND (COALESCE(TRIM(VN.STATUS_V), '''') = ''FECHADO'') AND (COALESCE(EST.STATUS_DEMONST, ''N'') = ''S'') ' +
     ' AND (COALESCE(TRIM(EST.POSICAO), ''VIVO'') <> ''MORTO'') ' +
     ' AND VN.COD_EMPRESA = :COD_EMPRESA AND VN.ATIVO = 1';
  end
  else
  begin
    buscas.close;
    buscas.SQL.text := ' SELECT VN.COD_ESTMOTO, VN.CHASSIV,VN.DATA_VEN,VN.CLIENTES_V, VN.NUM_NOTA_V,VN.NOME_RECEB, ' +
     ' TPM.CODIGO,TPM.CILINDRADA,VN.SITUACAO, EST.PRECO_TABEST,TPM.DESCRICAO,TPM.ORDTIPO, VN.TIPO_VENDA_V, EST.NUM_NOTA, EST.PRECO_CUSTO FROM COM_FAT VN ' +
     ' INNER JOIN EST_MOTO EST ON EST.CODIGO = VN.COD_ESTMOTO AND EST.CHASSI_C = VN.CHASSIV AND EST.COD_EMPRESA = VN.COD_EMPRESA ' +
     ' INNER JOIN TIPMODELO TPM ON TPM.CODIGO = EST.VERSAOEST AND TPM.COD_EMPRESA = EST.COD_EMPRESA ' +
     ' INNER JOIN NAT_OP NT ON NT.CODIGO_NOP = VN.NATOP_V ' +
     ' WHERE VN.DATA_VEN >= :VDAT1 AND VN.DATA_VEN <= :VDAT2 ' +
     ' AND VN.NATUREZA = ''S'' AND COALESCE(NT.FATURAMENTO, ''N'') = ''S'' ' + // and (coalesce(vn.tipv_veiculo, '''') <> ''T'') ' +
     ' AND (COALESCE(TRIM(UPPER(VN.STATUS_V)), '''') = ''FECHADO'') ' +
     ' AND VN.COD_EMPRESA = :COD_EMPRESA AND VN.ATIVO = 1';
  end;

  buscas.ParamByName('COD_EMPRESA').asstring:= vDadosIni.codEmpresa;
  buscas.ParamByName('vdat1').asdate := datainicial;
  buscas.ParamByName('vdat2').asdate := datafinal;

  if FiltrarTipoVenda then
   if trim(TipoVenda) <> '' then
   begin
     buscas.sql.text := buscas.sql.text + ' and vn.tipo_v = :vtp order by tpm.ordtipo,tpm.descricao,tpm.codigo,vn.data_ven ';
     buscas.ParamByName('vtp').AsString := trim(TipoVenda);
   end
   else
     buscas.sql.text := buscas.sql.text + ' order by tpm.ordtipo,tpm.descricao,tpm.codigo,vn.data_ven ';

  buscas.Open;
end;

