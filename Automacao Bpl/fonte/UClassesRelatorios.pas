   else if pBuscas.FieldByName('VALOR_PAGO').AsCurrency > 0 then
	   fTempRec.FieldByName('VALOR').AsFloat := fTempRec.FieldByName('VALOR').AsFloat + pBuscas.FieldByName('VALOR_PAGO').AsCurrency;
   fTempRec.Post;

//   fTempRecTot.Filter := 'TIPO = ''P'' ';

   if trim(pBuscas.FieldByName('TP_RECEBIMENTO2').AsString) = 'RECIBO' then
     fTempRecTot.Filter := 'CONTROLE = ''* RECIBO (APENAS INFORMATIVO)'' '
