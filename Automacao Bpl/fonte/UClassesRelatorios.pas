      Rdp.Imp(linha, 85, copy(buscas2.FieldByName('HISTORICO_C').AsString, 1, 31));
      Rdp.ImpD(linha, 126, format('%n', [buscas2.FieldByName('VL_BAIXA_COMISSAO').AsFloat]), [comp17]);
