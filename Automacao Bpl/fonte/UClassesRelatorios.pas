      else
        vlComissPart := vlComissPart + buscas.FieldByName('vl_comissao_vend').AsFloat;
      vlComiss := vlComiss + buscas.FieldByName('vl_comissao_vend').AsFloat;
      vtmpProdutos := vtmpProdutos + buscas.FieldByName('vltot_ped_item').AsFloat;
      vtmpComiss := vtmpComiss + buscas.FieldByName('vl_comissao_vend').AsFloat;

      ExibirParcela;
    end
    else
    	ExibirParcela;
      
    vNped := buscas.FieldByName('nped').AsInteger;
    vTipo := trim(buscas.FieldByName('tipo').AsString);
    vcod_tipo := buscas.FieldByName('cod_tipo').AsInteger;
    vcod_vendedor := buscas.FieldByName('cod_vendedor').AsInteger;
    vnomevendedor := trim(buscas.FieldByName('nome_vendedor').AsString);

    buscas.next;

    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;


