          ' left join estados est on est.codigo_uf = cl.codigo_uf ' +
          ' left join empresa emp on emp.cod_empresa = cp.cod_empresa ' +
          ' left join estados est1 on est1.codigo_uf = emp.uf_emp ' +
          ' left join nat_op nt on nt.codigo_nop = cp2.codigo_nop ' +
          ' left join produtos p on p.grupo_prod = cp2.grupo_prod and p.cod_prod = cp2.cod_prod and p.cod_empresa = cp2.cod_empresa ' +
          ' left join tipo_servico ts on ts.cod_servico = cp2.grupo_prod ' +
