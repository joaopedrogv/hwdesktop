function TRelatoriosdeRecibos.retornaValoBx(pNRecibo: integer): currency;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      buscasGerais.close;
      buscasGerais.SQL.Text := 'SELECT sum(valor_baixa) as vlbx FROM HIST_REC where data_baixa > :dtref ' +
        ' and data_baixa <= :dtbd and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1 ' +
        ' and (RECANT= ''S'' OR RECANT = ''O'') and nrecibo = ' + inttostr(pNRecibo) +
        ' and historico_rec like ''%PARCIAL%''';
      buscasGerais.ParamByName('dtref').AsDate := dataReferencia;
      buscasGerais.ParamByName('dtbd').AsDate := vDadosIni.getDataBanco(buscas1);
      buscasGerais.Open;
      result := buscasGerais.fieldbyname('vlbx').AsCurrency;
      buscasGerais.close;
    except
      result := 0;
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

{ TRelatoriosdeVendasObjetoCliente }

function TRelatoriosdeVendasObjetoCliente.abreVendasObjetoCliente: Boolean;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      Result := False;
      if FiltrarObjeto then
        FCodEquipamento := inttostr(dtSetObjeto.FieldByName('COD_EQUIP').AsInteger);
      //Entrada de notas emitidas por período
      buscas.Close;
      buscas.SQL.Text := 'select v.tipo,v.nped, vp.nitem,''P'' as prodserv, v.data_ped,' +
        ' v.data_fech,cl.cod_cliente,cl.nome_cliente,v.status_ped,v.cod_equip,v.valor_total,' +
        ' vp.descr_prod_ped as descrIt,vp.quant_ped_item as qtdItem, vp.vlun_ped_item  as vluItem ' +
        ' from pedvenda v inner join pedvenda_prod vp on v.nped = vp.nped and v.tipo=vp.tipo and ' +
        ' v.cod_empresa = vp.cod_empresa inner join clientes cl ' +
        ' on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
        ' where (vp.status<>''CANCELADO'' or vp.status is null) ' +
        ' and v.cod_empresa = ' + vDadosIni.codEmpresa;
      if ExibirVendaREQ and ExibirVendaOS then
      begin
        if FiltrarObjeto then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''REQ'') or (v.tipo=''OS'' and v.cod_equip=' + quotedstr(CodEqui) + '))'
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo<>''ORC'' ';
      end
      else if ExibirVendaREQ then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo=''REQ'' '
      else if ExibirVendaOS then
      begin
        if FiltrarObjeto then
          buscas.SQL.Text := buscas.SQL.Text + ' and ((v.tipo=''OS'' and v.cod_equip=' + CodEqui + ')) '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and v.tipo=''OS'' ';
      end;
      if FiltrarCliente then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
      if FiltrarData then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
      if StatusPed = 'ABERTA' then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
      else if StatusPed = 'FECHADA' then
        buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
      else
        buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

      if ExibirVendaOS then
      begin
        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo,v.nped,1 as nitem,''PT'' as prodserv, v.data_ped,v.data_fech, ' +
          ' cl.cod_cliente, cl.nome_cliente,v.status_ped,v.cod_equip, v.valor_total,vpt.descricao as descrIt,' +
          ' vpt.qtde as qtdItem, vpt.vl_unit as vluItem ' +
          ' from pedvenda v inner join pedvenda_prod_terc vpt on v.nped = vpt.nped and v.tipo=vpt.tipo ' +
          ' and v.cod_empresa = vpt.cod_empresa inner join clientes cl ' +
          ' on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
          ' where v.cod_empresa = ' + vDadosIni.codEmpresa + ' and v.tipo=''OS'' ';
        if FiltrarObjeto then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_equip=' + CodEqui;
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo,v.nped,vs.nitem,''S''  as prodserv,  v.data_ped,v.data_fech, cl.cod_cliente, ' +
          ' cl.nome_cliente, v.status_ped,v.cod_equip, v.valor_total,vs.desc_serv_ped as descrIt, ' +
          ' vs.quant_serv_ped as qtdItem, vs.valor_un_serv as vluItem ' +
          ' from pedvenda v inner join pedvenda_serv vs on v.nped = vs.nped and v.tipo=vs.tipo ' +
          ' and v.cod_empresa = vs.cod_empresa inner join clientes cl on v.cod_cliente = cl.cod_cliente ' +
          ' and v.cod_empresa = cl.cod_empresa ' +
          ' where (vs.status<>''CANCELADO'' or vs.status is null) ' +
          ' and v.cod_empresa = ' + vDadosIni.codEmpresa + ' and v.tipo=''OS'' ';
        if FiltrarObjeto then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_equip=' + quotedstr(CodEqui);
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';

        buscas.SQL.Text := buscas.SQL.Text + ' union ' +
          ' select v.tipo,v.nped,1 as nitem, ''ST''  as prodserv,  v.data_ped, v.data_fech, ' +
          ' cl.cod_cliente, cl.nome_cliente, v.status_ped,v.cod_equip, v.valor_total, ' +
          ' vst.descr_servt as descrIt, 1 as qtdItem, vst.vl_servt as vluItem ' +
          ' from pedvenda v inner join pedvenda_serv_terc vst ' +
          ' on v.nped = vst.nped and v.tipo=vst.tipo and v.cod_empresa = vst.cod_empresa ' +
          ' inner join clientes cl on v.cod_cliente = cl.cod_cliente and v.cod_empresa = cl.cod_empresa ' +
          ' where v.cod_empresa = ' + vDadosIni.codEmpresa + ' and v.tipo=''OS'' ';
        if FiltrarObjeto then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_equip=' + CodEqui;
        if FiltrarCliente then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.cod_cliente= ' + dtSetCliente.FieldByName('cod_cliente').AsString;
        if FiltrarData then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.data_ped >= :dti and v.data_ped <= :dtf ';
        if StatusPed = 'ABERTA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped<>''CANCELADO'' and (v.status_ped<>''FECHADA'' or (v.status_ped is null)) '
        else if StatusPed = 'FECHADA' then
          buscas.SQL.Text := buscas.SQL.Text + ' and v.status_ped=''FECHADA'' '
        else
          buscas.SQL.Text := buscas.SQL.Text + ' and (v.status_ped<>''CANCELADO'' or (v.status_ped is null)) ';
      end;
      if FiltrarData then
      begin
        buscas.Params.ParamByName('dti').AsDate := datainicial;
        buscas.Params.ParamByName('dtf').AsDate := datafinal;
      end;
      buscas.Open;
      if not (buscas.IsEmpty) then
        result := true;
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

procedure TRelatoriosdeVendasObjetoCliente.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;
  Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vnomeEmpresa), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'Relatório de Produtos e Serviços por Objeto / Cliente', [normal, negrito]);
  linha := linha + 1;
  if FiltrarData then
    Rdp.ImpF(linha, 1, 'No período de: ' + datetostr(datainicial) + ' A ' + datetostr(datafinal), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'No período de:   /  /     A    /  /    ', [normal, negrito]);
  linha := linha + 1;
  if StatusPed = 'ABERTA' then
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Aberto', [normal, negrito])
  else if StatusPed = 'FECHADA' then
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Fechado', [normal, negrito])
  else
  	Rdp.ImpF(linha, 1, 'Status REQ/OS: Ambos (Aberto / Fechado)', [normal, negrito]);
  linha := linha + 1;
  if FiltrarCliente then
  begin
    Rdp.ImpF(linha, 1, 'Cliente: ' + trim(dtSetCliente.FieldByName('NOME_CLIENTE').AsString), [normal, negrito]);
    linha := linha + 2;
  end;
  vpag := vpag + 1;
  Rdp.ImpF(linha, 1, 'Data/Hora: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  Rdp.ImpF(linha, 100, 'Pag: ' + vDadosIni.strzero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.Imp(linha, 2, 'Nº Venda');
  Rdp.Imp(linha, 12, 'Data');
  Rdp.Imp(linha, 28, 'Objeto / Cliente');
  Rdp.Imp(linha, 92, 'Status');
  Rdp.ImpD(linha, 132, 'Data Fechamento', []);
  linha := linha + 1;
  Rdp.Imp(linha, 34, 'Produto / Serviço');
  Rdp.Imp(linha, 86, 'Qtde');
  Rdp.Imp(linha, 100, 'Valor Unit');
  Rdp.ImpD(linha, 132, 'Valor Total Item', []);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
end;

constructor TRelatoriosdeVendasObjetoCliente.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  ExibirVendaOS := true;
  FiltrarObjeto := false;
  FiltrarData := true;
end;

procedure TRelatoriosdeVendasObjetoCliente.ImprimeRelatorios;
var
  condicao: boolean;
  totBruto, totLiq, totDesc, qtdeItens, valorItens, qtdeTotal, valorTotal, vrtot: currency;
  sqlComandos: TStringList;
  ndoc, tpImp: integer;
begin
  if not vDadosIni.PesqPros('REL021', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  if (not ExibirVendaREQ) and (not ExibirVendaOS) then
  begin
    Application.MessageBox('Selecione pelo menos um tipo de relatório. Venda Requisição ou Venda Ordem de Serviço', 'Informação', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  abreVendasObjetoCliente;//if not abreVendasObjetoCliente then //abre query buscas
//    exit;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de Produtos e Serviços por Objeto / Cliente';
  rdp.TitulodoRelatorio := 'Relatório de Produtos e Serviços por Objeto ou Cliente';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho

  totBruto := 0;
  totLiq := 0;
  totDesc := 0;
  qtdeTotal := 0;
  valorTotal := 0;
  tpImp := -1;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  while not buscas.Eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;

    qtdeItens := 0;
    valorItens := 0;
    vrtot := 0;
    ndoc := buscas.FieldByName('NPED').AsInteger;
    Rdp.impD(linha, 10, vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6), []);
    Rdp.imp(linha, 12, buscas.FieldByName('DATA_PED').AsString);
//    if FiltrarObjeto and (trim(buscas.FieldByName('TIPO').AsString) = 'OS') then
    Rdp.imp(linha, 28, trim(buscas.FieldByName('COD_EQUIP').AsString) + ' / ' + vDadosIni.StrZero(buscas.FieldByName('COD_CLIENTE').asInteger, 6) + '  ' + trim(buscas.FieldByName('NOME_CLIENTE').AsString));
//    else
//      Rdp.imp(linha, 28, ' / ' + vDadosIni.StrZero(buscas.FieldByName('COD_CLIENTE').asInteger, 6) + '  ' + trim(buscas.FieldByName('NOME_CLIENTE').AsString));
    Rdp.imp(linha, 92, buscas.FieldByName('STATUS_PED').AsString);
    Rdp.impD(linha, 132, buscas.FieldByName('DATA_FECH').AsString, []);
    while ndoc = buscas.FieldByName('NPED').AsInteger do
    begin
      linha := linha + 1;
      if linha > 63 then
      begin
        Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
        CabNovaPagina;
        Rdp.impD(linha, 10, vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6), []);
        Rdp.imp(linha, 12, buscas.FieldByName('DATA_PED').AsString);
        Rdp.imp(linha, 28, vDadosIni.StrZero(buscas.FieldByName('COD_CLIENTE').asInteger, 6) + '  ' + trim(buscas.FieldByName('NOME_CLIENTE').AsString));
        Rdp.imp(linha, 92, buscas.FieldByName('STATUS_PED').AsString);
        Rdp.impD(linha, 132, buscas.FieldByName('DATA_FECH').AsString, []);
        linha := linha + 1;
      end;
      Rdp.imp(linha, 30, buscas.FieldByName('prodserv').AsString);
      Rdp.imp(linha, 32, '-');
      Rdp.imp(linha, 34, Copy(trim(buscas.FieldByName('descrIt').AsString), 1, 51));
      Rdp.impD(linha, 90, Format('%n', [buscas.FieldByName('qtdItem').AsFloat]), []);
      Rdp.impD(linha, 110, format('%n', [buscas.FieldByName('vluItem').AsFloat]), []);
      Rdp.impD(linha, 132, format('%n', [buscas.FieldByName('vluItem').AsFloat * buscas.FieldByName('qtdItem').AsFloat]), []);
      qtdeItens := qtdeItens + buscas.FieldByName('qtdItem').AsFloat;
      valorItens := valorItens + (buscas.FieldByName('vluItem').AsFloat);
      vrtot := vrtot + (buscas.FieldByName('qtdItem').AsFloat * buscas.FieldByName('vluItem').AsFloat);
      buscas.Next;
      frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
      if buscas.Eof then
        Break;
    end;
    qtdeTotal := qtdeTotal + qtdeItens;
    valorTotal := valorTotal + vrtot;
    linha := linha + 1;
    Rdp.impD(linha, 90, Format('%n', [qtdeItens]), [Negrito]);
    Rdp.impD(linha, 132, format('%m', [vrtot]), [Negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 132), [comp17]);
    linha := linha + 1;
    if linha > 63 then
    begin
      Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
      CabNovaPagina;
    end;
  end;
  if linha + 5 > 63 then
  begin
    Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    CabNovaPagina;
  end;

  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.impf(linha, 1, 'Total..............................:', [Negrito]);
  Rdp.impD(linha, 90, Format('%n', [qtdeTotal]), [Negrito]);
  Rdp.impD(linha, 132, format('%m', [valorTotal]), [Negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
  vDadosIni.GravaAuditoria('REL021', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  buscas.close;

  if Rdp.EstaAberto then
    Rdp.Fechar;
  frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatorioApuracaoICMS }

function TRelatorioApuracaoICMS.abreApuracaoICMS(vNatureza, vTipo: string): Boolean;
var
  vNFAux, vCPAux, vNFSAux, vNFDAux, vFreteAux: string;
begin
  try
    Result := False;

    if TipoRelatorio = 'SINTÉTICO' then
    begin
      if vTipo = 'CFOP' then
      begin
    //Apuração ICMS por CFOP
        buscas.Close;
        buscas.SQL.Text := 'select ' +
          ' case when ((nfi.codigo_nop like ''1%'') or (nfi.codigo_nop like ''2%'') or (nfi.codigo_nop like ''3%'')) then  ''E''  else  ''S''  end NATUREZA, ' +
          ' 0 NUMDOC, 0 DATA, 0 SERIE, 0 MODELO, 0 COD_CLI, nfi.codigo_nop CFOP, ' +
          ' sum(coalesce(nfi.valor_total,0)) VALOR_TOTAL, sum(coalesce(nfi.valor_total,0) -' +
          ' (coalesce(nfi.rateio_desconto, 0) + coalesce(nfi.vpisdeson, 0) + coalesce(nfi.vcofinsdeson, 0) + iif(nf.totais_com_deson = ''N'', 0, coalesce(nfi.vicmdeson, 0)))' +
          ' + coalesce(nfi.rateio_seguro,0) + coalesce(nfi.rateio_outdesp,0) + case when nf.frete_f_nfe = ''S'' then 0 else coalesce(nfi.rateio_frete,0) ' +
          ' end + coalesce(case when (nfi.valor_icmsub_ant > 0) then 0 else nfi.valor_icmsub end,0) + coalesce(nfi.valor_ipi,0)) VALOR_LIQUIDO, ' +
          ' sum(coalesce(nfi.vloutras,0)) OUTRAS_DES, ' +
          ' (sum(coalesce(nfi.vlisento,0))  + sum(coalesce(nfi.vln_trib,0))) VALOR_ISENTO, ' +
          ' sum(iif(trunc(nfi.codigo_nop) in (5929,6929), 0, case when coalesce(nfi.base_icm, 0) > 0 then coalesce(nfi.base_icm, 0) else 0 end)) as BASE_ICM, ' +
          ' sum(iif(trunc(nfi.codigo_nop) in (5929,6929), 0, coalesce(nfi.valor_icm, 0))) VALOR_ICM, ' +
          ' sum(coalesce(nfi.valor_icmsub, 0)) VALOR_ICMSUB ' +
          ' from notafiscal nf' +
          ' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
          ' left join nat_op nt on nt.codigo_nop = nfi.codigo_nop ' +
          ' left join nbm on nbm.cod_ncm = nfi.ncm ' +
          ' left join clientes cl on cl.cod_cliente = nf.cod_cliente and cl.cod_empresa = nf.cod_empresa ' +
          ' left join estados est on est.codigo_uf = cl.codigo_uf ' +
