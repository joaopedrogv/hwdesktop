  Rdp.ImpF(linha, 15, 'COD', [negrito]);
  Rdp.ImpF(linha, 22, 'CLIENTE', [negrito]);
  Rdp.ImpF(linha, 61, 'CIDADE', [negrito]);
  Rdp.ImpF(linha, 83, 'DT.EMISSAO', [negrito]);
  Rdp.ImpF(linha, 95, 'DT.VENCTO', [negrito]);
  Rdp.ImpD(linha, 116, 'VALOR', [negrito]);
  Rdp.ImpF(linha, 118, 'DT.RECEB', [negrito]);
