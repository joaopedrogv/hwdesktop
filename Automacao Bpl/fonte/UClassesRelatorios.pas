function TRelatorioRecebimentosCaixaAuxiliar.abreRecebimentosCaixaAuxiliar(
  pAgruparEmpUnificada: string; pCodEmpUnificada,
  pCodEmpresa: Integer): Boolean;
var
	CpfCgcCliente: string;
begin
	if FiltrarCliente then
  begin
  	 CpfCgcCliente := '';

	 buscas.Close;
   buscas.SQL.Text := ' select cod_cliente, cpfcgc from clientes ' +
      ' where cod_cliente = :cod_cliente ' +
      ' and cod_empresa = :cod_empresa ';
    buscas.ParamByName('cod_cliente').AsInteger := StrToInt(Cliente);
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

	  CpfCgcCliente := trim(buscas.FieldByName('cpfcgc').AsString);
  end;

	buscas.Close;
  buscas.SQL.Text := ' select ' +
  	' rec.cod_empresa, ' +
    ' rec.cod_emp_mult, ' +
    ' rec.cod_cliente, ' +
    ' rec.nome_cliente, ' +
    ' rec.cpfcgc_cliente, ' +
    ' rec.tp_recebimento, ' +
    ' rec.tp_recebimento2, ' +
    ' rec.ordem, ' +
    ' rec.cod_tipo, ' +
    ' rec.tipo, ' +
    ' rec.cod_cred, ' +
    ' rec.num_doc, ' +
    ' rec.num_doc2, ' +
    ' rec.dia_cxl, ' +
    ' rec.op_cxl, ' +
    ' rec.nome_op_cxl, ' +
    ' rec.data_doc, ' +
    ' rec.data_conf, ' +
    ' rec.valor_a_receber, ' +
    ' rec.obs_cxl, ' +
    ' rec.loterec, ' +
    ' rec.op_cxl, ' +
    ' rec.cod_us, ' +
    ' rec.data_mov, ' +
    ' rec.historico, ' +
    ' rec.valor_pago, ' +
    ' rec.data_venc, ' +
    ' rec.terceiros, ' +
    ' rec.codigo_ctrl, ' +
    ' rec.nome_ctrl, ' +
    ' rec.num_recibo, ' +
    ' rec.valor_recibo, ' +
    ' rec.ncupom, ' +
    ' rec.num_nf, ' +
    ' rec.parcela, ' +
    ' rec.seqid, ' +
    ' rec.seqid2, ' +
    ' rec.venda, ' +
    ' rec.tipv, ' +
    ' rec.tipo_doc, ' +
    ' rec.qtde_prest, ' +
  	' ctr.docs, ' +
    ' ctr.nao_gera_finan, ' +
    ' rec.cod_empresa, ' +
    ' rec.cod_emp_mult from recebimentos5 rec ' +
    ' left join controles ctr on ctr.codigo_ctrl = rec.codigo_ctrl and ctr.codigo_emp = rec.cod_empresa ' +
    ' where rec.dia_cxl >= :dti and rec.dia_cxl <= :dtf ';
  if ((pAgruparEmpUnificada = 'S') and (pCodEmpUnificada <= 0)) then
    buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_empresa = :cod_empresa '
  else
  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_emp_mult = :cod_empresa ';

  if FiltrarVenda then
	  buscas.SQL.Text := buscas.SQL.Text + ' and rec.venda = ' + QuotedStr(vDadosIni.IfThen(trim(Venda) = 'SIM', 'S', 'N'));

  if FiltrarPorTipo then
  	if trim(PorTipo) = 'VEICULOS' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''VEICULOS'' '
  	else if trim(PorTipo) = 'ECOMMERCE' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''ECOMMERCE'' '
    else if trim(PorTipo) = 'BALCAO' then
      buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''BALCAO'' '
    else if trim(PorTipo) = 'SERVICOS' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''SERVICOS'' '
    else if trim(PorTipo) = 'RECIBO ANTECIPADO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''RECIBO ANTECIPADO'' '
    else if trim(PorTipo) = 'LANCAMENTO AVULSO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''LANCAMENTO AVULSO'' '
    else if trim(PorTipo) = 'PRESTACOES' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_recebimento = ''PRESTACOES'' ';

  if FiltrarCliente then
  	if (trim(CpfCgcCliente) <> '') then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cpfcgc_cliente = ' + QuotedStr(CpfCgcCliente)
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_cliente = ' + Cliente;

  if FiltrarOrigControle then
  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_tipo = ' + OrigControle;

  if FiltrarControle then
  begin
  	if trim(NomeControle) = 'RECIBO ANTECIPADO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.tp_recebimento2) = ''RECIBO'' '
    else if trim(NomeControle) = 'DEVOLUCAO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.tp_recebimento2) = ''DEVOLUCAO'' '
    else if trim(NomeControle)= 'CONTAS A PAGAR' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.nome_ctrl) = ''CONTAS A PAGAR'' '
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.codigo_ctrl = ' + Controle;
  end;

  if trim(Exibir) = 'QUITADOS' then
    buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(rec.codigo_ctrl, 0) > 0 '
  else if trim(Exibir) = 'NAO QUITADOS' then
    buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(rec.codigo_ctrl, 0) = 0 ';

  buscas.SQL.Text := buscas.SQL.Text +
    ' order by rec.dia_cxl, rec.cod_emp_mult, rec.nome_op_cxl, rec.ordem, rec.data_conf, rec.tipo, rec.loterec, rec.num_doc, rec.seqid, rec.valor_a_receber desc, rec.tp_recebimento, rec.nome_ctrl, rec.parcela ';
  buscas.Params.ParamByName('dti').AsDate := Fdatainicial;
  buscas.Params.ParamByName('dtf').AsDate := Fdatafinal;
  buscas.Params.ParamByName('cod_empresa').AsInteger := pCodEmpresa;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.CabNovaPagina;
begin
	if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO RECEBIMENTOS CAIXA AUXILIAR - MOVIMENTAÇÃO DA EMPRESA POR DIA ', [normal, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);

  if trim(PorTipo) <> 'TODOS' then
  begin
  	linha := linha + 1;
    Rdp.ImpF(linha, 1, 'TIPO: ' + PorTipo, [negrito]);
  end;
  
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TIPO DE RELATÓRIO: ' + TipoRelatorio, [negrito]);

  if (vDadosIni.vEmp.vFinanceiroUnificado) then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CODIGO EMPRESA UNIFICADA (0 - TODAS): ' +
    	vDadosIni.IfThen(CodEmpUnificada > 0, IntToStr(CodEmpUnificada), '0'), [negrito]);
    Rdp.ImpF(linha, 45, 'AGRUPAR EMPRESAS UNIFICADAS: ' +
    	vDadosIni.IfThen(AgruparEmpUnificada = 'S', 'SIM', 'NAO'), [negrito]);
  end;

  if FiltrarCliente then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CLIENTE: ' + trim(NomeCliente), [negrito]);
  end;

  if FiltrarOrigControle then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'ORIGEM: ' + trim(NomeOrigControle), [negrito]);
  end;

  if FiltrarControle then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CONTROLE: ' + trim(NomeControle), [negrito]);
  end;

  vpag := vpag + 1;
  Rdp.ImpD(linha, 126, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  if trim(TipoRelatorio) = 'ANALÍTICO' then
  begin
  	linha := linha + 2;
    Rdp.Imp(linha, 1, 'NUM.VND');
    Rdp.Imp(linha, 13, 'TIPO');
    Rdp.Imp(linha, 21, 'CLIENTE');
    Rdp.Imp(linha, 68, 'NFCE');
    Rdp.Imp(linha, 81, 'NF');
    Rdp.Imp(linha, 93, 'VALOR TOTAL');
    Rdp.imp(linha, 109, 'DATA CXL');
    Rdp.imp(linha, 123, 'STATUS');
  end;
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 133), [comp17, negrito]);
  linha := linha + 1;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.ChecarFimdePagina(
  fimpagina: boolean);
begin
 	 if (linha >= 60) then
   begin
     linha := 2;
     CabNovaPagina;
   end;

	 if not fimpagina then
   	exit;
   if (linha >= 58) or (fimpagina) then
   	ImprimirTotalPagina;
end;

