procedure TRelatorioVendaProdutosBalcaoParticipante.MenuTotais;
begin
  with dtmRelatorios do
  begin
    if (TotalProduto = 'SIM') or (TotalGrupo = 'SIM') then
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', 150))
    else
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', 132));
    linha := linha + 1;
    Rdp.Impf(linha, 1, 'DADOS GERAIS', [comp17, negrito]);
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'TOTAL VENDA(R$).........: ' + vDadosIni.AlnDir(format('%n', [vvalortotal]), 12));
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'TOTAL DESCONTO(R$)......: ' + vDadosIni.AlnDir(format('%n', [vdesconto]), 12));
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'TOTAL LIQUIDO(R$).......: ' + vDadosIni.AlnDir(format('%n', [vvalorLiquido]), 12));
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'TOT.CUSTO MED. CONT(R$).: ' + vDadosIni.AlnDir(format('%n', [vcustContabil]), 12));
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'LUCRO BRUTO(R$).........: ' + vDadosIni.AlnDir(format('%n', [vLucroBruto]), 12));
    linha := linha + 1;

    if vCustContabil <> 0 then
    begin
      Rdp.Imp(linha, 1, 'MARK UP FATURAMENTO ....: ' + vDadosIni.AlnDir(format('%0.4f', [((vvalortotal - vdesconto) - vcustContabil) / vcustContabil]), 12));
      linha := linha + 1;
    end;

    Rdp.Imp(linha, 1, 'MARGEM LUCRO(%).........: ' + vDadosIni.AlnDir(format('%n', [(((vvalortotal - vdesconto) - vcustContabil) / vvalortotal) * 100]), 12));
    linha := linha + 1;
    Rdp.Imp(linha, 1, 'QUANTIDADE REQUISICOES...:      ' + vDadosIni.strzero(CurrToStr(vQuantRequisicao), 6));
    linha := linha + 1;

    if vComissaoF <> 0 then
    begin
      Rdp.Imp(linha, 1, 'COMISSAO FUNCIONARIO PR.: ' + vDadosIni.AlnDir(format('%n', [vComissaoF]), 12));
      linha := linha + 1;
    end;

    if vComissaoG <> 0 then
    begin
      Rdp.Imp(linha, 1, 'COMISSAO GERENTE PRODUTO: ' + vDadosIni.AlnDir(format('%n', [vComissaoG]), 12));
      linha := linha + 1;
    end;
  end;
end;

procedure TRelatorioVendaProdutosBalcaoParticipante.Parar;
begin
  frmRelatorios.BitBtn1.Enabled := True;
  frmRelatorios.BitBtn2.Enabled := True;
  frmRelatorios.BitBtn3.Enabled := False;
end;

function TRelatorioVendaProdutosBalcaoParticipante.RelVendasBalcao: Boolean;
begin
  try
    result := false;
    if TipoRelatorio = 'ANALÍTICO' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select vp.nped, vp.grupo_prod, vp.cod_prod, vp.descr_prod_ped, ' +
        ' vp.vltot_ped_item,vp.rateio_desc, vp.vlun_ped_item,vp.pcust_mc,vp.quant_ped_item, ' +
        ' ((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-(vp.rateio_desc)+(vp.rateio_acresc)) as lucro,' +
        ' vp.comiss_prod,vp.comiss_prod_ger,vp.desc_funcao ' +
        ' from vendaprodutos vp ' +
        '	where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
      	if (trim(CodVendedor) = '') or (trim(CodVendedor) = '(0)')  then
        	buscas.SQL.Text := buscas.SQL.Text + ' and vp.cod_participante is null'
        else
        	buscas.SQL.Text := buscas.SQL.Text + ' and vp.cod_participante in ' + CodVendedor;

      if FiltrarGrupo then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      if OrdenarPor = 'NUM PEDIDO' then
	      buscas.SQL.Text := buscas.SQL.Text + ' order by 1,2,3 '
      else if OrdenarPor = 'CODPRODUTO' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 3, 1 '
      else if OrdenarPor = 'DESCRICAO' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 4, 1, 2, 3 '
      else if OrdenarPor = 'GRUPO E CODIGO' then
        buscas.SQL.Text := buscas.SQL.Text + ' order by 2, 3, 1 ';
      buscas.Params.ParamByName('dti').AsDate := datainicial;
      buscas.Params.ParamByName('dtf').AsDate := datafinal;
      buscas.Open;
      buscas.FetchAll;
//      if buscas.IsEmpty then
//      begin
//        result := False;
//        exit;
//      end;
	  end;

    // Dados Gerais
    buscas1.Close;
    buscas1.SQL.text := 'select ';

    if (FiltrarVendedor) and (Pos(',', CodVendedor) <= 0) then
	   	buscas1.SQL.text := buscas1.SQL.text + ' vp.desc_funcao, ';

    buscas1.SQL.text := buscas1.SQL.text +
    	' count(distinct(vp.nped)) as qtdRequisicao,' +
      ' sum(vp.vltot_ped_item+vp.RATEIO_ACRESC) as TotalValor,sum(vp.rateio_desc) as TotalDesc,sum(vp.rateio_acresc) as TotalAcresc,' +
      ' sum(vp.vltot_ped_item-vp.rateio_desc+vp.RATEIO_ACRESC) as TotalLiquido,sum(vp.quant_ped_item*vp.pcust_mc) as TotalCMC, ' +
      ' sum(((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-(vp.rateio_desc)+(vp.rateio_acresc))) as Totallucro, ' +
//      ' ((sum(((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-' +
//      '(vp.rateio_desc)+(vp.rateio_acresc)))/(case when sum(vp.pcust_mc)=0 then 1 else sum(vp.quant_ped_item*vp.pcust_mc) end ))*100) as markup, ' +
      ' ((sum(((vp.quant_ped_item * vp.vlun_ped_item)- ' +
      '(vp.rateio_desc)+(vp.rateio_acresc)))/(case when sum(vp.pcust_mc)=0 then 1 else sum(vp.quant_ped_item*vp.pcust_mc) end ))) as markup, ' +
      ' sum(vp.comiss_prod) as comiss_prod, sum(vp.comiss_prod_ger) as comiss_prod_ger ' +
      ' from vendaprodutos vp ' +
      ' where vp.data_fech >= :dti ' +
      ' and vp.data_fech <= :dtf ' +
      ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and vp.tipo = ''REQ'' ';

    if FiltrarTipoVenda then
      buscas1.SQL.Text := buscas1.SQL.Text + 'and vp.tipv = ' + QuotedStr(trim(TipoVenda))
    else
      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.venda = ''S'' ';

    if ObRel.FiltrarGrupo then
      buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

    if FiltrarVendedor then
    begin
    	if (trim(CodVendedor) = '') or (trim(CodVendedor) = '(0)') then
      	buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_participante is null '
      else
      	buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_participante in ' + CodVendedor;

//      buscas1.SQL.Text := StringReplace(buscas1.SQL.Text, 'from', ',vp.desc_funcao from ', [rfReplaceAll, rfIgnoreCase]);
//      if (trim(CodVendedor) = '') or (trim(CodVendedor) = '(0)') then
//      	buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_participante is null group by vp.desc_funcao'
//      else
//      	buscas1.SQL.Text := buscas1.SQL.Text + ' and vp.cod_participante in ' + CodVendedor + ' group by vp.desc_funcao';
    end;

    if (FiltrarVendedor) and (Pos(',', CodVendedor) <= 0) then
	    buscas1.SQL.text := buscas1.SQL.text + ' group by 1 ';

    buscas1.Params.ParamByName('dti').AsDate := datainicial;
    buscas1.Params.ParamByName('dtf').AsDate := datafinal;
    buscas1.Open;
//    if buscas1.IsEmpty then
//      exit;

    // Total por Produto
    if TotalProduto = 'SIM' then
    begin
      buscas2.Close;
      buscas2.SQL.text := 'select vp.grupo_prod, vp.cod_prod, pr.descr_prod as descr_prod_ped, ' +
        ' sum(vp.vltot_ped_item - vp.rateio_desc + vp.RATEIO_ACRESC) as totalItem, ' +
        ' sum(vp.quant_ped_item) as qtdItem, ' +
        ' sum(vp.RATEIO_DESC) RATEIO_DESC, ' +
        ' sum(vp.pcust_mc * vp.quant_ped_item) pcust_mc' +
        ' from vendaprodutos vp ' +
        ' inner join produtos pr on pr.grupo_prod = vp.grupo_prod and pr.cod_prod = vp.cod_prod and pr.cod_empresa = vp.cod_empresa ' +
        '	where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas2.SQL.Text := buscas2.SQL.Text + 'and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
      	if (trim(CodVendedor) = '') or (trim(CodVendedor) = '(0)') then
    	  	buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.cod_participante is null'
	      else
  	      buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.cod_participante in ' + CodVendedor;

      if ObRel.FiltrarGrupo then
        buscas2.SQL.Text := buscas2.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      buscas2.SQL.Text := buscas2.SQL.Text + ' group by vp.grupo_prod, vp.cod_prod, pr.descr_prod'; // order by vp.DESCR_PROD_PED, vp.grupo_prod,vp.cod_prod ';

      if OrdenarPor = 'CODPRODUTO' then
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by vp.cod_prod '
      else if OrdenarPor = 'DESCRICAO' then
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by pr.descr_prod '
      else
        buscas2.SQL.Text := buscas2.SQL.Text + ' order by vp.grupo_prod, vp.cod_prod ';

      buscas2.Params.ParamByName('dti').AsDate := datainicial;
      buscas2.Params.ParamByName('dtf').AsDate := datafinal;
      buscas2.Open;
//      if buscas2.IsEmpty then
//        exit;
    end;

    if TotalGrupo = 'SIM' then
    begin
      buscas3.Close;
      buscas3.SQL.text := 'select vp.grupo_prod, vp.descricao_grupo, ' +
        ' sum(vp.vltot_ped_item-vp.rateio_desc+vp.RATEIO_ACRESC) as totalGrupo, ' +
        ' sum(vp.quant_ped_item) as qtdItem,' +
        ' sum(vp.RATEIO_DESC) RATEIO_DESC, sum(vp.pcust_mc * vp.quant_ped_item) pcust_mc' +
        ' from vendaprodutos vp ' +
        ' where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and vp.tipo = ''REQ'' ';

      if FiltrarTipoVenda then
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.tipv = ' + QuotedStr(trim(TipoVenda))
      else
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.venda = ''S'' ';

      if FiltrarVendedor then
      	if (trim(CodVendedor) = '') or (trim(CodVendedor) = '(0)') then
    	  	buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.cod_participante is null'
	      else
	        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.cod_participante in ' + CodVendedor;

      if FiltrarGrupo then
        buscas3.SQL.Text := buscas3.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      buscas3.SQL.Text := buscas3.SQL.Text + ' group by vp.grupo_prod,vp.descricao_grupo';// order by vp.grupo_prod';

      if OrdenarPor = 'DESCRICAO' then
         buscas3.SQL.Text := buscas3.SQL.Text + ' order by vp.descricao_grupo'
      else
        buscas3.SQL.Text := buscas3.SQL.Text + ' order by vp.grupo_prod';

      buscas3.Params.ParamByName('dti').AsDate := datainicial;
      buscas3.Params.ParamByName('dtf').AsDate := datafinal;
      buscas3.Open;
//      if buscas3.IsEmpty then
//        exit;
    end;
    result := true;
  except
    Result := false;
  end;
end;

{ TRelatorioRecebimentosFinanceiro }

function TRelatorioRecebimentosFinanceiro.abreRecebimentosFinanceiro(pAgruparEmpUnificada: string;
	pCodEmpUnificada: Integer; pCodEmpresa: Integer): Boolean;
var
	CpfCgcCliente: string;
begin
	if FiltrarCliente then
  begin
  	CpfCgcCliente := '';

	  buscas.Close;
    buscas.SQL.Text := ' select cod_cliente, cpfcgc from clientes ' +
      ' where cod_cliente = :cod_cliente ' +
      ' and cod_empresa = :cod_empresa ';
    buscas.ParamByName('cod_cliente').AsInteger := StrToInt(Cliente);
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

	  CpfCgcCliente := trim(buscas.FieldByName('cpfcgc').AsString);
  end;

  buscas.Close;
  buscas.SQL.Text := ' select ' +
  	' rec.cod_empresa, ' +
    ' rec.cod_emp_orig, ' +
    ' rec.cod_emp_mult, ' +
    ' rec.cod_cliente, ' +
    ' rec.nome_cliente, ' +
    ' rec.cpfcgc_cliente, ' +
    ' rec.tp_rel, ' +
    ' rec.tp_doc, ' +
    ' rec.tp_recebimento, ' +
    ' rec.tp_recebimento2, ' +
    ' rec.ordem, ' +
    ' rec.cod_tipo, ' +
    ' rec.tipo, ' +
    ' rec.cod_cred, ' +
    ' rec.num_doc, ' +
    ' rec.num_doc2, ' +
    ' rec.data_doc, ' +
    ' rec.data_conf, ' +
    ' rec.valor_a_receber, ' +
    ' rec.obs_cxl, ' +
    ' rec.loterec, ' +
    ' rec.op_cxl, ' +
    ' rec.cod_us, ' +
    ' rec.data_mov, ' +
    ' rec.historico, ' +
    ' rec.valor_pago, ' +
    ' rec.data_venc, ' +
    ' rec.terceiros, ' +
    ' rec.codigo_ctrl, ' +
    ' rec.nome_ctrl, ' +
    ' rec.num_recibo, ' +
    ' rec.valor_recibo, ' +
    ' rec.ncupom, ' +
    ' rec.num_nf, ' +
    ' rec.parcela, ' +
    ' rec.seqid, ' +
    ' rec.seqid2, ' +
    ' rec.venda, ' +
    ' rec.tipv, ' +
    ' rec.tipo_doc, ' +
    ' rec.qtde_prest, ' +
  	' ctr.docs, ' +
    ' ctr.nao_gera_finan, ' +
    ' rec.cod_empresa, ' +
    ' rec.cod_emp_mult from recebimentos rec ' +
    ' left join controles ctr on ctr.codigo_ctrl = rec.codigo_ctrl and ctr.codigo_emp = rec.cod_empresa ' +
    ' where rec.data_conf >= :dti and rec.data_conf <= :dtf ';
  if ((pAgruparEmpUnificada = 'S') and (pCodEmpUnificada <= 0)) then
    buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_empresa = :cod_empresa '
  else
  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_emp_mult = :cod_empresa ';

  if FiltrarVenda then
	  buscas.SQL.Text := buscas.SQL.Text + ' and rec.venda = ' + QuotedStr(vDadosIni.IfThen(trim(Venda) = 'SIM', 'S', 'N'));

  if FiltrarPorTipo then
  	 if trim(PorTipo) = 'SAIDAS/VENDAS' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_rel = ''SAIDAS'' '
    else if trim(PorTipo) = 'RECIBO ANTECIPADO' then
      buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_rel = ''RECIBO ANTECIPADO'' '
    else if trim(PorTipo) = 'CREDIARIO/CHEQUE' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.tp_rel = ''CREDIARIO'' ';

  if FiltrarTipoVenda then
  	buscas.SQL.Text := buscas.SQL.Text + ' and ((rec.tipo_doc = ''REQ'' and rec.tipv = ' +QuotedStr(TipoVenda)+ ') ';

  if FiltrarTipoOS then
  	if FiltrarTipoVenda then
      buscas.SQL.Text := buscas.SQL.Text + ' or (rec.tipo_doc = ''OS'' and rec.tipv = ' +QuotedStr(TipoOs) + ') '
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and ((rec.tipo_doc = ''OS'' and rec.tipv = ' +QuotedStr(TipoOs)+ ') ';

  if FiltrarTipoVeic then
  	if (FiltrarTipoVenda) or (FiltrarTipoOS) then
      buscas.SQL.Text := buscas.SQL.Text + ' or (rec.tipo_doc = ''MOT'' and rec.tipv = ' +QuotedStr(TipoVeic)+ ') '
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and ((rec.tipo_doc = ''MOT'' and rec.tipv = ' +QuotedStr(TipoVeic)+ ') ';

  if ((FiltrarTipoVenda) and (FiltrarTipoOS) and (FiltrarTipoVeic)) then
  	buscas.SQL.Text := buscas.SQL.Text + ' or (rec.tipo_doc is null)) '
  else if ((FiltrarTipoVenda) or (FiltrarTipoOS) or (FiltrarTipoVeic)) then
  begin
    buscas.SQL.Text := buscas.SQL.Text + ' or (';
  	if FiltrarTipoVenda then
	    buscas.SQL.Text := buscas.SQL.Text + ' (rec.tipo_doc <> ''REQ'') ';
    if FiltrarTipoOS then
    	buscas.SQL.Text := buscas.SQL.Text + vDadosIni.IfThen(FiltrarTipoVenda, ' and ', '') +  ' (rec.tipo_doc <> ''OS'') ';
    if FiltrarTipoVeic then
    	buscas.SQL.Text := buscas.SQL.Text + vDadosIni.IfThen((FiltrarTipoVenda or FiltrarTipoOS), ' and ', '') + ' (rec.tipo_doc <> ''MOT'') ';
    buscas.SQL.Text := buscas.SQL.Text + '))';
  end;

  if FiltrarCliente then
  	if (trim(CpfCgcCliente) <> '') then
    	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cpfcgc_cliente = ' + QuotedStr(CpfCgcCliente)
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_cliente = ' + Cliente;

  if FiltrarOrigControle then
  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.cod_tipo = ' + OrigControle;

  if FiltrarControle then
  begin
  	if trim(NomeControle) = 'RECIBO ANTECIPADO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.tp_recebimento2) = ''RECIBO'' '
    else if trim(NomeControle) = 'DEVOLUCAO' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.tp_recebimento2) = ''DEVOLUCAO'' '
    else if trim(NomeControle)= 'CONTAS A PAGAR' then
    	buscas.SQL.Text := buscas.SQL.Text + ' and trim(rec.nome_ctrl) = ''CONTAS A PAGAR'' '
    else
	  	buscas.SQL.Text := buscas.SQL.Text + ' and rec.codigo_ctrl = ' + Controle +
      	' and (trim(rec.tp_recebimento2) <> ''RECIBO'') ' +
      	' and (trim(rec.tp_recebimento2) <> ''DEVOLUCAO'') ';
  end;

  if trim(Exibir) = 'QUITADOS' then
    buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(rec.codigo_ctrl, 0) > 0 '
  else if trim(Exibir) = 'NAO QUITADOS' then
    buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(rec.codigo_ctrl, 0) = 0 ';

  buscas.SQL.Text := buscas.SQL.Text +
    ' order by rec.ordem, rec.data_conf, rec.loterec, rec.num_doc, rec.tipo, rec.seqid, rec.valor_a_receber desc, rec.tp_recebimento, rec.nome_ctrl, rec.parcela ';
  buscas.Params.ParamByName('dti').AsDate := Fdatainicial;
  buscas.Params.ParamByName('dtf').AsDate := Fdatafinal;
  buscas.Params.ParamByName('cod_empresa').AsInteger := pCodEmpresa;
end;

procedure TRelatorioRecebimentosFinanceiro.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO DE RECEBIMENTOS', [normal, negrito]);
 
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);

  if FiltrarVenda then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'FILTRAR POR VENDAS (SIM OU NÃO): ' + vDadosIni.IfThen(Venda = 'SIM', 'SIM', 'NAO'), [negrito]);
  end;

  if FiltrarTipoVenda then
  begin
  	linha := linha + 1;
  	Rdp.ImpF(linha, 1, 'TIPO DE VENDA REQ: ' +QuotedStr(TipoVenda), [negrito]);
  end;

  if FiltrarTipoOS then
  begin
  	linha := linha + 1;
   Rdp.ImpF(linha, 1, 'TIPO DE VENDA OS: ' +QuotedStr(TipoOs), [negrito]);
  end;

  if FiltrarTipoVeic then
  begin
    linha := linha + 1;
  	Rdp.ImpF(linha, 1, 'TIPO DE VENDA VEIC: ' + QuotedStr(TipoVeic), [negrito]);
  end;
  
  if trim(Exibir) <> 'AMBOS' then
  begin
   linha := linha + 1;
   Rdp.ImpF(linha, 1, 'FILTRAR: ' + Exibir, [negrito]);
  end;

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TIPO DE RELATÓRIO: ' + TipoRelatorio, [negrito]);

  if (vDadosIni.vEmp.vFinanceiroUnificado) then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CODIGO EMPRESA UNIFICADA (0 - TODAS): ' +
    	vDadosIni.IfThen(CodEmpUnificada > 0, IntToStr(CodEmpUnificada), '0'), [negrito]);
    Rdp.ImpF(linha, 45, 'AGRUPAR EMPRESAS UNIFICADAS: ' +
    	vDadosIni.IfThen(AgruparEmpUnificada = 'S', 'SIM', 'NAO'), [negrito]);
  end;

  if FiltrarCliente then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CLIENTE: ' + trim(NomeCliente), [negrito]);
  end;

  if FiltrarOrigControle then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'ORIGEM: ' + trim(NomeOrigControle), [negrito]);
  end;

  if FiltrarControle then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'CONTROLE: ' + trim(NomeControle), [negrito]);
  end;

  vpag := vpag + 1;
  Rdp.ImpD(linha, 126, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
  if trim(TipoRelatorio) = 'ANALÍTICO' then
  begin
  	linha := linha + 2;
    Rdp.Imp(linha, 1, 'NUM.VND');
    Rdp.Imp(linha, 13, 'TIPO');
    Rdp.Imp(linha, 21, 'CLIENTE');
    Rdp.Imp(linha, 68, 'NFCE');
    Rdp.Imp(linha, 81, 'NF');
    Rdp.Imp(linha, 93, 'VALOR TOTAL');
    Rdp.imp(linha, 109, 'DATA FECH');
    Rdp.imp(linha, 123, 'STATUS');
  end;
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 133), [comp17, negrito]);
  linha := linha + 1;
end;

procedure TRelatorioRecebimentosFinanceiro.ChecarFimdePagina(fimpagina: boolean);
begin
   if (linha >= 60) then
   begin
     linha := 2;
     CabNovaPagina;
   end;
   
	 if not fimpagina then
   	exit;
   if (linha >= 58) or (fimpagina) then
   	ImprimirTotalPagina;
end;

