  //   inc(linha);
  //   Rdp.ImpF(linha, 1, Copy(trim(vDadosIni.vPedVnd.descricaoParticipante), 1, 1) +
  //   	  copy(LowerCase(trim(vDadosIni.vPedVnd.descricaoParticipante)), 2, Length(trim(vDadosIni.vPedVnd.descricaoParticipante)) - 1), []);
     fParcelas.First;
     while not fParcelas.Eof do
     begin
       inc(linha);
       vtotpart := vtotpart + RoundTo(fParcelas.FieldByName('comissao_vend').AsFloat, -2);
       Rdp.ImpF(linha, 1, Copy(Copy(trim(vDadosIni.vPedVnd.descricaoParticipante), 1, 1) +
        copy(LowerCase(trim(vDadosIni.vPedVnd.descricaoParticipante)), 2, Length(trim(vDadosIni.vPedVnd.descricaoParticipante)) - 1) + ': ' +
        trim(fParcelas.FieldByName('nome_vendedor').AsString), 1, 63), []);
       Rdp.ImpD(linha, 65, Format('%m', [RoundTo(fParcelas.FieldByName('comissao_vend').AsFloat, -2)]), []);

       fParcelas.Next;

       if linha >= 60 then
       begin
         linha := 2;
         CabNovaPagina;
       end;
     end;
