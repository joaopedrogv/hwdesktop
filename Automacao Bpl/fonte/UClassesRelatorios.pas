function TRelatorios.ListaAreaExec(Dbcombo: TDBCombobox; pVouF: boolean; pTipo: string): boolean;
begin
  Result := True;
  if dtSetArea = nil then
    dtSetArea := TClientDataSet(dtmRelatorios.cdsLocAreaExec);
  dtSetArea.Close;
  if not pVouF then
  begin
    result := false;
    exit;
  end;
  if trim(pTipo) = 'OS' then
    dtSetArea.CommandText := ' SELECT DISTINCT TRIM(COALESCE(AREA_EXEC, '''')) AREA_EXEC, TIPO FROM TIPO_VENDAS ' +
     ' WHERE (TRIM(COALESCE(AREA_EXEC, '''')) <> '''') ' +
     ' AND ATIVO=1 AND TIPO = ''OS'' ORDER BY AREA_EXEC'
  else
    dtSetArea.CommandText := ' SELECT DISTINCT TRIM(COALESCE(AREA_EXEC, '''')) AREA_EXEC, TIPO FROM TIPO_VENDAS ' +
     ' WHERE (TRIM(COALESCE(AREA_EXEC, '''')) <> '''') ' +
     ' AND ATIVO=1 ORDER BY AREA_EXEC';
  try
    dtSetArea.Open;
    Dbcombo.Items.Clear;
    dtSetArea.First;
    while not dtSetArea.Eof do
    begin
      Dbcombo.Items.Add(trim(dtSetArea.FieldByName('AREA_EXEC').AsString));
      dtSetArea.Next;
    end;
    dtSetArea.First;    
  except
    on e: exception do
    begin
      result := false;
      Application.MessageBox(Pchar('E0013 Erro ao executar comandos sql.' + #13 + 'Comandos: ' + dtSetArea.CommandText + #13 +
        'Erro: ' + e.Message), 'Informação', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TRelatorios.ListaCFOP(pVouF: boolean): boolean;
begin
