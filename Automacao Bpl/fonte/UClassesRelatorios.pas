function TRelatorioComprasPorPeriodo.SelecionaComprasPorPeriodo: Boolean;
var
  vCodNF: integer;
begin
  try
     buscas.Close;
     buscas.sql.text := ' select sum(valor_ctp) as valorpago,sum((data_venc_ctp-data_ent_ctp)*valor_ctp) as ponderacao '+
       ' from contas_a_pagar where data_ent_ctp >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(Fdatainicial))) +
       ' and data_ent_ctp <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(Fdatainicial))) +
       ' and (not num_nota_nfe is null and num_nota_nfe <> 0) and (tipo_ctp = ''F'' ' +
       ' and (data_venc_ctp-data_ent_ctp) >= 5) and codigo_emp = ' + vDadosIni.codEmpresa;
     buscas.Open;
     vvalvendaav := buscas.FieldByName('ponderacao').AsCurrency;
     vval:=0;

     buscas.Close;
     buscas.SQL.text := ' select ''pc'' as tipo,sum(val_tot_nfe) as valor from nf_entrada nf, nat_op nt where '+
       ' nf.data_lanc_nfe >= '+ QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(Fdatainicial))) +
       ' and nf.data_lanc_nfe <= '+ QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(Fdatainicial))) +
       ' and nf.codigo_nop = nt.codigo_nop ' +
       ' and (nt.mostrar_rel_compras <> ''N'' or nt.mostrar_rel_compras is null) ' +
       ' and nf.cod_empresa = ' + vDadosIni.codEmpresa +
       ' group by tipo ' +
       ' UNION ' +
       ' select ''mt'' as tipo,sum(valor_tot_nota) as valor from ent_moto nf,nat_op nt where '+
       ' nf.data_ch_nota >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(Fdatainicial))) +
       ' and nf.data_ch_nota <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(Fdatainicial))) +
       ' and nf.cod_fisc_nota = nt.codigo_nop and (nt.mostrar_rel_compras <> ''N'' '+
       ' or nt.mostrar_rel_compras is null) and cod_empresa = ' + vDadosIni.codEmpresa + ' group by tipo '+
       ' UNION '+
       ' select ''N4'' as tipo,sum(valor_total) as valor from notafiscal nf,nat_op nt where '+
       ' nf.data_lanc >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StartOfTheMonth(Fdatainicial))) +
       ' and nf.data_lanc <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', EndOfTheMonth(Fdatainicial))) +
       ' and nf.natureza_nf = ''E'' and nf.codigo_nop = nt.codigo_nop '+
       ' and (nt.mostrar_rel_compras <> ''N'' or nt.mostrar_rel_compras is null) ' +
       ' and nf.cod_empresa = ' + vDadosIni.codEmpresa+ ' group by tipo ';
     vval:=0;
     buscas.open;
     while not buscas.eof do
     begin
       vval := vval + buscas.FieldByName('valor').AsCurrency;
       buscas.next;
     end;
     if vval <> 0 then
        vPrazoMedioFornecedor := vvalvendaav/vval
     else
        vPrazoMedioFornecedor := 0.00;

     buscas.Close;
     if Trim(ComGrade) <> 'SIM' then
       buscas.SQL.Text := 'select nf.cod_nf, nf.cod_cliente ,nf.data_lanc, nf.valor_total, ' +
         ' nfi.cod_prod, nfi.grupo_prod,nfi.descricao_item, nfi.quantidade, nf.num_nf, ' +
         ' nfi.valor_unitario, nf.serie, nf.codigo_nop, nfi.codigo_nop as codigo_nop_item, cl.nome_cliente, ' +
         ' ( prod.est_f + prod.est_r ) as estoque,  nfi.prec_cus_cnt, nfi.nitem,' +
         ' coalesce((select sum ( case when nf.frete_f_nfe <> ''S'' then  ' +
         ' ( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp + nfi.rateio_frete ) ' +
         ' else ( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp )end) ' +
         ' from notafiscal_item nfi ' +
         ' inner join nat_op np on np.codigo_nop = nfi.codigo_nop ' +
         ' inner join notafiscal nf2 on nf2.cod_nf = nfi.cod_nf and nf2.cod_empresa = nfi.cod_empresa ' +
         ' where nfi.cod_nf = nf.cod_nf  and nfi.cod_empresa = nf.cod_empresa  and ' +
         ' np.mostrar_rel_compras = ''N''),0) as soma ' +
         ' from notafiscal nf  inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
         ' inner join nat_op np on np.codigo_nop = nf.codigo_nop  ' +
         ' inner join produtos prod on prod.cod_prod = nfi.cod_prod and prod.cod_empresa = nfi.cod_empresa and prod.grupo_prod = nfi.grupo_prod ' +
         ' inner join clientes cl on cl.cod_cliente = nf.cod_cliente and cl.cod_empresa = nf.cod_empresa ' +
         ' where nf.data_lanc >= :dti  and nf.data_lanc <= :dtf  and nf.status=''Fechada'' ' +
    //      ' and (nfi.altera_estoque_cfop <> ''N'' or nfi.altera_estoque_cfop is null) ' +
         ' and coalesce(situacao_nfe,'''')<> ''Inutilizada'' and coalesce(situacao_nfe,'''')<> ''Denegada'' and coalesce(situacao_nfe,'''')<> ''A Inutilizar'' ' +
         ' and nf.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf.ativo = 1  and( (np.mostrar_rel_compras <> ''N'') or (np.mostrar_rel_compras is null )) ' +
         ' and nf.natureza_nf = ''E'' '
     else
       buscas.SQL.Text := 'select nf.cod_nf, nf.cod_cliente ,nf.data_lanc, nf.valor_total, ' +
     	   ' nfi.cod_prod, nfi.grupo_prod,nfi.descricao_item, nfi.quantidade, nf.num_nf, ' +
         ' nfi.valor_unitario, nf.serie, nf.codigo_nop, nfi.codigo_nop as codigo_nop_item, nfi.nitem, cl.nome_cliente, ' +
         ' ( prod.est_f + prod.est_r ) as estoque,  nfi.prec_cus_cnt, coalesce(gra.cod_grade,0) as cod_grade,' +
         ' coalesce(gra.descricao,''SEM GRADE'') as descr_grade, nfi.nitem, coalesce(grcomp.qtde,0) as qtde_grade,' +
         ' coalesce((select sum ( case when nf.frete_f_nfe <> ''S'' then  ' +
         ' ( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp + nfi.rateio_frete ) ' +
         ' else ( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp )end) ' +
         ' from notafiscal_item nfi ' +
         ' inner join nat_op np on np.codigo_nop = nfi.codigo_nop  ' +
         ' inner join notafiscal nf2 on nf2.cod_nf = nfi.cod_nf and nf2.cod_empresa = nfi.cod_empresa ' +
         ' where nfi.cod_nf = nf.cod_nf  and nfi.cod_empresa = nf.cod_empresa  and ' +
         ' np.mostrar_rel_compras = ''N''),0) as soma ' +
         ' from notafiscal nf  inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
         ' inner join nat_op np on np.codigo_nop = nf.codigo_nop  ' +
         ' inner join produtos prod on prod.cod_prod = nfi.cod_prod and prod.cod_empresa = nfi.cod_empresa and prod.grupo_prod = nfi.grupo_prod ' +
         ' left join cod_grade_prod_compra grcomp on ' +
         ' nfi.grupo_prod = grcomp.grupo_prod and nfi.cod_prod = grcomp.cod_prod and nfi.cod_empresa = grcomp.cod_empresa and ' +
         ' nfi.cod_nf = grcomp.num_nota_nfe and nfi.nitem = grcomp.cod_forn_nfe ' +
         ' left join grade gra on grcomp.cod_grade = gra.cod_grade and grcomp.cod_empresa = gra.cod_empresa ' +
         ' inner join clientes cl on cl.cod_cliente = nf.cod_cliente and cl.cod_empresa = nf.cod_empresa ' +
         ' where nf.data_lanc >= :dti  and nf.data_lanc <= :dtf  and nf.status=''Fechada'' ' +
  //       ' and (nfi.altera_estoque_cfop <> ''N'' or nfi.altera_estoque_cfop is null) ' +
         '  and coalesce(situacao_nfe,'''')<> ''Inutilizada'' and coalesce(situacao_nfe,'''')<> ''Denegada'' and coalesce(situacao_nfe,'''')<> ''A Inutilizar'' ' +
         ' and nf.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf.ativo = 1  and( (np.mostrar_rel_compras <> ''N'') or (np.mostrar_rel_compras is null )) ' +
         ' and nf.natureza_nf = ''E'' ';

     if DA = 'SIM' then
        buscas.SQL.Text := buscas.SQL.Text + ' and nf.da = ''S'' '
     else if DA = 'NAO' then
        buscas.SQL.Text := buscas.SQL.Text + ' and coalesce(nf.da, '''') <> ''S'' ';

     if Trim(ComGrade) <> 'SIM' then
     begin
       if Trim(OrdenarPor) = 'NUM NF' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 9, 1'
       else if Trim(OrdenarPor) = 'CFOP' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 12, 1'
       else
         buscas.SQL.Text := buscas.SQL.Text + ' order by 3, 1';
     end
     else
     begin
       if Trim(OrdenarPor) = 'NUM NF' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 9, 1, 13'
       else if Trim(OrdenarPor) = 'CFOP' then
         buscas.SQL.Text := buscas.SQL.Text + ' order by 12, 1, 13'
       else
         buscas.SQL.Text := buscas.SQL.Text + ' order by 3, 1, 13';
     end;
     buscas.Params.ParamByName('dti').AsDate := Fdatainicial;
     buscas.Params.ParamByName('dtf').AsDate := Fdatafinal;
     buscas.Open;
     vCodNF := 0;
     vValortotal := 0;
     vCustContabil := 0;
     if not buscas.IsEmpty then
     begin
       buscas.First;
       vCodNF := buscas.FieldByName('cod_nf').AsInteger;
       vvalortotal := vvalortotal + (buscas.FieldByName('valor_total').AsCurrency - buscas.FieldByName('soma').AsCurrency);
       while not buscas.Eof do
       begin
         if vCodNF <> buscas.FieldByName('cod_nf').AsInteger then
         begin
           vvalortotal := vvalortotal + (buscas.FieldByName('valor_total').AsCurrency - buscas.FieldByName('soma').AsCurrency);
           vCodNF := buscas.FieldByName('cod_nf').AsInteger;
         end;
         vcustContabil := vcustContabil + (buscas.FieldByName('quantidade').AsCurrency * buscas.FieldByName('prec_cus_cnt').AsCurrency);
         buscas.Next;
       end;
       if AgrupaFornec = 'SIM' then
       begin
         buscas.Close;
         if Trim(OrdenarPor) = 'NUM NF' then
           buscas.SQL.Text := StringReplace(buscas.SQL.Text, ' order by 9, 1', ' order by 2, 9, 1', [rfIgnoreCase])
         else if Trim(OrdenarPor) = 'CFOP' then
           buscas.SQL.Text := StringReplace(buscas.SQL.Text, ' order by 12, 1', ' order by 2, 12, 1', [rfIgnoreCase])
         else
           buscas.SQL.Text := StringReplace(buscas.SQL.Text, ' order by 3, 1', ' order by 2, 3, 1', [rfIgnoreCase]);

         buscas.Params.ParamByName('dti').AsDate := datainicial;
         buscas.Params.ParamByName('dtf').AsDate := datafinal;
         buscas.Open;
       end;
     end;

     if buscas.IsEmpty then
       Result := False
     else
       Result := True;
  except
  end;
end;
{
function TRelatorioComprasPorPeriodo.SelecionaComprasPorPeriodo: Boolean;
var
  variavel: string;
begin
  variavel := '';
  try
    with dtmRelatorios do
    begin
      qrBuscas.Close;
      qrBuscas.SQL.Clear;

      qrBuscas.Params.CreateParam(ftDate, 'dataini', ptUnknown);
      qrBuscas.Params.CreateParam(ftDate, 'datafin', ptUnknown);
      qrBuscas.Params.CreateParam(ftUnknown, 'cod_empresa', ptUnknown);

      qrBuscas.Params.ParamByName('dataini').AsDate := Fdatainicial;
      qrBuscas.Params.ParamByName('datafin').AsDate := Fdatafinal;
      qrBuscas.Params.ParamByName('cod_empresa').AsString := vDadosIni.codEmpresa;

      variavel := variavel + 'select nf.cod_nf, nf.cod_cliente ,nf.data_lanc, nf.valor_total, nfi.cod_prod, nfi.grupo_prod, ' +
        'nfi.descricao_item, nfi.quantidade, nf.num_nf, nfi.valor_unitario, nf.serie, nf.codigo_nop, ' +
        'prod.prec_cus_prod, cl.nome_cliente, ( prod.est_f + prod.est_r ) estoque, ' +
        'cs.prec_cus_med, cs.valor, ' +

      '(select sum ( ' +
        'case when nf.frete_f_nfe <> ''S'' then ' +
        '( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp + nfi.rateio_frete ) ' +
        'else ' +
        '( (nfi.valor_total - nfi.rateio_desconto) + nfi.valor_ipi + nfi.rateio_seguro + nfi.rateio_outdesp )end ) ' +

      'from notafiscal_item nfi ' +
        'inner join nat_op np on np.codigo_nop = nfi.codigo_nop ' +
        'inner join notafiscal nf2 on nf2.cod_nf = nfi.cod_nf and nf2.cod_empresa = nfi.cod_empresa ' +
        'where nfi.cod_nf = nf.cod_nf ' +
        'and nfi.cod_empresa = nf.cod_empresa ' +
        'and ( (np.mostrar_rel_compras <> ''N'') or (np.mostrar_rel_compras is null )) ' +
        ') soma ' +

      'from notafiscal nf ' +
        'inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
        'inner join nat_op np on np.codigo_nop = nfi.codigo_nop ' +
        'inner join produtos prod on prod.cod_prod = nfi.cod_prod and prod.cod_empresa = nfi.cod_empresa and prod.grupo_prod = nfi.grupo_prod ' +
        'inner join clientes cl on cl.cod_cliente = nf.cod_cliente and cl.cod_empresa = nf.cod_empresa ' +
        'inner join custos cs on cs.cod_prod = nfi.cod_prod and cs.grupo_prod = nfi.grupo_prod and cs.cod_empresa = nfi.cod_empresa and cs.cod_nf = nfi.cod_nf ' +

      'where nf.data_lanc >= :dataini ' +
        'and nf.data_lanc <= :datafin ' +
        'and ((not nf.status is null) or nf.status <> '''' ) ' +
        'and nf.cod_empresa = :cod_empresa ' +
        'and nf.ativo = 1 ' +
        'and np.mostrar_rel_compras <> ''N'' ' +
        'and nf.natureza_nf = ''E'' ';

      if Fda = 'Sim' then
        variavel := variavel + 'and nf.da = ''S'' ';

      if FAgrupaFornec = 'Sim' then
        variavel := variavel + 'order by 2'
      else
        variavel := variavel + 'order by 1';

      qrBuscas.SQL.Text := variavel;
      qrBuscas.Open;

      if qrBuscas.IsEmpty then
        Result := False
      else
        Result := True;

    end;
  except
  end;
end;
}
{ TRelatorioEstoque }

constructor TRelatorioEstoque.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrBuscas1);
  buscasGerais := TIBQuery(dtmRelatorios.qrBuscasGerais);
end;

function TRelatorioEstoque.getQtdItensCompra(codprod: string;
  grupoprod: integer; data: TDateTime): double;
begin
  buscasGerais.Close;
  buscasGerais.SQL.Text := 'select sum(it.quant_item_nfe) as qtdItemNFE,sum(it.quant_item_nfe*it.prec_cus_cnt) ' +
    ' from item_nf_entrada it,nf_entrada nf ' +
    ' where nf.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and nf.ativo=1 and it.cod_prod = ' + quotedstr(trim(codprod)) +
    ' and it.grupo_prod = ' + inttostr(grupoprod) +
    ' and it.num_nota_nfe = nf.num_nota_nfe ' +
    ' and it.cod_forn_nfe = nf.cod_forn_nfe and it.cod_empresa = nf.cod_empresa ' +
    ' and nf.data_lanc_nfe  >= :vdata and (not nf.status_nfe is null)' +
    ' union ' +
    ' select sum(it4.quantidade),sum(it4.quantidade*it4.prec_cus_cnt) ' +
    ' from notafiscal_item it4 inner join notafiscal nf4 on it4.cod_nf = nf4.cod_nf and it4.cod_empresa = nf4.cod_empresa ' +
    ' where nf4.cod_empresa = ' + vDadosIni.codEmpresa + ' and nf4.natureza_nf=''E'' ' +
    ' and nf4.ativo=1 and it4.cod_prod = ' + quotedstr(trim(codprod)) +
    ' and it4.grupo_prod = ' + inttostr(grupoprod) +
    ' and nf4.data_lanc  >= :vdata and (nf4.status = ''Fechada'')';
  buscasGerais.ParamByName('vData').AsDate := Data + 1;
  buscasGerais.Open;
  result := 0;
  while not buscasGerais.eof do
  begin
    result := result + buscasGerais.FieldByName('qtdItemNFE').AsFloat;
    buscasGerais.next;
  end;
  buscasGerais.Close;
end;

function TRelatorioEstoque.getQtdItensDevolvidos(codprod: string;
  grupoprod: integer; data: TDateTime): double;
begin
  buscasGerais.Close;
  buscasGerais.SQL.Text := ' select ' +
  	' sum(case when (coalesce(valor_tot, 0) > 0) then ' +
    '            coalesce(valor_tot, 0) ' +
    '          else ' +
    '            (coalesce(quant, 0) * coalesce(valor, 0)) ' +
    '    end ' +
    ' ) SomaValorDevolvido, ' +
    ' sum(coalesce(quant, 0)) as qtdItemDevolvido from devolucao ' +
    ' where cod_prod = ' + quotedstr(trim(codprod)) +
    ' and grupo_prod = ' + inttostr(grupoprod) +
    ' and data  >= :vdata ' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1 and coalesce(nf_gerou,'''') <> ''S''';
  buscasGerais.ParamByName('vData').AsDate := Data + 1;
  buscasGerais.Open;
  result := buscasGerais.FieldByName('qtdItemDevolvido').AsFloat;
  buscasGerais.Close;
end;

function TRelatorioEstoque.getQtdItensVenda(codprod: string; grupoprod: integer;
  data: TDateTime): double;
begin
  buscasGerais.Close;
  buscasGerais.SQL.Text := 'select sum(ipv.quant_ped_item) as qtdItemREQOS,sum(ipv.quant_ped_item * ipv.pcust_mc) as vCustoMedio ' +
    ' from pedvenda_prod ipv,pedvenda pv ' +
    ' where ipv.cod_prod = ' + quotedstr(trim(codprod)) +
    ' and ((pv.tipo=' + quotedstr('REQ') + ') or (pv.tipo=' + quotedstr('OS') + ')) ' +
    ' and ipv.grupo_prod = ' + inttostr(grupoprod) +
    ' and ipv.nped = pv.nped and pv.data_fech  >= :vdata ' +
    ' and pv.cod_empresa = ipv.cod_empresa ' +
    ' and ipv.tipo=pv.tipo' +
    ' and (ipv.status<>''CANCELADO'' or ipv.status is null) ' +
    ' and pv.cod_empresa = ' + vDadosIni.codEmpresa + ' and pv.ativo=1';
  buscasGerais.ParamByName('vData').AsDate := Data + 1;
  buscasGerais.Open;
  result := buscasGerais.FieldByName('qtdItemREQOS').AsFloat;
  buscasGerais.Close;
end;

procedure TRelatorioEstoque.ImprimeRelatorios;
var
  vqtdg, vest, vQtdItemVnd, qtdItemCompras, qtdItemDevolvido: Double;
  vgrup: integer;
  vitem, i: integer;
  vprC: Double;
  qrBuscaProd: TIBQuery;
  strTemp: string;
  vtotger, vtotgert: Double;
  vGradeP, vExisteGrade: boolean;
begin
  try
    if not vDadosIni.PesqPros('REL011', 'IMPRIMIR', '', '',
      '', buscas, false) then
      Exit;
  inherited;

    Screen.Cursor := crHourGlass;
    vtotger := 0.00;
    vtotgert := 0.00;
    vitem := 1;
    vest := 0.00;
    vqtdg := 0;
    //  lb.Caption := 'Abrindo Bases de Produtos...';

    buscas.Close;
    buscas.SQL.Text := ' select first 1 coalesce(cod_grade, 0) as valor from grade ' +
     ' where ativo = 1 and cod_grade > 0 and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    vExisteGrade := not buscas.IsEmpty;

    buscas.Close;
    buscas.SQL.Text := 'select pr.GRUPO_PROD,pr.COD_PROD,pr.Descr_prod,pr.EST_F, ' +
      ' pr.EST_R,pr.PREC_CUSM_PROD from produtos pr where  pr.cod_empresa = ' + vDadosIni.codEmpresa + ' and pr.ativo=1 ' +
      ' and ((pr.consumo <> ' + quotedstr('S') + ') or (pr.consumo is null)) ' +
      ' and ((pr.dat_cad_prod is null) or (pr.dat_cad_prod <= :data_ref))' +
      ' and ((((select count(pv.cod_prod) from pedvenda_prod pv ' +
      ' where ((pv.tipo=' + quotedstr('OS') + ' ) or (pv.tipo=' + quotedstr('REQ') + ')) and ' +
      ' pv.grupo_prod = pr.grupo_prod and pv.cod_prod = pr.cod_prod and ' +
      ' pv.cod_empresa = ' + vDadosIni.codEmpresa + ' and pv.ativo=1) >= 1 ) ' +
      ' or ' +
      ' ((select count(it.cod_prod) from item_nf_entrada it where ' +
      ' it.grupo_prod = pr.grupo_prod and it.cod_prod = pr.cod_prod and ' +
      ' it.cod_empresa = ' + vDadosIni.codEmpresa + ' and it.ativo=1) >= 1 ) ' +
      ' or ' +
      ' ((select count(nfit.cod_prod) from notafiscal_item nfit inner join notafiscal nf on ' +
      ' nf.cod_nf=nfit.cod_nf and nf.cod_empresa=nfit.cod_empresa  where nf.natureza_nf=''E'' and ' +
      ' nfit.grupo_prod = pr.grupo_prod and nfit.cod_prod = pr.cod_prod and  ' +
      ' nfit.cod_empresa = ' + vDadosIni.codEmpresa + ' and nfit.ativo=1) >= 1 ) ' +
      ' ) or ((pr.est_f) > 0 and pr.cod_empresa = ' + vDadosIni.codEmpresa + '))';
    buscas.ParamByName('data_ref').AsDateTime := dataReferencia;
    buscas.sql.Text := buscas.sql.Text + ' order by pr.grupo_prod,pr.COD_PROD';
    buscas.Open;

    buscas.FetchAll;
    frmRelatorios.ProgressBar.max := Buscas.RecordCount;
    frmRelatorios.ProgressBar.Position := 0;
    buscas.First;
    while not buscas.eof do
    begin
      Application.processMessages;
      if dataReferencia < date then
      begin
        vDadosIni.RetornarEstoquePrecoCusto(buscas1, buscasGerais, DateToStr(dataReferencia),
         buscas.FieldByName('GRUPO_PROD').AsInteger, buscas.FieldByName('COD_PROD').asstring,
         vExisteGrade, vGradeP, vest, vprc);

        if (not vGradeP) or (buscas1.IsEmpty) then
        begin
          vprC := 0;
          qtdItemCompras := getQtdItensCompra(trim(buscas.FieldByName('COD_PROD').asstring), buscas.FieldByName('GRUPO_PROD').AsInteger, dataReferencia);
          vQtdItemVnd := getQtdItensVenda(trim(buscas.FieldByName('COD_PROD').asstring), buscas.FieldByName('GRUPO_PROD').AsInteger, dataReferencia);
          qtdItemDevolvido := getQtdItensDevolvidos(trim(buscas.FieldByName('COD_PROD').asstring), buscas.FieldByName('GRUPO_PROD').AsInteger, dataReferencia);
          vest := (((buscas.FieldByName('EST_F').AsFloat) - (qtdItemCompras + qtdItemDevolvido)) + (vQtdItemVnd));
//          vest := (((buscas.FieldByName('EST_F').AsFloat + buscas.FieldByName('EST_R').AsFloat) - (qtdItemCompras + qtdItemDevolvido)) + (vQtdItemVnd));
        end;
        if vDadosIni.StrToFloatFormat(vest, 3) > 0.000 then
        begin
          if vprC = 0 then
          begin
            buscas1.Close;
            buscas1.SQL.Text := 'SELECT data,valor,prec_cus_med,pr_cusc_prod FROM CUSTOS ' +
              ' WHERE GRUPO_PROD = ' + buscas.FieldByName('GRUPO_PROD').asstring +
              ' AND COD_PROD = ' + quotedstr(trim(buscas.FieldByName('COD_PROD').asstring)) +
              ' AND DATA < :vdata ' +
              ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1 ' +
              ' order by data desc';
            buscas1.ParamByName('vData').AsDate := dataReferencia + 1;
            buscas1.Open;
            if buscas1.IsEmpty then
              vprC := buscas.FieldByName('PREC_CUSM_PROD').asfloat
            else if buscas1.FieldByName('PREC_CUS_MED').AsFloat = 0 then
              vprC := buscas1.FieldByName('VALOR').AsFloat
            else
              vprC := buscas1.FieldByName('PREC_CUS_MED').AsFloat;
          end;
        end;
      end
      else
      begin
        vest := (buscas.FieldByName('EST_F').AsFloat {+ buscas.FieldByName('EST_R').AsFloat});
        vprc := buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
      end;
      if vDadosIni.StrToFloatFormat(vest, 3) > 0.000 then
        vtotgert := vtotgert + (vest * vprC);
      buscas.next;
      frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
    end;
    vDadosIni.GravaAuditoria('REL011', 'IMPRIMIR', 'SUCESSO', '',
      '', buscas);

    buscas.close;
    buscas1.close;

    if not vDadosIni.ModImp(Rdp) then
      exit;
    Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
    Rdp.TamanhoQteColunas := 132;
    Rdp.CaptionSetup := 'Configurações de Impressão';
    rdp.OpcoesPreview.CaptionPreview := 'Estoque por data de referência';
    rdp.TitulodoRelatorio := 'Estoque por data de referencia';
    vDadosIni._LimparVarSendEmail;
    rdp.OnSendMail := vDadosini._SendMailRdPrint;
    rdp.OpcoesPreview.Preview := true;
    if not Rdp.EstaAberto then
      Rdp.Abrir;
    vpag := 0;
    linha := 2;
    Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'RELATORIO DE ESTOQUE POR DATA DE REFERÊNCIA', [normal, negrito]);
    Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'DATA DE REFERÊNCIA: ' + DateToStr(dataReferencia), [normal, negrito]);
    vpag := vpag + 1;
    Rdp.ImpF(linha, 80, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal, negrito]);
    linha := linha + 2;

    Rdp.impF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    linha := linha + 1;
    Rdp.impf(linha, 1, 'TOTAL DE ESTOQUE EM ' + DateToStr(dataReferencia), [negrito]);
    Rdp.impD(linha, 85, format('%n', [vtotgert]), [negrito]);
    linha := linha + 1;
    Rdp.impF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    linha := linha + 1;
    if Rdp.EstaAberto then
      Rdp.Fechar;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
  end;
end;

