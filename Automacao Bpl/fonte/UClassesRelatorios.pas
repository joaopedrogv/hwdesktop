function TRelatorios.verificatipodepartamento(vcomb: TCombobox): boolean;
begin
  Result := False;

  buscas.close;
  buscas.sql.text := 'select nome_depto from depto where ativo = 1 order by nome_depto';
  buscas.open;
  vcomb.Items.Clear;
  vcomb.Items.Add('TODOS');
  while not buscas.eof do
  begin
    vcomb.Items.Add(buscas.FieldByName('nome_depto').AsString);
    buscas.next;
  end;
  vcomb.Text := 'TODOS';
  vcomb.ItemIndex := 0;
  Result := true;
end;

function TRelatorioVendaVendedorComissaoServ.ListaVendedores(pVouF: boolean): boolean;
begin
  try
    if dtSetColab = nil then
      dtSetColab := TClientDataSet(dtmRelatorios.cdsLocColab);
    dtSetColab.close;
    dtSetColab.CommandText := ' SELECT C.NOME_VENDEDOR, C.COD_VENDEDOR FROM COLABORADOR C' +
      ' INNER JOIN FUNCOES F ON F.COD_FUNCAO = C.COD_FUNCAO ' +
      ' WHERE C.COD_EMPRESA = ' + vDadosIni.codEmpresa;
    if FiltrarFuncao then
      dtSetColab.CommandText := dtSetColab.CommandText + ' and F.desc_funcao LIKE ' + '''%' + trim(dtSetFuncoes.FieldByName('DESC_FUNCAO').AsString) + '%''';
    dtSetColab.open;
    result := not dtSetColab.IsEmpty;
    if Result then
      abreFormVendedores
    else
      Application.MessageBox('Nenhum vendedor para a função selecionada!', 'Atenção', MB_OK + MB_ICONINFORMATION);
  except
    result := false;
  end;
end;

{ TRelatorioVendasOficina }

procedure TRelatorioVendasOficina.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'RELATORIO DE VENDAS/FATURAMENTO DE PRODUTOS', [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DADOS OFICINA', [normal, negrito]);
  linha := linha + 1;
  if FiltrarTipoOS then
    Rdp.ImpF(linha, 1, trim(dtSetTipoOS.FieldByName('DESCRICAO').AsString), [normal, negrito])
  else
    Rdp.ImpF(linha, 1, 'TODOS', [normal, negrito]);

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'DE: ' + DateToStr(datainicial) + ' A ' + DateToStr(datafinal), [normal, negrito]);
  Rdp.ImpF(linha, 80, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);

  if FiltrarVendedor then
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, Copy('VENDEDOR: ' + trim(Vendedor), 1, 78), [normal, negrito]);
  end
  else
  begin
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'VENDEDOR: ' + 'TODOS', [normal, negrito]);
  end;

  vpag := vpag + 1;
