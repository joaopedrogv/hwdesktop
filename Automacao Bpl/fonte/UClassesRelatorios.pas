              Rdp.Imp(linha, 100, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat / AcresDecres]), 12));
              grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat / AcresDecres), 0);
            end
            else
            begin
              Rdp.Imp(linha, 100, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat * AcresDecres]), 12));
              grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat * AcresDecres), 0);
            end;
          end
          else
          begin
            Rdp.Imp(linha, 100, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat]), 12));
            grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat), 0);
          end;
        end
        else
        begin
          Rdp.Imp(linha, 10, buscas.FieldByName('CHASSI_C').AsString);
          Rdp.Imp(linha, 32, buscas.FieldByName('DESCRICAO_VERSAOEST').AsString);
          Rdp.Imp(linha, 52, 'UN');
          Rdp.Imp(linha, 56, '01');
          if AcresDecres <> 0 then
          begin
            if Divisao then
            begin
              Rdp.Imp(linha, 60, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat / AcresDecres]), 10));
              Rdp.Imp(linha, 70, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat / AcresDecres]), 10));
              grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat / AcresDecres), 0);
            end
            else
            begin
              Rdp.Imp(linha, 60, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat * AcresDecres]), 10));
              Rdp.Imp(linha, 70, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat * AcresDecres]), 10));
              grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat * AcresDecres), 0);
            end;
          end
          else
          begin
            Rdp.Imp(linha, 60, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat]), 10));
            Rdp.Imp(linha, 70, vDadosIni.Alndir(format('%n', [buscas.FieldByName('CUSTO').AsFloat]), 10));
            grava_tipo74(1, (buscas.FieldByName('CUSTO').AsFloat), 0);
          end;
        end;
        if ComStatus then
        begin
          if trim(buscas.FieldByName('SIT_RES').AsString) <> '' then
          begin
            if trim(buscas.FieldByName('SIT_RES').AsString) = 'V' then
              Rdp.ImpF(linha, 116, copy(trim(buscas.FieldByName('SITUACAO').AsString), 1, 4) +
              	vDadosIni.IfThen(trim(buscas.FieldByName('SITUACAO').AsString) <> '', ' ', '') + 'Res Vend', [comp17])
            else
              Rdp.ImpF(linha, 116, copy(trim(buscas.FieldByName('SITUACAO').AsString), 1, 4) +
              	vDadosIni.IfThen(trim(buscas.FieldByName('SITUACAO').AsString) <> '', ' ', '') + 'Res N Vend', [comp17])
          end
          else
            Rdp.ImpF(linha, 116, copy(trim(buscas.FieldByName('SITUACAO').AsString), 1, 4) +
            	vDadosIni.IfThen(trim(buscas.FieldByName('SITUACAO').AsString) <> '', ' ', '') + 'Sem Res', [comp17]);
        end;
        linha := linha + 1;
        vcount := vcount + 1;
        vct := vct + 1;
        if linha >= 59 then
        begin
          if UpperCase(trim(TipoRelatorio)) <> 'GERAL' then
          begin
            Rdp.imp(linha, 47, 'A TRANSPORTAR...');
            Rdp.imp(linha, 62, vDadosIni.Alndir(format('%n', [vtotm]), 12));
          end
          else
            Rdp.Imp(linha, 1, vDadosIni.Replicate('=', 132));
          linha := 1;
          CabNovaPagina;
        end;
        if AcresDecres <> 0 then
        begin
          if Divisao then
            vtotm := vtotm + (buscas.FieldByName('CUSTO').AsFloat / AcresDecres)
          else
            vtotm := vtotm + (buscas.FieldByName('CUSTO').AsFloat * AcresDecres);
        end
        else
          vtotm := vtotm + buscas.FieldByName('CUSTO').AsFloat;
        frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
        buscas.next;
        if buscas.Eof then
        begin
          if UpperCase(trim(TipoRelatorio)) = 'GERAL' then
            Rdp.ImpF(linha, 1, '* * * * QTDE: ' + vDadosIni.Strzero(vcount, 5), [comp17]);
          linha := linha + 1;
          vcount := 0;
        end;
      end;
      if buscas.IsEmpty then
      begin
        if UpperCase(trim(TipoRelatorio)) = 'GERAL' then
          Rdp.ImpF(linha, 1, '* * * * QTDE: ' + vDadosIni.Strzero(vcount, 5), [comp17]);
        linha := linha + 1;
        vcount := 0;
    end;
    end;

    if linha >= 59 then
    begin
      if UpperCase(trim(TipoRelatorio)) <> 'GERAL' then
      begin
        Rdp.imp(linha, 47, 'A TRANSPORTAR...');
        Rdp.imp(linha, 62, vDadosIni.Alndir(format('%n', [vtotm]), 12));
      end;
      linha := 1;
      CabNovaPagina;
    end;

    if UpperCase(trim(TipoRelatorio)) = 'GERAL' then
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', 132));
    linha := linha + 2;

    if linha >= 56 then
    begin
      if UpperCase(trim(TipoRelatorio)) <> 'GERAL' then
      begin
        Rdp.imp(linha, 47, 'A TRANSPORTAR...');
        Rdp.imp(linha, 62, vDadosIni.Alndir(format('%n', [vtotm]), 12));
      end;
      linha := 1;
      CabNovaPagina;
    end;

    if ValorPecas <> 0 then
    begin
      Rdp.Imp(linha, 1, 'TOTAL MONETÁRIO DE PECAS NO ESTOQUE EM ' + DateToStr(DataReferencia) + '................: ');
      Rdp.ImpD(linha, 85, format('%n', [ValorPecas]), [comp17]);
    linha := linha + 2;
    end;
    
    if (VeiculoNovo) and (not VeiculoUsado) then
      Rdp.Imp(linha, 1, 'TOTAL MONETÁRIO DE VEÍCULOS NOVOS NO ESTOQUE EM ' + DateToStr(DataReferencia) + '.......:')
    else if (VeiculoUsado) and (not VeiculoNovo) then
      Rdp.Imp(linha, 1, 'TOTAL MONETÁRIO DE VEÍCULOS USADOS NO ESTOQUE EM ' + DateToStr(DataReferencia) + '......:')
    else
      Rdp.Imp(linha, 1, 'TOTAL MONETÁRIO DE VEÍCULOS NOVOS/USADOS NO ESTOQUE EM ' + DateToStr(DataReferencia) + ':');
    Rdp.ImpD(linha, 85, format('%n', [vtotm]), [comp17]);
    if ValorPecas <> 0 then
    begin
      linha := linha + 2;
      Rdp.Imp(linha, 1, 'TOTAL GERAL......................................................: ');
      Rdp.ImpD(linha, 85, format('%n', [ValorPecas + vtotm]), [comp17]);
    end;
    if ComStatus then
    begin
      linha := linha + 2;
      Rdp.Imp(linha, 1, 'QUANTIDADE.......................................................: ');
      Rdp.ImpD(linha, 85, vDadosIni.Strzero(vct, 5), [comp17]);
    end;
    linha := linha + 1;
    vct := 0;
//    vtotm := 0.00;
    vcount := 0;
    if Tipo74 then
      if buscas74.Transaction.InTransaction then
        buscas74.Transaction.Commit;
  end;
  Rdp.Fechar;
  buscas.close;
  buscasCompra.close;
  buscasVenda.close;
  buscas74.close;
  vDadosIni.Auditoria('REL036', 'IMPRIMIR', 'SUCESSO - ' +
  	'TP: ' + UpperCase(trim(TipoRelatorio)) +
  	' REF: ' + FormatDateTime('dd/mm/yyyy', DataReferencia) +
    ' EMISSAO: ' + FormatDateTime('dd/mm/yyyy', Date) +
    ' VL: ' + trim(vDadosIni.Alndir(format('%n', [vtotm]), 18)) +
    vDadosIni.IfThen((VeiculoNovo) and (not VeiculoUsado), ' VEIC: NOVO', 
    	vDadosIni.IfThen((not VeiculoNovo) and (VeiculoUsado), ' VEIC: USADO', '')), 'EST_MOTO', '');
  buscas.Close;
  frmRelatorios.ProgressBar.position := 0;
end;

{ TRelatorioSituacaodoEstoqueFechado }

function TRelatorioSituacaodoEstoqueFechado.abreSituacaodoEstoqueFechado: Boolean;
var
 pOrdem: string;
begin
  if trim(OrdenarPor) = 'CODIGO' then
    pOrdem := ' order by 1, 2, 3 '
  else if trim(OrdenarPor) = 'DESCRICAO' then
    pOrdem := ' order by 1, 2, 4 '
  else if trim(OrdenarPor) = 'LOCACAO' then
    pOrdem := ' order by 1, 2, 5 '
  else if trim(OrdenarPor) = 'LOCACAO2' then
    pOrdem := ' order by 1, 2, 6 '
  else if trim(OrdenarPor) = 'DATA' then
    pOrdem := ' order by 1, 2, 7 ';

  buscas.Close;
  buscas.SQL.Text :=
   ' select c.cod_vendedor, ''EST'' tipo, c.num_fab_prod, c.descr_prod, pr.locacao_prod, pr.locacao_prod_1, c.data_pedido, ' +
   ' c.sit_atd, c.ndoc, c.tpdoc, c.quant, cl.nome_cliente, cp.desc_cond_pag from controle_almoxarifado c ' +
   ' left join cond_pag cp on cp.cod_cond_pag = c.cod_cond_pag ' +
   ' left join clientes cl on cl.cod_cliente = c.cod_cliente and cl.cod_empresa = c.cod_empresa ' +
   ' left join produtos pr on pr.grupo_prod = c.grupo_prod and pr.cod_prod = c.cod_prod and pr.cod_empresa = c.cod_empresa ' +
   ' where (c.data_pedido >= :data_ini and c.data_pedido <= :data_fim) and c.cod_empresa = :cod_empresa ';
  if FiltrarVendedor then
    buscas.SQL.Text := buscas.SQL.Text + ' and c.cod_vendedor = ' + CodVendedor;
  buscas.SQL.Text := buscas.SQL.Text + ' union ' +
   ' select r.cod_vendedor, ''RES'' tipo, r.num_fab_prod, r.descr_prod, pr.locacao_prod, pr.locacao_prod_1, r.data, ' +
   ' case when (r.data_ver is null) then ''PEND'' else ''DISP'' end, r.codigo, ''RES'', r.quant, null, null from reserva_almoxarifado_itens r ' +
   ' left join produtos pr on pr.grupo_prod = r.grupo_prod and pr.cod_prod = r.cod_prod and pr.cod_empresa = r.cod_empresa ' +
   ' where (r.data >= :data_ini and r.data <= :data_fim) and r.cod_empresa = :cod_empresa ';
  if FiltrarVendedor then
    buscas.SQL.Text := buscas.SQL.Text + ' and r.cod_vendedor = ' + CodVendedor;
  buscas.SQL.Text := buscas.SQL.Text + pOrdem;
  buscas.ParamByName('DATA_INI').AsDate := datainicial;
  buscas.ParamByName('DATA_FIM').AsDate := datafinal;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.Open;
end;

