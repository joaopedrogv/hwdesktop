            end;
            vValorTotDoc := vValorTotDoc + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotTipo:= vValorTotTipo+ Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotPag := vValorTotPag + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotRel := vValorTotRel + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotOp  := vValorTotOp  + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
            vValorTotDia := vValorTotDia + Buscas.FieldByName('VALOR_A_RECEBER').AsCurrency;
          end;
        end;

        if (Buscas.FieldByName('QTDE_PREST').AsInteger > 1)
        	and (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
        begin
          if (vLoteTemp <> Buscas.FieldByName('LOTEREC').AsInteger) then
            vExibirTotInfCliente := true
          else
            vExibirTotInfCliente := false;
        end
        else
          vExibirTotInfCliente := false;

        if (vExibirTotInfCliente)
        	and (trim(TipoRelatorio) = 'ANALÍTICO')
          and (trim(ExibirDetalhesRec) = 'SIM') then
        begin
          Rdp.ImpD(linha, 104, Format('%f', [vValorTotDoc]), [comp17, negrito]);
          vValorTotDoc := 0;
          linha := linha + 1;
        end;

         //ATUALIZAR
        vLote := buscas.FieldByName('LOTEREC').AsInteger;
        vSeqId := buscas.FieldByName('SEQID').AsInteger;
        //
        vTipoRec := vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'VEICULOS', 'VEICULOS',
          vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'ECOMMERCE', 'ECOMMERCE',
          	vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'SERVICOS', 'SERVICOS',
		          vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'RECIBO ANTECIPADO', 'RECIBO ANTECIPADO',
              	vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'LANCAMENTO AVULSO', 'LANCAMENTO AVULSO',
                	vDadosIni.IfThen(trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'PRESTACOES', 'PRESTACOES',
           					'BALCAO'))))));

        vTipo := trim(buscas.FieldByName('TIPO').AsString);
        vNumDoc := buscas.FieldByName('NUM_DOC').asstring;

        //INCPREST
        if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
        begin
          vTotValorPagoLote := 0;
          vInc := 0;
        end;

        if ((vLote = buscas.FieldByName('LOTEREC').AsInteger)
        	and (vSeqId <> buscas.FieldByName('SEQID').AsInteger)
          and (buscas.FieldByName('QTDE_PREST').AsInteger > 1)) then
        begin
          vInc := vInc + 1;
        end
        else if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
        begin
          vInc := 1;
          vIncTemp := 0;
        end;

        if (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
        begin
          if (vLoteTemp <> Buscas.FieldByName('LOTEREC').AsInteger) then
          begin
            vLoteTemp := Buscas.FieldByName('LOTEREC').AsInteger;
            vExibirInfRec := true;
          end
          else
            vExibirInfRec := false;
        end
        else
          vExibirInfRec := false;

        if (vExibirInfRec)
        	and (trim(TipoRelatorio) = 'ANALÍTICO')
          and (trim(ExibirDetalhesRec) = 'SIM') then
        begin
          ChecarFimdePagina;
          Rdp.ImpF(linha, 21, vDadosIni.replicate('-', 113), [comp17, negrito]);
          linha := linha + 1;
          Rdp.Imp(linha, 21, '|TP RECEB');
          Rdp.Imp(linha, 37, 'CTRL');
          Rdp.Imp(linha, 53, 'N.DOC');
          Rdp.Imp(linha, 65, 'VL DOC');
          Rdp.Imp(linha, 77, 'N.PROC');
          Rdp.Imp(linha, 89, 'DATA VEN');
          Rdp.Imp(linha, 105, 'N.DATA MOV');
          linha := linha + 1;
          Rdp.Imp(linha, 21, '|');
          linha := linha + 1;
        end;

        if trim(Buscas.FieldByName('TP_RECEBIMENTO').AsString) <> 'PRESTACOES' then
	          vExibirDadosRec := true
        else if (vInc = Buscas.FieldByName('QTDE_PREST').AsInteger) then
  	        vExibirDadosRec := true
        else
    	      vExibirDadosRec := false;

       if (vInc = buscas.FieldByName('QTDE_PREST').AsInteger) then
       begin
         if (vLote <> buscas.FieldByName('LOTEREC').AsInteger) then
           vTotValorPagoLote := buscas.FieldByName('VALOR_PAGO').AsFloat
         else
           vTotValorPagoLote := vTotValorPagoLote + buscas.FieldByName('VALOR_PAGO').AsFloat;

         vDiaMov := FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DIA_CXL').AsDateTime);
         if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'VEICULOS' then
           vTipoMov := 'VEICULOS'
         else if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'SERVICOS' then
           vTipoMov := 'SERVICOS'
         else if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'ECOMMERCE' then
           vTipoMov := 'ECOMMERCE'
         else if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'RECIBO ANTECIPADO' then
           vTipoMov := 'RECIBO ANTECIPADO'
         else if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'LANCAMENTO AVULSO' then
           vTipoMov := 'LANCAMENTO AVULSO'
         else if trim(buscas.FieldByName('TP_RECEBIMENTO').AsString) = 'PRESTACOES' then
           vTipoMov := 'PRESTACOES'
         else
           vTipoMov := 'BALCAO';
       end;

       if (vExibirDadosRec) then
       begin
         if (trim(TipoRelatorio) = 'ANALÍTICO')
           and (trim(ExibirDetalhesRec) = 'SIM') then
         begin
         	 if buscas.FieldByName('CODIGO_CTRL').AsCurrency > 0 then
           begin
             Rdp.Imp(linha, 21, '|' + buscas.FieldByName('TP_RECEBIMENTO2').AsString);
             Rdp.Imp(linha, 37, Copy(trim(buscas.FieldByName('NOME_CTRL').AsString), 1, 12));

             Rdp.Imp(linha, 53, Copy(trim((buscas.FieldByName('NUM_DOC2').AsString)), 1, 10));

             Rdp.ImpD(linha, 71, Format('%f', [buscas.FieldByName('VALOR_PAGO').AsCurrency]), [comp17]);

             Rdp.impD(linha, 83, buscas.FieldByName('LOTEREC').AsString, [comp17]);
             Rdp.imp(linha, 89, buscas.FieldByName('DATA_VENC').AsString);
             Rdp.imp(linha, 105, buscas.FieldByName('DATA_MOV').AsString);

             linha := linha + 1;
           end;
         end;

         vValorTotDoc := vValorTotDoc + Buscas.FieldByName('VALOR_PAGO').AsCurrency;
//         if (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'RECIBO') and (trim(Buscas.FieldByName('TP_RECEBIMENTO2').AsString) <> 'DEVOLUCAO') then
         begin
         	 vValorRecTipo := vValorRecTipo + buscas.FieldByName('VALOR_PAGO').AsCurrency;
           vValorRecPag := vValorRecPag + buscas.FieldByName('VALOR_PAGO').AsCurrency;
           vValorRecOP  := vValorRecOP  + buscas.FieldByName('VALOR_PAGO').AsCurrency;
  	       vValorRecDia := vValorRecDia + buscas.FieldByName('VALOR_PAGO').AsCurrency;
	         vValorRecRel := vValorRecRel + buscas.FieldByName('VALOR_PAGO').AsCurrency;
         end;

         verificarDtSetTemp;
       end;

       ChecarFimdePagina;

       verificarFimdeRegistros;

       frmRelatorios.ProgressBar.position := frmRelatorios.ProgressBar.position + 1;
       buscas.next;
     end;

     buscasEmp.Next;
   end;

   Rdp.Fechar;
   buscas.close;
   vDadosIni.GravaAuditoria('REL062', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
	 buscas.Close;
 	 frmRelatorios.ProgressBar.position := 0;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.ImprimirControles(
  totGeral: boolean);
var
 vValorTotTemp, vValorTotTempRec, vValorTotGTemp, vValorTotRTemp, vValorTotRNaoGeraFinancTemp: Double;
 vValorTemp: Double;
 vPercTemp: Double;
 vPerc: Double;
begin
	if trim(ExibirTotatis) <> 'SIM' then
  begin
	  linha := linha + 1;
    exit;
  end;

  vValorTotTemp := 0;
  vValorTotTempRec := 0;
  vValorTemp := 0;
  vPercTemp := 0;

  ChecarFimdePagina;

  if (not totGeral) then
  begin
    if trim(vTipoRec) = 'BALCAO' then
      fTempRec.Filter := 'TIPO = ''B'' '
    else if trim(vTipoRec) = 'SERVICOS' then
      fTempRec.Filter := 'TIPO = ''S'' '
    else if trim(vTipoRec) = 'ECOMMERCE' then
      fTempRec.Filter := 'TIPO = ''E'' '
    else if trim(vTipoRec) = 'RECIBO ANTECIPADO' then
      fTempRec.Filter := 'TIPO = ''R'' '
    else if trim(vTipoRec) = 'PRESTACOES' then
      fTempRec.Filter := 'TIPO = ''P'' '
    else if trim(vTipoRec) = 'LANCAMENTO AVULSO' then
      fTempRec.Filter := 'TIPO = ''L'' '
    else if trim(vTipoRec) = 'VEICULOS' then
      fTempRec.Filter := 'TIPO = ''V'' ';

    fTempRec.Filter := fTempRec.Filter + ' AND DIA_CXL = ' + QuotedStr(vDiaCXL);
    fTempRec.Filter := fTempRec.Filter + ' AND OP_CXL = ' + IntToStr(vOpCXL);

    fTempRec.Filtered := True;
    fTempRec.IndexFieldNames := 'CONTROLE;';
  end;

  if fTempRec.IsEmpty then
  	exit;

  if (totGeral) and (linha + fTempRecTot.RecordCount + 2 >= 60) then
  begin
  	linha := 2;
    CabNovaPagina;
  end
  else if (not totGeral) and (linha + fTempRec.RecordCount + 2 >= 60) then
  begin
    linha := 2;
    CabNovaPagina;
  end
  else if (not totGeral) then
	  linha := linha + 1;


  if (not totGeral) then
  begin
    if trim(vTipoRec) = 'VEICULOS' then
      Rdp.ImpF(linha, 1, 'TOTAL VEICULOS:', [comp17, negrito])
    else if trim(vTipoRec) = 'BALCAO' then
      Rdp.ImpF(linha, 1, 'TOTAL BALCAO:', [comp17, negrito])
    else if trim(vTipoRec) = 'SERVICOS' then
      Rdp.ImpF(linha, 1, 'TOTAL SERVICOS:', [comp17, negrito])
    else if trim(vTipoRec) = 'ECOMMERCE' then
      Rdp.ImpF(linha, 1, 'TOTAL ECOMMERCE:', [comp17, negrito])
    else if trim(vTipoRec) = 'RECIBO ANTECIPADO' then
      Rdp.ImpF(linha, 1, 'TOTAL RECIBO:', [comp17, negrito])
    else if trim(vTipoRec) = 'LANCAMENTO AVULSO' then
      Rdp.ImpF(linha, 1, 'TOTAL LANCAMENTO:', [comp17, negrito])
    else if trim(vTipoRec) = 'PRESTACOES' then
      Rdp.ImpF(linha, 1, 'TOTAL PRESTACOES:', [comp17, negrito]);
    Rdp.ImpD(linha, 38, Format('%n', [vValorTotTipo]), [comp17, negrito]);
    vValorTotPag := 0;

    Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
    Rdp.ImpD(linha, 115, Format('%n', [vValorRecTipo]), [comp17, negrito]);
    vValorRecPag := 0;
    linha := linha + 1;
  end;

  if not totGeral then
    Rdp.ImpF(linha, 1, 'TOTAIS', [comp17, negrito]);

  if (not totGeral) then
  begin
    Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
    Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
    Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);
  end;

 if not totGeral then
 begin
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
      	vValorTotTempRec := vValorTotTempRec + fTempRec.FieldByName('VALOR').AsCurrency
      else
	      vValorTotTemp := vValorTotTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      fTempRec.Next;
    end;

    vValorTotGTemp              := 0;
    vValorTotRTemp              := 0;
    vValorTotRNaoGeraFinancTemp := 0;
    fTempRec.First;
    while not fTempRec.Eof do
    begin
      vPerc := 0;
    	if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
      	vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency
      else
      begin
      	if fTempRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
        	vValorTemp := vValorTemp + 0
        else if fTempRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
        	vValorTemp := vValorTemp + 0
        else
		      vValorTemp := vValorTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      end;

      if (vValorTotTemp + vValorTotTempRec = 0) then
    	  vPerc := 0
      else if fTempRec.FieldByName('VALOR').AsCurrency <= 0 then
      	vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
      else if fTempRec.FieldByName('VALOR').AsCurrency > 0 then
      	vPerc := (fTempRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
    	vPercTemp := vPercTemp + vPerc;

      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
      begin
      	linha := linha + 1;
        if trim(fTempRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
          Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
        else
       	  Rdp.Imp(linha, 21, fTempRec.FieldByName('CONTROLE').asstring);
        Rdp.ImpD(linha, 71, Format('%n', [fTempRec.FieldByName('VALOR').AsCurrency]), [comp17]);
        Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

        ChecarFimdePagina;
      end;

      vValorTotGTemp := vValorTotGTemp + fTempRec.FieldByName('VALOR').AsCurrency;
      if (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
        and (trim(fTempRec.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
		      vValorTotRTemp := vValorTotRTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      if (trim(fTempRec.FieldByName('NAO_GERA_FINAN').asstring) = 'S') then
      	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + fTempRec.FieldByName('VALOR').AsCurrency;

      fTempRec.Next;
    end;

    fTempRec.EmptyDataSet;
  end;

  if not totGeral then
  begin
    if ((trim(vTipoRec) = 'BALCAO'))
      or (trim(vTipoRec) = 'SERVICOS')
      or (trim(vTipoRec) = 'ECOMMERCE')
      or (trim(vTipoRec) = 'RECIBO ANTECIPADO')
      or (trim(vTipoRec) = 'PRESTACOES')
      or (trim(vTipoRec) = 'LANCAMENTO AVULSO')
      or (trim(vTipoRec) = 'VEICULOS') then
    begin
      linha := linha + 1;
      Rdp.ImpF(linha, 21, 'TOTAL RECEBIMENTO....: ' + Format('%n', [vValorTotRTemp]), [comp17, negrito]);
      Rdp.ImpD(linha, 71, Format('%n', [vValorTotGTemp]), [comp17, negrito]); //vValorTemp
      Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);

      linha := linha + 1;
    	Rdp.ImpF(linha, 21, 'TOTAL GERA FINANCEIRO: ' + Format('%n', [vValorTotRTemp - vValorTotRNaoGeraFinancTemp]), [comp17, negrito]);
    end;
  end;
  
  if not (totGeral) then
  begin
  	linha := linha + 1;
    
//    ImprimirTotalPagina(totGeral);
  end;

	if not totGeral then
  begin
  	linha := linha + 1;
//    Rdp.ImpF(linha,1, vDadosIni.Replicate('-',133),[comp17]);
//    linha := linha + 1;
  end;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.ImprimirTotalDiario;
var
  vValorTotTemp, vValorTotTempRec, vValorTotGTemp, vValorTotRTemp, vValorTotRNaoGeraFinancTemp: Double;
  vValorTemp: Double;
  vPercTemp: Double;
  vPerc: Double;
begin
	vValorTotTemp := 0;
  vValorTotTempRec := 0;
  vValorTemp := 0;
  vPercTemp := 0;

  ChecarFimdePagina;

  ftempDiaRec.Filter := 'DIA_CXL = ' + QuotedStr(vDiaCXL);
  ftempDiaRec.Filtered := True;
  ftempDiaRec.IndexFieldNames := 'CONTROLE;';

  if ftempDiaRec.IsEmpty then
    exit;

  if trim(ExibirTotatis) = 'SIM' then
  begin
    if (linha + ftempDiaRec.RecordCount + 2 >= 60) then
    begin
      linha := 2;
      CabNovaPagina;
    end;;
  end;

	Rdp.ImpF(linha, 1, 'TOTAL ' + vDiaCXL, [normal, negrito]);
	linha := linha + 1;

  Rdp.ImpF(linha, 1, 'TOTAL DOCUMENTOS:', [comp17, negrito]);
  Rdp.ImpD(linha, 38, Format('%n', [vValorTotDia]), [comp17, negrito]);
  vValorTotDia := 0;
  Rdp.ImpF(linha, 77, 'TOTAL RECEBIMENTO:', [comp17, negrito]);
  Rdp.ImpD(linha, 115, Format('%n', [vValorRecDia]), [comp17, negrito]);
  vValorRecDia := 0;

  linha := linha + 1;

  if trim(ExibirTotatis) <> 'SIM' then
  begin
  	Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 133), [comp17, negrito]);
    linha := linha + 1;
    exit;
  end;

  Rdp.ImpF(linha, 21, 'CONTROLES', [comp17, negrito]);
  Rdp.ImpF(linha, 66, 'VALOR', [comp17, negrito]);
  Rdp.ImpF(linha, 78, 'PERCENTUAL', [comp17, negrito]);

  ftempDiaRec.First;
  while not ftempDiaRec.Eof do
  begin
    if ftempDiaRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
      vValorTotTempRec := vValorTotTempRec + ftempDiaRec.FieldByName('VALOR').AsCurrency
    else if ftempDiaRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
      vValorTotTempRec := vValorTotTempRec + ftempDiaRec.FieldByName('VALOR').AsCurrency
    else
      vValorTotTemp := vValorTotTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency;
    ftempDiaRec.Next;
  end;

  vValorTotGTemp              := 0;
  vValorTotRTemp              := 0;
  vValorTotRNaoGeraFinancTemp := 0;
  ftempDiaRec.First;
  while not ftempDiaRec.Eof do
  begin
    vPerc := 0;
    if ftempDiaRec.FieldByName('VALOR').AsCurrency <= 0 then
      vValorTemp := vValorTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency
    else
    begin
      if ftempDiaRec.FieldByName('CONTROLE').AsString = '* RECIBO (APENAS INFORMATIVO)' then
        vValorTemp := vValorTemp + 0
      else if ftempDiaRec.FieldByName('CONTROLE').AsString = '* DEVOLUCAO (APENAS INFORMATIVO)' then
        vValorTemp := vValorTemp + 0
      else
        vValorTemp := vValorTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency;
    end;

    if (vValorTotTemp + vValorTotTempRec = 0) then
    	vPerc := 0
    else if ftempDiaRec.FieldByName('VALOR').AsCurrency <= 0 then
      vPerc := (ftempDiaRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100
    else if ftempDiaRec.FieldByName('VALOR').AsCurrency > 0 then
      vPerc := (ftempDiaRec.FieldByName('VALOR').AsCurrency / (vValorTotTemp + vValorTotTempRec)) * 100;
    vPercTemp := vPercTemp + vPerc;

    if (trim(ftempDiaRec.FieldByName('CONTROLE').asstring) <> 'SEM FORMA') then
    begin
      linha := linha + 1;
      if trim(ftempDiaRec.FieldByName('NAO_GERA_FINAN').AsString) = 'S' then
        Rdp.Imp(linha, 21, ftempDiaRec.FieldByName('CONTROLE').asstring + ' (NAO GERA FINANCEIRO)')
      else
        Rdp.Imp(linha, 21, ftempDiaRec.FieldByName('CONTROLE').asstring);
      Rdp.ImpD(linha, 71, Format('%n', [ftempDiaRec.FieldByName('VALOR').AsCurrency]), [comp17]);
      Rdp.ImpD(linha, 88, Format('%f', [vPerc]) + '%', [comp17]);

      ChecarFimdePagina;
    end;

    vValorTotGTemp := vValorTotGTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency;
    if (trim(ftempDiaRec.FieldByName('CONTROLE').asstring) <> '* DEVOLUCAO (APENAS INFORMATIVO)')
      and (trim(ftempDiaRec.FieldByName('CONTROLE').asstring) <> '* RECIBO (APENAS INFORMATIVO)') then
        vValorTotRTemp := vValorTotRTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency;

    if (trim(ftempDiaRec.FieldByName('NAO_GERA_FINAN').asstring) = 'S') then
      	vValorTotRNaoGeraFinancTemp := vValorTotRNaoGeraFinancTemp + ftempDiaRec.FieldByName('VALOR').AsCurrency;

    ftempDiaRec.Next;
  end;
  ftempDiaRec.EmptyDataSet;

  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL RECEBIMENTO....: ' + Format('%n', [vValorTotRTemp]), [comp17, negrito]);
  Rdp.ImpD(linha, 71, Format('%n', [vValorTotGTemp]), [comp17, negrito]); //vValorTemp
  Rdp.ImpD(linha, 88, Format('%f', [vPercTemp]) + '%' , [comp17, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 21, 'TOTAL GERA FINANCEIRO: ' + Format('%n', [vValorTotRTemp - vValorTotRNaoGeraFinancTemp]), [comp17, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.replicate('-', 133), [comp17, negrito]);
  linha := linha + 1;
end;

procedure TRelatorioRecebimentosCaixaAuxiliar.ImprimirTotalDocumento;
begin
	if (trim(TipoRelatorio) = 'ANALÍTICO')
