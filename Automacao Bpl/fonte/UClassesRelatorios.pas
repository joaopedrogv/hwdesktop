          ' and ((nf.emissao_propria = ''S'' and nf.modelo_nf = ''55'' and coalesce(nf.situacao_nfe,'''') = ''Autorizada'' ) ' +
          ' or (nf.emissao_propria = ''S'' and nf.modelo_nf <> ''55'') or (nf.emissao_propria = ''N'') ) ' +
          ' and coalesce(nf.da, '''') <> ''S'' ' +
          ' group by 1,2,3,4,5,6,7 ' +
          ' union ' +
          ' select ''S'' NATUREZA,' +
          ' 0 NUMDOC, 0 DATA, 0 SERIE, 0 MODELO, 0 COD_CLI, case when (coalesce(cp2.codigo_nop,'''') <>'''') then cp2.codigo_nop else p.codigo_nop end CFOP, sum(cp2.total) VALOR_TOTAL,' +
          ' sum(coalesce(CP2.total,0) + coalesce(cp2.rat_acres,0) + coalesce(cp2.perc_acresc,0) - coalesce(cp2.rat_desc,0) - coalesce(cp2.perc_desc,0) ) VALOR_LIQUIDO, ' +
          ' sum(case when (cp2.aliquota_it =''FF'')then ' +
          ' coalesce(CP2.total,0) + coalesce(cp2.rat_acres,0) + coalesce(cp2.perc_acresc,0) - coalesce(cp2.rat_desc,0) - coalesce(cp2.perc_desc,0) ' +
          ' else 0 end) OUTRAS_DES, ' +
          ' sum(case when ((cp2.aliquota_it =''II'') or (cp2.aliquota_it =''NN''))then ' +
          ' coalesce(CP2.total,0) + coalesce(cp2.rat_acres,0) + coalesce(cp2.perc_acresc,0) - coalesce(cp2.rat_desc,0) - coalesce(cp2.perc_desc,0) else  0 end) VALOR_ISENTO, ' +
          ' sum(case when (((cp2.aliquota_it <>''II'') and (cp2.aliquota_it <>''NN'') and coalesce(al.aliq,0) > 0))then ' +
          ' (coalesce(CP2.total,0) + coalesce(cp2.rat_acres,0) + coalesce(cp2.perc_acresc,0) - coalesce(cp2.rat_desc,0) - coalesce(cp2.perc_desc,0)) ' +
