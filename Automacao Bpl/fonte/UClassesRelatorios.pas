procedure TRelatorioFinVendaModalidadePag.ImprimeRelatorios;
var
  vtmodal: Currency;
  vtgera_receb: Currency;
  vtgera_financ: Currency;
begin
  inherited;

  if not vDadosIni.PesqPros('REL050', 'IMPRIMIR', '', '', '', buscas, false) then
    Exit;

  if not abreVendasModalidade then
  begin
//    Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//    exit;
  end;
  vtmodal := 0;
  vtgera_receb := 0;
  vtgera_financ := 0;
  vpag := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório de venda por modalidade de pagamento';
  rdp.TitulodoRelatorio := 'Financeiro - Venda por modalidade de pagamento';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;

  CabNovaPagina; //cabeçalho

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    if variavel_parar then
    begin
      if confirmaparar then
      begin
//        Parar;
        Exit;
      end;
    end;

    if trim(buscas.FieldByName('NOME_CTRL').AsString) = 'RECIBO ANTECIPADO' then
    	Rdp.Imp(linha, 1, '* ' + trim(buscas.FieldByName('NOME_CTRL').AsString) + ' (APENAS INFORMATIVO)')
		else if buscas.FieldByName('NAO_GERA_FINAN').AsString = 'S' then
      Rdp.Imp(linha, 1, trim(buscas.FieldByName('NOME_CTRL').AsString) + ' (NAO GERA FINANCEIRO)')
    else
      Rdp.Imp(linha, 1, trim(buscas.FieldByName('NOME_CTRL').AsString));

    Rdp.ImpD(linha, 85, format('%n', [buscas.FieldByName('VALORDOC').AsCurrency]), [comp17]);

    vtmodal := vtmodal + buscas.FieldByName('VALORDOC').AsCurrency;
    if trim(buscas.FieldByName('NOME_CTRL').AsString) <> 'RECIBO ANTECIPADO' then
    begin
    	vtgera_receb := vtgera_receb + buscas.FieldByName('valordoc').AsCurrency;

      if buscas.FieldByName('NAO_GERA_FINAN').AsString <> 'S' then
      	vtgera_financ := vtgera_financ + buscas.FieldByName('valordoc').AsCurrency;
    end;

    linha := linha + 1;
    if linha >= 58 then
      CabNovaPagina;

    buscas.next;
    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;

  Rdp.ImpF(linha, 1, 'TOTAL RECEBIMENTO....: ' + format('%m', [vtgera_receb]), [comp17, negrito]);
  if linha >= 58 then
    CabNovaPagina;

  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TOTAL GERA FINANCEIRO: ' + format('%m', [vtgera_financ]), [comp17, negrito]);
  if linha >= 58 then
    CabNovaPagina;

  linha := linha + 2;
  Rdp.ImpF(linha, 1, 'TOTAL:', [comp17, negrito]);
  Rdp.ImpD(linha, 85, format('%m', [vtmodal]), [comp17, negrito]);

  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL050', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
  frmRelatorios.ProgressBar.Position := 0;
  buscas.Close;
end;

