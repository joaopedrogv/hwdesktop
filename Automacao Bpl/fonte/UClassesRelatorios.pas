function TRelatoriosdeRecibos.abreHistoricoRec: Boolean;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      Result := False;
      //Recibos emitidos
      buscas.Close;
      buscas.SQL.Text := ' SELECT H.*, REC.NUM_REC_DEP FROM HIST_REC H ' +
        ' INNER JOIN RECIBOS REC ON REC.NRECIBO = H.NRECIBO AND REC.COD_EMPRESA = H.COD_EMPRESA ' +
        ' where H.data_baixa >= :dti and H.data_baixa <= :dtf ' +
        ' and H.cod_empresa = ' + vDadosIni.codEmpresa + ' and H.ativo=1 and (H.RECANT= ''S'' or H.RECANT = ''O'')';
      //    if DepartamentoRec <> 'TODOS' then
      //      buscas.SQL.Text := buscas.SQL.Text + ' and r.DEPREC = ' + quotedstr(copy(DepartamentoRec, 1, 1));
      buscas.SQL.Text := buscas.SQL.Text + ' order by SEQCAD_REC ';
      buscas.Params.ParamByName('dti').AsDate := datainicial;
      buscas.Params.ParamByName('dtf').AsDate := datafinal;
      buscas.Open;
//      if not (buscas.IsEmpty) then
        result := true
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

function TRelatoriosdeRecibos.abreInventarioRecibos: Boolean;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      Result := False;
      //Recibos emitidos
      buscas.Close;
      buscas.SQL.Text := ' select r.*, cl.nome_cliente, dp.nome_depto from recibos r ' +
        ' left join depto dp on dp.cod_depto = r.cod_depto ' +
        ' left join clientes cl on r.cod_benef = cl.cod_cliente and r.cod_empresa = cl.cod_empresa ' +
        ' where r.data_rec <= :dtref and ((r.data_baixa > :dtref) or (r.data_baixa is null)) ' +
        ' and (r.recant = ''S'' or r.recant = ''O'') and r.cod_empresa = ' + vDadosIni.codEmpresa + ' and r.ativo=1 ';
      if DepartamentoRec <> 'TODOS' then
        buscas.SQL.Text := buscas.SQL.Text + ' and dp.NOME_DEPTO = ' + quotedstr(trim(DepartamentoRec));
      buscas.SQL.Text := buscas.SQL.Text + ' order by r.nrecibo,r.data_rec ';
      buscas.Params.ParamByName('dtref').AsDate := dataReferencia;
      buscas.Params.ParamByName('dtref').AsDate := dataReferencia;
      buscas.Open;
//      if not (buscas.IsEmpty) then
        result := true
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

function TRelatoriosdeRecibos.abreRecibosEmitidos: Boolean;
begin
  try
    Screen.Cursor := crHourGlass;
    try
      Result := False;
      //Recibos emitidos
      buscas.Close;
      if StatusRec = 'CONFIRMADO' then
      begin
        buscas.SQL.Text := ' select r.*, cl.nome_cliente, dp.nome_depto from recibos r ' +
          ' left join depto dp on dp.cod_depto = r.cod_depto ' +
          ' left join clientes cl on r.cod_benef = cl.cod_cliente and r.cod_empresa = cl.cod_empresa ' +
          ' where r.data_baixa >= :dti and r.data_baixa <= :dtf ' +
          ' and (not r.status_rec is null) ' +
          ' and (r.recant = ''S'' or r.recant = ''O'') and r.cod_empresa = ' + vDadosIni.codEmpresa + ' and r.ativo=1 '
      end
      else
        buscas.SQL.Text := ' select r.*, cl.nome_cliente, dp.nome_depto from recibos r ' +
          ' left join depto dp on dp.cod_depto = r.cod_depto ' +
          ' left join clientes cl on r.cod_benef=cl.cod_cliente and r.cod_empresa=cl.cod_empresa ' +
          ' where r.data_rec >= :dti and r.data_rec <= :dtf ' +
          ' and ((status_rec is null) or (status_rec = '''')) ' +
          ' and (r.recant = ''S'' or r.recant = ''O'') and r.cod_empresa = ' + vDadosIni.codEmpresa + ' and r.ativo=1 ';
      if DepartamentoRec <> 'TODOS' then
        buscas.SQL.Text := buscas.SQL.Text + ' and dp.NOME_DEPTO = ' + quotedstr(trim(DepartamentoRec));
      buscas.SQL.Text := buscas.SQL.Text + ' order by r.nrecibo,r.data_rec ';
      buscas.Params.ParamByName('dti').AsDate := datainicial;
      buscas.Params.ParamByName('dtf').AsDate := datafinal;
      buscas.Open;
//      if not (buscas.IsEmpty) then
        result := true
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

procedure TRelatoriosdeRecibos.CabNovaPagina;
var
  buscas2: TIBQuery;
begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if vpag > 0 then
    Rdp.Novapagina;
  linha := 2;

  if TipoRec <> 'HISTORICO RECIBOS' then
  begin
    Rdp.ImpF(linha, 1, trim(vDadosIni.vEmp.vnomeEmpresa), [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'RELATORIO DE RECIBOS', [normal, negrito]);
    linha := linha + 1;
    if TipoRec = 'RECIBOS EMITIDOS' then
      Rdp.ImpF(linha, 1, 'NO PERIODO DE: ' + datetostr(datainicial) + ' A ' + datetostr(datafinal), [normal, negrito])
