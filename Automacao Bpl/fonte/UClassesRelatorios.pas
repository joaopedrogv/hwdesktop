procedure TRelatoriosVendasProgFid.ImprimeRelatorios;
var                                  
  vdata: string;
  buscas2: TIBQuery;
  vdia: TDateTime;
  totvaled, totvalord: Double;
  totvaleg, totvalorg: Double;

  procedure imprimirtotaldiario;
  begin
    Rdp.ImpF(linha, 1, vdata, [comp17, negrito]);
    Rdp.ImpD(linha, 107, FormatFloat('#,##0.00', RoundTo(totvaled, -2)), [comp17, negrito]);
    Rdp.ImpD(linha, 121, FormatFloat('#,##0.00', RoundTo(totvalord, -2)), [comp17, negrito]);
    linha := linha + 2;
    totvalord := 0;
    totvaled := 0;
  end;

begin
  if not vDadosIni.PesqPros('REL052', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;

  vdata := '';
  totvaled := 0;
  totvaleg := 0;
  totvalord := 0;
  totvalorg := 0;

  variavel_parar := false;
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if not abreRelatoriosVendasProgFid then //abre query buscas
    exit;
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Documentos recebidos com vale resgate (Prog Fid)';
  rdp.TitulodoRelatorio := 'Documentos recebidos com vale resgate (Prog Fid)';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;
  vpag := 0;
  if not Rdp.EstaAberto then
    Rdp.Abrir;
  CabNovaPagina; //cabeçalho
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;
  while not buscas.eof do
  begin
    if (trim(vdata) <> '')
    	and (vdata <> FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data').AsDateTime))  then
      imprimirtotaldiario;

    if trim(TipoRelatorio) = 'ANALÍTICO' then
    begin
      Rdp.Imp(linha, 1, IntToStr(buscas.FieldByName('ndoc').AsInteger));
      Rdp.Imp(linha, 10, buscas.FieldByName('tipo').AsString);
      Rdp.Imp(linha, 15, Copy(trim(buscas.FieldByName('nome_cliente').AsString), 1, 54));
      Rdp.Imp(linha, 83, trim(buscas.FieldByName('doc_fiscal').AsString));
      Rdp.ImpD(linha, 107, FormatFloat('#,##0.00', RoundTo(buscas.FieldByName('valor_vale').AsFloat, -2)), [comp17]);
      Rdp.ImpD(linha, 121, FormatFloat('#,##0.00', RoundTo(buscas.FieldByName('valor_total').AsFloat, -2)), [comp17]);
      Rdp.impD(linha, 133, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data').AsDateTime), [comp17]);
    end;
    totvaleg := totvaleg + RoundTo(buscas.FieldByName('valor_vale').AsFloat, -2);
    totvaled := totvaled + RoundTo(buscas.FieldByName('valor_vale').AsFloat, -2);
    totvalorg := totvalorg + RoundTo(buscas.FieldByName('valor_total').AsFloat, -2);
    totvalord := totvalord + RoundTo(buscas.FieldByName('valor_total').AsFloat, -2);

    vdata := FormatDatetime('dd/mm/yyyy', buscas.FieldByName('data').AsDateTime);

    if trim(TipoRelatorio) = 'ANALÍTICO' then
      linha := linha + 1;
    if linha >= 60 then
      CabNovaPagina;
    buscas.next;

    if buscas.Eof then
      imprimirtotaldiario;

    frmRelatorios.ProgressBar.Position := frmRelatorios.ProgressBar.Position + 1;
  end;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('-', Rdp.TamanhoQteColunas));
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'TOTAL:', [comp17, negrito]);
  Rdp.ImpD(linha, 107, FormatFloat('#,##0.00', RoundTo(totvaleg, -2)), [negrito]);
  Rdp.ImpD(linha, 121, FormatFloat('#,##0.00', RoundTo(totvalorg, -2)), [negrito]);
  linha := linha + 1;
  Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));

  buscas.close;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.GravaAuditoria('REL052', 'IMPRIMIR', 'SUCESSO', '', '', buscas);
  frmRelatorios.ProgressBar.Position := 0;
end;

{ TRelatorioTitulosPorRota }

function TRelatorioTitulosPorRota.AbreTitulosPorRota: Boolean;
var
 vCtrls: string;
begin
   try
    Screen.Cursor := crHourGlass;
    vCtrls := '';
    try
      Result := False;

      dtSetCtrlTitRota.First;
      while not dtSetCtrlTitRota.Eof do
      begin
        if dtSetCtrlTitRota.FieldByName('sel').AsString = 'S' then
        begin
          if trim(vCtrls) = '' then
            vCtrls := IntToStr(dtSetCtrlTitRota.FieldByName('codigo_ctrl').AsInteger)
          else
            vCtrls := vCtrls + ',' + IntToStr(dtSetCtrlTitRota.FieldByName('codigo_ctrl').AsInteger);
        end;
        dtSetCtrlTitRota.Next;  
      end;
      dtSetCtrlTitRota.First;
      
      buscas.Close;
      buscas.SQL.Text :=
         ' select distinct r.cod_rota, ' +
         ' coalesce((select first 1 r2.ordem from rotas_entr_cliente r2 ' +
         '         where r2.cod_rota = r.cod_rota and r2.cod_empresa = r.cod_empresa and r2.cod_cliente = r.cod_cliente ' +
         '     order by r2.ordem asc), 0) ordem, ' +
         ' r.cod_empresa, ' +
         ' cc.cod_cred, cc.tp_doc_v, ' +
         ' (''CC ''||coalesce(cc.n_doc_v, '''')) n_doc_v, (''CC ''||coalesce(cc.n_doc_c,'''')) n_doc_c, ' +
         ' cc.data_rec_c, cc.data_venc_c, cc.status_c, cc.datq_c, ' +
         ' case when (coalesce(cc.valor_original, 0) > 0) then  coalesce(cc.valor_original, 0) else coalesce(cc.valor_c, 0) end valor_original, ' +
         ' coalesce(cc.valor_c, 0) valor_c, ' +
         ' case when (coalesce(cc.valor_corr, 0)) > 0 then coalesce(cc.valor_corr, 0) else coalesce(cc.valor_c, 0) end valor_corr, ' +
         ' coalesce(bc.valor_quitado, 0) valor_quitado, ' +
         ' bc.datq_c data_rec, ' +
         ' r.cod_cliente, cl.nome_cliente, cl.razao, coalesce(cd.nome_cidade, cl.cidade) cidade, ' +
         ' coalesce((select sum(coalesce(cc2.valor_c, 0)) from controle_creditos cc2 ' +
         '     where cc2.cod_cred = cc.cod_cred and cc2.codigo_emp = cc.codigo_emp), 0) valor_a_rec, ' +
         ' coalesce((select sum( ' +
         ' case when (coalesce(cc3.valor_corr, 0)) > 0 then coalesce(cc3.valor_corr, 0) else coalesce(cc3.valor_c, 0) end) ' +
         '  from controle_creditos cc3 ' +
         '     where cc3.cod_cred = cc.cod_cred and cc3.codigo_emp = cc.codigo_emp), 0) valor_a_rec_corr, coalesce(bc.seq_bxcred, 0) cod_baixa ' +
         '           from rotas_entr_cliente r ' +
         ' inner join controle_creditos cc on cc.cod_cliente = r.cod_cliente and cc.codigo_emp = r.cod_empresa ' +
         ' left join baixa_creditos bc on bc.cod_cred = cc.cod_cred and bc.codigo_emp = cc.codigo_emp ' +
         ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.codigo_emp ' +
         ' left join cidades cd on cd.cod_cidade = cl.cod_cidade ' +
         ' where cc.status_c is null and cc.datq_c is null and r.cod_rota = :cod_rota ' +
         ' and r.cod_empresa = :cod_empresa and cc.data_venc_c >= :data_ini and cc.data_venc_c <= :data_fim ' +
      	' and cc.codigo_ctrl in (' + vCtrls + ' ) ' +
         ' union all ' +
         ' select distinct r.cod_rota, ' +
         ' coalesce((select first 1 r2.ordem from rotas_entr_cliente r2 ' +
         '         where r2.cod_rota = r.cod_rota and r2.cod_empresa = r.cod_empresa and r2.cod_cliente = r.cod_cliente ' +
         '     order by r2.ordem asc), 0) ordem, ' +
         ' r.cod_empresa, ' +
         ' ch.codigo_ch, ch.tp_doc_v, ' +
         ' (''CH ''||coalesce(ch.n_doc_v, '''')) n_doc_v, (''CH ''||coalesce(ch.n_doc_v, '''')) n_doc_c, ' +
         ' ch.data_rec, ch.data_venc, ch.status_ch, ch.datq_ch, ' +
         ' coalesce(ch.valor_ch, 0) valor_ch, ' +
         ' coalesce(ch.valor_ch, 0) valor_ch, ' +
         ' case when (coalesce(ch.valor_corr, 0) > 0) then coalesce(ch.valor_corr, 0) else coalesce(ch.valor_ch, 0) end valor_corr, ' +
         ' 0 valor_quitado, ' +
         ' ch.datq_ch data_rec, ' +
         ' r.cod_cliente, cl.nome_cliente, cl.razao, coalesce(cd.nome_cidade, cl.cidade) cidade, ' +
         ' coalesce(ch.valor_ch, 0) valor_a_rec, ' +
         ' case when (coalesce(ch.valor_corr, 0)) > 0 then coalesce(ch.valor_corr, 0) else coalesce(ch.valor_ch, 0) end valor_a_rec_corr, 0 cod_baixa ' +
         '        from rotas_entr_cliente r ' +
         ' inner join controle_cheque ch on ch.cod_cliente = r.cod_cliente and ch.codigo_emp = r.cod_empresa ' +
         ' inner join clientes cl on cl.cod_cliente = ch.cod_cliente and cl.cod_empresa = ch.codigo_emp ' +
         ' left join cidades cd on cd.cod_cidade = cl.cod_cidade ' +
         ' where ch.status_ch is null and ch.datq_ch is null and r.cod_rota = :cod_rota ' +
         ' and r.cod_empresa = :cod_empresa and ch.data_venc >= :data_ini and ch.data_venc <= :data_fim ' +
         ' and ch.codigo_ctrl in (' + vCtrls + ' ) ' +
         ' order by 1, 2, 3, 4 ';
      buscas.Params.ParamByName('cod_rota').AsInteger := dtSetRota.FieldByName('cod_rota').AsInteger;
      buscas.Params.ParamByName('data_ini').AsDate := datainicial;
      buscas.Params.ParamByName('data_fim').AsDate := datafinal;
      buscas.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;
//      if not (buscas.IsEmpty) then
        result := true
//      else
//        Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
    except
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

