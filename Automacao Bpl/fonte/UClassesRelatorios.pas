function TRelatorioVendasGeral.RelVendaGeral: Boolean;
var
  videv: integer;
begin
  try
    result := false;
    if TipoRelatorio = 'ANALÍTICO' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select vp.tipo, vp.nped, vp.grupo_prod, vp.cod_prod, vp.descr_prod_ped, ' +
        ' vp.vltot_ped_item,vp.rateio_desc, vp.vlun_ped_item,vp.pcust_mc,vp.quant_ped_item, ' +
        ' ((vp.quant_ped_item * vp.vlun_ped_item)- (vp.quant_ped_item*vp.pcust_mc)-(vp.rateio_desc)+(vp.rateio_acresc)) as lucro,' +
        ' vp.comiss_prod,vp.comiss_prod_ger,vp.desc_funcao ' +
        ' from vendaprodutos vp ';
      if FiltrarAreaExec then
        buscas.SQL.Text := buscas.SQL.Text  +
        ' inner join tipo_vendas tp on tp.tipo = vp.tipo and (tp.sigla = vp.tipv or (tp.tipo_os = vp.tipo_os)) ';

      buscas.SQL.Text := buscas.SQL.Text +
      	' where vp.data_fech >= :dti ' +
        ' and vp.data_fech <= :dtf ' +
        ' and vp.cod_empresa = ' + vDadosIni.codEmpresa;

      if FiltrarTipoVenda and FiltrarTipoOS then
        buscas.SQL.Text := buscas.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' and vp.tipo=''REQ'')' +
          ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vp.tipo=''OS'') ' +
          ' or (vp.tipo=''DEV'' and vp.venda = ''S'' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ') or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + '))))'
      else if FiltrarTipoVenda then
        buscas.SQL.Text := buscas.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' and vp.tipo=''REQ'')' +
          ' or (not vp.TIPO_OS is null and vp.tipo=''OS'' and vp.venda = ''S'') ' +
          ' or (vp.tipo=''DEV'' and vp.venda = ''S'' and vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ')' +
          ' or (vp.tipo=''DEV'' and vp.venda = ''S'' and not vp.TIPO_OS is null)) '
      else if FiltrarTipoOS then
        buscas.SQL.Text := buscas.SQL.Text + ' and ((not vp.TIPV is null and vp.tipo=''REQ'' and vp.venda = ''S'')' +
          ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vp.tipo=''OS'') ' +
          ' or (vp.tipo=''DEV'' and vp.venda = ''S'' and vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ')' +
          ' or (vp.tipo=''DEV'' and vp.venda = ''S'' and not vp.TIPV is null) )'
      else
        buscas.SQL.Text := buscas.SQL.Text + ' and ((vp.tipo=''OS'') or (vp.tipo=''REQ'') or (vp.tipo=''DEV'')) and vp.venda = ''S'' ';

      if FiltrarVendedor then
        buscas.SQL.Text := buscas.SQL.Text + ' and ((vp.cod_vendedor in ' + CodVendedor + ') or (vp.col_cod_vendedor in ' + CodVendedor + ')) ';

      if FiltrarGrupo then
        buscas.SQL.Text := buscas.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;

      if FiltrarAreaExec then
        buscas.SQL.Text := buscas.SQL.Text +
