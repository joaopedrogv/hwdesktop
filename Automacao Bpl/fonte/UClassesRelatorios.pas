     if linha >= 60 then
     begin
       linha := 2;
       CabNovaPagina;
     end;
     inc(linha);
     Rdp.ImpF(linha, 1, 'Total ' + Copy(trim(vDadosIni.vPedVnd.descricaoParticipante), 1, 1) +
        copy(LowerCase(trim(vDadosIni.vPedVnd.descricaoParticipante)), 2, Length(trim(vDadosIni.vPedVnd.descricaoParticipante)) - 1), [negrito]);
     Rdp.ImpD(linha, 65, Format('%m', [vtotpart]), [negrito]);

     // Total geral
     if linha >= 58 then
