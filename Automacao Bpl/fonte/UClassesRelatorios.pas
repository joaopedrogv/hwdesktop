procedure TRelatorioVendasPorVendedor.Parar;
begin
  frmRelatorios.BitBtn1.Enabled := True;
  frmRelatorios.BitBtn2.Enabled := True;
  frmRelatorios.BitBtn3.Enabled := False;
end;
{
function TRelatorioVendasPorVendedor.RetornaQtdItensProdVendedor(pCodVendedor: integer;
  pTipo: string): integer;
begin
  try
    result := 0;
    buscasGerais.Close;
    buscasGerais.SQL.Text := 'select count(vp.nped) as qtdItemProd ' +
      ' from vendaprodutos vp where vp.data_fech>=:dti and vp.data_fech<=:dtf ';
    if (pTipo <> 'REQ') and (pTipo <> 'OS') then
    begin
      if FiltrarTipoVenda and FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' and vp.tipo=''REQ'')' +
          ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vp.tipo=''OS''))'
      else if FiltrarTipoVenda then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((vp.TIPV = ' + QuotedStr(trim(TipoVenda)) + ' and vp.tipo=''REQ'')' +
          ' or (not vp.TIPO_OS is null and vp.tipo=''OS''))'
      else if FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and ((not vp.TIPV is null and vp.tipo=''REQ'')' +
          ' or (vp.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vp.tipo=''OS''))'
      else
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.tipo<>''ORC'' ';
    end
    else
      buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.tipo=' + QuotedStr(trim(pTipo));

    if pTipo = 'REQ' then
    begin
      if FiltrarTipoVenda then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.TIPV = ' + QuotedStr(trim(TipoVenda));
    end
    else if pTipo = 'OS' then
      if FiltrarTipoOS then
        buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.TIPO_OS = ' + QuotedStr(trim(TipoOs));

    buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.cod_vendedor = ' + inttostr(pCodVendedor);

    if FiltrarGrupo then
      buscasGerais.SQL.Text := buscasGerais.SQL.Text + ' and vp.grupo_prod = ' + GrupoNum;
    buscasGerais.Params.ParamByName('dti').AsDate := datainicial;
    buscasGerais.Params.ParamByName('dtf').AsDate := datafinal;
    buscasGerais.Open;
    result := buscasGerais.FieldByName('qtdItemProd').AsInteger;
    buscasGerais.close;
  except

  end;
end;
}
