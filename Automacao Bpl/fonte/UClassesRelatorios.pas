procedure TRelatorioVeiculosemTransito.ImprimeRelatorios;
var
 vdesc: string;
 vcount, ix, vquant: integer;
 QrReservaT: TIBQuery;
begin
  if not vDadosIni.PesqPros('REL034', 'IMPRIMIR', '', '',
    '', buscas, false) then
    Exit;
  inherited;
    
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp; //S20cpp;
  Rdp.TamanhoQteColunas := 133;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Relatório Veículos em Trânsito';
  rdp.TitulodoRelatorio := 'Veículos em Trânsito';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  abreVeiculosemTransito;
//  if buscas.IsEmpty then
//  begin
//   Application.MessageBox('Resultado não encontrado para busca, favor verificar!', 'Atenção', MB_OK);
//   exit;
//  end;

  QrReservaT := TIBQuery.Create(Application);
  QrReservaT.Database := buscas.Database;
  QrReservaT.Transaction := buscas.Transaction;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  vpag := 0;
  vquant := 0;
  linha := 2;
  try
    Screen.Cursor := crHourGlass;
    variavel_parar := false;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    frmRelatorios.ProgressBar.Position := 0;
    frmRelatorios.ProgressBar.Min := 0;
    frmRelatorios.ProgressBar.Max := buscas.RecordCount;
    buscas.First;
  end;
  ix := 0;
  CabNovaPagina; //cabeçalho

 vdesc := trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString);

 buscas.First;
 While not buscas.eof do
 begin
  Application.ProcessMessages;
  if variavel_parar then
  begin
    if confirmaparar then
    begin
//        Parar;
      Exit;
    end;
  end;
  if trim(TipoRelatorio) = 'RESERVADA' then
  begin
   if not buscas.FieldByName('DATA_RES').IsNull then
   begin
    linha:=linha+1;
    if trim(vdesc) <> trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString) then
    begin
     vdesc:= trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString);
     Rdp.ImpF(linha,1,'* * * * QTDE: '+ vDadosIni.Strzero(vcount,5),[comp17]);
     linha:=linha+1;
     vcount:=0;
    end;
    Rdp.ImpF(linha,1, trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString),[comp17]);
    Rdp.ImpF(linha,20, trim(buscas.FieldByName('CHASSI_C').AsString),[comp17]);
    Rdp.ImpF(linha,41, buscas.FieldByName('ANO_FABEST').AsString,[comp17]);
    Rdp.ImpF(linha,50, buscas.FieldByName('ANO_MODEST').asstring,[comp17]);
    Rdp.ImpF(linha,90, trim(buscas.FieldByName('COREST').AsString),[comp17]);
    Rdp.ImpF(linha,102, vDadosIni.Strzero(buscas.FieldByName('NUM_NOTA').AsString,6),[comp17]);
    if trim(buscas.FieldByName('SIT_RES').AsString) = 'V' then
     Rdp.ImpF(linha,116,'Reservada Vendida',[comp17])
    else
     Rdp.ImpF(linha,116,'Reservada N Vendida',[comp17]);
    vcount:=vcount+1;
    vquant := vquant + 1;
   end;
  end
  else if trim(TipoRelatorio) = 'NÃO RESERVADA' then
  begin
    if buscas.FieldByName('DATA_RES').IsNull then
    begin
     linha:=linha+1;
     if trim(vdesc) <> trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString) then
     begin
      vdesc := trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString);
      Rdp.ImpF(linha,1,'* * * * QTDE: '+ vDadosIni.strzero(vcount,5),[comp17]);
      linha:=linha+1;
      vcount:=0;
     end;
     Rdp.ImpF(linha,1, trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString),[comp17]);
     Rdp.ImpF(linha,20, trim(buscas.FieldByName('CHASSI_C').AsString),[comp17]);
     Rdp.ImpF(linha,41, buscas.FieldByName('ANO_FABEST').asstring,[comp17]);
     Rdp.ImpF(linha,50, buscas.FieldByName('ANO_MODEST').asstring,[comp17]);
     Rdp.ImpF(linha,90, buscas.FieldByName('COREST').AsString,[comp17]);
     Rdp.ImpF(linha,102, vDadosIni.Strzero(buscas.FieldByName('NUM_NOTA').AsString,6),[comp17]);
     Rdp.ImpF(linha,116,'Sem Reserva',[comp17]);
     vcount:=vcount+1;
     vquant := vquant + 1;
    end;
  end
  else if (trim(TipoRelatorio) <> 'RESERVADA') and (trim(TipoRelatorio) <> 'NÃO RESERVADA') then
  begin
   linha:=linha+1;
   if trim(vdesc) <> trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString) then
   begin
    vdesc := trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString);
    Rdp.ImpF(linha,1,'* * * * QTDE: '+ vDadosIni.Strzero(vcount,5),[comp17]);
    linha:=linha+1;
    vcount:=0;
   end;
   Rdp.ImpF(linha,1, trim(buscas.FieldByName('DESCRICAO_VERSAOEST').AsString),[comp17]);
   Rdp.ImpF(linha,20, trim(buscas.FieldByName('CHASSI_C').AsString),[comp17]);
   Rdp.ImpF(linha,41, buscas.FieldByName('ANO_FABEST').asstring,[comp17]);
   Rdp.ImpF(linha,50, buscas.FieldByName('ANO_MODEST').asstring,[comp17]);
   Rdp.ImpF(linha,90, buscas.FieldByName('COREST').AsString,[comp17]);
   Rdp.ImpF(linha,102, vDadosIni.Strzero(buscas.FieldByName('NUM_NOTA').AsString,6),[comp17]);
   if buscas.FieldByName('DATA_RES').IsNull then
    Rdp.ImpF(linha,116,'Sem Reserva',[comp17])
   else
   begin
    if trim(buscas.FieldByName('SIT_RES').AsString) = 'V' then
     Rdp.ImpF(linha,116,'Reservada Vendida',[comp17])
    else
     Rdp.ImpF(linha,116,'Reservada N Vendida',[comp17]);
   end;
   vcount:=vcount+1;
   vquant := vquant + 1;
  end;
  buscas.next;
  if linha >= 58 then
  begin
   linha:=linha+1;
   Rdp.ImpF(linha,1, vDadosIni.Replicate('=',132),[comp17]);
   linha:=1;
   Rdp.Novapagina;
  end;
 end;
 linha:=linha+1;
 Rdp.ImpF(linha,1, vDadosIni.Replicate('=',132),[comp17]);
 linha:=linha+1;
 Rdp.ImpF(linha,1,'TOTAL:        '+ vDadosIni.Strzero(vquant,5),[comp17]);
 Rdp.Fechar;
 buscas.close;
 QrReservaT.close;
 vDadosIni.GravaAuditoria('REL034', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
 buscas.Close;
 frmRelatorios.ProgressBar.position := 0;
end;

