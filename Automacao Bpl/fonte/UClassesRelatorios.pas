      ' vps.comiss_prod,vps.comiss_prod_ger,vps.desc_funcao, ' +
      ' coalesce((select col.nome_vendedor from colaborador col ' +
      '   where col.cod_vendedor = vps.col_cod_vendedor and col.cod_empresa =  vps.cod_empresa), '''') nome_vendedor, ' +
      ' vps.n_nf,vps.data_fech,vps.prod_serv,vps.qtde_prod,vps.qtde_serv ' +
      ' from PROD_SERV_EMVENDAS vps ';

   if FiltrarAreaExec then
    buscas.SQL.Text := buscas.SQL.Text  +
      ' inner join tipo_vendas tp on tp.tipo = vps.tipo and (tp.sigla = vps.sigla or (tp.tipo_os = vps.tipo_os)) ';

   buscas.SQL.Text := buscas.SQL.Text +
      ' where vps.data_fech>=:dti and vps.data_fech<=:dtf ' +
      ' and vps.cod_empresa=' + vDadosIni.codEmpresa + ' and ((coalesce(vps.pc_vend_serv,0)<>0) or (coalesce(vps.pc_vend_prod,0)<>0)) ';

   if FiltrarTipoVenda and FiltrarTipoOS then
     buscas.SQL.Text := buscas.SQL.Text + ' and ((vps.SIGLA = ' + QuotedStr(trim(TipoVenda)) + ' and vps.tipo=''REQ'')' +
       ' or (vps.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vps.tipo=''OS''))'
   else if FiltrarTipoVenda then
     buscas.SQL.Text := buscas.SQL.Text + ' and ((vps.SIGLA = ' + QuotedStr(trim(TipoVenda)) + ' and vps.tipo=''REQ'')' +
       ' or (not vps.TIPO_OS is null and vps.tipo=''OS'' and vps.venda=''S''))'
   else if FiltrarTipoOS then
     buscas.SQL.Text := buscas.SQL.Text + ' and ((not vps.SIGLA is null and vps.tipo=''REQ'' and vps.venda=''S'')' +
       ' or (vps.TIPO_OS = ' + QuotedStr(trim(TipoOs)) + ' and vps.tipo=''OS''))'
   else
     buscas.SQL.Text := buscas.SQL.Text + ' and ((vps.tipo=''REQ'') or (vps.tipo=''OS'')) and vps.venda=''S'' ';

   if FiltrarVendedor then
     buscas.SQL.Text := buscas.SQL.Text + ' and vps.col_cod_vendedor in ' + CodVendedor;

   if FiltrarAreaExec then
