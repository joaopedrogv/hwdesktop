    ' AND PD.COD_EMPRESA = PDS.COD_EMPRESA AND PDS.COD_VENDEDOR = COL.COD_VENDEDOR ' +
    ' AND PDS.COD_EMPRESA = COL.COD_EMPRESA AND PD.COD_EMPRESA = ' + vDadosIni.CodEmpresa +
    ' AND PDS.NITEM = 1 GROUP BY COL.NOME_VENDEDOR';
  buscas.open;
  vListaLadB.Add('||||P|');
  vListaLadB.Add('65|MECÂNICO||||');
  vListaLadB.Add('111|QTDE||||');
