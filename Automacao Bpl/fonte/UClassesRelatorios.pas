procedure TRelatorioPosicaodeEstoqueVeiculos.CabNovaPagina;
begin
  if vpag > 0 then
    Rdp.Novapagina;

  vpag := vpag + 1;
  
  Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'POSICAO DE MOTOCICLETAS EM ESTOQUE', [normal, negrito]);
  linha := linha + 2;
  vpag := vpag + 1;
  Rdp.ImpF(linha, 1, 'DATA/HORA: ' + FormatDateTime('dd/mm/yyyy hh:mm', Now), [normal, negrito]);
  Rdp.ImpF(linha, 110, 'PAG: ' + vDadosIni.Strzero(vpag, 3), [normal, negrito]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, 'MODELO', [comp17]);
  Rdp.ImpF(linha, 20, 'CASA', [comp17]);
  Rdp.ImpF(linha, 30, 'RES V', [comp17]);
  Rdp.ImpF(linha, 41, 'RES G', [comp17]);
  Rdp.ImpF(linha, 51, 'RES N V', [comp17]);
  Rdp.ImpF(linha, 61, 'TRANSITO', [comp17]);
  Rdp.ImpF(linha, 79, 'DEMONS', [comp17]);
  Rdp.ImpF(linha, 90, 'DEMONS V', [comp17]);
  Rdp.ImpF(linha, 101, 'A FATURAR', [comp17]);
  Rdp.ImpF(linha, 112, 'TOTAL', [comp17]);
  linha := linha + 1;
  Rdp.ImpF(linha, 20, ' (+)', [comp17]);
  Rdp.ImpF(linha, 30, ' (-) ', [comp17]);
  Rdp.ImpF(linha, 41, '(inf)', [comp17]);
  Rdp.ImpF(linha, 51, ' (inf) ', [comp17]);
  Rdp.ImpF(linha, 61, '  (+)   ', [comp17]);
  Rdp.ImpF(linha, 79, ' (+) ', [comp17]);
  Rdp.ImpF(linha, 90, ' (-)   ', [comp17]);
  Rdp.ImpF(linha, 101, '  (+)    ', [comp17]);
  Rdp.ImpF(linha, 112, ' (=) ', [comp17]);
  linha := linha + 1;
  Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
end;

