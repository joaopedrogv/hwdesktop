constructor TInventarioVeiculos.create;
begin
  Rdp := TRdPrint(dtmRelatorios.RdPrint1);
  buscas := TIBQuery(dtmRelatorios.qrBuscas);
  buscas1 := TIBQuery(dtmRelatorios.qrbuscas2);
  buscas2 := TIBQuery(dtmRelatorios.qrbuscas3);
  buscasCompra := TIBQuery(dtmRelatorios.qrbuscas4);
  buscasVenda := TIBQuery(dtmRelatorios.qrbuscas5);
  buscasVenda := TIBQuery(dtmRelatorios.qrbuscas6);

  buscas74 := TIBQuery.Create(dtmRelatorios.qrbuscas7);
  buscas74.Database := buscas.Database;
  buscas74.Transaction := buscas.Transaction;

  fTempChassi := TClientDataSet.Create(nil);
  fTempChassi.Close;
  fTempChassi.FieldDefs.Clear;
  fTempChassi.FieldDefs.Add('CHASSI', ftString, 80, false);

  if fTempChassi.Tag = 0 then
  try
    fTempChassi.CreateDataSet;
    fTempChassi.Tag := 1;
  except
  end;
end;

procedure TInventarioVeiculos.grava_tipo74(vQuant: real; valor: currency;
  tipoPosse: integer);
begin
  // Caso houver necessidade o tipo de posse será usado para achar o código de posse
  // mas por enquanto não temos nenhum caso de clientes(que usam peças miudas) que façam uso de
  // Remessa para demonstração de mercadoria
  if Tipo74 then
  begin
    buscas74.close;
    buscas74.SQL.Text := ' SELECT * FROM INV_TIPO74 WHERE DATA_INV = :VDATA AND ' +
      ' COD_EMPRESA = :COD_EMPRESA AND GRUPO_PROD = :GRUPO AND COD_PROD = :CODIGO ';
    buscas74.ParamByName('VDATA').AsDateTime := dataReferencia;
    buscas74.ParamByName('COD_EMPRESA').value := vDadosIni.CodEmpresa;
    buscas74.ParamByName('GRUPO').value := 0;    
    if date > dataReferencia then
      buscas74.ParamByName('CODIGO').value := copy(buscasVenda.FieldByName('CHASSI_C').AsString, 4, 14)
    else   
      buscas74.ParamByName('CODIGO').value := copy(buscas.FieldByName('CHASSI_C').AsString, 4, 14);
    buscas74.open;
    if buscas74.isempty then
    begin
      buscas74.close;
      buscas74.SQL.Text := ' INSERT INTO INV_TIPO74 (DATA_INV, COD_EMPRESA, GRUPO_PROD, COD_PROD, QUANTIDADE, ' +
        ' VALOR_PROD, CODIGO_POSSE, CNPJ_POSSE, INSCR_POSSE, UF_POSSE, CHASSI_MT, VALOR_ICMS, VALOR_PIS, VALOR_COFINS) ' +
        ' VALUES (:DATA_INV, :COD_EMPRESA, :GRUPO_PROD, :COD_PROD, :QUANTIDADE, ' +
        ' :VALOR_PROD, :CODIGO_POSSE, :CNPJ_POSSE, :INSCR_POSSE, :UF_POSSE, :CHASSI_MT, :VALOR_ICMS, :VALOR_PIS, :VALOR_COFINS); ';
      buscas74.ParamByName('DATA_INV').AsDateTime := dataReferencia;
      buscas74.ParamByName('COD_EMPRESA').asstring := vDadosIni.CodEmpresa;
      buscas74.ParamByName('GRUPO_PROD').AsInteger := 0;
      if date > dataReferencia then
        buscas74.ParamByName('COD_PROD').AsString := copy(buscasVenda.FieldByName('CHASSI_C').AsString, 4, 14)
      else
        buscas74.ParamByName('COD_PROD').AsString := copy(buscas.FieldByName('CHASSI_C').AsString, 4, 14);
      buscas74.ParamByName('QUANTIDADE').AsFloat := vQuant;
      buscas74.ParamByName('VALOR_PROD').AsFloat := valor;
      buscas74.ParamByName('CODIGO_POSSE').AsString := '1';
      buscas74.ParamByName('CNPJ_POSSE').AsString := '00000000000000';
      buscas74.ParamByName('INSCR_POSSE').AsString := vDadosIni.Space(14);
      buscas74.ParamByName('UF_POSSE').AsString := '  ';
      if date > dataReferencia then
        buscas74.ParamByName('CHASSI_MT').AsString := buscasVenda.FieldByName('CHASSI_C').AsString
      else 
        buscas74.ParamByName('CHASSI_MT').AsString := buscas.FieldByName('CHASSI_C').AsString;  
      buscas74.ExecSQL;
    end
    else
    begin
      buscas74.Close;
      buscas74.SQL.Text := ' UPDATE INV_TIPO74 SET QUANTIDADE = :QUANTIDADE, VALOR_PROD = :VALOR_PROD ' +
        ' WHERE DATA_INV = :DATA_INV AND COD_EMPRESA = :COD_EMPRESA AND GRUPO_PROD = :GRUPO AND COD_PROD = :CODIGO; ';
      buscas74.ParamByName('DATA_INV').AsDateTime := dataReferencia;
      buscas74.ParamByName('COD_EMPRESA').value := vDadosIni.CodEmpresa;
      buscas74.ParamByName('GRUPO').value := 0;
      if date > dataReferencia then
        buscas74.ParamByName('CODIGO').value := copy(buscasVenda.FieldByName('CHASSI_C').AsString, 4, 14)
      else
        buscas74.ParamByName('CODIGO').value := copy(buscas.FieldByName('CHASSI_C').AsString, 4, 14);
      buscas74.ParamByName('QUANTIDADE').AsFloat := vQuant;
      buscas74.ParamByName('VALOR_PROD').AsFloat := valor;
      buscas74.ExecSQL;
    end;
    buscas74.close;
  end;
end;

procedure TInventarioVeiculos.ImprimeRelatorios;
var
  vct, vcount, vmod: integer;
  vtotvu: currency;
  vlcusto: real;
  vSql: string;
  data1: string;
  vEstDiario, vOK: boolean;
begin
  fTempChassi.EmptyDataSet;

  if not vDadosIni.PesqPros('REL036', 'IMPRIMIR', '', 'EST_MOTO', '', buscas, false) then
    Exit;

  if (not VeiculoNovo) and (not VeiculoUsado) then
  begin
   Application.MessageBox('Favor marca a opção: (Veículo Novo ou Veículo Usado ou ambas opções)', 'Atenção', MB_OK);
   exit;
  end;
  inherited;

  vpag := 0;
  if PaginaInicial <> 0 then
    vpag := PaginaInicial - 1;
  vct := 0;
  vtotm := 0.00;
  vcount := 0;
  vtotvu := 0;
  linha := 1;

  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Inventário de Veículos';
  rdp.TitulodoRelatorio := 'Inventário de Veículos';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if (not VeiculoNovo) or (not VeiculoUsado) then
    vSql := ' and est.status_uso = :vtp ';

  buscas.Close;
  buscas.SQL.Text := ' select distinct est.chassi_c, ' +
   ' (select first 1 (et.data_ch_nota) from comprasmesesv40 et ' +
   ' where et.chassi = est.chassi_c and et.cod_empresa = est.cod_empresa order by data_ch_nota) as data_ch_nota, ' +
   ' est.descricao_versaoest,est.corest, est.ano_fabest,est.ano_modest, ' +
   ' (case when coalesce(est.num_nota,0) > 0 then ' +
   '   case when trim(est.status_uso) = ''U'' then ' +
   '     coalesce((select first 1 (et.custo) from comprasmesesv40 et ' +
   '      where et.chassi = est.chassi_c and et.cod_empresa = est.cod_empresa and et.status_uso = est.status_uso ' +
   '      order by et.data_ch_nota desc), coalesce(est.preco_custo,0)) ' +
   '   else                                                            ' +
   '     coalesce((select first 1 (et.custo) from comprasmesesv40 et ' +
   '      where et.chassi = est.chassi_c and et.cod_empresa = est.cod_empresa and et.status_uso = est.status_uso ' +
   '      order by et.data_ch_nota), coalesce(est.preco_custo,0)) ' +
   '   end ' +
   ' else ' +
   '   coalesce(est.preco_custo,0) ' +
   ' end) as custo, ' +
   ' tpm.cilindrada, tpm.codigo, est.situacao, est.sit_res, tpm.ordtipo from est_moto est,TIPMODELO tpm ' +
   ' where est.versaoest = tpm.codigo and est.cod_empresa = tpm.cod_empresa and est.cod_empresa = :COD_EMPRESA ' +
   ' and est.ativo = 1 and ((trim(coalesce(est.posicao, '''')) = ''VIVO'') and est.status_estoque = ''S'') ' + vSql;
  if vDadosIni.vEmp.vConsDepositoEstoque = 'S' then
    buscas.SQL.Text := buscas.SQL.Text + ' union ' +
     ' select distinct est.chassi_c, ' +
     ' (select first 1 (et.data_ch_nota) from comprasmesesv40 et ' +
     ' where et.chassi = est.chassi_c and et.cod_empresa = est.cod_empresa order by data_ch_nota) as data_ch_nota, ' +
     ' est.descricao_versaoest,est.corest, est.ano_fabest,est.ano_modest, ' +
     ' (case when coalesce(est.num_nota,0) > 0 then ' +
     '   case when trim(est.status_uso) = ''U'' then ' +
