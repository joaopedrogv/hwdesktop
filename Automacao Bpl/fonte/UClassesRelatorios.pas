      Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
      linha := 1;
      CabNovaPagina;
    end;
  end;
  Rdp.fechar;
  buscas.close;
  buscas1.close;
  buscas2.close;

  vDadosIni.GravaAuditoria('REL032', 'IMPRIMIR', 'SUCESSO', '',
    '', buscas);
  frmRelatorios.ProgressBar.position := 0;
end;

