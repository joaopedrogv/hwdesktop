procedure TNFCab.setVariavelStatusNf;
begin
  vStatusFechada := True;
  if DataSet.IsEmpty then
    exit;
  vStatusFechada := (get_status = stsFechada) or
                    (get_status = stsCancelada);
  if (DataSet.FieldByName('modelo_nf').AsString = '55') and
    (DataSet.FieldByName('emissao_propria').AsString = 'S') then
  begin
    vStatusFechada := ((get_status = stsFechada) or (get_status = stsCancelada)) and (get_situacao_nfe <> '');
    {
    if ( not vStatusFechada ) and
      ((Trim(DataSet.FieldByName('NFE_DPEC_NREGDPEC').AsString) <> '') and
      (Trim(DataSet.FieldByName('tiponfe').AsString) = 'DPEC') and
      (dataSet.FieldByName('natureza_nf').AsString = 'S') ) then
        vStatusFechada := True;
    }
    if (not vStatusFechada ) then
      if (Trim(DataSet.FieldByName('tiponfe').AsString) = 'DPEC') and
        (Trim(DataSet.FieldByName('nfe_dpec_nregdpec').AsString) <> '') and
        (dataSet.FieldByName('natureza_nf').AsString = 'S') and
        (dataSet.FieldByName('codigoerro').AsString = '') then// caso nao tenha rejeição
        vStatusFechada := True;
  end;
end;

function TNFCab.validaSomatorioCsosn: boolean;
var
  I, K, j, H: Integer;
  lista: TStrings;
begin
  lista := TStringList.Create;
  try
    lista.Clear;
    SetLength(FCst, 0);
    SetLength(FCsosn, 0);
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if Trim(vItem.dataSet.FieldByName('csosn').AsString) <> '' then
      begin
        j := High(FCst) + 1;
        if j = 0 then
        begin
          SetLength(FCst, 1);
          fcst[0].cst := vItem.dataSet.FieldByName('csosn').AsString;
          fcst[0].valorCstCsosn :=
            (vItem.dataSet.FieldByName('valor_total').AsFloat -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat
            //            + vItem.dataSet.FieldByName('valor_desconto_perc').AsFloat
            ));
        end
        else
          for I := 0 to j - 1 do
            if (vItem.dataSet.FieldByName('csosn').AsString =
              fcst[i].cst) or ((i = j - 1) and (vItem.dataSet.FieldByName('csosn').AsString <>
              fcst[i].cst)) then
            begin
              K := i;
              if vItem.dataSet.FieldByName('csosn').AsString <> fcst[i].cst then
              begin
                SetLength(FCst, j + 1);
                K := j;
              end;
              fcst[k].cst := vItem.dataSet.FieldByName('csosn').AsString;
              fcst[k].valorCstCsosn := fcst[k].valorCstCsosn +
                (vItem.dataSet.FieldByName('valor_total').AsFloat -
                (vItem.dataSet.FieldByName('rateio_desconto').AsFloat
                //                + vItem.dataSet.FieldByName('valor_desconto_perc').AsFloat
                ));
              Break;
            end;
      end;
      vItem.dataSet.Next;
    end;
//    lista.Clear; //lista.Lines.Text := (dataSet.FieldByName('obs').AsString);
//    for j := 0 to lista.Count - 1 do
//      if (copy(lista[j], 1, 7)) = ('CSOSN: ') then
//        lista.Lines.Delete(I);

    h := 0;
    k := High(FCst) + 1;
    for I := 0 to k - 1 do
    begin
      for j := 0 to lista.Count - 1 do
      begin
        if (copy(lista[j], 1, 10)) = ('CSOSN: ' + copy(FCst[i].cst, 1, 5)) then
        begin
          lista[j] := 'CSOSN: ' + FCst[i].cst + ' ' + Trim(format('%12.2m',
            [FCst[i].valorCstCsosn]));
          H := 1;
          Break;
        end;
      end;
      if H = 1 then
        H := 0
      else
        lista.Add('CSOSN: ' + FCst[i].cst + ' ' + Trim(format('%12.2m',
          [FCst[i].valorCstCsosn])));
    end;
    if dataSet.state in [dsInsert, dsEdit] then
      dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString := lista.Text;
  finally
    lista.Free;
    lista := nil;
  end;
end;

