procedure TNFItem.ajustaNItem;
var
  I, countP, countS: Integer;
begin
  if (dataSet.FieldByName('TIPO_ITEM').AsString <> 'P') and
    (dataSet.FieldByName('TIPO_ITEM').AsString <> 'S') then
    Exit;

  I := dataSet.RecordCount;

  countP := filterStr('tipo_item = ''P''').dataSet.RecordCount;
  countS := filterStr('tipo_item = ''S''').dataSet.RecordCount;

  if (countP > 0) and (countS > 0) then
  begin
    filterStr('tipo_item = ''S'' and nitem < %d ', [I]);
    try
      if dataSet.IsEmpty then
        Exit;

      IndexFieldNames := 'TIPO_ITEM;NITEM';

      dataSet.Last;
      while not dataSet.IsEmpty do
      begin
        I := I + 1;
        dataSet.Edit;
        dataSet.FieldByName('NITEM').AsInteger := I;
        dataSet.Post;

        dataSet.Last;
      end;

    finally
      filterClear;
    end;
  end;
  filterClear;

  I := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    I := I + 1;
    dataSet.Edit;
    dataSet.FieldByName('NITEM').AsInteger := I;
    dataSet.Post;
    dataSet.Next;
  end;
  {
  IndexFieldNames := 'TIPO_ITEM;NITEM';
  I := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    I := I + 1;
    if (dataSet.FieldByName('TIPO_ITEM').AsString <> 'P') then
    begin
      dataSet.Edit;
      dataSet.FieldByName('NITEM').AsInteger := I + dataSet.RecordCount;
      dataSet.Post;
    end;
    dataSet.Next;
  end;
  I := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    I := I + 1;
    dataSet.Edit;
    dataSet.FieldByName('NITEM').AsInteger := I;
    dataSet.Post;
    dataSet.Next;
  end;
  }
end;

