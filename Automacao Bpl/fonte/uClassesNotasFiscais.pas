begin
  Result := True;

  vrDadosItem.tipo_calc_pc           :=  Ord(tcCompleto);
  if FOwerNF.fequals('tipo_nf', 'D')then
    vrDadosItem.tipo_calc            :=  Ord(tcNenhum)
  else if FOwerNF.fequals('tipo_nf', 'O')then
    vrDadosItem.tipo_calc            :=  Integer(tcParcial)
  else if FOwerNF.fequals('natureza_nf', 'E') or FOwerNF.fdif('tipo_emissao', '1') or (vrDadosItem.tipo_item <> 'P') then
  begin
    vrDadosItem.tipo_calc            :=  Integer(tcParcial);
    vrDadosItem.calcIcmsActive       := True;
    vrDadosItem.calcIcmsUfDestActive := True;
    vrDadosItem.calcIPIActive        := True;
    vrDadosItem.calcISSActive        := True;
  end
  else
    vrDadosItem.tipo_calc := Integer(tcCompleto);
end;

function TNFItem.inserir2: boolean;
begin
  if vrDadosItem.stado = dsBrowse then
  begin
    vrDadosItem.stado := dsInsert;
    vrDadosItem.calcIcmsActive       := True;
    vrDadosItem.calcIcmsUfDestActive := True;
    vrDadosItem.calcIPIActive        := True;
    vrDadosItem.manterRateio         := False;
  end;
  Result := vrDadosItem.stado = dsInsert;
end;

procedure TNFItem.montaDataSetTemp(pCodDevolucao: Integer);
var
  tmpDataSet: TClientDataSet;
  custo: Double;
  I: Integer;
begin
  // Metodo responsavel por agrupor o custo por produto
  // Quando IndTot = 0, quer dizer que nao compoe o total da nota, sendo custo zero para o item
  //   porém a alteracao do estoque vai depender do CFOP
  try
    CheckAndSetDataSetTemp;

    tmpDataSet := TClientDataSet(DtmNF.cdsTempINf);
    tmpDataSet.EmptyDataSet;

    dataSet.First;
    while not dataSet.Eof do
    begin
      { Removi o teste pois Bonificacoes fazem parte do estoque e precisam ser consideradas
      if dataSet.FieldByName('indtot').Value = 0 then
      begin
        dataSet.Next;
        Continue;
      end;
      }
      dataSet.Edit;
      vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
      if pCodDevolucao = 0 then
        dataSet.FieldByName('altera_estoque_cfop').AsString := vDadosIni.retornoPorCondicao(
         vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfopIt.dataSet.FieldByName('ALT_EST').AsString)//vCfopIt.dataSet.FieldByName('ALT_EST').AsString
      else
        dataSet.FieldByName('altera_estoque_cfop').AsString := 'N';
      if dataSet.FieldByName('altera_estoque_cfop').AsString = 'N' then
        dataSet.FieldByName('altera_custo_cfop').AsString := 'N'
      else
        dataSet.FieldByName('altera_custo_cfop').AsString := vCfopIt.dataSet.FieldByName('calc_custo').AsString;
      dataSet.FieldByName('tipv_veiculo').AsString := vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString;
      dataSet.Post;
      dataSet.Next;
    end;

    dataSet.First;
    while not dataSet.Eof do
    begin
      { Removi o teste pois Bonificacoes fazem parte do estoque e precisam ser consideradas
      if dataSet.FieldByName('indtot').Value = 0 then
      begin
        dataSet.Next;
        Continue;
      end;
      }
      if dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        tmpDataSet.Filter := 'grupo_prod = ' +IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(Trim(dataSet.FieldByName('cod_prod').AsString)) +
          ' and altera_estoque_cfop = ' + QuotedStr(dataSet.FieldByName('altera_estoque_cfop').AsString);
        tmpDataSet.Filtered := True;

        if (dataSet.FieldByName('grupo_prod').AsInteger <> tmpDataSet.FieldByName('grupo_prod').AsInteger) or
          (Trim(dataSet.FieldByName('cod_prod').AsString) <> Trim(tmpDataSet.FieldByName('cod_prod').AsString))or
          (Trim(dataSet.FieldByName('altera_estoque_cfop').AsString) <> Trim(tmpDataSet.FieldByName('altera_estoque_cfop').AsString)) then
        begin
          tmpDataSet.Insert;
          for I := 0 to dataSet.FieldCount - 1 do
            if tmpDataSet.FindField(dataSet.Fields[i].FieldName) <> nil then
              tmpDataSet.FieldByName(dataSet.Fields[i].FieldName).Value :=
                dataSet.FieldByName(dataSet.Fields[i].FieldName).Value;
          tmpDataSet.FieldByName('prec_cus_cnt').AsFloat := tmpDataSet.FieldByName('prec_cus_cnt').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          tmpDataSet.FieldByName('prec_cusm_prod').AsFloat := tmpDataSet.FieldByName('prec_cusm_prod').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);

          tmpDataSet.FieldByName('pr_cusc_prod').AsFloat := tmpDataSet.FieldByName('pr_cusc_prod').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat := tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          tmpDataSet.FieldByName('base_icmsub_ant').AsFloat := tmpDataSet.FieldByName('base_icmsub_ant').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          tmpDataSet.FieldByName('prec_cus_rep').AsFloat := tmpDataSet.FieldByName('prec_cus_rep').AsFloat *
            GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          if tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat > 0 then
            tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat := tmpDataSet.FieldByName('quantidade').AsFloat;

          custo := tmpDataSet.FieldByName('prec_cusm_prod').AsFloat / GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          if (custo > 0) and (tmpDataSet.FieldByName('prctb_item').AsFloat > 0) then
            tmpDataSet.FieldByName('prec_vnd_prod').AsFloat :=
              RoundTo(custo * (1 + (tmpDataSet.FieldByName('prctb_item').AsFloat / 100)), DIGROUNDMAX);

          if (custo > 0) and (tmpDataSet.FieldByName('prctb_itema').AsFloat > 0) then
            tmpDataSet.FieldByName('prec_vnd_proda').AsFloat :=
              RoundTo(custo * (1 + (tmpDataSet.FieldByName('prctb_itema').AsFloat / 100)), DIGROUNDMAX);

//          vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
//          if (Trim(vCfopIt.dataSet.FieldByName('ALT_EST').AsString) <> 'N') and
//            (pCodDevolucao = 0) then
//            tmpDataSet.FieldByName('altera_estoque_cfop').AsString := 'S'
//          else
//            tmpDataSet.FieldByName('altera_estoque_cfop').AsString := 'N';
//
//          if Trim(vCfopIt.dataSet.FieldByName('calc_custo').AsString) <> 'N' then
//            tmpDataSet.FieldByName('altera_custo_cfop').AsString := 'S'
//          else
//            tmpDataSet.FieldByName('altera_custo_cfop').AsString := 'N';

          tmpDataSet.Post;
        end
        else
        begin
          tmpDataSet.Edit;
          tmpDataSet.FieldByName('quantidade').AsFloat := tmpDataSet.FieldByName('quantidade').AsFloat +
            dataSet.FieldByName('quantidade').AsFloat;
          tmpDataSet.FieldByName('valor_total').AsFloat := tmpDataSet.FieldByName('valor_total').AsFloat +
            (dataSet.FieldByName('valor_unitario').AsFloat * dataSet.FieldByName('quantidade').AsFloat);
          tmpDataSet.FieldByName('prec_cus_cnt').AsFloat := tmpDataSet.FieldByName('prec_cus_cnt').AsFloat +
            (dataSet.FieldByName('prec_cus_cnt').AsFloat * QtdeCalcCusto);
          tmpDataSet.FieldByName('prec_cusm_prod').AsFloat := tmpDataSet.FieldByName('prec_cusm_prod').AsFloat +
            (dataSet.FieldByName('prec_cusm_prod').AsFloat * QtdeCalcCusto);
          tmpDataSet.FieldByName('prec_cus_r').AsFloat := tmpDataSet.FieldByName('prec_cus_r').AsFloat +
            (dataSet.FieldByName('prec_cus_r').AsFloat * QtdeCalcCusto);
          tmpDataSet.FieldByName('pr_cusc_prod').AsFloat := tmpDataSet.FieldByName('pr_cusc_prod').AsFloat +
            (dataSet.FieldByName('pr_cusc_prod').AsFloat * QtdeCalcCusto);

          if dataSet.FieldByName('valor_icmsub_ant').AsFloat > 0 then
          begin
            tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat := tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat +
              dataSet.FieldByName('quantidade').AsFloat;
            tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat := tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat +
              (dataSet.FieldByName('valor_icmsub_ant').AsFloat * dataSet.FieldByName('quantidade').AsFloat);
            tmpDataSet.FieldByName('base_icmsub_ant').AsFloat := tmpDataSet.FieldByName('base_icmsub_ant').AsFloat +
              (dataSet.FieldByName('base_icmsub_ant').AsFloat * dataSet.FieldByName('quantidade').AsFloat);
          end;
          tmpDataSet.FieldByName('prec_cus_rep').AsFloat := tmpDataSet.FieldByName('prec_cus_rep').AsFloat +
            (dataSet.FieldByName('prec_cus_rep').AsFloat * QtdeCalcCusto);

          custo := tmpDataSet.FieldByName('prec_cusm_prod').AsFloat / GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
          if (custo > 0) and (tmpDataSet.FieldByName('prctb_item').AsFloat > 0) then
            tmpDataSet.FieldByName('prec_vnd_prod').AsFloat :=
              RoundTo(custo * (1 + (tmpDataSet.FieldByName('prctb_item').AsFloat / 100)), DIGROUNDMAX);

          if (custo > 0) and (tmpDataSet.FieldByName('prctb_itema').AsFloat > 0) then
            tmpDataSet.FieldByName('prec_vnd_proda').AsFloat :=
              RoundTo(custo * (1 + (tmpDataSet.FieldByName('prctb_itema').AsFloat / 100)), DIGROUNDMAX);

          tmpDataSet.Post;
        end;

      end;
      dataSet.Next;
    end;

    tmpDataSet.Filtered := False;

    tmpDataSet.First;
    while not tmpDataSet.Eof do
    begin
      tmpDataSet.Edit;
      tmpDataSet.FieldByName('valor_unitario').AsFloat := vDadosIni.StrToFloatFormat(
        tmpDataSet.FieldByName('valor_total').AsFloat / tmpDataSet.FieldByName('quantidade').AsFloat,
        vDadosIni.vEmp.vCasasDecimais);

      tmpDataSet.FieldByName('prec_cus_cnt').AsFloat := tmpDataSet.FieldByName('prec_cus_cnt').AsFloat /
        GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);

      vProd.buscaProduto(tmpDataSet.FieldByName('grupo_prod').AsInteger,
          tmpDataSet.FieldByName('cod_prod').AsString);

      if vProd.dataSet.FieldByName('EST_F').AsFloat <= 0 then
        tmpDataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
          tmpDataSet.FieldByName('PREC_CUS_CNT').AsFloat
      else
      if ((vProd.dataSet.FieldByName('EST_F').AsFloat +
        tmpDataSet.FieldByName('QUANTIDADE').AsFloat) <= 0) or
        (vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat <= 0) then
        tmpDataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
          tmpDataSet.FieldByName('PREC_CUS_CNT').AsFloat
      else
        tmpDataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
          (((vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
          vProd.dataSet.FieldByName('EST_F').AsFloat) +
          (tmpDataSet.FieldByName('PREC_CUS_CNT').AsFloat *
          GetQtdeCalcCusto(tmpDataSet.FieldByName('QUANTIDADE').AsFloat))) /
          (vProd.dataSet.FieldByName('EST_F').AsFloat +
          tmpDataSet.FieldByName('QUANTIDADE').AsFloat));

//      tmpDataSet.FieldByName('prec_cusm_prod').AsFloat := tmpDataSet.FieldByName('prec_cusm_prod').AsFloat /
//        tmpDataSet.FieldByName('quantidade').AsFloat;
      tmpDataSet.FieldByName('prec_cus_r').AsFloat := tmpDataSet.FieldByName('prec_cus_r').AsFloat /
        GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);
      tmpDataSet.FieldByName('pr_cusc_prod').AsFloat := tmpDataSet.FieldByName('pr_cusc_prod').AsFloat /
        GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);

      if (tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat > 0) and
        (tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat > 0) then
      begin
        tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat := tmpDataSet.FieldByName('valor_icmsub_ant').AsFloat /
          tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat;
        tmpDataSet.FieldByName('base_icmsub_ant').AsFloat := tmpDataSet.FieldByName('base_icmsub_ant').AsFloat /
          tmpDataSet.FieldByName('QTDE_ICM_ANT').AsFloat;
      end;

      tmpDataSet.FieldByName('prec_cus_rep').AsFloat := tmpDataSet.FieldByName('prec_cus_rep').AsFloat /
        GetQtdeCalcCusto(tmpDataSet.FieldByName('quantidade').AsFloat);

      tmpDataSet.Post;
      tmpDataSet.Next;
    end;

  finally
    tmpDataSet.Filter := '';
    tmpDataSet.Filtered := False;
    dataSet := TClientDataSet(DtmNF.cdsINf);
  end;
end;

function TNFItem.Next: Boolean;
begin
  result := inherited Next;
  if Result then
  begin
    if dataSet.FieldByName('tipo_item').AsString = 'V' then
    begin
      if not vDetVeic.dataSet.Active then
        vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger);

      vDetVeic.dataSet.First;
      while not vDetVeic.dataSet.Eof do
      begin
        if vDetVeic.dataSet.FieldByName('nitem').AsInteger =
          dataSet.FieldByName('nitem').AsInteger then
          Exit;

        vDetVeic.dataSet.Next;
      end;
    end;
  end;
end;

function TNFItem.NextMargem: boolean;
var
  Cursor: TBookmark;
begin
  Cursor := dataSet.GetBookmark;
  while not dataSet.Eof do
  begin
    dataSet.Next;
    //    if not dataSet.Eof then
    if dataSet.FieldByName('tipo_item').AsString = 'P' then
    begin
      Result := true;
      getAtributos;
      if dataSet.Eof then
       Result := False;
      Exit;
    end;
  end;
  dataSet.GotoBookmark(Cursor);
  Result := False;
end;

function TNFItem.Post: Boolean;
var
  tmpDataSet: TClientDataSet;
  I: Integer;
  vPercTotal: Extended;
  sDfeId: string;

  procedure corrigirRateio(AFieldName: string; ADecimal: Smallint);
  var
    AValue, AValueSum : Double;
  begin
    AValue    := dataSet.FieldByName(AFieldName).AsFloat;
    AValueSum := 0;

    tmpDataSet.First;
    while not tmpDataSet.Eof do
    begin
      AValueSum := AValueSum + tmpDataSet.FieldByName(AFieldName).AsFloat;
      tmpDataSet.Next;
    end;

    if RoundTo(AValue, ADecimal) <> RoundTo(AValueSum, ADecimal) then
    begin
      tmpDataSet.First;
      while not tmpDataSet.Eof do
      begin
        if RoundTo(tmpDataSet.FieldByName(AFieldName).AsFloat + ( AValue - AValueSum ), ADecimal) >= 0 then
        begin
          tmpDataSet.Edit;
          tmpDataSet.FieldByName(AFieldName).AsFloat := RoundTo(
            tmpDataSet.FieldByName(AFieldName).AsFloat + ( AValue - AValueSum ), ADecimal);
          tmpDataSet.Post;
          Break;
        end;
        tmpDataSet.Next;
      end;
    end;
  end;

begin
  if (dataSet.FieldByName('tipo_item').AsString <> 'P') or ((dataSet.State <> dsInsert) and (not FSemCodigo)) then
  begin
    Result := inherited Post;
    Exit;
  end;

  buscas.Close;
  buscas.SQL.Text := 'select pd.*, p.descr_prod, p.num_fab_prod, p.consumo, p.unidade, p.nbm, p.perc_tb_prod, p.perc_tb_proda,' +
                     ' perc_tb_prod3, perc_tb_prod6, perc_tb_prod9,' +
    ' p.peso_brut_prod, p.peso_liq_prod' +
    ' from produtos_desmembramento pd' +
    ' inner join produtos p on p.grupo_prod = pd.grupo_prod_mprima and p.cod_prod = pd.cod_prod_mprima and p.cod_empresa = pd.cod_empresa' +
    ' where pd.grupo_prod_acabado = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and pd.cod_prod_acabado = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
    ' and pd.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if buscas.IsEmpty then
  begin
    Result := inherited Post;
    Exit;
  end;

  try
    CheckAndSetDataSetTemp;

    tmpDataSet := TClientDataSet(DtmNF.cdsTempINf);
    tmpDataSet.Filtered := False;

    vPercTotal := 0;

    buscas.First;
    while not buscas.Eof do
    begin
      vPercTotal := vPercTotal + buscas.FieldByName('quant').AsFloat;
      buscas.Next;
    end;

    buscas.First;
    while not buscas.Eof do
    begin

      tmpDataSet.Insert;
      for I := 0 to dataSet.FieldCount - 1 do
        if tmpDataSet.FindField(dataSet.Fields[i].FieldName) <> nil then
          tmpDataSet.FieldByName(dataSet.Fields[i].FieldName).Value :=
            dataSet.FieldByName(dataSet.Fields[i].FieldName).Value;

//      pd.*, p.descr_prod, p.num_fab_prod, p.consumo, p.unidade, p.nbm, p.perc_tb_prod, p.perc_tb_proda,' +
//    ' p.peso_brut_prod, p.peso_liq_prod
      tmpDataSet.FieldByName('grupo_prod').AsInteger := buscas.FieldByName('grupo_prod_mprima').AsInteger;
      tmpDataSet.FieldByName('cod_prod').AsString := buscas.FieldByName('cod_prod_mprima').AsString;
      tmpDataSet.FieldByName('num_fab_prod').AsString := buscas.FieldByName('num_fab_prod').AsString;
      tmpDataSet.FieldByName('descricao_item').AsString := buscas.FieldByName('descr_prod').AsString;
      tmpDataSet.FieldByName('consumo').AsString := buscas.FieldByName('consumo').AsString;
      tmpDataSet.FieldByName('referencia').AsString := buscas.FieldByName('unidade').AsString;
      tmpDataSet.FieldByName('ncm').AsString := buscas.FieldByName('nbm').AsString;
      tmpDataSet.FieldByName('prctb_item').AsFloat := IfThen(vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF, buscas.FieldByName('perc_tb_prod').AsFloat);
      tmpDataSet.FieldByName('prctb_itema').AsFloat := IfThen(vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF, buscas.FieldByName('perc_tb_proda').AsFloat);
      tmpDataSet.FieldByName('prctb_item3').AsFloat := IfThen(vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF, buscas.FieldByName('perc_tb_prod3').AsFloat);
      tmpDataSet.FieldByName('prctb_item6').AsFloat := IfThen(vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF, buscas.FieldByName('perc_tb_prod6').AsFloat);
      tmpDataSet.FieldByName('prctb_item9').AsFloat := IfThen(vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF, buscas.FieldByName('perc_tb_prod9').AsFloat);

      tmpDataSet.FieldByName('peso_b').AsFloat := buscas.FieldByName('peso_brut_prod').AsFloat;
      tmpDataSet.FieldByName('peso_l').AsFloat := buscas.FieldByName('peso_liq_prod').AsFloat;

      tmpDataSet.FieldByName('quantidade').AsFloat := vDadosIni.StrToFloatFormat((buscas.FieldByName('quant').AsFloat / 100) *
        dataSet.FieldByName('quantidade').AsFloat, 3);

      tmpDataSet.FieldByName('valor_total').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
        dataSet.FieldByName('valor_total').AsFloat / 100, 2);

      tmpDataSet.FieldByName('valor_unitario').AsFloat := vDadosIni.StrToFloatFormat(tmpDataSet.FieldByName('valor_total').AsFloat /
        tmpDataSet.FieldByName('quantidade').AsFloat, 4);

      if tmpDataSet.FieldByName('rateio_desconto').AsFloat > 0 then
      begin
        tmpDataSet.FieldByName('rateio_desconto').AsFloat := RoundTo( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('rateio_desconto').AsFloat / 100, -2);
        tmpDataSet.FieldByName('perc_desconto').AsFloat :=
          tmpDataSet.FieldByName('rateio_desconto').AsFloat / tmpDataSet.FieldByName('valor_total').AsFloat * 100;
      end;

      if tmpDataSet.FieldByName('base_icm').AsFloat > 0 then
        tmpDataSet.FieldByName('base_icm').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('base_icm').AsFloat / 100, 2);      

      if tmpDataSet.FieldByName('valor_icm').AsFloat > 0 then
        tmpDataSet.FieldByName('valor_icm').AsFloat := RoundTo( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('valor_icm').AsFloat / 100, -2);    

      if tmpDataSet.FieldByName('vicmdeson').AsFloat > 0 then
        tmpDataSet.FieldByName('vicmdeson').AsFloat := RoundTo( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('vicmdeson').AsFloat / 100, -2);

      if tmpDataSet.FieldByName('base_icmsub').AsFloat > 0 then
        tmpDataSet.FieldByName('base_icmsub').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('base_icmsub').AsFloat / 100, 2);

      if tmpDataSet.FieldByName('valor_icmsub').AsFloat > 0 then
        tmpDataSet.FieldByName('valor_icmsub').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('valor_icmsub').AsFloat / 100, 2);

      if tmpDataSet.FieldByName('base_ipi').AsFloat > 0 then
        tmpDataSet.FieldByName('base_ipi').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('base_ipi').AsFloat / 100, 2);

      if tmpDataSet.FieldByName('base_pis').AsFloat > 0 then
        tmpDataSet.FieldByName('base_pis').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('base_pis').AsFloat / 100, 2);

      if tmpDataSet.FieldByName('base_cofins').AsFloat > 0 then
        tmpDataSet.FieldByName('base_cofins').AsFloat := vDadosIni.StrToFloatFormat( ((buscas.FieldByName('quant').AsFloat / vPercTotal) * 100) *
          dataSet.FieldByName('base_cofins').AsFloat / 100, 2);
      //
      tmpDataSet.FieldByName('UNIDADE_NF').AsString := '';
      tmpDataSet.FieldByName('QTDEMBREC').AsFloat := 0;
      tmpDataSet.FieldByName('VLREMBNF').AsFloat := 0;
      tmpDataSet.FieldByName('QTDEMB').AsFloat := 0;
      tmpDataSet.Post;

      buscas.Next;
    end;

    //colocar os outros aqui se achar necessário
    corrigirRateio('rateio_desconto', -2);

    sDfeId  := fstr('dfe_trib_id');

    if (dataSet.State = dsInsert) then
      dataSet.Cancel
    else
    begin
      dataSet.Cancel;
      dataSet.Delete;
    end;

    ajustaNItem;

    tmpDataSet.First;
    while not tmpDataSet.Eof do
    begin

      dataSet.Insert;
      for I := 0 to dataSet.FieldCount - 1 do
        if tmpDataSet.FindField(dataSet.Fields[i].FieldName) <> nil then
          dataSet.FieldByName(dataSet.Fields[i].FieldName).Value :=
            tmpDataSet.FieldByName(dataSet.Fields[i].FieldName).Value;

      if (YesNoEnum(FOwerNF.fint('dfe_trib_ignorar')) = ynYes) then
      begin
        dataSet.FieldByName('dfe_trib_id').Value := Null;
        dataSet.FieldByName('dfe_trib_id_xml').Value := Null;
      end;

      dataSet.FieldByName('nitem').AsInteger := dataSet.RecordCount + 1;
      dataSet.Post;

      tmpDataSet.Next;
    end;

    // Acho que pode colocar o rateio aqui, usar o sDfeId com a lista de ids dos itens gerados

    FTributos.Delete(sDfeId);

    Result := True;

  finally
    tmpDataSet.Filter := '';
    tmpDataSet.Filtered := False;
    dataSet := TClientDataSet(DtmNF.cdsINf);
  end;
end;

