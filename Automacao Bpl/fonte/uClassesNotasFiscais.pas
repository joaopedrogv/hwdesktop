function TNFCab.SairComEstoque: boolean;
begin
  Result := False;
  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
        try
          //Colocando o campo est_f = 0  se o memsmo for nulo, para poder somar o estoque atual com a entrada
          ExecutaComandosSqlExec('update produtos set est_f = 0 where' +
            ' grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and est_f is null');
          //Colocando o campo est_r = 0  se o memsmo for nulo, para poder somar o estoque atual com a entrada
          ExecutaComandosSqlExec('update produtos set est_r = 0 where' +
            ' grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and est_r is null');

          //Montando o update na buscas
          buscas.SQL.Text := 'update produtos set';
          if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N' then
            if vItem.dataSet.FieldByName('camp_entest').AsString = 'D' then
              buscas.SQL.Add(' est_r = est_r - :estoque,')
            else
              buscas.SQL.Add(' est_f = est_f - :estoque,');

          if vItem.dataSet.FieldByName('altera_custo_cfop').AsString <> 'N' then
          begin
            buscas.SQL.Add(' prec_cusm_prod = :prec_cusm_prod,' +
              ' prec_cus_prod = :prec_cus_prod,');
            if (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '1')
              or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '6') or
              (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '3')
              or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '7') then
            else
            begin
              buscas.SQL.Add(' icmant_sub = :icmant_sub,' +
                ' baseicmant_sub = :baseicmant_sub,');
            end;
            if vDadosIni.vEmp.vAltCustRep <> 'N' then
              buscas.SQL.Add(' prec_rep_prod = :prec_rep_prod,');
          end;
          if vItem.dataSet.FieldByName('prctb_item').AsFloat > 0 then
            buscas.SQL.Add(' prec_tab_prod = :prec_tab_prod,');
          if vItem.dataSet.FieldByName('prctb_itema').AsFloat > 0 then
            buscas.SQL.Add('prec_publico = :prec_publico,');

          buscas.SQL.Add(' data_ult_compra = :data_ult_compra,' +
            ' vl_ult_compra = :vl_ult_compra,' +
            ' perc_frete_prod = :perc_frete_prod,' +
            ' num_nf_rec = :num_nf_rec');
          buscas.SQL.Add(' where grupo_prod = :grupo_prod' +
            ' and cod_prod = :cod_prod' +
            ' and cod_empresa = :cod_empresa');
          //Passando os Parametros
          if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N' then
            buscas.ParamByName('estoque').AsFloat :=
              vItem.dataSet.FieldByName('quantidade').AsFloat;

          if vItem.dataSet.FieldByName('altera_custo_cfop').AsString <> 'N' then
          begin
            buscas.ParamByName('prec_cusm_prod').AsFloat :=
              vItem.dataSet.FieldByName('prec_cusm_prod').AsFloat;
            buscas.ParamByName('prec_cus_prod').AsFloat :=
              vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat;
            if (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '1')
              or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '6') or
              (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '3')
              or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '7') then
            else
            begin
              buscas.ParamByName('icmant_sub').AsFloat :=
                vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
              buscas.ParamByName('baseicmant_sub').AsFloat :=
                vItem.dataSet.FieldByName('base_icmsub').AsFloat;
            end;
            if vDadosIni.vEmp.vAltCustRep <> 'N' then
              buscas.ParamByName('prec_rep_prod').AsFloat :=
                vItem.dataSet.FieldByName('prec_cus_rep').AsFloat;
          end;
          if vItem.dataSet.FieldByName('prctb_item').AsFloat > 0 then
            buscas.ParamByName('prec_tab_prod').AsFloat :=
              vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat;
          if vItem.dataSet.FieldByName('prctb_itema').AsFloat > 0 then
            buscas.ParamByName('prec_publico').AsFloat :=
              vItem.dataSet.FieldByName('prec_vnd_proda').AsFloat;
          buscas.ParamByName('data_ult_compra').AsDate :=
            dataSet.FieldByName('data_lanc').AsDateTime;
          buscas.ParamByName('vl_ult_compra').AsFloat :=
            vItem.dataSet.FieldByName('valor_unitario').AsFloat;
          buscas.ParamByName('perc_frete_prod').AsFloat :=
            vItem.dataSet.FieldByName('perc_frete').AsFloat;
          buscas.ParamByName('num_nf_rec').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
          buscas.ParamByName('grupo_prod').AsInteger :=
            vItem.dataSet.FieldByName('grupo_prod').AsInteger;
          buscas.ParamByName('cod_prod').AsString := vItem.dataSet.FieldByName('cod_prod').AsString;
          buscas.ParamByName('cod_empresa').AsInteger :=
            vItem.dataSet.FieldByName('cod_empresa').AsInteger;
          buscas.SQL.Text;
          buscas.Prepare;
          buscas.ExecSql;

          buscas.Close;
          buscas.Sql.Text := 'INSERT INTO CUSTOS (CODIGO, COD_EMPRESA, FORNEC, VALOR,' +
            ' GRUPO_PROD, COD_PROD, DATA, NUM_NOTA_NFE, PREC_CUS_MED, PR_CUSC_PROD, SERIE, COD_NF)' +
            ' VALUES (:CODIGO, :COD_EMPRESA, :FORNEC, :VALOR,' +
            ' :GRUPO_PROD, :COD_PROD, :DATA, :NUM_NOTA_NFE, :PREC_CUS_MED, :PR_CUSC_PROD, :SERIE, :COD_NF)';
          buscas.ParamByName('CODIGO').AsInteger := Gencodigo('CUSTOS', dtmNF.SpIncCodNF,
            vDadosIni.codEmpresa);
          buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
          buscas.ParamByName('FORNEC').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
          buscas.ParamByName('GRUPO_PROD').AsInteger :=
            vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := vItem.dataSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('DATA').AsDate := dataSet.FieldByName('DATA_LANC').AsDateTime;
          buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('NUM_NF').AsInteger;
          buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('SERIE').AsString;
          buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;

          if (dataSet.FieldByName('emissao_propria').AsString <> 'S') and
            (vItem.dataSet.FieldByName('altera_custo_cfop').AsString <> 'N') then
          begin
            buscas.ParamByName('VALOR').AsFloat :=
              vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat;
            buscas.ParamByName('PREC_CUS_MED').AsFloat :=
              vItem.dataSet.FieldByName('prec_cusm_prod').AsFloat;
            buscas.ParamByName('PR_CUSC_PROD').AsFloat :=
              vItem.dataSet.FieldByName('prec_cusm_prod').AsFloat;
          end
          else
          begin
            vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
              vItem.dataSet.FieldByName('cod_prod').AsString);
            buscas.ParamByName('VALOR').AsFloat :=
              vItem.vProd.dataSet.FieldByName('PREC_CUS_PROD').AsFloat;
            buscas.ParamByName('PREC_CUS_MED').AsFloat :=
              vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
            buscas.ParamByName('PR_CUSC_PROD').AsFloat :=
              vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
          end;
          buscas.Prepare;
          buscas.ExecSql;
        except
          on e: Exception do begin
            registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
              dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoque ' + e.Message);
            exit;
          end;
        end;
        try
          if vItem.dataSet.FieldByName('seq_devolucao').AsInteger > 0 then
          begin
            buscas.Close;
            buscas.SQL.Text := 'update DEVOLUCAO set QUANT_C = :QUANT_C,' +
              ' NUM_NOTA_NFE = :NUM_NOTA_NFE, COD_FORNECEDOR = :COD_FORNECEDOR' +
              ' where grupo_prod = :grupo_prod cod_prod = :cod_prod' +
              ' and SEQUENCIA = :SEQUENCIA AND cod_empresa = :cod_empresa and ativo=1 ';
            buscas.ParamByName('QUANT_C').AsFloat :=
              vItem.dataSet.FieldByName('quantidade').AsFloat;
            buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
            buscas.ParamByName('COD_FORNECEDOR').AsInteger :=
              dataSet.FieldByName('cod_cliente').AsInteger;
            buscas.ParamByName('grupo_prod').AsInteger :=
              vItem.dataSet.FieldByName('grupo_prod').AsInteger;
            buscas.ParamByName('cod_prod').AsString :=
              vItem.dataSet.FieldByName('cod_prod').AsString;
            buscas.ParamByName('SEQUENCIA').AsInteger :=
              vItem.dataSet.FieldByName('seq_devolucao').AsInteger;
            buscas.ParamByName('cod_empresa').AsInteger :=
              vItem.dataSet.FieldByName('cod_empresa').AsInteger;
            buscas.Prepare;
            buscas.ExecSql;
          end;
        except
          on e: Exception do begin
            registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
              dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoque Devolução ' +
              e.Message);
            exit;
          end;
        end;
      end;
      vItem.dataSet.Next;
    end;
    Result := true;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('procedure EntrarComEstoque Erro: ' + e.Message);
    end;
  end;
end;
}
function TNFCab.sairComEstoqueECF: boolean;
var
  QtdePendente, QtdeInformada, QtdeTotal: Integer;
  vOK: Boolean;
begin

  if ((vItem.dataSet.FieldByName('ecf').AsString = 'E') or
    (vItem.dataSet.FieldByName('ecf').AsString = 'O')) and
    (vItem.dataSet.FieldByName('nped').AsInteger > 0) then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select cod_nserie from pedvenda_prod'+
      ' where nped = '+ IntToStr(vItem.dataSet.FieldByName('nped').AsInteger) +
      ' and tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
      ' and nitem = '+ IntToStr(vItem.dataSet.FieldByName('nitem_ped').AsInteger) +
      ' and cod_empresa = '+ vDadosIni.codEmpresa;
    buscas.Open;

    vOK := False;
    if buscas.FieldByName('cod_nserie').AsInteger > 0 then
    begin
      vItem.vDetEcf.vEstoqueECF.selecionaEstoqueECF(buscas.FieldByName('cod_nserie').AsInteger);
      vItem.vDetEcf.dataSet.First;
      while not vItem.vDetEcf.dataSet.Eof do
