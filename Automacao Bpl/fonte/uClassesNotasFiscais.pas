      (dataSet.FieldByName('dest_cmun').AsString = '9999999') and
      (dataSet.FieldByName('NFE_IDDEST').AsString = '3') then
//      abreFormExportacao;

//    if vDadosIni.strEstaContidoEm(Copy(dataSet.FieldByName('codigo_nop').AsString, 1, 1), ['3', '7']) then
    begin
      controlsDisabled := vItem.dataSet.ControlsDisabled;
