function TNFCab.setNumeroNFComandoFormPagamento: boolean;
var
  buscasTemp: TIBQuery;
begin
  if dataSet.FieldByName('tipo_nf').AsString <> 'V' then
    Exit;
  try
    if (vDadosIni.vEmp.vConfFormPagamento = 'PED') and (dataSet.FieldByName('n_comando').AsInteger > 0) then
    begin
      ExecutaComandosSqlExec('update formpagamento fp set' +
        ' fp.num_nota = ' + dataSet.FieldByName('num_nf').AsString +
        ', fp.sub_serie = ' + Trim(dataSet.FieldByName('serie').AsString) +
        ', fp.tip_cnt = ''C'' '+
        ' where  (((fp.nrequisicao = ' + dataSet.FieldByName('n_comando').AsString +
        ') and fp.tpdocs = ''MOT'''+
        ') or ((fp.rec_numvend = ' + dataSet.FieldByName('n_comando').AsString +
        ' and fp.tpdocs <> ''LCS'' and fp.rec_tipvend = ''MOT''' +
        '))) and fp.cod_empresa = ' + vDadosIni.codEmpresa + ' and fp.ativo = 1');
      buscas.Close;
      buscas.SQL.Text :=
        'update formpagamento fp set fp.ndoc = ' +QuotedStr(vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger,6))+
          '||substring(fp.ndoc from 7 for (char_length(fp.ndoc) - 6 ) )'+
          ' where  fp.nrequisicao = ' + dataSet.FieldByName('n_comando').AsString +
          ' and fp.tpdocs = ''MOT''' +
          ' and fp.cod_empresa = ' + vDadosIni.codEmpresa + ' and fp.ativo = 1 and fp.tipdoc = ''S2''' +
          ' and char_length(fp.ndoc) > 5';
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text :=
        'select n_processamento from formpagamento fp'+
          ' where  fp.nrequisicao = ' + dataSet.FieldByName('n_comando').AsString +
          ' and fp.tpdocs = ''MOT''' +
          ' and fp.cod_empresa = ' + vDadosIni.codEmpresa + ' and fp.ativo = 1 and fp.tipdoc = ''S2'' and fp.n_processamento > 0';
      buscas.Open;

      buscasTemp := TIBQuery(dtmNF.qrBuscasNf2);
      while not buscas.Eof do
      begin
        buscasTemp.Close;
        buscasTemp.SQL.Text :=
          'update controle_creditos cc set cc.n_doc_c = ' + QuotedStr(vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger,6))+
          '||substring(cc.n_doc_c from 7 for (char_length(cc.n_doc_c) - 6 ) )' +
          ' where cc.cod_cred = ' + IntToStr(buscas.FieldByName('n_processamento').AsInteger) +
          ' and cc.' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') + ' = ' + vDadosIni.codEmpresa +
          ' and char_length(cc.n_doc_c) > 5';
        buscasTemp.ExecSQL;

        buscas.Next;
      end;
    end;

    Result := True;
  except
    on e: Exception do begin
      Result := false;
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' setNumeroNFComandoFormPagamento ' + e.Message);
    end;
  end;
end;

function TNFCab.setNumeroNFPedVenda: boolean;
var
  buscasTemp: TIBQuery;
  ListCFOPsSemVinculo: TStringList;
  PedVendaRef: TPedvenda_ref_nf_classList;
  I: Integer;
  Ainsert: Boolean;
  Astr: string;
begin
  try
    ListCFOPsSemVinculo := vDadosIni.NewStringList(True, '', ',');
//    PedVendaRef         := TPedvenda_ref_nf_classList.Create;
    try

      ListCFOPsSemVinculo.Clear;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
        (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') and
        (vItem.dataSet.FieldByName('nitem_ped').AsInteger > 0) then
      begin
          ListCFOPsSemVinculo.Add(vItem.fstr('codigo_nop'));
          {
          Ainsert := True;
          for I := 0 to PedVendaRef.Count - 1 do with PedVendaRef.Items[I] do
            if (nped = vItem.fint('nped')) and (tipo = vItem.fstr('tipo_ped')) then
            begin
              Ainsert := False;
              Break;
            end;
          if Ainsert then
            with PedVendaRef.New do
            begin
              nped        := vItem.fint('nped');
              tipo        := vItem.fstr('tipo_ped');
              cod_empresa := vItem.fint('cod_empresa');
              cod_nf      := vItem.fint('cod_nf');
            end;
            }
        end;
        vItem.dataSet.Next;
      end;

      if ListCFOPsSemVinculo.Count > 0 then
      begin
        Astr := ListCFOPsSemVinculo.Text;
        if EndsStr(',', Astr) then System.Delete(Astr, Length(Astr), 1);

        SqlOpen('select codigo_nop from nat_op' +
                ' where codigo_nop in (%s) and semvinculo_vnd = ''S''',
                 [Astr]).First;
        ListCFOPsSemVinculo.Clear;
        while not buscas.Eof do
        begin
          ListCFOPsSemVinculo.Add(buscas.FieldByName('codigo_nop').AsString);
          buscas.Next;
        end;
      end;

      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin

        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') and
          (vItem.dataSet.FieldByName('nitem_ped').AsInteger > 0) and
          (ListCFOPsSemVinculo.IndexOf(vItem.fstr('codigo_nop')) < 0) then
        begin
        ExecutaComandosSqlExec(
          'update pedvenda set num_nf = ' + dataSet.FieldByName('num_nf').AsString +
