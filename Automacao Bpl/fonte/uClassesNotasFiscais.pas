            end;

            buscas.close;
            if vDadosIni.vEmp.vVersaoVeiculos = '4' then
              buscas.SQL.Text := 'update com_fat set STATUS_V = ''CANCELADO'' ' +
                ' where n_comando = ' + dataSet.FieldByName('n_comando').AsString +
                ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa + ' AND ATIVO = 1'
            else
              buscas.SQL.Text := 'update com_fat set STATUS_V = ''CANCELADA'' ' +
                ' where n_comando = ' + dataSet.FieldByName('n_comando').AsString +
                ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa + ' AND ATIVO = 1';
            buscas.Prepare;
            buscas.ExecSQL;

            if vDadosIni.vDpto = 'ESTOQUE' then
              vTemp := 'E'
            else if vDadosIni.vDpto = 'OFICINA' then
              vTemp := 'O'
            else
              vTemp := 'V';

            {buscas.close;
            buscas.SQL.Text := 'select nrecibo from recibos where ndocant = '+
              dataSet.FieldByName('n_comando').AsString+
              ' and deprec = '+QuotedStr(vTemp)+' and cod_empresa = '+vDadosIni.codEmpresa+
              ' and ativo = 1 ';
            buscas.Open;

            buscas.First;
            while not buscas.Eof do
            begin
              buscas2.close;
              buscas2.SQL.Text := 'delete from hist_rec where nrecibo = ' +buscas.FieldByName('nrecibo').AsString+
                ' and ndocant = ' + dataSet.FieldByName('n_comando').AsString+
                ' and cod_empresa = '+vDadosIni.codEmpresa+' and ativo = 1 ';
              buscas2.Prepare;
              buscas2.ExecSQL;

              buscas.Next;
            end;

            buscas2.close;
            buscas2.SQL.Text := 'update recibos set STATUS_REC = '''','+
              ' NDOCANT = 0, DATA_BAIXA = null where ndocant = '+
              dataSet.FieldByName('n_comando').AsString+
              ' and deprec = '+QuotedStr(vTemp)+' and cod_empresa = '+vDadosIni.codEmpresa+
              ' and ativo = 1 ';
            buscas2.Prepare;
            buscas2.ExecSQL;   }

            if (vDadosIni.vEmp.vVersaoVeiculos <> '4') then
            begin
              buscas2.close;
              buscas2.SQL.Text := 'Delete from mtusadas where com_ent = ' +
                dataSet.FieldByName('n_comando').AsString +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and ativo = 1 ';
              buscas2.Prepare;
              buscas2.ExecSQL;
            end;
          except
            on e: exception do begin
              if Application.MessageBox(pchar('Erro no cancelamento dos dados do Comando Num: ' +
                dataSet.FieldByName('n_comando').AsString + sLineBreak +
                'Mostrar Erro?'), 'Atenção',
                MB_ICONQUESTION + MB_YESNO) = IDYES then
                ShowMessage(e.Message);
              registraErro('Erro ao cancelar dados do comando Num: ' +
                dataSet.FieldByName('n_comando').AsString + ' Erro: ' + e.Message);
            end;
          end;
        end;
      end;

      buscas.Close;
      buscas.SQL.Text := 'delete from notafiscal' +
        ' where cod_nf_transf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and cod_emp_transf = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
        ' and status = ' + QuotedStr(stsPreNota);
      buscas.ExecSQL;

      _atualizarSituacaoPedidos('Iniciado', True);
      _atualizarSituacaoPedidos('Finalizado', True);

      if Apply then
      begin
        CommitaTransacao;

        if (dataSet.FieldByName('natureza_nf').AsString = 'E') and (not vAberta) then
        begin
          vItem.dataSet.First;
          while not vItem.dataSet.Eof do
          begin
            if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
              if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N' then
                vMD5Func._gravaMD5_Produtos(buscas, vItem.dataSet.FieldByName('grupo_prod').AsInteger,
                  vItem.dataSet.FieldByName('cod_prod').AsString);
            vItem.dataSet.Next;
          end;

        end;

        if origem <> ocEventoInut then
          Application.MessageBox('Nota Fiscal Cancelada', 'Atenção', mb_ok + MB_ICONINFORMATION);
      end
      else
      begin
        RollBackTransacao;
        Application.MessageBox('Nota Fiscal não foi Cancelada', 'Atenção', mb_ok +
          MB_ICONINFORMATION);
      end;
      dataSet.RefreshRecord;
      setVariavelStatusNf;

      for I := 0 to vListDocPrgFid.Count - 1 do
       vDadosIni.ImprimirRecProgFid(buscas, StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
          trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)),
          'CRÉDITO'); //Imprimir recibo programa de fidelidade

    except
      on e: exception do begin
        RollBackTransacao;
        Application.MessageBox(pchar('Erro ao Cancelar Nota Fiscal' + sLineBreak + 'Erro: ' + e.Message
          ), 'Atenção', mb_ok + MB_ICONINFORMATION);
        exit;
      end;
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

function TNFCab.cancelarPedVendaNF: Boolean;
var
  vNPED, vCOD_VENDEDOR, I, X: Integer;
  vNomeVendedor, vTipV, vDescrCondPag, vCpfCgc: string;
  vTemPedVenda, vProcessoPermitido, vGerarPedVenda: Boolean;
  vValorItem, vValorUnitario, vValorDesconto, vComiss, vComissGer, vValorTotalItem, vDescontoItem: Extended;
  // Vauriaveis usadas no plano
  vMaxDesconto, vPlanoAcresc, vPlanoDesc: Extended;
  vDataAtual, vDataHoraAtual: TDate;
  vTransacaoPED: TIBTransaction;

  procedure _chamarPedVenda(pAcao: string);
  var
//    formulario: TForm;
//    hdTemp: THandle;
    vTemp: string;
    X: Integer;
  begin
    vTemp := 'CLOSE';
    if Application.MainForm.MDIChildCount > 0 then
      for X := 0 to Pred(Application.MainForm.MDIChildCount) do
        if UpperCase(Application.MainForm.MDIChildren[X].ClassName) = UpperCase('TFrmCadPedVenda') then
        begin
          vTemp := '';
          Break;
        end;

    // NF_GERAR_REQ  NF_REABRIR_REQ
    if pAcao = 'NF_REABRIR_REQ' then
    	vDadosIni.chamarReaberturaPEDpelaNF(vNPED, 'REQ', vValorTotalItem - vValorDesconto)
    else
    	vDadosIni.chamarConfirmacaoPEDpelaNF(vNPED, 'REQ', vValorTotalItem - vValorDesconto);

//    vDadosIni.vTipoForm := 0;
//    vDadosIni.vPesquisa := pAcao + '|' + IntToStr(vNPED) + '|' + Trim('REQ') + '|' + Trim(vTemp) + '|' +
//      Trim(Format( '%0.2n', [vValorTotalItem - vValorDesconto])) + '|';
//
//    formulario := Funcoes.AbreForm('pkPedidoVenda', 'TFrmCadPedVenda', hdTemp);
//    try
//      formulario.ShowModal;
//    finally
//      formulario.Free;
//      unLoadPackage(hdTemp);
//    end;

  end;

  function VoltaEstoque: Boolean;
  begin
    Result := True;

    if not ExecutaComandosSql('select nped, status_ped from pedvenda' +
      ' where nped = ' + IntToStr(vNPED) +
      ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status_ped = ''FECHADA''') then
      Exit;

    Result := False;

    _chamarPedVenda('NF_REABRIR_REQ');

    if ExecutaComandosSql('select nped, status_ped from pedvenda' +
      ' where nped = ' + IntToStr(vNPED) +
      ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status_ped = ''FECHADA''') then
      Result := False
    else
      Result := True;

  end;

begin
  Result := True;
//  Comentei estas linhas deixando o teste apenas na criacao da requisicao.
//  Pois se a mesma foi criada pela nf e a configuração desativada ainda sim a nf deverá voltar o estoque e cancelar a REQ
//  if vDadosIni.vEmp.vVnd_MontarPedVendaAutomaticoNaNF <> 'S' then
//    Exit;

  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    Exit;

  if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
    Exit;

  Result := False;
  if not vDadosIni.PesqPros('NF0143', 'CANCELAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString,
    'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas,True) then
    Exit;

  try

    try
      buscas.Close;
      buscas.Transaction := dtmNF.transacaoPED;
      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      buscas.Close;
      buscas.SQL.Text := 'select distinct nped from pedvenda' +
        ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
        ' and nf_gerou = ''S''';
      buscas.Open;

      if buscas.FieldByName('nped').AsInteger > 0 then
      begin
        vNPED := buscas.FieldByName('nped').AsInteger;
        buscas.Close;

        if not buscas.Transaction.InTransaction then
          buscas.Transaction.StartTransaction;
        
        buscas.SQL.Text := 'update pedvenda_prod set n_nf = null, serie = null' +
          ' where nped = ' + IntToStr(vNPED) +
          ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;


        if VoltaEstoque then
        begin

          if not buscas.Transaction.InTransaction then
            buscas.Transaction.StartTransaction;

          vDataAtual := vDadosIni.getDataBanco(buscas);

          buscas.Close;
          buscas.SQL.Text := 'update pedvenda set status_ped = ''CANCELADO'', DATA_FECH = :DATA_FECH' +
            ' where nped = ' + IntToStr(vNPED) +
            ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ParamByName('DATA_FECH').AsDate := vDataAtual;
          buscas.ExecSQL;

          buscas.Close;
          buscas.SQL.Text := 'update pedvenda_prod set status = ''CANCELADO''' +
            ' where nped = ' + inttostr(vNPED) +
            ' and tipo = ''REQ''' +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSQL;

          if buscas.Transaction.InTransaction then
            buscas.Transaction.Commit;

        end
        else
        begin
          Application.MessageBox(pchar('A Requisição não foi cancelada!' + sLineBreak +
            'Consequentemente o estoque das mercadorias não voltaram.' + sLineBreak +
            'Entre nas Vendas (Ctrl+Shift+V) pesquise o número da venda ' + IntToStr(vNPED) + ' e efetue o cancelamento'),
            'Atenção', 64);
          Result := False;
          vDadosIni.GravaAuditoria('NF0143', 'CANCELAR', 'FALHA NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
            'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
          Exit;
        end;

      end
      else
      begin
        vNPED := 0;
        Exit;
      end;

      _buscas.Close;
      _buscas.SQL.Text := 'select status_ped from pedvenda' +
        ' where nped = ' + IntToStr(vNPED) +
        ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
      _buscas.Open;

      Result := UpperCase(Trim(_buscas.FieldByName('status_ped').AsString)) = 'CANCELADA';

    finally
      if buscas.Transaction.InTransaction then
        buscas.Transaction.Rollback;
      buscas.Close;
      buscas.Transaction := transacao;
    end;

    if Result then
      vDadosIni.GravaAuditoria('NF0143', 'CANCELAR', 'SUCESSO NUM NF' + Trim(dataSet.FieldByName('num_nf').asString),
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);

  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('function cancelarPedVendaNF. Erro: ' + e.Message);
    end;
  end;
end;

