    ' and serie = ' + QuotedStr(vserieOrig) + ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and natureza_nf = ' + QuotedStr(vNatureza) + ' and cod_cliente = ' + IntToStr(vCodClFor) +
