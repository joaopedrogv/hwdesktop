function TNFCab.OperacaoComICMSInterestadualParaPartilha(ACFOP,
  ACodigoANP: Integer): boolean;
var
  vIE: string;
  vIndIEDest: Integer;
begin
  vIE := Trim(dataSet.FieldByName('insc_est').AsString);
  if UpperCase(Trim(vIE)) = 'ISENTO' then
    vIE:= '';
  vIndIEDest := dataSet.FieldByName('NFE_INDIEDEST').AsInteger;
//  if vIndIEDest = 0 then
//    vIndIEDest := vClFor.dataSet.FieldByName('NFE_INDIEDEST').AsInteger;

  if vIndIEDest = 0 then
    if vIE = '' then
      vIndIEDest := 9
    else
      vIndIEDest := 1;

  Result := (vIndIEDest = 9) and
            (dataSet.FieldByName('consumidor_final').AsString = 'S') and
            (getUFdaOperacao <> vDadosIni.vEmp.vSiglaUF) and
            (getUFdaOperacao <> 'EX') and
            (not CFOPRetorno(ACFOP)) and
            (not CFOPRemessa(ACFOP)) and
            (not CodigoANPExecaoIcmsUFDest(ACodigoANP));
end;

function TNFCab.PedidoIrregular: boolean;
var
  vRel: TRelRDPrint;
  existeIrregularidades: boolean;
  vValorTotal, vQtde: Double;
  vGrupo, vCodigo: string;

  procedure imprimeDadosIrregulares(irregularidade: string);
  begin
    //  imprimeDadosIrregulares('PRODUTO NÃO RECEBIDO') //não mostrar os campos do item da nota
    //  imprimeDadosIrregulares('PRODUTO NÃO PEDIDO'); //não mostrar os campos do item do pedido
    vRel.vRdP.Imp(vRel.vLinha, 1, vGrupo + ' ' + vCodigo);
    if pos('NÃO PEDIDO', irregularidade) = 0 then
      vRel.vRdP.Imp(vRel.vLinha, 8, vDadosIni.alndir(Format('%0.2f',
        [vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat]), 9));
    if pos('NÃO RECEBIDO', irregularidade) = 0 then
      vRel.vRdP.Imp(vRel.vLinha, 18, vDadosIni.alndir(Format('%0.2f', [vQtde]), 9));
    if pos('NÃO PEDIDO', irregularidade) = 0 then
      vRel.vRdP.Imp(vRel.vLinha, 29, vDadosIni.alndir(Format('%0.2n',
        [vPedCNf.vItem.dataSet.FieldByName('VAL_UNT_IT').AsFloat]), 9));
    if pos('NÃO RECEBIDO', irregularidade) = 0 then
      vRel.vRdP.Imp(vRel.vLinha, 41, vDadosIni.alndir(Format('%0.2n', [vValorTotal / vQtde]), 9));
    vRel.vRdP.Imp(vRel.vLinha, 61, irregularidade);
    vRel.vLinha := vRel.vLinha + 1;
    existeIrregularidades := True;
    if vRel.vLinha >= 85 then
    begin
      vRel.vRdP.Novapagina;
      vRel.novaPaginaPedido(Self);
    end;

  end;

begin
  Result := False;
  existeIrregularidades := False;
  if dataSet.FieldByName('num_ped').AsInteger <= 0 then
    Exit;

  if Copy(dataSet.FieldByName('devolucao').AsString,1,1) = 'S' then
  begin
    Result := True;
    Application.MessageBox('Foi informado o numero do Pedido de compra e o campo "Devolução" esta com o valor "SIM". Verifique se é uma Devolução ou uma Compra de mercadorias', 'Atenção', 0 + 64);
    Exit;
  end;

  buscas.Close;
  buscas.SQL.Text := 'select num_ped, codigo_f from pedido' +
    ' where num_ped = ' + IntToStr(dataSet.FieldByName('num_ped').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and DATA_CHG_PED is null and STATUS_PED = ''EFETIVADO''';
  buscas.Open;

  if buscas.FieldByName('num_ped').AsInteger <> dataSet.FieldByName('num_ped').AsInteger then
  begin
    Result := True;
    Application.MessageBox('Pedido de Compra informado não encontrado, Efetivado ou já recebido por outra Nota Fiscal. Verifique!', 'Atenção', 0 + 64);
    Exit;
  end;
  
  if (buscas.FieldByName('codigo_f').AsInteger <> dataSet.FieldByName('cod_cliente').AsInteger) and
    (buscas.FieldByName('codigo_f').AsInteger > 0) then
  begin
    Result := True;
    Application.MessageBox('Nota Fiscal com fornecedor diferente do fornecedor do Pedido de Compra', 'Atenção', 0 + 64);
    Exit;
  end;

  buscas.Close;
  buscas.SQL.Text := 'select num_ped, num_nf from notafiscal' +
    ' where num_ped = ' + IntToStr(dataSet.FieldByName('num_ped').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cod_nf <> ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and status <> ' + QuotedStr(stsCancelada);
  buscas.Open;

  if buscas.FieldByName('num_ped').AsInteger = dataSet.FieldByName('num_ped').AsInteger then
  begin
    Result := True;
    Application.MessageBox(pchar('Pedido de Compra já está vinculado a Nota Fiscal ' + buscas.FieldByName('num_nf').AsString), 'Atenção', 0 + 64);
    Exit;
  end;

  try
    vRel := TRelRDPrint.create;
    vRel.vRdP.TamanhoQteLinhas := 66;
    vRel.vRdP.TamanhoQteColunas := 87;
    vRel.vRdP.TitulodoRelatorio := 'Relatório de Irregularidades com Pedido de Compra';
    vDadosIni._LimparVarSendEmail;
    vRel.vRdP.OnSendMail := vDadosini._SendMailRdPrint;
    vRel.vRdP.OpcoesPreview.Remalina := True;
    vRel.vRdP.OpcoesPreview.CaptionPreview := 'Pré visualização';
    vRel.vRdP.OpcoesPreview.Preview := True;
    vRel.vRdP.CaptionSetup := 'Configurações';
    vRel.vRdP.Abrir;
    vRel.novaPaginaPedido(Self);
    //Abrindo itens do pedido
    vPedCNf.abrePedCompra(dataSet.FieldByName('num_ped').AsInteger);
    vPedCNf.vItem.First;
    while not vPedCNf.vItem.Eof do
    begin
      vGrupo := vPedCNf.vItem.dataSet.FieldByName('grupo_prod').AsString;
      vCodigo := Trim(vPedCNf.vItem.dataSet.FieldByName('cod_prod').AsString);
      vValorTotal := 0;
      vQtde := 0;
      vItem.First;
      while not vItem.dataSet.Eof do
      begin
        if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
        begin
          if (vGrupo = vItem.dataSet.FieldByName('grupo_prod').AsString)
            and (Trim(vCodigo) = Trim(vItem.dataSet.FieldByName('cod_prod').AsString)) then
          begin
            vQtde := vQtde + vItem.dataSet.FieldByName('quantidade').AsFloat;
            vValorTotal := (vValorTotal + vItem.dataSet.FieldByName('valor_total').AsFloat);
          end;
        end;
        vItem.dataSet.Next;
      end;
      if vQtde = 0 then
        imprimeDadosIrregulares('PRODUTO NÃO RECEBIDO') //não mostrar os campos do item da nota
      else
      begin
        if vDadosIni.StrToFloatFormat(vPedCNf.vItem.dataSet.FieldByName('VAL_TOT_IT').AsFloat /
          vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat, 2) >
          vDadosIni.StrToFloatFormat(vValorTotal / vQtde, 2) then
          imprimeDadosIrregulares('PRODUTO MAIS BARATO')
        else if vDadosIni.StrToFloatFormat(vPedCNf.vItem.dataSet.FieldByName('VAL_TOT_IT').AsFloat /
          vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat,
          2) < vDadosIni.StrToFloatFormat(vValorTotal / vQtde, 2) then
          imprimeDadosIrregulares('PRODUTO MAIS CARO');
        if vDadosIni.StrToFloatFormat(vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat, 2)
          > vDadosIni.StrToFloatFormat(vQtde, 2) then
          imprimeDadosIrregulares('QUANTIDADE PEDIDA MAIOR')
        else if
          vDadosIni.StrToFloatFormat(vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat,
          2) < vDadosIni.StrToFloatFormat(vQtde, 2) then
          imprimeDadosIrregulares('QUANTIDADE PEDIDA MENOR');
      end;
      vPedCNf.vItem.Next;
    end;
    vItem.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        vGrupo := vItem.dataSet.FieldByName('grupo_prod').AsString;
        vCodigo := Trim(vItem.dataSet.FieldByName('cod_prod').AsString);
        vValorTotal := 0;
        vQtde := 0;
        vPedCNf.vItem.First;
        while not vPedCNf.vItem.Eof do
        begin
          if (vGrupo = vPedCNf.vItem.dataSet.FieldByName('grupo_prod').AsString)
            and (Trim(vCodigo) = Trim(vPedCNf.vItem.dataSet.FieldByName('cod_prod').AsString)) then
            vQtde := vQtde + vPedCNf.vItem.dataSet.FieldByName('QUANT_IT_PROD').AsFloat;
          vPedCNf.vItem.Next;
        end;
      end;
      if vQtde = 0 then
      begin
        vQtde := vQtde + vItem.dataSet.FieldByName('quantidade').AsFloat;
        vValorTotal := (vValorTotal + vItem.dataSet.FieldByName('valor_total').AsFloat);
        imprimeDadosIrregulares('PRODUTO NÃO PEDIDO'); //não mostrar os campos do item do pedido
      end;
      vItem.dataSet.Next;
    end;
    if existeIrregularidades then
    begin
      Result := Application.MessageBox(pchar(
        'Irregularidades na nota fiscal de acordo o Pedido de Compra.' + sLineBreak +
        'Deseja continuar mesmo assim?'), 'Atenção', MB_YESNO +
        MB_ICONQUESTION) = IDNO;

      if not Result then
        if not vDadosIni.PesqPros('NF0167', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString + ' PED COMPRA' + dataSet.FieldByName('num_ped').AsString,
          'EMPRESA', dataSet.FieldByName('COD_NF').AsString, buscas, True) then
        begin
          Result := True;
          Exit;
        end;
    end;

    if not existeIrregularidades then
    begin
      vRel.vRdP.Abortar;
      Exit;
    end;
    if Application.MessageBox(pchar(
      'Deseja imprimir Irregularidades'), 'Atenção', MB_YESNO +
      MB_ICONQUESTION) = IDNO then
    begin
      vRel.vRdP.Abortar;
      exit;
    end;
    try
      vRel.vRdP.Fechar;
    except
      vRel.vRdP.Abortar;
    end;
  except
    vRel.vRdP.Abortar;
  end;
end;

procedure TNFCab.pedvenda_referencia_montar;
var
  PedVendaRef: TPedvenda_ref_nf_classList;
  I: Integer;
  Ainsert: Boolean;
begin
  PedVendaRef := TPedvenda_ref_nf_classList.Create;
  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.fint('nped') > 0) and (not vItem.str_empty('tipo_ped')) and (vItem.fint('nitem_ped') > 0) then
      begin
        Ainsert := True;
        for I := 0 to PedVendaRef.Count - 1 do with PedVendaRef.Items[I] do
          if (nped = vItem.fint('nped')) and (tipo = vItem.fstr('tipo_ped')) then
          begin
            Ainsert := False;
            Break;
          end;
        if Ainsert then
          with PedVendaRef.New do
          begin
            nped        := vItem.fint('nped');
            tipo        := vItem.fstr('tipo_ped');
            cod_empresa := vItem.fint('cod_empresa');
            cod_nf      := vItem.fint('cod_nf');
          end;
      end;
      vItem.dataSet.Next;
    end;

    for I := 0 to PedVendaRef.Count - 1 do
      SqlExec(PedVendaRef.Items[I].SQLMotor().SQLUpdateOrInsert);

  finally
    FreeAndNil(PedVendaRef);
  end;
end;

function TNFCab.permiteAlterarNotaFechadaParaSPED: Boolean;
var
  id: Integer;
begin
  if not vDadosIni.PesqPros('NF0039', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    if dataSet.IsEmpty then
      raiseExceptionCreate('Nenhuma Nota Fiscal selecionada', '');

    id := fint('cod_nf');

    dataSet.Refresh;

    if id <> fint('cod_nf') then
      if not dataSet.Locate('COD_NF', id, []) then
        raiseExceptionCreate('Consulte e tente novamente');

    //if dataSet.FieldByName('emissao_propria').AsString = 'S' then
      //raiseExceptionCreate('Nota Fiscal de Emissão Própria não pode ser modificada', '');

    if get_status <> stsFechada then
      raiseExceptionCreate('Nota Fiscal somente poderá ser alterada se seu Status = "Fechada"', '');

    Result := True;

  except
    on e: exception do begin
      Application.MessageBox(pchar(e.message), 'Atenção', MB_ICONINFORMATION + MB_OK);
    end;
  end;
end;

function TNFCab.permiteConfirmacao: Boolean;
var
  AAberta : Boolean;
begin
  if (get_cod_nf = 0) then
  begin
    Result := False;
    Exit;
  end;

  Result := (get_status = stsAberta) and
            (get_cod_nf > 0)
            and (vItem.dataSet.ChangeCount = 0);
  if not Result then
  begin
    setVariavelStatusNf;
    if GetVersaoNFe = vnf400 then
      Result := emEdicao
    else
      Result := not vStatusFechada;
  end;
end;

function TNFCab.post: boolean;
var
  vTentarNoSCAN, vOK, controlsDisabled, isInsert: Boolean;
  vCodNf: Integer;
  vProc: string;
  I: Integer;
begin
  try
    Result := false;
    vProc := 'NF0030';
    if dataSet.FieldByName('NATUREZA_NF').AsString = 'S' then
      vProc := 'NF0031';
    if not vDadosIni.PesqPros(vProc, vAcao, 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, buscas, True) then
      Exit;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if (Trim(dataSet.FieldByName('NATUREZA_NF').AsString) = 'E') and
      (Trim(dataSet.FieldByName('EMISSAO_PROPRIA').AsString) = 'S') and
      (get_status = stsAberta) and
      (get_situacao_nfe = sitAutorizada) then
    begin
      Application.MessageBox('Nota Fiscal já autorizada no Web Service. Aguardando confirmação no sistema. Nenhuma Alteração é permitida', 'Atenção', 64);
      Result := True;
      Exit;
    end;

    if ((vDadosIni.StrZero(Trim(dataSet.FieldByName('modelo_nf').AsString), 3) = '001') or
      (vDadosIni.StrZero(Trim(dataSet.FieldByName('modelo_nf').AsString), 3) = '01A') or
      (vDadosIni.StrZero(Trim(dataSet.FieldByName('modelo_nf').AsString), 3) = '1-A') or
      (Trim(dataSet.FieldByName('modelo_nf').AsString) = 'E') or
      (Trim(dataSet.FieldByName('modelo_nf').AsString) = 'O')) and
      (dataSet.FieldByName('sem_serie').AsString = 'S') and
      (dataSet.FieldByName('emissao_propria').AsString = 'N') then
      dataSet.FieldByName('serie').AsString := '0';
    if (vDadosIni.StrZero(Trim(dataSet.FieldByName('modelo_nf').AsString), 3) <> '001') and
      (Trim(dataSet.FieldByName('modelo_nf').AsString) <> 'E') and
      (Trim(dataSet.FieldByName('modelo_nf').AsString) <> 'O') then
      dataSet.FieldByName('sem_serie').Value := Null;
    if (Trim(dataSet.FieldByName('tipo_nf').AsString) = 'S') then
    begin
      if (Trim(dataSet.FieldByName('modelo_nf').AsString) = 'E') then
      begin
        dataSet.FieldByName('MOD_DES_BH').AsString := '5';
        if Trim(dataSet.FieldByName('CHAVE_NFSE').AsString) = '' then
          raiseExceptionCreate('Chave ou Código de Verificação para a NFS-e obrigatório', '')
      end
      else if Trim(dataSet.FieldByName('MOD_DES_BH').AsString) = '5' then
        raiseExceptionCreate('Modelo DES BH com valor "5" somente para modelo da NF igual a "E": Eletronico', '')
      else
        vOK := False;
        for I := Low(modeloDESBH) to High(modeloDESBH) do
          if Trim(dataSet.FieldByName('MOD_DES_BH').AsString) = modeloDESBH[i] then
          begin
            vOK := True;
            Break;
          end;
        if not vOK then
          raiseExceptionCreate('Modelo DES BH preenchido incorretamente ou sem preenchimento', '');
    end;

    if fempty('op_interna_id') then
      dataSet.FieldByName('op_interna_id').Clear();

    //Validação de divergencias do NCM e CEST
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      if not vItem.divergNcmCest.verificaDivergencias(vItem) then
        if not vDadosIni.abreForm('Correção de Divergencias NCM e/ou CEST', frmCadNF.pnIrregularidadesNCMCEST, []) then
        begin
          vItem.divergNcmCest.clearEventos;
          Exit;
        end
        else
        begin
          vItem.divergNcmCest.clearEventos;
          vItem.setDivergenciasNcmCest;
        end;

    somaTotaisNF(True);
    definirPISCOFINS;
    calcularDadosDeOlhoNoImposto;

    //    if dataSet.State = dsInsert then
    if dataSet.FieldByName('cod_nf').AsInteger = 0 then
    begin
      if dataSet.FieldByName('tipo_nf').AsString = 'V' then
        if not salvaDadosDetalhesVeiculo then
          exit;

      dataSet.FieldByName('cod_nf').AsInteger :=
        Gencodigo('NOTAFISCAL', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);

      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('cod_nf').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
        if vItem.dataSet.FieldByName('tipo_item').AsString = 'D' then
          vItem.dataSet.FieldByName('num_fab_prod').AsString :=
            vDadosIni.StrZero(dataSet.FieldByName('cod_nf').AsInteger, 7) +
            vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3);
        vItem.dataSet.Post;
        vItem.dataSet.Next;
      end;

      if vSped.vC110.dataSet.Active then
      begin
        vSped.vC110.dataSet.First;
        while not vSped.vC110.dataSet.Eof do
        begin
          vSped.vC110.dataSet.Edit;
          vSped.vC110.dataSet.FieldByName('cod_nf').AsInteger :=
            dataSet.FieldByName('cod_nf').AsInteger;
          vSped.vC110.dataSet.Post;
          vSped.vC110.dataSet.Next;
        end;
      end;

      if vSped.vC120.dataSet.Active then
      begin
        vSped.vC120.dataSet.First;
        while not vSped.vC120.dataSet.Eof do
        begin
          vSped.vC120.dataSet.Edit;
          vSped.vC120.dataSet.FieldByName('cod_nf').AsInteger :=
            dataSet.FieldByName('cod_nf').AsInteger;
          vSped.vC120.dataSet.Post;
          vSped.vC120.dataSet.Next;
        end;
      end;
      
      if vSped.vC195_C197.dataSet.Active then
      begin
        vSped.vC195_C197.dataSet.First;
        while not vSped.vC195_C197.dataSet.Eof do
        begin
          vSped.vC195_C197.dataSet.Edit;
          vSped.vC195_C197.dataSet.FieldByName('cod_nf').AsInteger :=
            dataSet.FieldByName('cod_nf').AsInteger;
          vSped.vC195_C197.dataSet.Post;
          vSped.vC195_C197.dataSet.Next;
        end;
      end;

      if dataSet.FieldByName('tipo_nf').AsString = 'V' then
      begin
        vItem.vDetVeic.dataSet.First;
        while not vItem.vDetVeic.dataSet.Eof do
        begin
          vItem.vDetVeic.dataSet.Edit;
          vItem.vDetVeic.dataSet.FieldByName('cod_nf').AsInteger :=
            dataSet.FieldByName('cod_nf').AsInteger;
          vItem.vDetVeic.dataSet.Post;
          if (Trim(dataSet.FieldByName('NATUREZA_NF').AsString) = 'S') then
            GravarHistEstMoto;
          vItem.vDetVeic.dataSet.Next;
          SetDadosVeiculoComando;
        end;
      end
      else if dataSet.FieldByName('tipo_nf').AsString = 'P' then
//        if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
          vItem.vDetEcf.selecionaDetalhesECF(dataSet.FieldByName('cod_nf').AsInteger);
    end;

    dataSet.FieldByName('serie').AsString := Trim(dataSet.FieldByName('serie').AsString);
    dataSet.FieldByName('modelo_nf').AsString := Trim(dataSet.FieldByName('modelo_nf').AsString);

    vCodNf := dataSet.FieldByName('cod_nf').AsInteger;

    if (Trim(dataSet.FieldByName('SERIE_COMPL').AsString) <> '') and
      (dataSet.FieldByName('NUM_NF_COMPL').AsInteger > 0) then
    begin
      dataSet.FieldByName('SERIE_EMT').AsString := dataSet.FieldByName('SERIE_COMPL').AsString;
      dataSet.FieldByName('NUM_NF_EMT').AsInteger := dataSet.FieldByName('NUM_NF_COMPL').AsInteger;
    end;

    isInsert := dataSet.State = dsInsert;

    if not isInsert then
      verificaMensagensDadosAdicionais;

    Result := inherited post;

    //    if dataSet.ChangeCount = 0 then
    //    begin
    //      Result := true;
    //      exit;
    //    end;

    if (Apply) or (dataSet.ChangeCount = 0) then
    begin
      if isInsert then
        verificaMensagensDadosAdicionais();

      if not vItem.Apply then
      begin
        //        RollBackTransacao;
        dataSet.Edit;
        exit;
      end;

      pedvenda_referencia_montar;

      if not FpagNFe.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not FdupNFe.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not Fcoleta.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not Fentrega.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not FobsCont.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not Fdefensivo.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      if not FguiaTransito.Apply then
      begin
        dataSet.Edit;
        Exit;
      end;

      vSped.vC110.Apply;
      vSped.vC120.Apply;
