      ' and num_nota = :num_nf and sub_serie =  :serie' +
      ' and tpdocs <> ''LCS'' and tipdoc = ''S2''';
    buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
    buscas.ParamByName('serie').AsInteger := StrToIntDef(Trim(dataSet.FieldByName('serie').AsString), 0);
    buscas.ExecSQL;

    // consulta das formas de pagamento ja processadas para atribuir os dados da transacao
    buscas.Close;
    buscas.SQL.Text := 'select n_processamento from formpagamento' +
      ' where tpdocs = ' + QuotedStr(Trim(vTIPVND)) +
      ' and nrequisicao = ' + IntToStr(vNumVND) +
      ' and coalesce(secao,0) = ' + IntToStr(vSecao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and num_nota = :num_nf and sub_serie =  :serie' +
      ' and tpdocs <> ''LCS'' and tipdoc = ''S2''' +
      ' and n_processamento > 0';
    buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
    buscas.ParamByName('serie').AsInteger := StrToIntDef(Trim(dataSet.FieldByName('serie').AsString), 0);
    buscas.Open;

    buscas.First;
    while not buscas.Eof do
    begin

      //alteracao dos creditos com os dados da transacao
      buscas2.Close;
      buscas2.SQL.Text := 'update CONTROLE_CREDITOS' +
        ' set cod_terminal_adm = ' + QuotedStr(Copy(Trim(vTerminalAdm),1,10)) +
        ', n_aut_cart = ' + QuotedStr(Copy(Trim(vDadosIni.vPOSV.retornoAUT),1,20)) +
        ', n_docnsu_adm = ' + QuotedStr(Copy(Trim(vDadosIni.vPOSV.retornoNSU),1,10)) +
        ' where cod_cred = ' + IntToStr(buscas.FieldByName('n_processamento').AsInteger) +
        ' and ' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') +
        ' = ' + vDadosIni.codEmpresa +
        ' and DATQ_C is null';
      buscas2.ExecSQL;

      buscas.Next;
    end;

    vDadosIni.gravaTransacaoPosVirtual(vSeqIDTransacao, vTIPVND, vTerminalAdm, vNumVND, vSecao, vCtrl, buscas);

    buscas.Transaction.Commit;

    verificaFaturasEmCartao;

    Result := True;

    vDadosIni.GravaAuditoria('NF0192', 'CARTAO', 'SUCESSO - NUM NF '+ dataSet.FieldByName('NUM_NF').AsString + '-' +
      'AUT:' + Trim(vDadosIni.vPOSV.retornoAUT) + '-NSU:' + Trim(vDadosIni.vPOSV.retornoNSU) +
      '-TERM:' + Trim(vTerminalAdm), 'NOTAFISCAL', dataSet.FieldByName('COD_NF').AsString, buscas2);

  except on E: Exception do
    begin
      buscas.Transaction.Rollback;

      vDadosIni.GravaAuditoria('NF0192', 'CARTAO', 'FALHA - NUM NF '+ dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas2);

      verificaFaturasEmCartao;

      Result := False;
      registraErro('function TNFCab.efetuarTransacaoCartaoRegistroSelecionado. Erro: ' + e.Message);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Erro', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

