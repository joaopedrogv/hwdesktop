function TGradeCompraNF.salvaQtdeGrade(pQtdeInformada: Double): boolean;
begin
  if vDadosIni.StrToFloatFormat(pQtdeInformada, 4) > vDadosIni.StrToFloatFormat(FQtdePendente, 4)
    then
  begin
    if Format('%0.4f', [pQtdeInformada]) <> Format('%0.4f', [FQtdeInformada]) then
    begin
      result := False;
      Application.MessageBox(pchar('Quantidade Informada maior que a quantidade Pendente'),
        'Atenção', mb_ok +
        MB_ICONINFORMATION);
      Exit;
    end;
  end;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if dataSet.FieldByName('cod_grade').AsInteger =
      vGrades.dataSet.FieldByName('cod_grade').AsInteger then
    begin
      dataSet.Edit;
      Break;
    end;
    dataSet.Next;
  end;
  try
    if dataSet.State = dsEdit then
      dataSet.FieldByName('qtde').AsFloat :=
        dataSet.FieldByName('qtde').AsFloat +
        vDadosIni.StrToFloatFormat(pQtdeInformada, 4)
    else
    begin
      dataSet.Insert;
      dataSet.FieldByName('NUM_NOTA_NFE').AsInteger := FNumeroNotaFiscal;
      dataSet.FieldByName('COD_FORN_NFE').AsInteger := FNItem; //0;
      dataSet.FieldByName('GRUPO_PROD').AsInteger :=
        vGrades.dataSet.FieldByName('GRUPO_PROD').AsInteger;
      dataSet.FieldByName('COD_PROD').AsString := vGrades.dataSet.FieldByName('COD_PROD').AsString;
      dataSet.FieldByName('COD_GRADE').AsInteger :=
        vGrades.dataSet.FieldByName('COD_GRADE').AsInteger;
      dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      dataSet.FieldByName('QTDE').AsFloat := vDadosIni.StrToFloatFormat(pQtdeInformada, 4);
    end;
    dataSet.Post;
  except
    on e: Exception do begin
      Result := false;
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' salvaQtdeGrade .CodGrade: ' +
        dataSet.FieldByName('cod_grade').AsString + ' ' + e.Message);
    end;
  end;

  FQtdeInformada := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if dataSet.FieldByName('qtde').AsFloat > 0 then
      FQtdeInformada := FQtdeInformada + dataSet.FieldByName('qtde').AsFloat;
    dataSet.Next;
  end;
  FQtdePendente := FQtdeTotal - FQtdeInformada;
  Result := True;
  if Format('%0.4f', [FQtdePendente]) = '0,0000' then
  begin

  end;
end;

function TGradeCompraNF.selecionaGradeCompra(pGrupo, pCodNf, pNItem: integer;
  pCodigo, pSelG: string; pQtdePendente: Double): boolean;
begin
  //Abre a tabela grade inner join cod_grade_prod( estoque ).
  vGrades.selecionaGradeDoProduto(pGrupo, pCodigo);
  if vGrades.dataSet.IsEmpty then // Se na tiver sai
  begin
    if pSelG = 'S' then
      vGrades.selecionaGradeDoProduto(pGrupo, pCodigo, True)
    else
    begin
      Result := False;
      Exit;
    end;
  end
  else if (vDadosIni.vMostrarTodasGradesEntradaNF = 'S') then
    vGrades.selecionaGradeDoProduto(pGrupo, pCodigo, True);

  if vGrades.dataSet.IsEmpty then // Se na tiver sai
  begin
    Result := False;
    Exit;
  end;

  //Aqui a qtde total sera a quantidade que passar o parametro
  FQtdeTotal := pQtdePendente;
  FNumeroNotaFiscal  := pCodNf;
  FNItem :=  pNItem;
  //Abre as entradas da grade. Caso ja exista entrada para algum itam será mostrado assim mesmo
  Result := montaSelect('select * from cod_grade_prod_compra' +
    ' where grupo_prod = ' + IntToStr(pGrupo) +
    ' and cod_prod = ' + QuotedStr(pCodigo) +
    ' and num_nota_nfe = ' + IntToStr(pCodNf) +
    ' and cod_forn_nfe = ' + IntToStr(pNItem) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1');
  //Aqui soma a quantidade que ja for informada
  FQtdeInformada := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if dataSet.FieldByName('qtde').AsFloat > 0 then
      FQtdeInformada := FQtdeInformada + dataSet.FieldByName('qtde').AsFloat;
    dataSet.Next;
  end;
  //Aqui soma o total com a quantidade informada. Caso o mesmo produto seja informado duas vezes na nota fiscal
  FQtdeTotal := FQtdeTotal + FQtdeInformada;
  FQtdePendente := FQtdeTotal - FQtdeInformada;
  Result := True;
end;

