function TNFCab.definirItensBxRetornoFin: Boolean;
var
  vOKCreditos: Boolean;
  vSql:string;
begin
  Result := True;

  buscas.Close;
  buscas.SQL.Text := 'select first 1 CC.COD_CLIENTE from CONTROLE_CREDITOS CC' +
    ' inner join CONTROLES C ON C.CODIGO_CTRL = CC.CODIGO_CTRL and C.CODIGO_EMP = CC.CODIGO_EMP and C.RETORNOS = ''S''' +
    ' where CC.COD_CLIENTE = :COD_CLIENTE and CC.DATQ_C IS NULL ' +
    ' and CC.' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') + ' = ' + vDadosIni.codEmpresa;
  buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
  buscas.Open;

  if buscas.IsEmpty then
    Exit;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin

    buscas.Close;
    buscas.SQL.Text := 'select USA_BX_RETORNO_FIN from NAT_OP' +
      ' where CODIGO_NOP = :CODIGO_NOP and USA_BX_RETORNO_FIN = ''S''';
    buscas.ParamByName('CODIGO_NOP').AsFloat := vItem.dataSet.FieldByName('codigo_nop').AsFloat;
    buscas.Open;

//    vItem.dataSet.Edit;
    if buscas.IsEmpty then
      vSql := 'update notafiscal_item set BX_RETORNO_FIN = ''N'''
    else
      vSql := 'update notafiscal_item set BX_RETORNO_FIN = ''S''';

    buscas.Close;
    buscas.SQL.Text := vSql + ' where cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
      ' and nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
      ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
    buscas.ExecSQL;

//      vItem.dataSet.FieldByName('BX_RETORNO_FIN').AsString := 'N'
//    end
//    else
//      vItem.dataSet.FieldByName('BX_RETORNO_FIN').AsString := 'S';
//    vItem.dataSet.Post;
    vItem.dataSet.Next;
  end;
end;

function TNFCab.definirPISCOFINS: boolean;
var
  vTempCSTPIS, vTempCSTCOFINS, vTempNAT_REC: String;
  vTempAliqPIS, vTempAliqCOFINS: Double;
  vValorCOFINSTotal, vValorPISTotal, vValorCOFINSTotal_ST, vValorPISTotal_ST, vLucroVeiculoUsado: Currency;
  vTributadoPorQtde, vVeiculoUsado, CST_05_BaseZero: Boolean;
  ListConfNcmCfop: TStrings;
  ConfPesq, ConfPesq9, ConfAdicional, StrMod: string;
  I: Integer;
  ConfList: TConfig_sistema_classList;
  ConfBC: TConfig_sistema_class;
begin
  Result := True;
  Exit;
  try
    vValorPISTotal:=0;
    vValorCOFINSTotal:=0;
    vValorPISTotal_ST:=0;
    vValorCOFINSTotal_ST:=0;
    ListConfNcmCfop := TStringList.Create;
//    ListConfNcmCfop := vDadosIni.getConfSisBlob('nf_conf_ncm_cfop_piscofins', buscas);  

    ConfList := TConfig_sistema_classList.Create;
    try

      ConfList.AddKey('nf_conf_ncm_cfop_piscofins').
               AddKey('nf_piscofins_cst_05_revenda_base_zero').
               AddKey('nf_piscofins_bases').
               MakeAll(buscas, StrToInt(vDadosIni.codEmpresa));

      with ConfList.GetConf('nf_piscofins_cst_05_revenda_base_zero') do
        CST_05_BaseZero := value1_f = 1;

      if Assigned(ConfList.GetConf('nf_conf_ncm_cfop_piscofins')) then
        ListConfNcmCfop.Text := ConfList.GetConf('nf_conf_ncm_cfop_piscofins').value1_b.Text;

      if Assigned(ConfList.GetConf('nf_piscofins_bases')) then
        ConfBC := ConfList.GetConf('nf_piscofins_bases').Clone
      else
        ConfBC := TConfig_sistema_class.Create;
    finally
      FreeAndNil(ConfList);
    end;

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vTempAliqPIS := 0;
      vTempAliqCOFINS := 0;
      vLucroVeiculoUsado := 0;
      vVeiculoUsado := False;
      vTempCSTPIS := Trim(vItem.dataSet.FieldByName('CST_PIS').AsString);
      vTempCSTCOFINS := Trim(vItem.dataSet.FieldByName('CST_COFINS').AsString);
      vTempNAT_REC := '';
      vTributadoPorQtde := False;
      ConfPesq  := '|' + Trim(vItem.dataSet.FieldByName('NCM').AsString       ) + '|' +
               IntToStr(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) + '|';
      ConfPesq9  := '|99999999|' +
               IntToStr(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) + '|';
      ConfAdicional := '';
      for I := 0 to ListConfNcmCfop.Count - 1 do
        if Pos(ConfPesq, ListConfNcmCfop[I]) = 1 then
        begin
          ConfAdicional := ListConfNcmCfop[I];
          Break;
        end
        else if Pos(ConfPesq9, ListConfNcmCfop[I]) = 1 then
          ConfAdicional := ListConfNcmCfop[I];

      if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
      begin
        vTempCSTPIS := '99';
        vTempCSTCOFINS := '99';
      end
      else
      begin
        if (Trim(vDadosIni.vEmp.vSpedIncidTribPISCOFINS) = '') then
        begin
          Application.MessageBox(
            'Indicador de Incidência Tributária do PIS/COFINS não definida no Cadastro da Empresa',
            'Atenção', 0 + 64);
          Exit;
        end;
      end;

      vItem.dataSet.Edit;
      if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
      begin

        if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
        begin

          vItem.vProd.buscaProduto(
            vItem.dataSet.FieldByName('grupo_prod').AsInteger,
            vItem.dataSet.FieldByName('cod_prod').AsString);

          //PIS
          if Trim(vItem.vProd.dataSet.FieldByName('cst_pis').AsString) <> '' then
            vTempCSTPIS := Trim(vItem.vProd.dataSet.FieldByName('cst_pis').AsString)
          else
            vTempCSTPIS := '01';

          if (vTempCSTPIS = '02') or (vTempCSTPIS = '03') or (vTempCSTPIS = '05') then
            vTempAliqPIS := vItem.vProd.dataSet.FieldByName('ALIQ_PIS_DIFERENCIADA').AsFloat
          else if (vTempCSTPIS = '01') then
            vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;

          //COFINS
          if Trim(vItem.vProd.dataSet.FieldByName('cst_cofins').AsString) <> '' then
            vTempCSTCOFINS := Trim(vItem.vProd.dataSet.FieldByName('cst_cofins').AsString)
          else
            vTempCSTCOFINS := '01';

          if (vTempCSTCOFINS = '02') or (vTempCSTCOFINS = '03') or (vTempCSTCOFINS = '05') then
            vTempAliqCOFINS := vItem.vProd.dataSet.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsFloat
          else if (vTempCSTCOFINS = '01') then
            vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;

          //end;
        end  //produtos
        else if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
        begin

          vItem.vServ.buscaTipoServico(
            vItem.dataSet.FieldByName('cod_servico').AsInteger);

//          if Trim(vItem.vServ.dataSet.FieldByName('isento_pis').AsString) = 'S' then
//            vTempCSTPIS := '04'
          if Trim(vItem.vServ.dataSet.FieldByName('cst_pis').AsString) <> '' then
            vTempCSTPIS := Trim(vItem.vServ.dataSet.FieldByName('cst_pis').AsString)
          else //if (Trim(vTempCSTPIS) = '') then
            vTempCSTPIS := '01';

//          if Trim(vItem.vServ.dataSet.FieldByName('isento_pis').AsString) = 'S' then
//            vTempCSTCOFINS := '04'
          if Trim(vItem.vServ.dataSet.FieldByName('cst_cofins').AsString) <> '' then
            vTempCSTCOFINS := Trim(vItem.vServ.dataSet.FieldByName('cst_cofins').AsString)
          else //if (Trim(vTempCSTCOFINS) = '') then
            vTempCSTCOFINS := '01';

          if (vTempCSTPIS = '02') or (vTempCSTPIS = '03') or
            (vTempCSTPIS = '05') or (vTempCSTPIS = '01') then
            vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;

          if (vTempCSTCOFINS = '02') or (vTempCSTCOFINS = '03') or
            (vTempCSTCOFINS = '05') or (vTempCSTCOFINS = '01') then
            vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;

        end
        else if vItem.dataSet.FieldByName('tipo_item').AsString = 'V' then
        begin
          vLucroVeiculoUsado := 0;
          vItem.vDetVeic.dataSet.First;
          while not vItem.vDetVeic.dataSet.Eof do
          begin
            if vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger =
              vItem.dataSet.FieldByName('nitem').AsInteger then
              Break;
            vItem.vDetVeic.dataSet.Next;
          end;
          if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'U' then
          begin
            vVeiculoUsado := True;
            vLucroVeiculoUsado := (vItem.dataSet.FieldByName('valor_total').AsFloat -
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat) +
              vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
              vItem.dataSet.FieldByName('rateio_outdesp').AsFloat;
            if (dataSet.FieldByName('FRETECONTA_TR').AsString = '2') and
              (dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S') and
              (vItem.dataSet.FieldByName('rateio_frete').AsFloat > 0) then
              vLucroVeiculoUsado := vLucroVeiculoUsado + vItem.dataSet.FieldByName('rateio_frete').AsFloat;
            vLucroVeiculoUsado :=  vLucroVeiculoUsado - vItem.vDetVeic.dataSet.FieldByName('PRECOCOMPRA').AsFloat;
            if vLucroVeiculoUsado < 0 then
              vLucroVeiculoUsado := 0;
//            if not vVeiculoUsado then
//            begin
//              vLucroVeiculoUsado := 0;
//              vTempCSTPIS := '05';
//              vTempCSTCOFINS := '05';
//              vTempAliqPIS := 0;
//              vTempAliqCOFINS := 0;
//            end
//            else
//            begin
              vTempCSTPIS := '01';
              vTempCSTCOFINS := '01';
              vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;
              vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;
//            end;
          end
          else
//          if not vVeiculoUsado then
          begin
          vTempCSTPIS := '05';
          vTempCSTCOFINS := '05';
          vTempAliqPIS := 0;
          vTempAliqCOFINS := 0;
          end;
        end
        else
        begin
          if Trim(vTempCSTPIS) = '' then
            vTempCSTPIS := '01';

          if Trim(vTempCSTCOFINS) = '' then
            vTempCSTCOFINS := '01';

          if (vTempCSTPIS = '03') then
            vTempAliqPIS := vItem.dataSet.FieldByName('ALIQ_PIS_QUANT').AsFloat
          else if (vTempCSTPIS = '01') then
            vTempAliqPIS := vDadosIni.vEmp.vAliqPIS
          else if vItem.dataSet.FieldByName('ALIQ_PIS').AsFloat > 0 then
            vTempAliqPIS := vItem.dataSet.FieldByName('ALIQ_PIS').AsFloat;

          if (vTempCSTCOFINS = '03') then
            vTempAliqCOFINS := vItem.dataSet.FieldByName('ALIQ_COFINS_QUANT').AsFloat
          else if (vTempCSTCOFINS = '01') then
            vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS
          else if vItem.dataSet.FieldByName('ALIQ_COFINS').AsFloat > 0 then
            vTempAliqCOFINS := vItem.dataSet.FieldByName('ALIQ_COFINS').AsFloat;

        end;

        if cfopDeDevolucaoSPED(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) then
        begin
          vTempCSTPIS := '49';
          vTempCSTCOFINS := '49';
        end;

        vTributadoPorQtde := (vItem.dataSet.FieldByName('ALIQ_PIS_QUANT').AsFloat > 0);
      end
      else //Entrada
      begin
        if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
        begin

          if (Trim(vTempCSTPIS) = '') or (Trim(vTempCSTCOFINS) = '') then
            vItem.vProd.buscaProduto(
              vItem.dataSet.FieldByName('grupo_prod').AsInteger,
              vItem.dataSet.FieldByName('cod_prod').AsString);

          if (Trim(vTempCSTPIS) = '') then
            if Trim(vItem.vProd.dataSet.FieldByName('cst_pis_ent').AsString) <> '' then
              vTempCSTPIS := Trim(vItem.vProd.dataSet.FieldByName('cst_pis_ent').AsString)
            else
              vTempCSTPIS := '50';

          if (Trim(vTempCSTCOFINS) = '') then
            if Trim(vItem.vProd.dataSet.FieldByName('cst_cofins_ent').AsString) <> '' then
              vTempCSTCOFINS := Trim(vItem.vProd.dataSet.FieldByName('cst_cofins_ent').AsString)
            else
              vTempCSTCOFINS := '50';

          if vItem.vProd.dataSet.FieldByName('ALIQ_CRED_PIS').AsFloat > 0 then
            vTempAliqPIS := vItem.vProd.dataSet.FieldByName('ALIQ_CRED_PIS').AsFloat;

          if vItem.vProd.dataSet.FieldByName('ALIQ_CRED_COFINS').AsFloat > 0 then
            vTempAliqCOFINS := vItem.vProd.dataSet.FieldByName('ALIQ_CRED_COFINS').AsFloat;

        end
        else if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
        begin
          if (Trim(vTempCSTPIS) = '') or (Trim(vTempCSTCOFINS) = '') then
            vItem.vServ.buscaTipoServico(
              vItem.dataSet.FieldByName('cod_servico').AsInteger);

          if (Trim(vTempCSTPIS) = '') then
            if Trim(vItem.vServ.dataSet.FieldByName('cst_pis').AsString) <> '' then
              vTempCSTPIS := Trim(vItem.vServ.dataSet.FieldByName('cst_pis').AsString)
            else
              vTempCSTPIS := '50';

          if (Trim(vTempCSTCOFINS) = '') then
            if Trim(vItem.vServ.dataSet.FieldByName('cst_cofins').AsString) <> '' then
              vTempCSTCOFINS := Trim(vItem.vServ.dataSet.FieldByName('cst_cofins').AsString)
            else
              vTempCSTCOFINS := '50';

        end
        else if vItem.dataSet.FieldByName('tipo_item').AsString = 'V' then
        begin
          if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'U' then
          begin
            vVeiculoUsado := True;
            vLucroVeiculoUsado := 0;
            vTempCSTPIS := '50';
            vTempCSTCOFINS := '50';
            vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;
            vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;
          end
          else
          begin
          vTempCSTPIS := '75';
          vTempCSTCOFINS := '75';
          vTempAliqPIS := 0;
          vTempAliqCOFINS := 0;
          end;
        end
        else
        begin
          if Trim(vTempCSTPIS) = '' then
          begin
            vTempCSTPIS := '50';
            vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;
            vTempCSTCOFINS := '50';
            vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;
          end;
        end;

        if (vTempCSTPIS = '70') or (vTempCSTPIS = '71') or (vTempCSTPIS = '72') or
          (vTempCSTPIS = '73') or (vTempCSTPIS = '74') then
          vTempAliqPIS := 0
        else if vItem.dataSet.FieldByName('ALIQ_PIS').AsFloat > 0 then
          vTempAliqPIS := vItem.dataSet.FieldByName('ALIQ_PIS').AsFloat
        else if vItem.dataSet.FieldByName('ALIQ_PIS_QUANT').AsFloat > 0 then
          vTempAliqPIS := vItem.dataSet.FieldByName('ALIQ_PIS_QUANT').AsFloat
        else if ((copy(vTempCSTPIS, 1, 1) = '5') or (copy(vTempCSTPIS, 1, 1) = '6')) and (vTempAliqPIS = 0) then
          vTempAliqPIS := vDadosIni.vEmp.vAliqPIS;

        if (vTempCSTCOFINS = '70') or (vTempCSTCOFINS = '71') or (vTempCSTCOFINS = '72') or
          (vTempCSTCOFINS = '73') or (vTempCSTCOFINS = '74') then
          vTempAliqCOFINS := 0
        else if vItem.dataSet.FieldByName('ALIQ_COFINS').AsFloat > 0 then
          vTempAliqCOFINS := vItem.dataSet.FieldByName('ALIQ_COFINS').AsFloat
        else if vItem.dataSet.FieldByName('ALIQ_COFINS_QUANT').AsFloat > 0 then
          vTempAliqCOFINS := vItem.dataSet.FieldByName('ALIQ_COFINS_QUANT').AsFloat
        else if ((copy(vTempCSTCOFINS, 1, 1) = '5') or (copy(vTempCSTCOFINS, 1, 1) = '6')) and (vTempAliqCOFINS = 0) then
          vTempAliqCOFINS := vDadosIni.vEmp.vAliqCOFINS;
//      end;
//        else
        if cfopDeDevolucaoSPED(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) then
        begin
          vTempCSTPIS := '99';
          vTempCSTCOFINS := '99';
        end;
        
        vTributadoPorQtde := (vItem.dataSet.FieldByName('ALIQ_PIS_QUANT').AsFloat > 0) or
          (vItem.dataSet.FieldByName('ALIQ_COFINS_QUANT').AsFloat > 0);
      end;

      if ConfAdicional <> '' then
      begin
        vTempCSTPIS       := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 3) <> '',
                                              vDadosIni.getValue(ConfAdicional, 3), vTempCSTPIS);
        vTempCSTCOFINS    := vTempCSTPIS;
        vTempNAT_REC      := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 4) <> '',
                                              vDadosIni.getValue(ConfAdicional, 4), vTempNAT_REC);
        vTributadoPorQtde := vTempCSTPIS = '03';
        if not vTributadoPorQtde then
        begin
          vTempAliqPIS    := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 5) <> '',
                                StrToFloatDef(vDadosIni.getValue(ConfAdicional, 5), vTempAliqPIS), vTempAliqPIS);
          vTempAliqCOFINS := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 6) <> '',
                                StrToFloatDef(vDadosIni.getValue(ConfAdicional, 6), vTempAliqCOFINS), vTempAliqCOFINS);
        end
        else
        begin
          vTempAliqPIS    := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 7) <> '',
                                StrToFloatDef(vDadosIni.getValue(ConfAdicional, 7), vTempAliqPIS), vTempAliqPIS);
          vTempAliqCOFINS := vDadosIni.IfThen(vDadosIni.getValue(ConfAdicional, 8) <> '',
                                StrToFloatDef(vDadosIni.getValue(ConfAdicional, 8), vTempAliqCOFINS), vTempAliqCOFINS);
        end;
      end;

      vItem.dataSet.FieldByName('aliq_pis_quant').AsFloat := 0;
      vItem.dataSet.FieldByName('aliq_cofins_quant').AsFloat := 0;
      vItem.dataSet.FieldByName('aliq_pis').AsFloat := 0;
      vItem.dataSet.FieldByName('aliq_cofins').AsFloat := 0;
      vItem.dataSet.FieldByName('base_pis').AsFloat := 0;
      vItem.dataSet.FieldByName('base_cofins').AsFloat := 0;
      vItem.dataSet.FieldByName('valor_pis').AsFloat := 0;
      vItem.dataSet.FieldByName('valor_cofins').AsFloat := 0;
      vItem.dataSet.FieldByName('quant_bc_pis').AsFloat := 0;
      vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat := 0;

//      if (vTempCSTPIS = '01') or (vTempCSTPIS = '02') or
//        (vTempCSTPIS = '50') or (vTempCSTPIS = '51') or
//        (vTempCSTPIS = '52') or (vTempCSTPIS = '53') or
//        (vTempCSTPIS = '54') or (vTempCSTPIS = '55') or
//        (vTempCSTPIS = '56') then
      if (vVeiculoUsado) then
        vItem.dataSet.FieldByName('base_pis').AsFloat := vLucroVeiculoUsado
      else
      if (not vTributadoPorQtde) and (vTempAliqPIS > 0) then
      begin
        StrMod := vDadosIni.StrZero(StrToIntDef(fstr('modelo_nf'), 0), 2);
        StrMod := IfThen(StrMod = '00', fstr('modelo_nf'), StrMod);
        StrMod := Format('%s_Modelo_%s', [IfThen(fequals('natureza_nf', 'E'), 'Entrada', 'Saida'), StrMod]);
        vItem.dataSet.FieldByName('base_pis').AsFloat :=
          vItem.ffloat('valor_total') +
          IfThen((ConfBC.ReadString(StrMod, 'Campo_Seguro'  , 'S') = 'S'), vItem.ffloat('rateio_seguro')) +
          IfThen((ConfBC.ReadString(StrMod, 'Campo_Outras'  , 'S') = 'S'), vItem.ffloat('rateio_outdesp')) -
          IfThen((ConfBC.ReadString(StrMod, 'Campo_Desconto', 'S') = 'S'), vItem.ffloat('rateio_desconto')) +
          IfThen((ConfBC.ReadString(StrMod, 'Campo_Frete'   , 'S') = 'S') and (fstr('frete_f_nfe') <> 'S'), vItem.ffloat('rateio_frete')) +
          IfThen((ConfBC.ReadString(StrMod, 'Campo_ValorIPI', IfThen(fequals('natureza_nf', 'E'), 'S')) = 'S'), vItem.ffloat('valor_ipi'));
          //Acima o valor default quando entrada é q o valor do ipi entre na base, e nao na saida
        {
        if fstr('tipo_nf') = 'D'  then
        begin
          vItem.dataSet.FieldByName('base_pis').AsFloat :=
            vItem.ffloat('valor_total') +
            IfThen((ConfBC.ReadString('Modelo_' + StrMod, 'Campo_Seguro'  , 'S') = 'S'), vItem.ffloat('rateio_seguro')) +
            IfThen((ConfBC.ReadString('Modelo_' + StrMod, 'Campo_Outras'  , 'S') = 'S'), vItem.ffloat('rateio_outdesp')) -
            IfThen((ConfBC.ReadString('Modelo_' + StrMod, 'Campo_Desconto', 'S') = 'S'), vItem.ffloat('rateio_desconto')) +
            IfThen((ConfBC.ReadString('Modelo_' + StrMod, 'Campo_ValorIPI', 'S') = 'S'), vItem.ffloat('valor_ipi')) +
            IfThen((ConfBC.ReadString('Modelo_' + StrMod, 'Campo_Frete'   , 'S') = 'S') and (fstr('frete_f_nfe') <> 'S'), vItem.ffloat('rateio_frete'));
        end
        else
        begin
          vItem.dataSet.FieldByName('base_pis').AsFloat :=
            (vItem.dataSet.FieldByName('valor_total').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat) -
            vItem.dataSet.FieldByName('rateio_desconto').AsFloat;
          if (dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S') then
            vItem.dataSet.FieldByName('base_pis').AsFloat :=
              vItem.dataSet.FieldByName('base_pis').AsFloat +
              vItem.dataSet.FieldByName('rateio_frete').AsFloat ;

          if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
            vItem.dataSet.FieldByName('base_pis').AsFloat :=
              vItem.dataSet.FieldByName('base_pis').AsFloat +
              vItem.dataSet.FieldByName('valor_ipi').AsFloat;// + vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
          /// De acordo a solução abaixo o ICMS ST não faz parte do crédito PIS e COFINS para Não cumulativo
          ///  SOLUÇÃO DE CONSULTA Nº -12, DE 22 DE FEVEREIRO DE 2012
          ///                 DOU de 24-02-2012
        end;
        }
        vItem.dataSet.FieldByName('base_pis').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('base_pis').AsFloat, 2);
      end
      else if (vTributadoPorQtde) then
      begin
        vItem.dataSet.FieldByName('quant_bc_pis').AsFloat      := vItem.dataSet.FieldByName('quantidade').AsFloat;
        vItem.dataSet.FieldByName('aliq_pis_quant').AsFloat    := vTempAliqPIS;
        vItem.dataSet.FieldByName('aliq_cofins_quant').AsFloat := vTempAliqCOFINS;
      end;
      vItem.dataSet.FieldByName('base_cofins').AsFloat         := vItem.dataSet.FieldByName('base_pis').AsFloat;
      vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat     := vItem.dataSet.FieldByName('quant_bc_pis').AsFloat;
      if CST_05_BaseZero and (vTempCSTPIS = '05') then
      begin
        vItem.dataSet.FieldByName('base_pis').AsFloat        := 0;
        vItem.dataSet.FieldByName('base_cofins').AsFloat     := 0;
        vItem.dataSet.FieldByName('quant_bc_pis').AsFloat    := 0;
        vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat := 0;
      end;

//      if (vTempCSTCOFINS = '01') or (vTempCSTCOFINS = '02') or
//        (vTempCSTCOFINS = '50') or (vTempCSTCOFINS = '51') or
//        (vTempCSTCOFINS = '52') or (vTempCSTCOFINS = '53') or
//        (vTempCSTCOFINS = '54') or (vTempCSTCOFINS = '55') or
//        (vTempCSTCOFINS = '56') then
      {
      if (vVeiculoUsado) then
        vItem.dataSet.FieldByName('base_cofins').AsFloat := vLucroVeiculoUsado
      else
      if (not vTributadoPorQtde) and (vTempAliqCOFINS > 0) then
      begin
        vItem.dataSet.FieldByName('base_cofins').AsFloat :=
          (vItem.dataSet.FieldByName('valor_total').AsFloat +
          vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
          vItem.dataSet.FieldByName('rateio_outdesp').AsFloat) -
          vItem.dataSet.FieldByName('rateio_desconto').AsFloat;
        if (dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S') then
          vItem.dataSet.FieldByName('base_cofins').AsFloat :=
            vItem.dataSet.FieldByName('base_cofins').AsFloat +
            vItem.dataSet.FieldByName('rateio_frete').AsFloat ;

        if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
          vItem.dataSet.FieldByName('base_cofins').AsFloat :=
            vItem.dataSet.FieldByName('base_cofins').AsFloat +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat;// + vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
        /// De acordo a solução abaixo o ICMS ST não faz parte do crédito PIS e COFINS para Não cumulativo
        ///  SOLUÇÃO DE CONSULTA Nº -12, DE 22 DE FEVEREIRO DE 2012
        ///                 DOU de 24-02-2012
        ///
        vItem.dataSet.FieldByName('base_cofins').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('base_cofins').AsFloat, 2);
      end
      else if (vTributadoPorQtde) then
      begin
        vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat :=
          vItem.dataSet.FieldByName('quantidade').AsFloat;
        vItem.dataSet.FieldByName('aliq_cofins_quant').AsFloat :=
          vTempAliqCOFINS;
      end;
      }
      if vTempAliqPIS > 0 then
      begin
        if (vTributadoPorQtde) then
        begin
          vItem.dataSet.FieldByName('valor_pis').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('quant_bc_pis').AsFloat * vTempAliqPIS, 2);
          vTempAliqPIS := 0;
        end
        else
          vItem.dataSet.FieldByName('valor_pis').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('base_pis').AsFloat * vTempAliqPIS / 100 , 2);
      end;

      if vTempAliqCOFINS > 0 then
      begin
        if (vTributadoPorQtde) then
        begin
          vItem.dataSet.FieldByName('valor_cofins').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat * vTempAliqCOFINS, 2);
          vTempAliqCOFINS := 0;
        end
        else
          vItem.dataSet.FieldByName('valor_cofins').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('base_cofins').AsFloat * vTempAliqCOFINS / 100 , 2);
      end;
      vItem.dataSet.FieldByName('aliq_pis').AsFloat := vTempAliqPIS;
      vItem.dataSet.FieldByName('aliq_cofins').AsFloat := vTempAliqCOFINS;
      vItem.dataSet.FieldByName('cst_pis').AsString := vTempCSTPIS;
      vItem.dataSet.FieldByName('cst_cofins').AsString := vTempCSTCOFINS;

      if vTempNAT_REC <> '' then
        vItem.dataSet.FieldByName('nat_rec').AsString := vTempNAT_REC
      else
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        buscas.close;
        buscas.SQL.Text := 'select nat_rec from produtos'+
          ' where grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and cst_pis = ' + QuotedStr(vItem.dataSet.FieldByName('CST_pis').AsString);
        buscas.Open;

        if Trim(buscas.FieldByName('nat_rec').AsString) = '' then
        begin
          buscas.close;
          buscas.SQL.Text := 'select nat_rec from nbm'+
            ' where cod_ncm = ' + QuotedStr(vItem.dataSet.FieldByName('ncm').AsString) +
            ' and cst_pis = ' + QuotedStr(vItem.dataSet.FieldByName('CST_pis').AsString);
          buscas.Open;
        end;

        if Trim(buscas.FieldByName('nat_rec').AsString) <> '' then
          vItem.dataSet.FieldByName('nat_rec').AsString :=
            buscas.FieldByName('nat_rec').AsString;
      end
      else
      begin
        if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
        begin
          buscas.Close;
          buscas.SQL.Text := 'select tp.nat_rec from tipo_servico tp ' +
            ' inner join tipo_servico_empresa te on te.cod_servico = tp.cod_servico and te.cod_empresa = ' + vDadosIni.codEmpresa +
            ' where tp.cod_servico = ' + IntToStr(vItem.dataSet.FieldByName('cod_servico').AsInteger) +
            ' and te.cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.Open;
          if Trim(buscas.FieldByName('nat_rec').AsString) <> '' then
            vItem.dataSet.FieldByName('nat_rec').AsString :=
              buscas.FieldByName('nat_rec').AsString
        end
        else
          vItem.dataSet.FieldByName('nat_rec').AsString := '';

        if Trim(vItem.dataSet.FieldByName('nat_rec').AsString) = '' then
        begin
          buscas.close;
          buscas.SQL.Text := 'select nat_rec from nbm'+
            ' where cod_ncm = ' + QuotedStr(vItem.dataSet.FieldByName('ncm').AsString) +
            ' and cst_pis = ' + QuotedStr(vItem.dataSet.FieldByName('CST_pis').AsString);
          buscas.Open;
          if Trim(buscas.FieldByName('nat_rec').AsString) <> '' then
            vItem.dataSet.FieldByName('nat_rec').AsString :=
              buscas.FieldByName('nat_rec').AsString
          else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'V') and
            (vItem.dataSet.FieldByName('CST_pis').AsString = '05') then
              vItem.dataSet.FieldByName('nat_rec').AsString := '404';
        end;
      end;

      if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
      begin
        vItem.dataSet.FieldByName('aliq_pis_quant').AsFloat := 0;
        vItem.dataSet.FieldByName('aliq_cofins_quant').AsFloat := 0;
        vItem.dataSet.FieldByName('aliq_pis').AsFloat := 0;
        vItem.dataSet.FieldByName('aliq_cofins').AsFloat := 0;
        vItem.dataSet.FieldByName('base_pis').AsFloat := 0;
        vItem.dataSet.FieldByName('base_cofins').AsFloat := 0;
        vItem.dataSet.FieldByName('valor_pis').AsFloat := 0;
        vItem.dataSet.FieldByName('valor_cofins').AsFloat := 0;
        vItem.dataSet.FieldByName('quant_bc_pis').AsFloat := 0;
        vItem.dataSet.FieldByName('quant_bc_cofins').AsFloat := 0;
        vItem.dataSet.FieldByName('cst_pis').AsString := '99';
        vItem.dataSet.FieldByName('cst_cofins').AsString := '99';
      end;

      vValorPISTotal := vValorPISTotal + IfThen(vItem.fdif('cst_pis', '05'), vItem.ffloat('valor_pis'));
      vValorCOFINSTotal := vValorCOFINSTotal + IfThen(vItem.fdif('cst_pis', '05'), vItem.ffloat('valor_cofins'));

      if vItem.dataSet.FieldByName('import_xml').AsString <> 'S' then
      begin
      vItem.dataSet.FieldByName('aliq_pis_st').AsFloat := 0;
      vItem.dataSet.FieldByName('aliq_cofins_st').AsFloat := 0;
      vItem.dataSet.FieldByName('base_pis_st').AsFloat := 0;
      vItem.dataSet.FieldByName('base_cofins_st').AsFloat := 0;
      vItem.dataSet.FieldByName('valor_pis_st').AsFloat := 0;
      vItem.dataSet.FieldByName('valor_cofins_st').AsFloat := 0;
      if (vItem.dataSet.FieldByName('cst_pis').AsString = '75') then
      begin
        if (copy(Trim(dataSet.FieldByName('TEM_PISCOFINS_ST').AsString),1,1) = '') then
        begin

          dataSet.FieldByName('TEM_PISCOFINS_ST').AsString := _LerConfiguracoesRegistroString('TEM_PISCOFINS_ST');

          if (copy(Trim(dataSet.FieldByName('TEM_PISCOFINS_ST').AsString),1,1) = '') then
            if Application.MessageBox(pchar('Nota Fiscal com substituição tributária de PIS e COFINS?'+sLineBreak+
              'Se sim certifique-se que o NCM correspontente possui as alíquotas de PIS e COFINS ST.'),'Confirmação', 32 + 4) =  IDYES then
              dataSet.FieldByName('TEM_PISCOFINS_ST').AsString := 'S'
            else
              dataSet.FieldByName('TEM_PISCOFINS_ST').AsString := 'N';
        end;
        if (copy(Trim(dataSet.FieldByName('TEM_PISCOFINS_ST').AsString),1,1) = 'S') then
        begin
          buscas.Close;
          buscas.SQL.Text := ' select' +
            ' ne.ALIQ_PIS_DIFERENCIADA,' +
            ' ne.ALIQ_COFINS_DIFERENCIADA' +
            ' from nbm ne where ne.cod_ncm = ' + QuotedStr(vItem.dataSet.FieldByName('ncm').AsString);
          buscas.Open;

          if (buscas.FieldByName('ALIQ_PIS_DIFERENCIADA').AsFloat > 0) and
            (buscas.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsFloat > 0) then
          begin
            vItem.dataSet.FieldByName('aliq_pis_st').AsFloat :=
              buscas.FieldByName('ALIQ_PIS_DIFERENCIADA').AsFloat;
            vItem.dataSet.FieldByName('aliq_cofins_st').AsFloat :=
              buscas.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsFloat;

            vItem.dataSet.FieldByName('base_pis_st').AsFloat :=
              (vItem.dataSet.FieldByName('valor_total').AsFloat +
              vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
              vItem.dataSet.FieldByName('rateio_outdesp').AsFloat) -
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat;
            if (dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S') then
              vItem.dataSet.FieldByName('base_pis_st').AsFloat :=
                vItem.dataSet.FieldByName('base_pis_st').AsFloat +
                vItem.dataSet.FieldByName('rateio_frete').AsFloat ;

            vItem.dataSet.FieldByName('base_pis_st').AsFloat := vDadosIni.StrToFloatFormat(
              vItem.dataSet.FieldByName('base_pis_st').AsFloat, 2);
            vItem.dataSet.FieldByName('base_cofins_st').AsFloat :=
              vItem.dataSet.FieldByName('base_pis_st').AsFloat;

            if CST_05_BaseZero and (vTempCSTPIS = '05') then
            begin
              vItem.dataSet.FieldByName('base_pis_st').AsFloat        := 0;
              vItem.dataSet.FieldByName('base_cofins_st').AsFloat     := 0;
            end;

            vItem.dataSet.FieldByName('valor_pis_st').AsFloat := vDadosIni.StrToFloatFormat(
              vItem.dataSet.FieldByName('base_pis_st').AsFloat * vItem.dataSet.FieldByName('aliq_pis_st').AsFloat / 100, 2);
            vItem.dataSet.FieldByName('valor_cofins_st').AsFloat := vDadosIni.StrToFloatFormat(
              vItem.dataSet.FieldByName('base_cofins_st').AsFloat * vItem.dataSet.FieldByName('aliq_cofins_st').AsFloat / 100, 2);
          end
          else
          begin
          end;
        end
        else
        begin
        end;
      end;
      end;
      vValorPISTotal_ST := vValorPISTotal_ST + vItem.dataSet.FieldByName('valor_pis_st').AsFloat;
      vValorCOFINSTotal_ST := vValorCOFINSTotal_ST + vItem.dataSet.FieldByName('valor_cofins_st').AsFloat;

      vItem.dataSet.Post;
      vItem.dataSet.Next;
    end;
    dataSet.FieldByName('CONF_PISCOFINS').AsString := 'C';
    dataSet.FieldByName('valor_pis').AsFloat := vValorPISTotal;
    dataSet.FieldByName('valor_cofins').AsFloat := vValorCOFINSTotal;
    dataSet.FieldByName('valor_pis_st').AsFloat := vValorPISTotal_ST;
    dataSet.FieldByName('valor_cofins_st').AsFloat := vValorCOFINSTotal_ST;

    Result := True;
  except
  on e:exception do
    begin
      Result := True;
      Application.MessageBox(pchar('O sistema não conseguiu fazer a definição do PIS/COFINS. Erro: '+e.Message),
        'Atenção',0+64);
      registraErro('procedure definirPISCOFINS Erro: ' + e.Message);
    end;
  end;
end;

constructor TNFCab.create;
var
  I: Integer;
  DescompactarArquivo: TDescompactarArquivo;
  handleDescomp: THandle;
  dFormat: string;

  procedure _verificaRegistroDelphi;
  var
    registro: TRegistry;
  begin
    try
      Registro := TRegistry.Create(KEY_ALL_ACCESS);
      try
        Registro.RootKey := HKEY_LOCAL_MACHINE;
        Registro.OpenKey('SOFTWARE\Borland\BDS\4.0', True);
        Registro.CloseKey;
      finally
        Registro.Free;
      end;
    except
    end;
  end;

begin
  inherited Create;
  TableName := 'NOTAFISCAL';
  if dtmNF = nil then
    dtmNF := TdtmNF.Create(dtmNF);
  if dtmSpedNf = nil then
    dtmSpedNf := TdtmSpedNf.Create(dtmSpedNf);

  dataSet             := TClientDataSet(DtmNF.cdsNf);
  dataSet.Tag         := 0;
  dataSet.CommandText := 'select * from notafiscal where cod_nf = 0 and cod_empresa = 0 and cod_nf = 0';

  SQLMaker.Build('NOTAFISCAL',
     '', // alias
