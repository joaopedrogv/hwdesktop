function TNFItem.salvaItemAlteracaoSintegra(nota: TNFCab): boolean;
var
  natureza: string;
  cfop: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if Trim(dataSet.FieldByName('REFERENCIA').AsString) = '' then
      raise exception.create('Unidade de Medida do Item não informada');
    if Trim(dataSet.FieldByName('CODIGO_NOP').AsString) = '' then
      raise exception.create('CFOP do Item não informado');
    if Trim(dataSet.FieldByName('cst').AsString) = '' then
      raise exception.create('CST do Item não informado');

    natureza := nota.campo_natureza_nf;
    try
      cfop := IntToStr(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
    except
      raise exception.create('CFOP inválido');
    end;
    if natureza = 'S' then
    begin
      if (cfop[1] <> '5') and (cfop[1] <> '6') and (cfop[1] <> '7') then
        raise exception.create('CFOP de saída deve iniciar em 5, 6 ou 7');
      if (vDadosIni.vEmp.vSiglaUF <> nota.getUFdaOperacao) and
        (cfop[1] = '5') then
        raise exception.create('CFOP de saída para fora do estado não deve iniciar em 5')
      else if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) and
        (cfop[1] = '6') then
        raise exception.create('CFOP de saída para dentro do estado não deve iniciar em 6')
    end
    else
    begin
      if (cfop[1] <> '1') and (cfop[1] <> '2') and (cfop[1] <> '3') then
        raise exception.create('CFOP de entrada deve iniciar em 1, 2 ou 3');
      if (vDadosIni.vEmp.vSiglaUF <> nota.getUFdaOperacao) and
        (cfop[1] = '1') then
        raise exception.create('CFOP de entrada de fora do estado não deve iniciar em 1')
      else if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) and
        (cfop[1] = '2') then
        raise exception.create('CFOP de entrada para dentro do estado não deve iniciar em 2');
    end;
    if not existeCFOP(dataSet.FieldByName('codigo_nop').AsFloat) then
      raise exception.create('CFOP não encontrado no cadastro: ' + fstr('codigo_nop'));

    if not TestarCST(dataSet.FieldByName('cst').AsString) then
      Exit;

    if dataSet.FieldByName('antec_trib').AsString = 'S' then
    begin
      dataSet.FieldByName('base_icmsub_ant').AsFloat := dataSet.FieldByName('base_icmsub').AsFloat / dataSet.FieldByName('quantidade').AsFloat;
      dataSet.FieldByName('valor_icmsub_ant').AsFloat := dataSet.FieldByName('valor_icmsub').AsFloat / dataSet.FieldByName('quantidade').AsFloat;
    end
    else
    begin
      dataSet.FieldByName('base_icmsub_ant').AsFloat := 0;
      dataSet.FieldByName('valor_icmsub_ant').AsFloat := 0;
    end;
    fdata('cst_cofins').Put(ffloat('cst_pis'));

    fdata('base_icm').Put(ffloat('base_icm'));
    fdata('aliq_icm').Put(ffloat('aliq_icm'));
    fdata('valor_icm').Put(ffloat('valor_icm'));
    fdata('base_icmsub').Put(ffloat('base_icmsub'));
    fdata('aliq_icmsub').Put(ffloat('aliq_icmsub'));
    fdata('valor_icmsub').Put(ffloat('valor_icmsub'));
    fdata('base_ipi').Put(ffloat('base_ipi'));
    fdata('aliq_ipi').Put(ffloat('aliq_ipi'));
    fdata('valor_ipi').Put(ffloat('valor_ipi'));
    fdata('base_pis').Put(ffloat('base_pis'));
    fdata('aliq_pis').Put(ffloat('aliq_pis'));
    fdata('valor_pis').Put(ffloat('valor_pis'));
    fdata('quant_bc_pis').Put(ffloat('quant_bc_pis'));
    fdata('aliq_pis_quant').Put(ffloat('aliq_pis_quant'));
    fdata('base_cofins').Put(ffloat('base_cofins'));
    fdata('aliq_cofins').Put(ffloat('aliq_cofins'));
    fdata('valor_cofins').Put(ffloat('valor_cofins'));
    fdata('quant_bc_cofins').Put(ffloat('quant_bc_cofins'));
    fdata('aliq_cofins_quant').Put(ffloat('aliq_cofins_quant'));
    fdata('vicmdeson').Put(ffloat('vicmdeson'));
    fdata('vpisdeson').Put(ffloat('vpisdeson'));
    fdata('vcofinsdeson').Put(ffloat('vcofinsdeson'));
    fdata('rateio_desconto').Put(ffloat('rateio_desconto'));
    fdata('rateio_seguro').Put(ffloat('rateio_seguro'));
    fdata('rateio_outdesp').Put(ffloat('rateio_outdesp'));
    fdata('rateio_frete').Put(ffloat('rateio_frete'));
    fdata('vlisento').Put(ffloat('vlisento'));
    fdata('vln_trib').Put(ffloat('vln_trib'));
    fdata('vloutras').Put(ffloat('vloutras'));


    dataSet.post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;
    result := true;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFItem.salvaMargemObtida: boolean;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;
  if dataSet.FieldByName('tipo_item').AsString <> 'P' then
    Exit;

  if FMarkUpV < FMarkUpEsperadoV then
  begin
    Application.MessageBox('Markup obtido menor que o Markup esperado - Varejo', 'Atenção', 64);
    if not vDadosIni.PesqPros('NF0152', 'VALIDAR', 'OBTIDO: ' + FloatToStr(FMarkUpV) + ' ESPERADO: ' + FloatToStr(FMarkUpEsperadoV), 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
      Exit
    else if Application.MessageBox('Deseja continuar mesmo assim?', 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
      Exit;
    vDadosIni.GravaAuditoria('NF0152', 'VALIDAR', 'SALVAR MARKUP MENOR QUE O ESPERADO', 'NOTAFISCAL', dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas);
  end;

  if FMarkUpA < FMarkUpEsperadoA then
  begin
    Application.MessageBox('Markup obtido menor que o Markup esperado - Atacado', 'Atenção', 64);
    if not vDadosIni.PesqPros('NF0153', 'VALIDAR', 'OBTIDO: ' + FloatToStr(FMarkUpA) + ' ESPERADO: ' + FloatToStr(FMarkUpEsperadoA), 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
      Exit
    else if Application.MessageBox('Deseja continuar mesmo assim?', 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
      Exit;
    vDadosIni.GravaAuditoria('NF0153', 'VALIDAR', 'SALVAR MARKUP MENOR QUE O ESPERADO', 'NOTAFISCAL', dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas);
  end;

  dataSet.Edit;
  dataSet.FieldByName('PRCTB_ITEM').AsFloat := FMarkUpV;
  dataSet.FieldByName('PRCTB_ITEMA').AsFloat := FMarkUpA;
  dataSet.FieldByName('PRCTB_ITEM3').AsFloat := FMarkUp3;
  dataSet.FieldByName('PRCTB_ITEM6').AsFloat := FMarkUp6;
  dataSet.FieldByName('PRCTB_ITEM9').AsFloat := FMarkUp9;

  dataSet.FieldByName('prec_vnd_prod').AsFloat := FPrecoV;
  dataSet.FieldByName('prec_vnd_proda').AsFloat := FPrecoA;
  dataSet.FieldByName('PREC_30_PROD').AsFloat := FPreco30;
  dataSet.FieldByName('PREC_60_PROD').AsFloat := FPreco60;
  dataSet.FieldByName('PREC_90_PROD').AsFloat := FPreco90;

  HandleMarkupMargemCalculados;

  dataSet.Post;
  //  Result := Apply;
  if not NextMargem then
    Application.MessageBox('Fim do cálculo', 'Atenção', mb_ok + MB_ICONINFORMATION);
  result:=true;
end;

procedure TNFItem.marcaItem(AOperacao: C_OperacaoMarcacao);
var
  ARecNo: Integer;
  AValue: string;
begin
  if dataSet.IsEmpty then
    Exit;
  if not dataSet.Active then
    Exit;
  ARecNo := dataSet.RecNo;
  dataset.DisableControls;
  try
    if AOperacao = opmIndividual then
    begin
      AValue := Trim(dataset.FieldByName('sel').AsString);
      dataSet.Edit;
      dataset.FieldByName('sel').AsString := vDadosIni.IfThen(AValue = 'S', '', 'S');
      dataSet.Post;
    end
    else
    begin
      dataSet.First;
      while not dataSet.Eof do
      begin
        AValue := Trim(dataset.FieldByName('sel').AsString);
        dataSet.Edit;
        case AOperacao of
          opmTodos   : dataset.FieldByName('sel').AsString := 'S';
          opmNenhum  : dataset.FieldByName('sel').AsString := '';
          opmInversao: dataset.FieldByName('sel').AsString := vDadosIni.IfThen(AValue = 'S', '', 'S');
        end;

        dataSet.Post;
        dataSet.Next;
      end;
    end;
  finally
    dataSet.RecNo := ARecNo;
    dataSet.EnableControls;
  end;
end;

procedure TNFItem.marcaItemParaGrade;
var
  vGr: Integer;
  vCod: string;
  vPointer: Pointer;


begin
  if dataset.FieldByName('tipo_item').AsString <> 'P' then
    exit;

  vGr:= dataset.FieldByName('grupo_prod').AsInteger;
  vCod:= dataset.FieldByName('cod_prod').AsString;

  vPointer:= dataSet.GetBookmark;

  dataSet.First;
  while not dataSet.Eof do
  begin
    if (dataset.FieldByName('tipo_item').AsString = 'P') and
      (vGr = dataset.FieldByName('grupo_prod').AsInteger) and
      (Trim(vCod) = Trim(dataset.FieldByName('cod_prod').AsString)) then
    begin

      dataSet.Edit;
      if dataset.FieldByName('selg').AsString = 'S' then
        dataset.FieldByName('selg').AsString := ''
      else
        dataset.FieldByName('selg').AsString := 'S';
      dataSet.Post;
    end;

    dataSet.Next;    
  end;

  dataSet.GotoBookmark(vPointer);
end;

function TNFItem.selecionaItens(codNF: integer): boolean;
begin
  FSemCodigo := False;
  Result := montaSelect('select * from notafiscal_item where cod_nf = ' + IntToStr(codNF) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);
  IndexFieldNames := 'NITEM';
  if dataSet.FieldByName('tipo_item').AsString = 'V' then
    vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger);
  if (dataSet.FieldByName('tipo_item').AsString = 'P') then//and (Trim(vDadosIni.vEmp.vCredencInterventor) <> '') then
    vDetEcf.selecionaDetalhesECF(dataSet.FieldByName('cod_nf').AsInteger);

  if (dataSet.FieldByName('tipo_item').AsString = 'P') then//and (Trim(vDadosIni.vEmp.vCredencInterventor) <> '') then
  begin
    FUndsVnds.Clear;
    FUndsVnds.CopyFrom(TUnidadeVenda_Model,
      queryCons.Table('notafiscal_item nfi', 'ps.*')
        .Join('vw_produtos_conversao ps', 'ps.grupo_prod = nfi.grupo_prod and ps.cod_prod = nfi.cod_prod and ps.cod_empresa = nfi.cod_empresa')
           .Equals('nfi.cod_nf', codNF)
           .Equals('nfi.cod_empresa', vDadosIni.cod_empresa)
           .Open().query);
  end;

  FTributos.Load( codNF, vDadosIni.cod_empresa );
end;

procedure TNFItem.setDadosDataSetTemp(pCodDevolucao: Integer);
var
  tmpDataSet: TClientDataSet;
  I: Integer;
  list: TStrings;
begin
  try
    dataSet := TClientDataSet(DtmNF.cdsINf);
    tmpDataSet := TClientDataSet(DtmNF.cdsTempINf);

    if tmpDataSet.Tag  <> 22 then
      try
        tmpDataSet.CreateDataSet;
        tmpDataSet.Tag := 22;
      except
      end;

    {$REGION 'Ajustando campo de cfop pra depois setar os valores'}
    list := flist('codigo_nop', True);
    try
      for I := 0 to List.Count - 1 do
      begin
        dataSet.Filter := 'codigo_nop = ' + list[I];
        dataSet.Filtered := True;

        dataSet.First;
        while not dataSet.Eof do
        begin
          vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));

          dataSet.Edit;
          if vCfopIt.fdif('ALT_EST', 'N') and (pCodDevolucao = 0) then
            dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString := IfThen(vCfopIt.fequals('tipv_veiculo', 'A'), 'N', 'S')
          else
            dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString := 'N';

          if vCfopIt.fdif('calc_custo', 'N') and fdif('altera_estoque_cfop', 'N') then
            dataSet.FieldByName('altera_custo_cfop').AsString := 'S'
          else
            dataSet.FieldByName('altera_custo_cfop').AsString := 'N';
          dataSet.FieldByName('tipv_veiculo').AsString := vCfopIt.fstr('tipv_veiculo');

          dataSet.Post;
          dataSet.Next;
        end;   
      end;
    finally
      list.Free();
    end;
    {$ENDREGION}

    tmpDataSet.First;
    while not tmpDataSet.Eof do
    begin
      if tmpDataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        dataSet.Filter := 'grupo_prod = ' +IntToStr(tmpDataSet.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(tmpDataSet.FieldByName('cod_prod').AsString) +
          ' and altera_custo_cfop = ''S'' ';
          //' and codigo_nop = ' + IntToStr(tmpDataSet.FieldByName('codigo_nop').AsInteger);
        dataSet.Filtered := True;

        dataSet.First;
        while not dataSet.Eof do
        begin
          { Comentei para calcular alterar corretamente o estoque
            1) CalcularCustoDosProdutos é chamado, indtot = 0 fica com custo zerado
            2) montaDataSetTemp Agrupa os valores por produto/alteraestoque
            3) setDadosDataSetTemp apenas agrupa por produto/altera_custo_cfop e obtendo os valores de montaDataSetTemp

          if dataSet.FieldByName('indtot').Value = 0 then
          begin
            dataSet.Next;
            Continue;
          end;
          }

          dataSet.Edit;

          dataSet.FieldByName('PREC_VND_PROD').AsFloat := tmpDataSet.FieldByName('PREC_VND_PROD').AsFloat;
          dataSet.FieldByName('PREC_VND_PRODA').AsFloat := tmpDataSet.FieldByName('PREC_VND_PRODA').AsFloat;
          dataSet.FieldByName('PREC_30_PROD').Value := tmpDataSet.FieldByName('PREC_30_PROD').Value;
          dataSet.FieldByName('PREC_60_PROD').Value := tmpDataSet.FieldByName('PREC_60_PROD').Value;
          dataSet.FieldByName('PREC_90_PROD').Value := tmpDataSet.FieldByName('PREC_90_PROD').Value;

          dataSet.FieldByName('PREC_CUS_CNT').AsFloat := tmpDataSet.FieldByName('PREC_CUS_CNT').AsFloat;
          dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := tmpDataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
          dataSet.FieldByName('PREC_CUS_R').AsFloat := tmpDataSet.FieldByName('PREC_CUS_R').AsFloat;
          dataSet.FieldByName('PRCTB_ITEM').AsFloat := tmpDataSet.FieldByName('PRCTB_ITEM').AsFloat;
          dataSet.FieldByName('PRCTB_ITEMA').AsFloat := tmpDataSet.FieldByName('PRCTB_ITEMA').AsFloat;
          dataSet.FieldByName('PRCTB_ITEM3').AsFloat := tmpDataSet.FieldByName('PRCTB_ITEM3').AsFloat;
          dataSet.FieldByName('PRCTB_ITEM6').AsFloat := tmpDataSet.FieldByName('PRCTB_ITEM6').AsFloat;
          dataSet.FieldByName('PRCTB_ITEM9').AsFloat := tmpDataSet.FieldByName('PRCTB_ITEM9').AsFloat;
//          dataSet.FieldByName('PMARGFIM').AsFloat := tmpDataSet.FieldByName('PMARGFIM').AsFloat;
//          dataSet.FieldByName('PMARGFIM_A').AsFloat := tmpDataSet.FieldByName('PMARGFIM_A').AsFloat;

          dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := tmpDataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
          dataSet.FieldByName('PR_CUSC_PROD').AsFloat := tmpDataSet.FieldByName('PR_CUSC_PROD').AsFloat;
          if dataSet.FieldByName('VALOR_ICMSUB_ANT').AsFloat > 0 then
          begin
            dataSet.FieldByName('VALOR_ICMSUB_ANT').AsFloat := tmpDataSet.FieldByName('VALOR_ICMSUB_ANT').AsFloat;
            dataSet.FieldByName('BASE_ICMSUB_ANT').AsFloat := tmpDataSet.FieldByName('BASE_ICMSUB_ANT').AsFloat;
          end;
          {
          vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
          if (Trim(vCfopIt.dataSet.FieldByName('ALT_EST').AsString) <> 'N') and
            (pCodDevolucao = 0) then
            dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString := vDadosIni.retornoPorCondicao(
              vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', 'S')
          else
            dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString := 'N';

          if (Trim(vCfopIt.dataSet.FieldByName('calc_custo').AsString) <> 'N') and
            (dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N') then
            dataSet.FieldByName('altera_custo_cfop').AsString := 'S'
          else
            dataSet.FieldByName('altera_custo_cfop').AsString := 'N';
          dataSet.FieldByName('tipv_veiculo').AsString := vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString;
          }
//          dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString := tmpDataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString;
//          dataSet.FieldByName('ALTERA_CUSTO_CFOP').AsString := tmpDataSet.FieldByName('ALTERA_CUSTO_CFOP').AsString;

          dataSet.Post;
          dataSet.Next;
        end;

      end;
      tmpDataSet.Next;
    end;

    dataSet.Filtered := False;

  finally
    dataSet.Filter := '';
    dataSet.Filtered := False;
    dataSet := TClientDataSet(DtmNF.cdsINf);
  end;
end;

function TNFItem.setDadosIntemNF(): boolean;
begin
  try
    if not (dataSet.State in [dsInsert, dsEdit]) then
