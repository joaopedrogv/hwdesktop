end;

function TNFCab.getCSOSNPorCST(ACST, ACSOSN: string;
  AValidarPermissaoCredito: Boolean): string;
var
  CSOSN, AOrigem: string;
  I: Integer;
begin
  if Length(ACST) = 3 then
  begin
    AOrigem := Copy(ACST, 1, 1);
    ACST    := Copy(ACST, 2, 2);
  end
  else if Length(ACST) = 2 then
    AOrigem := '0'
  else
  begin
    ACST := '';
    AOrigem := '0';
  end;

  if FListRelCSOSNCST = nil then
  begin
    FListRelCSOSNCST := TStringList.Create;
    FListRelCSOSNCST.Text := FConfig.Conf_ICMS.prod_cad_relacao_cst_csosn.Text;// vDadosIni.getConfSisBlob('prod_cad_relacao_cst_csosn', buscas);
  end;

  CSOSN := '';  
  for I := 0 to FListRelCSOSNCST.Count - 1 do
  begin
    if ACST = vDadosIni.getValue(FListRelCSOSNCST[i], 1) then //por padrao vai utilizar o primeiro csosn que encontrar
      CSOSN := Copy( FListRelCSOSNCST[i], 4, Length(FListRelCSOSNCST[i]));
    if CSOSN <> '' then
    begin
      if (Trim(ACSOSN) <> '') and (Pos('|' + ACSOSN + '|',  CSOSN) > 0) then
        CSOSN := ACSOSN
      else
        CSOSN := vDadosIni.getValue(CSOSN, 1);
      Break;
    end;
  end;

  if CSOSN = '' then // caso nao tenha configuracao o padrao é este abaixo
    Result := getCsosn(AOrigem + ACST, AValidarPermissaoCredito)
  else if (AValidarPermissaoCredito) and (not vClFor.clienteFornecedorContrinuinte) then   // Não vai mais ajustar quando contribuinte, pois a contabilidade da Bellanona é muito chata, a conf global prod_cad_relacao_cst_csosn é a regra que vai prevalecer
    Result := AjustaCSOSN(CSOSN, False)
  else
    Result := CSOSN;
end;

