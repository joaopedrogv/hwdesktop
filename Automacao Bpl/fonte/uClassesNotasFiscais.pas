  //NACIONAL, NOS TERMOS DO § 1º DO ART. 20 DA LC 123/2006";
  //"NÃO GERA DIREITO A CRÉDITO FISCAL DE IPI
end;

procedure TNFCab.verificaMudancaCfopCstEmTela(AVerificarMudanca: Boolean);
var
  ASomenteSelecionados, AAlterar, ASetCFOP, ASetOrigem, ASetCST, ASetAliqICMS: Boolean;
  ACFOP: Integer;
  ACST, ACSOSN, AOrigCST: string;
  AAliqCIMS: Double;
begin
  if not (dataSet.State in [dsEdit, dsInsert]) then
    Exit;

//  if not vDadosIni.abreForm('Alteração de dados dos itens', frmCadNF.pnMudancaCfopCST, [ofAutoSize, ofEscapeExit]) then
//    Exit;

  ASomenteSelecionados := frmCadNF.ckMudSelecionados.Checked;

  ASetCFOP     := frmCadNF.ckMudCFOP.Checked;
  ASetOrigem   := frmCadNF.ckMudOrigem.Checked;
  ASetCST      := frmCadNF.ckMudCST.Checked;
  ASetAliqICMS := frmCadNF.ckMudAliqICMS.Checked;

  ACFOP := frmCadNF.edMudCFOP.AsInteger;
  AOrigCST := frmCadNF.edMudOrigCST.AsString;
  ACSOSN := frmCadNF.edMudCSOSN.AsString;
  ACST := frmCadNF.edMudCST.AsString;
  AAliqCIMS := frmCadNF.edMudAliqICMS.AsValue;

  if not AVerificarMudanca then
  begin
    if not (ASetCFOP or ASetCST or ASetAliqICMS) then
      Exit;

    AAlterar := False;
    dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'N';
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (not ASomenteSelecionados) then
        AAlterar := True
      else
        AAlterar := vItem.dataSet.FieldByName('sel').AsString = 'S';
      if AAlterar then
      begin
        ACFOP     := vDadosIni.IfThen(ASetCFOP    , ACFOP    , Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat));
        AOrigCST  := vDadosIni.IfThen(ASetOrigem  , AOrigCST , Copy(vItem.dataSet.FieldByName('cst').AsString, 1, 1));
        ACST      := vDadosIni.IfThen(ASetCST     , ACST     , Copy(vItem.dataSet.FieldByName('cst').AsString, 2, 2));
        ACSOSN    := vDadosIni.IfThen(ASetCST     , ACSOSN   , vItem.dataSet.FieldByName('csosn').AsString);
        AAliqCIMS := vDadosIni.IfThen(ASetAliqICMS, AAliqCIMS, vItem.dataSet.FieldByName('aliq_icm').AsFloat);

        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('codigo_nop').AsString := getCfopCorreto(IntToStr(ACFOP));
        vItem.dataSet.FieldByName('cst').AsString := AOrigCST + ACST;
        if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
          vItem.dataSet.FieldByName('csosn').AsString := ACSOSN
        else
          vItem.dataSet.FieldByName('csosn').AsString := '';
        vItem.dataSet.FieldByName('aliq_icm').AsFloat := AAliqCIMS;
        vItem.dataSet.Post;
      end;
      vItem.dataSet.Next;
    end;
  end
  else
  begin
    dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'S';
    somaTotaisNF(True);
    {
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
        vItem.vProd.buscaProduto(
          vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString);
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('codigo_nop').AsString := getCfopCorreto(vItem.vProd.dataSet.FieldByName('codigo_nop').AsString);
        vItem.dataSet.FieldByName('cst').AsString := vItem.vProd.dataSet.FieldByName('cst_prod').AsString;
        vItem.dataSet.FieldByName('csosn').AsString := getCSOSNPorCST(vItem.dataSet.FieldByName('cst').AsString, vItem.dataSet.FieldByName('csosn').AsString, False);
        vItem.dataSet.FieldByName('aliq_icm').AsFloat := vItem.vProd.dataSet.FieldByName('icm_prod').AsFloat;
        vItem.dataSet.Post;
      end;
      vItem.dataSet.Next;
    end;
    }
  end;
end;

procedure TNFCab.verificaMudancaCFOP(TestarCSTTambem: Boolean);
var
  CST: string;
begin
  if not Assigned(vItem) then
    Exit;

  if not Assigned(vItem.dataSet) then
    Exit;

  if (vDadosIni.GetIni('Automacao', 'VerificarMudacaoCstNF', 'N') <> 'S') or
    (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) = 'S') then
    TestarCSTTambem := False;
  if (TestarCSTTambem) then
    if vDadosIni.vEmp.vRegime = 'SIMPLES' then
    begin
      if InputQuery('CST', 'Informe o CSOSN', CST) then
      begin
        if not vItem.TestarCSOSN(CST, '') then
          TestarCSTTambem := False;
      end
      else
        TestarCSTTambem := False;
    end
    else
    begin
      if InputQuery('CST', 'Informe o CST', CST) then
      begin
        if not vItem.TestarCST(CST) then
          TestarCSTTambem := False;
      end
      else
        TestarCSTTambem := False;
    end;


  if (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) <> 'S') then
  begin
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vItem.dataSet.Edit;
      vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
        dataSet.FieldByName('codigo_nop').AsFloat;
      if (TestarCSTTambem) and (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
        if vDadosIni.vEmp.vRegime = 'SIMPLES' then
        begin
          vItem.dataSet.FieldByName('csosn').AsString := CST;
          vItem.dataSet.FieldByName('cst').AsString := getCSTPorCSOSN(vItem.dataSet.FieldByName('cst').AsString, CST);
        end
        else
        begin
          vItem.dataSet.FieldByName('cst').AsString := CST;
          vItem.dataSet.FieldByName('csosn').AsString := '';
        end;
      vItem.dataSet.Post;
      vItem.dataSet.Next;
    end;
  end
  else
  begin
    if (vDadosIni.GetIni('Automacao', 'VerificarMudacaoCstNF', 'N') = 'S') then
    begin
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
        begin
          vItem.vProd.buscaProduto(
            vItem.dataSet.FieldByName('grupo_prod').AsInteger,
            vItem.dataSet.FieldByName('cod_prod').AsString);
          vItem.dataSet.Edit;
          vItem.dataSet.FieldByName('cst').AsString := vItem.vProd.dataSet.FieldByName('cst_prod').AsString;
          vItem.dataSet.FieldByName('csosn').AsString := getCSOSNPorCST(vItem.dataSet.FieldByName('cst').AsString, vItem.dataSet.FieldByName('csosn').AsString, False);
          vItem.dataSet.Post;
        end;
        vItem.dataSet.Next;
      end;
    end;
    somaTotaisNF;
  end;
end;

