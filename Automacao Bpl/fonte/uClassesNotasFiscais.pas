function TNFCab.calcularValorItemDesconto: boolean;
begin
  try
    if notaFechada then
      exit;
    Result := true;
    //    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
    //      raise Exception.Create('Destinatário/Remetente não informado');
    //    if dataSet.FieldByName('codigo_nop').AsFloat = 0 then
    //      raise Exception.Create('Natureza de Operação da Nota Fiscal não informada');
//    if (dataSet.FieldByName('tipo_emissao').AsString <> '2') and
//      (dataSet.FieldByName('complementar_ent').AsString <> 'S') then
    if fstrin('tipo_emissao', ['1', '4']) then
    begin
      if vItem.vrDadosItem.quantidade <= 0 then
        raiseExceptionCreate('Quantidade deve ser informada.', campos[1]);
      //      if Trunc(vItem.vrDadosItem.quantidade) <> vItem.vrDadosItem.quantidade then
      //        vItem.vrDadosItem.quantidade := Trunc(vItem.vrDadosItem.quantidade);
      if (vItem.vrDadosItem.valor_unitario <= 0) and (vItem.vrDadosItem.tipo_item <> 'O') and
        (dataSet.FieldByName('natureza_nf').asstring = 'S') then
        raiseExceptionCreate('Valor Unitário deve ser informado.', campos[2]);
      if not validaCfop(vItem.vrDadosItem.codigo_nop) then
      begin
        vNomeCampoErro := campos[10];
        Result := False;
        exit;
      end;
    end;
    vItem.vrDadosItem.valor_total :=
      vDadosIni.StrToFloatFormat(vItem.vrDadosItem.quantidade * vItem.vrDadosItem.valor_unitario,
      2);
    if (vItem.vrDadosItem.tipo_ped = '') and (vItem.vrDadosItem.nped = 0) and (vItem.vrDadosItem.permitir_desconto = 'N') then
    begin
      vItem.vrDadosItem.perc_desconto := 0;
      vItem.vrDadosItem.rateio_desconto := 0;
      //      vItem.vrDadosItem.valor_desconto_perc := 0;
    end;
    if vItem.vrDadosItem.valor_total > 0 then    
      vItem.vrDadosItem.perc_desconto := vItem.vrDadosItem.rateio_desconto / vItem.vrDadosItem.valor_total * 100;
    if vItem.vrDadosItem.perc_desconto < 0 then
      vItem.vrDadosItem.perc_desconto := 0;
    if vItem.vrDadosItem.rateio_desconto > vItem.vrDadosItem.valor_total then
    begin
      vDadosIni.ShowErro('Valor do desconto %n não pode ser maior que o valor total %n',
                         [vItem.vrDadosItem.rateio_desconto, vItem.vrDadosItem.valor_total]);
      vItem.vrDadosItem.rateio_desconto := 0;
      vItem.vrDadosItem.perc_desconto   := 0;
    end;
    {
    if vItem.vrDadosItem.perc_desconto >= 100 then
      raiseExceptionCreate('Desconto maior que o permitido.', campos[3]);
    if vItem.vrDadosItem.perc_desconto < 0 then
      vItem.vrDadosItem.perc_desconto := 0;
    //      vItem.vrDadosItem.valor_desconto_perc := 0;
    if vItem.vrDadosItem.perc_desconto > 0 then
      //    vItem.vrDadosItem.valor_desconto_perc :=
      vItem.vrDadosItem.rateio_desconto :=
        StrToFloat(Format('%0.2f',
        [vItem.vrDadosItem.valor_total * vItem.vrDadosItem.perc_desconto / 100]))
    else if dataSet.FieldByName('tipo_desconto').AsString = 'I' then
      if vItem.vrDadosItem.perc_desconto = 0 then
        vItem.vrDadosItem.rateio_desconto := 0;
     }

  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

