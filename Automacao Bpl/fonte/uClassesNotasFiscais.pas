function TNotafiscal_item_dados.cst_icm_mono(sCST: string): Boolean;
var
  sTemp: string;
begin
  Result := False;
  sTemp := IfThen(sCST = '', Trim(Self.cst), sCST);
  if Length(sTemp) <> 3 then
    Exit;

  sTemp := Copy(sTemp, 2, 2);
  Result := MatchText(sTemp, ['02', '15', '53', '61']);
end;

