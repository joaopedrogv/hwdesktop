function TNFCab.removerItem: boolean;
var
  I: Integer;
  vRecalcularVlTotPedV: Boolean;
begin
  if f_int('id_ajuste') > 0 then
  begin
    vDadosIni.ShowAtencao('Nota fiscal de ajuste não pode excluir itens');
    Exit;
  end;

  if not vDadosIni.PesqPros('NF0058', 'EXCLUIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  if (not vItem.DataSet.Active) or (vItem.DataSet.RecordCount = 0) then
    exit;
  Result := False;
  if notaFechada then
  begin
    Application.MessageBox('Nota Fiscal já esta fechada. Nenhum item pode ser removido',
      'Atenção', MB_OK
      + MB_ICONINFORMATION);
    exit;
  end;
  if vItem.dataSet.FieldByName('nped').AsInteger > 0 then
  begin
    if not vDadosIni.PesqPros('NF0111', 'EXCLUIR', ' NUM NF ' + dataSet.FieldByName('NUM_NF').AsString + ' NITEM: '+vItem.dataSet.FieldByName('NITEM').AsString+
      vItem.dataSet.FieldByName('TIPO_PED').AsString+ ' NUM '+vItem.dataSet.FieldByName('NPED').AsString, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
      Exit;
    //    Application.MessageBox('Item da Nota Fiscal de Requisição ou Ordem de Serviço. O item não pode ser removido',
    //      'Atenção', MB_OK
    //      + MB_ICONINFORMATION);
    //    exit;
  end;

  if Application.MessageBox('Deseja mesmo remover o item da Nota Fiscal', 'Atenção', MB_YESNO
    + MB_ICONQUESTION) = ID_NO then
    Exit;

  if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
    (vItem.dataSet.FieldByName('cod_nf').AsInteger > 0) then
  begin

    vRecalcularVlTotPedV := False;

    if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select vl_desp_nf from pedvenda_prod pvp' +
        ' where pvp.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
        ' and pvp.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
        ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
        ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
        ' and pvp.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
        ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and not pvp.n_nf is null';
      buscas.Open;

      vRecalcularVlTotPedV := buscas.FieldByName('vl_desp_nf').AsFloat > 0;

      ExecutaComandosSqlExec('update pedvenda_prod pvp' +
        ' set pvp.n_nf = null, serie = null,' +
        ' rateio_acresc = coalesce(rateio_acresc, 0) - coalesce(vl_desp_nf, 0), vl_desp_nf = 0' +
        ' where pvp.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
        ' and pvp.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
        ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
        ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
        ' and pvp.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
        ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and not pvp.n_nf is null');
      if Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = 'REQ' then
        ExecutaComandosSqlExec(
          'update reqvenda_itens pvp' +
          ' set pvp.n_nf = null, serie = null' +
          ' where pvp.nreq = ' + vItem.dataSet.FieldByName('nped').AsString +
          ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
          ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
          ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvp.n_nf is null')
      else
        ExecutaComandosSqlExec(
          'update os_item_prod pvp' +
          ' set pvp.n_nf = null, serie = null' +
          ' where pvp.n_os = ' + vItem.dataSet.FieldByName('nped').AsString +
          ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
          ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
          ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvp.n_nf is null');
    end
    else if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select pvs.vl_desp_nf from pedvenda_serv pvs' +
        ' where pvs.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
        ' and pvs.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
        ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
        ' and pvs.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
        ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and not pvs.n_nf is null';
      buscas.Open;

      vRecalcularVlTotPedV := buscas.FieldByName('vl_desp_nf').AsFloat > 0;

      ExecutaComandosSqlExec(
        'update pedvenda_serv pvs' +
        ' set pvs.n_nf = null, serie = null' +
        ' where pvs.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
        ' and pvs.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
        ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
        ' and pvs.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
        ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and not pvs.n_nf is null');
      ExecutaComandosSqlExec(
        'update os_item_serv pvs' +
        ' set pvs.n_nf = null, serie = null' +
        ' where pvs.n_os = ' + vItem.dataSet.FieldByName('nped').AsString +
        ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
        ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and not pvs.n_nf is null');
    end;

    if vRecalcularVlTotPedV then
      if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
        (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) <> '') then
        if not atualizaValorTotalPedVenda(
          Trim(vItem.dataSet.FieldByName('tipo_ped').AsString),
          vItem.dataSet.FieldByName('nped').AsInteger, [opvAtualizarTotal]) then
        begin
          Result := False;
          Exit;
        end;
  end;
  if (dataSet.State in [dsedit, dsInsert]) then
  begin
    if (vItem.vrDadosItem.peso_b > 0) then
      dataSet.FieldByName('peso_b').AsFloat := dataSet.FieldByName('peso_b').AsFloat -
        (vItem.vrDadosItem.peso_b * vItem.vrDadosItem.quantidade);
    if (vItem.vrDadosItem.peso_l > 0) then
      dataSet.FieldByName('peso_l').AsFloat := dataSet.FieldByName('peso_l').AsFloat -
        (vItem.vrDadosItem.peso_l * vItem.vrDadosItem.quantidade);
    if (dataSet.FieldByName('peso_b').AsFloat < 0) then
      dataSet.FieldByName('peso_b').AsFloat := 0;
    if (dataSet.FieldByName('peso_l').AsFloat < 0) then
      dataSet.FieldByName('peso_l').AsFloat := 0;
  end;

  if vItem.Delete then
  begin
    I := 1;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vItem.dataSet.Edit;
      vItem.dataSet.FieldByName('nitem').AsInteger := i;
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'D' then
        vItem.dataSet.FieldByName('num_fab_prod').AsString :=
          vDadosIni.StrZero(dataSet.FieldByName('cod_nf').AsInteger, 7) +
          vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3);
      vItem.dataSet.Post;
      vItem.dataSet.Next;
      Inc(i);
    end;
    vItem.vrDadosItem.nItem := vItem.dataSet.RecordCount + 1;
    somaTotaisNF;
    vItem.cancelar;
  end;
end;

function TNFCab.removerItemsSelecionados: boolean;
var
  I: Integer;
  vRecalcularVlTotPedV, testarProcesso: Boolean;
  itensAudit: THw_auditoria_classList;
begin
  Result := False;

  if f_int('id_ajuste') > 0 then
  begin
    vDadosIni.ShowAtencao('Nota fiscal de ajuste não pode excluir itens');
    Exit;
  end;

  if (not vItem.DataSet.Active) or (vItem.DataSet.RecordCount = 0) then
    exit;

  if notaFechada then
  begin
    Application.MessageBox('Nota Fiscal já esta fechada. Nenhum item pode ser removido',
      'Atenção', MB_OK
      + MB_ICONINFORMATION);
    exit;
  end;

  itensAudit := THw_auditoria_classList.create;
  try

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin

      with itensAudit.New do
      begin
        cod_processo := 'NF0058';
        acao         := 'EXCLUIR';
        mensagem     := Format('NUM NF %d NITEM: %d', [fint('num_nf'), vItem.fint('nitem')]);
        tabela       := 'NOTAFISCAL';
        codigo       := fstr('cod_nf');
        gravar       := True;
      end;

      if vItem.dataSet.FieldByName('nped').AsInteger > 0 then
      begin

        with itensAudit.New do
        begin
          cod_processo := 'NF0111';
          acao         := 'EXCLUIR';
          mensagem     := Format('NUM NF %d NITEM: %d  %s NUM %d', [fint('num_nf'), vItem.fint('nitem'), vItem.fstr('tipo_ped'), vItem.fint('nped')]);
          tabela       := 'NOTAFISCAL';
          codigo       := fstr('cod_nf');
          gravar       := True;
        end;

      end;

      vItem.dataSet.Next;
    end;

    if not vDadosIni.PesqPros(itensAudit, buscas) then
      Exit;

  finally
    itensAudit.Free;
  end;

  if ShowConfirmacao('Deseja mesmo excluir todos os registros selecionados?') <> IDYES then
    Exit;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin

    if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
      (vItem.dataSet.FieldByName('cod_nf').AsInteger > 0) then
    begin

      vRecalcularVlTotPedV := False;

