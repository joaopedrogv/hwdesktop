function TNFCab.absorverValorICMSST: boolean;
{
var
  vBaseSTDistrib, //Base ja ST distribuida onde não poderara alterar
  vBaseST, // Base ST a distribuir
  vValorSTDistrib: Real;
  vTemp: string;
  }
begin
  {
  if notaFechada then
    exit;
  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    exit;
  if dataSet.FieldByName('valor_icmsub').AsFloat > 0 then
  begin
    vBaseST := 0;
    vBaseSTDistrib := 0;
    vValorSTDistrib := 0;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      vTemp := copy(vItem.dataSet.FieldByName('cst').AsString, 2, 2);
      if ((vTemp = '10') or (vTemp = '30') or (vTemp = '70')) and
        (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
//        if (vItem.dataSet.FieldByName('mva').AsFloat = 0) and
//          (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat = 0) then
        if (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat = 0) and
          (vItem.dataSet.FieldByName('import_xml').AsString <> 'S') then

          vBaseST := vBaseST + (vItem.dataSet.FieldByName('valor_total').AsFloat -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat ) +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('rateio_frete').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat);
        //        if vItem.dataSet.FieldByName('base_icmsub').AsFloat > 0 then
//        if (vItem.dataSet.FieldByName('mva').AsFloat > 0) and
//          (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat > 0) then
        if (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat > 0) or
          (vItem.dataSet.FieldByName('import_xml').AsString = 'S')  then
        begin
          vBaseSTDistrib := vBaseSTDistrib + vItem.dataSet.FieldByName('base_icmsub').AsFloat;
          //        if vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0 then
          vValorSTDistrib := vValorSTDistrib + vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
          //          vBaseST := vBaseST - vItem.dataSet.FieldByName('base_icmsub').AsFloat;
        end;
      end;
      vItem.dataSet.Next;
    end;

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      vTemp := copy(vItem.dataSet.FieldByName('cst').AsString, 2, 2);
      if ((vTemp = '10') or (vTemp = '30') or (vTemp = '70')) and
        (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
//        if (vItem.dataSet.FieldByName('mva').AsFloat = 0) and
//          (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat = 0) then
        if (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat = 0) and
          (vItem.dataSet.FieldByName('import_xml').AsString <> 'S') then
        begin
          vItem.dataSet.Edit;
          vItem.dataSet.FieldByName('base_icmsub').AsFloat :=
            (dataSet.FieldByName('base_icmsub').AsFloat - vBaseSTDistrib) / vBaseST *
            (vItem.dataSet.FieldByName('valor_total').AsFloat -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat ) +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('rateio_frete').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat);

          vItem.dataSet.FieldByName('valor_icmsub').AsFloat :=
            (dataSet.FieldByName('valor_icmsub').AsFloat - vValorSTDistrib) / vBaseST *
            (vItem.dataSet.FieldByName('valor_total').AsFloat -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat ) +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('rateio_frete').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat);
          vItem.dataSet.FieldByName('valor_icmsub').AsFloat :=
            vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('valor_icmsub').AsFloat, 2);
          vItem.dataSet.FieldByName('base_icmsub').AsFloat :=
            vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('base_icmsub').AsFloat, 2);
          vItem.dataSet.Post;
        end;
      end;
      vItem.dataSet.Next;
    end;

    //    vTemp := copy(vItem.vrDadosItem.cst, 2, 2);
    //    if (vTemp = '10') or (vTemp = '30') or (vTemp = '70') then
    //    begin
    //      vItem.vrDadosItem.valor_icmsub := (dataSet.FieldByName('valor_icmsub').AsFloat /
    //        dataSet.FieldByName('valor_prod').AsFloat)
    //        * (vItem.vrDadosItem.valor_total - (vItem.vrDadosItem.rateio_desconto +
    //          vItem.vrDadosItem.valor_desconto_perc));
    //      vItem.vrDadosItem.base_icmsub := (dataSet.FieldByName('base_icmsub').AsFloat /
    //        dataSet.FieldByName('valor_prod').AsFloat)
    //        * (vItem.vrDadosItem.valor_total - (vItem.vrDadosItem.rateio_desconto +
    //          vItem.vrDadosItem.valor_desconto_perc));
    //      vItem.vrDadosItem.valor_icmsub := vDadosIni.StrToFloatFormat(vItem.vrDadosItem.valor_icmsub,
