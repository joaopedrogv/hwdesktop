function TNFCab.GetVendasDaNF: ArrayVendas;
var
  existe: Boolean;
  I: Integer;
begin
  SetLength(Result, 0);
  if (fint('nped') > 0) and (not fempty('tipo_ped')) then
  begin
    SetLength(Result, 1);
    Result[High(Result)].NPed := fint('nped');
    Result[High(Result)].TipoVenda := fstr('tipo_ped');
    Exit;
  end;

  vItem.prepare_loop();
  try
    while not vItem.Eof do
    begin

      if (fint('nped') > 0) and (not fempty('tipo_ped')) then
      begin
        existe := False;
        for I := Low(Result) to High(Result) do
          if existe then
            Break
          else
            existe := (fint('nped') = Result[I].NPed) and fequals('tipo_ped', Result[I].TipoVenda);

        if not existe then
        begin
          SetLength(Result, Length(Result) + 1);
          Result[High(Result)].NPed := fint('nped');
          Result[High(Result)].TipoVenda := fstr('tipo_ped');          
        end;
      end;
      vItem.dataSet.Next;
    end;

  finally
    vItem.prepare_loop_done();
  end;
end;

