function TNFCab.verNotasVendaForaEstabelecimento: Boolean;
begin
  try
    buscas.AfterScroll := AfterScrollNFVendaForaEstab;
    dtmNF.dsTemp.DataSet := buscas;
    dtmNF.dsTemp2.DataSet := _buscas;

    buscas.Close;
    buscas.SQL.Text := 'select nf.cod_nf, nf.num_nf, nf.natureza_nf, nf.data_lanc,' +
      ' nf.cod_cliente||'' - ''||c.nome_cliente cliente, nf.valor_total, nf.status' +
      ' from notafiscal nf' +
      ' inner join clientes c on c.cod_cliente = nf.cod_cliente and c.cod_empresa = nf.cod_empresa' +
      ' where nf.cod_nf_rem_vfe= ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
      ' and nf.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by nf.data_lanc, nf.num_nf';
    buscas.Open;

    TFloatField(buscas.FieldByName('VALOR_TOTAL')).DisplayFormat := DisplayNumber(2);

    Result := abreFormVerVendaForaEstabelecimento;

  finally
    dtmNF.dsTemp.DataSet := nil;
    dtmNF.dsTemp2.DataSet := nil;
    buscas.AfterScroll := nil;
  end;
end;

procedure TNFCab.verPermissaoDesconto;
begin
  if notaFechada then
    Exit;

  if Trim(dataSet.FieldByName('natureza_nf').AsString) = 'E' then
    Exit;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
    begin
      vItem.dataSet.Edit;

      if Trim(dataSet.FieldByName('devolucao').AsString) = 'SIM' then
        vItem.dataSet.FieldByName('permitir_desconto').AsString := 'S'
      else
      begin
        vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString);
        vItem.dataSet.FieldByName('permitir_desconto').AsString :=
          vItem.vProd.dataSet.FieldByName('permitir_desconto').AsString;
      end;
      vItem.dataSet.Post;
    end;
    vItem.dataSet.Next;
  end;
end;

function TNFCab.visualizarReferenciaDevolucao: Boolean;
var
  vSql: string;
begin// abre o formulario para visualizar a referencia de devoluções
  try
    if Trim(dataSet.FieldByName('tipo_nf').AsString) <> 'V' then
      raiseExceptionCreate('Nota Fiscal não é de veículos', '');

    if ( vItem.dataSet.FieldByName('cod_nf_dev').AsInteger = 0) and
      (vItem.dataSet.FieldByName('nitem_dev').AsInteger = 0) then
      raiseExceptionCreate('Item não tem nehum vinculo de devolução', '');

    if not vDadosIni.PesqPros('NF0176', 'VISUALIZAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) +
      'CHASSI: ' +vItem.dataSet.FieldByName('CHASSI').AsString,
      'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas, True) then
      Exit;

    vSql :=  'select nf.num_nf "Num NF", nf.data_lanc "Data NF", nf.status "Status", cast(substring(nf.situacao_nfe from 1 for 12) as varchar(12)) "Situação NF-e",' +
      ' nfi.nitem "Nº Item", nfi.valor_total "Vr Tot Item", nf.valor_total "Valor NF",' +
      ' nfi.codigo_nop CFOP, nf.serie "Serie", nf.modelo_nf "Modelo", c.nome_cliente "Nome Fantasia",' +
      ' c.razao "Razao Social", nfi.cod_nf "Cod NF", nfi.nitem "Nitem", nfi.cod_nf "Cod_NF" from notafiscal_item nfi' +
      ' inner join notafiscal nf on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
      ' inner join clientes c on c.cod_cliente = nf.cod_cliente and c.cod_empresa = nf.cod_empresa' +
      ' where nfi.cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf_dev').AsInteger) +
      ' and nfi.nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem_dev').AsInteger) +
      ' and nfi.cod_empresa = ' + vDadosIni.codEmpresa;

    Result := abreFormReferenciasDevolucao( 'Chassi: ' + Trim(vItem.dataSet.FieldByName('chassi').AsString) +
      ' Item: ' + vItem.dataSet.FieldByName('nitem').AsString +
      '. Nota fiscal referenciada que originou a devolução', vSql);
    
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFCab._atualizarSituacaoPedidos(pStatus: string; pExcluir, pComitar: Boolean): Boolean;
var
  vLista: TStringList;
  I: Integer;
begin
  Result := True;

  if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString <> 'S' then
    Exit;

  buscas.close;
  buscas.SQL.Text := 'select modelo_nf, situacao_nfe from notafiscal' +
    ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (not pExcluir) and (pStatus = 'Finalizado') then
    if not ((buscas.FieldByName('modelo_nf').AsString <> '55') or
      ((buscas.FieldByName('modelo_nf').AsString = '55') and
      (buscas.FieldByName('situacao_nfe').AsString = sitAutorizada))) then
      Exit;

  buscas.Close;
  buscas.SQL.Text := 'select distinct NPED, TIPO_PED from NOTAFISCAL_ITEM' +
    ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and tipo_item = ''P'' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  vLista := TStringList.Create;
  vLista.Clear;

  buscas.First;
  while not buscas.Eof do
  begin
    vLista.Add(
      IntToStr(buscas.FieldByName('NPED').AsInteger) + '|' +
      Trim(buscas.FieldByName('TIPO_PED').AsString) + '|'
      );
    buscas.Next;
  end;

  for I := 0 to vLista.Count - 1 do
  begin
    vDadosIni.informarSituacaoPedido(
      StrToInt(vDadosIni.getCampoPipe(vLista[i],1)), Trim(vDadosIni.getCampoPipe(vLista[i],2)),
      'FATURAMENTO',
      pStatus,
      '',
      buscas, pComitar, False, pExcluir);
  end;
end;

function TNFCab._gerarPreNotaTransferencia: Boolean;
var
  vPreNota : TXmlImport;
  vCodEmpTransf: Integer;
begin
  Result := True;

  try

    if dataSet.FieldByName('natureza_nf').AsString <> 'S' then
      Exit;

    if get_status <> stsFechada then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select PRE_NOTA_TRANSF_CFOP, PRE_NOTA_TRANSF_CNPJ from empresa' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if pos(Trim( IntToStr(Trunc(dataSet.FieldByName('codigo_nop').AsFloat)))+ '|',
      Trim(buscas.FieldByName('PRE_NOTA_TRANSF_CFOP').AsString)) = 0 then
      Exit;

    if pos(Trim(dataSet.FieldByName('cpfcgc').AsString)+ '|',
      Trim(buscas.FieldByName('PRE_NOTA_TRANSF_CNPJ').AsString)) = 0 then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select cod_empresa from empresa' +
      ' where cod_empresa <> ' + vDadosIni.codEmpresa +
      ' and cgc_emp = ' + QuotedStr(Trim(dataSet.FieldByName('cpfcgc').AsString));
    buscas.Open;

    vCodEmpTransf := buscas.FieldByName('cod_empresa').AsInteger;

    if (vCodEmpTransf <= 0) or (vCodEmpTransf = StrToInt(vDadosIni.codEmpresa)) then
      Exit;

    vPreNota := TXmlImport.create;
    try
      Result := vPreNota.montarPreNota('', dataSet.FieldByName('cod_nf').AsInteger, vCodEmpTransf, False);
    finally
      FreeAndNil(vPreNota);
    end;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro ao gerar Pre-Nota. Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TNFCab._gerarPreNotaTransferencia. Erro: ' + e.Message);
    end;
  end;
end;

