function TNFCab.GetFretePorPeso: TFretePorPesoModel;
var
  query: TQuery_OOP;
  items: TItensFreteModelArray;
  freteEmDespPF: Boolean;
begin
//  query := TQuery_OOP.Create(SqlOpen(''));

  if (frete_strToOperacao in  [opfContaDestinatario, opfProprioDestinatario])
    and (ffloat('valor_frete') > 0) then
    freteEmDespPF := True
  else
    freteEmDespPF := False;

  Result := TFretePorPesoModel.Create;
  Result.notafiscalId := fint('cod_nf');
  Result.clienteId := fint('cod_cliente');
  Result.freteEmDespPF := freteEmDespPF;//  fdif('frete_f_nfe', 'S');// (not fstrin('freteconta_tr', ['9', '']));
  Result.conf := TConfig_sistema_class.getConf('prod_frete_peso', buscas, vDadosIni.cod_empresa);

  SetLength(items, 0);
  vItem.prepare_loop();
  try
    while not vItem.dataset.Eof do
    begin
      SetLength(items, Length(items) + 1);

      items[High(items)] := TItensFreteModel.Create;
      items[High(items)].nitem := vItem.fint('nitem');
      items[High(items)].unidade := vItem.fstr('referencia');//vItem.fstrdef('ucom', vItem.fstr('referencia'));

      if (Result.conf.ReadString('Calculo', 'SobreDadosFornecedor') = 'S')
        and (vItem.ffloat('qcom') > 0)
        and (not vItem.fempty('ucom')) then
      begin
        items[High(items)].quantidade := vItem.ffloat('qcom');
        items[High(items)].unidade := vItem.fstr('ucom');
      end
      else
      begin
        items[High(items)].quantidade := vItem.ffloat('quantidade');
        items[High(items)].unidade := vItem.fstr('referencia');
      end;

      items[High(items)].valor := vItem.ffloat('valor_total');
      items[High(items)].frete := 0;
      items[High(items)].grupo := vItem.fint('grupo_prod');
      items[High(items)].codprod := vItem.fstr('cod_prod');
      items[High(items)].freteId := 0;
      items[High(items)].jaIncluido := False;

      vItem.dataset.Next;
    end;

  finally
