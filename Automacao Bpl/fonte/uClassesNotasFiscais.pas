type
  TAvaliadorRetencoes = record
  private
    FCount: Integer;
    FTipos: array of string;
    FAliquotas: array of Currency;
    FBases: array of Currency;
  public
    procedure Inicializar(CountIntens: Integer);
    procedure Add(const Tipo: string; Aliquota, BaseCalculo: Currency);
    function ObterCalculo(const Tipo: string): Currency;
  end;

{ TAvaliadorRetencoes }

procedure TAvaliadorRetencoes.Add(const Tipo: string; Aliquota, BaseCalculo: Currency);
const
  Delta = 32;
var
  I: Integer;
  sTipo: string;
begin
  Aliquota := RoundTo(Aliquota, -2);

  if Aliquota <= 0 then
    Exit;

  BaseCalculo := RoundTo(BaseCalculo, -2);
  sTipo := Trim(AnsiUpperCase(Tipo));

  for I := 0 to FCount do
    if (Aliquota = FAliquotas[I]) and (sTipo = FTipos[I]) then
    begin
      FBases[I] := FBases[I] + BaseCalculo;
      Exit;
    end;

  if FCount >= Length(FTipos) then
  begin
    SetLength(FAliquotas, Length(FAliquotas) + Delta);
    SetLength(FBases, Length(FBases) + Delta);
    SetLength(FTipos, Length(FTipos) + Delta);
  end;

  FTipos[FCount] := sTipo;
  FBases[FCount] := BaseCalculo;
  FAliquotas[FCount] := Aliquota;
              
  Inc(FCount);
end;

procedure TAvaliadorRetencoes.Inicializar(CountIntens: Integer);
begin
  SetLength(FAliquotas, CountIntens);
  SetLength(FBases, CountIntens);
  SetLength(FTipos, CountIntens);
  FCount := 0;
end;

function TAvaliadorRetencoes.ObterCalculo(const Tipo: string): Currency;
var
  I: Integer;
  sTipo: string;
  vCalc: Currency;
begin
  vCalc := 0;
  sTipo := Trim(AnsiUpperCase(Tipo));
  for I := 0 to FCount -1 do
    if (sTipo = FTipos[I]) then
      vCalc:= vCalc + (FBases[I] * FAliquotas[I] / 100);

  Result := RoundTo(vCalc, -2);
end;

