              buscas.SQL.Text := ' update est_moto ' +
                ' set posicao = :posicao, cod_nf = :cod_nf, modelo_nf = :modelo_nf, ' +
                ' status_canc = :status_canc, status_uso = :status_uso, status_res = :status_res, ' +
                ' status_demonst = :status_demonst, status_transdep = :status_transdep, ' +
                ' status_estoque = :status_estoque, data_ch_nota = :data_ch_nota, ' +
                ' data_venc_res = :data_venc_res, hora_venc_res = :hora_venc_res ' +
                ' where chassi_c = :chassi_c and cod_empresa = :cod_empresa and codigo = :codigo ';
              buscas.ParamByName('CHASSI_C').AsString := trim(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString);
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
              buscas.ParamByName('CODIGO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger;
              buscas.ParamByName('POSICAO').AsString := 'TRANSITO';
              buscas.ParamByName('COD_NF').AsInteger := 0;
              buscas.ParamByName('MODELO_NF').AsString := 'TRA';
              buscas.ParamByName('STATUS_USO').Value := Null;
              buscas.ParamByName('STATUS_CANC').AsString := 'N';
              buscas.ParamByName('STATUS_RES').AsString := 'N';
              buscas.ParamByName('STATUS_DEMONST').AsString := 'N';
              buscas.ParamByName('STATUS_TRANSDEP').AsString := 'N';
              buscas.ParamByName('STATUS_ESTOQUE').AsString := 'N';
              buscas.ParamByName('DATA_CH_NOTA').Value := Null;
              buscas.ParamByName('DATA_VENC_RES').Value := Null;
              buscas.ParamByName('HORA_VENC_RES').Value := Null;
              buscas.Prepare;
              buscas.ExecSQL;
            end;

            ExecutaComandosSqlExec('delete from equipamento eq ' +
               ' where eq.cod_estmoto = ' + IntToStr(vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger) +
               ' and eq.cod_empresa = ' + vDadosIni.codEmpresa);

            ExecutaComandosSqlExec('delete from hist_estmoto ' +
               ' where tipo = ''NF'' and numdoc = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
               ' and chassi_c = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
               ' and codigo = ' + IntToStr(vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger) +
               ' and cod_empresa = ' + vDadosIni.codEmpresa);

            if dataSet.FieldByName('natureza_nf').AsString = 'E' then
              ExecutaComandosSqlExec('delete from com_fat ' +
               ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
               ' and n_comando =' + IntToStr(dataSet.FieldByName('n_comando').AsInteger) +
               ' and chassiv = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
               ' and cod_estmoto = ' + IntToStr(vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger) +
               ' and cod_empresa = ' + vDadosIni.codEmpresa);

            if dataSet.FieldByName('natureza_nf').AsString = 'E' then
              ExecutaComandosSqlExec('delete from hist_estmoto ' +
              ' where tipo in (''CFT'', ''CTR'') and numdoc = ' + IntToStr(dataSet.FieldByName('n_comando').AsInteger) +
              ' and chassi_c = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
              ' and codigo = ' + IntToStr(vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa);
          end
          else
          begin
             if (copy(vItem.dataset.FieldByName('codigo_nop').Asstring,2,3) <> '913') then
             begin
               vItem.vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger,
                 vItem.dataSet.FieldByName('nitem').AsInteger);
               if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N' then
                 ExecutaComandosSqlExec('delete from est_moto where chassi_c = ' +
                   QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
                   ' and cod_empresa = ' + vDadosIni.codEmpresa)
               else if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'U' then
                 ExecutaComandosSqlExec('delete from mtusadas where chassi_us = ' +
                   QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
                   ' and cod_empresa = ' + vDadosIni.codEmpresa);
             end;
             if dataSet.FieldByName('n_comando').AsInteger > 0 then
             begin
               if (dataset.FieldByName('codigo_nop').AsFloat = 1409) or
                 (dataset.FieldByName('codigo_nop').AsFloat = 2409) then
               begin
                 buscas.close;
                 buscas.SQL.Text := 'select * from TRANSF_DEP' +
                   ' WHERE CHASSIV = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
                   ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
                   ' AND N_COMANDO = ' + dataSet.FieldByName('n_comando').AsString +
                   ' AND ATIVO = 1';
                 buscas.Open;
                 if (not buscas.IsEmpty) then
                 begin
                   buscas.close;
                   buscas.Sql.Text := ' update transf_dep set data_trans_ret = null' +
                     ' where chassiv = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
                     ' and cod_empresa = ' + vDadosIni.codEmpresa +
                     ' AND N_COMANDO = ' + dataSet.FieldByName('n_comando').AsString +
                     ' and ativo = 1 and not data_trans_ret is null';
                   buscas.Prepare;
                   buscas.ExecSQL;
                 end;
               end;
             end;
          end;
        end;

        vItem.dataSet.Next;
      end;

      //Atualizar pontos da exclusão de nota de entrada de devolução
      for I := 0 to vListDocPrgFid.Count - 1 do
      begin
        // Atualizar pontos programa de fidelidade
        if not vDadosIni.setarPontosProgFidelidade(StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
          trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)),
          buscas, false, StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 3)), trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 4))) then
        begin
          RollBackTransacao;
          Result := False;
          exit;
        end;
      end;

      // Remover o estoque do ecf
      removerEstoqueECF;

      if not vGrComp.removerGradeCompraEExcluirEstoque(
        dataSet.FieldByName('cod_nf').AsInteger) then
          raiseExceptionCreate('Erro ao remover estoque de Grades','');

      if dataSet.FieldByName('num_ped').AsInteger > 0 then
        ExecutaComandosSqlExec('update pedido set status_ped = ''EFETIVADO'',' +
          ' data_chg_ped =  null' +
          ' where num_ped = ' + dataSet.FieldByName('num_ped').AsString +
          ' and cod_empresa = ' + vDadosIni.codEmpresa);

    end;

    vItem.montaDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
    vItem.dataSet := TClientDataSet(dtmNF.cdsINf);

    _atualizarSituacaoPedidos('Iniciado', True);
    _atualizarSituacaoPedidos('Finalizado', True);

    ExecutaComandosSql('delete from notafiscal_item where cod_nf = ' +
      dataSet.FieldByName('cod_nf').AsString +
      ' and cod_empresa = ' + vDadosIni.codEmpresa);
    dataSet.Delete;
    if Apply then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('NF0018', 'EXCLUIR', 'SUCESSO', 'NOTAFISCAL', vCodTabMov, buscas);
      try
        vItem.dataSet := TClientDataSet(DtmNF.cdsTempINf);
        vItem.dataSet.First;
        while not vItem.dataSet.Eof do
        begin
          if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
            vMD5Func._gravaMD5_Produtos(buscas, vItem.dataSet.FieldByName('grupo_prod').AsInteger,
              vItem.dataSet.FieldByName('cod_prod').AsString);
          vItem.dataSet.Next;
        end;
      finally
        vItem.dataSet := TClientDataSet(dtmNF.cdsINf);
      end;
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('NF0018', 'EXCLUIR', 'FALHA', 'NOTAFISCAL', vCodTabMov, buscas);
    end;

    vItem.selecionaItens(0);
    for I := 0 to vListDocPrgFid.Count - 1 do
      vDadosIni.ImprimirRecProgFid(buscas, StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
         trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)),
         'CRÉDITO'); //Imprimir recibo programa de fidelidade
  except
    on e: Exception do begin
      Result := false;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('NF0018', 'EXCLUIR', 'FALHA', 'NOTAFISCAL', vCodTabMov, buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;


