procedure TNFCab.novoProduto;
var
  vTemp: string;
  vTempInt: integer;
begin

  vItem.cancelar;
  vItem.vrDadosItem.tipo_item := 'P';
  vItem.vrDadosItem.stado := dsInsert;
  vItem.handleTipoCalc;
  vItem.getDadosProduto;

  if (dataSet.FieldByName('natureza_nf').AsString = 'S') or
    (dataSet.FieldByName('emissao_propria').AsString = 'S') then
  begin
    if (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) <> 'S') then
      vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;

    if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
    begin
      //Acordo Cliente
      if verificaAcordoCliente(vItem.vrDadosItem.FAliqProduto,
        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto) then
      begin
        vItem.vrDadosItem.cst := FCstAcordoCliente;
        vItem.vrDadosItem.aliq_icm := FAliqAcordoCliente;
        vItem.vrDadosItem.codigo_nop := FCfopAcordoCliente;
      end
        //Acordo Geral
      else if verificaAcordoGeral(vItem.vrDadosItem.FAliqProduto,
        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto) then
      begin
        vItem.vrDadosItem.cst := FCstAcordoGeral;
        vItem.vrDadosItem.aliq_icm := FAliqAcordoGeral;
        vItem.vrDadosItem.codigo_nop := FCfopAcordoGeral;
      end
      else
      begin

        vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
      end;
    end;
    setDadosAtributosCFOP;
    if vDadosIni.vEmp.vRegime = 'SIMPLES' then
      vItem.vrDadosItem.aliq_icm_simples := vDadosIni.vemp.vAliqSimplesICM;
    if vItem.vCfopIt.dataSet.FieldByName('sem_imposto').AsString = 'S' then
    begin
      vItem.vrDadosItem.aliq_icm := 0;
      vItem.vrDadosItem.aliq_icm_simples := 0;
    end
    else if vDadosIni.vEmp.vRegime <> 'SIMPLES' then
    begin
      if FAliqAcordoCFOPMUDE > 0 then
        vItem.vrDadosItem.aliq_icm := FAliqAcordoCFOPMUDE
      else
        vItem.vrDadosItem.aliq_icm := vItem.vrDadosItem.FAliqProduto;
    end;
  end
  else
    vItem.vrDadosItem.aliq_icm := dataSet.FieldByName('aliq_icm').AsFloat;

  vTemp := copy(vItem.vrDadosItem.cst, 2, 2);
  if not vClFor.empresaSubstitutoTributario then
  begin
    if vTemp = '10' then
      vItem.vrDadosItem.cst := copy(vItem.vrDadosItem.cst, 1, 1) + '00'
    else if vTemp = '30' then
      vItem.vrDadosItem.cst := copy(vItem.vrDadosItem.cst, 1, 1) + '40'
    else if vTemp = '70' then
      vItem.vrDadosItem.cst := copy(vItem.vrDadosItem.cst, 1, 1) + '20';
  end;
  if (vDadosIni.vemp.vRegime = 'SIMPLES') //and (dataSet.FieldByName('natureza_nf').AsString = 'S')
    then
  begin
    vItem.vrDadosItem.csosn := getCSOSNPorCST(vItem.vrDadosItem.cst, vItem.vrDadosItem.csosn, False);
    vItem.vrDadosItem.cst := getCSTPorCSOSN(vItem.vrDadosItem.cst, vItem.vrDadosItem.csosn);
  end;

  //  vTempInt := getCFOP;
  //  if vTempInt > 0 then
  //    vItem.vrDadosItem.codigo_nop := vTempInt;
  if (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) <> 'S') then
    vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;

  vItem.vrDadosItem.codigo_nop :=
    StrToFloat(getCfopCorreto(FloatToStr(vItem.vrDadosItem.codigo_nop)));
  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
  begin
    vItem.getDadosSubstituicaoTribSaida(
      vItem.vrDadosItem.ncm, (vDadosIni.vEmp.vSiglaUF <>
      getUFdaOperacao),
      vClFor.clienteFornecedorContrinuinte);
    vItem.vrDadosItem.aliq_icmsub := getAliqICMSST(vItem.vrDadosItem.cst);
    vItem.vrDadosItem.cst_ipi := Trim(vItem.vProd.dataSet.FieldByName('cst_ipi').AsString);
    if Trim(vItem.vrDadosItem.cst_ipi) = '' then
      if vItem.vrDadosItem.aliq_ipi > 0 then
        vItem.vrDadosItem.cst_ipi := '50'
      else
        vItem.vrDadosItem.cst_ipi := '52';
    //    if itemTributadoST(vItem.vrDadosItem.cst) then
    //    begin
    //      if vItem.vrDadosItem.FMVA > 0 then
    vItem.vrDadosItem.mva := vItem.vrDadosItem.FMVA;
    //      else
    //        Application.MessageBox('MVA não encontrado para o produto informado', 'Atenção', 0 +
    //          64);
    //    end;
//    if Trim(vItem.vProd.dataSet.FieldByName('isento_pis').AsString) = 'S' then
//    begin
//      vItem.vrDadosItem.cst_pis := '04';
//      vItem.vrDadosItem.cst_cofins := '04';
//    end
//    else
    begin
      vItem.vrDadosItem.cst_pis := Trim(vItem.vProd.dataSet.FieldByName('cst_pis').AsString);
      vItem.vrDadosItem.cst_cofins := Trim(vItem.vProd.dataSet.FieldByName('cst_cofins').AsString);
    end;
  end
  else
  begin
    vItem.vrDadosItem.aliq_ipi := 0;
    vItem.vrDadosItem.cst_ipi := '02';
    if vItem.getDadosSubstituicaoTribNbmEstado(
      vItem.vrDadosItem.ncm) then
    begin
      vItem.vrDadosItem.aliq_icmsub := vItem.vrDadosItem.FAliqNbmEstado;
      vItem.vrDadosItem.mva := vItem.vrDadosItem.FMvaNbmEstado;
      vItem.vrDadosItem.cst := vItem.vrDadosItem.FCstNbmEstodo;
    end;
//    if Trim(vItem.vProd.dataSet.FieldByName('isento_pis').AsString) = 'S' then
//    begin
//      vItem.vrDadosItem.cst_pis := '73';
//      vItem.vrDadosItem.cst_cofins := '73';
//    end
//    else
    begin
      vItem.vrDadosItem.cst_pis := Trim(vItem.vProd.dataSet.FieldByName('CST_PIS_ENT').AsString);
      vItem.vrDadosItem.cst_cofins := Trim(vItem.vProd.dataSet.FieldByName('CST_COFINS_ENT').AsString);
    end;
  end;

  vItem.vrDadosItem.camp_entest := 'L';
  if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
    vItem.vrDadosItem.permitir_desconto := 'S';

  if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
    (dataSet.FieldByName('emissao_propria').AsString <> 'S') then
  begin
    if (dataSet.FieldByName('aliq_icm').AsFloat > 0) then
      vItem.vrDadosItem.aliq_icm := dataSet.FieldByName('aliq_icm').AsFloat;
    vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
    vItem.vrDadosItem.cst := '';
    vItem.vrDadosItem.csosn := '';
    vItem.vrDadosItem.perc_red_prod := 0;
  end
  else
  begin
    vItem.vrDadosItem.perc_red_prod := vItem.vProd.getPercentualDeReducaoBaseICMS(
      vDadosIni.vEmp.vSiglaUF = getUFdaOperacao,
      (dataSet.FieldByName('insc_est').AsString = 'ISENTO') or
      (Trim(dataSet.FieldByName('insc_est').AsString) = ''), vItem.vrDadosItem.aliq_icm);
    vItem.vrDadosItem.perc_red_prod_sub := vItem.vrDadosItem.perc_red_prod;
    if vDadosIni.vEmp.vRegime = 'SIMPLES' then
    begin
      vItem.vrDadosItem.aliq_icm_simples := vDadosIni.vEmp.vAliqSimplesICM;
      vItem.vrDadosItem.perc_red_prod := 0;
    end;
    try
      vCPag.abreCondPag(dataSet.FieldByName('cod_cond_pag').AsInteger);
      vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
        vItem.vProd.dataSet.FieldByName('prec_tab_prod').AsCurrency);
      if vCPag.dataSet.FieldByName('seqpreco').AsString = '1' then
        vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
          vItem.vProd.dataSet.FieldByName('prec_tab_prod').AsCurrency)
      else if vCPag.dataSet.FieldByName('seqpreco').AsString = '2' then
        vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
          vItem.vProd.dataSet.FieldByName('prec_30_prod').AsCurrency)
      else if vCPag.dataSet.FieldByName('seqpreco').AsString = '3' then
        vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
          vItem.vProd.dataSet.FieldByName('prec_60_prod').AsCurrency)
      else if vCPag.dataSet.FieldByName('seqpreco').AsString = '4' then
        vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
          vItem.vProd.dataSet.FieldByName('prec_90_prod').AsCurrency);
      vItem.vrDadosItem.valor_total := RoundTo(vItem.vrDadosItem.quantidade * vItem.vrDadosItem.valor_unitario, -2);
    finally
      vCPag.abreCondPag(dataSet.FieldByName('natureza_nf').AsString[1]);
    end;
  end;
end;

procedure TNFCab.novoServico;
var
  vTemp: string;
begin
  vItem.cancelar;
  vItem.vrDadosItem.stado := dsInsert;
  vItem.getDadosTipoServico;
  if vItem.vrDadosItem.codigo_nop = 0 then
    vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
  if vItem.vrDadosItem.codigo_nop = 0 then
    vItem.vrDadosItem.codigo_nop := vDadosIni.vEmp.vCfopPadraoServ;

  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
  begin
    if vDadosIni.vEmp.vRegime = 'SIMPLES' then
      vItem.vrDadosItem.aliq_iss := vDadosIni.vEmp.vAliqSimplesISS
    else if vItem.vServ.dataSet.FieldByName('aliq_iss').AsFloat > 0 then
      vItem.vrDadosItem.aliq_iss := vItem.vServ.dataSet.FieldByName('aliq_iss').AsFloat;
    vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
      vItem.vServ.dataSet.FieldByName('VALOR_SERVICO').AsCurrency);
    vItem.vrDadosItem.cst_ipi := '52'
  end
  else
  begin
    vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
    vItem.vrDadosItem.consumo := 'S';
    vItem.vrDadosItem.cst_ipi := '02';
  end;
end;

procedure TNFCab.novoVeiculo;
var
  vTemp: string;
begin
  vItem.cancelar;
  vItem.vrDadosItem.stado := dsInsert;
  vItem.vrDadosItem.chassi := vComFat.dataSet.FieldByName('chassiv').AsString;
  vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
  vItem.vrDadosItem.quantidade := 1;
  vItem.vrDadosItem.nItem := 1;
  vItem.vrDadosItem.tipo_item := 'V';
  vItem.vrDadosItem.referencia := 'UN';
  vItem.vrDadosItem.permitir_desconto := 'S';
  vItem.vrDadosItem.num_fab_prod := vComFat.dataSet.FieldByName('chassiv').AsString;
  vItem.vrDadosItem.desc_natop := dataSet.FieldByName('desc_natop').AsString;
  vItem.vrDadosItem.cst := vComFat.dataSet.FieldByName('cst_v').AsString;
  vItem.vrDadosItem.red_lucro := vComFat.vItem.dataSet.FieldByName('RED_LUCRO').AsString;
  vItem.vrDadosItem.ncm := vComFat.vItem.dataSet.FieldByName('ncmsh').AsString;
  vitem.vrDadosItem.preco_compra_veiculo :=
    vComFat.vItem.dataSet.FieldByName('precocompra').AsFloat;
  if vComFat.vItem.dataSet.FieldByName('PRECO_CUSTO').AsFloat > 0 then
    vitem.vrDadosItem.prec_cusm_prod := vComFat.vItem.dataSet.FieldByName('PRECO_CUSTO').AsFloat
  else
    vitem.vrDadosItem.prec_cusm_prod := vitem.vrDadosItem.preco_compra_veiculo;
  vItem.vrDadosItem.valor_unitario :=
    vDadosIni.StrToFloatFormat(vComFat.dataSet.FieldByName('PRVEN_V').AsFloat, 2);
  vItem.vrDadosItem.valor_total :=
    vItem.vrDadosItem.valor_unitario;
  if (vDadosIni.vEmp.vUsarReducaoInvertida = 'S') and (vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat > 0) then
    vItem.vrDadosItem.perc_red_prod := 100 - vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat
  else
    vItem.vrDadosItem.perc_red_prod := vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat;
  vItem.vrDadosItem.aliq_icm := vComFat.dataSet.FieldByName('ALICM_V').AsFloat;
  if vItem.vrDadosItem.red_lucro = 'S' then
  begin
    vItem.vrDadosItem.cst := copy(vItem.vrDadosItem.cst, 1, 1) + '20';
    vItem.vrDadosItem.base_icm := vDadosIni.StrToFloatFormat(
      vItem.vrDadosItem.valor_total - vItem.vrDadosItem.preco_compra_veiculo, 2);
    if vItem.vrDadosItem.perc_red_prod > 0 then
      vItem.vrDadosItem.base_icm :=
        vItem.vrDadosItem.base_icm *
        (100 - vItem.vrDadosItem.perc_red_prod) / 100;
    if vItem.vrDadosItem.base_icm < 0 then
      vItem.vrDadosItem.base_icm := 0;
    if vItem.vrDadosItem.base_icm = 0 then
    begin
      vItem.vrDadosItem.perc_red_prod := 0;
      vItem.vrDadosItem.cst := copy(vItem.vrDadosItem.cst, 1, 1) + '41';
    end;
  end
  else
  begin
    vItem.vrDadosItem.base_icm :=
      vItem.vrDadosItem.valor_total;
    if vItem.vrDadosItem.perc_red_prod > 0 then
      vItem.vrDadosItem.base_icm :=
        vItem.vrDadosItem.base_icm *
        (100 - vItem.vrDadosItem.perc_red_prod) / 100;
  end;
  vItem.vrDadosItem.valor_icm :=
    vDadosIni.StrToFloatFormat((vItem.vrDadosItem.base_icm *
    vItem.vrDadosItem.aliq_icm / 100), 2);

  //vComFat.vItem
  vItem.vrDadosItem.descricao_item :=
    Trim(vComFat.vItem.dataSet.FieldByName('descricao_versaoest').AsString);
  if vComFat.vItem.dataSet.FieldByName('base_calc_icm_subv').AsFloat > 0 then
    vItem.vrDadosItem.base_icmant_sub :=
      vComFat.vItem.dataSet.FieldByName('base_calc_icm_subv').AsFloat;
  if vComFat.vItem.dataSet.FieldByName('VALOR_ICM_SUBV').AsFloat > 0 then
    vItem.vrDadosItem.valor_icmant_sub :=
      vComFat.vItem.dataSet.FieldByName('VALOR_ICM_SUBV').AsFloat;

  vItem.vrDadosItem.nped := vComFat.dataSet.FieldByName('n_comando').AsInteger;
  vItem.vrDadosItem.tipo_ped := 'MOT';

  {if vComFat.dataSet.FieldByName('bicmsub_v').AsFloat > 0 then
  begin
    if vItem.vrDadosItem.FAliqIntra > 0 then
      vItem.vrDadosItem.aliq_icmsub := vItem.vrDadosItem.FAliqIntra
    else if FAliqIntraEstadual > 0 then
      vItem.vrDadosItem.aliq_icmsub := FAliqIntraEstadual
    else // if not vClFor.clienteFornecedorContrinuinte then
      vItem.vrDadosItem.aliq_icmsub := 18;

    vItem.vrDadosItem.base_icmsub :=
      vComFat.vItem.dataSet.FieldByName('base_calc_icm_subv').AsFloat;
    vItem.vrDadosItem.valor_icmsub := 0;
  end;}
  verificaCSOSN(vItem.vrDadosItem.cst);
  //  if dataSet.FieldByName('crt').AsString = '1' then
  //  begin
  //    vTemp := copy(vItem.vrDadosItem.cst, 2, 2);
