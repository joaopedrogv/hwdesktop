function TNFCab._validaDadosExportacao: Boolean;
begin
  try

    if Trim(dataSet.FieldByName('NFE_IDDEST').AsString) <> '3' then
    begin
      if dataSet.State in [dsInsert, dsEdit] then
      begin
        dataSet.FieldByName('UFEMBARQ').AsString := '';
        dataSet.FieldByName('XLOCEMBARQ').AsString := '';
      end;

      buscas.close;
      buscas.SQL.Text := 'delete from NOTAFISCAL_ITEM_DETEXPORT' +
        ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
      buscas.ExecSQL;
      Result := True;
      Exit;
    end;

    if Trim(dataSet.FieldByName('UFEMBARQ').AsString) = '' then
      raiseExceptionCreate('UF de embarque deve ser informada', 'DBComboBox21');

    if Trim(dataSet.FieldByName('XLOCEMBARQ').AsString) = '' then
      raiseExceptionCreate('Local de embarque deve ser informado', 'DBEdit302');

    Result := True;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 64);
    end;
  end;
end;

