function TNFCab.getCFOP: integer;
begin //Caso seja necessario chamar este metodo de outro lugar, coloca dois parametros
  //tipo_item e codigo_nopDefault
  Result := 0;
  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
  begin
    Result := Trunc(dataSet.FieldByName('codigo_nop').AsFloat);
    Exit;
  end;
  if vItem.vrDadosItem.tipo_item = 'P' then
  begin
    if vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao then
    begin
      if FCfopAcordoCliente > 0 then
        result := Trunc(FCfopAcordoCliente)
      else if FCfopAcordoGeral > 0 then
        result := Trunc(FCfopAcordoGeral)
      else if FCfopAcordoCFOPMUDE > 0 then
        result := Trunc(FCfopAcordoCFOPMUDE)
      else if dataSet.FieldByName('natureza_nf').AsString = 'S' then
        Application.MessageBox('Sequência de Natureza de Operação não encontrada',
          'Atenção', 0 + 64);
    end
    else
    begin
      if (notaFiscalDeRetorno) or (notaFiscalDeRemessa(dataSet.FieldByName('codigo_nop').AsString))
        or
        (vItem.vrDadosItem.codigo_nop = 0) then
      begin
        result := Trunc(dataSet.FieldByName('codigo_nop').AsFloat);
        Exit;
      end
      else
        result := Trunc(vDadosIni.vEmp.vCfopPadraoProd);
    end;
  end;
end;

function TNFCab.getCfopCorreto(pCfop: string; UFCons: string): string;
begin
  Result := pCfop;
  try
    {
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    begin
      if (dataSet.FieldByName('dest_uf').AsString = 'EX') and (dataSet.FieldByName('NFE_IDDEST').AsString = '3') then
        Result := '7' + Copy(pCfop, 2, 3)
      else if (dataSet.FieldByName('dest_uf').AsString = 'EX') and (dataSet.FieldByName('NFE_IDDEST').AsString = '2') then
        Result := '6' + Copy(pCfop, 2, 3)
      else if (dataSet.FieldByName('dest_uf').AsString = 'EX') and (dataSet.FieldByName('NFE_IDDEST').AsString = '1') then
        Result := '5' + Copy(pCfop, 2, 3)
      else if (vDadosIni.vEmp.vSiglaUF <> dataSet.FieldByName('dest_uf').AsString) and
        ((copy(pCfop, 1, 1) = '5') or (copy(pCfop, 1, 1) = '1') or (copy(pCfop, 1, 1) = '2')) then
        Result := '6' + Copy(pCfop, 2, 3)
      else if (vDadosIni.vEmp.vSiglaUF = dataSet.FieldByName('dest_uf').AsString) and
        ((copy(pCfop, 1, 1) = '6') or (copy(pCfop, 1, 1) = '1') or (copy(pCfop, 1, 1) = '2')) then
        Result := '5' + Copy(pCfop, 2, 3)
    end
    else
    begin
      if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) and
        ((copy(pCfop, 1, 1) = '1') or (copy(pCfop, 1, 1) = '5') or (copy(pCfop, 1, 1) = '6')) then
        Result := '2' + Copy(pCfop, 2, 3)
      else if (vDadosIni.vEmp.vSiglaUF = getUFdaOperacao) and
        ((copy(pCfop, 1, 1) = '2') or (copy(pCfop, 1, 1) = '5') or (copy(pCfop, 1, 1) = '6')) then
        Result := '1' + Copy(pCfop, 2, 3)
    end;
    }

    if (UFCons = 'EX') and ((pCfop[1] = '3') or (pCfop[1] = '7')) then // I08-30
      Exit;
     {
    if f_str('emissao_propria') = 'S') and f_str('natureza_nf') = 'E' then
      if (UFCons = vDadosIni.vEmp.vSiglaUF) and (pCfop[1] = 1) then // I08-80
        Exit;

    if (UFCons <> vDadosIni.vEmp.vSiglaUF) and (pCfop[1] = '2') or (pCfop[1] = '6')) then // I08-90
      Exit;
    }
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      Result := IntToStr(StrToIntDef(fstr('nfe_iddest'), 1) + 4) + Copy(pCfop, 2, 3)
    else
    begin
      if getUFdaOperacao = 'EX' then
        Result := '3'
      else
        Result := IfThen(vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao, '2', '1');
      Result := Result + Copy(pCfop, 2, 3);
    end;

  except
  end;
end;

