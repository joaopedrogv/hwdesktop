      vItem.vDetEcf.dataSet.FieldByName('MODELO_ECF').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('MODELO_ECF').AsString;
      vItem.vDetEcf.dataSet.FieldByName('VERSAOSB').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('VERSAOSB').AsString;
      vItem.vDetEcf.dataSet.FieldByName('N_MEMORIA_FISCAL').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('N_MEMORIA_FISCAL').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO1').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO1').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO2').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO2').AsString;
