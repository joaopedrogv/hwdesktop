function TNFCab.buscaItem(tipo, grupoProd, CodProd: string): boolean;
var
  vTemp, vTempCodFornec: string;
begin
  try
    if tipo = 'P' then
    begin
      if Trim(grupoProd) = '' then
        raise Exception.Create('Produto não informado');
      if Trim(CodProd) = '' then
        raise Exception.Create('Produto não informado');
      if not vItem.vProd.buscaProduto(StrToInt(grupoProd),Trim(CodProd)) then
        raise Exception.Create('Produto não encontrado');
      vTemp := '';
      if Trim(vItem.vrDadosItem.num_fab_fornecedor) <> '' then
        vTemp := vItem.vrDadosItem.num_fab_fornecedor;
      if (not vItem.FSemCodigo) or (vItem.vrDadosItem.stado = dsBrowse) then
      begin
        novoProduto;
        vItem.vrDadosItem.num_fab_fornecedor := vTemp;
        //      verificaAcordoCliente(vItem.vrDadosItem.FAliqProduto,
        //        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto);
        //      verificaAcordoGeral(vItem.vrDadosItem.FAliqProduto,
        //        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto);
              //joguei os comentados dentro do novoProduto
  //      setDadosAtributosCFOP;

      end
      else
      begin
        vItem.vrDadosItem.grupo_prod := vItem.vProd.dataSet.FieldByName('grupo_prod').AsInteger;
        vItem.vrDadosItem.cod_prod := vItem.vProd.dataSet.FieldByName('cod_prod').AsString;
        vItem.vrDadosItem.num_fab_prod := vItem.vProd.dataSet.FieldByName('num_fab_prod').AsString;
        vItem.vrDadosItem.consumo := vItem.vProd.dataSet.FieldByName('consumo').AsString;
        vItem.vrDadosItem.ecf := vItem.vProd.dataSet.FieldByName('ecf').AsString;
        vItem.vrDadosItem.cean := vItem.vProd.vCB.GetEAN(vItem.vrDadosItem.cod_grade, Config.Conf_Geral.prod_ean_prefixos_invalidos);
      end;
      Result := True;
    end
    else if tipo = 'S' then
    begin
      if Trim(grupoProd) = '' then
        raise Exception.Create('Serviço não informado');
      if not vItem.vServ.buscaTipoServico(grupoProd) then
        raise Exception.Create('Serviço não encontrado');
      novoServico;
      setDadosAtributosCFOP;
      Result := True;
    end;
  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TNFCab.buscaItem(tipo, valor: string): boolean;
var
  vTemp, vTempCodFornec: string;
  AConf: TStrings;
begin
  try
    if tipo = 'P' then
    begin
      if Trim(valor) = '' then
        raise Exception.Create('Produto não informado');

      try
        vItem.vProd.inibePesquisaCodBarra := vItem.FSemCodigo;

        if not vItem.vProd.buscaProduto(Trim(valor), fequals('natureza_nf', 'S')) then
          raise Exception.Create('Produto não encontrado');

      finally
        vItem.vProd.inibePesquisaCodBarra := False;
      end;

      vTemp := '';
      if Trim(vItem.vrDadosItem.num_fab_fornecedor) <> '' then
        vTemp := vItem.vrDadosItem.num_fab_fornecedor;
      if (not vItem.FSemCodigo) or (vItem.vrDadosItem.stado = dsBrowse) then
      begin
        novoProduto;
        vItem.vrDadosItem.num_fab_fornecedor := vTemp;

        try
        	AConf := TStringList.Create;

        	AConf.Text := TConfig_sistema_class.getConf('ped_vnd_identificacao_produto', buscas, vDadosIni.cod_empresa).value1_b.Text;

          if (vDadosIni.GetIni('Conf', 'Identificar', 'INFORMADO', AConf) = 'NUMEROFABRICANTE') then
            vItem.vrDadosItem.num_fab_prod := vItem.vProd.dataSet.FieldByName('num_fab_prod').AsString
          else if (vDadosIni.GetIni('Conf', 'Identificar', 'INFORMADO', AConf) = 'GRUPOCODIGO') then
          	vItem.vrDadosItem.num_fab_prod := IntToStr(vItem.vProd.dataSet.FieldByName('grupo_prod').AsInteger) + vItem.vProd.dataSet.FieldByName('cod_prod').AsString
          else if (vDadosIni.GetIni('Conf', 'Identificar', 'INFORMADO', AConf) = 'CODIGO') then
          	vItem.vrDadosItem.num_fab_prod := vItem.vProd.dataSet.FieldByName('cod_prod').AsString
          else
          begin
            if not vItem.vProd.vConsultaDescricao then
              vItem.vrDadosItem.num_fab_prod := Trim(valor)
            else
              vItem.vrDadosItem.num_fab_prod := IfThen(vItem.vProd.vCB.CodBarraSelecionado <> '', vItem.vProd.vCB.CodBarraSelecionado, vItem.vrDadosItem.num_fab_prod);
          end;
        finally
          if Assigned(AConf) then
          	FreeAndNil(AConf);
        end;

        if (vItem.vrDadosItem.cst <> '') and (vItem.vrDadosItem.valor_total > 0)  then //na entrada não se faz necessario chamar o metodo, pois ainda não tem esses valores
          calcularValores(False);
        //      verificaAcordoCliente(vItem.vrDadosItem.FAliqProduto,
        //        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto);
        //      verificaAcordoGeral(vItem.vrDadosItem.FAliqProduto,
        //        vItem.vrDadosItem.FCfopProduto, vItem.vrDadosItem.FCstProduto);
              //joguei os comentados dentro do novoProduto
  //      setDadosAtributosCFOP;

      end
      else
      begin
        vItem.vrDadosItem.grupo_prod := vItem.vProd.dataSet.FieldByName('grupo_prod').AsInteger;
        vItem.vrDadosItem.cod_prod := vItem.vProd.dataSet.FieldByName('cod_prod').AsString;
        vItem.vrDadosItem.num_fab_prod := vItem.vProd.dataSet.FieldByName('num_fab_prod').AsString;
        vItem.vrDadosItem.consumo := vItem.vProd.dataSet.FieldByName('consumo').AsString;
        vItem.vrDadosItem.ecf := vItem.vProd.dataSet.FieldByName('ecf').AsString;
        vItem.vrDadosItem.descricao_item := Trim(vItem.vProd.dataSet.FieldByName('descr_prod').AsString);
        vItem.vrDadosItem.cod_grade := vItem.vProd.vCodGrade;
        vItem.vrDadosItem.cean := vItem.vProd.vCB.GetEAN(vItem.vrDadosItem.cod_grade, Config.Conf_Geral.prod_ean_prefixos_invalidos);
      end;
      Result := True;
    end
    else if tipo = 'S' then
    begin
      if Trim(valor) = '' then
        raise Exception.Create('Serviço não informado');
      if not vItem.vServ.buscaTipoServico(valor) then
        raise Exception.Create('Serviço não encontrado');
      novoServico;
      setDadosAtributosCFOP;
      Result := True;
    end;
  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

