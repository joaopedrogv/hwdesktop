function TNFCab.verificaTributacaoAdicional(pGrupo: Integer; pCodProd: string;
  pContribuinte, pPessoaJuridica, pConsumidorFinal: Boolean; pSiplaUF: string): Boolean;
var
  vSqlContribuinte, vSqlPessoa, vSqlConsumidorFinal, vSqlFinalidade: string;
  mvaAnexoXV: Double;
begin
  try
    if pContribuinte then
      vSqlContribuinte := ' and ((pf.contribuinte = ''Sim'') or (pf.contribuinte = ''Ambos''))'
    else
      vSqlContribuinte  := ' and ((pf.contribuinte = ''Nao'') or (pf.contribuinte = ''Ambos''))';

    if pPessoaJuridica then
      vSqlPessoa := ' and ((pf.pessoa = ''PJ'') or (pf.pessoa = ''Ambos''))'
    else
      vSqlPessoa := ' and ((pf.pessoa = ''PF'') or (pf.pessoa = ''Ambos''))';

    if pConsumidorFinal then
      vSqlConsumidorFinal := ' and ((pf.consumidor_final = ''Sim'') or (pf.consumidor_final = ''Ambos''))'
    else
      vSqlConsumidorFinal  := ' and ((pf.consumidor_final = ''Nao'') or (pf.consumidor_final = ''Ambos''))';

    vSqlFinalidade := Format(' and coalesce(pf.finalidadeid, %d) = %d', [fint('finalidadeid'), fint('finalidadeid')]);

//    if pContribuinte then
//      vContribuinte := ' and contribuinte = 0'
//    else
//      vContribuinte := ' and contribuinte = 1';
//
//    if pPessoaJuridica then
//      vPessoa := ' and pessoa = 0'
//    else
//      vPessoa := ' and pessoa = 1';
//
//    buscas.close;
//    buscas.sql.Text := 'select * from PRODUTOS_CONVENIO_UF' +
//      ' where GRUPO_PROD = ' + IntToStr(pGrupo) +
//      ' and cod_prod = ' + QuotedStr(pCodProd) +
//      ' and cod_empresa = ' + vDadosIni.codEmpresa +
//      ' and SIGLA_UF = ' + QuotedStr(pSiplaUF) + vContribuinte + vPessoa;
//    buscas.Open;

    buscas.close;
    buscas.sql.Text := 'select first 1 ad.*, pf.* from produtos_trib_ad ad' +
      ' inner join produtos_trib_pf pf on ad.cod_trib_pf = pf.cod_trib_pf and ad.cod_empresa = pf.cod_empresa and pf.ativo = 1' +
      ' where ad.GRUPO_PROD = ' + IntToStr(pGrupo) +
      ' and ad.cod_prod = ' + QuotedStr(pCodProd) +
      ' and ad.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pf.sigla_uf like ' + QuotedStr('%' +pSiplaUF + '|%') + vSqlContribuinte + vSqlPessoa + vSqlConsumidorFinal +
                                                                   vSqlFinalidade   +
      ' and pf.ativo = 1';
    buscas.Open;

    if (buscas.FieldByName('ind_desoneracao').AsInteger > 0) and (fstr('crt') <> '1') then
      vItem.vrDadosItem.ind_desoneracao := buscas.FieldByName('ind_desoneracao').AsInteger;
    if not buscas.IsEmpty then
    begin
      mvaAnexoXV := 0;
      if (buscas.FieldByName('usar_mva_anexoxv').AsString = 'S') and Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
        if vItem.vrDadosItem.getDadosSubstituicaoTributaria(getUFdaOperacao,
          Config.Conf_ICMS.nf_icmsst_cest_v2.GetRamoAtividade(fstr('natureza_nf'), fstr('cpfcgc'))) then
          mvaAnexoXV := vItem.vrDadosItem.ExecutarAjusteMVA(vItem.vrDadosItem.FMVA, buscas.FieldByName('ALIQ_INTER').AsFloat, buscas.FieldByName('ALIQ_INTRA').AsFloat);

      FAliqAcordoGeral := buscas.FieldByName('ALIQ_INTER').AsFloat;
      FCfopAcordoGeral := buscas.FieldByName('CODIGO_NOP').AsFloat;
      FCstAcordoGeral := buscas.FieldByName('CST_ICMS').AsString;

      vItem.vrDadosItem.FCP_aliq_tribAd := buscas.FieldByName('FCP_ALIQ').AsFloat;

      if (Copy(FCstAcordoGeral,1,1) = '0') or (Copy(FCstAcordoGeral,1,1) = '1') or (Copy(FCstAcordoGeral,1,1) = '2') or
        (Copy(FCstAcordoGeral,1,1) = '3') or (Copy(FCstAcordoGeral,1,1) = '7') or (Copy(FCstAcordoGeral,1,1) = '9') then
        vItem.vrDadosItem.FAliqInter := buscas.FieldByName('ALIQ_INTER').AsFloat;

      if (Copy(FCstAcordoGeral,1,1) = '2') or (Copy(FCstAcordoGeral,1,1) = '7') or (Copy(FCstAcordoGeral,1,1) = '9') then
        if Trim(buscas.FieldByName('REDUCAO_CAD_PRODUTO').AsString) <> 'S' then
        begin
          if (vDadosIni.vEmp.vUsarReducaoInvertida = 'S') and (buscas.FieldByName('perc_red_prod').AsFloat > 0) then
          begin
            vItem.vrDadosItem.perc_red_prod := 100 - buscas.FieldByName('perc_red_prod').AsFloat;
            vItem.vrDadosItem.perc_red_prod_sub := 100 - buscas.FieldByName('perc_red_prod').AsFloat;
          end
          else
          begin
            vItem.vrDadosItem.perc_red_prod := buscas.FieldByName('perc_red_prod').AsFloat;
            vItem.vrDadosItem.perc_red_prod_sub := buscas.FieldByName('perc_red_prod').AsFloat;
          end;
        end;

      if (Copy(FCstAcordoGeral,1,1) = '1') or (Copy(FCstAcordoGeral,1,1) = '3') or (Copy(FCstAcordoGeral,1,1) = '7') or (Copy(FCstAcordoGeral,1,1) = '9') then
      begin
        if mvaAnexoXV > 0 then
          vItem.vrDadosItem.FMVA := mvaAnexoXV
        else
          vItem.vrDadosItem.FMVA := buscas.FieldByName('MVA').AsFloat;
        vItem.vrDadosItem.FAliqIntra := buscas.FieldByName('ALIQ_INTRA').AsFloat;
        vItem.vrDadosItem.Fvlbcst := 0;
        vItem.vrDadosItem.Fmodbcst := 4;
      end;
    end;

    Result := not buscas.IsEmpty;
  finally
    buscas.Close;
  end;
end;

procedure TNFCab.verificaCSOSN(cst: string);
var
  vTemp: string;
begin
  if dataSet.FieldByName('crt').AsString <> '1' then
  begin
    vItem.vrDadosItem.csosn := '';
    exit;
  end
  else if dataSet.FieldByName('natureza_nf').AsString <> 'S' then
    exit;

  vTemp := copy(cst, 2, 2);
  if (vTemp = '10') or (vTemp = '70') then
  begin
    if not vClFor.clienteFornecedorContrinuinte then
      vItem.vrDadosItem.csosn := '202'
    else
      vItem.vrDadosItem.csosn := '201';
  end
  else if (vTemp = '00') or (vTemp = '20') then
  begin
    if not vClFor.clienteFornecedorContrinuinte then
      vItem.vrDadosItem.csosn := '102'
    else
      vItem.vrDadosItem.csosn := '101';
  end
  else if (vTemp = '30') then
    vItem.vrDadosItem.csosn := '203'
  else if (vTemp = '40') then
    vItem.vrDadosItem.csosn := '103'
  else if (vTemp = '41') then
  begin
    if vDadosIni.vUsarCSOSN300Para041 = 'S' then
      vItem.vrDadosItem.csosn := '300'
    else
      vItem.vrDadosItem.csosn := '400';
  end
  else if (vTemp = '60') then
    vItem.vrDadosItem.csosn := '500'
  else
    vItem.vrDadosItem.csosn := '900';
end;

function TNFCab.verificaDevolucaoDeItensPedVenda: boolean;
var
  vNPed:integer;
  vExisteDevolucao, vOK:Boolean;
  FDevolucao, FItensVenda: TStringList;
  I: Integer;
  vTemp: string;
  pNped, pNitem, pGrupoProd, pCodProd: string;
  pQuantidade: string;
  vValorTemp: Currency;
  vValorTemp2: Currency;
begin
  if fstr('natureza_nf') = 'E' then
    Exit;

  vNPed := 0;
  FItensVenda := TStringList.Create;
  FItensVenda.Clear;
  vExisteDevolucao := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
      (vItem.dataSet.FieldByName('tipo_ped').AsString = 'REQ') and
      (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_venda from devolucao where'+
        ' grupo_prod = '+vItem.dataSet.FieldByName('grupo_prod').AsString+
        ' and cod_prod = '+QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString)+
        ' and cod_empresa = '+vDadosIni.codEmpresa+
        ' and cod_venda = '+IntToStr(vItem.dataSet.FieldByName('nped').AsInteger)+//vNPed)+
        ' and quant > 0';
      buscas.Open;
      if not vExisteDevolucao then
        vExisteDevolucao := not buscas.IsEmpty;
      if not buscas.IsEmpty then
      begin
        vOK := True;
        for I := 0 to FItensVenda.Count - 1 do
        begin
          vTemp:= FItensVenda[i];
          pNped := copy(vTemp,1,Pos('|',vTemp) - 1);
          vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
          pGrupoProd := copy(vTemp,1,Pos('|',vTemp) - 1);
          vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
          pCodProd := copy(vTemp,1,Pos('|',vTemp) - 1);
          vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
          pQuantidade:= copy(vTemp,1,Pos('|',vTemp) - 1);
          vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
          if (Trim(vItem.dataSet.FieldByName('grupo_prod').AsString) = Trim(pGrupoProd)) and
            (Trim(vItem.dataSet.FieldByName('cod_prod').AsString) = Trim(pCodProd)) and
            (Trim(vItem.dataSet.FieldByName('nped').AsString) = Trim(pNped)) then
          begin
            vTemp := StringReplace(pQuantidade,'.','',[rfReplaceAll]);
            vValorTemp:= StrToFloat(pQuantidade);
            vValorTemp := vValorTemp + vItem.dataSet.FieldByName('quantidade').AsFloat;
            vTemp := StringReplace(FloatToStr(vValorTemp),'.','',[rfReplaceAll])+'|';
            FItensVenda[i] := pNped+'|'+pGrupoProd+'|'+pCodProd+'|'+vTemp;
            vOK := False;
            Break;
          end;
        end;
        if vOK then
        begin
          vTemp := StringReplace(FloatToStr(vItem.dataSet.FieldByName('quantidade').AsFloat),'.','',[rfReplaceAll])+'|';
          FItensVenda.Add(vItem.dataSet.FieldByName('nped').AsString+'|'+
          vItem.dataSet.FieldByName('grupo_prod').AsString+'|'+
          Trim(vItem.dataSet.FieldByName('cod_prod').AsString)+'|'+vTemp);
        end;
      end;
      //vExisteDevolucao := not buscas.IsEmpty;
      //if vExisteDevolucao  then
      //  Break;
    end;
    vItem.dataSet.Next;
  end;
  if not vExisteDevolucao then
    Exit;
  Application.ProcessMessages;
  vOK := Application.MessageBox(pchar('Existe devolução para algum(s) item(s) da nota fiscal'+sLineBreak+
    'Deseja remover os itens devolvidos?'),'Confirmação',MB_ICONQUESTION + MB_YESNO) = IDYES;
  if not vOK then
    Exit;

  FDevolucao:= TStringList.Create;
  FDevolucao.Clear;
  for I := 0 to FItensVenda.Count - 1 do
  begin
    vTemp:= FItensVenda[i];
    pNped := copy(vTemp,1,Pos('|',vTemp) - 1);
    vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
    pGrupoProd := copy(vTemp,1,Pos('|',vTemp) - 1);
    vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
    pCodProd := copy(vTemp,1,Pos('|',vTemp) - 1);
    vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
    buscas.Close;
    buscas.SQL.Text := 'select cod_venda, sum(quant) as quantidade from devolucao where'+
      ' grupo_prod = '+pGrupoProd+
      ' and cod_prod = '+QuotedStr(pCodProd)+
      ' and cod_empresa = '+vDadosIni.codEmpresa+
      ' and cod_venda = '+pNped+
      ' and quant > 0 group by 1';
    buscas.Open;
    if (not buscas.IsEmpty ) and (buscas.FieldByName('quantidade').AsFloat > 0) then
    begin
      vTemp := StringReplace(FloatToStr(buscas.FieldByName('quantidade').AsFloat),'.','',[rfReplaceAll])+'|';
      FDevolucao.Add( pNped+'|'+pGrupoProd+'|'+pCodProd+'|'+vTemp );
    end;
  end;

  vNPed := 0;
  vExisteDevolucao := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vOK := True;
    if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
      (vItem.dataSet.FieldByName('tipo_ped').AsString = 'REQ') and
      (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
    begin
      for I := 0 to FDevolucao.Count - 1 do
      begin
        vTemp:= FDevolucao[i];
        pNped := copy(vTemp,1,Pos('|',vTemp) - 1);
        vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
        pGrupoProd := copy(vTemp,1,Pos('|',vTemp) - 1);
        vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
        pCodProd := copy(vTemp,1,Pos('|',vTemp) - 1);
        vTemp := copy(vTemp,Pos('|',vTemp) + 1, length(vTemp));
        pQuantidade := copy(vTemp,1,Pos('|',vTemp) - 1);
        vTemp := StringReplace(pQuantidade,'.','',[rfReplaceAll]);
        vValorTemp:= StrToFloat(pQuantidade);
        if (Trim(vItem.dataSet.FieldByName('nped').AsString) = Trim(pNped)) and
          (Trim(vItem.dataSet.FieldByName('grupo_prod').AsString) = Trim(pGrupoProd)) and
          (Trim(vItem.dataSet.FieldByName('cod_prod').AsString) = Trim(pCodProd)) and
          (vValorTemp > 0)
           then
        begin
          vValorTemp2 := vValorTemp - vItem.dataSet.FieldByName('quantidade').AsFloat;
          if (vItem.dataSet.FieldByName('quantidade').AsFloat <=
            vValorTemp) then
          begin
            vItem.Delete;
            vOK:=False;
          end
          else
          begin
            vItem.dataSet.Edit;
            if vItem.dataSet.FieldByName('rateio_desconto').AsFloat > 0 then
            begin
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat :=
                vItem.dataSet.FieldByName('rateio_desconto').AsFloat /
                vItem.dataSet.FieldByName('quantidade').AsFloat;
            end;
            vItem.dataSet.FieldByName('quantidade').AsFloat :=
              vItem.dataSet.FieldByName('quantidade').AsFloat -
                vValorTemp;
            if vItem.dataSet.FieldByName('rateio_desconto').AsFloat > 0 then
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat := vDadosIni.StrToFloatFormat(
                vItem.dataSet.FieldByName('rateio_desconto').AsFloat *
                vItem.dataSet.FieldByName('quantidade').AsFloat,2);
            vItem.dataSet.Post;
            vItem.alterar;
            calcularValorItemDesconto;
            calcularValores;
            if vItem.Edit then
            begin
              vItem.setDadosIntemNF();
              vItem.post;
            end;
            vItem.cancelar;
          end;
          if vValorTemp2 >= 0 then
          begin
            vTemp := StringReplace(FloatToStr(vValorTemp2),'.','',[rfReplaceAll])+'|';
            FDevolucao[i] :=( pNped+'|'+pGrupoProd+'|'+pCodProd+'|'+vTemp );
          end
          else
          begin
            vTemp := StringReplace(FloatToStr(0),'.','',[rfReplaceAll])+'|';
            FDevolucao[i] :=( pNped+'|'+pGrupoProd+'|'+pCodProd+'|'+vTemp );
          end;
          Break;
        end;
      end;
    end;
    if vOK then
      vItem.dataSet.Next;
  end;
//  vValorTemp := 0;
//  vItem.dataSet.First;
//  while not vItem.dataSet.Eof do
//  begin
//    vValorTemp := vValorTemp + vItem.dataSet.FieldByName('rateio_desconto').AsFloat;
//    vItem.dataSet.Next;
//  end;
  vItem.ajustaNItem;
  somaTotaisNF;
end;

function TNFCab.verificaFaturasEmCartao: Integer;
begin
  Result := -1;

  Exit;// desativado, pois agora é na forma de pagamento que a transacao é feita

  if vDadosIni.GetIni('TEF', 'POSVirtual', 'N') <> 'S' then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select natureza_nf, status, situacao_nfe from notafiscal' +
    ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
  buscas.Open;

  if (buscas.FieldByName('natureza_nf').AsString <> 'S') or (buscas.FieldByName('situacao_nfe').AsString <> sitAutorizada) or (buscas.FieldByName('status').AsString <> stsFechada) then
    Exit;

  buscas.Close;
  buscas.SQL.Text :=
    'select fp.tpdocs "Tipo Vnd", fp.nrequisicao "Num Vnd", fp.secao "Secao", fp.cod_terminal_adm "Term Adm",' +
    ' fp.n_aut_cart "Num Aut Cartao", fp.n_docnsu_adm "Num Doc Adm", coalesce(fp.tef, ''N'') tef, fp.Cod_Controle "Ctrl", count(fp.seqform) "Parcelas", sum(fp.valordoc) "Valor"' +
    ' from formpagamento fp' +
    ' inner join controles ctr on ctr.codigo_ctrl = fp.cod_controle and ctr.codigo_emp = fp.cod_empresa' +
//    ' left join transacao_cartao tc on tc.tpdocs = fp.tpdocs and tc.nrequisicao = fp.nrequisicao and tc.cod_empresa = fp.cod_empresa' +
//    ' and coalesce(tc.secao,0) = coalesce(fp.secao,0)
    ' where  fp.num_nota = :num_nf and fp.sub_serie =  :serie' +
    ' and fp.tpdocs <> ''LCS'' and fp.cod_empresa = :cod_empresa and fp.ativo = 1' +
    ' and ctr.tp_plano = ''C'' and ctr.docs = ''S2''' +
    ' group by 1,2,3,4,5,6,7,8';
  buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
  buscas.ParamByName('serie').AsInteger := StrToIntDef(Trim(dataSet.FieldByName('serie').AsString), 0);
  buscas.ParamByName('cod_empresa').AsInteger := dataSet.FieldByName('cod_empresa').AsInteger;
  buscas.Open;

  TFloatField(buscas.FieldByName('Valor')).DisplayFormat := DisplayNumber(2);

  buscas.FetchAll;
  buscas.First;
  while not buscas.Eof do
  begin
    if buscas.FieldByName('tef').AsString <> 'S' then
    begin
      Result := buscas.RecordCount;
      Exit;
    end;  
    buscas.Next;
  end;

  Result := 0;
end;

function TNFCab.verificaMargemProdutos(fechamento: boolean): boolean;
  procedure DefinirPrecos;
  begin
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin

      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin

        vItem.vProd.buscaProduto(vItem.fint('grupo_prod'), vItem.fstr('cod_prod'));

        vItem.dataSet.Edit;
        vItem.CalcularPrecoItemDataSet;
        {
        if (vItem.ffloat('prec_vnd_prod') > 0 ) and (vItem.vProd.ffloat('PERC_AD_30') > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
          vItem.dataSet.FieldByName('PREC_30_PROD').AsFloat := RoundTo(
            vItem.ffloat('prec_vnd_prod') +
            (vItem.ffloat('prec_vnd_prod') *
              vItem.vProd.ffloat('PERC_AD_30') / 100), -2);

        if (vItem.ffloat('prec_vnd_prod') > 0 ) and (vItem.vProd.ffloat('PERC_AD_60') > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
          vItem.dataSet.FieldByName('PREC_60_PROD').AsFloat := RoundTo(
            vItem.ffloat('prec_vnd_prod') +
            (vItem.ffloat('prec_vnd_prod') *
              vItem.vProd.ffloat('PERC_AD_60') / 100), -2);

        if (vItem.ffloat('prec_vnd_prod') > 0 ) and (vItem.vProd.ffloat('PERC_AD_90') > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
          vItem.dataSet.FieldByName('PREC_90_PROD').AsFloat := RoundTo(
            vItem.ffloat('prec_vnd_prod') +
            (vItem.ffloat('prec_vnd_prod') *
              vItem.vProd.ffloat('PERC_AD_90') / 100), -2);
              }
        vItem.dataSet.Post;

      end;

      vItem.dataSet.Next;
    end;

  end;
var
  formulario: TfrmPadrao;
begin
  try
  {
    if fechamento then
      if (vDadosIni.vProduto.Precos.UsarPercAdicional306090) and (vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF) then
        DefinirPrecos;
   }
    if Self.emEdicao then
      DefinirPrecos;

    vItem.vQrUltimasCompras := TIBQuery(dtmNF.qrUltimasCompras);
    vItem.dataSet.AfterScroll := vItem.AfterScrollResumo;
    //vItem.CalcUsandoMagem := TCfg_sis.getConf('nf_e_alteracao_preco', buscas, vDadosIni.cod_empresa).ReadString('Conf', 'TelaMargemTrocarCampoMarkupParaMargem') = 'S';

    if not vItem.FirstMargem then
    begin
      Result := True;
      exit;
    end;

    Application.CreateForm(TfrmCadNFPrecos, frmCadNFPrecos);
    frmCadNFPrecos.emFechamento := fechamento;
    frmCadNFPrecos.CadNf := Self;
    try
      Result := (frmCadNFPrecos.ShowModal = mrOk);
    finally
      frmCadNFPrecos.Free;
    end;
    {
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Definição de Preço de Venda dos Produtos - Margem';
    frmCadNF.Panel13.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    formulario.OnKeyDown := frmCadNF.FormMargemKeyDown;
    try
      frmCadNF.Label165.Caption := IfThen(vItem.CalcUsandoMagem, 'Margem', 'Markup');
      frmCadNF.Label102.Caption := frmCadNF.Label165.Caption;
      frmCadNF.btSalvaMargemObtida.Enabled := fechamento;
      if vDadosIni.vEmp.vCasasDecimais > 0 then
      begin
        frmCadNF.edPrecoV.FormatSize := '0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais);
        frmCadNF.edPrecoA.FormatSize := '0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais);
        frmCadNF.edPreco30.FormatSize := '0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais);
        frmCadNF.edPreco60.FormatSize := '0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais);
        frmCadNF.edPreco90.FormatSize := '0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais);
      end;
    except
    end;
    frmCadNF.BitBtn30Click(frmCadNF.BitBtn30);
    formulario.ShowModal; // = mrOk then
    formulario.OnKeyDown := nil;
    }
  finally
    vItem.dataSet.AfterScroll := vItem.AfterItemNf;
//    frmCadNF.Panel13.Parent := frmCadNF.tsMargem;
//    formulario.Free;
//    formulario := nil;
  end;
end;

