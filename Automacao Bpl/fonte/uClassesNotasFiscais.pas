function TNFCab.incluirItem: boolean;
begin
  try
    Result := False;
    if notaFechada then
      exit;
    if vItem.dataSet.RecordCount >= vDadosIni.vEmp.vQtdeProdNf then
      raise Exception.Create('Quantidade de Itens maior que o configurado no cadastro da Empresa');
    if vItem.dataSet.RecordCount >= 899 then
      raise Exception.Create('Quantidade de Itens maior que o Permitido 899');

    if vItem.vrDadosItem.tipo_item = 'O' then
      vItem.vrDadosItem.descricao_item := vItem.vrDadosItem.descricao_item_outras[0];
    if Trim(vItem.vrDadosItem.descricao_item) = '' then
      raiseExceptionCreate('Descrição do Item não informada', campos[9]);

    if fstrin('tipo_emissao', ['1', '4']) then
      if (vItem.vrDadosItem.quantidade <= 0) then//and (dataSet.FieldByName('tipo_emissao').AsString <> '2') and
        //(dataSet.FieldByName('complementar_ent').AsString <> 'S') then
        raiseExceptionCreate('Quantidade deve ser informada.', campos[1])
      else if (vItem.vrDadosItem.valor_unitario <= 0) then//and (dataSet.FieldByName('tipo_emissao').AsString <> '2') and
        //(dataSet.FieldByName('complementar_ent').AsString <> 'S') then
        raiseExceptionCreate('Valor Unitário deve ser informado.', campos[2]);

    if vDadosIni.vEmp.vCombProduto = 'S' then
      if dataSet.FieldByName('emissao_propria').AsString = 'S' then
        if notaFiscalDeCombustivel(IntToStr(Trunc(vItem.vrDadosItem.codigo_nop))) then
        begin
          if Trim(vItem.vrDadosItem.comb_cprodanp) = '' then
            raiseExceptionCreate('Código ANP deve ser informado.', campos[12]);
          if (vItem.vrDadosItem.comb_cide_qbcprod > 0) or (vItem.vrDadosItem.comb_cide_valiqprod > 0) or (vItem.vrDadosItem.comb_cide_vcide > 0) then
          begin
            if (vItem.vrDadosItem.comb_cide_valiqprod = 0) then
              raiseExceptionCreate('CIDE - Aliquota deve ser informada.', campos[13]);
            if (vItem.vrDadosItem.comb_cide_qbcprod = 0) then
              raiseExceptionCreate('CIDE - Base deve ser informada.', campos[14]);
            if (vItem.vrDadosItem.comb_cide_vcide = 0) then
              raiseExceptionCreate('CIDE - Valor deve ser informado.', campos[15]);
          end;
          if Trim(vItem.vrDadosItem.comb_descanp) = '' then
            raiseExceptionCreate('Descrição ANP deve ser informada', campos[16]);
        end;
    

    vCfop.selecionaCfop(Trunc(vItem.vrDadosItem.codigo_nop));
    if vCfop.dataSet.IsEmpty then
      raiseExceptionCreate('CFOP não encontrado', campos[10]);
//    vItem.vrDadosItem.desc_natop :=
//      vCfop.dataSet.FieldByName('DESCRICAO_NOP').AsString;
    vItem.vrDadosItem.altera_estoque_cfop :=
      vDadosIni.retornoPorCondicao(
        vCfop.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfop.dataSet.FieldByName('ALT_EST').AsString);//vCfop.dataSet.FieldByName('ALT_EST').AsString;
    vItem.vrDadosItem.altera_custo_cfop :=
      vCfop.dataSet.FieldByName('calc_custo').AsString;
    vItem.vrDadosItem.tipv_veiculo := vCfop.dataSet.FieldByName('tipv_veiculo').AsString;
    try
      vItem.vrDadosItem.CheckNCM(vItem.vrDadosItem.ncm);
      {
      if (dataSet.FieldByName('modelo_nf').AsString = '55') and
        (dataSet.FieldByName('tipo_nf').AsString <> 'V') then
      begin
        if Trim(vItem.vrDadosItem.ncm) = '' then
          raiseExceptionCreate('NCM/SH de preenchimento obrigatório. Informar o Gênero caso não saiba o NCM/SH completo', campos[11]);
        if length(Trim(vItem.vrDadosItem.ncm)) < 2 then
          raiseExceptionCreate('NCM/SH de preenchimento obrigatório. Gênero de deve ter 2 dígitos', campos[11]);
        if (Length(Trim(vItem.vrDadosItem.ncm)) <> 8) and
          (Length(Trim(vItem.vrDadosItem.ncm)) <> 2) then
          raiseExceptionCreate('NCM/SH deve ser preenchido por completo ou pelo Gênero (2 primeiros dígitos)', campos[11]);
      end;
      if (vItem.vrDadosItem.valor_ipi > 0) and
        (Length(Trim(vItem.vrDadosItem.ncm)) <> 8) then
        raiseexceptioncreate('NCM/SH deve ser preenchido por completo quando existir tributação de IPI', campos[11]);
      if vDadosIni.vEmp.vGerarSpedPISCOFINS = 'S' then
        if vItem.vrDadosItem.tipo_item = 'O' then
          if (Trim(vItem.vrDadosItem.ncm) = '00') then
            raiseExceptionCreate('NCM/SH deve ser diferente de "00" para previnir erros no SPED Contribuições', campos[11]);
      }

      if vItem.vrDadosItem.tipo_item = 'P' then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select grupo_prod, cod_prod from produtos' +
          ' where grupo_prod = ' + IntToStr(vItem.vrDadosItem.grupo_prod) +
          ' and cod_prod = ' + QuotedStr(vItem.vrDadosItem.cod_prod) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;

        if buscas.IsEmpty then
          raiseExceptionCreate('Produto não encontrado no cadastro' + sLineBreak +
            'Provavelmente o grupo ou código do produto tenha sido alterado', '');
      end;

    except
      on e: exception do begin
        if vItem.vrDadosItem.nped > 0 then
        begin
          Application.MessageBox(pchar(e.Message), 'Atenção', mb_ok + MB_ICONINFORMATION);
          if (vItem.vrDadosItem.tipo_item = 'P') then
            Application.MessageBox(pchar('Produto: ' +
              Trim(vItem.vrDadosItem.descricao_item) + sLineBreak +
              'Grupo: ' + IntToStr(vItem.vrDadosItem.grupo_prod) +
              ' - Código: ' + vItem.vrDadosItem.cod_prod +
              ' - Numero Fabricante: ' +
              vItem.vrDadosItem.num_fab_prod
              ), 'Atenção', mb_ok + MB_ICONINFORMATION)
          else if (vItem.vrDadosItem.tipo_item = 'S') then
            Application.MessageBox(pchar('Serviço: ' +
              Trim(vItem.vrDadosItem.descricao_item) + sLineBreak +
              'Código: ' + vItem.vrDadosItem.num_fab_prod
              ), 'Atenção', mb_ok + MB_ICONINFORMATION);
        end
        else
        begin
          Application.MessageBox(pchar('Erro ao Incluir Item na Nota Fiscal' + sLineBreak + 'Erro: ' +
            e.Message
            ), 'Atenção', mb_ok + MB_ICONINFORMATION);
          exit;
        end;
      end;
    end;
//    if (not vCfop.vCfopDesc.dataSet.IsEmpty) and (vCfop.vCfopDesc.dataSet.RecordCount > 1) then
//    begin
//      Application.CreateForm(TfrmEscolhaDescCFOP, frmEscolhaDescCFOP);
//      if frmEscolhaDescCFOP.ShowModal = mrOk then
//        vItem.vrDadosItem.desc_natop :=
//          vCfop.vCfopDesc.dataSet.FieldByName('DESCRICAO_NOP').AsString;
//      frmEscolhaDescCFOP.Free;
//      frmEscolhaDescCFOP := nil;
//    end;

    if vItem.Insert then
    begin
      vItem.dataSet.FieldByName('cod_nf').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
      vItem.dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
      vItem.vrDadosItem.nItem := vItem.dataSet.RecordCount + 1;
      if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      begin
        if vItem.vrDadosItem.cst_ipi = '' then
          if vItem.vrDadosItem.aliq_ipi > 0 then
            vItem.vrDadosItem.cst_ipi := '50'
          else
            vItem.vrDadosItem.cst_ipi := '52';
      end
      else
      begin
        if vItem.vrDadosItem.cst_ipi = '' then
          if vItem.vrDadosItem.aliq_ipi > 0 then
            vItem.vrDadosItem.cst_ipi := '00'
          else
            vItem.vrDadosItem.cst_ipi := '02'
      end;
      vItem.setDadosIntemNF();
      vItem.calcucarReconposicaoDeICMS(Self);
      Result := vItem.post;
      vItem.ajustaNItem;
      if (vItem.vrDadosItem.peso_b > 0) and (dataSet.State in [dsedit, dsInsert]) then
        dataSet.FieldByName('peso_b').AsFloat := dataSet.FieldByName('peso_b').AsFloat +
          (vItem.vrDadosItem.peso_b * vItem.vrDadosItem.quantidade);
      if (vItem.vrDadosItem.peso_l > 0) and (dataSet.State in [dsedit, dsInsert]) then
        dataSet.FieldByName('peso_l').AsFloat := dataSet.FieldByName('peso_l').AsFloat +
          (vItem.vrDadosItem.peso_l * vItem.vrDadosItem.quantidade);
    end;
    //    somaTotaisNF;
    vItem.cancelar;
    vCfop.selecionaCfop(Trunc(dataSet.FieldByName('codigo_nop').AsFloat));
  except
    on e: exception do begin
      Application.MessageBox(pchar('Erro ao Incluir Item na Nota Fiscal' + sLineBreak + 'Erro: ' + e.Message
        ), 'Atenção', mb_ok + MB_ICONINFORMATION);
      exit;
    end;
  end;
end;

