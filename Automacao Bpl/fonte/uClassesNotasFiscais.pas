function TNFItem.verificaChassiEntrada(nota: TNFCab): boolean;
var
  vBreak: Boolean;
  vSqlTem: WideString;
begin
  //Ao sair do campo de CFOP da nota fiscal alterar o cfop do item.
  if nota.campo_natureza_nf = 'S' then
  begin
    result := true;
    exit;
  end;
  try
    if (vDadosIni.vEmp.vVersaoVeiculos = '4') and (dataSet.FieldByName('tipo_item').AsString = 'V') then
    begin
      vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
      dataSet.FieldByName('tipv_veiculo').AsString := vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString;
    end;
    if Trim(dataSet.FieldByName('chassi').AsString) = '' then
      raise exception.create('Chassi não informado');
//    if Trim(dataSet.FieldByName('chassi').OldValue) <> Trim(dataSet.FieldByName('chassi').NewValue)
//      then
    if (trim(vChassi) <> trim(dataSet.FieldByName('CHASSI').AsString))
	    or (trim(vTipoV) <> trim(vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString)) then
    begin
      vChassi := dataSet.FieldByName('CHASSI').AsString;
      vTipoV := trim(vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString);
      dataSet.post;
      dataset.edit;
      //Verificando veiculo em transferencia
      try

        if (vDadosIni.vEmp.vVersaoVeiculos = '4') and (dataSet.FieldByName('tipo_item').AsString = 'V') then
        begin
          buscas.close;
          buscas.SQL.Text := ' select placaest, versaoest, descricao_versaoest, ' +
            ' cod_marca, marcaest, cod_combustivel, combustivelest, ' +
        		' cod_cor, corest, cod_fornecedor, ano_fabest, ano_modest, cilindradaest, cilindrosest, ' +
        		' hpest, preco_custo, preco_custo_rep, preco_custo_desp, cod_cliente, ' +
        		' perc_red, red_lucro, preco_tabest, preco_sug_vnd, vl_compra, estoque, ' +
        		' lotacaoest, motorest, cod_espe_seg, renavamest, status_uso, tipoest, ' +
            ' status_transdep, data_trans_ret, tipv_veiculo from est_moto' +
            ' where chassi_c = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
            ' and ativo = 1 order by cod_empresa, codigo desc ';
          buscas.Open;

          if buscas.IsEmpty then
          begin
            buscas.close;
            buscas.SQL.Text := ' select placa as placaest, modelo versaoest, descmodelo as descricao_versaoest, ' +
              ' cod_marca, marca_v as marcaest, cod_combustivel, combustivel as combustivelest, ' +
              ' cod_cor, cor as corest, null as cod_fornecedor, anofab as ano_fabest, anomod as ano_modest, ' +
              ' cilindrada as cilindradaest, cilindros as cilindrosest, ' +
              ' hp as hpest, null preco_custo, null preco_custo_rep, null preco_custo_desp, ' +
              ' cod_cliente, null perc_red, null red_lucro, null preco_tabest, null preco_sug_vnd, ' +
              ' null vl_compra, ''T'' estoque, lotacao as lotacaoest, motor as motorest, ' +
              ' cod_espe_seg, renavam as renavamest, ''U'' status_uso, especie as tipoest, ' +
              ' null status_transdep, null data_trans_ret, null tipv_veiculo from veiculos ' +
              ' where chassi = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
              ' and ativo = 1 order by cod_empresa, codigo desc ';
            buscas.Open;
          end;

          if (trim(buscas.FieldByName('STATUS_TRANSDEP').AsString) = 'S')
            and (buscas.FieldByName('DATA_TRANS_RET').IsNull)
            and (trim(dataSet.FieldByName('TIPV_VEICULO').AsString) <> 'T') then
          begin
           if Application.MessageBox(
              'O Cfop do veículo encontrado não está configurado como recebimento de transferência, deseja configurar agora?',
              'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
              if nota.dataSet.State in [dsInsert, dsEdit] then
              begin
                nota.dataSet.FieldByName('codigo_nop').AsString :=
                  Copy(nota.dataSet.FieldByName('codigo_nop').AsString, 1, 1) + '409';
                if not(dataSet.State in [dsInsert, dsEdit])  then
                  dataSet.Edit;
                dataSet.FieldByName('codigo_nop').AsString := nota.dataSet.FieldByName('codigo_nop').AsString;
                vCfopIt.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));
                dataSet.FieldByName('tipv_veiculo').AsString := vCfopIt.dataSet.FieldByName('tipv_veiculo').AsString;
                vSqlTem := buscas.SQL.Text;
                nota.exitCodigoTabela('NAT_OP');
                buscas.close;
                buscas.SQL.Text := vSqlTem;
                buscas.Open;
              end;
          end;

          vBreak := False;
          buscas.First;
          while not buscas.eof do
          begin
//            if (buscas.FieldByName('chassiv').AsString = dataSet.FieldByName('chassi').AsString) and
//              (buscas.FieldByName('NF_FIL').AsInteger = nota.dataSet.FieldByName('num_nf').AsInteger)
//              then
            begin
            	vDetVeic.Edit;
              vDetVeic.dataSet.FieldByName('versao').AsInteger :=
                buscas.FieldByName('versaoest').AsInteger;
              if vDetVeic.vModV.abreModelos(
                vDetVeic.dataSet.FieldByName('versao').AsInteger) then
                verificaModeloVeiculo(nota);
              vDetVeic.vModV.abreModelos;
              vDetVeic.dataSet.FieldByName('chassi').AsString :=
                Trim(dataSet.FieldByName('chassi').AsString);
              if trim(vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString) <> 'N' then
                vDetVeic.dataSet.FieldByName('PLACA').AsString :=  Trim(buscas.FieldByName('placaest').AsString)
              else
                vDetVeic.dataSet.FieldByName('PLACA').AsString := '';
//              vDetVeic.dataSet.FieldByName('tipo_venda').AsString :=
//              	Trim(buscas.FieldByName('status_uso').AsString);
              vDetVeic.dataSet.FieldByName('MARCA').AsString :=
                Trim(buscas.FieldByName('marcaest').AsString);
              vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString :=
                Trim(buscas.FieldByName('descricao_versaoest').AsString);
              vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger :=
                buscas.FieldByName('ano_fabest').AsInteger;
              vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger :=
                buscas.FieldByName('ano_modest').AsInteger;
              vDetVeic.dataSet.FieldByName('COR').AsString :=
                Trim(buscas.FieldByName('corest').AsString);
              vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger :=
                buscas.FieldByName('cilindrosest').AsInteger;
              vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString :=
                Trim(buscas.FieldByName('combustivelest').AsString);
              vDetVeic.dataSet.FieldByName('CILINDRADA').AsFloat :=
                buscas.FieldByName('cilindradaest').AsFloat;
              vDetVeic.dataSet.FieldByName('HP').AsFloat :=
                buscas.FieldByName('hpest').AsFloat;
              vDetVeic.dataSet.FieldByName('LOTACAO').AsString :=
                Trim(buscas.FieldByName('lotacaoest').AsString);
              vDetVeic.dataSet.FieldByName('tipo').AsString :=
                Trim(buscas.FieldByName('tipoest').AsString);
              vDetVeic.dataSet.FieldByName('renavam').AsString :=
                Trim(buscas.FieldByName('renavamEST').AsString);
              if (trim(dataSet.FieldByName('tipv_veiculo').AsString) = 'D') then
                vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat := dataSet.FieldByName('VALOR_UNITARIO').AsFloat
              else if not buscas.FieldByName('PRECO_TABEST').IsNull then
                vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat := buscas.FieldByName('PRECO_TABEST').AsFloat;
              vDetVeic.dataSet.FieldByName('MOTOR').AsString :=
                Trim(buscas.FieldByName('MOTOREST').AsString);
              vDetVeic.dataSet.FieldByName('FRETE_AQUISICAO').AsFloat := 0;
              vDetVeic.dataSet.FieldByName('FRETE_VENDA').AsFloat := 0;
              vDetVeic.dataSet.FieldByName('OBS_ITEM').AsString := '';
              vDetVeic.dataSet.FieldByName('CERTIFICADO').AsString := '';
              vDetVeic.dataSet.FieldByName('DATA_CERTIFICADO').AsString := '';
              vDetVeic.dataSet.FieldByName('CATEGORIA').AsString := '';
              //              vDetVeic.dataSet.FieldByName('NF_AQ').AsString :=nota.dataSet.FieldByName('NUM_NF').AsString;
              //              vDetVeic.dataSet.FieldByName('SERIE_AQ').AsString :=nota.dataSet.FieldByName('SERIE').AsString;
              vDetVeic.dataSet.FieldByName('DAT_CADM').AsString :=
                nota.dataset.fieldByName('data_lanc').AsString;
              if (vDetVeic.dataSet.FieldByName('TIPO_VENDA').IsNull) or (trim(vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString) = '') then
                vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString := 'N';
              vDetVeic.dataSet.FieldByName('ESTOQUE').AsString := 'S';
              dataset.FieldByName('base_icmsub').AsFloat := 0;
              dataset.FieldByName('valor_icmsub').AsFloat := 0;
              dataset.FieldByName('valor_icm_stdes').AsFloat := 0;
              if (trim(dataSet.FieldByName('TIPV_VEICULO').AsString) = 'T') and (not buscas.FieldByName('PRECO_TABEST').IsNull) then
                dataset.FieldByName('valor_unitario').AsFloat := buscas.FieldByName('PRECO_TABEST').AsFloat
              else
                dataset.FieldByName('valor_unitario').Value := Null;
              dataset.FieldByName('base_icmsub').AsFloat := 0;
              verificaCorDescricao;
              vBreak := True;
              Break;
            end;
            buscas.Next;
          end;
//          if not vBreak then
//            raise Exception.Create('Chassi não encontrado no Depósito para este número de NF ')
        end
        else
        begin
          buscas.close;
          buscas.SQL.Text := 'select * from TRANSF_DEP' +
            ' WHERE CHASSIV = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
            ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
            ' AND ATIVO = 1 AND DATA_TRANS_RET IS NULL';
          buscas.Open;

          if buscas.IsEmpty then
          begin
            if Application.MessageBox(
              pchar('Chassi não encontrado no depósito desta empresa.'+sLineBreak+
                'Deseja procurar em outras empresas?'),
              'Confirmação', MB_ICONQUESTION + MB_YESNO ) = IDYES then
            begin

              buscas.close;
              buscas.SQL.Text := 'select * from TRANSF_DEP' +
                ' WHERE CHASSIV = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
                ' AND ATIVO = 1 AND DATA_TRANS_RET IS NULL';
              buscas.Open;

            end;

          end;
          if buscas.IsEmpty then
          begin
            if (dataSet.FieldByName('codigo_nop').AsFloat = 1409)
              or (dataSet.FieldByName('codigo_nop').AsFloat = 2409) then
              raise exception.create('Chassi não encontrado em nenhum Depósito');
          end
          else
          begin
            if (dataSet.FieldByName('codigo_nop').AsFloat <> 1409)
              and (dataSet.FieldByName('codigo_nop').AsFloat <> 2409) then
              if Application.MessageBox(
                'O Cfop não está configurado como recebimento de transferência, deseja configurar agora?',
                'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
                if nota.dataSet.State in [dsInsert, dsEdit] then
                begin
                  nota.dataSet.FieldByName('codigo_nop').AsString :=
                    Copy(nota.dataSet.FieldByName('codigo_nop').AsString, 1, 1) + '409';
                  if not(dataSet.State in [dsInsert, dsEdit])  then
                    dataSet.Edit;
                  dataSet.FieldByName('codigo_nop').AsString := nota.dataSet.FieldByName('codigo_nop').AsString;
                  vSqlTem := buscas.SQL.Text;
                  nota.exitCodigoTabela('NAT_OP');
                  buscas.close;
                  buscas.SQL.Text := vSqlTem;
                  buscas.Open;
                end;
            vBreak := False;
            buscas.First;
            while not buscas.eof do
            begin
  //            if (buscas.FieldByName('chassiv').AsString = dataSet.FieldByName('chassi').AsString) and
  //              (buscas.FieldByName('NF_FIL').AsInteger = nota.dataSet.FieldByName('num_nf').AsInteger)
  //              then
              begin
                vDetVeic.Edit;
                vDetVeic.dataSet.FieldByName('VERSAO').AsInteger :=
                  buscas.FieldByName('versaov').AsInteger;
                if vDetVeic.vModV.abreModelos(
                  vDetVeic.dataSet.FieldByName('VERSAO').AsInteger) then
                  verificaModeloVeiculo(nota);
                vDetVeic.vModV.abreModelos;
                vDetVeic.dataSet.FieldByName('CHASSI').AsString :=
                  Trim(dataSet.FieldByName('chassi').AsString);
                vDetVeic.dataSet.FieldByName('MARCA').AsString :=
                  Trim(buscas.FieldByName('marcav').AsString);
                vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString :=
                  Trim(buscas.FieldByName('descricao_versaov').AsString);
                vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger :=
                  buscas.FieldByName('ano_fabv').AsInteger;
                vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger :=
                  buscas.FieldByName('ano_modv').AsInteger;
                vDetVeic.dataSet.FieldByName('COR').AsString :=
                  Trim(buscas.FieldByName('corv').AsString);
                vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger :=
                  buscas.FieldByName('cilindrosv').AsInteger;
                vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString :=
                  Trim(buscas.FieldByName('combustivelv').AsString);
                vDetVeic.dataSet.FieldByName('CILINDRADA').AsFloat :=
                  buscas.FieldByName('cilindradav').AsFloat;
                vDetVeic.dataSet.FieldByName('HP').AsFloat :=
                  buscas.FieldByName('hpv').AsFloat;
                vDetVeic.dataSet.FieldByName('LOTACAO').AsString :=
                  Trim(buscas.FieldByName('lotacaoV').AsString);
                vDetVeic.dataSet.FieldByName('TIPO').AsString :=
                  Trim(buscas.FieldByName('TIPOV').AsString);
                vDetVeic.dataSet.FieldByName('RENAVAM').AsString :=
                  Trim(buscas.FieldByName('RENAVAMV').AsString);
                vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat :=
                  buscas.FieldByName('PRECO_TABV').AsFloat;
                vDetVeic.dataSet.FieldByName('FRETE_AQUISICAO').AsFloat := 0;
                vDetVeic.dataSet.FieldByName('FRETE_VENDA').AsFloat := 0;
                vDetVeic.dataSet.FieldByName('OBS_ITEM').AsString := '';
                vDetVeic.dataSet.FieldByName('MOTOR').AsString :=
                  Trim(buscas.FieldByName('MOTORV').AsString);
                vDetVeic.dataSet.FieldByName('PLACA').AsString := '';
                vDetVeic.dataSet.FieldByName('CERTIFICADO').AsString := '';
                vDetVeic.dataSet.FieldByName('DATA_CERTIFICADO').AsString := '';
                vDetVeic.dataSet.FieldByName('CATEGORIA').AsString := '';
                //              vDetVeic.dataSet.FieldByName('NF_AQ').AsString :=nota.dataSet.FieldByName('NUM_NF').AsString;
                //              vDetVeic.dataSet.FieldByName('SERIE_AQ').AsString :=nota.dataSet.FieldByName('SERIE').AsString;
                vDetVeic.dataSet.FieldByName('DAT_CADM').AsString :=
                  nota.dataset.fieldByName('data_lanc').AsString;
                if (vDetVeic.dataSet.FieldByName('TIPO_VENDA').IsNull) or (trim(vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString) = '') then
                  vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString := 'N';
                vDetVeic.dataSet.FieldByName('ESTOQUE').AsString := 'S';
                dataset.FieldByName('base_icmsub').AsFloat := 0;
                dataset.FieldByName('valor_icmsub').AsFloat := 0;
                dataset.FieldByName('valor_icm_stdes').AsFloat := 0;
                dataset.FieldByName('valor_unitario').AsFloat :=
                  buscas.FieldByName('PRECO_TABV').AsFloat;
                dataset.FieldByName('base_icmsub').AsFloat := 0;
                verificaCorDescricao;
                vBreak := True;
                Break;
              end;
              buscas.Next;
            end;
            if not vBreak then
              raise Exception.Create('Chassi não encontrado no Depósito para este número de NF ');
          end;
        end;
      finally
        buscas.close;
      end;
    end;

    if not verificaExistenciaVeiculo then
    begin
      Result := False;
      exit;
    end;
//    if dataset.FieldByName('valor_unitario').AsFloat = 0 then
//      dataset.FieldByName('valor_unitario').AsFloat :=
//        nota.Dataset.FieldByName('valor_prod').AsFloat;
    //Verificando veiculo no estoque de motos usadas
    Result := True;
  except
    on e: Exception do
    begin
      Result := false;
      Application.messagebox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('COD NF: E ' +
        dataSet.FieldByName('cod_nf').AsString + ' verificaChassiEntrada' + e.Message);
    end;
  end;

end;

function TNFItem.verificaCorDenatram(pCod: Integer): Boolean;
var
  buscas2: TIBQuery;
  vCampo: string;
begin
  Result := False;
  if not (vDetVeic.dataSet.state in [dsInsert, dsEdit]) then
    Exit;
  buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
  buscas2.CLose;
  if Trim(vDadosIni.vEmp.vUsarCorFabDenatran) = 'D' then
    vCampo := 'CODCORDENATRAM'
  else
    vCampo := 'COD_COR';
  buscas2.Sql.Text := ' select * from codigo_corfab ' +
     ' where ' + vCampo + ' = ' + IntToStr(pCod) + ' and ativo = 1';
  buscas2.Open;
  if not buscas2.isempty then
  begin
    vDetVeic.dataSet.FieldByName('COD_COR').AsInteger := buscas2.fieldbyname('COD_COR').AsInteger;
    vDetVeic.dataSet.FieldByName('TIP_PINTURA').AsString := buscas2.fieldbyname('TIPO_PINTURA').AsString;
    vDetVeic.dataSet.FieldByName('COR').AsString := buscas2.fieldbyname('DESCRICAO_COR').AsString;
    Result := True;
  end;
  buscas2.close;
end;

function TNFItem.verificaCorDescricao: boolean;
var
  buscas2: TIBQuery;
begin
  if not (vDetVeic.dataSet.state in [dsInsert, dsEdit]) then
    Exit;
  buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
  buscas2.CLose;
  buscas2.Sql.Text := ' select * from codigo_corfab ' +
