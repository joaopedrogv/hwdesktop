        if vItem.vDetEcf.dataSet.FieldByName('COD_NSERIE').AsInteger =
          vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('COD_NSERIE').AsInteger then
        begin
          vOK := True;
          vItem.vDetEcf.dataSet.Edit;
          Break;
        end;

        vItem.vDetEcf.dataSet.Next;
      end;
      if not vOK then
        vItem.vDetEcf.dataSet.Insert;
      vOK := True;
    end;

    if vOK then
    begin
      vItem.vDetEcf.dataSet.FieldByName('cod_nf').AsInteger :=
