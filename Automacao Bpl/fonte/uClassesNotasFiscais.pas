      begin
        buscas.ParamByName('VL_COMPRA_US').AsFloat := dataSet.FieldByName('VALOR_TOTAL').AsFloat;
        buscas.ParamByName('ESTOQUE').AsString := 'S';
        buscas.ParamByName('ESPECIE_US').AsString :=
          vItem.vDetVeic.dataSet.FieldByName('TIPO').AsString;
        buscas.ParamByName('DATCAD_US').AsDate := FDataDoDia;
        vCodVeiculo := Gencodigo('MTUSADAS', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
      end;
      buscas.ParamByName('CODIGO').AsInteger := vCodVeiculo;
      buscas.Prepare;
      buscas.ExecSQL;

      vItem.dataSet.Next;
    end;

    Result := True;
  except
    on e: Exception do begin
      Result := false;
      Application.messagebox(pchar('Erro ao entrar com Veículo no estoque.' + sLineBreak + 'Erro: ' +
        e.Message), 'Atenção', 0 + 64);
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoqueVeiculo ' + e.Message);
    end;
  end;
end;

function TNFCab.EntrarComEstoqueVeiculoCCIA: boolean;
var
  vCodVeiculo, vCodDepart, vCodBalanco, vQtdeRenovRes: integer;
  vChassi, vStatusDemonst: string;
  vFoneRes, vObsRes, vTipoRes, vDataAssembleia, vDataRes, vHoraRes,
  vDataVencRes, vHoraVencRes, vTipoVenda, vStatusRes, vNomeRes, vSitRes, vGrupoCotaRed, vStatusRenovRes: string;
  vVendedorRes, vCodCliente, vCondCondPag, vCodFilaRes, vCodEmpRes: integer;
  vtemReserva, vDemonstr, vTransito: boolean;
  buscas2, buscas3: TIBQuery;
  vPrecoSugVnd: Double;
  vDataResD, vDataVencResD, vDataAssembleiaD: TDateTime;
  vHoraResD, vHoraVencResD: string;
  vTipoResT, vGrupoCotaRDT, vDataVencT, vHoraVencT, vDataAssembleiaT: Variant;
  I: Integer;
begin
  Result := False;

  if vDadosIni.vEmp.vVersaoVeiculos <> '4' then
   exit;

  try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas3 := TIBQuery.Create(Application);
    buscas3.Database := buscas.Database;
    buscas3.Transaction := buscas.Transaction;

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vItem.vDetVeic.dataSet.First;
      while not vItem.vDetVeic.dataSet.Eof do
      begin
        if vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger =
          vItem.dataSet.FieldByName('nitem').AsInteger then
          Break;
        vItem.vDetVeic.dataSet.Next;
      end;

      vStatusDemonst := '';

      if (dataset.FieldByName('natureza_nf').Asstring = 'E') and
         (vItem.dataSet.FieldByName('tipv_veiculo').AsString = 'R') then
      begin
        buscas.Close;
        buscas.Sql.Text := ' select cf.cod_estmoto, cf.chassiv, est.status_demonst from com_fat cf ' +
          ' left join est_moto est ' +
          ' on est.codigo = cf.cod_estmoto and est.chassi_c = cf.chassiv and est.cod_empresa = cf.cod_empresa ' +
          ' where cf.num_nota_v = ' + dataset.fieldbyname('num_nf_emt').asstring +
          ' and cf.serie = ' + QuotedStr(dataset.fieldbyname('serie_emt').asstring)+
          ' and cf.cod_empresa = '+vDadosIni.codEmpresa;
        buscas.Open;

        if not buscas.IsEmpty then
        begin
          vCodVeiculo := buscas.FieldByName('COD_ESTMOTO').AsInteger;
          vChassi := trim(buscas.FieldByName('CHASSIV').AsString);
          vStatusDemonst := trim(buscas.FieldByName('STATUS_DEMONST').AsString);

          buscas.Close;
          buscas.Sql.Text := 'update com_fat set situacao = ''RETORNADO'' ' +
            ' where num_nota_v = ' + dataset.fieldbyname('num_nf_emt').asstring +
            ' and serie = ' + QuotedStr(dataset.fieldbyname('serie_emt').asstring)+
            ' and cod_empresa = '+vDadosIni.codEmpresa;
          buscas.ExecSql;

          buscas.Close;
          buscas.Sql.Text := 'update est_moto set status_demonst = ''N'', situacao = ''''' +
            ' where chassi_c = ' + QuotedStr(vChassi) +
            ' and codigo = ' + IntToStr(vCodVeiculo) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSql;
        end;
      end;

      Result := True;
      if { (notaFiscalDeRetorno) or } (dataset.FieldByName('natureza_nf').Asstring <> 'E') then
      begin
        vItem.dataSet.Next;
        continue;
      end;

      buscas.Close;
      buscas.Sql.Text := 'SELECT FIRST 1 * FROM EST_MOTO ' +
        ' WHERE CHASSI_C = '+QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString)) +
        ' AND (TRIM(COALESCE(POSICAO, ''VIVO'')) <> ''MORTO'') ' +
        ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
         if ((trim(buscas.FieldByName('STATUS_USO').AsString) = Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString)) and (buscas.FieldByName('NUM_NOTA').AsInteger <= 0))
         or ((buscas.FieldByName('NUM_NOTA').AsInteger > 0) and (trim(buscas.FieldByName('POSICAO').AsString) = 'TRANSITO'))
         or ((trim(buscas.FieldByName('STATUS_USO').AsString) = Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString)) and
           (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'R')) then// and (trim(vStatusDemonst) = 'S')) then
         begin
           vCodVeiculo := buscas.FieldByName('CODIGO').AsInteger;
           vChassi := buscas.FieldByName('CHASSI_C').AsString;
           vPrecoSugVnd := buscas.FieldByName('PRECO_SUG_VND').AsFloat;
           vDataResD := vDadosIni.getDataBanco(buscas2);
           vHoraResD := FormatDateTime('HH:MM', vDadosIni.getDataHoraBanco(buscas2));
           vDataAssembleiaD := buscas.FieldByName('DATA_ASSEMBLEIA').AsDateTime;
           vtemReserva := trim(buscas.FieldByName('STATUS_RES').AsString) = 'S';

           if vtemReserva then
             vDadosIni.RetornaDataHoraVenc(buscas3,
               'VIVO',
               buscas.FieldByName('TIPO_RES').AsString,
               buscas.FieldByName('GRUPO_COTA_RD').AsString,
               vDataResD,
               vHoraResD,
               vDataAssembleiaD,
               vTipoResT, vGrupoCotaRDT, vDataVencT, vHoraVencT, vDataAssembleiaT);

           if not (vItem.vDetVeic.dataSet.State in [dsInsert, dsEdit]) then
             vItem.vDetVeic.Edit;
           vItem.vDetVeic.dataSet.FieldByName('COD_ESTMOTO').AsInteger := vCodVeiculo;
           vItem.vDetVeic.Post;

           if not (vItem.dataSet.State in [dsInsert, dsEdit]) then
             vItem.dataSet.Edit;
           vItem.dataSet.FieldByName('COD_ESTMOTO').AsInteger := vCodVeiculo;
           vItem.dataSet.Post;

           buscas.Close;
           buscas.Sql.Text := ' UPDATE EST_MOTO SET TIPV_VEICULO = :TIPV_VEICULO, STATUS_DEMONST = :STATUS_DEMONST, ' +
             ' COD_NF = :COD_NF, NUM_NOTA = :NUM_NOTA, SERIE = :SERIE, ' +
             ' MODELO_NF = :MODELO_NF, DATA_CH_NOTA = :DATA_CH_NOTA ';
           if vtemReserva then
             buscas.SQL.Text := buscas.SQL.Text + ', DATA_RES = :DATA_RES, HORA_RES = :HORA_RES, ' +
             ' DATA_VENC_RES = :DATA_VENC_RES, HORA_VENC_RES = :HORA_VENC_RES ';
           if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'V') then
             buscas.SQL.Text := buscas.SQL.Text + ', US_CAD = :US_CAD, DATA_CAD = :DATA_CAD, HORA_CAD = :HORA_CAD ';
           if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString <> 'R') then
             buscas.SQL.Text := buscas.SQL.Text + ', MARCAEST = :MARCAEST, VERSAOEST = :VERSAOEST, ANO_FABEST = :ANO_FABEST, ANO_MODEST = :ANO_MODEST, ' +
              ' COREST = :COREST, CILINDROSEST = :CILINDROSEST, COMBUSTIVELEST = :COMBUSTIVELEST, ' +
              ' CILINDRADAEST = :CILINDRADAEST, HPEST = :HPEST, LOTACAOEST = :LOTACAOEST, TIPOEST = :TIPOEST, ' +
              ' RENAVAMEST = :RENAVAMEST, PRECO_TABEST = :PRECO_TABEST, PRECO_SUG_VND = :PRECO_SUG_VND, ' +
              ' OBS_ITEMEST = :OBS_ITEMEST, MOTOREST = :MOTOREST, ' +
              ' PLACAEST = :PLACAEST, CERTIFICADOEST = :CERTIFICADOEST, DATA_CERTIFICADOEST = :DATA_CERTIFICADOEST, ' +
              ' CATEGORIAEST = :CATEGORIAEST, TIP_PINTURA = :TIP_PINTURA, NSERIE = :NSERIE, ' +
              ' COD_COR = :COD_COR, BASE_CALC_ICM_SUBEST = :BASE_CALC_ICM_SUBEST, FRETE_AQUISICAOEST = :FRETE_AQUISICAOEST, ' +
              ' FRETE_VENDAEST = :FRETE_VENDAEST, VALOR_ICM_SUBEST = :VALOR_ICM_SUBEST, SITUACAO = :SITUACAO, ' +
              ' COD_FORNECEDOR = :COD_FORNECEDOR, TIPO_VENDA = :TIPO_VENDA, DESCRICAO_VERSAOEST = :DESCRICAO_VERSAOEST, ' +
              ' PRECO_CUSTO = :PRECO_CUSTO, PRECO_CUSTO_REP = :PRECO_CUSTO_REP, PRECO_CUSTO_DESP = :PRECO_CUSTO_DESP, ' +
              ' STATUS_ESTOQUE = :STATUS_ESTOQUE, STATUS_TRANSDEP = :STATUS_TRANSDEP, ' +
              ' STATUS_USO = :STATUS_USO, POSICAO = :POSICAO, COD_MARCA = :COD_MARCA, ' +
              ' COD_COMBUSTIVEL = :COD_COMBUSTIVEL, COD_ESPE_SEG = :COD_ESPE_SEG, ' +
              ' ESTOQUE = :ESTOQUE, PERC_RED = :PERC_RED, RED_LUCRO = :RED_LUCRO ';
           buscas.SQL.Text := buscas.SQL.Text +
             ' WHERE CHASSI_C = :CHASSI AND CODIGO = :CODIGO AND COD_EMPRESA = :COD_EMPRESA ';
           buscas.ParamByName('CHASSI').AsString := vChassi;
           buscas.ParamByName('CODIGO').AsInteger := vCodVeiculo;
           buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
           buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
           buscas.ParamByName('NUM_NOTA').AsInteger := dataSet.FieldByName('NUM_NF').AsInteger;
           buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('SERIE').AsString;
           buscas.ParamByName('MODELO_NF').AsString := dataSet.FieldByName('MODELO_NF').AsString;
           buscas.ParamByName('DATA_CH_NOTA').AsString := dataSet.FieldByName('DATA_LANC').AsString;
           buscas.ParamByName('TIPV_VEICULO').AsString := vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString;
           buscas.ParamByName('STATUS_DEMONST').AsString := 'N';
           if vtemReserva then
           begin
             buscas.ParamByName('DATA_RES').AsDateTime := vDataResD;
             buscas.ParamByName('HORA_RES').AsString := vHoraResD;
             buscas.ParamByName('DATA_VENC_RES').Value := vDataVencT;
             buscas.ParamByName('HORA_VENC_RES').Value := vHoraVencT;
           end;

           if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString <> 'R') then
           begin
             buscas.ParamByName('COD_MARCA').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_MARCA').AsInteger;
             buscas.ParamByName('COD_COMBUSTIVEL').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_COMBUSTIVEL').AsInteger;
             buscas.ParamByName('COD_ESPE_SEG').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_TIPO_ESP').AsInteger;
             buscas.ParamByName('POSICAO').AsString := 'VIVO';
             if (vItem.dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString = 'N')
              or (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'C')
              or (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'A')
              or (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'D') then
               buscas.ParamByName('STATUS_ESTOQUE').AsString := 'N'
             else
               buscas.ParamByName('STATUS_ESTOQUE').AsString := 'S';

             if (vDadosIni.vEmp.vTipoEmpVeiculos <> 'A') then
                 buscas.ParamByName('ESTOQUE').AsString := 'P';

             buscas.ParamByName('STATUS_TRANSDEP').AsString := 'N';
             buscas.ParamByName('MARCAEST').AsString := copy(vItem.vDetVeic.dataSet.FieldByName('MARCA').AsString, 1, 32);
             buscas.ParamByName('VERSAOEST').AsInteger := vItem.vDetVeic.dataSet.FieldByName('VERSAO').AsInteger;
             buscas.ParamByName('ANO_FABEST').AsInteger := vItem.vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger;
             buscas.ParamByName('ANO_MODEST').AsInteger := vItem.vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger;
             buscas.ParamByName('COREST').AsString := vItem.vDetVeic.dataSet.FieldByName('COR').AsString;
             buscas.ParamByName('CILINDROSEST').AsInteger := vItem.vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger;
             buscas.ParamByName('COMBUSTIVELEST').AsString := vItem.vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString;
             buscas.ParamByName('CILINDRADAEST').AsFloat := vItem.vDetVeic.dataSet.FieldByName('CILINDRADA').AsFloat;
             buscas.ParamByName('HPEST').AsFloat := vItem.vDetVeic.dataSet.FieldByName('HP').AsFloat;
             buscas.ParamByName('LOTACAOEST').AsString := vItem.vDetVeic.dataSet.FieldByName('LOTACAO').AsString;
             buscas.ParamByName('TIPOEST').AsString := vItem.vDetVeic.dataSet.FieldByName('TIPO').AsString;
             buscas.ParamByName('RENAVAMEST').AsString := vItem.vDetVeic.dataSet.FieldByName('RENAVAM').AsString;
             buscas.ParamByName('PRECO_TABEST').AsFloat := vItem.vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat;
             if vPrecoSugVnd > 0 then
               buscas.ParamByName('PRECO_SUG_VND').AsFloat := vPrecoSugVnd
             else
               buscas.ParamByName('PRECO_SUG_VND').AsFloat := vItem.vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat;
             buscas.ParamByName('OBS_ITEMEST').AsString := vItem.vDetVeic.dataSet.FieldByName('OBS_ITEM').AsString;
             buscas.ParamByName('MOTOREST').AsString := vItem.vDetVeic.dataSet.FieldByName('MOTOR').AsString;
             buscas.ParamByName('PLACAEST').AsString := vItem.vDetVeic.dataSet.FieldByName('PLACA').AsString;
             buscas.ParamByName('CERTIFICADOEST').AsString := vItem.vDetVeic.dataSet.FieldByName('CERTIFICADO').AsString;
             buscas.ParamByName('DATA_CERTIFICADOEST').AsString := vItem.vDetVeic.dataSet.FieldByName('DATA_CERTIFICADO').AsString;
             buscas.ParamByName('CATEGORIAEST').AsString := vItem.vDetVeic.dataSet.FieldByName('CATEGORIA').AsString;
             buscas.ParamByName('TIP_PINTURA').AsString := vItem.vDetVeic.dataSet.FieldByName('TIP_PINTURA').AsString;
             buscas.ParamByName('NSERIE').AsString := vItem.vDetVeic.dataSet.FieldByName('NSERIE').AsString;
             buscas.ParamByName('COD_COR').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_COR').AsInteger;
             buscas.ParamByName('PRECO_CUSTO').AsFloat := vItem.vDetVeic.dataSet.FieldByName('PRECO_CUSTO').AsFloat;
             buscas.ParamByName('PRECO_CUSTO_REP').AsFloat := vItem.vDetVeic.dataSet.FieldByName('PRECO_CUSTO').AsFloat;
             buscas.ParamByName('PRECO_CUSTO_DESP').AsFloat := vItem.vDetVeic.dataSet.FieldByName('PRECO_CUSTO').AsFloat;

             if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N' then
               buscas.ParamByName('STATUS_USO').AsString := 'N'
             else
                buscas.ParamByName('STATUS_USO').AsString := 'U';

             if (vDadosIni.vEmp.vInfRedLucro = 'S') and (Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) <> 'N') then
             begin
               buscas2.Close;
               buscas2.SQL.Text := ' SELECT PERC_RED, RED_LUCRO FROM TIPMODELO ' +
                ' WHERE CODIGO = :CODIGO AND COD_EMPRESA = :COD_EMPRESA AND ATIVO = 1 ';
               buscas2.ParamByName('CODIGO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('VERSAO').AsInteger;
               buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
               buscas2.Open;

               if not buscas2.IsEmpty then
               begin
                  buscas.ParamByName('PERC_RED').AsFloat := buscas2.FieldByName('PERC_RED').AsFloat;
                  buscas.ParamByName('RED_LUCRO').AsString := buscas2.FieldByName('RED_LUCRO').AsString;
               end;
             end;

             buscas.ParamByName('BASE_CALC_ICM_SUBEST').AsFloat := vItem.dataSet.FieldByName('BASE_ICMSUB').AsFloat;
             buscas.ParamByName('FRETE_AQUISICAOEST').AsFloat := vItem.vDetVeic.dataSet.FieldByName('FRETE_AQUISICAO').AsFloat;
             buscas.ParamByName('FRETE_VENDAEST').AsFloat := vItem.vDetVeic.dataSet.FieldByName('FRETE_VENDA').AsFloat;
             buscas.ParamByName('VALOR_ICM_SUBEST').AsFloat := vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat;
             buscas.ParamByName('SITUACAO').AsString := vItem.vDetVeic.dataSet.FieldByName('SITUACAO').AsString;
             buscas.ParamByName('COD_FORNECEDOR').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
             buscas.ParamByName('DESCRICAO_VERSAOEST').AsString := vItem.vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString;
           end;

           if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'V') then
           begin
             buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
             buscas.ParamByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas2);
             buscas.ParamByName('HORA_CAD').AsString := FormatDateTime('HH:MM', vDadosIni.getDataHoraBanco(buscas2));
           end;
           buscas.Prepare;
           buscas.ExecSQL;
         end
         else
         begin
           Result := false;
           if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'R') then
              Application.MessageBox(PChar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
              ' encontrado em estoque (VIVO) não se encontra em Demonstração: ' + sLineBreak +
              'Chassi: ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString))),
              'Atenção', mb_ok + MB_ICONINFORMATION)
           else
             Application.MessageBox(PChar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
             ' encontrado em estoque (VIVO): ' +sLineBreak +
             'Chassi: ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString))),
             'Atenção', mb_ok + MB_ICONINFORMATION);
           exit;
         end;                                                  
      end
      else
      begin
        if  (vItem.dataSet.FieldByName('tipv_veiculo').AsString = 'V') and (Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N') then
  			begin
          buscas.Close;
      		buscas.Sql.Text := ' select nf.cod_nf, nfv.chassi, nfi.codigo_nop, nfi.tipv_veiculo from notafiscal nf ' +
						' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
						' inner join notafiscal_item_veiculo nfv on nfv.cod_nf = nfi.cod_nf and nfv.cod_empresa = nfi.cod_empresa and nfv.nitem = nfi.nitem ' +
					  ' where nf.natureza_nf = ''E'' and nf.tipo_nf = ''V'' and nfi.tipv_veiculo = ''V'' and nfv.tipo_venda = ''N'' ' +
						' and nf.cod_empresa = :cod_empresa and (trim(coalesce(nf.status, '''')) = ' + QuotedStr(stsFechada) + ') ' +
            ' and nfv.chassi = :chassi ';
          buscas.ParamByName('CHASSI').AsString := vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString;
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          buscas.Open;

          if not buscas.IsEmpty then
          begin
            Result := False;

           	if Application.MessageBox(Pchar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
              ' novo já possui notafiscal de compra ' + sLineBreak +
              'Chassi: ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString)) + sLineBreak + sLineBreak +
              'Deseja continuar assim mesmo?'),'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
   		   			Exit;

          	if not vDadosIni.PesqPros('NF0195', 'PERMITIR',
     			  	'Chassi ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString)),
    				  'NOTAFISCAL', dataSet.FieldByName('COD_NF').AsString, buscas, true) then
      				Exit;
                   
            Result := True;
          end;
  			end
      	else if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'R') then
        begin
        		Result := False;

           	if Application.MessageBox(Pchar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
              ' não encontrado em estoque (VIVO): ' + sLineBreak +
              'Chassi: ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString)) + sLineBreak + sLineBreak +
              'Deseja continuar com retorno em demonstração assim mesmo?'),'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
              	Exit;

          	if not vDadosIni.PesqPros('NF0194', 'PERMITIR',
     			  	'Chassi ' + QuotedStr(Trim(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString)),
    				  'NOTAFISCAL', dataSet.FieldByName('COD_NF').AsString, buscas, true) then
      				Exit;

            Result := True;
     		end;

        Buscas.Close;
        Buscas.Sql.Text := 'INSERT INTO EST_MOTO' +
          ' (CHASSI_C, COD_EMPRESA, NUM_NOTA, SERIE, MARCAEST, VERSAOEST,' +
          ' ANO_FABEST, ANO_MODEST, COREST, CILINDROSEST, COMBUSTIVELEST, CILINDRADAEST, HPEST, LOTACAOEST,' +
          ' TIPOEST, RENAVAMEST, PRECO_TABEST, OBS_ITEMEST, MOTOREST, PLACAEST, CERTIFICADOEST, DATA_CERTIFICADOEST,' +
          ' CATEGORIAEST, DATA_CH_NOTA, TIP_PINTURA, NSERIE, COD_COR,' +
          ' BASE_CALC_ICM_SUBEST, FRETE_AQUISICAOEST, FRETE_VENDAEST, VALOR_ICM_SUBEST, SITUACAO, TIPO_RES, DATA_RES, HORA_RES,' +
