function TNFCab.existeNFDevolvida(pCod_nf: Integer): Boolean;
begin
  Result := false;
  try
    FDadosNFDevolvida := '0|0|0|0|';

    if pCod_nf = 0 then
      exit;
      
    buscas.Close;
    buscas.SQL.Text := 'select cod_nf, num_nf, serie, natureza_nf, status, data_contabil from notafiscal' +
      ' where cod_nf = ' + IntToStr(pCod_nf) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if not buscas.IsEmpty then
    begin
      if Trim(buscas.FieldByName('status').AsString) <> stsFechada then
      begin
        Application.MessageBox(pchar('Nota Fiscal não pode ser associada. Nota Fiscal ' +
          Trim(buscas.FieldByName('status').AsString)), 'Atenção',  0 + 64 );
        Exit;
      end;

      FDadosNFDevolvida := buscas.FieldByName('cod_nf').AsString + '|' +
        buscas.FieldByName('num_nf').AsString + '|' +
        buscas.FieldByName('serie').AsString + '|' +
        buscas.FieldByName('data_contabil').AsString + '|' ;

      _buscas.Close;
      _buscas.SQL.Text := 'select * from notafiscal_item'+
        ' where cod_nf = ' + vDadosIni.getCampoPipe(FDadosNFDevolvida, 1) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and tipo_item = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_item').AsString);
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
        _buscas.SQL.Text := _buscas.SQL.Text +
          ' and grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString)
      else if vItem.dataSet.FieldByName('tipo_item').AsString = 'V' then
        _buscas.SQL.Text := _buscas.SQL.Text +
          ' and chassi = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString);
      _buscas.Open;
      Result := True;
    end;

  finally
    if not result then
    begin

    _buscas.Close;
    _buscas.SQL.Text := 'select * from notafiscal_item'+
      ' where cod_nf = -1 and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and nitem = -1' ;
    _buscas.Open;

    end;
  end;
end;

function TNFCab.existeNotaFiscal: boolean;
var
  vNumNfOrig, vCodClFor: integer;
  vNatureza, vserieOrig, vModelo,vTempSql, vEmissaoPropria: string;
begin
  if notaFechada then
    exit;
  vNumNfOrig := dataSet.FieldByName('num_nf').AsInteger;
  vserieOrig := dataSet.FieldByName('serie').AsString;
  vNatureza := dataSet.FieldByName('natureza_nf').AsString;
  vModelo := dataSet.FieldByName('modelo_nf').AsString;
  vEmissaoPropria := dataSet.FieldByName('emissao_propria').AsString;
  vCodClFor := dataSet.FieldByName('cod_cliente').AsInteger;
  vTempSql := '';
  if dataSet.FieldByName('tipo_nf').AsString = 'D' then
    vTempSql := ' and coalesce(subserie,'''') = ' + QuotedStr(dataSet.FieldByName('subserie').AsString);

  if (vModelo = '21') or (vModelo = '22') or (vDadosIni.StrZero(Trim(vModelo),3) = '006') then
    vTempSql := vTempSql +
      ' and ID_MODELO21 = ' + StringReplace(QuotedStr(FormatDateTime('mm/yyyy', dataSet.FieldByName('data_lanc').AsDateTime)),'/', '', [rfReplaceAll]);

  Result := ExecutaComandosSql('select cod_nf from notafiscal where num_nf = ' +
