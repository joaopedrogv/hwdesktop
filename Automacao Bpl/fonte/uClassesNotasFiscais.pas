  if Result then
     Exit;
  Result := (abs(CalculoImposto.vValorFrete - dataSet.FieldByName('valor_frete').AsFloat) >
    vDadosIni.vEmp.vMaxDifEnt) ;
  if Result then
     Exit;
  Result := (abs(CalculoImposto.vValorSeguro - dataSet.FieldByName('valor_seguro').AsFloat) >
