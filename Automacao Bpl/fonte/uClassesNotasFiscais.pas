function TNFCab.verificarPrecoCustoItens: Boolean;
begin
  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    Exit;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vItem.vCfopIt.selecionaCfop(vItem.dataset.FieldByName('codigo_nop').AsInteger);
    if (vItem.vCfopIt.dataset.FieldByName('precc').AsString = 'S') and
      (vItem.dataset.FieldByName('tipo_item').AsString = 'P') then
    begin
      if (vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
        vItem.dataSet.FieldByName('cod_prod').AsString)) and
        (vDadosIni.StrToFloatFormat(vItem.vProd.dataSet.FieldByName('prec_cusm_prod').AsFloat,
        vDadosIni.vEmp.vCasasDecimais) > 0) then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('valor_unitario').AsFloat := vDadosIni.StrToFloatFormat(vItem.vProd.dataSet.FieldByName('prec_cusm_prod').AsFloat, vDadosIni.vEmp.vCasasDecimais);
        if vItem.verificaDescontoNoItem then
          vItem.dataSet.Post
        else
          vItem.dataSet.Cancel;
      end;
    end;
    vItem.dataSet.Next;
  end;
end;

function TNFCab.verificarRegraGeralCST: Boolean;
var
  RegraTabA, RegraTabB: Boolean;
  ListTabA, ListTabB: TStrings;
  CST_NF_A, CST_NF_B, CST_A, CST_B: string;
  CST_A_AlterarCadastro: Boolean;
  I: Integer;
begin
  Result := True;
  RegraTabA := vDadosIni.getConfSisBool('nf_e_hab_conversao_cst_regra_geral_tabela_a', buscas);
  RegraTabB := vDadosIni.getConfSisBool('nf_e_hab_conversao_cst_regra_geral_tabela_b', buscas);

  if (not RegraTabA) and (not RegraTabB) then
    Exit;

  try
    ListTabA := TStringList.Create;
    ListTabB := TStringList.Create;
    if RegraTabA then
      ListTabA := vDadosIni.getConfSisBlob('nf_e_hab_conversao_cst_regra_geral_tabela_a', buscas);
    if RegraTabB then
      ListTabB := vDadosIni.getConfSisBlob('nf_e_hab_conversao_cst_regra_geral_tabela_b', buscas);

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      CST_A := '';
      CST_B := '';
      CST_NF_A := Copy(vItem.dataSet.FieldByName('cst').AsString, 1, 1);
      CST_NF_B := Copy(vItem.dataSet.FieldByName('cst').AsString, 2, 2);
      if (RegraTabA) and (ListTabA.Count >= 2) then
        for I := 1 to ListTabA.Count - 1 do // a primeira linha é desconsiderada
          if CST_NF_A = vDadosIni.getValue(ListTabA[i], 1) then
          begin
            CST_A := Trim(vDadosIni.getValue(ListTabA[i], 2));
            CST_A_AlterarCadastro := vDadosIni.getValue(ListTabA[i], 3) = 'S';
            Break;
          end;

      if (RegraTabB) and (ListTabB.Count >= 2) then
        for I := 1 to ListTabB.Count - 1 do // a primeira linha é desconsiderada
          if (CST_NF_B = vDadosIni.getValue(ListTabB[i], 1)) then
          begin
            if (dataSet.FieldByName('emissao_propria').AsString <> 'S') or
              (vDadosIni.getValue(ListTabB[i], 3) = 'S') then
              CST_B := Trim(vDadosIni.getValue(ListTabB[i], 2));
            if CST_B <> '' then
              Break;
          end;

      if (CST_A <> '') or ( CST_B <> '') then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('cst').AsString :=
          vDadosIni.IfThen(CST_A <> '', CST_A, CST_NF_A) +
          vDadosIni.IfThen(CST_B <> '', CST_B, CST_NF_B);
        vItem.dataSet.Post;

        if (CST_A <> '') and (CST_A_AlterarCadastro) and (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
        begin
          buscas.Close;
          buscas.SQL.Text := 'select cst_prod from produtos' +
            ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod' +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ParamByName('grupo_prod').AsInteger := vItem.dataSet.FieldByName('grupo_prod').AsInteger;
          buscas.ParamByName('cod_prod').AsString    := vItem.dataSet.FieldByName('cod_prod').AsString;
          buscas.Open;
          if Copy(buscas.FieldByName('cst_prod').AsString, 1, 1) <> CST_A then
          begin
            CST_A := CST_A + Copy(buscas.FieldByName('cst_prod').AsString, 2, 2);
            buscas.Close;
            buscas.SQL.Text := 'update produtos set rep_int_active = 1, cst_prod = ' + QuotedStr(CST_A) +
              ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod' +
              ' and cod_empresa = ' + vDadosIni.codEmpresa;
            buscas.ParamByName('grupo_prod').AsInteger := vItem.dataSet.FieldByName('grupo_prod').AsInteger;
            buscas.ParamByName('cod_prod').AsString    := vItem.dataSet.FieldByName('cod_prod').AsString;
            buscas.ExecSQL;
            CST_A := Copy(CST_A, 1, 1);
          end;
          buscas.close;
        end;
      end;
      vItem.dataSet.Next;
    end;
  except on E: Exception do
    begin
      Result := False;
      registraErro('TNFCab.verificarRegraGeralCST. Erro: ' + e.Message);
      Application.MessageBox(PChar('Erro ao validar CST Regra Geral. Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION  + MB_OK );
    end;
  end;
end;

function TNFCab.verificaTransferenciaVeiculo: boolean;
begin
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vDadosIni.vEmp.vVersaoVeiculos = '4' then
    begin
      if (vItem.dataSet.FieldByName('TIPV_VEICULO').AsString = 'T') then
      begin
        buscas.close;
        buscas.SQL.Text := 'select * from EST_MOTO' +
         ' WHERE CHASSI_C = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
         ' AND (COALESCE(TIPV_VEICULO, ''V'') = ''T'') AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
         ' AND ATIVO = 1 AND DATA_TRANS_RET IS NULL';
        buscas.Open;
        if (not buscas.IsEmpty) and (dataSet.State in [dsInsert, dsEdit]) then
          dataSet.FieldByName('n_comando').AsInteger := buscas.FieldByName('n_comando').AsInteger
        else
          dataSet.FieldByName('n_comando').AsString := '';

        buscas.close;
        buscas.Sql.Text := ' update est_moto set data_trans_ret = :data' +
          ' where chassi_c = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
          ' and (coalesce(tipv_veiculo, ''V'') = ''T'') and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and status_transdep = ''S'' and ativo = 1 and data_trans_ret is null';
        buscas.ParamByName('data').AsDate := FDataDoDia;
        buscas.Prepare;
        buscas.ExecSQL;
      end
    end
    else if (vItem.dataset.FieldByName('codigo_nop').AsFloat = 1409) or
      (vItem.dataset.FieldByName('codigo_nop').AsFloat = 2409) then
    begin
      buscas.close;
      buscas.SQL.Text := 'select * from TRANSF_DEP' +
        ' WHERE CHASSIV = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
        ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' AND ATIVO = 1 AND DATA_TRANS_RET IS NULL';
      buscas.Open;
      if (not buscas.IsEmpty) and (dataSet.State in [dsInsert, dsEdit]) then
        dataSet.FieldByName('n_comando').AsInteger := buscas.FieldByName('n_comando').AsInteger
      else
        dataSet.FieldByName('n_comando').AsString := '';

      buscas.close;
      buscas.Sql.Text := ' update transf_dep set data_trans_ret = :data' +
        ' where chassiv = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 and data_trans_ret is null';
      buscas.ParamByName('data').AsDate := FDataDoDia;
      buscas.Prepare;
      buscas.ExecSQL;
    end;
    vItem.dataSet.Next;
  end;
end;

