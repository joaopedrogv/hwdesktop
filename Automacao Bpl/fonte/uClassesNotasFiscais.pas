  vdescontotmp: array of Currency;
  buscas2: TIBQuery;
begin
  try
  	vvalorDescontoNF := 0;
    vvalorboletostmp := 0;

  	buscas.Close;
    buscas.SQL.Text := ' select coalesce(cl.inf_desc_bol, ''N'') inf_desc_bol from clientes cl ' +
      ' where cl.cod_cliente = :cod_cliente ' +
      ' and cl.cod_empresa = :cod_empresa ';
    buscas.ParamByName('cod_cliente').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    if buscas.FieldByName('inf_desc_bol').AsString = 'S' then
    begin
    	SetLength(vdescontotmp, FFatura.parcelas);

    	vvalorDescontoNF := dataSet.FieldByName('VALOR_DESC').AsFloat +
      	IfThen(dataSet.FieldByName('TOTAIS_COM_DESON').AsString = 'S',
        	dataSet.FieldByName('VICMDESON').AsFloat, 0);

      if vvalorDescontoNF > 0 then
      begin
        for I := 0 to FFatura.parcelas - 1 do
          vvalorboletostmp := vvalorboletostmp + FFatura.valorDocumento[i];

        vDadosIni.atualizarValorDesconto(
          dataSet.FieldByName('VALOR_TOTAL').AsFloat,
          vvalorDescontoNF,
          vvalorboletostmp,
          FFatura.valorDocumento,
          vdescontotmp);
      end;
    end;

    vNFAlt := 'S';
    if (Trim(dataSet.FieldByName('modelo_nf').AsString) = '55') and
      (get_situacao_nfe <> sitAutorizada) then
      vNFAlt := 'N';
    vSql := 'INSERT INTO BOLETAS (N_SEQ_BOL, COD_EMPRESA, NUM_NF_VND, DATA_EM_BOL,' +
      ' DATA_VEN_BOL, N_DOC_BOL, VL_DOC_BOL, VL_DESC_BOL, OBS_BOL, M_DIA_BOL, MULT_ATR_BOL,' +
      ' COD_CLIENTE, LOCALPAG, OBS_BOL1, SUB_SERIE, COD_CONTROLE_CX, ' +
      ' TIPO_EMISSAO, NF_AUT, COD_CARGA, COD_NF, NPARCELA, TOTALPARCELAS)' +
      ' VALUES' +
      ' (:N_SEQ_BOL, :COD_EMPRESA, :NUM_NF_VND, :DATA_EM_BOL,' +
      ' :DATA_VEN_BOL, :N_DOC_BOL, :VL_DOC_BOL, :VL_DESC_BOL, :OBS_BOL, :M_DIA_BOL, :MULT_ATR_BOL,' +
      ' :COD_CLIENTE, :LOCALPAG, :OBS_BOL1, :SUB_SERIE, :COD_CONTROLE_CX, ' +
      ' ''NF'', '+QuotedStr(vNFAlt)+', :COD_CARGA, :COD_NF, :NPARCELA, :TOTALPARCELAS)';
    buscas.Close;
    buscas.SQL.Text := vSql;
    IniciaTransacao;
    FFatura.somaFaturas := 0;
    for I := 0 to FFatura.parcelas - 1 do
    begin

      buscas2 := TIBQuery(dtmNF.qrBuscasNf2);

      buscas2.Close;
      buscas2.SQL.Text := 'select N_SEQ_BOL from BOLETAS' +
        ' where NUM_NF_VND = ' + IntToStr(FFatura.numVenda[i]) +
        ' and TIPO_EMISSAO = ' + QuotedStr(FFatura.tipoVenda[i]) +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
      buscas2.Open;
      if buscas2.IsEmpty then
      begin
        if vDadosIni.vEmp.vNfUsarFormaPagDoPed <> 'S' then
        begin
          buscas2.Close;
          buscas2.SQL.Text := 'select cod_cobrebem from cobrebem where CODIGO_CTRL = :CODIGO_CTRL' +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas2.ParamByName('CODIGO_CTRL').AsInteger := vDadosIni.retornoPorCondicao(
            FFatura.codControles[i] > 0, FFatura.codControles[i], FFatura.codControle);
          buscas2.Open;
          if buscas2.FieldByName('cod_cobrebem').AsInteger > 0 then
            FFatura.numeroDocumento[i] := vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger, 6) + '-' + IntToStr(i + 1);
        end;
        buscas.Close;
        buscas.ParamByName('N_SEQ_BOL').AsInteger := Gencodigo('BOLETAS', dtmNF.SpIncCodNF,
          vDadosIni.codEmpresa);
        buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
        buscas.ParamByName('NPARCELA').AsInteger := i + 1;
        buscas.ParamByName('TOTALPARCELAS').AsInteger := FFatura.parcelas;
        buscas.ParamByName('NUM_NF_VND').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
        buscas.ParamByName('SUB_SERIE').AsInteger := dataSet.FieldByName('serie').AsInteger;
//        buscas.ParamByName('M_DIA_BOL').AsFloat := FFatura.moraDiaria;
//        buscas.ParamByName('MULT_ATR_BOL').AsFloat := FFatura.multa;
//        buscas.ParamByName('LOCALPAG').AsString := copy(FFatura.localPagamento,1,40);
//        buscas.ParamByName('OBS_BOL').AsString := copy(FFatura.obs1,1,45);
        buscas.ParamByName('OBS_BOL1').AsString := copy(FFatura.obs2,1,45);
        buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
        buscas.ParamByName('DATA_EM_BOL').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
        buscas.ParamByName('DATA_VEN_BOL').AsDate := StrToDate(FFatura.vencimentoDocumento[i]);
        buscas.ParamByName('N_DOC_BOL').AsString := copy(FFatura.numeroDocumento[i],1,10);
        if vvalorDescontoNF > 0 then
        begin
        	buscas.ParamByName('VL_DOC_BOL').AsCurrency := FFatura.valorDocumento[i];
        	buscas.ParamByName('VL_DESC_BOL').AsCurrency := 0;

          if Length(vdescontotmp) - 1 >= I then
          begin
            buscas.ParamByName('VL_DOC_BOL').AsCurrency := FFatura.valorDocumento[i];
            buscas.ParamByName('VL_DESC_BOL').AsCurrency := vdescontotmp[I];
          end;
        end
        else
        begin
        	buscas.ParamByName('VL_DOC_BOL').AsCurrency := FFatura.valorDocumento[i];
        	buscas.ParamByName('VL_DESC_BOL').AsCurrency := 0;
        end;

        if FFatura.codControles[i] > 0 then
          buscas.ParamByName('COD_CONTROLE_CX').AsInteger := FFatura.codControles[i]
        else
        buscas.ParamByName('COD_CONTROLE_CX').AsInteger := FFatura.codControle;
        if dataSet.FieldByName('COD_CARGA').AsInteger > 0 then
          buscas.ParamByName('COD_CARGA').AsInteger := dataSet.FieldByName('COD_CARGA').AsInteger;
        buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
      FFatura.somaFaturas := FFatura.somaFaturas + FFatura.valorDocumento[i];
    end;
    //    CommitaTransacao;
  except
    on e: Exception do begin
      RollBackTransacao;
      Result := false;
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' salvarFaturas ' + e.Message);
    end;
  end;
end;

function TNFCab.salvarFaturasEntrada: boolean;
var
  I, vCodControle: Integer;
  vSql: wideString;
  vComConsumo: Boolean;
  vNumConta: Double;
  vNumContaFrete: Double;
  vDetalhes:Boolean;
  J: Integer;
  K: Integer;
begin
  Result := False;

  vComConsumo := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vComConsumo := vItem.dataSet.FieldByName('consumo').AsString = 'S';
    if vComConsumo then
      Break;
    vItem.dataSet.Next;
  end;

  try
  	if not vDadosIni.testarContasLigacao(buscas, 'NF') then
  		Exit;

    buscas.Close;
    buscas.SQL.Text := ' SELECT NCON_C_PROD, NCON_C_VEIC, NCON_C_FRETE, CONTR_C_PROD FROM CONT_LIG ' +
      ' where COD_EMP = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if buscas.IsEmpty then
      raise exception.create('Sem contas de ligação para lançar no contas a Pagar');
    vNumContaFrete := buscas.FieldByName('NCON_C_FRETE').AsFloat;
    vNumConta      := buscas.FieldByName('NCON_C_PROD').AsFloat;
    if dataSet.FieldByName('tipo_nf').AsString = 'V' then
      vNumConta    := buscas.FieldByName('NCON_C_VEIC').AsFloat;
    vCodControle   := buscas.FieldByName('CONTR_C_PROD').AsInteger;
    vSql := 'INSERT INTO CONTAS_A_PAGAR (CODIGO_EMP, COD_FORN_NFE, NOME_FOR_CTP, N_CONTA_PLC,' +
      ' CODIGO_CTRL, TIPO_CTP, N_DOC_CTP, NPARCELA, QTDE_PARC, DATA_VENC_CTP, VALOR_CTP, DATA_ENT_CTP, VALOR_CTP_ORIG,' +
      ' NATL_CTP, HISTORICO_CTP, NUM_NOTA_NFE, COD_CONTRP, SERIE, N_DOC_CTP_ORIG, DTREFERENCIA, REF_FRETE, VL_CONTABIL, ACEITE_CTP, ENTRA_PREVISAO, COD_EMP_MULT, US_CAD)' +
      ' VALUES' +
      ' (:CODIGO_EMP, :COD_FORN_NFE, :NOME_FOR_CTP, :N_CONTA_PLC,' +
      ' :CODIGO_CTRL, :TIPO_CTP, :N_DOC_CTP, :NPARCELA, :QTDE_PARC, :DATA_VENC_CTP, :VALOR_CTP, :DATA_ENT_CTP, :VALOR_CTP_ORIG,' +
      ' :NATL_CTP, :HISTORICO_CTP, :NUM_NOTA_NFE, :COD_CONTRP, :SERIE, :N_DOC_CTP_ORIG, :DTREFERENCIA, :REF_FRETE, :VL_CONTABIL, :ACEITE_CTP, :ENTRA_PREVISAO, :COD_EMP_MULT, :US_CAD)';
    buscas.Close;
    buscas.SQL.Text := vSql;
    IniciaTransacao;
    for I := 0 to FFatura.parcelas - 1 do
    begin
      vDetalhes := False;
      if (High(FFatura.despesas) >= 0) then// and (pos('F', FFatura.numeroDocumento[i]) = 0) then
        for J := 0 to High(FFatura.despesas) do
          if FFatura.despesas[J].indice = I then
          begin
            vDetalhes := (FFatura.despesas[J].parcelas > 0)and (FFatura.despesas[J].indice = I) ;
            Break;
          end;
      if vDetalhes then
      begin
        for K := 0 to High(FFatura.despesas) do
          if FFatura.despesas[K].indice = I then
          begin
            for J := 0 to High(FFatura.despesas[K].valorDocumento) do
            begin
              buscas.Close;
              buscas.ParamByName('COD_CONTRP').AsInteger := Gencodigo('CONTAS_A_PAGAR', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
              buscas.ParamByName('CODIGO_EMP').AsString := vDadosIni.codEmpresa;
              buscas.ParamByName('COD_EMP_MULT').AsString := vDadosIni.codEmpresa;
              buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
              buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
              buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('serie').AsString;
              buscas.ParamByName('COD_FORN_NFE').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
              buscas.ParamByName('NOME_FOR_CTP').AsString := copy(dataSet.FieldByName('razao').AsString,1,35);
              buscas.ParamByName('N_CONTA_PLC').AsFloat := FFatura.despesas[K].NumConta[J];
              buscas.ParamByName('CODIGO_CTRL').AsInteger := FFatura.despesas[K].Controle[J];
              buscas.ParamByName('TIPO_CTP').AsString := 'D';
              buscas.ParamByName('N_DOC_CTP').AsString := copy(FFatura.despesas[k].NumDoc[J],1,20);
              buscas.ParamByName('NPARCELA').AsInteger := I + 1;
              buscas.ParamByName('QTDE_PARC').AsInteger := FFatura.parcelas;
              buscas.ParamByName('DATA_VENC_CTP').AsDate := StrToDate(FFatura.vencimentoDocumento[i]);
              buscas.ParamByName('VALOR_CTP').AsCurrency := FFatura.despesas[k].valorDocumento[J];
              buscas.ParamByName('VL_CONTABIL').AsCurrency := FFatura.despesas[k].valorDocumento[J];
              buscas.ParamByName('VALOR_CTP_ORIG').AsCurrency := FFatura.valorDocumento[i];
              buscas.ParamByName('DATA_ENT_CTP').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
              buscas.ParamByName('NATL_CTP').AsString := 'C';
              buscas.ParamByName('HISTORICO_CTP').AsString :=copy(FFatura.despesas[k].historico[J],1,100);
              buscas.ParamByName('N_DOC_CTP_ORIG').AsString := copY(FFatura.numeroDocumento[i],1,20);
              buscas.ParamByName('DTREFERENCIA').AsDate := StrToDate(FFatura.despesas[k].dataReferencia[J]);
              buscas.ParamByName('REF_FRETE').AsString := 'N';
              buscas.ParamByName('ACEITE_CTP').AsString := 'S';
              buscas.ParamByName('ENTRA_PREVISAO').AsString := 'S';
              if FFatura.referenteFrete[i] then//if pos('F', FFatura.numeroDocumento[i]) > 0 then
              begin
                buscas.ParamByName('REF_FRETE').AsString := 'F';//F: indica que a nf lancou a parcela do frete e o aguarda o lancamento do frete (servico_transporte) para marcar o campo como S
                if vNumContaFrete > 0 then
                	buscas.ParamByName('N_CONTA_PLC').AsFloat := vNumContaFrete;
              end;
              buscas.Prepare;
              buscas.ExecSQL;
            end;
            Break;
          end;
      end
      else
      begin
        buscas.Close;
        buscas.ParamByName('COD_CONTRP').AsInteger := Gencodigo('CONTAS_A_PAGAR', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
        buscas.ParamByName('CODIGO_EMP').AsString := vDadosIni.codEmpresa;
        buscas.ParamByName('COD_EMP_MULT').AsString := vDadosIni.codEmpresa;
        buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
        buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
        buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('serie').AsString;
        buscas.ParamByName('COD_FORN_NFE').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
        buscas.ParamByName('NOME_FOR_CTP').AsString :=
          copy(dataSet.FieldByName('razao').AsString,1,35);
        buscas.ParamByName('N_CONTA_PLC').AsFloat := vNumConta;
        buscas.ParamByName('CODIGO_CTRL').AsInteger := vCodControle;
        if vComConsumo then
          buscas.ParamByName('TIPO_CTP').AsString := 'D'
        else
          buscas.ParamByName('TIPO_CTP').AsString := 'F';
        buscas.ParamByName('N_DOC_CTP').AsString := copy(FFatura.numeroDocumento[i],1,20);
        buscas.ParamByName('NPARCELA').AsInteger := I + 1;
        buscas.ParamByName('QTDE_PARC').AsInteger := FFatura.parcelas;
        buscas.ParamByName('DATA_VENC_CTP').AsDate := StrToDate(FFatura.vencimentoDocumento[i]);
        buscas.ParamByName('VALOR_CTP').AsCurrency := FFatura.valorDocumento[i];
        buscas.ParamByName('VL_CONTABIL').AsCurrency := FFatura.valorDocumento[i];
        buscas.ParamByName('VALOR_CTP_ORIG').AsCurrency := FFatura.valorDocumento[i];
        buscas.ParamByName('DATA_ENT_CTP').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
        buscas.ParamByName('NATL_CTP').AsString := 'C';
        buscas.ParamByName('ACEITE_CTP').AsString := 'S';
        buscas.ParamByName('ENTRA_PREVISAO').AsString := 'S';
        if not FFatura.referenteFrete[i] then//if pos('F', FFatura.numeroDocumento[i]) = 0 then
        begin
          {
          buscas.ParamByName('HISTORICO_CTP').AsString := copy('COMPRA MERC CONF NF ' +
            dataSet.FieldByName('NUM_NF').AsString,1,100);
          }
          buscas.ParamByName('HISTORICO_CTP').AsString := Copy(HistoricoHelper.Build(CtpDeNF, dataSet),1,100);
          buscas.ParamByName('REF_FRETE').AsString := 'N';
        end
        else
        begin
          {
          buscas.ParamByName('HISTORICO_CTP').AsString := copy('CONHEC FRETE NF ' +
            dataSet.FieldByName('NUM_NF').AsString,1,100);
          }
          buscas.ParamByName('HISTORICO_CTP').AsString := Copy(HistoricoHelper.Build(CtpDeFreteNF, dataSet),1,100);
          buscas.ParamByName('REF_FRETE').AsString := 'F';
          if vNumContaFrete > 0 then
          	buscas.ParamByName('N_CONTA_PLC').AsFloat := vNumContaFrete;
        end;
        buscas.ParamByName('N_DOC_CTP_ORIG').AsString := copy(FFatura.numeroDocumento[i],1,20);
        buscas.ParamByName('DTREFERENCIA').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
      Result := True;
    end;
  except
    on e: Exception do begin
      Result := false;
      Application.messagebox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' salvarFaturasEntrada ' + e.Message);
    end;
  end;
end;

