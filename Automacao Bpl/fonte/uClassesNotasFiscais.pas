      end;
    if (Trim(dataSet.FieldByName('QTDE_VOLUMES_TR').AsString) = '') or
      (Trim(dataSet.FieldByName('ESPECIE_TR').AsString) = '') or
      (Trim(dataSet.FieldByName('MARCA_TR').AsString) = '') or
      (Trim(dataSet.FieldByName('NUMERO_TR').AsString) = '') or
      (Trim(dataSet.FieldByName('PESO_B').AsString) = '') or
      (Trim(dataSet.FieldByName('PESO_L').AsString) = '') then
      if Application.MessageBox(Pchar('Dados do(s) Volume(s) transportado(s) estão incompletos.' +
        sLineBreak +
        'Deseja continuar?'), 'Atenção', 4 + 32) = IDNO then
      begin
        Result := false;
        Exit;
      end;}
    Result := true;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.verificaAceiteCTP: Boolean;
