function TGradeCompraNF.concluirEntradaDeGrades: boolean;
begin
  FQtdeInformada := 0;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if dataSet.FieldByName('qtde').AsFloat > 0 then
      FQtdeInformada := FQtdeInformada + dataSet.FieldByName('qtde').AsFloat;
    dataSet.Next;
  end;
  FQtdePendente := FQtdeTotal - FQtdeInformada;
  try
    if Format('%0.4f', [FQtdePendente]) = '0,0000' then
      Result := Apply
    else
    begin
      Result := False;
      Application.MessageBox(pchar('Diferença de ' + Format('%0.4f', [FQtdePendente]) + sLineBreak +
        'A entrada da grade so terminará quando informar a diferença'), 'Atenção', mb_ok +
        MB_ICONINFORMATION);
    end;
  except
    on e: Exception do begin
      Result := false;
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' concluirEntradaDeGrades ' + e.Message);
    end;
  end;
end;

