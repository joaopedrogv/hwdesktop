       vItem.vDetVeic.dataSet.FieldByName('TIPO').AsString := vItem.vDetVeic.vModV.dataSet.FieldByName('tipo').AsString;
       vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString :=  Trim(vComFat.dataSet.FieldByName('TIPV_VEICULO').AsString);
       vItem.vDetVeic.dataSet.FieldByName('COD_ESTMOTO').AsInteger :=  vComFat.dataSet.FieldByName('COD_ESTMOTO').AsInteger;
      end;

      vItem.vDetVeic.Post;
      vItem.Edit;
      vItem.vDetVeic.vModV.abreModelos(vItem.vDetVeic.dataSet.FieldByName('VERSAO').AsInteger);
      if Trim(vItem.vDetVeic.vModV.dataSet.FieldByName('MARCA_DESC').AsString) <> '' then
        vItem.vDetVeic.dataSet.FieldByName('MARCA').AsString :=
          Trim(vItem.vDetVeic.vModV.dataSet.FieldByName('MARCA_DESC').AsString);
      if not vItem.vDetVeic.vModV.dataSet.IsEmpty then
      begin
        if Trim(vItem.vDetVeic.vModV.dataSet.FieldByName('ncmsh').AsString) <> '' then
          vItem.dataSet.FieldByName('ncm').AsString :=
            vItem.vDetVeic.vModV.dataSet.FieldByName('ncmsh').AsString
        else
          vItem.dataSet.FieldByName('ncm').AsString := '87';
        vItem.dataSet.FieldByName('cest').AsString :=
            vItem.vDetVeic.vModV.dataSet.FieldByName('cest').AsString;
      end;
      
      pagNFe.pagamentoDosPedidos;

    end;
  except
    on e: Exception do begin
      CancelUpdates;
      Application.MessageBox(pchar('Erro ao montar a nota fiscal de Veiculo. Erro: ' + e.Message),
        'Atenção', MB_OK + MB_ICONERROR);
      registraErro('COD COMANDO: ' + vComFat.dataSet.FieldByName('n_comando').AsString + ' ' +
        vComFat.dataSet.FieldByName('chassiv').AsString + ' adicionaVeiculoAnotaFiscal' +
        e.Message);
    end;
  end;
  // Codigo da entrada de veiculos
  //  vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := 'S';
  //  if (dataSet.FieldByName('codigo_nop').AsFloat = 1913) or (dataSet.FieldByName('codigo_nop').AsFloat = 1912) then
  //    vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := 'S';
  //   vItem.dataSet.FieldByName('altera_custo_cfop').AsString := vItem.vrDadosItem.altera_custo_cfop;
end;

