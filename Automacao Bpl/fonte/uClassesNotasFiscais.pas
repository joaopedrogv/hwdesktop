function TNFCab.existeCarga: Boolean;
begin
  Result := True;

  if (vDadosIni.vEmp.vOC_UsarOrdemCarregamento <> 'D') or (vDadosIni.vEmp.vOC_TipoControleOrdemC <> 'NF') then
    Exit;

  if Trim(dataSet.FieldByName('cod_carga').AsString) = '' then
    Exit;    

  Result := False;

  buscas.Close;
  buscas.SQL.Text := 'select cod_carga, status from carga' +
                     ' where cod_carga = '+IntToStr(dataSet.FieldByName('cod_carga').AsInteger) + ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if buscas.IsEmpty then
  begin
    vDadosIni.vPesquisa := 'Carga informada não existe';
    Exit;
  end;

  if Trim(buscas.FieldByName('status').AsString) = 'FECHADA' then
  begin
    vDadosIni.vPesquisa := 'Carga informada já esta fechada';
    Exit;
  end;
  
  Result := True;
end;

