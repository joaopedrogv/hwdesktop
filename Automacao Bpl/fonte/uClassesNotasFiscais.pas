function TNFCab.abreFormC114(abrirTabela: boolean): boolean;
var
  formulario: TfrmPadrao;
  vTem: Boolean;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Cupom Fiscal Referenciado';
    frmCadNF.pnC114.Parent := formulario;
    frmCadNF.pnC114Cadastro.Visible := False;
    frmCadNF.pnC114Consulta.Visible := True;
    frmCadNF.pnC114Cadastro.Left := 10;
    frmCadNF.pnC114Cadastro.Top := 10;
    frmCadNF.pnC114Consulta.Left := 10;
    frmCadNF.pnC114Consulta.Top := 10;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    if abrirTabela then
      vSped.vC110.vC114.abreC114(dataSet.FieldByName('cod_nf').AsInteger,
        vSped.vC110.dataSet.FieldByName('cod_inf').AsInteger);
    try
      vItem.dataSet.First;
      while not vitem.dataset.eof do
      begin
        if (vItem.dataset.FieldByName('ncupom').asinteger > 0) and
          ((Trim(vItem.dataset.FieldByName('nserieecf').AsString) <> '')) and
          (vItem.dataset.FieldByName('data_cupom').AsString <> '') then
        begin
          vTem := False;
          vSped.vC110.vC114.dataset.First;
          while not vSped.vC110.vC114.dataset.eof do
          begin
            if (vSped.vC110.vC114.dataset.fieldbyname('num_doc').asinteger =
              vitem.dataset.fieldbyname('ncupom').asinteger) and
              (vSped.vC110.vC114.dataset.fieldbyname('ecf_fab').asstring =
              vitem.dataset.FieldByName('nserieecf').AsString) and
              (vSped.vC110.vC114.dataset.fieldbyname('dt_doc').asstring =
              vitem.dataset.FieldByName('data_cupom').AsString) then
            begin
              vTem := true;
              break;
            end;
            vSped.vC110.vC114.dataset.next;
          end;
          if not vTem then
          begin
            if vSped.vC110.incluirC114 then
            begin
              vSped.vC110.vC114.dataset.fieldbyname('COD_MOD').AsString := '2D';
              vSped.vC110.vC114.dataset.fieldbyname('ECF_FAB').AsString :=
                vitem.dataset.FieldByName('nserieecf').AsString;
              vSped.vC110.vC114.dataset.fieldbyname('ECF_CX').AsString := '1';
              if vitem.dataset.FieldByName('terminal').AsInteger > 0 then
                vSped.vC110.vC114.dataset.fieldbyname('ECF_CX').AsString :=
                  vitem.dataset.FieldByName('terminal').AsString;
              vSped.vC110.vC114.dataset.fieldbyname('NUM_DOC').AsString :=
                vitem.dataset.FieldByName('ncupom').AsString;
              vSped.vC110.vC114.dataset.fieldbyname('DT_DOC').AsString :=
                vitem.dataset.FieldByName('data_cupom').AsString;
              vSped.vC110.vC114.Post;
            end;
          end;
        end;
        vitem.dataSet.next;
      end;
    except
    end;
    result := (formulario.ShowModal = mrOk);
  finally
    frmCadNF.pnC114.Parent := frmCadNF.tsC114;
    formulario.Free;
    formulario := nil;
  end;
end;

