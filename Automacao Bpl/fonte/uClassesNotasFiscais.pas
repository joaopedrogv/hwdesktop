function TNFCab.SetArrayOfcod_nf(selectedRecords, selectAsDefaultCurrent: Boolean): Integer;
begin
  Result := 0;
  SetLength(FarrayOfcod_nf, 0);
  if selectedRecords then
  begin
    try
      dataSet.DisableControls;
      storeRecNo;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('sel').AsString = 'S' then
        begin
          SetLength(FarrayOfcod_nf, Length(FarrayOfcod_nf) + 1);
          FarrayOfcod_nf[High(FarrayOfcod_nf)] := get_cod_nf;
        end;
        dataSet.Next;
      end;
    finally
      Result := Length(FarrayOfcod_nf);

      restoreRecNo;
      dataSet.EnableControls;
    end;
  end;

  if selectAsDefaultCurrent and (Length(FarrayOfcod_nf) = 0) then
  begin
    SetLength(FarrayOfcod_nf, 1);
    FarrayOfcod_nf[High(FarrayOfcod_nf)] := get_cod_nf;
    Result := Length(FarrayOfcod_nf);
  end;                               

end;

procedure TNFCab.setCFOPDevolucao;
begin
  buscas.Close;
  buscas.SQL.Text := 'select codigo_nop from nat_op where devolucao = ''S''';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    cfopDevolucaoCompra := '';
    cfopDevolucaoVenda := '';

    buscas.First;
    while not buscas.Eof do
    begin
      if buscas.FieldByName('codigo_nop').AsFloat > 3000 then
        cfopDevolucaoVenda := cfopDevolucaoVenda + IntToStr(Trunc(buscas.FieldByName('codigo_nop').AsFloat)) + '|'
      else
        cfopDevolucaoCompra :=  cfopDevolucaoCompra + IntToStr(Trunc(buscas.FieldByName('codigo_nop').AsFloat)) + '|';
      buscas.Next;
    end;
  end;

  // todos os cfops de devolução para o sped contribuicoes serao selecionados aqui
  buscas.Close;
  buscas.SQL.Text := 'select codigo_nop from nat_op where devolucao_sped = ''S''';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    cfopDevolucaoSPED := '';
    buscas.First;
    while not buscas.Eof do
    begin
      cfopDevolucaoSPED :=  cfopDevolucaoSPED + IntToStr(Trunc(buscas.FieldByName('codigo_nop').AsFloat)) + '|';
      buscas.Next;
    end;
  end;
end;

