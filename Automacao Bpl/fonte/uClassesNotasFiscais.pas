      ' and cg.aliq_interna = ' + vDadosIni.trocaVirgulaPorPonto(FloatToStr(pAliq)) +
      ' and cg.cfop_interno = ' + vDadosIni.trocaVirgulaPorPonto(FloatToStr(pCfop)) +
      ' and cg.cst_interno = ' + QuotedStr(pCst);
    buscas.Open;
    FAliqAcordoGeral := buscas.FieldByName('aliq_externa').AsFloat;
    FCfopAcordoGeral := buscas.FieldByName('cfop_externo').AsFloat;
    FCstAcordoGeral := buscas.FieldByName('cst_externo').AsString;
