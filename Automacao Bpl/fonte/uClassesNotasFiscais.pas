function TNFCab.existeNotaFiscalDeDemonstracao: boolean;
var
  vIsEmpty: Boolean;
begin

  if (dataSet.FieldByName('num_nf_emt').AsInteger = 0) and
    (Trim(dataSet.FieldByName('serie_emt').AsString) = '') then
  begin
    Result := True;
    Exit;
  end;

  buscas.Close;
  buscas.Sql.Text := 'select cod_nf,num_nf,serie,situacao_nfe,codigo_nop,tipo_nf from notafiscal' +
    ' where num_nf = ' + IntToStr(dataSet.FieldByName('num_nf_emt').AsInteger) +
    ' and serie = ' + QuotedStr(dataSet.FieldByName('serie_emt').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and EMISSAO_PROPRIA = ''S''' +
    ' and ativo = 1 and cod_nf <> ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger);
  buscas.Open;
  vIsEmpty := buscas.IsEmpty;
  if (dataSet.FieldByName('tipo_nf').AsString = 'V') and (vIsEmpty) then
  begin
    buscas.Close;
    buscas.Sql.Text := 'select num_nota_v, sub_serie, situacao_nfe, natop_v codigo_nop  from com_fat' +
      ' where num_nota_v = ' + IntToStr(dataSet.FieldByName('num_nf_emt').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and sub_serie = ' + Trim(dataSet.FieldByName('serie_emt').AsString) +
      ' and ativo = 1';
    buscas.Open;
    vIsEmpty := buscas.IsEmpty;
  end
  else if not buscas.IsEmpty then
    if Trim(buscas.FieldByName('tipo_nf').AsString) <> Trim(dataSet.FieldByName('tipo_nf').AsString) then
    begin
      Application.MessageBox(PChar('Nota fiscal informada não é do mesmo tipo' + sLineBreak +
        'Tipo desta nota fiscal: ' +Trim(dataSet.FieldByName('tipo_nf').AsString) + sLineBreak +
        'Tipo da nota fiscal informada: ' +Trim(buscas.FieldByName('tipo_nf').AsString)),
        'Atenção', 0 + 64);
      Exit;
    end;

  try
    try
      if vIsEmpty then
        raise exception.Create('Nota fiscal Emitida não encontrada');
      if trim(buscas.FieldByName('situacao_nfe').AsString) <> sitAutorizada then
        raise exception.Create('Nota fiscal encontrada não se encontra Autorizada');
      if not notaFiscalDeRemessa(buscas.FieldByName('codigo_nop').Asstring) then
        raise exception.Create('Nota fiscal encontrada não foi emitida com intenção de retorno');
    finally
      buscas.Close;
    end;
    Result := True;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      if vDadosIni.PesqPros('NF0119', 'VALIDAR', 'NAO ENCONTRADA NF DE REMESSA - NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL', '', buscas, True) then
        if Application.MessageBox(pchar('Deseja continuar mesmo assim?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          Result := True;
          if dataSet.State in [dsinsert, dsedit] then
          begin
            dataSet.FieldByName('num_nf_emt').AsInteger := 0;
            dataSet.FieldByName('serie_emt').AsString := '';
          end;
          vDadosIni.GravaAuditoria('NF0119', 'VALIDAR', 'NAO INFORMOU NF DE REMESSA', 'NOTAFISCAL', '', buscas);
        end;
    end;
  end;
end;

