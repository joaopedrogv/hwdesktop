procedure TNFCab_FieldValues_Changes.ChecarCamposParaIgnorarTributos;
begin
  if not (FOwner.dataSet.State in [dsEdit, dsInsert])then
    Exit;

  if FOwner.fstrin('tipo_emissao', ['2','3']) then        // ajuste e complemento
  begin
    if (YesNoEnum(FOwner.fint('dfe_trib_ignorar')) = ynNo) then
      FOwner.dataSet.FieldByName('dfe_trib_ignorar').AsInteger := Ord(ynYes)
  end

  else if (YesNoEnum(FOwner.fint('dfe_trib_ignorar')) = ynNo)
    and (FOwner.fdate('data_contabil') < EncodeDate(2026, 1, 1)) // menor que 2026
  then
    FOwner.dataSet.FieldByName('dfe_trib_ignorar').AsInteger := Ord(ynYes)

  else if (YesNoEnum(FOwner.fint('dfe_trib_ignorar')) = ynYes)
    and (FOwner.fdate('data_contabil') >= EncodeDate(2026, 1, 1))
    and FOwner.Config.Conf_RTC.EmVigencia(vDadosIni.vEmp.vRegime)
  then
    FOwner.dataSet.FieldByName('dfe_trib_ignorar').AsInteger := Ord(ynNo);
end;

