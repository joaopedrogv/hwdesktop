function TNFCab.removerStatusEmProcessamento: boolean;
begin
  if not vDadosIni.PesqPros('NF0107', 'ALTERAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, buscas, True) then
    Exit;
  try
    if Trim(dataSet.FieldByName('modelo_nf').AsString) <> '55' then
      raiseExceptionCreate('Nota fiscal não é modelo 55','');
    if Trim(dataSet.FieldByName('emissao_propria').AsString) <> 'S' then
      raiseExceptionCreate('Nota fiscal não é de emissão própria','');
    if get_situacao_nfe <> sitEmProcessamento then
      raiseExceptionCreate('Status não pode ser modificado. Somente status "Em Processamento"','');
    dataSet.Edit;
    dataSet.FieldByName('SITUACAO_NFE').AsString := '';
    dataSet.Post;
    if Apply then
    begin
      CommitaTransacao;
      Result:=True;
    end;     
  except on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('procedure removerStatusEmProcessamento Erro: ' + e.Message);
    end;
  end;
end;

