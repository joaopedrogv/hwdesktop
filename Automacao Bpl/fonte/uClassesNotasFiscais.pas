function TNFCab.incluirNFVendaForaEstabelecimento: Boolean;
var
  vCodNf: Integer;
  vIntegerTemp: Integer;
  I: Integer;
begin
  Result := False;
  if not vDadosIni.PesqPros('NF0144', 'INCLUIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    '', dtmNF.qrBuscas, True) then
    Exit;

  try
    if Trim(vDadosIni.vEmp.vNF_UsarVendaForaEstabelecimento) <> 'S' then
      raiseExceptionCreate('Uso de NF de Venda Fora do estabelecimento não habilitado no cadastro da empresa. Aba "Configurações do Sistema" / "Nota Fiscal"', 'dbgrid1');

//    if Trim(vDadosIni.vEmp.vNF_ModeloVendaForaEstabelecimento) = '55' then
//      raiseExceptionCreate('Modelo da NF de Venda Fora do estabelecimento não deve ser "55". Aba "Configurações do Sistema" / "Nota Fiscal"', 'dbgrid1');

    if Trim(vDadosIni.vEmp.vNF_ModeloVendaForaEstabelecimento) = '' then
      raiseExceptionCreate('Modelo da NF de Venda Fora do estabelecimento não informado no cadastro da empresa. Aba "Configurações do Sistema" / "Nota Fiscal"', 'dbgrid1');

    if Trim(vDadosIni.vEmp.vNF_SerieVendaForaEstabelecimento) = '' then
      raiseExceptionCreate('Série da NF de Venda Fora do estabelecimento não informada no cadastro da empresa. Aba "Configurações do Sistema" / "Nota Fiscal"', 'dbgrid1');

    if (dataSet.FieldByName('natureza_nf').AsString <> 'S') then
      raiseExceptionCreate('Nota Fiscal deverá ser saída', 'dbgrid1');

    if (dataSet.FieldByName('tipo_nf').AsString <> 'P') then
      raiseExceptionCreate('Nota Fiscal deverá ser de produtos', 'dbgrid1');

    if copy(dataSet.FieldByName('codigo_nop').AsString, 2,3) <> '904' then
      if Application.MessageBox(pchar('Nota fiscal selecionada não é de Remessa para venda Fora do Estabelecimento' + sLineBreak +
        'Deseja continuar mesmo assim?'), 'Atenção', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        Exit;

    vItemNFVFE.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);

    if not abreFormVendaForaEstabelecimento then
      Exit;

    vCodNf := dataset.FieldByName('cod_nf').AsInteger;

    if vItemNFVFE.retorno then
      incluirNf( tnfProdutos, 'P', 'E')
    else
      incluirNf( tnfProdutos, 'P', 'S');

    buscas.Close;
    buscas.SQL.Text := 'select cod_nf, aliq_icm, num_nf, cod_cliente from notafiscal where cod_nf = ' + IntToStr(vCodNf) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if buscas.IsEmpty then
      raiseExceptionCreate('Nota Fiscal não encontrada', 'dbgrid1');

    if vDadosIni.vEmp.vNF_ModeloVendaForaEstabelecimento = '55' then
      vItemNFVFE.vNumNF := 0;

    dataSet.FieldByName('cod_nf_rem_vfe').AsInteger := vCodNf;
    dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'N';
    if vItemNFVFE.retorno then
    begin
      dataSet.FieldByName('codigo_nop').AsFloat := 1904;
      dataSet.FieldByName('cod_cliente').AsInteger := buscas.FieldByName('cod_cliente').AsInteger;
      dataSet.FieldByName('num_nf').AsInteger := buscas.FieldByName('num_nf').AsInteger;
      dataSet.FieldByName('emissao_propria').AsString := 'S';
      exitCodigoTabela('CLIENTES');
    end
    else
    begin
      dataSet.FieldByName('num_nf').AsInteger := vItemNFVFE.vNumNF;
      dataSet.FieldByName('modelo_nf').AsString := vDadosIni.vEmp.vNF_ModeloVendaForaEstabelecimento;
      dataSet.FieldByName('serie').AsString := vDadosIni.vEmp.vNF_SerieVendaForaEstabelecimento;
      dataSet.FieldByName('codigo_nop').AsInteger := 5104;
    end;

    dataSet.FieldByName('codigo_nop').AsString := getCfopCorreto(dataSet.FieldByName('codigo_nop').AsString);
    dataSet.FieldByName('aliq_icm').AsFloat := buscas.FieldByName('aliq_icm').AsFloat;
    exitCodigoTabela('NAT_OP');
    dataSet.FieldByName('devolucao').AsString := '';

    vItem.CancelUpdates;
    vIntegerTemp:=0;
    vItemNFVFE._dataTemp.First;
    while not vItemNFVFE._dataTemp.Eof do
    begin
      Inc(vIntegerTemp);

      buscas.Close;
      buscas.SQL.Text := 'select * from notafiscal_item where cod_nf = ' + IntToStr(vCodNf) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and nitem = ' + IntToStr(vItemNFVFE._dataTemp.FieldByName('nitem').AsInteger);
      buscas.Open;

      vItem.dataSet.Insert;
      for I := 0 to vItem.dataSet.FieldCount - 1 do
        if vItem.Dataset.Fields[I].FieldKind = fkData then
          if (vItem.dataSet.Fields[i].FieldName <> 'COD_NF') then
            vItem.dataSet.FieldByName(vItem.dataSet.Fields[i].FieldName).Value :=
              buscas.FieldByName(vItem.dataSet.Fields[i].FieldName).Value;
      vItem.dataSet.FieldByName('codigo_nop').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
      vCfop.selecionaCfop(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat));
      vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := vDadosIni.retornoPorCondicao(
        vCfop.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfop.dataSet.FieldByName('ALT_EST').AsString);//vCfop.dataSet.FieldByName('alt_est').AsString;
      if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString = 'N' then
        vItem.dataSet.FieldByName('altera_custo_cfop').AsString := 'N'
      else
        vItem.dataSet.FieldByName('altera_custo_cfop').AsString := vCfop.dataSet.FieldByName('calc_custo').AsString;
      vItem.dataSet.FieldByName('tipv_veiculo').AsString := vCfop.dataSet.FieldByName('tipv_veiculo').AsString;
      vItem.dataSet.FieldByName('cod_nf').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
      vItem.dataSet.FieldByName('nitem').AsInteger :=  vIntegerTemp;
      vItem.dataSet.FieldByName('quantidade').AsFloat := vItemNFVFE._dataTemp.FieldByName('quantidade').AsFloat;
      vItem.dataSet.FieldByName('valor_total').AsFloat := vItemNFVFE._dataTemp.FieldByName('valor_total').AsFloat;
      vItem.dataSet.FieldByName('valor_unitario').AsFloat := vItem.dataSet.FieldByName('valor_total').AsFloat / vItem.dataSet.FieldByName('quantidade').AsFloat;
      vItem.dataSet.FieldByName('rateio_desconto').AsFloat := 0;
      vItem.dataSet.FieldByName('nitem_rem_vfe').AsInteger := vItemNFVFE._dataTemp.FieldByName('nitem').AsInteger;
      vItem.dataSet.FieldByName('nped').Value := Null;
      vItem.dataSet.FieldByName('tipo_ped').Value := Null;
      vItem.dataSet.FieldByName('nitem_ped').Value := Null;
      vItem.dataSet.FieldByName('dfe_trib_id').Value := Null;
      if vItemNFVFE.retorno then
      begin
        if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '5' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '0' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
        else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '9' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '4' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1);
      end;

      vItem.dataSet.Post;

      vItemNFVFE._dataTemp.Next;
    end;

    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      somaTotaisNF;
      if dataSet.State in [dsInsert, dsEdit] then
      begin
        dataSet.FieldByName('base_icm').AsCurrency := FCalculoImposto.vBaseICMS;
        dataSet.FieldByName('valor_icm').AsCurrency := FCalculoImposto.vValorICM;
        dataSet.FieldByName('base_icmsub').AsCurrency := FCalculoImposto.vBaseICMSSub;
        dataSet.FieldByName('valor_icmsub').AsCurrency := FCalculoImposto.vValorICMSub;
        dataSet.FieldByName('base_ipi').AsCurrency := FCalculoImposto.vBaseIPI;
        dataSet.FieldByName('valor_ipi').AsCurrency := FCalculoImposto.vValorIPI;
        dataSet.FieldByName('valor_prod').AsCurrency := FCalculoImposto.vValorProdutos;
        dataSet.FieldByName('valor_serv').AsCurrency := FCalculoImposto.vValorServicos;
        dataSet.FieldByName('valor_total').AsCurrency := FCalculoImposto.vValorLiquidoNF;
      end;
    end;

    Result := True;

  except on E: Exception do
    begin
      Result := False;
      if vItem.dataSet.Active then
      begin
        vItem.dataSet.Cancel;
        vItem.dataSet.CancelUpdates;
      end;
      dataSet.Cancel;
      dataSet.CancelUpdates;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFCab.InserirHistEstMoto(pCodigo: Integer; pChassi: string): boolean;
var
  buscas2: TIBQuery;
begin
  try
    Result := true;

    if vDadosIni.vEmp.vVersaoVeiculos <> '4' then
      exit;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas2.Close;
    buscas2.SQL.Text := ' SELECT * FROM EST_MOTO ' +
      ' WHERE CHASSI_C = ' + QuotedStr(pChassi) + ' AND CODIGO = ' + IntToStr(pCodigo) +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas2.Open;


    if buscas2.IsEmpty then
     exit;

    vDadosIni.vHistV.vChassi := buscas2.FieldByName('CHASSI_C').AsString;
    vDadosIni.vHistV.vCodigo := buscas2.FieldByName('CODIGO').AsInteger;
    vDadosIni.vHistV.vNatureza := dataset.FieldByName('NATUREZA_NF').AsString;
    vDadosIni.vHistV.vNumDoc := dataset.FieldByName('COD_NF').AsInteger;
    vDadosIni.vHistV.vPlaca := buscas2.FieldByName('PLACAEST').AsString;
    vDadosIni.vHistV.vTipo := 'NF';
    vDadosIni.vHistV.vModelo := buscas2.FieldByName('MODELO_CFT').AsString;
    vDadosIni.vHistV.vNumNota := dataset.FieldByName('NUM_NF').AsInteger;
    vDadosIni.vHistV.vSerieNF := dataset.FieldByName('SERIE').AsString;
    if dataset.FieldByName('NATUREZA_NF').AsString = 'E' then
      vDadosIni.vHistV.vStatusNF := stsFechada
    else
      vDadosIni.vHistV.vStatusNF := get_status;
    vDadosIni.vHistV.vSituacaoNF := get_situacao_nfe;
    vDadosIni.vHistV.vModeloNF := dataset.FieldByName('MODELO_NF').AsString;
    vDadosIni.vHistV.vEmissaoPropriaNF := dataset.FieldByName('EMISSAO_PROPRIA').AsString;
    vDadosIni.vHistV.vValorOP := vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat;
    vDadosIni.vHistV.vData := dataset.FieldByName('DATA_LANC').AsString;
    vDadosIni.vHistV.vNatOP := vItem.dataset.FieldByName('CODIGO_NOP').AsFloat;
    vDadosIni.vHistV.vTipoVenda := buscas2.FieldByName('STATUS_USO').AsString;
    vDadosIni.vHistV.vCodCliente := dataset.FieldByName('COD_CLIENTE').AsInteger;
    vDadosIni.vHistV.vCodCliVend := 0;
    vDadosIni.vHistV.vCodConcess := 0;
    vDadosIni.vHistV.vCodIntermed := 0;
    vDadosIni.vHistV.vCodVendedor := dataset.FieldByName('COD_VENDEDOR').AsInteger;
    vDadosIni.vHistV.vCodCondPag := dataset.FieldByName('COD_COND_PAG').AsInteger;
    if dataset.FieldByName('NATUREZA_NF').AsString = 'E' then
      vDadosIni.vHistV.vPrecCusto := vItem.dataset.FieldByName('VALOR_TOTAL').AsFloat
    else
      vDadosIni.vHistV.vPrecTabEst := vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat;
    vDadosIni.vHistV.vRedLucro := '';
    vDadosIni.vHistV.vTipvVeiculo := buscas2.FieldByName('TIPV_VEICULO').AsString;
    vDadosIni.vHistV.vStatusDemonst := buscas2.FieldByName('STATUS_DEMONST').AsString;
    vDadosIni.vHistV.vStatusEstoque := buscas2.FieldByName('STATUS_ESTOQUE').AsString;
    vDadosIni.vHistV.vStatusRes := buscas2.FieldByName('STATUS_RES').AsString;
    vDadosIni.vHistV.vStatusTransD := buscas2.FieldByName('STATUS_TRANSDEP').AsString;
    vDadosIni.vHistV.vStatusUso := buscas2.FieldByName('STATUS_USO').AsString;
    vDadosIni.vHistV.vStatusCanc := buscas2.FieldByName('STATUS_CANC').AsString;
    vDadosIni.vHistV.vStatusV := '';
    vDadosIni.vHistV.vPosicao := buscas2.FieldByName('POSICAO').AsString;
    vDadosIni.vHistV.vNComandoNF := dataset.FieldByName('N_COMANDO').AsInteger;
    vDadosIni.vHistV.vAlteraEstoqueCFOP := vItem.dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString;
    vDadosIni.GravarHistEstMoto(buscas2, dtmNF.SpIncCodNF, vDadosIni.vHistV);
  except
    on E: Exception do
    begin
      result := false;
      if inibeErro <> 'S' then
        Application.MessageBox(PChar('Erro ao Gravar Histórico Veículo.'), 'Atenção', MB_ICONWARNING + MB_OK);
      inibeErro := 'N';
      registraErro('E0007 ' + e.Message);
      RollBackTransacao;
      exit;
    end;
  end;
end;

function TNFCab.itemTributado(vCstCsosn: string): boolean;
var
  vTemp: string;
begin
  if vDadosIni.vEmp.vRegime = 'SIMPLES' then
    Result := (vCstCsosn = '101') or (vCstCsosn = '201') or (vCstCsosn = '202') or (vCstCsosn =
      '203') or (vCstCsosn = '900')
  else
  begin
    vTemp := Copy(vCstCsosn, 2, 2);
    Result := (vTemp = '00') or (vTemp = '10') or (vTemp = '20') or (vTemp = '30') or (vTemp =
      '70') or (vTemp = '90');
  end;
end;

function TNFCab.itemTributadoST(vCstCsosn: string): boolean;
var
  vTemp: string;
begin
  if vDadosIni.vEmp.vRegime = 'SIMPLES' then
    Result := (vCstCsosn = '201') or (vCstCsosn = '202') or (vCstCsosn = '203') or (vCstCsosn = '900')
  else
  begin
    vTemp := Copy(vCstCsosn, 2, 2);
    Result := (vTemp = '10') or (vTemp = '30') or (vTemp = '70') or (vTemp = '90');
  end;
end;

