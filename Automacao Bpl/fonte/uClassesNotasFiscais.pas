function TNFCab.getCSTPorCSOSN(ACST, ACSOSN: string): string;
var
  AOrigem: string;
  LCST: TStrings;
  I: Integer;
begin
  LCST :=  TStringList.Create;
  try
    if Length(ACST) = 3 then
    begin
      AOrigem := Copy(ACST, 1, 1);
      ACST    := Copy(ACST, 2, 2);
    end
    else if Length(ACST) = 2 then
      AOrigem := '0'
    else
    begin
      ACST := '';
      AOrigem := '0';
    end;

    if FListRelCSOSNCST = nil then
    begin
      FListRelCSOSNCST := TStringList.Create;
      FListRelCSOSNCST := vDadosIni.getConfSisBlob('prod_cad_relacao_cst_csosn', buscas);
    end;

    for I := 0 to FListRelCSOSNCST.Count - 1 do
    begin
      if Pos( '|' + ACSOSN + '|', FListRelCSOSNCST[I]) > 0 then
        LCST.Add( vDadosIni.getValue(FListRelCSOSNCST[i], 1) );
    end;

    for I := 0 to LCST.Count - 1 do
      if ACST = LCST[I] then
      begin
        Result := AOrigem + ACST;
        Exit;
      end;

    if LCST.Count > 0 then
      Result := AOrigem + LCST[0]
    else if vItem.vrDadosItem.cst_icm_mono(AOrigem + ACST) then
      Result := AOrigem + ACST         
    else
      Result := getCst(AOrigem + ACST, ACSOSN);
  finally
    FreeAndNil(LCST);
  end;
end;

