function TNFCab.adicionaVendaAnotaFiscal(pUsarValorNf,
  pUsarUmaVendaPorNF: Boolean; var AListMensagens: TStrings;
  CSTentrada: string; CFOPentrada: Integer): boolean;
var
  vOK: Boolean;
  vValorDesconto: Currency;
  I: Integer;
  vrDesc: Extended;
  vrDescNF: Extended;
  vrTotal: Extended;
  vrTot: Extended;
  vDif: Extended;
  vAlt: Boolean;
  AStrText: string;
  vAcCampoOutras: Double;
  prodsTemp: THw_produtos_tmp_classList;
  clienteEntrega: TVw_clientes_dest_class;
  endSeqid: Integer;
begin
  //vMensCupom := False;
  if not (dataSet.State in [dsInsert, dsEdit]) then
  begin
    Result := False;
    exit;
  end;
  try
    if vPedVNf.dataSet.IsEmpty then
      raiseExceptionCreate('Nenhuma Venda encontrada', '');
    //  begin
    //    Result := False;
    //    exit;
    //  end;
    if vPedVNf.vItem.dataSet.IsEmpty then
      raiseExceptionCreate('Venda sem itens', '');
    //  begin
    //    Result := False;
    //    exit;
    //  end;
    if (fstr('natureza_nf') = 'E') then
    begin
      if not SqlOpen('select nf.cod_nf, nf.num_nf, nf.serie, nf.data_lanc, nf.status, nf.situacao_nfe' +
                     ' from pedvenda_ref_nf pvr' +
                     ' inner join notafiscal nf on nf.cod_nf = pvr.cod_nf and nf.cod_empresa = pvr.cod_empresa' +
                     ' where pvr.nped = %d and pvr.tipo = %s and pvr.cod_empresa = %s' +
                     ' and nf.status in (''Aberta'', ''Fechada'') and nf.natureza_nf = ''E'' ' +
                     ' order by nf.data_lanc, nf.num_nf',
                     [vPedVNf.fint('nped'), vPedVNf.fstrq('tipo'), vDadosIni.codEmpresa]).IsEmpty then
        if vDadosIni.ShowConfirmacao('Já existe nota fiscal de entrada para esta venda ' + sLineBreak +
                                     'Código: %s' + sLineBreak +
                                     'Número: %s' + sLineBreak +
                                     'Série: %s' + sLineBreak +
                                     'Data: %s' + sLineBreak +
                                     'Status: %s' + sLineBreak +
                                     'Situação NFe: %s' + sLineBreak + sLineBreak +
                                     'Deseja adicionar a venda mesmo assim?',
                                     [buscas.FieldByName('cod_nf').AsString,
                                      buscas.FieldByName('num_nf').AsString,
                                      buscas.FieldByName('serie').AsString,
                                      buscas.FieldByName('data_lanc').AsString,
                                      buscas.FieldByName('status').AsString,
                                      buscas.FieldByName('situacao_nfe').AsString]) <> IDYES then
        begin
          vDadosIni.Auditoria('NF0215', 'INCLUIR', vPedVNf.fstr('tipo') + ' ' + vPedVNf.fstr('nped') + ' NAO ADICIONADA', 'NOTAFISCAL', '');
          Result := False;
          Exit;
        end
        else if not vDadosIni.PesqPros('NF0216', 'VALIDAR', vPedVNf.fstr('tipo') + ' ' + vPedVNf.fstr('nped'), 'NOTAFISCAL', '', buscas) then
        begin
          Result := False;
          Exit;
        end;
      vDadosIni.Auditoria('NF0215', 'INCLUIR', vPedVNf.fstr('tipo') + ' ' + vPedVNf.fstr('nped'), 'NOTAFISCAL', '');
    end;

    if (fstr('natureza_nf') = 'E') and (fint('num_nf') = 0) then
    begin
      dataset.FieldByName('codigo_nop').AsFloat       := CFOPentrada;
      dataset.FieldByName('emissao_propria').AsString := 'S';
      dataset.FieldByName('num_nf').AsInteger         := vPedVNf.fint('nped');
      dataSet.FieldByName('modelo_nf').AsString       := vDadosIni.vEmp.vNfe.modeloNF;
      dataSet.FieldByName('serie').AsString           := IntToStr(vDadosIni.vEmp.vSubSerieNotaFiscal);
      exitCodigoTabela('NAT_OP');
    end;
    if dataSet.FieldByName('cod_cond_pag').AsInteger = 0 then
    begin
      dataSet.FieldByName('cod_cond_pag').AsInteger :=
        vPedVNf.dataSet.FieldByName('cod_cond_pag').AsInteger;
    end;
    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
    begin
      dataSet.FieldByName('cod_cliente').AsInteger := IfThen(vPedVNf.fint('cod_cli_fat') > 0, vPedVNf.fint('cod_cli_fat'), vPedVNf.fint('cod_cliente'));
      if vPedVNf.fint('cod_cli_fat') > 0 then
      begin
        endSeqid := queryCons.Table('pedvenda', 'coalesce(dest_seqid_entrg, dest_seqid)')
          .Equals('nped', vPedVNf.fint('nped'))
          .Equals('tipo', vPedVNf.fstr('tipo'))
          .Equals('cod_empresa', vDadosIni.cod_empresa)
          .Scalar.AsInteger;

        dataSet.FieldByName('cod_cli_ped').AsInteger := vPedVNf.f_int('cod_cliente');

        clienteEntrega := TVw_clientes_dest_class.Create;
        clienteEntrega.SetValuesFrom(
          SqlOpen('select * from VW_CLIENTES_DEST' +
                   ' where cod_cliente = %d and dest_seqid = %d and cod_empresa = %s and ativo = 1',
                   [fint('cod_cli_ped'), endSeqid, vDadosIni.codEmpresa], buscas));

        entrega.Insert;
        entrega.dataSet.FieldByName('XNOME').AsString := clienteEntrega.razao;
        entrega.dataSet.FieldByName('CPFCNPJ').AsString := clienteEntrega.cpfcgc;
        entrega.dataSet.FieldByName('IE').AsString := clienteEntrega.insc_est;
        entrega.dataSet.FieldByName('CEP').AsString := clienteEntrega.cep;
        entrega.dataSet.FieldByName('XLGR').AsString := clienteEntrega.logradouro;
        entrega.dataSet.FieldByName('NRO').AsString := clienteEntrega.numero;
        entrega.dataSet.FieldByName('XCPL').AsString := clienteEntrega.complemento;
        entrega.dataSet.FieldByName('XBAIRRO').AsString := clienteEntrega.bairro;
        entrega.dataSet.FieldByName('CMUN').AsInteger := clienteEntrega.cmun;
        entrega.dataSet.FieldByName('XMUN').AsString := clienteEntrega.cidade;
        entrega.dataSet.FieldByName('CPAIS').AsInteger := clienteEntrega.cpais;
        entrega.dataSet.FieldByName('XPAIS').AsString := clienteEntrega.xpais;
        entrega.dataSet.FieldByName('FONE').AsString := clienteEntrega.telefone;
        entrega.dataSet.FieldByName('EMAIL').AsString := clienteEntrega.email;
        entrega.dataSet.FieldByName('UF').AsString := clienteEntrega.uf;
        entrega.Post;

        dataSet.FieldByName('dest_seqid').AsInteger := 0;
      end
      else
      begin
        dataSet.FieldByName('cod_cli_ped').Value := Null;
        dataSet.FieldByName('dest_seqid').AsInteger := vPedVNf.f_int('dest_seqid');
      end;
