      SetLength(FFatura.despesas[i].valorDocumento,0);
      SetLength(FFatura.despesas[i].Controle,0);
    end;
  end;
  Result := True;
end;

function TNFCab.cancelarNotaFiscal(origem: TOrigemCancelamento): boolean;
var
  vTemp: string;
  buscas2: TIBQuery;
  vPrecCusProd: Currency;
  vPrecCusMProd: Currency;
  vPrecCusMNF: Currency;
  vDataUltCompra: TDate;
  vNumNfRec: Integer;
  vCodDev: Integer;
  vAberta: Boolean;
  vUpdateTemp: string;
  vListaAtualizarValorPedVenda: TStringList;
  I: Integer;
begin
  vUpdateTemp := '';
  vListDocPrgFid.Clear;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if origem = ocDefault then
    if not vDadosIni.PesqPros('NF0026', 'CANCELAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString + ' NATUREZA ' +
      dataSet.FieldByName('natureza_nf').AsString, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
      Exit;
  Result := false;
  if dataSet.IsEmpty then
    Exit;
  dataSet.RefreshRecord;
  if get_status = stsCancelada then
  begin
    Application.MessageBox('Nota Fiscal já esta cancelada', 'Atenção', mb_ok +
      MB_ICONINFORMATION);
    exit;
  end;
  if get_status <> stsFechada then
    if (dataSet.FieldByName('natureza_nf').AsString <> 'E') or
      ((get_situacao_nfe <> sitInutilizada) and
      (get_situacao_nfe <> sitDenegada) and
      (get_situacao_nfe <> sitCancelada)) then
    begin
      Application.MessageBox('Nota Fiscal não esta Fechada', 'Atenção', mb_ok +
        MB_ICONINFORMATION);
      exit;
    end;
  if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
    (dataSet.FieldByName('emissao_propria').AsString <> 'S') then
  begin
    Application.MessageBox('Nota Fiscal de Terceiro. É necessário apagar', 'Atenção', mb_ok +
      MB_ICONINFORMATION);
    exit;
  end;
  if (dataSet.FieldByName('tipo_nf').AsString = 'V') and
    (dataSet.FieldByName('natureza_nf').AsString = 'S') and
    (dataSet.FieldByName('n_comando').AsInteger > 0) then
  begin
    buscas.close;
    buscas.SQL.Text := 'select * from com_fat where n_comando = ' +
      dataSet.FieldByName('n_comando').AsString +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa + ' AND ATIVO = 1';
    buscas.Open;
    if (buscas.FieldByName('DIA_CXL').IsNull) or (buscas.FieldByName('DIA_CXL').AsString = '') then
    else
    begin
      buscas.close;
      Application.MessageBox(pchar('Documento já Recebido Pelo Caixa da Loja'),
        'Informação', 0 + 64);

      if vDadosIni.vEmp.vVersaoVeiculos = '4' then
      begin
        if not vDadosIni.PesqPros('VEI087', 'PERMITIR', 'CANCELAR RECEBIMENTO CXL', 'COM_FAT',
           dataSet.FieldByName('n_comando').AsString, buscas, true) then
          exit;
      end
      else
      begin
        if not vDadosIni.PesqPros('HW478', 'EDITAR', 'CANCELAR RECEBIMENTO CXL', 'COM_FAT',
          dataSet.FieldByName('n_comando').AsString, buscas, True) then
          Exit;
      end;
      if Application.MessageBox('Deseja realmente excluir o recebimento do Comando?',
        'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDYES then
      begin
        ExecutaComandosSqlExec('update com_fat set status_cxl_rq = null, dia_cxl = null' +
          ' where n_comando = ' + dataSet.FieldByName('n_comando').AsString +
          ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1');
        CommitaTransacao;
      end;
      Exit;
    end;
  end;

  if origem = ocDefault then
    if Application.MessageBox('Deseja mesmo Cancelar a Nota Fiscal?', 'Atenção', MB_YESNO + MB_ICONQUESTION) = ID_NO then
      Exit;

  if (dataSet.FieldByName('MODELO_NF').AsString = '55') and
    (dataSet.FieldByName('emissao_propria').AsString = 'S') and
    (get_situacao_nfe <> sitInutilizada) and
    (get_situacao_nfe <> sitDenegada) and
    (get_situacao_nfe <> sitCancelada) and
    (get_status <> stsCancelada) then
  begin
    vTemp := 'N';
