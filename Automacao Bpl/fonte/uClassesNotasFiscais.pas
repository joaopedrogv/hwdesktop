          ' and pvp.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
          ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvp.n_nf is null');
        if Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = 'REQ' then
          ExecutaComandosSqlExec(
            'update reqvenda_itens pvp' +
            ' set pvp.n_nf = null, serie = null' +
            ' where pvp.nreq = ' + vItem.dataSet.FieldByName('nped').AsString +
            ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and not pvp.n_nf is null')
        else
          ExecutaComandosSqlExec(
            'update os_item_prod pvp' +
            ' set pvp.n_nf = null, serie = null' +
            ' where pvp.n_os = ' + vItem.dataSet.FieldByName('nped').AsString +
            ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and not pvp.n_nf is null');
      end
      else if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select pvs.vl_desp_nf from pedvenda_serv pvs' +
          ' where pvs.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
          ' and pvs.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
          ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
          ' and pvs.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
          ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvs.n_nf is null';
        buscas.Open;

        vRecalcularVlTotPedV := buscas.FieldByName('vl_desp_nf').AsFloat > 0;

        ExecutaComandosSqlExec(
          'update pedvenda_serv pvs' +
          ' set pvs.n_nf = null, serie = null' +
          ' where pvs.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
          ' and pvs.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
          ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
          ' and pvs.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
          ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvs.n_nf is null');
        ExecutaComandosSqlExec(
          'update os_item_serv pvs' +
          ' set pvs.n_nf = null, serie = null' +
          ' where pvs.n_os = ' + vItem.dataSet.FieldByName('nped').AsString +
          ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
          ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and not pvs.n_nf is null');
      end;

      if vRecalcularVlTotPedV then
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) <> '') then
          if not atualizaValorTotalPedVenda(
            Trim(vItem.dataSet.FieldByName('tipo_ped').AsString),
            vItem.dataSet.FieldByName('nped').AsInteger, [opvAtualizarTotal]) then
          begin
            Result := False;
            Exit;
