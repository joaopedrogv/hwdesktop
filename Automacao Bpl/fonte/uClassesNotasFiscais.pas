{ TCalculo_Faturamento_Group }

procedure TCalculo_Faturamento_Group.addCFOP(value: Integer);
var
  addit: Boolean;
  J: Integer;
begin

  addit := True;
  for J := Low(cfops) to High(cfops) do
    if not addit then
      Break
    else if cfops[J] = value then
      addit := False;

  if addit then
  begin
    SetLength(cfops, Length(cfops) + 1);
    cfops[High(cfops)] := value;
  end;
end;

procedure TCalculo_Faturamento_Group.buildProdutosTemporarios();
var
  prodsTemp: THw_produtos_tmp_classList;
begin
  SetLength(cfops, 0);
  temps.Clear;

  prodsTemp := THw_produtos_tmp_classList(temps);
  FOwner.vItem.dataSet.First;
  while not FOwner.vItem.dataSet.Eof do
  begin

    addCFOP(FOwner.vItem.fint('codigo_nop'));

    if (FOwner.vItem.f_str('tipo_item') = 'P') then
      if not Assigned(prodsTemp.GetProduto_tmp(FOwner.vItem.f_int('grupo_prod'), FOwner.vItem.f_str('cod_prod'))) then
      begin
        with prodsTemp.New do
        begin
          id_tmp      := id_prod_tmp;
          seqid       := prodsTemp.Count; //FOwner.vItem.f_int('nitem');
          cod_empresa := FOwner.vItem.f_int('cod_empresa');
          grupo_prod  := FOwner.vItem.f_int('grupo_prod');
          cod_prod    := FOwner.vItem.f_str('cod_prod');
        end;
      end;

    if //(TTipoCalculo(FOwner.vItem.fint('tipo_calc')) <> tcNenhum) and
      (FOwner.vItem.f_str('tipo_item') = 'S') then
      if not Assigned(prodsTemp.GetProduto_tmp(FOwner.vItem.fint('cod_servico'), 'SERV')) then
        with prodsTemp.New do
        begin
          id_tmp      := id_prod_tmp;
          seqid       := prodsTemp.Count;//FOwner.vItem.f_int('nitem');
          cod_empresa := FOwner.vItem.f_int('cod_empresa');
          grupo_prod  := FOwner.vItem.f_int('cod_servico');
          cod_prod    := 'SERV';
        end;

    FOwner.vItem.dataSet.Next;
  end;
end;

function TCalculo_Faturamento_Group.calculo_faturamento_completo_obterdados(
  forceGetData: Boolean;
  itens: TObjectList): Boolean;
begin
  Result := False;

  Fnf.SetValuesFrom(FOwner.dataSet, True);

  Fnf.erros.Clear;
  Ffat.erros.Clear;

  if itens = nil then
  begin
    if forceGetData then
    begin
      seq := seq + 1;
      id_prod_tmp := 'NF' + PadL(FOwner.fint('cod_nf'),  6) + PadL(seq, 3);

      buildProdutosTemporarios;
    end;
    itens := temps;
  end;

  Result := Fnf.notafiscal_calcular_completa_obterdados(id_prod_tmp, THw_produtos_tmp_classList(itens), cfops, forceGetData).erros.Count = 0;
end;

function TCalculo_Faturamento_Group.calculo_faturamento_individual_executar(
  silent: Boolean; 
  forceGetData: Boolean): Boolean;
var
  prodsTemp    : THw_produtos_tmp_classList;
  newProds     : THw_produtos_tmp_classList;
begin
  Result := False;

  if forceGetData or (Fnf.tipo_nf = '') then
  begin    
    Fnf.erros.Clear;
    Ffat.erros.Clear;
    newProds := THw_produtos_tmp_classList(temps);

    if FOwner.vItem.vrDadosItem.tipo_item = 'P' then
    begin
      if not Assigned(newProds.GetProduto_tmp(FOwner.vItem.vrDadosItem.grupo_prod, FOwner.vItem.vrDadosItem.cod_prod)) then
        with newProds.New do
        begin
          id_tmp      := id_prod_tmp;
          seqid       := newProds.Count; //FOwner.vItem.f_int('nitem');
          cod_empresa := vDadosIni.cod_empresa;
          grupo_prod  := FOwner.vItem.vrDadosItem.grupo_prod;
          cod_prod    := FOwner.vItem.vrDadosItem.cod_prod;
        end;
    end
    else if FOwner.vItem.vrDadosItem.tipo_item = 'S' then
      if not Assigned(newProds.GetProduto_tmp(FOwner.vItem.vrDadosItem.cod_servico, 'SERV'))  then
        with newProds.New do
        begin
          id_tmp      := id_prod_tmp;
          seqid       := newProds.Count; //FOwner.vItem.f_int('nitem');
          cod_empresa := vDadosIni.cod_empresa;
          grupo_prod  := FOwner.vItem.vrDadosItem.cod_servico;
          cod_prod    := 'SERV';
        end;

    addCFOP(Trunc(FOwner.vItem.vrDadosItem.codigo_nop));

    Fnf.SetValuesFrom(FOwner.dataSet, True);
    if Fnf.notafiscal_calcular_completa_obterdados(id_prod_tmp, newProds, cfops, True).erros.Count > 0 then
    begin
      Result := False;
      if not silent then
        vDadosIni.ShowErro(Fnf.erros.formato_TStrings.Text);
      Exit;
    end;

    forceGetData := False;
  end;

  if (forceGetData) or
     (Fnf.tipo_nf = '') or
     (Fnf.cod_cliente      <> FOwner.fint('cod_cliente')) or
     (Fnf.nfe_indiedest    <> FOwner.fint('nfe_indiedest')) or
     (Fnf.dest_cmun        <> FOwner.fint('dest_cmun')) or
     (Fnf.finalidadeid     <> FOwner.fint('finalidadeid')) or
     (Fnf.cmunfgibs        <> FOwner.fint('cmunfgibs')) or
     (Fnf.dfe_trib_ignorar <> FOwner.fint('dfe_trib_ignorar')) or
     (FOwner.fdif('op_interna_id'   , Fnf.op_interna_id)) or
     (FOwner.fdif('nfe_iddest'      , Fnf.nfe_iddest)) or
     (FOwner.fdif('tipo_emissao'    , Fnf.tipo_emissao)) or
     (FOwner.fdif('consumidor_final', Fnf.consumidor_final))
  then
  begin
    Fnf.SetValuesFrom(FOwner.dataSet, True);
    if Assigned(Fnf.cliente) then
      Fnf.cliente.cod_cliente := 0;
  end;

  Fnf.erros.Clear;
  Ffat.erros.Clear;

  Fnf.valor_prod := Fnf.valor_prod + FOwner.vItem.vrDadosItem.valor_total - IfThen(FOwner.vItem.vrDadosItem.stado = dsEdit, FOwner.vItem.ffloat('valor_total'));

  Result := Fnf.notafiscal_calcular_item_individual(THw_notafiscal_item_class(FOwner.vItem.vrDadosItem)).erros.Count = 0;

  if (not Result) then
  begin
    if not silent then
      vDadosIni.ShowErro(Fnf.erros.formato_TStrings.Text);
  end
  else if FOwner.vItem.vrDadosItem.tipo_item = 'P' then
    if Assigned(FOwner.vItem.vrDadosItem.merc) then
      if (FOwner.vItem.vrDadosItem.grupo_prod     = FOwner.vItem.vrDadosItem.merc.grupo_prod) and
         (Trim(FOwner.vItem.vrDadosItem.cod_prod) = Trim(FOwner.vItem.vrDadosItem.merc.cod_prod)) then
        FOwner.vItem.vrDadosItem.FAliqProduto := FOwner.vItem.vrDadosItem.merc.icm_prod;
end;

constructor TCalculo_Faturamento_Group.create(AOwner: TNFCab);
begin
  FOwner := AOwner;
  Ffat   := THw_faturamento.Create;
  Fativo := true;
  temps  := THw_produtos_tmp_classList.Create;
  seq    := 0;  
end;

destructor TCalculo_Faturamento_Group.Destroy;
begin
  if Assigned(Ffat) then FreeAndNil(Ffat);
  temps.Free;
  inherited;
end;

function TCalculo_Faturamento_Group.inicializar: TCalculo_Faturamento_Group;
begin
  Result := Self;
  Ffat.notas.Clear;
  Fnf := Ffat.notas.New;

  if Assigned(Fdet) then
    FreeAndNil(Fdet);
  Fdet := THw_notafiscal_item_class.Create(Fnf);

  if Assigned(temps) then
    FreeAndNil(temps);
  temps := THw_produtos_tmp_classList.Create;

  seq := seq + 1;
  id_prod_tmp := 'NF' + PadL(FOwner.fint('cod_nf'),  6) + PadL(seq, 3);
  if Ffat.Transacao.InTransaction then
    Ffat.Transacao.Rollback;

  buildProdutosTemporarios;
    
end;

{ TNFItemBase }

constructor TNFItemBase.Create;
begin
  inherited Create;

  if FUndsVnds = nil then
    FUndsVnds := TUnidadeVendas_Model.Create;

  if dataSet <> nil then
    dataSet.OnCalcFields := DataSetCalcFields;
end;

procedure TNFItemBase.DataSetCalcFields(DataSet: TDataSet);
begin
  if DataSet.State = dsInternalCalc then
  begin
    HandleCamposUVND;

    dataSet.FieldByName('peso_b_total').AsFloat  := ffloat('peso_b') * ffloat('quantidade');
  end;
end;

destructor TNFItemBase.Destroy;
begin
  FUndsVnds.Free;
  inherited;
end;

procedure TNFItemBase.HandleCamposUVND;
var
  unCalc: TUnidadeVenda_Model;
begin
  if (not fempty('unidade_nf')) then
  begin

    dataSet.FieldByName('uvnd').AsString := fstr('unidade_nf');
    dataSet.FieldByName('qvnd').AsFloat  := ffloat('qtdembrec');
    dataSet.FieldByName('vvnd').AsFloat  := ffloat('vlrembnf');

    if (ffloat('qtdemb') > 0) and (ffloat('qtdembrec') > 0) and (ffloat('vlrembnf') > 0) then
    begin
      unCalc := FUndsVnds.GetUnd(fint('grupo_prod'), fstr('cod_prod'), fstr('uvnd'));
      try
        if (unCalc = nil) then
        begin
          FUndsVnds.CopyFrom(TUnidadeVenda_Model,
            queryCons.Table('vw_produtos_conversao', '*')
             .Equals('grupo_prod', fint('grupo_prod'))
             .Equals('cod_prod', fstr('cod_prod'))
             .Equals('cod_empresa', vDadosIni.cod_empresa)
             .Open().query);
          unCalc := FUndsVnds.GetUnd(fint('grupo_prod'), fstr('cod_prod'), fstr('uvnd'));
        end;

        if unCalc = nil then
        begin
          unCalc := TUnidadeVenda_Model.Create;

          unCalc.unid_princ := fstr('referencia');
          unCalc.unid_vnd   := fstr('uvnd');
          unCalc.fator      := ffloat('qtdemb');
          unCalc.quantidade := 1 / unCalc.fator;
          FUndsVnds.Add(unCalc)
        end;

        dataSet.FieldByName('paridade').AsString := unCalc.paridade;
      finally
        //unCalc.Free;
      end;
    end;

  end
  else if (not fempty('ucom')) and (ffloat('qcom') > 0) and (ffloat('vuncom') > 0) then
  begin
    dataSet.FieldByName('uvnd').AsString     := fstr('ucom');
    dataSet.FieldByName('qvnd').AsFloat      := ffloat('qcom');
    dataSet.FieldByName('vvnd').AsFloat      := ffloat('vuncom');
    dataSet.FieldByName('paridade').AsString := '';
  end
  else
  begin
    dataSet.FieldByName('uvnd').AsString     := fstr('referencia');
    dataSet.FieldByName('qvnd').AsFloat      := ffloat('quantidade');
    dataSet.FieldByName('vvnd').AsFloat      := ffloat('valor_unitario');
    dataSet.FieldByName('paridade').AsString := '';
  end;
end;

{ TNFInteg }

procedure TNFInteg.cadNFInteg(tipoForm: integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Notas Fiscais (Suzuki)');
    if dtmNF = nil then
      dtmNF := TdtmNF.Create(dtmNF);

    vDadosIni.vTipoForm := tipoForm;

    if not vDadosIni.PesqPros('NF0258', 'CONSULTA', '', 'VW_NOTAFISCAL_INTEG', '',
      dtmNF.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmNfInteg = nil then
    begin
      if tipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmNfInteg, frmNfInteg);
    end;

    if (tipoForm > 0) and (not frmNfInteg.Visible) then
      frmNfInteg.ShowModal
    else if (not frmNfInteg.Visible) then
      frmNfInteg.Show
    else if frmNfInteg.FormStyle = fsMDIChild then
      frmNfInteg.Show
    else
      frmNfInteg.ShowModal;
  finally
  	vDadosIni.fechaStatusProcessamento;
  end;
end;

constructor TNFInteg.create;
begin
	if dtmNF = nil then
    dtmNF := TdtmNF.Create(dtmNF);

  dataSet := TClientDataSet(dtmNF.cdsNfInteg);
  transacao := TIBTransaction(dtmNF.transacaoNF);
  buscas := TIBQuery(dtmNF.qrBuscas);
end;

function TNFInteg.enviar: Boolean;
var
  vHabSuzuki: Boolean;
	ids: array of Integer;
begin
	try
  	if not vDadosIni.PesqPros('NF0260', 'ENVIAR', '', 'VW_NOTAFISCAL_INTEG', '',
    	buscas, true) then
    		Exit;

    vHabSuzuki := vDadosIni.retornaDadosSuzuki(buscas, True) <> '';

    if not vHabSuzuki then
    	Exit;

  	SetLength(ids, 0);

    try
      dataSet.Filtered := false;
      dataSet.Filter := 'sel = ''S'' ';
      dataSet.Filtered := true;

      if dataSet.IsEmpty then
      begin
        Application.MessageBox('Nenhuma notafiscal selecionada.', 'Atenção',
          MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        dataSet.Refresh;
        exit;
      end;

      if Application.MessageBox('Deseja enviar notas fiscais?',
  	    'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
	  	    Exit;

      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          SetLength(ids, Length(ids) + 1);
          ids[High(ids)] := fint('COD_NF');

          vDadosIni.GravaAuditoria('NF0260', 'ENVIAR', '', 'VW_NOTAFISCAL_INTEG', fstr('COD_NF'), buscas);
        end;

        dataSet.Next;
      end;
    finally
      dataSet.Filtered := false;
      dataSet.First;
      dataSet.EnableControls;
    end;

    if Length(ids) > 0 then
    begin
    	try
        vDadosIni.abreStatusProcessamento('', 'Enviando Notas Fiscais');

        suzuki_vendaveiculos(
          Format(';databaseName=%s;empresaid=%s;silent=true;userHW=HW;userLevel=10',
          [vDadosIni.vBancoHW, vDadosIni.codEmpresa]), ids);
      finally
      	vDadosIni.fechaStatusProcessamento;
      end;

      vDadosIni.GravaAuditoria('NF0260', 'ENVIAR', 'SUCESSO', 'VW_NOTAFISCAL_INTEG', '', buscas);
    end
    else
    	vDadosIni.GravaAuditoria('NF0260', 'ENVIAR', 'FALHA', 'VW_NOTAFISCAL_INTEG', '', buscas);

  except
    on e: Exception do
    begin
      Result := false;
      Application.messagebox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('TNFInteg.enviar ' + e.Message);
    end;
  end;
end;

function TNFInteg._abreNFInteg: Boolean;
begin
	Result := montaSelect(' select * from vw_notafiscal_integ ' +
  	' where cod_nf = 0 ' +
    ' and cod_empresa = 0 ');
end;

