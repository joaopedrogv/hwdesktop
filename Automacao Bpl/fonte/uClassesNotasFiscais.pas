function TNFCab.teclaAtalho(tabela, tecla: string): boolean;
var
  codigo, vCodCl: integer;
  codigoStr: string;
begin
  if notaFechada then
    exit;
  if UpperCase(tabela) = 'CLIENTES' then
  begin
    if tecla = 'F3' then
    begin
      vCodCl := dataSet.FieldByName('cod_cliente').AsInteger;
      codigo := vClFor.pesquisaCliente(dataSet.FieldByName('natureza_nf').AsString);
      if (dataSet.State in [dsInsert, dsEdit]) then
        dataSet.FieldByName('cod_cliente').AsInteger := codigo;
      if codigo <> 0 then
        exitCodigoTabela(UpperCase(tabela))
      else
        dataSet.FieldByName('cod_cliente').AsInteger := vCodCl;
      //        vClFor.selecionaClFor(codigo);
    end
    else if tecla = 'F4' then
      vClFor.cadastrarClFor;
  end
  else if UpperCase(tabela) = 'PRODUTOS' then
  begin
    if tecla = 'F3' then
    begin
      vDadosIni.vPesquisa := vItem.vProd.pesquisaProduto;
      Result := Trim(vDadosIni.vPesquisa) <> '';
    end
    else if tecla = 'F4' then
      vItem.vProd.cadastraProduto;
  end
  else if (UpperCase(tabela) = 'TIPO_SERVICO') or (UpperCase(tabela) = 'SERVICOS_EMP') then
  begin
    if tecla = 'F3' then
    begin
      vDadosIni.vPesquisa := vItem.vServ.pesquisaTipoServico;
      Result := Trim(vDadosIni.vPesquisa) <> '';
    end
    else if tecla = 'F4' then
      vItem.vServ.cadastraTipoServico;
  end
  else if UpperCase(tabela) = 'COND_PAG' then
  begin
    vDadosIni.vPesquisa := '';
    vCPag.cadastrarCondPag;
    if (Trim(vDadosIni.vPesquisa) <> '') and (dataSet.state in [dsEdit, dsInsert]) then
      dataSet.FieldByName('cod_cond_pag').AsString := Trim(vDadosIni.vPesquisa);
  end
  else if UpperCase(tabela) = 'TRANSPORTADOR' then
  begin
    if tecla = 'F3' then
    begin
      codigo := vTr.pesquisaTransportador;
      if dataSet.State in [dsInsert, dsEdit] then
        dataSet.FieldByName('codigo_tr').AsInteger := codigo;
      if codigo <> 0 then
        vTr.selecionaTransportador(codigo);
    end
    else if tecla = 'F4' then
      vTr.cadastrarTransportador;
  end
  else if UpperCase(tabela) = 'NAT_OP' then
  begin
    if tecla = 'F3' then
    begin
      codigo := vCfop.pesquisaNaturezaDeOperacao;
      if dataSet.State in [dsInsert, dsEdit] then
        dataSet.FieldByName('codigo_nop').AsFloat := codigo;
      //      begin
      vCfop.selecionaCfop(codigo);

      //end; //if codigo <> 0 then
    end;
  end
  else if UpperCase(tabela) = 'NAT_OP_DESCRICAO' then
  begin
    if tecla = 'F3' then
    begin
      codigoStr := vCfop.vCfopDesc.pesquisaDescricaoNaturezaDeOperacao;
      if dataSet.State in [dsInsert, dsEdit] then
        dataSet.FieldByName('desc_natop').AsString := codigoStr;
      if codigoStr <> '' then
        vCfop.vCfopDesc.selecionaDescricao(codigoStr);
    end;
  end;
end;

function TNFCab.tentarSCAN: boolean;
begin
  Result := False;
  Exit;
  {
  if ((dataSet.FieldByName('num_nf').AsInteger = 0) and (dataSet.FieldByName('natureza_nf').AsString = 'S')) or
  ((dataSet.FieldByName('natureza_nf').AsString = 'E') and (dataSet.FieldByName('NUM_GERADO').AsString <> 'S')) then
  begin
    if (dataSet.FieldByName('emissao_propria').AsString = 'S') then
    begin
      vDadosIni.atualizarVariaveisEmpresa(buscas);
      if (dataSet.FieldByName('modelo_nf').AsString = '55') and
        (vDadosIni.vEmp.vNfe.danfeFormaEmissao = 'SCAN') then
      begin
        Application.ProcessMessages;
        Application.MessageBox(pchar('Configuração do SCAN ativada.'+sLineBreak+
          'O Sistema irá verificar o Status do servidor SCAN na RFB'),
          'Atenção',0+64);
        //Usar metodo da dll para verificar o Status do servidor SCAN
        if VerificaSCAN(StrToInt(vDadosIni.codEmpresa), pchar(vDadosIni.vBancoHW) ) = 107 then
        begin
          Application.ProcessMessages;
          Result :=  Application.MessageBox(pchar('SCAN ativado pela SEFAZ de Origem'+sLineBreak+
            'Deseja enviar nota fiscal pelo servidor SCAN na RFB?'),'Confirmação',MB_ICONQUESTION+MB_YESNO) = IDYES;
        end;
      end;
    end;
  end;
  }
end;

