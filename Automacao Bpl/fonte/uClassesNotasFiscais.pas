                vItem.vrDadosItem.codigo_nop := vDadosIni.vEmp.vCfopPadraoServ;
                vItem.vrDadosItem.codigo_nop :=
                  StrToFloat(getCfopCorreto(FloatToStr(vItem.vrDadosItem.codigo_nop)));
                if vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat > 0 then
                begin
                  vItem.vrDadosItem.rateio_desconto := vDadosIni.StrToFloatFormat(
                    vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat, 2);
                  vValorDesconto := vValorDesconto + vItem.vrDadosItem.rateio_desconto;
                end;
                if not calcularValorItemDesconto then
                begin
                  if vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat > 0 then
                    vValorDesconto := vValorDesconto - vItem.vrDadosItem.rateio_desconto;
                  Result := False;
                  Exit;
                end;
                if not calcularValores(False) then
                begin
                  if vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat > 0 then
                    vValorDesconto := vValorDesconto - vItem.vrDadosItem.rateio_desconto;
                  Result := False;
                  Exit;
                end;
                Result := incluirItem;
                if not Result then
                  if vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat > 0 then
                    vValorDesconto := vValorDesconto - vItem.vrDadosItem.rateio_desconto;
              end;
            except
              on e: Exception do begin
                registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
                  dataSet.FieldByName('cod_nf').AsString + ' AdicionaVendaAnotaFiscal ' +
                  e.Message);
              end;
            end;
          end;
        end; //vOK
      end; //n_nf = 0
      vPedVNf.vItem.dataSet.Next;
    end;
    dataSet.FieldByName('VALOR_OUT_DESP').AsFloat := f_float('VALOR_OUT_DESP') + vAcCampoOutras;
    dataSet.FieldByName('VALOR_DESC').AsFloat := dataSet.FieldByName('VALOR_DESC').AsFloat + vValorDesconto;

    if (pUsarUmaVendaPorNF) and (vPedVNf.str_empty('nf_ac_calctrib')) then
    try
      recalcularDadosDaNotaFiscal;
      vrDesc := 0.00;
      vrTot := 0.00;
      vPedVNf.vItem.dataSet.First;
      while not vPedVNf.vItem.dataSet.Eof do
      begin
        vOK := False;
        if vPedVNf.vItem.dataSet.FieldByName('n_nf').AsInteger = 0 then
          if (vPedVNf.vItem.dataSet.FieldByName('tipo_item').AsString <> 'P') then
            vOK := Fservico
          else //if (vPedVNf.vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
            vOK := Fproduto;
        if vOK then
        begin
          if vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat > 0 then
            vrDesc := vrDesc + vPedVNf.vItem.dataSet.FieldByName('desconto').AsFloat;

          if (pUsarValorNf) and
            (vPedVNf.vItem.dataSet.FieldByName('vltot_ped_nf').AsCurrency > 0) then
            vrTot := vrTot + vPedVNf.vItem.dataSet.FieldByName('vltot_ped_nf').AsCurrency
          else
            vrTot := vrTot + vPedVNf.vItem.dataSet.FieldByName('vltot_ped_item').AsCurrency;
          vrTot := vrTot + vPedVNf.vItem.dataSet.FieldByName('acrescimo').AsFloat;
        end;
        vPedVNf.vItem.dataSet.Next;
      end;

      vrDescNF:= 0.00;
      vrTotal:= 0.00;
      try
        vItem.dataSet.Filter := 'nped = ' + IntToStr(vPedVNf.dataSet.FieldByName('nped').AsInteger) +
          ' and tipo_ped = ' + QuotedStr(vPedVNf.dataSet.FieldByName('tipo').AsString);
        vItem.dataSet.Filtered := True;

        vItem.dataSet.First;
        while not vItem.dataSet.Eof do
        begin
          if vItem.dataSet.FieldByName('rateio_desconto').AsFloat > 0 then
            vrDescNF := vrDescNF + vItem.dataSet.FieldByName('rateio_desconto').AsFloat;
          vrTotal := vrTotal + vItem.f_float('valor_total') +
                               vItem.f_float('valor_icmsub') +
                               vItem.f_float('valor_ipi') +
                               vItem.f_float('nfe_vipidevol') +
                               vItem.f_float('rateio_seguro') +
                               vItem.f_float('rateio_outdesp') +
                               IfThen(f_str('frete_f_nfe') <> 'S', vItem.f_float('rateio_frete')) +
                               vItem.f_float('valor_ii') +
                               vItem.f_float('fcp_vfcpst');

          vItem.dataSet.Next;
        end;

        if vDadosIni.StrToFloatFormat(vrTot - vrDesc, 2) <>
          vDadosIni.StrToFloatFormat(vrTotal - vrDescNF, 2) then
        begin
          vDif := //abs
          (vDadosIni.StrToFloatFormat(vrTot - vrDesc, 2) -
            vDadosIni.StrToFloatFormat(vrTotal - vrDescNF, 2));
          vAlt := False;
          vItem.dataSet.First;
          while not vItem.dataSet.Eof do
          begin
            if vItem.dataSet.FieldByName('rateio_desconto').AsFloat > 0 then
               if (vItem.dataSet.FieldByName('rateio_desconto').AsFloat - vDif) > 0 then
               begin
                 vItem.dataSet.Edit;
                 vItem.dataSet.FieldByName('rateio_desconto').AsFloat :=
                   vItem.dataSet.FieldByName('rateio_desconto').AsFloat - vDif;
                 vItem.dataSet.Post;
                 vAlt := True;
                 Break;
               end;
            vItem.dataSet.Next;
          end;
        end;
      finally
        vItem.dataSet.Filtered := False;
        vItem.dataSet.Filter := '';
      end;

    finally
    end;
    //verificaDevolucaoDeItensPedVenda;
  finally
    if validaDesconto('N') then
      recalcularDadosDaNotaFiscal;
    if (fstr('natureza_nf') = 'S') then
      pagNFe.pagamentoDosPedidos;

    //else
      somaTotaisNF;
    vItem.filterClear;
  end;
//  if vMensCupom then
//    Application.MessageBox('Existem cupons referenciados. Favor informar nos Dados Adicionais (Interesse do Fisco)', 'Atenção', +0 + 64);
end;

