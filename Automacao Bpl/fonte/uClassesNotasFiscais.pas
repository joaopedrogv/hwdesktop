function TNFCab.validaDesconto(campo: string): boolean;
begin //campo: 'P: Produtos - S: Serviços - N: Nota'
  try
    if notaFechada then
      Exit;
    if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
    begin
      dataSet.FieldByName('valor_desc_p').asfloat :=
        dataSet.FieldByName('valor_desc').asfloat;
      Result := true;
      exit;
    end;
    FDescontos.vSomaBrutaProdutos := 0;
    FDescontos.vSomaProdutosComPermissaoDeDesconto := 0;
    FDescontos.vSomaProdutosSemPermissaoDeDesconto := 0;
    FDescontos.vSomaServicos := 0;
    vItem.dataSet.first;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
        FDescontos.vSomaServicos := FDescontos.vSomaServicos +
          vItem.dataSet.FieldByName('valor_total').AsCurrency
      else //     if vItem.dataSet.FieldByName('tipo_item').AsString <> 'P' then
      begin
        if vItem.dataSet.FieldByName('permitir_desconto').AsString <> 'N' then
          FDescontos.vSomaProdutosComPermissaoDeDesconto :=
            FDescontos.vSomaProdutosComPermissaoDeDesconto +
            vItem.dataSet.FieldByName('valor_total').AsCurrency;
        FDescontos.vSomaBrutaProdutos := FDescontos.vSomaBrutaProdutos +
          vItem.dataSet.FieldByName('valor_total').AsCurrency;
      end;
      vItem.dataSet.Next;
    end;
    FDescontos.vSomaProdutosSemPermissaoDeDesconto := FDescontos.vSomaBrutaProdutos -
      FDescontos.vSomaProdutosComPermissaoDeDesconto;

    if FDescontos.vSomaServicos <= 0 then
      dataSet.FieldByName('valor_desc_s').asfloat := 0;
    if FDescontos.vSomaProdutosComPermissaoDeDesconto <= 0 then
      dataSet.FieldByName('valor_desc_p').asfloat := 0;
    if (FDescontos.vSomaServicos <= 0) and (FDescontos.vSomaProdutosComPermissaoDeDesconto <= 0)
      then
      dataSet.FieldByName('valor_desc').asfloat := 0;
    if campo = 'N' then
    begin
      if dataSet.FieldByName('valor_desc').asfloat < 0 then
        raise exception.create('Desconto não pode ser negativo');
      if (FDescontos.vSomaServicos > 0) and (FDescontos.vSomaProdutosComPermissaoDeDesconto > 0)
        then
      begin
        //        if dataSet.FieldByName('valor_desc').OldValue <> dataSet.FieldByName('valor_desc').NewValue then
        begin
          dataSet.FieldByName('valor_desc_p').asfloat :=
            vDadosIni.StrToFloatFormat(
            (dataSet.FieldByName('valor_desc').asfloat /
            (FDescontos.vSomaServicos + FDescontos.vSomaProdutosComPermissaoDeDesconto) *
            FDescontos.vSomaProdutosComPermissaoDeDesconto), 2);
          dataSet.FieldByName('valor_desc_s').asfloat :=
            dataSet.FieldByName('valor_desc').asfloat -
            dataSet.FieldByName('valor_desc_p').asfloat;
        end;
      end
      else if (FDescontos.vSomaProdutosComPermissaoDeDesconto > 0) then
        dataSet.FieldByName('valor_desc_p').asfloat :=
          dataSet.FieldByName('valor_desc').asfloat
      else if (FDescontos.vSomaServicos > 0) then
        dataSet.FieldByName('valor_desc_s').asfloat :=
          dataSet.FieldByName('valor_desc').asfloat;
      if dataSet.FieldByName('tipo_nf').AsString = 'P' then
        if (FDescontos.vSomaServicos > 0) and (FDescontos.vSomaProdutosComPermissaoDeDesconto > 0)
          and (dataSet.FieldByName('valor_desc').asfloat > 0) then
          abreFormDescontos;
    end
    else if (campo = 'P') or (campo = 'S') then
    begin
      if campo = 'P' then
      begin
        if dataSet.FieldByName('valor_desc_p').asfloat < 0 then
          raise exception.create('Desconto não pode ser negativo');
      end
      else if dataSet.FieldByName('valor_desc_s').asfloat < 0 then
        raise exception.create('Desconto não pode ser negativo');

      dataSet.FieldByName('valor_desc').asfloat :=
        dataSet.FieldByName('valor_desc_p').asfloat +
        dataSet.FieldByName('valor_desc_s').asfloat;
    end
    else
    begin

    end;
    Result := True;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.validaEntradaAnteriorVeiculo: boolean;
begin
  try
    buscas.Close;
    buscas.Sql.Text := 'select nf.num_nf,nf.data_lanc,nfv.chassi from notafiscal nf' +
      ' inner join notafiscal_item_veiculo nfv on nf.cod_nf = nfv.cod_nf and nfv.cod_empresa = nf.cod_empresa' +
      ' where nfv.chassi = ' + QuotedStr(vitem.dataSet.FieldByName('chassi').Asstring) +
      ' and nf.num_nf <> ' + dataSet.FieldByName('num_nf').Asstring +
      ' and nf.serie <> ' + QuotedStr(dataSet.FieldByName('serie').Asstring) +
      ' and nf.cod_empresa = ' + vDadosIni.codempresa +
      ' and nf.natureza_nf = ''E'' and nf.tipo_nf = ''V''' +
      ' and nf.ativo = 1';
    buscas.Open;
    if buscas.IsEmpty then
    begin
      Result := true;
      Exit;
    end;
    Application.MessageBox(pchar('Veículo ja existe na nota fiscal: ' +
      buscas.FieldByName('num_nf').AsString + sLineBreak +
      'Nota fiscal lançada em: ' + buscas.FieldByName('data_lanc').AsString), 'Atenção', 0 + 64);

    if not vDadosIni.PesqPros('NF0038', 'LIBERAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
      dataSet.FieldByName('cod_nf').AsString,
      buscas, true) then
      Result := False
    else if Application.MessageBox('Deseja continuar?', 'Confirmação', MB_YESNO + MB_ICONQUESTION)
      = IDYES then
      Result := True;
  finally
    buscas.Close;
  end;

end;

function TNFCab.validaInscricaoSuframa: Boolean;
var
  list: TStrings;
begin
  Result := true;

  if fdif('natureza_nf', 'S') or fdif('modelo_nf', '55') then
    exit;

  if ((Config.Conf_Geral.nf_desoneracao_zfm_alc.ReadString('ICMS'     , 'ConfirmarConferenciaInscricaoSuframa') = 'S') and (ffloat('vicmdeson') > 0)) or
     ((Config.Conf_Geral.nf_desoneracao_zfm_alc.ReadString('PISCOFINS', 'ConfirmarConferenciaInscricaoSuframa') = 'S') and ( (ffloat('vpisdeson') > 0) or (ffloat('vcofinsdeson') > 0))) then
    if (not fempty('dest_isuf')) and fempty('conf_isuf') then
    begin
      ShowAtencao('Inscrição Suframa precisa ser conferida se está ativa antes de emitir a nota fiscal' + sLineBreak + sLineBreak +
                  'Por favor acesse o portal e faça a conferência' + sLineBreak + sLineBreak +
                  'Após consultar o portal na aba do destinatário informe se a inscrição está "Ativa" ou "Inativa"');
      Result := False;
      Exit;
    end;

  list := TStringList.Create;

  if fempty('dest_isuf') and (ffloat('vicmdeson') > 0) then
  begin
    vItem.filterStr('ind_desoneracao = 7 and vicmdeson > 0').First;
    try
      while not vItem.dataSet.Eof do
      begin
        list.Add(Format('Item %d com valor de ICMS desonerado, motivo Suframa, o destinatário precisa ter inscrição Suframa', [vItem.fint('nitem')]));
        vItem.dataSet.Next;
      end;
    finally
      vItem.filterClear;
    end;
  end;

  if fequals('conf_isuf', 'I') and (ffloat('vicmdeson') > 0) and
    (Config.Conf_Geral.nf_desoneracao_zfm_alc.ReadString('ICMS', 'ConfirmarConferenciaInscricaoSuframa') = 'S') then
  begin
    vItem.filterStr('ind_desoneracao = 7 and vicmdeson > 0').First;
    try
      while not vItem.dataSet.Eof do
      begin
        list.Add(Format('Item %d com valor de ICMS desonerado, motivo Suframa, a inscrição está "Inativa" por favor corrija para continuar', [vItem.fint('nitem')]));
        vItem.dataSet.Next;
      end;
    finally
      vItem.filterClear;
    end;
  end;

  if fequals('conf_isuf', 'I') and ((ffloat('vpisdeson') > 0) or (ffloat('vcofinsdeson') > 0)) and
    (Config.Conf_Geral.nf_desoneracao_zfm_alc.ReadString('PISCOFINS', 'ConfirmarConferenciaInscricaoSuframa') = 'S') then
  begin
    vItem.filterStr('ind_desoneracao = 7 and (vpisdeson > 0 or vcofinsdeson > 0)').First;
    try
      while not vItem.dataSet.Eof do
      begin
        list.Add(Format('Item %d com valor de PIS COFINS desonerado, motivo Suframa, a inscrição está "Inativa" por favor corrija para continuar', [vItem.fint('nitem')]));
        vItem.dataSet.Next;
      end;
    finally
      vItem.filterClear;
    end;
  end;

  if list.Count > 0 then
  begin
    ShowAtencao(list.Text);
    Result := False;
    Exit;
  end;
end;

function TNFCab.validarAntecipacaoST: Boolean;
var
  Resposta: string;
  ListaErros, ListaAlerta: TStrings;
  I: Integer;
begin
  Result := True;
  Exit;

  if ( not vDadosIni.strIn(dataSet.FieldByName('tipo_nf').AsString, ['P','O'])) then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString <> 'E' then
    Exit;

  if not AsTrueValue(Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_f) then
    Exit;

  ListaErros := TStringList.Create;
  ListaErros.Clear;
  ListaAlerta := TStringList.Create;
  ListaAlerta.Clear;
  if dataSet.State in [dsEdit, dsInsert] then
    dataSet.FieldByName('antec_trib').AsString := '';
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vItem.dataSet.FieldByName('indtot').Value = 0 then
    begin
      vItem.dataSet.Next;
      Continue;
    end;
    Resposta := vItem.calcucarAntecipacaoTributariaST(Self, opdValidacao);
    if vDadosIni.getValue(Resposta, 1) <> 'OK' then
    begin
      ListaErros.Add('-');
      ListaErros.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
        Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
        Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
      ListaErros.Add(' * ' + vDadosIni.getValue(Resposta, 1));
    end
    else if vDadosIni.getValue(Resposta, 2) <> '' then
    begin
      ListaAlerta.Add('-');
      ListaAlerta.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
        Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
        Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
      ListaAlerta.Add(' * ' + vDadosIni.getValue(Resposta, 2));
    end;
    vItem.dataSet.Next;
  end;

  if ListaAlerta.Count > 0 then
    Application.MessageBox(PChar('Antecipação Tributaria de ICMS com Alertas' + sLineBreak +
      ListaAlerta.Text), 'Atenção', MB_ICONINFORMATION + MB_OK);

  if ListaErros.Count > 0 then
  begin
    Application.MessageBox(PChar('Antecipação Tributaria de ICMS com Irregularidades' + sLineBreak +
      ListaErros.Text), 'Atenção', MB_ICONWARNING + MB_OK);
    if vDadosIni.PesqPros('NF0197', 'VALIDAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
      'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas)  then
    begin
      for I := 0 to ListaErros.Count - 1 do
        vDadosIni.GravaAuditoria('NF0197', 'VALIDAR', 'NITEM/COD ' +
         vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + '/' +
          Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString),
          'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
      ListaErros.Clear;
    end;
  end;
  Result := ListaErros.Count = 0;
end;

function TNFCab.validarCfopCabecalhoEitens: Boolean;
begin
  try
    if ((fstr('natureza_nf') = 'E') and (not MatchStr(fstr('codigo_nop')[1], ['1', '2', '3']))) then
      raiseExceptionCreate('CFOP da nota fiscal inválido. Deve conter 4 números e iniciar em 1, 2 ou 3')
    else if ((fstr('natureza_nf') = 'S') and (not MatchStr(fstr('codigo_nop')[1], ['5', '6', '7']))) then
      raiseExceptionCreate('CFOP da nota fiscal inválido. Deve conter 4 números e iniciar em 5, 6 ou 7');

    if (Length(vDadosIni.apenasNumeros(fstr('codigo_nop'))) <> 4) or
       ((ffloat('codigo_nop') < 999) or (ffloat('codigo_nop') > 7999)) then
      raiseExceptionCreate('CFOP da nota fiscal inválido. Deve conter 4 números');

    vItem.prepare_loop();
    try
      while not vItem.DataSet.Eof do
      begin
        if ((fstr('natureza_nf') = 'E') and (not MatchStr(vItem.fstr('codigo_nop')[1], ['1', '2', '3']))) then
          raiseExceptionCreate('CFOP do item ' + vItem.fstr('nitem') + ' inválido. Deve conter 4 números e iniciar em 1, 2 ou 3')
        else if ((fstr('natureza_nf') = 'S') and (not MatchStr(vItem.fstr('codigo_nop')[1], ['5', '6', '7']))) then
          raiseExceptionCreate('CFOP do item ' + vItem.fstr('nitem') + ' inválido. Deve conter 4 números e iniciar em 5, 6 ou 7');

        if (Length(vDadosIni.apenasNumeros(vItem.fstr('codigo_nop'))) <> 4) or
           ((ffloat('codigo_nop') < 999) or (vItem.ffloat('codigo_nop') > 7999)) then
          raiseExceptionCreate('CFOP do item ' + vItem.fstr('nitem') + ' inválido. Deve conter 4 números');

        vItem.DataSet.Next;
      end;
    finally
      vItem.prepare_loop_done;
    end;
    Result := True;
  except on E: Exception do
    begin
      Result := False;
      vDadosIni.ShowErro(E.message);
    end;
  end;
end;

function TNFCab.validarChaveNFe(pChave: string): Boolean;
begin
  Result := ValidaChaveNFe(pchar(pChave));  
end;

function TNFCab.validarConferenciaCompra: Boolean;
var
  list: TStrings;
  prods: TProdutos_tmp_classList;
  I, limit, countNotas: Integer;
  perc, percConfAcima, percConfAbaixo, vlUnMedia: Double;
  confVlUn, confUnd, printItErro, hasCompras: Boolean;
  sMsg, sUndProd, sUndUltEnt: string;
  itensAudit: THw_auditoria_classList;
begin
  Result := True;

  confVlUn := Config.Conf_Geral.nf_e_compra_conferencia.ReadString('ValorUnitario', 'Conferir') = 'S';
  confUnd := Config.Conf_Geral.nf_e_compra_conferencia.ReadString('UnidadeMedida', 'Conferir') = 'S';

  if (not confVlUn) and (not confUnd) then
    Exit;

  if confVlUn then
    if not TryStrToFloat(Config.Conf_Geral.nf_e_compra_conferencia.ReadString('ValorUnitario', 'PercentualLimiteAcima'), percConfAcima) then
    begin
      Result := False;
      ShowAtencao('Configuração "nf_e_compra_conferencia" inválida.' + sLineBreak + sLineBreak +
                  '[ValorUnitario]' + sLineBreak +
                  'PercentualLimiteAcima=' + sLineBreak + sLineBreak +
                  'Valor inválido, não utilize pontos, apenas o número e vírgula se necessário');
    end;

  if confVlUn then
    if not TryStrToFloat(Config.Conf_Geral.nf_e_compra_conferencia.ReadString('ValorUnitario', 'PercentualLimiteAbaixo'), percConfAbaixo) then
    begin
      Result := False;
      ShowAtencao('Configuração "nf_e_compra_conferencia" inválida.' + sLineBreak + sLineBreak +
                  '[ValorUnitario]' + sLineBreak +
                  'PercentualLimiteAbaixo=' + sLineBreak + sLineBreak +
                  'Valor inválido, não utilize pontos, apenas o número e vírgula se necessário');
    end;

  limit := 5;
  TryStrToInt(Config.Conf_Geral.nf_e_compra_conferencia.ReadString('ValorUnitario', 'NumeroDeUltimasEntradas'), limit);
  limit := Abs(Min(10, limit));
  limit := Abs(Max(1, limit));

  list := NewStringList();
  prods := TProdutos_tmp_classList.Create;
  itensAudit := THw_auditoria_classList.Create('NOTAFISCAL');
  try
    prods.SetValuesFrom(SqlOpen('select distinct grupo_prod, cod_prod from notafiscal_item' +
                                ' where cod_nf = %d and cod_empresa = %d and altera_custo_cfop = ''S'' ' +
                                ' order by nitem',
                                [fint('cod_nf'), vDadosIni.cod_empresa]), True);

    for I := 0 to prods.Count - 1 do
    begin

      if confVlUn then
      begin
        queryCons.Open('select count(c.valor_unitario) qtde, avg(c.valor_unitario) valor_unitario from (' +
                       ' select first %d nf.data_lanc, nf.num_nf, avg(nfi.valor_unitario) valor_unitario' +
                       ' from notafiscal nf' +
                       ' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
                       '   and nfi.grupo_prod = %d and nfi.cod_prod = ''%s'' and nfi.altera_custo_cfop = ''S''' +
                       ' where nf.cod_nf <> %d and nf.data_lanc <= %s and nf.cod_empresa = %d' +
                       ' and nf.status = ''Fechada'' and nf.natureza_nf = ''E''' +
                       ' and iif(nf.emissao_propria = ''N'', ''Autorizada'', nf.situacao_nfe) = ''Autorizada''' +
                       ' group by 1,2' +
                       ' order by data_lanc desc' +
                       ' ) as c',
                       [limit, prods.Items[I].grupo_prod, prods.Items[I].cod_prod,
                        fint('cod_nf'), date_fb(vDadosIni.FusoDate(True)), vDadosIni.cod_empresa]);
        countNotas := queryCons.fint('qtde');
        vlUnMedia  := queryCons.ffloat('valor_unitario');
      end;

      if confUnd then
      begin    
        queryCons.Open('select first 1 nf.data_lanc, nf.num_nf, nfi.referencia und_nf, pr.unidade und_prod' +
                       ' from notafiscal nf' +
                       ' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
                       '   and nfi.grupo_prod = %d and nfi.cod_prod = ''%s'' and nfi.altera_custo_cfop = ''S''' +
                       ' inner join produtos pr on pr.grupo_prod = nfi.grupo_prod and pr.cod_prod = nfi.cod_prod and pr.cod_empresa = nfi.cod_empresa' +
                       ' where nf.cod_nf <> %d and nf.data_lanc <= %s and nf.cod_empresa = %d' +
                       ' and nf.status = ''Fechada'' and nf.natureza_nf = ''E''' +
                       ' and iif(nf.emissao_propria = ''N'', ''Autorizada'', nf.situacao_nfe) = ''Autorizada''' +
                       ' order by data_lanc desc',
                       [prods.Items[I].grupo_prod, prods.Items[I].cod_prod,
                        fint('cod_nf'), date_fb(vDadosIni.FusoDate(True)), vDadosIni.cod_empresa]);
        sUndProd   := queryCons.fstr('und_prod');
        sUndUltEnt := queryCons.fstr('und_nf');
        hasCompras := not queryCons.IsEmpty;
      end;

      vItem.filterStr('grupo_prod = %d and cod_prod = ''%s'' and altera_custo_cfop = ''S''',
                      [prods.Items[I].grupo_prod, prods.Items[I].cod_prod]).First;
      try
        while not vItem.Eof do
        begin

          printItErro := False;

          if confVlUn and (countNotas > 0) then
          begin
            if vItem.ffloat('valor_unitario') > vlUnMedia then
            begin
              perc := (vItem.ffloat('valor_unitario') / vlUnMedia - 1) * 100;
              sMsg := Format('Valor unitário NF superior em "%0.2f"%%, o limite é "%0.2f"%%', [perc, percConfAcima]);
            end;
            if vItem.ffloat('valor_unitario') < vlUnMedia then
            begin
              perc := (vItem.ffloat('valor_unitario') / vlUnMedia) * 100;
              sMsg := Format('Valor unitário NF inferior em "%0.2f"%%, o limite é "%0.2f"%%', [perc, percConfAbaixo]);
//              sMsg := Format('Media anterior superior em "%0.2f"%%, o limite é "%0.2f"%%', [perc, percConf]);
            end;

            if ((vItem.ffloat('valor_unitario') > vlUnMedia) and (perc > percConfAcima))
              or ((vItem.ffloat('valor_unitario') < vlUnMedia) and  (perc < percConfAbaixo)) then
            begin
              if list.Count > 0 then
                list.Add('-');

              printItErro := True;
              list.Add(Format('%d - %s - %s', [vItem.fint('nitem'), vItem.fstr('num_fab_prod'), vItem.fstr('descricao_item')]));

              list.Add(Format('* Média entrada anterior "%0.3f", valor unitário NF "%0.3f"' + sLineBreak +
                              '* Existe uma diferença de valores superior ou inferior ao esperado' + sLineBreak +
                              '  Pode existir um erro de conversão ou produto vinculado incorretamente' + sLineBreak +
                              '* %s',
                              [vlUnMedia, vItem.ffloat('valor_unitario'), sMsg]));
              with itensAudit.New do
              begin
                cod_processo := 'NF0239';
                acao         := 'VALIDAR';
                if ((vItem.ffloat('valor_unitario') > vlUnMedia) and (perc > percConfAcima)) then
                  mensagem   := Format('NUM NF %d NITEM: %d | Calc %0.3f > Max %0.3f ', [fint('num_nf'), vItem.fint('nitem'), perc, percConfAcima])
                else
                  mensagem   := Format('NUM NF %d NITEM: %d | Calc %0.3f < Min %0.3f ', [fint('num_nf'), vItem.fint('nitem'), perc, percConfAbaixo]);
                //tabela       := 'NOTAFISCAL';
                codigo       := fstr('cod_nf');
                gravar       := True;
              end;
            end;
          end;

          if confUnd and hasCompras then
          begin
            if (Config.Conf_Geral.nf_e_compra_conferencia.ReadString('UnidadeMedida', 'DivergeDoEstoque') = 'S')
              and (vItem.fdif('referencia', sUndProd))
            then
            begin
              if (not printItErro) and (list.Count > 0) then
                list.Add('-');
              if not printItErro then
                list.Add(Format('%d - %s - %s', [vItem.fint('nitem'), vItem.fstr('num_fab_prod'), vItem.fstr('descricao_item')]));
              printItErro := True;

              list.Add(Format('* Unidade de medida do item (%s) na NF difere da unidade de medida do Estoque (%s)',
                              [vItem.fstr('referencia'), sUndProd]));

              with itensAudit.New do
              begin
                cod_processo := 'NF0240';
                acao         := 'VALIDAR';
                mensagem     := Format('NUM NF %d NITEM: %d | UndNf(%s) difere Und Estoque(%s)', [fint('num_nf'), vItem.fint('nitem'), vItem.fstr('referencia'), sUndProd]);
                //tabela       := 'NOTAFISCAL';
                codigo       := fstr('cod_nf');
                gravar       := True;
              end;
            end;

            if (Config.Conf_Geral.nf_e_compra_conferencia.ReadString('UnidadeMedida', 'DivergeUltimaEntrada') = 'S')
              and (vItem.fdif('referencia', sUndUltEnt))
            then
            begin
              if (not printItErro) and (list.Count > 0) then
                list.Add('-');
              if not printItErro then
                list.Add(Format('%d - %s - %s', [vItem.fint('nitem'), vItem.fstr('num_fab_prod'), vItem.fstr('descricao_item')]));
              printItErro := True;

              list.Add(Format('* Unidade de medida do item (%s) na NF difere da unidade de medida da última entrada (%s)',
                              [vItem.fstr('referencia'), sUndUltEnt]));

              with itensAudit.New do
              begin
                cod_processo := 'NF0240';
                acao         := 'VALIDAR';
                mensagem     := Format('NUM NF %d NITEM: %d | UndNf(%s) difere Und UltNF(%s)', [fint('num_nf'), vItem.fint('nitem'), vItem.fstr('referencia'), sUndUltEnt]);
                //tabela       := 'NOTAFISCAL';
                codigo       := fstr('cod_nf');
                gravar       := True;
              end;
            end;
          end;

          vItem.Next;
        end;

      finally
        vItem.filterClear;
      end;       

    end;

    if list.Count > 0 then
      ShowAtencao(list.Text);

    if itensAudit.Count > 0 then
      if vDadosIni.PesqPros(itensAudit, buscas) then
        list.Clear
      else
        ShowAtencao(itensAudit.ProcessosNaoPermitidosToStr());

  finally
    prods.Free;
    itensAudit.Free;
  end;              
  
  if (not confVlUn) and (not confUnd) then
    Exit;

  Result := list.Count = 0;

end;

function TNFCab.validarDadosChaveNFe(pChave: string): Boolean;
begin
  try
    if StrToInt(Copy(Trim(pChave), 26, 9)) <> dataSet.FieldByName('num_nf').AsInteger then
      raiseExceptionCreate('Número da nota fiscal não corresponde ao número contido na Chave da %s', [StrDFe], 'DBEdit43')
    else if Copy(Trim(pChave), 23, 3) <> vDadosIni.StrZero(Trim(dataSet.FieldByName('serie').AsString),3) then
      raiseExceptionCreate('Série da nota fiscal não corresponde a série contido na Chave da %s', [StrDFe], 'DBEdit47');
    Result := True;
  except on E: Exception do
    begin
      if trim(e.Message) <> '' then
        Application.MessageBox(pchar(e.Message),'Atenção', 0 + 64)
      else
        ShowAtencao('Chave da %s contém digitos inválidos', [StrDFe]);
      Result := False;
    end;
  end;
end;

function TNFCab.validarEmissaaoPropriaNFe: Boolean;
var
  erros: TStrings;
  errosCalcRtc: Boolean;
  danfeSimpTipo2, isNT2026_002, isRegRefCupom : Boolean;
  S: string;
begin
  if not fequals('emissao_propria', 'S')
    or not fequals('modelo_nf', '55') then
  begin
    Result := True;
    Exit;
  end;

  isNT2026_002 := DFeNTManager.RegraEmVigor(nt2026_002, fequals('nfe_tpamb', 1));
  isRegRefCupom := DFeNTManager.RegraEmVigor(regRefDocConsumidor, fequals('nfe_tpamb', 1));

  danfeSimpTipo2 := fequals('tpimp', Ord(fidSimplificadoTipo2));
  S := 'NFe com DANFe Simplificado Tipo 2, ';
  erros := NewStringList();
  Result := False;
  try
    if YesNoEnum(fint('dfe_trib_ignorar')) = ynNo then
    begin
      vItem.prepare_loop();
      try
        errosCalcRtc := False;
        while not vItem.dataset.Eof do
        begin
          {$REGION 'Regras de Validacao DANFe Simplificado Tipo 2'}
          if danfeSimpTipo2 then
          begin
            if isNT2026_002 then
            begin
              // I08-150 - 725
              case vItem.fint('codigo_nop') of
                5101, 5102, 5103, 5104, 5115, 5405, 5656, 5667, 5910, 5933: ; // valores validos
                else
                  erros.Add(Format(
                    '%s, Item %d com CFOP %d inválido. Permitidos: "5101,5102,5103,5104,5115,5405,5656,5667,5910,5933"',
                    [S, vItem.fint('nitem'), vItem.fint('codigo_nop')])
                  );
              end;

              // I17b-10 - 774
              if vItem.fequals('indtot', 0) then
                erros.Add(Format('%s, Item %d com indicador de item não participante do total',[S, vItem.fint('nitem')]));

              // VC02-50 - 708
              if not vItem.fempty('chave_nfe_ref') then
                erros.Add(Format('%s, Item %d não pode referenciar documento fiscal', [S, vItem.fint('nitem')]));

              case StrToInt(IfThen(fequals('crt', '1'), vItem.fstr('csosn'), vItem.fstr('cst', 2, 2))) of
                00, 20, 40, 41, 61, 102, 103, 300: ; // Valores validos
                60, 500:
                  case vItem.fint('codigo_nop') of
                    5405, 5656, 5667, 5910: ; // valores validos
                    else
                      // N12-44 - 382 // N12a-44 - 386
                      erros.Add(Format(
                        '%s, Item %d com CFOP %d CFOP não permitido para o CST/CSOSN informado. Permitidos: "5405,5656,5667,5910"',
                        [S, vItem.fint('nitem'), vItem.fint('codigo_nop')])
                      );
                  end
                ;
                90, 900:
                  begin
                    // N12-34 - 381 // N12a-34 - 385
                    if vItem.ffloat('valor_icmsub') > 0 then
                      erros.Add(Format(
                        '%s, Item %d Grupo de tributação ICMS90, informando dados do ICMS-ST', [S, vItem.fint('nitem')])
                      );
                  end;
                else
                  // N12-30 - 766 // N12a-20 - 383
                  erros.Add(Format(
                    '%s, Item %d com CST/CSOSN %d indevido. Permitidos: "00,20,40,41,60,61,102,103,300,500,[90,900(A critério da UF)]"',
                    [S, vItem.fint('nitem'), vItem.fstr('cst', 2, 2)])
                  );
              end;
            end;
          end;

          {$ENDREGION}

          {$REGION 'Regra de validacao referenciamento Cupom ou NFCe'}
          // I08-180 - 375
          if isRegRefCupom and (vItem.fstr('codigo_nop', 2, 3) = '929') then
          begin
            vSped.vC110.vC113.First;
            while not vSped.vC110.vC113.Eof do
            begin
              if vSped.vC110.vC113.fstr('chave_nfe_ref', 21, 2) = '65' then
              begin
                erros.Add('NF-e com lançamento relativo a Cupom Fiscal referencia uma NFC-e. Isso não é permitido');
                isRegRefCupom := False; // Nao precisa mais validar os demais itens
                Break;
              end;
              vSped.vC110.vC113.Next;
            end;
          end;    
          {$ENDREGION}

          if vItem.fempty('dfe_trib_id') then
          begin
            erros.Add(Format(
              'Tributos RTC não calculados: %d - %s',
              [vItem.fint('nitem'), vItem.fstr('descricao_item')])
            );
            errosCalcRtc := True;
          end;
          vItem.dataSet.Next();
        end;

        if errosCalcRtc then
          if fempty('op_interna_id') then
            erros.Add(sLineBreak + 'Operação interna precisa ser informada para realização automática dos cálculos!')
          else
            erros.Add( sLineBreak +
              'Provavelmente a parametrização do sistema não foi feita para operação interna interna!' + sLineBreak +
              'Verifique seus cadastros de Regras Fiscais do IBS e CBS e também de Operações Fiscal do IBS e CBS' + sLineBreak +
              'Caso tenha alguma dúvida contacte o suporte técnico'
            );     
      finally
        vItem.prepare_loop_done();
      end;
    end;

    if danfeSimpTipo2 and isNT2026_002 then
    begin
      // B11-10 - 706 >
      if fequals('natureza_nf', 'E') then
        erros.Add(S + 'Não permitido para operação de entrada');
      // B11a-10 - 707 >
      if fdif('nfe_iddest', '1') then
        erros.Add(S + 'Não permitido para operação interestadual ou com o exterior');
      // B25-20 - 715
      if fdif('tipo_emissao', '1') then
        erros.Add(S + 'Finalidade difere de "1 - Normal"');
      // B25a-10 - 716
      if fdif('consumidor_final', 'S') then
        erros.Add(S + 'Somente permitida para consumo final');
      // B25b-20 - 717
      if not (fint('nfe_indpres') in [1,4,5]) then
        erros.Add(S +
          'Indicador de presença difere de:' + sLineBreak +
          '“1-Operação presencial”' + sLineBreak +
          '“4-Operações não presenciais com NF-e com DANFE Simplificado Tipo 2”' +
          '“5-Operação presencial, fora do estabelecimento”'
        );
      // BA01-10 - 708
      if vSped.vC110.vC113.Active and not vSped.vC110.vC113.IsEmpty then
        erros.Add(S + 'Não permitido referenciar outros Documentos Fiscais');

      // C18-10 - 718 > QUando gera o XML tem o teste

      // E01-20 - 787
      if fequals('nfe_indpres', 4) and fempty('cpfcgc') then
        erros.Add(S + 'Sem identificação do destinatário');
      // F01-10 - 669
      if not Fcoleta.IsEmpty() then
        erros.Add(S + 'Local de retirada informado indevidamente');
      // G01-10 - 670
      if not Fentrega.IsEmpty() then
        erros.Add(S + 'Local de entrega informado indevidamente');
      // J01-10 - 736
      if fequals('tipo_nf', 'V') then
        erros.Add(S + 'Nota de veículos não permitida');

      // Y01-10 - 760
      if not FdupNFe.IsEmpty() then
        erros.Add(S + 'Dados de cobrança não permitidos');
    end;

    // B22-10 > 711
    if not danfeSimpTipo2 and isNT2026_002 and fequals('nfe_tpemis', 9) then
      erros.Add('NF-e com contingência off-line em operação não permitida. Somente permitido para o DANFe Simplificado Tipo 2');

    if not fempty('cindop') and (Length(fstr('cindop')) <> 6) then
      erros.Add('Código Indicador do Local da Operação se preenchido precisa conter 6 dígitos');

    if erros.Count > 0 then
      raise Exception.Create(erros.Text);

    Result := True;

    erros.Free();

  except on E: Exception do
    begin
      ShowErro(e.Message);
      erros.Free();
    end;
  end;
end;

function TNFCab.validarGradeInformadaSaida(): Boolean;
var
  msg: TStrings;
begin
  Result := True;

  if fequals('natureza_nf', 'E') or (vDadosIni.vEmp.vVnd_MontarPedVendaAutomaticoNaNF <> 'S') then
    Exit;

  msg := TStringList.Create;
  try

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.fequals('tipo_item', 'P') and
        vItem.fdif('ALTERA_ESTOQUE_CFOP', 'N') and
        (vItem.fint('nped') = 0) and
        (vItem.fint('nitem_ped') = 0) and
        vItem.fempty('tipo_ped') and
        (vItem.fint('cod_grade') = 0) then
      begin
        try
          vGrComp.vGrades.selecionaGradeDoProduto(
            vItem.fint('grupo_prod'), vItem.fstr('cod_prod'));

          if (vGrComp.vGrades.dataSet.RecordCount > 0) then
            msg.Add(Format('Falta GRADE - Item %d - %s', [vItem.fint('nitem'), vItem.fstr('descricao_item')]));

        finally
          vGrComp.vGrades.Close();
        end;
      end;
      vItem.dataSet.Next;
    end;

    Result := msg.Count = 0;

    if not Result then
      raise Exception.CreateFmt('%s' + sLineBreak + sLineBreak + 'Na tela de alteração do item, utilize o botão "Grade"', [ msg.Text ]);

    msg.Free;

  except on E: Exception do
    begin
      msg.Free;
      Result := False;
      ShowErro(E.message);
    end;
  end;
end;

function TNFCab.validarItensDevolvidos: boolean;
var
  vOK, vOKSPED: Boolean;

  function validaNFVeiculoDevolvidos: Boolean;
  var
    vNatTemp, vSql: string;
  begin
    result := True;
    if Trim(dataSet.FieldByName('tipo_nf').AsString) <> 'V' then
      Exit;

    if Trim(dataSet.FieldByName('natureza_nf').AsString) = 'S' then
      vNatTemp := 'E'
    else
      vNatTemp := 'S';

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (cfopDeDevolucaoSPED(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat))) or
        (cfopDeDevolucao(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat))) then
      begin
        vNatTemp := 'select nf.num_nf "Num NF", nf.data_lanc "Data NF", nf.status "Status", cast(substring(nf.situacao_nfe from 1 for 12) as varchar(12)) "Situação NF-e",' +
          ' nfi.nitem "Nº Item", nfi.valor_total "Vr Tot Item", nf.valor_total "Valor NF",' +
          ' nfi.codigo_nop CFOP, nf.serie "Serie", nf.modelo_nf "Modelo", c.nome_cliente "Nome Fantasia",' +
          ' c.razao "Razao Social", nfi.cod_nf "Cod NF", nfi.nitem "Nitem", nfi.cod_nf "Cod_NF" from notafiscal_item nfi' +
          ' inner join notafiscal nf on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
          ' inner join clientes c on c.cod_cliente = nf.cod_cliente and c.cod_empresa = nf.cod_empresa' +
          ' where nfi.chassi = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
          ' and nfi.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and nf.natureza_nf = ' + QuotedStr(vNatTemp) +
          ' and nf.status = ' + QuotedStr(stsFechada) + 
          ' and ( (nf.emissao_propria = ''S'' and nf.modelo_nf = ''55'' and coalesce(nf.situacao_nfe,'''') <> '''' )' +
          ' or (nf.emissao_propria = ''S'' and nf.modelo_nf <> ''55'')' +
          ' or (nf.emissao_propria = ''N'') )' +
          ' order by nf.data_lanc desc, nf.num_nf desc';

        if not abreFormReferenciasDevolucao('Chassi: ' + Trim(vItem.dataSet.FieldByName('chassi').AsString) +
          ' Item: ' + vItem.dataSet.FieldByName('nitem').AsString +
          '. Informar nota fiscal que originou a devolução', vNatTemp) then
        begin
          Result := False;
          Exit;
        end;

        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('cod_nf_dev').AsInteger := buscas.FieldByName('cod_nf').AsInteger;
        vItem.dataSet.FieldByName('nitem_dev').AsInteger := buscas.FieldByName('nitem').AsInteger;
        vItem.dataSet.Post;
      end;
      vItem.dataSet.Next;
    end;
  end;

begin //Metodo que verifica os cfops de devolucao para referenciar a nota fiscal que originou. Veiculos e SPED Contribuições
// Para o SPED Contribuições o sistema efetua o teste no final do metodo antes de pedir para referenciar a nota fiscal

  Result := True;

  vOK := False;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if cfopDeDevolucao(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) then
    begin
      vOK := True;
      if vItem.dataSet.FieldByName('cod_nf_dev').AsInteger > 0 then
      begin
        {
        JP: Não vi sentido nisso, comentei o codigo para nao ter problema com a referencia 
        vSped.vC110.vC113.abreC113(dataSet.FieldByName('cod_nf').AsInteger);
        if vSped.vC110.vC113.dataset.Locate('COD_NF_REF', vItem.dataSet.FieldByName('cod_nf_dev').AsInteger, []) then
        begin
          vSped.vC110.vC113.dataSet.Delete;
          vSped.vC110.vC113.Apply;
        end;
        }
      end;
    end;
    vItem.dataSet.Next;
  end;


  if vOK then  // Caso o cfop do item foi configurado como devolucao e a nf é de veiculos os sistema pede a referencia da nota fiscal
    if Trim(dataSet.FieldByName('tipo_nf').AsString) = 'V' then
      if not validaNFVeiculoDevolvidos then
        if not vDadosIni.PesqPros('NF0178', 'VALIDAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
          'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas, True) then
        begin
          Result := False;
          Exit;
        end;

  vOKSPED := False;

  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if cfopDeDevolucaoSPED(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)) then
    begin
      vOKSPED := True;
      Break;
    end;
    vItem.dataSet.Next;
  end;

  if (not vOK) and (not vOKSPED) then
  begin
    Result := True;
    Exit;
  end;

  if (not vOKSPED) then // é necessario abrir o formuario abaixo apenas quando o CFOP DEVOLUCAO_SPED for configurado
  begin
    Result := True;// abreFormDevolcaoAssociacaoItens;
    Exit;
  end;

  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    if vDadosIni.vEmp.vRegime = 'LUCRO REAL' then
      Result := abreFormDevolcaoAssociacaoItens;

  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    if vDadosIni.vEmp.vRegime = 'LUCRO PRESUMIDO' then
      Result := abreFormDevolcaoAssociacaoItens;

//  if Result then
//    vItem.Apply;

end;

function TNFCab.validaRodape: boolean;
begin
  try
    Result := False;
    if notaFechada then
      Exit;

    if dataSet.IsEmpty then
      exit;

    if (dataSet.FieldByName('base_icm').AsFloat < 0) or
      (dataSet.FieldByName('valor_icm').AsFloat < 0) then
      raiseExceptionCreate('Valor do ICMS menor que zero', 'DBEdit26');

    if (dataSet.FieldByName('valor_desc').AsFloat < 0) or
      (dataSet.FieldByName('valor_desc_p').AsFloat < 0) or
      (dataSet.FieldByName('valor_desc_s').AsFloat < 0) then
      raiseExceptionCreate('Valor do Desconto menor que zero', 'DBEdit37');

    if (dataSet.FieldByName('aliq_iss').AsFloat < 0) or
      (dataSet.FieldByName('base_iss').AsFloat < 0) or
      (dataSet.FieldByName('valor_iss').AsFloat < 0) then
      raiseExceptionCreate('Aliquota, Base ou Valor de ISS menor que zero', '');

    if (dataSet.FieldByName('base_icmsub').AsFloat < 0) or
      (dataSet.FieldByName('valor_icmsub').AsFloat < 0) then
      raiseExceptionCreate('Base ou Valor de ICMS Sub Tributária menor que zero', 'DBEdit28');

    if (dataSet.FieldByName('base_icmsub').AsFloat > 0) and (dataSet.FieldByName('valor_icmsub').AsFloat = 0) then
      raiseExceptionCreate('Se informar a Base de ICMS Sub Tributária, informar também o Valor de ICMS Sub Tributária', 'DBEdit29');

    if (dataSet.FieldByName('base_icmsub').AsFloat = 0) and (dataSet.FieldByName('valor_icmsub').AsFloat > 0) then
      raiseExceptionCreate('Se informar o Valor de ICMS Sub Tributária, informar também a Base de ICMS Sub Tributária', 'DBEdit28');

    if (dataSet.FieldByName('valor_frete').AsFloat < 0) then
      raiseExceptionCreate('Valor do Frete menor que zero', 'DBEdit33');

    if (dataSet.FieldByName('valor_seguro').AsFloat < 0) then
      raiseExceptionCreate('Valor do Seguro menor que zero', 'DBEdit34');

    if (dataSet.FieldByName('valor_out_desp').AsFloat < 0) then
      raiseExceptionCreate('Valor de Outras Despesas menor que zero', 'DBEdit35');

    if (dataSet.FieldByName('valor_desp_pf').AsFloat < 0) then
      raiseExceptionCreate('Valor Despesas Fora da nota menor que zero', 'DBEdit38');

    if (dataSet.FieldByName('valor_ipi').AsFloat < 0) then
      raiseExceptionCreate('Valor do IPI menor que zero', 'DBEdit36');

    if (dataSet.FieldByName('valor_acres_fin').AsFloat < 0) then
      raiseExceptionCreate('Valor do Acréscimo Financeiro menor que zero', 'DBEdit31');
    {
    if fequals('natureza_nf', 'E') and fstrin('tipo_emissao', ['1', '4']) and
       (ffloat('valor_prod') = 0) and (ffloat('valor_serv') = 0) then
      raiseExceptionCreate('Valor total dos Produtos ou Serviço não informado', 'DBEdit30');

    if fequals('natureza_nf', 'E') and fstrin('tipo_emissao', ['1', '4']) and
      (ffloat('valor_total') = 0) then
      raiseExceptionCreate('Valor total da Nota Fiscal não informado', 'DBEdit32');
    }
    Result := true;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.validarRegrasCFOP_CST: boolean;
var
  buscas2: TIBQuery;
  MVA: Double;

  procedure obterdados_cest_v2;
begin
    try
      if vItem.fequals('tipo_item', 'P') then
        vItem.vrDadosItem.cest           := SqlOpen('select cest from produtos where grupo_prod = %d and cod_prod = %s and cod_empresa = %d',
                                                    [vItem.fint('grupo_prod'), vItem.fstrq('cod_prod'), vDadosIni.cod_empresa])
                                                    .FieldByName('cest').AsString
      else
        vItem.vrDadosItem.cest           := vItem.fstr('cest');
      vItem.vrDadosItem.ncm              := vItem.fstr('ncm');
      vItem.vrDadosItem.tipo_item        := vItem.fstr('tipo_item');
      vItem.vrDadosItem.cst              := vItem.fstr('cst');
      vItem.vrDadosItem.aliq_icm         := vItem.ffloat('aliq_icm');
      vItem.vrDadosItem.Cest_Variante_Id := 0;

      if vItem.vrDadosItem.getDadosSubstituicaoTributaria(vDadosIni.vEmp.vSiglaUF,
                                                    Config.Conf_ICMS.nf_icmsst_cest_v2.GetRamoAtividade(fstr('natureza_nf'), fstr('cpfcgc'))) then
        MVA := vItem.vrDadosItem.FMVA
    finally
      vItem.vrDadosItem.cest             := '';
      vItem.vrDadosItem.ncm              := '';
      vItem.vrDadosItem.tipo_item        := '';
      vItem.vrDadosItem.cst              := '';
      vItem.vrDadosItem.aliq_icm         := 0;
      vItem.vrDadosItem.Cest_Variante_Id := 0;
    end
  end;

begin
  buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
  Result := False;
  if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
   (vDadosIni.vEmp.vUsarRegraCFOPCSTEntrada = 'S') then
  begin
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin

      if (vItem.dataSet.FieldByName('tipo_item').AsString <> 'S') then
      try

        vItem.dataSet.Edit;
        try

          if Trim(vItem.dataSet.FieldByName('ncm').AsString) <> '' then
          begin

            MVA := 0;
            if Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
              obterdados_cest_v2
            else
            begin
            //Pesquisa na tabela de ncm se o os produtos com este ncm tem ST
            buscas.Close;
            buscas.SQL.Text := 'select * from nbm where cod_ncm = '+
              QuotedStr(vItem.dataSet.FieldByName('ncm').AsString);
            buscas.Open;
              MVA := buscas.FieldByName('mva').AsFloat;
            end;

            if (MVA > 0)  then
            begin

              /// Se exister MVA(ST) e o item não for destacado ST na Nota fiscal e existir ICMS destacado.
              ///   O sistema marca o item para fazer o cálculo de antecipação tributária
              ///
              { Nova tela faz isso desnecessario
              if (vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('base_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('valor_icm').AsFloat > 0) then
              if (Copy(dataSet.FieldByName('devolucao').AsString,1,1) <> 'S') then
              begin

                vDadosIni.vInibeMensPesqPros := 'S';
                if vDadosIni.PesqPros('NF0113', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
                  dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
                begin

                  vItem.dataSet.FieldByName('aliq_icm').AsFloat := 0;
                  vItem.dataSet.FieldByName('base_icm').AsFloat := 0;
                  vItem.dataSet.FieldByName('valor_icm').AsFloat := 0;
                  vItem.dataSet.FieldByName('fcp_pfcp').AsFloat := 0;
                  vItem.dataSet.FieldByName('fcp_vfcp').AsFloat := 0;
                  vItem.dataSet.FieldByName('fcp_vbcfcp').AsFloat := 0;
                  if (vItem.dataSet.FieldByName('valor_icmsub').AsFloat = 0) then
                  begin
                    vItem.dataSet.FieldByName('cst').AsString :=
                      copy(vItem.dataSet.FieldByName('cst').AsString,1,1)+'60';
                    vItem.dataSet.FieldByName('ANTEC_TRIB').AsString := 'S';
                    Application.MessageBox(pchar('Item nº ' + vItem.dataSet.FieldByName('nitem').AsString +
                      ' é substituição tributária e o sistema removeu a tributação normal de ICMS.'+sLineBreak+
                      'Verifique se o CFOP do item é de Substituição Tributária' ), 'Atenção', 0 + 64);

                    // Removi o teste e processo, pois o campo foi removido
                  end;
                end;
              end;
              }
            end;
          end;

          buscas.Close;
          buscas.SQL.Text := 'select * from CFOP_CST_ENTRADA where cfop = :cfop and cst = '+
            QuotedStr(Copy(vItem.dataSet.FieldByName('cst').AsString,2,2))+
            ' and cod_empresa = '+vDadosIni.codEmpresa;
          buscas.ParamByName('cfop').AsFloat := vItem.dataSet.FieldByName('codigo_nop').AsFloat;
          buscas.Open;

          if buscas.IsEmpty then
            raiseExceptionCreate('Combinação de CFOP com CST não encontrada'+sLineBreak+
              'Por favor entre no cadastro de CFOP e verifique as combinações','');

          vDadosIni.vInibeMensPesqPros := 'S';
          if vDadosIni.PesqPros('NF0115', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
            dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
          begin

            if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'S' then
            begin
              if vItem.dataSet.FieldByName('aliq_icm').AsFloat <= 0 then
                raiseExceptionCreate('ICMS de Preenchimento obrigatório conforme regras estabelecidas', campos[8]);
            end
            else if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'N' then
              if (vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('base_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('valor_icm').AsFloat > 0) then
              begin
                if Application.MessageBox( pchar('Conforme regras estabelecidas o ICMS de não deve ser preenchido! ' + sLineBreak +
                  'Se continuar o sistema irá remover os dados de ICMS do item' + sLineBreak +
                  'Deseja continuar mesmo assim?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
                begin
                  Result := False;
                  Exit;
                end;
                vItem.dataSet.FieldByName('aliq_icm').AsFloat := 0;
                vItem.dataSet.FieldByName('base_icm').AsFloat := 0;
                vItem.dataSet.FieldByName('valor_icm').AsFloat := 0;
                vDadosIni.GravaAuditoria('NF0115', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString + ' REMOVIDO DADOS DE ICMS: VALOR, BASE E ALIQUOTA', 'NOTAFISCAL',
                  dataSet.FieldByName('COD_NF').AsString, buscas2);
              end;

          end;
            //if vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0 then
              //raiseExceptionCreate('ICMS deve ser preenchido zerado conforme regras estabelecidas', campos[8]);

          vDadosIni.vInibeMensPesqPros := 'S';
          if vDadosIni.PesqPros('NF0116', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
            dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
          begin

            if buscas.FieldByName('ICMSST_OBRIGATORIO').AsString = 'S' then
            begin
              if vItem.dataSet.FieldByName('valor_icmsub').AsFloat <= 0 then
                raiseExceptionCreate('ICMS ST de Preenchimento obrigatório conforme regras estabelecidas', campos[8]);
            end
            else if (buscas.FieldByName('ICMSST_OBRIGATORIO').AsString = 'N') and
              (vItem.dataSet.FieldByName('antec_trib').AsString <> 'S') then
              if (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat > 0) or
                (vItem.dataSet.FieldByName('base_icmsub').AsFloat > 0) or
                (vItem.dataSet.FieldByName('mva').AsFloat > 0) or
                (vItem.dataSet.FieldByName('PERC_RED_PROD_SUB').AsFloat > 0) or
                (vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0) then
              begin
                if Application.MessageBox( pchar('Item '+vItem.dataSet.FieldByName('nitem').AsString+' com substituição tributária' + sLineBreak +
                  'Conforme regras estabelecidas o ICMS ST de não deve ser preenchido! ' + sLineBreak +
                  'Se continuar o sistema irá remover os dados de ICMS ST do item' + sLineBreak +
                  'Deseja continuar mesmo assim?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
                begin
                  Result := False;
                  Exit;
                end;
                vItem.dataSet.FieldByName('aliq_icmsub').AsFloat := 0;
                vItem.dataSet.FieldByName('base_icmsub').AsFloat := 0;
                vItem.dataSet.FieldByName('mva').AsFloat := 0;
                vItem.dataSet.FieldByName('PERC_RED_PROD_SUB').AsFloat := 0;
                vItem.dataSet.FieldByName('valor_icmsub').AsFloat := 0;
              end;
          end;

        finally
          vItem.dataSet.Post;
        end;

      except
        on e: exception do
        begin
          Result := False;
          Application.MessageBox(pchar('Item nº ' + vItem.dataSet.FieldByName('nitem').AsString + '. ' + e.Message), 'Atenção', 0 + 64);
          Exit;
        end;
      end;

      vItem.dataSet.Next;
    end;
  end
  else if (dataSet.FieldByName('natureza_nf').AsString = 'S') and
    (vDadosIni.vEmp.vUsarRegraCFOPCSTSaida = 'S') then
  begin

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin

      if (vItem.dataSet.FieldByName('tipo_item').AsString <> 'S') then
      try

        vItem.dataSet.Edit;
        try

          buscas.Close;
          buscas.SQL.Text := 'select * from CFOP_CST_ENTRADA where cfop = :cfop and cst = '+
            QuotedStr(Copy(vItem.dataSet.FieldByName('cst').AsString,2,2))+
            ' and cod_empresa = '+vDadosIni.codEmpresa;
          buscas.ParamByName('cfop').AsFloat := vItem.dataSet.FieldByName('codigo_nop').AsFloat;
          buscas.Open;

          if buscas.IsEmpty then
            raiseExceptionCreate('Combinação de CFOP com CST não encontrada'+sLineBreak+
              'Por favor entre no cadastro de CFOP e verifique as combinações','');

          vDadosIni.vInibeMensPesqPros := 'S';
          if vDadosIni.PesqPros('NF0117', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
            dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
          begin

            if (buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'S') and (vDadosIni.vEmp.vRegime <> 'SIMPLES') then
            begin
              if vItem.dataSet.FieldByName('aliq_icm').AsFloat <= 0 then
                raiseExceptionCreate('ICMS de Preenchimento obrigatório conforme regras estabelecidas', campos[8]);
            end
            else if buscas.FieldByName('ICMS_OBRIGATORIO').AsString = 'N' then
              if (vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('base_icm').AsFloat > 0) or
                (vItem.dataSet.FieldByName('valor_icm').AsFloat > 0) then
                raiseExceptionCreate('ICMS deve ser preenchido zerado conforme regras estabelecidas', campos[8]);

          end;
            //if vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0 then
              //raiseExceptionCreate('ICMS deve ser preenchido zerado conforme regras estabelecidas', campos[8]);

          vDadosIni.vInibeMensPesqPros := 'S';
          if vDadosIni.PesqPros('NF0118', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
            dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
          begin

            if buscas.FieldByName('ICMSST_OBRIGATORIO').AsString = 'S' then
            begin
              if vItem.dataSet.FieldByName('valor_icmsub').AsFloat <= 0 then
                raiseExceptionCreate('ICMS ST de Preenchimento obrigatório conforme regras estabelecidas', campos[8]);
            end
            else if buscas.FieldByName('ICMSST_OBRIGATORIO').AsString = 'N' then
              if (vItem.dataSet.FieldByName('aliq_icmsub').AsFloat > 0) or
                (vItem.dataSet.FieldByName('base_icmsub').AsFloat > 0) or
                (vItem.dataSet.FieldByName('mva').AsFloat > 0) or
                (vItem.dataSet.FieldByName('PERC_RED_PROD_SUB').AsFloat > 0) or
                (vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0) then
                raiseExceptionCreate('Campos de ICMS ST devem ser preenchidos zerados conforme regras estabelecidas', campos[8]);
          end;

        finally
          vItem.dataSet.Post;
        end;

      except
        on e: exception do
        begin
          Result := False;
          Application.MessageBox(pchar('Item nº ' + vItem.dataSet.FieldByName('nitem').AsString + '. ' + e.Message), 'Atenção', 0 + 64);
          Exit;
        end;
      end;

      vItem.dataSet.Next;
    end;

  end;

  vItem.dataSet.First;

  if fdif('devolucao', 'SIM') then
    while not vItem.dataSet.Eof do
    begin
      if Copy(vItem.dataSet.FieldByName('codigo_nop').AsString, 2, 3) = '929' then
        if (vItem.dataSet.FieldByName('ncupom').AsInteger <= 0) and (vItem.dataSet.FieldByName('cod_nfce').AsInteger <= 0) then
        begin
          if (not vSped.vC110.vC113.dataSet.Active) or
             (vSped.vC110.vC113.fdif('cod_nf', fstr('cod_nf'))) then
            vSped.vC110.vC113.abreC113(fint('cod_nf'));
          
          vSped.vC110.vC113.dataSet.First;
          while not vSped.vC110.vC113.dataSet.Eof do
          begin
            if vSped.vC110.vC113.fstr('CHAVE_NFE_REF', 21, 2) = '65' then
            begin
              Result := True;
              Exit;
            end;

            vSped.vC110.vC113.dataSet.Next;
          end;          

          Application.MessageBox(pchar('Item nº ' + vItem.dataSet.FieldByName('nitem').AsString +
            ' com CFOP ' + vItem.dataSet.FieldByName('codigo_nop').AsString +
            ' que referencia cupons fiscais ou NFC-e.'+sLineBreak+
            'Este CFOP não é aceito pois não existe a referencia dos cupons fiscais ou NFC-e' ), 'Atenção', 0 + 64);
          Exit;
        end;
      vItem.dataSet.Next;
    end;

  Result := True;
end;

function TNFCab.validarUnidadeMedidaCompra: Boolean;
var
  nfItens: TNotafiscal_item_classList;
  itemNf: TNotafiscal_item_class;
  itensAudit: THw_auditoria_classList;
  I: Integer;
begin
  Result := True;

  nfItens := TNotafiscal_item_classList.Create;
  itensAudit := THw_auditoria_classList.Create('NOTAFISCAL');
  try

//    nfItens.SetValuesFrom(
//      queryCons.Table('notafiscal_item ni', 'ni.nitem, p.unidade referencia, ni.unidade_nf, ni.ucom, ni.quantidade, ni.qtdemb, ni.qtdembrec, ni.qcom, ni.valor_unitario, ni.vlrembnf, ni.vuncom')
//        .Join('produtos p', '(p.grupo_prod = ni.grupo_prod) and (p.cod_prod = ni.cod_prod) and (p.cod_empresa = ni.cod_empresa)')
//        .Equals('ni.cod_nf', fint('cod_nf'))
//        .Equals('ni.cod_empresa', fint('cod_empresa'))
//        .OrderBy('ni.nitem')
//        .Open().query, True);
    nfItens.SetValuesFrom(vItem.dataSet, True);

    for I := 0 to nfItens.Count - 1 do
    begin
      itemNf := nfItens.Items[I];

      if (itemNf.ucom <> '') and (AnsiUpperCase(itemNf.ucom) <> AnsiUpperCase(itemNf.referencia)) and (itemNf.unidade_nf = '') then // Tem no XML, difere do produto e não converteu
      begin

        with itensAudit.New do
        begin
          cod_processo := 'NF0242';
          acao         := 'VALIDAR';
          mensagem     := Format('NUM NF %d NITEM: %d | Conversão de unidade não realizada [ %s > %s ]  ', [fint('num_nf'), itemNf.nitem, itemNf.ucom, itemNf.referencia]);
          codigo       := fstr('cod_nf');
          gravar       := True;
        end;
        itensAudit.Mensagem.Add(itensAudit.Last.mensagem);
      end
      else if (itemNf.ucom <> '') and (AnsiUpperCase(itemNf.ucom) <> AnsiUpperCase(itemNf.referencia)) and ((itemNf.qtdembrec = 0) or (itemNf.qtdemb = 0)) then // Tem no XML, difere do produto, sem fator de conversão ou qtde 0
      begin
        with itensAudit.New do
        begin
          cod_processo := 'NF0241';
          acao         := 'VALIDAR';
          mensagem     := Format('NUM NF %d NITEM: %d | Conversão de unidade não realizada [ %s > %s ]  ', [fint('num_nf'), itemNf.nitem, itemNf.ucom, itemNf.referencia]);
          codigo       := fstr('cod_nf');
          gravar       := True;
        end;
        itensAudit.Mensagem.Add(itensAudit.Last.mensagem);
      end;
    end;

    if itensAudit.Count > 0 then
      if vDadosIni.PesqPros(itensAudit, buscas) then
        itensAudit.Mensagem.Clear
      else
        ShowAtencao(itensAudit.ProcessosNaoPermitidosToStr());

    Result := itensAudit.Mensagem.Count = 0;

  finally
    nfItens.Free;
    itensAudit.Free;
    queryCons.Close();
  end;
end;

function TNFCab.validarValorPedidoCorrespondente: Boolean;
var
  valorPedido: Double;
begin
  Result := True;

  if (fequals('natureza_nf', 'E') or (not fequals('tipo_ped', 'REQ')) or (fint('nped') = 0)) then
    Exit;

  try
    valorPedido := SqlScalar('select valor_total from pedvenda' +
                             ' where nped = %d and tipo = %s and cod_empresa = %d',
                             [fint('nped'), fstrq('tipo_ped'), vDadosIni.cod_empresa]).AsFloat;

    if Abs(RoundTo(ffloat('valor_total') - valorPedido, -2)) > 0.50 then
    begin
      // processo para permitir continuar com valor diferente
      ShowAtencao('Valor da nota fiscal difere do valor do pedido' + _DLB +
                  'Valor Nota Fiscal: %0.2f' + _LB +
                  'Valor Pedido: %0.2f' + _DLB +
                  'Se a alteração de valores foi proposital, favor prosseguir com a validação do processo' + sLineBreak +
                  'Caso contrário, pode ser alguma alíquota de imposto que que sofreu alteração após a conclusão do pedido,' + _DLB +
                  'Se não identificar a solução por favor contacte o suporte técnico',
                  [ffloat('valor_total'), valorPedido]);

      if not vDadosIni.PesqPros('NF0224', 'VALIDAR', '', 'NOTAFISCAL', fstr('cod_nf'), buscas, False, False, True) then
      begin
        Result := False;
        Exit;
      end;
    end;

  except on E: Exception do
    begin
      Result := False;
      ShowErro(E.message);
    end;
  end;
end;

function TNFCab.validaSerie: boolean;
var
  vModelo: string;
  vSerie: string;
  ValidacaoAlternativa, PermiteSerieNula, PermiteSubserieNula: Boolean;
  ValidacaoSerie, ValidacaoSubserie, ValoresSerie, ValoresSubserie : string;
  List: TStrings;
  I: Integer;
  vTmp, vSubSerie: string;
begin
  try
    vModelo := Trim(dataSet.FieldByName('modelo_nf').AsString);
    ValidacaoAlternativa := AsTrueValue(Config.Conf_Geral.nf_e_hab_validacao_alternativa_modelo.value1_f);
    if ValidacaoAlternativa then
    begin
      ValidacaoAlternativa := False;
      //List := TStringList.Create;
      List := Config.Conf_Geral.nf_e_hab_validacao_alternativa_modelo.value1_b;
      for I := 0 to List.Count - 1 do
      begin
        vTmp := vDadosIni.getValue(Trim(List[i]), 1);
        ValidacaoAlternativa := vDadosIni.StrZero(Trim(vModelo), 3) = vDadosIni.StrZero(Trim(vTmp), 3);
        if ValidacaoAlternativa then
        begin
          ValidacaoSerie      := Trim(vDadosIni.getValue(List[i], 2));
          vTmp                := Trim(vDadosIni.getValue(List[i], 3));
          PermiteSerieNula    := vDadosIni.IfThen(vTmp = '', True, vTmp = 'S');
          ValoresSerie        := Trim(vDadosIni.getValue(List[i], 4));
          ValidacaoSubserie   := Trim(vDadosIni.getValue(List[i], 5));
          vTmp                := Trim(vDadosIni.getValue(List[i], 6));
          PermiteSubserieNula := vDadosIni.IfThen(vTmp = '', True, vTmp = 'S');
          ValoresSubserie     := Trim(vDadosIni.getValue(List[i], 7));
          Break;
        end;
      end;

      if ValidacaoAlternativa then
      begin
        vSerie    := Trim(dataSet.FieldByName('serie').AsString);
        vSubSerie := Trim(dataSet.FieldByName('subserie').AsString);
        if (not PermiteSerieNula) and (Trim(vSerie) = '') then
          raiseexceptioncreate('A série para o modelo "' + vModelo + '" de preenchimento obrigatório conforme configuração do sistema', 'DBEEdit47')
        else if ValidacaoSerie = 'N' then
        begin
          if (not PermiteSerieNula) or (Trim(vSerie) <> '') then
            if StrToIntDef(vSerie, -99) = -99 then
              raiseexceptioncreate('A série para o modelo "' + vModelo + '" deve ser numérica conforme configuração do sistema', 'DBEEdit47');
        end;
        if (Trim(ValoresSerie) <> '') and (Trim(vSerie) <> '') then
        begin
          vTmp := vDadosIni.StringReplace2(ValoresSerie, ',;.', '|||', True) + '|';
          List := vDadosIni.SplitS(vTmp);
          vTmp := '';
          for I := 0 to List.Count - 1 do
            if vDadosIni.StrZero(Trim(List[i]), 5) = vDadosIni.StrZero(Trim(vSerie), 5) then
              vTmp := 'OK';
          if vTmp = '' then
            raiseexceptioncreate('A série para o modelo "' + vModelo + '" deve ser preenchida apenas com um dos valores "' + Trim(ValoresSerie) +
              '" conforme configuração do sistema', 'DBEEdit47');
        end;

        if (not PermiteSubserieNula) and (Trim(vSubSerie) = '') then
          raiseexceptioncreate('A subserie para o modelo "' + vModelo + '" de preenchimento obrigatório conforme configuração do sistema', 'DBEEdit47')
        else if ValidacaoSubserie = 'N' then
        begin
          if (not PermiteSubserieNula) or (Trim(vSubSerie) <> '') then
            if StrToIntDef(vSubSerie, -99) = -99 then
              raiseexceptioncreate('A subserie para o modelo "' + vModelo + '" deve ser numérica conforme configuração do sistema', 'DBEEdit47');
        end;
        if (Trim(ValoresSubserie) <> '') and (Trim(vSubSerie) <> '') then
        begin
          vTmp := vDadosIni.StringReplace2(ValoresSubserie, ',;.', '|||', True) + '|';
          List := vDadosIni.SplitS(vTmp);
          vTmp := '';
          for I := 0 to List.Count - 1 do
            if vDadosIni.StrZero(Trim(List[i]), 5) = vDadosIni.StrZero(Trim(vSubSerie), 5) then
              vTmp := 'OK';
          if vTmp = '' then
            raiseexceptioncreate('A subserie para o modelo "' + vModelo + '" deve ser preenchida apenas com um dos valores "' + Trim(ValoresSubserie) +
              '" conforme configuração do sistema', 'DBEEdit47');
        end;

        Result := True;
        Exit;
      end;
    end;
    
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      if (Trim(dataSet.FieldByName('sem_serie').AsString) <> 'S') then
        if dataSet.FieldByName('serie').AsString = '' then
          raiseExceptionCreate('Série da Nota Fiscal não informada', 'DBEdit47');

    if (vModelo = '1')
      or (vModelo = '01')
      or (vModelo = '1A')
      or (vModelo = '1-A')
      or (vModelo = '4')
      or (vModelo = '04') 
      or (vModelo = 'E')
      or (vModelo = 'O') then
//      or (vModelo = '55') then
    begin
      if ((vModelo = '1') or (vModelo = '01') or (vModelo = '1-A') or (vModelo = '1A') or (vModelo = 'E') or (vModelo = 'O')) and
       (Trim(dataSet.FieldByName('sem_serie').AsString) = 'S') then
      else
      begin
        vSerie := Trim(dataSet.FieldByName('serie').AsString);
        if (vModelo <> 'E') and (vModelo <> 'O') then
        try
          StrToInt(vSerie);
          if (StrToInt(vSerie) = 0) then
            raiseexceptioncreate('A série para modelos 01, 04 ou 1A deve ser numérica e maior que zero', 'DBEEdit47');//raiseexceptioncreate('A série para modelos 01, 04, 1A ou 55 deve ser numérica e maior que zero', 'DBEEdit47');
        except
          raiseexceptioncreate('A série para modelos 01, 04 ou 1A deve ser numérica e não poderá ficar em branco', 'DBEEdit47');//raiseexceptioncreate('A série para modelos 01, 04, 1A ou 55 deve ser numérica e não poderá ficar em branco', 'DBEEdit47');
        end;
      end;
    end
    else
    try
      StrToInt(vModelo);
    except
      raiseexceptioncreate('O modelo da nota fiscal deve conter apenas números', 'DBEEdit50');
    end;

    vModelo := Trim(dataSet.FieldByName('modelo_nf').AsString);
    if (vModelo = '6')
      or (vModelo = '06') then
    begin
      vSerie := Trim(dataSet.FieldByName('serie').AsString);
      if (vSerie <> 'U')
        and (vSerie <> 'B')
        and (vSerie <> 'C') then
        raise exception.create('A série para modelos 06, 21 ou 22 deve ser "U", "B" ou "C"');
    end;
    Result := True;
  except
    on E: Exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

