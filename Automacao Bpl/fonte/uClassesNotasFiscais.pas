function TNFCab.abreFormImpressao: boolean;
var
  formulario: TfrmPadrao;
  vCadProduto: TProdutos;
  I: Integer;
  vQtdeEtiq: Integer;
  vCodEtiq: Integer;
  vTemp: string;
  conf: TConfig_sistema_class;
begin
  if not vDadosIni.PesqPros('NF0019', 'IMPRIMIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Gerenciamento de Impressão';
    frmCadNF.pnImpressao.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;

    frmCadNF.CheckListEtiq.Visible := False;

    conf := TCfg_sis.getConf('nf_etiqueta_danfe', buscas, vDadosIni.cod_empresa);

    if conf.ReadString('Conf', 'TelaImpressaoEtiquetas') <> 'S' then
    begin
      frmCadNF.CheckListEtiq.Visible := False;
      frmCadNF.CheckListEtiq.Clear;
    end
    else
    if dataSet.FieldByName('NATUREZA_NF').AsString = 'S' then
    begin
    	PreencherCamposDisplayDanfe(buscas);

      buscas.Close;
      buscas.SQL.Text := ' select cod_etiqueta, descricao, quant_impressao from cabecalho_etiqueta ' +
        ' where tabela = ''NOTAFISCAL_DANFE'' ' +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by cod_etiqueta ';
      buscas.Open;

      frmCadNF.CheckListEtiq.Visible := not buscas.IsEmpty;

      frmCadNF.CheckListEtiq.Clear;
      buscas.First;
      while not buscas.Eof do
      begin
        if (buscas.FieldByName('quant_impressao').AsInteger = 1)
          and (dataSet.FieldByName('qtde_volumes_tr').AsInteger > 1) then
            vQtdeEtiq := dataSet.FieldByName('qtde_volumes_tr').AsInteger
        else
            vQtdeEtiq := 1;

        frmCadNF.CheckListEtiq.Items.Add(
          IntToStr(buscas.FieldByName('cod_etiqueta').AsInteger) + ' - ' +
          trim(buscas.FieldByName('descricao').AsString) + ' | ' +
          IntToStr(vQtdeEtiq)
        );

        buscas.Next;
      end;
    end;

    try
      vImpNF := False;
      vImpEspelho := False;
      vImpResumo := False;
      vImpEtiTerm := False;
      vImpEtiComum := False;
      vImpRelProdAlterados := False;
      vImpEtiqPeq := False;
      vImpEtiqGra := False;
      vImpEtiq1Col := False;
      vImpCopiaCTP := False;
    except
    end;
    result := (formulario.ShowModal = mrOk); //;then
    if not Result then
      exit;
    try
      Screen.Cursor := crHourGlass;

      if vImpNF then
        imprimeNotaFiscal;
      if vImpEspelho then
        imprimeEspelhoNF;
      if vImpResumo then
      begin
        vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
        vClFor.selecionaClFor();
        imprimirResumo;
      end;
      if vImpEtiTerm then
        vCadProduto._abreFormEtiquetasTerm(dataSet.FieldByName('COD_NF').AsInteger);
      if vImpEtiComum then
        vCadProduto._abreFormEtiquetasComum(dataSet.FieldByName('COD_NF').AsInteger);
      if vImpRelProdAlterados then
        imprimeRelacaoProdutosAlterados;
      if vImpEtiqPeq or vImpEtiqGra or vImpEtiq1Col then
        ajustarCabecaImpressao;
      if vImpEtiqPeq then
        imprimeEtiquetasPequenas;
      if vImpEtiqGra then
        imprimeEtiquetasGrandes;
      if vImpEtiq1Col then
        imprimeEtiquetas1Coluna;
      if vImpCopiaCTP then
        vDadosIni.ctp_relatorio_por_nf(dataSet.FieldByName('num_nf').AsInteger,
          dataSet.FieldByName('cod_cliente').AsInteger,
          dataSet.FieldByName('serie').AsString,
          dataSet.FieldByName('data_lanc').AsDateTime);

      for I := 0 to frmCadNF.CheckListEtiq.Items.Count - 1 do
      begin
      	if frmCadNF.CheckListEtiq.Checked[I] then
        begin
        	// Cod Etiq
          vTemp := frmCadNF.CheckListEtiq.Items[I];
          vCodEtiq := StrToInt(trim(Copy(vTemp, 1, pos('-', vTemp) - 1)));

          // Quant Etiq
        	vTemp := frmCadNF.CheckListEtiq.Items[I];
        	while Pos('|', vTemp) > 0 do
        		System.Delete(vTemp, 1, Pos('|', vTemp));
        	vQtdeEtiq := StrToInt(trim(vTemp));

          SetLength(FarrayOfcod_nf, 1);
          FarrayOfcod_nf[High(FarrayOfcod_nf)] := get_cod_nf;

        	imprimeDanfeSimplificadoDadosTransporte(vCodEtiq, vQtdeEtiq);
        end;
      end;
    finally
      Screen.Cursor := crDefault;
    end;
  finally
    frmCadNF.pnImpressao.Parent := frmCadNF.tsImpressao;
    formulario.Free;
    formulario := nil;
  end;
end;

