  if (vItem.dataSet.RecordCount > 0) then
    if (vItem.dataSet.RecordCount < vQtdeProdNf) then
      AQtdeFolhas := 1
    else
      AQtdeFolhas := ceil((vItem.dataSet.RecordCount - AQtdeFolhas) / vQtdeItensNf);

  vQtdeImpLinhas := 0;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vQtdeImpLinhas := vQtdeImpLinhas + 1;
    imprimeLinha(vLinha, 002, 03, vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3));
    if vItem.dataSet.FieldByName('tipo_item').asstring <> 'P' then
      vDescricao := vDadosIni.StrZero(vItem.dataSet.FieldByName('num_fab_prod').AsString, 10)
    else
      vDescricao := copy(vDadosIni.StrZero(vItem.dataSet.FieldByName('grupo_prod').AsString +
        Trim(vItem.dataSet.FieldByName('cod_prod').AsString), 10) + '     ', 1, 10);
    vDescricao := vDescricao + ' ' + vItem.dataSet.FieldByName('descricao_item').AsString;
    imprimeLinha(vLinha, 006, 67, Copy(vDescricao, 1, 62));
    imprimeLinha(vLinha, 069, 00, vItem.dataSet.FieldByName('cst').AsString);
    imprimeLinha(vLinha, 073, 00, vItem.dataSet.FieldByName('referencia').AsString);
    imprimeLinha(vLinha, 077, 00, vDadosIni.AlnDir(format('%0.3f',
      [vItem.dataSet.FieldByName('quantidade').AsFloat]), 8));
    vFormat := '%0.2n';
    if (vDadosIni.vEmp.vCasasDecimais > 0) then
      vFormat := '%0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais) + 'n';
    imprimeLinha(vLinha, 086, 00, vDadosIni.AlnDir(format(vFormat,
      [vItem.dataSet.FieldByName('valor_unitario').AsFloat]), 10));
    imprimeLinha(vLinha, 097, 00, vDadosIni.AlnDir(format('%0.2f',
      [vItem.dataSet.FieldByName('valor_total').AsFloat]), 10));
    imprimeLinha(vLinha, 108, 05, vDadosIni.AlnDir(format('%0.2f',
      [vItem.dataSet.FieldByName('perc_red_prod').AsFloat]), 5));
    imprimeLinha(vLinha, 114, 05, vDadosIni.AlnDir(format('%0.2f',
      [vItem.dataSet.FieldByName('aliq_icm').AsFloat]), 5));
    imprimeLinha(vLinha, 120, 05, vDadosIni.AlnDir(format('%0.2f',
      [vItem.dataSet.FieldByName('aliq_ipi').AsFloat]), 5));
    imprimeLinha(vLinha, 126, 04, vDadosIni.AlnDir(format('%0.0f',
      [vItem.dataSet.FieldByName('codigo_nop').AsFloat]), 4)); vLinha := vLinha + 1;
    vItem.dataSet.Next;
    if AFolha < AQtdeFolhas then
    begin
      if (vQtdeImpLinhas >= (vQtdeItensNf + 20)) and (not vItem.dataSet.Eof) then
      begin
        vLinha := vLinha + 1;
        imprimeRodape;
        vRdpNf.Novapagina;
        imprimeCabecalho;
        vQtdeImpLinhas := 0;
      end;
    end
    else
    if (vQtdeImpLinhas >= vQtdeItensNf) and (not vItem.dataSet.Eof) then
    begin
      vLinha := vLinha + 1;
      imprimeRodape;
      vRdpNf.Novapagina;
      imprimeCabecalho;
      vQtdeImpLinhas := 0;
    end;
  end;
  vLinha := vLinha + 1;
  imprimeRodape;
  if (vLinha + vBol.dataSet.RecordCount + High(FCst) + 1) > 65 then
  begin
    vRdpNf.Novapagina;
    vLinha := 1;
  end;
  imprimeLinha(vLinha, 001, 130, vDadosIni.Replicate('-', 130)); vLinha := vLinha + 1;
  imprimeLinha(vLinha, 002, 130, 'DADOS ADICIONAIS'); vLinha := vLinha + 1;
  imprimeLinha(vLinha, 001, 130, vDadosIni.Replicate('-', 130)); vLinha := vLinha + 1;
  if (vDadosIni.vEmp.vRegime = 'SIMPLES') and fequals('natureza_nf', 'S') and (fdif('tipo_emissao', '4') or fdif('modelo_nf', '55')) then
  begin
    imprimeLinha(vLinha, 002, 130, 'CSOSN        TOTAL'); vLinha := vLinha + 1;
    validaSomatorioCsosn;
  end
  else
  begin
    imprimeLinha(vLinha, 002, 130, 'CST        TOTAL'); vLinha := vLinha + 1;
    validaSomatorioCst;
  end;
  k := 0;
  if High(FCst) > -1 then
    K := High(FCst);
  for I := Low(FCst) to High(FCst) do
  begin
    imprimeLinha(vLinha, 002, 003, fcst[i].cst);
    imprimeLinha(vLinha, 006, 000, vDadosIni.AlnDir(format('%0.2n', [fcst[i].valorCstCsosn]), 12));
    vLinha := vLinha + 1;
  end;
  vLinha := vLinha + 1;
  imprimeLinha(vLinha, 001, 130, vDadosIni.Replicate('-', 130));
  imprimeLinha(vLinha, 050, 000, '[ Relacao de Parcelas ]'); vLinha := vLinha + 1;
  imprimeLinha(vLinha, 002, 130, 'N.Doc          Data Vencimento                          Valor');
  vLinha := vLinha + 1;
  vValorTotalParcelas := 0;
  vBol.dataSet.First;
  while not vBol.dataSet.Eof do
  begin
    imprimeLinha(vLinha, 002, 000, vBol.dataSet.FieldByName('n_doc_bol').AsString);
    imprimeLinha(vLinha, 020, 000, vBol.dataSet.FieldByName('data_ven_bol').AsString);
    imprimeLinha(vLinha, 051, 000, vDadosIni.AlnDir(format('%0.2n',
      [vBol.dataSet.FieldByName('vl_doc_bol').AsFloat]), 12)); vLinha := vLinha + 1;
    vValorTotalParcelas := vValorTotalParcelas + vBol.dataSet.FieldByName('vl_doc_bol').AsFloat;
    vBol.dataSet.Next;
  end;
  imprimeLinha(vLinha, 002, 000, 'TOTAL GERAL...:');
  imprimeLinha(vLinha, 051, 000, vDadosIni.AlnDir(format('%0.2n', [vValorTotalParcelas]), 12));
  vRdpNf.Fechar;
end;

function TNFCab.imprimeEtiquetas1Coluna: boolean;
var
  Arquivo: TextFile;
  b: Integer;
  i: Integer;
  CodBarra, DescGrade, DescGrade1: array of string;
  Quant: array of Integer;
  QtdeEmt: string;
  ClickedOK: Boolean;
  cont: Integer;
  j: integer;
  itmax: integer;
  k: Integer;
  vQuant: Integer;
  grade: Boolean;
begin
  if not vDadosIni.PesqPros('NF0025', 'IMPRIMIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  b := 0;
  j := 0;
  vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
  vClFor.selecionaClFor;
  vItem.dataSet.First;
  try
    AssignFile(Arquivo, vDadosIni.vPortaImpressora);
    Rewrite(Arquivo);
    while not vItem.dataSet.eof do
    begin
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString);

        buscas.Close;
        buscas.SQL.Text := 'select * from COD_GRADE_PROD P, GRADE G where P.GRUPO_PROD = ' +
          vItem.dataSet.FieldByName('grupo_prod').AsString
          + ' and P.COD_PROD = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
          ' and P.COD_EMPRESA = ' + vDadosIni.CodEmpresa
          + ' and P.COD_GRADE = G.COD_GRADE and P.COD_EMPRESA = G.COD_EMPRESA';
        buscas.Open;
        grade := false;
        if not buscas.IsEmpty then
        begin
          buscas.First;
          i := 0;
          SetLength(CodBarra, buscas.RecordCount);
          SetLength(DescGrade, buscas.RecordCount);
          SetLength(DescGrade1, buscas.RecordCount);
          SetLength(Quant, buscas.RecordCount);
          while not buscas.Eof do
          begin
            if not buscas.FieldByName('DESCRICAO').IsNull then
              DescGrade[i] := buscas.FieldByName('DESCRICAO').Text;
            if not buscas.FieldByName('DESCRICAO1').IsNull then
              DescGrade1[i] := buscas.FieldByName('DESCRICAO1').Text;
            if not buscas.FieldByName('QTDE').IsNull then
              Quant[i] := buscas.FieldByName('QTDE').Value;

            CodBarra[i] := vDadosIni.retornaCodBarraEtiqueta(
              buscas,
              vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger,
              vItem.dataSet.FieldByName('COD_PROD').AsString,
              buscas.FieldByName('COD_GRADE').AsInteger,
              vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString);
              
//            CodBarra[i] := 'G-' + vDadosIni.StrZero(StrToInt(vDadosIni.CodEmpresa), 2) +
//              vItem.dataSet.FieldByName('GRUPO_PROD').AsString
//              + vItem.dataSet.FieldByName('COD_PROD').AsString + '/' +
//              buscas.FieldByName('COD_GRADE').AsString;
            inc(i);
            buscas.Next;
            grade := True;
          end;
        end
        else
        begin
          SetLength(CodBarra, 1);
          SetLength(DescGrade, 1);
          SetLength(DescGrade1, 1);
          SetLength(Quant, 1);
          DescGrade[0] := '';
          DescGrade1[0] := '';
          Quant[0] := 0;

          CodBarra[0] := vDadosIni.retornaCodBarraEtiqueta(
            buscas,
            vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger,
            vItem.dataSet.FieldByName('COD_PROD').AsString,
            buscas.FieldByName('COD_GRADE').AsInteger,
            vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString);

//          CodBarra[0] := vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString;
        end;

        for K := 0 to Length(Quant) - 1 do
        begin
          WriteLn(Arquivo, 'ZT'); //ZT
          WriteLn(Arquivo, 'q400');
          WriteLn(Arquivo, 'Q200,24');
          WriteLn(Arquivo, 'ON');
          WriteLn(Arquivo, 'D10');
          WriteLn(Arquivo, 'JF');
          WriteLn(Arquivo, 'S5');
          WriteLn(Arquivo, 'N');

          if not grade then
            if (vItem.vProd.dataSet.FieldByName('EST_F').AsFloat {+
              vItem.vProd.dataSet.FieldByName('EST_R').AsFloat}) > 0 then
              Quant[k] := ceil(vItem.vProd.dataSet.FieldByName('EST_F').AsFloat {+
                vItem.vProd.dataSet.FieldByName('EST_R').AsFloat});

          Quant[k] := getQuantidadeEtiquetas(Quant[0], '[Uma Coluna]');

          for cont := 0 to quant[k] - 1 do
          begin
            QtdeEmt := IntToStr(Quant[k]);
            WriteLn(Arquivo, 'B' + IntToStr(b + 15) + ',' + IntToStr(10) + ',0,1,2,2,64,B,"' +
              CodBarra[k] + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 15) + ',' + IntToStr(105) + ',0,2,1,1,N,"' +
              Copy((vItem.vProd.dataSet.FieldByName('DESCR_PROD').AsString), 1, 30) + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 15) + ',' + IntToStr(125) + ',0,2,1,1,N,"MARCA: '
              +
              copy(vItem.vProd.dataSet.FieldByName('MARCA_P').AsString, 1, 10) + ' - ' +
              copy(vItem.vProd.dataSet.FieldByName('APLICACAO_PROD').AsString, 1, 12) + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 15) + ',' + IntToStr(145) + ',0,2,1,1,N,"TAM:' +
              Copy(DescGrade[k], 1, 15) + '   ' + Copy(DescGrade1[k], 1, 15) + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 15) + ',' + IntToStr(170) + ',0,4,1,1,N,"' +
              Format('%m', [vItem.vProd.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency]) + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 15) + ',' + IntToStr(185) +
              ',0,1,1,1,N,"                           ' +
              StringReplace(vItem.vProd.dataSet.FieldByName('DAT_CAD_PROD').AsString, '/', '',
              [rfReplaceAll]) + '"');
            WriteLn(Arquivo, 'P' + QtdeEmt + '');
          end;
        end;
      end;
      vItem.dataSet.Next;
    end;
  finally
    CloseFile(Arquivo);
  end;
end;

