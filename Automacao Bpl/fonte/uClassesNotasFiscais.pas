      vItem.vDetVeic.dataSet.FieldByName('CERTIFICADO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('CERTIFICADOEST').AsString);
      vItem.vDetVeic.dataSet.FieldByName('DATA_CERTIFICADO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('DATA_CERTIFICADOEST').AsString);
      vItem.vDetVeic.dataSet.FieldByName('CATEGORIA').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('CATEGORIAEST').AsString);
      vItem.vDetVeic.dataSet.FieldByName('NF_AQ').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('NF_AQ').AsString);
      vItem.vDetVeic.dataSet.FieldByName('SERIE_AQ').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('serie').AsString);
      vItem.vDetVeic.dataSet.FieldByName('COD_FORN_AQ').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('cod_fornecedor').AsString);
      vItem.vDetVeic.dataSet.FieldByName('DATA_AQ').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('data_ch_nota').AsString);
      vItem.vDetVeic.dataSet.FieldByName('CODIGO').AsInteger :=
        vComFat.vItem.dataSet.FieldByName('codigo').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('DAT_CADM').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('data_ch_nota').AsString);
      vItem.vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString :=
