procedure TNFCab.AtualizarDataHoraEmisssao(dataHora: TDateTime);
var
  dateDiff: Integer;
  dhEmi: TDateTime;
begin
  if dataSet.IsEmpty then
    Exit;

  try
    dataSet.RefreshRecord;

    if not fstrin('situacao_nfe', [sitVazio, sitRejeitada])  then
    begin
      ShowAtencao('Nota fiscal não pode ser alterada. Situação "%s"', [fstr('situacao_nfe')]);
      Exit;
    end;

    if not Auditor.Processo('NF0229', Format('DE %s %s PARA %s', [fstr('data_contabil'), fstr('hora_emissao'), DateTimeToStr(dataHora)]), fstr('cod_nf'))
      .Alterar().Permitido then
      Exit;

    dhEmi := fdate('data_contabil') + StrToTime(fstr('hora_emissao'));
    dateDiff := Trunc(DateOf(dataHora) - vDadosIni.FusoDate(true));

    if Abs(dateDiff) > 30 then
      if ShowConfirmacao('Data com 30 dias superior a data de hoje. Deseja mesmo continuar?') <> IDYES then
        Exit;

    SqlExec('update notafiscal set data_contabil = %s, hora_emissao = ''%s''' +
            ' where cod_nf = %d and cod_empresa = %d',
            [date_fb(DateOf(dataHora)), FormatDateTime('hh:mm:ss', TimeOf(dataHora)),
             fint('cod_nf'), vDadosIni.cod_empresa]).Transaction.Commit;

    Auditor.Sucesso().GravarMensagem('');

  except on E: Exception do
    begin
      Auditor.Falha().GravarMensagem('');
      ShowErro('Erro ao ajustar da data de emissão: %s', [e.Message]);
      registraErro('TNFCab.AtualizarDataHoraEmisssao - %s', [DateTimeToStr(dataHora)]);
    end;
  end;
end;

function TNFCab.atualizaValorTotalPedVenda(pTipo: string; pNPed: Integer;
  const pArgs: array of C_OperacaoPedVenda): Boolean;
var
  vValorTotalDespNF, vTemp, vSomaSemArredondar: Extended;
  vAlt: string;
  vRemoverDespesaNF, vAtualizarDespesaNF, vAtualizarTotalVenda: Boolean;
  I: Integer;
  vListaAtualizarValorPedVenda: TStringList;
  AdoIt: Boolean;
  AlistPed: TAuxped_classList;
  Apedit: TAuxped_class;

  procedure _atualizaTotalPedvenda(_pTipo: string; _pNPed: Integer);
  var
    vValorTotalPedVenda: Extended;
  begin
    AdoIt := True;
    if (Trim(_pTipo) <> '') and (_pNPed > 0) then
    begin
      Apedit := AlistPed.GetAuxPed(_pNPed, Trim(_pTipo));
      if Assigned(Apedit) then
      begin
        AdoIt := Trim(Apedit.nf_ac_calctrib) = '';
        Apedit.ShowLog('Atualiza total pedvenda');
      end;
    end;
    if not AdoIt then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select sum( coalesce(vltot_ped_item, 0) + coalesce(rateio_acresc, 0) -' +
      ' coalesce(rateio_desc, 0)) soma from pedvenda_prod' +
      ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''' +
      ' union all' +
      ' select sum( coalesce(valor_tot_serv, 0) + coalesce(rateio_acresc, 0) -' +
      ' coalesce(rateio_desc, 0)) soma from pedvenda_serv' +
      ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''' +
      ' union all' +
      ' select sum( coalesce(vl_total, 0) ) soma from pedvenda_prod_terc' +
      ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped' +
      ' union all' +
      ' select sum( coalesce(vl_servt, 0) ) soma from pedvenda_serv_terc' +
      ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped';
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
    buscas.ParamByName('TIPO').AsString := _pTipo;
    buscas.ParamByName('NPED').AsInteger := _pNPed;
    buscas.Open;
    vValorTotalPedVenda := 0;
    buscas.First;
    while not buscas.Eof do
    begin
      vValorTotalPedVenda := vValorTotalPedVenda + buscas.FieldByName('soma').AsFloat;
      buscas.Next;
    end;
    buscas.Close;
    buscas.SQL.Text := 'update pedvenda set valor_total = :valor_total' +
      ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped';
    buscas.ParamByName('VALOR_TOTAL').AsFloat := vDadosIni.StrToFloatFormat(vValorTotalPedVenda, 2);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
    buscas.ParamByName('TIPO').AsString := _pTipo;
    buscas.ParamByName('NPED').AsInteger := _pNPed;
    buscas.ExecSQL;
    buscas.Close;
  end;

begin
  try
    Result := True;
    vRemoverDespesaNF := False;
    vAtualizarDespesaNF := False;
    vAtualizarTotalVenda := False;

    for I := 0 to Length(pArgs) - 1 do
      if pArgs[I] = opvAtualizarTotal then
        vAtualizarTotalVenda := True
      else if pArgs[I] = opvRemoverDespesasNF then
        vRemoverDespesaNF := True
      else if pArgs[I] = opvAtualizarDespesasNF then
        vAtualizarDespesaNF := True;

    if vAtualizarDespesaNF then // isso ocorre quando a nota é confirmada
    begin
      vDadosIni.vInibeMensPesqPros := 'S';
      if not vDadosIni.PesqPros('NF0181', 'HABILITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString,
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas, True) then
        Exit;
    end;

    AlistPed := TAuxped_classList.Create;

    if (pNPed > 0) and (Trim(pTipo) <> '') then
    begin
      Apedit := AlistPed.New;
      Apedit.nped := pNPed;
      Apedit.tipo := Trim(pTipo);
      Apedit.ShowLog('Inicio varoaeos do parametro');
    end;    

    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.f_int('nped') > 0) and (not vItem.str_empty('tipo_ped')) then
      begin
        Apedit := AlistPed.GetAuxPed(vItem.f_int('nped'), vItem.f_str('tipo_ped'));
        if not Assigned(Apedit) then
        begin
          Apedit := AlistPed.New;
          Apedit.nped := vItem.f_int('nped');
          Apedit.tipo := vItem.f_str('tipo_ped');
          Apedit.ShowLog('Novo item while');
        end;
      end;
      vItem.dataSet.Next;
    end;

    for I := 0 to Pred(AlistPed.Count) do
    begin
      Apedit := AlistPed.Items[I];
      Apedit.nf_ac_calctrib := SqlOpen('select NF_AC_CALCTRIB from PEDVENDA' +
                                       ' where nped = %d and tipo = %s and cod_empresa = %s',
                                       [Apedit.nped, QuotedStr(Apedit.tipo),
                                        vDadosIni.codEmpresa]).FieldByName('NF_AC_CALCTRIB').AsString;
      Apedit.ShowLog('For setando valores na variavel');
    end;

    if vAtualizarDespesaNF then
    begin
      vListaAtualizarValorPedVenda := TStringList.Create;
      vListaAtualizarValorPedVenda.Clear;
      vListaAtualizarValorPedVenda.Sorted := True;
      vListaAtualizarValorPedVenda.Sort;
      vListaAtualizarValorPedVenda.Duplicates := dupIgnore;

      vValorTotalDespNF := 0;
      vSomaSemArredondar := 0;

      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        AdoIt := True;
        if (vItem.f_str('tipo_item') = 'P') and
           (not vItem.str_empty('tipo_ped')) and (vItem.f_int('nped') > 0) then
        begin
          Apedit := AlistPed.GetAuxPed(vItem.f_int('nped'), vItem.f_str('tipo_ped'));
          if Assigned(Apedit) then
          begin
            AdoIt := Trim(Apedit.nf_ac_calctrib) = '';
            Apedit.ShowLog('while de soma');
          end;
        end;

        if AdoIt then        
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') and
          (vItem.dataSet.FieldByName('nitem_ped').AsInteger > 0) and
          ((vItem.dataSet.FieldByName('tipo_item').AsString = 'P') or
          (vItem.dataSet.FieldByName('tipo_item').AsString = 'S')) then
        begin
          vTemp :=
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat +
            vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat +
            vItem.dataSet.FieldByName('valor_ii').AsFloat;
          //if (dataSet.FieldByName('FRETECONTA_TR').AsString = '2') then
          if frete_somar_desp_req then
            vTemp := vTemp +
              vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat;

          vSomaSemArredondar := vSomaSemArredondar + vTemp;

          vValorTotalDespNF := vValorTotalDespNF + vDadosIni.StrToFloatFormat(vTemp, 2);
        end;
        vItem.dataSet.Next;
      end;

      if vDadosIni.StrToFloatFormat(vValorTotalDespNF, 2) <> vDadosIni.StrToFloatFormat(vSomaSemArredondar, 2) then
        vSomaSemArredondar := vDadosIni.StrToFloatFormat(vSomaSemArredondar, 2) - vDadosIni.StrToFloatFormat(vValorTotalDespNF, 2)
      else
        vSomaSemArredondar := 0;

      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        AdoIt := True;
        if (vItem.f_str('tipo_item') = 'P') and
           (not vItem.str_empty('tipo_ped')) and (vItem.f_int('nped') > 0) then
        begin
          Apedit := AlistPed.GetAuxPed(vItem.f_int('nped'), vItem.f_str('tipo_ped'));
          if Assigned(Apedit) then
          begin
            AdoIt := Trim(Apedit.nf_ac_calctrib) = '';
            Apedit.ShowLog('while de update');
          end;
        end;

        if AdoIt then        
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') and
          (vItem.dataSet.FieldByName('nitem_ped').AsInteger > 0) and
          ((vItem.dataSet.FieldByName('tipo_item').AsString = 'P') or
          (vItem.dataSet.FieldByName('tipo_item').AsString = 'S')) then
        begin
          buscas.Close;

          if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
            buscas.SQL.Text := 'update pedvenda_prod pvp' +
              ' set pvp.rateio_acresc = coalesce(pvp.rateio_acresc, 0) + :vl_desp_nf - coalesce(pvp.vl_desp_nf,0)' +
              ', pvp.vl_desp_nf = :vl_desp_nf' +
              ' where pvp.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
              ' and pvp.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
              ' and pvp.grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
              ' and pvp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
              ' and pvp.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
              ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa
          else if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
            buscas.SQL.Text := 'update pedvenda_serv pvs' +
              ' set pvs.rateio_acresc = coalesce(pvs.rateio_acresc, 0) + :vl_desp_nf - coalesce(pvs.vl_desp_nf,0)' +
              ', pvs.vl_desp_nf = :vl_desp_nf' +
              ' where pvs.nped = ' + vItem.dataSet.FieldByName('nped').AsString +
              ' and pvs.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
              ' and pvs.cod_servico = ' + vItem.dataSet.FieldByName('cod_servico').AsString +
              ' and pvs.nitem = ' + vItem.dataSet.FieldByName('nitem_ped').AsString +
              ' and pvs.cod_empresa = ' + vDadosIni.codEmpresa;

          buscas.ParamByName('vl_desp_nf').AsFloat :=
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat +
            vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat +
            vItem.dataSet.FieldByName('valor_ii').AsFloat;
          //if (dataSet.FieldByName('FRETECONTA_TR').AsString = '2') then
          if frete_somar_desp_req then
            buscas.ParamByName('vl_desp_nf').AsFloat :=
              buscas.ParamByName('vl_desp_nf').AsFloat +
              vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat;
          if ((vDadosIni.StrToFloatFormat(vSomaSemArredondar, 2) > 0) and (buscas.ParamByName('vl_desp_nf').AsFloat > 0))
            or
            ((vDadosIni.StrToFloatFormat(vSomaSemArredondar, 2) < 0) and
            (vDadosIni.StrToFloatFormat(buscas.ParamByName('vl_desp_nf').AsFloat, 2) >=
            Abs(vDadosIni.StrToFloatFormat(vSomaSemArredondar, 2))) ) then
          begin
            buscas.ParamByName('vl_desp_nf').AsFloat := buscas.ParamByName('vl_desp_nf').AsFloat + vSomaSemArredondar;
            vSomaSemArredondar := 0;
          end;

          buscas.ParamByName('vl_desp_nf').AsFloat := vDadosIni.StrToFloatFormat(buscas.ParamByName('vl_desp_nf').AsFloat, 2);
          vListaAtualizarValorPedVenda.Add(
            Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) + '|' +
            IntToStr(vItem.dataSet.FieldByName('nped').AsInteger) + '|'
          );
          buscas.ExecSQL;

        end;
        vItem.dataSet.Next;
      end;
    end;

    AdoIt := True;
    if (vRemoverDespesaNF) and (Trim(pTipo) <> '') and (pNPed > 0) then
    begin
      Apedit := AlistPed.GetAuxPed(pNPed, Trim(pTipo));
      if Assigned(Apedit) then
      begin
        AdoIt := Trim(Apedit.nf_ac_calctrib) = '';
        Apedit.ShowLog('Final teste de remover despesa update');
      end;
    end;

    if AdoIt then
    if vRemoverDespesaNF then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select ''P'' tipo, sum( coalesce(vl_desp_nf, 0) ) soma from pedvenda_prod' +
        ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''' +
        ' union' +
        ' select ''S'' tipo, sum( coalesce(vl_desp_nf, 0) ) soma from pedvenda_serv' +
        ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''';
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
      buscas.ParamByName('TIPO').AsString := pTipo;
      buscas.ParamByName('NPED').AsInteger := pNPed;
      buscas.Open;

      vAlt := '';
      buscas.First;
      while not buscas.Eof do
      begin
        if buscas.FieldByName('soma').AsFloat > 0 then
          vAlt := vAlt + '|' + buscas.FieldByName('tipo').AsString + '|';
        buscas.Next;
      end;

      if pos('|P|', vAlt) > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_prod set rateio_acresc = coalesce(rateio_acresc, 0) - coalesce(vl_desp_nf, 0), vl_desp_nf = 0' +
          ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''' +
          ' and coalesce(vl_desp_nf, 0) > 0';
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
        buscas.ParamByName('TIPO').AsString := pTipo;
        buscas.ParamByName('NPED').AsInteger := pNPed;
        buscas.ExecSQL;
      end;

      if pos('|S|', vAlt) > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_serv set rateio_acresc = coalesce(rateio_acresc, 0) - coalesce(vl_desp_nf, 0), vl_desp_nf = 0' +
          ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped and coalesce(status,'''') <> ''CANCELADO''' +
          ' and coalesce(vl_desp_nf, 0) > 0';
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToIntDef(vDadosIni.codEmpresa, 0);
        buscas.ParamByName('TIPO').AsString := pTipo;
        buscas.ParamByName('NPED').AsInteger := pNPed;
        buscas.ExecSQL;
      end;

      if (pos('|P|', vAlt) = 0) and (pos('|S|', vAlt) = 0) then
        Exit;
    end;

    if vAtualizarDespesaNF and vAtualizarTotalVenda then
    begin
      for I := 0 to vListaAtualizarValorPedVenda.Count - 1 do
        _atualizaTotalPedvenda(
          vDadosIni.getCampoPipe(vListaAtualizarValorPedVenda[i], 1),
          StrToIntDef(vDadosIni.getCampoPipe(vListaAtualizarValorPedVenda[i], 2), 0));
    end
    else if vAtualizarTotalVenda then
      _atualizaTotalPedvenda(pTipo, pNPed);

    Result := True;
  except
    on E: Exception do
    begin
      Result := False;
      registraErro('function TNFCab.atualizaValorTotalPedVenda. Erro: ' + e.Message + ' SQL: ' + buscas.SQL.Text + ' Tipo: ' + pTipo + ' NPed: ' + IntToStr(pNPed));
      Application.MessageBox(PCHar('Erro ao tentar alterar dados na venda de origem: ' + pTipo + ' número: ' + IntToStr(pNPed) +
        '. Erro: ' + e.Message), 'Erro', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TNFCab.EntrarComEstoque: boolean;
var
  vmedgc, vmedgr: Currency;
  vetant: Double;
  buscas2: TIBQuery;
  alterarMarkupMargem: Boolean;
  I: Integer;
begin
  Result := False;
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  alterarMarkupMargem := vDadosIni.PesqPros('NF0227', 'HABILITAR', 'NUM NF ' + fstr('num_nf'), 'NOTAFISCAL', fstr('cod_nf'), buscas2, True, False, True);

  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
        try
          vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
            vItem.dataSet.FieldByName('cod_prod').AsString);
          vetant := vItem.vProd.dataSet.FieldByName('EST_F').AsFloat {+
            vItem.vProd.dataSet.FieldByName('EST_R').AsFloat};
          //Colocando o campo est_f = 0  se o memsmo for nulo, para poder somar o estoque atual com a entrada
          buscas.Close;
          buscas.Sql.Text := 'update produtos set est_f = 0 where' +
            ' grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and est_f is null';
          buscas.Prepare;
          buscas.ExecSql;
          //Colocando o campo est_r = 0  se o memsmo for nulo, para poder somar o estoque atual com a entrada
          buscas.Close;
          buscas.Sql.Text := 'update produtos set est_r = 0 where' +
            ' grupo_prod = ' + vItem.dataSet.FieldByName('grupo_prod').AsString +
            ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and est_r is null';
          buscas.Prepare;
          buscas.ExecSql;  

          if (Trim(vItem.dataSet.FieldByName('ncm').AsString) <> '') then
          begin
            if not ExecutaComandosSql('select cod_ncm from nbm where cod_ncm = ' +
              QuotedStr(Trim(vItem.dataSet.FieldByName('ncm').AsString))) then
            begin
              ExecutaComandosSqlExec('insert into nbm (cod_ncm, NOME_ncm, referencia) values (' +
                QuotedStr(Trim(vItem.dataSet.FieldByName('ncm').AsString)) + ', ''CADASTRO NF'',' +
                QuotedStr(Trim(vItem.dataSet.FieldByName('referencia').AsString)) + ')');
            end;
          end;

          if (Trim(vItem.vProd.dataSet.FieldByName('nbm').AsString) = '') and
            (Trim(vItem.dataSet.FieldByName('ncm').AsString) <> '') then
          begin
            buscas2.Close;
            buscas2.SQL.Text := ' select * from nbm ' +
             ' where cod_ncm like ' + QuotedStr(trim(vItem.dataSet.FieldByName('ncm').AsString) + '%');
            buscas2.Open;

            if not buscas2.IsEmpty then
            begin
              buscas.Close;
              buscas.Sql.Text := ' update produtos set rep_int_active = 1, nbm = :nbm, cst_pis_ent = :cst_pis_ent, ' +
                ' cst_cofins_ent = :cst_cofins_ent, cst_pis = :cst_pis, cst_cofins = :cst_cofins, ' +
                ' nat_rec = :nat_rec, aliq_pis_diferenciada = :aliq_pis_diferenciada, aliq_cred_pis = :aliq_cred_pis, ' +
                ' aliq_cofins_diferenciada = :aliq_cofins_diferenciada, aliq_cred_cofins = :aliq_cred_cofins ' +
//                ' icm_prod = :icm_prod ' +
                ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod and cod_empresa = :cod_empresa ' +
                ' and (nbm is null or nbm = '''')';
              buscas.ParamByName('GRUPO_PROD').AsInteger := vItem.dataSet.FieldByName('grupo_prod').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vItem.dataSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
              buscas.ParamByName('NBM').AsString := trim(vItem.dataSet.FieldByName('NCM').AsString);
              buscas.ParamByName('CST_PIS_ENT').AsString := buscas2.FieldByName('CST_PIS_ENT').AsString;
              buscas.ParamByName('CST_COFINS_ENT').AsString := buscas2.FieldByName('CST_COFINS_ENT').AsString;
              buscas.ParamByName('CST_PIS').AsString := buscas2.FieldByName('CST_PIS').AsString;
              buscas.ParamByName('CST_COFINS').AsString := buscas2.FieldByName('CST_COFINS').AsString;
              buscas.ParamByName('NAT_REC').AsString := buscas2.FieldByName('NAT_REC').AsString;
              buscas.ParamByName('ALIQ_PIS_DIFERENCIADA').AsFloat := buscas2.FieldByName('ALIQ_PIS_DIFERENCIADA').AsFloat;
              buscas.ParamByName('ALIQ_CRED_PIS').AsFloat := buscas2.FieldByName('ALIQ_CRED_PIS').AsFloat;
              buscas.ParamByName('ALIQ_COFINS_DIFERENCIADA').AsFloat := buscas2.FieldByName('ALIQ_COFINS_DIFERENCIADA').AsFloat;
              buscas.ParamByName('ALIQ_CRED_COFINS').AsFloat := buscas2.FieldByName('ALIQ_CRED_COFINS').AsFloat;
//              buscas.ParamByName('ICM_PROD').AsString := buscas2.FieldByName('ALIQ_INTRA').AsString;
              buscas.Prepare;
              buscas.ExecSql;
            end;
            buscas2.Close;
          end;

          //Montando o update na buscas
          buscas.SQL.Text := 'update produtos set rep_int_active = 1, ';
          if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N' then
          begin
//            if vItem.dataSet.FieldByName('camp_entest').AsString = 'D' then
//              buscas.SQL.Add(' est_r = est_r + :estoque,')
//            else
//              buscas.SQL.Add(' est_f = est_f + :estoque,');
            if vItem.dataSet.FieldByName('mnf').AsString = 'S' then
              buscas.SQL.Add(' estm = estm + :estoque,');
            buscas.SQL.Add(' estc = estc + :estoque,');
            if (vItem.dataSet.FieldByName('nfe_indescala').AsString = 'N') and
               (vItem.dataSet.FieldByName('nfe_cnpjfab').AsString <> '') then
              buscas.SQL.Add(' nfe_indescala = :nfe_indescala,' +
                             ' nfe_cnpjfab = :nfe_cnpjfab,');
          end;

          if vItem.dataSet.FieldByName('altera_custo_cfop').AsString <> 'N' then
          begin
            buscas.SQL.Add(' prec_cusm_prod = :prec_cusm_prod,' +
              ' prec_cus_prod = :prec_cus_prod,');
            //if (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '1')
            //  or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '6') or
            //  (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '3')
            //  or (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '7') then
            //else
            if (vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0) or
              (vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat > 0) or
              (vItem.ffloat('icm_vicmst') > 0) or
              (vItem.ffloat('icm_vicmsstret') > 0) then
            begin
              buscas.SQL.Add(' icmant_sub = :icmant_sub,' +
                ' baseicmant_sub = :baseicmant_sub,' +
                ' ant_pst = :ant_pst,' +
                ' ant_vicmssubstituto = :ant_vicmssubstituto,');
            end;
            if (vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat > 0) or
              (vItem.ffloat('icm_vfcpst') > 0) or
              (vItem.ffloat('icm_vfcpstret') > 0) then
              buscas.SQL.Add(' fcp_vbcfcpstret = :fcp_vbcfcpstret,' +
                             ' fcp_pfcpstret = :fcp_pfcpstret,' +
                             ' fcp_vfcpstret = :fcp_vfcpstret,');

            if (vitem.ffloat('vicmsmonoreten') > 0) or (vitem.ffloat('vicmsmonoret') > 0) then
            begin
              buscas.SQL.Add(' adremicmsret = :adremicmsret,');
              buscas.SQL.Add(' vicmsmonoret = :vicmsmonoret,');
            end;

            if vDadosIni.vEmp.vAltCustRep <> 'N' then
              buscas.SQL.Add(' prec_rep_prod = :prec_rep_prod,');
            //Multiplicador
            buscas.SQL.Add(' prec_cusr_prod = :prec_cusr_prod,');
            buscas.SQL.Add(' PREC_CUSMR_PROD = :PREC_CUSMR_PROD,');

            if (vetant <= 0) or ( (vetant +
              vItem.dataSet.FieldByName('QUANTIDADE').AsFloat) <= 0) then
            begin
              vmedgc := vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat;
              vmedgr := vItem.dataSet.FieldByName('PREC_CUS_R').AsFloat;
            end
            else
            begin
              if (vItem.vProd.dataSet.FieldByName('PREC_CUSMR_PROD').AsFloat <= 0) then
                vmedgr := vItem.dataSet.FieldByName('PREC_CUS_R').AsFloat
              else
                vmedgr := (((vItem.vProd.dataSet.FieldByName('PREC_CUSMR_PROD').AsFloat * vetant) +
                  (vItem.dataSet.FieldByName('PREC_CUS_R').AsFloat *
                  vItem.QtdeCalcCusto)) /
                  (vetant + vItem.dataSet.FieldByName('quantidade').AsFloat));

              if (vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat <= 0) then
                vmedgc := vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat
              else
                vmedgc := (((vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat * vetant) +
                  (vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat *
                  vItem.QtdeCalcCusto)) / (vetant +
                  vItem.dataSet.FieldByName('quantidade').AsFloat));
            end;

            if (vItem.dataSet.FieldByName('mnf').AsString = 'S') then
            begin
              buscas.SQL.Add(' prec_cus_mnf = :prec_cus_mnf,');
              if (vItem.dataSet.FieldByName('VL_MULTP').AsFloat > 0) then
                buscas.SQL.Add(' prec_cusr_mnf = :prec_cusr_mnf,');
            end;
            
            if vItem.ffloat('quantidade') > 0 then
            begin
            buscas.SQL.Add(' data_ult_compra = :data_ult_compra,' +
              ' vl_ult_compra = :vl_ult_compra,' +
              ' perc_frete_prod = :perc_frete_prod,' +
              ' num_nf_rec = :num_nf_rec,');
            buscas.SQL.Add(' icms_recomposicao = :icms_recomposicao,');
            end;
          end;

          if vItem.dataSet.FieldByName('altera_custo_cfop').AsString <> 'N' then
          begin

          if ((vItem.dataSet.FieldByName('prctb_item').AsFloat > 0) and
            (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat > 0)) or
            ((vDadosIni.vEmp.vUsarAltPrecoNFDigItem = 'S') and
            (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat > 0)) then
            begin
            buscas.SQL.Add(' prec_tab_prod = :prec_tab_prod,');
              if alterarMarkupMargem and (vItem.ffloat('prctb_item') > 0) then
                buscas.SQL.Add(' perc_tb_prod = :perc_tb_prod,');
            end;
          if vItem.dataSet.FieldByName('prec_30_prod').AsFloat > 0 then
            begin
            buscas.SQL.Add(' prec_30_prod = :prec_30_prod,');
              if alterarMarkupMargem and (vItem.ffloat('prctb_item3') > 0) then
                buscas.SQL.Add(' perc_tb_prod3 = :perc_tb_prod3,');
            end;
          if vItem.dataSet.FieldByName('prec_60_prod').AsFloat > 0 then
            begin
            buscas.SQL.Add(' prec_60_prod = :prec_60_prod,');
              if alterarMarkupMargem and (vItem.ffloat('prctb_item6') > 0) then
                buscas.SQL.Add(' perc_tb_prod6 = :perc_tb_prod6,');
            end;
          if vItem.dataSet.FieldByName('prec_90_prod').AsFloat > 0 then
            begin
            buscas.SQL.Add(' prec_90_prod = :prec_90_prod,');
              if alterarMarkupMargem and (vItem.ffloat('prctb_item9') > 0) then
                buscas.SQL.Add(' perc_tb_prod9 = :perc_tb_prod9,');
            end;
          if ((vItem.dataSet.FieldByName('prctb_itema').AsFloat > 0) and
            (vItem.dataSet.FieldByName('prec_vnd_proda').AsFloat > 0)) or
            ((vDadosIni.vEmp.vUsarAltPrecoNFDigItem = 'S') and
            (vItem.dataSet.FieldByName('prec_vnd_proda').AsFloat > 0)) then
            begin
