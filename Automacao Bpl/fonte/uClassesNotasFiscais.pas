function TNFCab.abreFormBaixaPedidosDeCompra: Boolean;
var
  formulario: TfrmPadrao;
  controlsDisabled: Boolean;
begin
  Result := True;
  if (dataSet.FieldByName('natureza_nf').AsString <> 'E') or
    (dataSet.FieldByName('tipo_nf').AsString <> 'P') then
    Exit;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Baixa de Pedidos de Compra';
    frmCadNF.pnBaixaItensPedidos.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    try
      vItem.dataSet.Filter := 'ALTERA_ESTOQUE_CFOP <> ''N''';
      vItem.dataSet.Filtered := True;
      vBaixaPedidos.montarDataSet(vItem);
      vItem.dataSet.AfterScroll := vBaixaPedidos.AfterScrollItens;
      if vBaixaPedidos.dataSet.IsEmpty then
      begin
        Result := True;
        Exit;
      end;
      vItem.dataSet.First;
      controlsDisabled := vItem.dataSet.ControlsDisabled;
      vItem.dataSet.EnableControls;
      result := (formulario.ShowModal = mrOk);
    finally
      vItem.dataSet.AfterScroll := vItem.AfterItemNf;
      vItem.dataSet.Filtered := False;
      vItem.dataSet.Filter := '';
      if controlsDisabled then
        vItem.dataSet.DisableControls;
    end;
  finally
    frmCadNF.pnBaixaItensPedidos.Parent := frmCadNF.tsBaixaItensPedidos;
    formulario.Free;
    formulario := nil;
  end;
end;

function TNFCab.abreFormDadosAdicionaisDespesa: boolean;
var
  formulario: TfrmPadrao;
begin
  if ((dataSet.FieldByName('modelo_nf').AsString) <> '6') and
    ((dataSet.FieldByName('modelo_nf').AsString) <> '06') and
    ((dataSet.FieldByName('modelo_nf').AsString) <> '21') and
    ((dataSet.FieldByName('modelo_nf').AsString) <> '22') and
    ((dataSet.FieldByName('modelo_nf').AsString) <> '28') and
    ((dataSet.FieldByName('modelo_nf').AsString) <> '29') then
      exit;
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption :=
      'Dados Adicionais da Nota Fiscal de Consumo';
    frmCadNF.pnDadosAdConsumo.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    frmCadNF.dbComboAgua.Visible := False;
    frmCadNF.dbComboConsumo.Visible := False;
    frmCadNF.dbComboAgua.Enabled := False;
    frmCadNF.dbComboConsumo.Enabled := False;
    frmCadNF.DBEdit229.Enabled := False;
    if ((dataSet.FieldByName('modelo_nf').AsString) = '6') or
      ((dataSet.FieldByName('modelo_nf').AsString) = '06') or
      ((dataSet.FieldByName('modelo_nf').AsString) = '28') or
      ((dataSet.FieldByName('modelo_nf').AsString) = '29') then
    begin
      frmCadNF.dbComboAgua.Enabled := True;
      frmCadNF.dbComboConsumo.Enabled := True;
    end;
    if ((dataSet.FieldByName('modelo_nf').AsString) = '29') then
      frmCadNF.dbComboAgua.Visible := True
    else
      frmCadNF.dbComboConsumo.Visible := True;

    if ((dataSet.FieldByName('modelo_nf').AsString <> '21') and
      (dataSet.FieldByName('modelo_nf').AsString <> '22') ) then
    begin
      dataSet.FieldByName('vl_forn').AsFloat :=
        dataSet.FieldByName('valor_prod').AsFloat;
      if dataSet.FieldByName('valor_prod').AsFloat >
        dataSet.FieldByName('base_icm').AsFloat then
        dataSet.FieldByName('vl_serv_nt').AsFloat :=
          dataSet.FieldByName('valor_prod').AsFloat -
            dataSet.FieldByName('base_icm').AsFloat;
            
      frmCadNF.DBEdit229.Enabled := True;
    end;

    result := (formulario.ShowModal = mrOk);
  finally
    frmCadNF.pnDadosAdConsumo.Parent := frmCadNF.tsDadosAdConsumo;
    formulario.Free;
    formulario := nil;
  end;
end;

function TNFCab.abreFormDadosStCobradaAntecipada(pConsulta: Boolean = False): boolean;
var
  formulario: TfrmPadrao;
  vAnt:TClientDataSet;
  vValorICMSAnt, vBaseICMSAnt: Currency;
  I, idCodObsICMS, idCodObsOutros: Integer;
  temAntecipacao, temOutrosAjustes, controlsDisabled: Boolean;
begin
  Result := True;

  try
    controlsDisabled := vItem.dataSet.ControlsDisabled;
    temAntecipacao   := vItem.filterStr('antec_trib = ''S''').fsum('valor_icmsub_ant', False) > 0;
    temOutrosAjustes := vItem.filterStr('antec_trib <> ''S'' and trib_sefaz_id <> ''''').fsum('vajuste', False) > 0;

  finally
    vItem.filterClear;
  end;

  //if dataSet.FieldByName('ANTEC_TRIB').AsString = 'S' then
  if temAntecipacao or temOutrosAjustes then  
  begin
    vAnt := TClientDataSet(dtmNF.cdsStAnt);
    if vAnt.Tag = 0 then
    begin
      vAnt.CreateDataSet;
      vAnt.Tag := 1;
    end;
    vAnt.EmptyDataSet;
    vItem.dataSet.First;
    vValorICMSAnt := 0;
    vBaseICMSAnt := 0;
    while not vItem.dataSet.Eof do
    begin
      //if vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat > 0 then
      if (vItem.ffloat('valor_icmsub_ant') > 0) or (vItem.ffloat('vajuste')> 0) then
      begin
        vAnt.Insert;
        for I := 0 to vAnt.Fields.Count - 1 do
          vAnt.FieldByName(vAnt.Fields[i].FieldName).Value := vItem.dataSet.FieldByName(vAnt.Fields[i].FieldName).Value;
        vAnt.FieldByName('BASE_ICMSUB_ANT').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('BASE_ICMSUB_ANT').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat,2);
        vAnt.FieldByName('valor_icmsub_ant').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat,2);
        vValorICMSAnt := vValorICMSAnt + vAnt.FieldByName('valor_icmsub_ant').AsFloat;
        vBaseICMSAnt := vBaseICMSAnt + vAnt.FieldByName('BASE_ICMSUB_ANT').AsFloat;
        vAnt.Post;
      end;

      vItem.dataSet.Next;
    end;
    vAnt.IndexFieldNames := 'NITEM';
    try

      if temOutrosAjustes then
      begin     

        Application.CreateForm(TfrmCadNFLancC195C197, frmCadNFLancC195C197);
        try
          frmCadNFLancC195C197.nota := Self;
          frmCadNFLancC195C197.dsItens.DataSet := vAnt;
          Result := frmCadNFLancC195C197.ShowModal = IDOK;

          if Result then
          begin
            idCodObsICMS   := StrToInt(OnlyNumber(Copy(frmCadNFLancC195C197.edCodAjICMSAnt.Text, 1, Pos('-', frmCadNFLancC195C197.edCodAjICMSAnt.Text))));
            idCodObsOutros := StrToInt(OnlyNumber(Copy(frmCadNFLancC195C197.edCodAjICMSAjust.Text, 1, Pos('-', frmCadNFLancC195C197.edCodAjICMSAjust.Text))));

            Result := vSped.vC195_C197._gerarRegistroAutomatico(vItem, idCodObsICMS, idCodObsOutros,
              frmCadNFLancC195C197.icmsAjustePorItem, frmCadNFLancC195C197.outrosAjustePorItem);
          end;

        finally
          frmCadNFLancC195C197.dsItens.DataSet := nil;
          vItem.filterClear;
          frmCadNFLancC195C197.Free;
          frmCadNFLancC195C197 := nil;
        end;
      end
      else
      begin
        frmCadNF.Panel100.Caption := 'Valor total do ICMS ST calculado: '+Format('%0.2m',[vValorICMSAnt]);
        Result := vDadosIni.abreForm('Dados de ST não destacado na nota fiscal', frmCadNF.pnAtencTrib, [ofAutoSize]);

        if Result then
        begin
          if (frmCadNF.ckEfetuarLancamentoFiscalDocumento.Checked) and (vValorICMSAnt > 0) then
            Result := vSped.vC195_C197._gerarRegistroAutomatico(
              dataSet.FieldByName('cod_nf').AsInteger, 0,
              vDadosIni.StrToFloatFormat(vBaseICMSAnt,2),
              vDadosIni.StrToFloatFormat(vValorICMSAnt,2), 0, 0)
          else if (frmCadNF.ckEfetuarLancamentoFiscalItemDocumento.Checked) and (vValorICMSAnt > 0) then
          begin
            vAnt.First;
            while not vAnt.Eof do
            begin
              Result := vSped.vC195_C197._gerarRegistroAutomatico(
                dataSet.FieldByName('cod_nf').AsInteger,
                vAnt.FieldByName('nitem').AsInteger,
                vDadosIni.StrToFloatFormat(vAnt.FieldByName('base_icmsub_ant').AsFloat,2),
                vDadosIni.StrToFloatFormat(vAnt.FieldByName('valor_icmsub_ant').AsFloat,2), 0, 0);

              if not result then
                Exit;

              vAnt.Next;
            end;
          end
          else if (AsTrueValue(Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_f)) and (vValorICMSAnt > 0) then
          begin
            Application.MessageBox('Lançamento do Valor de ICMS ST antecipado deve ser lançado por Documento ou por Item', 'Atenção', 0 + 64);
            Result := False;
          end;
        end;
      end;

      if (Result) and (pConsulta) then
        CommitaTransacao;
    finally
      if controlsDisabled then
        vItem.dataSet.DisableControls;
//      frmCadNF.pnAtencTrib.Parent := frmCadNF.tsAntecTrib;
//      formulario.Free;
//      formulario := nil;
    end;
  end;
end;

