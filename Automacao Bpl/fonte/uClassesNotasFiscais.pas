      vItem.vDetVeic.dataSet.FieldByName('FRETE_AQUISICAO').AsFloat :=
        vComFat.vItem.dataSet.FieldByName('FRETE_AQUISICAOEST').AsFloat;
      vItem.vDetVeic.dataSet.FieldByName('FRETE_VENDA').AsFloat := 0;
      vItem.vDetVeic.dataSet.FieldByName('OBS_ITEM').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('OBS_ITEMEST').AsString);
      vItem.vDetVeic.dataSet.FieldByName('MOTOR').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('MOTOREST').AsString);
