function TNFCab.criarNotaFiscalDoPedvenda(numVenda: Integer; tipovenda: string): boolean;
var
  vTemp: string;
  vUsarValorNF: Boolean;
  Amensagem: TStrings;
begin
  Result := False;

  if (numVenda > 0) and (MatchText(Trim(tipovenda), ['REQ', 'OS'])) then
    vPedVNf.pesquisaPedVenda(numVenda, Trim(tipovenda))
  else
    vPedVNf.pesquisaPedVenda(FPedVenda, FtipoPedVenda);

  vTemp := '';
  vPedVNf.vItem.dataSet.First;
  while not vPedVNf.vItem.dataSet.Eof do
  begin
    if (vPedVNf.vItem.dataSet.FieldByName('tipo_item').AsString = 'S') or
      (vPedVNf.vItem.dataSet.FieldByName('tipo_item').AsString = 'T') then
      if vTemp = 'P' then
        vTemp := 'A'
      else
        vTemp := 'S';
    if (vPedVNf.vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      if vTemp = 'S' then
        vTemp := 'A'
      else
        vTemp := 'P';
    if vTemp = 'A' then
      Break;
    vPedVNf.vItem.dataSet.Next;
  end;
  try
    if vPedVNf.vItem.dataSet.IsEmpty then
      raiseExceptionCreate('Não foi encontrado itens para a venda informada', '');
    if vTemp = '' then
      raiseExceptionCreate('Tipo de Itens não pode ser definido', '');
    //Mensagem aqui
    //exit;

    //vTemp := 'P';
    if vTemp = 'S' then
      if not vDadosIni.PesqPros('NF0105', 'INCLUIR', '', 'NOTAFISCAL',
        '', buscas, True) then
        Exit;
    if (vDadosIni.vEmp.vNfe.modeloNF = '55') and (vDadosIni.vEmp.vNfe.usarServico = 'S') then
      //and (vTemp = 'A') then
      vTemp := 'A'
    else if (vDadosIni.vEmp.vNfe.modeloNF = '55') and (vDadosIni.vEmp.vNfe.usarServico <> 'S') then
    begin
      vTemp := 'P';
    end
    else if (vDadosIni.vEmp.vNfe.modeloNF = '55') and (vDadosIni.vEmp.vNfe.modeloNFServico = '55') then
    begin
      vTemp := 'P';
    end
    else if (vDadosIni.vEmp.vNfe.modeloNF <> vDadosIni.vEmp.vNfe.modeloNFServico) and
      (vDadosIni.vEmp.vNfe.usarServico <> 'S') and (vTemp = 'A') then
      vTemp := 'P';

    if vTemp = '' then
      raiseExceptionCreate('Tipo de Itens não pode ser definido. P ou S', '');
    //Mensagem aqui
    //exit;

    montaSelect('select * from notafiscal where cod_nf = 0 and cod_empresa = 0');
    vsqlTemp := dataSet.CommandText;

    if not incluirNf( tnfProdutos, vtemp[1], 'S') then
      exit;

    if vPedVNf.dataSet.IsEmpty then
      raise exception.create('Venda Nº ' + IntToStr(FPedVenda) + ' não encontrada');
    if vPedVNf.vItem.dataSet.IsEmpty then
      raise exception.create('Não encontrado itens para a venda Nº ' + IntToStr(FPedVenda));
    vObsOS := False;
    vDadosIni.vInibeMensPesqPros := 'S';
    if not vDadosIni.PesqPros('NF0192', 'HABILITAR', '', 'NOTAFISCAL', '', buscas, True) then
      vUsarValorNF := False
    else
      vUsarValorNF := Application.MessageBox('Usar campo Valor Nf da Venda',
        'Confirmação', MB_ICONQUESTION + MB_YESNOCANCEL + MB_DEFBUTTON2) = IDYES;
    dataSet.FieldByName('TIPO_DESCONTO').AsString := 'I';
    dataSet.FieldByName('TIPO_SEGURO').AsString   := 'R';
    dataSet.FieldByName('TIPO_OUTDESP').AsString  := 'R';
    dataSet.FieldByName('TIPO_FRETE').AsString    := 'R';
    dataSet.FieldByName('TIPO_DESPPF').AsString   := 'R';
    Amensagem := TStringList.Create;
    try
      if not adicionaVendaAnotaFiscal( vUsarValorNF, True, Amensagem) then
        exit;

      if Amensagem.Count > 0 then
      begin
        Amensagem.Insert(0, '');
        Amensagem.Insert(0, 'Existem CF ou NFC-e referenciados. Favor informar nos Dados Adicionais (Interesse do Fisco)');
        Application.MessageBox(PChar(Amensagem.Text), 'Atenção', 64);
      end;
    finally
      FreeAndNil(Amensagem);
    end;
    //    dataSet.FieldByName('nped').AsInteger := vPedVNf.dataSet.FieldByName('nped').AsInteger;
    //    dataSet.FieldByName('tipo_ped').AsString := vPedVNf.dataSet.FieldByName('tipo').AsString;

    verificaDevolucaoDeItensPedVenda;

    Result := True;
  except
    on e: exception do begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('procedure verificaPedVendaIntegracao Erro: ' + e.Message);
    end;
  end;
end;

function TNFCab.verificaProdutosECF: boolean;
var
  controlsDisabled: Boolean;
begin
  Result := True;
  if not vItem.vDetEcf.DataSet.Active then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
  begin
    vItem.vDetEcf.selecionaDetalhesECF(dataSet.FieldByName('cod_nf').AsInteger);
    vItem.vDetEcf.removerItensNotaNaoConfirmada;
  end
  else
  begin
    vItem.vDetEcf.dataSet.First;
    while not vItem.vDetEcf.dataSet.IsEmpty do
      vItem.vDetEcf.dataSet.Delete;
  end;
  controlsDisabled := vItem.dataSet.ControlsDisabled;
  vItem.dataSet.EnableControls;
  vItem.dataSet.Last;
  vItem.dataSet.EnableControls;
  vItem.dataSet.EnableControls;
  vItem.dataSet.EnableControls;
  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if ((vItem.dataSet.FieldByName('ecf').AsString = 'E') or (vItem.dataSet.FieldByName('ecf').AsString = 'O')) and
        (vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N') then
        if dataSet.FieldByName('natureza_nf').AsString = 'S' then
          sairComEstoqueECF
        else
        begin
          if notaFiscalDeRetorno then
            result := retornaComEstoqueECF
          else
            result := entrarComEstoqueECF;
          if not Result then
            exit;
        end;
      vItem.dataSet.Next;
    end;
  finally
    if controlsDisabled then
      vItem.dataSet.DisableControls;
  end;
end;

function TNFCab.VerificarBaixaBensAtivoImobilizado: boolean;
var
  vCodigoEqui: Integer;
  vContador: Integer;
  vContador2: Integer;
begin
  if not vDadosIni.strEstaContidoEm(dataSet.FieldByName('tipo_nf').AsString, ['P', 'O']) then
    Exit;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vDadosIni.strEstaContidoEm(vItem.dataSet.FieldByName('tipo_item').AsString, ['P', 'O']) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select TIPV_VEICULO from nat_op' +
        ' where codigo_nop = :codigo_nop';
      buscas.ParamByName('codigo_nop').AsFloat := vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat;
      buscas.Open;
      if (buscas.FieldByName('TIPV_VEICULO').AsString = 'A') then
      begin

        vContador := 0;

        while vContador < Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) do
        begin

          if vContador >= Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) then
            Break;

          buscas.Close;
          buscas.SQL.Text :=
            'select e.nom_equip "Nome do Bem", e.modelo "Modelo", e.marca "Marca", e.cor "Cor", e.dat_cad_equi "Data Cadastro",' +
            ' e.vlr_equi "Valor", d.nome_depto "Departamento", c.nome_vendedor "Colaborador", e.cod_equip "Codigo" from equipamento e' +
            ' left join depto d on d.cod_depto = e.cod_depart' +
            ' left join colaborador c on c.cod_vendedor = e.cod_prop and c.cod_empresa = e.cod_empresa' +
            ' where e.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and e.tip_equip = ''I'' and coalesce(e.status_v, '''') <> ''V''';
          buscas.Open;

          if buscas.IsEmpty then
            Break
          else
          begin

            Application.MessageBox(pchar('Existe item(s) da nota fiscal com CFOP de saída de Bem no Ativo Imobilizado' + sLineBreak +
              'Será aberto o cadastro de Equipamentos para baixar o(s) item(s)' +sLineBreak+
              'Quantidade já baixada: ' + IntToStr(vContador) + sLineBreak +
              'Quantidade pendente: ' + IntToStr(Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) - vContador))
              , 'Atenção', mb_ok + MB_ICONINFORMATION);

            try
              TFloatField(buscas.FieldByName('valor')).DisplayFormat := DisplayNumber(2);
              if vDadosIni.abreForm('Baixa de Itens do Ativo Imobilizado', frmCadNF.pnDiversos, frmCadNF.tsDiversos) then
              begin
                vCodigoEqui := buscas.FieldByName('codigo').AsInteger;

                buscas.Close;
                buscas.SQL.Text := 'update equipamento' +
                  ' set status_v = ''V'', data_ven = :data_ven, cod_nf_sai = :cod_nf_sai, nitem_sai = :nitem_sai' +
                  ' where COD_EQUIP = ' + IntToStr(vCodigoEqui) +
                  ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
                buscas.ParamByName('data_ven').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
                buscas.ParamByName('COD_NF_SAI').AsInteger := vItem.dataSet.FieldByName('COD_NF').AsInteger;
                buscas.ParamByName('NITEM_SAI').AsInteger := vItem.dataSet.FieldByName('NITEM').AsInteger;
                buscas.ExecSQL;
              end
              else if Application.MessageBox('Deseja cancelar a baixa de itens do Ativo Imobilizado? A nota fiscal não será confirmada',
                'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
                raiseExceptionCreate('Operação cancelada pelo usuário', '');
            finally

            end;

            buscas.Close;
            buscas.SQL.Text := 'select count(COD_NF_SAI) contador from equipamento' +
              ' where COD_NF_SAI = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
              ' and NITEM_SAI = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
              ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
            buscas.Open;

            vContador2 := buscas.FieldByName('contador').AsInteger;
            if vContador = vContador2 then
              if Application.MessageBox(PChar('Deseja cancelar o processo de baixa de itens do Ativo Imobilizado? A nota fiscal não será confirmada!'),
                'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
                raiseExceptionCreate('Processo cancelado pelo usuário', '');

            vContador := buscas.FieldByName('contador').AsInteger;
          end;

        end;
      end;
    end;
    vItem.dataSet.Next;
  end;
end;

function TNFCab.VerificarCadastroBensAtivoImobilizado: boolean;
var
  vEquip: TEquipamentos;
  vContador, vContador2: Integer;
begin
  if not vDadosIni.strEstaContidoEm(dataSet.FieldByName('tipo_nf').AsString, ['P', 'O']) then
    Exit;
  //Verifica os produtos da nota fiscal com CFOP de Compra para o ativo imobilizado
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vDadosIni.strEstaContidoEm(vItem.dataSet.FieldByName('tipo_item').AsString, ['P', 'O']) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select TIPV_VEICULO from nat_op' +
        ' where codigo_nop = :codigo_nop';
      buscas.ParamByName('codigo_nop').AsFloat := vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat;
      buscas.Open;
      if (buscas.FieldByName('TIPV_VEICULO').AsString = 'A') then
      begin

        vContador := 0;

        while vContador < Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) do
        begin

          if vContador >= Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) then
            Break;

          Application.MessageBox(pchar('Existe item(s) da nota fiscal com CFOP de entrada de Bem no Ativo Imobilizado' + sLineBreak +
            'Será aberto o cadastro de Equipamentos para adicionar o(s) item(s)' +sLineBreak+
            'Quantidade já adicionada: ' + IntToStr(vContador) + sLineBreak +
            'Quantidade pendente: ' + IntToStr(Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat) - vContador))
            , 'Atenção', mb_ok + MB_ICONINFORMATION);

          try

            vDadosIni.vEquipamento.COD_NF_ENT := vItem.dataSet.FieldByName('cod_nf').AsInteger;
            vDadosIni.vEquipamento.NITEM_ENT := vItem.dataSet.FieldByName('nitem').AsInteger;
            if vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat = 0 then
              vDadosIni.vEquipamento.VLR_EQUI := ((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
                vItem.dataSet.FieldByName('quantidade').AsFloat) -
                vItem.dataSet.FieldByName('rateio_desconto').AsFloat +
                (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
                vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
                vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
                vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
                vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
                vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +
                vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat +
                vItem.dataSet.FieldByName('valor_ii').AsFloat +
                vItem.dataSet.FieldByName('valor_pis_st').AsFloat +
                vItem.dataSet.FieldByName('valor_cofins_st').AsFloat)
                ) / vItem.dataSet.FieldByName('quantidade').AsFloat
            else
              vDadosIni.vEquipamento.VLR_EQUI := vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat;
            vDadosIni.vEquipamento.NOM_EQUIP := vItem.dataSet.FieldByName('descricao_item').AsString;
            vDadosIni.vEquipamento.TIPEQUIP := 'E';
            vDadosIni.vEquipamento.COD_MARCA := 0;
            vDadosIni.vEquipamento.MARCA := '';

            if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
            begin
              buscas.Close;
              buscas.SQL.Text := 'select cod_marca, marca_p from produtos' +
                ' where grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
                ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
                ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
              buscas.Open;

              vDadosIni.vEquipamento.COD_MARCA := buscas.FieldByName('cod_marca').AsInteger;
              vDadosIni.vEquipamento.MARCA := buscas.FieldByName('marca_p').AsString;
            end
            else
            begin
              vDadosIni.vEquipamento.COD_MARCA := 0;
              vDadosIni.vEquipamento.MARCA := '';
            end;
            vDadosIni.vEquipamento.transacao := TIBTransaction(buscas.Transaction);
            if vDadosIni.mdiAberto('TFrmCadEquipamentos') then
              if Application.MessageBox(PChar('Tela de cadastro de equipamentos aberta. Deseja fechar a tela para continuar?'),
                'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
              begin
                if vDadosIni.mdiAberto('TFrmCadEquipamentos', True) then
                  raiseExceptionCreate('Tela de cadastro de equipamentos aberta, feche-a antes de confirmar a nota fiscal', '');
              end
              else
              raiseExceptionCreate('Tela de cadastro de equipamentos aberta, feche-a antes de confirmar a nota fiscal', '');

            vEquip.CadEquipamentos(1);

          finally
            vDadosIni.vEquipamento.COD_NF_ENT := 0; vDadosIni.vEquipamento.NITEM_ENT := 0; vDadosIni.vEquipamento.VLR_EQUI := 0;
            vDadosIni.vEquipamento.NOM_EQUIP := ''; vDadosIni.vEquipamento.MARCA := ''; vDadosIni.vEquipamento.COD_MARCA := 0;
            vDadosIni.vEquipamento.TIPEQUIP := '';
          end;

          buscas.Close;
          buscas.SQL.Text := 'select count(COD_NF_ENT) contador from equipamento' +
            ' where COD_NF_ENT = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
            ' and NITEM_ENT = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
            ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
          buscas.Open;

          vContador2 := buscas.FieldByName('contador').AsInteger;
          if vContador = vContador2 then
            if Application.MessageBox(PChar('Deseja cancelar o processo de cadastro do Ativo Imobilizado? A nota fiscal não será confirmada!'),
              'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
              raiseExceptionCreate('Processo cancelado pelo usuário', '');

          vContador := buscas.FieldByName('contador').AsInteger;

        end;
        {vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString);
        //Apenas produto cadastrado para comsumo. Pois estes produtos nao entram no inventário
        if vItem.vProd.dataSet.FieldByName('CONSUMO').AsString = 'S' then
        begin
          try
            try
              Application.MessageBox(pchar('Existe item(s) da nota fiscal com CFOP de entrada de Bem no Ativo Imobilizado' + sLineBreak +
                'Será aberto o cadastro de Equipamentos para adicionar o(s) item(s)'), 'Atenção',
                mb_ok +
                MB_ICONINFORMATION);
              vEquip.CadEquipamentos(1);
              exit;
            finally
            end;
          except
            on e: Exception do begin
              Result := false;
              registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
                dataSet.FieldByName('cod_nf').AsString + ' VerificarCadastroBensAtivoImobilizado ' +
                vItem.dataSet.FieldByName('grupo_prod').AsString + ' ' +
                vItem.dataSet.FieldByName('cod_prod').AsString + ' ' + e.Message);
            end;
          end;
        end;
        }
      end;
    end;
    vItem.dataSet.Next;
  end;
end;

procedure TNFCab.verificarCFOPdoCabecalho;
var
  vTempCFOP, vTempCFOPNF: array of integer;
  vTemQtde: array of integer;
  vCont: integer;
  I, j, vCFOPMaiorQtde, vMaiorQtde: Integer;
  vControle, vExisteCFOPdoCabNosItens: boolean;
begin
  if vItem.dataSet.IsEmpty then
    Exit;
  SetLength(vTempCFOPNF, vItem.dataSet.RecordCount);
  vCont := 0;
  vExisteCFOPdoCabNosItens := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vTempCFOPNF[vCont] := Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat);
    Inc(vCont);

    if not vExisteCFOPdoCabNosItens then
      if Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat) = Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat) then
        vExisteCFOPdoCabNosItens := True;
    vItem.dataSet.Next;
  end;

  SetLength(vTempCFOP, vCont);
  SetLength(vTemQtde, vCont);
  for I := 0 to vCont - 1 do
  begin
    vControle := False;
    for j := 0 to vCont - 1 do
    begin
      if vTempCFOP[j] = vTempCFOPNF[i] then
      begin
        vTemQtde[j] := vTemQtde[j] + 1;
        vControle := True;
        Break;
      end
      else
        vControle := False;
    end;
    if not vControle then
      for j := 0 to vCont - 1 do
        if vTempCFOP[j] = 0 then
        begin
          vTempCFOP[j] := vTempCFOPNF[i];
          vTemQtde[j] := 1;
          break;
        end;
  end;
  vCFOPMaiorQtde := Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat);
  vMaiorQtde := 1;
  for I := 0 to vCont - 1 do
    if vTemQtde[i] > vMaiorQtde then
    begin
      vCFOPMaiorQtde := vTempCFOP[i];
      vMaiorQtde := vTemQtde[j];
    end;
  if vItem.dataSet.RecordCount = 1 then
    vCFOPMaiorQtde := Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat);
  if vCFOPMaiorQtde <> Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat) then
  begin
    if vExisteCFOPdoCabNosItens then
      if Application.MessageBox('Deseja alterar o CFOP do cabeçalho conforme o CFOP dos itens?',
        'Atenção', MB_YESNO
        + MB_ICONQUESTION) = ID_NO then
        exit;
    dataSet.FieldByName('codigo_nop').AsFloat := vCFOPMaiorQtde;
    dataSet.FieldByName('desc_natop').AsString := '';
    exitCodigoTabela('NAT_OP');
  end;
end;

function TNFCab.verificaRecibos: boolean;
var
  vNped: integer;
  vTipoPed: string;
  vGerarRecibo: boolean;
  I: Integer;
  vCodDevedor: Integer;
  vNomeDevedor: string;
  Atotal: Double;
  Adups, Avencs, Avals: string;
  Config: TConfig_sistema_class;
  vUtilizarDataVencimento: string;
  vDiasVencimento: string;
  vDataAtual: TDateTime;
begin
  Atotal := 0;
  Adups := '';
  Avencs := '';
  Avals := '';

  try
    FdupNFe.storeRecNo;
    FdupNFe.dataSet.DisableControls;

    FdupNFe.dataSet.First;
    while not FdupNFe.dataSet.Eof do
    begin
      Atotal := Atotal + FdupNFe.dataSet.FieldByName('vdup').AsFloat;
      Adups  := Adups  + FdupNFe.dataSet.FieldByName('ndoc').AsString + ';';
      Avencs := Avencs + FormatDateTime('dd/mm/yyyy', FdupNFe.dataSet.FieldByName('dvenc').AsDateTime) + ';';
      Avals  := Avals  + Format('%f', [FdupNFe.dataSet.FieldByName('vdup').AsFloat]) + ';';
      FdupNFe.dataSet.Next;
    end;
  finally
    FdupNFe.restoreRecNo;
    FdupNFe.dataSet.EnableControls;
  end;
  if Atotal = 0 then
    Exit;

  if ExecutaComandosSql('SELECT NRECIBO FROM RECIBOS WHERE NUM_NF = ' +
    dataSet.FieldByName('NUM_NF').AsString + ' AND SERIE_NF = ' +
    QuotedStr(Trim(dataSet.FieldByName('SERIE').AsString)) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa) then
    exit;
  vNped := 0;
  vTipoPed := '';
  vGerarRecibo := False;
  vItem.dataSet.First;
  if vDadosIni.vEmp.vModoFaturamento = 'S' then
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) <> '') then
          if vNped = 0 then
          begin
            vNped := vItem.dataSet.FieldByName('nped').AsInteger;
            vTipoPed := Trim(vItem.dataSet.FieldByName('tipo_ped').AsString);
          end
          else if (vItem.dataSet.FieldByName('nped').AsInteger <> vNped) or
            (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) <> vTipoPed) then
          begin
            vGerarRecibo := True;
            Break;
          end;
      end;
      vItem.dataSet.Next;
    end;

  if vGerarRecibo then
  begin

    if Application.MessageBox(pchar('Confirma a inclusão de Recibo Antecipado no valor de ' +
      Format('%0.2m', [Atotal])), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDNO
        then
      Exit;

    buscas.close;
    buscas.SQL.Text := 'select cod_cliente, nome_cliente from clientes ' +
    	' where cpfcgc = ' + QuotedStr(vDadosIni.vEmp.vCNPJ) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vCodDevedor := buscas.FieldByName('cod_cliente').AsInteger;
    vNomeDevedor := trim(buscas.FieldByName('nome_cliente').AsString);

    vDataAtual := vDadosIni.getDataBanco(buscas);

    buscas.close;
    buscas.SQL.Text := ' INSERT INTO RECIBOS ' +
      ' (NRECIBO, COD_EMPRESA, VALOR, VALOR_ORIG, REFERENCIA1, REFERENCIA2, REFERENCIA3, REFERENCIA4, ' +
      ' BENEF_CLIENT, NOME_DEV, DATA_REC, RECANT, COD_BENEF, DEPREC, COD_US, COD_DEVEDOR, ' +
      ' NUM_NF, SERIE_NF, NUM_REC_DEP, ATRAVES1, COD_DEPTO, COD_NF, DATA_VENC) ' +
      ' VALUES (:NRECIBO, :COD_EMPRESA, :VALOR, :VALOR_ORIG, :REFERENCIA1, :REFERENCIA2, :REFERENCIA3, :REFERENCIA4, ' +
      ' :BENEF_CLIENT, :NOME_DEV, :DATA_REC, :RECANT, :COD_BENEF, :DEPREC, :COD_US, :COD_DEVEDOR, ' +
      ' :NUM_NF, :SERIE_NF, :NUM_REC_DEP, :ATRAVES1, :COD_DEPTO, :COD_NF, :DATA_VENC); ';
    buscas.ParamByName('NRECIBO').AsInteger := Gencodigo('RECIBOS', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
    if vDadosIni.vRecibo.HabRecPorDepart then
      buscas.ParamByName('NUM_REC_DEP').AsString := trim(retornaNumRec)
    else
      buscas.ParamByName('NUM_REC_DEP').AsInteger := buscas.ParamByName('NRECIBO').AsInteger;
    if vDadosIni.vRecibo.HabRecPorDepart then
	    buscas.ParamByName('COD_DEPTO').AsInteger := retornaCodDepto;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('VALOR').AsFloat := RoundTo(Atotal, -2);
    buscas.ParamByName('VALOR_ORIG').AsFloat := RoundTo(Atotal, -2);
    buscas.ParamByName('REFERENCIA1').AsString := copy(trim('PAGAMENTO REFERENTE A NOTA FISCAL NUMERO ' + dataSet.FieldByName('NUM_NF').AsString), 1, 66);
    buscas.ParamByName('REFERENCIA2').AsString := copy(trim('DUPLICATAS: ' + Adups), 1, 66);
    buscas.ParamByName('REFERENCIA3').AsString := copy(trim('VENCIMENTO: ' + Avencs), 1, 66);
    buscas.ParamByName('REFERENCIA4').AsString := copy(trim('VALOR: ' + Avals), 1, 66);
    buscas.ParamByName('ATRAVES1').AsString := '...';
    buscas.ParamByName('BENEF_CLIENT').AsString := copy(trim(dataSet.FieldByName('NOME_CLIENTE').AsString), 1, 50);
    buscas.ParamByName('NOME_DEV').AsString := copy(vNomeDevedor, 1, 40);
    buscas.ParamByName('DATA_REC').AsDate := FDataDoDia;
    buscas.ParamByName('RECANT').AsString := 'O'; //de Outros
    buscas.ParamByName('COD_BENEF').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
    if vDadosIni.vDpto = 'ESTOQUE' then
      buscas.ParamByName('DEPREC').AsString := 'E'
    else if vDadosIni.vDpto = 'OFICINA' then
      buscas.ParamByName('DEPREC').AsString := 'O'
    else
      buscas.ParamByName('DEPREC').AsString := 'V';
    buscas.ParamByName('COD_US').AsInteger := vDadosIni.vCodUsuario;
    buscas.ParamByName('COD_DEVEDOR').AsInteger := vCodDevedor;
    buscas.ParamByName('NUM_NF').AsInteger := dataSet.FieldByName('NUM_NF').AsInteger;
    buscas.ParamByName('SERIE_NF').AsString := dataSet.FieldByName('SERIE').AsString;
    buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;

    if (vDadosIni.vRecibo.Baixar.vUtilizarDataVencimentoRecAntValeCompra = 'S') and  (trim(vDadosIni.vRecibo.Baixar.vDiasVencimentoRecAntValeCompra) <> '') then
	   	buscas.ParamByName('DATA_VENC').AsDateTime := FDataDoDia + StrToInt(trim(vDadosIni.vRecibo.Baixar.vDiasVencimentoRecAntValeCompra));

    buscas.Prepare;
    buscas.ExecSQL;
  end;
end;

