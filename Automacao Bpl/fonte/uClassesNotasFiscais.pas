function TNFCab.incluirNfComplementar: boolean;
var
  formulario: TfrmPadrao;
  vOK: Boolean;
  vTipoOutrasProdutos: string;
  I: Integer;
  J: Integer;
  vIt2Nf: TClientDataSet;
begin
  Result := False;
  if not vDadosIni.PesqPros('NF0010', 'INCLUIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL', '',
    buscas, True) then
    exit;
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Emissão de NFe Complementar';
    frmCadNF.pnComplementar.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    frmCadNF.edNumNfCompl.AsValue := dataSet.FieldByName('num_nf').AsInteger;
    frmcadnf.edSerieCompl.Text := dataSet.FieldByName('serie').AsString;
    vOK := (formulario.ShowModal = mrOk);
  finally
    frmCadNF.pnComplementar.Parent := frmCadNF.tsComplementar;
    formulario.Free;
    formulario := nil;
  end;
  if vOK then
  begin
    vTipoOutrasProdutos := 'P';
    if frmCadNF.rbCompl4.checked then
      vTipoOutrasProdutos := 'O';
  end
  else exit;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Emissão de NFe Complementar';
