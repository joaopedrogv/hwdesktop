end;

function TNFItem.verificaDescontoNoItem: boolean;
begin
  Result := True;
  if not (dataSet.state in [dsInsert, dsEdit]) then
    Exit;

  try
    if dataSet.FieldByName('valor_unitario').AsFloat <= 0 then
      raise Exception.Create('Valor Unitário deve ser informado.');
    dataSet.FieldByName('valor_total').AsFloat :=
      vDadosIni.StrToFloatFormat(dataSet.FieldByName('quantidade').AsFloat *
      dataSet.FieldByName('valor_unitario').AsFloat, 2);
    if dataSet.FieldByName('perc_desconto').AsFloat >= 100 then
      raise Exception.Create('Desconto maior que o permitido.');
    if dataSet.FieldByName('perc_desconto').AsFloat < 0 then
      dataSet.FieldByName('perc_desconto').AsFloat := 0;
    //dataSet.FieldByName('valor_desconto_perc').AsFloat := 0;
    if dataSet.FieldByName('perc_desconto').AsFloat > 0 then
      dataSet.FieldByName('rateio_desconto').AsFloat :=
        vDadosIni.StrToFloatFormat(//dataSet.FieldByName('valor_desconto_perc').AsFloat := vDadosIni.StrToFloatFormat(
        (dataSet.FieldByName('valor_total').AsFloat * dataSet.FieldByName('perc_desconto').AsFloat /
        100), 2);
  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TNFItem.verificaExistenciaVeiculo: boolean;
begin
 Result := False;        
 if (vDadosIni.vEmp.vVersaoVeiculos = '4') and (dataSet.FieldByName('tipo_item').AsString = 'V') then
 begin
     if (trim(dataSet.FieldByName('TIPV_VEICULO').AsString) <> 'R') then
     begin
        if (dataSet.FieldByName('codigo_nop').AsFloat <= 4000) then
          if ExecutaComandosSql('select codigo from EST_MOTO ' +
           ' where chassi_c = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
           ' and (trim(coalesce(POSICAO, ''VIVO'')) <> ''MORTO'')  ' +
           ' and (trim(coalesce(POSICAO, ''VIVO'')) <> ''TRANSITO'')  ' +
           ' and num_nota > 0 and cod_empresa = ' + vDadosIni.CodEmpresa + ' and ativo = 1 ') then
             raise exception.create('Chassi já existe em estoque (VIVO), Verifique o problema!');
     end;
 end
 else
 begin
   if (dataSet.FieldByName('codigo_nop').AsFloat <> 1913) and
       (dataSet.FieldByName('codigo_nop').AsFloat <> 2913) then
     begin
       if ExecutaComandosSql('select codigo_us from MtUsadas ' +
        ' where chassi_us = ' + QuotedStr(dataSet.FieldByName('chassi').AsString) +
        ' and cod_empresa = ' + vDadosIni.CodEmpresa + ' and ativo = 1 ') then
           raise exception.create('Chassi já existe em estoque de Veículos usados, Verifique o problema!');
     end;
 end;
 Result := True;
end;

function TNFItem.verificaMarcaVeiculoHonda: boolean;
