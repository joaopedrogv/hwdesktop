        vItem.dataSet.AfterScroll:= vItem.AfterItemNfExportacao;
        vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
        vItem.dataSet.First;
        while not vItem.dataSet.Eof do
        begin
          if vItem.vDetExport.dataSet.IsEmpty then
            Break;
          vItem.vDetExport.dataSet.First;
          while not vItem.vDetExport.dataSet.Eof do
          begin
            if vItem.vDetExport.vExpIndireta.dataSet.IsEmpty then
              Break;
            vItem.vDetExport.dataSet.Next;
          end;
          vItem.dataSet.Next;
        end;
        vItem.dataSet.EnableControls;

        vDadosIni.abreForm('Detalhes de Exportação', frmCadNF.pnDadosExportacao, frmCadNF.tsExportacao);

      finally
        vItem.dataSet.AfterScroll:= vItem.AfterItemNf;
        if controlsDisabled then
          vItem.dataSet.DisableControls;

      end;
    end;

    // Coloquei mais acima para fazer parte da transacao logo antes de salvar
    //verificaMensagensDadosAdicionais;

    if Trim(copy(dataSet.FieldByName('TEM_PISCOFINS_ST').AsString,1,1)) <> '' then
      _GravaConfiguracoesString('TEM_PISCOFINS_ST', copy(dataSet.FieldByName('TEM_PISCOFINS_ST').AsString, 1, 1));

    if Trim(copy(dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString,1,1)) <> '' then
      _GravaConfiguracoesString('ADD_PISCOFINS_ST_TOTALNF', copy(dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString, 1, 1));

  except on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      vDadosIni.GravaAuditoria(vProc, vAcao, 'FALHA NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

procedure TNFCab.PostFretePorPeso(payload: TFretePorPesoModel);
var
  query: TQuery_OOP;
  item: TItensFreteModel;
  valorFrete: Double;
begin

  if payload.freteEmDespPF then
    dataSet.FieldByName('tipo_desppf').AsString := 'I'
  else
  begin
    dataSet.FieldByName('tipo_frete').AsString := 'I';

    if ffloat('valor_desp_pf') > 0 then
      if ShowConfirmacao('Frete está sendo salvo no campo correspondente ao frete, porém existe um valor(%f) no campo de Outras Despesas PF' + sLineBreak + sLineBreak +
                         'Deseja remover o valor do campo Outras Despesas PF?', [ffloat('valor_desp_pf')]) = IDYES then
      begin
        dataSet.FieldByName('valor_desp_pf').AsFloat := 0;
        dataSet.FieldByName('tipo_desppf').AsString := 'R';
      end;

    if ffloat('valor_frete') = 0 then
      dataSet.FieldByName('frete_f_nfe').AsString := 'S';
  end;

  valorFrete := 0;
  vItem.prepare_loop();
  try
    while not vItem.dataset.Eof do
    begin
      vItem.dataset.Edit;

      for item in payload.items do
        if vItem.fequals('nitem', item.nitem) and
           vItem.fequals('grupo_prod', item.grupo) and
           vItem.fequals('cod_prod', item.codprod) then
        begin
          if payload.freteEmDespPF then
            vItem.dataSet.FieldByName('rateio_desp_pf').AsFloat := item.frete
          else
            vItem.dataSet.FieldByName('rateio_frete').AsFloat := item.frete;

          valorFrete := valorFrete + item.frete;
        end;

      vItem.dataset.Post;
      vItem.dataSet.Next;
    end;

  finally
    vItem.prepare_loop_done();
  end;

  if payload.freteEmDespPF then
    dataSet.FieldByName('valor_desp_pf').AsFloat := valorFrete
  else
    dataSet.FieldByName('valor_frete').AsFloat := valorFrete;
end;

function TNFCab.preencheDadosNfRetorno: boolean;
var
  I, vCodNf: Integer;
  vCampo: string;
  buscas2: TIBQuery;
begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  if not vDadosIni.PesqPros('NF0045', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    try
      if //(dataSet.fieldbyname('tipo_nf').AsString = 'V') and
      (dataSet.fieldbyname('natureza_nf').AsString = 'E') and
        (notaFiscalDeRetorno) then
      begin
        if (dataSet.fieldbyname('tipo_nf').AsString = 'V') then
        begin
          if Application.MessageBox(pchar('Nota Fiscal de Retorno. Deseja preencher nota automaticamente?' + sLineBreak +
            'Os itens contidos na nota serão removidos para serem incluídos os itens da nota fiscal de retorno'),
            'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
            Exit;
        end
        else if Application.MessageBox('Nota Fiscal de Retorno. Deseja preencher nota automaticamente?',
          'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDNO then
          Exit;
      end
      else
        exit;
      Result := False;
      buscas.Close;
      buscas.sql.Text := 'select * from notafiscal where num_nf = ' +
        IntToStr(dataSet.FieldByName('NUM_NF_EMT').AsInteger) +
        ' and serie = ' + QuotedStr(dataSet.FieldByName('SERIE_EMT').AsString) +
        ' and cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and natureza_nf = ''S'' and cod_nf <> ' +
        IntToStr(dataSet.FieldByName('cod_nf').AsInteger);
      buscas.Open;
      if buscas.IsEmpty then
        raise
          exception.create('Nota fiscal de demonstração não encontrada para o Emitente informado');
      //      if buscas.FieldByName('tipo_nf').AsString <> 'V' then
      //        raise exception.create('Nota fiscal não é nota fiscal de Veículo');
      if Trim(buscas.FieldByName('tipo_nf').AsString) <> Trim(dataSet.FieldByName('tipo_nf').AsString) then
        raise exception.create('Nota fiscal informada não é do mesmo tipo' + sLineBreak +
          'Tipo desta nota fiscal: ' +Trim(dataSet.FieldByName('tipo_nf').AsString) + sLineBreak +
          'Tipo da nota fiscal informada: ' +Trim(buscas.FieldByName('tipo_nf').AsString));
       if (vDadosIni.vEmp.vVersaoVeiculos = '4') then
       begin
         buscas2.Close;
         buscas2.SQL.Text := 'select tipv_veiculo from nat_op ' +
           ' where codigo_nop = :codigo_nop ';
         buscas2.ParamByName('CODIGO_NOP').AsFloat := buscas.FieldByName('CODIGO_NOP').AsFloat;
         buscas2.Open;
         if (buscas2.FieldByName('TIPV_VEICULO').AsString <> 'D') then
          raise exception.create('Nota fiscal não é de Demonstração!');
         buscas2.Close;
       end
       else
       begin
        if (copy(buscas.FieldByName('CODIGO_NOP').AsString, 2, 3) <> '912') and
         (copy(buscas.FieldByName('CODIGO_NOP').AsString, 2, 3) <> '913') then
          raise exception.create('Nota fiscal não é de Demonstração (5912, 5913)');
       end;

      dataSet.FieldByName('cod_cond_pag').AsInteger :=
        buscas.FieldByName('cod_cond_pag').AsInteger;
      dataSet.FieldByName('data_contabil').AsDateTime :=
        buscas.FieldByName('data_lanc').AsDateTime;
      dataSet.FieldByName('valor_total').AsFloat :=
        buscas.FieldByName('valor_total').AsFloat;
      dataSet.FieldByName('valor_prod').AsFloat :=
        buscas.FieldByName('valor_prod').AsFloat;
      dataSet.FieldByName('valor_serv').AsFloat :=
        buscas.FieldByName('valor_serv').AsFloat;
      dataSet.FieldByName('aliq_icm').AsFloat :=
        buscas.FieldByName('aliq_icm').AsFloat;
      dataSet.FieldByName('base_icm').AsFloat :=
        buscas.FieldByName('base_icm').AsFloat;
      dataSet.FieldByName('valor_icm').AsFloat :=
        buscas.FieldByName('valor_icm').AsFloat;
      dataSet.FieldByName('valor_desc').AsFloat :=
        buscas.FieldByName('valor_desc').AsFloat;
      dataSet.FieldByName('valor_desc_p').AsFloat :=
        buscas.FieldByName('valor_desc_p').AsFloat;
      dataSet.FieldByName('valor_desc_s').AsFloat :=
        buscas.FieldByName('valor_desc_s').AsFloat;
      dataSet.FieldByName('aliq_irrf').AsFloat :=
        buscas.FieldByName('aliq_irrf').AsFloat;
      dataSet.FieldByName('base_icmsub').AsFloat :=
        buscas.FieldByName('base_icmsub').AsFloat;
      dataSet.FieldByName('valor_icmsub').AsFloat :=
        buscas.FieldByName('valor_icmsub').AsFloat;
      dataSet.FieldByName('modelo_nf').AsString :=
        buscas.FieldByName('modelo_nf').AsString;
      dataSet.FieldByName('peso_b').AsFloat :=
        buscas.FieldByName('peso_b').AsFloat;
      dataSet.FieldByName('peso_l').AsFloat :=
        buscas.FieldByName('peso_l').AsFloat;

      vCodNf := buscas.FieldByName('cod_nf').AsInteger;

      buscas.Close;
      buscas.SQL.Text := 'select * from notafiscal_item' +
        ' where cod_nf = ' + IntToStr(vCodNf) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      if not buscas.IsEmpty then
      begin

        while not vItem.dataSet.IsEmpty do
          vItem.Delete;
        while not vItem.vDetVeic.dataSet.IsEmpty do
          vItem.vDetVeic.Delete;

        //vItem.CancelUpdates;
        //vItem.vDetVeic.CancelUpdates;
      end;
      while not buscas.Eof do
      begin
        vItem.dataSet.Insert;
        for I := 0 to vItem.dataSet.FieldCount - 1 do
          if vItem.Dataset.Fields[I].FieldKind = fkData then
            if (vItem.dataSet.Fields[i].FieldName <> 'COD_NF') then
              vItem.dataSet.FieldByName(vItem.dataSet.Fields[i].FieldName).Value :=
                buscas.FieldByName(vItem.dataSet.Fields[i].FieldName).Value;
        vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat :=
          dataSet.FieldByName('CODIGO_NOP').AsFloat;
        vItem.dataSet.FieldByName('DESC_NATOP').AsString :=
          dataSet.FieldByName('DESC_NATOP').AsString;
        vItem.dataSet.FieldByName('cod_nf').AsInteger :=
          dataSet.FieldByName('cod_nf').AsInteger;

        if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '0' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '5' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
        else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '5' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '0' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
        else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '4' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '9' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
        else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '9' then
          vItem.dataSet.FieldByName('cst_ipi').AsString := '4' +
            Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1);

        vItem.dataSet.Post;
        buscas.Next;
      end;

      vItem.dataSet.First;
      if (dataSet.fieldbyname('tipo_nf').AsString = 'V') then
        while not vItem.dataSet.Eof do
        begin
          buscas.Close;
          buscas.SQL.Text := 'select * from notafiscal_item_veiculo' +
            ' where cod_nf = ' + IntToStr(vCodNf) +
            ' and nitem = ' + vItem.dataSet.FieldByName('nitem').AsString +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.Open;
          vItem.vDetVeic.dataSet.Insert;
          for I := 0 to vItem.vDetVeic.dataSet.FieldCount - 1 do
            if (vItem.vDetVeic.dataSet.Fields[i].FieldName <> 'COD_NF') then
              vItem.vDetVeic.dataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[i].FieldName).Value
                :=
                buscas.FieldByName(vItem.vDetVeic.dataSet.Fields[i].FieldName).Value;

          vItem.vDetVeic.dataSet.FieldByName('cod_nf').AsInteger :=
            dataSet.FieldByName('cod_nf').AsInteger;
          vItem.vDetVeic.dataSet.Post;
          vItem.dataSet.Next;
        end;
      Result := true;
    except
      on e: exception do begin
        Result := False;
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      end;
    end;
  finally
    buscas.Close;
  end;
end;

