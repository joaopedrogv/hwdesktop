function TNFCab.ArredondaPreco(Preco: Double): Double;
begin
  if (vDadosIni.vEmp.vArredondaPreco <> '') and (Preco <> 0) then
  begin
    if Preco < Round(Preco) then
    begin
      if vDadosIni.vEmp.vArredondaPreco = '0,90' then
        Result := Round(Preco) - 0.10
      else if vDadosIni.vEmp.vArredondaPreco = '0,99' then
        Result := Round(Preco) - 0.1
      else
        Result := Preco;
    end
    else
      Result := Round(Preco) + 0.50;
  end
  else
    Result := Preco;
end;

