procedure TNFCab_FieldValues_Changes.dataSetNFGetText(Sender: TField;
  var Text: string; DisplayText: Boolean);
begin
  if Trim(Sender.AsString) = '' then
    Exit;
  if Sender.FieldName = 'EMISSAO_PROPRIA' then
    Text := IfThen(Sender.AsString = 'S', 'S: Sim', 'N: Nao')
  else if Sender.FieldName = 'CRT' then
    Text := IfThen(Sender.AsString = '1', '1: Simples Nacional') +
            IfThen(Sender.AsString = '2', '2: Simples Nacional, excesso') +
            IfThen(Sender.AsString = '3', '3: Regime Normal')
  else if Sender.FieldName = 'FRETECONTA_TR' then
    Text := IfThen(Sender.AsString = '0', '0: Terceiros') +
            IfThen(Sender.AsString = '1', '1: Emitente') +
            IfThen(Sender.AsString = '2', '2: Destinatário') +
            IfThen(Sender.AsString = '3', '3: Transporte próprio Remetente') +
            IfThen(Sender.AsString = '4', '4: Transporte próprio Destinatário') +
            IfThen(Sender.AsString = '5', '9: Sem frete')
  else if MatchText(Sender.FieldName, ['TIPO_DESCONTO', 'TIPO_SEGURO', 'TIPO_OUTDESP', 'TIPO_FRETE', 'TIPO_DESPPF']) then
    Text := IfThen(Sender.AsString <> 'I', 'R: Rateio', 'I: por Item')
  else if Sender.FieldName = 'TIPO_EMISSAO' then
    Text := IfThen(Sender.AsString = '1', '1: NFe normal') +
            IfThen(Sender.AsString = '2', '2: NFe complementar') +
            IfThen(Sender.AsString = '3', '3: NFe de ajuste') +
            IfThen(Sender.AsString = '4', '4: Devolução de mercadoria')
  else if Sender.FieldName = 'NFE_INDPRES' then
    Text := IfThen(Sender.AsString = '0', '0: Não se aplica') +
            IfThen(Sender.AsString = '1', '1: Operação presencial') +
            IfThen(Sender.AsString = '2', '2: Operação não presencial, pela Internet') +
            IfThen(Sender.AsString = '3', '3: Operação não presencial, Teleatendimento') +
            IfThen(Sender.AsString = '5', '5: Operação presencial, fora do estabelecimento') +
            IfThen(Sender.AsString = '9', '9: Operação não presencial, outros')
  else if Sender.FieldName = 'NFE_IDDEST' then
    Text := IfThen(Sender.AsString = '1', '1: Operação interna') +
            IfThen(Sender.AsString = '2', '2: Operação interestadual') +
            IfThen(Sender.AsString = '3', '3: Operação com exterior')
  else if Sender.FieldName = 'NFE_TPEMIS' then
    Text := IfThen(Sender.AsString = '1', '1: Normal') +
            IfThen(Sender.AsString = '4', '4: EPEC') +
            IfThen(Sender.AsString = '6', '6: SVC-AN') +
            IfThen(Sender.AsString = '7', '7: SVC-RS')
  else if Sender.FieldName = 'NFE_TPAMB' then
    Text := IfThen(Sender.AsString = '1', '1: Produção') +
            IfThen(Sender.AsString = '2', '2: Homologação')
  else if Sender.FieldName = 'TPIMP' then
    Text := Sender.AsString + ' - ' + FormatoImpressaoDANFeEnumStr[FormatoImpressaoDANFeEnum(Sender.AsInteger)]
  else if MatchText(Sender.FieldName, ['OBS', 'DADOS_INTERESSE_FISCO', 'DADOS_LANCAMENTO_FISCAL']) then
    Text := Copy(Sender.AsString, 1, 128);
end;

