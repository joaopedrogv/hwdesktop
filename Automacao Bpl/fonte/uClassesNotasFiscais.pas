procedure TNFItem.HandleCamposUVND_old;
var
  unCalc: TUnidadeVenda_Model;
begin
  if (not fempty('unidade_nf')) then
  begin

    dataSet.FieldByName('uvnd').AsString := fstr('unidade_nf');
    dataSet.FieldByName('qvnd').AsFloat  := ffloat('qtdembrec');
    dataSet.FieldByName('vvnd').AsFloat  := ffloat('vlrembnf');

    if (ffloat('qtdemb') > 0) and (ffloat('qtdembrec') > 0) and (ffloat('vlrembnf') > 0) then
    begin
      unCalc := FUndsVnds.GetUnd(fint('grupo_prod'), fstr('cod_prod'), fstr('uvnd'));
      try
        if (unCalc = nil) then
        begin
          FUndsVnds.CopyFrom(TUnidadeVenda_Model,
            queryCons.Table('vw_produtos_conversao', '*')
             .Equals('grupo_prod', fint('grupo_prod'))
             .Equals('cod_prod', fstr('cod_prod'))
             .Equals('cod_empresa', vDadosIni.cod_empresa)
             .Open().query);
          unCalc := FUndsVnds.GetUnd(fint('grupo_prod'), fstr('cod_prod'), fstr('uvnd'));
        end;

        if unCalc = nil then
        begin
          unCalc := TUnidadeVenda_Model.Create;

          unCalc.unid_princ := fstr('referencia');
          unCalc.unid_vnd   := fstr('uvnd');
          unCalc.fator      := ffloat('qtdemb');
          unCalc.quantidade := 1 / unCalc.fator;
          FUndsVnds.Add(unCalc)
        end;

        dataSet.FieldByName('paridade').AsString := unCalc.paridade;
      finally
        //unCalc.Free;
      end;
    end;

  end
  else if (not fempty('ucom')) and (ffloat('qcom') > 0) and (ffloat('vuncom') > 0) then
  begin
    dataSet.FieldByName('uvnd').AsString     := fstr('ucom');
    dataSet.FieldByName('qvnd').AsFloat      := ffloat('qcom');
    dataSet.FieldByName('vvnd').AsFloat      := ffloat('vuncom');
    dataSet.FieldByName('paridade').AsString := '';
  end
  else
  begin
    dataSet.FieldByName('uvnd').AsString     := fstr('referencia');
    dataSet.FieldByName('qvnd').AsFloat      := ffloat('quantidade');
    dataSet.FieldByName('vvnd').AsFloat      := ffloat('valor_unitario');
    dataSet.FieldByName('paridade').AsString := '';
  end;
end;

