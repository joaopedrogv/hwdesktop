    ' and cod_nf <> ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and modelo_nf = ' + QuotedStr(vModelo) +
    ' and ((status = ' + QuotedStr(stsFechada) + ') or (status = ' + QuotedStr(stsAberta) + ') or (status = ' + QuotedStr(stsPreNota) + ')) and ativo = 1' + vTempSql);
end;

function TNFCab.existeNotaFiscalComplementar(vNum_nf: integer;
  vSerie: string): boolean;
var
  vCodNf: Integer;
  vIt2Nf: TClientDataSet;
begin
  Result := False;
  if vNum_nf = 0 then
    Exit;
  if Trim(vSerie) = '' then
    Exit;

  Result := true;

  buscas.Close;
  buscas.Sql.Text :=
    'select cod_nf, num_nf, serie, modelo_nf, situacao_nfe, tipo_emissao from notafiscal' +
    ' where num_nf = ' + IntToStr(vNum_nf) +
    ' and serie = ' + QuotedStr(vSerie) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and natureza_nf = ''S''' +
    ' and ativo = 1 ';
  try
    buscas.Open;
  except
    raise exception.Create('Não foi possível abrir cadastro de Notas fiscais');
  end;
  try
    try
      if buscas.IsEmpty then
      begin
        Application.ProcessMessages;
        if Application.MessageBox(pchar('Nota Fiscal informada não encontrada para esta NF complementar. Deseja continuar?'),
          'Atenção',MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          Result := True;
          Exit;
        end;
//        raise exception.Create('Nota fiscal informada não encontrada');
      end;
      if buscas.FieldByName('modelo_nf').AsString <> '55' then
        raise exception.Create('Nota fiscal não é do modelo 55');
      if buscas.FieldByName('situacao_nfe').AsString <> sitAutorizada then
        raise exception.Create('Nota fiscal informada não está Autorizada');
      if buscas.FieldByName('tipo_emissao').AsString = '2' then
        raise exception.Create('Nota fiscal informada é uma nota Fiscal Complementar.');
      vCodNf := buscas.FieldByName('cod_nf').AsInteger;
    finally
      buscas.Close;
    end;
    Result := True;
    vIt2Nf := TClientDataSet(dtmNF.cdsIt2Nf);
    vIt2Nf.Close;
    vIt2Nf.CommandText := 'select * from notafiscal_item' +
      ' where cod_nf = ' + IntToStr(vCodNf) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    vIt2Nf.Open;
  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

