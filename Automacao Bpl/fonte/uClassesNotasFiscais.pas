      vItem.vDetVeic.dataSet.FieldByName('NSERIE').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('nserie').AsString);
      vItem.vDetVeic.dataSet.FieldByName('TIP_PINTURA').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('tip_pintura').AsString);
      vItem.vDetVeic.dataSet.FieldByName('COD_COR').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('cod_cor').AsString);
      vItem.vDetVeic.dataSet.FieldByName('COM_ENT').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('com_ent').AsString);
      vItem.vDetVeic.dataSet.FieldByName('SITUACAO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('situacao').AsString);
      vItem.vDetVeic.dataSet.FieldByName('RED_LUCRO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('RED_LUCRO').AsString);
