            vItem.dataSet.FieldByName('indsomapisst').Value := vDadosIni.IfThen(vIt2Nf.FieldByName('indsomapisst').Value = 0, 0, 1);
            vItem.dataSet.FieldByName('indsomacofinsst').Value := vDadosIni.IfThen(vIt2Nf.FieldByName('indsomacofinsst').Value = 0, 0, 1);
            vItem.Post;
            vItem.alterar;
            calcularValores;
            if vItem.Edit then
            begin
              if dataSet.FieldByName('natureza_nf').AsString = 'S' then
              begin
                if vItem.vrDadosItem.cst_ipi = '' then
