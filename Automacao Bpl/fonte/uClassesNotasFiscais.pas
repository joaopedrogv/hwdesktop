function TNFCab.salvaDespesa: boolean;
begin
  try
    Result := false;

    if not (vItem.dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if vItem.dataSet.fieldbyname('quantidade').AsFloat <= 0 then
      raiseExceptionCreate('Quantidade inválida', 'dbedit82');
    if vItem.dataSet.fieldbyname('valor_unitario').AsFloat <= 0 then
      raiseExceptionCreate('Valor unitário deve ser maior que zero', 'dbedit83');
    vItem.dataSet.fieldbyname('valor_total').AsFloat := vDadosIni.StrToFloatFormat(
      vItem.dataSet.fieldbyname('valor_unitario').AsFloat *
      vItem.dataSet.fieldbyname('quantidade').AsFloat, 2);

    if not vItem.fempty('cst') then
    begin
      if not vItem.TestarCST(vItem.fstr('cst')) then
        raiseExceptionCreate('CST de ICMS inválido');
    end
    else
    if (vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('base_icm').AsFloat, 2) >=
      vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('valor_total').AsFloat, 2)) then
      vItem.dataSet.fieldbyname('cst').AsString := '000'
    else if (vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('base_icm').AsFloat, 2) > 0) then
    begin
      vItem.dataSet.fieldbyname('cst').AsString := '020'
    end
    else if (vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('vlisento').AsFloat, 2) > 0) then
      vItem.dataSet.fieldbyname('cst').AsString := '040'
    else if (vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('vln_trib').AsFloat, 2) > 0) then
      vItem.dataSet.fieldbyname('cst').AsString := '041'
    else
      vItem.dataSet.fieldbyname('cst').AsString := '090';

    if vItem.post then
      Result := true; //inherited vItem.post;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.salvarDetalhesFatura(indice: integer;
  cdsDesp: TClientDataSet): boolean;
var
  I, J: Integer;
  vrTemp: Currency;
begin
  try
    vrTemp:=0;
    vDetDesp.First;
    while not vDetDesp.Eof do
    begin
      vrTemp := vrTemp + vDetDesp.FieldByName('Valor').AsFloat;
      vDetDesp.Next;
    end;
    if vDadosIni.StrToFloatFormat(vrTemp, 2) > vDadosIni.StrToFloatFormat(FFatura.valorDocumento[indice],2) then
      raiseExceptionCreate('Valor informado maior que o valor da Duplicata','')
    else if vDadosIni.StrToFloatFormat(vrTemp, 2) < vDadosIni.StrToFloatFormat(FFatura.valorDocumento[indice],2) then
      raiseExceptionCreate('Valor informado menor que o valor da Duplicata','');

    SetLength(FFatura.despesas, FFatura.parcelas);
    for I := 0 to High(FFatura.despesas) do
    begin
      if ((FFatura.despesas[i].indice = indice) and (FFatura.despesas[i].parcelas > 0)) or
        (FFatura.despesas[i].parcelas = 0) then
        begin
          j := 0;
          FFatura.despesas[i].parcelas := vDetDesp.RecordCount;
          FFatura.despesas[i].indice := indice;
          SetLength(FFatura.despesas[i].NumConta, vDetDesp.RecordCount);
          SetLength(FFatura.despesas[i].dataReferencia, vDetDesp.RecordCount);
          SetLength(FFatura.despesas[i].NumDoc, vDetDesp.RecordCount);
          SetLength(FFatura.despesas[i].historico, vDetDesp.RecordCount);
          SetLength(FFatura.despesas[i].valorDocumento, vDetDesp.RecordCount);
          SetLength(FFatura.despesas[i].Controle, vDetDesp.RecordCount);
          vDetDesp.First;
          while not vDetDesp.Eof do
          begin
            FFatura.despesas[i].NumConta[J] := vDetDesp.FieldByName('NumConta').AsFloat;
            FFatura.despesas[i].dataReferencia[J] :=
              vDetDesp.FieldByName('DataReferencia').AsString;
            FFatura.despesas[i].NumDoc[J] :=
              vDetDesp.FieldByName('NumDoc').AsString;
            FFatura.despesas[i].historico[J] := vDetDesp.FieldByName('Historico').AsString;
            FFatura.despesas[i].valorDocumento[J] := vDetDesp.FieldByName('Valor').AsFloat;
            FFatura.despesas[i].Controle[J] := vDetDesp.FieldByName('Controles').AsInteger;
            vDetDesp.Next;
            inc(J);
          end;
          Break;
        end;
    end;
    Result := True;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar('Erro ao salvar Dados do detalhamento da Despesa. Erro: '+e.Message),'Atenção',
      0+64);
    end;
  end;
end;

