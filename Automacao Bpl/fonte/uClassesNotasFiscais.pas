function TNFItem.GetUndVenda: TStrings;
var
  I: Integer;
  undItem: TUnidadeVenda_Model;
begin
  Result := GetUndVendaProd();

  if fempty('unidade_nf') then
    Exit;

  if FSemCodigo and (Result.Count = 0) then
    exit;

  if Result.IndexOf(fstr('unidade_nf')) = -1 then
  begin
    undItem := TUnidadeVenda_Model.Create;
    undItem.CopyFrom(Result.Objects[0] as TUnidadeVenda_Model);
    undItem.unidade := fstr('unidade_nf');
    undItem.unid_vnd := undItem.unidade;
    undItem.quantidade := 0;
    undItem.fator := 0;
    undItem.fator_sped := 0;
    undItem.unid_pref := '';
    Result.AddObject(undItem.unid_vnd, undItem);
  end;

  for I := 0 to Result.Count - 1 do
    if I > 0 then
      if Result[I] = fstr('unidade_nf') then
      begin
        Result.Move(I, 0);
        Break;
      end;
end;

function TNFItem.GetUndVendaProd(refreshData: Boolean): TStrings;
var
  convs, filtro: TUnidadeVendas_Model;
  undFirst: TUnidadeVenda_Model;
//  conv: TUnidadeVenda_Model;
//  I: Integer;
begin
  if (not refreshData)
    and (Assigned(FUndVenda))
    and (FUndVenda.Count > 0)
    and (Assigned(FUndVenda.Objects[0])) then
  begin
    undFirst := (FUndVenda.Objects[0] as TUnidadeVenda_Model);

    if (undFirst.grupo_prod = vrDadosItem.grupo_prod)
      and (undFirst.cod_prod = vrDadosItem.cod_prod) then
    begin
      Result := FUndVenda;
      Exit;
    end;
  end;

  convs := FOwerNF.helperConv.GetListConversao(vrDadosItem.grupo_prod, vrDadosItem.cod_prod);
  filtro := convs.GetList(FOwerNF.fequals('natureza_nf', 'S') and FOwerNF.fequals('tipo_emissao', '1'));
  try
    if Assigned(FUndVenda) then
      FUndVenda.Free;

    FUndVenda := filtro.ListStrings('');

    Result := FUndVenda;

  finally
    convs.Free;
    filtro.Free;
  end;
  {
  queryCons.SQL('select iif(pu.padrao_venda = :disponivel_venda, -1, 1) ind,' +
                ' pu.grupo_prod, pu.cod_prod, pu.cod_empresa, p.unidade unid_princ, pu.unidade unid_vnd, pu.undprefxml unid_pref,' +
                ' iif(substring(pu.operacao from 1 for 1) = ''D'', 1 /  pu.quantidade,pu.quantidade) fator' +
                ' from produtos p' +
                ' inner join vw_produtos_conversao pu on pu.grupo_prod = p.grupo_prod and pu.cod_prod = p.cod_prod and pu.cod_empresa = p.cod_empresa' +
                ' and pu.unidade <> p.unidade and pu.disponivel_venda in (@disponivel_venda@)' +
                ' where p.grupo_prod = :grupo_prod and p.cod_prod = :cod_prod and p.cod_empresa = :cod_empresa' +
                ' union distinct' +
                ' select 0 ind, p.grupo_prod, p.cod_prod, p.cod_empresa, p.unidade unid_princ, p.unidade unid_vnd, null unid_pref, 1 fator from produtos p' +
                ' where p.grupo_prod = :grupo_prod and p.cod_prod = :cod_prod and p.cod_empresa = :cod_empresa' +
                ' order by 1, 4')
    .ParamValue('grupo_prod', vrDadosItem.grupo_prod)
    .ParamValue('cod_prod', vrDadosItem.cod_prod)
    .ParamValue('cod_empresa', vDadosIni.cod_empresa)
    .ParamReplace('@disponivel_venda@', IfThen(FOwerNF.fequals('natureza_nf', 'S') and FOwerNF.fequals('tipo_emissao', '1'), '''S''', '''S'', ''N'''))
    .Open();

  convs := TUnidadeVendas_Model.Create;
  convs.CopyFrom(TUnidadeVenda_Model, queryCons.query, False);

  FUndVenda.Clear;

  for I := 0 to convs.Count - 1 do
    FUndVenda.AddObject(convs.Items[I].unid_vnd, convs.Items[I]);

  Result := FUndVenda;
  }
end;

