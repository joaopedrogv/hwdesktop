              Copy(vItem.vProd.dataSet.FieldByName('APLICACAO_PROD').AsString, 1, 10) + '"');
            WriteLn(Arquivo, 'A' + IntToStr(b + 4) + ',' + IntToStr(j + 120) + ',0,2,1,1,N,"' +
              Copy((vItem.vProd.dataSet.FieldByName('DESCR_PROD').AsString), 1, 18) + '"');
            if Odd(cont) then
            begin
              b := b + 242;
            end
            else
            begin
              j := j + 193;
              b := 5;
            end;
            cont := cont + 1;
            itmax := itmax + 1;
            if itmax = 22 then
            begin
              WriteLn(Arquivo, 'P1');
              WriteLn(Arquivo, 'N');
              //WriteLn(Arquivo, 'Q160,32');
              WriteLn(Arquivo, 'Q165,32');
              WriteLn(Arquivo, 'ON');
              WriteLn(Arquivo, 'q460');
              WriteLn(Arquivo, 'D15');
              WriteLn(Arquivo, 'JF');
              j := 0;
              b := 5;
              cont := 1;
              itmax := 0;
            end;
          end;
          WriteLn(Arquivo, 'P1');
        end;
      end;
      vItem.dataSet.Next;
    end;
  finally
    CloseFile(Arquivo);
  end;
end;

function TNFCab.imprimeNotaFiscal: boolean;
var
  vQtdeProdNf, vQtdeServNf, vQtdeNf, vFolha, I, vLinha, j, vQtdeImpLinhas, vQtdeProdImp,
    vQtdeServImp: Integer;
  vConfigNf: TConfignf;
  vRdpNf: TRDprint;
  vDataSetImp: TClientDataSet;
  //
  vTabela, vEndereco, vCampo, vCampo2, vFormat: string;
  vProdutosFim, vServicosFim: Boolean;
  ponteiroProdutos, ponteiroServicos: TBookmark;
  lista: TMemo;
  vLinhaItens, vOrdemBolNDoc, vOrdemBolVenc, vOrdemBolVal, vOrdemBol: Integer;
  vDesconsiderarTanamho: Boolean;

  procedure imprimeLinha(linha, coluna, condensado: Integer; texto: string);
  var
    vTexto: string;
  begin
    vTexto := texto;
    if (vConfigNf.vCampos.dataSet.FieldByName('tamanho_campo').AsInteger > 0) and (not
      vDesconsiderarTanamho) then
      vTexto := copy(vTexto, 1, vConfigNf.vCampos.dataSet.FieldByName('tamanho_campo').AsInteger);
    if condensado = 1 then
      vRdpNf.Impf(linha, coluna, vTexto, [comp17])
    else
      vRdpNf.Imp(linha, coluna, vTexto);
    vDesconsiderarTanamho := False;
  end;
begin
  if not vDadosIni.PesqPros('NF0020', 'IMPRIMIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  if dataSet.FieldByName('modelo_nf').AsString = '55' then
  begin
    if (get_situacao_nfe = sitDenegada) then
    begin
      Application.MessageBox('Nota Fiscal Denegada', 'Atenção', 64);
      Exit;
    end;
    if GetVersaoNFe = vnf400 then
      Result := dllNFe.nfe_imprimir([get_cod_nf], True, False, '', '')
    else
    begin
      EnviarNFeHW('N', Pchar(vDadosIni.vBancoHW), strtoint(vDadosIni.CodEmpresa), '4.0',
        dataSet.FieldByName('num_nf').AsInteger, 'NOTAFISCAL', '2',
        Pchar(dataSet.FieldByName('SERIE').asstring), PCHAR(vDadosIni.vNomeUsuario));
    end;
    _atualizarSituacaoPedidos('Finalizado', False, True);
    Exit;
  end;
  if Application.MessageBox(pchar('Imprimir Nota Fiscal' + chr(13) +
    'Prepare a Impressora para Impressão'), 'Confirmação',
    MB_YESNO + MB_ICONQUESTION) = IDNO then
    exit;
  vQtdeNf := 1;
  vQtdeProdNf := 0;
  vQtdeServNf := 0;
  vQtdeProdImp := 0;
  vQtdeServImp := 0;
  vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
  ponteiroProdutos := vItem.dataSet.GetBookmark;
  ponteiroServicos := vItem.dataSet.GetBookmark;
  vItem.IndexFieldNames := 'TIPO_ITEM;NITEM';

  //Definindo a quantidade de notas fiscais de acordo a quantidade de itens da nota
  vItem.First;
  while not vItem.dataSet.Eof do
  begin
    if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
      Inc(vQtdeServNf)
    else
      Inc(vQtdeProdNf);
    vItem.dataSet.Next;
  end;
  if (vQtdeProdNf > 0) and (vDadosIni.vEmp.vQtdeProdNf > 0) then
    vQtdeNf := ceil(vQtdeProdNf / vDadosIni.vEmp.vQtdeProdNf);
  if (vQtdeServNf > 0) and (vDadosIni.vEmp.vQtdeServNf > 0) then
    if vQtdeNf < ceil(vQtdeServNf / vDadosIni.vEmp.vQtdeServNf) then
      vQtdeNf := ceil(vQtdeServNf / vDadosIni.vEmp.vQtdeServNf);

  //Verificando os CFOP's existentes nos itens para imprimir na nota fiscal
  verificaCFOP;

  //Criando e abrindo configuraçoes de impressao da nota fiscal
  vConfigNf := TConfignf.create;
  if not vConfigNf.iniciaProcessoImpressaoNF then
  begin
    Application.MessageBox(pchar('Erro no Arquivo de Configuração' + chr(13) +
      'Configurações não Encontradas'), 'Informação',
      MB_YESNO + MB_ICONINFORMATION);
    exit;
  end;

  //Configurando o componente RDPrint para impressao
  vRdpNf := TRDprint(dtmNF.rdNF);
  vRdpNf.TamanhoQteLinhas := vDadosIni.vEmp.vQtdeLinhasNf;
  vRdpNf.TamanhoQteColunas := 80;
  vRdpNf.PortaComunicacao := vConfigNf.vCab.dataSet.FieldByName('PORTA_IMPRESSAO').AsString;
  if vConfigNf.vCab.dataSet.FieldByName('tamanhofonte').AsString = 'S05cpp' then
    //if vDadosIni.vEmp.vTamanhoLetra = 'S05cpp' then
    vRdpNf.FonteTamanhoPadrao := S05cpp;
  if vConfigNf.vCab.dataSet.FieldByName('tamanhofonte').AsString = 'S10cpp' then
    //if vDadosIni.vEmp.vTamanhoLetra = 'S10cpp' then
    vRdpNf.FonteTamanhoPadrao := S10cpp;
  if vConfigNf.vCab.dataSet.FieldByName('tamanhofonte').AsString = 'S12cpp' then
    //if vDadosIni.vEmp.vTamanhoLetra = 'S12cpp' then
    vRdpNf.FonteTamanhoPadrao := S12cpp;
  if vConfigNf.vCab.dataSet.FieldByName('tamanhofonte').AsString = 'S17cpp' then
    //if vDadosIni.vEmp.vTamanhoLetra = 'S17cpp' then
    vRdpNf.FonteTamanhoPadrao := S17cpp;
  if vConfigNf.vCab.dataSet.FieldByName('tamanhofonte').AsString = 'S20cpp' then
    //if vDadosIni.vEmp.vTamanhoLetra = 'S20cpp' then
    vRdpNf.FonteTamanhoPadrao := S20cpp;
  vRdpNf.Abrir;
  // Teste do Entrelinhamento
  if vConfigNf.vCab.dataSet.FieldByName('ENTRELINHAMENTO').AsString = 'Linha 1/8"' then
    vRdpNf.Imp(1, 1, chr(27) + '0')
  else
    if vConfigNf.vCab.dataSet.FieldByName('ENTRELINHAMENTO').AsString = 'Linha 7/72"' then
      vRdpNf.Imp(1, 1, chr(27) + '1')
    else
      if vConfigNf.vCab.dataSet.FieldByName('ENTRELINHAMENTO').AsString = 'Linha 1/6"' then
        vRdpNf.Imp(1, 1, chr(27) + '2')
      else
        if vConfigNf.vCab.dataSet.FieldByName('ENTRELINHAMENTO').AsString = '' then
          vRdpNf.Imp(1, 1, chr(27) + chr(64));

  vClFor.selecionaClFor;
  vTr.selecionaTransportador(dataSet.FieldByName('CODIGO_TR').AsInteger);
  vCPag.abreCondPag(dataSet.FieldByName('COD_COND_PAG').AsInteger);
  vBol := TBoletasNF.create;
//  vBol.selecionaBoletas(dataSet.FieldByName('num_nf').AsInteger,
//    StrToInt(dataSet.FieldByName('serie').AsString));
  vBol.selecionaBoletas(dataSet.FieldByName('cod_nf').AsInteger);
  vCfop.selecionaCfop(Trunc(dataSet.FieldByName('CODIGO_NOP').AsFloat));

  vFolha := 0;
  vProdutosFim := vQtdeProdNf = 0;
  vServicosFim := vQtdeServNf = 0;
  while vFolha <> vQtdeNf do
  begin
    vFolha := vFolha + 1;
    vConfigNf.vCampos.abreCamposNf;
    vConfigNf.vCampos.dataSet.First;
    while not vConfigNf.vCampos.dataSet.Eof do
    begin
      if (vConfigNf.vCampos.dataSet.FieldByName('NORDEM_CAMP').AsString <> '') and
        (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString <> 'FK_NOTAFISCAL_ITEM') and
        (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString <> 'FK_BOLETAS') then
      begin
        //Impressão das Variaveis Fixas da nota fiscal
        if (Copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 1, 1) = '@') then
        begin
          if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = '@HORA' then
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
              TimeToStr(vDadosIni.getDataHoraBanco(buscas)))
          else if (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = '@X NF SAIDA') and
            (dataSet.FieldByName('natureza_nf').AsString = 'S') then
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, 'X')
          else if (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = '@X NF ENTRADA') and
            (dataSet.FieldByName('natureza_nf').AsString = 'E') then
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, 'X')
          else if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = '@VALOR_EXTENSO' then
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
              vDadosIni.Extenso(dataSet.FieldByName('valor_total').AsFloat))
          else if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = '@CAMPOFIXO' then
          begin
            vConfigNf.vItem.montaSelect('select icn.*,(select count(codigo) from camposnf  where nordem_camp = icn.codigo and tipo_nota = 10) IMP' +
              ' from Itens_Config_nf icn' +
              ' where ativo = 1 and codigo = ' + vConfigNf.vCampos.dataSet.FieldByName('NORDEM_CAMP').AsString);
            if Trim(vConfigNf.vItem.dataSet.FieldByName('DESCRICAO').AsString) <> '' then
              imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                vConfigNf.vItem.dataSet.FieldByName('DESCRICAO').AsString);
          end;
        end
          //Impressão de outras tabelas ligadas a nota fiscal, menos os itens
        else if (vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsString <> '') and
          (vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsString <> '') and
          (copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 1, 3) = 'FK_') and
          (copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 1, 7) <> 'FK_NOTA') then
        begin
          if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'FK_CLIENTES' then
            vDataSetImp := TClientDataSet(vClFor.dataSet)
          else if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'FK_NAT_OP' then
            vDataSetImp := TClientDataSet(vCfop.dataSet)
          else if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'FK_TRANSPORTADOR' then
            vDataSetImp := TClientDataSet(vTr.dataSet)
          else if vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'FK_COND_PAG' then
            vDataSetImp := TClientDataSet(vCPag.dataSet)
          else if Copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 1, 3) = 'FK_' then
          begin
            vDataSetImp := TClientDataSet(dtmNF.cdsImp);
            vDataSetImp.Close;
            try
              vDataSetImp.CommandText := 'SELECT ' +
                vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString +
                ' FROM ' + Copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 4,
                Length(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString)) +
                ' WHERE COD_EMPRESA = ' + vDadosIni.codEmpresa + ' AND ATIVO = 1';
              vDataSetImp.Open;
            except
              try
                vDataSetImp.CommandText := 'SELECT ' +
                  vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString +
                  ' FROM ' + Copy(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString, 4,
                  Length(vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString));
                vDataSetImp.Open;
              except
              end;
            end;
          end;
          //Impressão dos campos
          for I := 0 to vDataSetImp.FieldCount - 1 do
          begin
            if vDataSetImp.Fields[I].FieldName =
              vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString then
            begin
              if (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'FK_CLIENTES') and
                (vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString = 'ENDERECO') then
              begin
                vEndereco := trim(vDataSetImp.FieldByName('ENDERECO').AsString);
                if (vDataSetImp.FieldByName('NUM_END_CLIENTE').AsString) <> '' then
                  vEndereco := vEndereco + ', ' +
                    vDataSetImp.FieldByName('NUM_END_CLIENTE').AsString;
                if (vDataSetImp.FieldByName('COMPLEMENTO').AsString) <> '' then
                  vEndereco := vEndereco + ', ' + vDataSetImp.FieldByName('COMPLEMENTO').AsString;
                imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, vEndereco);
              end
              else if vDataSetImp.Fields[I].FieldName = 'COD_CLIENTE' then
                imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  vDadosIni.StrZero(vDataSetImp.Fields[I].AsInteger, 5))
              else if vDataSetImp.Fields[I].FieldName = 'CODIGO_NOP' then
                imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, FImpCFOP)
              else
                imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  vDataSetImp.Fields[I].AsString);
            end;
          end;
        end
          //Impressão dos campos da nota fiscal.
        else if (vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsString <> '') and
          (vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsString <> '')
          and (vConfigNf.vCampos.dataSet.FieldByName('TABELA').AsString = 'NOTAFISCAL') then
        begin
          vCampo := Trim(vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString);
          //Caso a nota fiscal tenha mais de uma Folha, estes campos serão impressps
          if ((vCampo = 'BASE_ICM') or (vCampo = 'VALOR_ICM') or (vCampo = 'BASE_ICMSUB') or
            (vCampo = 'VALOR_ICMSUB') or (vCampo = 'VALOR_PROD') or (vCampo = 'VALOR_FRETE') or
            (vCampo = 'VALOR_SEGURO') or (vCampo = 'VALOR_DESC') or (vCampo = 'VALOR_OUT_DESP') or
            (vCampo = 'VALOR_IPI') or (vCampo = 'VALOR_TOTAL') or (vCampo = 'BASE_ISS') or
            (vCampo = 'VALOR_ISS') or (vCampo = 'VALOR_SERV')) and (vFolha < vQtdeNf) then
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, '************')
              //Caso o campo seja float sera formatado com 2 casas decimais
          else if dataSet.FieldByName(vCampo) is TFloatField then
          begin
            vFormat := '%8.2n';
            if UpperCase(vCampo) = 'CODIGO_NOP' then
              vFormat := '%0.0f';
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
              Format(vFormat, [dataSet.FieldByName(vCampo).AsFloat]));
          end
            //Caso Campo seja configurado com mais de uma linha e seja string aqui sera impresso
          else if ((dataSet.FieldByName(vCampo) is TStringField) or
            (dataSet.FieldByName(vCampo) is TWideStringField) or
            (dataSet.FieldByName(vCampo) is TMemoField) or
            (dataSet.FieldByName(vCampo) is TBlobField)) and
            (vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger > 1) and
            (Trim(dataSet.FieldByName(vCampo).AsString) <> '') or
            ((vCampo = 'OBS') and (dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString <> '') and
            (vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger > 1)) then
          begin
            //Cria o memo para jogar o valor do campo dentro
            lista := TMemo.Create(Application);
            try
              lista.Visible := false;
              lista.Parent := Application.MainForm;
              lista.Width := 800;
              lista.Height := 800;
              lista.WordWrap := False;
              lista.Clear;
              lista.Lines.Text := (dataSet.FieldByName(vCampo).AsString);
              if vCampo = 'OBS' then
                lista.Lines.Text := lista.Lines.Text + sLineBreak +
                  (dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString);

              //Variavel vLinha para receber a linha inicial da impressao do campo
              vLinha := vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger;
              //Variavel vQtdeImpLinhas recebe a menor quantidade de linhas, maxlinhas ou se o vampo tiver menos linhas
              vQtdeImpLinhas := lista.Lines.Count;
              if lista.Lines.Count > vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger
                then
                vQtdeImpLinhas := vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger;
              //Neste for a impressao das linhas é feita de acordo a quantidede de linhas definidas
              //La dentro a variavel vLinha so é aumentada se a qtde de linhas for maior q 1 e se nao for o final
              //das linhas, pois no caso dos itens da nota no proprio while ja existe um incremento do vLinha
              if (vCampo = 'OBS') and (vQtdeNf > 1) then
              begin
                imprimeLinha(vLinha, vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger, 'FOLHA: ' +
                  vDadosIni.StrZero(vFolha, 2) + '/' + vDadosIni.StrZero(vQtdeNf, 2));
                vLinha := vLinha + 1;
              end;
              for j := 0 to vQtdeImpLinhas - 1 do
              begin
                imprimeLinha(vLinha, vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  lista.Lines[j]);
                if (vQtdeImpLinhas > 1) and (j <> (vQtdeImpLinhas - 1)) then
                  vLinha := vLinha + 1;
              end;
            finally
              lista.Free;
              lista := nil;
            end;
          end
          else
            imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
              vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
              dataSet.FieldByName(vCampo).AsString);
        end;
      end;
      vConfigNf.vCampos.dataSet.Next;
    end;

    //Impressao das faturas
//    vConfigNf.vCampos.dataSet.First;
    if vFolha = vQtdeNf then
    begin
      vBol.dataSet.First;
      vConfigNf.vCampos.abreCamposNf('FK_BOLETAS');
      vOrdemBol := 0;
      //Na impressao das faturas ele utiliza o campo ordem_cfg para impressao dos campos
      //Na ordem dos foi definido com o campo configurado
      while not vBol.dataSet.Eof do
      begin
        vOrdemBol := vOrdemBol + 1;
        for I := 0 to vBol.dataSet.FieldCount - 1 do
          if vConfigNf.vCampos.dataSet.Locate('DESCRICAO_CAMP;ORDEM_CFG',
            VarArrayOf([vBol.dataSet.Fields[i].FieldName, vOrdemBol]), []) then
            if vBol.dataSet.Fields[i] is TFloatField then
              imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                Format('%8.2n', [vBol.dataSet.Fields[i].AsFloat]))
            else
              imprimeLinha(vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                vBol.dataSet.Fields[i].AsString);
        vBol.dataSet.Next;
      end;
    end;

    vQtdeServImp := 0;
    if (not vProdutosFim) or (not vServicosFim) then
    begin
      vConfigNf.vCampos.abreCamposNf('FK_NOTAFISCAL_ITEM_S');
      vLinha := vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger;
      vItem.dataSet.GotoBookmark(ponteiroServicos);
      while not vItem.dataSet.Eof do
      begin
        if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
        begin
          vQtdeServImp := vQtdeServImp + 1;
          for I := 0 to vItem.dataSet.FieldCount - 1 do
            if (vConfigNf.vCampos.dataSet.Locate('DESCRICAO_CAMP',
              vItem.dataSet.Fields[i].FieldName,
              [])) and
              (vConfigNf.vCampos.dataSet.FieldByName('NORDEM_CAMP').AsString <> '') then
            begin
              vCampo := Trim(vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString);
              if vItem.dataSet.FieldByName(vCampo) is TFloatField then
              begin
                vFormat := '%8.2n';
                if UpperCase(vCampo) = 'ALIQ_ISS' then
                  vFormat := '%2.2n'
                else if UpperCase(vCampo) = 'CODIGO_NOP' then
                  vFormat := '%0.0f';
                imprimeLinha(vLinha, vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  Format(vFormat, [vItem.dataSet.FieldByName(vCampo).AsFloat]));
              end
              else
                imprimeLinha(vLinha, vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  vItem.dataSet.FieldByName(vCampo).AsString);
            end;
          vLinha := vLinha + 1;
        end;
        vItem.dataSet.Next;
        if (vQtdeServImp = vQtdeServNf) or (vItem.dataSet.Eof) or (vQtdeServImp =
          vDadosIni.vEmp.vQtdeServNf) then
          //        if (vLinha >= (vDadosIni.vEmp.vQtdeServNf + vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger))
          //          or (vItem.dataSet.Eof) then
        begin
          vServicosFim := vQtdeServImp = vQtdeServNf;
          ponteiroServicos := vItem.dataSet.GetBookmark;
          Break;
        end;
      end;

      vQtdeProdImp := 0;
      vConfigNf.vCampos.abreCamposNf('FK_NOTAFISCAL_ITEM');
      vLinha := vConfigNf.vCampos.dataSet.FieldByName('LINHA_CFG').AsInteger;
      vItem.dataSet.GotoBookmark(ponteiroProdutos);
      while not vItem.dataSet.Eof do
      begin
        if vItem.dataSet.FieldByName('tipo_item').AsString <> 'S' then
        begin
          vLinhaItens := vLinha;
          vQtdeProdImp := vQtdeProdImp + 1;
          for I := 0 to vItem.dataSet.FieldCount - 1 do
            if (vConfigNf.vCampos.dataSet.Locate('DESCRICAO_CAMP',
              vItem.dataSet.Fields[i].FieldName,
              [])) and
              (vConfigNf.vCampos.dataSet.FieldByName('NORDEM_CAMP').AsString <> '') then
            begin
              vCampo := Trim(vConfigNf.vCampos.dataSet.FieldByName('DESCRICAO_CAMP').AsString);
              if vItem.dataSet.FieldByName(vCampo) is TFloatField then
              begin
                vFormat := '%8.2n';
                if (UpperCase(vCampo) = 'VALOR_UNITARIO') and (vDadosIni.vEmp.vCasasDecimais > 0)
                  then
                  vFormat := '%8.' + IntToStr(vDadosIni.vEmp.vCasasDecimais) + 'n'
                else if UpperCase(vCampo) = 'QUANTIDADE' then
                  vFormat := '%8.3n'
                else if UpperCase(vCampo) = 'ALIQ_ICM' then
                  vFormat := '%2.2n'
                else if UpperCase(vCampo) = 'ALIQ_IPI' then
                  vFormat := '%2.2n'
                else if UpperCase(vCampo) = 'ALIQ_ICMSUB' then
                  vFormat := '%2.2n'
                else if UpperCase(vCampo) = 'CODIGO_NOP' then
                  vFormat := '%0.0f';
                imprimeLinha(vLinhaItens,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  Format(vFormat, [vItem.dataSet.FieldByName(vCampo).AsFloat]));
              end
              else if ((vItem.dataSet.FieldByName(vCampo) is TStringField) or
                (vItem.dataSet.FieldByName(vCampo) is TWideStringField) or
                (vItem.dataSet.FieldByName(vCampo) is TMemoField) or
                (vItem.dataSet.FieldByName(vCampo) is TBlobField)) and
                (vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger > 1) then
              begin
                vCampo2 := vCampo;
                if UpperCase(vCampo) = 'DESCRICAO_ITEM' then
                begin
                  if vItem.dataSet.FieldByName('descricao_item_outras').AsString <> '' then
                    vCampo2 := 'DESCRICAO_ITEM_OUTRAS';
                end;
                //Cria o memo para jogar o valor do campo dentro
                lista := TMemo.Create(Application);
                try
                  lista.Visible := false;
                  lista.Parent := Application.MainForm;
                  lista.Width := 800;
                  lista.Height := 800;
                  lista.WordWrap := False;
                  lista.Clear;
                  lista.Lines.Text := (vItem.dataSet.FieldByName(vCampo2).AsString);
                  if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
                    (UpperCase(vCampo) = 'DESCRICAO_ITEM') and
                    (Trim(vDadosIni.vAplic) = 'S') then
                  begin
                    vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
                      vItem.dataSet.FieldByName('cod_prod').AsString);
                    lista.Lines[0] := lista.Lines[0] + ' ' +
                      vItem.vProd.dataSet.FieldByName('aplicacao_prod').AsString;
                  end
                  else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
                    (Trim(vDadosIni.vAplic) <> '') then
                    lista.Lines[0] := lista.Lines[0] + ' ' +
                      vItem.dataSet.FieldByName('num_fab_prod').AsString;

                  //Variavel vQtdeImpLinhas recebe a menor quantidade de linhas, maxlinhas ou se o vampo tiver menos linhas
                  vQtdeImpLinhas := lista.Lines.Count;
                  if lista.Lines.Count > vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger
                    then
                    vQtdeImpLinhas := vConfigNf.vCampos.dataSet.FieldByName('MAXLINHAS').AsInteger;
                  //Neste for a impressao das linhas é feita de acordo a quantidede de linhas definidas
                  //La dentro a variavel vLinha so é aumentada se a qtde de linhas for maior q 1 e se nao for o final
                  //das linhas, pois no caso dos itens da nota no proprio while ja existe um incremento do vLinha
                  for j := 0 to vQtdeImpLinhas - 1 do
                  begin
                    if (vCampo2 = 'DESCRICAO_ITEM_OUTRAS') and (j > 0) then
                      vDesconsiderarTanamho := True;
                    imprimeLinha(vLinha,
                      vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                      vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                      lista.Lines[j]);
                    if (vQtdeImpLinhas > 1) and (j <> (vQtdeImpLinhas - 1)) then
                      vLinha := vLinha + 1;
                  end;
                finally
                  lista.Free;
                  lista := nil;
                end;
              end
              else
              begin
                imprimeLinha(vLinhaItens,
                  vConfigNf.vCampos.dataSet.FieldByName('COLUNA_CFG').AsInteger,
                  vConfigNf.vCampos.dataSet.FieldByName('CONDENSADO').AsInteger,
                  vItem.dataSet.FieldByName(vCampo).AsString);
              end;
            end;
          vLinha := vLinha + 1;
        end;
        vItem.dataSet.Next;
        if (vQtdeProdImp = vQtdeProdNf) or (vItem.dataSet.Eof) or (vQtdeProdImp =
          vDadosIni.vEmp.vQtdeProdNf) then
        begin
          vProdutosFim := vQtdeProdImp = vQtdeProdNf;
          ponteiroProdutos := vItem.dataSet.GetBookmark;
          Break;
        end;
      end;

    end; //if (not vProdutosFim) and (not vServicosFim) then
    if vFolha <> vQtdeNf then
      vRdpNf.Novapagina;
  end;
  vRdpNf.Fechar;

  vItem.IndexFieldNames := 'NITEM';
end;

