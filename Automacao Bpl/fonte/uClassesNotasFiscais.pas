function TNFItem.edit: boolean;
begin
  Result := inherited edit;
  if Result then
  begin
    if dataSet.FieldByName('tipo_item').AsString = 'V' then
    begin
      if not vDetVeic.dataSet.Active then
        vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger);

      vDetVeic.dataSet.First;
      while not vDetVeic.dataSet.Eof do
      begin
        if vDetVeic.dataSet.FieldByName('nitem').AsInteger =
          dataSet.FieldByName('nitem').AsInteger then
        begin
          vDetVeic.dataSet.Edit;
          vDetVeic.dataSet.FieldByName('chassi').AsString := dataSet.FieldByName('chassi').AsString;
          vChassi := vDetVeic.dataSet.FieldByName('chassi').AsString;
          vTipoV := trim(vDetVeic.dataSet.FieldByName('tipo_venda').AsString);
          Exit;
        end;
        vDetVeic.dataSet.Next;
      end;
      //      if (vDetVeic.Dataset.state = dsBrowse) and (vDetVeic.dataSet.RecordCount > 0) then
      vDetVeic.Insert;
      vDetVeic.dataSet.FieldByName('cod_nf').AsInteger :=
        dataSet.FieldByName('cod_nf').AsInteger;
      vDetVeic.dataSet.FieldByName('cod_empresa').AsInteger :=
        dataSet.FieldByName('cod_empresa').AsInteger;
      vDetVeic.dataSet.FieldByName('nitem').AsInteger :=
        dataSet.FieldByName('nitem').AsInteger;
      vDetVeic.dataSet.FieldByName('chassi').AsString := dataSet.FieldByName('chassi').AsString;
      vDetVeic.dataSet.FieldByName('tipo_venda').AsString := 'N';
      vDetVeic.dataSet.FieldByName('TPREST').AsString := '0';
      vDetVeic.dataSet.Post;
      vDetVeic.dataSet.Edit;
    end;
  end;
end;

function TNFItem.FirstMargem: boolean;
begin
  try
    dataSet.First;
    if dataSet.FieldByName('tipo_item').AsString = 'P' then
    begin
      Result := true;
      getAtributos;
      Exit;
    end;

    while not dataSet.Eof do
    begin
      dataSet.Next;
      //    if dataSet.Bof then
      if dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        Result := true;
        getAtributos;
        Exit;
      end;
    end;
    Result := False;
  finally
    if not Result then
      vQrUltimasCompras.Close;
  end;
end;

function TNFItem.getAtributos: boolean;
begin
  if dataSet.State = dsBrowse then
    DataSet.Edit;

  CalcularPrecoItemDataSet;

  FMarkUpV := ffloat('prctb_item', DIGROUNDMAX);
  FMarkUpA := ffloat('prctb_itema', DIGROUNDMAX);
  FMarkUp3 := ffloat('prctb_item3', DIGROUNDMAX);
  FMarkUp6 := ffloat('prctb_item6', DIGROUNDMAX);
  FMarkUp9 := ffloat('prctb_item9', DIGROUNDMAX);

  FPrecoV := ffloat('prec_vnd_prod', DIGROUNDMAX);
  FPrecoA := ffloat('prec_vnd_proda', DIGROUNDMAX);
  FPreco30 := ffloat('prec_30_prod', DIGROUNDMAX);
  FPreco60 := ffloat('prec_60_prod', DIGROUNDMAX);
  FPreco90 := ffloat('prec_90_prod', DIGROUNDMAX);

  vProd.buscaProduto(fint('grupo_prod'), fstr('cod_prod'));

  FMarkUpEsperadoV := vProd.ffloat('PERC_TB_PROD', DIGROUNDMAX);
  FMarkUpEsperadoA := vProd.ffloat('PERC_TB_PRODA', DIGROUNDMAX);
  FPercAdProd3     := vProd.ffloat('PERC_AD_30');
  FPercAdProd6     := vProd.ffloat('PERC_AD_60');
  FPercAdProd9     := vProd.ffloat('PERC_AD_90');
  FPerc30ToVrj     := vProd.ffloat('PDESC_PR30_VAREJO');

  fPrecoAtualVarejo  := vProd.ffloat('prec_tab_prod', 0 - vDadosIni.vEmp.vCasasDecimais);
  fPrecoAtualAtacado := vProd.ffloat('prec_publico', 0 - vDadosIni.vEmp.vCasasDecimais);
                                        
  {
  FMargemObtidaV := CalcUtils.MargemLucro(FMarkUpV, -vDadosIni.vProduto.Precos.DigMrkMrg);
  FMargemObtidaA := CalcUtils.MargemLucro(FMarkUpA, -vDadosIni.vProduto.Precos.DigMrkMrg);

  FDescontoPrecoAVista := 0;
  if vDadosIni.vProduto.vMaxDescPrecoAVista = 'S' then
    FDescontoPrecoAVista := vProd.dataSet.FieldByName('PDESC_PR30_VAREJO').AsFloat;

  FPreco30 := 0;
  FPreco60 := 0;
  FPreco90 := 0;

  if dataSet.FieldByName('PREC_30_PROD').AsFloat > 0 then
    FPreco30 := dataSet.FieldByName('PREC_30_PROD').AsFloat
  else if (FPrecoV > 0 ) and (vProd.dataSet.FieldByName('PERC_AD_30').AsFloat > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
    FPreco30 := FPrecoV + (FPrecoV * vProd.dataSet.FieldByName('PERC_AD_30').AsFloat / 100);

  if dataSet.FieldByName('PREC_60_PROD').AsFloat > 0 then
    FPreco60 := dataSet.FieldByName('PREC_60_PROD').AsFloat
  else if (FPrecoV > 0 ) and (vProd.dataSet.FieldByName('PERC_AD_60').AsFloat > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
    FPreco60 := FPrecoV + (FPrecoV * vProd.dataSet.FieldByName('PERC_AD_60').AsFloat / 100);

  if dataSet.FieldByName('PREC_90_PROD').AsFloat > 0 then
    FPreco90 := dataSet.FieldByName('PREC_90_PROD').AsFloat
  else if (FPrecoV > 0 ) and (vProd.dataSet.FieldByName('PERC_AD_90').AsFloat > 0) and (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
    FPreco90 := FPrecoV + (FPrecoV * vProd.dataSet.FieldByName('PERC_AD_90').AsFloat / 100);

  FMarkUpEsperadoV := vProd.ffloat('PERC_TB_PROD', -2);
  FMarkUpEsperadoA := vProd.ffloat('PERC_TB_PRODA', -2);
  //FMargemEsperadaV := CalcUtils.MargemLucro(FMarkUpEsperadoV, -vDadosIni.vProduto.Precos.DigMrkMrg);
  //FMargemEsperadaA := CalcUtils.MargemLucro(FMarkUpEsperadoA, -vDadosIni.vProduto.Precos.DigMrkMrg);
  fPrecoAtualVarejo  := vProd.ffloat('prec_tab_prod', 0 - vDadosIni.vEmp.vCasasDecimais);
  fPrecoAtualAtacado := vProd.ffloat('prec_publico', 0 - vDadosIni.vEmp.vCasasDecimais);

  FPreco30 := Roundto(FPreco30, -2);
  FPreco60 := Roundto(FPreco60, -2);
  FPreco90 := Roundto(FPreco90, -2);
  }
end;

function TNFItem.getCorCampo(varejoOuAtacado, MarkUpOuMargem: string): integer;
var
  temp: string;
begin
  Result := clRed;

  if varejoOuAtacado = 'V' then
  begin
    if MarkUpOuMargem = 'MK' then
    begin
      if FMarkUpV > FMarkUpEsperadoV then
        Result := clGreen
      else if FMarkUpV = FMarkUpEsperadoV then
        Result := clBlue
    end
    else if MargemObtidaV > MargemEsperadaV then
      Result := clGreen
    else if MargemObtidaV = MargemEsperadaV then
      Result := clBlue;
  end
  else
  begin
    if MarkUpOuMargem = 'MK' then
    begin
      if FMarkUpA > FMarkUpEsperadoA then
        Result := clGreen
      else if FMarkUpA = FMarkUpEsperadoA then
        Result := clBlue;
    end
    else if MargemObtidaA > MargemEsperadaA then
      Result := clGreen
    else if MargemObtidaA = MargemEsperadaA then
      Result := clBlue
  end;
end;

procedure TNFItem.getDadosItemNF;
begin
  zerarDadosItem;
  vrDadosItem.SetValuesFrom(dataSet, True);
  vrDadosItem.indTot              := IfThen(dataSet.FieldByName('indtot').Value = 0, 0, 1);
  vrDadosItem.indsomapisst        := IfThen(dataSet.FieldByName('indsomapisst').Value = 0, 0, 1);
  vrDadosItem.indsomacofinsst     := IfThen(dataSet.FieldByName('indsomacofinsst').Value = 0, 0, 1);
  vrDadosItem.altera_estoque_cfop := IfThen(vrDadosItem.indTot = 0 , 'N', f_str('altera_estoque_cfop'));
  vrDadosItem.altera_estoque_cfop := IfThen(vrDadosItem.tipv_veiculo = 'A', 'N', vrDadosItem.altera_estoque_cfop);
  vrDadosItem.altera_estoque_cfop := IfThen(FOwerNF.f_int('id_ajuste') > 0, 'N', vrDadosItem.altera_estoque_cfop);
  vrDadosItem.altera_custo_cfop   := IfThen(vrDadosItem.altera_estoque_cfop = 'N', 'N', f_str('altera_custo_cfop'));
  vrDadosItem.base_icm_simples    := IfThen(IndexStr(f_str('csosn'), ['101', '201', '900']) >= 0, f_float('base_icm_simples'));
  vrDadosItem.valor_icm_simples   := IfThen(IndexStr(f_str('csosn'), ['101', '201', '900']) >= 0, f_float('valor_icm_simples'));
  vrDadosItem.aliq_icm_simples    := IfThen(IndexStr(f_str('csosn'), ['101', '201', '900']) >= 0, f_float('aliq_icm_simples'));
  vrDadosItem.csosn               := IfThen(vDadosIni.vEmp.vRegime <> 'SIMPLES', '', f_str('csosn'));

  vrDadosItem.tributosRTC := FTributos.GetItem( vrDadosItem.dfe_trib_id );

  if fnull('tipo_calc') then
  begin
    if FOwerNF.fequals('natureza_nf', 'E') or (FOwerNF.fdif('tipo_emissao', '1')) or (fdif('tipo_item', 'P')) then
      vrDadosItem.tipo_calc :=  Integer(tcParcial)
    else
      vrDadosItem.tipo_calc := Integer(tcCompleto);
  end;

  if fnull('tipo_calc_pc') then
    vrDadosItem.tipo_calc_pc := Integer(tcCompleto);
end;

