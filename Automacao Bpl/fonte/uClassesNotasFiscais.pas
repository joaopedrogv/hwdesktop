end;

function TNFCab.efetuarCancelamentoTransacaoCartaoRegistroSelecionado: Boolean;
var
  vTIPVND, vTerminalAdm, vAUT, vNSU: string;
  vNumVND, vSecao, vTerminalF, vSeqIDTransacao: Integer;
  vValor: Extended;
  buscas2 : TIBQuery;
begin
  try
    Result := False;
    buscas2 := TIBQuery(dtmNF.qrBuscasNf2);

    vTIPVND := buscas.FieldByName('Tipo Vnd').AsString;
    vNumVND := buscas.FieldByName('Num Vnd').AsInteger;
    vSecao := buscas.FieldByName('Secao').AsInteger;
    vAUT := buscas.FieldByName('Num Aut Cartao').AsString;
    vNSU := buscas.FieldByName('Num Doc Adm').AsString;
    vTerminalAdm := buscas.FieldByName('Term Adm').AsString;
    vValor := buscas.FieldByName('Valor').AsFloat;

    if not vDadosIni.PesqPros('NF0193', 'CANCELAR', 'NUM NF '+ dataSet.FieldByName('NUM_NF').AsString + ' - ' +
      'VL: ' + Format('%0.2n', [vValor]) + '-AUT:' + vAUT + '-NSU:' + vNSU + '-TERM:' + vTerminalAdm, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
      Exit;

    if Application.MessageBox(Pchar('Este processo somente irá efetuar o cancelamento da transação no sistema.' + sLineBreak +
      'Certifique-se que ja tenha cancelado ou de cancelar a transação TEF com a Adm do Cartão' + sLineBreak +
      'Para cancelar a transação TEF você deve usar a opção "Administrativo"' + sLineBreak +
      'Deseja mesmo cancelar a transacao no sistema?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
      Exit;

    //busca das formas de pagamento ja processadas pra remover dos creditos os dados
    buscas.Close;
    buscas.SQL.Text := 'select n_processamento from formpagamento' +
      ' where coalesce(tpdocs, '''') = ' + QuotedStr(Trim(vTIPVND)) +
      ' and nrequisicao = ' + IntToStr(vNumVND) +
      ' and coalesce(secao,0) = ' + IntToStr(vSecao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and num_nota = :num_nf and sub_serie =  :serie' +
      ' and tpdocs <> ''LCS'' and tipdoc = ''S2''' +
      ' and coalesce(cod_terminal_adm, '''') = ' + QuotedStr(Trim(vTerminalAdm)) +
      ' and coalesce(n_aut_cart, '''') = ' + QuotedStr(Trim(vAUT)) +
      ' and coalesce(n_docnsu_adm, '''') = ' + QuotedStr(Trim(vNSU)) +
      ' and n_processamento > 0';
    buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
    buscas.ParamByName('serie').AsInteger := StrToIntDef(Trim(dataSet.FieldByName('serie').AsString), 0);
    buscas.Open;

    buscas.First;
    while not buscas.Eof do
    begin

      //remocao dos creditos os dados da transacao
      buscas2.Close;
      buscas2.SQL.Text := 'update CONTROLE_CREDITOS' +
        ' set cod_terminal_adm = ''''' +
        ', n_aut_cart = ''''' +
        ', n_docnsu_adm = ''''' +
        ' where cod_cred = ' + IntToStr(buscas.FieldByName('n_processamento').AsInteger) +
        ' and ' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') +
        ' = ' + vDadosIni.codEmpresa +
        ' and DATQ_C is null';
      buscas2.ExecSQL;

      buscas.Next;
    end;

    //remocao da forma de pagamento os dados da transacao
    buscas.Close;
    buscas.SQL.Text := 'update formpagamento' +
      ' set cod_terminal_adm = ''''' +
      ', n_aut_cart = ''''' +
      ', n_docnsu_adm = ''''' +
      ', tef = ''N''' +
      ' where coalesce(tpdocs, '''') = ' + QuotedStr(Trim(vTIPVND)) +
      ' and nrequisicao = ' + IntToStr(vNumVND) +
      ' and coalesce(secao,0) = ' + IntToStr(vSecao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and num_nota = :num_nf and sub_serie =  :serie' +
      ' and tpdocs <> ''LCS'' and tipdoc = ''S2''' +
      ' and coalesce(cod_terminal_adm, '''') = ' + QuotedStr(Trim(vTerminalAdm)) +
      ' and coalesce(n_aut_cart, '''') = ' + QuotedStr(Trim(vAUT)) +
      ' and coalesce(n_docnsu_adm, '''') = ' + QuotedStr(Trim(vNSU));
    buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
    buscas.ParamByName('serie').AsInteger := StrToIntDef(Trim(dataSet.FieldByName('serie').AsString), 0);
    buscas.ExecSQL;

    //alteracao do status para cancelado na tabela de transacao de cartao
    buscas.Close;
    buscas.SQL.Text := 'update transacao_cartao set status = ''C'',' +
      ' COD_USUARIO_CANC = ' + IntToStr(vDadosIni.vCodUsuario) + ',' +
      ' LOGIN_USUARIO_CANC = ' +QuotedStr(Copy(Trim(vDadosIni.vNomeUsuario), 1, 20)) +
      ' where tpdocs = ' + QuotedStr(Trim(vTIPVND)) +
      ' and nrequisicao = ' + IntToStr(vNumVND) +
      ' and coalesce(secao,0) = ' + IntToStr(vSecao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status = ''A''' +
      ' and coalesce(cod_terminal_adm, '''') = ' + QuotedStr(Trim(vTerminalAdm)) +
      ' and coalesce(n_aut_cart, '''') = ' + QuotedStr(Trim(vAUT)) +
      ' and coalesce(n_docnsu_adm, '''') = ' + QuotedStr(Trim(vNSU)) +
      ' and coalesce(status, '''') <> ''C''';
    buscas.ExecSQL;

    buscas.Transaction.Commit;

    verificaFaturasEmCartao;

    Result := True;

    vDadosIni.GravaAuditoria('NF0193', 'CANCELAR', 'SUCESSO - NUM NF '+ dataSet.FieldByName('NUM_NF').AsString + ' - ' +
      'VL: ' + Format('%0.2n', [vValor]) + '-AUT:' + vAUT + '-NSU:' + vNSU + '-TERM:' + vTerminalAdm, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, buscas2);

  except on E: Exception do
    begin
      Result := False;
      buscas.Transaction.Rollback;

      vDadosIni.GravaAuditoria('NF0193', 'CANCELAR', 'FALHA - NUM NF '+ dataSet.FieldByName('NUM_NF').AsString + ' - ' +
        'VL: ' + Format('%0.2n', [vValor]) + '-AUT:' + vAUT + '-NSU:' + vNSU + '-TERM:' + vTerminalAdm, 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas2);

      registraErro('function TNFCab.efetuarCancelamentoTransacaoCartaoRegistroSelecionado. Erro: ' + e.Message);
      Application.MessageBox(PChar('Erro ao cancelar transação no sistema. Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TNFCab.efetuarTransacaoCartaoRegistroSelecionado: Boolean;
var
  vTIPVND, vTerminalAdm: string;
  vNumVND, vSecao, vTerminalF, vSeqIDTransacao, vCtrl: Integer;
  buscas2: TIBQuery;
begin
  try
    Result := False;
    buscas2 := TIBQuery(dtmNF.qrBuscasNf2);

    if not vDadosIni.PesqPros('NF0192', 'INCLUIR', 'NUM NF '+ dataSet.FieldByName('NUM_NF').AsString + ' - ' +
      'VL: ' + Format('%0.2n', [buscas.FieldByName('valor').AsFloat]), 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, buscas2, True) then
      Exit;

    if StrToIntDef(vDadosIni.vCodTerminal, 0) > 0 then
      vTerminalF := StrToIntDef(vDadosIni.vCodTerminal, 0)
    else
      vTerminalF := StrToIntDef(Trim(vDadosIni.GetIni('TEF', 'TerminalF', '0')), 0);

    if vTerminalF <= 0 then
      raiseExceptionCreate('Código inválido ou sem configuração para o codigo o terminal no Config: "[TEF] TerminalF=1"!', '');

    if buscas.FieldByName('Valor').AsFloat <= 0 then
      raiseExceptionCreate('Valor para transação inválido', '');

    if Trim(buscas.FieldByName('tef').AsString) = 'S' then
      raiseExceptionCreate('Transação já efetuada!' + sLineBreak + 'Caso tenha sido cancelada favor cancelar no sistema antes de continuar', '');

    if Trim(buscas.FieldByName('Num Aut Cartao').AsString) <> '' then
      raiseExceptionCreate('Número de Autorização de cartão já existe!' + sLineBreak + 'Caso a transação tenha sido cancelada favor cancelar no sistema antes de continuar', '');

    if Trim(buscas.FieldByName('Num Doc Adm').AsString) <> '' then
      raiseExceptionCreate('Número do Documento da Administradora (NSU) já existe!' + sLineBreak + 'Caso a transação tenha sido cancelada favor cancelar no sistema antes de continuar', '');

    if Trim(buscas.FieldByName('Term Adm').AsString) <> '' then
      raiseExceptionCreate('Número do Terminal da ADM já existe!' + sLineBreak + 'Caso a transação tenha sido cancelada favor cancelar no sistema antes de continuar', '');

    vTIPVND := buscas.FieldByName('Tipo Vnd').AsString;
    vNumVND := buscas.FieldByName('Num Vnd').AsInteger;
    vSecao := buscas.FieldByName('Secao').AsInteger;
    vCtrl := buscas.FieldByName('Ctrl').AsInteger;

    if not vDadosIni.operacaoPosVirtual(posCRT,
      'Recebimento em cartão para a NF: ' + IntToStr(dataSet.FieldByName('num_nf').AsInteger),
      IntToStr(dataSet.FieldByName('num_nf').AsInteger),
      vDadosIni.StrToFloatFormat(buscas.FieldByName('valor').AsFloat, 2), buscas) then
      raiseExceptionCreate('O processo não foi concluído!', '');

    if vDadosIni.vPOSV.retorno <> retSucesso then
      Exit;

    vSeqIDTransacao := vDadosIni.gravaTransacaoPosVirtual(0, vTIPVND, '', vNumVND, vSecao, vCtrl, buscas);

//    vSeqIDTransacao := 0;
//    while true do
//    begin
//      buscas.Close;
//      buscas.SQL.Text := 'select cod from incrementa_codigo( ' + vDadosIni.codEmpresa + ',''TRANSACAO_CARTAO'')';
//      buscas.Open;
//      if buscas.FieldByName('cod').AsInteger > 0 then
//      begin
//        vSeqIDTransacao := buscas.FieldByName('cod').AsInteger;
//        Break;
//      end;
//    end;

//    vTerminalAdm := '';
//    buscas.Close;
//    buscas.SQL.Text := 'insert into TRANSACAO_CARTAO' +
//      ' (SEQID, COD_EMPRESA, TPDOCS, NREQUISICAO, SECAO, VALOR_TRANSACAO, N_AUT_CART, N_DOCNSU_ADM, COD_TERMINAL_ADM, STATUS, COD_USUARIO, LOGIN_USUARIO)' +
//      ' values ( ' + IntToStr(vSeqIDTransacao) + ',' +
//      vDadosIni.codEmpresa + ', ' +
//      QuotedStr(Copy(Trim(vTIPVND), 1, 6)) + ', ' +
//      IntToStr(vNumVND) + ', ' +
//      IntToStr(vSecao) + ', :VALOR_TRANSACAO, ' +
//      QuotedStr(Copy(Trim(vDadosIni.vPOSV.retornoAUT), 1, 20)) + ', ' +
//      QuotedStr(Copy(Trim(vDadosIni.vPOSV.retornoNSU), 1, 10)) + ', ' +
//      QuotedStr(Copy(Trim(vTerminalAdm), 1, 10)) + ', ''A'', ' +
//      IntToStr(vDadosIni.vCodUsuario) + ', ' +
//      QuotedStr(Copy( Trim(vDadosIni.vNomeUsuario), 1, 10)) + ')';
//    buscas.ParamByName('VALOR_TRANSACAO').AsFloat := vDadosIni.vPOSV.valorTransacaoTEF;
//    buscas.ExecSQL;

    //metodo para pegar o terminal adm
    // caso nao encontre chamar um formulario para o usuário selecionar o terminal

    buscas.Close;
    buscas.SQL.Text :=
      'select t.cod_term_adm, a.descricao_adm, t.desc_term_adm from adm_cartao a' +
      ' inner join terminal_cartao t on t.cod_adm = a.cod_adm and t.cod_empresa = a.cod_empresa' +
      ' where a.redes like ''%|''||' + QuotedStr(Trim(vDadosIni.vPOSV.retornoREDE)) +
      '||''|%'' and a.cod_empresa = :cod_empresa and t.tipo = ''D''' +
      ' and t.cod_terminalf = :cod_terminalf';
    buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
    buscas.ParamByName('COD_TERMINALF').AsInteger := vTerminalF;
    buscas.Open;

    buscas.FetchAll;

    if buscas.RecordCount = 1 then
      vTerminalAdm := buscas.FieldByName('cod_term_adm').AsString
