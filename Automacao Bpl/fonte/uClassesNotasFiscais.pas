function TNFCab.adicionaNotaFiscalTransito: boolean;
begin
  if not (dataSet.State in [dsInsert, dsEdit]) then
  begin
    Result := False;
    exit;
  end;
  try
    if vTransNF.dataSet.IsEmpty then
      raiseExceptionCreate('Nenhum veículo encontrado', '');
    //    begin
    //      Result := False;
    //      exit;
    //    end;
    if vTransNF.vItem.dataSet.IsEmpty then
      raiseExceptionCreate('Nenhum veículo encontrado', '');
    //    begin
    //      Result := False;
    //      exit;
    //    end;
    dataSet.FieldByName('num_nf').AsInteger :=
      vTransNF.dataSet.FieldByName('num_notaT').AsInteger;
    dataSet.FieldByName('serie').AsString :=
      Trim(vTransNF.dataSet.FieldByName('seriet').AsString);
    dataSet.FieldByName('data_contabil').AsDateTime :=
      vTransNF.dataSet.FieldByName('DATA_EMISSAOT').AsDateTime;
    dataSet.FieldByName('valor_total').AsFloat :=
      vTransNF.dataSet.FieldByName('VALORNOTAT').AsFloat;
    dataSet.FieldByName('valor_frete').AsFloat :=
      vTransNF.dataSet.FieldByName('FRETET').AsFloat;
    dataSet.FieldByName('valor_seguro').AsFloat :=
      vTransNF.dataSet.FieldByName('SEGUROT').AsFloat;
    dataSet.FieldByName('valor_icmsub').AsFloat :=
      vTransNF.dataSet.FieldByName('ICMSSUBT').AsFloat;
    dataSet.FieldByName('N_CAIXA').AsString :=
      Trim(vTransNF.dataSet.FieldByName('N_CAIXA').AsString);
    //    dataSet.FieldByName('valor_prod').AsFloat :=
    //      dataSet.FieldByName('valor_total').AsFloat -
    //      dataSet.FieldByName('valor_frete').AsFloat -
    //      dataSet.FieldByName('valor_seguro').AsFloat -
    //      dataSet.FieldByName('valor_icmsub').AsFloat;
    if vItem.dataSet.State = dsBrowse then
      vItem.dataset.Edit;
    vItem.dataSet.FieldByName('cst').AsString := '010';
    vItem.dataSet.FieldByName('chassi').AsString :=
      vTransNF.vItem.dataSet.FieldByName('CHASSIT').AsString;
    if vItem.vDetVeic.dataSet.State = dsBrowse then
      vItem.vDetVeic.dataset.Edit;

    if vItem.vDetVeic.vModV.abreModelos(
      vTransNF.vItem.dataSet.FieldByName('VERSAOT').AsInteger) then
      vItem.verificaModeloVeiculo(Self);
    dataSet.FieldByName('valor_prod').AsFloat :=
      vItem.vDetVeic.vModV.dataSet.FieldByName('vl_unitario_nf').AsFloat;
    vItem.vDetVeic.vModV.abreModelos;
    vItem.vDetVeic.dataSet.FieldByName('motor').AsString :=
      vTransNF.vItem.dataSet.FieldByName('motort').AsString;
    vItem.vDetVeic.dataSet.FieldByName('cor').AsString :=
      vTransNF.vItem.dataSet.FieldByName('cort').AsString;
    vItem.vDetVeic.dataSet.FieldByName('marca').AsString := 'HONDA';
    vItem.verificaCorDescricao;
    vItem.dataSet.FieldByName('valor_unitario').AsFloat :=
      vItem.vDetVeic.vModV.dataSet.FieldByName('vl_unitario_nf').AsFloat;
    vItem.dataSet.FieldByName('valor_total').AsFloat :=
      vItem.dataSet.FieldByName('valor_unitario').AsFloat;
    vItem.Post;
    vItem.vDetVeic.Post;

    if (dataSet.FieldByName('base_icmsub').AsFloat = 0) and
      (vItem.dataSet.FieldByName('base_icmsub').AsFloat > 0) then
      dataSet.FieldByName('base_icmsub').AsFloat :=
        vItem.dataSet.FieldByName('base_icmsub').AsFloat;
    if (dataSet.FieldByName('valor_icmsub').AsFloat = 0) and
      (vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0) then
      dataSet.FieldByName('valor_icmsub').AsFloat :=
        vItem.dataSet.FieldByName('valor_icmsub').AsFloat;

    result := True;
  except
    on e: Exception do begin
      Application.MessageBox(pchar('Erro ao montar a nota fiscal de Veiculo. Erro: ' + e.Message),
        'Atenção', MB_OK + MB_ICONERROR);
      registraErro('NUM NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('num_nf').AsString + ' adicionaNotaFiscalTransito ' + e.Message);
    end;
  end;
end;

