function TNFCab.enviarNotaFiscalEletronica(var AsendMail, AcomBol: Boolean): boolean;
var
  vTemp, tipoDANFe: string;
  AEnviarEPEC, AenvNFe, Aprint: Boolean;
  ACNFE: Integer;
begin
  Result := True;
  if dataSet.FieldByName('modelo_nf').AsString <> '55' then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select nf.tiponfe, nf.situacao_nfe, nf.cnfe, e.nfe_danfe_foremiss from notafiscal nf' +
    ' inner join empresa e on e.cod_empresa = nf.cod_empresa' +
    ' where nf.cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and nf.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (buscas.FieldByName('SITUACAO_NFE').AsString = sitAutorizada) or
    (buscas.FieldByName('SITUACAO_NFE').AsString = sitCancelada) then
    Exit;

  if GetVersaoNFe = vnf400 then
  begin
    AEnviarEPEC := (dataSet.FieldByName('nfe_tpemis').AsString = '4') and //epec
                   (Trim(dataSet.FieldByName('nfe_dpec_nregdpec').AsString) = ''); // sem protocolo de autorizacao epec
    if AEnviarEPEC then
      if vDadosIni.ShowConfirmacao('Contingência DPEC/EPEC selecionada' + sLineBreak + sLineBreak +
        'Evento EPEC será enviado' + sLineBreak +
        'Após regularização da situação você deverá enviar a NFe para a SEFAZ Origem' + sLineBreak + sLineBreak +
        'Confirma envio do envento?') <> ID_YES then
      begin
        Result := False;
        Exit;
      end;
  end
  else
  begin
    AEnviarEPEC := (vDadosIni.strIn(Trim(buscas.FieldByName('tiponfe').AsString), ['', 'DPEC'])) and
                   (Trim(buscas.FieldByName('nfe_danfe_foremiss').AsString) = 'DPEC');

    if AEnviarEPEC then
      AEnviarEPEC := vDadosIni.ShowConfirmacao('Contingência DPEC/EPEC ativada' + sLineBreak + sLineBreak +
        'Enviar Evento EPEC?' + sLineBreak +
        'Após regularização da situação você deverá enviar a NFe para a SEFAZ Origem') = IDYES;
  end;

  if buscas.FieldByName('cnfe').AsInteger = 0 then
  begin
    Randomize;
    ACNFE := 0;
    while ACNFE = 0 do
      ACNFE := Random(99999999);
    buscas.Close;
    buscas.SQL.Text := 'update notafiscal nf set nf.cnfe = :cnfe' +
      ' where nf.cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
      ' and nf.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.ParamByName('cnfe').AsInteger := ACNFE;
    buscas.ExecSQL;
    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;
  end;

  Aprint := True;
  Result := False;
  tipoDANFe := '';
  if AEnviarEPEC then
  begin
    Result := vCC_e.EnviarEPEC(dataSet.FieldByName('cod_nf').AsInteger, Aprint, AsendMail, AcomBol, tipoDANFe);
  end
  else
  begin
    if Assigned(FconfNFeForm) then
      AenvNFe := FconfNFeForm(Aprint, AsendMail, AcomBol, tipoDANFe)
    else
      AenvNFe := Application.MessageBox('Deseja Enviar NFe', 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES;
    if AenvNFe then
    begin
      SetLength(FarrayOfcod_nf, 1);
      FarrayOfcod_nf[High(FarrayOfcod_nf)] := get_cod_nf;

      if GetVersaoNFe = vnf400 then
      begin
        if dllNFe.AutorizarNFe([get_cod_nf]) then
        begin
          Result := True;
          dupNFe.gerarBoletosPendentes(get_cod_nf);
          if Aprint then
            if not dllNFe.nfe_imprimir([get_cod_nf], Aprint, False, '', tipoDANFe) then
              vDadosIni.ShowErro(dllNFe.retornoStr.Text);
        end
        else
        begin
          Result := False;
          vDadosIni.ShowErro(dllNFe.retornoStr.Text);
        end;
      end
      else
      begin
        vTemp := 'N';
        if dataSet.FieldByName('tipo_nf').AsString = 'V' then
          vTemp := 'S';
        result := EnviarNFeHW(pchar(vTemp), Pchar(vDadosIni.vBancoHW), strtoint(vDadosIni.codEmpresa),
          '4.0', dataSet.FieldByName('num_nf').AsInteger, 'NOTAFISCAL', '1',
          Pchar(dataSet.FieldByName('SERIE').asstring), PCHAR(vDadosIni.vNomeUsuario));
      end;
      buscas.Close;
      buscas.SQL.Text := 'select situacao_nfe, chave_nfe from notafiscal' +
        ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
      buscas.Open;
      Result := Trim(buscas.FieldByName('situacao_nfe').AsString) = sitAutorizada;

      if Result and (buscas.FieldByName('chave_nfe').AsString <> '') then
      begin
        Container.GetInstance().ErpFeaturesFactory.CreateRegistrarAjusteRedBenefPcUseCase()
          .Executar( RegistrarAjusteRedBenefPcUseCaseInput.Create(
            buscas.FieldByName('chave_nfe').AsString, vDadosIni.cod_empresa
          ));
        if AlertasDFeUtil.TryObterAlertasFormatado(buscas.FieldByName('chave_nfe').AsString, vTemp) then
          ShowAtencao(
            '-------------- ATENÇÃO --------------' + sLineBreak +
            'MENSAGEM DA SEFAZ PARA O EMISSOR:' + sLineBreak +
            vTemp
          );
      end;

      buscas.Close;

      _atualizarSituacaoPedidos('Finalizado', False, True);
      try
        dataSet.RefreshRecord;
      except
      end;

      if Assigned(FprintEtqDanfe) then
        FprintEtqDanfe;
    end;
  end;
end;

function TNFCab.incluirLigacaoNfRemessaVendaForaEstab: Boolean;
begin
  Result := True;
  if get_status = stsFechada then
    Exit;
  if dataSet.FieldByName('COD_NF_REM_VFE').AsInteger = 0 then
    Exit;

  Result := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vItem.dataSet.FieldByName('NITEM_REM_VFE').AsInteger > 0 then
    begin
      buscas.Close;
      buscas.SQL.Text := 'INSERT INTO NOTAFISCAL_ITEM_VFE (COD_NF, COD_EMPRESA, NITEM, COD_NF_VFE, NITEM_NF_VFE, QUANTIDADE_NF_VFE)' +
        'VALUES (:COD_NF, :COD_EMPRESA, :NITEM, :COD_NF_VFE, :NITEM_NF_VFE, :QUANTIDADE_NF_VFE)';
      buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF_REM_VFE').AsInteger;
      buscas.ParamByName('NITEM').AsInteger := vItem.dataSet.FieldByName('NITEM_REM_VFE').AsInteger;
      buscas.ParamByName('COD_NF_VFE').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
      buscas.ParamByName('NITEM_NF_VFE').AsInteger := vItem.dataSet.FieldByName('NITEM').AsInteger;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('QUANTIDADE_NF_VFE').AsFloat := vItem.dataSet.FieldByName('QUANTIDADE').AsFloat;
      buscas.ExecSQL;

    end;
    vItem.dataSet.Next;
  end;
  Result := True;
end;

function TNFCab.nfe_autorizacao(AprintAfter, AsendMail, AcomBol, AonlySel: Boolean;
  tipoDANFe: string): boolean;
var
  AstrEnvio, AstrPrint, AstrMail, AstrMessage: string;
  Acod: Integer;
  I: Integer;
begin
  AstrEnvio := '';
  AstrPrint := '';
  AstrMail  := '';

  if not AonlySel then
  begin
    SetLength(FarrayOfcod_nf, 1);
    FarrayOfcod_nf[High(FarrayOfcod_nf)] := get_cod_nf;
  end
  else
    SetArrayOfcod_nf;

  if not dllNFe.AutorizarNFe(FarrayOfcod_nf)  then
    AstrEnvio := dllNFe.retornoStr.Text;

  if AsendMail then
    if not dllNFe.nfe_email(FarrayOfcod_nf, False, False, True, AcomBol, '', '') then
     AstrMail := dllNFe.retornoStr.Text;

  if AprintAfter then
    if not dllNFe.nfe_imprimir(FarrayOfcod_nf, True, False, '', tipoDANFe) then
     AstrPrint := dllNFe.retornoStr.Text;

  AstrMessage := '';
  if AstrEnvio <> '' then
    AstrMessage := 'Houve problemas durante o processo de autorização' + sLineBreak + sLineBreak + AstrEnvio + sLineBreak + sLineBreak;
  if AstrMail <> '' then
    AstrMessage := AstrMessage + 'Envio do email' + sLineBreak + sLineBreak + AstrMail + sLineBreak + sLineBreak;
  if AstrPrint <> '' then
    AstrMessage := AstrMessage + 'Impressão' + sLineBreak + sLineBreak + AstrPrint + sLineBreak + sLineBreak;

  if AstrMessage <> '' then
    vDadosIni.ShowErro(AstrMessage);

  dataSet.Refresh;
end;

