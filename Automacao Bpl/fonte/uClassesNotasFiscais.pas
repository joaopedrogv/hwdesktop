            vItem.dataSet.FieldByName('ncm').AsString := vIt2Nf.FieldByName('ncm').AsString;
            vItem.dataSet.FieldByName('quantidade').AsFloat :=
              vIt2Nf.FieldByName('quantidade').AsFloat;
            vItem.dataSet.FieldByName('valor_unitario').AsFloat :=
              vIt2Nf.FieldByName('valor_unitario').AsFloat;
            vItem.dataSet.FieldByName('valor_total').AsFloat :=
              vIt2Nf.FieldByName('valor_total').AsFloat;
            vItem.dataSet.FieldByName('aliq_icm').AsFloat := vIt2Nf.FieldByName('aliq_icm').AsFloat;
            vItem.dataSet.FieldByName('base_icm').AsFloat := vIt2Nf.FieldByName('base_icm').AsFloat;
            vItem.dataSet.FieldByName('valor_icm').AsFloat :=
              vIt2Nf.FieldByName('valor_icm').AsFloat;
            vItem.dataSet.FieldByName('aliq_icmsub').AsFloat :=
              vIt2Nf.FieldByName('aliq_icmsub').AsFloat;
            vItem.dataSet.FieldByName('base_icmsub').AsFloat :=
              vIt2Nf.FieldByName('base_icmsub').AsFloat;
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat :=
              vIt2Nf.FieldByName('valor_icmsub').AsFloat;
            vItem.dataSet.FieldByName('valor_icm_stdes').AsFloat :=
              vIt2Nf.FieldByName('valor_icm_stdes').AsFloat;
            vItem.dataSet.FieldByName('aliq_ipi').AsFloat := vIt2Nf.FieldByName('aliq_ipi').AsFloat;
            vItem.dataSet.FieldByName('base_ipi').AsFloat := vIt2Nf.FieldByName('base_ipi').AsFloat;
            vItem.dataSet.FieldByName('valor_ipi').AsFloat :=
              vIt2Nf.FieldByName('valor_ipi').AsFloat;
            vItem.dataSet.FieldByName('perc_red_prod').AsFloat :=
              vIt2Nf.FieldByName('perc_red_prod').AsFloat;
            vItem.dataSet.FieldByName('perc_red_ipi').AsFloat :=
              vIt2Nf.FieldByName('perc_red_ipi').AsFloat;
            vItem.dataSet.FieldByName('perc_red_prod_sub').AsFloat :=
              vIt2Nf.FieldByName('perc_red_prod_sub').AsFloat;
            vItem.dataSet.FieldByName('mva').AsFloat := vIt2Nf.FieldByName('mva').AsFloat;
//            vItem.dataSet.FieldByName('vlisento').AsFloat := vIt2Nf.FieldByName('vlisento').AsFloat;
//            vItem.dataSet.FieldByName('vloutras').AsFloat := vIt2Nf.FieldByName('vloutras').AsFloat;
//            vItem.dataSet.FieldByName('vln_trib').AsFloat := vIt2Nf.FieldByName('vln_trib').AsFloat;
            vItem.dataSet.FieldByName('aliq_icm_simples').AsFloat :=
              vIt2Nf.FieldByName('aliq_icm_simples').AsFloat;
            vItem.dataSet.FieldByName('base_icm_simples').AsFloat :=
              vIt2Nf.FieldByName('base_icm_simples').AsFloat;
            vItem.dataSet.FieldByName('valor_icm_simples').AsFloat :=
              vIt2Nf.FieldByName('valor_icm_simples').AsFloat;
            vItem.dataSet.FieldByName('aliq_iss').AsFloat := vIt2Nf.FieldByName('aliq_iss').AsFloat;
            vItem.dataSet.FieldByName('base_iss').AsFloat := vIt2Nf.FieldByName('base_iss').AsFloat;
            vItem.dataSet.FieldByName('valor_iss').AsFloat :=
              vIt2Nf.FieldByName('valor_iss').AsFloat;
            vItem.dataSet.FieldByName('peso_b').AsFloat := vIt2Nf.FieldByName('peso_b').AsFloat;
            vItem.dataSet.FieldByName('peso_l').AsFloat := vIt2Nf.FieldByName('peso_l').AsFloat;
            vItem.dataSet.FieldByName('permitir_desconto').AsString :=
