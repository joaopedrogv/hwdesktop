function TNFItem.TestarCSOSN(vcsosn, vcampo: string;
  AShowMessage: Boolean): boolean;
var
  temp: string;
begin
  try
    Result := true;
    if vDadosIni.vEmp.vRegime <> 'SIMPLES' then
      exit;
    Result := false;
    if vcsosn = '' then
      raiseExceptionCreate('CSOSN Não Informado.' + chr(13) + 'Campo Requerido.', vcampo)
    else if (vcsosn <> '101') and (vcsosn <> '102') and (vcsosn <> '103') and
      (vcsosn <> '201') and (vcsosn <> '202') and (vcsosn <> '203') and
      (vcsosn <> '300') and (vcsosn <> '400') and (vcsosn <> '500') and
      (vcsosn <> '900') then
      raiseExceptionCreate('CSOSN Informado Inválido.' + chr(13) +
        'Valores válidos: 101, 102, 103, 201, 202, 203, 400, 500 e 900', vcampo)
    else
      Result := True;
  except on e: exception do begin
      Result := False;
      if AShowMessage then      
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFItem.TestarCSOSN(vcsosn, vcst, vCampo: string;
  AShowMessage: Boolean): boolean;
var
  temp: string;
begin
  try
    Result := true;
    if vDadosIni.vEmp.vRegime <> 'SIMPLES' then
      exit;

    if vrDadosItem.cst_icm_mono(vcst) then
      Exit;

    Result := TestarCSOSN(vcsosn, vCampo, AShowMessage);

  except on e: exception do begin
      Result := False;
      if AShowMessage then      
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFItem.TestarCST(vcst: string;
  AShowMessage: Boolean): boolean;
var
  AOrigem, ACST: string;
begin
  AOrigem := Trim(Copy(Trim(vcst), 1, 1));
  ACST := Trim(Copy(Trim(vcst), 2, 2));
  try
    if (AOrigem = '') or (ACST = '') then
      raiseExceptionCreate('CST ICMS não informado ou inválido', '');

    if not vDadosIni.strIn(AOrigem, ['0', '1', '2', '3', '4', '5', '6', '7', '8']) then
      raiseExceptionCreate('Primeiro dígito do CST ICMS incorreto' + sLineBreak + 'Valores válidos: 0, 1, 2, 3, 4, 5, 6, 7 e 8', '');

    if not vDadosIni.strIn(ACST, ['00', '02', '10', '15', '20', '30', '40', '41', '50', '51', '53', '60', '61', '70', '90']) then
      raiseExceptionCreate('Segundo e terceiro dígito do CST ICMS incorreto' + sLineBreak + 'Valores válidos: 00, 02, 10, 15, 20, 30, 40, 41, 50, 51, 53, 60, 61, 70 e 90', '');

    Result := True;
  except on E: Exception do
    begin
      Result := False;
      if AShowMessage then
        vDadosIni.ShowErro(e.Message);
    end;
  end;
  exit;

  TestarCst := true;
  if vcst = '' then
  begin
    Application.MessageBox('Cst ICMS Não Informado.' + chr(13) + 'Campo Requerido.', 'Aviso', MB_OK +
      MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if copy(vcst, 1, 1) = '' then
  begin
    Application.MessageBox('Primeiro Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if pos(copy(vcst, 1, 1), '012345678') = 0 then
  begin
    Application.MessageBox('Primeiro Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if copy(vcst, 2, 1) = '' then
  begin
    Application.MessageBox('Segundo Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if pos(copy(vcst, 2, 1), '012345679') = 0 then
  begin
    Application.MessageBox('Segundo Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if copy(vcst, 3, 1) = '' then
  begin
    Application.MessageBox('Terceiro Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end
  else if pos(copy(vcst, 3, 1), '01') = 0 then
  begin
    Application.MessageBox('Terceiro Digito do CST ICMS Incorreto.',
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    TestarCst := false;
  end;
end;

function TNFItem.TestarCSTIPI(vcst, entSaida: string): boolean;
begin
  try
    Result := True;
    if entSaida = 'S' then
    begin
      if (copy(vcst,1,1) = '9') and (vcst <> '99') then
        raiseExceptionCreate('Primeiro dígito inválido','');
      if (copy(vcst,1,1) <> '5') and (copy(vcst,1,1) <> '9') then
        raiseExceptionCreate('Primeiro dígito inválido. Deve ser 5 ou 9','');
      if not (copy(vcst,1,1)[1] in (['0','1','2','3','4','5','9'])) then
        raiseExceptionCreate('Segundo Dígito inválido. Deve ser de 0 a 5 ou 9','');
    end
    else
    begin
      if (copy(vcst,1,1) = '4') and (vcst <> '49') then
        raiseExceptionCreate('Primeiro dígito inválido','');
      if (copy(vcst,1,1) <> '0') and (copy(vcst,1,1) <> '4') then
        raiseExceptionCreate('Primeiro dígito inválido. Deve ser 0 ou 4','');
      if not (copy(vcst,1,1)[1] in (['0','1','2','3','4','5','9'])) then
        raiseExceptionCreate('Segundo Dígito inválido. Deve ser de 0 a 5 ou 9','');
    end;
  except
    on e: exception do begin
      result := False;
      Application.MessageBox(pchar(e.Message),'Atenção',0+64);
    end;
  end;
end;


