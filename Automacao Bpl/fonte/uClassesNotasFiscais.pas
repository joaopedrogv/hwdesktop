      dataSet.FieldByName('COD_CLIENTE').AsInteger := buscas.FieldByName('COD_CLIENTE').AsInteger;
      vClFor.selecionaClFor;
      dataSet.FieldByName('COD_COND_PAG').AsInteger := buscas.FieldByName('COD_COND_PAG').AsInteger;
      dataSet.FieldByName('COD_VENDEDOR').AsInteger := buscas.FieldByName('COD_VENDEDOR').AsInteger;
      dataSet.FieldByName('TIPO_EMISSAO').AsString := '2';
      dataSet.FieldByName('COD_NF_REF').AsInteger := buscas.FieldByName('COD_NF').AsInteger;
      dataSet.FieldByName('NUM_NF_COMPL').AsInteger := buscas.FieldByName('NUM_NF').AsInteger;
