  if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
  begin
    //Verifica Cupons
    vSped.vC110.adicionaInfComplCupom(Self);
    //Verifica De Olho no Imposto
    vSped.vC110.adicinarInfComplDeOlhoNoImposto(Self);
    //Verofica desoneracao
    vSped.vC110.adicionaInfComplDesoneracaoICMS(Self);
    vSped.vC110.adicionaInfComplDesoneracaoPISCOFINS(Self);
    vSped.vC110.adicionaInfComplPorOperacaoFiscalId(Self);
    vSped.vC110.adicionaInfComplRetencaoFederal(Self);
