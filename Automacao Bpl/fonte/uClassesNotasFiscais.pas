function TNFCab.AjustaCSOSN(CSOSN: string; AContribuinte: Boolean): string;
begin
  if vDadosIni.strIn( CSOSN, ['101', '102']) then
    CSOSN := vDadosIni.IfThen(AContribuinte, '101', '102')
  else if vDadosIni.strIn( CSOSN, ['201', '202']) then
    CSOSN := vDadosIni.IfThen(AContribuinte, '201', '202');

  Result := CSOSN;
end;

