procedure TNFCab.imprimirResumo;
var
  vRel: TRelRDPrint;
  vTotal: Currency;
  vTemp: string;
  quociente, resto, z, j: Integer;
  procedure imprimeItem;
  begin
    vRel.vLinha := vRel.vLinha + 1;
    vRel.vRdP.imp(vRel.vLinha, 001,
      vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
      vDadosIni.StrZero(vItem.dataSet.FieldByName('grupo_prod').AsInteger, 5) + ' ' +
      vItem.dataSet.FieldByName('cod_prod').AsString + ' ' +
      copy(vItem.dataSet.FieldByName('num_fab_prod').AsString, 1, 14)); //29 //1
    vRel.vRdP.imp(vRel.vLinha, 031, vItem.dataSet.FieldByName('codigo_nop').AsString); //4 // 31
    vRel.vRdP.imp(vRel.vLinha, 036, copy(vItem.dataSet.FieldByName('descricao_item').AsString, 1,
      25)); //25 // 36
    vRel.vRdP.imp(vRel.vLinha, 062, vDadosIni.AlnDir(
      Format('%0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais) + 'f',
      [vItem.dataSet.FieldByName('valor_unitario').AsFloat]), 10)); //10 // 62
    vRel.vRdP.imp(vRel.vLinha, 073, vDadosIni.AlnDir(
      Format('%0.3f', [vItem.dataSet.FieldByName('quantidade').AsFloat]), 8)); //8 //73
    vRel.vRdP.imp(vRel.vLinha, 082, vDadosIni.AlnDir(
      Format('%0.2f', [vItem.dataSet.FieldByName('valor_total').AsFloat]), 12)); //12 //82
    vRel.vRdP.imp(vRel.vLinha, 095, vDadosIni.AlnDir(
      Format('%0.2f', [vItem.dataSet.FieldByName('aliq_icm').AsFloat]), 5)); //5 //95
    vRel.vRdP.imp(vRel.vLinha, 101, vDadosIni.AlnDir(
      Format('%0.2f', [vItem.dataSet.FieldByName('aliq_ipi').AsFloat]), 5)); //5 //101
    vRel.vRdP.imp(vRel.vLinha, 107, vItem.dataSet.FieldByName('CST').AsString); //3 //107
    if vItem.dataSet.FieldByName('mnf').asstring <> 'S' then
    begin
      vRel.vRdP.imp(vRel.vLinha, 111, vDadosIni.AlnDir(
        Format('%0.4f', [vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat]), 10)); //10 /110
      vRel.vRdP.imp(vRel.vLinha, 122, vDadosIni.AlnDir(
        Format('%0.2f', [vItem.QtdeCalcCusto *
        vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat]), 12)); //10 //110
      vTotal := vTotal + (vItem.QtdeCalcCusto *
        vItem.dataSet.FieldByName('prec_cus_cnt').AsFloat);
    end
    else
    begin
      vRel.vRdP.imp(vRel.vLinha, 111, vDadosIni.AlnDir(
        Format('%0.4f', [vItem.dataSet.FieldByName('pr_cusc_prod').AsFloat]), 10)); //10 /110
      vRel.vRdP.imp(vRel.vLinha, 122, vDadosIni.AlnDir(
        Format('%0.2f', [vItem.QtdeCalcCusto *
        vItem.dataSet.FieldByName('pr_cusc_prod').AsFloat]), 12)); //10 //110
      vTotal := vTotal + (vItem.QtdeCalcCusto *
        vItem.dataSet.FieldByName('pr_cusc_prod').AsFloat);
    end;
  end;
begin

  if not vDadosIni.PesqPros('NF0022', 'IMPRIMIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    if not notaFechada then
    begin
      if dataSet.State in [dsEdit, dsInsert] then
        dataSet.FieldByName('ANTEC_TRIB').AsString := '';
      CalcularCustoDosProdutos(opdResumo);
    end;
    somaTotaisNF;
    if not notaFechada then
    begin
//      CalcularCustoDosProdutos;
      try
        vItem.montaDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
        vItem.setDadosDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
      finally
        vItem.dataSet := TClientDataSet(DtmNF.cdsINf);
      end;

    end
    else
      FCalculoImposto.vValorICMSRecomposicao := vItem.fsum('icms_recomposicao', False);

    vRel := TRelRDPrint.create;
    vRel.vRdP.TamanhoQteLinhas := 66;
    vRel.vRdP.TamanhoQteColunas := 150;
    vRel.vRdP.TitulodoRelatorio := 'Resumo da Nota Fiscal de Entrada';
    vDadosIni._LimparVarSendEmail;
    vRel.vRdP.OnSendMail := vDadosini._SendMailRdPrint;
    vRel.vRdP.OpcoesPreview.Remalina := True;
    vRel.vRdP.OpcoesPreview.CaptionPreview := 'Pré visualização';
    vRel.vRdP.OpcoesPreview.Preview := True;
    vRel.vRdP.CaptionSetup := 'Configurações';
    vRel.vRdP.FonteTamanhoPadrao := S17cpp;
    vRel.vRdP.Abrir;
    try
      vRel.novaPaginaResumo(Self);
      vTotal := 0;
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        imprimeItem;
        if vRel.vLinha >= 65 then
        begin
          vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));
          vRel.vRdP.Novapagina;
          vRel.novaPaginaResumo(Self);
        end;
        vItem.dataSet.Next;
      end;
      if vRel.vLinha >= 62 then
      begin
        vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));
        vRel.vRdP.Novapagina;
        vRel.novaPaginaResumo(Self);
      end;

      vRel.vLinha := vRel.vLinha + 1;
      vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));
      vRel.vLinha := vRel.vLinha + 1;
      vRel.vRdP.imp(vRel.vLinha, 1, 'VALOR TOTAL DE PRODUTOS');
      vRel.vRdP.imp(vRel.vLinha, 121, vDadosIni.alndir(format('%n', [vTotal]), 15));
      vRel.vLinha := vRel.vLinha + 1;
      vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));

      buscas.Close;
      buscas.SQL.Text := ' select ca.data_ent_ctp ,' +
        ' ca.n_doc_ctp, ca.data_venc_ctp, ca.valor_ctp from contas_a_pagar ca' +
        ' where ca.num_nota_nfe = :num_nf and ca.serie = :serie and ca.' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') +
        ' = :cod_empresa and cod_forn_nfe = :cod_forn_nfe';
      buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
      buscas.ParamByName('serie').AsString := dataSet.FieldByName('serie').AsString;
      buscas.ParamByName('cod_empresa').AsInteger := dataSet.FieldByName('cod_empresa').AsInteger;
      buscas.ParamByName('cod_forn_nfe').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
      buscas.Open;
      buscas.FetchAll;

      if not buscas.IsEmpty then
    	begin
        quociente := buscas.RecordCount div 3;
        resto := buscas.RecordCount mod 3;
        if vRel.vLinha + quociente + vDadosIni.IfThen(resto > 0, 1, 0) + 1 >= 62 then
        begin
          vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));
          vRel.vRdP.Novapagina;
          vRel.novaPaginaResumo(Self);
        end;
        buscas.First;
        vRel.vLinha := vRel.vLinha + 1;
        vRel.vRdP.imp(vRel.vLinha, 001, 'FATURAS:');
        z := 0;
        j := 0;
        while not buscas.Eof do
        begin
          j := j + 1;
          z := z + 1;
          if (z = 1) then
          begin
            vRel.vRdP.imp(vRel.vLinha, 011, buscas.FieldByName('n_doc_ctp').AsString); //016
            vRel.vRdP.imp(vRel.vLinha, 023, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc_ctp').AsDateTime)); //031
            vRel.vRdP.imp(vRel.vLinha, 030, vDadosIni.alndir(format('%n', [buscas.FieldByName('valor_ctp').AsCurrency]), 15)); // 044
            if (j = buscas.RecordCount) then
	            vRel.vLinha := vRel.vLinha + 1;
          end
          else if (z = 2) then
          begin
            vRel.vRdP.imp(vRel.vLinha, 054, buscas.FieldByName('n_doc_ctp').AsString);
            vRel.vRdP.imp(vRel.vLinha, 067, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc_ctp').AsDateTime));
            vRel.vRdP.imp(vRel.vLinha, 074, vDadosIni.alndir(format('%n', [buscas.FieldByName('valor_ctp').AsCurrency]), 15));
            if (j = buscas.RecordCount) then
	            vRel.vLinha := vRel.vLinha + 1;
          end
          else
          begin
            vRel.vRdP.imp(vRel.vLinha, 098, buscas.FieldByName('n_doc_ctp').AsString);
            vRel.vRdP.imp(vRel.vLinha, 111, FormatDateTime('dd/mm/yyyy', buscas.FieldByName('data_venc_ctp').AsDateTime));
            vRel.vRdP.imp(vRel.vLinha, 118, vDadosIni.alndir(format('%n', [buscas.FieldByName('valor_ctp').AsCurrency]), 15));
            vRel.vLinha := vRel.vLinha + 1;
          	z := 0;
          end;

          buscas.Next;
        end;
        vRel.vRdP.imp(vRel.vLinha, 1, vDadosIni.replicate('=', 137));
      end;

      vRel.vRdP.Fechar;
    except
      vRel.vRdP.Abortar;
    end;
  finally
    {if (not notaFechada) and (dataSet.FieldByName('ANTEC_TRIB').AsString = 'S') then
    begin
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        vTemp := copy(vItem.dataSet.FieldByName('cst').AsString, 2, 1);
        if (vTemp = '1') or (vTemp = '6') or (vTemp = '3') or (vTemp = '7') then
        else
        begin
          vItem.dataSet.Edit;
          vItem.dataSet.FieldByName('base_icmsub').AsFloat := 0;
          vItem.dataSet.FieldByName('valor_icmsub').AsFloat := 0;
          vItem.dataSet.FieldByName('valor_icm_stdes').AsFloat := 0;
          vItem.dataSet.Post;
        end;
        vItem.dataSet.Next;
      end;
    end;}
  end;
end;

