function TNFCab.incluirNf(ATipoNota: TipoNfEmum; prodServ, entradaSaida: char): boolean;
var
  vDataeHora: TDateTime;
  I: Integer;
  dFormat: string;
begin
  try
    if (not vDadosIni.vSistemasUsuario.vSisVeiculos) or (not
      vDadosIni.vSistemasUsuario.vSisAutomacao) then
    begin
      if (not vDadosIni.vSistemasUsuario.vSisAutomacao) and (ATipoNota = tnfProdutos) then
        raiseExceptionCreate('Nota Fiscal de Produtos/Serviços não permitido para este usuário',
          '');
      if (not vDadosIni.vSistemasUsuario.vSisVeiculos) and (ATipoNota = tnfVeiculos) then
        raiseExceptionCreate('Nota Fiscal de Veículo não permitido para este usuário', '');
    end;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;
  end;
  if entradaSaida = 'E' then
  begin
    if ATipoNota = tnfProdutos then
      if not vDadosIni.PesqPros('NF0003', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfProdutos then
      if not vDadosIni.PesqPros('NF0004', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfOutras then
      if not vDadosIni.PesqPros('NF0005', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfDespesas then
      if not vDadosIni.PesqPros('NF0006', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfServicos then
      if not vDadosIni.PesqPros('NF0173', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
  end
  else
  begin
    if ATipoNota = tnfProdutos then
      if not vDadosIni.PesqPros('NF0007', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfVeiculos then
      if not vDadosIni.PesqPros('NF0008', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
    if ATipoNota = tnfOutras then
      if not vDadosIni.PesqPros('NF0009', 'INCLUIR', '', 'NOTAFISCAL', '',
        buscas, True) then
        exit;
  end;

  if not dataSet.Active then
    montaSelect('select * from notafiscal where cod_nf = 0 and cod_empresa = 0 and cod_nf = 0');

//  if not dataSet.Active then
//    montaSelect('select * from notafiscal where cod_nf = 0');
  vDataeHora := vDadosIni.getDataHoraBanco(buscas);
  FDataDoDia := DateOf(vDataeHora);
  FDadosNFDevolvida := '';
  fValorNotaAlterado := False;
//  FConfigFrete := vDadosIni.getConfSisBlob('nf_s_config_frete', buscas);
  if inherited insert then
  begin
    FConfig.ExecutarLeitura(entradaSaida);
    FConfig.versao_calc := IfThen(ATipoNota <> tnfProdutos, 1, FConfig.versao_calc);

    Result := True;
    vStatusFechada := False;
    vAcao := 'INCLUIR';
//    vTempAuditoria := 'NF NUM/SERIE: ' + vDadosIni.StrZero(dataSet.FieldByName('NUM_NF').AsInteger,
//      7) +
//      '/' + Trim(dataSet.FieldByName('SERIE').AsString);
    dataSet.FieldByName('cod_nf').AsString := '0';
    dataSet.FieldByName('num_nf').AsString := '0';
    dataSet.FieldByName('serie').AsString := '';
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('natureza_nf').AsString := entradaSaida;
    dataSet.FieldByName('tipo_nf').AsString := TipoNfEmumStr[ATipoNota];
    if Trim(dataSet.FieldByName('tipo_nf').AsString) = 'S' then
      dataSet.FieldByName('somenserv').AsString := 'S';
    dataSet.FieldByName('data_contabil').AsDateTime := FDataDoDia;
    dataSet.FieldByName('hora_emissao').AsString := FormatDateTime('HH:MM:SS', Time);
    dataSet.FieldByName('emissao_propria').AsString := 'S';
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      dataSet.FieldByName('data_ent_saida').AsDateTime := FDataDoDia;
      dataSet.FieldByName('hora_ent_saida').AsDateTime := TimeOf(vDataeHora);
      dataSet.FieldByName('emissao_propria').AsString := 'N';
    end;
    dataSet.FieldByName('data_lanc').AsDateTime := FDataDoDia;
    dataSet.FieldByName('cod_vendedor').AsInteger := vDadosIni.vCodUsuario;
    //    dataSet.FieldByName('aliq_icm').AsFloat := vDadosIni.vEmp.vAliqPadrao;
    dataSet.FieldByName('DA').AsString := 'N';
    dataSet.FieldByName('FRETE_F_NFE').AsString := 'N';
    //dataSet.FieldByName('FRETE_BASE_ICM').AsString := 'N';
    dataSet.FieldByName('FRETE_BASE_IPI').AsString := 'N';
    dataSet.FieldByName('IPI_BASE_ICM').AsString := 'N';
    dataSet.FieldByName('valor_desc').AsFloat := 0;
    dataSet.FieldByName('TIPO_DESCONTO').AsString := 'R';
    dataSet.FieldByName('TIPO_SEGURO').AsString   := 'R';
    dataSet.FieldByName('TIPO_OUTDESP').AsString  := 'R';
    dataSet.FieldByName('TIPO_FRETE').AsString    := 'R';
    dataSet.FieldByName('TIPO_DESPPF').AsString   := 'R';
    dataSet.FieldByName('cod_usuario').AsInteger := vDadosIni.vCodUsuario;
    dataSet.FieldByName('TIPO_EMISSAO').AsString := '1';
    dataSet.FieldByName('cod_cliente').AsInteger := 0;
    dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'S';
    dataSet.FieldByName('TOTAIS_COM_DESON').AsString := IfThen(fequals('natureza_nf', 'S'), 'S');
    dataSet.FieldByName('NFE_INDPRES').AsString := FConfig.Conf_Geral.nf_campos_default_indicadordepresenca(fstr('natureza_nf'));
    dataSet.FieldByName('INDINTERMED').AsString := '0';
    dataSet.FieldByName('IMPORT_XML').AsString := strDataVersion;
    dataSet.FieldByName('CONF_ISUF').AsString := '';
    dataSet.FieldByName('NFE_VERSAO').AsString := strVer400;
    dataSet.FieldByName('NFE_TPEMIS').AsString := IfThen(vDadosIni.vEmp.vNfe.danfeFormaEmissao = 'SVC', '6', '1');
    dataSet.FieldByName('NFE_TPAMB').AsString := IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente = 'Produção', '1', '2');
    dataSet.FieldByName('CMUNFG').AsInteger   := vDadosIni.vEmp.vNfe.ibgeCodCidade;
    dataSet.FieldByName('TPIMP').AsInteger := IndexText(vDadosIni.vEmp.vNfe.danfeTipo, FormatoImpressaoDANFeEnumStr); // Obtem o indice correspondente
    dataSet.FieldByName('TPIMP').AsInteger := IfThen( fint('tpimp') = -1, Ord(fidRetrato));                // Caso valor seja inválido

    vClFor.CodCliente := 0;
    checkConfigBcPisCofins;

    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    begin
      if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
      begin
        dataSet.FieldByName('crt').AsString := '1';
//        dataSet.FieldByName('aliq_icm').AsFloat := vDadosIni.vEmp.vAliqSimplesICM;
        dataSet.FieldByName('aliq_icm_simples').AsFloat := vDadosIni.vEmp.vAliqSimplesICM;
      end
      else if pos('SIMPLES / EXCESSO', vDadosIni.vEmp.vRegime) > 0 then
        dataSet.FieldByName('crt').AsString := '2'
      else
        dataSet.FieldByName('crt').AsString := '3';
      Fdespesa := false;

      if (vDadosIni.vEmp.vNfe.modeloNF = '55') and (vDadosIni.vEmp.vNfe.usarServico <> 'S') and
        (ATipoNota = tnfProdutos) then
      begin
        Fproduto := (prodServ = 'P') or (prodServ = 'A') or ((vDadosIni.vEmp.vNfe.modeloNFServico =
          '') or
          (vDadosIni.vEmp.vNfe.modeloNFServico = '0') or (vDadosIni.vEmp.vNfe.serieServico = 0));
        Fservico := ((prodServ = 'S') or (prodServ = 'A')) and (vDadosIni.vEmp.vNfe.modeloNFServico
          <> '') and
          (vDadosIni.vEmp.vNfe.modeloNFServico <> '0') and (vDadosIni.vEmp.vNfe.serieServico <> 0);
        Fveiculo := false;
        Foutras := false;
        if (Fservico) then
        begin
          dataSet.FieldByName('modelo_nf').AsString := vDadosIni.vEmp.vNfe.modeloNFServico;
          dataSet.FieldByName('serie').AsString := IntToStr(vDadosIni.vEmp.vNfe.serieServico);
          dataSet.FieldByName('codigo_nop').AsFloat := vDadosIni.vEmp.vCfopPadraoServ;
        end
        else
        begin
          dataSet.FieldByName('modelo_nf').AsString := vDadosIni.vEmp.vNfe.modeloNF;
          dataSet.FieldByName('serie').AsString := IntToStr(vDadosIni.vEmp.vSubSerieNotaFiscal);
          dataSet.FieldByName('codigo_nop').AsFloat := vDadosIni.vEmp.vCfopPadraoProd;
        end;
      end
      else
      begin
        Fproduto := ATipoNota = tnfProdutos;
        Fservico := ATipoNota = tnfProdutos;
