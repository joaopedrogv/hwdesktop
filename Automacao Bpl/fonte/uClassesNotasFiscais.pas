function TNFCab.TestarDetalhesVeiculo: boolean;
begin
  Result := False;

  if (vDadosIni.vEmp.vVersaoVeiculos <> '4') or (dataSet.FieldByName('tipo_nf').AsString <> 'V') then
  begin
   Result := true;
   exit;
  end;

    vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsString :=
    vItem.dataSet.FieldByName('cod_estmoto').AsString;
    buscas.Close;
    buscas.SQL.Text := 'select tipv_veiculo, case when alt_est = ''N'' then ''N'' else ''S'' end alt_est from nat_op where codigo_nop = :codigo_nop';
    buscas.ParamByName('codigo_nop').AsFloat := vItem.dataSet.FieldByName('codigo_nop').AsFloat;
    buscas.Open;
    if not buscas.FieldByName('tipv_veiculo').IsNull then
    begin
       vItem.vDetVeic.dataSet.FieldByName('tipv_veiculo').AsString := buscas.FieldByName('TIPV_VEICULO').AsString;
       if not (vItem.dataSet.State in [dsInsert, dsEdit]) then
         vItem.dataSet.Edit;
       vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := buscas.FieldByName('ALT_EST').AsString;
       vItem.dataSet.FieldByName('tipv_veiculo').AsString :=  vItem.vDetVeic.dataSet.FieldByName('tipv_veiculo').AsString;         end
    else
    begin
      vItem.vDetVeic.dataSet.FieldByName('tipv_veiculo').Value := Null;
      if not (vItem.dataSet.State in [dsInsert, dsEdit]) then
        vItem.dataSet.Edit;
      vItem.dataSet.FieldByName('altera_estoque_cfop').Value := Null;
      vItem.dataSet.FieldByName('tipv_veiculo').Value := Null;
    end;

   if trim(vItem.vDetVeic.dataSet.FieldByName('tipv_veiculo').AsString) = '' then
     raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'Tipo de Operação do Veículo não definido no cadastro de CFOP'+sLineBreak+ 'Por favor entre no cadastro de CFOP e verificar', '');

   if (dataSet.FieldByName('n_comando').AsInteger > 0) then
   begin
     if dataSet.FieldByName('CODIGO_NOP').AsFloat <> vItem.dataSet.FieldByName('codigo_nop').AsFloat then
       raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'CFOP do Item não pode ser diferente do CFOP do cabeçalho'+sLineBreak+ 'Por favor entre no cadastro de CFOP e verificar', '');

     buscas.Close;
     buscas.SQL.Text := 'select n_comando, cod_estmoto, tipv_veiculo, tipo, tipo_venda_v from com_fat  ' +
      ' where n_comando = :n_comando and cod_empresa = :cod_empresa ';
     buscas.ParamByName('N_COMANDO').AsInteger := dataSet.FieldByName('n_comando').AsInteger;
     buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
     buscas.Open;

    vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger := buscas.FieldByName('cod_estmoto').AsInteger;
    vItem.dataSet.FieldByName('cod_estmoto').AsInteger := buscas.FieldByName('cod_estmoto').AsInteger;

     if (buscas.FieldByName('tipv_veiculo').AsString <> vItem.dataSet.FieldByName('tipv_veiculo').AsString) then
       if trim(buscas.FieldByName('TIPO').AsString) = 'CFT' then
         raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'Tipo de Operação Veículo definido no Cadastro de CFOP da Nota Fiscal é diferente do tipo de operação do Comando'+sLineBreak+ 'Por favor verificar', '')
       else
         raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'Tipo de Operação Veículo definido no Cadastro de CFOP da Nota Fiscal é diferente do tipo de operação do Contrato'+sLineBreak+ 'Por favor verificar', '');

    if trim(buscas.FieldByName('TIPO_VENDA_V').AsString) <> trim(vItem.vDetVeic.dataSet.FieldByName('TIPO_VENDA').AsString) then
      if trim(buscas.FieldByName('TIPO').AsString) = 'CFT' then
         raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'Tipo de Venda (Novo/Usado) da Nota Fiscal é diferente do tipo de venda do Comando (Novo/Usado)'+sLineBreak+ 'Por favor verificar', '')
       else
         raiseExceptionCreate('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +sLineBreak+ 'Tipo de Venda (Novo/Usado) da Nota Fiscal é diferente do tipo de venda do Contrato (Novo/Usado)'+sLineBreak+ 'Por favor verificar', '');


   end;
  Result := true;
end;

function TNFCab.validaCabecalho: boolean;
var
  I: integer;
  vTem: Boolean;
  vDt: TDate;
begin
  try
    if notaFechada then
      Exit;

    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      if dataSet.FieldByName('num_nf').AsInteger = 0 then
        raiseExceptionCreate('Número da Nota Fiscal não informado', 'dbedit43');
      //        raise Exception.Create('Número da Nota Fiscal não informado');
//      if (Trim(dataSet.FieldByName('sem_serie').AsString) <> 'S') then
//        if dataSet.FieldByName('serie').AsString = '' then
//          raiseExceptionCreate('Série da Nota Fiscal não informada', 'DBEdit47');
//      if Trim(dataSet.FieldByName('serie').AsString) = '0' then
//        raiseExceptionCreate('Série da Nota Fiscal não pode ser "0"', 'DBEdit47');
      if (dataSet.FieldByName('emissao_propria').AsString <> 'S') and
        (dataSet.FieldByName('emissao_propria').AsString <> 'N') then
        raiseExceptionCreate('Campo de Emissão própria deve ser preenchido com "S" de Sim ou "N" de Não', 'DBEdit49');
    end;

    if (Trim(dataSet.FieldByName('modelo_nf').AsString) = '6') and (dataSet.State in [dsEdit, dsInsert]) then
      dataSet.FieldByName('modelo_nf').AsString := '06';

    if existeNotaFiscal then
    begin
      if dataSet.FieldByName('num_nf').AsInteger = 0 then
        raiseExceptionCreate('Nota fiscal já existe aberta para o Destinatário/Remetente informado', 'DBEdit43')
      else
        raiseExceptionCreate('Nota fiscal já existe', 'DBEdit43');
    end;
    dataSet.FieldByName('codigo_nop').AsString :=
      getCfopCorreto(dataSet.FieldByName('codigo_nop').AsString);
    exitCodigoTabela('NAT_OP');

    if not validaCfop(dataSet.FieldByName('codigo_nop').AsFloat) then
      exit;

    if dataSet.FieldByName('cod_cliente').AsString = '' then
      raiseExceptionCreate('Destinatário/Remetente não informado', 'DBEdit1');

    if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
    begin

      if SqlOpen('select cm.* from cfop_mud cm'+
          ' inner join estados es on es.codigo_uf = cm.uf_destino and es.sigla_uf = ' + QuotedStr(dataSet.FieldByName('dest_uf').AsString) +
          ' where cm.codigo_uf = ' + IntToStr(vDadosIni.vEmp.vCodigo_Uf)).IsEmpty then
        raiseExceptionCreate('Relação de CFOP Interestaduais (CFOP_MUD) não encontrada para o estado da operação' + sLineBreak +
          'Estado: ' + getUFdaOperacao, 'DBEdit1');
    end;

    if dataSet.FieldByName('cod_cond_pag').AsString = '' then
      raiseExceptionCreate('Condição de pagamento não informada', 'DBLookupComboBox1')
    else
    begin
      vCPag.IndexFieldNames := 'COD_COND_PAG';
      try
        vCPag.FindNearest([dataSet.FieldByName('cod_cond_pag').AsInteger]);
        if dataSet.FieldByName('cod_cond_pag').AsString <>
          vCPag.dataSet.FieldByName('cod_cond_pag').AsString then
          raiseExceptionCreate('Condição de pagamento não encontrada ou de natureza diferente da permitida', 'DBLookupComboBox1');
      finally
        vCPag.IndexFieldNames := 'DESC_COND_PAG';
      end;
    end;

    if dataSet.FieldByName('cod_vendedor').AsString = '' then
      if dataSet.FieldByName('natureza_nf').AsString = 'E' then
        raiseExceptionCreate('Usuário não informado', 'DBLookupComboBox2')
      else
        raiseExceptionCreate('Vendedor não informado', 'DBLookupComboBox2');

    if (dataSet.FieldByName('aliq_icm').AsFloat >= 100) or
      (dataSet.FieldByName('aliq_icm').AsFloat < 0) then
      raiseExceptionCreate('Aliquota inválida', 'DBEdit39');
    if (dataSet.FieldByName('aliq_irrf').AsFloat >= 100) or
      (dataSet.FieldByName('aliq_irrf').AsFloat < 0) then
      raiseExceptionCreate('Aliquota IRRF inválida', 'DBEdit41');

    //    if not dataSet.FieldByName('data_ent_saida').IsNull then
    //      if dataSet.FieldByName('data_ent_saida').AsDateTime <
    //        dataSet.FieldByName('data_lanc').AsDateTime then
    //        raise exception.create('Data de Entrada/Saída não pode ser menor que a data de lançamento');

    if not dataSet.FieldByName('data_ent_saida').IsNull then
      if dataSet.FieldByName('data_ent_saida').AsDateTime <
        dataSet.FieldByName('DATA_CONTABIL').AsDateTime then
        raiseExceptionCreate('Data de Entrada/Saída não pode ser menor que a data contábil',
          'DBEdit44');

    if (dataSet.FieldByName('emissao_propria').AsString) = 'N' then
      try
        StrToTime(dataSet.FieldByName('hora_emissao').AsString);
      except
        raiseExceptionCreate('Hora de emissão da NF inválida', 'dbeHoraEmissao');
      end;

    if ((Trim(dataSet.FieldByName('tipo_nf').AsString) = 'P') or
      (Trim(dataSet.FieldByName('tipo_nf').AsString) = 'V')) and
      (Trim(dataSet.FieldByName('natureza_nf').AsString) = 'E') and
      (dataSet.FieldByName('data_lanc').AsDateTime > vDadosIni.getDataBanco(buscas)) then
      raiseExceptionCreate('Data de lançamento de mercadorias não deve ser maior que a data atual', 'DBEdit45');

    if (dataSet.FieldByName('emissao_propria').AsString) = 'N' then
      if not validaSerie then
        Exit;

    if not existeCarga then
      raiseExceptionCreate(vDadosIni.vPesquisa, '');

    if Pos('SIMPLES', vDadosIni.vEmp.vRegime) = 0 then
      if fstrin('modelo_nf', ['55', '66']) then
        if (fequals('modelo_nf', '55') and (fdate('data_lanc') >= EncodeDate(2012, 04, 01))) or
           (fequals('modelo_nf', '62') and (fdate('data_lanc') >= EncodeDate(2025, 04, 01))) or
           (fequals('modelo_nf', '66') and (fdate('data_lanc') >= EncodeDate(2019, 12, 01))) then
          if str_empty('chave_nfe') then
          begin
            if fequals('emissao_propria', 'N') then
              if fequals('modelo_nf', '55') then
                raiseExceptionCreate('Chave da NFe Obrigatória a partir de abril de 2012', 'DBEdit44')
              ELSE if fequals('modelo_nf', '62') then
                raiseExceptionCreate('Chave da NFCom Obrigatória a partir de abril de 2025', 'DBEdit44')
              else
                raiseExceptionCreate('Chave da NF3e Obrigatória a partir de dezembro de 2019', 'DBEdit44');
          end
          else if fequals('emissao_propria', 'N') then
            if not validarChaveNFe(fstr('chave_nfe')) then
              raiseExceptionCreate('Chave da %s inválida. Verifique a chave informada na aba Chave %s', [StrDFe, StrDFe], 'DBEdit44');

//    if Pos('SIMPLES', vDadosIni.vEmp.vRegime) > 0 then
      if fstrin('modelo_nf', ['55', '62', '66']) then
        if not fempty('chave_nfe') then
          if fequals('emissao_propria', 'N') then
            if not validarDadosChaveNFe(fstr('chave_nfe')) then
              Exit;
//              raiseExceptionCreate('Chave da NFe inválida. Verifique a chave informada na aba Chave NFe', 'DBEdit44');

    if dataSet.State = dsInsert then
    begin
      //      dataSet.Post;
      //      Apply;
      //      TRY
      //        dataSet.RefreshRecord;
      //      EXCEPT;
      //      end;
      //      dataSet.Edit;
            //Ver issu daqui. Quando o camarada lançar a nota forra do mes. Apresentar esta mensagem
            // e gravar auditoria que o camarada lançou a nota fora do mes.
      //      vDt := StartOfTheMonth(FDataDoDia) - 1;
      //      if copy(FormatDateTime('dd/mm/yyyy', vDt), 1, 2) >= copy(FormatDateTime('dd/mm/yyyy',
      //        dataSet.FieldByName('data_lanc').AsDateTime), 1, 2) then
      //        if Application.MessageBox('Data contábil de meses anteriores. Deseja continuar?',
      //          'Atenção', 4 + 32) = IDNO then
      //          Exit;
    end;

    vTem := False;
    if dataSet.FieldByName('tipo_nf').AsString = 'P' then
    begin
      for I := Low(modeloProdServ) to High(modeloProdServ) do
      begin
        vTem := Trim(dataSet.FieldByName('modelo_nf').AsString) = modeloProdServ[i];
        if vTem then
          Break;
      end;
    end
    else if (dataSet.FieldByName('tipo_nf').AsString = 'V') or
      (dataSet.FieldByName('tipo_nf').AsString = 'O') then
    begin
      for I := Low(modeloVeicOutras) to High(modeloVeicOutras) do
      begin
        vTem := Trim(dataSet.FieldByName('modelo_nf').AsString) = modeloVeicOutras[i];
        if vTem then
          Break;
      end;
    end
    else if dataSet.FieldByName('tipo_nf').AsString = 'I' then
    begin
      for I := Low(modeloImpressoras) to High(modeloImpressoras) do
      begin
        vTem := Trim(dataSet.FieldByName('modelo_nf').AsString) = modeloImpressoras[i];
        if vTem then
          Break;
      end;
    end
    else if dataSet.FieldByName('tipo_nf').AsString = 'D' then
    begin
      for I := Low(modeloDespesas) to High(modeloDespesas) do
      begin
        vTem := Trim(dataSet.FieldByName('modelo_nf').AsString) = modeloDespesas[i];
        if vTem then
          Break;
      end;
    end
    else if dataSet.FieldByName('tipo_nf').AsString = 'S' then
    begin
      for I := Low(modeloServicos) to High(modeloServicos) do
      begin
        vTem := Trim(dataSet.FieldByName('modelo_nf').AsString) = modeloServicos[i];
        if vTem then
          Break;
      end;
    end;
    if not vTem then
      raiseExceptionCreate('Modelo inválido. Verifique no Help os modelos', 'DBEdit50');

    if (dataSet.FieldByName('emissao_propria').AsString = 'S') and
      (dataSet.FieldByName('modelo_nf').AsString = '55') and
      (dataSet.FieldByName('tipo_nf').AsString = 'V') and
      (vItem.dataSet.RecordCount > 1) then
    begin
      Application.MessageBox('Nota Fiscal de emissão própria. Permitido um item para cada nota fiscal', 'Atenção', 0 + 64);
      exit;
    end;

    if (dataSet.FieldByName('tipo_nf').AsString = 'S') and
      (dataSet.FieldByName('natureza_nf').AsString = 'E') and
      (vDadosIni.vEmp.vNfe.ibgeCodCidade = 3106200) then
    begin
      if (dataSet.FieldByName('TIPO_REC_ISSQN').AsString = '1') and
        (dataSet.FieldByName('MOTIVO_NAO_RETENCAO').AsString <> '16') then
        raiseExceptionCreate('Quando "Tipo de Recolhimento do ISSQN" for igual a "1" então "Motivo Não retenção" deve ser igual a "16"', 'DBComboBox25')
      else if (dataSet.FieldByName('TIPO_REC_ISSQN').AsString = '2') and
        (dataSet.FieldByName('MOTIVO_NAO_RETENCAO').AsString = '16') then
        raiseExceptionCreate('Quando "Tipo de Recolhimento do ISSQN" for igual a "2" então "Motivo Não retenção" deve ser diferente de "16"', 'DBComboBox25')
      else if (dataSet.FieldByName('TIPO_REC_ISSQN').AsString <> '1') and
        (dataSet.FieldByName('TIPO_REC_ISSQN').AsString <> '2') then
        raiseExceptionCreate('Campo "Tipo de Recolhimento do ISSQN" deve ser preenchido com "1" ou "2"', 'DBComboBox25')
      else if (dataSet.FieldByName('TIPO_REC_ISSQN').AsString = '2') and
        (trim(dataSet.FieldByName('MOTIVO_NAO_RETENCAO').AsString) = '')  then
        raiseExceptionCreate('Campo "Motivo Não retenção" deve ser preenchido de "01" até "17" quando "Tipo de Recolhimento do ISSQN" for igual a "2"', 'DBComboBox25')
      else if TryStrToInt(Trim(dataSet.FieldByName('MOTIVO_NAO_RETENCAO').AsString), I) then
        if (I > 17) or (I < 1) then
          raiseExceptionCreate('Campo "Motivo Não retenção" deve ser preenchido de "01" até "17"', 'DBComboBox25')
    end;

    Result := true;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.validaCfop(pCfop: Double): boolean;
var
  natureza: string;
  cfop: string;
begin
  if notaFechada then
    Exit;
  if dataSet.IsEmpty then
    exit;
  natureza := dataSet.FieldByName('natureza_nf').AsString;
  try
    cfop := IntToStr(Trunc(pCfop));
  except
    raise exception.create('CFOP inválido');
  end;

  try
    if natureza = 'S' then
    begin
      if (cfop[1] <> '5') and (cfop[1] <> '6') and (cfop[1] <> '7') then
        raise exception.create('CFOP de saída deve iniciar em 5, 6 ou 7');
      if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) and
        (cfop[1] = '5') and (getUFdaOperacao <> 'EX') then
        raise exception.create('CFOP de saída para fora do estado não deve iniciar em 5')
      else if fdif('nfe_iddest', '2') and
        (cfop[1] = '6') then
        raise exception.create('CFOP de saída iniciado em 6 e Indicador de operação difere de "2 - Interestadual"')
    end
    else
    begin
      if (cfop[1] <> '1') and (cfop[1] <> '2') and (cfop[1] <> '3') then
        raise exception.create('CFOP de entrada deve iniciar em 1, 2 ou 3');
      if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) and
        (cfop[1] = '1') then
        raise exception.create('CFOP de entrada de fora do estado não deve iniciar em 1')
      else if (vDadosIni.vEmp.vSiglaUF = getUFdaOperacao) and
        (cfop[1] = '2') then
        raise exception.create('CFOP de entrada para dentro do estado não deve iniciar em 2');
      if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
        (dataSet.FieldByName('emissao_propria').AsString = 'S') and
        (dataSet.FieldByName('dest_cmun').AsString = '9999999') and
        (cfop[1] <> '3') then
        raise exception.create('CFOP deve iniciar em "3". Nota Fiscal de Importação');

    end;
    if not existeCFOP(dataSet.FieldByName('codigo_nop').AsFloat) then
      raise exception.create('CFOP não encontrado no cadastro: ' + fstr('codigo_nop'));
    vCfop.selecionaCfop(dataSet.FieldByName('codigo_nop').AsInteger);
    Result := true;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.validaCodigoPeloCodFornecedor: boolean;
begin
  Result := True;
  if (dataSet.FieldByName('tipo_nf').AsString = 'V') and
    (dataSet.FieldByName('natureza_nf').AsString = 'S') then
    Exit;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
    begin
      if Trim(vItem.dataSet.FieldByName('grupo_prod').AsString) = '' then
      begin
        Result := False;
        Break;
      end;
    end;
    vItem.dataSet.Next;
  end;
end;

function TNFCab.validaDadosImportacao: Boolean;
begin
  Result := true;

  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    exit;

  if dataSet.FieldByName('emissao_propria').AsString <> 'S' then
    exit;

  if dataSet.FieldByName('dest_cmun').AsString <> '9999999' then
    Exit;

  try
    vItem.dataSet.AfterScroll:= vItem.AfterItemNfImportacao;

    vItem.dataSet.First;
    while not vItem.dataSet.eof do
    begin
      if copy(vItem.dataSet.FieldByName('codigo_nop').AsString, 1, 1) <> '3' then
      begin
        Application.MessageBox(pchar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
        ' com CFOP incorreto. Deve iniciar em 3'), 'Atenção', 0 + 64);
          Result := False;
        Break;
      end;

      if vItem.vDI.dataSet.IsEmpty then
      begin
        Application.MessageBox(pchar('Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +
        '. Não foi informado nenhum DI(Declaração de Importação) para ele'), 'Atenção', 0 + 64);
          Result := False;
        Break;
      end;

      vItem.vDI.dataSet.First;
      while not vItem.vDI.dataSet.eof do
      begin

        if vItem.vDI.vADI.dataSet.IsEmpty then
        begin
          Application.MessageBox(pchar('Item DI Nº ' + vItem.vDI.dataSet.FieldByName('nitem_di').AsString +
          ' do Item Nº ' + vItem.dataSet.FieldByName('nitem').AsString +  
          '. Não foi informado nenhum Adição DI(Declaração de Importação) para ele'), 'Atenção', 0 + 64);
            Result := False;
          Break;
        end;

        vItem.vDI.dataSet.Next;
      end;

      vItem.dataSet.Next;
    end;

  finally
    vItem.dataSet.AfterScroll:= vItem.AfterItemNf;
  end;
end;

function TNFCab.validaDadosItem: boolean;
var
  vComSubstituicao, vTributada: boolean;
  S, vTempCst: string;
  unds: TUnidadeVendas_Model;
begin
  try
    Result := False;

    if vItem.vrDadosItem.stado <> dsEdit then
    begin
      if vItem.dataSet.RecordCount >= vDadosIni.vEmp.vQtdeProdNf then
        raise Exception.Create('Quantidade de Itens maior que o configurado no cadastro da Empresa');

      if vItem.dataSet.RecordCount >= 899 then
        raise Exception.Create('Quantidade de Itens maior que o Permitido 899');
    end;

    if vItem.vrDadosItem.tipo_item = 'O' then
      vItem.vrDadosItem.descricao_item := vItem.vrDadosItem.descricao_item_outras[0]
    else if (vItem.vrDadosItem.tipo_item = 'P') and (vItem.vrDadosItem.unidade_nf <> '') then
    begin
      unds := helperConv.GetListConversao(vItem.vrDadosItem.grupo_prod, vItem.vrDadosItem.cod_prod);
      if unds.GetConversao(vItem.vrDadosItem.unidade_nf, fequals('natureza_nf', 'S') and fequals('tipo_emissao', '1')) = nil then
        raiseExceptionCreate('Fator de conversão para unidade' + vItem.vrDadosItem.unidade_nf + ' não encontrado');      
    end;

    if Trim(vItem.vrDadosItem.descricao_item) = '' then
      raiseExceptionCreate('Descrição do Item não informada', campos[9]);

    if fstrin('tipo_emissao', ['1', '4']) then
      if vItem.vrDadosItem.quantidade <= 0 then
        raiseExceptionCreate('Quantidade deve ser informada.', campos[1])
      else if vItem.vrDadosItem.valor_unitario <= 0 then
        raiseExceptionCreate('Valor Unitário deve ser informado.', campos[2]);

    if not validaCfop(vItem.vrDadosItem.codigo_nop) then
      Exit;

    if (vDadosIni.vEmp.vCombProduto = 'S') and fequals('emissao_propria', 'S') then
      if notaFiscalDeCombustivel(IntToStr(Trunc(vItem.vrDadosItem.codigo_nop))) then
      begin
        if Trim(vItem.vrDadosItem.comb_cprodanp) = '' then
          raiseExceptionCreate('Código ANP deve ser informado.', campos[12]);
        if (vItem.vrDadosItem.comb_cide_qbcprod > 0) or (vItem.vrDadosItem.comb_cide_valiqprod > 0) or (vItem.vrDadosItem.comb_cide_vcide > 0) then
        begin
          if (vItem.vrDadosItem.comb_cide_valiqprod = 0) then
            raiseExceptionCreate('CIDE - Aliquota deve ser informada.', campos[13]);
          if (vItem.vrDadosItem.comb_cide_qbcprod = 0) then
            raiseExceptionCreate('CIDE - Base deve ser informada.', campos[14]);
          if (vItem.vrDadosItem.comb_cide_vcide = 0) then
            raiseExceptionCreate('CIDE - Valor deve ser informado.', campos[15]);
        end;
        if Trim(vItem.vrDadosItem.comb_descanp) = '' then
          raiseExceptionCreate('Descrição ANP deve ser informada', campos[16]);
      end;

    if not vItem.TestarCST(vItem.vrDadosItem.cst) then
    begin
      vNomeCampoErro := campos[4];
      exit;
    end;

    if fequals('natureza_nf', 'S') and (vDadosIni.vEmp.vRegime = 'SIMPLES') then
      if (not vItem.vrDadosItem.cst_icm_mono) and (not vItem.TestarCSOSN(vItem.vrDadosItem.csosn, campos[5])) then
      begin
        vNomeCampoErro := campos[5];
        exit;
      end;

    vTempCst := Copy(vItem.vrDadosItem.cst, 2, 2);
    if fequals('natureza_nf', 'S') and (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
      if not vClFor.empresaSubstitutoTributario then
      begin
        if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
        begin
          if (vItem.vrDadosItem.csosn = '201') or (vItem.vrDadosItem.csosn = '202') or
            (vItem.vrDadosItem.csosn = '203') then
            raiseExceptionCreate('Empresa não é substituto tributário no estado de Destino' + sLineBreak +
                                 'CSOSN 201, 202 e 203 não podem ser usados', campos[5]);
        end
        else
        begin
          if (vTempCst = '10') or (vTempCst = '30') or (vTempCst = '70') then
            raiseExceptionCreate('Empresa não é substituto tributário no estado de Destino' + sLineBreak +
                                 'CST 10, 30 e 70 não podem ser usados', campos[5]);
        end;
      end;

    if (vItem.vrDadosItem.vicmdeson > 0) and (not MatchStr(vTempCst, ['20', '30', '40', '70', '90'])) then
      if not(fequals('natureza_nf', 'E') and (vTempCst = '60') and (vItem.vrDadosItem.antec_trib = 'S')) then
        if ShowConfirmacao('O CST de ICMS selecionando ("%s") não possui campos para desoneração do ICMS' +
                           ' e os campos estão preenchidos. ' + sLineBreak + sLineBreak +
                           ' Valor: %n' + sLineBreak + sLineBreak +
                           'Se prosseguir o valor do ICMS Desonerado será zerado. Continuar?',
                           [vItem.vrDadosItem.cst, vItem.vrDadosItem.vicmdeson]) = IDYES then
        begin
          vItem.vrDadosItem.vicmdeson := 0;
          vItem.vrDadosItem.ind_desoneracao := 0;
        end
        else
          Exit;

    if Trim(vItem.vrDadosItem.csosn) <> '' then
    begin
      vTributada       := MatchText(vItem.vrDadosItem.csosn, ['101', '201', '203']);
      vComSubstituicao := MatchText(vItem.vrDadosItem.csosn, ['201', '202', '203']);
    end
    else
    begin
      vTempCst         := Copy(vItem.vrDadosItem.cst, 2, 2);
      vTributada       := MatchText(vTempCst, ['00', '10', '20', '30', '70']);
      vComSubstituicao := MatchText(vTempCst, ['10', '30', '70']);
    end;

    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      if vComSubstituicao then
      begin
        if vItem.vrDadosItem.modbcst = 4 then
        begin
          if (vItem.vrDadosItem.aliq_icmsub > 0) and (vItem.vrDadosItem.mva <= 0) then
            raiseExceptionCreate('Item com ST. Modalidade: MVA. Aliq ST informada e MVA não informada' + sLineBreak +
                                 'Favor informar o MVA', campos[6])
          else if (vItem.vrDadosItem.aliq_icmsub <= 0) and (vItem.vrDadosItem.mva > 0) then
            raiseExceptionCreate('Item com ST. Modalidade: MVA. Aliq ST não informada e MVA informada' + sLineBreak +
                                 'Favor informar a Aliq ST', campos[7]);
        end
        else
        begin
          if (vItem.vrDadosItem.aliq_icmsub > 0) and (vItem.vrDadosItem.base_icmsub <= 0) then
            raiseExceptionCreate('Item com ST. Aliq ST informada e Base ICMS ST não informada' + sLineBreak +
                                 'Favor informar a Base de ICMS ST', campos[6]);
        end;
      end;
    end
    else
    begin
      if vDadosIni.vEmp.vRegime = 'SIMPLES' then
      begin
        if ((vItem.vrDadosItem.csosn = '101') or (vItem.vrDadosItem.csosn = '201')) and
           (not vClFor.clienteFornecedorContrinuinte) then
          raiseExceptionCreate('Destinatário não tem direto a crédito de ICMS' + sLineBreak +
                               'Portanto o CSOSN deverá ser diferente de 101 e 201');
      end
      else
      begin
        if (vTempCst <> '20') and (vTempCst <> '70') and (vTempCst <> '90') and (vItem.vrDadosItem.perc_red_prod > 0) then
          raiseExceptionCreate('Item tributado com redução na base de cálculo' + sLineBreak +
                               'O CST do produto deve ser 020, 120, 070 ou 170')
        else if ((vTempCst = '20') or (vTempCst = '70')) and
                ((vItem.vrDadosItem.perc_red_prod <= 0) and (vItem.vrDadosItem.base_icm <= 0)) then
          raiseExceptionCreate('Item tributado com redução na base de cálculo' + sLineBreak +
                               'O Sistema não encontrou a redução ou a Base. Verifique suas configurações');

        if TTipoCalculo(vItem.vrDadosItem.tipo_calc_pc) <> tcCompleto  then
          if MatchStr(vItem.vrDadosItem.cst_pis, ['06', '07', '08', '09']) and (vItem.vrDadosItem.nat_rec = '') then
            ShowAtencao('Natureza da receita do PISCOFINS precisa ser informada quando cst for "06", "07", "08" ou "09"');
      end;
    end;

    if Trim(vItem.vrDadosItem.cst_pis) <> (Trim(vItem.vrDadosItem.cst_cofins)) then
      raiseExceptionCreate('CST de PIS difere do CST de COFINS, deve ser o mesmo','');

    S := OnlyNumber(vItem.vrDadosItem.chave_nfe_ref);

    if S <> '' then
    begin
      if S <> vItem.vrDadosItem.chave_nfe_ref then
        raiseExceptionCreate('Chave da NFe inválida, a chave é composta apenas de números');
    
      if (Length(s) <> 44) then
        raiseExceptionCreate('Chave da NFe inválida, a chave precisa ter 44 dígitos');

      if fequals('tipo_emissao', '4') and (vItem.vrDadosItem.nitem_nfe_ref = 0) then
        raiseExceptionCreate('NFe de devolução, referencia de NFe por item, o número do item é obrigatório');
    end;

    Result := True;
  except
    on e: exception do
    begin
      Result := False;
      ShowAtencao(e.Message);
    end;
  end;
end;

function TNFCab.validaDadosNotaFiscalEletronica: boolean;
var
  slist: TStrings;
  lastNCM: string;
begin
  try
    Result := True;
    if (dataSet.FieldByName('modelo_nf').AsString <> '55') or
      (dataSet.FieldByName('emissao_propria').AsString <> 'S') then
    begin
      if (vDadosIni.vEmp.vRegime = 'LUCRO REAL') or (vDadosIni.vEmp.vGerarSpedPISCOFINS = 'S') then
      begin
        if vClFor.ibge_codigo_uf <= 0 then
          raise Exception.Create('Código IBGE do estado do remetente não infomado no cadastro do estado');

        if Trim(dataSet.FieldByName('dest_cmun').AsString) = '' then
          raise Exception.Create('Código IBGE da cidade do remetente não infomado no cadastro da cidade');
      end;
      exit;
    end;

    //Validando dados do emitente
    if Trim(vDadosIni.vEmp.vNfe.certificadonumSerie) = '' then
      raise Exception.Create('NFe: Certificado Transmissor inválido');

    if not DirectoryExists(Trim(vDadosIni.vEmp.vNfe.pathArquivos)) then
    begin
      if not CreateDir(Trim(vDadosIni.vEmp.vNfe.pathArquivos)) then
        raise Exception.Create('NFe: Endereço dos arquivos xml não encontrado');
      if not CreateDir(Trim(vDadosIni.vEmp.vNfe.pathArquivos+'\Autorizado')) then
        raise Exception.Create('NFe: Endereço dos arquivos xml não encontrado');
    end;
    if not DirectoryExists(Trim(vDadosIni.vEmp.vNfe.pathArquivos+'\Autorizado')) then
      raise Exception.Create('NFe: Endereço dos arquivos xml não encontrado');

    if Trim(vDadosIni.vEmp.vCNPJ) = '' then
      raise Exception.Create('NFe: CNPJ emitente não informado')
    else if not cgc(vDadosIni.vEmp.vCNPJ) then
      raise Exception.Create('NFe: CNPJ do emitente inválido');

    if Trim(vDadosIni.vEmp.vIE) = '' then
      raise Exception.Create('NFe: IE do emitente não informada')
    else if ConsisteInscricaoEstadual(vDadosIni.vEmp.vIE,
      vDadosIni.vEmp.vSiglaUF) <> 0 then
      raise Exception.Create('NFe: IE do emitente inválida');

    if vDadosIni.vEmp.vNfe.ibgeCodEstado = 0 then
      raise Exception.Create('NFe: Código IBGE do estado não infomado para o emitente');

    if vDadosIni.vEmp.vNfe.ibgeCodCidade = 0 then
      raise Exception.Create('NFe: Código IBGE da cidade não infomada para o emitente');

    //Validando dados do cliente  
    if Trim(dataSet.FieldByName('cpfcgc').AsString) = '' then
    begin
      if (dataSet.FieldByName('dest_cmun').AsString <> '9999999') then
        raise Exception.Create('NFe: CPF/CNPJ do destinatário não informado')
    end
    else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 14 then
    begin
      if not cgc(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
        raise Exception.Create('NFe: CNPJ do destinatário inválido');
    end
    else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 11 then
    begin
      if not Cpf(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
        raise Exception.Create('NFe: CPF do destinatário inválido');
    end
    else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) <> 0 then
      raise Exception.Create('NFe: CPF/CNPJ do destinatário inválido')
    else
      raise Exception.Create('NFe: CNPJ Destinatário não cadastrado');

    if Trim(dataSet.FieldByName('insc_est').AsString) = '' then
      raise Exception.Create('NFe: IE do destinatário não informada')
    else if ConsisteInscricaoEstadual(Trim(dataSet.FieldByName('insc_est').AsString),
      dataSet.FieldByName('dest_uf').AsString) <> 0 then
      raise Exception.Create('NFe: IE do destinatário inválida');

    if Trim(dataSet.FieldByName('dest_uf').AsString) = '' then
      raise Exception.Create('NFe: Sigla do estado não infomado para o destinatário');

    if Trim(dataSet.FieldByName('dest_cmun').AsString) = '' then
      raise Exception.Create('NFe: Código IBGE da cidade não infomada para o destinatário');

    if RoundTo(pagNFe.total, -2) < RoundTo(dataSet.FieldByName('valor_total').AsFloat, -2)  then
      raiseExceptionCreate('NFe: Valor total dos pagamentos menor que o total da NFe' + sLineBreak + sLineBreak + 'Favor informar na aba Cobrança', 'btpag_incluir');

    if RoundTo(dataSet.FieldByName('fat_vliq').AsFloat, -2) < 0  then
      raiseExceptionCreate('NFe: Valor líquido das Faturas não pode ser menor que zero', 'edfat_nfat');

    //Validando dados do Transportador
    if not vTr.dataSet.IsEmpty then
    begin
      if Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString) <> '' then
        //        raise Exception.Create('NFe: CNPJ transportador não informado')       else
        if Length(Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString)) = 14 then
        begin
          if not cgc(Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString)) then
            raise Exception.Create('NFe: CNPJ do transportador inválido');
        end
        else if Length(Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString)) = 11 then
        begin
          if not Cpf(Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString)) then
            raise Exception.Create('NFe: CPF do transportador inválido');
        end
        else if Trim(vTr.dataSet.FieldByName('cnpj_tr').AsString) <> '' then
          raise Exception.Create('NFe: CPF ou CNPJ do transportador inválido');

      if Trim(vTr.dataSet.FieldByName('ie_tr').AsString) <> '' then
      begin
        //        raise Exception.Create('NFe: IE do transportador não informada')       else
        if ConsisteInscricaoEstadual(Trim(vTr.dataSet.FieldByName('ie_tr').AsString),
          vTr.dataSet.FieldByName('sigla_uf').AsString) <> 0 then
          raise Exception.Create('NFe: IE do transportador inválida');

        if Trim(vTr.dataSet.FieldByName('sigla_uf').AsString) = '' then
          raise Exception.Create('NFe: UF do Transportador não informada')
      end;
      //      else if Trim(vTr.dataSet.FieldByName('ibge_codigo_uf').AsString) = '' then
      //        raise Exception.Create('NFe: Código IBGE do estado não infomado para o Transportador');
    end;

    //Validando dados do Cabeçalho da Nota fiscal

    //Validados dados da Nota Fiscal Complementar
    if dataset.fieldbyname('tipo_emissao').AsString = '2' then //2 = Complementar
    begin
      if vSped.vC110.vC113.IsEmpty then
      begin
        if (dataSet.FieldByName('num_nf_compl').AsInteger = 0) or
          (dataSet.FieldByName('serie_compl').AsString = '') //or
          //(dataSet.FieldByName('cod_nf_ref').AsInteger = 0)
          then
          raise Exception.Create('NFe: Nota Fiscal Referenciada não Informada');
        if not existeNotaFiscalComplementar(dataSet.FieldByName('num_nf_compl').AsInteger,
          dataSet.FieldByName('serie_compl').AsString) then
          Exit;
      end;
    end;

    //Validando dados dos Itens
    if vItem.dataSet.RecordCount = 0 then
      raise
        exception.create('NFe: Nota Fiscal sem Itens. No fiscal deve ter no mínimo 1 item');
    {
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('valor_ipi').AsFloat > 0) and
        (Length(Trim(vItem.dataSet.FieldByName('ncm').AsString)) <> 8) then
        raise
          exception.create('NCM/SH deve ser preenchido por completo quando existir tributação de IPI');
      if (Length(Trim(vItem.dataSet.FieldByName('ncm').AsString)) <> 8) and
        (Length(Trim(vItem.dataSet.FieldByName('ncm').AsString)) <> 2) then
        raise
          exception.create('NCM/SH deve ser preenchido por completo ou pelo Gênero (2 primeiros dígitos)');
      vItem.DataSet.Next;
    end;
    }
    if not (vDadosIni.strEstaContidoEm(dataSet.FieldByName('NFE_INDPRES').AsString, ['0', '1', '2', '3', '4', '9'])) then
      raise exception.create('Indicador de presença inválido. Valores válidos [ 0, 1, 2, 3, 4, 9 ]');

    if not (vDadosIni.strEstaContidoEm(dataSet.FieldByName('NFE_IDDEST').AsString, ['1', '2', '3'])) then
      raise exception.create('Identificador de local de destino da operação inválido. Valores válidos [ 1, 2, 3 ]');

    if (dataSet.FieldByName('valor_iss').AsFloat > 0) and
      (Trim(vDadosIni.vemp.vIM) = '') then
      raise
        exception.create('Operação com tributação de ISSQN sem informar a Inscrição Municipal no cadastro da Empresa');

    vDadosIni.vDataBanco := vDadosIni.getDataBanco(buscas);
    if vDadosIni.vDataBanco >= FConfig.Conf_Geral.nfe_nt_2020_006_data then
    begin
      if fstrin('nfe_indpres', ['1', '2', '3', '4', '9']) and fempty('indintermed') then
        if vDadosIni.vDataBanco >= EncodeDate(2021, 09, 01)  then
          raiseExceptionCreate('Indicador de presença entre os valores (1, 2, 3, 4, 9)' + sLineBreak +
                               'Indicador de intermediador/marketplace não informado');

      if fequals('indintermed', '1') then
        if fempty('infintermed_cnpj') then
          raiseExceptionCreate('Operação com Intermediador/Marketplace e cnpj do intermediador não informado')
        else if fempty('infintermed_idcadinttran') then
          raiseExceptionCreate('Operação com Intermediador/Marketplace e identificação no intermediador não informada')
        else
          if not cgc(fstr('infintermed_cnpj')) then
            raiseExceptionCreate('CNPJ do Intermediador/Marketplace inválido');
    end;

    //Validação de NCM via IBPT
    if Config.Conf_Geral.nf_ibpt_consulta_tributos.AsBoolean and
      (Config.Conf_Geral.nf_ibpt_consulta_tributos.ReadString('Conf', 'ValidarNCMsEmissaoNFe') = 'S') then
    begin

      queryCons
        .SQL('select nfi.ncm, nfi.nitem, nfi.descricao_item from notafiscal nf' +
              ' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
              ' left join ibpt ib on ib.codigo = nfi.ncm and ib.ex = 0 and ib.uf = :uf' +
              ' where nf.cod_nf = :cod_nf and nf.cod_empresa = :cod_empresa' +
              ' and coalesce(ib.descricao, ''Ncm não encontrado na api'') = ''Ncm não encontrado na api''' +
              ' order by nfi.ncm, nfi.nitem')
        .ParamValue('uf', vDadosIni.vEmp.vSiglaUF)
        .ParamValue('cod_nf', fint('cod_nf'))
        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
        .Open();

      slist := NewStringList();
      try

        lastNCM := '*';
        while not queryCons.Eof do
        begin                             
          if queryCons.fdif('ncm', lastNCM) then
          begin
            if lastNCM = '*' then
              slist.Add('Lista de NCM''s não encontrados' + sLineBreak);

            lastNCM := queryCons.fstr('ncm');
            slist.Add(' > ' + lastNCM);
          end;
          slist.Add(Format('     - Item %d - %s', [queryCons.fint('nitem'), queryCons.fstr('descricao_item')]));
          queryCons.Next;
        end;

        if slist.Count > 0 then
        begin
          slist.Add(sLineBreak + 'Deseja continar mesmo assim? Pode haver rejeição do WebService de Autorização da NFe ');
          if ShowConfirmacao(slist.Text) <> ID_YES then
          begin
            Result := False;
            Exit;
          end;
        end;

      finally
        slist.Free;
      end;
    end;
    
    //NCM de informação obrigatória para produto tributado pelo IPI
    //Operação com tributação de ISSQN sem informar a Inscrição Municipal
    //Total da BC ICMS difere do somatório dos itens
    //Total do ICMS difere do somatório dos itens
    //Total da BC ICMS-ST difere do somatório dos itens
    //Total do ICMS-ST difere do somatório dos itens
    //Total do Frete difere do somatório dos itens
    //Total do Seguro difere do somatório dos itens
    //Total do Desconto difere do somatório dos itens
    //Total do IPI difere do somatório dos itens
    //Total do Produto / Serviço difere do somatório dos itens

  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

