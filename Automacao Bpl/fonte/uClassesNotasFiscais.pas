function TNFCab.verificaAcordoCliente(pAliq, pCfop: Double;
  pCst: string): boolean;
begin
  try
    buscas.close;
    buscas.sql.Text := 'select aliq_externa, cfop_externo, cst_externo from cst_mud_cliente' +
      ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
      ' and aliq_interna = ' + vDadosIni.trocaVirgulaPorPonto(FloatToStr(pAliq)) +
      ' and cfop_interno = ' + vDadosIni.trocaVirgulaPorPonto(FloatToStr(pCfop)) +
      ' and cst_interno = ' + QuotedStr(pCst) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    FAliqAcordoCliente := buscas.FieldByName('aliq_externa').AsFloat;
    FCfopAcordoCliente := buscas.FieldByName('cfop_externo').AsFloat;
    FCstAcordoCliente := buscas.FieldByName('cst_externo').AsString;
    Result := not buscas.IsEmpty;
  finally
    buscas.Close;
  end;
end;

function TNFCab.verificaAcordoGeral(pAliq, pCfop: Double;
