    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    vOK := (formulario.ShowModal = mrOk);
  finally
    frmCadNF.pnComplementarCadastro.Parent := frmCadNF.tsComplementar;
    formulario.Free;
    formulario := nil;
  end;
  if not vOK then
    Exit;
  //  if not existeNotaFiscalComplementar(frmCadNF.edNumNfCompl.AsInteger, frmcadnf.edSerieCompl.Text)
  //    then
  //    exit;
  vIt2Nf := TClientDataSet(dtmNF.cdsIt2Nf);
  try
    try
      if not incluirNf(tnfOutras, 'P', 'S') then
        exit;
      buscas.Close;
      buscas.Sql.Text := 'select * from notafiscal' +
        ' where num_nf = ' + IntToStr(frmCadNF.edNumNfCompl.AsInteger) +
        ' and serie = ' + QuotedStr(frmcadnf.edSerieCompl.Text) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and natureza_nf = ''S''' +
        ' and ativo = 1 ';
