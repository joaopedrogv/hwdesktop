function TNFCab.abreFormDetalhesDespesa(indice: integer; cdsDesp: TClientDataSet): boolean;
var
  formulario: TfrmPadrao;
  I, J: Integer;
  vrTemp: Currency;
  plContas: TClientDataSet;
  vCtrl: TControlesNF;
begin
  try
    plContas := TClientDataSet(dtmNF.cdsPlC);
    vDetDesp := TClientDataSet(cdsDesp);
    vCtrl := TControlesNF.create;
    vCtrl.selecionaControlesContasAPagar;
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption :=
      'Detalhes da Despesa Selecionada. Documento : ' + FFatura.numeroDocumento[indice];
    frmCadNF.pnDetFatEnt.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    formulario.BorderIcons:= [];
    frmCadNF.Label402.Caption := Format('%0.2m', [FFatura.valorDocumento[indice]]);
    frmCadNF.Label404.Caption := FFatura.numeroDocumento[indice];
    vrTemp := 0;
    while not vDetDesp.IsEmpty do
      vDetDesp.Delete;
    if not plContas.Active then
      plContas.Open;
    for I := 0 to High(FFatura.despesas) do
    begin
      if FFatura.despesas[i].indice = indice then
      begin
        for J := 0 to High(FFatura.despesas[i].valorDocumento) do
        begin
          vrTemp := vrTemp + FFatura.despesas[i].valorDocumento[J];
          plContas.IndexFieldNames := 'N_CONTA_PLC';
          plContas.FindNearest([FFatura.despesas[i].NumConta[J]]);
          vCtrl.dataSet.IndexFieldNames := 'CODIGO_CTRL';
          vCtrl.dataSet.FindNearest([FFatura.despesas[i].Controle[J]]);
          vDetDesp.Insert;
          vDetDesp.FieldByName('NumConta').AsFloat := FFatura.despesas[i].NumConta[J];
          vDetDesp.FieldByName('Departamento').AsString :=
            plContas.FieldByName('desc_dep').AsString;
          vDetDesp.FieldByName('DataReferencia').AsDateTime :=
            StrToDate(FFatura.despesas[i].dataReferencia[J]);
          vDetDesp.FieldByName('NumDoc').AsString :=
            FFatura.despesas[i].NumDoc[J];
          vDetDesp.FieldByName('Historico').AsString := FFatura.despesas[i].historico[J];
