end;

procedure TNFItem.CadastrarConversaoUmParaUmAuto(todosItens: Boolean);
var
  sUndVenda: TStrings;
  sFalhas: TStrings;
  sItens: TStrings;
  sEans: TStrings;
  payload: TConvUnidadeCriarSilentInput;
  sItem: string;
  countEans: Integer;
  saveEan: Boolean;
begin

  sFalhas := NewStringList(True);
  sItens  := NewStringList(True);
  sEans   := NewStringList();
  if todosItens then
    Self.prepare_loop()
  else
    Self.prepare_loop('nitem = ' + fstr('nitem'));
  try

    while not dataSet.Eof do
    begin
      if (fstr('unidade_nf') = fstr('ucom')) // Igual a NFe
        and (ffloat('qtdemb') = 0)
        and (ffloat('qcom') > 0)
        and (ffloat('vuncom') > 0) then
      begin
        vrDadosItem.grupo_prod := fint('grupo_prod');
        vrDadosItem.cod_prod := fstr('cod_prod');

        sUndVenda := Self.GetUndVendaProd();

        if sUndVenda.IndexOf(fstr('ucom')) = -1 then
        begin
          sItens.Add(Format('grupo=%d;cod=%s;uest=%s;ucom=%s;',[ fint('grupo_prod'), fstr('cod_prod'), fstr('referencia') , fstr('ucom') ]));
          if (not CadNf.vItem.fempty('cean')) and CadNf.vItem.fdif('cean', 'SEM GTIN') then
            sEans.Values[fstr('grupo_prod') + ';' + fstr('cod_prod')] := CadNf.vItem.fstr('cean');
        end;

      end;
      dataSet.Next;
    end;

    if sItens.Count = 0 then
      Exit;

    if todosItens then
      if ShowCustomDlg
        .Msg(Format('Total de %d produtos/unidade fornecedor distintos sem conversão' + sLineBreak + sLineBreak +
                    'Continuar para cada produto/unidade cadastrar conversão 1 para 1?', [sItens.Count]),
                    mdtQuestion, [brYes, brNo, brCancel])
        .SetDefaultBtn(brCancel)
        .Show.ResultDlg <> IDYES then
        Exit;

    if sEans.Count > 0 then
      with ShowCustomDlg
        .Msg(Format('Foram encontrados %d produtos com código EAN' + sLineBreak + sLineBreak +
                    'Deseja salvar esse EAN nas convesões que serão criadas?', [sEans.Count]),
                    mdtQuestion, [brYes, brNo, brCancel])
        .SetDefaultBtn(brCancel)
        .Show do
      begin

        if not (ResultBtn in [brYes, brNo]) then
          Exit;

        saveEan := ResultBtn = brYes;
      end;

    for sItem in sItens do
    begin

      payload := TConvUnidadeCriarSilentInput.Create;
      try
        payload.cod_empresa := vDadosIni.cod_empresa;
        payload.usuario     := vDadosIni.vNomeUsuario;
        payload.fator       := 1;
        payload.quantidade  := 1;
        payload.grupo_prod  := StrToInt(ExtractStr(sItem, 'grupo=', ';'));
        payload.cod_prod    := ExtractStr(sItem, 'cod=', ';');
        payload.unidade     := AnsiUpperCase(ExtractStr(sItem, 'uest=', ';'));
        payload.unid_vnd    := AnsiUpperCase(ExtractStr(sItem, 'ucom=', ';'));
        payload.unid_princ  := payload.unidade;
        payload.codigo_ean  := IfThen( saveEan and CadNf.vItem.fdif('cean', 'SEM GTIN'),
                                               sEans.Values[ IntToStr(payload.grupo_prod) + ';' +payload.cod_prod ] );

        if not ConversaoUnidadeUtils.CriarSilent(Self.buscas.Database, payload) then
          sFalhas.Add(sItem)
        else
        begin
          dataSet.First;
          while not dataSet.Eof do
          begin
            AplicarConversaoDadosXML(payload);
            dataSet.Next;
          end;
        end;

      finally
        FreeAndNil(payload);
      end;
    end;

    sItens.Clear;
    for sItem in sFalhas do
    begin
      dataSet.First;
      while not dataSet.Eof do
      begin
        if (fstr('grupo_prod') = ExtractStr(sItem, 'grupo=', ';')) and
           (fstr('cod_prod') = ExtractStr(sItem, 'cod=', ';')) then
        begin
          sItens.Add(Format('Falha ao adicionar conversão para o produto [%d-%s] - %s - %s',
                            [fint('grupo_prod'), fstr('cod_prod'), fstr('num_fab_prod'), fstr('descricao_item')]));
          Break;
        end;
        dataSet.Next;
      end;
    end;

    if sItens.Count > 0 then
      ShowErro(sItens.Text);

  finally
    Self.prepare_loop_done();
    FreeAndNil(sFalhas);
    FreeAndNil(sItens);
    FreeAndNil(sEans);
  end;
end;

function TNFItem.calculaPreco(siglaPreco, MarkUpOuPreco: string;
  valor: Double): boolean;
type
  TipoCampo = (tcMarkup, tcMargem, tcPreco, tcPercentualAd);
var
  perclucro, calculoPreco, calculoMarkup, calculoMargem, custoProduto, percAdicional: Double;
  vValorTempMarkup: Extended;
  tipo: TipoCampo;
begin
  if RoundTo(valor, -3) <= 0 then
    Exit;

  custoProduto  := ffloat('prec_cusm_prod');
  calculoMarkup := 0;
  calculoPreco  := 0;
  calculoMargem := 0;
  percAdicional := 0;

  if MarkUpOuPreco = 'P' then
    tipo := tcPreco
  else if MatchStr(siglaPreco, ['3', '6', '9']) and vDadosIni.vProduto.Precos.UsarPercAdicional306090 and (FPrecoV > 0) then
    tipo := tcPercentualAd
  else if vDadosIni.vProduto.Precos.UsarMargemAoMarkup then
    tipo := tcMargem
  else
    tipo := tcMarkup;

  case tipo of
    tcMarkup:
      begin
        calculoMarkup := valor;//RoundTo(valor, DIGROUNDMAX);
        calculoPreco  := CalcUtils.Preco(custoProduto, calculoMarkup, DIGROUNDMAX);
        calculoMargem := CalcUtils.MargemLucro(calculoPreco, custoProduto, DIGROUNDMAX);
      end;

    tcMargem:
      begin
        calculoMargem := valor;//RoundTo(valor, DIGROUNDMAX);
        calculoMarkup := CalcUtils.Markup(calculoMargem, DIGROUNDMAX);
        calculoPreco  := CalcUtils.Preco(custoProduto, calculoMarkup, DIGROUNDMAX);
      end;

    tcPreco:
      begin
        calculoPreco  := valor;//RoundTo(valor, -vDadosIni.vEmp.vCasasDecimais);
        calculoMarkup := CalcUtils.Markup(calculoPreco, custoProduto, DIGROUNDMAX);
        calculoMargem := CalcUtils.MargemLucro(calculoPreco, custoProduto, DIGROUNDMAX);
      end;

    tcPercentualAd:
      begin
        percAdicional := valor;//RoundTo(valor, DIGROUNDMAX);
        valor         := RoundTo(FPrecoV, -vDadosIni.vEmp.vCasasDecimais);// arqui arredonda pois é o valor que finalmente ficará gravado
        calculoPreco  := RoundTo(valor * (1 + (percAdicional / 100)), DIGROUNDMAX);
      end;
  end;

  calculoMarkup := Abs(calculoMarkup);
  calculoPreco  := Abs(calculoPreco);
  calculoMargem := Abs(calculoMargem);
  percAdicional := Abs(percAdicional);

  if siglaPreco = 'V' then
  begin
    FPrecoV  := calculoPreco;
    FMarkUpV := calculoMarkup;
    //FMargemObtidaV := calculoMargem;
    if vDadosIni.vProduto.Precos.UsarPercAdicional306090  then
    begin
      if (not vDadosIni.vProduto.Precos.UsarPercDescPreco30Dias) or (FPerc30ToVrj <= 0)  then
        calculaPreco('3', 'M', FPercAdProd3);
      calculaPreco('6', 'M', FPercAdProd6);
      calculaPreco('9', 'M', FPercAdProd9);
    end;
  end
  else if siglaPreco = 'A' then
  begin
    FPrecoA  := calculoPreco;
    FMarkUpA := calculoMarkup;
    //FMargemObtidaA := calculoMargem;
  end
  else if siglaPreco = '3' then
  begin
    FPreco30  := calculoPreco;
    FMarkUp3 := calculoMarkup;

    if (tipo = tcPreco) and (siglaPreco = '3') and vDadosIni.vProduto.Precos.UsarPercDescPreco30Dias and (FPerc30ToVrj > 0) and (FPreco30 > 0) then
    begin
      valor        := RoundTo(FPreco30, -vDadosIni.vEmp.vCasasDecimais);// arqui arredonda pois é o valor que finalmente ficará gravado
      calculoPreco := Abs(RoundTo(valor * (1 - (FPerc30ToVrj / 100)), DIGROUNDMAX));
      calculaPreco('V', 'P', calculoPreco);
    end;
  end
  else if siglaPreco = '6' then
  begin
    FPreco60  := calculoPreco;
    FMarkUp6 := calculoMarkup;
  end
  else if siglaPreco = '9' then
  begin
    FPreco90  := calculoPreco;
    FMarkUp9 := calculoMarkup;
  end;
  {
  if FCalcUsandoMagem then  // calculo pela margem
  begin
    if MarkUpOuPreco = 'M' then
    begin
      if valor <= 0 then
        exit;

      calculoMargem := RoundTo(valor, - DIG_MARKMARG);
      calculoPreco := RoundTo(ffloat('prec_cusm_prod') / (1 - (calculoMargem / 100)), 0 - vDadosIni.vEmp.vCasasDecimais);
    end
    else
    begin
      calculoPreco := RoundTo(valor, 0 - vDadosIni.vEmp.vCasasDecimais);
      if (calculoPreco > 0) and (ffloat('prec_cusm_prod') > 0) then
        calculoMargem := RoundTo((((calculoPreco - ffloat('prec_cusm_prod')) / calculoPreco) * 100), - DIG_MARKMARG);
    end;

    if ffloat('prec_cusm_prod') > 0 then
      calculoMarkup := RoundTo(((calculoPreco - ffloat('prec_cusm_prod')) * 100) / ffloat('prec_cusm_prod'), - DIG_MARKMARG);

    if siglaPreco = 'V' then
    begin
      FMarkUpV := calculoMarkup;
      FMargemObtidaV := calculoMargem;
      FPrecoV := calculoPreco;

      if (FOwerNF.Config.Conf_Preco.UsarPercAdicional) then
      begin
        if (vProd.ffloat('PERC_AD_30') > 0) and (FPrecoV > 0) then
          FPreco30 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_30') / 100), 0 - vDadosIni.vEmp.vCasasDecimais);

        if (vProd.ffloat('PERC_AD_60') > 0) and (FPrecoV > 0) then
          FPreco60 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_60') / 100), 0 - vDadosIni.vEmp.vCasasDecimais);

        if (vProd.ffloat('PERC_AD_90') > 0) and (FPrecoV > 0) then
          FPreco90 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_90') / 100), 0 - vDadosIni.vEmp.vCasasDecimais);
      end;
    end
    else
    begin
      FMarkUpA := calculoMarkup;
      FMargemObtidaA := calculoMargem;
      FPrecoA := calculoPreco;
    end;
  end
  else
  if siglaPreco = 'V' then
  begin
    if MarkUpOuPreco = 'M' then
    begin
      if valor <= 0 then
        exit;
      FMarkUpV := RoundTo(valor, -2);
      FPrecoV := ffloat('prec_cusm_prod') + ((ffloat('prec_cusm_prod') * FMarkUpV) / 100);
      FPrecoV := RoundTo(FPrecoV, 0 - vDadosIni.vEmp.vCasasDecimais);

      vValorTempMarkup := (FPrecoV - ffloat('PREC_CUSM_PROD')) / ffloat('PREC_CUSM_PROD') * 100;

      if RoundTo(vValorTempMarkup, -2) < RoundTo(ffloat('PRCTB_ITEM'), -2) then
        FPrecoV := FPrecoV + 0.01;
    end
    else
    begin
      FPrecoV := RoundTo(valor, 0 - vDadosIni.vEmp.vCasasDecimais);
      if ffloat('prec_cusm_prod') > 0 then
        FMarkUpV := RoundTo(((FPrecoV - ffloat('prec_cusm_prod')) * 100) / ffloat('prec_cusm_prod'), -2);
    end;
    perclucro := (FPrecoV - dataSet.FieldByName('PREC_CUSM_PROD').AsFloat);
    if FPrecoV > 0 then
      FMargemObtidaV := RoundTo(((percLucro / FPrecoV) * 100), -2);

    if (FOwerNF.Config.Conf_Preco.UsarPercAdicional) then
    begin
      if (vProd.ffloat('PERC_AD_30') > 0) and (FPrecoV > 0) then
        FPreco30 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_30') / 100), -2);

      if (vProd.ffloat('PERC_AD_60') > 0) and (FPrecoV > 0) then
        FPreco60 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_60') / 100), -2);

      if (vProd.ffloat('PERC_AD_90') > 0) and (FPrecoV > 0) then
        FPreco90 := RoundTo(FPrecoV + (FPrecoV * vProd.ffloat('PERC_AD_90') / 100), -2);
    end;

  end
  else
  begin
    if MarkUpOuPreco = 'M' then
    begin
      FMarkUpA := RoundTo(valor, -2);
      FPrecoA := ffloat('prec_cusm_prod') + ((ffloat('prec_cusm_prod') * FMarkUpA) / 100);
      FPrecoA := RoundTo(FPrecoA, 0- vDadosIni.vEmp.vCasasDecimais);

      vValorTempMarkup := (FPrecoA - ffloat('PREC_CUSM_PROD')) / ffloat('PREC_CUSM_PROD') * 100;

      if RoundTo(vValorTempMarkup, -2) < RoundTo(dataSet.FieldByName('PRCTB_ITEMA').AsFloat, -2) then
        FPrecoA := FPrecoA + 0.01;
    end
    else
    begin
      FPrecoA := RoundTo(valor, 0 - vDadosIni.vEmp.vCasasDecimais);
      if ffloat('prec_cusm_prod') > 0 then
        FMarkUpA := ((FPrecoA - ffloat('prec_cusm_prod')) * 100) / ffloat('prec_cusm_prod');
    end;
    perclucro := (FPrecoA - ffloat('PREC_CUSM_PROD'));
    if FPrecoA > 0 then
      FMargemObtidaA := RoundTo(((percLucro / FPrecoA) * 100), -2);
  end;
  FPrecoV := RoundTo(FPrecoV, 0 - vDadosIni.vEmp.vCasasDecimais);
  FPrecoA := RoundTo(FPrecoA, 0 - vDadosIni.vEmp.vCasasDecimais);
  FMarkUpV := RoundTo(FMarkUpV, -2);
  FMarkUpA := RoundTo(FMarkUpA, -2);
  }
end;

function TNFItem.calculaPrecoAVistaPeloPrazo(valor: Double): Double;
begin
  Result := 0;
  if (FDescontoPrecoAVista > 0) and (valor > 0) then
  begin
    FPrecoV := RoundTo(valor - (valor * FDescontoPrecoAVista / 100), 0 - vDadosIni.vEmp.vCasasDecimais);
    Result := FPrecoV ;
    if ffloat('prec_cusm_prod') > 0 then
      FMarkUpV := RoundTo(((FPrecoV - ffloat('prec_cusm_prod')) * 100) / ffloat('prec_cusm_prod'), -2);
  end;
end;

procedure TNFItem.CalcularPrecoItemDataSet;
  function ArredondaPreco(Preco: Double): Double;
  begin
    Result := FOwerNF.ArredondaPreco(Preco);
  end;
begin
  if vDadosIni.vEmp.vUsarAltPrecoNFDigItem = 'S' then
    Exit;

  if (not vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF) then
    Exit;

  if (not vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
  begin
    dataSet.FieldByName('PREC_30_PROD').AsFloat := ArredondaPreco(CalcUtils.Preco(ffloat('PREC_CUSM_PROD'), ffloat('PRCTB_ITEM3'), DIGROUNDMAX));
    dataSet.FieldByName('PREC_60_PROD').AsFloat := ArredondaPreco(CalcUtils.Preco(ffloat('PREC_CUSM_PROD'), ffloat('PRCTB_ITEM6'), DIGROUNDMAX));
    dataSet.FieldByName('PREC_90_PROD').AsFloat := ArredondaPreco(CalcUtils.Preco(ffloat('PREC_CUSM_PROD'), ffloat('PRCTB_ITEM9'), DIGROUNDMAX));
  end;

  if (vDadosIni.vProduto.Precos.UsarPercDescPreco30Dias) and
     (not vDadosIni.vProduto.Precos.UsarPercAdicional306090) and
     (vProd.ffloat('PDESC_PR30_VAREJO') > 0) and
     (ffloat('PREC_30_PROD') > 0) then
    dataSet.FieldByName('PREC_VND_PROD').AsFloat := ArredondaPreco(RoundTo(ffloat('PREC_30_PROD') * (1 - vProd.ffloat('PDESC_PR30_VAREJO') / 100), DIGROUNDMAX))
  else
    dataSet.FieldByName('PREC_VND_PROD').AsFloat := ArredondaPreco(CalcUtils.Preco(ffloat('PREC_CUSM_PROD'), ffloat('PRCTB_ITEM'), DIGROUNDMAX));

  dataSet.FieldByName('PREC_VND_PRODA').AsFloat := ArredondaPreco(CalcUtils.Preco(ffloat('PREC_CUSM_PROD'), ffloat('PRCTB_ITEMA'), DIGROUNDMAX));

  if (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
  begin
    if (not vDadosIni.vProduto.Precos.UsarPercAdicional306090) or (vProd.ffloat('PDESC_PR30_VAREJO') <= 0) then
      dataSet.FieldByName('PREC_30_PROD').AsFloat := ArredondaPreco(RoundTo(ffloat('PREC_VND_PROD') * (1 + vProd.ffloat('PERC_AD_30') / 100), DIGROUNDMAX));
    dataSet.FieldByName('PREC_60_PROD').AsFloat := ArredondaPreco(RoundTo(ffloat('PREC_VND_PROD') * (1 + vProd.ffloat('PERC_AD_60') / 100), DIGROUNDMAX));
    dataSet.FieldByName('PREC_90_PROD').AsFloat := ArredondaPreco(RoundTo(ffloat('PREC_VND_PROD') * (1 + vProd.ffloat('PERC_AD_90') / 100), DIGROUNDMAX));
  end;

  HandleMarkupMargemCalculados;

end;

function TNFItem.calcucarAntecipacaoTributariaST(nota: TNFCab;
  operacao: C_OperacaoDiversas): string;
var
  MVA, AliqIntraICM, AliqInterICM, BaseCalcICM, BaseCalcICMSST, ValorICMSST, ValorICM: Double;
  MVAAJ, VRTMP: Double;
  buscas2, buscas3: TIBQuery;
  StateBrowse, UsarIcmsDoXML: Boolean;
  CST_ICM, CST_PROD_ICM: string;
  List, ListD: TStrings;
  ListEspelho: TStrings;
  STRTMP: string;
  I: Integer;

  procedure obterdados_cest_v2(varId: Integer; cest: string = '');
  begin
    //definido aliquota do icms caso o cestv2 ativado para colocar na busca
    if FOwerNF.fint('cod_cliente') <> FOwerNF.vClFor.fint('cod_cliente') then
      FOwerNF.vClFor.selecionaClFor;
    if UsarIcmsDoXML then
      AliqInterICM := dataSet.FieldByName('aliq_icm_xml').AsFloat;
    if AliqInterICM = 0 then
      if (vDadosIni.vEmp.vSiglaUF <> nota.getUFdaOperacao) and (vDadosIni.vEmp.vRegime <> 'SIMPLES') and
        (vDadosIni.strIn(Copy(fstr('cst'), 1, 1), ['1', '2', '3'])) then
        AliqInterICM := 4
      else
        AliqInterICM := IfThen(vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao, AliqIntraICM, nota.vClFor.icm_ext_c);
    if FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
    begin
      MVA := 0;
      try
        vrDadosItem.cest             := IfThen(cest = '', fstr('cest'), cest);
        vrDadosItem.ncm              := fstr('ncm');
        vrDadosItem.tipo_item        := fstr('tipo_item');
        vrDadosItem.cst              := fstr('cst');
        vrDadosItem.aliq_icm         := AliqInterICM;
        vrDadosItem.Cest_Variante_Id := varId;

        if vrDadosItem.getDadosSubstituicaoTributaria(vDadosIni.vEmp.vSiglaUF,
                                                      FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.GetRamoAtividade(FOwerNF.fstr('natureza_nf'), FOwerNF.fstr('cpfcgc'))) then
          MVA := vrDadosItem.FMVA
      finally
        vrDadosItem.cest             := '';
        vrDadosItem.ncm              := '';
        vrDadosItem.tipo_item        := '';
        vrDadosItem.cst              := '';
        vrDadosItem.aliq_icm         := 0;
        vrDadosItem.Cest_Variante_Id := 0;
      end;
    end
  end;

begin
  // para efeito de retorno, é possivel haver 3 tipos diferentes, veja abaixo:
  // |OK|: O sistema nao encontrou nenhum problema ao efetuar os calculos, ou nao houve calculo algum
  // |OK|Mensagem|: O sistema encontrou algum problema e apenas apresenta a mensagem ao usuário
  // |Mensagem|: O sistema encontrou algum problema e vai pedir processo ao usuario, isso somente no calculo de custo das mercadorias, consequentemente na confirmação da nota
  Result := 	'|OK|';
  StateBrowse := not (dataSet.State in [dsInsert, dsEdit]);
  ListEspelho := TStringList.Create;
  ListEspelho.Clear;

  CST_ICM := Copy(dataSet.FieldByName('cst').AsString, 2, 2);
  if (vDadosIni.strIn(CST_ICM, ['10', '30', '70'])) and
    (dataSet.FieldByName('antec_trib').AsString <> 'S') then
    Exit;

  if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) and
    (CST_ICM = '60') and (dataSet.FieldByName('antec_trib').AsString <> 'S') then
    Exit;

  if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) and
    (nota.Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'DesativarEmOperacaoInterna') = 'S') then
  begin    
    if StateBrowse then
      dataSet.Edit;
    dataSet.FieldByName('base_icmsub_ant').AsFloat  := 0;
    dataSet.FieldByName('valor_icmsub_ant').AsFloat := 0;
    dataSet.FieldByName('antec_trib').AsString := '';
    dataSet.FieldByName('espelho_calc_st').AsString := '';
    if StateBrowse then
      dataSet.Post;
    Exit;
  end;

  // teste adicionado para permitir a entrada de nota com calculo de st usando o cst 60
  if (CST_ICM = '60') // cst 60
    and (FCalcIcmsSTEntNF_Cst60) // habilitado o calculo de ST para cst 60
    and (dataSet.FieldByName('antec_trib').AsString <> 'S') // sem antecipacao tributaria
    and (dataSet.FieldByName('base_icmsub').AsFloat > 0) then // e com valor de icms st destacado
    Exit;

  // se o usuario informou que ele mesmo vai digitar entao não importa os valores da tabela de NCM
  if dataSet.FieldByName('ant_calc').AsString = 'D' then  //S: Sim, Sistema calcula; D: Usuario digita
  begin
    if (dataSet.FieldByName('base_icmsub_ant').AsFloat = 0) or
      (dataSet.FieldByName('valor_icmsub_ant').AsFloat = 0) then
    begin
      Result := vDadosIni.IfThen(operacao = opdCalculoCusto, '', '|OK') +
        '|Item marcado com Antecipação Tributária (digitada), porém, ' +
        'Valores Base de Calculo e/ou Valor do ICMS de Antecipação tributária não preenchidos|';
      Exit;
    end
    else
    begin
      ValorICMSST    := vDadosIni.StrToFloatFormat(dataSet.FieldByName('valor_icmsub_ant').AsFloat * dataSet.FieldByName('quantidade').AsFloat, 2);
      BaseCalcICMSST := vDadosIni.StrToFloatFormat(dataSet.FieldByName('base_icmsub_ant').AsFloat * dataSet.FieldByName('quantidade').AsFloat, 2);
      if StateBrowse then
        dataSet.Edit;
      ListEspelho.Add('ANT TRIB DIGITADA');
      ListEspelho.Add('BASE ST : ' + Format('%8.2n', [BaseCalcICMSST]));
      ListEspelho.Add('VALOR ST :' + Format('%8.2n', [ValorICMSST]));
      dataSet.FieldByName('antec_trib').AsString      := vDadosIni.IfThen(ValorICMSST    > 0, 'S'           , '');
      dataSet.FieldByName('base_icmsub').AsFloat      := vDadosIni.IfThen(BaseCalcICMSST > 0, BaseCalcICMSST, 0);
      dataSet.FieldByName('valor_icmsub').AsFloat     := vDadosIni.IfThen(ValorICMSST    > 0, ValorICMSST   , 0);
      dataSet.FieldByName('cst').AsString             :=
        Copy(dataSet.FieldByName('cst').AsString,1,1) +  vDadosIni.IfThen(ValorICMSST    > 0,
                                                         vDadosIni.IfThen(vDadosIni.strIn(CST_ICM, ['10','30','70']), CST_ICM, '60'), CST_ICM);
      dataSet.FieldByName('base_icm').AsFloat         := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('base_icm').AsFloat);
      dataSet.FieldByName('aliq_icm').AsFloat         := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('aliq_icm').AsFloat);
      dataSet.FieldByName('valor_icm').AsFloat        := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('valor_icm').AsFloat);
      dataSet.FieldByName('espelho_calc_st').AsString := Copy(ListEspelho.Text, 1, 512);
      if StateBrowse then
        dataSet.Post;
      if nota.dataSet.State in [dsEdit, dsInsert] then
        nota.dataSet.FieldByName('antec_trib').AsString := 'S';
      Exit;
    end;
  end;

  MVA := 0;
  MVAAJ := 0;
  AliqIntraICM := 0;
  AliqInterICM := 0;
  ValorICM := 0;
  buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
  buscas3 := TIBQuery(dtmNF.qrBuscasNf3);
  if dataSet.FieldByName('tipo_item').AsString = 'P' then
  begin
    buscas2.Close;
    buscas2.SQL.Text := 'select first 1 nbm.mva, pr.nbm, pr.icm_prod, pr.cest,' +
      ' pr.isento_prod, pr.n_incidencia_prod, pr.cst_prod, nbm.aliq_intra, pr.cest_variante_id ' +
      ' from produtos pr' +
      ' left join nbm on nbm.cod_ncm = pr.nbm' +
      ' where pr.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas2.Open;

    //de acordo a Elenice da Tonziro o MVA ajustado existe sempre que a aliquota intra for maior que a inter
    // para qualquer estado, sendo assim a parte abaixo é desconsiderada
//    if getDadosSubstituicaoTribNbmEstado(nota.vClFor.dataSet.FieldByName('codigo_uf').AsInteger,
//      buscas2.FieldByName('nbm').AsString) then
//    begin
//      MVA          := vrDadosItem.FMvaNbmEstado;
//      AliqIntraICM := vrDadosItem.FAliqNbmEstado;
//    end;
//    if (MVA = 0) and (buscas2.FieldByName('mva').AsFloat > 0) then
    if (buscas2.FieldByName('mva').AsFloat > 0) then
      MVA := buscas2.FieldByName('mva').AsFloat;
    if dataSet.FieldByName('aliq_icmsub').AsFloat > 0 then
      AliqIntraICM := dataSet.FieldByName('aliq_icmsub').AsFloat
    else if buscas2.FieldByName('icm_prod').AsFloat > 0 then
      AliqIntraICM := buscas2.FieldByName('icm_prod').AsFloat
    else if buscas2.FieldByName('aliq_intra').AsFloat > 0 then
      AliqIntraICM := buscas2.FieldByName('aliq_intra').AsFloat;

    obterdados_cest_v2(buscas2.FieldByName('cest_variante_id').AsInteger, buscas2.FieldByName('cest').AsString);

    /// o teste abaixo é o teste que deixa o sistema funcionando da mesma forma de antes
    ///  a diferenca é a configuracao "nf_hab_validacao_antecipacao_st"
    if MVA > 0 then // item com MVA
      if (CST_ICM <> '60') or (dataSet.FieldByName('antec_trib').AsString <> 'S') then // caso o item nao tenha um cst de antecipacao ou nao tenha sido marcado como antecipacao
        if not AsTrueValue(FOwerNF.Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_f) then  // o sistema NAO esta habilitado para calcular e validar a antecipacao
          Exit;

    // teste que nao vai verificar antencipação tributárias nas devoluções 
    if ((Trim(nota.dataSet.FieldByName('modelo_nf').AsString) = '55')           // nota fiscal eletronica
      and (Trim(nota.dataSet.FieldByName('tipo_emissao').AsString) = '4'))      // de devolucao
      or ((Trim(nota.dataSet.FieldByName('modelo_nf').AsString) <> '55')        // nota fiscal comum nao eletronica
      and (Trim(nota.dataSet.FieldByName('devolucao').AsString) = 'SIM')) then  // de devolucao
    begin
      //ListD := TStringList.Create;
      ListD := FOwerNF.Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_b;
      if ListD.Count = 2 then
        if vDadosIni.getValue(ListD[1], 1) = 'S' then
          Exit;
    end;

    if MVA > 0 then
      if AsTrueValue(FOwerNF.Config.Conf_Geral.nf_hab_alerta_calc_ant_st_itens_por_cst.value1_f) then
      begin
        CST_PROD_ICM := Copy(buscas2.FieldByName('cst_prod').AsString, 2, 2);
        //List := TStringList.Create;
        List := FOwerNF.Config.Conf_Geral.nf_hab_alerta_calc_ant_st_itens_por_cst.value1_b;
        for I := 0 to List.Count - 1 do
          if Pos('|' + CST_PROD_ICM + '|', List[i]) > 0 then
          begin
            if vDadosIni.strIn(Copy(vDadosIni.getValue(List[I], 2), 1, 1), ['A', 'N']) then
            begin
              MVA := 0;
              if Copy(vDadosIni.getValue(List[I], 2), 1, 1) = 'N' then //Nao Alertar e Nao Calcular
                Result := '|OK|'
              else if Copy(vDadosIni.getValue(List[I], 2), 1, 1) = 'A' then //Alertar e Nao Calcular
                Result := vDadosIni.IfThen((vDadosIni.getValue(List[I], 1) = 'S') and (operacao = opdCalculoCusto), '', '|OK') + // se nao pedir processo apenas mensagem, senao vai como erro e pede processo
                  '|CST do Cadastro do Produto configurado para não calcular antecipação de ICMS. Verifique com a sua contabilidade|';

              if StateBrowse then
                dataSet.Edit;
              dataSet.FieldByName('base_icmsub_ant').AsFloat  := 0;
              dataSet.FieldByName('valor_icmsub_ant').AsFloat := 0;
              dataSet.FieldByName('antec_trib').AsString := '';
              if StateBrowse then
                dataSet.Post;
              Exit;
            end
            else if Copy(vDadosIni.getValue(List[I], 1), 1, 1) = 'C' then //Calcular e Alertar
              Result := vDadosIni.IfThen((vDadosIni.getValue(List[I], 1) = 'S') and (operacao = opdCalculoCusto), '', '|OK') + // se nao pedir processo apenas mensagem, senao vai como erro e pede processo
                '|CST do Cadastro do Produto = "' + CST_PROD_ICM +
                '". O sistema vai calcular a antecipação de ICMS. Verifique com a sua contabilidade|';
          end;
      end;
  end
  else if (dataSet.FieldByName('tipo_item').AsString = 'O') and
    (Trim(dataSet.FieldByName('ncm').AsString) <> '') then
  begin
//    if getDadosSubstituicaoTribNbmEstado(nota.vClFor.dataSet.FieldByName('codigo_uf').AsInteger,
//      buscas2.FieldByName('cod_ncm').AsString) then
//    begin
//      MVA          := vrDadosItem.FMvaNbmEstado;
//      AliqIntraICM := vrDadosItem.FAliqNbmEstado;
//    end;
    if (MVA = 0) then
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select first 1 nbm.mva, nbm.cod_ncm, nbm.aliq_intra from nbm' +
        ' where nbm.cod_ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString);
      buscas2.Open;
      if buscas2.FieldByName('mva').AsFloat > 0 then
        MVA := buscas2.FieldByName('mva').AsFloat;
      if dataSet.FieldByName('aliq_icmsub').AsFloat > 0 then
        AliqIntraICM := dataSet.FieldByName('aliq_icmsub').AsFloat
      else if buscas2.FieldByName('aliq_intra').AsFloat > 0 then
        AliqIntraICM := buscas2.FieldByName('aliq_intra').AsFloat;

      obterdados_cest_v2(0);
    end;
    /// o teste abaixo é o teste que deixa o sistema funcionando da mesma forma de antes
    ///  a diferenca é a configuracao "nf_hab_validacao_antecipacao_st"
    if MVA > 0 then // item com MVA
      if (CST_ICM <> '60') or (dataSet.FieldByName('antec_trib').AsString <> 'S') then // caso o item nao tenha um cst de antecipacao ou nao tenha sido marcado como antecipacao
        if not AsTrueValue(FOwerNF.Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_f) then  // o sistema NAO esta habilitado para calcular e validar a antecipacao
          Exit;
  end;
  if MVA <= 0 then
  begin
    if StateBrowse then
      dataSet.Edit;
    dataSet.FieldByName('base_icmsub_ant').AsFloat  := 0;
    dataSet.FieldByName('valor_icmsub_ant').AsFloat := 0;
    dataSet.FieldByName('antec_trib').AsString := '';
    dataSet.FieldByName('espelho_calc_st').AsString := '';
    if StateBrowse then
      dataSet.Post;
    Exit;
  end;

  if AliqIntraICM > 0 then
    AliqIntraICM := AliqIntraICM
//  else if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
//    AliqIntraICM := 18
  else if vDadosIni.vEmp.vAliqIntraEstadual > 0 then
    AliqIntraICM := vDadosIni.vEmp.vAliqIntraEstadual
  else if vDadosIni.vEmp.vAliqPadrao > 0 then
    AliqIntraICM := vDadosIni.vEmp.vAliqPadrao
  else if AliqIntraICM = 0 then
    AliqIntraICM := 18;

  //obtendo a base de icms caso o valor do xml nao exista ou nao seja usado
  BaseCalcICM := ((dataSet.FieldByName('valor_unitario').AsFloat * dataSet.FieldByName('quantidade').AsFloat) -
    dataSet.FieldByName('rateio_desconto').AsFloat + (
    dataSet.FieldByName('RATEIO_SEGURO').AsFloat + dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
    dataSet.FieldByName('RATEIO_DESP_PF').AsFloat + dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat +
    vDadosIni.IfThen( nota.dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S',
      dataSet.FieldByName('RATEIO_FRETE').AsFloat, 0))
    );// / dataSet.FieldByName('quantidade').AsFloat;

  ListEspelho.Add('ANT TRIB CALC');
  STRTMP := 'VR MERC + IPI + DESP = ';
  VRTMP := (dataSet.FieldByName('valor_unitario').AsFloat * dataSet.FieldByName('quantidade').AsFloat) - dataSet.FieldByName('rateio_desconto').AsFloat ;
  STRTMP := STRTMP + Format( '%0.2f', [ VRTMP ]) + ' + ';
  VRTMP := dataSet.FieldByName('valor_ipi').AsFloat;
  STRTMP := STRTMP + Format( '%0.2f', [ VRTMP ]) + ' + ';
  VRTMP := (dataSet.FieldByName('RATEIO_SEGURO').AsFloat + dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
      dataSet.FieldByName('RATEIO_DESP_PF').AsFloat + dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat +
      vDadosIni.IfThen( nota.dataSet.FieldByName('FRETE_F_NFE').AsString <> 'S',
        dataSet.FieldByName('RATEIO_FRETE').AsFloat, 0));
  STRTMP := STRTMP + Format( '%0.2f', [ VRTMP ]) + ' = ';
  VRTMP := BaseCalcICM + dataSet.FieldByName('valor_ipi').AsFloat;
  STRTMP := STRTMP + Format( '%0.2f', [ VRTMP ]);
  ListEspelho.Add(STRTMP);

  UsarIcmsDoXML := (dataSet.FieldByName('valor_icm_xml').AsFloat >  0) and (FOwerNF.Config.Conf_Geral.nf_hab_antecipacao_st_usar_icms_xml);

  if UsarIcmsDoXML then
  begin
    ValorICM := dataSet.FieldByName('valor_icm_xml').AsFloat;
    AliqInterICM := dataSet.FieldByName('aliq_icm_xml').AsFloat;
  end;

  // o *(asterisco) indica que nao foi usado os valores do xml
  if AliqInterICM > 0 then
    ListEspelho.Add('ALIQ INTER..:' + Format( '%11.2n', [ AliqInterICM]))
  else
  begin
    if (vDadosIni.vEmp.vSiglaUF <> nota.getUFdaOperacao) and
      (vDadosIni.vEmp.vRegime <> 'SIMPLES') and
      (vDadosIni.strIn(Copy(dataSet.FieldByName('cst').AsString, 1, 1), ['1', '2', '3'])) then
      AliqInterICM := 4
    else if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) then
      AliqInterICM := AliqIntraICM
    else
    begin
      if nota.vClFor.icm_ext_c = 0 then
      begin
        Result := vDadosIni.IfThen(operacao = opdCalculoCusto, '', '|OK') +
          '|Item sem aliquota de ICMS Interestadual (CFOP Mud)|';
        Exit;
      end
      else
        AliqInterICM := nota.vClFor.icm_ext_c;
    end;
    ListEspelho.Add('*ALIQ INTER.:' + Format( '%11.2n', [ AliqInterICM]))
  end;

  if ValorICM > 0 then
    ListEspelho.Add('VALOR ICMS..:' + Format( '%11.2n', [ ValorICM]))
  else
  begin
    ValorICM := vDadosIni.StrToFloatFormat(BaseCalcICM * AliqInterICM / 100, 2);
    ListEspelho.Add('*VALOR ICMS.:' +
      Format( '%11.2n', [ BaseCalcICM ]) + ' * ' +
      Format( '%0.2n', [ AliqInterICM / 100 ]) + ' = ' +
      Format( '%0.2n', [ ValorICM ])
    );
  end;
  ListEspelho.Add('ALIQ INTRA..:' + Format( '%11.2n', [ AliqIntraICM ]));
  ListEspelho.Add('MVA ORIGINAL:' + Format( '%11.2n', [ MVA ]));
  //calculando o mva ajustado
  if (AliqIntraICM > AliqInterICM) and
     ((not FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa) or (vrDadosItem.AjustarMVA)) then //((A * B) - 1) * 100
    MVAAJ := vrDadosItem.ExecutarAjusteMVA(MVA, AliqInterICM, AliqIntraICM)
    //MVAAJ :=(( (1 + (MVA / 100)) * ((1 - (AliqInterICM / 100)) / (1 - (AliqIntraICM / 100))) ) - 1 ) * 100
  else
    MVAAJ := MVA;
  if MVAAJ <> MVA then
    ListEspelho.Add('MVA AJUSTADO:' + Format( '%11.2n', [ MVAAJ ]));

  VRTMP := vDadosIni.StrToFloatFormat(BaseCalcICM + dataSet.FieldByName('valor_ipi').AsFloat, 2);
  BaseCalcICMSST := vDadosIni.StrToFloatFormat(VRTMP * ( 1 + ( MVAAJ / 100 )),2);

  ListEspelho.Add('BASE ST.....:' +
    Format( '%11.2n', [ VRTMP ]) + ' * ( 1 + ( ' +
    Format( '%3.2n', [ MVAAJ ]) + ' / 100 )) = ' +
    Format( '%0.2n', [ BaseCalcICMSST ])
  );
  ValorICMSST := vDadosIni.StrToFloatFormat( BaseCalcICMSST * AliqIntraICM / 100, 2);
  ListEspelho.Add('             ' +
    Format( '%11.2n', [ BaseCalcICMSST ]) + ' * ' +
    Format( '%0.2n', [ AliqIntraICM ]) + ' = ' +
    Format( '%0.2n', [ ValorICMSST])
  );
  VRTMP := ValorICMSST;
  ValorICMSST := VRTMP - ValorICM;
  ListEspelho.Add('VALOR ST    :' +
    Format( '%11.2n', [ VRTMP ]) + ' - ' +
    Format( '%0.2n', [ ValorICM ]) + ' = ' +
    Format( '%0.2n', [ ValorICMSST])
  );
  {
//  caso deva considerar o icms que ja veio na nota fiscal
  if UsarIcmsDoXML then
    ValorICMSST := vDadosIni.StrToFloatFormat((BaseCalcICMSST * AliqIntraICM / 100) -
      dataSet.FieldByName('valor_icm').AsFloat, 2)
  else
  begin
    if (vDadosIni.vEmp.vSiglaUF <> nota.dataSet.FieldByName('dest_uf').AsString) and
      (vDadosIni.vEmp.vRegime <> 'SIMPLES') and
      (vDadosIni.strIn(Copy(dataSet.FieldByName('cst').AsString, 1, 1), ['1', '2', '3'])) then
      AliqInterICM := 4
    else if (vDadosIni.vEmp.vSiglaUF = nota.dataSet.FieldByName('dest_uf').AsString) then
      AliqInterICM := AliqIntraICM
    else
    begin
      if nota.vClFor.icm_ext_c = 0 then
      begin
        Result := vDadosIni.IfThen(operacao = opdCalculoCusto, '', '|OK') +
          '|Item sem aliquota de ICMS Interestadual (CFOP Mud)|';
        Exit;
      end
      else
        AliqInterICM := nota.vClFor.icm_ext_c;
    end;
    ValorICM := vDadosIni.StrToFloatFormat(BaseCalcICM * AliqInterICM / 100, 2);
    ValorICMSST := vDadosIni.StrToFloatFormat((BaseCalcICMSST * AliqIntraICM / 100) -
      ValorICM, 2)
  end;
  }
  if (BaseCalcICMSST < 0) or (ValorICMSST < 0) then
  begin
    BaseCalcICMSST := 0;
    ValorICMSST    := 0;
  end;

  if StateBrowse then
    dataSet.Edit;
//  caso deva considerar o icms que ja veio na nota fiscal
  dataSet.FieldByName('antec_trib').AsString      := vDadosIni.IfThen(ValorICMSST    > 0, 'S'           , '');
  dataSet.FieldByName('base_icmsub').AsFloat      := vDadosIni.IfThen(BaseCalcICMSST > 0, BaseCalcICMSST, 0);
  dataSet.FieldByName('valor_icmsub').AsFloat     := vDadosIni.IfThen(ValorICMSST    > 0, ValorICMSST   , 0);
  dataSet.FieldByName('base_icmsub_ant').AsFloat  := vDadosIni.IfThen(BaseCalcICMSST > 0, BaseCalcICMSST / dataSet.FieldByName('quantidade').AsFloat, 0);
  dataSet.FieldByName('valor_icmsub_ant').AsFloat := vDadosIni.IfThen(ValorICMSST    > 0, ValorICMSST / dataSet.FieldByName('quantidade').AsFloat   , 0);
  dataSet.FieldByName('cst').AsString             :=
    Copy(dataSet.FieldByName('cst').AsString,1,1) +  vDadosIni.IfThen(ValorICMSST    > 0,
                                                     vDadosIni.IfThen(vDadosIni.strIn(CST_ICM, ['10','30','70']), CST_ICM, '60'), CST_ICM);
  dataSet.FieldByName('base_icm').AsFloat         := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('base_icm').AsFloat);
  dataSet.FieldByName('aliq_icm').AsFloat         := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('aliq_icm').AsFloat);
  dataSet.FieldByName('valor_icm').AsFloat        := vDadosIni.IfThen(ValorICMSST    > 0, 0, dataSet.FieldByName('valor_icm').AsFloat);
  dataSet.FieldByName('espelho_calc_st').AsString := Copy(ListEspelho.Text, 1, 512);
  if StateBrowse then
    dataSet.Post;
  if nota.dataSet.State in [dsEdit, dsInsert] then
    nota.dataSet.FieldByName('antec_trib').AsString := 'S';
end;

procedure TNFItem.calcucarReconposicaoDeICMS(nota: TNFCab);
var
  AStateBrowse, AUsarPercReducaoDaNFe, ASempreUsarCreditoDaNFe,
    ACalcularIcmsQuandoZero: Boolean;
  AConf, AEspelho: TStrings;
  ABuscas: TIBQuery;
  ACST_CSOSN, ACSTCSOSN_IT: string;
  AVLOP, AAliqCred, AAliqInterna, ABCICMCred, ABCICMInterno, ABCICMInternoCalc,
    AICMCredito, AICMInterno, ARedICMCred, ARedICMInterno,
    AICMRecomposicao, AAliqDefault: Double;
begin
  if nota.dataSet.FieldByName('emissao_propria').AsString = 'S' then
    Exit;
  // dentro do mesmo estado não se calcula
  if (vDadosIni.vEmp.vSiglaUF = nota.getUFdaOperacao) then
    Exit;

  ABuscas          := TIBQuery(dtmNF.qrBuscasNf2);
  AConf            := TStringList.Create;
  try
    // verificando a configuração
    if not FOwerNF.Config.Conf_Geral.nf_e_add_calc_recomposicao_ao_custo then  // o sistema NAO esta habilitado para calcular a recomposicao
      Exit;

    AEspelho         := TStringList.Create;
    AICMRecomposicao := 0;
    AStateBrowse     := not (dataSet.State in [dsInsert, dsEdit]);
    AEspelho.Clear;//.Text := dataSet.FieldByName('espelho_calc_st').AsString;
    try
      AConf.Text := TConfig_sistema_class.getConf('nf_e_add_calc_recomposicao_ao_custo', buscas, vDadosIni.cod_empresa).value1_b.Text;

      ACST_CSOSN              := ',' + vDadosIni.GetIni('Configuracao', 'CST_CSOSN', '00,20,90,101,900', AConf) + ',';
      AUsarPercReducaoDaNFe   :=       vDadosIni.GetIni('Configuracao', 'UsarPercReducaoDaNFe', 'S', AConf) = 'S';
      ASempreUsarCreditoDaNFe :=       vDadosIni.GetIni('Configuracao', 'SempreUsarCreditoDaNFe', 'S', AConf) = 'S';
      ACalcularIcmsQuandoZero :=       vDadosIni.GetIni('Configuracao', 'CalcularIcmsQuandoZero', 'N', AConf) = 'S';
      AAliqDefault            := StrToFloatDef(vDadosIni.GetIni('Configuracao', 'AliquotaIcmsQuandoZero', '0', AConf), 0);

      if Trim(dataSet.FieldByName('csosn').AsString) <> '' then
        ACSTCSOSN_IT := dataSet.FieldByName('csosn').AsString
      else
        ACSTCSOSN_IT := Copy(dataSet.FieldByName('cst').AsString, 2, 2);

      if Pos(',' + ACSTCSOSN_IT + ',', ACST_CSOSN) = 0 then
        Exit;

      if dataSet.FieldByName('valor_icmsub').AsFloat > 0 then
        Exit;

      AStateBrowse := not (dataSet.State in [dsInsert, dsEdit]);

      AVLOP := (dataSet.FieldByName('valor_unitario').AsFloat * dataSet.FieldByName('quantidade').AsFloat) -
                 dataSet.FieldByName('rateio_desconto').AsFloat + (
                 dataSet.FieldByName('rateio_seguro').AsFloat + dataSet.FieldByName('rateio_outdesp').AsFloat +
                 dataSet.FieldByName('rateio_desp_pf').AsFloat + dataSet.FieldByName('rateio_acres_fin').AsFloat +
                 vDadosIni.IfThen( nota.dataSet.FieldByName('frete_f_nfe').AsString <> 'S',
                 dataSet.FieldByName('rateio_frete').AsFloat, 0));

      AAliqCred   := dataSet.FieldByName('aliq_icm').AsFloat;
      ARedICMCred := dataSet.FieldByName('perc_red_prod').AsFloat;
      ABCICMCred  := dataSet.FieldByName('base_icm').AsFloat;
      AICMCredito := dataSet.FieldByName('valor_icm').AsFloat;

      if (ASempreUsarCreditoDaNFe) then
      else if ((ABCICMCred = 0) or (AAliqCred = 0) or (ABCICMCred = 0)) and (ACalcularIcmsQuandoZero) then
      begin
        AAliqCred := AAliqDefault;
        ABCICMCred := AVLOP;
        ABCICMCred := RoundTo(ABCICMCred * IfThen(ARedICMCred > 0, ARedICMCred / 100, 1.00), -2);
        AICMCredito := RoundTo(ABCICMCred * AAliqCred / 100, -2);
      end;
      {
      if (not ASempreUsarCreditoDaNFe) and (AAliqCred = 0) and (AAliqDefault > 0) then
      begin
        AAliqCred := AAliqDefault;
        if ABCICMCred = 0 then
        begin
          ABCICMCred := ((dataSet.FieldByName('valor_unitario').AsFloat * dataSet.FieldByName('quantidade').AsFloat) -
                          dataSet.FieldByName('rateio_desconto').AsFloat + (
                          dataSet.FieldByName('rateio_seguro').AsFloat + dataSet.FieldByName('rateio_outdesp').AsFloat +
                          dataSet.FieldByName('rateio_desp_pf').AsFloat + dataSet.FieldByName('rateio_acres_fin').AsFloat +
                          vDadosIni.IfThen( nota.dataSet.FieldByName('frete_f_nfe').AsString <> 'S',
                          dataSet.FieldByName('rateio_frete').AsFloat, 0))
          );
          ABCICMCred := RoundTo(ABCICMCred * IfThen(ARedICMCred > 0, ARedICMCred / 100, 1.00), -2);
        end;
        AICMCredito := RoundTo(ABCICMCred * AAliqCred / 100, -2);
      end;
      }

      if dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        ABuscas.Close;
        ABuscas.SQL.Text := 'select first 1 pr.icm_prod, nbm.aliq_intra, pr.perc_red_prod ' +
          ' from produtos pr' +
          ' left join nbm on nbm.cod_ncm = pr.nbm' +
          ' where pr.grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
          ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        ABuscas.Open;
      end
      else
      begin
        ABuscas.Close;
        ABuscas.SQL.Text := 'select first 1 nbm.aliq_intra icm_prod, es.aliq_intra, 0 perc_red_prod ' +
          ' from estados es' +
          ' left join nbm on nbm.cod_ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString) +
          ' where es.codigo_uf = ' + IntToStr(vDadosIni.vEmp.vCodigo_Uf);
        ABuscas.Open;
      end;

      AAliqInterna      := IfThen(ABuscas.FieldByName('icm_prod').AsFloat > 0,
                                  ABuscas.FieldByName('icm_prod').AsFloat,
                                  ABuscas.FieldByName('aliq_intra').AsFloat);
      if AAliqInterna = 0 then
      begin
        AICMRecomposicao := 0;
        AEspelho.Clear;
        Exit;
      end;
      ARedICMInterno    := IfThen(AUsarPercReducaoDaNFe,
                                  ARedICMCred,
                                  ABuscas.FieldByName('perc_red_prod').AsFloat
                                  );
      if (not AUsarPercReducaoDaNFe) and (ARedICMInterno > 0) then
        ARedICMInterno := IfThen(vDadosIni.vEmp.vUsarReducaoInvertida = 'S',
                                 100 - ARedICMInterno, ARedICMInterno);

      ABCICMInterno     := RoundTo(( AVLOP - (AVLOP * AAliqCred / 100)) / ( 1 - AAliqInterna / 100), -2);
      ABCICMInternoCalc := ABCICMInterno;
      ABCICMInterno     := IfThen(ARedICMInterno > 0, ABCICMInterno * (100 - ARedICMInterno) / 100, ABCICMInterno);
      AICMInterno       := RoundTo(ABCICMInterno * AAliqInterna / 100, -2);
      AICMRecomposicao  := AICMInterno - AICMCredito;

      AEspelho.Clear;
      AEspelho.Add('Recomposição ICMS');
      AEspelho.Add('Valor da Operação    : ' + Format('%10.2n', [AVLOP])            + ' = vl.merc+desp-desc');
      AEspelho.Add('Aliquota ICM Crédito : ' + Format('%10.2n', [AAliqCred])        );
      AEspelho.Add('% Red BC ICMS Ent    : ' + Format('%10.2n', [ARedICMCred])      );
      AEspelho.Add('BC-ICMS Entrada      : ' + Format('%10.2n', [ABCICMCred])       );
      AEspelho.Add('ICMS Crédito(Ent)    : ' + Format('%10.2n', [AICMCredito])      );
      AEspelho.Add('Aliquota ICM Interno : ' + Format('%10.2n', [AAliqInterna])     );
      AEspelho.Add('% Red BC ICMS Interno: ' + Format('%10.2n', [ARedICMInterno])   );
      AEspelho.Add('BC-ICMS Interno      : ' + Format('%10.2n', [ABCICMInterno])    +
        IfThen(ARedICMInterno > 0,   ' = ( ' + Format('%00.2n', [ABCICMInternoCalc]) +
                                       ' - ' + Format('%00.2n', [ARedICMInterno]) + '% )')
      );// ' (vl.op-(vl.op*aliq.cred)) / (1-aliq.interna)');
      AEspelho.Add('ICMS Interno         : ' + Format('%10.2n', [AICMInterno])      );
      AEspelho.Add('ICMS Recomposição    : ' + Format('%10.2n', [AICMRecomposicao]) );

    finally
      if AStateBrowse then
        dataSet.Edit;
      dataSet.FieldByName('icms_recomposicao').AsFloat := AICMRecomposicao;
      if AEspelho.Count = 0  then
        dataSet.FieldByName('espelho_calc_st').Value := Null
      else
        dataSet.FieldByName('espelho_calc_st').AsString := Copy(AEspelho.Text, 1, 512);
      if AStateBrowse then
        dataSet.Post;

      FreeAndNil(AEspelho);
    end;
  finally
    if Assigned(AConf) then FreeAndNil(AConf);
  end;
end;

