    begin
      if not vClFor.clienteFornecedorContrinuinte then
        result := '202'
      else
        result := '201';
    end
    else if (vtempCst = '00') or (vtempCst = '20') then
    begin
      if not vClFor.clienteFornecedorContrinuinte then
        result := '102'
      else
        Result := '101';
    end;
    Exit;
  end;
  if (vtempCst = '10') or (vtempCst = '70') then
  begin
    if not vClFor.clienteFornecedorContrinuinte then
      result := '202'
    else
      result := '201';
  end
  else if (vtempCst = '00') or (vtempCst = '20') then
  begin
    if not vClFor.clienteFornecedorContrinuinte then
