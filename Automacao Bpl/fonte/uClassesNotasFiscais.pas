//        +
//        '/' + Trim(dataSet.FieldByName('SERIE').AsString);
      vDadosIni.GravaAuditoria(vProc, vAcao, 'SUCESSO ', 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vProc, vAcao, 'FALHA ', 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);
      Result := False;
    end;
    //    vsqlTemp := dataSet.CommandText;
    selecionaNotaFiscal(vCodNf);
    dataSet.Edit;

    if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
      (dataSet.FieldByName('emissao_propria').AsString = 'S') and
