function TNFCab.adicionaPedidoAnotaFiscal: boolean;
var
  vOK: Boolean;
begin
  if not (dataSet.State in [dsInsert, dsEdit]) then
  begin
    Result := False;
    exit;
  end;
  if vPedCNf.dataSet.IsEmpty then
  begin
    Result := False;
    exit;
  end;
  if vPedCNf.vItem.dataSet.IsEmpty then
  begin
    Result := False;
    exit;
  end;
  if vPedCNf.dataSet.FieldByName('num_ped').AsInteger = dataSet.FieldByName('num_ped').AsInteger
    then
  begin
    Result := False;
    exit;
  end;

  if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
  begin
    dataSet.FieldByName('cod_cliente').AsInteger :=
      vPedCNf.dataSet.FieldByName('codigo_f').AsInteger;
    vClFor.selecionaClFor();
    exitCodigoTabela('CLIENTES');
  end;
  if dataSet.State in [dsInsert, dsEdit] then
    dataSet.FieldByName('num_ped').AsInteger := vPedCNf.dataSet.FieldByName('num_ped').AsInteger;
  vPedCNf.vItem.dataSet.First;
  while not vPedCNf.vItem.dataSet.Eof do
  begin
    try
      if not buscaItem('P',
        vPedCNf.vItem.dataSet.FieldByName('num_fab_prod').AsString) then
      begin
        Application.MessageBox(pchar('Produto: ' +
          Trim(vPedCNf.vItem.dataSet.FieldByName('descr_prod').AsString) + sLineBreak +
          'Grupo: ' + vPedCNf.vItem.dataSet.FieldByName('grupo_prod').AsString +
          ' - Código: ' + vPedCNf.vItem.dataSet.FieldByName('cod_prod').AsString +
          ' - Numero Fabricante: ' + vPedCNf.vItem.dataSet.FieldByName('num_fab_prod').AsString
          ), 'Atenção', mb_ok + MB_ICONINFORMATION);
      end
      else
      begin
        vItem.vrDadosItem.valor_total :=
          vPedCNf.vItem.dataSet.FieldByName('val_tot_it').AsCurrency;
        vItem.vrDadosItem.quantidade :=
          vPedCNf.vItem.dataSet.FieldByName('quant_it_prod').AsFloat;
        vItem.vrDadosItem.valor_unitario := vDadosIni.getValorCurrencyCasasDecEmp(
          vItem.vrDadosItem.valor_total / vItem.vrDadosItem.quantidade);
        vItem.vrDadosItem.cst := vItem.vProd.dataSet.FieldByName('cst_prod').AsString;
        calcularValorItemDesconto;
        calcularValores;
        //        if not calcularValorItemDesconto then
        //        begin
        //          Result := FALSE;
        //          exit;
        //        end;
        //        if not calcularValores then
        //        begin
        //          Result := False;
        //          Exit;
        //        end;
        Result := incluirItem;
      end;
    except
      on e: Exception do begin
        registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
          dataSet.FieldByName('cod_nf').AsString + ' AdicionaPedidoAnotaFiscal ' + e.Message);
      end;
    end;
    vPedCNf.vItem.dataSet.Next;
  end;
end;

function TNFCab.adicionaVeiculoAnotaFiscal: boolean;
var
  vTemp: string;
begin
  if not (dataSet.State in [dsInsert, dsEdit]) then
  begin
    Result := False;
    exit;
  end;
  if vComFat.dataSet.IsEmpty then
  begin
    Result := False;
    exit;
  end;
  if vComFat.vItem.dataSet.IsEmpty then
  begin
    Result := False;
    exit;
  end;
  try
     if vComFat.dataSet.FieldByName('num_nota_v').AsInteger = 0 then
       raise exception.create('Comando de Faturamento sem número de nota fiscal');
     //    begin
     //      Result := False;
     //      exit;
     //    end;
     if existeNotaFiscalDeVeiculo(vComFat.dataSet.FieldByName('num_nota_v').AsInteger,
       vComFat.dataSet.FieldByName('serie').AsString) then
     begin
       Application.MessageBox('Comando de Faturamento já possui nota fiscal emitida', 'Atenção', 0
         + 64);
       montaSelect('select * from notafiscal' +
         ' where num_nf = ' + IntToStr(vComFat.dataSet.FieldByName('num_nota_v').AsInteger) +
         ' and serie = ' + QuotedStr(vComFat.dataSet.FieldByName('serie').AsString) +
         ' and natureza_nf = ''S'' and cod_empresa = ' + vDadosIni.codEmpresa);
       if not dataSet.IsEmpty then
       begin
         Edit;
         Result := True;
         exit;
       end;
     end;

    dataSet.FieldByName('cod_cliente').AsInteger :=
     vComFat.dataSet.FieldByName('clientes_v').AsInteger;
    exitCodigoTabela('CLIENTES');
    dataSet.FieldByName('n_comando').AsInteger :=
      vComFat.dataSet.FieldByName('n_comando').AsInteger;
    dataSet.FieldByName('cod_vendedor').AsInteger :=
      vComFat.dataSet.FieldByName('covend_v').AsInteger;
    dataSet.FieldByName('cod_cond_pag').AsInteger :=
      vComFat.dataSet.FieldByName('condpag_v').AsInteger;
    dataSet.FieldByName('codigo_nop').AsFloat :=
      vComFat.dataSet.FieldByName('natop_v').AsFloat;
    exitCodigoTabela('NAT_OP');
    dataSet.FieldByName('aliq_icm').AsFloat :=
      vComFat.dataSet.FieldByName('alicm_v').AsFloat;
    dataSet.FieldByName('num_nf').AsInteger :=
      vComFat.dataSet.FieldByName('num_nota_v').AsInteger;
    if Trim(vComFat.dataSet.FieldByName('serie').AsString) <> '' then
      dataSet.FieldByName('serie').AsString :=
        vComFat.dataSet.FieldByName('serie').AsString;
    if (Trim(dataSet.FieldByName('serie').AsString) = '') or
      (Trim(dataSet.FieldByName('serie').AsString) = '0') then
      dataSet.FieldByName('serie').AsString := IntToStr(vDadosIni.vEmp.vSubSerieNotaFiscal);
    dataSet.FieldByName('obs').AsString :=
      vComFat.dataSet.FieldByName('obs_v').AsString;
    dataSet.FieldByName('valor_frete').AsFloat :=
      vComFat.dataSet.FieldByName('frete_v').AsFloat;
    dataSet.FieldByName('valor_seguro').AsFloat :=
      vComFat.dataSet.FieldByName('seguro_v').AsFloat;
    dataSet.FieldByName('valor_out_desp').AsFloat :=
      vComFat.dataSet.FieldByName('outdesp_v').AsFloat;
    dataSet.FieldByName('data_ent_saida').AsDateTime :=
      vComFat.dataSet.FieldByName('dt_ent_said').AsDateTime;
    dataSet.FieldByName('tipo_desconto').AsString := 'R';
    if Trim(vComFat.dataSet.FieldByName('TIPV_VEICULO').AsString) = 'E' then // devolucao
      dataSet.FieldByName('valor_desc').AsFloat := vComFat.ffloat('desconto_v', -2);

    if vDadosIni.vEmp.vVersaoVeiculos = '4' then
    begin
      if trim(vComFat.dataSet.FieldByName('NATUREZA').AsString) = 'E' then
      begin
       dataSet.FieldByName('valor_prod').AsFloat := vComFat.dataSet.FieldByName('valor_real').AsFloat;
       dataSet.FieldByName('valor_total').AsFloat := vComFat.dataSet.FieldByName('valor_real').AsFloat;
      end;
    end;

    buscas.Close;
    buscas.SQL.Text := 'select tipdoc from formpagamento' +
      ' where nrequisicao = ' + IntToStr(vComFat.dataSet.FieldByName('n_comando').AsInteger) +
      ' and tpdocs = ''MOT''' +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and tipdoc <> ''N''';
    buscas.Open;

    if not buscas.IsEmpty then
      if vCPag.existeCondPagPrazo then
        dataset.FieldByName('cod_cond_pag').AsInteger := vCPag.dataset.FieldByName('cod_cond_pag').AsInteger;

    Fcalc_fat.calculo_faturamento_completo_obterdados(False);

    novoVeiculo;

    if Trim(vComFat.dataSet.FieldByName('TIPV_VEICULO').AsString) = 'E' then // devolucao
    begin
      vItem.vDetVeic.vModV.abreModelos(vComFat.vItem.fint('versaoest'));

      dataSet.FieldByName('tipo_emissao').AsString := '4';
      dataSet.FieldByName('devolucao').AsString    := 'SIM';
      dataSet.FieldByName('valor_pis').AsFloat     := vItem.vDetVeic.vModV.ffloat('valor_pis');
      dataSet.FieldByName('valor_cofins').AsFloat  := vItem.vDetVeic.vModV.ffloat('valor_cofins');
      dataSet.FieldByName('tem_piscofins_st').AsString := IfThen(vItem.vDetVeic.vModV.ffloat('valor_pis') > 0, 'S', 'N');
      dataSet.FieldByName('add_piscofins_st_totalnf').AsString := IfThen(vItem.vDetVeic.vModV.ffloat('valor_pis') > 0, 'S', 'N');

      vItem.vrDadosItem.tipo_calc       := Ord(tcParcial);
      vItem.vrDadosItem.tipo_calc_pc    := Ord(tcParcial);
      vItem.vrDadosItem.base_icmsub     := vComFat.vItem.ffloat('base_calc_icm_subv');
      vItem.vrDadosItem.valor_icmsub    := vComFat.vItem.ffloat('valor_icm_subv');
      vItem.vrDadosItem.rateio_desconto := vComFat.ffloat('desconto_v', -2);
      // adicionei par passar no comando de devolução da Seta motos
      vItem.vrDadosItem.valor_total     := vItem.vrDadosItem.valor_total + vItem.vrDadosItem.rateio_desconto;
      vItem.vrDadosItem.valor_unitario  := vItem.vrDadosItem.valor_total / vItem.vrDadosItem.quantidade;
      vItem.vrDadosItem.perc_desconto   := vItem.vrDadosItem.rateio_desconto / vItem.vrDadosItem.valor_total * 100;
      vItem.vrDadosItem.piscofins       := vItem.vDetVeic.vModV.ffloat('PISCOFINS');
      vItem.vrDadosItem.cst_pis         := '05';
      vItem.vrDadosItem.cst_cofins      := '05';
      vItem.vrDadosItem.valor_pis       := vItem.vDetVeic.vModV.ffloat('valor_pis');
      vItem.vrDadosItem.valor_cofins    := vItem.vDetVeic.vModV.ffloat('valor_cofins');
      vItem.vrDadosItem.base_pis        := IfThen(vItem.vrDadosItem.valor_pis > 0, vItem.vrDadosItem.base_icm);
      vItem.vrDadosItem.base_cofins     := IfThen(vItem.vrDadosItem.valor_pis > 0, vItem.vrDadosItem.base_pis);
      vItem.vrDadosItem.valor_pis_st    := IfThen(vItem.vrDadosItem.valor_pis > 0, vItem.vrDadosItem.valor_pis);
      vItem.vrDadosItem.valor_cofins_st := IfThen(vItem.vrDadosItem.valor_pis > 0, vItem.vrDadosItem.valor_cofins);
      vItem.vrDadosItem.base_icm        := IfThen(vItem.vrDadosItem.aliq_icm > 0, vItem.vrDadosItem.valor_total - vItem.vrDadosItem.rateio_desconto);
      vItem.vrDadosItem.valor_icm       := RoundTo(IfThen(vItem.vrDadosItem.aliq_icm > 0, vItem.vrDadosItem.base_icm * vItem.vrDadosItem.aliq_icm / 100), -2);

      if vCfop.fstr('sem_imposto') = 'S' then
      begin
        vItem.vrDadosItem.valor_pis       := 0;
        vItem.vrDadosItem.valor_cofins    := 0;
        vItem.vrDadosItem.base_pis        := 0;
        vItem.vrDadosItem.base_cofins     := 0;
        vItem.vrDadosItem.valor_pis_st    := 0;
        vItem.vrDadosItem.valor_cofins_st := 0;
        vItem.vrDadosItem.base_icm        := 0;
        vItem.vrDadosItem.valor_icm       := 0;
        vItem.vrDadosItem.base_icmsub     := 0;
        vItem.vrDadosItem.valor_icmsub    := 0;
      end;
    end;

    Fcalc_fat.calculo_faturamento_individual_executar(True);

    Result := incluirItem;
    if Result then
    begin
      vItem.vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger);
      vItem.vDetVeic.Insert;
      vItem.vDetVeic.dataSet.FieldByName('COD_NF').AsInteger :=
        dataSet.FieldByName('cod_nf').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('COD_EMPRESA').AsInteger :=
        dataSet.FieldByName('cod_empresa').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('NITEM').AsInteger := 1;
      vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString :=
        Trim(vItem.dataSet.FieldByName('chassi').AsString);
      vItem.vDetVeic.dataSet.FieldByName('MARCA').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('marcaest').AsString);
      vItem.vDetVeic.dataSet.FieldByName('VERSAO').AsInteger :=
        vComFat.vItem.dataSet.FieldByName('versaoest').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('n_comando').AsInteger :=
        vComFat.dataSet.FieldByName('n_comando').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('descricao_versaoest').AsString);
      vItem.vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger :=
        vComFat.vItem.dataSet.FieldByName('ano_fabest').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger :=
        vComFat.vItem.dataSet.FieldByName('ano_modest').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('COR').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('corest').AsString);
      vItem.vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger :=
        vComFat.vItem.dataSet.FieldByName('cilindrosest').AsInteger;
      vItem.vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('combustivelest').AsString);
      vItem.vDetVeic.dataSet.FieldByName('CILINDRADA').AsFloat :=
        vComFat.vItem.dataSet.FieldByName('cilindradaest').AsFloat;
      vItem.vDetVeic.dataSet.FieldByName('HP').AsFloat :=
        vComFat.vItem.dataSet.FieldByName('hpest').AsFloat;
      vItem.vDetVeic.dataSet.FieldByName('LOTACAO').AsString :=
        Trim(vComFat.vItem.dataSet.FieldByName('lotacaoest').AsString);
