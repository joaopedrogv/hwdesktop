function TNFCab.existeECF(pNumSerieFab: string): boolean;
var
  vTemp: string;
begin
  vItem.vDetEcf.dataSet.Cancel;
  vItem.vDetEcf.dataSet.First;
  while not vItem.vDetEcf.dataSet.Eof do
  begin
    if Trim(vItem.vDetEcf.dataSet.FieldByName('n_serie_fab').AsString) = pNumSerieFab then
    begin
      vItem.vDetEcf.dataSet.Insert;
      Result := True;
      Application.messagebox(pchar('Numero de série ja foi informado'), 'Atenção', 0 + 64);
      exit;
    end;
    vItem.vDetEcf.dataSet.Next;
  end;
  vtemp :=
    vItem.vDetEcf.dataSet.FieldByName('cniee').AsString;
  vItem.vDetEcf.dataSet.Cancel;
  vItem.vDetEcf.dataSet.Insert;
  vItem.vDetEcf.dataSet.FieldByName('cod_nf').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
  vItem.vDetEcf.dataSet.FieldByName('nitem').AsInteger :=
    vItem.dataSet.FieldByName('nitem').AsInteger;
  vItem.vDetEcf.dataSet.FieldByName('grupo_prod').AsInteger :=
    vItem.dataSet.FieldByName('grupo_prod').AsInteger;
  vItem.vDetEcf.dataSet.FieldByName('cod_prod').AsString :=
    vItem.dataSet.FieldByName('cod_prod').AsString;
  vItem.vDetEcf.dataSet.FieldByName('cniee').AsString := vTemp;
  vItem.vDetEcf.dataSet.FieldByName('n_serie_fab').AsString := pNumSerieFab;
  if vItem.dataSet.FieldByName('ecf').AsString = 'O' then
  begin
    vItem.vDetEcf.dataSet.FieldByName('tipo_ecf').AsString :=
      vItem.vDetEcf.vTipo;
    vItem.vDetEcf.dataSet.FieldByName('marca_ecf').AsString :=
      vItem.vDetEcf.vMarca;
    vItem.vDetEcf.dataSet.FieldByName('modelo_ecf').AsString :=
      vItem.vDetEcf.vModelo;
  end;

  Result := False;
end;

function TNFCab.salvaDadosDetalhesVeiculo: boolean;
begin
  try
    Result := False;
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      if not (vItem.vDetVeic.dataSet.state in [dsEdit, dsInsert]) then
        vItem.vDetVeic.dataSet.Edit;

