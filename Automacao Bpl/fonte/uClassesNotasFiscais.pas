function TNFCab.retornaNumRec: string;
var
 vTemp: string;
 buscas2: TIBQuery;
begin
  vTemp := '';

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  buscas2.Close;
  buscas2.SQL.Text := ' SELECT COALESCE(INICIAIS_DEPTO, '''') INICIAIS_DEPTO FROM DEPTO ' +
  	' WHERE ATIVO = 1 AND TRIM(COALESCE(INICIAIS_DEPTO, '''')) <> '''' ' ;
  if dataSet.FieldByName('tipo_nf').AsString = 'P' then
    buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO IN (''VENDA DE PEÇAS'', ''ESTOQUE'') '
  else if dataSet.FieldByName('tipo_nf').AsString = 'V' then
  	buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO IN (''VENDA DE MOTOS'', ''VEICULOS'') '
  else
  	buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO = ' + QuotedStr(vDadosIni.vDpto);
  buscas2.Open;

  if trim(buscas2.FieldByName('INICIAIS_DEPTO').AsString) <> '' then
  begin
    vTemp := trim(buscas2.FieldByName('INICIAIS_DEPTO').AsString);
    vTemp := vTemp + vDadosIni.StrZero(Gencodigo('RECIBOS_' + trim(buscas2.FieldByName('INICIAIS_DEPTO').AsString),
    	dtmNF.SpIncCodNF, vDadosIni.codEmpresa), 4) + '/';
    vTemp := vTemp + FormatDateTime('yy', vDadosIni.getDataBanco(buscas2))
  end;
  Result := vTemp;
end;

function TNFCab.retornarEstMotoEntrada: boolean;
var
  vCodVeiculo: Integer;
  vChassi: string;
begin
  try
   Result:= true;

   if not ((vDadosIni.vEmp.vVersaoVeiculos = '4') and (dataset.FieldByName('natureza_nf').Asstring = 'E')) then
     exit;

    if (vItem.dataSet.FieldByName('tipv_veiculo').AsString = 'T') then
    begin
      buscas.close;
      buscas.Sql.Text := ' update est_moto set data_trans_ret = :data' +
        ' where chassi_c = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
        ' and (coalesce(tipv_veiculo, ''V'') = ''T'') and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 and data_trans_ret is not null';
      buscas.ParamByName('data').Value := '';
      buscas.Prepare;
      buscas.ExecSQL;
    end
    else if (vItem.dataSet.FieldByName('tipv_veiculo').AsString = 'D') then
    begin
      buscas.Close;
      buscas.Sql.Text := 'select cod_estmoto, chassiv from com_fat ' +
        ' where num_nota_v = ' + dataset.fieldbyname('num_nf_emt').asstring +
        ' and serie = ' + QuotedStr(dataset.fieldbyname('serie_emt').asstring)+
        ' and cod_empresa = '+vDadosIni.codEmpresa;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        vCodVeiculo := buscas.FieldByName('COD_ESTMOTO').AsInteger;
        vChassi := buscas.FieldByName('CHASSIV').AsString;

        buscas.Close;
        buscas.Sql.Text := 'update com_fat set situacao = '''' ' +
          ' where num_nota_v = ' + dataset.fieldbyname('num_nf_emt').asstring +
          ' and serie = ' + QuotedStr(dataset.fieldbyname('serie_emt').asstring)+
          ' and cod_empresa = '+vDadosIni.codEmpresa;
        buscas.ExecSql;

        buscas.Close;
        buscas.Sql.Text := 'update est_moto set status_demonst = ''S'', situacao = ''DEMONSTRACAO''' +
          ' where chassi_c = ' + QuotedStr(vChassi) +
          ' and codigo = ' + IntToStr(vCodVeiculo) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSql;
      end;
    end;
  except
    on e: exception do begin
        Result := False;
        RollBackTransacao;
        Application.MessageBox(pchar('Erro ao retornar informações do veículo: retornarEstMotoEntrada' + sLineBreak + 'Erro: ' + e.Message), 'Atenção', mb_ok + MB_ICONINFORMATION);
        exit;
    end;
  end;
end;

