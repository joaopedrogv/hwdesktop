function TNFCab.verificaCadastroEquipamentos: boolean;
var
  formulario: TForm;
  hdTemp: THandle;
  vOk: boolean;
begin
  vOk := False;

  if dataSet.FieldByName('tipo_nf').AsString = 'V' then
  begin
     vItem.vDetVeic.dataSet.First;
     while not vItem.vDetVeic.dataSet.Eof do
     begin
       vDadosIni.vPesquisa := '';
       if (vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger > 0)
       and (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'A') then
