        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('NNF_ENTRADA').AsString;
      vItem.vDetEcf.dataSet.FieldByName('SERIE_ENTRADA').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('SERIE_ENTRADA').AsString;
      vItem.vDetEcf.dataSet.FieldByName('COD_NSERIE').AsInteger :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('COD_NSERIE').AsInteger;
      vItem.vDetEcf.dataSet.Post;
      vItem.vDetEcf.Apply; //12

      buscas.CLose;
      buscas.sql.text := 'update ecf set nnf = :nnf, serie = :serie' +
        ' where COD_NSERIE = :COD_NSERIE and cod_empresa = :cod_empresa';
      buscas.ParamByName('nnf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
      buscas.ParamByName('serie').AsString := dataSet.FieldByName('serie').AsString;
      buscas.ParamByName('COD_NSERIE').AsInteger := vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('COD_NSERIE').AsInteger;
      buscas.ParamByName('cod_empresa').asstring := vDadosIni.codEmpresa;
      buscas.prepare;
      buscas.ExecSql;
    end;
  end;
  Exit;

  vItem.vDetEcf.vEstoqueECF.selecionaEstoqueECFVenda(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
    vItem.dataSet.FieldByName('cod_prod').AsString);
  QtdeTotal := Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat);
  if vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount < QtdeTotal then
  begin
    Application.MessageBox(pchar('Estoque de Equipamentos insuficiente' + sLineBreak +
      'Quantidade encontrada: ' + IntToStr(vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount)
      ), 'Atenção', MB_OK + MB_ICONINFORMATION);
    //grava auditoria aqui.
    QtdeTotal := vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount;
  end;
  QtdePendente := QtdeTotal;
  QtdeInformada := 0;

  while QtdePendente <> QtdeInformada do
  begin
    vItem.vDetEcf.dataSet.Insert;
    if abreFormDetalhesECFSaida(QtdeTotal, QtdePendente, QtdeInformada) then
    begin
      vItem.vDetEcf.dataSet.Insert;
      vItem.vDetEcf.dataSet.FieldByName('cod_nf').AsInteger :=
        dataSet.FieldByName('cod_nf').AsInteger;
      vItem.vDetEcf.dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
      vItem.vDetEcf.dataSet.FieldByName('nitem').AsInteger :=
        vItem.dataSet.FieldByName('nitem').AsInteger;
      vItem.vDetEcf.dataSet.FieldByName('grupo_prod').AsInteger :=
        vItem.dataSet.FieldByName('grupo_prod').AsInteger;
      vItem.vDetEcf.dataSet.FieldByName('cod_prod').AsString :=
        vItem.dataSet.FieldByName('cod_prod').AsString;
      vItem.vDetEcf.dataSet.FieldByName('N_SERIE_FAB').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('N_SERIE_FAB').AsString;
      vItem.vDetEcf.dataSet.FieldByName('CNIEE').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('IDENTIFICACAO').AsString;
      vItem.vDetEcf.dataSet.FieldByName('TIPO_ECF').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('TIPO_ECF').AsString;
      vItem.vDetEcf.dataSet.FieldByName('MARCA_ECF').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('MARCA_ECF').AsString;
      vItem.vDetEcf.dataSet.FieldByName('MODELO_ECF').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('MODELO_ECF').AsString;
      vItem.vDetEcf.dataSet.FieldByName('VERSAOSB').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('VERSAOSB').AsString;
      vItem.vDetEcf.dataSet.FieldByName('N_MEMORIA_FISCAL').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('N_MEMORIA_FISCAL').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO1').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO1').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO2').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO2').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO3').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO3').AsString;
      vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO4').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('LACRE_EXTERNO4').AsString;
      vItem.vDetEcf.dataSet.FieldByName('NNF_ENTRADA').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('NNF_ENTRADA').AsString;
      vItem.vDetEcf.dataSet.FieldByName('SERIE_ENTRADA').AsString :=
        vItem.vDetEcf.vEstoqueECF.dataSet.FieldByName('SERIE_ENTRADA').AsString;
      vItem.vDetEcf.dataSet.Post;
      vItem.vDetEcf.Apply; //12
      QtdeInformada := QtdeInformada + 1;
      buscas.CLose;
      buscas.sql.text := 'update ecf set status = :status, nnf = :nnf, serie = :serie' +
        ' where n_serie_fab = :nserie and cod_empresa = :cod_empresa';
      if notaFiscalDeRemessa(vItem.dataSet.FieldByName('codigo_nop').AsString) then
        buscas.ParamByName('status').asstring := 'Demonstração'
