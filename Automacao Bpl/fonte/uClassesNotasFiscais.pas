function TGradeProdutoNF.selecionaGradeDoProduto(pGrupo: integer;
  pCodigo: string): boolean;
begin
  montaSelect('select cp.grupo_prod, cp.cod_prod, cp.cod_grade, cp.cod_empresa,' +
    ' cp.qtde estoque, g.descricao, g.descricao1' +
    '  from cod_grade_prod cp' +
    ' inner join grade g on g.cod_grade = cp.cod_grade' +
    ' and g.cod_empresa = cp.cod_empresa and g.cod_grade > 0' +
    ' where cp.grupo_prod = ' + IntToStr(pGrupo) +
    ' and cp.cod_prod = ' + QuotedStr(pCodigo) +
    ' and cp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cp.ativo = 1');
end;

function TGradeProdutoNF.selecionaGradeDoProduto(pGrupo: integer;
  pCodigo: string; pTodos: Boolean): boolean;
begin
  montaSelect('select '+IntToStr(pGrupo) +' grupo_prod, '+QuotedStr(pCodigo)+
    ' cod_prod, g.cod_grade, g.cod_empresa,' +
    ' cast(0 as double precision) estoque, g.descricao, g.descricao1' +
    ' from grade g '+
    ' where g.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and g.ativo = 1 and g.cod_grade > 0');
end;

