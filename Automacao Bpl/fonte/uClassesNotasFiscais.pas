    frmCadNF.setNComando(nComando);
    frmCadNF.ShowModal;
  end;
end;

procedure TNFCab.cadNfpeloPedVenda(nPedVenda: integer; tipoPedVenda: string;
  abrirTela: boolean);
var
  vTemp: string;
  vTemBoolean:Boolean;
begin
  vDadosIni.vTipoForm := 2;
  if dtmNF = nil then
    dtmNF := TdtmNF.Create(dtmNF);
  vTemp := tipoPedVenda;
  vTemBoolean := pos('CXL',vTemp) > 0;
  vTemp := StringReplace(vTemp,'CXL','',[rfReplaceAll]);
  if frmCadNF = nil then
  begin
    vDadosIni.vNomeForm := 'frmCadNF';
    vDadosIni.vModalOuChild := 'M';
    Application.CreateForm(TfrmCadNF, frmCadNF);
    if vTemBoolean then
      frmCadNF.tag := 32
    else
      frmCadNF.tag := 22;
    frmCadNF.setNpedVendaTipoPedVenda(nPedVenda, vTemp);
    frmCadNF.ShowModal;
  end
  else if not frmCadNF.Visible then
  begin
    vDadosIni.vNomeForm := 'frmCadNF';
    vDadosIni.vModalOuChild := 'M';
    if vTemBoolean then
      frmCadNF.tag := 32
    else
      frmCadNF.tag := 22;
    frmCadNF.setNpedVendaTipoPedVenda(nPedVenda, vTemp);
    frmCadNF.ShowModal;
  end;
end;

function TNFCab.calculaICMSCabecalho: boolean;
begin
  if not notaFechada then
    if (dataSet.State in [dsEdit, dsInsert]) and (dataSet.FieldByName('natureza_nf').AsString = 'E')
      then
//      if (dataSet.FieldByName('aliq_icm').OldValue <> dataSet.FieldByName('aliq_icm').NewValue)
//        or (dataSet.FieldByName('base_icm').OldValue <> dataSet.FieldByName('base_icm').NewValue)
//        then
      begin
        if dataset.state = dsedit then
        begin
          dataset.post;
          dataset.edit;
        end;
        dataSet.FieldByName('valor_icm').AsFloat := vDadosIni.StrToFloatFormat(
          (dataSet.FieldByName('aliq_icm').AsFloat * dataSet.FieldByName('base_icm').AsFloat) / 100,
          2);
      end;
end;

function TNFCab.CalcularCustoDosProdutos(operacaoa: C_OperacaoDiversas): boolean;
var
  vValorReposicao, vValorContabil, vValorPr_Cusc_prod: Currency;
  aliqinterna: Double;
  vValorTemp: Double;
  //MNF
  vTotalProdMNF, vtotps, vtotpsmnf, vRatFreteMNF, vRatSegMNF, vRatOutDMNF, vRatDesPFMNF: Real;
  vTempMVA, vAliqTemp: Real;
  vValorTempBase, vValorPISCOFINS: Currency;
  vValorTempMarkup: Extended;
  Resposta: string;
  ListaErros, ListaAlerta: TStrings;
  I: Integer;
  AntST: TNFItem_AntecipacaoST;
begin
  Result := False;
  try
    absorverValorICMSST;

    if Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'NuncaCalcularAntecipacao') = 'S' then
    begin
      if (dataSet.State in [dsEdit, dsInsert]) then
        dataSet.FieldByName('antec_trib').AsString := 'N';
    end
    else
    begin
      AntST := TNFItem_AntecipacaoST.create(Self);
      try
        I := AntSt.AnalisarItens(Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'PreferirAliquotaAoMVA') = 'S',
                                 Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'ConfirmarAntecipacaoEmTela') <> 'S');
        if (I > 0) and (Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'ConfirmarAntecipacaoEmTela') = 'S') then
        begin

          Application.CreateForm(TfrmCadNF_AntecipacaoST_Itens, frmCadNF_AntecipacaoST_Itens);
          frmCadNF_AntecipacaoST_Itens.nota  := Self;
          frmCadNF_AntecipacaoST_Itens.AntST := AntSt;
          frmCadNF_AntecipacaoST_Itens.ShowModal;
        end;

        I := AntSt.AnalisarItens(Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'PreferirAliquotaAoMVA') = 'S',
                                 Config.Conf_Geral.nf_hab_validacao_antecipacao_st.ReadString('Conf', 'ConfirmarAntecipacaoEmTela') <> 'S');

        if I > 0 then
        begin
          Result := False;
          ShowAtencao('Existem itens analisados pelo sistema que possuem Antecipação do ICMS' + sLineBreak + sLineBreak +
                      'Por favor "Aceite" ou "Não Aceite" o cálculo para a correta apresentação do custo das mercadorias');
          Exit;
        end;
      finally
        AntST.Free;
      end;
    end;

    vTotalProdMNF := 0;
    ListaErros := TStringList.Create;
    ListaErros.Clear;
    ListaAlerta := TStringList.Create;
    ListaAlerta.Clear;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.fequals('antec_trib', 'S') and fdif('antec_trib', 'S') and (dataSet.State in [dsEdit, dsInsert]) then
        dataSet.FieldByName('antec_trib').AsString := 'S';

      // Nao compoe total, mas compoe estoque se o CFOP for configurado
      if (vItem.dataSet.FieldByName('indtot').Value = 0) then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat := 0;
        vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := 0;
        vItem.dataSet.FieldByName('PREC_CUS_R').AsFloat := 0;
        vItem.dataSet.FieldByName('PR_CUSC_PROD').AsFloat := 0;
        vItem.dataSet.FieldByName('PREC_CUS_REP').AsFloat := 0;
        vItem.dataSet.Post;

        vItem.dataSet.Next;
        Continue;
      end;
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
        (vItem.dataSet.FieldByName('mnf').AsString = 'S') then
      begin
      // removi este teste porque na importação do xml o elvis precisou usar o campo qtemb,
      // para sua conferencia, deixando o calculo mnf despadronizado
      // ficando agora padronizado sempre informar o valor unitario da mercadoria
//        if (vItem.dataSet.FieldByName('QTDEMB').AsFloat > 0) then
//          vValorTemp := ((vItem.dataSet.FieldByName('VLREMBNFR').AsFloat /
//            vItem.dataSet.FieldByName('QTDEMB').AsFloat) *
//            vItem.dataSet.FieldByName('quantidade').AsFloat)
//        else
          vValorTemp := (vItem.dataSet.FieldByName('VLREMBNFR').AsFloat *
            vItem.dataSet.FieldByName('quantidade').AsFloat);
        vTotalProdMNF := vTotalProdMNF + vValorTemp;

        if (copy(vItem.dataSet.FieldByName('cst').AsString, 2, 1)[1] in ['1', '6', '3', '7']) then
          vtotps := vtotps + vValorTemp;
      end
      else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
        vTotalProdMNF := vTotalProdMNF + vItem.dataSet.FieldByName('valor_total').AsFloat;
        if (copy(vItem.dataSet.FieldByName('cst').AsString, 2, 1)[1] in ['1', '6', '3', '7']) then
          vtotps := vtotps + vItem.dataSet.FieldByName('valor_total').AsFloat;
      end;
      vItem.dataSet.Next;
    end;
    FCalculoImposto.vValorICMSubResumo := 0;
    FCalculoImposto.vValorICMResumo := 0;
    FCalculoImposto.vValorICMSRecomposicao := 0;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('indtot').Value = 0) then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
      begin
        vValorPr_Cusc_prod := 0; //vValorTempBase := 0;
        vRatFreteMNF := 0; vRatSegMNF := 0; vRatOutDMNF
          := 0; vRatDesPFMNF
        := 0;
        //Ja vi com o Herbert o Custo de Reposição. Dar uma pesquisada. Talvez colocar configuracao.
        //Acrescimo não esta entrado, somente outras despesas por fora
        if (vItem.dataSet.FieldByName('mnf').AsString = 'S') and (vTotalProdMNF > 0) then
        begin
        
         // removi este teste porque na importação do xml o elvis precisou usar o campo qtemb,
         // para sua conferencia, deixando o calculo mnf despadronizado
         // ficando agora padronizado sempre informar o valor unitario da mercadoria
//          if (vItem.dataSet.FieldByName('QTDEMB').AsFloat > 0) then
//            vValorReposicao := ((vItem.dataSet.FieldByName('VLREMBNFR').AsFloat /
//              vItem.dataSet.FieldByName('QTDEMB').AsFloat) *
//              vItem.dataSet.FieldByName('quantidade').AsFloat)
//          else
            vValorReposicao := (vItem.dataSet.FieldByName('VLREMBNFR').AsFloat *
              vItem.dataSet.FieldByName('quantidade').AsFloat);

          vRatFreteMNF := dataSet.FieldByName('valor_frete').AsFloat / vTotalProdMNF *
            vValorReposicao;
          vRatSegMNF := dataSet.FieldByName('valor_seguro').AsFloat / vTotalProdMNF *
            vValorReposicao;
          vRatOutDMNF := dataSet.FieldByName('valor_out_desp').AsFloat / vTotalProdMNF *
            vValorReposicao;
          vRatDesPFMNF := dataSet.FieldByName('valor_desp_pf').AsFloat / vTotalProdMNF *
            vValorReposicao;

          vValorReposicao := (vValorReposicao +
            (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            // o valor do ST será definido logo abaixo depois de verificar a atencipacao do ST
            //vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
            vItem.dataSet.FieldByName('valor_ii').AsFloat +
            vRatFreteMNF + vRatSegMNF + vRatOutDMNF + vRatDesPFMNF)
            ) / vItem.dataSet.FieldByName('quantidade').AsFloat;
          //vValorReposicao := vValorReposicao + vItem.dataSet.FieldByName('valor_dif').AsFloat;
        end
        else
        begin
          vValorReposicao :=
            ((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
            vItem.dataSet.FieldByName('quantidade').AsFloat) -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat +
             vItem.dataSet.FieldByName('vpisdeson').AsFloat +
             vItem.dataSet.FieldByName('vcofinsdeson').AsFloat) +
            (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            // o valor do ST será definido logo abaixo depois de verificar a atencipacao do ST
            //vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
            vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
            vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
            vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
            vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +
            vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat +
            vItem.dataSet.FieldByName('nfe_vipidevol').AsFloat +
            vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
            vItem.dataSet.FieldByName('valor_ii').AsFloat +
            vItem.dataSet.FieldByName('vicmsmonoreten').AsFloat +
            IfThen(vItem.fequals('indsomapisst', '1'), vItem.ffloat('valor_pis_st')) +
            IfThen(vItem.fequals('indsomacofinsst', '1'), vItem.ffloat('valor_cofins_st')) )
            ) / vItem.QtdeCalcCusto;
          //vValorReposicao := vValorReposicao + (vItem.dataSet.FieldByName('valor_dif').AsFloat /
          //  vItem.dataSet.FieldByName('quantidade').AsFloat);
        end;
        vValorPr_Cusc_prod := ((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
          vItem.dataSet.FieldByName('quantidade').AsFloat) -
          (vItem.dataSet.FieldByName('rateio_desconto').AsFloat +
           vItem.dataSet.FieldByName('vpisdeson').AsFloat +
           vItem.dataSet.FieldByName('vcofinsdeson').AsFloat) +
          (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
          // o valor do ST será definido logo abaixo depois de verificar a atencipacao do ST
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat +
          vItem.dataSet.FieldByName('nfe_vipidevol').AsFloat +
          vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
          vItem.dataSet.FieldByName('valor_ii').AsFloat +
          vItem.dataSet.FieldByName('vicmsmonoreten').AsFloat +
          IfThen(vItem.fequals('indsomapisst', '1'), vItem.ffloat('valor_pis_st')) +
          IfThen(vItem.fequals('indsomacofinsst', '1'), vItem.ffloat('valor_cofins_st')))
          ) / vItem.QtdeCalcCusto;
        vValorReposicao := vValorReposicao + (vItem.dataSet.FieldByName('valor_dif').AsFloat /
          vItem.QtdeCalcCusto);
        vValorPr_Cusc_prod := vValorPr_Cusc_prod + (vItem.dataSet.FieldByName('valor_dif').AsFloat /
          vItem.QtdeCalcCusto);
        if fdif('totais_com_deson', 'N') then
        begin
          vValorReposicao := vValorReposicao - (vItem.ffloat('vicmdeson') / vItem.QtdeCalcCusto);
          vValorPr_Cusc_prod := vValorPr_Cusc_prod - (vItem.ffloat('vicmdeson') / vItem.QtdeCalcCusto);
        end;

//        vValorTempBase := vValorPr_Cusc_prod - ((//vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
//           vItem.dataSet.FieldByName('valor_pis_st').AsFloat +
//           vItem.dataSet.FieldByName('valor_cofins_st').AsFloat +
//           vItem.dataSet.FieldByName('valor_ii').AsFloat) / vItem.dataSet.FieldByName('quantidade').AsFloat);
//        if (dataSet.FieldByName('FRETE_F_NFE').AsString = 'S') then
//          vValorTempBase := vValorTempBase - (vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat / vItem.dataSet.FieldByName('quantidade').AsFloat);
        //Custo Contabil
        vValorContabil := vValorReposicao;

        vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString);

        //Quando empresa Debito e Credito retirar o valor de ICMS
        if (vDadosIni.vEmp.vRegime <> 'SIMPLES') and (Config.Conf_Custo.AbaterCreditoIcms) and (vItem.vProd.ffloat('icm_prod') > 0) and
           (vItem.ffloat('icm_vicmst') = 0)      and vItem.fdif('antec_trib', 'S')   and (vItem.ffloat('valor_icmsub') = 0) then
        begin
          FCalculoImposto.vValorICMResumo := FCalculoImposto.vValorICMResumo + (vItem.ffloat('valor_icm') / vItem.QtdeCalcCusto);
          vValorContabil                  := vValorReposicao                 - (vItem.ffloat('valor_icm') / vItem.QtdeCalcCusto);
          vValorPr_Cusc_prod              := vValorPr_Cusc_prod              - (vItem.ffloat('valor_icm') / vItem.QtdeCalcCusto);
        end;

        if (vDadosIni.vEmp.vRegime <> 'SIMPLES') and Config.Conf_Custo.AbaterCreditoPisCofins and (vItem.vProd.fstrin('cst_pis', ['', '01', '02', '03']))
          and ((vItem.ffloat('valor_pis') > 0) or (vItem.ffloat('valor_cofins') > 0)) then
        begin
          vValorContabil                  := vValorContabil                  - ((vItem.ffloat('valor_pis') + vItem.ffloat('valor_cofins')) / vItem.QtdeCalcCusto);
          vValorPr_Cusc_prod              := vValorPr_Cusc_prod              - ((vItem.ffloat('valor_pis') + vItem.ffloat('valor_cofins')) / vItem.QtdeCalcCusto);
        end;         

        vItem.dataSet.Edit;

//        vItem.dataSet.FieldByName('base_icmsub_ant').AsFloat := 0;
//        vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat := 0;
        {
        Resposta := vItem.calcucarAntecipacaoTributariaST(Self,
          vDadosIni.IfThen(operacao = opdResumo, opdValidacao, opdCalculoCusto));
        if vDadosIni.getValue(Resposta, 1) <> 'OK' then
        begin
          ListaErros.Add('-');
          ListaErros.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
            Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
            Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
          ListaErros.Add(' * ' + vDadosIni.getValue(Resposta, 1));
        end
        else if vDadosIni.getValue(Resposta, 2) <> '' then
        begin
          ListaAlerta.Add('-');
          ListaAlerta.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
            Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
            Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
          ListaAlerta.Add(' * ' + vDadosIni.getValue(Resposta, 2));
        end;
        }
        // calculo de recomposicao do icms-- rei da borracha
        vItem.calcucarReconposicaoDeICMS(Self);
        vValorContabil := vValorContabil +
          (vItem.dataSet.FieldByName('icms_recomposicao').AsFloat / vItem.QtdeCalcCusto);
        FCalculoImposto.vValorICMSRecomposicao := FCalculoImposto.vValorICMSRecomposicao +
          vItem.dataSet.FieldByName('icms_recomposicao').AsFloat;
        // calculo de recomposicao do icms-- rei da borracha

        // setando o valor de icms st ao custo
        // valores de custo sao unitarios
        vValorContabil := vValorContabil +
          (vItem.dataSet.FieldByName('valor_icmsub').AsFloat / vItem.QtdeCalcCusto);
        vValorPr_Cusc_prod := vValorPr_Cusc_prod +
          (vItem.dataSet.FieldByName('valor_icmsub').AsFloat / vItem.QtdeCalcCusto);
        //caso tenha antecipacao do st
        if (vDadosIni.strIn(copy(vItem.dataSet.FieldByName('CST').AsString, 2, 2), ['10', '30', '60', '70'])) and
          (vItem.dataSet.FieldByName('ANTEC_TRIB').AsString = 'S') then
          // no resumo é total o custo
          FCalculoImposto.vValorICMSubResumo := FCalculoImposto.vValorICMSubResumo +
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
        {
        //Fazer como esta no Automacao 3.0
        vTempMVA := 0;
        aliqinterna := 0;
        if
          vItem.getDadosSubstituicaoTribNbmEstado(vClFor.dataSet.FieldByName('codigo_uf').AsInteger,
          vItem.dataSet.FieldByName('ncm').AsString) then
        begin
          vTempMVA := vItem.vrDadosItem.FMvaNbmEstado;
          aliqinterna := vItem.vrDadosItem.FAliqNbmEstado;
        end;

        if (vTempMVA > 0) then
        begin
          // fazer o cálculo...
          if ((copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '1') or
            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '3') or
            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) = '7')) and
            (vItem.dataSet.FieldByName('ANTEC_TRIB').AsString = 'S') then
          begin
            FCalculoImposto.vValorICMSubResumo := FCalculoImposto.vValorICMSubResumo + vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
            dataSet.FieldByName('ANTEC_TRIB').AsString := 'S';
          end
          else
          if (
//            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) <> '1') and
            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) <> '6') //and
//            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) <> '3') and
//            (copy(vItem.dataSet.FieldByName('CST').AsString, 2, 1) <> '7')
              ) or (vItem.dataSet.FieldByName('ANTEC_TRIB').AsString <> 'S')
             then
          else
          begin
            if aliqinterna > 0 then
              aliqinterna := aliqinterna
            else if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
              aliqinterna := 18
            else if (vItem.vProd.dataSet.FieldByName('icm_prod').AsFloat > 0) then
              aliqinterna := vItem.vProd.dataSet.FieldByName('icm_prod').AsFloat
            else if vDadosIni.vEmp.vAliqIntraEstadual > 0 then
              aliqinterna := vDadosIni.vEmp.vAliqIntraEstadual
            else if vDadosIni.vEmp.vAliqPadrao > 0 then
              aliqinterna := vDadosIni.vEmp.vAliqPadrao
            else if aliqinterna = 0 then
              aliqinterna := 18;

            vValorTemp := vValorTempBase;

            vItem.dataSet.FieldByName('base_icmsub').AsFloat := (vValorTemp + (vValorTemp *
              vTempMVA / 100)); // /
            //              vItem.dataSet.FieldByName('quantidade').AsFloat;
            if (vItem.dataSet.FieldByName('valor_icm').AsFloat /
              vItem.dataSet.FieldByName('quantidade').AsFloat) > 0 then
              vItem.dataSet.FieldByName('valor_icmsub').AsFloat :=
                (vItem.dataSet.FieldByName('base_icmsub').AsFloat * aliqinterna / 100) -
                (vItem.dataSet.FieldByName('valor_icm').AsFloat /
                vItem.dataSet.FieldByName('quantidade').AsFloat)
            else
            begin
              vAliqTemp := 0;

              if vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0 then
                vAliqTemp := vItem.dataSet.FieldByName('aliq_icm').AsFloat
              else
              begin
                if (vDadosIni.vEmp.vSiglaUF <> dataSet.FieldByName('dest_uf').AsString) and
                  (vDadosIni.vEmp.vRegime <> 'SIMPLES') and
                   (vDadosIni.strEstaContidoEm(Copy(vItem.dataSet.FieldByName('cst').AsString, 1, 1), ['1', '2', '3'])) then
                      vAliqTemp := 4
                else
                if (vDadosIni.vEmp.vSiglaUF = dataSet.FieldByName('dest_uf').AsString) then
                  vAliqTemp := aliqinterna
                else
                begin
                  if FAliqAcordoCFOPMUDE = 0 then
                    Application.MessageBox(pchar('Produto: ' +
                      vItem.dataSet.FieldByName('grupo_prod').AsString +
                      ' ' + Trim(vItem.dataSet.FieldByName('cod_prod').AsString) +
                      ' ' + Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + sLineBreak +
                      'Descrição: ' + Trim(vItem.dataSet.FieldByName('descricao_item').AsString) +
                        sLineBreak +
                      'Tem antecipação tributária e não foi encontrada a aliquota do item na entrada'),
                      'Atenção', 0 + 64)
                  else
                    vAliqTemp := FAliqAcordoCFOPMUDE;
                end;
              end;
              //              vValorTemp := (vItem.dataSet.FieldByName('valor_total').AsFloat -
              //                vItem.dataSet.FieldByName('rateio_desconto').AsFloat) /
              //                vItem.dataSet.FieldByName('quantidade').AsFloat;

              vItem.dataSet.FieldByName('valor_icmsub').AsFloat :=
                (vItem.dataSet.FieldByName('base_icmsub').AsFloat * aliqinterna / 100) -
                (vValorTemp * vAliqTemp / 100);
              if vItem.dataSet.FieldByName('valor_icmsub').AsFloat < 0 then
              begin
                vItem.dataSet.FieldByName('valor_icmsub').AsFloat := 0;
                vItem.dataSet.FieldByName('base_icmsub').AsFloat := 0;
              end;
            end;
            vValorContabil := vValorContabil +
              vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
            FCalculoImposto.vValorICMSubResumo := FCalculoImposto.vValorICMSubResumo +
              (vItem.dataSet.FieldByName('valor_icmsub').AsFloat *
              vItem.dataSet.FieldByName('quantidade').AsFloat);
            vValorPr_Cusc_prod := vValorPr_Cusc_prod +
              vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
            vItem.dataSet.FieldByName('base_icmsub_ant').AsFloat := vItem.dataSet.FieldByName('base_icmsub').AsFloat ;
            vItem.dataSet.FieldByName('base_icmsub').AsFloat := vItem.dataSet.FieldByName('base_icmsub').AsFloat *
              vItem.dataSet.FieldByName('quantidade').AsFloat;
            vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat := vItem.dataSet.FieldByName('valor_icmsub').AsFloat ;
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat := vItem.dataSet.FieldByName('valor_icmsub').AsFloat *
              vItem.dataSet.FieldByName('quantidade').AsFloat;
            dataSet.FieldByName('ANTEC_TRIB').AsString := 'S';
          end;
        end;
        }

        vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat := vValorContabil;
        //Ver configuracao aqui para alterar ou nao o preco de reposicao
        vItem.dataSet.FieldByName('PREC_CUS_REP').AsFloat := vValorReposicao;
        vItem.dataSet.FieldByName('PR_CUSC_PROD').AsFloat := vValorPr_Cusc_prod;
        if (vItem.dataSet.FieldByName('VL_MULTP').AsFloat > 0) then
          vItem.dataSet.FieldByName('PREC_CUS_R').AsFloat :=
            (vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat /
            vItem.dataSet.FieldByName('VL_MULTP').AsFloat);

        //Percentual do frete
        vItem.dataSet.FieldByName('PERC_FRETE').AsFloat :=
          ((vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat /
          vItem.QtdeCalcCusto) * 100) /
          vItem.dataSet.FieldByName('VALOR_UNITARIO').AsFloat;

        //      vItem.dataSet.FieldByName('PR_CUSC_PROD').AsFloat :=
        //        vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat;

              //Atualizando o custo médio do produto.
        if vItem.vProd.dataSet.FieldByName('EST_F').AsFloat <= 0 then
          vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
            vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat
        else
        if ((vItem.vProd.dataSet.FieldByName('EST_F').AsFloat +
          {vItem.vProd.dataSet.FieldByName('EST_R').AsFloat +}
          vItem.dataSet.FieldByName('QUANTIDADE').AsFloat) <= 0) or
          (vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat <= 0) then
          vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
            vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat
        else
          vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat :=
            (((vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
            (vItem.vProd.dataSet.FieldByName('EST_F').AsFloat {+
            vItem.vProd.dataSet.FieldByName('EST_R').AsFloat})) +
            (vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat *
            vItem.QtdeCalcCusto)) /                                             // QtdeCalcCusto tem o teste de qtde = 0 e nota de ajuste ou complemento
            ((vItem.vProd.dataSet.FieldByName('EST_F').AsFloat {+
            vItem.vProd.dataSet.FieldByName('EST_R').AsFloat}) +
            vItem.dataSet.FieldByName('QUANTIDADE').AsFloat));

        vItem.CalcularPrecoItemDataSet;
        {
        //if (vDadosIni.vAlteraPrecoVendaEntradaNF = 'S') then
        //if (FConfig.Conf_Preco.AlteraPrecoNaEntrada) then
        if (vDadosIni.vProduto.Precos.AlterarPrecosAoConfirmarNF) then
        begin

          if (vItem.dataSet.FieldByName('PRCTB_ITEM').AsFloat > 0) and (vDadosIni.vEmp.vUsarAltPrecoNFDigItem <> 'S') then
          begin
            vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat := RoundTo(
              ArredondaPreco(vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat +
              ((vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
              vItem.dataSet.FieldByName('PRCTB_ITEM').AsFloat) / 100)), 0 - vDadosIni.vEmp.vCasasDecimais);

            vValorTempMarkup := vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat;

            vValorTempMarkup := (vValorTempMarkup - vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat) /
              vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat * 100;

            if RoundTo(vValorTempMarkup, -2) < RoundTo(vItem.dataSet.FieldByName('PRCTB_ITEM').AsFloat, -2) then
              vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat := vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat + 0.01;
          end
          else if (vDadosIni.vEmp.vUsarAltPrecoNFDigItem <> 'S') then
            vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat := 0;

          if (vItem.dataSet.FieldByName('PRCTB_ITEMA').AsFloat > 0) and (vDadosIni.vEmp.vUsarAltPrecoNFDigItem <> 'S') then
          begin
            vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat := RoundTo(
              ArredondaPreco(vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat +
              ((vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
              vItem.dataSet.FieldByName('PRCTB_ITEMA').AsFloat) / 100)), 0 - vDadosIni.vEmp.vCasasDecimais);

            vValorTempMarkup := vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat;

            vValorTempMarkup := (vValorTempMarkup - vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat) /
              vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat * 100;

            if RoundTo(vValorTempMarkup, -2) < RoundTo(vItem.dataSet.FieldByName('PRCTB_ITEMA').AsFloat, -2) then
              vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat := vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat + 0.01;
          end
          else if (vDadosIni.vEmp.vUsarAltPrecoNFDigItem <> 'S') then
            vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat := 0;

          // Preços a prazo

          if (vDadosIni.vProduto.Precos.UsarPercAdicional306090) then
          begin

            if (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat > 0 ) and
              (vItem.vProd.dataSet.FieldByName('PERC_AD_30').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_30_PROD').AsFloat :=
                vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat +
                (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat *
                  vItem.vProd.dataSet.FieldByName('PERC_AD_30').AsFloat / 100);

            if (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat > 0 ) and
              (vItem.vProd.dataSet.FieldByName('PERC_AD_60').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_60_PROD').AsFloat :=
                vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat +
                (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat *
                  vItem.vProd.dataSet.FieldByName('PERC_AD_60').AsFloat / 100);

            if (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat > 0 ) and
              (vItem.vProd.dataSet.FieldByName('PERC_AD_90').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_90_PROD').AsFloat :=
                vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat +
                (vItem.dataSet.FieldByName('prec_vnd_prod').AsFloat *
                  vItem.vProd.dataSet.FieldByName('PERC_AD_90').AsFloat / 100);

          end
          else
          begin
            if (vItem.vProd.dataSet.FieldByName('PERC_TB_PROD3').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_30_PROD').AsFloat :=
                ArredondaPreco(vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat +
                ((vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
                vItem.vProd.dataSet.FieldByName('PERC_TB_PROD3').AsFloat) / 100))
            else
              vItem.dataSet.FieldByName('PREC_30_PROD').AsFloat := 0;

            if (vItem.vProd.dataSet.FieldByName('PERC_TB_PROD6').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_60_PROD').AsFloat :=
                ArredondaPreco(vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat +
                ((vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
                vItem.vProd.dataSet.FieldByName('PERC_TB_PROD6').AsFloat) / 100))
            else
              vItem.dataSet.FieldByName('PREC_60_PROD').AsFloat := 0;

            if (vItem.vProd.dataSet.FieldByName('PERC_TB_PROD9').AsFloat > 0) then
              vItem.dataSet.FieldByName('PREC_90_PROD').AsFloat :=
                ArredondaPreco(vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat +
                ((vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat *
                vItem.vProd.dataSet.FieldByName('PERC_TB_PROD9').AsFloat) / 100))
            else
              vItem.dataSet.FieldByName('PREC_90_PROD').AsFloat := 0;
          end;

        end;

        vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('PREC_VND_PROD').AsFloat, vDadosIni.vEmp.vCasasDecimais);
        vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('PREC_VND_PRODA').AsFloat, vDadosIni.vEmp.vCasasDecimais);
        }
        vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat, 4);
        vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat, 4);
        vItem.dataSet.Post;
      end
      else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'V') then
      begin
        vValorPISCOFINS := 0;
        try
          vItem.vDetVeic.dataSet.Filter := 'NITEM = ' + IntToStr(vItem.dataSet.FieldByName('NITEM').AsInteger);
          vItem.vDetVeic.dataSet.Filtered := True;
          if ((vDadosIni.vEmp.vVersaoVeiculos = '4') and (vItem.dataSet.FieldByName('TIPV_VEICULO').AsString = 'V'))
          or (vDadosIni.vEmp.vVersaoVeiculos <> '4') then
          begin
            if vItem.dataSet.FieldByName('valor_pis_st').AsFloat > 0 then
              vValorPISCOFINS := vValorPISCOFINS + vItem.dataSet.FieldByName('valor_pis_st').AsFloat;
            if vItem.dataSet.FieldByName('valor_cofins_st').AsFloat > 0 then
              vValorPISCOFINS := vValorPISCOFINS + vItem.dataSet.FieldByName('valor_cofins_st').AsFloat;
            if (vValorPISCOFINS = 0) and (Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) <> 'U') then
              vValorPISCOFINS := vItem.dataSet.FieldByName('PISCOFINS').AsFloat;
          end;

        finally
          vItem.vDetVeic.dataSet.Filtered := False;
          vItem.vDetVeic.dataSet.Filter := '';
        end;

        vValorPr_Cusc_prod := (((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
          vItem.dataSet.FieldByName('quantidade').AsFloat) -
          (vItem.dataSet.FieldByName('rateio_desconto').AsFloat {+
          vItem.dataSet.FieldByName('valor_desconto_perc').AsFloat}) +
          (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
          vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +    
          vItem.dataSet.FieldByName('nfe_vipidevol').AsFloat +
          vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
          vItem.dataSet.FieldByName('vicmsmonoreten').AsFloat +
          vItem.dataSet.FieldByName('valor_ii').AsFloat)
          ) / vItem.QtdeCalcCusto) +
          vValorPISCOFINS;
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := vValorPr_Cusc_prod;
        vItem.dataSet.Post;

        try
          vItem.vDetVeic.dataSet.Filter := 'nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger);
          vItem.vDetVeic.dataSet.Filtered := True;
          if (vItem.dataSet.FieldByName('nitem').AsInteger = vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger) then
          begin
            vItem.vDetVeic.dataSet.Edit;
            vItem.vDetVeic.dataSet.FieldByName('preco_custo').AsFloat :=
              vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
            vItem.vDetVeic.dataSet.Post;
          end;
        finally
          vItem.vDetVeic.dataSet.Filtered := False;
          vItem.vDetVeic.dataSet.Filter := '';
        end;

      end
      else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'S') then
      begin
        vValorPr_Cusc_prod := (((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
          vItem.dataSet.FieldByName('quantidade').AsFloat) -
          (vItem.dataSet.FieldByName('rateio_desconto').AsFloat {+
          vItem.dataSet.FieldByName('valor_desconto_perc').AsFloat}) +
          (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
          vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +
          vItem.dataSet.FieldByName('nfe_vipidevol').AsFloat +
          vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat +
          vItem.dataSet.FieldByName('valor_ii').AsFloat +
          vItem.dataSet.FieldByName('valor_pis_st').AsFloat +
          vItem.dataSet.FieldByName('valor_cofins_st').AsFloat)
          ) / vItem.QtdeCalcCusto);
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat := vDadosIni.StrToFloatFormat(
          vValorPr_Cusc_prod, 4);
        vItem.dataSet.FieldByName('PREC_CUS_CNT').AsFloat := vDadosIni.StrToFloatFormat(
          vValorPr_Cusc_prod, 4);
        vItem.dataSet.Post;
      end
      else if (vItem.dataSet.FieldByName('tipo_item').AsString = 'O') then
      begin
        {
        Resposta := vItem.calcucarAntecipacaoTributariaST(Self,
          vDadosIni.IfThen(operacao = opdResumo, opdValidacao, opdCalculoCusto));
        if vDadosIni.getValue(Resposta, 1) <> 'OK' then
        begin
          ListaErros.Add('-');
          ListaErros.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
            Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
            Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
          ListaErros.Add(' * ' + vDadosIni.getValue(Resposta, 1));
        end
        else if vDadosIni.getValue(Resposta, 2) <> '' then
        begin
          ListaAlerta.Add('-');
          ListaAlerta.Add( 'Item ' + vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
            Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString) + ' ' +
            Trim(vItem.dataSet.FieldByName('descricao_item').AsString));
          ListaAlerta.Add(' * ' + vDadosIni.getValue(Resposta, 2));
        end;
        }
        
        // calculo de recomposicao do icms-- rei da borracha
        vItem.calcucarReconposicaoDeICMS(Self);
        // calculo de recomposicao do icms-- rei da borracha

      end;
      vItem.dataSet.Next;
    end;
    
    if ListaAlerta.Count > 0 then
      Application.MessageBox(PChar('Antecipação Tributaria de ICMS com Alertas' + sLineBreak +
        ListaAlerta.Text), 'Atenção', MB_ICONINFORMATION + MB_OK);

    if AsTrueValue(Config.Conf_Geral.nf_hab_validacao_antecipacao_st.value1_f) then
    begin
      if ListaErros.Count > 0 then
      begin
        Application.MessageBox(PChar('Antecipação Tributaria de ICMS com Irregularidades' + sLineBreak +
          ListaErros.Text), 'Atenção', MB_ICONWARNING + MB_OK);
        if vDadosIni.PesqPros('NF0197', 'VALIDAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
          'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas)  then
        begin
          for I := 0 to ListaErros.Count - 1 do
            vDadosIni.GravaAuditoria('NF0197', 'VALIDAR', 'NITEM/COD ' +
             vDadosIni.StrZero(vItem.dataSet.FieldByName('nitem').AsInteger, 3) + '/' +
              Trim(vItem.dataSet.FieldByName('num_fab_prod').AsString),
              'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
          ListaErros.Clear;
        end;
      end;
      Result := ListaErros.Count = 0;
    end
    else
      Result := true;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('procedure CalcularCustoDosProduto Erro: ' + e.Message);
    end;
  end;
end;

function TNFCab.calcularDadosDeOlhoNoImposto: Boolean;
var
  vTotTrib: Extended;
  AAliquota: Double;
  ANCM, AUF: string;
  AEX: Integer;
  AConsultaIBPT: Boolean;
begin
  Exit;
  {
  if dataSet.FieldByName('consumidor_final').AsString = 'S' then
    AConsultaIBPT := vDadosIni.getConfSisBool('nf_ibpt_consulta_tributos', buscas)
  else
    AConsultaIBPT := False;

  vTotTrib := 0;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if dataSet.FieldByName('consumidor_final').AsString <> 'S' then
    begin
      vItem.dataSet.Edit;
      vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := 0;
      vItem.dataSet.Post;
    end
    else if Trim(vItem.dataSet.FieldByName('tipo_item').AsString) = 'S' then
    begin
      
      buscas.close;
      buscas.SQL.Text := 'select se.aliqnac aliqnac_116, se.aliqimp aliqimp_116,' +
                         ' n.aliqnac aliqnac_nbs, n.aliqimp aliqimp_nbs from tipo_servico s' +
                         ' inner join tipo_servico_empresa semp on semp.cod_servico = s.cod_servico and semp.cod_empresa = ' + vDadosIni.codEmpresa +
                         ' left join tiposerviconfse se on se.cod_tpservico = s.nfs_servico' +
                         ' left join nbs n on n.cod_nbs = se.cod_nbs' +
                         ' where s.cod_servico = '+ IntToStr(vItem.dataSet.FieldByName('cod_servico').AsInteger) +
                         ' AND semp.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      vItem.dataSet.Edit;
      if //(Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03450') > 0) and
        (buscas.FieldByName('ALIQNAC_116').AsFloat > 0) then
          vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * buscas.FieldByName('ALIQNAC_116').AsFloat / 100, 2)
      else if //(Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03450') > 0) and
        (buscas.FieldByName('ALIQNAC_nbs').AsFloat > 0) then
          vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
            vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * buscas.FieldByName('ALIQNAC_nbs').AsFloat / 100, 2)
//      else if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03450') = 0) and
//        (buscas.FieldByName('aliqimp_116').AsFloat > 0) then
//        vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
//          vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * buscas.FieldByName('aliqimp_116').AsFloat / 100, 2)
//      else if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03450') = 0) and
//        (buscas.FieldByName('aliqimp_nbs').AsFloat > 0) then
//        vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
//          vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * buscas.FieldByName('aliqimp_nbs').AsFloat / 100, 2)
      else
        vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * vDadosIni.vEmp.vAliqPadraoDeOlhoImpostoServico / 100, 2);
      vItem.dataSet.Post;
      vTotTrib := vTotTrib + vItem.dataSet.FieldByName('VTOTTRIB').AsFloat;
    end
    else if Trim(vItem.dataSet.FieldByName('NCM').AsString) <> '' then
    begin
      ANCM := Trim(vItem.dataSet.FieldByName('NCM').AsString);
      AUF := vDadosIni.vEmp.vSiglaUF;
      AEX := 0;

      buscas.close;
      buscas.SQL.Text := 'select NACIONAL, ESTADUAL, IMPORTADO, MUNICIPAL, VIGENCIAFIM from IBPT' +
        ' where CODIGO = '+ QuotedStr(Trim(vItem.dataSet.FieldByName('ncm').AsString)) +
        ' and UF = ' + QuotedStr(AUF) +
        ' and EX = ' + IntToStr(AEX);
      buscas.Open;

      if ((buscas.IsEmpty) or (Date > buscas.FieldByName('VIGENCIAFIM').AsDateTime)) and (Length(ANCM) = 8) then
        if AConsultaIBPT then
        begin
          hw_ibpt_produtos_get( vDadosIni.vBancoHW, vDadosIni.fdbUsuario, vDadosIni.fdbSenha, StrToInt(vDadosIni.codEmpresa),
            '03530705000109', ANCM, AUF, AEX);
          buscas.Close;
          buscas.Open;
        end;

      AAliquota := vDadosIni.vEmp.vAliqPadraoDeOlhoImpostoProduto;
      if not buscas.IsEmpty then
      begin
        if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03458') > 0) then
          AAliquota := buscas.FieldByName('NACIONAL').AsFloat +
                       buscas.FieldByName('ESTADUAL').AsFloat +
                       buscas.FieldByName('MUNICIPAL').AsFloat
        else if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03458') = 0) then
          AAliquota := buscas.FieldByName('IMPORTADO').AsFloat +
                       buscas.FieldByName('ESTADUAL').AsFloat +
                       buscas.FieldByName('MUNICIPAL').AsFloat;
      end
      else
      begin
        buscas.close;
        buscas.SQL.Text := 'select ALIQNAC, ALIQIMP from nbm' +
          ' where cod_ncm = '+ QuotedStr(Trim(vItem.dataSet.FieldByName('ncm').AsString));
        buscas.Open;

        if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03458') > 0) and
         (buscas.FieldByName('ALIQNAC').AsFloat > 0) then
          AAliquota := buscas.FieldByName('ALIQNAC').AsFloat
        else if (Pos( copy(vItem.dataSet.FieldByName('cst').AsString,1,1), '03458') = 0) and
          (buscas.FieldByName('ALIQIMP').AsFloat > 0) then
          AAliquota := buscas.FieldByName('ALIQIMP').AsFloat;;
      end;

      vItem.dataSet.Edit;
      vItem.dataSet.FieldByName('VTOTTRIB').AsFloat :=
        vDadosIni.StrToFloatFormat(AAliquota * vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat / 100, 2);

      vItem.dataSet.Post;
      vTotTrib := vTotTrib + vItem.dataSet.FieldByName('VTOTTRIB').AsFloat;

    end
    else if Trim(vItem.dataSet.FieldByName('tipo_item').AsString) = 'P' then
    begin
      if vDadosIni.vEmp.vAliqPadraoDeOlhoImpostoProduto > 0 then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('VTOTTRIB').AsFloat := vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('VALOR_TOTAL').AsFloat * vDadosIni.vEmp.vAliqPadraoDeOlhoImpostoProduto / 100, 2);
        vItem.dataSet.Post;
        vTotTrib := vTotTrib + vItem.dataSet.FieldByName('VTOTTRIB').AsFloat;
      end;

    end;
    vItem.dataSet.Next;
  end;
  if dataSet.State in [dsInsert, dsEdit] then
    dataSet.FieldByName('VTOTTRIB').AsFloat := vTotTrib;
  }
end;

