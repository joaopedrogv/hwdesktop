function TNFCab.retornaCodDepto: Integer;
var
 vTemp: Integer;
 buscas2: TIBQuery;
begin
  vTemp := 0;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  buscas2.Close;
  buscas2.SQL.Text := ' SELECT COALESCE(COD_DEPTO, 0) COD_DEPTO FROM DEPTO ' +
  	' WHERE ATIVO = 1 AND TRIM(COALESCE(INICIAIS_DEPTO, '''')) <> '''' ' ;
  if dataSet.FieldByName('tipo_nf').AsString = 'P' then
    buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO IN (''VENDA DE PEÇAS'', ''ESTOQUE'') '
  else if dataSet.FieldByName('tipo_nf').AsString = 'V' then
  	buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO IN (''VENDA DE MOTOS'', ''VEICULOS'') '
  else
  	buscas2.SQL.Text := buscas2.SQL.Text + ' AND NOME_DEPTO = ' + QuotedStr(vDadosIni.vDpto);
  buscas2.Open;

  if buscas2.FieldByName('COD_DEPTO').AsInteger > 0 then
    vTemp := buscas2.FieldByName('COD_DEPTO').AsInteger;
  Result := vTemp;
end;

function TNFCab.retornaComEstoqueECF: boolean;
var
  QtdePendente, QtdeInformada, QtdeTotal: Integer;
begin
  Result := True;
  vItem.vDetEcf.vEstoqueECF.selecionaEstoqueECFRetorno(vItem.dataSet.FieldByName('grupo_prod').AsInteger,
    vItem.dataSet.FieldByName('cod_prod').AsString);
  QtdeTotal := Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat);
  if vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount < QtdeTotal then
  begin
    Application.MessageBox(pchar('Estoque de Equipamentos insuficiente' + sLineBreak +
      'Quantidade encontrada: ' + IntToStr(vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount)
      ), 'Atenção', MB_OK + MB_ICONINFORMATION);
    //gravar auditoria aqui
    QtdeTotal := vItem.vDetEcf.vEstoqueECF.dataSet.RecordCount;
  end;
  QtdePendente := QtdeTotal;
  QtdeInformada := 0;

  while QtdePendente <> QtdeInformada do
  begin
    vItem.vDetEcf.dataSet.Insert;
    if abreFormDetalhesECFSaida(QtdeTotal, QtdePendente, QtdeInformada) then
    begin
      vItem.vDetEcf.dataSet.Insert;
      vItem.vDetEcf.dataSet.FieldByName('cod_nf').AsInteger :=
        dataSet.FieldByName('cod_nf').AsInteger;
      vItem.vDetEcf.dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
      vItem.vDetEcf.dataSet.FieldByName('nitem').AsInteger :=
        vItem.dataSet.FieldByName('nitem').AsInteger;
      vItem.vDetEcf.dataSet.FieldByName('grupo_prod').AsInteger :=
