function TNFCab.imprimeDanfeSimplificadoDadosTransporte(
	pCodEtiq: Integer; pQuantidade: Integer; apenasProcessada: Boolean): boolean;
var
  HandleRel: THandle;
  EtiquetasQRP: TEtiquetasQuickReport;
  Tabela: string;
  Caption: string;
  Consulta: string;
  I: Integer;
  enviarImpressao: Boolean;
begin
  pQuantidade := IfThen(pQuantidade > 1, pQuantidade, 1);
	Tabela := 'NOTAFISCAL_DANFE';
  Caption := 'Dados transporte';

//  Consulta := ' select * from ' + Tabela +
//    ' where cod_nf = ' + IntToStr(dataSet.FieldByName('COD_NF').AsInteger) +
//    ' and cod_empresa = ' + vDadosIni.codEmpresa;

  HandleRel := 0;
  try
    HandleRel := LoadLibrary('RelQReportHW.dll');
    if HandleRel <> 0 then
    begin
      @EtiquetasQRP := GetProcAddress(HandleRel, 'ChamaReport2');

      for I := Low(FarrayOfcod_nf) to High(FarrayOfcod_nf) do
      begin
        if apenasProcessada then
          enviarImpressao := MatchText(
            SqlScalar('select situacao_nfe from notafiscal where cod_nf = %d and cod_empresa = %d', [FarrayOfcod_nf[I], vDadosIni.cod_empresa]).AsString,
            [sitAutorizada, sitEmEPEC])
        else
          enviarImpressao := True;

        if enviarImpressao then
        begin

          Consulta := ' select * from ' + Tabela +
            ' where cod_nf = ' + IntToStr(FarrayOfcod_nf[I]) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;

          EtiquetasQRP(
            Pchar(Tabela),
            PChar(Caption),
            Pchar(vDadosIni.vBancoHW),
            strtoint(vDadosIni.codEmpresa),
            PChar(Consulta),
            pCodEtiq,
            pQuantidade);
        end;
      end;
    end;
  finally
    FreeLibrary(HandleRel);
  end;
end;

