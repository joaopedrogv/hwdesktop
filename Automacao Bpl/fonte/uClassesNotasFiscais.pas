            vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
              vIt2Nf.FieldByName('codigo_nop').AsFloat;
            vItem.dataSet.FieldByName('desc_natop').AsString :=
              vIt2Nf.FieldByName('desc_natop').AsString;
            vItem.dataSet.FieldByName('cst').AsString := vIt2Nf.FieldByName('cst').AsString;
            vItem.dataSet.FieldByName('csosn').AsString :=
