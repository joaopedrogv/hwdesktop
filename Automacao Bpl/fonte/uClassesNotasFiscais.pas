function TNFCab.montarControleInternoDevolucao: Boolean;
var
  vSEQUENCIA, vCOD_VENDEDOR, vCOD_CLIENTE: Integer;
  vValorItem, vValorDevolucao: Extended;
  vTemp, vNOME_CLIENTE: string;
  vTemDevolucao, vOK: Boolean;
  vCodVendaDev: Integer;
  vTipoVendaDev: string;
  Config: TConfig_sistema_class;
  vUtilizarDataVencimento: string;
  vDiasVencimento: string;
  vDataAtual: TDateTime;
  I: Integer;
begin
  Result := True;
  if vDadosIni.vEmp.vDev_UsarControleInternoDevolucao = 'N' then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    Exit;

  if dataSet.FieldByName('COD_DEVOLUCAO').AsInteger > 0 then
    Exit;

  vDataAtual := vDadosIni.getDataBanco(buscas);

  vTemDevolucao := False;
  vValorDevolucao := 0;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and (vItem.dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString <> 'N') and
      (cfopDeDevolucao(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)))then
    begin
      // Checar se ja existe devolucao para esta nf
      if not ExecutaComandosSql('select cod_nf, nitem_nf from devolucao' +
        ' where cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
        ' and nitem_nf = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa) then
      begin
        vTemDevolucao := True;
        Break;
      end;
    end;
    vItem.dataSet.Next;
  end;

  vDadosIni.vInibeMensPesqPros := 'N';
  if vTemDevolucao then
  begin

    if not vDadosIni.PesqPros('NF0141', 'INCLUIR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas,True) then
    begin
      if Application.MessageBox(pchar('Geração automática de Controle Interno de Devolução não poderá ser feita!' + sLineBreak +
        'O processo "NF0141" não está liberado para o nível '+ IntToStr(vDadosIni.vNivel) + sLineBreak +
        'Deseja continuar com o fechamento da nota fiscal mesmo assim?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDYES then
      begin
        Result := True;
        vDadosIni.GravaAuditoria('NF0141', 'INCLUIR', 'FALHA NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) + ' PROCESSO NAO PERMITIDO',
          'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
        Exit;
      end;
    end;
  end;

  vSEQUENCIA := 0;
  vCOD_VENDEDOR := 0;
  Result := False;
  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and (vItem.dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString <> 'N') and
        (cfopDeDevolucao(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat)))then
      begin
        if not ExecutaComandosSql('select cod_nf, nitem_nf from devolucao' +
          ' where cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
          ' and nitem_nf = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa) then
        begin

          if vSEQUENCIA = 0 then
            vSEQUENCIA := GenCodigo('DEVOLUCAO', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);

          vValorItem := ((vItem.dataSet.FieldByName('valor_unitario').AsFloat *
            vItem.dataSet.FieldByName('quantidade').AsFloat) -
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat) //+
//            (vItem.dataSet.FieldByName('valor_ipi').AsFloat +
//            vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat +
//            vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat +
//            vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat +
//            vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat +
//            vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat +
//            vItem.dataSet.FieldByName('valor_ii').AsFloat +
//            vItem.dataSet.FieldByName('valor_pis_st').AsFloat +
//            vItem.dataSet.FieldByName('valor_cofins_st').AsFloat)
            ) / vItem.dataSet.FieldByName('quantidade').AsFloat;
//          vValorItem := vValorItem + (vItem.dataSet.FieldByName('valor_dif').AsFloat /
//            vItem.dataSet.FieldByName('quantidade').AsFloat);

          buscas.Close;
          vCodVendaDev := 0;
          vTipoVendaDev := '';

          buscas.SQL.Text := '';
          buscas.SQL.Text := 'INSERT INTO DEVOLUCAO (SEQUENCIA, GRUPO_PROD, COD_PROD, COD_EMPRESA, NUM_FAB_PROD, DESCRICAO, ' +
            ' QUANT, QUANT_C, VALOR, VALOR_TOT, DATA, COD_VENDEDOR, NUM_NOTA_NFE, COD_FORNECEDOR, COD_VENDA, COD_NF, NITEM_NF,' +
            ' COD_GRADE, PCUST_MC, NOME_CLIENTE, ENDERECO, TELEFONE, COD_CLIENTE, COMISS_PROD, COMISS_PROD_GER, ' +
            ' TIPO_VENDA, TIPO, NF_GEROU, UNIDADE, UNIDADE_CONV, OPERACAO_CONV, FATOR_CONV)' +
            ' VALUES (:SEQUENCIA, :GRUPO_PROD, :COD_PROD, :COD_EMPRESA, :NUM_FAB_PROD, :DESCRICAO, ' +
            ' :QUANT, :QUANT_C, :VALOR, :VALOR_TOT, :DATA, :COD_VENDEDOR, :NUM_NOTA_NFE, :COD_FORNECEDOR, :COD_VENDA, :COD_NF, :NITEM_NF,' +
            ' :COD_GRADE, :PCUST_MC, :NOME_CLIENTE, :ENDERECO, :TELEFONE, :COD_CLIENTE, :COMISS_PROD, :COMISS_PROD_GER, ' +
            ' :TIPO_VENDA, ''D'', ''S'', :UNIDADE, :UNIDADE_CONV, :OPERACAO_CONV, :FATOR_CONV)';
          buscas.ParamByName('SEQUENCIA').Value := vSEQUENCIA;
          buscas.ParamByName('GRUPO_PROD').AsInteger := vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := vItem.dataSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('COD_EMPRESA').AsInteger := vItem.dataSet.FieldByName('COD_EMPRESA').AsInteger;
          buscas.ParamByName('NUM_FAB_PROD').AsString := vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString;
          buscas.ParamByName('DESCRICAO').AsString := copy(Trim(vItem.dataSet.FieldByName('DESCRICAO_ITEM').AsString),1,75);
          buscas.ParamByName('QUANT_C').AsFloat := vItem.dataSet.FieldByName('QUANTIDADE').AsFloat;
          buscas.ParamByName('DATA').AsDate := vDataAtual;
          buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
          buscas.ParamByName('COD_FORNECEDOR').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
          buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
          buscas.ParamByName('NITEM_NF').AsInteger := vItem.dataSet.FieldByName('NITEM').AsInteger;

          buscas.ParamByName('UNIDADE').AsString := vItem.fstr('referencia');

          if vItem.fstr('unidade_nf') = '' then
            buscas.ParamByName('UNIDADE_CONV').AsString := vItem.fstr('referencia')
          else
          begin
            buscas.ParamByName('UNIDADE_CONV').AsString := vItem.fstr('unidade_nf');
            if (fstr('import_xml') >= strDataVersion)
              and (vItem.fstr('referencia') <> vItem.fstr('unidade_nf')) then
            begin
              buscas.ParamByName('OPERACAO_CONV').AsString := IfThen(vItem.ffloat('qtdemb') > 1, 'M', 'D');
              if vItem.ffloat('qtdemb') > 1 then
                buscas.ParamByName('FATOR_CONV').AsFloat := vItem.ffloat('qtdemb')
              else if vItem.ffloat('qtdemb') > 0 then
                buscas.ParamByName('FATOR_CONV').AsFloat := 1 / vItem.ffloat('qtdemb')
              else
                buscas.ParamByName('FATOR_CONV').AsFloat := 1;
            end;
          end;

          _buscas.Close;
          if ((vItem.dataSet.FieldByName('nped').AsInteger > 0) and
            (vItem.dataSet.FieldByName('nitem_ped').AsInteger > 0) and
            (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) <> '')) then
          begin
            _buscas.SQL.Text := 'select c.nome_cliente, pp.cod_vendedor, p.nped, p.cod_cliente, pp.quant_ped_item,' +
              ' (pp.vltot_ped_item + coalesce(pp.rateio_acresc,0) - coalesce(pp.rateio_desc, 0)) valor_total,' +
              ' pp.pcust_mc, pp.cod_grade, c.endereco, c.fone_cliente, pp.comiss_prod, pp.comiss_prod_ger,' +
              ' pp.tipo from pedvenda p' +
              ' inner join pedvenda_prod pp on p.nped = pp.nped and p.cod_empresa = pp.cod_empresa' +
              ' inner join clientes c on c.cod_cliente = p.cod_cliente and c.cod_empresa = p.cod_empresa' +
              ' where pp.nped = ' + IntToStr(vItem.dataSet.FieldByName('nped').AsInteger) +
              ' and pp.nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem_ped').AsInteger) +
              ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and pp.tipo = ' + QuotedStr(vItem.dataSet.FieldByName('tipo_ped').AsString) +
              ' and pp.grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
              ' and pp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString);
            _buscas.Open;
          end;
          if (_buscas.IsEmpty) or (not _buscas.Active) then
          begin
            if ((vItem.dataSet.FieldByName('cod_nf_dev').AsInteger > 0) and
              (vItem.dataSet.FieldByName('nitem_dev').AsInteger > 0)) then
            begin
              _buscas.SQL.Text := 'select c.nome_cliente, pp.cod_vendedor, p.nped, p.cod_cliente, pp.quant_ped_item,' +
                ' (pp.vltot_ped_item + coalesce(pp.rateio_acresc,0) - coalesce(pp.rateio_desc, 0)) valor_total,' +
                ' pp.pcust_mc, pp.cod_grade, c.endereco, c.fone_cliente, pp.comiss_prod, pp.comiss_prod_ger,' +
                ' pp.tipo from pedvenda p' +
                ' inner join pedvenda_prod pp on p.nped = pp.nped and p.cod_empresa = pp.cod_empresa' +
                ' inner join clientes c on c.cod_cliente = p.cod_cliente and c.cod_empresa = p.cod_empresa' +
                ' inner join notafiscal_item ni on ni.nped = pp.nped and ni.nitem_ped = pp.nitem and ni.tipo_ped = pp.tipo and ni.cod_empresa = pp.cod_empresa' +
                ' where ni.cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf_dev').AsInteger) +
                ' and ni.nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem_dev').AsInteger) +
                ' and ni.cod_empresa = ' + vDadosIni.codEmpresa +
                ' and pp.grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
                ' and pp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString);
              _buscas.Open;
            end;

            if (_buscas.IsEmpty) or (not _buscas.Active) then
            begin
              _buscas.SQL.Text := 'select c.nome_cliente, pp.cod_vendedor, p.nped, p.cod_cliente, pp.quant_ped_item,' +
                ' (pp.vltot_ped_item + coalesce(pp.rateio_acresc,0) - coalesce(pp.rateio_desc, 0)) valor_total,' +
                ' pp.pcust_mc, pp.cod_grade, c.endereco, c.fone_cliente, pp.comiss_prod, pp.comiss_prod_ger,' +
                ' pp.tipo from pedvenda p' +
                ' inner join pedvenda_prod pp on p.nped = pp.nped and p.cod_empresa = pp.cod_empresa' +
                ' inner join clientes c on c.cod_cliente = p.cod_cliente and c.cod_empresa = p.cod_empresa' +
                ' where pp.cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf_dev').AsInteger) +
                ' and pp.nitem_nf = ' + IntToStr(vItem.dataSet.FieldByName('nitem_dev').AsInteger) +
                ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
                ' and pp.tipo = ''REQ''' +
                ' and pp.grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
                ' and pp.cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString);
              _buscas.Open;
            end;
          end;
          if (not _buscas.IsEmpty) and (_buscas.Active) then
          begin
            vCOD_CLIENTE := _buscas.FieldByName('cod_cliente').AsInteger;
            vNOME_CLIENTE := _buscas.FieldByName('nome_cliente').AsString;
            buscas.ParamByName('COD_CLIENTE').AsInteger := _buscas.FieldByName('cod_cliente').AsInteger;
            buscas.ParamByName('NOME_CLIENTE').AsString := copy(Trim(_buscas.FieldByName('nome_cliente').AsString), 1,35);
            buscas.ParamByName('COD_VENDEDOR').AsInteger := _buscas.FieldByName('cod_vendedor').AsInteger;
            buscas.ParamByName('COD_VENDA').AsInteger := _buscas.FieldByName('nped').AsInteger;
            buscas.ParamByName('QUANT').AsFloat := vItem.dataSet.FieldByName('QUANTIDADE').AsFloat;
            buscas.ParamByName('VALOR').AsFloat := _buscas.FieldByName('valor_total').AsFloat / _buscas.FieldByName('quant_ped_item').AsFloat;
            buscas.ParamByName('VALOR_TOT').AsFloat := vDadosIni.StrToFloatFormat(_buscas.FieldByName('valor_total').AsFloat, 2);
            buscas.ParamByName('PCUST_MC').AsFloat := _buscas.FieldByName('pcust_mc').AsFloat;
            buscas.ParamByName('COD_GRADE').AsInteger := _buscas.FieldByName('cod_grade').AsInteger;
            buscas.ParamByName('ENDERECO').AsString := copy(Trim(_buscas.FieldByName('endereco').AsString), 1,50);
            buscas.ParamByName('TELEFONE').AsString := copy(Trim(_buscas.FieldByName('fone_cliente').AsString),1,14);
            buscas.ParamByName('COMISS_PROD').AsFloat := _buscas.FieldByName('COMISS_PROD').AsFloat;
            buscas.ParamByName('COMISS_PROD_GER').AsFloat := _buscas.FieldByName('COMISS_PROD_GER').AsFloat;
            buscas.ParamByName('TIPO_VENDA').AsString := copy(Trim(_buscas.FieldByName('tipo').AsString),1,3);
          end
          else
          begin
            while vCOD_VENDEDOR = 0 do
            begin

              if not InputQuery('Código do Vendedor', 'Informe o código do vendedor que realizou a venda', vTemp) then
                if Application.MessageBox(pchar('O Controle Interno de Devolução não será gerado se não informado' +
                  ' o Código do Vendedor' + sLineBreak +
                  'Deseja cancelar o cadastro do Controle Interno de Devolução?'), 'Confirmação',
                  MB_ICONQUESTION + MB_YESNO ) = IDYES then
                begin
                  vDadosIni.GravaAuditoria('NF0141', 'INCLUIR', 'FALHA NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) + ' NAO INFORMOU CODIGO VENDEDOR',
                    'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
                  Exit;
                end
                else
                  Continue;

              try
                vCOD_VENDEDOR := StrToInt(vTemp)
              except
                Application.MessageBox('Código digitado Inválido', 'Atenção', 64);
              end;
              if vCOD_VENDEDOR <> 0 then
              begin
                _buscas.Close;
                _buscas.SQL.Text := 'select nome_vendedor from colaborador' +
                  ' where cod_vendedor = ' + IntToStr(vCOD_VENDEDOR) +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa;
                _buscas.Open;
                if _buscas.IsEmpty then
                begin
                  Application.MessageBox('Vendedor não encontrado com o Código digitado', 'Atenção', 64);
                  vCOD_VENDEDOR := 0;
                end
                else
                begin
                  if Application.MessageBox(pchar(
                    'Código: ' + IntToStr(vCOD_VENDEDOR) + sLineBreak +
                    'Nome: ' + Trim(_buscas.FieldByName('nome_vendedor').AsString) + sLineBreak +
                    'O vendedor informado está correto?'), 'Confirmação',
                    MB_ICONQUESTION + MB_YESNO ) <> IDYES then
                    vCOD_VENDEDOR := 0;
                end;
              end;
            end;

            vCOD_CLIENTE := dataSet.FieldByName('cod_cliente').AsInteger;
            vNOME_CLIENTE := dataSet.FieldByName('nome_cliente').AsString;
            buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
            buscas.ParamByName('NOME_CLIENTE').AsString := copy(Trim(dataSet.FieldByName('nome_cliente').AsString),1,35);
            buscas.ParamByName('COD_VENDEDOR').AsInteger := vCOD_VENDEDOR;
            buscas.ParamByName('COD_VENDA').Value := Null;
            buscas.ParamByName('QUANT').AsFloat := vItem.dataSet.FieldByName('QUANTIDADE').AsFloat;
            buscas.ParamByName('VALOR').AsFloat := vValorItem;
            buscas.ParamByName('VALOR_TOT').AsFloat := vDadosIni.StrToFloatFormat(vValorItem * vItem.dataSet.FieldByName('QUANTIDADE').AsFloat, 2);
            buscas.ParamByName('PCUST_MC').AsFloat := vItem.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
            buscas.ParamByName('COD_GRADE').AsInteger := vItem.fint('cod_grade');
            buscas.ParamByName('ENDERECO').AsString := copy(Trim(dataSet.FieldByName('dest_xlgr').AsString),1,50);
            buscas.ParamByName('TELEFONE').AsString := copy(Trim(dataSet.FieldByName('dest_fone').AsString),1,14);
            buscas.ParamByName('COMISS_PROD').AsFloat := 0;
            buscas.ParamByName('COMISS_PROD_GER').AsFloat := 0;
            buscas.ParamByName('TIPO_VENDA').AsString := 'DES';
          end;
          vValorDevolucao := vValorDevolucao + vDadosIni.StrToFloatFormat((buscas.ParamByName('VALOR').AsFloat * buscas.ParamByName('QUANT').AsFloat),2);
          vCodVendaDev := buscas.ParamByName('COD_VENDA').AsInteger;
          vTipoVendaDev := buscas.ParamByName('TIPO_VENDA').AsString;
          buscas.ExecSQL;

          vListDocPrgFid.Add(IntToStr(vSEQUENCIA) + '|' +
             'DEV|' +
             IntToStr(vCodVendaDev) + '|' +
             trim(vTipoVendaDev) + '|');

//          // Atualizar pontos programa de fidelidade
//          if not vDadosIni.setarPontosProgFidelidade(vSEQUENCIA, 'DEV', buscas, true, vCodVendaDev, vTipoVendaDev) then
//          begin
//            RollBackTransacao;
//            Result := False;
//            exit;
//          end;

        end;
      end;
      vItem.dataSet.Next;
    end;

    if (vSEQUENCIA > 0) and ((vDadosIni.vusRecDev = 'S') or (vDadosIni.vEmp.vUsarValorDEVFormPag = 'S')) then
    begin
      if (vDadosIni.vEmp.vUsarValorDEVFormPag = 'S') then
        vOK := True
      else
      begin
        while True do
        begin
        	  vOK := Application.MessageBox ('Deseja fazer recibo antecipado(VALECOMPRA) desta devolução?', 'Atenção' ,MB_ICONINFORMATION + MB_YESNO ) = IDYES;
           if not vOK then
           begin
             if vDadosIni.PesqPros('DEV019', 'NAO GERAR', '', 'DEVOLUCAO', IntToStr(vSEQUENCIA), buscas, False) then
               Break
           end
           else
           	 Break;
        end;
      end;
      if vOK then
      begin
      	buscas.Close;
        buscas.SQL.Text := ' INSERT INTO RECIBOS ' +
        	' (NRECIBO, COD_EMPRESA, VALOR, REFERENCIA1, BENEF_CLIENT, NOME_DEV, ' +
          ' DATA_REC, RECANT, COD_BENEF, DEPREC, NDOCANT, COD_US, ATIVO, VALOR_ORIG, DEVOLUCAO, ' +
          ' NUM_REC_DEP, ATRAVES1, COD_DEPTO, DATA_VENC) ' +
          ' VALUES (:NRECIBO, :COD_EMPRESA, :VALOR, :REFERENCIA1, :BENEF_CLIENT, :NOME_DEV, ' +
          ' :DATA_REC, :RECANT, :COD_BENEF, :DEPREC, :NDOCANT, :COD_US, :ATIVO, :VALOR_ORIG, :DEVOLUCAO, ' +
          ' :NUM_REC_DEP, :ATRAVES1, :COD_DEPTO, :DATA_VENC); ';
        buscas.ParamByName('NRECIBO').AsInteger := vSEQUENCIA;
        if vDadosIni.vRecibo.HabRecPorDepart then
        	buscas.ParamByName('NUM_REC_DEP').AsString := trim(retornaNumRec)
      	else
        	buscas.ParamByName('NUM_REC_DEP').AsInteger := buscas.ParamByName('NRECIBO').AsInteger;
        if vDadosIni.vRecibo.HabRecPorDepart then
			    buscas.ParamByName('COD_DEPTO').AsInteger := retornaCodDepto;
        buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
        buscas.ParamByName('VALOR').AsFloat := RoundTo(vValorDevolucao, -2);
        buscas.ParamByName('VALOR_ORIG').AsFloat := RoundTo(vValorDevolucao, -2);
        buscas.ParamByName('REFERENCIA1').AsString := copy('VALE COMPRA CONF. DEVOLUÇÃO: ' +
         vDadosIni.IfThen(vDadosIni.vRecibo.HabRecPorDepart, buscas.ParamByName('NUM_REC_DEP').AsString, vDadosIni.StrZero(vSEQUENCIA, 6)), 1, 66);
        buscas.ParamByName('ATRAVES1').AsString := '...';
        buscas.ParamByName('BENEF_CLIENT').AsString := copy(Trim(vNOME_CLIENTE), 1, 40);
        buscas.ParamByName('NOME_DEV').AsString := copy(vDadosIni.vEmp.vnomeEmpresa,1, 50);
        buscas.ParamByName('DATA_REC').AsDateTime := vDataAtual;
        buscas.ParamByName('RECANT').AsString := 'S';
        buscas.ParamByName('COD_BENEF').AsInteger := vCOD_CLIENTE;
        buscas.ParamByName('DEPREC').AsString := 'E';
        buscas.ParamByName('NDOCANT').AsInteger := vSEQUENCIA;
        buscas.ParamByName('COD_US').AsInteger := vDadosIni.vCodUsuario;
        buscas.ParamByName('ATIVO').AsInteger := 1;
        buscas.ParamByName('DEVOLUCAO').AsString := 'S';

        if (vDadosIni.vRecibo.Baixar.vUtilizarDataVencimentoRecAntValeCompra = 'S') and  (trim(vDadosIni.vRecibo.Baixar.vDiasVencimentoRecAntValeCompra) <> '') then
        	buscas.ParamByName('DATA_VENC').AsDateTime := vDataAtual + StrToInt(trim(vDadosIni.vRecibo.Baixar.vDiasVencimentoRecAntValeCompra));

        buscas.ExecSQL;
      end;
    end;

    //Atualizar pontos entrada devolução
    for I := 0 to vListDocPrgFid.Count - 1 do
    begin
      // Atualizar pontos programa de fidelidade
      if not vDadosIni.setarPontosProgFidelidade(StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
        trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)), buscas, true,
        StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 3)), trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 4))) then
      begin
        RollBackTransacao;
        Result := False;
        exit;
      end;
    end;

    Result := true;

    if vTemDevolucao then
      vDadosIni.GravaAuditoria('NF0141', 'INCLUIR', 'SUCESSO NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);

  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('function montarControleInternoDevolucao Erro: ' + e.Message);
    end;
  end;
end;

procedure TNFCab.montarDadosAdicionaisFisco;
begin
  if not (dataSet.State in [dsInsert, dsedit]) then
    Exit;
  dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString := '';

  if vDadosIni.getConfSisBool('nf_s_hab_dadosadicionais_cst_csosn', buscas) then
    if (vDadosIni.vEmp.vRegime = 'SIMPLES') and (fdif('tipo_emissao', '4') or fdif('modelo_nf', '55')) then
      validaSomatorioCsosn
    else
      validaSomatorioCst;
  
  vSped.vC110.vInfCompl.abreInfComplementar;
  vSped.vC110.dataSet.First;
  while not vSped.vC110.dataSet.Eof do
  begin
    dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString :=
      dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString +
      vSped.vC110.dataSet.FieldByName('TXT').AsString + ' ' +
      vSped.vC110.dataSet.FieldByName('TXT_COMPL').AsString + '.';
    vSped.vC110.dataSet.Next;
  end;
  if Trim(vDadosIni.vMD5Fiscal) <> '' then
    if (pos(vDadosIni.vMD5Fiscal, dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString) = 0) then
    dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString :=
      dataSet.FieldByName('DADOS_INTERESSE_FISCO').AsString +
      'MD-5:' + vDadosIni.vMD5Fiscal;
end;

function TNFCab.montarNFSaidaMPInsumosProducao(pCodigoProducao: string): Boolean;
var
  tempSubstituicao: Boolean;
  buscas2: TIBQuery;
  vOK: Boolean;
begin
  try
    Result := False;
    buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
    try
      StrToInt(Trim(pCodigoProducao));
    except
      raiseExceptionCreate('Código da Produção inválido', '');
    end;

    buscas2.Close;
    buscas2.SQL.Text := 'select * from producao where cod_producao = ' + Trim(pCodigoProducao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas2.Open;

    if buscas2.IsEmpty then
      raiseExceptionCreate('Produção não encontrada pelo código informado: ' + pCodigoProducao, '');

    if Trim(buscas2.FieldByName('STATUS').AsString) <> 'FECHADO' then
      raiseExceptionCreate('Pedido de Produção ainda não esta Fechado', '');

    buscas.Close;
    buscas.SQL.Text := 'select cod_nf, num_nf, status from notafiscal' +
      ' where cod_producao_mp = ' + IntToStr(StrToInt(Trim(pCodigoProducao))) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status <> ' + QuotedStr(stsCancelada) +
      ' and ativo = 1';
    buscas.Open;

    if buscas.FieldByName('cod_nf').AsInteger > 0 then
      raiseExceptionCreate('Uma nota fiscal já está sendo ou ja foi emitida para a Produção informada:' + sLineBreak +
        'NF Código: ' + IntToStr(buscas.FieldByName('cod_nf').AsInteger) +
        'NF Número: ' + IntToStr(buscas.FieldByName('num_nf').AsInteger) +
        'NF Status: ' + buscas.FieldByName('status').AsString, '');

    buscas2.Close;
    buscas2.SQL.Text := 'select cfop_pad_producao_mp from empresa' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa;
    buscas2.Open;

    if buscas2.FieldByName('cfop_pad_producao_mp').AsInteger = 0 then
    begin
      Application.MessageBox('CFOP padrão para saída de Matérias primas e Insumos não encontrado no cadastro da empresa',
        'Atenção', 0 + 64);
      Exit;
    end;

    if not incluirNf( tnfProdutos, 'P', 'S') then
      exit;

    dataSet.FieldByName('cod_producao_mp').AsInteger := StrToInt(Trim(pCodigoProducao));
    dataSet.FieldByName('codigo_nop').AsInteger := buscas2.FieldByName('cfop_pad_producao_mp').AsInteger;
    dataSet.FieldByName('verificar_mud_cfop').AsString := 'N';

    buscas.Close;
    buscas.SQL.Text := 'select cod_cliente from clientes' +
      ' where cod_empresa =  ' + vDadosIni.codEmpresa +
      ' and cpfcgc = ' + QuotedStr(vDadosIni.vEmp.vCNPJ) +
      ' and ativo = 1';
    buscas.Open;

    if buscas.FieldByName('cod_cliente').AsInteger > 0 then
    begin
      dataSet.FieldByName('cod_cliente').AsInteger :=
        buscas.FieldByName('cod_cliente').AsInteger;
      buscas.Close;
      buscas.Sql.Text := 'select cod_cliente, tipo from clientes where cod_cliente = '+
        dataSet.FieldByName('cod_cliente').AsString +' and cod_empresa = '+vDadosIni.codEmpresa;
      buscas.Open;
      if (buscas.FieldByName('TIPO').AsString <> 'F') and
        (buscas.FieldByName('TIPO').AsString <> 'A') then
      begin
        buscas.close;
        buscas.sql.Text := 'update clientes set tipo = ''A'' where cod_cliente = ' +
          dataSet.FieldByName('cod_cliente').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
    end
    else
    begin
      vDadosIni.vPesquisa := vDadosIni.pesquisaRapida('CLIENTES');
      dataSet.FieldByName('cod_cliente').AsString := Trim(vDadosIni.vPesquisa);
    end;
    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
      raiseExceptionCreate('Cliente/Fornecedor não encontrado', '');

    exitCodigoTabela('CLIENTES');
    dataSet.FieldByName('CODIGO_NOP').AsString := getCfopCorreto(dataSet.FieldByName('CODIGO_NOP').AsString);
    exitCodigoTabela('NAT_OP');

    buscas2.Close;
    buscas2.SQL.Text := 'select cod_prod, grupo_prod, descr_prod,' +
      ' avg(coalesce(prec_cusm_prod,0)) prec_cusm_prod,' +
      ' sum(coalesce(quantidade_utilizada,0)) quantidade_utilizada,' +
      ' sum(coalesce(quantidade_perda,0)) quantidade_perda' +
      ' from producao_item_indice' +
      ' where cod_producao = ' + IntToStr(StrToInt(Trim(pCodigoProducao))) +
      ' and cod_empresa =  ' + vDadosIni.codEmpresa +
      ' and coalesce(solvente, '''') <> ''S''' + 
      ' group by 1,2,3';
    buscas2.Open;

    buscas2.First;
    while not buscas2.Eof do
    begin
      if (Trim(buscas2.FieldByName('cod_prod').AsString) <> '') and
        (Trim(buscas2.FieldByName('grupo_prod').AsString) <> '') then
      begin
        if vItem.dataSet.RecordCount >= vDadosIni.vEmp.vQtdeProdNf then
          Break;

        if not vItem.vProd.buscaProduto(buscas2.FieldByName('grupo_prod').AsInteger,
          buscas2.FieldByName('cod_prod').AsString) then
          raise Exception.Create('Produto não encontrado. Grupo: ' +
            Trim(buscas2.FieldByName('grupo_prod').AsString) +
            ' Código: ' + Trim(buscas2.FieldByName('cod_prod').AsString));
        novoProduto;
        vItem.vrDadosItem.quantidade := buscas2.FieldByName('QUANTIDADE_UTILIZADA').AsFloat +  buscas2.FieldByName('QUANTIDADE_PERDA').AsInteger;
        vItem.vrDadosItem.valor_unitario :=
          vDadosIni.StrToFloatFormat(buscas2.FieldByName('PREC_CUSM_PROD').AsFloat,
          4);
        vItem.vrDadosItem.valor_total := vDadosIni.StrToFloatFormat(vItem.vrDadosItem.quantidade *
          vItem.vrDadosItem.valor_unitario, 2);
        vItem.vrDadosItem.descricao_item := buscas2.FieldByName('DESCR_PROD').AsString;
        vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
        calcularValorItemDesconto;
        calcularValores;
        Result := incluirItem;
      end;
      buscas2.Next;
    end;

    Result := True;
  except
    on e: exception do
    begin
      Result := False;
      if vItem.dataSet.Active then
      begin
        vItem.dataSet.Cancel;
        vItem.dataSet.CancelUpdates;
      end;
      dataSet.Cancel;
      dataSet.CancelUpdates;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFCab.montarPedVenda: Boolean;
var
  vNPED, vCOD_VENDEDOR, I, X: Integer;
  vNomeVendedor, vTipV, vDescrCondPag, vCpfCgc: string;
  vTemPedVenda, vProcessoPermitido, vGerarPedVenda: Boolean;
  vValorItem, vValorUnitario, vValorDesconto, vComiss, vComissGer, vValorTotalItem, vDescontoItem, vValorDespNF, vTotProd: Extended;
  // Vauriaveis usadas no plano
  vMaxDesconto, vPlanoAcresc, vPlanoDesc: Extended;
  vDataAtual, vDataHoraAtual: TDate;
  vTransacaoPED: TIBTransaction;

  procedure _chamarPedVenda(pAcao: string);
  var
    formulario: TForm;
    hdTemp: THandle;
    vTemp: string;
    X: Integer;
  begin
    vTemp := 'CLOSE';
    if Application.MainForm.MDIChildCount > 0 then
      for X := 0 to Pred(Application.MainForm.MDIChildCount) do
        if UpperCase(Application.MainForm.MDIChildren[X].ClassName) = UpperCase('TFrmCadPedVenda') then
        begin
          vTemp := '';
          Break;
        end;

    // NF_GERAR_REQ  NF_REABRIR_REQ
    if pAcao = 'NF_REABRIR_REQ' then
      vDadosIni.chamarReaberturaPEDpelaNF(vNPED, 'REQ', vValorTotalItem - vValorDesconto)
    else
      vDadosIni.chamarConfirmacaoPEDpelaNF(vNPED, 'REQ', vValorTotalItem - vValorDesconto);
      
//    vDadosIni.vTipoForm := 0;
//    vDadosIni.vPesquisa := pAcao + '|' + IntToStr(vNPED) + '|' + Trim('REQ') + '|' + Trim(vTemp) + '|' +
//      Trim(Format( '%0.2n', [vValorTotalItem - vValorDesconto])) + '|';
//
//    formulario := Funcoes.AbreForm('pkPedidoVenda', 'TFrmCadPedVenda', hdTemp);
//    try
//      formulario.ShowModal;
//    finally
//      formulario.Free;
//      unLoadPackage(hdTemp);
//    end;

  end;

  function VoltaEstoque: Boolean;
  begin
    Result := True;

    if not ExecutaComandosSql('select nped, status_ped from pedvenda' +
      ' where nped = ' + IntToStr(vNPED) +
      ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status_ped = ''FECHADA''') then
      Exit;

    Result := False;

    _chamarPedVenda('NF_REABRIR_REQ');

    if ExecutaComandosSql('select nped, status_ped from pedvenda' +
      ' where nped = ' + IntToStr(vNPED) +
      ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status_ped = ''FECHADA''') then
      Result := False
    else
      Result := True;

    Exit;

    _buscas.Close;
  end;

begin
  Result := True;
  if vDadosIni.vEmp.vVnd_MontarPedVendaAutomaticoNaNF <> 'S' then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    Exit;

  if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
    Exit;

  vDadosIni.vInibeMensPesqPros := 'S';
  vProcessoPermitido := vDadosIni.PesqPros('NF0142', 'INCLUIR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
    'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas,True);

  vTemPedVenda := False;
  vGerarPedVenda := False;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
      (vItem.dataSet.FieldByName('ALTERA_ESTOQUE_CFOP').AsString <> 'N') and
      (vItem.dataSet.FieldByName('nped').AsInteger = 0) and
      (vItem.dataSet.FieldByName('nitem_ped').AsInteger = 0) and
      (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = '')  then
    begin

      {$REGION 'Checando grade não informada'}



      {$ENDREGION}

      vGerarPedVenda := True;
      vValorItem :=
          vItem.dataSet.FieldByName('valor_total').AsFloat +
          vItem.dataSet.FieldByName('valor_icmsub').AsFloat +
          vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
          vItem.dataSet.FieldByName('valor_ipi').AsFloat +
          vItem.dataSet.FieldByName('rateio_outdesp').AsFloat;
        if dataSet.FieldByName('frete_f_nfe').AsString <> 'S' then
          vValorItem := vValorItem +
            vItem.dataSet.FieldByName('rateio_frete').AsFloat;

        vValorUnitario := vDadosIni.StrToFloatFormat(
          (vValorItem / vItem.dataSet.FieldByName('QUANTIDADE').AsFloat) , vDadosIni.vEmp.vCasasDecimais);

        vValorItem := vDadosIni.StrToFloatFormat( (vValorUnitario * vItem.dataSet.FieldByName('QUANTIDADE').AsFloat), 2);

        vValorTotalItem := vValorTotalItem + vValorItem;

        vValorDesconto := vValorDesconto + vDadosIni.StrToFloatFormat(
          vItem.dataSet.FieldByName('rateio_desconto').AsFloat, 2);
    end;
    vItem.dataSet.Next;
  end;

  if not vGerarPedVenda then
    Exit;

  if not vProcessoPermitido then
  begin
    vDadosIni.vInibeMensPesqPros := 'N';
    vDadosIni.GravaAuditoria('NF0142', 'INCLUIR', 'FALHA NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) + ' PROCESSO NAO PERMITIDO',
      'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
    Application.MessageBox(pchar('Geração automática da Requisição não poderá ser feita!' + sLineBreak +
      'O processo "NF0142" não está liberado para o nível '+ IntToStr(vDadosIni.vNivel) ) , 'Confirmação', 64);
    Result := False;
    Exit;
  end;

  try

    try
      buscas.Close;
      buscas.Transaction := dtmNF.transacaoPED;

      buscas.Close;
      buscas.SQL.Text := 'select distinct nped from pedvenda' +
        ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger) +
        ' and nf_gerou = ''S''';
      buscas.Open;

      if buscas.FieldByName('nped').AsInteger > 0 then
      begin
        vNPED := buscas.FieldByName('nped').AsInteger;

        if not buscas.Transaction.InTransaction then
          buscas.Transaction.StartTransaction;

        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_prod set N_NF = null' +
          ' where nped = ' + IntToStr(vNPED) +
          ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;
        buscas.Transaction.StartTransaction;

        if VoltaEstoque then
        begin

          if not buscas.Transaction.InTransaction then
            buscas.Transaction.StartTransaction;

//          buscas.Close;
//          buscas.SQL.Text := 'INSERT INTO PEDVENDA (NPED, TIPO, COD_EMPRESA, COD_CLIENTE, COD_VENDEDOR, ATIVO, VALOR_TOTAL, COD_NF, NF_GEROU)' +
//            ' VALUES (:NPED, :TIPO, :COD_EMPRESA, :COD_CLIENTE, :COD_VENDEDOR, 1, :VALOR_TOTAL, :COD_NF, ''S'')';
//          buscas.ParamByName('NPED').AsInteger := vNPED;
//          buscas.ParamByName('TIPO').AsString := 'REQ';
//          buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
//          buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
//          buscas.ParamByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
//          buscas.ParamByName('VALOR_TOTAL').AsFloat := vDadosIni.StrToFloatFormat(vValorTotalItem - vValorDesconto, 2);
//          buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
//          buscas.ExecSQL;

//          buscas.Close;
//          buscas.SQL.Text := 'delete from pedvenda' +
//            ' where nped = ' + IntToStr(vNPED) +
//            ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
//          buscas.ExecSQL;

          buscas.Close;
          buscas.SQL.Text := 'delete from pedvenda_prod' +
            ' where nped = ' + IntToStr(vNPED) +
            ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSQL;
          if buscas.Transaction.InTransaction then
            buscas.Transaction.Commit;
          buscas.Transaction.StartTransaction;

          buscas.Close;
          buscas.SQL.Text := 'update pedvenda set status_ped = ''ABERTA'', DATA_FECH = NULL' +
            ' where nped = ' + IntToStr(vNPED) +
            ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSQL;

//          if buscas.Transaction.InTransaction then
//            buscas.Transaction.Commit;
        end
        else
        begin
          Application.MessageBox(pchar('A Requisição gerada anteriormente pela nota fiscal não foi reaberta!' + sLineBreak +
            'Provavelmente está travada por outro usuário.' + sLineBreak +
            'Consequentemente o estoque das mercadorias não poderão ser baixados.' + sLineBreak +
            'Verifique o problema e tente novamente, número da venda ' + IntToStr(vNPED) + ''),
            'Atenção', 64);
          Result := False;
          vDadosIni.GravaAuditoria('NF0142', 'INCLUIR', 'FALHA REABRIR NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
            'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);
          Exit;
        end;

      end
      else
      begin
        vNPED := GenCodigo('REQVENDA', dtmNF.spIncCodPED, vDadosIni.codEmpresa);
//      end;

      if not buscas.Transaction.InTransaction then
        buscas.Transaction.StartTransaction;

      buscas.Close;
      buscas.SQL.Text := 'INSERT INTO PEDVENDA (NPED, TIPO, COD_EMPRESA, COD_CLIENTE, COD_VENDEDOR, ATIVO, VALOR_TOTAL, COD_NF, NF_GEROU)' +
        ' VALUES (:NPED, :TIPO, :COD_EMPRESA, :COD_CLIENTE, :COD_VENDEDOR, 1, :VALOR_TOTAL, :COD_NF, ''S'')';
      buscas.ParamByName('NPED').AsInteger := vNPED;
      buscas.ParamByName('TIPO').AsString := 'REQ';
      buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      buscas.ParamByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
      buscas.ParamByName('VALOR_TOTAL').AsFloat := vDadosIni.StrToFloatFormat(vValorTotalItem - vValorDesconto, 2);
      buscas.ParamByName('COD_NF').AsInteger := dataSet.FieldByName('COD_NF').AsInteger;
      buscas.ExecSQL;

      SqlExec('update or insert into PEDVENDA_REF_NF (NPED, TIPO, COD_EMPRESA, COD_NF) values (%d, %s, %d, %d) matching (NPED, TIPO, COD_EMPRESA, COD_NF)',
              [vNPED, QuotedStr('REQ'), fint('cod_empresa'), fint('cod_nf')])
      end;

      _buscas.Close;
      _buscas.SQL.Text := 'select desc_cond_pag, max_desc from cond_pag' +
        ' where cod_cond_pag = ' + IntToStr(dataSet.FieldByName('cod_cond_pag').AsInteger);
      _buscas.Open;
      vMaxDesconto := _buscas.FieldByName('max_desc').AsFloat;
      vDescrCondPag := Trim(_buscas.FieldByName('desc_cond_pag').AsString);

      _buscas.Close;
      _buscas.SQL.Text := 'select cpfcgc, camp_pr_venda, perc_desc from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      _buscas.Open;
      vCpfCgc := Trim(_buscas.FieldByName('cpfcgc').AsString);
      if (_buscas.FieldByName('camp_pr_venda').AsString <> '') and
        (_buscas.FieldByName('perc_desc').AsFloat > 0) then
        vMaxDesconto := _buscas.FieldByName('perc_desc').AsFloat;

      vDataHoraAtual := vDadosIni.getDataHoraBanco(_buscas);
      vDataAtual := vDadosIni.getDataBanco(_buscas);
      vNomeVendedor := retornaValor('select nome_vendedor as valor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa);
      vTipV := retornaValor('select tipv as valor from nat_op' +
        ' where codigo_nop = ' + IntToStr(Trunc(dataSet.FieldByName('codigo_nop').AsFloat) ) );
      if Trim(vTipV) = '' then
        vTipV := 'V';


      Result := False;

      I:= 0;
      vValorDesconto := 0;
      vValorTotalItem := 0;
      vTotProd := 0;
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
          (vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N') and
          (vItem.dataSet.FieldByName('nped').AsInteger = 0) and
          (vItem.dataSet.FieldByName('nitem_ped').AsInteger = 0) and
          (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = '')  then
        begin

          Inc(I);

          vValorItem :=
            vItem.dataSet.FieldByName('valor_total').AsFloat;
          vValorDespNF :=
            vItem.dataSet.FieldByName('valor_icmsub').AsFloat +
            vItem.dataSet.FieldByName('rateio_seguro').AsFloat +
            vItem.dataSet.FieldByName('valor_ipi').AsFloat +
            vItem.dataSet.FieldByName('rateio_outdesp').AsFloat;
          if dataSet.FieldByName('frete_f_nfe').AsString <> 'S' then
            vValorDespNF := vValorDespNF +
              vItem.dataSet.FieldByName('rateio_frete').AsFloat;
          vValorDespNF := vDadosIni.StrToFloatFormat(vValorDespNF, 2);

          vValorUnitario := vDadosIni.StrToFloatFormat(
            (vValorItem / vItem.dataSet.FieldByName('QUANTIDADE').AsFloat) , vDadosIni.vEmp.vCasasDecimais);

          vValorItem := vDadosIni.StrToFloatFormat( (vValorUnitario * vItem.dataSet.FieldByName('QUANTIDADE').AsFloat), 2);

          if vPlanoDesc > 0 then
          begin
            vDescontoItem := vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('rateio_desconto').AsFloat +
              (vPlanoDesc / vValorTotalItem * vValorItem), 2);
          end
          else if vPlanoAcresc > 0 then
          begin
            vValorItem := vDadosIni.StrToFloatFormat( ((vValorUnitario * vItem.dataSet.FieldByName('QUANTIDADE').AsFloat) +
              (vPlanoAcresc / vValorTotalItem * vValorItem) ), 2);
            vValorUnitario := vDadosIni.StrToFloatFormat( vValorItem / vItem.dataSet.FieldByName('QUANTIDADE').AsFloat,
              vDadosIni.vEmp.vCasasDecimais);
            vDescontoItem := 0;
          end
          else
          begin
            vDescontoItem := vDadosIni.StrToFloatFormat(
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat, 2);
          end;

          vValorTotalItem := vValorTotalItem + vValorItem + vValorDespNF;
          vValorDesconto := vValorDesconto + vDescontoItem;
          vTotProd := vTotProd + vValorItem;

          _buscas.Close;
          _buscas.SQL.Text := ' select comissao_prod, comissao_prod_ger, prec_cus_prod, prec_cusm_prod, ' +
          	' unidade, peso_liq_prod, peso_brut_prod from produtos ' +
            ' where grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
            ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
          _buscas.Open;

          vComiss := _buscas.FieldByName('comissao_prod').AsFloat;
          vComissGer := _buscas.FieldByName('comissao_prod_ger').AsFloat;

          buscas.Close;
          buscas.SQL.Text := ' INSERT INTO PEDVENDA_PROD (NPED, TIPO, GRUPO_PROD, COD_PROD, NITEM, COD_EMPRESA, COD_GRADE, CODIGO_NOP, NUM_FAB_PROD,' +
            ' DESCR_PROD_PED, QUANT_PED_ITEM, VLUN_PED_ITEM, VLTOT_PED_ITEM, VLUN_ORIG, VLUN_PED_NF,' +
            ' RATEIO_DESC, RATEIO_ACRESC, N_NF, SERIE, RATDSAS, COMISS_PROD, COMISS_PROD_GER, PCUST_C,' +
            ' PCUST_MC, TP_NF_PED, SIT_ATD, DESC_ITEM, ACRESC_ITEM, COD_VENDEDOR, DATA_TRANSF, NOME_VEND,' +
            ' VLO_UNITARIO, DATA_INCLUSAO, TP_DESCACRES, NAT_DESCACRES, VALOR_DESCACRES, COD_NF,' +
            ' NITEM_NF, XPED_COMPRA, NITEMPED_COMPRA, VL_DESP_NF, PESO_LIQ_PROD, PESO_BRUT_PROD, ' +
            ' UNIDADE, UNIDADE_CONV, OPERACAO_CONV, FATOR_CONV)' +
            ' VALUES (:NPED, :TIPO, :GRUPO_PROD, :COD_PROD, :NITEM, :COD_EMPRESA, :COD_GRADE, :CODIGO_NOP, :NUM_FAB_PROD,' +
            ' :DESCR_PROD_PED, :QUANT_PED_ITEM, :VLUN_PED_ITEM, :VLTOT_PED_ITEM, :VLUN_ORIG, :VLUN_PED_NF,' +
            ' :RATEIO_DESC, :RATEIO_ACRESC, :N_NF, :SERIE, 0, :COMISS_PROD, :COMISS_PROD_GER, :PCUST_C,' +
            ' :PCUST_MC, ''2'', ''N'', 0, 0, :COD_VENDEDOR, :DATA_TRANSF, :NOME_VEND,' +
            ' :VLO_UNITARIO, :DATA_INCLUSAO, ''DESCONTO'', ''PERCENTUAL'', 0, :COD_NF,' +
            ' :NITEM_NF, :XPED_COMPRA, :NITEMPED_COMPRA, :VL_DESP_NF, :PESO_LIQ_PROD, :PESO_BRUT_PROD, ' +
            ' :UNIDADE, :UNIDADE_CONV, :OPERACAO_CONV, :FATOR_CONV) ';

          buscas.ParamByName('NPED').AsInteger := vNPED;
          buscas.ParamByName('TIPO').AsString := 'REQ'; 
          buscas.ParamByName('GRUPO_PROD').AsInteger := vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := vItem.dataSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('NITEM').AsInteger := I;
          buscas.ParamByName('COD_EMPRESA').AsInteger := vItem.dataSet.FieldByName('COD_EMPRESA').AsInteger;
          buscas.ParamByName('COD_GRADE').AsInteger := vItem.dataSet.FieldByName('COD_GRADE').AsInteger;
          buscas.ParamByName('CODIGO_NOP').AsInteger := vItem.dataSet.FieldByName('CODIGO_NOP').AsInteger;
          buscas.ParamByName('NUM_FAB_PROD').AsString := vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString;
          buscas.ParamByName('DESCR_PROD_PED').AsString := copy(Trim(vItem.dataSet.FieldByName('DESCRICAO_ITEM').AsString),1,60);
          buscas.ParamByName('QUANT_PED_ITEM').AsFloat := vItem.dataSet.FieldByName('QUANTIDADE').AsFloat;
          buscas.ParamByName('VLUN_PED_ITEM').AsFloat := vValorUnitario;
          buscas.ParamByName('VLTOT_PED_ITEM').AsFloat := vValorItem;
          buscas.ParamByName('VLUN_ORIG').AsFloat := vValorUnitario;
          buscas.ParamByName('VLUN_PED_NF').AsFloat := vValorUnitario;
          buscas.ParamByName('RATEIO_DESC').AsFloat := vDadosIni.StrToFloatFormat(vDescontoItem, 2);
          buscas.ParamByName('RATEIO_ACRESC').AsFloat := vValorDespNF;
          buscas.ParamByName('N_NF').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
          buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('serie').AsString;
          buscas.ParamByName('COMISS_PROD').AsFloat := (vValorItem * vComiss) / 100;
          buscas.ParamByName('COMISS_PROD_GER').AsFloat := (vValorItem * vComissGer) / 100;
          buscas.ParamByName('PCUST_C').AsFloat := _buscas.FieldByName('PREC_CUS_PROD').AsFloat;
          buscas.ParamByName('PCUST_MC').AsFloat := _buscas.FieldByName('PREC_CUSM_PROD').AsFloat;
          buscas.ParamByName('COD_VENDEDOR').AsFloat := dataSet.FieldByName('COD_VENDEDOR').AsFloat;
          buscas.ParamByName('DATA_TRANSF').AsDate := vDataAtual;
          buscas.ParamByName('NOME_VEND').AsString := Trim(vNomeVendedor);
          buscas.ParamByName('VLO_UNITARIO').AsFloat := vValorUnitario;
          buscas.ParamByName('DATA_INCLUSAO').AsDate := vDataAtual;
          buscas.ParamByName('COD_NF').AsInteger := vItem.dataSet.FieldByName('COD_NF').AsInteger;
          buscas.ParamByName('NITEM_NF').AsInteger := vItem.dataSet.FieldByName('NITEM').AsInteger;
          buscas.ParamByName('CODIGO_NOP').AsInteger := vItem.dataSet.FieldByName('CODIGO_NOP').AsInteger;
          buscas.ParamByName('XPED_COMPRA').AsString := vItem.dataSet.FieldByName('XPED_COMPRA').AsString;
          buscas.ParamByName('NITEMPED_COMPRA').AsInteger := vItem.dataSet.FieldByName('NITEMPED_COMPRA').AsInteger;
          buscas.ParamByName('VL_DESP_NF').AsFloat := vValorDespNF;

          buscas.ParamByName('PESO_LIQ_PROD').AsFloat := _buscas.FieldByName('PESO_LIQ_PROD').AsFloat;
          buscas.ParamByName('PESO_BRUT_PROD').AsFloat := _buscas.FieldByName('PESO_BRUT_PROD').AsFloat;
          buscas.ParamByName('UNIDADE').AsString := Trim(_buscas.FieldByName('UNIDADE').AsString);


          if vItem.fstr('unidade_nf') = '' then
            buscas.ParamByName('UNIDADE_CONV').AsString := Trim(_buscas.FieldByName('unidade').AsString)
          else
          begin
            buscas.ParamByName('UNIDADE_CONV').AsString := vItem.fstr('unidade_nf');
            if (fstr('import_xml') >= strDataVersion)
              and (Trim(_buscas.FieldByName('unidade').AsString) <> vItem.fstr('unidade_nf')) then
            begin
              buscas.ParamByName('OPERACAO_CONV').AsString := IfThen(vItem.ffloat('qtdemb') > 1, 'M', 'D');
              if vItem.ffloat('qtdemb') > 1 then
                buscas.ParamByName('FATOR_CONV').AsFloat := vItem.ffloat('qtdemb')
              else if vItem.ffloat('qtdemb') > 0 then
                buscas.ParamByName('FATOR_CONV').AsFloat := 1 / vItem.ffloat('qtdemb')
              else
                buscas.ParamByName('FATOR_CONV').AsFloat := 1;
            end;
          end;

          buscas.ExecSQL;

        end;
        vItem.dataSet.Next;
      end;

      buscas.Close;
      buscas.SQL.Text := 'UPDATE PEDVENDA SET' +
        ' COD_COND_PAG = :COD_COND_PAG, DATA_PED = :DATA_PED, DATA_FECH = :DATA_FECH, VALOR_TOTAL = :VALOR_TOTAL,' +
        ' DESC_P_PROD = 0, DESC_P_SERV = 0, DESCONTO = :DESCONTO, OBS_PED = :OBS_PED,' +
        ' STATUS_PED = :STATUS_PED, TIPV = :TIPV, OBS_CXL_RQ = :OBS_CXL_RQ, VL_PAGO_CXL = 0,' +
        ' TIPOR = ''V'', HORAABERTURA = :HORAABERTURA, MINABERTURA = :MINABERTURA, HORAFECHAMENTO = :HORAFECHAMENTO,' +
        ' MINFECHAMENTO = :MINFECHAMENTO, DATA_CUPOM = :DATA_CUPOM, VL_ENTRADA = 0, NPREVENDA = null,' +
        ' ACRESC_P_PROD = 0, ACRESC_P_SERV = 0, ACRESCIMO = 0, TOT_PROD = :TOT_PROD,' +
        ' TOT_SERV = 0, DATA_NF = :DATA_NF, NUM_NF = :NUM_NF, VALOR_NF = :VALOR_NF, CPFCGC = :CPFCGC,' +
        ' SERIE_NF = :SERIE_NF, LIBTRAVA = ''N'', SUBTIPO_OS = ''NORMAL'',' +
        ' APROVADA_GERENTE = ''N'', DATA_LIBTRAVA = :DATA_LIBTRAVA,' +
        ' COD_CLIENTE = :COD_CLIENTE, COD_VENDEDOR = :COD_VENDEDOR' +
        ' WHERE NPED = :NPED AND TIPO = :TIPO AND COD_EMPRESA = :COD_EMPRESA';
      buscas.ParamByName('NPED').AsInteger := vNPED;
      buscas.ParamByName('TIPO').AsString := 'REQ';
      buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      buscas.ParamByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;

      buscas.ParamByName('COD_COND_PAG').AsInteger := dataSet.FieldByName('COD_COND_PAG').AsInteger;
      buscas.ParamByName('DATA_PED').AsDate := vDataAtual;
  //    buscas.ParamByName('DATA_FECH').AsInteger := dataSet.FieldByName('COD_COND_PAG').AsInteger;
      buscas.ParamByName('VALOR_TOTAL').AsFloat := vDadosIni.StrToFloatFormat(vValorTotalItem - vValorDesconto, 2);
      buscas.ParamByName('DESCONTO').AsFloat := vDadosIni.StrToFloatFormat(vValorDesconto, 2);
      buscas.ParamByName('OBS_PED').AsString := copy(vDadosIni.vEmp.vMensagem, 1, 50);
      buscas.ParamByName('STATUS_PED').AsString := 'ABERTA';
      buscas.ParamByName('TIPV').AsString := vTipV;
      buscas.ParamByName('OBS_CXL_RQ').AsString := Copy(vDescrCondPag, 1, 50);
      buscas.ParamByName('HORAABERTURA').AsString := Copy(FormatDateTime('HH:MM:SS', vDataHoraAtual), 1, 2);
      buscas.ParamByName('MINABERTURA').AsString := Copy(FormatDateTime('HH:MM:SS', vDataHoraAtual), 4, 2);
      buscas.ParamByName('HORAFECHAMENTO').AsString := Copy(FormatDateTime('HH:MM:SS', vDataHoraAtual), 1, 2);
      buscas.ParamByName('MINFECHAMENTO').AsString := Copy(FormatDateTime('HH:MM:SS', vDataHoraAtual), 4, 2);
      buscas.ParamByName('DATA_CUPOM').AsDate := vDataAtual;
      buscas.ParamByName('TOT_PROD').AsFloat := vDadosIni.StrToFloatFormat(vTotProd, 2);
      buscas.ParamByName('DATA_NF').AsDate := dataSet.FieldByName('data_lanc').AsDateTime;
      buscas.ParamByName('NUM_NF').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
      buscas.ParamByName('VALOR_NF').AsFloat := dataSet.FieldByName('valor_total').AsFloat;
      buscas.ParamByName('CPFCGC').AsString := vCpfCgc;
      buscas.ParamByName('SERIE_NF').AsString := dataSet.FieldByName('serie').AsString;
      buscas.ParamByName('DATA_LIBTRAVA').AsDate := vDataAtual;
      buscas.ExecSQL;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      _chamarPedVenda('NF_GERAR_REQ');

      _buscas.Close;
      _buscas.SQL.Text := 'select status_ped from pedvenda' +
        ' where nped = ' + IntToStr(vNPED) +
        ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
      _buscas.Open;

      Result := UpperCase(Trim(_buscas.FieldByName('status_ped').AsString)) = 'FECHADA';

      if not Result then
      begin
        if not buscas.Transaction.InTransaction then
          buscas.Transaction.StartTransaction;

        buscas.Close;
        buscas.SQL.Text := 'delete from pedvenda_prod' +
          ' where nped = ' + IntToStr(vNPED) +
          ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
        
        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;
      end;

//      vFpReq.fNPed := vNPED;
//      vFpReq.fTipoVenda := 'REQ';
//      vFpReq.fValorVenda := vValorTotalItem - vValorDesconto;
//      vFpReq.fGerarFP := True;

    finally
      if buscas.Transaction.InTransaction then
        buscas.Transaction.Rollback;
      buscas.Close;
      buscas.Transaction := transacao;
    end;

    if vTemPedVenda then
      vDadosIni.GravaAuditoria('NF0141', 'INCLUIR', 'SUCESSO NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString),
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);

  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('function montarPedVenda. Erro: ' + e.Message);
    end;
  end;
end;

function TNFCab.MontaXmlPeloPortalSefaz(vChave: string): boolean;
const urlDefault = 'https://www.nfe.fazenda.gov.br/portal/consultaRecaptcha.aspx?tipoConsulta=resumo&tipoConteudo=7PhJ+gAVw2g=&nfe=';
var
  vTemp, urlChv: string;
  vXmlNf: TXmlImport;
  conf: TConfig_sistema_class;
begin
  Result := False;
  if not DirectoryExists(ExtractFilePath(Application.ExeName) + 'consultasitenfe') then
    CreateDir(ExtractFilePath(Application.ExeName) + 'consultasitenfe');

  conf := TConfig_sistema_class.getConf('nfe_url_consulta_sefaz', buscas, vDadosIni.cod_empresa);
  if conf.chave = '' then
  begin
    conf.chave := 'nfe_url_consulta_sefaz';
    conf.cod_empresa := vDadosIni.cod_empresa;
    conf.display_ := 'Endereço do website da SEFAZ Ambiente nacional para consulta pela chave de acesso';
    conf.tag := 'nfe;consulta;chave';
    conf.type1_ := typeString;
    conf.value1_vc := urlDefault + '@CHAVE@';
    conf.ativo := 1;
    conf.value1_b.Add('Ao configurar a URL o sistema irá substituir o valor @CHAVE@ contido na URL pela chave da NFe digitada');
    conf.SaveConfDB(buscas).Transaction.Commit;
    urlChv := urlDefault + vChave;
  end
  else if Trim(conf.value1_vc) <> '' then
    urlChv := ReplaceText(conf.value1_vc, '@CHAVE@', vChave)
  else
    urlChv := urlDefault + vChave;

  vTemp := '';//ConsultaRFB(pchar(vChave), pchar(vDadosIni.vNomeUsuario));
  ShellExecute(Application.Handle, 'open',
//    PAnsiChar('http://www.nfe.fazenda.gov.br/portal/consultaRecaptcha.aspx?tipoConsulta=completa&tipoConteudo=XbSeqxE8pl8=&nfe=' + vChave),
    PAnsiChar(urlChv),
    nil, nil, SW_SHOWNORMAL);
  //  vTemp := StringReplace(vTemp,)
  if Trim(vTemp) <> '' then
  begin
    vXmlNf := TXmlImport.create;
    Result := vXmlNf.montarNf(Self, vTemp);
  end;
end;

procedure TNFCab.movimentarEstoqueProdSelecionado(pOperacao: C_Operacao);
var
  vSQLtmp: string;
  existeGrades, existeEstF: Boolean;
  prodVoltaEstoque: TVoltaEstoqueModel;
  gradsVolta: TVoltaEstoqueGradeModel;
  I: Integer;
begin

  if pOperacao = toEntrada then
    vSQLtmp := ' and cod_forn_nfe > 0'//pois antes de entrar neste nometodo, no dataset temporario é somado as quantidades, sendo assim nao pode ser pelo nitem, pois itens repetidos ficariam sem a grade especifica
  else
    vSQLtmp := ' and cod_forn_nfe = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger);


  existeGrades := SqlScalar('select count(*) from cod_grade_prod' +
                            ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d and cod_grade > 0',
                            [vItem.fint('grupo_prod'), vItem.fstrq('cod_prod'), vDadosIni.cod_empresa]).AsInteger > 0;

  existeEstF := RoundTo(SqlScalar('select est_f from produtos' +
                                  ' where grupo_prod = %d and cod_prod = %s and cod_empresa = %d',
                                  [vItem.fint('grupo_prod'), vItem.fstrq('cod_prod'), vDadosIni.cod_empresa]).AsFloat, -3) <> 0;

  buscas.close;
  buscas.Sql.Text := ' select * from cod_grade_prod_compra' +
    ' where num_nota_nfe = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    vSQLtmp +
    ' and grupo_prod = ' + IntToStr(vItem.dataSet.FieldByName('grupo_prod').AsInteger) +
    ' and cod_prod = ' + QuotedStr(vItem.dataSet.FieldByName('cod_prod').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1 and cod_grade > 0';
  buscas.Open;

  if (pOperacao = toEntrada) and
     (not buscas.IsEmpty) and     // tem grades informadas na entrada
     (existeEstF) and             // tem estoque no produto
     (not existeGrades)           // não tem estoque nas grades
  then
    raise Exception.Create('Produto já tem estoque e não possui grades' + _DLB +
                           'Antes de informar grades na nota fiscal por favor entre no cadastro de produto e faça a distribuição das grades');

  if (pOperacao = toSaida) and existeGrades and buscas.IsEmpty then // cancelando ou excluindo nota, cuja entrada form sem grade, e agora tem grade
  begin
    prodVoltaEstoque := TVoltaEstoqueModel.Create;
    prodVoltaEstoque.grupo := vItem.fint('grupo_prod');
    prodVoltaEstoque.codigo := vItem.fstr('cod_prod');
    prodVoltaEstoque.numfab := vItem.fstr('num_fab_prod');
    prodVoltaEstoque.descricao := vItem.fstr('descricao_item');
    prodVoltaEstoque.quantidade := vItem.ffloat('QUANTIDADE');

    Application.CreateForm(TfrmGradeVoltaEstoque, frmGradeVoltaEstoque);
    frmGradeVoltaEstoque.produto := prodVoltaEstoque;

    if frmGradeVoltaEstoque.ShowModal <> IDOK then
      raise Exception.Create('Operação cancelada pelo usuário');

    for gradsVolta in prodVoltaEstoque.grades do
    begin
      vMovimentaEstoque.Close;
      vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := vItem.dataset.Fieldbyname('GRUPO_PROD').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := vItem.dataset.Fieldbyname('COD_PROD').AsString;
      vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := vItem.dataset.Fieldbyname('COD_EMPRESA').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := gradsVolta.grade;
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := gradsVolta.quantidade;
      vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
      vMovimentaEstoque.Prepare;
      vMovimentaEstoque.ExecProc;
    end;

  end
  else
  if buscas.IsEmpty then
  begin
    vMovimentaEstoque.Close;
    vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := vItem.dataset.Fieldbyname('GRUPO_PROD').AsInteger;
    vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := vItem.dataset.Fieldbyname('COD_PROD').AsString;
    vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := vItem.dataset.Fieldbyname('COD_EMPRESA').AsInteger;
    vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := vItem.dataset.Fieldbyname('COD_GRADE').AsInteger;
    if pOperacao = toEntrada then
    begin
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := vItem.dataset.Fieldbyname('QUANTIDADE').AsFloat;
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := 0;
    end
    else
    begin
      vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
      vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := vItem.dataset.Fieldbyname('QUANTIDADE').AsFloat;
    end;
    vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
    vMovimentaEstoque.Prepare;
    vMovimentaEstoque.ExecProc;
  end
  else
  begin
    buscas.First;
    while not buscas.Eof do
    begin
      vMovimentaEstoque.Close;
      vMovimentaEstoque.ParamByName('PGRUPO_PROD').AsInteger := buscas.Fieldbyname('GRUPO_PROD').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_PROD').AsString := buscas.Fieldbyname('COD_PROD').AsString;
      vMovimentaEstoque.ParamByName('PCOD_EMPRESA').AsInteger := buscas.Fieldbyname('COD_EMPRESA').AsInteger;
      vMovimentaEstoque.ParamByName('PCOD_GRADE').AsInteger := buscas.Fieldbyname('COD_GRADE').AsInteger;
      if pOperacao = toEntrada then
      begin
        vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := buscas.Fieldbyname('QTDE').AsFloat;
        vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := 0;
      end
      else
      begin
        vMovimentaEstoque.ParamByName('PQTDE_ENTRADA').AsFloat := 0;
        vMovimentaEstoque.ParamByName('PQTDE_SAIDA').AsFloat := buscas.Fieldbyname('QTDE').AsFloat;
      end;
      vMovimentaEstoque.ParamByName('PALTDTULTVND').AsInteger := 0;
      vMovimentaEstoque.Prepare;
      vMovimentaEstoque.ExecProc;
      buscas.Next;
    end;
  end;
end;

function TNFCab.abreFormFaturasEntrada: boolean;
var
  formulario: TfrmPadrao;
  vComConsumo, vOKFaturas: Boolean;
  I: Integer;
begin
	Result := True;

  vOKFaturas := False;
  if vFaturasXML.Count > 0 then
    vOKFaturas := Application.MessageBox('Foi encontrado no XML registros de cobrança. Deseja utilizar os valores e vencimentos?',
      'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES;
  if not gerarFaturas(True) then
    if not vOKFaturas then
      exit;
  try
    vComConsumo := False;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vComConsumo := vItem.dataSet.FieldByName('consumo').AsString = 'S';
      if vComConsumo then
        Break;
      vItem.dataSet.Next;
    end;
    vItem.First;
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Faturas para o Contas a Pagar';
    frmCadNF.pnFaturaEntrada.Parent := formulario;
    frmCadNF.btDetalheDespesa.Visible:=vComConsumo;
    frmCadNF.btDetalheDespesa.Tag := 0;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    //    frmCadNF.BitBtn33.Enabled := fechamento;
    if vOKFaturas then
    begin
      FFatura.parcelas := vFaturasXML.Count;
      SetLength(FFatura.vencimentoDocumento, vFaturasXML.Count);
      SetLength(FFatura.numeroDocumento, vFaturasXML.Count);
      SetLength(FFatura.valorDocumento, vFaturasXML.Count);
      SetLength(FFatura.numVenda, vFaturasXML.Count);
      SetLength(FFatura.tipoVenda, vFaturasXML.Count);
      SetLength(FFatura.referenteFrete, vFaturasXML.Count);
      SetLength(FFatura.codControles, vFaturasXML.Count);
      for I := 0 to vFaturasXML.Count - 1 do
      begin
//        FFatura.numeroDocumento[i] := vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger, 6) + '-' + IntToStr(i + 1);
        FFatura.numeroDocumento[I] := vDadosIni.getCampoPipe(vFaturasXML[i], 1);
        FFatura.vencimentoDocumento[I] := vDadosIni.getCampoPipe(vFaturasXML[i], 2);
        FFatura.valorDocumento[I] := StrToFloat(vDadosIni.getCampoPipe(vFaturasXML[i], 3));
        FFatura.codControles[I] := 0;
      end;
    end;

    frmCadNF.getFaturas;
    try
      frmCadNF.ckLancarFrete.Checked := (dataSet.FieldByName('frete_f_nfe').AsString = 'S') and
        (dataSet.FieldByName('valor_frete').AsCurrency > 0);
      frmCadNF.edFreteCondPag.AsValue := dataSet.FieldByName('valor_frete').AsCurrency;
      frmCadNF.edDataFrete.Text := FFatura.vencimentoDocumento[0];
      frmCadNF.btAlterarFaturaEntrada.Enabled := True;
      frmCadNF.ListBox3.Enabled := True;
      frmCadNF.Panel47.Visible := False;
    except
    end;
    if formulario.ShowModal = mrOk then
    begin
      if frmCadNF.ckLancarFrete.Checked then
      begin
        FFatura.parcelas := FFatura.parcelas + 1;
        SetLength(FFatura.vencimentoDocumento, FFatura.parcelas);
        SetLength(FFatura.numeroDocumento, FFatura.parcelas);
        SetLength(FFatura.valorDocumento, FFatura.parcelas);
        SetLength(FFatura.numVenda, FFatura.parcelas);
        SetLength(FFatura.tipoVenda, FFatura.parcelas);
        SetLength(FFatura.referenteFrete, FFatura.parcelas);
        SetLength(FFatura.codControles, FFatura.parcelas);

        FFatura.vencimentoDocumento[FFatura.parcelas - 1] := frmCadNF.edDataFrete.Text;
        FFatura.numeroDocumento[FFatura.parcelas - 1] :=
          vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger, 6) + '/F';
        FFatura.valorDocumento[FFatura.parcelas - 1] := frmCadNF.edFreteCondPag.AsValue;
        FFatura.referenteFrete[FFatura.parcelas - 1] := True;
        FFatura.codControles[FFatura.parcelas - 1] := 0;
        if vComConsumo  then
        begin
          if Application.MessageBox(pchar('Deseja detalhar o conhecimento de frete no contas a pagar?'),'Atenção',
          MB_ICONQUESTION+MB_YESNO) = IDYES then
            abreFormDetalhesDespesa((FFatura.parcelas - 1),frmCadNF.cdsDesp);
        end;
      end;

      if not salvarFaturasEntrada then
      begin
      	Result := False;
        exit;
      end;
    end;
  finally
    frmCadNF.pnFaturaEntrada.Parent := frmCadNF.tsFaturasEntrada;
    formulario.Free;
    formulario := nil;
  end;
end;

function TNFCab.abreFormFaturasSaida(fechamento: boolean): boolean;
var
  formulario: TfrmPadrao;
  vCtrl: TControlesNF;
begin
  try
    vCtrl := TControlesNF.create;
    vCtrl.selecionaControlesDeBoletos(fCodControleVenda);
    if vCtrl.dataSet.IsEmpty then
      Exit;
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Modificar Faturas da Nota Fiscal';
    frmCadNF.pnModFaturas.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
    frmCadNF.BitBtn33.Enabled := fechamento;
    frmCadNF.getFaturas;
    try
      if FFatura.moraDiaria = 0 then
        FFatura.moraDiaria := StrToFloat(Format('%0.2f', [vDadosIni.vEmp.vTxJuros / 30]));
      if FFatura.multa = 0 then
        FFatura.multa := vDadosIni.vEmp.vMultas;
      if FFatura.localPagamento = '' then
        FFatura.localPagamento := vDadosIni.vEmp.vLocalPagBol;
      if FFatura.obs1 = '' then
        FFatura.obs1 := vDadosIni.vEmp.vObsBol;
      if not vCtrl.dataSet.IsEmpty then
        frmCadNF.DBLookupComboBox10.KeyValue := vCtrl.dataSet.FieldByName('codigo_ctrl').AsInteger;
      frmCadNF.DBLookupComboBox10.OnExit := frmCadNF.DBLookupComboBox10Exit;
      if FFatura.codControle > 0 then
      try
        frmCadNF.DBLookupComboBox10.KeyValue := FFatura.codControle;
      except
      end;

      frmCadNF.edMora.AsValue := Fatura.moraDiaria;
      frmCadNF.edMulta.AsValue := Fatura.multa;
      frmCadNF.edLocalPag.Text := Fatura.localPagamento;
      frmCadNF.edObsBol1.Text := Fatura.obs1;
      frmCadNF.edObsBol2.Text := Fatura.obs2;

      frmCadNF.BitBtn7.Enabled := True;
      frmCadNF.ListBox2.Enabled := True;
      frmCadNF.Panel5.Visible := False;
      frmCadNF.BitBtn12.Visible := False;
    
    except
    end;
    {if pVerDadosBoleto then
    begin
      frmCadNF.GroupBox7.Visible := False;
      frmCadNF.GroupBox65.Visible := False;
      frmCadNF.GroupBox9.Visible := False;
      frmCadNF.GroupBox90.Visible := True;
    end
    else}
    begin
      frmCadNF.GroupBox7.Visible := True;
      frmCadNF.GroupBox65.Visible := True;
      frmCadNF.GroupBox9.Visible := True;
     // frmCadNF.GroupBox90.Visible := False;
    end;
    Result := formulario.ShowModal = mrOk;
    _GravaConfiguracoesInteger('FFatura.codControle', FFatura.codControle);
    if fechamento then
    begin
      FFatura.moraDiaria := frmCadNF.edMora.AsValue;
      FFatura.multa := frmCadNF.edMulta.AsValue;
      FFatura.localPagamento := frmCadNF.edLocalPag.Text;
      FFatura.obs1 := frmCadNF.edObsBol1.Text;
      FFatura.obs2 := frmCadNF.edObsBol2.Text;
      if frmCadNF.DBLookupComboBox10.KeyValue > 0 then
        FFatura.codControle := frmCadNF.DBLookupComboBox10.KeyValue;

      if (Result) or (vDadosIni.vEmp.vConfGerarBoletoNF <> 'S') then
        salvarFaturas
      else
        Result := False;
    end;
  finally
    frmCadNF.pnModFaturas.Parent := frmCadNF.tsModificarFaturas;
    formulario.Free;
    formulario := nil;
    vCtrl.Close;
    vCtrl.Free;
  end;
end;

procedure TNFCab.nfe_verificar_dados_contingencia;
begin
  if (dataSet.State in [dsInsert, dsEdit]) and
    (GetVersaoNFe = vnf400) and (get_emissao_propria = 'S') and (get_modelo_nf = '55') then
  begin
    if not vDadosIni.strIn(dataSet.FieldByName('nfe_tpemis').AsString, ['4', '6', '9']) then
    begin
      dataSet.FieldByName('nfe_dhcont').Value := Null;
      dataSet.FieldByName('nfe_xjust').Value  := Null;
    end
    else
    begin
      if (dataSet.FieldByName('nfe_dhcont').AsDateTime <= 0) or
        (Trim(dataSet.FieldByName('nfe_xjust').AsString) = '') then
      begin
        dataSet.FieldByName('nfe_dhcont').AsDateTime := vDadosIni.vEmp.vNfe.nfe_dhcont;
        dataSet.FieldByName('nfe_xjust').AsString    := vDadosIni.vEmp.vNfe.nfe_xjust;
      end;
      if dataSet.FieldByName('nfe_dhcont').AsDateTime < IncDay(Now(), -30)  then
        dataSet.FieldByName('nfe_dhcont').AsDateTime := IncMinute(Now(), -1);
    end;
  end;
end;

