      begin
        dataSet.FieldByName('COD_VENDEDOR').AsInteger := vDadosIni.vCodUsuario;
        dataSet.FieldByName('TIPO_EMISSAO').AsString := '2';
        dataSet.FieldByName('COD_NF_REF').AsInteger := 0;
        dataSet.FieldByName('NUM_NF_COMPL').AsInteger := frmCadNF.edNumNfCompl.AsInteger;
