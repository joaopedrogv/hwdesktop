procedure TNFCab.checkConfigBcICMS;
type
  TSetTributos = set of TTipoTributo;
const
  tributos: TSetTributos = [ttICMS, ttICMSST, ttICMSUFDest];
var
  T      : TTipoTributo;
  section: string;
  tribstr: string;
  conf   : TConfTributo;
  fretebc: Boolean;
  continu: Boolean;
begin

  if fequals('natureza_nf', 'E') then
    Exit;

  case frete_strToOperacao of
    opfContaTerceiros      : fretebc := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_terceiros;
    opfContaEmitente,
    opfProprioEmitente     : fretebc := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_emitente;
    opfContaDestinatario,
    opfProprioDestinatario : fretebc := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_destinatario;
    opfSemFrete            : fretebc := True;
  end;

  conf      := TConfTributo.Create();
  conf.Text := fstr('conf_bc');

  for T := Low(T) to High(T) do
    if T in tributos then
    begin
      case T of
        ttICMS      : tribstr := 'ICMS';
        ttICMSST    : tribstr := 'ICMSST';
        ttICMSUFDest: tribstr := 'ICMSUFDest';
      end;

      section := TConfTributo.GetSectionBC(T, fstr('natureza_nf'), fstr('modelo_nf'));

      if (not conf.ReadBool(section, 'Habilitado')) then
      begin

        continu := (not fretebc) or (conf.ini.SectionExists(section));

        if continu then
        begin
          conf.WriteBool(section, 'Habilitado', not fretebc); //aqui é o contrario para ativar, pois a configuracao padrao o frete está na base
          conf.WriteDefaultBC(T, section);
          conf.WriteString(section, 'Campo_Frete', IfThen(fretebc, 'S', 'N'));
          dataSet.FieldByName('conf_bc').AsString := conf.Text;
        end;
      end;
    end;
end;

procedure TNFCab.checkConfigBcPisCofins;
  { Nao usa o salvo, sempre usa a configuracao
var
  section: string;
  conf: TConfTributo;
  }
begin
  {
  conf      := TConfTributo.Create();
  section   := ReplaceText(TConfTributo.GetSectionBC(ttPISCOFINS, fstr('natureza_nf'), fstr('modelo_nf')), 'Composicao_BC_PISCOFINS_', '');
  conf.Text := fstr('conf_bc');
  if not conf.ini.SectionExists(section) then
  begin
    section := ReplaceText(section, 'Composicao_BC_PISCOFINS_', '');
    if Config.Conf_PIS.nf_piscofins_bases.value1_b.ini.SectionExists(section) then
    begin
      Config.Conf_PIS.nf_piscofins_bases.value1_b.WriteBool(section, 'Habilitado', True);
      conf.setConfBC(ttPISCOFINS, fstr('natureza_nf'), fstr('modelo_nf'), section, Config.Conf_PIS.nf_piscofins_bases.value1_b);
      dataSet.FieldByName('conf_bc').AsString := conf.Text;
    end;
  end;
  }
end;

function TNFCab.CodigoANPExecaoIcmsUFDest(AValue: Integer): Boolean;
var
  AList: TStrings;
  I: Integer;
begin
  if not Assigned(FExecoesCodigoANP) then
  begin
    FExecoesCodigoANP := TStringList.Create;
    FExecoesCodigoANP.Sorted := True;
    FExecoesCodigoANP.Duplicates := dupIgnore;
    AList := vDadosIni.getConfSisBlob('nf_e_excecao_anp_cims_inter_nao_contri', buscas);
    AList.LineBreak := '|';
    AList := vDadosIni.SplitS('|' + AList.Text + '|', ['|', ',', ';', '.', ' ']);
    for I := 0 to AList.Count - 1 do
      if Trim(AList[I]) <> '' then
        FExecoesCodigoANP.Add(AList[I])
  end;
  Result := False;
  for I := 0 to FExecoesCodigoANP.Count - 1 do
    if StrToIntDef( Trim(FExecoesCodigoANP[I]), -1) = AValue then
    begin
      Result := True;
      Break;
    end;
end;

function TNFCab.ColarItensNaNF(payload: IClipBoardItem; AlogEvent: TLogEvent): Boolean;
  procedure DoLog(const Value: string; error: Boolean = False);
  begin
    if Assigned(AlogEvent) then
      AlogEvent(Value)
    else if error then
    begin
      ProgressUtil.Error(Value);
      ProgressUtil.TimeOut(2);
    end
    else
      ProgressUtil.TimeOut(2, Value);
  end;
var
  I: Integer;
  prod: TNFProd;
  tribCopyHandler: ITributosHandler;
  tribCopyCtx: TributoDFeContextEtd;
begin
  Result := False;
  if payload.Prods.Count = 0 then
  begin
    DoLog('Sem itens na área de transferência', True);
    Exit;
  end;

  if not Self.emEdicao then
  begin
    DoLog('Nota fiscal não permite mais alterações', True);
    Exit;
  end;

  if (vItem.dataSet.RecordCount + payload.Prods.Count) > 899 then
  begin
    DoLog('A soma total de items não pode ultrapassar 899 - Soma Total: ' +
      IntToStr(vItem.dataSet.RecordCount + payload.Prods.Count), True);
    Exit;
  end;

  DoLog('Colando itens');
  try
    tribCopyHandler := TributosHandler.Create( transacao, tdfoNotaFiscal );

    for I := 0 to payload.Prods.Count - 1 do
    begin
      prod := TNFProd.Create;
      try
        prod.CopyFrom(payload.Prods.Items[I]);

        DoLog('Colando item ' + prod.descricao_item);

        prod.nitem       := vItem.dataSet.RecordCount + 1;
        prod.cod_nf      := fint('cod_nf');
        prod.cod_empresa := vDadosIni.cod_empresa;
        prod.codigo_nop  := StrToFloat(getCfopCorreto(FloatToStr(prod.codigo_nop), prod.comb_ufcons));

        prod.CopyTo(vItem.dataSet, False, True, False, False);

        // Copia somente se for devolucao, caso contrario limpa o ID e vai calcular automaticamente se necessario
        if fequals('tipo_emissao', '4')
          //and (YesNoEnum(fint('dfe_trib_ignorar')) = ynNo) // Sempre copias os tributos quando devolução, o usuário decide na tela se continua ou nao com os trib utos
          and (payload.Prods.Items[I].OrigemItemNF.NotaFiscalId > 0)
          and ((payload.Prods.Items[I].dfe_trib_id <> '') or (payload.Prods.Items[I].dfe_trib_id_xml <> '') )
        then
        begin
          tribCopyHandler.Load(
            payload.Prods.Items[I].OrigemItemNF.NotaFiscalId,
            payload.Prods.Items[I].OrigemItemNF.EmpresaId,
            payload.Prods.Items[I].OrigemItemNF.NItem
          );

          tribCopyCtx := tribCopyHandler.GetItem( StrDefault(payload.Prods.Items[I].dfe_trib_id_xml, payload.Prods.Items[I].dfe_trib_id) );
          try
            if tribCopyCtx <> nil then
            begin
              tribCopyCtx.Id := NewGuid();
              tribCopyCtx.Origem := tdfoNotaFiscal;
              if tribCopyCtx.IbsCbs <> nil then
              begin
                tribCopyCtx.IbsCbs.RegraFiscalId := StringNullable.NullInstance();
                tribCopyCtx.IbsCbs.TipoRegra := tctNenhuma;
              end;
              
              vItem.dataSet.FieldByName('dfe_trib_id').AsString := tribCopyCtx.Id;
              vItem.FTributos.SetItem( tribCopyCtx.Id, tribCopyCtx );
              dataSet.FieldByName('dfe_trib_ignorar').AsInteger := Ord(ynNo);
            end;

          finally
            tribCopyCtx.Free();
          end;
        end
        else
          vItem.dataSet.FieldByName('dfe_trib_id').Clear();
        vItem.dataSet.FieldByName('dfe_trib_id_xml').Clear();

        vItem.Post;

        dataSet.FieldByName('valor_desc').AsFloat := ffloat('valor_desc') + VarToFloat(prod.rateio_desconto);
        dataSet.FieldByName('valor_frete').AsFloat := ffloat('valor_frete') + VarToFloat(prod.rateio_frete);
        dataSet.FieldByName('valor_seguro').AsFloat := ffloat('valor_seguro') + VarToFloat(prod.rateio_seguro);
        dataSet.FieldByName('valor_out_desp').AsFloat := ffloat('valor_out_desp') + VarToFloat(prod.rateio_outdesp);
      finally
        prod.Free;
      end;
    end;

    somaTotaisNF(False);

  finally
    tribCopyHandler.FreeSafe();
    DoLog('Pronto');
  end;
  Result := True;
end;

function TNFCab.conferenciaCegaFechada: boolean;
begin
	try
  	buscas.Close;
    buscas.SQL.Text := 'select cod_conferencia, status from conferencia_cega where '+
    'tipo_conferencia = ''NFENT'' and ativo = 1 and cod_empresa = :cod_empresa and num_doc = :num_doc';
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('num_doc').AsInteger := dataSet.FieldByName('LOTE_CONFERENCIA').AsInteger;
    buscas.Open;

    if buscas.IsEmpty then
    begin
      Result := True;
      Exit;
    end;

    FCodConferencia := buscas.FieldByName('COD_CONFERENCIA').AsInteger;
    Result := buscas.FieldByName('STATUS').AsString = 'FECHADA';
    
  except on E: Exception do
  	Result := True;
  end;
end;

function TNFCab.confirmaNF(): boolean;
var
  vTentarNoSCAN, vNumNFZero, AsendMail, AcomBol: Boolean;
  vProc, anexo: string;
  anexos: hw_utils.ArrayString;
  vPointer: Pointer;
  vCadProduto: TProdutos;
  vAplicativo: TAplicativoEnv;
  vArrayAplicativo: arrayaplicativo;
  vArrayContato: arraycontato;
  vUtilizarArrayContato: Boolean;
  vAssunto, vMensagem: string;
  vAnexarEventos, vAnexarPdfs, vAnexarBoletos: Boolean;
  vStringListErros: TStringList;
  I, J: Integer;
begin
  try
    Result := False;
	 vListDocPrgFid.Clear;

    vProc := 'NF0032';
    if dataSet.FieldByName('NATUREZA_NF').AsString = 'S' then
      vProc := 'NF0033';
    if not vDadosIni.PesqPros(vProc, 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, buscas, True) then
      Exit;
    if dataSet.IsEmpty then
      exit;
    if get_situacao_nfe <> sitAutorizada then
      if notaFechada then
        Exit;
    FDataDoDia := vDadosIni.getDataBanco(buscas);

    if (Trim(dataSet.FieldByName('NATUREZA_NF').AsString) = 'E') and
      (Trim(dataSet.FieldByName('EMISSAO_PROPRIA').AsString) = 'S') and
      (get_status = stsAberta) and
      (get_situacao_nfe = sitAutorizada) then
    begin
      vItem.vDetVeic.Cancel;
      vItem.dataSet.Cancel;
      dataSet.Cancel;
      vItem.vDetVeic.CancelUpdates;
      vItem.CancelUpdates;
      vSped.vC110.CancelUpdates;
      vSped.vC110.vC111.CancelUpdates;
      vSped.vC120.CancelUpdates;
      vSped.vC195_C197.CancelUpdates;
      inherited CancelUpdates;
      dataSet.Edit;
    end;

    if get_situacao_nfe <> sitAutorizada then
    begin
      if Trim(dataSet.FieldByName('desc_natop').AsString) = '' then
      begin
        if not exitCodigoTabela('NAT_OP') then
          Exit;
      end
      else if not validaCfop(dataSet.FieldByName('codigo_nop').AsFloat) then
        exit;
      if not validaCabecalho then
        exit;
      if not validaRodape then
        exit;
      if not validaDadosNotaFiscalEletronica then
        exit;
      if not validaTransporte then
        exit;
      if not validaInscricaoSuframa then
        exit;
      if dataSet.FieldByName('tipo_nf').AsString = 'V' then
        if dataSet.FieldByName('natureza_nf').AsString = 'S' then
        begin
          if not validaDadosVeiculos then
            exit;
        end
        else
        begin
          vItem.dataSet.First;
          while not vItem.dataSet.Eof do
          begin
            vPointer:= vItem.dataSet.GetBookmark;
            vItem.Edit;
            if not validaDadosVeiculos then
              exit;
            vItem.dataSet.GotoBookmark(vPointer);
            vItem.dataSet.Next;
          end;
        end;
    end;

    //Definir os dados de pis/cofins
    definirPISCOFINS;

    ResolverEmissaoPropriaNFe();

    somaTotaisNF;

    if not _validarNotaFiscalZerada then
      Exit;

    if not validarCfopCabecalhoEitens then
      Exit;

   if not validarValorPedidoCorrespondente then
     Exit;

   if not validarGradeInformadaSaida() then
     Exit;

   if not validarEmissaaoPropriaNFe() then
     Exit;

    if (dataSet.FieldByName('natureza_nf').AsString = 'S') and
      (dataSet.FieldByName('dest_cmun').AsString = '9999999') then
      if not _validaDadosExportacao then
        Exit;

    vNumNFZero := false;
    if dataSet.FieldByName('num_nf').AsInteger = 0 then
    begin
      vNumNFZero := True;
      if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
      begin
        {vTentarNoSCAN := tentarSCAN;
        if (dataSet.FieldByName('modelo_nf').AsString = '55') and
          (vDadosIni.vEmp.vNfe.danfeFormaEmissao = 'SCAN') then
        begin
          Application.ProcessMessages;
          Application.MessageBox(pchar('Configuração do SCAN ativada.'+sLineBreak+
            'O Sistema irá verificar o Status do servidor SCAN na RFB'),
            'Atenção',0+64);

          if 107 = 107 then
          begin
            Application.ProcessMessages;
            Application.MessageBox(pchar('SCAN ativado pela SEFAZ de Origem'+sLineBreak+
              'Deseja verificar servidor SCAN na RFB'

              if not True then //Testar se o webserver esta ativo
                vTentarNoSCAN := True;
          end;
        end;}
        //        vTentarNoSCAN := True; //remover isso daqui, coloquei somente pra testar;
        if tentarSCAN then
        begin
          dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDASCAN' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                               buscas, vDadosIni.codEmpresa);
          vDadosIni.hw_registra_estatistica('NOTAFISCAL');
          dataSet.FieldByName('serie').AsString := IntToStr(vDadosIni.vEmp.vNfe.serieScan);
          dataSet.FieldByName('tiponfe').AsString := 'SCAN';
        end
        else
        begin
          if dataSet.FieldByName('modelo_nf').AsString = vDadosIni.vEmp.vNfe.modeloNF then
            dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDA' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                                 buscas, vDadosIni.codEmpresa)
          else
            dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDA_SERV' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                                 buscas, vDadosIni.codEmpresa);
          vDadosIni.hw_registra_estatistica('NOTAFISCAL');
        end;
      end;
    end;

    if (dataSet.FieldByName('valor_serv').AsFloat > 0) and (dataSet.FieldByName('natureza_nf').AsString = 'S') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select CNAE_FISCAL, IM_EMP from empresa where cod_empresa = ' +
        vDadosIni.codEmpresa;
      buscas.Open;
      dataSet.FieldByName('CNAE_FISCAL').AsString := buscas.FieldByName('CNAE_FISCAL').AsString;
      dataSet.FieldByName('IM_EMP').AsString := buscas.FieldByName('IM_EMP').AsString;
      if Trim(dataSet.FieldByName('CNAE_FISCAL').AsString) = '' then
        raiseExceptionCreate('Código CNAE não encontrado no cadastro da empresa', '');
      if Trim(dataSet.FieldByName('IM_EMP').AsString) = '' then
        raiseExceptionCreate('Inscrição Municipal não encontrada no cadastro da empresa', '');
    end
    else
    begin
      dataSet.FieldByName('CNAE_FISCAL').AsString := '';
      dataSet.FieldByName('IM_EMP').AsString := '';
    end;

    FImprimir := False;

    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin

      if not validarUnidadeMedidaCompra then
        Exit;
//      if not validarRegrasCFOP_CST then
//        exit;
      //Relatorio de Conferencia de Pedido de Compra. Quantidades, Valores e Produtos nao recebidos
      if PedidoIrregular then
        exit;
      if DevolucaoIrregular then
        exit;

      if not validarConferenciaCompra then
        Exit;

      if Application.MessageBox('Deseja Fechar a Nota Fiscal?', 'Atenção', MB_YESNO
        + MB_ICONQUESTION) = ID_YES then
      begin
//        if Application.MessageBox('Esta nf possui Benefício Fiscal?', 'Confirmação',
//          MB_ICONQUESTION + MB_YESNO) = IDYES then
//          dataSet.FieldByName('BENEF_FISCAL').AsString := 'S'
//        else
//          dataSet.FieldByName('BENEF_FISCAL').AsString := 'N';

        verificarCFOPdoCabecalho;

        if not validarItensDevolvidos then
          Exit;

        // Adicionando informação da nota fiscal de entrada de devolução confirmada  
        if vDadosIni.vProgFid.vHabilitarProgFid then
        begin
          vItem.dataSet.First;
          while not vItem.dataSet.Eof do
          begin
            // Adicionando informação da nota fiscal de entrada de devolução
            if (dataSet.FieldByName('tipo_nf').AsString = 'V')
              and (dataSet.FieldByName('natureza_nf').AsString = 'E')
              and (trim(dataSet.FieldByName('devolucao').AsString) = 'SIM') then
            begin
              SqlOpen(' select nf.n_comando from notafiscal nf ' +
                 ' where nf.cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf_dev').AsInteger) +
                 ' and nf.cod_empresa = ' + vDadosIni.codEmpresa);
              if buscas.IsEmpty then
              begin
                SqlOpen(' select nf.n_comando from notafiscal nf ' +
                  ' where nf.cod_nf = ' +
                  '   (select first 1 nfi2.cod_nf_dev from notafiscal nf2 ' +
                  '   inner join notafiscal_item nfi2 on nfi2.cod_nf = nf2.cod_nf and nfi2.cod_empresa = nf2.cod_empresa ' +
                  '   where nf2.cod_empresa = ' + vDadosIni.codEmpresa +
                  '   and nf2.cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) + ') ' +
                  ' and nf.cod_empresa = ' + vDadosIni.codEmpresa);
              end;
              if buscas.IsEmpty then
                vListDocPrgFid.Add(IntToStr(dataSet.FieldByName('cod_nf').AsInteger) + '|' + 'DEVV|' + '0|' + 'MOT|')
              else if not buscas.IsEmpty then
                vListDocPrgFid.Add(IntToStr(dataSet.FieldByName('cod_nf').AsInteger) + '|' + 'DEVV|' +
                  IntToStr(buscas.FieldByName('n_comando').AsInteger) + '|' + 'MOT|');
            end;

            vItem.dataSet.Next;
          end;
        end;

        //Atualizar pontos da inclusão de nota de entrada de devolução
        for I := 0 to vListDocPrgFid.Count - 1 do
        begin
          // Atualizar pontos programa de fidelidade
          if not vDadosIni.setarPontosProgFidelidade(StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
            trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)), buscas, true,
            StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 3)), trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 4))) then
          begin
            RollBackTransacao;
            Result := False;
            exit;
          end;
        end;

        verificaMensagensDadosAdicionais;

        if (dataSet.FieldByName('emissao_propria').AsString = 'S') then
        begin
          if Application.MessageBox('NF de Emissão Própria. Confirma emissão da NF?',
            'Atenção', MB_YESNO + MB_ICONQUESTION) = IDYES then
          begin
            if dataSet.FieldByName('NUM_GERADO').AsString <> 'S' then
            begin
              dataSet.FieldByName('serie').AsString     := IntToStr(vDadosIni.vEmp.vSubSerieNotaFiscal);
              dataSet.FieldByName('modelo_nf').AsString := vDadosIni.vEmp.vNfe.modeloNF;
              if tentarSCAN then
              begin
                dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDASCAN' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                                     buscas, vDadosIni.codEmpresa);
                vDadosIni.hw_registra_estatistica('NOTAFISCAL');
                dataSet.FieldByName('serie').AsString := IntToStr(vDadosIni.vEmp.vNfe.serieScan);
                dataSet.FieldByName('tiponfe').AsString := 'SCAN';
              end
              else
              begin
                if dataSet.FieldByName('modelo_nf').AsString = vDadosIni.vEmp.vNfe.modeloNF then
                  dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDA' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                                       buscas, vDadosIni.codEmpresa)
                else
                  dataSet.FieldByName('num_nf').AsInteger := Gencodigo('NF_VENDA_SERV' + IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente <> 'Produção', '_HOM'),
                                                                       buscas, vDadosIni.codEmpresa);
                vDadosIni.hw_registra_estatistica('NOTAFISCAL');
              end;

              dataSet.FieldByName('data_contabil').AsDateTime := FDataDoDia;
              dataSet.FieldByName('hora_emissao').AsString := FormatDateTime('HH:MM:SS', Time);
              dataSet.FieldByName('NUM_GERADO').AsString := 'S';

              if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
                dataSet.FieldByName('crt').AsString := '1'
              else if pos('SIMPLES / EXCESSO', vDadosIni.vEmp.vRegime) > 0 then
                dataSet.FieldByName('crt').AsString := '2'
              else
                dataSet.FieldByName('crt').AsString := '3';
            end;

            verificaMensagensDadosAdicionais;
            if frmCadNF <> nil then
              abreFormImpDadosAdicionais;

            Result := inherited post;

            if (Apply) or (dataSet.ChangeCount = 0) then
            begin
              vItem.Apply;
              FpagNFe.Apply;
              FdupNFe.Apply;
              Fcoleta.Apply;
              Fentrega.Apply;
              FobsCont.Apply;
              Fdefensivo.Apply;
              FguiaTransito.Apply;

              if dataSet.FieldByName('tipo_nf').AsString = 'V' then
                vItem.vDetVeic.Apply
              else if dataSet.FieldByName('tipo_nf').AsString = 'P' then
//                if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
                  vItem.vDetEcf.Apply;
              CommitaTransacao;
              vDadosIni.GravaAuditoria(vProc, 'EDITAR', 'SUCESSO', 'NOTAFISCAL',
                dataSet.FieldByName('COD_NF').AsString, buscas);
            end
            else
            begin
              Cancel;
              RollBackTransacao;
              vDadosIni.GravaAuditoria(vProc, 'EDITAR', 'FALHA', 'NOTAFISCAL',
                dataSet.FieldByName('COD_NF').AsString, buscas);
              Result := False;
            end;

            if not validaDadosImportacao then
            begin
              Result := False;
              exit;
            end;

            FImprimir := true;
            AcomBol := False;
            AsendMail := False;
            if (dataSet.FieldByName('modelo_nf').AsString = '55') then
              if not enviarNotaFiscalEletronica(AsendMail, AcomBol) then
              begin
                Result := True;
                Exit;
              end;
            selecionaNotaFiscal(dataSet.FieldByName('cod_nf').AsInteger);
            vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
            dataSet.Edit;
            if Trim(dataSet.FieldByName('tiponfe').AsString) <> 'DPEC' then
              if not setDadosFechamento then
              begin
                Result := False;
                Exit;
              end;
          end;
          //          else
          //          begin
          //            Result := True;
          //            exit;
          //          end;
        end
        else if not setDadosFechamento then
        begin
          Result := False;
          Exit;
        end;
      end;
    end
    else
    begin

      if not validarItensDevolvidos then
      begin
        if vNumNFZero then
          dataSet.FieldByName('num_nf').AsInteger := 0;
        Result := False;
        Exit;
      end;

      if not setDadosFechamento then
      begin
        if vNumNFZero then
          dataSet.FieldByName('num_nf').AsInteger := 0;
        Result := False;
        Exit;
      end;
    end;

    if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
    begin
      AtualizarDadosEquipamento;
      GravarHistEstMoto;
      calcularDadosDeOlhoNoImposto;
      verificaMensagensDadosAdicionais;
      if frmCadNF <> nil then
        abreFormImpDadosAdicionais;
    end;

    dupNFe.nf_formatar_mensagem;
    if (dupNFe.dataSet.RecordCount > 0) and (Trim(dataSet.FieldByName('fat_nfat').AsString) = '') then
      dataSet.FieldByName('fat_nfat').AsString := vDadosIni.StrZero(get_num_nf, 6);    

    Result := inherited post;

    if (Apply) or (dataSet.ChangeCount = 0) then
    begin
      vItem.Apply;
      FpagNFe.Apply;
      FdupNFe.Apply;
      Fcoleta.Apply;
      Fentrega.Apply;
      FobsCont.Apply;
      Fdefensivo.Apply;
      FguiaTransito.Apply;

      if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
        (dataSet.FieldByName('tipo_nf').AsString = 'P') and
        (dataSet.FieldByName('emissao_propria').AsString = 'N') then
        vBaixaPedidos.confirmaBaixaItensPedidos(vItem);

      if dataSet.FieldByName('tipo_nf').AsString = 'V' then
        vItem.vDetVeic.Apply
      else if dataSet.FieldByName('tipo_nf').AsString = 'P' then
//        if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
          vItem.vDetEcf.Apply;

      _atualizarSituacaoPedidos('Finalizado');

      if not _gerarPreNotaTransferencia then
      begin
        RollBackTransacao;
        raiseExceptionCreate('Erro ao gerar Pré Nota desta transferencia', '');
      end;

      CommitaTransacao;

      if (dataSet.FieldByName('emissao_propria').AsString <> 'S') and
        (dataSet.FieldByName('modelo_nf').AsString = '55') and
        (Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString) <> '') and
        (FileExists(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString))) then
      begin
        if not DirectoryExists(vDadosIni.vEmp.vNfe.pathArquivos + '\entradas') then
          CreateDir(vDadosIni.vEmp.vNfe.pathArquivos + '\entradas');
        if (DirectoryExists(vDadosIni.vEmp.vNfe.pathArquivos + '\entradas')) and
          (not (FileExists(vDadosIni.vEmp.vNfe.pathArquivos + '\entradas\'+
            ExtractFileName(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString)))))then
          if CopyFile(
            pchar( Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString)),
            pchar( vDadosIni.vEmp.vNfe.pathArquivos + '\entradas\'+
            ExtractFileName(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString)) ),
            False)then
            if (FileExists(vDadosIni.vEmp.vNfe.pathArquivos + '\entradas\'+
              ExtractFileName(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString)))) then
              if ExtractFilePath(UpperCase(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString))) <>
                ExtractFilePath(UpperCase(Trim(vDadosIni.vEmp.vNfe.pathArquivos + '\Autorizado\teste.txt'))) then
                DeleteFile(Trim(dataSet.FieldByName('PATH_XML_IMPORT').AsString));
      end;
      if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      begin
        vItem.dataSet.First;
        while not vItem.dataSet.Eof do
        begin
          if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') then
            if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N' then
              vMD5Func._gravaMD5_Produtos(buscas, vItem.dataSet.FieldByName('grupo_prod').AsInteger,
                vItem.dataSet.FieldByName('cod_prod').AsString);
          vItem.dataSet.Next;
        end;

      end;
      if (dataSet.FieldByName('natureza_nf').AsString = 'S') and
        (dataSet.FieldByName('modelo_nf').AsString <> '55') then
        abrirFormPagamento;
      vDadosIni.GravaAuditoria(vProc, 'EDITAR', 'SUCESSO', 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);

      if (vDadosIni.vEtiquetaNF = 'S') and (vDadosIni.vSupermercado <> 'S') then
        if dataSet.FieldByName('natureza_nf').AsString = 'E' then
          if dataSet.FieldByName('tipo_nf').AsString = 'P' then
            if Application.MessageBox('Deseja imprimir etiquetas?', 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
              vCadProduto._abreFormEtiquetasTerm(dataSet.FieldByName('COD_NF').AsInteger);
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vProc, 'EDITAR', 'FALHA', 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);
      Result := False;
    end;
    if get_status = stsFechada then
      if (dataSet.FieldByName('emissao_propria').AsString = 'S') and
        (dataSet.FieldByName('modelo_nf').AsString = '55') then
      begin
        //      if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
        //        enviarNotaFiscalEletronica
        //      else if FImprimir then
        AsendMail := True;
        AcomBol   := _LerConfiguracoesRegistroBoolean('SendMailComBoleto', True);
        if dataSet.FieldByName('natureza_nf').AsString = 'S' then
          if enviarNotaFiscalEletronica(AsendMail, AcomBol) then
          begin
            verificarImpressaoBoleto;
            if AsendMail then
            begin
              if Config.Conf_Geral.UsarMensageriaAI then
              begin
                try
                	if not vDadosIni.sincronizarDadosContatoClienteAplicativo(dataSet.FieldByName('cod_cliente').AsInteger) then
                  	Exit;

                  vStringListErros := TStringList.Create;
        					vStringListErros.Clear;

                  Application.CreateForm(TFrmEnviarMensagem, FrmEnviarMensagem);
                  FrmEnviarMensagem.CheckListBoxOpcoes.Items.Clear;
                  FrmEnviarMensagem.CheckListBoxOpcoes.Items.Add('Anexar Eventos');
                  FrmEnviarMensagem.CheckListBoxOpcoes.Items.Add('Anexar PDFs');
                  FrmEnviarMensagem.CheckListBoxOpcoes.Items.Add('Anexar Boletos');

                  FrmEnviarMensagem.FrameCheckListaContato.CodCliente := dataSet.FieldByName('cod_cliente').AsInteger;
                  FrmEnviarMensagem.FrameCheckListaContato.Origem := cNfe;
                  FrmEnviarMensagem.FrameCheckListaContato.UnicoMens := False;

                  if FrmEnviarMensagem.ShowModal <> ID_OK then
                    Exit;

                  vArrayAplicativo := vDadosIni.retornaArrayAplicativo(FrmEnviarMensagem.FrameCheckListaContato.CheckListBoxAplicativo, True);
                  vArrayContato    := vDadosIni.retornaArrayContato(FrmEnviarMensagem.FrameCheckListaContato.CheckListBoxContato, True);

                  vUtilizarArrayContato := Length(vArrayContato) > 0;

                  vAnexarEventos := FrmEnviarMensagem.AnexarEventos;
                  vAnexarPdfs    := FrmEnviarMensagem.AnexarPdfs;
                  vAnexarBoletos := FrmEnviarMensagem.AnexarBoletos;

                  try
                anexo := LegacyDFeDLLAdapter.GeraArquivosNFe(
                      [get_cod_nf], vDadosIni.cod_empresa, vAnexarPdfs, vAnexarEventos, vAnexarBoletos, vDadosIni.vBancoHW
                );
                    anexos := NewArrayString(anexo, ';');

                    if vUtilizarArrayContato then
         						begin
                      for J := 0 to Length(vArrayContato) - 1 do
                      begin
                         vDadosIni.retornaMensagemEnv(cNfe, vArraycontato[J].Aplicativo, vAssunto, vMensagem);

                try
                           if not vDadosIni.EnvEmail(
                             vAssunto,
                             vMensagem,
                             dataSet.FieldByName('cod_cliente').AsInteger,
                             vArrayContato[J].Aplicativo,
                             IntToStr(get_cod_nf),
                             OrigemEnvStr[cNfe],
                             cNfe,
                             StringService.Join(sLineBreak, anexos),
                             Length(anexos),
                             True,
                             vArrayContato[J].Identificacao,
                             vArrayContato[J].Contato,
                             vArrayContato[J].Avulso) then
                           begin
                             if vStringListErros.Count = 10 then
                               vStringListErros.Add('...');
                             if vStringListErros.Count < 10 then
                               vStringListErros.Add('Falha ao enviar ' + LowerCase(AplicativoEnvStr[vArrayContato[J].Aplicativo]) + ' para ' + trim(vArrayContato[J].Identificacao) + '.');
                           end;
                         except
                           if vStringListErros.Count = 10 then
                             vStringListErros.Add('...');
                           if vStringListErros.Count < 10 then
                             vStringListErros.Add('Falha ao enviar ' + LowerCase(AplicativoEnvStr[vArrayContato[J].Aplicativo]) + ' para ' + trim(vArrayContato[J].Identificacao) + '.');
                         end;
                      end;
                    end
                    else
                    begin
                      for vAplicativo in vArrayAplicativo do
                      begin
                        vDadosIni.retornaMensagemEnv(cNfe, vAplicativo, vAssunto, vMensagem);

                        vArrayContato := vDadosIni.retornaArrayContato(dataSet.FieldByName('cod_cliente').AsInteger, vAplicativo, cNfe, False);

                        for J := 0 to Length(vArrayContato) - 1 do
                        begin
                        	try
                            if not vDadosIni.EnvEmail(
                              vAssunto,
                              vMensagem,
                              dataSet.FieldByName('cod_cliente').AsInteger,
                              vArrayContato[J].Aplicativo,
                              IntToStr(get_cod_nf),
                              OrigemEnvStr[cNfe],
                              cNfe,
                              StringService.Join(sLineBreak, anexos),
                              Length(anexos),
                              True,
                              vArrayContato[J].Identificacao,
                              vArrayContato[J].Contato,
                              vArrayContato[J].Avulso) then
                            begin
                              if vStringListErros.Count = 10 then
                                vStringListErros.Add('...');
                              if vStringListErros.Count < 10 then
                                vStringListErros.Add('Falha ao enviar ' + LowerCase(AplicativoEnvStr[vArrayContato[J].Aplicativo]) + ' para ' + trim(vArrayContato[J].Identificacao) + '.');
                            end;
                          except
                            if vStringListErros.Count = 10 then
                              vStringListErros.Add('...');
                            if vStringListErros.Count < 10 then
                              vStringListErros.Add('Falha ao enviar ' + LowerCase(AplicativoEnvStr[vArrayContato[J].Aplicativo]) + ' para ' + trim(vArrayContato[J].Identificacao) + '.');
                          end;
                        end;
                      end;
                    end;

                    if vStringListErros.Count > 0 then
          						Application.MessageBox(PChar(vStringListErros.Text), 'Atenção', MB_ICONERROR + MB_OK + MB_DEFBUTTON1);
                finally
                  for anexo in anexos do
                    	if FileExists(anexo) then
                    DeleteFile(anexo);
                end;
                finally
                  if Assigned(vStringListErros) then
                  	FreeAndNil(vStringListErros);

                	if Assigned(FrmEnviarMensagem) then
                  begin
                    FrmEnviarMensagem.Free;
                    FrmEnviarMensagem := nil;
                  end;
                end;
              end
              else
                emailNFe(AcomBol);
            end;

            abrirFormPagamento;
            abrirGNREonline;
            abrirCadastroObrigacoesICMSDifal;
          end;
        _GravaConfiguracoesBoolean('SendMailComBoleto', AcomBol);
      end
      else
      begin
        if dataSet.FieldByName('emissao_propria').AsString = 'S' then
          if Application.MessageBox('Deseja Imprimir Nota Fiscal?', 'Atenção',
            MB_YESNO + MB_ICONQUESTION) = IDYES then
            imprimeNotaFiscal;
        if dataSet.FieldByName('natureza_nf').AsString = 'S' then
        begin
          verificarImpressaoBoleto;
          abrirGNREonline;
          abrirCadastroObrigacoesICMSDifal;
        end;
      end;
    //Lançar valor do Frete
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      if get_status = stsFechada then
        VerificaCadastroConhecimentoDeFrete;

    //Verificar Equipamentos
    if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      if (get_status = stsFechada) and (dataSet.FieldByName('tipo_nf').AsString = 'V') then
        verificaCadastroEquipamentos;

    //Verificar Pagamento em Cartao
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      if get_status = stsFechada then
        if  verificaFaturasEmCartao > 0 then
          vDadosIni.abreForm('Cartão de Crédito', frmCadNF.pnDadosCartao, frmCadNF.tsDetalhesNF);

    // Verificar Lancamentos de ajuste Automaticos
    vSped.VerificarAjustesAutoAposConfirmacao();

    montaSelect(vsqlTemp);

    for I := 0 to vListDocPrgFid.Count - 1 do
      vDadosIni.ImprimirRecProgFid(buscas, StrToInt(vDadosIni.getCampoPipe(vListDocPrgFid[i], 1)),
         trim(vDadosIni.getCampoPipe(vListDocPrgFid[i], 2)),
         'DÉBITO'); //Imprimir recibo programa de fidelidade

    Result := true;
  except
    on e: Exception do begin
      Result := false;
      Application.MessageBox(pchar('Erro no Fechamento. Erro: ' + e.Message), 'Atenção',
        MB_ICONERROR + MB_OK);
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' confirmaNF ' + e.Message);
      vDadosIni.GravaAuditoria(vProc, 'EDITAR', 'FALHA', 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, buscas);
    end;
  end;
end;

function TNFCab.consulta: boolean;
var
  I, erro: Integer;
  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  AempNfe: TEmpresa_nfe_class;
begin
  vCons.valor   := Trim(vCons.valor);
  vCons.valorAd := Trim(vCons.valorAd);
  try
    if vCons.personalisada then
    begin
      result := ConsultaCampos('NOTAFISCAL', '', 'NUM_NF', 'Igual',
          'NUM_NF', vCons.sqlPersonalizado, False, vDadosIni.codEmpresa);
      Exit;
    end;
    if vCons.porData then
    begin
      try
        erro := 0;
        StrToDate(vCons.dataIni);
      except
        vCons.dataIni := '';
        erro := erro + 1;
      end;
      try
        StrToDate(vCons.dataFim);
      except
        vCons.dataFim := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data Inválida. Informe no mínimo uma data correta', 'Atenção',
          MB_OK + MB_ICONINFORMATION);
      end;
    end; //porData
    vsqlAdicional := '';
    if vCons.adicional then
      if not vCons.porDataAd then
        if Trim(vCons.valorAd) = '' then
          vCons.adicional := False;

    if vCons.adicional then
    begin
      if vCons.porDataAd then
      begin
        try
          erro := 0;
          StrToDate(vCons.dataIniAd);
        except
          vCons.dataIniAd := '';
          erro := erro + 1;
        end;
        try
          StrToDate(vCons.dataFimAd);
        except
          vCons.dataFimAd := '';
          erro := erro + 1;
        end;
        if erro = 2 then
        begin
          Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
            'Atenção', MB_OK + MB_ICONINFORMATION);
        end
        else
        begin
          if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
            formatodata := 'mm/dd/yyyy'
          else if pos('.', ShortDateFormat) <> 0 then
            formatodata := 'dd.mm.yyyy';
          if vCons.dataIniAd <> '' then
            vCons.dataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(vCons.dataIniAd)));
          if vCons.dataFimAd <> '' then
            vCons.dataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(vCons.dataFimAd)));
        end;
      end
      else
      begin
        vCons.dataIniAd := '';
        vCons.dataFimAd := '';
      end;
      if vCons.condicaoAd = 'Igual' then
        vCons.condicaoAd := '='
      else if vCons.condicaoAd = 'Maior' then
        vCons.condicaoAd := '>'
      else if vCons.condicaoAd = 'Menor' then
        vCons.condicaoAd := '<'
      else if vCons.condicaoAd = 'Diferente' then
        vCons.condicaoAd := '<>'
      else if (vCons.condicaoAd = 'Esta contido') then
        vCons.condicaoAd := 'like'
      else if (vCons.condicaoAd = 'Começa') then
        vCons.condicaoAd := 'Começa'
      else
        vCons.condicaoAd := '=';
      for I := 0 to dataSet.FieldCount - 1 do
      begin
        if Dataset.Fields[I].FieldKind = fkData then
        begin
          if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(vCons.campoAd) then
          begin
            vCons.valorAd := ajustar_consulta_incasesensitive(DataSet.Fields[I], 'NOTAFISCAL', vCons.valorAd);
            vCons.campoAd := DataSet.Fields[I].FieldName;
            if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
              (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
              ((vCons.condicaoAd = 'Começa') or (vCons.condicaoAd = 'Começa')) then
            begin
//              vCons.condicaoAd := '=';
              if (Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField) then
              begin
                try
                  vCons.valorAd := IntToStr(StrToInt(Trim(vCons.valorAd)));
                except
                  vCons.valorAd := '0';
                  Application.MessageBox('Valor inválido', 'Atenção', 0 + 64);
                end;
              end
              else
              vCons.valorAd := vDadosIni.tirapontos(vCons.valorAd, 4);
            end
            else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
            begin
              if (vCons.dataIniAd <> '') and (vCons.dataFimAd <> '') then
                vsqlAdicional := ' and ' + vCons.campoAd + ' >= ' + vCons.dataIniAd + ' and ' +
                  vCons.campoAd + ' <= ' + vCons.dataIniAd
              else if (vCons.dataFimAd <> '') then
                vsqlAdicional := ' and ' + vCons.campoAd + ' <= ' + vCons.dataIniAd
              else if (vCons.dataIniAd <> '') and (vCons.dataFimAd <> '') then
                vsqlAdicional := ' and ' + vCons.campoAd + ' >= ' + vCons.dataIniAd;
              Break;
            end;
            if vCons.condicaoAd = 'like' then
              vsqlAdicional := ' and ' + vCons.campoAd + ' like ' + QuotedStr('%' + vCons.valorAd +
                '%')
            else if vCons.condicaoAd = 'Começa' then
              vsqlAdicional := ' and ' + vCons.campoAd + ' like ' + QuotedStr(vCons.valorAd + '%')
            else
              vsqlAdicional := ' and ' + vCons.campoAd + ' ' + vCons.condicaoAd + ' ' +
                QuotedStr(vCons.valorAd);
            Break;
          end;
        end;
      end;
    end; //adicional

    if vCons.avancada then
    begin
      if vCons.operacaoAv = 'Entrada' then
        vsqlAdicional := vsqlAdicional + ' and NATUREZA_NF = ' + QuotedStr('E')
      else if vCons.operacaoAv = 'Saída' then
        vsqlAdicional := vsqlAdicional + ' and NATUREZA_NF = ' + QuotedStr('S');
      if vCons.statusAv = 'Abertas' then
        vsqlAdicional := vsqlAdicional + ' and STATUS = ' + QuotedStr(stsAberta)
      else if vCons.statusAv = 'Fechadas' then
        vsqlAdicional := vsqlAdicional + ' and STATUS = '  + QuotedStr(stsFechada)
      else if vCons.statusAv = 'Canceladas' then
        vsqlAdicional := vsqlAdicional + ' and STATUS = ' + QuotedStr(stsCancelada)
      else if vCons.statusAv = 'A Inutilizar' then
        vsqlAdicional := vsqlAdicional + ' and SITUACAO_NFE = ' + QuotedStr(sitAInutilizar)
      else if vCons.statusAv = 'Pre Notas' then
        vsqlAdicional := vsqlAdicional + ' and STATUS = ' + QuotedStr(stsPreNota)

      else if vCons.statusAv = 'Mais Opções NFe' then
      begin
        AempNfe := FdllNFe.empNFe;
        Application.CreateForm(TfrmOpcoesPesquisaNFe, frmOpcoesPesquisaNFe);
        try
          frmOpcoesPesquisaNFe.btPendenenciasDias.Caption := Format('NFe pendentes com data de emissão acima de %d dias', [AempNfe.nfependemdias]);
          frmOpcoesPesquisaNFe.btPendenenciasDias.Enabled := AempNfe.nfependemdias > 0;
          frmOpcoesPesquisaNFe.btPendenenciasQtde.Enabled := AempNfe.nfe_qtdelimitenfpend > 0;

          if frmOpcoesPesquisaNFe.ShowModal = mrOk then
          begin
            if frmOpcoesPesquisaNFe.pendentesDias then
            begin
              montaSelect('select * from notafiscal' +
                          ' where cod_empresa = ' + vDadosIni.codEmpresa +
                          ' and modelo_nf = ''55''' +
                          ' and emissao_propria = ''S''' +
                          ' and ativo = 1' +
                          ' and not coalesce(situacao_nfe, '''') in (' + QuotedStr(sitEnviando) +
                          ', ' + QuotedStr(sitEmProcessamento) + ', ' + QuotedStr(sitAutorizada) +
                          ', ' + QuotedStr(sitDenegada) + ', ' + QuotedStr(sitCancelada) +
                          ', ' + QuotedStr(sitInutilizada) + ', ' + QuotedStr(sitEmEPEC) + ')' +
                          ' and data_contabil < ' + vDadosIni.FusoSqlDate + ' - ' + IntToStr(AempNfe.nfependemdias));
              Exit;
            end
            else if frmOpcoesPesquisaNFe.pendentesQtde then
            begin
              montaSelect('select * from notafiscal' +
                          ' where cod_empresa = ' + vDadosIni.codEmpresa +
                          ' and modelo_nf = ''55''' +
                          ' and emissao_propria = ''S''' +
                          ' and ativo = 1' +
                          ' and not coalesce(situacao_nfe, '''') in (' + QuotedStr(sitEnviando) +
                          ', ' + QuotedStr(sitEmProcessamento) + ', ' + QuotedStr(sitAutorizada) +
                          ', ' + QuotedStr(sitDenegada) + ', ' + QuotedStr(sitCancelada) +
                          ', ' + QuotedStr(sitInutilizada) + ', ' + QuotedStr(sitEmEPEC) + ')');
              Exit;
            end
            else
              with frmOpcoesPesquisaNFe do
              begin
                situacoes := IfThen(ckSemStatus.Checked, QuotedStr(sitVazio) + ',') +
                             IfThen(ckEnviando.Checked, QuotedStr(sitEnviando) + ',') +
                             IfThen(ckEmProcessamento.Checked, QuotedStr(sitEmProcessamento) + ',') +
                             IfThen(ckDuplicidade.Checked, QuotedStr(sitDuplicidade) + ',') +
                             IfThen(ckAutorizada.Checked, QuotedStr(sitAutorizada) + ',') +
                             IfThen(ckDenegada.Checked, QuotedStr(sitDenegada) + ',') +
                             IfThen(ckCancelada.Checked, QuotedStr(sitCancelada) + ',') +
                             IfThen(ckInutilizada.Checked, QuotedStr(sitInutilizada) + ',') +
                             IfThen(ckRejeitada.Checked, QuotedStr(sitRejeitada) + ',') +
                             IfThen(ckAInutilizar.Checked, QuotedStr(sitAInutilizar) + ',') +
                             IfThen(ckEmEPEC.Checked, QuotedStr(sitEmEPEC) + ',');
                if situacoes <> '' then
                begin
                  situacoes := Copy(situacoes, 1, Length(situacoes) - 1);
                  vsqlAdicional := vsqlAdicional + ' and coalesce(situacao_nfe, '''') in (' + situacoes + ')';
                end;
              end;
          end;
        finally
          frmOpcoesPesquisaNFe.Close;
          if Assigned(frmOpcoesPesquisaNFe) then
            FreeAndNil(frmOpcoesPesquisaNFe);
        end;
      end;

      if ((vCons.prodServAv) and (vCons.veiculosAv) and (vCons.despesasAv) and (vCons.outrasAv) and (vCons.servicosAv))
        or ((not vCons.prodServAv) and (not vCons.veiculosAv)
        and (not vCons.despesasAv) and (not vCons.outrasAv) and (not vCons.servicosAv)) then
      else
      begin
        tempTipo := '';
        tempSql := '';
        if vCons.prodServAv then tempTipo := tempTipo + 'P';
        if vCons.veiculosAv then tempTipo := tempTipo + 'V';
        if vCons.outrasAv then tempTipo := tempTipo + 'O';
        if vCons.despesasAv then tempTipo := tempTipo + 'D';
        if vCons.servicosAv then tempTipo := tempTipo + 'S';
        for I := 1 to length(tempTipo) do
        begin
          if i = 1 then
          begin
            tempSql := tempSql + ' and ( (TIPO_NF = ' + QuotedStr(tempTipo[i]) + ')';
            if length(tempTipo) = 1 then
              tempSql := StringReplace(tempSql, 'and ( (TIPO_NF = ', 'and (TIPO_NF = ',
                [rfReplaceAll]);
          end
          else if i = length(tempTipo) then
            tempSql := tempSql + ' or (TIPO_NF = ' + QuotedStr(tempTipo[i]) + '))'
          else
            tempSql := tempSql + ' or (TIPO_NF = ' + QuotedStr(tempTipo[i]) + ')';
        end;
        vsqlAdicional := vsqlAdicional + tempSql;
      end;
    end; //avancada

    if (vCons.avancada) or (vcons.adicional) then
    begin
      if vCons.porData then
        result := ConsultaCampos('NOTAFISCAL', vCons.campo, vCons.ordem, vCons.dataIni,
          vCons.dataFim, vsqlAdicional, vDadosIni.codEmpresa)
      else
        result := ConsultaCampos('NOTAFISCAL', vCons.valor, vCons.campo, vCons.condicao,
          vCons.ordem, vsqlAdicional, False, vDadosIni.codEmpresa);
    end
    else
    begin
      if vCons.porData then
        result := ConsultaCampos('NOTAFISCAL', vCons.campo, vCons.ordem, vCons.dataIni,
          vCons.dataFim, vDadosIni.codEmpresa)
      else
        result := ConsultaCampos('NOTAFISCAL', vCons.valor, vCons.campo, vCons.condicao,
          vCons.ordem, False, vDadosIni.codEmpresa);
    end;
  finally
    vsqlTemp := dataSet.CommandText;
  end;
end;

