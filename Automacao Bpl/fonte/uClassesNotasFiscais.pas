procedure TNFCab.detalheFormPagamento;
var
  obFormPag2: TFormPag2;
  hdFormPag: THandle;
  formulario: TfrmPadrao;
begin
  if not vDadosIni.PesqPros('NF0040', 'CONSULTA', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  if dataSet.IsEmpty then
    exit;
  if dataSet.FieldByName('natureza_nf').AsString = 'S' then
  begin
    try
      CarregaPacote('pkFormPag', hdFormPag);
      obFormPag2 := TFormPag2.Create;
      obFormPag2.detalhamentoVenda(dataSet.FieldByName('num_nf').AsInteger,
        Trim(dataSet.FieldByName('serie').AsString), 'NF');
    finally
      UnloadPackage(hdFormPag);
    end;
  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text := ' select c.nome_cliente "Nome Fornecedor", ca.tipo_ctp "F/D",' +
      ' ca.data_ent_ctp "Data Ent",' +
      ' ca.n_doc_ctp "Num Doc", ca.data_venc_ctp "Data Venc", ca.valor_ctp "Valor",' +
      ' ca.status_ctp "Status", ca.datq_ctp "Data Quit", ca.valor_pago "Valor Pago",' +
      ' ca.historico_ctp "Histórico", ca.cod_contrp "Código CP"' +
      ' from contas_a_pagar ca' +
      ' left join clientes c on c.cod_cliente = ca.cod_forn_nfe and c.cod_empresa = ca.' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') +
      ' where ca.num_nota_nfe = :num_nf and ca.serie = :serie and ca.' + vDadosIni.retornoPorCondicao(vDadosIni.vEmp.vFinanceiroUnificado, 'COD_EMP_MULT', 'CODIGO_EMP') +
      ' = :cod_empresa and cod_forn_nfe = :cod_forn_nfe';
    buscas.ParamByName('num_nf').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
    buscas.ParamByName('serie').AsString := dataSet.FieldByName('serie').AsString;
    buscas.ParamByName('cod_empresa').AsInteger := dataSet.FieldByName('cod_empresa').AsInteger;
    buscas.ParamByName('cod_forn_nfe').AsInteger := dataSet.FieldByName('cod_cliente').AsInteger;
    buscas.Open;
    if buscas.IsEmpty then
      Exit;
    try
      formulario := TfrmPadrao.Create(Application);
      formulario.Width := 620;
      formulario.Height := 500;
      formulario.Position := poScreenCenter;
      formulario.Caption :=
        'Detalhes de Pagamento da Nota Fiscal de Entrada';
      frmCadNF.pnDetFormPagEnt.Parent := formulario;
      frmCadNF.dbGridDetPagEnt.DataSource := dtmNF.dsTemp;
      dtmNF.dsTemp.DataSet := buscas;
      formulario.AutoSize := True;
      formulario.AutoScroll := False;
      formulario.ShowHint := True;
      formulario.ShowModal;
    finally
      frmCadNF.pnDetFormPagEnt.Parent := frmCadNF.tsDetalhepagEnt;
      frmCadNF.dbGridDetPagEnt.DataSource := nil;
      dtmNF.dsTemp.DataSet := nil;
      formulario.Free;
      formulario := nil;
    end;
  end;
end;

function TNFCab.DevolucaoIrregular: Boolean;
var
  buscas2: TIBQuery;
begin
  Result := False;
  if dataSet.FieldByName('cod_devolucao').AsInteger = 0 then
  begin
//    vItem.dataSet.First;
//    while not vItem.dataSet.Eof do
//    begin
//      vItem.dataSet.Edit;
//      vItem.dataSet.FieldByName('codigo_nop').AsString :=
//        getCfopCorreto(vItem.dataSet.FieldByName('codigo_nop').AsString);
//      vCfop.selecionaCfop(Trunc(vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat));
//      vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := vCfop.dataSet.FieldByName('ALT_EST').AsString;
//      vItem.dataSet.FieldByName('altera_custo_cfop').AsString := vCfop.dataSet.FieldByName('calc_custo').AsString;
//      vItem.dataSet.Post;
//      vItem.dataSet.Next;
//    end;
    Exit;
  end;

  if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
    Exit;

  if dataSet.FieldByName('natureza_nf').AsString <> 'E' then
    Exit;

  if Copy(dataSet.FieldByName('devolucao').AsString,1,1) <> 'S' then
  begin
    Result := True;
    Application.MessageBox('Foi informado um numero para o Controle Interno de Devolução, porém o campo "Devolução" está com o valor diferente de "SIM"', 'Atenção', 0 + 64);
    Exit;
  end;

  buscas.Close;
  buscas.SQL.Text := 'select distinct sequencia, cod_cliente from devolucao' +
    ' where sequencia = ' + IntToStr(dataSet.FieldByName('cod_devolucao').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa ;
  buscas.Open;

  if buscas.FieldByName('sequencia').AsInteger <> dataSet.FieldByName('cod_devolucao').AsInteger then
  begin
    Result := True;
    Application.MessageBox('Controle Interno de Devolução não encontrado. Verifique!', 'Atenção', 0 + 64);
    Exit;
  end;    

  if (buscas.FieldByName('cod_cliente').AsInteger <> dataSet.FieldByName('cod_cliente').AsInteger) and
    (buscas.FieldByName('cod_cliente').AsInteger > 0) and
    (buscas.FieldByName('cod_cliente').AsInteger <> StrToIntDef(vDadosIni.vCliente.vCodClientePadrao, 0)) and
    (fdif('cpfcgc', vDadosIni.vEmp.vCNPJ)) then
  begin
    Result := True;
    Application.MessageBox('Nota Fiscal com cliente diferente do cliente do Controle Interno de Devolução', 'Atenção', 0 + 64);
    Exit;
  end;

  buscas.Close;
  buscas.SQL.Text := 'select cod_devolucao, num_nf from notafiscal' +
    ' where cod_devolucao = ' + IntToStr(dataSet.FieldByName('cod_devolucao').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and cod_nf <> ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
    ' and status <> ' + QuotedStr(stsCancelada);
  buscas.Open;

  if buscas.FieldByName('cod_devolucao').AsInteger = dataSet.FieldByName('cod_devolucao').AsInteger then
  begin
    Result := True;
    Application.MessageBox(pchar('Controle Interno de Devolução já está vinculado a Nota Fiscal ' + buscas.FieldByName('num_nf').AsString), 'Atenção', 0 + 64);
    Exit;
  end;
  
  try

    try

      buscas2 := TIBQuery(dtmNF.qrBuscasNf2);

      buscas.Close;
      buscas.SQL.Text := 'select d.grupo_prod, d.cod_prod, p.num_fab_prod, p.descr_prod, sum(d.quant) qtde from devolucao d' +
        ' inner join produtos p on p.grupo_prod = d.grupo_prod and p.cod_prod = d.cod_prod and p.cod_empresa = d.cod_empresa' +
        ' where d.sequencia = ' + IntToStr(dataSet.FieldByName('cod_devolucao').AsInteger) +
        ' and d.cod_empresa = ' + vDadosIni.codEmpresa +
        ' group by 1,2,3,4';
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin

        buscas2.Close;
        buscas2.SQL.Text := 'select ni.grupo_prod, ni.cod_prod, sum(ni.quantidade) qtde from notafiscal_item ni' +
          ' where ni.cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
          ' and ni.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ni.grupo_prod = ' + IntToStr(buscas.FieldByName('grupo_prod').AsInteger) +
          ' and ni.cod_prod = ' + QuotedStr(buscas.FieldByName('cod_prod').AsString) +
          ' group by 1,2';
        buscas2.Open;

        if buscas2.IsEmpty then
          raiseExceptionCreate('Nota fiscal de Devolução conforme o codigo interno ' + dataSet.FieldByName('cod_devolucao').AsString + sLineBreak +
            'O item: ' + Trim(buscas.FieldByName('num_fab_prod').AsString) + ' - ' + Trim(buscas.FieldByName('descr_prod').AsString) + sLineBreak +
            'não foi encontrado nesta nota nota fiscal, e o item consta no Controle Interno de Devolução','');

        if vDadosIni.StrToFloatFormat(buscas.FieldByName('qtde').AsFloat,4) <>
          vDadosIni.StrToFloatFormat(buscas2.FieldByName('qtde').AsFloat,4) then
          raiseExceptionCreate('Nota fiscal de Devolução conforme o codigo interno ' + dataSet.FieldByName('cod_devolucao').AsString + sLineBreak +
            'O item: ' + Trim(buscas.FieldByName('num_fab_prod').AsString) + ' - ' + Trim(buscas.FieldByName('descr_prod').AsString) + sLineBreak +
            'está com a quantidade diferente do Controle Interno de Devolução' + sLineBreak +
            'Qtde na Nota Fiscal...: ' + Format('%0.4n', [buscas2.FieldByName('qtde').AsFloat]) + sLineBreak +
            'Qtde Controle Interno: ' + Format('%0.4n', [buscas.FieldByName('qtde').AsFloat]), '');


        buscas.Next;
      end;

      // Validando se possui itens que estão na nota fiscal e não estao no controle interno de devolução

      buscas.Close;
      buscas.SQL.Text := 'select ni.grupo_prod, ni.cod_prod, p.num_fab_prod, p.descr_prod, sum(ni.quantidade) qtde from notafiscal_item ni' +
        ' inner join produtos p on p.grupo_prod = ni.grupo_prod and p.cod_prod = ni.cod_prod and p.cod_empresa = ni.cod_empresa' +
        ' where ni.cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
        ' and ni.cod_empresa = ' + vDadosIni.codEmpresa +
        ' group by 1,2,3,4';
      buscas.Open;

      buscas.First;
      while not buscas.Eof do
      begin
        buscas2.Close;
        buscas2.SQL.Text := 'select d.grupo_prod, d.cod_prod, sum(d.quant) qtde from devolucao d' +
          ' where d.sequencia = ' + IntToStr(dataSet.FieldByName('cod_devolucao').AsInteger) +
          ' and d.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and d.grupo_prod = ' + IntToStr(buscas.FieldByName('grupo_prod').AsInteger) +
          ' and d.cod_prod = ' + QuotedStr(buscas.FieldByName('cod_prod').AsString) +
          ' group by 1,2';
        buscas2.Open;

        if buscas2.IsEmpty then
          raiseExceptionCreate('Nota fiscal de Devolução conforme o codigo interno ' + dataSet.FieldByName('cod_devolucao').AsString + sLineBreak +
            'O item: ' + Trim(buscas.FieldByName('num_fab_prod').AsString) + ' - ' + Trim(buscas.FieldByName('descr_prod').AsString) + sLineBreak +
            'não foi encontrado no Controle Interno de Devolução, e o item consta nesta Nota Fiscal','');

        if vDadosIni.StrToFloatFormat(buscas.FieldByName('qtde').AsFloat,4) <>
          vDadosIni.StrToFloatFormat(buscas2.FieldByName('qtde').AsFloat,4) then
          raiseExceptionCreate('Nota fiscal de Devolução conforme o codigo interno ' + dataSet.FieldByName('cod_devolucao').AsString + sLineBreak +
            'O item: ' + Trim(buscas.FieldByName('num_fab_prod').AsString) + ' - ' + Trim(buscas.FieldByName('descr_prod').AsString) + sLineBreak +
            'está com a quantidade diferente do Controle Interno de Devolução' + sLineBreak +
            'Qtde na Nota Fiscal...: ' + Format('%0.4n', [buscas.FieldByName('qtde').AsFloat]) + sLineBreak +
            'Qtde Controle Interno: ' + Format('%0.4n', [buscas2.FieldByName('qtde').AsFloat]), '');

        buscas.Next;
      end;

      Result := False;

//      vItem.dataSet.First;
//      while not vItem.dataSet.Eof do
//      begin
//        vItem.dataSet.Edit;
//        vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := 'N';
//        vItem.dataSet.Post;
//        vItem.dataSet.Next;
//      end;

    except
      on e: exception do begin
        Result := True;
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
        Application.MessageBox('Salve a nota fiscal antes de confirmar. Se o problema persistir verifique', 'Atenção', 0 + 64);
      end;
    end;
  finally
    buscas2.Close;
    buscas.Close;
  end;
end;

function TNFCab.devolverNotaFiscal(codigoDevolucao: string): boolean;
var
  tempSubstituicao: Boolean;
  buscas2: TIBQuery;
  vOK: Boolean;
begin
  try
    Result := False;
    buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
    try
      StrToInt(Trim(codigoDevolucao));
    except
      raiseExceptionCreate('Código de devolução inválido', '');
    end;

    buscas2.Close;
    buscas2.SQL.Text := 'select * from devolucao where sequencia = ' + Trim(codigoDevolucao) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas2.Open;

    if buscas2.IsEmpty then
      raiseExceptionCreate('Devolução Interna não encontrada pelo código informado: ' +
        codigoDevolucao, '');
    if not incluirNf(tnfProdutos, 'P', 'E') then
      exit;

    //    buscas2.Close;
    //    buscas2.SQL.Text := 'select * from devolucao where sequencia = ' + Trim(codigoDevolucao) +
    //      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    //    buscas2.Open;

    if vDadosIni.vEmp.vCfopPadraoDevolucao > 0 then
      dataSet.FieldByName('CODIGO_NOP').AsFloat := vDadosIni.vEmp.vCfopPadraoDevolucao
    else
    begin
      tempSubstituicao :=
        Application.MessageBox('Esta Nota Fiscal possui Substituição Tributária',
        'Atenção', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = ID_YES;
      if not tempSubstituicao then
        dataSet.FieldByName('CODIGO_NOP').AsInteger := 1202
      else
        dataSet.FieldByName('CODIGO_NOP').AsInteger := 1411;
    end;

    if buscas2.FieldByName('cod_cliente').AsInteger > 0 then
    begin
      dataSet.FieldByName('cod_cliente').AsInteger :=
        buscas2.FieldByName('cod_cliente').AsInteger;
      buscas.Close;
      buscas.Sql.Text := 'select cod_cliente, tipo from clientes where cod_cliente = '+
        dataSet.FieldByName('cod_cliente').AsString +' and cod_empresa = '+vDadosIni.codEmpresa;
      buscas.Open;
      if (buscas.FieldByName('TIPO').AsString <> 'F') and
        (buscas.FieldByName('TIPO').AsString <> 'A') then
      begin
        buscas.close;
        buscas.sql.Text := 'update clientes set tipo = ''A'' where cod_cliente = ' +
          dataSet.FieldByName('cod_cliente').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
    end
    else
    begin
      vDadosIni.vPesquisa := vDadosIni.pesquisaRapida('CLIENTES');
      dataSet.FieldByName('cod_cliente').AsString := Trim(vDadosIni.vPesquisa);
    end;
    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
      raiseExceptionCreate('Cliente/Fornecedor não encontrado', '');

    exitCodigoTabela('CLIENTES');
    dataSet.FieldByName('CODIGO_NOP').AsString :=
      getCfopCorreto(dataSet.FieldByName('CODIGO_NOP').AsString);
    exitCodigoTabela('NAT_OP');

    dataSet.FieldByName('COD_DEVOLUCAO').AsInteger := StrToInt(codigoDevolucao);
    dataSet.FieldByName('devolucao').asstring := 'SIM';
    dataSet.FieldByName('tipo_emissao').AsString := '4';

    buscas2.First;
    while not buscas2.Eof do
    begin
      if (Trim(buscas2.FieldByName('cod_prod').AsString) <> '') and
        (Trim(buscas2.FieldByName('grupo_prod').AsString) <> '') then
      begin
        if vItem.dataSet.RecordCount >= vDadosIni.vEmp.vQtdeProdNf then
          Break;

        vOK := Trim(buscas2.FieldByName('num_nota_nfe').AsString) = '';
        if not vOK then
          vOK := Application.MessageBox(pchar(
            'Produto. Grupo: ' + Trim(buscas2.FieldByName('grupo_prod').AsString) +
            ' Código: ' + Trim(buscas2.FieldByName('cod_prod').AsString) + sLineBreak +
            'Descrição: ' + Trim(buscas2.FieldByName('DESCRICAO').AsString) + sLineBreak +
            'ja possui nota fiscal emitida de numero: ' +
            buscas2.FieldByName('num_nota_nfe').AsString +
            ' Deseja continuar'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES;
        if vOK then
        begin
          if not vItem.vProd.buscaProduto(buscas2.FieldByName('grupo_prod').AsInteger,
            buscas2.FieldByName('cod_prod').AsString) then
            raise Exception.Create('Produto não encontrado. Grupo: ' +
              Trim(buscas2.FieldByName('grupo_prod').AsString) +
              ' Código: ' + Trim(buscas2.FieldByName('cod_prod').AsString));
          dataSet.FieldByName('emissao_propria').AsString := 'S';
          novoProduto;
          dataSet.FieldByName('emissao_propria').AsString := 'N';
          vItem.vrDadosItem.seq_devolucao := buscas2.FieldByName('SEQUENCIA').AsInteger;
          vItem.vrDadosItem.seqid_devolucao := buscas2.FieldByName('SEQID').AsInteger;
          vItem.vrDadosItem.quantidade := buscas2.FieldByName('QUANT').AsFloat;
          vItem.vrDadosItem.valor_unitario :=
            vDadosIni.StrToFloatFormat(buscas2.FieldByName('VALOR').AsFloat,
            vDadosIni.vEmp.vCasasDecimais);
          if buscas2.FieldByName('VALOR_TOT').AsFloat > 0 then
	          vItem.vrDadosItem.valor_total := vDadosIni.StrToFloatFormat(buscas2.FieldByName('VALOR_TOT').AsFloat, 2)
          else
          	vItem.vrDadosItem.valor_total := vDadosIni.StrToFloatFormat(vItem.vrDadosItem.quantidade * vItem.vrDadosItem.valor_unitario, 2);
          vItem.vrDadosItem.descricao_item := buscas2.FieldByName('DESCRICAO').AsString;
          vItem.vrDadosItem.codigo_nop := dataSet.FieldByName('codigo_nop').AsFloat;
          StrToFloat(getCfopCorreto(FloatToStr(vItem.vrDadosItem.codigo_nop)));
          calcularValorItemDesconto;
          calcularValores;

          vItem.vrDadosItem.unidade_nf := Trim(buscas2.FieldByName('unidade_conv').AsString);
          if (vItem.vrDadosItem.unidade_nf <> '')
            and (vItem.vrDadosItem.unidade_nf <> vItem.vrDadosItem.referencia)
            and (buscas2.FieldByName('fator_conv').AsFloat > 0)
            and (Trim(buscas2.FieldByName('operacao_conv').AsString) <> '') then
          begin
            vItem.vrDadosItem.qtdemb    := IfThen(buscas2.FieldByName('operacao_conv').AsString = 'D', 1 / buscas2.FieldByName('fator_conv').AsFloat, buscas2.FieldByName('fator_conv').AsFloat);
            vItem.vrDadosItem.qtdembrec := vItem.vrDadosItem.quantidade * vItem.vrDadosItem.qtdemb;
            vItem.vrDadosItem.vlrembnf  := vItem.vrDadosItem.valor_total / vItem.vrDadosItem.qtdembrec;
          end;

          Result := incluirItem;
        end;
      end;
      buscas2.Next;
    end;
    ExecutaComandosSqlExec('update clientes set tipo =' +
      ' case when (tipo = ''C'') then ''A''' +
      '   when (tipo = ''F'') then ''F''' +
      '   when (tipo = ''A'') then ''A''' +
      '   else ''F''' +
      ' end where cod_cliente = ' + dataSet.FieldByName('cod_cliente').AsString);

    Result := True;
  except
    on e: exception do
    begin
      Result := False;
      if vItem.dataSet.Active then
      begin
        vItem.dataSet.Cancel;
        vItem.dataSet.CancelUpdates;
      end;
      dataSet.Cancel;
      dataSet.CancelUpdates;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFCab.devolverNotaFiscal(AdevTotal: Boolean): boolean;
var
  vDevolucaoTotal: boolean;
  I: Integer;
  tempSubstituicao: Boolean;
  formulario: TfrmPadrao;
  vOK: Boolean;
  vCodNf: Integer;
  vIntegerTemp: Integer;
  AQuantidade: Double;
  qrItensDev: TIBQuery;
  sChaveNFe: string;
  nItemRefNFe: Integer;
  tribDevHandler: ITributosHandler;
  tribDevCtx: TributoDFeContextEtd;
  tributoIdDev: string;
  ignorarOriginal: YesNoEnum;
begin
  try
    //    if dataSet.FieldByName('natureza_nf').AsString <> 'S' then
    //      raiseExceptionCreate('Nota Fiscal selecionada deve ser de Saída','dbgrid1');

    Result := False;

    if (dataSet.FieldByName('tipo_nf').AsString <> 'P') and
      (dataSet.FieldByName('tipo_nf').AsString <> 'V')  and
      (dataSet.FieldByName('tipo_nf').AsString <> 'O') then
      raiseExceptionCreate('Nota Fiscal deverá ser de produtos, veículos ou do tipo Outras', 'dbgrid1');

    buscas.Close;
    buscas.SQL.Text := 'select nf.status, sum(nfi.quantidade) quantidade from notafiscal_item nfi' +
      ' inner join notafiscal nf on nf.cod_nf = nfi.cod_nf and nf.cod_empresa = nfi.cod_empresa' +
      ' where nfi.cod_nf_dev = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
      ' and nfi.cod_empresa = ' + vDadosIni.codEmpresa +
      ' group by nf.status';
    buscas.Open;

    AQuantidade := 0;
    buscas.First;
    while not buscas.Eof do
    begin
      if buscas.FieldByName('status').AsString <> stsCancelada then
        AQuantidade := AQuantidade + buscas.FieldByName('quantidade').AsFloat;
      buscas.Next;
    end;

    if AQuantidade > 0 then
    begin
      Application.MessageBox(pchar('Nota fiscal ja possui ' + FloatToStr(AQuantidade) +
        ' item(s) devolvido(s)'), 'Atenção', 0 + 64);
      if not vDadosIni.PesqPros('NF0168', 'VALIDAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
        Exit
      else if Application.MessageBox('Deseja continuar mesmo assim?', 'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        Exit;
    end;

    vCodNf := dataset.FieldByName('cod_nf').AsInteger;
    if (dataSet.FieldByName('tipo_nf').AsString = 'P') then
    begin
      if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
        incluirNf( tnfProdutos, 'P', 'S')
      else
        incluirNf( tnfProdutos, 'P', 'E');
    end
    else if (dataSet.FieldByName('tipo_nf').AsString = 'V') then
    begin
      if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
        raiseExceptionCreate('Devolução de nota fiscal de veículos deve ser feita através de um comando de faturamento', 'dbgrid1')
      else
        incluirNf( tnfVeiculos, 'P', 'E');
    end
    else if (dataSet.FieldByName('tipo_nf').AsString = 'O') then
    begin
      if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
        incluirNf( tnfOutras, 'O', 'S')
      else
        incluirNf( tnfOutras, 'O', 'E');
    end
    else
      raiseExceptionCreate('Tipo de Nota Fiscal não encontrado', 'dbgrid1');

    tribDevHandler := TributosHandler.Create( transacao, tdfoNotaFiscal );
    try
      tribDevHandler.Load( vCodNf, vDadosIni.cod_empresa );
      ignorarOriginal := YesNoEnum(fint('dfe_trib_ignorar'));
      //dataSet.FieldByName('dfe_trib_ignorar').Clear(); Deixa o valor da configuracao, caso tenha IBSCBS nos itens automaticamente esse campo é setado lá

      buscas.Close;
      buscas.SQL.Text := 'select * from notafiscal where cod_nf = ' + IntToStr(vCodNf) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if buscas.IsEmpty then
        raiseExceptionCreate('Nota Fiscal não encontrada', 'dbgrid1');

      vCodNf := buscas.FieldByName('cod_nf').AsInteger;
      sChaveNFe := buscas.FieldByName('chave_nfe').AsString;
      vDevolucaoTotal := AdevTotal; //Application.MessageBox('Devolução total de mercadoria', 'Atenção',
        //MB_ICONQUESTION + MB_YESNO) = IDYES;

      dataSet.FieldByName('cod_cliente').AsInteger := buscas.FieldByName('cod_cliente').AsInteger;
      tempSubstituicao :=
        Application.MessageBox('Esta Nota Fiscal possui Substituição Tributária',
        'Atenção',
        MB_ICONQUESTION + MB_YESNO) = ID_YES;
      if not tempSubstituicao then
        dataSet.FieldByName('CODIGO_NOP').AsInteger := 5202
      else
        dataSet.FieldByName('CODIGO_NOP').AsInteger := 5411;

      dataSet.FieldByName('aliq_icm').AsFloat := buscas.FieldByName('aliq_icm').AsInteger;
      dataSet.FieldByName('devolucao').AsString := 'SIM';
      dataSet.FieldByName('tipo_emissao').AsString := '4';
      dataSet.FieldByName('cod_cond_pag').Value := Null;

      buscas.Close;
      buscas.Sql.Text := 'select cod_cliente, tipo from clientes where cod_cliente = '+
        dataSet.FieldByName('cod_cliente').AsString +' and cod_empresa = '+vDadosIni.codEmpresa;
      buscas.Open;
      if (((dataSet.FieldByName('natureza_nf').AsString = 'E') and (buscas.FieldByName('TIPO').AsString <> 'F')) or
        ((dataSet.FieldByName('natureza_nf').AsString = 'S') and (buscas.FieldByName('TIPO').AsString <> 'C'))) and
        (buscas.FieldByName('TIPO').AsString <> 'A') then
      begin
        buscas.close;
        buscas.sql.Text := 'update clientes set tipo = ''A'' where cod_cliente = ' +
          dataSet.FieldByName('cod_cliente').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Prepare;
        buscas.ExecSQL;
      end;
      exitCodigoTabela('CLIENTES');
      dataSet.FieldByName('CODIGO_NOP').AsString :=
        getCfopCorreto(dataSet.FieldByName('CODIGO_NOP').AsString);
      exitCodigoTabela('NAT_OP');

      qrItensDev := Self.Create_new_fb_query(Self.transacao);
      try
        qrItensDev.Close;
        qrItensDev.SQL.Text := 'select * from notafiscal_item where cod_nf = ' + IntToStr(vCodNf) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        qrItensDev.Open;
        if qrItensDev.IsEmpty then
          raiseExceptionCreate('Nota Fiscal sem itens', 'dbgrid1');

        if not vDevolucaoTotal then
        begin
          try
            formulario := TfrmPadrao.Create(Application);
            formulario.Width := 620;
            formulario.Height := 500;
            formulario.Position := poScreenCenter;
            formulario.Caption :=
              'Selecione os Itens que deseja devolver';
            frmCadNF.pnDevolucaoNf.Parent := formulario;
            dtmNF.dsTemp.dataSet := qrItensDev;
            frmCadNF.DBGrid24.DataSource := dtmNF.dsTemp;
            formulario.AutoSize := True;
            formulario.AutoScroll := False;
            formulario.ShowHint := True;
            vOK := (formulario.ShowModal = mrOk);
          finally
            frmCadNF.pnDevolucaoNf.Parent := frmCadNF.tsDevolucaoNf;
            formulario.Free;
            formulario := nil;
          end;
          if not vOK then
            raiseExceptionCreate('Operação cancelada', 'dbgrid1');
        end;

        vItem.CancelUpdates;
        vItem.vDetVeic.CancelUpdates;
        vIntegerTemp:=0;
        qrItensDev.First;
        while not qrItensDev.Eof do
        begin
          vOK := vDevolucaoTotal;
          if not vOK then
            vOK := frmCadNF.DBGrid24.SelectedRows.CurrentRowSelected;
          if vOK then
          begin
            Inc(vIntegerTemp);
            vItem.dataSet.Insert;
            for I := 0 to vItem.dataSet.FieldCount - 1 do
              if vItem.Dataset.Fields[I].FieldKind = fkData then
                if (vItem.dataSet.Fields[i].FieldName <> 'COD_NF') then
                  vItem.dataSet.FieldByName(vItem.dataSet.Fields[i].FieldName).Value :=
                    qrItensDev.FieldByName(vItem.dataSet.Fields[i].FieldName).Value;
            vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat :=
              dataSet.FieldByName('CODIGO_NOP').AsFloat;
            vItem.dataSet.FieldByName('DESC_NATOP').AsString :=
              dataSet.FieldByName('DESC_NATOP').AsString;
            vItem.dataSet.FieldByName('NFE_PDEVOL').AsFloat := 100;
            vItem.dataSet.FieldByName('NFE_VIPIDEVOL').AsFloat :=
              qrItensDev.FieldByName('valor_ipi').AsFloat;
            vItem.dataSet.FieldByName('valor_ipi').AsFloat := 0;
            vItem.dataSet.FieldByName('aliq_ipi').AsFloat := 0;
            vItem.dataSet.FieldByName('base_ipi').AsFloat := 0;
            if (dataSet.FieldByName('natureza_nf').AsString = 'S') and (vDadosIni.vEmp.vRegime = 'SIMPLES') and
              ((vItem.dataSet.FieldByName('valor_icm').AsFloat > 0) or (vItem.dataSet.FieldByName('valor_icmsub').AsFloat > 0)) then
            begin
              vItem.dataSet.FieldByName('cst').AsString := copy(vItem.dataSet.FieldByName('cst').AsString,1,1) + '90';
              vItem.dataSet.FieldByName('csosn').AsString := '900';
            end
            else if vItem.fempty('csosn') then
              vItem.dataSet.FieldByName('csosn').AsString := getCSOSNPorCST(vItem.fstr('cst'), vItem.fstr('csosn'), False);

            vCfop.selecionaCfop(Trunc(vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat));
            vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := vDadosIni.retornoPorCondicao(
              vCfop.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfop.dataSet.FieldByName('ALT_EST').AsString);//vCfop.dataSet.FieldByName('ALT_EST').AsString;
            if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString = 'N' then
              vItem.dataSet.FieldByName('altera_custo_cfop').AsString := 'N'
            else
              vItem.dataSet.FieldByName('altera_custo_cfop').AsString := vCfop.dataSet.FieldByName('calc_custo').AsString;
            vItem.dataSet.FieldByName('tipv_veiculo').AsString := vCfop.dataSet.FieldByName('tipv_veiculo').AsString;
            vItem.dataSet.FieldByName('cod_nf').AsInteger :=
              dataSet.FieldByName('cod_nf').AsInteger;
            vItem.dataSet.FieldByName('nitem').AsInteger :=
              vIntegerTemp;
            vItem.dataSet.FieldByName('COD_NF_DEV').AsInteger := vCodNf;
            vItem.dataSet.FieldByName('nitem_dev').AsInteger :=
              qrItensDev.FieldByName('nitem').AsInteger;

            if FConfig.Conf_Geral.nfs_devolucao_referencia_por_item then 
            begin
              vItem.dataSet.FieldByName('chave_nfe_ref').AsString := sChaveNFe;
              if qrItensDev.FieldByName('nitem_xml').AsInteger > 0 then            
                vItem.dataSet.FieldByName('nitem_nfe_ref').AsInteger := qrItensDev.FieldByName('nitem_xml').AsInteger
              else
                vItem.dataSet.FieldByName('nitem_nfe_ref').AsInteger := qrItensDev.FieldByName('nitem').AsInteger;
            end;
                        
            if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '0' then
              vItem.dataSet.FieldByName('cst_ipi').AsString := '5' +
                Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
            else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '5' then
              vItem.dataSet.FieldByName('cst_ipi').AsString := '0' +
                Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
            else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '4' then
              vItem.dataSet.FieldByName('cst_ipi').AsString := '9' +
                Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1)
            else if Copy(Trim(vItem.dataSet.FieldByName('cst_ipi').AsString),1,1) = '9' then
              vItem.dataSet.FieldByName('cst_ipi').AsString := '4' +
                Copy(vItem.dataSet.FieldByName('cst_ipi').AsString,2,1);
            vItem.dataSet.FieldByName('ncupom').Value :=  Null;
            vItem.dataSet.FieldByName('terminal').Value := Null;
            vItem.dataSet.FieldByName('nserieecf').Value := Null;
            vItem.dataSet.FieldByName('data_cupom').Value := Null;
            vItem.dataSet.FieldByName('cod_nfce').Value :=  Null;
            vItem.dataSet.FieldByName('antec_trib').Value := Null;
            vItem.dataSet.FieldByName('nped').Value := Null;
            vItem.dataSet.FieldByName('tipo_ped').Value := Null;
            vItem.dataSet.FieldByName('nitem_ped').Value := Null;
            vItem.dataSet.FieldByName('dfe_trib_id').Value := Null;
            vItem.dataSet.FieldByName('dfe_trib_id_xml').Value := Null;
            vItem.dataSet.FieldByName('VBCUFDEST').AsFloat := 0;
            vItem.dataSet.FieldByName('PFCPUFDEST').AsFloat := 0;
            vItem.dataSet.FieldByName('PICMSUFDEST').AsFloat := 0;
            vItem.dataSet.FieldByName('PICMSINTER').AsFloat := 0;
            vItem.dataSet.FieldByName('PICMSINTERPART').AsFloat := 0;
            vItem.dataSet.FieldByName('VFCPUFDEST').AsFloat := 0;
            vItem.dataSet.FieldByName('VICMSUFDEST').AsFloat := 0;
            vItem.dataSet.FieldByName('VICMSUFREMET').AsFloat := 0;
            vItem.dataSet.FieldByName('FCP_VBCFCPUFDEST').AsFloat := 0;

            dataSet.FieldByName('VALOR_DESC').AsFloat :=
              dataSet.FieldByName('VALOR_DESC').AsFloat +
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat;

            tributoIdDev := StrDefault(
              qrItensDev.FieldByName('dfe_trib_id_xml').AsString, // original do fornecedor
              qrItensDev.FieldByName('dfe_trib_id').AsString
            );

            tribDevCtx := tribDevHandler.GetItem( tributoIdDev );
            try
              if tribDevCtx <> nil then
              begin
                tribDevCtx.Id := NewGuid();
                tribDevCtx.Origem := tdfoNotaFiscal;
                if tribDevCtx.IbsCbs <> nil then
                begin
                  tribDevCtx.IbsCbs.RegraFiscalId := StringNullable.NullInstance();
                  tribDevCtx.IbsCbs.TipoRegra := tctNenhuma;
                end;

                vItem.dataSet.FieldByName('dfe_trib_id').AsString := tribDevCtx.Id;
                vItem.FTributos.SetItem( tribDevCtx.Id, tribDevCtx );

                dataSet.FieldByName('dfe_trib_ignorar').AsInteger := Ord(ynNo);
              end;

            finally
              tribDevCtx.Free();
            end;

            vItem.dataSet.Post;
          end;
          qrItensDev.Next;
        end;

        vItem.dataSet.First;
        if (dataSet.fieldbyname('tipo_nf').AsString = 'V') then
          while not vItem.dataSet.Eof do
          begin
            qrItensDev.Close;
            qrItensDev.SQL.Text := 'select * from notafiscal_item_veiculo' +
              ' where cod_nf = ' + IntToStr(vCodNf) +
              ' and nitem = ' + vItem.dataSet.FieldByName('nitem').AsString +
              ' and cod_empresa = ' + vDadosIni.codEmpresa;
            qrItensDev.Open;
            vItem.vDetVeic.dataSet.Insert;
            for I := 0 to vItem.vDetVeic.dataSet.FieldCount - 1 do
              if (vItem.vDetVeic.dataSet.Fields[i].FieldName <> 'COD_NF') then
                vItem.vDetVeic.dataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[i].FieldName).Value
                  :=
                  qrItensDev.FieldByName(vItem.vDetVeic.dataSet.Fields[i].FieldName).Value;

            vItem.vDetVeic.dataSet.FieldByName('cod_nf').AsInteger :=
              dataSet.FieldByName('cod_nf').AsInteger;
            vItem.vDetVeic.dataSet.Post;
            vItem.dataSet.Next;
          end;
        if dataSet.FieldByName('natureza_nf').AsString = 'E' then
        begin
          validaDesconto('N');

          somaTotaisNF;
          if dataSet.State in [dsInsert, dsEdit] then
          begin
            dataSet.FieldByName('base_icm').AsCurrency := FCalculoImposto.vBaseICMS;
            dataSet.FieldByName('valor_icm').AsCurrency := FCalculoImposto.vValorICM;
            dataSet.FieldByName('base_icmsub').AsCurrency := FCalculoImposto.vBaseICMSSub;
            dataSet.FieldByName('valor_icmsub').AsCurrency := FCalculoImposto.vValorICMSub;
            dataSet.FieldByName('base_ipi').AsCurrency := FCalculoImposto.vBaseIPI;
            dataSet.FieldByName('valor_ipi').AsCurrency := FCalculoImposto.vValorIPI;
            dataSet.FieldByName('valor_prod').AsCurrency := FCalculoImposto.vValorProdutos;
            dataSet.FieldByName('valor_serv').AsCurrency := FCalculoImposto.vValorServicos;
            dataSet.FieldByName('valor_total').AsCurrency := FCalculoImposto.vValorLiquidoNF;
          end;
        end;
        Result := True;

      finally
        FreeAndNil(qrItensDev);
      end;
    finally
      tribDevHandler.FreeSafe();
    end;

    if (YesNoEnum(fint('dfe_trib_ignorar')) = ynNo) and (ignorarOriginal = ynYes) then
      ShowAtencao(
        'Os dados dos tributos da RTC foram encontrados e copiados para devolução' + sLineBreak +
        'Caso não seja o caso de devolver esses tributos, marque a opção para Ignorar os tributos da RTC'
      );
  except
    on e: exception do
    begin
      Result := False;
      if vItem.dataSet.Active then
      begin
        vItem.dataSet.Cancel;
        vItem.dataSet.CancelUpdates;
      end;
      dataSet.Cancel;
      dataSet.CancelUpdates;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TNFCab.edit: boolean;
var
  I: Integer;
  vDataeHora: TDateTime;
  AsendMail, AcomBol: Boolean;
  dFormat: string;
begin
  result := False;
  fValorNotaAlterado := False;
  vDadosIni.atualizarVariaveisEmpresa(buscas);
  try
    if (not vDadosIni.vSistemasUsuario.vSisVeiculos) or (not
      vDadosIni.vSistemasUsuario.vSisAutomacao) then
    begin
      if (not vDadosIni.vSistemasUsuario.vSisAutomacao) and (dataSet.FieldByName('tipo_nf').AsString
        = 'P') then
        raiseExceptionCreate('Nota Fiscal de Produtos/Serviços não permitido para este usuário.(Senhas[Automação])',
          '');
      if (not vDadosIni.vSistemasUsuario.vSisVeiculos) and (dataSet.FieldByName('tipo_nf').AsString =
        'V') then
        raiseExceptionCreate('Nota Fiscal de Veículo não permitido para este usuário.(Senhas[Veículos])', '');
    end;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;
  end;
  dataSet.RefreshRecord;
  if dataSet.FieldByName('natureza_nf').AsString = 'E' then
  begin
    if dataSet.FieldByName('tipo_nf').AsString = 'P' then
      if not vDadosIni.PesqPros('NF0011', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'V' then
      if not vDadosIni.PesqPros('NF0012', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'O' then
      if not vDadosIni.PesqPros('NF0013', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'D' then
      if not vDadosIni.PesqPros('NF0014', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'S' then
      if not vDadosIni.PesqPros('NF0174', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
  end
  else
  begin
    if dataSet.FieldByName('tipo_nf').AsString = 'P' then
      if not vDadosIni.PesqPros('NF0015', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'V' then
      if not vDadosIni.PesqPros('NF0016', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
    if dataSet.FieldByName('tipo_nf').AsString = 'O' then
      if not vDadosIni.PesqPros('NF0017', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
        dataSet.FieldByName('cod_nf').AsString,
        buscas, True) then
        exit;
  end;
  if (Trim(dataSet.FieldByName('NATUREZA_NF').AsString) = 'E') and
    (Trim(dataSet.FieldByName('EMISSAO_PROPRIA').AsString) = 'S') and
    (get_status = stsAberta) then
  begin
    if (get_situacao_nfe = sitAutorizada) then
      Application.MessageBox('Nota Fiscal já autorizada no Web Service. Aguardando confirmação no sistema', 'Atenção', 64)
    else if (get_situacao_nfe = sitInutilizada) then
    begin
      Application.MessageBox('Nota Fiscal Inutilizada no Web Service. Aguardando cancelamento no sistema', 'Atenção', 64);
      Exit;
    end
    else if (get_situacao_nfe = sitDenegada) then
    begin
      Application.MessageBox('Nota Fiscal Denegada no Web Service. Aguardando cancelamento no sistema', 'Atenção', 64);
      Exit;
    end
    else if (get_situacao_nfe = sitCancelada) then
    begin
      Application.MessageBox('Nota Fiscal Cancelada no Web Service. Aguardando cancelamento no sistema', 'Atenção', 64);
      Exit;
    end;
  end;
  if (get_situacao_nfe = sitAInutilizar) then
  begin
    Application.MessageBox('Nota Fiscal está marcada para Inutilização. Acesso o Módulo da NFe, efetue a Inutilização da NFe e cancele a nota no sistema', 'Atenção', 64);
    Exit;
  end
  else if (Trim(dataSet.FieldByName('tiponfe').AsString) = 'DPEC') and
    (Trim(dataSet.FieldByName('nfe_dpec_nregdpec').AsString) <> '') and
    (dataSet.FieldByName('natureza_nf').AsString = 'S') then
  begin
    if vDadosIni.strIn(Trim(vDadosIni.vEmp.vNfe.danfeFormaEmissao), ['NORMAL']) then
    begin
      if (dataSet.FieldByName('codigoerro').AsString = '') then//tentar env
      begin
        vDadosIni.ShowAtencao('Nota fiscal em DPEC/EPEC. Envie para a SEFAZ de Origem');// = IDYES then

        AsendMail := True;
        AcomBol   := _LerConfiguracoesRegistroBoolean('SendMailComBoleto', True);

        if enviarNotaFiscalEletronica(AsendMail, AcomBol) then
          if dataSet.FieldByName('natureza_nf').AsString = 'S' then
          begin
            verificarImpressaoBoleto;
            if AsendMail then
              emailNFe(AcomBol);
          end;
        _GravaConfiguracoesBoolean('SendMailComBoleto', AcomBol);
        Exit;
      end;
    end
    else
      vDadosIni.ShowAtencao('Nota fiscal em DPEC/EPEC favor enviar para SEFAZ de Origem');
  end;

  _atualizarSituacaoPedidos('Finalizado', False, True);

  FDadosNFDevolvida := '';
  Result := inherited edit;
  if Result then
  begin

    FConfig.ExecutarLeitura(f_str('natureza_nf'));
    FConfig.versao_calc := IfThen(f_str('tipo_nf') <> 'P', 1, FConfig.versao_calc);

    if Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) = '' then
      dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'S';
    if dataSet.FieldByName('cod_nf_rem_vfe').AsInteger > 0 then
      dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString := 'N';

    if fequals('natureza_nf', 'S') and fempty('totais_com_deson') then
      dataSet.FieldByName('totais_com_deson').AsString := 'S';

    if (vDadosIni.vEmp.vRegime = 'SIMPLES') then
    begin
      dataSet.FieldByName('crt').AsString := '1';
      dataSet.FieldByName('aliq_icm_simples').AsFloat := vDadosIni.vEmp.vAliqSimplesICM;
    end
    else if pos('SIMPLES / EXCESSO', vDadosIni.vEmp.vRegime) > 0 then
      dataSet.FieldByName('crt').AsString := '2'
    else
      dataSet.FieldByName('crt').AsString := '3';

    if fequals('emissao_propria', 'S') and fempty('tpimp') then
    begin
      dataSet.FieldByName('tpimp').AsInteger := IndexText(vDadosIni.vEmp.vNfe.danfeTipo, FormatoImpressaoDANFeEnumStr); // Obtem o indice correspondente
      dataSet.FieldByName('tpimp').AsInteger := IfThen( fint('tpimp') = -1, Ord(fidRetrato)); // Caso valor seja inválido
    end;

    if fempty('dfe_trib_ignorar') then
      dataSet.FieldByName('dfe_trib_ignorar').AsInteger := IfThen( not Config.Conf_RTC.EmVigencia(vDadosIni.vEmp.vRegime), 1);

    vAcao := 'EDITAR';
//    vTempAuditoria := 'NF NUM/SERIE: ' + vDadosIni.StrZero(dataSet.FieldByName('NUM_NF').AsInteger,
//      7) +
//      '/' + Trim(dataSet.FieldByName('SERIE').AsString);
    vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
    vCfop.selecionaCfop(dataSet.FieldByName('codigo_nop').AsInteger);
    vClFor.selecionaClFor();
    vClFor.CodCliente := dataSet.FieldByName('cod_cliente').AsInteger;
    vClFor.DestSeqID := dataSet.FieldByName('dest_seqid').AsInteger;
    FpagNFe.selecionaPag;
    FdupNFe.selecionaDup;
    Fcoleta.selecionaColEnt;
    Fentrega.selecionaColEnt;
    FobsCont.selecionaCamposAd;
    Fdefensivo.Open();
    FguiaTransito.Open();
    vCPag.abreCondPag(dataSet.FieldByName('natureza_nf').AsString[1]);
    vTr.selecionaTransportador(dataSet.FieldByName('codigo_tr').AsInteger);
    vCol.abreUsuarios;
    vSped.vC110.abreC110(dataSet.FieldByName('cod_nf').AsInteger);
    vSped.vC120.abreC120(dataSet.FieldByName('cod_nf').AsInteger);
    vSped.vC195_C197.abreC195_C197(dataSet.FieldByName('cod_nf').AsInteger);
    vSped.VerificarAjustesAutoAposConfirmacao;
    helperConv.LoadUnidades;

    vBaixaPedidos.clearData;
    vCidadesIBGE.Close;
    vCidadesIBGE.CommandText := 'select * from cidades_ibge order by nome_municipio';
    vCidadesIBGE.Open;

    Fcalc_fat.inicializar;

    if get_status = stsPreNota then
    begin
      if (dataSet.FieldByName('COD_NF_TRANSF').AsInteger > 0) and
        (dataSet.FieldByName('COD_EMP_TRANSF').AsInteger > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select status, natureza_nf, modelo_nf, situacao_nfe, chave_nfe from notafiscal' +
          ' where cod_nf = ' + IntToStr(dataSet.FieldByName('COD_NF_TRANSF').AsInteger) +
          ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('COD_EMP_TRANSF').AsInteger);
        buscas.Open;

        if not buscas.IsEmpty then
        begin
          if Trim(buscas.FieldByName('status').AsString) <> stsFechada then
          begin
            dataSet.Cancel;
            dataSet.CancelUpdates;
            raiseExceptionCreate('Nota Fiscal que originou esta Pré Nota não esta Fechada', '');
          end;
          if Trim(buscas.FieldByName('natureza_nf').AsString) = 'S' then
            if Trim(buscas.FieldByName('modelo_nf').AsString) = '55' then
              if Trim(buscas.FieldByName('situacao_nfe').AsString) <> sitAutorizada then
              begin
                dataSet.Cancel;
                dataSet.CancelUpdates;
                raiseExceptionCreate('Nota Fiscal que originou esta Pré Nota não esta Autorizada', '');
              end;
        end;
        if (Trim(dataSet.FieldByName('chave_nfe').AsString) = '') and
          (Trim(buscas.FieldByName('chave_nfe').AsString) <> '') then
          dataSet.FieldByName('chave_nfe').AsString := buscas.FieldByName('chave_nfe').AsString;
      end;
      vDataeHora := vDadosIni.getDataHoraBanco(buscas);

      buscas.Close;
      buscas.SQL.Text := 'select cod_vendedor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(vDadosIni.vCodUsuario) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if buscas.FieldByName('cod_vendedor').AsInteger = 0 then
      begin
        dataSet.Cancel;
        dataSet.CancelUpdates;
        raiseExceptionCreate('Usuário não encontrado no cadastro dos colaboradores', '');
      end;

      dataSet.FieldByName('data_ent_saida').AsDateTime := DateOf(vDataeHora);
      dataSet.FieldByName('hora_ent_saida').AsDateTime := TimeOf(vDataeHora);
      dataSet.FieldByName('cod_vendedor').AsInteger := vDadosIni.vCodUsuario;
      dataSet.FieldByName('cod_usuario').AsInteger := vDadosIni.vCodUsuario;
      dataSet.FieldByName('status').AsString := stsAberta;
      dataSet.FieldByName('DA').Value := Null;

      _verificarProdutoSemVinculoPreNota;
      
    end;

    setVariavelStatusNf;
    if (DataSet.FieldByName('modelo_nf').AsString = '55') and
      (DataSet.FieldByName('emissao_propria').AsString = 'S') and
      (DataSet.FieldByName('natureza_nf').AsString = 'S') then
    begin
      if not vStatusFechada then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select cod_nf from boletas where cod_nf = ' +
          IntToStr(dataSet.FieldByName('cod_nf'). AsInteger) +
          ' and cod_empresa = ' + dataSet.FieldByName('COD_EMPRESA').AsString;
        buscas.Open;

        if buscas.FieldByName('cod_nf').AsInteger = dataSet.FieldByName('cod_nf').AsInteger then
        begin                                              
          ExecutaComandosSqlExec('delete from boletas where cod_nf = ' +
            IntToStr(dataSet.FieldByName('cod_nf').AsInteger) +
            ' and cod_empresa = ' + dataSet.FieldByName('COD_EMPRESA').AsString);
        end
        else
        begin
          ExecutaComandosSqlExec('delete from boletas where num_nf_vnd = ' +
            dataSet.FieldByName('num_nf').AsString +
            ' and cod_empresa = ' + dataSet.FieldByName('COD_EMPRESA').AsString + ' and sub_serie = '
            + Trim(dataSet.FieldByName('SERIE').AsString));
        end;

        buscas.Close;
        buscas.SQL.Text := 'update EQUIPAMENTO' +
          ' set STATUS_V = ''N'', DATA_VEN = null, COD_NF_SAI = null, NITEM_SAI = null ' +
          ' WHERE COD_EMPRESA = ' + vDadosIni.CodEmpresa +
          ' and COD_NF_SAI = ' + IntToStr(vItem.dataSet.FieldByName('COD_NF').AsInteger) +
          ' and NITEM_SAI = ' + IntToStr(vItem.dataSet.FieldByName('NITEM').AsInteger);
        buscas.ExecSQL;
      end;
    end;

    if (Trim(dataSet.FieldByName('SERIE_COMPL').AsString) <> '') and
      (dataSet.FieldByName('NUM_NF_COMPL').AsInteger > 0) then
    begin
      dataSet.FieldByName('SERIE_EMT').AsString := '0';
      dataSet.FieldByName('NUM_NF_EMT').AsInteger := 0;
    end;

    dFormat := DisplayNumber(IfThen(fequals('natureza_nf', 'E'), 6, IfThen(vDadosIni.vEmp.vCasasDecimais > 0, vDadosIni.vEmp.vCasasDecimais, 2)));
    TFloatField(vItem.dataSet.FieldByName('valor_unitario')).DisplayFormat := dFormat;
    TFloatField(vItem.dataSet.FieldByName('vvnd')).DisplayFormat := dFormat;
    TFloatField(vItem.dataSet.FieldByName('vlrembnf')).DisplayFormat := dFormat;

    dFormat := DisplayNumber(3);
    TFloatField(vItem.dataSet.FieldByName('quantidade')).DisplayFormat := dFormat;
    TFloatField(vItem.dataSet.FieldByName('qvnd')).DisplayFormat := dFormat;
    TFloatField(vItem.dataSet.FieldByName('qtdembrec')).DisplayFormat := dFormat;
    TFloatField(vItem.dataSet.FieldByName('qtdemb')).DisplayFormat := '';

    setCFOPDevolucao;

    handleUpdataVersionData;

    vItem.cancelar;
    if notaFechada then
      dataSet.Cancel
    else if GetVersaoNFe <> vnf400 then
    begin
      dataSet.FieldByName('NFE_VERSAO').AsString := strVer400;
      dataSet.FieldByName('NFE_TPEMIS').AsString := IfThen(vDadosIni.vEmp.vNfe.danfeFormaEmissao = 'SVC', '6', '1');
      dataSet.FieldByName('NFE_TPAMB').AsString := IfThen(vDadosIni.vEmp.vNfe.webServiceAmbiente = 'Produção', '1', '2');
    end;

//    else if ((Trim(DataSet.FieldByName('NFE_DPEC_NREGDPEC').AsString) <> '') and
//      (Trim(DataSet.FieldByName('tiponfe').AsString) = 'DPEC')) then
//      dataSet.Cancel;
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
    begin
      Fdespesa := false;
      if (vDadosIni.vEmp.vNfe.modeloNF = '55') and (vDadosIni.vEmp.vNfe.usarServico <> 'S') and
        (dataSet.FieldByName('tipo_nf').AsString = 'P') then
      begin
        Fproduto := dataSet.FieldByName('modelo_nf').AsString = vDadosIni.vEmp.vNfe.modeloNF;
        Fservico := dataSet.FieldByName('modelo_nf').AsString = vDadosIni.vEmp.vNfe.modeloNFServico;
        Fveiculo := false;
        Foutras := false;
      end
      else
      begin
        Fproduto := dataSet.FieldByName('tipo_nf').AsString = 'P';
        Fservico := dataSet.FieldByName('tipo_nf').AsString = 'P';
        Fveiculo := dataSet.FieldByName('tipo_nf').AsString = 'V';
        Foutras := dataSet.FieldByName('tipo_nf').AsString = 'O';
      end;
      vItem.CalcIcmsSTEntNF_Cst60 := False;
    end
    else // if dataSet.FieldByName('natureza_nf').AsString = 'E' then
    begin
      Fproduto := dataSet.FieldByName('tipo_nf').AsString = 'P';
      Fservico := fstrin('tipo_nf', ['P', 'S']);
      Fveiculo := dataSet.FieldByName('tipo_nf').AsString = 'V';
      Foutras := dataSet.FieldByName('tipo_nf').AsString = 'O';
      Fdespesa := dataSet.FieldByName('tipo_nf').AsString = 'D';

      vFaturasXML.Text :=  dataSet.FieldByName('DUP_XML_ENTRADA').AsString;
      vItem.CalcIcmsSTEntNF_Cst60 := vDadosIni.getConfSisBool('nf_e_hab_cst_60_calculo_st_icms', buscas);
    end;
//    FCSTCSOSNNaoCalcularICMSInterestadual := '|' + vDadosIni.getConfSisStr('nf_zerar_icms_interestadual_cst_csosn', buscas) + '|';
//    FConfigFrete := vDadosIni.getConfSisBlob('nf_s_config_frete', buscas);
    FFatura.moraDiaria := 0;
    FFatura.multa := 0;
    FFatura.localPagamento := '';
    FFatura.obs1 := '';
    FFatura.obs2 := '';
    FFatura.parcelas := 0;
    FFatura.somaFaturas := 0;
    SetLength(FFatura.vencimentoDocumento, 0);
    SetLength(FFatura.numeroDocumento, 0);
    SetLength(FFatura.valorDocumento, 0);
    SetLength(FFatura.numVenda, 0);
    SetLength(FFatura.tipoVenda, 0);
    SetLength(FFatura.referenteFrete, 0);
    SetLength(FFatura.codControles, 0);
    vItem.vProd.NaturezaNF := dataSet.FieldByName('natureza_nf').AsString;
    if dataSet.FieldByName('tipo_nf').AsString = 'P' then
      for I := Low(vItem.campos) to High(vItem.campos) do
        vItem.campos[i] := camposProdServ[i];
    if dataSet.FieldByName('tipo_nf').AsString = 'O' then
      for I := Low(vItem.campos) to High(vItem.campos) do
        vItem.campos[i] := camposOutras[i];
    for I := Low(vItem.campos) to High(vItem.campos) do
      campos[i] := vItem.campos[i];

  end;
end;

function TNFCab.editaVeiculoAnotaFiscal: boolean;
begin

  vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
  vItem.vDetVeic.selecionaDetalheVeiculo(dataSet.FieldByName('cod_nf').AsInteger);

  dataSet.FieldByName('cod_cond_pag').AsInteger :=
    vComFat.dataSet.FieldByName('condpag_v').AsInteger;
  dataSet.FieldByName('codigo_nop').AsFloat :=
    vComFat.dataSet.FieldByName('natop_v').AsFloat;
  dataSet.FieldByName('desc_natop').AsString := '';
  exitCodigoTabela('NAT_OP');
  dataSet.FieldByName('aliq_icm').AsFloat :=
    vComFat.dataSet.FieldByName('alicm_v').AsFloat;
  dataSet.FieldByName('valor_frete').AsFloat :=
    vComFat.dataSet.FieldByName('frete_v').AsFloat;
  dataSet.FieldByName('valor_seguro').AsFloat :=
    vComFat.dataSet.FieldByName('seguro_v').AsFloat;
  dataSet.FieldByName('valor_out_desp').AsFloat :=
    vComFat.dataSet.FieldByName('outdesp_v').AsFloat;
  dataSet.FieldByName('cod_cliente').AsInteger :=
    vComFat.dataSet.FieldByName('clientes_v').AsInteger;

  //notafiscal_item
  vItem.Edit;
  vItem.dataSet.FieldByName('chassi').AsString := vComFat.dataSet.FieldByName('chassiv').AsString;
  vItem.dataSet.FieldByName('codigo_nop').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
  vItem.dataSet.FieldByName('num_fab_prod').AsString :=
    vComFat.dataSet.FieldByName('chassiv').AsString;
  vItem.dataSet.FieldByName('desc_natop').AsString := dataSet.FieldByName('desc_natop').AsString;
  vItem.dataSet.FieldByName('cst').AsString := vComFat.dataSet.FieldByName('cst_v').AsString;
  vitem.vrDadosItem.preco_compra_veiculo :=
    vComFat.vItem.dataSet.FieldByName('precocompra').AsFloat;
  vItem.dataSet.FieldByName('valor_unitario').AsFloat :=
    vDadosIni.StrToFloatFormat(vComFat.dataSet.FieldByName('PRVEN_V').AsFloat, 2);
  vItem.dataSet.FieldByName('valor_total').AsFloat :=
    vItem.dataSet.FieldByName('valor_unitario').AsFloat;
  if (vDadosIni.vEmp.vUsarReducaoInvertida = 'S') and (vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat > 0) then
    vItem.dataSet.FieldByName('perc_red_prod').AsFloat :=
        100 - vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat
  else
    vItem.dataSet.FieldByName('perc_red_prod').AsFloat :=
      vComFat.dataSet.FieldByName('PERC_RED_V').AsFloat;
  vItem.dataSet.FieldByName('aliq_icm').AsFloat := vComFat.dataSet.FieldByName('ALICM_V').AsFloat;
  vItem.vrDadosItem.red_lucro := vComFat.vItem.dataSet.FieldByName('RED_LUCRO').AsString;
  if vItem.dataSet.FieldByName('aliq_icm').AsFloat > 0 then
  begin
    if vItem.vrDadosItem.red_lucro = 'S' then
    begin
      vItem.dataSet.FieldByName('cst').AsString := copy(vItem.dataSet.FieldByName('cst').AsString, 1, 1) + '20';
      vItem.dataSet.FieldByName('base_icm').AsFloat := vDadosIni.StrToFloatFormat(
        vItem.dataSet.FieldByName('valor_total').AsFloat - vItem.vrDadosItem.preco_compra_veiculo, 2);
      if vItem.dataSet.FieldByName('perc_red_prod').AsFloat > 0 then
        vItem.dataSet.FieldByName('base_icm').AsFloat :=
          vItem.dataSet.FieldByName('base_icm').AsFloat *
          (100 - vItem.dataSet.FieldByName('perc_red_prod').AsFloat) / 100;
      if vItem.dataSet.FieldByName('base_icm').AsFloat < 0 then
        vItem.dataSet.FieldByName('base_icm').AsFloat := 0;
      if vItem.dataSet.FieldByName('base_icm').AsFloat = 0 then
      begin
        vItem.dataSet.FieldByName('perc_red_prod').AsFloat := 0;
        vItem.dataSet.FieldByName('cst').AsString := copy(vItem.dataSet.FieldByName('cst').AsString, 1, 1) + '41';
      end;
    end
    else
    begin
      vItem.dataSet.FieldByName('base_icm').AsFloat :=
        vItem.dataSet.FieldByName('valor_total').AsFloat;
      if vItem.dataSet.FieldByName('perc_red_prod').AsFloat > 0 then
        vItem.dataSet.FieldByName('base_icm').AsFloat :=
          vItem.dataSet.FieldByName('base_icm').AsFloat *
          (100 - vItem.dataSet.FieldByName('perc_red_prod').AsFloat) / 100;
    end;
  end;
