function TNotafiscal_item_dados.verificaTributacaoAdicional(Acliente,
  AdestSeqId: Integer; Acontribuinte, ApessoaJuridica,
  AconsumidorFinal: Boolean): Boolean;
var
  sqlContribuinte, sqlPessoa, sqlConsumidorFinal, sqlFinalidade: string;
begin
  Result := False;
  if Assigned(FtribAd) then
    FreeAndNil(FtribAd);

  try
    sqlContribuinte    := ' and ((pf.contribuinte = ''Ambos'') or (pf.contribuinte = ' + QuotedStr(IfThen(Acontribuinte, 'Sim', 'Nao')) + '))';
    sqlPessoa          := ' and ((pf.pessoa = ''Ambos'') or (pf.pessoa = ' + QuotedStr(IfThen(ApessoaJuridica, 'PJ', 'PF')) + '))';
    sqlConsumidorFinal := ' and ((pf.consumidor_final = ''Ambos'') or (pf.consumidor_final = ' + QuotedStr(IfThen(AconsumidorFinal, 'Sim', 'Nao')) + '))';
    sqlFinalidade      := Format(' and coalesce(pf.finalidadeid, %d) = %d', [FOwerNF.fint('finalidadeid'), FOwerNF.fint('finalidadeid')]);

    if FOwerNF.SqlOpen('select first 1 %s from produtos_trib_ad ad' +
                       ' inner join produtos_trib_pf pf on ad.cod_trib_pf = pf.cod_trib_pf and ad.cod_empresa = pf.cod_empresa and pf.ativo = 1' +
                       ' inner join clientes_trib_ad ct on ct.cod_cliente = %d and ct.cod_empresa = ad.cod_empresa and' +
                       '   ct.end_doc_add_seqid = %d and ct.cod_trib_pf = ad.cod_trib_pf' +
                       ' where ad.grupo_prod = %d and ad.cod_prod = %s and ad.cod_empresa = %s' +
                       sqlContribuinte + sqlPessoa + sqlConsumidorFinal + sqlFinalidade + ' and pf.ativo = 1',
                       [TProdutos_trib_pf_class.GetFieldsSql('pf'), Acliente, AdestSeqId, grupo_prod,
                        QuotedStr(cod_prod), vDadosIni.codEmpresa]).IsEmpty then
      Exit
    else
    begin
      FtribAd := TProdutos_trib_pf_class.Create;
      FtribAd.SetValuesFrom(FOwerNF.buscas);
      if (FtribAd.usar_mva_anexoxv = 'S') and FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
        if getDadosSubstituicaoTributaria(FOwerNF.getUFdaOperacao,
          FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.GetRamoAtividade(FOwerNF.fstr('natureza_nf'), FOwerNF.fstr('cpfcgc'))) then
          if AjustarMVA then
            FtribAd.mva := ExecutarAjusteMVA(FMVA, FtribAd.aliq_inter, FtribAd.aliq_intra)
          else
            FtribAd.mva := FMVA;
      Result := True;
    end;

  finally
    FOwerNF.buscas.Close;
  end;
end;

function TNotafiscal_item_dados.verificaTributacaoAdicional(Auf: string;
  Acontribuinte, ApessoaJuridica, AconsumidorFinal: Boolean): Boolean;
var
  sqlContribuinte, sqlPessoa, sqlConsumidorFinal, sqlFinalidade: string;
begin
  Result := False;
  if Assigned(FtribAd) then
    FreeAndNil(FtribAd);

  try
    sqlContribuinte    := ' and ((pf.contribuinte = ''Ambos'') or (pf.contribuinte = ' + QuotedStr(IfThen(Acontribuinte, 'Sim', 'Nao')) + '))';
    sqlPessoa          := ' and ((pf.pessoa = ''Ambos'') or (pf.pessoa = ' + QuotedStr(IfThen(ApessoaJuridica, 'PJ', 'PF')) + '))';
    sqlConsumidorFinal := ' and ((pf.consumidor_final = ''Ambos'') or (pf.consumidor_final = ' + QuotedStr(IfThen(AconsumidorFinal, 'Sim', 'Nao')) + '))';
    sqlFinalidade      := Format(' and coalesce(pf.finalidadeid, %d) = %d', [FOwerNF.fint('finalidadeid'), FOwerNF.fint('finalidadeid')]);

    if FOwerNF.SqlOpen('select first 1 ' + TProdutos_trib_pf_class.GetFieldsSql('pf') +
                       ' from produtos_trib_ad ad' +
                       ' inner join produtos_trib_pf pf on ad.cod_trib_pf = pf.cod_trib_pf and ad.cod_empresa = pf.cod_empresa and pf.ativo = 1' +
                       ' where ad.grupo_prod = ' + IntToStr(grupo_prod) +
                       ' and ad.cod_prod = ' + QuotedStr(cod_prod) +
                       ' and ad.cod_empresa = ' + vDadosIni.codEmpresa +
                       ' and pf.sigla_uf like ' + QuotedStr('%' + Auf + '|%') +
                       sqlContribuinte + sqlPessoa + sqlConsumidorFinal + sqlFinalidade +
                       ' and pf.ativo = 1').IsEmpty then
      Exit
    else
    begin
      FtribAd := TProdutos_trib_pf_class.Create;
      FtribAd.SetValuesFrom(FOwerNF.buscas);
      if (FtribAd.usar_mva_anexoxv = 'S') and FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
        if getDadosSubstituicaoTributaria(FOwerNF.getUFdaOperacao,
          FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.GetRamoAtividade(FOwerNF.fstr('natureza_nf'), FOwerNF.fstr('cpfcgc'))) then
          if AjustarMVA then
            FtribAd.mva := ExecutarAjusteMVA(FMVA, FtribAd.aliq_inter, FtribAd.aliq_intra)
          else
            FtribAd.mva := FMVA;
      Result := True;
    end;

  finally
    FOwerNF.buscas.Close;
  end;
end;

function TNotafiscal_item_dados.ExecutarAjusteMVA(mvaValue, aliqInterValue,
  aliqIntraValue: Double): Double;
begin
  if (aliqIntraValue <= aliqInterValue) or (mvaValue <= 0) or (aliqInterValue <= 0) or (aliqIntraValue <= 0) then
    Result := mvaValue
  else if (FOwerNF.fequals('natureza_nf', 'E') and (FOwerNF.vClFor.fequals('REGIME', sInfCplSIMPLES))) or
          (FOwerNF.fequals('natureza_nf', 'S') and (vDadosIni.vEmp.vRegime = sInfCplSIMPLES)) or
          (FOwerNF.fequals('nfe_iddest', '2')) then
    Result := mvaValue
  else
    Result := (( (1 + (mvaValue / 100)) * ((1 - (aliqInterValue / 100)) / (1 - (aliqIntraValue / 100))) ) - 1 ) * 100;
end;

procedure TNotafiscal_item_dados.CheckNCM(value: string);
begin
  if FOwerNF.fequals('emissao_propria', 'S') and FOwerNF.fequals('modelo_nf', '55') then
    if Trim(value) = '' then
      FOwerNF.raiseExceptionCreate('Item %d - NCM de preenchimento obrigatório', [nitem])
    else if (not FOwerNF.fequals('tipo_emissao', '3')) and (not MatchStr(tipo_item, ['S', 'D', 'O'])) and (Trim(value) = '00') then
      FOwerNF.raiseExceptionCreate('Item %d - NCM=00 informado indevidamente', [nitem])
    else
    begin
      case StrLength(value) of
        8: ;
        else
        begin
          if (not MatchStr(tipo_item, ['S', 'D', 'O'])) then
            FOwerNF.raiseExceptionCreate('Item %d - NCM deve conter 8 dígitos - %sd', [nitem, value])
          else if (not MatchStr(Trim(value), ['00', '00000000'])) then
            FOwerNF.raiseExceptionCreate('Item %d - NCM inválido. Para serviços ou casos específicos pode ser 00 ou 00000000. Para produtos deve conter 8 dígitos', [nitem]);
        end;
      end;
    end;

  if vDadosIni.vEmp.vGerarSpedPISCOFINS = 'S' then
    if tipo_item = 'O' then
      if (Trim(value) = '00') then
        FOwerNF.raiseExceptionCreate('Item %d - NCM/SH deve ser diferente de "00" para previnir erros no SPED Contribuições', [nitem]);
end;

