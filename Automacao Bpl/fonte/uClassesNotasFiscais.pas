    vComFat.pesquisaComandoFaturamento(0, IntToStr(FComando), '  /  /    ', '  /  /    ');
    if vComFat.dataSet.IsEmpty then
      raise exception.create('Comando Nº ' + IntToStr(FComando) + ' não encontrado ou Cancelado');
    if vComFat.vItem.dataSet.IsEmpty then
      raise exception.create('Não encontrado veículo para o Comando Nº ' + IntToStr(FComando));
