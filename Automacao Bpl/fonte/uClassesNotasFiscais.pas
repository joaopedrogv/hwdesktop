                  dataSet.FieldByName('n_comando').AsString +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and chassiv = ' +
                    QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString);
