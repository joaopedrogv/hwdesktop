function TNFCab.exitCodigoTabela(tabela: string): boolean;
var
  tipoClFor: string;
  tempSubstituicao: Boolean;
  hasChangeCliente: Boolean;
begin
  try
    Result := true;

    if notaFechada then
      exit;

    if not(dataSet.State in [dsInsert, dsEdit]) then
      Exit;

    vItem.storeRecNo;
    try

      if UpperCase(tabela) = 'CLIENTES' then
      begin
        hasChangeCliente := False;
        vClFor.selecionaClFor();//, dataSet.FieldByName('natureza_nf').AsString);
        if vClFor.dataSet.IsEmpty then
          raiseExceptionCreate('Destinatário/Remetente não encontrado', 'dbedit1')
        else
        begin
          if vClFor.EndDoc.lista.Count <= 0 then
            raiseExceptionCreate('Destinatário/Remetente não encontrado', 'dbedit1');

          if ((vClFor.CodCliente <> dataSet.FieldByName('cod_cliente').AsInteger)) or
            (Trim(dataSet.FieldByName('nome_cliente').AsString) = '') then
            begin
              hasChangeCliente := True;
              FchangesF.disableAll;
              try
                vClFor.SetDadosDestinatario(vClFor.EndDoc.lista.Items[0], True);
                dataSet.FieldByName('conf_isuf').AsString := '';
              finally
                FchangesF.enableAll;
              end;
            end;

          //dataSet.FieldByName('consumidor_final').AsString     := vClFor.dataSet.FieldByName('consumidor_final').AsString;
          //dataSet.FieldByName('nfe_indiedest').AsInteger       := vClFor.dataSet.FieldByName('nfe_indiedest').AsInteger;
          dataSet.FieldByName('inscricao_substituto').AsString := '';

          if (dataSet.FieldByName('emissao_propria').AsString = 'S') and
            (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
            dataSet.FieldByName('inscricao_substituto').AsString := vClFor.inscricao;

          FAliqAcordoCFOPMUDE := vClFor.icm_ext_c;
          FCfopAcordoCFOPMUDE := vClFor.natop_ext_c;
          FAliqIntraEstadual  := vClFor.aliq_intra;

          if fequals('natureza_nf', 'S') and fequals('tipo_emissao', '1') then
          begin
            if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
            begin
              if vClFor.clienteFornecedorContrinuinte then
              begin
                FAliqAcordoCFOPMUDE := vClFor.icm_ext_c;
                FCfopAcordoCFOPMUDE := vClFor.natop_ext_c;
              end
              else
              begin
                FAliqAcordoCFOPMUDE := vClFor.ICM_EXT_NC;
                FCfopAcordoCFOPMUDE := vClFor.NATOP_EXT_NC;
              end;

              if (( (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) = 'S') ) or
                (dataSet.FieldByName('codigo_nop').AsFloat = 0)) and
                (dataSet.FieldByName('tipo_nf').AsString = 'P') then
                dataSet.FieldByName('codigo_nop').AsFloat := FCfopAcordoCFOPMUDE;
            end
            else
            begin
              buscas.Close;
              buscas.Sql.Text := 'select first 1 NATOP_INT_NC from cfop_mud';
              buscas.Open;
              if (( (Trim(dataSet.FieldByName('VERIFICAR_MUD_CFOP').AsString) = 'S') ) or
                (dataSet.FieldByName('codigo_nop').AsFloat = 0)) and
                (dataSet.FieldByName('tipo_nf').AsString = 'P') then
                dataSet.FieldByName('codigo_nop').AsFloat :=
                  buscas.FieldByName('NATOP_INT_NC').AsFloat;
              buscas.Close;
            end;

            if FAliqAcordoCFOPMUDE > 0 then
              dataSet.FieldByName('aliq_icm').AsFloat := FAliqAcordoCFOPMUDE
            else if vClFor.aliq_intra > 0 then
              dataSet.FieldByName('aliq_icm').AsFloat := vClFor.aliq_intra
            else if vDadosIni.vEmp.vAliqPadrao > 0 then
              dataSet.FieldByName('aliq_icm').AsFloat := vDadosIni.vEmp.vAliqPadrao
            else
              dataSet.FieldByName('aliq_icm').AsFloat := 18;
            if vDadosIni.vEmp.vRegime = 'SIMPLES' then
            begin
              dataSet.FieldByName('aliq_icm_simples').AsFloat := vDadosIni.vEmp.vAliqSimplesICM;
              dataSet.FieldByName('aliq_iss').AsFloat := vDadosIni.vEmp.vAliqSimplesISS;
            end;
            dataSet.FieldByName('codigo_nop').AsString := getCfopCorreto(dataSet.FieldByName('codigo_nop').AsString);

            vItem.dataSet.First;
            while not vItem.dataSet.Eof do
            begin
              vItem.dataSet.Edit;
              vItem.dataSet.FieldByName('codigo_nop').AsString :=
                getCfopCorreto(vItem.dataSet.FieldByName('codigo_nop').AsString);
              vCfop.selecionaCfop(Trunc(vItem.dataSet.FieldByName('CODIGO_NOP').AsFloat));
              vItem.dataSet.FieldByName('altera_estoque_cfop').AsString := vDadosIni.retornoPorCondicao(
                vCfop.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfop.dataSet.FieldByName('ALT_EST').AsString);//vCfop.dataSet.FieldByName('ALT_EST').AsString;
              if vItem.dataSet.FieldByName('altera_estoque_cfop').AsString = 'N' then
                vItem.dataSet.FieldByName('altera_custo_cfop').AsString := 'N'
              else
                vItem.dataSet.FieldByName('altera_custo_cfop').AsString := vCfop.dataSet.FieldByName('calc_custo').AsString;
              vItem.dataSet.FieldByName('tipv_veiculo').AsString := vCfop.dataSet.FieldByName('tipv_veiculo').AsString;
              if (vDadosIni.vemp.vRegime = 'SIMPLES') and fdif('tipo_emissao', '4') and fequals('natureza_nf', 'S') and (vClFor.CodCliente <> fint('cod_cliente')) then
              begin
                vItem.dataSet.FieldByName('csosn').AsString := getCSOSNPorCST(vItem.dataSet.FieldByName('cst').AsString, vItem.dataSet.FieldByName('csosn').AsString, True);
                vItem.dataSet.FieldByName('cst').AsString := getCSTPorCSOSN(vItem.dataSet.FieldByName('cst').AsString, vItem.dataSet.FieldByName('csosn').AsString);
              end;
              vItem.dataSet.Post;
              vItem.dataSet.Next;
            end;
            vClFor.CodCliente := dataSet.FieldByName('cod_cliente').AsInteger;

            //          if (vDadosIni.vEmp.vSiglaUF <> dataSet.FieldByName('dest_uf').AsString) and
            //            (copy(dataSet.FieldByName('codigo_nop').AsString, 1, 1) = '5') then
            //            dataSet.FieldByName('codigo_nop').AsString := '6' +
            //              copy(dataSet.FieldByName('codigo_nop').AsString, 2, 3)
            //          else
            //            if (vDadosIni.vEmp.vSiglaUF = dataSet.FieldByName('dest_uf').AsString) and
            //              (copy(dataSet.FieldByName('codigo_nop').AsString, 1, 1) = '6') then
            //              dataSet.FieldByName('codigo_nop').AsString := '5' +
            //                copy(dataSet.FieldByName('codigo_nop').AsString, 2, 3);

  //          if ((dataSet.FieldByName('aliq_icm').AsString = '') and
  //            (vClFor.icm_ext_c > 0)) then
  //            dataSet.FieldByName('aliq_icm').AsFloat := FAliqAcordoCFOPMUDE;
          end;

          if ((StrToIntDef(dataSet.FieldByName('cod_cond_pag').AsString, 0) = 0) and
            (vClFor.dataSet.FieldByName('cod_cond_pag').AsInteger > 0)) then
            dataSet.FieldByName('cod_cond_pag').AsInteger := vClFor.dataSet.FieldByName('cod_cond_pag').AsInteger;
          if (dataSet.FieldByName('codigo_nop').AsString = '') then
          begin
            if dataSet.FieldByName('natureza_nf').AsString = 'E' then
            begin
              if fstr('tipo_nf') = 'S' then
                dataSet.FieldByName('codigo_nop').AsFloat := IfThen(vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao, 2933, 1933)
              else
              begin
                tempSubstituicao := vDadosIni.ShowConfirmacao('Esta Nota Fiscal possui Substituição Tributária') = ID_YES;
                if (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
                  dataSet.FieldByName('codigo_nop').AsFloat := IfThen(tempSubstituicao, 2403, 2102)
                else
                  dataSet.FieldByName('codigo_nop').AsFloat := IfThen(tempSubstituicao, 1403, 1102);
              end;
              if (dataSet.FieldByName('natureza_nf').AsString = 'E') and
                (dataSet.FieldByName('dest_cmun').AsString = '9999999') then
              begin
                dataSet.FieldByName('emissao_propria').AsString := 'S';
                dataSet.FieldByName('codigo_nop').AsString := '3' + copy(dataSet.FieldByName('codigo_nop').AsString, 2, 3);
              end;

              tabela := 'NAT_OP';
            end;
          end;
        end;
        if hasChangeCliente then
          FchangesF.consumidor_final_Change(dataSet.FieldByName('consumidor_final'));
      end
      else if UpperCase(tabela) = 'TRANSPORTADOR' then
      begin
        vTr.selecionaTransportador(dataSet.FieldByName('codigo_tr').AsInteger);
        if vTr.dataSet.IsEmpty then
          raiseExceptionCreate('Transportador não encontrado', 'dbedit12');
      end;
      if UpperCase(tabela) = 'NAT_OP' then
      begin
        if not validaCfop(dataSet.FieldByName('codigo_nop').AsFloat) then
        begin
          Result := False;
          Exit;
        end;
        vCfop.selecionaCfop(Trunc(dataSet.FieldByName('codigo_nop').AsFloat));
        if vCfop.dataSet.IsEmpty then
          raiseExceptionCreate('CFOP não encontrado', 'dbedit10');
        if dataSet.State in [dsInsert, dsEdit] then
        begin
          if dataSet.FieldByName('tipo_nf').AsString = 'V' then
          begin
            if dataSet.FieldByName('natureza_nf').AsString = 'E' then
            begin
              if (FTemp = 1) then
                if vItem.dataSet.RecordCount > 0 then
                  if Application.MessageBox(
                    pchar('Deseja atribuir CFOP informado no cabeçalho a(os) item(s) da nota fiscal?'),
                    'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
                  begin
                    vItem.dataSet.First;
                    while not vItem.dataSet.Eof do
                    begin
                      vItem.dataSet.edit;
                      vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
                        dataSet.FieldByName('codigo_nop').AsFloat;
                      vItem.dataSet.FieldByName('desc_natop').AsString :=
                        dataSet.FieldByName('desc_natop').AsString;
                      if (vDadosIni.vEmp.vVersaoVeiculos = '4') then
                      begin
                        vItem.dataSet.FieldByName('tipv_veiculo').AsString :=
                        vCfop.dataSet.FieldByName('tipv_veiculo').AsString;
                        vItem.dataSet.FieldByName('altera_estoque_cfop').AsString :=
                        vDadosIni.retornoPorCondicao(
                          vCfop.dataSet.FieldByName('tipv_veiculo').AsString = 'A', 'N', vCfop.dataSet.FieldByName('ALT_EST').AsString);
  //                      vCfop.dataSet.FieldByName('alt_est').AsString;
                      end;
                      vItem.dataSet.Post;
                      vItem.dataSet.Next;
                    end;
                  end;
            end
            else
            begin
              if vItem.dataSet.state in [dsEdit, dsInsert] then
                vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
                  dataSet.FieldByName('codigo_nop').AsFloat
              else if vItem.dataSet.RecordCount > 0 then
              begin
                vItem.dataSet.edit;
                vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
                  dataSet.FieldByName('codigo_nop').AsFloat;
                vItem.dataSet.FieldByName('desc_natop').AsString :=
                  dataSet.FieldByName('desc_natop').AsString;
                vItem.dataSet.Post;
              end;
            end;
            //          if (dataSet.FieldByName('codigo_nop').AsFloat <> 5409) and (dataSet.FieldByName('codigo_nop').AsFloat <> 6409) AND
            //            (dataSet.FieldByName('codigo_nop').AsFloat<> 5912) and (dataSet.FieldByName('codigo_nop').AsFloat <> 6912) AND
            //            (dataSet.FieldByName('natureza_nf').AsString = 'S') then
            //            dataSet.FieldByName('INF_CORPO_V').asstring := 'DECLARAMOS QUE O PRODUTO DISCRIMINADO ' + sLineBreak +
            //              'ACIMA FOI POR NOS VENDIDO   ' + sLineBreak + 'ASSINATURA______________________________';
          end
          else if (dataSet.FieldByName('tipo_nf').AsString = 'D') or
            (((copy(dataSet.FieldByName('codigo_nop').AsString,2,3) = '407')  or
            (copy(dataSet.FieldByName('codigo_nop').AsString,2,3) = '556')  or
            (copy(dataSet.FieldByName('codigo_nop').AsString,2,3) = '557') ) and
            (dataSet.FieldByName('natureza_nf').AsString = 'E') and (FTemp = 1) and
            (Application.MessageBox('CFOP digitado de Consumo. Deseja alterar itens conforme CFOP do cabeçalho',
            'Confirmação',MB_ICONQUESTION + MB_YESNO) = IDYES ))then
          begin
            vItem.dataSet.First;
            while not vItem.dataSet.Eof do
            begin
              vItem.dataSet.Edit;
              vItem.dataSet.FieldByName('codigo_nop').AsFloat :=
                dataSet.FieldByName('codigo_nop').AsFloat;
              vItem.dataSet.Post;
              vItem.dataSet.Next;
            end;
          end;

          //if (Trim(dataSet.FieldByName('desc_natop').AsString) = '') or
          //  (dataSet.FieldByName('codigo_nop').OldValue <> dataSet.FieldByName('codigo_nop').NewValue)
          //  then
          begin
            if dataset.state = dsedit then
            begin
              dataset.post;
              dataset.edit;
            end;
            if (vCfop.vCfopDesc.dataSet.IsEmpty) or (vCfop.vCfopDesc.dataSet.RecordCount = 1) then
              dataSet.FieldByName('desc_natop').AsString :=
                vCfop.dataSet.FieldByName('DESCRICAO_NOP').AsString
            else
            begin
              FAlterarDescCFOP := (FTemp = 1);
              if (Trim(dataSet.FieldByName('desc_natop').AsString) = '') then
                FAlterarDescCFOP := True
              else if not FAlterarDescCFOP then
              begin
                FAlterarDescCFOP := True;

                vCfop.vCfopDesc.dataSet.First;
                while not vCfop.vCfopDesc.dataSet.Eof do
                begin
                  if Trim(dataSet.FieldByName('desc_natop').AsString) =
                    (vCfop.vCfopDesc.dataSet.FieldByName('DESCRICAO_NOP').AsString) then
                  begin
                    FAlterarDescCFOP := False;
                    Break;
                  end;
                  vCfop.vCfopDesc.dataSet.Next;
                end;
              end;

              if FAlterarDescCFOP then
              begin
                Application.CreateForm(TfrmEscolhaDescCFOP, frmEscolhaDescCFOP);
                if frmEscolhaDescCFOP.ShowModal = mrOk then
                  dataSet.FieldByName('desc_natop').AsString :=
                    vCfop.vCfopDesc.dataSet.FieldByName('DESCRICAO_NOP').AsString;
                frmEscolhaDescCFOP.Free;
                frmEscolhaDescCFOP := nil;
              end;

              FAlterarDescCFOP := False;
            end;
          end; //if Trim(dataSet.FieldByName('desc_natop').AsString) = '' then
          FTemp := 0;
        end; //if dataSet.State in [dsInsert, dsEdit] then
      end;
    finally
      vItem.restoreRecNo;
    end;

  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TNFCab.frete_somar_desp_req: Boolean;
var
  AIdent: string;
begin
  Result := False;
  if (dataSet.FieldByName('frete_f_nfe').AsString = 'S') then
    Exit;

  case frete_strToOperacao of
    opfContaTerceiros      : Result := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_terceiros;
    opfContaEmitente,
    opfProprioEmitente     : Result := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_emitente;
    opfContaDestinatario,
    opfProprioDestinatario : Result := FConfig.Conf_Frete.Somar_despesa_pedvenda_quando_conta_destinatario;
    opfSemFrete            : Exit;
  end;
  {
  case frete_strToOperacao of
    opfContaTerceiros    : AIdent := 'Somar_despesa_pedvenda_quando_conta_terceiros';
    opfContaEmitente     : AIdent := 'Somar_despesa_pedvenda_quando_conta_emitente';
    opfContaDestinatario : AIdent := 'Somar_despesa_pedvenda_quando_conta_destinatario';
    opfSemFrete          : Exit;
  end;

  Result := GetIni('Configuracao', AIdent, 'N', FConfigFrete) = 'S';
  }
end;

function TNFCab.frete_strToOperacao: C_OperacaoFrete;
begin
  if (dataSet.FieldByName('freteconta_tr').AsString = '0') then
    Result := opfContaTerceiros
  else if (dataSet.FieldByName('freteconta_tr').AsString = '1') then
    Result := opfContaEmitente
  else if (dataSet.FieldByName('freteconta_tr').AsString = '2') then
    Result := opfContaDestinatario
  else if (dataSet.FieldByName('freteconta_tr').AsString = '3') then
    Result := opfProprioEmitente
  else if (dataSet.FieldByName('freteconta_tr').AsString = '4') then
    Result := opfProprioDestinatario
  else if (dataSet.FieldByName('freteconta_tr').AsString = '9') then
    Result := opfSemFrete
  else
    Result := opfNenhum;
end;

function TNFCab.frete_usar_na_base_icms: Boolean;
var
  AIdent: string;
begin
  Result := False;
  if (dataSet.FieldByName('frete_f_nfe').AsString = 'S') then
    Exit;

  if fequals('natureza_nf', 'E') and fequals('frete_base_icm', 'S') then
  begin
    Result := True;
    Exit;
  end;

  case frete_strToOperacao of
    opfContaTerceiros      : Result := FConfig.Conf_Frete.Entra_base_icm_quando_conta_terceiros;
    opfContaEmitente,
    opfProprioEmitente     : Result := FConfig.Conf_Frete.Entra_base_icm_quando_conta_emitente;
    opfContaDestinatario,
    opfProprioDestinatario : Result := FConfig.Conf_Frete.Entra_base_icm_quando_conta_destinatario;
    opfSemFrete            : Exit;
  end;
  {
  case frete_strToOperacao of
    opfContaTerceiros    : AIdent := 'Entra_base_icm_quando_conta_terceiros';
    opfContaEmitente     : AIdent := 'Entra_base_icm_quando_conta_emitente';
    opfContaDestinatario : AIdent := 'Entra_base_icm_quando_conta_destinatario';
    opfSemFrete          : Exit;

  end;

  Result := GetIni('Configuracao', AIdent, 'N', FConfigFrete) = 'S';
  }
end;

function TNFCab.gerarFaturas(condicaoDaNotaFiscal: boolean): boolean;
var
  vCondicao: string;
  dias: array of integer;
  I, j: Integer;
  vDiaTemp: string;
  vDataDoDia: Tdate;
  vListaVendas: TStringList;
  K: Integer;
  vOK: Boolean;
  ValorVendas, ValorTotalFaturas: Double;
  ACondPag: TCondicaoPagamento;
  ACodCP: Integer;
  ADescrCP: string;
  AParcCP: RParcelamentos;
  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
begin
	try
    Result := False;

    ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
		vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));

    vOK := True;
    fCodControleVenda := 0;

    if (vDadosIni.vEmp.vUsarUmaVendaPorNF = 'S') and (vUsarControlesVenda = 'S') and
      (dataSet.FieldByName('nped').AsInteger > 0) and (dataSet.FieldByName('tipo_ped').AsString = 'REQ') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_controle from pedvenda' +
        ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      fCodControleVenda := buscas.FieldByName('cod_controle').AsInteger;

    end;

    if (vDadosIni.vEmp.vNfUsarFormaPagDoPed = 'S') and (not FFatura.UsarValorDoPedido) then
    begin
      vListaVendas := TStringList.Create;
      vListaVendas.Clear;
      vOK := False;

      if not vItem.dataSet.Active then
        vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);

      vItem.dataSet.First;
      if Trim(dataSet.FieldByName('natureza_nf').AsString) = 'S' then
      while not vItem.dataSet.Eof do
      begin
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') then
        begin
          vOK := False;
          for K := 0 to vListaVendas.Count - 1 do
            if (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = vDadosIni.getCampoPipe(vListaVendas[K], 1)) and
              (Trim(vItem.dataSet.FieldByName('nped').AsString) = vDadosIni.getCampoPipe(vListaVendas[K], 2)) then
            begin
              vOK := True;
              Break;
            end;
          if not vOK then
          begin
            buscas.Close;
            buscas.SQL.Text :=
              ('select fp.data_mov,fp.tpdocs, fp.nrequisicao,fp.ndoc,ctr.nome_ctrl,fp.cod_cliente,fp.cliente,' +
              ' fp.historico, fp.valordoc, fp.data_venc,fp.terceiros,fp.tipdoc, fp.cod_controle,' +
              ' fp.cod_empresa,' +
              ' case when fp.rec_tipvend = ''REC'' then ''RECIBO ANTECIPADO Nº ''||fp.rec_numvend' +
              '   else ctr.nome_ctrl' +
              ' end formaDePagamento, fp.n_processamento, fp.nosso_numero_banco ' +
              '  from formpagamento fp' +
              ' inner join controles ctr on ctr.codigo_ctrl = fp.cod_controle and' +
              ' ctr.codigo_emp = fp.cod_empresa' +
              ' where  fp.nrequisicao = ' + IntToStr(vItem.dataSet.FieldByName('nped').AsInteger) +
              ' and fp.tpdocs = ' + QuotedStr(Trim(vItem.dataSet.FieldByName('tipo_ped').AsString)) + ' and fp.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and fp.ativo = 1');
            buscas.Open;
            if buscas.IsEmpty then
              vOK := True;
          end;

          if not vOK then
            vListaVendas.Add(
              Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) + '|' +
              Trim(vItem.dataSet.FieldByName('nped').AsString) + '|' );
        end;
        vItem.dataSet.Next;
      end;

      if vListaVendas.Count > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select fp.seqform, fp.ndoc, fp.data_venc, ' +
          ' fp.valordoc, fp.valordocbruto, fp.tpdocs, fp.nrequisicao, fp.cod_controle from formpagamento fp' +
          ' inner join controles co on co.codigo_ctrl = fp.cod_controle and co.codigo_emp = fp.cod_empresa' +
          ' where co.usar_boleto = ''S'' and (';
        for K := 0 to vListaVendas.Count - 1 do
        begin
          if Pos('(tpdocs =', buscas.SQL.Text) > 0 then
            buscas.SQL.Add(' or ');
          buscas.SQL.Add(' (tpdocs = ' + QuotedStr(vDadosIni.getCampoPipe(vListaVendas[K], 1)) +
            ' and nrequisicao = ' + vDadosIni.getCampoPipe(vListaVendas[K], 2) + ')');
        end;
        buscas.SQL.Add(') and fp.cod_empresa = '+vDadosIni.codEmpresa+' order by fp.ndoc, fp.data_venc');
        buscas.Open;

        buscas.FetchAll;

        FFatura.parcelas := buscas.RecordCount;
        SetLength(FFatura.vencimentoDocumento, buscas.RecordCount);
        SetLength(FFatura.numeroDocumento, buscas.RecordCount);
        SetLength(FFatura.valorDocumento, buscas.RecordCount);
        SetLength(FFatura.numVenda, buscas.RecordCount);
        SetLength(FFatura.tipoVenda, buscas.RecordCount);
        SetLength(FFatura.referenteFrete, buscas.RecordCount);
        SetLength(FFatura.codControles, buscas.RecordCount);

        K:=0;
        buscas.First;
        while not buscas.Eof do
        begin
          FFatura.vencimentoDocumento[K] := buscas.FieldByName('data_venc').AsString;
          FFatura.numeroDocumento[K] := buscas.FieldByName('ndoc').AsString;//vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger, 6) + '-' +  IntToStr( K + 1 );
          FFatura.valorDocumento[K] := StrToFloat(Format('%0.2f', [buscas.FieldByName('valordoc').AsFloat]));

          FFatura.numVenda[K] := buscas.FieldByName('nrequisicao').AsInteger;
          FFatura.tipoVenda[K] := buscas.FieldByName('tpdocs').AsString;
          FFatura.codControles[K] := buscas.FieldByName('cod_controle').AsInteger;
          FFatura.referenteFrete[K] := False;

          Result := True;
          inc(K);
          buscas.Next;
        end;
        vOK := False;
      end
      else
        vOK := True;
      vListaVendas.Clear;

    end
    else if (Trim(dataSet.FieldByName('natureza_nf').AsString) = 'S') and (FFatura.UsarValorDoPedido) then
    begin
      vListaVendas := TStringList.Create;
      vListaVendas.Clear;
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        if (vItem.dataSet.FieldByName('nped').AsInteger > 0) and
          (vItem.dataSet.FieldByName('tipo_ped').AsString <> '') then
        begin
          vOK := False;
          for K := 0 to vListaVendas.Count - 1 do
            if (Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) = vDadosIni.getCampoPipe(vListaVendas[K], 1)) and
              (Trim(vItem.dataSet.FieldByName('nped').AsString) = vDadosIni.getCampoPipe(vListaVendas[K], 2)) then
            begin
              vOK := True;
              Break;
            end;
          if not vOK then
            vListaVendas.Add(
              Trim(vItem.dataSet.FieldByName('tipo_ped').AsString) + '|' +
              Trim(vItem.dataSet.FieldByName('nped').AsString) + '|' );
        end;
        vItem.dataSet.Next;
      end;
      ValorVendas := 0;
      for K := 0 to vListaVendas.Count - 1 do
      begin
        buscas.Close;
        buscas.SQL.Text := 'select valor_total from pedvenda pv' +
          ' where pv.tipo = ' + QuotedStr(vDadosIni.getCampoPipe(vListaVendas[K], 1)) +
          ' and pv.nped = ' + vDadosIni.getCampoPipe(vListaVendas[K], 2) +
          ' and pv.cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;
        ValorVendas := ValorVendas + buscas.FieldByName('valor_total').AsFloat;
      end;
      vOK := True;
    end;

    if vOK then
    begin
      try
        if condicaoDaNotaFiscal then
        begin
          vCPag.abreCondPag(dataSet.FieldByName('cod_cond_pag').AsInteger);
          vCondicao := Trim(vCPag.dataSet.FieldByName('desc_cond_pag').AsString);
          ACodCP := dataSet.FieldByName('cod_cond_pag').AsInteger;
          ADescrCP := vCondicao;
          vCPag.abreCondPag(dataSet.FieldByName('natureza_nf').AsString[1]);
        end
        else
        begin
          vCondicao := Trim(vCPag.dataSet.FieldByName('desc_cond_pag').AsString);
          ACodCP := vCPag.dataSet.FieldByName('cod_cond_pag').AsInteger;
          ADescrCP  := vCondicao;
        end;
        if (Pos('VISTA', UpperCase(vCondicao)) > 0) or (Pos('SEM PAGAMENTO', UpperCase(vCondicao)) > 0) or
          (vDadosIni.StrToFloatFormat(dataSet.FieldByName('valor_total').AsFloat, 2) = 0) then
        begin
          Result := False;
          exit;
        end;
        vDiaTemp := ''; J := 0;
        if Pos('X', UpperCase(vCondicao)) > 0 then
        begin
          try
            J := StrToInt(Trim(copy(vCondicao, 1, Pos('X', UpperCase(vCondicao)) - 1)));
          except
            Result := False;
            exit;
          end;
          SetLength(dias, j);
          for I := 1 to J do
            dias[I - 1] := 30 * i;
        end
        else
        begin
          for I := 1 to Length(vCondicao) do
          begin
            if vCondicao[i] in numeros then
              vDiaTemp := vDiaTemp + vCondicao[i]
            else
            begin
              if vDiaTemp <> '' then
              begin
                j := J + 1;
                SetLength(dias, j);
                dias[j - 1] := StrToInt(vDiaTemp);
                vDiaTemp := '';
              end;
            end;
          end;
          if vDiaTemp <> '' then
          begin
            j := J + 1;
            SetLength(dias, J);
            dias[J - 1] := StrToInt(vDiaTemp);
            vDiaTemp := '';
          end;
        end;
        if dataSet.FieldByName('natureza_nf').AsString = 'E' then
          vDataDoDia := dataSet.FieldByName('data_contabil').AsDateTime
        else
          vDataDoDia := vDadosIni.getDataBanco(buscas);

        if (ValorVendas > 0) and (FFatura.UsarValorDoPedido) then
          ValorTotalFaturas := ValorVendas
        else
          ValorTotalFaturas := dataSet.FieldByName('valor_total').AsFloat;

        try
          ACondPag := TCondicaoPagamento.create;

          if FFatura.codControle = 0 then
            FFatura.codControle := _LerConfiguracoesRegistroInteger('FFatura.codControle');

          AParcCP := ACondPag.MontarPacelamento(ACodCP, ADescrCP, ValorTotalFaturas, dataSet.FieldByName('num_nf').AsString,
                '', '', '', '', 0, 0, vDataDoDia, FFatura.codControle, 0, False, 0);
        finally
          FreeAndNil(ACondPag);
        end;

        FFatura.parcelas := Length(AParcCP);
        SetLength(FFatura.vencimentoDocumento, FFatura.parcelas);
        SetLength(FFatura.numeroDocumento, FFatura.parcelas);
        SetLength(FFatura.valorDocumento, FFatura.parcelas);
        SetLength(FFatura.numVenda, FFatura.parcelas);
        SetLength(FFatura.tipoVenda, FFatura.parcelas);
        SetLength(FFatura.referenteFrete, FFatura.parcelas);
        SetLength(FFatura.codControles, FFatura.parcelas);
        for I := Low(FFatura.despesas) to High(FFatura.despesas) do
        begin
          SetLength(FFatura.despesas[i].NumConta, 0);
          SetLength(FFatura.despesas[i].dataReferencia, 0);
          SetLength(FFatura.despesas[i].NumDoc, 0);
          SetLength(FFatura.despesas[i].historico, 0);
          SetLength(FFatura.despesas[i].valorDocumento, 0);
          SetLength(FFatura.despesas[i].Controle,0);
        end;
        for I:= Low(AParcCP) to High(AParcCP) do
        begin
          FFatura.vencimentoDocumento[i] := FormatDateTime('DD/MM/YYYY', AParcCP[I].DataVencimento);;
          FFatura.numeroDocumento[i] := AParcCP[I].NumeroDocumento;
          FFatura.valorDocumento[i] := AParcCP[I].ValorParcela;
          FFatura.referenteFrete[i] := False;
          FFatura.codControles[i] := 0;
        end;
        {
        FFatura.parcelas := J;
        SetLength(FFatura.vencimentoDocumento, J);
        SetLength(FFatura.numeroDocumento, J);
        SetLength(FFatura.valorDocumento, J);
        SetLength(FFatura.numVenda, J);
        SetLength(FFatura.tipoVenda, J);
        SetLength(FFatura.referenteFrete, J);
        SetLength(FFatura.codControles, J);
        for I := 0 to High(FFatura.despesas) do
        begin
          SetLength(FFatura.despesas[i].NumConta, 0);
          SetLength(FFatura.despesas[i].dataReferencia, 0);
          SetLength(FFatura.despesas[i].NumDoc, 0);
          SetLength(FFatura.despesas[i].historico, 0);
          SetLength(FFatura.despesas[i].valorDocumento, 0);
          SetLength(FFatura.despesas[i].Controle,0);
        end;
        SetLength(FFatura.despesas, 0);
        SetLength(FFatura.despesas, FFatura.parcelas);

        for I := 0 to FFatura.parcelas - 1 do
        begin
          ShortDateFormat := 'dd/mm/yyyy';
          FFatura.vencimentoDocumento[i] := DateToStr(vDataDoDia + dias[i]);
          FFatura.numeroDocumento[i] := vDadosIni.StrZero(dataSet.FieldByName('num_nf').AsInteger, 6) +
            '-'
            +
            IntToStr(i + 1);
          FFatura.valorDocumento[i] := StrToFloat(Format('%0.2f',
            [ValorTotalFaturas / FFatura.parcelas]));
          FFatura.referenteFrete[i] := False;
          FFatura.codControles[i] := 0;
        end;
        if FFatura.parcelas > 0 then
        FFatura.valorDocumento[0] := StrToFloat(Format('%0.2f', [FFatura.valorDocumento[0] +
          (ValorTotalFaturas -
            (FFatura.valorDocumento[0] * FFatura.parcelas))]));
        }

        Result := true;
      except
        Result := False;
      end;
    end;
  finally
  	if Assigned(ConfigPoliticaPag) then
      FreeAndNil(ConfigPoliticaPag);
  end;
end;

