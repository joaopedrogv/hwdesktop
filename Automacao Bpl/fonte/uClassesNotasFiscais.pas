procedure TNotafiscal_item_dados.ExecutarCalcularFCP;
var
  Acst, Acsosn: string;
  AoperacoesICM: OperacaoICMSSet;
begin
  if import_xml = 'S' then
    Exit;

  GetAliquotasFCP;

  Acst   := Copy(cst, 2, 2);
  Acsosn := Trim(csosn);

  if vDadosIni.strIn(Acst, ['10', '20', '70', '90']) then
    fcp_vbcfcp := RoundTo(IfThen(base_icm > 0, base_icm), -2);

  if vDadosIni.strIn(Acst, ['00', '10', '20', '70', '90']) then
    fcp_vfcp := RoundTo(IfThen(base_icm > 0, base_icm) * fcp_pfcp / 100, -2);

  if Acst = '51' then
  begin
    fcp_vbcfcp := GetValorBaseICMSCalculada;
    fcp_vfcp := RoundTo(fcp_vbcfcp * fcp_pfcp / 100, -2);
  end;

  if (vDadosIni.strIn(Acst  , ['10' , '30' , '70' , '90' ])) or
     (vDadosIni.strIn(Acsosn, ['201', '202', '203', '900'])) then
    fcp_vbcfcpst := RoundTo(IfThen(base_icmsub > 0, base_icmsub), -2);

  if (vDadosIni.strIn(Acst  , ['10' , '30' , '70' , '90' ])) or
     (vDadosIni.strIn(Acsosn, ['201', '202', '203', '900'])) then
    fcp_vfcpst := RoundTo(IfThen(fcp_vbcfcpst> 0, fcp_vbcfcpst) * fcp_pfcpst / 100, -2);

  if not vDadosIni.strIn(Acst, ['10', '20', '70', '90']) then
    fcp_vbcfcp := 0;

  if not vDadosIni.strIn(Acst, ['00', '10', '20', '70', '90']) then
  begin
    fcp_pfcp := 0;
    fcp_vfcp := 0;
  end;

  if ((not vDadosIni.strIn(Acst  , ['10' , '30' , '70' , '90' ])) and (Trim(Acsosn) =  '')) or
     ((not vDadosIni.strIn(Acsosn, ['201', '202', '203', '900'])) and (Trim(Acsosn) <> '')) then
  begin
    fcp_vbcfcpst := 0;
    fcp_pfcpst   := 0;
    fcp_vfcpst   := 0;
  end;

  if ((Acst   <> '60' ) and (Trim(Acsosn) =  '')) or
     ((Acsosn <> '500') and (Trim(Acsosn) <> '')) then
  begin
    fcp_vbcfcpstret := 0;
    fcp_pfcpstret   := 0;
    fcp_vfcpstret   := 0;
  end;

  if fcp_pfcp <= 0 then
  begin
    fcp_pfcp   := 0;
    fcp_vbcfcp := 0;
    fcp_vfcp   := 0;
  end;

  if fcp_pfcpst <= 0 then
  begin
    fcp_pfcpst   := 0;
    fcp_vbcfcpst := 0;
    fcp_vfcpst   := 0;
  end;
  
  if (FOwerNF.fstr('nfe_iddest')       = '2') and
     (FOwerNF.fstr('nfe_indiedest')    = '9') and
     (FOwerNF.fstr('consumidor_final') = 'S') then
  begin
    fcp_pfcp   := 0;
    fcp_vbcfcp := 0;
    fcp_vfcp   := 0;
  end;
end;

procedure TNotafiscal_item_dados.ExecutarCalcularICMSEfetivo(Abase_icms: Double);
begin
  if (picmsefet > 0) and
    (Copy(cst, 2, 2) = '60') and
    (FOwerNF.campo_emissao_propria = 'S') and
    (FOwerNF.dataSet.FieldByName('consumidor_final').AsString = 'S') and
    (vDadosIni.strIn(FOwerNF.getUFdaOperacao, FOwerNF.Config.Conf_ICMS.icms_efetivo_ufs)) and
    ((FOwerNF.campo_natureza_nf = 'S') or (FOwerNF.Config.Conf_ICMS.icms_efetivo_calc_entrada)) then
  begin
    if predbcefet > 0 then
      vbcefet    := RoundTo(((Abase_icms) * (100 - predbcefet) / 100), -2)
    else
    begin
      vbcefet    := RoundTo(Abase_icms, -2);
      predbcefet := 0;
    end;
    vicmsefet    := RoundTo(vbcefet * picmsefet / 100, -2);
  end
  else
  begin
    predbcefet := 0;
    picmsefet  := 0;
    vbcefet    := 0;
    vicmsefet  := 0;
  end;
end;

procedure TNotafiscal_item_dados.ExecutarCalcularICMSUFDest;
begin

  //vItem.vrDadosItem.vbcufdest := 0;
  if (Copy(FOwerNF.dataSet.FieldByName('devolucao').AsString,1,1) <> 'S') and
    (FOwerNF.OperacaoComICMSInterestadualParaPartilha( Trunc(codigo_nop), StrToIntDef(comb_cprodanp, 0))) then
  begin
    //não será mais usado da forma proposta na nota tecnico 2015/003 v1.40
    //base unica conforme noticia da sefaz SC
    //http://www.sef.sc.gov.br/noticias/aten%C3%A7%C3%A3o-contribuinte-delibera%C3%A7%C3%B5es-do-confaz-estendem-prazos-e-simplificam-gest%C3%A3o-tribut%C3%A1ria
    //verificar tambem se o IPI vai compor esta base de calculo

    //fazendo o calculo interestadual
    // base inter = valor da operacao / ( 1 - aliquota) --  aliq: 0,04  0,07   0,12
    //vItem.vrDadosItem.vbcufdest := vDadosIni.StrToFloatFormat(vValorBaseICMTemp / ( 1 - ( vItem.vrDadosItem.picmsinter / 100 )), 2);

    vbcufdest := vDadosIni.StrToFloatFormat(GetValorBaseICMSCalculada, 2);
    //icms interestadual = base inter * aliqinter / 100
    vicmsufremet := RoundTo(vbcufdest * picmsinter / 100, -2);
    //fazendo o calculo uf destino
    // base destino = valor da operacao / ( 1 - (aliqintra + aliqFCP)) --  aliq: 0,18   0,25   etc
    //vItem.vrDadosItem.vbcufdest := vDadosIni.StrToFloatFormat(vValorBaseICMTemp / ( 1 - ( (vItem.vrDadosItem.picmsufdest + vItem.vrDadosItem.pfcpufdest ) / 100 )),2);
    //icms uf destinho = base dest * aliqintra / 100
    vicmsufdest := RoundTo(vbcufdest * picmsufdest / 100, -2);
    //FCP: Fundo de combate a pobreza
    fcp_vbcfcpufdest := vbcufdest;
    vfcpufdest := RoundTo(fcp_vbcfcpufdest * pfcpufdest / 100, -2);
    //calculando o DIFAL: Diferencial de aliquota
    vicmsufdest := vicmsufdest - vicmsufremet;
    //definindo a participacao da uf destino, 40% em 2016, 60% em 2017, 80% em 2018, 100% a partir de 2019
    vicmsufremet := RoundTo(vicmsufdest * (100 - picmsinterpart) / 100, -2);
    vicmsufdest := RoundTo(vicmsufdest - vicmsufremet, -2);
    if vDadosIni.vEmp.vRegime = 'SIMPLES' then
      vicmsufremet := 0;
  end
  else if not FOwerNF.OperacaoComICMSInterestadualParaPartilha( Trunc(codigo_nop), StrToIntDef(comb_cprodanp, 0)) then
  begin
    vbcufdest := 0;
    pfcpufdest := 0;
    picmsufdest := 0;
    vfcpufdest := 0;
    vicmsufdest := 0;
    vicmsufremet := 0;
    fcp_vbcfcpufdest := 0;
  end;       

  if ((vDadosIni.vEmp.vRegime = 'SIMPLES') and (Pos('|' + Copy(csosn, 2, 2) + '|', FOwerNF.Config.Conf_ICMS.CSTCSOSNNaoCalcularICMSInterestadual) > 0 )) or
    ((vDadosIni.vEmp.vRegime <> 'SIMPLES') and (Pos('|' + Copy(cst, 2, 2) + '|', FOwerNF.Config.Conf_ICMS.CSTCSOSNNaoCalcularICMSInterestadual) > 0 )) then
  begin
    vbcufdest := 0;
    pfcpufdest := 0;
    picmsufdest := 0;
    vfcpufdest := 0;
    vicmsufdest := 0;
    vicmsufremet := 0;
    fcp_vbcfcpufdest := 0;
  end
  else if (vbcufdest = 0) and (Copy(FOwerNF.dataSet.FieldByName('devolucao').AsString,1,1) <> 'S') then
  begin
    picmsufdest := 0;
    picmsinter := 0;
    picmsinterpart := 0;
    pfcpufdest := 0;
    vicmsufremet := 0;
    vicmsufdest := 0;
    fcp_vbcfcpufdest := 0;
  end;
end;

procedure TNotafiscal_item_dados.ExecutarMotivoDesoneracao;
begin
  if (FOwerNF.fstr('devolucao') = 'SIM') or (FOwerNF.fstr('natureza_nf') = 'E') then
    Exit;

  if import_xml = 'S' then
    Exit;

  if FOwerNF.fstr('crt') = '1' then
  begin
    ind_desoneracao := 0;
    Exit;
  end;

  with FOwerNF do
    ind_desoneracao := SqlOpen('select case when DE.DESONERACAOID is null then D.IND_DESONERACAO else 0 end IND_DESONERACAO' +
                               ' from DESONERACAO_REGRAS dr' +
                               ' inner join DESONERACAO d on d.id = dr.desoneracaoid and d.cod_empresa = dr.cod_empresa' +
                               ' left  join DESONERACAO_EXCECOES de on de.desoneracaoid = d.id and de.cod_empresa = d.cod_empresa' +
                               '   and de.ncm = %s' +
                               ' where dr.sigla_uf like %s and dr.csts like %s and dr.contribuinte like %s and dr.pessoa like %s' +
                               ' and dr.consumidor_final like %s and dr.cod_empresa = %d and coalesce(dr.finalidadeid, %d) = %d',
                               [QuotedStr(ncm), QuotedStr('%' + fstr('dest_uf') + '|%'), QuotedStr('%' + Copy(cst, 2, 2) + '|%'),
                                QuotedStr('%' + fstr('nfe_indiedest') + '|%'), QuotedStr('%' + IfThen(Length(fstr('cpfcgc')) = 14, '1', '0') + '|%'),
                                QuotedStr('%' + IfThen(fstr('consumidor_final') = 'S', '1', '0') + '|%'),
                                fint('cod_empresa'), fint('finalidadeid'), fint('finalidadeid')]).
                                FieldByName('IND_DESONERACAO').AsInteger;
end;

procedure TNotafiscal_item_dados.ExecutarRateio;
var
  ArateioTemp: Double;
begin
//Efetuando rateio temporario
  ArateioTemp := FOwerNF.dataSet.FieldByname('valor_prod').AsFloat +                                 //total da nota
                 IfThen((FOwerNF.campo_natureza_nf = 'S'), valor_total) -  //total do item do calculo
                 IfThen((FOwerNF.campo_natureza_nf = 'S') and (stado <> dsInsert), FOwerNF.vItem.FOwerNF.dataSet.FieldByname('valor_total').AsFloat); //caso seja alteração entao o valor total pode ter sido alterado

  if (FOwerNF.fstr('tipo_frete') <> 'I') and (FOwerNF.ffloat('valor_frete') > 0) and (rateio_frete = 0) then
    rateio_frete := RoundTo(((FOwerNF.dataSet.FieldByname('valor_frete').AsFloat) / (ArateioTemp) * valor_total), -2);

  if (FOwerNF.fstr('tipo_seguro') <> 'I' ) and (FOwerNF.ffloat('valor_seguro') > 0) and (rateio_seguro = 0) then
    rateio_seguro := RoundTo(((FOwerNF.dataSet.FieldByname('valor_seguro').AsFloat) / (ArateioTemp) * valor_total), -2);

  if (FOwerNF.fstr('tipo_outdesp') <> 'I' ) and (FOwerNF.ffloat('valor_out_desp') > 0) and (rateio_outdesp = 0) then
    rateio_outdesp := RoundTo(((FOwerNF.dataSet.FieldByname('valor_out_desp').AsFloat) / (ArateioTemp) * valor_total), -2);

  if (FOwerNF.fstr('tipo_desppf') <> 'I' ) and (FOwerNF.ffloat('valor_desp_pf') > 0) and (rateio_desp_pf = 0) then
    rateio_desp_pf := RoundTo(((FOwerNF.dataSet.FieldByname('valor_desp_pf').AsFloat) / (ArateioTemp) * valor_total), -2);
end;

procedure TNotafiscal_item_dados.GetAliquotasFCP;
begin
  if (FOwerNF.campo_natureza_nf = 'E') or
     (FOwerNF.dataSet.FieldByName('devolucao').AsString = 'SIM') then
    Exit;

  if not FOwerNF.Config.Conf_FCP.CalcularFCP then
  begin
    fcp_pfcp         := 0;
    fcp_vfcp         := 0;
    fcp_vbcfcp       := 0;
    fcp_vbcfcpst     := 0;
    fcp_pfcpst       := 0;
    fcp_vfcpst       := 0;
    fcp_vbcfcpufdest := 0;
    fcp_vbcfcpstret  := 0;
    fcp_pfcpstret    := 0;
    fcp_vfcpstret    := 0;
    Exit;
  end;

  if FOwerNF.Config.Conf_FCP.UsarFCPdoEstado then
    fcp_pfcp := FOwerNF.vClFor.pfcp;

  if (FOwerNF.Config.Conf_FCP.UsarFCPdoNCM) and (Trim(ncm) <> '') then
    fcp_pfcp := FOwerNF.SqlOpen('select FCP_ALIQ from nbm where cod_ncm = ' + QuotedStr(ncm)).FieldByName('FCP_ALIQ').AsFloat;

  if (FOwerNF.Config.Conf_FCP.UsarFCPdoProduto) and (tipo_item = 'P') then
    fcp_pfcp := FOwerNF.vItem.vProd.dataSet.FieldByName('fcp_aliq').AsFloat;

  if (vDadosIni.vEmp.vSiglaUF <> FOwerNF.getUFdaOperacao) then
    if (FOwerNF.Config.Conf_FCP.UsarFCPTribAdProd) and (tipo_item = 'P') and (FCP_aliq_tribAd <> Unassigned) then
      fcp_pfcp := FCP_aliq_tribAd;

  fcp_pfcpst := fcp_pfcp;
  //fcp_pfcpstret := fcp_pfcp + aliq_icmsub;   ////// ??????????
end;

function TNotafiscal_item_dados.getDadosSubstituicaoTributaria(
  UFOperacao: string; RamoAtividade: Integer): Boolean;
var
  CestST: TCestM;
  Variante_Id, RamoAtiv: Integer;
begin
  Result := False;

  if Trim(cest) = '' then
    Exit;

  AjustarMVA := False;
  FMVA       := 0;
  mvaId      := 0; 

  try

    Variante_Id := IfThen(tipo_item = 'P', Cest_Variante_Id);

    CestST := TCest_Builder.GetCest(cest,
    																ncm,
                                    Copy(cst, 1, 1),                                                                 
                                    IfThen(FOwerNF.fequals('natureza_nf', 'S'), vDadosIni.vEmp.vSiglaUF, UFOperacao),
                                    IfThen(FOwerNF.fequals('natureza_nf', 'S'), UFOperacao, vDadosIni.vEmp.vSiglaUF),
                                    FOwerNF.fint('nfe_iddest'),
                                    Variante_Id,
                                    RamoAtividade,
                                    aliq_icm,
                                    dtmAtivo.bancoHw,
                                    vDadosIni.codEmpresa);

    if cest = CestST.cest then
      if CestST.MVAs.Count > 0 then
        if VarToFloat(CestST.MVAs.First.mva) > 0 then
        begin
          FMVA := VarToFloat(CestST.MVAs.First.mva);
          mvaId := CestST.MVAs.First.id;

          AjustarMVA := (FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa) and
                        (FOwerNF.fstr('nfe_iddest') = '2') and
                        (FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.AjustarMVA) and
                        (FOwerNF.vClFor.fequals('regime', sInfCplSIMPLES)) and
                        (FMVA > 0) and
                        (TTipo_Variante_Cest_MVA(VarToInt(CestST.MVAs.First.Variante.tipo)) <> tvOrigem);// Quando tipo Origem então o MVA já tem a definição da operacao interestadual ou interna
          Result := FMVA > 0;
        end;

  finally
    FreeAndNil(CestST);
  end;
end;

