function TNFCab.somaTotaisNF(forceGetData: Boolean): boolean;
var
  AValorPISCOFINS: Currency;
  vdif, dSum: Double;
  retAvaliador: TAvaliadorRetencoes;
begin
  //Zerando Variaveis
  if notaFechada then
    exit;
  absorverValorICMSST;
  verificarPrecoCustoItens;
  try
    if Assigned(FCalculoImposto) then
      FreeAndNil(FCalculoImposto);
    FCalculoImposto := TNotafiscal_totais_dados.Create;

    AValorPISCOFINS := 0;
    //Somanto Valores dos Itens para calcular descontos
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'S' then
      begin
        FCalculoImposto.vValorServicos := FCalculoImposto.vValorServicos + vItem.dataSet.FieldByName('valor_total').AsFloat;
        if vItem.dataSet.FieldByName('permitir_desconto').AsString <> 'N' then
          FCalculoImposto.FValorServicoPermiteDesconto := FCalculoImposto.FValorServicoPermiteDesconto + vItem.dataSet.FieldByName('valor_total').AsFloat;
      end
      else
      begin
        FCalculoImposto.vValorProdutos := FCalculoImposto.vValorProdutos +
          vItem.dataSet.FieldByName('valor_total').AsFloat;
        if vItem.dataSet.FieldByName('permitir_desconto').AsString <> 'N' then
          FCalculoImposto.FValorProdutoPermiteDesconto :=
            FCalculoImposto.FValorProdutoPermiteDesconto
            + vItem.dataSet.FieldByName('valor_total').AsFloat;
      end;
      vItem.dataSet.Next;
    end;

    //Acertando desconto de acordo o tipo. I: % no Item, R: Rateio no total
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      if dataSet.FieldByName('tipo_desconto').AsString = 'I' then
      begin
        if (vItem.dataSet.FieldByName('tipo_item').AsString = 'S') then
          FCalculoImposto.FValorDescontoServ := FCalculoImposto.FValorDescontoServ +
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat)
        else
          FCalculoImposto.FValorDescontoProd := FCalculoImposto.FValorDescontoProd +
            (vItem.dataSet.FieldByName('rateio_desconto').AsFloat);
      end
      else if vItem.dataSet.FieldByName('permitir_desconto').AsString = 'N' then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('rateio_desconto').AsFloat := 0;
        vItem.dataSet.FieldByName('perc_desconto').AsFloat := 0;
        vItem.dataSet.Post;
      end
      else if vItem.dataSet.FieldByName('permitir_desconto').AsString <> 'N' then
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('rateio_desconto').AsFloat := 0;
        if (vItem.dataSet.FieldByName('tipo_item').AsString = 'S') and
          (dataSet.FieldByName('valor_desc_s').AsFloat > 0) and
            (vItem.dataSet.FieldByName('valor_total').AsFloat > 0) then
          vItem.dataSet.FieldByName('rateio_desconto').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('valor_desc_s').AsFloat /
            FCalculoImposto.FValorServicoPermiteDesconto
            * vItem.dataSet.FieldByName('valor_total').AsFloat, 2)
        else if (vItem.dataSet.FieldByName('tipo_item').AsString <> 'S') and
          (dataSet.FieldByName('valor_desc_p').AsFloat > 0) and
            (vItem.dataSet.FieldByName('valor_total').AsFloat > 0) then
          vItem.dataSet.FieldByName('rateio_desconto').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('valor_desc_p').AsFloat /
            FCalculoImposto.FValorProdutoPermiteDesconto
            * vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
        vItem.dataSet.FieldByName('perc_desconto').AsFloat := 0;
        if (vItem.dataSet.FieldByName('valor_total').AsFloat > 0) then
          vItem.dataSet.FieldByName('perc_desconto').AsFloat :=
            vItem.dataSet.FieldByName('rateio_desconto').AsFloat /
            vItem.dataSet.FieldByName('valor_total').AsFloat * 100;
        vItem.dataSet.Post;
      end;
      vItem.dataSet.Next;
    end;
    //Acertando as casas decimais do valor de desconto
    if dataSet.State in [dsInsert, dsEdit] then
    begin
      if (dataSet.FieldByName('tipo_desconto').AsString = 'I') then
      begin
        dataSet.FieldByName('valor_desc_s').AsFloat := StrToFloat(Format('%0.2f',
          [FCalculoImposto.FValorDescontoServ]));
        dataSet.FieldByName('valor_desc_p').AsFloat := StrToFloat(Format('%0.2f',
          [FCalculoImposto.FValorDescontoProd]));
        dataSet.FieldByName('valor_desc').AsFloat := dataSet.FieldByName('valor_desc_p').AsFloat +
          dataSet.FieldByName('valor_desc_s').AsFloat;
      end
      else
      begin
        dataSet.FieldByName('valor_desc_s').AsFloat := StrToFloat(Format('%0.2f',
          [dataSet.FieldByName('valor_desc_s').AsFloat]));
        dataSet.FieldByName('valor_desc_p').AsFloat := StrToFloat(Format('%0.2f',
          [dataSet.FieldByName('valor_desc_p').AsFloat]));
      end;
    end;
    //Aplicando Descontos nos Itens e somando o valor liquido da nota fiscal
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;

      FCalculoImposto.vValorDesconto  := FCalculoImposto.vValorDesconto + (vItem.dataSet.FieldByName('rateio_desconto').AsFloat);
      FCalculoImposto.vValorLiquidoNF := FCalculoImposto.vValorLiquidoNF +
                                         vItem.ffloat('valor_total') -
                                         vItem.ffloat('rateio_desconto');
      vItem.dataSet.Next;
      if (dataSet.FieldByName('valor_desc').AsFloat > 0) and (vItem.dataSet.Eof) then
      begin
        if (dataSet.FieldByName('VALOR_DESC').AsFloat <> FCalculoImposto.vValorDesconto) then
        begin
          vdif := (dataSet.FieldByName('VALOR_DESC').AsFloat - FCalculoImposto.vValorDesconto);
          while not vItem.dataSet.bof do
          begin
            if vItem.dataSet.FieldByName('indtot').Value = 0 then
            begin
              vItem.dataSet.Prior;
              Continue;
            end;
            if vItem.dataSet.FieldByName('rateio_desconto').AsFloat > Abs(vdif) then
            begin
              FCalculoImposto.vValorLiquidoNF := FCalculoImposto.vValorLiquidoNF + ((-1) * vdif);
              vItem.dataSet.Edit;
              vItem.dataSet.FieldByName('rateio_desconto').AsFloat :=
                vItem.dataSet.FieldByName('rateio_desconto').AsFloat + vdif;
              vItem.dataSet.Post;
              Break;
            end;
            vItem.dataSet.Prior;
          end;
          vItem.dataSet.Last;
        end;
      end;
    end;
    //Aplicando Rateios nos Itens
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('indtot').Value = 0 then
      begin
        vItem.dataSet.Next;
        Continue;
      end;
      if (dataSet.FieldByName('VALOR_FRETE').AsFloat > 0) or
        (dataSet.FieldByName('VALOR_SEGURO').AsFloat > 0) or
        (dataSet.FieldByName('VALOR_OUT_DESP').AsFloat > 0) or
        //    (dataSet.FieldByName('VALOR_IPI').AsFloat > 0) or
      (dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat > 0) or
        (dataSet.FieldByName('VALOR_DESP_PF').AsFloat > 0) then
      begin
        vItem.dataSet.Edit;
        if (fstr('tipo_seguro') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat := 0;
        if (fstr('tipo_outdesp') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat := 0;
        if (fstr('tipo_frete') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat := 0;
        vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat := 0;
        if (fstr('tipo_desppf') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat := 0;
        if (ffloat('VALOR_SEGURO') > 0) and (vItem.fstr('tipo_item') <>  'S') and
          (fstr('tipo_seguro') <> 'I') then
        begin
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('VALOR_SEGURO').AsFloat / FCalculoImposto.vValorProdutos *
            vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
          FCalculoImposto.vValorSeguro := FCalculoImposto.vValorSeguro +
            vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat
        end
        else if (vItem.fstr('tipo_item') <> 'S') and (fstr('tipo_seguro') = 'I') then
          FCalculoImposto.vValorSeguro := FCalculoImposto.vValorSeguro + vItem.ffloat('rateio_seguro');

        if (ffloat('VALOR_OUT_DESP') > 0) and
           (fstr('tipo_outdesp') <> 'I') then
        begin
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('VALOR_OUT_DESP').AsFloat / (FCalculoImposto.vValorProdutos +
            FCalculoImposto.vValorServicos) *
            vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
          FCalculoImposto.vValorOutDesp := FCalculoImposto.vValorOutDesp +
            vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat;
        end
        else if (fstr('tipo_outdesp') = 'I') then
          FCalculoImposto.vValorOutDesp := FCalculoImposto.vValorOutDesp + vItem.ffloat('rateio_outdesp');

        if (ffloat('VALOR_FRETE') > 0) and (vItem.fstr('tipo_item') <> 'S') and
           (fstr('tipo_frete') <> 'I') then
        begin
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('VALOR_FRETE').AsFloat / FCalculoImposto.vValorProdutos *
            vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
          FCalculoImposto.vValorFrete := FCalculoImposto.vValorFrete +
            vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat;
        end
        else if (vItem.fstr('tipo_item') <> 'S') and (fstr('tipo_frete') = 'I') then
          FCalculoImposto.vValorFrete := FCalculoImposto.vValorFrete + vItem.ffloat('rateio_frete');

        if (dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat > 0) then
        begin
          vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat / (FCalculoImposto.vValorProdutos +
            FCalculoImposto.vValorServicos) *
            vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
          FCalculoImposto.vValorAcresFin := FCalculoImposto.vValorAcresFin +
            vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat;
        end;
        
        if (ffloat('valor_desp_pf') > 0) and
           (fstr('tipo_desppf') <> 'I') then
        //if (dataSet.FieldByName('VALOR_DESP_PF').AsFloat > 0) then
        begin
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat := vDadosIni.StrToFloatFormat(
            dataSet.FieldByName('VALOR_DESP_PF').AsFloat / (FCalculoImposto.vValorProdutos +
            FCalculoImposto.vValorServicos) *
            vItem.dataSet.FieldByName('valor_total').AsFloat, 2);
          FCalculoImposto.vValorOutDespPF := FCalculoImposto.vValorOutDespPF +
            vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat;
        end
        else if (fstr('tipo_desppf') = 'I') then
          FCalculoImposto.vValorOutDespPF := FCalculoImposto.vValorOutDespPF + vItem.ffloat('rateio_desp_pf');

        vItem.dataSet.Post;
      end
      else
      begin
        vItem.dataSet.Edit;
        if (fstr('tipo_seguro') <> 'I') then        
          vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat    := 0
        else if (vItem.fstr('tipo_item') <> 'S') then
          FCalculoImposto.vValorSeguro := FCalculoImposto.vValorSeguro + vItem.ffloat('rateio_seguro');
        if (fstr('tipo_outdesp') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat   := 0
        else 
          FCalculoImposto.vValorOutDesp := FCalculoImposto.vValorOutDesp + vItem.ffloat('rateio_outdesp');
        if (fstr('tipo_frete') <> 'I') then          
          vItem.dataSet.FieldByName('RATEIO_FRETE').AsFloat     := 0  
        else if (vItem.fstr('tipo_item') <> 'S') then
          FCalculoImposto.vValorFrete := FCalculoImposto.vValorFrete + vItem.ffloat('rateio_frete');        
        vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat := 0;
        
        if (fstr('tipo_desppf') <> 'I') then
          vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat := 0
        else
          FCalculoImposto.vValorOutDespPF := FCalculoImposto.vValorOutDespPF + vItem.ffloat('rateio_desp_pf');

        vItem.dataSet.Post;
      end;

      vItem.dataSet.Next;
      //Caso haja alguma diferença no rateio o sistema irá jogar a diferença
      //no ultimo registro
      if ( ((ffloat('VALOR_FRETE')    > 0) and (fstr('tipo_frete'  ) <> 'I')) or
           ((ffloat('VALOR_SEGURO')   > 0) and (fstr('tipo_seguro' ) <> 'I')) or
           ((ffloat('VALOR_OUT_DESP') > 0) and (fstr('tipo_outdesp') <> 'I')) or
           ((ffloat('VALOR_DESP_PF')  > 0) and (fstr('tipo_desppf' ) <> 'I')) or
        //    (dataSet.FieldByName('VALOR_IPI').AsFloat > 0) or
        (dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat > 0)) and (vItem.dataSet.Eof) then
      begin
        if fstr('tipo_seguro' ) <> 'I' then
          if (dataSet.FieldByName('VALOR_SEGURO').AsFloat <> FCalculoImposto.vValorSeguro) then
          begin
            vdif := (dataSet.FieldByName('VALOR_SEGURO').AsFloat - FCalculoImposto.vValorSeguro);
            vItem.dataSet.Edit;
            vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat :=
              vItem.dataSet.FieldByName('RATEIO_SEGURO').AsFloat + vdif;
            //          (dataSet.FieldByName('VALOR_SEGURO').AsFloat - FCalculoImposto.vValorSeguro);
            vItem.dataSet.Post;
            FCalculoImposto.vValorSeguro := dataSet.FieldByName('VALOR_SEGURO').AsFloat;
          end;
        if fstr('tipo_outdesp') <> 'I' then
          if (dataSet.FieldByName('VALOR_OUT_DESP').AsFloat <> FCalculoImposto.vValorOutDesp) then
          begin
            vdif := dataSet.FieldByName('VALOR_OUT_DESP').AsFloat - FCalculoImposto.vValorOutDesp;
            vItem.dataSet.Edit;
            vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat := vItem.dataSet.FieldByName('RATEIO_OUTDESP').AsFloat + vdif;
            vItem.dataSet.Post;
            FCalculoImposto.vValorOutDesp := dataSet.FieldByName('VALOR_OUT_DESP').AsFloat;
          end;
        if fstr('tipo_frete'  ) <> 'I' then
          if (dataSet.FieldByName('VALOR_FRETE').AsFloat <> FCalculoImposto.vValorFrete) then
          begin
            vdif := (dataSet.FieldByName('VALOR_FRETE').AsFloat - FCalculoImposto.vValorFrete);
            vItem.dataSet.Edit;
            vItem.dataSet.FieldByName('rateio_frete').AsFloat := vItem.dataSet.FieldByName('rateio_frete').AsFloat + vDif;
            vItem.dataSet.Post;
            FCalculoImposto.vValorFrete := dataSet.FieldByName('VALOR_FRETE').AsFloat;
          end;
        if (dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat <> FCalculoImposto.vValorAcresFin) then
        begin
          vdif := (dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat - FCalculoImposto.vValorAcresFin);
          vItem.dataSet.Edit;
          vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat := vItem.dataSet.FieldByName('RATEIO_ACRES_FIN').AsFloat + vdif;
          vItem.dataSet.Post;
          FCalculoImposto.vValorAcresFin := dataSet.FieldByName('VALOR_ACRES_FIN').AsFloat;
        end;
        if fstr('tipo_desppf'  ) <> 'I' then
          if (dataSet.FieldByName('VALOR_DESP_PF').AsFloat <> FCalculoImposto.vValorOutDespPF) then
          begin
            vdif := (dataSet.FieldByName('VALOR_DESP_PF').AsFloat - FCalculoImposto.vValorOutDespPF);
            vItem.dataSet.Edit;
            vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat := vItem.dataSet.FieldByName('RATEIO_DESP_PF').AsFloat + vdif;
            vItem.dataSet.Post;
            FCalculoImposto.vValorOutDespPF := dataSet.FieldByName('VALOR_DESP_PF').AsFloat;
          end;
        vItem.dataSet.Next;
      end; //if vItem.DataSet.Eof then

    end; //while not vItem.DataSet.Eof do
    if (dataSet.State in [dsInsert, dsEdit])
      and (dataSet.FieldByName('natureza_nf').AsString = 'S') then
      dataSet.FieldByName('valor_prod').AsFloat := FCalculoImposto.vValorProdutos;

    if fstr('tipo_frete'  ) = 'I' then dataSet.FieldByName('VALOR_FRETE').AsFloat    := FCalculoImposto.vValorFrete;
    if fstr('tipo_seguro' ) = 'I' then dataSet.FieldByName('VALOR_SEGURO').AsFloat   := FCalculoImposto.vValorSeguro;
    if fstr('tipo_outdesp') = 'I' then dataSet.FieldByName('VALOR_OUT_DESP').AsFloat := FCalculoImposto.vValorOutDesp;
    if fstr('tipo_desppf' ) = 'I' then dataSet.FieldByName('VALOR_DESP_PF').AsFloat  := FCalculoImposto.vValorOutDespPF;

    //if FConfig.versao_calc = 2 then
    Fcalc_fat.calculo_faturamento_completo_obterdados(forceGetData);

    retAvaliador.Inicializar(vItem.dataSet.RecordCount);

    vItem.dataSet.First;
    while not vItem.DataSet.Eof do
    begin
      vItem.alterar;
      //if //(FConfig.versao_calc = 2) and
        //(vItem.f_str('tipo_item') = 'P') then
      try
        vItem.vrDadosItem.manterRateio := True;
        Fcalc_fat.calculo_faturamento_individual_executar(True);
      finally
        vItem.vrDadosItem.manterRateio := False;
      end;
      //else
        //calcularValores;
      if vItem.Edit then
      begin
        if dataSet.FieldByName('natureza_nf').AsString = 'S' then
        begin
          if vItem.vrDadosItem.cst_ipi = '' then
            if vItem.vrDadosItem.aliq_ipi > 0 then
              vItem.vrDadosItem.cst_ipi := '50'
            else
              vItem.vrDadosItem.cst_ipi := '52';
        end
        else
        begin
          if vItem.vrDadosItem.cst_ipi = '' then
            if vItem.vrDadosItem.aliq_ipi > 0 then
              vItem.vrDadosItem.cst_ipi := '00'
            else
              vItem.vrDadosItem.cst_ipi := '02'
        end;
        vItem.setDadosIntemNF();
        vItem.post;
      end;
      
      {$REGION 'Novos Campos RTC'}
      
      if vItem.vrDadosItem.tributosRTC <> nil then
      begin
        if (vItem.vrDadosItem.tributosRTC.IbsCbs <> nil)
          and (vItem.vrDadosItem.tributosRTC.IbsCbs <> nil)
        then
        begin
          if (vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs <> nil) then
          begin
            FCalculoImposto.vbcibscbs := FCalculoImposto.vbcibscbs +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.VBc;
            //IBS
            FCalculoImposto.ibsuf_vdif := FCalculoImposto.ibsuf_vdif +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsUfVdif.Value;
            FCalculoImposto.ibsuf_vdevtrib := FCalculoImposto.ibsuf_vdevtrib +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsUfVDevTrib.Value;
            FCalculoImposto.vibsuf := FCalculoImposto.vibsuf +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.VIbsUf;
            FCalculoImposto.ibsmun_vdif := FCalculoImposto.ibsmun_vdif +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsMunVdif.Value;
            FCalculoImposto.ibsmun_vdevtrib := FCalculoImposto.ibsmun_vdevtrib +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsMunVDevTrib.Value;
            FCalculoImposto.vibsmun := FCalculoImposto.vibsmun +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.VIbsmun;
            FCalculoImposto.vibs := FCalculoImposto.vibs +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.VIbs;
            //CBS
            FCalculoImposto.cbs_vdif := FCalculoImposto.cbs_vdif +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.CbsVdif.Value;
            FCalculoImposto.cbs_vdevtrib := FCalculoImposto.cbs_vdevtrib +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.CbsVDevTrib.Value;
            FCalculoImposto.vcbs := FCalculoImposto.vcbs +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.vcbs;
            FCalculoImposto.ibsmun_vdif := FCalculoImposto.ibsmun_vdif +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsMunVdif.Value;
            FCalculoImposto.ibsmun_vdevtrib := FCalculoImposto.ibsmun_vdevtrib +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.IbsMunVDevTrib.Value;
            FCalculoImposto.vibsmun := FCalculoImposto.vibsmun +
              vItem.vrDadosItem.tributosRTC.IbsCbs.GIbsCbs.VIbsmun;
          end;

          //Credito  Presumido
          if (vItem.vrDadosItem.tributosRTC.IbsCbs.CredPresOp <> nil) then
          begin
            FCalculoImposto.ibs_vcredpres := FCalculoImposto.ibs_vcredpres +
              vItem.vrDadosItem.tributosRTC.IbsCbs.CredPresOp.IbsVcredpres.Value;
            FCalculoImposto.ibs_vcredprescondsus := FCalculoImposto.ibs_vcredprescondsus +
              vItem.vrDadosItem.tributosRTC.IbsCbs.CredPresOp.IbsVcredprescondsus.Value;

            FCalculoImposto.cbs_vcredpres := FCalculoImposto.cbs_vcredpres +
              vItem.vrDadosItem.tributosRTC.IbsCbs.CredPresOp.CbsVcredpres.Value;
            FCalculoImposto.cbs_vcredprescondsus := FCalculoImposto.cbs_vcredprescondsus +
              vItem.vrDadosItem.tributosRTC.IbsCbs.CredPresOp.CbsVcredprescondsus.Value;
          end;

          //Monofasia
          if (vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia <> nil) then
          begin
            FCalculoImposto.vibsmono := FCalculoImposto.vibsmono +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vibsmono.Value;
            FCalculoImposto.vcbsmono := FCalculoImposto.vcbsmono +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vcbsmono.Value;
            FCalculoImposto.vibsmonoreten := FCalculoImposto.vibsmonoreten +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vibsmonoreten.Value;
            FCalculoImposto.vcbsmonoreten := FCalculoImposto.vcbsmonoreten +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vcbsmonoreten.Value;
            FCalculoImposto.vibsmonoret := FCalculoImposto.vibsmonoret +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vibsmonoret.Value;
            FCalculoImposto.vcbsmonoret := FCalculoImposto.vcbsmonoret +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vcbsmonoret.Value;
            FCalculoImposto.vcbsmonoret := FCalculoImposto.vcbsmonoret +
              vItem.vrDadosItem.tributosRTC.IbsCbs.Monofasia.Vcbsmonoret.Value;

          end;

          //Estorno de credito
          FCalculoImposto.vibsestcred := FCalculoImposto.vibsestcred +
            vItem.vrDadosItem.tributosRTC.IbsCbs.VIbsEstCred.Value;
          FCalculoImposto.vcbsestcred := FCalculoImposto.vcbsestcred +
            vItem.vrDadosItem.tributosRTC.IbsCbs.VCbsEstCred.Value;
        end;
        if (vItem.vrDadosItem.tributosRTC.ImpostoSeletivo <> nil)
          and (vItem.vrDadosItem.tributosRTC.ImpostoSeletivo <> nil)
        then
        begin
          FCalculoImposto.vis := FCalculoImposto.vis +
            vItem.vrDadosItem.tributosRTC.ImpostoSeletivo.Vis.Value;
        end;
      end;

      FCalculoImposto.vnftot := FCalculoImposto.vnftot + vItem.ffloat('vitem');

      {$ENDREGION}

      vItem.cancelar;

      // Somatorio dos Atributos para apresentar a diferenca quando nota fiscal de entrada
      //Ou para atribuir nos valores do cabeçalho quando nova fiscal de saida
      FCalculoImposto.vBaseICMS    := FCalculoImposto.vBaseICMS    + vItem.dataSet.FieldByName('base_icm').AsFloat;
      FCalculoImposto.vBaseIPI     := FCalculoImposto.vBaseIPI     + vItem.dataSet.FieldByName('base_ipi').AsFloat;
      FCalculoImposto.vBaseISS     := FCalculoImposto.vBaseISS     + vItem.dataSet.FieldByName('base_iss').AsFloat;
      FCalculoImposto.vValorICM    := FCalculoImposto.vValorICM    + vItem.dataSet.FieldByName('valor_icm').AsFloat;
      FCalculoImposto.vICMDeson    := FCalculoImposto.vICMDeson    + vItem.dataSet.FieldByName('vicmdeson').AsFloat;
      FCalculoImposto.vpisdeson    := FCalculoImposto.vpisdeson    + vItem.dataSet.FieldByName('vpisdeson').AsFloat;
      FCalculoImposto.vcofinsdeson := FCalculoImposto.vcofinsdeson + vItem.dataSet.FieldByName('vcofinsdeson').AsFloat;
      if vItem.dataSet.FieldByName('indtot').Value <> 0 then
        if Trim(vItem.dataSet.FieldByName('antec_trib').AsString) = 'S' then
        begin
          FCalculoImposto.vValorICMSubAntecipado := FCalculoImposto.vValorICMSubAntecipado + vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('valor_icmsub_ant').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat, 2);
          FCalculoImposto.vBaseICMSSubAntecipado := FCalculoImposto.vBaseICMSSubAntecipado + vDadosIni.StrToFloatFormat(vItem.dataSet.FieldByName('base_icmsub_ant').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat, 2);
        end
        else
        begin
          FCalculoImposto.vBaseICMSSub := FCalculoImposto.vBaseICMSSub + vItem.dataSet.FieldByName('base_icmsub').AsFloat;
          FCalculoImposto.vValorICMSub := FCalculoImposto.vValorICMSub + vItem.dataSet.FieldByName('valor_icmsub').AsFloat;
        end;
      FCalculoImposto.vValorIPI        := FCalculoImposto.vValorIPI        + vItem.dataSet.FieldByName('valor_ipi').AsFloat;
      FCalculoImposto.vValorISS        := FCalculoImposto.vValorISS        + vItem.dataSet.FieldByName('valor_iss').AsFloat;
      FCalculoImposto.vBaseICMSimples  := FCalculoImposto.vBaseICMSimples  + vItem.dataSet.FieldByName('base_icm_simples').AsFloat;
      FCalculoImposto.vValorICMSimples := FCalculoImposto.vValorICMSimples + vItem.dataSet.FieldByName('valor_icm_simples').AsFloat;
      FCalculoImposto.vValorPIS        := FCalculoImposto.vValorPIS        + IfThen(not vItem.fstrin('cst_pis', ['05', '75']), vItem.ffloat('valor_pis'));
      FCalculoImposto.vValorCOFINS     := FCalculoImposto.vValorCOFINS     + IfThen(not vItem.fstrin('cst_pis', ['05', '75']), vItem.ffloat('valor_cofins'));
      FCalculoImposto.vValorII         := FCalculoImposto.vValorII         + vItem.dataSet.FieldByName('valor_ii').AsFloat;
      FCalculoImposto.vFCPUFDest       := FCalculoImposto.vFCPUFDest       + vItem.dataSet.FieldByName('vFCPUFDest').AsFloat;
      FCalculoImposto.vICMSUFDest      := FCalculoImposto.vICMSUFDest      + vItem.dataSet.FieldByName('vICMSUFDest').AsFloat;
      FCalculoImposto.vICMSUFRemet     := FCalculoImposto.vICMSUFRemet     + vItem.dataSet.FieldByName('vICMSUFRemet').AsFloat;
      FCalculoImposto.fcp_vfcp         := FCalculoImposto.fcp_vfcp         + vItem.dataSet.FieldByName('fcp_vfcp').AsFloat;
      FCalculoImposto.fcp_vfcpst       := FCalculoImposto.fcp_vfcpst       + vItem.dataSet.FieldByName('fcp_vfcpst').AsFloat;
      FCalculoImposto.fcp_vfcpstret    := FCalculoImposto.fcp_vfcpstret    + RoundTo(vItem.ffloat('fcp_vfcpstret') * vItem.ffloat('quantidade'), -2);
      FCalculoImposto.ipi_vipidevol    := FCalculoImposto.ipi_vipidevol    + vItem.dataSet.FieldByName('nfe_vipidevol').AsFloat;
      FCalculoImposto.vtottrib         := FCalculoImposto.vtottrib         + vItem.dataSet.FieldByName('vtottrib').AsFloat;
      FCalculoImposto.peso_b           := FCalculoImposto.peso_b           + vItem.dataSet.FieldByName('peso_b').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat;
      FCalculoImposto.peso_l           := FCalculoImposto.peso_l           + vItem.dataSet.FieldByName('peso_l').AsFloat * vItem.dataSet.FieldByName('quantidade').AsFloat;
      FCalculoImposto.vpisst           := FCalculoImposto.vpisst           + IfThen(vItem.fequals('indsomapisst'   , '1'), vItem.ffloat('valor_pis_st'));
      FCalculoImposto.vcofinsst        := FCalculoImposto.vcofinsst        + IfThen(vItem.fequals('indsomacofinsst', '1'), vItem.ffloat('valor_cofins_st'));
      FCalculoImposto.qBCMono          := FCalculoImposto.qBCMono          + vItem.dataSet.FieldByName('qbcmono').AsFloat;
      FCalculoImposto.vICMSMono        := FCalculoImposto.vICMSMono        + vItem.dataSet.FieldByName('vicmsmono').AsFloat;
      FCalculoImposto.qBCMonoReten     := FCalculoImposto.qBCMonoReten     + vItem.dataSet.FieldByName('qbcmonoreten').AsFloat;
      FCalculoImposto.vICMSMonoReten   := FCalculoImposto.vICMSMonoReten   + vItem.dataSet.FieldByName('vicmsmonoreten').AsFloat;
      FCalculoImposto.qBCMonoRet       := FCalculoImposto.qBCMonoRet       + vItem.dataSet.FieldByName('qbcmonoret').AsFloat;
      FCalculoImposto.vICMSMonoRet     := FCalculoImposto.vICMSMonoRet     + vItem.dataSet.FieldByName('vicmsmonoret').AsFloat;
      FCalculoImposto.vBCIRRF          := FCalculoImposto.vBCIRRF          + vItem.dataSet.FieldByName('vbcretfed').AsFloat;
      FCalculoImposto.vIRRF            := FCalculoImposto.vIRRF            + vItem.dataSet.FieldByName('vretir').AsFloat;
      FCalculoImposto.vRetCSLL         := FCalculoImposto.vRetCSLL         + vItem.dataSet.FieldByName('vretcsll').AsFloat;
      FCalculoImposto.vRetPIS          := FCalculoImposto.vRetPIS          + vItem.dataSet.FieldByName('vretpis').AsFloat;
      FCalculoImposto.vRetCOFINS       := FCalculoImposto.vRetCOFINS       + vItem.dataSet.FieldByName('vretcofins').AsFloat;

      retAvaliador.Add('IR'    , vItem.ffloat('pretir')    , vItem.ffloat('vbcretfed'));
      retAvaliador.Add('CSLL'  , vItem.ffloat('pretcsll')  , vItem.ffloat('vbcretfed'));
      retAvaliador.Add('PIS'   , vItem.ffloat('pretpis')   , vItem.ffloat('vbcretfed'));
      retAvaliador.Add('COFINS', vItem.ffloat('pretcofins'), vItem.ffloat('vbcretfed'));

      if vItem.dataSet.FieldByName('tipo_item').AsString = 'V' then
        AValorPISCOFINS := AValorPISCOFINS + vItem.vDetVeic.dataSet.FieldByName('piscofins').AsFloat;

      FCalculoImposto.vValorICMSRecomposicao := FCalculoImposto.vValorICMSRecomposicao + vItem.ffloat('icms_recomposicao');
      vItem.DataSet.Next;
    end;

    dSum := RoundTo(FCalculoImposto.vIRRF + FCalculoImposto.vRetCSLL + FCalculoImposto.vRetPIS + FCalculoImposto.vRetCOFINS, -2);
    if (dSum > 0) and
      ((fint('ret_fed') = Ord(rfSemRetencao)) or
      ((fint('ret_fed') = Ord(rfComRetencaoMin10)) and (dSum < 10)))  then
    begin
      vItem.dataSet.First;
      while not vItem.dataSet.Eof do
      begin
        vItem.dataSet.Edit;
        vItem.dataSet.FieldByName('vbcretfed').AsFloat  := 0;
        vItem.dataSet.FieldByName('vretir').AsFloat     := 0;
        vItem.dataSet.FieldByName('vretcsll').AsFloat   := 0;
        vItem.dataSet.FieldByName('vretpis').AsFloat    := 0;
        vItem.dataSet.FieldByName('vretcofins').AsFloat := 0;
        vItem.dataSet.Post;

        vItem.dataSet.Next;
      end;

      FCalculoImposto.vBCIRRF    := 0;
      FCalculoImposto.vIRRF      := 0;
      FCalculoImposto.vRetCSLL   := 0;
      FCalculoImposto.vRetPIS    := 0;
      FCalculoImposto.vRetCOFINS := 0;

      retAvaliador.Inicializar(0);
    end;

    //Aplicando somatorios no cabecalho da nota
    if (dataSet.State in [dsInsert, dsEdit]) then
    begin
      //if (dataSet.FieldByName('natureza_nf').AsString = 'S') then

      dataSet.FieldByName('qbcmono').AsFloat        := FCalculoImposto.qBCMono;
      dataSet.FieldByName('vicmsmono').AsFloat      := FCalculoImposto.vICMSMono;
      dataSet.FieldByName('qbcmonoreten').AsFloat   := FCalculoImposto.qBCMonoReten;
      dataSet.FieldByName('vicmsmonoreten').AsFloat := FCalculoImposto.vICMSMonoReten;
      dataSet.FieldByName('qbcmonoret').AsFloat     := FCalculoImposto.qBCMonoRet;
      dataSet.FieldByName('vicmsmonoret').AsFloat   := FCalculoImposto.vICMSMonoRet;

      {$REGION 'Novos Campos RTC'}
      dataSet.FieldByName('vnftot').AsFloat               := FCalculoImposto.vnftot;
      dataSet.FieldByName('vbcibscbs').AsFloat            := FCalculoImposto.vbcibscbs;
      dataSet.FieldByName('ibsuf_vdif').AsFloat           := FCalculoImposto.ibsuf_vdif;
      dataSet.FieldByName('ibsuf_vdevtrib').AsFloat       := FCalculoImposto.ibsuf_vdevtrib;
      dataSet.FieldByName('vibsuf').AsFloat               := FCalculoImposto.vibsuf;
      dataSet.FieldByName('ibsmun_vdif').AsFloat          := FCalculoImposto.ibsmun_vdif;
      dataSet.FieldByName('ibsmun_vdevtrib').AsFloat      := FCalculoImposto.ibsmun_vdevtrib;
      dataSet.FieldByName('vibsmun').AsFloat              := FCalculoImposto.vibsmun;
      dataSet.FieldByName('vibs').AsFloat                 := FCalculoImposto.vibs;
      dataSet.FieldByName('ibs_vcredpres').AsFloat        := FCalculoImposto.ibs_vcredpres;
      dataSet.FieldByName('ibs_vcredprescondsus').AsFloat := FCalculoImposto.ibs_vcredprescondsus;
      dataSet.FieldByName('cbs_vdif').AsFloat             := FCalculoImposto.cbs_vdif;
      dataSet.FieldByName('cbs_vdevtrib').AsFloat         := FCalculoImposto.cbs_vdevtrib;
      dataSet.FieldByName('vcbs').AsFloat                 := FCalculoImposto.vcbs;
      dataSet.FieldByName('cbs_vcredpres').AsFloat        := FCalculoImposto.cbs_vcredpres;
      dataSet.FieldByName('cbs_vcredprescondsus').AsFloat := FCalculoImposto.cbs_vcredprescondsus;
      dataSet.FieldByName('vibsmono').AsFloat             := FCalculoImposto.vibsmono;
      dataSet.FieldByName('vcbsmono').AsFloat             := FCalculoImposto.vcbsmono;
      dataSet.FieldByName('vibsmonoreten').AsFloat        := FCalculoImposto.vibsmonoreten;
      dataSet.FieldByName('vcbsmonoreten').AsFloat        := FCalculoImposto.vcbsmonoreten;
      dataSet.FieldByName('vibsmonoret').AsFloat          := FCalculoImposto.vibsmonoret;
      dataSet.FieldByName('vcbsmonoret').AsFloat          := FCalculoImposto.vcbsmonoret;
      dataSet.FieldByName('vibsestcred').AsFloat          := FCalculoImposto.vibsestcred;
      dataSet.FieldByName('vcbsestcred').AsFloat          := FCalculoImposto.vcbsestcred;
      dataSet.FieldByName('vis').AsFloat                  := FCalculoImposto.vis;
      {$ENDREGION}

      if (get_emissao_propria = 'S') then
      begin                   //23-icmdes-basesimples-valorsimples - valorserv= 19
                              //frete, serg outros, desconto                  = 4    23
        dataSet.FieldByName('base_icm').AsFloat          := FCalculoImposto.vBaseICMS;
        dataSet.FieldByName('base_icmsub').AsFloat       := FCalculoImposto.vBaseICMSSub;
        dataSet.FieldByName('base_ipi').AsFloat          := FCalculoImposto.vBaseIPI;
        dataSet.FieldByName('base_iss').AsFloat          := FCalculoImposto.vBaseISS;
        dataSet.FieldByName('valor_icm').AsFloat         := FCalculoImposto.vValorICM;
        dataSet.FieldByName('vicmdeson').AsFloat         := FCalculoImposto.vICMDeson;
        dataSet.FieldByName('valor_icmsub').AsFloat      := FCalculoImposto.vValorICMSub;
        dataSet.FieldByName('valor_ipi').AsFloat         := FCalculoImposto.vValorIPI;
        dataSet.FieldByName('valor_iss').AsFloat         := FCalculoImposto.vValorISS;
        dataSet.FieldByName('valor_prod').AsFloat        := FCalculoImposto.vValorProdutos;
        dataSet.FieldByName('valor_serv').AsFloat        := FCalculoImposto.vValorServicos;
        dataSet.FieldByName('base_icm_simples').AsFloat  := FCalculoImposto.vBaseICMSimples;
        dataSet.FieldByName('valor_icm_simples').AsFloat := FCalculoImposto.vValorICMSimples;
        dataSet.FieldByName('valor_pis').AsFloat         := FCalculoImposto.vValorPIS;
        dataSet.FieldByName('valor_cofins').AsFloat      := FCalculoImposto.vValorCOFINS;
        dataSet.FieldByName('vpisdeson').AsFloat         := FCalculoImposto.vpisdeson;
        dataSet.FieldByName('vcofinsdeson').AsFloat      := FCalculoImposto.vcofinsdeson;
        dataSet.FieldByName('valor_ii').AsFloat          := FCalculoImposto.vValorII;
        dataSet.FieldByName('vFCPUFDest').AsFloat        := FCalculoImposto.vFCPUFDest;
        dataSet.FieldByName('vICMSUFDest').AsFloat       := FCalculoImposto.vICMSUFDest;
        dataSet.FieldByName('vICMSUFRemet').AsFloat      := FCalculoImposto.vICMSUFRemet;
        dataSet.FieldByName('fcp_vfcp').AsFloat          := FCalculoImposto.fcp_vfcp;
        dataSet.FieldByName('fcp_vfcpst').AsFloat        := FCalculoImposto.fcp_vfcpst;
        dataSet.FieldByName('fcp_vfcpstret').AsFloat     := FCalculoImposto.fcp_vfcpstret;
        dataSet.FieldByName('ipi_vipidevol').AsFloat     := FCalculoImposto.ipi_vipidevol;
        dataSet.FieldByName('vtottrib').AsFloat          := FCalculoImposto.vtottrib;
        dataSet.FieldByName('valor_pis_st').AsFloat      := FCalculoImposto.vpisst;
        dataSet.FieldByName('valor_cofins_st').AsFloat   := FCalculoImposto.vcofinsst;
        dataSet.FieldByName('base_irrf').AsFloat         := FCalculoImposto.vBCIRRF;
        dataSet.FieldByName('valor_irrf').AsFloat        := retAvaliador.ObterCalculo('IR'); //FCalculoImposto.vIRRF;
        dataSet.FieldByName('vretcsll').AsFloat          := retAvaliador.ObterCalculo('CSLL'); //FCalculoImposto.vRetCSLL;
        dataSet.FieldByName('vretpis').AsFloat           := retAvaliador.ObterCalculo('PIS');  //FCalculoImposto.vRetPIS;
        dataSet.FieldByName('vretcofins').AsFloat        := retAvaliador.ObterCalculo('COFINS'); //FCalculoImposto.vRetCOFINS;

        if not Config.Conf_Geral.nf_s_hab_digitacao_peso then
        begin
          dataSet.FieldByName('peso_b').AsFloat            := FCalculoImposto.peso_b;
          dataSet.FieldByName('peso_l').AsFloat            := FCalculoImposto.peso_l;
        end;

        if not fValorNotaAlterado then
          dataSet.FieldByName('valor_total').AsFloat :=
            RoundTo(
              FCalculoImposto.vValorLiquidoNF +
              FCalculoImposto.vValorICMSub +
              dataSet.FieldByName('valor_seguro').AsFloat +
              dataSet.FieldByName('valor_ipi').AsFloat +
              FCalculoImposto.vValorII +
              FCalculoImposto.fcp_vfcpst +
              FCalculoImposto.ipi_vipidevol +
              FCalculoImposto.vpisst +
              FCalculoImposto.vcofinsst +
              FCalculoImposto.vICMSMonoReten +
              dataSet.FieldByName('valor_out_desp').AsFloat +
              IfThen(fdif('frete_f_nfe', 'S'), ffloat('valor_frete')) -
              (IfThen(fdif('totais_com_deson', 'N'), FCalculoImposto.vICMDeson) + FCalculoImposto.vpisdeson + FCalculoImposto.vcofinsdeson)
             , -2);
      end;                                                           
    end;
    if (dataSet.FieldByName('natureza_nf').AsString = 'E') then
    begin
      {
      if (copy(Trim(dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString),1,1) = '') and
        (( (dataSet.FieldByName('valor_pis_st').AsFloat + dataSet.FieldByName('valor_cofins_st').AsFloat ) > 0) or
        (AValorPISCOFINS > 0 )) then
      begin
        dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString := _LerConfiguracoesRegistroString('ADD_PISCOFINS_ST_TOTALNF');

        if (copy(Trim(dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString),1,1) = '') then
          if Application.MessageBox(pchar('Adicionar valor de PIS e COFIS ST ao Total da Nota Fiscal?'),'Confirmação', 32 + 4 + MB_DEFBUTTON2) =  IDYES then
            dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString := 'S'
          else
            dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString := 'N';
      end;
      }

      FCalculoImposto.vValorLiquidoNF := FCalculoImposto.vValorLiquidoNF +
                                         FCalculoImposto.vValorICMSub    + FCalculoImposto.vValorIPI +
                                         FCalculoImposto.vValorSeguro    + FCalculoImposto.vValorOutDesp +
                                         FCalculoImposto.fcp_vfcpst      + FCalculoImposto.ipi_vipidevol +
                                         FCalculoImposto.vpisst          + FCalculoImposto.vcofinsst +
                                         FCalculoImposto.vValorII  +
                                         FCalculoImposto.vICMSMonoReten  +
                                         IfThen(dataSet.FieldByName('frete_f_nfe').AsString <> 'S', FCalculoImposto.vValorFrete) -
                                         (IfThen(fdif('totais_com_deson', 'N'), FCalculoImposto.vICMDeson) + FCalculoImposto.vpisdeson + FCalculoImposto.vcofinsdeson);
      FCalculoImposto.vValorLiquidoNF := RoundTo(FCalculoImposto.vValorLiquidoNF, -2);

//      if (dataSet.FieldByName('valor_pis_st').AsFloat + dataSet.FieldByName('valor_cofins_st').AsFloat) > 0 then
//        AValorPISCOFINS := dataSet.FieldByName('valor_pis_st').AsFloat + dataSet.FieldByName('valor_cofins_st').AsFloat;
//
//      if copy(Trim(dataSet.FieldByName('ADD_PISCOFINS_ST_TOTALNF').AsString),1,1) = 'S' then
//        FCalculoImposto.vValorLiquidoNF := RoundTo(FCalculoImposto.vValorLiquidoNF + AValorPISCOFINS, -2);

      if fequals('natureza_nf', 'E') and fempty('totais_com_deson') then
      begin
        if ffloat('vicmdeson') > 0 then
        begin
          vdif := Abs(ffloat('valor_total') - FCalculoImposto.vValorLiquidoNF);
          if Abs(vdif - ffloat('vicmdeson')) <= 0.1 then
          begin
            FCalculoImposto.vValorLiquidoNF := FCalculoImposto.vValorLiquidoNF + FCalculoImposto.vICMDeson;
            dataSet.FieldByName('totais_com_deson').AsString := 'N';
          end                                                       
          else
            dataSet.FieldByName('totais_com_deson').AsString := 'S';
        end;
      end;
    end;
  except
    on e: Exception do
    begin
      Result := false;
      Application.messagebox(pchar('Erro ao efetuar calculo da nota fiscal.' + sLineBreak +
        'Verifique os valores digitados. Pode existir valores zerados' + sLineBreak +
        'Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' salvaDadosVeiculo ' + e.Message);
    end;
  end;
end;

