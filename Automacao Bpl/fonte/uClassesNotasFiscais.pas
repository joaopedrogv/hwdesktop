procedure TNFCab.abrirCadastroObrigacoesICMSDifal(pDesconsiderarConf: Boolean);
var
  vLst: TStrings;
  I: Integer;
  vValor: Double;
begin
  if ((dataSet.FieldByName('VICMSUFDEST').AsFloat > 0) or (dataSet.FieldByName('VFCPUFDEST').AsFloat > 0)) and
    (vDadosIni.vEmp.vRegime <> 'SIMPLES') then
    if (vDadosIni.getConfSisBool('nf_hab_cad_obrig_sped_f_icmsdifal_fcp', buscas)) or (pDesconsiderarConf) then
    begin
      vLst := TStringList.Create;
      vLst := vDadosIni.getConfSisBlob('nf_hab_cad_obrig_sped_f_icmsdifal_fcp', buscas);
      if dataSet.FieldByName('cod_cliente').AsInteger <> vClFor.dataSet.FieldByName('cod_cliente').AsInteger then
        vClFor.selecionaClFor();
      if pDesconsiderarConf then
      begin
        if ((dataSet.FieldByName('VICMSUFDEST').AsFloat > 0) and
          (pos('|' + getUFdaOperacao + '|DIFAL|', vLst.Text) = 0)) then
          vLst.Add('|' + getUFdaOperacao + '|DIFAL|003||')
        else if ((dataSet.FieldByName('VFCPUFDEST').AsFloat > 0) and
          (pos('|' + getUFdaOperacao + '|FCP|', vLst.Text) = 0)) then
          vLst.Add('|' + getUFdaOperacao + '|FCP|006||');
      end;

      for I := 0 to vLst.Count - 1 do
        if vDadosIni.getValue(vLst[i], 1) = getUFdaOperacao then
        begin
          if Trim(vDadosIni.getValue(vLst[i], 2)) = 'DIFAL' then
            vValor := dataSet.FieldByName('VICMSUFDEST').AsFloat
          else if Trim(vDadosIni.getValue(vLst[i], 2)) = 'FCP' then
            vValor := dataSet.FieldByName('VFCPUFDEST').AsFloat
          else
            vValor := 0;

          if vValor > 0 then
          begin
            vDadosIni.vPesquisa := '|CAD_DIFAL_FCP|' + vDadosIni.getValue(vLst[I], 3) + '|' + vDadosIni.getValue(vLst[I], 4) + '|' +
              Format('%0.2f', [vValor]) + '|' +
              getUFdaOperacao + '|' +
              dataSet.FieldByName('cod_nf').AsString + '|' +
              vDadosIni.getValue(vLst[i], 2) + '|' +
              dataSet.FieldByName('num_nf').AsString + '|' ;
            vDadosIni.abreFormCadastro('pkSPED', 'TfrmCadSpedFObrigacoesDIFAL', True,
              'Tela de cadastro de Obrigações a recolher DIFAL / FCP já está aberta' + sLineBreak + sLineBreak +
              'Por favor efetue o cadastro desta obrigação a recolher manualmente ou feche a tela e repita o processo');
          end;
        end;
    end;
end;

procedure TNFCab.abrirFormPagamento;
var
  vFp2: TComunicacaoFormaPagamento;
  hdFormPag: THandle;
  vNumNota,vSerieNota:integer;
begin
  if (vDadosIni.vEmp.vModoFaturamento <> 'S') and (vDadosIni.vEmp.vConfFormPagamento = 'NF') then
  begin
      vNumNota := dataSet.FieldByName('num_nf').AsInteger;
      vSerieNota := StrToInt(Trim(dataSet.FieldByName('serie').AsString));

      if Trim(dataSet.FieldByName('modelo_nf').AsString) = '55' then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select NUM_NF_VNDANT, SUB_SERIEANT, NUM_NF, SERIE from notafiscal'+
          ' where natureza_nf = ''S'' and NUM_NF_VNDANT = '+dataSet.FieldByName('num_nf').AsString+
          ' and serie = '+QuotedStr(Trim(dataSet.FieldByName('serie').AsString))+
          ' and cod_empresa = '+vDadosIni.codEmpresa +' and ativo = 1'+
          ' and status = ' + QuotedStr(stsFechada);
        buscas.Open;
        if not buscas.IsEmpty then
        begin
          vNumNota := buscas.FieldByName('num_nf').AsInteger;
          try
            vSerieNota := StrToInt(Trim(buscas.FieldByName('serie').AsString));
          except
          end;
        end;
        buscas.Close;
      end;
    try
      CarregaPacote('pkFormPag', hdFormPag);
      vFp2 := TComunicacaoFormaPagamento.Create;
      vFp2.iniciaFormaPagamento(vNumNota,
        dataSet.FieldByName('cod_cond_pag').AsInteger, vSerieNota,
        dataSet.FieldByName('cod_cliente').AsInteger,
        dataSet.FieldByName('cod_usuario').AsInteger,
        'NF', dataSet.FieldByName('valor_total').AsCurrency);
    finally
      UnloadPackage(hdFormPag);
    end;
  end;
end;

