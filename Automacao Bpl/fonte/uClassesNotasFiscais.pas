function TNFCab.removerItemVeiculo: boolean;
var
  I: Integer;
  vTempDataSet: TClientDataSet;
  J: Integer;
begin
  if not vDadosIni.PesqPros('NF0058', 'EXCLUIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  if (not vItem.DataSet.Active) or (vItem.DataSet.RecordCount = 0) then
    exit;
  Result := False;
  if notaFechada then
  begin
    Application.MessageBox('Nota Fiscal já esta fechada. Nenhum item pode ser removido',
      'Atenção', MB_OK
      + MB_ICONINFORMATION);
    exit;
  end;

  if Application.MessageBox('Deseja mesmo remover o item da Nota Fiscal', 'Atenção', MB_YESNO
    + MB_ICONQUESTION) = ID_NO then
    Exit;

  if vItem.Delete then
  begin
    I := 1;
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vItem.dataSet.Edit;

//      vItem.vDetVeic.dataSet.First;
//      while not vItem.vDetVeic.dataSet.Eof do
//      begin
//        if vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger =
//          vItem.dataSet.FieldByName('nitem').AsInteger then
//        begin
//          vItem.vDetVeic.dataSet.Edit;
//          vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger := i;
//          vItem.vDetVeic.dataSet.Post;
//          Break;
//        end;
//        vItem.vDetVeic.dataSet.Next;
//      end;

      vItem.dataSet.FieldByName('nitem').AsInteger := i;
      vItem.dataSet.Post;
      vItem.dataSet.Next;
      Inc(i);
    end;

    vTempDataSet := TClientDataSet.Create(Application);
    vTempDataSet.FieldDefs.Clear;
    for I := 0 to vItem.vDetVeic.dataSet.FieldDefs.Count - 1 do
      vTempDataSet.FieldDefs.Add( vItem.vDetVeic.dataSet.FieldDefs[i].Name,
        vItem.vDetVeic.dataSet.FieldDefs[i].DataType, vItem.vDetVeic.dataSet.FieldDefs[i].Size, False);

    try
      vTempDataSet.CreateDataSet;
    except
    end;
    vTempDataSet.EmptyDataSet;
    vTempDataSet.IndexFieldNames := 'nitem';
        
    vItem.vDetVeic.dataSet.First;
    while not vItem.vDetVeic.dataSet.Eof do
    begin
      vTempDataSet.Insert;
      for I := 0 to vItem.vDetVeic.dataSet.FieldCount - 1 do
        if vItem.vDetVeic.dataSet.Fields[I].FieldKind = fkData then
          vTempDataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[I].FieldName).Value :=
            vItem.vDetVeic.dataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[I].FieldName).Value;
      vTempDataSet.Post;
      vItem.vDetVeic.dataSet.Next;
    end;
   
//    while not vItem.vDetVeic.dataSet.IsEmpty do
//      vItem.vDetVeic.dataSet.Delete;
    buscas.Close;
    buscas.SQL.Text := 'delete from notafiscal_item_veiculo' +
      ' where cod_nf = ' + IntToStr(dataSet.FieldByName('cod_nf').AsInteger)+
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.ExecSQL;

    vItem.vDetVeic.dataSet.CancelUpdates;
    vItem.vDetVeic.dataSet.Refresh;
     
    vTempDataSet.First;
    J:= 0;
    while not vTempDataSet.Eof do
    begin      
      inc(J);
      vItem.vDetVeic.dataSet.Insert;
      for I := 0 to vItem.vDetVeic.dataSet.FieldCount - 1 do
        if vItem.vDetVeic.dataSet.Fields[I].FieldKind = fkData then
          vItem.vDetVeic.dataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[I].FieldName).Value :=
            vTempDataSet.FieldByName(vItem.vDetVeic.dataSet.Fields[I].FieldName).Value;      
      vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger := J;
      vItem.vDetVeic.dataSet.Post;
      vTempDataSet.Next;
    end;

    vItem.vrDadosItem.nItem := vItem.dataSet.RecordCount + 1;
    somaTotaisNF;
    vItem.cancelar;
  end;
end;

