              buscas.ParamByName('VALOR').AsFloat :=
                vItem.vProd.dataSet.FieldByName('PREC_CUS_PROD').AsFloat;
              buscas.ParamByName('PREC_CUS_MED').AsFloat :=
                vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat;
              if (vItem.vProd.dataSet.FieldByName('PREC_CUS_MNF').AsFloat = 0) then
                buscas.ParamByName('PR_CUSC_PROD').AsFloat :=
                  vItem.vProd.dataSet.FieldByName('PREC_CUSM_PROD').AsFloat
              else
                buscas.ParamByName('PR_CUSC_PROD').AsFloat :=
                  vItem.vProd.dataSet.FieldByName('PREC_CUS_MNF').AsFloat;
            end;}
            buscas.Prepare;
            buscas.ExecSql;
          end;
        except
          on e: Exception do begin
            if Application.MessageBox(pchar('Erro ao Entrar com estoque do Produto: ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + sLineBreak +
              'Nota Fiscal não será confirmada. Certifique-se que o item não esteja travado por outro usuário' + sLineBreak
                +
              'Mostrar Erro?'), 'Atenção', MB_ICONEXCLAMATION + MB_YESNO) = IDYES then
              ShowMessage(e.Message);
            registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
              dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoque ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + ' '
              + e.Message);
            exit;
          end;
        end;
        try
          if vItem.dataSet.FieldByName('seq_devolucao').AsInteger > 0 then
          begin
            buscas.Close;
            buscas.SQL.Text := 'update DEVOLUCAO set QUANT_C = :QUANT_C,' +
              ' NUM_NOTA_NFE = :NUM_NOTA_NFE, COD_FORNECEDOR = :COD_FORNECEDOR, COD_NF = :COD_NF, NITEM_NF = :NITEM' +
              ' where grupo_prod = :grupo_prod and cod_prod = :cod_prod' +
              ' and SEQUENCIA = :SEQUENCIA AND cod_empresa = :cod_empresa and ativo=1 ' +
              ' and SEQID = :SEQID';
            buscas.ParamByName('QUANT_C').AsFloat :=
              vItem.dataSet.FieldByName('quantidade').AsFloat;
            buscas.ParamByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
            buscas.ParamByName('COD_FORNECEDOR').AsInteger :=
              dataSet.FieldByName('cod_cliente').AsInteger;
            buscas.ParamByName('grupo_prod').AsInteger :=
              vItem.dataSet.FieldByName('grupo_prod').AsInteger;
            buscas.ParamByName('cod_prod').AsString :=
              vItem.dataSet.FieldByName('cod_prod').AsString;
            buscas.ParamByName('SEQUENCIA').AsInteger :=
              vItem.dataSet.FieldByName('seq_devolucao').AsInteger;
            buscas.ParamByName('cod_empresa').AsInteger :=
              vItem.dataSet.FieldByName('cod_empresa').AsInteger;
           buscas.ParamByName('SEQID').AsInteger :=
              vItem.dataSet.FieldByName('SEQID_DEVOLUCAO').AsInteger;
           buscas.ParamByName('cod_nf').AsInteger :=
              vItem.dataSet.FieldByName('cod_nf').AsInteger;
           buscas.ParamByName('nitem').AsInteger :=
              vItem.dataSet.FieldByName('nitem').AsInteger;
            buscas.Prepare;
            buscas.ExecSql;
          end;
        except
          on e: Exception do begin
            if Application.MessageBox(pchar('Erro ao Alterar a devolução do Produto: ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + sLineBreak +
              'Nota Fiscal não será confirmada. Certifique-se que o item não esteja travado por outro usuário' + sLineBreak
                +
              'Mostrar Erro?'), 'Atenção', MB_ICONEXCLAMATION + MB_YESNO) = IDYES then
              ShowMessage(e.Message);
            registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
              dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoque Devolução ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + ' ' +
              e.Message);
            exit;
          end;
        end;
        try
          buscas.Close;
          buscas.SQL.Text := 'delete from venda_perdida vp' +
            ' where vp.grupo_prod = :grupo_prod and vp.cod_prod = :cod_prod' +
            ' and vp.cod_empresa = :cod_empresa and vp.codigo_vp' +
            ' in ( select tvp.codigo_vp from tipovp tvp where tvp.bx_entr_nfe = ''S'' and' +
            ' tvp.cod_empresa = :cod_empresa )';
          buscas.ParamByName('grupo_prod').AsInteger :=
            vItem.dataSet.FieldByName('grupo_prod').AsInteger;
          buscas.ParamByName('cod_prod').AsString :=
            vItem.dataSet.FieldByName('cod_prod').AsString;
          buscas.ParamByName('cod_empresa').AsInteger :=
            vItem.dataSet.FieldByName('cod_empresa').AsInteger;
          buscas.Prepare;
          buscas.ExecSql;
        except
          on e: Exception do begin
            if Application.MessageBox(pchar('Erro ao remover venda perdida do Produto: ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + sLineBreak +
              'Nota Fiscal não será confirmada. Certifique-se que o item não esteja travado por outro usuário' + sLineBreak
                +
              'Mostrar Erro?'), 'Atenção', MB_ICONEXCLAMATION + MB_YESNO) = IDYES then
              ShowMessage(e.Message);
            registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
              dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoque VendaPerdida ' +
              vItem.dataSet.FieldByName('num_fab_prod').AsString +
              ' / ' + vItem.dataSet.FieldByName('descricao_item').AsString + ' ' +
              e.Message);
            exit;
          end;
        end;
      end;
      vItem.dataSet.Next;
    end;
    Result := true;
  except
    on e: exception do begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro('TNFCab.EntrarComEstoque Erro: ' + e.Message);
    end;
  end;
end;

function TNFCab.entrarComEstoqueECF: boolean;
var
  QtdePendente, QtdeInformada, QtdeTotal: Integer;
begin
  Result := True;
  QtdeTotal := Trunc(vItem.dataSet.FieldByName('quantidade').AsFloat);
  QtdePendente := QtdeTotal;
  QtdeInformada := 0;
  while QtdePendente <> QtdeInformada do
  begin
    vItem.vDetEcf.dataSet.Insert;
    if abreFormDetalhesECFEntrada(QtdeTotal, QtdePendente, QtdeInformada) then
    begin
      QtdeInformada := QtdeInformada + 1;
      buscas.CLose;
      buscas.sql.text :=
        'INSERT INTO ECF (N_SERIE_FAB, COD_EMPRESA, IDENTIFICACAO, TIPO_ECF, MARCA_ECF, MODELO_ECF, VERSAOSB, N_MEMORIA_FISCAL, LACRE_EXTERNO1, LACRE_EXTERNO2, LACRE_EXTERNO3,' +
        ' LACRE_EXTERNO4, STATUS, NNF_ENTRADA, SERIE_ENTRADA, COD_PROD, GRUPO_PROD, TIPO, COD_NSERIE)' +
        'VALUES (:N_SERIE_FAB, :COD_EMPRESA, :IDENTIFICACAO, :TIPO_ECF, :MARCA_ECF, :MODELO_ECF, :VERSAOSB, :N_MEMORIA_FISCAL, :LACRE_EXTERNO1, :LACRE_EXTERNO2, :LACRE_EXTERNO3,' +
        ' :LACRE_EXTERNO4, :STATUS, :NNF_ENTRADA, :SERIE_ENTRADA, :COD_PROD, :GRUPO_PROD, :TIPO, :COD_NSERIE)';
      buscas.ParamByName('N_SERIE_FAB').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('N_SERIE_FAB').AsString;
      buscas.ParamByName('COD_EMPRESA').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('COD_EMPRESA').AsString;
      buscas.ParamByName('IDENTIFICACAO').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('CNIEE').AsString;
      buscas.ParamByName('TIPO_ECF').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('TIPO_ECF').AsString;
      buscas.ParamByName('MARCA_ECF').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('MARCA_ECF').AsString;
      buscas.ParamByName('MODELO_ECF').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('MODELO_ECF').AsString;
      buscas.ParamByName('VERSAOSB').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('VERSAOSB').AsString;
      buscas.ParamByName('N_MEMORIA_FISCAL').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('N_MEMORIA_FISCAL').AsString;
      buscas.ParamByName('LACRE_EXTERNO1').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO1').AsString;
      buscas.ParamByName('LACRE_EXTERNO2').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO2').AsString;
      buscas.ParamByName('LACRE_EXTERNO3').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO3').AsString;
      buscas.ParamByName('LACRE_EXTERNO4').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('LACRE_EXTERNO4').AsString;
      buscas.ParamByName('STATUS').AsString := 'Estoque';
      buscas.ParamByName('NNF_ENTRADA').AsString := dataSet.FieldByName('num_nf').AsString;
      buscas.ParamByName('SERIE_ENTRADA').AsString := dataSet.FieldByName('serie').AsString;
      buscas.ParamByName('COD_PROD').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('COD_PROD').AsString;
      buscas.ParamByName('GRUPO_PROD').AsInteger :=
        vItem.vDetEcf.dataSet.FieldByName('GRUPO_PROD').AsInteger;    
      buscas.ParamByName('TIPO').AsString :=
        vItem.vDetEcf.dataSet.FieldByName('TIPO').AsString;
      buscas.ParamByName('COD_NSERIE').AsInteger :=
        Gencodigo('ECF', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
      vItem.vDetEcf.dataSet.Edit;
      vItem.vDetEcf.dataSet.FieldByName('COD_NSERIE').AsInteger :=
        buscas.ParamByName('COD_NSERIE').AsInteger;
      vItem.vDetEcf.dataSet.Post;
      buscas.prepare;
      buscas.ExecSql;
    end
    else
    begin
      Result := False;
      Break;
    end;
  end;
end;

function TNFCab.EntrarComEstoqueVeiculo: boolean;
var
  vCodVeiculo: integer;
  vTipoRes, vDataRes, vTipoVenda, vStatusRes, vNomeRes, vSitRes: string;
  vVendedorRes, vCodCliente: integer;
  vtemReserva: boolean;
begin
  Result := False;
  try
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      vItem.vDetVeic.dataSet.First;
      while not vItem.vDetVeic.dataSet.Eof do
      begin
        if vItem.vDetVeic.dataSet.FieldByName('nitem').AsInteger =
          vItem.dataSet.FieldByName('nitem').AsInteger then
          Break;
        vItem.vDetVeic.dataSet.Next;
      end;

      if (dataset.FieldByName('natureza_nf').Asstring = 'E') and
        (copy(vItem.dataset.FieldByName('codigo_nop').Asstring,2,3) = '913') then
      begin
        buscas.Close;
        buscas.Sql.Text := 'update com_fat set situacao = ''RETORNADA'' ' +
          ' where num_nota_v = ' + dataset.fieldbyname('num_nf_emt').asstring +
          ' and serie = ' + QuotedStr(dataset.fieldbyname('serie_emt').asstring)+
          ' and cod_empresa = '+vDadosIni.codEmpresa;
        buscas.ExecSql;

        buscas.Close;
        buscas.Sql.Text := 'update est_moto set situacao = ''''' +
          ' where chassi_c = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSql;

      end;
      Result := True;
      if (notaFiscalDeRetorno) or (dataset.FieldByName('natureza_nf').Asstring <> 'E') then
      begin
        vItem.dataSet.Next;
        continue;
      end;

      buscas.Close;
      if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N' then
      begin
        buscas.Close;
        buscas.Sql.Text := 'select TIPO_RES, DATA_RES, VENDEDOR_RES, TIPO_VENDA, COD_CLIENTE,' +
          ' STATUS_RES, NOME_RES, SIT_RES from transito_motos' +
          ' where num_notat = ' + dataSet.FieldByName('num_nf').AsString +
          ' and chassit = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;
        vTipoRes := '';
        vDataRes := '';
        vVendedorRes := 0;
        vTipoVenda := '';
        vCodCliente := 0;
        vStatusRes := '';
        vNomeRes := '';
        vSitRes := '';
        vtemReserva := not buscas.IsEmpty;
        if vtemReserva then
        begin
          vTipoRes := buscas.FieldByName('TIPO_RES').AsString;
          vDataRes := buscas.FieldByName('DATA_RES').AsString;
          vVendedorRes := buscas.FieldByName('VENDEDOR_RES').AsInteger;
          vTipoVenda := Trim(buscas.FieldByName('TIPO_VENDA').AsString);
          vCodCliente := buscas.FieldByName('COD_CLIENTE').AsInteger;
          vStatusRes := buscas.FieldByName('STATUS_RES').AsString;
          vNomeRes := buscas.FieldByName('NOME_RES').AsString;
          vSitRes := buscas.FieldByName('SIT_RES').AsString;
        end;
        Buscas.Close;
        Buscas.Sql.Text := 'INSERT INTO EST_MOTO' +
          ' (CHASSI_C, COD_EMPRESA, NUM_NOTA, SERIE, MARCAEST, VERSAOEST,' +
          ' ANO_FABEST, ANO_MODEST, COREST, CILINDROSEST, COMBUSTIVELEST, CILINDRADAEST, HPEST, LOTACAOEST,' +
          ' TIPOEST, RENAVAMEST, PRECO_TABEST, OBS_ITEMEST, MOTOREST, PLACAEST, CERTIFICADOEST, DATA_CERTIFICADOEST,' +
          ' CATEGORIAEST, DATA_CH_NOTA, TIP_PINTURA, NSERIE, COD_COR,' +
          ' BASE_CALC_ICM_SUBEST, FRETE_AQUISICAOEST, FRETE_VENDAEST, VALOR_ICM_SUBEST, SITUACAO, TIPO_RES, DATA_RES,' +
          ' VENDEDOR_RES, COD_CLIENTE, STATUS_RES, NOME_RES, SIT_RES, COD_FORNECEDOR, TIPO_VENDA, DESCRICAO_VERSAOEST, CODIGO, PRECO_CUSTO)' +
          ' VALUES ' +
          ' (:CHASSI, :COD_EMPRESA, :NUM_NF, :SERIE, :MARCA, :VERSAO,' +
          ' :ANO_FAB, :ANO_MOD, :COR, :CILINDROS, :COMBUSTIVEL, :CILINDRADA, :HP, :LOTACAO,' +
          ' :TIPO, :RENAVAM, :PRECO_TAB, :OBS_ITEM, :MOTOR, :PLACA, :CERTIFICADO, :DATA_CERTIFICADO,' +
          ' :CATEGORIA, :DATA_LANC, :TIP_PINTURA, :NSERIE, :COD_COR,' +
          ' :BASE_ICMSUB, :FRETE_AQUISICAO, :FRETE_VENDA, :VALOR_ICMSUB, :SITUACAO, :TIPO_RES, :DATA_RES,' +
          ' :VENDEDOR_RES, :COD_CLIENTE, :STATUS_RES, :NOME_RES, :SIT_RES, :COD_FORNECEDOR, :TIPO_VENDA, :DESCRICAO_VERSAO, :CODIGO, :PRECO_CUSTO)';
      end
      else
        Buscas.Sql.Text := 'INSERT INTO MTUSADAS' +
          ' (CHASSI_US, COD_EMPRESA, NFAQ_US, SUBSERIENFAQ, MARCA_US, VERSAO_US,' +
          ' ANOFAB_US, ANOMOD_US, COR_US, CILIND_US, COMBUST_US, CILINDRADA_US, HP_US, LOTACAO_US,' +
          ' TIPO_US, RENAVAM_US, VALOR_VEN_US, OBS_US, MOTOR_US, PLACA_US, CERTIF_US, DATA_CERT_US,' +
          ' CATEGORIA_US, DATA_CH_NOTA, TIP_PINTURA, NSERIE, COD_COR, ' +
          ' VL_COMPRA_US, ESTOQUE, ESPECIE_US, DATCAD_US, CODIGO_US, PRECO_CUSTO)' +
          ' VALUES ' +
          ' (:CHASSI, :COD_EMPRESA, :NUM_NF, :SERIE, :MARCA, :VERSAO,' +
          ' :ANO_FAB, :ANO_MOD, :COR, :CILINDROS, :COMBUSTIVEL, :CILINDRADA, :HP, :LOTACAO,' +
          ' :TIPO, :RENAVAM, :PRECO_TAB, :OBS_ITEM, :MOTOR, :PLACA, :CERTIFICADO, :DATA_CERTIFICADO,' +
          ' :CATEGORIA, :DATA_LANC, :TIP_PINTURA, :NSERIE, :COD_COR,' +
          ' :VL_COMPRA_US, :ESTOQUE, :ESPECIE_US, :DATCAD_US, :CODIGO, :PRECO_CUSTO)';
      buscas.ParamByName('CHASSI').AsString := vItem.vDetVeic.dataSet.FieldByName('CHASSI').AsString;
      buscas.ParamByName('COD_EMPRESA').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ParamByName('NUM_NF').AsInteger := dataSet.FieldByName('NUM_NF').AsInteger;
      buscas.ParamByName('SERIE').AsString := dataSet.FieldByName('SERIE').AsString;
      buscas.ParamByName('MARCA').AsString := copy(vItem.vDetVeic.dataSet.FieldByName('MARCA').AsString, 1, 32);
      buscas.ParamByName('VERSAO').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('VERSAO').AsInteger;
      buscas.ParamByName('ANO_FAB').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger;
      buscas.ParamByName('ANO_MOD').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger;
      buscas.ParamByName('COR').AsString := vItem.vDetVeic.dataSet.FieldByName('COR').AsString;
      buscas.ParamByName('CILINDROS').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger;
      buscas.ParamByName('COMBUSTIVEL').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString;
      buscas.ParamByName('CILINDRADA').AsFloat :=
        vItem.vDetVeic.dataSet.FieldByName('CILINDRADA').AsFloat;
      buscas.ParamByName('HP').AsFloat := vItem.vDetVeic.dataSet.FieldByName('HP').AsFloat;
      buscas.ParamByName('LOTACAO').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('LOTACAO').AsString;
      buscas.ParamByName('TIPO').AsString := vItem.vDetVeic.dataSet.FieldByName('TIPO').AsString;
      buscas.ParamByName('RENAVAM').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('RENAVAM').AsString;
      buscas.ParamByName('PRECO_TAB').AsFloat :=
        vItem.vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat;
      buscas.ParamByName('OBS_ITEM').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('OBS_ITEM').AsString;
      buscas.ParamByName('MOTOR').AsString := vItem.vDetVeic.dataSet.FieldByName('MOTOR').AsString;
      buscas.ParamByName('PLACA').AsString := vItem.vDetVeic.dataSet.FieldByName('PLACA').AsString;
      buscas.ParamByName('CERTIFICADO').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('CERTIFICADO').AsString;
      buscas.ParamByName('DATA_CERTIFICADO').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('DATA_CERTIFICADO').AsString;
      buscas.ParamByName('CATEGORIA').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('CATEGORIA').AsString;
      buscas.ParamByName('DATA_LANC').AsString := dataSet.FieldByName('DATA_LANC').AsString;
      buscas.ParamByName('TIP_PINTURA').AsString :=
        vItem.vDetVeic.dataSet.FieldByName('TIP_PINTURA').AsString;
      buscas.ParamByName('NSERIE').AsString := vItem.vDetVeic.dataSet.FieldByName('NSERIE').AsString;
      buscas.ParamByName('COD_COR').AsInteger :=
        vItem.vDetVeic.dataSet.FieldByName('COD_COR').AsInteger;
      buscas.ParamByName('PRECO_CUSTO').AsFloat :=
        vItem.vDetVeic.dataSet.FieldByName('PRECO_CUSTO').AsFloat;
      if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N' then
      begin
        buscas.ParamByName('BASE_ICMSUB').AsFloat := vItem.dataSet.FieldByName('BASE_ICMSUB').AsFloat;
        buscas.ParamByName('FRETE_AQUISICAO').AsFloat :=
          vItem.vDetVeic.dataSet.FieldByName('FRETE_AQUISICAO').AsFloat;
        buscas.ParamByName('FRETE_VENDA').AsFloat :=
          vItem.vDetVeic.dataSet.FieldByName('FRETE_VENDA').AsFloat;
        buscas.ParamByName('VALOR_ICMSUB').AsFloat :=
          vItem.dataSet.FieldByName('VALOR_ICMSUB').AsFloat;
        buscas.ParamByName('SITUACAO').AsString :=
          vItem.vDetVeic.dataSet.FieldByName('SITUACAO').AsString;
        buscas.ParamByName('COD_FORNECEDOR').AsInteger :=
          dataSet.FieldByName('COD_CLIENTE').AsInteger;
        buscas.ParamByName('DESCRICAO_VERSAO').AsString :=
          vItem.vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString;
        //Reserva de veiculo.
        buscas.ParamByName('TIPO_RES').AsString := vTipoRes;
        buscas.ParamByName('DATA_RES').AsString := vDataRes;
        buscas.ParamByName('VENDEDOR_RES').AsInteger := vVendedorRes;
        buscas.ParamByName('TIPO_VENDA').AsString := Trim(vTipoVenda);
        buscas.ParamByName('COD_CLIENTE').AsInteger := vCodCliente;
        buscas.ParamByName('STATUS_RES').AsString := vStatusRes;
        buscas.ParamByName('NOME_RES').AsString := vNomeRes;
        buscas.ParamByName('SIT_RES').AsString := vSitRes;
        vCodVeiculo := Gencodigo('EST_MOTO', dtmNF.SpIncCodNF, vDadosIni.codEmpresa);
