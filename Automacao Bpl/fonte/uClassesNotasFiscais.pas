function TNFCab.setDadosFechamento: boolean;
begin
  Result := False;
  try
    if dataSet.State in [dsInsert, dsEdit] then
    begin

      if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      begin
        dataSet.FieldByName('INSCRICAO_SUBSTITUTO').AsString := '';
        if (dataSet.FieldByName('emissao_propria').AsString = 'S') and
          (vDadosIni.vEmp.vSiglaUF <> getUFdaOperacao) then
          dataSet.FieldByName('INSCRICAO_SUBSTITUTO').AsString := vClFor.inscricao;
        if dataSet.FieldByName('tipo_nf').AsString = 'P' then
        begin
          verificarCFOPdoCabecalho;

          if not montarPedVenda then
            Exit;

          if not setNumeroNFPedVenda then
            Exit;

          if not atualizaValorTotalPedVenda('', 0, [opvAtualizarTotal, opvAtualizarDespesasNF]) then
            Exit;
          begin
            verificaProdutosECF;
            setDescricaoItemOutras;
          end;

          {if not notaFiscalDeRemessa(dataSet.FieldByName('codigo_nop').AsString) then
            if gerarFaturas(True) then
              abreFormFaturasSaida(True);}

          verificaRecibos;
          incluirLigacaoNfRemessaVendaForaEstab;

          if fequals('tipo_emissao', '1') and not CFOPRetorno(fint('codigo_nop')) and not CFOPRemessa(fint('codigo_nop')) then
            PedidoCliente.AutoPreencheItemsNf(fint('cod_nf'));
        end
        else if dataSet.FieldByName('tipo_nf').AsString = 'V' then
        begin

          if pos('NF FABRICA NUMERO: ', dataSet.FieldByName('OBS').AsString) = 0 then
          begin
            try
              buscas.close;
              buscas.SQL.Text := 'select faturamento from nat_op' +
                ' where codigo_nop = :codigo_nop';
              buscas.ParamByName('codigo_nop').AsFloat := vItem.dataSet.FieldByName('codigo_nop').AsFloat;
              buscas.Open;

              if Trim(buscas.FieldByName('faturamento').AsString) = 'S' then
              begin
                buscas.close;
                buscas.SQL.Text := 'select first 1 nf.num_nf, nf.data_contabil from notafiscal nf' +
                  ' inner join notafiscal_item_veiculo nv on nv.cod_nf = nf.cod_nf and nv.cod_empresa = nf.cod_empresa' +
                  ' inner join empresa e on e.cod_empresa = nv.cod_empresa and e.nf_veic_mostrar_nf_fab = ''S''' +
                  ' where nv.chassi = ' + QuotedStr(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString) +
                  ' and nv.cod_empresa = ' + vDadosIni.codEmpresa +
                  ' and nf.natureza_nf = ''E'' order by nf.data_contabil';
                buscas.Open;
                if buscas.FieldByName('num_nf').AsInteger > 0 then
                  dataSet.FieldByName('OBS').AsString := dataSet.FieldByName('OBS').AsString +
                    ';NF FABRICA NUMERO: ' + vDadosIni.StrZero(buscas.FieldByName('NUM_NF').AsInteger, 7) +
                    ' DATA EMISSAO: ' + FormatDateTime('DD/MM/YYYY', buscas.FieldByName('DATA_CONTABIL').AsDateTime);
              end;

            except on E: Exception do
              begin
                Result := False;
                Application.MessageBox(pchar('Erro ao buscar nota de entrada do Fabricante. Erro: ' + e.Message +
                  'Informe o Suporte para consultar o erros.log'),
                  'Atenção', 0 + 64);
                registraErro('function TNFCab.setDadosFechamento. Erro: ' + e.Message + '. Sql: ' + buscas.SQL.Text);
                Exit;
              end;
            end;
          end;

//          if get_status <> stsFechada then
// quando a NFe nao é enviada da primeira vez o metodo nao é chamado porteriormente, caso a forma de pagamento seja refeita fica sem os dados deste metodo, entao comentei por causa disso
            if not setNumeroNFComandoFormPagamento then
              Exit;

          setDadosVeiculo;
          if not verificaVeiculoDemonstracao then
            Exit;
          //Atribuindo dados do veiculo para impressao da nf
          setDescricaoItemOutras;
          //baixaEstoqueVeiculo. O comando de faturamento ja vai fazer o necessário

          buscas.Close;
          buscas.SQL.Text := 'select GERA_FATURAS_NF_VEIC from empresa' +
            ' where cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.Open;

          {if buscas.FieldByName('GERA_FATURAS_NF_VEIC').AsString = 'S' then
            if not notaFiscalDeRemessa(dataSet.FieldByName('codigo_nop').AsString) then
              if gerarFaturas(True) then
                abreFormFaturasSaida(True);  }
        end;

        VerificarBaixaBensAtivoImobilizado;

        if dataSet.FieldByName('valor_icm_simples').AsFloat = 0 then
          dataSet.FieldByName('aliq_icm_simples').AsFloat := 0;
        dataSet.FieldByName('STATUS').AsString := stsFechada;
      end
      else if dataSet.FieldByName('natureza_nf').AsString = 'E' then
      begin
        if get_status = stsFechada then
        begin
          result := True;
          exit;
        end;
        //      if Application.MessageBox('Deseja Fechar a Nota Fiscal?', 'Atenção', MB_YESNO
        //        + MB_ICONQUESTION) = ID_YES then
        begin
          //Chamar aqui as funçoes de fechamento da nota fiscal de entrada.
          if get_status <> stsFechada then
          begin
            if dataSet.FieldByName('tipo_nf').AsString = 'P' then
            begin
              //Relatorio de Conferencia de Pedido de Compra. Quantidades, Valores e Produtos nao recebidos
  //            if PedidoIrregular then
  //              exit;
              //Baixar o Pedido
              if dataSet.FieldByName('emissao_propria').AsString = 'N' then
                if not BaixaPedidoCompra then
                  exit;
              //Calcular o Custo do Produto
              dataSet.FieldByName('ANTEC_TRIB').AsString := '';
              if not CalcularCustoDosProdutos(opdConfirmacao) then
                exit;
              if not abreFormDadosStCobradaAntecipada then
                Exit;
              //Abrir a Margem para Definição do Preço de Venda
              try
                vItem.montaDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
                vItem.dataSet := TClientDataSet(DtmNF.cdsTempINf);
                  vCfop.selecionaCfop(Trunc(dataSet.FieldByName('codigo_nop').AsFloat));
                if (not notaFiscalDeRetorno) and
                  (Trim(vCfop.dataSet.FieldByName('calc_custo').AsString)
                  <> 'N') then
                  if vDadosIni.vEmp.vUsarAltPrecoNFDigItem <> 'S' then
                    if not verificaMargemProdutos(True) then
                      exit;
              finally
                vItem.dataSet := TClientDataSet(DtmNF.cdsINf);
                end;

              // Montar Controle Interno de Devolução para
              if not montarControleInternoDevolucao then
                Exit;

              //Entrar com estoque nas grades
              if not VerificarGrades then
                exit;

              try
                vItem.setDadosDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
                vItem.dataSet := TClientDataSet(DtmNF.cdsTempINf);
                //Entrar com Estoque
                if not EntrarComEstoque then
                  exit;
              finally
                vItem.dataSet := TClientDataSet(DtmNF.cdsINf);
              end;
//              if not vGrComp.BaixaEstoqueGrades(dataSet.FieldByName('cod_nf').AsInteger) then
//                exit;

//              if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
              if not verificaProdutosECF then
                Exit;
              //Entrar com equipamento do Ativo Imobilizado
              VerificarCadastroBensAtivoImobilizado;

              //Cadastra Codigos de Fornecedor
              verificaCodigosFornecedor;

              //Inclui ligação entre notas de venda fora do estabelecimento e nota de remessa e de retorno
              incluirLigacaoNfRemessaVendaForaEstab;

            end
            else if dataSet.FieldByName('tipo_nf').AsString = 'V' then
            begin
              dataSet.FieldByName('ANTEC_TRIB').AsString := '';
              if not CalcularCustoDosProdutos(opdConfirmacao) then
                exit;
              //Entrar com o estoque do veiculo
              if vDadosIni.vEmp.vVersaoVeiculos = '4' then
              begin
                if not EntrarComEstoqueVeiculoCCIA then
                  exit;
              end
              else
              begin
                if not EntrarComEstoqueVeiculo then
                  exit;
              end;
              verificaTransitoVeiculo;
              verificaRetornoVeiculo;
              verificaTransferenciaVeiculo;

              //          if dataSet.FieldByName('emissao_propria').AsString = 'S' then
              //          begin
              setDescricaoItemOutras;
              //            vItem.dataSet.Edit;
              //            vItem.dataSet.fieldbyname('descricao_item_outras').AsString :=
              //              vItem.vDetVeic.dataSet.fieldbyname('dados_v').AsString;
              //            vItem.dataSet.Post;
              //          end;
            end
            else if dataSet.FieldByName('tipo_nf').AsString = 'D' then
            begin
              abreFormDadosAdicionaisDespesa;

            end
            else
            begin
              VerificarCadastroBensAtivoImobilizado;
              //Entrar com estoque de ECF
            end;
            definirItensBxRetornoFin;
            if not abreFormFaturasEntrada then
              Exit;
              
            if fdif('emissao_propria', 'S') then
              if not verificarRegraGeralCST then
                Exit;

            RegistrarAjusteC195C197_ICMS_SN;

            dataSet.FieldByName('STATUS').AsString := stsFechada;

            //Lançar valor do Frete
            //VerificaCadastroConhecimentoDeFrete;
          end;
        end;
      end;
      vStatusFechada := (get_status = stsFechada) or
                        (get_status = stsCancelada);
      nfe_verificar_dados_contingencia;
    end;
    Result := True;
  finally
    if not Result then
      RollBackTransacao;
  end;
  //Ver se vai abrir o forma de pagamento
  //Chamar a impressao da nota fiscal ou
  //Enviar a nota fiscal eletronica
  //Jogar numero da nota fiscal na tabela forma de pagamento para as requisicoes que comporam a nota fiscal
end;

function TNFCab.setDadosVeiculo: boolean;
var
  lista: TMemo;
begin
  lista := TMemo.Create(Application);
  try
    lista.Visible := false;
    lista.Parent := Application.MainForm;
    lista.Width := 800;
    lista.Height := 800;
    lista.Clear;
    if not (vItem.vDetVeic.dataSet.state in [dsEdit, dsInsert]) then
      vItem.vDetVeic.dataSet.Edit;
    vItem.vDetVeic.Edit;
    if dataSet.fieldbyname('natureza_nf').ASstring = 'S' then
      vItem.vDetVeic.dataSet.FieldByName('frete_venda').AsFloat :=
        vItem.dataSet.FieldByName('rateio_frete').AsFloat;
    vItem.vDetVeic.dataSet.FieldByName('precovenda').AsFloat :=
      vItem.dataSet.FieldByName('valor_unitario').AsFloat;

    lista.Lines.add(vItem.vDetVeic.dataSet.fieldbyname('tipo').AsString + ' MARCA: ' +
      vItem.vDetVeic.dataSet.FieldByName('marca').AsString + ' MODELO: ' +
      vItem.vDetVeic.dataSet.fieldbyname('DESCRICAO_VERSAO').AsString);
    lista.Lines.add(vItem.vDetVeic.dataSet.fieldbyname('lotacao').AsString + ', ANO FABRICACAO: ' +
      vItem.vDetVeic.dataSet.FieldByName('ano_fab').AsString + ', ANO MODELO: ' +
      vItem.vDetVeic.dataSet.fieldbyname('ano_mod').AsString);

    lista.Lines.add(vDadosIni.strzero(vItem.vDetVeic.dataSet.fieldbyname('cilindros').AsInteger, 3)
      +
      ', 0 KM, COR: ' +
      vItem.vDetVeic.dataSet.FieldByName('cor').AsString + ', CILINDRADAS: ' +
      vItem.vDetVeic.dataSet.fieldbyname('cilindrada').AsString);
    lista.Lines.add('HP: ' + vItem.vDetVeic.dataSet.fieldbyname('hp').AsString + ', COMBUSTIVEL: ' +
      vItem.vDetVeic.dataSet.FieldByName('combustivel').AsString);
    lista.Lines.add('CHASSI NUMERO: ' + vItem.vDetVeic.dataSet.fieldbyname('chassi').AsString);
    lista.Lines.add('RENAVAM NUMERO: ' + vItem.vDetVeic.dataSet.fieldbyname('renavam').AsString +
      '  ' + 'MOTOR: ' + vItem.vDetVeic.dataSet.fieldbyname('motor').AsString);
    if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'U' then
    begin
      lista.Lines.add('PLACA NUMERO: ' + vItem.vDetVeic.dataSet.fieldbyname('placa').asstring);
      lista.Lines.Text := StringReplace(lista.Lines.Text, '0 KM,', ' USADO,', [rfReplaceAll,
        rfIgnoreCase]);
    end;
    vItem.vDetVeic.dataSet.fieldbyname('dados_v').AsString := lista.Lines.Text;
    vItem.vDetVeic.dataSet.Post;
  finally
    lista.Free;
    lista := nil;
  end;
end;

function TNFCab.SetDadosVeiculoComando: boolean;
begin
 if (vDadosIni.vEmp.vVersaoVeiculos <> '4') or (dataset.fieldbyname('tipo_nf').asstring <> 'V')  then
    exit;

 if (dataset.fieldbyname('NATUREZA_NF').asstring = 'S') then
 begin
  buscas.Close;
  buscas.SQL.Text := ' update est_moto ' +
    ' set cod_nfv = :cod_nfv, num_notav = :num_notav, seriev = :seriev ' +
    ' , modelo_nfv = :modelo_nfv, data_ch_notav = :data_ch_notav ' +
    ' where chassi_c = :chassi_c and codigo = :codigo and cod_empresa = :cod_empresa';
  buscas.ParamByName('CHASSI_C').AsString := vItem.vDetVeic.dataSet.FieldByName('chassi').AsString;
  buscas.ParamByName('CODIGO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('COD_NFV').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
  buscas.ParamByName('NUM_NOTAV').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
  buscas.ParamByName('SERIEV').AsString := trim(dataSet.FieldByName('serie').AsString);
  buscas.ParamByName('MODELO_NFV').AsString := trim(dataSet.FieldByName('modelo_nf').AsString);
  buscas.ParamByName('DATA_CH_NOTAV').AsString := dataSet.FieldByName('data_lanc').AsString;
  buscas.Prepare;
  buscas.ExecSQL;
 end;

 if (vItem.vDetVeic.dataSet.FieldByName('n_comando').AsInteger <= 0) then
   exit;

  if dataset.fieldbyname('tipo_nf').asstring = 'V' then
  begin
     buscas.Close;
     buscas.SQL.Text := ' update com_fat ' +
      ' set cod_nf = :cod_nf, num_nota_v = :num_nota_v, serie = :serie, ' +
      ' modelo_nf = :modelo_nf, emissao_propria = :emissao_propria  ' +
      ' where chassiv = :chassiv and n_comando = :n_comando and natureza = :natureza ' +
      ' and cod_empresa = :cod_empresa';
     buscas.ParamByName('CHASSIV').AsString := vItem.vDetVeic.dataSet.FieldByName('chassi').AsString;
     buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
     buscas.ParamByName('N_COMANDO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('n_comando').AsInteger;
     buscas.ParamByName('NATUREZA').AsString := trim(dataSet.FieldByName('natureza_nf').AsString);
     buscas.ParamByName('COD_NF').AsInteger := vItem.vDetVeic.dataSet.FieldByName('cod_nf').AsInteger;
     buscas.ParamByName('NUM_NOTA_V').AsInteger := dataSet.FieldByName('num_nf').AsInteger;
     buscas.ParamByName('SERIE').AsString := trim(dataSet.FieldByName('serie').AsString);
     buscas.ParamByName('MODELO_NF').AsString := trim(dataSet.FieldByName('modelo_nf').AsString);
     buscas.ParamByName('EMISSAO_PROPRIA').AsString := trim(dataSet.FieldByName('emissao_propria').AsString);
     buscas.Prepare;
     buscas.ExecSQL;
  end;
end;

function TNFCab.setDescricaoItemOutras: Boolean;
var
  lista: TMemo;
  vTemp: string;
  I: Integer;
begin
  vItem.dataSet.First;
  while not vitem.dataset.eof do
  begin
    if vItem.dataset.fieldbyname('tipo_item').asstring = 'V' then
    begin
//      vItem.vDetVeic.selecionaDetalheVeiculo(dataset.fieldbyname('cod_nf').AsInteger,
//        vItem.dataset.fieldbyname('nitem').AsInteger);
      vItem.Edit;
      vItem.dataSet.fieldbyname('descricao_item_outras').AsString :=
        vItem.vDetVeic.dataSet.fieldbyname('dados_v').AsString;
      vItem.dataSet.Post;
    end
    else //if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
    //begin
      if vItem.dataset.fieldbyname('tipo_item').asstring = 'P' then
      begin
        if (vItem.dataset.fieldbyname('ecf').asstring = 'E') or (vItem.dataset.fieldbyname('ecf').asstring = 'O') then
        begin
          lista := TMemo.Create(Application);
          try
            lista.Visible := false;
            lista.Parent := Application.MainForm;
            lista.Width := 800;
            lista.Height := 800;
            lista.Clear;
            vItem.vDetEcf.selecionaDetalhesECF(dataset.fieldbyname('cod_nf').AsInteger,
              vItem.dataset.fieldbyname('nitem').AsInteger);
            lista.Lines.add(vItem.dataset.fieldbyname('descricao_item').AsString);
            if not vItem.vDetEcf.dataSet.IsEmpty then
            begin
              lista.Lines.add(vItem.vDetEcf.dataset.fieldbyname('marca_ecf').AsString + ' ' +
                vItem.vDetEcf.dataset.fieldbyname('modelo_ecf').AsString + ' ' +
                vItem.vDetEcf.dataset.fieldbyname('tipo_ecf').AsString + ': ');
              vTemp := '';
              i := 0;
              vItem.vDetEcf.dataSet.First;
              while not vItem.vDetEcf.dataSet.eof do
              begin
                i := i + 1;
                vTemp := vTemp + vItem.vDetEcf.dataset.fieldbyname('n_serie_fab').AsString + ';';
                vItem.vDetEcf.dataSet.Next;
                if ((i >= StrToInt(vDadosIni.vQtdeNSerieFabEcfImpNF)) or
                  (vItem.vDetEcf.dataSet.eof)) and (Trim(vTemp) <> '') then
                begin
                  lista.Lines.Add(vTemp);
                  vTemp := '';
                end;
              end;
              vItem.dataSet.Edit;
              vItem.dataSet.fieldbyname('descricao_item_outras').AsString := lista.Lines.Text;
              vItem.dataSet.Post;
            end;
          finally
            lista.Free;
            lista := nil;
          end;
        end;
      //end;
    end;
    vitem.dataset.next;
  end;
end;

