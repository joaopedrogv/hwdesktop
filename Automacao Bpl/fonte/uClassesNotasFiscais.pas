function TNFCab.verificaComandoIntegracao: boolean;
begin
  vDadosIni.vTipoForm := 2;
  if dtmNF = nil then
    dtmNF := TdtmNF.Create(dtmNF);
  montaSelect('select * from notafiscal where n_comando = ' + IntToStr(FComando) +
    ' and cod_empresa = ' + vDadosIni.CodEmpresa +
    ' and natureza_nf = ''S''  and ativo = 1');
  vsqlTemp := dataSet.CommandText;
  try
    if not dataSet.IsEmpty then
    begin
      if get_status = stsAberta then
      begin
        Edit;
        vComFat.pesquisaComandoFaturamento(0, IntToStr(FComando), '  /  /    ', '  /  /    ');
        if vComFat.dataSet.IsEmpty then
          raise exception.create('Comando Nº ' + IntToStr(FComando) +
            ' não encontrado ou Cancelado');
        if vComFat.vItem.dataSet.IsEmpty then
          raise exception.create('Não encontrado veículo para o Comando Nº ' +
            IntToStr(FComando));
        if not editaVeiculoAnotaFiscal then
          exit;
        Result := true;
        exit;
      end
      else
      begin
        Edit;
        if (get_situacao_nfe <> '') and
          (Trim(dataSet.FieldByName('modelo_nf').AsString) = '55') or
          (get_status = stsCancelada) then
          dataSet.Cancel
        else
        begin
          vComFat.pesquisaComandoFaturamento(0, IntToStr(FComando), '  /  /    ', '  /  /    ');
          if vComFat.dataSet.IsEmpty then
            raise exception.create('Comando Nº ' + IntToStr(FComando) +
              ' não encontrado ou Cancelado');
          if vComFat.vItem.dataSet.IsEmpty then
            raise exception.create('Não encontrado veículo para o Comando Nº ' +
              IntToStr(FComando));
          if not editaVeiculoAnotaFiscal then
            exit;
        end;
        Result := True;
        Exit;
      end;
    end;
    if not incluirNf( tnfVeiculos, 'V', 'S') then
