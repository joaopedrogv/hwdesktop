      vSped.vC110.adicionaInfComplPorInfId([Config.Conf_Geral.nfe_inf_compl_op_interna_dest_outra_uf]);
  end;

  //Verifica Devoluções
  vSped.vC110.adicionaInfComplDevolucaoOuPorItem(Self);

