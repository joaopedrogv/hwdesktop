procedure TNFCab.abreConhecimentoDeFrete;
var
  vFrete: TServTransporte;
  vYes: Boolean;
  I: Integer;
begin
  try
    Screen.Cursor := crHourGlass;
    if not vDadosIni.PesqPros('NF0029', 'CONSULTA', '', 'NOTAFISCAL',
      dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
      Exit;
    vFrete := TServTransporte.create;
    if dataSet.IsEmpty then
      exit;
    if not vFrete.abreServTransportePeloNumNF
      (dataSet.FieldByName('num_nf').AsInteger,
      dataSet.FieldByName('cod_cliente').AsInteger,
      Trim(dataSet.FieldByName('serie').AsString),
      dataSet.FieldByName('natureza_nf').AsString) then
    begin
      if not vDadosIni.validarAcessoCadastrosEmpresas('SERVICO_TRANSPORTE', 'I', buscas) then
        Exit;

      vYes:= Application.MessageBox('Não foi encontrado Conhecimento de Frete para esta nota fiscal. Deseja cadastrar?',
        'Confirmção',MB_ICONQUESTION + MB_YESNO) = IDYES;
      if vYes then
      begin
        for I := 0 to Pred(Application.MainForm.MDIChildCount) do
          if Application.MainForm.MDIChildren[i] = frmCadServicoTransporte then
          begin
            if not (fsModal in Application.MainForm.MDIChildren[I].FormState) then
              Application.MainForm.MDIChildren[I].Show;
            Exit;
          end;
        vFrete.Free;
        vFrete := TServTransporte.create(dataSet.FieldByName('serie').AsString,
          dataSet.FieldByName('natureza_nf').AsString,
          dataSet.FieldByName('num_nf').AsInteger,
          dataSet.FieldByName('cod_cliente').AsInteger);
        vFrete.CadServTransporte(1);
      end;
    end;
  finally
    Screen.Cursor := crDefault;
  end;
end;

function TNFCab.abreFormAlterarDadosSPED: boolean;
var
  formulario: TfrmPadrao;
begin
  if not vDadosIni.PesqPros('NF0039', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    if dataSet.IsEmpty then
      raiseExceptionCreate('Nenhuma Nota Fiscal selecionada', '');

    dataSet.RefreshRecord;

    if dataSet.FieldByName('emissao_propria').AsString = 'S' then
      raiseExceptionCreate('Nota Fiscal de Emissão Própria não pode ser modificada', '');

    if get_status <> stsFechada then
      raiseExceptionCreate('Nota Fiscal somente poderá ser alterada se seu Status = "Fechada"',
        '');

    dataSet.Edit;
    if not (dataSet.State = dsEdit) then
      raiseExceptionCreate('Erro ao tentar modificar Nota Fiscal', '');

    vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
    vClFor.selecionaClFor;
    try
      vStatusFechada := False;
      formulario := TfrmPadrao.Create(Application);
      formulario.Width := 620;
      formulario.Height := 500;
      formulario.Position := poScreenCenter;
      formulario.Caption :=
        'Nota Fiscal - Modificação de Dados';
      frmCadNF.ed_alt_sped_csosn.Enabled := vDadosIni.vEmp.vRegime = 'SIMPLES';
      frmCadNF.pnAlterarDadosSPED.Parent := formulario;
      frmCadNF.pnConsultaItemSPED.Visible := True;
      frmCadNF.pnAlterarItemSPED.Visible := False;
      frmCadNF.pnConsultaItemSPED.Align := alClient;
      frmCadNF.pnAlterarItemSPED.Align := alClient;

      formulario.AutoSize := True;
      formulario.AutoScroll := False;
      formulario.ShowHint := True;
      if (formulario.ShowModal = mrOk) then
      begin
        try
          dataSet.FieldByName('antec_trib').AsString := '';
          vItem.dataSet.First;
          while not vItem.dataSet.Eof do
          begin
            if vItem.dataSet.FieldByName('antec_trib').AsString = 'S' then
            begin
              dataSet.FieldByName('antec_trib').AsString := 'S';
              Break;
            end;
            vItem.dataSet.Next;
          end;
          dataSet.Post;
          if dataSet.ChangeCount > 0 then
            Apply;
          if vItem.dataSet.ChangeCount > 0 then
            if not vItem.Apply then
            begin
              RollBackTransacao;
              Exit;
            end;
          CommitaTransacao;
        except
          on e: exception do begin
            RollBackTransacao;
            if Application.MessageBox(pchar('Erro ao modificar dados da Nota Fiscal' + sLineBreak +
              'Mostrar Erro?'), 'Atenção', MB_ICONEXCLAMATION + MB_YESNO) = IDYES then
              ShowMessage(e.Message);
          end;
        end;
      end
      else
      begin
        CancelUpdates;
        RollBackTransacao;
      end;
    finally
      vStatusFechada := True;
      frmCadNF.pnAlterarDadosSPED.Parent := frmCadNF.tsAlterarDadosSPED;
      formulario.Free;
      formulario := nil;
    end;
  except
    on e: exception do begin
      Application.MessageBox(pchar(e.message), 'Atenção', MB_ICONINFORMATION + MB_OK);
    end;
  end;
end;

