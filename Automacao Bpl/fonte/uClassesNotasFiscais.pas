  dataSet.Post;
end;

procedure TNFItem.VerificarItensComConversaoPendente;
var
  sUndVenda: TStrings;
  qtde, idx: Integer;
begin
  qtde := 0;
  Self.prepare_loop();
  try
    while not dataSet.Eof do
    begin
      if (fstr('unidade_nf') = fstr('ucom')) // Igual a NFe
        and (ffloat('qtdemb') = 0)
        and (ffloat('qcom') > 0)
        and (ffloat('vuncom') > 0) then
      begin
        vrDadosItem.grupo_prod := fint('grupo_prod');
        vrDadosItem.cod_prod := fstr('cod_prod');

        if Self.GetUndVendaProd().IndexOf(fstr('ucom')) >= 0 then
          Inc(qtde);

      end;
      dataSet.Next;
    end;

    if qtde = 0 then
    begin
      ShowAtencao('Nenhum item com conversão pendente');
      Exit;
    end;

    if ShowCustomDlg
      .Msg(Format('Total de %d itens com conversão, porém ainda não aplicadas' + sLineBreak + sLineBreak +
                  'Continuar para aplicar as convesões?', [qtde]),
                  mdtQuestion, [brYes, brNo, brCancel])
      .SetDefaultBtn(brCancel)
      .Show.ResultDlg <> IDYES then
      Exit;

    dataSet.First;
    while not dataSet.Eof do
    begin
      if (fstr('unidade_nf') = fstr('ucom')) // Igual a NFe
        and (ffloat('qtdemb') = 0)
        and (ffloat('qcom') > 0)
        and (ffloat('vuncom') > 0) then
      begin  
        vrDadosItem.grupo_prod := fint('grupo_prod');
        vrDadosItem.cod_prod := fstr('cod_prod');

        sUndVenda := Self.GetUndVendaProd();
        idx := sUndVenda.IndexOf(fstr('ucom'));

        if idx >= 0 then
          AplicarConversaoDadosXML(sUndVenda.Objects[idx]);

      end;
      dataSet.Next;
    end;

  finally
    Self.prepare_loop_done();
  end;
end;

