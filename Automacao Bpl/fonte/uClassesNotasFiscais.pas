                   buscas.ParamByName('valor_ven').Value := Null;
                   buscas.ParamByName('data_ven').Value := Null;
                 end;

              buscas.Prepare;
              buscas.ExecSQL;

              buscas.Close;
              buscas.SQL.Text := ' update equipamento ' +
                ' set status_v = :status_v, data_ven = :data_ven, cod_nf_sai = null, nitem_sai = null' +
