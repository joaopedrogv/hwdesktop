function TNFItem.getDadosSubstituicaoTribSaida(
  ncm_produto: string; interestadual, contribuinte: boolean): boolean;
begin
  Result := False;

  if FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.Ativa then
  begin
    //quando ativada procura na tabela CEST_ v2
    vrDadosItem.Fvlbcst  := 0;
    vrDadosItem.Fmodbcst := 4;

    if FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.CalcularSTSaida then
      Result := vrDadosItem.getDadosSubstituicaoTributaria(FOwerNF.getUFdaOperacao, FOwerNF.Config.Conf_ICMS.nf_icmsst_cest_v2.RamoAtividade);

    if not interestadual then
      vrDadosItem.FAliqIntra := SqlOpen('select aliq_intra from nbm where cod_ncm = %s', [QuotedStr(ncm_produto)]).FieldByName('aliq_intra').AsFloat;
    Exit;
  end;
  
  vrDadosItem.FMVA := 0;
  vrDadosItem.Fvlbcst := 0;
  vrDadosItem.Fmodbcst := 4;
  vrDadosItem.FAliqIntra := 0;
  vrDadosItem.FAliqInter := 0;
  try
    if interestadual then
    begin
      //MVA Ajustada
      buscas.Close;
      buscas.SQL.Text := 'select' +
        ' mva.aliq_inter,' +
        ' mva.aliq_intra,' +
        ' mva.mva_st_original,' +
        ' mva.mva_ajustada' +
        ' from MVA_AJUSTADA_NCM mva' +
        ' inner join estados es on es.codigo_uf = mva.codigo_uf and es.sigla_uf = ' + QuotedStr(FOwerNF.getUFdaOperacao) +
        ' where  mva.cod_ncm = ' +QuotedStr(ncm_produto);
      buscas.Open;
      if not buscas.IsEmpty then
      begin
        vrDadosItem.FMVA := buscas.FieldByName('mva_ajustada').AsFloat;
        vrDadosItem.FAliqIntra := buscas.FieldByName('aliq_intra').AsFloat;
        vrDadosItem.FAliqInter := buscas.FieldByName('aliq_inter').AsFloat;
        Result := True;
        exit;
      end;
    end;
    //MVA no NCM
    buscas.Close;
    buscas.SQL.Text := ' select' +
      ' ne.mva,' +
      ' ne.MVA_INTER,' +
      ' ne.aliq_intra,' +
      ' ne.modbcst,' +
      ' ne.vlbcst' +
      ' from nbm ne where ne.cod_ncm = ' + QuotedStr(ncm_produto);
    buscas.Open;
    if not buscas.IsEmpty then
    begin
      if (buscas.FieldByName('vlbcst').AsFloat > 0) and
        (buscas.FieldByName('modbcst').AsFloat = 0) then
      begin
        vrDadosItem.Fvlbcst := buscas.FieldByName('vlbcst').AsFloat;
        vrDadosItem.Fmodbcst := buscas.FieldByName('modbcst').AsInteger;
      end
      else if (interestadual) then
      begin
        if (buscas.FieldByName('MVA_INTER').AsFloat > 0) then
          vrDadosItem.FMVA := buscas.FieldByName('MVA_INTER').AsFloat
        else
          vrDadosItem.FMVA := buscas.FieldByName('MVA').AsFloat;
      end
      else
        vrDadosItem.FMVA := buscas.FieldByName('MVA').AsFloat;
      if not interestadual then
      begin
        vrDadosItem.FAliqIntra := buscas.FieldByName('aliq_intra').AsFloat;
        vrDadosItem.FAliqInter := vrDadosItem.FAliqIntra;
      end;
//      Esta aliquota do ncm é a aliquota do estado da empresa, se a operacao é interestadual deve usar aliquota do estado ou das tributações adicionais
//      else
//        vrDadosItem.FAliqIntra := buscas.FieldByName('aliq_intra').AsFloat;
      Result := (vrDadosItem.FMVA > 0) or (vrDadosItem.Fvlbcst > 0);
      exit;
    end;
  finally
    buscas.close;
    if (vrDadosItem.FMVA > 0) or (vrDadosItem.Fvlbcst > 0) then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select ne.CALC_ST_SAIDA from nbm ne where ne.cod_ncm = ' + QuotedStr(ncm_produto);
      buscas.Open;
      if buscas.FieldByName('CALC_ST_SAIDA').AsString <> 'S' then
      begin
        Result := False;
        vrDadosItem.FMVA := 0;
        vrDadosItem.FAliqIntra := 0;
        vrDadosItem.FAliqInter := 0;
        vrDadosItem.Fvlbcst := 0;
        vrDadosItem.Fmodbcst := 4;
      end;
      buscas.Close;
    end;
  end;
end;

