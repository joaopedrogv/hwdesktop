function TNFCab.GetListEtiquetasDanfe(telaAutorizacao: Boolean): TStrings;
var
  etq: TCabecalho_etiqueta_class;
  conf: TConfig_sistema_class;
begin
  Result := NewStringList();

  conf := TCfg_sis.getConf('nf_etiqueta_danfe', buscas, vDadosIni.cod_empresa);

  if conf.ReadString('Conf', IfThen(telaAutorizacao, 'TelaAutorizacao', 'TelaImpressaoDANFe')) <> 'S' then
    Exit;

  buscas.Close;
  buscas.SQL.Text := ' select cod_etiqueta, descricao, quant_impressao from cabecalho_etiqueta ' +
    ' where tabela = ''NOTAFISCAL_DANFE'' ' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by cod_etiqueta ';
  buscas.Open;

  while not buscas.Eof do
  begin
    etq := TCabecalho_etiqueta_class.Create;
    etq.CopyFrom(buscas);
    Result.AddObject(Format('%d - %s', [etq.cod_etiqueta, etq.descricao]), etq);
    buscas.Next;
  end;

  buscas.Close;
end;

