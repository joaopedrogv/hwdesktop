function TNFCab.alteraCstNfTransito: boolean;
var
  vCst: string;
begin
  if not vDadosIni.PesqPros('NF0028', 'EDITAR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    Result := False;
    vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      raise exception.create('Nota fiscal de Saída. A nota fiscal deve ser de entrada');
    if dataSet.FieldByName('TP_NF').AsString <> 'T' then
      raise exception.create('Nota fiscal não é de trânsito');

    vCst := '000';
    vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
    while not vItem.dataSet.eof do
    begin
      if vItem.dataSet.FieldByName('tipo_item').AsString = 'P' then
      begin
        vCst := getCstTransito(vCst);
        if vCst = 'SAIR' then
        begin
          vItem.CancelUpdates;
          RollBackTransacao;
          vItem.Close;
          EXIT;
        end;
        if vItem.TestarCST(vCst) then
        begin
          vItem.dataSet.edit;
          vItem.dataSet.FieldByName('cst').AsString := vcst;
          vItem.dataSet.post;
          vItem.dataSet.next;
        end;
      end
      else
        vItem.dataSet.Next;
    end;
    if vItem.Apply then
    begin
      CommitaTransacao;
      Result := True;
    end
    else
      RollBackTransacao;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

function TNFCab.AlterarGradeItem: Boolean;
begin
  Result := False;
  vItem.vProd.montaSelect('select ' + StringReplace(vItem.vProd.vCamposProd,
    ' P.NUM_FAB_PROD, 0 COD_GRADE, ''SEM GRADE'' DESCRICAO, '' '' DESCRICAO1',
    ' coalesce(cb.cod_barra, P.NUM_FAB_PROD) NUM_FAB_PROD, gr.COD_GRADE, gr.DESCRICAO, gr.DESCRICAO1',
    [rfReplaceAll, rfIgnoreCase]) + ' from produtos p' +
    ' left join cod_grade_prod g on g.grupo_prod = p.grupo_prod and g.cod_prod = p.cod_prod and g.cod_empresa = p.cod_empresa' +
    ' left join grade gr on gr.cod_grade = g.cod_grade and gr.cod_empresa = g.cod_empresa' +
    ' left join cod_barra cb on cb.grupo_prod = p.grupo_prod and cb.cod_prod = p.cod_prod and cb.cod_empresa = p.cod_empresa and cb.cod_grade = gr.cod_grade' +
    ' where p.grupo_prod = ' + IntToStr(vItem.vrDadosItem.grupo_prod) +
    ' and p.cod_prod = ' + QuotedStr(vItem.vrDadosItem.cod_prod) +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa);

  if not vItem.vProd.dataSet.IsEmpty then
  begin
    try
      Application.CreateForm(TfrmEscolhaProdutoNf, frmEscolhaProdutoNf);
      frmEscolhaProdutoNf.GroupBox1.Visible := True;
      frmEscolhaProdutoNf.GroupBox1.Align := alClient;
      frmEscolhaProdutoNf.Panel2.Visible := True;
      if frmEscolhaProdutoNf.ShowModal = idOK then
      begin
        vItem.vrDadosItem.cod_grade := vItem.vProd.fint('cod_grade');
        vItem.vrDadosItem.descricao_item := vItem.vProd.fstr('descr_prod') +
          IfThen(vItem.vProd.fint('cod_grade') > 0,
             IfThen(vItem.vProd.fstr('descricao') <> 'SEM GRADE', '-' + vItem.vProd.fstr('descricao')));// +
        vItem.vrDadosItem.cean := vItem.vProd.vCB.GetEAN(vItem.vrDadosItem.cod_grade, Config.Conf_Geral.prod_ean_prefixos_invalidos);
        vItem.vrDadosItem.num_fab_prod := vItem.vProd.fstr('num_fab_prod');
        Result := True;
      end;
    finally
      frmEscolhaProdutoNf.Free;
      frmEscolhaProdutoNf := nil;
    end;
  end
end;

function TNFCab.alterarItem: boolean;
begin
  try
    Result := False;
    if notaFechada then
      exit;
    if vItem.vrDadosItem.tipo_item = 'O' then
      vItem.vrDadosItem.descricao_item := vItem.vrDadosItem.descricao_item_outras[0];
    if Trim(vItem.vrDadosItem.descricao_item) = '' then
      raiseExceptionCreate('Descrição do Item não informada', campos[9]);
    vItem.vrDadosItem.CheckNCM(vItem.vrDadosItem.ncm);
    {
    if dataSet.FieldByName('modelo_nf').AsString = '55' then
    begin
      if Trim(vItem.vrDadosItem.ncm) = '' then
        raiseExceptionCreate('NCM/SH de preenchimento obrigatório. Informar o Gênero caso não saiba o NCM/SH completo', campos[11]);
      if length(Trim(vItem.vrDadosItem.ncm)) < 2 then
        raiseExceptionCreate('NCM/SH de preenchimento obrigatório. Gênero de deve ter 2 dígitos',
          campos[11]);
      if (Length(Trim(vItem.vrDadosItem.ncm)) <> 8) and
        (Length(Trim(vItem.vrDadosItem.ncm)) <> 2) then
        raiseexceptioncreate('NCM/SH deve ser preenchido por completo ou pelo Gênero (2 primeiros dígitos)', campos[11]);
    end;
    if (vItem.vrDadosItem.valor_ipi > 0) and
      (Length(Trim(vItem.vrDadosItem.ncm)) <> 8) then
      raiseexceptioncreate('NCM/SH deve ser preenchido por completo quando existir tributação de IPI', campos[11]);
    if vDadosIni.vEmp.vGerarSpedPISCOFINS = 'S' then
      if vItem.vrDadosItem.tipo_item = 'O' then
        if (Trim(vItem.vrDadosItem.ncm) = '00') then
          raiseExceptionCreate('NCM/SH deve ser diferente de "00" para previnir erros no SPED Contribuições', campos[11]);
    }

    if vDadosIni.vEmp.vCombProduto = 'S' then
      if dataSet.FieldByName('emissao_propria').AsString = 'S' then
        if notaFiscalDeCombustivel(IntToStr(Trunc(vItem.vrDadosItem.codigo_nop))) then
        begin
          if Trim(vItem.vrDadosItem.comb_cprodanp) = '' then
            raiseExceptionCreate('Código ANP deve ser informado.', campos[12]);
          try
            StrToInt64(Trim(vItem.vrDadosItem.comb_cprodanp));
          except
            raiseExceptionCreate('Código ANP deve conter apenas números.', campos[12]);
          end;
          if (vItem.vrDadosItem.comb_cide_qbcprod > 0) or (vItem.vrDadosItem.comb_cide_valiqprod > 0) or (vItem.vrDadosItem.comb_cide_vcide > 0) then
          begin
            if (vItem.vrDadosItem.comb_cide_valiqprod = 0) then
              raiseExceptionCreate('Código ANP deve ser informado.', campos[13]);
            if (vItem.vrDadosItem.comb_cide_qbcprod = 0) then
              raiseExceptionCreate('Código ANP deve ser informado.', campos[14]);
            if (vItem.vrDadosItem.comb_cide_vcide = 0) then
              raiseExceptionCreate('Código ANP deve ser informado.', campos[15]);
          end;
          if Trim(vItem.vrDadosItem.comb_descanp) = '' then
            raiseExceptionCreate('Descrição ANP deve ser informada', campos[16]);
        end;

    if (dataSet.FieldByName('modelo_nf').AsString = '55') and
       (dataSet.FieldByName('emissao_propria').AsString = 'S') then
       if (vItem.vrDadosItem.nfe_indescala = 'N') and (vItem.vrDadosItem.nfe_cnpjfab = '') then
         raiseExceptionCreate('Se informado Indicador de escala relevante = "N" então o CNPJ do fabricante é obrigatório', '');

    if Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat) <> Trunc(vItem.vrDadosItem.codigo_nop)
