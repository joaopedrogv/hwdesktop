           buscas2.ParamByName('NR_PARC').AsInteger := 48;
           buscas2.ParamByName('COD_CCUS').AsInteger := 1;
           buscas2.ParamByName('VIDA_UTIL').AsInteger := 12;
           buscas2.ParamByName('MARCA').AsString := copy(trim(vItem.vDetVeic.dataSet.FieldByName('MARCA').AsString), 1, 32);
           buscas2.ParamByName('MODELO').AsString := copy(trim(vItem.vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString), 1, 32);
           buscas2.ParamByName('COR').AsString := copy(trim(vItem.vDetVeic.dataSet.FieldByName('COR').AsString), 1, 16);
           buscas2.ParamByName('ATIVO').AsInteger := 1;
           buscas2.ParamByName('COD_MARCA').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_MARCA').AsInteger;
           buscas2.ParamByName('COMCONTRATO').AsString := 'N';
           if Trim(vItem.vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N' then
             buscas2.ParamByName('ESTADO_EQUI').AsString := 'NOVO'
           else
             buscas2.ParamByName('USADO').AsString := 'USADO';
           buscas2.ParamByName('COD_ESTMOTO').AsInteger := buscas.ParamByName('CODIGO').AsInteger;
           buscas2.ParamByName('STATUS_V').AsString := 'N';
           buscas2.ParamByName('CODSEQ_BALANCO').AsInteger := vCodBalanco;
           buscas2.ParamByName('COD_NF_ENT').AsInteger := vItem.vDetVeic.dataSet.FieldByName('COD_NF').AsInteger;
           buscas2.ParamByName('NITEM_ENT').AsInteger := vItem.vDetVeic.dataSet.FieldByName('NITEM').AsInteger;
           buscas2.ExecSQL;
        end;
      end;
      if (vItem.vDetVeic.dataSet.FieldByName('TIPV_VEICULO').AsString = 'V') then
        vDadosIni.AtualizarFilaReserva(buscas2, dtmNF.SpIncCodNF,
          buscas.ParamByName('CODIGO').AsInteger,
          buscas.ParamByName('CHASSI').AsString);

      if not InserirHistEstMoto(buscas.ParamByName('CODIGO').AsInteger, buscas.ParamByName('CHASSI').AsString) then
        exit;

      vItem.dataSet.Next;
    end;

    Result := True;
  except
    on e: Exception do begin
      Result := false;
      Application.messagebox(pchar('Erro ao entrar com Veículo no estoque.' + sLineBreak + 'Erro: ' +
        e.Message), 'Atenção', 0 + 64);
      registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
        dataSet.FieldByName('cod_nf').AsString + ' EntrarComEstoqueVeiculoCCIA ' + e.Message);
    end;
  end;
end;

