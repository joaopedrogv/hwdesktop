function TNFCab.alterarNotaFechadaParaSPED: Boolean;
begin
  try
    dataSet.FieldByName('antec_trib').AsString := '';
    vItem.dataSet.First;
    while not vItem.dataSet.Eof do
    begin
      if vItem.dataSet.FieldByName('antec_trib').AsString = 'S' then
      begin
        dataSet.FieldByName('antec_trib').AsString := 'S';
        Break;
      end;
      vItem.dataSet.Next;
    end;
    dataSet.Post;
    if dataSet.ChangeCount > 0 then
      Apply;
    if vItem.dataSet.ChangeCount > 0 then
      if not vItem.Apply then
      begin
        RollBackTransacao;
        Exit;
      end;
    CommitaTransacao;

    vDadosIni.GravaAuditoria('NF0039', 'EDITAR', 'SUCESSO - NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
                             dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas);

    Result := True;
  except
    on e: exception do begin
      RollBackTransacao;
      if Application.MessageBox(pchar('Erro ao modificar dados da Nota Fiscal' + sLineBreak +
        'Mostrar Erro?'), 'Atenção', MB_ICONEXCLAMATION + MB_YESNO) = IDYES then
        ShowMessage(e.Message);
    end;
  end;
end;

function TNFCab.apagaNF: boolean;
var
  vPrecCusProd: Currency;
  vPrecCusMProd: Currency;
  vPrecCusMNF: Currency;
  vDataUltCompra: TDate;
  vNumNfRec, vCodDev: Integer;
  vCodTabMov: string;
  vOK: Boolean;
  vdtTmpClient: TClientDataSet;
  buscas2: TIBQuery;
  I: Integer;
begin
  vListDocPrgFid.Clear;
  
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  vCodTabMov := dataSet.FieldByName('cod_nf').AsString;
  if not vDadosIni.PesqPros('NF0018', 'EXCLUIR', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString , 'NOTAFISCAL', vCodTabMov,
    buscas, True) then
    exit;
  try
    Result := False;

    vOK := True;
    if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
    begin
      vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
      // Permitindo a exclusao de notas fiscais abertas de saida e sem mercadorias
      if (get_status = stsAberta) then
        if (dataSet.FieldByName('num_nf').AsInteger = 0) then
          if vItem.dataSet.IsEmpty then
            vOK := False;

      // Permitindo a exclusao de notas fiscais de venda fora do estabelecimento canceladas, no caso de cadastramento errado
      if (get_status = stsCancelada) or (get_status = stsAberta) then
        if (dataSet.FieldByName('cod_nf_rem_vfe').AsInteger > 0) then
          vOK := False;
    end;

    if vOK then
    begin
      if dataSet.FieldByName('emissao_propria').AsString = 'S' then
        raise exception.create('Nota Fiscal de Emissão Própria. É necessário Cancelar');
    end;
    if Application.MessageBox(pchar('Atenção' + sLineBreak +
      'Esta opção apagará a Nota Fiscal e os Itens da Nota' + sLineBreak + 'Apagar assim Mesmo?'),
