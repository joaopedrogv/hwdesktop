function TNFCab.limparReferenciaDevolucao: Boolean;
begin  // remove as referencias de devolucao
  try
    if Trim(dataSet.FieldByName('tipo_nf').AsString) <> 'V' then
      raiseExceptionCreate('Nota Fiscal não é de veículos', '');

    if ( vItem.dataSet.FieldByName('cod_nf_dev').AsInteger = 0) and
      (vItem.dataSet.FieldByName('nitem_dev').AsInteger = 0) then
      raiseExceptionCreate('Item não tem nehum vinculo de devolução', '');

    if not vDadosIni.PesqPros('NF0175', 'ALTERAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) +
      'CHASSI: ' +vItem.dataSet.FieldByName('CHASSI').AsString,
      'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas, True) then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'update notafiscal_item set cod_nf_dev = null, nitem_dev = null' +
      ' where cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
      ' and nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
      ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);
    buscas.ExecSQL;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    vDadosIni.GravaAuditoria('NF0175', 'ALTERAR', 'SUCESSO',
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);

    Application.MessageBox('Referencia removida com sucesso', 'Atenção', 0 + 64);

    vItem.dataSet.Refresh;

    Result := True;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

