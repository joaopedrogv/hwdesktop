        //        vIt2Nf.Close;
        //        vIt2Nf.CommandText := 'select * from notafiscal_item' +
        //          ' where cod_nf = ' + IntToStr(dataSet.FieldByName('COD_NF_REF').AsInteger) +
        //          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        //        vIt2Nf.Open;
        j := 0;
        while not vIt2Nf.Eof do
