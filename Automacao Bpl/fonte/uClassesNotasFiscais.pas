  buscas2 := TIBQuery(dtmNF.qrBuscasNf2);
  buscas2.CLose;
  buscas2.Sql.Text := ' select * from tp_comb_renavam ' +
     ' where codigo_tpcomb = ' + IntToStr(pCod) + ' and ativo = 1';
