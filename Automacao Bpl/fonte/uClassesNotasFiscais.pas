function TNFItem.verificaModeloVeiculo(nota: TNFCab): boolean;
var
  stadoDt: TDataSetState;
begin
  if not (vDetVeic.dataSet.state in [dsInsert, dsEdit]) then
    Exit;
  stadoDt := dataSet.State;
  //  if vDetVeic.dataSet.FieldByName('versao').OldValue <>
  //    vDetVeic.dataSet.FieldByName('versao').NewValue then
  begin
    vDetVeic.dataset.post;
    vDetVeic.dataset.Edit;
    vDetVeic.dataSet.FieldByName('versao').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('codigo').AsString;
    vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('descricao').AsString;
    vDetVeic.dataSet.FieldByName('CILINDROS').AsInteger :=
      vDetVeic.vModV.dataSet.FieldByName('cilindros').AsInteger;
    vDetVeic.dataSet.FieldByName('HP').AsFloat := vDetVeic.vModV.dataSet.FieldByName('hp').AsFloat;
    vDetVeic.dataSet.FieldByName('CILINDRADA').AsInteger :=
      vDetVeic.vModV.dataSet.FieldByName('CILINDRADA').AsInteger;
    vDetVeic.dataSet.FieldByName('LOTACAO').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('lotacao').AsString;
    vDetVeic.dataSet.FieldByName('RENAVAM').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('renavam').AsString;
    if (vDadosIni.vEmp.vVersaoVeiculos = '4') and (trim(dataSet.FieldByName('TIPV_VEICULO').AsString) = 'D') then
      vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat := dataSet.FieldByName('VALOR_UNITARIO').AsFloat
    else
      vDetVeic.dataSet.FieldByName('PRECO_TAB').AsFloat := vDetVeic.vModV.dataSet.FieldByName('VALTAB').AsFloat;
    vDetVeic.dataSet.FieldByName('NSERIE').AsString :=
      copy(trim(dataSet.FieldByName('chassi').AsString), 9, 9);
    vDetVeic.dataSet.FieldByName('TIP_PINTURA').AsString := 'S';
    vDetVeic.dataSet.FieldByName('COMBUSTIVEL').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('combustivel').AsString;
    vDetVeic.dataSet.FieldByName('TPCOMB').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('TPCOMb').AsString;
    vDetVeic.dataSet.FieldByName('Tipo').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('tipo').AsString;
    vDetVeic.dataSet.FieldByName('MARCA').AsString :=
      vDetVeic.vModV.dataSet.FieldByName('MARCA_DESC').AsString;

    if vDadosIni.vEmp.vVersaoVeiculos = '4' then
    begin
     vDetVeic.dataSet.FieldByName('COD_COMBUSTIVEL').AsInteger := vDetVeic.vModV.dataSet.FieldByName('cod_combustivel').AsInteger;
     vDetVeic.dataSet.FieldByName('COD_MARCA').AsInteger := vDetVeic.vModV.dataSet.FieldByName('cod_marca').AsInteger;
     vDetVeic.dataSet.FieldByName('COD_TIPO_ESP').AsInteger := vDetVeic.vModV.dataSet.FieldByName('cod_tipo_esp').AsInteger;
    end;

    dataSet.Edit;
    if nota.fdif('tipo_emissao', '4')   then
    begin
      if (nota.dataSet.FieldByName('emissao_propria').AsString <> 'S')
        and (copy(nota.dataSet.FieldByName('codigo_nop').AsString, 2, 3) <> '409')
        and (copy(nota.dataSet.FieldByName('codigo_nop').AsString, 2, 3) <> '913')
        and (nota.dataSet.FieldByName('codigo_nop').AsString <> '1912')
        and (Trim(vDetVeic.dataSet.FieldByName('tipo_venda').AsString) = 'N') then
      begin
        if dataSet.FieldByName('base_icmsub').AsFloat = 0 then
          dataSet.FieldByName('base_icmsub').AsFloat :=
            vDetVeic.vModV.dataSet.FieldByName('VLBICMSUB').AsFloat;
        if dataSet.FieldByName('valor_icmsub').AsFloat = 0 then
          dataSet.FieldByName('valor_icmsub').AsFloat :=
            vDetVeic.vModV.dataSet.FieldByName('VLICMSUB').AsFloat;
        vDetVeic.dataSet.FieldByName('PISCOFINS').AsFloat :=
          vDetVeic.vModV.dataSet.FieldByName('PISCOFINS').AsFloat;
        dataSet.FieldByName('PISCOFINS').AsFloat :=
          vDetVeic.vModV.dataSet.FieldByName('PISCOFINS').AsFloat;
        nota.dataSet.FieldByName('valor_pis').AsFloat :=
          nota.dataSet.FieldByName('valor_pis').AsFloat +
          vDetVeic.vModV.dataSet.FieldByName('valor_pis').AsFloat;
        nota.dataSet.FieldByName('valor_cofins').AsFloat :=
          nota.dataSet.FieldByName('valor_cofins').AsFloat +
          vDetVeic.vModV.dataSet.FieldByName('valor_cofins').AsFloat;

      end
      else
      begin
        dataSet.FieldByName('base_icmsub').AsFloat := 0;
        dataSet.FieldByName('valor_icmsub').AsFloat := 0;
        vDetVeic.dataSet.FieldByName('PISCOFINS').AsFloat := 0;
  //        vDetVeic.vModV.dataSet.FieldByName('PISCOFINS').AsFloat; retornos nao é necessario adicionar o piscofins st
        dataSet.FieldByName('PISCOFINS').AsFloat := 0;
  //        vDetVeic.vModV.dataSet.FieldByName('PISCOFINS').AsFloat;
      end;
    end;
    dataSet.FieldByName('descricao_item').AsString :=
      vDetVeic.dataSet.FieldByName('DESCRICAO_VERSAO').AsString;
    if Trim(vDetVeic.vModV.dataSet.FieldByName('ncmsh').AsString) <> '' then
      dataSet.FieldByName('ncm').AsString :=
        vDetVeic.vModV.dataSet.FieldByName('ncmsh').AsString;
    dataSet.Post;
    if stadoDt = dsEdit then
      dataSet.Edit;
    if (vDetVeic.dataSet.FieldByName('ANO_FAB').AsInteger = 0) and
      (vDetVeic.dataSet.FieldByName('ANO_MOD').AsInteger = 0) then
    begin
      if copy(dataSet.FieldByName('chassi').AsString, 1, 10) =
        copy(vDetVeic.vModV.dataSet.FieldByName('INICHASSI1').AsString, 1, 10) then
      begin
        vDetVeic.dataSet.FieldByName('ANO_FAB').asinteger :=
          vDetVeic.vModV.dataSet.FieldByName('ANO1').asinteger;
        vDetVeic.dataSet.FieldByName('ANO_MOD').asinteger :=
          vDetVeic.vModV.dataSet.FieldByName('MODELO1').asinteger;
      end
      else
      begin
        vDetVeic.dataSet.FieldByName('ANO_FAB').asinteger :=
          vDetVeic.vModV.dataSet.FieldByName('ANO2').asinteger;
        vDetVeic.dataSet.FieldByName('ANO_MOD').asinteger :=
          vDetVeic.vModV.dataSet.FieldByName('MODELO2').asinteger;
      end;
    end;
    vDetVeic.dataset.post;
    vDetVeic.dataset.Edit;
  end;
end;

procedure TNFItem.setDivergenciasNcmCest;
var
  vUpdateProduto, vUpdateModelo, vUpdateNCM, vUpdateCEST, vRepAtiva: Boolean;
  vCamposAd: string;
begin
  divergNcmCest.divergencias.First;
  while not divergNcmCest.divergencias.Eof do
  begin
    if divergNcmCest.divergencias.FieldByName('usncm').AsString = 'cad' then
      if dataSet.Locate('NITEM', divergNcmCest.divergencias.FieldByName('nitem').AsInteger, []) then
      begin
        dataSet.Edit;
        dataSet.FieldByName('ncm').AsString := divergNcmCest.divergencias.FieldByName('ncm_cad').AsString;
        dataSet.Post;
      end;
    if divergNcmCest.divergencias.FieldByName('uscest').AsString = 'cad' then
      if dataSet.Locate('NITEM', divergNcmCest.divergencias.FieldByName('nitem').AsInteger, []) then
      begin
        dataSet.Edit;
        dataSet.FieldByName('cest').AsString := divergNcmCest.divergencias.FieldByName('cest_cad').AsString;
        dataSet.Post;
      end;
    vUpdateProduto := False;
    vUpdateModelo  := False;
    vUpdateNCM     := False;
    vUpdateCEST    := False;
    if dataSet.Locate('NITEM', divergNcmCest.divergencias.FieldByName('nitem').AsInteger, []) then
    begin
      vUpdateProduto := dataSet.FieldByName('tipo_item').AsString = 'P';
      vUpdateModelo  := dataSet.FieldByName('tipo_item').AsString = 'V';
      vUpdateNCM     := divergNcmCest.divergencias.FieldByName('usncm').AsString = 'xml';
      vUpdateCEST    := divergNcmCest.divergencias.FieldByName('uscest').AsString = 'xml';
    end;
    if (vUpdateProduto) and (vUpdateNCM or vUpdateCEST) then
    begin
      vRepAtiva := ExecutaComandosSql('select tabela as valor from tab_rep where tabela = ''PRODUTOS''');
      vCamposAd := '';
      if (vUpdateProduto) and (vUpdateNCM) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select * from nbm where cod_ncm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString);
        buscas.Open;
        if not buscas.IsEmpty then
          vCamposAd :=
            ', cst_pis_ent = '              + QuotedStr(buscas.FieldByName('cst_pis_ent').AsString) +
            ', cst_cofins_ent = '           + QuotedStr(buscas.FieldByName('cst_cofins_ent').AsString) +
            ', cst_pis = '                  + QuotedStr(buscas.FieldByName('cst_pis').AsString) +
            ', cst_cofins = '               + QuotedStr(buscas.FieldByName('cst_cofins').AsString) +
            ', nat_rec = '                  + QuotedStr(buscas.FieldByName('nat_rec').AsString) +
            ', aliq_pis_diferenciada = '    + vDadosIni.formatFloatToFirebird(buscas.FieldByName('aliq_pis_diferenciada').AsFloat) +
            ', aliq_cred_pis = '            + vDadosIni.formatFloatToFirebird(buscas.FieldByName('aliq_cred_pis').AsFloat) +
            ', aliq_cofins_diferenciada = ' + vDadosIni.formatFloatToFirebird(buscas.FieldByName('aliq_cofins_diferenciada').AsFloat) +
            ', aliq_cred_cofins = '         + vDadosIni.formatFloatToFirebird(buscas.FieldByName('aliq_cred_cofins').AsFloat);
      end;
      buscas.Close;
      buscas.SQL.Text := 'update produtos ' +
        vDadosIni.IfThen(vUpdateNCM, 'set rep_int_active = 1, nbm = ' + QuotedStr(dataSet.FieldByName('ncm').AsString) , '') +
        vDadosIni.IfThen(vUpdateNCM and vUpdateCEST, ', ', '') +
        vDadosIni.IfThen(not vUpdateNCM and vUpdateCEST, 'set ', '') +
        vDadosIni.IfThen(vUpdateCEST, ' cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString), '') +
        vCamposAd +
        ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
        vDadosIni.IfThen(vRepAtiva, '', ' and cod_empresa = ' + vDadosIni.codEmpresa);
      buscas.ExecSQL;
    end
    else if (vUpdateModelo) and (vUpdateNCM or vUpdateCEST) then
      if vDetVeic.dataSet.Locate('NITEM', dataSet.FieldByName('NITEM').AsInteger, []) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update TIPMODELO ' +
          vDadosIni.IfThen(vUpdateNCM, 'set NCMSH = ' + QuotedStr(dataSet.FieldByName('ncm').AsString) , '') +
          vDadosIni.IfThen(vUpdateNCM and vUpdateCEST, ', ', '') +
          vDadosIni.IfThen(vUpdateCEST, 'set cest = ' + QuotedStr(dataSet.FieldByName('cest').AsString), '') +
          ' where codigo = ' + IntToStr(vDetVeic.dataSet.FieldByName('versao').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
      end;   
    divergNcmCest.divergencias.Next;
  end;
end;

