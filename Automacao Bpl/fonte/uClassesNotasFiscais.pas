        vItem.vDetVeic.Apply
      else if dataSet.FieldByName('tipo_nf').AsString = 'P' then
//        if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
          vItem.vDetEcf.Apply;
      //      if CommitaTransacao then

      _atualizarSituacaoPedidos('Iniciado');

      if (dataSet.FieldByName('natureza_nf').AsString = 'S') then
        GravarHistEstMoto;

      CommitaTransacao;
      //      vSped.vC110.vC111.Apply;
      //      vSped.vC110.vC112.Apply;
      //      vSped.vC110.vC113.Apply;
      //      vSped.vC110.vC114.Apply;
      //      CommitaTransacao;
      vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
