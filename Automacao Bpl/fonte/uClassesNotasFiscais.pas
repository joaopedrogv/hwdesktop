function TNFCab.referenciarDevolucao: Boolean;
var
  vSql: string;
begin  // abre o formulario para efetuar uma nova referencia de devolucao
  try
    if Trim(dataSet.FieldByName('tipo_nf').AsString) <> 'V' then
      raiseExceptionCreate('Nota Fiscal não é de veículos', '');

    setCFOPDevolucao;

    if (not cfopDeDevolucao(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat))) and
      (not cfopDeDevolucaoSPED(Trunc(vItem.dataSet.FieldByName('codigo_nop').AsFloat))) then
        raiseExceptionCreate('CFOP do item não é um CFOP de devolução', '');

    if not vDadosIni.PesqPros('NF0177', 'ALTERAR', 'NUM NF ' + Trim(dataSet.FieldByName('num_nf').asString) +
      'CHASSI: ' +vItem.dataSet.FieldByName('CHASSI').AsString,
      'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas, True) then
      Exit;

    if Trim(dataSet.FieldByName('natureza_nf').AsString) = 'S' then
      vSql := 'E'
    else
      vSql := 'S';

    vSql := 'select nf.num_nf "Num NF", nf.data_lanc "Data NF", nf.status "Status", cast(substring(nf.situacao_nfe from 1 for 12) as varchar(12)) "Situação NF-e",' +
      ' nfi.nitem "Nº Item", nfi.valor_total "Vr Tot Item", nf.valor_total "Valor NF",' +
      ' nfi.codigo_nop CFOP, nf.serie "Serie", nf.modelo_nf "Modelo", c.nome_cliente "Nome Fantasia",' +
      ' c.razao "Razao Social", nfi.cod_nf "Cod NF", nfi.nitem "Nitem", nfi.cod_nf "Cod_NF" from notafiscal_item nfi' +
      ' inner join notafiscal nf on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
      ' inner join clientes c on c.cod_cliente = nf.cod_cliente and c.cod_empresa = nf.cod_empresa' +
      ' where nfi.chassi = ' + QuotedStr(vItem.dataSet.FieldByName('chassi').AsString) +
      ' and nfi.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and nf.natureza_nf = ' + QuotedStr(vSql) +
      ' and nf.status = ' + QuotedStr(stsFechada) + 
      ' and ( (nf.emissao_propria = ''S'' and nf.modelo_nf = ''55'' and coalesce(nf.situacao_nfe,'''') <> '''' )' +
      ' or (nf.emissao_propria = ''S'' and nf.modelo_nf <> ''55'')' +
      ' or (nf.emissao_propria = ''N'') )' +
      ' order by nf.data_lanc desc, nf.num_nf desc';

    if abreFormReferenciasDevolucao( 'Chassi: ' + Trim(vItem.dataSet.FieldByName('chassi').AsString) +
      ' Item: ' + vItem.dataSet.FieldByName('nitem').AsString +
      '. Informar nota fiscal que originou a devolução', vSql) then
    begin
      vSql := 'update notafiscal_item set cod_nf_dev =' + IntToStr(buscas.FieldByName('cod_nf').AsInteger) +
        ' , nitem_dev = ' + IntToStr(buscas.FieldByName('nitem').AsInteger) +
        ' where cod_nf = ' + IntToStr(vItem.dataSet.FieldByName('cod_nf').AsInteger) +
        ' and nitem = ' + IntToStr(vItem.dataSet.FieldByName('nitem').AsInteger) +
        ' and cod_empresa = ' + IntToStr(vItem.dataSet.FieldByName('cod_empresa').AsInteger);

      buscas.Close;
      buscas.SQL.Text := vSql;
      buscas.ExecSQL;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      vDadosIni.GravaAuditoria('NF0177', 'ALTERAR', 'SUCESSO',
        'NOTAFISCAL', dataSet.FieldByName('cod_nf').AsString, buscas);

      Application.MessageBox('Nota fiscal referenciada com sucesso', 'Atenção', 0 + 64);

      vItem.dataSet.Refresh;

      Result := True;
    end;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

procedure TNFCab.RegistrarAjusteC195C197_ICMS_SN;
var
  conf: TConfig_sistema_class;
  lanc: TSped_lancamento_fiscal_class;
  ajus: TNotafiscal_sped_c195_c197_cls;
  vliq: Double;
begin
  if StartsText('SIMPLES', vDadosIni.vEmp.vRegime) then
    Exit;

  if fequals('emissao_propria', 'S') then
    Exit;

  conf := TConfig_sistema_class.getConf('efd_icms_escrituracao', buscas, vDadosIni.cod_empresa);
  ajus := TNotafiscal_sped_c195_c197_cls.Create;
  lanc := TSped_lancamento_fiscal_class.Create;
  try
    if not conf.AsBoolean then
      Exit;

    if not ContainsText(conf.ReadString('ICMSSN', 'FormaAjuste'), 'S') then
      exit;

    if SqlOpen('select nfi.icm_picm aliq_icms, sum(nfi.valor_icmsub) vl_icmsst, sum(nfi.icm_vicm) vl_icms,' +
               'sum(coalesce(nfi.valor_total,0) -  coalesce(nfi.rateio_desconto,0) + coalesce(nfi.rateio_seguro,0) +' +
               '    coalesce(nfi.rateio_outdesp,0) + iif(nf.frete_f_nfe = ''S'', 0, coalesce(nfi.rateio_frete,0))  +' +
               '    coalesce(iif(nfi.valor_icmsub_ant > 0, 0, nfi.valor_icmsub), 0) + coalesce(nfi.valor_ipi,0)) vliq' +
               ' from notafiscal nf' +
               ' left join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa' +
               ' where nf.emissao_propria = ''N'' and nf.cod_nf = %d and nf.cod_empresa = %d' +
               '  and coalesce(nfi.icm_csosn, '''') <> '''' and nfi.icm_vicm > 0 and coalesce(nfi.valor_icmsub, 0) = 0' +
               ' group by 1',
               [fint('cod_nf'), vDadosIni.cod_empresa]).IsEmpty then
      Exit;
      
    ajus.vl_icms := RoundTo(buscas.FieldByName('vl_icms').AsFloat, -2);
    ajus.aliq_icms := RoundTo(buscas.FieldByName('aliq_icms').AsFloat, -2);
    vliq := RoundTo(buscas.FieldByName('vliq').AsFloat, -2);

    if not SqlOpen('select cod_nf from notafiscal_sped_c195_c197 n' +
                   ' where cod_nf = %d and cod_empresa = %d and n.cod_aj = %s',
                   [fint('cod_nf'), vDadosIni.cod_empresa, QuotedStr(conf.ReadString('ICMSSN', 'CodigoAjuste'))])
                   .IsEmpty then
      Exit;

    if Trim(conf.ReadString('ICMSSN', 'CodigoAjuste')) = '' then
    begin
      ShowAtencao('Codigo de ajuste para lançamento de valores do Simples Nacional não configurado' + sLineBreak +
                  'Configuração global: efd_icms_escrituracao' + sLineBreak +
                  '[ICMSSN]' + sLineBreak +
                  'CodigoAjuste=MG10990505' + sLineBreak + sLineBreak +
                  '1° Por favor configure o código do ajuste corretamente' + sLineBreak +
                  '2° Cadastre o código no cadastro de lançamentos no menu Sped Fiscal' + sLineBreak +
                  '3º Cadastre o lançamento de ajuste usando o lançamento correspondente com o valor de crédito do SN contido na nota fiscal');
      Exit;
    end;

    lanc.CopyFrom(SqlOpen('select first 1 sl.* from sped_lancamento_fiscal sl' +
                          ' where sl.cod_padrao_ajuste = %s and sl.cod_empresa = %d',
                          [QuotedStr(conf.ReadString('ICMSSN', 'CodigoAjuste')), vDadosIni.cod_empresa]));

    if lanc.cod_obs = 0 then
    begin
      lanc.cod_empresa := vDadosIni.cod_empresa;
      lanc.txt := 'APROVEITAMENTO DE CREDITO DE ICMS – FORNECEDOR OPTANTE PELO SIMPLES NACIONAL';
      lanc.cod_padrao_ajuste := conf.ReadString('ICMSSN', 'CodigoAjuste');
      with lanc.SQLMotor('cod_obs', 'CONF_ASSISTENTE') do
        lanc.cod_obs := SqlInsertID(SQLInsertAutoInc, 'cod_obs');
    end;

    if not SqlOpen('select cod_nf from notafiscal_sped_c195_c197 n' +
                   ' where cod_nf = %d and cod_empresa = %d and n.cod_obs = %d and nitem = 0',
                   [fint('cod_nf'), vDadosIni.cod_empresa, lanc.cod_obs])
                   .IsEmpty then
      Exit;

    ajus.cod_nf := fint('cod_nf');
    ajus.cod_empresa := vDadosIni.cod_empresa;
    ajus.cod_obs := lanc.cod_obs;
    ajus.nitem := 0;
    ajus.cod_aj := lanc.cod_padrao_ajuste;
    if Abs(RoundTo(ajus.aliq_icms * vliq / 100, -2) - ajus.vl_icms) <= 0.01  then
      ajus.vl_bc_icms :=RoundTo(vliq, -2)
    else
      ajus.vl_bc_icms := RoundTo(ajus.vl_icms / ajus.aliq_icms * 100, -2);
    SqlExec(ajus.SQLMotor().SQLInsert);

  finally
    conf.Free;
    ajus.Free;
    lanc.Free;
  end;
end;

function TNFCab.cancelarDetalhesFatura(indice: integer;
  cdsDesp: TClientDataSet): boolean;
var
  I: Integer;
  J: Integer;
begin
  Result := False;
  if Application.MessageBox('Se cancelar os dados apresentados serão perdidos. Deseja sair assim mesmo?','Atenção',
      MB_ICONQUESTION+MB_YESNO) = IDNO then
      exit;
  while not vDetDesp.IsEmpty do
    vDetDesp.Delete;
  for I := 0 to High(FFatura.despesas) do
