procedure TNFCab.verificaCFOP;
var
  i, j: integer;
  sair: boolean;
  vCFOP: array[1..8] of string;
  temp: string;
begin
  sair := false;
  for i := 1 to 8 do vCFOP[I] := '0';

  vItem.dataset.First;
  while not vItem.dataset.eof do
  begin
    for i := 1 to 8 do
      if (vCFOP[i] = '0') then
      begin
        for j := 1 to 8 do
          if (vCFOP[j] = vItem.dataset.FieldByName('CODIGO_NOP').AsString) then
          begin
            sair := true;
            break;
          end;
        if not sair then
        begin
          vCFOP[I] := vItem.dataset.FieldByName('CODIGO_NOP').AsString;
          break;
        end;
      end;
    sair := false;
    vItem.dataset.Next;
  end;
  for i := 1 to 8 do
    if vCFOP[i] = '0' then
      vCFOP[i] := '';
  temp := '';
  for i := 1 to 8 do
    if vCFOP[i] <> '' then
      temp := temp + vCFOP[i] + ',';
  if (temp <> '') then
    temp := copy(temp, 1, length(temp) - 1);
  if (temp = '') or (vDadosIni.vQtdeImpCFOPNF = '0') or (vDadosIni.vQtdeImpCFOPNF = '1') then
    FImpCFOP := dataSet.FieldByName('CODIGO_NOP').AsString
  else
    FImpCFOP := copy(temp, 1, (StrToInt(vDadosIni.vQtdeImpCFOPNF) * 5) - 1);
end;

