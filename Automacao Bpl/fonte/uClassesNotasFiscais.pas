function TNFCab.VerificarGrades: boolean;
var
  formulario: TfrmPadrao;
  controlsDisabled: Boolean;
begin
  Result := True;
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    if (vItem.dataSet.FieldByName('tipo_item').AsString = 'P') and
    (vItem.dataSet.FieldByName('altera_estoque_cfop').AsString <> 'N') then
    begin
      if vItem.dataSet.FieldByName('COD_GRADE').AsInteger > 0 then
      begin
         if vGrComp.selecionaGradeCompra(
          vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_nf').AsInteger,
          vItem.dataSet.FieldByName('nitem').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString,
          vItem.dataSet.FieldByName('selg').AsString,
          vItem.dataSet.FieldByName('quantidade').AsFloat) then
        begin
          vGrComp.dataSet.Insert;
          vGrComp.dataSet.FieldByName('NUM_NOTA_NFE').AsInteger := dataSet.FieldByName('cod_nf').AsInteger;
          vGrComp.dataSet.FieldByName('COD_FORN_NFE').AsInteger := vItem.dataSet.FieldByName('nitem').AsInteger; //0;
          vGrComp.dataSet.FieldByName('GRUPO_PROD').AsInteger := vItem.dataSet.FieldByName('GRUPO_PROD').AsInteger;
          vGrComp.dataSet.FieldByName('COD_PROD').AsString := vItem.dataSet.FieldByName('COD_PROD').AsString;
          vGrComp.dataSet.FieldByName('COD_GRADE').AsInteger := vItem.dataSet.FieldByName('COD_GRADE').AsInteger;
          vGrComp.dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
          vGrComp.dataSet.FieldByName('QTDE').AsFloat := vItem.dataSet.FieldByName('quantidade').AsFloat;
          vGrComp.dataSet.Post;
          if not vGrComp.Apply then
          begin
            Application.MessageBox('Problema ao incluir grade vinculada pelo código de barras do produto ou pelo código vindo do fornecedor', 'Atenção', 0 + 64);
            Result := False;
            Exit;
          end;
          
        end;
      end
      else
      try
        if vGrComp.selecionaGradeCompra(
          vItem.dataSet.FieldByName('grupo_prod').AsInteger,
          vItem.dataSet.FieldByName('cod_nf').AsInteger,
          vItem.dataSet.FieldByName('nitem').AsInteger,
          vItem.dataSet.FieldByName('cod_prod').AsString,
          vItem.dataSet.FieldByName('selg').AsString,
          vItem.dataSet.FieldByName('quantidade').AsFloat) then
        begin
          while true do
          begin

            try
              controlsDisabled := vItem.dataSet.ControlsDisabled;
              vItem.dataSet.EnableControls;
              formulario := TfrmPadrao.Create(Application);
              formulario.Width := 620;
              formulario.Height := 500;
              formulario.Position := poScreenCenter;
              formulario.Caption := 'Entrada de Grades no Estoque';
              frmCadNF.Panel12.Parent := formulario;
              formulario.AutoSize := True;
              formulario.AutoScroll := False;
              formulario.ShowHint := True;
              frmCadNF.BitBtn27.Enabled := False;
              frmCadNF.BitBtn25.Enabled := True;
              frmCadNF.BitBtn26.Enabled := not vGrComp.dataSet.IsEmpty;
              frmCadNF.lbQtdeInformada.Caption :=
                'Quantidade Informada: ' + Format('%0.4f', [vGrComp.QtdeInformada]);
              frmCadNF.lbQtdePendente.Caption :=
                'Quantidade Pendente: ' + Format('%0.4f', [vGrComp.QtdePendente]);
              frmCadNF.edQuantGradeCompra.AsValue := vGrComp.QtdePendente;
              frmCadNF.lb_ent_grade_prod.Caption := Format('%d - %s' , [vItem.fint('nitem'), vItem.fstr('descricao_item')]);
              frmCadNF.lb_ent_grade_dados.Caption := Format('Grupo %d - Codigo %s - Num Fab %s - Unidade %s', [vItem.fint('grupo_prod'), vItem.fstr('cod_prod'), vItem.fstr('num_fab_prod'), vItem.fstr('referencia')]);
              if Format('%0.4f', [vGrComp.QtdePendente]) = '0,0000' then
              begin
                frmCadNF.BitBtn27.Enabled := True;
                frmCadNF.BitBtn25.Enabled := False;
              end;
              if formulario.ShowModal = mrOk then
                Break
              else if Application.MessageBox(pchar('Não foi confirmada a entrada da Grade.' + sLineBreak
                + 'Deseja cancelar a entrada de estoque das grades'), 'Confirmação',
                MB_YESNO + MB_ICONQUESTION) = ID_YES then
                begin
                  Result := False;
                  Exit;
                end;
            finally

              if controlsDisabled then
                vItem.dataSet.DisableControls;
              frmCadNF.Panel12.Parent := frmCadNF.tsEntGrade;
              formulario.Free;
              formulario := nil;
            end;

          end;

        end;
      except
        on e: Exception do begin
          Result := false;
          registraErro('COD NF: ' + dataSet.FieldByName('natureza_nf').AsString + ' ' +
            dataSet.FieldByName('cod_nf').AsString + ' verificarGrades ' +
            vItem.dataSet.FieldByName('grupo_prod').AsString + ' ' +
            vItem.dataSet.FieldByName('cod_prod').AsString + ' ' + e.Message);
        end;
      end;
    end;
    vItem.dataSet.Next;
  end;
end;

