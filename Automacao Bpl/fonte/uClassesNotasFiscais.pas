function TNFCab._VerificarPendenciaNFeComando(pTipo: tTipoApagar): boolean;
var
 vApagarNF: boolean;
 vMensagem, vTemp: string;
 buscas2: TIBQuery;
 pCodigo: Integer;
 pChassi: string;
begin
  Result := True;
  case pTipo of
   tApagar: vMensagem := 'Apagar';
   tCancelar: vMensagem := 'Cancelar';
  end;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  buscas.Close;
  buscas.SQL.Text := ' select cf.cod_nf, cf.num_nota_v, cf.n_comando, cf.tipo, cf.natureza, c.nome_vendedor from com_fat cf' +
    ' left join colaborador c on c.cod_vendedor = cf.covend_v and c.cod_empresa = cf.cod_empresa ' +
    ' where cf.chassiv = :chassi_c ' +
//    ' and cf.cod_estmoto = :codigo ' +
    ' and cf.cod_empresa = :cod_empresa ' +
    ' and (coalesce(trim(cf.status_v), '''') <> ' + QuotedStr('CANCELADO') + ') ' +
    ' order by cf.natureza desc, cf.n_comando desc ';
  buscas.ParamByName('CHASSI_C').AsString := trim(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString);
  //   buscas.ParamByName('CODIGO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrtoInt(vDadosIni.codEmpresa);
  buscas.Open;
  buscas.FetchAll;
  if not buscas.IsEmpty then
  begin
     if trim(buscas.FieldByName('TIPO').AsString) = 'CTR' then
       vTemp := 'Contrato: '
     else
       vTemp := 'Comando: ';
     if trim(buscas.FieldByName('NATUREZA').AsString) = 'E' then
     begin
       if Application.MessageBox(pchar('Atenção' + sLineBreak +
         'Veículo vinculado no '+vTemp+  vDadosIni.strzero(buscas.FieldByName('N_COMANDO').asinteger, 6) + sLineBreak +
         'Nota Fiscal de Entrada Nº ' + IntToStr(buscas.FieldByName('NUM_NOTA_V').AsInteger) + sLineBreak +
         'Colaborador: ' + trim(buscas.FieldByName('NOME_VENDEDOR').AsString) + sLineBreak +
         'Deseja ' + Trim(vMensagem) + ' Nota Fiscal assim Mesmo?'),
         'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = IDNO then
       begin
         Result := False;
         exit;
       end;
     end
     else
     begin
       vApagarNF := False;
       if dataSet.FieldByName('COD_NF').AsInteger >= buscas.FieldByName('COD_NF').AsInteger then
         vApagarNF := True;

       if not vApagarNF then
       begin
         Application.MessageBox(pchar('Veículo vinculado no '+vTemp+  vDadosIni.strzero(buscas.FieldByName('N_COMANDO').asinteger, 6) + sLineBreak +
           'Nota Fiscal de Saída Nº ' + IntToStr(buscas.FieldByName('NUM_NOTA_V').AsInteger) + sLineBreak +
           'Colaborador: ' + trim(buscas.FieldByName('NOME_VENDEDOR').AsString)+ sLineBreak +
           'Não é possível ' + Trim(vMensagem) + ' Nota Fiscal!'), 'Atenção', MB_OK + MB_ICONINFORMATION);
         Result := False;
         exit;
       end;
     end;
  end;

   buscas.Close;
   buscas.SQL.Text := ' select first 1 nf.natureza_nf, nf.cod_nf, nfi.cod_estmoto, nfi.chassi, nfi.cod_estmoto, ' +
    ' nf.status, nf.num_nf, nf.serie, nf.modelo_nf, nf.data_lanc, nfi.tipv_veiculo, c.nome_vendedor from notafiscal nf ' +
    ' inner join notafiscal_item nfi on nfi.cod_nf = nf.cod_nf and nfi.cod_empresa = nf.cod_empresa ' +
    ' left join colaborador c on c.cod_vendedor = nf.cod_vendedor and c.cod_empresa = nf.cod_empresa ' +
    ' where nfi.chassi = :chassi_c ' +
//    ' and nfi.cod_estmoto = :codigo ' +
    ' and nf.tipo_nf = ''V'' ' +
    ' and (trim(coalesce(nf.status, '''')) <> ' + QuotedStr(stsCancelada) + ') ' +
    ' and nf.cod_empresa = :cod_empresa order by nf.cod_nf desc ';
   buscas.ParamByName('CHASSI_C').AsString := trim(vItem.vDetVeic.dataSet.FieldByName('chassi').AsString);
//   buscas.ParamByName('CODIGO').AsInteger := vItem.vDetVeic.dataSet.FieldByName('cod_estmoto').AsInteger;
   buscas.ParamByName('COD_EMPRESA').AsInteger := StrtoInt(vDadosIni.codEmpresa);
   buscas.Open;

   if not buscas.IsEmpty then
   begin
      if not (dataSet.FieldByName('COD_NF').AsInteger >= buscas.FieldByName('COD_NF').AsInteger) then
      begin
        if trim(buscas.FieldByName('NATUREZA_NF').AsString) = 'E' then
          vTemp := 'Entrada'
        else
          vTemp := 'Saída';
        Application.MessageBox(pchar('Veículo pendente na Nota Fiscal de '+vTemp+' Nº ' + buscas.FieldByName('num_nf').AsString + sLineBreak +
         'Colaborador: ' + trim(buscas.FieldByName('NOME_VENDEDOR').AsString)+ sLineBreak +
         'Não é possível ' + Trim(vMensagem) + ' Nota Fiscal!'), 'Atenção', mb_ok +
        MB_ICONINFORMATION);
        Result := False;
        exit;
      end;
   end;

end;

function TNFCab._verificarProdutoSemVinculoPreNota: Boolean;
begin
  vItem.dataSet.First;
  while not vItem.dataSet.Eof do
  begin
    vItem.dataSet.Edit;
    if (Trim(vItem.dataSet.FieldByName('TIPO_ITEM').AsString) = 'P') and (Trim(vItem.dataSet.FieldByName('cod_prod').AsString) = '') then
    begin

      if (vDadosIni.vEmp.vBuscaCodNoProduto <> 'S') and (Trim(vItem.dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString) <> '') then
      begin
        vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString :=
          getCodigoPeloCodFornecedor(vItem.dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString, false);
        if trim(vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString) <> '' then
        begin
         vItem.dataSet.FieldByName('descricao_item').AsString := uppercase(trim(vProdForn.dataSet.FieldByName('descr_prod').AsString));
         vItem.dataSet.FieldByName('cod_prod').AsString := vProdForn.dataSet.FieldByName('cod_prod').AsString;
         vItem.dataSet.FieldByName('grupo_prod').AsString := vProdForn.dataSet.FieldByName('grupo_prod').AsString;
         vItem.dataSet.FieldByName('consumo').AsString := vProdForn.dataSet.FieldByName('consumo').AsString;
          if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
           vItem.dataSet.FieldByName('ecf').AsString := vProdForn.dataSet.FieldByName('ecf').AsString;
         vItem.dataSet.FieldByName('cod_grade').AsInteger := vProdForn.vCodGrade;
        end;
      end
      else
      begin
        vItem.vProd.FBuscarApenasCB := True;
        if vItem.vProd.buscaProduto(vItem.dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString, False) then
        begin
         vItem.dataSet.FieldByName('num_fab_prod').AsString := vItem.vProd.dataSet.FieldByName('num_fab_prod').AsString;
         vItem.dataSet.FieldByName('cod_prod').AsString := vItem.vProd.dataSet.FieldByName('cod_prod').AsString;
         vItem.dataSet.FieldByName('grupo_prod').AsString := vItem.vProd.dataSet.FieldByName('grupo_prod').AsString;
         vItem.dataSet.FieldByName('consumo').AsString := vItem.vProd.dataSet.FieldByName('consumo').AsString;
          if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
           vItem.dataSet.FieldByName('ecf').AsString := vItem.vProd.dataSet.FieldByName('ecf').AsString;
         vItem.dataSet.FieldByName('cod_grade').AsInteger := vItem.vProd.vCodGrade;
        end
        else
        begin
         vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString :=
           getCodigoPeloCodFornecedor(vItem.dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString, false);

          if trim(vItem.dataSet.FieldByName('NUM_FAB_PROD').AsString) <> '' then
          begin
           vItem.dataSet.FieldByName('descricao_item').AsString := uppercase(trim(vProdForn.dataSet.FieldByName('descr_prod').AsString));
           vItem.dataSet.FieldByName('cod_prod').AsString := vProdForn.dataSet.FieldByName('cod_prod').AsString;
           vItem.dataSet.FieldByName('grupo_prod').AsString := vProdForn.dataSet.FieldByName('grupo_prod').AsString;
           vItem.dataSet.FieldByName('consumo').AsString := vProdForn.dataSet.FieldByName('consumo').AsString;
            if Trim(vDadosIni.vEmp.vCredencInterventor) <> '' then
             vItem.dataSet.FieldByName('ecf').AsString := vProdForn.dataSet.FieldByName('ecf').AsString;
           vItem.dataSet.FieldByName('cod_grade').AsInteger := vProdForn.vCodGrade;
          end;
        end;
      end;
    end;
    vItem.dataSet.Post;

    vItem.dataSet.Next;
  end;
end;

