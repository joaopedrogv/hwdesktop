    vItem.dataSet.FieldByName('indtot').AsInteger := 1;
    vItem.dataSet.FieldByName('indsomapisst').AsInteger := 1;
    vItem.dataSet.FieldByName('indsomacofinsst').AsInteger := 1;
    vItem.dataSet.FieldByName('modbc').AsInteger := 3;
    {vItem.dataSet.FieldByName('cst_pis').AsString := '99';
    vItem.dataSet.FieldByName('cst_cofins').AsString := '99';}
    vItem.dataSet.FieldByName('cst_IPI').AsString := '02';
    if fstrin('modelo_nf', ['6', '06', '66']) then
      TFloatField(vItem.dataSet.FieldByName('valor_unitario')).DisplayFormat := ''
    else
      TFloatField(vItem.dataSet.FieldByName('valor_unitario')).DisplayFormat := DisplayNumber(2);
    if vItem.dataSet.RecordCount = 0 then
    begin
      vItem.dataSet.fieldbyname('quantidade').AsFloat := 1;
      vItem.dataSet.FieldByName('valor_unitario').AsFloat :=
        dataSet.FieldByName('valor_prod').AsFloat;
      vItem.dataSet.fieldbyname('valor_total').AsFloat := vDadosIni.StrToFloatFormat(
        vItem.dataSet.fieldbyname('valor_unitario').AsFloat *
        vItem.dataSet.fieldbyname('quantidade').AsFloat, 2);
      vItem.dataSet.fieldbyname('aliq_icm').AsFloat := dataSet.fieldbyname('aliq_icm').AsFloat;
      vItem.dataSet.fieldbyname('base_icm').AsFloat := dataSet.fieldbyname('base_icm').AsFloat;
      vItem.dataSet.fieldbyname('valor_icm').AsFloat := dataSet.fieldbyname('valor_icm').AsFloat;
    end;
    Result := True;
  end;
end;

