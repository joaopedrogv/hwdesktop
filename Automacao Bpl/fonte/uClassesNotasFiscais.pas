function TNFCab.abreMargem: boolean;
begin
  if not vDadosIni.PesqPros('NF0027', 'CONSULTA', 'NUM NF ' + dataSet.FieldByName('NUM_NF').AsString, 'NOTAFISCAL',
    dataSet.FieldByName('COD_NF').AsString, dtmNF.qrBuscas, True) then
    Exit;
  try
    Result := False;
    vItem.OnAfterScroll := nil;
    vItem.selecionaItens(dataSet.FieldByName('cod_nf').AsInteger);
    if dataSet.FieldByName('natureza_nf').AsString = 'S' then
      raise exception.create('Nota fiscal de Saída. Margem não pode ser aberta');
    if dataSet.FieldByName('tipo_nf').AsString <> 'P' then
      raise exception.create('Nota fiscal não é de Produtos. Margem não pode ser aberta');

    FConfig.ExecutarLeitura(f_str('natureza_nf'));

    if Self.emEdicao then
      Self.CalcularCustoDosProdutos(opdCalculoCusto);

    try
      if fdif('status', stsFechada) then
      begin
        vItem.montaDataSetTemp(dataSet.FieldByName('cod_devolucao').AsInteger);
        vItem.dataSet := TClientDataSet(DtmNF.cdsTempINf);
      end;

      verificaMargemProdutos(False);
    finally
      vItem.dataSet := TClientDataSet(DtmNF.cdsINf);
    end;
    //    if vItem.Apply then
    //    begin
    //      CommitaTransacao;
    //      Result := true;
    //    end
    //    else
    //      RollBackTransacao;
    //    vItem.Close;
  except on e: exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

