  object qrServicosSugeridos: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      
        'select regras_sug.codigo, regras_sug.descricao, regras_sug.mes_r' +
        'et_serv1, regras_sug.mes_ret_serv2, regras_sug.interv_mes_serv, '
      
