  object qrFilaReserva: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      'SELECT FL.*, VN.NOME_VENDEDOR, TP.DESCRICAO,TP.CILINDRADA,'
      'COR.DESCRICAO_COR FROM FILA_RESERVA_VEIC FL'
      
        'LEFT JOIN COLABORADOR VN ON VN.COD_VENDEDOR = FL.COD_VENDEDOR AN' +
        'D VN.COD_EMPRESA = FL.COD_EMPRESA'
      
        'LEFT JOIN TIPMODELO TP ON TP.CODIGO = FL.COD_MODELO AND TP.COD_E' +
        'MPRESA = FL.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES CL ON CL.COD_CLIENTE = FL.COD_CLIENTE AND CL.' +
        'COD_EMPRESA = FL.COD_EMPRESA'
      'LEFT JOIN CODIGO_CORFAB COR ON COR.COD_COR = FL.COD_COR')
    Left = 607
    Top = 89
  end
  object dspFilaReserva: TDataSetProvider
    DataSet = qrFilaReserva
    Options = [poAllowCommandText, poUseQuoteChar]
    UpdateMode = upWhereChanged
    Left = 609
    Top = 138
  end
