  object qrEstMotos: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      
        'SELECT EST_MOTO.*, CL.NOME_CLIENTE CLIENTE, F.NOME_CLIENTE FORNE' +
        'CEDOR, COL.NOME_VENDEDOR FROM EST_MOTO'
      
        'LEFT JOIN CLIENTES CL ON CL.COD_CLIENTE = EST_MOTO.COD_CLIENTE A' +
        'ND CL.COD_EMPRESA = EST_MOTO.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES F ON F.COD_CLIENTE = EST_MOTO.COD_FORNECEDOR ' +
        'AND F.COD_EMPRESA = EST_MOTO.COD_EMPRESA'
      
        'LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = EST_MOTO.VENDEDO' +
        'R_RES AND COL.COD_EMPRESA = EST_MOTO.COD_EMPRESA'
      
        'WHERE EST_MOTO.ATIVO = 1 AND EST_MOTO.CODIGO = 0 AND EST_MOTO.CO' +
        'D_EMPRESA =1 and EST_MOTO.COD_EMPRESA = 1')
    Left = 45
    Top = 1212
  end
