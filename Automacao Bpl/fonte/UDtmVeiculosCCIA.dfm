  object qrCFOPComFat: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      'SELECT NAT.*, SPED.TXT, SPED.TXT_COMPL FROM NAT_OP NAT'
      
        'LEFT JOIN SPED_INFORMACAO_COMPLEMENTAR SPED ON SPED.COD_INF = NA' +
        'T.COD_INF AND SPED.COD_EMPRESA =  1'
      'WHERE NAT.CODIGO_NOP=0')
    Left = 913
    Top = 1461
  end
