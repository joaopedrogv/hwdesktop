  object qrPendencias: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      
        'SELECT PENDENCIAS_VEIC.*, TIPO_PENDENCIA.DESCRICAO AS DESCRICAO_' +
        'TP FROM PENDENCIAS_VEIC'
      
        'INNER JOIN TIPO_PENDENCIA ON PENDENCIAS_VEIC.COD_TP_PENDENCIA = ' +
        'TIPO_PENDENCIA.COD_TP_PENDENCIA'
      'where cod_empresa = -1')
    Left = 575
    Top = 309
  end
