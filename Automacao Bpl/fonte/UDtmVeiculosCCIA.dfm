  object qrComFat: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      
        'SELECT CF.*, CL.NOME_CLIENTE CLIENTE, INTER.NOME_CLIENTE INTERME' +
        'DIADOR,'
      
        'CON.NOME_CLIENTE CONCESSIONARIA, CLV.NOME_CLIENTE CLIENTE_VENDED' +
        'OR,'
      
        'COL.NOME_VENDEDOR VENDEDOR, GER.NOME_VENDEDOR GERENTE, COND.DESC' +
        '_COND_PAG CONDPAG,'
      'USFECH.NOME_VENDEDOR NOME_US_FECH FROM COM_FAT CF'
      
        'LEFT JOIN CLIENTES CL ON CL.COD_CLIENTE = CF.CLIENTES_V AND CL.C' +
        'OD_EMPRESA = CF.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES INTER ON INTER.COD_CLIENTE = CF.COD_INTERMED ' +
        'AND INTER.COD_EMPRESA = CF.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES CON ON CON.COD_CLIENTE = CF.COD_CONCESS AND C' +
        'ON.COD_EMPRESA = CF.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES CLV ON CLV.COD_CLIENTE = CF.COD_CLI_VENDE AND' +
        ' CLV.COD_EMPRESA = CF.COD_EMPRESA'
      
        'LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = CF.COVEND_V AND ' +
        'COL.COD_EMPRESA = CF.COD_EMPRESA'
      
        'LEFT JOIN COLABORADOR GER ON GER.COD_VENDEDOR = CF.COD_GERENTE A' +
        'ND GER.COD_EMPRESA = CF.COD_EMPRESA'
      'LEFT JOIN COND_PAG COND ON COND.COD_COND_PAG = CF.CONDPAG_V'
      
        'LEFT JOIN COLABORADOR USFECH ON USFECH.COD_VENDEDOR = CF.COD_US_' +
        'FECH AND USFECH.COD_EMPRESA = CF.COD_EMPRESA'
      'WHERE 1 = 0')
    Left = 33
    Top = 1457
  end
