  object qrHistCTRSEstMotos: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      'SELECT'
      
        'CASE WHEN ((TRIM(COALESCE(H.TIPO, '#39#39')) = '#39'NF'#39') AND (TRIM(COALESC' +
        'E(H.NATUREZA, '#39#39')) = '#39'E'#39')'
      'AND (COALESCE(H.NUMDOC, 0) = 0)) THEN'
      ' CASE WHEN (TRIM(COALESCE(F.NOME_FANTASIA, '#39#39')) = '#39#39') THEN'
      '   TRIM(F.NOME)'
      ' ELSE'
      '   TRIM(F.NOME_FANTASIA)'
      ' END'
      'ELSE'
      '  TRIM(CL.NOME_CLIENTE)'
      'END CLIENTE,'
      'TRIM(INTER.RAZAO) INTERMEDIADOR,'
      
        ' TRIM(CON.RAZAO) CONCESSIONARIA, TRIM(CLV.RAZAO) CLIENTE_VENDEDO' +
        'R, COL.NOME_VENDEDOR VENDEDOR,'
      ' GER.NOME_VENDEDOR GERENTE,'
      'SUBSTRING(TRIM(N.DESCRICAO_NOP) FROM 1 FOR 40) DESC_NATOP,'
      'COND.DESC_COND_PAG COND_PAG, H.* FROM HIST_ESTMOTO H'
      
        'LEFT JOIN CLIENTES CL ON CL.COD_CLIENTE = H.COD_CLIENTE AND CL.C' +
        'OD_EMPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN FORNECEDOR F ON F.CODIGO_F = H.COD_CLIENTE AND F.COD_E' +
        'MPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES INTER ON INTER.COD_CLIENTE = H.COD_INTERMED A' +
        'ND INTER.COD_EMPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES CON ON CON.COD_CLIENTE = H.COD_CONCESS AND CO' +
        'N.COD_EMPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN CLIENTES CLV ON CLV.COD_CLIENTE = H.COD_CLI_VENDE AND ' +
        'CLV.COD_EMPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = H.COD_VENDEDOR A' +
        'ND COL.COD_EMPRESA = H.COD_EMPRESA'
      
        'LEFT JOIN COLABORADOR GER ON GER.COD_VENDEDOR = H.COD_GERENTE AN' +
        'D GER.COD_EMPRESA = H.COD_EMPRESA'
      'LEFT JOIN COND_PAG COND ON COND.COD_COND_PAG = H.COD_COND_PAG'
      'LEFT JOIN NAT_OP N ON N.CODIGO_NOP = H.NATOP_V')
    Left = 506
    Top = 1665
  end
  object dsHistCTRSEstMotos: TDataSource
    DataSet = cdsHistCTRSEstMotos
    Left = 506
    Top = 1814
  end
  object dspHistCTRSEstMotos: TDataSetProvider
    DataSet = qrHistCTRSEstMotos
