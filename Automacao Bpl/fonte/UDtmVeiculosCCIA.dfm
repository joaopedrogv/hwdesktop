  object qrDespesas: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      
        'SELECT DESPESAS_VEIC.* , CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, ' +
        'TIPO_DESPESA.DESCRICAO AS DESCRICAO_DESP FROM DESPESAS_VEIC'
      
        'INNER JOIN TIPO_DESPESA ON DESPESAS_VEIC.COD_TP_DESPESA = TIPO_D' +
        'ESPESA.COD_TP_DESPESA'
      
        'LEFT JOIN CLIENTES ON DESPESAS_VEIC.COD_CLIENTE = CLIENTES.COD_C' +
        'LIENTE AND DESPESAS_VEIC.COD_EMPRESA = CLIENTES.COD_EMPRESA'
      'WHERE DESPESAS_VEIC.COD_EMPRESA = -1'
      ''
      '')
    Left = 657
    Top = 309
  end
