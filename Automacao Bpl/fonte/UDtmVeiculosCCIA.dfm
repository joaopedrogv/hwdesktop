  object qrDemonstracao: TIBQuery
    Database = dtmAtivo.bancoHw
    Transaction = IBTransVeiculos
    SQL.Strings = (
      'select vn.chassiv,vn.data_ven,vn.clientes_v, '
      
        'vn.num_nota_v,vn.nome_receb,tpm.codigo,tpm.cilindrada,vn.situaca' +
        'o,est.preco_tabest,tpm.descricao,(vn.data_ven+60) as data_venc'
      'from com_fat vn,tipmodelo tpm,'
      
        'est_moto est where (vn.natop_v = :vcod or vn.natop_v = :vcod1 or' +
        ' vn.natop_v = :vcod2 or vn.natop_v = :vcod3 ) and vn.chassiv = e' +
        'st.chassi_c and'
      
        'est.versaoest = tpm.codigo and vn.cod_empresa = tpm.cod_empresa ' +
        'and vn.cod_empresa = est.cod_empresa'
      
        'and vn.cod_empresa = :cod_empresa and vn.ativo = 1 and vn.situac' +
        'ao is null'
      'order by tpm.ordtipo,tpm.descricao,tpm.codigo,vn.data_ven'
      ''
      '')
    Left = 650
    Top = 750
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'vcod'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'vcod1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'vcod2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'vcod3'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'COD_EMPRESA'
        ParamType = ptUnknown
      end>
  end
