function TCores.post: boolean;
var
  acao: string;
  mensagem: string;
  codigo: integer;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if (dataSet.FieldByName('US_CAD').AsInteger > 0) and (dataSet.FieldByName('US_EDIT').AsInteger <= 0) then
      mensagem := 'US CAD: ' + IntToStr(dataSet.FieldByName('US_CAD').AsInteger)
    else if (dataSet.FieldByName('US_CAD').AsInteger <= 0) and (dataSet.FieldByName('US_EDIT').AsInteger > 0) then
      mensagem := 'US ALT: ' + IntToStr(dataSet.FieldByName('US_EDIT').AsInteger)
    else
      mensagem := 'US CAD: ' + IntToStr(dataSet.FieldByName('US_CAD').AsInteger) +
      	' US ALT: ' + IntToStr(dataSet.FieldByName('US_EDIT').AsInteger);

    if not vDadosIni.PesqPros('BAS114', 'SALVAR', mensagem,
     'CODIGO_CORFAB', dataSet.FieldByName('COD_COR').AsString, buscas, true) then
      Exit;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.FieldByName('COD_COR').AsInteger <= 0 then
      raiseExceptionCreate('Código da cor não informado!', 'DBEdit_Codigo');

    if (acao = 'INSERIR') then
      if ExecutaComandosSql('select cod_cor from codigo_corfab where cod_cor = ' + IntToStr(dataSet.FieldByName('COD_COR').AsInteger)) then
          raiseExceptionCreate('Já existe uma cor cadastrada com este código!', 'DBEdit_Codigo');

    if dataSet.FieldByName('CODCORDENATRAM').AsInteger <= 0 then
      raiseExceptionCreate('Código da cor do DENATRAM  não informado!', 'DBEdit_CodigoDENATRAM');

    if trim(dataSet.FieldByName('DESCRICAO_COR').AsString) = '' then
      raiseExceptionCreate('Descrição da cor não informado!', 'DBEdit_Descricao');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('DESCRICAO_COR').OldValue <> dataSet.FieldByName('DESCRICAO_COR').NewValue))) then
      if ExecutaComandosSql('select cod_cor from codigo_corfab where descricao_cor = ' +
        quotedstr(dataSet.FieldByName('DESCRICAO_COR').AsString)) then
        raiseExceptionCreate('Já existe uma cor cadastrada com esta descrição!', 'DBEdit_Descricao');

    if trim(dataSet.FieldByName('TIPO_PINTURA').AsString) = '' then
      raiseExceptionCreate('Tipo de Pintura da cor não informado!', 'DBComboBox_TipoPintura');

//    if acao = 'INSERIR' then
//    begin
//      _VerificarCodigoAutoIncremento('INC_CODIGO_CORFAB', 'COD_COR', 'CODIGO_CORFAB');
//      vDadosIni.vPesquisa := dataSet.FieldByName('COD_COR').AsString;
//    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS114', acao, 'SUCESSO', 'CODIGO_CORFAB',
        dataSet.FieldByName('COD_COR').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS114', acao, 'FALHA', 'CODIGO_CORFAB',
        dataSet.FieldByName('COD_COR').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
        // dataSet.FieldByName('COD_COR').AsVariant := null;
      end;
    end;
  end;

end;

