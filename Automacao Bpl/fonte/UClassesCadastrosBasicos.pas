      tempTipo := '= ';

    if (rSugServico.vCampo = 'Ano Fab') or (rSugServico.vCampo = 'Ano Mod') then
    begin
      if tempTipo = 'like' then
        tempSql := 'VEICULOS.ANOFAB ' + tempTipo + QuotedStr('%' + rSugServico.vValor + '%')
      else if tempTipo = 'Começa' then
        tempSql := 'VEICULOS.ANOFAB ' + 'like' + QuotedStr(rSugServico.vValor + '%')
