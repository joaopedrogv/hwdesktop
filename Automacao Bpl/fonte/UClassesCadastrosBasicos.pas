function TContador.post: boolean;
begin
  result := false;
  try
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataset.FieldByName('CPFCNPJ_CONT').AsString) = '' then
      raise exception.Create('Campo CPF/CNPJ não informado.');

    if trim(dataset.FieldByName('NOME_CONT').AsString) = '' then
      raise exception.Create('Campo nome não informado.');

    if not cpf(dataset.FieldByName('CPFCNPJ_CONT').AsString) and not
      cgc(dataset.FieldByName('CPFCNPJ_CONT').AsString) then
      raise exception.Create('CPF/CNPJ Invalido.');

    if Trim(dataset.FieldByName('CNPJ_ESCRITORIO').AsString) <> '' then
      if not cgc(dataset.FieldByName('CNPJ_ESCRITORIO').AsString) then
        raise exception.Create('CNPJ Escritório Invalido.');

    if dataSet.FieldByName('COD_CIDADE').AsString <> '' then
      dataSet.FieldByName('CIDADE_CONT').AsString :=
        vCidade.buscas.FieldByName('nome_cidade').AsString
    else
      raise exception.Create('Cidade do Contador não informada');

    if dataSet.FieldByName('COD_BAIRRO').AsString <> '' then
      dataSet.FieldByName('BAIRRO_CONT').AsString :=
        vBairro.buscas.FieldByName('nome_bairro').AsString
    else
      raise exception.Create('Bairro do Contador não informado');

    if dataSet.FieldByName('CODIGO_UF').asinteger = 0 then
      raise exception.Create('Estado do Contador não informado');

    if dataSet.State = dsInsert then
    begin
      dataSet.FieldByName('COD_CONTADOR').AsInteger := Gencodigo('CONTADOR',
        DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_CONTADOR').AsString;
    end;

    result := inherited post;

    if dataset.ChangeCount = 0 then
    begin
      result := true;
      exit;
    end;

    if apply then
      CommitaTransacao
    else
    begin
      Cancel;
      RollBackTransacao;
      Result := false;
    end;
    Refresh;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

