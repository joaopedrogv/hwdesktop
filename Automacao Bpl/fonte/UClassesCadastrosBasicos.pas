function TBairros.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if trim(dataSet.FieldByName('NOME_BAIRRO').AsString) = '' then
      raiseExceptionCreate('Descrição do bairro não informada', 'DBEdit2')
    else
    begin
      if acao = 'EDITAR' then
      begin
        if trim(dataSet.FieldByName('NOME_BAIRRO').OldValue) <>
          trim(dataSet.FieldByName('NOME_BAIRRO').NewValue) then
          if ExecutaComandosSql('select NOME_BAIRRO from BAIRROS where NOME_BAIRRO = ' +
            quotedstr(dataSet.FieldByName('NOME_BAIRRO').AsString)) then
            	raiseExceptionCreate('Já existe um bairro cadastrado com este nome!', 'DBEdit2');
      end
      else if ExecutaComandosSql('select NOME_BAIRRO from BAIRROS where NOME_BAIRRO = ' +
        quotedstr(dataSet.FieldByName('NOME_BAIRRO').AsString)) then
        	raiseExceptionCreate('Já existe um bairro cadastrado com este nome!', 'DBEdit2');
    end;
    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_BAIRRO,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('COD_BAIRRO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      if Pos('CADBAIRRO|0|', vDadosIni.vPesquisa) > 0 then
        vDadosIni.vPesquisa := 'CADBAIRRO|' + dataSet.FieldByName('COD_BAIRRO').AsString + '|' + dataSet.FieldByName('NOME_BAIRRO').AsString + '|'
      else
        vDadosIni.vPesquisa := dataSet.FieldByName('COD_BAIRRO').AsString;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS051', acao, 'SUCESSO', 'BAIRROS',
        dataSet.FieldByName('COD_BAIRRO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS051', acao, 'FALHA', 'BAIRROS',
        dataSet.FieldByName('COD_BAIRRO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código do bairro duplicado.' + chr(13) +
          'O código do bairro será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        dataSet.FieldByName('COD_BAIRRO').AsVariant := null;
      end;
    end;
  end;
end;

