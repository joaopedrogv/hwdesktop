    vProcesso := 'BAS289';
    if vSing.vTipoContrato = 'MOT' then
      vProcesso := 'BAS179'
    else if vSing.vTipoContrato = 'NOT' then
    	vProcesso := 'BAS421'
    else if vSing.vTipoContrato = 'DOC' then
    	vProcesso := 'BAS555';
  end
  else
  begin
  	vProcesso := 'BAS288';
    if vSing.vTipoContrato = 'MOT' then
	    vProcesso := 'BAS180'
    else if vSing.vTipoContrato = 'NOT' then
    	vProcesso := 'BAS422'
    else if vSing.vTipoContrato = 'DOC' then
    	vProcesso := 'BAS556';
  end;
    
  if dataSet.IsEmpty then
    exit;
  codcarta := dataSet.FieldByName('COD_CARTA').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 0 then
  begin
    if not vDadosIni.PesqPros(vProcesso, 'EXCLUIR', '', 'MODCARTAS', dataset.FieldByName('COD_CARTA').AsString, buscas, true) then
        exit;

    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
    begin
    	SqlExec(' delete from modcartas ' +
              ' where cod_carta = %d and cod_empresa = %d ',
              [fint('cod_carta'), vDadosIni.cod_empresa], buscas);

      CommitaTransacao;
      vDadosIni.GravaAuditoria(vProcesso, 'EXCLUIR', 'SUCESSO', 'MODCARTAS', codcarta, buscas);
    end;
  end
  else
  begin
    if not vDadosIni.PesqPros(vProcesso, 'ENVIANDO PARA LIXEIRA', '', 'MODCARTAS', dataset.FieldByName('COD_CARTA').AsString, buscas, true) then
        exit;

    if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      if inherited Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 0;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria(vProcesso, 'EXCLUIR', 'SUCESSO', 'MODCARTAS', codcarta, buscas)
        else
          vDadosIni.GravaAuditoria(vProcesso, 'EXCLUIR', 'FALHA', 'MODCARTAS', codcarta, buscas)
        end;
      end;
    end;
  Refresh;
end;

