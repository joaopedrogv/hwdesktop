function TComissaoFaixaDescPerc.post(pDataset: TDataSet): boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS475', 'SALVAR', '', 'COMISSAO_FAIXA_DESCONTO_PERC',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataSet.FieldByName('PERC_DESC_INI').IsNull then
    	raiseExceptionCreate('Campo "Desconto de" deve ser informado', 'DBEdit6');

    if dataSet.FieldByName('PERC_DESC_FIM').IsNull then
    	raiseExceptionCreate('Campo "Desconto até" deve ser informado', 'DBEdit7');

    if dataSet.FieldByName('PERC_DESC_INI').AsFloat > dataSet.FieldByName('PERC_DESC_FIM').AsFloat then
    	raiseExceptionCreate('Desconto inicial não deve ser maior que o desconto final', 'DBEdit6');

    if dataSet.FieldByName('PERC_COMISSAO').AsFloat <= 0 then
    	raiseExceptionCreate('Percentual de comissão deve ser informado', 'DBEdit8');

    buscas.Close;
    buscas.SQL.Text := 'select codigo from comissao_faixa_desconto_perc ' +
    	' where cod_perc <> ' + IntToStr(dataSet.FieldByName('cod_perc').AsInteger) +
      ' and cod_vig = ' + IntToStr(dataSet.FieldByName('cod_vig').AsInteger) +
      ' and codigo = ' + IntToStr(dataSet.FieldByName('codigo').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and :valor >= perc_desc_ini ' +
      ' and :valor <= perc_desc_fim ';
    buscas.ParamByName('valor').AsFloat := dataSet.FieldByName('perc_desc_ini').AsFloat;
    buscas.Open;
    if not buscas.IsEmpty then
      raiseExceptionCreate('Já existe o cadastro no intervalo de desconto informado', 'DBEdit6');

    buscas.Close;
    buscas.SQL.Text := 'select codigo from comissao_faixa_desconto_perc ' +
    	' where cod_perc <> ' + IntToStr(dataSet.FieldByName('cod_perc').AsInteger) +
      ' and cod_vig = ' + IntToStr(dataSet.FieldByName('cod_vig').AsInteger) +
      ' and codigo = ' + IntToStr(dataSet.FieldByName('codigo').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and :valor >= perc_desc_ini ' +
      ' and :valor <= perc_desc_fim ';
    buscas.ParamByName('valor').AsFloat := dataSet.FieldByName('perc_desc_fim').AsFloat;
    buscas.Open;
    if not buscas.IsEmpty then
      raiseExceptionCreate('Já existe o cadastro no intervalo de desconto informado', 'DBEdit7');

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('COD_PERC').AsInteger :=
        Gencodigo('COMISSAO_FAIXA_DESCONTO_PERC', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
    end;
    
    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS475', acao, 'SUCESSO', 'COMISSAO_FAIXA_DESCONTO_PERC',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS475', acao, 'FALHA', 'COMISSAO_FAIXA_DESCONTO_PERC',
        dataSet.FieldByName('CODIGO').AsString, buscas);

    if Result then
      _abreComissaoFaixaDescPerc(
		  	pDataSet.FieldByName('CODIGO').AsInteger,
    		pDataSet.FieldByName('COD_VIG').AsInteger);

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

