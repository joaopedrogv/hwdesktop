function TSenha.post: boolean;
var
	acao: string;
  vUsuario: string;
begin
  result := false;
  try
    if not (dataset.State in [dsEdit, dsInsert]) then
    begin
      Result := true;
      exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    vUsuario         := trim(dataset.FieldByName('USUARIO').AsString);

    if dataset.FieldByName('CODIGO').AsString = '' then
      raise Exception.Create('Campo Nome do funcionário não informado.');

    if trim(dataset.FieldByName('USUARIO').AsString) = '' then
      raise Exception.Create('Campo usuário não informado.');

    if dataSet.FieldByName('CONTRA_SENHA').AsString = '' then
      raise Exception.Create('Campo confirmar senha não informado.');

    if dataSet.FieldByName('SENHA').AsString = '' then
      raise Exception.Create('Campo senha não informado.');

    if trim(dataSet.FieldByName('SENHA').AsString) <>
      trim(dataSet.FieldByName('CONTRA_SENHA').AsString) then
      raise Exception.Create('Confirmação da senha incorreta.');

    if dataSet.FieldByName('NIVEL_US').AsString = '' then
      raise Exception.Create('Campo Nível do Usuário não informado.');

    if Trim(dataSet.FieldByName('ESTOQ_NEG').AsString) = '' then
      dataSet.FieldByName('ESTOQ_NEG').AsString := 'N';
    if Trim(dataSet.FieldByName('IMP_US').AsString) = '' then
      dataSet.FieldByName('IMP_US').AsString := 'Epson';
    if Trim(dataSet.FieldByName('ALT_CAB').AsString) = '' then
      dataSet.FieldByName('ALT_CAB').AsString := 'N';
    if Trim(dataSet.FieldByName('ALT_IMP').AsString) = '' then
      dataSet.FieldByName('ALT_IMP').AsString := 'N';

    dataSet.FieldByName('SENHA').AsString :=
      vDadosIni.codifica(trim(dataSet.FieldByName('SENHA').AsString));
    dataSet.FieldByName('CONTRA_SENHA').AsString :=
      vDadosIni.codifica(trim(dataSet.FieldByName('CONTRA_SENHA').AsString));

    result := inherited post;

    if (apply) or (vSenhas_erp.dataSet.ChangeCount > 0) then
    begin
      if (dataSet.FieldByName('emp_padrao').AsInteger = StrToInt(vDadosIni.codEmpresa)) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'update senhas set senha = ' + QuotedStr(trim(dataSet.FieldByName('SENHA').AsString)) +
          ', contra_senha = ' + QuotedStr(trim(dataSet.FieldByName('SENHA').AsString)) +
          ' where usuario = ' + QuotedStr(trim(dataSet.FieldByName('usuario').AsString)) +
          ' and cod_empresa <> ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
      end;

      vSenhas_erp.Apply;
      CommitaTransacao;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
    end;

    // Atualizar nivel e estoque negativo
    if (trim(acao) = 'EDITAR') and (trim(vUsuario) = trim(vDadosIni.vNomeUsuario)) then
    begin
    	SqlOpen(' select col.nome_vendedor, s.codigo, s.depart, f.desc_funcao, ' +
        ' s.usuario, s.senha, s.cod_empresa, s.nivel_us, ' +
        ' s.ALT_IMP, s.IMP_US, s.estoq_neg, e.nome_emp, e.CGC_EMP, s.EXIBIR_MENSAGEM_CONSORCIO, col.email' +
        ' from SENHAS S ' +
        ' inner join empresa e on e.cod_empresa = s.cod_empresa ' +
        ' inner join colaborador col on col.cod_vendedor = s.codigo and col.cod_empresa = s.cod_empresa ' +
        ' left join funcoes f on f.cod_funcao = col.cod_funcao ' +
        ' where S.USUARIO = ' + QuotedStr(trim(vUsuario)) +
        ' and S.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and S.ativo = 1 ', buscas);

    	vDadosIni.vCodUsuario := buscas.FieldByName('CODIGO').AsInteger;
      vDadosIni.vNivel := buscas.FieldByName('NIVEL_US').AsInteger;
      vDadosIni.vNomeUsuario := trim(buscas.FieldByName('USUARIO').AsString);
      vDadosIni.vDpto := trim(buscas.FieldByName('depart').AsString);
    //  vDadosIni.vSenhaUsuario := trim(buscas.FieldByName('senha').AsString);
      vDadosIni.vAltImp := trim(buscas.FieldByName('alt_imp').AsString);
      vDadosIni.vImp_Us := trim(buscas.FieldByName('Imp_us').AsString);
      vDadosIni.vEstoqueNegativo := trim(buscas.FieldByName('estoq_neg').AsString);
      vDadosIni.vMensagemConsorcio := trim(buscas.FieldByName('exibir_mensagem_consorcio').AsString);
      vDadosIni.EmailColab := trim(buscas.FieldByName('email').AsString);
    end;

  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
  //  Refresh
end;

function TSenha.restaurarLixeira: boolean;
var
	vUsuario: string;
	vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vUsuario  := trim(dataSet.FieldByName('USUARIO').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vUsuario  := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vUsuario) <> '') then
      	prepare_loop('USUARIO = ' + QuotedStr(vUsuario))
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'SENHA' + #13 +
        'Usuario: ' + vUsuario;

      if (trim(vUsuario) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('CFG030', 'RESTAURAR', '', 'SENHAS',
        vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando senha(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando senha(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update senhas set ativo = 1 ' +
          ' where usuario = %s and cod_empresa = %d ',
          [fstrq('usuario'), fint('cod_empresa')], buscas);

        if (trim(vUsuario) = '') then
          vDadosIni.GravaAuditoria('CFG030', 'RESTAURAR', '', 'SENHAS',
            dataSet.FieldByName('USUARIO').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('CFG030', 'RESTAURAR', 'SUCESSO', 'SENHAS',
        vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('CFG030', 'RESTAURAR', 'FALHA', 'SENHAS',
        vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

