function TImpressoras_CNIEE.abreImpressoras: boolean;
begin
  Result := montaSelect('Select * from Impressoras_CNIEE where Ativo = 1');
end;

function TImpressoras_CNIEE.abreLixeira: boolean;
begin
  if not statusLixeira then
  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    Result := False;
  end
  else
    Result := montaSelect('Select * from Impressoras_CNIEE where Ativo <> 1');
end;

procedure TImpressoras_CNIEE.CadImpressoras(TipoForm: integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Impressoras');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := TipoForm;

    if not vDadosIni.PesqPros('BAS296', 'CONSULTA', '', 'Impressoras_CNIEE', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
    if frmCadImpressoras = nil then
      Application.CreateForm(TfrmCadImpressoras, frmCadImpressoras);
    if TipoForm = 1 then
    begin
      frmCadImpressoras.FormStyle := fsNormal;
      frmCadImpressoras.Visible := false;
      frmCadImpressoras.Refresh;
      frmCadImpressoras.Position := poScreenCenter;
      frmCadImpressoras.ShowModal;
    end
    else
      frmCadImpressoras.Show;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

constructor TImpressoras_CNIEE.create;
begin
  dataSet := TClientDataSet(DtmCadBasicos.cdsImpressoras);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
end;

function TImpressoras_CNIEE.delete: boolean;
var
  vCodFormula: string;
begin
  vCodFormula := dataSet.FieldByName('IDENTIFICACAO').AsString;

  if dataSet.IsEmpty then
    exit;

  if dataSet.FieldByName('Ativo').asInteger = 0 then
  begin
    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
      exit;

    result := inherited Delete;
    if Result then
      result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS301', 'EXCLUIR', 'SUCESSO', 'Impressoras_CNIEE', vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS301', 'EXCLUIR', 'FALHA', 'Impressoras_CNIEE', vCodFormula, buscas);

    Result := true;
    Refresh;

    exit;
  end;

  if not vDadosIni.PesqPros('BAS300', 'EXCLUIR', '', 'Impressoras_CNIEE',
    dataSet.FieldByName('IDENTIFICACAO').AsString, buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    exit;

  dataSet.Edit;
  dataSet.FieldByName('ATIVO').AsInteger := 0;
  dataSet.Post;

  result := Apply;
  if result then
    result := CommitaTransacao;
  if Result then
    vDadosIni.GravaAuditoria('BAS300', 'EXCLUIR', 'SUCESSO', 'Impressoras_CNIEE', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS300', 'EXCLUIR', 'FALHA', 'Impressoras_CNIEE', vCodFormula, buscas);

  Result := true;
  Refresh;

end;

function TImpressoras_CNIEE.edit: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('BAS299', 'ALTERAR', '', 'Impressoras_CNIEE',
    '', buscas, True) then
    Exit;



  if dataSet.IsEmpty then
    Exit;
  result := inherited edit;
end;

function TImpressoras_CNIEE.insert: boolean;
begin
  if not vDadosIni.PesqPros('BAS298', 'INCLUIR', '', 'Impressoras_CNIEE',
    '', buscas, True) then
    Exit;

  if not dataSet.Active then
    montaSelect('Select * from Impressoras_CNIEE where 1 = 0');
  result := inherited insert;
end;

function TImpressoras_CNIEE.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS302', 'SALVAR', '', 'Impressoras_CNIEE',
      dataSet.FieldByName('IDENTIFICACAO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';


    if trim(dataSet.FieldByName('Identificacao').asString) = '' then
      raise Exception.Create('Campo Identificação não informado!');
    if trim(dataSet.FieldByName('TIPO_ECF').asString) = '' then
      raise Exception.Create('Tipo de ECF não informado!');
    if trim(dataSet.FieldByName('MARCA_ECF').asString) = '' then
      raise Exception.Create('Marca deve ser preenchida!');
    if trim(dataSet.FieldByName('MODELO_ECF').asString) = '' then
      raise Exception.Create('Modelo deve ser preenchida!');
    if trim(dataSet.FieldByName('ATO_APROVACAO').asString) = '' then
      raise Exception.Create('Ato homologatório deve ser preenchida!');

    result := inherited Post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS302', acao, 'SUCESSO', 'Impressoras_CNIEE',
        dataSet.FieldByName('IDENTIFICACAO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS302', acao, 'FALHA', 'Impressoras_CNIEE',
        dataSet.FieldByName('IDENTIFICACAO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TImpressoras_CNIEE.restauraLixeira: boolean;
begin
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('Ativo').asInteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if (Edit) or (dataSet.State = dsEdit) then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          Result := Post;
          if Result then
            Result := CommitaTransacao;

          if Result then
            vDadosIni.GravaAuditoria('BAS302', 'RESTAURAR REGISTRO', 'SUCESSO',
              'IMPRESSORAS_CNIEE', dataSet.FieldByName('IDENTIFICACAO').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS302', 'RESTAURAR REGISTRO', 'FALHA',
              'IMPRESSORAS_CNIEE', dataSet.FieldByName('IDENTIFICACAO').AsString, buscas);
        end;
      end;
    end
    else
      Application.MessageBox('Registro já está ativo' + chr(13) +
        'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION +
        MB_DEFBUTTON1);
  Refresh;
end;

