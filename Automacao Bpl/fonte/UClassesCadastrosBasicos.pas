procedure TComissaoFaixaDesc._cadComissaoFaixaDesc(pTipoForm: Integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Comissão Por Faixa de Desconto');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS458', 'CONSULTA', '', 'COMISSAO_FAIXA_DESCONTO', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadComissaoFaixaDesconto = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadComissaoFaixaDesconto, frmCadComissaoFaixaDesconto);
    end;

    if (pTipoForm > 0) and (not frmCadComissaoFaixaDesconto.Visible) then
      frmCadComissaoFaixaDesconto.ShowModal
    else if (not frmCadComissaoFaixaDesconto.Visible) then
      frmCadComissaoFaixaDesconto.Show
    else if frmCadComissaoFaixaDesconto.FormStyle = fsMDIChild then
      frmCadComissaoFaixaDesconto.Show
    else
      frmCadComissaoFaixaDesconto.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

