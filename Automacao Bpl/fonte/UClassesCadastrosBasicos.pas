function TCadPerfilHorasTrabalho.insert: boolean;
begin
	if not vDadosIni.PesqPros('BAS534', 'INCLUIR', '', 'PERFIL_HORAS_TRABALHO',
    '', buscas, True) then
	    Exit;

	if not dataset.Active then
    montaSelect('Select * from perfil_horas_trabalho where 1 = 0');

  if inherited insert then
  begin
    result := true;
    dataset.FieldByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataset.FieldByName('DATA_MOD').AsDateTime := dataset.FieldByName('DATA_CAD').AsDateTime;
    dataset.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    dataset.FieldByName('ATIVO').AsInteger := 1;

    vCadPerfilHorasTrabalhoDia.abrePerfilHorasTrabalhoDia(0);
  end;
end;

procedure TCadPerfilHorasTrabalho.obterDiaSemana(
	pDiaSemana: Integer;
  ckDiaSemana: TCheckBox;
  mkHoraIni: TMaskEdit;
  mkHoraFim: TMaskEdit;
  spButton: TSpeedButton);
begin
	ckDiaSemana.Checked := False;

  mkHoraIni.Clear;
  mkHoraIni.Enabled   := False;

  mkHoraFim.Clear;
  mkHoraFim.Enabled   := False;

  spButton.Enabled    := False;

  if dataSet.FieldByName('CODIGO').AsInteger <= 0 then
  	Exit;

  buscas.Close;
  buscas.SQL.Text := ' select * from perfil_horas_trabalho_dia ' +
  	' where codigo = :codigo ' +
    ' and cod_empresa = :cod_empresa ' +
    ' and dia_semana = :dia_semana ';
  buscas.ParamByName('codigo').AsInteger := dataSet.FieldByName('CODIGO').AsInteger;
  buscas.ParamByName('cod_empresa').AsInteger := dataSet.FieldByName('cod_empresa').AsInteger;
  buscas.ParamByName('dia_semana').AsInteger := pDiaSemana;
  buscas.Open;

  if buscas.IsEmpty then
  	Exit;

  ckDiaSemana.Checked := True;

  mkHoraIni.Text      := buscas.FieldByName('HORA_INI').AsString + ':' + buscas.FieldByName('MINUTO_INI').AsString;
  mkHoraIni.Enabled   := True;

  mkHoraFim.Text      := buscas.FieldByName('HORA_FIM').AsString + ':' + buscas.FieldByName('MINUTO_FIM').AsString;
	mkHoraFim.Enabled   := True;

  spButton.Enabled    := True;
end;

