procedure TEstados.renconciliaErro(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  try
    if (Pos('FK_CFOP_MUD_ESTADOS_C_ESTADOS', UpperCase(e.Message)) <> 0) then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''CFOP_MUD''', 'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_CLIENTES_ESTADOS_C_ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''CLIENTES''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_COLABORA_ESTADOS_C_ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''COLABORADOR''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_FORNECED_RELATION__ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''FORNECEDOR''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_EMPDESVOLV_ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''EMPDESVOLV''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_CONTADOR_ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''CONTADOR''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_NBM_ESTADOS_ESTADOS', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar estado' + chr(13) +
        'Estado sendo utilizado em outra tabela! ''NBM_ESTADO''',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
  finally
    RollBackTransacao;
    Self.DataSet.CancelUpdates;
  end;
end;

