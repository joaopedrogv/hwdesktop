    AMaskData1 := TMaskEdit.Create(APanelAllClient); AMaskData1.Parent := APanelAllClient; AMaskData1.Width := 77; AMaskData1.Top := 13; AMaskData1.Left := 115; AMaskData1.EditMask := '!99/99/0000;1;_';
    AMaskData2 := TMaskEdit.Create(APanelAllClient); AMaskData2.Parent := APanelAllClient; AMaskData2.Width := 77; AMaskData2.Top := 40; AMaskData2.Left := 115; AMaskData2.EditMask := '!99/99/0000;1;_';
    ABotaoOK := TBitBtn.Create(APanelAllClient); ABotaoOK.Parent := APanelAllClient; ABotaoOK.Caption := '&Confirmar'; ABotaoOK.Top := 24; ABotaoOK.Left := 231 - 7 - 7; ABotaoOK.ModalResult := mrOk;
    APanelBottom := TPanel.Create(APanelAllClient); APanelBottom.Parent := APanelAllClient; APanelBottom.Align := alBottom; APanelBottom.Caption := ''; APanelBottom.BevelOuter := bvNone; APanelBottom.BevelKind := bkTile; APanelBottom.BorderWidth := 7; APanelBottom.Caption := '';
    ABotaoNO := TBitBtn.Create(APanelBottom); ABotaoNO.Parent := APanelBottom; ABotaoNO.Caption := '&Sair'; ABotaoNO.Align := alRight; ABotaoNO.ModalResult := mrCancel;

    try
      while True do
      begin
        AMaskData1.Text := FormatDateTime('dd/mm/yyyy', ADT1);
        AMaskData2.Text := FormatDateTime('dd/mm/yyyy', ADT2);

        AModalResult := AForm.ShowModal;

        if AModalResult = mrOk then
        begin
          if not TryStrToDate(AMaskData1.Text, ADT1) then
            vDadosIni.ShowErro('Data da 1º parcela inválida')
          else if not TryStrToDate(AMaskData2.Text, ADT2) then
            vDadosIni.ShowErro('Data da 2º parcela inválida')
          else if ADT2 < ADT1 then
            vDadosIni.ShowErro('Data da 2º parcela menor que a 1º')
          else if ADT1 < ADTAtual then
            vDadosIni.ShowErro('Data da 1º parcela menor que a data atual')
          else
          begin
            APrimeira := ADT1;
            ASegunda  := ADT2;
            informarDiaPrimeiraESegundaParcela := True;
            Break;
          end;
        end
        else if AModalResult = mrCancel then
          Break;
      end;
    finally
      FreeAndNil(ABotaoOK);
      FreeAndNil(AMaskData2);
      FreeAndNil(AMaskData1);
      FreeAndNil(ALabelData2);
      FreeAndNil(ALabelData1);
      FreeAndNil(APanelBottom);
      FreeAndNil(APanelAllClient);
      FreeAndNil(AForm);
    end;
  end;

const
  Cnumber = ['0'..'9'];
var
  AQuery: TIBQuery;
  AParcelas: RParcelamentos;
  AQtde: Integer;
  I, ADiaFixo, ADiaDo, J: Integer;
  AStr: string;
  AUsarDiaBaseControle, AAlterarDataBase: Boolean;
  ADiaAtual, ADiaPrimeiroVencimento: TDate;
  ADataTmp: TDateTime;
  AValParcela, AValParcelaComDif: Currency;
  AFeriado: TFeriado;
  AParcelasAdicionais: Smallint;
begin
  SetLength(AParcelas, 0);
  AQuery := TIBQuery.Create(buscas.Owner);
  AQuery.Database := buscas.Database;
  AQuery.Transaction := buscas.Transaction;
  try
    // definindo modalidade e condicao de pagamento
    if ACodCP > 0 then
    begin
      AQuery.Close;
      AQuery.SQL.Text := 'select desc_cond_pag, modalidade, considerar_dia_util, parcelas_adicionais' +
        ' from COND_PAG' +
        ' where cod_cond_pag = ' + IntToStr(ACodCP) +
        ' and ativo = 1';
      AQuery.Open;
      if not AQuery.IsEmpty then
      begin
        ADescrCP               := Trim(AQuery.FieldByName('desc_cond_pag').AsString);
        AModalidade            := Trim(AQuery.FieldByName('modalidade').AsString);
        ACondiderarDiaUtil     := Trim(AQuery.FieldByName('considerar_dia_util').AsString);
        AMaxParcelasAdicionais :=      AQuery.FieldByName('parcelas_adicionais').AsInteger;
      end;
    end;
    //---

    if ACodCtrl > 0 then
    begin
      AQuery.Close;
      AQuery.SQL.Text := 'select tipo_parcelamento, dia_base_parcelamento from controles' +
        ' where codigo_emp = ' + vDadosIni.codEmpresa +
        ' and codigo_ctrl = ' + IntToStr(ACodCtrl);
      AQuery.Open;
      if not AQuery.IsEmpty then
      begin
        ATipoParcelamento := Trim(AQuery.FieldByName('tipo_parcelamento').AsString);
        ADiaBase          := Trim(AQuery.FieldByName('dia_base_parcelamento').AsString);
      end;
    end;

    // testes de descricao
    if UpperCase(Trim(ADescrCP)) = 'NENHUMA' then
    begin
      if not Asilent then
        vDadosIni.ShowAtencao('Nenhuma condição de pagamento informada!');
      Exit;
    end;
    if UpperCase(Trim(ADescrCP)) = 'A VISTA' then
    begin
      if not Asilent then
        vDadosIni.ShowAtencao('Condição A Vista!');
      Exit;
    end;
    //---

    AUsarDiaBaseControle := vDadosIni.strIn(ADiaBase, ['D1', 'D2', 'D3', 'D4', 'D5']);
    if ADiaSimulacao > 0 then
      ADiaAtual := ADiaSimulacao
    else
      ADiaAtual := vDadosIni.getDataBanco(AQuery);

    if Asilent and (AdefaultDaySilentMode = 0) then
      AdefaultDaySilentMode := DayOf(ADiaAtual);

    if AUsarDiaBaseControle then
      AUsarDiaBaseControle := (Pos('X', UpperCase(ADescrCP)) > 0) and //3x, 4x
        (StrToIntDef(Trim(copy(ADescrCP, 1, Pos('X', UpperCase(ADescrCP)) - 1)), -1) > 0);

    AParcelasAdicionais := 0;
    AAlterarDataBase := vDadosIni.getConfSisBool('cond_pag_alterar_data_base', AQuery);
    if (not Asilent) and (AMaxParcelasAdicionais > 0) then
    begin
      Application.CreateForm(TfrmCondPagParcelamento, frmCondPagParcelamento);
      frmCondPagParcelamento.SpinEdit1.MinValue              := 0;
      frmCondPagParcelamento.SpinEdit1.MaxValue              := AMaxParcelasAdicionais;
      frmCondPagParcelamento.MaskEdit1.Text                  := FormatDateTime('dd/mm/yyyy', ADiaAtual);
      frmCondPagParcelamento.lbCondicao.Caption              := ADescrCP;
      frmCondPagParcelamento.lbNumDoc.Caption                := ANumDoc;
      frmCondPagParcelamento.lbValor.Caption                 := Format('%m',[ AValor ]);
      frmCondPagParcelamento.lbModalidade.Caption            := AModalidade;
      frmCondPagParcelamento.groupDataBase.Visible           := AAlterarDataBase;
      frmCondPagParcelamento.groupParcelasAdicionais.Visible := AMaxParcelasAdicionais > 0;
      frmCondPagParcelamento.Query                           := AQuery;

      if frmCondPagParcelamento.ShowModal <> mrOk then
      begin
        vDadosIni.ShowAtencao('Cancelado pelo usuário!');
        Exit;
      end;

      if AMaxParcelasAdicionais > 0 then
        AParcelasAdicionais := frmCondPagParcelamento.SpinEdit1.Value;
      if AAlterarDataBase then
        ADiaAtual           := StrToDate(frmCondPagParcelamento.MaskEdit1.Text);

      FreeAndNil(frmCondPagParcelamento);
    end;

    // Calculo do primeiro dia de vendimento
    ADiaBase := Trim(ADiaBase);
    if AUsarDiaBaseControle then
    begin
      ADiaFixo := 0;
      if (vDadosIni.strIn(ADiaBase, ['D1', 'D2', 'D4'] )) then // D1, D2 = Dia do cliente;  D4: Usuario informa
      begin
        if (vDadosIni.strIn(ADiaBase, ['D1', 'D2'] )) then // Dia de vencimento do cliente
        begin
          if ACodCliente > 0 then
          begin
            AQuery.Close;
            AQuery.SQL.Text := 'select dia_venc as valor from CLIENTES' +
              ' where cod_cliente  = ' + IntToStr(ACodCliente) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa;
            AQuery.Open;
            ADiaFixo := AQuery.FieldByName('valor').AsInteger;
          end;
        end;

        if ADiaFixo <= 0 then
        begin
          if ADiaBase = 'D1' then  // D1 quando o cliente nao tem o dia usa automaticamente o dia atual
            ADiaFixo := DayOf(ADiaAtual)
          else if Asilent then
            ADiaFixo := AdefaultDaySilentMode
          else if not InputQuery('Todo Dia', 'Dia de Vencimento:', AStr) then // no caso sobra o D2 ou D4 quando o cliente nao tem o dia no cadastro pede ao usuário para digitar o dia de vencimento
          begin
            vDadosIni.ShowErro('Operação cancelada');
            Exit;
          end
          else
          begin
            ADiaFixo := StrToIntDef(AStr, 0);
            if (ADiaFixo = 0) then  // caso o dia digitado seja inválido
            begin
              vDadosIni.ShowErro('Dia inválido');
              Exit;
            end;
          end;
        end;
      end
      else if (vDadosIni.strIn(ADiaBase, ['D3'])) then // D3 = Dia 0 do mes seguiinte
        ADiaFixo := DayOf(ADiaAtual);

      if (vDadosIni.strIn(ADiaBase, ['D1', 'D2', 'D3', 'D4'])) then //tentar dentro do mes, exceto do D3(mes seguinte sempre)
      begin
//        if ADiaBase = 'D3' then//sempre o mes seguinte
          ADiaPrimeiroVencimento := IncMonth(ADiaAtual);
//        else
//          ADiaPrimeiroVencimento := ADiaAtual;

        if not TryEncodeDate(YearOf(ADiaPrimeiroVencimento), MonthOf(ADiaPrimeiroVencimento), ADiaFixo, ADataTmp) then // tenta setar o dia de vencimento dentro do mes, se nao conseguir (dia 31, 30, 29) seta o final do mes
          ADataTmp := EndOfTheMonth(ADiaPrimeiroVencimento);

        if DateOf(ADataTmp) <= DateOf(ADiaAtual) then // testa o dia de vencimento está vencido ou é hoje, se for entao incrementa um mes
        begin
          ADataTmp := IncMonth(ADataTmp);//mes seguinte, logo abaixo atribui novamente o dia de vencimento valido para o mes
          if not TryEncodeDate(YearOf((ADataTmp)), MonthOf(ADataTmp), ADiaFixo, ADataTmp) then // tenta setar o dia de vencimento dentro do mes, se nao conseguir (dia 31, 30, 29) seta o final do mes
            ADataTmp := EndOfTheMonth(ADataTmp);
        end;

        ADiaPrimeiroVencimento := ADataTmp;
      end
      else if vDadosIni.strIn(ADiaBase, ['D5', 'D6']) then
        ADiaPrimeiroVencimento := ADiaAtual + 30;

      AQtde := StrToIntDef(Trim(copy(ADescrCP, 1, Pos('X', UpperCase(ADescrCP)) - 1)), -1) + AParcelasAdicionais;

      SetLength(AParcelas, AQtde);
      ADataTmp := ADiaPrimeiroVencimento;
      for I := Low(AParcelas) to High(AParcelas) do
      begin
        AParcelas[I].DataVencimento := ADataTmp;
        if (vDadosIni.strIn(ADiaBase, ['D1', 'D2', 'D3', 'D4'])) then //tentar dentro do mes
        begin
          ADataTmp := IncMonth(ADataTmp);
          if ADiaFixo > 0 then
            if not TryEncodeDate(YearOf((ADataTmp)), MonthOf(ADataTmp), ADiaFixo, ADataTmp) then // tenta setar o dia de vencimento dentro do mes, se nao conseguir (dia 31, 30, 29) seta o final do mes
              ADataTmp := EndOfTheMonth(ADataTmp);
        end
        else
          ADataTmp := ADataTmp + 30;
      end;
    end
    else
    begin

      if AModalidade = 'M' then //fora mes
        ADiaPrimeiroVencimento := StartOfTheMonth(IncMonth(ADiaAtual))//Primeiro dia do mes seguinte
      else if AModalidade = 'Q' then
      begin
        ADiaDo := DayOf(ADiaAtual);
        if ADiaDo <= 15 then
          ADiaPrimeiroVencimento := EncodeDate(YearOf(ADiaAtual), MonthOf(ADiaAtual), 16)
        else
          ADiaPrimeiroVencimento := StartOfTheMonth(IncMonth(ADiaAtual));
      end
      else if AModalidade = 'S' then
        ADiaPrimeiroVencimento := StartOfTheWeek(IncWeek(ADiaAtual)) - 1// Primeiro dia da semana seguinte, -1, pois retorna segunda
      else
        ADiaPrimeiroVencimento := ADiaAtual;

      // convertendo a condição em parcelas
      AQtde := -1;
      if Pos('X', UpperCase(ADescrCP)) > 0 then //3x, 4x
      begin
        AQtde := StrToIntDef(Trim(copy(ADescrCP, 1, Pos('X', UpperCase(ADescrCP)) - 1)), -1);
        if AQtde > 0 then
        begin
          AQtde := AQtde + AParcelasAdicionais;
          ADiaFixo := DayOf(ADiaPrimeiroVencimento);
          if vDadosIni.vParcelamentoDiaBase = 'S' then
            ADataTmp := IncMonth(ADiaPrimeiroVencimento)
          else
            ADataTmp := ADiaPrimeiroVencimento + 30;
          SetLength(AParcelas, AQtde);
          for I := Low(AParcelas) to High(AParcelas) do
          begin
            AParcelas[I].DataVencimento := ADataTmp;

            if vDadosIni.vParcelamentoDiaBase = 'S' then
              ADataTmp := IncMonth(ADataTmp)
            else
              ADataTmp := ADataTmp + 30;

            if Pos('[DIA FIXO]', UpperCase(ADescrCP)) > 0 then
              if not TryEncodeDate(YearOf((ADataTmp)), MonthOf(ADataTmp), ADiaFixo, ADataTmp) then // tenta setar o dia de vencimento dentro do mes, se nao conseguir (dia 31, 30, 29) seta o final do mes
                ADataTmp := EndOfTheMonth(ADataTmp);

            if (not Asilent) and (I = Low(AParcelas) + 1) then
              if Pos('[INFORMAR DIA]', UpperCase(ADescrCP)) > 0 then
                if informarDiaPrimeiraESegundaParcela(
                  AParcelas[Low(AParcelas)    ].DataVencimento,
                  AParcelas[Low(AParcelas) + 1].DataVencimento,
                  ADiaAtual) then
                begin
                  ADataTmp := IncMonth(AParcelas[I].DataVencimento);
                  ADiaFixo := DayOf(ADataTmp);
                  if Pos('[DIA FIXO]', UpperCase(ADescrCP)) > 0 then
                    if not TryEncodeDate(YearOf((ADataTmp)), MonthOf(ADataTmp), ADiaFixo, ADataTmp) then // tenta setar o dia de vencimento dentro do mes, se nao conseguir (dia 31, 30, 29) seta o final do mes
                      ADataTmp := EndOfTheMonth(ADataTmp);
                end;
          end;
        end;
      end;

      if AQtde = -1 then// 30/60/90 dias; 15 dias; etc;
      begin
        AUsarDiaBaseControle := False;
        AStr := '';
        for I := 1 to Length(ADescrCP) do
          if ADescrCP[I] in Cnumber then
            AStr := AStr + ADescrCP[I]
          else if AStr <> '' then
          begin
            ADataTmp := ADiaPrimeiroVencimento + StrToInt(AStr);

            SetLength(AParcelas, Length(AParcelas) + 1);
            AParcelas[High(AParcelas)].DataVencimento := ADataTmp;
            AStr := '';
          end;

        if Length(AParcelas) <= 0 then
        begin
          if not Asilent then
            vDadosIni.ShowAtencao('Condição informada não gera parcelas');
          Exit;
        end;

        ADataTmp := AParcelas[High(AParcelas)].DataVencimento;
        for I := 1 to AParcelasAdicionais do
        begin
          ADataTmp := ADataTmp + 30;
          SetLength(AParcelas, Length(AParcelas) + 1);
          AParcelas[High(AParcelas)].DataVencimento := ADataTmp;
        end;

        AQtde := Length(AParcelas);
      end;
      //---
    end;

    ACondiderarDiaUtil := Trim(ACondiderarDiaUtil);
    if vDadosIni.strIn(ACondiderarDiaUtil, ['S', 'S1', 'SA', 'SA1']) then
    try
      AFeriado := TFeriado.create;
      for I := Low(AParcelas) to High(AParcelas) do
      begin
        AStr := AFeriado.E_DiaUtil(AParcelas[I].DataVencimento);

        while AStr <> 'true' do
        begin
          AParcelas[I].DataVencimento := AParcelas[I].DataVencimento +
            IfThen(Pos('A', ACondiderarDiaUtil) > 0, -1, 1);

          if not Assigned(AParcelas[I].Feriados) then
            AParcelas[I].Feriados := TStringList.Create;
          AParcelas[I].Feriados.Add(AStr);

          AStr := AFeriado.E_DiaUtil(AParcelas[I].DataVencimento);
        end;

        if Pos('1', ACondiderarDiaUtil) > 0 then // apenas na primeira
          Break;
      end;
    finally
      FreeAndNil(AFeriado);
    end;
    //---

    // definindo numero de documentos
    for I := Low(AParcelas) to High(AParcelas) do
      AParcelas[I].NumeroDocumento := vDadosIni.StrZero(ANumDoc, 6) + '-' + IntToStr(I + 1);
    //---

    // definindo valores das parcelas
    if not vDadosIni.strIn(ATipoParcelamento, ['I1', 'IN', 'T1', 'TN']) then // Valores validos contidos no cadastro do controle
      ATipoParcelamento := vDadosIni.vTipoParcelamento;
    
    if AJurosPrat > 0 then
    begin
      AQuery.Close;
      AQuery.SQL.Text := 'select coef_j from tabjuros' +
        ' where nprest_j = :nprest_j' +
        ' and juros_j = :juros_j' +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
      AQuery.ParamByName('nprest_j').AsInteger := Length(AParcelas);
      AQuery.ParamByName('juros_j').AsFloat := AJurosPrat;
      AQuery.Open;

      AJurosPrat := AQuery.FieldByName('coef_j').AsFloat;
      AQuery.Close;
    end;

    if AJurosPrat > 0 then
      AValParcela := RoundTo((AValor * AJurosPrat), -2)
    else if vDadosIni.strIn(ATipoParcelamento, ['T1', 'TN']) then
      AValParcela := Trunc(AValor / Length(AParcelas))
    else
      AValParcela := RoundTo( ( 0.01 * Trunc((AValor / Length(AParcelas) ) * 100) ) , -2);

    for I := Low(AParcelas) to High(AParcelas) do
      AParcelas[i].ValorParcela := AValParcela;

    AValParcelaComDif := RoundTo(AValParcela + (AValor - (AValParcela * Length(AParcelas))), -2);

    if vDadosIni.strIn(ATipoParcelamento, ['IN', 'TN']) then
      AParcelas[High(AParcelas)].ValorParcela := AValParcelaComDif
    else
      AParcelas[Low(AParcelas)].ValorParcela := AValParcelaComDif;
    //---
  finally
    FreeAndNil(AQuery);
    Result := AParcelas;
  end;
end;

function TCondicaoPagamento.post: boolean;
var
  acao: string;
  vTabPrec: boolean;
begin
  try
    Result := false;
    vTabPrec := False;
    if not (dataSet.State in [dsEdit, dsInsert]) then
    begin
      Result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if dataSet.FieldByName('Desc_Cond_Pag').asString = '' then
      raiseExceptionCreate('Campo Descrição não informado!', 'DBEDIT2');

    if dataSet.FieldByName('Seqpreco').asString = '' then
      raiseExceptionCreate('Campo Sequência de Preços não informado!', 'DBComboBox1');

    if dataSet.FieldByName('NATUREZA_CP').asString = '' then
      raiseExceptionCreate('O campo Natureza da condição de pagamento não pode ser vazio!',
        'DBComboBox2');

    if frmCondicaoPagamento.EditHw5.AsInteger > 0 then
     if not BuscarTabPrec(frmCondicaoPagamento.EditHw5.AsInteger) then
       raiseExceptionCreate('Preço de Tabela não encontrado!', 'EditHw5');

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_CONDPAG,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('COD_COND_PAG').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_COND_PAG').AsString;
      buscas.close;
    end;

    Result := inherited post;

		if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    try
      vEmpresaDefCondPag.dataSet.DisableControls;
      vEmpresaDefCondPag.dataSet.First;
      while not vEmpresaDefCondPag.dataSet.Eof do
      begin
        if vEmpresaDefCondPag.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE OR INSERT INTO COND_PAG_EMPRESA (COD_COND_PAG, COD_EMPRESA) ' +
            ' VALUES ( ' + IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger) + ', ' +
            IntToStr(vEmpresaDefCondPag.dataSet.FieldByName('COD_EMPRESA').AsInteger) + ') ' +
            ' MATCHING (COD_COND_PAG, COD_EMPRESA); ';
          buscas.ExecSQL;
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := ' DELETE FROM COND_PAG_EMPRESA ' +
            ' WHERE COD_COND_PAG = ' + IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(vEmpresaDefCondPag.dataSet.FieldByName('COD_EMPRESA').AsInteger);
        	buscas.ExecSQL;
        end;
   
        vEmpresaDefCondPag.dataSet.Next;
      end;
    finally
      vEmpresaDefCondPag.First;
      vEmpresaDefCondPag.dataSet.EnableControls;
    end;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS095', acao, 'SUCESSO', 'COND_PAG',
        dataSet.FieldByName('COD_COND_PAG').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS095', acao, 'FALHA', 'COND_PAG',
        dataSet.FieldByName('COD_COND_PAG').AsString, buscas);

    Result := GravarTabPrec(frmCondicaoPagamento.EditHw5.AsInteger);
    if Result then
     CommitaTransacao;

    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');

  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código da Condição de Pagamento duplicado.' + chr(13) +
          'O código da Condição de Pagamento será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        dataSet.FieldByName('COD_COND_PAG').AsVariant := null;
      end;
    end;
  end;
end;

function TCondicaoPagamento.restaurarRegistro: boolean;
var
	vCodCondPag: string;
	vDescCondPag: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCodCondPag := trim(dataSet.FieldByName('COD_COND_PAG').AsString);
      vDescCondPag := trim(dataSet.FieldByName('DESC_COND_PAG').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCodCondPag := '';
        vDescCondPag := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCodCondPag) <> '') then
      	prepare_loop('COD_COND_PAG = ' + vCodCondPag)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'CONDIÇÃO DE PAGAMENTO' + #13 +
        'Código: ' + vCodCondPag + #13 +
        'Descrição: ' + vDescCondPag;

      if (trim(vCodCondPag) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('BAS094', 'RESTAURAR', '', 'COND_PAG',
        vDadosIni.IfThen(trim(vCodCondPag) <> '', vCodCondPag, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando condição(ões) de pagamento');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando condição(ões) de pagamento (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update cond_pag set ativo = 1 ' +
          ' where cod_cond_pag = %d ',
          [fint('cod_cond_pag')], buscas);

        if (trim(vCodCondPag) = '') then
          vDadosIni.GravaAuditoria('BAS094', 'RESTAURAR', '', 'COND_PAG',
            dataSet.FieldByName('COD_COND_PAG').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('BAS094', 'RESTAURAR', 'SUCESSO', 'COND_PAG',
        vDadosIni.IfThen(trim(vCodCondPag) <> '', vCodCondPag, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('BAS094', 'RESTAURAR', 'FALHA', 'COND_PAG',
        vDadosIni.IfThen(trim(vCodCondPag) <> '', vCodCondPag, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

