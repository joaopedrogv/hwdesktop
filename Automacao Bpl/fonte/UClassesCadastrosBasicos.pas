function TCidades.SqlAdicional(consulta: RConsulta): string;
var
  sql: string;
  I: Integer;
begin

  Result := '';

  if Trim(consulta.valor) = '' then
    Exit;

  for I := 0 to dataSet.FieldCount - 1 do
    if Dataset.Fields[I].FieldKind = fkData then
      if ContainsText(dataset.Fields[I].DisplayName, consulta.campo) then
      begin
        consulta.campo := dataset.Fields[I].FieldName;
        consulta.valor := ajustar_consulta_incasesensitive(DataSet.Fields[I], '', consulta.valor);
        Break;
      end;

  if consulta.campo <> 'ZFM_ALC' then
    Exit;

  consulta.condicao := Trim(consulta.condicao);
  
  sql := IfThen(consulta.condicao = 'Igual', '= ') +
         IfThen(consulta.condicao = 'Maior', '> ') +
         IfThen(consulta.condicao = 'Maior ou Igual', '>= ') +
         IfThen(consulta.condicao = 'Menor', '< ') +
         IfThen(consulta.condicao = 'Menor ou Igual', '<= ') +
         IfThen(consulta.condicao = 'Diferente', '<> ') +
         IfThen(consulta.condicao = 'Esta contido', 'like') +
         IfThen(consulta.condicao = 'Começa', 'Começa');
  sql := IfThen(consulta.condicao = '', '= ', sql);

  sql := IfThen(sql = 'Começa', ' like ' + QuotedStr(consulta.valor + '%'),
                IfThen(sql = 'like'  , ' like ' + QuotedStr('%' + consulta.valor + '%'),
                       sql + QuotedStr(consulta.valor)));

  Result := 'CIDADES_IBGE.ZFM_ALC ' + sql;  
end;

