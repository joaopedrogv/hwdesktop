procedure TCadPerfilHorasTrabalho._cadPerfilHorasTrabalho(pTipoForm: Integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro do Perfil Horas de Trabalho');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS532', 'CONSULTA', '', 'PERFIL_HORAS_TRABALHO', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadPerfilHorasTrabalho = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadPerfilHorasTrabalho, frmCadPerfilHorasTrabalho);
    end;

    if (pTipoForm > 0) and (not frmCadPerfilHorasTrabalho.Visible) then
      frmCadPerfilHorasTrabalho.ShowModal
    else if (not frmCadPerfilHorasTrabalho.Visible) then
      frmCadPerfilHorasTrabalho.Show
    else if frmCadPerfilHorasTrabalho.FormStyle = fsMDIChild then
      frmCadPerfilHorasTrabalho.Show
    else
      frmCadPerfilHorasTrabalho.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

