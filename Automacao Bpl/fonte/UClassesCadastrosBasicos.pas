{ TEmpresaReplicacao }

function TEmpresaReplicacao.abreEmpresaReplicacao: boolean;
begin
	Result := montaSelect(' select cod_empresa, nome_emp, identificacao_emp, '+
  	 ' cgc_emp, coalesce(emp_repl_interna, ' + vDadosIni.codEmpresa + ') emp_repl_interna from EMPRESA ' +
  	' where cod_empresa <> ' + vDadosIni.codEmpresa +
    ' order by cod_empresa desc ');

  vDadosIni.vDtSetTmp.FieldByName('COD_EMPRESA').DisplayLabel := 'Codigo';
  vDadosIni.vDtSetTmp.FieldByName('IDENTIFICACAO_EMP').DisplayLabel := 'Empresa';
  vDadosIni.vDtSetTmp.FieldByName('CGC_EMP').DisplayLabel := 'CNPJ';
  vDadosIni.vDtSetTmp.FieldByName('EMP_REPL_INTERNA').DisplayLabel := 'Responsavel';

  vDadosIni.vDtSetTmp.EmptyDataSet;
  dataSet.First;
  while not dataSet.Eof do
  begin
    vDadosIni.vDtSetTmp.Insert;
    vDadosIni.vDtSetTmp.FieldByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
    vDadosIni.vDtSetTmp.FieldByName('NOME_EMP').AsString := dataSet.FieldByName('NOME_EMP').AsString;
    vDadosIni.vDtSetTmp.FieldByName('IDENTIFICACAO_EMP').AsString := dataSet.FieldByName('IDENTIFICACAO_EMP'). AsString;
    vDadosIni.vDtSetTmp.FieldByName('CGC_EMP').AsString := dataSet.FieldByName('CGC_EMP').AsString;
    vDadosIni.vDtSetTmp.FieldByName('EMP_REPL_INTERNA').AsInteger := dataSet.FieldByName('EMP_REPL_INTERNA').AsInteger;
    if vDadosIni.vDtSetTmp.FieldByName('EMP_REPL_INTERNA').AsInteger > 0 then
    	vDadosIni.vDtSetTmp.FieldByName('HAB').AsString := 'S'
    else
    	vDadosIni.vDtSetTmp.FieldByName('HAB').AsString := 'N';
    vDadosIni.vDtSetTmp.Post;
    vDadosIni.vDtSetTmp.First;

    dataSet.Next;
  end;
end;

function TEmpresaReplicacao.abreFormReplicacaoInterna: boolean;
var
  formulario: TfrmPadrao;
  panelTemp: TPanel;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 783;
    formulario.Height := 534;
    formulario.Position := poMainFormCenter;
    formulario.Caption := 'Configurar replicação interna';
    frmCadEmpresa.pnReplicacaoInterna.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
