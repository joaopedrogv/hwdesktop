      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;

    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS462', 'EXCLUIR', 'SUCESSO', 'COMISSAO_FAIXA_DESCONTO', vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS462', 'EXCLUIR', 'FALHA', 'COMISSAO_FAIXA_DESCONTO', vCodFormula, buscas);

    Result := true;
    Refresh;

    Exit;
  end;

  if not vDadosIni.PesqPros('BAS463', 'EXCLUIR', '', 'COMISSAO_FAIXA_DESCONTO',
    vCodFormula, buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  result := inherited Delete;
  if Result then
    result := Apply;

  if result then
    result := CommitaTransacao;
  _abrelixeira(false);
  if Result then
    vDadosIni.GravaAuditoria('BAS463', 'EXCLUIR', 'SUCESSO', 'COMISSAO_FAIXA_DESCONTO', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS463', 'EXCLUIR', 'FALHA', 'COMISSAO_FAIXA_DESCONTO', vCodFormula, buscas);

  Result := true;
  Refresh;
end;

function TComissaoFaixaDesc._abrelixeira(pMensagem: boolean): boolean;
begin
  if not _lixeiraCheia then
  begin
  	if pMensagem then
	    Application.MessageBox('A lixeira está vazia.', 'Informação', 0 + 64);
    Result := False;
  end
  else
    result := montaSelect('select * from comissao_faixa_desconto ' +
    	' where cod_empresa= ' + vDadosIni.codEmpresa +
      ' and ativo = 0');
end;

function TComissaoFaixaDesc._lixeiraCheia: boolean;
begin
  Result := ExecutaComandosSql('Select first 1 codigo from comissao_faixa_desconto ' +
    ' where ativo = 0 and cod_empresa = ' + vDadosIni.codEmpresa);
end;

function TComissaoFaixaDesc._restauralixeira: boolean;
begin
	if not vDadosIni.PesqPros('BAS464', 'RESTAURAR REGISTRO', '',
  	'COMISSAO_FAIXA_DESCONTO', dataSet.FieldByName('CODIGO').AsString, buscas, false) then
  	exit;

  if dataSet.IsEmpty then
    Exit;

  if dataSet.FieldByName('ATIVO').asinteger = 0 then
  begin
    if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
      'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
    begin
      if (Edit) or (dataSet.State = dsEdit) then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 1;
        Result := Post;
        if Result then
          Result := CommitaTransacao;

        if Result then
          vDadosIni.GravaAuditoria('BAS464', 'RESTAURAR REGISTRO', 'SUCESSO',
            'COMISSAO_FAIXA_DESCONTO', dataSet.FieldByName('CODIGO').AsString, buscas)
        else
          vDadosIni.GravaAuditoria('BAS464', 'RESTAURAR REGISTRO', 'FALHA',
            'COMISSAO_FAIXA_DESCONTO', dataSet.FieldByName('CODIGO').AsString, buscas);

      end;
    end;
  end
  else
    Application.MessageBox('Registro já está ativo' + #13 +
      'Não é necessário restaurá-lo', 'Informação', 0 + 64);
  Refresh;
end;

