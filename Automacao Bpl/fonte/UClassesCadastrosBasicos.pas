function TPerfisMetas.Delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('CODIGO_META').AsString + ' - ' + dataSet.FieldByName('CODIGO_PERFIL').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin

    if not vDadosIni.PesqPros('BAS279', 'EXCLUIR', '', 'PERFIL_METAS',
      dataSet.FieldByName('CODIGO_META').AsString + ' - ' + dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas, false) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja enviar este registro para Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;

    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS279', 'EXCLUIR', 'SUCESSO', 'PERFIL_METAS', vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS279', 'EXCLUIR', 'FALHA', 'PERFIL_METAS', vCodFormula, buscas);

    Result := true;
    Refresh;

    Exit;
  end;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  buscas.Close;
  buscas.SQL.Text := ' delete from perfil_metas '
    + '  where codigo_meta =' + dataSet.FieldByName('CODIGO_META').AsString
    + ' and codigo_perfil =' + dataSet.FieldByName('CODIGO_PERFIL').AsString + ' and cod_empresa= ' + vDadosIni.codEmpresa;

  try
    buscas.ExecSQL;

    CommitaTransacao;
    vDadosIni.GravaAuditoria('BAS280', 'EXCLUIR', 'SUCESSO', 'PERFIL_METAS', vCodFormula, buscas);
  except
    RollBackTransacao;
    vDadosIni.GravaAuditoria('BAS280', 'EXCLUIR', 'FALHA', 'PERFIL_METAS', vCodFormula, buscas);
  end;
  _abrelixeira(false);

  Result := true;
  Refresh;

end;

function TPerfisMetas.edit: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('BAS278', 'ALTERAR', '', 'PERFIL_METAS',
    '', buscas, false) then
    Exit;

  if inherited Edit then
  begin
    Result := True;
    dataSet.FieldByName('CODIGO_META').AsInteger := dataSet.FieldByName('CODIGO_META').AsInteger;
    dataSet.FieldByName('CODIGO_PERFIL').AsInteger := dataSet.FieldByName('CODIGO_PERFIL').AsInteger;
    _abreMetas;
    _abrePerfil;
  end;
end;

function TPerfisMetas.Insert: boolean;
begin
  if not vDadosIni.PesqPros('BAS277', 'INCLUIR', '', 'PERFIS_METAS',
    '', buscas, True) then
    Exit;

  if not dataSet.Active then
    montaSelect('select pm.*, mv.descricao_meta, pc.nome_perfil from perfil_metas pm '
      + ' inner join metas_vendas mv on mv.codigo_meta = pm.codigo_meta and mv.cod_empresa = pm.cod_empresa '
      + ' inner join perfil_comissao pc on pc.codigo_perfil = pm.codigo_perfil '
      + ' where pm.ativo = 0 and pm.cod_empresa= 0');

  Result := False;
  if inherited Insert then
  begin
    Result := True;
    dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('ATIVO').AsFloat := 1;
    _abreMetas;
    _abrePerfil;
  end;
end;

function TPerfisMetas.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS282', 'SALVAR', '', 'PERFIL_METAS',
      dataSet.FieldByName('CODIGO_META').AsString + ' - ' + dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataSet.FieldByName('CODIGO_META').AsInteger <= 0 then
      raiseExceptionCreate('Meta deve ser informada', 'EditHw1');

    if not _buscarMetas(dataSet.FieldByName('CODIGO_META').AsInteger) then
      raiseExceptionCreate('Meta não encontrada', 'EditHw1');

    if dataSet.FieldByName('CODIGO_PERFIL').AsInteger <= 0 then
      raiseExceptionCreate('Perfil deve ser informada', 'EditHw2');

    if not _buscarPerfil(dataSet.FieldByName('CODIGO_PERFIL').AsInteger) then
      raiseExceptionCreate('Perfil não encontrado', 'EditHw2');  

    if dataSet.State = dsInsert then
      if not _verificarPerfilMeta(dataSet.FieldByName('CODIGO_META').AsInteger, dataSet.FieldByName('CODIGO_PERFIL').AsInteger) then
      begin
        raiseExceptionCreate('Ja existe essa meta para este perfil!', 'EditHw2');
        exit;
      end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS282', acao, 'SUCESSO', 'PERFIL_METAS',
        dataSet.FieldByName('CODIGO_META').AsString + ' - ' + dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS282', acao, 'FALHA', 'PERFIL_METAS',
        dataSet.FieldByName('CODIGO_META').AsString + ' - ' + dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;


end;

