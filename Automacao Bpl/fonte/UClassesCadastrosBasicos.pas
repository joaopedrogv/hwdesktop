  if dataSet.IsEmpty then
    Exit;
  if not vDadosIni.PesqPros('BAS217', 'EXCLUIR', 'CFOP ' + dataSet.FieldByName('CODIGO_NOP').AsString
    + ' - ' +
    dataSet.FieldByName('DESCRICAO_NOP').AsString, 'NAT_OP_DESCRICAO', '', buscas, true) then
