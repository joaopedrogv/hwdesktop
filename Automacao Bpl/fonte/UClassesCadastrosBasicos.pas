function TCEP._PrimeiroWebService_RuaBairroCidadeSiglaEstadoCodIBGECidade(Cep: string): TStringList;
var
  // WebServiceCep : CEPServicePort;
  temp, temp2, tempcont: string;
  p2, x, p, ContPadrao: integer;
  recebetexto: TStringList;
begin
  try
    recebetexto := TStringList.Create;
    // WebServiceCep := GetCEPServicePort();
    //temp :=  WebServiceCep.obterLogradouroAuth(Cep,'azevedo','empresabyjg');
    ContPadrao := 0;
    tempcont := temp;
    {Conta se a quatidade de virgula  é  igual a 4, o padrão de quando
      foi feito.
    }
    while (Pos(',', tempcont) <> 0) do
    begin
      tempcont[pos(',', tempcont)] := '.';
      inc(ContPadrao);
    end;

    if not (ContPadrao = 4) then
      exit;

    while pos('ç', temp) <> 0 do
      temp[pos('ç', temp)] := 'c';
    while pos('Ç', temp) <> 0 do
      temp[pos('Ç', temp)] := 'C';
    while pos('á', temp) <> 0 do
      temp[pos('á', temp)] := 'a';
    while pos('Á', temp) <> 0 do
      temp[pos('Á', temp)] := 'A';
    while pos('é', temp) <> 0 do
      temp[pos('é', temp)] := 'e';
    while pos('É', temp) <> 0 do
      temp[pos('É', temp)] := 'E';
    while pos('ã', temp) <> 0 do
      temp[pos('ã', temp)] := 'a';
    while pos('õ', temp) <> 0 do
      temp[pos('õ', temp)] := 'o';

    temp := UpperCase(temp);
    temp := _UpperCaseAcentuados(temp);
    p2 := 0;
    if not (Pos(',', temp) = 0) then
    begin
      for x := 0 to 4 do
      begin
        p2 := Pos(',', temp) - 1;
        if p2 > 0 then
        begin
          temp2 := Copy(temp, 1, p2);
          p2 := Length(temp2) + 1;
          if ((not (Pos('-', temp2) = 0)) and (x = 0)) then
          begin
            temp2 := Copy(temp2, 1, (Pos('-', temp2) - 1));
          end;
          recebetexto.Add(temp2);
        end
        else
        begin
          recebetexto.Add(temp);
        end;
        temp := Copy(temp, p2 + 1, (Length(temp)));
      end;
    end;
    Result := recebetexto;
  except
    recebetexto.Clear;
    Result := recebetexto;
  end;
end;

