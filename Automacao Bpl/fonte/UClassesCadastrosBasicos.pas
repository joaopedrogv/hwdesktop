procedure cadastrosbasicos_preencherDadosImagemDoc(
	pBuscas: TIBQuery;
	pCodigo: Integer;
  pCodEmpresa: Integer;
  pTipo: string);
begin
	try
		if trim(pTipo) = 'CTP' then
      frmImagensDoc.Caption     := 'Imagens / Doc (Conta a pagar - Código: ' + IntToStr(pCodigo)+ ')'
    else if trim(pTipo) = 'LOTECTP' then
      frmImagensDoc.Caption     := 'Imagens / Doc (Conta a pagar - Lote: ' + IntToStr(pCodigo) + ')';

    if trim(pTipo) = 'CTP' then
      frmImagensDoc.vNomeTabela := 'CONTAS_A_PAGAR_IMAGENS'
    else if trim(pTipo) = 'LOTECTP' then
      frmImagensDoc.vNomeTabela := 'LOTE_LANC_IMAGENS';

    frmImagensDoc.vCodigoTabMovimentada := trim(pTipo) + ' ' + IntToStr(pCodigo);

    frmImagensDoc.vProcessoAdicionar    := 'CTP036';
    frmImagensDoc.vProcessoVisualizar   := 'CTP037';
    frmImagensDoc.vProcessoProximo      := 'CTP038';
    frmImagensDoc.vProcessoAnterior     := 'CTP039';
    frmImagensDoc.vProcessoRevomer      := 'CTP040';

    frmImagensDoc.SpeedButton48.Hint :=
      'Adicionar Imagem - [' + frmImagensDoc.vProcessoAdicionar + ']';

    frmImagensDoc.SpeedButton52.Hint :=
      'Visualizar Imagem - [' + frmImagensDoc.vProcessoVisualizar + ']';

    frmImagensDoc.SpeedButton49.Hint :=
      'Próxima Imagem - [' + frmImagensDoc.vProcessoProximo + ']';

    frmImagensDoc.SpeedButton51.Hint :=
      'Imagem Anterior - [' + frmImagensDoc.vProcessoAnterior + ']';

    frmImagensDoc.SpeedButton50.Hint :=
      'Excluir Imagem - [' + frmImagensDoc.vProcessoRevomer + ']';

    frmImagensDoc.vCodigo     := pCodigo;
    frmImagensDoc.vCodEmpresa := pCodEmpresa;
    frmImagensDoc.vTipo       := pTipo;
  except
    on E: Exception do
    begin
			Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      vDadosIni.registraErro('Erro: ' + e.Message);
    end;
  end;
end;

function cadastrosbasicos_abreFormImagemDoc(
  pBuscas: TIBQuery;
	pCodigo: Integer;
  pCodEmpresa: Integer;
  pTipo: string): boolean;
begin
	try
    Application.CreateForm(TfrmImagensDoc, frmImagensDoc);

    cadastrosbasicos_preencherDadosImagemDoc(
      pBuscas,
    	pCodigo,
      pCodEmpresa,
      pTipo
    );

    Result := frmImagensDoc.ShowModal = mrOk;
  finally
    if Assigned(frmImagensDoc) then
    	frmImagensDoc.Free;
  end;
end;

