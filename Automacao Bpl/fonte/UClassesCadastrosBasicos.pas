function TCondicaoPagamento.adicionarRemoverControleClientePrestacao(pRemover: boolean): boolean;
var
	temp: string;
  temp2: string;
	codigo: string;
  codprocesso: string;
begin
	try
    Result := False;

    codigo := IntToStr(dataset.FieldByName('COD_COND_PAG').AsInteger);

    codprocesso := vDadosIni.IfThen(not pRemover, 'BAS505', 'BAS506');
    
    if not vDadosIni.PesqPros(codprocesso, 'SALVAR', '', 'COND_PAG',
      codigo, buscas, true) then
      Exit;

    temp := vDadosIni.IfThen(not pRemover, 'adicionar', 'remover');
    temp2 := vDadosIni.IfThen(not pRemover, 'adicionada', 'removida');

    if Application.MessageBox(PChar('Deseja ' + temp + ' a condição de pagamento?' + #13 + #13 +
      'A condição de pagamento será ' + temp2 + ' para prestações em todos clientes.'), 'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> idyes then
        exit;

    if not pRemover then
    begin
      buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = ''(' + codigo + ')'' ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and trim(coalesce(cond_pag_pre, '''')) = '''' ' +
        '	and (char_length(trim(coalesce(cond_pag_pre, ''''))) + char_length(' + codigo + ')) <= 256 ';
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = replace(cond_pag_pre, '')'', '',' + codigo + ')'') ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(cond_pag_pre, '''') <> ''(' + codigo + ')'' ' +
        ' and coalesce(cond_pag_pre, '''') not like ''(' + codigo + ',%'' ' +
        ' and coalesce(cond_pag_pre, '''') not like ''%,' + codigo + ')'' ' +
        '	and (char_length(trim(coalesce(cond_pag_pre, ''''))) + char_length(' + codigo + ')) <= 256 ';
      buscas.ExecSQL;
    end
    else
    begin
    	buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = null ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(cond_pag_pre, '''') = ''(' + codigo + ')'' ';
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = replace(cond_pag_pre, ''(' + codigo + ','', ''('') ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(cond_pag_pre, '''') like ''(' + codigo + ',%'' ';
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = replace(cond_pag_pre, '',' + codigo + ','', '','') ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(cond_pag_pre, '''') like ''%,' + codigo + ',%'' ';
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ' update clientes set cond_pag_pre = replace(cond_pag_pre, '',' + codigo + ')'', '')'') ' +
        '	where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(cond_pag_pre, '''') like ''%,' + codigo + ')'' ';
      buscas.ExecSQL;
    end;

    CommitaTransacao;

    vDadosIni.GravaAuditoria(codprocesso, 'SALVAR', 'SUCESSO', 'COND_PAG', codigo, buscas);
    
    Result := true;
  Except
     on e: Exception do
     begin
        Result := false;

        vDadosIni.GravaAuditoria(codprocesso, 'SALVAR', 'FALHA', 'COND_PAG', codigo, buscas);
        
        Application.MessageBox( pchar(e.Message) ,'Atenção' ,MB_ICONERROR + MB_OK );
        registraErro(e.Message);
     end;
  end;
end;

