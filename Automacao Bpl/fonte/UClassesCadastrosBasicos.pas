    _setaPercentuaisTipoVND;
    dataSet.FieldByName('OBSERVACAO').AsString := UpperCase(dataSet.FieldByName('OBSERVACAO').AsString);
    dataSet.FieldByName('TIPO').AsString := dataSet.FieldByName('TIPO').AsString;
    dataSet.FieldByName('DESCRICAO').AsString := dataSet.FieldByName('DESCRICAO').AsString;
    dataSet.FieldByName('TIPO_OS').AsString := dataSet.FieldByName('TIPO_OS').AsString;
    dataSet.FieldByName('SIGLA').AsString := dataSet.FieldByName('SIGLA').AsString;
    dataSet.FieldByName('VENDA').AsString := dataSet.FieldByName('VENDA').AsString;
    dataSet.FieldByName('COMGARANTIA').AsString := dataSet.FieldByName('COMGARANTIA').AsString;
    dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString := dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString;
    dataSet.FieldByName('COMGARANTIA').AsString := dataSet.FieldByName('COMGARANTIA').AsString;
    dataSet.FieldByName('ORDEMEXIBICAO').AsInteger := dataSet.FieldByName('ORDEMEXIBICAO').AsInteger;
    dataSet.FieldByName('CONFIGFECHVND').AsString := dataSet.FieldByName('CONFIGFECHVND').AsString;
    dataSet.FieldByName('RECEBER_FINANCEIRO').AsString := dataSet.FieldByName('RECEBER_FINANCEIRO').AsString;

