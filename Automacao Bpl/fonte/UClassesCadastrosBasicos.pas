      dataSet.FieldByName('CODIGO_UF').AsString +
      ' and uf_destino = ' + dataSet.FieldByName('UF_DESTINO').AsString;
    buscas.Open;

    Cancel;
    dataSet.IndexFieldNames := 'CODIGO_UF;UF_DESTINO';
    dataSet.FindNearest([buscas.FieldByName('CODIGO_UF').AsInteger,
      buscas.FieldByName('UF_DESTINO').AsInteger]);
    if (dataset.FieldByName('CODIGO_UF').AsInteger = buscas.FieldByName('CODIGO_UF').AsInteger) and
      (dataset.FieldByName('UF_DESTINO').AsInteger = buscas.FieldByName('UF_DESTINO').AsInteger)
      then
    begin
      if not edit then
      begin
        result := false;
        Application.MessageBox(PChar('Falha ao tentar editar o registro.'), 'Aviso', MB_OK +
          MB_ICONERROR + MB_DEFBUTTON1);
