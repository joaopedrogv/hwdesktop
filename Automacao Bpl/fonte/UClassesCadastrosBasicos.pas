function TTipoReserva._RestaurarLixeira: boolean;
begin
  result := false;
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if inherited Edit then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          result := inherited Post;
          if Result then
            result := Apply;
          if Result then
            result := CommitaTransacao;
          if Result then
            vDadosIni.GravaAuditoria('BAS358', 'RESTAURAR REGISTRO', 'SUCESSO',
              'TIPO_RESERVA', dataSet.FieldByName('CODIGO').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS358', 'RESTAURAR REGISTRO', 'FALHA',
              'TIPO_RESERVA', dataSet.FieldByName('CODIGO').AsString, buscas);
        end;
      end;
    end;
  Refresh;
end;

