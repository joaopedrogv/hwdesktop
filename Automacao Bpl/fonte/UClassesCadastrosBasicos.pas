      raiseExceptionCreate('Tipo da Meta deve ser informada', 'DBComboBox6');

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('CODIGO_META').AsInteger := Gencodigo('METAS_VENDAS',
        DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
