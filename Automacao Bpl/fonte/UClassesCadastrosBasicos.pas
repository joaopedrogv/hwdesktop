function TCadRegrasTravReqOS.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS483', 'SALVAR',
    	dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString,
      'REGRAS_TRAVOSREQ', '', buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('TIPO').AsString) = '' then
    	raiseExceptionCreate('Tipo deve ser informado', 'DBComboBox1');

    if trim(dataSet.FieldByName('TIPV').AsString) = '' then
    	raiseExceptionCreate('Sigla / Tipo OS deve ser informado', 'DBComboBox2');

    if dataSet.FieldByName('QTDE_DIAS').AsInteger < 0 then
      raiseExceptionCreate('Quantidade de dias deve ser informada', 'DBEdit1');

    if trim(dataSet.FieldByName('TIPO').AsString) = 'ESF' then
      if dataSet.FieldByName('QTDE_DIAS_RES').AsInteger < 0 then
        raiseExceptionCreate('Quantidade de dias reserva deve ser informada', 'DBEdit2');

    if dataSet.FieldByName('NIVEL_US').AsInteger <= 0 then
    	raiseExceptionCreate('Nível do usuário deve ser informada', 'DBEdit3');

    if (acao = 'INSERIR') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select tipo, tipv, cod_empresa from regras_travosreq ' +
        ' where tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
        ' and tipv = ' + QuotedStr(dataSet.FieldByName('tipv').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ';
      buscas.Open;
      if not buscas.IsEmpty then
        raiseExceptionCreate('Já existe essa regra ativa cadastrada', '');
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS483', acao,
      	'SUCESSO - ' + dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString,
     	  'REGRAS_TRAVOSREQ', '', buscas)
    else
      vDadosIni.GravaAuditoria('BAS483', acao,
      	'FALHA - ' + dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString,
        'REGRAS_TRAVOSREQ', '', buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadRegrasTravReqOS.verificatipovenda(
  var vcomb: TCombobox; vtipo: string): boolean;
