function TOLAP_ConsultasUsuario.Iniciar: Boolean;
var
  I: Integer;
begin
  Result := False;

  SetConsultasDB;

  if Assigned(FOnChangeOLAPDB) then
    FOnChangeOLAPDB(FConsultasDB);

  SetConsultasUS;

  if Assigned(FOnChangeOLAPUS) then
    FOnChangeOLAPUS(FConsultasUS);

  Result := True;
end;

procedure TOLAP_ConsultasUsuario.Inserir(AIndexGrupo, AIndexConsulta: Integer);
var
  I: Integer;
  ANewGrupo: Boolean;
  J: Integer;
begin
  if AIndexGrupo <= -1 then
    Exit;
  if AIndexGrupo > FConsultasDB.Count - 1 then
    Exit;

  if AIndexConsulta <= -1 then
    Exit;
  if AIndexConsulta > FConsultasDB.Items[AIndexGrupo].Consultas.Count - 1 then
    Exit;

  if FOwer.SqlOpen('select cod_consulta from user_consultasdiv' +
                  ' where cod_consulta = ' + IntToStr(FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].cod_consulta) +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa +
                  ' and usuario = ' + QuotedStr(FOwer.dataSet.FieldByName('usuario').AsString)).IsEmpty then
  begin
    InsertDB(FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta]);
    SetConsultasUS;
    if Assigned(FOnChangeOLAPUS) then
      FOnChangeOLAPUS(FConsultasUS);
  end;
  Exit;

  ANewGrupo := True;
  for I := 0 to FConsultasUS.Count - 1 do
    if FConsultasUS.Items[I].Grupo = FConsultasDB.Items[AIndexGrupo].Grupo then
    begin
      ANewGrupo := False;
      for J := 0 to FConsultasUS.Items[I].Consultas.Count - 1 do
        if FConsultasUS.Items[I].Consultas.Items[J].cod_consulta = FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].cod_consulta then
          Exit;

      InsertDB(FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta]);
//      with FConsultasUS.Items[I].Consultas.New do
//      begin
//        cod_consulta := FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].cod_consulta;
//        nome         := FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].nome;
//      end;
    end;

  if ANewGrupo then
  begin
    with FConsultasUS.New do
    begin
      Grupo := FConsultasDB.Items[AIndexGrupo].Grupo;
      with Consultas.New do
      begin
        cod_consulta := FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].cod_consulta;
        nome         := FConsultasDB.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].nome;
      end;
    end;
  end;
  if Assigned(FOnChangeOLAPUS) then
    FOnChangeOLAPUS(FConsultasUS);
end;

procedure TOLAP_ConsultasUsuario.InsertDB(AConsulta: TOLAP_Consultas);
begin
  vDadosIni.GravaAuditoria('GES042', 'INSERIR', 'CONSULTA OLAP ' + IntToStr(AConsulta.cod_consulta) + ' - ' +
    AConsulta.nome, 'USER_CONSULTASDIV', FOwer.dataSet.FieldByName('usuario').AsString, FOwer.buscas);

  FOwer.SqlExec('insert into USER_CONSULTASDIV (COD_CONSULTA, COD_EMPRESA, USUARIO,COD_USUARIO)' +
                ' values (' +
                IntToStr(AConsulta.cod_consulta) + ',' +
                vDadosIni.codEmpresa + ',' +
                QuotedStr(FOwer.dataSet.FieldByName('usuario').AsString) + ',' +
                IntToStr(FOwer.dataSet.FieldByName('codigo').AsInteger) + ')');
  if FOwer.buscas.Transaction.InTransaction then
    FOwer.buscas.Transaction.Commit;

  vDadosIni.GravaAuditoria('GES042', 'INSERIR', 'SUCESSO - CONSULTA OLAP ' + IntToStr(AConsulta.cod_consulta) + ' - ' +
    AConsulta.nome, 'USER_CONSULTASDIV', FOwer.dataSet.FieldByName('usuario').AsString, FOwer.buscas);
end;

procedure TOLAP_ConsultasUsuario.SetConsultasDB;
var
  I: Integer;
begin
  FConsultasDB.Clear;
  with FOwer do
  begin
    //consultas OLAP base
    if SqlOpen('select distinct sq.tipoconsulta from sqlconsultasdiv sq' +
               ' where sq.cod_empresa = ' + vDadosIni.codEmpresa +
               ' order by 1').IsEmpty then
      Exit;

    while not buscas.Eof do
    begin
      with FConsultasDB.New do
        Grupo := Trim(buscas.FieldByName('tipoconsulta').AsString);
      buscas.Next;
    end;

    for I := 0 to FConsultasDB.Count - 1 do
    begin
      SqlOpen('select sq.cod_consulta, sq.descricaocons from sqlconsultasdiv sq' +
              ' where sq.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and sq.tipoconsulta = ' + QuotedStr(FConsultasDB.Items[I].Grupo) +
              ' order by 2');
      while not buscas.Eof do
      begin
        with FConsultasDB.Items[I].Consultas.New do
        begin
          cod_consulta := buscas.FieldByName('cod_consulta').AsInteger;
          nome         := Trim(buscas.FieldByName('descricaocons').AsString);
        end;
        buscas.Next;
      end;
    end;
  end;
end;

procedure TOLAP_ConsultasUsuario.SetConsultasUS;
var
  I: Integer;
begin
  FConsultasUS.Clear;
  with FOwer do
  begin
    //consultas OLAP do usuário
    if SqlOpen('select distinct sq.tipoconsulta from sqlconsultasdiv sq' +
               ' inner join user_consultasdiv uc on uc.cod_consulta = sq.cod_consulta and uc.cod_empresa = sq.cod_empresa and uc.usuario = ' + QuotedStr(Trim(FOwer.dataSet.FieldByName('usuario').AsString)) +
               ' where sq.cod_empresa = ' + vDadosIni.codEmpresa +
               ' order by 1').IsEmpty then
      Exit;

    while not buscas.Eof do
    begin
      with FConsultasUS.New do
        Grupo := Trim(buscas.FieldByName('tipoconsulta').AsString);
      buscas.Next;
    end;

    for I := 0 to FConsultasUS.Count - 1 do
    begin
      SqlOpen('select sq.cod_consulta, sq.descricaocons from sqlconsultasdiv sq' +
              ' inner join user_consultasdiv uc on uc.cod_consulta = sq.cod_consulta and uc.cod_empresa = sq.cod_empresa and uc.usuario = ' + QuotedStr(Trim(FOwer.dataSet.FieldByName('usuario').AsString)) +
              ' where sq.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and sq.tipoconsulta = ' + QuotedStr(FConsultasUS.Items[I].Grupo) +
              ' order by 2');
      while not buscas.Eof do
      begin
        with FConsultasUS.Items[I].Consultas.New do
        begin
          cod_consulta := buscas.FieldByName('cod_consulta').AsInteger;
          nome         := Trim(buscas.FieldByName('descricaocons').AsString);
        end;
        buscas.Next;
      end;
    end;
  end;
end;

