function TEmpresa_Substituto.post: boolean;
//const est: array[1..27] of string = ('AC', 'AL', 'AM', 'AP', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MG', 'MS', 'MT', 'PA', 'PB', 'PE', 'PI', 'PR', 'RJ', 'RN', 'RO', 'RR', 'RS', 'SC', 'SE', 'SP', 'TO');
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;

    if Trim(dataSet.FieldByName('sigla_uf').AsString) = '' then
      raise exception.create('Estado não informado');

    if Trim(dataSet.FieldByName('inscricao').AsString) = '' then
      raise exception.create('Inscrição de Substituto não informada');

    if ConsisteInscricaoEstadual(dataSet.FieldByName('inscricao').AsString,
      trim(dataSet.FieldByName('sigla_uf').AsString)) <> 0 then
      exit;

    dataSet.post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    Apply;
    CommitaTransacao;
    Refresh;
    result := true;
  except on e: exception do
    begin
      dataSet.Cancel;
      if pos('KEY VIOLATION', UpperCase(E.Message)) > 0 then
        Application.MessageBox('Estado informado duplicado',
          'Atenção', 0 + 64)
      else
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      Result := false;
    end;
  end;
end;

