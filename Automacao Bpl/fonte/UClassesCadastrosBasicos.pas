function TTabPrecoCond.abreTabPreco: boolean;
begin
 Result := montaSelect('select p.*, t.descr_tipo from promocao p' +
   ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa' +
   ' where p.cod_promocao > 0 and t.tipo = ''T'' and p.ativo = 1 and p.cod_empresa =' + vDadosIni.codEmpresa +
   ' order by p.descr_promocao asc');
end;

function TTabPrecoCond.buscarTabPreco(vCod: integer): boolean;
begin
  Result := ExecutaComandosSql('select p.*, t.descr_tipo from promocao p ' +
    ' inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa ' +
    ' where cod_promocao = ' + IntToStr(vCod) +
    ' and t.tipo = ''T'' ' +
    ' and p.ativo = 1 ' +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa);
end;

