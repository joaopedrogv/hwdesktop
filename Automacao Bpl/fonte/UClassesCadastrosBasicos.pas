function TRegrasCFOP_CST.post: boolean;
var
  acao: string;
begin
  try
    Result := false;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if not vDadosIni.PesqPros('BAS198', acao, 'CFOP/CST' + dataSet.FieldByName('CFOP').AsString + '/'
      +
      dataSet.FieldByName('CST').AsString + ' /ICMS: ' +
      dataSet.FieldByName('ICMS_OBRIGATORIO').AsString +
      ' /ICMS ST: ' + dataSet.FieldByName('ICMSST_OBRIGATORIO').AsString, 'CFOP_CST_ENTRADA', '',
      buscas, true) then
      Exit;

    if not (dataSet.State in [dsEdit, dsInsert]) then
    begin
      Result := true;
      exit;
    end;

    if dataSet.FieldByName('cfop').AsFloat <= 0 then
      raiseExceptionCreate('CFOP inválido!', 'DBEdit25');
    if not existeCFOP(dataSet.FieldByName('cfop').AsFloat) then
      raiseExceptionCreate('CFOP não encontrado no cadastro', 'DBEdit25');
    //    if (copy(dataSet.FieldByName('cfop').AsString,1,1) <> '1') and
    //    (copy(dataSet.FieldByName('cfop').AsString,1,1) <> '2') and
    //    (copy(dataSet.FieldByName('cfop').AsString,1,1) <> '3') then
    //      raiseExceptionCreate('CFOP informado deve iniciar em "1" ou "2"','DBEdit25');

    if dataSet.FieldByName('CST').AsString = '' then
      raiseExceptionCreate('CST não informado!', 'DBEdit90');
    if not vDadosIni.TestarCst('0' + dataSet.FieldByName('CST').AsString) then
    begin
      Result := False;
      Exit;
    end;

    if (copy(dataSet.FieldByName('ICMS_OBRIGATORIO').AsString, 1, 1) <> 'S') and
      (copy(dataSet.FieldByName('ICMS_OBRIGATORIO').AsString, 1, 1) <> 'N') and
      (Trim(dataSet.FieldByName('ICMS_OBRIGATORIO').AsString) <> '') then
      raiseExceptionCreate('Campo de ICMS obrigatório com valores inválidos!', 'DBComboBox17');

    if (copy(dataSet.FieldByName('ICMSST_OBRIGATORIO').AsString, 1, 1) <> 'S') and
      (copy(dataSet.FieldByName('ICMSST_OBRIGATORIO').AsString, 1, 1) <> 'N') and
      (Trim(dataSet.FieldByName('ICMSST_OBRIGATORIO').AsString) <> '') then
      raiseExceptionCreate('Campo de ICMS ST obrigatório com valores inválidos!', 'DBComboBox18');

    dataSet.post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    Apply;
    Refresh;
    result := true;
    CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS198', acao, 'SUCESSO', 'CFOP_CST_ENTRADA', 'CFOP/CST' +
        dataSet.FieldByName('CFOP').AsString + '/' +
        dataSet.FieldByName('CST').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS198', acao, 'FALHA', 'CFOP_CST_ENTRADA', 'CFOP/CST' +
        dataSet.FieldByName('CFOP').AsString + '/' +
        dataSet.FieldByName('CST').AsString, buscas);
    if Result then
      Refresh;
  except
    on e: exception do
    begin
      Result := false;
      if pos('KEY VIOLATION', UpperCase(E.Message)) > 0 then
        Application.MessageBox('Regra já existe', 'Atenção', 0 + 64)
      else
        Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

