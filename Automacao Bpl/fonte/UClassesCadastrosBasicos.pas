{ TAplicativo }

function TAplicativo.abreAplicativo: boolean;
begin
	Result := montaSelect(' select msg_aplicativo.id, msg_aplicativo.aplicativo from msg_aplicativo ' +
  	' where msg_aplicativo.id > 0 ' +
    ' and (select count(*) from msg_plataforma ' +
    '		   where msg_plataforma.id_msg_aplicativo = msg_aplicativo.id ' +
    '      and msg_plataforma.cod_empresa = ' + vDadosIni.codEmpresa + ') <> 0 ' +
    ' order by msg_aplicativo.id ')
end;

constructor TAplicativo.create;
begin
	if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsAplicativo);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);
end;

{ TCamposConsultasSQL }

function TCamposConsultasSQL.abreCamposConsultasSQL(pId: string): Boolean;
var
	vSql: string;
  I: Integer;
begin
	Result := False;

  FTempDatasetCamposConsultasSQL.EmptyDataSet;
  
	SqlOpen(' select sql from consultas_sql ' +
  	' where id = %s ',
    [QuotedStr(pId)], buscas);

  if buscas.IsEmpty then
  	Exit;

  vSql := buscas.FieldByName('sql').AsString;

  buscas.Close;
  buscas.SQL.Text := vSql;
  buscas.ParamByName('dados').AsInteger := 0;
  buscas.Open;

  for I := 0 to buscas.Fields.Count - 1 do
  begin
  	FTempDatasetCamposConsultasSQL.Insert;
    FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := I;
    FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := buscas.Fields[I].FieldName;
    if not buscas.FieldByName(buscas.Fields[I].FieldName).IsNull then
    	FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := buscas.FieldByName(buscas.Fields[I].FieldName).Value;
    FTempDatasetCamposConsultasSQL.Post;
  end;

  FTempDatasetCamposConsultasSQL.Insert;
  FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := buscas.Fields.Count;
  FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := 'url_anexo';
  FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := 'Url do(s) anexo(s)';
  FTempDatasetCamposConsultasSQL.Post;

  FTempDatasetCamposConsultasSQL.Insert;
  FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := buscas.Fields.Count + 1;
  FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := 'nome_bot';
  FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := 'Nome do bot';
  FTempDatasetCamposConsultasSQL.Post;

  FTempDatasetCamposConsultasSQL.Insert;
  FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := buscas.Fields.Count + 2;
  FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := 'aplicativo';
  FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := 'Aplicativo';
  FTempDatasetCamposConsultasSQL.Post;

  FTempDatasetCamposConsultasSQL.Insert;
  FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := buscas.Fields.Count + 3;
  FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := 'plataforma';
  FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := 'Plataforma';
  FTempDatasetCamposConsultasSQL.Post;

  FTempDatasetCamposConsultasSQL.Insert;
  FTempDatasetCamposConsultasSQL.FieldByName('ORDEM').AsInteger := buscas.Fields.Count + 4;
  FTempDatasetCamposConsultasSQL.FieldByName('CAMPO').AsString := 'origem';
  FTempDatasetCamposConsultasSQL.FieldByName('VALOR').Value := 'Origem (Nfe/NFSe/NFCe/Boleto/Financeiro/Contratos/Outros)';
  FTempDatasetCamposConsultasSQL.Post;

  FTempDatasetCamposConsultasSQL.IndexFieldNames := 'ORDEM';
  FTempDatasetCamposConsultasSQL.First;

  if Assigned(frmListarCamposSql) then
  	frmListarCamposSql.DBGrid_Listar.DataSource := FTempDatasourceCamposConsultasSQL;
end;

constructor TCamposConsultasSQL.create;
begin
	Buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  FTempDatasetCamposConsultasSQL := TClientDataSet.Create(nil);
  FTempDatasetCamposConsultasSQL.Close;
  FTempDatasetCamposConsultasSQL.FieldDefs.Clear;
  FTempDatasetCamposConsultasSQL.FieldDefs.Add('ORDEM', ftInteger, 0, false);
  FTempDatasetCamposConsultasSQL.FieldDefs.Add('CAMPO', ftString, 100, false);
  FTempDatasetCamposConsultasSQL.FieldDefs.Add('VALOR', ftString, 300, false);
  
  if FTempDatasetCamposConsultasSQL.Tag = 0 then
  try
    FTempDatasetCamposConsultasSQL.CreateDataSet;
    FTempDatasetCamposConsultasSQL.Tag := 1;
  except
  end;
  FTempDatasourceCamposConsultasSQL := TDataSource.Create(nil);
  FTempDatasourceCamposConsultasSQL.DataSet := FTempDatasetCamposConsultasSQL;
end;

destructor TCamposConsultasSQL.destroy;
begin
  inherited;
  if Assigned(FTempDatasourceCamposConsultasSQL) then
  	FreeAndNil(FTempDatasourceCamposConsultasSQL);

  if Assigned(FTempDatasetCamposConsultasSQL) then
  begin
    FTempDatasetCamposConsultasSQL.free;
    FTempDatasetCamposConsultasSQL := nil;
  end;
end;

end.

