  	' where codigo = ' + IntToStr(dataSet.FieldByName('CODIGO').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;

  try
    buscas.ExecSQL;

    CommitaTransacao;
//    vDadosIni.GravaAuditoria('MOB016', 'EXCLUIR', 'SUCESSO', 'MENSAGEM_MOB', vCodFormula, buscas);
  except
    RollBackTransacao;
//    vDadosIni.GravaAuditoria('MOB016', 'EXCLUIR', 'FALHA', 'MENSAGEM_MOB', vCodFormula, buscas);
  end;
  _abrelixeira(false);

  Result := true;
  Refresh;
end;

