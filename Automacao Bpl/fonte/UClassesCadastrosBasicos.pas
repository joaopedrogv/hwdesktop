      vDadosIni.GravaAuditoria('BAS006', acao, 'SUCESSO', 'DEPTO',
        dataSet.FieldByName('COD_DEPTO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS006', acao, 'FALHA', 'DEPTO',
        dataSet.FieldByName('COD_DEPTO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código do departamento duplicado.' +
          chr(13) +
          'O código da departamento será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        if dataSet.State <> dsInsert then
          inherited Insert;
        dataSet.FieldByName('COD_DEPTO').AsVariant := null;
      end;
    end;
  end;
end;

procedure TDepartamentos.PreencheCampos;
begin
  if dataSet.State = dsInsert then
  begin
    buscas.close;
    buscas.SQL.Text := 'select GEN_ID(INC_COD_DEPTO,0) from rdb$database';
    buscas.Open;
    dataSet.FieldByName('COD_DEPTO').AsInteger := buscas.FieldByName('GEN_ID').asinteger + 1;
    dataSet.FieldByName('ATIVO').AsInteger := 1;
    buscas.close;
  end;
end;

function TDepartamentos.restauraRegistro: boolean;
begin
  result := false;
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if inherited Edit then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          result := inherited Post;
          if Result then
            result := Apply;
          if Result then
            result := CommitaTransacao;
          if Result then
            vDadosIni.GravaAuditoria('BAS005', 'RESTAURAR REGISTRO', 'SUCESSO', 'DEPTO',
              dataSet.FieldByName('COD_DEPTO').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS005', 'RESTAURAR REGISTRO', 'FALHA', 'DEPTO',
              dataSet.FieldByName('COD_DEPTO').AsString, buscas);
        end;
      end;
    end;
  Refresh;
end;

