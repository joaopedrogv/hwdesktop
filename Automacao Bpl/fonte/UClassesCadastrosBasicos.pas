procedure TCores._VerificarCodigoAutoIncremento(generator, campo, tabela: string);
var
  codigo: integer;
begin
  buscas.close;
  buscas.SQL.Text := 'select GEN_ID(' + generator + ',1) from rdb$database';
  buscas.Open;
  dataSet.FieldByName(campo).AsInteger := buscas.FieldByName('GEN_ID').asinteger;

  buscas.close;
  buscas.SQL.Text := 'select coalesce(max(' + campo + ')+1,0) as cod from ' + tabela + '';
  buscas.Open;
  codigo := buscas.FieldByName('cod').asinteger;
  if (dataSet.FieldByName(campo).AsInteger <> codigo) then
  begin
    ExecutaComandosSql('SET GENERATOR ' + generator + ' TO ' + IntToStr(codigo));
    buscas.close;
    buscas.SQL.Text := 'select GEN_ID(' + generator + ',1) from rdb$database';
    buscas.Open;
    dataSet.FieldByName(campo).AsInteger := buscas.FieldByName('GEN_ID').asinteger;
  end;
end;

procedure TCores._VerificarCampos(qtde_tratamento: integer; acao: string; campo_chave: string;
  campo: string;
  tabela: string; mensagem_naoinformado: string; mensagem_jacadastrado: string);
begin
  { Verificação do campo se não foi informado e se já tem este campo no banco
qtde_tratamento : quantidade de tratamentos que fará no campo
opções: 1 - tratamento  somente de campo não informado
      2 - tratamento anterior e de informação já cadastrada
acao : 'INSERIR' ou 'EDITAR' (somente aceita essas strings)
campo_chave: campo chave primaria na tabela do banco
campo : campo de verificação
tabela : tabela do banco de dados
mensagem_naoinformado : Mensagem de campo não informado para exibir
mensagem_jacadastrado : Mensagem de informação já cadastrada para exibir
}
  if trim(dataSet.FieldByName(campo).AsString) = '' then
  begin
    if (qtde_tratamento >= 1) then
    begin
      raise exception.create(mensagem_naoinformado);
    end
  end
  else
  begin
    if acao = 'EDITAR' then
    begin
      if (qtde_tratamento >= 2) then
        if trim(dataSet.FieldByName(campo).OldValue) <>
          trim(dataSet.FieldByName(campo).NewValue) then
          if ExecutaComandosSql('select ' + campo_chave + ' from ' + tabela + ' where ' + campo +
            ' = ' +
            quotedstr(dataSet.FieldByName(campo).AsString)) then
          begin
            raise exception.create(mensagem_jacadastrado);
          end
    end
    else if (qtde_tratamento >= 2) then
      if ExecutaComandosSql('select ' + campo_chave + ' from ' + tabela + ' where ' + campo + ' = '
        +
        quotedstr(dataSet.FieldByName(campo).AsString)) then
      begin
        raise exception.create(mensagem_jacadastrado);
      end

  end;
end;

