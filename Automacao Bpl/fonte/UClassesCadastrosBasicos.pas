  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin

    if not vDadosIni.PesqPros('BAS480', 'EXCLUIR', '', 'REGRAS_TRAVOSREQ',
    	dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString, buscas, false) then
        Exit;

    if Application.MessageBox('Tem certeza que deseja enviar este registro para Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;

    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS480', 'EXCLUIR',
