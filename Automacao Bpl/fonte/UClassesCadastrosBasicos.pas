procedure TSugestaoServico._abreFormSugServ(pTipoForm: Integer);
begin
   try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Sugestão Serviço');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
    vDadosIni.vTipoForm := pTipoForm;
    if not vDadosIni.PesqPros('BAS376', 'ABRIR', '', 'SUGESTAOSERVICO', '',DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if not (vDadosIni.vSugServico.vHabilitarSug) then
    begin
      Application.MessageBox('Empresa não configurada para usar Sugestão Serviço!',
      'Atenção', 0 + 64);
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmSugestaoServico = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TfrmSugestaoServico, frmSugestaoServico);
    end;

    if (pTipoForm > 0) and (not frmSugestaoServico.Visible) then
      frmSugestaoServico.ShowModal
    else if (not frmSugestaoServico.Visible) then
      frmSugestaoServico.Show
    else if frmSugestaoServico.FormStyle = fsMDIChild then
      frmSugestaoServico.Show
    else
      frmSugestaoServico.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TSugestaoServico._abrelixeira: boolean;
begin
 if not _lixeiraCheia then
  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', 0 + 64);
    Result := False;
  end
  else
   result :=  montaSelect(' select distinct sugestaoservico.cod_empresa, sugestaoservico.cod_equip, ' +
   	' sugestaoservico.cod_veic, sugestaoservico.chassi, sugestaoservico.placa, ' +
    ' veiculos.anofab, veiculos.anomod, sugestaoservico.ndoc_ant, sugestaoservico.tpdoc_ant, ' +
    ' sugestaoservico.data_ult_serv, sugestaoservico.km_ult_serv, ' +
    ' case when (sugestaoservico.cod_equip > 0) then equipamento.dat_cad_equi else veiculos.data_cad end data_cad_tipo, ' +
    ' sugestaoservico.data, sugestaoservico.cod_cliente, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.codigo_uf else clientes.codigo_uf end codigo_uf, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then est.sigla_uf else estados.sigla_uf end sigla_uf, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.cod_cidade else clientes.cod_cidade end cod_cidade, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then cid.nome_cidade else cidades.nome_cidade end nome_cidade, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.cod_bairro else clientes.cod_bairro end cod_bairro, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then bai.nome_bairro else bairros.nome_bairro end nome_bairro, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then colaborador.cep_vendedor else clientes.cep end cep, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then colaborador.end_vendedor else clientes.endereco end endereco, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then 0 else clientes.num_end_cliente end num_end_cliente, ' +
    ' case when (sugestaoservico.cod_equip > 0) then equipamento.nom_equip else veiculos.descmodelo end descricao_tp, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.nome_vendedor else clientes.nome_cliente end nome_cliente, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.nome_vendedor else clientes.nome_cliente end razao, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.fone_vendedor else clientes.fone_cliente end fone_cliente, ' +
    ' case when ((sugestaoservico.cod_equip > 0) and (equipamento.tip_equip = ''I'')) then col.email else clientes.email end email, ' +
    ' sugestaoservico.ult_atd, colaborador.nome_vendedor, sugestaoservico.ativo, ' +
    ' sugestaoservico.cod_agenda, sugestaoservico.status, sugestaoservico.ndoc, sugestaoservico.tpdoc, ' +
    ' sugestaoservico.us_cad, sugestaoservico.data_cad, sugestaoservico.hora_cad from sugestaoservico ' +
    ' left join equipamento on equipamento.cod_equip = sugestaoservico.cod_equip and equipamento.cod_empresa = sugestaoservico.cod_empresa ' +
    ' left join veiculos on veiculos.codigo = sugestaoservico.cod_veic and veiculos.chassi = sugestaoservico.chassi and veiculos.placa = sugestaoservico.placa ' +
    ' left join colaborador col on col.cod_vendedor = sugestaoservico.cod_cliente and col.cod_empresa = sugestaoservico.cod_empresa ' +
    ' left join estados est on col.codigo_uf = est.codigo_uf ' +
    ' left join cidades cid on col.cod_cidade = cid.cod_cidade ' +
    ' left join bairros bai on col.cod_bairro = bai.cod_bairro ' +
    ' left join clientes on clientes.cod_cliente = sugestaoservico.cod_cliente and clientes.cod_empresa = sugestaoservico.cod_empresa ' +
    ' left join estados on clientes.codigo_uf = estados.codigo_uf ' +
    ' left join cidades on clientes.cod_cidade = cidades.cod_cidade ' +
    ' left join bairros on clientes.cod_bairro = bairros.cod_bairro ' +
    ' left join colaborador on colaborador.cod_vendedor = sugestaoservico.ult_atd and colaborador.cod_empresa = sugestaoservico.cod_empresa' +
    ' where sugestaoservico.cod_empresa = ' + vDadosIni.codEmpresa + ' and sugestaoservico.ativo = 0 ');
end;

function TSugestaoServico._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
begin
  result := true;
  rSugServico.vSqlAdicional := '';

  if rSugServico.vAdicional then
  begin
    if rSugServico.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rSugServico.vDataIniAd);
      except
        rSugServico.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rSugServico.vDataFimAd);
      except
        rSugServico.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rSugServico.vDataIniAd <> '' then
          rSugServico.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rSugServico.vDataIniAd)));
        if rSugServico.vDataFimAd <> '' then
          rSugServico.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rSugServico.vDataFimAd)));
      end;
    end
    else if rSugServico.vValorAd = '' then
      exit;
    if rSugServico.vCondicaoAd = 'Igual' then
      rSugServico.vCondicaoAd := '='
    else if rSugServico.vCondicaoAd = 'Maior' then
      rSugServico.vCondicaoAd := '>'
    else if rSugServico.vCondicaoAd = 'Maior ou Igual' then
      rSugServico.vCondicaoAd := '>='
    else if rSugServico.vCondicaoAd = 'Menor' then
      rSugServico.vCondicaoAd := '<'
    else if rSugServico.vCondicaoAd = 'Menor ou Igual' then
      rSugServico.vCondicaoAd := '<='
    else if rSugServico.vCondicaoAd = 'Diferente' then
      rSugServico.vCondicaoAd := '<>'
    else if (rSugServico.vCondicaoAd = 'Esta contido') then
      rSugServico.vCondicaoAd := 'like'
    else if (rSugServico.vCondicaoAd = 'Começa') then
      rSugServico.vCondicaoAd := 'Começa'
    else
      rSugServico.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rSugServico.vCampoAd) then
        begin
//          if rSugServico.vCampo = rSugServico.vCampoAd then
//          begin
//            rSugServico.vsqlAdicional := '';
//            exit;
//          end;
          rSugServico.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rSugServico.vCondicaoAd = 'Começa') or (rSugServico.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rSugServico.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rSugServico.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rSugServico.vCondicaoAd := '=';
            rSugServico.vValorAd := vDadosIni.trocaVirgulaPorPonto(rSugServico.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (rSugServico.vDataIniAd <> '') and (rSugServico.vDataFimAd <> '') then
            begin
              if (rSugServico.vCampoAd = 'DATA_CAD_TIPO') then
                rSugServico.vsqlAdicional := '((EQUIPAMENTO.DAT_CAD_EQUI >= ' + rSugServico.vDataIniAd +
                  ' AND EQUIPAMENTO.DAT_CAD_EQUI <= ' + rSugServico.vDataFimAd + ') OR ' +
                  ' (VEICULOS.DATA_CAD >= ' + rSugServico.vDataIniAd +
                  ' AND VEICULOS.DATA_CAD <= ' + rSugServico.vDataFimAd + ')) '
              else if (rSugServico.vCampoAd = 'DATA_CAD') then
                rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + 'SUGESTAOSERVICO.DATA_CAD ' +
                  ' >= ' + rSugServico.vDataIniAd + ' AND SUGESTAOSERVICO.DATA_CAD <= ' + rSugServico.vDataFimAd
              else
                rSugServico.vSqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd +
                ' >= ' + rSugServico.vDataIniAd + ' and ' + rSugServico.vCampoAd + ' <= ' + rSugServico.vDataFimAd
            end
            else if (rSugServico.vDataFimAd <> '') then
              rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd +
                ' <= ' + rSugServico.vDataIniAd
            else if (rSugServico.vDataIniAd <> '') and (rSugServico.vDataFimAd <> '') then
              rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd +
                ' >= ' + rSugServico.vDataIniAd;
            Break;
          end;
          if rSugServico.vCondicaoAd = 'like' then
            rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd +
              ' like ' + QuotedStr('%' +
              rSugServico.vValorAd +
              '%')
          else if rSugServico.vCondicaoAd = 'Começa' then
            rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd +
              ' like ' +
              QuotedStr(rSugServico.vValorAd + '%')
          else
            rSugServico.vsqlAdicional := rSugServico.vsqlAdicional + rSugServico.vCampoAd + ' '
              + rSugServico.vCondicaoAd + ' ' +
              QuotedStr(rSugServico.vValorAd);

          if rSugServico.vCondicaoAd <> 'Começa' then
          begin
            if (rSugServico.vCampoAd = 'ANOFAB') or (rSugServico.vCampoAd = 'ANOMOD') then
              rSugServico.vsqlAdicional := 'VEICULOS.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd)
            else if (rSugServico.vCampoAd= 'CODIGO_UF') or (rSugServico.vCampoAd= 'COD_CIDADE') or (rSugServico.vCampoAd= 'COD_BAIRRO') then
              rSugServico.vsqlAdicional := '((COLABORADOR.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'SIGLA_UF') then
              rSugServico.vsqlAdicional := '((EST.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(ESTADOS.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'NOME_CIDADE') then
              rSugServico.vsqlAdicional := '((CID.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CIDADES.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'NOME_BAIRRO') then
              rSugServico.vsqlAdicional := '((BAI.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(BAIRROS.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'CEP') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.CEP_VENDEDOR ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.CEP ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'ENDERECO') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.END_VENDEDOR ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.ENDERECO ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'NOME_CLIENTE') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.NOME_VENDEDOR ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.NOME_CLIENTE ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'RAZAO') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.NOME_VENDEDOR ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.RAZAO ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'FONE_CLIENTE') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.FONE_VENDEDOR ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.FONE_CLIENTE ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'EMAIL') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.EMAIL ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR ' +
                '(CLIENTES.EMAIL ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd= 'NUM_END_CLIENTE') then
              rSugServico.vsqlAdicional := 'CLIENTES.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd)
            else if (rSugServico.vCampoAd = 'NOME_VENDEDOR') then
              rSugServico.vsqlAdicional := 'COLABORADOR.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd)
            else if (rSugServico.vCampoAd = 'DESCRICAO_TP') then
            	rSugServico.vsqlAdicional := '((EQUIPAMENTO.NOM_EQUIP ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + ') OR '+
               ' (VEICULOS.DESCMODELO ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd) + '))'
            else if (rSugServico.vCampoAd = 'HORA_CAD') then
              rSugServico.vsqlAdicional := 'SUGESTAOSERVICO.HORA_CAD ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd)
            else
              rSugServico.vsqlAdicional := 'SUGESTAOSERVICO.' + rSugServico.vCampoAd + ' ' + rSugServico.vCondicaoAd + ' ' + QuotedStr(rSugServico.vValorAd);
          end
          else
          begin
            if (rSugServico.vCampoAd = 'ANOFAB') or (rSugServico.vCampoAd = 'ANOMOD') then
              rSugServico.vsqlAdicional := 'VEICULOS.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%')
            else if (rSugServico.vCampoAd= 'CODIGO_UF') or (rSugServico.vCampoAd= 'COD_CIDADE') or (rSugServico.vCampoAd= 'COD_BAIRRO') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR '+
								' (CLIENTES.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ')) '
            else if (rSugServico.vCampoAd= 'SIGLA_UF') then
              rSugServico.vsqlAdicional := '((EST.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(ESTADOS.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd= 'NOME_CIDADE') then
              rSugServico.vsqlAdicional := '((CID.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CIDADES.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd= 'NOME_BAIRRO') then
              rSugServico.vsqlAdicional := '((BAI.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(BAIRROS.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd= 'CEP') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.CEP_VENDEDOR LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.CEP LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd= 'ENDERECO') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.END_VENDEDOR LIKE' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.ENDERECO LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd = 'NOME_CLIENTE') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.NOME_VENDEDOR LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.NOME_CLIENTE LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd = 'RAZAO') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.NOME_VENDEDOR LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.RAZAO LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd = 'FONE_CLIENTE') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.FONE_VENDEDOR LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.FONE_CLIENTE LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd = 'EMAIL') then
            	rSugServico.vsqlAdicional := '((COLABORADOR.EMAIL LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
                '(CLIENTES.EMAIL LIKE ' + QuotedStr(rSugServico.vValorAd + '%') + '))'
            else if (rSugServico.vCampoAd = 'NUM_END_CLIENTE') then
              rSugServico.vsqlAdicional := 'CLIENTES.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%')
            else if (rSugServico.vCampoAd = 'NOME_VENDEDOR') then
              rSugServico.vsqlAdicional := 'COLABORADOR.' + rSugServico.vCampoAd + ' LIKE ' + QuotedStr(rSugServico.vValorAd + '%')
		        else if (rSugServico.vCampoAd = 'DESCRICAO_TP') then
              rSugServico.vsqlAdicional := '((EQUIPAMENTO.NOM_EQUIP LIKE' + QuotedStr(rSugServico.vValorAd + '%') + ') OR ' +
