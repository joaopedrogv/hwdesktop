      frmCadConciliacaoTipoLanc.ShowModal
    else if (not frmCadConciliacaoTipoLanc.Visible) then
      frmCadConciliacaoTipoLanc.Show
    else if frmCadConciliacaoTipoLanc.FormStyle = fsMDIChild then
      frmCadConciliacaoTipoLanc.Show
    else
      frmCadConciliacaoTipoLanc.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

