function TFeriado.E_DiaUtil(AData: TDateTime): string;
var
  AE_Feriado: string;
begin
  ///  Caso queira usar o turno da tabela de feriados ainda deve ser implementado
  ///  passar parametro para testar o turno
  AE_Feriado := E_Feriado(AData);
  if AE_Feriado <> 'false' then
  begin
    Result := AE_Feriado;
    Exit;
  end;

  Result := 'true';

  case DayOfWeek(AData) of
    1:  Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Domingo';
    7:  Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Sábado';
  end;
end;

function TFeriado.E_Feriado(AData: TDateTime): string;
var
  AEnum: EnumFeriados;
  AFeriado: TDate;
  AQuery: TIBQuery;
begin
  ///  Caso queira usar o turno da tabela de feriados ainda deve ser implementado
  ///  passar parametro para testar o turno
  Result := 'false';
  if      DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 01, 01)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Confraternização Universal'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 04, 21)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Tiradentes'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 05, 01)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Dia do Trabalhador'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 09, 07)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Independência'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 10, 12)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Nossa Senhora Aparecida'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 11, 02)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Finados'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 11, 15)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Proclamação da República'
  else if DateOf(AData) = DateOf(EncodeDate(YearOf(AData), 12, 25)) then
    Result := FormatDateTime('DD/MM/YYYY', AData) + ' - Natal'
  else
  begin
    for AEnum := Low(EnumFeriados) to High(EnumFeriados) do
    begin
      AFeriado := CalculaFeriado(MonthOf(AData), AEnum);
      if DateOf(AFeriado) = DateOf(AData) then
      begin
        Result := FormatDateTime('DD/MM/YYYY', AData) + ' - ' +
                    StringReplace(
                      StringReplace(
                        GetEnumName(TypeInfo(EnumFeriados), Integer(AEnum)), 'fr_', '',[]), '_', ' ', [rfReplaceAll]);
        Exit;
      end;
    end;

    try
      AQuery := TIBQuery.Create(buscas.Owner); AQuery.Database := buscas.Database; AQuery.Transaction := buscas.Transaction;

      AQuery.Close;
      AQuery.SQL.Text := 'select data_feriado, descr_feriado, turno from FERIADO' +
        ' where data_feriado = :data_feriado and ativo = 1';
      AQuery.ParamByName('data_feriado').AsDate := DateOf(AData);
      AQuery.Open;

      if DateOf(AQuery.FieldByName('data_feriado').AsDateTime) = DateOf(AData) then
        Result := FormatDateTime('DD/MM/YYYY', AData) + ' - ' + Trim(AQuery.FieldByName('descr_feriado').AsString);
      AQuery.Close;
    finally
      FreeAndNil(AQuery);
    end;
  end;
end;

