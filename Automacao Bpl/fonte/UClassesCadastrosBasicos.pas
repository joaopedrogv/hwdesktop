function TConciliacaoTipoLanc.Delete: boolean;
var
	vId: Integer;
  vDescricao: string;
begin
	Result := False;
  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  try
  	vId := dataSet.FieldByName('ID').AsInteger;
    vDescricao := trim(dataSet.FieldByName('DESCRICAO').AsString);

    prepare_loop('SEL = ''S''');
    if not dataset.IsEmpty then
    begin
    	vId := 0;
      vDescricao := '';
    end;
  finally
    prepare_loop_done;
  end;

  try
  	try
      if vId > 0 then
        prepare_loop('ID = ' + IntToStr(vId))
      else
        prepare_loop('SEL = ''S''');

      if vId > 0 then
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja remover tipo de lançamento (Nº Conta Entrada / Nº Conta Saída) deste código de ajuste?' + #13 + #13 +
          'TIPO DE LANÇAMENTO' + #13 +
          'Id: ' + IntToStr(vId) + #13+
          'Descrição: ' + trim(vDescricao)),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
            Exit;
      end
      else
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja remover tipo de lançamento (Nº da Conta Entrada / Nº da Conta Saída) dos códigos de ajuste ' + IntToStr(dataSet.RecordCount) + ' contratos selecionados?'),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          Exit;
      end;

      if not vDadosIni.PesqPros('BAS527', 'EXCLUIR', '', 'CONCILIACAO_TIPO_LANC', '', buscas, true) then
        Exit;

      try
        dataset.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Remover nº das contas (Nº da Conta Entrada / Nº da Conta Saída)  (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          buscas.Close;
          buscas.SQL.Text := ' update conciliacao_tipo_lanc set n_conta_plc_e = null, n_conta_plc_s = null ' +
            ' where id = :id ';
          buscas.ParamByName('id').AsInteger := dataSet.FieldByName('id').AsInteger;
          buscas.ExecSQL;

          vDadosIni.GravaAuditoria('BAS527', 'EXCLUIR', '', 'CONCILIACAO_TIPO_LANC',
            dataSet.FieldByName('ID').AsString, buscas);

          dataset.Next;
        end;
      finally
        dataset.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    CommitaTransacao;

    Result := True;

    if Result then
      vDadosIni.GravaAuditoria('BAS527', 'EXCLUIR', 'SUCESSO', 'CONCILIACAO_TIPO_LANC', '', buscas);

	  dataSet.Refresh;

	except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('BAS527', 'EXCLUIR', 'FALHA', 'CONCILIACAO_TIPO_LANC',
      	vDadosIni.IfThen(vId > 0, IntToStr(vId), ''), buscas);
      Application.MessageBox(pchar('Erro ao excluir contrato. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

