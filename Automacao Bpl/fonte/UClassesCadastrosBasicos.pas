procedure TEmpresa.atualizarTabelaCodigo(CodEmpresa: Integer);
var
  query: TIBQuery;
  vCodigo: Integer;
begin
  query := TIBQuery(DtmCadBasicos.qrBuscas);
  
  query.Close;
  query.SQL.Text := 'select * from codigo ' +
  	' where tabela = :tabela and cod_empresa = :cod_empresa ';
  query.ParamByName('TABELA').AsString := 'DEVOLUCAO';
  query.ParamByName('COD_EMPRESA').AsInteger := CodEmpresa;
  query.Open;

  if not query.IsEmpty then
  begin
    buscas.Close;
    buscas.SQL.Text := ' UPDATE CODIGO SET  VALOR = :VALOR ' +
    	' WHERE TABELA = :TABELA AND COD_EMPRESA = :COD_EMPRESA AND VALOR < 100000 ';
    buscas.ParamByName('TABELA').AsString := 'DEVOLUCAO';
    buscas.ParamByName('COD_EMPRESA').AsInteger := CodEmpresa;
    buscas.ParamByName('VALOR').AsFloat := 100000;
    buscas.ExecSQL;
  end
  else
  begin
    buscas.Close;
    buscas.SQL.Text := ' SELECT GEN_ID(GENCODIGO, 1) AS VALOR FROM RDB$DATABASE ';
    buscas.Open;

    vCodigo := buscas.FieldByName('VALOR').AsInteger;

    buscas.Close;
    buscas.SQL.Text := ' INSERT INTO CODIGO (TABELA, COD_EMPRESA, CODIGO, VALOR, ATIVO) ' +
    	' VALUES (:TABELA, :COD_EMPRESA, :CODIGO, :VALOR, :ATIVO) ';
    buscas.ParamByName('TABELA').AsString := 'DEVOLUCAO';
    buscas.ParamByName('COD_EMPRESA').AsInteger := CodEmpresa;
    buscas.ParamByName('CODIGO').AsInteger := vCodigo;
    buscas.ParamByName('VALOR').AsFloat := 100000;
    buscas.ParamByName('ATIVO').AsInteger := 1;
    buscas.ExecSQL;
  end;
  query.Close;
  CommitaTransacao;
end;

function TEmpresa.AtualizarTipoPreco: boolean;
var
  i: integer;
  localidade, setor, cidade: string;
begin

  if ((obEmpresa.sTipoPreco[0] = obEmpresa.sTipoPrecoN[0]) and
    (obEmpresa.sTipoPreco[1] = obEmpresa.sTipoPrecoN[1]) and
    (obEmpresa.sTipoPreco[2] = obEmpresa.sTipoPrecoN[2])) then
    exit;

  //Localidade
  if (obEmpresa.sTipoPrecoN[0] = 'LOCALIDADE') then
    localidade := '1'
  else if (obEmpresa.sTipoPrecoN[1] = 'LOCALIDADE') then
    localidade := '2'
  else if (obEmpresa.sTipoPrecoN[2] = 'LOCALIDADE') then
    localidade := '3';
  //Setor
  if (obEmpresa.sTipoPrecoN[0] = 'SETOR') then
    setor := '1'
  else if (obEmpresa.sTipoPrecoN[1] = 'SETOR') then
    setor := '2'
  else if (obEmpresa.sTipoPrecoN[2] = 'SETOR') then
    setor := '3';
  //Cidade
  if (obEmpresa.sTipoPrecoN[0] = 'CIDADE') then
    cidade := '1'
  else if (obEmpresa.sTipoPrecoN[1] = 'CIDADE') then
    cidade := '2'
  else if (obEmpresa.sTipoPrecoN[2] = 'CIDADE') then
    cidade := '3';

  if (localidade <> '') then
    ExecutaComandosSqlExec('update promocao set ordem = ' + localidade +
      ' where cod_tppreco = 2 and cod_empresa= ' + vDadosIni.codEmpresa);
  if (setor <> '') then
    ExecutaComandosSqlExec('update promocao set ordem = ' + setor +
      ' where cod_tppreco = 3 and cod_empresa= ' + vDadosIni.codEmpresa);
  if (cidade <> '') then
    ExecutaComandosSqlExec('update promocao set ordem = ' + cidade +
      '  where cod_tppreco = 4 and cod_empresa= ' + vDadosIni.codEmpresa);

  transacao.Commit;
end;

