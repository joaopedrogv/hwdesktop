    MB_ICONQUESTION + MB_YESNO) <> IDYES then
    exit;
  if inherited delete then
  begin
    Apply;
    CommitaTransacao;
    vNitem := 0;
    dataSet.First;
    while not dataSet.Eof do
    begin
      Inc(vNitem);
      dataSet.Edit;
      dataSet.FieldByName('NITEM_NOP_DESC').AsInteger := vNitem;
      dataSet.Post;
      dataSet.Next;
    end;

    Apply;
    CommitaTransacao;
    Result := True;
