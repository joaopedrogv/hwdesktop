    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS255', 'CONSULTA', '', 'PERFIL_COMISSAO', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadMetasComissao = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadMetasComissao, frmCadMetasComissao);
    end;

    if (pTipoForm > 0) and (not frmCadMetasComissao.Visible) then
      frmCadMetasComissao.ShowModal
    else if (not frmCadMetasComissao.Visible) then
      frmCadMetasComissao.Show
    else if frmCadMetasComissao.FormStyle = fsMDIChild then
      frmCadMetasComissao.Show
    else
      frmCadMetasComissao.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

