function TExcecoesProc.imprimirExcecoesProcesso(pusuario: string): boolean;
var
  variavel_parar: boolean;
  vpag: Integer;
  linha: integer;
  vqtdeExc: Integer;
  vrel: string;
  vFiltrarVendedor: boolean;
  vusuario: string;

  procedure CabNovaPaginaExcecoes;
  begin
    //  if Rdp.UltimaPagina > 1 then
    if vpag > 0 then
      Rdp.Novapagina;
    Rdp.ImpF(linha, 1, vDadosIni.vEmp.vnomeEmpresa, [normal, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, 'EXCECOES DE PROCESSOS POR USUARIO', [normal, negrito]);

    if vFiltrarVendedor then
    begin
      linha := linha + 1;
      Rdp.ImpF(linha, 1, 'USUARIO: ' + trim(pusuario), [normal, negrito]);
    end;

    vpag := vpag + 1;
    Rdp.ImpF(linha, 116, 'PAG: ' + vDadosIni.StrZero(vpag, 3), [normal]);
    linha := linha + 1;
  end;

  procedure menuExcecoes;
  begin
    //Impressão do Menu.
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);

    linha := linha + 1;
    Rdp.ImpD(linha, 1, 'PROCESSO', [comp17, negrito]);
    Rdp.ImpD(linha, 32, 'DESCRICAO PROCESSO', [comp17, negrito]);
    Rdp.ImpD(linha, 79, 'USUARIO AUTORIZOU', [comp17, negrito]);
    Rdp.ImpD(linha, 92, 'NIVEL', [comp17, negrito]);
    Rdp.ImpD(linha, 110, 'SENHA GERENTE', [comp17, negrito]);
    Rdp.ImpD(linha, 130, 'DATA AUTORIZACAO', [comp17, negrito]);
    linha := linha + 1;
    Rdp.ImpF(linha, 1, vDadosIni.replicate('=', 132), [comp17]);
    linha := linha + 1;
  end;
begin
  if not vDadosIni.PesqPros('CFG053', 'IMPRIMIR', '', '', '', buscas, false) then
    Exit;
  inherited;

  vusuario := '';
  vFiltrarVendedor := Application.MessageBox(PChar('Exibir exceções de processos somente do usuário ' + trim(pusuario) + '?'),
      'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes;
      
  buscas.Close;
  buscas.SQL.Text := ' select tu.*, tb.nome_processo, tb.nivel_processo, coalesce(tb.senha_gerente, ''N'') senha_gerente from tabela_processos_usuarios tu ' +
    ' inner join tabela_processos tb on tb.cod_processo = tu.cod_processo and tb.cod_empresa = tu.cod_empresa ' +
    ' where tu.cod_empresa = ' + vDadosIni.codEmpresa;
  if vFiltrarVendedor then
    buscas.SQL.Text := buscas.SQL.Text + ' and tu.usuario = ' + QuotedStr(pusuario);
  buscas.SQL.Text := buscas.SQL.Text +  
    ' order by tu.usuario, tu.cod_processo ';
  buscas.Open;

  vpag := 0;
  vqtdeExc := 0;
  //Inicia a Impressão.
  if not vDadosIni.ModImp(Rdp) then
    exit;
  Rdp.FonteTamanhoPadrao := S17cpp;
  Rdp.TamanhoQteColunas := 132;
  Rdp.CaptionSetup := 'Configurações de Impressão';
  rdp.OpcoesPreview.CaptionPreview := 'Exceções de Processos por usuário';
  rdp.TitulodoRelatorio := 'Exceções de Processos por usuário';
  vDadosIni._LimparVarSendEmail;
  rdp.OnSendMail := vDadosini._SendMailRdPrint;
  rdp.OpcoesPreview.Preview := true;

  if not Rdp.EstaAberto then
    Rdp.Abrir;
  linha := 2;
  CabNovaPaginaExcecoes; //cabeçalho

  // Inicio da Impressão dos Itens.
  if vFiltrarVendedor then
    menuExcecoes;
  try
    Screen.Cursor := crHourGlass;
    buscas.FetchAll;
  finally
    Screen.Cursor := crDefault;
    vDadosIni.abreStatusProcessamento('', 'Abrindo Impressão Exceções de Processos por usuário: 0/' + IntToStr(buscas.RecordCount));
    buscas.First;
  end;

  while not buscas.eof do
  begin
    Application.ProcessMessages;
    try
      if (not vFiltrarVendedor) and (trim(vusuario) <> trim(Buscas.FieldByName('usuario').AsString)) then
      begin
        if trim(vusuario) <> '' then
        begin
          Rdp.ImpD(linha, 1, 'QTDE EXCECOES USUARIO ' + trim(vusuario) + ': ' + IntToStr(vqtdeExc), [comp17, negrito]);
          linha := linha + 1;
        end;

        vqtdeExc := 0;
        linha := linha + 1;
        Rdp.ImpF(linha, 1, 'USUARIO: ' + trim(Buscas.FieldByName('usuario').AsString), [normal, negrito]);
        menuExcecoes;
      end;
      Rdp.Imp(linha, 1, Buscas.FieldByName('cod_processo').asstring);
      Rdp.Imp(linha, 14, Copy(trim(Buscas.FieldByName('nome_processo').AsString), 1, 50));
      Rdp.ImpD(linha, 79, Buscas.FieldByName('usuario_autorizou').AsString, [comp17]);
      Rdp.ImpD(linha, 90, Buscas.FieldByName('nivel_processo').AsString, [comp17]);
      Rdp.ImpD(linha, 104, Buscas.FieldByName('senha_gerente').AsString, [comp17]);
      Rdp.ImpD(linha, 130, Buscas.FieldByName('data_autorizacao').AsString, [comp17]);
      linha := linha + 1;
      vqtdeExc := vqtdeExc + 1;
      vusuario := Buscas.FieldByName('usuario').AsString;
    except
    end;
    buscas.Next;
    vDadosIni.abreStatusProcessamento('', 'Abrindo Impressão Exceções de Processos por usuário: '+IntToStr(buscas.RecNo)+'/' + IntToStr(buscas.RecordCount));
    if linha >= 60 then
    begin
      Rdp.Imp(linha, 1, vDadosIni.Replicate('=', Rdp.TamanhoQteColunas));
      linha := 2;
      CabNovaPaginaExcecoes;
      if vFiltrarVendedor then
        menuExcecoes;
      if not vFiltrarVendedor then
        linha := linha + 1;
    end;
  end;
//  linha := linha + 1;
  Rdp.ImpD(linha, 1, 'QTDE EXCECOES USUARIO ' + trim(vDadosIni.IfThen(vFiltrarVendedor, pusuario, vusuario)) + ': ' + IntToStr(vqtdeExc), [comp17, negrito]);
  vDadosIni.GravaAuditoria('CFG053', 'IMPRIMIR', 'SUCESSO', '',  '', buscas);
  buscas.close;
  if Rdp.EstaAberto then
    Rdp.Fechar;
  vDadosIni.fechaStatusProcessamento;

end;

