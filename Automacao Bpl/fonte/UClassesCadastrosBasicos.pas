    dataSet.FieldByName('TIPO_PERFIL').AsString := dataSet.FieldByName('TIPO_PERFIL').AsString;
    dataSet.FieldByName('ABRANG_PERFIL').AsString := dataSet.FieldByName('ABRANG_PERFIL').AsString;
