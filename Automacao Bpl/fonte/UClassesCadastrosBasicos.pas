function TComissaoFaixaDesc.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS465', 'SALVAR', '', 'COMISSAO_FAIXA_DESCONTO',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
    	raiseExceptionCreate('Descrição do Perfil deve ser informado', 'DBEdit2');

    if trim(dataSet.FieldByName('TIPO').AsString) = '' then
    	raiseExceptionCreate('Tipo de comissão deve ser informado', 'DBComboBox1');

    if (trim(dataSet.FieldByName('TIPO').AsString) <> 'GERAL')
     and (trim(dataSet.FieldByName('TIPO').AsString) <> 'ESPECIFICA') then
    	raiseExceptionCreate('Tipo de comissão incorreto', 'DBComboBox1');

    if (acao = 'INSERIR') and (trim(dataSet.FieldByName('TIPO').AsString) = 'GERAL') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select codigo from comissao_faixa_desconto ' +
        ' where codigo <> ' + IntToStr(dataSet.FieldByName('codigo').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and tipo = ''GERAL'' ' +
        ' and ativo = 1 ';
      buscas.Open;
      if not buscas.IsEmpty then
        raiseExceptionCreate('Já existe uma regra ativa do tipo "GERAL" cadastrada', '');
    end;

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('CODIGO').AsInteger :=
        Gencodigo('COMISSAO_FAIXA_DESCONTO', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS465', acao, 'SUCESSO', 'COMISSAO_FAIXA_DESCONTO',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS465', acao, 'FALHA', 'COMISSAO_FAIXA_DESCONTO',
        dataSet.FieldByName('CODIGO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

