function TMarcas.abreMarcas: Boolean;
begin
  result := montaSelect('SELECT MARCA_PROD.*, MARCA_PROD_EC.ID_COMMERCE FROM MARCA_PROD ' +
  	' LEFT JOIN MARCA_PROD_EC ON MARCA_PROD_EC.COD_MARCA = MARCA_PROD.COD_MARCA AND MARCA_PROD_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
  	' WHERE MARCA_PROD.ATIVO = 1');
end;

function TMarcas.AbrirLixeira: boolean;
begin
  if not StatusLixeira then
  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    montaSelect(' SELECT MARCA_PROD.*, MARCA_PROD_EC.ID_COMMERCE FROM MARCA_PROD ' +
    	' LEFT JOIN MARCA_PROD_EC ON MARCA_PROD_EC.COD_MARCA = MARCA_PROD.COD_MARCA AND MARCA_PROD_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
    	' WHERE MARCA_PROD.ATIVO = 1 ');
    result := false;
  end
  else
    result := montaSelect(' SELECT MARCA_PROD.*, MARCA_PROD_EC.ID_COMMERCE FROM MARCA_PROD ' +
    	' LEFT JOIN MARCA_PROD_EC ON MARCA_PROD_EC.COD_MARCA = MARCA_PROD.COD_MARCA AND MARCA_PROD_EC.COD_EMPRESA = ' + vDadosIni.codEmpresa +
    	' WHERE MARCA_PROD.ATIVO = 0 ');
end;

procedure TMarcas.CadMarcas(TipoForm: integer);
begin
	try
  	vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Marcas');
    vDadosIni.vTipoForm := TipoForm;
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
    if FrmCadMarcas = nil then
    begin
      vDadosIni.vTipoForm := TipoForm;
      if TipoForm > 0 then
        vDadosIni.vModalOuChild := 'M'
      else
        vDadosIni.vModalOuChild := 'C';
      Application.CreateForm(TFrmCadMarcas, FrmCadMarcas);
    end;

    if (TipoForm > 0) and (not FrmCadMarcas.Visible) then
      FrmCadMarcas.ShowModal
    else if (not FrmCadMarcas.Visible) then
      FrmCadMarcas.Show
    else if FrmCadMarcas.FormStyle = fsMDIChild then
      FrmCadMarcas.Show
    else
      FrmCadMarcas.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

