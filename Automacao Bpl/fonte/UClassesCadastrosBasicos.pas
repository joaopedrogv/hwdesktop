{ TPerfilComissaoConteudo }

function TPerfilComissaoConteudo.CheckUnCheckAllRows(Acheck: Boolean;
  AFieldName: string): TDataSet_OOP;
begin
  Result := Self;
  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  prepare_loop(Format('trim(sel) %s ''Z'' ', [IfThen(Acheck, '=', '<>')]));

  try
    if not Acheck then
      Index := 0;

    while not dataSet.IsEmpty do
    begin
      fdata(AFieldName).AutoPut(IfThen(Acheck, PadL(Index, 11), 'Z'));
      Index := Index + 1;
    end;

  finally
    prepare_loop_done();
  end;
end;

function TPerfilComissaoConteudo.CheckUnCheckRow(
  AFieldName: string): TDataSet_OOP;
begin
  Result := Self;
  if dataSet.IsEmpty then
    Exit;

  storeRecNo;
  try
    fdata(AFieldName).AutoPut(IfThen(fequals('sel', 'Z'), PadL(Index, 11), 'Z'));
    Index := Index + 1;
  finally
    restoreRecNo;
  end;
end;

function TPerfilComissaoConteudo.Conteudo(selecao: string): TPerfilComissaoConteudo;
var
  value, startValues: string;
  arrayValores: ArrayString;
begin
  Result       := Self;
  selecao      := Trim(selecao);

  if FSelecionado = selecao then
    Exit;

  startValues  := IfThen((selecao <> FstartSelect), '', Trim(StrReplace(FstartValue, [sLineBreak, '(', ')'], ',')));
  startValues  := IfThen(Trim(startValues) = '', '-1', startValues);
  FSelecionado := selecao;

  if MatchText(selecao, ['Tipo Serviço', 'Tipo de Segmentação']) then
    ClientOpen('select ''Z          '' sel, cod_servico codigo, desc_servico descricao from tipo_servico' +
               ' where coalesce(cod_empresa, %d) = %d %s' +
               ' and ((ativo = 1) or (cod_servico in (%s)))' +
               ' order by desc_servico',
               [vDadosIni.cod_empresa, vDadosIni.cod_empresa,
                IfThen(selecao = 'Tipo de Segmentação', ' and stipo = ''S'''),
                startValues])
  else if selecao = 'Grupo Produto' then
    ClientOpen('select ''Z          '' sel, codigo_grup codigo, descricao from grupos' +
               ' where ((ativo = 1) or (codigo_grup in (%s)))' +
               ' order by descricao', [startValues])
  else if selecao = 'Controle Caixa' then
    ClientOpen('select ''Z          '' sel, codigo_ctrl codigo, nome_ctrl descricao from controles' +
               ' where compsaldo = ''S'' and codigo_emp = %d' +
               ' and ((ativo = 1) or (codigo_ctrl in (%s)))' +
               ' order by nome_ctrl', [vDadosIni.cod_empresa, startValues])
  else if selecao = 'Tipo Venda' then
    ClientOpen('select ''Z          '' sel, descricao codigo, descricao from tipo_vendas' +
               ' where venda = ''S'' order by descricao')
  else
  begin
    dataSet.Close;
    Exit;
  end;

  dataSet.FieldByName('codigo').Visible := selecao <> 'Tipo Venda';
  dataSet.FieldByName('sel').Visible := False;

  Index := 0;
  arrayValores := NewArrayString(startValues);
  prepare_loop();
  try
    for value in arrayValores do
      if not filterStr('codigo = %s', [IfThen(selecao = 'Tipo Venda', QuotedStr(value), value)]).IsEmpty then
      begin
        fdata('sel').AutoPut(PadL(Index, 11));
        Index := Index + 1;
      end;

  finally
    IndexFieldNames := 'sel;descricao';
    prepare_loop_done();
  end;
end;

function TPerfilComissaoConteudo.GetValores: string;
begin
  Result := '';

  if not dataSet.Active then
    Exit;

  prepare_loop();//'SEL <> ''Z''');//.IndexFieldNames := 'SEL';//.dataSet.IndexName := 'IdxSel'; //.IndexFieldNames := 'SEL';
  try
    dataSet.First;
    while not dataSet.Eof do
    begin
      if fdif('sel', 'Z') then
        Result := Result + IfThen(Result <> '', sLineBreak) + fstr('codigo');

      dataSet.Next;
    end;
  finally
    prepare_loop_done;
  end;
end;

function TPerfilComissaoConteudo.Init(selecao,
  startValue: string): TPerfilComissaoConteudo;
begin
  FSelecionado := '';
  FstartSelect := Trim(selecao);
  FstartValue  := startValue;
  Result       := Conteudo(FstartSelect);
end;

{ TImagensDoc }

function TImagensDoc.abreImagem(
	pCodigo: Integer;
  pCodEmpresa: Integer;
  pTipo: string;
  pGrupoProd: Integer = 0;
  pCodProd: string = '';
  pCodGrade: Integer = 0): boolean;
begin
	if trim(pTipo) = 'CTP' then
    Result := montaSelect('	select imagens_doc.* from contas_a_pagar_imagens ' +
      ' inner join imagens_doc on ' +
      '			imagens_doc.cod_img = contas_a_pagar_imagens.cod_img ' +
      '     and imagens_doc.cod_empresa = contas_a_pagar_imagens.cod_empresa ' +
      ' where contas_a_pagar_imagens.cod_contrp = ' + IntToStr(pCodigo) +
      ' and contas_a_pagar_imagens.cod_empresa = ' + IntToStr(pCodEmpresa))
  else
  	Result := montaSelect('	select imagens_doc.* from lote_lanc_imagens ' +
      ' inner join imagens_doc on ' +
      '			imagens_doc.cod_img = lote_lanc_imagens.cod_img ' +
      '     and imagens_doc.cod_empresa = lote_lanc_imagens.codigo_emp ' +
      ' where lote_lanc_imagens.n_lote = ' + IntToStr(pCodigo) +
      ' and lote_lanc_imagens.codigo_emp = ' + IntToStr(pCodEmpresa));
end;

function TImagensDoc.adicionarImagem(
	pCodigo: Integer;
  pCodEmpresa: Integer;
  pTipo: string;
  var pImagensOrigem: string;
  var pImagensDestino: string;
  pSetPathPadrao: string;
  pGrupoProd: Integer = 0;
  pCodProd: string = '';
  pCodGrade: Integer = 0): string;
var
	vCodigoImg: Integer;
  buscas2: TIBQuery;
  vMD5: string;
  SearchRec: TSearchRec;
  compressao: Integer;
begin
	try
  	Result := pImagensDestino;

    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := buscas.Database;
	  buscas2.Transaction := buscas.Transaction;

    try
      if SysUtils.FindFirst(pImagensOrigem, faAnyFile, SearchRec) <> 0 then
        exit;

      if SearchRec.Size >= 1024000 then
        compressao := 30
      else if SearchRec.Size >= 300000 then
        compressao := 50
      else
        compressao := 100;
    finally
      SysUtils.FindClose(SearchRec);
    end;

    vCodigoImg := vDadosIni.verificaImagemBD(
    	buscas2,
      pCodEmpresa,
      compressao,
      pImagensOrigem,
      pImagensDestino);

    if vCodigoImg <= 0 then
    begin
      if not vDadosIni.SetJPGCompression(
        compressao,
        pImagensOrigem,
        pImagensDestino) then
          exit;

      Result := pImagensDestino;

      vMD5 := _getMd5File(pImagensDestino);
      if trim(pSetPathPadrao) <> '' then
        pImagensDestino := ExtractFileName(pImagensDestino);

      Result := pImagensDestino;

      vCodigoImg := Gencodigo('IMAGENS_DOC', DtmCadBasicos.SpIncCodigo, IntToStr(pCodEmpresa));

      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO IMAGENS_DOC ' +
        ' (COD_IMG, COD_EMPRESA, IMAGEM, MD5, US_CAD, DATA_CAD) ' +
        ' VALUES (:COD_IMG, :COD_EMPRESA, :IMAGEM, :MD5, :US_CAD, :DATA_CAD); ';
      buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
      buscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      buscas.ParamByName('IMAGEM').AsString := pImagensDestino;
      buscas.ParamByName('MD5').AsString := vMD5;
      buscas.ParamByName('US_CAD').AsInteger := vDadosIni.vCodUsuario;
      buscas.ParamByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas2);
      buscas.ExecSQL;
    end;

    if trim(pTipo) = 'CTP' then
    begin
    	buscas.Close;
      buscas.SQL.Text := ' SELECT COD_IMG FROM CONTAS_A_PAGAR_IMAGENS ' +
      	' WHERE COD_CONTRP = :COD_CONTRP ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ' +
        ' AND COD_IMG = :COD_IMG ';
      buscas.ParamByName('COD_CONTRP').AsInteger := pCodigo;
      buscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
      buscas.Open;

      if not buscas.IsEmpty then
      begin
      	Application.MessageBox(PChar('Imagem ' + trim(ExtractFileName(pImagensDestino)) +
        	' já foi adicionada a conta a pagar: ' + #13 + #13 +
          'CONTA A PAGAR' + #13 +
          'Código: ' + IntToStr(pCodigo) + #13 +
          'Cod Empresa: ' + IntToStr(pCodEmpresa) + #13 + #13 +
          'Favor verificar antes de continuar.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        exit;
      end;

      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO CONTAS_A_PAGAR_IMAGENS ' +
      	' (COD_CONTRP, COD_EMPRESA, COD_IMG) ' +
        ' VALUES (:COD_CONTRP, :COD_EMPRESA, :COD_IMG); ';
      buscas.ParamByName('COD_CONTRP').AsInteger := pCodigo;
      buscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
      buscas.ExecSQL;
    end
    else
    begin
    	buscas.Close;
      buscas.SQL.Text := ' SELECT COD_IMG FROM LOTE_LANC_IMAGENS ' +
      	' WHERE N_LOTE = :N_LOTE ' +
        ' AND CODIGO_EMP = :CODIGO_EMP ' +
        ' AND COD_IMG = :COD_IMG ';
      buscas.ParamByName('N_LOTE').AsInteger := pCodigo;
      buscas.ParamByName('CODIGO_EMP').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
      buscas.Open;

    	if not buscas.IsEmpty then
      begin
      	Application.MessageBox(PChar('Imagem ' + trim(ExtractFileName(pImagensDestino)) +
        	' já foi adicionada ao lote: ' + #13 + #13 +
          'LOTE' + #13 +
          'Código: ' + IntToStr(pCodigo) + #13 +
          'Cod Empresa: ' + IntToStr(pCodEmpresa) + #13 + #13 +
          'Favor verificar antes de continuar.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        exit;
      end;

      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO LOTE_LANC_IMAGENS ' +
      	' (N_LOTE, CODIGO_EMP, COD_IMG) ' +
        ' VALUES (:N_LOTE, :CODIGO_EMP, :COD_IMG); ';
      buscas.ParamByName('N_LOTE').AsInteger := pCodigo;
      buscas.ParamByName('CODIGO_EMP').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := vCodigoImg;
      buscas.ExecSQL;
    end;

    CommitaTransacao;
    Refresh;
  except
    on e: Exception do
    begin
      Result := '';
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

constructor TImagensDoc.create;
begin
	if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
