function TEstados.Insert: boolean;
begin
  result := inherited Insert;
  if result then
    PreencheCampos;
end;

function TEstados.post: boolean;
var
  acao: string;
begin
  try
    campocomerro := '';
    Result := false;
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if Trim(Estado.dataSet.FieldByName('NOME_UF').AsString) = '' then
      raiseExceptionCreate('O campo do nome do estado não pode ser vazio.' + chr(13) +
        'Favor corrigir.', 'DBEdit2')
    else if trim(dataSet.FieldByName('SIGLA_UF').AsString) = '' then
    	raiseExceptionCreate('Descrição da UF não informada', 'DBEdit3')
    else if length(trim(dataSet.FieldByName('SIGLA_UF').asstring)) <> 2 then
      raiseExceptionCreate('Preenchimento incorreto do campo UF.' + chr(13) + 'Favor corrigir.', 'DBEdit3')
    else if dataSet.FieldByName('ALIQ_INTRA').IsNull then
      raiseExceptionCreate('Alíquota interna de ICMS do Estado não informada.','DBEdit5')
    else
    begin
      if acao = 'EDITAR' then
      begin
        if trim(dataSet.FieldByName('SIGLA_UF').OldValue) <>
          trim(dataSet.FieldByName('SIGLA_UF').NewValue) then
          if ExecutaComandosSql('select CODIGO_UF from ESTADOS where SIGLA_UF = ' +
            quotedstr(dataSet.FieldByName('SIGLA_UF').AsString)) then
          		raiseExceptionCreate('Já existe um estado cadastrado com a UF informada!', 'DBEdit3');
      end
      else if ExecutaComandosSql('select CODIGO_UF from ESTADOS where SIGLA_UF = ' +
        quotedstr(dataSet.FieldByName('SIGLA_UF').AsString)) then
      		raiseExceptionCreate('Já existe um estado cadastrado com a UF informada!', 'DBEdit3');
    end;

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_ESTADO,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('CODIGO_UF').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_UF').AsString;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS043', acao, 'SUCESSO', 'ESTADOS',
        dataSet.FieldByName('SIGLA_UF').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS043', acao, 'FALHA', 'ESTADOS',
        dataSet.FieldByName('SIGLA_UF').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código do estado duplicado.' + chr(13) +
          'O código do estado será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        if dataSet.State <> dsInsert then
          Insert;
        dataSet.FieldByName('CODIGO_UF').AsVariant := null;
      end;
    end;
  end;

end;

