function TMarcas._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
begin
  result := true;
  rMarca.vSqlAdicional := '';
  rMarca.vValor   := Trim(rMarca.vValor);
  rMarca.vValorAd := Trim(rMarca.vValorAd);

  if rMarca.vAdicional then
  begin
    if rMarca.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rMarca.vDataIniAd);
      except
        rMarca.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rMarca.vDataFimAd);
      except
        rMarca.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rMarca.vDataIniAd <> '' then
          rMarca.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rMarca.vDataIniAd)));
        if rMarca.vDataFimAd <> '' then
          rMarca.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rMarca.vDataFimAd)));
      end;
    end
    else if rMarca.vValorAd = '' then
      exit;
    if rMarca.vCondicaoAd = 'Igual' then
      rMarca.vCondicaoAd := '='
    else if rMarca.vCondicaoAd = 'Maior' then
      rMarca.vCondicaoAd := '>'
    else if rMarca.vCondicaoAd = 'Maior ou Igual' then
      rMarca.vCondicaoAd := '>='
    else if rMarca.vCondicaoAd = 'Menor' then
      rMarca.vCondicaoAd := '<'
    else if rMarca.vCondicaoAd = 'Menor ou Igual' then
      rMarca.vCondicaoAd := '<='
    else if rMarca.vCondicaoAd = 'Diferente' then
      rMarca.vCondicaoAd := '<>'
    else if (rMarca.vCondicaoAd = 'Esta contido') then
      rMarca.vCondicaoAd := 'like'
    else if (rMarca.vCondicaoAd = 'Começa') then
      rMarca.vCondicaoAd := 'Começa'
    else
      rMarca.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rMarca.vCampoAd) then
        begin
          rMarca.vValorAd := ajustar_consulta_incasesensitive(DataSet.Fields[I], '', rMarca.vValorAd);
//          if rMarca.vCampo = rMarca.vCampoAd then
//          begin
//            rMarca.vsqlAdicional := '';
//            exit;
//          end;
          rMarca.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rMarca.vCondicaoAd = 'Começa') or (rMarca.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rMarca.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rMarca.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rMarca.vCondicaoAd := '=';
            rMarca.vValorAd := vDadosIni.trocaVirgulaPorPonto(rMarca.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (rMarca.vDataIniAd <> '') and (rMarca.vDataFimAd <> '') then
              rMarca.vSqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd +
                ' >= ' + rMarca.vDataIniAd + ' and ' + rMarca.vCampoAd + ' <= ' + rMarca.vDataFimAd
            else if (rMarca.vDataFimAd <> '') then
              rMarca.vsqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd +
                ' <= ' + rMarca.vDataIniAd
            else if (rMarca.vDataIniAd <> '') and (rMarca.vDataFimAd <> '') then
              rMarca.vsqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd +
                ' >= ' + rMarca.vDataIniAd;
            Break;
          end;
          if rMarca.vCondicaoAd = 'like' then
            rMarca.vsqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd +
              ' like ' + QuotedStr('%' +
              rMarca.vValorAd +
              '%')
          else if rMarca.vCondicaoAd = 'Começa' then
            rMarca.vsqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd +
              ' like ' +
              QuotedStr(rMarca.vValorAd + '%')
          else
            rMarca.vsqlAdicional := rMarca.vsqlAdicional + rMarca.vCampoAd + ' '
              + rMarca.vCondicaoAd + ' ' +
              QuotedStr(rMarca.vValorAd);

          if rMarca.vCondicaoAd <> 'Começa' then
          begin
            if rMarca.vCampoAd = 'ID_COMMERCE' then
              rMarca.vsqlAdicional := 'MARCA_PROD_EC.' + rMarca.vCampoAd + ' ' + rMarca.vCondicaoAd + ' ' + QuotedStr(rMarca.vValorAd)
            else
              rMarca.vsqlAdicional := 'MARCA_PROD.' + rMarca.vCampoAd + ' ' + rMarca.vCondicaoAd + ' ' + QuotedStr(rMarca.vValorAd);
          end
          else
          begin
            if rMarca.vCampoAd = 'ID_COMMERCE' then
              rMarca.vsqlAdicional := 'MARCA_PROD_EC.' + rMarca.vCampoAd + ' LIKE ' + QuotedStr(rMarca.vValorAd + '%')
            else
              rMarca.vsqlAdicional := 'MARCA_PROD.' + rMarca.vCampoAd + ' LIKE' + QuotedStr(rMarca.vValorAd + '%');
          end;

          Break;
        end;
      end;
    end;
  end;

  tempSql := '';

  if Trim(rMarca.vValor) <> '' then
    for I := 0 to dataSet.FieldCount - 1 do
      if Dataset.Fields[I].FieldKind = fkData then
        if ContainsText(dataset.Fields[I].DisplayName, rMarca.vCampo) then
        begin
          rMarca.vValor := ajustar_consulta_incasesensitive(DataSet.Fields[I], '', rMarca.vValor);
          Break;
        end;

  if rMarca.vCampo = 'Id Commerce' then
    tempSql := 'MARCA_PROD_EC.ID_COMMERCE ';
  if tempSql  <> '' then
  begin
    if rMarca.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rMarca.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rMarca.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rMarca.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rMarca.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rMarca.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rMarca.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rMarca.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + rMarca.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(rMarca.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(rMarca.vValor);
    rMarca.vValor := '';
    if Trim(rMarca.vSqlAdicional) <> '' then
      rMarca.vSqlAdicional := rMarca.vSqlAdicional + ' and ' + tempSql
    else
      rMarca.vSqlAdicional := tempSql;
  end;
end;

procedure TMarcas._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
