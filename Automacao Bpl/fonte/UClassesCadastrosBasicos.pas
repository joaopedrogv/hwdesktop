procedure TCidades.switchZFM;
begin
  if fint('IBGE_COD_CIDADE') = 0 then
  begin
    ShowAtencao('Essa cidade não possui um código IBGE');
    Exit;
  end;

  if ShowConfirmacao('Deseja mesmo alternar a cidade como Zona Franca de Manaus ou Área de Livre Comércio?') <> IDYES then
    Exit;

  if not vDadosIni.PesqPros('BAS055', 'EDITANDO CIDADE IBGE', '', 'CIDADES', fstr('IBGE_COD_CIDADE'), buscas, true) then
    Exit;

  SqlExec('update CIDADES_IBGE set ZFM_ALC = iif(ZFM_ALC = ''S'', ''N'', ''S'')' +
          ' where CODIGO_MUN_IBGE = %d', [fint('IBGE_COD_CIDADE')]).Transaction.Commit;

  vDadosIni.GravaAuditoria('BAS060', 'ALTERAR ZFM', 'SUCESSO', 'CIDADES', fstr('IBGE_COD_CIDADE'), buscas);

  dataSet.Refresh;
end;

