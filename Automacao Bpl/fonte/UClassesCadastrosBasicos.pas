      '  where rctrl.cod_regravnd = ' + IntToStr(dataSet.FieldByName('COD_REGRAVND').AsInteger) +
      '  and rv.cod_empresa = ' + vDadosIni.codEmpresa +
      '  and ctrl.codigo_ctrl = rctrl.codigo_ctrl ' +
      ' ) as cod_regravnd from controles ctrl ' +
      ' where ctrl.codigo_emp = ' + vDadosIni.codEmpresa +
      ' and ctrl.cxent = ''S'' ' +
      ' and ctrl.ativo = 1 ' +
      ' order by 3 desc, ctrl.qseqperf ';
