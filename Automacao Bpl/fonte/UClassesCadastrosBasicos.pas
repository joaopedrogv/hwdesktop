        if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        begin
          if Edit then
          begin
            dataSet.FieldByName('ATIVO').asinteger := 0;
            if inherited post then
              if Apply then
                if CommitaTransacao then
                begin
                  vDadosIni.GravaAuditoria('BAS030', 'ENVIAR LIXEIRA', 'SUCESSO', 'CFOP_MUD',
                    ' UFO = ' +
                    dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
                    dataSet.FieldByName('UF_DESTINO').AsString, buscas);
                  //                  vDadosIni.GravaAuditoria('BAS030', ' UFO = ' +
                  //                    dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
                  //                    dataSet.FieldByName('UF_DESTINO').AsString + ' Sucesso ao Enviar para Lixeira',
                  //                    buscas);
                  result := true;
                end;
          end;
          if not result then
          begin
            vDadosIni.GravaAuditoria('BAS030', 'ENVIAR LIXEIRA', 'FALHA', 'CFOP_MUD', ' UFO = ' +
              dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
              dataSet.FieldByName('UF_DESTINO').AsString, buscas);
            //            vDadosIni.GravaAuditoria('BAS030', ' UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString
            //              + ' UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString +
            //              ' Falha ao Enviar para Lixeira', buscas);
            Cancel;
            RollBackTransacao;
          end;
        end;
  except
    vDadosIni.GravaAuditoria('BAS030', 'ENVIAR LIXEIRA', 'FALHA', 'CFOP_MUD', ' UFO = ' +
      dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
      dataSet.FieldByName('UF_DESTINO').AsString, buscas);
    //    vDadosIni.GravaAuditoria('BAS030', ' UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString +
    //      ' UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString + ' Falha ao Enviar para Lixeira',
    //      buscas);
    RollBackTransacao;
  end;
  Refresh;
end;

function TCFOPMud.gravar: boolean;
begin
  try
    result := false;
    if jaexisteCadastro then
      if EditarRegistro then
        exit
      else
      begin
        Cancel;
        RollBackTransacao;
        result := true;
        exit;
      end;
    if Post then
    begin
      if dataSet.ChangeCount = 0 then
      begin
        Cancel;
        RollBackTransacao;
        result := true;
      end
      else
      begin
        if Apply then
          if CommitaTransacao then
          begin
            result := true;
            vDadosIni.GravaAuditoria('BAS033', 'GRAVAR', 'SUCESSO', 'CFOP_MUD', ' UFO = ' +
              dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
              dataSet.FieldByName('UF_DESTINO').AsString, buscas);
            //            vDadosIni.GravaAuditoria('BAS033', 'UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString
            //              +
            //              ' - UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString + ' SUCESSO', buscas);
          end
          else
            vDadosIni.GravaAuditoria('BAS033', 'GRAVAR', 'SUCESSO', 'CFOP_MUD', ' UFO = ' +
              dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
              dataSet.FieldByName('UF_DESTINO').AsString, buscas);
        //            vDadosIni.GravaAuditoria('BAS033', 'UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString
        //              +
        //              ' - UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString + ' FALHA', buscas);
        if result then
          Refresh
