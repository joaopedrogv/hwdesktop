    vDadosIni.GravaAuditoria('BAS260', 'EXCLUIR', 'SUCESSO', 'PERFIL_COMISSAO', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS260', 'EXCLUIR', 'FALHA', 'PERFIL_COMISSAO', vCodFormula, buscas);

