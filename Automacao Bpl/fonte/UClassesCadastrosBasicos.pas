function TTipoReserva.delete: boolean;
var
  codigo: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;
  codigo := dataSet.FieldByName('CODIGO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 0 then
  begin
    if not vDadosIni.PesqPros('BAS357', 'EXCLUIR', '', 'TIPO_RESERVA',
      '', buscas, false) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
    begin
      result := inherited Delete;
      if Result then
        result := Apply;
      if result then
        result := CommitaTransacao;
      if Result then
        vDadosIni.GravaAuditoria('BAS357', 'EXCLUIR', 'SUCESSO', 'TIPO_PENDENCIA', codigo, buscas)
      else
        vDadosIni.GravaAuditoria('BAS357', 'EXCLUIR', 'FALHA', 'TIPO_PENDENCIA', codigo, buscas);
      Refresh;
    end;
    exit;
  end;
  if not vDadosIni.PesqPros('BAS356', 'EXCLUIR', '', 'TIPO_RESERVA',
    '', buscas, false) then
    Exit;
  if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
  begin
    if inherited Edit then
    begin
      dataSet.FieldByName('ATIVO').asinteger := 0;
      result := inherited Post;
      if Result then
        result := Apply;
      if Result then
        result := CommitaTransacao;
      if Result then
        vDadosIni.GravaAuditoria('BAS356', 'ENVIAR REGISTRO PARA A LIXEIRA',
          'SUCESSO', 'TIPO_RESERVA', codigo, buscas)
      else
        vDadosIni.GravaAuditoria('BAS356', 'ENVIAR REGISTRO PARA A LIXEIRA ',
          'FALHA', 'TIPO_RESERVA', codigo, buscas);
    end;
  end;
  Refresh;
end;

function TTipoReserva.edit: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('BAS355', 'ALTERAR', '', 'TIPO_RESERVA',
    dataSet.FieldByName('CODIGO').AsString, buscas, false) then
    Exit;

  if inherited Edit then
    Result := True;
end;

function TTipoReserva.Insert: boolean;
begin
  result := inherited Insert;
  if result then
  begin
    dataSet.FieldByName('ATIVO').AsInteger := 1;
    dataSet.FieldByName('TIPO').AsString := 'VEI';
  end;
end;

function TTipoReserva.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS359', 'SALVAR', '', 'TIPO_RESERVA',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('TIPO_RES').AsString) = '' then
      raiseExceptionCreate('Tipo de Reserva não informado!', 'DBComboBox_Tipo');

    if (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'V')
     and (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'M')
     and (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'B')
     and (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'C')
     and (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'F')
     and (trim(dataSet.FieldByName('TIPO_RES').AsString) <> 'T') then
      raiseExceptionCreate('Tipo de Reserva não incorreto!', 'DBComboBox_Tipo');

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição não informada!', 'DBEdit_Descricao');

    if trim(dataSet.FieldByName('SIGLA').AsString) = '' then
      raiseExceptionCreate('Sigla não informada!', 'DBEdit_Sigla');

//    if (trim(dataSet.FieldByName('TIPO_RES').AsString) = 'M') then
//      if (trim(dataSet.FieldByName('RETIRAR_RESERVAS_VENC').AsString) = 'S') then
//        raiseExceptionCreate('Retirar reserva deve estar configurado como "N"!', 'DBComboBox_RetirarReservas');

    if not testarSigla(vMensagem) then
      raiseExceptionCreate(vMensagem, 'DBEdit_Sigla');

   if Pos(trim(dataSet.FieldByName('SIGLA').AsString), Copy(trim(dataSet.FieldByName('DESCRICAO').AsString), 1, 4)) = 0 then
      dataSet.FieldByName('DESCRICAO').AsString :=
        trim(dataSet.FieldByName('SIGLA').AsString) + ' - ' +
        trim(dataSet.FieldByName('DESCRICAO').AsString);  

    if dataSet.State in [dsInsert] then
    begin
      _VerificarCodigoAutoIncremento('GEN_TIPO_RESERVA', 'CODIGO', 'TIPO_RESERVA');
      vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO').AsString;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS359', acao, 'SUCESSO', 'TIPO_RESERVA',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS359', acao, 'FALHA', 'TIPO_RESERVA',
        dataSet.FieldByName('CODIGO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
      end;
    end;
  end;
end;

function TTipoReserva.testarSigla(var pMensagem: string): boolean;
begin
   Result := False;

   buscas.Close;
   buscas.SQL.Text := 'SELECT CODIGO, SIGLA FROM TIPO_RESERVA ' +
    ' WHERE TIPO = :TIPO AND SIGLA = :SIGLA ';
   buscas.ParamByName('TIPO').AsString := dataSet.FieldByName('TIPO').AsString;
   buscas.ParamByName('SIGLA').AsString := dataSet.FieldByName('SIGLA').AsString;
   buscas.Open;
   buscas.FetchAll;

   if buscas.IsEmpty then
   begin
     Result := true;
     exit;
   end;

   if dataSet.State = dsInsert then
   begin
     pMensagem :=  'Já existe outro tipo de reserva cadastrada com está sigla.';
     exit;
   end
   else if dataSet.State = dsEdit then
   begin
     buscas.First;
     while not buscas.Eof do
     begin
       if buscas.FieldByName('CODIGO').AsInteger <> dataSet.FieldByName('CODIGO').AsInteger then
       begin
        pMensagem :=  'Já existe outro tipo de reserva cadastrada com está sigla.';
        exit;
       end;
       buscas.Next;
     end;
   end;
   Result := True;

end;

