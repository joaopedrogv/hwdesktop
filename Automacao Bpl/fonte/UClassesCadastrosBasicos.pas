function TCEP.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not (DtmCadBasicos.dsAbreEstados.DataSet.FieldByName('NOME_UF').IsNull) then
      CEPs.dataSet.FieldByName('ESTADO').Value :=
        DtmCadBasicos.dsAbreEstados.DataSet.FieldByName('NOME_UF').Value;

    _VerificarCampos(2, acao, 'COD_CEP', 'COD_CORREIOS',
      'CEP', 'CEP não informado!',
      'Este CEP já está cadastrado!');

    _VerificarCampos(1, acao, 'COD_CEP', 'COD_ESTADO',
      'CEP', 'Estado não informado!', '');

    _VerificarCampos(1, acao, 'COD_CEP', 'COD_CIDADE',
      'CEP', 'Cidade não informada!', '');

    _VerificarCampos(1, acao, 'COD_CEP', 'COD_BAIRRO',
      'CEP', 'Bairro não informado!', '');

    _VerificarCampos(1, acao, 'COD_CEP', 'ENDERECO',
      'CEP', 'Logradouro não informado!', '');

    if acao = 'INSERIR' then
    begin
      _VerificarCodigoAutoIncremento('GEN_CEP_ID', 'COD_CEP', 'CEP');
      vDadosIni.vPesquisa := dataset.fieldbyname('COD_CORREIOS').AsString;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS153', acao, 'SUCESSO', 'CEP',
        dataSet.FieldByName('COD_CEP').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS153', acao, 'FALHA', 'CEP',
        dataSet.FieldByName('COD_CEP').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
        // dataSet.FieldByName('COD_CEP').AsVariant := null;
      end;
    end;
  end;

end;

