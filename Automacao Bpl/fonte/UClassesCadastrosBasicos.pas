function TConciliacaoTipoLanc.atualizarTipoLancEmLote: boolean;
var
	vIndexFieldNames: string;
	vIndexName: string;
  vRecNo: Integer;
	vId: Integer;
  vSQL: string;
  fTempTipoLancamentos: TClientDataSet;
begin
	vSQL := '';

	if not vDadosIni.PesqPros('BAS529', 'ATUALIZAR', '', 'CONCILIACAO_TIPO_LANC', '', buscas, False) then
    Exit;

	try
    try
    	vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum tipo de lançamento selecionado.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          dataSet.Refresh;
          exit;
        end;

        fTempTipoLancamentos := TClientDataSet.Create(nil);
        fTempTipoLancamentos.Close;
        fTempTipoLancamentos.FieldDefs.Clear;
        fTempTipoLancamentos.FieldDefs.Add('ID', ftInteger, 0, false);
        fTempTipoLancamentos.close;
        fTempTipoLancamentos.CreateDataSet;
        fTempTipoLancamentos.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
            vDadosIni.abreStatusProcessamento('', 'Atualizando tipos de lançamento (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempTipoLancamentos.Insert;
              fTempTipoLancamentos.FieldByName('ID').AsInteger := dataSet.FieldByName('ID').AsInteger;
              fTempTipoLancamentos.Post;
            end;

            dataSet.Next;
          end;

          vSQL := dataSet.CommandText;
        finally
          dataSet.EnableControls;
        end;
      finally
        dataSet.Filtered := False;
      end;

      if vHAB_NUM_CONTA_E then
      begin
//        if vNUM_CONTA_E <= 0 then
//          raiseExceptionCreate('Nº da Conta (Entrada) deve ser informado', 'EdNumContaE');

      	if vNUM_CONTA_E > 0 then
          if not ConciliacaoTipoLancPContasE.buscarNumConta(vNUM_CONTA_E) then
            raiseExceptionCreate('Nº da Conta (Entrada) não encontrado', 'EdNumContaE');

        if vNUM_CONTA_E > 0 then
          if not ConciliacaoTipoLancPContasE.buscarNumContaNatureza(vNUM_CONTA_E) then
            raiseExceptionCreate('Nº Conta (Entrada) não encontrado', 'EdNumContaE');
      end;

      if vHAB_NUM_CONTA_S then
      begin
//        if vNUM_CONTA_S <= 0 then
//          raiseExceptionCreate('Nº da Conta (Saída) deve ser informado', 'EdNumContaS');

      	if vNUM_CONTA_S > 0 then
          if not ConciliacaoTipoLancPContasS.buscarNumConta(vNUM_CONTA_S) then
            raiseExceptionCreate('Nº da Conta (Saída) não encontrado', 'EdNumContaS');

        if vNUM_CONTA_S > 0 then
          if not ConciliacaoTipoLancPContasS.buscarNumContaNatureza(vNUM_CONTA_S) then
            raiseExceptionCreate('Nº Conta (Saída) não encontrado', 'EdNumContaS');
      end;

     if (not vHAB_NUM_CONTA_E)
     	and (not vHAB_NUM_CONTA_S) then
      	raiseExceptionCreate('Nenhum opção selecionada!', '');

      try
        fTempTipoLancamentos.DisableControls;
        fTempTipoLancamentos.First;
        while not fTempTipoLancamentos.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Atualizando tipos de lançamento (' +
            IntToStr(fTempTipoLancamentos.RecNo) + '/' + IntToStr(fTempTipoLancamentos.RecordCount) + ')');

          _selecionaTipoLanc(fTempTipoLancamentos.FieldByName('ID').AsInteger);

          if not dataSet.IsEmpty then
          begin
          	vId := dataSet.FieldByName('ID').AsInteger;

            dataSet.Edit;

            if vHAB_NUM_CONTA_E then
            begin
            	if vNUM_CONTA_E > 0 then
              	dataSet.FieldByName('N_CONTA_PLC_E').AsFloat := vNUM_CONTA_E
              else
              	dataSet.FieldByName('N_CONTA_PLC_E').Value := Null;
            end;

            if vHAB_NUM_CONTA_S then
            begin
            	if vNUM_CONTA_S > 0 then
              	dataSet.FieldByName('N_CONTA_PLC_S').AsFloat := vNUM_CONTA_S
              else
              	dataSet.FieldByName('N_CONTA_PLC_S').Value := Null;
            end;

            dataSet.Post;

            if (not Apply) and (dataSet.ChangeCount > 0) then
            begin
              dataSet.CancelUpdates;
              RollBackTransacao;
              Result := False;

              dataSet.Close;
		    			dataSet.CommandText := vSQL;
					    dataSet.Open;

              Exit;
            end;

            vDadosIni.GravaAuditoria('BAS529', 'ATUALIZAR', '', 'CONCILIACAO_TIPO_LANC', IntToStr(vId), buscas);
          end;

          fTempTipoLancamentos.Next;
        end;
      finally
        fTempTipoLancamentos.EnableControls;
      end;

      Result := True;

      CommitaTransacao;

      if Result then
      	vDadosIni.GravaAuditoria('BAS529', 'ATUALIZAR',	'SUCESSO', 'CONCILIACAO_TIPO_LANC', '', buscas);

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      if Result then
      	dataSet.Refresh;
    finally
    	dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('BAS529', 'ATUALIZAR',	'FALHA', 'CONCILIACAO_TIPO_LANC', '', buscas);
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
		    dataSet.Close;
  	    dataSet.CommandText := vSQL;
	    	dataSet.Open;
    	end;

      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

constructor TConciliacaoTipoLanc.create;
begin
	if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsConciliacaoTiposLancamentos);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  ConciliacaoTipoLancPContasE := TConciliacaoTipoLancPContasE.Create;
