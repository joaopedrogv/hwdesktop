function TComissaoFaixaDescVig.post(pDataset: TDataSet): boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS471', 'SALVAR', '', 'COMISSAO_FAIXA_DESCONTO_VIG',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('DTINI_VIG').AsString) = '' then
    	raiseExceptionCreate('Data inicial vigência deve ser informada', 'DBEdit3');

    if trim(dataSet.FieldByName('DTFIM_VIG').AsString) = '' then
    	raiseExceptionCreate('Data final vigência deve ser informado', 'DBEdit4');

    if dataSet.FieldByName('DTINI_VIG').AsDateTime > dataSet.FieldByName('DTFIM_VIG').AsDateTime then
    	raiseExceptionCreate('Data inicial vigência não deve ser maior que data final', 'DBEdit3');

    buscas.Close;
    buscas.SQL.Text := 'select codigo from comissao_faixa_desconto_vig ' +
    	' where cod_vig <> ' + IntToStr(dataSet.FieldByName('cod_vig').AsInteger) +
      ' and codigo = ' + IntToStr(dataSet.FieldByName('codigo').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and :data >= dtini_vig ' +
      ' and :data <= dtfim_vig ';
    buscas.ParamByName('data').AsDateTime := dataSet.FieldByName('dtini_vig').AsDateTime;
    buscas.Open;
    if not buscas.IsEmpty then
      raiseExceptionCreate('Já existe o cadastro nesta data de vigência informada', 'DBEdit3');

    buscas.Close;
    buscas.SQL.Text := 'select codigo from comissao_faixa_desconto_vig ' +
      ' where cod_vig <> ' + IntToStr(dataSet.FieldByName('cod_vig').AsInteger) +
      ' and codigo = ' + IntToStr(dataSet.FieldByName('codigo').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and :data >= dtini_vig ' +
      ' and :data <= dtfim_vig ';
    buscas.ParamByName('data').AsDateTime := dataSet.FieldByName('dtfim_vig').AsDateTime;
    buscas.Open;
    if not buscas.IsEmpty then
      raiseExceptionCreate('Já existe o cadastro nesta data de vigência informada', 'DBEdit4');

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('COD_VIG').AsInteger :=
        Gencodigo('COMISSAO_FAIXA_DESCONTO_VIG', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS471', acao, 'SUCESSO', 'COMISSAO_FAIXA_DESCONTO_VIG',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS471', acao, 'FALHA', 'COMISSAO_FAIXA_DESCONTO_VIG',
        dataSet.FieldByName('CODIGO').AsString, buscas);

    if Result then
      _abreComissaoFaixaDescVig(
		  	pDataSet.FieldByName('codigo').AsInteger);

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TComissaoFaixaDescVig._abreComissaoFaixaDescVig(pCodigo: Integer): Boolean;
begin
	result := montaSelect(' select * from comissao_faixa_desconto_vig ' +
  	' where codigo = ' + IntToStr(pCodigo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by dtini_vig, dtfim_vig ');

  if dataSet.IsEmpty then
  begin
  	vComissaoFaixaDescPerc._abreComissaoFaixaDescPerc(
      0,
      0);

    if frmCadComissaoFaixaDesconto <> nil then
	    frmCadComissaoFaixaDesconto.GroupBox6.Caption := 'Intervalo de desconto';
  end
  else
  begin
    vComissaoFaixaDescPerc._abreComissaoFaixaDescPerc(
      dataSet.FieldByName('CODIGO').AsInteger,
      dataSet.FieldByName('COD_VIG').AsInteger);

    if frmCadComissaoFaixaDesconto <> nil then
      frmCadComissaoFaixaDesconto.GroupBox6.Caption :=
        'Intervalo de desconto' +
        ' (' + FormatDateTime('dd/mm/yyyy', DataSet.FieldByName('DTINI_VIG').AsDateTime) +
        ' á ' + FormatDateTime('dd/mm/yyyy', DataSet.FieldByName('DTFIM_VIG').AsDateTime) + ')';
  end;
