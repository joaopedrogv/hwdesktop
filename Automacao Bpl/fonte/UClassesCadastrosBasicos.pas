function TConciliacaoCodAjuste.Delete: boolean;
var
	vId: Integer;
  vDescricao: string;
begin
	Result := False;
  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  try
  	vId := dataSet.FieldByName('ID').AsInteger;
    vDescricao := trim(dataSet.FieldByName('DESCRICAO').AsString);

    prepare_loop('SEL = ''S''');
    if not dataset.IsEmpty then
    begin
    	vId := 0;
      vDescricao := '';
    end;
  finally
    prepare_loop_done;
  end;

  try
  	try
      if vId > 0 then
        prepare_loop('ID = ' + IntToStr(vId))
      else
        prepare_loop('SEL = ''S''');

      if vId > 0 then
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja remover código de ajuste (Nº Conta Entrada / Nº Conta Saída) deste código de ajuste?' + #13 + #13 +
          'CÓDIGO DE AJUSTE' + #13 +
          'Id: ' + IntToStr(vId) + #13+
          'Descrição: ' + trim(vDescricao)),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
            Exit;
      end
      else
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja remover código de ajuste (Nº da Conta Entrada / Nº da Conta Saída) dos códigos de ajuste ' + IntToStr(dataSet.RecordCount) + ' contratos selecionados?'),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          Exit;
      end;

      if not vDadosIni.PesqPros('BAS456', 'EXCLUIR', '', 'CONCILIACAO_COD_AJUSTE', '', buscas, true) then
        Exit;

      try
        dataset.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Remover nº das contas (Nº da Conta Entrada / Nº da Conta Saída)  (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          buscas.Close;
          buscas.SQL.Text := ' update conciliacao_cod_ajuste set n_conta_plc_e = null, n_conta_plc_s = null ' +
            ' where id = :id ';
          buscas.ParamByName('id').AsInteger := dataSet.FieldByName('id').AsInteger;
          buscas.ExecSQL;

          vDadosIni.GravaAuditoria('BAS456', 'EXCLUIR', '', 'CONCILIACAO_COD_AJUSTE',
            dataSet.FieldByName('ID').AsString, buscas);

          dataset.Next;
        end;
      finally
        dataset.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    CommitaTransacao;

    Result := True;

    if Result then
      vDadosIni.GravaAuditoria('BAS456', 'EXCLUIR', 'SUCESSO', 'CONCILIACAO_COD_AJUSTE', '', buscas);

	  dataSet.Refresh;

	except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('BAS456', 'EXCLUIR', 'FALHA', 'CONCILIACAO_COD_AJUSTE',
      	vDadosIni.IfThen(vId > 0, IntToStr(vId), ''), buscas);
      Application.MessageBox(pchar('Erro ao excluir contrato. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

