function TSenha.importarUsuarioOutraEmpresa: Boolean;
var
  vCodEmpPadrao, vCodColabPadrao: Integer;
  vCPFColabPadrao: string;
  I: Integer;

  procedure corrigirEmpPadraoUsuarioSelecionado;
  var
    vEmpP: Integer;
  begin
    buscas.Close;
    buscas.SQL.Text := 'select first 1 EMP_PADRAO from senhas' +
      ' where usuario = ' + QuotedStr(Trim(dataSet.FieldByName('usuario').AsString)) +
      ' and EMP_PADRAO > 0';
    buscas.Open;

    vEmpP := buscas.FieldByName('emp_padrao').AsInteger;

    if vEmpP = 0 then
      vEmpP := dataSet.FieldByName('COD_EMPRESA').AsInteger;

    buscas.Close;
    buscas.SQL.Text := 'update senhas set emp_padrao = ' + IntToStr(vEmpP) +
      ' where usuario = ' + QuotedStr(Trim(dataSet.FieldByName('usuario').AsString)) +
      ' and emp_padrao <> ' + IntToStr(vEmpP);
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := 'update senhas set emp_padrao = ' + IntToStr(vEmpP) +
      ' where usuario = ' + QuotedStr(Trim(dataSet.FieldByName('usuario').AsString)) +
      ' and emp_padrao is null';
    buscas.ExecSQL;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

  end;

begin
  Result := False;
  try
    if vEmp.dataSet.IsEmpty then
      raiseExceptionCreate('Nenhuma empresa selecionada','');

    if dataSet.IsEmpty then
      raiseExceptionCreate('Nenhum Usuário selecionado','');

    corrigirEmpPadraoUsuarioSelecionado;

    buscas.Close;
    buscas.SQL.Text := 'select * from senhas' +
      ' where cod_empresa = ' +  vDadosIni.codEmpresa +
      ' and usuario = ' + QuotedStr(dataSet.FieldByName('usuario').AsString);
    buscas.Open;

    if not buscas.IsEmpty then
      raiseExceptionCreate('Usuário selecionado já ativo para esta empresa','');

    buscas.Close;
    buscas.SQL.Text := 'select first 1 EMP_PADRAO from senhas' +
      ' where usuario = ' + QuotedStr(dataSet.FieldByName('usuario').AsString) +
      ' and EMP_PADRAO > 0';
    buscas.Open;

    if buscas.FieldByName('EMP_PADRAO').AsInteger > 0 then
      vCodEmpPadrao := buscas.FieldByName('EMP_PADRAO').AsInteger
    else
      vCodEmpPadrao := dataSet.FieldByName('COD_EMPRESA').AsInteger;

    buscas.Close;
    buscas.SQL.Text := 'select * from senhas' +
      ' where cod_empresa = ' +  IntToStr(vCodEmpPadrao) +
      ' and usuario = ' + QuotedStr(dataSet.FieldByName('usuario').AsString);
    buscas.Open;

    if buscas.FieldByName('ativo').AsInteger = 0 then
      if Application.MessageBox('Usuário padrão esta desativado. Deseja continuar mesmo assim?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + 64) <> IDYES then
        Exit;

    vCodColabPadrao := buscas.FieldByName('codigo').AsInteger;

    buscas.Close;
    buscas.SQL.Text := 'select cod_vendedor, NOME_VENDEDOR, CPF_VENDEDOR, ativo from colaborador' +
      ' where cod_vendedor = ' + IntToStr(vCodColabPadrao) +
      ' and cod_empresa = ' + IntToStr(vCodEmpPadrao);
    buscas.Open;

    if buscas.IsEmpty then
    begin
      if Application.MessageBox('Colaborador não encontrado no cadastro da empresa padrão. Deseja continuar mesmo assim?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + 64) <> IDYES then
        Exit;

    end
    else if buscas.FieldByName('ativo').AsInteger = 0 then
      if Application.MessageBox('Colaborador desativado na empresa padrão. Deseja continuar mesmo assim?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + 64) <> IDYES then
        Exit;

    vCPFColabPadrao := '';
    if Trim(buscas.FieldByName('CPF_VENDEDOR').AsString) <> '' then
      vCPFColabPadrao := Trim(buscas.FieldByName('CPF_VENDEDOR').AsString)
    else if Trim(buscas.FieldByName('CPF_VENDEDOR').AsString) = '' then
      if Application.MessageBox('Colaborador do usuário padrão sem CPF, sistema não pode entrar no cadastro desta empresa' +
        ' o colaborador correspondente. Deseja continuar mesmo assim?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + 64) <> IDYES then
        Exit;

    buscas.Close;
    buscas.SQL.Text := 'select * from senhas' +
      ' where cod_empresa = ' +  IntToStr(vCodEmpPadrao) +
      ' and usuario = ' + QuotedStr(dataSet.FieldByName('usuario').AsString);
    buscas.Open;

    vEmp.dataSet.AfterScroll := nil;

    dataSet.Insert;

    for I := 0 to dataSet.FieldCount - 1 do
      if buscas.FindField(dataSet.Fields[i].FieldName) <> nil then
        dataSet.FieldByName(dataSet.Fields[i].FieldName).Value :=
          buscas.FieldByName(dataSet.Fields[i].FieldName).Value;

    dataset.FieldByName('DATA_CAD_S').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataset.FieldByName('DATA_MOD_S').AsDateTime := dataset.FieldByName('DATA_CAD_S').AsDateTime;
    dataset.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    dataset.FieldByName('EMP_PADRAO').AsInteger := vCodEmpPadrao;

    if Trim(vCPFColabPadrao) <> '' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select first 1 cod_vendedor from colaborador' +
                         ' where CPF_VENDEDOR = ' + QuotedStr(vCPFColabPadrao) +
                         ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      if buscas.FieldByName('cod_vendedor').AsInteger > 0 then
        dataset.FieldByName('codigo').Value := buscas.FieldByName('cod_vendedor').AsInteger
      else
        dataset.FieldByName('codigo').Value := Null;
    end
    else
      dataset.FieldByName('codigo').Value := Null;
      
    Result := True;
    concluirImportacaoUsuarioOutraEmpresa;
    
  except on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TSenha.importarUsuarioOutraEmpresa. Erro: ' + e.Message);
    end;
  end;
end;

