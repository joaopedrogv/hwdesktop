function TModeloCartas.Insert: boolean;
var
	vhwcloudIA: boolean;
begin
  result := false;
  vProcesso := 'BAS286';
  if vSing.vTipoContrato = 'MOT' then
  	vProcesso := 'BAS177'
  else if vSing.vTipoContrato = 'NOT' then
  	vProcesso := 'BAS419'
  else if vSing.vTipoContrato = 'DOC' then
  	vProcesso := 'BAS553';

  if not vDadosIni.PesqPros(vProcesso, 'INSERIR', '', 'MODCARTAS', '', buscas, true) then
  	exit;

  result := inherited Insert;

  vhwcloudIA := vDadosIni.retornaDadosHwCloudIA(buscas) <> '';

  if result then
  begin
    dataSet.FieldByName('COD_CARTA').AsInteger := 0;
    dataSet.FieldByName('TIPO').AsString := vSing.vTipoContrato;
    dataSet.FieldByName('USAR_SERVICO').AsString := 'N';

    obAplicativo.abreAplicativo;

    if (vSing.vTipoContrato <> 'NOT') and  (vSing.vTipoContrato <> 'DOC') then
    	dataSet.FieldByName('ID_MSG_APLICATIVO').AsInteger := 0
    else if not vhwcloudIA then
    	dataSet.FieldByName('ID_MSG_APLICATIVO').AsInteger := 1
    else
    begin
      if not abreFormOpcoes then
      begin
        dataSet.Cancel;
        Result := false;
        exit;
      end;
    end;
  end;
end;

function TModeloCartas.post: boolean;
var
  acao: string;
begin
  result := false;
  vProcesso := 'BAS292';
  if vSing.vTipoContrato = 'MOT' then
  	vProcesso := 'BAS183'
  else if vSing.vTipoContrato = 'NOT' then
    vProcesso := 'BAS425'
  else if vSing.vTipoContrato = 'DOC' then
    vProcesso := 'BAS559';

  try
    if not (dataset.State in [dsInsert, dsEdit]) then
      exit;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    dataset.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    dataset.FieldByName('ATIVO').AsInteger := 1;

    if trim(dataset.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição não informada.',
      	IfThen(dataSet.FieldByName('TIPO').AsString = 'NOT', 'DBEDIT6', 'DBEDIT2'));

    if dataSet.FieldByName('TIPO').AsString = 'NOT' then
    	if dataSet.FieldByName('TIPO_CONTRATO').AsString = '' then
      	raiseExceptionCreate('Tipo da notificação não informado.', 'DBComboBox3');

    if (dataSet.FieldByName('TIPO').AsString = 'NOT') or (dataSet.FieldByName('TIPO').AsString = 'DOC') then
    begin
    	if trim(dataSet.FieldByName('DADOS_CARTA').AsString) = '' then
      	raiseExceptionCreate('Dados da notificação não informado.',
        	IfThen(dataSet.FieldByName('TIPO').AsString = 'NOT', 'WebBrowser1', 'WebBrowser2'));

      if dataSet.FieldByName('ID_MSG_APLICATIVO').AsInteger <= 0 then
      	raiseExceptionCreate('Aplicativo não informada.',
        	IfThen(dataSet.FieldByName('TIPO').AsString = 'NOT', 'DBLookupComboBox1', 'DBLookupComboBox2'));

    	if (trim(obAplicativo.dataSet.FieldByName('APLICATIVO').AsString) = 'WHATSAPP') then
      begin
      	if trim(dataSet.FieldByName('TEMPLATE').AsString) = '' then
      		raiseExceptionCreate('Template não informado.',
          	IfThen(dataSet.FieldByName('TIPO').AsString = 'NOT', 'DBComboBox7', 'DBComboBox9'));
      end;
    end;

    if (dataSet.FieldByName('TIPO').AsString = 'NOT') and (dataSet.FieldByName('USAR_SERVICO').AsString = 'S') then
    begin
      SqlOpen(' select cod_carta, cod_empresa, descricao from modcartas ' +
        ' where cod_carta <> ' + IntToStr(dataSet.FieldByName('COD_CARTA').AsInteger) +
        '	and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ' +
        ' and tipo = ''NOT'' ' +
        ' and tipo_contrato = ' + QuotedStr(dataSet.FieldByName('TIPO_CONTRATO').AsString) +
        ' and id_msg_aplicativo = ' + IntToStr(dataSet.FieldByName('ID_MSG_APLICATIVO').AsInteger) +
        ' and usar_servico = ''S'' ');

       if not buscas.IsEmpty then
       begin
         if Application.MessageBox('Já existe um modelo de notificação utilizado no serviço com este tipo e aplicativo, deseja alterar para este?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = ID_YES then
         begin
           SqlExec(' update modcartas set usar_servico = ''N'' ' +
           		' where cod_carta <> ' + IntToStr(dataSet.FieldByName('COD_CARTA').AsInteger) +
              '	and cod_empresa = ' + vDadosIni.codEmpresa +
              ' and tipo = ''NOT'' ' +
			        ' and tipo_contrato = ' + QuotedStr(dataSet.FieldByName('TIPO_CONTRATO').AsString) +
              ' and id_msg_aplicativo = ' + IntToStr(dataSet.FieldByName('ID_MSG_APLICATIVO').AsInteger) +
      			  ' and usar_servico = ''S'' ');
         end
         else
           raiseExceptionCreate('Já existe um modelo de notificação utilizado no serviço com este tipo,' +
           	' favor verificar antes de continuar.', 'DBCheckBox1');
       end;
    end;

    if (trim(dataSet.FieldByName('TIPO_CONTRATO').AsString) <> 'AVISO DE VENCIMENTO')
    	and (trim(dataSet.FieldByName('TIPO_CONTRATO').AsString) <> 'CREDITOS EM ATRASO')
      and (trim(dataSet.FieldByName('TIPO_CONTRATO').AsString) <> 'AGRADECIMENTO') then
      	dataSet.FieldByName('USAR_SERVICO').AsString := 'N'
    else if (trim(dataSet.FieldByName('TIPO').AsString) <> 'DOC') then
      	dataSet.FieldByName('DOC').Value := Null;

//    if trim(vSing.vTipoContrato) = 'MOT' then
//      if trim(dataset.FieldByName('FORMULARIOS').AsString) = '' then
//        raiseExceptionCreate('Formulário não informado.', 'DBComboBox1');

    if acao = 'INSERIR' then
      dataSet.FieldByName('COD_CARTA').AsInteger := Gencodigo('MODCARTAS',
        DtmCadBasicos.spModCarta, vDadosIni.codEmpresa);

    result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao
    else
    	RollBackTransacao;

    if Result then
      vDadosIni.GravaAuditoria(vProcesso, acao, 'SUCESSO', 'MODCARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas)
    else
      vDadosIni.GravaAuditoria(vProcesso, acao, 'FALHA', 'MODCARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas);
    if Result then
      Refresh
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TModeloCartas._abrelixeira: boolean;
begin
  result := false;
  vProcesso := 'BAS290';
  if vSing.vTipoContrato = 'MOT' then
    vProcesso := 'BAS182'
  else if vSing.vTipoContrato = 'NOT' then
  	vProcesso := 'BAS424'
  else if vSing.vTipoContrato = 'DOC' then
  	vProcesso := 'BAS558';

  if not vDadosIni.PesqPros(vProcesso, 'ABRIR LIXEIRA', '', 'MODCARTAS', dataset.FieldByName('COD_CARTA').AsString, buscas, true) then
      Exit;

  if not _lixeiraCheia then
  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    montaSelect(ultimasql);
    result := false;
  end
  else
    result := montaSelect(' SELECT MODCARTAS.*, ' +
    	' MSG_APLICATIVO.APLICATIVO ' +
      ' FROM MODCARTAS ' +
      ' LEFT JOIN MSG_APLICATIVO ON MSG_APLICATIVO.ID = MODCARTAS.ID_MSG_APLICATIVO ' +
      ' WHERE COALESCE(MODCARTAS.ATIVO, 0) = 0 ' +
      ' AND MODCARTAS.TIPO = ' + QuotedStr(getTipoContrato));
end;

function TModeloCartas._ManterRegrasCartasCobranca: boolean;
begin
  result := false;
  if IsEmpty then
    exit;
  if not (trim(dataSet.FieldByName('TIPO').AsString) = 'CAR') then
  begin
    Application.MessageBox('Configuração disponível apenas para modelos de carta de cobrança.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    exit;
  end;
  if obRegrasCCobranca = nil then
    obRegrasCCobranca := TRegrasCartas.Create;
  result := obRegrasCCobranca.montaSelect('select * from regradecartas where cod_carta=' +
    inttostr(dataSet.FieldByName('COD_CARTA').AsInteger) + ' and cod_empresa=' + vDadosIni.codEmpresa);
  if not result then
    exit;
  if obRegrasCCobranca.IsEmpty then
  begin
    result := vDadosIni.PesqPros('BAS323', 'INSERINDO NOVO REGISTRO', '', 'REGRADECARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas, true);
    if not result then
      exit;
    result := obRegrasCCobranca.Insert;
  end
  else begin
    result := vDadosIni.PesqPros('BAS323', 'EDITANDO REGISTRO', '', 'REGRADECARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas, true);
    if not result then
      exit;
    result := obRegrasCCobranca.Edit;
  end;
  if result then
  begin
    obRegrasCCobranca.dataSet.FieldByName('COD_CARTA').AsInteger := dataSet.FieldByName('COD_CARTA').AsInteger;
    obRegrasCCobranca.dataSet.FieldByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
  end;
  obRegrasCCobranca.vBuscas.close;
  obRegrasCCobranca.vbuscas.SQL.Text := 'select mc.cod_carta,mc.descricao from modcartas mc where mc.tipo=''CAR'' ' +
    ' and mc.cod_empresa= ' + vDadosIni.codEmpresa + ' order by mc.descricao';
  obRegrasCCobranca.vbuscas.Open;
  obRegrasCCobranca.FdsModeloCarta := TDataSource.Create(nil);
  obRegrasCCobranca.FdsModeloCarta.DataSet := obRegrasCCobranca.vbuscas;
end;

procedure TModeloCartas._cadModelosCarta(pTipoForm: Integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Modelos de Cartas');

    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS294', 'CONSULTA', '', 'MODCARTAS', '', DtmCadBasicos.qrModCartas, False) then
      Exit;

    if frmCadModeloCartas = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TfrmCadModeloCartas, frmCadModeloCartas);
    end;

    if (pTipoForm > 0) and (not frmCadModeloCartas.Visible) then
      frmCadModeloCartas.ShowModal
    else if (not frmCadModeloCartas.Visible) then
      frmCadModeloCartas.Show
    else if frmCadModeloCartas.FormStyle = fsMDIChild then
      frmCadModeloCartas.Show
    else
      frmCadModeloCartas.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TModeloCartas._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  vStatus: string;
begin
	result := true;
  rModCartas.vSqlAdicional := '';

  tempSql := '';
  if rModCartas.vCampo = 'Aplicativo' then
    tempSql := ' MSG_APLICATIVO.APLICATIVO ';

  if tempSql  <> '' then
  begin
    if rModCartas.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rModCartas.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rModCartas.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rModCartas.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rModCartas.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rModCartas.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rModCartas.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rModCartas.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + rModCartas.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(rModCartas.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(rModCartas.vValor);
    rModCartas.vValor := '';
    if Trim(rModCartas.vSqlAdicional) <> '' then
      rModCartas.vSqlAdicional := rModCartas.vSqlAdicional + ' and ' + tempSql
    else
      rModCartas.vSqlAdicional := tempSql;
  end;

  if rModCartas.vAdicional then
  begin
    if rModCartas.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rModCartas.vDataIniAd);
      except
        rModCartas.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rModCartas.vDataFimAd);
      except
        rModCartas.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rModCartas.vDataIniAd <> '' then
          rModCartas.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rModCartas.vDataIniAd)));
        if rModCartas.vDataFimAd <> '' then
          rModCartas.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rModCartas.vDataFimAd)));
      end;
    end
    else if rModCartas.vValorAd = '' then
      exit;
    if rModCartas.vCondicaoAd = 'Igual' then
      rModCartas.vCondicaoAd := '='
    else if rModCartas.vCondicaoAd = 'Maior' then
      rModCartas.vCondicaoAd := '>'
    else if rModCartas.vCondicaoAd = 'Maior ou Igual' then
      rModCartas.vCondicaoAd := '>='
    else if rModCartas.vCondicaoAd = 'Menor' then
      rModCartas.vCondicaoAd := '<'
    else if rModCartas.vCondicaoAd = 'Menor ou Igual' then
      rModCartas.vCondicaoAd := '<='
    else if rModCartas.vCondicaoAd = 'Diferente' then
      rModCartas.vCondicaoAd := '<>'
    else if (rModCartas.vCondicaoAd = 'Esta contido') then
      rModCartas.vCondicaoAd := 'like'
    else if (rModCartas.vCondicaoAd = 'Começa') then
      rModCartas.vCondicaoAd := 'Começa'
    else
      rModCartas.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rModCartas.vCampoAd) then
        begin
//          if rModCartas.vCampo = rModCartas.vCampoAd then
//          begin
//            rModCartas.vsqlAdicional := '';
//            exit;
//          end;
          rModCartas.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rModCartas.vCondicaoAd = 'Começa') or (rModCartas.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rModCartas.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rModCartas.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rModCartas.vCondicaoAd := '=';
            rModCartas.vValorAd := vDadosIni.trocaVirgulaPorPonto(rModCartas.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if Trim(rModCartas.vSqlAdicional) <> '' then
		      	rModCartas.vSqlAdicional := rModCartas.vSqlAdicional + ' and ';

            if (rModCartas.vDataIniAd <> '') and (rModCartas.vDataFimAd <> '') then
              rModCartas.vSqlAdicional := rModCartas.vsqlAdicional + rModCartas.vCampoAd +
                ' >= ' + rModCartas.vDataIniAd + ' and ' + rModCartas.vCampoAd + ' <= ' + rModCartas.vDataFimAd
            else if (rModCartas.vDataFimAd <> '') then
              rModCartas.vsqlAdicional := rModCartas.vsqlAdicional + rModCartas.vCampoAd +
                ' <= ' + rModCartas.vDataIniAd
            else if (rModCartas.vDataIniAd <> '') and (rModCartas.vDataFimAd <> '') then
              rModCartas.vsqlAdicional := rModCartas.vsqlAdicional + rModCartas.vCampoAd +
                ' >= ' + rModCartas.vDataIniAd;
            Break;
          end;
          if Trim(rModCartas.vSqlAdicional) <> '' then
		      	rModCartas.vSqlAdicional := rModCartas.vSqlAdicional + ' and ';

          if rModCartas.vCondicaoAd = 'like' then
          begin
          	if rModCartas.vCampoAd = 'APLICATIVO' then
	            rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
             	  ' MSG_APLICATIVO.APLICATIVO like ' + QuotedStr('%' + rModCartas.vValorAd + '%')
            else
              rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
              	' MODCARTAS.' + rModCartas.vCampoAd + ' like ' + QuotedStr('%' + rModCartas.vValorAd + '%')
          end
          else if rModCartas.vCondicaoAd = 'Começa' then
          begin
            if rModCartas.vCampoAd = 'APLICATIVO' then
            	rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
              	' MSG_APLICATIVO.APLICATIVO like ' + QuotedStr(rModCartas.vValorAd + '%')
            else
	            rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
              	' MODCARTAS.' + rModCartas.vCampoAd + ' like ' + QuotedStr(rModCartas.vValorAd + '%')
          end
          else //if rModCartas.vCondicaoAd <> 'Começa' then
          begin
            if rModCartas.vCampoAd = 'APLICATIVO' then
              rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
              	' MSG_APLICATIVO.APLICATIVO ' + rModCartas.vCondicaoAd + ' ' + QuotedStr(rModCartas.vValorAd)
            else
              rModCartas.vsqlAdicional := rModCartas.vsqlAdicional +
              	' MODCARTAS.' + rModCartas.vCampoAd + ' ' + rModCartas.vCondicaoAd + ' ' + QuotedStr(rModCartas.vValorAd);
          end;
          Break;
        end;
      end;
    end;
  end;

  if Trim(rModCartas.vSqlAdicional) <> '' then
  	rModCartas.vSqlAdicional := rModCartas.vSqlAdicional + ' and ';

  rModCartas.vSqlAdicional := rModCartas.vSqlAdicional + ' MODCARTAS.TIPO = ' + QuotedStr(vSing.vTipoContrato)
end;

function TModeloCartas._lixeiraCheia: boolean;
begin
  result := ExecutaComandosSql('Select first 1 cod_carta from modcartas ' +
    ' where coalesce(ativo,0) = 0 ' +
    ' and tipo = ' + QuotedStr(vSing.vTipoContrato) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);
end;

function TModeloCartas._restauraRegistro: boolean;
begin
  result := false;
  vProcesso := 'BAS291';
  if vSing.vTipoContrato = 'MOT' then
  	vProcesso := 'BAS181'
  else if vSing.vTipoContrato = 'NOT' then
  	vProcesso := 'BAS423'
  else if vSing.vTipoContrato = 'DOC' then
  	vProcesso := 'BAS557';
  
  if IsEmpty then
    exit;
  if dataSet.FieldByName('ATIVO').asinteger = 0 then
  begin
    if not vDadosIni.PesqPros(vProcesso, 'RESTAURAR REGISTRO', '', 'MODCARTAS', dataset.FieldByName('COD_CARTA').AsString, buscas, true) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
      'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin

    	if (dataSet.FieldByName('TIPO').AsString = 'NOT') and (dataSet.FieldByName('USAR_SERVICO').AsString = 'S') then
      begin
        SqlOpen(' select cod_carta, cod_empresa, descricao from modcartas ' +
          ' where cod_carta <> ' + IntToStr(dataSet.FieldByName('COD_CARTA').AsInteger) +
          '	and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ativo = 1 ' +
          ' and tipo = ''NOT'' ' +
          ' and tipo_contrato = ' + QuotedStr(dataSet.FieldByName('TIPO_CONTRATO').AsString) +
          ' and usar_servico = ''S'' ');

        if not buscas.IsEmpty then
        begin
        	 if Application.MessageBox('Já existe um modelo de notificação utilizado no serviço com este tipo, deseja alterar para este?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = ID_YES then
           begin
             SqlExec(' update modcartas set usar_servico = ''N'' ' +
                ' where cod_carta <> ' + IntToStr(dataSet.FieldByName('COD_CARTA').AsInteger) +
                '	and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and tipo = ''NOT'' ' +
                ' and tipo_contrato = ' + QuotedStr(dataSet.FieldByName('TIPO_CONTRATO').AsString) +
                ' and usar_servico = ''S'' ');
    			end
    			else
    			begin
             Application.MessageBox(PChar('Já existe um modelo de notificação utilizado no serviço com este tipo,' +
           			' favor verificar antes de continuar.'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
             exit;
    			end;
        end;
      end;

      if inherited Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 1;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria(vProcesso, 'RESTAURAR REGISTRO', 'SUCESSO', 'MODCARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas)
        else
          vDadosIni.GravaAuditoria(vProcesso, 'RESTAURAR REGISTRO', 'FALHA', 'MODCARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas);
        end;
      end;
    end;
  Refresh;
end;

{ TTipoVendas }

constructor TTipoVendas.create;
begin
  DataSet := TClientDataSet(DtmCadBasicos.cdsTipoVendas);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  Buscas := TIBQuery(DtmCadBasicos.qrBuscas);
end;

function TTipoVendas.Delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('COD_TIPO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin

    if not vDadosIni.PesqPros('BAS249', 'EXCLUIR', '', 'TIPO_VENDAS',
      dataSet.FieldByName('COD_TIPO').AsString, buscas, false) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja enviar este registro para Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;

    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS249', 'EXCLUIR', 'SUCESSO', 'TIPO_VENDAS', vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS249', 'EXCLUIR', 'FALHA', 'TIPO_VENDAS', vCodFormula, buscas);

    Result := true;
    Refresh;

    Exit;
  end;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  result := inherited Delete;
  if Result then
    result := Apply;

  if result then
    result := CommitaTransacao;
  _abrelixeira;
  if Result then
    vDadosIni.GravaAuditoria('BAS250', 'EXCLUIR', 'SUCESSO', 'TIPO_VENDAS', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS250', 'EXCLUIR', 'FALHA', 'TIPO_VENDAS', vCodFormula, buscas);

  Result := true;
  Refresh;

end;

