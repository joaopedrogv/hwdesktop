function TApuracaoDepto.post: boolean;
begin
  try
    Result := false;
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.FieldByName('COD_DEP').asinteger = 0 then
      raise exception.create('Departamento não informado');
    if dataSet.FieldByName('MES').asinteger = 0 then
      raise exception.create('Mês não informado');
    if dataSet.FieldByName('ANO').asinteger = 0 then
      raise exception.create('Ano não informado');
    if trim(dataSet.FieldByName('TPDESP').AsString) = '' then
      raise exception.create('Tipo de Custo não informado');
    if dataSet.FieldByName('VALOR').AsCurrency = 0 then
      raise exception.create('Valor do Custo não informado');
    if dataSet.FieldByName('VALOR_FATURADO').AsCurrency = 0 then
      raise exception.create('Valor Faturado não informado');
    //
    if dataSet.State in [dsInsert] then
    begin
      //colocar aqui o teste de depto já cadastrado para o DNA em questão
      buscas.close;
      buscas.sql.text := 'select * from apuracao_depto where cod_dep = ' +
        dataSet.FieldByName('COD_DEP').AsString +
        ' and mes = ' + dataSet.FieldByName('MES').AsString + ' and ano = ' +
        dataSet.FieldByName('ANO').AsString +
        ' and TPDESP = ''' + dataSet.FieldByName('TPDESP').AsString + ''' and cod_empresa = ' +
        vDadosIni.codEmpresa;
      buscas.open;
      if not buscas.IsEmpty then
      begin
        raise exception.create('Custo já cadastrado para o mes e ano informado. Verifique!');
      end;
      dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    end;
    dataSet.FieldByName('datacad_ap').AsDateTime :=
      strtodate(inttostr(vDadosIni.UltimoDia(StrToDate('01/' + dataSet.FieldByName('MES').AsString +
      '/' + dataSet.FieldByName('ANO').AsString))) + '/' + dataSet.FieldByName('MES').AsString + '/'
      + dataSet.FieldByName('ANO').AsString);

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if Apply then
    begin
      if CommitaTransacao then
        vDadosIni.GravaAuditoria('GES050', 'GRAVAR', 'SUCESSO', 'APURACAO_DEPTO',
          dataSet.FieldByName('COD_DEP').AsString + ' MES ' + dataSet.FieldByName('MES').AsString +
          ' ANO ' +
          dataSet.FieldByName('ANO').AsString, buscas);
      //        vDadosIni.GravaAuditoria('GES001', 'TRANSACAO CONFIRMADA DEPTO ' +
      //          dataSet.FieldByName('COD_DEP').AsString + ' MES ' + dataSet.FieldByName('MES').AsString + ' ANO ' +
      //          dataSet.FieldByName('ANO').AsString, buscas);
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      vDadosIni.GravaAuditoria('GES050', 'GRAVAR', 'FALHA', 'APURACAO_DEPTO',
        dataSet.FieldByName('COD_DEP').AsString + ' MES ' + dataSet.FieldByName('MES').AsString +
        ' ANO ' +
        dataSet.FieldByName('ANO').AsString, buscas);
      //      vDadosIni.GravaAuditoria('GES001', 'TRANSACAO NAO CONFIRMADA DEPTO ' +
      //        dataSet.FieldByName('COD_DEP').AsString + ' MES ' + dataSet.FieldByName('MES').AsString + ' ANO ' +
      //        dataSet.FieldByName('ANO').AsString, buscas);
      Result := FALSE;
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

