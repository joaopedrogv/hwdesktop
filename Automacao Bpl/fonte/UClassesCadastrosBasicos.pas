function TImagensDoc.removerImagem(
	pCodigo: Integer;
  pCodEmpresa: Integer;
  pTipo: string;
  pGrupoProd: Integer = 0;
  pCodProd: string = '';
  pCodGrade: Integer = 0): boolean;
begin
	try
  	Result := False;

    if trim(pTipo) = 'CTP' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM CONTAS_A_PAGAR_IMAGENS ' +
        ' WHERE COD_CONTRP = :COD_CONTRP ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ' +
        ' AND COD_IMG = :COD_IMG; ';
      buscas.ParamByName('COD_CONTRP').AsInteger := pCodigo;
      buscas.ParamByName('COD_EMPRESA').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := dataSet.FieldByName('COD_IMG').AsInteger;
      buscas.ExecSQL;
    end
    else
    begin
    	buscas.Close;
      buscas.SQL.Text := ' DELETE FROM LOTE_LANC_IMAGENS ' +
        ' WHERE N_LOTE = :N_LOTE ' +
        ' AND CODIGO_EMP = :CODIGO_EMP ' +
        ' AND COD_IMG = :COD_IMG; ';
      buscas.ParamByName('N_LOTE').AsInteger := pCodigo;
      buscas.ParamByName('CODIGO_EMP').AsInteger := pCodEmpresa;
      buscas.ParamByName('COD_IMG').AsInteger := dataSet.FieldByName('COD_IMG').AsInteger;
      buscas.ExecSQL;
    end;

    CommitaTransacao;
    Refresh;
  except
    on e: Exception do
    begin
      Result := False;
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

{ TConciliacaoCodAjuste }

function TConciliacaoCodAjuste.atualizarCodAjusteEmLote: boolean;
var
	vIndexFieldNames: string;
	vIndexName: string;
  vRecNo: Integer;
	vId: Integer;
  vSQL: string;
  fTempCodAjuste: TClientDataSet;
begin
	vSQL := '';

	if not vDadosIni.PesqPros('BAS517', 'ATUALIZAR', '', 'CONCILIACAO_COD_AJUSTE', '', buscas, False) then
    Exit;

	try
    try
    	vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum contrato selecionado.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          dataSet.Refresh;
          exit;
        end;

        fTempCodAjuste := TClientDataSet.Create(nil);
        fTempCodAjuste.Close;
        fTempCodAjuste.FieldDefs.Clear;
        fTempCodAjuste.FieldDefs.Add('ID', ftInteger, 0, false);
        fTempCodAjuste.close;
        fTempCodAjuste.CreateDataSet;
        fTempCodAjuste.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
            vDadosIni.abreStatusProcessamento('', 'Atualizando códigos de ajuste (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempCodAjuste.Insert;
              fTempCodAjuste.FieldByName('ID').AsInteger := dataSet.FieldByName('ID').AsInteger;
              fTempCodAjuste.Post;
            end;

            dataSet.Next;
          end;

          vSQL := dataSet.CommandText;
        finally
          dataSet.EnableControls;
        end;
      finally
        dataSet.Filtered := False;
      end;

      if vHAB_NUM_CONTA_E then
      begin
//        if vNUM_CONTA_E <= 0 then
//          raiseExceptionCreate('Nº da Conta (Entrada) deve ser informado', 'EdNumContaE');

      	if vNUM_CONTA_E > 0 then
          if not ConciliacaoCodAjustePContasE.buscarNumConta(vNUM_CONTA_E) then
            raiseExceptionCreate('Nº da Conta (Entrada) não encontrado', 'EdNumContaE');

        if vNUM_CONTA_E > 0 then
          if not ConciliacaoCodAjustePContasE.buscarNumContaNatureza(vNUM_CONTA_E) then
            raiseExceptionCreate('Nº Conta (Entrada) não encontrado', 'EdNumContaE');
      end;

      if vHAB_NUM_CONTA_S then
      begin
//        if vNUM_CONTA_S <= 0 then
//          raiseExceptionCreate('Nº da Conta (Saída) deve ser informado', 'EdNumContaS');

      	if vNUM_CONTA_S > 0 then
          if not ConciliacaoCodAjustePContasS.buscarNumConta(vNUM_CONTA_S) then
            raiseExceptionCreate('Nº da Conta (Saída) não encontrado', 'EdNumContaS');

        if vNUM_CONTA_S > 0 then
          if not ConciliacaoCodAjustePContasS.buscarNumContaNatureza(vNUM_CONTA_S) then
            raiseExceptionCreate('Nº Conta (Saída) não encontrado', 'EdNumContaS');
      end;

     if (not vHAB_NUM_CONTA_E)
     	and (not vHAB_NUM_CONTA_S) then
      	raiseExceptionCreate('Nenhum opção selecionada!', '');

      try
        fTempCodAjuste.DisableControls;
        fTempCodAjuste.First;
        while not fTempCodAjuste.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Atualizando códigos de ajuste (' +
            IntToStr(fTempCodAjuste.RecNo) + '/' + IntToStr(fTempCodAjuste.RecordCount) + ')');

          _selecionaCodAjuste(fTempCodAjuste.FieldByName('ID').AsInteger);

          if not dataSet.IsEmpty then
          begin
          	vId := dataSet.FieldByName('ID').AsInteger;

            dataSet.Edit;

            if vHAB_NUM_CONTA_E then
            begin
            	if vNUM_CONTA_E > 0 then
              	dataSet.FieldByName('N_CONTA_PLC_E').AsFloat := vNUM_CONTA_E
              else
              	dataSet.FieldByName('N_CONTA_PLC_E').Value := Null;
            end;

            if vHAB_NUM_CONTA_S then
            begin
            	if vNUM_CONTA_S > 0 then
              	dataSet.FieldByName('N_CONTA_PLC_S').AsFloat := vNUM_CONTA_S
              else
              	dataSet.FieldByName('N_CONTA_PLC_S').Value := Null;
            end;

            dataSet.Post;

            if (not Apply) and (dataSet.ChangeCount > 0) then
            begin
              dataSet.CancelUpdates;
              RollBackTransacao;
              Result := False;

              dataSet.Close;
		    			dataSet.CommandText := vSQL;
					    dataSet.Open;

              Exit;
            end;

            vDadosIni.GravaAuditoria('BAS517', 'ATUALIZAR', '', 'CONCILIACAO_COD_AJUSTE', IntToStr(vId), buscas);
          end;

          fTempCodAjuste.Next;
        end;
      finally
        fTempCodAjuste.EnableControls;
      end;

      Result := True;

      CommitaTransacao;

      if Result then
      	vDadosIni.GravaAuditoria('BAS517', 'ATUALIZAR',	'SUCESSO', 'CONCILIACAO_COD_AJUSTE', '', buscas);

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      if Result then
      	dataSet.Refresh;
    finally
    	dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('BAS517', 'ATUALIZAR',	'FALHA', 'CONCILIACAO_COD_AJUSTE', '', buscas);
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
		    dataSet.Close;
  	    dataSet.CommandText := vSQL;
	    	dataSet.Open;
    	end;

      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

