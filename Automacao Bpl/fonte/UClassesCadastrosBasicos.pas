procedure TProdutosEC_CA._cadProdutosEC_CA(pTipoForm: Integer; pTipo: string);
begin
	try
  	if pTipo = 'E' then
	    vDadosIni.abreStatusProcessamento('', 'Abrindo Produtos E-Commerce')
    else
    	vDadosIni.abreStatusProcessamento('', 'Abrindo Produtos/Serviços Comércio Aberto');

    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros(IfThen(pTipo = 'E', 'BAS432', 'BAS434'), 'CONSULTA', '', 'VW_PRODUTOS_EC', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;
    vDadosIni.vtpEC_CA := pTipo;
    if frmProdutosEC_CA = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmProdutosEC_CA, frmProdutosEC_CA);
    end;
    frmProdutosEC_CA.Caption := vDadosIni.IfThen(pTipo = 'E',
    	'Produtos E-Commerce', 'Produtos Comércio Aberto');

    if (pTipoForm > 0) and (not frmProdutosEC_CA.Visible) then
      frmProdutosEC_CA.ShowModal
    else if (not frmProdutosEC_CA.Visible) then
      frmProdutosEC_CA.Show
    else if frmProdutosEC_CA.FormStyle = fsMDIChild then
      frmProdutosEC_CA.Show
    else
      frmProdutosEC_CA.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TProdutosEC_CA._defineSqlAdicional(pTipo: string): boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  vtempAvanc: string;
begin
  result := true;
  rProdutosEC_CA.vSqlAdicional := '';

  tempSql := '';
  if (rProdutosEC_CA.vCampo = 'Descricao Resumida') then
    tempSql := 'UPPER(VW_PRODUTOS_EC.DESCR_PROD_RES) ';
  if (rProdutosEC_CA.vPorData) then
  begin
    try
      erro := 0;
      StrToDateTime(rProdutosEC_CA.vDataIni);
    except
      rProdutosEC_CA.vDataIni := '';
      erro := erro + 1;
    end;
    try
      StrToDateTime(rProdutosEC_CA.vDataFim);
    except
      rProdutosEC_CA.vDataFim := '';
      erro := erro + 1;
    end;
    if erro = 2 then
    begin
      Application.MessageBox('Data inválida. Informe no mínimo uma data correta',
        'Atenção', MB_OK + MB_ICONINFORMATION);
    end
    else
    begin
      if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
        formatodata := 'mm/dd/yyyy'
      else if pos('.', ShortDateFormat) <> 0 then
        formatodata := 'dd.mm.yyyy';
      if rProdutosEC_CA.vDataIni <> '' then
        rProdutosEC_CA.vDataIni := QuotedStr(FormatDateTime(formatodata, strtodate(rProdutosEC_CA.vDataIni)) + ' 00:00:00');
      if rProdutosEC_CA.vDataFim <> '' then
        rProdutosEC_CA.vDataFim := QuotedStr(FormatDateTime(formatodata, strtodate(rProdutosEC_CA.vDataFim)) + ' 23:59:59');
    end;
  end;

  if tempSql  <> '' then
  begin
    if rProdutosEC_CA.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rProdutosEC_CA.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rProdutosEC_CA.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rProdutosEC_CA.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rProdutosEC_CA.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rProdutosEC_CA.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rProdutosEC_CA.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rProdutosEC_CA.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if (rProdutosEC_CA.vPorData) and (rProdutosEC_CA.vDataIni <> '') and (rProdutosEC_CA.vDataFim <> '') then
    begin
    	for I := 0 to dataSet.FieldCount - 1 do
	      if Dataset.Fields[I].FieldKind = fkData then
  	      if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rProdutosEC_CA.vCampo) then
          begin
          	rProdutosEC_CA.vCampo := DataSet.Fields[I].FieldName;

            tempSql := 'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampo + ' >= ' + rProdutosEC_CA.vDataIni +
              ' and VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampo + ' <= ' + rProdutosEC_CA.vDataFim;
            break;
          end;
    end
    else if tempTipo = 'like' then
    begin
    	if (rProdutosEC_CA.vCampo = 'Descricao Resumida') then
			  tempSql := tempSql + tempTipo + QuotedStr('%' + UpperCase(rProdutosEC_CA.vValor) + '%')
      else
	      tempSql := tempSql + tempTipo + QuotedStr('%' + rProdutosEC_CA.vValor + '%');
    end
    else if tempTipo = 'Começa' then
    begin
    	if (rProdutosEC_CA.vCampo = 'Descricao Resumida') then
      	tempSql := tempSql + 'like' + QuotedStr(UpperCase(rProdutosEC_CA.vValor) + '%')
      else
	      tempSql := tempSql + 'like' + QuotedStr(rProdutosEC_CA.vValor + '%');
    end
    else
    begin
    	if (rProdutosEC_CA.vCampo = 'Descricao Resumida') then
      	tempSql := tempSql + tempTipo + QuotedStr(UpperCase(rProdutosEC_CA.vValor))
      else
	      tempSql := tempSql + tempTipo + QuotedStr(rProdutosEC_CA.vValor);
    end;
    rProdutosEC_CA.vCampo := '';
    rProdutosEC_CA.vValor := '';
    rProdutosEC_CA.vDataIni := '';
    rProdutosEC_CA.vDataFim := '';
    if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
      rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ' + tempSql
    else
      rProdutosEC_CA.vSqlAdicional := tempSql;
  end
  else
  begin
  	if (rProdutosEC_CA.vPorData) and (rProdutosEC_CA.vDataIni <> '') and (rProdutosEC_CA.vDataFim <> '') then
    begin
    	for I := 0 to dataSet.FieldCount - 1 do
	      if Dataset.Fields[I].FieldKind = fkData then
  	      if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rProdutosEC_CA.vCampo) then
          begin
          	rProdutosEC_CA.vCampo := DataSet.Fields[I].FieldName;

           	tempSql := 'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampo + ' >= ' + rProdutosEC_CA.vDataIni +
             	' and VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampo + ' <= ' + rProdutosEC_CA.vDataFim;
            break;
          end;
      rProdutosEC_CA.vCampo := '';
      rProdutosEC_CA.vValor := '';
	    rProdutosEC_CA.vDataIni := '';
  	  rProdutosEC_CA.vDataFim := '';
      if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
        rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ' + tempSql
      else
        rProdutosEC_CA.vSqlAdicional := tempSql;
    end
  end;

  if rProdutosEC_CA.vAdicional then
  begin
    if rProdutosEC_CA.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDateTime(rProdutosEC_CA.vDataIniAd);
      except
        rProdutosEC_CA.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDateTime(rProdutosEC_CA.vDataFimAd);
      except
        rProdutosEC_CA.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rProdutosEC_CA.vDataIniAd <> '' then
          rProdutosEC_CA.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rProdutosEC_CA.vDataIniAd)) + ' 00:00:00');
        if rProdutosEC_CA.vDataFimAd <> '' then
          rProdutosEC_CA.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rProdutosEC_CA.vDataFimAd)) + ' 23:59:59');
      end;
    end
    else if rProdutosEC_CA.vValorAd = '' then
      exit;
    if rProdutosEC_CA.vCondicaoAd = 'Igual' then
      rProdutosEC_CA.vCondicaoAd := '='
    else if rProdutosEC_CA.vCondicaoAd = 'Maior' then
      rProdutosEC_CA.vCondicaoAd := '>'
    else if rProdutosEC_CA.vCondicaoAd = 'Maior ou Igual' then
      rProdutosEC_CA.vCondicaoAd := '>='
    else if rProdutosEC_CA.vCondicaoAd = 'Menor' then
      rProdutosEC_CA.vCondicaoAd := '<'
    else if rProdutosEC_CA.vCondicaoAd = 'Menor ou Igual' then
      rProdutosEC_CA.vCondicaoAd := '<='
    else if rProdutosEC_CA.vCondicaoAd = 'Diferente' then
      rProdutosEC_CA.vCondicaoAd := '<>'
    else if (rProdutosEC_CA.vCondicaoAd = 'Esta contido') then
      rProdutosEC_CA.vCondicaoAd := 'like'
    else if (rProdutosEC_CA.vCondicaoAd = 'Começa') then
      rProdutosEC_CA.vCondicaoAd := 'Começa'
    else
      rProdutosEC_CA.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rProdutosEC_CA.vCampoAd) then
        begin
//          if rProdutosEC_CA.vCampo = rProdutosEC_CA.vCampoAd then
//          begin
//            rProdutosEC_CA.vsqlAdicional := '';
//            exit;
//          end;
          rProdutosEC_CA.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rProdutosEC_CA.vCondicaoAd = 'Começa') or (rProdutosEC_CA.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rProdutosEC_CA.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rProdutosEC_CA.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rProdutosEC_CA.vCondicaoAd := '=';
            rProdutosEC_CA.vValorAd := vDadosIni.trocaVirgulaPorPonto(rProdutosEC_CA.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
		      		rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ';

            if (rProdutosEC_CA.vDataIniAd <> '') and (rProdutosEC_CA.vDataFimAd <> '') then
              rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vsqlAdicional +
                'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' >= ' + rProdutosEC_CA.vDataIniAd +
                ' and VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' <= ' + rProdutosEC_CA.vDataFimAd
            else if (rProdutosEC_CA.vDataFimAd <> '') then
              rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional +
                'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' <= ' + rProdutosEC_CA.vDataIniAd
            else if (rProdutosEC_CA.vDataIniAd <> '') and (rProdutosEC_CA.vDataFimAd <> '') then
              rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional +
                'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' >= ' + rProdutosEC_CA.vDataIniAd;
            rProdutosEC_CA.vCampoAd := '';
            rProdutosEC_CA.vValorAd := '';
            rProdutosEC_CA.vDataIniAd := '';
            rProdutosEC_CA.vDataFimAd := '';
          end;

          if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
		      	rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ';

          if rProdutosEC_CA.vCondicaoAd = 'like' then
          begin
          	if rProdutosEC_CA.vCampoAd = 'DESCR_PROD_RES' then
              rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'UPPER(VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ') like ' + QuotedStr('%' + UpperCase(rProdutosEC_CA.vValorAd) + '%')
            else
            	rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' like ' + QuotedStr('%' + rProdutosEC_CA.vValorAd + '%');
          end
          else if rProdutosEC_CA.vCondicaoAd = 'Começa' then
          begin
          	if rProdutosEC_CA.vCampoAd = 'DESCR_PROD_RES' then
            	rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'UPPER(VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ') like ' + QuotedStr(UpperCase(rProdutosEC_CA.vValorAd) + '%')
            else
		          rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' like ' + QuotedStr(rProdutosEC_CA.vValorAd + '%');
          end
          else //if rProdutosEC_CA.vCondicaoAd <> 'Começa' then
          begin
          	if rProdutosEC_CA.vCampoAd = 'DESCR_PROD_RES' then
            	rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'UPPER(VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ') ' + rProdutosEC_CA.vCondicaoAd + ' ' + QuotedStr(UpperCase(rProdutosEC_CA.vValorAd))
            else
	            rProdutosEC_CA.vsqlAdicional := rProdutosEC_CA.vsqlAdicional + 'VW_PRODUTOS_EC.' + rProdutosEC_CA.vCampoAd + ' ' + rProdutosEC_CA.vCondicaoAd + ' ' + QuotedStr(rProdutosEC_CA.vValorAd);
          end;
          Break;
        end;
      end;
    end;
  end;
  if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
    rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ';

  if pTipo = 'E' then
	  rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' VW_PRODUTOS_EC.SINC_ECOMMERCE = ''S'' '
  else
    rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' VW_PRODUTOS_EC.ENV_COMERCIO_ABERTO = ''S'' ';

  if Trim(rProdutosEC_CA.vSqlAdicional) <> '' then
    rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' and ';

  if pTipo = 'E' then
    rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' VW_PRODUTOS_EC.API in (''TRAYCOMMERCE'', ''NUVEMSHOP'') '
  else
    rProdutosEC_CA.vSqlAdicional := rProdutosEC_CA.vSqlAdicional + ' VW_PRODUTOS_EC.API =  ''COMERCIOABERTO'' ';
end;

