function TRegrasSugServ.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS370', 'SALVAR', '', 'REGRAS_SUG',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

   if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('TIPO').AsString) = 'E' then
    begin
    	dataSet.FieldByName('MES_RET_SERV1').Value := Null;
	    dataSet.FieldByName('MES_RET_SERV2').Value := Null;
	    dataSet.FieldByName('INTERV_KM_SERV').Value := Null;
    	dataSet.FieldByName('KM_RET_SERV1').Value := Null;
    	dataSet.FieldByName('KM_RET_SERV2').Value := Null;
    end;

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição deve ser informada', 'DBEdit1');

    if trim(dataSet.FieldByName('TIPO').AsString) = '' then
      raiseExceptionCreate('Tipo deve ser informada', 'DBComboBox2');

    if trim(dataSet.FieldByName('TIPO').AsString) <> '' then
      if (trim(dataSet.FieldByName('TIPO').AsString) <> 'V') and (trim(dataSet.FieldByName('TIPO').AsString) <> 'E') then
      raiseExceptionCreate('Tipo incorreto', 'DBComboBox2');

  	if dataSet.FieldByName('INTERV_MES_SERV').AsInteger <= 0 then
	   	raiseExceptionCreate('Interv mesês entre as revisões deve ser informado', 'DBEdit2');
      
    if (trim(dataSet.FieldByName('TIPO').AsString) <> 'E') then
      if (dataSet.FieldByName('INTERV_KM_SERV').AsInteger <= 0) then
      	raiseExceptionCreate('Interv km entre as revisões deve ser informado', 'DBEdit6');

    if (dataSet.FieldByName('MES_RET_SERV1').AsInteger <= 0) and (dataSet.FieldByName('MES_RET_SERV2').AsInteger > 0) then
    	raiseExceptionCreate('Mês primeira revisão deve ser informado', 'DBEdit3');

    if (dataSet.FieldByName('MES_RET_SERV1').AsInteger > 0) and (dataSet.FieldByName('MES_RET_SERV2').AsInteger <= 0) then
      raiseExceptionCreate('Mês segunda revisão deve ser informado', 'DBEdit4');

    if (dataSet.FieldByName('MES_RET_SERV1').AsInteger <> dataSet.FieldByName('MES_RET_SERV2').AsInteger) then
    	if (dataSet.FieldByName('MES_RET_SERV1').AsInteger >= dataSet.FieldByName('MES_RET_SERV2').AsInteger) then
      	raiseExceptionCreate('Mês primeira revisão não pode ser maior ou igual ao mês segunda revisão', 'DBEdit3');

    if (dataSet.FieldByName('KM_RET_SERV1').AsInteger <= 0) and (dataSet.FieldByName('KM_RET_SERV2').AsInteger > 0) then
    	raiseExceptionCreate('Km primeira revisão deve ser informado', 'DBEdit7');

    if (dataSet.FieldByName('KM_RET_SERV1').AsInteger > 0) and (dataSet.FieldByName('KM_RET_SERV2').AsInteger <= 0) then
      raiseExceptionCreate('Km segunda revisão deve ser informado', 'DBEdit5');

    if (dataSet.FieldByName('KM_RET_SERV1').AsInteger <> dataSet.FieldByName('KM_RET_SERV2').AsInteger) then
	    if (dataSet.FieldByName('KM_RET_SERV1').AsInteger >= dataSet.FieldByName('KM_RET_SERV2').AsInteger) then
      	raiseExceptionCreate('Km primeira revisão não pode ser maior ou igual ao km segunda revisão', 'DBEdit3');

    if acao = 'INSERIR' then
      dataSet.FieldByName('CODIGO').AsInteger :=  Gencodigo('REGRAS_SUG', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);

    Result := inherited post;

    if DataSet.ChangeCount = 0 then
      Result := True
    else
      Result := Apply;

    vRegrasSugServItens.Insert(dataSet);

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS370', acao, 'SUCESSO', 'REGRAS_SUG',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS370', acao, 'FALHA', 'REGRAS_SUG',
        dataSet.FieldByName('CODIGO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

