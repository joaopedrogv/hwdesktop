    dataSet.FieldByName('FLAG_SERV_PROD').AsString := dataSet.FieldByName('FLAG_SERV_PROD').AsString;
    dataSet.FieldByName('CONTEUDO_FLAG').AsString := dataSet.FieldByName('CONTEUDO_FLAG').AsString;
    dataSet.FieldByName('TABELAS_PERFIL').AsString := dataSet.FieldByName('TABELAS_PERFIL').AsString;
    dataSet.FieldByName('PERC_PESO').AsFloat := dataSet.FieldByName('PERC_PESO').AsFloat;
    fdata('TIPO_PERFIL').Put(IfThen(fequals('TIPO_PERFIL', 'Segmentação'), strVendaGeral, fstr('TIPO_PERFIL')));
    vagrupar := fstr('TIPO_PERFIL');
    vtipo := fstr('TIPO_SERV_PROD');
    vselecao := fstr('FLAG_SERV_PROD');
    vemcima := fstr('EM_CIMA_PERFIL');
    _abreTiposVendas;

    FConteudos.Init(vselecao, fstr('conteudo_flag'));
    FTipoVendas.Init('Tipo Venda', fstr('tabelas_perfil'));

    dataSet.FieldByName('TIPO_SERV_PROD').OnChange := DataSetFieldsChange;
    dataSet.FieldByName('TIPO_PERFIL').OnChange := DataSetFieldsChange;
  end;

