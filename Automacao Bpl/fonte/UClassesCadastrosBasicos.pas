function TRegrasCartas.post: boolean;
var
  acao: string;
begin
  result := false;
  try
    if not (dataset.State in [dsInsert, dsEdit]) then
      exit;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      RollBackTransacao;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao
    else RollBackTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('BAS323', acao, 'SUCESSO', 'REGRADECARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas)
    end
    else
    begin
      vDadosIni.GravaAuditoria('BAS323', acao, 'FALHA', 'REGRADECARTAS', dataSet.FieldByName('COD_CARTA').AsString, buscas)
    end;
    if Result then
      Refresh
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

