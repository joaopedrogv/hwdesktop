function TSenhas_ERP.insert(Senha: TSenha): boolean;
begin
  try
    if not dataSet.Active then
      montaSelect('Select * from Senhas_erp');

    if senha.dataSet.FieldByName('usuario').asString = '' then
      raise Exception.Create('Usuário não informado.');

    if vERP.dataSet.FieldByName('cod_aplicativo').asString = '' then
      raise Exception.Create('Sistema não informado.');

    dataSet.First;
    while not dataSet.Eof do
    begin
      if (Trim(dataSet.FieldByName('usuario').AsString) =
        Trim(senha.dataSet.FieldByName('usuario').asString)) and
        (dataSet.FieldByName('cod_empresa').AsString = vDadosIni.codEmpresa) and
        (dataSet.FieldByName('cod_aplicativo').AsInteger =
        vERP.dataSet.FieldByName('cod_aplicativo').asInteger) then
      begin
        Application.MessageBox('Sistema já cadastrado para este usuário.', 'Atenção',
          MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        exit;
      end;
      dataSet.Next;
    end;

    if inherited Insert then
    begin
      dataSet.FieldByName('usuario').asString := senha.dataSet.FieldByName('usuario').asString;
      dataSet.FieldByName('cod_empresa').asString := vDadosIni.codEmpresa;
      dataSet.FieldByName('cod_aplicativo').asInteger :=
        vERP.dataSet.FieldByName('cod_aplicativo').asInteger;
      result := true;
    end;
  except
    result := false;
  end;

end;

