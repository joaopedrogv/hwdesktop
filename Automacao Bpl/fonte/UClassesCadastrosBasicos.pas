function TControlesNot.abrirControlesNot: boolean;
begin
	Result := montaSelect(' select codigo_ctrl, codigo_emp, nome_ctrl, coalesce(env_notificacao, ''N'') env_notificacao from controles ' +
  	' where codigo_emp = ' + vDadosIni.codEmpresa +
    ' and docs = ''S2'' ' +
    ' and ativo = 1 ' +
    ' order by 1 ');
end;

function TControlesNot.AtivarDesativarControles(pAtivar: boolean): boolean;
var
	vControleSel: boolean;
begin
	if not vDadosIni.PesqPros(IfThen(pAtivar, 'BAS428', 'BAS429'),
  	'SALVAR', '', 'CONTROLES', '', buscas, true) then
    exit;

	try
  	Result := false;
    vControleSel := false;
    try
      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('SEL').AsString = 'S' then
        begin
        	vControleSel := true;
          
          SqlExec(' update controles set env_notificacao = ' + QuotedStr(IfThen(pAtivar, 'S', 'N')) +
          	' where codigo_ctrl = ' + IntToStr(dataSet.FieldByName('codigo_ctrl').AsInteger) +
            ' and codigo_emp = ' + vDadosIni.codEmpresa, buscas);

          vDadosIni.GravaAuditoria(IfThen(pAtivar, 'BAS428', 'BAS429'),
          	'SALVAR', '', 'CONTROLES',
            dataSet.FieldByName('CODIGO_CTRL').AsString, buscas);
        end;

        dataSet.Next;
      end;

      if not vControleSel then
      begin
      	Application.MessageBox('Nenhum controle selecionado.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      	Result := false;
        exit;
      end;

      if buscas.Transaction.InTransaction then
      	buscas.Transaction.Commit;

      if Result then
        vDadosIni.GravaAuditoria(IfThen(pAtivar, 'BAS428', 'BAS429'),
        	'SALVAR', 'SUCESSO', 'CONTROLES', '', buscas)
      else
        vDadosIni.GravaAuditoria(IfThen(pAtivar, 'BAS428', 'BAS429'),
        	'SALVAR', 'FALHA', 'CONTROLES', '', buscas);
    finally
      dataSet.EnableControls;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

