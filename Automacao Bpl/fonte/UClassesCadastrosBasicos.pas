begin
  result := false;

  vProcesso := 'BAS287';
  if vSing.vTipoContrato = 'MOT' then
  	vProcesso := 'BAS178'
  else if vSing.vTipoContrato = 'NOT' then
  	vProcesso := 'BAS420'
  else if vSing.vTipoContrato = 'DOC' then
  	vProcesso := 'BAS554';

  if IsEmpty then
    exit;

  if not vDadosIni.PesqPros(vProcesso, 'EDITAR', '', 'MODCARTAS', dataset.FieldByName('COD_CARTA').AsString, buscas, true) then
  	exit;

  result := inherited Edit;

  if result then
