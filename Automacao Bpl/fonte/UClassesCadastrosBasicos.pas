function TEmpresa.checkNumSerieCertificadoNFe: Boolean;
var
  CertNFeEmp, CertNFCeEmp: string;
  Substituir: Boolean;
begin
  Result := True;

  if fempty('NFE_NUMSERIE_CERT') then
    Exit;

  CertNFeEmp := ReplaceStr(SqlOpen('select NFE_NUMSERIE_CERT from empresa where cod_empresa = %d',
                                   [fint('cod_empresa')]).FieldByName('NFE_NUMSERIE_CERT').AsString,
                           ' ', '');

  if CertNFeEmp = ReplaceStr(fstr('NFE_NUMSERIE_CERT'), ' ', '') then
    Exit;

  Substituir := False;

  CertNFCeEmp := ReplaceStr(SqlOpen('select CERT_NUM_SERIE from NFCE_CONFIG where cod_empresa = %d',
                                    [fint('cod_empresa')]).FieldByName('CERT_NUM_SERIE').AsString,
                            ' ', '');

  if CertNFeEmp <> CertNFCeEmp then
    Exit;

  case ShowConfirmacao('Numero de série do certificado da NFCe igual ao da NFe' + sLineBreak +
                       'Deseja alterar também o número do certificado da NFCe?',
                       MB_ICONQUESTION + MB_YESNOCANCEL) of
    ID_CANCEL :
      Result := False;

    ID_YES    :
      begin
        SqlExec('update NFCE_CONFIG set CERT_NUM_SERIE = %s where cod_empresa = %d',
            [fstrq('NFE_NUMSERIE_CERT'), fint('cod_empresa')]);
      end;
  end;
end;

function TEmpresa.configuraItensTipovenda(vcomb: TDbCombobox;
  vtipo: string): boolean;
begin
  result := false;
  buscas.close;
  buscas.sql.text := 'select * from tipo_vendas where tipo = ''' + vtipo + ''' order by cod_tipo';
  buscas.open;
  vcomb.Items.Clear;
  while not buscas.eof do
  begin
    if (buscas.FieldByName('TIPO').AsString = 'REQ') or (buscas.FieldByName('TIPO').AsString = 'ORC')
      then
      vcomb.Items.Add(buscas.FieldByName('DESCRICAO').AsString);
    if (trim(buscas.FieldByName('TIPO').AsString) = 'OS') or
      (trim(buscas.FieldByName('TIPO').AsString) = 'TMO') then
      vcomb.Items.Add(buscas.FieldByName('TIPO_OS').AsString);
    buscas.next;
  end;
  if (vtipo = 'REQ') or (vtipo = 'ORC') then
    vcomb.Items.Add('E - ESCOLHA');
  Result := true;
end;

