function TOcorrenciaSugestaoServico.abreOcorrenciaSugServ(pDataset: TDataSet): boolean;
begin
	if vDadosIni.vEmp.vUsarAparelho = 'S' then
		result := montaSelect(' SELECT * FROM OCORRENCIA_SUG ' +
  		' WHERE COD_EQUIP = ' + IntToStr(pDataset.FieldByName('COD_EQUIP').AsInteger) +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa)
  else
  	result := montaSelect(' SELECT * FROM OCORRENCIA_SUG ' +
  		' WHERE CHASSI = ' + QuotedStr(pDataset.FieldByName('CHASSI').AsString) +
      ' AND PLACA = ' + QuotedStr(pDataset.FieldByName('PLACA').AsString) +
      ' AND COD_VEIC = ' + IntToStr(pDataset.FieldByName('COD_VEIC').AsInteger) +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa)
end;

