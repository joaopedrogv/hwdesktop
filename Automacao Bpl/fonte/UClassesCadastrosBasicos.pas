function TTAG.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS168', 'SALVAR', '', 'MACRO',
      dataSet.FieldByName('MACRO').AsString, buscas, true) then
      Exit;


    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if Trim(dataSet.FieldByName('NOME').AsString) = '' then
      raiseExceptionCreate('Nome não informado!', 'DBEdit_Nome');

    if Trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição não informada!', 'DBEdit_Descricao');

    if Trim(dataSet.FieldByName('TABELA').AsString) = '' then
      raiseExceptionCreate('Tabela não informada!', 'DBComboBox_Tabela');

    if Trim(dataSet.FieldByName('CAMPO').AsString) = '' then
      raiseExceptionCreate('Campo não informado!', 'DBComboBox_Campo');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('NOME').OldValue <> dataSet.FieldByName('NOME').NewValue))) then
      if ExecutaComandosSql('select macro from macro where nome = ' +
        QuotedStr(dataSet.FieldByName('NOME').AsString)) then
        raiseExceptionCreate('Já existe uma TAG com este nome!', 'DBEdit_Nome');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('DESCRICAO').OldValue <> dataSet.FieldByName('DESCRICAO').NewValue))) then
      if ExecutaComandosSql('select macro from macro where descricao = ' +
        quotedstr(dataSet.FieldByName('DESCRICAO').AsString)) then
        raiseExceptionCreate('Já existe um opcional cadastrado com esta descrição!', 'DBEdit_Descricao');

    if (_VerificaRelacionamento) then
    begin
      if Trim(dataSet.FieldByName('TABELA_RELAC').AsString) = '' then
        raiseExceptionCreate('Nome da Tabela não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento!', 'DBComboBox_TabelaBuscar');

      if Trim(dataSet.FieldByName('CAMPO_RELAC').AsString) = '' then
        raiseExceptionCreate('Campo da Tabela de busca não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento!', 'DBComboBox_CampoBuscar');

      if not (_VerificaRelacionamento2) then
       if Trim(dataSet.FieldByName('CAMPO_RETORNO').AsString) = '' then
         raiseExceptionCreate('Campo da Tabela de exibição não informado, preencha o campo ou desmarque ' +
           'a opção de relacionamento!', 'DBComboBox_CampoExibir');
    end;

    if (_VerificaRelacionamento2) then
    begin
      if Trim(dataSet.FieldByName('CAMPO2').AsString) = '' then
        raiseExceptionCreate('Campo da Tabela de busca não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento2!', 'DBComboBox_Campo2');

      if Trim(dataSet.FieldByName('TABELA_RELAC2').AsString) = '' then
        raiseExceptionCreate('Nome da Tabela não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento 2!', 'DBComboBox_TabelaBuscar2');

      if Trim(dataSet.FieldByName('CAMPO_RELAC2').AsString) = '' then
        raiseExceptionCreate('Campo da Tabela de busca não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento 2!', 'DBComboBox_CampoBuscar2');
          
      if Trim(dataSet.FieldByName('CAMPO_RETORNO').AsString) = '' then
        raiseExceptionCreate('Campo da Tabela de exibição não informado, preencha o campo ou desmarque ' +
          'a opção de relacionamento!', 'DBComboBox_CampoExibir');
    end;

    if acao = 'INSERIR' then
      _VerificarCodigoAutoIncremento('GENMACRO', 'MACRO', 'MACRO');

    _PreencheCampos;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS168', acao, 'SUCESSO', 'MACRO',
        dataSet.FieldByName('MACRO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS168', acao, 'FALHA', 'MACRO',
        dataSet.FieldByName('MACRO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
        // dataSet.FieldByName('MACRO').AsVariant := null;
      end;
    end;
  end;

end;

