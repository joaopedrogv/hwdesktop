function TOcorrenciaSugestaoServico.delete: boolean;
var
	codigo, vMensagem: string;
begin
  if vDadosIni.vEmp.vUsarAparelho = 'S' then
    vMensagem := 'COD EQUIP ' + dataSet.FieldByName('COD_EQUIP').AsString
  else
	  vMensagem := 'CHASSI ' + dataSet.FieldByName('CHASSI').AsString +
      ' PLACA ' + dataSet.FieldByName('PLACA').AsString + ' COD VEIC ' + dataSet.FieldByName('COD_VEIC').AsString;

	if not vDadosIni.PesqPros('BAS382', 'EXCLUIR', vMensagem,
    'OCORRENCIA_SUG', '', buscas, true) then
    Exit;

  Result := False;
  if dataSet.IsEmpty then
    exit;
  codigo := dataSet.FieldByName('COD_OCORR').AsString;

  if Application.MessageBox('Deseja excluir pendência?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
  begin
     result := inherited Delete;
     if Result then
       result := Apply;

     if result then
       result := CommitaTransacao;

    if Result then
       vDadosIni.GravaAuditoria('BAS382', 'EXCLUIR', 'SUCESSO - ' + vMensagem, 'OCORRENCIA_SUG', codigo, buscas)
    else
       vDadosIni.GravaAuditoria('BAS382', 'EXCLUIR', 'FALHA - ' + vMensagem, 'OCORRENCIA_SUG', codigo, buscas);
  end;
  result := true;
  Refresh;
end;

