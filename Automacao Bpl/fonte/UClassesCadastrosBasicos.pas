function TAcessoCadastrosEmp.post: boolean;
var
  vCadastro: string;
  vEmpCod, vNivelInsert, vNivelAlteracao, vNivelExclusao: Integer;
begin
  Result := False;

  try

    if Trim(dataSet.FieldByName('CADASTRO').AsString) = '' then
      raiseExceptionCreate('Campo acesso ao cadastro não informado', 'DBComboBox116');

    if not (dataSet.State  in [dsEdit, dsInsert]) then
    begin
      Result := True;
      Exit;
    end;

    if dataSet.State  = dsInsert then
    begin
      vCadastro := Trim(dataSet.FieldByName('CADASTRO').AsString);
      vEmpCod := dataSet.FieldByName('COD_EMP_ACESSO').AsInteger;
      vNivelInsert := dataSet.FieldByName('NIVEL_INCLUSAO').AsInteger;
      vNivelAlteracao := dataSet.FieldByName('NIVEL_ALTERACAO').AsInteger;
      vNivelExclusao := dataSet.FieldByName('NIVEL_EXCLUSAO').AsInteger;

      try
        dataSet.Cancel;
        dataSet.Filter := 'CADASTRO = ' + QuotedStr(vCadastro) + ' AND COD_EMP_ACESSO = ' + IntToStr(vEmpCod);
        dataSet.Filtered := True;

        if vCadastro = Trim(dataSet.FieldByName('CADASTRO').AsString) then
          raiseExceptionCreate('Acesso ao Cadastro já está no banco de dados!', 'DBComboBox116');

        if inherited insert then
        begin

          dataSet.FieldByName('CADASTRO').AsString := Trim(vCadastro);
          dataSet.FieldByName('COD_EMP_ACESSO').AsInteger := vEmpCod;
          dataSet.FieldByName('NIVEL_INCLUSAO').AsInteger := vNivelInsert;
          dataSet.FieldByName('NIVEL_ALTERACAO').AsInteger := vNivelAlteracao;
          dataSet.FieldByName('NIVEL_EXCLUSAO').AsInteger := vNivelExclusao;

          Result := inherited post;

          if Result then
            Result := Apply;

          if Result then
            Result := CommitaTransacao;

        end;

      finally
        dataSet.Filtered := False;
        dataSet.Filter := '';
      end;

    end
    else if dataSet.State  = dsEdit then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select * from CADASTROS_EMP' +
        ' where cadastro = ' + QuotedStr(Trim(dataSet.FieldByName('CADASTRO').AsString)) +
        ' and COD_EMP_ACESSO = ' + IntToStr(dataSet.FieldByName('COD_EMP_ACESSO').AsInteger) +
        ' and cadastro <> ' + QuotedStr(Trim(fCadastroEdit)) ;
      buscas.Open;

      if not buscas.IsEmpty then
        raiseExceptionCreate('Campo acesso ao cadastro não informado', 'DBComboBox116');

      Result := inherited post;

      if Result then
        Result := Apply;

      if Result then
        Result := CommitaTransacao;
    end;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;

end;

{ TRegrasVendas }

constructor TRegrasVendas.create;
begin
  if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  DataSet := TClientDataSet(DtmCadBasicos.cdsRegraVND);
  transacao := TIBTransaction(DtmCadBasicos.IBTRegrasVND);
  Buscas := TIBQuery.Create(nil);
  Buscas.Database := DtmCadBasicos.qrRegraVND.Database;
  buscas.Transaction := transacao;


  FdtSetTipo := TClientDataSet(DtmCadBasicos.cdsRegraTipo);
  DtmCadBasicos.dspRegraTipo.DataSet := DtmCadBasicos.qrRegraTipo;
  DtmCadBasicos.qrRegraTipo.Transaction := transacao;

  
  FdtSetTipoVendaOS := TClientDataSet(DtmCadBasicos.cdsRegraTipoVndOS);
  DtmCadBasicos.dspRegraTipoVndOS.DataSet := DtmCadBasicos.qrRegraTipoVndOS;
  DtmCadBasicos.qrRegraTipoVndOS.Transaction := transacao;


  FdtSetControle := TClientDataSet(DtmCadBasicos.cdsRegraControle);
  DtmCadBasicos.dspRegraControle.DataSet := DtmCadBasicos.qrRegraControle;
  DtmCadBasicos.qrRegraControle.Transaction := transacao;


  FdtSetCondPag := TClientDataSet(DtmCadBasicos.cdsRegraCondPag);
  DtmCadBasicos.dspRegraCondPag.DataSet := DtmCadBasicos.qrRegraCondPag;
  DtmCadBasicos.qrRegraCondPag.Transaction := transacao;
end;

function TRegrasVendas.Delete: boolean;
var
  vCodRegraVND:string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;
  vCodRegraVND := dataSet.FieldByName('COD_REGRAVND').AsString;
  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin
    if not vDadosIni.PesqPros('BAS342', 'EXCLUIR', '', 'REGRAS_VENDAS',
      dataSet.FieldByName('COD_REGRAVND').AsString, buscas, false) then
      Exit;
    if Application.MessageBox('Tem certeza que deseja enviar este registro para Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;
    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;
    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS342', 'MOVER', 'SUCESSO', 'REGRAS_VENDAS', vCodRegraVND, buscas)
    else
      vDadosIni.GravaAuditoria('BAS342', 'MOVER', 'FALHA', 'REGRAS_VENDAS', vCodRegraVND, buscas);
    Refresh;
    Exit;
  end;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;
  result := ExecutaComandosSqlExec('delete from REGRAS_VENDAS where COD_REGRAVND = ' +
    dataSet.FieldByName('COD_REGRAVND').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa);
  if result then
    result := CommitaTransacao
  else
    RollBackTransacao;
  if Result then
    vDadosIni.GravaAuditoria('BAS343', 'EXCLUIR', 'SUCESSO', 'REGRAS_VENDAS', vCodRegraVND, buscas)
  else
    vDadosIni.GravaAuditoria('BAS343', 'EXCLUIR', 'FALHA', 'REGRAS_VENDAS', vCodRegraVND, buscas);
  Refresh;
end;

destructor TRegrasVendas.destroy;
begin
  if FdtSetCondPag <> nil then
    FdtSetCondPag.Close;
  inherited;
end;

function TRegrasVendas.edit: boolean;
begin
  Result := False;
  if IsEmpty then
    exit;
  if dataSet.FieldByName('ATIVO').AsInteger=0 then
    exit;
  if not vDadosIni.PesqPros('BAS341', 'ALTERAR', '', 'REGRAS_VENDAS', dataset.fieldbyname('COD_REGRAVND').AsString, buscas, true) then
    Exit;
  Result := inherited Edit;
end;

function TRegrasVendas.Insert: boolean;
begin
  result:=false;
  if not vDadosIni.PesqPros('BAS340', 'INCLUIR', '', 'REGRAS_VENDAS', '', buscas, True) then
    Exit;
  if not dataSet.Active then
    montaSelect('select first 1 REGRAS_VENDAS.* from REGRAS_VENDAS where REGRAS_VENDAS.ativo=1');
  Result := inherited Insert;
  if Result then
  begin
    dataSet.FieldByName('TIPO').AsString := '.';
    dataSet.FieldByName('COD_EMPRESA').AsInteger := strtoint(vDadosIni.codEmpresa);
    dataSet.FieldByName('ATIVO').AsFloat := 1;
    dataSet.FieldByName('TIPOVND_OS').AsString := '.';
    dataSet.FieldByName('CODIGO_CTRL').AsInteger := 0;
  end;
end;

function TRegrasVendas.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not vDadosIni.PesqPros('BAS346', 'SALVAR', '', 'REGRAS_VENDAS',dataSet.FieldByName('COD_REGRAVND').AsString, buscas, true) then
      Exit;

    if (trim(dataSet.FieldByName('DESCRICAO').AsString) = '') then
      raiseExceptionCreate('Descrição deve ser informada.', 'DBEdit2');

    if ((trim(dataSet.FieldByName('PESSOAFISICA').AsString) = '') or
    	not((dataSet.FieldByName('PESSOAFISICA').AsString[1]='S') or (dataSet.FieldByName('PESSOAFISICA').AsString[1]='N')
    	or (dataSet.FieldByName('PESSOAFISICA').AsString[1]='A'))) then
      	raiseExceptionCreate('Selecione SIM para cliente pessoa física, NÃO para pessoa jurídica ou AMBOS', 'DBComboBox2');

  	if vDadosIni.StrToFloatFormat(dataSet.FieldByName('PARCELAMIN').AsFloat, 2) < 0 then
      raiseExceptionCreate('Valor da parcela mínima deve ser menor que zero.', 'DBEdit7');
      
    if dataSet.FieldByName('MAXPARCELAS').AsInteger < 0 then
      raiseExceptionCreate('Número de parcelas não pode ser menor que zero.', 'DBEdit8');

    if dataSet.FieldByName('PRAZOMAX').AsInteger <= 0 then
      raiseExceptionCreate('Informe o prazo máximo em dias para parcelamentos.', 'DBEdit3');

  	if dataSet.FieldByName('VALORMINDOC').IsNull then
    	dataSet.FieldByName('VALORMINDOC').AsFloat := 0;

    if dataSet.FieldByName('PARCELAMIN').IsNull then
    	dataSet.FieldByName('PARCELAMIN').AsFloat := 0;

    if dataSet.FieldByName('MAXPARCELAS').IsNull then
    	dataSet.FieldByName('MAXPARCELAS').AsFloat := 0;

    if dataSet.FieldByName('PRAZOMAX').IsNull then
    	dataSet.FieldByName('PRAZOMAX').AsFloat := 0;

    if acao = 'INSERIR' then
    begin
      DtmCadBasicos.SpIncCodigo.Transaction := transacao;
      dataSet.FieldByName('COD_REGRAVND').AsInteger := Gencodigo('REGRAS_VENDAS', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
    end;

    Result := inherited post;
    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;                             
    end;
    if result then
      Result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS346', acao, 'SUCESSO', 'REGRAS_VENDAS',dataSet.FieldByName('COD_REGRAVND').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS346', acao, 'FALHA', 'REGRAS_VENDAS', dataSet.FieldByName('COD_REGRAVND').AsString, buscas);
    if Result then
      Refresh;
  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TRegrasVendas._abrelixeira: boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('BAS344', 'ABRIR A LIXEIRA', '', 'REGRAS_VENDAS','', buscas, true) then
    Exit;
  if not _lixeiraCheia then
    Application.MessageBox('A lixeira está vazia.', 'Informação', 0 + 64)
  else
    result := montaSelect('select REGRAS_VENDAS.* from REGRAS_VENDAS where REGRAS_VENDAS.ATIVO = 0');
end;

procedure TRegrasVendas._cadRegrasVendas(pTipoForm: Integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Política de Pagamento');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
    vDadosIni.vTipoForm := pTipoForm;
    if not vDadosIni.PesqPros('BAS348', 'CONSULTA', '', 'REGRAS_VENDAS', '',DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;
    if FrmCadRegrasVendas = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TFrmCadRegrasVendas, FrmCadRegrasVendas);
    end;

    if (pTipoForm > 0) and (not FrmCadRegrasVendas.Visible) then
      FrmCadRegrasVendas.ShowModal
    else if (not FrmCadRegrasVendas.Visible) then
      FrmCadRegrasVendas.Show
    else if FrmCadRegrasVendas.FormStyle = fsMDIChild then
      FrmCadRegrasVendas.Show
    else
      FrmCadRegrasVendas.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TRegrasVendas._ListaControles(
  var pDBLookupComboBox: TDBLookupComboBox): boolean;
begin
  result:=false;
  try
    if dtSetControles = nil  then
    begin
      buscas.Close;
      buscas.SQL.Text:='select CODIGO_CTRL,NOME_CTRL from controles c where c.codigo_emp='+vDadosIni.codEmpresa+
      ' and c.ativo=1';
      buscas.Open;
      dtSource3 := TDataSource.Create(nil);
      dtSource4 := TDataSource.Create(nil);
      dtSetControles := TClientDataSet.Create(nil);
      dtSetControles.Close;
      dtSetControles.FieldDefs.Clear;
      dtSetControles.FieldDefs.Add('CODIGO_CTRL', ftInteger, 0, false);
      dtSetControles.FieldDefs.Add('NOME_CTRL', ftString, 35, false);
      dtSetControles.CreateDataSet;
      dtSetControles.LogChanges := False; //LogChanges = False, desabilita os logs de alteração e inserção dando performance na manipulação do ClientDataset
      buscas.First;
      while not buscas.Eof do
      begin
        dtSetControles.Append;
        dtSetControles.FieldByName('CODIGO_CTRL').AsString := buscas.FieldByName('CODIGO_CTRL').AsString;
        dtSetControles.FieldByName('NOME_CTRL').AsString := buscas.FieldByName('NOME_CTRL').AsString;
        dtSetControles.Post;
        buscas.Next;
      end;
      dtSource3.DataSet := dtSetControles;
      pDBLookupComboBox.ListSource := dtSource3;
      pDBLookupComboBox.ListField := 'NOME_CTRL;CODIGO_CTRL';
      pDBLookupComboBox.KeyField := 'CODIGO_CTRL';
      dtSource4.DataSet := dataSet;
      pDBLookupComboBox.DataSource := dtSource4;
      pDBLookupComboBox.DataField := 'CODIGO_CTRL';
    end;
    result := true;
    buscas.Close;
  except
  end;
end;

function TRegrasVendas._listarCondPag:boolean;
begin
  try
    result:=false;
    if IsEmpty then
      exit;
    if not vDadosIni.PesqPros('BAS349', 'EXIBIR', 'LISTAR CODIÇÕES DE PAGAMENTO', 'REGRAVND_CONDPAG', '',Buscas, False) then
      Exit;

    FdtSetCondPag.Close;
    FdtSetCondPag.CommandText := ' select cp.cod_cond_pag, cp.desc_cond_pag, ' +
      ' (select distinct rv.cod_regravnd ' +
      '  from regravnd_condpag rc ' +
      '  inner join regras_vendas rv on ' +
      '	   rc.cod_regravnd = rv.cod_regravnd ' +
      ' 	 and rc.cod_empresa = rv.cod_empresa ' +
      '  where rc.cod_regravnd = ' + IntToStr(dataSet.FieldByName('COD_REGRAVND').AsInteger) +
      '  and rv.cod_empresa = ' + vDadosIni.codEmpresa +
      '  and cp.cod_cond_pag = rc.cod_cond_pag ' +
      ' ) as cod_regravnd from cond_pag cp ' +
      ' where cp.ativo = 1 ' +
      ' order by 3 desc, 2 ';
    FdtSetCondPag.open;
    result:=true;
  except
    result:=false;
  end;
end;

function TRegrasVendas._listarControle: boolean;
begin
