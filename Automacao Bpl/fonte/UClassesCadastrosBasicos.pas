function TMarcas._restauralixeira: boolean;
var
	vCod_Marca: string;
	vDesc_Marca: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCod_Marca  := trim(dataSet.FieldByName('COD_MARCA').AsString);
      vDesc_Marca := trim(dataSet.FieldByName('DESCRICAO_MARCA').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCod_Marca  := '';
        vDesc_Marca := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCod_Marca) <> '') then
      	prepare_loop('COD_MARCA = ' + vCod_Marca)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'MARCA' + #13 +
        'Código: ' + vCod_Marca + #13 +
        'Descrição: ' + vDesc_Marca;

      if (trim(vCod_Marca) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('BAS012', 'RESTAURAR', '', 'MARCA_PROD',
        vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando marca(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando marca(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update marca_prod set ativo = 1 ' +
          ' where cod_marca = %d ',
          [fint('cod_marca')], buscas);

        if (trim(vCod_Marca) = '') then
          vDadosIni.GravaAuditoria('BAS012', 'RESTAURAR', '', 'MARCA_PROD',
            dataSet.FieldByName('COD_MARCA').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('BAS012', 'RESTAURAR', 'SUCESSO', 'MARCA_PROD',
        vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('BAS012', 'RESTAURAR', 'FALHA', 'MARCA_PROD',
        vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TMarcas._VerificarCampos(qtde_tratamento: integer; acao, campo_chave,
  campo, tabela, mensagem_naoinformado, mensagem_jacadastrado: string);
begin
  { Verificação do campo se não foi informado e se já tem este campo no banco
qtde_tratamento : quantidade de tratamentos que fará no campo
opções: 1 - tratamento  somente de campo não informado
      2 - tratamento anterior e de informação já cadastrada
acao : 'INSERIR' ou 'EDITAR' (somente aceita essas strings)
campo_chave: campo chave primaria na tabela do banco
campo : campo de verificação
tabela : tabela do banco de dados
mensagem_naoinformado : Mensagem de campo não informado para exibir
mensagem_jacadastrado : Mensagem de informação já cadastrada para exibir
}
  if trim(dataSet.FieldByName(campo).AsString) = '' then
  begin
    if (qtde_tratamento >= 1) then
    begin
      raise exception.create(mensagem_naoinformado);
    end
  end
  else
  begin
    if acao = 'EDITAR' then
    begin
      if (qtde_tratamento >= 2) then
        if trim(dataSet.FieldByName(campo).OldValue) <>
          trim(dataSet.FieldByName(campo).NewValue) then
          if ExecutaComandosSql('select ' + campo_chave + ' from ' + tabela + ' where ' + campo +
            ' = ' +
            quotedstr(dataSet.FieldByName(campo).AsString)) then
          begin
            raise exception.create(mensagem_jacadastrado);
          end
    end
    else if (qtde_tratamento >= 2) then
      if ExecutaComandosSql('select ' + campo_chave + ' from ' + tabela + ' where ' + campo + ' = '
        +
        quotedstr(dataSet.FieldByName(campo).AsString)) then
      begin
        raise exception.create(mensagem_jacadastrado);
      end

  end;
end;

