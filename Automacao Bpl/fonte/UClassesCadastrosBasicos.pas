function TCFOPMud.restauraLixeira: boolean;
begin
  result := false;
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if vDadosIni.PesqPros('BAS032', 'RESTAURAR', '', 'CFOP_MUD', '', buscas, true) then
          //        if vDadosIni.PesqPros('BAS032', '', buscas, false) then
          if Edit then
          begin
            dataSet.FieldByName('ATIVO').asinteger := 1;
            if inherited Post then
              if Apply then
                if CommitaTransacao then
                  result := true;
          end;
        if result then
          vDadosIni.GravaAuditoria('BAS032', 'RESTAURAR', 'SUCESSO', 'CFOP_MUD', ' UFO = ' +
            dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
            dataSet.FieldByName('UF_DESTINO').AsString, buscas)
            //          vDadosIni.GravaAuditoria('BAS032', ' UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString +
//            ' UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString + ' Sucesso ao restaurar', buscas)
        else
          vDadosIni.GravaAuditoria('BAS032', 'RESTAURAR', 'FALHA', 'CFOP_MUD', ' UFO = ' +
            dataSet.FieldByName('CODIGO_UF').AsString + ' UFD = ' +
            dataSet.FieldByName('UF_DESTINO').AsString, buscas);
        //
        //          vDadosIni.GravaAuditoria('BAS032', ' UFO = ' + dataSet.FieldByName('CODIGO_UF').AsString +
        //            ' UFD = ' + dataSet.FieldByName('UF_DESTINO').AsString + ' Falha ao restaurar', buscas)
      end;
    end
    else
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
        'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION +
        MB_DEFBUTTON1);
    end;
  Refresh;
end;

