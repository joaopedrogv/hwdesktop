      MB_DEFBUTTON1);
    montaSelect('SELECT * FROM TIPO_RESERVA WHERE ativo=1');
    result := false;
  end
  else
    result := montaSelect('SELECT * FROM TIPO_RESERVA WHERE ativo<>1');
end;

procedure TTipoReserva._CadTipoReserva(TipoForm: integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Tipo de Reserva');
    vDadosIni.vTipoForm := TipoForm;
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    if not vDadosIni.PesqPros('BAS352', 'CONSULTA', '', 'TIPO_RESERVA', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadTipoReserva = nil then
    begin
      if TipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadTipoReserva, frmCadTipoReserva);
    end;

    if (TipoForm > 0) and (not frmCadTipoReserva.Visible) then
      frmCadTipoReserva.ShowModal
    else if (not frmCadTipoReserva.Visible) then
      frmCadTipoReserva.Show
    else if frmCadTipoReserva.FormStyle = fsMDIChild then
      frmCadTipoReserva.Show
    else
      frmCadTipoReserva.ShowModal;
  finally
