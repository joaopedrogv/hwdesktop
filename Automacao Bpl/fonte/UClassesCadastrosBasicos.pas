	Result := False;
  if not vDadosIni.PesqPros('BAS455', 'ALTERAR', '', 'CONCILIACAO_COD_AJUSTE',
    dataSet.FieldByName('id').AsString, buscas, false) then
    Exit;

  if inherited Edit then
  begin
    Result := True;
    dataSet.FieldByName('ID').AsInteger := dataSet.FieldByName('ID').AsInteger;

    ConciliacaoCodAjustePContasE.abreConciliacaoCodAjustePContasE;
    ConciliacaoCodAjustePContasS.abreConciliacaoCodAjustePContasS;
  end;
end;

function TConciliacaoCodAjuste.post: boolean;
var
  acao: string;
  codigo: integer;
  vCodFormula: string;
begin
  try
    Result := false;

    vCodFormula := dataSet.FieldByName('ID').AsString;

    if not vDadosIni.PesqPros('BAS456', 'SALVAR', '', 'CONCILIACAO_COD_AJUSTE',
      vCodFormula, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataSet.FieldByName('ID').AsInteger <= 0 then
      raiseExceptionCreate('Id do ajuste deve ser informado', 'DBEdit4');

    if dataSet.FieldByName('N_CONTA_PLC_E').AsFloat > 0 then
    begin
    	if not ConciliacaoCodAjustePContasE.buscarNumConta(
      	dataSet.FieldByName('N_CONTA_PLC_E').AsFloat) then
	    		raiseExceptionCreate('Nº de Plano de Conta (Entrada) não encontrado', 'DBEdit2');

      if not ConciliacaoCodAjustePContasE.buscarNumContaNatureza(
      	dataSet.FieldByName('N_CONTA_PLC_E').AsFloat) then
        	raiseExceptionCreate('Plano de Conta não é de Entrada', 'DBEdit2');
    end;

    if dataSet.FieldByName('N_CONTA_PLC_S').AsFloat > 0 then
    begin
    	if not ConciliacaoCodAjustePContasS.buscarNumConta(
      	dataSet.FieldByName('N_CONTA_PLC_S').AsFloat) then
	    		raiseExceptionCreate('Nº de Plano de Conta (Saída) não encontrado', 'DBEdit3');

      if not ConciliacaoCodAjustePContasS.buscarNumContaNatureza(
      	dataSet.FieldByName('N_CONTA_PLC_S').AsFloat) then
        	raiseExceptionCreate('Plano de Conta não é de Saída', 'DBEdit3');
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS456', acao, 'SUCESSO', 'CONCILIACAO_COD_AJUSTE',
        vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS456', acao, 'FALHA', 'CONCILIACAO_COD_AJUSTE',
        vCodFormula, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

