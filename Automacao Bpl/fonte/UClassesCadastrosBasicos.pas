function TEmpresa.GravarLogo: boolean;
var
 ImageCli: TImage;
 b: TMemoryStream;
begin
  Result := true;

  try

  if trim(dataSet.FieldByName('USAR_LOGO').AsString) <> 'S' then
  begin
   buscas.Close;
   buscas.SQL.Text := 'delete from fotos ' +
     ' where coalesce(codigo, 0) = 0 and tipo = 3 ' +
     ' and cod_empresa=' + vDadosIni.codEmpresa;
   buscas.ExecSQL;
   exit;
  end;

  if trim(dataSet.FieldByName('NFE_LOGOMARCA').AsString) = '' then
   exit;

 if not FileExists(trim(dataSet.FieldByName('NFE_LOGOMARCA').AsString)) then
  exit;

  ImageCli := TImage.Create(nil);

  ImageCli.Picture.LoadFromFile(trim(dataSet.FieldByName('NFE_LOGOMARCA').AsString));
  b := TMemoryStream.Create;
  ImageCli.Picture.Graphic.SaveToStream(b);

  if ExecutaComandosSql('select * from fotos where coalesce(codigo, 0) = 0 and tipo =3 ' +
   ' and cod_empresa=' + vDadosIni.codEmpresa) then
 begin
   buscas.Close;
   buscas.SQL.Text := 'update fotos set foto = :pFoto_jpg ' +
     ' where coalesce(codigo, 0) = 0 and tipo = 3 ' +
     ' and cod_empresa=' + vDadosIni.codEmpresa;
   buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
   buscas.ExecSQL;
 end
 else
 begin
   buscas.Close;
   buscas.SQL.Text := 'INSERT INTO FOTOS (CODIGO, TIPO, COD_EMPRESA,FOTO, EXTENSAO, NITEM, DESCRICAO) ' +
     ' VALUES (0, 3, ' + vDadosIni.codEmpresa + ' ,:pFoto_jpg, ''jpg'' ,1, ''EMPRESA'')';
   buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
   buscas.ExecSQL;
 end;
 if ImageCli <> nil then
   ImageCli.Destroy;
 if b <> nil then
   b.Destroy;

  except
  end;
end;

function TEmpresa.insert: boolean;
var
  I: Integer;
begin
  if not dataset.Active then
    montaSelect('select * from empresa where 1 = 0');

  if inherited Insert then
  begin
    result := true;
    if Application.MessageBox('Deseja carregar dados de uma empresa já cadastrada?',
      'Confirmação',
      MB_ICONQUESTION + MB_YESNO) = IDYES then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select first 1 * from empresa order by cod_empresa';
      buscas.Open;
      for I := 0 to dataSet.FieldCount - 1 do
        dataSet.FieldByName(dataSet.Fields[i].FieldName).Value :=
          buscas.FieldByName(dataSet.Fields[i].FieldName).Value;
      buscas.Close;
      dataSet.FieldByName('cod_empresa').AsString := '';
      dataSet.FieldByName('cgc_emp').AsString := '';
      dataSet.FieldByName('fantasia_emp').AsString := '';
      dataSet.FieldByName('nome_emp').AsString := '';
      dataSet.FieldByName('endreco_emp').AsString := '';
      dataSet.FieldByName('numero_end').AsString := '';
      dataSet.FieldByName('complemento_emp').AsString := '';
      dataSet.FieldByName('bairro_emp').AsString := '';
      dataSet.FieldByName('cidade_emp').AsString := '';
      dataSet.FieldByName('cep_emp').AsString := '';
      dataSet.FieldByName('telefone_emp').AsString := '';
      dataSet.FieldByName('ie_emp').AsString := '';
      dataSet.FieldByName('im_emp').AsString := '';
      dataSet.FieldByName('prop_emp').AsString := '';
      dataSet.FieldByName('filial').AsString := '';
      dataSet.FieldByName('observ_emp').AsString := '';
      dataSet.FieldByName('mensagem_emp').AsString := '';
      dataSet.FieldByName('email_emp').AsString := '';
      dataSet.FieldByName('sped_matriz_filial').AsString := 'F';
      dataSet.FieldByName('email_emp').AsString := '';

      buscas.Close;
      buscas.SQL.Text := 'select max(cod_empresa) cod_empresa from empresa';
      buscas.Open;

      if buscas.FieldByName('cod_empresa').AsInteger > 0 then
        dataSet.FieldByName('cod_empresa').AsInteger :=
          buscas.FieldByName('cod_empresa').AsInteger + 1;
      buscas.Close;

      vContaLig.abreContasLig;
      vContaLigContabil.abreContasLigContabil;

    end;
    CriarProcesso := true;
  end
  else
    result := false;
end;

function TEmpresa.post: boolean;
var
  vEstado: string;
  acao, vTmp: string;
begin
  try
    Result := false;
    if not (dataSet.State in [dsEdit, dsInsert]) then
    begin
      Result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if not vDadosIni.PesqPros('BAS079', acao, '', 'EMPRESA',
      dataSet.FieldByName('COD_EMPRESA').AsString, buscas) then
      Exit;

    dataSet.FieldByName('cgc_emp').AsString := Trim(dataSet.FieldByName('cgc_emp').AsString);
    dataSet.FieldByName('MENSAGEM_EMP').AsString := UpperCase(dataSet.FieldByName('MENSAGEM_EMP').AsString); 

    if dataset.FieldByName('CGC_EMP').AsString = '' then
      raiseExceptionCreate('Campo CPNJ não informado.', 'DBEDIT8');

    if dataset.FieldByName('ALMOX').AsString = 'S2' then
    begin
    	if Pos('S', dataset.FieldByName('CONF_CEGA_SAIDA').AsString) > 0 then
      	raiseExceptionCreate('Não é possivel utilizar a conferência cega com o estoque fechado ativado!', 'DBComboBox118');
      if dataset.FieldByName('USAR_SEPARACAO_PED').AsString = 'S' then
      	raiseExceptionCreate('Não é possivel utilizar a separação com o estoque fechado ativado!', 'DBComboBox146');
    end;

    if not cgc(dataset.FieldByName('CGC_EMP').AsString) then
      raiseExceptionCreate('CPNJ Invalido.', 'DBEDIT8');

    if dataset.FieldByName('NOME_EMP').AsString = '' then
      raiseExceptionCreate('Campo Nome da Empresa não informado.', 'DBEDIT2');

    if dataset.FieldByName('FANTASIA_EMP').AsString = '' then
      raiseExceptionCreate('Campo Nome Fantasia da Empresa não informado.', 'DBEDIT129');

    if dataset.FieldByName('ENDRECO_EMP').AsString = '' then
      raiseExceptionCreate('Campo Endereço não informado.', 'DBEDIT113');

    if dataset.FieldByName('NUMERO_END').AsString = '' then
      raiseExceptionCreate('Campo Numero do Endereço não informado.', 'DBEDIT3');

    if dataset.FieldByName('BAIRRO_EMP').AsString = '' then
      raiseExceptionCreate('Campo Bairro não informado.', 'DBEDIT4');

    if dataset.FieldByName('CEP_EMP').AsString = '' then
      raiseExceptionCreate('Campo CEP não informado.', 'DBEDIT6');

    if dataset.FieldByName('NUMERO_END').AsString = '' then
      raiseExceptionCreate('Campo Numero do Endereço não informado.', 'DBEDIT3');

    if dataset.FieldByName('UF_EMP').AsString = '' then
      raiseExceptionCreate('Campo UF não informado.', 'DBLookupComboBox1');

    if (Trim(dataset.FieldByName('ALMOX').AsString) = 'S1') or (Trim(dataset.FieldByName('ALMOX').AsString) = 'S2') then
      if Trim(dataset.FieldByName('MONTAR_REQ_AUT_NF').AsString) = 'S' then
        raiseExceptionCreate('Controle de estoque ativado. A montagem de requisição automática pela nota fiscal não deve ficar ativa.', 'DBComboBox79');

    if pos('.', dataSet.FieldByName('IE_EMP').asString) > 0 then
      raiseExceptionCreate('Digitar a Incrição Estadual sem Ponto.', 'DBEDIT9');

    if pos('-', dataSet.FieldByName('IE_EMP').asString) > 0 then
      raiseExceptionCreate('Digitar a Incrição Estadual sem Traço.', 'DBEDIT9');

    if pos('/', dataSet.FieldByName('IE_EMP').asString) > 0 then
      raiseExceptionCreate('Digitar a Incrição Estadual sem Barra.', 'DBEDIT9');

    if not ((dataset.FieldByName('VERSAO_ABRASF').AsInteger = 1) or (dataset.FieldByName('VERSAO_ABRASF').AsInteger = 2)) then
      raiseExceptionCreate('Versão Abrasf inválida.', 'DBComboBox90');

    if not ((Trim(dataset.FieldByName('USARENVRPSSINCRONO').AsString) = 'N') or (Trim(dataset.FieldByName('USARENVRPSSINCRONO').AsString) = 'S')) then
      raiseExceptionCreate('Envio de Lote Rps Abrasf inválido.', 'DBComboBox91');

    if (Trim(dataset.FieldByName('PRE_NOTA_TRANSF_CFOP').AsString) <> '') or (Trim(dataset.FieldByName('PRE_NOTA_TRANSF_CNPJ').AsString) <> '') then
    begin
      if Trim(dataset.FieldByName('PRE_NOTA_TRANSF_CFOP').AsString) = '' then
        raiseExceptionCreate('"CFOP''s de Transferencia para Gerar Pre Nota na Outra Empresa" deve ser informado quando o "CNPJ''s da outra empresa onde sera gerada a Pre Nota" for informado', 'DBListBox1');

      if Trim(dataset.FieldByName('PRE_NOTA_TRANSF_CNPJ').AsString) = '' then
        raiseExceptionCreate('"CNPJ''s da outra empresa onde sera gerada a Pre Nota" deve ser informado quando o "CFOP''s de Transferencia para Gerar Pre Nota na Outra Empresa" for informado', 'DBListBox2');
    end;


    if Trim(dataset.FieldByName('MODELO_NF').AsString) = '55' then
    begin
      if Length(Trim(dataset.FieldByName('NOME_EMP').AsString)) < 2 then
        raiseExceptionCreate('Campo Nome da Empresa deve ter no mínimo 2 dígitos.', 'DBEDIT2');

      if Length(Trim(dataset.FieldByName('ENDRECO_EMP').AsString)) < 2 then
        raiseExceptionCreate('Campo Endereço deve ter no mínimo 2 dígitos.', 'DBEDIT113');

      if Length(Trim(dataset.FieldByName('BAIRRO_EMP').AsString)) < 2 then
        raiseExceptionCreate('Campo Bairro deve ter no mínimo 2 dígitos.', 'DBEDIT4');

      if Length(Trim(dataset.FieldByName('IBGE_COD_CIDADE').AsString)) <> 7 then
        raiseExceptionCreate('Campo Cod IBGE Cidade deve ter 7 dígitos.', 'DBEdit103');

      if Length(Trim(dataset.FieldByName('IBGE_CODIGO_UF').AsString)) <> 2 then
        raiseExceptionCreate('Campo Cod IBGE Estado deve ter 2 dígitos.', 'DBEdit104');

      if Length(Trim(dataset.FieldByName('CIDADE_EMP').AsString)) < 2 then
        raiseExceptionCreate('Campo Cidade deve ter no mínimo 2 dígitos.', 'DBEdit5');

      vTmp := StringReplace(Trim(dataset.FieldByName('TELEFONE_EMP').AsString), '(', '', [rfReplaceAll]);
      vTmp := StringReplace(vTmp, ')', '', [rfReplaceAll]);
      vTmp := StringReplace(vTmp, '-', '', [rfReplaceAll]);

      if Length(Trim(vTmp)) < 6 then
        raiseExceptionCreate('Campo Telefone deve ter no mínimo 6 dígitos.', 'DBEdit7');

      if Length(Trim(dataset.FieldByName('IE_EMP').AsString)) < 2 then
        raiseExceptionCreate('Campo Inscrição Estadual deve ter no mínimo 2 dígitos.', 'DBEdit9');

    end;

//    if ((Trim(dataSet.FieldByName('USPREVENDA_OS').asString) = 'S') or
//      (Trim(dataSet.FieldByName('USPREVENDA').asString) = 'S')) and
//      (Trim(dataSet.FieldByName('PAF_USAR_PREVENDA').asString) = 'S') then
//      raiseExceptionCreate('"Pré-Venda" e "DAV/DAV-OS" ativados, apenas um deverá ficar ativado', 'DBComboBox12');

    if dataSet.FieldByName('IE_EMP').asString = '' then
      dataSet.FieldByName('IE_EMP').asString := 'ISENTO';

    vEstado := retornaValor('select SIGLA_UF as valor from Estados where CODIGO_UF = ' +
      dataset.FieldByName('UF_EMP').AsString);

    if ConsisteInscricaoEstadual(dataSet.FieldByName('IE_EMP').asString, trim(vEstado)) <> 0 then
      raiseExceptionCreate('Inscrição Estadual Invalida.', 'DBEDIT9');

    if dataSet.FieldByName('VND_TOLER_PERC_MARKUP').AsFloat < 0 then
      raiseExceptionCreate('Campo "Percentual de Tolerancia na Venda a menor do MarkUp" não deve ser negativo.', '');

    if dataSet.FieldByName('VND_TOLER_PERC_MARKUP').AsFloat >= 100 then
      raiseExceptionCreate('Campo "Percentual de Tolerancia na Venda a menor do MarkUp" não deve ser maior ou igual a 100%.', '');

    if Trim(dataSet.FieldByName('USAR_SEPARACAO_PED').AsString) = 'S' then
    begin
      if Trim(dataSet.FieldByName('OC_USAR_ORDEM_CARREGAMENTO').AsString) = 'S' then
        raiseExceptionCreate('Campo "Usar separação no Pedido(REQ)"  aba "Configurações do Sistema/Venda/2" igual a "S", campo "Usar Ordem de Carregamento" aba "Configurações do Sistema/Carregamento" não pode ser igual "S" ou "D"', '')
      else if Trim(dataSet.FieldByName('OC_USAR_ORDEM_CARREGAMENTO').AsString) = 'D' then
        raiseExceptionCreate('Campo "Usar separação no Pedido(REQ)"  aba "Configurações do Sistema/Venda/2" igual a "S", campo "Usar Ordem de Carregamento" aba "Configurações do Sistema/Carregamento" não pode ser igual "S" ou "D"', '')
      else if Trim(dataSet.FieldByName('ALMOX').AsString) = 'S2' then
        raiseExceptionCreate('Campo "Usar separação no Pedido(REQ)"  aba "Configurações do Sistema/Venda/2" igual a "S", campo "Usar Controle de Estoque Fechado" aba "Configurações do Sistema/Venda/1" não pode ser igual "S2"', '');
    end;

    if not checkNumSerieCertificadoNFe then
      Exit;

    if dataSet.FieldByName('SPED_COD_INC_TRIB').AsInteger = 1 then
    begin
      if (vDadosIni.StrToFloatFormat(dataSet.FieldByName('pis_emp').AsFloat, 2) <>
        vDadosIni.StrToFloatFormat(1.65, 2)) or
        (vDadosIni.StrToFloatFormat(dataSet.FieldByName('cofins_emp').AsFloat, 2) <>
        vDadosIni.StrToFloatFormat(7.60, 2)) then
      begin
        if
          Application.MessageBox('Deseja alterar as alíquitas de PIS e da COFINS para 1,65% e 7,60% do regime de Incidência Não Cumulativa?',
          'Atenção', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          dataSet.FieldByName('pis_emp').AsFloat := 1.65;
          dataSet.FieldByName('cofins_emp').AsFloat := 7.60;
        end;
      end;
    end
    else if dataSet.FieldByName('SPED_COD_INC_TRIB').AsInteger = 2 then
    begin
      if (vDadosIni.StrToFloatFormat(dataSet.FieldByName('pis_emp').AsFloat, 2) <>
        vDadosIni.StrToFloatFormat(0.65, 2)) or
        (vDadosIni.StrToFloatFormat(dataSet.FieldByName('cofins_emp').AsFloat, 2) <>
        vDadosIni.StrToFloatFormat(3.00, 2)) then
      begin
        if
          Application.MessageBox('Deseja alterar as alíquitas de PIS e da COFINS para 0,65% e 3,00% do regime de Incidência Cumulativa?',
          'Atenção', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          dataSet.FieldByName('pis_emp').AsFloat := 0.65;
          dataSet.FieldByName('cofins_emp').AsFloat := 3.00;
        end;
      end;
    end;

    if vDadosIni.vModoTreino = 'S' then
      if dataSet.State in [dsEdit, dsInsert] then
      begin
        if pos('MODO TREINAMENTO', dataSet.FieldByName('IDENTIFICACAO_EMP').AsString) = 0 then
          dataSet.FieldByName('IDENTIFICACAO_EMP').AsString :=
            'MODO TREINAMENTO ' + dataSet.FieldByName('IDENTIFICACAO_EMP').AsString;
        dataSet.FieldByName('NFE_LOGPATH').AsString := 'C:\Treinamento\Hw\NFe';
        dataSet.FieldByName('WEBSERV_AMBIENTE').AsString := 'Homologação';
      end;

    //    if dataset.FieldByName('SERIE_SCAN').IsNull then
    //      raiseExceptionCreate('Campo Série SCAN não preenchido.','DBEDIT106');
    if not AtualizarAgendaOficina then
      exit;

    if obEmpresa.dataSet.State = dsEdit then
      AtualizarTipoPreco;

     if (obEmpresa.dataSet.State in [dsInsert, dsEdit]) then
      GravarLogo;

    if trim(dataSet.FieldByName('TP_EMP').AsString) = 'C' then
      dataSet.FieldByName('CONCESS').AsString := 'S'
    else
      dataSet.FieldByName('CONCESS').AsString := 'N';

    DtmCadBasicos.SpIncCodigo.Transaction := transacao;
    if dataSet.State = dsInsert then
    begin
      if dataset.FieldByName('COD_EMPRESA').AsInteger = 0 then
      begin
        dataset.FieldByName('COD_EMPRESA').AsInteger := Gencodigo('EMPRESA',
          DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
        buscas.close;
        buscas.SQL.Text := 'SELECT GEN_ID(INC_COD_EMPRESA,1) FROM rdb$Database';
        buscas.Open;
        dataset.FieldByName('COD_EMPRESA').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
        buscas.close;
      end;

      obEmpresa.GerarMenus(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarTabCodigo(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarSenha(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarTipoPreco(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarRegrasCFOPCstEntrada(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarRegrasTravOSREQ(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarContasLigacao(dataset.FieldByName('COD_EMPRESA').AsInteger);
      obEmpresa.GerarRegrasProgFid(dataset.FieldByName('COD_EMPRESA').AsInteger);
      vProcesso.abreProcesso;
      vProcesso.gravarProcesso(dataset.FieldByName('COD_EMPRESA').AsInteger);
    end;

    if vContaLig.dataSet.State = dsInsert then
      vContaLig.dataSet.FieldByName('cod_emp').AsInteger :=
        dataset.FieldByName('COD_EMPRESA').AsInteger;
    if vContaLigContabil.dataSet.State = dsInsert then
      vContaLigContabil.dataSet.FieldByName('cod_empresa').AsInteger :=
        dataset.FieldByName('COD_EMPRESA').AsInteger;

    dataSet.FieldByName('LICENCANFSE').AsString := vDadosIni.codifica(dataSet.FieldByName('LICENCANFSE').AsString);

    result := inherited post;

    if (dataset.ChangeCount = 0) then
    begin
      Cancel;
      if (vTx.teveAlteracao) and (acao = 'EDITAR') then
        CommitaTransacao;
      result := true;
      exit;
    end;

    if result then
      result := apply;

    if result then
    begin
      //      if acao = 'INSERIR' then
      //      begin
      //        buscas.close;
      //        buscas.SQL.Text := 'SELECT GEN_ID(INC_COD_EMPRESA,1) FROM rdb$Database';
      //        buscas.Open;
      //        buscas.close;
      //      end;
      vProcesso.Apply;
      result := CommitaTransacao;
      if acao = 'INSERIR' then
	      obEmpresa.atualizarTabelaCodigo(dataset.FieldByName('COD_EMPRESA').AsInteger);
      vDadosIni.atualizarVariaveisEmpresa(buscas);
    end;

    if Result then
    begin
      vDadosIni.GravaAuditoria('BAS079', acao, 'SUCESSO', 'EMPRESA',
        dataSet.FieldByName('COD_EMPRESA').AsString, buscas);
    end
    else
      vDadosIni.GravaAuditoria('BAS079', acao, 'FALHA', 'EMPRESA',
        dataSet.FieldByName('COD_EMPRESA').AsString, buscas);
    if Result then
      Refresh
    else
    begin
      vProcesso.CancelUpdates;
      cancel;
    end;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TEmpresa.restauraLixeira: boolean;
begin
  result := false;
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if inherited Edit then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          result := inherited Post;
          if Result then
            result := Apply;
          if Result then
            result := CommitaTransacao;
          if Result then
            vDadosIni.GravaAuditoria('BAS077', 'RESTAURAR REGISTRO', 'SUCESSO', 'EMPRESA',
              dataSet.FieldByName('COD_EMPRESA').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS077', 'RESTAURAR REGISTRO', 'FALHA', 'EMPRESA',
              dataSet.FieldByName('COD_EMPRESA').AsString, buscas);
        end;
      end;
    end;
  Refresh;
end;

function TEmpresa.statusLixeira: boolean;
begin
  result := ExecutaComandosSql('select cod_empresa from empresa where ativo = 0 and cod_empresa = '
    +
    vDadosIni.codEmpresa);
end;

