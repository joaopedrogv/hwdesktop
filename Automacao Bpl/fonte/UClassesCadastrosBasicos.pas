procedure TNaturezaOperacao.cadNatOperacao(TipoForm: integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Natureza de Operação');
    vDadosIni.vTipoForm := TipoForm;

    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    if frmCadNaturezaOperacao = nil then
    begin
      if TipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TfrmCadNaturezaOperacao, frmCadNaturezaOperacao);
    end;

    if (TipoForm > 0) and (not frmCadNaturezaOperacao.Visible) then
      frmCadNaturezaOperacao.ShowModal
    else if (not frmCadNaturezaOperacao.Visible) then
      frmCadNaturezaOperacao.Show
    else if frmCadNaturezaOperacao.FormStyle = fsMDIChild then
      frmCadNaturezaOperacao.Show
    else
      frmCadNaturezaOperacao.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

constructor TNaturezaOperacao.create;
begin
  if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsNatOperacao);
  buscas := tibquery(DtmCadBasicos.qrBuscas);
  transacao := tibtransaction(DtmCadBasicos.IBTransCadastroBasico);
  vRegCfopCST := TRegrasCFOP_CST.create;
  vDescNatOp := TDescricaoNatOP.create;
  montaSelect('select * from nat_op where CODIGO_NOP = 0');
  vTextoInfComplementar := TStringList.Create;
  FCodContaContabil := '';
end;

function TNaturezaOperacao.delete: boolean;
var
  codCFOP: string;
begin
  result := false;
  if dataSet.IsEmpty then
    exit;
  codCFOP := dataSet.FieldByName('CODIGO_NOP').AsString;
  try
    if dataSet.FieldByName('ATIVO').AsInteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
        'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
      begin
        if verificaNFvenda(dataSet.FieldByName('CODIGO_NOP').AsString) then
          raise Exception.Create('O registro não pode ser excluido porque esta sendo' + #13 +
            'usado por uma NF de Venda.');

        if verificaNFEntrada(dataSet.FieldByName('CODIGO_NOP').AsString) then
          raise Exception.Create('O registro não pode ser excluido porque esta sendo' + #13 +
            'usado por uma NF de Entrada.');

        result := inherited Delete;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria('BAS065', 'EXCLUIR', 'SUCESSO', 'NAT_OP', codCFOP, buscas)
        else
          vDadosIni.GravaAuditoria('BAS065', 'EXCLUIR', 'FALHA', 'NAT_OP', codCFOP, buscas);
      end;
    end
    else if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      if Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 0;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria('BAS066', 'ENVIAR REGISTRO PARA A LIXEIRA', 'SUCESSO', 'NAT_OP',
            codCFOP, buscas)
        else
          vDadosIni.GravaAuditoria('BAS066', 'ENVIAR REGISTRO PARA A LIXEIRA ', 'FALHA', 'NAT_OP',
            codCFOP, buscas);
      end;
    end;
  finally
    Refresh;
  end;
end;

destructor TNaturezaOperacao.Destroy;
begin
  FreeAndNil(vRegCfopCST);
  FreeAndNil(vDescNatOp);
  inherited;
end;

