begin

  inherited;
end;

function TDepartamentos.Insert: boolean;
begin
  result := inherited Insert;
  if result then
  begin
    abreDeptoFinanceiro;
    PreencheCampos;
  end;
end;

function TDepartamentos.post: boolean;
var
  acao: string;
begin
  try
    Result := false;
    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

//    if Trim(dataset.FieldByName('INICIAIS_DEPTO').AsString) = '' then
//    	dataset.FieldByName('INICIAIS_DEPTO').AsString := Copy(Trim(dataset.FieldByName('NOME_DEPTO').AsString), 1, 3);

    if Trim(dataset.FieldByName('NOME_DEPTO').AsString) = '' then
      raiseExceptionCreate('Campo Descrição não informado.', 'DBEDIT2');

    if Trim(dataset.FieldByName('NOME_DEPTO').AsString) <> '' then
     if ExecutaComandosSql('select COD_DEPTO from DEPTO ' +
       ' where NOME_DEPTO = ' +  quotedstr(dataSet.FieldByName('NOME_DEPTO').AsString) +
       ' and COD_DEPTO <> ' + IntToStr(dataSet.FieldByName('COD_DEPTO').AsInteger)) then
       raiseExceptionCreate('Já existe um departamento cadastrado com este nome.', 'DBEDIT2');

//    if Trim(dataset.FieldByName('INICIAIS_DEPTO').AsString) <> '' then
//     if ExecutaComandosSql('select COD_DEPTO from DEPTO ' +
//       ' where INICIAIS_DEPTO = ' +  quotedstr(dataSet.FieldByName('INICIAIS_DEPTO').AsString) +
//       ' and COD_DEPTO <> ' + IntToStr(dataSet.FieldByName('COD_DEPTO').AsInteger)) then
//       raiseExceptionCreate('Já existe um departamento cadastrado com estas iniciais.', 'DBEdit3');
//    else
//    begin
//      {if acao = 'EDITAR' then
//      begin
//        if trim(dataSet.FieldByName('NOME_DEPTO').OldValue) <>
//          trim(dataSet.FieldByName('NOME_DEPTO').NewValue) then
//          if ExecutaComandosSql('select COD_DEPTO from DEPTO where NOME_DEPTO = ' +
//            quotedstr(dataSet.FieldByName('NOME_DEPTO').AsString)) then
//            raise exception.create('Já existe um departamento cadastrado com este nome.');
//      end
