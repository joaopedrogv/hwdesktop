         	' (CLIENTES.CODIGO_UF ' + tempTipo + QuotedStr('%' + rSugServico.vValor + '%') + ')) '
      else if tempTipo = 'Começa' then
        tempSql := '((COLABORADOR.CODIGO_UF ' + 'like' + QuotedStr(rSugServico.vValor + '%') + ') or ' +
          ' (CLIENTES.CODIGO_UF ' + 'like' + QuotedStr(rSugServico.vValor + '%') + ')) '
      else
        tempSql := '((COLABORADOR.CODIGO_UF ' + tempTipo + QuotedStr(rSugServico.vValor) + ') or ' +
          ' (COLABORADOR.CODIGO_UF ' + tempTipo + QuotedStr(rSugServico.vValor) + '))';
    end
    else if (rSugServico.vCampo = 'Cod Cidade') then
    begin
       if tempTipo = 'like' then
        tempSql := '((COLABORADOR.COD_CIDADE ' + tempTipo + QuotedStr('%' + rSugServico.vValor + '%') + ') or ' +
         	' (CLIENTES.COD_CIDADE ' + tempTipo + QuotedStr('%' + rSugServico.vValor + '%') + ')) '
      else if tempTipo = 'Começa' then
        tempSql := '((COLABORADOR.COD_CIDADE ' + 'like' + QuotedStr(rSugServico.vValor + '%') + ') or ' +
          ' (CLIENTES.COD_CIDADE ' + 'like' + QuotedStr(rSugServico.vValor + '%') + ')) '
      else
        tempSql := '((COLABORADOR.COD_CIDADE ' + tempTipo + QuotedStr(rSugServico.vValor) + ') or ' +
          ' (COLABORADOR.COD_CIDADE ' + tempTipo + QuotedStr(rSugServico.vValor) + '))';
    end
    else if (rSugServico.vCampo = 'Cod Bairro') then
    begin
      if tempTipo = 'like' then
        tempSql := '((COLABORADOR.COD_BAIRRO ' + tempTipo + QuotedStr('%' + rSugServico.vValor + '%') + ') or ' +
