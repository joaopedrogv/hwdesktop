function TCEP._ConsultarWebService(Cep: string): boolean;
type
  TBuscarCEPWebService = function(Cep: PChar; CaminhoBanco: PChar): boolean; stdcall;
  Tws_cep_lasterror = procedure(var error: PChar); stdcall;
var
  HandleCEP: THandle;
  BuscarCEP: TBuscarCEPWebService;
  ws_cep_lasterror: Tws_cep_lasterror;
  error: string;
  err: PChar;
begin
  Result    := False;
  HandleCEP := 0;
  Screen.Cursor := crHourGlass;
  try
    vDadosIni.abreStatusProcessamento('Conectando ao servidor', 'Buscando informações...');

    if hw_cep_consultar(vDadosIni.vBancoHW, Cep) then
    begin
      Result := True;
      Exit;
    end
    else
      error := hw_utils_lasterror;

    try
      HandleCEP := LoadLibrary('WebServiceCEP.dll');
      if HandleCEP <> 0 then
      begin
        @BuscarCEP := GetProcAddress(HandleCEP, '_ConsultarWebService');
        @ws_cep_lasterror := GetProcAddress(HandleCEP, 'ws_cep_lasterror');
      end;

      if BuscarCEP(Pchar(cep), Pchar(vDadosIni.vBancoHW)) then
      begin
        Result := True;
        Exit;
      end
      else
      begin
        ws_cep_lasterror(err);
        error := error + sLineBreak + sLineBreak + 'Serv Dev(old)' + string(err);
      end;

      if ShowConfirmacao('Consulta CEP falhou, Verifique sua conexão com a Internet e repita a operação' + sLineBreak +
                         'Deseja ver mais detalhes do erro?', MB_YESNO + MB_ICONQUESTION) = ID_YES then
        ShowErro(error);

    except
      Result := False;
      ShowMessage('Ocorreu um erro na execução do programa buscar CEP da internet.');
    end;

  finally
    if HandleCEP <> 0 then
      FreeLibrary(HandleCEP);
    Screen.Cursor := crDefault;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TCEP._GravarCEPAutomatico(Cep: string; CodEst, CodCid, CodBai: integer;
  Endereco, SiglaEstadoWebService, NomeEstadoWebService, CodIBGECidadeWebService,
  CidadeWebService, BairroWebService: string): boolean;
var
  CEPQuery, CEPQueryIncluir: TIBQuery;
  function BuscarCodInserirWebService(SQLSelecionar, SQLInserir, CampoChave: string): integer;
  begin
    {  Busca no banco estado,cidade e bairro se não tiver  inclui }
    CEPQuery.Close;
    CEPQuery.SQL.Text := SQLSelecionar;
    CEPQuery.Open;
    if (CEPQuery.FieldByName(CampoChave).IsNull) then
    begin
      CEPQueryIncluir.Close;
      CEPQueryIncluir.SQL.Text := SQLInserir;
      CEPQueryIncluir.ExecSQL;
      CEPQueryIncluir.Transaction.Commit;

      CEPQuery.Close;
      CEPQuery.SQL.Text := SQLSelecionar;
      CEPQuery.Open;
    end;
    Result := CEPQuery.FieldByName(CampoChave).AsInteger;
  end;
begin
  { Para gravar pelo webservice deixar CodEst, CodCid e CodBai zerados(0)}

  { Para gravar pelo programa deixar SiglaEstadoWebService,NomeEstadoWebService,CodIBGECidadeWebService,
    CidadeWebService e BairroWebService com string vazia('') }

  try
    Result := False;
    Cep := StringReplace(Cep, '-', '', [rfReplaceAll]);
    if cep <> '00000000' then
    begin
      CEPQuery := TIBQuery.Create(CEPQuery);
      CEPQueryIncluir := TIBQuery.Create(CEPQueryIncluir);
      CEPQuery.Database := dtmAtivo.bancoHw;
      CEPQueryIncluir.Database := dtmAtivo.bancoHw;

      if (CodEst = 0) then
      begin
        CodEst := BuscarCodInserirWebService('SELECT first 1 estados.codigo_uf ' +
          '  FROM estados where ' +
          ' estados.sigla_uf = ' + QuotedStr(trim(SiglaEstadoWebService)) + ' ',
          'INSERT INTO ESTADOS (SIGLA_UF,NOME_UF) VALUES('
          + QuotedStr(trim(SiglaEstadoWebService)) + ',' + QuotedStr(trim(NomeEstadoWebService)) +
          ')',
          'codigo_uf');

        CodCid := BuscarCodInserirWebService('SELECT first 1 cidades.cod_cidade ' +
          '  FROM cidades where ' +
          ' cidades.nome_cidade = ' + QuotedStr(trim(CidadeWebService)) + ' ',
          'INSERT INTO CIDADES (NOME_CIDADE,IBGE_COD_CIDADE) VALUES('
          + QuotedStr(trim(CidadeWebService)) + ',' + QuotedStr(trim(CodIBGECidadeWebService)) +
          ')',
          'cod_cidade');

        CodBai := BuscarCodInserirWebService('SELECT first 1 bairros.cod_bairro ' +
          '  FROM  bairros where ' +
          ' bairros.nome_bairro = ' + QuotedStr(trim(BairroWebService)) + ' ',
          'INSERT INTO BAIRROS (NOME_BAIRRO) VALUES('
          + QuotedStr(trim(BairroWebService)) + ')',
          'cod_bairro');

      end;
      CEPQuery.close;
      CEPQuery.SQL.Text := 'select cep.cod_cep from cep where cep.cod_correios = ' + QuotedStr(Cep);
      CEPQuery.Open;

      if (CEPQuery.Eof) then
      begin
        CEPQuery.Close;
        CEPQuery.SQL.Text := 'SELECT estados.sigla_uf,estados.nome_uf,cidades.nome_cidade, ' +
          ' bairros.nome_bairro FROM estados,cidades,bairros where ' +
          ' estados.codigo_uf = ' + inttostr(CodEst) + ' ' +
          ' and cidades.cod_cidade = ' + inttostr(CodCid) + ' and BAIRROS.cod_bairro = ' + inttostr(CodBai);
        CEPQuery.Open;

        if not (CEPQuery.Eof) then
        begin
          CEPQueryIncluir.Close;
          CEPQueryIncluir.SQL.Text :=
            'INSERT INTO CEP (COD_CORREIOS,COD_ESTADO,COD_CIDADE,COD_BAIRRO, ' +
            ' ENDERECO,SIGLA_ESTADO,ESTADO,CIDADE,BAIRRO) VALUES(' + QuotedStr(Cep) + ',' +
            inttostr(CodEst) + ',' + inttostr(CodCid) +
            ',' + inttostr(CodBai) + ',' + QuotedStr(trim(Endereco)) + ',' +
            QuotedStr(CEPQuery.FieldByName('sigla_uf').AsString) +
            ',' + QuotedStr(CEPQuery.FieldByName('nome_uf').AsString) + ',' +
            QuotedStr(CEPQuery.FieldByName('nome_cidade').AsString) +
            ',' + QuotedStr(CEPQuery.FieldByName('nome_bairro').AsString) + ')';
          CEPQueryIncluir.ExecSQL;
          CEPQueryIncluir.Transaction.Commit;
          Result := true;
        end;
      end;

      CEPQuery.Close;
      CEPQuery.Free;
      CEPQueryIncluir.Close;
      CEPQueryIncluir.Free;
    end;
  except
    CEPQuery.Close;
    CEPQuery.Free;
    CEPQueryIncluir.Close;
    CEPQueryIncluir.Free;
  end;

end;

