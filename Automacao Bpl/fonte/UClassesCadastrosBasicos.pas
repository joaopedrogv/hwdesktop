      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('MINUTO_INI').AsString :=
        Copy(vPerfilHoras.sextahoraini, 4, 2);

      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('HORA_FIM').AsString :=
        Copy(vPerfilHoras.sextahorafim, 1, 2);
      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('MINUTO_FIM').AsString :=
        Copy(vPerfilHoras.sextahorafim, 4, 2);

      vCadPerfilHorasTrabalhoDia.dataSet.Post;
    end;

    if (vCadPerfilHorasTrabalhoDia.DataSet.ChangeCount = 0) then
    	Result := True
    else
      Result := vCadPerfilHorasTrabalhoDia.Apply;

    // sabado
    vDiaSemana := 6;
    vCadPerfilHorasTrabalhoDia.abrePerfilHorasTrabalhoDia(
      dataSet.FieldByName('CODIGO').AsInteger,
      vDiaSemana);

    if not vPerfilHoras.sabado then
    begin
      if not vCadPerfilHorasTrabalhoDia.IsEmpty then
      	vCadPerfilHorasTrabalhoDia.Delete;
    end
    else
    begin
      if vCadPerfilHorasTrabalhoDia.IsEmpty then
      begin
        vCadPerfilHorasTrabalhoDia.dataSet.Insert;
        vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('CODIGO').AsInteger :=
          dataSet.FieldByName('CODIGO').AsInteger;
        vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('COD_EMPRESA').AsInteger :=
          dataSet.FieldByName('COD_EMPRESA').AsInteger;
        vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('DIA_SEMANA').AsInteger :=
          vDiaSemana;
      end
      else
        vCadPerfilHorasTrabalhoDia.dataSet.Edit;

      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('HORA_INI').AsString :=
        Copy(vPerfilHoras.sabadohoraini, 1, 2);
      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('MINUTO_INI').AsString :=
        Copy(vPerfilHoras.sabadohoraini, 4, 2);

      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('HORA_FIM').AsString :=
        Copy(vPerfilHoras.sabadohorafim, 1, 2);
      vCadPerfilHorasTrabalhoDia.dataSet.FieldByName('MINUTO_FIM').AsString :=
        Copy(vPerfilHoras.sabadohorafim, 4, 2);

      vCadPerfilHorasTrabalhoDia.dataSet.Post;
    end;

    if (vCadPerfilHorasTrabalhoDia.DataSet.ChangeCount = 0) then
    	Result := True
    else
      Result := vCadPerfilHorasTrabalhoDia.Apply;

  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

constructor TCadPerfilHorasTrabalho.create;
begin
	dataset := TClientDataSet(DtmCadBasicos.cdsPerfilHorasTrabalho);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  vCadPerfilHorasTrabalhoDia := TCadPerfilHorasTrabalhoDia.create;
end;

function TCadPerfilHorasTrabalho.delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('CODIGO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin

    if not vDadosIni.PesqPros('BAS536', 'EXCLUIR', '', 'PERFIL_HORAS_TRABALHO',
      dataSet.FieldByName('CODIGO').AsString, buscas, false) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja enviar este registro para Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    dataSet.Edit;
    dataSet.FieldByName('ATIVO').AsInteger := 0;
    dataSet.Post;

    result := Apply;
    if result then
      result := CommitaTransacao;
    if Result then
      vDadosIni.GravaAuditoria('BAS536', 'EXCLUIR', 'SUCESSO', 'PERFIL_HORAS_TRABALHO', vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS536', 'EXCLUIR', 'FALHA', 'PERFIL_HORAS_TRABALHO', vCodFormula, buscas);

    Result := true;
    Refresh;

    Exit;
  end;

	if not vDadosIni.PesqPros('BAS537', 'EXCLUIR', '', 'PERFIL_HORAS_TRABALHO',
    dataSet.FieldByName('CODIGO').AsString, buscas, false) then
      Exit;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  SqlExec(' update senhas set cod_perfil_horas_trab = null ' +
          ' where cod_perfil_horas_trab = %d ' +
          ' and cod_empresa = %d ',
          [fint('codigo'), fint('cod_empresa')], buscas);

	SqlExec(' delete from perfil_horas_trabalho ' +
          ' where codigo = %d ' +
          ' and cod_empresa = %d ',
          [fint('codigo'), fint('cod_empresa')], buscas);

  result := CommitaTransacao;

  if Result then
    vDadosIni.GravaAuditoria('BAS537', 'EXCLUIR', 'SUCESSO', 'PERFIL_HORAS_TRABALHO', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS537', 'EXCLUIR', 'FALHA', 'PERFIL_HORAS_TRABALHO', vCodFormula, buscas);

  Result := true;
  Refresh;
end;

