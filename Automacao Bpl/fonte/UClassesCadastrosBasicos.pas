function TComissaoFaixaDesc.Delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('CODIGO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
  begin

    if not vDadosIni.PesqPros('BAS462', 'EXCLUIR', '', 'COMISSAO_FAIXA_DESCONTO',
      vCodFormula, buscas, false) then
      Exit;

