function TEmpresa.edit: boolean;
begin
  result := false;
  if dataSet.IsEmpty then
    exit;

  if inherited edit then
  begin
    result := true;
    vContaLig.abreContasLig;
    vContaLigContabil.abreContasLigContabil;
    vControles.abreControles;
    dataSet.FieldByName('LICENCANFSE').AsString := vDadosIni.decodifica(dataSet.FieldByName('LICENCANFSE').AsString);

    CriarProcesso := false;
  end
  else
    result := false;
end;

