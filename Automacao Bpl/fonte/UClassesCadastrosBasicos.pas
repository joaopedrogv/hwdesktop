function TOpcionais.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS186', 'SALVAR', '', 'OPCIONAIS',
      dataSet.FieldByName('COD_OPCIONAIS').AsString, buscas, true) then
      Exit;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if Trim(dataSet.FieldByName('CODIGO_FABRICA').AsString) = '' then
      raiseExceptionCreate('Código de Fábrica opcional não informado!', 'DBEdit_CodigoFabrica');

    if Trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição do opcional não informado!', 'DBEdit_Descricao');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('CODIGO_FABRICA').OldValue <> dataSet.FieldByName('CODIGO_FABRICA').NewValue))) then
      if ExecutaComandosSql('select cod_opcionais from opcionais where codigo_fabrica = ' + QuotedStr(dataSet.FieldByName('CODIGO_FABRICA').AsString)) then
        raiseExceptionCreate('Já existe um opcional cadastrado com este código de fábrica!', 'DBEdit_CodigoFabrica');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('DESCRICAO').OldValue <> dataSet.FieldByName('DESCRICAO').NewValue))) then
      if ExecutaComandosSql('select cod_opcionais from opcionais where descricao = ' +
        quotedstr(dataSet.FieldByName('DESCRICAO').AsString)) then
        raiseExceptionCreate('Já existe um opcional cadastrado com esta descrição!', 'DBEdit_Descricao');

    if acao = 'INSERIR' then
      _VerificarCodigoAutoIncremento('GEN_OPCIONAIS_ID', 'COD_OPCIONAIS', 'OPCIONAIS');

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS186', acao, 'SUCESSO', 'OPCIONAIS',
        dataSet.FieldByName('COD_OPCIONAIS').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS186', acao, 'FALHA', 'OPCIONAIS',
        dataSet.FieldByName('COD_OPCIONAIS').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
      end;
    end;
  end;

end;

