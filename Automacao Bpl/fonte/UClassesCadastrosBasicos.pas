function TCadPerfilHorasTrabalho.restaurarLixeira: boolean;
begin
	if dataSet.IsEmpty then
  	Exit;

  if dataSet.FieldByName('ATIVO').asinteger = 0 then
  begin
  	if not vDadosIni.PesqPros('BAS538', 'RESTAURAR', '', 'PERFIL_HORAS_TRABALHO',
      dataSet.FieldByName('CODIGO').AsString, buscas, false) then
     	 Exit;

    if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
      'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
    begin
      if (Edit) or (dataSet.State = dsEdit) then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 1;
        Result := Post;
        if Result then
          Result := CommitaTransacao;

        if Result then
          vDadosIni.GravaAuditoria('BAS538', 'RESTAURAR', 'SUCESSO',
            'PERFIL_HORAS_TRABALHO', dataSet.FieldByName('CODIGO').AsString, buscas)
        else
          vDadosIni.GravaAuditoria('BAS538', 'RESTAURAR', 'FALHA',
            'PERFIL_HORAS_TRABALHO', dataSet.FieldByName('CODIGO').AsString, buscas);

      end;
    end;
  end;

  Refresh;
end;

