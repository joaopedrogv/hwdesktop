function TSenha.atualizarSenhasEmLote: boolean;
var
	vIndexFieldNames: string;
	vIndexName: string;
  vRecNo: Integer;
	vUsuario: string;
  vSQL: string;
  fTempListaSenhas: TClientDataSet;
begin
	vSQL := '';

	if not vDadosIni.PesqPros('CFG057', 'ATUALIZAR', '', 'SENHAS', '', buscas, False) then
    Exit;

	try
    try
    	vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhuma senha selecionada.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          dataSet.Refresh;
          exit;
        end;

        fTempListaSenhas := TClientDataSet.Create(nil);
        fTempListaSenhas.Close;
        fTempListaSenhas.FieldDefs.Clear;
        fTempListaSenhas.FieldDefs.Add('USUARIO', ftString, 20, false);
        fTempListaSenhas.close;
        fTempListaSenhas.CreateDataSet;
        fTempListaSenhas.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
            vDadosIni.abreStatusProcessamento('', 'Atualizando senhas (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempListaSenhas.Insert;
              fTempListaSenhas.FieldByName('USUARIO').AsString := dataSet.FieldByName('USUARIO').AsString;
              fTempListaSenhas.Post;
            end;

            dataSet.Next;
          end;

          vSQL := dataSet.CommandText;
        finally
          dataSet.EnableControls;
        end;
      finally
        dataSet.Filtered := False;
      end;

      if vHAB_DEPARTAMENTO then
      begin
        if (trim(vDEPARTAMENTO) = '') then
        	raiseExceptionCreate('Departamento deve ser informado', 'cbDepartamento');
      end;

      if vHAB_LIBERAR_ACESSO then
      begin
        if (trim(vLIBERAR_ACESSO) = '') then
        	raiseExceptionCreate('Liberar Acesso deve ser informado', 'cbLiberarAcesso');
      end;

      if vHAB_ESTOQUE_NEGATIVO then
      begin
        if (trim(vESTOQUE_NEGATIVO) = '') then
        	raiseExceptionCreate('Estoque Negativo deve ser informado', 'cbEstoqueNegativo');
      end;

    	if vHAB_MODO_IMPRESSAO then
      begin
        if (trim(vMODO_IMPRESSAO) = '') then
        	raiseExceptionCreate('Modo Impressão deve ser informado', 'cbModoImpressao');
      end;

      if vHAB_ALTERAR_IMPRESSORA then
      begin
        if (trim(vALTERAR_IMPRESSORA) = '') then
        	raiseExceptionCreate('Alterar Impressora deve ser informado', 'cbAlterarImpressora');
      end;

      if vHAB_ALTERAR_CABECALHO then
      begin
        if (trim(vALTERAR_CABECALHO) = '') then
        	raiseExceptionCreate('Alterar Cabeçalho deve ser informado', 'cbAlterarCabecalho');
      end;

    	if vHAB_NIVEL_SENHA then
      begin
        if (vNIVEL_SENHA <= 0) then
        	raiseExceptionCreate('Nível Senha deve ser informado', 'cbNivelSenha');
      end;

      if vHAB_PERFIL_HORARIO_TRABALHO then
      begin
        if (vPERFIL_HORARIO_TRABALHO < 0) then
        	raiseExceptionCreate('Perfil Horário de Trabalho deve ser informado', 'DBLPerfilHorarioTrabalho');
      end;

     if (not vHAB_DEPARTAMENTO)
      and (not vHAB_LIBERAR_ACESSO)
      and (not vHAB_ESTOQUE_NEGATIVO)
      and (not vHAB_MODO_IMPRESSAO)
      and (not vHAB_ALTERAR_IMPRESSORA)
      and (not vHAB_ALTERAR_CABECALHO)
      and (not vHAB_NIVEL_SENHA)
      and (not vHAB_PERFIL_HORARIO_TRABALHO) then
      	raiseExceptionCreate('Nenhum opção selecionada!', '');

      try
        fTempListaSenhas.DisableControls;
        fTempListaSenhas.First;
        while not fTempListaSenhas.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Atualizando senhas (' +
            IntToStr(fTempListaSenhas.RecNo) + '/' + IntToStr(fTempListaSenhas.RecordCount) + ')');

          abreSenha(fTempListaSenhas.FieldByName('USUARIO').AsString);

          if not dataSet.IsEmpty then
          begin
          	vUsuario := dataSet.FieldByName('USUARIO').AsString;

            dataSet.Edit;

            if vHAB_DEPARTAMENTO then
              dataSet.FieldByName('DEPART').AsString := trim(vDEPARTAMENTO);

            if vHAB_LIBERAR_ACESSO then
              dataSet.FieldByName('LIBERAR_ACESSO').AsString := trim(vLIBERAR_ACESSO);

            if vHAB_ESTOQUE_NEGATIVO then
              dataSet.FieldByName('ESTOQ_NEG').AsString := trim(vESTOQUE_NEGATIVO);

            if vHAB_MODO_IMPRESSAO then
              dataSet.FieldByName('IMP_US').AsString := trim(vMODO_IMPRESSAO);

            if vHAB_ALTERAR_IMPRESSORA then
              dataSet.FieldByName('ALT_IMP').AsString := trim(vALTERAR_IMPRESSORA);

            if vHAB_ALTERAR_CABECALHO then
              dataSet.FieldByName('ALT_CAB').AsString := trim(vALTERAR_CABECALHO);

            if vHAB_NIVEL_SENHA then
              dataSet.FieldByName('NIVEL_US').AsInteger := vNIVEL_SENHA;

            if vHAB_PERFIL_HORARIO_TRABALHO then
              dataSet.FieldByName('COD_PERFIL_HORAS_TRAB').AsInteger := vPERFIL_HORARIO_TRABALHO;

            dataSet.Post;

            if (not Apply) and (dataSet.ChangeCount > 0) then
            begin
              dataSet.CancelUpdates;
              RollBackTransacao;
              Result := False;

              dataSet.Close;
		    			dataSet.CommandText := vSQL;
					    dataSet.Open;

              Exit;
            end;

            vDadosIni.GravaAuditoria('CFG057', 'ATUALIZAR', '', 'SENHAS', Trim(vUsuario), buscas);
          end;

          fTempListaSenhas.Next;
        end;
      finally
        fTempListaSenhas.EnableControls;
      end;

      Result := True;

      CommitaTransacao;

      if Result then
      	vDadosIni.GravaAuditoria('CFG057', 'ATUALIZAR',	'SUCESSO', 'SENHAS', '', buscas);

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      if Result then
      	dataSet.Refresh;
    finally
    	dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('CFG057', 'ATUALIZAR',	'FALHA', 'SENHAS', '', buscas);
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
		    dataSet.Close;
  	    dataSet.CommandText := vSQL;
	    	dataSet.Open;
    	end;

      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
