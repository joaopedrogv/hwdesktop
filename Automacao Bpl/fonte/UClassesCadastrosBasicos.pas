procedure TTransportador.HandleUF;
var
  ufIBGE, ufTR: Integer;
begin
  FLastError := '';
  if fint('cidade_ibge') > 9 then
  begin
    ufIBGE := StrToInt(fstr('cidade_ibge', 1, 2));
    if ufIBGE <> FufIBGE then
    begin
      ufTR := SqlScalar('select first 1 codigo_uf from estados where ibge_codigo_uf = %d', [ufIBGE]).AsInteger;
      if ufTR > 0 then
      begin
        dataSet.FieldByName('uf_tr').AsInteger := ufTR;
        FufIBGE := ufIBGE;
      end
      else
        FLastError := 'Não encontrado no cadastro de Estados o vículo com o IBGE. Por favor acesse o cadastro de estados e vincule o código IBGE';
    end;
  end
  else
    FLastError := 'Cidade IBGE inválida';
end;

function TTransportador.insert: boolean;
begin
  result := inherited Insert;
  FufIBGE := 0;
  if result then
    vUF.abreUF;
end;

function TTransportador.post: boolean;
var
  vUF: string;
  acao: string;
begin
  result := false;
  try
    if not (dataset.State in [dsInsert, dsEdit]) then
      exit;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    dataset.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;

    dataset.FieldByName('ATIVO').AsInteger := 1;

    if dataset.FieldByName('NOME_TR').AsString = '' then
      raiseExceptionCreate('Campo Transportador não informado.', 'DBEDIT3');

    if dataset.FieldByName('END_TR').AsString = '' then
      raiseExceptionCreate('Campo endereço não informado.', 'DBEDIT5');

    if dataset.FieldByName('cidade_ibge').AsString = '' then
      raiseExceptionCreate('Campo Município não informado', 'DBEDIT6');

    if dataset.FieldByName('UF_TR').AsString = '' then
      raiseExceptionCreate('Campo UF não informado.', 'DBLOOKUPCOMBOBOX1');

    if pos('.', dataSet.FieldByName('IE_TR').asString) > 0 then
      raiseExceptionCreate('Digitar sem Ponto.', 'DBEDIT8');

    if pos('-', dataSet.FieldByName('IE_TR').asString) > 0 then
      raiseExceptionCreate('Digitar sem Traço.', 'DBEDIT8');

    if pos('/', dataSet.FieldByName('IE_TR').asString) > 0 then
      raiseExceptionCreate('Digitar sem Barra.', 'DBEDIT8');

    if dataSet.FieldByName('IE_TR').asString = '' then
      dataSet.FieldByName('IE_TR').asString := 'ISENTO';

    if dataset.FieldByName('CNPJ_TR').AsString = '' then
      raiseExceptionCreate('Campo CNPJ/CPF não informado.', 'DBEDIT4');
    if Length(dataset.FieldByName('CNPJ_TR').AsString) = 11 then
    begin
      if not Cpf(dataset.FieldByName('CNPJ_TR').AsString) then
        raiseExceptionCreate('Valor do campo CPF inválido.', 'DBEDIT4')
    end
    else
      if not cgc(UpperCase(fstr('CNPJ_TR'))) then
        raiseExceptionCreate('Valor do campo CNPJ inválido.', 'DBEDIT4');

    //    if dataset.FieldByName('CODIGOANTT').AsString = '' then
    //       raiseExceptionCreate('Campo Código ANTT não informado.', 'DBEDIT10');

    vUF := retornaValor('select SIGLA_UF as valor from Estados where CODIGO_UF = ' +
      dataset.FieldByName('UF_TR').AsString);

    if ConsisteInscricaoEstadual(dataSet.FieldByName('IE_TR').asString, trim(vUF)) <> 0 then
      exit;

    dataset.FieldByName('NOME_TR').AsString      := Trim(dataset.FieldByName('NOME_TR').AsString);
    dataset.FieldByName('CNPJ_TR').AsString      := HelperDocumento.CnpjOuCpfTratado(fstr('CNPJ_TR'));
    dataset.FieldByName('END_TR').AsString       := Trim(dataset.FieldByName('END_TR').AsString);
    dataset.FieldByName('MUNICIPIO_TR').AsString := Trim(dataset.FieldByName('MUNICIPIO_TR').AsString);
    dataset.FieldByName('IE_TR').AsString        := Trim(dataset.FieldByName('IE_TR').AsString);
    dataset.FieldByName('FONE_TR').AsString      := Trim(dataset.FieldByName('FONE_TR').AsString);
    dataset.FieldByName('FAX_TR').AsString       := Trim(dataset.FieldByName('FAX_TR').AsString);
    if fint('cidade_ibge') > 0 then
    begin
      dataset.FieldByName('MUNICIPIO_TR').AsString :=
		    SqlScalar('select first 1 c.nome_municipio from cidades_ibge c' +
                  ' where c.codigo_mun_ibge = %d', [fint('cidade_ibge')]).AsString;

      dataset.FieldByName('MUNICIPIO_TR').AsString :=
		    SqlScalar('select first 1 c.nome_municipio from cidades_ibge c' +
                  ' where c.codigo_mun_ibge = %d', [fint('cidade_ibge')]).AsString;
    end;

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('CODIGO_TR').AsInteger := Gencodigo('TRANSPORTADOR',
        DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
      vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_TR').AsString;
    end;

    result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      RollBackTransacao;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS103', acao, 'SUCESSO', 'TRANSPORTADOR',
        dataSet.FieldByName('CODIGO_TR').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS103', acao, 'FALHA', 'TRANSPORTADOR',
        dataSet.FieldByName('CODIGO_TR').AsString, buscas);
    if Result then
      Refresh
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TTransportador.restaurarRegistro: boolean;
var
	vCodTransportador: string;
	vNomeTransportador: string;
  vtemp: string;
begin
	try
  	result := false;
    if dataSet.IsEmpty then
      exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vCodTransportador := trim(dataSet.FieldByName('CODIGO_TR').AsString);
      vNomeTransportador := trim(dataSet.FieldByName('NOME_TR').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vCodTransportador := '';
        vNomeTransportador := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(vCodTransportador) <> '') then
      	prepare_loop('CODIGO_TR = ' + vCodTransportador)
      else
		    prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
        'TRANSPORTADOR' + #13 +
        'Código: ' + vCodTransportador + #13 +
        'Nome: ' + vNomeTransportador;

      if (trim(vNomeTransportador) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('BAS102', 'RESTAURAR', '', 'TRANSPORTADOR',
        vDadosIni.IfThen(trim(vCodTransportador) <> '', vCodTransportador, ''), buscas, true) then
          exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando transportador(es)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando transportador(es) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update transportador set ativo = 1 ' +
          ' where codigo_tr = %d and cod_empresa = %d ',
          [fint('codigo_tr'), fint('cod_empresa')], buscas);

        if (trim(vCodTransportador) = '') then
          vDadosIni.GravaAuditoria('BAS102', 'RESTAURAR', '', 'TRANSPORTADOR',
            dataSet.FieldByName('CODIGO_TR').AsString, buscas);

        dataset.Next;
      end;
    finally
    	vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;
    if Result then
    begin
    	vDadosIni.GravaAuditoria('BAS102', 'RESTAURAR', 'SUCESSO', 'TRANSPORTADOR',
        vDadosIni.IfThen(trim(vCodTransportador) <> '', vCodTransportador, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
    	vDadosIni.GravaAuditoria('BAS102', 'RESTAURAR', 'FALHA', 'TRANSPORTADOR',
        vDadosIni.IfThen(trim(vCodTransportador) <> '', vCodTransportador, ''), buscas);
    end;

    if Result then
      montaSelect(ultimasql);
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

