  buscas.close;
  buscas.sql.text := 'select * from tipo_vendas  ' +
    ' where tipo = ' + QuotedStr(vDadosIni.IfThen(trim(vtipo) = 'OS', 'OS', 'REQ')) +
    ' order by ordemexibicao';
  buscas.open;

  vcomb.Items.Clear;
  while not buscas.eof do
  begin
    if (buscas.FieldByName('TIPO').AsString = 'REQ')
      or (buscas.FieldByName('TIPO').AsString = 'ORC')
      or (buscas.FieldByName('TIPO').AsString = 'ESF') then
        vcomb.Items.Add(buscas.FieldByName('SIGLA').AsString)
    else if (trim(buscas.FieldByName('TIPO').AsString) = 'OS')
      or (trim(buscas.FieldByName('TIPO').AsString) = 'TMO') then
        vcomb.Items.Add(trim(buscas.FieldByName('TIPO_OS').AsString));
    buscas.next;
  end;
end;

