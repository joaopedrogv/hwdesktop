function TTipoVendas.Insert: boolean;
begin
  if not vDadosIni.PesqPros('BAS247', 'INCLUIR', '', 'TIPO_VENDAS',
    '', buscas, True) then
    Exit;

  if not dataSet.Active then
    montaSelect('select t.* from tipo_vendas t ' +
      ' where t.ativo=0');

  Result := False;
  if inherited Insert then
  begin
    Result := True;
    _setaPercentuaisTipoVND;
    dataSet.FieldByName('TIPO').AsString := 'REQ';
    dataSet.FieldByName('VENDA').AsString := 'N';
    dataSet.FieldByName('COMGARANTIA').AsString := 'N';
    dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString := 'S';
    dataSet.FieldByName('CONFIGFECHVND').AsString := 'E';
    dataSet.FieldByName('USAR_CONFERENCIA_PRODUTO').AsString := 'N';
    dataSet.FieldByName('N_USAR_CONFERENCIA_PRODUTO').AsString := 'N';
    dataSet.FieldByName('RECEBER_FINANCEIRO').AsString := 'N';
    dataSet.FieldByName('ATIVO').AsFloat := 1;
  end;
end;

function TTipoVendas.post: boolean;
var
  acao: string;
  codigo: integer;
  campo: string;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS252', 'SALVAR', '', 'TIPO_VENDAS',
      dataSet.FieldByName('COD_TIPO').AsString, buscas, true) then
      Exit;

    if ((trim(dataSet.FieldByName('TIPO').AsString) = '')
      or (trim(dataSet.FieldByName('TIPO').AsString) <> 'REQ') and (trim(dataSet.FieldByName('TIPO').AsString) <> 'OS')
      and (trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC') and (trim(dataSet.FieldByName('TIPO').AsString) <> 'TMO')
      and (trim(dataSet.FieldByName('TIPO').AsString) <> 'VEI')) then
      raiseExceptionCreate('Tipo deve ser informado, ou valor incorreto!', 'DBComboBox1');

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição deve ser informada', 'DBEdit3');

    if (trim(dataSet.FieldByName('TIPO').AsString) = 'REQ')
    	or (trim(dataSet.FieldByName('TIPO').AsString) = 'ORC') then
    begin
    	if trim(dataSet.FieldByName('SIGLA').AsString) = '' then
      	raiseExceptionCreate('Sigla deve ser informada', 'DBEdit5');
    end
    else if (trim(dataSet.FieldByName('TIPO').AsString) = 'OS')
    	or (trim(dataSet.FieldByName('TIPO').AsString) = 'VEI')
      or (trim(dataSet.FieldByName('TIPO').AsString) = 'TMO') then
    begin
    	campo := 'Tipo de OS';
    	if (trim(dataSet.FieldByName('TIPO').AsString) = 'VEI') then
      	campo := 'Tipo de Veículo'
      else if (trim(dataSet.FieldByName('TIPO').AsString) = 'TMO') then
      	campo := 'Status TMO';

      if trim(dataSet.FieldByName('TIPO_OS').AsString) = '' then
        raiseExceptionCreate(campo + ' deve ser informada', 'DBEdit4');
    end;

    if ((trim(dataSet.FieldByName('VENDA').AsString) = '')
      or (trim(dataSet.FieldByName('VENDA').AsString) <> 'S') and (trim(dataSet.FieldByName('VENDA').AsString) <> 'N')) then
      raiseExceptionCreate('Venda deve ser informada, ou valor incorreto!', 'DBComboBox2');

    if ((trim(dataSet.FieldByName('COMGARANTIA').AsString) = '')
      or (trim(dataSet.FieldByName('COMGARANTIA').AsString) <> 'S') and (trim(dataSet.FieldByName('COMGARANTIA').AsString) <> 'N')) then
      raiseExceptionCreate('Garantia deve ser informada, ou valor incorreto!', 'DBComboBox3');

    if ((trim(dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString) = '')
      or (trim(dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString) <> 'S') and (trim(dataSet.FieldByName('PERMITIR_CUPOM_SERVICO').AsString) <> 'N')) then
      raiseExceptionCreate('Garantia deve ser informada, ou valor incorreto!', 'DBComboBox4');

    if ((trim(dataSet.FieldByName('CONFIGFECHVND').AsString) = '')
      or (trim(dataSet.FieldByName('CONFIGFECHVND').AsString) <> 'E') and (trim(dataSet.FieldByName('CONFIGFECHVND').AsString) <> 'F')
      and (trim(dataSet.FieldByName('CONFIGFECHVND').AsString) <> 'C')) then
      raiseExceptionCreate('Confirmar Fechamento na Venda deve ser informada, ou valor incorreto!', 'DBComboBox5');

    if (trim(dataSet.FieldByName('USARPRECOCUSTO').AsString) = 'S') and (trim(dataSet.FieldByName('VENDA').AsString) = 'S') then
      raiseExceptionCreate('Tipo de venda configurado para compor venda não deve usar preço de custo no pedido.', 'DBComboBox7');

    if (trim(dataSet.FieldByName('USARPRECOCUSTO').AsString) = 'S') and (trim(dataSet.FieldByName('TIPO').AsString) = 'ORC') then
      raiseExceptionCreate('Apenas tipo de venda igual a ''OS'' ou ''REQ'' pode ser configurado para usar preço de custo no pedido.', 'DBComboBox7');

    if (Trim(dataSet.FieldByName('CONSUMO').AsString) = 'S') then
    begin
      if (trim(dataSet.FieldByName('VENDA').AsString) = 'S') then
        raiseExceptionCreate('Tipo de venda configurada para consumo, Campo Venda deve ficar igual "N"!', 'DBComboBox2');

      if (trim(dataSet.FieldByName('USARPRECOCUSTO').AsString) <> 'S') then
        if Application.MessageBox('Tipo de venda configurada para consumo. Deseja alterar o tipo de venda para usar o preço de custo?',
          'Atenção', MB_ICONQUESTION + MB_YESNO) =  IDYES then
          dataSet.FieldByName('USARPRECOCUSTO').AsString := 'S';
    end;

    if trim(dataSet.FieldByName('ENV_EMAIL').AsString) = '' then
      dataSet.FieldByName('ENV_EMAIL').AsString := 'N';

    if (trim(dataSet.FieldByName('TIPO').AsString) <> 'REQ')
     and (trim(dataSet.FieldByName('TIPO').AsString) <> 'OS')
     and (trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC') then
       dataSet.FieldByName('ENV_EMAIL').AsString := 'N';

    if (trim(dataSet.FieldByName('TIPO').AsString) = 'REQ')
     or (trim(dataSet.FieldByName('TIPO').AsString) = 'OS') then
     begin
      if (Trim(dataSet.FieldByName('ENV_EMAIL').AsString) <> 'N')
      and (Trim(dataSet.FieldByName('ENV_EMAIL').AsString) <> 'A')
      and (Trim(dataSet.FieldByName('ENV_EMAIL').AsString) <> 'F') then
        raiseExceptionCreate('Tipo de envio do pedido por email incorreto, favor informar "N" ou "A" ou "F"', 'DBComboBox15');
     end
     else if (trim(dataSet.FieldByName('TIPO').AsString) = 'ORC') then
      if (Trim(dataSet.FieldByName('ENV_EMAIL').AsString) <> 'N')
       and (Trim(dataSet.FieldByName('ENV_EMAIL').AsString) <> 'A') then
         raiseExceptionCreate('Tipo de envio do pedido por email incorreto, favor informar "N" ou "A"', 'DBComboBox15');


    if (trim(dataSet.FieldByName('TIPO_OS').AsString) = '') then
      dataSet.FieldByName('TIPO_OS').AsVariant := null;
    if (trim(dataSet.FieldByName('SIGLA').AsString) = '') then
      dataSet.FieldByName('SIGLA').AsVariant := null;
    if (trim(dataSet.FieldByName('SALVAR_ITENS_AUTOMATIC').AsString) = '') then
    	dataSet.FieldByName('SALVAR_ITENS_AUTOMATIC').AsString := 'N';
    if (trim(dataSet.FieldByName('REPETIR_ITEMVND').AsString) = '') then
    	dataSet.FieldByName('REPETIR_ITEMVND').AsString := 'S';


    if not SiglaTipoVendaExiste then
    begin
    	if trim(dataSet.FieldByName('TIPO').AsString) = 'REQ' then
      begin
	    	raiseExceptionCreate('Já existe um tipo de venda para Requisição' +
        	' com a Sigla "' + trim(dataSet.FieldByName('SIGLA').AsString) + '"' + #13 + #13 +
          'Favor verificar antes de continuar!', 'DBComboBox1');
      end
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
      begin
      	raiseExceptionCreate('Já existe um tipo de venda para Ordem de Serviço' +
        	' com o Tipo de OS "' + trim(dataSet.FieldByName('TIPO_OS').AsString) + '"' + #13 + #13 +
          'Favor verificar antes de continuar!', 'DBComboBox1');
      end
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
      begin
      	raiseExceptionCreate('Já existe um tipo de venda para Orçamento' +
        	' com a Sigla "' + trim(dataSet.FieldByName('SIGLA').AsString) + '"' + #13 + #13 +
          'Favor verificar antes de continuar!', 'DBComboBox1');
      end
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'VEI' then
      begin
      	raiseExceptionCreate('Já existe um tipo de venda para Veículos' +
        	' com o Tipo de Veículo "' + trim(dataSet.FieldByName('TIPO_OS').AsString) + '"' + #13 + #13 +
          'Favor verificar antes de continuar!', 'DBComboBox1');
      end
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'TMO' then
      begin
      	raiseExceptionCreate('Já existe um tipo de venda para TMO' +
        	' com o Status TMO "' + trim(dataSet.FieldByName('TIPO_OS').AsString) + '"' + #13 + #13 +
          'Favor verificar antes de continuar!', 'DBComboBox1');
      end;
    end;

    dataSet.FieldByName('OBSERVACAO').AsString := UpperCase(dataSet.FieldByName('OBSERVACAO').AsString);

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(GEN_TIPO_VENDAS,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('COD_TIPO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_TIPO').AsString;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if not ExecutaComandosSql('select ptv.cod_tipo from percentuaistipovnd ptv '+
      ' where ptv.cod_tipo = '+inttostr(dataSet.FieldByName('cod_tipo').asinteger)+
      ' and ptv.cod_empresa ='+vDadosIni.codEmpresa) then
    begin
      buscas.Close;
      buscas.SQL.Text:='insert into percentuaistipovnd (cod_empresa,cod_tipo,maxdescontotv,min_margem,min_m_lq) '+
        ' values('+vDadosIni.codEmpresa+
        ' ,'+inttostr(dataSet.FieldByName('cod_tipo').asinteger)+
        ' ,:pmaxdescontotv,:min_margem,:min_m_lq) ';
      buscas.ParamByName('pmaxdescontotv').AsFloat:= FPercDescMax;
      buscas.ParamByName('min_margem').AsFloat:= FMinMarkUp;
      buscas.ParamByName('min_m_lq').AsFloat:=FMinMargemLiq;
      buscas.ExecSQL;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text:='update percentuaistipovnd set maxdescontotv = :pmaxdescontotv, '+
        ' min_margem = :pmin_margem, min_m_lq = :pmin_m_lq where cod_tipo = '+inttostr(dataSet.FieldByName('cod_tipo').asinteger)+
        ' and cod_empresa ='+vDadosIni.codEmpresa;
      buscas.ParamByName('pmaxdescontotv').AsFloat:= FPercDescMax;
      buscas.ParamByName('pmin_margem').AsFloat:= FMinMarkUp;
      buscas.ParamByName('pmin_m_lq').AsFloat:=FMinMargemLiq;
      buscas.ExecSQL;
    end;

    if result or (buscas.RowsAffected>0) then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS252', acao, 'SUCESSO', 'TIPO_VENDAS',
        dataSet.FieldByName('COD_TIPO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS252', acao, 'FALHA', 'TIPO_VENDAS',
        dataSet.FieldByName('COD_TIPO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;

end;

function TTipoVendas.SiglaTipoVendaExiste: boolean;
begin
	Result := true;

  if (trim(dataSet.FieldByName('TIPO').AsString) = 'REQ')
  	or (trim(dataSet.FieldByName('TIPO').AsString) = 'ORC')  then
  begin
  	buscas.close;
	  buscas.SQL.Text := 'select cod_tipo, tipo from tipo_vendas ' +
    	' where tipo = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) +
      ' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('SIGLA').AsString)) +
      ' and cod_tipo <> ' + IntToStr(dataSet.FieldByName('COD_TIPO').AsInteger);
	  buscas.Open;

	  Result := buscas.IsEmpty;
  end
  else if (trim(dataSet.FieldByName('TIPO').AsString) = 'OS')
  	or (trim(dataSet.FieldByName('TIPO').AsString) = 'VEI')
    or (trim(dataSet.FieldByName('TIPO').AsString) = 'TMO') then
  begin
  	buscas.close;
	  buscas.SQL.Text := 'select cod_tipo, tipo from tipo_vendas ' +
    	' where tipo = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) +
      ' and tipo_os = ' + QuotedStr(trim(dataSet.FieldByName('TIPO_OS').AsString)) +
      ' and cod_tipo <> ' + IntToStr(dataSet.FieldByName('COD_TIPO').AsInteger);
	  buscas.Open;

	  Result := buscas.IsEmpty;
  end;
end;

function TTipoVendas._abrelixeira: boolean;
begin
  if not _lixeiraCheia then
  begin
    Application.MessageBox('A lixeira está vazia.', 'Informação', 0 + 64);
    Result := False;
  end
  else
    result := montaSelect('select t.* from tipo_vendas t where t.ativo = 0');
end;

procedure TTipoVendas._cadTipoVendas(pTipoForm: Integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro Tipos Vendas');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS245', 'CONSULTA', '', 'TIPO_VENDAS', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadTipoVendas = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadTipoVendas, frmCadTipoVendas);
    end;

    if (pTipoForm > 0) and (not frmCadTipoVendas.Visible) then
      frmCadTipoVendas.ShowModal
