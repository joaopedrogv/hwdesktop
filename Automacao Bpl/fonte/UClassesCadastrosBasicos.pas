procedure TContratos._CadContrato(pTipoForm: integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Modelos de Contratos');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS294', 'CONSULTA', '', 'MODCARTAS', '', DtmCadBasicos.qrModCartas, False) then
      Exit;

    if frmCadModeloCartas = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
