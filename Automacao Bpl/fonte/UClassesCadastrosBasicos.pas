function TCSTMudGeral.ChecaCamposObrigatorios: boolean;
begin
  result := false;
  if trim(dataSet.FieldByName('CST_INTERNO').AsString) = '' then
  begin
    Application.MessageBox('CST do produto deve ser informado.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CST_INTERNO';
  end
  else if trim(dataSet.FieldByName('CST_EXTERNO').asstring) = '' then
  begin
    Application.MessageBox('CST a utilizar deve ser informado.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CST_EXTERNO';
  end
  else if dataSet.FieldByName('CFOP_INTERNO').IsNull then
  begin
    Application.MessageBox('CFOP do produto deve ser informado.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CFOP_INTERNO';
  end
  else if not existeCFOP(dataSet.FieldByName('CFOP_INTERNO').AsFloat) then
  begin
    Application.MessageBox('CFOP do produto não encontrado no cadastro', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CFOP_INTERNO';
  end
  else if dataSet.FieldByName('CFOP_EXTERNO').IsNull then
  begin
    Application.MessageBox('CFOP a utilizar deve ser informado.', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CFOP_EXTERNO';
  end
  else if not existeCFOP(dataSet.FieldByName('CFOP_EXTERNO').AsFloat) then
  begin
    Application.MessageBox('CFOP a utilizar não encontrado no cadastro', 'Informação', MB_OK +
      MB_ICONINFORMATION + MB_DEFBUTTON1);
    campoComErro := 'CFOP_EXTERNO';
  end
  else
  begin
    if dataSet.FieldByName('ALIQ_INTERNA').IsNull then
      dataSet.FieldByName('ALIQ_INTERNA').AsFloat := 0;
    if dataSet.FieldByName('ALIQ_EXTERNA').IsNull then
      dataSet.FieldByName('ALIQ_EXTERNA').AsFloat := 0;
    result := true;
  end;
end;

