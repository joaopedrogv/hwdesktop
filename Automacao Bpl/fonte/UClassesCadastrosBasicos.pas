function TCEP.GetCEP(Acep: string): TCep_class;
begin
  try
    if SqlOpen('SELECT * FROM CEP' +
      ' WHERE COD_CORREIOS = ' + QuotedStr(vDadosIni.apenasNumeros(Acep)) +
      ' and ATIVO = 1 ').IsEmpty then
      Exit;

    Result := TCep_class.Create;
    Result.CopyFrom(buscas);

  except on E: Exception do
    begin
      vDadosIni.registraErro('TCEP.GetCEP Acep=' + Acep);
      if Assigned(Result) then
        FreeAndNil(Result);
    end;
  end;
end;

function TCEP.getEndereco(CEP: string): Boolean;
var
  CEPQuery: TIBQuery;
begin

  try
    Result := False;
    CEP := StringReplace(Trim(CEP), '-', '', [rfReplaceAll]);
    CEPQuery := TIBQuery.Create(CEPQuery);
    try
