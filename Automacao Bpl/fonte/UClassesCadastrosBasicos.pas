          end;

          Break;
        end;
      end;
    end;
  end;

  tempSql := '';

  if (rSugServico.vCampo = 'Ano Fab') or (rSugServico.vCampo = 'Ano Mod')
  	or (rSugServico.vCampo = 'Cod UF')	or (rSugServico.vCampo = 'Cod Cidade') or (rSugServico.vCampo = 'Cod Bairro')
    or (rSugServico.vCampo = 'Sigla UF') or (rSugServico.vCampo = 'Cidade') or (rSugServico.vCampo = 'Bairro')
    or (rSugServico.vCampo = 'Cep') or (rSugServico.vCampo = 'Endereco') or (rSugServico.vCampo = 'Nome Fantasia')
    or (rSugServico.vCampo = 'Razao') or (rSugServico.vCampo = 'Fone') or (rSugServico.vCampo = 'Email')
