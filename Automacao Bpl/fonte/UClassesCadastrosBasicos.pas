    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS272', acao, 'SUCESSO', 'METAS_VENDAS',
        dataSet.FieldByName('CODIGO_META').AsString, buscas)
