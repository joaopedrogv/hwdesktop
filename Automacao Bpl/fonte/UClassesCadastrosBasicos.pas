function TTransportador.delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Transportador: string;
  vNome_Transportador: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Transportador  := trim(dataSet.FieldByName('CODIGO_TR').AsString);
      vNome_Transportador := trim(dataSet.FieldByName('NOME_TR').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Transportador  := '';
        vNome_Transportador := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Transportador) <> '') then
        prepare_loop('CODIGO_TR = ' + vCod_Transportador)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'TRANSPORTADOR' + #13 +
          'Código: ' + vCod_Transportador + #13 +
          'Nome: ' + vNome_Transportador;

        if (trim(vCod_Transportador) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('BAS104', 'EXCLUIR', '', 'TRANSPORTADOR',
          vDadosIni.IfThen(trim(vCod_Transportador) <> '', vCod_Transportador, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'TRANSPORTADOR' + #13 +
          'Código: ' + vCod_Transportador + #13 +
          'Nome: ' + vNome_Transportador;

        if (trim(vCod_Transportador) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('BAS100', 'EXCLUIR', '', 'TRANSPORTADOR',
           vDadosIni.IfThen(trim(vCod_Transportador) <> '', vCod_Transportador, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo transportador(es) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo transportador(es) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo transportador(es) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo transportador(es) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' update transportador set ativo = 99 ' +
            ' where codigo_tr = %d and cod_empresa = %d ',
            [fint('codigo_tr'), fint('cod_empresa')], buscas);
          if (trim(vCod_Transportador) = '') then
            vDadosIni.GravaAuditoria('BAS104', 'EXCLUIR', '', 'TRANSPORTADOR',
              dataSet.FieldByName('CODIGO_TR').AsString, buscas);
        end
        else
        begin
          SqlExec(' update transportador set ativo = 0 ' +
            ' where codigo_tr = %d and cod_empresa = %d ',
            [fint('codigo_tr'), fint('cod_empresa')], buscas);

          if (trim(vCod_Transportador) = '') then
            vDadosIni.GravaAuditoria('BAS100', 'EXCLUIR', '', 'TRANSPORTADOR',
              dataSet.FieldByName('CODIGO_TR').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS104', 'BAS100'),
        'EXCLUIR', 'SUCESSO', 'TRANSPORTADOR',
        vDadosIni.IfThen(trim(vCod_Transportador) <> '', vCod_Transportador, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS104', 'BAS100'),
        'EXCLUIR', 'FALHA', 'TRANSPORTADOR',
        vDadosIni.IfThen(trim(vCod_Transportador) <> '', vCod_Transportador, ''), buscas);
    end;
    if Result then
      montaSelect(ultimasql);
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TTransportador.edit: boolean;
begin
  FLastError := '';
  if inherited Edit then
  begin
  	dataset.FieldByName('NOME_TR').AsString      := Trim(dataset.FieldByName('NOME_TR').AsString);
    dataset.FieldByName('CNPJ_TR').AsString      := Trim(dataset.FieldByName('CNPJ_TR').AsString);
    dataset.FieldByName('END_TR').AsString       := Trim(dataset.FieldByName('END_TR').AsString);
    dataset.FieldByName('MUNICIPIO_TR').AsString := Trim(dataset.FieldByName('MUNICIPIO_TR').AsString);
    dataset.FieldByName('IE_TR').AsString        := Trim(dataset.FieldByName('IE_TR').AsString);
    dataset.FieldByName('FONE_TR').AsString      := Trim(dataset.FieldByName('FONE_TR').AsString);
    dataset.FieldByName('FAX_TR').AsString       := Trim(dataset.FieldByName('FAX_TR').AsString);

    if fint('cidade_ibge') < 9 then
    begin
      dataSet.FieldByName('cidade_ibge').AsInteger :=
        SqlScalar('select first 1 c.codigo_mun_ibge from cidades_ibge c' +
                  ' inner join estados es on es.ibge_codigo_uf = c.codigo_uf_ibge and es.codigo_uf = %d' +
                  ' where c.nome_municipio = %s',
                  [fint('uf_tr'), fstrq('municipio_tr')]).AsInteger;

      if fint('cidade_ibge') < 9 then
      begin
        FLastError := SqlScalar('select first 1 sigla_uf from estados where codigo_uf = %d', [fint('uf_tr')]).AsString;
        FLastError := Format('Código de cidade IBGE não encontrada com os dados do registro. É necessário ajustar para continuar' + sLineBreak + sLineBreak +
                             'Cidade: "%s"' + sLineBreak +
                             'UF: "%s"', [fstr('municipio_tr'), FLastError]);
        FufIBGE := 0;
      end
      else
        FufIBGE := StrToInt(fstr('cidade_ibge', 1, 2));
    end
    else
      FufIBGE := StrToInt(fstr('cidade_ibge', 1, 2));
    
    Result := True;
  end;
end;

