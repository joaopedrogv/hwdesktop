procedure TCondicaoPagamento.limpaParcelamento;
begin
  SetLength(vValor, 0);
  SetLength(vDocumento, 0);
  SetLength(vData, 0);
end;

function TCondicaoPagamento.montaParcelamento(lista: TListBox;
  parcelas: integer; condPag: string; valor: Currency): boolean;
const
  numeros = ['0'..'9'];
var
  temp: string;
  diaVenc, i, j, k, incDias: integer;
  dias: array of integer;
  dataTemp: TDate;
  condicaoPagamento: string;
begin
  try
    condicaoPagamento := '';
    limpaParcelamento;
    SetLength(dias, 0);
    SetLength(dias, 99);

    if UpperCase(trim(condPag)) = 'A VISTA' then
    begin
      result := false;
      Application.MessageBox('Condição A Vista!', 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if parcelas > 0 then
    begin
      condicaoPagamento := IntToStr(parcelas) + 'X';
      temp := '';
      if vDadosIni.vSistema = 'Fiscal' then
        buscas := TIBQuery(DtmCadBasicos.qrBuscas);

      if temp = '' then
      begin
        if not InputQuery('Todo Dia', 'Dia de Vencimento:', temp) then
        begin
          result := false;
          exit;
        end;
      end;
      diaVenc := StrToInt(temp);
      //for I := 1 to parcelas do
      //  dias[I] := IntToStr(I * 30);
      qtde := parcelas;
    end
    else if trim(condPag) <> '' then
    begin
      incDias := 0;
      temp := '';
      i := 0;
      k := Length(condPag);
      while i <> k do
      begin
        temp := '';
        inc(i);
        for j := i to k do
        begin
          if condPag[j] in numeros then
            temp := temp + condpag[j]
          else
            break;
        end; //fim for j
        i := j;

        try
          if temp <> '' then
          begin
            if StrToInt(temp) > 0 then
            begin
              dias[incDias] := StrToInt(temp);
              Inc(incDias);
            end;
          end;
        except
        end;
        if (i - 1) = k then
          Break;
      end; //fim for i
      qtde := incDias;
    end; //fim else

    SetLength(vValor, qtde);
    SetLength(vDocumento, qtde);
    SetLength(vData, qtde);
    ArredondaParcela(valor, qtde);

    for i := 0 to qtde - 1 do
      vDocumento[I] := vDadosIni.StrZero(numeroVenda, 6) + '-' + IntToStr(I + 1);

    if parcelas > 0 then
    begin
      for i := 0 to qtde - 1 do
      begin
        dataTemp := IncMonth(date, i + 1);
        if IsValidDate(YearOf(dataTemp), MonthOf(dataTemp), diaVenc) then
          vData[i] := DateToStr(StartOfTheMonth(dataTemp) + diaVenc - 1)
        else
          vData[i] := DateToStr(EndOfTheMonth(dataTemp));
      end;
    end
    else
    begin
      for i := 0 to qtde - 1 do
        vData[i] := DateToStr(Date + dias[i]);
    end;
    lista.Clear;
    for I := 0 to qtde - 1 do
      lista.Items.Add(vDocumento[I] + '    ' + vData[I] + '           ' + Format('%m',
        [vValor[I]]));
    result := true;
  except
    on e: exception do
    begin
      result := false;
      Application.MessageBox(pchar('EFPG0019 Erro ao gerar parcelas. Erro: ' + e.Message),
        'Informação', MB_OK + MB_ICONINFORMATION);
      registraErro('EFPG0019 ' + e.Message);
    end;
  end;
end;

