    vDadosIni.vDtSourceTmp := TDataSource.Create(nil);
    vDadosIni.vDtSourceTmp.DataSet := vDadosIni.vDtSetTmp;
    result := (formulario.ShowModal = mrOk);
  finally
    if frmCadEmpresa <> nil then
      frmCadEmpresa.pnReplicacaoInterna.Parent := frmCadEmpresa.tsReplicacaoInterna;
    formulario.Free;
    formulario := nil;
  end;
