function TEstados.delete: boolean;
var
  siglaUF: string;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;
    siglaUF := dataSet.FieldByName('SIGLA_UF').AsString;

    if dataSet.FieldByName('ATIVO').AsInteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
        'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
      begin
        dataSet.OnReconcileError := renconciliaErro;
        //        DataSet.Delete;
        result := inherited Delete;
        if dataSet.ApplyUpdates(-1) = 0 then
          Result := True;
        dataSet.OnReconcileError := nil;

        //        if Result then
        //          result := Apply;
        if result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria('BAS039', 'EXCLUIR', 'SUCESSO', 'ESTADOS', siglaUF, buscas)
        else
          vDadosIni.GravaAuditoria('BAS039', 'EXCLUIR', 'FALHA', 'ESTADOS', siglaUF, buscas);
      end;
    end
    else if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      if inherited Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 0;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria('BAS040', 'ENVIAR REGISTRO PARA A LIXEIRA', 'SUCESSO', 'ESTADOS',
            siglaUF, buscas)
        else
          vDadosIni.GravaAuditoria('BAS040', 'ENVIAR REGISTRO PARA A LIXEIRA ', 'FALHA', 'ESTADOS',
            siglaUF, buscas);
      end;
    end;
    Refresh;
  except
    Result := False;
    dataSet.OnReconcileError := nil;
  end;

end;

