function TTipoDespesa.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS144', 'SALVAR', '', 'TIPO_DESPESA',
      dataSet.FieldByName('COD_TP_DESPESA').AsString, buscas, true) then
      Exit;


    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Descrição do tipo de despesa não informado!', 'DBEdit_Descricao');

    if (dataSet.FieldByName('N_CONTA_PLC').AsFloat <= 0) then
      raiseExceptionCreate('Número do Plano de Contas não informado!', 'DBEdit_NumPlano');

    if not (pPContas.buscarPContas(dataSet.FieldByName('N_CONTA_PLC').AsFloat)) then
      raiseExceptionCreate('Número do Plano de Contas não encontrado!', 'DBEdit_NumPlano');

    if ((acao = 'INSERIR') or ((acao = 'EDITAR') and (dataSet.FieldByName('DESCRICAO').OldValue <> dataSet.FieldByName('DESCRICAO').NewValue))) then
      if ExecutaComandosSql('select cod_tp_despesa from tipo_despesa where descricao = ' +
        quotedstr(dataSet.FieldByName('DESCRICAO').AsString)) then
        raiseExceptionCreate('Já existe um tipo de despesa cadastrado com esta descrição!', 'DBEdit_Descricao');

    if acao = 'INSERIR' then
    begin
      _VerificarCodigoAutoIncremento('GEN_TIPO_DESPESA_ID', 'COD_TP_DESPESA', 'TIPO_DESPESA');
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_TP_DESPESA').AsString;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS144', acao, 'SUCESSO', 'TIPO_DESPESA',
        dataSet.FieldByName('COD_TP_DESPESA').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS144', acao, 'FALHA', 'TIPO_DESPESA',
        dataSet.FieldByName('COD_TP_DESPESA').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Pode ter outro usuário ' +
          'impedindo a gravação. Por favor espere um pouco e confirme novamente,  ' +
          'se o erro persistir contacte o administrador da rede.',
          'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        if dataSet.State = dsBrowse then
          Edit;
      end;
    end;
  end;
end;

