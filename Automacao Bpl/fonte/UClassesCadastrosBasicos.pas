        'REGRAS_TRAVOSREQ', '', buscas)
    else
      vDadosIni.GravaAuditoria('BAS480', 'EXCLUIR',
      	'FALHA - ' + dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString,
        'REGRAS_TRAVOSREQ', '', buscas);

    Result := true;
    Refresh;

    Exit;
  end;

  if not vDadosIni.PesqPros('BAS481', 'EXCLUIR', '', 'REGRAS_TRAVOSREQ',
  	dataSet.FieldByName('TIPO').AsString + ' ' + dataSet.FieldByName('TIPV').AsString, buscas, false) then
