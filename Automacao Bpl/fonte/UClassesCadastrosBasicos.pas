function TCSTMudGeral.EditarRegistro: boolean;
var
  mensagem: string;
begin
  if dataSet.State = dsEdit then
    mensagem := 'Esta modificação está apontando para um registro já existente.'
  else
    mensagem := 'Item repetido.';
  if Application.MessageBox(PChar(mensagem + chr(13) +
    'Deseja alterar os dados deste item já existente?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION
    + MB_DEFBUTTON1) = mrYES then
  begin
    buscas.close;
    buscas.SQL.Text := 'select * from cst_mud_geral where uf_origem = ' +
      dataSet.FieldByName('UF_ORIGEM').AsString +
      ' and uf_destino = ' + dataSet.FieldByName('UF_DESTINO').AsString +
      ' and (cst_interno = ' + QuotedStr(dataSet.FieldByName('CST_INTERNO').AsString) +
      ' or cst_interno is null)' +
      ' and aliq_interna = ' + FloatToStr(dataSet.FieldByName('ALIQ_INTERNA').AsFloat) +
      ' and cfop_interno = ' + FloatToStr(dataSet.FieldByName('CFOP_INTERNO').AsFloat);
    buscas.Open;

    Cancel;
    dataSet.IndexFieldNames := 'UF_ORIGEM;UF_DESTINO;CST_INTERNO;ALIQ_INTERNA;CFOP_INTERNO';
    dataSet.FindNearest([buscas.FieldByName('UF_ORIGEM').AsString,
      buscas.FieldByName('UF_DESTINO').AsString, buscas.FieldByName('CST_INTERNO').AsString,
        buscas.FieldByName('ALIQ_INTERNA').AsFloat, buscas.FieldByName('CFOP_INTERNO').AsFloat]);
    if (dataset.FieldByName('UF_ORIGEM').AsInteger = buscas.FieldByName('UF_ORIGEM').AsInteger) and
      (dataset.FieldByName('UF_DESTINO').AsInteger = buscas.FieldByName('UF_DESTINO').AsInteger) and
      (dataset.FieldByName('CST_INTERNO').AsString = buscas.FieldByName('CST_INTERNO').AsString) and
      (dataset.FieldByName('ALIQ_INTERNA').AsFloat = buscas.FieldByName('ALIQ_INTERNA').AsFloat) and
      (dataset.FieldByName('CFOP_INTERNO').AsFloat = buscas.FieldByName('CFOP_INTERNO').AsFloat)
      then
    begin
      if not edit then
      begin
        result := false;
        Application.MessageBox(PChar('Falha ao tentar editar o registro.'), 'Aviso', MB_OK +
          MB_ICONERROR + MB_DEFBUTTON1);
      end
      else
        result := true;
    end;
  end
  else
    result := false;
end;

