{ TSugestaoServicoItens }

function TSugestaoServicoItens.abreSugServItens(pDataSet: TDataSet): boolean;
var
 vSql: string;
begin
	vSql := ' SELECT SUGESTAOSERVICO.*, REGRAS_SUG.DESCRICAO, ' +
  	' REGRAS_SUG.MES_RET_SERV1, REGRAS_SUG.MES_RET_SERV2, REGRAS_SUG.INTERV_MES_SERV, ' +
   ' REGRAS_SUG.KM_RET_SERV1, REGRAS_SUG.KM_RET_SERV2, REGRAS_SUG.INTERV_KM_SERV, ' +
   vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', '0 ANOFAB, 0 ANOMOD, ', ' VEICULOS.ANOFAB, VEICULOS.ANOMOD, ');
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
  	vSql := vSql + ' EQUIPAMENTO.DAT_CAD_EQUI AS DATA_CAD_TIPO, '
  else
    vSql := vSql + ' VEICULOS.DATA_CAD AS DATA_CAD_TIPO, ';
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
  	vSql := vSql + ' EQUIPAMENTO.NOM_EQUIP DESCRICAO_TP, '
  else
  	vSql := vSql + ' VEICULOS.DESCMODELO DESCRICAO_TP, ';
  vSql := vSql +  
    ' CLIENTES.NOME_CLIENTE, CLIENTES.RAZAO, CLIENTES.FONE_CLIENTE, CLIENTES.EMAIL, ' +
    ' COLABORADOR.NOME_VENDEDOR FROM SUGESTAOSERVICO ';
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
	  vSql := vSql +
    	' LEFT JOIN EQUIPAMENTO ON EQUIPAMENTO.COD_EQUIP = SUGESTAOSERVICO.COD_EQUIP AND EQUIPAMENTO.COD_EMPRESA = SUGESTAOSERVICO.COD_EMPRESA ' +
    	' INNER JOIN REGRAS_SUG_ITENS ON REGRAS_SUG_ITENS.CODIGO = SUGESTAOSERVICO.COD_SERV_SUG AND REGRAS_SUG_ITENS.COD_TIPO = SUGESTAOSERVICO.COD_EQUIP AND REGRAS_SUG_ITENS.COD_EMPRESA = SUGESTAOSERVICO.COD_EMPRESA '
  else
	  vSql := vSql +
    	' LEFT JOIN VEICULOS ON VEICULOS.CODIGO = SUGESTAOSERVICO.COD_VEIC AND VEICULOS.CHASSI = SUGESTAOSERVICO.CHASSI AND VEICULOS.PLACA = SUGESTAOSERVICO.PLACA ' +
    	' INNER JOIN REGRAS_SUG_ITENS ON REGRAS_SUG_ITENS.CODIGO = SUGESTAOSERVICO.COD_SERV_SUG AND REGRAS_SUG_ITENS.COD_TIPO = VEICULOS.MODELO AND REGRAS_SUG_ITENS.COD_EMPRESA = SUGESTAOSERVICO.COD_EMPRESA ';
  vSql := vSql + 
    ' INNER JOIN REGRAS_SUG ON REGRAS_SUG.CODIGO = REGRAS_SUG_ITENS.CODIGO AND REGRAS_SUG.COD_EMPRESA = REGRAS_SUG_ITENS.COD_EMPRESA ' +
    ' LEFT JOIN CLIENTES ON CLIENTES.COD_CLIENTE = SUGESTAOSERVICO.COD_CLIENTE AND CLIENTES.COD_EMPRESA = SUGESTAOSERVICO.COD_EMPRESA ' +
    ' LEFT JOIN COLABORADOR ON COLABORADOR.COD_VENDEDOR = SUGESTAOSERVICO.ULT_ATD AND COLABORADOR.COD_EMPRESA = SUGESTAOSERVICO.COD_EMPRESA ' +
    ' WHERE SUGESTAOSERVICO.DATA = :DATA AND SUGESTAOSERVICO.COD_CLIENTE = :COD_CLIENTE ';
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
    vSql := vSql + ' AND SUGESTAOSERVICO.COD_EQUIP = :COD_EQUIP '
  else
    vSql := vSql + ' AND SUGESTAOSERVICO.COD_VEIC = :COD_VEIC AND SUGESTAOSERVICO.CHASSI = :CHASSI ' +
    	'	AND SUGESTAOSERVICO.PLACA = :PLACA ';
 	vSql := vSql +
    ' AND SUGESTAOSERVICO.COD_EMPRESA =  :COD_EMPRESA ' +
    ' AND SUGESTAOSERVICO.ATIVO = 1 ORDER BY REGRAS_SUG.DESCRICAO ';
  dataSet.Close;
  dataSet.CommandText := vSql;
  dataSet.Params.ParamByName('DATA').AsDateTime := pDataSet.FieldByName('DATA').AsDateTime;
  dataSet.Params.ParamByName('COD_CLIENTE').AsInteger := pDataSet.FieldByName('COD_CLIENTE').AsInteger;
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
	  dataSet.Params.ParamByName('COD_EQUIP').AsInteger := pDataSet.FieldByName('COD_EQUIP').AsInteger
  else
  begin
    dataSet.Params.ParamByName('COD_VEIC').AsInteger := pDataSet.FieldByName('COD_VEIC').AsInteger;
    dataSet.Params.ParamByName('CHASSI').AsString := pDataSet.FieldByName('CHASSI').AsString;
    dataSet.Params.ParamByName('PLACA').AsString := pDataSet.FieldByName('PLACA').AsString;
  end;
  dataSet.Params.ParamByName('COD_EMPRESA').AsInteger := pDataSet.FieldByName('COD_EMPRESA').AsInteger;
  dataSet.Open;


  if (dataSet.FieldByName('STATUS').AsString <> 'CANCELADA') then
  begin
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('SEL').AsString := 'S';
      dataSet.Post;

      dataSet.Next;
    end;
  end;
  dataSet.First;

	Result := not dataSet.IsEmpty;
end;

constructor TSugestaoServicoItens.create;
begin
  if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsSugestaoServItens);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  if vDadosIni.vEmp.vUsarAparelho = 'S' then
  begin
  	 dataSet.FieldByName('MES_RET_SERV1').Tag := 1;
    dataSet.FieldByName('MES_RET_SERV2').Tag := 1;
    dataSet.FieldByName('KM_RET_SERV1').Tag := 1;
    dataSet.FieldByName('KM_RET_SERV2').Tag := 1;
    dataSet.FieldByName('INTERV_KM_SERV').Tag := 1;

    dataSet.FieldByName('MES_RET_SERV1').Visible := false;
    dataSet.FieldByName('MES_RET_SERV2').Visible := false;
    dataSet.FieldByName('KM_RET_SERV1').Visible := false;
    dataSet.FieldByName('KM_RET_SERV2').Visible := false;
    dataSet.FieldByName('INTERV_KM_SERV').Visible := false;
  end;
end;

