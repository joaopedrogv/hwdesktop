    if frmCadRegrasTravReqOS = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadRegrasTravReqOS, frmCadRegrasTravReqOS);
    end;

    if (pTipoForm > 0) and (not frmCadRegrasTravReqOS.Visible) then
      frmCadRegrasTravReqOS.ShowModal
    else if (not frmCadRegrasTravReqOS.Visible) then
      frmCadRegrasTravReqOS.Show
    else if frmCadRegrasTravReqOS.FormStyle = fsMDIChild then
      frmCadRegrasTravReqOS.Show
    else
      frmCadRegrasTravReqOS.ShowModal;
  finally
