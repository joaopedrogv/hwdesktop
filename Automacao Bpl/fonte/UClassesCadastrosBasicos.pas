  dataSet.FieldByName('DATA_CAD').AsDateTime := vDadosIni.getDataBanco(buscas);
  dataSet.FieldByName('HORA_CAD').AsString := FormatDateTime('HH:MM', vDadosIni.getDataHoraBanco(buscas));
  dataSet.FieldByName('COD_EMPRESA').AsInteger := strToInt(vDadosIni.codEmpresa);
end;

function TOcorrenciaSugestaoServico.post: boolean;
var
  acao: string;
  vCodigo: string;
  vMensagem: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if vDadosIni.vEmp.vUsarAparelho = 'S' then
      vMensagem := 'COD EQUIP ' + dataSet.FieldByName('COD_EQUIP').AsString
    else
      vMensagem := 'CHASSI ' + dataSet.FieldByName('CHASSI').AsString +
        ' PLACA ' + dataSet.FieldByName('PLACA').AsString + ' COD VEIC ' + dataSet.FieldByName('COD_VEIC').AsString;

    if not vDadosIni.PesqPros('BAS383', 'SALVAR', vMensagem,
      'OCORRENCIA_SUG', '', buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if trim(dataSet.FieldByName('OBSERVACAO').AsString) = '' then
	    raiseExceptionCreate('Observação deve ser informada', 'DBMemo1');

    if dataSet.State in [dsInsert] then
      dataSet.FieldByName('COD_OCORR').AsInteger := Gencodigo('OCORRENCIA_SUG', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);

    vCodigo := dataSet.FieldByName('COD_OCORR').AsString;
    if vDadosIni.vEmp.vUsarAparelho = 'S' then
      vMensagem := 'COD EQUIP ' + dataSet.FieldByName('COD_EQUIP').AsString
    else
	    vMensagem := 'CHASSI ' + dataSet.FieldByName('CHASSI').AsString +
      ' PLACA ' + dataSet.FieldByName('PLACA').AsString + ' COD VEIC ' + dataSet.FieldByName('COD_VEIC').AsString;

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS383', acao, 'SUCESSO - ' + vMensagem, 'OCORRENCIA_SUG', vCodigo, buscas)
    else
      vDadosIni.GravaAuditoria('BAS383', acao, 'FALHA - ' + vMensagem, 'OCORRENCIA_SUG', vCodigo, buscas);
    if Result then
      Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

{ TOrdemServicoSugestaoServico }

function TOrdemServicoSugestaoServico.abreOrdemServicoSugestaoServico(pDataSet: TDataSet): boolean;
var
 vWhere, vWhere2: string;
begin
  vWhere := ' WHERE PD.TIPO = ''OS'' AND PD.STATUS_PED = ''FECHADA'' ';
  vWhere2 := ' WHERE PD.TIPO = ''OS'' AND PD.STATUS_PED = ''FECHADA'' ';
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
  begin
  	vWhere := vWhere + ' AND PD.COD_EQUIP = :COD_EQUIP ';
    vWhere2 := vWhere2 + ' AND PD.COD_EQUIP = :COD_EQUIP ';
  end
  else
  begin
  	vWhere := vWhere +
    	' AND (PD.PLACA = :PLACA AND PD.CHASSI = :CHASSI AND PD.COD_VEICULO = :COD_VEICULO) ';
    vWhere2 := vWhere2 +
	    ' AND ((PD.PLACA = :PLACA AND PD.CHASSI = :CHASSI AND PD.COD_VEICULO = :COD_VEICULO) ' +
  	  ' OR (PD.PLACA = :PLACA) OR (PD.CHASSI = :CHASSI) OR  (PD.COD_VEICULO = :COD_VEICULO)) ';
  end;
  vWhere := vWhere +
    ' AND PD.COD_EMPRESA = :COD_EMPRESA ' +
    ' ORDER BY 1 DESC, 2 DESC ';
  vWhere2 := vWhere2 +
  	' AND PD.COD_EMPRESA = :COD_EMPRESA ' +
    ' ORDER BY 1 DESC, 2 DESC ';

  dataSet.Close;
  dataSet.CommandText := ' SELECT PD.DATA_PED, PD.DATA_FECH, PD.STATUS_PED, ' +
  	' PD.COD_VENDEDOR, COL.NOME_VENDEDOR, PD.COD_EQUIP, ' +
  	' PD.COD_VEICULO, PD.CHASSI, PD.PLACA, PD.KM_V, ' +
    ' PD.COD_CLIENTE, CL.NOME_CLIENTE, PD.NPED FROM PEDVENDA PD ' +
    ' LEFT JOIN COLABORADOR COL ON COL.COD_VENDEDOR = PD.COD_VENDEDOR AND COL.COD_EMPRESA = PD.COD_EMPRESA ' +
    ' LEFT JOIN CLIENTES CL ON CL.COD_CLIENTE = PD.COD_CLIENTE AND CL.COD_EMPRESA = PD.COD_EMPRESA ' +
    vWhere;
  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
    dataSet.Params.ParamByName('COD_EQUIP').AsInteger := pDataSet.FieldByName('COD_EQUIP').AsInteger
  else
  begin
    dataSet.Params.ParamByName('PLACA').AsString := pDataSet.FieldByName('PLACA').AsString;
    dataSet.Params.ParamByName('CHASSI').AsString := pDataSet.FieldByName('CHASSI').AsString;
    dataSet.Params.ParamByName('COD_VEICULO').AsInteger := pDataSet.FieldByName('COD_VEIC').AsInteger;
  end;
  dataSet.Params.ParamByName('COD_EMPRESA').AsInteger := pDataSet.FieldByName('COD_EMPRESA').AsInteger;
  dataSet.Open;

  if (vDadosIni.vEmp.vUsarAparelho <> 'S') and (dataSet.IsEmpty) then
  begin
    dataSet.Close;
    dataSet.CommandText := Copy(dataSet.CommandText, 0, Pos(' WHERE ', dataSet.CommandText)) + vWhere2;
    if (vDadosIni.vEmp.vUsarAparelho = 'S') then
      dataSet.Params.ParamByName('COD_EQUIP').AsInteger := pDataSet.FieldByName('COD_EQUIP').AsInteger
    else
    begin
      dataSet.Params.ParamByName('PLACA').AsString := pDataSet.FieldByName('PLACA').AsString;
      dataSet.Params.ParamByName('CHASSI').AsString := pDataSet.FieldByName('CHASSI').AsString;
      dataSet.Params.ParamByName('COD_VEICULO').AsInteger := pDataSet.FieldByName('COD_VEIC').AsInteger;
    end;
    dataSet.Params.ParamByName('COD_EMPRESA').AsInteger := pDataSet.FieldByName('COD_EMPRESA').AsInteger;
    dataSet.Open;
  end;

  Result := not dataSet.IsEmpty;
end;

