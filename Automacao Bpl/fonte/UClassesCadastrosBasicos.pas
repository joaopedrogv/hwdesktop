function TCondicaoPagamento.definirCondPagPorEmpresa: boolean;
var
	vCodCondPag: Integer;
	vCondPagSel: boolean;
  vTmp: string;
begin
	try
    Result := False;

    if vEmpresaDefCondPag.dataSet.IsEmpty then
    begin
      Application.MessageBox('Nenhuma empresa selecionada.', 'Informação', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
      exit;
    end;

    vCondPagSel := False;
    vCodCondPag := dataSet.FieldByName('COD_COND_PAG').AsInteger;

    try
      vEmpresaDefCondPag.dataSet.DisableControls;
      vEmpresaDefCondPag.dataSet.First;
      while not vEmpresaDefCondPag.dataSet.Eof do
      begin
        if vEmpresaDefCondPag.dataSet.FieldByName('SEL').AsString = 'S' then
          vCondPagSel := True;

        if vEmpresaDefCondPag.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          vTmp := 'HABILITAR';

          buscas.Close;
          buscas.SQL.Text := ' UPDATE OR INSERT INTO COND_PAG_EMPRESA (COD_COND_PAG, COD_EMPRESA) ' +
            ' VALUES ( ' + IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger) + ', ' +
            IntToStr(vEmpresaDefCondPag.dataSet.FieldByName('COD_EMPRESA').AsInteger) + ') ' +
            ' MATCHING (COD_COND_PAG, COD_EMPRESA); ';
          buscas.ExecSQL;
        end
        else
        begin
          vTmp := 'DESABILITAR';

          buscas.Close;
          buscas.SQL.Text := ' DELETE FROM COND_PAG_EMPRESA ' +
            ' WHERE COD_COND_PAG = ' + IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(vEmpresaDefCondPag.dataSet.FieldByName('COD_EMPRESA').AsInteger);
          buscas.ExecSQL;
        end;

        vDadosIni.GravaAuditoria(
          vDadosIni.IfThen(vEmpresaDefCondPag.dataSet.FieldByName('SEL').AsString = 'S', 'CXG124', 'CXG125'),
          vTmp,
          'Emp: ' + IntToStr(vEmpresaDefCondPag.dataSet.FieldByName('COD_EMPRESA').AsInteger),
          'CONTROLES', IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger), buscas);

        vEmpresaDefCondPag.dataSet.Next;
      end;

      if (not vCondPagSel) then
      begin
        Application.MessageBox('Nenhuma empresa selecionada.', 'Informação', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
        Result := False;
        exit;
      end;

      if buscas.Transaction.InTransaction then
      begin
        buscas.Transaction.Commit;
        vDadosIni.GravaAuditoria(vDadosIni.IfThen(vCondPagSel, 'BAS515', 'BAS516'),
          vDadosIni.IfThen(vCondPagSel, 'HABILITAR', 'DESABILITAR'), 'SUCESSO',
          'COND_PAG', IntToStr(vCodCondPag), buscas);
      end
      else
      begin
        buscas.Transaction.Rollback;
        vDadosIni.GravaAuditoria(vDadosIni.IfThen(vCondPagSel, 'BAS515', 'BAS516'),
          vDadosIni.IfThen(vCondPagSel, 'HABILITAR', 'DESABILITAR'), 'FALHA',
          'COND_PAG', IntToStr(vCodCondPag), buscas);
      end;

    	vEmpresaDefCondPag.abreEmpresaDefCondPag(vCodCondPag);

      Result := True;
    finally
      vEmpresaDefCondPag.dataSet.First;
      vEmpresaDefCondPag.dataSet.EnableControls;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox('Erro ao definir condição de pagamento por empresa.',
        'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vCondPagSel, 'BAS515', 'BAS516'),
      	vDadosIni.IfThen(vCondPagSel, 'HABILITAR', 'DESABILITAR'),	'FALHA',
        'COND_PAG', '', buscas);
    end;
  end;
end;

function TCondicaoPagamento.delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Cond_Pag: string;
  vDesc_Cond_Pag: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Cond_Pag  := trim(dataSet.FieldByName('COD_COND_PAG').AsString);
      vDesc_Cond_Pag := trim(dataSet.FieldByName('DESC_COND_PAG').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar        := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Cond_Pag  := '';
        vDesc_Cond_Pag := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Cond_Pag) <> '') then
        prepare_loop('COD_COND_PAG = ' + vCod_Cond_Pag)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'CONDIÇÃO DE PAGAMENTO' + #13 +
          'Código: ' + vCod_Cond_Pag + #13 +
          'Descrição: ' + vDesc_Cond_Pag;

        if (trim(vCod_Cond_Pag) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('BAS091', 'EXCLUIR', '', 'COND_PAG',
          vDadosIni.IfThen(trim(vCod_Cond_Pag) <> '', vCod_Cond_Pag, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'CONDIÇÃO DE PAGAMENTO' + #13 +
          'Código: ' + vCod_Cond_Pag + #13 +
          'Descrição: ' + vDesc_Cond_Pag;

        if (trim(vCod_Cond_Pag) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('BAS090', 'EXCLUIR', '', 'COND_PAG',
           vDadosIni.IfThen(trim(vCod_Cond_Pag) <> '', vCod_Cond_Pag, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo condição(ões) de pagamento permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo condição(ões) de pagamento para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo condição(ões) de pagamento permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo condição(ões) de pagamento para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' update cond_pag set ativo = 99 ' +
            ' where cod_cond_pag = %d ',
            [fint('cod_cond_pag')], buscas);
          if (trim(vCod_Cond_Pag) = '') then
            vDadosIni.GravaAuditoria('BAS091', 'EXCLUIR', '', 'COND_PAG',
              dataSet.FieldByName('COD_COND_PAG').AsString, buscas);
        end
        else
        begin
          SqlExec(' update cond_pag set ativo = 0 ' +
            ' where cod_cond_pag = %d ',
            [fint('cod_cond_pag')], buscas);

          if (trim(vCod_Cond_Pag) = '') then
            vDadosIni.GravaAuditoria('BAS090', 'EXCLUIR', '', 'COND_PAG',
              dataSet.FieldByName('COD_COND_PAG').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS091', 'BAS090'),
        'EXCLUIR', 'SUCESSO', 'COND_PAG',
        vDadosIni.IfThen(trim(vCod_Cond_Pag) <> '', vCod_Cond_Pag, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS091', 'BAS090'),
        'EXCLUIR', 'FALHA', 'COND_PAG',
        vDadosIni.IfThen(trim(vCod_Cond_Pag) <> '', vCod_Cond_Pag, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

