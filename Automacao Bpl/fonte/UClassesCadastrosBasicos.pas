function TProcessosEmp.gravarProcesso(Cod_Empresa: integer): boolean;

var
  I: integer;
begin
  try
    buscas.close;
    buscas.SQL.Clear;
    buscas.SQL.Add('select * from TABELA_PROCESSOS where COD_EMPRESA = ' + vDadosIni.codEmpresa);
    buscas.Open;

    First;
    while not buscas.Eof do
    begin
      dataSet.Insert;
      dataSet.FieldByName('COD_PROCESSO').AsString :=
        buscas.FieldByName('COD_PROCESSO').AsString;
      dataSet.FieldByName('COD_EMPRESA').AsInteger := cod_Empresa;
      dataSet.FieldByName('NOME_PROCESSO').AsString :=
        buscas.FieldByName('NOME_PROCESSO').AsString;
      dataSet.FieldByName('NIVEL_PROCESSO').AsInteger :=
        buscas.FieldByName('NIVEL_PROCESSO').AsInteger;
      dataSet.FieldByName('SENHA_GERENTE').AsString :=
        buscas.FieldByName('SENHA_GERENTE').AsString;
      dataSet.FieldByName('FORM').AsString := buscas.FieldByName('FORM').AsString;
      dataSet.FieldByName('ATIVO').AsString := buscas.FieldByName('ATIVO').AsString;
      dataset.post;
      buscas.Next;
    end;
    {if Apply then
    begin
      CommitaTransacao;
      result := true;
    end
    else begin
      cancel;
      RollBackTransacao;
      result := false;
    end;}
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

