    end;

    CommitaTransacao;

    vDadosIni.GravaAuditoria(codprocesso, 'SALVAR', 'SUCESSO', 'COND_PAG', codigo, buscas);
    
    Result := true;
  Except
     on e: Exception do
     begin
        Result := false;

        vDadosIni.GravaAuditoria(codprocesso, 'SALVAR', 'FALHA', 'COND_PAG', codigo, buscas);

        Application.MessageBox( pchar(e.Message) ,'Atenção' ,MB_ICONERROR + MB_OK );
        registraErro(e.Message);
     end;
  end;
end;

procedure TCondicaoPagamento.ArredondaParcela(Valor: Currency; Quant: Integer);
var
  resto, vr: Currency;
  i: Integer;
begin
  vr := 0;
  for i := 0 to Length(vValor) - 1 do
    vValor[i] := vDadosIni.StrToFloatFormat((valor / quant), 2);
  vValor[0] := vDadosIni.StrToFloatFormat(vValor[0] +
    (valor - (vValor[0] * quant)), 2);
end;

