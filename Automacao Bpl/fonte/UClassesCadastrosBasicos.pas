function TSenha.delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vUsuario: string;
  I: Integer;
begin
  try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar   := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vUsuario  := trim(dataSet.FieldByName('USUARIO').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar  := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vUsuario := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vUsuario) <> '') then
        prepare_loop('USUARIO = ' + QuotedStr(vUsuario))
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'SENHA' + #13 +
          'Usuario: ' + vUsuario;

        if (trim(vUsuario) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('CFG031', 'EXCLUIR', '', 'SENHAS',
          vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'SENHA' + #13 +
          'Usuario: ' + vUsuario;

        if (trim(vUsuario) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('CFG027', 'EXCLUIR', '', 'SENHAS',
           vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo senha(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo senha(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo senha(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo senha(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' delete from senhas ' +
            ' where usuario = %s and cod_empresa = %d ',
            [fstrq('usuario'), fint('cod_empresa')], buscas);
          if (trim(vUsuario) = '') then
            vDadosIni.GravaAuditoria('CFG031', 'EXCLUIR', '', 'SENHAS',
              dataSet.FieldByName('USUARIO').AsString, buscas);
        end
        else
        begin
          SqlExec(' update senhas set ativo = 0 ' +
            ' where usuario = %s and cod_empresa = %d ',
            [fstrq('usuario'), fint('cod_empresa')], buscas);

          if (trim(vUsuario) = '') then
            vDadosIni.GravaAuditoria('CFG027', 'EXCLUIR', '', 'SENHAS',
              dataSet.FieldByName('USUARIO').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CFG031', 'CFG027'),
        'EXCLUIR', 'SUCESSO', 'SENHAS',
        vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CFG031', 'CFG027'),
        'EXCLUIR', 'FALHA', 'SENHAS',
        vDadosIni.IfThen(trim(vUsuario) <> '', vUsuario, ''), buscas);
    end;
    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

