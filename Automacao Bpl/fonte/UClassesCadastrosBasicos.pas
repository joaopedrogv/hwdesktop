function TPerfilComissao.Insert: boolean;
begin
  if not vDadosIni.PesqPros('BAS257', 'INCLUIR', '', 'PERFIL_COMISSAO',
    '', buscas, True) then
    Exit;

  if not dataSet.Active then
    montaSelect('select p.* from perfil_comissao p ' +
      ' where p.ativo=0');

  Result := False;
  if inherited Insert then
  begin
    Result := True;
    dataSet.FieldByName('DATA_CADASTRO').AsDateTime := StrToDateTime(FormatDateTime('DD/MM/YYYY', vDadosIni.getDataHoraBanco(DtmCadBasicos.qrBuscas)));
    dataSet.FieldByName('ATIVO').AsFloat := 1;
    _abreTiposVendas;
    FConteudos.Init('Nenhum', '');
    FTipoVendas.Init('Tipo Venda', '');

    dataSet.FieldByName('TIPO_SERV_PROD').OnChange := DataSetFieldsChange;
    dataSet.FieldByName('TIPO_PERFIL').OnChange := DataSetFieldsChange;

    vagrupar := '';
    vtipo := '';
    vselecao := '';
    vemcima := '';
  end;
end;

function TPerfilComissao.post: boolean;
var
  acao, strConteudo, strTabelas: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS262', 'SALVAR', '', 'PERFIL_COMISSAO',
      dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';
      
    strConteudo := FConteudos.GetValores;
    strTabelas  := FTipoVendas.GetValores;

    checkFieldEmpty('NOME_PERFIL', 'Descrição do Perfil deve ser informado', 'DBEdit2');

    if not fmatchText('TIPO_PERFIL', [strVendaGeral, strProduto, strPrestacaoRecebida, strModRecebimento]) then
      raiseExceptionCreate('Agrupado por deve ser informado, ou valor incorreto', 'DBComboBox4');

    checkFieldEmpty('ABRANG_PERFIL', 'Tipo de Comissão deve ser informado, ou valor incorreto!', 'DBComboBox1');

    if fdif('TIPO_PERFIL', strProduto) then
      checkFieldEmpty('PERC_PESO', 'Percentual ou peso deve ser informado', 'DBEdit9');

    if fmatchText('TIPO_PERFIL', [strVendaGeral, strProduto]) then
      checkFieldEmpty('TIPO_SERV_PROD', 'Tipo deve ser informado, ou valor incorreto', 'DBComboBox2');

    if fequals('TIPO_PERFIL', strVendaGeral) then
      checkFieldEmpty('EM_CIMA_PERFIL', 'Em cima deve ser informado, ou valor incorreto', 'DBComboBox5');
                                           
    checkFieldEmpty('FLAG_SERV_PROD', 'Tipo de Seleção deve ser informado, ou valor incorreto', 'DBComboBox3');

    if fmatchText('TIPO_PERFIL', [strVendaGeral, strProduto]) then
      if strTabelas = '' then
        raiseExceptionCreate('Tabelas de Venda deve ser informado', 'DBMemo2');

    fdata('conteudo_flag').Put(strConteudo);
    fdata('tabelas_perfil').Put(strTabelas);
    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(PERFIL_COMISSAO,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('CODIGO_PERFIL').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_PERFIL').AsString;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    dataSet.FieldByName('TIPO_SERV_PROD').OnChange := nil;
    dataSet.FieldByName('TIPO_PERFIL').OnChange := nil;

    if Result then
      vDadosIni.GravaAuditoria('BAS262', acao, 'SUCESSO', 'PERFIL_COMISSAO',
        dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS262', acao, 'FALHA', 'PERFIL_COMISSAO',
        dataSet.FieldByName('CODIGO_PERFIL').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

