function cond_pag_montar_parcelamento(ACodCP: Integer; ADescrCP: string; AValor: Currency; ANumDoc: string;
      ATipoParcelamento: string = ''; AModalidade: string = ''; ACondiderarDiaUtil: string = '';
      ADiaBase: string = ''; ACodCliente: Integer = 0; AJurosPrat: Double = 0 ;
      ADiaSimulacao: TDate = 0; ACodCtrl: Integer = 0; AMaxPArcelasAdicionais: Smallint = 0;
      Asilent: Boolean = False; AdefaultDaySilentMode: Smallint = 0): RParcelamentos;
var
  ACondPag: TCondicaoPagamento;
begin
  ACondPag := TCondicaoPagamento.create;
  try
    Result := ACondPag.MontarPacelamento(ACodCP, ADescrCP, AValor, ANumDoc,
      ATipoParcelamento, AModalidade, ACondiderarDiaUtil, ADiaBase, ACodCliente,
      AJurosPrat, ADiaSimulacao, ACodCtrl, AMaxPArcelasAdicionais, Asilent, AdefaultDaySilentMode);
  finally
    FreeAndNil(ACondPag);
  end;
end;

function MontarPacelamentoStr(ACodCP: Integer; ADescrCP: string; AValor: Currency; ANumDoc: string;
  ATipoParcelamento: string = ''; AModalidade: string = ''; ACondiderarDiaUtil: string = '';
  ADiaBase: string = ''; ACodCliente: Integer = 0; AJurosPrat: Double = 0 ;
  ADiaSimulacao: TDate = 0; ACodCtrl: Integer = 0; Asilent: Boolean = False): string;//formato TStrings
var
  ACondPag: TCondicaoPagamento;
  ARetorno: TStrings;
  AParcelas: RParcelamentos;
  I, J: Integer;
  AStr: string;
begin
  ARetorno := TStringList.Create;
  ACondPag := TCondicaoPagamento.create;
  try
    AParcelas := ACondPag.MontarPacelamento(ACodCP, ADescrCP, AValor, ANumDoc,
      ATipoParcelamento, AModalidade, ACondiderarDiaUtil, ADiaBase, ACodCliente,
      AJurosPrat, ADiaSimulacao, ACodCtrl, 0, Asilent, 0);

    for I := Low(AParcelas) to High(AParcelas) do
    begin
      AStr := '|' + AParcelas[I].NumeroDocumento +
              '|' + FormatDateTime('dd/mm/yyyy', AParcelas[I].DataVencimento) +
              '|' + Format('%0.2f', [AParcelas[I].ValorParcela]);
      if Assigned(AParcelas[i].Feriados) then
        for J := 0 to AParcelas[i].Feriados.Count - 1 do
          AStr := AStr + '|' + IfThen(J > 0, '#') + AParcelas[i].Feriados[J];
      AStr := AStr + '|';
      ARetorno.Add(AStr);
    end;

    Result := ARetorno.Text;
  finally
    FreeAndNil(ACondPag);
    FreeAndNil(ARetorno);
  end;
end;

