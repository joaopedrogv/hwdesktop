//        quotedstr(dataSet.FieldByName('NOME_DEPTO').AsString)) then
//        raise exception.create('Já existe um departamento cadastrado com este nome.');
//      }
//    end;

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_DEPTO,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('COD_DEPTO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      if ExecutaComandosSql('select COD_DEPTO from DEPTO where COD_DEPTO = ' +
        dataSet.FieldByName('COD_DEPTO').AsString) then
        raise exception.create('Erro ao inserir');
      vDadosIni.vPesquisa := dataSet.FieldByName('COD_DEPTO').asstring;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
