function TConciliacaoEstEmpAdq.post: boolean;
var
  acao: string;
  codigo: integer;
  vCodFormula: string;
begin
  try
    Result := false;

    vCodFormula :=
    	dataSet.FieldByName('ID_ADQUIRENTE').AsString + '-' +
      dataSet.FieldByName('COD_ESTAB').AsString + '-' +
      dataSet.FieldByName('CODIGO').AsString;

    if not vDadosIni.PesqPros('BAS523', 'SALVAR', '', 'CONCILIACAO_ESTAB_EMP',
      vCodFormula, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataSet.FieldByName('ID_ADQUIRENTE').AsInteger <= 0 then
      raiseExceptionCreate('Id adquirente deve ser informado', 'DBEdit1');

    if dataSet.FieldByName('ID_ADQUIRENTE').AsInteger > 0 then
    	if not vConciliacaoAdq._buscarConciliacaoArq(dataSet.FieldByName('ID_ADQUIRENTE').AsInteger) then
      	raiseExceptionCreate('Adquirente não encontrado', 'DBEdit1');

    if dataSet.FieldByName('COD_ESTAB').AsInteger <= 0 then
      raiseExceptionCreate('Código do estabelecimento deve ser informado', 'DBEdit2');

    if dataSet.FieldByName('COD_ESTAB').AsInteger > 0 then
    	if not vConciliacaoEstEmp._buscarConciliacaoEstEmp(dataSet.FieldByName('COD_ESTAB').AsInteger) then
      	raiseExceptionCreate('Estabelecimento não encontrado', 'DBEdit2');

    if trim(dataSet.FieldByName('CODIGO').AsString) = '' then
      raiseExceptionCreate('Código do estabelecimento deve ser informado', 'DBEdit3');

    dataSet.FieldByName('CODIGO').AsString := trim(dataSet.FieldByName('CODIGO').AsString);

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS523', acao, 'SUCESSO', 'CONCILIACAO_ESTAB_EMP',
        vCodFormula, buscas)
    else
      vDadosIni.GravaAuditoria('BAS523', acao, 'FALHA', 'CONCILIACAO_ESTAB_EMP',
        vCodFormula, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

