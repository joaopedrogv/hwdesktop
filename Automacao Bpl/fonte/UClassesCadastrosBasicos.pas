function TNaturezaOperacao.post: boolean;
var
  acao, pTp, vTemp: string;
  ACommitAnyWay: Boolean;
begin
  try
    Result := false;
    ACommitAnyWay := False;
    if not (dataSet.State in [dsInsert, dsEdit]) then
      exit;
    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataset.FieldByName('CODIGO_NOP').AsString = '' then
      raise exception.Create('O campo Código não informado!');

    if dataset.FieldByName('DESCRICAO_NOP').AsString = '' then
      raise exception.Create('O campo descrição não informado!');

    if dataset.FieldByName('ALIQ_INT_SAID').AsString = '' then
      raise exception.Create('O campo Alíq. Saida Venda não informado!');

    pTp := trim(dataset.FieldByName('TIPV_VEICULO').AsString);

    if (vDadosIni.vRegistro.vSisVeiculos) then
    begin
      if (pTp <> 'A') and (pTp <> 'C') and (pTp <> 'D') and (pTp <> 'E')
      and (pTp <> 'O') and (pTp <> 'R') and (pTp <> 'T') and (pTp <> 'V') and (pTp <> '') then
        raiseExceptionCreate('Tipo de Operação não existe: "' + pTp + '"', 'DBComboBox13');
    end
    else
    begin
      if (pTp <> 'A') and (pTp <> '') then
        raiseExceptionCreate('Tipo de Operação não existe: "' + pTp + '"', 'DBComboBox13');
    end;

    if Trim(dataset.FieldByName('NAT_BC_CRED').AsString) <> '' then
    begin
      try
        if (StrToInt(Trim(dataset.FieldByName('NAT_BC_CRED').AsString)) <= 0) then
          raiseExceptionCreate('Campo "Natureza da Base de Cálculo de Crédito - SPED PIS/COFINS" ' +
            'deve ser preenchido para operações geradoras de crédito com o valor numérico de 2 dígitos maior que 0',
            'DBComboBox8');
      except
        raiseExceptionCreate('Campo "Natureza da Base de Cálculo de Crédito - SPED PIS/COFINS" ' +
          'deve ser preenchido para operações geradoras de crédito com o valor numérico de 2 dígitos maior que 0',
          'DBComboBox8');
      end;
      dataset.FieldByName('NAT_BC_CRED').AsString := vDadosIni.StrZero(Trim(dataset.FieldByName('NAT_BC_CRED').AsString),2);
    end;

    if ((dataSet.FieldByName('TIPV_VEICULO').AsString = 'C')
      or (dataSet.FieldByName('TIPV_VEICULO').AsString = 'A')
      or (dataSet.FieldByName('TIPV_VEICULO').AsString = 'D'))
      and (dataSet.FieldByName('ALT_EST').AsString <> 'N') then
    begin
       if (dataSet.FieldByName('TIPV_VEICULO').AsString = 'C') then
         vTemp := '"C - ENTRADA EM CONSIGNAÇÃO"'
       else if (dataSet.FieldByName('TIPV_VEICULO').AsString = 'A') then
         vTemp := '"A - ATIVO IMOBILIZADO"'
       else if (dataSet.FieldByName('TIPV_VEICULO').AsString = 'D') then
         vTemp := '"D - ENTRADA EM DEMONSTRACAO"';
       raiseExceptionCreate('Tipo de Operação ' + vTemp +
         ', deve estar configurado como Alterar Estoque "N"' + #13 +
         'Favor verificar as configurações!', 'DBComboBox13');
    end;

    if (Trim(FCodContaContabil) <> '') or (Trim(FCodContaContabil_Old) <> '') then
    begin
      if (Trim(FCodContaContabil_Old) <> Trim(FCodContaContabil)) and
         (Trim(FCodContaContabil_Old) <> '') then
      begin
        buscas.Close;
        buscas.SQL.Text := 'delete from NAT_OP_P_CONTAS_CONTABIL' +
          ' where codigo_nop = :codigo_nop and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ParamByName('codigo_nop').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
        buscas.ExecSQL;
        ACommitAnyWay := True;
      end;
      if (Trim(FCodContaContabil) <> '') then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select CODIGO_NOP, COD_CTA, COD_EMPRESA from NAT_OP_P_CONTAS_CONTABIL ' +
          ' where CODIGO_NOP = :CODIGO_NOP and COD_CTA = :COD_CTA and COD_EMPRESA = :COD_EMPRESA ';
        buscas.ParamByName('CODIGO_NOP').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
        buscas.ParamByName('COD_CTA').AsString := FCodContaContabil;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.Open;

        if buscas.IsEmpty then
        begin
          buscas.Close;
        buscas.SQL.Text := 'insert into NAT_OP_P_CONTAS_CONTABIL (CODIGO_NOP, COD_CTA, COD_EMPRESA) ' +
          ' values (:CODIGO_NOP, :COD_CTA, :COD_EMPRESA)';
        buscas.ParamByName('CODIGO_NOP').AsFloat := dataSet.FieldByName('codigo_nop').AsFloat;
        buscas.ParamByName('COD_CTA').AsString := FCodContaContabil;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ExecSQL;
        ACommitAnyWay := True;
      end;
    end;
    end;

    if dataSet.FieldByName('CFOP_CONV_SAIDA_INTRA').AsFloat > 0 then
      if Copy(trim(dataSet.FieldByName('CFOP_CONV_SAIDA_INTRA').AsString), 1, 1) <> '5' then
        raiseExceptionCreate('CFOP Intraestadual deve começar com 5', 'DBEdit8');

    if dataSet.FieldByName('CFOP_CONV_SAIDA_INTRA').AsFloat > 0 then
      if Length(trim(dataSet.FieldByName('CFOP_CONV_SAIDA_INTRA').AsString)) <> 4 then
        raiseExceptionCreate('CFOP Intraestadual incorreto', 'DBEdit8');

    if dataSet.FieldByName('CFOP_CONV_SAIDA_INTER').AsFloat > 0 then
      if Copy(trim(dataSet.FieldByName('CFOP_CONV_SAIDA_INTER').AsString), 1, 1) <> '6' then
        raiseExceptionCreate('CFOP Interestadual Não Contribuinte deve começar com 6', 'DBEdit9');

    if dataSet.FieldByName('CFOP_CONV_SAIDA_INTER').AsFloat > 0 then
      if Length(trim(dataSet.FieldByName('CFOP_CONV_SAIDA_INTER').AsString)) <> 4 then
        raiseExceptionCreate('CFOP Interestadual Não Contribuinte incorreto', 'DBEdit9');

    Result := inherited post;

    if acao = 'INSERIR' then
      vDadosIni.vPesquisa := dataSet.FieldByName('CODIGO_NOP').asstring;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      if ACommitAnyWay then
        CommitaTransacao;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS069', acao, 'SUCESSO', 'NAT_OP',
        dataSet.FieldByName('CODIGO_NOP').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS069', acao, 'FALHA', 'NAT_OP',
        dataSet.FieldByName('CODIGO_NOP').AsString, buscas);
    if Result then
      Refresh
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TNaturezaOperacao.restauraLixeira: boolean;
begin
  result := false;
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      begin
        if inherited Edit then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          result := inherited Post;
          if Result then
            result := Apply;
          if Result then
            result := CommitaTransacao;
          if Result then
            vDadosIni.GravaAuditoria('BAS067', 'RESTAURAR REGISTRO', 'SUCESSO', 'NAT_OP',
              dataSet.FieldByName('CODIGO_NOP').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS067', 'RESTAURAR REGISTRO', 'FALHA', 'NAT_OP',
              dataSet.FieldByName('CODIGO_NOP').AsString, buscas);
        end;
      end;
    end;
  Refresh;
end;

function TNaturezaOperacao.StatusLixeira: boolean;
begin
  result := ExecutaComandosSql('SELECT first 1 CODIGO_NOP FROM NAT_OP where ativo = 0');
end;

function TNaturezaOperacao.verificaCodigo(cod: string): boolean;
begin
  result := false;
  if dataSet.State = dsEdit then
  begin
    if trim(dataSet.FieldByName('CODIGO_NOP').OldValue) <>
      trim(dataSet.FieldByName('CODIGO_NOP').NewValue) then
    begin
      Result := ExecutaComandosSql('SELECT first 1 CODIGO_NOP FROM NAT_OP where CODIGO_NOP = ' +
        trim(cod));
      if result then
        Application.MessageBox('Erro ao Alterar CFOP.' +
          chr(13) + 'Código de Natureza de Operação duplicado', 'Erro', MB_OK + MB_ICONERROR +
          MB_DEFBUTTON1);
    end;
  end
  else
  begin
    Result := ExecutaComandosSql('SELECT first 1 CODIGO_NOP FROM NAT_OP where CODIGO_NOP = ' +
      trim(cod));
    if result then
      Application.MessageBox('Erro ao Cadastrar CFOP' +
        chr(13) + 'Código de Natureza de Operação já existente', 'Erro', MB_OK + MB_ICONERROR +
        MB_DEFBUTTON1);
  end;
end;

function TNaturezaOperacao.verificaExisteNATOP(cod: integer): boolean;
begin
  result := false;
  result :=
    ExecutaComandosSql('select first 1 CODIGO_NOP from NAT_OP where ATIVO=1 and CODIGO_NOP = ' +
    trim(IntToStr(cod)));
end;

function TNaturezaOperacao.verificaNFEntrada(cod: string): boolean;
begin
  result := false;
  result :=
    ExecutaComandosSql('select first 1 COD_NF from NOTAFISCAL where NATUREZA_NF=''E'' and CODIGO_NOP = '
    + trim(cod));
  if not result then
    result := ExecutaComandosSql('select first 1 NUM_NOTA_NFE from NF_ENTRADA where CODIGO_NOP = ' +
      trim(cod));
end;

function TNaturezaOperacao.verificaNFvenda(cod: string): boolean;
begin
  result := false;
  result :=
    ExecutaComandosSql('select first 1 COD_NF from NOTAFISCAL where NATUREZA_NF=''S'' and CODIGO_NOP = '
    + trim(cod));
  if not result then
    result := ExecutaComandosSql('select first 1 NUM_NF_VND from NF_VENDA where CODIGO_NOP =' +
      trim(cod));
end;

