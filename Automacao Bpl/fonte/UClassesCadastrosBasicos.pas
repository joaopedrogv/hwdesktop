  	exit;

  try
    vDadosIni.abreStatusProcessamento('', 'Carregando equipamentos');
    pDataset.DisableControls;
    pDataset.First;
    while not pDataset.Eof do
    begin
      dataSet.Filter := 'COD_EQUIP = ' + IntToStr(pDataset.FieldByName('COD_TIPO').AsInteger);
      dataSet.Filtered := True;

      if not dataSet.IsEmpty then
      begin
        dataSet.Edit;
        dataSet.FieldByName('SEL').AsString := 'S';
        dataSet.Post;
      end;

      pDataset.Next;
    end;
  finally
    dataSet.Filtered := false;
    dataSet.Filter := '';
    dataSet.IndexFieldNames := 'nom_equip';
    pDataset.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TEquipamentosServ._marcarTodos(pDataset: TDataSet);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');

    if not vDadosIni.PesqPros('BAS374', 'SELECIONAR', 'TIPO: ' + QuotedStr(pDataset.FieldByName('TIPO').AsString) +
   		'CODIGO: ' + IntToStr(pDataset.FieldByName('CODIGO').AsInteger), 'REGRAS_SUG_ITENS',
   		 '', buscas, true) then
    Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := 'S';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

