procedure TBairros.PostErro(DataSet: TDataSet; E: EDatabaseError;
  var Action: TDataAction);
begin
  try // of PRIMARY or UNIQUE KEY
    if (Pos('key violation', LowerCase(e.Message)) <> 0) then
    begin
      if Application.MessageBox('Erro ao gravar registro. Código do bairro duplicado.' + chr(13) +
        'Deseja incrementar o código do bairro em 1 e tentar novamente?', 'Confirmação', MB_YESNO
        +
        MB_ICONQUESTION + MB_DEFBUTTON1) = ID_YES then
      begin
        buscas.close;
        buscas.SQL.Text := 'select GEN_ID(INC_COD_BAIRRO,1) from rdb$database';
        buscas.Open;
        dataSet.FieldByName('COD_BAIRRO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      end
      else
      begin
        RollBackTransacao;
        Self.DataSet.CancelUpdates;
        abort;
      end;
    end;
  finally
  end;

end;

