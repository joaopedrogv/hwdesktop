  if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  DataSet := TClientDataSet(DtmCadBasicos.CdsDepartamentos);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  Buscas := TIBQuery(DtmCadBasicos.qrBuscasDep);
end;

function TDepartamentos.delete: boolean;
var
  codDepto: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;
  codDepto := dataSet.FieldByName('COD_DEPTO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 0 then
  begin
    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
    begin
      result := inherited Delete;
      if Result then
        result := Apply;
      if result then
        result := CommitaTransacao;
      if Result then
        vDadosIni.GravaAuditoria('BAS003', 'EXCLUIR', 'SUCESSO', 'DEPTO', codDepto, buscas)
      else
        vDadosIni.GravaAuditoria('BAS003', 'EXCLUIR', 'FALHA', 'DEPTO', codDepto, buscas);
    end;
  end
  else if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
  begin
    if inherited Edit then
    begin
      dataSet.FieldByName('ATIVO').asinteger := 0;
      result := inherited Post;
      if Result then
        result := Apply;
      if Result then
        result := CommitaTransacao;
      if Result then
        vDadosIni.GravaAuditoria('BAS003', 'ENVIAR REGISTRO PARA A LIXEIRA', 'SUCESSO', 'DEPTO',
          codDepto, buscas)
      else
        vDadosIni.GravaAuditoria('BAS003', 'ENVIAR REGISTRO PARA A LIXEIRA ', 'FALHA', 'DEPTO',
          codDepto, buscas);
    end;
  end;
  Refresh;
end;

