function TRegrasSugServItens.abreRegrasSugServItens(
  pDataset: TDataSet): boolean;
begin
	Result := montaSelect(' select * from regras_sug_itens  ' +
  	' where codigo = ' + IntToStr(pDataset.FieldByName('CODIGO').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and tipo = ' + QuotedStr(pDataset.FieldByName('TIPO').AsString));
end;

constructor TRegrasSugServItens.create;
begin
  if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsRegrasSugServItens);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  vModVeiculosServ := TModVeiculosServ.create;
	vEquipamentosServ := TEquipamentosServ.create;
end;

destructor TRegrasSugServItens.destroy;
begin
  vModVeiculosServ.Free;
  vModVeiculosServ := nil;

  vEquipamentosServ.Free;
  vEquipamentosServ := nil;
  
  inherited;
end;

function TRegrasSugServItens.Insert(pDataset: TDataSet): boolean;
begin
  Result := False;
  if not vDadosIni.PesqPros('BAS234', 'INCLUIR', '', 'REGRAS_SUG',
    '', buscas, True) then
    Exit;

  if trim(pDataset.FieldByName('TIPO').AsString) = 'E' then
  begin
    if vEquipamentosServ.dataSet.IsEmpty then
    begin
    	Application.MessageBox('Nenhum equipamento selecionado.', 'Erro', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
      exit;
    end;
  end
  else
  begin
    if vModVeiculosServ.dataSet.IsEmpty then
    begin
      Application.MessageBox('Nenhum modelo de veículo selecionado.', 'Erro', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
      exit;
    end;
  end;

  // Apaga todos itens para inclui-los novamente 
  buscas.Close;
  buscas.SQL.Text := ' delete from regras_sug_itens ' +
  	' where codigo = ' + IntToStr(pDataset.FieldByName('CODIGO').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.ExecSQL;

  if pDataset.FieldByName('TIPO').AsString = 'E' then
  begin
    try
      vEquipamentosServ.dataSet.Filter := 'SEL = ''S''';
      vEquipamentosServ.dataSet.Filtered := True;

//      vEquipamentosServ.dataSet.DisableControls;
      vDadosIni.abreStatusProcessamento('', 'Aguarde. Incluindo regra para o(s) equipamento(s) ');
      vEquipamentosServ.dataSet.First;
      while not vEquipamentosServ.dataSet.Eof do
      begin
        if vEquipamentosServ.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          montaSelect(' select * from regras_sug_itens ' +
				    ' where codigo = ' + IntToStr(pDataset.FieldByName('CODIGO').AsInteger) +
            ' and cod_tipo = ' + IntToStr(vEquipamentosServ.dataSet.FieldByName('COD_EQUIP').AsInteger) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and tipo = ''E'' ');

          if dataSet.IsEmpty then
	          dataSet.Insert
          else
          	dataSet.Edit;  
          dataSet.FieldByName('CODIGO').AsInteger := pDataset.FieldByName('CODIGO').AsInteger;
				  dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
          dataSet.FieldByName('COD_TIPO').AsInteger := vEquipamentosServ.dataSet.FieldByName('COD_EQUIP').AsInteger;
				  dataSet.FieldByName('TIPO').AsString := pDataset.FieldByName('TIPO').AsString;
          dataSet.Post;
          Apply;
        end;

        vEquipamentosServ.Next;
      end;
    finally
//       vEquipamentosServ.dataSet.EnableConstraints;
       vEquipamentosServ.dataSet.Filter := '';
       vEquipamentosServ.dataSet.Filtered := false;
       vEquipamentosServ.IndexFieldNames := 'nom_equip';
       vDadosIni.fechaStatusProcessamento;
    end;
  end
  else
  begin
    try
      vModVeiculosServ.dataSet.Filter := 'SEL = ''S''';
      vModVeiculosServ.dataSet.Filtered := True;

//      vModVeiculosServ.dataSet.DisableControls;
      vDadosIni.abreStatusProcessamento('', 'Aguarde.. Incluindo regra para o(s) modelos de veículo ');
      vModVeiculosServ.dataSet.First;
      while not vModVeiculosServ.dataSet.Eof do
      begin
        if vModVeiculosServ.dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          montaSelect(' select * from regras_sug_itens ' +
				    ' where codigo = ' + IntToStr(pDataset.FieldByName('CODIGO').AsInteger) +
            ' and cod_tipo = ' + IntToStr(vModVeiculosServ.dataSet.FieldByName('CODIGO').AsInteger) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and tipo = ''V'' ');
            
          if dataSet.IsEmpty then
	          dataSet.Insert
          else
          	dataSet.Edit;
          dataSet.FieldByName('CODIGO').AsInteger := pDataset.FieldByName('CODIGO').AsInteger;
				  dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
          dataSet.FieldByName('COD_TIPO').AsInteger := vModVeiculosServ.dataSet.FieldByName('CODIGO').AsInteger;
				  dataSet.FieldByName('TIPO').AsString := pDataset.FieldByName('TIPO').AsString;
          dataSet.Post;
          Apply;
        end;

        vModVeiculosServ.Next;
    end;

    finally
//      vModVeiculosServ.dataSet.EnableControls;
      vModVeiculosServ.dataSet.Filter := '';
      vModVeiculosServ.dataSet.Filtered := false;
      vModVeiculosServ.IndexFieldNames := 'descricao';
      vDadosIni.fechaStatusProcessamento;
    end;
  end;
end;

