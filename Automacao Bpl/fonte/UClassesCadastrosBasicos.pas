    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    result := inherited post;

    if dataset.ChangeCount = 0 then
    begin
      result := true;
      exit;
    end;

    if result then
      result := apply;

    if result then
      CommitaTransacao
    else
    begin
      Cancel;
      RollBackTransacao;
      Result := false;
    end;
    Refresh;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

