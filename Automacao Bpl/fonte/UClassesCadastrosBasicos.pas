function TPerfil.post: boolean;
var
  acao: string;
begin
  result := false;
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS320', 'SALVAR', '', 'TAB_PERFIL',
      dataSet.FieldByName('CAMPO_PERFIL').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if dataset.FieldByName('DESCRICAO').AsString = '' then
      raise exception.Create('Campo descrição não foi informado.');

    if dataset.State = dsInsert then
      dataset.FieldByName('CAMPO_PERFIL').AsInteger := 0;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS320', acao, 'SUCESSO', 'TAB_PERFIL',
        dataSet.FieldByName('CAMPO_PERFIL').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS320', acao, 'FALHA', 'TAB_PERFIL',
        dataSet.FieldByName('CAMPO_PERFIL').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

