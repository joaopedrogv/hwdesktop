function TEmpresa.delete: boolean;
var
  codemp: string;
begin
  result := false;
  if dataSet.IsEmpty then
    exit;
  codemp := dataSet.FieldByName('COD_EMPRESA').AsString;
  try
    if dataSet.FieldByName('ATIVO').AsInteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
        'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = idyes then
      begin
        ExecutaComandosSqlExec('delete from codigo where cod_empresa= ' +
          dataset.FieldByName('COD_EMPRESA').AsString);
        DeletaMenus(dataset.FieldByName('COD_EMPRESA').AsInteger);
        DeletaSenha(dataset.FieldByName('COD_EMPRESA').AsInteger);
        DeletaTipoPreco(dataset.FieldByName('COD_EMPRESA').AsInteger);
        ExecutaComandosSqlExec('delete from TABELA_PROCESSOS where COD_EMPRESA = ' +
          dataset.FieldByName('COD_EMPRESA').AsString);
        //                vProcesso.deleteProcesso(dataset.FieldByName('COD_EMPRESA').AsInteger);
        result := inherited Delete;
        if Result then
          result := Apply;

        if Result then
          result := CommitaTransacao;

        if Result then
          vDadosIni.GravaAuditoria('BAS075', 'EXCLUIR', 'SUCESSO', 'EMPRESA', codemp, buscas)
        else
        begin
          RollBackTransacao;
          vDadosIni.GravaAuditoria('BAS075', 'EXCLUIR', 'FALHA', 'EMPRESA', codemp, buscas);
          result := false;
        end;
      end;
    end
    else if Application.MessageBox('Tem certeza que deseja mover este registro para a Lixeira?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      if Edit then
      begin
        dataSet.FieldByName('ATIVO').asinteger := 0;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria('BAS076', 'ENVIAR REGISTRO PARA A LIXEIRA', 'SUCESSO', 'EMPRESA',
            codemp, buscas)
        else
          vDadosIni.GravaAuditoria('BAS076', 'ENVIAR REGISTRO PARA A LIXEIRA ', 'FALHA', 'EMPRESA',
            codemp, buscas);
      end;
    end;
  finally
    Refresh;
  end;

end;

