  else
    mensagem := 'Item repetido.';
  if Application.MessageBox(PChar(mensagem + chr(13) +
    'Deseja alterar os dados deste item já existente?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION
    + MB_DEFBUTTON1) = mrYES then
  begin
    buscas.close;
