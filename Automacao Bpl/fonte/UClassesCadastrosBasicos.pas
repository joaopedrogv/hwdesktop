function TTipoVendas._receberCaixa(pTipo: string; pTipoOs: string; pSigla: string): string;
begin
	result := 'N';

  if (trim(pTipo) <> 'REQ') and (trim(pTipo) <> 'OS') and (trim(pTipo) <> 'VEI') then
    exit;

  result := 'S';

  {
  buscas.Close;
  buscas.SQL.Text := ' select coalesce(receber_financeiro, ''N'') receber_financeiro from tipo_vendas ' +
  	' where tipo = ' + QuotedStr(trim(pTipo));

  if trim(pTipo) = 'REQ' then
  	buscas.SQL.Text := buscas.SQL.Text + ' and sigla = ' + QuotedStr(trim(pSigla))
  else if trim(pTipo) = 'OS' then
  	buscas.SQL.Text := buscas.SQL.Text + ' and tipo_os = ' + QuotedStr(trim(pTipoOs));
  buscas.Open;

  if not buscas.IsEmpty then
    Result := trim(buscas.FieldByName('receber_financeiro').AsString);
  }
end;

function TTipoVendas._restauralixeira: boolean;
begin
  if not dataSet.IsEmpty then
    if dataSet.FieldByName('ATIVO').asinteger = 0 then
    begin
      if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
        'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
      begin
        if (Edit) or (dataSet.State = dsEdit) then
        begin
          dataSet.FieldByName('ATIVO').asinteger := 1;
          Result := Post;
          if Result then
            Result := CommitaTransacao;

          if Result then
            vDadosIni.GravaAuditoria('BAS251', 'RESTAURAR REGISTRO', 'SUCESSO',
              'TIPO_VENDAS', dataSet.FieldByName('COD_TIPO').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('BAS251', 'RESTAURAR REGISTRO', 'FALHA',
              'TIPO_VENDAS', dataSet.FieldByName('COD_TIPO').AsString, buscas);

        end;
      end;
    end
    else
      Application.MessageBox('Registro já está ativo' + #13 +
        'Não é necessário restaurá-lo', 'Informação', 0 + 64);
  Refresh;
end;

