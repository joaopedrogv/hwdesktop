function TRegrasVendas._listarTipoVndOS: boolean;
begin
	try
    result:=false;
    if IsEmpty then
      exit;
    if not vDadosIni.PesqPros('BAS507', 'EXIBIR', 'LISTAR TIPO VND/OS', 'REGRAVND_TIPO_VENDAS', '',Buscas, False) then
      Exit;

    FdtSetTipoVendaOS.Close;
    FdtSetTipoVendaOS.CommandText := ' select tp.tipo, ' +
    	' case when (tp.tipo = ''REQ'') then tp.sigla else tp.tipo_os end sigla, ' +
      ' tp.descricao, ' +
      ' (select distinct rtp.cod_regravnd ' +
      '  from regravnd_tipo_vendas rtp ' +
      '  inner join regras_vendas rv on ' +
      '     rtp.cod_regravnd = rv.cod_regravnd ' +
      '     and rtp.cod_empresa = rv.cod_empresa ' +
      ' where rtp.cod_regravnd = ' + IntToStr(dataSet.FieldByName('COD_REGRAVND').AsInteger) +
      ' and rtp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rtp.tipo = tp.tipo ' +
      ' and rtp.tipovnd_os = case when (tp.tipo = ''REQ'') then tp.sigla else tp.tipo_os end ' +
      ' ) as cod_regravnd  from tipo_vendas tp ' +
      ' where tp.ativo = 1 ' +
      ' and tp.tipo in (''REQ'', ''OS'') ' +
      ' order by 4 desc, 1 desc, 2 asc, 3 ';
    FdtSetTipoVendaOS.open;
    result:=true;
  except
    result:=false;
  end;
end;

function TRegrasVendas._ListaTipoVendas(pTipo: string;
  var pDBLookupComboBox: TDBLookupComboBox): boolean;
begin
  result:=false;
  try
    if dtSet = nil  then
    begin
      buscas.Close;
      buscas.SQL.Text:='select tipo_vendas.tipo,tipo_vendas.descricao, '+
        ' case when tipo_vendas.tipo=''OS'' then tipo_vendas.tipo_os '+
        ' when tipo_vendas.tipo=''REQ'' then tipo_vendas.sigla end as tipo_vnd_os from tipo_vendas '+
        ' where ((tipo_vendas.tipo=''OS'') or (tipo_vendas.tipo=''REQ'')) and tipo_vendas.ativo=1 '+
        ' order by tipo_vendas.tipo,tipo_vendas.ordemexibicao';
      buscas.Open;
      dtSource1 := TDataSource.Create(nil);
      dtSource2 := TDataSource.Create(nil);
      dtSet := TClientDataSet.Create(nil);
      dtSet.Close;
      dtSet.FieldDefs.Clear;
      dtSet.FieldDefs.Add('TIPO', ftString, 3, false);
      dtSet.FieldDefs.Add('DESCRICAO', ftString, 20, false);
      dtSet.FieldDefs.Add('TIPO_VND_OS', ftString, 10, false);
      dtSet.CreateDataSet;
      dtSet.LogChanges := False; //LogChanges = False, desabilita os logs de alteração e inserção dando performance na manipulação do ClientDataset
      buscas.First;
      while not buscas.Eof do
      begin
        dtSet.Append;
        dtSet.FieldByName('TIPO').AsString := buscas.FieldByName('TIPO').AsString;
        dtSet.FieldByName('DESCRICAO').AsString := buscas.FieldByName('DESCRICAO').AsString;
        dtSet.FieldByName('TIPO_VND_OS').AsString := buscas.FieldByName('TIPO_VND_OS').AsString;
        dtSet.Post;
        buscas.Next;
      end;
      dtSource1.DataSet := dtSet;
      pDBLookupComboBox.ListSource := dtSource1;
      pDBLookupComboBox.ListField := 'DESCRICAO';
      pDBLookupComboBox.KeyField := 'TIPO_VND_OS';
    end;
  finally
    if pos(pTipo, dtSet.Filter)= 0 then
    begin
      dtSet.Filter:= 'tipo = '+QuotedStr(pTipo);
      dtSet.Filtered := true;
      result := true;
    end;
    dtSource2.DataSet := dataSet;
    pDBLookupComboBox.DataSource := dtSource2;
    pDBLookupComboBox.DataField := 'TIPOVND_OS';
    pDBLookupComboBox.KeyValue := dataSet.FieldByName('TIPOVND_OS').AsVariant;
  end;

end;

function TRegrasVendas._lixeiraCheia: boolean;
begin
  Result := ExecutaComandosSql('Select first 1 COD_REGRAVND from REGRAS_VENDAS ' +
    ' where ativo = 0');
end;

function TRegrasVendas._restauraRegistro: boolean;
begin
   result:=false;
   if not vDadosIni.PesqPros('BAS345', '', '', 'REGRAS_VENDAS', '', buscas, false) then
     exit;
   if not dataSet.IsEmpty then
     if dataSet.FieldByName('ATIVO').asinteger = 0 then
     begin
       if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
         'Confirmação', MB_YESNO + MB_ICONQUESTION) = IDYES then
       begin
         if inherited Edit then
         begin
           dataSet.FieldByName('ATIVO').asinteger := 1;
           Result := inherited Post;
           if Result then
             Result := Apply
           else Cancel;  
           if Result then
             Result := CommitaTransacao
           else RollBackTransacao;
           if Result then
             vDadosIni.GravaAuditoria('BAS345', 'RESTAURAR REGISTRO', 'SUCESSO','REGRAS_VENDAS', dataSet.FieldByName('COD_REGRAVND').AsString, buscas)
           else
              vDadosIni.GravaAuditoria('BAS345', 'RESTAURAR REGISTRO', 'FALHA', 'REGRAS_VENDAS', dataSet.FieldByName('COD_REGRAVND').AsString, buscas);
         end;
       end;
     end
     else
       Application.MessageBox('Registro já está ativo.' +chr(13)+'Não é necessário restaurá-lo.', 'Informação', 0 + 64);
  if result then
    Refresh;
end;

function TRegrasVendas._validaCtrl: boolean;
begin
  try
    result:=true;
    if not ExecutaComandosSql('select ctrl.codigo_ctrl from controles ctrl where ctrl.codigo_ctrl= '+inttostr(dataSet.FieldByName('CODIGO_CTRL').AsInteger)+
      ' and ctrl.ativo=1 and ctrl.codigo_emp='+vDadosIni.codEmpresa) then
      raiseExceptionCreate('Informe um controle válido.', 'DBEdit6');
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TRegrasVendas._verificarVinculo(pTipo: Integer; pValor: string): boolean;
var
	buscasPolitica: TIBQuery;
	buscasTipo : TIBQuery;
  buscasTpVnd: TIBQuery;
  buscasCtrl : TIBQuery;
  buscasCond : TIBQuery;
  buscasTmp  : TIBQuery;

  vExisteTipo : boolean;
  vExisteTpVnd: boolean;
  vExisteCtrl : boolean;
  vExisteCond : boolean;

  vTipo : string;
  vTpVnd: string;
  vCtrl : string;
  vCond : string;
  vPolit: string;
begin
	// pTipo
  // 1 REQ/OS (Tipo Doc)
  // 2 V/A/D (Tipo de venda REQ)
  // 3 CLIENTE/EXTERNA (Tipo de Venda OS)
  // 4 Controle
  // 5 Cond Pag

  Result       := False;

  buscasPolitica := TIBQuery.Create(Application);
  buscasPolitica.Database := buscas.Database;
  buscasPolitica.Transaction := buscas.Transaction;

  buscasTipo := TIBQuery.Create(Application);
  buscasTipo.Database := buscas.Database;
  buscasTipo.Transaction := buscas.Transaction;

  buscasTpVnd := TIBQuery.Create(Application);
  buscasTpVnd.Database := buscas.Database;
  buscasTpVnd.Transaction := buscas.Transaction;

  buscasCond := TIBQuery.Create(Application);
  buscasCond.Database := buscas.Database;
  buscasCond.Transaction := buscas.Transaction;

  buscasCtrl := TIBQuery.Create(Application);
  buscasCtrl.Database := buscas.Database;
  buscasCtrl.Transaction := buscas.Transaction;

  buscasTmp := TIBQuery.Create(Application);
  buscasTmp.Database := buscas.Database;
  buscasTmp.Transaction := buscas.Transaction;

  buscasPolitica.Close;
  buscasPolitica.SQL.Text := ' select rv.cod_regravnd, rv.descricao from regras_vendas rv ' +
  	' where rv.cod_regravnd <> ' + IntToStr(dataSet.FieldByName('COD_REGRAVND').AsInteger) +
    ' and rv.cod_empresa = ' + vDadosIni.codEmpresa;
  buscasPolitica.Open;

  buscasPolitica.First;
  while not buscasPolitica.Eof do
  begin
  	vExisteTipo  := False;
    vExisteTpVnd := False;
    vExisteCtrl  := False;
    vExisteCond  := False;

    vPolit := IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) + ' - ' +
    	trim(buscasPolitica.FieldByName('DESCRICAO').AsString);

    if (pTipo = 1) then
    begin
      vTipo := pValor;

      buscasTipo.Close;
      buscasTipo.SQL.Text := ' select rt.cod_regravnd from regravnd_tipo rt ' +
        '  where rt.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
        '  and rt.cod_empresa = ' + vDadosIni.codEmpresa +
        '  and rt.tipo = ' + QuotedStr(trim(pValor));
      buscasTipo.Open;

      vExisteTipo := not buscasTipo.IsEmpty;
    end
    else if (pTipo = 2) or (pTipo = 3) then
    begin
      vTpVnd := pValor;

      buscasTpVnd.Close;
      buscasTpVnd.SQL.Text := ' select rtp.cod_regravnd from regravnd_tipo_vendas rtp ' +
        ' where rtp.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
        ' and rtp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and rtp.tipo = ' + QuotedStr(vDadosIni.IfThen(pTipo = 2, 'REQ', 'OS')) +
        ' and rtp.tipovnd_os = ' + QuotedStr(trim(pValor));
      buscasTpVnd.Open;

      vExisteTpVnd := not buscasTpVnd.IsEmpty;
    end
    else if (pTipo = 4) then
    begin
      vCtrl := pValor;

      buscasCtrl.Close;
      buscasCtrl.SQL.Text := ' select rctrl.cod_regravnd from regravnd_controle rctrl ' +
        '  where rctrl.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
        '  and rctrl.cod_empresa = ' + vDadosIni.codEmpresa +
        '  and rctrl.codigo_ctrl = ' + pValor;
      buscasCtrl.Open;

      vExisteCtrl := not buscasCtrl.IsEmpty;
    end
    else if (pTipo = 5) then
    begin
      vCond := pValor;

      buscasCond.Close;
      buscasCond.SQL.Text := ' select rc.cod_regravnd from regravnd_condpag rc ' +
        '  where rc.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
        '  and rc.cod_empresa = ' + vDadosIni.codEmpresa +
        '  and rc.cod_cond_pag = ' + pValor;
      buscasCond.Open;

      vExisteCond := not buscasCond.IsEmpty;
    end;

    if (pTipo <> 1) then
    begin
      try
        FdtSetTipo.DisableControls;
        FdtSetTipo.First;
        while not FdtSetTipo.Eof do
        begin
          if FdtSetTipo.FieldByName('COD_REGRAVND').AsInteger > 0 then
          begin
            buscasTipo.Close;
            buscasTipo.SQL.Text := ' select rt.cod_regravnd from regravnd_tipo rt ' +
              '  where rt.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
              '  and rt.cod_empresa = ' + vDadosIni.codEmpresa +
              '  and rt.tipo = ' + QuotedStr(trim(FdtSetTipo.FieldByName('TIPO').AsString));
            buscasTipo.Open;

            vExisteTipo := not buscasTipo.IsEmpty;

            if vExisteTipo then
            begin
              vTipo := trim(FdtSetTipo.FieldByName('TIPO').AsString);
              Break;
            end;
          end;

          FdtSetTipo.Next;
        end;
      finally
        FdtSetTipo.First;
        FdtSetTipo.EnableControls;
      end;
    end;

    if (pTipo <> 2) and (pTipo <> 3) then
    begin
      try
        FdtSetTipoVendaOS.DisableControls;
        FdtSetTipoVendaOS.First;
        while not FdtSetTipoVendaOS.Eof do
        begin
          if FdtSetTipoVendaOS.FieldByName('COD_REGRAVND').AsInteger > 0 then
          begin
            buscasTpVnd.Close;
            buscasTpVnd.SQL.Text := ' select rtp.cod_regravnd from regravnd_tipo_vendas rtp ' +
              ' where rtp.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
              ' and rtp.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and rtp.tipo = ' + QuotedStr(trim(FdtSetTipoVendaOS.FieldByName('TIPO').AsString)) +
              ' and rtp.tipovnd_os = ' + QuotedStr(trim(FdtSetTipoVendaOS.FieldByName('SIGLA').AsString));
            buscasTpVnd.Open;

            vExisteTpVnd := not buscasTpVnd.IsEmpty;

            if vExisteTpVnd then
            begin
              vTpVnd := trim(FdtSetTipoVendaOS.FieldByName('SIGLA').AsString);
              Break;
            end;
          end;

          FdtSetTipoVendaOS.Next;
        end;
      finally
        FdtSetTipoVendaOS.First;
        FdtSetTipoVendaOS.EnableControls;
      end;
    end;

    if (pTipo <> 4) then
    begin
      try
        FdtSetControle.DisableControls;
        FdtSetControle.First;
        while not FdtSetControle.Eof do
        begin
          if FdtSetControle.FieldByName('COD_REGRAVND').AsInteger > 0 then
          begin
            buscasCtrl.Close;
            buscasCtrl.SQL.Text := ' select rctrl.cod_regravnd from regravnd_controle rctrl ' +
              '  where rctrl.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
              '  and rctrl.cod_empresa = ' + vDadosIni.codEmpresa +
              '  and rctrl.codigo_ctrl = ' + IntToStr(FdtSetControle.FieldByName('CODIGO_CTRL').AsInteger);
            buscasCtrl.Open;

            vExisteCtrl := not buscasCtrl.IsEmpty;

            if vExisteCtrl then
            begin
              vCtrl := IntToStr(FdtSetControle.FieldByName('CODIGO_CTRL').AsInteger);
              Break;
            end;
          end;

          FdtSetControle.Next;
        end;
      finally
        FdtSetControle.First;
        FdtSetControle.EnableControls;
      end;
    end;

    if (pTipo <> 5) then
    begin
      try
        FdtSetCondPag.DisableControls;
        FdtSetCondPag.First;
        while not FdtSetCondPag.Eof do
        begin
          if FdtSetCondPag.FieldByName('COD_REGRAVND').AsInteger > 0 then
          begin
            buscasCond.Close;
            buscasCond.SQL.Text := ' select rc.cod_regravnd from regravnd_condpag rc ' +
              '  where rc.cod_regravnd = ' + IntToStr(buscasPolitica.FieldByName('COD_REGRAVND').AsInteger) +
              '  and rc.cod_empresa = ' + vDadosIni.codEmpresa +
              '  and rc.cod_cond_pag = ' + IntToStr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger);
            buscasCond.Open;

            vExisteCond := not buscasCond.IsEmpty;

            if vExisteCond then
            begin
              vCond := IntToStr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger);
              Break;
            end;
          end;

          FdtSetCondPag.Next;
        end;
      finally
        FdtSetCondPag.First;
        FdtSetCondPag.EnableControls;
      end;
    end;

    if (vExisteTipo) and (vExisteTpVnd) and (vExisteCtrl) and (vExisteCond) then
    begin
      SqlOpen(' select codigo_ctrl, nome_ctrl from controles ' +
        ' where codigo_ctrl = ' + vCtrl +
        ' and codigo_emp = ' + vDadosIni.codEmpresa, buscasTmp);

      vCtrl := IntToStr(buscasTmp.FieldByName('CODIGO_CTRL').AsInteger) + ' - ' +
        trim(buscasTmp.FieldByName('NOME_CTRL').AsString);

      SqlOpen(' select cod_cond_pag, desc_cond_pag from cond_pag ' +
        ' where cod_cond_pag = ' + vCond,  buscasTmp);

      vCond := IntToStr(buscasTmp.FieldByName('COD_COND_PAG').AsInteger) + ' - ' +
        trim(buscasTmp.FieldByName('DESC_COND_PAG').AsString);

      Application.MessageBox(PChar(
        'Tipo: ' + vTipo + #13 +
        'Tipo de venda: ' + vTpVnd + #13 +
        'Controle: ' + vCtrl + #13 +
        'Condição de pagamento: ' + vCond + #13 + #13 +
        'Já adiconados a política de pagamento: ' + #13 + vPolit), 'Atenção',
        MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);

      Result := False;
      Exit;
    end;

    buscasPolitica.Next;
  end;

  Result := True;
end;

function TRegrasVendas._vincular_congpag(pRetirarVinculo:boolean): boolean;
begin
  result:=false;
  if dataSet.IsEmpty then
    exit;

  if pRetirarVinculo then
  begin
  	if FdtSetCondPag.FieldByName('COD_REGRAVND').AsInteger > 0 then
    begin
      if ExecutaComandosSqlExec(' delete from REGRAVND_CONDPAG ' +
        ' where COD_REGRAVND = ' + inttostr(FdtSetCondPag.FieldByName('COD_REGRAVND').AsInteger) +
        ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' and COD_COND_PAG = ' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger)) then
          result:= CommitaTransacao
      else
        RollBackTransacao;
      if result then
        vDadosIni.GravaAuditoria('BAS350', 'DESVINCULAR', 'SUCESSO', 'REGRAVND_CONDPAG', inttostr(FdtSetCondPag.FieldByName('COD_REGRAVND').AsInteger) + '|' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger), buscas)
      else
        vDadosIni.GravaAuditoria('BAS350', 'DESVINCULAR', 'FALHA', 'REGRAVND_CONDPAG', inttostr(FdtSetCondPag.FieldByName('COD_REGRAVND').AsInteger) + '|' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger), buscas);
  	end
  end
  else
  begin
  	if not _verificarVinculo(5, IntToStr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger)) then
    	exit;
      
  	if ExecutaComandosSqlExec(' INSERT INTO REGRAVND_CONDPAG (COD_REGRAVND, COD_EMPRESA, COD_COND_PAG) '+
      ' VALUES (' + dataSet.FieldByName('COD_REGRAVND').AsString +
      ' ,' + vDadosIni.codEmpresa +
      ' ,' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger) +
      ')') then
        result := CommitaTransacao
    else
      RollBackTransacao;
    if result then
      vDadosIni.GravaAuditoria('BAS350', 'VINCULAR', 'SUCESSO', 'REGRAVND_CONDPAG', inttostr(dataSet.FieldByName('COD_REGRAVND').AsInteger) + '|' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger),buscas)
    else
      vDadosIni.GravaAuditoria('BAS350', 'VINCULAR', 'FALHA', 'REGRAVND_CONDPAG', inttostr(dataSet.FieldByName('COD_REGRAVND').AsInteger) + '|' + inttostr(FdtSetCondPag.FieldByName('COD_COND_PAG').AsInteger),buscas);
  end;
  _listarCondPag;
end;

