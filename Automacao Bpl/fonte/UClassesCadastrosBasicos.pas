{ TConciliacaoEstEmpAdq }

function TConciliacaoEstEmpAdq.consulta: boolean;
var
  I, erro: Integer;
  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  tempPosicao, tempPosicaoAnt: string;
  vCampoTemp, vCampoTempAd, vCondicaoTmp, vCondicaoTmpAd: string;
begin
  try
    vsqlAdicional := '';
    tempPosicao := '';
    tempPosicaoAnt := '';
    vCampoTemp:= '';
    vCampoTempAd := '';
    if UpperCase(trim(vCons.campo)) = 'TODOS' then
      vCons.porData := False;

    if (UpperCase(trim(vCons.ordem)) =  'ADQUIRENTE') then
      vCons.ordem := 'CONCILIACAO_ADQUIRENTE.NOME';
    if UpperCase(trim(vCons.campo)) = 'EMPRESA' then
  		vCampoTemp := 'EMPRESA.IDENTIFICACAO_EMP';

    if vCons.porData then
    begin
      try
        erro := 0;
        StrToDate(vCons.dataIni);
      except
        vCons.dataIni := '';
        erro := erro + 1;
      end;
      try
        StrToDate(vCons.dataFim);
      except
        vCons.dataFim := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data Inválida. Informe no mínimo uma data correta', 'Atenção',
          MB_OK + MB_ICONINFORMATION);
      end;
    end; //porData

    if Trim(vCampoTemp) <> '' then
    begin
      vCondicaoTmp := vCons.Condicao;
      if vCondicaoTmp = 'Igual' then
        vCondicaoTmp := '='
      else if vCondicaoTmp = 'Maior' then
        vCondicaoTmp := '>'
      else if vCondicaoTmp = 'Maior ou Igual' then
        vCondicaoTmp := '>='
      else if vCondicaoTmp = 'Menor' then
        vCondicaoTmp := '<'
      else if vCondicaoTmp = 'Menor ou Igual' then
        vCondicaoTmp := '<='
      else if vCondicaoTmp = 'Diferente' then
        vCondicaoTmp := '<>'
      else if (vCondicaoTmp = 'Esta contido') then
        vCondicaoTmp := 'like'
      else if (vCondicaoTmp = 'Começa') then
        vCondicaoTmp := 'Começa'
      else
        vCondicaoTmp := '=';
      if trim(vsqlAdicional) <> '' then
       vsqlAdicional := vsqlAdicional + ' and ';
      if vCondicaoTmp = 'like' then
      	vsqlAdicional := vsqlAdicional + ' ' + vCampoTemp + ' like ' + QuotedStr('%' + UpperCase(trim(vCons.valor)) + '%')
      else if vCondicaoTmp = 'Começa' then
      	vsqlAdicional := vsqlAdicional + ' ' + vCampoTemp + ' like ' + QuotedStr(UpperCase(trim(vCons.valor)) + '%')
      else
      	vsqlAdicional := vsqlAdicional + ' ' + vCampoTemp + ' ' + vCondicaoTmp + ' ' + QuotedStr(UpperCase(trim(vCons.valor)));

      vCons.valor := '';
      vCons.campo := '';
      vCons.ordem := vCampoTemp;
    end;

    if (UpperCase(trim(vCons.ordem)) =  'ADQUIRENTE')  then
      vCons.ordem := 'CONCILIACAO_ADQUIRENTE.NOME'
    else if (UpperCase(trim(vCons.ordem)) =  'EMPRESA') then
      vCons.ordem :=  'EMPRESA.IDENTIFICACAO_EMP';

    if vCons.porData then
      result := ConsultaCampos('CONCILIACAO_ESTAB_EMP', vCons.campo, vCons.ordem, vCons.dataIni,
        vCons.dataFim, '', 1,
        ' CONCILIACAO_ESTAB_EMP.*, CONCILIACAO_ADQUIRENTE.NOME, EMPRESA.IDENTIFICACAO_EMP	',
        ' LEFT JOIN CONCILIACAO_ADQUIRENTE ON CONCILIACAO_ADQUIRENTE.ID = CONCILIACAO_ESTAB_EMP.id_adquirente ' +
        ' LEFT JOIN EMPRESA ON EMPRESA.COD_EMPRESA = CONCILIACAO_ESTAB_EMP.COD_ESTAB ',
        vsqlAdicional)
    else
      result := ConsultaCampos('CONCILIACAO_ESTAB_EMP', vCons.valor, vCons.campo, vCons.condicao,
        vCons.ordem, False, '',
        ' CONCILIACAO_ESTAB_EMP.*, CONCILIACAO_ADQUIRENTE.NOME, EMPRESA.IDENTIFICACAO_EMP ',
        ' LEFT JOIN CONCILIACAO_ADQUIRENTE ON CONCILIACAO_ADQUIRENTE.ID = CONCILIACAO_ESTAB_EMP.id_adquirente ' +
        ' LEFT JOIN EMPRESA ON EMPRESA.COD_EMPRESA = CONCILIACAO_ESTAB_EMP.COD_ESTAB ',
        vsqlAdicional);
  finally
    vsqlTemp := dataSet.CommandText;
  end;
end;

