function TProdutosEC_CA.EnviarDadosComercioAberto(pRemover: boolean; pComGrade: boolean): boolean;
var
  acao: string;
  buscas2: TIBQuery;
begin
	buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  Result := false;

  acao := 'ENVIAR';
  if pRemover then acao := 'REMOVER';

	try
    prepare_loop('SEL = ''S''');
  	try
      if dataSet.IsEmpty then
      begin
        Application.MessageBox('Nenhum produto selecionado.', 'Atenção',
          MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if not vDadosIni.PesqPros('BAS430', 'ATUALIZAR', '', 'VW_PRODUTOS_EC', '', buscas, true) then
        Exit;

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Atualizar dados do Comércio Aberto (' +
          	IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if dataSet.FieldByName('tipo').AsInteger = 0 then
        begin
          SqlExec(' update produtos_ec set env_comercio_aberto = ' + QuotedStr(vDadosIni.IfThen(pRemover, 'N', 'S')) + 
              vDadosIni.IfThen(trim(dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString) = '',	', preco_a_combinar_ca = ' + QuotedStr('N'), '') +
              ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa);

        	if pComGrade then
          begin
            if dataSet.FieldByName('cod_grade').AsInteger > 0 then
            begin
              SqlExec(' update produtos_ec_grade set env_comercio_aberto = ' + QuotedStr(vDadosIni.IfThen(pRemover, 'N', 'S')) +
                ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
                ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
                ' and cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger) +
                ' and cod_empresa = ' + vDadosIni.codEmpresa);
            end;
          end
          else
          begin
             SqlOpen(' select grupo_prod, cod_prod, cod_grade, cod_empresa from cod_grade_prod ' +
              ' where cod_grade > 0 and grupo_prod = ' + IntToStr(dataset.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).FetchAll;

             buscas2.First;
             while not buscas2.Eof do
             begin
              	SqlExec(' update produtos_ec_grade set env_comercio_aberto = ' + QuotedStr(vDadosIni.IfThen(pRemover, 'N', 'S')) +
                 ' where grupo_prod = ' + IntToStr(buscas2.FieldByName('grupo_prod').AsInteger) +
                 ' and cod_prod = ' + QuotedStr(buscas2.FieldByName('cod_prod').AsString) +
                 ' and cod_grade = ' + IntToStr(buscas2.FieldByName('cod_grade').AsInteger) +
                 ' and cod_empresa = ' + vDadosIni.codEmpresa);

               buscas2.Next;
             end;
          end;
        end
        else
        begin
          SqlExec(' update tipo_servico set env_comercio_aberto = ' + QuotedStr(vDadosIni.IfThen(pRemover, 'N', 'S')) + 
              vDadosIni.IfThen(trim(dataSet.FieldByName('PRECO_A_COMBINAR_CA').AsString) = '',	', preco_a_combinar_ca = ' + QuotedStr('N'), '') +
              ' where cod_servico = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa);
        end;

        vDadosIni.GravaAuditoria('BAS430', acao, '', 'PRODUTOS_EC',
        	IntToStr(dataset.FieldByName('grupo_prod').AsInteger) + ' - ' +
          trim(dataSet.FieldByName('cod_prod').AsString), buscas);

        dataset.Next;
      end;

      if SqlOpen('select count(ec.grupo_prod) contador from vw_produtos_ec ec' +
                 ' where ec.env_comercio_aberto = ''S'' and ec.api = ''COMERCIOABERTO''' +
                 ' and ec.cod_empresa = %d and ec.ativo = 1', [vDadosIni.cod_empresa]).FieldByName('contador').AsInteger > LIMITE_COMERCIOABERTO then
      begin
        RollBackTransacao;

        ShowErro(LIMITE_COMERCIOABERTO_MENSAGEM);

        Exit;
      end;

      CommitaTransacao;

      vDadosIni.GravaAuditoria('BAS430', 'ATUALIZAR', 'SUCESSO', 'VW_PRODUTOS_EC', '', buscas);

      Result := true;

      {$REGION 'chamada da dll para enviar'}
      try
        vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Api');

        dataSet.First;
        while not dataSet.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Enviando dados para a Ap (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          if pComGrade then
          begin
            if dataSet.FieldByName('cod_grade').AsInteger > 0 then
              hw_comercio_produto_enviar(
                WideString(vDadosIni.vBancoHW),
                vDadosIni.cod_empresa,
                dataSet.FieldByName('grupo_prod').AsInteger,
                WideString(dataSet.FieldByName('cod_prod').AsString),
                dataSet.FieldByName('cod_grade').AsInteger)
            else
              hw_comercio_produto_enviar(
                WideString(vDadosIni.vBancoHW),
                vDadosIni.cod_empresa,
                dataSet.FieldByName('grupo_prod').AsInteger,
                WideString(dataSet.FieldByName('cod_prod').AsString),
                0);
          end
          else
          begin
            SqlOpen(' select grupo_prod, cod_prod, cod_grade, cod_empresa from cod_grade_prod ' +
              ' where cod_grade > 0 and grupo_prod = ' + IntToStr(dataset.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).FetchAll;

            if buscas2.IsEmpty then
              hw_comercio_produto_enviar(
              	WideString(vDadosIni.vBancoHW),
              	vDadosIni.cod_empresa,
                dataSet.FieldByName('grupo_prod').AsInteger,
                WideString(dataSet.FieldByName('cod_prod').AsString),
                0);

            buscas2.First;
            while not buscas2.Eof do
            begin
              hw_comercio_produto_enviar(
              	WideString(vDadosIni.vBancoHW),
                vDadosIni.cod_empresa,
                dataSet.FieldByName('grupo_prod').AsInteger,
                WideString(dataSet.FieldByName('cod_prod').AsString),
                buscas2.FieldByName('cod_grade').AsInteger);
              buscas2.Next;
            end;
          end;

          dataSet.Next;
        end;
        buscas.Close;

        hw_comercio_consulta_periodica(WideString(vDadosIni.vBancoHW), vDadosIni.cod_empresa);

      except on E: Exception do
        begin
          registraErro('TProdutosEC_CA.EnviarDadosComercioAberto %s', [e.Message]);
          ShowErro('Erro ao enviar dados para Api ' + sLineBreak + E.Message);
        end;
      end;
      {$ENDREGION}

    finally
      prepare_loop_done;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on E: Exception do
    begin
      result := False;
      vDadosIni.GravaAuditoria('BAS430', 'ATUALIZAR', 'ERRO', 'VW_PRODUTOS_EC', '', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TProdutosEC_CA.abrirComprasEVendasC. Erro: ' + e.Message);
    end;
  end;
end;

