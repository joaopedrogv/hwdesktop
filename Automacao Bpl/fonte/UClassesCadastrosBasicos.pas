    vDadosIni.abreStatusProcessamento('', 'Abrindo Estabelecimentos por Adquirente (Conciliação Cartão)');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS518', 'CONSULTA', '', 'CONCILIACAO_ESTAB_EMP', '',
      DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadEmpresaAdq = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadEmpresaAdq, frmCadEmpresaAdq);
    end;

    if (pTipoForm > 0) and (not frmCadEmpresaAdq.Visible) then
      frmCadEmpresaAdq.ShowModal
    else if (not frmCadEmpresaAdq.Visible) then
      frmCadEmpresaAdq.Show
    else if frmCadEmpresaAdq.FormStyle = fsMDIChild then
      frmCadEmpresaAdq.Show
    else
      frmCadEmpresaAdq.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

