function TCadPerfilHorasTrabalhoDia.abrePerfilHorasTrabalhoDia(pCodigo: Integer): boolean;
begin
	Result := montaSelect(' select * from perfil_horas_trabalho_dia ' +
  	' where codigo = ' + IntToStr(pCodigo) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa);
end;

function TCadPerfilHorasTrabalhoDia.abrePerfilHorasTrabalhoDia(
