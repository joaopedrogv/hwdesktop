function TMarcas.Delete: boolean;
var
  vtemp: string;
	vApagar: boolean;
  vCod_Marca: string;
  vDesc_Marca: string;
  I: Integer;
begin
  try
  	Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
      vCod_Marca  := trim(dataSet.FieldByName('COD_MARCA').AsString);
      vDesc_Marca := trim(dataSet.FieldByName('DESCRICAO_MARCA').AsString);

      prepare_loop('SEL = ''S''');

      if not dataset.IsEmpty then
      begin
        vApagar     := dataSet.FieldByName('ATIVO').AsInteger = 0;
        vCod_Marca  := '';
        vDesc_Marca := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(vCod_Marca) <> '') then
        prepare_loop('COD_MARCA = ' + vCod_Marca)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'MARCA' + #13 +
          'Código: ' + vCod_Marca + #13 +
          'Descrição: ' + vDesc_Marca;

        if (trim(vCod_Marca) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('BAS010', 'EXCLUIR', '', 'MARCA_PROD',
          vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a lixeira?' + #13 + #13 +
          'MARCA' + #13 +
          'Código: ' + vCod_Marca + #13 +
          'Descrição: ' + vDesc_Marca;

        if (trim(vCod_Marca) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('BAS014', 'EXCLUIR', '', 'MARCA_PROD',
           vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas, true) then
            exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> mrYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo marca(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo marca(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo marca(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo marca(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          buscas.Close;
          buscas.SQL.Text := ' select count(*) as qtde from produtos ' +
            ' where cod_marca = :cod_marca ';
          buscas.ParamByName('cod_marca').AsInteger := fint('cod_marca');
          buscas.Open;

          if buscas.FieldByName('qtde').AsInteger > 0 then
          begin
            Application.MessageBox('Não é possível excluir marca, pois existem produtos vinculados.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            exit;
          end;

          buscas.Close;
          buscas.SQL.Text := ' select count(*) as qtde from veiculos ' +
            ' where cod_marca = :cod_marca ';
          buscas.ParamByName('cod_marca').AsInteger := fint('cod_marca');
          buscas.Open;

          if buscas.FieldByName('qtde').AsInteger > 0 then
          begin
            Application.MessageBox('Não é possível excluir marca, pois existem veículos movimentados vinculados.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            exit;
          end;

          buscas.Close;
          buscas.SQL.Text := ' select count(*) as qtde from est_moto ' +
            ' where cod_marca = :cod_marca ';
          buscas.ParamByName('cod_marca').AsInteger := fint('cod_marca');
          buscas.Open;

          if buscas.FieldByName('qtde').AsInteger > 0 then
          begin
            Application.MessageBox('Não é possível excluir marca, pois existem veículos movimentados vinculados.', 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            exit;
          end;

          SqlExec(' delete from marca_prod ' +
            ' where cod_marca = %d ',
            [fint('cod_marca')], buscas);

          if (trim(vCod_Marca) = '') then
            vDadosIni.GravaAuditoria('BAS010', 'EXCLUIR', '', 'MARCA_PROD',
              dataSet.FieldByName('COD_MARCA').AsString, buscas);
        end
        else
        begin
          SqlExec(' update marca_prod set ativo = 0 ' +
            ' where cod_marca = %d ',
            [fint('cod_marca')], buscas);

          if (trim(vCod_Marca) = '') then
            vDadosIni.GravaAuditoria('BAS014', 'EXCLUIR', '', 'MARCA_PROD',
              dataSet.FieldByName('COD_MARCA').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

		Result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS010', 'BAS014'),
        'EXCLUIR', 'SUCESSO', 'MARCA_PROD',
        vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'BAS010', 'BAS014'),
        'EXCLUIR', 'FALHA', 'MARCA_PROD',
        vDadosIni.IfThen(trim(vCod_Marca) <> '', vCod_Marca, ''), buscas);
    end;
    if Result then
     Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

destructor TMarcas.destroy;
begin

  inherited;
end;

function TMarcas.Post: Boolean;
var
  acao: string;
begin
  try
    Result := false;
    acao := vDadosIni.IfThen(dataSet.State = dsInsert, 'INSERIR', 'EDITAR');

    if not vDadosIni.PesqPros('BAS013', acao, '',
      'MARCA_PROD', '', buscas) then
      exit;

    if not (dataSet.State in [dsEdit, dsInsert]) then
    begin
      Result := True;
      exit;
    end;

    checkFieldEmpty('DESCRICAO_MARCA', 'Descrição da marca não informada', 'DBLookupComboBox3');
    checkFieldEmpty('TIPO_MARCA', 'Tipo de marca não informada', 'DBLookupComboBox1');

    if (vDadosIni.vEcommerce.vHabilitarEcommerce) then
      checkFieldEmpty('DESCRICAO_EC', 'Descrição da marca (E-Commerce) não informada', 'DBEdit4');

    if dataSet.State = dsInsert then
    begin
      buscas.close;
      buscas.SQL.Text := 'select cod_marca from MARCA_PROD ' +
        ' where cod_marca = ' + IntToStr(dataSet.FieldByName('COD_MARCA').AsInteger) +
        ' and cod_marca <> ' + IntToStr(fCodMarca);
      buscas.Open;

      if buscas.FieldByName('COD_MARCA').AsInteger > 0 then
        raiseExceptionCreate('Codigo da marca ja existe no banco de dados', 'DBEdit1');
    end;

    if dataSet.State = dsInsert then
    begin
      if dataSet.FieldByName('COD_MARCA').AsInteger = 0 then
      begin
        buscas.close;
        buscas.SQL.Text := 'select GEN_ID(INC_COD_MARCA,1) from rdb$database';
        buscas.Open;
        dataSet.FieldByName('COD_MARCA').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      end;
      if Pos('CADMARCA|0|', vDadosIni.vPesquisa) > 0 then
        vDadosIni.vPesquisa := 'CADMARCA|' + dataSet.FieldByName('COD_MARCA').AsString + '|' + dataSet.FieldByName('DESCRICAO_MARCA').AsString + '|'
      else
        vDadosIni.vPesquisa := dataSet.FieldByName('COD_MARCA').AsString;
    end;

    dataSet.FieldByName('DESCRICAO_MARCA').AsString := trim(dataSet.FieldByName('DESCRICAO_MARCA').AsString);
    if (vDadosIni.vEcommerce.vHabilitarEcommerce) then
    	dataSet.FieldByName('DESCRICAO_EC').AsString := trim(dataSet.FieldByName('DESCRICAO_EC').AsString);

    dataSet.Post;

    if (dataSet.ChangeCount = 0) then
    begin
      Result := True;
      exit;
    end;

    Result := Apply;

    if not Result then
      Exit;

    CommitaTransacao;

    vDadosIni.GravaAuditoria('BAS013', acao, 'SUCESSO', 'MARCA_PROD', '', buscas);

    Refresh;
  except
    on E: Exception do
    begin
      Result := false;
      RollBackTransacao;
      Application.MessageBox(pchar('Erro ao salvar registro. Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('TMarcas.Post Erro: ' + e.Message);
    end;
  end;
end;

