    ' left join colaborador on colaborador.cod_vendedor = sugestaoservico.ult_atd and colaborador.cod_empresa = sugestaoservico.cod_empresa ' +
		' where sugestaoservico.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and sugestaoservico.data <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDataBanco + vDadosIni.vSugServico.vDiasAntec)) +
    ' and (trim(coalesce(sugestaoservico.status, '''')) = '''') and sugestaoservico.ativo = 1 ');
  ultimasql := dataSet.CommandText;
end;

function TSugestaoServico.AbrirAgendaOficina(codAgenda: Integer; pDesmarca: boolean): boolean;
 var
  formulario: TForm;
  hdTemp: THandle;
  vProcesso: string;
  vDescricao: string;
begin
  if pDesmarca then
  begin
  	vProcesso := 'BAS387';
    vDescricao := 'EXCLUIR AGENDAMENTO';
    vDadosIni.vPesquisa := 'DESMARCARAGENDA| ' + IntToStr(codAgenda) + '|';
  end
	else if (codAgenda = 0) then
  begin
    vProcesso := 'BAS385';
    vDescricao := 'INCLUIR AGENDAMENTO';
  	if (vDadosIni.vEmp.vUsarAparelho = 'S') then
      vDadosIni.vPesquisa := 'MARCARAGENDA| ' +  IntToStr(dataSet.FieldByName('COD_EQUIP').AsInteger) + '|'
    else
		  vDadosIni.vPesquisa := 'MARCARAGENDA| ' +  IntToStr(dataSet.FieldByName('COD_VEIC').AsInteger) + '|' +
      dataSet.FieldByName('CHASSI').AsString + '|' + dataSet.FieldByName('PLACA').AsString + '|';
    vDadosIni.abreStatusProcessamento('', 'Abrindo Agenda Oficina');
  end
  else if (codAgenda > 0) then
  begin
    vProcesso := 'BAS386';
    vDescricao := 'EDITAR AGENDAMENTO';
  	vDadosIni.vPesquisa := 'EDITARAGENDA| ' + IntToStr(codAgenda) + '|';
    vDadosIni.abreStatusProcessamento('', 'Abrindo Agenda Oficina');
  end;

  if not vDadosIni.PesqPros(vProcesso, vDescricao, '', 'SUGESTAOSERVICO', '', buscas, false) then
  	exit;

  if vDescricao = 'INCLUIR AGENDAMENTO' then
    if not abreFormServicoSug(false) then
    begin
      Result := False;
      vDadosIni.fechaStatusProcessamento;
      Application.MessageBox('Nenhum serviço selecionado.', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

  formulario := Funcoes.AbreForm('pkPedidoVenda', 'TfrmCadAgenda', hdTemp);

  try
    formulario.ShowModal;
  finally
    formulario.Free;
    unLoadPackage(hdTemp);
    try
      if (StrToIntDef(vDadosIni.vPesquisaCodAgenda, 0) > 0) or (pDesmarca) then
      begin
        if vSugestaoServicoItens.abreSugServItens(dataSet) then
        begin
          vSugestaoServicoItens.dataSet.First;
          while not vSugestaoServicoItens.dataSet.Eof do
          begin
            if vSugestaoServicoItens.dataSet.FieldByName('SEL').AsString = 'S' then
            begin
              vSugestaoServicoItens.dataSet.Edit;
              if (pDesmarca) then
              begin
                vSugestaoServicoItens.dataSet.FieldByName('COD_AGENDA').Value := Null;
                vSugestaoServicoItens.dataSet.FieldByName('DATA').AsDateTime := vSugestaoServicoItens.dataSet.FieldByName('DATA_CAD').AsDateTime;
              end
              else
              begin
                vSugestaoServicoItens.dataSet.FieldByName('COD_AGENDA').AsInteger := StrToInt(vDadosIni.vPesquisaCodAgenda);
                vSugestaoServicoItens.dataSet.FieldByName('DATA').AsDateTime := StrToDateTime(vDadosIni.vPesquisaDataAgenda) + 1;
              end;
              vSugestaoServicoItens.dataSet.Post;

              vDadosIni.GravaAuditoria(vProcesso, vDescricao,
              'CLIENTE ' + vSugestaoServicoItens.dataSet.FieldByName('COD_CLIENTE').AsString,
              vSugestaoServicoItens.dataSet.FieldByName('COD_SUG').AsString, '', buscas);
            end;

            vSugestaoServicoItens.dataSet.Next;
          end;
          if (vSugestaoServicoItens.dataSet.ChangeCount = 0) then
            Result := True
          else
            Result := vSugestaoServicoItens.Apply;
          if result then
            result := CommitaTransacao;

          if Result then
            vDadosIni.GravaAuditoria(vProcesso, vDescricao, 'SUCESSO', 'SUGESTAOSERVICO', '', buscas)
          else
            vDadosIni.GravaAuditoria(vProcesso, vDescricao, 'FALHA', 'SUGESTAOSERVICO', '', buscas);
          end;
      end;
    finally
       vDadosIni.vPesquisaCodAgenda := '';
       vDadosIni.vPesquisaDataAgenda := '';
    end;
  end;

end;

function TSugestaoServico.AdiarSugestaoServico: boolean;
var
	vData: string;
begin
	Result := true;

  if dataSet.IsEmpty then
  	exit;

  if not vSugestaoServicoItens.abreSugServItens(dataSet) then
  	exit;

  if not vDadosIni.PesqPros('BAS388', 'ADIAR', '', 'SUGESTAOSERVICO', '', buscas, false) then
  	exit;

  if not InputQuery('Informe a próxima data', 'Exemplo: ' + FormatDateTime('DD/MM/YYYY', dataSet.FieldByName('DATA').AsDateTime), vData) then
  begin
    Result := False;
  	exit;
  end;

  if dataSet.FieldByName('DATA').AsDateTime > StrToDateTime(vData) then
  begin
  	Result := False;
    Application.MessageBox(PChar('Data informada menor que a data atual.' + #13 + #13 +
    	'Data informada: ' + FormatDateTime('dd/mm/yyyy', StrToDateTime(vData)) + #13 +
      'Data atual......: ' +  FormatDateTime('dd/mm/yyyy', dataSet.FieldByName('DATA').AsDateTime)),
      'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    exit;
  end;

  if not abreFormServicoSug(false) then
  begin
    Result := False;
    Application.MessageBox('Nenhum serviço selecionado.', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    exit;
  end;

  vSugestaoServicoItens.dataSet.First;
  while not vSugestaoServicoItens.dataSet.Eof do
  begin
    if vSugestaoServicoItens.dataSet.FieldByName('SEL').AsString = 'S' then
    begin
      vSugestaoServicoItens.dataSet.Edit;
      vSugestaoServicoItens.dataSet.FieldByName('DATA').AsDateTime := StrToDateTime(vData);
      vSugestaoServicoItens.dataSet.Post;

      vDadosIni.GravaAuditoria('BAS388', 'ADIAR',
        'CLIENTE ' + vSugestaoServicoItens.dataSet.FieldByName('COD_CLIENTE').AsString,
        vSugestaoServicoItens.dataSet.FieldByName('COD_SUG').AsString, '', buscas);
    end;

  	vSugestaoServicoItens.dataSet.Next;
  end;
  vSugestaoServicoItens.dataSet.First;

  result := vSugestaoServicoItens.Apply;
  if result then
    result := vSugestaoServicoItens.CommitaTransacao;

  if Result then
    vDadosIni.GravaAuditoria('BAS388', 'ADIAR', 'SUCESSO', 'SUGESTAOSERVICO', '', buscas)
  else
    vDadosIni.GravaAuditoria('BAS388', 'ADIAR', 'FALHA', 'SUGESTAOSERVICO', '', buscas);
end;

function TSugestaoServico.AlterarStatusSugestaoServico(pTipo: string; pComitar: boolean): boolean;
var
	vProcesso, vDescricao, vMensagem: string;
	vCodSugAvulsa: integer;
  vOK: boolean;
  vTemp: string;
begin
	Result := true;

  if dataSet.IsEmpty then
  	exit;

  if not vSugestaoServicoItens.abreSugServItens(dataSet) then
  	exit;

  if (pTipo = 'FINALIZAR') then
  begin
    if dataSet.FieldByName('STATUS').AsString = 'FINALIZADA' then
    begin
      Application.MessageBox('Sugestão de serviço se encontra "FINALIZADA".', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    	Result := False;
      exit;
    end;
    vProcesso := 'BAS389';
    vDescricao := 'FINALIZAR';
    vMensagem := 'finalizar';
  end
  else if (pTipo = 'CANCELAR') then
  begin
    if dataSet.FieldByName('STATUS').AsString = 'CANCELADA' then
    begin
      Application.MessageBox('Sugestão de serviço se encontra "CANCELADA".', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    	Result := False;
      exit;
    end;
    vProcesso := 'BAS390';
    vDescricao := 'CANCELAR';
    vMensagem := 'cancelar';
  end
  else
  begin
    if dataSet.FieldByName('STATUS').AsString = '' then
    begin
      Application.MessageBox('Sugestão de serviço se encontra "ABERTA".', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      Result := False;
      exit;
    end;
	  vProcesso := 'BAS391';
    vDescricao := 'REABRIR';
    vMensagem := 'reabrir';
  end;

  if Application.MessageBox(PChar('Deseja ' + vMensagem + ' sugestão de serviço?'),
    'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
  begin
    Result := False;
  	exit;
  end;

  if (pTipo = 'CANCELAR')  then 
    if Application.MessageBox('Sugestão de serviço não será reagendada. Deseja continuar mesmo assim?',
     'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> IDYES then
      begin
    		Result := False;
  			exit;
  		end;

  if (vDadosIni.vEmp.vUsarAparelho = 'S') then
  	vTemp := 'CodEquip ' + IntToStr(dataSet.FieldByName('COD_EQUIP').AsInteger)
  else
  	vTemp := 'CodVeic ' + IntToStr(dataSet.FieldByName('COD_VEIC').AsInteger) +
    	' Placa ' + dataSet.FieldByName('PLACA').AsString +
      ' Chassi ' +  dataSet.FieldByName('CHASSI').AsString;

  if not vDadosIni.PesqPros(vProcesso, vDescricao, vTemp, 'SUGESTAOSERVICO', '', buscas, false) then
  	exit;

  if not abreFormServicoSug(false) then
  begin
    Result := False;
    Application.MessageBox('Nenhum serviço selecionado.', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    exit;
  end;


	try
    vSugestaoServicoItens.dataSet.Filter := 'SEL = ''S''';
    vSugestaoServicoItens.dataSet.Filtered := True;
    vSugestaoServicoItens.First;

    if vSugestaoServicoItens.dataSet.IsEmpty then
    begin
      Result := False;
      Application.MessageBox('Nenhum serviço selecionado.', 'Atenção', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    if (pTipo = 'FINALIZAR') then
	    vCodSugAvulsa := Gencodigo('SUG_AVULSA', DtmCadBasicos.SpIncCodigo, vDadosIni.codEmpresa);
    vSugestaoServicoItens.First;
    while not vSugestaoServicoItens.Eof do
    begin
      vSugestaoServicoItens.Edit;
      if (pTipo = 'FINALIZAR') then
      begin
        vSugestaoServicoItens.dataSet.FieldByName('STATUS').AsString := 'FINALIZADA';
        vSugestaoServicoItens.dataSet.FieldByName('NDOC').AsInteger := vCodSugAvulsa;
        vSugestaoServicoItens.dataSet.FieldByName('TPDOC').AsString := 'AVS';
      end
      else if (pTipo = 'CANCELAR') then
        vSugestaoServicoItens.dataSet.FieldByName('STATUS').AsString := 'CANCELADA'
      else
        vSugestaoServicoItens.dataSet.FieldByName('STATUS').Value := Null;
      vSugestaoServicoItens.Post;

      vDadosIni.GravaAuditoria(vProcesso, vDescricao,
        'CLIENTE ' + vSugestaoServicoItens.dataSet.FieldByName('COD_CLIENTE').AsString,
       vSugestaoServicoItens.dataSet.FieldByName('COD_SUG').AsString, '', buscas);

      vSugestaoServicoItens.Next;
    end;
  finally
    vSugestaoServicoItens.dataSet.Filtered := false;
  end;
  
  vSugestaoServicoItens.First;

  result := vSugestaoServicoItens.Apply;

  if pComitar then
  begin
    if result then
      result := vSugestaoServicoItens.CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria(vProcesso, vDescricao, 'SUCESSO', 'SUGESTAOSERVICO', '', buscas)
    else
      vDadosIni.GravaAuditoria(vProcesso, vDescricao, 'FALHA', 'SUGESTAOSERVICO', '', buscas);
  end;
end;

function TSugestaoServico.ReabrirCancelarSugestao(pTipo: string;
  pNumDoc: Integer): boolean;
begin
  Result := true;

  try
    buscas.Close;
    buscas.SQL.Text := ' delete from sug_os ' +
      ' where ndoc = :ndoc and tpdoc = :tpdoc and cod_empresa = :cod_empresa; ';
    buscas.ParamByName('NDOC').AsInteger := pNumDoc;
    buscas.ParamByName('TPDOC').AsString := pTipo;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := ' update sugestaoservico set status = null, ndoc = null, tpdoc  = null ' +
      ' where ndoc = :ndoc and tpdoc = :tpdoc and cod_empresa = :cod_empresa; ';
    buscas.ParamByName('NDOC').AsInteger := pNumDoc;
    buscas.ParamByName('TPDOC').AsString := pTipo;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;
  except
    on E: Exception do
    begin
      result := False;
      RollBackTransacao;
      Application.MessageBox(pchar('Erro ao reabrir/cancelar. Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TSugestaoServico.CancelarSugestao. Erro: ' + e.Message);
    end;
  end;
end;

constructor TSugestaoServico.create;
begin
 if DtmCadBasicos = nil then
    DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
  dataSet := TClientDataSet(DtmCadBasicos.cdsSugestaoServ);
  transacao := TIBTransaction(DtmCadBasicos.IBTransCadastroBasico);
  buscas := TIBQuery(DtmCadBasicos.qrBuscas);

  vSugestaoServicoItens := TSugestaoServicoItens.create;
  vOcorrenciaSugestaoServico := TOcorrenciaSugestaoServico.create;
  vOrdemServicoSugestaoServico := TOrdemServicoSugestaoServico.create;
  
  if vDadosIni.vEmp.vUsarAparelho = 'S' then
  begin
  	dataSet.FieldByName('CHASSI').Tag := 1;
    dataSet.FieldByName('PLACA').Tag := 1;
    dataSet.FieldByName('COD_VEIC').Tag := 1;
    dataSet.FieldByName('ANOFAB').Tag := 1;
    dataSet.FieldByName('ANOMOD').Tag := 1;

    dataSet.FieldByName('COD_EQUIP').Tag := 0;
  end
  else
  begin
  	dataSet.FieldByName('COD_EQUIP').Tag := 1;

    dataSet.FieldByName('CHASSI').Tag := 0;
    dataSet.FieldByName('PLACA').Tag := 0;
    dataSet.FieldByName('COD_VEIC').Tag := 0;
    dataSet.FieldByName('ANOFAB').Tag := 0;
    dataSet.FieldByName('ANOMOD').Tag := 0;
  end;
end;

destructor TSugestaoServico.destroy;
begin
  vSugestaoServicoItens.Free;
  vSugestaoServicoItens := nil;

  vOcorrenciaSugestaoServico.Free;
  vOcorrenciaSugestaoServico := nil;

  vOrdemServicoSugestaoServico.Free;
  vOrdemServicoSugestaoServico := nil;

  inherited;
end;

