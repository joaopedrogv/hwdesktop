constructor TOLAP_ConsultasUsuario.create(AOwer: TSenha);
begin
  if not Assigned(AOwer) then
    raise Exception.Create('Ower não definido');

  FOwer := AOwer;
  
  FConsultasDB := TOLAP_GruposList.Create;
  FConsultasUS := TOLAP_GruposList.Create;
end;

procedure TOLAP_ConsultasUsuario.Delete(AIndexGrupo, AIndexConsulta: Integer);
var
  I: Integer;
  ANewGrupo: Boolean;
  J: Integer;
begin
  if AIndexGrupo <= -1 then
    Exit;
  if AIndexGrupo > FConsultasUS.Count - 1 then
    Exit;

  if AIndexConsulta <= -1 then
    Exit;
  if AIndexConsulta > FConsultasUS.Items[AIndexGrupo].Consultas.Count - 1 then
    Exit;


  if not FOwer.SqlOpen('select cod_consulta from user_consultasdiv' +
                  ' where cod_consulta = ' + IntToStr(FConsultasUS.Items[AIndexGrupo].Consultas.Items[AIndexConsulta].cod_consulta) +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa +
                  ' and usuario = ' + QuotedStr(FOwer.dataSet.FieldByName('usuario').AsString)).IsEmpty then
  begin
    DeleteDB(FConsultasUS.Items[AIndexGrupo].Consultas.Items[AIndexConsulta]);
    SetConsultasUS;
    if Assigned(FOnChangeOLAPUS) then
      FOnChangeOLAPUS(FConsultasUS);
  end;
  Exit;

  FConsultasUS.Items[AIndexGrupo].Consultas.Delete(AIndexConsulta);
  if FConsultasUS.Items[AIndexGrupo].Consultas.Count = 0 then
    FConsultasUS.Delete(AIndexGrupo);
  
  if Assigned(FOnChangeOLAPUS) then
    FOnChangeOLAPUS(FConsultasUS);
end;

procedure TOLAP_ConsultasUsuario.DeleteDB(AConsulta: TOLAP_Consultas);
begin
  vDadosIni.GravaAuditoria('GES042', 'EXCLUIR', 'CONSULTA OLAP ' + IntToStr(AConsulta.cod_consulta) + ' - ' +
    AConsulta.nome, 'USER_CONSULTASDIV', FOwer.dataSet.FieldByName('usuario').AsString, FOwer.buscas);

  FOwer.SqlExec('DELETE FROM USER_CONSULTASDIV' +
                ' WHERE COD_CONSULTA = ' + IntToStr(AConsulta.cod_consulta) +
                ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
                ' AND USUARIO = ' + QuotedStr(FOwer.dataSet.FieldByName('usuario').AsString));
  if FOwer.buscas.Transaction.InTransaction then
    FOwer.buscas.Transaction.Commit;

  vDadosIni.GravaAuditoria('GES042', 'EXCLUIR', 'SUCESSO - CONSULTA OLAP ' + IntToStr(AConsulta.cod_consulta) + ' - ' +
    AConsulta.nome, 'USER_CONSULTASDIV', FOwer.dataSet.FieldByName('usuario').AsString, FOwer.buscas);
end;

