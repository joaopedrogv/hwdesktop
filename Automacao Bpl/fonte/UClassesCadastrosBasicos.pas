	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Regras para Travar REQ/OS/EST FECH em aberto');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS476', 'CONSULTA', '', 'REGRAS_TRAVOSREQ', '',
