    if (dataSet.IsEmpty) then
    begin
      Application.MessageBox('Nenhuma empresa selecionada.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    if not vDadosIni.PesqPros('BAS302', 'DESABILITAR', '', 'EMPRESA',
      vDadosIni.vDtSetTmp.FieldByName('COD_EMPRESA').AsString, buscas, true) then
      Exit;

    vCodEmpresa := vDadosIni.vDtSetTmp.FieldByName('COD_EMPRESA').AsInteger;

