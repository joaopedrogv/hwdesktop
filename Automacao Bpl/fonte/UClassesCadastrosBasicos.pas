function TRegrasSugServ.Delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('CODIGO').AsString;

  if dataSet.FieldByName('ATIVO').AsInteger = 1 then
