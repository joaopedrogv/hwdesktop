procedure TRegrasSugServ._cadRegrasSugServ(pTipoForm: Integer);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro de Regras de Sugestão Serviço');
    if DtmCadBasicos = nil then
      DtmCadBasicos := TDtmCadBasicos.Create(DtmCadBasicos);
    vDadosIni.vTipoForm := pTipoForm;
    if not vDadosIni.PesqPros('BAS363', 'ABRIR', '', 'REGRAS_SUG', '',DtmCadBasicos.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;
    if frmCadRegrasSugestao = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TfrmCadRegrasSugestao, frmCadRegrasSugestao);
    end;

    if (pTipoForm > 0) and (not frmCadRegrasSugestao.Visible) then
      frmCadRegrasSugestao.ShowModal
    else if (not frmCadRegrasSugestao.Visible) then
      frmCadRegrasSugestao.Show
    else if frmCadRegrasSugestao.FormStyle = fsMDIChild then
      frmCadRegrasSugestao.Show
    else
      frmCadRegrasSugestao.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

