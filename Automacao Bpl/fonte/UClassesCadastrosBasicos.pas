function TConciliacaoEstEmpAdq.Delete: boolean;
var
  vCodFormula: string;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    vCodFormula :=
      dataSet.FieldByName('ID_ADQUIRENTE').AsString + '-' +
      dataSet.FieldByName('COD_ESTAB').AsString + '-' +
      dataSet.FieldByName('CODIGO').AsString;

    if not vDadosIni.PesqPros('BAS522', 'SALVAR', '', 'CONCILIACAO_ESTAB_EMP',
      vCodFormula, buscas, true) then
      Exit;

    if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'delete from conciliacao_estab_emp ' +
    	' where id_adquirente = ' + IntToStr(dataSet.FieldByName('ID_ADQUIRENTE').AsInteger) +
      ' and cod_estab = ' + IntToStr(dataSet.FieldByName('COD_ESTAB').AsInteger) +
      ' and codigo = ' + QuotedStr(dataSet.FieldByName('CODIGO').AsString);

    try
      buscas.ExecSQL;

      CommitaTransacao;
      vDadosIni.GravaAuditoria('BAS522', 'EXCLUIR', 'SUCESSO', 'CONCILIACAO_ESTAB_EMP', vCodFormula,
        buscas);
    except
      RollBackTransacao;
      vDadosIni.GravaAuditoria('BAS522', 'EXCLUIR', 'FALHA', 'CONCILIACAO_ESTAB_EMP', vCodFormula, buscas);
    end;
    result := true;
    Refresh;
  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('BAS522', 'EXCLUIR', 'FALHA', 'CONCILIACAO_ESTAB_EMP',
      	vDadosIni.IfThen(trim(vCodFormula) <> '', trim(vCodFormula), ''), buscas);
      Application.MessageBox(pchar('Erro ao excluir contrato. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

