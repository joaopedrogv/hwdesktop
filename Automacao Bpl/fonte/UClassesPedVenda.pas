function TPedVendaServ.insert: boolean;
var
 vCodTecMec:integer;
 vCodVendedor:integer;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    if not post then
      exit;
  end;
  FOwner.calculaDescontoAcrescimo;
  dataSet.Last;
  vCodTecMec := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
  vCodVendedor := dataSet.FieldByName('COD_VENDEDOR1').AsInteger;
  if inherited insert then
  begin
    Result := true;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('tipo').AsString := FOwner.dataSet.FieldByName('tipo').AsString;
    dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;
    dataSet.FieldByName('SUBGSERVICO').AsInteger :=
      vSubG.dataSet.FieldByName('CODIGO_SUBGR').AsInteger;
    dataSet.FieldByName('nitem').AsInteger := nItem + 1;
    if vDadosIni.vMecOs = 'S' then
    begin
      dataSet.FieldByName('cod_vendedor').AsInteger :=
        FOwner.dataSet.FieldByName('cod_vendedor').AsInteger;
      dataSet.FieldByName('cod_vendedor1').AsInteger :=
        FOwner.dataSet.FieldByName('cod_vendedor').AsInteger;
    end
    else
    begin
      dataSet.FieldByName('cod_vendedor').AsInteger :=
        vCodTecMec;
      dataSet.FieldByName('cod_vendedor1').AsInteger :=
        vCodVendedor;
    end;
  end;
end;

procedure TPedVendaServ.pedVendaServBeforePost(DataSet: TDataSet);
begin
  dataSet.FieldByName('VALOR_UN_SERV').AsString :=
    StringReplace(Trim(format('%14.' + vSing.vCasasDecimais + 'n',
    [dataSet.FieldByName('VALOR_UN_SERV').AsFloat])), '.', '', [rfReplaceAll]);
  if not vDadosIni.vPedVnd.permitirQtdeServFracionado then
	  dataSet.FieldByName('QUANT_SERV_PED').AsFloat :=  Trunc(dataSet.FieldByName('QUANT_SERV_PED').AsFloat);
  dataSet.FieldByName('VALOR_TOT_SERV').AsFloat :=
    (dataSet.FieldByName('QUANT_SERV_PED').AsFloat *
    dataSet.FieldByName('VALOR_UN_SERV').AsFloat);
  dataSet.FieldByName('VALOR_TOT_SERV').AsString :=
    StringReplace(trim(Format('%14.2n',
    [dataSet.FieldByName('VALOR_TOT_SERV').AsFloat])), '.', '', [rfReplaceAll]);
	if Trim(dataSet.FieldByName('md5').AsString) = '' then
		dataSet.FieldByName('md5').AsString := 'SISTEMA' + IntToStr(dataSet.FieldByName('NPED').AsInteger);

	if dtSet.Locate('NITEM', dataSet.FieldByName('NITEM').AsInteger, []) then
  begin
    dtSet.Edit;
    dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
    dtSet.FieldByName('COD_SERVICO').AsInteger := DataSet.FieldByName('COD_SERVICO').AsInteger;
    dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
    dtSet.FieldByName('QUANT_SERV_PED').AsFloat := DataSet.FieldByName('QUANT_SERV_PED').AsFloat;
    dtSet.FieldByName('CODIGO_NOP').AsFloat := DataSet.FieldByName('CODIGO_NOP').AsFloat;
    dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
    dtSet.FieldByName('STATUS').AsString := DataSet.FieldByName('STATUS').AsString;
    dtSet.FieldByName('VALOR_UN_SERV').AsFloat := DataSet.FieldByName('VALOR_UN_SERV').AsFloat;
    dtSet.FieldByName('VALOR_TOT_SERV').AsFloat := DataSet.FieldByName('VALOR_TOT_SERV').AsFloat;
    dtSet.FieldByName('RATEIO_ACRESC').AsCurrency := dataSet.FieldByName('RATEIO_ACRESC').AsCurrency;
    dtSet.FieldByName('ACRESC_ITEM').AsCurrency := dataSet.FieldByName('ACRESC_ITEM').AsCurrency;
    dtSet.FieldByName('RATEIO_DESC').AsCurrency := dataSet.FieldByName('RATEIO_DESC').AsCurrency;
    dtSet.FieldByName('DESC_ITEM').AsCurrency := dataSet.FieldByName('DESC_ITEM').AsCurrency;
    dtSet.Post;
  end
  else
  begin
    dtSet.Insert;
    dtSet.FieldByName('NITEM').AsInteger := DataSet.FieldByName('NITEM').AsInteger;
    dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
    dtSet.FieldByName('COD_SERVICO').AsInteger := DataSet.FieldByName('COD_SERVICO').AsInteger;
    dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
    dtSet.FieldByName('QUANT_SERV_PED').AsFloat := DataSet.FieldByName('QUANT_SERV_PED').AsFloat;
    dtSet.FieldByName('CODIGO_NOP').AsFloat := DataSet.FieldByName('CODIGO_NOP').AsFloat;
    dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
    dtSet.FieldByName('STATUS').AsString := DataSet.FieldByName('STATUS').AsString;
    dtSet.FieldByName('VALOR_UN_SERV').AsFloat := DataSet.FieldByName('VALOR_UN_SERV').AsFloat;
    dtSet.FieldByName('VALOR_TOT_SERV').AsFloat := DataSet.FieldByName('VALOR_TOT_SERV').AsFloat;
    dtSet.FieldByName('RATEIO_ACRESC').AsCurrency := dataSet.FieldByName('RATEIO_ACRESC').AsCurrency;
    dtSet.FieldByName('ACRESC_ITEM').AsCurrency := dataSet.FieldByName('ACRESC_ITEM').AsCurrency;
    dtSet.FieldByName('RATEIO_DESC').AsCurrency := dataSet.FieldByName('RATEIO_DESC').AsCurrency;
    dtSet.FieldByName('DESC_ITEM').AsCurrency := dataSet.FieldByName('DESC_ITEM').AsCurrency;
    dtSet.Post;
  end;

end;

function TPedVendaServ.post: boolean;
var
	buscas2: TIBQuery;
begin
  try
    Result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    try


      if not (dataSet.State in [dsInsert, dsEdit]) then
      begin
        result := true;
        exit;
      end;
      if vSing.vTipoVenda = 'OS' then
      begin
        if not vDadosIni.PesqPros('VND025', 'SALVAR', dataSet.FieldByName('TIPO').AsString + ' - ' +
          'SERV.: ' + dataSet.FieldByName('COD_SERVICO').AsString, 'PEDVENDA_SERV', dataSet.FieldByName('NITEM').AsString, buscas, true) then
            Exit;
      end
      else
      begin
        if not vDadosIni.PesqPros('VND029', 'SALVAR', dataSet.FieldByName('TIPO').AsString + ' - ' +
          'SERV.: ' + dataSet.FieldByName('COD_SERVICO').AsString, 'PEDVENDA_SERV', dataSet.FieldByName('NITEM').AsString, buscas, true) then
            Exit;
      end;
      if FOwner.vendaFechada then
        Exit;

      if dataSet.FieldByName('cod_servico').IsNull then
        raiseExceptioncreate('Serviço não informado.' + chr(13) + 'Favor Verificar', 'DBEdit56')
      else if not vTipServ.dataSet.Locate('cod_servico', dataSet.FieldByName('cod_servico').AsInteger, [loCaseInsensitive]) then
        raiseExceptioncreate('Serviço informado não foi encontrado.' + chr(13) + 'Favor Verificar.', 'DBEdit56');

      if trim(dataSet.FieldByName('desc_serv_ped').AsString) = '' then
        raiseExceptioncreate('Descrição do serviço não informada' + chr(13) + 'Favor Verificar', 'DBEdit61');

      if (dataSet.FieldByName('cod_vendedor').AsInteger = 0) and (vDadosIni.vMecOS <> 'S') then
        raiseExceptioncreate('Mecânico ou Técnico não informado' + chr(13) + 'Favor Verificar', 'DBEdit59');

      if dataSet.FieldByName('codigo_nop').AsFloat = 0 then
        raiseExceptioncreate('CFOP não informado' + chr(13) + 'Favor Verificar', 'DBEdit63');

      if (dataSet.FieldByName('SUBGSERVICO').AsInteger = 0) and (FOwner.getTipoVenda <> 'ORC') then
        raiseExceptioncreate('Sub Grupo do serviço não informado' + chr(13) + 'Favor Verificar', 'DBEdit48');

      if not checaValoresItens then
        exit;

      if dataSet.State = dsInsert then
      begin
        if (((vDadosIni.vEmp.vAgendaOficina = 'S') and (vDadosIni.vEmp.vUsarDisponibilidadeOS = 'A'))
          or (vDadosIni.vEmp.vAgendaOficina = 'S') and (FOwner.dataSet.FieldByName('COD_AGENDA').AsInteger > 0)) then
        begin
        // Função para verificar se o mecâncio possuí tempo disponível
          if not tempo_disponivel_mecanico then
            exit;
        // Função para verificar se o serviço especifico possuí tempo disponível
          if not tempo_disponivel_srvEspecifico_tmo then
            exit;
        // Função para verificar se o serviço possuí tempo disponível na data da OS
          if not tempo_disponivel_tmo then
            exit;
        // Função para gravar serviço na tabela agenda_itens
          if (FOwner.dataSet.FieldByName('COD_AGENDA').AsInteger > 0) then
            SalvarServAgendaItens;
        end;
        if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
          and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
          and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
        begin
          buscas.Close;
          buscas.SQL.Text := 'select max(nitem) as nitem from pedvenda_serv' +
            ' where nped = ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger) +
            ' and tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('tipo').AsString) +
            ' and cod_empresa =  ' + vDadosIni.codEmpresa;
          buscas.Open;
          dataSet.FieldByName('nitem').AsInteger := buscas.FieldByName('nitem').AsInteger + 1;
        end;
      end;

      if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
        and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
        and (dataSet.FieldByName('NPED').AsInteger = 0)
        and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
          dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;

      if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') and (dataSet.FieldByName('nitem_serv').AsInteger <= 0) then
      begin
        buscas2.Close;
        buscas2.SQL.Text := 'select cod from incrementa_codigo( ' + vDadosIni.codEmpresa + ',''PEDVENDA_SERV_NITEM'')';
        try
          buscas2.Open;
          dataSet.FieldByName('nitem_serv').AsInteger := buscas2.FieldByName('cod').AsInteger;

         if buscas2.Transaction.InTransaction then
           buscas2.Transaction.Commit;
        except
          Result := false;
          exit;
        end;
      end;

      // Atualizar valor liquido, rateio acresc  e rateio desc
      dataSet.FieldByName('RATEIO_ACRESC').AsFloat :=
        RoundTo(dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat
          + dataSet.FieldByName('ACRESC_ITEM').AsFloat, -2);

      dataSet.FieldByName('RATEIO_DESC').AsFloat   :=
        RoundTo(dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat
          + dataSet.FieldByName('DESC_ITEM').AsFloat, -2);

      dataSet.FieldByName('VALOR_TOT_SERV_LIQ').AsFloat :=
        RoundTo(dataSet.FieldByName('VALOR_TOT_SERV').AsFloat
          + IfThen(dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat > 0, dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat, 0) +
          		dataSet.FieldByName('ACRESC_ITEM').AsFloat
          - IfThen(dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat > 0, dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat, 0) -
          		dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

      if dataSet.FieldByName('QUANT_SERV_PED').AsFloat > 0 then
        dataSet.FieldByName('VALOR_UN_SERV_LIQ').AsFloat := RoundTo(
          dataSet.FieldByName('VALOR_TOT_SERV_LIQ').AsFloat / dataSet.FieldByName('QUANT_SERV_PED').AsFloat, - StrToInt(vSing.vCasasDecimais));

      Result := inherited post;

      if Result then
        if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO') then
          if (FOwner.dataSet.FieldByName('nped').AsInteger = 0) then
            FOwner.verificaSalvamentoAutomatico
          else
          begin
            Result := Apply;
            if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
              abrePedVendaServ(FOwner.dataSet.FieldByName('nped').AsInteger);
          end;

      _alterarServicoProdutos;
      Inc(nItem);
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaServ.SalvarServAgendaItens: boolean;
var
  vTmo, vCFOP: Double;
  vServico: string;
begin
  buscas.Close;
  buscas.SQL.Text := ' select cod_servico, desc_servico, tmo, codigo_nop from tipo_servico ' +
    ' where cod_servico = :cod_servico ';
  buscas.ParamByName('cod_servico').AsInteger := dataSet.FieldByName('COD_SERVICO').AsInteger;
  buscas.Open;
  buscas.FetchAll;

  vServico := Trim(buscas.FieldByName('DESC_SERVICO').AsString);
  vTmo := buscas.FieldByName('TMO').AsFloat;
  vCFOP := buscas.FieldByName('CODIGO_NOP').AsFloat;

  buscas.Close;
  buscas.SQL.Text := 'INSERT INTO AGENDA_ITENS (COD_AGENDA, COD_EMPRESA, NITEM, COD_SERVICO, ' +
     ' DESC_SERVICO, TMO_SERVICO, NPED, CODIGO_NOP, VALOR_SERVICO) ' +
     ' VALUES (:COD_AGENDA, :COD_EMPRESA, :NITEM, :COD_SERVICO, ' +
     ' :DESC_SERVICO, :TMO_SERVICO, :NPED, :CODIGO_NOP, :VALOR_SERVICO); ';
  buscas.ParamByName('COD_AGENDA').AsInteger := FOwner.dataSet.FieldByName('COD_AGENDA').AsInteger;
	buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
	buscas.ParamByName('NITEM').AsInteger := dataSet.FieldByName('NITEM').AsInteger;
  buscas.ParamByName('COD_SERVICO').AsInteger := dataSet.FieldByName('COD_SERVICO').AsInteger;
	buscas.ParamByName('DESC_SERVICO').AsString := vServico;
	buscas.ParamByName('TMO_SERVICO').AsFloat := vTmo;
	buscas.ParamByName('NPED').AsInteger := FOwner.dataSet.FieldByName('NPED').AsInteger;
	buscas.ParamByName('CODIGO_NOP').AsFloat := vCFOP;
	buscas.ParamByName('VALOR_SERVICO').AsFloat := dataSet.FieldByName('VALOR_UN_SERV').AsFloat;
  buscas.ExecSQL;
end;

function TPedVendaServ.tempo_disponivel_mecanico: boolean;
var
 aux: string;
begin
  Result := false;

  if vDadosIni.vEmp.vUsarAparelho = 'S' then
    aux := 'Técnico'
  else
    aux := 'Mecânico';

  buscas.Close;
  buscas.SQL.Text := '  select c.cod_vendedor, tm.n_os, tm.dia_fechado from colaborador c ' +
    ' inner join agenda_itens ai on ai.cod_vendedor = c.cod_vendedor and ai.cod_empresa = c.cod_empresa ' +
    ' inner join agenda a on ai.cod_agenda = a.cod_agenda and ai.cod_empresa = a.cod_empresa ' +
    ' inner join tmo_serv_os tm on tm.cod_servico = ai.cod_servico and tm.n_os = ai.nped and tm.cod_empresa = ai.cod_empresa ' +
    ' where tm.dia_fechado is null and tm.n_os <> ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
    ' and c.cod_empresa =' + vDadosIni.codEmpresa;
  buscas.Open;

  if not buscas.IsEmpty then
  begin
    if Application.MessageBox(PChar(aux+' possuí serviço em aberto!' + chr(13) + 'Deseja continuar?'),
      'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrNo then
      Exit;

    if not vDadosIni.PesqPros('AGO019', 'SALVAR', '', '', dataSet.FieldByName('COD_AGENDA').AsString, buscas, true) then
      Exit;

    Result := true;
  end
  else
    Result := true;
end;

function TPedVendaServ.tempo_disponivel_srvEspecifico_tmo: boolean;
var
  vQuant_Mecanicos, vTmo_Utilizado, vTmo_Disponivel, vServicos: Double;
  vCod_Vendedor: string;
  buscas2: TIBQuery;
begin
	try
    Result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas.Close;
    buscas.SQL.Text := ' select cod_servico from tipo_servico_mecanico ' +
      ' where cod_servico = ' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if buscas.IsEmpty then
    begin
      Result := true;
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select tp.cod_vendedor from tipo_servico_mecanico tp ' +
      ' inner join colaborador c on c.cod_vendedor = tp.cod_vendedor and c.cod_empresa = tp.cod_empresa ' +
      ' where tp.cod_servico = :cod_servico ' +
      ' and ((c.data_ini_ausencia > :DATA_INI) or  c.data_fim_ausencia < :DATA_FIM ' +
      ' or (c.data_ini_ausencia is null or c.data_fim_ausencia is null)) ' +
      ' and c.cod_empresa = :cod_empresa';
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('COD_SERVICO').AsInteger := dataSet.FieldByName('COD_SERVICO').AsInteger;
    buscas.ParamByName('DATA_INI').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
    buscas.ParamByName('DATA_FIM').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
    buscas.Open;
    buscas.FetchAll;

    if buscas.IsEmpty then
    begin
      Result := true;
      exit;
    end;
    vQuant_Mecanicos := buscas.RecordCount;
    FOwner.vAgenda._QuantHorasSemana(FOwner.dataSet.FieldByName('DATA_PED').AsDateTime);

    vCod_Vendedor := '';
    buscas.First;
    while not buscas.Eof do
    begin

      if vCod_Vendedor = '' then
        vCod_Vendedor := buscas.FieldByName('COD_VENDEDOR').AsString
      else
        vCod_Vendedor := vCod_Vendedor + ',' + buscas.FieldByName('COD_VENDEDOR').AsString;

      buscas.Next;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select distinct tp.cod_servico from tipo_servico_mecanico tp ' +
      ' where tp.cod_vendedor in (' + vCod_Vendedor + ') and tp.cod_empresa=' + vDadosIni.codEmpresa;
    buscas.Open;
    buscas.FetchAll;

    vTmo_Utilizado := 0;
    buscas.First;
    while not buscas.Eof do
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select sum(ai.tmo_servico) as tmo from agenda a ' +
        ' inner join agenda_itens ai on ai.cod_agenda = a.cod_agenda and ai.cod_empresa = a.cod_empresa ' +
        ' where a.data_agenda = :data_agenda and ai.cod_servico = :cod_servico '+
        ' and a.cod_empresa = :cod_empresa ';
      buscas2.ParamByName('data_agenda').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
      buscas2.ParamByName('cod_servico').AsInteger := buscas.FieldByName('COD_SERVICO').AsInteger;
      buscas2.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas2.Open;
      buscas2.FetchAll;

      vTmo_Utilizado := vTmo_Utilizado + buscas2.FieldByName('TMO').AsFloat;

      buscas.Next;
    end;

    dtSet.First;
    while not dtSet.Eof do
    begin
      buscas.Close;
      buscas.SQL.Text := ' select tp.cod_servico, s.tmo from tipo_servico_mecanico tp ' +
        ' inner join tipo_servico s on s.cod_servico = tp.cod_servico ' +
        ' where tp.cod_servico =' + IntToStr(dtSet.FieldByName('COD_SERVICO').AsInteger) +
        ' and tp.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if dtSet.FieldByName('COD_AGENDA').AsInteger = 0 then
      begin
        if not buscas.IsEmpty then
        begin
          vServicos := vServicos + buscas.FieldByName('TMO').AsFloat;
        end;
      end;
      dtSet.Next;
    end;

    buscas.Close;
    buscas.SQL.Text := 'select tmo from tipo_servico'
      + ' where cod_servico =' + dataSet.FieldByName('COD_SERVICO').AsString + '';
    buscas.Open;
    buscas.FetchAll;

    vTmo_disponivel := (Quant_Horas_Dia * vQuant_Mecanicos) - (vTmo_Utilizado + vServicos + buscas.FieldByName('TMO').AsFloat);

    if vTmo_disponivel < 0 then
    begin
      if Application.MessageBox(PChar('Serviço específico não possuí tempo disponível!' + chr(13) + 'Deseja continuar?'),
        'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1)
        = mrNo then
        Exit;

      if not vDadosIni.PesqPros('AGO016', 'SALVAR', '', 'AGENDA',
        dataSet.FieldByName('COD_AGENDA').AsString, buscas, true) then
        Exit;

      Result := true;
    end
    else
      Result := true;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaServ.tempo_disponivel_tmo: boolean;
var
  vTmoUtilizado, vTmoServicos, vTmoPorDia, vTmoDisponivel, Quant_Mecanicos: Double;
begin
  Result := False;

  buscas.Close;
  buscas.SQL.Text := 'select count(*) as quant_mecanicos from colaborador c ' +
    ' inner join funcoes f on f.cod_funcao = c.cod_funcao ';
  if vDadosIni.vEmp.vUsarAparelho = 'S' then
  	buscas.SQL.Text := buscas.SQL.Text +
     ' where ((f.desc_funcao like ''%TECNICO%'') or (f.desc_funcao like ''%TÉCNICO%'')) '
  else
  	buscas.SQL.Text := buscas.SQL.Text +
     ' where ((f.desc_funcao like ''%MECANICO%'') or (f.desc_funcao like ''%MECÂNICO%'')) ';
  buscas.SQL.Text := buscas.SQL.Text +
    ' and c.ativo = 1 and c.cod_empresa = :cod_empresa ' +
    ' and ((c.data_ini_ausencia > :DATA_INI) or  c.data_fim_ausencia < :DATA_FIM ' +
    ' or (c.data_ini_ausencia is null or c.data_fim_ausencia is null))';
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('DATA_INI').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
  buscas.ParamByName('DATA_FIM').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
  buscas.Open;


  Quant_Mecanicos := buscas.FieldByName('QUANT_MECANICOS').AsInteger;
  FOwner.vAgenda._QuantHorasSemana(FOwner.dataSet.FieldByName('DATA_PED').AsDateTime);

  vTmoPorDia := Quant_Horas_Dia * Quant_Mecanicos;

  buscas.Close;
  buscas.SQL.Text := ' select sum(agi.tmo_servico) as tmo_utilizado from agenda ag ' +
    ' inner join agenda_itens agi on agi.cod_agenda = ag.cod_agenda and agi.cod_empresa =ag.cod_empresa ' +
    ' where ag.data_agenda = :data_agenda and ag.cod_empresa = :cod_empresa ';
  buscas.ParamByName('DATA_AGENDA').AsDateTime := FOwner.dataSet.FieldByName('DATA_PED').AsDateTime;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.Open;

  vTmoUtilizado := buscas.FieldByName('TMO_UTILIZADO').AsFloat;

  dtSet.First;
  while not dtSet.Eof do
  begin
    if dtSet.FieldByName('COD_AGENDA').AsInteger = 0 then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select tmo from tipo_servico ' +
        ' where cod_servico = ' + IntToStr(dtSet.FieldByName('COD_SERVICO').AsInteger);
      buscas.Open;
      buscas.FetchAll;
      
      vTmoServicos := vTmoServicos + buscas.FieldByName('TMO').AsFloat;
    end;
    dtSet.Next;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select tmo from tipo_servico ' +
    ' where cod_servico = ' + dataSet.FieldByName('COD_SERVICO').AsString;
  buscas.Open;
  buscas.FetchAll;
  vTmoServicos := vTmoServicos + buscas.FieldByName('TMO').AsFloat;

  vTmoDisponivel := vTmoPorDia - (vTmoUtilizado + vTmoServicos);

  if vTmoDisponivel <= 0 then
  begin
    if Application.MessageBox(PChar('Serviço sem tempo disponivel!' + chr(13) + 'Deseja continuar?'),
      'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1)
      = mrNo then
      Exit;

    if not vDadosIni.PesqPros('AGO017', 'SALVAR', '', 'AGENDA',
      dataSet.FieldByName('COD_AGENDA').AsString, buscas, true) then
      Exit;

    Result := true;
  end
  else
    Result := true;
end;

function TPedVendaServ.validaAlteracaoPrecoServ: boolean;
var
  valorUnitario: Currency;
begin
  result := true;
  try
    if vDadosIni.StrToFloatFormat(FvalorUnitarioServ, vDadosIni.vEmp.vCasasDecimais) <>
      vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_UN_SERV').AsFloat, vDadosIni.vEmp.vCasasDecimais) then
      if not vDadosIni.PesqPros('VND074', 'LIBERAR', dataSet.FieldByName('COD_SERVICO').AsString, 'PEDVENDA', '', buscas, TRUE) then
      begin
        dataSet.FieldByName('VALOR_UN_SERV').AsFloat := FvalorUnitarioServ;
        raiseExceptionCreate('Alteração de preço de serviço não permitida.', 'dbedit62');
      end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

