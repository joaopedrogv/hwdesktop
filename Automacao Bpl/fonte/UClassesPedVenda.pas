function TPedVenda.abrePedVenda(nped: integer; tipo: string): boolean;
begin
  result := montaSelect('select ' + Fsql_campos + ' from pedvenda ' + Fsql_inner +
    ' where pedvenda.COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and pedvenda.nped = ' + IntToStr(nped) + ' and pedvenda.tipo = ' + QuotedStr(tipo) +
    ' and pedvenda.ativo=1');
end;

procedure TPedVenda.abrePlanoPagamento;
var
  vPlano: TComunicacaoFormaPagamento;
begin
	try
    vPlano := TComunicacaoFormaPagamento.create;
    vPlano.iniciaPlanoDePagamento;
  finally
  	if Assigned(vPlano) then
      FreeAndNil(vPlano);
  end;
end;

function TPedVenda._abreRegraCondicoesPolitica(pTodas: boolean): Boolean;
var
	vformasCliente: string;
  vtemp: string;
  vtemp2: string;
  buscas2: TIBQuery;
  I: Integer;

  function _existeControlesPadrao: boolean;
  var
    vSql: string;
  begin
    Result := False;

    if vDadosIni.vEmp.vUsarControlesCliente <> 'S' then
      exit;

    vSql  := 'SELECT FIRST 1 CODIGO_CTRL, NOME_CTRL, QSEQPERF FROM CONTROLES' +
      ' WHERE CXENT = ''S'' ' +
      ' AND ATIVO = 1 ' +
      ' AND CODIGO_EMP = ' + vDadosIni.codEmpresa;

    vSql := vSql + ' AND COALESCE(FP_PADRAO_CL, ''N'') = ''T'' ';

    if vDadosIni.vEmp.vFinanceiroUnificado then
      vSql := vSql + ' AND (COALESCE(CONTROLE_VISIVEL, ''S'') = ''S'') ';

    buscas2.Close;
    buscas2.SQL.Text := vSql;
    buscas2.Open;

    Result := buscas2.RecordCount > 0;
  end;
  
begin
  try
    Result := False;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if vRVnd.vCtrlSelTmp <> nil then
      vRVnd.vCtrlSelTmp.EmptyDataSet;

    vformasCliente := '';
    if (vDadosIni.vEmp.vUsarControlesCliente = 'S') then
    begin
      buscas2.Close;
      buscas2.SQL.Text := ' select nome_cliente, controles_fp, cond_pag_vnd, cond_pag_pre from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Open;

      vformasCliente := trim(buscas2.FieldByName('controles_fp').AsString);

      if trim(vformasCliente) <> '' then
        if ContainsStr(trim(vformasCliente), ',')
          and (Copy(trim(vformasCliente), 1, 1) = '(')
          and (Copy(trim(vformasCliente), Length(trim(vformasCliente)), 1) <> ')') then
        begin
          vtemp := '';
          vtemp2 := '';
          for I := 1 to Length(trim(vformasCliente)) do
          begin
            vtemp := vtemp + trim(vformasCliente[I]);
            if trim(vformasCliente[I]) = ',' then
              vtemp2 := vtemp;
          end;
          vformasCliente := Copy(vtemp2, 1, Length(vtemp2) - 1) + ')';
        end;

      if (vDadosIni.vEmp.vUsarControlesCliente = 'S')
        and ((trim(vformasCliente) <> '') or (_existeControlesPadrao)) then
      begin
        buscas2.Close;
        buscas2.SQL.Text := '';
        if trim(vformasCliente) <> '' then
        begin
          buscas2.SQL.Text := buscas2.SQL.Text +
            ' SELECT CONTROLES.CODIGO_CTRL FROM CONTROLES ' +
            ' WHERE CONTROLES.CXENT = ''S'' ' +
            ' AND CONTROLES.ATIVO = 1 ' +
            ' AND CONTROLES.CODIGO_EMP = ' + vDadosIni.codEmpresa +
            ' AND CONTROLES.CODIGO_CTRL IN ' + vformasCliente +
            ' UNION ';
        end;

        buscas2.SQL.Text := buscas2.SQL.Text +
          ' SELECT CONTROLES.CODIGO_CTRL FROM CONTROLES ' +
          ' WHERE CONTROLES.CXENT = ''S'' ' +
          ' AND CONTROLES.ATIVO = 1 ' +
          ' AND CONTROLES.CODIGO_EMP = ' + vDadosIni.codEmpresa +
          ' AND COALESCE(CONTROLES.FP_PADRAO_CL, ''N'') = ''T'' ';
        buscas2.Open;

        if buscas2.RecordCount > 0 then
        begin
          vformasCliente := '(';
          buscas2.First;
          while not buscas2.Eof do
          begin
            if buscas2.RecNo = 1 then
              vformasCliente := vformasCliente + IntToStr(buscas2.FieldByName('CODIGO_CTRL').AsInteger)
            else
              vformasCliente := vformasCliente + ', ' + IntToStr(buscas2.FieldByName('CODIGO_CTRL').AsInteger);

            buscas2.Next;
          end;
          vformasCliente := vformasCliente + ')';
        end;
      end;
    end;

    vListaTodasPoliticas := pTodas;
    if (trim(dataSet.FieldByName('REGRAS_DESCONTOS').AsString)= '') or (trim(dataSet.FieldByName('REGRAS_DESCONTOS').AsString) = '()') then
      vRVnd.vRVndSel.montaSelect(' select first 0 * from regras_vendas rv ' +
        ' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and rv.ativo = 1 ' +
        ' order by rv.cod_regravnd ')
    else
      vRVnd.vRVndSel.montaSelect(' select * from regras_vendas rv '+
        ' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and rv.cod_regravnd in ' + dataSet.FieldByName('REGRAS_DESCONTOS').AsString +
        ' and rv.ativo = 1 ' +
        ' order by rv.cod_regravnd ');

    vRVnd.dataSet.AfterScroll := RegraVendaAfterScroll;
    vRVnd.Close;
    vRVnd.dataSet.CommandText := ' select rv.cod_regravnd, ' +
      ' (trim(coalesce(rv.descricao, '''')) || '' - '' || trim(coalesce(ctrl.nome_ctrl, ''''))) descricao, ' +
      ' rv.pessoafisica, ' +

      ' (select rt2.tipovnd_os from regravnd_tipo_vendas rt2 ' +
      '	 where rt2.cod_regravnd = rv.cod_regravnd ' +
      '	 and rt2.cod_empresa = rv.cod_empresa ' +
      '  and rt2.tipo = :pTipo ' +
      '  and rt2.tipovnd_os = :pTipovnd_os) tipovnd_os, ' +

      ' case ' +

      ' when ((rv.pessoafisica <> :pPessoafisica) and (rv.pessoafisica <> ''A'')) then ''Barrado'' ' +

      vDadosIni.IfThen(dataSet.FieldByName('COD_CONTROLE').AsInteger > 0,
      '	when (rc.codigo_ctrl <> :pCodigo_ctrl) then ''Barrado'' ', '') +

      ' when (coalesce(rv.valormindoc, 0) > :pValorTotal) then ''Barrado'' ' +

      ' when (:pValorTotal > coalesce(rv.valormaxdoc, 0)) then ''Barrado'' ' +

      '	when ((:pMax_desc > 0) ' +
      '		and (rv.max_desc = 0)) then ''Barrado'' ' +

      '	when ((:pMax_descprod > 0) ' +
      '		and (rv.max_descprod = 0)) then ''Barrado'' ' +

      '	when ((:pMax_descserv > 0) ' +
      '		and (rv.max_descserv = 0)) then ''Barrado'' ' +

      '	when ((:pMax_desc > 0) ' +
      '		and (rv.max_desc > 0) ' +
      '   and (:pMax_desc > rv.max_desc)) then ''Barrado'' ' +

      '	when ((:pMax_descprod > 0) ' +
      '   and (rv.max_descprod > 0) ' +
      '   and (:pMax_descprod > rv.max_descprod)) then ''Barrado'' ' +

      '	when ((:pMax_descserv > 0) ' +
      '   and (rv.max_descserv > 0) ' +
      '		and (:pMax_descserv > rv.max_descserv)) then ''Barrado'' ' +

      ' when ((select count(*) from regras_vendas rv1 ' +
      '				 where rv1.cod_regravnd = rv.cod_regravnd ' +
      '				 and rv1.cod_empresa = rv.cod_empresa ' +
      '        and ((rv1.pessoafisica = :pPessoafisica) or (rv1.pessoafisica = ''A''))) <= 0) then ''Barrado'' ' +

      ' when ((select count(*) from regravnd_tipo rtp1 ' +
      '				 where rtp1.cod_regravnd = rv.cod_regravnd ' +
      '				 and rtp1.cod_empresa = rv.cod_empresa ' +
      '        and rtp1.tipo = :pTipo) <= 0) then ''Barrado'' ' +

      ' when ((select count(*) from regravnd_tipo_vendas rt1 ' +
      '				 inner join tipo_vendas tp1 on ' +
      ' 			   tp1.tipo = rt1.tipo ' +
      ' 				 and case when (tp1.tipo = ''REQ'') then tp1.sigla else tp1.tipo_os end = rt1.tipovnd_os ' +
      '			   where rt1.cod_regravnd = rv.cod_regravnd ' +
      '			   and rt1.cod_empresa = rv.cod_empresa ' +
      '        and rt1.tipo = :pTipo ' +
      ' 			 and rt1.tipovnd_os = :pTipovnd_os ' +
      '				 and tp1.ativo = 1) <= 0) then ''Barrado'' ' +

      vDadosIni.IfThen(dataSet.FieldByName('COD_CONTROLE').AsInteger > 0,
      ' when ((select count(*) from regravnd_controle rc1 ' +
      '        inner join controles ctrl1 on ' +
      '				 	 ctrl1.codigo_ctrl = rc1.codigo_ctrl ' +
      '					 and ctrl1.codigo_emp = rc1.cod_empresa ' +
      '			   where rc1.cod_regravnd = rv.cod_regravnd ' +
      '			   and rc1.cod_empresa = rv.cod_empresa ' +
      '			   and rc1.codigo_ctrl = :pCodigo_ctrl ' +
      '   		 and ctrl.cxent = ''S'' ' +
      '				 and ctrl.ativo = 1) <= 0) then ''Barrado'' ', '') +

      vDadosIni.IfThen(dataSet.FieldByName('COD_COND_PAG').AsInteger > 0,
      ' when ((select count(*) from regravnd_condpag rp1 ' +
      '				 inner join cond_pag cond1 on ' +
      '				   cond1.cod_cond_pag = rp1.cod_cond_pag ' +
      '			   where rp1.cod_regravnd = rv.cod_regravnd ' +
      '        and rp1.cod_empresa = rv.cod_empresa ' +
      '        and rp1.cod_cond_pag = :pCod_cond_pag ' +
      '				 and cond1.ativo = 1) <= 0) then ''Barrado'' ', '');

      vRVnd.dataSet.CommandText := vRVnd.dataSet.CommandText +
      ' else ''Liberado'' end as status, ' +
      ' rv.sobrepor_promocao, ' +
      ' rv.sobrepor_tabpreco, ' +
      ' rv.sobrepor_maxdescprod, ' +
      ' rv.vlvnd_mindesc, ' +
      ' rc.codigo_ctrl, ' +
      ' coalesce(ctrl.nome_ctrl, '''') nome_ctrl, ctrl.qseqperf, ' +

      vDadosIni.IfThen(not pTodas, ' rtp.tipo, ',
      ' (select rtp2.tipo from regravnd_tipo rtp2 ' +
      '  where rtp2.cod_regravnd = rv.cod_regravnd ' +
      '  and rtp2.cod_empresa = rv.cod_empresa ' +
      '  and rtp2.tipo = :pTipo) tipo, ') +

      vDadosIni.IfThen(dataSet.FieldByName('COD_COND_PAG').AsInteger > 0,
      ' (select rp2.cod_cond_pag from regravnd_condpag rp2 ' +
      '	 where rp2.cod_regravnd = rv.cod_regravnd ' +
      '  and rp2.cod_empresa = rv.cod_empresa ' +
      '  and rp2.cod_cond_pag = :pCod_cond_pag) cod_cond_pag ', ' 0 cod_cond_pag ') +

      ' from regras_vendas rv ' +

      vDadosIni.IfThen(pTodas, '',
      ' inner join regravnd_tipo rtp on ' +
      '		rtp.cod_regravnd = rv.cod_regravnd ' +
      '		and rtp.cod_empresa = rv.cod_empresa ') +

      vDadosIni.IfThen(pTodas, '',
      ' inner join regravnd_tipo_vendas rt on ' +
      '		rt.cod_regravnd = rv.cod_regravnd ' +
      '		and rt.cod_empresa = rv.cod_empresa ') +

      ' inner join regravnd_controle rc on ' +
      ' 	rc.cod_regravnd = rv.cod_regravnd ' +
      '		and rc.cod_empresa = rv.cod_empresa ' +
      ' inner join controles ctrl on ' +
      '		ctrl.codigo_ctrl = rc.codigo_ctrl ' +
      '		and ctrl.codigo_emp = rc.cod_empresa ' +
      '   and ctrl.cxent = ''S'' ' +
      '		and ctrl.ativo = 1 ' +

      ' where rv.cod_empresa = :pCod_empresa ' +
      ' and rv.ativo = 1 ' +

      vDadosIni.IfThen((vDadosIni.vEmp.vUsarControlesCliente = 'S') and (trim(vformasCliente) <> ''),
        ' and rc.codigo_ctrl in ' + vformasCliente, '') +

      vDadosIni.IfThen(pTodas, '',
        ' and ((rv.pessoafisica = :pPessoafisica) or (rv.pessoafisica = ''A'')) ') +

      vDadosIni.IfThen(pTodas, '',
        ' and rtp.tipo = :pTipo ') +

      vDadosIni.IfThen(pTodas, '',
        ' and rt.tipo = :pTipo ' +
        ' and rt.tipovnd_os = :pTipovnd_os ') +

      vDadosIni.IfThen(pTodas, '',
        vDadosIni.IfThen(dataSet.FieldByName('COD_CONTROLE').AsInteger > 0,
        '	and rc.codigo_ctrl = :pCodigo_ctrl ', '')) +

      vDadosIni.IfThen(pTodas, '',
        ' and :pValorTotal >= coalesce(rv.valormindoc, 0) ') +

      vDadosIni.IfThen(pTodas, '',
        ' and coalesce(rv.valormaxdoc, 0) >= :pValorTotal ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_desc > 0) ' +
        '						  and (rv.max_desc = 0)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_descprod > 0) ' +
        '						  and (rv.max_descprod = 0)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_descserv > 0) ' +
        '							and (rv.max_descserv = 0)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_desc > 0) ' +
        '							and (rv.max_desc > 0) ' +
        '							and (:pMax_desc > rv.max_desc)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_descprod > 0) ' +
        '							and (rv.max_descprod > 0) ' +
        '							and (:pMax_descprod > rv.max_descprod)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (case when ((:pMax_descserv > 0) ' +
        '	            and (rv.max_descserv > 0) ' +
        '             and (:pMax_descserv > rv.max_descserv)) then 0 else 1 end) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        ' and (select count(*) from regravnd_tipo_vendas rt1 ' +
        '			 inner join tipo_vendas tp1 on ' +
        '			   tp1.tipo = rt1.tipo ' +
        ' 			 and case when (tp1.tipo = ''REQ'') then tp1.sigla else tp1.tipo_os end = rt1.tipovnd_os ' +
        '			 where rt1.cod_regravnd = rv.cod_regravnd ' +
        '			 and rt1.cod_empresa = rv.cod_empresa ' +
        '      and rt1.tipo = :pTipo ' +
        '      and rt1.tipovnd_os = :pTipovnd_os ' +
        '      and tp1.ativo = 1) > 0 ') +

      vDadosIni.IfThen(pTodas, '',
        vDadosIni.IfThen(dataSet.FieldByName('COD_CONTROLE').AsInteger > 0,
          ' and (select count(*) from regravnd_controle rc1 ' +
          '      inner join controles ctrl1 on ' +
          '			   ctrl1.codigo_ctrl = rc1.codigo_ctrl ' +
          '				 and ctrl1.codigo_emp = rc1.cod_empresa ' +
          '			 where rc1.cod_regravnd = rv.cod_regravnd ' +
          '			 and rc1.cod_empresa = rv.cod_empresa ' +
          '			 and rc1.codigo_ctrl = :pCodigo_ctrl ' +
          '   	 and ctrl1.cxent = ''S'' ' +
          '			 and ctrl1.ativo = 1) > 0 ', '')) +

      vDadosIni.IfThen(pTodas, '',
        vDadosIni.IfThen(dataSet.FieldByName('COD_COND_PAG').AsInteger > 0,
          ' and (select count(*) from regravnd_condpag rp1 ' +
          '			 inner join cond_pag cond1 on ' +
          '			 	 cond1.cod_cond_pag = rp1.cod_cond_pag ' +
          '			 where rp1.cod_regravnd = rv.cod_regravnd ' +
          '      and rp1.cod_empresa = rv.cod_empresa ' +
          '      and rp1.cod_cond_pag = :pCod_cond_pag ' +
          '      and cond1.ativo = 1) > 0 ', '')) +

      ' order by status desc, rv.descricao, ctrl.qseqperf ';


    vRVnd.dataSet.Params.ParamByName('pCod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);

    vRVnd.dataSet.Params.ParamByName('pPessoafisica').AsString := trim(FTipoPessoaRegraVND);

    vRVnd.dataSet.Params.ParamByName('pTipovnd_os').AsString := trim(FTipoVndOSRegraVND);

    vRVnd.dataSet.Params.ParamByName('pTipo').AsString := trim(FTipoRegraVND);

    if dataSet.FieldByName('COD_CONTROLE').AsInteger > 0 then
      vRVnd.dataSet.Params.ParamByName('pCodigo_ctrl').AsInteger := dataSet.FieldByName('cod_controle').AsInteger;

    if dataSet.FieldByName('COD_COND_PAG').AsInteger > 0 then
      vRVnd.dataSet.Params.ParamByName('pCod_cond_pag').AsInteger := dataSet.FieldByName('cod_cond_pag').AsInteger;

    vRVnd.dataSet.Params.ParamByName('pValorTotal').AsFloat := dataSet.FieldByName('valor_total').AsFloat;

    vRVnd.dataSet.Params.ParamByName('pMax_desc').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPerc, 5);

    vRVnd.dataSet.Params.ParamByName('pMax_descprod').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPercProd, 5);

    vRVnd.dataSet.Params.ParamByName('pMax_descserv').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPercServ, 5);

    vRVnd.Open;

    vRVnd.dataSet.Filter := '';
    vRVnd.dataSet.Filtered := False;

    if not vRVnd.IsEmpty then
      result := True;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVenda.abreVendaDireto(pVendaRapida: Boolean): boolean;
begin
	if not vDadosIni._mdiAberto('pkPedidoVenda', 'TFrmCadPedVendaREQ', 'NAME') then
    exit;

  vDadosIni.vTipoForm := 0;
  vDadosIni.vModalOuChild := 'M';
  if pVendaRapida then
    vDadosIni.vTipoForm := 3
  else
    vDadosIni.vTipoForm := 4;

  vDadosIni.vtpVenda := 'REQ';

  if FrmCadPedVendaREQ = nil then
    Application.CreateForm(TFrmCadPedVenda, FrmCadPedVendaREQ);
  FrmCadPedVendaREQ.Position := poScreenCenter;
  FrmCadPedVendaREQ.Showmodal;
end;

