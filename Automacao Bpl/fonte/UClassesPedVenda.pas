      temp := 'ORDEM SERVIÇO'
    else if vSing.vTipoVenda = 'ORC' then
      temp := 'ORÇAMENTO';

    if (FDadosImpressao.ModeloImpressao = 'REDUZIDO') or (FDadosImpressao.ModeloImpressao = 'DETALHADO') or (FDadosImpressao.ModeloImpressao = 'REDUZIDO2') then
    begin
      if DataSet.FieldByName('NPREVENDA').AsInteger <> 0 then
        RdpDav.ImpF(linha, 1, 'Documento Auxiliar de Venda - ' + temp +
