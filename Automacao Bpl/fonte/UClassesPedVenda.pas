     TFrmCadPedVenda(FrmCadPed).DBGrid23.Columns[0].Title.Caption :=
     	vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'Cod Técnico', 'Cod Mecânico');
     TFrmCadPedVenda(FrmCadPed).DBGrid23.Columns[1].Title.Caption :=
     	vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'Técnico', 'Mecânico');

    TFrmCadPedVenda(FrmCadPed).pnMecanicoEspecifico.Parent := formulario;
