      if FDadosImpressao.ModeloImpressao = 'DETALHADO' then
      begin
        if tp = 1 then
          RdpDav.Impf(ln, 1, '+---+-----------+--------------------------------------------------------+---------+---------+----------+-------+-------+----------+', [comp17])
        else
          RdpDav.Impf(ln, 1, '|   |           |                                                        |         |         |          |       |       |          |', [comp17]);
      end
