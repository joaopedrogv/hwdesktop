function TPedVenda.apagarContasPagar(pNped: Integer; pMensagem: boolean = true): boolean;
var
 vOK: boolean;
begin
  try
    Result := true;
    vOK := true;

    if (vSing.vTipoVenda <> 'OS') then
    	exit;

    if not vDadosIni.vPedVnd.gerarContasApagar then
      exit;

    buscas.Close;
    buscas.SQL.Text := ' SELECT * FROM CONTAS_A_PAGAR ' +
      ' WHERE NPED = :NPED AND TIPO_NPED = :TIPO_NPED AND CODIGO_EMP = :CODIGO_EMP ';
    buscas.ParamByName('NPED').AsInteger := pNped;
    buscas.ParamByName('TIPO_NPED').AsString := 'OS';
    buscas.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    buscas.First;
    while not buscas.Eof do
    begin
       if trim(buscas.FieldByName('STATUS_CTP').AsString) = 'QUITADO' then
       begin
         vOK := false;
         Break;
       end;
       buscas.Next;  
    end;
    buscas.First;

    if not vOK then
    begin
      if pMensagem then      
        Application.MessageBox(Pchar('As contas a pagar referente aos serviços de terceiros desta Ordem de Serviço não serão apagadas,' +
        ' pois os mesmos se encontram quitados'), 'Atenção', MB_ICONINFORMATION + MB_OK);
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM CONTAS_A_PAGAR ' +
        ' WHERE NPED = :NPED AND TIPO_NPED = :TIPO_NPED AND CODIGO_EMP = :CODIGO_EMP ';
      buscas.ParamByName('NPED').AsInteger := pNped;
      buscas.ParamByName('TIPO_NPED').AsString := 'OS';
      buscas.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;
    end;
  except on E: Exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TPedVenda.apagarContasPagar. Erro: ' + e.Message);
    end;
  end;
end;

