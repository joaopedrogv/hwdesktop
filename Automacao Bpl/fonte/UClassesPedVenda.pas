function TPedVenda.abreFormEscolhaTipoOrcamento(pOrcamentoSoPecas, pCancelarVariosItens, pDsInsert: Boolean): Boolean;
var
  formulario: TfrmPadrao;
begin
  vSing.vOrcamentoSoPecas := pOrcamentoSoPecas;
  vSing.vCancelarVariosItens := pCancelarVariosItens;
  
  result := vSing.vOrcamentoSoPecas;
  if (getTipoVenda <> 'ORC') or pOrcamentoSoPecas then
    exit;
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption :=
      'Escolha o Tipo de Orçamento';
    TFrmCadPedVenda(FrmCadPed).pnTipoOrc.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    TFrmCadPedVenda(FrmCadPed).ComboBox4.ItemIndex := 0;
    result := (formulario.ShowModal = mrOk);
    if TFrmCadPedVenda(FrmCadPed).Combobox4.ItemIndex = 0 then
      vSing.vOrcamentoSoPecas := true
    else
      vSing.vOrcamentoSoPecas := false;
  finally
    if (not pOrcamentoSoPecas) and vSing.vOrcamentoSoPecas then
    begin
      vSing.vOrcamentoSoPecas := false;
      if pDsInsert then
        vSing.vOrcamentoSoPecas := true
      else if ExecutaComandosSql('SELECT first 1 nped FROM PEDVENDA_SERV ' +
        'WHERE  NPED = ' + dataSet.FieldByName('NPED').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) + ' and ativo=1') then
        Application.MessageBox('Existe(m) serviço(s) adicionado(s) neste orçamento.' + chr(13) +
          'O mesmo será editado no modo PEÇAS E SERVIÇOS.', 'Informação',
          MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1)
      else if ExecutaComandosSql('SELECT first 1 nped FROM PEDVENDA_PROD_TERC WHERE ' +
        ' NPED = ' + dataSet.FieldByName('NPED').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) + ' and ativo=1') then
        Application.MessageBox('Existe(m) produto(s) de terceiro(s) neste orçamento.' + chr(13) +
          'O mesmo será editado no modo PEÇAS E SERVIÇOS.', 'Informação',
          MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1)
      else if ExecutaComandosSql('SELECT * FROM PEDVENDA_SERV_TERC WHERE ' +
        ' NPED = ' + dataSet.FieldByName('NPED').AsString + ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) + ' and ativo=1') then
        Application.MessageBox('Existe(m) serviço(s) de terceiro(s) neste orçamento.' + chr(13) +
          'O mesmo será editado no modo PEÇAS E SERVIÇOS.', 'Informação',
          MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1)
      else
        vSing.vOrcamentoSoPecas := true;
    end;
    TFrmCadPedVenda(FrmCadPed).pnTipoOrc.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros;
    if Assigned(formulario) then
    	FreeAndNil(formulario);
  end;
end;

function TPedVenda.abreFormEscolhaTipoVenda: Boolean;
var
  formulario: TfrmPadrao;
begin
  if (vSing.vVendaRapida) then
  begin
    if (trim(dataSet.FieldByName('TIPV').AsString) <> '') or
      (not (dataSet.State in [dsinsert, dsEdit])) then
    begin
      Result := True;
      Exit;
    end;
    if (vSing.vTipoVenda = 'ORC') or ((vDadosIni.vPedVnd.Otimizacao.Ativa) and (vDadosIni.vPedVnd.Otimizacao.InibirMensagem.TipoDeVenda)) then
    begin
      dataSet.FieldByName('TIPV').AsString := retornaValor('select sigla AS VALOR from' +
        ' tipo_vendas where sigla= ''V'' and tipo=''REQ''');
      //se não tiver o tipo V-Varejo joga o primeiro tipo de venda requisição
      if dataSet.FieldByName('TIPV').AsString = '' then
        dataSet.FieldByName('TIPV').AsString := retornaValor('select first 1 sigla AS VALOR from' +
          ' tipo_vendas where tipo=''REQ'' and venda=''S''');
      Result := True;
      Exit;
    end;
  end;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption :=
      'Escolha de Tipo de Venda';
    TFrmCadPedVenda(FrmCadPed).pnTipoVenda.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    if dataSet.State in [dsinsert, dsEdit] then
      dataSet.FieldByName('TIPV').AsString := 'V';

    result := (formulario.ShowModal = mrOk);
    if not Result then
      if dataSet.State in [dsinsert, dsEdit] then
        dataSet.FieldByName('TIPV').AsString := '';
    verificarSalvamentoAutomatico(true);
  finally
    TFrmCadPedVenda(FrmCadPed).pnTipoVenda.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros;
    if Assigned(formulario) then
    	FreeAndNil(formulario);
  end;
end;

