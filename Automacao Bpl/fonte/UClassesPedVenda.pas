function TPedVenda.validarMarkUp_MargemMin: boolean;
var
  vratd: Real;
  valorItensLiq: Currency;
  vmarkat, vMarkUp , margem2: Double;
  vStrProcesso: string;
  vChecarMarkup:boolean;
  vHabConfUnicaMarkUp: Boolean;
  vListaMarkUp, vListaMarkUpPro: TStringList;
  I: Integer;
begin
  Result := true;

  if vItProd.dataSet.RecordCount = 0 then
    Exit;
  try

    vListaMarkUp := TStringList.Create;
//    vListaMarkUp.Sorted := True;
//    vListaMarkUp.Duplicates := dupIgnore;
    vListaMarkUp.Clear;

    vListaMarkUpPro := TStringList.Create;
    vListaMarkUpPro.Sorted := True;
    vListaMarkUpPro.Duplicates := dupIgnore;
    vListaMarkUpPro.Clear;

    vChecarMarkup:=false;
    if vDadosIni.vEmp.vUsarMarkUpMinimo then
    begin
      if vSing.vTipoVenda = 'REQ' then
        vStrProcesso := 'VND085'
      else if vSing.vTipoVenda = 'OS' then
        vStrProcesso := 'VND086'
      else vStrProcesso := 'VND191';
      vDadosIni.vInibeMensPesqPros := 'S';
      if  vDadosIni.PesqPros(vStrProcesso, 'PERMITIR DESCONTO', '', 'PEDVENDA', dataset.FieldByName('NPED').AsString, buscas, true) then
        vChecarMarkup:=true;
    end;

    vDadosIni.vInibeMensPesqPros := 'S';
    vHabConfUnicaMarkUp := vDadosIni.PesqPros('VND203', 'HABILITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
      dataset.FieldByName('NPED').AsString, buscas, true);

    if not vHabConfUnicaMarkUp then
    begin
      if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
        vHabConfUnicaMarkUp :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
           ' where tipo=''OS'' and tipo_os = ' + QuotedStr(trim(dataSet.FieldByName('tipo_os').AsString))) = 'S', true, false)
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
        vHabConfUnicaMarkUp :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
          ' where tipo=''ORC'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipo_orc').AsString))) = 'S', true, false)
      else
        vHabConfUnicaMarkUp :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
          ' where tipo=''REQ'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipv').AsString))) = 'S', true, false);
    end;

    if not vChecarMarkup and not(vDadosIni.vEmp.vUsarMargemMinProd = 'S') then
      exit;

//    if vSing.vTipoVenda = 'ORC' then
//      exit;
    if vSing.vTipoVenda='REQ' then
      vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPV').AsString)
    else if vSing.vTipoVenda='OS' then
      vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPO_OS').AsString)
    else
    	vItProd.FUsarPrecoCustoTipoVND := (f_str('tipo') = 'ORC') and
                                           (vDadosIni.vLocacao.vHabilitarLoc) and
                                           (vDadosIni.vLocacao.TipoOrcCusto = f_str('tipo_orc')) and
                                           (vDadosIni.vLocacao.ClienteOrcCusto = f_str('cod_cliente'));
    _setaVariaveisTipoVendas; //seta   vMinMarkUp e vMinMargemLiq;
    valorItensLiq := vItProd.getValorItensLiquido;
    vItProd.dataSet.DisableControls;
    vItProd.dataSet.first;
    while not vItProd.dataSet.eof do
    begin
      vItProd.vProduto.buscaProduto(
      	vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
        vItProd.dataSet.FieldByName('cod_prod').AsString);
      if (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S')
      	or (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P')
        or (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'T')
        or (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q')
        or (trim(vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO')
        or (vItProd.FUsarPrecoCustoTipoVND) then
      begin
        vItProd.dataSet.next;
        Continue;
      end;
      if dataSet.FieldByName('TIPV').AsString = 'V' then
      begin
          if (vItProd.vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat > 0) then
            vMarkUp := vItProd.vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat
          else
            vMarkUp := vMinMarkUp;
          margem2 := vMinMargemLiq;
      end
      else if dataSet.FieldByName('TIPV').AsString = 'A' then
      begin
        if (vItProd.vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat > 0) then
          vMarkUp := vItProd.vProduto.dataSet.FieldByName('PERC_TB_PRODA').AsFloat
        else
          vMarkUp := vMinMarkUp;
        margem2 := vMinMargemLiq;
      end else begin
        vMarkUp := vMinMarkUp;
        margem2 := vMinMargemLiq;
      end;
      if vChecarMarkup and (vMarkUp > 0) then
      begin
        vDadosIni.abreStatusProcessamento('', 'Verificando Mark up por item no Fechamento da Venda');
        if vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency <> 0 then
          vmarkat := ((vItProd.getValorLiqParaMargem - vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency) / vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency) * 100;
        // Foi adicionado a formatação de casas decimais para evitar divergencias de valores, caso ocorrer novamente verificar a possibilidade de adicionar uma vMakUp de erro neste teste
        if vDadosIni.StrToFloatFormat((vItProd.getValorLiqParaMargem),2) <
          vDadosIni.StrToFloatFormat((vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency +
          ((vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency *
            (vMarkUp - vDadosIni.vEmp.vVndToleranciaMarkUp)) / 100)),2) then
        begin
          if vHabConfUnicaMarkUp then
          begin
            if (vListaMarkUp.Count = 20) then
            	vListaMarkUp.Add('...')
            else if (vListaMarkUp.Count < 20) then
               vListaMarkUp.Add(
                 vDadosIni.StrZero(vItProd.dataSet.FieldByName('nitem').AsInteger, 3) + ' - ' +
                 vDadosIni.Space(Trim(vItProd.dataSet.FieldByName('num_fab_prod').AsString), 20) + ' - ' +
                 Trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString));
            if (vListaMarkUp.Count = 20) then
               vListaMarkUp.Add('...')
            else if (vListaMarkUp.Count < 20) then
               vListaMarkUp.Add( '  Produto: ' + format('%n', [vmarkat]) + '% ' +
                 ' - Estabelecido: ' + format('%n', [vMarkUp]) + '%');
            if (vListaMarkUpPro.Count = 20) then
              vListaMarkUpPro.Add(Trim(vItProd.dataSet.FieldByName('num_fab_prod').AsString) +'-'+
                dataSet.FieldByName('NPED').asstring + ' MARG.: ' +
                  format('%n', [(((vItProd.getValorLiqParaMargem) * 100) / vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency)]) + ' % ...')
            else
              vListaMarkUpPro.Add(Trim(vItProd.dataSet.FieldByName('num_fab_prod').AsString) +'-'+
                dataSet.FieldByName('NPED').asstring + ' MARG.: ' +
                  format('%n', [(((vItProd.getValorLiqParaMargem) * 100) / vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency)]) + ' %');
          end
          else
          begin
            vDadosIni.fechaStatusProcessamento;
            Application.MessageBox(pchar('Mark up do produto(' + format('%n', [vmarkat]) + ') ' +
                trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').asstring) +
                '   Menor que Mark up estabelecido ' + format('%n', [vMarkUp]) + '%'), 'Informação',
            MB_ICONINFORMATION + MB_OK);
            if not vDadosIni.PesqPros('VND047', 'LIBERAR', dataSet.FieldByName('TIPO').asstring + ' - MARG.: ' +
              format('%n', [(((vItProd.getValorLiqParaMargem) * 100) / vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency)]) + ' %',
              'PEDVENDA', dataSet.FieldByName('NPED').asstring, buscas, true) then
            begin
              result := false;
              Exit;
            end;
            vDadosIni.GravaAuditoria('VND047', 'LIBERAR', 'PROC: HW LIB VENDA: - ' + vSing.vTipoVenda + ': ' +
              vCliente.dataSet.FieldByName('nome_cliente').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').asstring, buscas);
            if Application.MessageBox(pchar('Deseja continuar a venda?'), 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDNO then
            begin
              Result := false;
              Exit;
            end;
          end;
        end;
      end;

      if vDadosIni.vEmp.vUsarMargemMinProd = 'S' then
      begin
        vItProd.definirMargemProduto(dataSet.FieldByName('TIPV').AsString);
        if not vItProd.CalcCustLiq(vItProd.vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString,
          dataSet.FieldByName('TIPV').AsString,
          vItProd.getValorLiqParaMargem ,
          vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency, margem2) then
        begin
          Result := false;
          Exit;
        end;
      end;
      vItProd.dataSet.next;
    end;
    if vHabConfUnicaMarkUp and (vListaMarkUp.Count > 0) then
    begin
      Application.MessageBox(pchar('Mark up do(s) produto(s) menor que Mark up estabelecido' + #13 + #13 +
        vListaMarkUp.Text), 'Informação',
        MB_ICONINFORMATION + MB_OK);
      if not vDadosIni.PesqPros('VND047', 'LIBERAR', 'LOTE ' + dataSet.FieldByName('TIPO').asstring, 'PEDVENDA',
      	dataSet.FieldByName('NPED').asstring, buscas, true, True) then
      begin
        result := false;
        Exit;
      end;
      for I := 0 to vListaMarkUpPro.Count - 1 do
        vDadosIni.GravaAuditoria('VND047', 'LIBERADO', dataSet.FieldByName('tipo').asstring + ' ' + vListaMarkUpPro[I], 'PEDVENDA',
        	dataSet.FieldByName('NPED').asstring,buscas);

      vDadosIni.GravaAuditoria('VND047', 'LIBERADO', 'PROC: HW LIB VENDA: - ' + vSing.vTipoVenda + ': ' +
        vCliente.dataSet.FieldByName('nome_cliente').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').asstring, buscas);
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
    if Assigned(vListaMarkUp) then
    	FreeAndNil(vListaMarkUp);
    if Assigned(vListaMarkUpPro) then
      FreeAndNil(vListaMarkUpPro);
    vItProd.dataSet.EnableControls;
  end;
end;

function TPedVenda.desmarcarDAVsParaMesclagem: boolean;
begin
	if Assigned(dtSetOrcTemp) then
  begin
    dtSetOrcTemp.Close;
    dtSetOrcTemp.CommandText := ' select ' + Fsql_campos + ' from pedvenda ' + Fsql_inner +
      ' where pedvenda.nped = 0 ' +
      ' and pedvenda.tipo = ' + QuotedStr('') +
      ' and pedvenda.cod_empresa = 0 ' +
      ' and pedvenda.ativo = 1 ';
    dtSetOrcTemp.Open;

    if dtSetOrcTemp.Filtered then
      dtSetOrcTemp.Filtered := False;
    if not dtSetOrcTemp.IsEmpty then
      dtSetOrcTemp.EmptyDataSet;
  end;

  if Assigned(vItProd.dtSetIt) then
  begin
    if vItProd.dtSetIt.Filtered then
      vItProd.dtSetIt.Filtered := False;
    if not vItProd.dtSetIt.IsEmpty then
      vItProd.dtSetIt.EmptyDataSet;
  end;

  if Assigned(vItServ.dtSetIt) then
  begin
    if vItServ.dtSetIt.Filtered then
      vItServ.dtSetIt.Filtered := False;
    if not vItServ.dtSetIt.IsEmpty then
      vItServ.dtSetIt.EmptyDataSet;
  end;

  if Assigned(vItServTerc.dtSetIt) then
  begin
    if vItServTerc.dtSetIt.Filtered then
      vItServTerc.dtSetIt.Filtered := False;
    if not vItServTerc.dtSetIt.IsEmpty then
      vItServTerc.dtSetIt.EmptyDataSet;
  end;

  if Assigned(vItProdTerc.dtSetIt) then
  begin
    if vItProdTerc.dtSetIt.Filtered then
      vItProdTerc.dtSetIt.Filtered := False;
    if not vItProdTerc.dtSetIt.IsEmpty then
      vItProdTerc.dtSetIt.EmptyDataSet;
  end;
end;

function TPedVenda.desselecionaDAVsParaMesclagem(pNPED: integer; pTipo: string;
  pDesselecionaTodos: boolean): boolean;
begin
  result := false;
  if dtSetOrcTemp.IsEmpty then
    exit;
  if pDesselecionaTodos then
  begin
    dtSetOrcTemp.EmptyDataSet;
    vItProd.dtSetIt.EmptyDataSet;
    vItServ.dtSetIt.EmptyDataSet;
    vItServTerc.dtSetIt.EmptyDataSet;
    vItProdTerc.dtSetIt.EmptyDataSet;
  end
  else
  begin
    vItProd.dtSetIt.Close;
    vItProd.dtSetIt.Filtered := false;
    vItProd.dtSetIt.Open;
    while vItProd.dtSetIt.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([pNPED, trim(pTipo), strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) do
      vItProd.dtSetIt.Delete;

    vItServ.dtSetIt.Close;
    vItServ.dtSetIt.Filtered := false;
    vItServ.dtSetIt.Open;
    while vItServ.dtSetIt.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([pNPED, trim(pTipo), strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) do
      vItServ.dtSetIt.Delete;

    vItServTerc.dtSetIt.Close;
    vItServTerc.dtSetIt.Filtered := false;
    vItServTerc.dtSetIt.Open;
    while vItServTerc.dtSetIt.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([pNPED, trim(pTipo), strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) do
      vItServTerc.dtSetIt.Delete;

    vItProdTerc.dtSetIt.Close;
    vItProdTerc.dtSetIt.Filtered := false;
    vItProdTerc.dtSetIt.Open;
    while vItProdTerc.dtSetIt.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([pNPED, trim(pTipo), strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) do
      vItProdTerc.dtSetIt.Delete;

    dtSetOrcTemp.Delete;
  end;
  result := true;
end;

