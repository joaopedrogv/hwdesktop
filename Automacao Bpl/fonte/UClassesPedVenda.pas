procedure TClientesPed.gravaTipoCliente(pTipoCliente, pTipo: string);
var
  vDtaTemp: TDate;
  //var
  vTipoCli: string;
begin
  try
    //    vTipoCliente := Trim(tipo);
    pTipoCliente := Trim(pTipoCliente);
    if trim(pTipo) = 'ORC' then
      exit
    else if trim(pTipo) = 'REQ' then
    begin
      if trim(pTipoCliente) = '' then
        pTipoCliente := 'P'
      else if (pos('P', pTipoCliente) = 0) then
        pTipoCliente := pTipoCliente + 'P|';
    end
    else if trim(pTipo) = 'OS' then
    begin
      if trim(pTipoCliente) = '' then
        pTipoCliente := 'S'
      else if (pos('S', pTipoCliente) = 0) then
        pTipoCliente := pTipoCliente + '|S';
    end;

    vDtaTemp := vDadosIni.getDataBanco(buscas);

    if (pos('P', pTipoCliente) > 0) and (pos('V', pTipoCliente) > 0) and (pos('S', pTipoCliente) > 0) then
      vTipoCli := 'P|V|S'
    else if (pos('P', pTipoCliente) > 0) and (pos('V', pTipoCliente) > 0) then
      vTipoCli := 'P|V'
    else if (pos('P', pTipoCliente) > 0) and (pos('S', pTipoCliente) > 0) then
      vTipoCli := 'P|S'
    else if (pos('V', pTipoCliente) > 0) and (pos('S', pTipoCliente) > 0) then
      vTipoCli := 'V|S'
    else if (pos('P', pTipoCliente) > 0) then
      vTipoCli:='P'
    else if (pos('V', pTipoCliente) > 0) then
      vTipoCli:='V'
    else if (pos('S', pTipoCliente) > 0) then
      vTipoCli:='S'
    else vTipoCli := '';

    buscas.Close;
    buscas.SQL.Text := 'update clientes set tipocliente = ' + QuotedStr(vTipoCli) + ',' +
      ' data_ult_compra = :data where cod_cliente = ' + dataset.FieldByName('cod_cliente').AsString +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.ParamByName('data').AsDate := vDtaTemp;
    buscas.Prepare;
    buscas.ExecSQL;
  except
    on e: exception do
    begin
      Application.MessageBox(pchar('Erro ao gravar dados da venda no cliente: ' + #13 + 'Erro: ' +
        e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

