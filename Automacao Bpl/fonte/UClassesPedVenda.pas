procedure TSituacaoDosPedidos.pesquisa(pDataIni, pDataFim: string; pApenasAbertos, pRazaoSocial: Boolean);
var
  vSql: string;
begin
  vSql := 'select' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''PEDIDO'' order by data_e_hora desc) as "Pedido",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FINANCEIRO'' order by data_e_hora desc) as "Financeiro",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''SEPARACAO'' order by data_e_hora desc) as "Separacao",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FATURAMENTO'' order by data_e_hora desc) as "Faturamento",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''EXPEDICAO'' order by data_e_hora desc) as "Expedicao",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''SAIDA'' order by data_e_hora desc) as "Saida",' +
    ' (select first 1 status_situacao from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''ACERTO'' order by data_e_hora desc) as "Acerto",' +
    ' p.cod_carga, p.nped, p.data_ped, c.nome_cliente, c.razao, p.valor_total,' +
    ' c.usar_liberacao_financeiro lib_fin_cl, tv.usar_liberacao_financeiro lib_fin_tv,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''PEDIDO'' and status_situacao = ''Iniciado'' order by data_e_hora) as PED_INI,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''PEDIDO'' and status_situacao = ''Finalizado'' order by data_e_hora) as PED_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''PEDIDO'' and status_situacao = ''Nao Autorizado'' order by data_e_hora) as PED_NAO,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FINANCEIRO'' and status_situacao = ''Finalizado'' order by data_e_hora) as FIN_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FINANCEIRO'' and status_situacao = ''Nao Autorizado'' order by data_e_hora) as FIN_NAO,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''SEPARACAO'' and status_situacao = ''Iniciado'' order by data_e_hora) as SEP_INI,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''SEPARACAO'' and status_situacao = ''Finalizado'' order by data_e_hora) as SEP_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FATURAMENTO'' and status_situacao = ''Iniciado'' order by data_e_hora) as FAT_INI,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''FATURAMENTO'' and status_situacao = ''Finalizado'' order by data_e_hora) as FAT_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''EXPEDICAO'' and status_situacao = ''Iniciado'' order by data_e_hora) as EXP_INI,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''EXPEDICAO'' and status_situacao = ''Finalizado'' order by data_e_hora) as EXP_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''SAIDA'' and status_situacao = ''Finalizado'' order by data_e_hora) as SAI_FIN,' +
    ' (select first 1 ocorrencias_os.data_e_hora from ocorrencias_os where nped = p.nped and tipo = p.tipo and cod_empresa = p.cod_empresa and situacao = ''ACERTO'' and status_situacao = ''Finalizado'' order by data_e_hora) as ACE_FIN' +
    ' from pedvenda p' +
    ' inner join clientes c on c.cod_cliente = p.cod_cliente and c.cod_empresa = p.cod_empresa' +
    ' left join tipo_vendas tv on tv.tipo = p.tipo and tv.sigla = p.tipv' +
    ' where p.data_ped >= :dataIni and p.data_ped <= :dataFim and p.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and p.tipo = ''REQ''';

  if pApenasAbertos then
    vSql := vSql + ' and p.data_fech is null';

  if pRazaoSocial then
    vSql := vSql + ' order by c.razao, p.nped'
  else
    vSql := vSql + ' order by c.nome_cliente, p.nped';

  montaSelect(vSql , StrToDate(pDataIni), StrToDate(pDataFim));

end;

