  procedure DefinirTotais;
  var
    ControlsDisabled: Boolean;
  begin
    dadosImp.nAcrescimo     := vSing.vValorAcrescimo;
    dadosImp.nDesconto      := vSing.vValorDesconto;
    dadosImp.nTotBruto      := vSing.vValorTotalBruto;
    dadosImp.nTotLiquido    := vSing.vValorTotalLiq;
    dadosImp.nTotProd       := dataSet.FieldByName('tot_prod').AsFloat;
    dadosImp.nTotServ       := dataSet.FieldByName('tot_serv').AsFloat;
    dadosImp.nQtdeItensCanc := 0;
    dadosImp.nQtdeItens     := vItProd.DataSet.RecordCount;
    if vSing.vTipoVenda <> 'REQ' then
    begin
      dadosImp.nQtdeItens   := dadosImp.nQtdeItens +
        vItServ.dataSet.RecordCount + vItServTerc.dataSet.RecordCount + vItProdTerc.dataSet.RecordCount;
    end;

    ControlsDisabled := vItProd.dataSet.ControlsDisabled;
    try
      vItProd.dataSet.DisableControls;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        dadosImp.nQtdeItensCanc := dadosImp.nQtdeItensCanc + vDadosIni.IfThen(
          Trim(vItProd.dataSet.FieldByName('status').AsString) = 'CANCELADO', 1, 0);
        vItProd.dataSet.Next;
      end;
    finally
      if ControlsDisabled <> vItProd.dataSet.ControlsDisabled then
        if vItProd.dataSet.ControlsDisabled then
          vItProd.dataSet.EnableControls
        else
          vItProd.dataSet.DisableControls;
    end;
    if vSing.vTipoVenda <> 'REQ' then
    begin
      ControlsDisabled := vItServ.dataSet.ControlsDisabled;
      try
        vItServ.dataSet.DisableControls;
        vItServ.dataSet.First;
        while not vItServ.dataSet.Eof do
        begin
          dadosImp.nQtdeItensCanc := dadosImp.nQtdeItensCanc + vDadosIni.IfThen(
            Trim(vItServ.dataSet.FieldByName('status').AsString) = 'CANCELADO', 1, 0);
          vItServ.dataSet.Next;
        end;
      finally
        if ControlsDisabled <> vItServ.dataSet.ControlsDisabled then
          if vItServ.dataSet.ControlsDisabled then
            vItServ.dataSet.EnableControls
          else
            vItServ.dataSet.DisableControls;
      end;

      vItProdTerc.dataSet.First;
      while not vItProdTerc.dataSet.Eof do
      begin
        dadosImp.nTotProd := dadosImp.nTotProd + vItProdTerc.dataSet.FieldByName('VL_TOTAL').AsFloat;
        vItProdTerc.dataSet.Next;
      end;

      vItServTerc.dataSet.First;
      while not vItServTerc.dataSet.Eof do
      begin
        dadosImp.nTotServ := dadosImp.nTotServ + vItServTerc.dataSet.FieldByName('VL_SERVT').AsFloat;
        vItServTerc.dataSet.Next;
      end;
    end;
  end;

  function GetField(var FieldFormat: string): Boolean;
