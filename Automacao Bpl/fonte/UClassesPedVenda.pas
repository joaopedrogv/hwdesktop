//        if not vDadosIni.PesqPros('VND088', 'LIBERAR', dataSet.FieldByName('TIPO').asstring, 'PEDVENDA', dataSet.FieldByName('NPED').asstring, buscas, true) then
//          exit;
//        if Application.MessageBox(pchar('Deseja continuar a reabrir a venda?'), 'Confirmação',
//          MB_ICONQUESTION + MB_YESNO) = IDNO then
          Exit;
      end;

      if cargaFechada then
      begin
        Application.MessageBox('Carga fechada! Não é permitido fazer qualquer alteração no pedido', 'Atenção', 0 + 64);
        Exit;
      end;

      if vDadosIni.vEmp.vOC_AlterarPedComOCFech = 'N' then
        if vendaEmOrdemDeCarregamento then
        begin
          Application.MessageBox('Pedido está vinculado a uma Ordem de Carregamento! Não é permitido fazer qualquer alteração no pedido', 'Atenção', 0 + 64);
          Exit;
        end;

      if retornaValor('SELECT N_NF as valor FROM pedvenda_prod ' +
        ' WHERE nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' AND TIPO = ' + QuotedStr(vSing.vTipoVenda) +
        ' AND COD_EMPRESA = ' + vDadosIni.CodEmpresa +
        ' AND (N_NF <> 0 OR (N_NF IS NOT NULL))') <> '' then
        if (vSing.vTipoVenda = 'REQ') then
          raise Exception.create('Requisição com nota fiscal emitida. Abertura não permitida')
        else if vSing.vTipoVenda = 'OS' then
          raise Exception.create('Ordem de serviço com nota fiscal emitida. Abertura não permitida');
      {
      if vSing.vTipoVenda = 'OS' then
        if retornaValor('SELECT N_NF as valor FROM pedvenda_serv WHERE nped = ' +
          dataSet.FieldByName('nped').AsString + ' AND COD_EMPRESA = ' + vDadosIni.CodEmpresa +
          ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
          ' AND (N_NF <> 0 OR (N_NF IS NOT NULL))') <> '' then
        begin
          if (pCancelar) and (dataSet.FieldByName('TOT_SERV').AsFloat > 0) then
          begin
            if Application.MessageBox(pchar('Ordem de serviço com nota fiscal de serviço emitida, deseja continuar assim mesmo?'),
              'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
              raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Abertura não permitida');

            if not vDadosIni.PesqPros('VND245', 'PERMITIR', vSing.vTipoVenda + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger),
            	'PEDVENDA', '', buscas, True) then
              raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Abertura não permitida');
          end
          else if dataSet.FieldByName('TOT_SERV').AsFloat > 0 then
            raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Abertura não permitida');
        end;
      }
      if fequals('tipo', 'OS') then
        with Container.GetInstance().ErpFeaturesFactory.CreateObterSituacaoEmissaoNFSeDeOrdemServUseCase()
          .Executar(fint('nped')) do
        begin
          if ComNotaEdicao then
            raise Exception.create(
              'Existe uma NFSe em edição e/ou emissão para essa Ordem de serviço.' +
              'Resolva essa pendência e depois repita a operação'
            );

          if ComNotaEmitida then
            if not pCancelar
              or (ShowCustomDlg.Question(
                'Ordem de serviço com NFSe emitida. Deseja continuar mesmo assim?', brNone
              ) <> mrYes)
              or not Auditor.Processo('VND245', fstr('tipo') + ' ' + fstr('nped'), fstr('tipo') + ' ' + fstr('nped'))
                .Validar.Permitido() then
              raise Exception.create('Ordem de serviço com NFSe emitida. Abertura não permitida');
        end;

//      if (vDadosIni.vEmp.vModoFaturamento <> 'S') or (vDadosIni.vPedVnd.ReceberPeloFinanceiro) then
    	if retornaValor(' select cxl as valor from pedvenda ' +
      		' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
          ' and cod_empresa = ' + vDadosIni.CodEmpresa) <> 'S' then
      begin
        if ExecutaComandosSql(' select first 1 SEQFORM FROM FORMPAGAMENTO ' +
        	' where nrequisicao = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tpdocs = ' + QuotedStr(vSing.vTipoVenda) +
          ' and cod_empresa = ' + vDadosIni.CodEmpresa) then
        begin
          Application.MessageBox('Venda com Forma de Pagamento. ' + #13 + #13 +
          	 'É necessário cancelar as formas para reabrir!', 'Atenção', MB_OK + MB_ICONINFORMATION);

          if not vDadosIni.PesqPros('FPG023', 'CANCELAR', '', 'FORMPAGAMENTO', '', buscas, True, True) then
            Exit;

          obFp := TFormPag2.create;
          try
            if not obFp.cancelaVenda(dataSet.FieldByName('NPED').AsInteger, vSing.vTipoVenda, '', True) then
              Exit
            else
              Application.MessageBox('Forma de Pagamento Cancelada', 'Atenção', 0 + 64);
          finally
            obFp.Free;
            obFp := nil;
          end;
        end;
      end
      else
      begin
      	if ExecutaComandosSql(' select first 1 seqform from formpagamento ' +
        	' where nrequisicao = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tpdocs = ' + QuotedStr(vSing.vTipoVenda) +
          ' and cod_empresa = ' + vDadosIni.CodEmpresa) then
        begin
          Application.MessageBox('Venda com Forma de Pagamento realizada no Caixa Auxiliar. ' + #13 + #13 +
          	'É necessário cancelar as formas para reabrir!', 'Atenção', MB_OK + MB_ICONINFORMATION);

          if not vDadosIni.PesqPros('FPG023', 'CANCELAR', '', 'FORMPAGAMENTO', '', buscas, True, True) then
            Exit;

          obFp := TFormPag2.create;
          try
            if not obFp.cancelaVenda(dataSet.FieldByName('NPED').AsInteger, vSing.vTipoVenda, '', True, True) then
              Exit
            else
              Application.MessageBox('Forma de Pagamento Cancelada', 'Atenção', 0 + 64);
          finally
            obFp.Free;
            obFp := nil;
          end;
        end;
      end;

      if Trim(dataSet.FieldByName('tipo').AsString) = 'REQ' then
      begin

        // Voltando o valor do rateio no desconto a vista concedido pelo caixa auxiliar caso o desconto ja tenha sido aplicado
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_prod set' +
          ' rateio_desc = (coalesce(rateio_desc, 0) - (coalesce(rat_desc_avista, 0))),' +
          ' rat_desc_avista = 0,' +
          ' refazer_comiss = ''S'' ' +
          ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tipo = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and coalesce(status, '''') = ''''' +
          ' and coalesce(rat_desc_avista, 0) > 0';
        buscas.ExecSQL;

        // Recalculando o valor da comissao nos itens da venda
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_prod pp set' +
          ' pp.COMISS_PROD = ((coalesce(pp.vltot_ped_item, 0) + coalesce(pp.rateio_acresc, 0) - coalesce(pp.rateio_desc, 0)) *' +
          ' coalesce((select p.comissao_prod from produtos p' +
          ' where p.grupo_prod = pp.grupo_prod and p.cod_prod = pp.cod_prod and p.cod_empresa = pp.cod_empresa), 0) / 100 ),' +
          ' pp.comiss_prod_ger = ((coalesce(pp.vltot_ped_item, 0) + coalesce(pp.rateio_acresc, 0) - coalesce(pp.rateio_desc, 0)) *' +
          ' coalesce((select p.comissao_prod_ger from produtos p' +
          ' where p.grupo_prod = pp.grupo_prod and p.cod_prod = pp.cod_prod and p.cod_empresa = pp.cod_empresa), 0) / 100 ),' +
          ' refazer_comiss = ''N'' ' +
          ' where pp.nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and pp.tipo = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
          ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and coalesce(pp.status, '''') = '''' and refazer_comiss = ''S''';
        buscas.ExecSQL;

        // Aplicando o valor do desconto e alterando o valor total na requisicao
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda set' +
          ' desconto = (coalesce(desconto, 0 ) - coalesce(valor_desc_avista,0) ),' +
          ' valor_total = (valor_total + coalesce(valor_desc_avista, 0)),' +
          ' valor_desc_avista = 0' +
          ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tipo = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and coalesce(valor_desc_avista,0) > 0';
        buscas.ExecSQL;
      end;

      if (Trim(dataSet.FieldByName('tipo').AsString) = 'OS') or (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') then
        vDadosIni.informarSituacaoPedido(
          dataSet.FieldByName('nped').AsInteger, Trim(dataSet.FieldByName('tipo').AsString),
          'PEDIDO',
          'Finalizado',
          '',
          buscas, False, False, True);

      CommitaTransacao;
      IniciaTransacao;
      vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
      vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
      VoltaEstoque;
      VoltaEstoqueEquipamentoNSerie;
      if not vItProd.vGrade.removerGradeVenda(vItProd) then
      begin
        Application.MessageBox(pchar('Erro ao remover produto Grupo: ' + vItProd.dataSet.FieldByName('grupo_prod').AsString + '-' +
          'Código: ' + trim(vItProd.dataSet.FieldByName('cod_prod').AsString) + '-' +
          'Grade: ' + vItProd.dataSet.FieldByName('cod_grade').AsString + ' da grade de venda.' + chr(13) +
          'O documento não poderá ser reaberto.'), 'Erro', MB_OK + MB_ICONWARNING);
        RollBackTransacao;
        Result := false;
        exit;
      end;
//      if dataSet.FieldByName('tipv').AsString = 'P' then
//        diminuiEstoque;
      {buscas.Close;
      buscas.SQL.Text := ('DELETE FROM FORMPAGAMENTO WHERE TPDOCS = ' +
        QuotedStr(vSing.vTipoVenda) + ' and cod_empresa = ' + vDadosIni.CodEmpresa +
        ' and ativo=1 AND NREQUISICAO = ' + dataSet.FieldByName('nped').AsString);
      buscas.ExecSQL;

      buscas.Close;
      buscas.SQL.Text := ('DELETE FROM FORMPAGAMENTO WHERE REC_TIPVEND = ' +
        QuotedStr(vSing.vTipoVenda) + ' and cod_empresa = ' + vDadosIni.CodEmpresa +
        ' and ativo=1 AND REC_NUMVEND = ' + dataSet.FieldByName('nped').AsString);
      buscas.ExecSQL;}

      if (vDadosIni.vEmp.vOC_UsarOrdemCarregamento = 'D') and (vDadosIni.vEmp.vOC_TipoControleOrdemC = 'REQ')
        and (dataSet.FieldByName('cod_carga').AsInteger > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select cod_carga from carga' +
          ' where cod_carga = ' + IntToStr(dataSet.FieldByName('cod_carga').AsInteger) +
          ' and status <> ''FECHADA''' +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;
        if not buscas.IsEmpty then
        begin
          buscas.Close;
          buscas.SQL.Text := 'delete from carga_item' +
            ' where cod_carga = ' + IntToStr(dataSet.FieldByName('cod_carga').AsInteger) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSQL;
        end;
      end;

      qrHelp := QueryHelper.CreateObj(buscas)
        .Open('select result, msg from SP_PEDVENDA_PLANO_REVERTER(%d, %s, %d)',
                 [fint('nped'), fstrq('tipo'), vDadosIni.cod_empresa]);

      if qrHelp.fequals('result', '1') and qrHelp.fequals('msg', 'REVERTIDO') then
        dataSet.Refresh;

      dataSet.Edit;


      // Atualizar Lembrete Agenda Oficina
      atualizarLembreteAgenda(dataSet.FieldByName('nped').AsInteger, 'ABERTA');
      //Grava histórico do veículo
      GravarHistEstMoto('ABERTA');
      //Apagar contas a pagar
      apagarContasPagar(dataSet.FieldByName('nped').AsInteger);


      if (vDadosIni.vUsarPlano = 'S') or (vDadosIni.vUsarPlano = '2') then
      begin
        if str_empty('nf_ac_calctrib') then
          dataSet.FieldByName('acrescimo').AsFloat := 0;
        {
        else
        begin
          dataSet.FieldByName('acrescimo').AsFloat := ffloat('acrescimo') - ffloat('nf_ac_outras');
          dataSet.FieldByName('nf_ac_outras').AsFloat := 0;
        end;
        }
      end;
      calculaTotais;
      efetuaRateios(true);
      vItProd.Apply;
      calculaDescontoAcrescimo;
      dataSet.FieldByName('cod_us_fech').Value := Null;
      dataSet.FieldByName('status_ped').AsString := '';
      dataSet.FieldByName('data_fech').AsString := '';
      dataSet.FieldByName('reaberto').AsString := 'S';
      dataSet.FieldByName('regras_descontos').Value := Null;
      //Voltando para aparecer no caixa auxiliar
      //if not pConfirmacao then // Cancelamento
      //if pConfirmacao then     // Reabertura
      if pConfirmacao then     // Reabertura
      begin
        dataSet.FieldByName('DIA_CXL').Value := null;
        dataSet.FieldByName('STATUS_CXL_RQ').value := null;
        dataset.FieldByName('OP_CXL').value := null;
        dataset.FieldByName('VL_PAGO_CXL').value := 0;
      end;
      dataSet.Post;
      result := Apply;
      if result then
      begin
        // Atualizar pontos programa de fidelidade (requisição/ordem de serviço - tipo regaste/troca)
        if ((dataSet.FieldByName('VALE_TROCA').AsString = 'S') or (vvaleregaste = 'S')) then
        begin
          if not vDadosIni.setarPontosProgFidelidade(dataSet.FieldByName('nped').AsInteger,
           dataSet.FieldByName('tipo').AsString, buscas, false, 0, '', false, true,
           dataSet.FieldByName('VALE_TROCA').AsString = 'S',
           vvaleregaste = 'S') then
          begin
            RollBackTransacao;
            Result := false;
            exit;
          end;
        end;

        result := CommitaTransacao;
        if Result then
          vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);
      end
      else
        RollBackTransacao;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
    if trim(comandoTexto) <> '' then
      montaSelect(comandoTexto);
    if result then
      vDadosIni.GravaAuditoria('VND062', 'REABRIR SUCESSO', 'REABERTO DOC ' + getTipoVenda + ' Nº ' +
        dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('VND062', 'REABRIR FALHA', 'DOC ' + getTipoVenda + ' Nº ' +
        dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
  end;
end;

function TPedVenda.reabrirVenda(pNPED: integer; pTipo: string): boolean;
begin
  Result := false;
  try
    try
      vSing.vTipoVenda := trim(pTipo);
      LerVariaveisOtimizacao;
      abrePedVenda(pNPED);
      CommitaTransacao;
      IniciaTransacao;
      vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
      vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
      VoltaEstoque;
      VoltaEstoqueEquipamentoNSerie;
      if not vItProd.vGrade.removerGradeVenda(vItProd) then
      begin
        Application.MessageBox(pchar('Erro ao remover produto Grupo: ' + vItProd.dataSet.FieldByName('grupo_prod').AsString + '-' +
          'Código: ' + trim(vItProd.dataSet.FieldByName('cod_prod').AsString) + '-' +
          'Grade: ' + vItProd.dataSet.FieldByName('cod_grade').AsString + ' da grade de venda.' + chr(13) +
          'O documento não poderá ser reaberto.'), 'Erro', MB_OK + MB_ICONWARNING);
        RollBackTransacao;
        Result := false;
        exit;
      end;
//      if dataSet.FieldByName('tipv').AsString = 'P' then
//        diminuiEstoque;
      dataSet.Edit;
      if (vdescMesc <> 0) or (vAcresMesc <> 0) then
      begin
        dataSet.FieldByName('DESCONTO').AsCurrency := vdescMesc;
        dataSet.FieldByName('ACRESCIMO').AsCurrency := vAcresMesc;
      end;
      if (vDadosIni.vUsarPlano = 'S') and (vDadosIni.vUsarPlano = '2') then
        dataSet.FieldByName('acrescimo').AsFloat := 0;
      calculaTotais;
      efetuaRateios;
      calculaDescontoAcrescimo;
      dataSet.FieldByName('cod_us_fech').Value := Null;
      dataSet.FieldByName('status_ped').AsString := '';
      dataSet.FieldByName('data_fech').AsString := '';
      dataSet.FieldByName('reaberto').AsString := 'S';
      dataSet.FieldByName('regras_descontos').Value := Null;
      dataSet.Post;
      result := Apply;
      if result then
      begin
        result := CommitaTransacao;
        if Result then
          vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);
      end;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
    if result then
      vDadosIni.GravaAuditoria('VND062', 'REABRIR SUCESSO', 'REABERTO DOC ' + getTipoVenda + ' Nº ' +
        dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('VND062', 'REABRIR FALHA', 'DOC ' + getTipoVenda + ' Nº ' +
        dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
  end;
end;

function TPedVenda.recalcularMesclagem(pNped: Integer; pTipo: string): Boolean;
begin
	try
  	Result := True;
    
    montaSelect('select ' + Fsql_campos + ' from pedvenda ' + Fsql_inner +
      ' where pedvenda.COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' and pedvenda.nped = ' + IntToStr(pNped) +
      ' and pedvenda.tipo = ' + QuotedStr(pTipo) +
      ' and pedvenda.ativo=1');
    Edit;
    if (vDadosIni.vUsarPlano = 'S') or (vDadosIni.vUsarPlano = '2') then
      dataSet.FieldByName('acrescimo').AsFloat := 0;
    calculaTotais;
    calcularComissaoPorVenda;
    efetuaRateios;
    calculaDescontoAcrescimo;
    dataSet.Post;
    Apply;
    CommitaTransacao;
    pedidoEmEdicao(caRemoverEdicao, False);
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.recalcularPrecoItensPelaCondicaoPagamento: boolean;
var
	Valor_acrescitemTemp, Valor_descItemtemp: currency;
  Perc_acrescitemTemp, Perc_descItemtemp: Double;
  Avalor_total: Double;
  vExibirDesconto: string;
begin
  //  Result := true;
  //  if not vSing.vVendaRapida then
  //    Exit;
  try
    vDadosIni.abreStatusProcessamento('Status', 'Aguarde...');
    Avalor_total := f_float('valor_total');
    Perc_acrescitemTemp := 0;
    Perc_descItemtemp := 0;
    Result := False;

    if vSing.vTipoVenda='REQ' then
      vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPV').AsString)
    else if vSing.vTipoVenda='OS' then
      vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPO_OS').AsString)
    else
    	vItProd.FUsarPrecoCustoTipoVND := (f_str('tipo') = 'ORC')
    																		and (vDadosIni.vLocacao.vHabilitarLoc)
                                        and (vDadosIni.vLocacao.TipoOrcCusto = f_str('tipo_orc'))
                                        and (vDadosIni.vLocacao.ClienteOrcCusto = f_str('cod_cliente'));
                                        
    if vItProd.FUsarPrecoCustoTipoVND then
    begin
      vDadosIni.ShowAtencao('Não é possível recalcular preços pela condição de pagamento pois o tipo de venda %s está configurado para usar o preço de custo.',
                            [IfThen(f_str('tipo') = 'REQ', f_str('tipv')) +
                             IfThen(f_str('tipo') = 'OS' , f_str('tipo_os')) +
                             IfThen(f_str('tipo') = 'ORC', f_str('tipo_orc'))]);
      exit;
    end;

    if ((dataSet.FieldByName('NPEDMOB').AsInteger > 0) and
      (FCliOriginalVND = dataSet.FieldByName('COD_CLIENTE').AsInteger)) then
    begin
      if ShowCustomDlg
        .Question('Este pedido foi feito através de um dispositivo móvel. Deseja mesmo recalcular preços pela condição de pagamento?', brNo) <> IDYES then
        exit;
      
      if not vDadosIni.PesqPros('VND265', 'VALIDAR', getTipoVenda + ' Nº ' + fstr('NPED') + ' TOTAL ' + fstr('valor_total'),
        'PEDVENDA', fstr('NPED')) then
          Exit;
    end;

    try

      vItProd.dataSet.DisableControls;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        if (trim(vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO') then
        begin
          vItProd.dataSet.Next;
          continue;
        end;

        vItProd.dataSet.Edit;
        Valor_acrescitemTemp := vItProd.dataSet.FieldByName('acresc_item').AsCurrency;
        Valor_descItemtemp := vItProd.dataSet.FieldByName('desc_item').AsCurrency;
        Perc_acrescitemTemp := vItProd.dataSet.FieldByName('acresc_item').AsCurrency / vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;
        Perc_descItemtemp := vItProd.dataSet.FieldByName('desc_item').AsCurrency / vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;
        vItProd.vProduto.buscaProduto(
          vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
          vItProd.dataSet.FieldByName('cod_prod').AsString);

        if vItProd.dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').AsString = 'S' then
        begin
        	vItProd.dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').Value := Null;
