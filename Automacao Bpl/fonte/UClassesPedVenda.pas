              dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat *
              buscas2.FieldByName('QUANTIDADE').AsFloat, - 4);

            dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            if (dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR') and (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
            	dataSet.FieldByName('VALOR_DESCACRES').AsFloat :=
              	buscas2.FieldByName('QUANTIDADE').AsFloat * dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
          end
          else
          begin
            dataSet.FieldByName('OPERACAO_CONV').Value := Null;
            dataSet.FieldByName('FATOR_CONV').Value := Null;

            dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);

            dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_NF').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
        end;
      end;

      dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
        (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
          dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaProd.atualizarValorAcresc(
  pDBComboBoxDescAcres: TDBComboBox;
  pDBComboBoxValorPerc: TDBComboBox;
  pComissaoVendAcres: string = 'COMISSAOVEND'): Boolean;
var
	ConfigImp: TConfig_sistema_class;
  MontarPacelamentoStr: TMontarPacelamentoStr;
  vParcelas: TStringList;
  vStringListTiposReqOs: TStringList;
  vStringListGrupoReqOs: TStringList;
  vExisteTpVnd: Boolean;
  vrTemp: Currency;
  vComissaoCond: Double;
  vFatorConvCond: Double;
  vPerc_Comissao_CondPagTmp: Double;
  vComissaoGrupo, vComissaoMaxVend: Double;
  vValor_DescAcrescTmp, vPerc_Comissao_Vend3Tmp: Double;
	vCodCondPag: Integer;
  vDescrCondPag: string;
  I: Integer;
begin
	try
    Result := True;
    vExisteTpVnd := False;

    if not (dataSet.State in [dsInsert, dsEdit]) then
      Exit;

    if FOwner.vendaFechada then
      Exit;

    if not vDadosIni.vPedVnd.AcrescCondPagComissaoVend then
    begin
      if vDadosIni.StrToFloatFormat(vValor_DescAcresc, 2) = vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2) then
        Exit;

      if (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) and
        (pDBComboBoxDescAcres.ItemIndex = 0) then
      begin
        if (pDBComboBoxValorPerc.ItemIndex = 1) then
          vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2)
        else
          vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency *
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
        dataSet.FieldByName('DESC_ITEM').AsCurrency := Abs(dataSet.FieldByName('RATEIO_DESC').AsCurrency - vrTemp);

        dataSet.FieldByName('ACRESC_ITEM').AsCurrency := 0;
      end
      else
      begin
        if (pDBComboBoxValorPerc.ItemIndex = 1) then
          vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2)
        else
          vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency *
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
        dataSet.FieldByName('ACRESC_ITEM').AsCurrency := Abs(dataSet.FieldByName('RATEIO_ACRESC').AsCurrency - vrTemp);

        dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
      end;

      vValor_DescAcresc    := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
    end
    else
    begin
      ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscas, vDadosIni.cod_empresa);

      if pComissaoVendAcres = 'COMISSAOVEND' then
      begin
        if vPerc_Comissao_Vend3 = dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat then
          Exit;
      end
      else
      begin
        if vDadosIni.StrToFloatFormat(vValor_DescAcresc, 2) = vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2) then
          Exit;
      end;

      vStringListTiposReqOs := TStringList.Create;
      vStringListGrupoReqOs := TStringList.Create;

      if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'REQ' then
        vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoREQ')), ',')
      else if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'OS' then
        vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoOS')), ',')
      else if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'ORC' then
        vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoORC')), ',');

      for I := 0 to vStringListTiposReqOs.Count - 1 do
      begin
        if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'REQ')
          and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
            or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPV').AsString))) then
        begin
          vExisteTpVnd := True;
          Break;
        end
        else if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'OS')
          and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
            or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPO_OS').AsString))) then
        begin
          vExisteTpVnd := True;
          Break;
        end
        else if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'ORC')
          and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
            or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPO_ORC').AsString))) then
        begin
          vExisteTpVnd := True;
          Break;
        end;
      end;

      if not vExisteTpVnd then
        Exit;

      if (FOwner.dataSet.FieldByName('COD_COND_PAG').AsInteger > 0)
        and (dataSet.FieldByName('TP_DESCACRES').AsString = 'ACRÉSCIMO')
        and (dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat <= 0) then
      begin
        @MontarPacelamentoStr := GetProcAddress(vDadosIni.vCadBasicos.AHandle, PChar('MontarPacelamentoStr'));
        if Assigned(MontarPacelamentoStr) then
        begin
          try
            vParcelas := TStringList.Create;

            try
              vFatorConvCond := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'FatorPrazoPag')));
            except
              vFatorConvCond := 0;
            end;

            if vFatorConvCond > 0 then
            begin
              SqlOpen(' select cond_pag.cod_cond_pag, cond_pag.desc_cond_pag from cond_pag ' +
                ' where cond_pag.cod_cond_pag = ' + IntToStr(FOwner.dataSet.FieldByName('cod_cond_pag').AsInteger), buscas);
              vCodCondPag   := buscas.FieldByName('cod_cond_pag').AsInteger;
              vDescrCondPag := trim(buscas.FieldByName('desc_cond_pag').AsString);

              vParcelas.Text := MontarPacelamentoStr(
                vCodCondPag,
                vDescrCondPag,
                1000,
                '00000',
                '',
                '',
                '',
                '',
                0,
                0,
                0,
                0,
                True);

              vComissaoCond := 0;
              for I := 0 to vParcelas.Count - 1 do
                vComissaoCond := vComissaoCond + StrToDate(vDadosIni.getCampoPipe(trim(vParcelas[I]), 3)) - vDadosIni.getDataBanco(buscas);
              if vParcelas.Count > 1 then
                vComissaoCond := vComissaoCond / vParcelas.Count;

              // Acrescimo em percentual
              vPerc_Comissao_CondPagTmp := (vFatorConvCond * vComissaoCond);

              if vPerc_Comissao_CondPagTmp > 0 then
                dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat :=	vPerc_Comissao_CondPagTmp;
            end;
          finally
            if Assigned(vParcelas) then
              FreeAndNil(vParcelas);
          end;
        end;
      end;

      if dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat <= 0 then
      begin
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;
        Exit;
      end;

      try
        vComissaoMaxVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'ComissaoMaxVendedor')));
      except
        vComissaoMaxVend := 0;
      end;

      SqlOpen(' select pc.conteudo_flag, pc.perc_peso from perfil_vendedor pv ' +
        ' inner join perfil_comissao pc on pv.codigo_perfil = pc.codigo_perfil ' +
        ' where pv.ativo = 1 ' +
        ' and pv.cod_vendedor = ' + IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger) +
        ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and pc.tipo_perfil = ''Venda Geral'' ' +
        ' and pc.tipo_serv_prod = ''Produto'' ' +
        ' and pc.flag_serv_prod = ''Grupo Produto'' ', buscas);

      vComissaoGrupo := 0;
      vStringListGrupoReqOs.Text := trim(buscas.FieldByName('conteudo_flag').AsString);

      for I := 0 to vStringListGrupoReqOs.Count - 1 do
        if trim(vStringListGrupoReqOs[I]) = IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) then
        begin
          vComissaoGrupo := buscas.FieldByName('perc_peso').AsFloat;
          Break;
        end;

      vValor_DescAcresc    := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
      vPerc_Comissao_Vend3 := dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat;
    end;
  finally
    if Assigned(ConfigImp) then
      FreeAndNil(ConfigImp);
    if Assigned(vParcelas) then
      FreeAndNil(vParcelas);
    if Assigned(vStringListTiposReqOs) then
      FreeAndNil(vStringListTiposReqOs);
    if Assigned(vStringListGrupoReqOs) then
      FreeAndNil(vStringListGrupoReqOs);
  end;
end;

function TPedVendaProd.atualizarValorLiquido(pDBComboBoxDescAcres,
  pDBComboBoxValorPerc: TDBComboBox): boolean;
var
	vrTemp: Currency;
begin
	Result := True;

  if not (dataSet.State in [dsInsert, dsEdit]) then
  	Exit;

  if FOwner.vendaFechada then
  	Exit;

  if (trim(vTp_DescAcresc) = trim(dataSet.FieldByName('TP_DESCACRES').AsString))
  	and (trim(vNat_DescAcresc) = trim(dataSet.FieldByName('NAT_DESCACRES').AsString)) then
  		Exit;

	if (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) and
    (pDBComboBoxDescAcres.ItemIndex = 0) then
  begin
    if (pDBComboBoxValorPerc.ItemIndex = 1) then
      vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2)
    else
      vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency *
        dataSet.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
    dataSet.FieldByName('DESC_ITEM').AsCurrency := Abs(dataSet.FieldByName('RATEIO_DESC').AsCurrency - vrTemp);

  	dataSet.FieldByName('ACRESC_ITEM').AsCurrency := 0;
  end
  else
  begin
    if (pDBComboBoxValorPerc.ItemIndex = 1) then
      vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2)
    else
      vrTemp := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency *
        dataSet.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
    dataSet.FieldByName('ACRESC_ITEM').AsCurrency := Abs(dataSet.FieldByName('RATEIO_ACRESC').AsCurrency - vrTemp);

    dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
  end;

  vTp_DescAcresc       := dataSet.FieldByName('TP_DESCACRES').AsString;
  vNat_DescAcresc      := dataSet.FieldByName('NAT_DESCACRES').AsString;
end;

