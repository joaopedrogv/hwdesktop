          if verificarNFSe(
            dataSet.FieldByName('NPED').AsInteger,
            dataSet.FieldByName('TIPO').AsString,
            False) then
          begin
            if vDadosIni.PesqPros('VND268', 'EMITIR NFS', getTipoVenda, 'PEDVENDA',
              dataSet.FieldByName('NPED').AsString, buscas, true) then
            begin
              CallerNFSeFeatures.Emitir( fint('nped'), False );
            end;

            if (vDadosIni.vEmp.vModoFaturamento <> 'S') then
            begin
              existeRetencaoProdutos := (Trim(vSing.vTipoVenda) <> 'ORC')
                and fequals('nf_ac_calctrib', 'S')
                and vDadosIni.existeProdutoDoc( buscas, fint('nped'), fstr('tipo'))
                and vDadosIni.RetencaoClienteNFe(
                  buscas, IfThen(fint('cod_cli_fat') > 0, fint('cod_cli_fat'), fint('cod_cliente'))
                );

              existeRetencaoServicos := (Trim(vSing.vTipoVenda) = 'OS')
                and Container.GetInstance().ErpFeaturesFactory.CreateChecarPossivelRetencaoNFSeUseCase()
                  .Executar(fint('nped'));

              if existeRetencaoProdutos or existeRetencaoServicos then
                iniciaFormaPagamento;
              {
            	vExisteServicoOS           := False;
              vRetencaoFedClienteNF      := False;
            	vRetencaoFedClienteNFS     := False;
            	vRetencaoFedTpServNFS      := False;
            	vIssRetidoClienteNFS       := False;
              vIssRetidoTpServNFS        := False;

              vExisteProduto             := vDadosIni.existeProdutoDoc(
                                          	  buscas,
                                              fint('nped'),
                                     	        fstr('tipo'));

              if trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC' then
              begin
                if fstr('nf_ac_calctrib') = 'N' then
                  vRetencaoFedClienteNF  := False
                else
                  vRetencaoFedClienteNF  := vDadosIni.RetencaoClienteNFe(
                                              buscas,
                                              IfThen(fint('cod_cli_fat') > 0, fint('cod_cli_fat'), fint('cod_cliente')));
              end;

              if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
              begin
                vExisteServicoOS         := vDadosIni.existeServicoDoc(
                                     	        buscas,
                                              fint('nped'),
                                     	        fstr('tipo'));

                vRetencaoFedClienteNFS   := vDadosIni.RetencaoClienteNFse(
                                   		      	buscas,
                                   		       	fint('cod_cliente'));

                vRetencaoFedTpServNFS    := vDadosIni.RetencaoTpServicoNFSe(
                                          	  buscas,
                                              fint('nped'),
                                     	        fstr('tipo'));

								vIssRetidoClienteNFS     := vDadosIni.IssRetidoClienteNFSe(
                                   		        buscas,
                                   		        fint('cod_cliente'));

                vIssRetidoTpServNFS      := vDadosIni.IssRetidoTpServicoNFSe(
                                              buscas,
                                              fint('nped'),
                                              fstr('tipo'));
              end;

              if ((vExisteProduto) and (vRetencaoFedClienteNF))
                or ((vExisteServicoOS) and ((vIssRetidoClienteNFS) or (vIssRetidoTpServNFS) or (vRetencaoFedClienteNFS) or (vRetencaoFedTpServNFS))) then
              begin
                iniciaFormaPagamento;
              end;
              }
            end;
          end;
        end;
      finally
        vEmitirNFeNFC := 'NAO';
        vEmitirNFSe   := 'NAO';
      end;
      Result := true;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        vDadosIni.GravaAuditoria('VND046', 'SALVAR PEDIDO', 'Erro: ' + e.Message, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        registraErro('VND046' + e.Message);
      end;
    end;
  finally
    vDadosIni.logsPedvenda(Self.ClassName + '.post - end', 'pedvenda');

  	if Assigned(ConfigPoliticaPag) then
      FreeAndNil(ConfigPoliticaPag);
       
    if Result then
    begin
      //      vItProd.QuestionarBaixaGrade := false;
			vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);
      vItProd.dataSet.DisableControls;
			vItProd.dataSet.First;
			while not vItProd.dataSet.Eof do
			begin
				vMD5Func._gravaMD5_Produtos(buscas,
					vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
					vItProd.dataSet.FieldByName('cod_prod').AsString);
				vItProd.dataSet.Next;
			end;
      if vDadosIni.vZerarDescontoItem = 'S' then
			begin
				vItProd.descontoP := 0;
        vItProd.descontoV := 0;
        vItProd.descontoVini := 0;
        vItProd.acrescimoP := 0;
        vItProd.acrescimoV := 0;
      end;
      pedidoEmEdicao(caRemoverEdicao, False);
      if vDadosIni.vTsPlus = 'S' then
      begin
      	vSqlTmp := ' and pedvenda.tipo = ' + QuotedStr(getTipoVenda);
        if getTipoVenda = 'REQ' then
          vProcessoPesqVendedor := 'VND222'
        else if Trim(getTipoVenda) = 'OS' then
          vProcessoPesqVendedor := 'VND223'
        else
          vProcessoPesqVendedor := 'VND224';
        if not vDadosIni.PesqPros(vProcessoPesqVendedor, 'HABILITAR', '',
        	'PEDVENDA', '', buscas, False, False, True) then
          	vSqlTmp := vSqlTmp + ' and pedvenda.cod_vendedor = ' + IntToStr(vDadosIni.vCodUsuario);


        montaSelect(' select ' + Fsql_campos + ' from pedvenda ' +
        	Fsql_inner +
          ' where pedvenda.data_ped = ' + QuotedStr(FormatDateTime('dd.mm.yyyy', vDataTmp)) +
          vSqlTmp +
          ' and pedvenda.cod_empresa = ' + vDadosIni.codEmpresa);
      end
      else
      begin
        if trim(comandoTexto) <> '' then
          montaSelect(comandoTexto);
      end;
    end;
    enableControlsDataSets;
  end;
end;

