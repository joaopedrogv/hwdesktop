          ' vei.placa,os.data_fech,os.num_nf,os.data_nf,os.VALOR_NF,os.OBS_RED_OS,os.ncupom,os.NUM_NFEEXT,os.DATA_NFEXT,os.VALOR_NFEXT from ' +
          ' pedvenda os ' +
          ' inner join clientes cl on os.cod_cliente = cl.cod_cliente and os.cod_empresa = cl.cod_empresa ' +
          ' left join veiculos vei on os.chassi = vei.chassi and os.cod_empresa = vei.cod_empresa ' +
          ' where os.data_ped >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataInicial))) +
          ' and os.data_ped <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataFinal))) +
          ' and os.tipo = ''OS''  ' +
          ' and os.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and os.ativo = 1 ' +
          ' and (os.status_ped is null or os.status_ped = '''') ' +
          ' order by os.seq_fech, os.nped ';
      end;
    end
    else
    begin
      if status = 'Fechadas' then
      begin
        if vDadosIni.vEmp.vUsarAparelho = 'S' then
