function TPedVenda.validaCheckCheck: Boolean;
begin
  try
    try
      Result := False;

      vCheckCheck := TCheckCheck.create;

      if not(vCheckCheck.efetuarConsultaCheckCheck(dataSet.FieldByName('COD_CLIENTE').AsInteger, dataSet.FieldByName('VALOR_TOTAL').AsFloat)) then
        if not vDadosIni.PesqPros('CHK004', 'PERMITIR VENDA SEM CONSULTAR NO CHECK CHECK', '', 'PEDVENDA', dataSet.FieldByName('COD_CLIENTE').AsString, buscas, True) then
            Exit;

      vCliente.Refresh;

      Result := True;
    except on E: Exception do
      begin
        Result := False;
        Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(vCheckCheck) then
  		FreeAndNil(vCheckCheck);
  end;
end;

function TPedVenda.validaConfirmacao: Boolean;
begin
	try
    Result := False;

    if not validaCheckCheck then
    	Exit;

    if not validaFaturamento then
    	Exit;

    if not validaLimiteCredito then
    	Exit;

    Result := True;    
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
      registraErro(e.Message);
    end;
  end;
end;

