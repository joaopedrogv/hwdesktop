function TPedVenda._liberarVendasSelecionadasParaFechamento: Boolean;
var
  vListaAprovadas: TStringList;
  I: Integer;
begin
	try
    Result := False;

    vListaAprovadas := TStringList.Create;
    vListaAprovadas.Clear;
    dataSet.First;
    while not dataSet.Eof do
    begin
      if dataSet.FieldByName('sel').AsString = 'S' then
      begin

        buscas.Close;
        if Trim(dataSet.FieldByName('tipo').AsString) = 'REQ' then
          buscas.SQL.Text := 'select USAR_LIBERACAO_GERENTE from TIPO_VENDAS' +
                           ' where tipo = ''REQ'' and sigla = ' + QuotedStr(Trim(dataSet.FieldByName('tipv').AsString))
        else
          buscas.SQL.Text := 'select USAR_LIBERACAO_GERENTE from TIPO_VENDAS' +
                           ' where tipo = ''OS'' and tipo_os = ' + QuotedStr(Trim(dataSet.FieldByName('tipo_os').AsString));
        buscas.Open;

        if Trim(buscas.FieldByName('USAR_LIBERACAO_GERENTE').AsString) = 'S' then
        begin

          dataSet.Edit;
          if dataSet.FieldByName('APROVADA_GERENTE').AsString = 'S' then
          begin
            dataSet.FieldByName('APROVADA_GERENTE').AsString := 'N';
            vDadosIni.GravaAuditoria('VND125', 'TRAVAR', 'VENDA NUM ' + dataSet.FieldByName('NPED').AsString,
              'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
          end
          else
          begin
            dataSet.FieldByName('APROVADA_GERENTE').AsString := 'S';
            vDadosIni.GravaAuditoria('VND125', 'LIBERAR', 'VENDA NUM ' + dataSet.FieldByName('NPED').AsString,
              'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
            vListaAprovadas.Add(dataSet.FieldByName('NPED').AsString);
          end;
          dataSet.Post;
        end;

      end;
      dataSet.Next;
    end;
    if dataSet.ChangeCount > 0 then
    begin
      Result := Apply;

      for I := 0 to vListaAprovadas.Count - 1 do
        verificarEnvioAutoParaSeparacao(StrToInt(vListaAprovadas[I]));
      CommitaTransacao;

      if Result then
      begin
        vDadosIni.GravaAuditoria('VND125', 'GRAVAR', 'SUCESSO',
          'PEDVENDA', '', buscas);
      end;
    end;
  finally
    if Assigned(vListaAprovadas) then
    	FreeAndNil(vListaAprovadas);
  end;
end;

procedure TPedVenda._marcaDesmarcaLinha;
begin
  if dataSet.IsEmpty then
