procedure TPedVenda.GravarContasPagarTemp(var pContas: RContas;
  cdsDesp: TClientDataSet);
var
 I, vParcela: Integer;
 vNomeCtr, vContrBanco: string;
begin
  vParcela := 0;
  while not cdsDesp.IsEmpty do
    cdsDesp.Delete;
  for I := 0 to pContas.parcelas - 1 do
  begin
    Inc(vParcela);
    cdsDesp.Insert;
    cdsDesp.FieldByName('NumConta').AsFloat := pContas.NumConta[I];
//    cdsDesp.FieldByName('Departamento').AsString := trim(vPlanoC.dataset.FieldByName('desc_dep').AsString);
//    cdsDesp.FieldByName('CodCred').AsInteger := pContas.CodCred[I];
    cdsDesp.FieldByName('DataReferencia').AsString := pContas.dataReferencia[I];
    cdsDesp.FieldByName('DataVenc').AsString := pContas.vencimentoDocumento[I];
    cdsDesp.FieldByName('NumDoc').AsString := pContas.numeroDocumento[I];
    cdsDesp.FieldByName('Historico').AsString := pContas.historico[I];
    cdsDesp.FieldByName('TipoDespesa').AsInteger := pContas.CodTpDespesa[I];
    cdsDesp.FieldByName('Valor').AsFloat := pContas.valorDocumento[I];
    cdsDesp.FieldByName('CodFornecedor').AsInteger := pContas.CodFornecedor[I];
    cdsDesp.FieldByName('Controles').AsInteger := pContas.Controle[I];
    cdsDesp.FieldByName('NChq').AsString := pContas.NCHQ[I];
    cdsDesp.FieldByName('NominalChq').AsString := pContas.NCHQNominal[I];
    cdsDesp.FieldByName('Parcela').AsInteger := vParcela;

    buscas.Close;
    buscas.SQL.Text := 'SELECT CODIGO_CTRL, NOME_CTRL, CONTR_BANC FROM CONTROLES ' +
     ' WHERE CODIGO_CTRL = :CODIGO_CTRL ' +
     ' AND CODIGO_EMP = :CODIGO_EMP ';
    buscas.ParamByName('CODIGO_CTRL').AsInteger := cdsDesp.FieldByName('Controles').AsInteger;
    buscas.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    vNomeCtr := buscas.FieldByName('NOME_CTRL').AsString;
    vContrBanco := buscas.FieldByName('CONTR_BANC').AsString;

    cdsDesp.FieldByName('ContrBanc').AsString := vContrBanco;
    cdsDesp.FieldByName('NomeControle').AsString := trim(vNomeCtr);

    cdsDesp.Post;
  end;
  cdsDesp.First;
end;

function TPedVenda.GravarHistEstMoto(pStatus: string): boolean;
var
  buscas2: TIBQuery;
begin
	try
  	buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    try
      if vDadosIni.vEmp.vVersaoVeiculos <> '4' then
        exit;

      if vDadosIni.vEmp.vUsarAparelho <> 'N' then
        exit;

      if (trim(dataset.FieldByName('CHASSI').AsString) = '') and (trim(dataset.FieldByName('PLACA').AsString) = '') then
        exit;

      vDadosIni.vHistV.vChassi := dataset.FieldByName('CHASSI').AsString;
      if dataset.FieldByName('N_COMANDO').AsInteger > 0 then
         vDadosIni.vHistV.vCodigo := StrToInt(retornaValor('select COALESCE(COD_ESTMOTO, 0) as valor from COM_FAT ' +
          ' WHERE N_COMANDO = ' + IntToStr(dataset.FieldByName('N_COMANDO').AsInteger) + ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa))
      else
         vDadosIni.vHistV.vCodigo := 0;
      vDadosIni.vHistV.vNatureza := 'S';
      vDadosIni.vHistV.vNumDoc := dataset.FieldByName('NPED').AsInteger;
      vDadosIni.vHistV.vPlaca := dataset.FieldByName('PLACA').AsString;
      vDadosIni.vHistV.vTipo := dataset.FieldByName('TIPO').AsString;
      vDadosIni.vHistV.vModelo := '';
      vDadosIni.vHistV.vNumNota := 0;
      vDadosIni.vHistV.vSerieNF := '';
      vDadosIni.vHistV.vStatusNF := '';
      vDadosIni.vHistV.vSituacaoNF := '';
      vDadosIni.vHistV.vModeloNF := '';
      vDadosIni.vHistV.vEmissaoPropriaNF := '';
      vDadosIni.vHistV.vValorOP := dataSet.FieldByName('VALOR_TOTAL').AsFloat;
      vDadosIni.vHistV.vData := dataset.FieldByName('DATA_PED').AsString;
      vDadosIni.vHistV.vNatOP := 0;
      vDadosIni.vHistV.vTipoVenda := '';
      vDadosIni.vHistV.vCodCliente := dataset.FieldByName('COD_CLIENTE').AsInteger;
      vDadosIni.vHistV.vCodCliVend := 0;
      vDadosIni.vHistV.vCodConcess := 0;
      vDadosIni.vHistV.vCodIntermed := 0;
      vDadosIni.vHistV.vCodVendedor := dataset.FieldByName('COD_VENDEDOR').AsInteger;
      vDadosIni.vHistV.vCodCondPag := dataset.FieldByName('COD_COND_PAG').AsInteger;
      vDadosIni.vHistV.vPrecCusto := 0;
      vDadosIni.vHistV.vPrecTabEst := 0;
      vDadosIni.vHistV.vRedLucro := '';
      vDadosIni.vHistV.vTipvVeiculo := '';
      vDadosIni.vHistV.vStatusDemonst := '';
      vDadosIni.vHistV.vStatusEstoque := '';
      vDadosIni.vHistV.vStatusRes := '';
      vDadosIni.vHistV.vStatusTransD := '';
      vDadosIni.vHistV.vStatusUso := '';
      if trim(dataset.FieldByName('TIPO').AsString) = 'OS' then
        vDadosIni.vHistV.vStatusV := pStatus
      else if (trim(dataset.FieldByName('TIPO').AsString) = 'ORC') and (trim(pStatus) = 'CANCELADO') then
        vDadosIni.vHistV.vStatusV := pStatus;
      vDadosIni.vHistV.vPosicao := 'MORTO';
      vDadosIni.vHistV.vAlteraEstoqueCFOP := 'N';
      vDadosIni.GravarHistEstMoto(buscas2, DtmPed.SpIncCodigo, vDadosIni.vHistV);

      if (trim(UpperCase(pStatus)) = 'CANCELADO') and (dataset.FieldByName('N_COMANDO').AsInteger > 0) then
      begin
         ExecutaComandosSqlExec('update com_fat set status_v = ''CANCELADO''' +
          ' where n_comando = ' + IntToStr(dataSet.FieldByName('n_comando').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa);

         ExecutaComandosSqlExec('update hist_estmoto set status_v = ''CANCELADO''' +
          ' where tipo in (''CFT'', ''CTR'') and numdoc = ' + IntToStr(dataSet.FieldByName('n_comando').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa);
      end;
    except
      on E: Exception do
      begin
        result := false;
        if inibeErro <> 'S' then
          Application.MessageBox(PChar('Erro ao Gravar Histórico Veículo.'), 'Atenção', MB_ICONWARNING + MB_OK);
        inibeErro := 'N';
        registraErro('E0007 ' + e.Message);
        RollBackTransacao;
        exit;
      end;
    end;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVenda._habilitadoDataPrometida(pTipo: string): Boolean;
var
	ConfigDataProm: TConfig_sistema_class;
  vTipoDoc: TStringList;
  I: Integer;
begin
	try
  	Result := False;

    ConfigDataProm := TConfig_sistema_class.getConf('ped_vnd_data_prometida', buscas, vDadosIni.cod_empresa);

    if Assigned(ConfigDataProm) then
    begin
      vTipoDoc := TStringList.create;
      vTipoDoc := vDadosIni.Split(ConfigDataProm.ReadString('Conf', 'TipoDoc'), ',');

      for I := 0 to vTipoDoc.Count - 1 do
      begin
      	if (trim(pTipo) = 'REQ') and (trim(vTipoDoc[I]) = 'REQ') then
        begin
          Result := True;
          Break;
        end
        else if (trim(pTipo) = 'OS') and (trim(vTipoDoc[I]) = 'OS') then
        begin
          Result := True;
          Break;
        end
        else if (trim(pTipo) = 'ORC') then
        begin
          if (vSing.vOrcamentoSoPecas) and (trim(vTipoDoc[I]) = 'ORC_P') then
          begin
            Result := True;
            Break;
          end
          else if (not vSing.vOrcamentoSoPecas) and (trim(vTipoDoc[I]) = 'ORC_PS') then
          begin
            Result := True;
            Break;
          end;
        end;
      end;
    end;
  finally
  	if Assigned(ConfigDataProm) then
      FreeAndNil(ConfigDataProm);
  end;
end;

function TPedVenda._habilitarFormPag: Boolean;
var
  vCtrlVnd: Integer;
  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
begin
  Result := False;
  try
    ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
    vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));

    if vUsarControlesVenda <> 'S' then
      Exit;

    if (Trim(dataSet.FieldByName('tipo').AsString) <> 'REQ') and (Trim(dataSet.FieldByName('tipo').AsString) <> 'OS') then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select nrequisicao from formpagamento' +
      ' where nrequisicao = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ' and tpdocs = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if not buscas.IsEmpty then
      Exit;

    vCtrl.dataSet.Close;
    if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
      if Trim(vCliente.dataSet.FieldByName('controles_fp').AsString) <> '' then
        vCtrl._selecionaControlesFP(Trim(vCliente.dataSet.FieldByName('controles_fp').AsString));

    if not vCtrl.dataSet.Active then
      vCtrl._selecionaControlesFP('');

    Result := True;
  finally
    if Assigned(ConfigPoliticaPag) then
    	FreeAndNil(ConfigPoliticaPag);
  end;
end;


