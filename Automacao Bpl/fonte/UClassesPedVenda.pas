        begin
          //          dataSet.FieldByName('TIPV').AsString := retornaValor('select sigla AS VALOR from' +
          //         ' tipo_vendas where sigla= ''V'' and tipo=''REQ''');
                  //se não tiver o tipo V-Varejo joga o primeiro tipo de venda requisição
          if dataSet.FieldByName('TIPV').AsString = '' then
            dataSet.FieldByName('TIPV').AsString := retornaValor('select first 1 sigla AS VALOR from tipo_vendas ' +
              ' where tipo=''REQ'' and venda=''S'' and ativo = 1 order by ordemexibicao');
        end
        else if (Trim(vDadosIni.vEmp.vTipoVendaPadraoVendaRap) <> 'E') then
          dataSet.FieldByName('TIPV').AsString := Trim(vDadosIni.vEmp.vTipoVendaPadraoVendaRap);
        if vSing.vTipoVenda = 'ORC' then
        begin
          if (Trim(vDadosIni.vEmp.vTipoOrcPadrao) = '') then
          begin
            //            dataSet.FieldByName('TIPO_ORC').AsString := retornaValor('select sigla AS VALOR from' +
            //            ' tipo_vendas where sigla= ''T'' and tipo=''ORC''');
            if dataSet.FieldByName('TIPO_ORC').AsString = '' then
              dataSet.FieldByName('TIPO_ORC').AsString := retornaValor('select first 1 sigla AS VALOR from tipo_vendas ' +
              	' where tipo=''ORC'' and ativo = 1 order by ordemexibicao');
