      if dataSet.FieldByName('acresc_p_prod').IsNull then
        dataSet.FieldByName('acresc_p_prod').AsFloat := 0;
      if dataSet.FieldByName('acresc_p_serv').IsNull then
        dataSet.FieldByName('acresc_p_serv').AsFloat := 0;
      if dataSet.FieldByName('acrescimo').IsNull then
        dataSet.FieldByName('acrescimo').AsFloat := 0;

      Fconf.ExecutarLeitura;
      Result := true;
    end;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TPedVenda.LerVariaveisOtimizacao;
var
  Value: string;
  Conf: TStrings;
begin

  vDadosIni.vPedVnd.Otimizacao.Ativa := Pos(getTipoVenda, vDadosIni.getConfSisStr('ped_vnd_otimizacao', buscas)) > 0;

  if vDadosIni.vPedVnd.Otimizacao.Ativa then
  begin
    Conf := vDadosIni.getConfSisBlob('ped_vnd_otimizacao', buscas);

    Value := 'Outras';
    if Pos('[' + Value + getTipoVenda + ']', Conf.Text) = 1 then
      Value := Value + getTipoVenda;

    vDadosIni.vPedVnd.Otimizacao.Outras.ExibirOpcaoEnviarNfNfcNFSAoFechar := vDadosIni.GetIni(Value , 'ExibirOpcaoEnviarNfNfcNFSAoFechar', 'S', Conf) = 'S';

    vDadosIni.vPedVnd.Otimizacao.Outras.FormaPagamentoAntesDeFechar := vDadosIni.GetIni(Value , 'FormaPagamentoAntesDeFechar', 'N', Conf) = 'S';

    Value := 'InibirMensagens';
    if Pos('[' + Value + getTipoVenda + ']', Conf.Text) = 1 then
      Value := Value + getTipoVenda;

    vDadosIni.vPedVnd.Otimizacao.InibirMensagem.TipoDeVenda                  := vDadosIni.GetIni(Value , 'TipoDeVenda'        , 'S', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.InibirMensagem.ConfirmarDocumento           := vDadosIni.GetIni(Value , 'ConfirmarDocumento' , 'S', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.InibirMensagem.DocumentoConfirmado          := vDadosIni.GetIni(Value , 'DocumentoConfirmado', 'S', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.InibirMensagem.ImprimirDocumentoAoConfirmar := vDadosIni.GetIni(Value , 'ImprimirDocumentoAoConfirmar'  , 'S', Conf) = 'S';

    Value := 'ImpressaoAuto';
    if Pos('[' + Value + getTipoVenda + ']', Conf.Text) = 1 then
      Value := Value + getTipoVenda;

    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.AbrirTelaDeOpcoes         := vDadosIni.GetIni(Value , 'AbrirTelaDeOpcoes', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.SempreImprimirAoConfirmar := vDadosIni.GetIni(Value , 'SempreImprimirAoConfirmar', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.Chassi                    := vDadosIni.GetIni(Value , 'Chassi', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.OSExterna                 := vDadosIni.GetIni(Value , 'OSExterna', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.NomeFantasia              := vDadosIni.GetIni(Value , 'NomeFantasia', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.DuasVias                  := vDadosIni.GetIni(Value , 'DuasVias', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.DuasViasPorFolha          := vDadosIni.GetIni(Value , 'DuasViasPorFolha', 'N', Conf) = 'S';
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.Tipo                      := vDadosIni.GetIni(Value , 'Tipo', 'REDUZIDO', Conf);
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.Formato                   := vDadosIni.GetIni(Value , 'Formato', 'A5 (33 Linhas)', Conf);
    vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.IdentificacaoProd         := UpperCase(vDadosIni.GetIni(Value , 'IdentificacaoProd', 'Valor informado', Conf));
  end;
end;

function TPedVenda.LiberarTravaVenda: boolean;
var
  msg, processo: string;
begin
  result := false;
  if dataSet.FieldByName('ATIVO').asinteger = 0 then
    exit;
  if vSing.vTipoVenda = 'ORC' then
    exit;
  {  if dataSet.FieldByName('LIBTRAVA').AsString = 'S' then
    begin
      if vSing.vTipoVenda = 'REQ' then
        Application.MessageBox('Trava para esta requisição já foi retirada para abertura de novas Requisições.',
          'Informação', MB_OK + MB_ICONINFORMATION)
      else
        Application.MessageBox('Trava para esta O.S. já foi retirada para abertura de novas Ordens de Serviço.',
          'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;}
  if vSing.vTipoVenda = 'OS' then
    msg := 'Deseja realmente retirar esta O.S. da trava para abertura de novas Ordens de Serviços?'
  else
    msg := 'Deseja realmente retirar esta Requisição da trava para abertura de novas Requisições?';
  if Application.MessageBox(Pchar(msg), 'Retirar trava', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
  begin
    processo := 'VND217';
    if dataset.FieldByName('QTDE_LIBTRAVA').AsInteger > 0 then
      processo := 'VND091';
    if vDadosIni.PesqPros(processo, 'RETIRAR TRAVA', '', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
      if inherited Edit then
      begin
        dataSet.FieldByName('LIBTRAVA').AsString := 'S';
        dataset.FieldByName('DATA_LIBTRAVA').AsDateTime := vDadosIni.getDataBanco(buscas);
        dataset.FieldByName('QTDE_LIBTRAVA').AsInteger := dataset.FieldByName('QTDE_LIBTRAVA').AsInteger + 1;
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
          vDadosIni.GravaAuditoria(processo, 'RETIRAR TRAVA', 'SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
        else
          vDadosIni.GravaAuditoria(processo, 'RETIRAR TRAVA', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
      end;
  end;
  Refresh;
end;

function TPedVenda.lixeiraVazia: boolean;
begin
  Result := not ExecutaComandosSql('select first 1 nped from pedvenda where ativo = 0' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and tipo = ' + QuotedStr(vSing.vTipoVenda));
end;

procedure TPedVenda.lixeira;
begin
  if dataSet.IsEmpty then
    exit;

  if not vDadosIni.PesqPros('VND004', 'EXCLUIR', getTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
    Exit;

  if dataSet.FieldByName('nprevenda').AsInteger > 0 then
  begin
    Application.MessageBox('DAV não pode ser excluído.',
      'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;

  if dataSet.FieldByName('paf_num_prevenda').AsInteger > 0 then
  begin
    Application.MessageBox('PreVenda não pode ser excluída.',
      'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;

  if trim(retornaValor('select ncupom as valor from pedvenda ' +
  	' where nped = ' + dataSet.FieldByName('nped').AsString +
    ' and tipo = ' + QuotedStr(getTipoVenda))) <> '' then
  begin
    Application.MessageBox('Venda já possui cupom emitido. Não pode ser excluída.',
      'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;

  if trim(retornaValor('select n_nfd as valor from pedvenda ' +
  	' where nped = ' + dataSet.FieldByName('nped').AsString +
    ' and tipo = ' + QuotedStr(getTipoVenda))) <> '' then
  begin
    Application.MessageBox('Venda já possui nota fiscal série D. Não pode ser excluída.',
      'Atenção', MB_OK + MB_ICONEXCLAMATION);
    exit;
  end;

  if vDadosIni.vEmp.vModoFaturamento = 'S' then
    if recebendoOuRecebidoCaixaAuxiliar then
    begin
      Application.MessageBox('Documento recebido ou sendo recebido no Caixa Auxiliar por outro operador.',
        'Atenção', MB_OK + MB_ICONINFORMATION);
      if not vDadosIni.PesqPros('VND089', 'LIBERAR', dataSet.FieldByName('TIPO').asstring, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        exit;
    end;
  excluirPermanentemente;
end;

function TPedVenda.abrePedVenda: boolean;
begin
  result := montaSelect('select ' + Fsql_campos + ' from pedvenda ' + Fsql_inner +
    ' where pedvenda.COD_EMPRESA = ' + vDadosIni.codEmpresa + ' and pedvenda.ativo=1');
end;

procedure TPedVenda.abreFichaVeiculoAparelho(
	pVeicAparelho: string;
  pNped: Integer;
  pTipo: string;
  pChassi: string;
  pPlaca: string;
  pCodVeic: Integer;
  pCodEquip: Integer);
var
	temp: string;
begin
	if pVeicAparelho = 'V' then
  begin
    if (Trim(pChassi) <> '')
      and (not vDadosIni.vVeic.vDesabilitarChassi) then
    begin
      temp := ' WHERE TRIM(ORD.CHASSI) = :CHASSI ';
    end
    else if (Trim(vDadosIni.retornaPlacaNovaAntiga(pPlaca)) <> Trim(pPlaca)) then
    begin
      temp := ' WHERE ((TRIM(ORD.PLACA) = :PLACANOV) OR (TRIM(ORD.PLACA) = :PLACAANT)) ';
    end
    else
    begin
    	temp := ' WHERE TRIM(ORD.PLACA) = :PLACA ';
    end;

    qrficha.Close;
    qrficha.SQL.text :=
      ' SELECT DISTINCT ORD.NPED AS N_OS, ORD.TIPO, ' +
      '	ORD.PLACA, ORD.CHASSI, ORD.DATA_PED, ORD.STATUS_PED, ORD.COD_EMPRESA, ORD.VALOR_TOTAL, ' +
      ' CASE WHEN (ORD.TIPO = ''OS'') then ' +
      ' 		   ORD.TIPO_OS ' +
      '			 ELSE ' +
      '				 ORD.TIPO_ORC ' +
      '	END TIPO_OS, ' +
      ' VEI.DESCMODELO, VEI.ANOFAB, VEI.ANOMOD, CL.NOME_CLIENTE, CL.RAZAO ' +
      ' FROM PEDVENDA ORD ' +
      ' INNER JOIN VEICULOS VEI ON ORD.CHASSI = VEI.CHASSI AND ORD.COD_EMPRESA = VEI.COD_EMPRESA ' +
      ' INNER JOIN CLIENTES CL ON ORD.COD_CLIENTE = CL.COD_CLIENTE AND ORD.COD_EMPRESA = CL.COD_EMPRESA ' +
      temp +
      vDadosIni.IfThen(Trim(pTipo) = 'OsOrc', ' AND ORD.TIPO in (''OS'', ''ORC'') ', ' AND ORD.TIPO = :TIPO ') +
      ' AND ORD.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND ORD.ATIVO = 1 ' +
      ' AND ((ORD.STATUS_PED <> ''CANCELADO'') OR (ORD.STATUS_PED IS NULL)) ' +
      ' AND VEI.ATIVO <> 99 ';

    if (Trim(pChassi) <> '')
      and (not vDadosIni.vVeic.vDesabilitarChassi) then
    begin
      qrficha.ParamByName('CHASSI').AsString := Trim(pChassi);
    end
    else if (Trim(vDadosIni.retornaPlacaNovaAntiga(pPlaca)) <> Trim(pPlaca)) then
    begin
    	qrficha.ParamByName('PLACANOV').AsString := Trim(pPlaca);
      qrficha.ParamByName('PLACAANT').AsString := Trim(vDadosIni.retornaPlacaNovaAntiga(pPlaca));
    end
    else
    begin
      qrficha.ParamByName('PLACA').AsString := Trim(pPlaca);
    end;

    if Trim(pTipo) <> 'OsOrc' then
    	qrficha.ParamByName('TIPO').AsString := pTipo;

    qrficha.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

    qrficha.Open;

    qrficha.AfterScroll := abreItFichaAfterScroll;

    if qrficha.IsEmpty then
      abreItemFicha(-1, '')
    else
      abreItemFicha(qrficha.FieldByName('N_OS').AsInteger, qrficha.FieldByName('TIPO').AsString);
  end
  else
  begin
  	qrficha.Close;
    qrficha.SQL.text :=
    	' SELECT ORD.NPED AS N_OS, ORD.TIPO, ' +
      ' ORD.COD_EQUIP, ORD.DATA_PED, ORD.STATUS_PED, ORD.COD_EMPRESA, ORD.VALOR_TOTAL, ' +
      ' CASE WHEN (ORD.TIPO = ''OS'') then ' +
      ' 		   ORD.TIPO_OS ' +
      '			 ELSE ' +
      '				 ORD.TIPO_ORC ' +
      '	END TIPO_OS, ' +
      '	VEI.NOM_EQUIP, CL.NOME_CLIENTE, CL.RAZAO ' +
      ' FROM PEDVENDA ORD ' +
      ' INNER JOIN EQUIPAMENTO VEI ON ORD.COD_EQUIP = VEI.COD_EQUIP AND ORD.COD_EMPRESA = VEI.COD_EMPRESA ' +
      ' INNER JOIN CLIENTES CL ON ORD.COD_CLIENTE = CL.COD_CLIENTE AND ORD.COD_EMPRESA = CL.COD_EMPRESA ' +
      ' WHERE ORD.COD_EQUIP = :COD_EQUIP ' +
      vDadosIni.IfThen(Trim(pTipo) = 'OsOrc', ' AND ORD.TIPO in (''OS'', ''ORC'') ', ' AND ORD.TIPO = :TIPO ') +
      ' AND ORD.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND ORD.ATIVO = 1 ' +
      ' AND ((ORD.STATUS_PED <> ''CANCELADO'') OR (ORD.STATUS_PED IS NULL)) ' +
      ' AND VEI.ATIVO <> 99 ';

    qrficha.ParamByName('COD_EQUIP').AsInteger := pCodEquip;

    if Trim(pTipo) <> 'OsOrc' then
    	qrficha.ParamByName('TIPO').AsString := pTipo;

    qrficha.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

    qrficha.Open;

    qrficha.AfterScroll := abreItFichaAfterScroll;

    if qrficha.IsEmpty then
      abreItemFicha(-1, '')
    else
      abreItemFicha(qrficha.FieldByName('N_OS').AsInteger, qrficha.FieldByName('TIPO').AsString);
  end;
