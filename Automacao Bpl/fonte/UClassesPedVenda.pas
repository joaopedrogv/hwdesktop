function TProdutoPed.buscaProduto(var codBarra: string; var gradeSel: Integer): boolean;
var
  vPesquisaPorDesc: boolean;
begin
	vPesquisaPorDesc := false;
  try
    montaSelect('select distinct coalesce(cb.cod_barra, p.num_fab_prod) num_fab_prod, ' +
    	' trim(p.descr_prod) || ' +
      ' case when (gr.descricao is not null) and (gr.descricao1 is not null) then ' +
      '        case when (trim(gr.descricao) <> trim(gr.descricao1)) then ' +
      '               ''-'' || gr.descricao || ''-'' || gr.descricao1 ' +
      '             else ' +
      '               ''-'' || gr.descricao ' +
      '        end ' +
      '      when (gr.descricao is not null) then ' +
      '        ''-'' || gr.descricao ' +
      '      else ' +
      '        '''' ' +
      ' end descr_prod, ' +
      ' coalesce(g.qtde, p.est_f) est_f, ' +
      ' iif(cb.cod_grade > 0, cb.cod_grade, g.cod_grade) num_banca, ' +
      ' p.*, ' +
      ' coalesce(est.estoque, 0) estoque_disponivel, ' +
			' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
    	' inner join cod_barra cb on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
      ' left join cod_grade_prod g on g.grupo_prod = p.grupo_prod and g.cod_prod = p.cod_prod and g.cod_empresa = p.cod_empresa and g.cod_grade = cb.cod_grade ' +
      ' left join grade gr on gr.cod_grade = g.cod_grade and gr.cod_empresa = g.cod_empresa' +
      ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, cb.cod_grade, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
      ' where p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cb.cod_barra = ' + QuotedStr(codBarra) +
      ' and p.ativo = 1 ');

  	if dataSet.IsEmpty then
    begin
      montaSelect('select distinct coalesce(cb.cod_barra, p.num_fab_prod) num_fab_prod, ' +
      	' trim(p.descr_prod) || ' +
        ' case when (gr.descricao is not null) and (gr.descricao1 is not null) then ' +
        '        case when (trim(gr.descricao) <> trim(gr.descricao1)) then ' +
        '               ''-'' || gr.descricao || ''-'' || gr.descricao1 ' +
        '             else ' +
        '               ''-'' || gr.descricao ' +
        '        end ' +
        '      when (gr.descricao is not null) then ' +
        '        ''-'' || gr.descricao ' +
        '      else ' +
        '        '''' ' +
        ' end descr_prod, ' +
        ' coalesce(g.qtde, p.est_f) est_f, ' +
        ' iif(cb.cod_grade > 0, cb.cod_grade, g.cod_grade) num_banca, ' +
        ' p.*, ' +
        ' coalesce(est.estoque, 0) estoque_disponivel, ' +
				' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        ' left join cod_grade_prod g on g.grupo_prod = p.grupo_prod and g.cod_prod = p.cod_prod and g.cod_empresa = p.cod_empresa' +
        ' left join grade gr on gr.cod_grade = g.cod_grade and gr.cod_empresa = g.cod_empresa' +
        ' left join cod_barra cb on cb.grupo_prod = p.grupo_prod and cb.cod_prod = p.cod_prod and cb.cod_empresa = p.cod_empresa and cb.cod_grade = gr.cod_grade' +
        ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, g.cod_grade, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
        ' where p.descr_prod like ' + QuotedStr(codBarra + '%') +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and p.ativo = 1 ' +
        ' order by p.descr_prod ');

      if not dataSet.IsEmpty then
	      vPesquisaPorDesc := true;
    end;

 	  if not dataSet.IsEmpty then
    begin
      if dataSet.RecordCount > 1 then
      begin
        try
        	if frmEscolhaProdutoPedvenda = nil then
          begin
            Application.CreateForm(TfrmEscolhaProdutoPedvenda, frmEscolhaProdutoPedvenda);

            if DtmPedVenda = nil then
              DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

            vDadosIni.AlterarDataSourceComponentes(frmEscolhaProdutoPedvenda, FOwner.DtmPed);
          end;

          frmEscolhaProdutoPedvenda.vProdServ := 'P';
          if frmEscolhaProdutoPedvenda.ShowModal <> mrOk then
          begin
          	Result := false;
            exit;
          end;
        finally
          frmEscolhaProdutoPedvenda.Free;
          frmEscolhaProdutoPedvenda := nil;
        end;
      end;
      if vPesquisaPorDesc or (fint('NUM_BANCA') > 0) then
      	codBarra := dataSet.FieldByName('num_fab_prod').AsString;
      if fint('NUM_BANCA') > 0 then
        gradeSel := fint('NUM_BANCA');
    end;

    if dataSet.IsEmpty then
    begin
      if not vBarra.abreCodBarra(codBarra) then
        raise exception.create('Produto não encontrado');
      if not buscaProduto(
      	vBarra.dataSet.FieldByName('grupo_prod').AsInteger,
        vBarra.dataSet.FieldByName('cod_prod').AsString) then
        	raise exception.create('Produto não encontrado');
    end;
    Result := validaProduto;
    {
//    if dataSet.FieldByName('CONSUMO').AsString = 'S' then
    begin
      if venda.dataSet.FieldByName('TIPO').AsString = 'ORC' then
        if dataSet.FieldByName('CONSUMO').AsString = 'S' then
          raise exception.create('Produto para consumo, ' + chr(13) +
            'Favor Verificar no cadastro');

      if venda.dataSet.FieldByName('TIPO').AsString <> 'ORC' then
      begin
        buscas.close;
        if Trim(venda.dataSet.FieldByName('tipo').AsString) = 'REQ' then
          buscas.sql.text := 'select consumo from tipo_vendas' +
            ' where tipo = ' + QuotedStr(venda.dataSet.FieldByName('tipo').AsString) +
            ' and sigla = ' + QuotedStr(venda.dataset.FieldByName('TIPV').AsString) +
            ' order by cod_tipo'
        else if Trim(venda.dataSet.FieldByName('tipo').AsString) = 'OS' then
          buscas.sql.text := 'select consumo from tipo_vendas' +
            ' where tipo = ' + QuotedStr(venda.dataSet.FieldByName('tipo').AsString) +
            ' and tipo_os = ' + QuotedStr(venda.dataset.FieldByName('tipo_os').AsString) +
            ' order by cod_tipo';
        buscas.open;

        if dataSet.FieldByName('CONSUMO').AsString = 'S' then
        begin
          if Trim(buscas.FieldByName('consumo').AsString) <> 'S' then
            raise exception.create('Produto para consumo, ' + chr(13) +
              'Favor Verificar no cadastro');
        end
        else
        begin
          if Trim(buscas.FieldByName('consumo').AsString) = 'S' then
            raise exception.create('Produto não é para consumo. Tipos Vendas de consumo, ' + chr(13) +
              'Favor Verificar no cadastro');
        end;
      end;
    end;
    if venda.dataSet.FieldByName('TIPO').AsString <> 'ORC' then
    begin
      if dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency <= 0 then
        raise exception.create('Produto com custo médio Zerado, ' + chr(13) +
          'Favor Verificar Custo deste produto no cadastro');
    end;
    Result := true;
    }
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

