        Application.MessageBox(Pchar('Pedido de Venda ' + inttostr(pNPED) + ' com nota fiscal série D emitida.' + chr(13) + 'Esta Requisição informada não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
      else if (pTipo = 'OS') then
        Application.MessageBox(Pchar('Pedido de Venda ' + inttostr(pNPED) + ' com nota fiscal série D emitida.' + chr(13) + 'Esta Ordem de Serviço informada não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
      exit;
    end;

    dtSetOrcTemp.First;
    while not dtSetOrcTemp.Eof do
    begin
      if (pNPED = dtSetOrcTemp.FieldByName('NPED').AsInteger) then
      begin
        Application.MessageBox(Pchar('Para mesclagem de DAVs/PreVendas, o DAV/PreVenda de origem deve ser diferente do DAV/PreVenda de destino'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;

      if ExecutaComandosSql('select fp.seqform from FORMPAGAMENTO fp WHERE fp.TPDOCS = ' +
        QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').AsString)) + ' and fp.cod_empresa = ' + vDadosIni.CodEmpresa +
        ' and fp.ativo=1 AND fp.NREQUISICAO = ' + dtSetOrcTemp.FieldByName('nped').AsString) then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Existe forma de pagamento para a Requisição de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Existe forma de pagamento para a Ordem de serviço ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;
      if dtSetOrcTemp.FieldByName('status_cupom').AsString = 'P' then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' está sendo processado pelo cupom Fiscal.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' está sendo processado pelo cupom Fiscal.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;
      if (dtSetOrcTemp.FieldByName('NCUPOM').AsInteger <> 0) then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Cupom fiscal já emitido para o pedido de venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Cupom fiscal já emitido para o pedido de venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;
      if (dtSetOrcTemp.FieldByName('N_NFD').AsInteger <> 0) then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Nota fiscal série D já emitida para o pedido de venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Nota fiscal série D já emitida para o pedido de venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + '.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;
      if dtSetOrcTemp.FieldByName('dia_cxl').AsString <> '' then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' recebido ou sendo recebido no Caixa Auxiliar.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' recebido ou sendo recebido no Caixa Auxiliar.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;

      if retornaValor('SELECT N_NF as valor FROM pedvenda_prod ' +
      	' WHERE nped = ' + dtSetOrcTemp.FieldByName('nped').AsString + ' AND COD_EMPRESA = ' + vDadosIni.CodEmpresa +
        ' and tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').AsString)) +
        ' AND (N_NF <> 0 OR (N_NF IS NOT NULL))') <> '' then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' com nota fiscal emitida.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' com nota fiscal emitida.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;

      if retornaValor('SELECT N_NFD as valor FROM pedvenda_prod ' +
      	' WHERE nped = ' + dtSetOrcTemp.FieldByName('nped').AsString + ' AND COD_EMPRESA = ' + vDadosIni.CodEmpresa +
        ' and tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').AsString)) +
        ' AND (N_NFD <> 0 OR (N_NFD IS NOT NULL))') <> '' then
      begin
        if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'REQ' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' com nota fiscal série D emitida.' + chr(13) + 'Esta Requisição não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK)
        else if trim(dtSetOrcTemp.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Pedido de Venda ' + dtSetOrcTemp.FieldByName('NPED').AsString + ' com nota fiscal série D emitida.' + chr(13) + 'Esta Ordem de Serviço não pode ser mesclada.'), 'Atenção', +MB_ICONWARNING + MB_OK);
        exit;
      end;
      dtSetOrcTemp.Next;
    end;

    if ExecutaComandosSql('select v.nped from pedvenda v ' +
      ' where v.nped = ' + inttostr(pNPED) +
      ' and v.tipo = ' + QuotedStr(trim(pTipo)) +
      ' and v.status_cupom=''P''' +
      ' and v.ativo=1 and v.cod_empresa=' + vDadosIni.codEmpresa) then
    begin
      Application.MessageBox(Pchar('Pedido de Venda ' + inttostr(pNPED) + 'informado está sendo processado pelo cupom Fiscal.' + chr(13) + 'Este Pedido de Venda não pode ser mesclado.'), 'Atenção', +MB_ICONWARNING + MB_OK);
      exit;
    end;
  end;

  dtSetOrcTemp.First;
  if pNPED <> 0 then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select v.cod_cliente from pedvenda v where v.nped = ' + inttostr(pNPED) +
      ' and v.tipo = ' + QuotedStr(trim(pTipo)) + ' and v.ativo=1 and v.cod_empresa=' + vDadosIni.codEmpresa;
    buscas.open;
    if not buscas.IsEmpty then
      vcod_cliente := buscas.FieldByName('COD_CLIENTE').AsInteger;
  end
  else
    vcod_cliente := dtSetOrcTemp.FieldByName('COD_CLIENTE').AsInteger;

  dtSetOrcTemp.First;
  while not dtSetOrcTemp.Eof do
  begin
    if dtSetOrcTemp.FieldByName('COD_CLIENTE').AsInteger <> vcod_cliente then
    begin
      Application.MessageBox(Pchar('Foi feita uma seleção de DAVs de diferentes clientes.' + chr(13) + 'Mesclagem de DAVs permitida apenas para um único cliente.'), 'Atenção', +MB_ICONWARNING + MB_OK);
      exit;
    end;
    dtSetOrcTemp.Next;
  end;
  result := true;
end;

function TPedVenda.validaFaturamento: Boolean;
begin
	try
  	Result := True;

    buscas.Close;
    buscas.SQL.Text := 'SELECT COALESCE(T.STATUS_F, '''') STATUS_F FROM CLIENTES C '+
		'INNER JOIN TIPO_FATURAMENTO T ON T.CODIGO_FATURAMENTO = C.CODIGO_FATURAMENTO '+
		'WHERE T.ATIVO = 1 AND C.COD_CLIENTE = :COD_CLIENTE AND C.COD_EMPRESA = :COD_EMPRESA';
    buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  	buscas.Open;

    if buscas.IsEmpty then
      Exit;

    if Trim(buscas.FieldByName('STATUS_F').AsString) <> 'BARRADO' then
    	Exit;

    if not vDadosIni.PesqPros('VND049', 'LIBERAR',
      dataSet.FieldByName('TIPO').AsString + ' - ' +
      'CLIENTE:' + dataSet.FieldByName('COD_CLIENTE').AsString + ' ' + vCliente.dataSet.FieldByName('NOME_CLIENTE').AsString,
      'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, True) then
        Result := False
    else if Application.MessageBox('Deseja continuar a venda?', 'Confirmação', 0 + 4) = mrNO then
    	Result := False;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.validaLimiteCredito: Boolean;
begin
	try
    Result := True;

    if not vCliente.limiteDeCreditoEstouradoFechamento(dataSet.FieldByName('VALOR_TOTAL').AsCurrency) then
    	Exit;
      
    if not vDadosIni.PesqPros('VND048', 'PERMITIR',
    	dataSet.FieldByName('TIPO').AsString + ' - ' +
    	'CLIENTE:' + dataSet.FieldByName('COD_CLIENTE').AsString, 'PEDVENDA',
      dataSet.FieldByName('NPED').AsString, buscas, True) then
      	Result := False
		else if Application.MessageBox(pchar('Deseja continuar a venda?'), 'Confirmação', 0 + 4) = mrNo then
    		Result := False;
      
  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.validarCamposPersonalizados: Boolean;
var
  vLista: TStrings;
  I: Integer;
begin
	try
    Result := True;
    vLista := TStringList.Create;
    vLista := vDadosIni.getConfSisBlob('ped_vnd_campos_obrigatorios', buscas);

    if vLista.Count = 0 then
      Exit;

    Result := False;
    try

      for I := 0 to vLista.Count - 1 do
        if I > 0 then
        begin
          fStrTmp := Trim(vDadosIni.getValue(vLista.Strings[I], 4));
          if (trim(getTipoVenda) = 'REQ')
            and (trim(getTipoVenda) = trim(vDadosIni.getValue(vLista.Strings[I], 4))) then
          begin
            if dataset.FindField(vDadosIni.getValue(vLista.Strings[I], 1)) <> nil then
              checkFieldEmpty(
                vDadosIni.getValue(vLista.Strings[I], 1),
                vDadosIni.getValue(vLista.Strings[I], 2),
                vDadosIni.getValue(vLista.Strings[I], 3));
          end
          else if (trim(getTipoVenda) = 'ORC') and (OrcamentoSoPecas)
            and (trim(vDadosIni.getValue(vLista.Strings[I], 4)) = 'ORCP') then
          begin
            if dataset.FindField(vDadosIni.getValue(vLista.Strings[I], 1)) <> nil then
              checkFieldEmpty(
                vDadosIni.getValue(vLista.Strings[I], 1),
                vDadosIni.getValue(vLista.Strings[I], 2),
                vDadosIni.getValue(vLista.Strings[I], 3));
          end
          else if (trim(getTipoVenda) = 'ORC') and (not OrcamentoSoPecas)
            and (trim(vDadosIni.getValue(vLista.Strings[I], 4)) = 'ORCPS') then
          begin
            if dataset.FindField(vDadosIni.getValue(vLista.Strings[I], 1)) <> nil then
              checkFieldEmpty(
                vDadosIni.getValue(vLista.Strings[I], 1),
                vDadosIni.getValue(vLista.Strings[I], 2),
                vDadosIni.getValue(vLista.Strings[I], 3));
          end
          else if (trim(getTipoVenda) = 'OS')
            and (trim(getTipoVenda) = trim(vDadosIni.getValue(vLista.Strings[I], 4))) then
          begin
            if dataset.FindField(vDadosIni.getValue(vLista.Strings[I], 1)) <> nil then
              checkFieldEmpty(
                vDadosIni.getValue(vLista.Strings[I], 1),
                vDadosIni.getValue(vLista.Strings[I], 2),
                vDadosIni.getValue(vLista.Strings[I], 3));
          end;
        end;

      Result := True;

    except on E: Exception do
      begin
        Result := False;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(vLista) then
    	FreeAndNil(vLista);
  end;
end;

function TPedVenda.validarestoqueItProd(pNPED, pGrupoprod, pCodgrade: integer;
  pTipo, pCodprod: string; pQtdeItem: double): boolean;
var
  nome_venda, sql, sqlTemp: string;
  vest, vQtdTotalItemNoPedido, qtdItemDisponivel: double;
  vTipoVenda, vAbaterItens: string;
  vCodVendedor: Integer;
begin
  try
    Result := true;
    qtdItemDisponivel := 0;
    vest := vItProd.vProduto.getQtdeDisponivelEmEstoque(pNPED, pGrupoprod, pCodprod);

    dtSetItVndTemp.First;
    while not dtSetItVndTemp.Eof do
    begin
      if (pGrupoprod = dtSetItVndTemp.FieldByName('GRUPO_PROD').AsInteger) and
        (trim(pCodprod) = trim(dtSetItVndTemp.FieldByName('COD_PROD').AsString)) and
        (trim(dtSetItVndTemp.FieldByName('STATUS').AsString) <> 'CANCELADO') then
        vest := vest - dtSetItVndTemp.FieldByName('quant_ped_item').AsFloat;
      dtSetItVndTemp.Next;
    end;
    if not ((vest >= pQtdeItem) or (vDadosIni.vEstoqueNegativo = 'S')) then
    begin
      Application.MessageBox(Pchar('Produto ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('NUM_FAB_PROD').Asstring)) +
      	' - ' + trim(vItProd.dtSetIt.FieldByName('DESCR_PROD_PED').AsString) + sLineBreak +
        IfThen(vest <= 0,
      		'sem estoque', 'sem estoque suficiente') + '.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      result := false;
      exit;
    end
    else if (vest < pQtdeItem) and (vDadosIni.vEstoqueNegativo = 'S') then
    begin
      if Application.MessageBox(pchar('Erro com o item Nº : ' + vItProd.dtSetIt.FieldByName('NITEM').Asstring +
      	' - ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('NUM_FAB_PROD').Asstring)) +
      	' - ' + trim(vItProd.dtSetIt.FieldByName('DESCR_PROD_PED').AsString) + ' ' + nome_venda + chr(13) +
        'Quantidade deste item no orçamento = ' + floattostr(pQtdeItem) + chr(13) +
        'Quantidade disponível = ' + floattostr(vest) + chr(13) +
        'Deseja exportar o item mesmo assim?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDNO then
      begin
        Result := false;
        exit;
      end;
    end;

    if pCodgrade <> 0 then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select cod_grade from cod_grade_prod' +
        ' where grupo_prod = ' + IntToStr(pGrupoprod) +
        ' and cod_prod = ' + QuotedStr(pCodprod) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_grade = ' + IntToStr(pCodgrade);
      buscas.Open;

      if buscas.IsEmpty then
        raise exception.create(pchar('Erro com o item Nº : ' + vItProd.dataSet.FieldByName('NITEM').Asstring + #13 +
          'Grade de código ' + IntToStr(pCodgrade) + ' não encontrada para o produto'));

      buscas.Close;
      buscas.SQL.Text := 'select ' +
        ' (coalesce(cgp.qtde, 0) - ' +
        '  coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod pp ' +
        ' 				   inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
        '            where pp.grupo_prod = cgp.grupo_prod ' +
        '            and pp.cod_prod = cgp.cod_prod ' +
        '            and pp.cod_grade = cgp.cod_grade ' +
        '            and pp.cod_empresa = cgp.cod_empresa ' +
        '            and coalesce(v.status_ped, '''') = '''' ' +
        '            and coalesce(pp.status, '''') = '''' ' +
        '            and v.NPED <> ' + inttostr(pNPED) +
        '            sql_tipo),0) - ' +
        '	 coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod pp ' +
        '            inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
        '            where pp.grupo_prod = cgp.grupo_prod ' +
        '            and pp.cod_prod = cgp.cod_prod ' +
        '            and pp.cod_grade = cgp.cod_grade ' +
        '            and pp.cod_empresa = cgp.cod_empresa ' +
        '            and coalesce(v.status_ped, '''') = '''' ' +
        '            and coalesce(pp.status, '''') = '''' ' +
        '            and v.NPED = ' + inttostr(pNPED) +
        '            and v.tipo = ' + QuotedStr(trim(pTipo)) + ' ),0) + ' +
        '  coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        ' 				   cgp.grupo_prod, ' +
        '            cgp.cod_prod, ' +
        '            cgp.cod_empresa, ' +
        '            cgp.cod_grade)), 0) ' +
        ') as qtd_item_disponivel ' +
        ' from grade g ' +
        ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
        ' where cgp.grupo_prod = ' + inttostr(pGrupoprod) +
        ' and cgp.cod_prod = ' + QuotedStr(trim(pCodprod)) +
        ' and cgp.cod_grade = ' + inttostr(pCodgrade) +
        ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by g.cod_grade';

      if (vDadosIni.vEmp.vApresentarEstR = 'S') then
        sql := sql + ' and v.tipo <> ''ORC'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'R') then
        sql := sql + ' and v.tipo = ''REQ'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'O') then
        sql := sql + ' and v.tipo = ''OS''';

      if (vDadosIni.vEmp.vApresentarEstR = 'R') or
        (vDadosIni.vEmp.vApresentarEstR = 'O') or
        (vDadosIni.vEmp.vApresentarEstR = 'S') then
      begin
        buscas.SQL.Text := StringReplace(buscas.SQL.Text, 'sql_tipo', sql, [rfReplaceAll, rfIgnoreCase]);
        buscas.Open;
        qtdItemDisponivel := buscas.FieldByName('qtd_item_disponivel').AsFloat;
      end
      else
      begin
        buscas.SQL.Text := 'select ' +
        	' (coalesce(cgp.qtde, 0) - ' +
        	'  coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from  pedvenda_prod pp ' +
          '            inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
          '            where pp.grupo_prod = cgp.grupo_prod ' +
          '            and pp.cod_prod = cgp.cod_prod ' +
          '            and pp.cod_grade = cgp.cod_grade ' +
          '            and pp.cod_empresa = cgp.cod_empresa ' +
          '            and coalesce(v.status_ped, '''') = '''' ' +
          '            and coalesce(pp.status, '''') = '''' ' +
          '            and v.nped = ' + inttostr(pNPED) +
          '            and v.tipo = ' + QuotedStr(trim(pTipo)) + '), 0) + ' +
          '  coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
          ' 				   cgp.grupo_prod, ' +
          '            cgp.cod_prod, ' +
          '            cgp.cod_empresa, ' +
          '            cgp.cod_grade)), 0) ' +
          ' ) as qtd_item_disponivel ' +
          ' from grade g ' +
          ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
          ' where cgp.grupo_prod = ' + inttostr(pGrupoprod) +
          ' and cgp.cod_prod = ' + QuotedStr(trim(pCodprod)) +
          ' and cgp.cod_grade = ' + inttostr(pCodgrade) +
          ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' order by g.cod_grade ';
        buscas.Open;
        qtdItemDisponivel := buscas.FieldByName('qtd_item_disponivel').AsFloat;
      end;

      if vDadosIni.vEmp.vAbaterItens = 'S' then
      begin
        vAbaterItens := retornaValor('select first 1 coalesce(usar_conferencia_produto, '''') as valor from tipo_vendas ' +
          ' where tipo = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
          ' and sigla = ' + QuotedStr(dataset.FieldByName('TIPV').AsString) +
          ' order by cod_tipo');

        if trim(vAbaterItens) <> 'S' then
        begin
          sql := 'select sum(coalesce(itpd.quant_ped_item, 0)) as soma1 from pedvenda pd ' +
           ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo ' +
           ' inner join tipo_vendas tv on tv.sigla = pd.tipv and tv.tipo = pd.tipo ' +
           ' where pd.ativo = 1 and itpd.grupo_prod = :grupo and itpd.cod_prod = :codigo ' +
           ' and itpd.cod_grade = :cod_grade ' +
           ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
           ' and (coalesce(tv.usar_conferencia_produto, '''') = ''S'') ' +
           ' and (pd.data_fech is null or pd.data_fech < :data) ' +
           ' and (itpd.status <> ''CANCELADO'' or itpd.status is null) ' +
           ' and pd.cod_vendedor = :cod_vendedor ';

          sqlTemp := sql;
          buscas.Close;
          if vDadosIni.vEmp.vApresentarEstR = 'S' then
            sql := sql + ' and pd.tipo <> ''ORC'''
          else if vDadosIni.vEmp.vApresentarEstR = 'R' then
            sql := sql + ' and pd.tipo = ''REQ'''
          else if vDadosIni.vEmp.vApresentarEstR = 'O' then
            sql := sql + ' and pd.tipo = ''OS''';
          if (vDadosIni.vEmp.vApresentarEstR = 'R') or
            (vDadosIni.vEmp.vApresentarEstR = 'O') or
            (vDadosIni.vEmp.vApresentarEstR = 'S') then
          begin
            buscas.SQL.Text := sql;
            buscas.Params[0].AsInteger := pGrupoprod;
            buscas.Params[1].AsString := pCodprod;
            buscas.Params[2].AsInteger := pCodgrade;
            buscas.Params[3].AsDate := 0;
            buscas.Params[4].AsInteger := dataSet.FieldByName('cod_vendedor').AsInteger;
            buscas.Open;
            qtdItemDisponivel := qtdItemDisponivel + buscas.FieldByName('soma1').AsFloat;
    //        buscas.Close;
    //        buscas.sql.Text := sqlTemp + ' and pd.NPED=' + inttostr(venda.dataSet.FieldByName('NPED').asinteger) +
    //          ' and pd.tipo=' + quotedstr(trim(venda.dataSet.FieldByName('TIPO').AsString));
    //        buscas.Params[0].AsInteger := grupo_prod;
    //        buscas.Params[1].AsString := trim(cod_prod);
    //        buscas.Params[2].AsDate := 0;
    //        buscas.Open;
    //        vTemp := vTemp - buscas.FieldByName('soma1').AsFloat;
          end;
        end;
      end;
      SqlOpen('select sum(coalesce(pi.quantidade_utilizada, 0) + coalesce(pi.quantidade_perda, 0)) as pendencia from producao pd ' +
      				' inner join producao_item_indice pi on pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa ' +
              ' where pi.grupo_prod = %d ' +
              ' and pi.cod_prod = %s %s ' +
              ' and (pd.data_fechamento is null) ' +
              ' and pd.cod_empresa = %s ',
              [pGrupoProd, pCodprod, StrUtils.IfThen(pCodGrade > 0, Format(' and pi.cod_grade = %d', [pCodGrade])),
               vDadosIni.codEmpresa]);
      qtdItemDisponivel := qtdItemDisponivel - buscas.FieldByName('pendencia').AsFloat;

      if pQtdeItem > qtdItemDisponivel then
      begin
        if (vDadosIni.vEstoqueNegativo <> 'S') then
        begin
          Application.MessageBox(pchar('Erro com o item Nº : ' + vItProd.dataSet.FieldByName('nitem').Asstring + ' do orçamento.' + sLineBreak +
            'Quantidade informada = ' + floattostr(vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) + sLineBreak +
            'Quantidade disponível = ' + floattostr(qtdItemDisponivel) + sLineBreak + sLineBreak +
            'Quantidade maior que o estoque da Grade ' + vItProd.dataSet.FieldByName('cod_grade').AsString), 'Informação',
            MB_ICONINFORMATION + MB_OK);
          Result := false;
        end
        else
        begin
          if Application.MessageBox(pchar('Erro com o item Nº : ' + vItProd.dataSet.FieldByName('nitem').Asstring + ' ' + nome_venda + sLineBreak +
            'Quantidade informada = ' + floattostr(vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) + sLineBreak +
            'Quantidade disponível = ' + floattostr(qtdItemDisponivel) + sLineBreak + sLineBreak +
            'Quantidade maior que o estoque da Grade ' + vItProd.dataSet.FieldByName('cod_grade').AsString +
            '. Deseja baixar o item mesmo assim?'), 'Confirmação',
            MB_ICONQUESTION + MB_YESNO) = IDNO then
            Result := false;
        end;
      end;
      buscas.close;
    end;
  except
    on e: exception do
    begin
      buscas.close;
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

