      	if vCodClienteAlterCliente <> dataSet.FieldByName('cod_vendedor').AsInteger then
          vDadosIni.GravaAuditoria('VND160', 'ALTERAR', 'FALHA - ' +
          	'VEND ANT:' + IntToStr(vCodVendedorAlterCliente) + ' VEND NOVO:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger),
            'PEDVENDA', trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabClienteAlterClienteFpCred then
      	if vCodVendedorAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger then
	        vDadosIni.GravaAuditoria('VND238', 'ALTERAR', 'FALHA - ' +
            'CLI ANT:' + IntToStr(vCodVendedorAlterCliente) + ' CLI NOVO:' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger),
            'PEDVENDA', trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabControleAlterClienteVnd then
      	if vCodControleAlterCliente <> dataSet.FieldByName('cod_controle').AsInteger then
        	vDadosIni.GravaAuditoria('VND162', 'ALTERAR', 'FALHA - ' +
            'CTRL ANT:' + IntToStr(vCodControleAlterCliente) + ' CTRL NOVO:' + IntToStr(dataSet.FieldByName('cod_controle').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

