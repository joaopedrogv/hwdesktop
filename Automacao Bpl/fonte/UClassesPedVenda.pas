procedure TPedVendaProd.setDescricaoValorPeloVendaRapida(
	valor: Currency;
  unidade: string;
  descricao: string);
begin
  if dataSet.State in [dsedit, dsInsert] then
  begin
    dataSet.FieldByName('descr_prod_ped').asstring := descricao;

    if (UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) <> UpperCase(trim(Unidade))) then
    begin
      dataSet.FieldByName('vlun_ped_item_conv').AsCurrency := RoundTo(
      	valor, - StrToInt(vSing.vCasasDecimais));
        
      if dataSet.FieldByName('operacao_conv').AsString = 'M' then
      begin
        dataSet.FieldByName('vlun_ped_item_conv').AsFloat := RoundTo(
        	valor, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('vlun_ped_item').AsFloat := RoundTo(
          dataSet.FieldByName('vlun_ped_item_conv').AsFloat *
            dataSet.FieldByName('fator_conv').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end
      else if dataSet.FieldByName('operacao_conv').AsString = 'D' then
      begin
        dataSet.FieldByName('vlun_ped_item_conv').AsFloat := RoundTo(
        	valor, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('vlun_ped_item').AsFloat := RoundTo(
          dataSet.FieldByName('vlun_ped_item_conv').AsFloat /
            dataSet.FieldByName('fator_conv').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end;
    end
    else
    begin
    	dataSet.FieldByName('operacao_conv').Value := Null;
    	dataSet.FieldByName('fator_conv').Value := Null;

    	dataSet.FieldByName('vlun_ped_item').AsCurrency := RoundTo(
      	valor, - StrToInt(vSing.vCasasDecimais));

      dataSet.FieldByName('vlun_ped_item_conv').AsCurrency := RoundTo(
      	dataSet.FieldByName('vlun_ped_item').AsCurrency, - StrToInt(vSing.vCasasDecimais));

    	dataSet.FieldByName('vlun_ped_nf').AsCurrency := RoundTo(
      	valor, - StrToInt(vSing.vCasasDecimais));
    end;
    dataSet.FieldByName('vltot_ped_item').AsCurrency := vDadosIni.StrToFloatFormat(
      dataSet.FieldByName('vlun_ped_item').AsFloat *
      dataSet.FieldByName('quant_ped_item').AsFloat, 2);
    verificaAcresDescNoItem;
  end;
end;

function TPedVendaProd.setItensVendaRapida: boolean;
begin

end;

procedure TPedVendaProd.setQuantidadePeloVendaRapida(
	Qtde: Double;
  Unidade: string);
var
	buscas2: TIBQuery;
begin
	try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if dataSet.State in [dsedit, dsInsert] then
    begin
      if (UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) <> UpperCase(trim(Unidade))) then
      begin
        if SqlOpen(' select ps.grupo_prod, ps.cod_prod, ps.cod_empresa, ps.unidade, ' +
          ' ps.quantidade, ps.operacao, ps.disponivel_venda, ps.padrao_venda, ' +
          ' pr.unidade as unidade_prod from produtos pr ' +
          ' inner join produtos_conversao_saida ps on ' +
          '   ps.grupo_prod = pr.grupo_prod ' +
          '		and ps.cod_prod = pr.cod_prod ' +
          '   and ps.cod_empresa = pr.cod_empresa ' +
          ' where ps.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and ps.cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and upper(ps.unidade) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) +
          ' and ps.quantidade > 0 ' +
          ' and ((ps.operacao = ''M'') or (ps.operacao = ''D'')) ', buscas2).IsEmpty then
            exit;

        dataSet.FieldByName('operacao_conv').AsString := buscas2.FieldByName('operacao').AsString;
        dataSet.FieldByName('fator_conv').AsFloat := buscas2.FieldByName('quantidade').AsFloat;
        dataSet.FieldByName('quant_ped_item_conv').AsFloat := RoundTo(Qtde, - 4);

        if buscas2.FieldByName('operacao').AsString = 'M' then
        begin
          dataSet.FieldByName('quant_ped_item').AsFloat := RoundTo(
            dataSet.FieldByName('quant_ped_item_conv').AsFloat /
            buscas2.FieldByName('quantidade').AsFloat, - 4);
        end
        else if buscas2.FieldByName('operacao').AsString = 'D' then
        begin
          dataSet.FieldByName('quant_ped_item').AsFloat := RoundTo(
            dataSet.FieldByName('quant_ped_item_conv').AsFloat *
            buscas2.FieldByName('quantidade').AsFloat, - 4);
        end;
      end
      else
      begin
        dataSet.FieldByName('operacao_conv').Value := Null;
        dataSet.FieldByName('fator_conv').Value := Null;
        dataSet.FieldByName('quant_ped_item').AsFloat := RoundTo(Qtde, - 4);
        dataSet.FieldByName('quant_ped_item_conv').AsFloat := RoundTo(dataSet.FieldByName('quant_ped_item').AsFloat, - 4);
      end;

      dataSet.FieldByName('vltot_ped_item').AsCurrency := vDadosIni.StrToFloatFormat(
        dataSet.FieldByName('vlun_ped_item').AsFloat *
        dataSet.FieldByName('quant_ped_item').AsFloat, 2);

      verificaAcresDescNoItem;
    end;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaProd.validaAcresDescNoItem(AcrescDesc,
  ValorouPercentual: string; valor: currency): boolean;
var
	vExibirDesconto: string;
begin
	descontoP := 0;
  descontoV := 0;
  descontoVini := 0;
  acrescimoP := 0;
  acrescimoV := 0;

  result := false;
  if not (dataSet.State in [dsInsert, dsEdit]) then
  begin
    result := true;
    exit;
  end;
  if valor <= 0 then
  begin
    dataSet.FieldByName('desc_item').AsCurrency := 0;
    dataSet.FieldByName('acresc_item').AsCurrency := 0;
    result := true;
    exit;
  end;

  if dataSet.FieldByName('vltot_ped_item').AsCurrency <= 0 then
    if not checaValoresItens then
      exit;

//  if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') and (AcrescDesc = 'DESCONTO') then
//  begin
//    Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
//    exit;
//  end;
//  if ((vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S')
//  		or (dataSet.FieldByName('TABPRATICADA').AsString = 'P')
//    	or (dataSet.FieldByName('TABPRATICADA').AsString = 'T')
//    	or (dataSet.FieldByName('TABPRATICADA').AsString = 'Q'))
//  	and (AcrescDesc = 'DESCONTO') then
  if (AcrescDesc = 'DESCONTO') then
  begin
    {if (not vDadosIni.vPedVnd.alterarPrecoProdutosQtde) and (dataSet.FieldByName('PRECOPORQTDE').AsString = 'S') then
    begin
      Application.MessageBox(pchar('Existe preço por quantidade para o item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + chr(13) + 'Desconto não é permitido.'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end
    else}
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
    begin
    	vExibirDesconto := 'N';
    	if dataSet.FieldByName('TABPRATICADA').AsString = 'P' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao
      else if dataSet.FieldByName('TABPRATICADA').AsString = 'T' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado
    	else if dataSet.FieldByName('TABPRATICADA').AsString = 'Q' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde;

      if (vExibirDesconto = 'S')
      	and (dataSet.FieldByName('VALOR_DESCACRES').AsCurrency > 0)
      	and (vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLUN_PED_ITEM').AsFloat - dataSet.FieldByName('VLUN_ORIG').AsFloat, 2) >=
             vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat / dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 2)) then
          //
      else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end
			else if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat = 0) then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end;
    end
    else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
    begin
      Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;
  end;

  if dataSet.State in [dsInsert, dsEdit] then
  begin
    dataSet.FieldByName('desc_item').AsCurrency := 0;
    dataSet.FieldByName('acresc_item').AsCurrency := ((
      dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV;
    if AcrescDesc = 'DESCONTO' then
    begin
      if ValorouPercentual = 'PERCENTUAL' then
        descontoP := valor
      else
      begin
        descontoV := valor;

        if (dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S') then
        begin
        	if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
            descontoVini :=
              vDadosIni.StrToFloatFormat(
                (dataSet.FieldByName('vlun_ped_item').AsFloat -
                 dataSet.FieldByName('vlun_orig').AsFloat) *
                dataSet.FieldByName('quant_ped_item').AsFloat, 2);
        end
        else if (dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S') then
        begin
        	if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
            descontoVini :=
              vDadosIni.StrToFloatFormat(
                (dataSet.FieldByName('vlun_ped_item').AsFloat -
                 dataSet.FieldByName('vlun_orig').AsFloat) *
                dataSet.FieldByName('quant_ped_item').AsFloat, 2)
        end
        else if (dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S') then
        begin
        	if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
            descontoVini :=
              vDadosIni.StrToFloatFormat(
                (dataSet.FieldByName('vlun_ped_item').AsFloat -
                 dataSet.FieldByName('vlun_orig').AsFloat) *
                dataSet.FieldByName('quant_ped_item').AsFloat, 2);
      	end
      end;
    end
    else
    begin
      if ValorouPercentual = 'PERCENTUAL' then
        acrescimoP := valor
      else
        acrescimoV := valor;
    end;

    if (descontoP < 0) or (descontoV < 0) then
    begin
      Application.MessageBox(pchar('Percentual ou Valor do Desconto para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if (acrescimoP < 0) or (acrescimoV < 0) then
    begin
      Application.MessageBox(pchar('Percentual ou Valor do Acréscimo para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if (((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) > dataSet.FieldByName('vltot_ped_item').AsCurrency then
    begin
      Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o valor do item'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    vProduto.buscaProduto(
    	dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString);
    //    if vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N' then  só no rateio

    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
    begin
      if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
        if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100)) then
        begin
        	if descontoVini > 0 then
          	Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
              'Total Bruto: ' + format('%m', [dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency]) + #13 +
              'Desconto total (' + format('%m', [((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV]) + ') - ' +
          		'Desconto inicial (' + format('%m', [descontoVini]) + ') = ' +
          		'Desconto adicional (' + format('%m', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]) + ')'  + #13 +
              'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
              format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))]) + #13 + #13 +
              'Não considera desconto informados nos totais.'), 'Atenção', MB_OK + MB_ICONINFORMATION)
          else
          	Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
            	'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
              format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);
          exit;
        end;
    end
    else
    begin
      if vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat > 0 then
        if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100)) then
        begin
          Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
          	'Máximo Permitido: ' + Format('%0.2f', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) + '% - ' +
            format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);

          if not vDadosIni.PesqPros('VND240', 'LIBERAR',
            'Tipo: ' + trim(dataSet.FieldByName('tipo').AsString) +
            ' Grupo : ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
            ' CodProd: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) +
            ' Perc Perm: ' + format('%n', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) +
            ' Perc Inf: ' + Format('%n', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]),
            'PEDVENDA',
            dataSet.FieldByName('NPED').asstring, buscas, true) then
          exit;
        end;
    end;

    dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV,2);
    dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV,2);
    if ffloat('desc_item'  ) <= 0 then fdata('desc_item').Put(0);
    if ffloat('acresc_item') <= 0 then fdata('acresc_item').Put(0);
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
      dataSet.FieldByName('rateio_desc').AsCurrency := dataSet.FieldByName('desc_item').AsCurrency;
    result := true;
  end
  else
  begin
    result := true;
  end;
end;

function TPedVendaProd.validaAcresDescNoItem2: boolean;
var
	vExibirDesconto: string;
begin
  result := false;

  if dataSet.FieldByName('TP_DESCACRES').AsString = 'DESCONTO' then
  begin
  	if (dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S') then
    begin
      if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
      begin
        descontoVini :=
          vDadosIni.StrToFloatFormat(
            (dataSet.FieldByName('vlun_ped_item').AsFloat -
             dataSet.FieldByName('vlun_orig').AsFloat) *
            dataSet.FieldByName('quant_ped_item').AsFloat, 2);

        if dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR' then
        	descontoV := descontoV + descontoVini;
      end;
    end
    else if (dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S') then
    begin
      if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
      begin
        descontoVini :=
          vDadosIni.StrToFloatFormat(
            (dataSet.FieldByName('vlun_ped_item').AsFloat -
             dataSet.FieldByName('vlun_orig').AsFloat) *
            dataSet.FieldByName('quant_ped_item').AsFloat, 2);

        if dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR' then
        	descontoV := descontoV + descontoVini;
      end;
    end
    else if (dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S') then
    begin
      if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
      begin
        descontoVini :=
          vDadosIni.StrToFloatFormat(
            (dataSet.FieldByName('vlun_ped_item').AsFloat -
             dataSet.FieldByName('vlun_orig').AsFloat) *
            dataSet.FieldByName('quant_ped_item').AsFloat, 2);

        if dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR' then
        	descontoV := descontoV + descontoVini;
      end;
    end
  end;

  if (descontoP < 0) or (descontoV < 0) then
  begin
    Application.MessageBox(pchar('Percentual ou Valor do Desconto para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  if (acrescimoP < 0) or (acrescimoV < 0) then
  begin
    Application.MessageBox(pchar('Percentual ou Valor do Acréscimo para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

  if (((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) > dataSet.FieldByName('vltot_ped_item').AsCurrency then
  begin
    Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o valor do item'), 'Atenção', MB_OK + MB_ICONINFORMATION);
    exit;
  end;

	if ((descontoP > 0) or (descontoV - descontoVini > 0)) then
  begin
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
    begin
      vExibirDesconto := 'N';
      if dataSet.FieldByName('TABPRATICADA').AsString = 'P' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao
      else if dataSet.FieldByName('TABPRATICADA').AsString = 'T' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado
    	else if dataSet.FieldByName('TABPRATICADA').AsString = 'Q' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde;

      if (dataSet.FieldByName('TP_DESCACRES').AsString = 'DESCONTO')
      	and (dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR')
        and ((descontoP > 0) or (descontoV - descontoVini > 0)) then
      begin
      	if dataSet.State in [dsEdit, dsInsert] then
          dataSet.FieldByName('VALOR_DESCACRES').AsCurrency :=
            dataSet.FieldByName('VALOR_DESCACRES').AsCurrency +
            vDadosIni.StrToFloatFormat(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + (descontoV - descontoVini),2);
      end;

    	if (vExibirDesconto = 'S')
      	and (dataSet.FieldByName('VALOR_DESCACRES').AsCurrency > 0)
      	and (vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLUN_PED_ITEM').AsFloat - dataSet.FieldByName('VLUN_ORIG').AsFloat, 2) >=
          	 vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat / dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 2)) then
          //
      else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end
      else if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat = 0) then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end;
    end
    else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
    begin
      Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;
  end;

	if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
  begin
    if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
      if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
        (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100)) then
      begin
        if descontoVini > 0 then
          Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 +  #13 +
            'Total Bruto: ' + format('%m', [dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency]) + #13 +
            'Desconto total (' + format('%m', [((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV]) + ') - ' +
            'Desconto inicial (' + format('%m', [descontoVini]) + ') = ' +
            'Desconto adicional (' + format('%m', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]) + ')'  + #13 +
            'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
            format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))]) + #13 + #13 +
            'Não considera desconto informados nos totais.'), 'Atenção', MB_OK + MB_ICONINFORMATION)
        else
          Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
          	'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
            format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end;
  end
  else
  begin
    if vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat > 0 then
      if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
        (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100)) then
      begin
        Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
        	'Máximo Permitido: ' + Format('%0.2f', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) + '% - ' +
          format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);

        if not vDadosIni.PesqPros('VND240', 'LIBERAR',
          'Tipo: ' + trim(dataSet.FieldByName('tipo').AsString) +
          ' Grupo : ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' CodProd: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) +
          ' Perc Perm: ' + format('%n', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) +
          ' Perc Inf: ' + Format('%n', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]),
          'PEDVENDA',
          dataSet.FieldByName('NPED').asstring, buscas, true) then
        exit;
      end;
  end;

  result := true;
end;

function TPedVendaProd.validaEstoqueGradeProduto: boolean;
var
  nome_venda, codprod, sql, sqlTemp: string;
  vQtdeItem, qtdItemDisponivel: double;
  grupoprod, codgrade: integer;
  vAbaterItens: string;
  vEstoqueNegativo: string;
  vtemp: string;
  vtemp2: string;
begin
  try
    Result := true;
    if dataSet.FieldByName('cod_grade').AsInteger = 0 then
      exit;

    vEstoqueNegativo := 'N';
    vDadosIni.vInibeMensPesqPros := 'S';
    if vDadosIni.PesqPros('VND281', 'PERMITIR', FOwner.getTipoVenda, 'PEDVENDA', FOwner.dataSet.FieldByName('NPED').AsString, buscas, false) then
      vEstoqueNegativo := 'S';

    if vSing.vTipoVenda = 'REQ' then
      nome_venda := 'da requisição.'
    else if vSing.vTipoVenda = 'OS' then
      nome_venda := 'da Ordem de Serviço.';

    vQtdeItem := dataSet.FieldByName('quant_ped_item').AsFloat;
    grupoprod := dataSet.FieldByName('grupo_prod').asinteger;
    codprod := trim(dataSet.FieldByName('cod_prod').AsString);
    codgrade := dataSet.FieldByName('cod_grade').asinteger;
    try
      dtSet.Filter:=' grupo_prod='+dataSet.FieldByName('grupo_prod').AsString+ ' and cod_prod = '+QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString));
      dtSet.Filtered:=true;
      dtSet.First;
      while not dtSet.Eof do
      begin
        if (dtSet.FieldByName('NITEM').asinteger <> dataSet.FieldByName('NITEM').asinteger) and
          (grupoprod = dtSet.FieldByName('grupo_prod').asinteger) and
          (codprod = trim(dtSet.FieldByName('cod_prod').AsString)) and
          (trim(dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') and
          (dtSet.FieldByName('cod_grade').asinteger = codgrade) then
          vQtdeItem := vQtdeItem + dtSet.FieldByName('quant_ped_item').AsFloat;
        dtSet.Next;
      end;
    finally
      dtSet.Filtered:=false;
      dtSet.Filter:=''
    end;
    //    if vSing.vTipoVenda = 'ORC' then
    //    sqlTemp:=''

    buscas.Close;
    buscas.SQL.Text := 'select cod_grade from cod_grade_prod' +
      ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
      ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger);
    buscas.Open;

    if buscas.IsEmpty then
      raise exception.create(pchar('Erro com o item Nº : ' + dataSet.FieldByName('NITEM').Asstring + #13 +
        'Grade de código ' + IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger) + ' não encontrada para o produto'));

    buscas.Close;
    buscas.SQL.Text := 'select ' +
    	' (coalesce(cgp.qtde, 0) - ' +
      '  coalesce((select sum(pp.quant_ped_item) from pedvenda_prod pp ' +
      '            inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
      '            where pp.grupo_prod = cgp.grupo_prod ' +
      '            and pp.cod_prod = cgp.cod_prod ' +
      '            and pp.cod_grade = cgp.cod_grade ' +
      '            and pp.cod_empresa = cgp.cod_empresa ' +
      '            and coalesce(v.status_ped, '''') = '''' ' +
      '            and coalesce(pp.status, '''') = '''' ' +
      '            and v.NPED <> ' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
      '            sql_tipo), 0) + ' +
      '  coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
      ' 				   cgp.grupo_prod, ' +
      '            cgp.cod_prod, ' +
      '            cgp.cod_empresa, ' +
      '            cgp.cod_grade)), 0) ' +
      ' ) as qtd_item_disponivel ' +
      ' from grade g ' +
      ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
      ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
      ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
      ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
      ' and cgp.cod_empresa =' + vDadosIni.codEmpresa +
      ' order by g.cod_grade';
    if (vDadosIni.vEmp.vApresentarEstR = 'S') then
      sql := sql + ' and v.tipo <> ''ORC'''
    else if (vDadosIni.vEmp.vApresentarEstR = 'R') then
      sql := sql + ' and v.tipo = ''REQ'''
    else if (vDadosIni.vEmp.vApresentarEstR = 'O') then
      sql := sql + ' and v.tipo = ''OS''';

    if (vDadosIni.vEmp.vApresentarEstR = 'R') or
      (vDadosIni.vEmp.vApresentarEstR = 'O') or
      (vDadosIni.vEmp.vApresentarEstR = 'S') then
      buscas.SQL.Text := StringReplace(buscas.SQL.Text, 'sql_tipo', sql, [rfReplaceAll, rfIgnoreCase])
    else
      buscas.SQL.Text := 'select coalesce(cgp.qtde, 0) as qtd_item_disponivel from grade g ' +
        ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
        ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
        ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
        ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
        ' and cgp.cod_empresa =' + vDadosIni.codEmpresa +
        ' order by g.cod_grade';
    buscas.Open;
    qtdItemDisponivel := buscas.FieldByName('qtd_item_disponivel').AsFloat;

    if vDadosIni.vEmp.vAbaterItens = 'S' then
    begin
      vAbaterItens := retornaValor('select first 1 coalesce(usar_conferencia_produto, '''') as valor from tipo_vendas ' +
        ' where tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('TIPO').AsString) +
        ' and sigla = ' + QuotedStr(FOwner.dataset.FieldByName('TIPV').AsString) +
        ' order by cod_tipo');

      if trim(vAbaterItens) <> 'S' then
      begin
        sql := 'select sum(coalesce(itpd.quant_ped_item, 0)) as soma1 from pedvenda pd ' +
         ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo ' +
         ' inner join tipo_vendas tv on tv.sigla = pd.tipv and tv.tipo = pd.tipo ' +
         ' where pd.ativo = 1 ' +
         ' and itpd.grupo_prod = :grupo ' +
         ' and itpd.cod_prod = :codigo ' +
         ' and itpd.cod_grade = :cod_grade ' +
         ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
         ' and (coalesce(tv.usar_conferencia_produto, '''') = ''S'') ' +
         ' and (pd.data_fech is null or pd.data_fech < :data) ' +
         ' and (itpd.status <> ''CANCELADO'' or itpd.status is null) ' +
         ' and pd.cod_vendedor = :cod_vendedor ';

        sqlTemp := sql;
        buscas.Close;
        if vDadosIni.vEmp.vApresentarEstR = 'S' then
          sql := sql + ' and pd.tipo <> ''ORC'''
        else if vDadosIni.vEmp.vApresentarEstR = 'R' then
          sql := sql + ' and pd.tipo = ''REQ'''
        else if vDadosIni.vEmp.vApresentarEstR = 'O' then
          sql := sql + ' and pd.tipo = ''OS''';
        if (vDadosIni.vEmp.vApresentarEstR = 'R') or
          (vDadosIni.vEmp.vApresentarEstR = 'O') or
          (vDadosIni.vEmp.vApresentarEstR = 'S') then
        begin
          buscas.SQL.Text := sql;
          buscas.Params[0].AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
          buscas.Params[1].AsString := dataSet.FieldByName('cod_prod').AsString;
          buscas.Params[2].AsInteger := dataSet.FieldByName('cod_grade').AsInteger;
          buscas.Params[3].AsDate := 0;
          buscas.Params[4].AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
          buscas.Open;
          qtdItemDisponivel := qtdItemDisponivel + buscas.FieldByName('soma1').AsFloat;
  //        buscas.Close;
  //        buscas.sql.Text := sqlTemp + ' and pd.NPED=' + inttostr(venda.dataSet.FieldByName('NPED').asinteger) +
  //          ' and pd.tipo=' + quotedstr(trim(venda.dataSet.FieldByName('TIPO').AsString));
  //        buscas.Params[0].AsInteger := grupo_prod;
  //        buscas.Params[1].AsString := trim(cod_prod);
  //        buscas.Params[2].AsDate := 0;
  //        buscas.Open;
  //        vTemp := vTemp - buscas.FieldByName('soma1').AsFloat;
        end;
      end;
    end;      
    SqlOpen(' select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as pendecia from producao pd ' +
    				' inner join producao_item_indice pi on pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa ' +
            ' where pi.grupo_prod = %d ' +
            ' and pi.cod_prod = %s %s' +
            ' and (pd.data_fechamento is null) ' +
            ' and pd.cod_empresa = %s ',
            [fint('grupo_prod'), fstr('cod_prod'), StrUtils.IfThen(fint('cod_grade') > 0, Format(' and pi.cod_grade = %d', [fint('cod_grade')])),
             vDadosIni.codEmpresa]);
    qtdItemDisponivel := qtdItemDisponivel - buscas.FieldByName('pendecia').AsFloat;

    if vQtdeItem > qtdItemDisponivel then
    begin
    	if vSing.vTipoVenda = 'REQ' then
    		vtemp2 := ' da Requisição.'
      else if vSing.vTipoVenda = 'OS' then
        vtemp2 := ' da Ordem de Serviço.'
      else
      	vtemp2 := ' ' + nome_venda;

  		vtemp := 'Erro com o item Nº : ' + dataSet.FieldByName('NITEM').Asstring + vtemp2 + sLineBreak +
        ' - ' + QuotedStr(dataSet.FieldByName('DESCR_PROD_PED').AsString) + sLineBreak +
        'Quantidade informada = ' + FloatToStr(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) + '.' + sLineBreak +
        'Quantidade do item já existente nesta venda = ' + FloatToStr(vQtdeItem) + '.' + sLineBreak +
        'Quantidade disponível = ' + FloatToStr(qtdItemDisponivel - vQtdeItem) + '.' + sLineBreak + sLineBreak +
        'Quantidade maior que o estoque da Grade ' + dataSet.FieldByName('COD_GRADE').AsString + '.';

      if (vDadosIni.vEstoqueNegativo = 'S') then
      	vtemp := vtemp + ' Deseja baixar o item mesmo assim?';

      if (vDadosIni.vEstoqueNegativo <> 'S') and (vEstoqueNegativo <> 'S') then
      begin
        if vSing.vTipoVenda = 'REQ' then
          raiseexceptioncreate(vtemp, 'DBedit10') // 'DBedit53') //DBedit14
        else if vSing.vTipoVenda = 'OS' then
          raiseexceptioncreate(vtemp, 'DBedit51');
      end
      else
      begin
        if Application.MessageBox(pchar(vtemp), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO) = IDNO then
        begin
          if vSing.vTipoVenda = 'REQ' then
            vNomeCampoErro := 'DBedit10'
          else
            vNomeCampoErro := 'DBedit51';
          Result := false;
        end;
      end;
    end;
    buscas.close;
  except
    on e: exception do
    begin
      buscas.close;
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TPedVendaProd.validaMargemLucro: boolean;
var
  temp: string;
  vmarkat, vMarkUp, margem2: Double;
begin
  try
    try
      Result := true;
      if (vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S')
        or (dataSet.FieldByName('TABPRATICADA').AsString = 'P')
        or (dataSet.FieldByName('TABPRATICADA').AsString = 'T')
        or (dataSet.FieldByName('TABPRATICADA').AsString = 'Q')
        or (FUsarPrecoCustoTipoVND) then
        Exit;
      // Olhar o Markup estabelecido
      FOwner._setaVariaveisTipoVendas;
      if FOwner.dataSet.FieldByName('TIPV').AsString = 'V' then
      begin
        if (vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat <= 0) and
          (FOwner.vMinMarkUp <= 0) then
        else
        begin
          if (vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat > 0) then
            vMarkUp := vProduto.dataSet.FieldByName('PERC_TB_PROD').AsFloat
          else
            vMarkUp := FOwner.vMinMarkUp;//vDadosIni.vEmp.vMinMarkUpVarejo; //FOwner.vEmp.dataSet.FieldByName('MIN_MARGEM_V').AsFloat;
        end;
        margem2 := FOwner.vMinMargemLiq;//vDadosIni.vEmp.vMinMargemLiqVarejo; //FOwner.vEmp.dataSet.FieldByName('MIN_M_LQ_V').AsFloat;
      end
      else if FOwner.dataSet.FieldByName('TIPV').AsString = 'A' then
      begin
        if vProduto.dataSet.FieldByName('PERC_TB_PRODA').AsFloat > 0 then
          vMarkUp := vProduto.dataSet.FieldByName('PERC_TB_PRODA').AsFloat
        else
          vMarkUp := FOwner.vMinMarkUp;//vDadosIni.vEmp.vMinMarkUpAtac; //FOwner.vEmp.dataSet.FieldByName('MIN_MARGEM_A').AsFloat;
        margem2 := FOwner.vMinMargemLiq;//vDadosIni.vEmp.vMinMargemLiqAtac; //FOwner.vEmp.dataSet.FieldByName('MIN_M_LQ_A').AsFloat;
      end else begin
        vMarkUp := FOwner.vMinMarkUp; //FOwner.vEmp.dataSet.FieldByName('MIN_MARGEM_A').AsFloat;
        margem2 := FOwner.vMinMargemLiq; //FOwner.vEmp.dataSet.FieldByName('MIN_M_LQ_A').AsFloat;
      end;

      if vDadosIni.vEmp.vUsarMarkUpMinimo then
      begin
        if vMarkUp > 0 then
        begin
          if vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency > 0 then
            vmarkat := ((getValorLiqParaMargem - vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency) / vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency) * 100
          else
            vmarkat := 0;
          // Foi adicionado a formatação de casas decimais para evitar divergencias de valores, caso ocorrer novamente verificar a possibilidade de adicionar uma vMarkUp de erro neste teste
          if vDadosIni.StrToFloatFormat(getValorLiqParaMargem,2) <
            vDadosIni.StrToFloatFormat((vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency +
            ((vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency * (vMarkUp - vDadosIni.vEmp.vVndToleranciaMarkUp)) / 100)),2) then
          begin
            Application.MessageBox(pchar('Markup obtido(' + format('%n', [vmarkat]) + ') Menor que Markup estabelecido ' +
              Format('%n', [vMarkUp]) + '%'), 'Informação', MB_ICONINFORMATION + MB_OK);
            if not vDadosIni.PesqPros('VND047', 'LIBERAR',
            	FOwner.dataSet.FieldByName('TIPO').asstring + ' - MARKUP.: ' +
              format('%n', [(((getValorLiqParaMargem) * 100) /
                vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency)]) + '%', 'PEDVENDA',
                FOwner.dataSet.FieldByName('NPED').asstring, buscas, true) then
            begin
              Result := false;
              Exit;
            end;
          end;
        end;
      end;

      //      if (FOwner.vEmp.dataSet.FieldByName('US_MINM_PROD').AsString <> 'S') then
      if vDadosIni.vEmp.vUsarMargemMinProd <> 'S' then
        exit;
      definirMargemProduto(FOwner.dataSet.FieldByName('TIPV').AsString);
      if not CalcCustLiq(vProduto.dataSet.FieldByName('NUM_FAB_PROD').AsString,
        FOwner.dataSet.FieldByName('TIPV').AsString,
        getValorLiqParaMargem {dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency},
        vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency, margem2) then
      begin
        //        if not vDadosIni.PesqPros('VND47', 'LIBERAR', FOwner.dataSet.FieldByName('TIPO').asstring + ' - ' +
        //          ' MARG.: LIQ%', 'PEDVENDA', FOwner.dataSet.FieldByName('NPED').asstring, buscas, true) then
        //        begin
        Result := false;
        Exit;
      end;
    finally
      temp := Format('%8.' + vSing.vCasasDecimais + 'n', [dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency]);
      temp := StringReplace(temp, ' ', '', [rfReplaceAll, rfIgnoreCase]);
      temp := StringReplace(temp, '.', '', [rfReplaceAll, rfIgnoreCase]);
      if dataSet.State in [dsinsert, dsEdit] then
        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(StrToFloat(temp) * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 2);
      if dataSet.State = dsinsert then
        dataSet.FieldByName('VLUN_PED_NF').AsCurrency := dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency;
// O valor original será obtido apenas no método busca produto e não mais será auterado
//      dataSet.FieldByName('VLUN_ORIG').AsCurrency :=
//        dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVendaProd.validarAcrescDescAcrescCondPagComissaoVend: boolean;
var
	ConfigImp: TConfig_sistema_class;
  vStringListTiposReqOs: TStringList;
  vStringListGrupoReqOs: TStringList;
	vCalculoValorProd: string;
  vExisteTpVnd: boolean;
  vComissaoGrupo: Double;
  vComissaoMinVend: Double;
  vComissaoMaxVend: Double;
  vValor_DescAcrescTmp: Double;
  vTmp: Double;
  I: Integer;
begin
	Result := True;

	if not (dataSet.State in [dsInsert, dsEdit]) then
    Exit;

  if not vDadosIni.vPedVnd.AcrescCondPagComissaoVend then
  	Exit;

  try
    ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscas, vDadosIni.cod_empresa);

    vStringListTiposReqOs := TStringList.Create;
    vStringListGrupoReqOs := TStringList.Create;

    if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'REQ' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoREQ')), ',')
    else if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'OS' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoOS')), ',')
    else if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'ORC' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoORC')), ',');

    for I := 0 to vStringListTiposReqOs.Count - 1 do
    begin
      if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'REQ')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPV').AsString))) then
      begin
        vExisteTpVnd := True;
        Break;
      end
      else if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'OS')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPO_OS').AsString))) then
      begin
        vExisteTpVnd := True;
        Break;
      end
      else if (trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'ORC')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(FOwner.dataSet.FieldByName('TIPO_ORC').AsString))) then
      begin
        vExisteTpVnd := True;
        Break;
      end;
    end;

    if not vExisteTpVnd then
      Exit;

    SqlOpen(' select pc.conteudo_flag, pc.perc_peso from perfil_vendedor pv ' +
      ' inner join perfil_comissao pc on pv.codigo_perfil = pc.codigo_perfil ' +
      ' where pv.ativo = 1 ' +
      ' and pv.cod_vendedor = ' + IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger) +
      ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pc.tipo_perfil = ''Venda Geral'' ' +
      ' and pc.tipo_serv_prod = ''Produto'' ' +
      ' and pc.flag_serv_prod = ''Grupo Produto'' ', buscas);

    vComissaoGrupo := 0;
    vStringListGrupoReqOs.Text := trim(buscas.FieldByName('conteudo_flag').AsString);

    for I := 0 to vStringListGrupoReqOs.Count - 1 do
      if trim(vStringListGrupoReqOs[I]) = IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) then
      begin
        vComissaoGrupo := buscas.FieldByName('perc_peso').AsFloat;
        Break;
      end;

    try
      vComissaoMinVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'ComissaoMinVendedor')));
    except
      vComissaoMinVend := 0;
    end;

    try
      vComissaoMaxVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'ComissaoMaxVendedor')));
    except
      vComissaoMaxVend := 0;
    end;

    vCalculoValorProd := UpperCase(trim(ConfigImp.ReadString('Configuracao', 'CalculoValorProd')));
    if trim(vCalculoValorProd) = '' then
      vCalculoValorProd := 'DIVIDIR';

    if (trim(vCalculoValorProd) <> 'DIVIDIR') and (trim(vCalculoValorProd) <> 'MULTIPLICAR') then
      vCalculoValorProd := 'DIVIDIR';

    if dataSet.FieldByName('TP_DESCACRES').AsString = 'DESCONTO' then
    begin
    	if (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > vComissaoGrupo)
        and (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > 0)
        and (vComissaoGrupo > 0) then
      begin
      	Application.MessageBox(Pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
        	'Comissão do vendedor (%) não pode ser maior que ' + FormatFloat('0.000', vComissaoGrupo)), 'Atenção', MB_ICONERROR + MB_OK);
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoGrupo;
        Result := False;
        Exit;
      end
      else if (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > vComissaoMinVend)
        and (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > 0)
        and (vComissaoGrupo <= 0)
        and (vComissaoMinVend > 0)  then
      begin
        Application.MessageBox(Pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
        	'Comissão do vendedor (%) não pode ser maior que ' + FormatFloat('0.000', vComissaoMinVend)), 'Atenção', MB_ICONERROR + MB_OK);
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoMinVend;
        Result := False;
        Exit;
      end;
    end
    else if dataSet.FieldByName('TP_DESCACRES').AsString = 'ACRÉSCIMO' then
    begin
      if (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > vComissaoMaxVend)
        and (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > 0)
        and (vComissaoMaxVend > 0)  then
      begin
        Application.MessageBox(Pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
        	'Comissão do vendedor (%) não pode ser maior que ' + FormatFloat('0.000', vComissaoMaxVend) + '%'), 'Atenção', MB_ICONERROR + MB_OK);
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoMaxVend;
        Result := False;
        Exit;
      end;
    end;

    if (vComissaoGrupo > 0)
      and (dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat <> vComissaoGrupo) then
    begin
      SqlOpen(' select codigo_grup, descricao from grupos ' +
        ' where codigo_grup = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger), buscas);

      if Application.MessageBox(pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
      	'Percentual de comissão definido no perfil de comissão para o grupo: ' +
        IntToStr(buscas.FieldByName('codigo_grup').AsInteger) + ' - ' + trim(buscas.FieldByName('descricao').AsString) + ':' + #13 + #13 +
        'COMISSAO' + #13 +
        'Informada........: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%' + #13 +
        'Perfil Comissão: ' + FormatFloat('0.000', vComissaoGrupo) + '%' + #13 + #13 +
        'Deseja alterar percentual de comissão do vendedor para este item? '),
        'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
      begin
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoGrupo;
        Result := False;
        Exit;
      end;

      if not vDadosIni.PesqPros('VND278', 'PERMITIR',
        FOwner.getTipoVenda +
        ' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
        ' GRUPO: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
        ' COD PROD: ' + dataSet.FieldByName('COD_PROD').AsString +
        ' PERFIL: ' + FormatFloat('0.000', vComissaoGrupo) + '%' +
        ' INF: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%',
        'PEDVENDA',
        FOwner.dataSet.FieldByName('NPED').AsString, buscas, true) then
      begin
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoGrupo;
        Result := False;
        Exit;
      end;
    end;

    if dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat < 0  then
      dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;

    if dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat < 0 then
      dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat := 0;


    if dataSet.FieldByName('TP_DESCACRES').AsString = 'DESCONTO' then
    begin
      if dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat > 0 then
      begin
      	if Application.MessageBox(Pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
        	 'Permitir informar comissão do vendedor (%) para item vendido abaixo do preço: ' + #13 + #13 +
           'COMISSAO ' + #13 +
           'Vendedor: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%' + #13 + #13 +
           'PRECO ' + #13 +
           'Original.:' + 'R$ ' + FormatFloat('0.00', dataSet.FieldByName('VLUN_ORIG').AsCurrency) + #13 +
           'Informado: ' + 'R$ ' + FormatFloat('0.00',
              vDadosIni.IfThen(dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0,
                dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency - dataSet.FieldByName('VALOR_DESCACRES').AsFloat,
           			dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency)) + #13 + #13 +
           'Deseja salvar este item mesmo assim? '),
           'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = ID_NO then
        begin
          dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vPerc_Comissao_Vend3;
          Result := False;
          Exit;
        end;

        if not vDadosIni.PesqPros('VND280', 'PERMITIR',
          FOwner.getTipoVenda +
          ' Grupo Prod: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
          ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString +
          ' Comissao Vend: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%',
          'PEDVENDA',
          FOwner.dataSet.FieldByName('NPED').AsString, buscas, true) then
        begin
          dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vPerc_Comissao_Vend3;
          Result := False;
          Exit;
        end;
      end;
    end
    else if dataSet.FieldByName('TP_DESCACRES').AsString = 'ACRÉSCIMO' then
    begin
    	if trim(vCalculoValorProd) = 'MULTIPLICAR' then
        vValor_DescAcrescTmp :=
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat *
            (1 + ((dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat +
                   dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat) / 100))) -
           dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat
    	else
        vValor_DescAcrescTmp :=
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat /
            (1 - ((dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat +
                   dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat) / 100))) -
           dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat;

      if vDadosIni.StrToFloatFormat(vValor_DescAcrescTmp, 2) > vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat, 2) then
      begin
        if Application.MessageBox(Pchar('O item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + '.' + #13 + #13 +
        	 'Comissão do vendedor (%) + condição de pagamento (%) maior que acréscimo informado: ' + #13 + #13 +
           'COMISSAO ' + #13 +
           'Vendedor: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%' + #13 +
           'Cond Pag: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat) + '%' + #13 + #13 +
           'ACRESCIMO  ' + #13 +
           'Informado: ' + 'R$ ' + FormatFloat('0.00',
            	vDadosIni.IfThen(dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0,
           			dataSet.FieldByName('VALOR_DESCACRES').AsFloat,
                dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency - dataSet.FieldByName('VLUN_ORIG').AsCurrency)) + #13 +
           'Calculado.: ' + 'R$ ' + FormatFloat('0.00', vValor_DescAcrescTmp) + #13 + #13 +
           'Deseja salvar este item mesmo assim? '),
           'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = ID_NO then
        begin
          dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vPerc_Comissao_Vend3;
          Result := False;
          Exit;
        end;

        if not vDadosIni.PesqPros('VND279', 'PERMITIR',
          FOwner.getTipoVenda +
          ' Grupo Prod: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
          ' Cod Prod: ' + dataSet.FieldByName('COD_PROD').AsString +
          ' Comissao Vend: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat) + '%' +
          ' Perc Cond Pag: ' + FormatFloat('0.000', dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat) + '%',
          'PEDVENDA',
          FOwner.dataSet.FieldByName('NPED').AsString, buscas, true) then
        begin
          dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vComissaoGrupo;
          Result := False;
          Exit;
        end;
      end;
    end;

  finally
    if Assigned(ConfigImp) then
      FreeAndNil(ConfigImp);
    if Assigned(vStringListTiposReqOs) then
      FreeAndNil(vStringListTiposReqOs);
    if Assigned(vStringListGrupoReqOs) then
      FreeAndNil(vStringListGrupoReqOs);
  end;
end;

procedure TPedVendaProd.verificaAcresDescNoItem;
begin
  if dataSet.State in [dsInsert, dsEdit] then
  begin
    dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(((
      dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV,2);
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
      dataSet.FieldByName('rateio_desc').AsCurrency := dataSet.FieldByName('desc_item').AsCurrency;
    dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(((
      dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV,2);
  end;
end;

function TPedVendaProd.validaAcresDescNoItem: boolean;
var
	vExibirDesconto: string;
begin
  result := false;

//  if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') and ((descontoP > 0) or (descontoV > 0)) then
//  begin
//    Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
//    exit;
//  end;

//  if ((vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S')
//  		or (dataSet.FieldByName('TABPRATICADA').AsString = 'P')
//    	or (dataSet.FieldByName('TABPRATICADA').AsString = 'T')
//    	or (dataSet.FieldByName('TABPRATICADA').AsString = 'Q'))
//  	and ((descontoP > 0) or (descontoV > 0)) then
	if ((descontoP > 0) or (descontoV - descontoVini > 0)) then
  begin
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
    begin
      vExibirDesconto := 'N';
      if dataSet.FieldByName('TABPRATICADA').AsString = 'P' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao
      else if dataSet.FieldByName('TABPRATICADA').AsString = 'T' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado
    	else if dataSet.FieldByName('TABPRATICADA').AsString = 'Q' then
    		vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde;

    	if (vExibirDesconto = 'S')
      	and (dataSet.FieldByName('VALOR_DESCACRES').AsCurrency > 0)
      	and (vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLUN_PED_ITEM').AsFloat - dataSet.FieldByName('VLUN_ORIG').AsFloat, 2) >=
          	 vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_DESCACRES').AsFloat / dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 2)) then
          //
      else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end
      else if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat = 0) then
      begin
        Application.MessageBox(pchar('Desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ' no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
        exit;
      end;
    end
    else if (vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N') then
    begin
      Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' não é permitido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;
  end;

  if dataSet.State in [dsInsert, dsEdit] then
  begin
    dataSet.FieldByName('desc_item').AsCurrency := 0;
    dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(((
      dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV,2);

    vProduto.buscaProduto(
    	dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString);
    //    if vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N' then  só no rateio

    // colocando as informações sobre o tipo de desconto
    if descontoP > 0 then
    begin
      dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';
      dataSet.FieldByName('NAT_DESCACRES').AsString := 'PERCENTUAL';
      dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := descontoP;
    end;
    if descontoV > 0 then
    begin
      dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';
      dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
      dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := descontoV;
    end;
    if acrescimoP > 0 then
    begin
      dataSet.FieldByName('TP_DESCACRES').AsString := 'ACRÉSCIMO';
      dataSet.FieldByName('NAT_DESCACRES').AsString := 'PERCENTUAL';
      dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := acrescimoP;
    end;
    if acrescimoV > 0 then
    begin
      dataSet.FieldByName('TP_DESCACRES').AsString := 'ACRÉSCIMO';
      dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
      dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := acrescimoV;
    end;

    if (descontoP < 0) or (descontoV < 0) then
    begin
      Application.MessageBox(pchar('Percentual ou Valor do Desconto para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if (acrescimoP < 0) or (acrescimoV < 0) then
    begin
      Application.MessageBox(pchar('Percentual ou Valor do Acréscimo para o item é inválido'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if (((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) > dataSet.FieldByName('vltot_ped_item').AsCurrency then
    begin
      Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o valor do produto'), 'Atenção', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
    begin
      if (dataSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
        if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100)) then
        begin
          if descontoVini > 0 then
          	Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 +  #13 +
              'Total Bruto: ' + format('%m', [dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency]) + #13 +
              'Desconto total (' + format('%m', [((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV]) + ') - ' +
          		'Desconto inicial (' + format('%m', [descontoVini]) + ') = ' +
          		'Desconto adicional (' + format('%m', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]) + ')'  + #13 +
              'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
              format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))]) + #13 + #13 +
              'Não considera desconto informados nos totais.'), 'Atenção', MB_OK + MB_ICONINFORMATION)
          else
          	Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido ' +
            	'Máximo Permitido: ' + Format('%0.2f', [dataSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% - ' +
              format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (dataSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);
          exit;
        end;
    end
    else
    begin
      if vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat > 0 then
        if (((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini) >
          (dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100)) then
        begin
          Application.MessageBox(pchar('Desconto no item ' + dataSet.FieldByName('nitem').asstring + ' - ' + trim(dataSet.FieldByName('num_fab_prod').asstring) + ' maior que o permitido.' + #13 + #13 +
         	  'Máximo Permitido: ' + Format('%0.2f', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) + '% - ' +
            format('%m', [(dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency / 100))])), 'Atenção', MB_OK + MB_ICONINFORMATION);

          if not vDadosIni.PesqPros('VND240', 'LIBERAR',
            'Tipo: ' + trim(dataSet.FieldByName('tipo').AsString) +
            ' Grupo : ' + IntToStr(vProduto.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
            ' CodProd: ' + trim(vProduto.dataSet.FieldByName('COD_PROD').AsString) +
            ' Perc Perm: ' + format('%n', [vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsFloat]) +
            ' Perc Inf: ' + Format('%n', [(((dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency) * (descontoP / 100)) + descontoV - descontoVini)]),
            'PEDVENDA',
            dataSet.FieldByName('NPED').asstring, buscas, true) then
          exit;
        end;
    end;

    dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV,2);
    if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
      dataSet.FieldByName('rateio_desc').AsCurrency := dataSet.FieldByName('desc_item').AsCurrency;
    result := true;
  end;
end;

function TPedVendaProd.verificaGradeProduto(pQuant: double): boolean;
var
  qtdItemDisponivel: double;
  sql: string;
begin
  result := false;
  sql := '';
  qtdItemDisponivel := 0;
  if (vSing.vTipoVenda <> 'REQ') and (vSing.vTipoVenda <> 'OS') then //JC se tiver grade...baixa tanto na OS quanto na REQ
  begin
    Result := true;
    exit;
  end;
  if not ProdutoPossuiGrade(dataSet.FieldByName('grupo_prod').AsInteger, dataSet.FieldByName('cod_prod').AsString) then
  begin
    Result := true;
    exit;
  end
  else
  begin
    if dataSet.FieldByName('cod_grade').Asinteger = 0 then
    begin
      Result := true;
      exit;
    end;
    try
      buscas.Close;
      buscas.SQL.Text := 'select ' +
      	' (coalesce(cgp.qtde, 0) - ' +
        '  coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod pp ' +
        '            inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo' +
        '            where pp.grupo_prod = cgp.grupo_prod ' +
        '            and pp.cod_prod = cgp.cod_prod ' +
        '            and pp.cod_grade = cgp.cod_grade ' +
        '            and pp.cod_empresa = cgp.cod_empresa ' +
        '            and coalesce(v.status_ped, '''') = '''' ' +
        '            and coalesce(pp.status, '''') = '''' ' +
        '            and v.NPED <> ' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
        '            sql_tipo), 0) + ' +
        '  coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        ' 				   cgp.grupo_prod, ' +
        '            cgp.cod_prod, ' +
        '            cgp.cod_empresa, ' +
        '            cgp.cod_grade)), 0) ' +
        ' ) as qtd_item_disponivel ' +
        ' from grade g ' +
        ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
        ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
        ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
        ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
        ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by g.cod_grade';

      if (vDadosIni.vEmp.vApresentarEstR = 'S') then
        sql := sql + ' and v.tipo <> ''ORC'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'R') then
        sql := sql + ' and v.tipo = ''REQ'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'O') then
        sql := sql + ' and v.tipo = ''OS''';

      if (vDadosIni.vEmp.vApresentarEstR = 'R') or
        (vDadosIni.vEmp.vApresentarEstR = 'O') or
        (vDadosIni.vEmp.vApresentarEstR = 'S') then
        buscas.SQL.Text := StringReplace(buscas.SQL.Text, 'sql_tipo', sql, [rfReplaceAll, rfIgnoreCase])
      else
        buscas.SQL.Text := 'select coalesce(cgp.qtde, 0) as qtd_item_disponivel from grade g ' +
          ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
          ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
          ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
          ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
          ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' order by g.cod_grade ';

      buscas.Open;
      qtdItemDisponivel := buscas.FieldByName('qtd_item_disponivel').AsFloat;

      if dataSet.FieldByName('QUANT_PED_ITEM').AsFloat + pQuant > qtdItemDisponivel then
      begin
        if vSing.vTipoVenda = 'REQ' then
          raiseexceptioncreate('Quantidade maior que o estoque da Grade informada.', 'DBedit10') // 'DBedit53') //DBedit14
        else if vSing.vTipoVenda = 'OS' then
          raiseexceptioncreate('Quantidade maior que o estoque da Grade informada.', 'DBedit51');
      end;
      Result := true;
      buscas.close;
    except
      on e: exception do
      begin
        buscas.close;
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  end;
end;

function TPedVendaProd._produtoempromocao: boolean;
begin
  result := false;
  buscas.Close;
  buscas.SQL.Text := 'select p.ordem, tp.descr_tipo,pr.prec_tab_prod,pr.prec_publico, ' +
    'case when coalesce(l.cod_localidade, 0) > 0 then l.localidade ' +
    'when coalesce(st.cod_setor, 0) > 0 then st.setor ' +
    'when coalesce(cd.cod_cidade, 0) > 0 then cd.nome_cidade ' +
    'else p.descr_promocao ' +
    'end descricao, ' +
    'pp.valor_promocao, pp.porcentagem ' +
    'from promocao_produto pp ' +
    'inner join tipo_preco tp on tp.cod_tppreco = pp.cod_tppreco and tp.cod_empresa = pp.cod_empresa ' +
    'inner join produtos pr on pr.grupo_prod = pp.grupo_prod and pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa ' +
    'left join localidade l on l.cod_localidade = pp.cod_localidade and l.cod_empresa = pp.cod_empresa ' +
    'left join setor st on st.cod_setor = pp.cod_setor and st.cod_empresa = pp.cod_empresa ' +
    'left join cidades cd on cd.cod_cidade = pp.cod_cidade ' +
    'inner join promocao p on p.cod_promocao = pp.cod_promocao and p.cod_tppreco = pp.cod_tppreco and p.cod_empresa = pp.cod_empresa ' +
    'where pr.ativo = 1 and pr.grupo_prod = ' + inttostr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and pr.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
    ' and pp.cod_empresa = ' + vDadosIni.codEmpresa + ' and ' +
    '( ' +
    '( ' +
    'tp.tipo = ''T'' and ((tp.descr_tipo = ''SETOR'' AND PP.cod_setor = ' + inttostr(FCodSetor) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')) ) or ' +
    '( TP.descr_tipo = ''LOCALIDADE'' AND PP.cod_localidade = ' + inttostr(FCodLocalidade) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')) ) or ' +
    '(TP.descr_tipo = ''CIDADE'' AND PP.cod_cidade = ' + inttostr(FCodCidade) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')) )) ' +
    ') or ' +
    '( ' +
    '(tp.tipo = ''P'') and (pp.data_ini <= ' + vDadosIni.FusoSqlDateTime + ' and pp.data_fim >= ' + vDadosIni.FusoSqlDateTime + ') and ' +
    '((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')) ' +
    ')' +
    ') order by tp.tipo, p.ordem';
  buscas.Open;
  if not buscas.IsEmpty then
    if (vDadosIni.StrToFloatFormat((buscas.FieldByName('valor_promocao').AsFloat), vDadosIni.vEmp.vCasasDecimais) > 0) or
      (vDadosIni.StrToFloatFormat((buscas.FieldByName('porcentagem').AsFloat), vDadosIni.vEmp.vCasasDecimais) > 0) then
      result := true;
  buscas.close;
end;

function TPedVendaProd._retornaQtdNItensCancelConsignado: integer;
begin
  result := 0;
  if (not vListarImprimirItemCancConsignado) and (dataSet.FieldByName('NPED').AsInteger > 0) then
  begin
    buscas.Close;
    buscas.SQL.Text := 'SELECT count(NITEM) as qtd FROM PEDVENDA_PROD ' +
      'WHERE  NPED = ' + inttostr(dataSet.FieldByName('NPED').AsInteger) + ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and tipo = ' + QuotedStr(vSing.vTipoVenda) + ' and ativo=1 ' +
      ' and (coalesce(quant_ped_item,0)= coalesce(quant_item_dev,0) ' +
      ' and coalesce(status,'''') = ''CANCELADO'')';
    buscas.Open;
    result := buscas.FieldByName('QTD').AsInteger;
    buscas.close;
  end;
end;

function TPedVendaProd._retornaValorItemOrig: Double;
begin
	Result := 0;
  if FOwner.dataSet.FieldByName('TIPV').AsString = 'A' then
    Result := vProduto.dataSet.FieldByName('PREC_PUBLICO').AsCurrency
  else if FOwner.vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '1' then
    Result := vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency
  else if FOwner.vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '2' then
    Result := vProduto.dataSet.FieldByName('PREC_30_PROD').AsCurrency
  else if FOwner.vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '3' then
    Result := vProduto.dataSet.FieldByName('PREC_60_PROD').AsCurrency
  else if FOwner.vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '4' then
    Result := vProduto.dataSet.FieldByName('PREC_90_PROD').AsCurrency;

  if Result = 0 then
    Result := vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;
end;

function TPedVendaProd._setaPrecoPromocao(pCodLocalidade, pCodCliente , pCodTabDifCliente, pCodCidade: integer; pTIPV: string): currency;
begin
  result := 0;

  FUsarPrecoProdPromDif := false;
  FPrecoPromocaoProd := 0;
  FDescMaxPromocao := 0;
  FTabPraticada := 'N';
  FUsarDebCredProdPromDif := true;

  if FUsarPrecoCustoTipoVND then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' select p.ordem, tp.tipo, tp.descr_tipo, pr.prec_tab_prod, pr.prec_publico, ' +
    ' case ' +
    '		when coalesce(l.cod_localidade, 0) > 0 then l.localidade ' +
    ' 	when coalesce(st.cod_setor, 0) > 0 then st.setor ' +
    ' 	when coalesce(cd.cod_cidade, 0) > 0 then cd.nome_cidade ' +
    ' 	else p.descr_promocao ' +
    ' end descricao, ' +
    ' case ' +
    '   when (tp.descr_tipo = ''SETOR'') then iif(coalesce(tp.usar_debcred, ''S'') = ''N'', ''N'', ''S'') ' +
    '   when (tp.descr_tipo = ''LOCALIDADE'') then iif(coalesce(tp.usar_debcred, ''S'') = ''N'', ''N'', ''S'') ' +
  	'   when (tp.descr_tipo = ''CIDADE'') then iif(coalesce(tp.usar_debcred, ''S'') = ''N'', ''N'', ''S'')  ' +
    '   else iif(coalesce(p.usar_debcred, ''S'') = ''N'', ''N'', ''S'') ' +
    ' end usar_debcred_tab, ' +
    ' iif(coalesce(pp.usar_debcred, ''S'') = ''N'', ''N'', p.usar_debcred) usar_debcred, ' +
    ' pp.valor_promocao, pp.porcentagem, pp.max_desc from promocao_produto pp ' +
    ' inner join tipo_preco tp on tp.cod_tppreco = pp.cod_tppreco and tp.cod_empresa = pp.cod_empresa ' +
    ' inner join produtos pr on pr.grupo_prod = pp.grupo_prod and pr.cod_prod = pp.cod_prod and pr.cod_empresa = pp.cod_empresa ' +
    ' left join localidade l on l.cod_localidade = pp.cod_localidade and l.cod_empresa = pp.cod_empresa and l.ativo = 1 ' +
    ' left join setor st on st.cod_setor = pp.cod_setor and st.cod_empresa = pp.cod_empresa and st.ativo = 1' +
    ' left join cidades cd on cd.cod_cidade = pp.cod_cidade and cd.ativo = 1' +
    ' inner join promocao p on p.cod_promocao = pp.cod_promocao and p.cod_tppreco = pp.cod_tppreco and p.cod_empresa = pp.cod_empresa ' +
    ' where pr.grupo_prod = ' + inttostr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
    ' and pr.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
    ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and pr.ativo = 1 ' +
    ' and ' +
    ' 		( ' +
    '	 			((tp.tipo = ''T'') ' +
    '   			and ((tp.descr_tipo = ''SETOR'' AND PP.cod_setor = ' + inttostr(FCodSetor) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + '))) ' +
    '	  				or (tp.descr_tipo = ''LOCALIDADE'' AND PP.cod_localidade = ' + inttostr(FCodLocalidade) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')))' +
    '	  				or (tp.descr_tipo = ''CIDADE'' AND PP.cod_cidade = ' + inttostr(FCodCidade) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + '))) ' +
    '	   				or (tp.descr_tipo = ''AVULSO'' AND PP.cod_promocao = ' + inttostr(FCodTabDifClienteVenda) + ' and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')))' +
    '		 		  ) ' +
    '  			) ' +
    '			  or ' +
    '  			((tp.tipo = ''P'') ' +
    '    			and (pp.data_ini <= ' + vDadosIni.FusoSqlDateTime + ' and pp.data_fim >= ' + vDadosIni.FusoSqlDateTime + ') and ((pp.sigla = ''0'') or (pp.sigla = ' + QuotedStr(FTipv) + ')) ' +
    '  			)' +
    ' 		) ' +
    ' order by tp.tipo, p.ordem ';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    vValorAcrescimo := 0;
    vValorDesconto := 0;

    if buscas.FieldByName('valor_promocao').AsFloat > 0 then
      result := vDadosIni.StrToFloatFormat(buscas.FieldByName('valor_promocao').AsFloat, vDadosIni.vEmp.vCasasDecimais)
//    else if FTipv = 'A' then
//      result := vDadosIni.StrToFloatFormat((((100 - buscas.FieldByName('porcentagem').AsFloat) / 100) * buscas.FieldByName('PREC_PUBLICO').AsCurrency), vDadosIni.vEmp.vCasasDecimais)
    else
      result := vDadosIni.StrToFloatFormat((((100 - buscas.FieldByName('porcentagem').AsFloat) / 100) * buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais);

  	if result > vValorItem then
	    vValorAcrescimo := Abs((result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat))
    else
	    vValorDesconto := Abs((vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat));

    FUsarPrecoProdPromDif := true;
    FPrecoPromocaoProd := result;
    FDescMaxPromocao := buscas.FieldByName('max_desc').AsFloat;
    FTabPraticada := buscas.FieldByName('TIPO').AsString;

    if trim(buscas.FieldByName('USAR_DEBCRED').AsString) = 'N' then
      FUsarDebCredProdPromDif := False
    else if trim(buscas.FieldByName('USAR_DEBCRED').AsString) = 'S' then
      FUsarDebCredProdPromDif := True
    else if trim(buscas.FieldByName('USAR_DEBCRED_TAB').AsString) = 'N' then
      FUsarDebCredProdPromDif := False
	  else
    	FUsarDebCredProdPromDif := True;
  end;
  buscas.close;
end;

function TPedVendaProd._setarAcrescCondPagComissaoVend(
	pTipo: string; pTipoREQ: string; pTipoOS: string; pTipoORC: string;
  pCodCondPag: Integer; pComissaoVend: Double;
  pQtde: Double; pValorUnBruto: Double; pValorAcrescimo: Double): boolean;
var
	ConfigImp: TConfig_sistema_class;
	MontarPacelamentoStr: TMontarPacelamentoStr;
  vParcelas: TStringList;
  vDescrCondPag: string;
  vComissaoGrupo, vComissaoCond: Double;
  vComissaoMaxVend: Double;
  vFatorConvCond: Double;
  vStringListTiposReqOs: TStringList;
  vStringListGrupoReqOs: TStringList;
  vCalculoValorProd: string;
  vExisteTpVnd: Boolean;
  vValor_DescAcrescTmp: Double;
  I: Integer;
begin
	try
    try
      result := False;
      vExisteTpVnd := False;

      if not vDadosIni.vPedVnd.AcrescCondPagComissaoVend then
        exit;

      ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscas, vDadosIni.cod_empresa);

      vStringListTiposReqOs := TStringList.Create;
      vStringListGrupoReqOs := TStringList.Create;

      if trim(pTipo) = 'REQ' then
      	vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoREQ')), ',')
      else if trim(pTipo) = 'OS' then
      	vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoOS')), ',')
      else if trim(pTipo) = 'ORC' then
      	vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoORC')), ',');

      for I := 0 to vStringListTiposReqOs.Count - 1 do
      begin
        if (trim(pTipo) = 'REQ')
        	and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
        		or (trim(vStringListTiposReqOs[I]) = trim(pTipoREQ))) then
        begin
        	vExisteTpVnd := True;
          Break;
        end
        else if (trim(pTipo) = 'OS')
        	and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          	or (trim(vStringListTiposReqOs[I]) = trim(pTipoOS))) then
        begin
        	vExisteTpVnd := True;
          Break;
        end
        else if (trim(pTipo) = 'ORC')
        	and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          	or (trim(vStringListTiposReqOs[I]) = trim(pTipoORC))) then
        begin
        	vExisteTpVnd := True;
          Break;
        end;
      end;

      if not vExisteTpVnd then
        Exit;

      @MontarPacelamentoStr := GetProcAddress(vDadosIni.vCadBasicos.AHandle, PChar('MontarPacelamentoStr'));
      if Assigned(MontarPacelamentoStr) then
      begin
        vParcelas := TStringList.Create;

        try
          vFatorConvCond := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'FatorPrazoPag')));
        except
          vFatorConvCond := 0;
        end;

        try
        	vComissaoMaxVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'ComissaoMaxVendedor')));
        except
        	vComissaoMaxVend := 0;
        end;

      	vCalculoValorProd := UpperCase(trim(ConfigImp.ReadString('Configuracao', 'CalculoValorProd')));
        if trim(vCalculoValorProd) = '' then
        	vCalculoValorProd := 'DIVIDIR';

        if (trim(vCalculoValorProd) <> 'DIVIDIR') and (trim(vCalculoValorProd) <> 'MULTIPLICAR') then
        	vCalculoValorProd := 'DIVIDIR';

        // Comissao Cond Pag
        vValorAcrescCondPag := 0;
        vValorAcrescimo     := 0;
        if vFatorConvCond > 0 then
        begin
          SqlOpen(' select cond_pag.desc_cond_pag from cond_pag ' +
            ' where cond_pag.cod_cond_pag = ' + IntToStr(pCodCondPag), buscas);
          vDescrCondPag := trim(buscas.FieldByName('desc_cond_pag').AsString);

          try
            vParcelas.Text := MontarPacelamentoStr(
              pCodCondPag,
              vDescrCondPag,
              1000,
              '00000',
              '',
              '',
              '',
              '',
              0,
              0,
              0,
              0,
              True);

          	vComissaoCond := 0;
            for I := 0 to vParcelas.Count - 1 do
              vComissaoCond := vComissaoCond + StrToDate(vDadosIni.getCampoPipe(trim(vParcelas[I]), 3)) - vDadosIni.getDataBanco(buscas);
            if vParcelas.Count > 1 then
              vComissaoCond := vComissaoCond / vParcelas.Count;

            // Acrescimo em percentual
            vValorAcrescCondPag := vValorAcrescCondPag + (vFatorConvCond * vComissaoCond);

          finally
            FreeAndNil(vParcelas);
          end;
        end;

        if vValorAcrescCondPag < 0 then
           vValorAcrescCondPag := 0;

        SqlOpen(' select pc.conteudo_flag, pc.perc_peso from perfil_vendedor pv ' +
        	' inner join perfil_comissao pc on pv.codigo_perfil = pc.codigo_perfil ' +
          ' where pv.ativo = 1 ' +
          ' and pv.cod_vendedor = ' + IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger) +
          ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and pc.tipo_perfil = ''Venda Geral'' ' +
          ' and pc.tipo_serv_prod = ''Produto'' ' +
          ' and pc.flag_serv_prod = ''Grupo Produto'' ', buscas);

        vComissaoGrupo := 0;
        vStringListGrupoReqOs.Text := trim(buscas.FieldByName('conteudo_flag').AsString);

        for I := 0 to vStringListGrupoReqOs.Count - 1 do
        	if trim(vStringListGrupoReqOs[I]) = IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) then
          begin
          	vComissaoGrupo := buscas.FieldByName('perc_peso').AsFloat;
            Break;
          end;

        if vComissaoGrupo > 0 then
        	pComissaoVend := vComissaoGrupo;

        if (pQtde > 0) and (pValorAcrescimo > 0) then
        begin
        	pComissaoVend :=
          	vDadosIni.StrToFloatFormat(pQtde * pValorAcrescimo, 2) /
          		(vDadosIni.StrToFloatFormat(pQtde * pValorUnBruto, 2) + vDadosIni.StrToFloatFormat(pQtde * pValorAcrescimo, 2)) * 100;

          pComissaoVend := pComissaoVend - vValorAcrescCondPag;
        end;

        if (vComissaoGrupo > vComissaoMaxVend) and (vComissaoMaxVend > 0) and (vComissaoGrupo > 0) then
          vPercComissaoVnd3 := vComissaoMaxVend
        else if (pComissaoVend > vComissaoGrupo) and (vComissaoGrupo > 0) and (pComissaoVend > 0) then
        	vPercComissaoVnd3 := vComissaoGrupo
        else if (pComissaoVend > vComissaoMaxVend) and (vComissaoMaxVend > 0) and (pComissaoVend > 0) then
          vPercComissaoVnd3 := vComissaoMaxVend
        else if (vComissaoGrupo > 0) then
        	vPercComissaoVnd3 := vComissaoGrupo
        else if (pComissaoVend > 0) then
          vPercComissaoVnd3 := pComissaoVend
        else
          vPercComissaoVnd3 := 0;

        // Comissao Vend
        if pValorAcrescimo > 0 then
          vValorAcrescimo := pValorAcrescimo
        else if pComissaoVend > 0 then
        begin
          // Acrescimo em percentual
          vValorAcrescimo := vValorAcrescCondPag + pComissaoVend;

          if vValorAcrescimo > 0 then
          begin
          	if trim(vCalculoValorProd) = 'MULTIPLICAR' then
              vValorAcrescimo :=
                (vDadosIni.StrToFloatFormat(pQtde * pValorUnBruto, 2) * (1 + (vValorAcrescimo / 100))) - vDadosIni.StrToFloatFormat(pQtde * pValorUnBruto, 2)
            else
              vValorAcrescimo :=
                (vDadosIni.StrToFloatFormat(pQtde * pValorUnBruto, 2) / (1 - (vValorAcrescimo / 100))) - vDadosIni.StrToFloatFormat(pQtde * pValorUnBruto, 2);
          end;
        end;
      end;

    finally
      if Assigned(ConfigImp) then
        FreeAndNil(ConfigImp);
      if Assigned(vParcelas) then
      	FreeAndNil(vParcelas);
      if Assigned(vStringListTiposReqOs) then
        FreeAndNil(vStringListTiposReqOs);
      if Assigned(vStringListGrupoReqOs) then
        FreeAndNil(vStringListGrupoReqOs);
    end;

    Result := True;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TPedVendaProd._setaTipv(pTipv: string);
begin
  FTipv := pTipv;
end;

procedure TPedVendaProd._setaVariaveisPromocao(pCodLocalidade, pCodCliente, pCodTabDifCliente, pCodCondPag, pCodCidade: integer; pTIPV: string);
var
 vCodTemp, vSqlTemp, vWhereTemp: string;
begin
  FCodClienteVenda := pCodCliente;
  FCodLocalidade := pCodLocalidade;
  FCodCidade := pCodCidade;
  FCodCondPag := pCodCondPag;
  FCodTabDifClienteVenda := 0;
  vSqlTemp := '';
  vWhereTemp := '';

  if ((dataSet.FieldByName('GRUPO_PROD').AsInteger > 0) and (trim(dataSet.FieldByName('COD_PROD').AsString) <> '')) then
  begin
    vSqlTemp := ' inner join promocao_produto pp on pp.cod_promocao = p.cod_promocao and pp.cod_empresa = p.cod_empresa ';
    vWhereTemp := ' and pp.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
      ' and pp.cod_prod = '+QuotedStr(dataSet.FieldByName('COD_PROD').AsString);
  end;

  if pCodTabDifCliente > 0 then
  begin
     vCodTemp := retornaValor('select p.cod_promocao as valor from promocao p ' +
      ' inner join tipo_preco tp on tp.cod_tppreco = p.cod_tppreco and tp.cod_empresa = p.cod_empresa ' + vSqlTemp +
      ' where p.cod_promocao=' + inttostr(pCodTabDifCliente) + ' and tp.tipo = ''T'' and p.cod_empresa=' + vDadosIni.codEmpresa + ' and p.ativo=1' + vWhereTemp);

      if trim(vCodTemp) <> '' then
        FCodTabDifClienteVenda := strtoint(vCodTemp)
      else
        FCodTabDifClienteVenda := 0;
  end;

  if FCodTabDifClienteVenda <= 0 then
    if pCodCondPag > 0 then
    begin
      vCodTemp := retornaValor('select tb.cod_tab_preco as valor from cond_pag_tabpreco tb' +
       ' inner join cond_pag c on tb.cod_cond_pag = c.cod_cond_pag and c.ativo = 1' +
       ' where tb.cod_cond_pag = ' + inttostr(pCodCondPag) + ' and tb.cod_empresa = ' + vDadosIni.codEmpresa);
      if trim(vCodTemp) <> '' then
        FCodTabDifClienteVenda := strtoint(vCodTemp)
      else
       FCodTabDifClienteVenda := 0;
    end
    else
      FCodTabDifClienteVenda := 0;

  FTipv := pTipv;
  if pCodLocalidade > 0 then
    FCodSetor := strtoint(retornaValor('select l.cod_setor as valor from localidade l where l.cod_localidade=' + inttostr(pCodLocalidade) + ' and l.cod_empresa=' + vDadosIni.codEmpresa + ' and l.ativo=1'))
  else
    FCodSetor := 0;
end;

function TPedVendaProd._setaPrecoPromocaoAnt: currency;
begin
  result := 0;

	FUsarPrecoProdPromDif := false;
  FPrecoPromocaoProd := 0;
  FDescMaxPromocao := 0;
  FTabPraticada := 'N';

  if FUsarPrecoCustoTipoVND then
    exit;

  if (vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S')
  	and (vProduto.dataSet.FieldByName('PRECO_PROMOCAO').AsCurrency > 0)
    and (not FUsarPrecoCustoTipoVND) then
  begin
    vValorAcrescimo := 0;
    vValorDesconto := 0;

    Result := vProduto.dataSet.FieldByName('PRECO_PROMOCAO').AsCurrency;

    FUsarPrecoProdPromDif := True;
  	FPrecoPromocaoProd := Result;
  	FTabPraticada := 'P';

    if result > vValorItem then
	    vValorAcrescimo := Abs((result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat))
    else
	    vValorDesconto := Abs((vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat));
  end;
end;

function TPedVendaProd._setaPrecoProdutosPorQtde(pTIPV: string; pAtualizarqtde: boolean; pVendaRapida: boolean): currency;
var
	vExibirTab: boolean;
   I: Integer;
begin
  result := 0;
  vExibirTab := true;

  if pVendaRapida then
	  if not vDadosIni.vPedVnd.exibirPrecoQtdeVndRapida then
    	vExibirTab := false;

  FDescMaxPorQtde := 0;
  FValorDesconto := 0;
  FUsarPrecoProdPorQtde := false;
  FPrecoProdPorQtde := 0;
  FUsarDebCredProdPorQtde := true;

  if (FUsarPrecoCustoTipoVND) or (FUsarPrecoProdPromDif) then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' select first 1 ' +
  	' coalesce(preco_produtos_qtde.preco_venda, 0) preco_venda, ' +
    ' coalesce(preco_produtos_qtde.porcentagem, 0) porcentagem, ' +
    ' coalesce(preco_produtos_qtde.max_desc, 0) max_desc, ' +
    ' iif(coalesce(tipo_preco.usar_debcred, ''S'') = ''N'', ''N'', ''S'') as usar_debcred_tab, ' +
    ' iif(coalesce(preco_produtos_qtde.usar_debcred, ''S'') = ''N'', ''N'', preco_produtos_qtde.usar_debcred) usar_debcred, ' +
    ' coalesce(produtos.prec_tab_prod, 0) prec_tab_prod ' +
    ' from preco_produtos_qtde ' +
    ' inner join produtos on ' +
  	'		produtos.grupo_prod = preco_produtos_qtde.grupo_prod ' +
    '		and produtos.cod_prod = preco_produtos_qtde.cod_prod ' +
    '   and produtos.cod_empresa = preco_produtos_qtde.cod_empresa ' +
    ' left join tipo_preco on ' +
    '		tipo_preco.cod_tppreco = 6 ' +
    '		and tipo_preco.cod_empresa = preco_produtos_qtde.cod_empresa ' +
    ' where preco_produtos_qtde.grupo_prod = :grupo_prod ' +
    ' and preco_produtos_qtde.cod_prod = :cod_prod ' +
    ' and preco_produtos_qtde.cod_empresa = :cod_empresa ' +
    ' and ((preco_produtos_qtde.sigla = ''0'') or (preco_produtos_qtde.sigla = :sigla)) ' +
    ' and preco_produtos_qtde.quant > :quant ';
  buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
  buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('SIGLA').AsString := pTIPV;
  buscas.ParamByName('QUANT').AsFloat := 0;
  buscas.Open;

  if buscas.IsEmpty then
  	exit
  else
  begin
  	FUsarPrecoProdPorQtde := true;
    if dataSet.State in [dsinsert, dsEdit] then
	    dataSet.FieldByName('PRECOPORQTDE').AsString := 'S';
  end;

  if (pAtualizarqtde) and (FUsarPrecoProdPorQtde) and (vExibirTab) then
  begin
  	if vProdutosPorQtde.abreProdutosPorQtde(dataSet.FieldByName('GRUPO_PROD').AsInteger, dataSet.FieldByName('COD_PROD').AsString, pTIPV) then
    begin
      for I := 0 to vProdutosPorQtde.dataSet.Fields.Count - 1 do
       if vProdutosPorQtde.dataSet.Fields[i].DataType = ftFloat then
         if (pos('Quantidade', TFloatField(vProdutosPorQtde.dataSet.Fields[i]).DisplayLabel) > 0) then
           TFloatField(vProdutosPorQtde.dataSet.Fields[i]).DisplayFormat := '##0.0000'
         else if (pos('Preco Venda', TFloatField(vProdutosPorQtde.dataSet.Fields[i]).DisplayLabel) > 0) then
           TFloatField(vProdutosPorQtde.dataSet.Fields[i]).DisplayFormat := '##0.000';

      if frmPrecoPorQtde = nil then
      begin
        Application.CreateForm(TfrmPrecoPorQtde, frmPrecoPorQtde);

        if DtmPedVenda = nil then
          DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

        vDadosIni.AlterarDataSourceComponentes(frmPrecoPorQtde, FOwner.DtmPed);
      end;

	    if frmPrecoPorQtde.showModal = mrOK then
      begin
      	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(vProdutosPorQtde.dataSet.FieldByName('QUANT').AsFloat, - 4);
        dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);

        if trim(vProdutosPorQtde.dataSet.FieldByName('USAR_DEBCRED').AsString) = 'N' then
          FUsarDebCredProdPorQtde := False
        else if trim(vProdutosPorQtde.dataSet.FieldByName('USAR_DEBCRED').AsString) = 'S' then
          FUsarDebCredProdPorQtde := True
        else if trim(vProdutosPorQtde.dataSet.FieldByName('USAR_DEBCRED_TAB').AsString) = 'N' then
          FUsarDebCredProdPorQtde := False
        else
          FUsarDebCredProdPorQtde := True;

        if SqlOpen(' select grupo_prod, cod_prod, cod_empresa, unidade from produtos ' +
        	' where grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).IsEmpty then
          	dataSet.FieldByName('UNIDADE_CONV').AsString := UpperCase(trim(buscas.FieldByName('UNIDADE').AsString));
      end
      else if not pVendaRapida then
      	exit;
    end;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select first 1 ' +
  	' coalesce(preco_produtos_qtde.preco_venda, 0) preco_venda, ' +
    ' coalesce(preco_produtos_qtde.porcentagem, 0) porcentagem, ' +
    ' coalesce(preco_produtos_qtde.max_desc, 0) max_desc, ' +
    ' iif(coalesce(tipo_preco.usar_debcred, ''S'') = ''N'', ''N'', ''S'') as usar_debcred_tab, ' +
    ' iif(coalesce(preco_produtos_qtde.usar_debcred, ''S'') = ''N'', ''N'', preco_produtos_qtde.usar_debcred) usar_debcred, ' +
    ' coalesce(produtos.prec_tab_prod, 0) prec_tab_prod ' +
    ' from preco_produtos_qtde ' +
    ' inner join produtos on ' +
  	'		produtos.grupo_prod = preco_produtos_qtde.grupo_prod ' +
    '		and produtos.cod_prod = preco_produtos_qtde.cod_prod ' +
    '   and produtos.cod_empresa = preco_produtos_qtde.cod_empresa ' +
    ' left join tipo_preco on ' +
    '		tipo_preco.cod_tppreco = 6 ' +
    '		and tipo_preco.cod_empresa = preco_produtos_qtde.cod_empresa ' +
    ' where preco_produtos_qtde.grupo_prod = :grupo_prod ' +
    ' and preco_produtos_qtde.cod_prod = :cod_prod ' +
    ' and preco_produtos_qtde.cod_empresa = :cod_empresa ' +
    ' and ((preco_produtos_qtde.sigla = ''0'') or (preco_produtos_qtde.sigla = :sigla)) ' +
    ' and preco_produtos_qtde.quant <= :quant ' +
    ' order by preco_produtos_qtde.quant desc ';
  buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
  buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('SIGLA').AsString := pTIPV;
  buscas.ParamByName('QUANT').AsFloat := dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
  buscas.Open;

  if not buscas.IsEmpty then
  begin
    if (vValorItem > 0)
    	and (buscas.FieldByName('preco_venda').AsFloat > 0)
    	and (buscas.FieldByName('preco_venda').AsFloat > vValorItem) then
    begin
      if pAtualizarqtde then
        Application.MessageBox(Pchar('Preço por quantidade maior que o preço de venda unitário. Favor verificar: ' + #13 + #13 +
          'Preço de venda unitário: R$ ' + Format('%0.2n', [vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat]) + #13 +
          'Preço por quantidade...: R$ ' + Format('%0.2n', [buscas.FieldByName('preco_venda').AsFloat])),
          'Atenção', MB_ICONWARNING + MB_OK);
      Result := 0;
      exit;
    end
    else if (vValorItem > 0)
    	and (buscas.FieldByName('porcentagem').AsFloat > 0)
    	and (vDadosIni.StrToFloatFormat((((100 + buscas.FieldByName('porcentagem').AsFloat) / 100) *
      																		buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais) > 0)
    	and (vDadosIni.StrToFloatFormat((((100 + buscas.FieldByName('porcentagem').AsFloat) / 100) *
      																		buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais) > vValorItem) then
    begin
    	if pAtualizarqtde then
        Application.MessageBox(Pchar('Preço por quantidade maior que o preço de venda unitário. Favor verificar: ' + #13 + #13 +
          'Preço de venda unitário: R$ ' + Format('%0.2n', [vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsFloat]) + #13 +
          'Preço por quantidade...: R$ ' + Format('%0.2n', [vDadosIni.StrToFloatFormat((((100 + buscas.FieldByName('porcentagem').AsFloat) / 100) *
       																									buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais)])),
          'Atenção', MB_ICONWARNING + MB_OK);
      Result := 0;
      exit;
    end;

  	if buscas.FieldByName('preco_venda').AsFloat > 0 then
   	  result := vDadosIni.StrToFloatFormat(buscas.FieldByName('preco_venda').AsFloat, vDadosIni.vEmp.vCasasDecimais)
    else if (buscas.FieldByName('porcentagem').AsFloat <> 0) then
    begin
    	if buscas.FieldByName('porcentagem').AsFloat > 0 then
        result := vDadosIni.StrToFloatFormat((((100 + buscas.FieldByName('porcentagem').AsFloat) / 100) *
        																				buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais)
      else
        result := vDadosIni.StrToFloatFormat((((100 - buscas.FieldByName('porcentagem').AsFloat) / 100) *
        																				buscas.FieldByName('PREC_TAB_PROD').AsCurrency), vDadosIni.vEmp.vCasasDecimais);
    end;

    vValorAcrescimo := 0;
    vValorDesconto := 0;

    if result > vValorItem then
	    vValorAcrescimo := Abs((result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat))
    else
	    vValorDesconto := Abs((vValorItem * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat)
  			- (result * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat));

    FPrecoProdPorQtde := result;
    FDescMaxPorQtde   := buscas.FieldByName('MAX_DESC').AsFloat;

    if trim(buscas.FieldByName('USAR_DEBCRED').AsString) = 'N' then
      FUsarDebCredProdPorQtde := False
    else if trim(buscas.FieldByName('USAR_DEBCRED').AsString) = 'S' then
      FUsarDebCredProdPorQtde := True
    else if trim(buscas.FieldByName('USAR_DEBCRED_TAB').AsString) = 'N' then
      FUsarDebCredProdPorQtde := False
	  else
    	FUsarDebCredProdPorQtde := True;
  end
  else if dataSet.State in [dsinsert, dsEdit] then
  	dataSet.FieldByName('TABPRATICADA').AsString := 'N';
  buscas.close;
end;

function TPedVendaProd._usarPrecoCustoTiposVendas(pTipoPed, pTipoVendaOuOS: string): Boolean;
begin
  if Trim(pTipoPed) = 'REQ' then
    Result := ExecutaComandosSql('select usarprecocusto as valor from tipo_vendas tv where tv.usarprecocusto=''S'' ' +
      ' and tv.tipo = ' + quotedstr(pTipoPed) + ' and tv.sigla = ' + quotedstr(pTipoVendaOuOS))
  else if Trim(pTipoPed) = 'OS' then
    Result := ExecutaComandosSql('select usarprecocusto as valor from tipo_vendas tv where tv.usarprecocusto=''S'' ' +
      ' and tv.tipo = ' + quotedstr(pTipoPed) + ' and tv.tipo_os = ' + quotedstr(pTipoVendaOuOS))
  else
    result := False;
end;

function TPedVendaProd._validarAlteracaoPrecoUnitario(pTABPRATICADA: string): boolean;
var
	buscas2: TIBQuery;
  vValorUnOrig: Double;
  vValorUn: Double;
  vAlterarPreco: Boolean;
begin
	try
    result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if not(dataSet.State in [dsEdit, dsInsert]) then
    begin
      result := True;
      exit;
    end;

    if (dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
      and (dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0)
      and (trim(dataSet.FieldByName('UNIDADE').AsString) <> '')
      and (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
      and (trim(dataSet.FieldByName('OPERACAO_CONV').AsString) <> '')
      and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0)
      and (UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) <> UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
    begin
      if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
      begin
        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat *
          dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat *
          dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end
      else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
      begin
        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat /
          dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat /
          dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end
      else
      begin
        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end;
    end
    else
    begin
      if (dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat > 0) then
        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if (dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
    end;

    vValorUnOrig   := dataSet.FieldByName('VLUN_ORIG').AsFloat;
    vValorUn       := dataSet.FieldByName('VLUN_PED_ITEM').AsFloat;

    vAlterarPreco := True;
    if (dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S') then
    begin
      vAlterarPreco := False;
      if vDadosIni.StrToFloatFormat(vValorUn, 2) > vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
      	vValorUnOrig  := _retornaValorItemOrig;
    end
    else if (dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S') then
    begin
      vAlterarPreco := False;
      if vDadosIni.StrToFloatFormat(vValorUn, 2) > vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
      	vValorUnOrig  := _retornaValorItemOrig;
    end
  	else if (dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S') then
    begin
      vAlterarPreco := False;
      if vDadosIni.StrToFloatFormat(vValorUn, 2) > vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
      	vValorUnOrig  := _retornaValorItemOrig;
    end;

    if vAlterarPreco then
    begin
      vDadosIni.vInibeMensPesqPros := 'S';
      if vDadosIni.PesqPros('VND133', 'HABILITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
        dataSet.FieldByName('NPED').AsString + ' - ' + dataSet.FieldByName('NITEM').AsString, buscas, true) then
      begin
        if vDadosIni.StrToFloatFormat(vValorUn, 2) < vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
        begin
          dataSet.FieldByName('ACRESC_ITEM').AsCurrency := 0;

          dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';

          if (vDadosIni.vPedVnd.AcrescCondPagComissaoVend) then
          begin
            dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
                (dataSet.FieldByName('VLUN_ORIG').AsCurrency - dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency), - 2);
            dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := dataSet.FieldByName('VLUN_ORIG').AsCurrency;
          end
          else
          begin
            dataSet.FieldByName('NAT_DESCACRES').AsString := 'PERCENTUAL';
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := dataSet.FieldByName('VLUN_ORIG').AsCurrency - dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency;
            dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := dataSet.FieldByName('VLUN_ORIG').AsCurrency;
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := dataSet.FieldByName('VALOR_DESCACRES').AsFloat / dataSet.FieldByName('VLUN_ORIG').AsCurrency * 100;
          end;

          if (vDadosIni.vPedVnd.AcrescCondPagComissaoVend) then
          begin
            if _atribuirComissaoMinVend(
              FOwner.dataSet.FieldByName('TIPO').AsString,
              FOwner.dataSet.FieldByName('TIPV').AsString,
              FOwner.dataSet.FieldByName('TIPO_OS').AsString,
              FOwner.dataSet.FieldByName('TIPO_ORC').AsString,
              FOwner.dataSet.FieldByName('COD_COND_PAG').AsInteger) then
            begin
              dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').AsString := 'S';

              if vPercComissaoVnd3 > 0 then
                dataSet.FieldByName('PERC_COMISSAO_VEND3').AsCurrency := vPercComissaoVnd3
              else
                dataSet.FieldByName('PERC_COMISSAO_VEND3').AsCurrency := 0;

              if vValorAcrescCondPag > 0 then
                dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := vValorAcrescCondPag
              else
                dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := 0;

              dataSet.FieldByName('DESC_ITEM').AsCurrency := dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

              dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';

              dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
            end;
          end;

          if (trim(DataSet.FieldByName('UNIDADE_CONV').AsString) = '')
            or (UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString))) then
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else
          begin
            if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end;
          end;

          if not checaValoresItens then
            Exit;

          if not validaAcresDescNoItem(
            dataSet.FieldByName('TP_DESCACRES').AsString,
            dataSet.FieldByName('NAT_DESCACRES').AsString,
            dataSet.FieldByName('VALOR_DESCACRES').AsCurrency) then
              Exit;
        end
        else if vDadosIni.StrToFloatFormat(vValorUn, 2) > vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
        begin
          dataSet.FieldByName('DESC_ITEM').AsFloat := 0;
          dataSet.FieldByName('TP_DESCACRES').AsString := 'ACRÉSCIMO';

          if (vDadosIni.vPedVnd.AcrescCondPagComissaoVend) then
          begin
            dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
                (dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency - dataSet.FieldByName('VLUN_ORIG').AsCurrency), - 2);
            dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := dataSet.FieldByName('VLUN_ORIG').AsCurrency;
          end
          else
          begin
            dataSet.FieldByName('NAT_DESCACRES').AsString := 'PERCENTUAL';
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency - dataSet.FieldByName('VLUN_ORIG').AsCurrency;
            dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := dataSet.FieldByName('VLUN_ORIG').AsCurrency;
            dataSet.FieldByName('VALOR_DESCACRES').AsFloat := dataSet.FieldByName('VALOR_DESCACRES').AsFloat / dataSet.FieldByName('VLUN_ORIG').AsCurrency * 100;
          end;

          if (vDadosIni.vPedVnd.AcrescCondPagComissaoVend) then
          begin
            if _setarAcrescCondPagComissaoVend(
              FOwner.dataSet.FieldByName('TIPO').AsString,
              FOwner.dataSet.FieldByName('TIPV').AsString,
              FOwner.dataSet.FieldByName('TIPO_OS').AsString,
              FOwner.dataSet.FieldByName('TIPO_ORC').AsString,
              FOwner.dataSet.FieldByName('COD_COND_PAG').AsInteger,
              FOwner.dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat,
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat,
              dataSet.FieldByName('VLUN_PED_ITEM').AsFloat,
              dataSet.FieldByName('VALOR_DESCACRES').AsFloat) then
            begin
              dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').AsString := 'S';

              if vPercComissaoVnd3 > 0 then
                dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vPercComissaoVnd3
              else
                dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;

              if vValorAcrescCondPag > 0 then
                dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := vValorAcrescCondPag
              else
                dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := 0;

              if vValorAcrescimo > 0 then
                dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := vValorAcrescimo
              else
                dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;

              dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
              dataSet.FieldByName('ACRESC_ITEM').AsCurrency := dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

              dataSet.FieldByName('TP_DESCACRES').AsString := 'ACRÉSCIMO';

              dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
            end;
          end;

          vNat_DescAcresc      := dataSet.FieldByName('TP_DESCACRES').AsString;
          vTp_DescAcresc       := dataSet.FieldByName('NAT_DESCACRES').AsString;
          vValor_DescAcresc    := dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;
          vPerc_Comissao_Vend3 := dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat;

          if (trim(DataSet.FieldByName('UNIDADE_CONV').AsString) = '')
            or (UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString))) then
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else
          begin
            if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end;
          end;

          if not checaValoresItens then
            Exit;

          if not validaAcresDescNoItem(
            dataSet.FieldByName('TP_DESCACRES').AsString,
            dataSet.FieldByName('NAT_DESCACRES').AsString,
            dataSet.FieldByName('VALOR_DESCACRES').AsCurrency) then
              Exit;
        end;
      end;
    end;

    if vDadosIni.StrToFloatFormat(vValorUn, 2) < vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
    begin
      vDadosIni.vInibeMensPesqPros := 'N';
      if not vDadosIni.PesqPros('VND132', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
        dataSet.FieldByName('NPED').AsString + '/' + dataSet.FieldByName('NITEM').AsString, buscas, true) then
      begin
        dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(vValorUnOrig, 2);
        dataSet.FieldByName('TABPRATICADA').AsString := pTABPRATICADA;

        if pTABPRATICADA = 'Q' then
        	dataSet.FieldByName('PRECOPORQTDE').AsString := 'S';

        if (trim(DataSet.FieldByName('UNIDADE_CONV').AsString) = '')
          or (UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString))) then
        begin
          DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
            DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
        end
        else
        begin
          if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
                DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end;
        end;
        exit;
      end;
    end
    else
    begin
    	if vDadosIni.StrToFloatFormat(vValorUn, 2) > vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
      begin
        vDadosIni.vInibeMensPesqPros := 'N';
        if not vDadosIni.PesqPros('VND131', 'ALTERAR', dataSet.FieldByName('TIPO').AsString,
          'PEDVENDA', dataSet.FieldByName('NPED').AsString + '/' + dataSet.FieldByName('NITEM').AsString, buscas, true) then
        begin
        	dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(vValorUnOrig, 2);
          dataSet.FieldByName('TABPRATICADA').AsString := pTABPRATICADA;
          
          if pTABPRATICADA = 'Q' then
          	dataSet.FieldByName('PRECOPORQTDE').AsString := 'S';

          if (trim(DataSet.FieldByName('UNIDADE_CONV').AsString) = '')
            or (UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString))) then
          begin
            DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else
          begin
            if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                  DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end
            else
            begin
              DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
                DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
            end;
          end;
          exit;
        end;
      end;
    end;
    result := true;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaProd.verificaGradeProduto: boolean;
var
  vQtdItem, qtdItemDisponivel: double;
  sql, vAbaterItens: string;
  vEstoqueNegativo: string;
  vtemp: string;
begin
  result := false;
  vQtdItem := 0;
  sql := '';
  qtdItemDisponivel := 0;

  vEstoqueNegativo := 'N';
  vDadosIni.vInibeMensPesqPros := 'S';
  if vDadosIni.PesqPros('VND281', 'PERMITIR', FOwner.getTipoVenda, 'PEDVENDA', FOwner.dataSet.FieldByName('NPED').AsString, buscas, false) then
    vEstoqueNegativo := 'S';

  if (vSing.vTipoVenda <> 'REQ') and (vSing.vTipoVenda <> 'OS') then //JC se tiver grade...baixa tanto na OS quanto na REQ
  begin
    Result := true;
    exit;
  end;
  if not ProdutoPossuiGrade(dataSet.FieldByName('grupo_prod').AsInteger, dataSet.FieldByName('cod_prod').AsString) then
  begin
    Result := true;
    exit;
  end
  else
  begin
    if dataSet.FieldByName('cod_grade').Asinteger = 0 then
    begin
      Result := true;
      exit;
    end;
    dtSet.First;
    while not dtSet.eof do
    begin
      if (dtSet.FieldByName('cod_grade').asinteger = dataSet.FieldByName('cod_grade').asinteger) and
        (dtSet.FieldByName('grupo_prod').asinteger = dataSet.FieldByName('grupo_prod').asinteger) and
        (trim(dtSet.FieldByName('cod_prod').AsString) = trim(dataSet.FieldByName('cod_prod').AsString)) and
        (trim(dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
        //        (dtSet.FieldByName('codigo_nop').asfloat = dataSet.FieldByName('codigo_nop').asfloat) then
        if dataSet.State in [dsEdit] then
        begin
          if not(dtSet.FieldByName('NITEM').asinteger = dataSet.FieldByName('NITEM').asinteger) then
            vQtdItem := vQtdItem + dtSet.FieldByName('QUANT_PED_ITEM').AsFloat;
        end
        else
        	vQtdItem := vQtdItem + dtSet.FieldByName('QUANT_PED_ITEM').AsFloat;
      dtSet.Next;
    end;
    try

      buscas.Close;
      buscas.SQL.Text := 'select cod_grade from cod_grade_prod' +
        ' where grupo_prod = ' + IntToStr(dataSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('cod_prod').AsString) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_grade = ' + IntToStr(dataSet.FieldByName('cod_grade').AsInteger);
      buscas.Open;

      if buscas.IsEmpty then
        raise exception.create(pchar('Erro com o item Nº : ' + dataSet.FieldByName('NITEM').Asstring + #13 +
          'Grade de código ' + IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger) + ' não encontrada para o produto'));

      buscas.Close;
      buscas.SQL.Text := 'select ' +
      	' (coalesce(cgp.qtde, 0) - ' +
      	'  coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from pedvenda_prod pp ' +
        '            inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo' +
        '            where pp.grupo_prod = cgp.grupo_prod ' +
        '            and pp.cod_prod = cgp.cod_prod ' +
        '            and pp.cod_grade = cgp.cod_grade ' +
        '            and pp.cod_empresa = cgp.cod_empresa ' +
        '            and coalesce(v.status_ped, '''') = '''' ' +
        '            and coalesce(pp.status, '''') = '''' ' +
        '            and v.NPED <> ' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
        '            sql_tipo), 0) + ' +
        '  coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        ' 				   cgp.grupo_prod, ' +
        '            cgp.cod_prod, ' +
        '            cgp.cod_empresa, ' +
        '            cgp.cod_grade)), 0) ' +
        ' ) as qtd_item_disponivel ' +
        ' from grade g ' +
        ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
        ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
        ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
        ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
        ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by g.cod_grade ';

      if (vDadosIni.vEmp.vApresentarEstR = 'S') then
        sql := sql + ' and v.tipo <> ''ORC'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'R') then
        sql := sql + ' and v.tipo = ''REQ'''
      else if (vDadosIni.vEmp.vApresentarEstR = 'O') then
        sql := sql + ' and v.tipo = ''OS''';

      if (vDadosIni.vEmp.vApresentarEstR = 'R') or
        (vDadosIni.vEmp.vApresentarEstR = 'O') or
        (vDadosIni.vEmp.vApresentarEstR = 'S') then
        buscas.SQL.Text := StringReplace(buscas.SQL.Text, 'sql_tipo', sql, [rfReplaceAll, rfIgnoreCase])
      else
        buscas.SQL.Text := 'select coalesce(cgp.qtde, 0) as qtd_item_disponivel from grade g ' +
        	' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
          ' where cgp.grupo_prod = ' + dataSet.FieldByName('grupo_prod').AsString +
          ' and cgp.cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('cod_prod').AsString)) +
          ' and cgp.cod_grade = ' + dataSet.FieldByName('cod_grade').AsString +
          ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
          ' order by g.cod_grade';

      buscas.Open;
      qtdItemDisponivel := buscas.FieldByName('qtd_item_disponivel').AsFloat;

      if vDadosIni.vEmp.vAbaterItens = 'S' then
      begin
        vAbaterItens := retornaValor('select first 1 coalesce(usar_conferencia_produto, '''') as valor from tipo_vendas ' +
          ' where tipo = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
          ' and sigla = ' + QuotedStr(dataset.FieldByName('TIPV').AsString) +
          ' order by cod_tipo');

        if trim(vAbaterItens) <> 'S' then
        begin
          sql := 'select sum(coalesce(itpd.quant_ped_item, 0)) as soma1 from pedvenda pd' +
           ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo' +
           ' inner join tipo_vendas tv on tv.sigla = pd.tipv and tv.tipo = pd.tipo' +
           ' where pd.ativo = 1 ' +
           ' and itpd.grupo_prod = :grupo ' +
           ' and itpd.cod_prod = :codigo ' +
           ' and itpd.cod_grade = :cod_grade ' +
           ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
           ' and (coalesce(tv.usar_conferencia_produto, '''') = ''S'') ' +
           ' and (pd.data_fech is null or pd.data_fech < :data) ' +
           ' and (itpd.status<>''CANCELADO'' or itpd.status is null) ' +
           ' and pd.cod_vendedor = :cod_vendedor ';

          buscas.Close;
          if vDadosIni.vEmp.vApresentarEstR = 'S' then
            sql := sql + ' and pd.tipo <> ''ORC'''
          else if vDadosIni.vEmp.vApresentarEstR = 'R' then
            sql := sql + ' and pd.tipo = ''REQ'''
          else if vDadosIni.vEmp.vApresentarEstR = 'O' then
            sql := sql + ' and pd.tipo = ''OS''';
          if (vDadosIni.vEmp.vApresentarEstR = 'R') or
            (vDadosIni.vEmp.vApresentarEstR = 'O') or
            (vDadosIni.vEmp.vApresentarEstR = 'S') then
          begin
            buscas.SQL.Text := sql;
            buscas.Params[0].AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
            buscas.Params[1].AsString := dataSet.FieldByName('cod_prod').AsString;
            buscas.Params[2].AsInteger := dataSet.FieldByName('cod_grade').AsInteger;
            buscas.Params[3].AsDate := 0;
            buscas.Params[4].AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
            buscas.Open;
            qtdItemDisponivel := qtdItemDisponivel + buscas.FieldByName('soma1').AsFloat;
          end;
        end;
      end;

      //Aqui está testando a quantidade do item já existente na venda
      //A quantidade disponível deve ser maior a quantidade do item já existente na venda
      if not (qtdItemDisponivel >= dataSet.FieldByName('QUANT_PED_ITEM').AsFloat + vQtdItem) then
      begin
        if (vDadosIni.vEstoqueNegativo <> 'S') then
        begin
        	if vProduto <> nil then
            vProduto.vSim.existeProdutoSimilar(
              dataSet.FieldByName('grupo_prod').AsInteger,
              dataSet.FieldByName('cod_prod').AsString, 2);

          if vEstoqueNegativo <> 'S' then
          	vtemp := 'Erro com o item Nº '
          else
          	vtemp := 'Item Nº ';

          vtemp := vtemp + dataSet.FieldByName('NITEM').Asstring +
            ' - ' + QuotedStr(dataSet.FieldByName('DESCR_PROD_PED').AsString) + sLineBreak +
            'Quantidade informada = ' + FloatToStr(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) + '.' + sLineBreak +
            'Quantidade do item já existente nesta venda = ' + FloatToStr(vQtdItem) + '.' + sLineBreak +
            'Quantidade disponível = ' + FloatToStr(qtdItemDisponivel - vQtdItem) + '.' + sLineBreak + sLineBreak +
            'Quantidade maior que o estoque da Grade ' + dataSet.FieldByName('COD_GRADE').AsString + '.';

          if (vEstoqueNegativo = 'S') then
          begin
//          	if (not FOwner.vSing.vVendaRapida) then
//            	Application.MessageBox(Pchar(vtemp), 'Atenção', MB_OK + MB_ICONINFORMATION)
//            else
//            begin
         	    vtemp := 'Produto ' + QuotedStr(trim(dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
                ' - ' + trim(dataSet.FieldByName('DESCR_PROD_PED').AsString) + sLineBreak +
                IfThen(qtdItemDisponivel <= 0,
                  'sem estoque', 'sem estoque suficiente') + '.';
              if Assigned(FOwner.OnMessage) then
      					FOwner.OnMessage(vtemp);
//            end;

            result := true;
          end
          else if vSing.vTipoVenda = 'REQ' then
            raiseexceptioncreate(vtemp, 'DBedit10')
          else if vSing.vTipoVenda = 'OS' then
            raiseexceptioncreate(vtemp, 'DBedit51');
        end
        else
          result := true;
      end
      else
        Result := true;
      buscas.close;
    except
      on e: exception do
      begin
        buscas.close;
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  end;
end;

