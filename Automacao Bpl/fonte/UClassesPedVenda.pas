      begin
        Application.MessageBox('Não é possível reabrir Venda feita pelo E-Commerce.', 'Informação', MB_ICONINFORMATION + MB_OK);
        exit;
      end;

    if trim(dataSet.FieldByName('VALE_TROCA').AsString) = 'S' then
    begin
      Application.MessageBox('Não é possível reabrir Venda do tipo vale troca.', 'Informação', MB_ICONINFORMATION + MB_OK);
      exit;
    end;

    if (vSing.vTipoVenda = 'OS') and (vDadosIni.vLocacao.vHabilitarLoc) then
