          vdadosini.strzero(DataSet.FieldByName('NPED').AsInteger, 7) +
          '   ' + StringReplace(vDadosIni.vEmp.vTelefone, ' ', '', []) + '  ' +
          datetostr(date) + ' ' + timetostr(time), [Normal,//datetostr(DataSet.FieldByName('DATA_ped').AsDateTime) + ' ' + timetostr(time), [Normal,
          Negrito]);

//      linha := linha + 1;
//      RdpDav.ImpF(linha, 1, VdadosIni.replicate('-', 78), [normal]);
      linha := linha + 1;
      if vDadosIni.vModoTreino = 'S' then
        RdpDav.ImpF(linha, 1, 'MODO TREINAMENTO - NAO É DOCUMENTO FISCAL ', [expandido, negrito])
      else
      RdpDav.ImpF(linha, 1, '           NAO É DOCUMENTO FISCAL ', [expandido, negrito]);
      if Acontrole_pagina_pedido <> fint('nped') then
      begin
        Acontrole_pagina_pedido := fint('nped');
        Acontrole_pagina_pagina := 1;
      end
      else
        Acontrole_pagina_pagina := Acontrole_pagina_pagina + 1;
      RdpDav.impD(linha, RdpDav.TamanhoQteColunas - 1, 'PAG ' + vDadosIni.StrZero(Acontrole_pagina_pagina, 3), [normal]);
      linha := linha + 1;
//    RdpDav.ImpF(linha, 1, 'NAO É VALIDO COMO GARANTIA DE MERCADORIA', [expandido, negrito]);
      if vDadosIni.vModoTreino = 'S' then
        RdpDav.ImpF(linha, 1, 'MODO TREINAMENTO - NAO É VALIDO COMO RECIBO E COMO GARANTIA', [expandido, negrito])
      else
      RdpDav.ImpF(linha, 1, 'NAO É VALIDO COMO RECIBO E COMO GARANTIA', [expandido, negrito]);
      linha := linha + 1;
      if vDadosIni.vModoTreino = 'S' then
        RdpDav.ImpF(linha, 1, 'MODO TREINAMENTO - DE MERCADORIA - NAO COMPROVA PAGAMENTO', [expandido, negrito])
      else
      RdpDav.ImpF(linha, 1, ' DE MERCADORIA - NAO COMPROVA PAGAMENTO', [expandido, negrito]);
//      linha := linha + 1;
//      RdpDav.ImpF(linha, 1, VdadosIni.Replicate('-', 78), [normal]);
      linha := linha + 1;

      buscas.close;
      vtipsaida := '';
      if vSing.vTipoVenda = 'REQ' then
      begin
        buscas.close;
        buscas.sql.text := 'select * from tipo_vendas where tipo = ''' + vSing.vTipoVenda +
          ''' and sigla = ''' + dataset.FieldByName('TIPV').AsString + ''' order by cod_tipo';
        buscas.open;
        vtipsaida := buscas.FieldByName('DESCRICAO').AsString;
      end;
      if vSing.vTipoVenda = 'OS' then
      begin
        vtipsaida := dataSet.FieldByName('TIPO_OS').AsString;
      end;
      if (Length(vtipsaida) + Length(FDadosImpressao.DescricaoVia)) > 32 then
        System.Delete(vtipsaida, 33 - (Length(FDadosImpressao.DescricaoVia)), Length(FDadosImpressao.DescricaoVia));
      vtipsaida := vtipsaida + FDadosImpressao.DescricaoVia;

      vTemp := 'EMITENTE : ' + Trim(vDadosIni.vEmp.vRazaoSocial);
      if Length(vTemp) <= 47 then
      begin
        RdpDav.Impf(linha, 01, 'EMITENTE : ' + vDadosIni.vEmp.vRazaoSocial, [comp17]);
        RdpDav.Impf(linha, 48, 'CNPJ.....: ' + vDadosIni.vEmp.vCNPJ, [comp17]);
        if vtipsaida <> '' then
          RdpDav.Impf(linha, 90, 'TIPO SAÍDA: ' + vtipsaida, [comp17]);
      end
      else
      begin
        vTemp := vTemp + ' - CNPJ: ' + vDadosIni.vEmp.vCNPJ;
        if Length(vTemp) >= 90 then
          RdpDav.Impf(linha, 1, vTemp + ' TIPO SAÍDA: ' + vtipsaida, [comp17])
        else
        begin
          RdpDav.Impf(linha, 1, vTemp, [comp17]);
          if vtipsaida <> '' then
            RdpDav.Impf(linha, 90, 'TIPO SAÍDA: ' + vtipsaida, [comp17]);
        end;
      end;

      if Aped_vnd_hab_imp_end_emp then
      begin
        linha := linha + 1;
        RdpDav.Impf(linha, 1, Copy('           ' +
                              vDadosIni.vEmp.vEndereco  + ', ' +
                              vDadosIni.vEmp.vNumeroEnd + ', ' +
                              vDadosIni.vEmp.vBairro    + ' - ' +
                              vDadosIni.vEmp.vCidade    + ' - ' +
                              vDadosIni.vEmp.vSiglaUF   + ', CEP: ' +
                              vDadosIni.vEmp.vCEP, 1, 89), [comp17]);
        RdpDav.Impf(linha, 90, vDadosIni.vEquipamentos.DescrAdicAtivReparoInstrucacaoInMetr, [comp17]);
      end
      else if (vSing.vTipoVenda = 'OS') or ((vSing.vTipoVenda = 'ORC') and vImprimirOBSORC)
    		and (vDadosIni.vEquipamentos.HabAtivReparoInstrucacaoInMetr) and (vDadosIni.vEmp.vUsarAparelho = 'S') then
      begin
      	linha := linha + 1;
        RdpDav.Impf(linha, 1, vDadosIni.vEquipamentos.DescrAdicAtivReparoInstrucacaoInMetr,[comp17]);
      end;


      linha := linha + 1;
    end;
  end;

  procedure Separador(ln: integer; tp: integer);
