procedure TPedVendaProd._marcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
    	if dataSet.FieldByName('STATUS').AsString <> 'CANCELADO' then
      begin
        dataSet.Edit;
        dataSet.FieldByName('sel').AsString := 'S';
        dataSet.Post;
      end;

      dataSet.Next;
    end;
    dataSet.First;

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TPedVendaProd.CalculaValorTotalItens;
begin
  vTotalItensBruto := 0;
  vTotalItensLiq := 0;
  nItem := _retornaQtdNItensCancelConsignado;
  vSing.vValorAcrescimoIt := 0;
  vSing.vValorDescontoIt := 0;
  vSing.vValorRateioDesconto := 0;
  vSing.vValorRateioAcrescimo := 0;
  vSing.vValorInicialDesc := 0;
  dtSet.First;
  fStringNSerie := '';
  while not dtSet.Eof do
  begin
    if trim(dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
    begin
      if Pos('|' + IntToStr(dtSet.FieldByName('cod_nserie').AsInteger) + '|', fStringNSerie) = 0 then
        fStringNSerie := fStringNSerie + '|' + IntToStr(dtSet.FieldByName('cod_nserie').AsInteger) + '|';
      vTotalItensBruto := vTotalItensBruto + dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;
//      vTotalItensLiq := vTotalItensLiq + dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency +
//        dtSet.FieldByName('RATEIO_ACRESC').AsCurrency -
//        dtSet.FieldByName('RATEIO_DESC').AsCurrency;
      vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto + dtSet.FieldByName('RATEIO_DESC').AsCurrency,-2);
      if dtSet.FieldByName('RATEIO_DESC').AsFloat=0 then
        vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto + dtSet.FieldByName('DESC_ITEM').AsFloat,-2);

      vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + dtSet.FieldByName('RATEIO_ACRESC').AsCurrency,-2);
      if dtSet.FieldByName('RATEIO_ACRESC').AsCurrency=0 then
        vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + dtSet.FieldByName('ACRESC_ITEM').AsCurrency,-2);

      vTotalItensLiq := vTotalItensLiq + dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;

      vSing.vValorAcrescimoIt := vSing.vValorAcrescimoIt + dtSet.FieldByName('ACRESC_ITEM').AsFloat;
      vSing.vValorDescontoIt := vSing.vValorDescontoIt + dtSet.FieldByName('DESC_ITEM').AsFloat;

      if ((dtSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S')) then
      	vSing.vValorInicialDesc := vSing.vValorInicialDesc + (dtSet.FieldByName('vlun_ped_item').AsFloat - dtSet.FieldByName('vlun_orig').AsFloat) * dtSet.FieldByName('quant_ped_item').AsFloat
      else if ((dtSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S')) then
      	vSing.vValorInicialDesc := vSing.vValorInicialDesc + (dtSet.FieldByName('vlun_ped_item').AsFloat - dtSet.FieldByName('vlun_orig').AsFloat) * dtSet.FieldByName('quant_ped_item').AsFloat
      else if ((dtSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S')) then
      	vSing.vValorInicialDesc := vSing.vValorInicialDesc + (dtSet.FieldByName('vlun_ped_item').AsFloat - dtSet.FieldByName('vlun_orig').AsFloat) * dtSet.FieldByName('quant_ped_item').AsFloat;
    end;
    inc(nItem);
    dtSet.Next;
  end;

  vTotalItensLiq := vTotalItensLiq + vSing.vValorRateioAcrescimo - vSing.vValorRateioDesconto;

  fStringNSerie := StringReplace(fStringNSerie, '||', ',', [rfReplaceAll]);
  fStringNSerie := StringReplace(fStringNSerie, '|', '', [rfReplaceAll]);
end;

function TPedVendaProd.CalcCustLiq(vNum_fab, vtip: string; vvalor, vlcusto, mimMargLiqEmp:
  currency): boolean;
var
  vMargem: TMargemProduto;
  vMargLiq, vPercMargLiq: Currency;
begin
  Result := true;
  vDadosIni.abreStatusProcessamento('', 'Verificando margem do item');
  vMargem := TMargemProduto.create;
  if not vMargem.vProd.verificarDNA(vmargem.vProd.vEmp.dataSet.FieldByName('CODDEPPRODUTOS').AsInteger) then
  begin
    vDadosIni.fechaStatusProcessamento;
    Application.MessageBox('Não Encontrado a fórmula do DNA do DEPTO/EMPRESA', 'Atenção', MB_OK + MB_ICONINFORMATION);
    result := false;
    exit;
  end;
  Result := vMargem.obterMargemProduto(vvalor, vlcusto, vNum_fab, vtip = 'A', vMargLiq,
    vPercMargLiq, 1);

  if vpermgvnd > 0 then
  begin
    if vPercMargLiq < vpermgvnd then
    begin
      vDadosIni.fechaStatusProcessamento;
      Application.MessageBox(Pchar('Margem Atingida ' + format('%n', [vPercMargLiq]) + '% menor que ' + #13 +
        'Margem minima ' + format('%n', [vpermgvnd]) + ' para ' + #13 +
        'o Produto ' + vNum_fab), 'Informação', MB_OK + MB_ICONINFORMATION);
      if not vDadosIni.PesqPros('VND102', 'PERMITIR MARG.MIN', 'Margem Estab/Atingida: ' + format('%n', [vpermgvnd]) + '/' + format('%n', [vPercMargLiq]), 'PEDVENDA', dataset.FieldByName('NUM_FAB_PROD').AsString, buscas, true) then
        CalcCustLiq := false
      else
        CalcCustLiq := true;
    end
    else
      CalcCustLiq := true;
  end
  else
  begin
    if vPercMargLiq < mimMargLiqEmp then
    begin
      vDadosIni.fechaStatusProcessamento;
      messagedlg('Margem Atingida ' + format('%n', [vPercMargLiq]) + '% menor que ' + #13 +
        'Margem Liquida minima ' + format('%n', [mimMargLiqEmp]) + ' para ' + #13 +
        'o Produto ' + vNum_fab, mtinformation, [mbOK], 0);
      if not vDadosIni.PesqPros('VND102', 'PERMITIR MARG.MIN', 'Margem Estab/Atingida: ' + format('%n', [vpermgvnd]) + '/' + format('%n', [vPercMargLiq]), 'PEDVENDA', dataset.FieldByName('NUM_FAB_PROD').AsString, buscas, true) then
        CalcCustLiq := false
      else
        CalcCustLiq := true;
    end
    else
      CalcCustLiq := true;
  end;
  vDadosIni.fechaStatusProcessamento;
end;

function TPedVendaProd.CalculaAcresDesc(PercAcres, PercDesc: double; ValorAcres, ValorDesc:
  Currency): boolean;
var
  vrProdPermDesc: Currency;
begin
  result := false;
  if (ValorAcres < 0) or (PercAcres < 0) then
  begin
    Application.MessageBox('Valor para Acréscimo inválido', 'Informação', MB_OK + MB_ICONWARNING
      + MB_DEFBUTTON1);
    Exit;
  end;

  if (ValorDesc < 0) or (PercDesc < 0) then
  begin
    Application.MessageBox('Valor para Desconto inválido', 'Informação', MB_OK + MB_ICONWARNING +
      MB_DEFBUTTON1);
    Exit;
  end;
  try
    result := true;
    vrProdPermDesc := 0;
    dataSet.First;
    while not dataSet.Eof do
    begin
      buscas.Close;
      buscas.SQL.Text := 'SELECT * FROM Produtos where cod_prod = ' +
        quotedstr(dataSet.FieldByName('COD_PROD').asstring) + ' and grupo_prod = ' +
        dataSet.FieldByName('GRUPO_PROD').asstring + ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo=1 ';
      buscas.Open;
      if (buscas.FieldByName('PERMITIR_DESCONTO').AsString <> 'N')
        and (buscas.FieldByName('EM_PROMOCAO').AsString <> 'S')
        and (dataSet.FieldByName('TABPRATICADA').AsString <> 'P')
        and (dataSet.FieldByName('TABPRATICADA').AsString <> 'T')
        and (dataSet.FieldByName('TABPRATICADA').AsString <> 'Q') then
        //        (not _produtoempromocao) then
        vrProdPermDesc := vrProdPermDesc + (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
          dataSet.FieldByName('VLUN_PED_ITEM').AsFloat);
      dataSet.next;
    end;

    vAcrescimo := 0;
    vDesconto := 0;

    vAcrescimo := ValorAcres + (PercAcres * vrProdPermDesc / 100);
    vDesconto := ValorDesc + (PercDesc * vrProdPermDesc / 100);
  except
    result := false;
  end;
end;

function TPedVendaProd.cancel: boolean;
var
	item, I: integer;
	vProcessoExcluir: Boolean;
   vRecNoItem: Integer;
begin
  Result := false;
  if FOwner.vendaFechada then
  begin
    Application.MessageBox(pchar('Venda já esta fechada?'), 'Atenção',
      MB_ICONINFORMATION + MB_OK);
    Exit;
  end;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    dataSet.Cancel;
    Result := true;
  end
  else if dataSet.State = dsBrowse then
  begin
    if FOwner.CancelarVariosItens then
      if Application.MessageBox(pchar('Deseja excluir os item selecionados?'), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> IDYES then
      begin
        Result := false;
        exit;
      end;

    if not FOwner.CancelarVariosItens then
      if (dataSet.IsEmpty) or (trim(dataSet.FieldByName('STATUS').AsString) = 'CANCELADO') then
      begin
        Result := false;
        exit;
      end;

    if vSing.vTipoVenda = 'REQ' then
    begin
      if FOwner.CancelarVariosItens then
      begin
        if not vDadosIni.PesqPros('VND012', 'CANCELAR ITEM', dataSet.FieldByName('TIPO').AsString +
        	' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
          ' GRUPO:' + dataSet.FieldByName('GRUPO_PROD').AsString +
        	' COD PROD:' + dataSet.FieldByName('COD_PROD').AsString, 'PEDVENDA_PROD',
        	dataSet.FieldByName('NPED').AsString, buscas, true) then
        begin
          Result := false;
          exit;
        end;
      end
      else if Application.MessageBox(pchar('Deseja excluir o item?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDYES then
      begin
        if not vDadosIni.PesqPros('VND012', 'CANCELAR ITEM', dataSet.FieldByName('TIPO').AsString +
        	' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
          ' GRUPO:' + dataSet.FieldByName('GRUPO_PROD').AsString +
        	' COD PROD:' + dataSet.FieldByName('COD_PROD').AsString, 'PEDVENDA_PROD',
        	dataSet.FieldByName('NPED').AsString, buscas, true) then
        begin
          Result := false;
          exit;
        end;
      end
      else
        exit;
    end
    else if vSing.vTipoVenda = 'OS' then
