    APedVenda.RollBackTransacao;

  finally
    APedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    APedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
