function TPedVenda.abreFormDetParcelamentoContas: Boolean;
var
  formulario: TfrmPadrao;
  I: Integer;
  vOK: boolean;
  vOK2: boolean;
begin
  try
    vOK := false;
    vOK2 := false;

    if trim(dataSet.FieldByName('TIPO').AsString) <> 'OS' then
    begin
      Application.MessageBox(Pchar('Opção disponível somente para Ordem de Serviço'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;

    if trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'FECHADA' then
    begin
      Application.MessageBox(Pchar('A Ordem de Serviço não está FECHADA'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;

    vSing.vTipoVenda := 'OS';
    if not vItServTerc.abreServicoTerceiro(dataSet.FieldByName('NPED').AsInteger) then
      exit;
    if not vItProdTerc.abreProdTerceiro(dataSet.FieldByName('NPED').AsInteger) then
      exit;
       
    if (vItServTerc.dataSet.IsEmpty) and (vItProdTerc.dataSet.IsEmpty) then
    begin
      Application.MessageBox(Pchar('Ordem de Serviço não possui produtos e serviço de terceiro'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;

    vOK := true;

    if not vContasServTerc.abreContasServTerc(
      dataSet.FieldByName('NPED').AsInteger,
      dataSet.FieldByName('TIPO').AsString) then
        exit;

	  try
      formulario := TfrmPadrao.Create(Application);
      formulario.Width := 620;
      formulario.Height := 500;
      formulario.Position := poScreenCenter;
      formulario.Caption := 'Produtos/Serviços de Terceiro - Contas a pagar';
      TFrmCadPedVenda(FrmCadPed).BitBtn112.Visible := vContasServTerc.dataSet.IsEmpty;
      TFrmCadPedVenda(FrmCadPed).pnDetFaturas.Parent := formulario;
      formulario.AutoSize := True;
      formulario.AutoScroll := False;
      formulario.ShowHint := True;
      formulario.BorderIcons := [];
      result := (formulario.ShowModal = mrOk);
    finally
      if Result then
      begin
        vOK2 := verificarContasPagar(FContas, true);
        if vOK2 then
        begin
          CommitaTransacao;
          vDadosIni.GravaAuditoria('VND237', 'INCLUIR', 'SUCESSO', 'PEDVENDA', '', buscas);
        end
        else
        begin
          RollBackTransacao;
          vDadosIni.GravaAuditoria('VND237', 'INCLUIR', 'FALHA', 'PEDVENDA', '', buscas);
        end;
      end;
      if vOK then
      begin
        TFrmCadPedVenda(FrmCadPed).pnDetFaturas.Parent := TFrmCadPedVenda(FrmCadPed).tsFaturasServTerc;
        if Assigned(formulario) then
      		 FreeAndNil(formulario);
      end;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

