function TPedVendaProdTerc._locFornecedor(pCodFornec: integer): boolean;
begin
  result := false;
  buscas.Close;
  buscas.SQL.Text := 'select cod_cliente,cod_empresa,NOME_CLIENTE, RAZAO,cpfcgc from clientes ' +
    ' where cod_cliente = ' + IntToStr(pCodFornec) + ' and (tipo=''F'' or tipo=''A'') ' +
    ' and ativo=1 and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;
  if buscas.IsEmpty then
  begin
    if Application.MessageBox(Pchar('Fornecedor não Encontrado.' + chr(13) + 'Deseja continuar?'),
    	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = mrNo then
      vNomeCampoErro := 'DBEdit142'
    else if trim(dataSet.FieldByName('NOME_FORNECEDOR').AsString) = '' then
    begin
      vNomeCampoErro := 'DBEdit143';
      result := true;
    end;
  end
  else
  begin
    dataSet.FieldByName('NOME_FORNECEDOR').AsString := buscas.FieldByName('RAZAO').AsString;
    result := true;
  end;
end;

