function TPedVenda.setCalculoPendente(pCommitTransacao: Boolean): Boolean;
begin
  Result := True;
  if (dataSet.FieldByName('SAVEAUTO').AsString <> 'S') then
    Exit;

  try
    if outroUsuarioEditando then
      Exit;
    if dataSet.State = dsBrowse then
      dataSet.Edit;
    dataSet.FieldByName('calc').AsString := 'N';
    dataSet.Post;
    if dataSet.ChangeCount > 0 then
      Result := Apply;
    if ((Result) and (pCommitTransacao)) then
      CommitaTransacao;
    if Result then
      abrePedVenda(dataSet.FieldByName('nped').AsInteger);
    if dataSet.State = dsBrowse then
      dataSet.Edit;

    if not Result then
    begin
      if pCommitTransacao then
        RollBackTransacao;
      Application.MessageBox(PChar('O sistema não conseguir alterar dados n' + vSing.nomeVenda +
        '. Possivelmente outro usuário está alterando o mesmo registro. Verifique e tente novamente'),
        'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  except
    on e: Exception do
    begin
      Result := False;
      RollBackTransacao;
      registraErro('TPedVenda.setCalculoPendente. Erro: ' + e.Message);
      Application.MessageBox(PChar('O sistema não conseguir alterar dados n' + vSing.nomeVenda +
        '. Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

