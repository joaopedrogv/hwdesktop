{ TPedvenda_comiss_class }

procedure TPedvenda_comiss_class.CalcularComiss(pCalc: boolean);
var
  vIncVlVnd: Double;
  vIncVlPart: Double;
begin
  vIncVlVnd := 0;
  vIncVlPart := 0;
  
  if not vDadosIni.vPedVnd.comissaoPorVenda then
    exit;

  if valor_total <= 0 then
    exit;

  if (perc_prod_vendedor > 0) then
  begin
    perc_comissao_vend := perc_prod_vendedor;
    vl_comissao_vend := vDadosIni.IfThen(not pCalc, vl_comissao_vend, (0.01 * Trunc(((valor_total / 100) * perc_prod_vendedor) * 100)));
  end
  else
  begin
    perc_comissao_vend := 0;
    vl_comissao_vend := 0;
  end;

  if (vDadosIni.vPedVnd.habPartipante) and (perc_prod_participante > 0) then
  begin
    perc_comissao_vend1 := perc_prod_participante;
    vl_comissao_vend1 := vDadosIni.IfThen(not pCalc, vl_comissao_vend1, (0.01 * Trunc(((valor_total / 100) * perc_prod_participante) * 100)));
  end
  else
  begin
    perc_comissao_vend1 := 0;
    vl_comissao_vend1 := 0;
  end;
end;

function TPedvenda_comiss_class.Clone: TPedvenda_comiss_class;
begin
  if not Assigned(Result) then
  Result                     := TPedvenda_comiss_class.Create;
