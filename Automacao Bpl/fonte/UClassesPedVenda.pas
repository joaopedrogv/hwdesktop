  dtSet.First;
  while not dtSet.Eof do
  begin
    if (dtSet.FieldByName('cod_grade').AsInteger = codgrade) and
      (dtSet.FieldByName('grupo_prod').AsInteger = grupoprod) and
      (dtSet.FieldByName('cod_prod').AsString = cod_prod) and
      (dtSet.FieldByName('tipo').AsString = tipo) then
