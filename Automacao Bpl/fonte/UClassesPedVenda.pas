            vControleEnt.sql.text := ' SELECT * FROM CONTROLES ' +
              ' WHERE CXENT = ''S'' ' +
              ' AND DOCS <> ''S2'' ' +
              ' AND CODIGO_EMP = ' + vDadosIni.codEmpresa +
              ' AND ATIVO = 1 ' +
              ' ORDER BY QSEQPERF ';
            vControleEnt.Open;
            vControleEnt.FetchAll;

            if FrmobsCxl = nil then
            begin
              Application.CreateForm(TFrmobsCxl, FrmobsCxl);

              if DtmPedVenda = nil then
                DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

              vDadosIni.AlterarDataSourceComponentes(FrmobsCxl, DtmPed);
            end;

            buscas.Close;
            buscas.SQL.Text := ' select trim(cd.desc_cond_pag) desc_cond_pag  from pedvenda pd ' +
             ' inner join cond_pag cd on cd.cod_cond_pag = pd.cod_cond_pag ' +
             ' where pd.nped = ' + IntToStr(dataset.FieldByName('NPED').AsInteger) +
             ' and pd.tipo = ' + QuotedStr(dataset.FieldByName('TIPO').AsString) +
             ' and pd.cod_empresa =' + vDadosIni.codEmpresa;
            buscas.Open;
            if trim(dataSet.FieldByName('OBS_CXL_RQ').AsString) = '' then
              dataSet.FieldByName('OBS_CXL_RQ').AsString := buscas.FieldByName('DESC_COND_PAG').AsString;
            if FrmobsCxl.ShowModal = mrOk then
            begin
              if (vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2') then
              begin
                if CadastrarFormEnt then
                begin
                  dataset.FieldByName('CODIGO_CTRL').AsInteger := FrmobsCxl.vcodigoctrl;
                  dataset.FieldByName('VL_ENTRADA').AsCurrency := FrmobsCxl.vlent;
                end
                else
                begin
                  dataset.FieldByName('CODIGO_CTRL').Value := Null;
                  dataset.FieldByName('VL_ENTRADA').AsFloat := 0;
                end;
              end;
            end;
            vControleEnt.close;
          end;
        end;
        dataSet.Post;
        vItProd.Apply;
        vItServ.Apply;
        vItServTerc.Apply;
        vItProdTerc.Apply;
        Apply;

        if trim(ultimoErro) <> '' then
          if (Pos('EXC_PED_CONF_TOTAL', ultimoErro) > 0) then
          begin
            verificaFechamento(4);
            Result := false;
            Exit;
          end;

        if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'REQ') then
          vDadosIni.informarSituacaoPedido(
            dataSet.FieldByName('nped').AsInteger, vSing.vTipoVenda,
            'PEDIDO',
            'Finalizado',
            '',
            buscas, False, False);

        dataSet.Refresh;
        vCliente.abreClientes(dataSet.FieldByName('cod_cliente').AsInteger);
        //      if vCliente.dataSet.FieldByName('TIPOCLIENTE').AsString='' then
        //        vCliente.gravaTipoCliente('P',vSing.vTipoVenda)
        //      else
        vCliente.gravaTipoCliente(vCliente.dataSet.FieldByName('TIPOCLIENTE').AsString, vSing.vTipoVenda);
        result := CommitaTransacao;
        if result then
        begin
          if (dataSet.FieldByName('nprevenda').AsInteger > 0) then
            vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);
          try
          vItProd.dataSet.DisableControls;
          vItProd.dataSet.First;
          while not vItProd.dataSet.Eof do
          begin
            vMD5Func._gravaMD5_Produtos(buscas,
              vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
              vItProd.dataSet.FieldByName('cod_prod').AsString);
            vItProd.dataSet.Next;
          end;
          finally
            vItProd.dataSet.EnableControls;
          end;

          with Fconf.est_min_notificar do
            if ContainsStr(ReadString('Conf', 'Documentos', ''), fstr('tipo')) then
              if ReadString('Conf', 'AposConfirmar', 'N') = 'S' then
                 NotificarEstoqueMinimoAtingido;
        end;
        vtemp := '';
        if vSing.vVendaRapida then
          vtemp := ' número ' + dataSet.FieldByName('nped').AsString;
        if not result then
          raise exception.create('Erro no fechamento d' + vSing.nomeVenda + ': ' +
            dataSet.FieldByName('nped').AsString + '  O procedimento será revertido');

        if not vDadosIni.vPedVnd.Otimizacao.Ativa then
          ExibirMensagem := True
        else
          ExibirMensagem := not vDadosIni.vPedVnd.Otimizacao.InibirMensagem.ConfirmarDocumento;

        if not ExibirMensagem then
        else if pAutorizacaoPeloFinanc  then
        else if vSing.vTipoVenda = 'REQ' then
          Application.MessageBox(pchar('Requisição' + vtemp + ' confirmada'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else if vSing.vTipoVenda = 'OS' then
          Application.MessageBox(pchar('Ordem de Serviço confirmada'), 'Atenção', MB_ICONINFORMATION + MB_OK);

        if ((vDadosIni.vEmp.vModoFaturamento <> 'S') or (vDadosIni.vPedVnd.ReceberPeloFinanceiro))
          and (vDadosIni.vEmp.vConfFormPagamento = 'PED') then
        begin
          if (not vDadosIni.vPedVnd.Otimizacao.Ativa)
            or (not vDadosIni.vPedVnd.Otimizacao.Outras.FormaPagamentoAntesDeFechar) then
          begin
            existeRetencaoProdutos := (Trim(vSing.vTipoVenda) <> 'ORC')
              and fequals('nf_ac_calctrib', 'S')
              and vDadosIni.existeProdutoDoc( buscas, fint('nped'), fstr('tipo'))
              and vDadosIni.RetencaoClienteNFe(
                buscas, IfThen(fint('cod_cli_fat') > 0, fint('cod_cli_fat'), fint('cod_cliente'))
              );

            existeRetencaoServicos := (Trim(vSing.vTipoVenda) = 'OS')
              and Container.GetInstance().ErpFeaturesFactory.CreateChecarPossivelRetencaoNFSeUseCase()
                .Executar(fint('nped'));

            if existeRetencaoProdutos and existeRetencaoServicos then
              ShowAtencao('Possível retenção nas notas fiscais de Produtos e Serviços. Emita as notas antes do recebimento')
            else if existeRetencaoProdutos then
              ShowAtencao('Possível retenção na nota fiscal de Produtos. Emita as notas antes do recebimento')
            else if existeRetencaoServicos then
              ShowAtencao('Possível retenção na nota fiscal de Serviços. Emita as notas antes do recebimento')
            else
              iniciaFormaPagamento;
            {            
            vExisteServicoOS           := False;
          	vRetencaoFedClienteNF      := False;
            vRetencaoFedClienteNFS     := False;
            vRetencaoFedTpServNFS      := False;
            vIssRetidoClienteNFS       := False;
            vIssRetidoTpServNFS        := False;

            vExisteProduto             := vDadosIni.existeProdutoDoc(
                                            buscas,
                                            fint('nped'),
                                            fstr('tipo'));

            if trim(vSing.vTipoVenda) <> 'ORC' then
            begin
              if fstr('nf_ac_calctrib') = 'N' then
                vRetencaoFedClienteNF  := False
              else
                vRetencaoFedClienteNF  := vDadosIni.RetencaoClienteNFe(
                                            buscas,
                                            IfThen(fint('cod_cli_fat') > 0, fint('cod_cli_fat'), fint('cod_cliente')));
            end;

            if trim(vSing.vTipoVenda) = 'OS' then
            begin
            	vExisteServicoOS         := vDadosIni.existeServicoDoc(
                                             buscas,
                                             fint('nped'),
                                             fstr('tipo'));

              vRetencaoFedClienteNFS   := vDadosIni.RetencaoClienteNFSe(
                                   		      buscas,
                                   		      fint('cod_cliente'));

              vRetencaoFedTpServNFS    := vDadosIni.RetencaoTpServicoNFSe(
                                            buscas,
                                            fint('nped'),
                                     	      fstr('tipo'));

           	  vIssRetidoClienteNFS     := vDadosIni.IssRetidoClienteNFSe(
                                            buscas,
                                            fint('cod_cliente'));

              vIssRetidoTpServNFS      := vDadosIni.IssRetidoTpServicoNFSe(
                                            buscas,
                                            fint('nped'),
                                            fstr('tipo'));
            end;

            if ((vExisteProduto) and (vRetencaoFedClienteNF)) or ((vExisteServicoOS) and ((vRetencaoFedClienteNFS) or (vRetencaoFedTpServNFS))) then
              ShowAtencao('Possível retenção de tributos federais. Emita as notas fiscais antes do recebimento')
            else if (vExisteServicoOS) and ((vIssRetidoClienteNFS) or (vIssRetidoTpServNFS)) then
              ShowAtencao('Possível ISS Retido. Emite a NFSe dos Serviços antes do recebimento')
            else
              iniciaFormaPagamento;
            }
          end;
        end;
        env := 'S';
        if Trim(vSing.vTipoVenda) = 'REQ' then
        vDadosIni.GravaAuditoria('VND060', 'CONFIRMAR', 'CONFIRMADA ' + getTipoVenda + ' Nº ' +
          dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);

        if Trim(vSing.vTipoVenda) = 'OS' then
        vDadosIni.GravaAuditoria('VND061', 'CONFIRMAR', 'CONFIRMADA ' + getTipoVenda + ' Nº ' +
          dataSet.FieldByName('NPED').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);

      except
        on e: exception do
        begin
          RollBackTransacao;
          verificaFechamento(3);
          Result := false;
          Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
          registraErro(e.Message);
        end;
      end;
    finally
      if vSing.vTipoVenda = 'REQ' then
        doc := 'REQVENDA'
      else if vSing.vTipoVenda = 'OS' then
        doc := 'ORDEM_SERV'
      else
        doc := 'ORCAMENTO';
      if (result) or ((vSing.vTipoVenda = 'REQ') and (dataset.FieldByName('TIPV').AsString = 'C')) then
        if (vDadosIni.vEmp.vUsarPreVenda <> 'S') then
          if not pAutorizacaoPeloFinanc then
          begin
            if not vDadosIni.vPedVnd.Otimizacao.Ativa then
              ExibirMensagem := True
            else
              ExibirMensagem := not vDadosIni.vPedVnd.Otimizacao.InibirMensagem.ImprimirDocumentoAoConfirmar;

            if (not ExibirMensagem) then
            begin
              if verificarImpressaoPerm then
                if (vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.SempreImprimirAoConfirmar) then
                begin
                  vDadosIni.logsPedvenda(Self.ClassName + '.confirmarVenda - imprimirDocumento;', 'pedvenda');

                  imprimirDocumento;
                end;
            end
            else
            begin
              if verificarImpressaoPerm then
                if (Application.MessageBox(pchar('Deseja imprimir ' + vSing.nomeVenda + '?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES) then
                begin
                  vDadosIni.logsPedvenda(Self.ClassName + '.confirmarVenda - imprimirDocumento;', 'pedvenda');

                  imprimirDocumento;
                end;
            end;
          end;

      if (vDadosIni.vFiscalAtivo = 'S') and (env = 'S') then
      begin
        vDadosIni.logsPedvenda(Self.ClassName + '.post - enviarVendaParaCupom;', 'pedvenda');

        enviarVendaParaCupom;
      end;

      if Result then
        if Assigned(FAfterConfirmar) then
          FAfterConfirmar(Self);

      {if vDadosIni.vEmp.vEmitirNF = 'S' then
      begin
        if Application.MessageBox('Deseja Emitir NF desta Venda?', 'Confirmação',
          MB_YESNO + MB_DEFBUTTON2) = mrYES then
        begin
          // Colocar aqui a chamada da NF
          vNf := TNFCab.create;
          vNf.cadNfpeloPedVenda(CadPendReq.dataSet.FieldByName('nped').AsInteger,
          CadPendReq.vtipdoc+'CXL', True);
          vNf.Free;
        end;
      end;}

      if Result then
        pedidoEmEdicao(caRemoverEdicao, False);

      try
        if Result then
          dataSet.Refresh
        else dataSet.cancel;
      except

      end;
    end;
  finally
  	vDadosIni.logsPedvenda(Self.ClassName + '.confirmarVenda - end', 'pedvenda');
    
  	if Assigned(ConfigPoliticaPag) then
    	FreeAndNil(ConfigPoliticaPag);
  end;
end;

{function TPedVenda.ConsultaCampos(tabela, valorConsulta, Campo, condicao,
  ordem: string; constante: boolean; codemp: string): boolean;
var
  I: integer;
  possuiCodEmpresa, possuiAtivo: boolean;
  tipo: string; // F (Integer, Float); S String; D Data; I Indefinido
begin //Começa    Igual    Diferente   Maior   Menor   Esta Contido
  try
    possuiCodEmpresa := false;
    possuiAtivo := false;
    result := false;
    if valorConsulta <> '' then
    begin
      try
        if condicao = 'Igual' then
          condicao := '='
        else if condicao = 'Maior' then
          condicao := '>'
        else if condicao = 'Menor' then
          condicao := '<'
        else if condicao = 'Diferente' then
          condicao := '<>'
        else if (condicao = 'Esta contido') then
          condicao := 'like'
        else if (condicao = 'Começa') then
          condicao := 'Começa'
        else
          condicao := '=';
        for I := 0 to DataSet.FieldCount - 1 do
        begin
          if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(Campo) then
          begin
            Campo := DataSet.Fields[I].FieldName;

            if UpperCase(DataSet.Fields[I].DisplayName) = UpperCase(ordem) then
              ordem := DataSet.Fields[I].FieldName;

            if Dataset.Fields[I].FieldName = 'COD_EMPRESA' then
              possuiCodEmpresa := true;
            if Dataset.Fields[I].FieldName = 'ATIVO' then
              possuiAtivo := true;

            if (Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
              (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField) then
              tipo := 'F'
            else if DataSet.Fields[i] is TStringField then
              tipo := 'S'
            else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
              tipo := 'D'
            else
              tipo := 'I';
            break;
          end;
        end;
        for I := 0 to DataSet.FieldCount - 1 do
          if Dataset.Fields[I].FieldName = 'COD_EMPRESA' then
          begin
            possuiCodEmpresa := true;
            Break;
          end;
        for I := 0 to DataSet.FieldCount - 1 do
          if Dataset.Fields[I].FieldName = 'ATIVO' then
          begin
            possuiAtivo := true;
            Break;
          end;
        for I := 0 to DataSet.FieldCount - 1 do
          if UpperCase(DataSet.Fields[I].DisplayName) = UpperCase(ordem) then
          begin
            ordem := DataSet.Fields[I].FieldName;
            Break;
          end;
        DataSet.Close;
        if tipo = 'F' then
        begin
          if (condicao = 'like') or (condicao = 'Começa') then
            condicao := '=';
          DataSet.CommandText := 'select * from ' + tabela + ' where ' + Campo + ' ' + condicao + ' '
            + vDadosIni.tirapontos(valorConsulta, 5);
        end
        else if (tipo = 'S') or (tipo = 'I') then
        begin
          if condicao = 'like' then
            DataSet.CommandText := 'select * from ' + tabela + ' where ' + Campo + ' like ' +
              QuotedStr('%' + valorConsulta + '%')
          else if condicao = 'Começa' then
            DataSet.CommandText := 'select * from ' + tabela + ' where ' + Campo + ' like ' +
              QuotedStr(valorConsulta + '%')
          else
            DataSet.CommandText := 'select * from ' + tabela + ' where ' + Campo + ' ' + condicao +
              ' ' + QuotedStr(valorConsulta);
        end;

        if possuiCodEmpresa then
          DataSet.CommandText := DataSet.CommandText + ' and cod_empresa = ' + codemp;
        if possuiAtivo then
          DataSet.CommandText := DataSet.CommandText + ' and ativo=1';

        DataSet.CommandText := DataSet.CommandText + ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
          ' order by ' + ordem;
        DataSet.Open;
        Result := true;
      except
        on e: exception do
        begin
          Result := false;
          MessageDlg('E0009 Erro ao efetuar consulta. Erro: ' + e.Message + DataSet.CommandText,
            mtInformation, [mbOK], 0);
          registraErro('E0009 ' + e.Message + DataSet.CommandText);
        end;
      end;
    end
    else
    begin
      try
        for I := 0 to DataSet.FieldCount - 1 do
          if Dataset.Fields[I].FieldName = 'COD_EMPRESA' then
          begin
            possuiCodEmpresa := true;
            Break;
          end;
        for I := 0 to DataSet.FieldCount - 1 do
          if Dataset.Fields[I].FieldName = 'ATIVO' then
          begin
            possuiAtivo := true;
            Break;
          end;
        DataSet.close;
        DataSet.CommandText := 'select * from ' + tabela + ' where tipo = ' +
          QuotedStr(vSing.vTipoVenda);
        if possuiCodEmpresa then
          DataSet.CommandText := DataSet.CommandText + ' and cod_empresa = ' + codemp;
        if possuiAtivo and possuiCodEmpresa then
          DataSet.CommandText := DataSet.CommandText + ' and ativo = 1'
        else
          if possuiAtivo then
            DataSet.CommandText := DataSet.CommandText + ' and ativo = 1';
        DataSet.Open;
        Result := true;
      except
        on e: exception do
        begin
          Result := false;
          MessageDlg('E0010 Erro ao efetuar consulta. Erro: ' + e.Message + DataSet.CommandText,
            mtInformation, [mbOK], 0);
          registraErro('E0010 ' + e.Message + DataSet.CommandText);
        end;
      end;
    end;
  finally
    possuiCodEmpresa := false;
  end;
end; }

function TPedVenda.ConsultaAvancada(tabela, valorConsulta, Campo, condicao, ordem: string;
  avancado, constante: boolean;
  codemp, dataIni, dataFim: string;
  status, DavSimNaoTodos: integer; datas: boolean): boolean;
var
  tempSql, vCampoTemp, vCondicaoTmp, tableJoin, joinSql: string;
  ProcessoPesqVendedor: string;
  I: Integer;
begin
  tempSql := '';
  tempSql := ' and pedvenda.tipo = ' + QuotedStr(getTipoVenda);
  if getTipoVenda = 'REQ' then
    ProcessoPesqVendedor := 'VND222'
  else if Trim(getTipoVenda) = 'OS' then
    ProcessoPesqVendedor := 'VND223'
  else
    ProcessoPesqVendedor := 'VND224';
  if not vDadosIni.PesqPros(ProcessoPesqVendedor, 'HABILITAR', '', 'PEDVENDA', '', buscas, False, False, True) then
    tempSql := tempSql + ' and pedvenda.cod_vendedor = ' + IntToStr(vDadosIni.vCodUsuario);

  if avancado then
  begin
    if status <> 2 then
    begin
      if status = 0 then
        tempSql := tempSql + ' and ((pedvenda.status_ped = '''') or (pedvenda.status_ped is null))'
      else if status = 1 then
        tempSql := tempSql + ' and (pedvenda.status_ped <> '''')';
    end;
  end;

  if avancado then
  begin
    if DavSimNaoTodos <> 3 then
    begin
      if DavSimNaoTodos = 0 then
        tempSql := tempSql + ' and ((pedvenda.nprevenda <> 0) and (pedvenda.nprevenda is not  null))'
      else if DavSimNaoTodos = 1 then
        tempSql := tempSql + ' and ((pedvenda.paf_num_prevenda <> 0) and (pedvenda.paf_num_prevenda is not  null))'
      else if DavSimNaoTodos = 2 then
        tempSql := tempSql +
          ' and coalesce(pedvenda.ncupom, 0) <> 0 and coalesce(pedvenda.nprevenda, 0) = 0 and coalesce(pedvenda.paf_num_prevenda, 0) = 0';
    end;
  end;

  if Trim(valorConsulta) <> '' then
    for I := 0 to dataSet.FieldCount - 1 do
      if Dataset.Fields[I].FieldKind = fkData then
        if ContainsText(dataset.Fields[I].DisplayName, Campo) then
        begin
          valorConsulta := ajustar_consulta_incasesensitive(DataSet.Fields[I], tabela, valorConsulta);
          Break;
        end;

  vCampoTemp:= '';
  if UpperCase(trim(Campo)) = 'PLACA' then
    vCampoTemp := 'PEDVENDA.PLACA'
  else if UpperCase(trim(Campo)) = 'MODELO VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.DESCMODELO, NULL)'
  else if UpperCase(trim(Campo)) = 'ESPECIE VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ESPECIE, NULL)'
  else if UpperCase(trim(Campo)) = 'MARCA VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.MARCA_V, NULL)'
  else if UpperCase(trim(Campo)) = 'COR VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.COR, NULL)'
  else if UpperCase(trim(Campo)) = 'COMBUSTIVEL VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.COMBUSTIVEL, NULL)'
  else if UpperCase(trim(Campo)) = 'ANO FABRICACAO VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ANOFAB, NULL)'
  else if UpperCase(trim(Campo)) = 'ANO MODELO VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ANOMOD, NULL)'
  else if UpperCase(trim(Campo)) = 'CILINDROS VEICULO' then
	  vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.CILINDROS, NULL)'
  else if UpperCase(trim(Campo)) = 'CILINDRADA VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.CILINDRADA, NULL)'
  else if UpperCase(trim(Campo)) = 'HP VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.HP, NULL)'
  else if UpperCase(trim(Campo)) = 'LOTACAO VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.LOTACAO, NULL)'
  else if UpperCase(trim(Campo)) = 'MOTOR VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.MOTOR, NULL)'
  else if UpperCase(trim(Campo)) = 'RENAVAM VEICULO' then
  	vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.RENAVAM, NULL)'
  else if UpperCase(trim(Campo)) = 'NOME EQUIPAMENTO' then
	  vCampoTemp := 'EQUIPAMENTO.NOM_EQUIP'
  else if UpperCase(trim(Campo)) = 'MODELO EQUIPAMENTO' then
		vCampoTemp := 'EQUIPAMENTO.MODELO'
  else if UpperCase(trim(Campo)) = 'MARCA EQUIPAMENTO' then
		vCampoTemp := 'EQUIPAMENTO.MARCA'
  else if UpperCase(trim(Campo)) = 'COR EQUIPAMENTO' then
		vCampoTemp := 'EQUIPAMENTO.COR'
  else if UpperCase(trim(Campo)) = 'NUM SERIE EQUIPAMENTO' then
	  vCampoTemp := 'EQUIPAMENTO.N_SERIE'
  else if UpperCase(trim(Campo)) = 'NOME CLIENTE (NOME FANTASIA)' then
    vCampoTemp := 'CLIENTES.NOME_CLIENTE'
  else if UpperCase(trim(Campo)) = 'NOME CLIENTE (RAZAO SOCIAL)' then
    vCampoTemp := 'CLIENTES.RAZAO'
  else if UpperCase(trim(Campo)) = 'CEP CLIENTE' then
  	vCampoTemp := 'CLIENTES.CEP'
