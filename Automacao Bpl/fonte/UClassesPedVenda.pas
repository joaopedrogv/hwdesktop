          abrePedVendaProd(FOwner.dataSet.FieldByName('nped').AsInteger);
        end;
//      if not FOwner.CancelarVariosItens then
        if not dataSet.IsEmpty then
	       dataSet.RecNo := vRecNoItem;
        FOwner.fat_ped.calcular_valores_nf_atualizar;
    end
    else
      FOwner.fat_ped.calcular_valores_nf_atualizar;
  end;
end;

function TPedVendaProd.checaValoresItens: boolean;
begin
  result := false;
  try
    if not (dataSet.State in [dsInsert, dsedit]) then
      exit;

    if trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '' then
    begin
      if (dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat <= 0) then
      	raiseExceptioncreate(Pchar('Campo Quantidade deve ser preenchido.' + chr(13) + 'Favor Verificar'), 'dbedit47');

      if (dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat <= 0) then
      if vSing.vTipoVenda = 'REQ' then
      begin
        if (vSing.vVendaRapida) then
          raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
            'Favor Verificar'), 'EditMoeda5')
        else raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
            'Favor Verificar'), 'dbedit14');
      end
      else raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
          'Favor Verificar'), 'dbedit51');
    end
    else
    begin
    	if (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat <= 0) then
    		raiseExceptioncreate(Pchar('Campo Quantidade deve ser preenchido.' + chr(13) + 'Favor Verificar'), 'dbedit47');

    	if (dataSet.FieldByName('VLUN_PED_ITEM').AsFloat <= 0) then
        if vSing.vTipoVenda = 'REQ' then
        begin
          if (vSing.vVendaRapida) then
            raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
              'Favor Verificar'), 'EditMoeda5')
          else raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
              'Favor Verificar'), 'dbedit14');
        end
        else raiseExceptioncreate(Pchar('Campo Valor Unitário deve ser maior que zero.' + chr(13) +
            'Favor Verificar'), 'dbedit51');
    end;

  	if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) = '')
    	or (UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) then
    begin
  		dataSet.FieldByName('OPERACAO_CONV').Value := Null;
      dataSet.FieldByName('FATOR_CONV').Value := Null;

      dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
      	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);

      dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
      	dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

      dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
      	dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
    end
    else
    begin
      if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
      begin
      	dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
        	dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat *
          	dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat *
            dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat /
          dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
      end
      else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
      begin
      	dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
        	dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat /
          	dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat /
            dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat *
          dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
      end;
    end;

    if (vProduto.dataSet.FieldByName('ecf').AsString = 'E') or
      (vProduto.dataSet.FieldByName('ecf').AsString = 'O') then
      if dataSet.FieldByName('QUANT_PED_ITEM').AsFloat <> 1 then
        raiseExceptioncreate(Pchar('Item com Controle de N° de Série.' + chr(13) + 'Apenas 1 item por linha da venda é permitido'), 'dbedit47');

    dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
      dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
    dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsCurrency := vDadosIni.StrToFloatFormat(
      dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
    if dataSet.FieldByName('VLO_UNITARIO').AsCurrency <= 0 then
      dataSet.FieldByName('VLO_UNITARIO').AsCurrency := dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency;
    dataSet.FieldByName('VLO_UNITARIO').AsCurrency := StrToCurr(vDadosIni.tirapontos(format('%8.' +
      vSing.vCasasDecimais + 'n', [dataSet.FieldByName('VLO_UNITARIO').AsCurrency]), StrToInt(vSing.vCasasDecimais)));
    //    if (dataSet.FieldByName('VLO_UNITARIO').AsCurrency < dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency) then
    //      if vSing.vVendaRapida then
    //        raiseExceptioncreate(Pchar('Campo Val. Orig. Unitário deve ser maior ou igual ao Valor Unitário.' + chr(13) + 'Favor Verificar'), 'dbedit93')
    //      else raiseExceptioncreate(Pchar('Campo Val. Orig. Unitário deve ser maior ou igual ao Valor Unitário.' + chr(13) + 'Favor Verificar'), 'dbedit92');
    if dataSet.FieldByName('VLUN_PED_NF').AsCurrency <= 0 then
      dataSet.FieldByName('VLUN_PED_NF').AsCurrency := dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency;

    if dataSet.FieldByName('VLUN_PED_NF_CONV').AsCurrency <= 0 then
      dataSet.FieldByName('VLUN_PED_NF_CONV').AsCurrency := dataSet.FieldByName('VLUN_PED_NF_CONV').AsCurrency;

    dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
      (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
      dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);

    //    dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency :=
    //      (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat
    //      * StrToCurr(vDadosIni.tirapontos(format('%8.' + vSing.vCasasDecimais + 'n',
    //      [dataSet.FieldByName('VLUN_PED_ITEM').AsFloat]), StrToInt(vSing.vCasasDecimais))));
        {if not verificaGradeProduto then
          if vSing.vTipoVenda = 'REQ' then
            raiseexceptioncreate('Grade não informada', 'DBedit14')
          else if vSing.vTipoVenda = 'OS' then
            raiseexceptioncreate('Grade não informada', 'DBedit51');}
    if (not vSing.vVendaRapida) then
      Result := true
    else if (vSing.vVendaRapida) and (verificaGradeProduto) then
      Result := true
    else if vSing.vVendaRapida then
      dataSet.Cancel;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

