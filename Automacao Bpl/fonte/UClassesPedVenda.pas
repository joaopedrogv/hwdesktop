function TPedVendaProd.retornaQtdExistente(numFabProd: string): double;
begin
  Result := 0;
  dtSet.First;
  while not dtSet.Eof do
  begin
    if (trim(numFabProd) = trim(dataSet.FieldByName('num_fab_prod').AsString)) and
      (trim(dtset.FieldByName('STATUS').AsString) <> 'CANCELADO') then
      Result := Result + dtSet.FieldByName('quant_ped_item').AsFloat;
    dtSet.Next;
  end;
end;

procedure TPedVendaProd.SelecionaGradeProd(grupo: integer; codProd: string; var codBarra: string);
begin
	if FrmSelGradeProd = nil then
  begin
    Application.CreateForm(TFrmSelGradeProd, FrmSelGradeProd);

    if DtmPedVenda = nil then
      DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

    vDadosIni.AlterarDataSourceComponentes(FrmSelGradeProd, FOwner.DtmPed);
  end;

  try
    buscas.Close;
    buscas.SQL.Text := 'select g.cod_grade, g.descricao, g.descricao1, ' +
      ' (coalesce(cgp.qtde, 0) - coalesce((select sum(coalesce(pp.quant_ped_item, 0)) from  pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade = cgp.cod_grade ' +
      ' and pp.cod_empresa = cgp.cod_empresa ' +
      ' and coalesce(v.status_ped, '''') = '''' ' +
      ' and coalesce(pp.status, '''') = '''' ' +
      ' and v.NPED <> ' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
      ' and v.tipo <> ''ORC''),0)) as qtd_item_disponivel, ' +
      ' coalesce(cgp.qtde, 0) as qtde, ' +
      ' (coalesce((select sum(pp.quant_ped_item) from pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped = pp.nped and v.cod_empresa = pp.cod_empresa and pp.tipo = v.tipo ' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade = cgp.cod_grade ' +
      ' and pp.cod_empresa = cgp.cod_empresa ' +
      ' and coalesce(v.status_ped, '''') = '''' ' +
      ' and coalesce(pp.status, '''') = '''' ' +
      ' and v.NPED <> ' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
      ' and v.tipo<>''ORC''),0)) as qtd_item_pedAberto, ';

    if vDadosIni.vEmp.vUsarProducao = 'S' then
      buscas.SQL.Text := buscas.SQL.Text +
        ' coalesce((select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        '  cgp.grupo_prod, ' +
        '  cgp.cod_prod, ' +
        '  cgp.cod_empresa, ' +
        '  cgp.cod_grade)), 0) qtde_produzir, ';

    buscas.SQL.Text := buscas.SQL.Text +
      ' cb.cod_barra "Codigo" ' +
      ' from grade g ' +
      ' inner join cod_grade_prod cgp on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
      ' left join cod_barra cb on cb.grupo_prod = cgp.grupo_prod and cb.cod_prod = cgp.cod_prod and cb.cod_empresa = cgp.cod_empresa and cb.cod_grade = cgp.cod_grade' +
      ' where cgp.grupo_prod = ' + inttostr(grupo) +
      ' and cgp.cod_prod = ' + QuotedStr(codProd) +
      ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa +
      ' order by g.cod_grade';
    buscas.open;
    buscas.FieldByName('cod_grade').DisplayLabel := 'Grade';
    buscas.FieldByName('descricao').DisplayLabel := 'Descrição 1';
    buscas.FieldByName('descricao1').DisplayLabel := 'Descrição 2';
    buscas.FieldByName('qtde').DisplayLabel := 'Qtd. total da grade';
    buscas.FieldByName('qtd_item_pedAberto').DisplayLabel := 'Qtd. em Vendas em Aberto';
    buscas.FieldByName('qtd_item_disponivel').DisplayLabel := 'Qtd. Disponível';
    if vDadosIni.vEmp.vUsarProducao = 'S' then
      buscas.FieldByName('qtde_produzir').DisplayLabel := 'Qtd. Produzir';

    TFloatField(buscas.FieldByName('qtde')).DisplayFormat                := '#0.000';
    TFloatField(buscas.FieldByName('qtd_item_pedAberto')).DisplayFormat  := '#0.000';
    TFloatField(buscas.FieldByName('qtd_item_disponivel')).DisplayFormat := '#0.000';
    if vDadosIni.vEmp.vUsarProducao = 'S' then
      TFloatField(buscas.FieldByName('qtde_produzir')).DisplayFormat     := '#0.000';

    FrmSelGradeProd.DataSource1.dataSet := buscas;
    FrmSelGradeProd.Caption:= 'Selecionar Grade do produto [Grupo: '+inttostr(grupo)+' Código: '+codProd+']';
    if FrmSelGradeProd.showModal = mrOK then
    begin
      nGradeSelecionada := buscas.FieldByName('cod_grade').AsInteger;
      if Trim(buscas.FieldByName('codigo').AsString) <> '' then
        codBarra := Trim(buscas.FieldByName('codigo').AsString);
    end;
  finally
    buscas.close;
    FrmSelGradeProd.DataSource1.dataSet := nil;
    FrmSelGradeProd.Free;
    FrmSelGradeProd := nil;
  end;
end;

