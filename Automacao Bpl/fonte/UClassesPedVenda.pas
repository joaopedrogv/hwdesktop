function TPedVenda.BaixaEstoqueEquipamentoNSerie: Boolean;
var
  vTemp: string;
begin
  try
    vItProd.dataSet.DisableControls;
    Result := True;
    vDadosIni.abreStatusProcessamento('', 'Baixando Estoque de Equipamentos');
    vItProd.dataSet.first;
    while not vItProd.dataSet.Eof do
    begin
      if (vItProd.dataset.Fieldbyname('NPED').AsInteger = dataset.fieldbyname('NPED').AsInteger) and
        (vItProd.dataset.Fieldbyname('STATUS').AsString <> 'CANCELADO') and
        (vItProd.dataSet.FieldByName('cod_nserie').AsInteger > 0) then
      begin
        try
          vItProd.vEstoqueECF.selecionaEstoqueECF(vItProd.dataSet.FieldByName('cod_nserie').AsInteger);

          if vItProd.vEstoqueECF.dataSet.IsEmpty then
            raise exception.create('Equipamento não encontrado no Estoque de Equipamentos');

          vTemp := '';
          if Trim(vItProd.vEstoqueECF.dataSet.FieldByName('status').AsString) <> 'Estoque' then
          begin
            vTemp := 'Equipamento com status diferente de "Estoque"';
            if (Trim(vItProd.vEstoqueECF.dataSet.FieldByName('tipo_ped').AsString) <> '') and
              (vItProd.vEstoqueECF.dataSet.FieldByName('nped').AsInteger > 0) then
              vTemp := vTemp + ' na ' + Trim(vItProd.vEstoqueECF.dataSet.FieldByName('tipo_ped').AsString) +
                ' número ' + vItProd.vEstoqueECF.dataSet.FieldByName('nped').AsString;
          end;
          if vTemp <> '' then
          begin
            vItProd.dataSet.Edit;
            vItProd.dataSet.FieldByName('cod_nserie').Value := Null;
            vItProd.dataSet.FieldByName('DESCR_PROD_PED').asstring :=
              StringReplace(Trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').asstring),
              Trim(vItProd.vEstoqueECF.dataSet.FieldByName('n_serie_fab').AsString),
              '', [rfReplaceAll]);
            vItProd.dataSet.Post;
            raise exception.create(vTemp);
          end;

          buscas.Close;
          buscas.SQL.Text := 'update ecf set status = ''Vendido'', nped = ' + dataSet.FieldByName('nped').AsString +
            ', tipo_ped = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
            ', nitem_ped = ' + vItProd.dataSet.FieldByName('nitem').AsString +
            ' where cod_nserie = ' + vItProd.dataSet.FieldByName('cod_nserie').AsString +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and status = ''Estoque''';
          buscas.ExecSQL;

          vTemp := retornaValor('SELECT COD_MARCA AS VALOR FROM MARCA_PROD WHERE DESCRICAO_MARCA = ' + QuotedStr(vItProd.vEstoqueECF.dataSet.FieldByName('MARCA_ECF').AsString));

          buscas.Close;
          buscas.SQL.Text := 'INSERT INTO EQUIPAMENTO (COD_EQUIP, COD_EMPRESA, DAT_CAD_EQUI, TIP_EQUIP,' +
            ' COD_PROP, NOM_EQUIP, N_SERIE, MARCA, MODELO, COD_MARCA, TIPEQUIP)' +
            ' VALUES (:COD_EQUIP, :COD_EMPRESA, ' + vDadosIni.FusoSqlDate + ', ''E'', :COD_PROP, :NOM_EQUIP, :N_SERIE,' +
            ' :MARCA, :MODELO, :COD_MARCA, ''E'')';
          buscas.ParamByName('COD_EQUIP').AsInteger := Gencodigo('EQUIPAMENTO', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
          buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
          buscas.ParamByName('COD_PROP').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
          if Trim(vItProd.vEstoqueECF.dataSet.FieldByName('TIPO_ECF').AsString) <> 'E' then
            buscas.ParamByName('NOM_EQUIP').AsString := copy('IMPRESSORA FISCAL ' + vItProd.vEstoqueECF.dataSet.FieldByName('MODELO_ECF').AsString, 1, 32)
          else
            buscas.ParamByName('NOM_EQUIP').AsString := copy(vItProd.vEstoqueECF.dataSet.FieldByName('TIPO_ECF').AsString + ' ' +
              vItProd.vEstoqueECF.dataSet.FieldByName('MODELO_ECF').AsString, 1, 32);
          buscas.ParamByName('N_SERIE').AsString := vItProd.vEstoqueECF.dataSet.FieldByName('N_SERIE_FAB').AsString;
          buscas.ParamByName('MARCA').AsString := vItProd.vEstoqueECF.dataSet.FieldByName('MARCA_ECF').AsString;
          try
            buscas.ParamByName('cod_marca').AsInteger := StrToInt(vTemp);
          except
            buscas.ParamByName('cod_marca').AsInteger := 0;
          end;
          buscas.ParamByName('MODELO').AsString := copy(vItProd.vEstoqueECF.dataSet.FieldByName('MODELO_ECF').AsString, 1, 32);
          buscas.ExecSQL;

        except on E: Exception do
          begin
            Result := False;
            if Application.MessageBox(pchar('Item N° ' + vitProd.dataset.Fieldbyname('nitem').AsString +
              '. Erro ao Baixar Estoque de Equipamento do produto: ' + trim(vitProd.dataset.Fieldbyname('NUM_FAB_PROD').AsString) +
              '. Deseja ver o erro?'), 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDYES then
              Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
            registraErro(e.Message);
          end;
        end;

      end;
      vItProd.dataSet.Next;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
    vItProd.dataSet.EnableControls;
  end;
end;

function TPedVenda.buscaAparelho(codigo: integer; memo: TMemo): boolean;
var
  temp,vDescrAPTemp: string;
begin
  if codigo = 0 then
  begin
    Result := False;
    Application.MessageBox('Objeto não informado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  vApar.abreAparelho(codigo);
  if vApar.IsEmpty then
  begin
    Result := false;
    Application.MessageBox('Objeto não encontrado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  if vApar.dataSet.FieldByName('TIP_EQUIP').AsString = 'I' then
  begin
    Result := false;
    Application.MessageBox('Objeto interno, selecione somente objetos externos', 'Atenção',
      MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  if dataSet.State in [dsinsert, dsEdit] then
  begin
    temp := retornaValor('select first 1 (''O.S.: ''||nped||'' - Data: ''||' +
      'substring(cast(data_ped as varchar(50)) from 9 for 2)||''/''||' +
      'substring(cast(data_ped as varchar(50)) from 6 for 2)||''/''||' +
      'substring(cast(data_ped as varchar(50)) from 1 for 4)) as valor from pedvenda' +
      ' where tipo = ''OS'' and cod_equip = ' + IntToStr(codigo) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and nped <> ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ' and (status_ped is null or status_ped = '''') order by data_ped');
    if temp <> '' then
    begin
      Result := false;
      if Application.MessageBox(pchar('Existe O.S. aberta para este Objeto. ' + temp + #13 +
        'Deseja continuar?'), 'Atenção',
        MB_ICONQUESTION + MB_YESNO) = ID_NO then
        exit;
    end;

    dataSet.FieldByName('cod_equip').AsInteger := codigo;
    vDescrAPTemp := trim(copy(trim(vApar.dataSet.fieldbyname('MARCA').asstring) +
        '-' + trim(vApar.dataSet.fieldbyname('NOM_EQUIP').asstring) +
        ' SERIE: ' + trim(vApar.dataSet.fieldbyname('N_SERIE').AsString) +
        ' MODELO: ' + trim(vApar.dataSet.fieldbyname('MODELO').AsString),1,128));

    if trim(vApar.dataSet.fieldbyname('PORTARIA_MODELO').AsString) <> '' then
	     vDescrAPTemp := vDescrAPTemp + ' PORTARIA: ' + trim(vApar.dataSet.fieldbyname('PORTARIA_MODELO').AsString);

    if trim(dataSet.FieldByName('APARELHO_PED').AsString) = '' then
      dataSet.FieldByName('APARELHO_PED').AsString := vDescrAPTemp
    else
      if dataSet.FieldByName('cod_equip').AsInteger<> FCodAparelho then
         if trim(dataSet.FieldByName('APARELHO_PED').AsString) <>vDescrAPTemp then
           if Application.MessageBox(pchar('Descrição do aparelho: '+vDescrAPTemp+chr(13)+chr(13)+'difere da descrição informada: '+
             trim(dataSet.FieldByName('APARELHO_PED').AsString)+chr(13)+'Deseja alterá-la?'),
             'Confirmação', MB_ICONQUESTION + MB_YESNO) = ID_YES then
                dataSet.FieldByName('APARELHO_PED').AsString := vDescrAPTemp;
    if dataSet.FieldByName('tipo_os').AsString <> vApar.dataSet.fieldbyname('TIPOOSVINC').asstring then
      if vApar.dataSet.fieldbyname('COMCONTRATO').asstring = 'S' then
        if Application.MessageBox(pchar('Obejeto está vinculado ao tipo de OS ' + vApar.dataSet.fieldbyname('TIPOOSVINC').asstring + ' enquanto o tipo da OS informado é ' + dataSet.fieldbyname('TIPO_OS').asstring + '.' + chr(13) +
          'Alterar para ' + vApar.dataSet.fieldbyname('TIPOOSVINC').asstring + '?'), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO) = ID_YES then
          dataSet.FieldByName('tipo_os').AsString := vApar.dataSet.fieldbyname('TIPOOSVINC').asstring;

    if (dataSet.FieldByName('COD_CLIENTE').AsInteger = 0) then
    begin
      dataSet.FieldByName('COD_CLIENTE').AsInteger :=
        vApar.dataSet.fieldbyname('COD_PROP').AsInteger;
      vCliente.LocCliente(dataSet.FieldByName('COD_CLIENTE').AsInteger);
    end;
  end;
  memo.Clear;
  memo.lines.Add('Série: ' + TRIM(vApar.dataSet.fieldbyname('N_SERIE').asstring) + ' ' +
    TRIM(vApar.dataSet.fieldbyname('MARCA').asstring) + ' ' +
    TRIM(vApar.dataSet.fieldbyname('MODELO').asstring));
  memo.lines.add('COR: ' + vApar.dataSet.fieldbyname('COR').asstring);
  Result := true;
end;

function TPedVenda.buscaAparelho(codigo: integer): boolean;
begin
  Result := false;
  if codigo = 0 then
  begin
    Application.MessageBox('Objeto não informado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;

  if not vApar.Active then
  begin
    Application.MessageBox('Objeto não encontrado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  if vApar.IsEmpty then
  begin
    Application.MessageBox('Objeto não encontrado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  if vApar.dataSet.FieldByName('TIP_EQUIP').AsString = 'I' then
  begin
    Application.MessageBox('Objeto interno, selecione somente objetos externos', 'Atenção',
      MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;

  dataSet.FieldByName('APARELHO_PED').AsString := copy(trim(vApar.dataSet.fieldbyname('MARCA').asstring) +
      ' ' + trim(vApar.dataSet.fieldbyname('NOM_EQUIP').asstring) + ' SERIE: ' +
      trim(vApar.dataSet.fieldbyname('N_SERIE').AsString) + ' MODELO: ' + trim(vApar.dataSet.fieldbyname('MODELO').AsString),1,128) +
      vDadosIni.IfThen(trim(vApar.dataSet.fieldbyname('PORTARIA_MODELO').AsString) <> '',
	     ' PORTARIA: ' + trim(vApar.dataSet.fieldbyname('PORTARIA_MODELO').AsString), '');

  Result := true;
end;

function TPedVenda.buscaVeiculo(valor: string; placaChassiCodigo: integer;
  memo: TMemo; pPlaca: string = ''; pChassi: string = ''): boolean;
var
  temp: string;
begin
  if placaChassiCodigo = 0 then
  begin
  	if (trim(vDadosIni.retornaPlacaNovaAntiga(valor)) <> trim(valor)) then
    begin
    	if vDadosIni.vVeic.vDesabilitarChassi then
        temp :=
          ' where ((trim(placa) = ' + QuotedStr(trim(pPlaca)) + ')' +
          ' 			  or (trim(placa) = ' + QuotedStr(trim(vDadosIni.retornaPlacaNovaAntiga(pPlaca))) + ')) ' +
          ' and codigo = ' + (valor)
      else
        temp :=
          ' where ((trim(placa) = ' + QuotedStr(trim(pPlaca)) + ')' +
          ' 			  or (trim(placa) = ' + QuotedStr(trim(vDadosIni.retornaPlacaNovaAntiga(pPlaca))) + ')) ' +
          ' and trim(chassi) = ' + QuotedStr(trim(pChassi)) +
          ' and codigo = ' + (valor);
    end
    else
    begin
      if vDadosIni.vVeic.vDesabilitarChassi then
      	temp :=
          ' where trim(placa) = ' + QuotedStr(trim(pPlaca)) +
          ' and codigo = ' + (valor)
      else
        temp :=
          ' where trim(placa) = ' + QuotedStr(trim(pPlaca)) +
          ' and trim(chassi) = ' + QuotedStr(trim(pChassi)) +
          ' and codigo = ' + (valor);
    end;
  end
  else if placaChassiCodigo = 1 then
  begin
  	if (trim(vDadosIni.retornaPlacaNovaAntiga(valor)) <> trim(valor)) then
    	temp :=
      	' where ((trim(placa) = ' + QuotedStr(trim(valor)) + ')' +
        ' 			  or (trim(placa) = ' + QuotedStr(trim(vDadosIni.retornaPlacaNovaAntiga(valor))) + ')) '
    else
      temp := ' where trim(placa) = ' + QuotedStr(trim(valor));
  end
  else if placaChassiCodigo = 2 then
    temp := ' where trim(chassi) = ' + QuotedStr(trim(valor))
  else if placaChassiCodigo = 3 then
    temp := ' where codigo = ' + valor
  else
  begin
    Result := false;
    Application.MessageBox('Veículo não informado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  vVeic.montaSelect('select * from veiculos' + temp +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo <> 99 ' +
    ' order by ativo desc, codigo desc ');
  if (vVeic.IsEmpty) then
  begin
    Result := false;
    if (valor <> '') then
      Application.MessageBox('Veículo não encontrado', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    exit;
  end;
  if dataSet.State in [dsinsert, dsEdit] then
  begin
    temp := retornaValor('select first 1 (''O.S.: ''||nped||'' - Data: ''||' +
      ' substring(cast(data_ped as varchar(50)) from 9 for 2)||''/''||' +
      ' substring(cast(data_ped as varchar(50)) from 6 for 2)||''/''||' +
      ' substring(cast(data_ped as varchar(50)) from 1 for 4)) as valor from pedvenda' +
      ' where ((trim(placa) = ' + QuotedStr(trim(vVeic.dataSet.FieldByName('placa').AsString)) + ')' +
      ' 			  or (trim(placa) = ' + QuotedStr(trim(vDadosIni.retornaPlacaNovaAntiga(vVeic.dataSet.FieldByName('placa').AsString))) + ')) ' +
      ' and tipo = ''OS'' ' +
      '	and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and nped <> ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ' and (status_ped is null or status_ped = '''') ');
    if trim(temp) <> '' then
    begin
      Result := false;
      if Application.MessageBox(pchar('Existe O.S. aberta para este Veículo. ' + temp + #13 +
        'Deseja continuar?'), 'Atenção',
        MB_ICONQUESTION + MB_YESNO) = ID_NO then
        exit;
    end;

    dataSet.FieldByName('placa').AsString := trim(vVeic.dataSet.FieldByName('placa').AsString);
    dataSet.FieldByName('chassi').AsString := trim(vVeic.dataSet.FieldByName('chassi').AsString);
    dataSet.FieldByName('cod_veiculo').AsString := vVeic.dataSet.FieldByName('codigo').AsString;
    if (dataSet.FieldByName('COD_CLIENTE').AsInteger = 0) then
    begin
      dataSet.FieldByName('COD_CLIENTE').AsInteger :=
        vVeic.dataSet.fieldbyname('cod_cliente').AsInteger;
      vCliente.LocCliente(dataSet.FieldByName('COD_CLIENTE').AsInteger);
    end;
  end;
  memo.Clear;
  memo.lines.Add(TRIM(vVeic.dataSet.FieldByName('ESPECIE').AsString) + ' ' +
    TRIM(vVeic.dataSet.FieldByName('MARCA_V').AsString) + ' ' +
    TRIM(vVeic.dataSet.FieldByName('DESCMODELO').AsString));
  memo.lines.add(TRIM(vVeic.dataSet.FieldByName('ANOFAB').asstring) + '/' +
    TRIM(vVeic.dataSet.FieldByName('ANOMOD').asstring));
  if not vVeic.fempty('OBS') then
  memo.lines.add(TRIM(vVeic.dataSet.FieldByName('OBS').AsString));
  Result := true;
end;

function TPedVenda.CadastrarFormEnt: boolean;
var
  vflagent: integer;
begin
  Result := false;
  if FrmobsCxl.EditMoeda1.Valor = 0 then
  begin
    buscas.close;
    buscas.sql.text := 'delete from plano_pag where nrequisicao = ' + dataSet.FieldByName('NPED').AsString +
      ' and tpdocs = ''' + getTipoVenda + ''' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
    buscas.ExecSQL;
    Result := True;
  end
  else
  if FrmobsCxl.EditMoeda1.Valor <> 0 then
  begin
    try
      vflagent := 0;
      buscas.close;
      buscas.sql.text := 'select * from plano_pag where nrequisicao = ' + dataSet.FieldByName('NPED').AsString +
        ' and tpdocs = ''' + getTipoVenda + ''' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
      buscas.Open;
      if not buscas.isempty then
      begin
        if Application.MessageBox(pchar('Já Existe uma entrada para este documento no valor de: ' +
          format('%n', [buscas.FieldByName('valordoc').AsCurrency]) + ' deseja mantê-la?'), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO) = IDYES then
          vflagent := 1
        else
        begin
          buscas.close;
          buscas.sql.text := 'delete from plano_pag where nrequisicao = ' + dataSet.FieldByName('NPED').AsString +
            'and tpdocs = ''' + getTipoVenda + ''' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
          buscas.Prepare;
          buscas.ExecSQL;
        end;
      end;
      if vflagent = 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := 'INSERT INTO PLANO_PAG (SEQPLANO, NREQUISICAO, TIPDOC, ' +
          ' COD_CONTROLE, COD_CLIENTE, COD_EMPRESA, DATA_MOV, VALORDOC,TPDOCS,DATA_VENC) ' +
          ' VALUES (:SEQPLANO,:NREQUISICAO,:TIPDOC,:COD_CONTROLE,:COD_CLIENTE, ' +
          ' :COD_EMPRESA,:DATA_MOV,:VALORDOC,:TPDOCS,:DATA_VENC)';
        buscas.ParamByName('SEQPLANO').asinteger := Gencodigo('PLANO_PAG', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
        buscas.ParamByName('NREQUISICAO').AsInteger := dataSet.FieldByName('NPED').AsInteger;
        buscas.ParamByName('TIPDOC').Value := vControleEnt.FieldByName('DOCS').AsString;
        buscas.ParamByName('COD_CONTROLE').AsInteger := vControleEnt.FieldByName('CODIGO_CTRL').AsInteger;
        buscas.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
        buscas.ParamByName('DATA_MOV').AsDate := dataSet.FieldByName('DATA_FECH').AsDateTime;
        buscas.ParamByName('VALORDOC').Value := FrmobsCxl.vlent;
        buscas.ParamByName('TPDOCS').AsString := getTipoVenda;
        if vControleEnt.FieldByName('DOCS').AsString <> 'N' then
        try
          buscas.ParamByName('DATA_VENC').Value := strtodate(FrmobsCxl.MaskEdit1.text);
        except
          buscas.ParamByName('DATA_VENC').AsString := ''
        end;
        buscas.Prepare;
        buscas.ExecSQL;
        result := true;
      end;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  end;
end;

function TPedVenda.cadCliente(modal: integer; testaDtMod: boolean = false): boolean;
var
	AProcedure: Tcl_abreCliente;
  AProcedure2: Tcl_cadCliente;
  vCodClienteTmp: Integer;
  vNomeClienteTmp: string;
  vDataModTm: TDateTime;
begin
  try
  	if trim(vDadosIni.vPesquisa) = '' then
    	Exit;

  	try
    	if trim(vDadosIni.vPesquisa) = '' then
      	vCodClienteTmp := 0
      else
  			vCodClienteTmp := StrToInt(vDadosIni.vPesquisa);
    except
      vCodClienteTmp   := 0;
    end;

    if vCliente.FPossivelCli then
    begin
      vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro do cliente...');
      if modal = 2 then
      begin
        if ExecutaComandosSql('SELECT * FROM CLIENTES ' +
          'WHERE COD_CLIENTE = ' + IntToStr(vCodClienteTmp) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=2') then
        begin
          try
            if vDadosIni.vCliente.AHandle = 0 then
              CarregaPacote('pkClientes', vDadosIni.vCliente.AHandle);

            if vDadosIni.vCliente.AHandle = 0 then
            begin
              Application.MessageBox('Pacote Cliente não carregado', 'Anteção', 0 + 64);
              Exit;
            end;
            @AProcedure := GetProcAddress(vDadosIni.vCliente.AHandle, 'cl_abreCliente');

            if Assigned(AProcedure) then
              AProcedure(
                vCodClienteTmp);
          finally
          end;

//          Cl.abreClientes(StrToInt(vDadosIni.vPesquisa));
          vDadosIni.fechaStatusProcessamento;
        end;
      end;
      if (modal = 2) and (vCodClienteTmp > 0) then
      begin
      	if vCodClienteTmp > 0 then
    			vDadosIni.vPesquisa := 'EDITAR_CLIENTE|' + IntToStr(vCodClienteTmp) + '|';
      end;

      try
        if vDadosIni.vCliente.AHandle = 0 then
          CarregaPacote('pkClientes', vDadosIni.vCliente.AHandle);

        if vDadosIni.vCliente.AHandle = 0 then
        begin
          Application.MessageBox('Pacote Cliente não carregado', 'Anteção', 0 + 64);
          Exit;
        end;
        @AProcedure2 := GetProcAddress(vDadosIni.vCliente.AHandle, 'cl_cadCliente');

        if Assigned(AProcedure2) then
          AProcedure2(
            modal);
      finally
      end;

//      cl.cadcliente(modal);
      exit;
    end;

    vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro do cliente...');
    if modal = 2 then
    begin
    	try
        if vDadosIni.vCliente.AHandle = 0 then
          CarregaPacote('pkClientes', vDadosIni.vCliente.AHandle);

        if vDadosIni.vCliente.AHandle = 0 then
        begin
          Application.MessageBox('Pacote Cliente não carregado', 'Anteção', 0 + 64);
          Exit;
        end;
        @AProcedure := GetProcAddress(vDadosIni.vCliente.AHandle, 'cl_abreCliente');

        if Assigned(AProcedure) then
          AProcedure(
            vCodClienteTmp);
      finally
      end;

      buscas.Close;
      buscas.SQL.Text := ' SELECT COD_CLIENTE, COD_EMPRESA, ' +
      	' NOME_CLIENTE, DATA_MOD_CAD FROM CLIENTES ' +
        ' WHERE COD_CLIENTE = :COD_CLIENTE ' +
        ' AND COD_EMPRESA = :COD_EMPRESA ';
      buscas.ParamByName('COD_CLIENTE').AsInteger := vCodClienteTmp;
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;

      vNomeClienteTmp := trim(buscas.FieldByName('NOME_CLIENTE').AsString);
      vDataModTm      := buscas.FieldByName('DATA_MOD_CAD').AsDateTime;

//    	Cl.abreClientes(StrToInt(vDadosIni.vPesquisa));
      if not testaDtMod then
        if (pos('CONSUMIDOR', UpperCase(vNomeClienteTmp)) > 0) or
          (vDataModTm = vDadosIni.getDataBanco(buscas)) then
        begin
          vDadosIni.fechaStatusProcessamento;
          Exit;
        end;
    end;
    if (modal = 2) and (vCodClienteTmp > 0) then
    begin
      if vCodClienteTmp > 0 then
        vDadosIni.vPesquisa := 'EDITAR_CLIENTE|' + IntToStr(vCodClienteTmp) + '|';
    end;

    try
      if vDadosIni.vCliente.AHandle = 0 then
        CarregaPacote('pkClientes', vDadosIni.vCliente.AHandle);

      if vDadosIni.vCliente.AHandle = 0 then
      begin
        Application.MessageBox('Pacote Cliente não carregado', 'Anteção', 0 + 64);
        Exit;
      end;
      @AProcedure2 := GetProcAddress(vDadosIni.vCliente.AHandle, 'cl_cadCliente');

      if Assigned(AProcedure2) then
        AProcedure2(
          modal);
    finally
    end;

//    cl.cadcliente(modal);
  finally
    vDadosIni.fechaStatusProcessamento;

//    if Assigned(cl) then
//    	FreeAndNil(cl);

    vCliente.FPossivelCli:=false;
  end;
end;

class function TPedVenda.cadPedVenda(modal: boolean): boolean; //static;
var
	vFormAbert: boolean;

  procedure abrirFormPedVenda(var pFrmCadPedVenda: TFrmCadPedvenda);
begin
  if pFrmCadPedVenda = nil then
  begin
  	vFormAbert := false;
    vDadosIni.vTipoForm := 0;
    if modal then
    begin
      vDadosIni.vModalOuChild := 'M';
      vDadosIni.vTipoForm := 1;
    end
    else
      vDadosIni.vModalOuChild := 'C';

      Application.CreateForm(TFrmCadPedVenda, pFrmCadPedVenda);
      pFrmCadPedVenda.Name := pFrmCadPedVenda.Name + trim(vDadosIni.vtpVenda);
      pFrmCadPedVenda.DBGrid1.DataSource;


    //    vDadosIni.vTipoForm := 1;
      //    pFrmCadPedVenda.FormStyle := fsNormal;
      //    pFrmCadPedVenda.WindowState := wsNormal;
      //    pFrmCadPedVenda.Height := 600;
      //    pFrmCadPedVenda.Width := 800;
      //    pFrmCadPedVenda.Position := poScreenCenter;
      //    pFrmCadPedVenda.Visible := false;
      //    Application.CreateForm(TFrmCadPedVenda(FrmCadPed)Venda, pFrmCadPedVenda);
      //    pFrmCadPedVenda.Showmodal;
    end
    else
        pFrmCadPedVenda.Tag := 0;

    if vFormAbert then
    begin
      if (pFrmCadPedVenda.DBGrid1.DataSource.State = dsBrowse)
        and (pFrmCadPedVenda.PageControl1.ActivePage = pFrmCadPedVenda.TabSheet2) then
      begin
        if trim(vDadosIni.vtpVenda) = 'REQ' then
            pFrmCadPedVenda.RadioGroup3.ItemIndex := 0
        else if trim(vDadosIni.vtpVenda) = 'OS' then
            pFrmCadPedVenda.RadioGroup3.ItemIndex := 1
        else if trim(vDadosIni.vtpVenda) = 'ORC' then
            pFrmCadPedVenda.RadioGroup3.ItemIndex := 2;
      end;
    end;

    if (modal) and (not pFrmCadPedVenda.Visible) then
      pFrmCadPedVenda.ShowModal
    else if (not pFrmCadPedVenda.Visible) then
      pFrmCadPedVenda.Show
    else if pFrmCadPedVenda.FormStyle = fsMDIChild then
      pFrmCadPedVenda.Show
    else
      pFrmCadPedVenda.ShowModal;
  end;
begin
	try
    vFormAbert := true;
    if trim(vDadosIni.vtpVenda) = 'REQ' then
      vDadosIni.abreStatusProcessamento('', 'Abrindo Venda Produtos')
    else if trim(vDadosIni.vtpVenda) = 'OS' then
      vDadosIni.abreStatusProcessamento('', 'Abrindo Ordem de Serviço')
    else if trim(vDadosIni.vtpVenda) = 'ORC' then
      vDadosIni.abreStatusProcessamento('', 'Abrindo Orçamento');

    vDadosIni.vTipoForm := 0;

    if trim(vDadosIni.vtpVenda) = 'ORC' then
    	abrirFormPedVenda(FrmCadPedVendaORC)
    else if trim(vDadosIni.vtpVenda) = 'OS' then
    	abrirFormPedVenda(FrmCadPedVendaOS)
    else
    	abrirFormPedVenda(FrmCadPedVendaREQ);

  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

