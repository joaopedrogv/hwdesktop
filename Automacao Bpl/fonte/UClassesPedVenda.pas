procedure TPedVenda.agenda_oficina;
begin
  if vAgenda.Active = false then
    exit;

  vAgenda.dataSet.Edit;
  vAgenda.dataSet.FieldByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
  vAgenda.dataSet.Post;

  vAgenda.Apply;
  vAgenda.CommitaTransacao;

  vAgenda.vAgendaItens.dataSet.First;

  while not vAgenda.vAgendaItens.Eof do
  begin
    if (vAgenda.vAgendaItens.dataSet.FieldByName('SEL').AsString = 'S') then
    begin
      vAgenda.vAgendaItens.dataSet.Edit;
      vAgenda.vAgendaItens.dataSet.FieldByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
      vAgenda.vAgendaItens.dataSet.Post;
    end;
    vAgenda.vAgendaItens.Next;
  end;

  vAgenda.vAgendaItens.Apply;
  vAgenda.vAgendaItens.CommitaTransacao;
end;

function TPedVenda.Alterar: boolean;
begin
  result := false;
  if IsEmpty then
    exit;
  result := inherited Edit;
end;

procedure TPedVenda.alterarNpedItens;
begin
  try
    disableControlsDataSets;
    vItProd.dataSet.First;
    while not vItProd.dataSet.Eof do
    begin
      vItProd.dataSet.Edit;
      vItProd.dataSet.FieldByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
      vItProd.dataSet.Post;
      vItProd.dataSet.Next;
    end;
    if vSing.vTipoVenda <> 'REQ' then
    begin
      vItServ.dataSet.First;
      while not vItServ.dataSet.Eof do
      begin
        vItServ.dataSet.Edit;
        vItServ.dataSet.FieldByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
        vItServ.dataSet.Post;
        if (vDadosIni.vMecOS = 'S') then
        begin
          vItServ.vMecOs.First;
          while not vItServ.vMecOs.Eof do
          begin
            if (vItServ.vMecOs.dataSet.FieldByName('cod_servico').asinteger= vItServ.dataSet.FieldByName('cod_servico').asinteger)
              and (trim(vItServ.vMecOs.dataSet.FieldByName('TIPO').AsString) = trim(vItServ.dataSet.FieldByName('TIPO').AsString)) then
            begin
              vItServ.vMecOs.dataSet.Edit;
              vItServ.vMecOs.dataSet.FieldByName('nped').asinteger := dataSet.FieldByName('nped').AsInteger;
              vItServ.vMecOs.dataSet.Post;
            end;
            vItServ.vMecOs.Next;
          end;
        end;
        vItServ.dataSet.Next;
      end;
      vItServTerc.First;
      while not vItServTerc.dataSet.Eof do
      begin
        vItServTerc.dataSet.Edit;
        vItServTerc.dataSet.FieldByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
        vItServTerc.dataSet.Post;
        vItServTerc.Next;
      end;
      vItProdTerc.First;
      while not vItProdTerc.dataSet.Eof do
      begin
        vItProdTerc.dataSet.Edit;
        vItProdTerc.dataSet.FieldByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
        vItProdTerc.dataSet.Post;
        vItProdTerc.Next;
      end;
      vOcorr.First;
      while not vOcorr.Eof do
      begin
        vOcorr.dataSet.Edit;
        vOcorr.dataSet.FieldByName('NPED').AsInteger := dataSet.FieldByName('nped').AsInteger;
        vOcorr.dataSet.FieldByName('n_os').AsInteger := dataSet.FieldByName('nped').AsInteger;
        vOcorr.dataSet.FieldByName('tipo').AsString := dataSet.FieldByName('tipo').AsString;
        vOcorr.dataSet.Post;
        vOcorr.Next;
    end;
    end;
  finally
    enableControlsDataSets;
  end;
end;

