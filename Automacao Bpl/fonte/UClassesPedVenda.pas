function TPedVenda.davJaImpressoNoECF(pAcao: string): Boolean;
begin
	Result := False;
	if dataSet.FieldByName('nprevenda').AsInteger = 0 then
		Exit;
	buscas.close;
	buscas.SQL.Text :=
		'select dav_impresso, coo_impressao from pedvenda' +
		' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
		' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
		' and cod_empresa = ' + vDadosIni.codEmpresa;
	buscas.Open;

	Result := (dataSet.FieldByName('COO_IMPRESSAO').AsInteger > 0);

	if Result then
	begin
		vDadosIni.vInibeMensPesqPros := 'S';
		if not vDadosIni.PesqPros('VND103', pAcao, getTipoVenda, 'PEDVENDA',
			dataSet.FieldByName('NPED').AsString, buscas, true) then
		begin
			Application.MessageBox(Pchar('Ações no DAV não é permitida. DAV já impresso no ECF'), 'Atenção', MB_ICONINFORMATION + MB_OK);
			exit;
		end;
		Result := False;
	end;
end;

function TPedVenda.defineCampos(vDtSet: TClientDataSet; Itens: boolean): boolean;
