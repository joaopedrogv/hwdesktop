function TClientesPed.limiteDeCreditoEstouradoFechamento(
  Valor: currency): boolean;
var
  valorCredito: Currency;
  valorCheque: Currency;
begin
  result := false;
  if (dataset.FieldByName('LIMITE_CREDITO').AsFloat > 0) then
  begin
    if RoundTo(dataset.FieldByName('LIMITE_CREDITO').AsFloat, - 2) < RoundTo(Valor, - 2) then
    begin
      Application.MessageBox(PChar('Limite de Crédito Estourado para o cliente. Valor: ' +
        format('%m', [dataset.FieldByName('LIMITE_CREDITO').AsFloat])),
        'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      result := true;
      exit;
    end;
    vDadosIni.abreStatusProcessamento('', 'Verificando limite de Credito');
    valorCredito := getValorDebitoCredito;
    valorCheque := getValorDebitoCheque;
    vdadosini.fechaStatusProcessamento;
    if (RoundTo(Valor + valorCredito + valorCheque, - 2) > RoundTo(dataset.FieldByName('LIMITE_CREDITO').AsFloat, - 2)) then
    begin
    {
      Application.MessageBox(pchar('Cliente com Limite Estourado' + chr(13) +
        'Valor do Limite: ' + format('%n', [dataset.FieldByName('LIMITE_CREDITO').AsCurrency]) + chr(13) +
        'Valor do debito: ' + format('%n', [valorCredito + valorCheque]) + chr(13) +
        'Valor da Compra: ' + format('%n', [Valor])), 'Erro', MB_ICONWARNING + MB_OK);
    }
      ShowWarning('Cliente com Limite Estourado %s' +
                  'Valor do Limite: %n %s' +
                  'Valor do Débito: %n %s' +
                  'Valor da Compra: %n %s' +
                  '%s',
                  [sLineBreak,
                   ffloat('limite_credito'), sLineBreak,
                   valorCredito + valorCheque, sLineBreak,
                   Valor, sLineBreak,
                   IfThen(fequals('USAR_LIM_LIBVND_FINAN', 'S'), '>Cliente configurado para permitir continuar mesmo com limite estourado<')]);
      Result := fdif('USAR_LIM_LIBVND_FINAN', 'S');
    end;
  end;
end;

