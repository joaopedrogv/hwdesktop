        vCondPagRequisicaoR := '';
        vCondPagOrdemServico := '';
        vCondPagOrcamentoN := '';
        vCondPagOrcamentoR := '';

        AConf := TConfig_sistema_class.getConf('cond_pag_padrao_por_tipo', buscas, vDadosIni.cod_empresa);
