function TPedVendaProd.devolver(qtde: Real): boolean;
var
  vnitem: integer;
begin
  Result := false;
  if qtde = 0 then
  begin
    Application.MessageBox(pchar('Quantidade informada igual zero.'), 'Informação', MB_ICONINFORMATION + MB_OK);
    exit;
  end;
  if not (dataSet.State in [dsInsert, dsedit, dsbrowse]) then
  begin
    dataSet.Cancel;
    Result := False;
  end;
  if dataSet.State = dsBrowse then
  begin
    if dataSet.IsEmpty then
    begin
      Result := false;
      exit;
    end;
    if dataSet.FieldByName('quant_ped_item').AsString = FloatToStr(qtde) then
    begin
      if Application.MessageBox(pchar('Quantidade informada igual a quantidade do item!' + #13 +
        'Deseja apagar o item?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDYES then
      begin
        if Cancel then
          Result := true
        else
          Result := false;
      end;
    end
    else if dataSet.FieldByName('quant_ped_item').AsFloat > qtde then
    begin
      dataSet.Edit;
      dataSet.FieldByName('quant_ped_item').AsFloat := dataSet.FieldByName('quant_ped_item').AsFloat - qtde;
      dataSet.Post;
      Result := true;
    end
    else Application.MessageBox(pchar('Quantidade informada maior que a quantidade do item na OS' ), 'Informação', MB_ICONWARNING);
  end;
end;

procedure TPedVendaProd.dataSetCalcFields(DataSet: TDataSet);
begin
  if (dataSet.FieldByName('TABPRATICADA').AsString = 'N')
  	and (DataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N')
    and (DataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
    	DataSet.FieldByName('MAX_DESC_TAB_TEMP').AsFloat := 100
  else
    DataSet.FieldByName('MAX_DESC_TAB_TEMP').AsFloat :=
      IfThen(DataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
        0, DataSet.FieldByName('MAX_DESC_TAB').AsFloat);

	DataSet.FieldByName('PESO_LIQ_PROD_TEMP').AsFloat :=
  	DataSet.FieldByName('QUANT_PED_ITEM').AsFloat * DataSet.FieldByName('PESO_LIQ_PROD').AsFloat;

  DataSet.FieldByName('PESO_BRUT_PROD_TEMP').AsFloat :=
  	DataSet.FieldByName('QUANT_PED_ITEM').AsFloat * DataSet.FieldByName('PESO_BRUT_PROD').AsFloat;

  if DataSet.FieldByName('QUANT_DEV_ITEM_TEMP').IsNull then
  	DataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat := 0;

  if DataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').IsNull then
  	DataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').AsFloat := 0;

	if (trim(DataSet.FieldByName('UNIDADE_CONV').AsString) = '')
    or (UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString))) then
  begin
  	if DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat <= 0 then
  		DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
      	DataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);

    if DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat <= 0 then
    	DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
      	DataSet.FieldByName('VLUN_PED_NF').AsFloat, - StrToInt(vSing.vCasasDecimais));

    if DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat <= 0 then
    	DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
      	DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));

    if DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat <= 0 then
    	DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
      	DataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);

    DataSet.FieldByName('FATOR_CONV_TEMP').AsString := '';
  end
  else
  begin
    if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
    begin
    	if DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat <= 0 then
        DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            DataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

      if DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat <= 0 then
        DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('VLUN_PED_NF').AsFloat /
            DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat <= 0 then
        DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
            DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat <= 0 then
        DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('QUANT_ITEM_DEV').AsFloat *
            DataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

      DataSet.FieldByName('FATOR_CONV_TEMP').AsString :=
        FloatToStr(RoundTo(1, -4)) + ' ' +
        UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString)) + ' = ' +
        FloatToStr(RoundTo(DataSet.FieldByName('FATOR_CONV').AsFloat, -4)) + ' ' +
        UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString));
    end
    else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
    begin
    	if DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat <= 0 then
        DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('QUANT_PED_ITEM').AsFloat /
            DataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

      if DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat <= 0 then
        DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('VLUN_PED_NF').AsFloat *
            DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

    	if DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat <= 0 then
        DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
            DataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat <= 0 then
        DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
          DataSet.FieldByName('QUANT_ITEM_DEV').AsFloat /
          	DataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

      DataSet.FieldByName('FATOR_CONV_TEMP').AsString :=
        FloatToStr(RoundTo(1, -4)) + ' ' +
        UpperCase(trim(DataSet.FieldByName('UNIDADE_CONV').AsString)) + ' = ' +
        FloatToStr(RoundTo(DataSet.FieldByName('FATOR_CONV').AsFloat, -4)) + ' ' +
        UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString));
    end
    else
    begin
      if DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat <= 0 then
    		DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
        	DataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);

      if DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat <= 0 then
	    	DataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
        	DataSet.FieldByName('VLUN_PED_NF').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat <= 0 then
    		DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
        	DataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat <= 0 then
      	DataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
        	DataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);

      DataSet.FieldByName('FATOR_CONV_TEMP').AsString := '';
    end;
  end;

  DataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat := RoundTo(
  	DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat
    	+ IfThen(DataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat > 0, DataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat, 0) +
      		DataSet.FieldByName('ACRESC_ITEM').AsFloat
      - IfThen(DataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat > 0, DataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat, 0) -
      		DataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

  if DataSet.FieldByName('QUANT_PED_ITEM').AsFloat > 0 then
    DataSet.FieldByName('VLUN_PED_ITEM_LIQ').AsFloat := RoundTo(
      DataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat / DataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));

  if DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0 then
    DataSet.FieldByName('VLUN_PED_ITEM_CONV_LIQ').AsFloat := RoundTo(
      DataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat / DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
end;

procedure TPedVendaProd.dtsetItProdTemBeforePost(DataSet: TDataSet);
begin
  if vDadosIni.StrToFloatFormat(dtSetIt.FieldByName('QTDAMESCLAR').AsFloat, 4) > vDadosIni.StrToFloatFormat(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 4) then
  begin
    Application.MessageBox('Quantidade à mesclar não pode ultrapassar a quantidade do item.', 'Informação', MB_OK + MB_ICONINFORMATION);
    abort;
  end
  else if dtSetIt.FieldByName('QTDAMESCLAR').AsFloat = 0 then
    dtSetIt.FieldByName('SELEC').AsVariant := null;
end;

function TPedVendaProd.edit: boolean;
var
  ponto: Pointer;
begin
  Result := false;

  if dataSet.IsEmpty then
  	exit;
  vProduto.buscaProduto(
  	dataSet.FieldByName('grupo_prod').AsInteger,
    dataSet.FieldByName('cod_prod').AsString);
  Result := inherited edit;
  if not Result then
  	exit;

  if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') then
  	vTipServ.abreTipoServico(dataSet.FieldByName('NPED').AsInteger, dataSet.FieldByName('TIPO').AsString);

  if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
  begin
	  vUsarPrecoProdPromDif := vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T']);
    vPrecoPromocaoProd := IfThen(vUsarPrecoProdPromDif, dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, 0);

    vUsarPrecoProdPorQtde := dataSet.FieldByName('TABPRATICADA').AsString = 'Q';
    vPrecoProdPorQtde := IfThen(vUsarPrecoProdPorQtde, dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, 0);

    vValorDesconto := dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;
  end;

  vQuantidade := vDadosIni.ifThen(dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0,
  	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat,
    dataSet.FieldByName('QUANT_PED_ITEM').AsFloat);

  vUnidade := vDadosIni.ifThen(trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '',
  	UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)),
    UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)));

  vNat_DescAcresc      := dataSet.FieldByName('TP_DESCACRES').AsString;
  vTp_DescAcresc       := dataSet.FieldByName('NAT_DESCACRES').AsString;
	vValor_DescAcresc    := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
  vPerc_Comissao_Vend3 := dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat;
end;

function TPedVendaProd.existeItem(numFabProd: string): boolean;
var
  cod_grade, grupoprod: integer;
  codigo_nop: double;
  codprod: string;
begin
  cod_grade := dataSet.FieldByName('cod_grade').asinteger;
  grupoprod := dataSet.FieldByName('grupo_prod').asinteger;
  codprod := trim(dataSet.FieldByName('cod_prod').AsString);
  codigo_nop := dataSet.FieldByName('codigo_nop').asfloat;

  Result := false;
  dataSet.Cancel;
  dataSet.First;
  while not dataSet.Eof do
  begin
    if not ProdutoPossuiGrade(grupoprod, codprod) then
    begin
      if (trim(numFabProd) = trim(dataSet.FieldByName('num_fab_prod').AsString)) and
        (codigo_nop = dataSet.FieldByName('codigo_nop').asfloat) and
        (dataSet.FieldByName('STATUS').asstring <> 'CANCELADO') then
      begin
        Result := true;
        exit;
      end;
    end
    else if (trim(numFabProd) = trim(dataSet.FieldByName('num_fab_prod').AsString)) and
      (nGradeSelecionada = dataSet.FieldByName('cod_grade').asinteger) and
      (codigo_nop = dataSet.FieldByName('codigo_nop').asfloat) and
      (trim(dataSet.FieldByName('STATUS').asstring) <> 'CANCELADO') then // and (cod_grade <> 0) then
    begin
      Result := true;
      exit;
    end;
    dataSet.Next;
  end;
end;

function TPedVendaProd.existeProdutoSemAtendimento: boolean;
begin
  Result := false;
  First;
  vDadosIni.abreStatusProcessamento('', 'Verificando Atendimento por Item');
  while not dataSet.eof do
  begin
    if (dataSet.FieldByName('SIT_ATD').AsString = 'NT')
      and (dataSet.FieldByName('STATUS').AsString = '') then
    begin
      Result := true;
      Break;
    end;
    Next;
  end;
  vDadosIni.fechaStatusProcessamento;
end;

function TPedVendaProd.filtrarItensDAV(pNPED: integer; pTipo: string): boolean;
begin
  dtSetIt.Close;
  dtSetIt.Filtered := false;
  if pNPED <> 0 then
  begin
    dtSetIt.Filter := 'TIPO=' + QuotedStr(pTipo) + ' and NPED=' + inttostr(pNPED);
    dtSetIt.Filtered := true;
  end;
  dtSetIt.Open;
end;

function TPedVendaProd.GetDevInterna: TDataSet_OOP;
var
  SIdDevolucao, SIdCondicional: string;
begin
  if not Assigned(FDevInterna) then
    FDevInterna := TDataSet_OOP.Create(buscas.Database);

  if fempty('tipo') or fempty('nped') then
  begin
    DevInternaReset;
    Result := FDevInterna;
    Exit;
  end;

  if FDevInterna.TableName <> (fstr('tipo') + fstr('nped')) then
  begin
    SIdDevolucao := vDadosIni.vImpDavReduzidoDetalhado.vDevIdDevolucao;
    SIdCondicional := vDadosIni.vImpDavReduzidoDetalhado.vDevIdCondicional;

    FDevInterna.filterClear;
    FDevInterna.ClientOpen(' select ''%s'' tipo, d.data, d.sequencia id, d.grupo_prod, d.cod_prod, d.cod_grade, sum(coalesce(d.quant, 0)) quantidade ' +
                           ' from devolucao d ' +
                           ' where d.cod_venda = %d ' +
                           ' and d.tipo_venda = %s ' +
                           ' and d.cod_empresa = %d ' +
                           ' group by 1,2,3,4,5,6 ' +
                           ' union ' +
                           ' select ''%s'' tipo, pd.data, null id, pd.grupo_prod, pd.cod_prod, pd.cod_grade, sum(coalesce(pd.quantidade, 0)) quantidade ' +
                           ' from pedvenda_prod_cond_dev pd ' +
                           ' where pd.nped = %d ' +
                           ' and pd.tipo = %s ' +
                           ' and pd.cod_empresa = %d ' +
                           ' group by 1,2,3,4,5,6 ' +
                           ' order by 2,3 ',
                           [SIdDevolucao, FOwner.fint('nped'), FOwner.fstrq('tipo'), vDadosIni.cod_empresa,
                            SIdCondicional, FOwner.fint('nped'), FOwner.fstrq('tipo'), vDadosIni.cod_empresa]);

    FDevInterna.fdata('quantidade').SetNumberDisplayFormat(vDadosIni.vEmp.vCasasDecimais);

    //enquanto não existe outro processamento no afterscroll do dataset do item pode ficar assim, caso contrario nao pode remover o evento
    if FDevInterna.dataSet.RecordCount > 0 then
    begin
      FDevInterna.TableName := fstr('tipo') + fstr('nped');
      //dataSet.AfterScroll := AfterScroll;
      //AfterScroll(dataSet);
    end
    else
      DevInternaReset;
  end;

  Result := FDevInterna;
end;

function TPedVendaProd.getPesoBrutoProdutos: Real;
begin
  vSing.pesobr := 0;
  First;
  while not dataSet.eof do
  begin
    vProduto.buscaProduto(
    	dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString);
    vSing.pesobr := vSing.pesobr + (vProduto.dataSet.FieldByName('PESO_BRUT_PROD').AsFloat
      * dataSet.FieldByName('QUANT_PED_ITEM').AsFloat);
    Next;
  end;
  Result := vSing.pesobr;
end;

function TPedVendaProd.getSituacaoProdutoSimilar: string;
var
  vEst, vQtdeItem: Double;
begin
  vEst := vProduto.getQtdeDisponivelEmEstoque(false);
  vQtdeItem := dataSet.FieldByName('quant_ped_item').AsFloat;
  if vQtdeItem > vEst then
  begin
    if vProduto.vSim.existeProdutoSimilar(dataSet.FieldByName('grupo_prod').AsInteger,
      dataSet.FieldByName('cod_prod').AsString, 1) then
    begin
      vEst := vProduto.getQtdeDisponivelEmEstoque(
        vProduto.vSim.dataSet.FieldByName('grupo_ps').AsInteger,
        vProduto.vSim.dataSet.FieldByName('cod_ps').AsString);
      if vEst >= vQtdeItem then
        Result := 'S'
      else
        Result := '*';
    end
    else
      Result := '*';
  end
  else
    Result := ' ';
end;

function TPedVendaProd.getValorItensBruto: Currency;
begin
  CalculaValorTotalItens;
  Result := vTotalItensBruto;
end;

function TPedVendaProd.getValorItensLiquido: Currency;
begin
  CalculaValorTotalItens;
  Result := vTotalItensLiq;
end;

function TPedVendaProd.getValorLiqParaMargem: Currency;
begin
{
  Result := ((dataSet.FieldByName('VLUN_PED_ITEM').AsFloat * dataSet.FieldByName('quant_ped_item').AsFloat) +
    dataSet.FieldByName('RATEIO_ACRESC').AsCurrency -
    dataSet.FieldByName('RATEIO_DESC').AsCurrency) /
    dataSet.FieldByName('quant_ped_item').AsFloat;
}
  Result := (ffloat('vltot_ped_item') +
             // o acrescimo quando nf_ac_calctrib S ou N é despensa portanto apenas o acresc_item entra no calculo da margem
             IfThen(FOwner.str_empty('nf_ac_calctrib'), ffloat('rateio_acresc'), ffloat('acresc_item')) -
             ffloat('rateio_desc') +
             // o desconto possui o icmsdesoneradoo porem quando embutido foi adicionado como acrescimo, necessitando somar o valor embutido para obter corretamente o valor liquido
             IfThen(FOwner.str_empty('nf_ac_calctrib') and (FOwner.fstr('nf_cf_deson_emb') = 'S'), ffloat('nf_ac_des_emb'))
            ) / ffloat('quant_ped_item');
end;

