  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Formas de Pagamento do Cliente';
    TFrmCadPedVenda(FrmCadPed).pnFormasCliente.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;

    buscas.Close;
    buscas.SQL.Text := 'select CONTROLES_FP from CLIENTES' +
      ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vTemp := Trim(buscas.FieldByName('CONTROLES_FP').AsString);

    buscas.Close;
    buscas.SQL.Text := 'SELECT CODIGO_CTRL, NOME_CTRL FROM CONTROLES' +
      ' WHERE CXENT = ''S'' ' +
      ' AND ATIVO = 1 ' +
      ' AND CODIGO_EMP = ' + vDadosIni.codEmpresa;
    if Trim(vTemp) <> '' then
      buscas.SQL.Text := buscas.SQL.Text + ' AND CODIGO_CTRL IN ' + Trim(vTemp)
    else
      buscas.SQL.Text := buscas.SQL.Text + ' AND CODIGO_CTRL = 0';
    buscas.SQL.Text := buscas.SQL.Text + ' ORDER BY QSEQPERF';
    buscas.Open;

    TFrmCadPedVenda(FrmCadPed).dsFormasCiente.DataSet := buscas;

    result := (formulario.ShowModal = mrOk);

  finally
    TFrmCadPedVenda(FrmCadPed).dsFormasCiente.DataSet := nil;
    TFrmCadPedVenda(FrmCadPed).pnFormasCliente.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros;
