function TPedVenda.edit: boolean;
var
  nped: integer;
  qrHelp: TQuery_OOP;

  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
begin
  Result := false;
  try
    if dataSet.IsEmpty then
      Exit;

    try
    	ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
 			vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));

      vSing.vVendaRapida := false;
      if vendaFechada then
      begin
        vItProd.vGrade := TGradeProdEstPed.create(Self.DtmPed);
        nped := dataSet.FieldByName('NPED').AsInteger;
        vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
        vItProd.abrePedVendaProd(nped);
        vCliente.abreClientes(dataSet.FieldByName('COD_CLIENTE').AsInteger);
        FCliOriginalVND := dataSet.FieldByName('COD_CLIENTE').AsInteger;
        vCondPag.abreCondPag(dataSet.FieldByName('COD_COND_PAG').AsInteger);
        vColab.abreColaborador;
        vParticipante.abreParticipante;

        if vUsarControlesVenda = 'S' then
        begin
          vCtrl.dataSet.Close;
          if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
            if Trim(vCliente.dataSet.FieldByName('controles_fp').AsString) <> '' then
              vCtrl._selecionaControlesFP(Trim(vCliente.dataSet.FieldByName('controles_fp').AsString));

          if not vCtrl.dataSet.Active then
            vCtrl._selecionaControlesFP('');
        end;
        if vDadosIni.vEmp.vSegmentaProdVenda = 'S1' then
        begin
  //        vServ.abreTipoServicoSeg;
          vItProd.vTipServ.abreTipoServicoSeg;
          vItServ.vTipServ.abreTipoServicoSeg;

        end;
        if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
        begin
          vListaColab.ListaColaborador;
          vItServ.abrePedVendaServ(nped);
          vItServTerc.abreServicoTerceiro(nped);
          vItProdTerc.abreProdTerceiro(nped);
          vOcorr.abreOcorreciaPed(nped, vSing.vTipoVenda);
          if (vDadosIni.vMecOS = 'S') then
            vItServ.vMecOs.aberturaDosItens(IntToStr(dataSet.FieldByName('nped').AsInteger), vSing.vTipoVenda);
        end
        else
          vItServ.Close;
        Result := True;
        EXIT;
      end;

      if pedidoEmEdicao(caAdicionarEdicao, True) then
      begin
        Result := False;
        Exit;
      end;

      qrHelp := QueryHelper.CreateObj(buscas)
        .Open('select result, msg from SP_PEDVENDA_PLANO_REVERTER(%d, %s, %d)',
                 [fint('nped'), fstrq('tipo'), vDadosIni.cod_empresa]);

      if qrHelp.fequals('result', '1') and qrHelp.fequals('msg', 'REVERTIDO') then
      begin
        CommitaTransacao;
        dataSet.Refresh;
      end;

      if inherited edit then
      begin
        vCodClienteExit        := 0;
        vCodVendedorExit       := 0;
        vCodCondPagExit        := 0;
        vTipoVExit             := '';
        vTipoOsExit            := '';
        vTipoOrcExit           := '';
        vPercComissaoVend3Exit := 0;

		  vCodClienteOld   := dataSet.FieldByName('COD_CLIENTE').AsInteger;
        vCodVendedorOld  := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
        vCodCondPagOld   := dataSet.FieldByName('COD_COND_PAG').AsInteger;
        vTipoVOld        := trim(dataSet.FieldByName('TIPV').AsString);
        vTipoOsOld       := trim(dataSet.FieldByName('TIPO_OS').AsString);
        vTipoOrcOld      := trim(dataSet.FieldByName('TIPO_ORC').AsString);
        vDest_seqidOld   := dataSet.FieldByName('DEST_SEQID').AsInteger;
        vNPEDold         := dataSet.FieldByName('NPED').AsInteger;

        comandoTexto := dataSet.CommandText;
        nped := dataSet.FieldByName('nped').AsInteger;
        FCodAparelho := dataSet.FieldByName('COD_EQUIP').AsInteger;
        vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
        vItProd.abrePedVendaProd(nped);
        vCliente.abreClientes(dataSet.FieldByName('COD_CLIENTE').AsInteger);
        FCliOriginalVND := dataSet.FieldByName('COD_CLIENTE').AsInteger;
        if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
        begin
          vListaColab.ListaColaborador;
          vItServ.abrePedVendaServ(nped);
          vItServTerc.abreServicoTerceiro(nped);
          vItProdTerc.abreProdTerceiro(nped);
          vOcorr.abreOcorreciaPed(nped, vSing.vTipoVenda);
          if (vDadosIni.vMecOS = 'S') then
            vItServ.vMecOs.aberturaDosItens(IntToStr(dataSet.FieldByName('nped').AsInteger), vSing.vTipoVenda);
        end;

        if dataSet.FieldByName('desc_p_prod').IsNull then
        	dataSet.FieldByName('desc_p_prod').AsFloat := 0;
        if dataSet.FieldByName('desc_p_serv').IsNull then
        	dataSet.FieldByName('desc_p_serv').AsFloat := 0;
        if dataSet.FieldByName('desconto').IsNull then
        	dataSet.FieldByName('desconto').AsFloat := 0;
        if dataSet.FieldByName('acresc_p_prod').IsNull then
        	dataSet.FieldByName('acresc_p_prod').AsFloat := 0;
        if dataSet.FieldByName('acresc_p_serv').IsNull then
        	dataSet.FieldByName('acresc_p_serv').AsFloat := 0;
        if dataSet.FieldByName('acrescimo').IsNull then
        	dataSet.FieldByName('acrescimo').AsFloat := 0;

        if fstrin('tipo', ['REQ', 'OS'])
          and (vDadosIni.vUsarPlano[1] in ['S', '2'])
          and conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'Ativa', 'N', 'S') then
          dataSet.FieldByName('nf_ac_calctrib').AsString := 'N';

        if conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'Ativa', 'N', 'S') and
           fempty('nf_ac_calctrib') and (fint('idmobile') > 0)
        then
          dataSet.FieldByName('nf_ac_calctrib').AsString := IfThen( conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'DefaultInclusao', 'N', 'S'), 'S', 'N');

        if vSing.vTipoVenda='REQ' then
          vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPV').AsString)
        else if vSing.vTipoVenda='OS' then
          vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPO_OS').AsString)
        else
        	vItProd.FUsarPrecoCustoTipoVND := (f_str('tipo') = 'ORC') and
                                              (vDadosIni.vLocacao.vHabilitarLoc) and
                                              (vDadosIni.vLocacao.TipoOrcCusto = f_str('tipo_orc')) and
                                              (vDadosIni.vLocacao.ClienteOrcCusto = f_str('cod_cliente'));

        if (vUsarControlesVenda = 'S')
        	and ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS')) then
        begin
          vCtrl.dataSet.Close;
          if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
            if Trim(vCliente.dataSet.FieldByName('controles_fp').AsString) <> '' then
              vCtrl._selecionaControlesFP(Trim(vCliente.dataSet.FieldByName('controles_fp').AsString));

          if not vCtrl.dataSet.Active then
            vCtrl._selecionaControlesFP('');
        end;
        vColab.abreColaborador;
        vParticipante.abreParticipante;
        vCondPag.abreCondPag(vCliente.dataSet.FieldByName('COND_PAG_VND').AsString);
        calculaTotais;
        calculaDescontoAcrescimo;
  //      vItProd.vGrade.iniciaGrades(vItProd);
        if vDadosIni.vEmp.vSegmentaProdVenda = 'S1' then
        begin
  //        vServ.abreTipoServicoSeg;
          vItProd.vTipServ.abreTipoServicoSeg;
          vItServ.vTipServ.abreTipoServicoSeg;
        end;
        Fconf.ExecutarLeitura;

        if Assigned(Ffat_ped) then
        	FreeAndNil(Ffat_ped);
        Ffat_ped := TFaturamento_Group.create(Self);
        Result := true;
      end;
    finally
      if Assigned(FAfterEdit) then
      	FAfterEdit(Self);
      if Assigned(ConfigPoliticaPag) then
      	FreeAndNil(ConfigPoliticaPag);
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.editarObservacaoOSFechada: Boolean;
var
  formDescricao: TfrmCadPedVenda_DescricaoNFSe;
begin
	try
    Result := False;

    if not vendaFechada then
    begin
    	Application.MessageBox(pchar('Ordem de Serviço não esta fechada'), 'Informação', MB_ICONINFORMATION + MB_OK);
    	Exit;
    end;

    if not(vDadosIni.PesqPros('VND190', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
    	dataset.FieldByName('NPED').AsString, buscas, true)) then
      	Exit;

    if not inherited Edit then
    	Exit;

    formDescricao := TfrmCadPedVenda_DescricaoNFSe.Create(nil);
    try
      formDescricao.Setup(Self);
      if not (formDescricao.ShowModal = mrOk) then
      begin
        dataSet.Cancel;
        RollBackTransacao();
        Exit;
      end;
    finally
      formDescricao.Free();
    end;
    
    //if TFrmCadPedVenda(FrmCadPed) <> nil then
      //vDadosIni.abreForm('Editar Observação', TFrmCadPedVenda(FrmCadPed).pnObservacao, TFrmCadPedVenda(FrmCadPed).tsObservacao);

    inherited Post;

    Result := inherited Apply;

    if Result then
    begin
    	CommitaTransacao;
      Refresh;
    end
    else
    	RollBackTransacao;
  except on E: Exception do
  begin
    Result := False;
    RollBackTransacao;
    Application.MessageBox(PChar(e.Message), 'Atenção', 0 + 16);
    registraErro(e.Message);
  end;
  end;
end;

