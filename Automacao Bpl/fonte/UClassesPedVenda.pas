function TPedVendaProd.abrePedVendaProd(nPed: integer): boolean;
var
  I: Integer;
  vdtSetDevTemp, vdtSetItensTemp: TClientDataSet;
  vValorDevRest: Double;
begin
	try
  	vdtSetDevTemp := TClientDataSet.Create(nil);
    vdtSetDevTemp.Close;
    vdtSetDevTemp.FieldDefs.Clear;
    vdtSetDevTemp.FieldDefs.Add('NPED', ftInteger, 0, false);
    vdtSetDevTemp.FieldDefs.Add('TIPO', ftString, 3, false);
    vdtSetDevTemp.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
    vdtSetDevTemp.FieldDefs.Add('COD_PROD', ftString, 6, false);
    vdtSetDevTemp.FieldDefs.Add('COD_GRADE', ftInteger, 0, false);
    vdtSetDevTemp.FieldDefs.Add('QUANT_DEV_REST', ftFloat, 0, false);

    if vdtSetDevTemp.Tag = 0 then
    try
      vdtSetDevTemp.CreateDataSet;
      vdtSetDevTemp.Tag := 1;
    except
    end;

  	vdtSetItensTemp := TClientDataSet.Create(nil);
    vdtSetItensTemp.Close;
    vdtSetItensTemp.FieldDefs.Clear;
    vdtSetItensTemp.FieldDefs.Add('NPED', ftInteger, 0, false);
    vdtSetItensTemp.FieldDefs.Add('TIPO', ftString, 3, false);
    vdtSetItensTemp.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
    vdtSetItensTemp.FieldDefs.Add('COD_PROD', ftString, 6, false);
    vdtSetItensTemp.FieldDefs.Add('NITEM', ftInteger, 0, false);
    vdtSetItensTemp.FieldDefs.Add('COD_GRADE', ftInteger, 0, false);
    vdtSetItensTemp.FieldDefs.Add('CODIGO_NOP', ftFloat, 0, false);
    vdtSetItensTemp.FieldDefs.Add('QUANT_PED_ITEM', ftFloat, 0, false);
    vdtSetItensTemp.FieldDefs.Add('QUANT_DEV_ITEM', ftFloat, 0, false);

    if vdtSetItensTemp.Tag = 0 then
    try
      vdtSetItensTemp.CreateDataSet;
      vdtSetItensTemp.Tag := 1;
    except
    end;

    if vListarImprimirItemCancConsignado then
      result := montaSelect(' select * from pedvenda_prod ' +
        ' where nped = ' + inttostr(nPed) +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1')
    else if vListarNaoImprimirItemCanc then
      result := montaSelect(' select * from pedvenda_prod ' +
        ' where nped = ' + inttostr(nPed) +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(status,'''') <> ''CANCELADO'' ' +
        ' and ativo = 1 ' +
        ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
        ' and coalesce(status,'''') = ''CANCELADO'')')
    else if vListarImprimirItemVan then
      result := montaSelect(' select * from pedvenda_prod ' +
        ' where nped = ' + inttostr(nPed) +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(status,'''') <> ''CANCELADO'' ' +
        ' and ativo = 1 ' +
        ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
        ' and coalesce(status,'''') = ''CANCELADO'')')
    else
      result := montaSelect(' select * from pedvenda_prod ' +
        ' where nped = ' + inttostr(nPed) +
        ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ' +
        ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
        ' and coalesce(status,'''') = ''CANCELADO'')');
    nItem := _retornaQtdNItensCancelConsignado;
    if not DataSet.ControlsDisabled then
      DataSet.DisableControls;
    dtSet.open;
    dtSet.EmptyDataSet;

    DataSet.First;
    while not DataSet.Eof do
    begin
      dtSet.Insert;
      for I := 0 to dtSet.Fields.Count - 1 do
        if dataSet.FindField(dtSet.Fields[I].FieldName) <> nil then
        dtSet.Fields[I].Value := dataSet.FieldByName(dtSet.Fields[I].FieldName).Value;
      dtSet.Post;

      if (dataSet.FieldByName('PESO_LIQ_PROD').AsFloat <= 0) and (dataSet.FieldByName('PESO_BRUT_PROD').AsFloat <= 0) then
      begin
      	buscas.Close;
      	buscas.SQL.Text := ' select peso_liq_prod, peso_brut_prod from produtos ' +
        	' where grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;

        if (buscas.FieldByName('PESO_LIQ_PROD').AsFloat > 0)
        	or (buscas.FieldByName('PESO_BRUT_PROD').AsFloat > 0) then
        begin
        	dataSet.Edit;
        	if buscas.FieldByName('PESO_LIQ_PROD').AsFloat > 0 then
        		dataSet.FieldByName('PESO_LIQ_PROD').AsFloat := buscas.FieldByName('PESO_LIQ_PROD').AsFloat;

          if buscas.FieldByName('PESO_BRUT_PROD').AsFloat > 0 then
        		dataSet.FieldByName('PESO_BRUT_PROD').AsFloat := buscas.FieldByName('PESO_BRUT_PROD').AsFloat;
          dataSet.Post;
        end;
      end;

      buscas.Close;
      buscas.SQL.Text := ' select ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) + ' tipo, ' +
      	' d.grupo_prod, d.cod_prod, d.cod_grade, sum(coalesce(d.quant, 0)) quant_dev_item from devolucao d ' +
        ' where d.cod_venda = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
        ' and d.tipo_venda = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
        ' and d.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
        ' and d.cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
        ' and d.cod_grade = ' + IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger) +
        ' and d.cod_empresa = ' + vDadosIni.codEmpresa +
        ' group by 1,2,3,4 ';
      buscas.Open;

      if not buscas.IsEmpty then
      begin
      	try
        	vdtSetDevTemp.Filtered := false;
          vdtSetDevTemp.Filter :=
          	' grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
            ' and cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
            ' and cod_grade = ' + IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger);
          vdtSetDevTemp.Filtered := true;

          vdtSetItensTemp.Insert;
          vdtSetItensTemp.FieldByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
          vdtSetItensTemp.FieldByName('COD_PROD').AsString := trim(dataSet.FieldByName('COD_PROD').AsString);
          vdtSetItensTemp.FieldByName('NITEM').AsInteger := dataSet.FieldByName('NITEM').AsInteger;
          vdtSetItensTemp.FieldByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
          vdtSetItensTemp.FieldByName('CODIGO_NOP').AsFloat := dataSet.FieldByName('CODIGO_NOP').AsFloat;
          vdtSetItensTemp.FieldByName('QUANT_PED_ITEM').AsFloat := dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;

          if vdtSetDevTemp.IsEmpty then
          begin
          	if (buscas.FieldByName('QUANT_DEV_ITEM').AsFloat > 0)
            	and (buscas.FieldByName('QUANT_DEV_ITEM').AsFloat > dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) then
            begin
          		vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat := vdtSetItensTemp.FieldByName('QUANT_PED_ITEM').AsFloat;
            end
            else if (buscas.FieldByName('QUANT_DEV_ITEM').AsFloat > 0)
            	and (buscas.FieldByName('QUANT_DEV_ITEM').AsFloat <= dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) then
            begin
              vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat := buscas.FieldByName('QUANT_DEV_ITEM').AsFloat;
            end
            else
            begin
            	vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat := 0;
            end;

            vdtSetDevTemp.Insert;
            vdtSetDevTemp.FieldByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
            vdtSetDevTemp.FieldByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
            vdtSetDevTemp.FieldByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
            vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat := buscas.FieldByName('QUANT_DEV_ITEM').AsFloat;

            if (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat >= buscas.FieldByName('QUANT_DEV_ITEM').AsFloat) then
            		vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat := 0
            else if (buscas.FieldByName('QUANT_DEV_ITEM').AsFloat > dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) then
            		vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat :=
                	vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat - dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
            vdtSetDevTemp.Post;
          end
          else if (vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat > 0)
          	and (vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat >= vdtSetItensTemp.FieldByName('QUANT_PED_ITEM').AsFloat) then
          begin
            vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat := vdtSetItensTemp.FieldByName('QUANT_PED_ITEM').AsFloat;

            vdtSetDevTemp.Edit;
            vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat :=
              vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat - vdtSetItensTemp.FieldByName('QUANT_PED_ITEM').AsFloat;
            vdtSetDevTemp.Post;
          end
          else
          begin
          	vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat := vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat;

          	vdtSetDevTemp.Edit;
            vdtSetDevTemp.FieldByName('QUANT_DEV_REST').AsFloat := 0;
            vdtSetDevTemp.Post;
          end;

          vdtSetItensTemp.Post;
        finally
          vdtSetDevTemp.Filtered := false;
        end;
      end;

      DataSet.Next;
    end;

    DataSet.First;
    while not DataSet.Eof do
    begin
      dataSet.Edit;

      dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat := RoundTo(
        dataSet.FieldByName('RATEIO_ACRESC').AsFloat - dataSet.FieldByName('ACRESC_ITEM').AsFloat, - 2);

      dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat := RoundTo(
        dataSet.FieldByName('RATEIO_DESC').AsFloat - dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

      dataSet.FieldByName('USAR_DEBCRED').AsString :=
      	IfThen(dataSet.FieldByName('USAR_DEBCRED').AsString = 'N',
        	'N', 'S');

      try
        vdtSetItensTemp.Filtered := false;
        vdtSetItensTemp.Filter :=
          ' grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and cod_prod = ' + QuotedStr(trim(dataSet.FieldByName('COD_PROD').AsString)) +
          ' and nitem = ' + IntToStr(dataSet.FieldByName('NITEM').AsInteger) +
          ' and cod_grade = ' + IntToStr(dataSet.FieldByName('COD_GRADE').AsInteger);
        vdtSetItensTemp.Filtered := true;

        if not vdtSetItensTemp.IsEmpty then
        	dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat := vdtSetItensTemp.FieldByName('QUANT_DEV_ITEM').AsFloat
        else
        	dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat := 0;

        if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) = '')
  			  or (UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) then
  			begin
          dataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').AsFloat := RoundTo(
            dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat, - 4);
        end
        else
        begin
        	if (dataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
    			begin
          	dataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat *
                dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else if (DataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (DataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
          begin
            dataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat /
                dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else
          begin
            dataSet.FieldByName('QUANT_DEV_ITEM_TEMP_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_DEV_ITEM_TEMP').AsFloat, - 4);
          end;
        end;

      finally
        vdtSetItensTemp.Filtered := false;
      end;

      dataSet.Post;

      dataSet.Next;
    end;

    if DataSet.ControlsDisabled then
      DataSet.EnableControls;
    DataSet.First;
    if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') then
      vTipServ.abreTipoServico(dataSet.FieldByName('NPED').AsInteger, dataSet.FieldByName('TIPO').AsString)
    else if (vDadosIni.vEmp.vSegmentaProdVenda <> 'S1') then
      vTipServ.abreTipoServico;
  finally
  	if Assigned(vdtSetDevTemp) then
      FreeAndNil(vdtSetDevTemp);
  	if Assigned(vdtSetItensTemp) then
      FreeAndNil(vdtSetItensTemp);
  end;
end;

