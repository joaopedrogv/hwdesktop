           vtemp := vtemp + 'Item ' + dataSet.FieldByName('nitem').AsString + ' Cancelado. Produto: ' + dataSet.FieldByName('num_fab_prod').AsString;

           delete;
           dtSet.EmptyDataSet;
         end
         else
         begin
         while not dataSet.Eof do
         begin
            if (((FOwner.CancelarVariosItens) and (dataSet.FieldByName('SEL').AsString = 'S')) or (not FOwner.CancelarVariosItens))
                 and (trim(dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
            begin
              Inc(I);
