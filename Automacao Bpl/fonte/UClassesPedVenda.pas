procedure TPedVenda.enviarVendaParaNFCe;
var
  nfce_emitir_from_pedvenda: Tnfce_emitir_from_pedvenda;
  ANomeDoc: string;
begin
  if (Trim(dataSet.FieldByName('tipo').AsString) = 'ORC') then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para orçamentos');
    Exit;
  end;

  if (Trim(dataSet.FieldByName('status_ped').AsString) <> 'FECHADA') then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para documento com status: ' +
                          vDadosIni.IfThen(Trim(dataSet.FieldByName('status_ped').AsString) = '',
                          	'ABERTO',
                            Trim(dataSet.FieldByName('status_ped').AsString)));
    Exit;
  end;

  if (Trim(dataSet.FieldByName('tipo').AsString) = 'OS') then
  begin
    if not vDadosIni.PesqPros('VND252', 'EMITIR NFCE', fstr('tipo'), 'PEDVENDA',
      fstr('NPED'), buscas) then
    begin
      Application.MessageBox(Pchar('Emitir NFC-e não é permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;
  end
  else
  if not vDadosIni.PesqPros('VND136', 'EMITIR NFCE', fstr('tipo'), 'PEDVENDA',
    fstr('NPED'), buscas) then
  begin
    Application.MessageBox(Pchar('Emitir NFC-e não é permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
    exit;
  end;

  ANomeDoc := IfThen(Trim(dataSet.FieldByName('tipo').AsString) = 'REQ', 'Pedido', 'Ordem de serviço');

  if (dataSet.FieldByName('ncupom').AsInteger > 0) then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para ' + ANomeDoc + '. Cupom fiscal já emitido ' + #13 +
                          'Numero: ' + dataSet.FieldByName('ncupom').AsString + #13 +
                          'ECF: ' + dataSet.FieldByName('nserieecf').AsString + #13 +
                          'Caixa: ' + dataSet.FieldByName('operador').AsString + #13 +
                          'Data: ' + dataSet.FieldByName('data_cupom').AsString
                          );
    Exit;
  end;

  if (dataSet.FieldByName('n_nfd').AsInteger > 0) then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para ' + ANomeDoc + '. Nota Fiscal Serie D já emitida ' + #13 +
                          'Numero: ' + dataSet.FieldByName('n_nfd').AsString + #13 +
                          'Serie: ' + dataSet.FieldByName('serie_nfd').AsString //+ #13 +
                          //'Data: ' + dataSet.FieldByName('data_nfd').AsString + #13 +
                          //'Valor: ' + Format('%0.2n', [dataSet.FieldByName('valor_nfd').AsFloat])
                          );
    Exit;
  end;

  if (dataSet.FieldByName('num_nf').AsInteger > 0) then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para ' + ANomeDoc + '. Nota Fiscal já emitida ' + #13 +
                          'Numero: ' + dataSet.FieldByName('num_nf').AsString + #13 +
                          'Serie: ' + dataSet.FieldByName('serie_nf').AsString + #13 +
                          'Valor: ' + Format('%0.2n', [dataSet.FieldByName('valor_nf').AsFloat])
                          );
    Exit;
  end;

  buscas.close;
  buscas.sql.text := ' select nped, tipo, cod_empresa, status_ped from pedvenda ' +
    ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
    ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (Trim(buscas.FieldByName('status_ped').AsString) <> 'FECHADA') then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para documento com status: ' +
                          vDadosIni.IfThen(Trim(buscas.FieldByName('status_ped').AsString) = '',
                          	'ABERTO',
                            Trim(buscas.FieldByName('status_ped').AsString)));
    Exit;
  end;

  if SqlOpen('select n_nf, serie from pedvenda_prod' +
             ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
             ' and tipo = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
             ' and cod_empresa = ' + vDadosIni.codEmpresa +
             ' and ((status is null) or (status = ' + QuotedStr('') + '))'
            ).FieldByName('n_nf').AsInteger > 0 then
  begin
    vDadosIni.ShowAtencao('NFC-e não permitida para ' + ANomeDoc + '. Nota Fiscal já emitida ' + #13 +
                          'Numero: ' + buscas.FieldByName('n_nf').AsString + #13 +
                          'Serie: ' + buscas.FieldByName('serie').AsString
                          );
    Exit;
  end;

  if vDadosIni.vNFConsumidor.AHandle = 0 then
    CarregaPacote('pkNFConsumidor', vDadosIni.vNFConsumidor.AHandle);

  if vDadosIni.vNFConsumidor.AHandle = 0 then
  begin
    vDadosIni.ShowAtencao('Pacote Nota Fiscal de Consumidor não carregado');
    Exit;
  end;

  if not vDadosIni._mdiAberto('TfrmCadNFCe', 'O modulo de Nota Fiscal de Consumidor se encontra aberto') then
    exit;

  @nfce_emitir_from_pedvenda := GetProcAddress(vDadosIni.vNFConsumidor.AHandle, PChar('nfce_emitir_from_pedvenda'));
  if Assigned(nfce_emitir_from_pedvenda) then
    nfce_emitir_from_pedvenda(dataSet.FieldByName('nped').AsInteger,
                              Trim(dataSet.FieldByName('tipo').AsString));
end;

function TPedVenda.excluirNFSE_CANCELADAS: boolean;
var
  vNumNFSE: string;
  vDataNFSE: Word;
begin
  try
    Result := False;

    if vNFSE_CANCELADAS.dataSet.IsEmpty then
    	Exit;

    vNumNFSE := vNFSE_CANCELADAS.dataSet.FieldByName('NUM_NFSE').AsString;
    vDataNFSE := YearOf(vNFSE_CANCELADAS.dataSet.FieldByName('EMISSAO_NFSE').AsDateTime);

		if not vDadosIni.PesqPros('VND175', 'EXCLUIR', 'NUM_NFSEEXT ' + vNumNFSE, 'NFSE_CANCELADAS', vNumNFSE, vNFSE_CANCELADAS.buscas, True) then
      Exit;

    if Application.MessageBox(PChar('Tem certeza que deseja excluir todos os cancelamentos referentes a NFS-EXT ' + vNumNFSE),
      'Confirmação', MB_YESNO + MB_ICONQUESTION) <> IDYES then
      Exit;

  	vNFSE_CANCELADAS.buscas.Close;
    vNFSE_CANCELADAS.buscas.SQL.Text := 'DELETE FROM NFSE_CANCELADAS N WHERE N.NUM_NFSE = :NUM_NFSE AND N.COD_EMPRESA = :COD_EMPRESA AND N.COD_RPS = 0 AND EXTRACT(YEAR FROM N.EMISSAO_NFSE) = :ANO';
    vNFSE_CANCELADAS.buscas.ParamByName('NUM_NFSE').AsString := vNFSE_CANCELADAS.dataSet.FieldByName('NUM_NFSE').AsString;
    vNFSE_CANCELADAS.buscas.ParamByName('COD_EMPRESA').AsInteger := vNFSE_CANCELADAS.dataSet.FieldByName('COD_EMPRESA').AsInteger;
		vNFSE_CANCELADAS.buscas.ParamByName('ANO').AsWord := vDataNFSE;
		vNFSE_CANCELADAS.buscas.ExecSQL;

    Result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('VND175', 'EXCLUIR', 'SUCESSO', 'NFSE_CANCELADAS', vNumNFSE, buscas)
    else
    	vDadosIni.GravaAuditoria('VND175', 'EXCLUIR', 'FALHA', 'NFSE_CANCELADAS', vNumNFSE, buscas);

    vNFSE_CANCELADAS.Refresh;
  except on E: Exception do
  begin
  	Result := False;
    vNFSE_CANCELADAS.RollBackTransacao;
    registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;
  end;
end;

function TPedVenda.excluirPermanentemente: boolean;
var
  vNped: string;
begin
  if not vDadosIni.PesqPros('VND051', 'EXCLUINDO PERMANENTEMENTE', getTipoVenda, 'PEDVENDA',
  	dataSet.FieldByName('NPED').AsString, buscas, true) then
    	Exit;
  vNped := dataSet.FieldByName('NPED').AsString;
  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
    if ExecutaComandosSqlExec('delete from pedvenda where nped=' + inttostr(dataSet.FieldByName('NPED').asinteger) +
      'and cod_empresa=' + vDadosIni.codEmpresa) then
    begin
      if CommitaTransacao then
        vDadosIni.GravaAuditoria('VND051', 'EXCLUIDO PERMANENTEMENTE SUCESSO ' + getTipoVenda + ' Nº ' +
          vNped, '', 'PEDVENDA', vNped, buscas)
      else
        vDadosIni.GravaAuditoria('VND051', 'EXCLUIDO PERMANENTEMENTE FALHA ' + getTipoVenda + ' Nº ' +
          vNped, '', 'PEDVENDA', vNped, buscas);
    end;
end;

function TPedVenda.existeCancelamentoItem(pN_OS, pISS_RETIDO: integer;
  pAno: Word; pNUM_NFSE, pCNAE, pCTISS,
  pNFS_SERVICO: string; pALIQ_ISS: Real): boolean;
var
  qrBuscaNFSE_CANCELADAS: TIBQuery;
begin
  try
    Result := False;
    qrBuscaNFSE_CANCELADAS := TIBQuery(DtmPed.qrBuscas3);
    qrBuscaNFSE_CANCELADAS.Close;
    qrBuscaNFSE_CANCELADAS.SQL.Text := 'SELECT N.NUM_NFSE FROM NFSE_CANCELADAS N WHERE N.NUM_NFSE = :NUM_NFSE '+
		'AND N.N_OS = :N_OS AND N.COD_EMPRESA = :COD_EMPRESA '+
		'AND EXTRACT(YEAR FROM N.EMISSAO_NFSE) = :ANO '+
		'AND N.CNAE = :CNAE AND N.CTISS = :CTISS AND N.ALIQ_ISS = :ALIQ_ISS '+
		'AND N.NFS_SERVICO = :NFS_SERVICO AND N.ISS_RETIDO = :ISS_RETIDO';
    qrBuscaNFSE_CANCELADAS.ParamByName('NUM_NFSE').AsString := pNUM_NFSE;
    qrBuscaNFSE_CANCELADAS.ParamByName('N_OS').AsInteger := pN_OS;
    qrBuscaNFSE_CANCELADAS.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    qrBuscaNFSE_CANCELADAS.ParamByName('ANO').AsWord := pAno;
    qrBuscaNFSE_CANCELADAS.ParamByName('CNAE').AsString := pCNAE;
    qrBuscaNFSE_CANCELADAS.ParamByName('CTISS').AsString := pCTISS;
    qrBuscaNFSE_CANCELADAS.ParamByName('ALIQ_ISS').AsFloat := pALIQ_ISS;
    qrBuscaNFSE_CANCELADAS.ParamByName('NFS_SERVICO').AsString := pNFS_SERVICO;
    qrBuscaNFSE_CANCELADAS.ParamByName('ISS_RETIDO').AsInteger := pISS_RETIDO;
    qrBuscaNFSE_CANCELADAS.Open;

    if qrBuscaNFSE_CANCELADAS.IsEmpty then
    	Exit;
    Result := True;
  except on E: Exception do
  begin
  	Result := False;
    registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;
  end;
end;

