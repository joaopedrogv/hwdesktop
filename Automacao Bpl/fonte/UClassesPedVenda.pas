procedure TPedvendaItProd_comiss_classList.CalcularComissItProd(Avlcomissaovend: Double; Avlcomissaopart: Double; ATestarVdn: boolean);
var
  I: Integer;
  vIncVlVnd: Double;
  vIncVlPart: Double;

begin
  vIncVlVnd := 0;
  vIncVlPart := 0;

  if not vDadosIni.vPedVnd.comissaoPorVenda then
    exit;

	for I := 0 to Self.Count - 1 do
    with Self.Items[I] do
    begin
      if (Fvltot_ped_item > 0) and (trim(Fstatus) <> 'CANCELADO') then
      begin
        if (Fperc_prod_vendedor > 0) and (FatualizarVND) then
        begin
          Fperc_comissao_vend := Fperc_prod_vendedor;
          Fvl_comissao_vend := (0.01 * Trunc(((Fvltot_ped_item / 100) * Fperc_prod_vendedor) * 100));
          vIncVlVnd := vIncVlVnd + Fvl_comissao_vend;

          if (I = Self.Count -1) then
          begin
            // Incluir diferença no último item
            if ((Fperc_comissao_vend > 0) and (Avlcomissaovend - vIncVlVnd <> 0)) then
              Fvl_comissao_vend := Fvl_comissao_vend + (Avlcomissaovend - vIncVlVnd);
          end;
        end
        else
        begin
          Fperc_comissao_vend := 0;
          Fvl_comissao_vend := 0;
        end;
        
        if (vDadosIni.vPedVnd.habPartipante) and (Fperc_prod_participante > 0) and (FatualizarPart) then
        begin
          Fperc_comissao_vend1 := Fperc_prod_participante;
          vl_comissao_vend1 := (0.01 * Trunc(((Fvltot_ped_item / 100) * Fperc_prod_participante) * 100));
          vIncVlPart := vIncVlPart + vl_comissao_vend1;

          if (I = Self.Count -1) then
          begin
            // Incluir diferença no último item
            if ((Fperc_comissao_vend1 > 0) and (Avlcomissaopart - vIncVlPart <> 0)) then
              Fvl_comissao_vend1 := Fvl_comissao_vend1 + (Avlcomissaopart - vIncVlPart);
          end;
        end
        else
        begin
          Fperc_comissao_vend1 := 0;
          vl_comissao_vend1 := 0;
        end;
      end
      else
      begin
        Fperc_comissao_vend := 0;
        vl_comissao_vend := 0;
        Fperc_comissao_vend1 := 0;
        vl_comissao_vend1 := 0;
      end;
    end;
	end;

