function TPedVenda._alterarFormPag: Boolean;
var
  vCtrlVnd: Integer;
  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
begin
  Result := True;

  try
  	ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
  	vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));
    
    if vUsarControlesVenda <> 'S' then
      Exit;

    if (Trim(dataSet.FieldByName('tipo').AsString) <> 'REQ') and
      (Trim(dataSet.FieldByName('tipo').AsString) <> 'OS') then
      Exit;

    try

      if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
        vCtrl._selecionaControlesFP(dataSet.FieldByName('cod_controle').AsInteger,
          Trim(vCliente.dataSet.FieldByName('controles_fp').AsString))
      else
        vCtrl._selecionaControlesFP(dataSet.FieldByName('cod_controle').AsInteger, '');

      try
        if vCtrl.dataSet.IsEmpty then
          raiseExceptionCreate('Controle para forma de pagamento informado não encontrado', 'DBEdit119');

        if (vHabControleAlterClienteVnd) then
          if (vCodControleAlterCliente > 0) and (dataSet.FieldByName('cod_controle').AsInteger = 0) then
            if not vDadosIni.PesqPros('VND163', 'PERMITIR', dataSet.FieldByName('TIPO').AsString + ' - VENDA SEM CONTROLE', 'PEDVENDA',
              IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas, true) then
              	raiseExceptionCreate('Forma de pagamento não informada', 'DBEdit119');
      finally
        vCtrl.dataSet.Close;
        if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
          if Trim(vCliente.dataSet.FieldByName('controles_fp').AsString) <> '' then
            vCtrl._selecionaControlesFP(Trim(vCliente.dataSet.FieldByName('controles_fp').AsString));

        if not vCtrl.dataSet.Active then
          vCtrl._selecionaControlesFP('');
      end;

      buscas.Close;
      buscas.SQL.Text := 'select cod_controle from pedvenda' +
        ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' and tipo = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      if buscas.IsEmpty then
        Exit;

      vCtrlVnd := buscas.FieldByName('cod_controle').AsInteger;

  //    if vCtrlVnd <> dataSet.FieldByName('cod_controle').AsInteger then
  //      vDadosIni.GravaAuditoria('VND162', 'ALTERAR', 'ALTERAR CONTROLE ' + dataSet.FieldByName('tipo').AsString + ' ' + dataSet.FieldByName('NPED').AsString +
  //      ' ANT:' + IntToStr(vCtrlVnd) + ' NOVO:' + dataSet.FieldByName('COD_CONTROLE').AsString, 'PEDVENDA',
  //      dataSet.FieldByName('NPED').AsString, buscas);

    except
      on E: Exception do begin
        Result := False;
        Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64);
      end;
    end;
  finally
    if Assigned(ConfigPoliticaPag) then
    	FreeAndNil(ConfigPoliticaPag);
  end;
end;

