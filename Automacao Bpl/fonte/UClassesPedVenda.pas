function TPedVenda.atribuirObsAdcTpVenda: boolean;
var
	vtemp: string;
  vcampo: string;
  vvalor: string;
	vObs: string;
  I: Integer;
  vtempini: string;
  vtempfim: string;
  vcampoenc: boolean;
begin
	vcampoenc := false;
	result := true;

  try
    if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
      vObs :=
        retornaValor('select first 1 coalesce(observacao, '''') AS VALOR from tipo_vendas ' +
         ' where tipo=''OS'' and tipo_os = ' + QuotedStr(trim(dataSet.FieldByName('tipo_os').AsString)))
    else if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
      vObs :=
        retornaValor('select first 1 coalesce(observacao, '''') AS VALOR from tipo_vendas ' +
        ' where tipo=''ORC'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipo_orc').AsString)))
    else
      vObs :=
        retornaValor('select first 1 coalesce(observacao, '''') AS VALOR from tipo_vendas ' +
        ' where tipo=''REQ'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipv').AsString)));

    if Pos('[@', vObs) = 0 then
    	dataSet.FieldByName('obs_tpvenda').AsString := vObs
    else
    begin
      vtemp := vObs;
      while (Pos('[@', vtemp) > 0) and (Pos(']', vtemp) > 0) do
      begin
        vcampoenc:= false;
        vtempini := Copy(vtemp, 1, Pos('[@', vtemp) - 1);
        vtempfim := Copy(vtemp, Pos(']', vtemp) + 1, Length(vtemp) - Pos(']', vtemp));

        vcampo := Copy(vtemp, Pos('[@', vtemp), Pos(']', vtemp) + 1 - Pos('[@', vtemp));

        vvalor := '';
        if trim(vcampo) <> '' then
        begin
          vcampo := Copy(vcampo, 3, Length(vcampo) - 3);
          for I := 0 to DataSet.FieldCount - 1 do
          begin
            if UpperCase(Dataset.Fields[I].FieldName) = UpperCase(vcampo) then
            begin
              vcampoenc := true;
              if dataSet.Fields[i].DataType = ftCurrency then
                vvalor := 'R$ ' + FormatFloat('0.00', Dataset.Fields[I].AsFloat)
              else if dataSet.Fields[i].DataType = ftFloat then
              begin
                if trim(dataSet.Fields[i].EditMask) <> '' then
                  vvalor := FormatFloat(dataSet.Fields[i].EditMask, Dataset.Fields[I].AsFloat)
                else
                  vvalor := FormatFloat('0.00', Dataset.Fields[I].AsFloat);
              end
              else if dataSet.Fields[i].DataType = ftInteger then
                vvalor := IntToStr(Dataset.Fields[I].AsInteger)
              else if not Dataset.Fields[I].IsNull then
              begin
                if dataSet.Fields[i].DataType = ftDateTime then
                  vvalor := FormatDateTime('dd/mm/yyyy', Dataset.Fields[I].AsDateTime)
                else if dataSet.Fields[i].DataType = ftDate then
                  vvalor := FormatDateTime('dd/mm/yyyy', Dataset.Fields[I].AsDateTime)
                else if dataSet.Fields[i].DataType = ftString then
                  vvalor := trim(Dataset.Fields[I].AsString)
                else
                  vvalor := Dataset.Fields[I].Value;
              end;
              Break;
            end;
          end;

          if not vcampoenc then
            vvalor := '[@' + vcampo + ']';
        end;

        vtemp := vtempini + vvalor + vtempfim;
      end;

      dataSet.FieldByName('obs_tpvenda').AsString := vtemp;
    end;
  except
    on e: exception do
    begin
    	Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('TPedVenda.atribuirObsAdcTpVenda. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.atualizaAgendamento: Boolean;
var
  vdtG: TDateTime;
begin
  Result := True;

  if dataSet.FieldByName('cod_agendamento').AsInteger = 0 then
    Exit;

  Result := False;

  vdtG := vDadosIni.getDataBanco(buscas);

  try
    buscas.Close;
    buscas.SQL.Text := 'update agendamento' +
      ' set cod_finalizacao = 6' +
      ', data_finalizacao = :data_finalizacao' +
      ', status = ''FINALIZADO''' +
      ', nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ', tipo_ped = ' + QuotedStr(Trim(dataSet.FieldByName('tipo').AsString)) +
      ' where cod_agendamento = ' + IntToStr(dataSet.FieldByName('COD_AGENDAMENTO').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and coalesce(nped, 0) = 0';
    buscas.ParamByName('data_finalizacao').AsDate := vdtG;
    buscas.ExecSQL;

    Result := True;

    if vDadosIni.vEmp.vUsarTelevenda = 'S' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select associar_cart_vnd_tlv from empresa' +
        ' where cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      if Trim(buscas.FieldByName('associar_cart_vnd_tlv').AsString) = 'S' then
      begin
        buscas.close;
        buscas.SQL.Text := 'update clientes set cod_vendedor = ' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger) +
          ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
          ' and coalesce(cod_vendedor, 0) = 0 and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
      end;
    end;

    vDadosIni.GravaAuditoria('CRM014', 'FINALIZAR', 'SUCESSO AO FECHAR A VENDA', 'AGENDAMENTO', dataSet.FieldByName('cod_agendamento').AsString, buscas);
  except
    on e: exception do begin
      registraErro('TPedVenda.atualizaAgendamento. Erro: ' + e.Message);
      vDadosIni.GravaAuditoria('CRM014', 'FINALIZAR', 'FALHA AO FECHAR A VENDA', 'AGENDAMENTO', dataSet.FieldByName('cod_agendamento').AsString, buscas);
    end;
  end;

end;

function TPedVenda.atualizaCustoMercadorias: Boolean;
begin
  Result := True;
  try
    vItProd.dataSet.DisableControls;
    vDadosIni.abreStatusProcessamento('', 'Atualizando custos..');
    vItProd.dataSet.first;
    while not vItProd.dataSet.Eof do
    begin
      if (vItProd.dataset.Fieldbyname('NPED').AsInteger = dataset.fieldbyname('NPED').AsInteger) and
        (vItProd.dataset.Fieldbyname('STATUS').AsString <> 'CANCELADO') then
      begin
        try
          buscas.Close;
          buscas.SQL.Text := 'select prec_cusm_prod from produtos' +
            ' where grupo_prod = ' + IntToStr(vItProd.dataSet.FieldByName('grupo_prod').AsInteger) +
            ' and cod_prod = ' + QuotedStr(vItProd.dataSet.FieldByName('cod_prod').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.Open;

          if (vItProd.dataSet.FieldByName('pcust_mc').AsFloat <> buscas.FieldByName('prec_cusm_prod').AsFloat) then
          begin
            vItProd.dataSet.Edit;
            vItProd.dataSet.FieldByName('pcust_mc').AsFloat := buscas.FieldByName('prec_cusm_prod').AsFloat;
            vItProd.dataSet.Post;
          end;
        except on E: Exception do
          begin
            Result := False;
            vItProd.dataSet.Cancel;
            Application.MessageBox(pchar('Erro ao atualizar custo das mercadorias. Erro: ' + e.Message), 'Erro', 64);
            Exit;
          end;
        end;
      end;
      vItProd.dataSet.Next;
    end;
  finally
    vItProd.dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVenda.atualizarLembreteAgenda(nped: Integer; pstatus: string): Boolean;
var
	vDataBanco: TDateTime;
  vHoraBanco: string;
begin
  // Grava lembrete na agenda_oficina
  if ((vSing.vTipoVenda = 'OS') and (vDadosIni.vEmp.vAgendaOficina = 'S')) then
  begin
    vDataBanco := vDadosIni.getDataBanco(buscas);
    vHoraBanco := FormatDateTime('hh:mm:ss', vDadosIni.getDataHoraBanco(buscas));

    buscas.Close;
    buscas.SQL.Text := 'UPDATE AGENDA SET STATUS_AGENDA = :STATUS_AGENDA ' +
      ' WHERE COD_EMPRESA = :COD_EMPRESA AND NPED = :NPED';
    buscas.ParamByName('STATUS_AGENDA').AsString := pstatus;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('NPED').AsInteger := nped;
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := ' SELECT NPED FROM LEMBRETE_AGENDA ' +
      ' WHERE NPED = :NPED AND COD_EMPRESA = :COD_EMPRESA ';
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('NPED').AsInteger := nped;
    buscas.Open;

    if buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO LEMBRETE_AGENDA (NPED, COD_EMPRESA, DATA, HORA, LEMBRETE, STATUS_OS, ATIVO) ' +
        ' VALUES (:NPED, :COD_EMPRESA, :DATA, :HORA, :LEMBRETE, :STATUS_OS, :ATIVO);';
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := ' UPDATE LEMBRETE_AGENDA SET DATA = :DATA, ' +
       ' HORA = :HORA, LEMBRETE = :LEMBRETE, STATUS_OS = :STATUS_OS, ATIVO = :ATIVO ' +
       ' WHERE NPED = :NPED AND COD_EMPRESA = :COD_EMPRESA; ';
    end;
    buscas.ParamByName('NPED').AsInteger := nped;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('DATA').AsDateTime := vDataBanco;
    buscas.ParamByName('HORA').AsString := vHoraBanco;
    buscas.ParamByName('LEMBRETE').AsString := 'OS - ' + IntToStr(nped);
    buscas.ParamByName('STATUS_OS').AsString := pstatus;
    buscas.ParamByName('ATIVO').AsInteger := 1;
    buscas.ExecSQL;
  end;
end;

