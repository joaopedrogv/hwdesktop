function TPedidosAutorizacaoFinanceiro.autorizarOuNaoAutorizarPedidos(pAutorizar, pApenasSelecionadas: Boolean): Boolean;
var
  vListaAutorizacao: TStringList;
  I: Integer;
  vTexto, vTipoAutorizacao: string;
  vOK, vCadPedVendaCriado, vFecharPedido: Boolean;
  vPedVenda: TPedVenda;
  vCadPedVendaTipo: string;
  confS: TConfig_sistema_class;
  vVerificarLimiteCredito: string;
  vVerificarDebitoAtraso: string;
  vAgruparVerificacao: string;
  vListaClientesDebito: TStringList;
  vListaClientesLimite: TStringList;
  vListaNumPedDebito: TStringList;
  vListaNumPedLimite: TStringList;
  vClientes: string;
begin
	try
    if dataSet.IsEmpty then
      Exit;

    if not vDadosIni.validarAcessoCadastrosEmpresas('PEDIDO_VENDA', 'A', buscas) then
      Exit;

    if pAutorizar then
    begin
      if not vDadosIni.pESQPROS('VND168', 'AUTORIZAR', '','PEDVENDA', '', buscas, True) then
        Exit;

      buscas.Close;
      buscas.SQL.Text := 'select vnd_fech_depois_de_aut from empresa' +
                         ' where cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      vFecharPedido := buscas.FieldByName('vnd_fech_depois_de_aut').AsString = 'S';
  //    vCadPedVendaCriado := FOwner <> nil;
  //    if vCadPedVendaCriado then
  //      if FOwner.dataSet.State in [dsEdit, dsInsert] then
  //      begin
  //        Application.MessageBox('Tela de Vendas ou Orçamentos aberta. Feche para continuar', 'Atenção', MB_ICONEXCLAMATION + MB_OK);
  //        Exit;
  //      end
  //      else
  //        vCadPedVendaTipo := FOwner.getTipoVenda;
    end;

    if not pAutorizar then
      if not vDadosIni.pESQPROS('VND169', 'NAO AUTORIZAR', '','PEDVENDA', '', buscas, True) then
        Exit;

    if pAutorizar then
    begin
      vTexto := 'autorizar';
      vTipoAutorizacao := 'S';
    end
    else
    begin
      vTexto := 'não autorizar';
      vTipoAutorizacao := 'N';
    end;

    if pApenasSelecionadas then
      if Application.MessageBox(pchar('Deseja mesmo ' + vTexto + ' Pedido(s) selecionado(s)?'), 'Atenção', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        Exit;

    if not pApenasSelecionadas then
      if Application.MessageBox(pchar('Deseja mesmo ' + vTexto + ' todos Pedidos?'), 'Atenção', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        Exit;

    try
    	confS := TCfg_sis.getConf('aut_fin_conf', buscas, vDadosIni.cod_empresa);
      vVerificarLimiteCredito := UpperCase(confS.ReadString('Configuracao', 'VerificarLimiteCredito', 'N'));
      vVerificarDebitoAtraso  := UpperCase(confS.ReadString('Configuracao', 'VerificarDebitoAtraso', 'N'));
      vAgruparVerificacao     := UpperCase(confS.ReadString('Configuracao', 'AgruparVerificacao', 'N'));

      vListaClientesLimite    := TStringList.Create;
      vListaClientesLimite.Sorted := True;
    	vListaClientesLimite.Duplicates := dupIgnore;
    	vListaClientesLimite.Clear;

      vListaClientesDebito    := TStringList.Create;
      vListaClientesDebito.Sorted := True;
    	vListaClientesDebito.Duplicates := dupIgnore;
    	vListaClientesDebito.Clear;

      vListaNumPedLimite      := TStringList.Create;
      vListaNumPedLimite.Clear;

    	vListaNumPedDebito      := TStringList.Create;
      vListaNumPedDebito.Clear;

      vListaAutorizacao       := TStringList.Create;
      vListaAutorizacao.Clear;

      try
        if pApenasSelecionadas then
        begin
          dataSet.Filter := 'SEL = ''S''';
          if pAutorizar then
            dataSet.Filter := dataSet.Filter + ' and ((AUTORIZADO_FINANCEIRO = ''N'') or (AUTORIZADO_FINANCEIRO is null))'
          else
            dataSet.Filter := dataSet.Filter + ' and ((AUTORIZADO_FINANCEIRO = ''S'') or (AUTORIZADO_FINANCEIRO is null))';
          dataSet.Filtered := True;
        end;

        try

          if (pAutorizar) and (vFecharPedido) then
          begin
            vDadosIni.vtpVenda := 'REQ';
            vPedVenda := TPedVenda.create(DtmPedVenda);
          end;

          dataSet.First;
          while not dataSet.Eof do
          begin
            if (dataSet.FieldByName('sel').AsString = 'S')
              and (pAutorizar)
              and (vVerificarLimiteCredito = 'S')
              and (dataSet.FieldByName('limite_estourado').AsString = 'S') then
            begin
              if (vAgruparVerificacao = 'S') then
              begin
                if dataSet.FieldByName('USAR_LIM_LIBVND_FINAN').AsString <> 'S' then
                begin
                  vListaNumPedLimite.Add('|' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + '|' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + '|');

                  vListaClientesLimite.Add(IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger));
                end;
              end
              else
              begin
              	if dataSet.FieldByName('USAR_LIM_LIBVND_FINAN').AsString = 'S' then
                begin
                 	Application.MessageBox(pchar('Cliente com limite de crédito estourado.' + #13 + #13 +
                    'Num Ped: ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + #13 +
                    'Nome Fantasia Cliente: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + #13 +
                    'Razão Social Cliente: ' + trim(dataSet.FieldByName('RAZAO').AsString) + #13 +
                    'CPF/CNPJ Cliente: ' + trim(dataSet.FieldByName('CPFCGC').AsString) + #13 +
                    'Valor do Limite: ' + FormatFloat('0.00', dataSet.FieldByName('limite_credito').AsFloat) + #13 +
                    'Valor do Débito: ' + FormatFloat('0.00', dataSet.FieldByName('valor_debito').AsFloat) + #13 +
                    'Valor da Compra: ' + FormatFloat('0.00', dataSet.FieldByName('valor_total').AsFloat) + #13 +
                    IfThen(dataSet.FieldByName('USAR_LIM_LIBVND_FINAN').AsString = 'S', '>Cliente configurado para permitir continuar mesmo com limite estourado<' + #13, '')),
                    'Atenção', MB_ICONINFORMATION + MB_OK);
                end
                else
                begin
                  if Application.MessageBox(pchar('Cliente com limite de crédito estourado.' + #13 + #13 +
                    'Num Ped: ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + #13 +
                    'Nome Fantasia Cliente: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + #13 +
                    'Razão Social Cliente: ' + trim(dataSet.FieldByName('RAZAO').AsString) + #13 +
                    'CPF/CNPJ Cliente: ' + trim(dataSet.FieldByName('CPFCGC').AsString) + #13 +
                    'Valor do Limite: ' + FormatFloat('0.00', dataSet.FieldByName('limite_credito').AsFloat) + #13 +
                    'Valor do Débito: ' + FormatFloat('0.00', dataSet.FieldByName('valor_debito').AsFloat) + #13 +
                    'Valor da Compra: ' + FormatFloat('0.00', dataSet.FieldByName('valor_total').AsFloat) + #13 +
                    IfThen(dataSet.FieldByName('USAR_LIM_LIBVND_FINAN').AsString = 'S', '>Cliente configurado para permitir continuar mesmo com limite estourado<' + #13, '') + #13 +
                    'Deseja continuar assim mesmo?'), 'Informação', MB_ICONQUESTION + MB_YESNO) = IDNO then
                  begin
                    dataSet.Edit;
                    dataSet.FieldByName('sel').Value := Null;
                    dataSet.Post;
                  end;

                  if (dataSet.FieldByName('sel').AsString = 'S') then
                  begin
                    if not vDadosIni.PesqPros('VND048', 'PERMITIR',
                      'REQ' + ' ' +
                      'CLIENTE:' + dataSet.FieldByName('COD_CLIENTE').AsString,
                      'PEDVENDA',
                      dataSet.FieldByName('NPED').asstring, buscas, true) then
                    begin
                      dataSet.Edit;
                      dataSet.FieldByName('sel').Value := Null;
                      dataSet.Post;
                    end;
                  end;
                end;
              end;
            end;

            if (dataSet.FieldByName('sel').AsString = 'S')
            	and (pAutorizar)
            	and (vVerificarDebitoAtraso = 'S')
              and (dataSet.FieldByName('valor_debito_atraso_car').AsFloat > 0) then
            begin
              if (vAgruparVerificacao = 'S') then
              begin
                vListaNumPedDebito.Add('|' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + '|' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + '|');

              	vListaClientesDebito.Add(IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger));
              end
              else
              begin
                if Application.MessageBox(PChar('Cliente com débito em atraso.' + #13 + #13 +
                  'Num Ped: ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + #13 +
                  'Nome Fantasia Cliente: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + #13 +
                  'Razão Social Cliente: ' + trim(dataSet.FieldByName('RAZAO').AsString) + #13 +
                  'CPF/CNPJ Cliente: ' + trim(dataSet.FieldByName('CPFCGC').AsString) + #13 + #13 +
                  'Deseja continuar assim mesmo?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
                begin
                  dataSet.Edit;
                  dataSet.FieldByName('sel').Value := Null;
                  dataSet.Post;
                end;

                if (dataSet.FieldByName('sel').AsString = 'S') then
                begin
                  if not vDadosIni.PesqPros('VND157', 'PERMITIR',
                    'REQ' + ' ' +
                    'CLIENTE:' + dataSet.FieldByName('COD_CLIENTE').AsString,
                    'PEDVENDA',
                    dataSet.FieldByName('NPED').AsString, buscas, true) then
                  begin
                    dataSet.Edit;
                    dataSet.FieldByName('sel').Value := Null;
                    dataSet.Post;
                  end;
                end;
              end;
            end;

            dataSet.Next;
            Application.ProcessMessages;
          end;

          if (vAgruparVerificacao = 'S')
          	and (vVerificarLimiteCredito = 'S')
            and (vListaNumPedLimite.Count > 0) then
          begin
            vClientes := '';
            for I := 0 to vListaClientesLimite.Count - 1 do
            	vClientes := IfThen(trim(vClientes) = '', '', trim(vClientes) + ',') + vListaClientesLimite[I];

            if Application.MessageBox(PChar('Cliente(s) com limite de crédito estourado.' + #13 + #13 +
              'Cliente(s): ' + vClientes + #13 + #13 +
              'Deseja continuar assim mesmo?'), 'Informação', MB_ICONQUESTION + MB_YESNO) = IDNO then
              	Exit;

            if not vDadosIni.PesqPros('VND048', 'PERMITIR',
              'REQ', 'PEDVENDA', '', buscas, true) then
              	Exit;

            vClientes := '';
            for I := 0 to vListaNumPedLimite.Count - 1 do
            begin
            	vDadosIni.GravaAuditoria('VND048', 'PERMITIR', 'REQ - ' +
                'CLIENTE: ' + vDadosIni.getCampoPipe(vListaNumPedLimite[I], 2), 'PEDVENDA',
                vDadosIni.getCampoPipe(vListaNumPedLimite[I], 3), buscas);
            end;
            
            vDadosIni.GravaAuditoria('VND048', 'PERMITIR', 'SUCESSO', 'PEDVENDA', '', buscas);
          end;

          if (vAgruparVerificacao = 'S')
          	and (vVerificarDebitoAtraso = 'S')
            and (vListaNumPedDebito.Count > 0) then
          begin
            vClientes := '';
            for I := 0 to vListaClientesDebito.Count - 1 do
            	vClientes := IfThen(trim(vClientes) = '', '', trim(vClientes) + ',') + vListaClientesDebito[I];

          	if Application.MessageBox(PChar('Cliente(s) com débito em atraso.' + #13 + #13 +
              'Cliente(s): ' + vClientes + #13 + #13 +
              'Deseja continuar assim mesmo?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
              	Exit;

            if not vDadosIni.PesqPros('VND157', 'PERMITIR',
              'REQ', 'PEDVENDA', '', buscas, true) then
              	Exit;

            for I := 0 to vListaNumPedDebito.Count - 1 do
            begin
            	vDadosIni.GravaAuditoria('VND157', 'PERMITIR', 'REQ - ' +
                'CLIENTE: ' + vDadosIni.getCampoPipe(vListaNumPedDebito[I], 2), 'PEDVENDA',
                vDadosIni.getCampoPipe(vListaNumPedDebito[I], 3), buscas);
            end;

            vDadosIni.GravaAuditoria('VND157', 'PERMITIR', 'SUCESSO', 'PEDVENDA', '', buscas);
          end;

          dataSet.First;
          while not dataSet.Eof do
          begin
            if (dataSet.FieldByName('sel').AsString = 'S') then
            begin
              vOK := True;

              if (pAutorizar) and (vFecharPedido) then
                if vDadosIni.vEmp.vVnd_AprovacaoGerente = 'S' then
                begin
                  buscas.Close;
                  buscas.SQL.Text := 'select USAR_LIBERACAO_GERENTE from TIPO_VENDAS' +
                    ' where tipo = ''REQ'' and sigla = ' + QuotedStr(Trim(dataSet.FieldByName('tipv').AsString));
                  buscas.Open;

                  if Trim(buscas.FieldByName('USAR_LIBERACAO_GERENTE').AsString) = 'S' then
                    if dataSet.FieldByName('APROVADA_GERENTE').AsString <> 'S' then
                    begin
                      Application.MessageBox(pchar('Atenção! Venda ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
                                                   ' aguardando liberação do gerente'), 'Atenção',
                        MB_ICONEXCLAMATION + MB_OK);
                      vOK := False;
                    end;
                end;

              if vOK then
              begin

                buscas.Close;
                buscas.SQL.Text := 'update PEDVENDA set AUTORIZADO_FINANCEIRO = ' + QuotedStr(vTipoAutorizacao) +
                  ' where NPED = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
                  ' and TIPO =  ''REQ''' +
                  ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
                buscas.ExecSQL;

                buscas.Close;
                buscas.SQL.Text := 'delete from OCORRENCIAS_OS' +
                  ' where NPED = :NPED and TIPO = :TIPO and COD_EMPRESA = :COD_EMPRESA and SITUACAO = :SITUACAO';
                buscas.ParamByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
                buscas.ParamByName('TIPO').AsString := 'REQ';
                buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
                buscas.ParamByName('SITUACAO').AsString := 'FINANCEIRO';
                buscas.ExecSQL;

                if pAutorizar then
                  vDadosIni.informarSituacaoPedido(
                    dataSet.FieldByName('NPED').AsInteger, 'REQ',
                    'FINANCEIRO',
                    'Finalizado',
                    '',
                    buscas, False, False);

                if not pAutorizar then
                  vDadosIni.informarSituacaoPedido(
                    dataSet.FieldByName('NPED').AsInteger, 'REQ',
                    'FINANCEIRO',
                    'Nao Autorizado',
                    '',
                    buscas, False, False);

                if pAutorizar then
                  vListaAutorizacao.Add(IntToStr(dataSet.FieldByName('NPED').AsInteger) + '|PEDIDO N° ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + ' AUTORIZADO|')
                else
                  vListaAutorizacao.Add(IntToStr(dataSet.FieldByName('NPED').AsInteger) + '|PEDIDO N° ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + ' NAO AUTORIZADO|');

                if (pAutorizar) and (Trim(vDadosIni.vEmp.vUSAR_SEPARACAO_PED) = 'S') then
                begin
                  if vPedVenda = nil then
                  begin
                    vDadosIni.vtpVenda := 'REQ';
                    vPedVenda := TPedVenda.create(DtmPedVenda);
                    try
                      vPedVenda.verificarEnvioAutoParaSeparacao(dataSet.FieldByName('NPED').AsInteger);
                    finally
                      vPedVenda.Free;
                      vPedVenda := nil;
                    end;
                  end
                  else
                     vPedVenda.verificarEnvioAutoParaSeparacao(dataSet.FieldByName('NPED').AsInteger);
                end;

                if (pAutorizar) and (vFecharPedido) then
                begin
                  if buscas.Transaction.InTransaction then
                    buscas.Transaction.Commit;
                  vDadosIni.GravaAuditoria('VND168', 'AUTORIZAR', 'PEDIDO N° ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + ' AUTORIZADO',
                    'PEDVENDA', IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);
                  vPedVenda.abrePedVenda(dataSet.FieldByName('NPED').AsInteger);
                  confirmarVenda(vPedVenda);
                end;
              end;
            end;

            dataSet.Next;
            Application.ProcessMessages;
          end;
        finally
          if (pAutorizar) and (vFecharPedido) then
            if not vCadPedVendaCriado then
            begin
              vPedVenda.Free;
              vPedVenda := nil;
            end
            else
            begin
              vDadosIni.vtpVenda := vCadPedVendaTipo;
              vPedVenda := TPedVenda.create(DtmPedVenda);
            end;
        end;

      finally
        if pApenasSelecionadas then
        begin
          dataSet.Filtered := False;
          dataSet.Filter := '';
        end;
      end;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;

      Result := True;

      if (pAutorizar) and (not vFecharPedido) then
        for I := 0 to vListaAutorizacao.Count - 1 do
          vDadosIni.GravaAuditoria('VND168', 'AUTORIZAR', vDadosIni.getCampoPipe(vListaAutorizacao[i],2),'PEDVENDA', vDadosIni.getCampoPipe(vListaAutorizacao[i],1), buscas);

      if not pAutorizar then
        for I := 0 to vListaAutorizacao.Count - 1 do
          vDadosIni.GravaAuditoria('VND169', 'NAO AUTORIZAR', vDadosIni.getCampoPipe(vListaAutorizacao[i],2),'PEDVENDA', vDadosIni.getCampoPipe(vListaAutorizacao[i],1), buscas);

      pesquisa('CLOSE','OPEN', fAutorizados);

    except on E: Exception do
      begin
        RollBackTransacao;
        Result := False;
        Application.MessageBox(pchar('Erro ao ' + vTexto + ' pedidos. Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('TPedidosAutorizacaoFinanceiro.autorizarOuNaoAutorizarPedidos. Erro' + e.Message);
      end;
    end;
  finally
  	if Assigned(confS) then
    	FreeAndNil(confS);
   	if Assigned(vListaAutorizacao) then
    	FreeAndNil(vListaAutorizacao);
    if Assigned(vListaClientesLimite) then
      FreeAndNil(vListaClientesLimite);
    if Assigned(vListaClientesDebito) then
      FreeAndNil(vListaClientesDebito);
    if Assigned(vListaNumPedLimite) then
      FreeAndNil(vListaNumPedLimite);
  end;
end;

function TPedidosAutorizacaoFinanceiro.confirmarVenda(AOwner: TPedVenda): Boolean;
var
	vAtualizarCl: Boolean;
begin
  Result := False;

  try

    if not AOwner.Edit then
      exit;

    frmAutorizacaoFinanceiro.Caption := 'Autorização de Pedidos pelo Financeiro - Fechando pedido número: ' + IntToStr(AOwner.dataSet.FieldByName('NPED').AsInteger);
    frmAutorizacaoFinanceiro.Refresh;
    Application.ProcessMessages;

    if AOwner.getTipoVenda <> 'ORC' then
    begin
    	if (AOwner.dataSet.FieldByName('COD_CLIENTE').AsInteger > 0) then
      begin
      	AOwner.vCliente.abreClientes(AOwner.dataSet.FieldByName('COD_CLIENTE').AsInteger);
        if not AOwner.vCliente.dataSet.IsEmpty then
        begin
        	vAtualizarCl := False;

          if (vDadosIni.vEmp.vFinanceiroUnificado)
            and (vDadosIni.vEmp.vCodigoUnificadora = StrToInt(vDadosIni.codEmpresa)) then
          begin
          	if trim(AOwner.vCliente.dataSet.FieldByName('CPFCGC').AsString) <> '' then
              if (vDadosIni.negativarClientes(0, trim(AOwner.vCliente.dataSet.FieldByName('CPFCGC').AsString))) then
                vAtualizarCl := True;
          end
          else if (not vDadosIni.vEmp.vFinanceiroUnificado) then
          begin
          	if (vDadosIni.negativarClientes(AOwner.dataSet.FieldByName('COD_CLIENTE').AsInteger, '')) then
            	vAtualizarCl := True;
          end;

          if (vDadosIni.baixarRecAntValeCompra(AOwner.dataSet.FieldByName('COD_CLIENTE').AsInteger)) then
          	vAtualizarCl := True;

          if (vAtualizarCl) then
						AOwner.vCliente.dataSet.Refresh;
        end;
      end;

      if not AOwner.vCliente.dataSet.FieldByName('CODIGO_FATURAMENTO').IsNull then
        if AOwner.vCliente.faturamentoBarrado(
          AOwner.vCliente.dataSet.FieldByName('CODIGO_FATURAMENTO').AsInteger) then
        begin
          if not vDadosIni.PesqPros('VND049', 'LIBERAR',
          	AOwner.dataSet.FieldByName('TIPO').asstring + ' ' +
            'CLIENTE:' +AOwner.dataSet.FieldByName('COD_CLIENTE').asstring + ' ' + AOwner.vCliente.dataSet.FieldByName('NOME_CLIENTE').AsString,
            'PEDVENDA',
            AOwner.dataSet.FieldByName('NPED').asstring,
            AOwner.buscas,
            True) then
            	Exit
          else if Application.MessageBox('Deseja continuar a venda?', 'Confirmação', MB_YESNO +
            MB_DEFBUTTON1) = mrNO then
            	Exit;
        end;
    end;

    if AOwner.getTipoVenda = 'OS' then
    begin
      if not AOwner.vItProd.vProduto.validaEstoqueFechamento then
      begin
        Application.MessageBox('O documento não foi confirmado.', 'Informação', MB_ICONEXCLAMATION + MB_OK);
        exit;
      end;
    end;
    if AOwner.getTipoVenda = 'REQ' then
    begin
      if not AOwner.vItProd.vProduto.validaEstoqueFechamento then
      begin
        Application.MessageBox('O documento não foi confirmado.', 'Informação', MB_ICONEXCLAMATION + MB_OK);
        exit;
      end;
    end;

    if AOwner.dataSet.FieldByName('idmobile').AsInteger > 0 then
    begin
      //Checar limite de credito do cliente
      if AOwner.getTipoVenda <> 'ORC' then
      begin
        if AOwner.vCliente.limiteDeCreditoEstouradoFechamento(AOwner.dataSet.FieldByName('valor_total').AsCurrency) then
        begin
          if not vDadosIni.PesqPros('VND048', 'PERMITIR',
            AOwner.dataSet.FieldByName('TIPO').asstring + ' - ' +
          	'Cliente:' + AOwner.dataSet.FieldByName('COD_CLIENTE').asstring, 'PEDVENDA',
            AOwner.dataSet.FieldByName('NPED').asstring,
            AOwner.buscas, true) then
            	Exit;

          if Application.MessageBox(pchar('Deseja continuar a venda?'), 'Informação',
            MB_ICONQUESTION + MB_YESNO) = IDNO then
            Exit;
        end;
      end;
    end;

    Result := AOwner.confirmarVenda(False, True);

  finally
    AOwner.pedidoEmEdicao(caRemoverEdicao, False);
    frmAutorizacaoFinanceiro.Caption := 'Autorização de Pedidos pelo Financeiro';
    frmAutorizacaoFinanceiro.Refresh;
    Application.ProcessMessages;
  end;
end;

constructor TPedidosAutorizacaoFinanceiro.create;
begin
  if DtmPedVenda = nil then
    DtmPedVenda := TDtmPedVenda.create(DtmPedVenda);

  DataSet := TClientDataSet(DtmPedVenda.cdsAprovaFin);
  transacao := TIBTransaction(DtmPedVenda.IBTransPedVenda);
  Buscas := TIBQuery(DtmPedVenda.qrBuscas);
end;

procedure TPedidosAutorizacaoFinanceiro.marcaDesmarcaLinha(pTodos, pMarcar: Boolean);
begin
  if dataSet.IsEmpty then
    Exit;
  if pTodos then
  begin
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      if not pMarcar then      
        dataSet.FieldByName('SEL').AsString := ''
      else
        dataSet.FieldByName('SEL').AsString := 'S';
      dataSet.Post;
      dataSet.Next;
    end;
  end
  else
  begin
    dataSet.Edit;
    if dataSet.FieldByName('SEL').AsString = 'S' then
      dataSet.FieldByName('SEL').AsString := ''
    else
      dataSet.FieldByName('SEL').AsString := 'S';
    dataSet.Post;
  end;
end;

procedure TPedidosAutorizacaoFinanceiro.pesquisa(pDataIni, pDataFim: string; pAutorizados: Boolean; pRazaoSocial: Boolean);
var
  vSql, vOrdem, vStatus1, vStatus2: string;
begin

  if (pDataIni = 'CLOSE') and (pDataFim = 'OPEN') then
  begin
    dataSet.Close;
    dataSet.Open;
    Exit;
  end;

  fAutorizados := pAutorizados;

  vOrdem := '7, 1';
  if pRazaoSocial then
    vOrdem := '8, 1';

  if not pAutorizados then
  begin
    vStatus1 := 'pv.autorizado_financeiro is null';
    vStatus2 := 'pv.autorizado_financeiro <> ''S''';
  end
  else
  begin
    vStatus1 := 'pv.autorizado_financeiro = ''S''';
    vStatus2 := 'pv.autorizado_financeiro = ''S''';
  end;

  vSql := 'select pv.nped, pv.data_ped, pv.cod_cliente, ' +
    ' coalesce(c.limite_credito, 0) limite_credito, ' +
    ' c.usar_lim_libvnd_finan, ' +
  	' coalesce(getcrediario.valor_debito, 0) valor_debito, ' +
    ' coalesce(getcrediario.qtde_debito, 0) qtde_debito, ' +
    ' round(coalesce(getcrediario.media_debito, 0), 0) media_debito, ' +
    ' coalesce(getcrediario.valor_debito_atraso_car, 0) valor_debito_atraso_car, ' +
    ' coalesce(getcrediario.qtde_debito_atraso_car, 0) qtde_debito_atraso_car, ' +
    ' round(coalesce(getcrediario.media_debito_atraso_car, 0), 0) media_debito_atraso_car, ' +
    ' coalesce(getcrediario.valor_debito_atraso, 0) valor_debito_atraso, ' +
