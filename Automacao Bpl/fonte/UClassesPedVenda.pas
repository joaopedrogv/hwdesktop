        end;
      end
      else if not ExecutaComandosSql('SELECT COD_CLIENTE FROM CLIENTES ' +
          'WHERE COD_CLIENTE = ' + inttostr(dataSet.FieldByName('COD_CLIENTE').asInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1') then
      begin
        if vSing.vVendaRapida then
          raiseExceptioncreate('Cliente não encontrado. O Campo Cliente deve ser preenchido.', 'DBEdit67')
        else
          raiseExceptioncreate('Cliente não encontrado. O Campo Cliente deve ser preenchido.', 'DBEdit4');
      end;

    ///  //////////////////////////////////

      if dataSet.FieldByName('COD_VENDEDOR').AsInteger = 0 then
      begin
        if (getTipoVenda = 'REQ') or ((getTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
        begin
          if vSing.vVendaRapida then
            raiseExceptioncreate('Campo Vendedor não pode ser vazio', 'DBEdit70')
          else
            raiseExceptioncreate('Campo Vendedor não pode ser vazio', 'DBEdit5');
        end
        else if (getTipoVenda = 'ORC') then
        begin
          TFrmCadPedVenda(FrmCadPed).tsOS.Show;
          raiseExceptioncreate('Campo Vendedor não pode ser vazio', 'DBEdit42');
        end
        else if getTipoVenda = 'OS' then
        begin
          TFrmCadPedVenda(FrmCadPed).tsOS.Show;
          raiseExceptioncreate('Campo Recepcionista pode ser vazio', 'DBEdit42');
        end;
      end;
      if getTipoVenda = 'OS' then
        if not verPendenciaVenda(dataSet.FieldByName('COD_VENDEDOR').AsInteger, trim(dataSet.FieldByName('TIPO_OS').AsString)) then
        begin
          vNomeCampoErro := 'DBEdit42';
          exit;
        end;
      if getTipoVenda = 'REQ' then
        if not verPendenciaVenda(dataSet.FieldByName('COD_VENDEDOR').AsInteger, trim(dataSet.FieldByName('TIPV').AsString)) then
        begin
          vNomeCampoErro := 'DBEdit5';
          exit;
        end;

      if (vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'ORC') or (vSing.vTipoVenda = 'OS') then
      begin
        if (dataSet.FieldByName('COD_COND_PAG').AsInteger = 0) then
        begin
          if (vSing.vTipoVenda = 'OS')  then
          begin
          	if vUsarCondPagVenda = 'S' then
            	raiseExceptioncreate('Campo Cod. Pag. não pode ser vazio', 'DBEdit130');
          end
          else if (vSing.vTipoVenda = 'REQ') or ((getTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
          begin
            if vSing.vVendaRapida then
              raiseExceptioncreate('Campo Cod. Pag. não pode ser vazio', 'DBEdit108')
            else
              raiseExceptioncreate('Campo Cod. Pag. não pode ser vazio', 'DBEdit6');
          end
          else
          begin
            TFrmCadPedVenda(FrmCadPed).tsOS.Show;
            raiseExceptioncreate('Campo Cod. Pag. não pode ser vazio', 'DBEdit130');
          end;
        end;
      end;
      
      if (vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'ORC') or (vSing.vTipoVenda = 'OS') then
      begin
        if (dataSet.FieldByName('COD_COND_PAG').AsInteger > 0) then
          if not vCondPag.dataSet.Locate('COD_COND_PAG', dataSet.FieldByName('COD_COND_PAG').AsInteger, []) then
          begin
            if (vSing.vTipoVenda = 'REQ') or ((getTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
            begin
              if vSing.vVendaRapida then
                raiseExceptioncreate('Campo Cod. Pag. não encontrado', 'DBEdit108')
              else
                raiseExceptioncreate('Campo Cod. Pag. não encontrado', 'DBEdit6');
            end
            else
            begin
              TFrmCadPedVenda(FrmCadPed).tsOS.Show;
              raiseExceptioncreate('Campo Cod. Pag. não encontrado', 'DBEdit130');
            end;
          end;
      end;
      if (vSing.vTipoVenda = 'OS') then
        if (vDadosIni.vSugServico.vHabilitarSug) and (vDadosIni.vEmp.vUsarAparelho <> 'S') then
          if not ((dataSet.FieldByName('COD_VEICULO').AsInteger <= 0)
           and (trim(dataSet.FieldByName('CHASSI').AsString) = '') and (trim(dataSet.FieldByName('CHASSI').AsString) = '')) then
              if dataSet.FieldByName('KM_V').IsNull then
              begin
                TFrmCadPedVenda(FrmCadPed).tsOS.Show;
                raiseExceptioncreate('Campo KM Veículo deve ser preenchido.', 'DBEdit39');
              end;

      if (vSing.vTipoVenda = 'REQ') then
      begin
        {if (pos(dataSet.FieldByName('TIPV').AsString, 'VACTPO') = 0) then
        begin
          Application.MessageBox(PChar('Tipo de Venda ''' + dataSet.FieldByName('TIPV').asstring +
            ''' Incorreto'), 'Erro', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
          vNomeCampoErro:='DBComboBox1';
    //      Result := 4;
          exit;
        end;
        if (pos(dataSet.FieldByName('TIPOR').AsString, 'VPDTA') = 0) then
        begin
          Application.MessageBox(PChar('Tipo de Origem ''' + dataSet.FieldByName('TIPV').asstring +
            ''' Incorreto'), 'Erro', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          vNomeCampoErro:='DBComboBox2';
    //      Result := 5;
          exit;
        end;}
        if not ChecaTipVendaVendedor then
        begin
          vNomeCampoErro := 'DBComboBox1';
          //      Result := 6;
          exit;
        end;

        if not ChecaOrigemExiste then
        begin
          vNomeCampoErro := 'DBComboBox2';
          //      Result := 7;
          exit;
        end;
      end
      else if (vSing.vTipoVenda = 'OS') then
      begin
        {if (pos(dataSet.FieldByName('TIPO_OS').AsString, 'GARANTIA,CORTESIA,INTERNA,CLIENTE,EXTERNA') = 0) then
        begin
          Application.MessageBox(PChar('Tipo de OS ''' + dataSet.FieldByName('TIPO_OS').asstring +
            ''' Incorreto'), 'Erro', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
          vNomeCampoErro := 'DBComboBox3';
          //      Result := 3;
          exit;
        end
        else}
        if retornaValor('select tipo_os AS VALOR from' +
          ' tipo_vendas where tipo_os= ' + QuotedStr(trim(dataSet.FieldByName('TIPO_OS').AsString)) + ' and tipo=''OS''') = '' then
        begin
          TFrmCadPedVenda(FrmCadPed).tsOS.Show;
          raiseExceptioncreate('Tipo de OS não informado', 'DBComboBox3');
        end;
        if trim(dataSet.FieldByName('OBS_LIVRO_REG').AsString) = '' then
        begin
          TFrmCadPedVenda(FrmCadPed).tsOS.Show;
          raiseExceptioncreate('Observação para o livro precisa ser preenchida', 'DBEdit43');
        end;
      end
      else if (vSing.vTipoVenda = 'ORC') then
      begin
        //    if ((dataSet.FieldByName('tipo_orc').AsString <> 'T') and
        //      (dataSet.FieldByName('tipo_orc').AsString <> 'O')) then
        if not verificatipoorc(trim(dataSet.FieldByName('tipo_orc').AsString)) then
        begin
          if vSing.vOrcamentoSoPecas then
            raiseExceptioncreate('Tipo de Orçamento inválido', 'DBComboBox9')
          else
          begin
            TFrmCadPedVenda(FrmCadPed).tsOS.Show;
            raiseExceptioncreate('Tipo de Orçamento inválido','DBComboBox5');
          end;
        end;
        //    if not vSing.vOrcamentoSoPecas then
        //      if not verificaColaboradorProdutos(false, true) then
        //      begin
        //        vNomeCampoErro := vItProd.vNomeCampoErro;
        //        vItProd.vNomeCampoErro := '';
        //        exit;
        //      end;
      end;
      if not verificarServicos then
        exit;

      if (dataSet.FieldByName('cod_cliente').AsInteger <> StrToIntDef(vDadosIni.vCliente.vCodClientePadrao, 0)) or
        (Trim(dataSet.FieldByName('nome_cli_orc').AsString) = '') then
      begin
        dataSet.FieldByName('CPFCGC').AsString          := vCliente.dataSet.FieldByName('CPFCGC').AsString;
        dataSet.FieldByName('NOME_CLIENTEDAV').AsString := vCliente.dataSet.FieldByName('NOME_CLIENTE').AsString;
      end
      else
        dataSet.FieldByName('NOME_CLIENTEDAV').AsString := dataSet.FieldByName('NOME_CLI_ORC').AsString;
      if trim(dataSet.FieldByName('stat_req').AsString) = '' then
        dataSet.FieldByName('stat_req').AsString := 'B';
      result := true;
    finally
    	if Assigned(ConfigPoliticaPag) then
      	FreeAndNil(ConfigPoliticaPag);
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

