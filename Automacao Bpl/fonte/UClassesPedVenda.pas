function TPedVenda.osVinculadasNFSE: string;
begin
	try
    Result := '';
    buscas.Close;
    buscas.SQL.Text := 'SELECT P.NPED FROM PEDVENDA P WHERE P.TIPO = ''OS'' AND P.COD_EMPRESA = :COD_EMPRESA '+
  	'AND P.NUM_NFEEXT = :NUM_NFEEXT AND EXTRACT(YEAR FROM P.DATA_NFEXT) = :ANO';
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
		buscas.ParamByName('NUM_NFEEXT').AsString := dataSet.FieldByName('NUM_NFEEXT').AsString;
		buscas.ParamByName('ANO').AsWord := YearOf(dataSet.FieldByName('DATA_NFEXT').AsDateTime);
    buscas.Open;

    if buscas.IsEmpty then
    	Exit;

    buscas.First;
    while not buscas.Eof do
    begin
      Result := Result + '|' + buscas.FieldByName('NPED').AsString + '|';
      buscas.Next;
    end;

    Result := StringReplace(Result, '||', ',', [rfReplaceAll]);
    Result := StringReplace(Result, '|', '', [rfReplaceAll]);
  except on E: Exception do
  	Result := '';
  end;
end;

function TPedVenda.outroUsuarioEditando(pMensagem: Boolean;
  pCancelUpdatesRollback: Boolean; pDeixarEditando: Boolean): Boolean;
var
  vCodigo: Integer;
begin
  Result := False;
  if (Trim(dataSet.FieldByName('SAVEAUTO').AsString) = 'S')
  	and (Trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'CANCELADO') then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select us_edit from pedvenda' +
      ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
      ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
    buscas.Open;

    vCodigo := buscas.FieldByName('us_edit').AsInteger;

    Result := (vCodigo > 0) and (vCodigo <> vDadosIni.vCodUsuario);

    if not Result then
      Exit;

    fEmEdicaoSaveAuto := False;

    if pCancelUpdatesRollback then
    begin
      dataSet.Cancel;
      dataSet.CancelUpdates;
      vItProd.dataSet.Cancel;
      vItProd.dataSet.CancelUpdates;
      if getTipoVenda <> 'REQ' then
      begin
        vItServ.dataSet.Cancel;
        vItProdTerc.dataSet.Cancel;
        vItServTerc.dataSet.Cancel;
        vItServ.CancelUpdates;
        vItProdTerc.CancelUpdates;
        vItServTerc.CancelUpdates;
      end;
      RollBackTransacao;
      if pDeixarEditando then
        dataSet.Edit;
    end;

    if pMensagem then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select nome_vendedor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(vCodigo) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
      buscas.Open;
      
      Application.MessageBox(PChar('Outro usuário também está alterando este registro' + #13 +
        'Usuário: ' + IntToStr(vCodigo) + ' - ' + Trim(buscas.FieldByName('nome_vendedor').AsString) + #13 + #13 +
        'As suas alterações não serão salvas!' + #13 +
        'Verifique com o outro usuário ou aguarde ele terminar as alterações'), 'Atenção', 0 + 64);
    end;
  end;
end;

