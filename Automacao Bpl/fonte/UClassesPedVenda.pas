      else
        buscas.SQL.Text :=
          ' select os.nped from pedvenda os,pedvenda_serv it' +
          ' where it.nped = os.nped and it.tipo = os.tipo and ' +
          ' os.em_nf = ''S'' and (os.ncupom = 0 or os.ncupom is null) and (it.n_nf = 0 or it.n_nf is null) and ' +
          ' (os.num_nfeext = 0 or os.num_nfeext is null) and (it.VALOR_TOT_SERV <> 0) and os.data_fech >= ' +
          QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataInicial))) +
          ' and os.data_fech <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataFinal))) + ' and os.tipo = ''OS'' and os.cod_empresa = it.cod_empresa' +
          ' and os.cod_empresa = ' + vDadosIni.codEmpresa + ' and os.ativo=1' +
          ' and coalesce(os.status_ped, '''') <> ''CANCELADO''';
    end
    else
    begin
      buscas.close;
      if (vdadosini.vImpOSMarcadaLivReg <> 'S') then
        buscas.SQL.Text :=
          ' select os.nped from pedvenda os,pedvenda_serv it' +
          ' where it.nped = os.nped and it.tipo = os.tipo and ' +
          ' (os.ncupom = 0 or os.ncupom is null) and (it.n_nf = 0 or it.n_nf is null) and ' +
          ' os.data_fech >= ' +
          QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataInicial))) +
          ' and os.data_fech <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataFinal))) + ' and os.tipo = ''OS'' and os.cod_empresa = it.cod_empresa' +
          ' and os.cod_empresa = ' + vDadosIni.codEmpresa + ' and os.ativo=1' +
          ' and coalesce(os.status_ped, '''') <> ''CANCELADO'''
      else
        buscas.SQL.Text :=
          ' select os.nped from pedvenda os,pedvenda_serv it' +
          ' where it.nped = os.nped and it.tipo = os.tipo and ' +
          ' os.em_nf = ''S'' and (os.ncupom = 0 or os.ncupom is null) and (it.n_nf = 0 or it.n_nf is null) and ' +
          ' os.data_fech >= ' +
          QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataInicial))) +
          ' and os.data_fech <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', StrToDate(dataFinal))) + ' and os.tipo = ''OS'' and os.cod_empresa = it.cod_empresa' +
          ' and os.cod_empresa = ' + vDadosIni.codEmpresa + ' and os.ativo=1' +
          ' and coalesce(os.status_ped, '''') <> ''CANCELADO''';
    end;
    buscas.open;
    if not buscas.isempty then
    begin
      osPend := '';
      i := 0;
      while not buscas.Eof do
      begin
        if not (pos(vdadosini.strzero(buscas.FieldByName('NPED').asinteger, 5), ospend) > 0) then
        begin
          if ospend = '' then
