function TPedVendaServ.checaValoresItens: boolean;
var
  valorUnitario: Currency;
begin
  result := false;
  try
    if dataSet.FieldByName('QUANT_SERV_PED').AsFloat <= 0 then
      raiseExceptioncreate('Campo Quantidade deve ser preenchido.' + chr(13) + 'Favor Verificar.', 'DBEdit57');

    if (dataSet.FieldByName('VALOR_UN_SERV').AsFloat <= 0) and
      (dataSet.FieldByName('PRC_INT_SERV').AsFloat <= 0) then
      if not vDadosIni.PesqPros('VND178', 'SALVAR', dataSet.FieldByName('TIPO').AsString + ' - ' +
      	'SERV.: ' + dataSet.FieldByName('COD_SERVICO').AsString, 'PEDVENDA_SERV',
        dataSet.FieldByName('NPED').AsString+'-'+dataSet.FieldByName('NITEM').AsString, buscas, true) then
      raiseExceptioncreate('Campo Valor Unitário deve ser preenchido.' + chr(13) + 'Favor Verificar.', 'DBEdit58');

    if (dataSet.FieldByName('VALOR_UN_SERV').AsFloat > 0) then
    begin
      dataSet.FieldByName('VALOR_UN_SERV').AsCurrency := StrToCurr(vDadosIni.tirapontos(format('%8.' +
        vSing.vCasasDecimais + 'n',
        [dataSet.FieldByName('VALOR_UN_SERV').AsCurrency]), StrToInt(vSing.vCasasDecimais)));
      valorUnitario := dataSet.FieldByName('VALOR_UN_SERV').ascurrency
    end
    else
    begin
      dataSet.FieldByName('PRC_INT_SERV').AsCurrency := StrToCurr(vDadosIni.tirapontos(format('%8.' +
        vSing.vCasasDecimais + 'n',
        [dataSet.FieldByName('PRC_INT_SERV').AsCurrency]), StrToInt(vSing.vCasasDecimais)));
      valorUnitario := dataSet.FieldByName('PRC_INT_SERV').ascurrency;
    end;

    dataSet.FieldByName('VALOR_TOT_SERV').AsCurrency :=
      (dataSet.FieldByName('QUANT_SERV_PED').AsFloat
      * StrToCurr(vDadosIni.tirapontos(format('%8.' + vSing.vCasasDecimais + 'n',
      [valorUnitario]), StrToInt(vSing.vCasasDecimais))));
    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

constructor TPedVendaServ.create(AOwner: TPedVenda; pDtm: TDtmPedVenda);
var
	I: Integer;
begin
	FOwner := AOwner;

  DataSet := TClientDataSet(pDtm.cdsItemServ);
  transacao := TIBTransaction(pDtm.IBTransPedVenda);
  Buscas := TIBQuery(pDtm.qrBuscas);
  vSubG := TSub_GrupoPed.create(pDtm);
  vTipServ := TTipoServicoPed.create(pDtm);
  vMecOs := TMecanicos_OS.create(pDtm);//(pDtm.cdsMecOsTemp);
  IndexFieldNames := 'NITEM';

  dtSet := TClientDataSet.Create(nil);
  dtSet.Close;
  dtSet.FieldDefs.Clear;
  for I := 0 to pDtm.cdsItemServTemp.Fields.Count - 1 do
   dtSet.FieldDefs.Add(
      pDtm.cdsItemServTemp.Fields[i].FieldName,
      pDtm.cdsItemServTemp.Fields[i].DataType,
      pDtm.cdsItemServTemp.Fields[i].Size,
      false);
  if dtSet.Tag = 0 then
  try
    dtSet.CreateDataSet;
    dtSet.Tag := 1;
  except
  end;
//  dtSet.Free;
//  dtSet := nil;
//  dtSet := TClientDataSet(pDtm.cdsItemServTemp);
//  if dtSet.active then
//    dtSet.close;
//  DtSet.CreateDataSet;

  dataSet.OnCalcFields := dataSetCalcFields;

  fTemp.Free;
  fTemp := nil;
  fTemp := TClientDataSet(pDtm.cdsTemp);
  if fTemp.active then
    fTemp.close;
  fTemp.CreateDataSet;

  dataSet.BeforePost := pedVendaServBeforePost;
  TFloatField(dataSet.FieldByName('VALOR_UN_SERV')).currency := false;
  TFloatField(dataSet.FieldByName('QUANT_SERV_PED')).currency := false;
  TFloatField(dataSet.FieldByName('VALOR_TOT_SERV')).Currency := false;
end;

procedure TPedVendaServ.dataSetCalcFields(DataSet: TDataSet);
begin
	DataSet.FieldByName('VALOR_TOT_SERV_LIQ').AsFloat := RoundTo(
  	DataSet.FieldByName('VALOR_TOT_SERV').AsFloat
    	+ IfThen(DataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat > 0, DataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat, 0) +
      		DataSet.FieldByName('ACRESC_ITEM').AsFloat
      - IfThen(DataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat > 0, DataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat, 0) -
      		DataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

  if DataSet.FieldByName('QUANT_SERV_PED').AsFloat > 0 then
    DataSet.FieldByName('VALOR_UN_SERV_LIQ').AsFloat := RoundTo(
      DataSet.FieldByName('VALOR_TOT_SERV_LIQ').AsFloat / DataSet.FieldByName('QUANT_SERV_PED').AsFloat, - StrToInt(vSing.vCasasDecimais));
end;

