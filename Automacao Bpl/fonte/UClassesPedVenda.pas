  //    ' and ativo <> 1');
end;

function TPedVenda.AbrirPedVendaATransferirouMesclar: boolean;
var
  i: integer;
begin
  result := true;
  if dtSetOrcTemp = nil then
  begin
    Application.MessageBox('Não há nenhuma venda selecionado.' + chr(13) +
      'Use a tecla de atalho [F5] para selecionar o(s) DAV(s) desejado(s).', 'Informação', MB_OK +
      MB_ICONINFORMATION);
    result := false;
    Exit;
  end;

  dtSetOrcTemp.Close;
  dtSetOrcTemp.Filtered := false;
  if vSing.vTipoVenda = 'ORC' then
    dtSetOrcTemp.Filter := 'TIPO=''ORC'''
  else
    dtSetOrcTemp.Filter := 'TIPO<>''ORC''';
  dtSetOrcTemp.Filtered := true;
  dtSetOrcTemp.Open;

  if not(vSing.vTipoVenda = 'ORC') then
  begin
    dtSetOrcTemp.First;
    while not dtSetOrcTemp.Eof do
    begin
      if not ExecutaComandosSql('select nped from pedvenda v ' +
      	' where v.nped = ' + inttostr(dtSetOrcTemp.FieldByName('NPED').AsInteger) +
        ' and v.tipo = ' + QuotedStr(dtSetOrcTemp.FieldByName('TIPO').AsString) +
        ' and v.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and v.status_ped = ''FECHADA'' ') then
      begin
        dtSetOrcTemp.Delete;
        Continue;
      end;
      dtSetOrcTemp.Next;
    end;
  end;

  vItProd.abrePedVendaProd(0);
  defineCamposItensTemp(vItProd.dataSet);
  vItProd.dtSetIt := TClientDataSet(DtmPed.cdsItemProdTemp2);
  vItProd.dtSetIt.Close;
  vItProd.dtSetIt.FieldDefs.Clear;
  vItProd.dtSetIt.FieldDefs.Add('SELEC', ftString, 1, false);
  vItProd.dtSetIt.FieldDefs.Add('QTDAMESCLAR', ftFloat, 0, false);
  vItProd.dtSetIt.FieldDefs.Add('QTDAMESCLAR_CONV', ftFloat, 0, false);
  for I := 0 to vItProd.dataset.FieldDefs.Count - 1 do
  begin
    vItProd.dtSetIt.FieldDefs.Add(
      vItProd.dataSet.FieldDefs[i].Name,
      vItProd.dataSet.FieldDefs[i].DataType,
      vItProd.dataSet.FieldDefs[i].Size,
      false);
  end;
  vItProd.dtSetIt.close;
  vItProd.dtSetIt.CreateDataSet;

  vItProd.dtSetIt.FieldByName('UNIDADE_CONV').OnGetText := GetTextdtSetItUnConv;
  vItProd.dtSetIt.FieldByName('UNIDADE_CONV').OnSetText := SetTextdtSetItUnConv;

  vItProd.dtSetIt.OnCalcFields := dtSetItProdCalcFields;

  TFloatField(vItProd.dtSetIt.FieldByName('QTDAMESCLAR')).DisplayFormat            := '#,##0.0000';
  TFloatField(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV')).DisplayFormat       := '#,##0.0000';
  TFloatField(vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM')).DisplayFormat         := '#,##0.0000';
  TFloatField(vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM_CONV')).DisplayFormat    := '#,##0.0000';
  TFloatField(vItProd.dtSetIt.FieldByName('VLUN_PED_ITEM')).DisplayFormat          := '#,##0.' +
  	vDadosIni.StrZero(0, StrToInt(vSing.vCasasDecimais));
