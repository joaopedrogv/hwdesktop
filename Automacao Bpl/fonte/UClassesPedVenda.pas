function TPedVenda.verificaCamposObrigatoriosBH(pNUM_NFEEXT: string; pAno: Word): string;
var
	vCodServico: string;
begin
	try
    Result := '';

    if vDadosIni.vEmp.vNfe.ibgeCodCidade <> 3127701 then
    begin
      Result := '';
      Exit;
    end;
    
    buscas.Close;
    buscas.SQL.Text := 'SELECT DISTINCT PS.COD_SERVICO, P.NUM_NFEEXT NUM_NFSE, P.NPED N_OS, P.COD_EMPRESA, C.NOME_CLIENTE, ' +
		'P.VALOR_NFEXT VALOR_NFSE, P.DATA_NFEXT EMISSAO_NFSE, T.CNAE_SERV CNAE, T.CTISS, T.NFS_SERVICO, T.ALIQ_ISS, C.COD_CLIENTE, ' +
		'(CASE WHEN COALESCE(C.ISS_RETIDO, 0) = 0 THEN COALESCE(T.ISS_RETIDO, 2) ELSE C.ISS_RETIDO END) ISS_RETIDO '+
		'FROM PEDVENDA P '+
		'LEFT JOIN CLIENTES C ON C.COD_CLIENTE = P.COD_CLIENTE AND C.COD_EMPRESA = P.COD_EMPRESA '+
		'LEFT JOIN PEDVENDA_SERV PS ON PS.NPED = P.NPED AND PS.TIPO = P.TIPO AND PS.COD_EMPRESA = P.COD_EMPRESA '+
		'LEFT JOIN TIPO_SERVICO T ON T.COD_SERVICO = PS.COD_SERVICO '+
		'WHERE P.NUM_NFEEXT = :NUM_NFEEXT AND EXTRACT(YEAR FROM P.DATA_NFEXT) = :ANO AND P.COD_EMPRESA = :COD_EMPRESA';

    buscas.ParamByName('NUM_NFEEXT').AsString := pNUM_NFEEXT;
    buscas.ParamByName('ANO').AsWord := pAno;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

    buscas.Open;

		if buscas.IsEmpty then
    	Exit;

    buscas.First;

    while not buscas.Eof do
    begin
      if not ((Trim(buscas.FieldByName('CNAE').AsString) = '') or (Trim(buscas.FieldByName('CTISS').AsString) = '')
      or (Trim(buscas.FieldByName('NFS_SERVICO').AsString) = '') or (Trim(buscas.FieldByName('ALIQ_ISS').AsString) = '')) then
      begin
        buscas.Next;
        Continue;
      end;

      if Pos(buscas.FieldByName('COD_SERVICO').AsString, vCodServico) <> 0 then
      begin
        buscas.Next;
        Continue;
      end;

      vCodServico := vCodServico + '|' + buscas.FieldByName('COD_SERVICO').AsString + '|';
      buscas.Next;
    end;

    vCodServico := StringReplace(vCodServico, '||', ',', [rfReplaceAll]);
    vCodServico := StringReplace(vCodServico, '|', '', [rfReplaceAll]);

    Result := vCodServico;
  except on E: Exception do
  begin
  	Result := '';
    registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;
  end;
end;

function TPedVenda.verificaColaboradorProdutos(Colab1, Colab2: boolean;pTodososRegistros:boolean=false): boolean;
var
  vSqltemp:string;
begin
  if Colab1 then
  begin
    vColab.IndexFieldNames := 'COD_VENDEDOR';
    vColab.FindNearest([vItProd.dataSet.FieldByName('COD_VENDEDOR').AsInteger]);
    if vItProd.dataSet.RecordCount > 0 then
    if vColab.dataSet.FieldByName('COD_VENDEDOR').AsInteger <>
      vItProd.dataSet.FieldByName('COD_VENDEDOR').AsInteger then
    begin
      Application.MessageBox(pchar('Colaborador não encontrado'), 'Atenção', MB_ICONEXCLAMATION +
        MB_OK);
      if vSing.vTransProdOS then
        vItProd.vNomeCampoErro := 'DBedit121'
      else
      begin
        if vSing.vTipoVenda = 'OS' then
          vItProd.vNomeCampoErro := 'DBedit54'
        else if vSing.vTipoVenda = 'REQ' then
          vItProd.vNomeCampoErro := 'DBedit129';
      end;
      Result := false;
      exit;
    end;
    if (vSing.vTipoVenda <> 'REQ') and (not vSing.vOrcamentoSoPecas) then
    begin
      if (trim(vSing.vTipoVenda) = 'OS') then
        vSqltemp:='select tv.verifica_funccolab_itos from tipo_vendas tv '+
        ' where tv.tipo='+ QuotedStr(trim(dataSet.FieldByName('TIPO').AsString))+
        ' and coalesce(tv.verifica_funccolab_itos,'''')=''N'' '+
        ' and tv.TIPO_OS='+ QuotedStr(trim(dataSet.FieldByName('TIPO_OS').AsString))
      else vSqltemp:='select tv.verifica_funccolab_itos from tipo_vendas tv '+
        ' where tv.tipo='+ QuotedStr(trim(dataSet.FieldByName('TIPO').AsString))+
        ' and coalesce(tv.verifica_funccolab_itos,'''')=''N'' '+
        ' and tv.SIGLA='+ QuotedStr(trim(dataSet.FieldByName('TIPO_ORC').AsString));
      if not ExecutaComandosSql(vSqltemp) then
      begin
        if pTodososRegistros then
        begin
          vItProd.dataSet.DisableControls;
          vItProd.dataSet.First;
          while not vItProd.dataSet.eof do
          begin
            vColab.IndexFieldNames := 'COD_VENDEDOR';
            vColab.FindNearest([vItProd.dataSet.FieldByName('COD_VENDEDOR').AsInteger]);
            if trim(vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO'  then
            begin
              vItProd.dataSet.next;
              Continue;
            end;
            if not (pos('VENDEDOR', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) then
            begin
              Application.MessageBox(pchar('O colaborador já informado para o item '+
               vItProd.dataSet.FieldByName('NITEM').AsString+ ' do pedido não é um Vendedor!'+chr(13)+'Nesta situação não é permitido a alteração do tipo.'), 'Atenção',
                MB_ICONEXCLAMATION +
                MB_OK);
              if vSing.vTransProdOS then
                vItProd.vNomeCampoErro := 'DBedit121'
              else
              begin
                if (vSing.vTipoVenda = 'OS') then
                  vItProd.vNomeCampoErro := 'DBComboBox3'//'DBedit54'
                else if (vSing.vTipoVenda = 'ORC') then
                  vItProd.vNomeCampoErro := 'DBComboBox5'
                else if vSing.vTipoVenda = 'REQ' then
                  if vSing.vVendaRapida then
                    vNomeCampoErro := 'DBedit70'
                  else
                    vItProd.vNomeCampoErro := 'DBedit129';
              end;
              Result := FALSE;
              Exit;
            end;
            vItProd.dataSet.Next;
          end;
          vItProd.dataSet.EnableControls;
        end
        else
        if not (pos('VENDEDOR', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) then
        begin
          Application.MessageBox(pchar('O colaborador não é um Vendedor!'), 'Atenção',
            MB_ICONEXCLAMATION +
            MB_OK);
          if vSing.vTransProdOS then
            vItProd.vNomeCampoErro := 'DBedit121'
          else
          begin
            if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
              vItProd.vNomeCampoErro := 'DBedit54'
            else if vSing.vTipoVenda = 'REQ' then
              if vSing.vVendaRapida then
                vNomeCampoErro := 'DBedit70'
              else
                vItProd.vNomeCampoErro := 'DBedit129';
          end;
          Result := FALSE;
          Exit;
        end;
      end;
    end;
    Result := true;
    if not (vItProd.dataSet.State in [dsInsert, dsEdit]) then
      Exit;
    vItProd.dataSet.FieldByName('nome_vend').AsString :=
      vColab.dataSet.FieldByName('NOME_VENDEDOR').AsString;
  end;
  if Colab2 then //if Colab1ou2ou3 = 2 then
  begin
    vColab.IndexFieldNames := 'COD_VENDEDOR';
    vColab.FindNearest([vItProd.dataSet.FieldByName('COL_COD_VENDEDOR').AsInteger]);
    if vColab.dataSet.FieldByName('COD_VENDEDOR').AsInteger <>
      vItProd.dataSet.FieldByName('COL_COD_VENDEDOR').AsInteger then
    begin
      //      Application.MessageBox(pchar('Colaborador não encontrado'), 'Atenção', MB_ICONEXCLAMATION +
      //        MB_OK);
      if vDadosIni.vEmp.vUsarAparelho = 'S' then
        Application.MessageBox(pchar('Técnico não encontrado'), 'Atenção', MB_ICONEXCLAMATION +
          MB_OK)
      else
        Application.MessageBox(pchar('Mecânico não encontrado'), 'Atenção', MB_ICONEXCLAMATION +
          MB_OK);
      if vSing.vTransProdOS then
        vItProd.vNomeCampoErro := 'DBedit120'
      else
        vItProd.vNomeCampoErro := 'DBedit45';
      Result := false;
      exit;
    end;
    //    if vEmp.dataSet.FieldByName('DADVAP').AsString = 'SIM' then
    if vDadosIni.vEmp.vUsarAparelho = 'S' then
    begin
      if (pos('TECNICO', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) or
        (pos('TÉCNICO', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) then
      else
      begin
        Application.MessageBox(pchar('O colaborador não é um Técnico!'), 'Atenção',
          MB_ICONEXCLAMATION +
          MB_OK);
        if vSing.vTransProdOS then
          vItProd.vNomeCampoErro := 'DBedit120'
        else
          vItProd.vNomeCampoErro := 'DBedit45';
        Result := FALSE;
        Exit;
      end;
    end
    else
    begin
      if (pos('MECANICO', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) or
        (pos('MECÂNICO', vColab.dataSet.FieldByName('desc_funcao').asstring) > 0) then
      else
      begin
        Application.MessageBox(pchar('O colaborador não é um Mecânico'), 'Atenção',
          MB_ICONEXCLAMATION +
          MB_OK);
        if vSing.vTransProdOS then
          vItProd.vNomeCampoErro := 'DBedit120'
        else
          vItProd.vNomeCampoErro := 'DBedit45';
        Result := FALSE;
        Exit;
      end;
    end;
    Result := true;
    if not (vItProd.dataSet.State in [dsInsert, dsEdit]) then
      Exit;
    vItProd.dataSet.FieldByName('nome_vend1').AsString :=
      vColab.dataSet.FieldByName('NOME_VENDEDOR').AsString;
  end;
  //     vItProd.dataSet.next;
  //  end;
end;

