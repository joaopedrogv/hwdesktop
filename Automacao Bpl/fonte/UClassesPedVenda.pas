function TPedVendaServ.buscaServico(codigo: integer): boolean;
begin
  if not (dataSet.State in [dsInsert, dsEdit]) then
    exit;

  if Trim(dataSet.FieldByName('COD_SERVICO').AsString) <> '' then
  begin
    dataSet.FieldByName('DESC_SERV_PED').AsString :=
      vTipServ.dataSet.FieldByName('DESC_SERVICO').AsString;
    if (dataSet.FieldByName('CODIGO_NOP').AsFloat = 0) and
      (vTipServ.dataSet.FieldByName('CODIGO_NOP').AsFloat <> 0) then
      dataSet.FieldByName('CODIGO_NOP').AsFloat := vTipServ.dataSet.FieldByName('CODIGO_NOP').AsFloat
    else
    if (dataSet.FieldByName('CODIGO_NOP').AsFloat = 0) and (vDadosIni.vEmp.vCfopPadraoServ <> 0) then
      {(venda.vEmp.dataSet.FieldByName('CFOP_PAD_SERV').AsFloat <> 0) then}
      dataSet.FieldByName('CODIGO_NOP').AsFloat := vDadosIni.vEmp.vCfopPadraoServ;
        //        venda.vEmp.dataSet.FieldByName('CFOP_PAD_SERV').AsFloat
//    else
//      dataSet.FieldByName('CODIGO_NOP').AsFloat := 5933;
    if vTipServ.dataSet.FieldByName('SHONDA').value = 'S' then
    begin
      dataSet.FieldByName('PRC_INT_SERV').AsCurrency :=
        vTipServ.dataSet.FieldByName('VALOR_SERVICO').AsCurrency;
      dataSet.FieldByName('VALOR_UN_SERV').AsCurrency := 0;
    end
    else
    begin
      dataSet.FieldByName('VALOR_UN_SERV').AsCurrency :=
        vTipServ.dataSet.FieldByName('VALOR_SERVICO').AsCurrency;
      dataSet.FieldByName('PRC_INT_SERV').AsCurrency := 0;
      FvalorUnitarioServ := vTipServ.dataSet.FieldByName('VALOR_SERVICO').AsCurrency;
    end;
    dataSet.FieldByName('TMO_SERV').AsFloat := vTipServ.dataSet.FieldByName('TMO').AsFloat;
    dataSet.FieldByName('aliq_iss').AsFloat := vTipServ.dataSet.FieldByName('aliq_iss').AsFloat;
    dataSet.FieldByName('csdecvlunt').AsString := vTipServ.dataSet.FieldByName('csdecvlunt').AsString;
    dataSet.FieldByName('sit_trib').AsString := 'S';
    Result := true;
  end
  else
  begin
    messagedlg('Servico não encontrado', mtinformation, [mbOK], 0);
    Result := false;
  end;
end;

procedure TPedVendaServ.CalculaValorTotalItens;
begin
  vTotalServBruto := 0;
  vTotalServLiq := 0;
  vSing.vValorAcrescimoItServ := 0;
  vSing.vValorDescontoItServ := 0;
  vSing.vValorServLiquido := 0;

  nItem := 0;
  if vSing.vTipoVenda = 'REQ' then
    exit;
  dtSet.First;
  while not dtSet.Eof do
  begin
    if trim(dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
    begin
      vTotalServBruto := vTotalServBruto + dtSet.FieldByName('VALOR_TOT_SERV').AsCurrency;
      vTotalServLiq := vTotalServLiq + dtSet.FieldByName('VALOR_TOT_SERV').AsCurrency +
        dtSet.FieldByName('RATEIO_ACRESC').AsCurrency - dtSet.FieldByName('RATEIO_DESC').AsCurrency;
      vSing.vValorAcrescimoItServ := vSing.vValorAcrescimoItServ + dtSet.FieldByName('ACRESC_ITEM').AsFloat;
      vSing.vValorDescontoItServ := vSing.vValorDescontoItServ + dtSet.FieldByName('DESC_ITEM').AsFloat;
      vSing.vValorServLiquido := vTotalServLiq + vSing.vValorDescontoItServ;
    end;
    inc(nItem);
    dtSet.Next;
  end;
end;

function TPedVendaServ.Cancel: boolean;
var
	item: Integer;
	vProcessoExcluir: Boolean;
  vRecNoItem: Integer;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    dataSet.Cancel;
    Result := true;
  end
  else if dataSet.State = dsBrowse then
  begin
    if not FOwner.CancelarVariosItens then
