  if pNPED <> 0 then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select status_ped,status_cupom,nped,NCUPOM,dia_cxl, n_nfd from pedvenda where tipo =' + QuotedStr(pTipo) +
      ' and nped = ' + inttostr(pNPED) +
