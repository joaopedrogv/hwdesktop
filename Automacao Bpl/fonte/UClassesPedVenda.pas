function TMontarPedido.montarPedido(ProgressBar: TProgressBar): boolean;
var
	APedVenda: TReg_PedVenda;
	vQtdePedido: Integer;
  vIncItens: Integer;
  vIncPedido: Integer;
  fTemp: TClientDataSet;
  I: Integer;
  vpergunta: string;

  function InserirPedVenda(var APedVenda: TReg_PedVenda): Boolean;
  var
  	vbuscasTmp: TIBQuery;
    vReq, vPreVenda, vDav: Integer;
  begin
  	try
    	Result := True;

      vbuscasTmp := TIBQuery.Create(Application);
      vbuscasTmp.Database := buscas.Database;
      vbuscasTmp.Transaction := buscas.Transaction;

      try

        if not Assigned(APedVenda) then
          APedVenda := TReg_PedVenda.create;

        vReq := Gencodigo('REQVENDA', vbuscasTmp, vDadosIni.codEmpresa);
        vPreVenda := 0;
        vDav := 0;

        with APedVenda do
        begin
          nped             := vReq;
          if vDav > 0 then
            nprevenda :=	vDav;
          if vPreVenda > 0 then
            pafnumprevenda :=	vPreVenda;
          tipo             := 'REQ';
          cod_cliente      := vCodCliente;
          cod_vendedor     := vCodVendedor;
          valor_total      := 0;
          cod_cond_pag     := vCodCondPag;
          data_ped         := vDadosIni.getDataBanco(vbuscasTmp);

          acrescimo        := 0;
          desconto         := 0;
          obs_ped          := vDadosIni.vEmp.vMensagem;
          tipv             := vTipoVenda;
          horaabertura     := HourOf(data_ped);
          minabertura      := MinuteOf(data_ped);

          tot_prod         := 0;
          tot_serv         := 0;
          tot_prod_terc    := 0;
          tot_serv_terc    := 0;
          valor_total      := 0;

          SqlOpen(' select cod_cliente, cpfcgc, nome_cliente from clientes ' +
            ' where cod_cliente = ' + IntToStr(vCodCliente) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa, vbuscasTmp);
          cpfcgc           := trim(vbuscasTmp.FieldByName('cpfcgc').AsString);
          nome_clientedav  := trim(vbuscasTmp.FieldByName('nome_cliente').AsString);
          nome_cli_orc     := trim(vbuscasTmp.FieldByName('nome_cliente').AsString);


          SqlOpen(' select venda, gerar_pontos from tipo_vendas ' +
            ' where tipo = ''REQ'' ' +
            ' and sigla = ' + QuotedStr(vTipoVenda), vbuscasTmp);
          tp_gerar_pontos  := vbuscasTmp.FieldByName('gerar_pontos').AsString;
          tp_venda         := vbuscasTmp.FieldByName('venda').AsString;
          vale_troca       := 'N';

          ativo            := 1;
        end;

        if APedVenda.cod_cliente > 0 then
        begin
          with SqlOpen(
            ' select cl.cod_cliente, cl.nome_cliente, cl.razao, cl.cpfcgc, cl.fone_cliente, cl.email, cl.endereco, ' +
            ' cl.num_end_cliente, cl.complemento, cl.bairro, cl.cidade, cl.cep, ' +
            ' cid.ibge_cod_cidade, es.sigla_uf, es.nome_uf, es.ibge_codigo_uf' +
            ' from clientes cl' +
            ' left join cidades cid on cid.cod_cidade = cl.cod_cidade' +
            ' left join estados es on es.codigo_uf = cl.codigo_uf' +
            ' where cl.cod_cliente = ' + IntToStr(APedVenda.cod_cliente) +
            ' and cl.cod_empresa = ' + vDadosIni.codEmpresa, vbuscasTmp) do
          begin
            with APedVenda.Cliente do
            begin
              Codigo                      := vbuscasTmp.FieldByName('cod_cliente').AsInteger;
              NomeFantasia                := Trim(vbuscasTmp.FieldByName('nome_cliente').AsString);
              RazaoSocial                 := Trim(vbuscasTmp.FieldByName('razao').AsString);
              cpfcnpj                     := Trim(vbuscasTmp.FieldByName('cpfcgc').AsString);
              endereco.Logradouro         := Trim(vbuscasTmp.FieldByName('endereco').AsString);
              endereco.Numero             := Trim(vbuscasTmp.FieldByName('num_end_cliente').AsString);
              endereco.Complemento        := Trim(vbuscasTmp.FieldByName('complemento').AsString);
              endereco.Bairro             := Trim(vbuscasTmp.FieldByName('bairro').AsString);
              endereco.Cidade.Nome        := Trim(vbuscasTmp.FieldByName('cidade').AsString);
              endereco.Cidade.IBGE_Cidade := vbuscasTmp.FieldByName('ibge_cod_cidade').AsInteger;
              endereco.Cidade.UF          := Trim(vbuscasTmp.FieldByName('sigla_uf').AsString);
              endereco.Cidade.Estado      := Trim(vbuscasTmp.FieldByName('nome_uf').AsString);
              endereco.Cidade.IBGE_Estado := vbuscasTmp.FieldByName('ibge_codigo_uf').AsInteger;
              endereco.CEP                := Trim(vbuscasTmp.FieldByName('cep').AsString);
              telefone                    := Trim(vbuscasTmp.FieldByName('fone_cliente').AsString);
              email                       := Trim(vbuscasTmp.FieldByName('email').AsString);
            end;
          end;
        end;
      except
        on e: exception do
        begin
          Result := False;
          RollBackTransacao;
          Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        end;
      end;
    finally
    	if Assigned(vbuscasTmp) then
      	FreeAndNil(vbuscasTmp);
    end
  end;

  function InserirPedVendaProd(var APedVenda: TReg_PedVenda; ADtSet: TClientDataSet; ANitem: Integer): Boolean;
  begin
  	try
    	Result := True;

      with APedVenda.Prod.New do
      begin
        grupo_prod      := ADtSet.FieldByName('grupo_prod').AsInteger;
        cod_prod        := ADtSet.FieldByName('cod_prod').AsString;
        nitem           := ANitem;
        cod_grade       := ADtSet.FieldByName('cod_grade').AsInteger;
        codigo_nop      := ADtSet.FieldByName('codigo_nop').AsFloat;
        num_fab_prod    := ADtSet.FieldByName('num_fab_prod').AsString;
        descr_prod_ped  := ADtSet.FieldByName('descr_prod').AsString;
        quant_ped_item  := ADtSet.FieldByName('qtde').AsFloat;

        vlun_ped_item   :=
        	vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco);

        vltot_ped_item  := RoundTo(
        	ADtSet.FieldByName('qtde').AsFloat *
        	vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco), - 2);

        vlun_orig       :=
        	vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco);

        vlun_ped_nf     :=
        	vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco);

        rateio_desc     := 0;
        rateio_acresc   := 0;
        desc_item       := 0;
        acresc_item     := 0;

        comiss_prod     := RoundTo((ADtSet.FieldByName('comissao_prod').AsFloat     * (vltot_ped_item - rateio_desc)) / 100, -2);// aqui nao entra seguro, frete, nem outras despesas
        comiss_prod_ger := RoundTo((ADtSet.FieldByName('comissao_prod_ger').AsFloat * (vltot_ped_item - rateio_desc)) / 100, -2);// aqui nao entra seguro, frete, nem outras despesas
        pcust_c         := ADtSet.FieldByName('prec_cus_prod').AsFloat;
        pcust_mc        := ADtSet.FieldByName('prec_cusm_prod').AsFloat;

        cod_vendedor    := vCodVendedor;

        data_transf     := DateOf(vDadosIni.vDataHora);
        nome_vend       := vNomeVendedor;
        vlo_unitario    := vlun_ped_item;
        data_inclusao   := DateOf(vDadosIni.vDataHora);
        nitem_nf        := 0;
        vl_desp_nf      := 0;

        unidade         := UpperCase(trim(ADtSet.FieldByName('unidade').AsString));
        unidade_conv    := UpperCase(trim(ADtSet.FieldByName('unidade').AsString));

        tp_descacres    := 'DESCONTO';
        nat_descacres   := 'PERCENTUAL';
        valor_descacres := 0;

        icm_prod        := ADtSet.FieldByName('icm_prod').AsFloat;
        csdecqtde       := ADtSet.FieldByName('csdecqtde').AsString;
        csdecvlunt      := ADtSet.FieldByName('csdecvlunt').AsString;

        if icm_prod > 0 then
          sit_trib := 'T'
        else if trim(ADtSet.FieldByName('isento_prod').AsString) = 'S' then
          sit_trib := 'I'
        else if trim(ADtSet.FieldByName('n_incidencia_prod').AsString) = 'S' then
          sit_trib := 'N'
        else
          sit_trib := 'F';

      	vltot_ped_nf    := vltot_ped_item;

        ativo           := 1;
      end;

      with APedVenda do
      begin
      	tot_prod        := tot_prod + RoundTo(
        	ADtSet.FieldByName('qtde').AsFloat *
          vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco), -2);

  			valor_total     := valor_total + RoundTo(
        	ADtSet.FieldByName('qtde').AsFloat *
          vDadosIni.IfThen(ADtSet.FieldByName('prec_tab_prod').AsFloat > 0,
        		ADtSet.FieldByName('prec_tab_prod').AsFloat,
          	vValorItensProdSemPreco), -2);
      end;

    except
      on e: exception do
      begin
        Result := False;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  end;

  function InserirPedVendaBanco(var APedVenda: TReg_PedVenda): Boolean;
  var
  	ARegistros: TGeraRegistros;
  	vbuscasTmp: TIBQuery;
  begin
  	try
    	Result := True;

      vbuscasTmp := TIBQuery.Create(Application);
      vbuscasTmp.Database := buscas.Database;
      vbuscasTmp.Transaction := buscas.Transaction;

      try
        with APedVenda do
        begin
          tot_prod        := RoundTo(tot_prod, -2);
          valor_total     := RoundTo(valor_total, -2);
        end;

        ARegistros := TGeraRegistros.create(vbuscasTmp.Transaction);
        try
          if not ARegistros.Inserir(APedVenda) then
            raiseExceptionCreate(ARegistros.LasError, '');
        finally
        	if Assigned(ARegistros) then
          	FreeAndNil(ARegistros);
        end;

        vDadosIni.GravaAuditoria('VND271', 'MONTAR',
          'REQ' +
          ' CL: ' + IntToStr(vCodCliente) +
          ' VND: ' + IntToStr(vCodVendedor) +
          ' COND: ' + IntToStr(vCodCondPag) +
          ' TP VND: ' + trim(vTipoVenda) +
          ' EST: ' + vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'D', 'F') +
          ' ORD: ' + vDadosIni.IfThen(trim(vOrdenarItensPor) = 'NUM FAB PROD', 'NUMFAB', 'DESCR'),
          'PEDVENDA', IntToStr(APedVenda.nped), buscas);

        if Assigned(APedVenda) then
          FreeAndNil(APedVenda);

        Result := CommitaTransacao;
      except
        on e: exception do
        begin
          Result := False;
          RollBackTransacao;
          Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        end;
      end;
    finally
    	if Assigned(vbuscasTmp) then
      	FreeAndNil(vbuscasTmp);
    end
  end;
begin
	try
  	Result := True;
  	fTemp := TClientDataSet.Create(nil);

    try
      vpergunta := 'Deseja montar pedido com as produtos com estoque ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'disponível', 'físico') + '?';

      if Application.MessageBox(pchar(vpergunta),
        'Atenção', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
          exit;

      if not vDadosIni.PesqPros('VND271', 'MONTAR',
        'REQ' +
        ' CL: ' + IntToStr(vCodCliente) +
        ' VND: ' + IntToStr(vCodVendedor) +
        ' COND: ' + IntToStr(vCodCondPag) +
        ' TP VND: ' + trim(vTipoVenda) +
        ' EST: ' + vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'D', 'F') +
        ' ORD: ' + vDadosIni.IfThen(trim(vOrdenarItensPor) = 'NUM FAB PROD', 'NUMFAB', 'DESCR'),
        'PEDVENDA', '', buscas, true) then
          exit;

      SqlOpen(' select cod_vendedor, nome_vendedor from colaborador ' +
        ' where cod_vendedor = ' + IntToStr(vCodVendedor) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);
      vNomeVendedor      := buscas.FieldByName('nome_vendedor').AsString;

      vIncPedido := 0;
      vIncItens  := 0;

      buscas.Close;
      buscas.SQL.Text := ' select 0 cod_grade, ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL',
          ' (round(coalesce(est.estoque, 0), 4)) as qtde, ',
          ' (round(coalesce(produtos.est_f, 0), 4)) as qtde, ') +
        ' trim(coalesce(produtos.descr_prod, '''')) descr_prod, ' +
        ' trim(coalesce(produtos.num_fab_prod, '''')) num_fab_prod, ' +
        ' produtos.* from produtos ' +
        ' left join getestoquedisponivel ( ' +
        '		produtos.grupo_prod, ' +
        '		produtos.cod_prod, ' +
        '		0, ' +
        '		produtos.cod_empresa, ' +
        '		0, ' +
        '		'''', ' +
        '		0, ' +
        '		0) est on 1 = 1 ' +
        ' where produtos.cod_empresa = :cod_empresa ' +
        ' and produtos.ativo = 1 ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL',
          ' and (round(coalesce(est.estoque, 0), 4)) > 0 ',
          ' and (round(coalesce(produtos.est_f, 0), 4)) > 0 ') +
        ' and (select count(*) from cod_grade_prod ' +
        '      where cod_grade_prod.grupo_prod = produtos.grupo_prod ' +
        '      and cod_grade_prod.cod_prod = produtos.cod_prod ' +
        '      and cod_grade_prod.cod_empresa = cod_grade_prod.cod_empresa ' +
        '      and cod_grade_prod.cod_grade > 0) = 0 ' +
        ' union ' +
        ' select cod_grade_prod.cod_grade, ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL',
          ' (round(coalesce(est.estoque, 0), 4)) as qtde, ',
          ' (round(coalesce(cod_grade_prod.qtde, 0), 4)) as qtde, ') +
        ' (trim(coalesce(produtos.descr_prod, '''')) || '' '' || trim(coalesce(grade.descricao, ''''))) descr_prod, ' +
        ' trim(coalesce(produtos.num_fab_prod, '''')) num_fab_prod, ' +
        ' produtos.* from produtos ' +
        ' inner join cod_grade_prod on ' +
        '     cod_grade_prod.grupo_prod = produtos.grupo_prod ' +
        '     and cod_grade_prod.cod_prod = produtos.cod_prod ' +
        '     and cod_grade_prod.cod_empresa = cod_grade_prod.cod_empresa ' +
        '     and cod_grade_prod.cod_grade > 0 ' +
        ' inner join grade on ' +
        '     grade.cod_grade = cod_grade_prod.cod_grade ' +
        '     and grade.cod_empresa = cod_grade_prod.cod_empresa ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL',
          ' left join getestoquedisponivel (' +
          '		produtos.grupo_prod, ' +
          '		produtos.cod_prod, ' +
          '		coalesce(cod_grade_prod.cod_grade, 0), ' +
          '		produtos.cod_empresa, ' +
          '		0, ' +
          '		'''', ' +
          '		0, ' +
          '		0) est on 1 = 1 ',
          '') +
        ' where produtos.cod_empresa = :cod_empresa ' +
        ' and produtos.ativo = 1 ' +
        vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL',
          ' and (round(coalesce(est.estoque, 0), 4)) > 0 ',
          ' and (round(coalesce(cod_grade_prod.qtde, 0), 4)) > 0 ') +
        vDadosIni.IfThen(trim(vOrdenarItensPor) = 'NUM FAB PROD',
          ' order by 4, 1 ',
          ' order by 3, 1 ');
      buscas.ParamByName('cod_empresa').AsInteger := vDadosIni.cod_empresa;
      buscas.Open;
      buscas.FetchAll;

      if buscas.IsEmpty then
      begin
        vpergunta := 'Nenhum produto com estoque ' +
          vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'disponível', 'físico') + ' encontrado';
        Application.MessageBox(Pchar(vpergunta), 'Atenção', MB_ICONWARNING + MB_OK);
        Result := False;
        Exit;
      end;

      fTemp.Close;
      fTemp.FieldDefs.Clear;
      for I := 0 to buscas.Fields.Count - 1 do
      begin
        fTemp.FieldDefs.Add(
          buscas.Fields[i].FieldName,
          buscas.Fields[i].DataType,
          buscas.Fields[i].Size,
          false);
      end;
      fTemp.CreateDataSet;
      fTemp.EmptyDataSet;

      ProgressBar.Min := 0;
      ProgressBar.Max := buscas.RecordCount;
      ProgressBar.Position := 0;

      vQtdePedido := Ceil(buscas.RecordCount / vQtdeMaxItensPed);

      buscas.First;
      while not buscas.Eof do
      begin
        fTemp.Insert;
        for I := 0 to buscas.Fields.Count - 1 do
          fTemp.FieldByName(buscas.Fields[i].FieldName).Value := buscas.Fields[i].Value;
        fTemp.Post;

        vDadosIni.abreStatusProcessamento('',
          'Preparando dataset ' + IntToStr(buscas.RecNo));

        ProgressBar.Position := ProgressBar.Position + 1;

        buscas.Next;
      end;
      buscas.Close;

      if trim(vOrdenarItensPor) = 'NUM FAB PROD' then
        fTemp.IndexFieldNames := 'NUM_FAB_PROD;COD_GRADE'
      else
        fTemp.IndexFieldNames := 'DESCR_PROD;COD_GRADE';

      ProgressBar.Min := 0;
      ProgressBar.Position := 0;

      fTemp.First;
      while not fTemp.Eof do
      begin
        Application.ProcessMessages;
        Inc(vIncItens);
        if fTemp.RecNo = 1 then
        begin
          Inc(vIncPedido);
          InserirPedVenda(APedvenda);
          InserirPedVendaProd(APedvenda, fTemp, vIncItens);

          if fTemp.RecNo = fTemp.RecordCount then
            InserirPedVendaBanco(APedvenda);

          vDadosIni.abreStatusProcessamento('',
            'Montando pedido(s) - ' + IntToStr(vIncPedido) + '/' + IntToStr(vQtdePedido) + ' (' + IntToStr(vIncItens) + '/' + IntToStr(fTemp.RecordCount) + ')');
        end
        else if vIncItens > vQtdeMaxItensPed then
        begin
          InserirPedVendaBanco(APedvenda);

          vDadosIni.abreStatusProcessamento('',
            'Montando pedido(s) - ' + IntToStr(vIncPedido) + '/' + IntToStr(vQtdePedido) + ' (' + IntToStr(vIncItens) + '/' + IntToStr(fTemp.RecordCount) + ')');

          Inc(vIncPedido);
          vIncItens := 1;
          InserirPedVenda(APedvenda);
          InserirPedVendaProd(APedvenda, fTemp, vIncItens);

          if fTemp.RecNo = fTemp.RecordCount then
            InserirPedVendaBanco(APedvenda);
        end
        else if (fTemp.Eof) or (fTemp.RecNo = fTemp.RecordCount) then
        begin
          InserirPedVendaProd(APedvenda, fTemp, vIncItens);
          InserirPedVendaBanco(APedvenda);

          vDadosIni.abreStatusProcessamento('',
            'Montando pedido(s) - ' + IntToStr(vIncPedido) + '/' + IntToStr(vQtdePedido) + ' (' + IntToStr(vIncItens) + '/' + IntToStr(fTemp.RecordCount) + ')');
        end
        else
        begin
          InserirPedVendaProd(APedvenda, fTemp, vIncItens);

          if fTemp.RecNo = fTemp.RecordCount then
            InserirPedVendaBanco(APedvenda);

          vDadosIni.abreStatusProcessamento('',
            'Montando pedido(s) - ' + IntToStr(vIncPedido) + '/' + IntToStr(vQtdePedido) + ' (' + IntToStr(vIncItens) + '/' + IntToStr(fTemp.RecordCount) + ')');
        end;

        ProgressBar.Position := ProgressBar.Position + 1;

        fTemp.Next;
      end;

      vDadosIni.GravaAuditoria('VND271', 'MONTAR', 'SUCESSO -' +
          ' REQ' +
          ' CL: ' + IntToStr(vCodCliente) +
          ' VND: ' + IntToStr(vCodVendedor) +
          ' COND: ' + IntToStr(vCodCondPag) +
          ' TP VND: ' + trim(vTipoVenda) +
          ' EST: ' + vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'D', 'F') +
          ' ORD: ' + vDadosIni.IfThen(trim(vOrdenarItensPor) = 'NUM FAB PROD', 'NUMFAB', 'DESCR'),
          'PEDVENDA', '', buscas);

      vDadosIni.fechaStatusProcessamento;

      if vIncPedido > 0 then
        Application.MessageBox(Pchar('Pedido(s) criado(s) com sucesso'), 'Atenção', MB_ICONINFORMATION + MB_OK);

      Result := True;
    except
      on e: exception do
      begin
        Result := false;
        vDadosIni.fechaStatusProcessamento;

        vDadosIni.GravaAuditoria('VND271', 'MONTAR', 'FALHA -' +
          ' REQ' +
          ' CL: ' + IntToStr(vCodCliente) +
          ' VND: ' + IntToStr(vCodVendedor) +
          ' COND: ' + IntToStr(vCodCondPag) +
          ' TP VND: ' + trim(vTipoVenda) +
          ' EST: ' + vDadosIni.IfThen(trim(vUtilizarEstoque) = 'DISPONIVEL', 'D', 'F') +
          ' ORD: ' + vDadosIni.IfThen(trim(vOrdenarItensPor) = 'NUM FAB PROD', 'NUMFAB', 'DESCR'),
          'PEDVENDA', '', buscas);

        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(fTemp) then
    	FreeAndNil(fTemp);
  end;
end;

initialization
  RegisterClass(TConfirmaVenda);

finalization
  UnRegisterClass(TConfirmaVenda);

end.
