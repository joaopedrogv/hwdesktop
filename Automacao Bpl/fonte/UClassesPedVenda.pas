procedure TPedVendaProd._desmarcaItem;
begin
  if dataSet.IsEmpty then
    exit;

  if dataSet.FieldByName('STATUS').AsString = 'CANCELADO' then
 	exit;
   
  dataSet.Edit;
  dataSet.FieldByName('SEL').AsString := 'N';
  dataSet.Post;
end;

procedure TPedVendaProd._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if dataSet.IsEmpty then
    	Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
    	if dataSet.FieldByName('STATUS').AsString <> 'CANCELADO' then
      begin
        dataSet.Edit;
        dataSet.FieldByName('sel').AsString := '';
        dataSet.Post;
      end;

      dataSet.Next;
    end;
    dataSet.First;

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVendaProd._devolverItemVnd: boolean;
var
  qtdItensTemp, qtdItensDevTemp: double;
  unidadeTemp, unidadeConvTemp: string;
  vcfop: double;

  procedure _reajustaAcresDesc;
  begin
    descontoP := 0;
    descontoV := 0;
    descontoVini := 0;
    acrescimoP := 0;
    acrescimoV := 0;
    if dataSet.FieldByName('VALOR_DESCACRES').AsFloat = 0 then
    begin
      dataSet.FieldByName('desc_item').AsCurrency := 0;
      dataSet.FieldByName('acresc_item').AsCurrency := 0;
    end
    else
    begin
      dataSet.FieldByName('desc_item').AsCurrency := 0;
      dataSet.FieldByName('acresc_item').AsCurrency := ((
        dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV;
      if trim(dataSet.FieldByName('TP_DESCACRES').Asstring) = 'DESCONTO' then
      begin
        if trim(dataSet.FieldByName('NAT_DESCACRES').Asstring) = 'PERCENTUAL' then
          descontoP := dataSet.FieldByName('VALOR_DESCACRES').AsFloat
        else
        begin
          descontoV := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;

          if (dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S') then
          begin
            if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
              descontoVini :=
                vDadosIni.StrToFloatFormat(
                  (dataSet.FieldByName('vlun_ped_item').AsFloat -
                   dataSet.FieldByName('vlun_orig').AsFloat) *
                  dataSet.FieldByName('quant_ped_item').AsFloat, 2);
          end
          else if (dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S') then
          begin
            if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
              descontoVini :=
                vDadosIni.StrToFloatFormat(
                  (dataSet.FieldByName('vlun_ped_item').AsFloat -
                   dataSet.FieldByName('vlun_orig').AsFloat) *
                  dataSet.FieldByName('quant_ped_item').AsFloat, 2)
          end
          else if (dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S') then
          begin
            if vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_ped_item').AsFloat, StrToInt(vSing.vCasasDecimais)) >= vDadosIni.StrToFloatFormat(dataSet.FieldByName('vlun_orig').AsFloat, StrToInt(vSing.vCasasDecimais)) then
              descontoVini :=
                vDadosIni.StrToFloatFormat(
                  (dataSet.FieldByName('vlun_ped_item').AsFloat -
                   dataSet.FieldByName('vlun_orig').AsFloat) *
                  dataSet.FieldByName('quant_ped_item').AsFloat, 2);
          end
        end;
      end
      else
      begin
        if trim(dataSet.FieldByName('NAT_DESCACRES').Asstring) = 'PERCENTUAL' then
          acrescimoP := dataSet.FieldByName('VALOR_DESCACRES').AsFloat
        else
          acrescimoV := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
      end;
      dataSet.FieldByName('desc_item').AsCurrency := ((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (descontoP / 100)) + descontoV;
      dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(dataSet.FieldByName('desc_item').AsCurrency, 2);
      if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
        dataSet.FieldByName('rateio_desc').AsCurrency := dataSet.FieldByName('desc_item').AsCurrency;
      dataSet.FieldByName('rateio_desc').AsCurrency := dataSet.FieldByName('desc_item').AsCurrency;
      dataSet.FieldByName('acresc_item').AsCurrency := ((dataSet.FieldByName('vltot_ped_item').AsCurrency) * (acrescimoP / 100)) + acrescimoV;
      dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(dataSet.FieldByName('acresc_item').AsCurrency, 2);
    end;
  end;

  procedure InserirHistorico;
  var
    devit: TPedvenda_prod_cond_dev_class;    
  begin
    devit := TPedvenda_prod_cond_dev_class.Create;
    devit.nped := fint('nped');
    devit.tipo := fstr('tipo');
    devit.grupo_prod := fint('grupo_prod');
    devit.cod_prod := fstr('cod_prod');
    devit.cod_empresa := vDadosIni.cod_empresa;
    devit.cod_grade := fint('cod_grade');
    devit.quantidade := vQuantDev;
    SqlExec(devit.SQLMotor().SQLInsert);
    devit.Free;
  end;

begin
  try
    result := false;
    qtdItensTemp := 0;
    qtdItensDevTemp := 0;
    unidadeTemp := '';
    unidadeConvTemp := '';
    
    TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Clear;

    dtSet.Filtered := false;
    dtSet.Filter := ' GRUPO_PROD = ' + inttostr(vCodGrupoDev) +
      ' and COD_PROD = ' + QuotedStr(vCodProdDev) +
      ' and COD_GRADE = ' + inttostr(nGradeSelecionada) +
      ' and STATUS <> ''CANCELADO''';
    dtSet.Filtered := true;

    dtSet.First;
    while not dtSet.Eof do
    begin
    	if trim(unidadeTemp) = '' then
    		unidadeTemp := UpperCase(trim(dtSet.FieldByName('UNIDADE').AsString));
        
    	if trim(dtSet.FieldByName('UNIDADE').AsString) <> '' then
      	if TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items.IndexOf(UpperCase(trim(dtSet.FieldByName('UNIDADE').AsString))) = -1 then
      		TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items.Add(UpperCase(trim(dtSet.FieldByName('UNIDADE').AsString)));

      if trim(dtSet.FieldByName('UNIDADE_CONV').AsString) <> '' then
      	if TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items.IndexOf(UpperCase(trim(dtSet.FieldByName('UNIDADE_CONV').AsString))) = -1 then
      		TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items.Add(UpperCase(trim(dtSet.FieldByName('UNIDADE_CONV').AsString)));

    	dtSet.Next;
    end;

    TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.ItemIndex := 0;
    if TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items.Count > 1 then
    begin
    	TFrmCadPedVenda(FOwner.FrmCadPed).LabelInfConversaoSaida.Caption := '';
    	TFrmCadPedVenda(FOwner.FrmCadPed).LabelInfGrupoConversaoSaida.Caption := IntToStr(vCodGrupoDev);
      TFrmCadPedVenda(FOwner.FrmCadPed).LabelInfCodProdConversaoSaida.Caption := vCodProdDev;
      if not vDadosIni.abreForm('Informe a unidade de devolução', TFrmCadPedVenda(FOwner.FrmCadPed).pnDevolucaoUnidade, TFrmCadPedVenda(FOwner.FrmCadPed).ts_devolucao) then
        exit;
    end;

   	unidadeConvTemp := trim(TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.Items[TFrmCadPedVenda(FOwner.FrmCadPed).ComboBoxDevolucaoUn.ItemIndex]);

    if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
      ' WHERE UPPER(SIGLA) = ' + QuotedStr(UpperCase(trim(unidadeConvTemp))), buscas).IsEmpty then
    begin
      if buscas.FieldByName('FRACIONADO').AsInteger = 0 then
      begin
        vQuantDev := RoundTo(vQuantDev, 0);
      end;
    end;

    if (trim(unidadeTemp) <> trim(unidadeConvTemp))  then
    begin
      if not SqlOpen(' select first 1 pp.operacao_conv, pp.fator_conv from pedvenda_prod pp ' +
        ' where pp.nped = ' + IntToStr(FOwner.dataSet.FieldByName('NPED').AsInteger) +
        ' and pp.tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('TIPO').AsString) +
        ' and pp.grupo_prod = ' + IntToStr(vCodGrupoDev) +
        ' and pp.cod_prod = ' + QuotedStr(vCodProdDev) +
        ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and pp.unidade_conv = ' + QuotedStr(trim(unidadeConvTemp)) +
        ' and ((pp.status = '''') or (pp.status is null)) ', buscas).IsEmpty then
      begin
      	if buscas.FieldByName('OPERACAO_CONV').AsString = 'M' then
        begin
        	vQuantDev :=
            vQuantDev /
            buscas.FieldByName('FATOR_CONV').AsFloat;
        end
        else if buscas.FieldByName('OPERACAO_CONV').AsString = 'D' then
        begin
          vQuantDev :=
            vQuantDev *
            buscas.FieldByName('FATOR_CONV').AsFloat;
        end;
      end;
    end;

    dtSet.First;
    while not dtSet.Eof do
    begin
    	if (UpperCase(trim(unidadeConvTemp)) = UpperCase(trim(dtSet.FieldByName('UNIDADE_CONV').AsString))) then
    			qtdItensTemp := qtdItensTemp + dtSet.FieldByName('QUANT_PED_ITEM').AsFloat
      else if (trim(dtSet.FieldByName('UNIDADE_CONV').AsString) = '')
      	and (UpperCase(trim(unidadeConvTemp)) = UpperCase(trim(dtSet.FieldByName('UNIDADE').AsString))) then
      qtdItensTemp := qtdItensTemp + dtSet.FieldByName('QUANT_PED_ITEM').AsFloat;

      qtdItensDevTemp := qtdItensDevTemp + dtSet.FieldByName('QUANT_ITEM_DEV').AsFloat;
      dtSet.Next;
    end;

    if vQuantDev > qtdItensTemp then
    begin
      Application.MessageBox(PChar('Quantidade informada para o item maior que a quantidade do mesmo, existente na venda.' + #13 + #13 +
      	'Unidade informada: ' + trim(unidadeConvTemp)), 'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select first 1 codigo_nop from pedvenda_prod pd ' +
      ' where nped = :nped ' +
      ' and tipo = :tipo ' +
      ' and cod_empresa = :cod_empresa ' +
      ' and status = ''CANCELADO'' ' +
      ' order by codigo_nop asc ';
    buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
    buscas.ParamByName('tipo').AsString := dataSet.FieldByName('tipo').AsString;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    vcfop := -1;
    if not buscas.IsEmpty then
      vcfop := buscas.FieldByName('codigo_nop').AsFloat - 1;
     

    dataSet.Filtered := false;
    dataSet.Filter := ' GRUPO_PROD = ' + inttostr(vCodGrupoDev) +
      ' and COD_PROD = ' + QuotedStr(vCodProdDev) +
      ' and COD_GRADE = ' + inttostr(nGradeSelecionada);
//     ' and STATUS <> ''CANCELADO''';
    dataSet.Filtered := true;

    First;
    while not eof do
    begin
      if trim(dataSet.FieldByName('STATUS').AsString) = 'CANCELADO' then
      begin
        next;
        Continue;
      end
      else if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
      	and (UpperCase(trim(unidadeConvTemp)) <> UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) then
      begin
        next;
        Continue;
      end
      else if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) = '')
      	and (UpperCase(trim(unidadeConvTemp)) <> UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
      begin
        next;
        Continue;
      end;

      inherited edit;
      if (RoundTo(vQuantDev, - 4) - RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4)) = 0 then
      begin
        if dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat > 0 then
          dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat + vQuantDev, - 4)
        else
        	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(vQuantDev, - 4);

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);

        if (trim(unidadeConvTemp) = '')
        	or (trim(unidadeTemp) = trim(unidadeConvTemp)) then
        begin
        	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
        	dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
        end
        else
        begin
        	if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
          begin
          	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
        	end
          else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
          begin
            dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else
          begin
          	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
          	dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
          end;
        end;

        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := 0;
        dataSet.FieldByName('STATUS').AsString := 'CANCELADO';
        dataSet.FieldByName('TIPV').AsString := FTipv;
        dataSet.FieldByName('CODIGO_NOP').AsFloat := vcfop;
        definirValorNF;
        InserirHistorico;
        _reajustaAcresDesc;
        break;
      end
      else if (RoundTo(vQuantDev, - 4) - RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4)) > 0 then
      begin
        if dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat > 0 then
          dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat + dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4)
        else
        	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
        vQuantDev := vQuantDev - dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);

        if (trim(unidadeConvTemp) = '')
        	or (trim(unidadeTemp) = trim(unidadeConvTemp)) then
        begin
        	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
        	dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
        end
        else
        begin
          if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
          begin
            dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
          begin
            dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else
          begin
          	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
          	dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
          end;
        end;

        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := 0;
        dataSet.FieldByName('STATUS').AsString := 'CANCELADO';
        dataSet.FieldByName('TIPV').AsString := FTipv;
        dataSet.FieldByName('CODIGO_NOP').AsFloat := vcfop;
        definirValorNF;
        InserirHistorico;
        _reajustaAcresDesc;
      end
      else
      begin
        if dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat > 0 then
          dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat + vQuantDev, - 4)
        else
        	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat := RoundTo(vQuantDev, - 4);

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat - vQuantDev, - 4);

        if (trim(unidadeConvTemp) = '')
        	or (trim(unidadeTemp) = trim(unidadeConvTemp)) then
        begin
        	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
          dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
        end
        else
        begin
        	if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
          begin
          	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat *
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
          begin
            dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);

            dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(
            	dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat /
              dataSet.FieldByName('FATOR_CONV').AsFloat, - 4);
          end
          else
          begin
          	dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);
          	dataSet.FieldByName('QUANT_ITEM_DEV_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat, - 4);
          end;
        end;
        
        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
        	(dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency *
          	dataSet.FieldByName('QUANT_PED_ITEM').AsFloat), 2);
        dataSet.FieldByName('TIPV').AsString := FTipv;
        definirValorNF;
        InserirHistorico;
        _reajustaAcresDesc;
        break;
      end;
      inherited post;
      Next;
    end;

//    dtSet.Filtered:=false;
//    dtSet.Filter:=' COALESCE(STATUS,'''') <> ''CANCELADO''';
//    dtSet.Filtered:=true;
//    if dtSet.IsEmpty then
//      Application.MessageBox('Todo os itens da venda foram canceladoQuantidade informada para o item maior que a quantidade do mesmo, existente na venda.','Informação',MB_OK);

  finally
    dtSet.Filtered := false;
    dataSet.Filtered := false;
  end;
end;

function TPedVendaProd._existePrecoPorQtde(pTIPV: string): boolean;
begin
	try
    Result := False;

    buscas.Close;
    buscas.SQL.Text := ' SELECT FIRST 1 ' +
      ' COALESCE(PRECO_PRODUTOS_QTDE.PRECO_VENDA, 0) PRECO_VENDA, ' +
      ' COALESCE(PRECO_PRODUTOS_QTDE.PORCENTAGEM, 0) PORCENTAGEM, ' +
      ' COALESCE(PRECO_PRODUTOS_QTDE.MAX_DESC, 0) MAX_DESC, ' +
      ' COALESCE(PRODUTOS.PREC_TAB_PROD, 0) PREC_TAB_PROD ' +
      ' FROM PRECO_PRODUTOS_QTDE ' +
      ' INNER JOIN PRODUTOS ON ' +
      '		PRODUTOS.GRUPO_PROD = PRECO_PRODUTOS_QTDE.GRUPO_PROD ' +
      '		AND PRODUTOS.COD_PROD = PRECO_PRODUTOS_QTDE.COD_PROD ' +
      '   AND PRODUTOS.COD_EMPRESA = PRECO_PRODUTOS_QTDE.COD_EMPRESA ' +
      ' WHERE PRECO_PRODUTOS_QTDE.GRUPO_PROD = :GRUPO_PROD ' +
      ' AND PRECO_PRODUTOS_QTDE.COD_PROD = :COD_PROD ' +
      ' AND PRECO_PRODUTOS_QTDE.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND ((PRECO_PRODUTOS_QTDE.SIGLA = ''0'') or (PRECO_PRODUTOS_QTDE.SIGLA = :SIGLA)) ' +
//      ' AND PRECO_PRODUTOS_QTDE.QUANT <= :QUANT ' +
      ' ORDER BY PRECO_PRODUTOS_QTDE.QUANT DESC ';
    buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
    buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('SIGLA').AsString := pTIPV;
//    buscas.ParamByName('QUANT').AsFloat := dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
    buscas.Open;

    Result := not buscas.IsEmpty;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

