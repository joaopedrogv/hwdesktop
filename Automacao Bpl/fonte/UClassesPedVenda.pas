function TPedVenda.MarcarOSParaLivro: boolean;
begin
  result := false;
  if dataSet.FieldByName('ATIVO').asinteger = 0 then
    exit;
  if (vSing.vTipoVenda = 'ORC') or (vSing.vTipoVenda = 'REQ') then
    exit;
  if dataSet.FieldByName('EM_NF').AsString = 'S' then
  begin
    if Application.MessageBox(Pchar('Deseja retirar a marcação da O.S. ' + dataSet.FieldByName('NPED').AsString + ' para o livro de registro?'), 'Retirar marcação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      if vDadosIni.PesqPros('VND093', 'DESMARCAR O.S.', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
        if inherited Edit then
        begin
          dataSet.FieldByName('EM_NF').AsVariant := null;
          result := inherited Post;
          if Result then
            result := Apply;
          if Result then
            result := CommitaTransacao;
          if Result then
            vDadosIni.GravaAuditoria('VND093', 'DESMARCAR O.S.', dataSet.FieldByName('TIPO').AsString + ' - SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('VND093', 'DESMARCAR O.S.', dataSet.FieldByName('TIPO').AsString + ' - FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        end;
  end
  else if vDadosIni.PesqPros('VND092', 'MARCAR O.S.', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
  begin
    if Application.MessageBox(Pchar('Deseja marcar a O.S. ' + dataSet.FieldByName('NPED').AsString + ' para o livro de registro?'), 'Marcar O.S.', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
      if inherited Edit then
      begin
        dataSet.FieldByName('EM_NF').AsVariant := 'S';
        result := inherited Post;
        if Result then
          result := Apply;
        if Result then
          result := CommitaTransacao;
        if Result then
        begin
          Application.MessageBox(Pchar('O.S. :' + dataSet.FieldByName('NPED').AsString + ' marcada com sucesso'), 'Maracação de O.S. para Livro de Registro', MB_OK + MB_ICONINFORMATION);
          vDadosIni.GravaAuditoria('VND092', 'MARCAR O.S.', dataSet.FieldByName('TIPO').AsString + ' - SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        end
        else
        begin
          Application.MessageBox(Pchar('Falha na marcação da O.S. :' + dataSet.FieldByName('NPED').AsString), 'Maracação de O.S. para Livro de Registro', MB_OK + MB_ICONWARNING);
          vDadosIni.GravaAuditoria('VND092', 'MARCAR O.S.', dataSet.FieldByName('TIPO').AsString + ' - FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        end;
      end;
  end;
  if result then
    Refresh
  else
    CancelUpdates;
end;

function TPedVenda.MesclarDAVsOSREQ(pNPED: integer; pTipo: string): boolean;
var
  i, nVenda: Integer;
  j: Integer;
  nDAV, vNitemP, vNitemS, nPV: Integer;
  vTotalRateioDesc, vTotalRateioAcresc, vrTemp: currency;
  vstatusPED, vDAVOrigem, vTipvTemp,vTipoTemp,col_cod_vendedorTemp: string;
  vlista: TStringList;
  vCodMax: Integer;
  vCodMaxGenerator: Integer;
  buscas2: TIBQuery;
begin
  try
  	 buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    vlista := TStringList.Create;
  	 vlista.Clear;

  	try
      disableControlsDataSets;
      vDadosIni.abreStatusProcessamento('Status', 'Exportando. Aguarde...');
      vNitemP := 0;
      vNitemS := 0;
      vdescMesc := 0;
      vAcresMesc := 0;
      vTotalRateioDesc := 0;  //DESCONTO DESTINADO A VENDA QUE VAI SER GERADA
      vTotalRateioAcresc := 0;  //ACRESCIMO DESTINADO A VENDA QUE VAI SER GERADA
      UltimoNpedMesclado := 0;
      Result := false;

      if not validaDAVParaMesclagem(pNPED, pTipo) then
      begin
      	Result := false;
        exit;
      end;

      if dtSetOrcTemp <> nil then
      begin
        dtSetOrcTemp.First;
        while not dtSetOrcTemp.Eof do
        begin
          buscas.Close;
          buscas.SQL.Text := 'select nped, op_cxl, status_cxl_rq from pedvenda' +
            ' where nped = ' + dtSetOrcTemp.FieldByName('nped').AsString +
            ' and tipo = ' + quotedStr(dtSetOrcTemp.FieldByName('tipo').AsString) +
            ' and COD_EMPRESA = ' + vDadosIni.codEmpresa ;
          buscas.Open;

          if Trim(buscas.FieldByName('status_cxl_rq').AsString) = 'R' then
          begin
            Application.MessageBox(PChar('Venda ' + dtSetOrcTemp.FieldByName('nped').AsString +
	            ' recebida ou sendo recebida no Caixa Auxiliar'), 'Atenção', MB_OK + MB_ICONINFORMATION);
            Result := false;
            exit;
          end;

          buscas.Close;
          buscas.SQL.Text := 'select first 1 COD_CARGA, NUM_VENDA, TIPO_VENDA from CARGA_ITEM' +
            ' where NUM_VENDA = ' + dtSetOrcTemp.FieldByName('nped').AsString +
            ' and TIPO_VENDA = ' + quotedStr(dtSetOrcTemp.FieldByName('tipo').AsString) +
            ' and COD_EMPRESA = ' + vDadosIni.codEmpresa ;
          buscas.Open;

          if buscas.FieldByName('NUM_VENDA').AsInteger > 0 then
          begin
            Application.MessageBox(PChar(
              'Venda ' + dtSetOrcTemp.FieldByName('nped').AsString +
              ' está em uma ordem de carregamento: ' + buscas.FieldByName('COD_CARGA').AsString + #13 +
              'Não pode ser mesclado'), 'Atenção', MB_OK + MB_ICONINFORMATION);
            Result := false;
            exit;
          end;
          dtSetOrcTemp.Next;
        end;
      end;

      //Atualizar gencodigo Evidencias PAF
      buscas.Close;
      buscas.SQL.Text := ' select first 1 seqid as cod_max from evidencias_paf ' +
      	' where cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by 1 desc ';
      buscas.Open;

      vCodMax := buscas.FieldByName('cod_max').AsInteger + 1;

      buscas.Close;
      buscas.SQL.Text := ' select gen_id(gen_evidencias_paf, 0) cod_max from rdb$database ';
      buscas.Open;

      vCodMaxGenerator := buscas.FieldByName('cod_max').AsInteger;

      if vCodMax > vCodMaxGenerator then
      begin
        buscas.Close;
	      buscas.SQL.Text := ' set generator gen_evidencias_paf to ' + IntToStr(vCodMax);
        buscas.ExecSQL;
      end;

      //Atualizar Ocorrencias OS
      buscas.Close;
      buscas.SQL.Text := ' select first 1 cod_ocorrencia as cod_max from ocorrencias_os ' +
      	' where cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by 1 desc ';
      buscas.Open;

      vCodMax := buscas.FieldByName('cod_max').AsInteger + 1;
      
      buscas.Close;
      buscas.SQL.Text := ' select cod from incrementa_codigo(' + vDadosIni.codEmpresa + ', ''OCORRENCIAS_OS'') ';
      buscas.Open;

      vCodMaxGenerator := buscas.FieldByName('cod').AsInteger;

      if vCodMax > vCodMaxGenerator then
      begin
        buscas.Close;
	      buscas.SQL.Text := ' update codigo set valor = ' + IntToStr(vCodMax) +
        	' where tabela = ''OCORRENCIAS_OS'' ' +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ExecSQL;
      end;

      dtSetSinc := TClientDataSet(DtmPed.cdssinc);
      dtSetSincIt := TClientDataSet(DtmPed.cdssincIt);
      comandoTexto := dataSet.CommandText;
      defineCampos(dataSet, false);
      dtSetSinc.Close;
      dtSetSinc.CommandText := 'select v.* from pedvenda v ' +
        ' where v.nped = ' + inttostr(pNPED) +
        ' and v.tipo = ' + QuotedStr(pTipo) +
        ' and v.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and v.ativo = 1';
      dtSetSinc.Open;
      dtSetOrcTemp.Locate('SEL', 'S', [loCaseInsensitive, loPartialKey]);

//        try
        IniciaTransacao;
        nDAV := 0;
        nPV := 0;
        if (pNPED = 0) then
        begin
          if pTipo = 'OS' then
          begin
            nVenda := Gencodigo('ORDEM_SERV', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
            vDadosIni.hw_registra_estatistica('ORDEM_SERV');
          end
          else if pTipo = 'REQ' then
          begin
            nVenda := Gencodigo('REQVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
            vDadosIni.hw_registra_estatistica('REQVENDA');
          end;
          if (vDadosIni.vEmp.vUsarPreVenda = 'S') and (vSing.vTipoVenda = 'REQ') then
            nPV := Gencodigo('PAF_PREVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa)
          else if (vDadosIni.vEmp.vUsarDAV = 'S') then
            nDAV := Gencodigo('PREVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);

          dtSetSinc.Insert;
          //        for i := 0 to dataSet.Fields.Count - 1 do
          //          dtSetSinc.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
          dtSetSinc.FieldByName('COD_EMPRESA').AsInteger := strToint(vDadosIni.codEmpresa);
          if vDadosIni.vPedVnd.ManterVendOrigMesc then
          begin
            dtSetSinc.FieldByName('COD_VENDEDOR').AsInteger := dtSetOrcTemp.FieldByName('COD_VENDEDOR').AsInteger;
            if vDadosIni.vPedVnd.comissaoPorVenda then
              dtSetSinc.FieldByName('PERC_COMISSAO_VEND').AsFloat := dtSetOrcTemp.FieldByName('PERC_COMISSAO_VEND').AsFloat;
          end
          else
          begin
          dtSetSinc.FieldByName('COD_VENDEDOR').AsInteger := vDadosIni.vCodUsuario;
            if vDadosIni.vPedVnd.comissaoPorVenda then
              dtSetSinc.FieldByName('PERC_COMISSAO_VEND').AsFloat := vDadosIni.vPercProdVnd;

          end;
          dtSetSinc.FieldByName('COD_VENDEDOR1').Value := dtSetOrcTemp.FieldByName('COD_VENDEDOR1').Value;
          dtSetSinc.FieldByName('PERC_COMISSAO_VEND1').AsFloat := dtSetOrcTemp.FieldByName('PERC_COMISSAO_VEND1').AsFloat;
          dtSetSinc.FieldByName('ATIVO').AsInteger := 1;
          if Trim(pTipo) = 'OS' then
            dtSetSinc.FieldByName('seq_fech').AsInteger := Gencodigo('SEQ_FECH', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
          dtSetSinc.FieldByName('nped').AsInteger := nVenda;
          if nDAV > 0 then
            dtSetSinc.FieldByName('nprevenda').AsInteger := nDAV;
          if nPV > 0 then
            dtSetSinc.FieldByName('PAF_NUM_PREVENDA').AsInteger := nPV;
          dtSetSinc.FieldByName('tipo').AsString := pTipo; //'OS';
          dtSetSinc.FieldByName('data_ped').AsDateTime := vDadosIni.getDataBanco(buscas);
          dtSetSinc.FieldByName('HORAABERTURA').AsString := copy(timetostr(time), 1, 2);
          dtSetSinc.FieldByName('MINABERTURA').AsString := copy(timetostr(time), 4, 2);
          dtSetSinc.FieldByName('TIPV').AsString := dtSetOrcTemp.FieldByName('TIPV').AsString;//'V';
          dtSetSinc.FieldByName('TIPOR').AsString := dtSetOrcTemp.FieldByName('TIPOR').AsString;//'V';
          dtSetSinc.FieldByName('OBS_PED').AsString := vSing.vObs_Ped;
          dtSetSinc.FieldByName('OBS_OS').AsString := vSing.vObs_OS;
          if (pTipo = 'OS') and not(trim(dtSetOrcTemp.FieldByName('tipo_os').AsString)='') then
            dtSetSinc.FieldByName('tipo_os').AsString := dtSetOrcTemp.FieldByName('tipo_os').AsString
          else if (Trim(pTipo) <> 'REQ') then
            dtSetSinc.FieldByName('tipo_os').AsString := retornaValor(
            	' select first 1 tipo_os AS VALOR from tipo_vendas ' +
              ' where tipo=''OS'' order by ordemexibicao');
          dtSetSinc.FieldByName('estado_veic').AsString := vDadosIni.vEmp.vObsPadOS;
          dtSetSinc.FieldByName('H_ENT').value := now;
          dtSetSinc.FieldByName('DT_PROMETIDA').AsDateTime := DateOf(now);
          dtSetSinc.FieldByName('H_PROMETIDA').value := now;
          dtSetSinc.FieldByName('cod_cliente').AsInteger :=
            dtSetOrcTemp.FieldByName('cod_cliente').AsInteger;

          dtSetSinc.FieldByName('COD_COND_PAG').AsInteger :=
            dtSetOrcTemp.FieldByName('COD_COND_PAG').AsInteger;
          if dtSetSinc.FieldByName('COD_COND_PAG').AsString = '' then
            dtSetSinc.FieldByName('COD_COND_PAG').AsString := retornaValor(
            	' select first 1 cond_pag.cod_cond_pag AS VALOR from cond_pag ' +
              ' where cond_pag.ativo = 1 ');
          dtSetSinc.FieldByName('DATA_PED').AsDateTime := vDadosIni.getDataBanco(buscas);
          if conf.valores_nf.ConfActive('Conf_' + trim(pTipo), 'Ativa', 'N', 'S') then
          begin
            {
            if vDadosIni.vUsarPlano[1] in ['S', '2'] then
              vDadosIni.ShowAtencao('Configuração de calcular tributos da nota não compatível com o uso do Plano de Pagamento')
            else
            }
            begin
              dtSetSinc.FieldByName('nf_ac_calctrib').AsString := IfThen( conf.valores_nf.ConfActive('Conf_' + trim(pTipo), 'DefaultInclusao', 'N', 'S'), 'S', 'N');
              dtSetSinc.FieldByName('nf_freteconta').AsString  := IfThen( conf.valores_nf.ConfActive('Conf_' + trim(pTipo), 'Ativa', 'N', 'S'),
                                                                          conf.valores_nf.ReadString('Conf_' + trim(pTipo), 'FretePorConta', 'D'), 'D');
              dtSetSinc.FieldByName('nf_cf_deson_emb').AsString := IfThen( conf.valores_nf.ConfActive('Conf_' + trim(pTipo), 'ICMSDesoneradoEmbutido', 'N', 'S'), 'S', 'N');
            end;
          end;
          //os dois campos do mob ainda não estão indo pois talvez esta informação deva ir no item e não no cabeçalho
          //        dtSetSinc.FieldByName('NPEDMOB').AsVariant:=dataSet.FieldByName('NPEDMOB').AsVariant;
          //        dtSetSinc.FieldByName('IDMOBILE').AsVariant:=dataSet.FieldByName('IDMOBILE').AsVariant;

//            try
            try
              dtSetSinc.OnReconcileError := dataSetReconcileError;
              if dtSetSinc.ApplyUpdates(-1) > 0 then
              begin
                Result := false;
                raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
              end;
            finally
              dtSetSinc.OnReconcileError := nil;
            end;
//            except
//              on e: Exception  do
//                begin
//                  RollBackTransacao;
//                  registraErro('TPedVenda.MesclarDAVsOSREQ. ' +
//                    pTipo + ' - ' + IntToStr(nVenda) + ' - ' + 'PEDIDO' + ' - ' + 'Iniciado. Erro: ' + E.Message) ;
//                  Application.MessageBox(pchar(E.Message),'Atenção', 0 + 64);
//                  exit;
//              end;
//            end;
          pNPED := nVenda;

          if (pTipo = 'OS') or (pTipo = 'REQ') then
            vDadosIni.informarSituacaoPedido(
              nVenda, pTipo,
              'PEDIDO',
              'Iniciado',
              '',
              buscas, False, False);

        end
        else
        begin
          nVenda := pNPED;
          if dtSetSinc.FieldByName('STATUS_PED').AsString = 'FECHADA' then
          begin
            if not reabrirVenda(pNPED, pTipo) then
            begin
              result := false;
              exit;
            end;
          end;
        end;

        vItProd.dtSetIt.Close;
        vItProd.dtSetIt.Filtered := false;
        vItProd.dtSetIt.Filter := 'SELEC=''S'' and STATUS<>''CANCELADO''';
        vItProd.dtSetIt.Filtered := true;
        vItProd.dtSetIt.Open;
        vItProd.dtSetIt.IndexFieldNames := 'NITEM';

        vItServ.dtSetIt.Close;
        vItServ.dtSetIt.Filtered := false;
        vItServ.dtSetIt.Filter := 'SELEC=''S'' and STATUS<>''CANCELADO''';
        vItServ.dtSetIt.Filtered := true;
        vItServ.dtSetIt.Open;
        vItServ.dtSetIt.IndexFieldNames := 'NITEM';

        vItServTerc.dtSetIt.Close;
        vItServTerc.dtSetIt.Filtered := false;
        vItServTerc.dtSetIt.Filter := 'SELEC=''S''';
        vItServTerc.dtSetIt.Filtered := true;
        vItServTerc.dtSetIt.Open;
        vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';

        vItProdTerc.dtSetIt.Close;
        vItProdTerc.dtSetIt.Filtered := false;
        vItProdTerc.dtSetIt.Filter := 'SELEC=''S''';
        vItProdTerc.dtSetIt.Filtered := true;
        vItProdTerc.dtSetIt.Open;
        vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';

        if vItServ.dtSetIt.IsEmpty and vItProd.dtSetIt.IsEmpty then
        begin
          vItProd.dtSetIt.Close;
          vItProd.dtSetIt.Filtered := false;
          vItProd.dtSetIt.open;
          vItProd.dtSetIt.IndexFieldNames := 'NITEM';

          vItServ.dtSetIt.Close;
          vItServ.dtSetIt.Filtered := false;
          vItServ.dtSetIt.open;
          vItServ.dtSetIt.IndexFieldNames := 'NITEM';

          vItServTerc.dtSetIt.Close;
