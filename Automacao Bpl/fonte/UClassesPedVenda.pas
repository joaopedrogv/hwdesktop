procedure TOpcoesPag._marcaDesmarcaLinha;
var
  strFilter:string;
  vCodRegraTemp,vCondPagtemp,i,j:integer;
begin
  if dataSet.IsEmpty then
    exit;
  if UpperCase(trim(dataset.FieldbyName('Status').AsString)) = 'BARRADO' then
    exit;
  dataSet.Edit;
  if dataSet.FieldByName('sel').AsString = 'S' then
    dataSet.FieldByName('sel').AsString := ''
  else if not (UpperCase(trim(dataset.FieldbyName('Status').AsString)) = 'BARRADO') then
    dataSet.FieldByName('sel').AsString := 'S'
  else dataSet.FieldByName('sel').AsString := '';
  vCondPagtemp:=dataSet.FieldByName('cod_cond_pag').AsInteger;
  vCodRegraTemp:= dataSet.FieldByName('cod_regravnd').AsInteger;
  dataSet.Post;
  strFilter:='';

  if dataSet.FieldByName('SOBREPOR_PROMOCAO').AsString = 'S' then
    strFilter:=' SOBREPOR_PROMOCAO = ''S'' ';

  if (strFilter = '') and (dataSet.FieldByName('SOBREPOR_TABPRECO').AsString = 'S') then
    strFilter:=' SOBREPOR_TABPRECO = ''S'' '
  else if (dataSet.FieldByName('SOBREPOR_TABPRECO').AsString = 'S') then
    strFilter:= strFilter+ ' and SOBREPOR_TABPRECO = ''S'' ';

  if (strFilter = '') and (dataSet.FieldByName('SOBREPOR_MAXDESCPROD').AsString = 'S') then
    strFilter:=' SOBREPOR_MAXDESCPROD = ''S'' '
  else if dataSet.FieldByName('SOBREPOR_MAXDESCPROD').AsString = 'S' then
    strFilter:= strFilter + ' and SOBREPOR_MAXDESCPROD = ''S'' ';

  {if (strFilter = '') and (dataSet.FieldByName('VLVND_MINDESC').AsFloat > 0) then
    strFilter:= ' VLVND_MINDESC >= ' +floattostr(dataSet.FieldByName('VLVND_MINDESC').AsFloat)
    //no filter não usa trocar o ponto por vírgula (vDadosIni.trocaVirgulaPorPonto(floattostr(dataSet.FieldByName('VLVND_MINDESC').AsFloat)));
  else if dataSet.FieldByName('VLVND_MINDESC').AsFloat > 0 then
    strFilter:= strFilter + ' and VLVND_MINDESC >= ' +floattostr(dataSet.FieldByName('VLVND_MINDESC').AsFloat);
  }
  if (strFilter <> dataSet.Filter) and (strFilter<>'') then
  begin
    dataSet.Filter:= strFilter;
    dataSet.Filtered:= true;
  end;
  dataSet.Locate('cod_cond_pag;cod_regravnd',VarArrayOf([vCondPagtemp, vCodRegraTemp]), [loCaseInsensitive]);

  if dataSet.FieldByName('sel').AsString <> 'S' then
  begin
    j:=0;
    first;
    for I := 0 to dataSet.RecordCount - 1 do
      if dataSet.FieldByName('sel').AsString = 'S' then
        inc(j);
    if j=0 then
    begin
      dataSet.Filter:='';
      dataSet.Filtered:= false;
      dataset.Refresh;
    end;
    dataSet.Locate('cod_cond_pag;cod_regravnd',VarArrayOf([vCondPagtemp, vCodRegraTemp]), [loCaseInsensitive]);
  end;
end;

