procedure TPedVenda.restaurar;
var
  vprocesso: string;
  resultado: boolean;
begin
  if getTipoVenda = 'REQ' then
    vprocesso := 'VND057'
  else if getTipoVenda = 'OS' then
    vprocesso := 'VND058'
  else
    vprocesso := 'VND059';

  if not vDadosIni.PesqPros(vprocesso, 'RESTAURAR', 'RESTAURAR ' + getTipoVenda + ' Nº ' +
    dataSet.FieldByName('NPED').AsString + ' DA LIXEIRA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
    Exit;

  if dataSet.IsEmpty then
    exit;
  if dataSet.FieldByName('ATIVO').asinteger = 1 then
    exit;
  if dataSet.FieldByName('ATIVO').asinteger = 0 then
  begin
    if Application.MessageBox('Tem certeza que deseja restaurar o registro selecionado?',
      'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
    begin
      dataSet.Edit;
      dataSet.FieldByName('ATIVO').asinteger := 1;
      dataSet.Post;
      resultado := Apply;
      if resultado then
        resultado := CommitaTransacao;
      if resultado then
        vDadosIni.GravaAuditoria(vprocesso, 'RESTAURAR', 'SUCESSO AO RESTAURAR ' + getTipoVenda + ' Nº ' +
          dataSet.FieldByName('NPED').AsString + ' DA LIXEIRA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
      else
        vDadosIni.GravaAuditoria(vprocesso, 'RESTAURAR', 'FALHA AO RESTAURAR ' + getTipoVenda + ' Nº ' +
          dataSet.FieldByName('NPED').AsString + ' DA LIXEIRA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
    end;
  end;
end;

function TPedVenda.retornaObsREQ_OS(pOBS: string; pCodClienteOld,
  pCodClienteNew: Integer): string;
var
  vObsReqOS: string;
begin
	try
    Result := pOBS;

    if pCodClienteOld > 0 then
    begin
      SqlOpen(' select obs_req_os from clientes ' +
        ' where cod_cliente = ' + IntToStr(pCodClienteOld) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);
      vObsReqOS := trim(buscas.FieldByName('obs_req_os').AsString);

      Result := trim(StringReplace(trim(Result), trim(vObsReqOS), '', [rfReplaceAll]));
    end;

    if pCodClienteNew > 0 then
    begin
      SqlOpen(' select obs_req_os from clientes ' +
        ' where cod_cliente = ' + IntToStr(pCodClienteNew) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas);
      vObsReqOS := trim(buscas.FieldByName('obs_req_os').AsString);

      Result := trim(vDadosIni.IfThen(trim(Result) <> '', trim(Result) + ' ', '') + trim(vObsReqOS));
    end;

  except
    on e: exception do
    begin
      Result := pOBS;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.retornaValeResgate(pnped: Integer; ptipo: string; pvaletroca, pvaleregaste: string): string;
begin
 Result := pvaleregaste; 
 if ((vDadosIni.vProgFid.vHabilitarProgFid) and ((trim(ptipo) = 'REQ') or (trim(ptipo) = 'OS'))) then
    if ((pvaletroca = 'N') and (pvaleregaste = 'N')) then
    begin
       SqlOpen(' select count(*) valor_vale_prg from conta_corrente_prog_fidelidade ' +
         ' where ndoc = ' + IntToStr(pnped) + ' and tipodoc = ' + QuotedStr(ptipo) +
         ' and cod_emp_tipodoc = ' + vDadosIni.codEmpresa +
         ' and pontos > 0 and vale = ''S'' ' +
         ' and coalesce((select result from pos(''DÉBITO'', descricao)), 0) > 0 ');
       Result := IfThen(buscas.FieldByName('VALOR_VALE_PRG').AsFloat > 0, 'S', 'N');
    end;
end;

