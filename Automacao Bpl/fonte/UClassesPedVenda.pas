      APedVenda.vCliente.abreClientes(APedVenda.dataSet.FieldByName('COD_CLIENTE').AsInteger);
    APedvenda.RollBackTransacao;
    if Assigned(APedvenda) then
   	  FreeAndNil(APedvenda);
    Screen.Cursor := crDefault;
  end;
end;

function buscarProduto(ANumFab: string; AGrupoProd: Integer; ACodProd: string;
   ACodGrade: Integer; ADescrProd: string; AUseTransactionIni: Boolean = False): boolean;
var
  APedvenda: TPedvenda;
  ABuscas: TIBQuery;
  vTemp: string;
  vCondPag: Integer;
begin
  try
    Result := false;

    if DtmPedVenda = nil then
    	DtmPedVenda := TDtmPedVenda.create(DtmPedVenda);

    APedvenda 													      := TPedVenda.create(DtmPedVenda);
    ABuscas 	 	  														:= TIBQuery.Create(APedvenda.buscas);
    ABuscas.Database 													:= APedvenda.buscas.Database;
    if not AUseTransactionIni then
    	ABuscas.Transaction												:= APedvenda.buscas.Transaction;
    APedvenda.buscas 										         := ABuscas;
    if AUseTransactionIni then
      ABuscas.Transaction                							:= vDadosIni.vTransactionTmp;
    APedvenda.buscas.Database 								:= APedvenda.buscas.Database;
    APedvenda.transacao 										:= ABuscas.Transaction;
    APedvenda.buscas.Transaction								:= ABuscas.Transaction;
    APedvenda.vSing.vTipoVenda := 'REQ';
    APedvenda.inserirVenda(false);

    APedvenda.SqlOpen(' select first 1 cond_pag.cod_cond_pag from cond_pag ' +
    	' inner join cond_pag_empresa on ' +
      ' 	cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
      '	  and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
		  ' where cond_pag.ativo = 1 ' +
      ' and cond_pag.desc_cond_pag = ''A VISTA'' ' +
      ' order by cond_pag.cod_cond_pag ');
    vCondPag := vDadosIni.IfThen(not APedvenda.buscas.IsEmpty, APedvenda.buscas.FieldByName('cod_cond_pag').AsInteger, 1);

    APedvenda.vCondPag.abreCondPag(vCondPag);
//    APedvenda.vItProd._setaVariaveisPromocao(0, 0, 0, APedvenda.dataSet.FieldByName('cod_cond_pag').AsInteger, 0, 'V');
    APedvenda.vItProd.insert;
    if not APedvenda.vItProd.buscaProduto(ANumFab, AGrupoProd, ACodProd, 0, true, false, false, false) then
      exit;

    vTemp := APedvenda.vItProd.dataSet.FieldByName('num_fab_prod').AsString;
    vTemp := vTemp + '|' + APedvenda.vItProd.dataSet.FieldByName('grupo_prod').AsString;
    vTemp := vTemp + '|' + APedvenda.vItProd.dataSet.FieldByName('cod_prod').AsString;
    vTemp := vTemp + '|' + APedvenda.vItProd.dataSet.FieldByName('cod_grade').AsString;
    vTemp := vTemp + '|' + Copy(APedvenda.vItProd.dataSet.FieldByName('descr_prod_ped').AsString, 1, 75);
    vTemp := vTemp + '|' + FloatToStr(APedvenda.vItProd.vProduto.dataSet.FieldByName('prec_tab_prod').AsFloat);
    			//FloatToStr(APedvenda.vItProd.dataSet.FieldByName('vlun_ped_item').AsFloat);
    vTemp := vTemp + '|';

    vDadosIni.vPesquisa := vTemp;

    Result := true;
  finally
    APedvenda.RollBackTransacao;
    if Assigned(APedvenda) then
    	FreeAndNil(APedvenda);
    if Assigned(ABuscas) then
    	FreeAndNil(ABuscas);
  end;
end;

