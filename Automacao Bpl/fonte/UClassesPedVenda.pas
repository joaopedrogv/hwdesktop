    if Itens then
    begin
      dtSetSincIt.IndexFieldNames := '';
      dtSetSincIt.Cancel;
      dtSetSincIt.Close;
      dtSetSincIt.FieldDefs.Clear;
      for I := 0 to vDtSet.FieldDefs.Count - 1 do
        dtSetSincIt.FieldDefs.Add(
          vDtSet.FieldDefs[i].Name,
          vDtSet.FieldDefs[i].DataType,
          vDtSet.FieldDefs[i].Size,
          false);
    end
    else
    begin
      dtSetSinc.Cancel;
      dtSetSinc.Close;
      dtSetSinc.FieldDefs.Clear;
      for I := 0 to vDtSet.FieldDefs.Count - 1 do
        dtSetSinc.FieldDefs.Add(
          vDtSet.FieldDefs[i].Name,
          vDtSet.FieldDefs[i].DataType,
          vDtSet.FieldDefs[i].Size,
          false);
    end;
    Result := True;
  except
    Result := false;
  end;
end;

