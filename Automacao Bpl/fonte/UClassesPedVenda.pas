  vSql, vSql2, vSql3, vSql4: string;
  vExisteCtrlPadrao: boolean;
begin
  try
  	Result := False;
    
  	vExisteCtrlPadrao := _existeControlesPadrao;

    vSql2 :='';
    vSql := ' SELECT CODIGO_CTRL, NOME_CTRL, QSEQPERF FROM CONTROLES' +
        ' WHERE CXENT = ''S'' ' +
        ' AND ATIVO = 1 ' +
        ' AND CODIGO_EMP = ' + vDadosIni.codEmpresa;
        
    if Trim(pControlesCliente) <> '' then
      vSql2 := vSql2 + ' AND CODIGO_CTRL IN ' + pControlesCliente
    else if (vExisteCtrlPadrao) and (Trim(pControlesCliente) = '') then
    	vSql2 := vSql2 + ' AND COALESCE(FP_PADRAO_CL, ''N'') = ''T'' ';

    if vDadosIni.vEmp.vFinanceiroUnificado then
		  vSql2 := vSql2 + ' AND (COALESCE(CONTROLE_VISIVEL, ''S'') = ''S'') ';

    if (vExisteCtrlPadrao) and (trim(pControlesCliente) <> '') then
    begin
    	vSql4 := '';
      vSql3 := ' UNION ' +
      	' SELECT CODIGO_CTRL, NOME_CTRL, QSEQPERF FROM CONTROLES' +
        ' WHERE CXENT = ''S'' ' +
        ' AND ATIVO = 1 ' +
        ' AND CODIGO_EMP = ' + vDadosIni.codEmpresa;

      vSql4 := vSql4 + ' AND COALESCE(FP_PADRAO_CL, ''N'') = ''T'' ';
      
      if vDadosIni.vEmp.vFinanceiroUnificado then
		  	vSql4 := vSql4 + ' AND (COALESCE(CONTROLE_VISIVEL, ''S'') = ''S'') ';
    end;

    if trim(pControlesCliente) <> '' then
    	Result := montaSelect(vSql + vSql2 + vSql3 + vSql4 + ' ORDER BY 3')
    else
	    Result := montaSelect(vSql + vSql2 + ' ORDER BY 3');

  except
  	result := montaSelect(vSql + ' ORDER BY 3');
  end;
end;

