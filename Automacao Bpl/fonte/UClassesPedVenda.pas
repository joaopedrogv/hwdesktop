          MB_OK);
        Result := FALSE;
        Exit;
      end;
    end;
  end;
  Result := true;
end;

function TPedVenda.verificaComissaoProdutos: Boolean;
var
  vTeste: Integer;
begin
  ///  Agora o calculo de comissao esta sendo chamado no metodo de efetuaRateios para otimizar o processamento.
  ///  Este metodo esta sendo usado apenas no caso do plano de pagamento
  result := true;
  vTeste := 0;
  vItProd.dataSet.DisableControls;
  vItProd.dataSet.First;
  vDadosIni.abreStatusProcessamento('', 'Calculando Comissão por item');
  while not vItProd.dataSet.Eof do
  begin
    vItProd.vProduto.buscaProduto(
      vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
      vItProd.dataSet.FieldByName('cod_prod').AsString);
    vItProd.dataSet.Edit;
    if (vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD').AsFloat > 0) then
    begin
      vItProd.dataSet.FieldByName('comiss_prod').AsCurrency := ((vItProd.getValorLiqParaMargem *
        vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) *
        vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD').AsFloat) / 100
    end
    else
    begin
      if ((vSing.vTipoVenda <> 'ORC') and ((vTeste = 0) or (vTeste = 1))) then
      begin
        vDadosIni.vInibeMensPesqPros := 'S';

        if not vDadosIni.PesqPros('VND158', 'VALIDAR', dataSet.FieldByName('TIPO').AsString +
        	' - VERIFICAR PERC. DE COMISSAO NO CADASTRO DO PRODUTO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
        begin
          if Application.MessageBox(pchar('Item Nº ' + vItProd.dataSet.FieldByName('NITEM').AsString +
            ' - ' + QuotedStr(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString) + ' sem percentual de comissão, caso continue com esta operação a comissão deste produto não será calculada, Deseja continuar assim mesmo?'), 'Confirmação',
            MB_ICONQUESTION + MB_YESNO) = IDNO then
          begin
            result := false;
            vDadosIni.fechaStatusProcessamento;
            exit;
          end;

          if vTeste = 0 then
          begin
            if Application.MessageBox(pchar('Exibir está mensagem novamente? '+#13 + #13+
            ' Sim - O sistema realizará a verificação de comissão em cada item.'+#13+
            ' Não - O sistema não realizará a verificação da comissão nos próximos itens.'), 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDYES then
              vTeste := 1
            else
              vTeste := 2
          end;

          if not vDadosIni.PesqPros('VND159', 'VALIDAR', dataSet.FieldByName('TIPO').AsString + ' - ' +
          	'PERMITIR VENDA DE PRODUTO SEM PERC. DE COMISSAO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
          begin
            result := false;
            vDadosIni.fechaStatusProcessamento;
            exit;
          end;
        end;
      end;

      vItProd.dataSet.FieldByName('comiss_prod').AsCurrency := 0;
    end;
    if (vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD_Ger').AsFloat > 0) then
      vItProd.dataSet.FieldByName('comiss_prod_ger').AsCurrency := ((vItProd.getValorLiqParaMargem *
        vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) *
        vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD_Ger').AsFloat) / 100
    else
      vItProd.dataSet.FieldByName('comiss_prod_ger').AsCurrency := 0;
    vItProd.dataSet.Post;
    vItProd.dataSet.Next;
  end;
  vItProd.dataSet.EnableControls;
  vDadosIni.fechaStatusProcessamento;
end;

function TPedVenda.verificaFechamento(vtp: integer): boolean;
var
  vstatusped: string;
begin
  // 1 - verificar se está fechando
  if vtp = 1 then
  begin
    vstatusped := retornaValor('select status_ped as valor from pedvenda' +
      ' where nped = ' + dataSet.FieldByName('nped').AsString +
      ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and tipo = ' +
      QuotedStr(vSing.vTipoVenda));
    if (vstatusped = 'FECHANDO') or (vstatusped = 'FECHADA')
      or (vstatusped = 'CANCELANDO') or (vstatusped = 'CANCELADO') then
      result := true
    else
      Result := false;
  end;
  // 2 - Colocar Fechando
  if vtp = 2 then
  begin
    try
      dataset.Edit;
      dataset.FieldByName('status_ped').AsString := 'FECHANDO';
      if dataSet.FieldByName('idmobile').AsInteger > 0 then
      begin
        calculaDescontoAcrescimo;
        if (vDadosIni.vEmp.vUsarDAV = 'S') and (dataset.FieldByName('nprevenda').AsInteger = 0) then
          dataset.FieldByName('nprevenda').AsInteger := Gencodigo('PREVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      end;

      dataSet.Post;
      dataset.ApplyUpdates(-1);
      CommitaTransacao;
      result := true;
    except
      on e: exception do
      begin
        RollBackTransacao;
        Result := false;
        if Application.MessageBox(pchar('Erro ao Tentar fechar a Venda. Mostrar Erro?'), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO) = IDYES then
          Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  end;
  // 3 - Retirar Fechando
  if vtp = 3 then
  begin
    if dataset.FieldByName('status_ped').AsString = 'FECHANDO' then
    begin
      dataset.Edit;
      dataset.FieldByName('status_ped').AsString := '';
      dataSet.Post;
      Apply;
      CommitaTransacao;
      result := true;
    end
    else
    begin
      Application.MessageBox(pchar('O Status do pedido não está definido como o de ''FECHANDO'''), 'Atenção',
          MB_ICONEXCLAMATION + MB_OK);
      result:=false;
    end;
  end;
  // 4 - Retirar Fechando
  if vtp = 4 then
  begin
    RollBackTransacao;
    abrePedVenda(f_int('nped'));
   	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
    vItProd.abrePedVendaProd(f_int('nped'));
    if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
    begin
      vItServ.abrePedVendaServ(f_int('nped'));
      vItServTerc.abreServicoTerceiro(f_int('nped'));
      vItProdTerc.abreProdTerceiro(f_int('nped'));
    end;
    dataset.Edit;
    dataset.FieldByName('status_ped').AsString := '';
    efetuaRateios(true);
    dataSet.Post;
    Apply;
    vItProd.Apply;
    if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
      vItServ.Apply;
    CommitaTransacao;
    result := true;

    if vSing.vTipoVenda = 'REQ' then
      vSing.nomeVenda := 'a Requisição'
    else if vSing.vTipoVenda = 'OS' then
      vSing.nomeVenda := 'a Ordem de Serviço'
    else
      vSing.nomeVenda := 'o Orçamento';

    Application.MessageBox(Pchar('Total da ' +
    	IfThen(vSing.vTipoVenda = 'REQ', 'Requisição', 'Ordem de Serviço') +
      ' Atualizado' + #13 + #13 + 'Favor realizar a confirmação novamente.') , 'Atenção', MB_ICONINFORMATION + MB_OK);
  end;
end;

