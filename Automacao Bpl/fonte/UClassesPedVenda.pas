function TPedVenda.ChecaExistenciaPedido(NPedido: Integer): boolean;
begin
  result := true;
  buscas.close;
  buscas.SQL.Text := 'SELECT NPED FROM PEDVENDA WHERE NPED = ' + inttostr(NPedido) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    Application.MessageBox(PChar('Erro ao salvar a requisição' + chr(13) +
      'Número de requisição já existente.' + chr(13) +
      'O número da requisição será ajustado para o maior número existente + 1.'), 'Erro', MB_OK
      +
      MB_ICONERROR + MB_DEFBUTTON1);
    buscas.close;
    buscas.SQL.Text := 'select max(nped) as MAXIMO from pedvenda where' +
      ' cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    while dataSet.FieldByName('NPED').AsInteger <= buscas.FieldByName('MAXIMO').asinteger do
      dataSet.FieldByName('NPED').AsInteger := Gencodigo('PEDVENDA', DtmPed.SpIncCodigo,
        vDadosIni.codEmpresa);
    result := false;
  end
end;

