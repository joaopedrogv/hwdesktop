      if (pTipo = 'OS') then
        Application.MessageBox(Pchar('Ordem de Serviço informada não encontrada.' + chr(13) + 'Favor verificar.'), 'Atenção', +MB_ICONWARNING + MB_OK)
      else if (pTipo = 'REQ') then
        Application.MessageBox(Pchar('Requisição de Venda informada não encontrada.' + chr(13) + 'Favor verificar.'), 'Atenção', +MB_ICONWARNING + MB_OK);
