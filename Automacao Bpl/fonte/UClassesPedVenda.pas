  procedure impCondPag;
  var
    itxpl: integer;
  begin
    if (vDadosIni.vImpDavReduzidoDetalhado.vDeclSpc <> 'S')
    	and ((vDadosIni.vUsarPlano = 'S') or (vDadosIni.vUsarPlano = '2')) then
    begin
      vInfoPlano.Clear;

      vQuery.close;
      vQuery.sql.Text := 'select * from plano_pag ' +
        ' where nrequisicao = ' + dataSet.FieldByName('NPED').AsString +
        ' and tpdocs = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1 ' +
        ' order by seqplano ';
      vQuery.Open;
      if not vQuery.IsEmpty then
      begin
        vInfoPlano.Clear;
        vInfoPlano.Text := vQuery.FieldByName('TEXTO_PLANO').AsWideString;
      end;
      for itxpl := 0 to vInfoPlano.Count - 1 do
      begin
        RdpDav.Impf(vlnplano, 65, vInfoPlano[itxpl], [comp20]);
        vlnplano := vlnplano + 1;
      end;
      vContP := 0;
      vQuery.First;
      while not vQuery.Eof do
      begin
        inc(vcontP);
        RdpDav.Impf(vlnplano, 65, vDadosIni.StrZero(vQuery.FieldByName('NREQUISICAO').AsInteger, 6) + '-' + IntToStr(vcontp), [comp20]);
        RdpDav.Impf(vlnplano, 75, vQuery.FieldByName('DATA_VENC').AsString, [comp20]);
        RdpDav.ImpD(vlnplano, 95, format('%12.2f', [vQuery.FieldByName('VALORDOC').AsFloat]), [comp20]);
        vQuery.Next;
        if not vQuery.Eof then
        begin
          inc(vcontP);
          RdpDav.Impf(vlnplano, 97, vDadosIni.StrZero(vQuery.FieldByName('NREQUISICAO').AsInteger, 6) + '-' + IntToStr(vcontp), [comp20]);
          RdpDav.Impf(vlnplano, 107, vQuery.FieldByName('DATA_VENC').AsString, [comp20]);
          RdpDav.Impf(vlnplano, 119, format('%12.2f', [vQuery.FieldByName('VALORDOC').AsFloat]), [comp20]);
          vQuery.Next;
        end;
        vlnplano := vlnplano + 1;
        {if vContP >= 8 then
          Break;}
        if vlnplano >= qtdeLinhas then
        begin
          linha := 1;
          RdpDav.Novapagina;
          novaPag;
          Cabreq;
          linha := linha + 1;
          vlnplano := linha;
        end;
      end;
    end
    else if (vDadosIni.vImpDavReduzidoDetalhado.vDeclSpc <> 'S')
    	and (vDadosIni.vImpDavReduzidoDetalhado.vFormPag = 'S')
    	and ((vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2')) then
    begin
    	vQuery.close;
      vQuery.sql.Text := 'select * from dados_recebimento ' +
        ' where nrequisicao = ' + dataSet.FieldByName('NPED').AsString +
        ' and tpdocs = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' order by seqform ';
      vQuery.Open;

      vQuery.First;
      while not vQuery.Eof do
      begin
        inc(vcontP);
        RdpDav.Impf(vlnplano, 61, Copy(trim(vQuery.FieldByName('NOME_CTRL').AsString), 1, 15), [comp20]);
        RdpDav.Impf(vlnplano, 75, vQuery.FieldByName('DATA_VENC').AsString, [comp20]);
        RdpDav.ImpD(vlnplano, 96, format('%12.2f', [vQuery.FieldByName('VALORDOC').AsFloat]), [comp20]);
        vQuery.Next;

        if not vQuery.Eof then
        begin
          inc(vcontP);
          RdpDav.Impf(vlnplano, 98, Copy(trim(vQuery.FieldByName('NOME_CTRL').AsString), 1, 15), [comp20]);
          RdpDav.Impf(vlnplano, 112, vQuery.FieldByName('DATA_VENC').AsString, [comp20]);
          RdpDav.ImpD(vlnplano, 133, format('%12.2f', [vQuery.FieldByName('VALORDOC').AsFloat]), [comp20]);
          vQuery.Next;
        end;

        vlnplano := vlnplano + 1;
        {if vContP >= 8 then
          Break;}
        if vlnplano >= qtdeLinhas then
        begin
          linha := 1;
          RdpDav.Novapagina;
          novaPag;
          Cabreq;
          linha := linha + 1;
          vlnplano := linha;
        end;
      end;
    end
    else if (vDadosIni.vImpDavReduzidoDetalhado.vDeclSpc <> 'S')
    	and ((vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2')) then
    begin
      vQuery.close;
      vQuery.sql.Text := 'select fp.ndoc,fp.valordoc,fp.data_venc from formpagamento fp' +
        ' where (((fp.nrequisicao = ' + dataSet.FieldByName('NPED').AsString + ') ' +
        ' 	and fp.tpdocs = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) + ') ' +
        ' or ((fp.rec_numvend = ' + dataSet.FieldByName('NPED').AsString + ') ' +
        ' 	and fp.tpdocs <> ''LCS'' ' +
        ' 	and fp.rec_tipvend = ' + QuotedStr(trim(dataSet.FieldByName('TIPO').AsString)) + ')) ' +
        ' and fp.tipdoc <> ''N'' ' +
        ' and fp.ativo = 1 ' +
        ' and fp.cod_empresa = ' + vDadosIni.codEmpresa;
      vQuery.Open;
      vContP := 0;
      while not vQuery.Eof do
      begin
        inc(vcontP);
        RdpDav.Impf(vlnplano, 65, vQuery.FieldByName('ndoc').AsString, [comp20]);
        RdpDav.Impf(vlnplano, 75, vQuery.FieldByName('data_venc').AsString, [comp20]);
        RdpDav.Impf(vlnplano, 87, vdadosini.AlnDir(Trim(format('%12.2f', [vQuery.FieldByName('valordoc').AsFloat])), 8), [comp20]);
        vQuery.Next;
        if not vQuery.Eof then
        begin
          RdpDav.Impf(vlnplano, 97, vQuery.FieldByName('ndoc').AsString, [comp20]);
          RdpDav.Impf(vlnplano, 107, vQuery.FieldByName('data_venc').AsString, [comp20]);
          RdpDav.Impf(vlnplano, 119, vdadosini.AlnDir(Trim(format('%12.2f', [vQuery.FieldByName('valordoc').AsFloat])), 8), [comp20]);
          vQuery.Next;
        end;
        vlnplano := vlnplano + 1;
        {if vContP >= 4 then
          Break;}
        if vlnplano >= qtdeLinhas then
        begin
          linha := 1;
          RdpDav.Novapagina;
          novaPag;
          Cabreq;
          linha := linha + 1;
//            if linha < vlnDeclReq then
//              linha := vlnDeclReq;
          vlnplano := linha;
        end;
      end;
    end;
  end;

  function existeItensCancelados: Boolean;
  begin
    Result := True;
    vItProd.dataSet.First;
    while not vItProd.dataSet.Eof do
    begin
      if Trim(vItProd.dataSet.FieldByName('status').AsString) = 'CANCELADO' then
        Exit;
      vItProd.dataSet.Next;
    end;

    if vSing.vTipoVenda <> 'REQ' then
    begin
      vItServ.dataSet.First;
      while not vItServ.dataSet.Eof do
      begin
        if Trim(vItServ.dataSet.FieldByName('status').AsString) = 'CANCELADO' then
          Exit;
        vItServ.dataSet.Next;
      end;
    end;
    Result := False;
  end;

