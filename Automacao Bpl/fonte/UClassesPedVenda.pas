function TPedVenda.ChecaParticipante: boolean;
begin
	try
    result := true;
    if not vDadosIni.vPedVnd.habPartipante then
    	exit;
      
    if not dataSet.FieldByName('COD_VENDEDOR1').IsNull then
    begin
      result := true;
      buscas.Close;
      buscas.SQL.Text := 'select cod_participante from participante ' +
      	' where cod_participante = ' + dataSet.FieldByName('COD_VENDEDOR1').AsString +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1';
      vDadosIni.abreStatusProcessamento('', 'Verificando ' + vDadosIni.vPedVnd.descricaoParticipante);
      buscas.Open;
      if buscas.isempty then
      begin
        vDadosIni.fechaStatusProcessamento;
        Application.MessageBox(PChar(vDadosIni.vPedVnd.descricaoParticipante +
          ' não encontrado'), 'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        Result := false;
      end
      else
        result := true;
    end;

    if result then
    begin
      if vSing.vTipoVenda <> 'OS' then
      begin
        vDadosIni.abreStatusProcessamento('', 'Alterando Código  ' +vDadosIni.vPedVnd.descricaoParticipante+ ' nos itens');
        try
          vItProd.dataSet.DisableControls;
        vItProd.dataSet.First;
        while not vItProd.dataSet.eof do
        begin
          if dataSet.FieldByName('COD_VENDEDOR1').AsInteger <= 0 then
          begin
            vItProd.dataSet.edit;
            vitprod.dataSet.FieldByName('COD_VENDEDOR1').Value := Null;
            vItProd.dataSet.Post;
          end
          else if vitprod.dataSet.FieldByName('COD_VENDEDOR1').AsInteger <> dataSet.FieldByName('COD_VENDEDOR1').AsInteger then
          begin
            vItProd.dataSet.edit;
            vitprod.dataSet.FieldByName('COD_VENDEDOR1').AsInteger := dataSet.FieldByName('COD_VENDEDOR1').AsInteger;
            vItProd.dataSet.Post;
          end;

          vItProd.dataSet.next;
        end;
        finally
          vItProd.dataSet.EnableControls;
        end;
        vDadosIni.fechaStatusProcessamento;
      end;
    end;
  except
    result := false;
  end;
  vDadosIni.fechaStatusProcessamento;
end;

