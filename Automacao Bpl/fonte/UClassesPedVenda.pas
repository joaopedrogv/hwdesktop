end;

function TPedVenda.finalizarSeparacao: Boolean;
var
  vNumPedVenda: Integer;
  vStatusPed, vStatusSepConf: string;
begin
  Result := False;

  if Application.MessageBox('Deseja finalizar o processo de Separação?',
    'Confirmação', MB_ICONQUESTION + MB_YESNO) <> ID_YES then
    Exit;

  if not vDadosIni.PesqPros('VND186', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
  	IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas, true) then
    	Exit;

  try
    vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;
    buscas.Close;
    buscas.SQL.Text := 'select STATUS_PED, STATUS_SEP_CONF, TIPV, COD_CLIENTE, APROVADA_GERENTE, AUTORIZADO_FINANCEIRO' +
      ' from PEDVENDA' +
      ' WHERE NPED = ' + IntToStr(vNumPedVenda) +
      ' AND TIPO = ''REQ'' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vStatusPed := Trim(buscas.FieldByName('STATUS_PED').AsString);
    vStatusSepConf := Trim(buscas.FieldByName('STATUS_SEP_CONF').AsString);

    if Trim(vStatusPed) <> '' then
      raiseExceptionCreate('Separação do Pedido não pode ser Finalizada pois o pedido já está ' + vStatusPed, '');

    if (Trim(vStatusSepConf) <> 'EM SEPARACAO') and (Trim(vStatusSepConf) <> 'SEPARACAO') and (Trim(vStatusSepConf) <> '') then
      raiseExceptionCreate('Separação do Pedido não pode ser finalizada pois já esta como: ' + vStatusSepConf, '');

    if not gerenteAutorizou(vNumPedVenda) then
      raiseExceptionCreate('Separação do Pedido não pode ser finalizada pois está aguardando autorização do Gerente', '');

    if not financeiroAutorizou(vNumPedVenda) then
      raiseExceptionCreate('Separação do Pedido não pode ser finalizada pois está aguardando liberação do Financeiro', '');

    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Iniciado', '', buscas, False, False, False);
    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Finalizado', '', buscas, False, False, False);

    Result := vDadosIni.mudarStatusSeparacao(vNumPedVenda, 'REQ', cSeparado, buscas, True);

    if Result then
      vDadosIni.GravaAuditoria('VND186', 'ALTERAR', 'SUCESSO', 'PEDVENDA', IntToStr(vNumPedVenda), buscas)
    else
      vDadosIni.GravaAuditoria('VND186', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);

  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('VND186', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registrarEntrega('function TPedVenda.finalizarSeparacao. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.financeiroAutorizou(pNPed: Integer): Boolean;
begin
  Result := True;
  if Trim(vSing.vTipoVenda) <> 'REQ' then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select c.usar_liberacao_financeiro usar_liberacao_financeiro_cl,' +
    ' t.usar_liberacao_financeiro usar_liberacao_financeiro_tv, p.autorizado_financeiro from pedvenda p' +
    ' left join clientes c on c.cod_cliente = p.cod_cliente and c.cod_empresa = p.cod_empresa' +
    ' left join tipo_vendas t on t.tipo = p.tipo and t.sigla = p.tipv' +
    ' where p.nped = ' + IntToStr(pNPed) +
    ' and p.tipo = ''REQ'' and p.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (Trim(buscas.FieldByName('usar_liberacao_financeiro_cl').AsString) = 'S') or
    (Trim(buscas.FieldByName('usar_liberacao_financeiro_tv').AsString) = 'S') then
    if Trim(buscas.FieldByName('autorizado_financeiro').AsString) <> 'S' then
      Result := False;
end;

