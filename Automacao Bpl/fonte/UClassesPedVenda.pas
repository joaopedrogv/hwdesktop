function TPedVenda.GetValorProdQuePermiteDesconto: Double;
begin
  Result := 0;
  vItProd.dtSet.First; //dataset temporário
  while not vItProd.dtSet.Eof do
  begin
    if trim(vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
    begin
    	if ExecutaComandosSql('select grupo_prod, cod_prod from produtos ' +
        ' where grupo_prod = ' + IntToStr(vItProd.dtSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + //' and coalesce(consumo,'''') <> ''S''' +
        ' and ativo = 1 ' +
        ' and coalesce(permitir_desconto,'''') <> ''N'' ' +
        ' and coalesce(em_promocao,'''') <> ''S''')
        and (vDadosIni.strIn(vItProd.dtSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q']))
        and (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
        	Result := Result +
          	(vItProd.dtSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            	vItProd.dtSet.FieldByName('VLUN_PED_ITEM').AsFloat)
      else if ExecutaComandosSql('select grupo_prod, cod_prod from produtos ' +
      	' where grupo_prod = ' + IntToStr(vItProd.dtSet.FieldByName('grupo_prod').AsInteger) +
        ' and cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + //' and coalesce(consumo,'''') <> ''S''' +
        ' and ativo = 1 ' +
        ' and coalesce(permitir_desconto, '''') <> ''N'' ' +
        ' and coalesce(em_promocao, '''') <> ''S''')
        and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'P')
        and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'T')
        and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'Q') then
        	Result := Result +
          	(vItProd.dtSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            	vItProd.dtSet.FieldByName('VLUN_PED_ITEM').AsFloat);
    end;
    vItProd.dtSet.Next;
  end;
end;

