    vItProd.acrescimoV := 0;
    vItProd.descontoP := 0;
    vItProd.descontoV := 0;
    vItProd.descontoVini := 0;

    if (vSing.vEmitNf = 'S') or (vSing.vUsarDAV = 'S') then
    begin
      result := true;
      Insert;
      dataSet.FieldByName('NPED').AsInteger := 0;
      //;Gencodigo('PEDVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      dataSet.FieldByName('COD_EMPRESA').AsInteger := strToint(vDadosIni.codEmpresa);
