function TPedVenda.temEstoqueProduto(grupo: integer; codigo: string;
  qtdeVenda: real): boolean;
var
  vest: real;
  vQtdeItem: real;
begin
  vItProd.vProduto.vQtdEstoqueDisponivel := 0;
  Result := false;
  vest := vItProd.vProduto.getQtdeDisponivelEmEstoque(grupo, codigo);
  vItProd.vProduto.vQtdEstoqueDisponivel := vest;
  vQtdeItem := qtdeVenda;
  if (vest >= vQtdeItem) then
    Result := true
  else
    Result := False;
end;

function TPedVenda.todosOsItensDAVCancelados(pNPED: integer;
  pTipo: string): boolean;
begin
  vItProd.dtSetIt.Close;
  vItProd.dtSetIt.Filtered := false;
  vItServ.dtSetIt.Close;
  vItServ.dtSetIt.Filtered := false;
  vItProd.dtSetIt.Filter := 'TIPO=' + QuotedStr(trim(pTipo)) + ' and NPED=' + inttostr(pNPED) + ' and STATUS<>''CANCELADO''';
  vItProd.dtSetIt.Filtered := true;
  if pTipo <> 'REQ' then
  begin
    vItServ.dtSetIt.Filter := 'TIPO=' + QuotedStr(trim(pTipo)) + ' and NPED=' + inttostr(pNPED) + ' and STATUS<>''CANCELADO''';
    vItServ.dtSetIt.Filtered := true;
  end;
  vItProd.dtSetIt.Open;
  vItServ.dtSetIt.Open;
  if (trim(pTipo) = 'REQ') and vItProd.dtSetIt.IsEmpty then
  begin
    result := true;
    exit;
  end
  else if (trim(pTipo) = 'OS') and vItProd.dtSetIt.IsEmpty and vItServ.dtSetIt.IsEmpty then
  begin
    result := true;
    exit;
  end
  else
    result := false;

  vItProd.dtSetIt.Close;
  vItProd.dtSetIt.Filtered := false;
  vItProd.dtSetIt.Open;
  vItServ.dtSetIt.Close;
  vItServ.dtSetIt.Filtered := false;
  vItServ.dtSetIt.Open;
end;

