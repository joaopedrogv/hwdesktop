end;

function TPedVenda.salvarAgendamento(pCancelar: boolean; pCodAgenda: Integer): boolean;
var
  buscasAgenda: TIBQuery;
  vExisteVinculo: boolean;
begin
   try
     Result := True;

     if vSing.vTipoVenda <> 'OS' then
     	exit;

     vExisteVinculo := False;
     
     buscas.Close;
     buscas.SQL.Text := ' SELECT COALESCE(COD_USUARIO, 0) COD_USUARIO FROM AGENDA ' +
        ' WHERE COD_AGENDA = :COD_AGENDA AND COD_EMPRESA = :COD_EMPRESA ';
     if ((pCancelar) and (pCodAgenda > 0)) then
       buscas.ParamByName('COD_AGENDA').AsInteger := pCodAgenda
     else if (pCancelar) then
     	 buscas.ParamByName('COD_AGENDA').AsInteger := dataSet.FieldByName('COD_AGENDA').AsInteger
     else
	     buscas.ParamByName('COD_AGENDA').AsInteger := vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;
     buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
     buscas.Open;

     if not buscas.IsEmpty then
     begin
       if (pCancelar) then
       begin
         if (pCodAgenda > 0) then
         begin
           if (buscas.FieldByName('COD_USUARIO').AsInteger <= 0) then
           begin
             Application.MessageBox(Pchar('Agendamento se encontra disponível!'), 'Atenção', MB_ICONINFORMATION + MB_OK);
             Result := False;
             exit;
           end;
         end
       end
       else
       begin
         if (buscas.FieldByName('COD_USUARIO').AsInteger > 0) then
         begin
           Application.MessageBox(Pchar('Agendamento se encontra indisponível!' + #13 +
           	'Favor realizar uma nova consulta para atualizar as informações.'), 'Atenção', MB_ICONINFORMATION + MB_OK);
           Result := False;
           exit;
         end;
       end;
     end;

     buscas.Close;
     buscas.SQL.Text := ' SELECT COALESCE(NPED, 0) NPED FROM PEDVENDA ' +
        ' WHERE COD_EMPRESA = :COD_EMPRESA AND COD_AGENDA = :COD_AGENDA ' +
        ' AND UPPER(TRIM(COALESCE(STATUS_PED, ''''))) <> ''CANCELADO'' ';
     if ((pCancelar) and (pCodAgenda > 0)) then
       buscas.ParamByName('COD_AGENDA').AsInteger := pCodAgenda
     else if (pCancelar) then
     	 buscas.ParamByName('COD_AGENDA').AsInteger := dataSet.FieldByName('COD_AGENDA').AsInteger
     else
	     buscas.ParamByName('COD_AGENDA').AsInteger := vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;
     buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
     buscas.Open;

     vExisteVinculo := (not buscas.IsEmpty);
     if not buscas.IsEmpty then
     begin
       if (pCancelar) then
       begin
         if (pCodAgenda > 0) then
         begin
           if (buscas.FieldByName('NPED').AsInteger > 0) then
           begin
             Application.MessageBox(Pchar('Agendamento vinculado a OS N°' +
              IntToStr(buscas.FieldByName('NPED').AsInteger) +' !'), 'Atenção', MB_ICONINFORMATION + MB_OK);
             Result := False;
             exit;
           end;
         end;
       end
       else
       begin
         if (buscas.FieldByName('NPED').AsInteger > 0) then
         begin
           Application.MessageBox(Pchar('Agendamento vinculado a OS N°' + IntToStr(buscas.FieldByName('NPED').AsInteger) +' !' + #13 +
           	'Favor realizar uma nova consulta para atualizar as informações.'), 'Atenção', MB_ICONINFORMATION + MB_OK);
           Result := False;
           exit;
         end;
       end;
     end;

     if ((not vExisteVinculo) or (not pCancelar)) then
     begin
       try
         buscasAgenda := TIBQuery.Create(Application);
         buscasAgenda.Database := buscas.Database;
         buscasAgenda.Transaction := DtmPed.IBTransAgenda;

         buscasAgenda.Transaction.StartTransaction;

         buscasAgenda.Close;
         buscasAgenda.SQL.Text := ' UPDATE AGENDA SET COD_USUARIO = :COD_USUARIO ' +
          ' WHERE COD_AGENDA = :COD_AGENDA AND COD_EMPRESA = :COD_EMPRESA ;';
         if (pCancelar) then
           buscasAgenda.ParamByName('COD_USUARIO').Value := Null
         else
           buscasAgenda.ParamByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
         if ((pCancelar) and (pCodAgenda > 0)) then
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := pCodAgenda
         else if (pCancelar) then
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := dataSet.FieldByName('COD_AGENDA').AsInteger
         else
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;
         buscasAgenda.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
         buscasAgenda.ExecSQL;

         buscasAgenda.Close;
         buscasAgenda.SQL.Text := ' UPDATE AGENDA_ITENS SET COD_USUARIO = :COD_USUARIO  ' +
           ' WHERE COD_AGENDA = :COD_AGENDA AND COD_EMPRESA = :COD_EMPRESA ;';
         if (pCancelar) then
           buscasAgenda.ParamByName('COD_USUARIO').Value := Null
         else
           buscasAgenda.ParamByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
         if ((pCancelar) and (pCodAgenda > 0)) then
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := pCodAgenda
         else if (pCancelar) then
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := dataSet.FieldByName('COD_AGENDA').AsInteger
         else
           buscasAgenda.ParamByName('COD_AGENDA').AsInteger := vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;
         buscasAgenda.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
         buscasAgenda.ExecSQL;

         if buscasAgenda.Transaction.InTransaction then
           buscasAgenda.Transaction.Commit;
       finally
         if Assigned(buscasAgenda) then
           FreeAndNil(buscasAgenda);
       end;
     end;
   except
    on e: exception do
    begin
      Application.MessageBox(pchar('Falha ao salvar agendamento: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Falha ao salvar agendamento: ' + e.Message);
      Result := False;
    end;
  end;
end;

function TPedVenda.SalvarAltVendedorClienteVenda: boolean;
var
  vclienteOld, vclienteNew: string;
  vcpfOld, vcpfNew: string;
begin
  try
    result := false;

    if ((vDadosIni.vProgFid.vHabilitarProgFid) or (vDadosIni.vCashback.vHabilitarCashback))
    	and (Trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC') then
    begin
    	if vCodClienteAlterCliente <> dataSet.FieldByName('COD_CLIENTE').AsInteger then
      begin
        SqlOpen('select nome_cliente, cpfcgc from clientes ' +
        	' where cod_cliente = ' + IntToStr(vCodClienteAlterCliente) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa);
        vclienteOld := trim(buscas.FieldByName('nome_cliente').AsString);
        vcpfOld := trim(buscas.FieldByName('cpfcgc').AsString);

        SqlOpen('select nome_cliente, cpfcgc from clientes ' +
        	' where cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa);
        vclienteNew := trim(buscas.FieldByName('nome_cliente').AsString);
        vcpfNew := trim(buscas.FieldByName('cpfcgc').AsString);

        if Application.MessageBox(pchar('Ao alterar o cliente os pontos desta operação serão transferidos para o novo cliente: ' + #13 + #13 +
          'Cliente anterior: ' + IntToStr(vCodClienteAlterCliente) + ' - ' + vclienteOld + ' - ' + vcpfOld + #13 +
          'Cliente atual: ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + ' - ' + vclienteNew + ' - ' + vcpfNew + #13 + #13 +
        	'Deseja alterar o cliente assim mesmo?'), 'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
        	exit;

        if not vDadosIni.PesqPros('VND251', 'PERMITIR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
          IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas, true) then
          	Exit;
      end;
    end;

    if not (dataSet.State = dsEdit) then
      exit;
    if not ChecaParticipante then
    	exit;
    if not ChecaTipVendaVendedor then
    	exit;
    if not atribuirComissaoPorVenda then
      exit;

    if ((vDadosIni.vProgFid.vHabilitarProgFid) or (vDadosIni.vCashback.vHabilitarCashback))
    	and (Trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC') then
    begin
      if vCodClienteAlterCliente <> dataSet.FieldByName('COD_CLIENTE').AsInteger then
      begin
        // Atualizar pontos programa de fidelidade
        if not vDadosIni.setarPontosProgFidelidade(dataSet.FieldByName('NPED').AsInteger,
          dataSet.FieldByName('TIPO').AsString, buscas, true) then
        begin
          RollBackTransacao;
          Result := false;
          exit;
        end;
      end;
    end;

    dataSet.FieldByName('CPFCGC').AsString := vCliente.dataSet.FieldByName('CPFCGC').AsString;
    result := inherited Post;
    if Result then
    begin
      result := Apply;
      //          if dataSet.FieldByName('TIPO').AsString = 'REQ' then
      //          begin
      //            buscas.close;
      //            buscas.SQL.Text:='UPDATE PEDVENDA_PROD SET COD_VENDEDOR = '+dataSet.FieldByName('COD_VENDEDOR').AsString+
      //            ' WHERE NPED = '+dataSet.FieldByName('NPED').AsString+' AND TIPO = ''REQ'' AND COD_EMPRESA = '+vDadosIni.codEmpresa;
      //            buscas.Prepare;
      //            buscas.ExecSQL;
      //          end
      //          else
      vItProd.Apply;
    end;

    if ((vDadosIni.vProgFid.vHabilitarProgFid) or (vDadosIni.vCashback.vHabilitarCashback))
    	and (Trim(dataSet.FieldByName('TIPO').AsString) <> 'ORC') then
    begin
      if vCodClienteAlterCliente <> dataSet.FieldByName('COD_CLIENTE').AsInteger then
      begin
        // Atualizar pontos programa de fidelidade
        if not vDadosIni.setarPontosProgFidelidade(dataSet.FieldByName('NPED').AsInteger,
          dataSet.FieldByName('TIPO').AsString, buscas, false) then
        begin
          RollBackTransacao;
          Result := false;
          exit;
        end;
      end;
    end;

    if Result then
      result := CommitaTransacao
    else
    	RollBackTransacao;

    if Result then
    begin
      vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);

      if vHabClienteAlterClienteVnd then
      	if vCodClienteAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger then
          vDadosIni.GravaAuditoria(vDadosIni.IfThen(getTipoVenda = 'REQ', 'VND098', vDadosIni.IfThen(getTipoVenda = 'ORC', 'VND199', 'VND200')),
            'ALTERAR', 'SUCESSO - ' +
            vDadosIni.IfThen(vCodClienteAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger,
            'CLI ANT:' + IntToStr(vCodClienteAlterCliente) + ' CLI NOVO:' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger), ''),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabVendedorAlterClienteVnd then
        if vCodVendedorAlterCliente <> dataSet.FieldByName('cod_vendedor').AsInteger then
          vDadosIni.GravaAuditoria(vDadosIni.IfThen(getTipoVenda = 'REQ', 'VND256', vDadosIni.IfThen(getTipoVenda = 'ORC', 'VND257', 'VND201')),
          	'ALTERAR', 'SUCESSO - ' +
            'VEND ANT:' + IntToStr(vCodVendedorAlterCliente) + ' VEND NOVO:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabVendedorAlterClienteFpCred then
      	if vCodClienteAlterCliente <> dataSet.FieldByName('cod_vendedor').AsInteger then
          vDadosIni.GravaAuditoria('VND160', 'ALTERAR', 'SUCESSO - ' +
          	'VEND ANT:' + IntToStr(vCodVendedorAlterCliente) + ' VEND NOVO:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger),
            'PEDVENDA', trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabClienteAlterClienteFpCred then
      	if vCodVendedorAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger then
        	vDadosIni.GravaAuditoria('VND238', 'ALTERAR', 'SUCESSO - ' +
          	'CLI ANT:' + IntToStr(vCodVendedorAlterCliente) + ' CLI NOVO:' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabControleAlterClienteVnd then
      	if vCodControleAlterCliente <> dataSet.FieldByName('cod_controle').AsInteger then
        	vDadosIni.GravaAuditoria('VND162', 'ALTERAR', 'SUCESSO - ' +
          	'CTRL ANT:' + IntToStr(vCodControleAlterCliente) + ' CTRL NOVO:' + IntToStr(dataSet.FieldByName('cod_controle').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

    	if vHabParticipanteAlterClienteVnd then
      	if vCodParticipanteAlterCliente <> dataSet.FieldByName('cod_vendedor1').AsInteger then
        	vDadosIni.GravaAuditoria('VND287', 'ALTERAR', 'SUCESSO - ' +
          	'PART ANT:' + IntToStr(vCodParticipanteAlterCliente) + ' PART NOVO:' + IntToStr(dataSet.FieldByName('cod_vendedor1').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);
    end
    else
    begin
    	if vHabClienteAlterClienteVnd then
      	if vCodClienteAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger then
          vDadosIni.GravaAuditoria(vDadosIni.IfThen(getTipoVenda = 'REQ', 'VND098', vDadosIni.IfThen(getTipoVenda = 'ORC', 'VND199', 'VND200')),
            'ALTERAR', 'FALHA - ' +
            vDadosIni.IfThen(vCodClienteAlterCliente <> dataSet.FieldByName('cod_cliente').AsInteger,
            'CLI ANT:' + IntToStr(vCodClienteAlterCliente) + ' CLI NOVO:' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger), ''),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

      if vHabVendedorAlterClienteVnd then
        if vCodVendedorAlterCliente <> dataSet.FieldByName('cod_vendedor').AsInteger then
          vDadosIni.GravaAuditoria(vDadosIni.IfThen(getTipoVenda = 'REQ', 'VND256', vDadosIni.IfThen(getTipoVenda = 'ORC', 'VND257', 'VND201')),
          	'ALTERAR', 'FALHA - ' +
            'VEND ANT:' + IntToStr(vCodVendedorAlterCliente) + ' VEND NOVO:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger),
            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

