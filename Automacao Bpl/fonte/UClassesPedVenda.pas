  finally
    APedvenda.RollBackTransacao;
   	FreeAndNil(APedvenda);
  end;
end;

procedure chamarConfirmacaoPEDpelaNF(pNped: Integer; pTipo: string; pValor: Double);
var
	APedvenda: TPedvenda;
  vTpTemp: string;
begin
	try
    Screen.Cursor := crHourGlass;

    if DtmPedVenda = nil then
	  	DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

    vTpTemp := pTipo;

    vDadosIni.vtpVenda := pTipo;

    APedvenda := TPedVenda.create(DtmPedVenda);

    if not APedVenda.abreFormNFGeraREQ(
      'Deseja Confirmar a Requisição N° ' + IntToStr(pNped) +
      '. Valor R$ ' + Format( '%0.2n', [pValor])) then
        Exit;

    APedVenda.dataSet := TClientDataSet(DtmPedVenda.cdsVnd);
    APedVenda.vItProd.dataSet := TClientDataSet(DtmPedVenda.cdsIVnd);
    APedVenda.buscas := TIBQuery(DtmPedVenda.qrbuscasVnd);
    APedVenda.vCliente.buscas := TIBQuery(DtmPedVenda.qrbuscasVnd);
    APedVenda.vItProd.buscas := TIBQuery(DtmPedVenda.qrbuscasVnd);
    APedVenda.transacao := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    APedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    APedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);

    APedVenda.abrePedVenda(pNped);

    if not APedVenda.Edit then
      exit;

    if not APedVenda.validaConfirmacao then
    begin
    	APedVenda.Cancel;
    	Exit;
    end;

    if not APedVenda.calculaDescontoAcrescimo then
      Exit;

    if APedVenda.getTipoVenda = 'REQ' then
    begin
      if not APedVenda.vItProd.vProduto.validaEstoqueFechamento then
      begin
        Application.MessageBox('O documento não foi confirmado.', 'Informação', MB_ICONEXCLAMATION + MB_OK);
        exit;
      end;
    end;
    APedVenda.abrePedVenda(APedVenda.dataSet.FieldByName('NPED').AsInteger);
    APedVenda.confirmarVenda;
    APedVenda.RollBackTransacao;
  finally
    APedVenda.pedidoEmEdicao(caRemoverEdicao, False);
    APedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    APedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    vDadosIni.vtpVenda := vTpTemp;
    APedVenda.create(DtmPedVenda);
    APedVenda.dataSet := TClientDataSet(DtmPedVenda.cdsPedVenda);
    APedVenda.vItProd.dataSet := TClientDataSet(DtmPedVenda.cdsItemProd);
    APedVenda.buscas := TIBQuery(DtmPedVenda.qrBuscas);
    APedVenda.vCliente.buscas := TIBQuery(DtmPedVenda.qrBuscas);
    APedVenda.vItProd.buscas := TIBQuery(DtmPedVenda.qrBuscas);
    APedVenda.transacao := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    if APedVenda.dataSet.FieldByName('COD_CLIENTE').AsInteger > 0 then
      APedVenda.vCliente.abreClientes(APedVenda.dataSet.FieldByName('COD_CLIENTE').AsInteger);
    APedvenda.RollBackTransacao;
    if Assigned(APedvenda) then
    	FreeAndNil(APedvenda);
    Screen.Cursor := crDefault;
  end;
end;

procedure chamarReaberturaPEDpelaNF(pNped: Integer; pTipo: string; pValor: Double);
var
	APedvenda: TPedvenda;
  vTpTemp: string;
begin
  try
    Screen.Cursor := crHourGlass;

