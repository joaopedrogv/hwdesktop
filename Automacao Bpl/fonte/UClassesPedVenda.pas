        Result := dataSet.FieldByName('est_f').AsFloat - vTemp;
//    Result := dataSet.FieldByName('est_f').AsFloat + dataSet.FieldByName('est_r').AsFloat - vTemp;
      vDadosIni.fechaStatusProcessamento;
  except
  end;
end;

function TProdutoPed.validaEstoque: boolean;
var
  sql: string;
  vest, vQtdeItem: Real;
  i, grupoprod: integer;
  codgrade: integer;
  codprod, numfabprod, descrprod: string;
  vEstoqueNegativo: string;
  vtemp: string;
begin
  try
  	vEstoqueNegativo := 'N';
  	vDadosIni.vInibeMensPesqPros := 'S';
		if vDadosIni.PesqPros('VND281', 'PERMITIR', FOwner.getTipoVenda, 'PEDVENDA', FOwner.dataSet.FieldByName('NPED').AsString, buscas, false) then
			vEstoqueNegativo := 'S';

    if FOwner.vItProd.dataSet.FieldByName('quant_ped_item').AsFloat <= 0 then
      raise exception.create('Quantidade inválida');
    vest       := getQtdeDisponivelEmEstoque(true);
    vestDisp   := vest;
    vQtdeItem  := FOwner.vItProd.dataSet.FieldByName('quant_ped_item').AsFloat;
    grupoprod  := FOwner.vItProd.dataSet.FieldByName('grupo_prod').asinteger;
    codprod    := trim(FOwner.vItProd.dataSet.FieldByName('cod_prod').AsString);
    codgrade   := FOwner.vItProd.dataSet.FieldByName('cod_grade').asinteger;
    numfabprod := trim(FOwner.vItProd.dataSet.FieldByName('num_fab_prod').AsString);
    descrprod  := trim(FOwner.vItProd.dataSet.FieldByName('descr_prod_ped').AsString);
    FOwner.vItProd.dtSet.First;
    vDadosIni.abreStatusProcessamento('', 'Validando Estoque do Item');
    while not FOwner.vItProd.dtSet.Eof do
    begin
    	if (FOwner.vItProd.dataSet.FieldByName('COD_GRADE').asinteger > 0) then
      begin
      	if (FOwner.vItProd.dtSet.FieldByName('NITEM').asinteger <> FOwner.vItProd.dataSet.FieldByName('NITEM').asinteger) and
          (grupoprod = FOwner.vItProd.dtSet.FieldByName('grupo_prod').asinteger) and
          (codprod = trim(FOwner.vItProd.dtSet.FieldByName('cod_prod').AsString)) and
          (codgrade = FOwner.vItProd.dtSet.FieldByName('cod_grade').asinteger) and
          (trim(FOwner.vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
          vQtdeItem := vQtdeItem + FOwner.vItProd.dtSet.FieldByName('quant_ped_item').AsFloat;
      end
      else
      begin
        if (FOwner.vItProd.dtSet.FieldByName('NITEM').asinteger <> FOwner.vItProd.dataSet.FieldByName('NITEM').asinteger) and
          (grupoprod = FOwner.vItProd.dtSet.FieldByName('grupo_prod').asinteger) and
          (codprod = trim(FOwner.vItProd.dtSet.FieldByName('cod_prod').AsString)) and
          (trim(FOwner.vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
          vQtdeItem := vQtdeItem + FOwner.vItProd.dtSet.FieldByName('quant_ped_item').AsFloat;
      end;
      FOwner.vItProd.dtSet.Next;
    end;

    Result := (vest >= vQtdeItem) or (vDadosIni.vEstoqueNegativo = 'S') or (vEstoqueNegativo = 'S');
    vdadosini.fechaStatusProcessamento;

    if not result then
      vSim.existeProdutoSimilar(grupoprod, codprod, 2);

    vtemp := 'Produto ' + QuotedStr(trim(numfabprod)) +
    	' - ' + trim(descrprod) + sLineBreak +
      IfThen(vest <= 0,
      	'sem estoque', 'sem estoque suficiente') + '.';

    if not Result then
    begin
      if (FOwner.vItProd.vSing.vTipoVenda = 'REQ') and (FOwner.vItProd.vNomeCampoErro = '') then
        FOwner.vItProd.vNomeCampoErro := 'DBEDIT10'
      else if FOwner.vItProd.vNomeCampoErro = '' then
        FOwner.vItProd.vNomeCampoErro := 'DBEDIT47';
			raise exception.create(vtemp);
    end;

    if ((vest < vQtdeItem) and (vDadosIni.vEstoqueNegativo = 'S')) then
    begin
//    	if (not FOwner.vSing.vVendaRapida) then
//      	Application.MessageBox(Pchar(vtemp), 'Atenção', MB_OK + MB_ICONINFORMATION)
//      else
      if Assigned(FOwner.OnMessage) then
      	FOwner.OnMessage(vtemp);
    end
    else if ((vest < vQtdeItem) and (vEstoqueNegativo = 'S')) then
    begin
//    	if (not FOwner.vSing.vVendaRapida) then
//    		Application.MessageBox(Pchar(vtemp), 'Atenção', MB_OK + MB_ICONINFORMATION)
//      else
			if Assigned(FOwner.OnMessage) then
      	FOwner.OnMessage(vtemp);
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TProdutoPed.validaEstoqueFechamento: boolean;
var
  vest, vQtdeItem: Double;
  I, J, nItem, {qtdItens,} grupoprod, vQtdNItens: integer;
  codprod, numfabprod, vdescr_item, vNitem: string;
  vHabConfUnicaEstoque: Boolean;
  vListaProdSemEstoque: TStringList;
  vListaSemEstoque: TStringList;
  vEstoqueNegativo: string;
begin
	try
    try
      Result := true;
      if (FOwner.vItProd.IsEmpty) or (vDadosIni.vEmp.vAlmox = 'S2') then
        exit;

      vEstoqueNegativo := 'N';
      vDadosIni.vInibeMensPesqPros := 'S';
      if vDadosIni.PesqPros('VND282', 'HABILITAR', FOwner.getTipoVenda, 'PEDVENDA', FOwner.dataSet.FieldByName('NPED').AsString, buscas, false) then
        vEstoqueNegativo := 'S';

  //    if (vDadosIni.vEstoqueNegativo = 'S') or (vEstoqueNegativo = 'S') then
  //    begin
        vDadosIni.vInibeMensPesqPros := 'S';
        vHabConfUnicaEstoque :=
          vDadosIni.PesqPros('VND202', 'HABILITAR', FOwner.dataSet.FieldByName('tipo').AsString +
            ' ' + FOwner.dataset.FieldByName('NPED').AsString, 'PEDVENDA',
            FOwner.dataset.FieldByName('NPED').AsString, buscas, true);

        if not vHabConfUnicaEstoque then
        begin
          if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'OS' then
            vHabConfUnicaEstoque :=
              vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
               ' where tipo=''OS'' and tipo_os = ' + QuotedStr(trim(FOwner.dataSet.FieldByName('tipo_os').AsString))) = 'S', true, false)
          else if trim(FOwner.dataSet.FieldByName('TIPO').AsString) = 'ORC' then
            vHabConfUnicaEstoque :=
              vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
              ' where tipo=''ORC'' and sigla = ' + QuotedStr(trim(FOwner.dataSet.FieldByName('tipo_orc').AsString))) = 'S', true, false)
          else
            vHabConfUnicaEstoque :=
              vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(usar_conferencia_produto, ''N'') AS VALOR from tipo_vendas ' +
              ' where tipo=''REQ'' and sigla = ' + QuotedStr(trim(FOwner.dataSet.FieldByName('tipv').AsString))) = 'S', true, false);
        end;

        if vHabConfUnicaEstoque then
        begin
          vListaProdSemEstoque := TStringList.Create;
          vListaProdSemEstoque.Sorted := False;
          vListaProdSemEstoque.Duplicates := dupIgnore;
          vListaProdSemEstoque.Clear;

          vListaSemEstoque := TStringList.Create;
          vListaSemEstoque.Sorted := False;
          vListaSemEstoque.Duplicates := dupIgnore;
          vListaSemEstoque.Clear;
        end;
  //    end;

      nItem := FOwner.vItProd._retornaQtdNItensCancelConsignado;
      vQtdeItem := 0;
      //    FOwner.vItProd.abrePedVendaProd(FOwner.dataSet.FieldByName('NPED').asinteger);
  //    qtdItens := FOwner.vItProd.dataSet.RecordCount;
      if (FOwner.vItProd.dataSet.FieldByName('quant_ped_item').AsFloat <= 0) and (trim(FOwner.vItProd.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
        raise exception.create('Quantidade inválida');
      FOwner.vItProd.IndexFieldNames := 'NITEM';
      if FOwner.dataSet.FieldByName('NPED').AsInteger > 0 then
      begin
        vQtdNItens := strtoint(retornaValor('select count(nitem) as valor from pedvenda_prod pp' +
          ' where pp.nped=' + FOwner.dataSet.FieldByName('NPED').AsString +
          ' and pp.tipo = ' + QuotedStr(trim(FOwner.dataSet.FieldByName('TIPO').AsString)) +
          ' and pp.cod_empresa=' + vDadosIni.codEmpresa));
        if vQtdNItens < FOwner.vItProd.dataSet.RecordCount then
          vQtdNItens := FOwner.vItProd.dataSet.RecordCount;
      end
      else
        vQtdNItens := FOwner.vItProd.dataSet.RecordCount;

      for I := 1 to vQtdNItens do
      begin
        vDadosIni.abreStatusProcessamento('', 'Validando Estoque no fechamento da venda');
        if not FOwner.vItProd.dataSet.Locate('NITEM', I, [loCaseInsensitive]) then
          Continue;
        if trim(FOwner.vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO' then
          Continue;
  //      if not FOwner.vItProd.validaEstoqueGradeProduto then
  //      begin
  //        result := false;
  //        break;
  //      end;
        vest := getQtdeDisponivelEmEstoque(true);
        grupoprod := FOwner.vItProd.dataSet.FieldByName('grupo_prod').asinteger;
        codprod := trim(FOwner.vItProd.dataSet.FieldByName('cod_prod').AsString);
        numfabprod := trim(FOwner.vItProd.dataSet.FieldByName('num_fab_prod').AsString);
        vQtdeItem := FOwner.vItProd.dataSet.FieldByName('quant_ped_item').AsFloat;
        vdescr_item := trim(FOwner.vItProd.dataSet.FieldByName('descr_prod_ped').AsString);
        vNitem := vDadosIni.StrZero(FOwner.vItProd.dataSet.FieldByName('nitem').AsInteger, 3);

        try
          if (FOwner.vItProd.dataSet.FieldByName('cod_grade').AsInteger > 0) then
            FOwner.vItProd.dtSet.Filter := ' grupo_prod = ' + FOwner.vItProd.dataSet.FieldByName('grupo_prod').AsString +
              ' and cod_prod = ' + QuotedStr(trim(FOwner.vItProd.dataSet.FieldByName('cod_prod').AsString)) +
              ' and cod_grade = ' + FOwner.vItProd.dataSet.FieldByName('cod_grade').AsString
          else
            FOwner.vItProd.dtSet.Filter := ' grupo_prod = ' + FOwner.vItProd.dataSet.FieldByName('grupo_prod').AsString +
              ' and cod_prod = ' + QuotedStr(trim(FOwner.vItProd.dataSet.FieldByName('cod_prod').AsString));
          FOwner.vItProd.dtSet.Filtered:=true;
          FOwner.vItProd.dtSet.First;
          while not FOwner.vItProd.dtSet.Eof do
          begin
            if (i <> FOwner.vItProd.dtSet.FieldByName('NITEM').asinteger) and
              (grupoprod = FOwner.vItProd.dtSet.FieldByName('grupo_prod').asinteger) and
              (codprod = trim(FOwner.vItProd.dtSet.FieldByName('cod_prod').AsString)) and
              (trim(FOwner.vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
               vQtdeItem := vQtdeItem + FOwner.vItProd.dtSet.FieldByName('quant_ped_item').AsFloat;
            FOwner.vItProd.dtSet.Next;
          end;
        finally
          FOwner.vItProd.dtSet.Filtered:=false;
          FOwner.vItProd.dtSet.Filter:='';
        end;

        if Result then
          Result := (RoundTo(vest, -3) >= RoundTo(vQtdeItem, -3)) or (vDadosIni.vEstoqueNegativo = 'S') or (vEstoqueNegativo = 'S');

        if (not Result) and (not vHabConfUnicaEstoque) then
        begin
          vDadosIni.fechaStatusProcessamento;
          raise exception.create('Produto ' + QuotedStr(trim(numfabprod)) +
            ' - ' + trim(vdescr_item) + sLineBreak +
            IfThen(vest <= 0,
              'sem estoque', 'sem estoque suficiente') + '.');
        end;

        if (RoundTo(vest,  -3) < RoundTo(vQtdeItem, -3)) then
        begin
          vDadosIni.fechaStatusProcessamento;
          if vHabConfUnicaEstoque then
          begin
            if (vListaSemEstoque.Count = 20) then
            begin
              vListaSemEstoque.Add(vNitem + ' - ' + trim(numfabprod) + ' - ' + Copy(trim(vdescr_item), 1, 30));
              vListaSemEstoque.Add('...');
            end
            else if (vListaSemEstoque.Count < 20) then
              vListaSemEstoque.Add(vNitem + ' - ' + trim(numfabprod) + ' - ' + Copy(trim(vdescr_item), 1, 30));

            vListaProdSemEstoque.Add(vNitem + '|' + IntToStr(grupoprod) + '|' + trim(codprod) + '|');
          end
          else
          begin
            Application.MessageBox(Pchar('Produto ' + QuotedStr(trim(numfabprod)) +
              ' - ' + trim(vdescr_item) + sLineBreak +
              IfThen(vest <= 0,
                'sem estoque', 'sem estoque suficiente') + '.'), 'Atenção', MB_OK + MB_ICONINFORMATION);

            if (vDadosIni.vEstoqueNegativo <> 'S') and (vEstoqueNegativo = 'S') then
            begin
              if not vDadosIni.PesqPros('VND283', 'PERMITIR', FOwner.getTipoVenda + ' - ' +
                ' GRUPO: ' + IntToStr(grupoprod) +
                ' COD PROD: ' + codprod +
                ' NITEM: ' + vNitem, 'PEDVENDA',
                FOwner.dataSet.FieldByName('NPED').AsString, buscas, true) then
              begin
                Result := False;
                Exit;
              end;

              vDadosIni.GravaAuditoria('VND283', 'PERMITIR',
                FOwner.getTipoVenda + ' - ' +
                ' GRUPO: ' + IntToStr(grupoprod) +
                ' COD PROD: ' + codprod +
                ' NITEM: ' + vNitem,
                'PEDVENDA', FOwner.dataSet.FieldByName('NPED').asstring, buscas);

      //        vDadosIni.GravaAuditoria('VND283', 'PERMITIR',
      //          FOwner.getTipoVenda + ' - SUCESSO',
      //          'PEDVENDA', FOwner.dataSet.FieldByName('NPED').asstring, buscas);
            end;
          end;
        end;
      end;

      if (vHabConfUnicaEstoque) and (vListaSemEstoque.Count > 0) then
      begin
        if not Result then
          raise exception.create('Produto(s) sem estoque suficiente.' + sLineBreak + sLineBreak +
            vListaSemEstoque.Text)
        else
          Application.MessageBox(Pchar('Produto(s) sem estoque suficiente.' + sLineBreak + sLineBreak +
            vListaSemEstoque.Text), 'Atenção', MB_OK + MB_ICONINFORMATION);
      end;

      if (vDadosIni.vEstoqueNegativo <> 'S') and (vEstoqueNegativo = 'S') then
      begin
        if vHabConfUnicaEstoque then
        begin
          if vListaProdSemEstoque.Count > 0 then
          begin
            if not vDadosIni.PesqPros('VND283', 'PERMITIR', FOwner.getTipoVenda, 'PEDVENDA',
              FOwner.dataSet.FieldByName('NPED').AsString, buscas, true) then
            begin
              Result := False;
              Exit;
            end;

            for J := 0 to vListaProdSemEstoque.Count - 1 do
            begin
              vDadosIni.GravaAuditoria('VND283', 'PERMITIR',
                FOwner.getTipoVenda + ' - ' +
                ' GRUPO: ' + vDadosIni.getCampoPipe(vListaProdSemEstoque[J], 2) +
                ' COD PROD: ' + vDadosIni.getCampoPipe(vListaProdSemEstoque[J], 3) +
                ' NITEM: ' + vDadosIni.getCampoPipe(vListaProdSemEstoque[J], 1),
                'PEDVENDA', FOwner.dataSet.FieldByName('NPED').asstring, buscas);
            end;

  //          vDadosIni.GravaAuditoria('VND283', 'PERMITIR',
  //            FOwner.getTipoVenda + ' - SUCESSO',
  //            'PEDVENDA', FOwner.dataSet.FieldByName('NPED').asstring, buscas);
          end;
        end;
      end;

      vDadosIni.fechaStatusProcessamento;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
      end;
    end;
  finally
  	if Assigned(vListaProdSemEstoque) then
    	FreeAndNil(vListaProdSemEstoque);

    if Assigned(vListaSemEstoque) then
    	FreeAndNil(vListaSemEstoque);
  end;
end;

function TProdutoPed.validaProduto: boolean;
begin
  try
    if FOwner.dataSet.FieldByName('TIPO').AsString = 'ORC' then
      if dataSet.FieldByName('CONSUMO').AsString = 'S' then
        raise exception.create('Produto para consumo, ' + chr(13) +
          'Favor Verificar no cadastro');

    if FOwner.dataSet.FieldByName('TIPO').AsString <> 'ORC' then
    begin
      buscas.close;
      if Trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'REQ' then
        buscas.sql.text := 'select consumo from tipo_vendas' +
          ' where tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('tipo').AsString) +
          ' and sigla = ' + QuotedStr(FOwner.dataset.FieldByName('TIPV').AsString) +
          ' order by cod_tipo'
      else if Trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS' then
        buscas.sql.text := 'select consumo from tipo_vendas' +
          ' where tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('tipo').AsString) +
          ' and tipo_os = ' + QuotedStr(FOwner.dataset.FieldByName('tipo_os').AsString) +
          ' order by cod_tipo';
      buscas.open;

      if dataSet.FieldByName('CONSUMO').AsString = 'S' then
      begin
        if Trim(buscas.FieldByName('consumo').AsString) <> 'S' then
          raise exception.create('Produto para consumo, ' + chr(13) +
            'Favor Verificar no cadastro');
      end
      else
      begin
        if Trim(buscas.FieldByName('consumo').AsString) = 'S' then
          raise exception.create('Produto não é para consumo. Tipos Vendas de consumo, ' + chr(13) +
            'Favor Verificar no cadastro');
      end;
    end;

    if FOwner.dataSet.FieldByName('TIPO').AsString <> 'ORC' then
    begin
      if dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency <= 0 then
        raise exception.create('Produto com custo médio Zerado, ' + chr(13) +
          'Favor Verificar Custo deste produto no cadastro');
    end;
    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TProdutoPed.getQtdeDisponivelEmEstoque(pNPED, pGrupoprod: integer;
  pCodprod: string): Double;
var
  sql: string;
  vest, vTemp: Real;
begin
  try
    vTemp := 0;

    sql := 'select sum(coalesce(itpd.quant_ped_item, 0)) as soma1 from pedvenda pd' +
      ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and' +
      ' pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo' +
      ' where pd.ativo = 1 and itpd.grupo_prod = :grupo and itpd.cod_prod = :codigo ' +
      ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and (pd.data_fech is null or pd.data_fech < :data) and (itpd.status<>''CANCELADO'' or itpd.status is null) ';

    buscas.Close;
    if (vDadosIni.vEmp.vApresentarEstR = 'S') then
      sql := sql + ' and pd.tipo <> ''ORC'''
    else if (vDadosIni.vEmp.vApresentarEstR = 'R') then
      sql := sql + ' and pd.tipo = ''REQ'''
    else if (vDadosIni.vEmp.vApresentarEstR = 'O') then
      sql := sql + ' and pd.tipo = ''OS''';
    //a linha abaixo não precisa
//    sql := sql + ' and pd.nped <> ' + inttostr(pNPED);

    if (vDadosIni.vEmp.vApresentarEstR = 'R') or
      (vDadosIni.vEmp.vApresentarEstR = 'O') or
      (vDadosIni.vEmp.vApresentarEstR = 'S') then
    begin
      buscas.SQL.Text := sql;
      buscas.Params[0].AsInteger := pGrupoprod;
      buscas.Params[1].AsString := trim(pCodprod);
      buscas.Params[2].AsDate := 0;
      //      AsString:='01/01/1899';
      buscas.Open;
      vTemp := buscas.FieldByName('soma1').AsFloat;
    end;
    if (vDadosIni.vEmp.vApresentarEstR = 'P') or (vDadosIni.vEmp.vApresentarEstR = 'S') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as soma from producao pd ' +
        ' inner join producao_item_indice pi on pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa ' +
        ' where pi.grupo_prod = ' + IntToStr(pGrupoprod) +
        ' and pi.cod_prod = ' + QuotedStr(pCodprod) +
        ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      vTemp := vTemp + buscas.FieldByName('soma').AsFloat;
    end;
    if (vDadosIni.vEmp.vApresentarEstR = 'S') or (vDadosIni.vEmp.vApresentarEstR = 'R') or (vDadosIni.vEmp.vApresentarEstR = 'O') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select sum(coalesce(c.quant,0)) as soma from controle_almoxarifado c' +
        ' left join grade grd on c.cod_grade = grd.cod_grade and c.cod_empresa = grd.cod_empresa' +
        ' where c.grupo_prod = ' + IntToStr(pGrupoprod) +' and c.cod_prod = ' + QuotedStr(pCodprod) +
        ' and c.cod_empresa ='+ vDadosIni.codEmpresa;
      buscas.Open;
      vTemp := vTemp + buscas.FieldByName('soma').AsFloat;
    end;
    if (vDadosIni.vEmp.vApresentarEstR = 'S') or (vDadosIni.vEmp.vApresentarEstR = 'R') or (vDadosIni.vEmp.vApresentarEstR = 'O') then
    begin
    	buscas.Close;
      buscas.SQL.Text := ' select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        ':grupo_prod, ' +
        ':cod_prod, ' +
        ':cod_empresa, ' +
        ':cod_grade);';
      buscas.ParamByName('grupo_prod').AsInteger := pGrupoprod;
      buscas.ParamByName('cod_prod').AsString := pCodprod;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('cod_grade').AsInteger := 0;
      buscas.Open;

      vTemp := vTemp - buscas.FieldByName('somaEstoque').AsFloat;
    end;

    buscaProduto(pGrupoprod, pCodprod);
    Result := dataSet.FieldByName('est_f').AsFloat - vTemp;
//    Result := dataSet.FieldByName('est_f').AsFloat + dataSet.FieldByName('est_r').AsFloat - vTemp;
  except
  end;
end;

function TProdutoPed.getQtdeDisponivelPrima(pNPED, pGrupoprod: integer;
  pCodprod: string): Double;
var
  vTemp: Real;
begin
	try
    vTemp := 0;

    if (vDadosIni.vEmp.vApresentarEstR = 'S') or (vDadosIni.vEmp.vApresentarEstR = 'R') or (vDadosIni.vEmp.vApresentarEstR = 'O') then
    begin
    	buscas.Close;
      buscas.SQL.Text := ' select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
        ':grupo_prod, ' +
        ':cod_prod, ' +
        ':cod_empresa, ' +
        ':cod_grade);';
      buscas.ParamByName('grupo_prod').AsInteger := pGrupoprod;
      buscas.ParamByName('cod_prod').AsString := pCodprod;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ParamByName('cod_grade').AsInteger := 0;
      buscas.Open;

      vTemp := vTemp - buscas.FieldByName('somaEstoque').AsFloat;
    end;
  except
  end;
end;

