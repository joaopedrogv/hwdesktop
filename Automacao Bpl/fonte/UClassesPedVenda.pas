function TPedVendaProd.insert: boolean;
var
  vMaxItem:integer;
  vCodTecMec:integer;
  vCodVendedor:integer;
  vCodParticipante: Variant;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
//    if not venda.verificaColaboradorProdutos(true, true) then
//      Exit;
    if not validaAcresDescNoItem(fstr('TP_DESCACRES'), fstr('NAT_DESCACRES'),ffloat('VALOR_DESCACRES')) then
      exit;

    if not post then
      exit;
  end;

  if Trim(dataSet.FieldByName('xped_compra').AsString) <> '' then
    fCodPedidoDeCompra := Trim(dataSet.FieldByName('xped_compra').AsString)
  else
    fCodPedidoDeCompra := '';

  FOwner.calculaTotais;
  dataSet.Last;
  vCodTecMec := 0;
  vCodVendedor := 0;
  vMaxItem:= dataSet.FieldByName('nitem').AsInteger;
  if not dataSet.IsEmpty then
  begin
  	vCodTecMec := dataSet.FieldByName('col_cod_vendedor').AsInteger;
  	vCodVendedor := dataSet.FieldByName('cod_vendedor').AsInteger;
    vCodParticipante := dataSet.FieldByName('cod_vendedor1').Value;
  end
  else
  begin
    vCodVendedor := FOwner.dataSet.FieldByName('cod_vendedor').AsInteger;
    vCodParticipante := FOwner.dataSet.FieldByName('cod_vendedor1').Value;
  end;
  if inherited insert then
  begin
    Result := true;
    if (vSing.vTipoVenda = 'REQ') or vSing.vOrcamentoSoPecas then
    begin
    	dataSet.FieldByName('cod_vendedor1').Value := FOwner.dataSet.FieldByName('cod_vendedor1').Value;
      if nCodVendedorKit = -1 then
        dataSet.FieldByName('cod_vendedor').AsInteger := FOwner.dataSet.FieldByName('cod_vendedor').AsInteger
      else
        dataSet.FieldByName('cod_vendedor').AsInteger := nCodVendedorKit;
    end
    else
    begin
      dataSet.FieldByName('cod_vendedor1').Value := vCodParticipante;
      if nCodVendedorKit = -1 then
      begin
        dataSet.FieldByName('cod_vendedor').AsInteger := vCodVendedor; //FOwner.dataSet.FieldByName('cod_vendedor').AsInteger;
        if vCodTecMec > 0 then
          dataSet.FieldByName('col_cod_vendedor').AsInteger := vCodTecMec;
      end
      else
        dataSet.FieldByName('cod_vendedor').AsInteger := nCodVendedorKit;
      if nCodTecnicoMecanico <> -1 then
        dataSet.FieldByName('COL_COD_VENDEDOR').AsInteger := nCodTecnicoMecanico;
    end;
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('tipo').AsString := FOwner.dataSet.FieldByName('tipo').AsString;
    dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;
    dataSet.FieldByName('nitem').AsInteger := vMaxItem + 1;
    if Trim(fCodPedidoDeCompra) <> '' then
    begin
      dataSet.FieldByName('nitemped_compra').AsInteger := nItem + 1;
      dataSet.FieldByName('xped_compra').AsString := fCodPedidoDeCompra;
    end;
    dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;
    dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';
    dataSet.FieldByName('NAT_DESCACRES').AsString := 'PERCENTUAL';
    if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') then
      vTipServ.abreTipoServico(FOwner.dataSet.FieldByName('NPED').AsInteger, FOwner.dataSet.FieldByName('TIPO').AsString);

    vQuantidade := 0;
    vUnidade := '';
    vNat_DescAcresc      := '';
    vTp_DescAcresc       := '';
    vValor_DescAcresc    := 0;
    vPerc_Comissao_Vend3 := 0;
  end;
end;

procedure TPedVendaProd.pedVendaProdBeforePost(DataSet: TDataSet);
var
  I: Integer;
begin
  {
  dataSet.FieldByName('VLUN_PED_ITEM').AsString :=
    StringReplace(Trim(format('%14.' + vSing.vCasasDecimais + 'n',
    [dataSet.FieldByName('VLUN_PED_ITEM').AsFloat])), '.', '', [rfReplaceAll]);
  dataSet.FieldByName('VLUN_PED_NF').AsString :=
    StringReplace(Trim(format('%14.' + vSing.vCasasDecimais + 'n',
    [dataSet.FieldByName('VLUN_PED_NF').AsFloat])), '.', '', [rfReplaceAll]);
  dataSet.FieldByName('QUANT_PED_ITEM').AsString :=
    StringReplace(Trim(format('%14.4n',
    [dataSet.FieldByName('QUANT_PED_ITEM').AsFloat])), '.', '', [rfReplaceAll]);
  dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat := vDadosIni.StrToFloatFormat(
    (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
		dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
  }
  dataSet.FieldByName('VLUN_PED_ITEM').AsFloat  := ffloat('VLUN_PED_ITEM' , 0 - vSing.iCasasDecimais);
  dataSet.FieldByName('VLUN_PED_NF').AsFloat    := ffloat('VLUN_PED_NF'   , 0 - vSing.iCasasDecimais);
  dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := ffloat('QUANT_PED_ITEM', 0 - 4);
  dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat := RoundTo(ffloat('QUANT_PED_ITEM') * ffloat('VLUN_PED_ITEM'), -2);
	if Trim(dataSet.FieldByName('md5').AsString) = '' then
		dataSet.FieldByName('md5').AsString := 'SISTEMA' + IntToStr(dataSet.FieldByName('NPED').AsInteger);

  if dtSet.Locate('NITEM', dataSet.FieldByName('NITEM').AsInteger, []) then
  begin
    dtSet.Edit;
    dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
    dtSet.FieldByName('GRUPO_PROD').AsInteger := DataSet.FieldByName('GRUPO_PROD').AsInteger;
    dtSet.FieldByName('COD_GRADE').AsInteger := DataSet.FieldByName('COD_GRADE').AsInteger;
    dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
    dtSet.FieldByName('NUM_FAB_PROD').AsString := DataSet.FieldByName('NUM_FAB_PROD').AsString;
    dtSet.FieldByName('COD_PROD').AsString := DataSet.FieldByName('COD_PROD').AsString;
    dtSet.FieldByName('DESCR_PROD_PED').AsString := DataSet.FieldByName('DESCR_PROD_PED').AsString;
    dtSet.FieldByName('CODIGO_NOP').AsFloat := DataSet.FieldByName('CODIGO_NOP').AsFloat;
    dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
    dtSet.FieldByName('STATUS').AsString := DataSet.FieldByName('STATUS').AsString;
    dtSet.FieldByName('UNIDADE').AsString := UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString));
    dtSet.FieldByName('QUANT_PED_ITEM').AsFloat := DataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
    dtSet.FieldByName('VLUN_PED_ITEM').AsFloat := DataSet.FieldByName('VLUN_PED_ITEM').AsFloat;
    dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat := DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
    dtSet.FieldByName('RATEIO_ACRESC').AsCurrency := dataSet.FieldByName('RATEIO_ACRESC').AsCurrency;
    dtSet.FieldByName('ACRESC_ITEM').AsCurrency := dataSet.FieldByName('ACRESC_ITEM').AsCurrency;
    dtSet.FieldByName('RATEIO_DESC').AsCurrency := dataSet.FieldByName('RATEIO_DESC').AsCurrency;
    dtSet.FieldByName('DESC_ITEM').AsCurrency := dataSet.FieldByName('DESC_ITEM').AsCurrency;
    dtSet.FieldByName('TABPRATICADA').AsString := dataSet.FieldByName('TABPRATICADA').AsString;
    dtSet.FieldByName('QUANT_ITEM_DEV').AsFloat := DataSet.FieldByName('QUANT_ITEM_DEV').AsFloat;
    dtSet.FieldByName('MAX_DESC_TAB').AsFloat := DataSet.FieldByName('MAX_DESC_TAB').AsFloat;
    dtSet.FieldByName('COD_PEDIDO').AsInteger := DataSet.FieldByName('COD_PEDIDO').AsInteger;
    dtSet.FieldByName('NITEM_PEDIDO').AsInteger := DataSet.FieldByName('NITEM_PEDIDO').AsInteger;
    dtSet.FieldByName('COD_NSERIE').AsInteger := DataSet.FieldByName('COD_NSERIE').AsInteger;
    dtSet.FieldByName('VALOR_DESCACRES').AsFloat := DataSet.FieldByName('VALOR_DESCACRES').AsFloat;
    dtSet.FieldByName('PRECOPORQTDE').AsString := dataSet.FieldByName('PRECOPORQTDE').AsString;
    dtSet.FieldByName('NF_DC_DESPNF').AsFloat := DataSet.FieldByName('NF_DC_DESPNF').AsFloat;
    dtSet.FieldByName('UNIDADE_CONV').AsString := UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString));
    dtSet.FieldByName('OPERACAO_CONV').AsString := dataSet.FieldByName('OPERACAO_CONV').AsString;
    dtSet.FieldByName('FATOR_CONV').AsFloat := dataSet.FieldByName('FATOR_CONV').AsFloat;
    
    dtSet.Post;
  end
  else
  begin
    dtSet.Insert;
    for I := 0 to dtSet.Fields.Count - 1 do
    	if dataSet.FindField(dtSet.Fields[I].FieldName) <> nil then
      dtSet.Fields[I].Value := dataSet.FieldByName(dtSet.Fields[I].FieldName).Value;
    dtSet.Post;
  end;
end;

function TPedVendaProd.post(pServico: boolean = true): boolean;
var
	buscas2: TIBQuery;
  vdttransf: TDate;
  vmensagem: string;
  vDescAcresc: string;
  vPercValor: string;
  vValorDescAcresc: Double;
  vValorUnOrig: Double;
  vQtde: Double;
  vValorUn: Double;
  vExibirDesconto: string;
begin
	try
  	Result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    try

      vdttransf := vDadosIni.getDataBanco(buscas);
      if not (dataSet.State in [dsInsert, dsEdit]) then
      begin
        result := true;
        exit;
      end;

      if vSing.vTipoVenda = 'REQ' then
      begin
        if not vDadosIni.PesqPros('VND013', 'SALVAR',
          dataSet.FieldByName('TIPO').AsString + ' - ' +
          ' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
          ' GRUPO: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
          ' COD PROD: ' + dataSet.FieldByName('COD_PROD').AsString +
          vDadosIni.IfThen(vDadosIni.vTintas = 'S', ' DESCR: ' + trim(dataSet.FieldByName('DESCR_PROD_PED').AsString), ''),
          'PEDVENDA_PROD', dataSet.FieldByName('NPED').AsString, buscas, true) then
            Exit;
      end
      else if vSing.vTipoVenda = 'OS' then
      begin
        if not vDadosIni.PesqPros('VND017', 'SALVAR',
          dataSet.FieldByName('TIPO').AsString + ' - ' +
          ' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
          ' GRUPO: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
          ' COD PROD: ' + dataSet.FieldByName('COD_PROD').AsString +
          vDadosIni.IfThen(vDadosIni.vTintas = 'S', ' DESCR: ' + trim(dataSet.FieldByName('DESCR_PROD_PED').AsString), ''),
          'PEDVENDA_PROD', dataSet.FieldByName('NPED').AsString, buscas, true) then
            Exit;
      end
      else
      begin
        if not vDadosIni.PesqPros('VND021', 'SALVAR',
          dataSet.FieldByName('TIPO').AsString + ' - ' +
          ' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
          ' GRUPO: ' + dataSet.FieldByName('GRUPO_PROD').AsString +
          ' COD PROD: ' +	dataSet.FieldByName('COD_PROD').AsString +
          vDadosIni.IfThen(vDadosIni.vTintas = 'S', ' DESCR: ' + trim(dataSet.FieldByName('DESCR_PROD_PED').AsString), ''),
          'PEDVENDA_PROD', dataSet.FieldByName('NPED').AsString, buscas, true) then
            Exit;
      end;

      if FOwner.vendaFechada then
        Exit;

      if (vSing.vTipoVenda <> 'REQ') and (not vSing.vOrcamentoSoPecas)
        and (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') and (pServico) then
      begin
        if FOwner.vItServ.IsEmpty then
          raiseExceptioncreate('Nenhum serviço aplicado.' + chr(13) + 'Favor Verificar.', 'DBLookupComboBox8');
        if (FOwner.vItServ.dataSet.FieldByName('cod_servico').AsInteger > 0)
        and (dataSet.FieldByName('nitem_serv').AsInteger = FOwner.vItServ.dataSet.FieldByName('nitem_serv').AsInteger) then
          dataSet.FieldByName('cod_seg_serv').AsInteger := FOwner.vItServ.dataSet.FieldByName('cod_servico').AsInteger;
        if (dataSet.FieldByName('cod_seg_serv').AsInteger <= 0) then
          raiseExceptioncreate('Serviço não informado.' + chr(13) + 'Favor Verificar', 'DBLookupComboBox8')
        else if not FOwner.vItServ.dataSet.Locate('nitem_serv', dataSet.FieldByName('nitem_serv').AsInteger, []) then
          raiseExceptioncreate('Serviço informado não foi encontrado entre os serviços aplicados.' + chr(13) + 'Favor Verificar.', 'DBLookupComboBox8');
      end;

      if trim(dataSet.FieldByName('cod_prod').AsString) = '' then
        raiseExceptionCreate('Produto não encontrado', 'Dbedit46');
      if trim(dataSet.FieldByName('grupo_prod').AsString) = '' then
        raiseExceptionCreate('Produto não encontrado', 'Dbedit46');
      if trim(dataSet.FieldByName('num_fab_prod').AsString) = '' then
        raiseExceptionCreate('Produto não encontrado', 'Dbedit46');
      if trim(dataSet.FieldByName('cod_vendedor').AsString) = '' then
        raiseExceptionCreate('Vendedor não informado', 'DBEdit54');
      if dataSet.FieldByName('codigo_nop').AsFloat = 0 then
        //raiseExceptionCreate('CFOP não informado' + chr(13) + 'Favor Verificar', 'DBEdit50');
        dataSet.FieldByName('codigo_nop').AsFloat := 5102;

      if (vDadosIni.strIn(dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
      begin
      	if dataSet.FieldByName('TABPRATICADA').AsString = 'P' then
          vmensagem := 'promocao'
        else if dataSet.FieldByName('TABPRATICADA').AsString = 'T' then
          vmensagem := 'diferenciado'
        else if dataSet.FieldByName('TABPRATICADA').AsString = 'Q' then
          vmensagem := 'por quantidade';

        vDescAcresc       := dataSet.FieldByName('TP_DESCACRES').AsString;
        vPercValor        := dataSet.FieldByName('NAT_DESCACRES').AsString;
        vValorDescAcresc  := dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
        vQtde             := dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
        vValorUnOrig      := dataSet.FieldByName('VLUN_ORIG').AsFloat;

        if  ((dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S'))
        	or ((dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S'))
          or ((dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S')) then
        begin
        	vExibirDesconto := 'S';
          vValorUn        := vDadosIni.StrToFloatFormat(dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, 2)
                               - vDadosIni.StrToFloatFormat(vDadosIni.IfThen(vDescAcresc = 'DESCONTO',  vDadosIni.IfThen(vPercValor = 'PERCENTUAL', ((vValorDescAcresc * (vQtde* vValorUn)) / vQtde), 0), 0), 2)
                               - vDadosIni.StrToFloatFormat(vDadosIni.IfThen(vDescAcresc = 'DESCONTO',  vDadosIni.IfThen(vPercValor = 'VALOR', (vValorDescAcresc / vQtde), 0), 0), 2)
                               + vDadosIni.StrToFloatFormat(vDadosIni.IfThen(vDescAcresc = 'ACRÉSCIMO', vDadosIni.IfThen(vPercValor = 'PERCENTUAL', ((vValorDescAcresc * (vQtde* vValorUn)) / vQtde), 0), 0), 2)
                               + vDadosIni.StrToFloatFormat(vDadosIni.IfThen(vDescAcresc = 'ACRÉSCIMO', vDadosIni.IfThen(vPercValor = 'VALOR', (vValorDescAcresc / vQtde), 0), 0), 2);
        end
        else
        begin
        	vExibirDesconto := 'N';
        	vValorUn        := dataSet.FieldByName('VLUN_PED_ITEM').AsFloat;
        end;

        if (trim(dataSet.FieldByName('TP_DESCACRES').AsString) <> '')
          and (trim(dataSet.FieldByName('TP_DESCACRES').AsString) <> 'DESCONTO')
          and (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
        begin
        	if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
          	raiseExceptionCreate('Não é possível alterar o tipo (desconto/acrescimo), produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBComboBox6')
          else
        		raiseExceptionCreate('Não é possível alterar o tipo (desconto/acrescimo), produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBComboBox10');
        end
        else if (trim(dataSet.FieldByName('NAT_DESCACRES').AsString) <> '')
          and (trim(dataSet.FieldByName('NAT_DESCACRES').AsString) <> 'VALOR')
          and (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
        begin
        	if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
          	raiseExceptionCreate('Não é possível alterar a natureza (percentual/valor), produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBComboBox7')
          else
        		raiseExceptionCreate('Não é possível alterar a natureza (percentual/valor), produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBComboBox11');
        end
        else if vDadosIni.StrToFloatFormat(vValorUn, 2) <> vDadosIni.StrToFloatFormat(vValorUnOrig, 2) then
        begin
          if (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
          begin
            if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
            	raiseExceptionCreate('Não é possível conceder desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ', produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBEdit95')
            else
            	raiseExceptionCreate('Não é possível conceder desconto' + IfThen(vExibirDesconto = 'S', ' adicional', '') + ', produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBEdit134');
          end
          else
          begin
          	if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
            	raiseExceptionCreate('Não é possível alterar valor unitário, produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBEdit14')
            else
            	raiseExceptionCreate('Não é possível alterar valor unitário, produto com preço ' + vmensagem + chr(13) + 'Favor Verificar', 'DBEdit51');
        	end;
        end;
      end;

      // Atualizar valor total do item se unidade do produto não for fracionada
      if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
        ' WHERE UPPER(SIGLA) = ' + QuotedStr(vDadosIni.IfThen(trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '',
          UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)),
          UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)))), buscas2).IsEmpty then
      begin
        if buscas2.FieldByName('FRACIONADO').AsInteger = 0 then
        begin
          if trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '' then
          begin
            dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat :=
              RoundTo(dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, 0);

            if not SqlOpen(' select ps.grupo_prod, ps.cod_prod, ps.cod_empresa, ps.unidade, ' +
              ' ps.quantidade, ps.operacao, ps.disponivel_venda, ps.padrao_venda, ' +
              ' pr.unidade as unidade_prod from produtos pr ' +
              ' inner join produtos_conversao_saida ps on ' +
              '   ps.grupo_prod = pr.grupo_prod ' +
              '		and ps.cod_prod = pr.cod_prod ' +
              '   and ps.cod_empresa = pr.cod_empresa ' +
              ' where ps.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
              ' and ps.cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
              ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and upper(ps.unidade) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) +
              ' and ps.quantidade > 0 ' +
              ' and ((ps.operacao = ''M'') or (ps.operacao = ''D'')) ', buscas2).IsEmpty then
            begin
              if buscas2.FieldByName('OPERACAO').AsString = 'M' then
                dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
                  dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat /
                  buscas2.FieldByName('QUANTIDADE').AsFloat, 0)
              else if buscas2.FieldByName('OPERACAO').AsString = 'D' then
                dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
                  dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat *
                  buscas2.FieldByName('QUANTIDADE').AsFloat, 0);
            end
            else
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
                dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 0);
          end
          else
            dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, 0);

          dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency :=
            vDadosIni.StrToFloatFormat(
              (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
                dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
        end
        else
        begin
          dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency :=
            vDadosIni.StrToFloatFormat(
              (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
                dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
        end;
      end;

      if dataSet.FieldByName('TABPRATICADA').IsNull then
        dataSet.FieldByName('TABPRATICADA').AsString := 'N';

      if dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat < 0  then
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;

      if dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat < 0 then
        dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat := 0;

      if dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat < 0  then
        dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;

      if dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat < 0 then
        dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsFloat := 0;

      //    if not venda.verificaColaboradorProdutos(1) then
      if not FOwner.verificaColaboradorProdutos(true, false) then
        Exit;

      if not checaValoresItens then
        exit;
      if vSing.vTipoVenda <> 'ORC' then
      begin
        if not vProduto.validaEstoque then
        begin
          if vSing.vVendaRapida then
            inherited cancel;
          Exit;
        end;
      end;

      //    verificaAcresDescNoItem;
      if vSing.vVendaRapida then
        if not validaAcresDescNoItem then
        begin
          inherited cancel;
          exit;
        end;
      if not validaMargemLucro then
      begin
        if vSing.vVendaRapida then
          dataSet.Cancel;
        exit;
      end;
      definirValorNF;

      if dataSet.State = dsInsert then
      begin
        dataset.FieldByName('DATA_TRANSF').AsDateTime := vdttransf;
        if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
          and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
          and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
        begin
          buscas.Close;
          buscas.SQL.Text := 'select max(nitem) as nitem from pedvenda_prod' +
            ' where nped = ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger) +
            ' and tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('tipo').AsString) +
            ' and cod_empresa =  ' + vDadosIni.codEmpresa;
          buscas.Open;
          dataSet.FieldByName('nitem').AsInteger := buscas.FieldByName('nitem').AsInteger + 1;
        end;
      end;

      if (Trim(dataSet.FieldByName('XPED_COMPRA').AsString) = '') or (dataSet.FieldByName('nitemped_compra').AsInteger = 0) then
      begin
        dataSet.FieldByName('nitemped_compra').Value := Null;
        dataSet.FieldByName('xped_compra').Value := Null;
      end;
      if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
        and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
        and (dataSet.FieldByName('NPED').AsInteger = 0)
        and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
          dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;

      if (dataSet.FieldByName('CODIGO_KIT').AsInteger <= 0) then
        dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString := trim(dataSet.FieldByName('DESCR_PROD_PED').AsString);

      if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('NPED').AsInteger = 0) then
        if not FOwner.verificaVendaCondicional then
          exit;

  	  // Atualizar valor liquido, rateio acresc  e rateio desc
      dataSet.FieldByName('RATEIO_ACRESC').AsFloat :=
        RoundTo(dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat
          + dataSet.FieldByName('ACRESC_ITEM').AsFloat, -2);

      dataSet.FieldByName('RATEIO_DESC').AsFloat   :=
        RoundTo(dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat
          + dataSet.FieldByName('DESC_ITEM').AsFloat, -2);

      dataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat :=
        RoundTo(dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat
          + IfThen(dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat > 0, dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat, 0) +
          		dataSet.FieldByName('ACRESC_ITEM').AsFloat
          - IfThen(dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat > 0, dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat, 0) -
          		dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

      if dataSet.FieldByName('QUANT_PED_ITEM').AsFloat > 0 then
        dataSet.FieldByName('VLUN_PED_ITEM_LIQ').AsFloat := RoundTo(
          dataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat / dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));

      if dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0 then
        dataSet.FieldByName('VLUN_PED_ITEM_CONV_LIQ').AsFloat := RoundTo(
          dataSet.FieldByName('VLTOT_PED_ITEM_LIQ').AsFloat / dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
 

      Result := inherited post;

      if Result then
        if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO') then
          if (FOwner.dataSet.FieldByName('nped').AsInteger = 0) then
            FOwner.verificaSalvamentoAutomatico
          else
          begin
            Result := Apply;
            if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
            begin
              vListarImprimirItemVan := FOwner.retornaVendaTipoVan;
              abrePedVendaProd(FOwner.dataSet.FieldByName('nped').AsInteger);
            end;
          end;

      Inc(nItem);
      fCodPedidoDeCompra := dataSet.FieldByName('XPED_COMPRA').AsString;

      FOwner.fat_ped.calcular_valores_nf_atualizar;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaProd.ProdutoPossuiGrade(grupoprod: integer; codprod: string): boolean;
begin
  result := ExecutaComandosSql('select first 1 cgp.cod_grade from cod_grade_prod cgp' +
    ' inner join grade g on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa' +
    ' where cgp.grupo_prod = ' + IntToStr(grupoprod) +
    ' and cgp.cod_prod = ' + QuotedStr(trim(codprod)) +
    ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa);
  if (not result) and (dataSet.State in [dsEdit, dsInsert]) then
    dataSet.FieldByName('cod_grade').AsInteger := 0;
end;

