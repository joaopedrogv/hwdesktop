{ TConfirmaVenda }

procedure TConfirmaVenda.confirmaVenda;///
var
  vNPED, vCodConferencia: integer;
  vPedVenda: TPedVenda;
begin
  try
    vDadosIni.vtpVenda := Trim(vDadosIni.getCampoPipe(vDadosIni.vPesquisa, 1));
    vNPED := StrToIntDef(vDadosIni.getCampoPipe(vDadosIni.vPesquisa, 2), 0);
    vCodConferencia := StrToIntDef(vDadosIni.getCampoPipe(vDadosIni.vPesquisa, 3), 0);

    if ((vDadosIni.vtpVenda = '') or (vNPED = 0) or (vCodConferencia = 0)) then
			Exit;

    if DtmPedVenda = nil then
    	DtmPedVenda := TDtmPedVenda.create(DtmPedVenda);

    vPedVenda := TPedVenda.create(DtmPedVenda);
    vPedVenda.dataSet := TClientDataSet(DtmPedVenda.cdsVnd);
    vPedVenda.vItProd.dataSet := TClientDataSet(DtmPedVenda.cdsIVnd);
    vPedVenda.buscas := TIBQuery(DtmPedVenda.qrbuscasVnd);
    vPedVenda.transacao := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    vPedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    vPedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);

    vPedVenda.abrePedVenda(vNPED);

    if not(fechaConferenciaCega(vNPED, vCodConferencia, vDadosIni.vtpVenda)) then
    	Exit;

    if not vPedVenda.Edit then
      Exit;

    if not vPedVenda.validaConfirmacao then
    begin
    	vPedVenda.Cancel;
    	Exit;
    end;

    if not vPedVenda.calculaDescontoAcrescimo then
      Exit;

    if vDadosIni.vtpVenda = 'REQ' then
    begin
      if not vPedVenda.vItProd.vProduto.validaEstoqueFechamento then
      begin
        Application.MessageBox('O documento não foi confirmado.', 'Informação', MB_ICONEXCLAMATION + MB_OK);
        Exit;
      end;
    end;
    
    vPedVenda.abrePedVenda(vPedVenda.dataSet.FieldByName('NPED').AsInteger);
    vPedVenda.confirmarVenda(False, True);

    vPedVenda.RollBackTransacao;
  finally
    vPedVenda.pedidoEmEdicao(caRemoverEdicao, False);
    vPedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    vPedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.IBTransPedVenda);
    if vPedVenda.dataSet.FieldByName('COD_CLIENTE').AsInteger > 0 then
    	vPedVenda.vCliente.abreClientes(vPedVenda.dataSet.FieldByName('COD_CLIENTE').AsInteger);

    	if vPedVenda <> nil then
				FreeAndNil(vPedVenda);
  end;
end;

function TConfirmaVenda.updateConferencia(pCodConferencia: integer): Boolean;
begin
	try
    DtmPedVenda.qrbuscasVnd.Close;
    DtmPedVenda.qrbuscasVnd.SQL.Text := ' UPDATE CONFERENCIA_CEGA C SET ' +
    	' C.STATUS = ''FECHADA'', ' +
      ' C.DATA_FECHAMENTO = ' + vDadosIni.FusoSqlDate + ', ' +
		'C.DATA_HORA_FECHAMENTO = ' + vDadosIni.FusoSqlDateTime +
		  ' WHERE C.COD_CONFERENCIA = :COD_CONFERENCIA ' +
      ' AND C.COD_EMPRESA = :COD_EMPRESA ';
    DtmPedVenda.qrbuscasVnd.ParamByName('COD_CONFERENCIA').AsInteger := pCodConferencia;
    DtmPedVenda.qrbuscasVnd.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    DtmPedVenda.qrbuscasVnd.ExecSQL;

    Result := True;
  except on E: Exception do
  	Result := False;
  end;
end;

function TConfirmaVenda.fechaConferenciaCega(pNPED, pCodConferencia: integer; pTipo: string): Boolean;
begin
  try
  	Result := False;
    
		vDadosIni.informarSituacaoPedido(pNPED, pTipo, 'EXPEDICAO', 'Finalizado', '', buscas, False, False, False);
    
    if not(vDadosIni.mudarStatusSeparacao(pNPED, pTipo, cConferido, buscas)) then
    	Exit;

    if not(updateConferencia(pCodConferencia)) then
    	Exit;
    
  	Result := True;
  except on E: Exception do
  	Result := False;
  end;
end;

