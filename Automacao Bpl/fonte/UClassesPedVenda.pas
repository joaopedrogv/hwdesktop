begin
  result := false;
  if dtSetOrcTemp.IsEmpty then
  begin
    Application.MessageBox(Pchar('Nenhum registro foi selecionado para mesclagem.'), 'Atenção', +MB_ICONWARNING + MB_OK);
    exit;
