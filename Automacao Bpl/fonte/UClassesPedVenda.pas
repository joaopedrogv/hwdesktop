function TPedVendaProd.adicionarQtdeItem(vQuant: string = ''): boolean;
var
 vQtde: string;
 vProcesso: string;
begin
   Result := False;

   if FOwner.getTipoVenda = 'REQ' then
   	vProcesso := 'VND229'
   else if FOwner.getTipoVenda = 'OS' then
      vProcesso := 'VND230'
   else
   	vProcesso := 'VND231';   

   if not vDadosIni.PesqPros(vProcesso, 'ADICIONAR QTDE AO ITEM',
     dataSet.FieldByName('TIPO').AsString +
   	 ' NITEM: ' + dataSet.FieldByName('NITEM').AsString +
     ' GRUPO:' + dataSet.FieldByName('GRUPO_PROD').AsString +
   	 ' COD PROD:' + dataSet.FieldByName('COD_PROD').AsString, 'PEDVENDA_PROD',
   	 dataSet.FieldByName('NPED').AsString, buscas, true) then
    	 Exit;

	vQtde := vDadosIni.IfThen(vQuant = '0', '1', vQuant);
   try
     if InputQuery('Informe a quantidade', 'Informe a quantidade que deseja adicionar ao item', vQtde) then
     begin
       StrToFloat(vQtde);
     end;
   except
     Application.MessageBox(pchar('Quantidade inválida'), 'Informação', MB_ICONINFORMATION + MB_OK);
     exit;
   end;

   if trim(vQtde) = '' then
   begin
     Application.MessageBox(pchar('Quantidade não informada'), 'Informação', MB_ICONINFORMATION + MB_OK);
     exit;
   end
   else if StrToFloat(trim(vQtde)) <= 0 then
   begin
     Application.MessageBox(pchar('Quantidade não informada'), 'Informação', MB_ICONINFORMATION + MB_OK);
     exit;
   end;

   dataSet.Edit;
   dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat + StrToFloat(vQtde), - 4);
   if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) = '')
   	  or (UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
   begin
   	  dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);
   end
   else
   begin
     if (dataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
       dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
       	 dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat /
         dataSet.FieldByName('FATOR_CONV').AsFloat, - 4)
     else if (dataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
       dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
       	 dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat *
         dataSet.FieldByName('FATOR_CONV').AsFloat, - 4)
     else
       dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);
   end;
   dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
   	 (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
     	 dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
   if not buscaProduto('', dataSet.FieldByName('grupo_prod').AsInteger, dataSet.FieldByName('cod_prod').AsString, 0, false, FOwner.vSing.vVendaRapida, false) then
     Exit;
   dataSet.Post;

   if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO') then
     if (FOwner.dataSet.FieldByName('nped').AsInteger = 0) then
       FOwner.verificaSalvamentoAutomatico
     else
     begin
       Result := Apply;
       if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
       begin
         vListarImprimirItemVan := FOwner.retornaVendaTipoVan;
         abrePedVendaProd(FOwner.dataSet.FieldByName('nped').AsInteger);
       end;
     end;
//   Apply;
//   dataSet.RefreshRecord;

   Result := True;
end;

