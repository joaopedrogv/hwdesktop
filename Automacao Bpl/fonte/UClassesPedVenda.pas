procedure TPedvendaItProd_comiss_classList.SetValuesFrom(ADataSet: TDataSet;
  APercVnd, APercPart: Double; ACodVend: Integer; ACodPart: Integer; ATestarVdn: boolean);
var
  vatualizarVND, vatualizarPart: boolean;
begin
  ADataSet.First;
  while not ADataSet.Eof do
  begin
    vatualizarVND := false;
    vatualizarPart := false;

    if not ATestarVdn then
    begin
      vatualizarVND := true;
      vatualizarPart := true;
    end
    else
    begin
      if ACodVend = ADataSet.FieldByName('COD_VENDEDOR').AsInteger then
        vatualizarVND := true
      else if ACodPart = ADataSet.FieldByName('COD_VENDEDOR1').AsInteger then
        vatualizarPart := true;
    end;

    with New do
    begin
      FatualizarVND        := vatualizarVND;
      FatualizarPart       := vatualizarPart;
      Fvltot_ped_item      := ADataSet.FieldByName('VLTOT_PED_ITEM').AsFloat
      	- ADataSet.FieldByName('RATEIO_DESC').AsFloat + ADataSet.FieldByName('RATEIO_ACRESC').AsFloat;
      Fstatus              := Trim(ADataSet.FieldByName('STATUS').AsString);
      Fvl_comissao_vend    := ADataSet.FieldByName('VL_COMISSAO_VEND').AsFloat;
      Fperc_comissao_vend  := ADataSet.FieldByName('PERC_COMISSAO_VEND').AsFloat;
      Fvl_comissao_vend1   := ADataSet.FieldByName('VL_COMISSAO_VEND1').AsFloat;
      Fperc_comissao_vend1 := ADataSet.FieldByName('PERC_COMISSAO_VEND1').AsFloat;
      Fperc_prod_vendedor     := APercVnd;
      Fperc_prod_participante := APercPart;
    end;

    ADataSet.Next;
  end;
end;

procedure TPedvendaItProd_comiss_classList.SetValuesFromIn(
  ADataSet: TClientDataSet; AdoPost, AdoInsert, AdoAppend, AdoEdit: Boolean);
var
 I: Integer;
begin
  ADataSet.First;
  for I := 0 to Self.Count - 1 do
    with Self.Items[I] do
    begin
       if (FatualizarVND) or (FatualizarPart) then
       begin
         if ADataSet.State = dsBrowse then
          if AdoEdit then
            ADataSet.Edit
          else if AdoAppend then
            ADataSet.Append
          else if AdoInsert then
            ADataSet.Insert;

          if (FatualizarVND) then
          begin
            ADataSet.FieldByName('VL_COMISSAO_VEND').AsFloat    := Fvl_comissao_vend;
            ADataSet.FieldByName('PERC_COMISSAO_VEND').AsFloat  := Fperc_comissao_vend;
          end;

          if (FatualizarPart) then
          begin
            ADataSet.FieldByName('VL_COMISSAO_VEND1').AsFloat   := Fvl_comissao_vend1;
            ADataSet.FieldByName('PERC_COMISSAO_VEND1').AsFloat := Fperc_comissao_vend1;
          end;

          if AdoPost then
            ADataSet.Post;
       end;
       ADataSet.Next;
    end;
end;

