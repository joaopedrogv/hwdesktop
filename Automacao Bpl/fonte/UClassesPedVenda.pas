function TCondPagPed._existeCondPagPadrao: boolean;
var
	vSql: string;
  buscas2: TIBQuery;
begin
	try
    Result := False;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if not vDadosIni.vCliente.vCondPagPorCliente then
      exit;

    vSql  := ' SELECT FIRST 1 COND_PAG.COD_COND_PAG, COND_PAG.DESC_COND_PAG, COND_PAG.SEQPRECO FROM COND_PAG ' +
      ' INNER JOIN COND_PAG_EMPRESA ON ' +
      '		COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
      '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' WHERE COND_PAG.NATUREZA_CP <> ''C'' ' +
      ' AND COND_PAG.ATIVO = 1 ';

    vSql := vSql + ' AND COALESCE(COND_PAG.COND_PADRAO_CL_VND, ''N'') = ''T'' ';

    buscas2.Close;
    buscas2.SQL.Text := vSql;
    buscas2.Open;

    Result := buscas2.RecordCount > 0;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

{ TPedVendaProdTerc }

function TPedVendaProdTerc.abreProdTerceiro(nPed: integer): boolean;
var
	I: Integer;
begin
  try
    dataset.close;
  except
  end;
  result := montaSelect(' SELECT * FROM PEDVENDA_PROD_TERC ' +
  	' WHERE NPED = ' + inttostr(nPed) +
    ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and ATIVO = 1 ' +
    ' ORDER BY SEQID ');

  dataSet.First;
  dtSet.open;
  dtSet.EmptyDataSet;
  while not DataSet.Eof do
  begin
    dtSet.Insert;
    dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
    dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
    dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
    dtSet.FieldByName('DESCRICAO').AsString := DataSet.FieldByName('DESCRICAO').AsString;
    dtSet.FieldByName('QTDE').AsFloat := DataSet.FieldByName('QTDE').AsFloat;
    dtSet.FieldByName('VL_UNIT').AsFloat := DataSet.FieldByName('VL_UNIT').AsFloat;
    dtSet.FieldByName('VL_TOTAL').AsFloat := DataSet.FieldByName('VL_TOTAL').AsFloat;
    dtSet.FieldByName('UNIDADE').AsString := UpperCase(trim(DataSet.FieldByName('UNIDADE').AsString));
    dtSet.FieldByName('COD_VENDEDOR').AsInteger := DataSet.FieldByName('COD_VENDEDOR').AsInteger;
    dtSet.FieldByName('ATIVO').AsInteger := DataSet.FieldByName('ATIVO').AsInteger;
    dtSet.FieldByName('COD_FORNECEDOR').AsInteger := DataSet.FieldByName('COD_FORNECEDOR').AsInteger;
    dtSet.FieldByName('NOME_FORNECEDOR').AsString := DataSet.FieldByName('NOME_FORNECEDOR').AsString;
    dtSet.FieldByName('VLCUSTO').AsFloat := DataSet.FieldByName('VLCUSTO').AsFloat;
    dtSet.FieldByName('VLCUSTO_TOT').AsFloat := DataSet.FieldByName('VLCUSTO_TOT').AsFloat;
    dtSet.Post;

    DataSet.Next;
  end;
  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;

  defineCamposDtSetTemp;
  if Assigned(dtSetTemp) then
  begin
  	vSeqId := 0;
    
    dtSetTemp.Close;
    dtSetTemp.CommandText := ' SELECT * FROM PEDVENDA_PROD_TERC ' +
      ' WHERE NPED = ' + inttostr(nPed) +
      ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
      ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' and ATIVO = 1 ' +
      ' ORDER BY SEQID ';
    dtSetTemp.Open;
    dtSetTemp.EmptyDataSet;

    dataSet.First;
    while not dataSet.Eof do
    begin
      dtSetTemp.Insert;
      for I := 0 to dataSet.Fields.Count - 1 do
        dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
      dtSetTemp.Post;
      vSeqId := dataSet.FieldByName('SEQID').AsInteger;

      dataSet.Next;
    end;
    dataSet.First;
  end;
end;

function TPedVendaProdTerc.abreProdTerceiro(nPed: integer; pTipo: string;
  pMesclar: boolean): boolean;
var
  i: integer;
begin
  try
    dataset.close;
  except
  end;
  result := montaSelect(' SELECT * FROM PEDVENDA_PROD_TERC ' +
  	' WHERE NPED = ' + inttostr(nPed) +
    ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and ATIVO = 1 ' +
    ' ORDER BY SEQID ');

  if not dtSetIt.Active then
    dtSetIt.open;
  //  if pEmptyDataSet then
  //    dtSetIt.EmptyDataSet;
  DataSet.First;
  while not DataSet.Eof do
  begin
    if not dtSetIt.Locate('NPED;TIPO;COD_EMPRESA;DESCRICAO',
    	VarArrayOf([dataset.FieldByName('NPED').AsInteger,
                  trim(dataset.FieldByName('TIPO').AsString),
                  dataset.FieldByName('COD_EMPRESA').AsInteger,
                  trim(dataset.FieldByName('DESCRICAO').AsString)]), [loCaseInsensitive]) then
    begin
      dtSetIt.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
        dtSetIt.FieldByName(dataSet.Fields[I].FieldName).Value :=
          dataSet.Fields[I].Value;
    	dtSetIt.FieldByName('QTDAMESCLAR').AsFloat := RoundTo(dataSet.FieldByName('QTDE').AsFloat, - 4);

      dtSetIt.Post;
    end;
    DataSet.Next;
  end;
  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;
end;

procedure TPedVendaProdTerc.atualizarDtSetTemp(acao: string; pAtualizarSeqId: boolean = false);
var
  I: Integer;
begin
	if dtSetTemp = nil then
  	exit;

	if acao = 'EXCLUIR' then
  begin
    try
      dtSetTemp.Filter := ' nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' and tipo = ' + QuotedStr(trim(dataSet.FieldByName('tipo').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and descricao = ' + QuotedStr(dataSet.FieldByName('descricao').AsString);
      dtSetTemp.Filtered := true;

      if not dtSetTemp.IsEmpty then
        dtSetTemp.Delete;
    finally
      dtSetTemp.Filtered := false;
    end;
  end
	else if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'N') or (pAtualizarSeqId) then
  begin
    if acao = 'EDITAR' then
    begin
      try
        dtSetTemp.Filter := ' nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tipo = ' + QuotedStr(trim(dataSet.FieldByName('tipo').AsString)) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and descricao = ' + QuotedStr(vDadosIni.IfThen(pAtualizarSeqId,
          	dataSet.FieldByName('descricao').AsString, descricaoTemp));
        dtSetTemp.Filtered := true;

        if not dtSetTemp.IsEmpty then
          dtSetTemp.Edit
        else
          dtSetTemp.Insert;
        for i := 0 to dataSet.Fields.Count - 1 do
        	dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
        dtSetTemp.Post;
      finally
        dtSetTemp.Filtered := false;
      end;
    end
    else if acao = 'INSERIR' then
    begin
      dtSetTemp.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
    		dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
      dtSetTemp.Post;
    end;
  end;
end;

procedure TPedVendaProdTerc.CalculaValorTotalItens;
begin
  vTotalItens := 0;
  nItem := 0;
  if vSing.vTipoVenda = 'REQ' then
    exit;
  dataSet.First;
  while not dataSet.Eof do
  begin
    vTotalItens := vTotalItens + RoundTo(dataSet.FieldByName('qtde').AsFloat *
      dataSet.FieldByName('vl_unit').AsCurrency, -2);
    inc(nItem);
    dataSet.Next;
  end;
end;

function TPedVendaProdTerc.cancel: boolean;
var
  vRecNoItem: Integer;
  vTemp: string;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    dataSet.Cancel;
    Result := true;
  end
  else if dataSet.State = dsBrowse then
  begin
    if dataSet.IsEmpty then
    begin
      Result := false;
      exit;
    end;
    vTemp := 'Deseja apagar o produto de terceiro?';
    if FOwner.CancelarVariosItens then
    	vTemp := 'Deseja apagar os produtos de terceiro selecionados?';
    if Application.MessageBox(pchar(vTemp), 'Confirmação',
      MB_ICONQUESTION + MB_YESNO) = IDYES then
    begin
      try
         if FOwner.CancelarVariosItens then
         begin
           dataSet.Filtered := false;
           dataSet.Filter := ' SEL =''S'' ';
           dataSet.Filtered := true;

           if dataSet.IsEmpty then
           begin
              Application.MessageBox(pchar('Nenhum item selecionado, favor selecionar'), 'Atenção', MB_ICONINFORMATION + MB_OK);
              Exit;
           end;
           dataSet.First;
         end;

         if not FOwner.CancelarVariosItens then
         begin
         	 atualizarDtSetTemp('EXCLUIR');
	       	 delete;
         end
         else
         begin
           while not dataSet.Eof do
           begin
             atualizarDtSetTemp('EXCLUIR');
             delete;
           end;
         end;
      finally
         if FOwner.CancelarVariosItens then
         begin
           dataSet.Filtered := false;
           dataSet.Filter := '';
//            dataSet.IndexFieldNames := 'NITEM';
         end;
      end;
      Result := true;

      if (Result)
      	and (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
        and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
        and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
      begin
        vRecNoItem := dataSet.RecNo;
        Result := Apply;
        if Result then
          if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
            abreProdTerceiro(FOwner.dataSet.FieldByName('nped').AsInteger);
//        if not FOwner.CancelarVariosItens then
          if not dataSet.IsEmpty then
            dataSet.RecNo := vRecNoItem;
      end;
    end;
  end;
end;

function TPedVendaProdTerc.checaValoresItens: boolean;
begin
  try
    Result := false;
    if dataSet.FieldByName('qtde').AsFloat <= 0 then
    begin
      dataSet.FieldByName('vl_total').AsFloat := 0;
      dataSet.FieldByName('vlcusto_tot').AsFloat := 0;
      raiseExceptioncreate('Quantidade de preenchimento obrigatório', 'DBEdit68');
    end;
    if dataSet.FieldByName('vl_unit').AsFloat <= 0 then
    begin
      dataSet.FieldByName('vl_total').AsFloat := 0;
      raiseExceptioncreate('Valor unitário de preenchimento obrigatório', 'DBEdit71');
    end;
    dataSet.FieldByName('vl_total').AsCurrency :=
      dataSet.FieldByName('qtde').AsFloat *
      dataSet.FieldByName('vl_unit').AsCurrency;
    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

constructor TPedVendaProdTerc.create(AOwner: TPedVenda; pDtm: TDtmPedVenda);
begin
	FOwner := AOwner;

  DataSet := TClientDataSet(pDtm.cdsProdTerceiro);
  transacao := TIBTransaction(pDtm.IBTransPedVenda);
  Buscas := TIBQuery(pDtm.qrBuscas);
  dataSet.BeforePost := pedVendaProdTercBeforePost;
  TFloatField(dataSet.FieldByName('QTDE')).currency := false;
  TFloatField(dataSet.FieldByName('VL_UNIT')).currency := false;
  TFloatField(dataSet.FieldByName('VL_TOTAL')).Currency := false;

  dtSet.Free;
  dtSet := nil;
  dtSet := TClientDataSet(pDtm.cdsItemProdTercTemp);
  if dtSet.active then
    dtSet.close;
  DtSet.CreateDataSet;

  try
    fTempDespesas := TClientDataSet.Create(nil);
    fTempDespesas.Close;
    fTempDespesas.FieldDefs.Clear;
    fTempDespesas.FieldDefs.Add('COD_FORNECEDOR', ftInteger, 0, false);
    fTempDespesas.FieldDefs.Add('NOME_FORNECEDOR', ftString, 35, false);
    fTempDespesas.FieldDefs.Add('VLCUSTO_TOT', ftFloat, 0, false);
  except
  end;

  if fTempDespesas.Tag = 0 then
  try
    fTempDespesas.CreateDataSet;
    fTempDespesas.Tag := 22;
  except
  end;
end;

function TPedVendaProdTerc.defineCamposDtSetTemp: boolean;
var
  i: integer;
begin
  if dtSetTemp = nil then
  begin
    dtSetTemp := TClientDataSet.Create(nil);
//    dtSetTemp.Close;
    dtSetTemp.FieldDefs.Clear;
    for I := 0 to dataSet.FieldDefs.Count - 1 do
      dtSetTemp.FieldDefs.Add(
        dataSet.FieldDefs[i].Name,
        dataSet.FieldDefs[i].DataType,
        dataSet.FieldDefs[i].Size,
        false);
//    dtSetTemp.close;
    dtSetTemp.CreateDataSet;
    dtSetTemp.Open;
  end;
end;

procedure TPedVendaProdTerc.defineDisplay;
begin
	TFloatField(dtSetIt.FieldByName('QTDAMESCLAR')).DisplayFormat:= '#,##0.0000';
  TFloatField(dtSetIt.FieldByName('QTDE')).DisplayFormat       := '#,##0.0000';
  TFloatField(dtSetIt.FieldByName('VL_UNIT')).DisplayFormat    := '#,##0.' +
  	vDadosIni.StrZero(0, StrToInt(vSing.vCasasDecimais));
  TFloatField(dtSetIt.FieldByName('VL_TOTAL')).DisplayFormat   := '#,##0.00';
  TFloatField(dtSetIt.FieldByName('VLCUSTO')).DisplayFormat    := '#,##0.' +
  	vDadosIni.StrZero(0, StrToInt(vSing.vCasasDecimais));
  TFloatField(dtSetIt.FieldByName('VLCUSTO_TOT')).DisplayFormat:= '#,##0.00';
end;

destructor TPedVendaProdTerc.destroy;
begin
	dtSet.Close;
  dtSet := nil;
  fTempDespesas.Free;
  fTempDespesas := nil;
  inherited;
end;

procedure TPedVendaProdTerc.dtsetItProdTercTemBeforePost(DataSet: TDataSet);
begin
	if vDadosIni.StrToFloatFormat(dtSetIt.FieldByName('QTDAMESCLAR').AsFloat, 4) > vDadosIni.StrToFloatFormat(dataSet.FieldByName('QTDE').AsFloat, 4) then
  begin
    Application.MessageBox('Quantidade à mesclar não pode ultrapassar a quantidade do item.', 'Informação', MB_OK + MB_ICONINFORMATION);
    abort;
  end
  else if dtSetIt.FieldByName('QTDAMESCLAR').AsFloat = 0 then
    dtSetIt.FieldByName('SELEC').AsVariant := null;
end;

function TPedVendaProdTerc.edit: boolean;
begin
  Result := false;

  if dataSet.IsEmpty then
    Exit;

	if inherited edit then
  begin
    Result := True;
    if dataSet.FieldByName('SEQID').AsInteger <= 0 then
    begin
      vSeqId := vSeqId + 1;
      descricaoTemp := dataSet.FieldByName('DESCRICAO').AsString;
      dataSet.FieldByName('SEQID').AsInteger := vSeqId;
      atualizarDtSetTemp('EDITAR', true);
    end;
    descricaoTemp := dataSet.FieldByName('DESCRICAO').AsString;
  end;
end;

function TPedVendaProdTerc.getValorItens: Currency;
begin
  CalculaValorTotalItens;
  Result := vTotalItens;
end;

function TPedVendaProdTerc.insert: boolean;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    if not post then
      exit;
  end;
  FOwner.calculaDescontoAcrescimo;
  if inherited insert then
  begin
    Result := true;
    vSeqId := vSeqId + 1;
    descricaoTemp := '';
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('tipo').AsString := FOwner.dataSet.FieldByName('tipo').AsString;
    dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;
    dataSet.FieldByName('vlcusto').AsFloat := 0;
    dataSet.FieldByName('seqid').AsInteger := vSeqId;
  end;
end;

procedure TPedVendaProdTerc.pedVendaProdTercBeforePost(DataSet: TDataSet);
begin
  dataSet.FieldByName('VL_UNIT').AsString :=
    StringReplace(Trim(format('%14.' + vSing.vCasasDecimais + 'n',
    [dataSet.FieldByName('VL_UNIT').AsFloat])), '.', '', [rfReplaceAll]);
  dataSet.FieldByName('QTDE').AsString :=
    StringReplace(Trim(format('%14.4n',
    [dataSet.FieldByName('QTDE').AsFloat])), '.', '', [rfReplaceAll]);
  dataSet.FieldByName('VL_TOTAL').AsFloat :=
    (dataSet.FieldByName('QTDE').AsFloat *
    dataSet.FieldByName('VL_UNIT').AsFloat);
  dataSet.FieldByName('VL_TOTAL').AsString :=
    StringReplace(trim(Format('%14.2n',
    [dataSet.FieldByName('VL_TOTAL').AsFloat])), '.', '', [rfReplaceAll]);
end;

function TPedVendaProdTerc.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if vSing.vTipoVenda = 'OS' then
    begin
      if not vDadosIni.PesqPros('VND033', 'SALVAR', 'PROD.:' + trim(dataSet.FieldByName('DESCRICAO').AsString), 'PEDVENDA_PROD_TERC', '', buscas, true) then
        Exit;
    end
    else
    begin
      if not vDadosIni.PesqPros('VND037', 'SALVAR', 'PROD.:' + trim(dataSet.FieldByName('DESCRICAO').AsString), 'PEDVENDA_PROD_TERC', '', buscas, true) then
        Exit;
    end;
    if FOwner.vendaFechada then
      Exit;

    if dataSet.FieldByName('vlcusto').AsFloat < 0 then
      dataSet.FieldByName('vlcusto').AsFloat := 0;
    if dataSet.FieldByName('vlcusto_tot').AsFloat < 0 then
      dataSet.FieldByName('vlcusto_tot').AsFloat := 0;
    if dataSet.FieldByName('cod_fornecedor').AsFloat < 0 then
      dataSet.FieldByName('cod_fornecedor').AsFloat := 0;
          
    if trim(dataSet.FieldByName('COD_VENDEDOR').AsString) = '' then
      raiseExceptioncreate('Vendedor não informado', 'DBEdit74');
    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptioncreate('Descrição do produto de preenchimento obrigatório', 'DBEdit69');
    if dataSet.FieldByName('qtde').AsFloat = 0 then
      raiseExceptioncreate('Quantidade de preenchimento obrigatório', 'DBEdit68');
    if dataSet.FieldByName('vl_unit').AsFloat = 0 then
      raiseExceptioncreate('Valor unitário de preenchimento obrigatório', 'DBEdit71');
    if dataSet.FieldByName('vlcusto').AsString = '' then
      raiseExceptioncreate('Custo precisa de preenchimento obrigatório', 'DBEdit140');

    if dataSet.FieldByName('vlcusto').AsFloat > 0 then
      if dataSet.FieldByName('nome_fornecedor').AsString = '' then
        raiseExceptioncreate('Fornecedor precisa ser preenchido', 'DBEdit143');

    if not checaValoresItens then
      exit;

    if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
    	and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
    	and (dataSet.FieldByName('NPED').AsInteger = 0)
      and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
      	dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;

    if Assigned(dtSetTemp) then
    begin
      dtSetTemp.First;
      while not dtSetTemp.Eof do
      begin
        if (dtSetTemp.FieldByName('DESCRICAO').AsString = dataSet.FieldByName('DESCRICAO').AsString)
        	and (dtSetTemp.FieldByName('SEQID').AsInteger <> dataSet.FieldByName('SEQID').AsInteger) then
          raiseExceptioncreate('Já existe um produto de terceiro com esta descrição!', 'DBEdit69');

        dtSetTemp.Next;
      end;
    end;

    Result := inherited post;

    atualizarDtSetTemp(acao);

    if Result then
      if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO') then
        if (FOwner.dataSet.FieldByName('nped').AsInteger = 0) then
          FOwner.verificaSalvamentoAutomatico
        else
        begin
          Result := Apply;
          if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
            abreProdTerceiro(FOwner.dataSet.FieldByName('nped').AsInteger);
        end;

    Inc(nItem);
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

