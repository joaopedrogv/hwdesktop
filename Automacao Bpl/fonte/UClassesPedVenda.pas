function TProdutoPed.getQtdeDisponivelEmEstoque(
  grupo_prod: integer; cod_prod: string): Double;
var
  sql, sqlTemp: string;
  vest, vTemp: Real;
  vAbaterItens: string;
begin
  vTemp := 0;

  sql := 'select sum(itpd.quant_ped_item) as soma1 from pedvenda pd' +
    ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and' +
    ' pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo' +
    ' where pd.ativo = 1 and itpd.grupo_prod = :grupo and itpd.cod_prod = :codigo ' +
    ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and (pd.data_fech is null or pd.data_fech < :data) and (itpd.status<>''CANCELADO'' or itpd.status is null) ';
  sqlTemp := sql;
  buscas.Close;
  if vDadosIni.vEmp.vApresentarEstR = 'S' then
    sql := sql + ' and pd.tipo <> ''ORC'''
  else if vDadosIni.vEmp.vApresentarEstR = 'R' then
    sql := sql + ' and pd.tipo = ''REQ'''
  else if vDadosIni.vEmp.vApresentarEstR = 'O' then
    sql := sql + ' and pd.tipo = ''OS''';
  if (vDadosIni.vEmp.vApresentarEstR = 'R') or
    (vDadosIni.vEmp.vApresentarEstR = 'O') or
    (vDadosIni.vEmp.vApresentarEstR = 'S') then
  begin
    buscas.SQL.Text := sql;
    buscas.Params[0].AsInteger := grupo_prod;
    buscas.Params[1].AsString := trim(cod_prod);
    buscas.Params[2].AsDate := 0;
    buscas.Open;
    vTemp := buscas.FieldByName('soma1').AsFloat;
    buscas.Close;
    buscas.sql.Text := sqlTemp + ' and pd.NPED=' + inttostr(FOwner.dataSet.FieldByName('NPED').asinteger) +
      ' and pd.tipo=' + quotedstr(trim(FOwner.dataSet.FieldByName('TIPO').AsString));
    buscas.Params[0].AsInteger := grupo_prod;
    buscas.Params[1].AsString := trim(cod_prod);
    buscas.Params[2].AsDate := 0;
    buscas.Open;
    vTemp := vTemp - buscas.FieldByName('soma1').AsFloat;
  end;
  if (vDadosIni.vEmp.vApresentarEstR = 'P') or (vDadosIni.vEmp.vApresentarEstR = 'S') then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select sum(coalesce(pi.quantidade_utilizada,0) + coalesce(pi.quantidade_perda,0)) as soma from producao pd, producao_item_indice pi' +
      ' where pi.grupo_prod = ' + IntToStr(grupo_prod) +
      ' and pi.cod_prod = ' + QuotedStr(cod_prod) +
      ' and pd.cod_producao = pi.cod_producao and pd.cod_empresa = pi.cod_empresa' +
      ' and (pd.data_fechamento is null) and pd.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vTemp := vTemp + buscas.FieldByName('soma').AsFloat;
  end;
  FOwner.vItProd.dtSet.First;
  while not FOwner.vItProd.dtSet.eof do
  begin
    if (FOwner.vItProd.dtSet.FieldByName('NITEM').asinteger <> FOwner.vItProd.dataSet.FieldByName('NITEM').asinteger) and
      (grupo_prod = FOwner.vItProd.dtSet.FieldByName('grupo_prod').asinteger) and
      (cod_prod = trim(FOwner.vItProd.dtSet.FieldByName('cod_prod').AsString)) and
      (UpperCase(FOwner.vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
      vTemp := vTemp + FOwner.vItProd.dtSet.FieldByName('quant_ped_item').AsFloat;
    FOwner.vItProd.dtSet.next;
  end;
  if (vDadosIni.vEmp.vApresentarEstR = 'S') or (vDadosIni.vEmp.vApresentarEstR = 'R') or (vDadosIni.vEmp.vApresentarEstR = 'O') then
    if vDadosIni.vEmp.vAlmox = 'S2' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select sum(coalesce(c.quant,0)) as soma from controle_almoxarifado c' +
      ' where not(c.cod_pedido = ' + IntToStr(FOwner.vItProd.dataSet.FieldByName('COD_PEDIDO').AsInteger) +
      ' and c.nitem = ' + IntToStr(FOwner.vItProd.dataSet.FieldByName('NITEM_PEDIDO').AsInteger) +
      ') and c.grupo_prod = ' + IntToStr(grupo_prod) +' and c.cod_prod = ' + QuotedStr(cod_prod) +
      ' and c.cod_empresa ='+ vDadosIni.codEmpresa;
      buscas.Open;
      vTemp := vTemp + buscas.FieldByName('soma').AsFloat;
    end;

  if vDadosIni.vEmp.vAbaterItens = 'S' then
  begin
     vAbaterItens := retornaValor('select first 1 coalesce(usar_conferencia_produto, '''') as valor from tipo_vendas ' +
      '  where tipo = ' + QuotedStr(FOwner.dataSet.FieldByName('TIPO').AsString) +
      ' and sigla = ''' + FOwner.dataset.FieldByName('TIPV').AsString + ''' order by cod_tipo');

    if trim(vAbaterItens) <> 'S' then
    begin
      sql := 'select sum(itpd.quant_ped_item) as soma1 from pedvenda pd' +
       ' inner join pedvenda_prod itpd on pd.nped = itpd.nped and pd.cod_empresa = itpd.cod_empresa and pd.tipo = itpd.tipo' +
       ' inner join tipo_vendas tv on tv.sigla = pd.tipv and tv.tipo = pd.tipo' +
       ' where pd.ativo = 1 and itpd.grupo_prod = :grupo and itpd.cod_prod = :codigo ' +
       ' and pd.cod_empresa = ' + vDadosIni.codEmpresa + ' and (coalesce(tv.usar_conferencia_produto, '''') = ''S'') ' +
       ' and (pd.data_fech is null or pd.data_fech < :data) and (itpd.status<>''CANCELADO'' or itpd.status is null) ' +
       ' and pd.cod_vendedor = :cod_vendedor ';

      sqlTemp := sql;
      buscas.Close;
      if vDadosIni.vEmp.vApresentarEstR = 'S' then
        sql := sql + ' and pd.tipo <> ''ORC'''
      else if vDadosIni.vEmp.vApresentarEstR = 'R' then
        sql := sql + ' and pd.tipo = ''REQ'''
      else if vDadosIni.vEmp.vApresentarEstR = 'O' then
        sql := sql + ' and pd.tipo = ''OS''';
      if (vDadosIni.vEmp.vApresentarEstR = 'R') or
        (vDadosIni.vEmp.vApresentarEstR = 'O') or
        (vDadosIni.vEmp.vApresentarEstR = 'S') then
      begin
        buscas.SQL.Text := sql;
        buscas.Params[0].AsInteger := grupo_prod;
        buscas.Params[1].AsString := trim(cod_prod);
        buscas.Params[2].AsDate := 0;
        buscas.Params[3].AsInteger := FOwner.dataSet.FieldByName('COD_VENDEDOR').AsInteger;
        buscas.Open;
        vTemp := vTemp - buscas.FieldByName('soma1').AsFloat;
//        buscas.Close;
//        buscas.sql.Text := sqlTemp + ' and pd.NPED=' + inttostr(FOwner.dataSet.FieldByName('NPED').asinteger) +
//          ' and pd.tipo=' + quotedstr(trim(FOwner.dataSet.FieldByName('TIPO').AsString));
//        buscas.Params[0].AsInteger := grupo_prod;
//        buscas.Params[1].AsString := trim(cod_prod);
//        buscas.Params[2].AsDate := 0;
//        buscas.Open;
//        vTemp := vTemp - buscas.FieldByName('soma1').AsFloat;
      end;
    end;
  end;

  if (vDadosIni.vEmp.vApresentarEstR = 'S') or (vDadosIni.vEmp.vApresentarEstR = 'R') or (vDadosIni.vEmp.vApresentarEstR = 'O') then
  begin
    buscas.Close;
    buscas.SQL.Text := ' select coalesce(estoque, 0) as somaEstoque from getestoque_recursivo ( ' +
      ':grupo_prod, ' +
      ':cod_prod, ' +
      ':cod_empresa, ' +
      ':cod_grade);';
    buscas.ParamByName('grupo_prod').AsInteger := grupo_prod;
    buscas.ParamByName('cod_prod').AsString := trim(cod_prod);
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('cod_grade').AsInteger := 0;
    buscas.Open;

    vTemp := vTemp - buscas.FieldByName('somaEstoque').AsFloat;
  end;

  buscaProduto(grupo_prod, trim(cod_prod));
  Result := dataSet.FieldByName('est_f').AsFloat - vTemp;
//  Result := dataSet.FieldByName('est_f').AsFloat + dataSet.FieldByName('est_r').AsFloat - vTemp;
end;

