function TComissaoPorVendaCons.atribuirComissaoPorVenda(pPercVend, pVlVend, pPercPart, pVlPart: Double; pCodVend, pCodPart: Integer): boolean;
begin
  Result := true;
  try
    if trim(dataSet.FieldByName('TIPO').AsString) <> 'REQ' then
      exit;

    try
      vComissaoPorVenda.vItensComissaoPorVenda.abreItensComissaoPorVenda(dataSet.FieldByName('nped').AsInteger,
        dataSet.FieldByName('tipo').AsString);
      if (pCodVend > 0) or (pCodPart > 0) then
      begin
        vComissaoPorVenda.vItensComissaoPorVenda.dataSet.Filtered := false;
        if (pCodVend > 0) then
          vComissaoPorVenda.vItensComissaoPorVenda.dataSet.Filter := 'cod_vendedor = ' + IntToStr(pCodVend)
        else if (pCodPart > 0) then
          vComissaoPorVenda.vItensComissaoPorVenda.dataSet.Filter := 'cod_vendedor1 = ' + IntToStr(pCodPart);
        vComissaoPorVenda.vItensComissaoPorVenda.dataSet.Filtered := true;
        vComissaoPorVenda.vItensComissaoPorVenda.dataSet.IndexFieldNames := 'cod_vendedor';
        vComissaoPorVenda.vItensComissaoPorVenda.dataSet.First;
      end;

      vPedvendaItProd_comiss_class := TPedvendaItProd_comiss_classList.Create;
      vPedvendaItProd_comiss_class.SetValuesFrom(vComissaoPorVenda.vItensComissaoPorVenda.dataSet, pPercVend, pPercPart, pCodVend, pCodPart, true);
      vPedvendaItProd_comiss_class.CalcularComissItProd(pVlVend, pVlPart, true);
      vPedvendaItProd_comiss_class.SetValuesFromIn(vComissaoPorVenda.vItensComissaoPorVenda.dataSet, true, false, false, true);
      vComissaoPorVenda.vItensComissaoPorVenda.Apply;
    finally
      if (pCodVend > 0) or (pCodPart > 0) then
      begin
        vComissaoPorVenda.dataSet.Filtered := false;
        vComissaoPorVenda.vItensComissaoPorVenda.dataSet.Filter := '';
      end;
    end;

    vComissaoPorVenda.abreVenda(dataSet.FieldByName('nped').AsInteger, dataSet.FieldByName('tipo').AsString);
    vPedvenda_comiss_class := TPedvenda_comiss_class.Create;
    vPedvenda_comiss_class.SetValuesFromItens(vComissaoPorVenda.vItensComissaoPorVenda.dataSet);
//    vPedvenda_comiss_class.CalcularComiss(false);
    vPedvenda_comiss_class.SetValuesFromIn(vComissaoPorVenda.dataSet, true, false, false, true);
    vComissaoPorVenda.Apply;

    vComissaoPorVenda.CommitaTransacao;
  finally
     if Assigned(vPedvenda_comiss_class) then
       FreeAndNil(vPedvenda_comiss_class);
     if Assigned(vPedvendaItProd_comiss_class) then
       FreeAndNil(vPedvendaItProd_comiss_class);
  end;


   vPedvendaItProd_comiss_class := TPedvendaItProd_comiss_classList.Create;
//
//      vPedvendaItProd_comiss_class.SetValuesFrom(vComissaoPorVenda.vItensComissaoPorVenda.dataSet,
//        dataSet.FieldByName('PERC_COMISSAO_VEND').AsFloat, dataSet.FieldByName('PERC_COMISSAO_VEND1').AsFloat);
//      vPedvendaItProd_comiss_class.CalcularComissItProd(vComissaoPorVenda.dataSet.FieldByName('VL_COMISSAO_VEND').AsFloat,
//      	vComissaoPorVenda.dataSet.FieldByName('VL_COMISSAO_VEND1').AsFloat);
//      vPedvendaItProd_comiss_class.SetValuesFromIn(vComissaoPorVenda.vItensComissaoPorVenda.dataSet, true, false, false, true);
//      vComissaoPorVenda.vItensComissaoPorVenda.Apply;
//      vComissaoPorVenda.CommitaTransacao;
end;

