function TPedVenda.gerarContas(pProdServ: string; var pContas: RContas; pAlter: boolean): boolean;
 var
  I, K: Integer;
  dias: array of integer;
  vCond: string;
begin
 Result := False;
 K:=0;
 I := 0;
 SetLength(dias, 100);
 SetLength(pContas.vencimentoDocumento, 100);
 SetLength(pContas.CodCred, 100);
 SetLength(pContas.dataReferencia, 100);
 SetLength(pContas.numeroDocumento, 100);
 SetLength(pContas.CodFornecedor, 100);
 SetLength(pContas.CodTpDespesa, 100);
 SetLength(pContas.Controle, 100);
 SetLength(pContas.NumConta, 100);
 SetLength(pContas.NCHQ, 100);
 SetLength(pContas.NCHQNominal, 100);
 SetLength(pContas.valorDocumento, 100);
 SetLength(pContas.numVenda, 100);
 SetLength(pContas.tipoVenda, 100);
 SetLength(pContas.historico, 100);

 pContas.parcelas := 0;
 try
   TFrmCadPedVenda(FrmCadPed).ListBox3.Clear;

   if TFrmCadPedVenda(FrmCadPed).cdsDesp.IsEmpty then
   begin
      vCond := IntToStr(TFrmCadPedVenda(FrmCadPed).edcreditoQtdeParcelas.Value) + 'X';

     if not vDadosIni.montarParcelamento(buscas, pContas.numeroDocumento, pContas.vencimentoDocumento, pContas.valorDocumento,
      trim(TFrmCadPedVenda(FrmCadPed).Edit14.Text), vDadosIni.StrToFloatFormat(TFrmCadPedVenda(FrmCadPed).EditHw3.AsValue, 2),
     dataSet.FieldByName('COD_CLIENTE').AsInteger, vCond,
     vDadosIni.IfThen(TFrmCadPedVenda(FrmCadPed).edcreditoQtdeParcelas.Value > 0,	TFrmCadPedVenda(FrmCadPed).edcreditoQtdeParcelas.Value, 1),
     'N', DateToStr(vDadosIni.getDataBanco(buscas))) then
     begin
      SetLength(pContas.vencimentoDocumento, 100);
      SetLength(pContas.numeroDocumento, 100);
      SetLength(pContas.valorDocumento, 100);
      pContas.NumConta[I] := 0;// dataSet.FieldByName('N_CONTA_PLC').AsFloat;
      pContas.numeroDocumento[I] := vDadosIni.StrZero(TFrmCadPedVenda(FrmCadPed).Edit14.Text, 6) + '-1';
      pContas.CodFornecedor[I] := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      pContas.Controle[I] := dataSet.FieldByName('CODIGO_CTRL').AsInteger;
      pContas.vencimentoDocumento[I] := DateToStr(vDadosIni.getDataBanco(buscas));
      pContas.dataReferencia[I] := DateToStr(vDadosIni.getDataBanco(buscas));
      pContas.valorDocumento[I] := TFrmCadPedVenda(FrmCadPed).EditHw3.AsValue;
      pContas.parcelas := pContas.parcelas + 1;
      TFrmCadPedVenda(FrmCadPed).ListBox3.Items.Add(pContas.numeroDocumento[I] + '   ' + pContas.vencimentoDocumento[I] + '    ' + Format('%m', [pContas.valorDocumento[I]]));
     end
     else
     begin
       for I := 0 to Length(pContas.numeroDocumento) - 1 do
       begin
        TFrmCadPedVenda(FrmCadPed).ListBox3.Items.Add(pContas.numeroDocumento[I] + '   ' + pContas.vencimentoDocumento[I] + '    ' + Format('%m', [pContas.valorDocumento[I]]));
        pContas.NumConta[I] := 0;// dataSet.FieldByName('N_CONTA_PLC').AsFloat;
        pContas.CodFornecedor[I] := dataSet.FieldByName('COD_CLIENTE').AsInteger;
        if vDadosIni.vPedVnd.gerarContasApagarTotServ then
          pContas.historico[I] := 'DESP OS ' + dataSet.FieldByName('NPED').AsString + ' - ' +
           vDadosIni.IfThen(pProdServ = 'P', 'PRODUTOS', 'SERVICOS') + ' DE TERCEIRO'
        else
          pContas.historico[I] := 'DESP OS ' + dataSet.FieldByName('NPED').AsString + ' - ' +
          vDadosIni.IfThen(pProdServ = 'P',
            vItProdTerc.dataSet.FieldByName('DESCRICAO').AsString,
          	vItServTerc.dataSet.FieldByName('DESCR_SERVT').AsString);
        pContas.Controle[I] := vDadosIni.IfThen(dataSet.FieldByName('CODIGO_CTRL').AsInteger > 0,
        dataSet.FieldByName('CODIGO_CTRL').AsInteger, vCtrl.dataSet.FieldByName('CODIGO_CTRL').AsInteger);
        pContas.dataReferencia[I] := pContas.vencimentoDocumento[I];//DateToStr(vDadosIni.getDataBanco(buscas));
        pContas.parcelas := pContas.parcelas + 1;
       end;
     end;
   end
   else
   begin
      TFrmCadPedVenda(FrmCadPed).cdsDesp.IndexFieldNames := 'NumConta;NumDoc';
      TFrmCadPedVenda(FrmCadPed).cdsDesp.First;
      if not TFrmCadPedVenda(FrmCadPed).cdsDesp.IsEmpty then
      begin
        while not TFrmCadPedVenda(FrmCadPed).cdsDesp.Eof do
        begin
           pContas.NumConta[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('NumConta').AsFloat;
           pContas.historico[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('Historico').AsString;
           pContas.numeroDocumento[I] :=  TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('NumDoc').AsString;
           pContas.CodFornecedor[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('CodFornecedor').AsInteger;
           pContas.Controle[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('Controles').AsInteger;
           pContas.vencimentoDocumento[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('DataVenc').AsString;
           pContas.dataReferencia[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('DataReferencia').AsString;
           pContas.valorDocumento[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('Valor').AsFloat;
           pContas.NCHQ[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('NChq').AsString;
           pContas.NCHQNominal[I] := TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('NominalChq').AsString;
           TFrmCadPedVenda(FrmCadPed).ListBox3.Items.Add(trim(TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('NumDoc').AsString) + '   '
            + trim(TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('DataVenc').AsString) + '    ' + Format('%m', [TFrmCadPedVenda(FrmCadPed).cdsDesp.FieldByName('Valor').AsFloat]));
           pContas.parcelas := pContas.parcelas + 1;
           Inc(I);

           TFrmCadPedVenda(FrmCadPed).cdsDesp.Next;
        end;
      end;
      TFrmCadPedVenda(FrmCadPed).cdsDesp.First;
   end;
   Result := True;
 except
   on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
 end;
end;

function TPedVenda.gerenteAutorizou(pNPed: Integer): Boolean;
begin
  Result := True;

  if Trim(vSing.vTipoVenda) <> 'REQ' then
    Exit;

  if vDadosIni.vEmp.vVnd_AprovacaoGerente = 'S' then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select t.usar_liberacao_gerente, p.aprovada_gerente from pedvenda p' +
      ' left join tipo_vendas t on t.tipo = p.tipo and t.sigla = p.tipv' +
      ' where p.nped = ' + IntToStr(pNPed) +
      ' and p.tipo = ''REQ'' and p.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if Trim(buscas.FieldByName('USAR_LIBERACAO_GERENTE').AsString) <> 'S' then
      Exit;

    if Trim(buscas.FieldByName('aprovada_gerente').AsString) <> 'S' then
      Result := False;
  end;
end;

function TPedVenda.GetClienteFaturamento(iCodCliente: Integer): string;
var
  iCodCliFat: Integer;
begin
  Result := '';
  if iCodCliente <= 0 then
    Exit;

  iCodCliFat := queryCons.Table('clientes', 'cod_cli_fat')
    .Equals('cod_cliente', iCodCliente)
    .Equals('cod_empresa', vDadosIni.cod_empresa)
    .Scalar().AsInteger;

  queryCons.Table('clientes', 'cpfcgc, cod_cliente, nome_cliente, razao')
    .Equals('cod_cliente', iCodCliFat)
    .Equals('cod_empresa', vDadosIni.cod_empresa)
    .Open;

  if dataSet.State in [dsEdit, dsInsert] then
    if queryCons.fint('cod_cliente') > 0 then
      dataSet.FieldByName('cod_cli_fat').AsInteger := queryCons.fint('cod_cliente')
    else
      dataSet.FieldByName('cod_cli_fat').AsVariant := Null;

  Result := queryCons.fstr('cpfcgc') + ' - ' + queryCons.fstr('nome_cliente');
  if queryCons.fstr('nome_cliente') <> queryCons.fstr('razao') then
    Result := Result + '/' + queryCons.fstr('razao');
end;

function TPedVenda.getCodigoServicoSegmento: integer;
var
  vsqlAdicional: string;
  codSegmento: string;
  codServico: string;
begin
  try
    vsqlAdicional := ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa + ' AND STIPO = ''S''';
    if (getTipoVenda <> 'REQ') and (vDadosIni.vEmp.vUsarAparelho <> 'S') then
    begin
      codSegmento := vDadosIni.pesquisaRapida('ESPECIE_VEICULO');
      try
        StrToInt(codSegmento);
      except
        raise exception.create('Espécie não informada');
      end;
      if not existeSegmento(StrToInt(codSegmento)) then
        raise exception.create('Espécie não encontrada');
      vsqlAdicional := vsqlAdicional + ' and COD_ESPE_SEG = ' + codSegmento;
    end;
    codServico := vDadosIni.pesquisaRapida('SERVICOS_EMP', vsqlAdicional, 'Localizar Serviços');
    try
      StrToInt(codServico);
    except
      raise exception.create('Serviço não informado');
    end;
    if not existeTipoServico(StrToInt(codServico)) then
      raise exception.create('Serviço não encontrado');
    result := StrToInt(codServico);
  except
    on e: exception do
    begin
      Result := -1;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

