function TConf_PedVenda.ExecutarLeitura: TConf_PedVenda;
var
  Alist: TConfig_sistema_classList;
begin
  Alist := TConfig_sistema_classList.Create;
  try
  if Assigned(Fvalores_nf) then
  	FreeAndNil(Fvalores_nf);

    Alist.AddKey('ped_vnd_valores_nf').
          AddKey('ped_vnd_req_imprimir_abertas').
          AddKey('ped_vnd_est_min_notificar').
          AddKey('ped_vnd_req_obs_semlimite').
          MakeAll(TPedVenda(FOwner).buscas, StrToInt(vDadosIni.codEmpresa));

    Fvalores_nf          := Alist.GetConf('ped_vnd_valores_nf').Clone;
    Fimprimir_abertas    := Alist.GetConf('ped_vnd_req_imprimir_abertas').value1_f = 1;
    Fest_min_notificar   := Alist.GetConf('ped_vnd_est_min_notificar').Clone;
    Fped_vnd_req_obs_semlimite := Alist.GetConf('ped_vnd_req_obs_semlimite').value1_f = 1;

    if vDadosIni.vImpDavReduzidoDetalhado.vExibirDescAcresItem in [0,1,2] then
      Fimprimir_descacr_it := TipoImpDescAcresItem(vDadosIni.vImpDavReduzidoDetalhado.vExibirDescAcresItem)
    else
    	Fimprimir_descacr_it := tidaNenhum;

    FPercentualAcDescTotais := vDadosIni.vImpDavReduzidoDetalhado.vPercentualAcrescimoDescontoEmTotais = 'S';

    Finicializado := True;

  finally
  	if Assigned(Alist) then
    	FreeAndNil(Alist);
  end;
end;

function TConf_PedVenda.Getvalores_nf: TConfig_sistema_class;
begin
  if not Finicializado then
    ExecutarLeitura;

  Result := Fvalores_nf;
end;

procedure TConf_PedVenda.ped_vnd_valores_nf_check;
var
  I: Integer;
  Achanges: Boolean;
  Atipos: TStrings;
  Aconf: TConfig_sistema_class;
begin
  ExecutarLeitura;

  Atipos := vDadosIni.NewStringList(False, 'REQ,ORC,OS', ',');

  try
    Achanges := False;
    for I := 0 to Atipos.Count - 1 do
    begin
      if not Fvalores_nf.GetIniFile.ValueExists(Format('Conf_%s', [Atipos[I]]), 'ICMSDesoneradoEmbutido') then
        if Fvalores_nf.InsertLineConf(Format('Conf_%s', [Atipos[I]]), 'ICMSDesoneradoEmbutido', 'N') then
          Achanges := True;
    end;
  finally
  	if Assigned(Atipos) then
    	FreeAndNil(Atipos);
  end;

  if Achanges then
  begin
    Fvalores_nf.SaveConfDB(Fquery);
    if Fquery.Transaction.InTransaction then
      Fquery.Transaction.Commit;
  end;
end;

{ TFaturamento_Group }

procedure TFaturamento_Group.calcular_valores_nf;
var
  I: Integer;
  Alog: THw_faturamento;
begin
  if (FOwner.vItProd.dataSet.IsEmpty) then
    Exit;

  if FOwner.f_str('nf_ac_calctrib') <> 'S' then
  begin
    zerar_valores_nf;
    Exit;
  end;

  Alog := THw_faturamento.Create;
  Alog.logs_sl('-- calcular_valores_nf start', 'calcnf');

  vDadosIni.abreStatusProcessamento('Calculando valores da NF', 'Aguarde enquanto o sistema está processando');
  try
    FOwner.vItProd.prepare_loop('status <> ''CANCELADO'' or status is null or status = ''''');

    if (not Assigned(Fped)) or (not Assigned(Fnf)) then
    begin
      Fped := THw_faturamento(Ffat).pedidos.New;
      Fnf  := THw_faturamento(Ffat).notas.New;
    end
    else
      THw_pedvenda_class(Fped).erros.Clear;

    THw_faturamento(Ffat).erros.Clear;

    Alog.logs_elapsed_time('preparaitens');

    THw_pedvenda_class(Fped).pedvenda_dados_obter(FOwner.dataSet, FOwner.vItProd.dataSet).validacao_atualizar_totais_itens(False).emMemoria := True;
    if THw_faturamento(Ffat).erros.Count > 0 then
    begin
      FOwner.dataSet.FieldByName('nf_ac_calctrib').AsString := 'N';
      vDadosIni.ShowErro('Pelos erros encontrados o cálculo dos tributos foi desativado nesta venda, corrija os erros encontrados para tentar calcular novamente' + sLineBreak + sLineBreak +
                         THw_faturamento(Ffat).erros.formato_string(10));
      if Assigned(FOwner.onCalcValoresNF) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);
      Exit;
    end;

    Alog.logs_elapsed_time('obterdadospedido');

    with THw_notafiscal_class(Fnf) do
    begin
      erros.Clear;
      itens.Clear;
      if Assigned(cad_merc) then cad_merc.Clear;
      if Assigned(cad_cbarra) then cad_cbarra.Clear;
      if Assigned(cad_serv) then cad_serv.Clear;
      if Assigned(cad_redu) then cad_redu.Clear;
      if Assigned(cad_trib) then cad_trib.Clear;
      if Assigned(cad_cfop) then cad_cfop.Clear;
      if Assigned(cad_deson) then cad_deson.Clear;
      if Assigned(cad_ncm_dest) then cad_ncm_dest.Clear;
      if Assigned(cad_mva_aj) then cad_mva_aj.Clear;
      if Assigned(cad_ncm_loc) then cad_ncm_loc.Clear;
      if Assigned(cad_ibpt) then cad_ibpt.Clear;
      if Assigned(cad_opfiscal) then cad_opfiscal.Clear;
      pedvenda_atualizar(THw_pedvenda_class(Fped));
    end;

    Alog.logs_elapsed_time('notafiscalmontar');

    THw_notafiscal_class(Fnf).totais_somar;
    if THw_faturamento(Ffat).erros.Count > 0 then
    begin
      if FOwner.dataSet.State in [dsEdit, dsInsert] then
        FOwner.dataSet.FieldByName('nf_ac_calctrib').AsString := 'N';
      vDadosIni.ShowErro('Pelos erros encontrados o cálculo dos tributos foi desativado nesta venda, corrija os erros encontrados para tentar calcular novamente' + sLineBreak + sLineBreak +
                         THw_faturamento(Ffat).erros.formato_string(10));
      if Assigned(FOwner.onCalcValoresNF) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);
      Exit;
    end;

    Alog.logs_elapsed_time('notafiscalsomar');

    if FOwner.dataSet.State in [dsEdit, dsInsert] then with FOwner.dataSet do
    begin

      FieldByName('NF_AC_IPI').AsFloat        := THw_notafiscal_class(Fnf).valor_ipi;
      FieldByName('NF_AC_ICMSST').AsFloat     := THw_notafiscal_class(Fnf).valor_icmsub;
      FieldByName('NF_AC_FCPST').AsFloat      := THw_notafiscal_class(Fnf).fcp_vfcpst;
      FieldByName('NF_AC_IMPOSTO_II').AsFloat := THw_notafiscal_class(Fnf).valor_ii;
      FieldByName('NF_DC_VICMDESON').AsFloat  := THw_notafiscal_class(Fnf).vicmdeson + THw_notafiscal_class(Fnf).vpisdeson + THw_notafiscal_class(Fnf).vcofinsdeson;
      FieldByName('NF_AC_VICMDESON').AsFloat  := 0;
      for I := 0 to Pred(THw_notafiscal_class(Fnf).itens.Count) do with THw_notafiscal_class(Fnf).itens.Items[I] do
        FieldByName('NF_AC_VICMDESON').AsFloat  := FieldByName('NF_AC_VICMDESON').AsFloat  + dadosDeson.valor_adicional_custeio;

      FieldByName('ACRESCIMO').AsFloat := FOwner.f_float('NF_AC_SEGURO') +
                                          FOwner.f_float('NF_AC_OUTRAS') +
                                          FOwner.f_float('NF_AC_FRETE') +
                                          FOwner.f_float('NF_AC_IPI') +
                                          FOwner.f_float('NF_AC_ICMSST') +
                                          FOwner.f_float('NF_AC_FCPST') +
                                          FOwner.f_float('NF_AC_IMPOSTO_II') +
                                          FOwner.f_float('NF_AC_VICMDESON');
      FieldByName('ACRESC_P_PROD').AsFloat := 0;

      FieldByName('DESCONTO').AsFloat    := FOwner.f_float('NF_DC_DESCONTO') + FOwner.f_float('NF_DC_VICMDESON');

      FOwner.vItProd.First;
      while not FOwner.vItProd.Eof do
      begin
        for I := 0 to Pred(THw_notafiscal_class(Fnf).itens.Count) do with THw_notafiscal_class(Fnf).itens.Items[I] do
          if FOwner.vItProd.dataSet.FieldByName('nitem').AsInteger = nitem_ped then
          begin
            FOwner.vItProd.dataSet.Edit;
            FOwner.vItProd.dataSet.FieldByName('vl_desp_nf').AsFloat := valor_ipi + valor_icmsub + fcp_vfcpst + valor_ii + dadosDeson.valor_adicional_custeio;
            FOwner.vItProd.dataSet.FieldByName('nf_dc_despnf').AsFloat := vicmdeson + vpisdeson + vcofinsdeson;
            FOwner.vItProd.dataSet.FieldByName('nf_ac_des_emb').AsFloat := dadosDeson.valor_adicional_custeio;
            FOwner.vItProd.dataSet.Post;
          end;

        FOwner.vItProd.Next;
      end;

      Alog.logs_elapsed_time('pedvendaacrescimo');

      FOwner.calculaDescontoAcrescimo;
      
      Alog.logs_elapsed_time('pedvendacalculadescac');
    end;

    if Assigned(FOwner.onCalcValoresNF) then
      if Assigned(Fnf) then
        FOwner.onCalcValoresNF(Fnf)
      else if Assigned(THw_faturamento(Ffat).erros) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);

  finally
    FOwner.vItProd.prepare_loop_done;
    if Assigned(Alog) then
    	FreeAndNil(Alog);
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TFaturamento_Group.calcular_valores_nf_atualizar;
var
  I: Integer;
  Alog: THw_faturamento;
begin
  if (FOwner.vItProd.dataSet.IsEmpty) then
    Exit;

  if FOwner.f_str('nf_ac_calctrib') <> 'S' then
    Exit;

  Alog := THw_faturamento.Create;
  Alog.logs_sl('-- calcular_valores_nf_atualizar start', 'calcnf');


  vDadosIni.abreStatusProcessamento('Calculando valores da NF', 'Aguarde enquanto o sistema está processando');
  try
    FOwner.vItProd.prepare_loop('status <> ''CANCELADO'' or status is null or status = ''''');

    if (not Assigned(Fped)) or (not Assigned(Fnf)) then
    begin
      Alog.logs_elapsed_time('abortado');
      calcular_valores_nf;
      exit;
    end;

    THw_pedvenda_class(Fped).erros.Clear;
    THw_faturamento(Ffat).erros.Clear;

    Alog.logs_elapsed_time('preparaitens');

    THw_pedvenda_class(Fped).pedvenda_dados_atualizar(FOwner.dataSet, FOwner.vItProd.dataSet).validacao_atualizar_totais_itens.emMemoria := True;
    if THw_faturamento(Ffat).erros.Count > 0 then
    begin
      FOwner.dataSet.FieldByName('nf_ac_calctrib').AsString := 'N';
      vDadosIni.ShowErro('Pelos erros encontrados o cálculo dos tributos foi desativado nesta venda, corrija os erros encontrados para tentar calcular novamente' + sLineBreak + sLineBreak +
                         THw_faturamento(Ffat).erros.formato_string(10));
      if Assigned(FOwner.onCalcValoresNF) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);
      Exit;
    end;

    Alog.logs_elapsed_time('obterdadospedido');

    with THw_notafiscal_class(Fnf) do
    begin
      itens.Clear;
      pedvenda_atualizar(THw_pedvenda_class(Fped));

      Alog.logs_elapsed_time('notafiscalmontar');

      totais_somar;
    end;


    if THw_faturamento(Ffat).erros.Count > 0 then
    begin
      FOwner.dataSet.FieldByName('nf_ac_calctrib').AsString := 'N';
      vDadosIni.ShowErro('Pelos erros encontrados o cálculo dos tributos foi desativado nesta venda, corrija os erros encontrados para tentar calcular novamente' + sLineBreak + sLineBreak +
                         THw_faturamento(Ffat).erros.formato_string(10));
      if Assigned(FOwner.onCalcValoresNF) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);
      Exit;
    end;

    Alog.logs_elapsed_time('notafiscalsomar');

    if FOwner.dataSet.State in [dsEdit, dsInsert] then with FOwner.dataSet do
    begin

      FieldByName('NF_AC_IPI').AsFloat        := THw_notafiscal_class(Fnf).valor_ipi;
      FieldByName('NF_AC_ICMSST').AsFloat     := THw_notafiscal_class(Fnf).valor_icmsub;
      FieldByName('NF_AC_FCPST').AsFloat      := THw_notafiscal_class(Fnf).fcp_vfcpst;
      FieldByName('NF_AC_IMPOSTO_II').AsFloat := THw_notafiscal_class(Fnf).valor_ii;
      FieldByName('NF_DC_VICMDESON').AsFloat  := THw_notafiscal_class(Fnf).vicmdeson + THw_notafiscal_class(Fnf).vpisdeson + THw_notafiscal_class(Fnf).vcofinsdeson;
      FieldByName('NF_AC_VICMDESON').AsFloat  := 0;
      for I := 0 to Pred(THw_notafiscal_class(Fnf).itens.Count) do with THw_notafiscal_class(Fnf).itens.Items[I] do
        FieldByName('NF_AC_VICMDESON').AsFloat  := FieldByName('NF_AC_VICMDESON').AsFloat  + dadosDeson.valor_adicional_custeio;

      FieldByName('ACRESCIMO').AsFloat := FOwner.f_float('NF_AC_SEGURO') +
                                          FOwner.f_float('NF_AC_OUTRAS') +
                                          FOwner.f_float('NF_AC_FRETE') +
                                          FOwner.f_float('NF_AC_IPI') +
                                          FOwner.f_float('NF_AC_ICMSST') +
                                          FOwner.f_float('NF_AC_FCPST') +
                                          FOwner.f_float('NF_AC_IMPOSTO_II') +
                                          FOwner.f_float('NF_AC_VICMDESON');
      FieldByName('ACRESC_P_PROD').AsFloat := 0;

      FieldByName('DESCONTO').AsFloat    := FOwner.f_float('NF_DC_DESCONTO') + FOwner.f_float('NF_DC_VICMDESON');

      FOwner.vItProd.First;
      while not FOwner.vItProd.Eof do
      begin
        for I := 0 to Pred(THw_notafiscal_class(Fnf).itens.Count) do with THw_notafiscal_class(Fnf).itens.Items[I] do
          if FOwner.vItProd.dataSet.FieldByName('nitem').AsInteger = nitem_ped then
          begin
            FOwner.vItProd.dataSet.Edit;
            FOwner.vItProd.dataSet.FieldByName('vl_desp_nf').AsFloat   := valor_ipi + valor_icmsub + fcp_vfcpst + valor_ii + dadosDeson.valor_adicional_custeio;
            FOwner.vItProd.dataSet.FieldByName('nf_dc_despnf').AsFloat := vicmdeson + vpisdeson + vcofinsdeson;
            FOwner.vItProd.dataSet.FieldByName('nf_ac_des_emb').AsFloat := dadosDeson.valor_adicional_custeio;
            FOwner.vItProd.dataSet.Post;
          end;
//
        FOwner.vItProd.Next;
      end;

      Alog.logs_elapsed_time('pedvendaacrescimo');

      FOwner.calculaDescontoAcrescimo;
      
      Alog.logs_elapsed_time('pedvendacalculadescac');
    end;

    if Assigned(FOwner.onCalcValoresNF) then
      if Assigned(Fnf) then
        FOwner.onCalcValoresNF(Fnf)
      else if Assigned(THw_faturamento(Ffat).erros) then
        FOwner.onCalcValoresNF(THw_faturamento(Ffat).erros);

  finally
    FOwner.vItProd.prepare_loop_done;
    if Assigned(Alog) then
    	FreeAndNil(Alog);    
    vDadosIni.fechaStatusProcessamento;
  end;
end;

constructor TFaturamento_Group.create(AOwner: TPedVenda);
begin
  FOwner := AOwner;
  Ffat   := THw_faturamento.Create;
end;

destructor TFaturamento_Group.Destroy;
begin
  if Assigned(Ffat) then
  	FreeAndNil(Ffat);
  inherited;
end;

procedure TFaturamento_Group.zerar_valores_nf;
var
  Aerros: THw_erro_classList;
begin
  if not (FOwner.dataSet.State in [dsEdit, dsInsert]) then
    Exit;

  vDadosIni.abreStatusProcessamento('Calculando valores da NF', 'Aguarde enquanto o sistema está processando');
  try
    with FOwner.dataSet do
    begin
      FieldByName('NF_AC_IPI').AsFloat        := 0;
      FieldByName('NF_AC_ICMSST').AsFloat     := 0;
      FieldByName('NF_AC_FCPST').AsFloat      := 0;
      FieldByName('NF_AC_IMPOSTO_II').AsFloat := 0;
      FieldByName('NF_AC_VICMDESON').AsFloat  := 0;
      FieldByName('ACRESCIMO').AsFloat        := FOwner.f_float('NF_AC_SEGURO') +
                                                 FOwner.f_float('NF_AC_OUTRAS') +
                                                 FOwner.f_float('NF_AC_FRETE');
      FieldByName('ACRESC_P_PROD').AsFloat    := 0;
      FieldByName('NF_DC_VICMDESON').AsFloat  := 0;
      FieldByName('DESCONTO').AsFloat         := FOwner.f_float('NF_DC_DESCONTO');
      if FOwner.str_empty('nf_ac_calctrib') then
      begin
        FieldByName('NF_AC_SEGURO').AsFloat   := 0;
        FieldByName('NF_AC_OUTRAS').AsFloat   := 0;
        FieldByName('NF_AC_FRETE').AsFloat    := 0;
        FieldByName('NF_DC_DESCONTO').AsFloat := 0;
      end;
      FOwner.vItProd.prepare_loop;
      while not FOwner.vItProd.Eof do
      begin
        if FOwner.vItProd.f_str('status') <> 'CANCELADO' then
        begin
          FOwner.vItProd.dataSet.Edit;
          FOwner.vItProd.dataSet.FieldByName('vl_desp_nf').AsFloat := 0;
          FOwner.vItProd.dataSet.FieldByName('nf_dc_despnf').AsFloat := 0;
          FOwner.vItProd.dataSet.FieldByName('nf_ac_des_emb').AsFloat := 0;
          FOwner.vItProd.dataSet.Post;
        end;
        FOwner.vItProd.Next;
      end;

      FOwner.calculaDescontoAcrescimo;
    end;
    Aerros := THw_erro_classList.Create;
    Aerros.New('Pedido configurado para não adicionar acréscimos de tributos da NF').
      detalhe := 'Importante: Mesmo assim se uma nota for emitida o cálculo dos tributos será feito pela mesma';

    if Assigned(FOwner.onCalcValoresNF) then
      if Assigned(Aerros) then
        FOwner.onCalcValoresNF(Aerros);

  finally
    FOwner.vItProd.prepare_loop_done;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

