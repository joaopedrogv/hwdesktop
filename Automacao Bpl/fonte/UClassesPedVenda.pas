function TPedVenda.VoltaEstoqueEquipamentoNSerie: Boolean;
var
  vTemp: string;
begin
  Result := True;
  try
    vDadosIni.abreStatusProcessamento('', 'Voltando Estoque de Equipamentos');
    vItProd.dataSet.DisableControls;
    vItProd.dataSet.first;
    while not vItProd.dataSet.Eof do
    begin
      if (vItProd.dataset.Fieldbyname('NPED').AsInteger = dataset.fieldbyname('NPED').AsInteger) and
        (vItProd.dataset.Fieldbyname('STATUS').AsString <> 'CANCELADO') and
        (vItProd.dataSet.FieldByName('cod_nserie').AsInteger > 0) then
      begin
        try
          buscas.Close;
          buscas.SQL.Text := 'update ecf set status = ''Estoque'', nped = null, tipo_ped = null, nitem_ped = null ' +
            ' where cod_nserie = ' + IntToStr(vItProd.dataSet.FieldByName('cod_nserie').AsInteger) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and nped = ' + dataSet.FieldByName('nped').AsString +
            ' and tipo_ped = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
            ' and nitem_ped = ' + vItProd.dataSet.FieldByName('nitem').AsString;
          buscas.ExecSQL;

        except on E: Exception do
          begin
            Result := False;
            if Application.MessageBox(pchar('Item N° ' + vitProd.dataset.Fieldbyname('nitem').AsString +
              '. Erro ao Voltar Estoque de Equipamento do produto: ' + trim(vitProd.dataset.Fieldbyname('NUM_FAB_PROD').AsString) +
              '. Deseja ver o erro?'), 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDYES then
              Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
            registraErro(e.Message);
          end;
        end;
      end;
      vItProd.dataSet.Next;
    end;
    vItProd.dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  except on E: Exception do
    begin
      Result := False;
      if Application.MessageBox(pchar('Item N° ' + vitProd.dtSetIt.Fieldbyname('nitem').AsString +
        '. Erro ao Voltar Estoque equipamento NSérie: ' + trim(vitProd.dtSetIt.Fieldbyname('NUM_FAB_PROD').AsString) +
        '. Deseja ver o erro?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDYES then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

