function TPedVendaServTerc.edit: boolean;
begin
	Result := false;

  if dataSet.IsEmpty then
    Exit;

	if inherited edit then
  begin
    Result := True;
    if dataSet.FieldByName('SEQID').AsInteger <= 0 then
    begin
      vSeqId := vSeqId + 1;
      dataSet.FieldByName('SEQID').AsInteger := vSeqId;
      atualizarDtSetTemp('EDITAR', true);
    end;
    descricaoTemp := dataSet.FieldByName('DESCR_SERVT').AsString;
  end;
end;

function TPedVendaServTerc.getValorItens: Currency;
begin
  CalculaValorTotalItens;
  Result := vTotalServ;
end;

function TPedVendaServTerc.insert: boolean;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    if not post then
      exit;
  end;
  FOwner.calculaDescontoAcrescimo;
  if inherited insert then
  begin
    Result := true;
    vSeqId := vSeqId + 1;
    descricaoTemp := '';
    dataSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('tipo').AsString := FOwner.dataSet.FieldByName('tipo').AsString;
    dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;
    dataSet.FieldByName('vlcusto').AsFloat := 0;
    dataSet.FieldByName('seqid').AsInteger := vSeqId;
  end;
end;

procedure TPedVendaServTerc.pedVendaServTercBeforePost(DataSet: TDataSet);
begin
  dataSet.FieldByName('VL_SERVT').AsString :=
    StringReplace(trim(Format('%14.2n',
    [dataSet.FieldByName('VL_SERVT').AsFloat])), '.', '', [rfReplaceAll]);
end;

function TPedVendaServTerc.post: boolean;
var
	acao: string;
begin
  try
    Result := false;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if vSing.vTipoVenda = 'OS' then
    begin
      if not vDadosIni.PesqPros('VND041', 'SALVAR', 'SERV.:' + trim(dataSet.FieldByName('DESCR_SERVT').AsString), 'PEDVENDA_SERV_TERC', '', buscas, true) then
        Exit;
    end
    else
    begin
      if not vDadosIni.PesqPros('VND045', 'SALVAR', 'SERV.:' + trim(dataSet.FieldByName('DESCR_SERVT').AsString), 'PEDVENDA_SERV_TERC', '', buscas, true) then
        Exit;
    end;
    if dataSet.FieldByName('vlcusto').AsFloat < 0 then
      dataSet.FieldByName('vlcusto').AsFloat := 0;
    if dataSet.FieldByName('cod_fornecedor').AsFloat < 0 then
      dataSet.FieldByName('cod_fornecedor').AsFloat := 0;
      
    if dataSet.FieldByName('descr_servt').AsString = '' then
      raiseExceptioncreate('Descrição precisa ser preenchida', 'DBEdit66');
    if dataSet.FieldByName('vl_servt').AsString = '' then
      raiseExceptioncreate('Valor do serviço precisa ser preenchido', 'DBEdit65');
    if dataSet.FieldByName('vlcusto').AsString = '' then
      raiseExceptioncreate('Custo precisa ser preenchido', 'DBEdit140');

    if dataSet.FieldByName('vlcusto').AsFloat > 0 then
      if dataSet.FieldByName('nome_fornecedor').AsString = '' then
        raiseExceptioncreate('Fornecedor precisa ser preenchido', 'DBEdit146');


    if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
    	and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
    	and (dataSet.FieldByName('NPED').AsInteger = 0)
      and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
      	dataSet.FieldByName('nped').AsInteger := FOwner.dataSet.FieldByName('nped').AsInteger;

    if Assigned(dtSetTemp) then
    begin
      dtSetTemp.First;
      while not dtSetTemp.Eof do
      begin
        if (dtSetTemp.FieldByName('DESCR_SERVT').AsString = dataSet.FieldByName('DESCR_SERVT').AsString)
        	and (dtSetTemp.FieldByName('SEQID').AsInteger <> dataSet.FieldByName('SEQID').AsInteger) then
          raiseExceptioncreate('Já existe um serviço de terceiro com esta descrição!', 'DBEdit66');

        dtSetTemp.Next;
      end;
    end;
    
    Result := inherited post;

    atualizarDtSetTemp(acao);

    if Result then
      if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S') and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO') then
        if (FOwner.dataSet.FieldByName('nped').AsInteger = 0) then
          FOwner.verificaSalvamentoAutomatico
        else
        begin
          Result := Apply;
          if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
            abreServicoTerceiro(FOwner.dataSet.FieldByName('nped').AsInteger);
        end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

