function TPedVenda.cargaFechada: Boolean;
begin
  Result := False;
  if dataSet.FieldByName('cod_carga').AsInteger = 0 then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select status from carga' +
    ' where cod_carga = ' + IntToStr(dataSet.FieldByName('cod_carga').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if buscas.IsEmpty then
  begin
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_carga').Value := Null;
  end
  else
    Result := Trim(buscas.FieldByName('status').AsString) = 'FECHADA';
end;

function TPedVenda.vendaEmOrdemDeCarregamento: Boolean;
begin
  Result := False;
  if dataSet.FieldByName('cod_carga').AsInteger = 0 then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select cod_carga from carga' +
    ' where cod_carga = ' + IntToStr(dataSet.FieldByName('cod_carga').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if buscas.IsEmpty then
  begin
    if dataSet.State in [dsInsert, dsEdit] then
      dataSet.FieldByName('cod_carga').Value := Null;
  end
  else
    Result := True;
end;

function TPedVenda.ChangeClienteFaturamento(iCodCliFat: Integer): string;
begin
  Result := '';
  if iCodCliFat <= 0 then
    Exit;

  queryCons.Table('clientes', 'cpfcgc, cod_cliente, nome_cliente, razao')
    .Equals('cod_cliente', iCodCliFat)
    .Equals('cod_empresa', vDadosIni.cod_empresa)
    .Open;

  if queryCons.IsEmpty then
  begin
    ShowAtencao('Cliente não localizado');
    Exit;
  end;

  Result := queryCons.fstr('cpfcgc') + ' - ' + queryCons.fstr('nome_cliente');
  if queryCons.fstr('nome_cliente') <> queryCons.fstr('razao') then
    Result := Result + '/' + queryCons.fstr('razao');

  if dataSet.State in [dsEdit, dsInsert] then
    dataSet.FieldByName('cod_cli_fat').AsInteger := iCodCliFat;
end;

