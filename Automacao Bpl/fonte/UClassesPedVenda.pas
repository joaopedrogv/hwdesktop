function TComissaoPorVendaCons.validarCampos(pVndPart: string): boolean;
begin
  try
    Result := True;

    if pVndPart = 'V' then
    begin
      if dataSet.FieldByName('perc_comissao_vend').AsFloat < 0 then
        raiseExceptionCreate('Percentual de Comissão do vendedor incorreto', 'EditHwPercVend');

      if dataSet.FieldByName('vl_comissao_vend').AsFloat < 0 then
        raiseExceptionCreate('Valor de Comissão do vendedor incorreto', 'EditHwVlVend');
    end;

    if pVndPart = 'P' then
      if (vDadosIni.vPedVnd.habPartipante) and (dataSet.FieldByName('cod_vendedor1').AsInteger > 0) then
      begin
        if dataSet.FieldByName('perc_comissao_vend1').AsFloat < 0 then
          raiseExceptionCreate('Percentual de Comissão do ' + vDadosIni.vPedVnd.descricaoParticipante +
             ' incorreto', 'DBEditPercPart');

        if dataSet.FieldByName('vl_comissao_vend1').AsFloat < 0 then
          raiseExceptionCreate('Valor de Comissão do ' + vDadosIni.vPedVnd.descricaoParticipante +
            ' incorreto ', 'DBEditVlPart');
      end;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TComissaoPorVendaCons.validarCampos. Erro: ' + e.Message);
    end;
  end;
end;

