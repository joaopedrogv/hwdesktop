procedure TRegrasVnd._desmarcarTodos(pBuscas: TIBQuery);
var
	vRecno: Integer;
begin
	if dataset.IsEmpty then
    exit;

	try
  	vRecno := dataset.RecNo;
    dataset.DisableControls;
    dataset.First;
    while not dataset.Eof do
    begin
      dataset.Edit;
      dataset.FieldByName('sel').AsString := '';
      dataset.Post;

      dataset.Next;
    end;

    vCtrlSelTmp.EmptyDataSet;
  finally
    dataset.First;
    dataset.EnableControls;
    dataset.RecNo := vRecno;
  end;

  try
  	FCodRegras := '';

    dataset.DisableControls;
    dataset.First;
    while not dataset.Eof do
    begin
      if (dataset.FieldByName('sel').AsString = 'S')
        and (Pos(',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger) + ',', ',' + FCodRegras + ',') <= 0)  then
      begin
        if (trim(FCodRegras) <> '') and (trim(FCodRegras) <> '()') then
          FCodRegras := FCodRegras + ',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger)
        else
          FCodRegras := IntToStr(dataset.FieldByName('cod_regravnd').AsInteger);
      end;

    	dataset.Next;
    end;

    FCodRegras := '(' + FCodRegras + ')';
  finally
  	dataset.First;
    dataset.EnableControls;
  end;

  if FCodRegras = '()' then
    vRVndSel.montaSelect(' select first 0 * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' order by rv.cod_regravnd ')
  else
  	vRVndSel.montaSelect(' select * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' and rv.cod_regravnd in ' + FCodRegras +
      ' order by rv.cod_regravnd ');
end;

procedure TRegrasVnd._marcaDesmarcaLinha(pBuscas: TIBQuery);
var
	vSel: boolean;
  vCodRegraVnd: Integer;
  vBarradoDiasPrazo: boolean;
  vBarradoQtdeParc: boolean;
  vRecno: Integer;
  vCodRegraVndTmp: Integer;
begin
  if dataset.IsEmpty then
    exit;

  if UpperCase(trim(dataset.FieldbyName('Status').AsString)) = 'BARRADO' then
  begin
    Application.MessageBox('Somente é possível a seleção de regras/condições não barradas.','Informação',MB_OK+MB_ICONINFORMATION);
    exit;
  end;

  if dataset.FieldByName('sel').AsString = '' then
  begin
    if vOpPag.dataSet.IsEmpty then
    begin
    	Application.MessageBox(PChar('Nenhuma condição de pagamento compatível com a política de pagamento.'),
      	'Informação', MB_OK + MB_ICONINFORMATION);
      exit;
    end;

  	try
    	// Testar controles selecionados
      try
      	vCodRegraVndTmp := dataSet.FieldByName('cod_regravnd').AsInteger;

      	vRecno := dataset.RecNo;
        dataset.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
        	if vCodRegraVndTmp = dataSet.FieldByName('cod_regravnd').AsInteger then
          begin
            try
              vCtrlSelTmp.Filtered := False;
              vCtrlSelTmp.Filter := 'CODIGO_CTRL = ' + IntToStr(dataset.FieldByName('CODIGO_CTRL').AsInteger);
              vCtrlSelTmp.Filtered := True;

              if not vCtrlSelTmp.IsEmpty then
              begin
                Application.MessageBox(PChar('Controle já adicionado em outra política: ' + #13 + #13 +
                  'CONTROLE: ' + #13 +
                  'Cod Controle: ' + IntToStr(dataset.FieldByName('CODIGO_CTRL').AsInteger) + #13 +
                  'Nome Controle: ' + Trim(dataset.FieldByName('NOME_CTRL').AsString) + #13 + #13 +
                  'Favor verificar antes de continuar!'),'Informação',MB_OK+MB_ICONINFORMATION);
                exit;
              end;
            finally
              vCtrlSelTmp.Filtered := False;
              vCtrlSelTmp.Filter := '';
            end;
          end;

          dataset.Next;
        end;
      finally
        dataset.First;
        dataset.EnableControls;
        dataset.RecNo := vRecno;
      end;

    	vOpPag.dataSet.DisableControls;
      vOpPag.dataSet.First;
      while not vOpPag.dataSet.Eof do
      begin
      	SqlOpen(' select dias_prazo from retorna_qtde_cond_pag ' +
        	' (' + QuotedStr(vOpPag.dataSet.FieldByName('DESC_COND_PAG').AsString) + ')', pBuscas);

        if pBuscas.FieldByName('DIAS_PRAZO').AsInteger > vOpPag.dataSet.FieldByName('PRAZOMAX').AsInteger then
          vBarradoDiasPrazo := True
        else
        	vBarradoDiasPrazo := False;

        SqlOpen(' select qtde_parc from retorna_qtde_cond_pag ' +
        	' (' + QuotedStr(vOpPag.dataSet.FieldByName('DESC_COND_PAG').AsString) + ')', pBuscas);

        if pBuscas.FieldByName('QTDE_PARC').AsInteger > vOpPag.dataSet.FieldByName('MAXPARCELAS').AsInteger then
          vBarradoQtdeParc  := True
        else
        	vBarradoQtdeParc  := False;

        if ((not vBarradoDiasPrazo) and (not vBarradoQtdeParc)) then
        	Break;

        vOpPag.dataSet.Next;
      end;

    finally
      vOpPag.dataSet.First;
      vOpPag.dataSet.EnableControls;
    end;

    if (vBarradoDiasPrazo) and (vBarradoQtdeParc) then
    begin
    	Application.MessageBox('Nenhuma condição de pagamento para esta política é compatível.','Informação',MB_OK+MB_ICONINFORMATION);
      Exit;
    end;

  end;

  vCodRegraVnd := dataset.FieldByName('cod_regravnd').AsInteger;
  dataset.Edit;
  if dataset.FieldByName('sel').AsString = 'S' then
  begin
    dataset.FieldByName('sel').AsString := '';

    // Testar controles selecionados
    try
    	vCtrlSelTmp.Filtered := False;
      vCtrlSelTmp.Filter := 'CODIGO_CTRL = ' + IntToStr(dataset.FieldByName('CODIGO_CTRL').AsInteger);
      vCtrlSelTmp.Filtered := True;

      if not vCtrlSelTmp.IsEmpty then
      	vCtrlSelTmp.Delete;
    finally
    	vCtrlSelTmp.Filtered := False;
      vCtrlSelTmp.Filter := '';
    end;

    vSel := false;
  end
  else
  begin
  	dataset.FieldByName('sel').AsString := 'S';

    vCtrlSelTmp.Insert;
    vCtrlSelTmp.FieldByName('CODIGO_CTRL').AsInteger := dataset.FieldByName('CODIGO_CTRL').AsInteger;
    vCtrlSelTmp.Post;

    vSel := true;
  end;
  dataset.Post;

  try
  	FCodRegras := '';

    dataset.DisableControls;
    dataset.First;
    while not dataset.Eof do
    begin
      if dataset.FieldByName('cod_regravnd').AsInteger = vCodRegraVnd then
      begin
      	dataset.Edit;
        dataset.FieldByName('sel').AsString := vDadosIni.IfThen(vSel, 'S', 'N');
        dataset.Post;
      end;

      if (dataset.FieldByName('sel').AsString = 'S')
        and (Pos(',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger) + ',', ',' + FCodRegras + ',') <= 0)  then
      begin
        if (trim(FCodRegras) <> '') and (trim(FCodRegras) <> '()') then
          FCodRegras := FCodRegras + ',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger)
        else
          FCodRegras := IntToStr(dataset.FieldByName('cod_regravnd').AsInteger);
      end;

    	dataset.Next;
    end;

    FCodRegras := '(' + FCodRegras + ')';
  finally
  	dataset.First;
    dataset.EnableControls;
  end;

  if FCodRegras = '()' then
    vRVndSel.montaSelect(' select first 0 * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' order by rv.cod_regravnd ')
  else
  	vRVndSel.montaSelect(' select * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' and rv.cod_regravnd in ' + FCodRegras +
      ' order by rv.cod_regravnd ');

end;

procedure TRegrasVnd._marcarTodos(pBuscas: TIBQuery);
var
	vBarradoDiasPrazo: boolean;
  vBarradoQtdeParc: boolean;
	vRecno: Integer;
  vCodRegraVndTmp: Integer;
	fTempDataset: TClientDataSet;
begin
	try
    if dataset.IsEmpty then
      exit;

    fTempDataset := TClientDataSet.Create(nil);
    fTempDataset.Close;
    fTempDataset.FieldDefs.Clear;
    fTempDataset.FieldDefs.Add('COD_REGRAVND', ftInteger, 0, false);
    fTempDataset.FieldDefs.Add('CODIGO_CTRL', ftInteger, 0, false);
    fTempDataset.FieldDefs.Add('STATUS', ftString, 8, false);
    fTempDataset.FieldDefs.Add('STATUS_ID', ftInteger, 0, false);
    fTempDataset.FieldDefs.Add('DESCRICAO', ftString, 70, false);
    fTempDataset.FieldDefs.Add('QSEQPERF', ftInteger, 0, false);
    fTempDataset.FieldDefs.Add('SEL', ftString, 1, false);

    if fTempDataset.Tag = 0 then
    try
      fTempDataset.CreateDataSet;
      fTempDataset.Tag := 1;
    except
    end;

    try
      vRecno := dataset.RecNo;
      dataset.DisableControls;
      dataset.First;
      while not dataset.Eof do
      begin
        fTempDataset.Insert;
        fTempDataset.FieldByName('COD_REGRAVND').AsInteger := dataSet.FieldByName('COD_REGRAVND').AsInteger;
        fTempDataset.FieldByName('CODIGO_CTRL').AsInteger := dataSet.FieldByName('CODIGO_CTRL').AsInteger;
        fTempDataset.FieldByName('STATUS').AsString := dataSet.FieldByName('STATUS').AsString;
        fTempDataset.FieldByName('STATUS_ID').AsInteger := vDadosIni.IfThen(
          fTempDataset.FieldByName('STATUS').AsString = 'Liberado', 0, 1);
        fTempDataset.FieldByName('DESCRICAO').AsString := dataSet.FieldByName('DESCRICAO').AsString;
        fTempDataset.FieldByName('QSEQPERF').AsInteger := dataSet.FieldByName('QSEQPERF').AsInteger;
        fTempDataset.FieldByName('SEL').AsString := '';
        fTempDataset.Post;

        dataset.Next;
      end;
    finally
      dataset.First;
      dataset.EnableControls;
      dataset.RecNo := vRecno;
    end;

    fTempDataset.IndexFieldNames := 'status_id;descricao;qseqperf';
    fTempDataset.RecNo := vRecno;

    try
      fTempDataset.DisableControls;
      fTempDataset.First;
      while not fTempDataset.Eof do
      begin
        if UpperCase(trim(fTempDataset.FieldbyName('Status').AsString)) <> 'BARRADO' then
        begin
          if fTempDataset.FieldByName('sel').AsString = '' then
          begin
            dataSet.RecNo := fTempDataset.RecNo;

            if not vOpPag.dataSet.IsEmpty then
            begin
              try
                // Testar controles selecionados
                try
                  vCodRegraVndTmp := dataSet.FieldByName('cod_regravnd').AsInteger;

                  vRecno := dataset.RecNo;
                  dataset.DisableControls;
                  dataset.First;
                  while not dataset.Eof do
                  begin
                    if vCodRegraVndTmp = dataSet.FieldByName('cod_regravnd').AsInteger then
                    begin
                      try
                        vCtrlSelTmp.Filtered := False;
                        vCtrlSelTmp.Filter := 'CODIGO_CTRL = ' + IntToStr(dataset.FieldByName('CODIGO_CTRL').AsInteger);
                        vCtrlSelTmp.Filtered := True;

                        if not vCtrlSelTmp.IsEmpty then
                        begin
                          fTempDataset.Edit;
                          fTempDataset.FieldByName('sel').AsString := 'S';
                          fTempDataset.Post;

  //                      	fTempDataset.Next;
                        end;
                      finally
                        vCtrlSelTmp.Filtered := False;
                        vCtrlSelTmp.Filter := '';
                      end;
                    end;

                    dataset.Next;
                  end;
                finally
                  dataset.First;
                  dataset.EnableControls;
                  dataset.RecNo := vRecno;
                end;

                vOpPag.dataSet.DisableControls;
                vOpPag.dataSet.First;
                while not vOpPag.dataSet.Eof do
                begin
                  SqlOpen(' select dias_prazo from retorna_qtde_cond_pag ' +
                    ' (' + QuotedStr(vOpPag.dataSet.FieldByName('DESC_COND_PAG').AsString) + ')', pBuscas);

                  if pBuscas.FieldByName('DIAS_PRAZO').AsInteger > vOpPag.dataSet.FieldByName('PRAZOMAX').AsInteger then
                    vBarradoDiasPrazo := True
                  else
                    vBarradoDiasPrazo := False;

                  SqlOpen(' select qtde_parc from retorna_qtde_cond_pag ' +
                    ' (' + QuotedStr(vOpPag.dataSet.FieldByName('DESC_COND_PAG').AsString) + ')', pBuscas);

                  if pBuscas.FieldByName('QTDE_PARC').AsInteger > vOpPag.dataSet.FieldByName('MAXPARCELAS').AsInteger then
                    vBarradoQtdeParc  := True
                  else
                    vBarradoQtdeParc  := False;

                  if ((not vBarradoDiasPrazo) and (not vBarradoQtdeParc)) then
                  begin
                    fTempDataset.Edit;
                    fTempDataset.FieldByName('sel').AsString := 'S';
                    fTempDataset.Post;

  //                  fTempDataset.Next;
                  end;

                  vOpPag.dataSet.Next;
                end;

              finally
                vOpPag.dataSet.First;
                vOpPag.dataSet.EnableControls;
              end;
            end;

            fTempDataset.Edit;
            fTempDataset.FieldByName('sel').AsString := 'S';
            fTempDataset.Post;

            vCtrlSelTmp.Insert;
            vCtrlSelTmp.FieldByName('CODIGO_CTRL').AsInteger := dataset.FieldByName('CODIGO_CTRL').AsInteger;
            vCtrlSelTmp.Post;
          end;
        end;

        fTempDataset.Next;
      end;

    finally
      dataset.First;
      dataset.EnableControls;
      dataset.RecNo := vRecno;
    end;

    fTempDataset.First;
    while not fTempDataset.Eof do
    begin
      if UpperCase(trim(fTempDataset.FieldbyName('Status').AsString)) <> 'BARRADO' then
      begin
        dataset.RecNo := fTempDataset.RecNo;

        dataSet.Edit;
        dataSet.FieldByName('SEL').AsString := fTempDataset.FieldByName('SEL').AsString;
        dataSet.Post;
      end;

      fTempDataset.Next;
    end;


    try
      FCodRegras := '';

      dataset.DisableControls;
      dataset.First;
      while not dataset.Eof do
      begin
        if (dataset.FieldByName('sel').AsString = 'S')
          and (Pos(',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger) + ',', ',' + FCodRegras + ',') <= 0)  then
        begin
          if (trim(FCodRegras) <> '') and (trim(FCodRegras) <> '()') then
            FCodRegras := FCodRegras + ',' + IntToStr(dataset.FieldByName('cod_regravnd').AsInteger)
          else
            FCodRegras := IntToStr(dataset.FieldByName('cod_regravnd').AsInteger);
        end;

        dataset.Next;
      end;

      FCodRegras := '(' + FCodRegras + ')';
    finally
      dataset.First;
      dataset.EnableControls;
    end;

    if FCodRegras = '()' then
      vRVndSel.montaSelect(' select first 0 * from regras_vendas rv ' +
        ' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and rv.ativo = 1 ' +
        ' order by rv.cod_regravnd ')
    else
      vRVndSel.montaSelect(' select * from regras_vendas rv ' +
        ' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and rv.ativo = 1 ' +
        ' and rv.cod_regravnd in ' + FCodRegras +
        ' order by rv.cod_regravnd ');
  finally
  	if Assigned(fTempDataset) then
    	FreeAndNil(fTempDataset);
  end;
end;

function TRegrasVnd._selecionarRegra(pSimular:boolean=true): boolean;
var
  strFilter:string;
  vCodRegrasTemp,vCondPagtemp,i,j:integer;
begin
  result:=false;
  if vOpPag.IsEmpty then
    exit;

  if UpperCase(trim(vOpPag.dataSet.FieldbyName('Status').AsString)) = 'BARRADO' then
  begin
    Application.MessageBox('Somente é possível a seleção de regras/condições não barradas.','Informação',MB_OK+MB_ICONINFORMATION);
    exit;
  end;

  if pos('('+dataSet.FieldByName('cod_regravnd').AsString+',',FCodRegras)>0 then
    FCodRegras := StringReplace(FCodRegras, '(' + dataSet.FieldByName('cod_regravnd').AsString + ',', '(',[])
  else if pos(','+dataSet.FieldByName('cod_regravnd').AsString+',',FCodRegras)>0 then
    FCodRegras := StringReplace(FCodRegras, ',' + dataSet.FieldByName('cod_regravnd').AsString + ',', ',',[])
  else if pos(','+dataSet.FieldByName('cod_regravnd').AsString+')',FCodRegras)>0 then
    FCodRegras := StringReplace(FCodRegras, ',' + dataSet.FieldByName('cod_regravnd').AsString + ')', ')',[])
  else if FCodRegras = '()' then
    FCodRegras := '(' + dataSet.FieldByName('cod_regravnd').AsString + ')'
  else
  begin
//      vRVndSel.First;
//      while not vRVndSel.Eof do
//      begin
      if (dataSet.FieldByName('SOBREPOR_PROMOCAO').AsString = vRVndSel.dataSet.FieldByName('SOBREPOR_PROMOCAO').AsString)
        and  (dataSet.FieldByName('SOBREPOR_TABPRECO').AsString = vRVndSel.dataSet.FieldByName('SOBREPOR_TABPRECO').AsString)
        and (dataSet.FieldByName('SOBREPOR_MAXDESCPROD').AsString = vRVndSel.dataSet.FieldByName('SOBREPOR_MAXDESCPROD').AsString) then
      begin
        FCodRegras:= StringReplace(FCodRegras, ')',',' + dataSet.FieldByName('cod_regravnd').AsString + ')',[]);
//          exit;
      end
      else
      begin
        if Application.MessageBox(pchar('Esta regra que está sendo seleciona não é compatível com a(s) regra(s) já selecionada(s).'+chr(13)+
           'Selecionar esta regra irá descelecionar a(s) regra(s) já selecionada(s). Deseja selecioná-la assim mesmo?'), 'Confirmação',
          MB_ICONQUESTION + MB_YESNO) = IDYES then
        FCodRegras:='('+dataSet.FieldByName('cod_regravnd').AsString+')'
      end;
//        vRVndSel.Next;
//      end;
  end;

  if FCodRegras = '()' then
    vRVndSel.montaSelect(' select first 0 * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' order by rv.cod_regravnd ')
  else
  	vRVndSel.montaSelect(' select * from regras_vendas rv ' +
    	' where rv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and rv.ativo = 1 ' +
      ' and rv.cod_regravnd in ' + FCodRegras +
      ' order by rv.cod_regravnd ');
  Result := True;
end;

