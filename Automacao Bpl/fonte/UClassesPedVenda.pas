//                buscas.ExecSQL;
//              end;

              	 vtemp := vtemp + ' ' + dataSet.FieldByName('NITEM').AsString + ',';
              delete;
            end
            else
              dataSet.Next;
         end;
         end;

         if FOwner.CancelarVariosItens then
           if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
           	 and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
             and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
             	Apply;

         if FOwner.CancelarVariosItens then
           vtemp := vDadosIni.IfThen(I <= 1, 'Item', 'Item(s) ') +
              Copy(vtemp, 1, length(vtemp) - 1)  +
              vDadosIni.IfThen(I <= 1, ' Cancelado', ' Cancelado(s).');
       finally
          if FOwner.CancelarVariosItens then
          begin
            dataSet.Filtered := false;
            dataSet.Filter := '';
            dataSet.IndexFieldNames := 'NITEM';
          end;
       end;

       dtSet.EmptyDataSet;
       item := 1;

       if not dataSet.ControlsDisabled then
         dataSet.DisableControls;
       dataSet.First;
       while not dataSet.Eof do
       begin
         dataSet.Edit;
         dataSet.FieldByName('nitem').AsInteger := item;
         dataSet.Post;
         inc(item);
         dataSet.Next;
       end;
       if dataSet.ControlsDisabled then
         dataSet.EnableControls;
       Result := true;
    end
    else
    begin
        try
          if FOwner.CancelarVariosItens then
          begin
            dataSet.Filtered := false;
            dataSet.Filter := ' SEL =''S'' AND STATUS <> ''CANCELADO'' ';
            dataSet.Filtered := true;

            if dataSet.IsEmpty then
            begin
              Application.MessageBox(pchar('Nenhum item selecionado, favor selecionar'), 'Atenção', MB_ICONINFORMATION + MB_OK);
              Exit;
            end;

            dataSet.First;
          end;

          I := 0;
          vtemp := '';
          if not FOwner.CancelarVariosItens then
          begin
             if inherited Edit then
             begin
               Inc(I);
               dataSet.FieldByName('TIPV').AsVariant := null;
               dataSet.FieldByName('STATUS').AsString := 'CANCELADO';
               dataSet.FieldByName('RATEIO_DESC').AsCurrency := 0;
               dataSet.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
               Result := inherited post;

               vtemp := vtemp + 'Item ' + dataSet.FieldByName('nitem').AsString + ' Cancelado. Produto: ' + dataSet.FieldByName('num_fab_prod').AsString
             end
             else
               Result := false;
          end
          else
          begin
          while not dataSet.Eof do
          begin
            Inc(I);
            dataSet.Edit;
            dataSet.FieldByName('SEL').AsVariant := null;
            dataSet.FieldByName('TIPV').AsVariant := null;
            dataSet.FieldByName('STATUS').AsString := 'CANCELADO';
            dataSet.FieldByName('RATEIO_DESC').AsCurrency := 0;
            dataSet.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
            dataSet.Post;

              vtemp := vtemp + ' ' + dataSet.FieldByName('NITEM').AsString + ',';
  //            dataSet.Next;
          end;
            Result := true;
          end;

          if FOwner.CancelarVariosItens then
          begin
            	vtemp := vDadosIni.IfThen(I <= 1, 'Item', 'Item(s) ') +
        		   Copy(vtemp, 1, length(vtemp) - 1)  + vDadosIni.IfThen(I <= 1, ' Cancelado', ' Cancelado(s).');
          end;
        finally
          if FOwner.CancelarVariosItens then
          begin
            dataSet.Filtered := false;
            dataSet.Filter := '';
            dataSet.IndexFieldNames := 'NITEM';
          end;
        end;
    end;
    if (Result)
    	and (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
      and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
      and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
    begin
