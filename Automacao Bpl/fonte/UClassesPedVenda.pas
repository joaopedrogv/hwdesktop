procedure TPedVenda.removerStatusLiberacaoFinanceiro;
var
  vNumPedVenda: Integer;
  vSitAut: string;
begin
  if not vDadosIni.PesqPros('VND189', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', IntToStr(dataSet.FieldByName('nped').AsInteger), buscas, true) then
    Exit;

  vSitAut := '';

  try
    vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;
    buscas.Close;
    buscas.SQL.Text := 'select AUTORIZADO_FINANCEIRO, STATUS_PED from PEDVENDA' +
      ' WHERE NPED = ' + IntToStr(vNumPedVenda) +
      ' AND TIPO = ''REQ'' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;

    if Trim(buscas.FieldByName('AUTORIZADO_FINANCEIRO').AsString) = '' then
      Exit;

    if Trim(buscas.FieldByName('STATUS_PED').AsString) <> '' then
      raiseExceptionCreate('Pedido não está aberto, funcionalidade não disponível para pedidos abertos!', '');


    if Trim(buscas.FieldByName('AUTORIZADO_FINANCEIRO').AsString) = 'S' then
      if Application.MessageBox('Pedido liberado pelo Financeiro! Deseja remover o status de libeação?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> ID_YES then
        Exit;

    if Trim(buscas.FieldByName('AUTORIZADO_FINANCEIRO').AsString) = 'N' then
      if Application.MessageBox('Pedido não autorizado pelo Financeiro! Deseja remover o status de autorização?',
        'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> ID_YES then
        Exit;

    if Trim(buscas.FieldByName('AUTORIZADO_FINANCEIRO').AsString) = 'S' then
      vSitAut := 'SITUACAO FINANCEIRO: AUTORIZADO'
    else
      vSitAut := 'SITUACAO FINANCEIRO: NAO AUTORIZADO';

    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'FINANCEIRO', 'Iniciado', '', buscas, False, False, True);
    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'FINANCEIRO', 'Finalizado', '', buscas, False, False, True);

    buscas.Close;
    buscas.SQL.Text := 'update pedvenda set autorizado_financeiro = null' +
      ' where nped = ' + IntToStr(vNumPedVenda) +
      ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.ExecSQL;

    if buscas.Transaction.InTransaction then
      buscas.Transaction.Commit;

    try dataSet.Refresh; except end;

    vDadosIni.GravaAuditoria('VND189', 'ALTERAR', 'SUCESSO ' + vSitAut, 'PEDVENDA', IntToStr(vNumPedVenda), buscas)

  except on E: Exception do
    begin
      vDadosIni.GravaAuditoria('VND189', 'ALTERAR', 'FALHA ' + vSitAut, 'PEDVENDA', IntToStr(vNumPedVenda), buscas);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registrarEntrega('procedure TPedVenda.removerStatusLiberacaoFinanceiro. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.removerStatusSeparacao: Boolean;
var
  vNumPedVenda: Integer;
  vStatusPed, vStatusSepConf: string;
begin
  Result := False;

  if Application.MessageBox('Deseja remover o status da separação/conferência?',
    'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) <> ID_YES then
    Exit;

  if not vDadosIni.PesqPros('VND185', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', IntToStr(dataSet.FieldByName('nped').AsInteger), buscas, true) then
    Exit;

  try
    vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;
    buscas.Close;
    buscas.SQL.Text := 'select STATUS_PED, STATUS_SEP_CONF, TIPV, COD_CLIENTE, APROVADA_GERENTE, AUTORIZADO_FINANCEIRO' +
      ' from PEDVENDA' +
      ' WHERE NPED = ' + IntToStr(vNumPedVenda) +
      ' AND TIPO = ''REQ'' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vStatusPed := Trim(buscas.FieldByName('STATUS_PED').AsString);
    vStatusSepConf := Trim(buscas.FieldByName('STATUS_SEP_CONF').AsString);

    if Trim(vStatusPed) <> '' then
      raiseExceptionCreate('Status da Separação do Pedido não pode ser removido pois o pedido já está ' + vStatusPed, '');

    if (Trim(vStatusSepConf) = 'CONFERIDO') or (Trim(vStatusSepConf) = 'CONFERENCIA') then
      raiseExceptionCreate('Status da Separação do Pedido não pode ser removido já esta como: ' + vStatusSepConf, '');

    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Iniciado', '', buscas, False, False, True);
    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Finalizado', '', buscas, False, False, True);

    Result := vDadosIni.mudarStatusSeparacao(vNumPedVenda, 'REQ', cEmBranco, buscas, True);
    if Result then
      vDadosIni.GravaAuditoria('VND185', 'ALTERAR', 'SUCESSO', 'PEDVENDA', IntToStr(vNumPedVenda), buscas)
    else
      vDadosIni.GravaAuditoria('VND185', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);

  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('VND185', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registrarEntrega('function TPedVenda.finalizarSeparacao. Erro: ' + e.Message);
    end;
  end;
end;

