function TPedVenda._abreFormBoxEspecifico(pcod_servico: Double): Boolean;
var
  formulario: TfrmPadrao;
  vCodBox: string;
begin
  result := false;
  try
    formulario := TfrmPadrao.Create(Application);
    if DtmAgenda = nil then
      DtmAgenda := TDtmAgenda.Create(DtmAgenda);

    if vAgenda = nil then
      vAgenda := TAgenda.create;

    buscas.Close;
    buscas.SQL.Text := 'select t.*, s.desc_servico, b.descr_box from tipo_servico_box t ' +
      ' inner join box b on b.cod_box = t.cod_box and b.cod_empresa = t.cod_empresa ' +
      ' inner join tipo_servico s on s.cod_servico = t.cod_servico ' +
      ' where t.cod_servico = ' + FloatToStr(pcod_servico) + ' and t.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    buscas.FetchAll;
    buscas.First;
    while not buscas.Eof do
    begin
      if Trim(vCodBox) = '' then
        vCodBox := buscas.FieldByName('cod_box').AsString
      else
        vCodBox := vCodBox + ', ' + buscas.FieldByName('cod_box').AsString;
      buscas.Next;
    end;

    vAgenda.vAgendaItens.fBox.Filter := 'COD_BOX in (' + vCodBox + ')';
    vAgenda.vAgendaItens.fBox.Filtered := true;

    formulario.Width := 471;
    formulario.Height := 203;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Selecione o box específico';
    TFrmCadPedVenda(FrmCadPed).Panel48.Caption := 'Servico= ' + buscas.FieldByName('COD_SERVICO').AsString + ' - '
      + Copy(trim(buscas.FieldByName('DESC_SERVICO').AsString), 1, 20);

    TFrmCadPedVenda(FrmCadPed).pnBoxEspecifico.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.BorderIcons := [];
    result := (formulario.ShowModal = mrOk);

  finally
    TFrmCadPedVenda(FrmCadPed).pnBoxEspecifico.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros3;
    vAgenda.vAgendaItens.fBox.Filtered := false;
    if Assigned(formulario) then
    	FreeAndNil(formulario);
  end;
end;

function TPedVenda._abreFormDevolucaItensVND: Boolean;
var
  formulario: TfrmPadrao;
  vStatusSeparacao: string;
begin
  result := false;

  if not vDadosIni.PesqPros('VND129', 'ABRIR TELA DEVOLUÇÃO NA REQUISIÇÃO', dataSet.FieldByName('tipo').AsString, 'PEDVENDA',
  	dataSet.FieldByName('NPED').AsString, buscas, true) then
    	Exit;

  if IsEmpty then
  begin
    Application.MessageBox('Nenhum pedido de venda selecionado para proceder com a devolução de itens', 'Informação', MB_OK + MB_ICONINFORMATION);
    Exit;
  end;
  if verificaFechamento(1) then
  begin
    Application.MessageBox('Pedido de venda deve estar em aberto para proceder com a devolução de itens', 'Informação', MB_OK + MB_ICONINFORMATION);
    Exit;
  end;

  if (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') and (vDadosIni.vEmp.vUSAR_SEPARACAO_PED = 'S') then
  begin
    vStatusSeparacao := getStatusPedidoESeparacao(dataSet.FieldByName('nped').AsInteger);
    if vDadosIni.getCampoPipe(vStatusSeparacao,2) <> '' then
    begin
      Application.MessageBox(PChar('Pedido não pode ser alterado. Já esta em processo de separação com status: ' + vDadosIni.getCampoPipe(vStatusSeparacao,2)),
        'Atenção', 0 + 64 );
      Exit;
    end;
  end;
  if (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') and (vDadosIni.vEmp.vUsarConferenciaCegaSaida = 'S2') then
  begin
    vStatusSeparacao := getStatusPedidoESeparacao(dataSet.FieldByName('nped').AsInteger);
    if vDadosIni.getCampoPipe(vStatusSeparacao,2) = 'CONFERENCIA' then
    begin
      Application.MessageBox(PChar('Pedido não pode ser alterado. Já esta em processo de conferência'),
        'Atenção', 0 + 64 );
      Exit;
    end
    else if vDadosIni.getCampoPipe(vStatusSeparacao,2) = 'CONFERIDO' then
    begin
      Application.MessageBox(PChar('Pedido não pode ser alterado. Processo de conferência já foi concluído'),
        'Atenção', 0 + 64 );
      Exit;
    end;
  end;

  if dataSet.FieldByName('TIPV').AsString <>
    retornaValor('select first 1 sigla AS VALOR from tipo_vendas where tipo= ''REQ'' ' +
    ' and coalesce(venda,'''')=''N'' and sigla=' + QuotedStr(dataSet.FieldByName('TIPV').AsString)) then
  begin
    Application.MessageBox('O tipo de venda deste pedido de venda não permite devolução de itens', 'Informação', MB_OK + MB_ICONINFORMATION);
    Exit;
  end
  else
  	vItProd._setaTipv(dataSet.FieldByName('TIPV').AsString);

  abrePedVenda(fint('nped'));

  defineDisplay;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Devolução de itens na requisição ainda em aberto';
    TFrmCadPedVenda(FrmCadPed).pnDevolucao.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := True;
   	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
    vItProd.abrePedVendaProd(dataset.FieldByName('NPED').AsInteger);
    setValotTotalProdutos(vItProd.getValorItensBruto);
    TFrmCadPedVenda(FrmCadPed).Label183.Caption := Format('%m', [vItProd.vTotalItensBruto]);
    TFrmCadPedVenda(FrmCadPed).Label185.Caption := Format('%m', [vItProd.vTotalItensLiq]);
    TFrmCadPedVenda(FrmCadPed).LabelInfConversaoSaida.Caption := '';
    result := (formulario.ShowModal = mrOk);

  finally
    if result then
      _gravaDevolucaoVND
    else
    begin
      vItProd.CancelUpdates;
      Cancel;
      RollBackTransacao;
    end;
    TFrmCadPedVenda(FrmCadPed).pnDevolucao.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros2;
    if Assigned(formulario) then
    	FreeAndNil(formulario);
  end;
end;

