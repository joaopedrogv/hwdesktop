function TPedVenda.efetuaRateios(pReabrindo:boolean=false): Boolean;
var
  acrescProd, acrescServ,vDescontoNoItemValor,vDescontoNoItemPerc: Currency;
  vAjustaRateioDesc, Apend:boolean;
  vTeste: Integer;
  ASumDescProd, ASumDescServ, ASumAcreProd, ASumAcreServ, ALiq, ASumDescItem, ASumAcresItem,
    AdescProd, AacrescProd, AacrescimoSemImpostos, AimpostosAC, AimpostosDC, AdescontoSemImpostos: Double;
  msgDescontos: AnsiString;
begin
  try
    disableControlsDataSets;
    Result := True;

    vDadosIni.abreStatusProcessamento('', 'Efetuando Rateios necessários');
    vValorProdPermDesc := 0;
    FSobreporPromocao := false;
    FSobreporPrecTab := false;
    FSobreporMaxDescProd := false;
    FSobreporPrecQtde := false;
    if pReabrindo then
      FRegrasDescontos := trim(dataSet.FieldByName('REGRAS_DESCONTOS').AsString);
    if vDadosIni.vEmp.vUsarPoliticasDesc then
      if (trim(FRegrasDescontos) <> '') and (trim(FRegrasDescontos) <> '()') then
      begin
      	FSobreporPromocao := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + FRegrasDescontos +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_promocao = ''S'' ');

        FSobreporPrecTab := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + FRegrasDescontos +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_tabpreco = ''S'' ');

        FSobreporMaxDescProd := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + FRegrasDescontos +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_maxdescprod = ''S'' ');
      end;
    try

      if (dataSet.FieldByName('SAVEAUTO').AsString = 'S')
      	and (dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
      	and (dataSet.FieldByName('NPED').AsInteger > 0) then
      begin
        vDadosIni.abreStatusProcessamento('', 'Verificando produtos que pemitem rateio. Aguarde um pouco');

        buscas.Close;
        buscas.SQL.Text := 'select p.PERMITIR_DESCONTO, p.EM_PROMOCAO, pp.TABPRATICADA, pp.MAX_DESC_TAB, ' +
          ' sum( coalesce(pp.VLTOT_PED_ITEM, 0) ) as valor from pedvenda_prod pp' +
          ' inner join produtos p on p.grupo_prod = pp.grupo_prod and p.cod_prod = pp.cod_prod and p.cod_empresa = pp.cod_empresa' +
          ' where pp.nped = :nped and pp.tipo = :tipo and pp.cod_empresa = :cod_empresa and coalesce(pp.status, '''') <> ''CANCELADO''' +
          ' group by 1,2,3,4';
        buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
        buscas.ParamByName('tipo').AsString := dataSet.FieldByName('tipo').AsString;
        buscas.ParamByName('cod_empresa').AsInteger := dataSet.FieldByName('cod_empresa').AsInteger;
        buscas.Open;
        buscas.FetchAll;

        buscas.First;
        while not buscas.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Verificando produtos que permitem rateio. ' + IntToStr( Trunc( buscas.RecNo / buscas.RecordCount * 100  ) ) + '%' );
          if (buscas.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
            ((buscas.FieldByName('EM_PROMOCAO').AsString <> 'S') or
            ((FSobreporPromocao) and (buscas.FieldByName('EM_PROMOCAO').AsString = 'S'))) and
            ((buscas.FieldByName('TABPRATICADA').AsString <> 'P') or
            ((FSobreporPromocao) and (buscas.FieldByName('TABPRATICADA').AsString = 'P'))) and
            ((buscas.FieldByName('TABPRATICADA').AsString <> 'T') or
            ((FSobreporPrecTab) and (buscas.FieldByName('TABPRATICADA').AsString = 'T'))) and
            ((buscas.FieldByName('TABPRATICADA').AsString <> 'Q') or
            ((FSobreporPrecQtde) and (buscas.FieldByName('TABPRATICADA').AsString = 'Q'))) then
            	vValorProdPermDesc := vValorProdPermDesc + (buscas.FieldByName('valor').AsFloat)
          else if (buscas.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
            (buscas.FieldByName('EM_PROMOCAO').AsString <> 'S') and
            (vDadosIni.strIn(buscas.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and
            (buscas.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
          		vValorProdPermDesc := vValorProdPermDesc + (buscas.FieldByName('valor').AsFloat);
          buscas.Next;
        end;

      end
      else
      begin
        vItProd.dtSet.First; //dataset temporário
        while not vItProd.dtSet.Eof do
        begin
          Application.ProcessMessages;
          vDadosIni.abreStatusProcessamento('', 'Verificando produtos que permitem rateio... Item: '+vItProd.dtSet.FieldByName('nitem').AsString);
          if trim(vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
          begin
            vItProd.vProduto.buscaProduto(
            	vItProd.dtSet.FieldByName('grupo_prod').AsInteger,
              vItProd.dtSet.FieldByName('cod_prod').AsString);
            if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
              ((vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString <> 'S') or
              ((FSobreporPromocao) and (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S'))) and // ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS')))) and
              ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'P') or
              ((FSobreporPromocao) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'P'))) and // ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS'))) ) and
              ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'T') or
              ((FSobreporPrecTab) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'T'))) and
              ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'Q') or
              ((FSobreporPrecQtde) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'Q'))) then // and  ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS'))) ) then
              	vValorProdPermDesc := vValorProdPermDesc + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat
            else if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
              (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString <> 'S') and
              (vDadosIni.strIn(vItProd.dtSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and
              (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
             		vValorProdPermDesc := vValorProdPermDesc + (vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat);
          end;
          vItProd.dtSet.Next;
        end;

      end;
    finally
      vDadosIni.abreStatusProcessamento('', 'Efetuando Rateios necessários');
    end;

    descProd := 0;
    descServ := 0;
    acrescProd := 0;
    acrescServ := 0;
    if (dataSet.FieldByName('desconto').AsCurrency > 0) or
       (dataSet.FieldByName('desc_p_prod').AsFloat > 0) or
       (dataSet.FieldByName('desc_p_serv').AsFloat > 0) then
    begin
      if (vValorTotalProd + vValorTotalServ) > 0 then
      begin
        {
        descProd := (dataSet.FieldByName('desconto').AsCurrency / (vValorProdPermDesc + vValorTotalServ)) *
          vValorProdPermDesc;
        descServ := (dataSet.FieldByName('desconto').AsCurrency / (vValorProdPermDesc + vValorTotalServ)) *
          vValorTotalServ;
        }
        // abaixo estes valores são subtraidos pois estáo somados no campos nf_dc_vicmdeson dos itens que corresponde aos descontos aplicados na nota fiscal
        AimpostosDC := f_float('NF_DC_VICMDESON');
        AdescontoSemImpostos := f_float('desconto') - AimpostosDC;

        if (vValorProdPermDesc + vValorTotalServ > 0) then
        	descProd := RoundTo((AdescontoSemImpostos / (vValorProdPermDesc + vValorTotalServ)) * vValorProdPermDesc, -2);

        if descProd < 0 then
          raise Exception.Create('Total do desconto incorreto. Verifique novamente os valores de nota fiscal');

        //descProd := RoundTo((dataSet.FieldByName('desconto').AsCurrency / (vValorProdPermDesc + vValorTotalServ)) * vValorProdPermDesc, -2);
        //descServ := dataSet.FieldByName('desconto').AsFloat - descProd;
        descServ := AdescontoSemImpostos - descProd;
        descProd := descProd + RoundTo( dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc / 100, -2);
        descServ := descServ + RoundTo( dataSet.FieldByName('DESC_P_SERV').AsFloat * vValorTotalServ    / 100, -2);
      end;
    end;
    if (dataSet.FieldByName('acrescimo').AsCurrency > 0) or
       (dataSet.FieldByName('acresc_p_prod').AsFloat > 0) or
       (dataSet.FieldByName('acresc_p_serv').AsFloat > 0) then
    begin
      if (vValorTotalProd + vValorTotalServ) > 0 then
      begin
        {
        acrescProd := (dataSet.FieldByName('acrescimo').AsCurrency / (vValorTotalProd + vValorTotalServ))
          * vValorTotalProd;
        acrescServ := (dataSet.FieldByName('acrescimo').AsCurrency / (vValorTotalProd + vValorTotalServ))
          * vValorTotalServ;
        }
        // abaixo estes valores são subtraidos pois estáo somados no campos vl_desp_nf dos itens
        AimpostosAC := f_float('NF_AC_IPI') + f_float('NF_AC_ICMSST') + f_float('NF_AC_FCPST') + f_float('NF_AC_IMPOSTO_II') + f_float('NF_AC_VICMDESON');
        AacrescimoSemImpostos := f_float('acrescimo') - AimpostosAC;

        if (vValorTotalProd + vValorTotalServ > 0) then
        	acrescProd	 := RoundTo((AacrescimoSemImpostos / (vValorTotalProd + vValorTotalServ)) * vValorTotalProd, -2);

        if acrescProd < 0 then
          raise Exception.Create('Total do acréscimo incorreto. Verifique novamente os valores de nota fiscal');

        acrescServ := AacrescimoSemImpostos - acrescProd;
        acrescProd := acrescProd + RoundTo( dataSet.FieldByName('acresc_p_prod').AsFloat * vValorTotalProd / 100, -2);
        acrescServ := acrescServ + RoundTo( dataSet.FieldByName('acresc_p_serv').AsFloat * vValorTotalServ / 100, -2);
//          * vValorTotalServ;
      end;
    end;

    vSing.vValorRateioDesconto:=0;
    vSing.vValorRateioAcrescimo:=0;
    vSing.vValorDescontoIt:=0;
    vSing.vValorAcrescimoIt:=0;
    ASumDescProd := 0;
    ASumDescServ := 0;
    ASumAcreProd := 0;
    ASumAcreServ := 0;
    ASumDescItem := 0;
    ASumAcresItem := 0;
    vDescontoNoItemValor:=0;
    vDescontoNoItemPerc:=0;
    vTeste := 0;
    vItProd.dataSet.First;
    while not vItProd.dataSet.Eof do
    begin
      Application.ProcessMessages;
      vDadosIni.abreStatusProcessamento('', 'Efetuando Rateios necessários em Produtos ' + IntToStr( Trunc( vItProd.dataSet.RecNo / vItProd.dataSet.RecordCount * 100  ) ) + '%');
      vItProd.vProduto.buscaProduto(
        vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
        vItProd.dataSet.FieldByName('cod_prod').AsString);
      if (trim(vItProd.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
      begin
        vItProd.dataSet.Edit;
        if vItProd.ffloat('desc_item'  ) <= 0 then vItProd.fdata('desc_item').Put(0);
        if vItProd.ffloat('acresc_item') <= 0 then vItProd.fdata('acresc_item').Put(0);
        if vValorTotalProd > 0 then
          {
          vItProd.dataSet.FieldByName('rateio_acresc').AsCurrency := ((acrescProd +
            (dataSet.FieldByName('acresc_p_prod').AsCurrency * vValorTotalProd / 100)) *
            (vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency) / vValorTotalProd) + vItProd.dataSet.FieldByName('ACRESC_ITEM').AsCurrency
          }
          vItProd.dataSet.FieldByName('rateio_acresc').AsCurrency := RoundTo((acrescProd / vValorTotalProd * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('ACRESC_ITEM').AsFloat, -2)
        else
          vItProd.dataSet.FieldByName('rateio_acresc').AsCurrency := 0;
        vItProd.dataSet.FieldByName('rateio_acresc').AsFloat := vItProd.f_float('rateio_acresc') + vItProd.f_float('vl_desp_nf');

        ASumAcresItem := ASumAcresItem + vItProd.dataSet.FieldByName('ACRESC_ITEM').AsFloat;

//      if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
//        (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString <> 'S') and
//        (vItProd.dataSet.FieldByName('TABPRATICADA').AsString <> 'P') and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString <> 'T') then
        if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
          ((vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString <> 'S') or
          ((FSobreporPromocao) and (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S'))) and
          ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString <> 'P') or
          ((FSobreporPromocao) and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P'))) and
          ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString <> 'T') or
          ((FSobreporPrecTab) and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'T'))) and
          ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString <> 'Q') or
          ((FSobreporPrecQtde) and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q'))) then
        begin
          if vValorProdPermDesc > 0 then
          begin
            msgDescontos := 'Rateio de desconto maior que o valor total do item' + #13 + #13 +
            	'Rateio de desconto concedido de ' + format('%m', [RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('desc_item').AsFloat, -2)]) + #13 +
              'No item ' + vItProd.dataSet.FieldByName('nitem').asstring + ' - ' +
                trim(vItProd.dataSet.FieldByName('num_fab_prod').asstring) + ' - ' +
                format('%m', [vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency]);

          	vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('DESC_ITEM').AsFloat, -2);

          	if RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('desc_item').AsFloat, -2) > RoundTo(vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency, -2) then
            	raise Exception.Create(msgDescontos);
          end
          else
            vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := 0;

          if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='VALOR') then
            vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
          else if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='PERCENTUAL') then
            vDescontoNoItemPerc := vDescontoNoItemPerc + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency;
        end
        else if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
        	((vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S') or
        	(vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q']))) then
        begin
        	if vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsFloat > 0 then
          begin
            if vValorProdPermDesc > 0 then
            begin
            	msgDescontos := 'Rateio de desconto maior que o valor total do item' + #13 + #13 +
              	'Rateio de desconto concedido de ' + format('%m', [RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('desc_item').AsFloat, -2)]) + #13 +
              	'No item ' + vItProd.dataSet.FieldByName('nitem').asstring + ' - ' +
                trim(vItProd.dataSet.FieldByName('num_fab_prod').asstring) + ' - ' +
                format('%m', [vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency]);

            	vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('DESC_ITEM').AsFloat, -2);

            	if RoundTo((descProd / vValorProdPermDesc * vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat) + vItProd.dataSet.FieldByName('desc_item').AsFloat, -2) > RoundTo(vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency, -2) then
            		raise Exception.Create('Total do desconto incorreto. Verifique novamente os valores de nota fiscal');
            end
            else
              vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := 0;

          	if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='VALOR') then
              vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
            else if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='PERCENTUAL') then
              vDescontoNoItemPerc := vDescontoNoItemPerc + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency;
          end
          else
          begin
            vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := RoundTo(vItProd.dataSet.FieldByName('desc_item').AsCurrency,-2);

            if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='VALOR') then
              vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
            else if (vItProd.dataSet.FieldByName('tp_descacres').AsString='DESCONTO') and (vItProd.dataSet.FieldByName('nat_descacres').AsString ='PERCENTUAL') then
              vDescontoNoItemPerc := vDescontoNoItemPerc + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency;
          end;
        end
        else if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N')
          and ((vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S') or (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P'))
          and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S')
          and (vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais)) >=
               vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_ORIG').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais))) then
        begin
          vItProd.dataSet.FieldByName('rateio_desc').AsCurrency :=
            vDadosIni.StrToFloatFormat(
              (vItProd.dataSet.FieldByName('vlun_ped_item').AsFloat -
               vItProd.dataSet.FieldByName('vlun_orig').AsFloat) *
               vItProd.dataSet.FieldByName('quant_ped_item').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais));

          vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
        end
        else if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N')
          and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'T')
          and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S')
          and (vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais)) >=
               vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_ORIG').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais))) then
        begin
          vItProd.dataSet.FieldByName('rateio_desc').AsCurrency :=
            vDadosIni.StrToFloatFormat(
              (vItProd.dataSet.FieldByName('vlun_ped_item').AsFloat -
               vItProd.dataSet.FieldByName('vlun_orig').AsFloat) *
               vItProd.dataSet.FieldByName('quant_ped_item').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais));

          vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
        end
        else if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N')
          and (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q')
          and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S')
          and (vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais)) >=
               vDadosIni.StrToFloatFormat(vItProd.dataSet.FieldByName('VLUN_ORIG').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais))) then
        begin
          vItProd.dataSet.FieldByName('rateio_desc').AsCurrency :=
            vDadosIni.StrToFloatFormat(
              (vItProd.dataSet.FieldByName('vlun_ped_item').AsFloat -
               vItProd.dataSet.FieldByName('vlun_orig').AsFloat) *
               vItProd.dataSet.FieldByName('quant_ped_item').AsFloat, StrToInt(vItProd.vSing.vCasasDecimais));

          vDescontoNoItemValor := vDescontoNoItemValor + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency
        end
        else
          vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := 0;

        vItProd.dataSet.FieldByName('rateio_desc').AsFloat := vItProd.f_float('rateio_desc') + vItProd.f_float('nf_dc_despnf');

        vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat :=
        	RoundTo(vItProd.dataSet.FieldByName('rateio_acresc').AsFloat - vItProd.dataSet.FieldByName('acresc_item').AsFloat, -2);

        vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat   :=
        	RoundTo(vItProd.dataSet.FieldByName('rateio_desc').AsFloat - vItProd.dataSet.FieldByName('desc_item').AsFloat, -2);

        ASumDescItem := ASumDescItem + vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency;
        vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto + vItProd.dataSet.FieldByName('rateio_desc').AsCurrency,-2);//+vItProd.dataSet.FieldByName('desc_item').AsCurrency;
        vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + vItProd.dataSet.FieldByName('rateio_acresc').AsCurrency,-2);

        //////// metodo de calculo de comissao copiado no metodo verificaComissaoProdutos para otimizar o tempo de processamento
        if not pReabrindo then
        begin
          if (vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD').AsFloat > 0) then
          begin
            vItProd.dataSet.FieldByName('comiss_prod').AsCurrency := ((vItProd.getValorLiqParaMargem *
              vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) *
              vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD').AsFloat) / 100
          end
          else
          begin
            if ((vSing.vTipoVenda <> 'ORC') and ((vTeste = 0) or (vTeste = 1))) then
            begin
              vDadosIni.vInibeMensPesqPros := 'S';

              if not vDadosIni.PesqPros('VND158', 'VALIDAR',
              	dataSet.FieldByName('TIPO').AsString + ' - VERIFICAR PERC. DE COMISSAO NO CADASTRO DO PRODUTO', 'PEDVENDA',
              	dataSet.FieldByName('NPED').AsString, buscas, false) then
              begin
                if Application.MessageBox(pchar('Item Nº ' + vItProd.dataSet.FieldByName('NITEM').AsString +
                  ' - ' + QuotedStr(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString) + ' sem percentual de comissão, caso continue com esta operação a comissão deste produto não será calculada, Deseja continuar assim mesmo?'), 'Confirmação',
                  MB_ICONQUESTION + MB_YESNO) = IDNO then
                begin
                  vItProd.dataSet.Cancel;
                  result := false;
                  vDadosIni.fechaStatusProcessamento;
                  exit;
                end;

                if vTeste = 0 then
                begin
                  if Application.MessageBox(pchar('Exibir está mensagem novamente? '+#13 + #13+
                  ' Sim - O sistema realizará a verificação de comissão em cada item.'+#13+
                  ' Não - O sistema não realizará a verificação da comissão nos próximos itens.'), 'Confirmação',
                    MB_ICONQUESTION + MB_YESNO) = IDYES then
                    vTeste := 1
                  else
                    vTeste := 2
                end;

                if not vDadosIni.PesqPros('VND159', 'VALIDAR', dataSet.FieldByName('TIPO').AsString + ' - PERMITIR VENDA DE PRODUTO SEM PERC. DE COMISSAO', 'PEDVENDA',
                  dataSet.FieldByName('NPED').AsString, buscas, true) then
                begin
                  vItProd.dataSet.Cancel;
                  result := false;
                  vDadosIni.fechaStatusProcessamento;
                  exit;
                end;
              end;
            end;

            vItProd.dataSet.FieldByName('comiss_prod').AsCurrency := 0;
          end;
          if (vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD_Ger').AsFloat > 0) then
            vItProd.dataSet.FieldByName('comiss_prod_ger').AsCurrency := ((vItProd.getValorLiqParaMargem *
              vItProd.dataSet.FieldByName('quant_ped_item').AsFloat) *
              vItProd.vProduto.dataSet.FieldByName('COMISSAO_PROD_Ger').AsFloat) / 100
          else
            vItProd.dataSet.FieldByName('comiss_prod_ger').AsCurrency := 0;
        end;
        /// fim do metodo de calculo de comissao copiado
        ASumDescProd := ASumDescProd + vItProd.dataSet.FieldByName('rateio_desc').AsFloat;
        ASumAcreProd := ASumAcreProd + vItProd.dataSet.FieldByName('rateio_acresc').AsFloat;

        vItProd.dataSet.post;
      end;
      vItProd.dataSet.Next;
    end;

    // corrigindo caso o rateio de diferenca de centavos
    AdescProd := (descProd + AimpostosDC) + ASumDescItem;
    AacrescProd := (acrescProd + AimpostosAC) + ASumAcresItem;
    if (RoundTo(ASumDescProd, -2) <> RoundTo(AdescProd, -2)) or
       (RoundTo(ASumAcreProd, -2) <> RoundTo(AacrescProd, -2)) then
    begin
      try
        vItProd.dataSet.Filter := 'rateio_desc > 0';
        vItProd.dataSet.Filtered := True;

        if not vItProd.dataSet.IsEmpty then
        begin
        	vItProd.dataSet.First;
          while true do
          begin
            ALiq := RoundTo(vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat - vItProd.dataSet.FieldByName('rateio_desc').AsFloat, -2);
            if (RoundTo(ASumDescProd, -2) <> RoundTo(AdescProd, -2)) and
              (RoundTo(ALiq - (AdescProd - ASumDescProd), -2) >= 0) then
            begin
              vItProd.dataSet.Edit;

              if (RoundTo(AdescProd - ASumDescProd, -2) < 0)
                and (RoundTo(ASumDescProd - AdescProd, -2) >= vItProd.dataSet.FieldByName('rateio_desc').AsFloat) then
              begin
                vSing.vValorRateioDesconto := vSing.vValorRateioDesconto - vItProd.dataSet.FieldByName('rateio_desc').AsFloat;
                ASumDescProd := ASumDescProd - vItProd.dataSet.FieldByName('rateio_desc').AsFloat;

                vItProd.dataSet.FieldByName('rateio_desc').AsFloat := 0;

                vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat := 0;
              end
              else
              begin
                vItProd.dataSet.FieldByName('rateio_desc').AsFloat :=
                  vItProd.dataSet.FieldByName('rateio_desc').AsFloat + RoundTo(AdescProd - ASumDescProd, -2);

                vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat :=
                	vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat + RoundTo(AdescProd - ASumDescProd, -2);

                vSing.vValorRateioDesconto := vSing.vValorRateioDesconto + RoundTo(AdescProd - ASumDescProd, -2);
                ASumDescProd := AdescProd;
              end;

              vItProd.dataSet.Post;
            end;

            if (RoundTo(ASumDescProd, -2) = RoundTo(AdescProd, -2)) then
              Break;
          end;
        end;

        if vItProd.dataSet.IsEmpty then
        begin
          vItProd.filterClear;
          if not vItProd.dataSet.IsEmpty then
          begin
            vItProd.dataSet.First;

            vItProd.dataSet.Edit;
            vItProd.dataSet.FieldByName('rateio_desc').AsFloat :=
            	vItProd.dataSet.FieldByName('rateio_desc').AsFloat + RoundTo(AdescProd - ASumDescProd, -2);

            vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat :=
            	vItProd.dataSet.FieldByName('rateio_desc_temp').AsFloat + RoundTo(AdescProd - ASumDescProd, -2);

            vItProd.dataSet.Post;
            vSing.vValorRateioDesconto := vSing.vValorRateioDesconto + RoundTo(AdescProd - ASumDescProd, -2);
            ASumDescProd := AdescProd;
          end;
        end;

        vItProd.dataSet.Filter := 'rateio_acresc > 0';
        vItProd.dataSet.Filtered := True;

        if not vItProd.dataSet.IsEmpty then
        begin
          vItProd.dataSet.First;
          while true do
          begin
            if (RoundTo(ASumAcreProd, -2) <> RoundTo(AacrescProd, -2)) and
              (RoundTo(AacrescProd - ASumAcreProd, -2) <> 0) then
            begin
              vItProd.dataSet.Edit;

              if (RoundTo(AacrescProd - ASumAcreProd, -2) < 0)
                and (RoundTo(ASumAcreProd - AacrescProd, -2) >= vItProd.dataSet.FieldByName('rateio_acresc').AsFloat) then
              begin
                vSing.vValorRateioAcrescimo := vSing.vValorRateioAcrescimo - vItProd.dataSet.FieldByName('rateio_acresc').AsFloat;
                ASumAcreProd := ASumAcreProd - vItProd.dataSet.FieldByName('rateio_acresc').AsFloat;

                vItProd.dataSet.FieldByName('rateio_acresc').AsFloat := 0;

                vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat := 0;
              end
              else
              begin
                vItProd.dataSet.FieldByName('rateio_acresc').AsFloat :=
                  vItProd.dataSet.FieldByName('rateio_acresc').AsFloat + RoundTo(AacrescProd - ASumAcreProd, -2);

                vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat :=
                	vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat + RoundTo(AacrescProd - ASumAcreProd, -2);


                vSing.vValorRateioAcrescimo := vSing.vValorRateioAcrescimo + RoundTo(AacrescProd - ASumAcreProd, -2);
                ASumAcreProd := AacrescProd;
              end;

              vItProd.dataSet.Post;
            end;

            if (RoundTo(ASumAcreProd, -2) = RoundTo(AacrescProd, -2)) then
              Break;
          end;
        end;

        if vItProd.dataSet.IsEmpty then
        begin
          vItProd.filterClear;
          if not vItProd.dataSet.IsEmpty then
          begin
            vItProd.dataSet.First;

            vItProd.dataSet.Edit;
            vItProd.dataSet.FieldByName('rateio_acresc').AsFloat :=
            	vItProd.dataSet.FieldByName('rateio_acresc').AsFloat + RoundTo(AacrescProd - ASumAcreProd, -2);

            vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat :=
            	vItProd.dataSet.FieldByName('rateio_acresc_temp').AsFloat + RoundTo(AacrescProd - ASumAcreProd, -2);

            vItProd.dataSet.Post;
            vSing.vValorRateioAcrescimo := vSing.vValorRateioAcrescimo + RoundTo(AacrescProd - ASumAcreProd, -2);
            ASumAcreProd := AacrescProd;
          end;
        end;

      finally
        vItProd.dataSet.Filtered := False;
        vItProd.dataSet.Filter := '';
      end;
    end;

    if vSing.vTipoVenda <> 'REQ' then
    begin
      vItServ.dataSet.First;
      while not vItServ.dataSet.Eof do
      begin
        vDadosIni.abreStatusProcessamento('', 'Efetuando Rateios necessários em Serviços ' + IntToStr( Trunc( vItServ.dataSet.RecNo / vItServ.dataSet.RecordCount * 100  ) ) + '%');
        if (trim(vItServ.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
        begin
          vItServ.dataSet.Edit;
          if vValorTotalServ > 0 then
          begin
            {
            vItServ.dataSet.FieldByName('rateio_desc').AsCurrency := RoundTo((descServ +
              (dataSet.FieldByName('desc_p_serv').AsCurrency * vValorTotalServ / 100)) *
              (vItServ.dataSet.FieldByName('valor_tot_serv').AsCurrency) / vValorTotalServ + vItServ.dataSet.FieldByName('DESC_ITEM').AsCurrency,-2)
            }
            vItServ.dataSet.FieldByName('rateio_desc').AsCurrency :=
            	RoundTo((descServ / vValorTotalServ * vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat) + vItServ.dataSet.FieldByName('DESC_ITEM').AsFloat, -2);

          	vItServ.dataSet.FieldByName('rateio_desc_temp').AsFloat :=
            	RoundTo((descServ / vValorTotalServ * vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat), - 2);
          end
          else
          begin
          	vItServ.dataSet.FieldByName('rateio_desc').AsCurrency := 0;

            vItServ.dataSet.FieldByName('rateio_desc_temp').AsFloat := 0;
          end;

          if vValorTotalServ > 0 then
          begin
            {
            vItServ.dataSet.FieldByName('rateio_acresc').AsCurrency := RoundTo((acrescServ +
              (dataSet.FieldByName('acresc_p_serv').AsCurrency * vValorTotalServ / 100)) *
              (vItServ.dataSet.FieldByName('valor_tot_serv').AsCurrency) / vValorTotalServ + vItServ.dataSet.FieldByName('ACRESC_ITEM').AsCurrency,-2)
            }
            vItServ.dataSet.FieldByName('rateio_acresc').AsCurrency :=
            	RoundTo((acrescServ / vValorTotalServ * vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat) + vItServ.dataSet.FieldByName('ACRESC_ITEM').AsFloat, -2);

            vItServ.dataSet.FieldByName('rateio_acresc_temp').AsCurrency :=
            	RoundTo((acrescServ / vValorTotalServ * vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat), - 2);
          end
          else
          begin
            vItServ.dataSet.FieldByName('rateio_acresc').AsCurrency := 0;

            vItServ.dataSet.FieldByName('rateio_acresc_temp').AsCurrency := 0;
          end;
          vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto + vItServ.dataSet.FieldByName('rateio_desc').AsCurrency,-2);//-vItProd.dataSet.FieldByName('desc_item').AsCurrency;
          vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + vItServ.dataSet.FieldByName('rateio_acresc').AsCurrency,-2);

          ASumDescServ := ASumDescServ + vItServ.dataSet.FieldByName('rateio_desc').AsFloat;
          ASumAcreServ := ASumAcreServ + vItServ.dataSet.FieldByName('rateio_acresc').AsFloat;

          vItServ.dataSet.post;
        end;
        vItServ.dataSet.Next;
      end;

      // corrigindo caso o rateio de diferenca de centavos
      if (RoundTo(ASumDescServ, -2) <> RoundTo(descServ, -2)) or
         (RoundTo(ASumAcreServ, -2) <> RoundTo(acrescServ, -2)) then
      begin
        vItServ.dataSet.First;
        while not vItServ.dataSet.Eof do
        begin
          ALiq := RoundTo(vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat - vItServ.dataSet.FieldByName('rateio_desc').AsFloat, -2);
          if (RoundTo(ASumDescServ, -2) <> RoundTo(descServ, -2)) and
            (RoundTo(ALiq - (descServ - ASumDescServ), -2) >= 0) then
          begin
            vItServ.dataSet.Edit;
            vItServ.dataSet.FieldByName('rateio_desc').AsFloat :=
              vItServ.dataSet.FieldByName('rateio_desc').AsFloat + RoundTo(descServ - ASumDescServ, -2);

            vItServ.dataSet.FieldByName('rateio_desc_temp').AsFloat :=
              vItServ.dataSet.FieldByName('rateio_desc_temp').AsFloat + RoundTo(descServ - ASumDescServ, -2);

            vItServ.dataSet.Post;
            vSing.vValorRateioDesconto := vSing.vValorRateioDesconto + RoundTo(descServ - ASumDescServ, -2);
            ASumDescServ := descServ;
          end;

          if (RoundTo(ASumAcreServ, -2) <> RoundTo(acrescServ, -2)) and
            (RoundTo(acrescServ - ASumAcreServ, -2) <> 0) then
          begin
            vItServ.dataSet.Edit;
            vItServ.dataSet.FieldByName('rateio_acresc').AsFloat :=
              vItServ.dataSet.FieldByName('rateio_acresc').AsFloat + RoundTo(acrescServ - ASumAcreServ, -2);

            vItServ.dataSet.FieldByName('rateio_acresc_temp').AsFloat :=
              vItServ.dataSet.FieldByName('rateio_acresc_temp').AsFloat + RoundTo(acrescServ - ASumAcreServ, -2);

            vItServ.dataSet.Post;
            vSing.vValorRateioAcrescimo := vSing.vValorRateioAcrescimo + RoundTo(acrescServ - ASumAcreServ, -2);
            ASumAcreServ := acrescServ;
          end;
          if (RoundTo(ASumDescServ, -2) = RoundTo(descServ, -2)) and
             (RoundTo(ASumAcreServ, -2) = RoundTo(acrescServ, -2)) then
            Break;

          vItServ.dataSet.Next;
        end;
      end;

    end;
    vDadosIni.abreStatusProcessamento('', 'Efetuando Rateios necessários. Finalizando');
    //Ajusta o valor do rateio de desconto
    if (dataSet.FieldByName('DESC_P_SERV').AsCurrency = 0) and
      (dataSet.FieldByName('DESC_P_PROD').AsFloat = 0) and (vDescontoNoItemPerc=0) and
      (vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) <> (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor)) then
    begin
      vAjustaRateioDesc:=false;
      if vItServ.dataSet.Active then
      begin
        vItServ.dataset.First;
        while not vItServ.dataset.Eof do
        begin
          if vItServ.dataSet.FieldByName('rateio_desc').AsCurrency > 0 then
          begin
            if vItServ.dataSet.FieldByName('valor_tot_serv').AsCurrency > vItServ.dataSet.FieldByName('rateio_desc').AsCurrency then
            begin
              vItServ.dataSet.Edit;
              if (vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) > (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor)) then
              begin
                vItServ.dataSet.FieldByName('rateio_desc').AsCurrency :=
                	vItServ.dataSet.FieldByName('rateio_desc').AsCurrency - abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));

                vItServ.dataSet.FieldByName('rateio_desc_temp').AsCurrency :=
                	vItServ.dataSet.FieldByName('rateio_desc_temp').AsCurrency - abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));
              end
              else
              begin
              	vItServ.dataSet.FieldByName('rateio_desc').AsCurrency :=
                	vItServ.dataSet.FieldByName('rateio_desc').AsCurrency + abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));

                vItServ.dataSet.FieldByName('rateio_desc_temp').AsCurrency :=
                	vItServ.dataSet.FieldByName('rateio_desc_temp').AsCurrency + abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));
              end;

              vAjustaRateioDesc:=true;
              vItServ.dataSet.post;
              break;
            end;
          end;
          vItServ.dataset.Next;
        end;
      end;

      if not vAjustaRateioDesc then
      begin
        if vItProd.dataSet.Active then
        begin
          vItProd.dataSet.First;
          while not vItProd.dataSet.Eof do
          begin
            if vItProd.dataSet.FieldByName('rateio_desc').AsCurrency > 0 then
            begin
              if vItProd.dataSet.FieldByName('vltot_ped_item').AsCurrency > vItProd.dataSet.FieldByName('rateio_desc').AsCurrency then
              begin
                vItProd.dataSet.Edit;
                if (vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) > (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor)) then
                begin
                  vItProd.dataSet.FieldByName('rateio_desc').AsCurrency :=
                  	vItProd.dataSet.FieldByName('rateio_desc').AsCurrency - abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));

                  vItProd.dataSet.FieldByName('rateio_desc_temp').AsCurrency :=
                  	vItProd.dataSet.FieldByName('rateio_desc_temp').AsCurrency - abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));
                end
                else
                begin
                	vItProd.dataSet.FieldByName('rateio_desc').AsCurrency :=
                  	vItProd.dataSet.FieldByName('rateio_desc').AsCurrency + abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));

                  vItProd.dataSet.FieldByName('rateio_desc_temp').AsCurrency :=
                  	vItProd.dataSet.FieldByName('rateio_desc_temp').AsCurrency + abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor));
                end;
                vAjustaRateioDesc:=true;
                vItProd.dataSet.post;
                break;
              end;
            end;
            vItProd.dataSet.Next;
          end;
        end;
      end;
      if (vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) > (dataSet.FieldByName('DESCONTO').AsCurrency+ vDescontoNoItemValor)) then
        vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto - abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor)),-2)
      else
      	vSing.vValorRateioDesconto := Roundto(vSing.vValorRateioDesconto + abs(vDadosIni.StrToFloatFormat(vSing.vValorRateioDesconto, 2) - (dataSet.FieldByName('DESCONTO').AsCurrency + vDescontoNoItemValor)),-2);
    end;

    if dataSet.State in [dsinsert, dsEdit] then
    begin
      dataSet.FieldByName('valor_total').AsCurrency := {vDadosIni.StrToFloatFormat(}Roundto(vValorTotalProd + vValorTotalServ +
      vValorTotalProdTerc + vValorTotalServTerc + vSing.vValorRateioAcrescimo - vSing.vValorRateioDesconto, -2);
      if dataSet.State in [dsinsert, dsEdit] then
        dataSet.FieldByName('calc').AsString := 'S';
    end;

    if (f_str('SAVEAUTO') = 'S')
    	and (f_str('STATUS_PED') <> 'CANCELADO')
      and (f_int('nped') > 0) then
    begin
      if vItProd.dataSet.ChangeCount > 0 then
      	vItProd.Apply;

      if f_str('tipo') <> 'REQ' then
      begin
        if vItServ.dataSet.ChangeCount > 0 then
        	vItServ.Apply;
        if vItProdTerc.dataSet.ChangeCount > 0 then
        	vItProdTerc.Apply;
        if vItServTerc.dataSet.ChangeCount > 0 then
        	vItServTerc.Apply;
      end;
    end;

    vSing.vValorTotalLiq := dataSet.FieldByName('valor_total').AsCurrency;
    vSing.vValorTotalBruto := vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc;

  finally
    if (f_str('SAVEAUTO') = 'S') and (f_str('STATUS_PED') <> 'CANCELADO') then
      if (f_int('nped') = 0) then
        verificaSalvamentoAutomatico
      else
      begin
        Apend := False;
        if vItProd.dataSet.ChangeCount > 0 then
        begin
          vItProd.Apply;
          Apend := True;
        end;
        if f_str('tipo') <> 'REQ' then
        begin
          if vItServ.dataSet.ChangeCount > 0 then
          begin
            vItServ.Apply;
            Apend := True;
          end;
          if vItProdTerc.dataSet.ChangeCount > 0 then
          begin
            vItProdTerc.Apply;
            Apend := True;
          end;
          if vItServTerc.dataSet.ChangeCount > 0 then
          begin
            vItServTerc.Apply;
            Apend := True;
          end;
        end;
        if Apend then
          if setCalculoPendente then // dentro deste metodo ja tem um commit
          begin
          	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
            vItProd.abrePedVendaProd(f_int('nped'));
          end;
      end;
    vDadosIni.fechaStatusProcessamento;
    enableControlsDataSets;
  end;
end;

function TPedVenda.emitirNotaDoPedido(exibir_mens: boolean = True): Boolean;
var
  nf_emitir_from_pedvenda: Tnf_emitir_from_pedvenda;
  vemit_nf: string;

  function verificaemissaonf(vtipo: integer; Doc: string = 'Cupom'): boolean;
  var
   CNPJ,INSC: string;
  begin
    result:=true;
    CNPJ := retornaValor('SELECT CPFCGC AS VALOR FROM CLIENTES WHERE COD_CLIENTE = ' +
      dataSet.FieldByName('COD_CLIENTE').AsString + ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa);
    INSC := TRIM(retornaValor('SELECT INSC_EST AS VALOR FROM CLIENTES WHERE COD_CLIENTE = ' +
      dataSet.FieldByName('COD_CLIENTE').AsString + ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa));
    if vtipo = 2 then
    begin
      if (Length(CNPJ) > 11) //and
      //(INSC <> 'ISENTO')
      then
      if ShowConfirmacao(
        'Este cliente é Pessoa Jurídica, você pode emitir NF, tem certeza que deseja enviar este DAV para %s?',
        [Doc]) = IDNO then
        result:=false;
    end;
    if vtipo = 1 then
    begin
     if ((Length(CNPJ) <= 11) and (vDadosIni.vFiscalAtivo <> 'S'))
     or ((Length(CNPJ) <= 11) and (dataSet.FieldByName('NCUPOM').asinteger <> 0)) then
      Result:=true;
    end;
  end;
begin
	if (Trim(dataSet.FieldByName('tipo').AsString) = 'ORC') then
  begin
    vDadosIni.ShowAtencao('Nota Fiscal não permitida para orçamentos');
    Exit;
  end;

  if (Trim(dataSet.FieldByName('status_ped').AsString) <> 'FECHADA') then
  begin
    vDadosIni.ShowAtencao('Nota Fiscal não permitida para documento com status: ' +
                          vDadosIni.IfThen(Trim(dataSet.FieldByName('status_ped').AsString) = '',
                          	'ABERTO',
                            Trim(dataSet.FieldByName('status_ped').AsString)));
    Exit;
  end;

	if (Trim(dataSet.FieldByName('tipo').AsString) = 'OS') then
  begin
    if not vDadosIni.PesqPros('VND267', 'EMITIR NF', getTipoVenda, 'PEDVENDA',
      dataSet.FieldByName('NPED').AsString, buscas, true) then
    begin
      Application.MessageBox(Pchar('Emitir Nota Fiscal não é permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;
  end
  else
  begin
    if not vDadosIni.PesqPros('VND266', 'EMITIR NF', getTipoVenda, 'PEDVENDA',
      dataSet.FieldByName('NPED').AsString, buscas, true) then
    begin
      Application.MessageBox(Pchar('Emitir Nota Fiscal não é permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
      exit;
    end;
  end;

  buscas.close;
  buscas.sql.text := ' select nped, tipo, cod_empresa, status_ped from pedvenda ' +
    ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
    ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if (Trim(buscas.FieldByName('status_ped').AsString) <> 'FECHADA') then
  begin
    vDadosIni.ShowAtencao('Nota Fiscal não permitida para documento com status: ' +
                          vDadosIni.IfThen(Trim(buscas.FieldByName('status_ped').AsString) = '',
                          	'ABERTO',
                            Trim(buscas.FieldByName('status_ped').AsString)));
    Exit;
  end;

	buscas.close;
  buscas.sql.text := ' select em_nf, usprevenda, modelo_nf_serv from empresa ' +
  	' where cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ';
  buscas.Open;
  vemit_nf := buscas.FieldByName('EM_NF').AsString;;

  if exibir_mens then
  begin
    if (vemit_nf <> 'S')
      or (not verificaemissaonf(1))
      or (ShowConfirmacao('Deseja Emitir NF desta Venda?', MB_YESNO + MB_DEFBUTTON2) <> IDYES) then
        Exit;
  end
  else
  begin
    if (vemit_nf <> 'S')
      or (not verificaemissaonf(1)) then
        Exit;
  end;
  
  buscas.close;
  buscas.sql.text := ' select first 1 nped, tipo, ' +
  	' grupo_prod, cod_prod, nitem, cod_empresa, ' +
    ' cod_grade, codigo_nop, n_nf, serie from pedvenda_prod ' +
    ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
    ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ((n_nf is null) or (n_nf = 0)) ';
  buscas.Open;

  if buscas.IsEmpty then
  begin
  	Application.MessageBox(Pchar('Todos itens com Nota Fiscal emitida'), 'Atenção', MB_ICONWARNING + MB_OK);
    Exit;
  end;

  if not vDadosIni._mdiAberto('TfrmCadNF', 'O modulo de Nota Fiscal se encontra aberto') then
    exit;

  if vDadosIni.vNotaFiscal.AHandle = 0 then
    CarregaPacote('pkNF', vDadosIni.vNotaFiscal.AHandle);

  if vDadosIni.vNotaFiscal.AHandle = 0 then
  begin
    vDadosIni.ShowAtencao('Pacote Nota Fiscal não carregado');
    Exit;
  end;

  @nf_emitir_from_pedvenda := GetProcAddress(vDadosIni.vNotaFiscal.AHandle, PChar('nf_emitir_from_pedvenda'));
  if Assigned(nf_emitir_from_pedvenda) then
    nf_emitir_from_pedvenda(dataSet.FieldByName('nped').AsInteger,
    									 Trim(dataSet.FieldByName('tipo').AsString));
end;

procedure TPedVenda.enableControlsDataSets;

  procedure enableControlsDataSet(pDataSet: TClientDataSet);
  begin
    try
      if pDataSet <> nil then
        if pDataSet.ControlsDisabled then
          pDataSet.EnableControls;
    except
    end;
  end;

begin
  enableControlsDataSet(dataSet);
  enableControlsDataSet(vItProd.dataSet);
  enableControlsDataSet(vItServ.dataSet);
  enableControlsDataSet(vItProdTerc.dataSet);
  enableControlsDataSet(vItServTerc.dataSet);

  enableControlsDataSet(vItProd.dtSet);
  enableControlsDataSet(vItProd.dtSetIt);
  enableControlsDataSet(vItServ.dtSet);
  enableControlsDataSet(vItServ.dtSetIt);
end;

function TPedVenda.enviarBoletoPorEmail: boolean;
var
	vEmail: Boolean;
  vWhatsApp: Boolean;
  vTelegram: Boolean;
begin
   try
     Result := false;

     if dataSet.IsEmpty then
       exit;

     if not vDadosIni.PesqPros('VND232', 'ENVIAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
       dataSet.FieldByName('NPED').AsString, buscas, true) then
       	exit;

     buscas.Close;
     buscas.SQL.Text := ' select * from boletas ' +
       ' where num_nf_vnd = :num_nf_vnd ' +
       ' and tipo_emissao = :tipo_emissao ' + 
       ' and cod_empresa = :cod_empresa ';
     buscas.ParamByName('num_nf_vnd').AsInteger := dataSet.FieldByName('NPED').AsInteger;
     buscas.ParamByName('tipo_emissao').AsString := dataSet.FieldByName('TIPO').AsString;
     buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
     buscas.Open;

     if buscas.IsEmpty then
     begin
        if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
          Application.MessageBox(Pchar('Nenhum boleto encontrado para esta Ordem de Serviço'), 'Atenção', MB_ICONINFORMATION + MB_OK)
        else
          Application.MessageBox(Pchar('Nenhum boleto encontrado para esta Requisição'), 'Atenção', MB_ICONINFORMATION + MB_OK);
        exit;
     end;

     Result := vDadosIni.gerar_boletoNFOS(
       dataSet.FieldByName('NPED').AsInteger,
       0,
       dataSet.FieldByName('TIPO').AsString,
       dataSet.FieldByName('COD_CLIENTE').AsInteger,
       '',
       true,
       true,
       vDadosIni.retornaArrayAplicativo,
       vDadosIni.retornaArrayContato(dataSet.FieldByName('COD_CLIENTE').AsInteger, cBoleto),
       cBoleto,
       True,
       0
     );
     
     if Result then
        vDadosIni.GravaAuditoria('VND232', 'ENVIAR', 'SUCESSO - ' +
        '"'+dataSet.FieldByName('TIPO').AsString+'" ' + dataSet.FieldByName('NPED').AsString,
        'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
     else
        vDadosIni.GravaAuditoria('VND232', 'ENVIAR', 'FALHA - ' +
        '"'+dataSet.FieldByName('TIPO').AsString+'" ' + dataSet.FieldByName('NPED').AsString,
        'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);

   except on E: Exception do
    begin
      vDadosIni.GravaAuditoria('VND232', 'ENVIAR', 'FALHA', 'PEDVENDA', '', buscas);
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registraErro('function TPedVenda.enviarBoletoPorEmail. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.EnviarMensagemWhatsApp: boolean;
var
	vStringListMensagemVenda: TStringList;
  vStringListProd: TStringList;
  vStringListImg: TStringList;
  fTempProdutos: TClientDataSet;
  vValorDesconto: Double;
  vValorAcrescimo: Double;
  vImprimirDescAcresc: boolean;
  vDadosKentro: string;
begin
  try
    try
      Result := true;

      vImprimirDescAcresc := false;
      vDadosIni.vInibeMensPesqPros := 'S';
      if vDadosIni.PesqPros('VND196', 'IMPRIMIR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
        dataset.FieldByName('NPED').AsString, buscas, true) then
          vImprimirDescAcresc := true;

      vValorDesconto := 0;
      vValorAcrescimo := 0;

      fTempProdutos := TClientDataSet.Create(nil);
      fTempProdutos.Close;
      fTempProdutos.FieldDefs.Clear;
      fTempProdutos.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
      fTempProdutos.FieldDefs.Add('COD_PROD', ftString, 6, false);
      fTempProdutos.FieldDefs.Add('DESCR_PROD_PED', ftString, 75, false);
      fTempProdutos.FieldDefs.Add('LISTA_IMAGENS', ftMemo, 10, false);

      if fTempProdutos.Tag = 0 then
      try
        fTempProdutos.CreateDataSet;
        fTempProdutos.Tag := 1;
      except
      end;

      vStringListMensagemVenda := TStringList.Create;
      vStringListProd := TStringList.Create;
      vStringListImg := TStringList.Create;
      vStringListMensagemVenda.Clear;
      vStringListProd.Clear;
      vStringListImg.Clear;

      if trim(dataSet.FieldByName('TIPO').AsString) = 'REQ' then
        vStringListMensagemVenda.Add('VENDA DE PRODUTOS: *Nº ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + '*')
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
        vStringListMensagemVenda.Add('ORDEM DE SERVIÇO: *Nº ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + '*')
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
        vStringListMensagemVenda.Add('ORÇAMENTO: *Nº ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + '*');

  //    if trim(dataSet.FieldByName('STATUS_PED').AsString) = 'FECHADA' then
  //      vStringListMensagemVenda.Add('Situação: Fechada')
  //    else if trim(dataSet.FieldByName('STATUS_PED').AsString) = 'CANCELADO' then
  //      vStringListMensagemVenda.Add('Situação: Cancelada')
  //    else if trim(dataSet.FieldByName('STATUS_PED').AsString) = '' then
  //      vStringListMensagemVenda.Add('Situação: Aberta')
  //    else
  //      vStringListMensagemVenda.Add('Situação: ' + LowerCase(trim(dataSet.FieldByName('STATUS_PED').AsString)));

      vStringListMensagemVenda.Add('');
      //Produtos
      try
        vItProd.dataSet.DisableControls;
        vItProd.dataSet.First;
        while not vItProd.dataSet.Eof do
        begin
          if vItProd.dataSet.RecNo = 1 then
            vStringListMensagemVenda.Add('*PRODUTOS:*');

          try
            fTempProdutos.Filtered := false;
            fTempProdutos.Filter := 'grupo_prod = ' + IntToStr(vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
              ' and cod_prod = ' + QuotedStr(vItProd.dataSet.FieldByName('COD_PROD').AsString);
            fTempProdutos.Filtered := true;

            if fTempProdutos.IsEmpty then
            begin
              fTempProdutos.Insert;
              fTempProdutos.FieldByName('GRUPO_PROD').AsInteger := vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              fTempProdutos.FieldByName('COD_PROD').AsString := vItProd.dataSet.FieldByName('COD_PROD').AsString;
              fTempProdutos.FieldByName('DESCR_PROD_PED').AsString := Copy(trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString), 1, 75);

              buscas.Close;
              buscas.SQL.Text := ' select lista_imagens from produtos ' +
                ' where grupo_prod = :grupo_prod ' +
                ' and cod_prod = :cod_prod ' +
                ' and cod_empresa = :cod_empresa ';
              buscas.ParamByName('GRUPO_PROD').AsInteger := vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
              buscas.ParamByName('COD_PROD').AsString := vItProd.dataSet.FieldByName('COD_PROD').AsString;
              buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
              buscas.Open;

              if trim(buscas.FieldByName('LISTA_IMAGENS').AsString) <> '' then
                fTempProdutos.FieldByName('LISTA_IMAGENS').AsString := buscas.FieldByName('LISTA_IMAGENS').AsString;
              fTempProdutos.Post;
            end;
          finally
            fTempProdutos.Filtered := false;
          end;

          vValorDesconto := vValorDesconto + vItProd.dataSet.FieldByName('DESC_ITEM').AsFloat;
          vValorAcrescimo := vValorAcrescimo + vItProd.dataSet.FieldByName('ACRESC_ITEM').AsFloat;

          vStringListMensagemVenda.Add(
            'Item ' + vDadosIni.StrZero(vItProd.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
            '*' + trim(vItProd.dataSet.FieldByName('descr_prod_ped').AsString) + '*'
          );

          vStringListMensagemVenda.Add(
              'Quantidade: *' + Format('%0.2n', [
              Math.IfThen(vItProd.dataSet.FieldByName('quant_ped_item_conv').AsFloat > 0,
                vItProd.dataSet.FieldByName('quant_ped_item_conv').AsFloat,
                vItProd.dataSet.FieldByName('quant_ped_item').AsFloat)]) + '*'
          );

          if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
          begin
            vStringListMensagemVenda.Add(
              'Vl Unitário: *R$ ' + Format('%0.2n', [
              Math.IfThen(vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat > 0,
                vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat,
                vItProd.DataSet.FieldByName('vlun_ped_item').AsFloat)
              - (vItProd.DataSet.FieldByName('rateio_desc').AsFloat /
                  Math.IfThen(vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat > 0,
                    vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat,
                    vItProd.DataSet.FieldByName('vlun_ped_item').AsFloat))
              + (vItProd.DataSet.FieldByName('rateio_acresc').AsFloat /
                  Math.IfThen(vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat > 0,
                    vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat,
                    vItProd.DataSet.FieldByName('vlun_ped_item').AsFloat))]) + '*'
            );

            vStringListMensagemVenda.Add(
              'Vl Total: *R$ ' + Format('%0.2n', [
                                            vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat
                                            - vItProd.dataSet.FieldByName('rateio_desc').AsFloat
                                            + vItProd.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
            );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Desconto: *R$ ' + Format('%0.2n', [0.00]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Acréscimo: *R$ ' + Format('%0.2n', [0.00]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Vl Líquido: *R$ ' + Format('%0.2n', [
                                                 vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat
                                                 - vItProd.dataSet.FieldByName('rateio_desc').AsFloat
                                                 + vItProd.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
              );
          end
          else
          begin
            vStringListMensagemVenda.Add(
              'Vl Unitário: *R$ ' + Format('%0.2n', [
              Math.IfThen(vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat > 0,
                vItProd.DataSet.FieldByName('vlun_ped_item_conv').AsFloat,
                vItProd.DataSet.FieldByName('vlun_ped_item').AsFloat)]) + '*'
            );

            vStringListMensagemVenda.Add(
              'Vl Total: *R$ ' + Format('%0.2n', [vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat]) + '*'
            );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Desconto: *R$ ' + Format('%0.2n', [vItProd.dataSet.FieldByName('rateio_desc').AsFloat]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Acréscimo: *R$ ' + Format('%0.2n', [vItProd.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Vl Líquido: *R$ ' + Format('%0.2n', [
                                                 vItProd.dataSet.FieldByName('vltot_ped_item').AsFloat
                                                 - vItProd.dataSet.FieldByName('rateio_desc').AsFloat
                                                 + vItProd.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
              );
          end;

          vStringListMensagemVenda.Add('');

          vItProd.dataSet.Next;
        end;
      finally
        vItProd.dataSet.First;
        vItProd.dataSet.EnableControls;
      end;

      if (trim(dataSet.FieldByName('TIPO').AsString) = 'OS') or (trim(dataSet.FieldByName('TIPO').AsString) = 'ORC') then
      begin
        //Produtos Terceiro
        try
          vItProdTerc.dataSet.DisableControls;
          vItProdTerc.dataSet.First;
          while not vItProdTerc.dataSet.Eof do
          begin
            if (vItProd.dataSet.RecordCount = 0) and (vItProdTerc.dataSet.RecNo = 1) then
              vStringListMensagemVenda.Add('*PRODUTOS:*');

            vStringListMensagemVenda.Add(
              'Item ' + vDadosIni.StrZero(vItProd.dataSet.RecordCount + vItProdTerc.dataSet.RecNo, 3) + ' ' +
              '*' + trim(vItProdTerc.dataSet.FieldByName('descricao').AsString) + '*'
            );

            vStringListMensagemVenda.Add(
              'Quantidade: *' + Format('%0.2n', [vItProdTerc.dataSet.FieldByName('qtde').AsFloat]) + '*'
            );
            vStringListMensagemVenda.Add(
              'Vl Unitário: *' + Format('%0.2n', [
                                                  vItProdTerc.dataSet.FieldByName('vl_total').AsFloat /
                                                  vItProdTerc.dataSet.FieldByName('qtde').AsFloat]) + '*'
            );
            vStringListMensagemVenda.Add(
              'Vl Total: *R$ ' + Format('%0.2n', [vItProdTerc.dataSet.FieldByName('vl_total').AsFloat]) + '*'
            );
           if vImprimirDescAcresc then
             vStringListMensagemVenda.Add(
               'Desconto: *R$ ' + Format('%0.2n', [0.00]) + '*'
             );
           if vImprimirDescAcresc then
             vStringListMensagemVenda.Add(
               'Acréscimo: *R$ ' + Format('%0.2n', [0.00]) + '*'
             );
           if vImprimirDescAcresc then
             vStringListMensagemVenda.Add(
                'Vl Líquido: *R$ ' + Format('%0.2n', [vItProdTerc.dataSet.FieldByName('vl_total').AsFloat]) + '*'
             );

            vStringListMensagemVenda.Add('');

            vItProdTerc.dataSet.Next;
          end;
        finally
          vItProdTerc.dataSet.First;
          vItProdTerc.dataSet.EnableControls;
        end;

        //Serviços
        try
          vItServ.dataSet.DisableControls;
          vItServ.dataSet.First;
          while not vItServ.dataSet.Eof do
          begin
            if vItServ.dataSet.RecNo = 1 then
              vStringListMensagemVenda.Add('*SERVIÇOS:*');

            vStringListMensagemVenda.Add(
              'Item ' + vDadosIni.StrZero(vItServ.dataSet.FieldByName('nitem').AsInteger, 3) + ' ' +
              '*' + trim(vItServ.dataSet.FieldByName('desc_serv_ped').AsString) + '*'
            );

            vValorDesconto := vValorDesconto + vItServ.dataSet.FieldByName('DESC_ITEM').AsFloat;
            vValorAcrescimo := vValorAcrescimo + vItServ.dataSet.FieldByName('ACRESC_ITEM').AsFloat;

            vStringListMensagemVenda.Add(
              'Quantidade: *' + Format('%0.2n', [vItServ.dataSet.FieldByName('quant_serv_ped').AsFloat]) + '*'
            );

            if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
            begin
              vStringListMensagemVenda.Add(
                'Vl Unitário: *R$ ' + Format('%0.2n', [
                                                vItServ.dataSet.FieldByName('valor_un_serv').AsFloat
                                                - (vItServ.dataSet.FieldByName('rateio_desc').AsFloat / vItServ.dataSet.FieldByName('quant_serv_ped').AsFloat)
                                                + vItServ.dataSet.FieldByName('rateio_acresc').AsFloat / vItServ.dataSet.FieldByName('quant_serv_ped').AsFloat]) + '*'
              );

              vStringListMensagemVenda.Add(
                'Vl Total: *R$ ' + Format('%0.2n', [
                                                vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat
                                                - vItServ.dataSet.FieldByName('rateio_desc').AsFloat
                                                + vItServ.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
              );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Desconto: *R$ ' + Format('%0.2n', [0.00]) + '*'
                );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Acréscimo: *R$ ' + Format('%0.2n', [0.00]) + '*'
                );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Vl Líquido: *R$ ' + Format('%0.2n', [
                                                  vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat
                                                  - vItServ.dataSet.FieldByName('rateio_desc').AsFloat
                                                  + vItServ.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
                );
            end
            else
            begin
              vStringListMensagemVenda.Add(
                'Vl Unitário: *R$ ' + Format('%0.2n', [vItServ.dataSet.FieldByName('valor_un_serv').AsFloat]) + '*'
              );
              vStringListMensagemVenda.Add(
                'Vl Total: *R$ ' + Format('%0.2n', [vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat]) + '*'
              );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Desconto: *R$ ' + Format('%0.2n', [vItServ.dataSet.FieldByName('rateio_desc').AsFloat]) + '*'
                );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Acréscimo: *R$ ' + Format('%0.2n', [vItServ.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
                );
              if vImprimirDescAcresc then
                vStringListMensagemVenda.Add(
                  'Vl Líquido: *R$ ' + Format('%0.2n', [
                                                  vItServ.dataSet.FieldByName('valor_tot_serv').AsFloat
                                                  - vItServ.dataSet.FieldByName('rateio_desc').AsFloat
                                                  + vItServ.dataSet.FieldByName('rateio_acresc').AsFloat]) + '*'
                );
            end;

            vStringListMensagemVenda.Add('');

            vItServ.dataSet.Next;
          end;
        finally
          vItServ.dataSet.First;
          vItServ.dataSet.EnableControls;
        end;

        //Serviços Terceiro
        try
          vItServTerc.dataSet.DisableControls;
          vItServTerc.dataSet.First;
          while not vItServTerc.dataSet.Eof do
          begin
            if (vItServ.dataSet.RecordCount = 0) and (vItServTerc.dataSet.RecNo = 1) then
              vStringListMensagemVenda.Add('*SERVIÇOS:*');

            vStringListMensagemVenda.Add(
              'Item ' + vDadosIni.StrZero(vItServ.dataSet.RecordCount + vItServTerc.dataSet.RecNo, 3) + ' ' +
              '*' + trim(vItServTerc.dataSet.FieldByName('descr_servt').AsString) + '*'
            );
            vStringListMensagemVenda.Add(
              'Quantidade: *' + Format('%0.2n', [1.00]) + '*'
            );
            vStringListMensagemVenda.Add(
              'Vl Unitário: *R$ ' + Format('%0.2n', [vItServTerc.dataSet.FieldByName('vl_servt').AsFloat]) + '*'
            );
            vStringListMensagemVenda.Add(
              'Vl Total: *R$ ' + Format('%0.2n', [vItServTerc.dataSet.FieldByName('vl_servt').AsFloat]) + '*'
            );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Desconto: *R$ ' + Format('%0.2n', [0.00]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Acréscimo: *R$ ' + Format('%0.2n', [0.00]) + '*'
              );
            if vImprimirDescAcresc then
              vStringListMensagemVenda.Add(
                'Vl Líquido: *R$ ' + Format('%0.2n', [vItServTerc.dataSet.FieldByName('vl_servt').AsFloat]) + '*'
              );

            vStringListMensagemVenda.Add('');

            vItServTerc.dataSet.Next;
          end;
        finally
          vItServTerc.dataSet.First;
          vItServTerc.dataSet.EnableControls;
        end;
      end;

      vValorDesconto := vValorDesconto + dataSet.FieldByName('DESCONTO').AsFloat;
      vValorAcrescimo := vValorAcrescimo + dataSet.FieldByName('ACRESCIMO').AsFloat;

      //Totais
      vStringListMensagemVenda.Add('*TOTAIS:*');
      if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
      begin
        vStringListMensagemVenda.Add(
          'Valor Líquido: *R$ ' + Format('%0.2n', [dataSet.FieldByName('VALOR_TOTAL').AsFloat]) + '*'
        );
      end
      else
      begin
        if (vValorDesconto > 0) or (vValorAcrescimo > 0) then
          vStringListMensagemVenda.Add(
            'Valor Bruto: *R$ ' + Format('%0.2n', [
                                                  dataSet.FieldByName('TOT_PROD').AsFloat
                                                  + dataSet.FieldByName('TOT_SERV').AsFloat
                                                  + dataSet.FieldByName('TOT_PROD_TERC').AsFloat
                                                  + dataSet.FieldByName('TOT_SERV_TERC').AsFloat]) + '*'
          );
        if vValorDesconto > 0 then
          vStringListMensagemVenda.Add(
            'Desconto: *R$ ' + Format('%0.2n', [vValorDesconto]) + '*'
          );
        if vValorAcrescimo > 0 then
          vStringListMensagemVenda.Add(
            'Acréscimo: *R$ ' + Format('%0.2n', [vValorAcrescimo]) + '*'
          );
        vStringListMensagemVenda.Add(
          'Valor Líquido: *R$ ' + Format('%0.2n', [dataSet.FieldByName('VALOR_TOTAL').AsFloat]) + '*'
        );
      end;

      fTempProdutos.First;
      while not fTempProdutos.Eof do
      begin
        vStringListProd.Add(trim(fTempProdutos.FieldByName('DESCR_PROD_PED').AsString) + '¶');
        if trim(fTempProdutos.FieldByName('LISTA_IMAGENS').AsString) = '' then
          vStringListImg.Add('sem imagem' + '¶')
        else
          vStringListImg.Add(trim(fTempProdutos.FieldByName('LISTA_IMAGENS').AsString) + '¶');

        fTempProdutos.Next;
      end;
      fTempProdutos.First;

      vDadosKentro := vDadosIni.retornaDadosKentro(buscas);
      if trim(vDadosKentro) = '' then
        exit;

      if not kentro_enviar_mensagem(PChar(vDadosIni.vBancoHW),
        PChar(vDadosIni.getCampoPipe(trim(vDadosKentro), 1) + '|' +
              vDadosIni.getCampoPipe(trim(vDadosKentro), 2) + '|' +
              vDadosIni.getCampoPipe(trim(vDadosKentro), 3) + '|'),
        dataSet.FieldByName('NPED').AsInteger,
        PChar(dataSet.FieldByName('TIPO').AsString),
        StrToInt(vDadosIni.codEmpresa),
        trim(vStringListMensagemVenda.Text),
        trim(vStringListProd.Text),
        trim(vStringListImg.Text)) then
      begin
        Result := False;
        exit;
      end;
    except on E: Exception do
      begin
        Result := False;
        Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('function TPedVenda.EnviarMensagemWhatsApp. Erro: ' + e.Message);
      end;
    end;
  finally
    if Assigned(fTempProdutos) then
    	FreeAndNil(fTempProdutos);
  	if Assigned(vStringListMensagemVenda) then
    	FreeAndNil(vStringListMensagemVenda);
  	if Assigned(vStringListProd) then
    	FreeAndNil(vStringListProd);
  	if Assigned(vStringListImg) then
    	FreeAndNil(vStringListImg);
  end;
end;

procedure TPedVenda.enviarVendaParaCupom;
begin
	if (Trim(dataSet.FieldByName('tipo').AsString) = 'ORC') then
  begin
    vDadosIni.ShowAtencao('Cupom Fiscal não permitido para orçamentos');
    Exit;
  end;

  if (Trim(dataSet.FieldByName('status_ped').AsString) <> 'FECHADA') then
  begin
