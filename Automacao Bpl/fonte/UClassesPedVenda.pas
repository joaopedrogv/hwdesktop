{ TClientesPed_dest }

function TClientesPed_dest.abrir(Atodos: Boolean): Boolean;
var
  Acampos, Asql: string;
begin
  try
    dataSet.AfterScroll := nil;
  Acampos := TVw_clientes_dest_class.GetFieldsSql();
  Asql := Format('select %s from vw_clientes_dest' +
                 ' where cod_cliente = %d and cod_empresa = %s and dest_seqid = %d',
                 [Acampos, FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, FOwner.f_int('dest_seqid')]);
  if Atodos then
    Asql := Asql + Format(' union' +
                          ' select %s from vw_clientes_dest' +
                          ' where cod_cliente = %d and cod_empresa = %s and dest_seqid <> %d and ativo = 1',
                          [Acampos, FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, FOwner.f_int('dest_seqid')]);

    dataSet.Close;
    dataSet.CommandText := Asql;
    dataSet.Open;

  dataSet.AfterScroll := dataset_AfterScroll;
    Result :=  True;
  except on E: Exception do
    begin
      Result :=  False;
      registraErro('TClientesPed_dest.abrir. Etapa 1: ' + e.Message);
      {$REGION 'tratamento'}
      try
        dataSet.Close;
        if not Atodos then
          dataSet.CommandText := Format('select %s from vw_clientes_dest' +
                                        ' where cod_cliente = %d and cod_empresa = %s and dest_seqid = %d',
                                        [TVw_clientes_dest_class.GetFieldsSql(),
                                         FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, FOwner.f_int('dest_seqid')])
        else
          dataSet.CommandText := Format('select %s from vw_clientes_dest' +
                                        ' where cod_cliente = %d and cod_empresa = %s and dest_seqid = %d',
                                        [TVw_clientes_dest_class.GetFieldsSql(),
                                         FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, FOwner.f_int('dest_seqid')]) +
                                 Format(' union' +
                                        ' select %s from vw_clientes_dest' +
                                        ' where cod_cliente = %d and cod_empresa = %s and dest_seqid <> %d and ativo = 1',
                                        [TVw_clientes_dest_class.GetFieldsSql(),
                                         FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, FOwner.f_int('dest_seqid')]);
        dataSet.Open;
        dataSet.AfterScroll := dataset_AfterScroll;
        Result :=  False;
      except on E: Exception do
        begin
          registraErro('TClientesPed_dest.abrir. Etapa 2: ' + e.Message);
        end;
      end;
      {$ENDREGION}
    end;
  end;
end;

