      end
      else if (vSing.vTipoVenda = 'ORC') and (vSing.vVendaRapida) and (trim(vCondPagOrcamentoR) <> '') then
      begin
      	try
        	StrToInt(vCondPagOrcamentoR);
        except
          vCondPagOrcamentoR := '';
        end;

      	if trim(vCondPagOrcamentoR) <> '' then
          if trim(retornaValor(' select first 1 cond_pag.cod_cond_pag AS VALOR from cond_pag ' +
          	' inner join cond_pag_empresa on ' +
            ' 	cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
            '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
            ' where cond_pag.cod_cond_pag = ' + vCondPagOrcamentoR +
            ' and cond_pag.ativo = 1 ')) = '' then
              vCondPagOrcamentoR := '';
      end;

      if (vSing.vTipoVenda = 'REQ') and (not vSing.vVendaRapida) and (trim(vCondPagRequisicaoN) <> '') then
      	dataSet.FieldByName('COD_COND_PAG').AsString := vCondPagRequisicaoN
      else if (vSing.vTipoVenda = 'REQ') and (vSing.vVendaRapida) and (trim(vCondPagRequisicaoR) <> '') then
      	dataSet.FieldByName('COD_COND_PAG').AsString := vCondPagRequisicaoR
      else if (vSing.vTipoVenda = 'OS') and (trim(vCondPagOrdemServico) <> '') then
      	dataSet.FieldByName('COD_COND_PAG').AsString := vCondPagOrdemServico
      else if (vSing.vTipoVenda = 'ORC') and (not vSing.vVendaRapida) and (trim(vCondPagOrcamentoN) <> '') then
      	dataSet.FieldByName('COD_COND_PAG').AsString := vCondPagOrcamentoN
      else if (vSing.vTipoVenda = 'ORC') and (vSing.vVendaRapida) and (trim(vCondPagOrcamentoR) <> '') then
      	dataSet.FieldByName('COD_COND_PAG').AsString := vCondPagOrcamentoR
      else if (vSing.vVendaRapida) or (vSing.vTipoVenda = 'OS') then
      begin
        dataSet.FieldByName('COD_COND_PAG').AsString :=
          retornaValor('select cond_pag.cod_cond_pag AS VALOR from cond_pag ' +
          	' inner join cond_pag_empresa on ' +
            ' 	cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
            '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
          	' where cond_pag.desc_cond_pag like ''%IST%'' ' +
            ' and cond_pag.ativo = 1 ' +
            ' order by cond_pag.seqpreco ');
            
        if dataSet.FieldByName('COD_COND_PAG').AsString = '' then
          dataSet.FieldByName('COD_COND_PAG').AsString :=
            retornaValor('select first 1 cond_pag.cod_cond_pag AS VALOR from cond_pag ' +
            	' inner join cond_pag_empresa on ' +
              ' 	cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
              '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
            	' where cond_pag.ativo = 1 ');
      end;

      if (vSing.vVendaRapida) and (StrToIntDef(vDadosIni.vCliente.vCodClientePadrao, 0) > 0) then
      	dataSet.FieldByName('cod_cliente').AsInteger := StrToInt64Def(vDadosIni.vCliente.vCodClientePadrao, 0);

      dataSet.FieldByName('DATA_PED').AsDateTime := vDadosIni.getDataBanco(buscas);
			dataSet.FieldByName('METODO_ENTREGA').AsString := 'CARREGAMENTO PROPRIO';
			if Trim(dataSet.FieldByName('md5').AsString) = '' then
    		dataSet.FieldByName('md5').AsString := 'SISTEMA';
      if conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'Ativa', 'N', 'S') then
      begin
        {
        if vDadosIni.vUsarPlano[1] in ['S', '2'] then
          vDadosIni.ShowAtencao('Configuração de calcular tributos da nota não compatível com o uso do Plano de Pagamento')
        else
        }
        begin
        dataSet.FieldByName('nf_ac_calctrib').AsString := IfThen( conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'DefaultInclusao', 'N', 'S'), 'S', 'N');
        dataSet.FieldByName('nf_freteconta').AsString  := IfThen( conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'Ativa', 'N', 'S'),
                                                                  conf.valores_nf.ReadString('Conf_' + f_str('tipo'), 'FretePorConta', 'D'), 'D');
        dataSet.FieldByName('nf_cf_deson_emb').AsString := IfThen( conf.valores_nf.ConfActive('Conf_' + f_str('tipo'), 'ICMSDesoneradoEmbutido', 'N', 'S'), 'S', 'N');
      end;
      end;
      vStateVendaProd := 1;
      verificarSalvamentoAutomatico;
      if Assigned(Ffat_ped) then
      	FreeAndNil(Ffat_ped);
      Ffat_ped := TFaturamento_Group.create(Self);
    end
    else
    begin
      result := false;
      Application.MessageBox('Empresa não utiliza nota fiscal e não utiliza DAV.', 'Informação',
        MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    end;
  except
    on e: exception do
    begin
      Result := true;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

