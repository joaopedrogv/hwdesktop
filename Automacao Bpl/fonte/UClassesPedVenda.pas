        vItProd.dtSetIt.First;
        while not vItProd.dtSetIt.Eof do
        begin
          if (trim(vItProd.dtSetIt.FieldByName('STATUS').AsString) <> 'CANCELADO') then
          begin
            vstatusPED := retornaValor(' select status_ped as valor from pedvenda ' +
            	' where nped = ' + IntToStr(vItProd.dtSetIt.FieldByName('nped').AsInteger) +
              ' and tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').AsString)) +
              ' and cod_empresa = ' + vDadosIni.CodEmpresa +
              ' and ativo = 1 ');
            if vstatusPED = 'FECHADA' then
            begin
              if not VoltaEstoqueIndividual then
              begin
                RollBackTransacao;
                vItProd.dtSetIt.Close;
                vItProd.dtSetIt.Filtered := false;
                vItProd.dtSetIt.open;
                vItProd.dtSetIt.IndexFieldNames := 'NITEM';

                vItProd.dtSetIt.first;
                while not vItProd.dtSetIt.Eof do
                begin
	                vItProd.dtSetIt.edit;
		 	 	          vItProd.dtSetIt.FieldByName('STATUS').AsString := '';
    	            vItProd.dtSetIt.post;

      	          vItProd.dtSetIt.next;
                end;
                vItProd.dtSetIt.first;

                Result := False;
                exit;
              end;
