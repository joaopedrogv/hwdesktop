            ' where tipo=''ORC'' and ativo = 1 order by ordemexibicao');
      end;

//      if (vSing.vTipoVenda = 'OS')
//      	or (_habilitadoDataPrometida(vSing.vTipoVenda)) then
//      begin
        dataSet.FieldByName('DT_PROMETIDA').AsDateTime := DateOf(now);
        dataSet.FieldByName('H_PROMETIDA').value := now;
//      end;

