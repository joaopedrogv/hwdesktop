        if (not FDadosImpressao.vImpSelecionados) and (not FDadosImpressao.Imprimir2Vias) then
        begin
        	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if RdpDav.EstaAberto then', 'pedvenda');

          if RdpDav.EstaAberto then
          begin
          	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - RdpDav.Fechar;', 'pedvenda');

            RdpDav.Fechar;
          end;
        end;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - updateQtdeImpressao;', 'pedvenda');

        updateQtdeImpressao;
      finally
        vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
        vItProd.DevInternaReset;
        Fconf.exibir_devolucao_runtime := rescueExibirDev;
        enableControlsDataSets;
      end;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - ' + e.Message, 'pedvenda');
      end;
    end;
  finally
    if Assigned(vListaTmp) then
    	FreeAndNil(vListaTmp);
    if Assigned(vListaObs) then
      FreeAndNil(vListaObs);
    if Assigned(vInfoPlano) then
    	FreeAndNil(vInfoPlano);
    if Assigned(vQuery) then
    	FreeAndNil(vQuery);
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);

  	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - end', 'pedvenda');
  end;
end;

