    vSing.vValorRateioDesconto := 0;
    vSing.vValorRateioAcrescimo := 0;
    vSing.vValorDescontoIt := 0;
    vSing.vValorAcrescimoIt := 0;
    vSing.vValorTotalLiq := 0;
    vSing.vValorAcrescimoItServ := 0;
    vSing.vValorDescontoItServ := 0;
    vValorTotalProd := 0;
    vValorTotalServ:= 0;
    vValorTotalProdTerc:=0;
    vValorTotalServTerc:=0;

