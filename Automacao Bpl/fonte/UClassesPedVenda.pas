function TPedVenda.existeCFOP(CFOP: Double): boolean;
begin
  Result:= True;
  Exit;

  if CFOP = 0 then
  begin
    Result := false;
    Application.MessageBox('CFOP não informado.', 'Informação',
      MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    exit;
  end
  else
  begin
    if (COPY(FloatToStr(CFOP), 1, 1) <> '5') and (COPY(FloatToStr(CFOP), 1, 1) <> '6')
      and (COPY(FloatToStr(CFOP), 1, 1) <> '7') then
    begin
      Result := false;
      Application.MessageBox('CFOP inválido para venda. Deve iniciar em 5, 6 ou 7', 'Informação',
        MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      Exit;
    end;
  end;
  Result := ExecutaComandosSql('select * from nat_op where codigo_nop = ' + FloatToStr(CFOP));
  if not Result then
  begin
    Result := false;
    Application.MessageBox('CFOP não encontrado no cadastro ou não informado.', 'Informação',
      MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
  end
  else
    Result := true;
end;

