function TItensComissaoPorVenda.abreItensComissaoPorVenda(pNped: Integer;
  pTipo: string): boolean;
begin
   montaSelect(' select pp.nped, pp.tipo, pp.grupo_prod, pp.cod_prod, pp.nitem, pp.cod_empresa, pp.cod_grade, pp.codigo_nop, ' +
     ' pp.vltot_ped_item, pp.rateio_desc, pp.rateio_acresc, pp.status, ' +
     ' pp.cod_vendedor, pp.vl_comissao_vend, pp.perc_comissao_vend,  '+
     ' pp.cod_vendedor1, pp.vl_comissao_vend1, pp.perc_comissao_vend1 from pedvenda_prod pp ' +
     ' where pp.nped = ' + IntToStr(pNped) + ' and pp.tipo = ' + QuotedStr(pTipo) + ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
     ' and coalesce(pp.status, '''') <> ''CANCELADO'' ' +
     ' order by pp.nped, pp.tipo, pp.nitem ');
end;

