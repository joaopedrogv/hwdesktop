      vCodClienteExit        := 0;
      vCodVendedorExit       := 0;
      vCodCondPagExit        := 0;
      vTipoVExit             := '';
      vTipoOsExit            := '';
      vTipoOrcExit           := '';
      vPercComissaoVend3Exit := 0;

