            'PEDVENDA',	trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);
    end;

    //       else
    //        Cancel;
    vItProd.Close;
    if result then
      Refresh
    else
      CancelUpdates;
  except
    on e: exception do
    begin
      Result := false;
      CancelUpdates;
      vDadosIni.GravaAuditoria('VND098', 'ALTERAR', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.salvarDadosEnvioEC: Boolean;
var
  acao: string;
  codigo: string;
  Amsg: string;
begin
  try
    Result := false;

    codigo := dataSet.FieldByName('NPED').AsString;
    
    if not vDadosIni.PesqPros('VND249', 'SALVAR', 'REQ', 'PEDVENDA',
       codigo, buscas, true) then
      Exit;
            
    if vFormasEnvio.idsitped_ec_old <> f_int('IDSITPED_EC')  then
    begin
      Amsg := SqlOpen('select '' - Status alterado de '' ||' +
                      'coalesce((select codigo|| '' - ''|| status_ec from SIT_PEDIDO_EC where codigo = %d),0)' +
                      '||'' para ''||' +
                      'coalesce((select codigo|| '' - ''|| status_ec from SIT_PEDIDO_EC where codigo = %d),0)' +
                      ' as status from rdb$database', [vFormasEnvio.idsitped_ec_old, f_int('IDSITPED_EC')]).FieldByName('status').AsString;
    end
    else
      Amsg := '';

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if not dataSet.FieldByName('DATA_ENVIO_RAST').IsNull then
      if dataSet.FieldByName('DATA_ENVIO_RAST').AsDateTime > vDadosIni.getDataBanco(Buscas) then
        raiseExceptionCreate('Data de envio menor que a data atual, favor verificar!', 'DBEdit138');

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('VND249', acao, 'SUCESSO' + Amsg, 'PEDVENDA',
        codigo + ' - REQ', buscas)
    else
      vDadosIni.GravaAuditoria('VND249', acao, 'FALHA', 'PEDVENDA',
        codigo + ' - REQ', buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.SalvarDadosOSParaLivro: boolean;
var
  vValorTemp: Currency;
begin
  try
    result := false;
    if not (dataSet.State = dsEdit) then
      exit;
    if vDadosIni.PesqPros('VND094', 'ALTERAR O.S. PARA LIVRO', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
    begin
      vItServ.abrePedVendaServ(dataSet.FieldByName('NPED').AsInteger);
      vItServTerc.abreServicoTerceiro(dataSet.FieldByName('NPED').AsInteger);

      vValorTemp := 0;
      vItServ.dataSet.First;
      while not vItServ.dataSet.Eof do
      begin
        vValorTemp := vValorTemp + vItServ.dataSet.FieldByName('VALOR_TOT_SERV').AsFloat -
          vItServ.dataSet.FieldByName('RATEIO_DESC').AsFloat;
        vItServ.dataSet.Next;
      end;

      vItServTerc.dataSet.First;
      while not vItServTerc.dataSet.Eof do
      begin
        vValorTemp := vValorTemp + vItServTerc.dataSet.FieldByName('VL_SERVT').AsFloat;
        vItServTerc.dataSet.Next;
      end;

      if vDadosIni.StrToFloatFormat(dataSet.FieldByName('VALOR_NFEXT').AsFloat, 2) > vDadosIni.StrToFloatFormat(vValorTemp, 2) then
      begin
        if not vDadosIni.PesqPros('VND122', 'VALIDAR', dataSet.FieldByName('TIPO').AsString + ' - VALOR MAIOR ' +
          Format('%0.2f', [dataSet.FieldByName('VALOR_NFEXT').AsFloat]) + ' > ' +
          Format('%0.2f', [vValorTemp]), 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, True) then
          raiseExceptionCreate('Valor da NF informado maior que o valor dos serviços', '')
        else if Application.MessageBox(pchar('Valor da NF informado maior que o valor dos serviços. Deseja continuar mesmo assim?'),
          'Confirmação', MB_ICONQUESTION + MB_YESNO) <> IDYES then
        begin
          Result := False;
          Exit;
        end;
      end;

      result := inherited Post;
      if Result then
        result := Apply;
      if Result then
        result := CommitaTransacao;
      if Result then
        vDadosIni.GravaAuditoria('VND094', 'ALTERAR O.S. PARA LIVRO', dataSet.FieldByName('TIPO').AsString + ' - SUCESSO', 'PEDVENDA',
        	dataSet.FieldByName('NPED').AsString, buscas)
      else
        vDadosIni.GravaAuditoria('VND094', 'ALTERAR O.S. PARA LIVRO', dataSet.FieldByName('TIPO').AsString + ' - FALHA', 'PEDVENDA',
        	dataSet.FieldByName('NPED').AsString, buscas);
    end;
    if result then
      Refresh
    else
      CancelUpdates;
  except
    on e: exception do
    begin
      Result := false;
      //      CancelUpdates;
      vDadosIni.GravaAuditoria('VND094', 'ALTERAR O.S. PARA LIVRO', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.salvarImagensProd: boolean;
var
 ImageProd: TImage;
 b: TMemoryStream;
 vListaImgProd: TStringList;
 vDiretorioPadrao: string;
 vtemp: string;
 vDataCad: TDate;
begin
	Result := true;

  vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
  if vItProd.dataSet.IsEmpty then
  	exit;

  vDataCad := vDadosIni.getDataBanco(buscas);

  try
    vDiretorioPadrao := IncludeTrailingPathDelimiter(vDadosIni.getConfSisStr('prod_cad_diretorio_padrao_imagens', buscas));

    buscas.Close;
    buscas.SQL.Text := 'delete from fotos ' +
      ' where ' +
      vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'REQ',
      	' tipo = -1000 ',
        	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS',
          	' tipo = -1001', ' tipo = -1002 ')) +
      ' and cod_empresa=' + vDadosIni.codEmpresa +
      ' and data_cad <= current_date - 1 ';
    buscas.ExecSQL;
    
    buscas.Close;
    buscas.SQL.Text := 'delete from fotos ' +
      ' where codigo = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
      vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'REQ',
      	' and tipo = -1000 ',
        	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS',
          	' and tipo = -1001', ' and tipo = -1002 ')) +
      ' and cod_empresa=' + vDadosIni.codEmpresa;
    buscas.ExecSQL;

    try
      ImageProd := TImage.Create(nil);
      vListaImgProd := TStringList.Create;

      try
        vItProd.dataSet.DisableControls;
        vItProd.dataSet.First;
        while not vItProd.dataSet.eof do
        begin
          vListaImgProd.Clear;

          buscas.Close;
          buscas.SQL.Text := ' select first 1 lista_imagens from produtos_imagens ' +
            ' where grupo_prod = :grupo_prod ' +
            ' and cod_prod = :cod_prod ' +
            ' and cod_grade = :cod_grade ' +
            ' and cod_empresa = :cod_empresa ' +
            ' union ' +
            ' select first 1 lista_imagens from produtos_imagens ' +
            ' where grupo_prod = :grupo_prod ' +
            ' and cod_prod = :cod_prod ' +
            ' and cod_grade = 0 ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and (select count(*) from produtos_imagens ' +
            '      where grupo_prod = :grupo_prod ' +
            '      and cod_prod = :cod_prod ' +
            '      and cod_grade = :cod_grade ' +
            '      and cod_empresa = :cod_empresa) = 0 ' +
            ' union ' +
            ' select first 1 lista_imagens from produtos ' +
            ' where grupo_prod = :grupo_prod ' +
            ' and cod_prod = :cod_prod ' +
            ' and cod_empresa = :cod_empresa ' +
            ' and lista_imagens is not null ' +
            ' and (select count(*) from produtos_imagens ' +
            '      where grupo_prod = :grupo_prod ' +
            '      and cod_prod = :cod_prod ' +
            '      and cod_grade = :cod_grade ' +
            '      and cod_empresa = :cod_empresa) = 0 ' +
            ' and (select count(*) from produtos_imagens ' +
            '      where grupo_prod = :grupo_prod ' +
            '      and cod_prod = :cod_prod ' +
            '      and cod_grade = 0 ' +
            '      and cod_empresa = :cod_empresa) = 0 ';
          buscas.ParamByName('GRUPO_PROD').AsInteger := vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
          buscas.ParamByName('COD_PROD').AsString := vItProd.dataSet.FieldByName('COD_PROD').AsString;
          buscas.ParamByName('COD_GRADE').AsInteger := vItProd.dataSet.FieldByName('COD_GRADE').AsInteger;
          buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          buscas.Open;

          if not buscas.IsEmpty then
          begin
            vListaImgProd.Text := trim(buscas.FieldByName('LISTA_IMAGENS').AsString);

            if trim(vDiretorioPadraoImg) = '' then
              vtemp := vListaImgProd[0]
            else if vDadosIni.strIn(Copy(vListaImgProd[0], 2, 1), ['\', ':']) then
              vtemp := vListaImgProd[0]
            else
              vtemp := vDiretorioPadraoImg + vListaImgProd[0];

            if vListaImgProd.Count > 0 then
            begin
              if FileExists(vtemp) then
              begin
                ImageProd.Picture.LoadFromFile(vtemp);
                b := TMemoryStream.Create;
                ImageProd.Picture.Graphic.SaveToStream(b);

                if ExecutaComandosSql('select grupo_prod, cod_prod, cod_empresa from fotos ' +
                  ' where codigo = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
                  vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'REQ',
                    ' and tipo = -1000 ',
                      vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS',
                        ' and tipo = -1001', ' and tipo = -1002 ')) +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa +
                  ' and grupo_prod = ' + IntToStr(vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger) +
                  ' and cod_prod = ' + QuotedStr(vItProd.dataSet.FieldByName('COD_PROD').AsString) +
                  ' and cod_grade = ' + IntToStr(vItProd.dataSet.FieldByName('COD_GRADE').AsInteger)) then
                begin
                  buscas.Close;
                  buscas.SQL.Text := ' update fotos set foto = :foto, data_cad = :data_cad ' +
                    ' where codigo = :codigo ' +
                    ' and tipo = :tipo ' +
                    ' and cod_empresa = :cod_empresa ' +
                    ' and grupo_prod = :grupo_prod ' +
                    ' and cod_prod = :cod_prod ' +
                    ' and cod_grade = :cod_grade ';
                  buscas.ParamByName('codigo').AsInteger := dataSet.FieldByName('NPED').AsInteger;
                  if trim(dataSet.FieldByName('TIPO').AsString) = 'REQ' then
                    buscas.ParamByName('tipo').AsInteger := -1000
                  else if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
                    buscas.ParamByName('tipo').AsInteger := -1001
                  else
                    buscas.ParamByName('tipo').AsInteger := -1002;
                  buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
                  buscas.ParamByName('grupo_prod').AsInteger := vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
                  buscas.ParamByName('cod_prod').AsString := vItProd.dataSet.FieldByName('COD_PROD').AsString;
                  buscas.ParamByName('cod_grade').AsInteger := vItProd.dataSet.FieldByName('COD_GRADE').AsInteger;
                  buscas.ParamByName('foto').LoadFromStream(b, ftBlob);
                  buscas.ParamByName('data_cad').AsDateTime := vDataCad;
                  buscas.ExecSQL;
                end
                else
                begin
                  buscas.Close;
                  buscas.SQL.Text := ' insert into fotos' +
                    ' (codigo, tipo, cod_empresa, foto, extensao, nitem, descricao, grupo_prod, cod_prod, cod_grade, data_cad) ' +
                    ' values (:codigo, :tipo, :cod_empresa, :foto, :extensao, :nitem, :descricao, :grupo_prod, :cod_prod, :cod_grade, :data_cad);';
                  buscas.ParamByName('codigo').AsInteger := dataSet.FieldByName('NPED').AsInteger;
                  if trim(dataSet.FieldByName('TIPO').AsString) = 'REQ' then
                    buscas.ParamByName('tipo').AsInteger := -1000
                  else if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
                    buscas.ParamByName('tipo').AsInteger := -1001
                  else
                    buscas.ParamByName('tipo').AsInteger := -1002;
                  buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
                  buscas.ParamByName('foto').LoadFromStream(b, ftBlob);
                  buscas.ParamByName('extensao').AsString := 'jpg';
                  buscas.ParamByName('nitem').AsInteger := vItProd.dataSet.RecNo;
                  buscas.ParamByName('descricao').AsString := Copy(trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString), 1, 30);
                  buscas.ParamByName('grupo_prod').AsInteger := vItProd.dataSet.FieldByName('GRUPO_PROD').AsInteger;
                  buscas.ParamByName('cod_prod').AsString := vItProd.dataSet.FieldByName('COD_PROD').AsString;
                  buscas.ParamByName('cod_grade').AsInteger := vItProd.dataSet.FieldByName('COD_GRADE').AsInteger;
                  buscas.ParamByName('data_cad').AsDateTime := vDataCad;
                  buscas.ExecSQL;
                end;
              end;
            end;
          end;

          vItProd.dataSet.Next;
        end;
      finally
        vItProd.dataSet.First;
        vItProd.dataSet.EnableControls;
      end;

      if buscas.Transaction.InTransaction then
        buscas.Transaction.Commit;
        
    finally
    	if ImageProd <> nil then
        ImageProd.Destroy;
      if b <> nil then
        b.Destroy;
      if Assigned(vListaImgProd) then
      	FreeAndNil(vListaImgProd);
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda.salvarKmVeiculo: boolean;
var
	temp: string;
begin
  Result := true;

  if (trim(dataSet.FieldByName('TIPO').AsString) <> 'OS') then
  	exit;

 	if vDadosIni.vEmp.vUsarAparelho = 'S' then
  	exit;

  if (dataSet.FieldByName('COD_VEICULO').AsInteger > 0)
 	 and (dataSet.FieldByName('CHASSI').AsString <> '') and (dataSet.FieldByName('PLACA').AsString <> '') then
    temp := ' WHERE PLACA = ' + QuotedStr(dataSet.FieldByName('PLACA').AsString) +
        ' AND CHASSI = ' + QuotedStr(dataSet.FieldByName('CHASSI').AsString) +
        ' AND CODIGO = ' + IntToStr(dataSet.FieldByName('COD_VEICULO').AsInteger)
  else if (dataSet.FieldByName('COD_VEICULO').AsInteger > 0) then
    temp := ' WHERE CODIGO = ' + IntToStr(dataSet.FieldByName('COD_VEICULO').AsInteger)
  else if (dataSet.FieldByName('CHASSI').AsString = '') then
    temp := ' WHERE CHASSI = ' + QuotedStr(dataSet.FieldByName('CHASSI').AsString)
  else if (dataSet.FieldByName('PLACA').AsString = '') then
  	temp := ' WHERE PLACA = ' + QuotedStr(dataSet.FieldByName('PLACA').AsString);

  buscas.Close;
  buscas.SQL.Text := ' UPDATE VEICULOS SET KM_V = ' + IntToStr(dataSet.FieldByName('KM_V').AsInteger) +
  	temp + ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
  buscas.ExecSQL;
end;

function TPedVenda.salvaTransfDev(pDevolucao:boolean=false): boolean;
var
  grupo, codigo, cfop: string;
  nPed: integer;
  stado: TDataSetState;
begin
	Result := false;
  if verificaFechamento(1) then
  begin
    Application.MessageBox('Venda sendo Fechada neste momento.', 'Informação', MB_OK + MB_ICONINFORMATION);
    Result := False;
    exit;
  end;
//  transfDev := 'SIM';
  if dataSet.State = dsBrowse then
    dataSet.Edit;
//  Result := post;
//  transfDev := 'NAO';

  try
    try
      if not vItProd.vProduto.validaEstoqueFechamento then
        exit;
      arredondar;
      calculaTotais;
      if not efetuaRateios then
        Exit;
      if not pDevolucao then
        if not vItProd.validaMargemLucro then
        begin
          dataSet.Cancel;
          exit;
        end;
//      if not verificarDescontos then
//      begin
//        Result := False;
//        Exit;
//      end;

//      if vDadosIni.vEmp.vUsarMarkUpMinimo then
//        if not validarMarkUp then
//        begin
//          Result := false;
//          Exit;
//        end;

      {
      Agora o calculo da comissao é feito no metodo de rateio
      //Definindo comissao nos produtos.
      if (vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2') then
        if not verificaComissaoProdutos then
          exit;
      }

      //Gravando a venda no banco de dados
      stado := dataSet.State;

      nPed := dataSet.FieldByName('nped').AsInteger;

      // Atualizar Lembrete Agenda Oficina
      atualizarLembreteAgenda(nPed, 'ABERTA');
      //Grava histórico do veículo
      GravarHistEstMoto('ABERTA');
      //Apagar contas a pagar
      apagarContasPagar(nped);

      dataSet.Post;

      if Apply then
      begin
        if not CommitaTransacao then
        begin
          raise exception.create('Erro na gravação d' + vSing.nomeVenda + ' número ' +
            dataSet.FieldByName('nped').AsString);
        end
        else
          abrePedVenda(nPed);
        if vItProd.Apply then
          vItProd.Refresh
        else
        begin
          result := false;
          dataSet.edit;
          exit;
        end;
        if vSing.vTipoVenda <> 'REQ' then
        begin
          vItServ.Apply;
          vItServ.dataSet.Refresh;
          vItProdTerc.Apply;
          vItProdTerc.dataSet.Refresh;
          vItServTerc.Apply;
          vItServTerc.dataSet.Refresh;
        end;
        if not CommitaTransacao then
        begin
          raise exception.create('Erro na gravação d' + vSing.nomeVenda + ' número ' +
            dataSet.FieldByName('nped').AsString);
        end;
        vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
        vItProd.abrePedVendaProd(nPed);
        if (vSing.vTipoVenda <> 'REQ') then
        begin
          vItServ.abrePedVendaServ(nPed);
          vItProdTerc.abreProdTerceiro(nPed);
          vItServTerc.abreServicoTerceiro(nPed);
        end;

//        if (vSing.vTipoVenda = 'OS') and (vSing.vNum_CredenciamentoInterventor <> '') then
//          vAtestado.confirmarAtestado(dataSet.FieldByName('nped').AsInteger,
//            dataSet.FieldByName('cod_equip').AsInteger);
      end;

      Result := true;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        vDadosIni.GravaAuditoria('VND046', 'SALVAR PEDIDO', 'Erro: ' + e.Message, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        registraErro('VND046' + e.Message);
      end;
    end;
  finally
    if Result then
    begin
      //      vItProd.QuestionarBaixaGrade := false;
      vMD5Func._gravaMD5_DAV(buscas, dataSet.FieldByName('nprevenda').AsInteger);
      vItProd.dataSet.DisableControls;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
				vMD5Func._gravaMD5_Produtos(buscas,
          vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
          vItProd.dataSet.FieldByName('cod_prod').AsString);
        vItProd.dataSet.Next;
      end;
      vItProd.dataSet.EnableControls;
      if vDadosIni.vZerarDescontoItem = 'S' then
      begin
        vItProd.descontoP := 0;
        vItProd.descontoV := 0;
        vItProd.descontoVini := 0;
        vItProd.acrescimoP := 0;
        vItProd.acrescimoV := 0;
      end;
      dataSet.Refresh;
    end;
  end;

end;

function TPedVenda.selecionaDAVsParaMesclagem(pNPED: integer): boolean;
var
  i: integer;
begin
  result := false;
  if isempty then
    exit;
  if not validaDAVParaMesclagem(pNPED) then
    exit;

  VerificarCriarDatasetDAVsParaMesclagem;

  if not dtSetOrcTemp.Active then
    dtSetOrcTemp.Open;
  if not dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([dataset.FieldByName('NPED').AsInteger, trim(dataset.FieldByName('TIPO').AsString), dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
  begin
    dtSetOrcTemp.Insert;
    for i := 0 to dataSet.Fields.Count - 1 do
    begin
      dtSetOrcTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
      dtSetOrcTemp.FieldByName(dataSet.Fields[I].FieldName).DisplayLabel := dataSet.Fields[I].DisplayLabel;
    end;
    dtSetOrcTemp.Post;
    if vSing.vTipoVenda = 'REQ' then
      Application.MessageBox(Pchar('Requisição de venda ' + dataset.FieldByName('NPED').AsString + ' selecionada com sucesso.'), 'Atenção', +MB_ICONINFORMATION + MB_OK)
    else if vSing.vTipoVenda = 'OS' then
      Application.MessageBox(Pchar('Ordem de Serviço ' + dataset.FieldByName('NPED').AsString + ' selecionada com sucesso.'), 'Atenção', +MB_ICONINFORMATION + MB_OK);
  end
  else
  begin
    if vSing.vTipoVenda = 'REQ' then
      Application.MessageBox(Pchar('Requisição de venda ' + dataset.FieldByName('NPED').AsString + ' já se encontra selecionada.'), 'Atenção', +MB_ICONINFORMATION + MB_OK)
    else if vSing.vTipoVenda = 'OS' then
      Application.MessageBox(Pchar('Ordem de Serviço ' + dataset.FieldByName('NPED').AsString + ' já se encontra selecionada.'), 'Atenção', +MB_ICONINFORMATION + MB_OK);
  end;
  result := true;
end;

function TPedVenda.selecionaOrcParaTransferir(pNPED, pDAV: integer): boolean;
var
  i: integer;
begin
  result := false;
  if isempty then
    exit;
  try
    if dataSet.FieldByName('paf_num_prevenda').AsInteger > 0 then
      vDadosIni.abreStatusProcessamento('', 'Selecionando PreVenda para mesclagem. Aguarde!!')
    else if dataSet.FieldByName('nprevenda').AsInteger > 0 then
      vDadosIni.abreStatusProcessamento('', 'Selecionando DAV para mesclagem. Aguarde!!')
    else
      vDadosIni.abreStatusProcessamento('', 'Selecionando Orçamento para mesclagem. Aguarde!!');

    if dataset.FieldByName('STATUS_PED').AsString = 'CANCELADO' then
    begin
       Application.MessageBox(Pchar('O orçamento de número: '+inttostr(pNPED)+ ' que você está tentanto selecionar para mesclar está cancelado.'),'Atenção', +MB_ICONWARNING + MB_OK);
       if dtSetOrcTemp <> nil then
         if dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([dataset.FieldByName('NPED').AsInteger, dataset.FieldByName('TIPO').AsString, dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
           dtSetOrcTemp.delete;		 
       Exit;
    end;
    
    buscas.close;
    buscas.sql.text:= 'select first 1 pp.dav_origem,pp.tipo from pedvenda_prod pp where pp.dav_origem = ' + IntToStr(pDAV) +
      ' and pp.cod_empresa = ' + vDadosIni.codEmpresa + ' union '+
      ' select first 1 ps.dav_origem,ps.tipo from pedvenda_serv ps where ps.dav_origem = ' + IntToStr(pDAV) + 
      ' and ps.cod_empresa = ' + vDadosIni.codEmpresa + ' union '+
      ' select first 1 v.nped,v.tipo from pedvenda v where v.cod_orcamento = ' + inttostr(pNPED) + ' and v.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.open; 
    if not buscas.isempty then
    begin
      Application.MessageBox(Pchar('Já existe Ordem de Serviço ou Requisição para o orçamento ' + inttostr(pNPED)), 'Atenção', +MB_ICONWARNING + MB_OK);
      if (vDadosIni.vConfigImportOrcam = '1') or (vDadosIni.vConfigImportOrcam = 'U') then
        Exit;
    end;
    if dtSetOrcTemp = nil then
    begin
      dtSetOrcTemp := TClientDataSet.Create(nil);//DtmPed.cdsTransfOrcTemp);
      dtSetOrcTemp.Close;
      dtSetOrcTemp.FieldDefs.Clear;
      dtSetOrcTemp.FieldDefs.Add('SEL', ftString, 1, false);
      for I := 0 to dataset.FieldDefs.Count - 1 do
      	if (dataSet.FieldDefs[i].Name <> 'SEL') then
	        dtSetOrcTemp.FieldDefs.Add(dataSet.FieldDefs[i].Name,dataSet.FieldDefs[i].DataType,dataSet.FieldDefs[i].Size,false);
      dtSetOrcTemp.close;
      dtSetOrcTemp.CreateDataSet;
      dtSetOrcTemp.FieldByName('SEL').DisplayLabel := 'Sel';
      FDsOrcTemp := TDataSource.Create(nil);
      FDsOrcTemp.DataSet:=dtSetOrcTemp;
      dtSetOrcTemp.FieldByName('SEL').Index:=0;
    end;
    if not dtSetOrcTemp.Active then
    begin
      dtSetOrcTemp.Close;
      dtSetOrcTemp.CommandText := dataSet.CommandText;
      dtSetOrcTemp.Open;
    end;
    if not dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([dataset.FieldByName('NPED').AsInteger, dataset.FieldByName('TIPO').AsString, dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
    begin
      dtSetOrcTemp.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
      begin
        dtSetOrcTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
        dtSetOrcTemp.FieldByName(dataSet.Fields[I].FieldName).DisplayLabel := dataSet.Fields[I].DisplayLabel;
      end;
      dtSetOrcTemp.Post;
      Application.MessageBox(Pchar('Orçamento ' + dataset.FieldByName('NPED').AsString + ' selecionado com sucesso.'), 'Atenção', +MB_ICONINFORMATION + MB_OK);
    end
    else
      Application.MessageBox(Pchar('Orçamento ' + dataset.FieldByName('NPED').AsString + ' já se encontra selecionado.'), 'Atenção', +MB_ICONINFORMATION + MB_OK);
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
  result := true;
end;

