procedure TGradeProdEstPed.atualizaRegistros;
begin
  vQtdeConfirmada := 0;
  if frmBaixaGrade <> nil then
    frmBaixaGrade.lbDisponivel.Caption := FloatToStr(DataSet.FieldByName('Qtde').AsFloat -
      DataSet.FieldByName('QtdeItem').AsFloat);
  vGradeVenda.dtSet.First;
  while not vGradeVenda.dtSet.Eof do
  begin
    if (DataSet.FieldByName('cod_grade').AsInteger =
      vGradeVenda.dtSet.FieldByName('cod_grade').AsInteger) and
      (DataSet.FieldByName('grupo_prod').AsInteger =
      vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
      (trim(DataSet.FieldByName('cod_prod').AsString) =
      trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) then
    begin
      DataSet.Edit;
      DataSet.FieldByName('QtdeItem').AsFloat := vGradeVenda.dtSet.FieldByName('qtde').AsFloat;
      frmBaixaGrade.lbDisponivel.Caption := FloatToStr(DataSet.FieldByName('Qtde').AsFloat -
        DataSet.FieldByName('QtdeItem').AsFloat);
      DataSet.Post;
    end;
    if (DataSet.FieldByName('grupo_prod').AsInteger =
      vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
      (trim(DataSet.FieldByName('cod_prod').AsString) =
      trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) then
    begin
      vQtdeConfirmada := vQtdeConfirmada + vGradeVenda.dtSet.FieldByName('Qtde').AsFloat;
    end;
    vGradeVenda.dtSet.Next;
  end;
  vQtdePendente := qtdeItem - vQtdeConfirmada;
  if frmBaixaGrade <> nil then
  begin
    frmBaixaGrade.lbPendente.Caption := FloatToStr(vQtdePendente);
    frmBaixaGrade.lbConfirmado.Caption := FloatToStr(vQtdeConfirmada);
  end;
end;

