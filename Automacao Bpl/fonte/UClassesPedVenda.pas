function TPedVendaProd.abrePedVendaProd(nPed: integer; pTipo: string; pMesclar: boolean): boolean;
var
  i: integer;
begin
  if vListarImprimirItemCancConsignado then
    result := montaSelect(' select * from pedvenda_prod ' +
      ' where nped = ' + inttostr(nPed) +
      ' and tipo = ' + QuotedStr(trim(pTipo)) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ativo = 1')
  else if vListarNaoImprimirItemCanc then
  	result := montaSelect(' select * from pedvenda_prod ' +
      ' where nped = ' + inttostr(nPed) +
      ' and tipo = ' + QuotedStr(trim(pTipo)) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and coalesce(status,'''') <> ''CANCELADO'' ' +
      ' and ativo = 1 ' +
      ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
      ' and coalesce(status,'''') = ''CANCELADO'')')
  else if vListarImprimirItemVan then
  	result := montaSelect(' select * from pedvenda_prod ' +
      ' where nped = ' + inttostr(nPed) +
      ' and tipo = ' + QuotedStr(trim(pTipo)) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and coalesce(status,'''') <> ''CANCELADO'' ' +
      ' and ativo = 1 ' +
      ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
      ' and coalesce(status,'''') = ''CANCELADO'')')
  else
    result := montaSelect(' select * from pedvenda_prod ' +
      ' where nped = ' + inttostr(nPed) +
      ' and tipo = ' + QuotedStr(trim(pTipo)) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ativo = 1 ' +
      ' and not(coalesce(quant_ped_item,0) = coalesce(quant_item_dev,0) ' +
      ' and coalesce(status,'''') = ''CANCELADO'')');

  if not dtSetIt.Active then
    dtSetIt.open;
  if not DataSet.ControlsDisabled then
    DataSet.DisableControls;

  DataSet.First;
  while not DataSet.Eof do
  begin
    if pMesclar then
    begin
      FOwner.dtSetItVndTemp.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
        FOwner.dtSetItVndTemp.FieldByName(dataSet.Fields[I].FieldName).Value :=
          dataSet.Fields[I].Value;
      FOwner.dtSetItVndTemp.Post;
    end
    else
    begin
      if not dtSetIt.Locate('NPED;NITEM;TIPO;COD_EMPRESA',
      	VarArrayOf([dataset.FieldByName('NPED').AsInteger,
        						dataset.FieldByName('NITEM').AsInteger,
                    trim(dataset.FieldByName('TIPO').AsString),
                    dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
      begin
        dtSetIt.Insert;
        for i := 0 to dataSet.Fields.Count - 1 do
          dtSetIt.FieldByName(dataSet.Fields[I].FieldName).Value :=
            dataSet.Fields[I].Value;

        if (trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) = '' then
        	dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4)
        else if (UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) then
        	dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4)
        else if (dataSet.FieldByName('OPERACAO_CONV').AsString = 'M') and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
          dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat * dataSet.FieldByName('FATOR_CONV').AsFloat, - 4)
        else if (dataSet.FieldByName('OPERACAO_CONV').AsString = 'D') and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0) then
          dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat / dataSet.FieldByName('FATOR_CONV').AsFloat, - 4)
        else
        	dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);

        dtSetIt.FieldByName('QTDAMESCLAR').AsFloat := RoundTo(dataSet.FieldByName('QUANT_PED_ITEM').AsFloat, - 4);

        dtSetIt.Post;
      end;
    end;
    DataSet.Next;
  end;

  DataSet.First;
  while not DataSet.Eof do
  begin
  	dataSet.Edit;

  	dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat := RoundTo(
    	dataSet.FieldByName('RATEIO_ACRESC').AsFloat - dataSet.FieldByName('ACRESC_ITEM').AsFloat, - 2);

  	dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat := RoundTo(
	   	dataSet.FieldByName('RATEIO_DESC').AsFloat - dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

    dataSet.FieldByName('USAR_DEBCRED').AsString :=
      IfThen(dataSet.FieldByName('USAR_DEBCRED').AsString = 'N',
        'N', 'S');

    dataSet.Post;

    dataSet.Next;
	end;

  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;
  if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') then
    vTipServ.abreTipoServico(dataSet.FieldByName('NPED').AsInteger, dataSet.FieldByName('TIPO').AsString)
  else if (vDadosIni.vEmp.vSegmentaProdVenda <> 'S1') then
    vTipServ.abreTipoServico;
end;

