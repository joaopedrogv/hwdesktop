          end;
        end;

        if (Trim(vItProd.dataSet.FieldByName('TABPRATICADA').AsString) = 'N')
        	and (Trim(vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString) = 'VALOR') then
	      begin
  				vItProd.dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(Valor_acrescitemTemp,2);
          vItProd.dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(Valor_descItemtemp,2);
        end
        else
        begin
          vItProd.dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(Perc_acrescitemTemp * vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency,2);
          if not (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
            vItProd.dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(Perc_descItemtemp * vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency,2);
          if (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
            vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := vItProd.dataSet.FieldByName('desc_item').AsCurrency;
        end;
        vItProd.dataSet.Post;

        vItProd.dataSet.Next;
      end;

      //    calculaTotais;
      calculaDescontoAcrescimo;
      Result := true;

    except
      on e: exception do
      begin
        Result := False;
        Application.MessageBox(pchar('Erro ao recalcular preço. Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('procedure recalcularPrecoItensPelaCondicaoPagamento Erro: ' + e.Message)
      end;
    end;
  finally
    if (f_str('SAVEAUTO') = 'S') and (f_str('STATUS_PED') <> 'CANCELADO') then
      if (f_int('nped') = 0) then
        verificaSalvamentoAutomatico
      else if Avalor_total <> f_float('valor_total') then
      begin
        if vItProd.dataSet.ChangeCount > 0 then
          vItProd.Apply;
        if setCalculoPendente then // dentro deste metodo ja tem um commit
        begin
        	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
          vItProd.abrePedVendaProd(f_int('nped'));
        end;
      end;
    vItProd.dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVenda.recebendoOuRecebidoCaixaAuxiliar(pReabertura: Boolean): boolean;
var
  vTmpOP: Integer;
  vTmpDia: TDate;
  vTmpStatus: string;
begin
  Result := True;
  buscas.Close;
  buscas.SQL.Text := 'select op_cxl, dia_cxl, status_cxl_rq from pedvenda' +
    ' where nped = ' + dataset.FieldByName('nped').AsString +
    ' and tipo = ' + QuotedStr(dataset.FieldByName('tipo').AsString) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa;
  buscas.Open;
  vTmpOP := buscas.FieldByName('op_cxl').AsInteger;
  vTmpDia := DateOf(buscas.FieldByName('dia_cxl').AsDateTime);
  vTmpStatus := buscas.FieldByName('status_cxl_rq').AsString;

  if vTmpOP > 0 then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select OP_CXL, STATUS_CXL from FECD_CXL' +
      ' where OP_CXL = ' + IntToStr(vTmpOP) +
      ' and DIA_F_CXL = :DIA_F_CXL' +
      ' and CODIGO_EMP = ' + vDadosIni.codEmpresa;
    buscas.ParamByName('DIA_F_CXL').AsDate := vTmpDia;
    buscas.Open;
    if (Trim(buscas.FieldByName('STATUS_CXL').AsString) = 'FECHADO') or (buscas.IsEmpty) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select nome_vendedor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(vTmpOP) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      Application.MessageBox(PChar('Venda com recebimento no Caixa Auxiliar' + #13 +
        'Dia movimento: ' + FormatDateTime('dd/mm/yyyy', vTmpDia) + #13 +
        'Operador: ' + IntToStr(vTmpOP) + ' - ' + buscas.FieldByName('nome_vendedor').AsString),
        'Atenção', MB_ICONEXCLAMATION + MB_OK);
//      if pReabertura then
//        Exit;

      if not vDadosIni.PesqPros('VND088', 'LIBERAR', dataSet.FieldByName('TIPO').asstring, 'PEDVENDA', dataSet.FieldByName('NPED').asstring, buscas, true) then
        exit;
      if Application.MessageBox(pchar('Deseja continuar a reabrir a venda?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDNO then
        Exit;
      Result := False;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := 'select nome_vendedor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(vTmpOP) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      Application.MessageBox(PChar('Venda com recebimento no Caixa Auxiliar' + #13 +
        'Dia do movimento aberto: ' + FormatDateTime('dd/mm/yyyy', vTmpDia) + #13 +
        'Operador: ' + IntToStr(vTmpOP) + ' - ' + buscas.FieldByName('nome_vendedor').AsString + #13 + #13 +
        'Peça ao operador para cancelar primeiro o recebimento'), 'Erro', MB_ICONERROR + MB_OK);
      Exit;
    end;
  end
  else
    Result := False;
//  Result := not ExecutaComandosSql('select nped,op_cxl from pedvenda where nped = ' +
//    dataSet.FieldByName('nped').AsString + ' and tipo = ' + quotedStr(
//    dataSet.FieldByName('tipo').AsString) + ' and (op_cxl is null or op_cxl = 0 or op_cxl = ' +
//    IntToStr(vDadosIni.vCodOpCxl) + ') and COD_EMPRESA = ' + vDadosIni.codEmpresa +
//    ' AND ATIVO = 1');
end;

