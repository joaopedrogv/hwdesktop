{ TComissaoPorVendaCons }

function TComissaoPorVendaCons.abreComissaoPorVenda(pDataIni, pDataFim: string; pRazaoSocial: Boolean; pFechada: Boolean; pAberta: Boolean): boolean;
var
  vSql, vOrdem: string;
begin
 vOrdem := '10, 1';
 if pRazaoSocial then
   vOrdem := '11, 1';

  vSql := 'select pv.nped, pv.tipo, pv.data_ped, pv.data_fech, pv.cod_empresa, pv.cod_cliente, ' +
    ' pv.tot_prod, pv.valor_total, pv.status_ped, pv.obs_cxl_rq, pv.tipv, pv.autorizado_financeiro, ' +
    ' pv.idmobile, pv.npedmob, pv.aprovada_gerente, ' +
    ' c.nome_cliente, c.razao, ' + //c.cidade,
    ' coalesce((select cidade from sp_clientes_dest(pv.cod_cliente, pv.cod_empresa,  pv.dest_seqid, null, null) spe), '''') cidade, ' +
    ' c.limite_credito, case when rtrim(tf.status_f) = ''BARRADO'' then ''Sim'' else ''Não'' end barrado, c.cpfcgc, ' +
    ' cp.desc_cond_pag, ' +
    ' pv.cod_vendedor, col.nome_vendedor, ' +
    ' pv.cod_vendedor1, part.nome_participante, ' +
    ' cl.nome_ctrl, ' +
    ' coalesce(pv.vl_comissao_vend, 0) vl_comissao_vend, ' +
    ' coalesce(pv.perc_comissao_vend, 0) perc_comissao_vend, ' +
    ' coalesce(pv.vl_comissao_vend1, 0) vl_comissao_vend1, ' +
    ' coalesce(pv.perc_comissao_vend1, 0) perc_comissao_vend1, ' +
    ' coalesce((select sum(coalesce(pp.pcust_c, 0)) from pedvenda_prod pp ' +
    '   where pp.nped = pv.nped and pp.tipo = pv.tipo and pp.cod_empresa = pv.cod_empresa ' +
    '   and (coalesce(pp.status,'''') <> ''CANCELADO'')), 0) custo_total, ' +
    '  (pv.valor_total - coalesce((select sum(coalesce(pp.pcust_c, 0)) from pedvenda_prod pp ' +
    '  where pp.nped = pv.nped and pp.tipo = pv.tipo and pp.cod_empresa = pv.cod_empresa ' +
    '  and (coalesce(pp.status,'''') <> ''CANCELADO'')), 0)) lucro ' +
    ' from pedvenda pv ' +
    ' inner join clientes c on c.cod_cliente = pv.cod_cliente and c.cod_empresa = pv.cod_empresa ' +
    ' inner join tipo_vendas tv on tv.sigla = pv.tipv and tv.tipo = pv.tipo ' +
    ' inner join cond_pag cp on cp.cod_cond_pag = pv.cod_cond_pag ' +
    ' left join controles cl on cl.codigo_ctrl = pv.cod_controle and cl.codigo_emp = pv.cod_empresa ' +
    ' left join colaborador col on col.cod_vendedor = pv.cod_vendedor and col.cod_empresa = pv.cod_empresa ' +
    ' left join participante part on part.cod_participante = pv.cod_vendedor1 and part.cod_empresa = pv.cod_empresa ' +
    ' left join tipo_faturamento tf on tf.codigo_faturamento = c.codigo_faturamento ' +
    ' where tv.venda = ''S'' ' +
    ' and pv.tipo = ''REQ'' and pv.data_ped >= :dataIni and pv.data_ped <= :dataFim ' +
    ' and pv.cod_empresa = ' + vDadosIni.codEmpresa;

   if (pFechada <> pAberta) then
   begin
     if pFechada then
       vSql := vSql + ' and coalesce(pv.status_ped,'''') = ''FECHADA'''
     else
       vSql := vSql + ' and coalesce(pv.status_ped,'''') = ''''';
   end
   else
     vSql := vSql + ' and coalesce(pv.status_ped,'''') <> ''CANCELADO''';
   vSql := vSql + ' order by ' + vOrdem;

  montaSelect(vSql, StrToDate(pDataIni), StrToDate(pDataFim));
end;

