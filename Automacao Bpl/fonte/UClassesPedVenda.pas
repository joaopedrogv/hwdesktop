function TGradeProdEstPed.fechamentoGrades(venda: TPedVendaProd; baixar: boolean): boolean;
begin
  try
    vGradeVenda.abreGradesEst(venda.dataSet.FieldByName('nped').AsInteger,
      venda.dataSet.FieldByName('tipo').AsString);
    venda.First;
    while not venda.dataSet.Eof do
    begin
      //21/07/2011 não mais usar COD_GRADE_PROD_VENDA pois já tem a grade nos itens da venda
      if (venda.dataSet.FieldByName('cod_grade').AsInteger <> 0) and (trim(venda.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
      begin
        vBxGradeEstoque.close;
        vBxGradeEstoque.ParamByName('vgrupo').AsInteger :=
          Venda.dataset.Fieldbyname('GRUPO_PROD').AsInteger;
        vBxGradeEstoque.ParamByName('vcod_prod').AsString :=
          Venda.dataSet.Fieldbyname('COD_PROD').AsString;
        vBxGradeEstoque.ParamByName('vcod_grade').AsInteger :=
          Venda.dataSet.Fieldbyname('cod_grade').AsInteger;
        vBxGradeEstoque.ParamByName('quant').AsFloat :=
          Venda.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
        vBxGradeEstoque.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.CodEmpresa);
        vBxGradeEstoque.Prepare;
        vBxGradeEstoque.ExecProc;
      end;
      venda.Next;
    end;
    //    vGradeVenda.Apply;
    result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro ao dar baixa na grade do produto Grupo-Código: ' +
        venda.dataSet.FieldByName('grupo_prod').AsString + '-' +
        venda.dataSet.FieldByName('cod_prod').AsString +
        'Grade : ' + venda.dataSet.FieldByName('cod_grade').AsString + #13 + 'Erro: ' +
        e.Message), 'Erro', MB_OK + MB_ICONERROR);
      registraErro(e.Message);
    end;
  end;
end;

function TGradeProdEstPed.getQtdePendente(itVenda: TPedVendaProd): double;
begin
  vQtdeConfirmada := 0;
  vGradeVenda.dtSet.First;
  while not vGradeVenda.dtSet.Eof do
  begin
    if (DataSet.FieldByName('grupo_prod').AsInteger =
      vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
      (trim(DataSet.FieldByName('cod_prod').AsString) =
      trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) and
      (DataSet.FieldByName('cod_grade').AsInteger =
      vGradeVenda.dtSet.FieldByName('cod_grade').AsInteger) then
      vQtdeConfirmada := vQtdeConfirmada + vGradeVenda.dtSet.FieldByName('Qtde').AsFloat;
    vGradeVenda.dtSet.Next;
  end;
  vQtdePendente := qtdeItem - vQtdeConfirmada;
  if vQtdeConfirmada > itVenda.dataSet.FieldByName('quant_ped_item').AsFloat then
  begin
    vGradeVenda.dtSet.First;
    while not vGradeVenda.dtSet.Eof do
    begin
      if (DataSet.FieldByName('grupo_prod').AsInteger =
        vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
        (trim(DataSet.FieldByName('cod_prod').AsString) =
        trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) and
        (DataSet.FieldByName('cod_grade').AsInteger =
        vGradeVenda.dtSet.FieldByName('cod_grade').AsInteger) then
        vGradeVenda.dtSet.Delete
      else
        vGradeVenda.dtSet.Next;
    end;
  end;
  result := vQtdePendente;
end;

procedure TGradeProdEstPed.GradePedAfterScroll(DataSet: TDataSet);
begin
  vQtdeConfirmada := 0;
  if frmBaixaGrade <> nil then
    frmBaixaGrade.lbDisponivel.Caption := FloatToStr(DataSet.FieldByName('Qtde').AsFloat -
      DataSet.FieldByName('QtdeItem').AsFloat);
  vGradeVenda.dtSet.First;
  while not vGradeVenda.dtSet.Eof do
  begin
    if (DataSet.FieldByName('cod_grade').AsInteger =
      vGradeVenda.dtSet.FieldByName('cod_grade').AsInteger) and
      (DataSet.FieldByName('grupo_prod').AsInteger =
      vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
      (trim(DataSet.FieldByName('cod_prod').AsString) =
      trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) then
    begin
      DataSet.Edit;
      DataSet.FieldByName('QtdeItem').AsFloat := vGradeVenda.dtSet.FieldByName('qtde').AsFloat;
      if frmBaixaGrade <> nil then
        frmBaixaGrade.lbDisponivel.Caption := FloatToStr(DataSet.FieldByName('Qtde').AsFloat -
          DataSet.FieldByName('QtdeItem').AsFloat);
      DataSet.Post;
    end;
    if (DataSet.FieldByName('grupo_prod').AsInteger =
      vGradeVenda.dtSet.FieldByName('grupo_prod').AsInteger) and
      (trim(DataSet.FieldByName('cod_prod').AsString) =
      trim(vGradeVenda.dtSet.FieldByName('cod_prod').AsString)) then
    begin
      vQtdeConfirmada := vQtdeConfirmada + vGradeVenda.dtSet.FieldByName('Qtde').AsFloat;
    end;
    vGradeVenda.dtSet.Next;
  end;
  vQtdePendente := qtdeItem - vQtdeConfirmada;
  if frmBaixaGrade <> nil then
  begin
    frmBaixaGrade.lbPendente.Caption := FloatToStr(vQtdePendente);
    frmBaixaGrade.lbConfirmado.Caption := FloatToStr(vQtdeConfirmada);
  end;
end;

procedure TGradeProdEstPed.iniciaGrades(venda: TPedVendaProd);
begin
  dataSet.AfterScroll := nil;
  venda.First;
  while not venda.dataSet.Eof do
  begin
    vGradeVenda.abreGradeEst(venda.dataSet.FieldByName('nped').AsInteger,
      venda.dataSet.FieldByName('grupo_prod').AsInteger, venda.dataSet.FieldByName('cod_grade').AsInteger,
      venda.dataSet.FieldByName('cod_prod').AsString, venda.dataSet.FieldByName('tipo').AsString);
    if not vGradeVenda.dataSet.IsEmpty then
      vGradeVenda.insert(vGradeVenda.dataSet.FieldByName('nreq').AsInteger,
        vGradeVenda.dataSet.FieldByName('grupo_prod').AsInteger,
        vGradeVenda.dataSet.FieldByName('cod_grade').AsInteger,
        vGradeVenda.dataSet.FieldByName('cod_prod').AsString,
        vGradeVenda.dataSet.FieldByName('tipo').AsString,
        vGradeVenda.dataSet.FieldByName('qtde').AsFloat);
    venda.Next;
  end;
  dataSet.AfterScroll := GradePedAfterScroll;
  vGradeVenda.abreGradesEst(venda.dataSet.FieldByName('nped').AsInteger,
    venda.dataSet.FieldByName('tipo').AsString);
end;

function TGradeProdEstPed.inserirGrade(venda: TPedVendaProd; pQtde: Double): boolean;
begin
  venda.vGrade.vGradeVenda.insert(venda.dataSet.FieldByName('nped').AsInteger,
    venda.dataSet.FieldByName('grupo_prod').AsInteger,
    venda.vGrade.dataSet.FieldByName('cod_grade').AsInteger,
    trim(venda.dataSet.FieldByName('cod_prod').AsString),
    venda.dataSet.FieldByName('tipo').AsString, pQtde);
  venda.dataSet.FieldByName('cod_grade').AsInteger := venda.vGrade.dataSet.FieldByName('cod_grade').AsInteger;
  atualizaRegistros;
end;

function TGradeProdEstPed.removerGrade(venda: TPedVendaProd): boolean;
begin
  venda.vGrade.vGradeVenda.delete(venda.dataSet.FieldByName('nped').AsInteger,
    venda.dataSet.FieldByName('grupo_prod').AsInteger,
    venda.vGrade.dataSet.FieldByName('cod_grade').AsInteger,
    venda.dataSet.FieldByName('cod_prod').AsString,
    venda.dataSet.FieldByName('tipo').AsString);
  DataSet.Edit;
  DataSet.FieldByName('QtdeItem').AsFloat := 0;
  DataSet.Post;
  atualizaRegistros;
end;

function TGradeProdEstPed.removerGradeVenda(venda: TPedVendaProd): boolean;
begin
  try
    result := true;
    vGradeVenda.abreGradesEst(venda.dataSet.FieldByName('nped').AsInteger, venda.dataSet.FieldByName('tipo').AsString);
    vGradeVenda.First;
    while not vGradeVenda.Eof do
    begin
      inibeErro := 'S';
      if not ExecutaComandosSqlExec('delete from cod_grade_prod_venda ' +
        ' where nreq = ' + vGradeVenda.dataSet.FieldByName('NREQ').asstring +
        ' and tipo = ' + QuotedStr(vGradeVenda.dataSet.FieldByName('TIPO').asstring) +
        ' and grupo_prod = ' + vGradeVenda.dataSet.FieldByName('grupo_prod').asstring +
        ' and cod_prod = ' + QuotedStr(trim(vGradeVenda.dataSet.FieldByName('cod_prod').asstring)) +
        ' and cod_grade = ' + vGradeVenda.dataSet.FieldByName('cod_grade').asstring +
        ' and cod_empresa = ' + vDadosIni.codEmpresa) then
      begin
        result := false;
        exit;
      end;
      vGradeVenda.Next;
    end;
  except
    Result := false;
  end;
end;

