              '', dataSet.FieldByName('PLACA').AsString))
        else if Pos('PCODIGO', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
          obCrystal.ParamFields[i].CurrentValue :=
            IntToStr(vDadosIni.IfThen(dataSet.FieldByName('COD_VEICULO').IsNull,
              0, dataSet.FieldByName('COD_VEICULO').AsInteger))
        else if Pos('PCOD_EMPRESA', UpperCase(trim(obCrystal.ParamFields[i].Name))) > 0 then
          obCrystal.ParamFields[i].CurrentValue := vDadosIni.codEmpresa;
      end;

      vUs := string(__getUsuarioFDB);
      vPw := string(__getSenhaFDB);

      if (Trim(vPw) <> '') then
        obCrystal.LogOnServer.Item.Password := string(__descriptografaTextoFDB(Pchar(vPw)))
      else
        obCrystal.LogOnServer.Item.Password := 'masterkey';
      obCrystal.LogOnServer.Item.DLLName := 'pdsodbc.dll';
      obCrystal.Connect.DatabaseName := vDadosIni.vBancoHW;

      if (Trim(vPw) <> '') then
        obCrystal.Connect.Password := string(__descriptografaTextoFDB(Pchar(vPw)))
      else
        obCrystal.Connect.Password := 'masterkey';
      obCrystal.Connect.ServerName := 'admin';
      if (Trim(vUs) <> '') then
        obCrystal.Connect.UserID := string(__descriptografaTextoFDB(Pchar(vUs)))
      else
        obCrystal.Connect.UserID := 'SYSDBA';

      for i := 0 to (obCrystal.LogOnServer.Count - 1) do
      begin
        if not obCrystal.LogOnServer.Items[i].LogOn then
        begin
          Application.MessageBox(pchar('Erro de conexão com o banco de dados: ' + obCrystal.LastErrorString), 'Informação', MB_ICONERROR + MB_OK);
          exit;
        end;
      end;
      //    ShowMessage(obCrystal.Selection.Formula.Text);
      //  obCrystal.Selection.Formula.Text:=obCrystal.Selection.Formula.Text+' and {PEDVENDA.NPED}=1';
      if obCrystal.Connect.Test then
      begin

        if IniConf.ReadStr('Sistema', 'TSPlus') = 'S' then
        begin
          obCrystal.ExportOptions.FileType := AdobeAcrobatPDF;
          obCrystal.ExportOptions.FileName := GetFileNameRandom('', 'pdf');//vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\Temp\'+ IntToStr(Random(999999)) + '.pdf'; //GetFileNameRandom('', 'pdf');
  //        vDadosIni.registraErro(obCrystal.ExportOptions.FileName);

          sPdfFile := WideString(obCrystal.ExportOptions.FileName);
          sPrintName := WideString(PrintHelper.GetDefaultPrinter());

          obCrystal.Output := toExport;
          obCrystal.Export;

  //        vDadosIni.registraErro(PrintHelper.GetDefaultPrinter());

          sText := PdfHelper.Print(obCrystal.ExportOptions.FileName, PrintHelper.GetDefaultPrinter(), True);

          if sText = '' then
            Exit
          else
          begin
            vDadosIni.registraErro(sText);
            if FileExists(obCrystal.ExportOptions.FileName) then
              DeleteFile(obCrystal.ExportOptions.FileName);

            obCrystal.Output := toWindow;
          end;
        end;

//        result := obCrystal.Execute; //Result := obCrystal.Show;
        vForm.WindowState := wsMaximized;
        vForm.BorderIcons := [biSystemMenu, biMinimize, biMaximize];
        vForm.OnShow := FormShowCrpe;
        vForm.ShowModal;
        Result := True;
      end;

    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDavOrcAvancado12 - ' + e.Message, 'pedvenda');
      end;
    end;
  finally
    vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDavOrcAvancado12 - end', 'pedvenda');

    if Assigned(vSpeedButton) then
	    FreeAndNil(vSpeedButton);
    if Assigned(vPanel) then
	    FreeAndNil(vPanel);
    if Assigned(obCrystal) then
	    FreeAndNil(obCrystal);
    if Assigned(vForm) then
    	FreeAndNil(vForm);
      
  end;
end;

procedure TPedVenda.imprimirDocumento;
var
  vNPed: integer;
  ListImpNaoPermitida, ListSel: TStrings;
  vTemp: string;
  I: Integer;
  DuasViasUmaFolha: Boolean;
  Config: TStrings;
  Modelos: TStrings;
  StrVal: string;
  IntTmp: Integer;
  ConfName: TStrings;
  agentsAndFiles: TStrings;
  filesPosprinter: TStrings;
  confS: TConfig_sistema_class;
  ImprimirOK: Boolean;
  vnpedTmp: Integer;
  vListarImprimirItemCancConsignado: Boolean;
  queryConf: TIBQuery;
  transConf: TIBTransaction;
  ConfigImp: TConfig_sistema_class;
  rdPedido: TRDprint;
begin
  try
  	rdPedido := TRDprint.Create(nil);
    rdPedido.OpcoesPreview.CaptionPreview := 'Impressão vendas';
    rdPedido.CaptionSetup := 'Configuração impressão vendas';
    rdPedido.TitulodoRelatorio := 'Impressão vendas';
    vDadosIni._LimparVarSendEmail;
    vDadosini.CodClienteSendEmail := DataSet.FieldByName('COD_CLIENTE').AsInteger;
    vDadosini.OrigemEnvSendEmail := cPropostaProd;
    vDadosini.NDocSendEmail := IntToStr(dataSet.FieldByName('NPED').AsInteger);
    vDadosini.TipoDocSendEmail := dataSet.FieldByName('TIPO').AsString;
    rdPedido.OnSendMail := vDadosini._SendMailRdPrint;
    rdPedido.OpcoesPreview.Preview := true;
    rdPedido.OpcoesPreview.Remalina := true;
    rdPedido.FonteTamanhoPadrao := S17cpp;
    rdPedido.TamanhoQteColunas := 133;
    rdPedido.TamanhoQteLinhas := 33;

    Modelos := TStringList.Create;
    Modelos.Clear;

    agentsAndFiles := TStringList.Create;
    agentsAndFiles.Clear;
    agentsAndFiles.Add('Padrao');

    Config := TStringList.Create;
    Config.Clear;

    ListSel := TStringList.Create;
    ListSel.Clear;

    ListImpNaoPermitida := TStringList.Create;
    ListImpNaoPermitida.Clear;

    ConfigImp := TConfig_sistema_class.getConf('ped_vnd_impressao_dav_v6', buscas, vDadosIni.cod_empresa);

  	try
      vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDocumento - begin', 'pedvenda');

      if IsEmpty then
        exit;

      vnpedTmp := dataSet.FieldByName('NPED').AsInteger;

      if not _permitirAlteracoesComEnvioMobilePendente then
        Exit;

      if (vSing.vTipoVenda = 'REQ') and (dataSet.FieldByName('paf_num_prevenda').AsInteger > 0) then
      begin
        Application.MessageBox('Impressão de Pré-Venda não permitida de Acordo Ato Cotepe/ICMS N°9 de 2013', 'Atenção', 0 + 64);
        exit;
      end;

      if davJaImpressoNoECF('IMPRIMIR') then
        Exit;

      if (dataSet.FieldByName('nprevenda').AsInteger > 0) and (dataSet.FieldByName('ncupom').AsInteger > 0) then
      begin
    //    if (vSing.vTipoVenda = 'REQ') then
        begin
          vDadosIni.vInibeMensPesqPros := 'S';
          if not vDadosIni.PesqPros('VND103', 'IMPRIMIR DAV', getTipoVenda, 'PEDVENDA',
            dataSet.FieldByName('NPED').AsString, buscas, true) then
          begin
            Application.MessageBox(Pchar('Reimpressão de DAV não é permitida. Cupom fiscal já emitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
            exit;
          end;
        end;
      end;

    //  if trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'FECHADA' then
    //  begin
    //    if (vSing.vTipoVenda = 'REQ') then
    //    begin
    //      vDadosIni.vInibeMensPesqPros := 'S';
    //      if not vDadosIni.PesqPros('VND103', 'IMPRIMIR DAV', getTipoVenda, 'PEDVENDA',
    //        dataSet.FieldByName('NPED').AsString, buscas, true) then
    //      begin
    //				Application.MessageBox(Pchar('Documento ainda não fechado. Impressão permitida apenas após fechamento'), 'Atenção', MB_ICONINFORMATION + MB_OK);
    //        exit;
    //      end;
    //    end;
    //	end;

      try
        transConf := Create_new_fb_transaction(buscas.Database);
      	queryConf := Create_new_fb_query(transConf);

        confS := TCfg_sis.getConf('ped_vnd_imprimir_nao_fiscal', queryConf, vDadosIni.cod_empresa);
        confS.AtivarMapeamentoKeys;

        //if vDadosIni.getConfSisBool('ped_vnd_imprimir_nao_fiscal', buscas) then
        if confS.AsBoolean then
        begin
          Config.Text := confs.AsStrings.Text;
          //Config := vDadosIni.getConfSisBlob('ped_vnd_imprimir_nao_fiscal', buscas);

          IntTmp := 1;
          StrVal := '';
          while StrVal <> '[/fimarquivo]' do
          begin
            StrVal := vDadosIni.GetIni('ModelosNaoFiscal', 'FileNameCofingPosPrinter' + IntToStr(IntTmp), '[/fimarquivo]', Config);
            if FileExists(ExtractFilePath(Application.ExeName) + StrVal + '.ini') then
            begin
              StrVal := vDadosIni.GetIni('ModelosNaoFiscal', 'Modelo' + IntToStr(IntTmp), '[/fimarquivo]', Config);
              if StrVal <> '[/fimarquivo]' then
                Modelos.Add(StrVal);
            end;
            IntTmp := IntTmp + 1;
          end;


    //      confS := TConfig_sistema_class.Create;
    //      confS.value1_b.Text := Config.Text;

          IntTmp := 1;
          while (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'Agente' + IntToStr(IntTmp))) and
                (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'AgenteId' + IntToStr(IntTmp))) and
                (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'ArquivosIniPosPrinterNaoFiscal' + IntToStr(IntTmp))) do
          begin
            filesPosprinter := NewStringList(OnlyNumberAndLetters(confS.ReadString('AgentesNaoFiscal', 'ArquivosIniPosPrinterNaoFiscal' + IntToStr(IntTmp)), ' ,'), ',');
            for I := 0 to filesPosprinter.Count - 1 do
              agentsAndFiles.Add(Format('%s - %s',
                                        [OnlyNumberAndLetters(confS.ReadString('AgentesNaoFiscal', 'Agente' + IntToStr(IntTmp)), ' '),
                                         filesPosprinter[I]]));
            IntTmp := IntTmp + 1;
          end;

          try
            if confS.KesyChanges then
              confS.SaveConfDB(queryConf).Transaction.Commit;
          except
          end;
        end;

      finally
        FreeAndNil(queryConf);
        FreeAndNil(transConf);
        FreeAndNil(confS);
      end;

      try
        if (not vDadosIni.vPedVnd.Otimizacao.Ativa) or (vDadosIni.vPedVnd.Otimizacao.ImpressaoAuto.AbrirTelaDeOpcoes) then
        begin
        	if frmImpPedVenda = nil then
          begin
            Application.CreateForm(TfrmImpPedVenda, frmImpPedVenda);

            if DtmPedVenda = nil then
              DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

            vDadosIni.AlterarDataSourceComponentes(frmImpPedVenda, DtmPed);
          end;

          frmImpPedVenda.nped   := dataSet.FieldByName('nped').AsInteger;
          frmImpPedVenda.tipo   := dataSet.FieldByName('tipo').AsString;
          frmImpPedVenda.cadped := Self;
          frmImpPedVenda.buscas := buscas;
          frmImpPedVenda.AgentsAndFiles.Text := agentsAndFiles.Text;
          if trim(vDadosIni.vHwCloudIA.vUsarServMensageria) = 'S' then
          	frmImpPedVenda.SpeedButtonWhatsApp.Visible := False
          else
          	frmImpPedVenda.SpeedButtonWhatsApp.Visible := vDadosIni.WhatsAppHabilitado(buscas);

          if vSing.vTipoVenda = 'ORC' then
            frmImpPedVenda.ckNaoImprimirTotal.Visible := True
          else if vSing.vTipoVenda = 'OS' then
          begin
            if retornaValor('select first 1 coalesce(configfechvnd, ''E'') AS VALOR from tipo_vendas ' +
              ' where tipo = ''OS'' and tipo_os = ' + QuotedStr(trim(dataSet.FieldByName('tipo_os').AsString))) = 'F' then
            begin
              frmImpPedVenda.ckNaoImprimirTotal.Visible := True;
            end
            else
            begin
              frmImpPedVenda.ckNaoImprimirTotal.Checked := False;
              frmImpPedVenda.ckNaoImprimirTotal.Visible := False;
            end;
          end
          else if vSing.vTipoVenda = 'REQ' then
          begin
            if retornaValor('select first 1 coalesce(configfechvnd, ''E'') AS VALOR from tipo_vendas ' +
              ' where tipo = ''REQ'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipv').AsString))) = 'F' then
            begin
              frmImpPedVenda.ckNaoImprimirTotal.Visible := True;
            end
            else
            begin
              frmImpPedVenda.ckNaoImprimirTotal.Checked := False;
              frmImpPedVenda.ckNaoImprimirTotal.Visible := False;
            end;
          end
          else
          begin
            frmImpPedVenda.ckNaoImprimirTotal.Checked := False;
            frmImpPedVenda.ckNaoImprimirTotal.Visible := False;
          end;

          frmImpPedVenda.SpeedButtonWhatsApp.OnClick := SpeedButtonWhatsAppClick;
          if vSing.vTipoVenda = 'OS' then
          begin
            if vDadosIni.vEmp.vConcess = 'S' then
              frmImpPedVenda.BitBtn3.Visible := true
            else
              frmImpPedVenda.BitBtn3.Visible := False;
            if vDadosIni.vEmp.vUsarAparelho = 'S' then
              frmImpPedVenda.ckImprimirChassi.Visible := False
            else
              frmImpPedVenda.ckImprimirChassi.Visible := True;
          end
          else
          begin
            frmImpPedVenda.BitBtn3.Visible := False;
            if vDadosIni.vEmp.vUsarAparelho = 'S' then
