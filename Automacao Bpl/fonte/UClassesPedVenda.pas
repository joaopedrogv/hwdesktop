function TMecanicos_OS.insert(cod_servico, cod_vendedor, nped: integer;
  codigo_cfop: Double; pTipo: string): boolean;
begin
  Result := false;
  if dataSet.Locate('cod_empresa;nped;tipo;cod_servico;cod_vendedor',
  VarArrayOf([strtoint(vDadosIni.codEmpresa),nped,pTipo,cod_servico,cod_vendedor]),  [loCaseInsensitive]) then
  begin
    Application.MessageBox('Colaborador já relacionado!', 'Atenção', MB_OK +
      MB_ICONEXCLAMATION);
    exit;
  end else
  if inherited insert then
  begin
    dataSet.FieldByName('cod_vendedor').AsInteger := cod_vendedor;
    dataSet.FieldByName('cod_servico').AsInteger := cod_servico;
    dataSet.FieldByName('codigo_nop').AsFloat := codigo_cfop;
    dataSet.FieldByName('nped').AsInteger := nped;
    dataSet.FieldByName('tipo').AsString := trim(pTipo);
    dataSet.FieldByName('per_comissao').AsFloat := 0;
    dataSet.FieldByName('cod_empresa').AsInteger := strtoInt(vDadosIni.codEmpresa);
    dataSet.FieldByName('nome_vendedor').AsString :=
      getNomeColab(dataSet.FieldByName('cod_vendedor').AsString);
    result := inherited Post;
  end;
end;

