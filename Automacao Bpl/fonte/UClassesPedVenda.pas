function TComissaoVend.abreVend(pnped: Integer; ptipo: string; pCodVend: Integer): boolean;
begin

  Result := montaSelect(' select pp.cod_vendedor, col.nome_vendedor, ' +
  	' col.pc_vend_prod, ' +
    ' max(coalesce(pp.perc_comissao_vend, 0)) perc_comissao_vend, ' +
    ' sum(coalesce(pp.vl_comissao_vend, 0)) vl_comissao_vend, ' +
    ' sum(coalesce(pp.vltot_ped_item, 0) - coalesce(pp.rateio_desc, 0) + coalesce(pp.rateio_acresc, 0)) valor_total from pedvenda_prod pp ' +
    ' inner join colaborador col on col.cod_vendedor = pp.cod_vendedor and col.cod_empresa = pp.cod_empresa ' +
    ' where pp.nped = ' + IntToStr(pnped) + ' and pp.tipo = ' + QuotedStr(ptipo) + ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and (coalesce(pp.status,'''') <> ''CANCELADO'') ' +
    ' group by 1, 2, 3 ');

  if pCodVend > 0 then
  begin
    dataset.First;
    while not dataSet.Eof do
    begin
      if (pCodVend = dataSet.FieldByName('cod_vendedor').AsInteger) then
        break;

      dataSet.Next;
    end;
  end;
end;

