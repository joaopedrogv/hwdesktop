    vCodGrupoDev := vDadosIni.vEtiqProd.GrupoProd;
    vCodProdDev := vDadosIni.vEtiqProd.CodProd;
    nGradeSelecionada := vDadosIni.vEtiqProd.CodGrade;

    if (trim(vCodProdDev) <> '') then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select distinct(p.*) from produtos p ' +
      	' inner join cod_barra cb ' +
        ' 	on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' where p.grupo_prod = ' + IntToStr(vCodGrupoDev) +
        ' and p.cod_prod = ' + QuotedStr(vCodProdDev) +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa + //' and consumo <> ''S'
        ' and p.ativo = 1';
      buscas.Open;
    end
    else
    begin
      buscas.Close;
      buscas.SQL.Text := 'select distinct(p.*) from produtos p ' +
      	' inner join cod_barra cb ' +
        ' 	on p.grupo_prod = cb.grupo_prod and p.cod_prod = cb.cod_prod and p.cod_empresa = cb.cod_empresa ' +
        ' where p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cb.cod_barra = ' + QuotedStr(pCodBarra) + //' and consumo <> ''S'
        ' and p.ativo = 1';
