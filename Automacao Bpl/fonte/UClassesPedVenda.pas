        else
        begin
          dataSet.FieldByName('OPERACAO_CONV').AsString := buscas2.FieldByName('OPERACAO').AsString;
          dataSet.FieldByName('FATOR_CONV').AsFloat := buscas2.FieldByName('QUANTIDADE').AsFloat;
          if buscas2.FieldByName('OPERACAO').AsString = 'M' then
          begin
            dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_NF').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - 4);

            dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat *
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat *
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            if (dataSet.FieldByName('NAT_DESCACRES').AsString = 'VALOR') and (dataSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
            	dataSet.FieldByName('VALOR_DESCACRES').AsFloat :=
                buscas2.FieldByName('QUANTIDADE').AsFloat / dataSet.FieldByName('VALOR_DESCACRES').AsFloat;
          end
          else if buscas2.FieldByName('OPERACAO').AsString = 'D' then
          begin
            dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_NF').AsFloat *
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

            dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              dataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

