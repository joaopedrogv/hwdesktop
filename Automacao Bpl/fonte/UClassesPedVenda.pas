          lnRodape := lnRodape + vDadosIni.IfThen(vSing.vTipoVenda <> 'REQ', 1, 0);
          lnRodape := lnRodape + vDadosIni.IfThen(existeItensCancelados and vImprimirCanc, 1, 0);
          lnRodape := lnRodape + vDadosIni.IfThen((vSing.vValorAcrescimo > 0) and (vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N'), 1, 0);
          lnRodape := lnRodape + vDadosIni.IfThen((vSing.vValorDesconto  > 0) and (vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N'), 1, 0);
          lnRodape := vDadosIni.IfThen((lnRodape < 4) and (vDadosIni.vImpDavReduzidoDetalhado.vDeclSpc = 'S'), 4, lnRodape);//declaracao
          lnRodape := lnRodape + 5;// ___ + ass + espaco + obs + razao + pontilhados logo depois de imprimir os itens

          if FDadosImpressao.Via = '1' then
            qtdTeste:= 33
          else
            qtdTeste:= 34;

          if FDadosImpressao.DuasViasEmUmaFolha then
           	vQtdLinhasReqTemp := '66'
          else if FDadosImpressao.Via = '2' then
          begin
            RdpDav.Novapagina;
            FDadosImpressao.Via := '1';
          end;

          if (lnRodape {linhas finais} + lnCab {linhas cabecalho} + it {linhas itens} + 3{1 para cortar}) >= qtdTeste then
            FDadosImpressao.DuasViasEmUmaFolha := False;
        end;

        if (FDadosImpressao.DuasViasEmUmaFolha) and
          ((FDadosImpressao.DescricaoVia = ' - Via Loja') or
          ( FDadosImpressao.Via = '2' ) )  then
          linha := 34
        else
          linha := 1;

        if (vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'ORC') then
          qtdeLinhas := strtoint(trim(vQtdLinhasReqTemp))
        else
          qtdeLinhas := 66;

        RdpDav.TamanhoQteLinhas := qtdeLinhas;

        it := 1;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if (not FDadosImpressao.vImpSelecionados) and (not FDadosImpressao.Imprimir2Vias) then', 'pedvenda');

        if (not FDadosImpressao.vImpSelecionados) and (not FDadosImpressao.Imprimir2Vias) then
        begin
        	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if not RdpDav.EstaAberto then', 'pedvenda');

          if not RdpDav.EstaAberto then
          begin
          	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - result := RdpDav.Abrir;', 'pedvenda');

            result := RdpDav.Abrir;
          end;
        end;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - novaPag;', 'pedvenda');

        novaPag;
        vtotPed := 0.00;

        cabreq;
        vqtdpc := 0;
        vlProd := 0;
        vlServ := 0;
        vVlCanc := 0;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if vItProd.dataSet.RecordCount > 0 then', 'pedvenda');

        if vItProd.dataSet.RecordCount > 0 then
        begin
          vItProd.dataSet.first;
          while not vItProd.dataSet.eof do
          begin
            if (not vItProd.dataSet.FieldByName('CODIGO_KIT').IsNull) and (vItProd.dataSet.FieldByName('CODIGO_KIT').value <> 0) then
            begin
              vUsakit := 1;
              break;
            end;
            vItProd.dataSet.next;
          end;
          if vUsakit = 1 then
          begin
            if Application.MessageBox(pchar('Deseja Imprimir por Kit?'), 'Confirmação',
              MB_ICONQUESTION + MB_YESNO) = IDYES then
              vUsakit := 1
            else
              vUsakit := 0;
          end;

          if FDadosImpressao.ImprimirItensOrdemAlf then
            if vUsakit = 1 then
            begin
              try
                vItProd.dataSet.DisableControls;
                vItProd.dataSet.first;
                while not vItProd.dataSet.eof do
                begin
                  if (vItProd.DataSet.FieldByName('CODIGO_KIT').Asinteger > 0)
                    and (trim(vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString) = '') then
                  begin
                    buscas.Close;
                    buscas.SQL.Text := ' select descricao_kit from kits_prod ' +
                      ' where codigo_kit = ' + inttostr(vItProd.DataSet.FieldByName('CODIGO_KIT').Asinteger) +
                      ' and cod_empresa=' + vDadosIni.codEmpresa;
                    buscas.Open;

                    vItProd.dataSet.Edit;
                    if buscas.IsEmpty then
                      vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString :=
                        vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString
                    else if vItProd.dataSet.FieldByName('ID_KIT').AsInteger > 0 then
                      vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString :=
                        buscas.FieldByName('DESCRICAO_KIT').AsString + IntToStr(vItProd.dataSet.FieldByName('ID_KIT').AsInteger)
                    else
                      vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString :=
                        buscas.FieldByName('DESCRICAO_KIT').AsString;
                    vItProd.dataSet.Post;
                  end
                  else if (trim(vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString) = '') then
                  begin
                    vItProd.dataSet.Edit;
                    vItProd.dataSet.FieldByName('DESCRICAO_KIT_ID_KIT').AsString :=
                      vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString;
                    vItProd.dataSet.Post;
                  end;

                  vItProd.dataSet.Next;
                end;
              finally
                if vItProd.dataSet.ChangeCount > 0 then
                  vItProd.Apply;

                vItProd.dataSet.first;
                vItProd.dataSet.EnableControls;
              end;
            end;

          try
            vOrdem := vItProd.dataSet.IndexFieldNames;
            if FDadosImpressao.ImprimirItensOrdemAlf then
            begin
              if vUsakit = 1 then
                vItProd.dataSet.IndexFieldNames := 'DESCRICAO_KIT_ID_KIT'
              else
                vItProd.dataSet.IndexFieldNames := 'DESCR_PROD_PED';
            end;
            vItProd.dataSet.first;
            while not vItProd.dataSet.eof do
            begin
              if (Trim(vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO') and
                (vItProd.dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat > 0) then// (vItProd.dataSet.FieldByName('QUANT_ITEM_DEV').AsFloat = vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat) then
              begin
                if not vItProd.vListarImprimirItemCancConsignado then
                begin
                  vItProd.dataSet.Next;
                  Continue;
                end;
              end;

              vLocacaoImp := '';
              if (vDadosIni.vImpDavReduzidoDetalhado.vLocacao = 'S') and (Trim(vItProd.dataSet.FieldByName('status').AsString) <> 'CANCELADO') then
              begin
                buscas.Close;
                buscas.SQL.Text := 'select p.LOCACAO_PROD, p.LOCACAO_PROD_1 from produtos p ' +
                  ' where p.grupo_prod = ' + IntToStr(vItProd.DataSet.FieldByName('GRUPO_PROD').Asinteger) +
                  ' and p.cod_prod = ' + QuotedStr(trim(vItProd.DataSet.FieldByName('COD_PROD').AsString)) +
                  ' and p.cod_empresa = ' + vDadosIni.codEmpresa;
                buscas.Open;

                if Trim(buscas.FieldByName('LOCACAO_PROD').AsString) <> '' then
                  vLocacaoImp := Trim(FormatMaskText(vDadosIni.vMascaraLocacao, Trim(buscas.FieldByName('LOCACAO_PROD').AsString)));

                if Trim(buscas.FieldByName('LOCACAO_PROD_1').AsString) <> '' then
                begin
                  if Trim(vLocacaoImp) <> '' then
                    vLocacaoImp := vLocacaoImp + '/';
                  vLocacaoImp := ' ' + vLocacaoImp + Trim(FormatMaskText(vDadosIni.vMascaraLocacao, Trim(buscas.FieldByName('LOCACAO_PROD_1').AsString)));
                end;
              end;

              linha := linha + 1;
              separador(linha, 2);
              //if vkit = 1 then

              if (vItProd.dataSet.FieldByName('CODIGO_KIT').AsInteger = 0) or (vUsakit <> 1) then   // produto nao é kit  ou nao usa o kit na impressao
              begin
                // NOVO MODELO DE IMPRESSAO PRODUTOS
                if vSing.vTipoVenda = 'ORC' then
                  RdpDav.Impf(linha, 4, vItProd.getSituacaoProdutoSimilar, [comp17]);
                RdpDav.Impf(linha, 2, inttostr(it), [comp17]);
                if vConfPos.vPosGrupoCodigo > 0 then
                begin
                  if trim(FDadosImpressao.IdentificacaoProduto) = '' then
                    FDadosImpressao.IdentificacaoProduto := 'GRUPO E CODIGO';

                  if trim(FDadosImpressao.IdentificacaoProduto) = 'GRUPO E CODIGO' then
                    RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                      Copy(vItProd.DataSet.FieldByName('GRUPO_PROD').AsString + ' ' +
                      Trim(vItProd.DataSet.FieldByName('COD_PROD').AsString), 1,vConfPos.vMaxGrupoProd), [comp20])
                  else if trim(FDadosImpressao.IdentificacaoProduto) = 'CODIGO' then
                    RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                      Copy(Trim(vItProd.DataSet.FieldByName('COD_PROD').AsString), 1,vConfPos.vMaxGrupoProd), [comp20])
                  else if trim(FDadosImpressao.IdentificacaoProduto) = 'NUMERO DE FABRICANTE' then
                  begin
                    buscas.Close;
                    buscas.SQL.Text := ' select p.NUM_FAB_PROD from produtos p ' +
                      ' where p.grupo_prod = ' + inttostr(vItProd.DataSet.FieldByName('GRUPO_PROD').Asinteger) +
                      ' and p.cod_prod = ' + QuotedStr(trim(vItProd.DataSet.FieldByName('COD_PROD').AsString)) +
                      ' and p.cod_empresa = ' + vDadosIni.codEmpresa;
                    buscas.Open;

                    RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                      Copy(Trim(buscas.FieldByName('NUM_FAB_PROD').AsString), 1,vConfPos.vMaxGrupoProd), [comp20]);
                  end
                  else
                    RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                      Copy(Trim(vItProd.DataSet.FieldByName('NUM_FAB_PROD').AsString), 1,vConfPos.vMaxGrupoProd), [comp20]);
                end;

                if vConfPos.vPosNumFab > 0 then
                begin
                  if vItProd.DataSet.FieldByName('COD_GRADE').AsInteger <> 0 then
                    RdpDav.Impf(linha, vConfPos.vPosNumFab, Copy(trim(vItProd.DataSet.FieldByName('NUM_FAB_PROD').AsString) + ';' +
                      copy(retornaValor('select descricao as valor from grade ' +
                        ' where cod_grade = ' + IntToStr(vItProd.DataSet.FieldByName('COD_GRADE').AsInteger) +
                        ' and cod_empresa = ' + vDadosIni.codEmpresa), 1, 2), 1, vConfPos.vMaxNumFab), [comp17])
                  else
                    RdpDav.Impf(linha, vConfPos.vPosNumFab, Copy(vItProd.DataSet.FieldByName('NUM_FAB_PROD').AsString,1,vConfPos.vMaxNumFab), [comp17]);
                end;

                 // descricao do produto com tamanho minimo de 25 caracteres
                vTempString := '';
                if (Trim(vLocacaoImp) <> '') and (Trim(vItProd.dataSet.FieldByName('status').AsString) <> 'CANCELADO') then
                  vTempString := ';' + vLocacaoImp
                else if (vDadosIni.vImpDavReduzidoDetalhado.vAplicacao = 'S') or (vDadosIni.vImpDavReduzidoDetalhado.vMarca = 'S') then
                begin
                  buscas.Close;
                  buscas.SQL.Text := ' select p.aplicacao_prod, p.marca_p from produtos p ' +
                    ' where p.grupo_prod = ' + inttostr(vItProd.DataSet.FieldByName('GRUPO_PROD').Asinteger) +
                    ' and p.cod_prod = ' + QuotedStr(trim(vItProd.DataSet.FieldByName('COD_PROD').AsString)) +
                    ' and p.cod_empresa = ' + vDadosIni.codEmpresa;
                  buscas.Open;
                  if vDadosIni.vImpDavReduzidoDetalhado.vAplicacao = 'S' then
                    if Trim(buscas.FieldByName('APLICACAO_PROD').AsString) <> '' then
                      vTempString := ';' + Trim(Copy(buscas.FieldByName('APLICACAO_PROD').AsString, 1, 20));

                  if not (Trim(vItProd.dataSet.FieldByName('status').AsString) = 'CANCELADO') then
                    if Trim(buscas.FieldByName('MARCA_P').AsString) <> '' then
                      vTempString := vDadosIni.IfThen(vDadosIni.vImpDavReduzidoDetalhado.vMarca = 'S', vTempString, '') +
                        ';' + Trim(Copy(buscas.FieldByName('MARCA_P').AsString, 1, 8));
                end
                else
                  vTempString := '';

                if vDadosIni.vImpDavReduzidoDetalhado.vUnidade = 'S' then
                begin
                  if trim(vItProd.dataSet.FieldByName('UNIDADE').AsString) <> '' then
                    vTempString := vTempString + ' ' + UpperCase(Trim(vItProd.dataSet.FieldByName('UNIDADE').AsString));
                end;

                vTemp := '';
                if Fconf.exibir_devolucao_runtime and (not linhaAdicionalDev) and (vItProd.DevInterna.dataSet.Active) and (vItProd.DevInterna.dataSet.RecordCount > 0) then
                begin
                  if (vItProd.DevInterna.fcount('tipo', vDadosIni.vImpDavReduzidoDetalhado.vDevIdDevolucao) > 0) and
                                           (Length(Trim(sinalDevolucao)) > 0) then
                    vTemp := Trim(sinalDevolucao)[1];
                  if (vItProd.DevInterna.fcount('tipo', vDadosIni.vImpDavReduzidoDetalhado.vDevIdCondicional) > 0) and
                                           (Length(Trim(sinalCondicional)) > 0) then
                    vTemp := vTemp + Trim(sinalCondicional)[1];
                end;

                 vTemp := vTemp + vItProd.fstr('DESCR_PROD_PED');

                if (vConfPos.vMaxDescricao - Length(Trim(vTempString))) < 25 then
                  vTempString := Copy(vTemp, 1, 25) + vTempString
                else
                  vTempString := Copy(vTemp, 1, vConfPos.vMaxDescricao - (Length(Trim(vTempString)))) + vTempString;

                if Trim(vItProd.dataSet.FieldByName('status').AsString) = 'CANCELADO' then
                begin
                  vTempString := vDadosIni.Space(vTempString, vConfPos.vMaxDescricao);
                  vTempString := Copy(vTempString, 1, vConfPos.vMaxDescricao - Length(';cancelado')) + ';cancelado';
                end;
                RdpDav.Impf(linha, vConfPos.vPosDescricao, Copy(vTempString, 1, vConfPos.vMaxDescricao), [comp17]);

                if (trim(vItProd.DataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
                  and (vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
                  and (vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
                    RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat]), [comp17])
                else
                RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [vItProd.DataSet.FieldByName('QUANT_PED_ITEM').AsFloat]), [comp17]);

                if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
                begin
                  if (trim(vItProd.DataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
                    and (vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
                    and (vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                        [vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat -
                        (vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat / vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat) +
                        (vItProd.DataSet.FieldByName('RATEIO_ACRESC').AsFloat / vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat)]), [comp17])
                  else
                      RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                    [vItProd.DataSet.FieldByName('VLUN_PED_ITEM').AsFloat -
                    (vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat / vItProd.DataSet.FieldByName('QUANT_PED_ITEM').AsFloat) +
                        (vItProd.DataSet.FieldByName('RATEIO_ACRESC').AsFloat / vItProd.DataSet.FieldByName('QUANT_PED_ITEM').AsFloat)]), [comp17]);

                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n',
                    [vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat -
                    vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat +
                    vItProd.DataSet.FieldByName('RATEIO_ACRESC').AsFloat]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [0.00]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [0.00]), [comp17]);
                  end;
                end
                else
                begin
                  if (trim(vItProd.DataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
                    and (vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
                    and (vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                        [vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat]), [comp17])
                  else
                      RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                    [vItProd.DataSet.FieldByName('VLUN_PED_ITEM').AsFloat]), [comp17]);

                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n',
                    [vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem = tidaValor then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [vItProd.DataSet.FieldByName('RATEIO_ACRESC').AsFloat]), [comp17]);
                  end
                  else if FDadosImpressao.ImpDescAcrescItem = tidaPercentual then
                  begin
                    doub := 0;
                    if (vItProd.ffloat('rateio_desc') > 0) and (vItProd.ffloat('vltot_ped_item') > 0) then
                      doub := vItProd.ffloat('rateio_desc') / vItProd.ffloat('vltot_ped_item') * 100;

                    RdpDav.ImpD(linha, 113, Format('%0.2n', [doub]), [comp17]);

                    doub := 0;
                    if (vItProd.ffloat('rateio_acresc') > 0) and (vItProd.ffloat('vltot_ped_item') > 0) then
                      doub := vItProd.ffloat('rateio_acresc') / vItProd.ffloat('vltot_ped_item') * 100;

                    RdpDav.ImpD(linha, 121, Format('%0.2n', [doub]), [comp17]);
                  end;
                end;
                if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                begin
                  RdpDav.ImpD(linha, 132, format('%0.2n',
                    [vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat -
                    vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat +
                    vItProd.DataSet.FieldByName('RATEIO_ACRESC').AsFloat]), [comp17]);
                end;

                if Fconf.exibir_devolucao_runtime and linhaAdicionalDev and (vItProd.DevInterna.dataSet.RecordCount > 0) then
                begin
                  //vItProd.DevInterna.dataSet.First;
                  while vItProd.DevInterna.dataSet.RecordCount > 0 do
                  begin
                    AddLinhaeVerificarNovaPagina;
                    separador(linha, 2);

                    if vItProd.DevInterna.fequals('tipo', vDadosIni.vImpDavReduzidoDetalhado.vDevIdDevolucao) then
                      RdpDav.Impf(linha, vConfPos.vPosDescricao, Format('%s %s %d %s %s', [sinalDevolucao,
                                                                                        vDadosIni.vImpDavReduzidoDetalhado.vDevIdDevolucao,
                                                                                        vItProd.DevInterna.fint('id'),
                                                                                        FormatDateTime('DD/MM/YYYY', vItProd.DevInterna.fdate('data')),
                                                                                        TrimRight(sinalDevolucao)]), [comp17])
                    else
                      RdpDav.Impf(linha, vConfPos.vPosDescricao, Format('%s %s %s %s', [sinalCondicional,
                                                                                        vDadosIni.vImpDavReduzidoDetalhado.vDevIdCondicional,
                                                                                        FormatDateTime('DD/MM/YYYY', vItProd.DevInterna.fdate('data')),
                                                                                        TrimRight(sinalCondicional)]), [comp17]);

                    RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [vItProd.DevInterna.ffloat('quantidade')]), [comp17]);

                    vItProd.DevInterna.dataSet.Delete;
                  end;
                end;

                //FIM NOVO MODELO DE IMPRESSAO
                if Trim(vItProd.dataSet.FieldByName('status').AsString) <> 'CANCELADO' then
                begin
                  if (trim(vItProd.DataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
                    and (vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
                    and (vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
                      vqtdpc := vqtdpc + vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat
                  else
                      vqtdpc := vqtdpc + vItProd.DataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
                end
                else
                  vVlCanc := vVlCanc + vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat;

                vtotPed := vtotPed + vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
                it := it + 1;
              end
              else
              begin
                vidkit := vItProd.dataSet.FieldByName('ID_KIT').AsInteger;
                vnkit := vItProd.dataSet.FieldByName('CODIGO_KIT').AsInteger;
                vvalkit := 0;
                vdesckit := 0;
                vacreskit := 0;
                while not vItProd.dataSet.eof do
                begin
                  //if vItProd.dataSet.FieldByName('CODIGO_KIT').value <> vnkit then
                  if vItProd.dataSet.FieldByName('ID_KIT').value <> vidkit then
                  begin
                    vItProd.dataSet.prior;
                    break;
                  end;
                  vvalkit := vvalkit + (vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').value);
                  vdesckit := vdesckit + (vItProd.dataSet.FieldByName('RATEIO_DESC').value);
                  vacreskit := vacreskit + (vItProd.dataSet.FieldByName('RATEIO_ACRESC').value);
                  //-vItProd.DataSet.FieldByName('RATEIO_DESC').AsFloat);
                  vItProd.dataSet.next;
                end;
                buscas.close;
                buscas.sql.text := 'SELECT * FROM KITS_PROD ' +
                  ' where codigo_kit = ' + vItProd.dataSet.FieldByName('CODIGO_KIT').AsString +
                  ' and cod_empresa = ' + vDadosIni.codEmpresa +
                  ' and ativo=1';
                buscas.Open;
                RdpDav.Impf(linha, 2, inttostr(it), [comp17]);

                //NOVO MODELO IMPRESSAO KITS

                if vConfPos.vPosGrupoCodigo > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                    Copy(vDadosIni.StrZero(vItProd.dataSet.FieldByName('CODIGO_KIT').AsInteger, 6), 1,vConfPos.vMaxGrupoProd), [comp20])
                else if vConfPos.vPosNumFab > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosNumFab,
                    Copy(vDadosIni.StrZero(vItProd.dataSet.FieldByName('CODIGO_KIT').AsInteger, 6), 1,vConfPos.vMaxNumFab), [comp17]);
                RdpDav.Impf(linha, vConfPos.vPosDescricao, Copy(trim(buscas.FieldByName('DESCRICAO_KIT').AsString) + ' - KIT',1 ,vConfPos.vMaxDescricao), [comp17]);

                RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [1.000]), [comp17]);
                if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
                begin
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n', [vvalkit + vacreskit - vdesckit]), [comp17]);
                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n', [vvalkit + vacreskit - vdesckit]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [0.00]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [0.00]), [comp17]);
                  end;
                end
                else
                begin
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n', [vvalkit]), [comp17]);
                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n', [vvalkit]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem = tidaValor then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [vdesckit]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [vacreskit]), [comp17]);
                  end
                  else if FDadosImpressao.ImpDescAcrescItem = tidaPercentual then
                  begin
                    doub := 0;
                    if (vdesckit > 0) and (vvalkit > 0) then
                      doub := vdesckit / vvalkit * 100;

                    RdpDav.ImpD(linha, 113, Format('%0.2n', [doub]), [comp17]);

                    doub := 0;
                    if (vacreskit > 0) and (vvalkit > 0) then
                      doub := vacreskit / vvalkit * 100;

                    RdpDav.ImpD(linha, 121, Format('%0.2n', [doub]), [comp17]);
                  end;
                end;
                if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                  RdpDav.ImpD(linha, 132, format('%0.2n', [vvalkit + vacreskit - vdesckit]), [comp17]);

                //FIM NOVO MODELO IMPRESSAO KITS
                if Trim(vItProd.dataSet.FieldByName('status').AsString) <> 'CANCELADO' then
                begin
                  if (trim(vItProd.DataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
                    and (vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
                    and (vItProd.DataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0) then
                      vqtdpc := vqtdpc + vItProd.DataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat
                  else
                      vqtdpc := vqtdpc + vItProd.DataSet.FieldByName('QUANT_PED_ITEM').AsFloat;
                end
                else
                  vVlCanc := vVlCanc + vItProd.DataSet.FieldByName('VLTOT_PED_ITEM').AsFloat;

                vtotPed := vtotPed + vvalkit;
                it := it + 1;
              end;

              vItProd.dataSet.next;
              if linha = qtdeLinhas {- 1} then
              begin
                linha := 1;
                RdpDav.Novapagina;
                novaPag;
                Cabreq;
            end;
            end;
          finally
             if FDadosImpressao.ImprimirItensOrdemAlf then
               vItProd.dataSet.IndexFieldNames := vOrdem;
          end;
        end;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if vItServ.dataSet.RecordCount > 0 then', 'pedvenda');

        vqtdsv := 0;
        if vSing.vTipoVenda <> 'REQ' then
        begin
          if vItServ.dataSet.RecordCount > 0 then
          begin
            try
              vOrdem := vItServ.dataSet.IndexFieldNames;
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItServ.dataSet.IndexFieldNames := 'DESC_SERV_PED';
              vItServ.dataSet.first;
              while not vItServ.dataSet.eof do
              begin
                linha := linha + 1;
                separador(linha, 2);
                RdpDav.Impf(linha, 2, inttostr(it), [comp17]);

                // NOVO MODELO DE IMPRESSAO SERVICOS

                if vConfPos.vPosGrupoCodigo > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo,
                    Copy(vDadosIni.StrZero(vItServ.DataSet.FieldByName('cod_servico').AsInteger, 6), 1, vConfPos.vMaxGrupoProd), [comp20])
                else if vConfPos.vPosNumFab > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosNumFab, Copy(vDadosIni.StrZero(vItServ.DataSet.FieldByName('cod_servico').AsInteger, 6), 1, vConfPos.vMaxNumFab), [comp17]);

                vTempString := Trim(vItServ.DataSet.FieldByName('DESC_SERV_PED').AsString);
                if Trim(vItServ.dataSet.FieldByName('status').AsString) = 'CANCELADO' then
                begin
                  vTempString := vDadosIni.Space(vTempString, vConfPos.vMaxDescricao);
                  vTempString := Copy(vTempString, 1, vConfPos.vMaxDescricao - Length(';cancelado')) + ';cancelado';
                end;

                RdpDav.Impf(linha, vConfPos.vPosDescricao, Copy(vTempString, 1, vConfPos.vMaxDescricao), [comp17]);
                RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [vItServ.DataSet.FieldByName('QUANT_SERV_PED').AsFloat]), [comp17]);
                if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc = 'N' then
                begin
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                    [vItServ.DataSet.FieldByName('VALOR_UN_SERV').AsFloat -
                    (vItServ.DataSet.FieldByName('RATEIO_DESC').AsFloat / vItServ.DataSet.FieldByName('QUANT_SERV_PED').AsFloat) +
                    (vItServ.DataSet.FieldByName('rateio_acresc').AsFloat / vItServ.DataSet.FieldByName('QUANT_SERV_PED').AsFloat)]), [comp17]);
                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n',
                    [vItServ.DataSet.FieldByName('VALOR_TOT_SERV').AsFloat -
                    vItServ.DataSet.FieldByName('RATEIO_DESC').AsFloat +
                    vItServ.DataSet.FieldByName('rateio_acresc').AsFloat]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [0.00]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [0.00]), [comp17]);
                  end;
                end
                else
                begin
                  RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n',
                    [vItServ.DataSet.FieldByName('VALOR_UN_SERV').AsFloat]), [comp17]);
                  RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n',
                    [vItServ.DataSet.FieldByName('VALOR_TOT_SERV').AsFloat]), [comp17]);
                  if FDadosImpressao.ImpDescAcrescItem = tidaValor then
                  begin
                    RdpDav.ImpD(linha, 113, Format('%0.2n', [vItServ.DataSet.FieldByName('RATEIO_DESC').AsFloat]), [comp17]);
                    RdpDav.ImpD(linha, 121, Format('%0.2n', [vItServ.DataSet.FieldByName('rateio_acresc').AsFloat]), [comp17]);
                  end
                  else if FDadosImpressao.ImpDescAcrescItem = tidaPercentual then
                  begin
                   doub := 0;
                   if (vItServ.ffloat('rateio_desc') > 0) and (vItServ.ffloat('valor_tot_serv') > 0) then
                     doub := vItServ.ffloat('rateio_desc') / vItServ.ffloat('valor_tot_serv') * 100;

                   RdpDav.ImpD(linha, 113, Format('%0.2n', [doub]), [comp17]);

                   doub := 0;
                   if (vItServ.ffloat('rateio_acresc') > 0) and (vItServ.ffloat('valor_tot_serv') > 0) then
                     doub := vItServ.ffloat('rateio_acresc') / vItServ.ffloat('valor_tot_serv') * 100;

                   RdpDav.ImpD(linha, 121, Format('%0.2n', [doub]), [comp17]);
                  end;
                end;
                if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                  RdpDav.ImpD(linha, 132, format('%0.2n',
                    [vItServ.DataSet.FieldByName('VALOR_TOT_SERV').AsFloat -
                    (vItServ.DataSet.FieldByName('RATEIO_DESC').AsFloat) +
                    (vItServ.DataSet.FieldByName('rateio_acresc').AsFloat)]), [comp17]);

                //FIM NOVO MODELO DE IMPRESSAO SERVICOS

                if Trim(vItServ.dataSet.FieldByName('status').AsString) <> 'CANCELADO' then
                  vqtdsv := vqtdsv + vItServ.DataSet.FieldByName('QUANT_SERV_PED').AsFloat
                else
                	vVlCanc := vVlCanc + vItServ.DataSet.FieldByName('VALOR_TOT_SERV').AsFloat;

                vtotPed := vtotPed + vItServ.DataSet.FieldByName('VALOR_TOT_SERV').AsFloat;
                it := it + 1;
                vItServ.dataSet.next;
                if linha = qtdeLinhas {- 1} then
                begin
                  linha := 1;
                  RdpDav.Novapagina;
                  novaPag;
                  Cabreq;
              end;
              end;
            finally
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItServ.dataSet.IndexFieldNames := vOrdem;
            end;
          end;

        	vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if vItProdTerc.dataSet.RecordCount > 0 then', 'pedvenda');

          // Produtos de Terceiros
          if vItProdTerc.dataSet.RecordCount > 0 then
          begin
            try
              vOrdem := vItProdTerc.dataSet.IndexFieldNames;
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItProdTerc.dataSet.IndexFieldNames := 'DESCRICAO';

              vItProdTerc.first;
              while not vItProdTerc.eof do
              begin
                linha := linha + 1;
                separador(linha, 2);
                RdpDav.Impf(linha, 2, inttostr(it), [comp17]);

                // NOVO MODELO DE IMPRESSAO PRODUTOS TERCEIRO

                if vConfPos.vPosGrupoCodigo > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo, Copy('P' + vDadosIni.StrZero(it, 5), 1, vConfPos.vMaxGrupoProd), [comp20])
                else if vConfPos.vPosNumFab > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosNumFab, Copy('P' + vDadosIni.StrZero(it, 5), 1, vConfPos.vMaxDescricao), [comp17]);
                RdpDav.Impf(linha, vConfPos.vPosDescricao, Copy(vItProdTerc.DataSet.FieldByName('DESCRICAO').AsString, 1, vConfPos.vMaxDescricao), [comp17]);
                RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [vItProdTerc.DataSet.FieldByName('QTDE').AsFloat]), [comp17]);
                RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n', [vItProdTerc.DataSet.FieldByName('VL_UNIT').AsFloat]), [comp17]);
                RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n', [vItProdTerc.DataSet.FieldByName('VL_TOTAL').AsFloat]), [comp17]);
                if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                begin
                  RdpDav.ImpD(linha, 113, Format('%0.2n', [0.00]), [comp17]);
                  RdpDav.ImpD(linha, 121, Format('%0.2n', [0.00]), [comp17]);
                  RdpDav.ImpD(linha, 132, format('%0.2n', [vItProdTerc.DataSet.FieldByName('VL_TOTAL').AsFloat]), [comp17]);
                end;

                //FIM NOVO MODELO DE IMPRESSAO PRODUTOS TERCEIRO

                vqtdpc := vqtdpc + vItProdTerc.DataSet.FieldByName('QTDE').AsFloat;
                vtotPed := vtotPed + vItProdTerc.DataSet.FieldByName('VL_TOTAL').AsFloat;
                vlProd := vlProd + vItProdTerc.DataSet.FieldByName('VL_TOTAL').AsFloat;
                it := it + 1;
                vItProdTerc.next;
                if linha = qtdeLinhas {- 1} then
                begin
                  linha := 1;
                  RdpDav.Novapagina;
                  novaPag;
                  Cabreq;
              end;
              end;
            finally
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItProdTerc.dataSet.IndexFieldNames := vOrdem;
            end;
          end;

          vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - if vItServTerc.dataSet.RecordCount > 0 then', 'pedvenda');

          // Serviços de Terceiros
          if vItServTerc.dataSet.RecordCount > 0 then
          begin
            try
              vOrdem := vItServTerc.dataSet.IndexFieldNames;
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItServTerc.dataSet.IndexFieldNames := 'DESCR_SERVT';

              vItServTerc.first;
              while not vItServTerc.eof do
              begin
                linha := linha + 1;
                separador(linha, 2);
                RdpDav.Impf(linha, 2, inttostr(it), [comp17]);

                // NOVO MODELO DE IMPRESSAO SERVICOS TERCEIRO

                if vConfPos.vPosGrupoCodigo > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosGrupoCodigo, Copy('S' + vDadosIni.StrZero(it, 5), 1, vConfPos.vMaxGrupoProd), [comp20])
                else if vConfPos.vPosNumFab > 0 then
                  RdpDav.Impf(linha, vConfPos.vPosNumFab, Copy('S' + vDadosIni.StrZero(it, 5), 1, vConfPos.vMaxDescricao), [comp17]);
                RdpDav.Impf(linha, vConfPos.vPosDescricao, Copy(vItServTerc.DataSet.FieldByName('DESCR_SERVT').AsString, 1, vConfPos.vMaxDescricao), [comp17]);
                RdpDav.impD(linha, vConfPos.vPosQtde, format('%0.3n', [1.00]), [comp17]);
                RdpDav.ImpD(linha, vConfPos.vPosVlUnit, format('%0.' + vSing.vCasasDecimais + 'n', [vItServTerc.DataSet.FieldByName('VL_SERVT').AsFloat]), [comp17]);
                RdpDav.ImpD(linha, vConfPos.vPosVlTot, format('%0.2n', [vItServTerc.DataSet.FieldByName('VL_SERVT').AsFloat]), [comp17]);
                if FDadosImpressao.ImpDescAcrescItem <> tidaNenhum then
                begin
                  RdpDav.ImpD(linha, 113, Format('%0.2n', [0.00]), [comp17]);
                  RdpDav.ImpD(linha, 121, Format('%0.2n', [0.00]), [comp17]);
                  RdpDav.ImpD(linha, 132, format('%0.2n', [vItServTerc.DataSet.FieldByName('VL_SERVT').AsFloat]), [comp17]);
                end;

                //FIM NOVO MODELO DE IMPRESSAO SERVICOS TERCEIRO

                vqtdsv := vqtdsv + 1;
                vtotPed := vtotPed + vItServTerc.DataSet.FieldByName('VL_SERVT').AsFloat;
                vlServ := vlServ + vItServTerc.DataSet.FieldByName('VL_SERVT').AsFloat;
                it := it + 1;
                vItServTerc.next;
                if linha = qtdeLinhas {- 1} then
                begin
                  linha := 1;
                  RdpDav.Novapagina;
                  novaPag;
                  Cabreq;
              end;
              end;
            finally
              if FDadosImpressao.ImprimirItensOrdemAlf then
                vItServTerc.dataSet.IndexFieldNames := vOrdem;
            end;
          end;
        end;

        linha := linha + 1;
        separador(linha, 1);
        linha := linha + 1;
        if vVlCanc > 0 then
          inc(lnFin);
        if linha + lnFin > {=} qtdeLinhas {- 1} then
        begin
          linha := 1;
          RdpDav.Novapagina;
          novaPag;
          Cabreq;
          linha := linha + 1;
        end;
        vlnplano := linha;
        vlnDeclReq := linha;

        if (vqtdpc > 0) or (vExibirValorPecasServ) then
        begin
          RdpDav.impf(linha, 1, 'QTDE PECAS VENDIDAS: ' + VdadosIni.alndir(format('%n', [vqtdpc]), 8), [normal]);
          linha := linha + 1;
        end;

        if (vSing.vTipoVenda <> 'REQ') and ((vqtdsv > 0) or (vExibirValorPecasServ)) then
        begin
          RdpDav.impf(linha, 1, 'QTDE SERVIÇOS......: ' + VdadosIni.alndir(format('%n', [vqtdsv]), 8), [normal]);
          linha := linha + 1;
        end;

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDav - TOTAIS', 'pedvenda');

        if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
          // Não imprimir total
        else if (vVlCanc > 0) and (vImprimirCanc) then
        begin
          RdpDav.impf(linha, 1, 'TOTAL CANCELADO....: ' + vdadosini.alndir(Format('%n', [vVlCanc]), 8), [normal]);
          linha := linha + 1;
        end;

        if vSing.vTipoVenda = 'REQ' then
        begin
          if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
            // Não imprimir total
          else if (vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N') and ((dataSet.FieldByName('VALOR_TOTAL').AsCurrency - vSing.vValorAcrescimo + vSing.vValorDesconto > 0) or (vExibirValorPecasServ)) then
          begin
            RdpDav.impf(linha, 1, 'TOTAL REQUISICAO...: ' + VdadosIni.alndir(format('%n',
              [dataSet.FieldByName('VALOR_TOTAL').AsCurrency - vSing.vValorAcrescimo + vSing.vValorDesconto]),
                12), [normal]);
            linha := linha + 1;
          end
          else if (dataSet.FieldByName('VALOR_TOTAL').AsCurrency > 0) or (vExibirValorPecasServ)  then
          begin
            RdpDav.impf(linha, 1, 'TOTAL REQUISICAO...: ' + VdadosIni.alndir(format('%n',
              [dataSet.FieldByName('VALOR_TOTAL').AsCurrency]),
              12), [normal]);
            linha := linha + 1;
          end;
        end
        else
        begin
          if vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N' then
          begin
          	if (dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd > 0) or (vExibirValorPecasServ) then
            begin
              RdpDav.impf(linha, 1, 'TOTAL PRODUTOS.....: ' + VdadosIni.alndir(format('%n',
                [dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd]),
                12), [normal]);
              linha := linha + 1;
            end;

            if (dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ > 0) or (vExibirValorPecasServ) then
            begin
              RdpDav.impf(linha, 1, 'TOTAL SERVIÇOS.....: ' + VdadosIni.alndir(format('%n',
                [dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ]),
                12), [normal]);
              linha := linha + 1;
            end;

            if (vDadosIni.vImpDavReduzidoDetalhado.vImpBruto = 'S')
            	and (((dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd > 0) and (dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ > 0)) or (vExibirValorPecasServ)) then
            begin
              RdpDav.impf(linha, 1, 'TOTAL BRUTO........: ' + VdadosIni.alndir(format('%n',
                [dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd +
                 dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ]),
                12), [normal]);
              linha := linha + 1;
            end;
          end
          else
          begin
            if (dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd + vSing.vRateioAcrescimoProd - vSing.vRateioDescontoProd > 0) or (vExibirValorPecasServ) then
            begin
              RdpDav.impf(linha, 1, 'TOTAL PRODUTOS.....: ' + VdadosIni.alndir(format('%n',
                [dataSet.FieldByName('TOT_PROD').AsCurrency + vlProd +
                 vSing.vRateioAcrescimoProd - vSing.vRateioDescontoProd]),
                12), [normal]);
              linha := linha + 1;
            end;

            if (dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ + vSing.vRateioAcrescimoServ - vSing.vRateioDescontoServ > 0) or (vExibirValorPecasServ) then
            begin
              RdpDav.impf(linha, 1, 'TOTAL SERVIÇOS.....: ' + VdadosIni.alndir(format('%n',
                [dataSet.FieldByName('TOT_SERV').AsCurrency + vlServ +
                 vSing.vRateioAcrescimoServ - vSing.vRateioDescontoServ]),
                12), [normal]);
              linha := linha + 1;
            end;
          end;
        end;

        if (vSing.vValorAcrescimo > 0) and (vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N') then
        begin
          if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
            // Não imprimir total
          else
          begin
            RdpDav.impf(linha, 1, 'TOTAL DO ACRÉSCIMO.: ' + VdadosIni.alndir(Format('%n',
              [vSing.vValorAcrescimo]), 12), [normal]);
            linha := linha + 1;
          end;

          if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
            // Não imprimir total
          else if (FDadosImpressao.ImpDescAcrescItem = tidaPercentual) and (conf.PercentualAcDescTotais) then
          begin
            RdpDav.impf(linha, 1, 'TOTAL  % ACRÉSCIMO.: ' + PadL(Format('%9.2n', [vSing.vValorAcrescimo / (ffloat('TOT_PROD') + vlProd + ffloat('TOT_SERV') + vlServ) * 100]), 12), [normal]);
            linha := linha + 1;
          end;
        end;

        if (vSing.vValorDesconto > 0) and (vDadosIni.vImpDavReduzidoDetalhado.vImpDescAcresc <> 'N') then
        begin
          if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
            // Não imprimir total
          else
          begin
            RdpDav.impf(linha, 1, 'TOTAL DO DESCONTO..: ' + vdadosini.alndir(Format('%n',
              [vSing.vValorDesconto]), 12), [normal]);
            linha := linha + 1;
          end;

          if (vSing.vTipoVenda = 'REQ') and (FDadosImpressao.NaoImprimirTotal) then
            // Não imprimir total
          else if (FDadosImpressao.ImpDescAcrescItem = tidaPercentual) and (conf.PercentualAcDescTotais) then
          begin
            RdpDav.impf(linha, 1, 'TOTAL  % DESCONTO..: ' + PadL(Format('%9.2n', [vSing.vValorDesconto / (ffloat('TOT_PROD') + vlProd + ffloat('TOT_SERV') + vlServ) * 100]), 12), [normal]);
