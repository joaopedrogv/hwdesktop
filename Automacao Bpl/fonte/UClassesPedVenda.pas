function TPedVenda.retornaVendedorCarteira: Boolean;
var
	ConfigImp: TConfig_sistema_class;
begin
	try
  	Result := True;

    ConfigImp := TConfig_sistema_class.getConf('ped_vnd_vendedor_carteira', buscas, vDadosIni.cod_empresa);

    try

      if (UpperCase(ConfigImp.ReadString('Conf_' + trim(dataSet.FieldByName('TIPO').AsString), 'Ativa')) = 'S')
        or (UpperCase(ConfigImp.ReadString('Conf_' + trim(dataSet.FieldByName('TIPO').AsString), 'Ativa')) = 'SIM') then
      begin
        if dataSet.FieldByName('COD_CLIENTE').AsInteger <= 0 then
          exit;

        buscas.Close;
        buscas.SQL.Text := ' select cod_vendedor from clientes ' +
          ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.Open;

        if buscas.FieldByName('COD_VENDEDOR').AsInteger > 0 then
          dataSet.FieldByName('COD_VENDEDOR').AsInteger := buscas.FieldByName('COD_VENDEDOR').AsInteger;
      end;

    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(ConfigImp) then
    	FreeAndNil(ConfigImp);
  end;
end;

function TPedVenda.RollbackVendaProd(ItensProd, ItensServ: TDataSet): boolean;
begin
  if (dataSet.State = dsInsert) or (dataSet.State = dsInsert) then
  begin
    if (ItensProd.State = dsInsert) or (ItensProd.State = dsInsert) then
      ItensProd.Cancel;
    if (ItensServ.State = dsInsert) or (ItensServ.State = dsInsert) then
      ItensServ.Cancel;
    Cancel;
    DtmPed.IBTransPedVenda.Rollback;
  end;
end;

