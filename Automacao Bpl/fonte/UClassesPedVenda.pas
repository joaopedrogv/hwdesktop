  procedure FormatValue(var Value: string; var FormatParam: string);
  var
    StrTmpValue: string;
    IntTmpValue: Integer;
    DoubleTmp: Double;
  begin
    while Trim(FormatParam) <> '' do
    begin
      StrTmpValue := Copy(FormatParam, Pos('(', FormatParam),
        Pos(')', FormatParam) - Pos('(', FormatParam) + 1 );
      System.Delete(FormatParam, Pos('(', FormatParam),
        Pos(')', FormatParam) - Pos('(', FormatParam) + 1 );

      if Copy(StrTmpValue, 1, 5) = '(STZ:' then
      begin
        IntTmpValue := StrToIntDef( Trim(Copy(StrTmpValue, 6, Length(StrTmpValue) - 6)) , 0);
        Value := vDadosIni.StrZero(Value, IntTmpValue);
      end
      else if (Copy(StrTmpValue, 1, 5) = '(PDL:') or (Copy(StrTmpValue, 1, 5) = '(PDR:') then
      begin
        IntTmpValue := StrToIntDef( Trim(Copy(StrTmpValue, 6, Length(StrTmpValue) - 6)) , 0);
        if IntTmpValue > 0 then
          if Length(Value) > IntTmpValue then
            Value := Copy(Value, 1, IntTmpValue)
          else if (Copy(StrTmpValue, 1, 5) = '(PDL:') then
            Value := vDadosIni.Replicate(' ', IntTmpValue - Length(Value)) + Value
          else
            Value := Value + vDadosIni.Replicate(' ', IntTmpValue - Length(Value));
      end
      else if Copy(StrTmpValue, 1, 5) = '(DEC:' then
      begin
        DoubleTmp := StrToFloatDef(Value, -998877);
        if DoubleTmp <> -998877 then
        begin
          IntTmpValue := StrToIntDef( Trim(Copy(StrTmpValue, 6, Length(StrTmpValue) - 6)) , 2);
          Value := Format('%0.' + IntToStr(IntTmpValue) + 'n', [DoubleTmp]);
        end;
      end
      else if Copy(StrTmpValue, 1, 9) = '(CFPCNPJ)' then
      begin
        Value := vDadosIni.apenasNumeros(Value);
        if Length(Trim(Value)) = 11 then
          Value := FormatMaskText('000.000.000-00;0;_', Value)
        else if Length(Trim(Value)) = 14 then
          Value := FormatMaskText('00.000.000/0000-00;0;_', Value)
      end
      else if Copy(StrTmpValue, 1, 6) = '(FONE)' then
      begin
        Value := vDadosIni.apenasNumeros(Value);
        if Length(Value) = 10 then
          Value := FormatMaskText('(00)0000-0000;0;_', Value)
        else if Length(Value) = 11 then
          Value := FormatMaskText('(00)00000-0000;0;_', Value)
      end;

      if (Pos('(', FormatParam) = 0) or (Pos(')', FormatParam) = 0)  then
        FormatParam := ''
      else if (Pos('(', FormatParam) > Pos(')', FormatParam))  then
        FormatParam := '';
    end;
  end;

  procedure lib_querys(var Aquery: TIBQuery);
  begin
    if Assigned(Aquery) then
    begin
      Aquery.Close;
      FreeAndNil(Aquery);
    end;
  end;
  {$ENDREGION}

begin
	try
  	qEmpresa := TIBQuery.Create(Application);
    qCondPag := TIBQuery.Create(Application);
    qCliente := TIBQuery.Create(Application);
    qCl_endAd := TIBQuery.Create(Application);
    qColab := TIBQuery.Create(Application);
    qVeiculo := TIBQuery.Create(Application);

  	try
      vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDavImpNaoFiscal - begin', 'pedvenda');

      Config := TStringList.Create;
      Config := vDadosIni.getConfSisBlob('ped_vnd_imprimir_nao_fiscal', buscas);

      Colunas           := StrToInt(vDadosIni.GetIni(ModeloImpressao, 'Colunas', '53', Config));
      ColunasCondensado := StrToInt(vDadosIni.GetIni(ModeloImpressao, 'ColunasCondensado', '57', Config));

      Modelo := TStringList.Create;
      Modelo.Clear;
      Condensado := False;
      Modelo.Text := Copy(Config.Text,
                          Pos('[*' + ModeloImpressao + '*]', Config.Text),
                          Pos('[*/' + ModeloImpressao + '*]', Config.Text) -
                          Pos('[*' + ModeloImpressao + '*]', Config.Text) + Length(ModeloImpressao) + 5);
      if Modelo.Text <> '' then
      begin
        if Modelo.Count > 0 then
          Modelo.Delete(Modelo.Count - 1); //linha final
        if Modelo.Count > 0 then
          Modelo.Delete(0); //linha inicial
      end;

      StrVal := '';
      ConfName := '';
      IntTmp := 1;
      while StrVal <> '[/fimarquivo]' do
      begin
        StrVal := vDadosIni.GetIni('ModelosNaoFiscal', 'Modelo' + IntToStr(IntTmp), '[/fimarquivo]', Config);
        if ModeloImpressao = StrVal then
        begin
          ConfName := vDadosIni.GetIni('ModelosNaoFiscal', 'FileNameCofingPosPrinter' + IntToStr(IntTmp), '', Config);
          Break;
        end;
        IntTmp := IntTmp + 1;
      end;

      if Modelo.Count = 0 then
      begin
        Application.MessageBox('Sem modelo configurado para impressão', 'Atenção', 0 + 64);
        Exit;
      end;

      AgenteId := '';
      if AgentAndFile <> 'Padrao' then
      begin
        confS := TConfig_sistema_class.Create;
        confS.value1_b.Text := Config.Text;

        IntTmp := 1;
        while (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'Agente' + IntToStr(IntTmp))) and
              (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'AgenteId' + IntToStr(IntTmp))) and
              (confS.GetIniFile.ValueExists('AgentesNaoFiscal', 'ArquivosIniPosPrinterNaoFiscal' + IntToStr(IntTmp))) do
        begin

          if MatchText(Trim(Copy(AgentAndFile, 1, Pos(' -', AgentAndFile) - 1)), [confS.ReadString('AgentesNaoFiscal', 'Agente' + IntToStr(IntTmp))]) then
          begin
            AgenteId := Trim(confS.ReadString('AgentesNaoFiscal', 'AgenteId' + IntToStr(IntTmp)));
            ConfName := Trim(Copy(AgentAndFile, Pos('- ', AgentAndFile) + 2, Length(AgentAndFile)));
            Break;
          end;
          IntTmp := IntTmp + 1;
        end;
        if AgenteId = '' then
        begin
          ShowAtencao('Agente de impressão selecionado sem configuração(AgenteId)');
          Exit;
        end;
      end;

      if ConfName = '' then
      begin
        Application.MessageBox('Arquivo de Configuração não informado', 'Atenção', 0 + 64);
        Exit;
      end;

      dataSet.Refresh;   //para atualizar os dados do cabeçalho antes de imprimir
      vCliente.abreClientes(DataSet.FieldByName('COD_CLIENTE').AsInteger);
      vCliente.vEst.abreEstado(vCliente.DataSet.FieldByName('CODIGO_UF').AsInteger);
      vItProd.vListarImprimirItemVan := false;
      vItProd.abrePedVendaProd(DataSet.FieldByName('NPED').AsInteger);
      if vSing.vTipoVenda <> 'REQ' then
      begin
        vItServ.abrePedVendaServ(DataSet.FieldByName('NPED').AsInteger);
        vItServTerc.abreServicoTerceiro(DataSet.FieldByName('NPED').AsInteger);
        vItProdTerc.abreProdTerceiro(DataSet.FieldByName('NPED').AsInteger);
      end;
      DefinirQuerys;

      calculaTotais;
      calculaDescontoAcrescimo;
      DefinirTotais;
      dadosImp.nItem := 0;

      Impressao := TStringList.Create;
      Impressao.Clear;

      Impressao.Add('</zera>');
      for I := 0 to Modelo.Count - 1 do
      begin
        if Pos('//', Modelo[I]) = 1 then //comentario
          Continue;
        if (Pos('[/ATV_APARELHO]', Modelo[I]) > 0) then
          if (vDadosIni.vEmp.vUsarAparelho <> 'S') or
            (((vSing.vTipoVenda = 'ORC') and (Trim(dataSet.FieldByName('APARELHO_PED').AsString) = '')) or (vSing.vTipoVenda = 'REQ')) then
            Continue;

        if (Pos('[/ATV_VEICULO]', Modelo[I])  > 0) then
          if (vDadosIni.vEmp.vUsarAparelho = 'S') or
            (((vSing.vTipoVenda = 'ORC') and (Trim(dataSet.FieldByName('PLACA').AsString) = '')) or (vSing.vTipoVenda = 'REQ')) then
            Continue;

        if (Pos('[/ATV_REQ]', Modelo[I]) > 0) or (Pos('[/ATV_ORC]', Modelo[I]) > 0) or (Pos('[/ATV_OS]', Modelo[I]) > 0) then
          if (Pos('[/ATV_' + vSing.vTipoVenda + ']', Modelo[I]) = 0) then
            Continue;

        if Pos('<c>', Modelo[I]) > 0 then
          Condensado := True;
        if Pos('</fn>', Modelo[I]) > 0 then
          Condensado := False;
        Linha := Modelo[I];

        Linha := StringReplace(Linha, '[/ATV_APARELHO]', '', [rfReplaceAll, rfIgnoreCase]);
        Linha := StringReplace(Linha, '[/ATV_VEICULO]', '', [rfReplaceAll, rfIgnoreCase]);
        Linha := StringReplace(Linha, '[/ATV_REQ]', '', [rfReplaceAll, rfIgnoreCase]);
        Linha := StringReplace(Linha, '[/ATV_ORC]', '', [rfReplaceAll, rfIgnoreCase]);
        Linha := StringReplace(Linha, '[/ATV_OS]', '', [rfReplaceAll, rfIgnoreCase]);

        StrImp := '';
        while Length(Linha) > 0 do
        begin
          if Pos('[/', Linha) > 0 then
          begin
            StrImp := StrImp + Copy(Linha, 1, Pos('[/', Linha) - 1);
            Linha := Copy(Linha, Pos('[/', Linha), Length(Linha));
          end;

          Campo := GetCampo;

          if Campo = 'CL_ENDERECO_PADRAO_RESUMIDO' then
          begin
            Impressao.Add('</ce><c>' + Trim(qCl_endAd.FieldByName('logradouro').AsString) +
              vDadosIni.IfThen(Trim(qCl_endAd.FieldByName('numero').AsString) <> '', ',' + Trim(qCl_endAd.FieldByName('numero').AsString), '') +
              vDadosIni.IfThen(Trim(qCl_endAd.FieldByName('complemento').AsString) <> '', ',' + Trim(qCl_endAd.FieldByName('complemento').AsString), '') +
              '-' + Trim(qCl_endAd.FieldByName('cidade').AsString) + '</c>');
            Linha := '';
          end
          else if Campo = 'CL_ENDERECO_PADRAO_DETALHADO' then
          begin
            Impressao.Add('</ce><c>Endereco: ' + Trim(qCl_endAd.FieldByName('logradouro').AsString) +
              vDadosIni.IfThen(Trim(qCl_endAd.FieldByName('numero').AsString) <> '', ',' + Trim(qCl_endAd.FieldByName('numero').AsString), '') +
              vDadosIni.IfThen(Trim(qCl_endAd.FieldByName('complemento').AsString) <> '', ',' + Trim(qCl_endAd.FieldByName('complemento').AsString), '')+
              '</c>');
            StrVal := vDadosIni.apenasNumeros(qCl_endAd.FieldByName('cep').AsString);
            Impressao.Add('<c>CEP: ' + FormatMaskText('00.000-000;0;_', StrVal) + ' - ' +
              Trim(qCl_endAd.FieldByName('bairro').AsString) + '</c>');
            Impressao.Add('<c>' + Trim(qCl_endAd.FieldByName('cidade').AsString) + ' - ' +
              Trim(qCl_endAd.FieldByName('uf').AsString) + '</c>');
          end
          else if Campo = 'MERCADORIAS'                then
          begin
            dadosImp.bItensEmUmaLinha         := Pos('[/IT_PADRAO_UMA_LINHA]', Linha) > 0;
            dadosImp.bItensImprimirAcrescDesc := Pos('[/IT_PADRAO_ACRESC_DESC]', Linha) > 0;

            vItProd.dataSet.First;
            while not vItProd.dataSet.Eof do
            begin
              dadosImp.nItem := dadosImp.nItem + 1;

              dadosImp.sItem        := vDadosIni.StrZero( dadosImp.nItem, 3);
              dadosImp.sDescricao   := Trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString);
              dadosImp.sUnidade     := UpperCase(Trim(vItProd.dataSet.FieldByName('UNIDADE').AsString));
              dadosImp.sVlrProduto  := Format( '%0.2n', [vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat]);
              dadosImp.sCodigo      := Trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString);
              dadosImp.sVlrUnitario := Format( '%0.' + IntToStr(vDadosIni.vEmp.vCasasDecimais) + 'n', [vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat]);
              dadosImp.sQuantidade  := Format( '%0.3n', [vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat]);
              dadosImp.sAcrescimo   := Format( '%0.2n', [vItProd.dataSet.FieldByName('RATEIO_ACRESC').AsFloat]);
              dadosImp.sDesconto    := Format( '%0.2n', [vItProd.dataSet.FieldByName('RATEIO_DESC').AsFloat]);
              dadosImp.sVlrLiquido  := Format( '%0.2n', [vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsFloat +
                                                         vItProd.dataSet.FieldByName('RATEIO_ACRESC').AsFloat -
                                                         vItProd.dataSet.FieldByName('RATEIO_DESC').AsFloat]);
              if vItProd.ffloat('RATEIO_ACRESC', -2) = 0.00 then
                dadosImp.sAcrescimo := '';
              if vItProd.ffloat('RATEIO_DESC', -2) = 0.00 then
                dadosImp.sDesconto := '';

              MontarItem;

              vItProd.dataSet.Next;
            end;
          end
          else if (Campo = 'SERVICOS') and (vSing.vTipoVenda <> 'REQ') then
          begin
            dadosImp.bItensEmUmaLinha         := Pos('[/IT_PADRAO_UMA_LINHA]', Linha) > 0;
            dadosImp.bItensImprimirAcrescDesc := Pos('[/IT_PADRAO_ACRESC_DESC]', Linha) > 0;
            dadosImp.bItensImprimirTecMec     := Pos('[/IT_PADRAO_NOME_TEC_MEC]', Linha) > 0;

            vItServ.dataSet.First;
            while not vItServ.dataSet.Eof do
            begin
              dadosImp.nItem := dadosImp.nItem + 1;

              dadosImp.sItem        := vDadosIni.StrZero( dadosImp.nItem, 3);
              dadosImp.sDescricao   := Trim(vItServ.dataSet.FieldByName('DESC_SERV_PED').AsString);
              dadosImp.sUnidade     := '';
              dadosImp.sVlrProduto  := Format( '%0.2n', [vItServ.dataSet.FieldByName('VALOR_TOT_SERV').AsFloat]);
              dadosImp.sCodigo      := Trim(vItServ.dataSet.FieldByName('COD_SERVICO').AsString);
              dadosImp.sVlrUnitario := Format( '%0.2n', [vItServ.dataSet.FieldByName('VALOR_UN_SERV').AsFloat]);
              dadosImp.sQuantidade  := Format( '%0.3n', [vItServ.dataSet.FieldByName('QUANT_SERV_PED').AsFloat]);
              dadosImp.sAcrescimo   := Format( '%0.2n', [vItServ.dataSet.FieldByName('RATEIO_ACRESC').AsFloat]);
              dadosImp.sDesconto    := Format( '%0.2n', [vItServ.dataSet.FieldByName('RATEIO_DESC').AsFloat]);
              dadosImp.sVlrLiquido  := Format( '%0.2n', [vItServ.dataSet.FieldByName('VALOR_TOT_SERV').AsFloat +
                                                             vItServ.dataSet.FieldByName('RATEIO_ACRESC').AsFloat -
                                                             vItServ.dataSet.FieldByName('RATEIO_DESC').AsFloat]);
              if vItProd.ffloat('RATEIO_ACRESC', -2) = 0.00 then
                dadosImp.sAcrescimo := '';
              if vItProd.ffloat('RATEIO_DESC', -2) = 0.00 then
                dadosImp.sDesconto := '';

              MontarItem;

              if vSing.vTipoVenda = 'OS' then
                MontarTecnicoMecanicoPorServico(Linha);

              vItServ.dataSet.Next;
            end;
          end
          else if (Campo = 'SERVICOS_TERCEIROS') and (vSing.vTipoVenda <> 'REQ') then
          begin
            dadosImp.bItensEmUmaLinha         := Pos('[/IT_PADRAO_UMA_LINHA]', Linha) > 0;
            dadosImp.bItensImprimirAcrescDesc := Pos('[/IT_PADRAO_ACRESC_DESC]', Linha) > 0;

            vItServTerc.dataSet.First;
            while not vItServTerc.dataSet.Eof do
            begin
              dadosImp.nItem := dadosImp.nItem + 1;

              dadosImp.sItem        := vDadosIni.StrZero( dadosImp.nItem, 3);
              dadosImp.sDescricao   := Trim(vItServTerc.dataSet.FieldByName('DESCR_SERVT').AsString);
              dadosImp.sUnidade     := '';
              dadosImp.sVlrProduto  := Format( '%0.2n', [vItServTerc.dataSet.FieldByName('VL_SERVT').AsFloat]);
              dadosImp.sCodigo      := '';
              dadosImp.sVlrUnitario := Format( '%0.2n', [vItServTerc.dataSet.FieldByName('VL_SERVT').AsFloat]);
              dadosImp.sQuantidade  := Format( '%0.3n', [1.00]);
              dadosImp.sAcrescimo   := Format( '%0.2n', [0.00]);
              dadosImp.sDesconto    := Format( '%0.2n', [0.00]);
              dadosImp.sVlrLiquido  := Format( '%0.2n', [vItServTerc.dataSet.FieldByName('VL_SERVT').AsFloat]);
              if StrToFloat(dadosImp.sAcrescimo) = 0 then
                dadosImp.sAcrescimo := '';
              if StrToFloat(dadosImp.sDesconto) = 0 then
                dadosImp.sDesconto := '';

              MontarItem;

              vItServTerc.dataSet.Next;
            end;
          end
          else if (Campo = 'MERCADORIAS_TERCEIROS') and (vSing.vTipoVenda <> 'REQ') then
          begin
            dadosImp.bItensEmUmaLinha         := Pos('[/IT_PADRAO_UMA_LINHA]', Linha) > 0;
            dadosImp.bItensImprimirAcrescDesc := Pos('[/IT_PADRAO_ACRESC_DESC]', Linha) > 0;

            vItProdTerc.dataSet.First;
            while not vItProdTerc.dataSet.Eof do
            begin
              dadosImp.nItem := dadosImp.nItem + 1;

              dadosImp.sItem        := vDadosIni.StrZero( dadosImp.nItem, 3);
              dadosImp.sDescricao   := Trim(vItProdTerc.dataSet.FieldByName('DESCRICAO').AsString);
              dadosImp.sUnidade     := UpperCase(Trim(vItProdTerc.dataSet.FieldByName('UNIDADE').AsString));
              dadosImp.sVlrProduto  := Format( '%0.2n', [vItProdTerc.dataSet.FieldByName('VL_TOTAL').AsFloat]);
              dadosImp.sCodigo      := '';
              dadosImp.sVlrUnitario := Format( '%0.2n', [vItProdTerc.dataSet.FieldByName('VL_UNIT').AsFloat]);
              dadosImp.sQuantidade  := Format( '%0.3n', [vItProdTerc.dataSet.FieldByName('QTDE').AsFloat]);
              dadosImp.sAcrescimo   := Format( '%0.2n', [0.00]);
              dadosImp.sDesconto    := Format( '%0.2n', [0.00]);
              dadosImp.sVlrLiquido  := Format( '%0.2n', [vItProdTerc.dataSet.FieldByName('VL_TOTAL').AsFloat]);
              if StrToFloat(dadosImp.sAcrescimo) = 0 then
                dadosImp.sAcrescimo := '';
              if StrToFloat(dadosImp.sDesconto) = 0 then
                dadosImp.sDesconto := '';

              MontarItem;

              vItProdTerc.dataSet.Next;
            end;
          end
          else if Campo = 'TOTAL_ITENS' then
          begin
            if dadosImp.nQtdeItens > 0 then
              StrImp := '</fn></ae>' + ReplaceForSpace('QTDE TOTAL DE ITENS|' + vDadosIni.StrZero(dadosImp.nQtdeItens, 3), Colunas);
          end
          else if Campo = 'TOTAL_ITENS_CANCELADOS' then
          begin
            if dadosImp.nQtdeItensCanc > 0 then
              StrImp := '</fn></ae>' + ReplaceForSpace('QTDE TOTAL DE ITENS|' + vDadosIni.StrZero(dadosImp.nQtdeItensCanc, 3), Colunas);
          end
          else if Campo = 'TOTAL_MERCADORIAS' then
          begin
            if dadosImp.nTotProd > 0 then
              StrImp := '</fn></ae>' + ReplaceForSpace('TOTAL PRODUTOS R$|' + Format('%0.2n', [dadosImp.nTotProd]), Colunas);
          end
          else if Campo = 'TOTAL_SERVICOS' then
          begin
            if dadosImp.nTotServ > 0 then
              StrImp := '</fn></ae>' + ReplaceForSpace('TOTAL SERVICOS R$|' + Format('%0.2n', [dadosImp.nTotServ]), Colunas);
          end
          else if Campo = 'TOTAL_BRUTO' then
          begin
            if dadosImp.nTotBruto > 0 then
              StrImp := '</fn></ae>' + ReplaceForSpace('TOTAL R$|' + Format('%0.2n', [dadosImp.nTotBruto]), Colunas);
          end
          else if Campo = 'TOTAL_LIQUIDO' then
          begin
            if dadosImp.nTotServ > 0 then
              StrImp := '</fn></ae><n>' + ReplaceForSpace('TOTAL LIQUIDO R$|' + Format('%0.2n', [dadosImp.nTotLiquido]), Colunas) + '</n>';
          end
          else if Campo = 'TOT_PADRAO_RESUMIDO' then
          begin
            StrImp := '</fn></ae><n>' + ReplaceForSpace('TOTAL LIQUIDO R$|' + Format('%0.2n', [dadosImp.nTotLiquido]), Colunas) + '</n>';
          end
          else if Campo = 'TOT_PADRAO_DETALHADO' then
          begin
            if dadosImp.nAcrescimo > 0 then
              Impressao.Add('</fn></ae>' + ReplaceForSpace('ACRESCIMO R$|' + Format('%0.2n', [dadosImp.nAcrescimo]), Colunas));
            if dadosImp.nDesconto > 0 then
              Impressao.Add('</fn></ae>' + ReplaceForSpace('DESCONTO R$|' + Format('%0.2n', [dadosImp.nDesconto]), Colunas));
            Impressao.Add('</fn></ae><n>' + ReplaceForSpace('TOTAL LIQUIDO R$|' + Format('%0.2n', [dadosImp.nTotLiquido]), Colunas) + '</n>');
          end
          else if Pos('.', Campo) > 0 then
          begin
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_UMA_LINHA]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_UMA_LINHA]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_ACRESC_DESC]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_ACRESC_DESC]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC1]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC1]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC2]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC2]', '', [rfReplaceAll, rfIgnoreCase]);

            bGetField := GetField(StrFormatField);
            if not bGetField then
            begin
              if Campo = 'PEDVENDA.VENCIMENTO' then
              begin
                StrVal := retornaValor('select min(fp.data_venc) as valor from formpagamento fp ' +
                  ' where fp.nrequisicao= ' + DataSet.FieldByName('NPED').AsString +
                  ' and tpdocs=' + quotedstr(trim(vSing.vTipoVenda)) +
                  ' and fp.cod_empresa= ' + vDadosIni.codEmpresa +
                  ' and fp.ativo=1');
                FormatValue(StrVal, StrFormatField);
                StrImp := StrImp + StrVal;
              end
              else if Campo = 'PEDVENDA.PESOBRUTO' then
              begin
                StrVal := FloatToStr(vItProd.getPesoBrutoProdutos);
                FormatValue(StrVal, StrFormatField);
                StrImp := StrImp + StrVal;
              end;
            end
            else
            begin
              if Campo = 'TIPO' then
                StrImp := StrImp + vDadosIni.IfThen(Trim(Field.AsString) = 'REQ', 'Venda',
                          vDadosIni.IfThen(Trim(Field.AsString) =  'OS', 'Ordem de Serviço',
                                                                   'Orçamento'))
              else if Trim(StrFormatField) <> '' then
              begin
                StrVal := Trim(Field.AsString);
                FormatValue(StrVal, StrFormatField);

                StrImp := StrImp + StrVal;
              end
              else
                StrImp := StrImp + Trim(Field.AsString);
            end;
          end
          else
          begin
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_UMA_LINHA]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_UMA_LINHA]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_ACRESC_DESC]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_ACRESC_DESC]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC1]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC1]', '', [rfReplaceAll, rfIgnoreCase]);
            StrImp := StringReplace(StrImp, '[/IT_PADRAO_NOME_TEC_MEC2]', '', [rfReplaceAll, rfIgnoreCase]);
            Linha  := StringReplace(Linha , '[/IT_PADRAO_NOME_TEC_MEC2]', '', [rfReplaceAll, rfIgnoreCase]);

            StrImp := StrImp + Linha;
            Linha  := '';
          end;
        end;

        if Pos('|', StrImp) > 0 then
          StrImp := ReplaceForSpace(StrImp, vDadosIni.IfThen(Condensado, ColunasCondensado, Colunas));

        if StrImp <> '' then
          Impressao.Add(StrImp);

        if Pos('</c>', Modelo[I]) > 0 then
          Condensado := False;
      end;

      if MatchText(AgenteId, ['', 'Local']) then
      begin
        Resposta := HwPosPrintFromText(WideString(Impressao.Text), WideString(ConfName), vDadosIni.IfThen(FDadosImpressao.Imprimir2Vias, 2, 1));
        if Resposta = 0 then
          ShowAtencao(string(HwPosUltimoErro));
      end
      else
      begin
        if not cloud_agente_print_text(WideString(Impressao.Text), WideString(Format('confName=%s;agentId=%s;copies=%d;cnpj=%s', [ConfName, AgenteId, IfThen(FDadosImpressao.Imprimir2Vias, 2, 1), vDadosIni.vEmp.vCNPJ]))) then
          ShowAtencao(string(cloud_agente_last_error));
      end;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);

        vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDavImpNaoFiscal - ' + e.Message, 'pedvenda');
      end;
    end;
  finally
  	if Assigned(qEmpresa) then
  		lib_querys(qEmpresa);

    if Assigned(qCondPag) then
    	lib_querys(qCondPag);

    if Assigned(qCliente) then
    	lib_querys(qCliente);

    if Assigned(qColab) then
      lib_querys(qColab);

    if Assigned(qVeiculo) then
      lib_querys(qVeiculo);

    if Assigned(qCl_endAd) then
      lib_querys(qCl_endAd);

  	if Assigned(Config) then
    	FreeAndNil(Config);

    if Assigned(Modelo) then
    	FreeAndNil(Modelo);

    if Assigned(Impressao) then
    	FreeAndNil(Impressao);

    vDadosIni.logsPedvenda(Self.ClassName + '.imprimirDavImpNaoFiscal - end', 'pedvenda');
  end;
end;

function TPedVenda.incluirKit(codigoKit, pCodVendedor, pCodTecnicoMecanico: integer;
  mesmaSegmentacao: boolean; pVendaRapida: boolean): boolean;
var
  codSegmento, codServico, vsqlAdicional: string;
  vest: Real;
  vQtdeItem, vQtdDisponivelItemKit: Real;
  vIdKit: Integer;
  vOK: boolean;
begin
  Result := false;
  vsqlAdicional := '';
  codSegmento := '';
  codServico := '';
  vItProd.vInsercaoKit := true;
  try
    if not (vItProd.dataSet.State in [dsEdit, dsInsert]) then
      vItProd.Insert;
    vItProd.nCodVendedorKit := pCodVendedor;
    vItProd.nCodTecnicoMecanico := pCodTecnicoMecanico;
    try
      vKit.abreKitProd(codigoKit);
      if vKit.dataSet.IsEmpty then
        raise exception.create('Kit não encontrado');
      if (vDadosIni.vEmp.vSegmentaProdVenda = 'S1') and (mesmaSegmentacao) then
      begin
        codServico := IntToStr(getCodigoServicoSegmento);
        if StrToInt(codServico) = -1 then
          Exit;
      end;
      vKit.vProdKit.First;
      if (vKit.dataSet.FieldByName('kit_todo').AsString = 'S') and (vDadosIni.vEstoqueNegativo <> 'S') then
      begin
        while not vKit.vProdKit.Eof do
        begin
          vQtdeItem := vKit.vProdKit.dataSet.FieldByName('quant_prod_kit').AsFloat;
          vQtdeItem := vQtdeItem + vItProd.retornaQtdExistente(vKit.vProdKit.dataSet.FieldByName('num_fab_prod').AsString);
          if not temEstoqueProduto(vKit.vProdKit.dataSet.FieldByName('grupo_prod').AsInteger,
            vKit.vProdKit.dataSet.FieldByName('cod_prod').AsString, vQtdeItem) then
          begin
            vItProd.vProduto.buscaProduto(
            	vKit.vProdKit.dataSet.FieldByName('grupo_prod').AsInteger,
              vKit.vProdKit.dataSet.FieldByName('cod_prod').AsString);
            raise exception.create('Produto ' + QuotedStr(trim(vKit.vProdKit.dataSet.FieldByName('num_fab_prod').AsString)) +
              ' - ' + trim(vKit.vProdKit.dataSet.FieldByName('descr_prod').AsString) + sLineBreak +
              'sem estoque suficiente.' + sLineBreak +
              'Quantidade requisitada = ' + floattostr(vQtdeItem) + '.' + sLineBreak +
              'Quantidade disponível = ' + floattostr(vItProd.vProduto.vQtdEstoqueDisponivel) + '.');
          end;
          vKit.vProdKit.Next;
        end;
      end;

      buscas.Close;
		  buscas.SQL.Text := 'SELECT GEN_ID(INC_KIT_PEDVENDA_PROD,1) AS VALOR from RDB$DATABASE';
		  buscas.Open;
      
		  vIdKit := buscas.FieldByName('VALOR').asinteger;

      vKit.vProdKit.First;
      //No bloco abaixo joga o kit inteiro... (joga com estoque negativo caso não tenha no estoque e o vendedor tenha senha para trabalhar com estoque negativo.)
      if (vKit.dataSet.FieldByName('kit_todo').AsString = 'S') then //and (vDadosIni.vEstoqueNegativo <> 'S') then
      begin
        while not vKit.vProdKit.Eof do
        begin
          try
            if (vDadosIni.vEmp.vSegmentaProdVenda = 'S1') and (not mesmaSegmentacao) then
            begin
