function TPedVenda._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  vCampoTemp, vCondicaoTmp: string;
begin
  result := true;
  rPED.vSqlAdicional := '';

  if rPED.vAdicional then
  begin
    rPED.vValorAd := UpperCase(rPED.vValorAd);
    if rPED.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rPED.vDataIniAd);
      except
        rPED.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rPED.vDataFimAd);
      except
        rPED.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rPED.vDataIniAd <> '' then
          rPED.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rPED.vDataIniAd)));
        if rPED.vDataFimAd <> '' then
          rPED.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rPED.vDataFimAd)));
      end;
    end
    else if rPED.vValorAd = '' then
      exit;

    vCampoTemp:= '';
    if UpperCase(trim(rPED.vCampoAd)) = 'Placa' then
      vCampoTemp := 'PEDVENDA.PLACA'
    else if UpperCase(trim(rPED.vCampoAd)) = 'MODELO VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.DESCMODELO, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'ESPECIE VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ESPECIE, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'MARCA VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.MARCA_V, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COR VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.COR, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COMBUSTIVEL VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.COMBUSTIVEL, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'ANO FABRICACAO VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ANOFAB, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'ANO MODELO VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.ANOMOD, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'CILINDROS VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.CILINDROS, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'CILINDRADA VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.CILINDRADA, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'HP VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.HP, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'LOTACAO VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.LOTACAO, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'MOTOR VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.MOTOR, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'RENAVAM VEICULO' then
      vCampoTemp := 'IIF(RETV.ICODIGO > 0, VEICULOS.RENAVAM, NULL)'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NOME EQUIPAMENTO' then
      vCampoTemp := 'EQUIPAMENTO.NOM_EQUIP'
    else if UpperCase(trim(rPED.vCampoAd)) = 'MODELO EQUIPAMENTO' then
      vCampoTemp := 'EQUIPAMENTO.MODELO'
    else if UpperCase(trim(rPED.vCampoAd)) = 'MARCA EQUIPAMENTO' then
      vCampoTemp := 'EQUIPAMENTO.MARCA'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COR EQUIPAMENTO' then
      vCampoTemp := 'EQUIPAMENTO.COR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NUM SERIE EQUIPAMENTO' then
	  	vCampoTemp := 'EQUIPAMENTO.N_SERIE'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NOME CLIENTE (NOME FANTASIA)' then
      vCampoTemp := 'CLIENTES.NOME_CLIENTE'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NOME CLIENTE (RAZAO SOCIAL)' then
      vCampoTemp := 'CLIENTES.RAZAO'
    else if UpperCase(trim(rPED.vCampoAd)) = 'CEP CLIENTE' then
      vCampoTemp := 'CLIENTES.CEP'
    else if UpperCase(trim(rPED.vCampoAd)) = 'ENDERECO CLIENTE' then
      vCampoTemp := 'CLIENTES.ENDERECO'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NUM ENDERECO CLIENTE' then
      vCampoTemp := 'CLIENTES.NUM_END_CLIENTE'
    else if UpperCase(trim(rPED.vCampoAd)) = 'TELEFONE CLIENTE' then
      vCampoTemp := 'CLIENTES.FONE_CLIENTE'
    else if UpperCase(trim(rPED.vCampoAd)) = 'CELULAR CLIENTE' then
      vCampoTemp := 'CLIENTES.FONE_CELULAR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'EMAIL CLIENTE' then
		vCampoTemp := 'CLIENTES.EMAIL'
    else if UpperCase(trim(rPED.vCampoAd)) = 'ESTADO' then
      vCampoTemp := 'ESTADOS.SIGLA_UF'
    else if UpperCase(trim(rPED.vCampoAd)) = 'CIDADE' then
      vCampoTemp := 'CIDADES.NOME_CIDADE'
  	 else if UpperCase(trim(rPED.vCampoAd)) = 'BAIRRO' then
	   vCampoTemp := 'BAIRROS.NOME_BAIRRO'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COD LOCALIDADE' then
      vCampoTemp := 'CLIENTES.COD_LOCALIDADE'
  	 else if UpperCase(trim(rPED.vCampoAd)) = 'LOCALIDADE' then
      vCampoTemp := 'LOCALIDADE.LOCALIDADE'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COD SETOR' then
      vCampoTemp := 'LOCALIDADE.COD_SETOR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'SETOR' then
      vCampoTemp := 'SETOR.SETOR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'COND PAG' then
      vCampoTemp := 'COND_PAG.DESC_COND_PAG'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NOME VENDEDOR' then
  		vCampoTemp := 'COLABORADOR.NOME_VENDEDOR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'NOME USUARIO FECH' then
  		vCampoTemp := 'USFECH.NOME_VENDEDOR'
    else if UpperCase(trim(rPED.vCampoAd)) = 'VALOR TOTAL DEVOLVIDO' then
    	vCampoTemp := 'DEV_VND.VALOR_TOTAL_DEV'
    else if UpperCase(trim(rPED.vCampoAd)) = 'VALOR TOTAL APOS DEVOLUCAO' then
    	vCampoTemp := 'DEV_VND.VALOR_TOTAL_APOS_DEV';

    if Trim(vCampoTemp) <> '' then
    begin
      vCondicaoTmp := rPED.vCondicaoAd;
      if vCondicaoTmp = 'Igual' then
        vCondicaoTmp := '='
      else if vCondicaoTmp = 'Maior' then
        vCondicaoTmp := '>'
      else if vCondicaoTmp = 'Maior ou Igual' then
        vCondicaoTmp := '>='
      else if vCondicaoTmp = 'Menor' then
        vCondicaoTmp := '<'
      else if vCondicaoTmp = 'Menor ou Igual' then
        vCondicaoTmp := '<='
      else if vCondicaoTmp = 'Diferente' then
        vCondicaoTmp := '<>'
      else if (vCondicaoTmp = 'Esta contido') then
        vCondicaoTmp := 'like'
      else if (vCondicaoTmp = 'Começa') then
        vCondicaoTmp := 'Começa'
      else
        vCondicaoTmp := '=';
      if vCondicaoTmp = 'like' then
        rPED.vSqlAdicional := rPED.vSqlAdicional + ' and ' + vCampoTemp + ' like ' + QuotedStr('%' + rPED.vValorAd + '%')
      else if vCondicaoTmp = 'Começa' then
      begin
      	if (UpperCase(trim(rPED.vCampoAd)) = 'PLACA') and (trim(vDadosIni.retornaPlacaNovaAntiga(rPED.vValorAd)) <> trim(rPED.vValorAd)) then
          rPED.vSqlAdicional := rPED.vSqlAdicional + ' and ((' + vCampoTemp + ' like ' + QuotedStr(UpperCase(trim(rPED.vValorAd)) + '%') + ') ' +
          	' or (' + vCampoTemp + ' like ' + QuotedStr(UpperCase(trim(vDadosIni.retornaPlacaNovaAntiga(rPED.vValorAd))) + '%') + ')) '
        else
	        rPED.vSqlAdicional := rPED.vSqlAdicional + ' and ' + vCampoTemp + ' like ' + QuotedStr(rPED.vValorAd + '%')
      end
      else
      begin
      	if (UpperCase(trim(rPED.vCampoAd)) = 'PLACA') and (trim(vDadosIni.retornaPlacaNovaAntiga(rPED.vValorAd)) <> trim(rPED.vValorAd)) then
        	rPED.vSqlAdicional := rPED.vSqlAdicional + ' and ((' + vCampoTemp + ' ' + vCondicaoTmp + ' ' + QuotedStr(UpperCase(trim(rPED.vValorAd))) + ') ' +
          	' or (' + vCampoTemp + ' ' + vCondicaoTmp + ' ' + QuotedStr(UpperCase(trim(vDadosIni.retornaPlacaNovaAntiga(rPED.vValorAd)))) + ')) '
        else
	        rPED.vSqlAdicional := rPED.vSqlAdicional + ' and ' + vCampoTemp + ' ' + vCondicaoTmp + ' ' +QuotedStr(rPED.vValorAd);
      end;
      rPED.vValorAd := '';
      Exit;
    end;

    if rPED.vCondicaoAd = 'Igual' then
      rPED.vCondicaoAd := '='
    else if rPED.vCondicaoAd = 'Maior' then
      rPED.vCondicaoAd := '>'
    else if rPED.vCondicaoAd = 'Maior ou Igual' then
      rPED.vCondicaoAd := '>='
    else if rPED.vCondicaoAd = 'Menor' then
      rPED.vCondicaoAd := '<'
    else if rPED.vCondicaoAd = 'Menor ou Igual' then
      rPED.vCondicaoAd := '<='
    else if rPED.vCondicaoAd = 'Diferente' then
      rPED.vCondicaoAd := '<>'
    else if (rPED.vCondicaoAd = 'Esta contido') then
      rPED.vCondicaoAd := 'like'
    else if (rPED.vCondicaoAd = 'Começa') then
      rPED.vCondicaoAd := 'Começa'
    else
      rPED.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rPED.vCampoAd) then
        begin
//          if rPED.vCampo = rPED.vCampoAd then
//          begin
//            rPED.vsqlAdicional := '';
//            exit;
//          end;
          rPED.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rPED.vCondicaoAd = 'Começa') or (rPED.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rPED.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rPED.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rPED.vCondicaoAd := '=';
            rPED.vValorAd := vDadosIni.trocaVirgulaPorPonto(rPED.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (rPED.vDataIniAd <> '') and (rPED.vDataFimAd <> '') then
              rPED.vSqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd +
                ' >= ' + rPED.vDataIniAd + ' AND ' + ' PEDVENDA.' + rPED.vCampoAd + ' <= ' + rPED.vDataFimAd
            else if (rPED.vDataFimAd <> '') then
              rPED.vsqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd +
                ' <= ' + rPED.vDataIniAd
            else if (rPED.vDataIniAd <> '') and (rPED.vDataFimAd <> '') then
              rPED.vsqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd +
                ' >= ' + ' PEDVENDA.' + rPED.vDataIniAd;
            Break;
          end;
          if rPED.vCondicaoAd = 'like' then
            rPED.vsqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd +
              ' like ' + QuotedStr('%' + rPED.vValorAd + '%')
          else if rPED.vCondicaoAd = 'Começa' then
            rPED.vsqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd +
              ' like ' + QuotedStr(rPED.vValorAd + '%')
          else
            rPED.vsqlAdicional := ' AND ' + rPED.vsqlAdicional + ' PEDVENDA.' + rPED.vCampoAd + ' ' +
              rPED.vCondicaoAd + ' ' + QuotedStr(rPED.vValorAd);
          Break;
        end;
      end;
    end;
  end;
end;

function TPedVenda._ExibirInfPoliticaSel(pRVnd: TDataSet; pDataSetOpPag: TDataSet; var pLabel: TLabel): string;
begin
	if pDataSetOpPag.FieldByName('COD_COND_PAG').AsInteger <= 0 then
  begin
  	pLabel.Caption := '';
    pLabel.Visible := False;
    Exit;
  end;

  pLabel.Visible := True;
	pLabel.Caption := 'CONDIÇÃO DE PAGAMENTO: ' + trim(pDataSetOpPag.FieldByName('DESC_COND_PAG').AsString) + chr(13) + chr(13);

	if dataSet.FieldByName('VALOR_TOTAL').AsFloat >= pDataSetOpPag.FieldByName('VALORMINDOC').AsFloat then
  	pLabel.Caption := pLabel.Caption +
    	'Valor Liquido do documento maior ou igual Valor Min Doc da política  (X)' + chr(13)
  else
  	pLabel.Caption := pLabel.Caption +
    	'Valor Min da política maior que o valor liquido do documento         ( )' + chr(13);

  if pDataSetOpPag.FieldByName('VALORMAXDOC').AsFloat >= dataSet.FieldByName('VALOR_TOTAL').AsFloat then
  	pLabel.Caption := pLabel.Caption +
    	'Valor Max Doc da política maior ou igual Valor Liquido do documento  (X)' + chr(13)
  else
  	pLabel.Caption := pLabel.Caption +
    	'Valor Liquido do documento maior que o Valor Max Doc da política     ( )' + chr(13);

  if trim(pRVnd.FieldByName('PESSOAFISICA').AsString) = 'A' then
  	pLabel.Caption := pLabel.Caption +
      'Tipo do cliente (pessoa física/jurídica) é compatível com política   (X)' + chr(13)
  else if FTipoPessoaRegraVND = 'S' then
  begin
    if trim(pRVnd.FieldByName('PESSOAFISICA').AsString) <> trim(FTipoPessoaRegraVND) then
      pLabel.Caption := pLabel.Caption +
      'Tipo do cliente (pessoa física) é incompatível com a política        ( )' + chr(13)
    else
      pLabel.Caption := pLabel.Caption +
      'Tipo do cliente (pessoa física) é compatível com a política          (X)' + chr(13);
  end
  else if FTipoPessoaRegraVND = 'N' then
  begin
  	if trim(pRVnd.FieldByName('PESSOAFISICA').AsString) <> trim(FTipoPessoaRegraVND) then
      pLabel.Caption := pLabel.Caption +
      'Tipo do cliente (pessoa jurídica) é incompatível com a política      ( )' + chr(13)
    else
      pLabel.Caption := pLabel.Caption +
      'Tipo do cliente (pessoa jurídica) é compatível com a política        (X)' + chr(13);
  end;

  if trim(pRVnd.FieldbyName('TIPO').AsString) <> trim(FTipoRegraVND) then
  	pLabel.Caption := pLabel.Caption +
  		'Tipo do documento (REQ/OS) é incompatível com a política             ( )' + chr(13)
  else
  	pLabel.Caption := pLabel.Caption +
  		'Tipo do documento (REQ/OS) é compatível com a política               (X)' + chr(13);

	if trim(pRVnd.FieldbyName('TIPOVND_OS').AsString) <> trim(FTipoVndOSRegraVND) then
  	pLabel.Caption := pLabel.Caption +
  		'Tipo de venda do documento é incompatível com a política             ( )' + chr(13)
  else
  	pLabel.Caption := pLabel.Caption +
  		'Tipo de venda do documento é compatível com a política               (X)' + chr(13);

  if pRVnd.FieldbyName('COD_COND_PAG').AsInteger <> dataSet.FieldByName('cod_cond_pag').AsInteger then
  	pLabel.Caption := pLabel.Caption +
    	'Condição de pagamento do documento é incompatível com a política     ( )' + chr(13)
  else
  	pLabel.Caption := pLabel.Caption +
    	'Condição de pagamento do documento é compatível com a política       (X)' + chr(13);

  if pDataSetOpPag.FieldbyName('DOCS').AsString = 'S2' then
  begin
    if pDataSetOpPag.FieldbyName('QTDE_PARC').AsInteger > pDataSetOpPag.FieldbyName('MAXPARCELAS').AsInteger then
      pLabel.Caption := pLabel.Caption +
      'Qtde de Parcela do documento maior que Max Parcela da política       ( )' + chr(13)
    else
      pLabel.Caption := pLabel.Caption +
      'Qtde de Parcela do documento menor ou igual Max Parcela da política  (X)' + chr(13);
  end;

  if pDataSetOpPag.FieldbyName('DOCS').AsString = 'S2' then
  begin
    if pDataSetOpPag.FieldbyName('DIAS_PRAZO').AsInteger > pDataSetOpPag.FieldbyName('PRAZOMAX').AsInteger then
      pLabel.Caption := pLabel.Caption +
      'Dias de Prazo do documento maior que Max Prazo da política           ( )' + chr(13)
    else
      pLabel.Caption := pLabel.Caption +
      'Dias de Prazo do documento menor ou igual Max Prazo da política      (X)' + chr(13);
  end;

  if (vSing.vValorDescontoProd <= 0)
  	or (pDataSetOpPag.FieldByName('MAX_DESCPROD').IsNull) then
    pLabel.Caption := pLabel.Caption +
    	'Desconto apurado produto menor ou igual Max Desc Prod da política    (X)' + chr(13)
  else if ((vSing.vValorDescontoProd /
    dataSet.FieldbyName('TOT_PROD').AsFloat) * 100) > pDataSetOpPag.FieldByName('MAX_DESCPROD').AsFloat then
    pLabel.Caption := pLabel.Caption +
    	'Desconto apurado produto maior que Max Desc Prod da política         ( )' + chr(13)
  else
    pLabel.Caption := pLabel.Caption +
    	'Desconto apurado produto menor ou igual Max Desc Prod da política    (X)' + chr(13);

  if vSing.vTipoVenda = 'OS' then
