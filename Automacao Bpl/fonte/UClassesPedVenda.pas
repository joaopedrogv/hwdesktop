function TMecanicos_OS.post: boolean;
var
  cod_servico: string;
  codigo_nop: string;
  nped, vTipo: string;
begin
  try
    Result := true;
    if IsEmpty then
      exit;
    if dataSet.FieldByName('cod_servico').AsInteger = 0 then
      raise exception.create('Serviço não encontrado');
    if dataSet.FieldByName('cod_vendedor').AsInteger = 0 then
      raise exception.create('Vendedor não informado');
    if dataSet.FieldByName('per_comissao').AsString = '' then
      raise exception.create('% de Comissão não informado');
    if (vDadosIni.StrToFloatFormat(dataSet.FieldByName('per_comissao').AsFloat, 2) <= 0) or
      (vDadosIni.StrToFloatFormat(dataSet.FieldByName('per_comissao').AsFloat, 2) > 100) then
      raise exception.create('% de Comissão inválido');
    if not (dataSet.State in [dsInsert, dsEdit]) then
      exit;

    dataSet.FieldByName('per_comissao').AsFloat := vDadosIni.StrToFloatFormat(dataSet.FieldByName('per_comissao').AsFloat,2);
    result := inherited Post;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TMecanicos_OS.validarCampos: boolean;
begin
  Result := true;
  if (dataSet.State in [dsInsert, dsEdit]) or IsEmpty then
    exit;
  try
    first;
    while not eof do
    begin
      if dataSet.FieldByName('cod_servico').AsInteger = 0 then
        raise exception.create('Serviço não encontrado');
      if dataSet.FieldByName('cod_vendedor').AsInteger = 0 then
        raise exception.create('Vendedor não informado');
      if dataSet.FieldByName('per_comissao').AsString = '' then
        raise exception.create('% de Comissão não informado');
      if (vDadosIni.StrToFloatFormat(dataSet.FieldByName('per_comissao').AsFloat, 2) <= 0) or
        (vDadosIni.StrToFloatFormat(dataSet.FieldByName('per_comissao').AsFloat, 2) > 100) then
        raise exception.create('% de Comissão inválido');
      next;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

