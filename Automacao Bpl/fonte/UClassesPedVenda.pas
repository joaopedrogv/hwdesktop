function TPedVenda.AlterarVendedorFormPagCreditosCheques(pNPED: integer; pTipo: string): boolean;
var
  vAlterarVendedor, vAlterarCliente: boolean;
  vNomeCliente, vRazaoCliente, vCNPJCPFCliente: string;
  nCodLanc: string;
  vcodLancOld: Integer;
  vQuery, vQuery2: TIBQuery;


  procedure verificaPrestacaoRecursiva(pPrestacao: Integer);
  begin
    buscas.Close;
    buscas.SQL.Text := 'UPDATE FORMPAGAMENTO SET ';
    if (vAlterarVendedor) then
      buscas.SQL.Text := buscas.SQL.Text + 'OPERADOR = :OPERADOR';
    if ((vAlterarVendedor) and (vAlterarCliente)) then
      buscas.SQL.Text := buscas.SQL.Text + ',';
    if (vAlterarCliente) then
      buscas.SQL.Text := buscas.SQL.Text + 'COD_CLIENTE = :COD_CLIENTE, CLIENTE = :CLIENTE';
    buscas.SQL.Text := buscas.SQL.Text +  
      ' WHERE NREQUISICAO = :NREQUISICAO AND TPDOCS = :TPDOCS ' +
      ' AND ATIVO = 1 AND COD_EMPRESA = :COD_EMPRESA';
    if (vAlterarVendedor) then
      buscas.Params.ParamByName('OPERADOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
    if (vAlterarCliente) then
    begin
      buscas.Params.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      buscas.Params.ParamByName('CLIENTE').AsString := Copy(vNomeCliente, 1, 60);
    end;
    buscas.Params.ParamByName('NREQUISICAO').AsInteger := pPrestacao;
    buscas.Params.ParamByName('TPDOCS').AsString := 'PRE';
    buscas.Params.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := 'UPDATE CONTROLE_CHEQUE SET ';
    if (vAlterarVendedor) then
      buscas.SQL.Text := buscas.SQL.Text + 'CODIGO_VEND = :CODIGO_VEND';
    if (vAlterarVendedor) and (vAlterarCliente) then
      buscas.SQL.Text := buscas.SQL.Text + ',';
    if (vAlterarCliente) then
      buscas.SQL.Text := buscas.SQL.Text + 'COD_CLIENTE = :COD_CLIENTE, NOME_CH = :NOME_CH, RAZAO = :RAZAO, CPFCGC = :CPFCGC';
    buscas.SQL.Text := buscas.SQL.Text +  
      ' WHERE TP_DOC_V = :TP_DOC_V AND N_DOC_V = :N_DOC_V AND CODIGO_EMP = :CODIGO_EMP';
    if (vAlterarVendedor) then    
      buscas.Params.ParamByName('CODIGO_VEND').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
    if (vAlterarCliente) then
    begin
      buscas.Params.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
      buscas.Params.ParamByName('NOME_CH').AsString := Copy(vNomeCliente, 1, 35);
      buscas.Params.ParamByName('RAZAO').AsString := Copy(vRazaoCliente, 1, 60);
      buscas.Params.ParamByName('CPFCGC').AsString := vCNPJCPFCliente;
    end;
    buscas.Params.ParamByName('N_DOC_V').AsInteger := pPrestacao;
    buscas.Params.ParamByName('TP_DOC_V').AsString := 'PRE';
    buscas.Params.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;

    vQuery.Close;
    vQuery.SQL.Text := 'SELECT CC.TP_DOC_V, CC.N_DOC_V, CC.LOTE_CXL FROM CONTROLE_CREDITOS CC' +
      ' WHERE CC.CODIGO_EMP = ' + vDadosIni.codEmpresa + ' AND CC.N_DOC_V = ' + IntToStr(pPrestacao);
    vQuery.Open;

    vQuery.First;
    while not vQuery.Eof do
    begin
      if (Trim(vQuery.FieldByName('TP_DOC_V').AsString) = 'PRE') then
      begin
        buscas.Close;
        buscas.SQL.Text := 'UPDATE CONTROLE_CREDITOS SET ';
        if (vAlterarVendedor) then        
          buscas.SQL.Text := buscas.SQL.Text + 'CODIGO_VEND = :CODIGO_VEND';
        if (vAlterarVendedor) and (vAlterarCliente) then
          buscas.SQL.Text := buscas.SQL.Text + ',';
        if (vAlterarCliente) then
          buscas.SQL.Text := buscas.SQL.Text + 'COD_CLIENTE = :COD_CLIENTE, NOME_C = :NOME_C, RAZAO = :RAZAO, CPFCGC = :CPFCGC';
        buscas.SQL.Text := buscas.SQL.Text +
          ' WHERE TP_DOC_V = :TP_DOC_V AND N_DOC_V = :N_DOC_V AND CODIGO_EMP = :CODIGO_EMP';
        if (vAlterarVendedor) then
          buscas.Params.ParamByName('CODIGO_VEND').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
        if (vAlterarCliente) then
        begin
          buscas.Params.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
          buscas.Params.ParamByName('NOME_C').AsString := Copy(vNomeCliente, 1, 35);
          buscas.Params.ParamByName('RAZAO').AsString := Copy(vRazaoCliente, 1, 60);
	       buscas.Params.ParamByName('CPFCGC').AsString := vCNPJCPFCliente;
        end;
        buscas.Params.ParamByName('N_DOC_V').AsInteger := vQuery.FieldByName('N_DOC_V').AsInteger;
        buscas.Params.ParamByName('TP_DOC_V').AsString := vQuery.FieldByName('TP_DOC_V').AsString;
        buscas.Params.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := 'UPDATE CONTROLE_CHEQUE SET ';
        if (vAlterarVendedor) then        
          buscas.SQL.Text := buscas.SQL.Text + 'CODIGO_VEND = :CODIGO_VEND';
        if (vAlterarVendedor) and (vAlterarCliente) then
          buscas.SQL.Text := buscas.SQL.Text + ',';
        if (vAlterarCliente) then
          buscas.SQL.Text := buscas.SQL.Text + 'COD_CLIENTE = :COD_CLIENTE, NOME_CH = :NOME_CH, RAZAO = :RAZAO, CPFCGC = :CPFCGC';
        buscas.SQL.Text := buscas.SQL.Text +
         ' WHERE TP_DOC_V = :TP_DOC_V AND N_DOC_V = :N_DOC_V AND CODIGO_EMP = :CODIGO_EMP';
        if (vAlterarVendedor) then        
          buscas.Params.ParamByName('CODIGO_VEND').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
        if (vAlterarVendedor) and (vAlterarCliente) then
        begin
          buscas.Params.ParamByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
          buscas.Params.ParamByName('NOME_CH').AsString := Copy(vNomeCliente, 1, 35);
          buscas.Params.ParamByName('RAZAO').AsString := Copy(vRazaoCliente, 1, 60);
	       buscas.Params.ParamByName('CPFCGC').AsString := vCNPJCPFCliente;
        end;
        buscas.Params.ParamByName('N_DOC_V').AsInteger := vQuery.FieldByName('LOTE_CXL').AsInteger;
        buscas.Params.ParamByName('TP_DOC_V').AsString := vQuery.FieldByName('TP_DOC_V').AsString;
        buscas.Params.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := 'UPDATE BAIXA_CREDITOS SET ';
        if (vAlterarVendedor) then
