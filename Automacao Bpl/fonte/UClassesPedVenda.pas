function TPedVenda._abreFormMecanicoEspecifico(pcod_servico: Double): Boolean;
var
  formulario: TfrmPadrao;
  vCod_vendedor: string;
begin
  result := false;
  try
    formulario := TfrmPadrao.Create(Application);
    if DtmAgenda = nil then
      DtmAgenda := TDtmAgenda.Create(DtmAgenda);

    if vAgenda = nil then
      vAgenda := TAgenda.create;

    buscas.Close;
    buscas.SQL.Text := 'select t.*, s.desc_servico, c.nome_vendedor from tipo_servico_mecanico t ' +
      ' inner join colaborador c on c.cod_vendedor = t.cod_vendedor and c.cod_empresa = c.cod_empresa ' +
      ' inner join tipo_servico s on s.cod_servico = t.cod_servico ' +
      ' where t.cod_servico = ' + FloatToStr(pcod_servico) + ' and t.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;

    buscas.FetchAll;
    buscas.First;
    while not buscas.Eof do
    begin
      if Trim(vCod_vendedor) = '' then
        vCod_vendedor := buscas.FieldByName('cod_vendedor').AsString
      else
        vCod_vendedor := vCod_vendedor + ', ' + buscas.FieldByName('cod_vendedor').AsString;
      buscas.Next;
