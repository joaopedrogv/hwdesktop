              buscas.Params.ParamByName('DESCR_PROD').AsString := copy(trim(vItProd.dtSetIt.FieldByName('DESCR_PROD_PED').AsString), 1, 75);
              buscas.Params.ParamByName('VLTOT').AsFloat := vItProd.dtSetIt.FieldByName('VLTOT_PED_ITEM').AsFloat;
              buscas.Params.ParamByName('CODIGO_NOP').AsFloat := vItProd.dtSetIt.FieldByName('CODIGO_NOP').AsFloat;
              buscas.Params.ParamByName('NDOC').AsInteger := nVenda;
              buscas.Params.ParamByName('TPDOC').AsString := pTipo;
              buscas.Params.ParamByName('COD_CLIENTE').AsInteger := dtSetOrcTemp.FieldByName('COD_CLIENTE').AsInteger;
              buscas.ExecSQL;

              if not (pos(IntToStr(nVenda), vNPEDsORCMesclados) > 0) then
              begin
                if vNPEDsORCMesclados = '' then
                  vNPEDsORCMesclados := IntToStr(nVenda)
                else
                  vNPEDsORCMesclados := vNPEDsORCMesclados + ',' + IntToStr(nVenda);
              end;
            end;
          end;
        end
        else
        begin
          if (trim(vItProd.dtSetIt.FieldByName('STATUS').AsString) <> 'CANCELADO') and
            (trim(vItProd.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
          begin
            if validarestoqueItProd(pNPED, vItProd.dtSetIt.FieldByName('GRUPO_PROD').AsInteger,
              vItProd.dtSetIt.FieldByName('COD_GRADE').AsInteger, pTipo,
              vItProd.dtSetIt.FieldByName('COD_PROD').AsString,
              vItProd.dtSetIt.FieldByName('quant_ped_item').AsFloat) then
            begin
              dtSetSincIt.Insert;
              for i := 0 to vItProd.dtSetIt.Fields.Count - 1 do
                if (vItProd.dtSetIt.Fields[I].FieldName <> 'SELEC')
                	and (vItProd.dtSetIt.Fields[I].FieldName <> 'SEL')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'MAX_DESC_TAB_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'QUANT_ITEM_DEV_CONV')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'QUANT_PED_ITEM_CONV')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'VLUN_PED_ITEM_LIQ')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'VLUN_PED_ITEM_CONV')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'VLUN_PED_ITEM_CONV_LIQ')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'VLUN_PED_NF_CONV')
                	and (vItProd.dtSetIt.Fields[I].FieldName <> 'QTDAMESCLAR')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'QTDAMESCLAR_CONV')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'FATOR_CONV_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'VLTOT_PED_ITEM_LIQ')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'RATEIO_DESC_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'RATEIO_ACRESC_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'PESO_LIQ_PROD_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'PESO_BRUT_PROD_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'QUANT_DEV_ITEM_TEMP')
                  and (vItProd.dtSetIt.Fields[I].FieldName <> 'QUANT_DEV_ITEM_TEMP_CONV') then
                  	dtSetSincIt.FieldByName(vItProd.dtSetIt.Fields[I].FieldName).Value := vItProd.dtSetIt.Fields[I].Value;

            	if (trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString) = '')
    						or (UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE').AsString)) = UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString))) then
              begin
              	vItProd.dtSetIt.Edit;
                if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
                  ' WHERE UPPER(SIGLA) = ' + QuotedStr(vDadosIni.IfThen(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString) <> '',
                  	UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString)),
                    UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE').AsString)))) +
                  ' AND COALESCE(FRACIONADO, 0) = 0 ', buscas2).IsEmpty then
                	  vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                    	RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, 0)
                else
										vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                    	RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, - 4);
              	vItProd.dtSetIt.Post;
              end
              else
              begin
              	vItProd.dtSetIt.Edit;
                if (vItProd.dtSetIt.FieldByName('OPERACAO_CONV').AsString = 'M') and (vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat > 0) then
                begin
                	if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
                  	' WHERE UPPER(SIGLA) = ' + QuotedStr(vDadosIni.IfThen(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString) <> '',
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString)),
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE').AsString)))) +
                 	  ' AND COALESCE(FRACIONADO, 0) = 0 ', buscas2).IsEmpty then
                      vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                        RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, 0) /
                          vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat
                  else
                      vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                        RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, - 4) /
                          vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat;
                end
              	else if (vItProd.dtSetIt.FieldByName('OPERACAO_CONV').AsString = 'D') and (vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat > 0) then
                begin
                	if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
                  	' WHERE UPPER(SIGLA) = ' + QuotedStr(vDadosIni.IfThen(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString) <> '',
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString)),
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE').AsString)))) +
                 	  ' AND COALESCE(FRACIONADO, 0) = 0 ', buscas2).IsEmpty then
                    	vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                        RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, 0) *
                          vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat
                  else
                      vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                        RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, - 4) *
                          vItProd.dtSetIt.FieldByName('FATOR_CONV').AsFloat;
                end
                else
                begin
                	if not SqlOpen(' SELECT SIGLA, DESCRICAO, FRACIONADO FROM UNIDADES ' +
                	  ' WHERE UPPER(SIGLA) = ' + QuotedStr(vDadosIni.IfThen(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString) <> '',
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE_CONV').AsString)),
                      UpperCase(trim(vItProd.dtSetIt.FieldByName('UNIDADE').AsString)))) +
                 	  ' AND COALESCE(FRACIONADO, 0) = 0 ', buscas2).IsEmpty then
                    	vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                      	RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, 0)
                  else
                			vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat :=
                      	RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR_CONV').AsFloat, - 4);
                end;
              	vItProd.dtSetIt.Post;
              end;

              //alterando as quantidades abaixo, já que agora pode-se informar a quantidade de itens que está se mesclando.
              dtSetSincIt.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat, - 4);

              dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency :=
              	((vItProd.dtSetIt.FieldByName('RATEIO_DESC').AsFloat /
                	vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM').AsFloat) *
                  	dtSetSincIt.FieldByName('QUANT_PED_ITEM').AsFloat);//vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat);

              dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency :=
              	((vItProd.dtSetIt.FieldByName('RATEIO_ACRESC').AsFloat /
                	vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM').AsFloat) *
                  	dtSetSincIt.FieldByName('QUANT_PED_ITEM').AsFloat); //vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat);

              dtSetSincIt.FieldByName('VLTOT_PED_ITEM').AsCurrency :=
              	vDadosIni.StrToFloatFormat((dtSetSincIt.FieldByName('QUANT_PED_ITEM').AsFloat * //vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat *
                	vItProd.dtSetIt.FieldByName('VLUN_PED_ITEM').AsFloat), 2);

              // verificando se possui desconto no item
              if (pTipo = 'REQ') then
              begin
                if (dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat > 0) and
                  (Copy(dtSetSincIt.FieldByName('TP_DESCACRES').AsString,1,1) = 'D') then
                begin
                  if (Copy(dtSetSincIt.FieldByName('NAT_DESCACRES').AsString,1,1) = 'V') then
                    vrTemp := vDadosIni.StrToFloatFormat(dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat, 2)
                  else
                    vrTemp := vDadosIni.StrToFloatFormat(dtSetSincIt.FieldByName('VLTOT_PED_ITEM').AsCurrency *
                      dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
                  dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency := dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency - vrTemp;
                  if dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency < 0 then
                    dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency := 0;
                end
                else
                begin
                  if (Copy(dtSetSincIt.FieldByName('NAT_DESCACRES').AsString,1,1) = 'V') then
                    vrTemp := vDadosIni.StrToFloatFormat(dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat, 2)
                  else
                    vrTemp := vDadosIni.StrToFloatFormat(dtSetSincIt.FieldByName('VLTOT_PED_ITEM').AsCurrency *
                      dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat / 100, 2);
                  dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency := dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency - vrTemp;
                  if dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency < 0 then
                    dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
                end;
              end
              else
              begin
                dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
                dtSetSincIt.FieldByName('VALOR_DESCACRES').AsFloat := 0;
                dtSetSincIt.FieldByName('DESC_ITEM').AsFloat := 0;
                dtSetSincIt.FieldByName('ACRESC_ITEM').AsFloat := 0;
              end;
              vTotalRateioDesc := vTotalRateioDesc + dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency;
              vTotalRateioAcresc := vTotalRateioAcresc + dtSetSincIt.FieldByName('RATEIO_ACRESC').AsCurrency;
              if not (pos(dtSetSincIt.FieldByName('nped').AsString, vNPEDsORCMesclados) > 0) then
              begin
                if vNPEDsORCMesclados = '' then
                  vNPEDsORCMesclados := dtSetSincIt.FieldByName('nped').AsString
                else
                	vNPEDsORCMesclados := vNPEDsORCMesclados + ',' + dtSetSincIt.FieldByName('nped').AsString;
              end;

              dtSetSincIt.FieldByName('nped').AsInteger := nVenda;
              dtSetSincIt.FieldByName('tipo').AsString := trim(pTipo);
              vItProd.vProduto.buscaProduto(
              	dtSetSincIt.FieldByName('grupo_prod').AsInteger,
                dtSetSincIt.FieldByName('cod_prod').AsString);
              if (dtSetSincIt.FieldByName('cod_nserie').AsInteger = 0) and
                ((vItProd.vProduto.dataSet.FieldByName('ecf').AsString = 'E') or
                (vItProd.vProduto.dataSet.FieldByName('ecf').AsString = 'O')) then
              begin
                if dtSetSincIt.FieldByName('QUANT_PED_ITEM').AsFloat > 1 then
                  raise exception.Create('Quantidade de itens não pode ser maior que 1 para Equipamentos com controle de Nº de Série');

                vItProd.StringNSerie := StringReplace(vStringTmp, '||', ',', [rfReplaceAll]);
                vItProd.StringNSerie := StringReplace(vItProd.StringNSerie, '|', '', [rfReplaceAll]);

                vItProd.vEstoqueECF.selecionaEstoqueECFVenda(
                  dtSetSincIt.FieldByName('grupo_prod').AsInteger,
                  dtSetSincIt.FieldByName('cod_prod').AsString, vItProd.StringNSerie, '',0);// Aqui nao coloquei o numero da venda pois o dataset temporario neste momento esta sem os demais itens, sendo assim os codigos de nserie desta venda nao podem ser recuperados
                if vItProd.vEstoqueECF.dataSet.IsEmpty then
                  raise exception.Create('Sem itens no estoque de Equipamentos com controle de Nº de Série');

                vDadosIni.vPesquisa := 'NSERIE';
                if abreFormEscolhaEquipamentoNSerie then
                begin
                  dtSetSincIt.FieldByName('cod_nserie').asstring :=
                    vItProd.vEstoqueECF.dataSet.FieldByName('COD_NSERIE').AsString;
                  dtSetSincIt.FieldByName('DESCR_PROD_PED').asstring :=
                    Trim(dtSetSincIt.FieldByName('DESCR_PROD_PED').asstring) + ' ' + Trim(vItProd.vEstoqueECF.dataSet.FieldByName('n_serie_fab').AsString);
                  if Pos('|' + IntToStr(dtSetSincIt.FieldByName('cod_nserie').AsInteger) + '|', vStringTmp) = 0 then
                    vStringTmp := vStringTmp + '|' + IntToStr(dtSetSincIt.FieldByName('cod_nserie').AsInteger) + '|';
                end
                else
                  raise exception.Create('O Equipamento deve ser informado!');
                vDadosIni.vPesquisa := '';
              end;

              if trim(pTipo) = 'REQ' then
                dtSetSincIt.FieldByName('COL_COD_VENDEDOR').AsVariant := Null;

              inc(vNitemP);
              dtSetSincIt.FieldByName('NITEM').AsInteger := vNitemP;
              vDAVOrigem := retornaValor(' select nprevenda as valor from pedvenda ' +
              	' where nped = ' + IntToStr(vItProd.dtSetIt.FieldByName('NPED').AsInteger) +
                ' and tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').AsString)) +
                ' and cod_empresa = ' + vDadosIni.CodEmpresa +
                ' and ativo = 1 ');

             if vDAVOrigem <> '' then
               dtSetSincIt.FieldByName('DAV_ORIGEM').AsInteger := strtoint(vDAVOrigem);
             dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItProd.dtSetIt.FieldByName('nped').AsInteger;
             dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItProd.dtSetIt.FieldByName('TIPO').AsString;

             try
               dtSetSincIt.OnReconcileError := dataSetReconcileError;
               if dtSetSincIt.ApplyUpdates(-1) > 0 then
               begin
                 Result := false;
                 raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
               end;
             finally
               dtSetSincIt.OnReconcileError := nil;
             end;

              buscas.Close;
              buscas.SQL.Text := 'update pedvenda_prod pp ' +
                ' set pp.npedoriginado = ' + inttostr(nVenda) +
                ' ,pp.tipooriginado = ' + QuotedStr(trim(pTipo)) +
                ' where pp.nped = ' + vItProd.dtSetIt.FieldByName('NPED').AsString +
                ' and pp.nitem = ' + vItProd.dtSetIt.FieldByName('NITEM').AsString +
                ' and pp.tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').asstring)) +
                ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
                ' and pp.ativo = 1 ' +
                ' and pp.npedoriginado is null ';
              buscas.ExecSQL;
            end;
          end;
        end;
        vItProd.dtSetIt.Next;
      end;

      if (pTipo = 'OS') and (not vItServ.dtSetIt.IsEmpty) then
      begin
        defineCampos(vItServ.dataSet, true);
        dtSetSincIt.Close;
        dtSetSincIt.CommandText := ' select * from pedvenda_serv ps ' +
          ' where ps.nped = ' + inttostr(pNPED) +
          ' and ps.tipo = ' + QuotedStr(trim(pTipo)) +
          ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and ps.ativo = 1 ' +
          ' order by ps.nitem ';
        dtSetSincIt.Open;
        vNitemS := dtSetSincIt.RecordCount;

        vItServ.dtSetIt.Close;
        vItServ.dtSetIt.Filtered := false;
        vItServ.dtSetIt.open;
        vItServ.dtSetIt.IndexFieldNames := 'NITEM';
        
        vItServ.dtSetIt.First;
        while not vItServ.dtSetIt.eof do
        begin
          if (trim(vItServ.dtSetIt.FieldByName('STATUS').AsString) <> 'CANCELADO')
          	and (trim(vItServ.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
          begin
            dtSetSincIt.Insert;
            for i := 0 to vItServ.dtSetIt.Fields.Count - 1 do
              if (vItServ.dtSetIt.Fields[I].FieldName <> 'SELEC')
              	and (vItServ.dtSetIt.Fields[I].FieldName <> 'SEL')
                and (vItServ.dtSetIt.Fields[I].FieldName <> 'VALOR_UN_SERV_LIQ')
                and (vItServ.dtSetIt.Fields[I].FieldName <> 'VALOR_TOT_SERV_LIQ')
                and (vItServ.dtSetIt.Fields[I].FieldName <> 'RATEIO_DESC_TEMP')
                and (vItServ.dtSetIt.Fields[I].FieldName <> 'RATEIO_ACRESC_TEMP') then
                	dtSetSincIt.FieldByName(vItServ.dtSetIt.Fields[I].FieldName).Value := vItServ.dtSetIt.Fields[I].Value;

            if not (pos(dtSetSincIt.FieldByName('nped').AsString, vNPEDsORCMesclados) > 0) then
            begin
              if vNPEDsORCMesclados = '' then
                vNPEDsORCMesclados := dtSetSincIt.FieldByName('nped').AsString
              else
              	vNPEDsORCMesclados := vNPEDsORCMesclados + ',' + dtSetSincIt.FieldByName('nped').AsString;
            end;
            dtSetSincIt.FieldByName('nped').AsInteger := nVenda;
            dtSetSincIt.FieldByName('tipo').AsString := trim(pTipo);
            vTotalRateioDesc := vTotalRateioDesc + dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency;
            inc(vNitemS);
            dtSetSincIt.FieldByName('NITEM').AsInteger := vNitemS;
            vDAVOrigem := retornaValor(' select nprevenda as valor from pedvenda ' +
            	' where nped = ' + IntToStr(vItServ.dtSetIt.FieldByName('NPED').AsInteger) +
              ' and tipo = ' + QuotedStr(trim(vItServ.dtSetIt.FieldByName('TIPO').AsString)) +
              ' and cod_empresa = ' + vDadosIni.CodEmpresa +
              ' and ativo = 1 ');
            if vDAVOrigem <> '' then
              dtSetSincIt.FieldByName('DAV_ORIGEM').AsInteger := strtoint(vDAVOrigem);
            dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItServ.dtSetIt.FieldByName('NPED').AsInteger;
            dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItServ.dtSetIt.FieldByName('TIPO').AsString;

            try
              dtSetSincIt.OnReconcileError := dataSetReconcileError;
              if dtSetSincIt.ApplyUpdates(-1) > 0 then
              begin
                Result := false;
                raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
              end;
            finally
              dtSetSincIt.OnReconcileError := nil;
            end;

            if vDadosIni.vMecOS='S' then
            begin
              if not ExecutaComandosSql('select * from MECANICO_OS mo '+
                ' where mo.COD_SERVICO = '+vItServ.dtSetIt.FieldByName('COD_SERVICO').AsString+
                ' and mo.nped = '+ inttostr(nVenda) +
                ' and mo.tipo = '+ quotedstr(trim(pTipo)) +
                ' and mo.cod_empresa=' + vDadosIni.codEmpresa) then
              begin
                buscas.Close;
                buscas.SQL.Text := 'insert into MECANICO_OS '+
                  '(COD_VENDEDOR,N_OS,COD_EMPRESA,COD_SERVICO,PER_COMISSAO, CODIGO_NOP,NPED,TIPO) '+
                  ' select COD_VENDEDOR,N_OS,COD_EMPRESA,COD_SERVICO,PER_COMISSAO, CODIGO_NOP,'+ inttostr(nVenda) +',''OS'' '+
                  ' from MECANICO_OS mo where mo.COD_SERVICO = '+vItServ.dtSetIt.FieldByName('COD_SERVICO').AsString+
                  ' and mo.nped = '+vItServ.dtSetIt.FieldByName('nped').AsString+
                  ' and mo.tipo = '+ QuotedStr(trim(vItServ.dtSetIt.FieldByName('TIPO').asstring)) +
                  ' and mo.cod_empresa=' + vDadosIni.codEmpresa;
                buscas.ExecSQL;
              end;
            end;

            buscas.Close;
            buscas.SQL.Text := 'update pedvenda_serv ps ' +
              ' set ps.npedoriginado = ' + inttostr(nVenda) +
              ' ,ps.tipooriginado = ' + QuotedStr(trim(pTipo)) +
              ' where ps.nped = ' + vItServ.dtSetIt.FieldByName('NPED').AsString +
              ' and ps.nitem = ' + vItServ.dtSetIt.FieldByName('NITEM').AsString +
              ' and ps.tipo = ' + QuotedStr(trim(vItServ.dtSetIt.FieldByName('TIPO').asstring)) +
              ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and ps.ativo = 1 ' +
              ' and ps.npedoriginado is null';
            buscas.ExecSQL;

          end;
          vItServ.dtSetIt.next;
        end;
      end;

      if (pTipo = 'OS') and (not vItServTerc.dtSetIt.IsEmpty) then
      begin
      	defineCampos(vItServTerc.dataSet, true);
        dtSetSincIt.Close;
        dtSetSincIt.CommandText := ' select * from pedvenda_serv_terc pst ' +
          ' where pst.nped = ' + inttostr(pNPED) +
          ' and pst.tipo = ' + QuotedStr(trim(pTipo)) +
          ' and pst.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and pst.ativo = 1 ' +
          ' order by pst.seqid ';
        dtSetSincIt.Open;

        vItServTerc.dtSetIt.Close;
        vItServTerc.dtSetIt.Filtered := false;
        vItServTerc.dtSetIt.open;
        vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';
        
        vItServTerc.dtSetIt.First;
