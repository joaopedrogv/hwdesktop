function TEstoqueECFPED.selecionaEstoqueECFVenda(pGrupo: integer;
  pCodigo: string; pSqlAdicional, pTipoPed: string; pNped: Integer): boolean;
var
  vTempSql: string;
begin
  buscas.Close;
  buscas.SQL.Text := 'select p.nped, pp.cod_nserie from pedvenda p' +
    ' inner join pedvenda_prod pp on pp.nped = p.nped and pp.tipo = p.tipo and pp.cod_empresa = p.cod_empresa' +
    ' where coalesce(pp.status, '''') <> ''CANCELADO'' and coalesce(p.status_ped , '''') = ''''' +
    ' and pp.cod_nserie > 0' +
    ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and pp.grupo_prod = ' + IntToStr(pGrupo) +
    ' and pp.cod_prod = ' + QuotedStr(pCodigo) +
    ' and p.tipo <> ''ORC'' and not (p.nped = ' + IntToStr(pNped) +
    ' and p.tipo = ' + QuotedStr(pTipoPed) +')';
  buscas.Open;
  vTempSql := '';
  buscas.First;
  while not buscas.Eof do
  begin
    vTempSql := vTempSql + '|' + IntToStr(buscas.FieldByName('cod_nserie').AsInteger) + '|';
    buscas.Next;
  end;

  if vTempSql <> '' then
  begin
    vTempSql := StringReplace(vTempSql, '||', ',', [rfReplaceAll]);
    vTempSql := StringReplace(vTempSql, '|', '', [rfReplaceAll]);
    vTempSql := 'and not (cod_nserie in ( '+ vTempSql + '))';
  end;

  if Trim(pSqlAdicional) <> '' then
    pSqlAdicional := 'and not (cod_nserie in ( '+ pSqlAdicional + '))';
  Result := montaSelect('select * from ecf where status = ''Estoque''' +
    ' and grupo_prod = ' + IntToStr(pGrupo) + ' and cod_prod = ' + QuotedStr(Trim(pCodigo)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + pSqlAdicional + vTempSql);
end;

