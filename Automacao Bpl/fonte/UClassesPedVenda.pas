function TPedVenda.ChecaTipVendaVendedor: boolean;
begin
  try
    result := false;
    if not ChecaTipVendaExiste then
      exit;

    if dataSet.FieldByName('COD_VENDEDOR').IsNull then
      result := true
    else
    begin
      result := true;
      buscas.Close;
      buscas.SQL.Text := 'select f.tpdocs_vnd from colaborador col ' +
        ' inner join funcoes f on col.cod_funcao = f.cod_funcao ' +
      	' where col.cod_vendedor = ' + IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger) +
        ' and  col.cod_empresa = ' + vDadosIni.codEmpresa + ' and f.ativo=1';
      if vDadosIni.GetIni('Sistema', 'InimeMsgVerColab', 'N') = 'S' then
      vDadosIni.abreStatusProcessamento('', 'Verificando Funcoes do Vendedor');
      buscas.Open;
      if not buscas.isempty then
      begin
        if pos('REQ' + dataSet.FieldByName('TIPV').AsString,
          buscas.FieldByName('TPDOCS_VND').asstring) = 0 then
        begin
          if vDadosIni.GetIni('Sistema', 'InimeMsgVerColab', 'N') = 'S' then
          vDadosIni.fechaStatusProcessamento;
          Application.MessageBox(PChar('Tipo de Venda ''' + dataSet.FieldByName('TIPV').asstring +
            ''' não compativel com o Vendedor'), 'Informação', MB_OK + MB_ICONINFORMATION +
            MB_DEFBUTTON1);
          Result := false;
        end
        else
          Result := true;
      end
      else
        result := false;
      if result then
      begin
        if vSing.vTipoVenda <> 'OS' then
        begin
//          if dataSet.FieldByName('COD_VENDEDOR').OldValue <> dataSet.FieldByName('COD_VENDEDOR').NewValue then
//          begin
            if vDadosIni.GetIni('Sistema', 'InimeMsgVerColab', 'N') = 'S' then
            vDadosIni.abreStatusProcessamento('', 'Alterando Código Vendedor nos itens');
            try
              vItProd.prepare_loop(loop_options_all);

              //vItProd.dataSet.DisableControls;
              //vItProd.dataSet.First;
              while not vItProd.dataSet.eof do
              begin
                if (vItProd.dataSet.FieldByName('DAV_ORIGEM').isnull) or (not vDadosIni.vPedVnd.ManterVendOrigMesc) then
                begin
                  if vitprod.dataSet.FieldByName('COD_VENDEDOR').AsInteger <> dataSet.FieldByName('COD_VENDEDOR').AsInteger then
                  begin
                  vItProd.dataSet.edit;
                  vitprod.dataSet.FieldByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
                  vItProd.dataSet.Post;
                  end;
                end;
                vItProd.dataSet.next;
              end;
              if vDadosIni.GetIni('Sistema', 'InimeMsgVerColab', 'N') = 'S' then
                Exit;
            finally
              //vItProd.dataSet.EnableControls;
              vItProd.prepare_loop_done();
              vDadosIni.fechaStatusProcessamento;
            end;
//          end;
        end;
      end;
    end;
  except
    result := false;
  end;
  if vDadosIni.GetIni('Sistema', 'InimeMsgVerColab', 'N') = 'S' then
    vDadosIni.fechaStatusProcessamento;
end;

