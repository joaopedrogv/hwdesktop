function TCondPagPed.abreCondPag(
  ACondicaoCliente: string): boolean;
var
  sql,vformasCliente:string;
  vExisteCondpagPadrao: boolean;
begin
	vExisteCondpagPadrao := _existeCondPagPadrao;

  dataSet.Close;
  if (Trim(ACondicaoCliente) <> '') and (vDadosIni.vCliente.vCondPagPorCliente) then
    try
      result := montaSelect(
      	' SELECT COND_PAG.COD_COND_PAG, COND_PAG.DESC_COND_PAG, ' +
        '	COND_PAG.SEQPRECO, COND_PAG.MAX_DESC, COND_PAG.ATIVO, COND_PAG.FINALIZADOR_CUPOM FROM COND_PAG ' +
        ' INNER JOIN COND_PAG_EMPRESA ON ' +
        '		COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
        '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' WHERE COND_PAG.NATUREZA_CP <> ''C'' ' +
        ' AND COND_PAG.ATIVO = 1 ' +
        ' AND COND_PAG.COD_COND_PAG IN ' + ACondicaoCliente +
      vDadosIni.IfThen(vExisteCondpagPadrao,
      	' UNION ' +
      	' SELECT COND_PAG.COD_COND_PAG, COND_PAG.DESC_COND_PAG, ' +
        ' COND_PAG.SEQPRECO, COND_PAG.MAX_DESC, COND_PAG.ATIVO, COND_PAG.FINALIZADOR_CUPOM FROM COND_PAG ' +
        ' INNER JOIN COND_PAG_EMPRESA ON ' +
        '		COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
        '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' WHERE COND_PAG.NATUREZA_CP <> ''C'' ' +
        ' AND COND_PAG.ATIVO = 1 ' +
        ' AND COALESCE(COND_PAG.COND_PADRAO_CL_VND, ''N'') = ''T'' ', '') +
        ' ORDER BY 2 ');
    except
    end;

  if (not dataSet.Active) or (dataset.IsEmpty) then
  	result := montaSelect(' SELECT COND_PAG.COD_COND_PAG, COND_PAG.DESC_COND_PAG, ' +
    	'	COND_PAG.SEQPRECO, COND_PAG.MAX_DESC, COND_PAG.ATIVO, COND_PAG.FINALIZADOR_CUPOM FROM COND_PAG ' +
      ' INNER JOIN COND_PAG_EMPRESA ON ' +
      '		COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
      '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
    	'	WHERE COND_PAG.NATUREZA_CP <> ''C'' ' +
      ' AND COND_PAG.ATIVO = 1 ' +
    vDadosIni.IfThen(vExisteCondpagPadrao,
    	' AND COALESCE(COND_PAG.COND_PADRAO_CL_VND, ''N'') = ''T'' ', '') +
      ' ORDER BY 2 ');
end;

function TCondPagPed.ExibirCondPag: integer;
