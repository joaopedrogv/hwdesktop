function TPedVendaServ.abrePedVendaServ(nPed: integer): boolean;
var
	buscas2: TIBQuery;
begin
	try
  	buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    result := montaSelect('SELECT * FROM PEDVENDA_SERV ' +
      ' WHERE NPED = ' + inttostr(nPed) +
      ' AND TIPO = ' + QuotedStr(vSing.vTipoVenda) +
      ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' AND ATIVO = 1');

    dataSet.First;
    dtSet.open;
    dtSet.EmptyDataSet;
    while not DataSet.Eof do
    begin
      dtSet.Insert;
      dtSet.FieldByName('NITEM').AsInteger := DataSet.FieldByName('NITEM').AsInteger;
      dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
      dtSet.FieldByName('COD_SERVICO').AsInteger := DataSet.FieldByName('COD_SERVICO').AsInteger;
      dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
      dtSet.FieldByName('QUANT_SERV_PED').AsFloat := DataSet.FieldByName('QUANT_SERV_PED').AsFloat;
      dtSet.FieldByName('CODIGO_NOP').AsFloat := DataSet.FieldByName('CODIGO_NOP').AsFloat;
      dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
      dtSet.FieldByName('STATUS').AsString := DataSet.FieldByName('STATUS').AsString;
      dtSet.FieldByName('VALOR_UN_SERV').AsFloat := DataSet.FieldByName('VALOR_UN_SERV').AsFloat;
      dtSet.FieldByName('VALOR_TOT_SERV').AsFloat := DataSet.FieldByName('VALOR_TOT_SERV').AsFloat;
      dtSet.FieldByName('RATEIO_ACRESC').AsCurrency := dataSet.FieldByName('RATEIO_ACRESC').AsCurrency;
      dtSet.FieldByName('ACRESC_ITEM').AsCurrency := dataSet.FieldByName('ACRESC_ITEM').AsCurrency;
      dtSet.FieldByName('RATEIO_DESC').AsCurrency := dataSet.FieldByName('RATEIO_DESC').AsCurrency;
      dtSet.FieldByName('DESC_ITEM').AsCurrency := dataSet.FieldByName('DESC_ITEM').AsCurrency;
      dtSet.FieldByName('COD_AGENDA').AsInteger := dataSet.FieldByName('COD_AGENDA').AsInteger;
      dtSet.Post;

      if (vDadosIni.vEmp.vSegmentaProdVenda = 'S2') and (dataSet.FieldByName('NITEM_SERV').AsInteger <= 0) then
      begin
        buscas2.Close;
        buscas2.SQL.Text := 'select cod from incrementa_codigo( ' + vDadosIni.codEmpresa + ',''PEDVENDA_SERV_NITEM'')';
        try
          buscas2.Open;
          dataSet.Edit;
          dataSet.FieldByName('nitem_serv').AsInteger := buscas2.FieldByName('cod').AsInteger;
          dataSet.Post;

         if buscas2.Transaction.InTransaction then
           buscas2.Transaction.Commit;
        except
        end;
      end;
      DataSet.Next;
    end;

    dataSet.First;
    while not DataSet.Eof do
    begin
      dataSet.Edit;

      dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat := RoundTo(
        dataSet.FieldByName('RATEIO_ACRESC').AsFloat - dataSet.FieldByName('ACRESC_ITEM').AsFloat, - 2);

      dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat := RoundTo(
        dataSet.FieldByName('RATEIO_DESC').AsFloat - dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

      dataSet.Post;

      DataSet.Next;
    end;

    if DataSet.ControlsDisabled then
      DataSet.EnableControls;
    DataSet.First;

    vSubG.abreSubGrupo;
  //  vTipServ.abreTipoServico;
    if (vDadosIni.vEmp.vSegmentaProdVenda <> 'S1') then
      vTipServ.abreTipoServico;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaServ.abreMecanicos(pcod_servico: Integer): Boolean;
var
	buscas2: TIBQuery;
begin
	try
  	buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas.Close;
    buscas.SQL.Text := 'select first 1 cod_servico from tipo_servico_mecanico ' +
      ' where cod_servico = ' + IntToStr(pcod_servico) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    buscas.FetchAll;

    if buscas.IsEmpty then
    begin
      buscas2.Close;
      if vDadosIni.vEmp.vUsarAparelho = 'S' then
        buscas2.SQL.Text :=
          ' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao, ' +
          ' cast(coalesce(max(cast(t.dia as date) ||'' ''|| t.hora_inicio),''01/01/1899 00:00:00'') as timestamp) as data, ' +
          ' case when (t.dia is null) then ''F'' when (t.dia_fechado is null) then ''A'' else ''F'' end as tipo ' +
          ' from colaborador c ' +
          ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
          ' left join tmo_serv_os t on t.cod_vendedor = c.cod_vendedor ' +
          ' where  c.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and c.ativo = 1 ' +
          ' and ((f.desc_funcao like ''%TECNICO%'') or (f.desc_funcao like ''%TÉCNICO%'')) ' +
          ' and (t.tipo_op =''S'' or t.tipo_op =''P'' or t.tipo_op is null) ' +
          ' and ((c.data_ini_ausencia > ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          '			 or (c.data_fim_ausencia <' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          ' 		 or (c.data_ini_ausencia is null or c.data_fim_ausencia is null)) ' +
          ' group by 1,2, 3, 5 ' +
          ' order by 5 desc, 4 '
      else
        buscas2.SQL.Text :=
          ' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao, ' +
          ' cast(coalesce(max(cast(t.dia as date) ||'' ''|| t.hora_inicio),''01/01/1899 00:00:00'') as timestamp) as data, ' +
          ' case when (t.dia is null) then ''F'' when (t.dia_fechado is null) then ''A'' else ''F'' end as tipo ' +
          ' from colaborador c ' +
          ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
          ' left join tmo_serv_os t on t.cod_vendedor = c.cod_vendedor ' +
          ' where  c.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and c.ativo = 1 and ((f.desc_funcao like ''%MECANICO%'') or (f.desc_funcao like ''%MECÂNICO%'')) ' +
          ' and (t.tipo_op =''S'' or t.tipo_op =''P'' or t.tipo_op is null) ' +
          ' and ((c.data_ini_ausencia > ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          '			 or (c.data_fim_ausencia <' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          ' 		 or (c.data_ini_ausencia is null or c.data_fim_ausencia is null)) ' +
          ' group by 1,2, 3, 5 ' +
          ' order by 5 desc, 4 ';
      buscas2.Open;
      buscas2.FetchAll;
    end
    else
    begin
      buscas2.Close;
      if vDadosIni.vEmp.vUsarAparelho = 'S' then
        buscas2.SQL.Text :=
          ' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao, ' +
          ' cast(coalesce(max(cast(t.dia as date) ||'' ''|| t.hora_inicio),''01/01/1899 00:00:00'') as timestamp) as data, ' +
          ' case when (t.dia is null) then ''F'' when (t.dia_fechado is null) then ''A'' else ''F'' end as tipo ' +
          ' from colaborador c ' +
          ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
          ' left join tmo_serv_os t on t.cod_vendedor = c.cod_vendedor ' +
          ' inner join tipo_servico_mecanico tm on tm.cod_vendedor = c.cod_vendedor and tm.cod_empresa = c.cod_empresa ' +
          ' where  c.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and c.ativo = 1 and ((f.desc_funcao like ''%TECNICO%'') or (f.desc_funcao like ''%TÉCNICO%'')) ' +
          ' and (t.tipo_op =''S'' or t.tipo_op =''P'' or t.tipo_op is null) ' +
          ' and ((c.data_ini_ausencia > ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ' ) ' +
          '			 or (c.data_fim_ausencia <' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          ' 		 or (c.data_ini_ausencia is null or c.data_fim_ausencia is null)) ' +
          ' and tm.cod_servico =' + IntToStr(pcod_servico) +
          ' group by 1,2, 3, 5 ' +
          ' order by 5 desc, 4 '
      else
        buscas2.SQL.Text :=
          ' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao, ' +
          ' cast(coalesce(max(cast(t.dia as date) ||'' ''|| t.hora_inicio),''01/01/1899 00:00:00'') as timestamp) as data, ' +
          ' case when (t.dia is null) then ''F'' when (t.dia_fechado is null) then ''A'' else ''F'' end as tipo ' +
          ' from colaborador c ' +
          ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
          ' left join tmo_serv_os t on t.cod_vendedor = c.cod_vendedor ' +
          ' inner join tipo_servico_mecanico tm on tm.cod_vendedor = c.cod_vendedor and tm.cod_empresa = c.cod_empresa ' +
          ' where  c.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and c.ativo = 1 and ((f.desc_funcao like ''%MECANICO%'') or (f.desc_funcao like ''%MECÂNICO%'')) ' +
          ' and (t.tipo_op =''S'' or t.tipo_op =''P'' or t.tipo_op is null) ' +
          ' and ((c.data_ini_ausencia > ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ' ) ' +
          ' 		 or (c.data_fim_ausencia <' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) + ') ' +
          ' 		 or (c.data_ini_ausencia is null or c.data_fim_ausencia is null)) ' +
          ' and tm.cod_servico =' + IntToStr(pcod_servico) +
          ' group by 1,2, 3, 5 ' +
          ' order by 5 desc, 4 ';
      buscas2.Open;
      buscas2.FetchAll;
    end;

    buscas2.First;
    fTemp.EmptyDataSet;
    while not buscas2.Eof do
    begin

      fTemp.Filtered := false;
      fTemp.Filter := 'COD_VENDEDOR = ' + IntToStr(buscas2.FieldByName('COD_VENDEDOR').AsInteger) + '';
      fTemp.Filtered := true;

      if buscas2.FieldByName('COD_VENDEDOR').AsInteger = fTemp.FieldByName('COD_VENDEDOR').AsInteger then
      begin
        if fTemp.FieldByName('DATA').AsDateTime < buscas2.FieldByName('DATA').AsDateTime then
        begin
          fTemp.Edit;
          fTemp.FieldByName('DATA').AsDateTime := buscas2.FieldByName('DATA').AsDateTime;
          fTemp.FieldByName('TIPO').AsString := buscas2.FieldByName('TIPO').AsString;
          fTemp.Post;
        end;
      end
      else
      begin
        fTemp.Insert;
        fTemp.FieldByName('COD_VENDEDOR').AsInteger := buscas2.FieldByName('COD_VENDEDOR').AsInteger;
        fTemp.FieldByName('NOME_VENDEDOR').AsString := buscas2.FieldByName('NOME_VENDEDOR').AsString;
        fTemp.FieldByName('DESC_FUNCAO').AsString := buscas2.FieldByName('DESC_FUNCAO').AsString;
        fTemp.FieldByName('DATA').AsDateTime := buscas2.FieldByName('DATA').AsDateTime;
        fTemp.FieldByName('TIPO').AsString := buscas2.FieldByName('TIPO').AsString;
        fTemp.Post;
      end;
      buscas2.Next;
    end;

    fTemp.Filtered := false;
    fTemp.AddIndex('IndiceDesc', 'TIPO', [ixDescending], 'TIPO');
    fTemp.IndexName := 'IndiceDesc';
    fTemp.IndexFieldNames := 'DATA';

    dataSet.FieldByName('COD_VENDEDOR').AsInteger := fTemp.FieldByName('COD_VENDEDOR').AsInteger;
    dataSet.FieldByName('COD_VENDEDOR1').AsInteger := fTemp.FieldByName('COD_VENDEDOR').AsInteger;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVendaServ.abrePedVendaServ(nPed: integer; pTipo: string;
  pEmptyDataSet: boolean): boolean;
var
  i: integer;
begin
  result := montaSelect('SELECT * FROM PEDVENDA_SERV ' +
    ' WHERE  NPED = ' + inttostr(nPed) +
    ' AND TIPO = ' + QuotedStr(pTipo) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' AND ATIVO = 1 ');

  if not dtSetIt.Active then
    dtSetIt.open;
  //  if pEmptyDataSet then
  //    dtSetIt.EmptyDataSet;
  DataSet.First;
  while not DataSet.Eof do
  begin
  	if not dtSetIt.Locate('NPED;NITEM;TIPO;COD_EMPRESA',
    	VarArrayOf([dataset.FieldByName('NPED').AsInteger,
      						dataset.FieldByName('NITEM').AsInteger,
                  trim(dataset.FieldByName('TIPO').AsString),
                  dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
    begin
      dtSetIt.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
        dtSetIt.FieldByName(dataSet.Fields[I].FieldName).Value :=
          dataSet.Fields[I].Value;

      dtSetIt.Post;
    end;
    DataSet.Next;
  end;

  DataSet.First;
  while not DataSet.Eof do
  begin
  	dataSet.Edit;

  	dataSet.FieldByName('RATEIO_ACRESC_TEMP').AsFloat := RoundTo(
    	dataSet.FieldByName('RATEIO_ACRESC').AsFloat - dataSet.FieldByName('ACRESC_ITEM').AsFloat, - 2);

  	dataSet.FieldByName('RATEIO_DESC_TEMP').AsFloat := RoundTo(
	   	dataSet.FieldByName('RATEIO_DESC').AsFloat - dataSet.FieldByName('DESC_ITEM').AsFloat, - 2);

    dataSet.Post;

  	DataSet.Next;
  end;

  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;
end;

function TPedVendaServ.abrePedVendaServAgenda(nPed: integer): boolean;
var
  NItem: Integer;
  vNomeVendedor: string;
  vselecionado: Boolean;
begin
  result := false;
  vselecionado := false;

  if not vDadosIni.PesqPros('AGO015', 'SALVAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA_SERV',
  	dataSet.FieldByName('NPED').AsString, buscas, true) then
    	Exit;

  montaSelect('SELECT * FROM PEDVENDA_SERV ' +
    ' WHERE NPED = ' + inttostr(nPed) +
    ' AND TIPO = ' + QuotedStr(vSing.vTipoVenda) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' AND ATIVO = 1');

  FOwner.vAgenda.vAgendaItens.dataSet.First;
  while not FOwner.vAgenda.vAgendaItens.dataSet.Eof do
  begin

    if FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('SEL').AsString = 'S' then
    begin
      vselecionado := true;

      FOwner.vAgenda.vAgendaItens.Edit;

      if Length(Trim(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString)) > 1 then
      begin
        if Pos('-', FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString) > 0 then
        begin
          FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_VENDEDOR').AsInteger := StrToInt(trim(Copy(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString, 0, Pos('-', FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString) - 1)));
          vNomeVendedor := trim(Copy(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString, Pos('-', FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString) + 1, Length(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODNOMEVENDEDOR').AsString)));
        end
      end
      else
      begin
        if vDadosIni.vEmp.vUsarAparelho = 'S' then
          Application.MessageBox(pchar('Técnico não informado!'), 'Observação', MB_OK)
        else
          Application.MessageBox(pchar('Mecânico não informado!'), 'Observação', MB_OK);
        exit;
      end;


      if Length(Trim(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODBOX').AsString)) > 1 then
      begin
        if Pos('-', FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODBOX').AsString) > 0 then
          FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_BOX').AsInteger := StrToInt(trim(Copy(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODBOX').AsString, 0, Pos('-', FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODBOX').AsString) - 1)));
      end
      else
      begin
        Application.MessageBox(pchar('Box não informado!'), 'Observação', MB_OK);
        exit;
      end;
      FOwner.vAgenda.vAgendaItens.Post;

      if not FOwner.vAgenda._verificar_servico_especifico_mecanico(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_VENDEDOR').AsInteger, FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_SERVICO').AsInteger) then
      begin
        FOwner._abreFormMecanicoEspecifico(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_SERVICO').AsInteger);
        dataSet.EmptyDataSet;
        exit;
      end;

      if not FOwner.vAgenda._verificar_servico_especifico_box(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_BOX').AsInteger, FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_SERVICO').AsInteger) then
      begin
        FOwner._abreFormBoxEspecifico(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_SERVICO').AsInteger);
        dataSet.EmptyDataSet;
        exit;
      end;

      if not FOwner.vAgenda._verificar_box_servico(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_BOX').AsInteger) then
      begin
        dataSet.EmptyDataSet;
        exit;
      end;

      if not FOwner.vAgenda._verificar_temp_vendedor(FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_VENDEDOR').AsInteger) then
      begin
        dataSet.EmptyDataSet;
        exit;
      end;
    end;
    FOwner.vAgenda.vAgendaItens.dataSet.Next;
  end;

  if vselecionado = false then
  begin
    Application.MessageBox(pchar('Nenhum serviço selecionado!'), 'Observação', MB_OK);
    exit;
  end;

  if not FOwner.salvarAgendamento then
  begin
    dataSet.EmptyDataSet;
  	exit;
  end;

  NItem := 0;
  FOwner.vAgenda.vAgendaItens.dataSet.First;
  while not FOwner.vAgenda.vAgendaItens.dataSet.Eof do
  begin
    if FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('SEL').AsString = 'S' then
    begin
      NItem := NItem + 1;
      dataSet.Insert;
      dataSet.FieldByName('NITEM').AsInteger := NItem;
      dataSet.FieldByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
      dataSet.FieldByName('COD_AGENDA').AsInteger := FOwner.vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;
      dataSet.FieldByName('COD_VENDEDOR').AsInteger := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_VENDEDOR').AsInteger;
      dataSet.FieldByName('COD_VENDEDOR1').AsInteger := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_VENDEDOR').AsInteger;
      dataSet.FieldByName('NOME_VEND').AsString := vNomeVendedor;
      dataSet.FieldByName('NOME_VEND1').AsString := vNomeVendedor;
      dataSet.FieldByName('COD_SERVICO').AsInteger := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('COD_SERVICO').AsInteger;
      dataSet.FieldByName('DESC_SERV_PED').AsString := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('DESC_SERVICO').AsString;
      dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      dataSet.FieldByName('CODIGO_NOP').AsFloat := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('CODIGO_NOP').AsFloat;
      dataSet.FieldByName('QUANT_SERV_PED').AsFloat := 1;
      dataSet.FieldByName('VALOR_TOT_SERV').AsFloat := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('VALOR_SERVICO').AsFloat;
      dataSet.FieldByName('VALOR_UN_SERV').AsFloat := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('VALOR_SERVICO').AsFloat;
      dataSet.FieldByName('TIPO').AsString := 'OS';
      dataSet.FieldByName('TMO_SERV').AsFloat := FOwner.vAgenda.vAgendaItens.dataSet.FieldByName('TMO_SERVICO').AsFloat;
      dataSet.FieldByName('RATEIO_ACRESC').AsFloat := 0;
      dataSet.FieldByName('ACRESC_ITEM').AsFloat := 0;
      dataSet.FieldByName('RATEIO_DESC').AsFloat := 0;
      dataSet.FieldByName('DESC_ITEM').AsFloat := 0;
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      dataSet.Post;
    end;

  	FOwner.vAgenda.vAgendaItens.dataSet.Next;
  end;

  if vDadosIni.vEmp.vUsarAparelho = 'S' then
  begin
    FOwner.dataSet.FieldByName('COD_EQUIP').AsInteger := FOwner.vAgenda.dataSet.FieldByName('COD_EQUIP').AsInteger;
    FOwner.vSing.vObs_OS := FOwner.vAgenda.dataSet.FieldByName('OBSERVACAO').AsString;
    FOwner.dataSet.FieldByName('OBS_OS').AsString := FOwner.vAgenda.dataSet.FieldByName('OBSERVACAO').AsString;
    FOwner.buscaAparelho(FOwner.vAgenda.dataSet.FieldByName('COD_EQUIP').AsInteger, TFrmCadPedVenda(FOwner.FrmCadPed).Memo2);
  end
  else
  begin
    FOwner.dataSet.FieldByName('COD_VEICULO').AsInteger := FOwner.vAgenda.dataSet.FieldByName('COD_VEICULO').AsInteger;
    FOwner.dataSet.FieldByName('PLACA').AsString := FOwner.vAgenda.dataSet.FieldByName('PLACA').AsString;
    FOwner.dataSet.FieldByName('CHASSI').AsString := FOwner.vAgenda.dataSet.FieldByName('CHASSI').AsString;
    FOwner.vSing.vObs_OS := FOwner.vAgenda.dataSet.FieldByName('OBSERVACAO').AsString;
    FOwner.dataSet.FieldByName('OBS_OS').AsString := FOwner.vAgenda.dataSet.FieldByName('OBSERVACAO').AsString;
    FOwner.buscaVeiculo(FOwner.vAgenda.dataSet.FieldByName('PLACA').AsString, 1, TFrmCadPedVenda(FOwner.FrmCadPed).Memo1);
  end;

  FOwner.dataSet.FieldByName('COD_CLIENTE').AsInteger := FOwner.vAgenda.dataSet.FieldByName('COD_CLIENTE').AsInteger;
  FOwner.dataSet.FieldByName('COD_AGENDA').AsInteger := FOwner.vAgenda.dataSet.FieldByName('COD_AGENDA').AsInteger;

  Result := True;
end;

function TPedVendaServ.AlterarMecTecVend: Boolean;
var
	vMecTec: string;
  vVend: string;
begin
  if (not vHabMecTecServAlterClienteVnd) and (not vHabVendAlterServClienteVnd) then
    Exit;

	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Atualizando registros');

    Result := False;

  	vMecTec := '';
    if vHabMecTecServAlterClienteVnd then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select nome_vendedor from colaborador ' +
        ' where cod_vendedor = :cod_vendedor ' +
        ' and cod_empresa = :cod_empresa ';
      buscas.ParamByName('cod_vendedor').AsInteger := vCodMecTecServAlterClienteVnd;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;
      vMecTec := trim(buscas.FieldByName('nome_vendedor').AsString);
    end;

    vVend := '';
    if vHabVendAlterServClienteVnd then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select nome_vendedor from colaborador ' +
        ' where cod_vendedor = :cod_vendedor ' +
        ' and cod_empresa = :cod_empresa ';
      buscas.ParamByName('cod_vendedor').AsInteger := vCodVendAlterServClienteVnd;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;
      vVend := trim(buscas.FieldByName('nome_vendedor').AsString);
    end;

		try
      dataSet.Filter := 'sel = ''S'' ';
      dataSet.Filtered := True;

      if dataSet.IsEmpty then
      begin
        Application.MessageBox(pchar('Nenhum serviço selecionado!'), 'Atenção', MB_ICONERROR + MB_OK);
        exit;
      end;

      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('sel').AsString = 'S' then
        begin
          dataSet.Edit;

          if vHabMecTecServAlterClienteVnd then
          	if vCodMecTecServAlterClienteVnd <> dataSet.FieldByName('cod_vendedor').AsInteger then
              vDadosIni.GravaAuditoria(
              	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS', 'VND288', 'VND292'),
                'ALTERAR',
                vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'TECNICO', 'MECANICO') + ' ANT:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger) + ' ' +
                vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'TECNICO', 'MECANICO') + ' NOVO:' + IntToStr(vCodMecTecServAlterClienteVnd),
                'PEDVENDA',
                trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

          if vHabVendAlterServClienteVnd then
            if vCodVendAlterServClienteVnd <> dataSet.FieldByName('cod_vendedor1').AsInteger then
              vDadosIni.GravaAuditoria(
              	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS', 'VND289', 'VND293'),
                'ALTERAR',
                UpperCase(trim(vDadosIni.vPedVnd.NomeSegCampoServ)) + ' ANT:' + IntToStr(dataSet.FieldByName('cod_vendedor1').AsInteger) + ' ' +
                UpperCase(trim(vDadosIni.vPedVnd.NomeSegCampoServ)) + ' NOVO:' + IntToStr(vCodVendAlterServClienteVnd),
                'PEDVENDA',
                trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

          if vHabMecTecServAlterClienteVnd then
          begin
            dataSet.FieldByName('cod_vendedor').AsInteger := vCodMecTecServAlterClienteVnd;
            dataSet.FieldByName('nome_vend').AsString := Copy(trim(vMecTec), 1, 35);
          end;
          if vHabVendAlterServClienteVnd then
          begin
          	dataSet.FieldByName('cod_vendedor1').AsInteger := vCodVendAlterServClienteVnd;
            dataSet.FieldByName('nome_vend1').AsString := Copy(trim(vVend), 1, 35);
          end;
          dataSet.Post;
        end;

        dataSet.Next;
      end;
    finally
      dataSet.Filtered := false;
    end;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
    begin
    	if vHabMecTecServAlterClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND288', 'VND292'),
          'ALTERAR',
          'SUCESSO',
          'PEDVENDA',	trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);

      if vHabVendAlterServClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND289', 'VND293'),
          'ALTERAR',
          'SUCESSO',
          'PEDVENDA',	trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);
    end
    else
    begin
    	if vHabMecTecServAlterClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND288', 'VND292'),
          'ALTERAR',
          'FALHA',
          'PEDVENDA', trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);

      if vHabVendAlterServClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND289', 'VND293'),
          'ALTERAR',
          'FALHA',
          'PEDVENDA', trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);
    end;

    if Result then
      abrePedVendaServ(FOwner.dataSet.FieldByName('nped').AsInteger);

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

