//    end
//    else
//    begin
//      buscas.ParamByName('COD_SEG_SERVNEW').AsInteger := dataSet.FieldByName('COD_SERVICO').AsInteger;
//      buscas.ParamByName('NITEM_SERVNEW').AsInteger := dataSet.FieldByName('NITEM_SERV').AsInteger;
//    end;
//    buscas.ParamByName('NITEM_SERV').AsInteger := dataSet.FieldByName('NITEM_SERV').AsInteger;
//    buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
//    buscas.ExecSQL;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro ao alterar serviços - TPedVendaServ._alterarServicoProdutos: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('TPedVendaServ._alterarServicoProdutos: ' + e.Message);
    end;
  end;
