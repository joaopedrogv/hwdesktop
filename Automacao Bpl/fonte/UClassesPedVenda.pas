function TPedVenda.confirmarVenda(pQuestionar: boolean = false;
  pAutorizacaoPeloFinanc: Boolean = False): boolean;
//pAutorizacaoPeloFinanc: Quando o fechamento for chamado pela tela de autorizacao do financeiro nao será questionado sobre a confirmacao e a impressao
var
  dataNow: TDateTime;
  doc, env, vTemp: string;
  vTemDescCondPag: string;
  vstatped, vLibFin: string;
  vStatusSeparacao: string;
  vValorTotal: Double;
  vMensagem: string;
  ExibirMensagem, ExibirOpcaoEnviarNfNfcNfsAoFechar, FormaPagamentoAntesDeFechar: Boolean;
  existeRetencaoProdutos, existeRetencaoServicos: boolean;
  Acheck_valores_nf: Boolean;
  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
  hndNFe: thandle;
begin
	try
    Result := false;

    vDadosIni.logsPedvenda(Self.ClassName + '.confirmarVenda - begin', 'pedvenda');

    vEmitirNFeNFC := 'NAO';
    vEmitirNFSe   := 'NAO';
    if ((dataSet.FieldByName('valor_total').AsCurrency = 0) or (vSing.vValorTotalBruto = 0)) and (vSing.vTipoVenda = 'REQ') then
    begin
      if (dataSet.State in [dsEdit, dsInsert]) then
        Cancel;
      Application.MessageBox('Valor total dos itens da requisição de venda deve ser maior zero','Atenção',MB_OK+MB_ICONINFORMATION);
      exit;
    end;
    if IsEmpty then
      exit;
    try
      ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
      vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));

      env := '';
      if Trim(vSing.vTipoVenda) = 'REQ' then
        if not vDadosIni.PesqPros('VND060', 'CONFIRMAR', getTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Exit;
      if Trim(vSing.vTipoVenda) = 'OS' then
        if not vDadosIni.PesqPros('VND061', 'CONFIRMAR', getTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Exit;
      if vendaFechada then
        Exit;
      if vSing.vTipoVenda = 'ORC' then
      begin
        Result := true;
        Exit;
      end;
      //if not vSing.vVendaRapida then

      if vSing.vTipoVenda = 'REQ' then
        if vDadosIni.vEmp.vVnd_AprovacaoGerente = 'S' then
        begin

          buscas.Close;
          if Trim(dataSet.FieldByName('tipo').AsString) = 'REQ' then
            buscas.SQL.Text := 'select USAR_LIBERACAO_GERENTE from TIPO_VENDAS' +
                             ' where tipo = ''REQ'' and sigla = ' + QuotedStr(Trim(dataSet.FieldByName('tipv').AsString))
          else
            buscas.SQL.Text := 'select USAR_LIBERACAO_GERENTE from TIPO_VENDAS' +
                             ' where tipo = ''OS'' and tipo_os = ' + QuotedStr(Trim(dataSet.FieldByName('tipo_os').AsString));
          buscas.Open;

          if Trim(buscas.FieldByName('USAR_LIBERACAO_GERENTE').AsString) = 'S' then
            if dataSet.FieldByName('APROVADA_GERENTE').AsString <> 'S' then
            begin
              Application.MessageBox(pchar('Atenção! Venda aguardando liberação do gerente'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              Result := False;
              Exit;
            end;
        end;
      if vSing.vTipoVenda = 'REQ' then
      begin
        if UpperCase(vDadosIni.vEmp.vUsarConferenciaCegaSaida) = 'S2' then
        begin
          if existeConferenciaAberta(dataSet.FieldByName('NPED').AsInteger) then
          begin
            Result := False;
            Application.MessageBox(pchar('Pedido possui conferência cega ABERTA!'), 'Atenção', 0 + 48);
            Exit;
          end
          else if not(existeConferencia(dataSet.FieldByName('NPED').AsInteger)) then
          begin
            if not vDadosIni.PesqPros('RM018', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, True) then
            begin
              Application.MessageBox(pchar('Sistema configurado para utilizar conferência cega, não é possivel confirmar!'), 'Atenção', 0 + 48);
              Result := False;
              Exit;
            end;
          end;
        end;

        buscas.Close;
        buscas.SQL.Text := 'select USAR_LIBERACAO_FINANCEIRO from TIPO_VENDAS' +
          ' where tipo = ''REQ'' and sigla = ' + QuotedStr(Trim(dataSet.FieldByName('tipv').AsString));
        buscas.Open;

        vLibFin := buscas.FieldByName('USAR_LIBERACAO_FINANCEIRO').AsString;

        if vLibFin <> 'S' then
        begin
          buscas.Close;
          buscas.SQL.Text := 'select USAR_LIBERACAO_FINANCEIRO from CLIENTES' +
