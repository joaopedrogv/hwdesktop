function TPedVendaProd.AlterarMecTecVend: Boolean;
var
	vMecTec: string;
  vVend: string;
begin
  if (not vHabMecTecProdAlterClienteVnd) and (not vHabVendAlterProdClienteVnd) then
    Exit;

	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Atualizando registros');

    Result := False;

		vMecTec := '';
    if vHabMecTecProdAlterClienteVnd then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select nome_vendedor from colaborador ' +
        ' where cod_vendedor = :cod_vendedor ' +
        ' and cod_empresa = :cod_empresa ';
      buscas.ParamByName('cod_vendedor').AsInteger := vCodMecTecProdAlterClienteVnd;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;
      vMecTec := trim(buscas.FieldByName('nome_vendedor').AsString);
    end;

    vVend := '';
    if vHabVendAlterProdClienteVnd then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select nome_vendedor from colaborador ' +
        ' where cod_vendedor = :cod_vendedor ' +
        ' and cod_empresa = :cod_empresa ';
      buscas.ParamByName('cod_vendedor').AsInteger := vCodVendAlterProdClienteVnd;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;
      vVend := trim(buscas.FieldByName('nome_vendedor').AsString);
    end;

  	try
      dataSet.Filter := 'sel = ''S'' ';
      dataSet.Filtered := True;

      if dataSet.IsEmpty then
      begin
        Application.MessageBox(pchar('Nenhum produto selecionado!'), 'Atenção', MB_ICONERROR + MB_OK);
        exit;
      end;

      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('sel').AsString = 'S' then
        begin
          dataSet.Edit;

          if vHabMecTecProdAlterClienteVnd then
          	if vCodMecTecProdAlterClienteVnd <> dataSet.FieldByName('col_cod_vendedor').AsInteger then
              vDadosIni.GravaAuditoria(
              	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS', 'VND290', 'VND294'),
                'ALTERAR',
                vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'TECNICO', 'MECANICO') + ' ANT:' + IntToStr(dataSet.FieldByName('col_cod_vendedor').AsInteger) + ' ' +
                vDadosIni.IfThen(vDadosIni.vEmp.vUsarAparelho = 'S', 'TECNICO', 'MECANICO') + ' NOVO:' + IntToStr(vCodMecTecProdAlterClienteVnd),
                'PEDVENDA',
                trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

          if vHabVendAlterProdClienteVnd then
	          if vCodVendAlterProdClienteVnd <> dataSet.FieldByName('cod_vendedor').AsInteger then
              vDadosIni.GravaAuditoria(
              	vDadosIni.IfThen(trim(dataSet.FieldByName('TIPO').AsString) = 'OS', 'VND291', 'VND295'),
                'ALTERAR',
                'VENDEDOR ANT:' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger) + ' ' +
                'VENDEDOR NOVO:' + IntToStr(vCodVendAlterProdClienteVnd),
                'PEDVENDA',
                trim(dataSet.FieldByName('TIPO').AsString) + ' ' + IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas);

          if vHabMecTecProdAlterClienteVnd then
          begin
            dataSet.FieldByName('col_cod_vendedor').AsInteger := vCodMecTecProdAlterClienteVnd;
            dataSet.FieldByName('nome_vend1').AsString := Copy(trim(vMecTec), 1, 35);
          end;
          if vHabVendAlterProdClienteVnd then
          begin
            dataSet.FieldByName('cod_vendedor').AsInteger := vCodVendAlterProdClienteVnd;
            dataSet.FieldByName('nome_vend').AsString := Copy(trim(vVend), 1, 35);
          end;
          dataSet.Post;
        end;

        dataSet.Next;
      end;
    finally
      dataSet.Filtered := false;
    end;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

		if Result then
    begin
    	if vHabMecTecProdAlterClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND290', 'VND294'),
          'ALTERAR',
          'SUCESSO',
          'PEDVENDA',	trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);

      if vHabVendAlterProdClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND291', 'VND295'),
          'ALTERAR',
          'SUCESSO',
          'PEDVENDA',	trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);
    end
    else
    begin
    	if vHabMecTecProdAlterClienteVnd then
        vDadosIni.GravaAuditoria(
          vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND290', 'VND294'),
          'ALTERAR',
          'FALHA',
          'PEDVENDA', trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);

      if vHabVendAlterProdClienteVnd then
        vDadosIni.GravaAuditoria(
        	vDadosIni.IfThen(trim(FOwner.dataSet.FieldByName('tipo').AsString) = 'OS', 'VND291', 'VND295'),
          'ALTERAR',
          'FALHA',
          'PEDVENDA', trim(FOwner.dataSet.FieldByName('tipo').AsString) + ' ' + IntToStr(FOwner.dataSet.FieldByName('nped').AsInteger), buscas);
    end;

    if Result then
      abrePedVendaProd(FOwner.dataSet.FieldByName('nped').AsInteger);

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVendaProd.apply: boolean;
begin
  // Retorno verdadeiro caso não haja erro para baixa.
  Result := true;
  try
    try
      if (DataSet <> nil) and (DataSet.Active) and (DataSet.ChangeCount > 0) then
      begin
        dataSet.OnReconcileError := dataSetReconcileError;
        if DataSet.ApplyUpdates(-1) > 0 then
        begin
          Result := false;
          raise Exception.Create('Erro ao salvar dados');
        end;
      end;
    except
      on E: Exception do
      begin
        MessageDlg(e.Message, mtInformation, [mbOK], 0);
        registraErro(e.Message);
        Result := False;
      end;
    end;
  finally
    dataSet.OnReconcileError := nil;
  end;
end;

function TPedVendaProd.atualizarUnidadeQtdePrecoUnPorCampoPadrao: boolean;
var
	buscas2: TIBQuery;
  I: Integer;
begin
	try
  	Result := True;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

  	try
      if (UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
      begin
        dataSet.FieldByName('OPERACAO_CONV').Value := Null;
        dataSet.FieldByName('FATOR_CONV').Value := Null;

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);

        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
          (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
      end
      else
      begin
        if SqlOpen(' select ps.grupo_prod, ps.cod_prod, ps.cod_empresa, ps.unidade, ' +
          ' ps.quantidade, ps.operacao, ps.disponivel_venda, ps.padrao_venda, ' +
          ' pr.unidade as unidade_prod from produtos pr ' +
          ' inner join produtos_conversao_saida ps on ' +
          '   ps.grupo_prod = pr.grupo_prod ' +
          '		and ps.cod_prod = pr.cod_prod ' +
          '   and ps.cod_empresa = pr.cod_empresa ' +
          ' where ps.grupo_prod = ' + IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) +
          ' and ps.cod_prod = ' + QuotedStr(dataSet.FieldByName('COD_PROD').AsString) +
          ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and upper(ps.unidade) = ' + QuotedStr(UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString))) +
          ' and ps.quantidade > 0 ' +
          ' and ((ps.operacao = ''M'') or (ps.operacao = ''D'')) ', buscas2).IsEmpty then
            exit;
      end;

      if (UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) = UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
      begin
        dataSet.FieldByName('OPERACAO_CONV').Value := Null;
        dataSet.FieldByName('FATOR_CONV').Value := Null;

        dataSet.FieldByName('QUANT_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat, - 4);

        dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

        dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
          dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
      end
      else
      begin
        dataSet.FieldByName('OPERACAO_CONV').AsString := buscas2.FieldByName('OPERACAO').AsString;
        dataSet.FieldByName('FATOR_CONV').AsFloat := buscas2.FieldByName('QUANTIDADE').AsFloat;
        if buscas2.FieldByName('OPERACAO').AsString = 'M' then
        begin
          dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
            dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat *
            buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

          dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
            dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat *
            buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            buscas2.FieldByName('QUANTIDADE').AsFloat, - 4);
        end
        else if buscas2.FieldByName('OPERACAO').AsString = 'D' then
        begin
          dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
            dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat /
            buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

          dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
            dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat /
              buscas2.FieldByName('QUANTIDADE').AsFloat, - StrToInt(vSing.vCasasDecimais));

          dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat := RoundTo(
            dataSet.FieldByName('QUANT_PED_ITEM').AsFloat /
            buscas2.FieldByName('QUANTIDADE').AsFloat, - 4);
        end;

        dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
          (dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
            dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);
      end;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

