            vDAVOrigem := retornaValor(' select nprevenda as valor from pedvenda ' +
            	' where nped = ' + vItProd.dtSetIt.FieldByName('NPED').AsString +
              ' and tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').AsString)) +
              ' and cod_empresa = ' + vDadosIni.CodEmpresa +
              ' and ativo = 1 ');
            if vDAVOrigem <> '' then
              dtSetSincIt.FieldByName('DAV_ORIGEM').AsInteger := strtoint(vDAVOrigem);
            dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItProd.dtSetIt.FieldByName('NPED').AsInteger;
            dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItProd.dtSetIt.FieldByName('TIPO').AsString;

            try
              dtSetSincIt.OnReconcileError := dataSetReconcileError;
              if dtSetSincIt.ApplyUpdates(-1) > 0 then
              begin
                Result := false;
                raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
              end;
            finally
              dtSetSincIt.OnReconcileError := nil;
            end;

            vItProd.dtSetIt.edit;
            vItProd.dtSetIt.FieldByName('STATUS').AsString := 'CANCELADO';

            vdescMesc := vdescMesc +
              (((vItProd.dtSetIt.FieldByName('RATEIO_DESC').AsCurrency -
                vItProd.dtSetIt.FieldByName('NF_DC_DESPNF').AsCurrency) /
                  vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM').AsFloat) *
                    vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat);

            vAcresMesc := vAcresMesc +
              (((vItProd.dtSetIt.FieldByName('RATEIO_ACRESC').AsCurrency -
                vItProd.dtSetIt.FieldByName('VL_DESP_NF').AsCurrency) /
                  vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM').AsFloat) *
                    vItProd.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat);

            vItProd.dtSetIt.FieldByName('RATEIO_DESC').AsCurrency := 0;
            vItProd.dtSetIt.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
            vItProd.dtSetIt.post;
          end;
          vItProd.dtSetIt.Next;
        end;

        if (pTipo = 'OS') and (not vItServ.dtSetIt.IsEmpty) then
        begin
          defineCampos(vItServ.dataSet, true);
          dtSetSincIt.Close;
          dtSetSincIt.CommandText := ' select * from pedvenda_serv ps ' +
            ' where ps.nped = ' + inttostr(pNPED) +
            ' and ps.tipo = ' + QuotedStr(trim(pTipo)) +
            ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ps.ativo = 1 ' +
            ' order by ps.nitem ';
          dtSetSincIt.Open;
          vNitemS := dtSetSincIt.RecordCount;

          vItServ.dtSetIt.Close;
          vItServ.dtSetIt.Filtered := false;
          vItServ.dtSetIt.open;
          vItServ.dtSetIt.IndexFieldNames := 'NITEM';
          
          vItServ.dtSetIt.First;
          while not vItServ.dtSetIt.eof do
          begin
            if (trim(vItServ.dtSetIt.FieldByName('STATUS').AsString) <> 'CANCELADO') and
              (trim(vItServ.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
            begin
              dtSetSincIt.Insert;
              for i := 0 to vItServ.dtSetIt.Fields.Count - 1 do
                if (vItServ.dtSetIt.Fields[I].FieldName <> 'SELEC')
                	and (vItServ.dtSetIt.Fields[I].FieldName <> 'SEL')
                  and (vItServ.dtSetIt.Fields[I].FieldName <> 'VALOR_UN_SERV_LIQ')
                  and (vItServ.dtSetIt.Fields[I].FieldName <> 'VALOR_TOT_SERV_LIQ')
                  and (vItServ.dtSetIt.Fields[I].FieldName <> 'RATEIO_DESC_TEMP')
                  and (vItServ.dtSetIt.Fields[I].FieldName <> 'RATEIO_ACRESC_TEMP') then
                  	dtSetSincIt.FieldByName(vItServ.dtSetIt.Fields[I].FieldName).Value := vItServ.dtSetIt.Fields[I].Value;
                    
              dtSetSincIt.FieldByName('nped').AsInteger := nVenda;
              dtSetSincIt.FieldByName('tipo').AsString := trim(pTipo);
              vTotalRateioDesc := vTotalRateioDesc + dtSetSincIt.FieldByName('RATEIO_DESC').AsCurrency;
              inc(vNitemS);
              dtSetSincIt.FieldByName('NITEM').AsInteger := vNitemS;
              vDAVOrigem := retornaValor(' select nprevenda as valor from pedvenda ' +
              	' where nped = ' + vItServ.dtSetIt.FieldByName('NPED').AsString +
                ' and tipo = ' + QuotedStr(trim(vItServ.dtSetIt.FieldByName('TIPO').AsString)) +
                ' and cod_empresa = ' + vDadosIni.CodEmpresa +
                ' and ativo = 1 ');
              if vDAVOrigem <> '' then
                dtSetSincIt.FieldByName('DAV_ORIGEM').AsInteger := strtoint(vDAVOrigem);
              dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItServ.dtSetIt.FieldByName('NPED').AsInteger;
              dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItServ.dtSetIt.FieldByName('TIPO').AsString;

              try
                dtSetSincIt.OnReconcileError := dataSetReconcileError;
                if dtSetSincIt.ApplyUpdates(-1) > 0 then
                begin
                  Result := false;
                  raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
                end;
              finally
                dtSetSincIt.OnReconcileError := nil;
              end;

              if vDadosIni.vMecOS='S' then
              begin
                if not ExecutaComandosSql(' select * from MECANICO_OS mo '+
                  ' where mo.COD_SERVICO = ' + IntToStr(vItServ.dtSetIt.FieldByName('COD_SERVICO').AsInteger) +
                  ' and mo.nped = '+ IntToStr(nVenda) +
                  ' and mo.tipo = '+ QuotedStr(trim(pTipo)) +
                  ' and mo.cod_empresa = ' + vDadosIni.codEmpresa) then
                begin
                  buscas.Close;
                  buscas.SQL.Text := ' insert into MECANICO_OS '+
                    '(COD_VENDEDOR,N_OS,COD_EMPRESA,COD_SERVICO,PER_COMISSAO, CODIGO_NOP,NPED,TIPO) '+
                    ' select COD_VENDEDOR,N_OS,COD_EMPRESA,COD_SERVICO,PER_COMISSAO, CODIGO_NOP,'+ inttostr(nVenda) +',''OS'' '+
                    ' from MECANICO_OS mo ' +
                    '	where mo.COD_SERVICO = ' + IntToStr(vItServ.dtSetIt.FieldByName('COD_SERVICO').AsInteger) +
                    ' and mo.nped = ' + IntToStr(vItServ.dtSetIt.FieldByName('nped').AsInteger) +
                    ' and mo.tipo = ' + QuotedStr(trim(vItServ.dtSetIt.FieldByName('TIPO').asstring)) +
                    ' and mo.cod_empresa=' + vDadosIni.codEmpresa;
                  buscas.ExecSQL;
                end;
              end;

              vItServ.dtSetIt.edit;
              vItServ.dtSetIt.FieldByName('STATUS').AsString := 'CANCELADO';
              vdescMesc := vdescMesc + vItServ.dtSetIt.FieldByName('RATEIO_DESC').AsCurrency;
              vAcresMesc := vAcresMesc + vItServ.dtSetIt.FieldByName('RATEIO_ACRESC').AsCurrency;

              vItServ.dtSetIt.FieldByName('RATEIO_DESC').AsCurrency := 0;
              vItServ.dtSetIt.FieldByName('RATEIO_ACRESC').AsCurrency := 0;
              vItServ.dtSetIt.post;
            end;
            vItServ.dtSetIt.next;
          end;
        end;

        if (pTipo = 'OS') and (not vItServTerc.dtSetIt.IsEmpty) then
        begin
          defineCampos(vItServTerc.dataSet, true);
          dtSetSincIt.Close;
          dtSetSincIt.CommandText := ' select * from pedvenda_serv_terc pst ' +
            ' where pst.nped = ' + inttostr(pNPED) +
            ' and pst.tipo = ' + QuotedStr(trim(pTipo)) +
            ' and pst.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and pst.ativo = 1 ' +
            ' order by pst.seqid ';
          dtSetSincIt.Open;

          vItServTerc.dtSetIt.Close;
          vItServTerc.dtSetIt.Filtered := false;
          vItServTerc.dtSetIt.open;
          vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';
          
          vItServTerc.dtSetIt.First;
          while not vItServTerc.dtSetIt.eof do
          begin
            if (trim(vItServTerc.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
            begin
              buscas.Close;
              buscas.SQL.Text := ' select * from pedvenda_serv_terc pst ' +
                ' where pst.nped = ' + IntToStr(vDadosIni.IfThen(nVenda > 0, nVenda, pNPED)) +
                ' and pst.tipo = ' + QuotedStr(trim(pTipo)) +
                ' and pst.descr_servt = ' + QuotedStr(trim(vItServTerc.dtSetIt.FieldByName('DESCR_SERVT').AsString)) +
                ' and pst.cod_empresa = ' + vDadosIni.codEmpresa;
              buscas.Open;

              if not buscas.IsEmpty then
              begin
                Application.MessageBox(Pchar('Serviço de terceiro já adicionado: ' + #13 +
                  'SERVIÇO DE TERCEIRO' + #13 +
                  'Descrição: ' + trim(vItServTerc.dtSetIt.FieldByName('DESCR_SERVT').AsString)), 'Atenção', MB_ICONINFORMATION + MB_OK);
                RollBackTransacao;
                Result := false;
                exit;
              end;

              dtSetSincIt.Insert;
              for i := 0 to vItServTerc.dtSetIt.Fields.Count - 1 do
                if (vItServTerc.dtSetIt.Fields[I].FieldName <> 'SELEC')
                  and (vItServTerc.dtSetIt.Fields[I].FieldName <> 'SEL') then
                    dtSetSincIt.FieldByName(vItServTerc.dtSetIt.Fields[I].FieldName).Value := vItServTerc.dtSetIt.Fields[I].Value;

              dtSetSincIt.FieldByName('NPED').AsInteger := nVenda;
              dtSetSincIt.FieldByName('TIPO').AsString := trim(pTipo);
              dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItServTerc.dtSetIt.FieldByName('NPED').AsInteger;
              dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItServTerc.dtSetIt.FieldByName('TIPO').AsString;

              try
                dtSetSincIt.OnReconcileError := dataSetReconcileError;
                if dtSetSincIt.ApplyUpdates(-1) > 0 then
                begin
                  Result := false;
                  raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
                end;
              finally
                dtSetSincIt.OnReconcileError := nil;
              end;
            end;
            vItServTerc.dtSetIt.next;
          end;

          // Deletando todos serviços de terceiros
          try
          	vItServTerc.dtSetIt.Filtered := false;
            vItServTerc.dtSetIt.Filter := ' SELEC = ''S'' ';
            vItServTerc.dtSetIt.Filtered := true;

            vItServTerc.dtSetIt.First;
            while not vItServTerc.dtSetIt.eof do
              vItServTerc.dtSetIt.delete;
          finally
          	vItServTerc.dtSetIt.Filtered := false;
            vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';
          	vItServTerc.dtSetIt.First;
          end;
        end;

        if (pTipo = 'OS') and (not vItProdTerc.dtSetIt.IsEmpty) then
        begin
          defineCampos(vItProdTerc.dataSet, true);
          dtSetSincIt.Close;
          dtSetSincIt.CommandText := ' select * from pedvenda_prod_terc ppt ' +
            ' where ppt.nped = ' + inttostr(pNPED) +
            ' and ppt.tipo = ' + QuotedStr(trim(pTipo)) +
            ' and ppt.cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ppt.ativo = 1 ' +
            ' order by ppt.seqid ';
          dtSetSincIt.Open;

          vItProdTerc.dtSetIt.Close;
          vItProdTerc.dtSetIt.Filtered := false;
          vItProdTerc.dtSetIt.open;
          vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';
          
          vItProdTerc.dtSetIt.First;
          while not vItProdTerc.dtSetIt.eof do
          begin
            if (trim(vItProdTerc.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
            begin
              buscas.Close;
              buscas.SQL.Text := ' select * from pedvenda_prod_terc ppt ' +
                ' where ppt.nped = ' + IntToStr(vDadosIni.IfThen(nVenda > 0, nVenda, pNPED)) +
                ' and ppt.tipo = ' + QuotedStr(trim(pTipo)) +
                ' and ppt.cod_empresa = ' + vDadosIni.codEmpresa +
                ' and ppt.descricao = ' + QuotedStr(trim(vItProdTerc.dtSetIt.FieldByName('DESCRICAO').AsString));
              buscas.Open;

              if not buscas.IsEmpty then
              begin
                Application.MessageBox(Pchar('Produto de terceiro já adicionado: ' + #13 +
                  'PRODUTO DE TERCEIRO' + #13 +
                  'Descrição: ' + trim(vItProdTerc.dtSetIt.FieldByName('DESCRICAO').AsString)), 'Atenção', MB_ICONINFORMATION + MB_OK);
                RollBackTransacao;
                Result := false;
                exit;
              end;

              dtSetSincIt.Insert;
              for i := 0 to vItProdTerc.dtSetIt.Fields.Count - 1 do
                if (vItProdTerc.dtSetIt.Fields[I].FieldName <> 'SELEC')
                  and (vItProdTerc.dtSetIt.Fields[I].FieldName <> 'SEL')
                  and (vItProdTerc.dtSetIt.Fields[I].FieldName <> 'QTDAMESCLAR') then
                    dtSetSincIt.FieldByName(vItProdTerc.dtSetIt.Fields[I].FieldName).Value := vItProdTerc.dtSetIt.Fields[I].Value;

              //alterando as quantidades abaixo, já que agora pode-se informar a quantidade de itens que está se mesclando.
              dtSetSincIt.FieldByName('QTDE').AsFloat := vItProdTerc.dtSetIt.FieldByName('QTDAMESCLAR').AsFloat;
              dtSetSincIt.FieldByName('VL_TOTAL').AsFloat := vDadosIni.StrToFloatFormat((vItProdTerc.dtSetIt.FieldByName('QTDE').AsFloat *
                vItProdTerc.dtSetIt.FieldByName('VL_UNIT').AsCurrency), 2);
              dtSetSincIt.FieldByName('VLCUSTO_TOT').AsFloat := vDadosIni.StrToFloatFormat((vItProdTerc.dtSetIt.FieldByName('QTDE').AsFloat *
                vItProdTerc.dtSetIt.FieldByName('VLCUSTO').AsCurrency), 2);
              dtSetSincIt.FieldByName('NPED').AsInteger := nVenda;
              dtSetSincIt.FieldByName('TIPO').AsString := trim(pTipo);
              dtSetSincIt.FieldByName('NPED_ORIGEM').AsInteger := vItProdTerc.dtSetIt.FieldByName('NPED').AsInteger;
              dtSetSincIt.FieldByName('TIPO_ORIGEM').AsString := vItProdTerc.dtSetIt.FieldByName('TIPO').AsString;

              try
                dtSetSincIt.OnReconcileError := dataSetReconcileError;
                if dtSetSincIt.ApplyUpdates(-1) > 0 then
                begin
                  Result := false;
                  raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
                end;
              finally
                dtSetSincIt.OnReconcileError := nil;
              end;
            end;
            vItProdTerc.dtSetIt.next;
          end;

          // Deletando todos produtos de terceiros
          try
          	vItProdTerc.dtSetIt.Filtered := false;
            vItProdTerc.dtSetIt.Filter := ' SELEC = ''S'' ';
            vItProdTerc.dtSetIt.Filtered := true;

            vItProdTerc.dtSetIt.First;
            while not vItProdTerc.dtSetIt.eof do
              vItProdTerc.dtSetIt.delete;
          finally
          	vItProdTerc.dtSetIt.Filtered := false;
            vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';
            vItProdTerc.dtSetIt.First;
          end;
        end;

        vItProd.dtSetIt.First;
        while not vItProd.dtSetIt.Eof do
        begin
          if (trim(vItProd.dtSetIt.FieldByName('STATUS').AsString) = 'CANCELADO') and
            (trim(vItProd.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
          begin
            if dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA',
            		VarArrayOf([vItProd.dtSetIt.FieldByName('NPED').AsInteger,
                					  trim(vItProd.dtSetIt.FieldByName('TIPO').asstring),
                            strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) then
              if dtSetOrcTemp.FieldByName('STATUS_PED').AsString <> 'CANCELADO' then
              begin
                dtSetOrcTemp.Edit;
                dtSetOrcTemp.FieldByName('STATUS_PED').AsString := 'CANCELADO';
                dtSetOrcTemp.post;
              end;
          end;
          vItProd.dtSetIt.Next;
        end;

        vItProd.dtSetIt.Filtered := false;
        vItProd.dtSetIt.Filter := ' SELEC ='''' and STATUS <>''CANCELADO'' ';
        vItProd.dtSetIt.Filtered := true;
        vItProd.dtSetIt.First;
        while not vItProd.dtSetIt.Eof do
        begin
          if (trim(vItProd.dtSetIt.FieldByName('TIPO').AsString) = 'REQ') then
          begin
            vTipvTemp := retornaValor(' select sigla as valor from tipo_vendas tv ' +
            	' inner join pedvenda v on tv.tipo = v.tipo and tv.sigla = v.tipv ' +
              ' where coalesce(tv.venda,'''')= ''N'' ' +
              ' and v.nped = ' + vItProd.dtSetIt.FieldByName('NPED').AsString +
              ' and v.tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').AsString)) +
              ' and v.cod_empresa = ' + vDadosIni.codEmpresa);
            if (vTipvTemp <> '') then
            begin
              buscas.Close;
              buscas.SQL.Text := ' update pedvenda_prod pp set pp.status = ''CANCELADO'', ' +
                ' pp.quant_item_dev = :qtdITdev, pp.tipv = ' + QuotedStr(vTipvTemp) +
                ' where pp.nped = ' + vItProd.dtSetIt.FieldByName('NPED').AsString +
                ' and pp.nitem = ' + vItProd.dtSetIt.FieldByName('NITEM').AsString +
                ' and pp.tipo = ' + QuotedStr(trim(vItProd.dtSetIt.FieldByName('TIPO').asstring)) +
                ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
                ' and pp.ativo = 1 ';
            //aqui a qtd devolvida é a quantidade do item.
              buscas.ParamByName('qtdITdev').AsFloat := vItProd.dtSetIt.FieldByName('QUANT_PED_ITEM').AsFloat;
              buscas.ExecSQL;
            end;
          end;
          vItProd.dtSetIt.Next;
        end;
        vItProd.dtSetIt.Close;
        vItProd.dtSetIt.Filtered := false;
  //      vItProd.dtSetIt.Filter := 'SELEC=''S'' and STATUS<>''CANCELADO''';
  //      vItProd.dtSetIt.Filtered := true;
        vItProd.dtSetIt.Open;
        vItProd.dtSetIt.IndexFieldNames := 'NITEM';

        if (pTipo <> 'REQ') then
        begin
          vItServ.dtSetIt.First;
          while not vItServ.dtSetIt.Eof do
          begin
            if (trim(vItServ.dtSetIt.FieldByName('STATUS').AsString) = 'CANCELADO') and
              (trim(vItServ.dtSetIt.FieldByName('SELEC').AsString) = 'S') then
            begin
              if dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA',
              		VarArrayOf([vItServ.dtSetIt.FieldByName('NPED').AsInteger,
                  						trim(vItServ.dtSetIt.FieldByName('TIPO').asstring),
                              strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) then
                if dtSetOrcTemp.FieldByName('STATUS_PED').AsString <> 'CANCELADO' then
                begin
                  dtSetOrcTemp.Edit;
                  dtSetOrcTemp.FieldByName('STATUS_PED').AsString := 'CANCELADO';
                  dtSetOrcTemp.post;
                end;
            end;
            vItServ.dtSetIt.Next;
          end;
        end;

        vlista.Clear;
        VdescUltMesclado := 0;
        dtSetOrcTemp.first;
        while not dtSetOrcTemp.Eof do
        begin
          if dtSetOrcTemp.FieldByName('STATUS_PED').AsString = 'CANCELADO' then
          begin
            vlista.Add(dtSetOrcTemp.FieldByName('nprevenda').AsString);
            ExecutaComandosSqlExec(' update pedvenda v set v.status_ped=''CANCELADO'' ' +
              ', DATA_FECH = '+QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas))) +
              ', NPED_ORIGINADO = ' + IntToStr(nVenda) +
              ', TIPO_ORIGINADO = ' + Trim(QuotedStr(pTipo)) +
              ' where v.nped = ' + dtSetOrcTemp.FieldByName('NPED').AsString +
              ' and v.tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').asstring)) +
              ' and v.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and v.ativo = 1 ');
            ExecutaComandosSqlExec(' update pedvenda_prod pp set pp.status=''CANCELADO'' ' +
              ' where pp.nped = ' + dtSetOrcTemp.FieldByName('NPED').AsString +
              ' and pp.tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').asstring)) +
              ' and pp.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and pp.ativo = 1 ');
            ExecutaComandosSqlExec(' update pedvenda_serv ps set ps.status=''CANCELADO'' ' +
              ' where ps.nped = ' + dtSetOrcTemp.FieldByName('NPED').AsString +
              ' and ps.tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').asstring)) +
              ' and ps.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and ps.ativo = 1');
            ExecutaComandosSqlExec(' delete from pedvenda_serv_terc pst ' +
              ' where pst.nped = ' + dtSetOrcTemp.FieldByName('NPED').AsString +
              ' and pst.tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').asstring)) +
              ' and pst.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and pst.ativo = 1');
            ExecutaComandosSqlExec(' delete from pedvenda_prod_terc ppt ' +
              ' where ppt.nped = ' + dtSetOrcTemp.FieldByName('NPED').AsString +
              ' and ppt.tipo = ' + QuotedStr(trim(dtSetOrcTemp.FieldByName('TIPO').asstring)) +
              ' and ppt.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and ppt.ativo = 1');

            VdescUltMesclado := VdescUltMesclado + dtSetOrcTemp.FieldByName('DESCONTO').ascurrency;
          end;
          dtSetOrcTemp.Next;
        end;

        if (vTotalRateioDesc > 0) or (vTotalRateioAcresc > 0) then
        begin
          dtSetSinc.Close;
          dtSetSinc.CommandText := 'select v.* from pedvenda v ' +
            ' where v.nped = ' + inttostr(nVenda) +
            ' and v.tipo = ' + QuotedStr(pTipo) +
            ' and v.cod_empresa=' + vDadosIni.codEmpresa +
            ' and v.ativo = 1 ';
          dtSetSinc.Open;
          dtSetSinc.Edit;

          if dtSetSinc.FieldByName('NF_AC_CALCTRIB').AsString = 'S' then
            dtSetSinc.FieldByName('NF_DC_DESCONTO').AsFloat := vTotalRateioDesc;

          dtSetSinc.FieldByName('DESCONTO').AsFloat := vTotalRateioDesc;
          dtSetSinc.FieldByName('ACRESCIMO').AsFloat := vTotalRateioAcresc;
          
          try
            dtSetSinc.OnReconcileError := dataSetReconcileError;
            if dtSetSinc.ApplyUpdates(-1) > 0 then
            begin
              Result := false;
              raise Exception.Create('Erro na mesclagem: Erro ao salvar dados do pedido ou da ocorrrêcia do pedido.');
            end;
          finally
            dtSetSinc.OnReconcileError := nil;
          end;
        end;

        Result := CommitaTransacao;
        for I := 0 to vlista.Count - 1 do
        try
          vMD5Func._gravaMD5_DAV(buscas, StrToInt(vlista[i]));
          vItProd.dtSetIt.First;
          while not vItProd.dtSetIt.Eof do
          begin
            vMD5Func._gravaMD5_Produtos(buscas,
              vItProd.dtSetIt.FieldByName('grupo_prod').AsInteger,
              vItProd.dtSetIt.FieldByName('cod_prod').AsString);
            vItProd.dtSetIt.Next;
          end;
        except
        end;

        if result then
        begin
          dtSetOrcTemp.EmptyDataSet;
          if (pTipo = 'OS') then
            Application.MessageBox(pchar('Sucesso na mesclagem do DAVs.' + chr(13) + 'A Ordem de serviço número ' + IntToStr(nVenda) + ' agora está aberta para que se proceda com seu FECHAMENTO.'), 'Atenção',
              +MB_ICONINFORMATION + MB_OK)
          else if (pTipo = 'REQ') then
            Application.MessageBox(pchar('Sucesso na mesclagem do DAVs.' + chr(13) + 'A Requisição de Venda número ' + IntToStr(nVenda) + ' agora está aberta para que se proceda com seu FECHAMENTO.'), 'Atenção',
              +MB_ICONINFORMATION + MB_OK);
        end
        else
        begin
          dtSetOrcTemp.First;
          while not dtSetOrcTemp.Eof do
          begin
            dtSetOrcTemp.Edit;
            dtSetOrcTemp.FieldByName('STATUS_PED').AsVariant := null;
            dtSetOrcTemp.post;
            dtSetOrcTemp.Next;
          end;
          
          vItProd.dtSetIt.Close;
          vItProd.dtSetIt.Filtered := false;
          vItProd.dtSetIt.open;
          vItProd.dtSetIt.IndexFieldNames := 'NITEM';
          
          vItProd.dtSetIt.First;
          while not vItProd.dtSetIt.eof do
          begin
            if vItProd.dtSetIt.FieldByName('SELEC').AsString = 'S' then
            begin
              vItProd.dtSetIt.Edit;
              vItProd.dtSetIt.FieldByName('STATUS').AsVariant := null;
              vItProd.dtSetIt.Post;
            end;
            vItProd.dtSetIt.Next;
          end;
          
          vItServ.dtSetIt.Close;
          vItServ.dtSetIt.Filtered := false;
          vItServ.dtSetIt.open;
          vItServ.dtSetIt.IndexFieldNames := 'NITEM';
          
          vItServ.dtSetIt.First;
          while not vItServ.dtSetIt.eof do
          begin
            if vItServ.dtSetIt.FieldByName('SELEC').AsString = 'S' then
            begin
              vItServ.dtSetIt.Edit;
              vItServ.dtSetIt.FieldByName('STATUS').AsVariant := null;
              vItServ.dtSetIt.Post;
            end;
            vItServ.dtSetIt.Next;
          end;

          vItServTerc.dtSetIt.Close;
          vItServTerc.dtSetIt.Filtered := false;
          vItServTerc.dtSetIt.open;
          vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';

          vItServTerc.dtSetIt.First;

          vItProdTerc.dtSetIt.Close;
          vItProdTerc.dtSetIt.Filtered := false;
          vItProdTerc.dtSetIt.open;
          vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';
          
          vItProdTerc.dtSetIt.First;
        end;
    except
      on e: Exception  do
        begin
          RollBackTransacao;
          
          vItProd.dtSetIt.Close;
          vItProd.dtSetIt.Filtered := false;
          vItProd.dtSetIt.open;
          vItProd.dtSetIt.IndexFieldNames := 'NITEM';

          vItProd.dtSetIt.first;
          while not vItProd.dtSetIt.Eof do
          begin
            vItProd.dtSetIt.edit;
            vItProd.dtSetIt.FieldByName('STATUS').AsString := '';
            vItProd.dtSetIt.post;

            vItProd.dtSetIt.next;
          end;
          vItProd.dtSetIt.first;

          vItServ.dtSetIt.Close;
          vItServ.dtSetIt.Filtered := false;
          vItServ.dtSetIt.open;
          vItServ.dtSetIt.IndexFieldNames := 'NITEM';
          
          vItServ.dtSetIt.first;
          while not vItServ.dtSetIt.Eof do
          begin
            vItServ.dtSetIt.edit;
            vItServ.dtSetIt.FieldByName('STATUS').AsString := '';
            vItServ.dtSetIt.post;

            vItServ.dtSetIt.next;
          end;
          vItServ.dtSetIt.first;

          vItServTerc.dtSetIt.Close;
          vItServTerc.dtSetIt.Filtered := false;
          vItServTerc.dtSetIt.open;
          vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';
          
          vItServTerc.dtSetIt.first;

          vItProdTerc.dtSetIt.Close;
          vItProdTerc.dtSetIt.Filtered := false;
          vItProdTerc.dtSetIt.open;
          vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';
          
          vItProdTerc.dtSetIt.first;

          registraErro('TPedVenda.MesclarDAVsOSREQ. ' +
            pTipo + ' - ' + IntToStr(nVenda) + ' - ' + 'PEDIDO' + ' - ' + 'Iniciado. Erro: ' + E.Message) ;
          Application.MessageBox(pchar(E.Message),'Atenção', 0 + 64);
          Result := false;
          exit;
      end;
    end;
  finally
    if not result then
    begin
    	if trim(comandoTexto) <> '' then
	      montaSelect(comandoTexto);
    end
    else
    begin
      UltimoNpedMesclado := nVenda;
    end;

    if Assigned(buscas2) then
    	FreeAndNil(buscas2);

    if Assigned(vlista) then
    	FreeAndNil(vlista);

    if dtSetSincIt <> nil then
      dtSetSincIt.close;

    if dtSetSinc <> nil then
      dtSetSinc.close;

    vItProd.dtSetIt.Close;
    vItProd.dtSetIt.Filtered := false;
    vItProd.dtSetIt.Open;
    vItProd.dtSetIt.IndexFieldNames := 'NITEM';

    vItServ.dtSetIt.Close;
    vItServ.dtSetIt.Filtered := false;
    vItServ.dtSetIt.Open;
    vItServ.dtSetIt.IndexFieldNames := 'NITEM';

    vItServTerc.dtSetIt.Close;
    vItServTerc.dtSetIt.Filtered := false;
    vItServTerc.dtSetIt.Open;
    vItServTerc.dtSetIt.IndexFieldNames := 'SEQID';

    vItProdTerc.dtSetIt.Close;
    vItProdTerc.dtSetIt.Filtered := false;
    vItProdTerc.dtSetIt.Open;
    vItProdTerc.dtSetIt.IndexFieldNames := 'SEQID';

    enableControlsDataSets;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVenda.moverParaLixeira: boolean;
begin
  if not dataSet.Active then
    Exit;
  if dataSet.IsEmpty then
    Exit;
  dataSet.Edit;
  dataSet.FieldByName('ATIVO').asinteger := 0;
  dataSet.Post;
  if Apply then
    if emTransacao then
      if CommitaTransacao then
        vDadosIni.GravaAuditoria('VND004', 'ENVIADO PARA LIXEIRA ' + getTipoVenda + ' Nº ' +
          dataSet.FieldByName('NPED').AsString, '', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
end;

procedure TPedVenda.NotificarEstoqueMinimoAtingido;
var
  Aprodutos: TDataSet_OOP;
  vData: TDateTime;
  vEstMin: Boolean;
begin
  if not Assigned(FestoqueMinimoAtingido) then
    Exit;
  Aprodutos := TDataSet_OOP.Create(dtmAtivo.bancoHw);
  try

    Aprodutos.montaSelect('select pvp.nitem, pvp.grupo_prod, pvp.cod_prod, ' +
    											' pvp.num_fab_prod codigo, pvp.quant_ped_item qtde_documento, ' +
                          ' pr.n_min_prod minimo, pr.n_max_prod maximo, ' +
                          ' (coalesce(est.estoque, 0)) disponivel, ' +
                          ' (coalesce(est.est_f, 0) - coalesce(est.estoque, 0)) pendencias, ' +
                          vDadosIni.IfThen(vDadosIni.vEmp.vUsarProducao = 'S',
                            ' (coalesce(est.est_prima, 0)) qtdeproduzir, ', '') +
                          ' pvp.descr_prod_ped descricao ' +
                          ' from pedvenda_prod pvp ' +
                          ' inner join produtos pr on pr.grupo_prod = pvp.grupo_prod and pr.cod_prod = pvp.cod_prod and pr.cod_empresa = pvp.cod_empresa ' +
                          ' left join getestoquedisponivel(pvp.grupo_prod, pvp.cod_prod, pvp.cod_grade, pvp.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
                          ' where pvp.nped = %d and pvp.tipo = %s and pvp.cod_empresa = %d and coalesce(pvp.status, '''') <> ''CANCELADO'' ',
                          [fint('nped'), fstrq('tipo'), fint('cod_empresa')]);
    TFloatField(Aprodutos.dataSet.FieldByName('minimo')).DisplayFormat       := '#0.000';
    TFloatField(Aprodutos.dataSet.FieldByName('maximo')).DisplayFormat       := '#0.000';
    TFloatField(Aprodutos.dataSet.FieldByName('disponivel')).DisplayFormat   := '#0.000';
    TFloatField(Aprodutos.dataSet.FieldByName('pendencias')).DisplayFormat   := '#0.000';
    if vDadosIni.vEmp.vUsarProducao = 'S' then
    begin
    	Aprodutos.dataSet.FieldByName('qtdeproduzir').DisplayLabel := 'Qtd. Produzir';
      TFloatField(Aprodutos.dataSet.FieldByName('qtdeproduzir')).DisplayFormat := '#0.000';
    end;
    with Fconf.est_min_notificar do
    begin
      if ReadString('Conf', 'SempreMostrar', 'N') = 'S' then
        FestoqueMinimoAtingido(Aprodutos)
      else
      begin
      	if vDadosIni.vEmp.vUsarProducao = 'S' then
	        Aprodutos.filterStr('disponivel + qtdeproduzir <= minimo')
        else
        	Aprodutos.filterStr('disponivel <= minimo');
        if Aprodutos.dataSet.RecordCount > 0 then
        begin
          vData := vDadosIni.getDataBanco(buscas);
        	try
            Aprodutos.dataSet.First;
            while not Aprodutos.dataSet.Eof do
            begin
              vEstMin := False;
              if (vDadosIni.vEmp.vUsarProducao = 'S') then
              begin
              	if (Aprodutos.dataSet.FieldByName('disponivel').AsFloat +
                		Aprodutos.dataSet.FieldByName('qtdeproduzir').AsFloat <= Aprodutos.dataSet.FieldByName('minimo').AsFloat) then
                    	vEstMin := True;
              end
              else
              begin
                if (Aprodutos.dataSet.FieldByName('disponivel').AsFloat <= Aprodutos.dataSet.FieldByName('minimo').AsFloat) then
                  	vEstMin := True;
              end;

              if vEstMin then
              begin
                buscas.Close;
                buscas.SQL.Text := ' UPDATE OR INSERT INTO EST_MIN_PROD ' +
                  ' (GRUPO_PROD, COD_PROD, COD_EMPRESA, DATA) ' +
                  ' VALUES ' +
                  ' (:GRUPO_PROD, :COD_PROD, :COD_EMPRESA, :DATA) ' +
                  ' MATCHING (GRUPO_PROD, COD_PROD, COD_EMPRESA, DATA); ';
                buscas.ParamByName('GRUPO_PROD').AsInteger := Aprodutos.dataSet.FieldByName('GRUPO_PROD').AsInteger;
                buscas.ParamByName('COD_PROD').AsString := Aprodutos.dataSet.FieldByName('COD_PROD').AsString;
                buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
                buscas.ParamByName('DATA').AsDateTime := vData;
                buscas.ExecSQL;
              end;

              Aprodutos.dataSet.Next;
            end;
          finally
            Aprodutos.dataSet.First;
          end;

          if buscas.Transaction.InTransaction then
            buscas.Transaction.Commit;

          if ReadString('Conf', 'MostrarTodos', 'N') = 'S' then
            Aprodutos.filterClear;
          FestoqueMinimoAtingido(Aprodutos)
        end;
      end;
    end;
  finally
    FreeAndNil(Aprodutos);
  end;
end;

function TPedVenda.pedidoEmEdicao(pAcao: CAcaoSaveAuto; pMensagem: Boolean;
  pGravaAuditoria: Boolean ): Boolean;
var
  vCodigo: Integer;
begin
  Result := False;
  if (Trim(dataSet.FieldByName('SAVEAUTO').AsString) = 'S') and (Trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'CANCELADO') then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select us_edit from pedvenda' +
      ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
      ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
      ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
    buscas.Open;

    vCodigo := buscas.FieldByName('us_edit').AsInteger;

    Result := vCodigo > 0;

    if (pAcao = caNenhuma) then
      Exit;

    if (vCodigo > 0) and ( pAcao = caAdicionarEdicao) and (pMensagem) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select nome_vendedor from colaborador' +
        ' where cod_vendedor = ' + IntToStr(vCodigo) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
      buscas.Open;

      Application.MessageBox(PChar('Registro está sendo alterado pelo usuário: ' + IntToStr(vCodigo) +
        ' - ' + Trim(buscas.FieldByName('nome_vendedor').AsString) + #13 + #13 +
        'Este registro esta configurado para salvamento automático, cada alteração que é feita' +
        ' nos itens é salvo no banco de dados automaticamente.' + #13 + #13 +
        'Se o sistema foi encerrado de forma indevida o registro pode ser liberado usando o botão direito no mouse' +
        ' sobre a linha e escolhendo a opção "Remover Status Editando - [VND195]"'
        ), 'Atenção', 0 + 64);
      Exit;
    end;

    if ((pAcao = caRemoverEdicao) and (vCodigo > 0)) then  // caso o metodo seja chamado e o registro nao tenha iniciado a edicao pela instancia deste sistema ou o processo de remocao de status
      if not fEmEdicaoSaveAuto then             // a variavel fEmEdicaoSaveAuto terá o valor "true", caso a instancia nao seja deste sistema nem o processo de remocao de status
        Exit;                                   // a variavel fEmEdicaoSaveAuto terá o valor "false", nao alterando o registro nesta ultima situacao 

    if ((pAcao = caRemoverEdicao) and (vCodigo > 0)) or ((pAcao = caAdicionarEdicao) and (vCodigo = 0)) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'update pedvenda set US_EDIT = :US_EDIT' +
        ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
        ' and cod_empresa = ' + IntToStr(dataSet.FieldByName('cod_empresa').AsInteger);
      if pAcao = caRemoverEdicao then
        buscas.ParamByName('US_EDIT').Value := Null
      else
        buscas.ParamByName('US_EDIT').AsInteger := vDadosIni.vCodUsuario;

      try
        buscas.ExecSQL;

        if buscas.Transaction.InTransaction then
          buscas.Transaction.Commit;

        if pAcao = caAdicionarEdicao then
          fEmEdicaoSaveAuto := True
        else
          fEmEdicaoSaveAuto := False;

        if (pAcao = caRemoverEdicao) and (pGravaAuditoria) then
          vDadosIni.GravaAuditoria('VND195', 'ALTERAR', 'TIPO:' +
            dataSet.FieldByName('TIPO').AsString + ' NUM ' +
            dataSet.FieldByName('NPED').AsString +
            vDadosIni.retornoPorCondicao(pAcao = caRemoverEdicao, ' REMOCAO', ' ADICAO') + ' - SUCESSO', 'PEDVENDA',
            dataSet.FieldByName('NPED').AsString, buscas);
      except
        on E: exception do
        begin
          registraErro( 'function TPedVenda.pedidoEmEdicao.' +
            vDadosIni.retornoPorCondicao( pAcao = caRemoverEdicao,
              'Remover_US_EDIT=' + IntToStr(vCodigo),
              'Adicionar_US_EDIT=' + IntToStr(vDadosIni.vCodUsuario)
            ) + '.' +
            Trim(dataSet.FieldByName('tipo').AsString) + '=' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
            '. Erro: ' + e.Message);
          Application.MessageBox(PChar('Erro ao tentar ' +
            string(vDadosIni.retornoPorCondicao(pAcao = caRemoverEdicao, 'remover', 'adicionar')) +
          ' status em edição n' + vSing.nomeVenda + ' ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          '. Erro: ' + e.Message), 'Atenção', 0 + 64);
        end;
      end;
    end;
  end;
end;

function TPedVenda.pedvenda_biu_conf_total: boolean;
var
  sum_total: Double;
  sum_prod: Double;
  sum_serv: Double;
  sum_prod_terc: Double;
  sum_serv_terc: Double;

  val_tot: Double;
  val_acr: Double;
  val_des: Double;
begin
	try
		Result := True;

    sum_prod      := 0;
    sum_serv      := 0;
    sum_total     := 0;
    sum_prod_terc := 0;
    sum_serv_terc := 0;

    //Produtos
    buscas.Close;
	  buscas.SQL.Text := ' select sum(coalesce(pvp.vltot_ped_item, 0)) vltot_ped_item, ' +
    	' sum(coalesce(pvp.rateio_desc, 0)) rateio_desc, ' +
      ' sum(coalesce(pvp.rateio_acresc, 0)) rateio_acresc from pedvenda_prod pvp ' +
      ' where pvp.nped = :nped and pvp.tipo = :tipo and pvp.cod_empresa = :cod_empresa ' +
      ' and coalesce(pvp.status, '''') = '''' ';
    buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
    buscas.ParamByName('tipo').AsString := vSing.vTipoVenda;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    val_tot       := buscas.FieldByName('VLTOT_PED_ITEM').AsFloat;
    val_acr       := buscas.FieldByName('RATEIO_ACRESC').AsFloat;
    val_des       := buscas.FieldByName('RATEIO_DESC').AsFloat;

    sum_prod      := val_tot + val_acr - val_des;
    sum_total     := sum_total + sum_prod;

    //Servicos
    buscas.Close;
	  buscas.SQL.Text := ' select sum(coalesce(pvs.valor_tot_serv, 0)) valor_tot_serv, ' +
			' sum(coalesce(pvs.rateio_desc, 0)) rateio_desc, ' +
      ' sum(coalesce(pvs.rateio_acresc, 0)) rateio_acresc from pedvenda_serv pvs ' +
      ' where pvs.nped = :nped and pvs.tipo = :tipo and pvs.cod_empresa = :cod_empresa ' +
      ' and coalesce(pvs.status, '''') = '''' ';
    buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
    buscas.ParamByName('tipo').AsString := vSing.vTipoVenda;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    val_tot       := buscas.FieldByName('VALOR_TOT_SERV').AsFloat;
    val_acr       := buscas.FieldByName('RATEIO_ACRESC').AsFloat;
    val_des       := buscas.FieldByName('RATEIO_DESC').AsFloat;

    sum_serv      := val_tot + val_acr - val_des;
    sum_total     := sum_total + sum_serv;

    //Produtos Terceiro
    buscas.Close;
	  buscas.SQL.Text := ' select sum(coalesce(pvpt.vl_total, 0)) vl_total, ' +
    	' sum(0) rateio_desc, ' +
      ' sum(0) rateio_acresc from pedvenda_prod_terc pvpt ' +
      ' where pvpt.nped = :nped and pvpt.tipo = :tipo and pvpt.cod_empresa = :cod_empresa ';
    buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
    buscas.ParamByName('tipo').AsString := vSing.vTipoVenda;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    val_tot       := buscas.FieldByName('VL_TOTAL').AsFloat;
    val_acr       := buscas.FieldByName('RATEIO_ACRESC').AsFloat;
    val_des       := buscas.FieldByName('RATEIO_DESC').AsFloat;

    sum_prod_terc := val_tot + val_acr - val_des;
    sum_total     := sum_total + sum_prod_terc;

    //Servicos Terceiro
    buscas.Close;
	  buscas.SQL.Text := ' select sum(coalesce(pvt.vl_servt, 0)) vl_servt, ' +
    	' sum(0) rateio_desc, ' +
      ' sum(0) rateio_acresc from pedvenda_serv_terc pvt ' +
      ' where pvt.nped = :nped and pvt.tipo = :tipo and pvt.cod_empresa = :cod_empresa ';
    buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
    buscas.ParamByName('tipo').AsString := vSing.vTipoVenda;
    buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    val_tot       := buscas.FieldByName('VL_SERVT').AsFloat;
    val_acr       := buscas.FieldByName('RATEIO_ACRESC').AsFloat;
    val_des       := buscas.FieldByName('RATEIO_DESC').AsFloat;

    sum_serv_terc := val_tot + val_acr - val_des;
    sum_total     := sum_total + sum_serv_terc;

    if (RoundTo(sum_total, -2) <> RoundTo(dataSet.FieldByName('VALOR_TOTAL').AsFloat, -2)) then
    begin
    	buscas.Close;
		  buscas.SQL.Text := ' update pedvenda set valor_total = :valor_total ' +
      	' where nped = :nped and tipo = :tipo and cod_empresa = :cod_empresa ';
      buscas.ParamByName('valor_total').AsFloat := RoundTo(sum_total, -2);
      buscas.ParamByName('nped').AsInteger := dataSet.FieldByName('nped').AsInteger;
      buscas.ParamByName('tipo').AsString := vSing.vTipoVenda;
      buscas.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;

      if buscas.Transaction.InTransaction then
      	buscas.Transaction.Commit;
    end;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar('Erro ao efetuar somatorio dos itens. Proceder novamente com o salvamento'), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao efetuar somatorio dos itens. Proceder novamente com o salvamento - ' + e.Message);
    end;
  end;
end;

function TPedVenda.permiteImpressaoDocumento(PedirProcesso: Boolean): Boolean;
var
  QtdePermitida: Smallint;
begin
  Result:= True;
  if Trim(dataSet.FieldByName('tipo').AsString) = 'REQ' then
    QtdePermitida := vDadosIni.vPedVnd.qtdeImpressaoReq
  else if Trim(dataSet.FieldByName('tipo').AsString) = 'OS' then
    QtdePermitida := vDadosIni.vPedVnd.qtdeImpressaoOS
  else
    QtdePermitida := vDadosIni.vPedVnd.qtdeImpressaoOrc;
  if QtdePermitida = 0 then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select QTDE_IMPRESSAO from pedvenda' +
    ' where nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
    ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  if buscas.FieldByName('QTDE_IMPRESSAO').AsInteger >= QtdePermitida then
  begin
    Result := False;
    if PedirProcesso then
      if not vDadosIni.PesqPros('VND225', 'IMPRIMIR', Trim(dataSet.FieldByName('tipo').AsString), 'PEDVENDA',
        dataSet.FieldByName('NPED').AsString, buscas, true) then
      begin
        Result := False;
        Application.MessageBox(Pchar('Reimpressão não permitida. Limite de impressões atingido'), 'Atenção', MB_ICONERROR + MB_OK);
      end
      else
        Result := True;
  end;
end;

function TPedVenda.post(pAlmox: boolean = false): boolean;
var
  grupo, codigo, cfop: string;
  nPed: integer;
  stado: TDataSetState;
  vinsOS: smallint;
  vOK: boolean;
  vConfTotal: boolean;
  ConfigPoliticaPag: TConfig_sistema_class;
  vUsarControlesVenda: string;
  existeRetencaoProdutos, existeRetencaoServicos: boolean;
  vDataTmp: TDateTime;
  vSqlTmp: string;
  vProcessoPesqVendedor: string;
  AProcedure: Tcl_abreSituacaoDeCaixa;
  vAtualizarCl: Boolean;
begin
	try
  	try
	  	Result := false;

  	  vDadosIni.logsPedvenda(Self.ClassName + '.post - begin', 'pedvenda');

      if vDadosIni.vTsPlus = 'S' then
      begin
			  if (not dataSet.FieldByName('DATA_PED').IsNull) then
        	vDataTmp := dataSet.FieldByName('DATA_PED').AsDateTime
        else
         	vDataTmp := vDadosIni.getDataBanco(buscas);
      end;

  	  vConfTotal := true;

      ConfigPoliticaPag := TConfig_sistema_class.getConf('ped_vnd_definir_politica_pagamento', buscas, vDadosIni.cod_empresa);
  	  vUsarControlesVenda := UpperCase(ConfigPoliticaPag.ReadString('CONTROLE', 'Usar'));

      disableControlsDataSets;
      vinsOS := 0;
      //Baixar Grade
//      vItProd.QuestionarBaixaGrade := true;
      vCliente.LocCliente(f_int('cod_cliente'));

      if vDadosIni.vCashback.vHabilitarCashback then
      	if (trim(vCliente.fstr('cpfcgc')) = '') and (trim(vCliente.fstr('fone_celular')) = '') then
        	Application.MessageBox(PChar('Empresa utiliza o Programa de Cashback: '+ #13 + #13 +
        		'Cliente sem CPF/CNPJ e Celular, para gerar cashback é necessário informar o CPF/CNPJ ou Celular'),
            'Atenção', MB_ICONWARNING + MB_OK);

      if vItProd.dataSet.State in [dsInsert, dsEdit] then
        if not vItProd.post then
        begin
          Result := false;
          exit;
        end;
      if vSing.vTipoVenda <> 'ORC' then
        if not vItProd.vProduto.validaEstoqueFechamento then
          exit;

      if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
      begin
        if vItServ.dataSet.State in [dsInsert, dsEdit] then
          if not vItServ.post then
          begin
            Result := false;
            exit;
          end;
        if vItServTerc.dataSet.State in [dsInsert, dsEdit] then
          if not vItServTerc.post then
          begin
            Result := false;
            exit;
          end;
        if vItProdTerc.dataSet.State in [dsInsert, dsEdit] then
          if not vItProdTerc.post then
          begin
            Result := false;
            exit;
          end;

        if (vDadosIni.vMecOS = 'S') and not (vItServ.dataSet.IsEmpty) then
        begin
