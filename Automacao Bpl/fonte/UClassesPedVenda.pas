    if Pos('(', Campo) > 0 then
    begin
      FieldFormat := Copy(Campo, Pos('(', Campo), Length(Campo));
      Campo := Copy(Campo, 1, Pos('(', Campo) - 1);
    end
    else
      FieldFormat := '';
    if Tabela = 'PEDVENDA' then
      TabDT := dataSet
    else if Tabela = 'PEDVENDA_PROD' then
      TabDT := vItProd.dataSet
    else if Tabela = 'PEDVENDA_SERV' then
      TabDT := vItServ.dataSet
    else if Tabela = 'PEDVENDA_SERV_TERC' then
      TabDT := vItServTerc.dataSet
    else if Tabela = 'PEDVENDA_PROD_TERC' then
      TabDT := vItServTerc.dataSet
    else if Tabela = 'CLIENTES' then
      TabDT := qCliente
    else if Tabela = 'VW_CLIENTES_DEST' then
      TabDT := qCl_endAd
    else if Tabela = 'COND_PAG' then
      TabDT := qCondPag
    else if Tabela = 'EMPRESA' then
      TabDT := qEmpresa
    else if Tabela = 'COLABORADOR' then
      TabDT := qColab
    else if Tabela = 'VEICULOS' then
      TabDT := qVeiculo;

    if TabDT <> nil then
      Field := TabDT.FindField(Campo);
    Result := Field <> nil;
    if not Result then
      Campo := Tabela + '.' + Campo;
  end;

  function CountTags(Value: string): Integer;
  var
    K: Integer;
    ValueNoTag: string;
    TagAberta: Boolean;
  begin
    ValueNoTag := '';
    TagAberta := False;
    for K := 1 to Length(Value) do
    begin
      if (not TagAberta) and (Value[K] = '<') then
        TagAberta := True
      else if (TagAberta) and (Value[K] = '>') then
        TagAberta := False
      else if not TagAberta  then
        ValueNoTag := ValueNoTag + Value[K];
    end;
    Result := Length(Value) - Length(ValueNoTag);
  end;

  function ReplaceForSpace(Value: string; Tamanho: Integer; Separador: string = '|'): string;
  var
    IntegerTmp: Integer;
    NewValue: string;
    K, CountAddChar, CountValue, CountNewValue, CountFinalValue: Integer;
  begin
    CountFinalValue := Tamanho + CountTags(Value);
    if Length(Value) >= (CountFinalValue) then
    begin
      Result := StringReplace(Value, Separador, ' ',[rfReplaceAll]);
      Exit;
    end;
    if Pos(Separador, Value) = 0 then
    begin
      Result := Value;
      Exit;
    end;
    CountAddChar  := 0;
    CountValue    := Length(Value);
    CountNewValue := CountValue + CountAddChar;

    while CountNewValue < CountFinalValue do
    begin
      NewValue      := '';
      for K := 1 to CountValue do
      begin
        CountNewValue := CountValue + CountAddChar;

        if (CountNewValue < CountFinalValue) then
        begin
          if Value[K] = Separador then
          begin
            NewValue := NewValue + ' ' + Separador;
            CountAddChar := CountAddChar + 1;
          end
          else
            NewValue := NewValue + Value[K];
        end
        else
          NewValue := NewValue + Value[K];
      end;
      Value         := NewValue;
      CountAddChar  := 0;
      CountValue    := Length(Value);
      CountNewValue := CountValue + CountAddChar;

    end;
    Result := StringReplace(NewValue, Separador, ' ',[rfReplaceAll]);

//    IntegerTmp := Tamanho - Length(Value) - 1;
//    Result := StringReplace(Value, Separador, vDadosIni.Replicate(' ', IntegerTmp),[]);
  end;

  procedure MontarItem;
  begin
    if dadosImp.bItensEmUmaLinha then
    begin
      StrVal := dadosImp.sItem + ' ' + dadosImp.sCodigo + ' ' + '[DesProd] ' + dadosImp.sQuantidade + ' ' +
        dadosImp.sUnidade + vDadosIni.IfThen(dadosImp.sUnidade = '', '', ' X ') +
        dadosImp.sVlrUnitario + ' ' + dadosImp.sVlrProduto;

      IntTmp := ColunasCondensado - Length(StrVal) + 9;
      dadosImp.sDescricao := Copy(dadosImp.sDescricao + vDadosIni.Replicate(' ', 57), 1, IntTmp);

      StrVal := StringReplace(StrVal, '[DesProd]', dadosImp.sDescricao, [rfReplaceAll]);
      Impressao.Add('</ae><c>' + StrVal + '</c>');
    end
    else
    begin
      StrVal := dadosImp.sItem + ' ' + dadosImp.sCodigo + ' ' + dadosImp.sDescricao;
      Impressao.Add('</ae><c>' + StrVal + '</c>');

      StrVal :=  ReplaceForSpace(dadosImp.sQuantidade + '|', 15) + ' ' +
        vDadosIni.IfThen(dadosImp.sUnidade = '', '',
        ReplaceForSpace(dadosImp.sUnidade + '|', 6) + ' X ') +
        ReplaceForSpace(dadosImp.sVlrUnitario + '|', 13) + '|' + dadosImp.sVlrProduto;
      StrVal := ReplaceForSpace(StrVal, ColunasCondensado);
      Impressao.Add('</ae><c>' + StrVal + '</c>');
    end;

    if dadosImp.bItensImprimirAcrescDesc then
    begin
      StrVal := '';
      if (dadosImp.sDesconto <> '') and (dadosImp.sAcrescimo <> '') then
        StrVal := ReplaceForSpace(
            ReplaceForSpace('desconto|' + dadosImp.sDesconto, 15) + '|' +
            ReplaceForSpace('acréscimo|' + dadosImp.sAcrescimo, 15) + '|' + dadosImp.sVlrLiquido, ColunasCondensado)
      else if (dadosImp.sDesconto <> '') then
        StrVal := ReplaceForSpace(
            ReplaceForSpace('desconto|'  + dadosImp.sDesconto , 15) + '|' + dadosImp.sVlrLiquido, ColunasCondensado)
      else if (dadosImp.sAcrescimo <> '') then
        StrVal := ReplaceForSpace(
            ReplaceForSpace('acréscimo|' + dadosImp.sAcrescimo, 15) + '|' + dadosImp.sVlrLiquido, ColunasCondensado);

      if StrVal <> '' then
      begin
        StrVal := '</ae><c>' + StrVal + '</c>';
        Impressao.Add(StrVal);
      end;
    end;
  end;

