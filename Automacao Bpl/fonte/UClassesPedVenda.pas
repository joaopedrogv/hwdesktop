	pCombobox.Clear;

	buscas.Close;
  buscas.SQL.Text := ' select sigla, descricao from tipo_vendas ' +
  	' where tipo = ''REQ'' ' +
    ' and ativo = 1 ' +
    ' order by ordemexibicao ';
  buscas.Open;
  buscas.FetchAll;

  buscas.First;
  while not buscas.Eof do
  begin
    pCombobox.Items.Add(
    	trim(buscas.FieldByName('sigla').AsString) + ' | ' +
      trim(buscas.FieldByName('descricao').AsString));

    buscas.Next;
  end;

  for I := 0 to pCombobox.Items.Count - 1 do
  begin
  	if Copy(trim(pCombobox.Items[I]), 1, 1) = 'V' then
    begin
    	pCombobox.ItemIndex := I;
      Break;
