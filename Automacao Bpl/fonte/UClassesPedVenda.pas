    dataSet.FieldByName('sel').AsString := ''
  else
    dataSet.FieldByName('sel').AsString := 'S';
  dataSet.Post;
end;

function TPedVenda._marcarOrcComoNaoVenda: boolean;
begin
  result := false;
  if not vDadosIni.PesqPros('VND156', 'MARCAR/DESMARCAR ORC COMO NÃO GERADOR DE VENDA', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
  	dataSet.FieldByName('NPED').AsString, buscas, true) then
    	Exit;
  if dataset.FieldByName('ORCPARAVND').AsString = 'N' then
  begin
    if Application.MessageBox(Pchar('Orçamento ' + dataSet.FieldByName('NPED').AsString + ' já está marcado como não gerador de venda.' + chr(13) + 'Deseja retirar esta marcação?'), 'Confirmação', MB_YESNO + MB_ICONINFORMATION + MB_DEFBUTTON2) = IDYES then
    begin
      inherited edit;
      dataSet.FieldByName('ORCPARAVND').AsString := 'S';
      result := inherited post;
      if result then
        result := inherited Apply;
      if result then
        result := CommitaTransacao
      else RollBackTransacao;
      if result then
        vDadosIni.GravaAuditoria('VND156', 'DESMARCAR', dataSet.FieldByName('TIPO').AsString + ' - SUCESSO', 'PEDVENDA',
          dataSet.FieldByName('NPED').AsString, Buscas)
      else vDadosIni.GravaAuditoria('VND156', 'DESMARCAR', dataSet.FieldByName('TIPO').AsString + ' - FALHA', 'PEDVENDA',
          dataSet.FieldByName('NPED').AsString, Buscas);
      if result then
        Application.MessageBox(Pchar('Orçamento demarcado com sucesso.'), 'Informação', MB_OK)
      else
      	Application.MessageBox(Pchar('Falha ao desmarcar orçamento.'), 'Informação', MB_OK);
    end;
  end
  else
  begin
    inherited edit;
    dataSet.FieldByName('ORCPARAVND').AsString := 'N';
    result := inherited post;
    if result then
      result := inherited Apply;
    if result then
      result := CommitaTransacao
    else RollBackTransacao;
    if result then
      vDadosIni.GravaAuditoria('VND156', 'MARCAR', dataSet.FieldByName('TIPO').AsString + ' - SUCESSO', 'PEDVENDA',
        dataSet.FieldByName('NPED').AsString, Buscas)
    else
    	vDadosIni.GravaAuditoria('VND156', 'MARCAR', dataSet.FieldByName('TIPO').AsString + ' - FALHA', 'PEDVENDA',
        dataSet.FieldByName('NPED').AsString, Buscas);
    if result then
      Application.MessageBox(Pchar('Marcação feita com sucesso.'), 'Informação', MB_OK)
    else Application.MessageBox(Pchar('Falha ao fazer marcação.'), 'Informação', MB_OK);
  end;
end;

function TPedVenda._permitirAlteracoesComEnvioMobilePendente: Boolean;
begin
  Result := True;
  if dataSet.IsEmpty then
    Exit;

  if Trim(dataSet.FieldByName('tipo').AsString) <> 'REQ' then
    Exit;

  if dataSet.FieldByName('nped').AsInteger = 0 then
    Exit;

  if dataSet.FieldByName('idmobile').AsInteger = 0 then
    Exit;

  if Trim(dataSet.FieldByName('ENV_MOBILE').AsString) = 'S' then
    Exit;

  if (Trim(dataSet.FieldByName('status_ped').AsString) = 'FECHADA') OR
    (Trim(dataSet.FieldByName('status_ped').AsString) = 'CANCELADO') then
    Exit;

  Application.MessageBox('Envio do pedido não foi concluído pelo mobile', 'Atenção', 0 + 64);

  Result := False;

  if not vDadosIni.PesqPros('VND173', 'VALIDACAO', dataSet.FieldByName('TIPO').AsString + ' - MOBILE ' + dataSet.FieldByName('idmobile').AsString +
    ' ENVIO ' + dataSet.FieldByName('ENV_MOBILE').AsString, 'PEDVENDA',
    dataSet.FieldByName('NPED').AsString, buscas, true, True) then
    Exit;

  Result := True;
end;

function TPedVenda._permitirInclusaoEdicaoVND(pInclusao:boolean): boolean;
var
  vStatusSeparacao: string;
begin
  result:=false;
  if pInclusao then
  begin
    if getTipoVenda = 'REQ' then
    begin
      if not vDadosIni.PesqPros('VND001', 'INCLUIR', '', 'PEDVENDA', '', buscas, true) then
        Exit;
    end
    else if getTipoVenda = 'OS' then
    begin
      if not vDadosIni.PesqPros('VND002', 'INCLUIR', '', 'PEDVENDA', '', buscas, true) then
        Exit;
    end
    else if getTipoVenda = 'ORC' then
    begin
      if not vDadosIni.PesqPros('VND003', 'INCLUIR', '', 'PEDVENDA', '', buscas, true) then
        Exit;
    end;
  end
  else
  begin
    if getTipoVenda = 'REQ' then
    begin
	    if not vDadosIni.PesqPros('VND007', 'EDITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
      	dataSet.FieldByName('NPED').AsString, buscas, true) then
        	Exit;
  	end
    else if getTipoVenda = 'OS' then
	  begin
	    if not vDadosIni.PesqPros('VND008', 'EDITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
      	dataSet.FieldByName('NPED').AsString, buscas, true) then
        	Exit;
	  end
    else if getTipoVenda = 'ORC' then
	  begin
	    if not vDadosIni.PesqPros('VND009', 'EDITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
      	dataSet.FieldByName('NPED').AsString, buscas, true) then
        	Exit;
	  end;
  end;
  if (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') and (vDadosIni.vEmp.vUSAR_SEPARACAO_PED = 'S') and (not pInclusao) then
  begin
    vStatusSeparacao := getStatusPedidoESeparacao(dataSet.FieldByName('nped').AsInteger);
    if vDadosIni.getCampoPipe(vStatusSeparacao,1) = '' then
      if vDadosIni.getCampoPipe(vStatusSeparacao,2) <> '' then
      begin
        Result := False;
        Application.MessageBox(PChar('Pedido não pode ser alterado. Já esta em processo de separação com status: ' + vDadosIni.getCampoPipe(vStatusSeparacao,2)),
         'Atenção', 0 + 64);
        Exit;
      end;
	end;
  if (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') and (vDadosIni.vEmp.vUsarConferenciaCegaSaida = 'S2') and (not pInclusao) then
  begin
    vStatusSeparacao := getStatusPedidoESeparacao(dataSet.FieldByName('nped').AsInteger);
    if vDadosIni.getCampoPipe(vStatusSeparacao,1) = '' then
      if vDadosIni.getCampoPipe(vStatusSeparacao,2) = 'CONFERENCIA' then
      begin
        Result := False;
        Application.MessageBox(PChar('Pedido não pode ser alterado. Já esta em processo de conferência'),
         'Atenção', 0 + 64);
        Exit;
      end
      else if vDadosIni.getCampoPipe(vStatusSeparacao,2) = 'CONFERIDO' then
      begin
        Result := False;
        Application.MessageBox(PChar('Pedido não pode ser alterado. Processo de conferência já foi concluído'),
         'Atenção', 0 + 64);
        Exit;
      end;
  end;
  result:=true;
end;

function TPedVenda._recalcularPrecoProdutosPromocao: boolean;
var
	Valor_acrescitemTemp, Valor_descItemtemp: currency;
  Perc_acrescitemTemp, Perc_descItemtemp: currency;
  vExibirDesconto: string;
begin
  Result := False;

  if ((dataSet.FieldByName('NPEDMOB').AsInteger > 0) and
    (FCliOriginalVND = dataSet.FieldByName('COD_CLIENTE').AsInteger)) then
    exit;

  if vSing.vTipoVenda='REQ' then
    vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPV').AsString)
  else if vSing.vTipoVenda='OS' then
    vItProd.FUsarPrecoCustoTipoVND := vItProd._usarPrecoCustoTiposVendas(vSing.vTipoVenda, dataSet.FieldByName('TIPO_OS').AsString)
  else
  	vItProd.FUsarPrecoCustoTipoVND := (f_str('tipo') = 'ORC')
    																	and (vDadosIni.vLocacao.vHabilitarLoc)
                                      and (vDadosIni.vLocacao.TipoOrcCusto = f_str('tipo_orc'))
                                      and (vDadosIni.vLocacao.ClienteOrcCusto = f_str('cod_cliente'));

  Perc_acrescitemTemp := 0;
  Perc_descItemtemp := 0;
  try
    try
      vItProd.dataSet.DisableControls;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        vDadosIni.abreStatusProcessamento('', 'Recalculando preço de produtos para o cliente informado ' + IntToStr( Trunc( vItProd.dataSet.RecNo / vItProd.dataSet.RecordCount * 100  ) ) + '%');
        Application.ProcessMessages;
        if (trim(vItProd.dataSet.FieldByName('STATUS').AsString) = 'CANCELADO') then
        begin
          vItProd.dataSet.Next;
          continue;
        end;
        vItProd.dataSet.Edit;
        Valor_acrescitemTemp := vItProd.dataSet.FieldByName('acresc_item').AsCurrency;
        Valor_descItemtemp := vItProd.dataSet.FieldByName('desc_item').AsCurrency;
        Perc_acrescitemTemp := vItProd.dataSet.FieldByName('acresc_item').AsCurrency / vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;
        Perc_descItemtemp := vItProd.dataSet.FieldByName('desc_item').AsCurrency / vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency;
        vItProd.vProduto.buscaProduto(
          vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
          vItProd.dataSet.FieldByName('cod_prod').AsString);

        if vItProd.dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').AsString = 'S' then
        begin
        	vItProd.dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').Value := Null;
          vItProd.dataSet.FieldByName('PERC_COMISSAO_VEND3').AsCurrency := 0;
          vItProd.dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := 0;
          vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;
          vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
          vItProd.dataSet.FieldByName('ACRESC_ITEM').AsCurrency := 0;
          Perc_acrescitemTemp := 0;
        end;

        vItProd.dataSet.FieldByName('PRECOPORQTDE').AsString := 'N';
//        if (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q')
//        	and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
//        begin
//          vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;
//          vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
//        end;

        if (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
        begin
           if vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '1' then
           begin
             vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
		           vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
           end
           else if vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '2' then
           begin
             vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_30_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_30_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
		           vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
           end
           else if vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '3' then
           begin
             vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_60_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_60_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
			         vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
           end
           else if vCondPag.dataSet.FieldByName('SEQPRECO').AsString = '4' then
           begin
             vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_90_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_90_PROD').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
		           vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
           end;

           if (dataSet.FieldByName('TIPV').AsString = 'A') then
           begin
             vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_PUBLICO').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
               vItProd.vProduto.dataSet.FieldByName('PREC_PUBLICO').AsCurrency;
             vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
		           vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
           end;

//          if vSing.vVendaRapida then
          if vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat = 0 then
          begin
            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vItProd.vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;
            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency := vItProd.vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;
            vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
	          	vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
          end;
        end;

        if vItProd.FUsarPrecoCustoTipoVND then
        begin
          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency;
          vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency := vItProd.vProduto.dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency;
          vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
	          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
        end;

        vItProd.vValorItem := vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat;//vItProd.vProduto.dataSet.FieldByName('PREC_TAB_PROD').AsCurrency;

        vItProd._setaVariaveisPromocao(
        	vCliente.endAdic.cod_localidade_dest,
          dataSet.FieldByName('cod_cliente').AsInteger,
          vCliente.dataSet.FieldByName('cod_tab_preco').AsInteger,
          dataSet.FieldByName('cod_cond_pag').AsInteger,
          vCliente.endAdic.cod_cidade_dest,
          dataSet.FieldByName('TIPV').AsString);

        vItProd.dataSet.FieldByName('TABPRATICADA').AsString := 'N';
        vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency :=
          IfThen(vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
            0, vItProd.vProduto.dataSet.FieldByName('MAX_DESC_ITEM').AsCurrency);
        vItProd.dataSet.FieldByName('PERMITIR_DESCONTO').AsString :=
        	IfThen(vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
          	'N', 'S');
        vItProd.dataSet.FieldByName('USAR_DEBCRED').AsString :=
        	IfThen(vItProd.vProduto.dataSet.FieldByName('USAR_DEBCRED').AsString = 'N',
          	'N', 'S');

        if (vItProd._setaPrecoPromocaoAnt > 0) then
        begin
          vItProd.dataSet.FieldByName('TABPRATICADA').AsString := 'P';
          vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency :=
          	IfThen(vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
              0, vItProd.vDescMaxPromocao);
          vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
	          vItProd.vPrecoPromocaoProd, vDadosIni.vEmp.vCasasDecimais);

					if (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P')
          	and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S')
            and (not vDadosIni.vPedVnd.AcrescCondPagComissaoVend)
            and (vDadosIni.StrToFloatFormat(vItProd.vValorItem, 4) >= vDadosIni.StrToFloatFormat(vItProd.vPrecoPromocaoProd, 4)) then
          begin
          	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency :=
            	Abs((vItProd.vValorItem - vItProd.vPrecoPromocaoProd) * vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat);

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';

            vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
            	vDadosIni.IfThen(vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S', vItProd.vValorItem, vItProd.vPrecoPromocaoProd);

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
            	vDadosIni.IfThen(vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S', vItProd.vValorItem, vItProd.vPrecoPromocaoProd);
          end
          else
          begin
          	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
            	vItProd.vPrecoPromocaoProd;

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
            	vItProd.vPrecoPromocaoProd;
          end;

          vDadosIni.abreStatusProcessamento('', 'Aguarde... produto: ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString));
        end
        else if vItProd._setaPrecoPromocao(
        	vCliente.endAdic.cod_localidade_dest,
          dataSet.FieldByName('COD_CLIENTE').AsInteger,
          vCliente.dataSet.FieldByName('COD_TAB_PRECO').AsInteger,
          vCliente.endAdic.cod_cidade_dest,
          dataSet.FieldByName('TIPV').AsString) > 0 then
        begin
          vItProd.dataSet.FieldByName('TABPRATICADA').AsString := vItProd.vTabPraticada;
          vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency :=
          	IfThen(vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
              0, vItProd.vDescMaxPromocao);
          vItProd.dataSet.FieldByName('USAR_DEBCRED').AsString :=
            IfThen(vItProd.dataSet.FieldByName('USAR_DEBCRED').AsString = 'N',
            	'N', IfThen(not vItProd.vUsarDebCredProdPromDif, 'N', 'S'));
          vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
          	vItProd.vPrecoPromocaoProd, vDadosIni.vEmp.vCasasDecimais);

          vExibirDesconto := 'N';
          if (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P') then
          	vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao
          else if (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'T') then
          	vExibirDesconto := vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado;

          if (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T']))
          	and (vExibirDesconto = 'S')
            and (not vDadosIni.vPedVnd.AcrescCondPagComissaoVend)
            and (vDadosIni.StrToFloatFormat(vItProd.vValorItem, 4) >= vDadosIni.StrToFloatFormat(vItProd.vPrecoPromocaoProd, 4)) then
          begin
          	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency :=
            	Abs((vItProd.vValorItem - vItProd.vPrecoPromocaoProd) * vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat);

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';

            vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';

          	vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
              vDadosIni.IfThen(vExibirDesconto = 'S', vItProd.vValorItem, vItProd.vPrecoPromocaoProd);

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
              vDadosIni.IfThen(vExibirDesconto = 'S', vItProd.vValorItem, vItProd.vPrecoPromocaoProd);
          end
          else
          begin
            vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
            	vItProd.vPrecoPromocaoProd;

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
            	vItProd.vPrecoPromocaoProd;
          end;
          vDadosIni.abreStatusProcessamento('', 'Aguarde... produto: ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString));
        end;

        if vItProd._setaPrecoProdutosPorQtde(dataSet.FieldByName('TIPV').AsString) > 0 then
        begin
          vItProd.dataSet.FieldByName('PRECOPORQTDE').AsString := 'S';
          vItProd.dataSet.FieldByName('TABPRATICADA').AsString := 'Q';
          vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency :=
          	IfThen(vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N',
              0, vItProd.vDescMaxPorQtde);
          vItProd.dataSet.FieldByName('USAR_DEBCRED').AsString :=
          	IfThen(vItProd.dataSet.FieldByName('USAR_DEBCRED').AsString = 'N',
            	'N', IfThen(not vItProd.vUsarDebCredProdPorQtde, 'N', 'S'));
          vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
	          vItProd.vPrecoProdPorQtde, vDadosIni.vEmp.vCasasDecimais);

          if (vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q')
          	and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S')
          	and (not vDadosIni.vPedVnd.AcrescCondPagComissaoVend)
            and (vDadosIni.StrToFloatFormat(vItProd.vValorItem, 4) >= vDadosIni.StrToFloatFormat(vItProd.vPrecoProdPorQtde, 4)) then
          begin
          	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency :=
            	Abs((vItProd.vValorItem - vItProd.vPrecoProdPorQtde) * vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat);

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('TP_DESCACRES').AsString := 'DESCONTO';

            vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
              vDadosIni.IfThen(vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S', vItProd.vValorItem, vItProd.vPrecoProdPorQtde);

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
              vDadosIni.IfThen(vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S', vItProd.vValorItem, vItProd.vPrecoProdPorQtde);
          end
          else
          begin
            vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;

            vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency   :=
            	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency :=
            	vItProd.vPrecoProdPorQtde;

            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency :=
            	vItProd.vPrecoProdPorQtde;
          end
        end;

				if ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'N') and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency <= 0) and (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString = 'N'))
          or ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'P') and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency <= 0) and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao <> 'S'))
          or ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'T') and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency <= 0) and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado <> 'S'))
          or ((vItProd.dataSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsCurrency <= 0) and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde <> 'S')) then
        begin
          if vItProd.dataSet.FieldByName('TP_DESCACRES').AsString = 'DESCONTO' then
          	vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;
          vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
        end;

        if vItProd._setarAcrescCondPagComissaoVend(
        	dataSet.FieldByName('TIPO').AsString,
        	dataSet.FieldByName('TIPV').AsString,
        	dataSet.FieldByName('TIPO_OS').AsString,
          dataSet.FieldByName('TIPO_ORC').AsString,
        	dataSet.FieldByName('COD_COND_PAG').AsInteger,
          dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat,
          vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat,
          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat,
          0) then
        begin
        	vItProd.dataSet.FieldByName('CALC_COMISSAO_CONDPAG_VEND').AsString := 'S';

          if vItProd.vPercComissaoVnd3 > 0 then
            vItProd.dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := vItProd.vPercComissaoVnd3
          else
            vItProd.dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat := 0;

          if vItProd.vValorAcrescCondPag > 0 then
            vItProd.dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := vItProd.vValorAcrescCondPag
          else
            vItProd.dataSet.FieldByName('PERC_COMISSAO_CONDPAG').AsCurrency := 0;

        	if vItProd.vValorAcrescimo > 0 then
            vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := vItProd.vValorAcrescimo
          else
            vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency := 0;

          vItProd.dataSet.FieldByName('DESC_ITEM').AsCurrency := 0;
          vItProd.dataSet.FieldByName('ACRESC_ITEM').AsCurrency := vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;

          if vItProd.vValorAcrescimo > 0 then
          	Perc_acrescitemTemp := (vItProd.vValorAcrescimo / 100)
          else
          	Perc_acrescitemTemp := 0;

          vItProd.dataSet.FieldByName('TP_DESCACRES').AsString := 'ACRÉSCIMO';

          vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString := 'VALOR';
        end;

        vItProd.vNat_DescAcresc      := vItProd.dataSet.FieldByName('TP_DESCACRES').AsString;
        vItProd.vTp_DescAcresc       := vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString;
      	vItProd.vValor_DescAcresc    := vItProd.dataSet.FieldByName('VALOR_DESCACRES').AsCurrency;
    		vItProd.vPerc_Comissao_Vend3 := vItProd.dataSet.FieldByName('PERC_COMISSAO_VEND3').AsFloat;

        vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
        vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency := vDadosIni.StrToFloatFormat(
          vItProd.dataSet.FieldByName('VLUN_PED_NF').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
//        vItProd.dataSet.FieldByName('VLUN_ORIG').AsCurrency := vDadosIni.StrToFloatFormat(
//          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);
        if vItProd.dataSet.FieldByName('VLO_UNITARIO').AsCurrency = 0 then
          vItProd.dataSet.FieldByName('VLO_UNITARIO').AsCurrency := vDadosIni.StrToFloatFormat(
            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsCurrency, vDadosIni.vEmp.vCasasDecimais);

        vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency := vDadosIni.StrToFloatFormat(
          (vItProd.dataSet.FieldByName('QUANT_PED_ITEM').AsFloat *
          vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat), 2);

        if (trim(vItProd.dataSet.FieldByName('UNIDADE_CONV').AsString) = '')
          or (UpperCase(trim(vItProd.dataSet.FieldByName('UNIDADE').AsString)) = UpperCase(trim(vItProd.dataSet.FieldByName('UNIDADE_CONV').AsString))) then
        begin
          vItProd.dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
            vItProd.dataSet.FieldByName('VLUN_PED_NF').AsFloat, - StrToInt(vSing.vCasasDecimais));

          vItProd.dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
            vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat, - StrToInt(vSing.vCasasDecimais));
        end
        else
        begin
          if vItProd.dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
          begin
          	vItProd.dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
              vItProd.dataSet.FieldByName('VLUN_PED_NF').AsFloat /
              	vItProd.dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat /
              	vItProd.dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end
          else if vItProd.dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
      		begin
						vItProd.dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat := RoundTo(
              vItProd.dataSet.FieldByName('VLUN_PED_NF').AsFloat *
              	vItProd.dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

            vItProd.dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat := RoundTo(
              vItProd.dataSet.FieldByName('VLUN_PED_ITEM').AsFloat *
                vItProd.dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
          end;
        end;

        if (Trim(vItProd.dataSet.FieldByName('TABPRATICADA').AsString) = 'N')
	        and (Trim(vItProd.dataSet.FieldByName('NAT_DESCACRES').AsString) = 'VALOR') then
        begin
          vItProd.dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(Valor_acrescitemTemp,2);
          vItProd.dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(Valor_descItemtemp,2);
        end
        else
        begin
          vItProd.dataSet.FieldByName('acresc_item').AsCurrency := vDadosIni.StrToFloatFormat(Perc_acrescitemTemp * vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency,2);
          if not (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
            vItProd.dataSet.FieldByName('desc_item').AsCurrency := vDadosIni.StrToFloatFormat(Perc_descItemtemp * vItProd.dataSet.FieldByName('VLTOT_PED_ITEM').AsCurrency,2);
          if (vDadosIni.strIn(vItProd.dataSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) and (vItProd.dataSet.FieldByName('MAX_DESC_TAB').AsFloat <= 0) then
            vItProd.dataSet.FieldByName('rateio_desc').AsCurrency := vItProd.dataSet.FieldByName('desc_item').AsCurrency;
        end;
        vItProd.dataSet.Post;

        vItProd.dataSet.Next;
      end;
      
      vDadosIni.fechaStatusProcessamento;
      calculaDescontoAcrescimo;
      Result := true;
      
    except
      on e: exception do
      begin
        Result := False;
        Application.MessageBox(pchar('Erro ao recalcular preço. Erro: ' + e.Message), 'Atenção', 0 + 64);
        registraErro('function _recalcularPrecoProdutosPromocao Erro: ' + e.Message)
      end;
    end;
  finally
    vItProd.dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVenda._recalcularPrecos(nped: integer): boolean;
begin
  vDadosIni.vInibeMensPesqPros := 'S';
  if not vDadosIni.PesqPros('VND193', 'PERMITIR', getTipoVenda + ' - RECALCULAR', 'PEDVENDA',
  	IntToStr(nped), buscas, true) then
    	exit;

  abrePedVenda(nped);
  Edit;

  vItProd._setaVariaveisPromocao(
  	vCliente.endAdic.cod_localidade_dest,
    dataSet.FieldByName('cod_cliente').AsInteger,
    vCliente.dataSet.FieldByName('cod_tab_preco').AsInteger,
    dataSet.FieldByName('cod_cond_pag').AsInteger,
    vCliente.endAdic.cod_cidade_dest,
    dataSet.FieldByName('TIPV').AsString);

  recalcularPrecoItensPelaCondicaoPagamento;
  dataSet.Post;
  dataSet.ApplyUpdates(-1);
  if vItServ.dataSet.Active then  
    vItServ.dataSet.ApplyUpdates(-1);
  if vItProd.dataSet.Active then
    vItProd.dataSet.ApplyUpdates(-1);
  if vItProdTerc.dataSet.Active then
    vItProdTerc.dataSet.ApplyUpdates(-1);
  if vItServTerc.dataSet.Active then
    vItServTerc.dataSet.ApplyUpdates(-1);
  CommitaTransacao;
end;

function TPedVenda._retornaComissaoVend: Double;
var
	ConfigImp: TConfig_sistema_class;
	vComissaoVend: Double;
begin
	result := 0;

  if not vDadosIni.vPedVnd.AcrescCondPagComissaoVend then
    exit;

	try
  	try
      ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscas, vDadosIni.cod_empresa);

      try
        vComissaoVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'PercComissaoVendedor')));
      except
        vComissaoVend := 0;
      end;

      if vComissaoVend > 0 then
        Result := vComissaoVend;
    finally
      if Assigned(ConfigImp) then
        FreeAndNil(ConfigImp);
    end;
  except
    on e: exception do
    begin
      Result := 0;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPedVenda._SelecionarCabecalhoDAVParaMesclar: boolean;
var
 vNped:integer;
 vTipo:string;
 vJaMarcado:boolean;
begin
  result:=false;
  if dtSetOrcTemp.IsEmpty then
    exit;
  vNped:=dtSetOrcTemp.FieldByName('NPED').AsInteger;
  vTipo:=trim(dtSetOrcTemp.FieldByName('TIPO').AsString);
  vJaMarcado :=false;
  if trim(dtSetOrcTemp.FieldByName('STATUS_PED').AsString) <> 'CANCELADO' then
  begin
    if dtSetOrcTemp.FieldByName('SEL').AsString = 'S' then
    begin
      dtSetOrcTemp.Edit;
      dtSetOrcTemp.FieldByName('SEL').AsVariant := null;
    end  
    else begin
      dtSetOrcTemp.first;
      while not dtSetOrcTemp.eof do
      begin
        if  not((vTipo=trim(dtSetOrcTemp.FieldByName('TIPO').AsString)) and (vNped=dtSetOrcTemp.FieldByName('NPED').AsInteger))
            and (dtSetOrcTemp.FieldByName('SEL').AsString = 'S') then
        begin
          Application.MessageBox('Selecione um único cabeçalho para mesclar.', 'Atenção', MB_ICONINFORMATION + MB_OK);
          vJaMarcado:=true;
          break;
        end;
        dtSetOrcTemp.next;
      end;
      if not vJaMarcado then
      begin
        if dtSetOrcTemp.Locate('NPED;TIPO;COD_EMPRESA', VarArrayOf([vNped, vTipo, strtoint(vDadosIni.codEmpresa)]), [loCaseInsensitive]) then
        begin
          dtSetOrcTemp.Edit;
          dtSetOrcTemp.FieldByName('SEL').AsString := 'S';
        end;
      end;	  
    end;  
    if dtSetOrcTemp.state = dsEdit then
      dtSetOrcTemp.Post;
    result:=true;
  end;
end;

