function TPedVenda.verificarContasPagar(var pContas: RContas; pAlter: boolean = false; pCOnfirmarVenda: boolean = false): boolean;
var
  vTotServTerc: Double;
  vTotProdTerc: Double;
  vtemp: string;
begin
  Result := false;
  vTotServTerc := 0;
  vTotProdTerc := 0;

  vItServTerc.fTempDespesas.EmptyDataSet;
  vItProdTerc.fTempDespesas.EmptyDataSet;

  if TFrmCadPedVenda(FrmCadPed) = nil then
  begin
    Result := true;
    exit;
  end;
  if trim(dataSet.FieldByName('TIPO').AsString) <> 'OS' then
  begin
    Result := true;
    exit;
  end;

  if pCOnfirmarVenda then
    if not vDadosIni.vPedVnd.gerarContasApagar then
    begin
      Result := true;
      exit;
    end;

  if (vItServTerc.IsEmpty) and (vItProdTerc.IsEmpty) then
  begin
    Result := true;
    exit;
  end;

  if (trim(vDadosIni.vPedVnd.gerarContasApagarNumConta) = '') then
  begin
    Application.MessageBox(Pchar('Código do plano de contas das despesas dos produtos/serviços de terceiros não foi definido nas configurações'), 'Atenção', MB_ICONERROR + MB_OK);
   exit;
  end;

  try
    StrToFloat(vDadosIni.vPedVnd.gerarContasApagarNumConta)
  except
    Application.MessageBox(Pchar('Código do plano de contas para produtos/serviços de terceiros definido nas configurações inválido'), 'Atenção', MB_ICONERROR + MB_OK);
   exit;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select p.n_conta_plc, p.desc_plc, p.tipo_plc, c.desc_gr, ' +
    ' c.tipo_gr, s.desc_sub_ct, p.tipo_ctp, p.gerar_contrapartida from p_contas p  ' +
    ' inner join grupos_ct c on p.grup_ct = c.grup_ct ' +
    ' left join sub_grup_ct s on p.cod_sub_ct = s.cod_sub_ct ' +
    ' where p.n_conta_plc = :n_conta_plc ';
  buscas.ParamByName('N_CONTA_PLC').AsFloat := StrToFloat(vDadosIni.vPedVnd.gerarContasApagarNumConta);
  buscas.Open;

  if buscas.IsEmpty then
  begin
    Application.MessageBox(Pchar('Código do plano de contas para produtos/serviços de terceiros definido nas configurações não encontrado no cadastro'), 'Atenção', MB_ICONERROR + MB_OK);
   exit;
  end
  else if buscas.FieldByName('TIPO_PLC').AsString = 'E' then //Conta de entrada
  begin
    Application.MessageBox(Pchar('Código do plano de contas para produtos/serviços de terceiros definido nas configurações pertence a uma conta de natureza de entrada, favor verificar'), 'Atenção', MB_ICONERROR + MB_OK);
   exit;
  end
  else if (buscas.FieldByName('TIPO_GR').AsString <> 'S') and //Natureza da conta de saída
    (buscas.FieldByName('TIPO_CTP').AsString <> 'F') and // Conta do tipo fornecedor
    (buscas.FieldByName('TIPO_CTP').AsString <> 'O') then // Conta do tipo outras
  begin
      Application.MessageBox(Pchar('Conta "' + vDadosIni.vPedVnd.gerarContasApagarNumConta +
      ' - ' + trim(buscas.FieldByName('desc_plc').AsString) + '" não esta configurada!' + #13 +
      'Motivo(s): ' + #13 +
      '* Natureza do grupo da conta não esta definida como "SAÍDA"' + #13 +
      '* Tipo da conta a pagar não é de origem "FORNECEDOR"/"OUTRAS SAÍDAS"!' + #13 +
      'Favor verificar antes de continuar!'), 'Atenção', MB_ICONERROR + MB_OK);
    exit;
  end;

  if not apagarContasPagar(dataSet.FieldByName('NPED').AsInteger, false) then
    exit;

  buscas.Close;
  buscas.SQL.Text := ' SELECT * FROM CONTAS_A_PAGAR ' +
    ' WHERE NPED = :NPED AND TIPO_NPED = :TIPO_NPED AND CODIGO_EMP = :CODIGO_EMP ';
  buscas.ParamByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
  buscas.ParamByName('TIPO_NPED').AsString := 'OS';
  buscas.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.Open;

  if not buscas.IsEmpty then
  begin
    Result := true;
    exit;
  end;

  try
    vItServTerc.dataSet.First;
    while not vItServTerc.dataSet.Eof do
    begin
      if (vItServTerc.dataSet.FieldByName('vlcusto').AsFloat *
         	vItServTerc.dataSet.FieldByName('vlcusto').AsFloat) > 0 then
      begin
        vItServTerc.fTempDespesas.Filter := 'nome_fornecedor = ' + QuotedStr(vItServTerc.dataSet.FieldByName('nome_fornecedor').AsString);
        vItServTerc.fTempDespesas.Filtered := true;

        if vItServTerc.fTempDespesas.IsEmpty then
        begin
           vItServTerc.fTempDespesas.Insert;
           vItServTerc.fTempDespesas.FieldByName('cod_fornecedor').AsInteger :=
              vItServTerc.dataSet.FieldByName('cod_fornecedor').AsInteger;
           vItServTerc.fTempDespesas.FieldByName('nome_fornecedor').AsString :=
              vItServTerc.dataSet.FieldByName('nome_fornecedor').AsString;
           vItServTerc.fTempDespesas.FieldByName('vlcusto').AsFloat :=
              vItServTerc.dataSet.FieldByName('vlcusto').AsFloat;
           vItServTerc.fTempDespesas.Post;
        end
        else
        begin
           vItServTerc.fTempDespesas.Edit;
           vItServTerc.fTempDespesas.FieldByName('vlcusto').AsFloat :=
              vItServTerc.fTempDespesas.FieldByName('vlcusto').AsFloat +
              vItServTerc.dataSet.FieldByName('vlcusto').AsFloat;
           vItServTerc.fTempDespesas.Post;
        end;

        vTotServTerc := vTotServTerc + vItServTerc.dataSet.FieldByName('VLCUSTO').AsFloat;
      end;

      vItServTerc.dataSet.Next;
    end;
  finally
    vItServTerc.fTempDespesas.Filtered := false;
  end;

  try
    vItProdTerc.dataSet.First;
    while not vItProdTerc.dataSet.Eof do
    begin
      if vItProdTerc.dataSet.FieldByName('vlcusto').AsFloat > 0 then
      begin
        vItProdTerc.fTempDespesas.Filter := 'nome_fornecedor = ' + QuotedStr(vItProdTerc.dataSet.FieldByName('nome_fornecedor').AsString);
        vItProdTerc.fTempDespesas.Filtered := true;

        if vItProdTerc.fTempDespesas.IsEmpty then
        begin
           vItProdTerc.fTempDespesas.Insert;
           vItProdTerc.fTempDespesas.FieldByName('cod_fornecedor').AsInteger :=
              vItProdTerc.dataSet.FieldByName('cod_fornecedor').AsInteger;
           vItProdTerc.fTempDespesas.FieldByName('nome_fornecedor').AsString :=
              vItProdTerc.dataSet.FieldByName('nome_fornecedor').AsString;
           vItProdTerc.fTempDespesas.FieldByName('vlcusto_tot').AsFloat :=
              vItProdTerc.dataSet.FieldByName('vlcusto_tot').AsFloat;
           vItProdTerc.fTempDespesas.Post;
        end
        else
        begin
           vItProdTerc.fTempDespesas.Edit;
           vItProdTerc.fTempDespesas.FieldByName('vlcusto_tot').AsFloat :=
              vItProdTerc.fTempDespesas.FieldByName('vlcusto_tot').AsFloat +
              vItProdTerc.dataSet.FieldByName('vlcusto_tot').AsFloat;
           vItProdTerc.fTempDespesas.Post;
        end;

        vTotProdTerc := vTotProdTerc + vItProdTerc.dataSet.FieldByName('VLCUSTO_TOT').AsFloat;
      end;

      vItProdTerc.dataSet.Next;
    end;
  finally
    vItProdTerc.fTempDespesas.Filtered := false;
  end;

  if (vTotServTerc > 0) or (vTotProdTerc > 0) then
  	vtemp := 'produtos/serviços'
  else if (vTotServTerc > 0) then
    vtemp := 'serviços'
  else
    vtemp := 'produtos';

  if (vTotServTerc > 0) or (vTotProdTerc > 0) then
	  Application.MessageBox(Pchar('Houveram ' + vtemp +
 	    ' de terceiro realizados com o valor do custo informado nesta Ordem de Serviço,' +
 	    ' favor realizar o lançamento das contas a pagar'), 'Atenção', MB_ICONINFORMATION + MB_OK);

  if vTotServTerc > 0 then
  begin
    if vDadosIni.vPedVnd.gerarContasApagarTotServ then
    begin
      vItServTerc.fTempDespesas.First;
      while not vItServTerc.fTempDespesas.Eof do
      begin
        if not abreFormParcelamentoContas('S', pContas, 'T',
        	vItServTerc.fTempDespesas.FieldByName('VLCUSTO').AsFloat,
          vItServTerc.fTempDespesas.FieldByName('COD_FORNECEDOR').AsInteger,
          vItServTerc.fTempDespesas.FieldByName('NOME_FORNECEDOR').AsString, pAlter) then
           exit;

        vItServTerc.fTempDespesas.Next;
      end;
    end
    else
    begin
      vItServTerc.dataSet.First;
      while not vItServTerc.dataSet.Eof do
      begin
        if not vDadosIni.vPedVnd.gerarContasApagarTotServ then
          if not abreFormParcelamentoContas('S', pContas, '',
          	vItServTerc.dataSet.FieldByName('VLCUSTO').AsFloat,
            vItServTerc.dataSet.FieldByName('COD_FORNECEDOR').AsInteger,
            vItServTerc.dataSet.FieldByName('NOME_FORNECEDOR').AsString, pAlter) then
             exit;

        vItServTerc.dataSet.Next;
      end;
    end;
  end;

      
  if vTotProdTerc > 0 then
  begin
    if vDadosIni.vPedVnd.gerarContasApagarTotServ then
    begin
      vItProdTerc.fTempDespesas.First;
      while not vItProdTerc.fTempDespesas.Eof do
      begin
        if not abreFormParcelamentoContas('P', pContas, 'T',
          vItProdTerc.fTempDespesas.FieldByName('VLCUSTO_TOT').AsFloat,
          vItProdTerc.fTempDespesas.FieldByName('COD_FORNECEDOR').AsInteger,
          vItProdTerc.fTempDespesas.FieldByName('NOME_FORNECEDOR').AsString, pAlter) then
          exit;
        vItProdTerc.fTempDespesas.Next;
      end;
    end
    else
    begin
      vItProdTerc.dataSet.First;
      while not vItProdTerc.dataSet.Eof do
      begin
        if not vDadosIni.vPedVnd.gerarContasApagarTotServ then
          if not abreFormParcelamentoContas('P', pContas, '',
          	vItProdTerc.dataSet.FieldByName('VLCUSTO_TOT').AsFloat,
            vItProdTerc.dataSet.FieldByName('COD_FORNECEDOR').AsInteger,
            vItProdTerc.dataSet.FieldByName('NOME_FORNECEDOR').AsString, pAlter) then
            exit;

        vItProdTerc.dataSet.Next;
      end;
    end;
  end;
  
  Result := true;
end;


function TPedVenda.verificarDescontos: boolean;
var
  vpercdesc: Double;
  vtot: Currency;
  vValorDescontoPercServ, vValorDescontoPercProd: Currency;
  ADescSub, ADescCalc, ADescMax: Double;
begin
  Result := true;
  try
    vpercdesc:=0;
    if (vCondPag.dataSet.FieldByName('MAX_DESC').AsFloat > 0) then
      vpercdesc := vCondPag.dataSet.FieldByName('MAX_DESC').AsFloat
    else
    begin
      _setaVariaveisTipoVendas;
      vpercdesc:= vPercDescMax;
      buscas.Close;
    end;
//    else if vDadosIni.vEmp.vTotDescProdVarejo > 0 then //(vEmp.dataSet.FieldByName('TOTDESC_EMP').AsFloat > 0) then
//      vpercdesc := vDadosIni.vEmp.vTotDescProdVarejo; //vEmp.dataSet.FieldByName('TOTDESC_EMP').AsFloat;
    if (vCliente.dataSet.FieldByName('CAMP_PR_VENDA').AsString <> '') then
    begin
      if (vCliente.dataSet.FieldByName('PERC_DESC').AsFloat > 0) then
        vpercdesc := vCliente.dataSet.FieldByName('PERC_DESC').AsFloat;
    end;
    if vpercdesc <= 0 then
      Exit;
    vtot := getValorVendaBruta;
    if vtot = 0 then
      exit;

    vValorDescontoPercServ := 0;
    vValorDescontoPercServ := (dataSet.FieldByName('desc_p_serv').AsCurrency * vValorTotalServ) / 100;
    vValorDescontoPercProd := 0;
    vValorDescontoPercProd := (dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc) / 100;
    if ((vValorTotalProd + vValorTotalServ) > 0) then
    begin
      if (vValorProdPermDesc = 0) and (vValorTotalProd > 0) and (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
      begin
        dataSet.FieldByName('desc_p_prod').AsFloat := 0;
        if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
          raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit24')
        else
          raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit29');
      end;
      if (vValorProdPermDesc = 0) and (vValorTotalProd > 0) and (getDescontoSemValorNF > 0) and (vValorTotalServ = 0) then
      begin
        dataSet.FieldByName('desconto').AsCurrency       := ffloat('nf_dc_vicmdeson');
        dataSet.FieldByName('nf_dc_desconto').AsCurrency := 0;
        if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
          raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit21')
        else
          raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit31');
      end;
      if (vValorTotalServ > 0) then
      begin
        if (((dataSet.FieldByName('desc_p_serv').AsCurrency * vValorTotalServ) / 100) >= vValorTotalServ) then
          raiseExceptionCreate('Desconto percentual nos serviços maior que o permitido', 'dbedit30');
      end
      else if dataSet.FieldByName('desc_p_serv').AsCurrency > 0 then
        dataSet.FieldByName('desc_p_serv').AsCurrency := 0;
      if ((vValorProdPermDesc + vValorTotalServ) = 0) and ((vSing.vValorDescontoIt > 0) or (getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_prod').AsFloat > 0)) then
      begin
        if (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
        begin
          if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
            raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit24')
          else
            raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit29');
        end
        else if getDescontoSemValorNF > 0 then
          if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
            raiseExceptionCreate('Desconto nos produtos maior que o permitido', 'dbedit21')
          else
            raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit31');
      end
      else if ((vValorProdPermDesc + vValorTotalServ) > 0) and ((vSing.vValorDescontoIt > 0) or (getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_prod').AsFloat > 0)) then
      begin
        if ((((getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
          vValorProdPermDesc) + vValorDescontoPercProd + vSing.vValorDescontoIt) > 0) and ((((getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
          vValorProdPermDesc) + vValorDescontoPercProd + vSing.vValorDescontoIt) >= vValorProdPermDesc) then
          if (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
          begin
            if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit24')
            else
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit29');
          end
          else if getDescontoSemValorNF > 0 then
            if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
              raiseExceptionCreate('Desconto nos produtos maior que o permitido', 'dbedit21')
            else
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit31');
      end;
      if ((vValorProdPermDesc + vValorTotalServ) > 0) and ((getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_serv').AsCurrency > 0)) then
        if ((((getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
          vValorTotalServ) + vValorDescontoPercServ) >= vValorTotalServ) and (vValorTotalServ > 0) then
          raiseExceptionCreate(Pchar('Desconto nos serviços maior que o permitido.'), 'dbedit31');
    end
    else
    begin
      dataSet.FieldByName('desconto').AsCurrency := ffloat('nf_dc_vicmdeson');
      dataSet.FieldByName('desc_p_prod').AsFloat := 0;
      dataSet.FieldByName('desc_p_serv').AsCurrency := 0;
      dataSet.FieldByName('nf_dc_desconto').AsCurrency := 0;
    end;

    if not verificarDescontosNoItem then
    begin
      result := false;
      exit;
    end;               

    //ADescSub  := RoundTo(vtot - dataSet.FieldByName('valor_total').AsFloat, -2);
    //caso o capo nf_ac_calctrib igual a S ou N entao os campos de frete, seguro, etc ficam ativados, sendo assim o acréscimo do total nao deve a ser considerado no calculo do desconto
    ADescMax  := RoundTo(vtot - (ffloat('valor_total') + IfThen(not str_empty('nf_ac_calctrib'), ffloat('nf_dc_vicmdeson') - ffloat('acrescimo'))), -2);
    ADescSub  := RoundTo(ADescMax - vSing.vValorInicialDesc, -2);
    ADescCalc := RoundTo((vpercdesc + vDadosIni.vEmp.vVndToleranciaMarkUp) * vtot / 100, -2);
    if (ADescSub > 0) and (ADescSub > ADescCalc) then
//    if (((vtot - dataSet.FieldByName('valor_total').AsCurrency) * 100) / vtot) > vpercdesc+vDadosIni.vEmp.vVndToleranciaMarkUp then
    begin
      if vSing.vValorInicialDesc > 0 then
      	Application.MessageBox(pchar('Desconto maior que o permitido. ' + #13 + #13 +
        	'Total Bruto: ' + format('%m', [vtot]) + #13 +
          'Total Liquido: ' + format('%m', [dataSet.FieldByName('valor_total').AsCurrency]) + #13 +
          'Desconto total (' + format('%m', [ADescMax]) + ') - ' +
          'Desconto inicial (' + format('%m', [vSing.vValorInicialDesc]) + ') = ' +
          'Desconto adicional (' + format('%m', [ADescMax - vSing.vValorInicialDesc]) + ')'  + #13 +
          'Máximo Permitido: ' + format('%n', [vpercdesc]) + '% - ' +
          format('%m', [(vtot) * (vpercdesc / 100)])), 'Atenção', MB_OK + MB_ICONEXCLAMATION)
      else
        Application.MessageBox(pchar('Desconto maior que o permitido. ' + #13 + #13 +
        	'Total Bruto: ' + format('%m', [vtot]) + #13 +
          'Total Liquido: ' + format('%m', [dataSet.FieldByName('valor_total').AsCurrency]) + #13 +
          'Desconto Total: ' + format('%m', [ADescMax]) + #13 +
          'Máximo Permitido: ' + format('%n', [vpercdesc]) + '% - '  +
          format('%m', [(vtot) * (vpercdesc / 100)])), 'Atenção', MB_OK + MB_ICONEXCLAMATION);

      vDadosIni.vInibeMensPesqPros := 'S';
      if not vDadosIni.PesqPros('VND087', 'LIBERAR', vSing.vTipoVenda + ':' + dataSet.FieldByName('NPED').AsString
        + ' DESC.: ' +
        //format('%n', [(((vtot - dataSet.FieldByName('valor_total').AsCurrency) * 100) / vtot)]) + '%',
        format('%n', [(((vtot - (ffloat('valor_total') + IfThen(not str_empty('nf_ac_calctrib'), ffloat('nf_dc_vicmdeson') - ffloat('acrescimo')))) * 100) / vtot)]) + '%',
        'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
      begin
        Result := false;
        Exit;
      end;
      if Application.MessageBox('Deseja continuar a venda?', 'Confirmação', MB_YESNO +
        MB_ICONQUESTION) = IDNo then
      begin
        Result := false;
        Exit;
      end;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TPedVenda.verificarDescontosNoItem: boolean;
var
  msgDescontos: AnsiString;
  vmensagem: string;
  vDescontoTotal: Double;
  vDescontoInicial: Double;
begin
  result := true;
  msgDescontos := '';
  vItProd.dtSet.First;
  if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
    msgDescontos := 'Valor total dos produtos que permitem desconto é: ' + format('%m', [vValorProdPermDesc]) + chr(13) + chr(13)
  else
    msgDescontos := 'Valor total dos produtos que permitem desconto é: ' + format('%m', [vValorProdPermDesc]) + chr(13) +
      'Valor total dos serviços que permitem desconto é: ' + format('%m', [vValorTotalServ]) + chr(13) + chr(13);
  while not vItProd.dtSet.Eof do
  begin
    if trim(vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select MAX_DESC_ITEM from produtos p ' +
        ' where p.grupo_prod = ' + vItProd.dtSet.FieldByName('grupo_prod').AsString +
        ' and p.cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
        ' and p.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;

      {if (vItProd.dtSet.FieldByName('PRECOPORQTDE').AsString = 'S') then
      begin
        if (not vDadosIni.vPedVnd.descontoProdutosPorQtde) and (vItProd.dtSet.FieldByName('VALOR_DESCACRES').AsFloat > 0) then
        begin
          msgDescontos := msgDescontos + 'Produto possui preço por quantidade' +
          ' no item ' + vItProd.dtSet.FieldByName('nitem').asstring + ' - ' +
            trim(vItProd.dtSet.FieldByName('num_fab_prod').asstring) + ' - ' +
            format('%m', [vItProd.dtSet.FieldByName('valor_descacres').AsCurrency]) +
          ' desconto não é permitido.' + chr(13);
          result := false;
        end;
      end
      else}
      if (vDadosIni.strIn(vItProd.dtSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q'])) then
      begin
      	if vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'P' then
      		vmensagem := 'promocao'
        else if vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'T' then
        	vmensagem := 'diferenciado'
        else if vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'Q' then
        	vmensagem := 'por quantidade';

      	if (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
        begin
        	if ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'P') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoPromocao = 'S'))
            or ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'T') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoDiferenciado = 'S'))
            or ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'Q') and (vDadosIni.vPedVnd.ExibirDesconto.PrecoQtde = 'S')) then
          begin
          	vDescontoTotal   := vItProd.dtSet.FieldByName('rateio_desc').AsCurrency - vItProd.dtSet.FieldByName('nf_dc_despnf').AsCurrency;
            vDescontoInicial := (vItProd.dtSet.FieldByName('vlun_ped_item').AsFloat - vItProd.dtSet.FieldByName('vlun_orig').AsFloat) * vItProd.dtSet.FieldByName('quant_ped_item').AsFloat;

          	if (RoundTo(vDescontoInicial, -2) > 0)
            	and (RoundTo(vDescontoTotal - vDescontoInicial, -2) >
              		 RoundTo((vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100)),-2)) then
            begin
              msgDescontos := msgDescontos + 'Produto com preço ' + vmensagem + #13 +
                'Desconto total (' + format('%m', [vDescontoTotal]) + ') - ' +
                'Desconto inicial (' + format('%m', [vDescontoInicial]) + ') = ' +
                'Desconto adicional (' + format('%m', [vDescontoTotal - vDescontoInicial]) + ')' + #13 +
                'No item ' + vItProd.dtSet.FieldByName('nitem').asstring + ' - ' +
                  trim(vItProd.dtSet.FieldByName('num_fab_prod').asstring) + ' - ' +
                  format('%m', [vItProd.dtSet.FieldByName('vltot_ped_item').AsCurrency]) +
                ' maior que os ' +
                  format('%n', [vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% permitido.' + chr(13);
              result := false;
            end;
          end
          else
          begin
            if (RoundTo(vItProd.dtSet.FieldByName('RATEIO_DESC').AsCurrency - vItProd.dtSet.FieldByName('NF_DC_DESPNF').AsCurrency, -2) >
              RoundTo((vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsCurrency / 100)),-2)) then
            begin
              msgDescontos := msgDescontos + 'Produto com preço ' + vmensagem + ', desconto concedido de ' +
                format('%m', [vItProd.dtSet.FieldByName('rateio_desc').AsCurrency - vItProd.dtSet.FieldByName('nf_dc_despnf').AsCurrency]) +
                ' no item ' + vItProd.dtSet.FieldByName('nitem').asstring + ' - ' +
                  trim(vItProd.dtSet.FieldByName('num_fab_prod').asstring) + ' - ' +
                  format('%m', [vItProd.dtSet.FieldByName('vltot_ped_item').AsCurrency]) +
                ' maior que os ' +
                  format('%n', [vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat]) + '% permitido.' + chr(13);
              result := false;
            end
          end;
        end;
      end
      else
      begin
        if buscas.FieldByName('MAX_DESC_ITEM').AsFloat > 0 then
        begin
          if RoundTo(vItProd.dtSet.FieldByName('RATEIO_DESC').AsCurrency - vItProd.dtSet.FieldByName('NF_DC_DESPNF').AsCurrency, -2) >
            RoundTo((vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsCurrency * (buscas.FieldByName('MAX_DESC_ITEM').AsCurrency / 100)), -2) then
          begin
            msgDescontos := msgDescontos + 'Rateio de desconto concedido de ' +
              format('%m', [vItProd.dtSet.FieldByName('rateio_desc').AsCurrency - vItProd.dtSet.FieldByName('nf_dc_despnf').AsCurrency]) +
            ' no item ' + vItProd.dtSet.FieldByName('nitem').asstring + ' - ' +
              trim(vItProd.dtSet.FieldByName('num_fab_prod').asstring) + ' - ' +
              format('%m', [vItProd.dtSet.FieldByName('vltot_ped_item').AsCurrency]) +
            ' maior que os ' +
              format('%n', [buscas.FieldByName('MAX_DESC_ITEM').AsFloat]) + '% permitido.' + chr(13);
            result := false;
          end;
        end;
      end;
    end;
    vItProd.dtSet.Next;
  end;
  if not result then
    if Application.MessageBox(pchar(msgDescontos + chr(13) + 'Deseja conceder o desconto e continuar a venda assim mesmo?'), 'Confirmação',
      MB_ICONQUESTION + MB_YESNO) = ID_YES then
      if vDadosIni.PesqPros('VND119', 'LIBERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
      	dataSet.FieldByName('NPED').AsString, buscas, true) then
        	result := true;
end;

function TPedVenda.verificarDevolucao(pMensagem: string): boolean;
var
  vMensagem: string;
  vtemp: string;
  vNumPedVenda: Integer;
  vresult: boolean;
  vCancelarDoc: boolean;
  vCancelarSomServ: boolean;
begin
  Result := true;
  vresult := true;
  vCancelarDoc := false;
  vCancelarSomServ := false;
  vMensagem := '';
  vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;

  if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
    exit;

  SqlOpen('SELECT DISTINCT SEQUENCIA, DATA FROM DEVOLUCAO ' +
    ' WHERE COD_VENDA = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
    ' AND TIPO_VENDA = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa);

  if buscas.FieldByName('SEQUENCIA').AsInteger > 0 then
  begin
     Result := false;

     buscas.First;
     while not buscas.Eof do
     begin
       vMensagem := vMensagem +
         vDadosIni.IfThen(trim(vMensagem) <> '', #13, '') +
         'Dev ' + IntToStr(buscas.FieldByName('SEQUENCIA').AsInteger) +
         ' Data ' + FormatDateTime('dd/mm/yyyy', buscas.FieldByName('DATA').AsDateTime);

       buscas.Next;
     end;

     if ((vSing.vTipoVenda = 'OS') and (pMensagem = 'CANCELAR')
      and (dataSet.FieldByName('TOT_PROD').AsFloat > 0) and (dataSet.FieldByName('TOT_SERV').AsFloat > 0)) then
     begin
     	 if FrmConfirmCancelamento = nil then
       begin
         Application.CreateForm(TFrmConfirmCancelamento, FrmConfirmCancelamento);

         if DtmPedVenda = nil then
           DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

         vDadosIni.AlterarDataSourceComponentes(FrmConfirmCancelamento, DtmPed);
       end;

       FrmConfirmCancelamento.Label1.Caption := 'Ordem de Serviço ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
       		' possui devolução(ões): ' + #13 + #13 + vMensagem;
       FrmConfirmCancelamento.Height := 175 + (buscas.RecordCount * 12);
       FrmConfirmCancelamento.Height := 175 + (buscas.RecordCount * 13);
       FrmConfirmCancelamento.RadioGroup1.Items.Clear;
       FrmConfirmCancelamento.RadioGroup1.Items.Add('Deseja cancelar assim mesmo?');
       FrmConfirmCancelamento.RadioGroup1.Items.Add('Deseja cancelar somente os serviços?');
       FrmConfirmCancelamento.RadioGroup1.ItemIndex := 0;
       FrmConfirmCancelamento.ShowHint := true;   
       if FrmConfirmCancelamento.ShowModal = mrOk then
       begin
         vCancelarDoc := FrmConfirmCancelamento.RadioGroup1.ItemIndex = 0;
         vCancelarSomServ := FrmConfirmCancelamento.RadioGroup1.ItemIndex = 1;
         vresult := not vCancelarSomServ;
       end
       else
	     begin
	       Result := false;
         exit;
	     end; 
     end;

     if (not vCancelarDoc) and (not vCancelarSomServ) then
     begin
       vtemp := 'Deseja ' + vDadosIni.IfThen(pMensagem = 'CANCELAR', 'cancelar', 'reabrir') + ' assim mesmo?';
       if trim(dataSet.FieldByName('TIPO').AsString) = 'REQ' then
       begin
         if Application.MessageBox(Pchar('Requisição ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
           ' possui devolução(ões): ' + #13 + #13 + vMensagem + #13 + #13 + vtemp),
           'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
		     begin
           result := false;
			     exit;
	       end;
       end
       else
       begin
         if Application.MessageBox(Pchar('Ordem de Serviço ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
           ' possui devolução(ões): ' + #13 + #13 + vMensagem + #13 + #13 + vtemp),
           'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
		     begin 
		       if (trim(pMensagem) <> 'CANCELAR') then
           begin
		         result := false;
			       exit;
		       end
		       else
             vresult := false;
         end;
       end;
     end;

     if vresult then
       if not vDadosIni.PesqPros('VND239', pMensagem + ' VENDA', pMensagem + ' ' + getTipoVenda,
       	 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
	     begin
         Application.MessageBox(Pchar('Ordem de serviço com devolução emitida. Cancelamento não permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
         result := false;
         exit;
	     end;

     if vCancelarSomServ then 
     begin
        if not vDadosIni.PesqPros('VND246', 'PERMITIR', vSing.vTipoVenda + ' ' + IntToStr(vNumPedVenda),
         'PEDVENDA', '', buscas, True) then
        begin
          Application.MessageBox(Pchar('Ordem de serviço com devolução emitida. Cancelamento não permitido'), 'Atenção', MB_ICONINFORMATION + MB_OK);
		      result := false;
          exit;
        end;

        if retornaValor('SELECT N_NF as valor FROM pedvenda_serv ' +
          ' WHERE nped = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + ' AND COD_EMPRESA = ' + vDadosIni.CodEmpresa +
          ' and tipo = ' + QuotedStr(vSing.vTipoVenda) +
          ' AND (N_NF <> 0 OR (N_NF IS NOT NULL))') <> '' then
        begin
          if (pMensagem = 'CANCELAR') and (dataSet.FieldByName('TOT_SERV').AsFloat > 0) then
          begin
            if Application.MessageBox(pchar('Ordem de serviço com nota fiscal de serviço emitida, deseja continuar assim mesmo?'),
              'Confirmação', MB_ICONQUESTION + MB_YESNO + MB_DEFBUTTON2) = IDNO then
              	raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Cancelamento não permitido');

            if not vDadosIni.PesqPros('VND245', 'PERMITIR', vSing.vTipoVenda,
              'PEDVENDA', '', buscas, True) then
              	raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Cancelamento não permitido');
          end
          else if dataSet.FieldByName('TOT_SERV').AsFloat > 0 then
            raise Exception.create('Ordem de serviço com nota fiscal de serviço emitida. Cancelamento não permitido');
        end;

        try
          vItServ.abrePedVendaServ(dataSet.FieldByName('NPED').AsInteger);
          disableControlsDataSets;
          vItServ.dataSet.First;
          while not vItServ.dataSet.Eof do
          begin
            vItServ.dataSet.Edit;
            vItServ.dataSet.FieldByName('STATUS').AsString := 'CANCELADO';
            vItServ.dataSet.Post;

            vItServ.dataSet.Next;
          end;
          vItServ.Apply;

          if not (dataSet.State in [dsEdit, dsInsert]) then
            dataSet.Edit;
          dataSet.FieldByName('VALOR_TOTAL').AsFloat := dataSet.FieldByName('VALOR_TOTAL').AsFloat -
            dataSet.FieldByName('TOT_SERV').AsFloat;
          dataSet.FieldByName('TOT_SERV').AsFloat := 0;
          dataSet.Post;
          Apply;

          CommitaTransacao;
          enableControlsDataSets;

          Application.MessageBox(Pchar('Cancelamento dos serviços realizado com sucesso!'), 'Atenção', MB_ICONINFORMATION + MB_OK);
          Result := false;
          Exit;
        except on E: Exception do
          begin
            Result := false;
            Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
            registrarEntrega('procedure TPedVenda.verificarDevolucao. Erro: ' + e.Message);
          end;
        end;
     end;

     Result := true;
  end;
end;

procedure TPedVenda.verificarEnvioAutoParaSeparacao(pNped: Integer);
var
  vNumPedVenda: Integer;
  vStatusPed, vStatusSepConf: string;
begin
  if (pNped = 0) then
    Exit;

  vDadosIni.vInibeMensPesqPros := 'S';
  if not vDadosIni.PesqPros('VND182', 'ALTERAR', Trim(vSing.vTipoVenda), 'PEDVENDA', IntToStr(pNped), buscas, true) then
    Exit;

  if Trim(vSing.vTipoVenda) <> 'REQ' then
    Exit;

  try
    if pNped > 0 then
      vNumPedVenda := pNped
    else
      vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;
    buscas.Close;
    buscas.SQL.Text := 'select STATUS_PED, STATUS_SEP_CONF, TIPV, COD_CLIENTE, APROVADA_GERENTE, AUTORIZADO_FINANCEIRO' +
      ' from PEDVENDA' +
      ' WHERE NPED = ' + IntToStr(vNumPedVenda) +
      ' AND TIPO = ''REQ'' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vStatusPed := Trim(buscas.FieldByName('STATUS_PED').AsString);
    vStatusSepConf := Trim(buscas.FieldByName('STATUS_SEP_CONF').AsString);

    if Trim(vStatusPed) <> '' then
      Exit;

    if Trim(vStatusSepConf) <> '' then
      Exit;

    if not gerenteAutorizou(vNumPedVenda) then
      Exit;

    if not financeiroAutorizou(vNumPedVenda) then
      Exit;

    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Iniciado', '', buscas, False, False, False);

    if vDadosIni.mudarStatusSeparacao(vNumPedVenda, 'REQ', cSeparacao, buscas, False) then
      vDadosIni.GravaAuditoria('VND182', 'ALTERAR', 'SUCESSO AGUARDANDO COMMIT', 'PEDVENDA', IntToStr(pNped), buscas)
    else
      vDadosIni.GravaAuditoria('VND182', 'ALTERAR', 'FALHA', 'PEDVENDA ', IntToStr(pNped), buscas);

  except on E: Exception do
    begin
      vDadosIni.GravaAuditoria('VND182', 'ALTERAR', 'FALHA', 'PEDVENDA ', IntToStr(pNped), buscas);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registrarEntrega('function TPedVenda.verificarEnvioAutoParaSeparacao. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.verificarImpressaoPerm(
	pExibirProcesso: boolean = False;
  pExibirMens: boolean = False): boolean;
var
	ConfigImp: TConfig_sistema_class;
  vStringListTiposReqOs: TStringList;
  I: Integer;
begin
	try
  	vStringListTiposReqOs := TStringList.Create;
    vStringListTiposReqOs.Clear;

    try
      Result := False;
      if (trim(dataSet.FieldByName('TIPO').AsString) = 'REQ')
        and (trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'FECHADA') then
      begin
        ConfigImp := TConfig_sistema_class.getConf('ped_vnd_imprimir_fech', buscas, vDadosIni.cod_empresa);

        if (UpperCase(ConfigImp.ReadString('Conf_REQ', 'Ativa')) = 'S')
          or (UpperCase(ConfigImp.ReadString('Conf_REQ', 'Ativa')) = 'SIM') then
        begin
          vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Conf_REQ', 'TipV')), ',');

          for I := 0 to vStringListTiposReqOs.Count - 1 do
          begin
            if trim(vStringListTiposReqOs[I]) = trim(dataSet.FieldByName('TIPV').AsString) then
            begin
              if pExibirProcesso then
                if vDadosIni.PesqPros('VND261', 'PERMITIR',
                  dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
                  dataSet.FieldByName('NPED').AsString, buscas, true) then
                begin
                  Result := True;
                  Exit;
                end;

              if pExibirMens then
                Application.MessageBox(Pchar('Impressão permitida apenas para documento fechado'), 'Atenção', MB_ICONINFORMATION + MB_OK);
              exit;
            end;
          end;
        end;
      end
      else if (trim(dataSet.FieldByName('TIPO').AsString) = 'OS')
        and (trim(dataSet.FieldByName('STATUS_PED').AsString) <> 'FECHADA') then
      begin
        ConfigImp := TConfig_sistema_class.getConf('ped_vnd_imprimir_fech', buscas, vDadosIni.cod_empresa);

        if (UpperCase(ConfigImp.ReadString('Conf_OS', 'Ativa')) = 'S')
          or (UpperCase(ConfigImp.ReadString('Conf_OS', 'Ativa')) = 'SIM') then
        begin
          vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Conf_OS', 'TipoOS')), ',');

          for I := 0 to vStringListTiposReqOs.Count - 1 do
          begin
            if trim(vStringListTiposReqOs[I]) = trim(dataSet.FieldByName('TIPO_OS').AsString) then
            begin
              if pExibirProcesso then
                if vDadosIni.PesqPros('VND262', 'PERMITIR',
                  dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
                  dataSet.FieldByName('NPED').AsString, buscas, true) then
                begin
                  Result := True;
                  Exit;
                end;

              if pExibirMens then
                Application.MessageBox(Pchar('Impressão permitida apenas para documento fechado'), 'Atenção', MB_ICONINFORMATION + MB_OK);
              exit;
            end;
          end;
        end;
      end;

      Result := True;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  finally
  	if Assigned(vStringListTiposReqOs) then
    	FreeAndNil(vStringListTiposReqOs);
    if Assigned(ConfigImp) then
    	FreeAndNil(ConfigImp);
  end;
end;

function TPedVenda.verificarNFSe(nped: Integer; tipo: string; exibir_mens: boolean = True): boolean;
begin
	Result := False;

	buscas.close;
  buscas.sql.text := ' select count(*) as qtde, ' +
   ' sum(coalesce(valor_tot_serv, 0) - coalesce(rateio_desc, 0)) as valor from pedvenda_serv ' +
   ' where nped = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
   ' and tipo = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
   ' and cod_empresa = ' + vDadosIni.codEmpresa +
   ' and valor_tot_serv <> 0 ' +
   ' and (n_nf is null or n_nf = 0) ' +
   ' and (status is null or status = '''') ';
  buscas.open;

  if buscas.FieldByName('qtde').AsInteger > 0 then
  begin
  	if not exibir_mens then
    	Result := True
    else
      Result := Application.MessageBox(Pchar('Deseja Emitir NFSe dos serviços desta Venda no valor de: ' +
        format('%n', [buscas.fieldbyname('valor').ascurrency])+'?'),
        'Confirmação', MB_YESNO + MB_DEFBUTTON2) = mrYES;
  end;
end;

procedure TPedVenda.verificarSalvamentoAutomatico(pTipV: boolean);
begin
  if not (dataSet.State in [dsInsert, dsEdit]) then
  	 exit; 
      
  //Ativa o salvendo automatico do pedvenda ao salvar os itens (Pedido de Venda, Orçamento e Ordem de Servico)
  if (not vDadosIni.strEstaContidoEm(vDadosIni.vEmp.vAlmox, ['S2', 'S1'])) then
  begin
    if not pTipV then
      dataSet.FieldByName('SAVEAUTO').AsString := vDadosIni.retornoPorCondicao(
        vDadosIni.PesqPros('VND194', 'HABILITAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA',
        	dataSet.FieldByName('NPED').AsString, buscas, True, False, True), 'S', 'N');

    if ((dataSet.FieldByName('SAVEAUTO').AsString = 'N') or (pTipV)) then
    begin
      if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
        dataSet.FieldByName('SAVEAUTO').AsString :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(salvar_itens_automatic, ''N'') AS VALOR from tipo_vendas ' +
           ' where tipo=''OS'' and tipo_os = ' + QuotedStr(trim(dataSet.FieldByName('tipo_os').AsString))) = 'S', 'S', 'N')
      else if trim(dataSet.FieldByName('TIPO').AsString) = 'ORC' then
        dataSet.FieldByName('SAVEAUTO').AsString :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(salvar_itens_automatic, ''N'') AS VALOR from tipo_vendas ' +
          ' where tipo=''ORC'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipo_orc').AsString))) = 'S', 'S', 'N')
      else
      begin
        dataSet.FieldByName('SAVEAUTO').AsString :=
          vDadosIni.retornoPorCondicao(retornaValor('select first 1 coalesce(salvar_itens_automatic, ''N'') AS VALOR from tipo_vendas ' +
          ' where tipo=''REQ'' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipv').AsString))) = 'S', 'S', 'N');
        if (vDadosIni.vEmp.vAbaterItens = 'S') then
          if (dataSet.FieldByName('NPED').AsInteger > 0) and (dataSet.FieldByName('SAVEAUTO').AsString <> 'S') then
          begin
            dataSet.FieldByName('SAVEAUTO').AsString :=
            vDadosIni.retornoPorCondicao(retornaValor('select first 1 case when(nped > 0) then ''S'' else ''N'' end VALOR from pedvenda_prod_conf' +
              ' where nped = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
              ' and tipo = ''REQ'' and cod_empresa = ' + vDadosIni.codEmpresa) = 'S', 'S', 'N');
          end;
      end;
    end;
  end;
end;

function TPedVenda.verificarServicos: boolean;
var
 vOK: boolean;
begin
 try
   Result := true;
   if not ((vSing.vTipoVenda <> 'REQ') and (not vSing.vOrcamentoSoPecas)
     and (vDadosIni.vEmp.vSegmentaProdVenda = 'S2')) then
      exit;

//    vItServ.Refresh;
    vItProd.Refresh;
    vItProd.First;
    while not vItProd.Eof do
    begin
      vOK := true;
      vItServ.dataSet.FieldByName('nitem_serv').AsInteger;
      if (vItProd.dataSet.FieldByName('cod_seg_serv').AsInteger <= 0)
       and (vItServ.dataSet.RecordCount = 1) then
      begin
        vItProd.dataSet.Edit;
        vItProd.dataSet.FieldByName('cod_seg_serv').AsInteger := vItServ.dataSet.FieldByName('cod_servico').AsInteger;
        vItProd.dataSet.FieldByName('nitem_serv').AsInteger := vItServ.dataSet.FieldByName('nitem_serv').AsInteger;
        vItProd.dataSet.post;
      end
      else if (vItProd.dataSet.FieldByName('cod_seg_serv').AsInteger <= 0) then
      begin
        vOK := false;
        Application.MessageBox(Pchar('Serviço não informado. ' + #13 +
         'Item nº ' + IntToStr(vItProd.dataSet.FieldByName('NITEM').AsInteger) +
         ' produto ' + QuotedStr(trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
         ' ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString)), 'Atenção', MB_ICONERROR + MB_OK);
      end
      else if not vItServ.dataSet.Locate('nitem_serv', vItProd.dataSet.FieldByName('nitem_serv').AsInteger, []) then
      begin
        vOK := false;
        Application.MessageBox(Pchar('Serviço informado não foi encontrado entre os serviços aplicados. ' + #13 +
        'Item nº ' + IntToStr(vItProd.dataSet.FieldByName('NITEM').AsInteger) +
        ' produto ' + QuotedStr(trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
         ' ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString)), 'Atenção', MB_ICONERROR + MB_OK);
      end;
      if not vOK then
      begin
        if FrmSelecionarServico = nil then
        begin
          Application.CreateForm(TFrmSelecionarServico, FrmSelecionarServico);

          if DtmPedVenda = nil then
            DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

          vDadosIni.AlterarDataSourceComponentes(FrmSelecionarServico, DtmPed);
        end;

        FrmSelecionarServico.Panel1.Caption := 'Favor informar serviço: Item nº ' + IntToStr(vItProd.dataSet.FieldByName('NITEM').AsInteger) +
         ' produto ' + QuotedStr(trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
         ' ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString);

        if FrmSelecionarServico.showModal = mrOK then
        begin
          vItProd.dataSet.Edit;
          vItProd.dataSet.FieldByName('cod_seg_serv').AsInteger := vDadosIni.vPesquisaCodServico;
          vItProd.dataSet.FieldByName('nitem_serv').AsInteger := vDadosIni.vPesquisaNitem;
          vItProd.dataSet.post;
        end;
      end;
      vItProd.Next;
    end;
//    if (vItProd.DataSet.ChangeCount = 0) then
//      Result := True
//    else
//      Result := vItProd.Apply;

    vItProd.First;
    while not vItProd.Eof do
    begin
      if (vItProd.dataSet.FieldByName('cod_seg_serv').AsInteger <= 0) then
        raiseExceptioncreate('Serviço não informado. Item nº ' + IntToStr(vItProd.dataSet.FieldByName('NITEM').AsInteger) +
        ' produto ' + QuotedStr(trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
        ' ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString) + chr(13) +
        'Favor Verificar', 'DBLookupComboBox8')
      else if not vItServ.dataSet.Locate('nitem_serv', vItProd.dataSet.FieldByName('nitem_serv').AsInteger, []) then
        raiseExceptioncreate('Serviço informado não foi encontrado entre os serviços aplicados. Item nº ' + IntToStr(vItProd.dataSet.FieldByName('NITEM').AsInteger) +
        ' produto ' + QuotedStr(trim(vItProd.dataSet.FieldByName('NUM_FAB_PROD').AsString)) +
        ' ' + trim(vItProd.dataSet.FieldByName('DESCR_PROD_PED').AsString) + chr(13) + 'Favor Verificar.', 'DBLookupComboBox8');
      vItProd.Next;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TPedVenda.verificaSalvamentoAutomatico: Boolean;
var
  vPed: Integer;
begin
  Result := True;
  if (dataSet.FieldByName('SAVEAUTO').AsString <> 'S') then
   Exit;

  if (dataSet.FieldByName('nped').AsInteger = 0) and (dataSet.State = dsInsert) then
  begin
    if dataSet.FieldByName('cod_cliente').AsInteger <= 0 then
      Exit;

    if dataSet.FieldByName('cod_vendedor').AsInteger <= 0 then
      Exit;

    if dataSet.FieldByName('cod_cond_pag').AsInteger <= 0 then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select cod_cliente from clientes' +
      ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if buscas.FieldByName('cod_cliente').AsInteger = 0 then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select cod_vendedor from colaborador' +
      ' where cod_vendedor = ' + IntToStr(dataSet.FieldByName('cod_vendedor').AsInteger) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if buscas.FieldByName('cod_vendedor').AsInteger = 0 then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select cod_cond_pag from cond_pag' +
      ' where cod_cond_pag = ' + IntToStr(dataSet.FieldByName('cod_cond_pag').AsInteger);
    buscas.Open;
    if buscas.FieldByName('cod_cond_pag').AsInteger = 0 then
      Exit;

    if vSing.vTipoVenda = 'OS' then
    begin
      dataSet.FieldByName('nped').AsInteger := Gencodigo('ORDEM_SERV',
        DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      vDadosIni.hw_registra_estatistica('ORDEM_SERV');
      dataSet.FieldByName('seq_fech').AsInteger := Gencodigo('SEQ_FECH',
        DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      if vSing.vObs_OS <> '' then
        dataSet.FieldByName('OBS_OS').AsString := dataSet.FieldByName('OBS_OS').AsString + ',  O.S.: ' +
          vDadosIni.StrZero(dataSet.FieldByName('nped').AsInteger, 5)
      else if trim(dataSet.FieldByName('OBS_OS').AsString) <> '' then
        dataSet.FieldByName('OBS_OS').AsString := dataSet.FieldByName('OBS_OS').AsString + ',  O.S.: ' + vDadosIni.StrZero(dataSet.FieldByName('nped').AsInteger, 5)
      else
        dataSet.FieldByName('OBS_OS').AsString := 'O.S.: ' + vDadosIni.StrZero(dataSet.FieldByName('nped').AsInteger, 5);
    end
    else if vSing.vTipoVenda = 'REQ' then
    begin
    	if not existeVendaVan then
      begin
      	Application.MessageBox(PChar(vDadosIni.vPesquisa), 'Atenção', MB_ICONERROR + MB_OK);
      	Exit;
      end;

      dataSet.FieldByName('nped').AsInteger := Gencodigo('REQVENDA',
        DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      vDadosIni.hw_registra_estatistica('REQVENDA');
    end
    else if vSing.vTipoVenda = 'ORC' then
    begin
      dataSet.FieldByName('nped').AsInteger := Gencodigo('ORCAMENTOS',
        DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
      vDadosIni.hw_registra_estatistica('ORCAMENTOS');
    end;
    if (vDadosIni.vEmp.vUsarPreVenda = 'S') and (vSing.vTipoVenda = 'REQ') then
      dataSet.FieldByName('paf_num_prevenda').AsInteger :=
        Gencodigo('PAF_PREVENDA', DtmPed.SpIncCodigo, vDadosIni.codEmpresa)
    else if vSing.vUsarDAV = 'S' then
      dataSet.FieldByName('nprevenda').AsInteger := Gencodigo('PREVENDA',
        DtmPed.SpIncCodigo,
        vDadosIni.codEmpresa);
    alterarNpedItens;
    vPed := dataSet.FieldByName('nped').AsInteger;
    dataSet.Post;
    Result := Apply;

    try
      if Result  then
      begin
        if Result then
          if vItProd.dataSet.ChangeCount > 0 then
            Result := vItProd.Apply;
        if Result then
          if vItServ.dataSet.ChangeCount > 0 then
            Result := vItServ.Apply;
        if Result then
          if vItServTerc.dataSet.ChangeCount > 0 then
            Result := vItServTerc.Apply;
        if Result then
          if vItProdTerc.dataSet.ChangeCount > 0 then
            Result := vItProdTerc.Apply;
        if Result then
          Result := CommitaTransacao;
      end;
      if Result then
      begin
        abrePedVenda(vPed);
       	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
        vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
        if Trim(dataSet.FieldByName('tipo').AsString) <> 'REQ' then
        begin
          vItServ.abrePedVendaServ(dataSet.FieldByName('nped').AsInteger);
          vItProdTerc.abreProdTerceiro(dataSet.FieldByName('nped').AsInteger);
          vItServTerc.abreServicoTerceiro(dataSet.FieldByName('nped').AsInteger);
        end;
      end;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
    except
      Result := False;
    end;
  end;
end;

function TPedVenda.verificatipoorc(vtpescol: string): boolean;
begin
  buscas.close;
  buscas.sql.text := 'select * from tipo_vendas where tipo = ''ORC'' and sigla = ''' +
    copy(vtpescol, 1, 1) + '''';
  buscas.open;
  if buscas.isempty then
    result := false
  else
    Result := true;
  buscas.close;
end;

function TPedVenda.verificatipovenda(vtop: integer; var vcomb: TDbCombobox; vtipo: string; vtpescol: string): boolean;
var
  vAbaterItens, vNAbaterItens: string;
  vIndex: Integer;
begin
  vAbaterItens := '';
  vNAbaterItens := '';
  if vtop = 1 then
  begin
    if (dataSet.FieldByName('VALE_TROCA').AsString = 'S') and (dataSet.State = dsEdit) then
    begin
      buscas.close;
      buscas.sql.text := 'select * from tipo_vendas  ' +
        ' where tipo = ' + QuotedStr(trim(vtipo)) +
        ' and sigla = ' + QuotedStr(trim(vDadosIni.vProgFid.vTipoVendaReqTroca)) + 
        ' order by ordemexibicao';
      buscas.open;
    end
    else if (vDadosIni.vEmp.vAbaterItens = 'S') and (dataSet.State = dsEdit) then
    begin
      if trim(vtipo) = 'REQ' then
      begin
        vAbaterItens := retornaValor('select first 1 coalesce(usar_conferencia_produto, '''') as valor from tipo_vendas ' +
          ' where tipo = ' + QuotedStr(trim(vtipo)) +
          ' and sigla = ' + QuotedStr(dataset.FieldByName('TIPV').AsString) +
          ' order by cod_tipo ');

        vNAbaterItens := retornaValor('select first 1 coalesce(n_usar_conferencia_produto, '''') as valor from tipo_vendas ' +
          ' where tipo = ' + QuotedStr(trim(vtipo)) +
          ' and sigla = ' + QuotedStr(dataset.FieldByName('TIPV').AsString) +
          ' order by cod_tipo ');
      end;

      if vAbaterItens = 'S' then
      begin
        buscas.close;
        buscas.sql.text := 'select * from tipo_vendas ' +
          ' where tipo = ' + QuotedStr(trim(vtipo)) +
          ' and (coalesce(usar_conferencia_produto, '''') = ''S'') '+
          ' order by ordemexibicao ';
        buscas.open;
      end
      else if vNAbaterItens = 'S' then
      begin
        buscas.close;
        buscas.sql.text := 'select * from tipo_vendas ' +
         ' where tipo = ' + QuotedStr(trim(vtipo)) +
         ' and (coalesce(n_usar_conferencia_produto, '''') = ''S'') '+
         ' order by ordemexibicao ';
        buscas.open;
      end
      else
      begin
        buscas.close;
        buscas.sql.text := 'select * from tipo_vendas ' +
         ' where tipo = ' + QuotedStr(trim(vtipo)) +
         ' and (coalesce(usar_conferencia_produto, '''') <> ''S'') ' +
         ' and (coalesce(n_usar_conferencia_produto, '''') <> ''S'') '+
         ' order by ordemexibicao ';
        buscas.open;
      end;
    end
    else
    begin
      buscas.close;
      buscas.sql.text := 'select * from tipo_vendas ' +
      	' where tipo = ' + QuotedStr(vtipo) +
        ' order by ordemexibicao';
      buscas.open;
    end;
    vIndex := -1;
    vcomb.Items.Clear;
    while not buscas.eof do
    begin
      if (Trim(buscas.FieldByName('TIPO').AsString) = 'REQ') or (Trim(buscas.FieldByName('TIPO').AsString) = 'ORC') then
        vcomb.Items.Add(trim(buscas.FieldByName('DESCRICAO').AsString));
      if (Trim(buscas.FieldByName('TIPO').AsString) = 'OS') or (Trim(buscas.FieldByName('TIPO').AsString) = 'TMO') then
        vcomb.Items.Add(trim(buscas.FieldByName('TIPO_OS').AsString));
      if (Trim(dataSet.FieldByName('TIPO').AsString) = 'OS') and (Trim(buscas.FieldByName('TIPO_OS').AsString) = Trim(dataSet.FieldByName('TIPO_OS').AsString)) then
        vIndex := buscas.RecNo - 1;
      buscas.next;
    end;
    if (Trim(dataSet.FieldByName('TIPO').AsString) = 'OS') and (vIndex > -1) then
      vcomb.ItemIndex := vIndex;
    Result := true;
  end;

  if vtop = 2 then
  begin
    if vtipo = 'ORC' then
    begin
      Result := true;
      exit;
    end;

    buscas.close;
    if vtipo = 'OS' then
      buscas.sql.text := ' select * from tipo_vendas ' +
      	' where tipo = ' + QuotedStr(trim(vtipo)) +
        ' and tipo_os = ' + QuotedStr(trim(vtpescol))
    else
      buscas.sql.text := ' select * from tipo_vendas ' +
      	' where tipo = ' + QuotedStr(trim(vtipo)) +
        ' and sigla = ' + QuotedStr(copy(vtpescol, 1, 1));
    buscas.open;
    if buscas.isempty then
      result := false
    else
    begin
      if (vtipo = 'OS') then
        vcomb.ItemIndex := vcomb.Items.IndexOf(trim(buscas.FieldByName('TIPO_OS').AsString))
      else vcomb.ItemIndex := vcomb.Items.IndexOf(trim(buscas.FieldByName('DESCRICAO').AsString));
      vcomb.Text := vcomb.Items[vcomb.ItemIndex];
      if (vtipo = 'REQ') and (dataSet.State in [dsEdit, dsInsert]) then
        dataSet.FieldByName('TIPV').AsString := copy(vtpescol, 1, 1);
      Result := true;
    end;
  end;
end;

function TPedVenda.verificaUsoDoPlanoDePagamento: boolean;
var
  vPlano: TComunicacaoFormaPagamento;
  hdFormPag: Cardinal;
  vMaxPercDesc, vPercDesc: Double;
  vValorVenda: Currency;
  vrPlano: Currency;
  vDiferenca: Currency;
  qrHelp: TQuery_OOP;
begin
  if (vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2') then
  begin
    Result := true;
    exit;
  end;
  vMaxPercDesc := 0;
  if (vCondPag.dataSet.FieldByName('MAX_DESC').AsFloat > 0) then
    vMaxPercDesc := vCondPag.dataSet.FieldByName('MAX_DESC').AsFloat;
  if (vCliente.dataSet.FieldByName('CAMP_PR_VENDA').AsString <> '') then
  begin
    if (vCliente.dataSet.FieldByName('PERC_DESC').AsFloat > 0) then
      vMaxPercDesc := vCliente.dataSet.FieldByName('PERC_DESC').AsFloat;
  end;
  calculaTotais;
  vPercDesc := 0;
  vrPlano := 0;
  vValorVenda := vSing.vValorTotalBruto;
  if vSing.vValorTotalBruto > vSing.vValorTotalLiq then
    vPercDesc := ((vSing.vValorTotalBruto - vSing.vValorTotalLiq) / vSing.vValorTotalBruto) * 100;
  if vSing.vValorTotalBruto < vSing.vValorTotalLiq then
    vValorVenda := vSing.vValorTotalLiq;
  try
    CarregaPacote('pkFormPag', hdFormPag);
    vPlano := TComunicacaoFormaPagamento.Create;
    result := vPlano.iniciaPlanoDePagamento(dataSet.FieldByName('nped').AsInteger,
      dataSet.FieldByName('cod_cliente').AsInteger,
      dataSet.FieldByName('cod_vendedor').AsInteger,
      vValorVenda,
      vMaxPercDesc,
      vPercDesc,
      dataSet.FieldByName('TIPV').AsString,
      vSing.vTipoVenda, vrPlano,dataSet.FieldByName('TIPO_OS').AsString);
    if vrPlano > 0 then
    begin
      vDiferenca := 0;
      //if vrPlano > vSing.vValorTotalLiq then
      vDiferenca := vrPlano - vSing.vValorTotalLiq;

      if dataSet.State = dsBrowse then
        dataSet.Edit;
      if vDiferenca > 0 then
      begin
        if not fempty('nf_ac_calctrib') then
        begin
          dataSet.Post;
          Self.Apply;
          vItProd.Apply;
          vItServ.Apply;

          qrHelp := QueryHelper.CreateObj(buscas)
            .Open('select result, msg from SP_PEDVENDA_PLANO_RATEAR(%d, %s, %d, %s)',
                     [fint('nped'), fstrq('tipo'), vDadosIni.cod_empresa, ffloat_fb(vDiferenca)]);

          if qrHelp.fint('result') <> 1 then
            raiseExceptionCreate(qrHelp.fstr('msg'))
          else
          begin   
            dataSet.Refresh;
            vItProd.dataSet.Refresh;
            if vItServ.dataSet.Active then            
              vItServ.dataSet.Refresh;
            dataSet.Edit;
          end;
        end
        else
        dataSet.FieldByName('acrescimo').AsFloat := vDiferenca
      end
      else if vDiferenca < 0 then
      begin
        if f_str('nf_ac_calctrib') = 'S' then
        begin
          dataSet.FieldByName('NF_DC_DESCONTO').AsCurrency := ffloat('NF_DC_DESCONTO') + Abs(vDiferenca);
          dataSet.FieldByName('DESCONTO').AsCurrency       := ffloat('NF_DC_DESCONTO') + ffloat('NF_DC_VICMDESON');
        end
        else
        dataSet.FieldByName('desconto').AsFloat :=
          dataSet.FieldByName('desconto').AsFloat + Abs(vDiferenca);
      end;
      efetuaRateios;
      calculaDescontoAcrescimo;
      dataSet.Post;
    end;
  finally
    UnloadPackage(hdFormPag);
  end;
end;

function TPedVenda.verificaVendaCondicional: boolean;
var
	vSiglaTmp: string;
	vDescricaoTmp: string;
  vCodClienteTmp: string;
begin
	Result := False;

  if trim(dataSet.FieldByName('TIPO').AsString) <> 'REQ' then
  begin
  	Result := True;
    exit;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select first 1 sigla, descricao, coalesce(venda, ''N'') venda from tipo_vendas ' +
    ' where tipo = ''REQ'' ' +
    ' and sigla = ' + QuotedStr(trim(dataSet.FieldByName('tipv').AsString));
  buscas.Open;

  if buscas.IsEmpty then
  begin
  	Result := True;
    exit;
  end;

  vSiglaTmp := trim(buscas.FieldByName('SIGLA').AsString);
  vDescricaoTmp := trim(buscas.FieldByName('DESCRICAO').AsString);
  vCodClienteTmp := IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger);

  if buscas.FieldByName('VENDA').AsString <> 'N' then
  begin
  	Result := True;
    exit;
  end;

  buscas.Close;
  buscas.SQL.Text := ' select pd.nped, pd.tipo, pd.cod_empresa, pd.status_ped, pd.data_ped, pd.data_fech, pd.cod_cliente from pedvenda pd ' +
	  ' inner join tipo_vendas tp on ' +
    '		pd.tipo = tp.TIPO ' +
    '		and pd.tipv = tp.sigla ' +
  	' where pd.nped <> ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
    ' and pd.tipo = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
    ' and pd.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ((pd.status_ped = '''') or (pd.status_ped is null)) ' +
		' and pd.cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
    ' and coalesce(venda, '''') = ''N'' ';
  buscas.Open;

	Result := buscas.IsEmpty;

	if not Result then
  begin
   	if Application.MessageBox(PChar('Cliente possui venda em aberto com mesmo tipo de venda ' + QuotedStr(vDescricaoTmp) + #13 + #13 +
    	'Deseja continuar assim mesmo?'),
    	'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> mrYes then
      	exit;

    if not vDadosIni.PesqPros('VND260', 'PERMITIR', dataSet.FieldByName('TIPO').AsString + ' - ' +
    	'CLIENTE: ' + vCodClienteTmp, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, True) then
    		exit;

    Result := True;
  end;
end;

function TPedVenda.verPendenciaVenda(pCodvend: integer; pTipvAtacVarejo: string; pTipoMesclagem:string=''): boolean;
var
  vnivelus, vdias: integer;
  vossprob: AnsiString;
  vTipo: string;
begin
  result := true;
  vossprob := '';
  if pTipoMesclagem='' then
  begin
    if (vSing.vTipoVenda = 'ORC') then
      exit;
    vTipo:= vSing.vTipoVenda;
  end
  else
  	vTipo:= trim(pTipoMesclagem);
    
  if vDadosIni.vusardtvervnd <> '' then
  begin
    buscas.close;
    if vTipo = 'REQ' then
    begin
      buscas.SQL.Text := 'select * from REGRAS_TRAVOSREQ where tipo = ''REQ''  and tipv = ' +
        QuotedStr(pTipvAtacVarejo) + ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1';
      buscas.Open;
      if not buscas.IsEmpty then
      begin
        vdias := buscas.fieldbyname('QTDE_DIAS').AsInteger;
        vnivelus := buscas.fieldbyname('NIVEL_US').AsInteger;
      end
      else
      begin
        vdias := 0;
        vnivelus := 0;
      end;
      buscas.Close;
      buscas.sql.text := 'SELECT NPED FROM PEDVENDA WHERE tipo =''REQ'' and ' +
        ' COD_VENDEDOR = ' + inttostr(pCodvend) + ' AND TIPV = ' + QuotedStr(pTipvAtacVarejo) +
        ' and coalesce(status_ped,'''') <> ''CANCELADO'' '+
        ' AND ((DATA_LIBTRAVA >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_LIBTRAVA <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1)) +
        ' AND DATA_FECH IS NULL) OR (DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - 1)) +
        ' AND (NOT DATA_FECH IS NULL) AND (OP_CXL IS NULL OR OP_CXL = 0)))';
      buscas.open;
      while not buscas.Eof do
      begin
        vossprob := vossprob + vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6) + ' ';
        buscas.next;
      end;
      buscas.Close;
      buscas.sql.text := 'SELECT COUNT(*) as total FROM PEDVENDA WHERE tipo =''REQ'' and ' +
        ' COD_VENDEDOR = ' + inttostr(pCodvend) + ' AND TIPV = ' + QuotedStr(pTipvAtacVarejo) +
        ' and coalesce(status_ped,'''') <> ''CANCELADO'' '+
        ' AND ((DATA_LIBTRAVA >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_LIBTRAVA <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1)) +
        ' AND DATA_FECH IS NULL) OR (DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - 1)) +
        ' AND (NOT DATA_FECH IS NULL) AND (OP_CXL IS NULL OR OP_CXL = 0)))';
    end
    else
    begin
      buscas.sql.text := 'select * from REGRAS_TRAVOSREQ where tipo = ''OS''  and tipv = ' +
        QuotedStr(pTipvAtacVarejo) + ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1';
      buscas.Open;
      if not buscas.IsEmpty then
      begin
        vdias := buscas.fieldbyname('QTDE_DIAS').AsInteger;
        vnivelus := buscas.fieldbyname('NIVEL_US').AsInteger;
      end
      else
      begin
        vdias := 0;
        vnivelus := 0;
      end;
      buscas.Close;
      buscas.sql.text := 'SELECT NPED FROM PEDVENDA WHERE tipo = ''OS'' and ' +
        ' COD_VENDEDOR = ' + inttostr(pCodvend) + ' AND TIPO_OS = ' + QuotedStr(pTipvAtacVarejo) +
        ' and coalesce(status_ped,'''') <> ''CANCELADO'' '+
        ' AND ((DATA_LIBTRAVA >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_LIBTRAVA <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1)) +
        ' AND DATA_FECH IS NULL) OR ' +
        '(DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - 1)) +
        ' AND (NOT DATA_FECH IS NULL) AND (OP_CXL IS NULL OR OP_CXL = 0)))';
      buscas.Open;
      while not buscas.Eof do
      begin
        vossprob := vossprob + vDadosIni.StrZero(buscas.FieldByName('NPED').AsInteger, 6) + ' ';
        buscas.Next;
      end;
      buscas.Close;
      buscas.sql.text := 'SELECT COUNT(*) as total FROM PEDVENDA WHERE tipo = ''OS'' and ' +
        ' COD_VENDEDOR = ' + inttostr(pCodvend) + ' AND TIPO_OS = ' + QuotedStr(pTipvAtacVarejo) +
        ' and coalesce(status_ped,'''') <> ''CANCELADO'' '+
        ' AND ((DATA_LIBTRAVA >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_LIBTRAVA <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1)) +
        ' AND DATA_FECH IS NULL) OR ' +
        '(DATA_FECH >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vusardtvervnd))) +
        ' AND DATA_FECH <= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - 1)) +
        ' AND (NOT DATA_FECH IS NULL) AND (OP_CXL IS NULL OR OP_CXL = 0)))';
    end;
    vDadosIni.abreStatusProcessamento('', 'Verificando Pendências de Venda');
    buscas.Open;
    vDadosIni.fechaStatusProcessamento;
    if buscas.FieldByName('total').asinteger > 0 then
    begin
      if vTipo = 'REQ' then
        Application.MessageBox(Pchar('Esse Vendedor tem vendas pendentes(fechamento/recebimento) entre os dias ' + vDadosIni.vusardtvervnd + ' e ' +
          FormatDateTime('dd/mm/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1) + ' ' + #13 + vossprob), 'Informação', MB_OK)
      else
        Application.MessageBox(Pchar('Esse Recepcionista tem vendas pendentes(fechamento/recebimento) entre os dias ' + vDadosIni.vusardtvervnd + ' e ' +
          FormatDateTime('dd/mm/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1) + ' ' + #13 + vossprob), 'Informação', MB_OK);
      if not vDadosIni.PesqPros('VND090', 'VENDEDOR: ' + vDadosIni.StrZero(pCodvend, 5), '', 'PEDVENDA', '', buscas, true) then
        Result := false
      else
        Result := true;
    end
    else
    begin
      if vDadosIni.vNivel < vnivelus then
      begin
        if vTipo = 'REQ' then
          Application.MessageBox('Esse Vendedor não tem permissão para abrir este tipo de Requisição', 'Informação', MB_OK)
        else
          Application.MessageBox('Esse Recepcionista não tem permissão para abrir este tipo de O.S.', 'Informação', MB_OK);
        if not vDadosIni.PesqPros('VND090', 'VENDEDOR: ' + vDadosIni.StrZero(pCodvend, 5), '', 'PEDVENDA', '', buscas, true) then
          Result := false
        else
          Result := true;
      end;
    end
  end;
end;

function TPedVenda.verPendenciaVendaIt(pTipoIt:string='P'): boolean;
var
  vnivelus, vdias: integer;
begin
  result:= true;
  if (vSing.vTipoVenda = 'ORC') or vendaFechada or (dataSet.FieldByName('NPED').asinteger=0) then
    exit;
  buscas.Close;
  buscas.SQL.Text := 'select * from REGRAS_TRAVOSREQ where tipo = '+quotedstr(vSing.vTipoVenda);

  if vSing.vTipoVenda = 'REQ' then
    buscas.sql.text := buscas.sql.text + ' AND TIPV = ' + QuotedStr(trim(dataSet.FieldByName('TIPV').AsString))
  else buscas.sql.text := buscas.sql.text + ' AND TIPV = ' + QuotedStr(trim(dataSet.FieldByName('TIPO_OS').AsString));

  buscas.sql.text := buscas.sql.text +' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1';
  buscas.Open;
  if not buscas.IsEmpty then
  begin
    vdias := buscas.fieldbyname('QTDE_DIAS').AsInteger;
    vnivelus := buscas.fieldbyname('NIVEL_US').AsInteger;
  end
  else
  begin
    vdias := 0;
    vnivelus := 0;
  end;
  buscas.Close;
  buscas.sql.text := 'SELECT COUNT(NPED) as total FROM PEDVENDA WHERE tipo ='+quotedstr(trim(vSing.vTipoVenda));
//  if vSing.vTipoVenda = 'REQ' then
//    buscas.sql.text := buscas.sql.text + ' AND TIPV = ' + QuotedStr(trim(dataSet.FieldByName('TIPV').AsString))
//  else buscas.sql.text := buscas.sql.text + ' AND TIPO_OS = ' + QuotedStr(trim(dataSet.FieldByName('TIPO_OS').AsString));

  buscas.sql.text := buscas.sql.text + 'and nped = '+ inttostr(dataSet.FieldByName('NPED').asinteger)+
    ' and cod_empresa = '+vDadosIni.codEmpresa+
    ' and coalesce(status_ped,'''') <> ''CANCELADO'' '+
    ' AND ( '+
    ' (DATA_PED >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', strtodate(vDadosIni.vEmp.vDtVencUIItensVnd))) +
    ' and coalesce(LIBTRAVA,'''') <>''S'' ) '+
    ' or '+
    ' (DATA_LIBTRAVA >= ' + QuotedStr(FormatDateTime('mm/dd/yyyy', vDadosIni.getDataBanco(buscas) - vdias - 1)) +
    ' and coalesce(LIBTRAVA,'''') =''S'' ) ) '+
    ' AND DATA_FECH IS NULL  ';
  buscas.Open;

  if not(buscas.FieldByName('total').AsInteger>0) then
  begin
    Application.MessageBox(Pchar('Data para alteração ou inclusão de itens para este pedido de venda já está de vencida.'), 'Informação', MB_OK);
    if vSing.vTipoVenda = 'REQ' then
    begin
      if not vDadosIni.PesqPros('VND177', 'VENDEDOR: ' + vDadosIni.StrZero(dataSet.FieldByName('COD_VENDEDOR').AsInteger, 5),vSing.vTipoVenda+ ' NPED:'+dataSet.FieldByName('NPED').AsString+'ITEM:'+vItProd.dataSet.FieldByName('NITEM').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        Result := false
      else
      	Result := true;
    end
    else if vSing.vTipoVenda = 'OS' then
    begin
      if pTipoIt = 'P' then
      begin
        if not vDadosIni.PesqPros('VND177', 'VENDEDOR: ' + vDadosIni.StrZero(dataSet.FieldByName('COD_VENDEDOR').AsInteger, 5),vSing.vTipoVenda+ ' NPED: '+dataSet.FieldByName('NPED').AsString+' ITEM: '+vItProd.dataSet.FieldByName('NITEM').AsString+' MEC./TEC.: '+vItProd.dataSet.FieldByName('COL_COD_VENDEDOR').AsString, 'PEDVENDA_PROD', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Result := false
        else
        	Result := true;
      end
      else if pTipoIt = 'PT' then
      begin
        if not vDadosIni.PesqPros('VND177', 'VENDEDOR: ' + vDadosIni.StrZero(dataSet.FieldByName('COD_VENDEDOR').AsInteger, 5),vSing.vTipoVenda+ ' NPED: '+dataSet.FieldByName('NPED').AsString+' DESCR: '+trim(vItProdTerc.dataSet.FieldByName('DESCRICAO').AsString), 'PEDVENDA_PROD_TERC', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Result := false
        else
        	Result := true;
      end
      else if pTipoIt = 'S' then
      begin
        if not vDadosIni.PesqPros('VND177', 'VENDEDOR: ' + vDadosIni.StrZero(dataSet.FieldByName('COD_VENDEDOR').AsInteger, 5),vSing.vTipoVenda+ ' NPED: '+dataSet.FieldByName('NPED').AsString+' ITEM: '+vItServ.dataSet.FieldByName('NITEM').AsString+' MEC1./TEC1: '+vItServ.dataSet.FieldByName('COD_VENDEDOR1').AsString, 'PEDVENDA_SERV', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Result := false
        else
        	Result := true;
      end
      else if pTipoIt = 'ST' then
      begin
        if not vDadosIni.PesqPros('VND177', 'VENDEDOR: ' + vDadosIni.StrZero(dataSet.FieldByName('COD_VENDEDOR').AsInteger, 5),vSing.vTipoVenda+ ' NPED: '+dataSet.FieldByName('NPED').AsString+' DESCR: '+trim(vItServTerc.dataSet.FieldByName('DESCR_SERVT').AsString), 'PEDVENDA_SERV_TERC', dataSet.FieldByName('NPED').AsString, buscas, true) then
          Result := false
        else
        	Result := true;
      end;
    end;
  end;
end;

