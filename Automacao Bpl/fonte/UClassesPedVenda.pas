procedure TPedVenda._setaVariaveisTipoVendas;
var
  vSigla:string;
begin
  if vSing.vTipoVenda = 'ORC' then
    vSigla:= trim(dataSet.FieldByName('TIPO_ORC').AsString)
  else
  	vSigla:= trim(dataSet.FieldByName('TIPV').AsString);

  buscas.close;
  buscas.SQL.Text:= 'select ptv.maxdescontotv, ptv.min_m_lq, ptv.min_margem  from tipo_vendas tv '+
    ' inner join percentuaistipovnd ptv on tv.cod_tipo = ptv.cod_tipo '+
    ' where tv.tipo = '+ QuotedStr(vSing.vTipoVenda)+
    ' and ((tv.sigla = '+QuotedStr(vSigla)+
    ' and coalesce(tv.sigla, '''') <> '''') or (tv.tipo_os = ' + QuotedStr(dataSet.FieldByName('TIPO_OS').AsString) +
    ' and coalesce(tv.tipo_os, '''') <> '''')) and ptv.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;

  vPercDescMax:= buscas.FieldByName('maxdescontotv').AsFloat;
  vMinMarkUp := buscas.FieldByName('min_margem').AsFloat;
  vMinMargemLiq := buscas.FieldByName('min_m_lq').AsFloat;
  buscas.Close;
end;

function TPedVenda._SimularValoresComDesconto(var pLabel:Tlabel):string;
var
  acrescProd, acrescServ: Currency;
begin
  try
    disableControlsDataSets;
    vDadosIni.abreStatusProcessamento('', 'Simulando totais');
    vValorProdPermDesc := 0;
    FSobreporPromocao := false;
    FSobreporPrecTab := false;
    FSobreporMaxDescProd := false;
//    _defineRegrasDesconto;
    FRegrasDescontos:= vRVnd.FCodRegras;
    if vDadosIni.vEmp.vUsarPoliticasDesc then
      if (trim(FRegrasDescontos) <> '') and (trim(FRegrasDescontos) <> '()') then
      begin
        FSobreporPromocao := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + trim(FRegrasDescontos) +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_promocao = ''S'' ');
        FSobreporPrecTab := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + trim(FRegrasDescontos) +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_tabpreco = ''S'' ');
        FSobreporMaxDescProd := ExecutaComandosSql(' select rv.cod_regravnd from regras_vendas rv ' +
          ' where rv.cod_regravnd in ' + trim(FRegrasDescontos) +
          ' and rv.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and rv.ativo = 1 ' +
          ' and rv.sobrepor_maxdescprod = ''S'' ');
      end;
    vItProd.dtSet.First; //dataset temporário
    while not vItProd.dtSet.Eof do
    begin
      if trim(vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
      begin
        vItProd.vProduto.buscaProduto(
        	vItProd.dtSet.FieldByName('grupo_prod').AsInteger,
          vItProd.dtSet.FieldByName('cod_prod').AsString);
        if (vItProd.vProduto.dataSet.FieldByName('PERMITIR_DESCONTO').AsString <> 'N') and
          ((vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString <> 'S') or
          ((FSobreporPromocao) and (vItProd.vProduto.dataSet.FieldByName('EM_PROMOCAO').AsString = 'S'))) and // ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS')))) and
          ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'P') or
          ((FSobreporPromocao) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'P'))) and // ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS'))) ) and
          ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'T') or
          ((FSobreporPrecTab) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'T'))) and
          ((vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'Q') or
          ((FSobreporPrecQtde) and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'Q'))) then // and  ((vSing.vTipoVenda = 'REQ') or (vSing.vTipoVenda = 'OS'))) ) then
            vValorProdPermDesc := vValorProdPermDesc +
              (vItProd.dtSet.FieldByName('QUANT_PED_ITEM').AsFloat * vItProd.dtSet.FieldByName('VLUN_PED_ITEM').AsFloat);
      end;
      vItProd.dtSet.Next;
    end;

    descProd := 0;
    descServ := 0;
    acrescProd := 0;
    acrescServ := 0;
    if getDescontoSemValorNF > 0 then
    begin
      if (vValorTotalProd + vValorTotalServ) > 0 then
      begin
        descProd := (getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
          vValorProdPermDesc;
        descServ := (getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
          vValorTotalServ;
      end;
    end;
    if dataSet.FieldByName('acrescimo').AsCurrency > 0 then
    begin
      if (vValorTotalProd + vValorTotalServ) > 0 then
      begin
        acrescProd := (dataSet.FieldByName('acrescimo').AsCurrency / (vValorTotalProd + vValorTotalServ))
          * vValorTotalProd;
        acrescServ := (dataSet.FieldByName('acrescimo').AsCurrency / (vValorTotalProd + vValorTotalServ))
          * vValorTotalServ;
      end;
    end;

    vSing.vValorRateioDesconto  := 0;
    vSing.vValorRateioAcrescimo := 0;

    vSing.vValorDescontoIt      := 0;
    vSing.vValorAcrescimoIt     := 0;
    try
    	vItProd.dataSet.DisableControls;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        vItProd.vProduto.buscaProduto(
          vItProd.dataSet.FieldByName('grupo_prod').AsInteger,
          vItProd.dataSet.FieldByName('cod_prod').AsString);
        if (trim(vItProd.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
        begin
          vSing.vValorRateioDesconto  := Roundto(vSing.vValorRateioDesconto  + vItProd.dataSet.FieldByName('RATEIO_DESC').AsCurrency,-2);
          vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + vItProd.dataSet.FieldByName('RATEIO_ACRESC').AsCurrency,-2);

          vSing.vValorDescontoIt      := Roundto(vSing.vValorDescontoIt      + vItProd.dataSet.FieldByName('DESC_ITEM').AsFloat,-2);
          vSing.vValorAcrescimoIt     := Roundto(vSing.vValorAcrescimoIt     + vItProd.dataSet.FieldByName('ACRESC_ITEM').AsFloat,-2);
        end;

        vItProd.dataSet.Next;
      end;
    finally
      vItProd.dataSet.First;
      vItProd.dataSet.EnableControls;
    end;

    if vSing.vTipoVenda <> 'REQ' then
    begin
    	try
      	vItServ.dataSet.DisableControls;
        vItServ.dataSet.First;
        while not vItServ.dataSet.Eof do
        begin
          if (trim(vItProd.dataSet.FieldByName('STATUS').AsString) <> 'CANCELADO') then
          begin
            vSing.vValorRateioDesconto  := Roundto(vSing.vValorRateioDesconto  + vItServ.dataSet.FieldByName('rateio_desc').AsCurrency,-2);
            vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo + vItServ.dataSet.FieldByName('rateio_acresc').AsCurrency,-2);

            vSing.vValorDescontoIt      := Roundto(vSing.vValorDescontoIt      + vItServ.dataSet.FieldByName('DESC_ITEM').AsFloat,-2);
          	vSing.vValorAcrescimoIt     := Roundto(vSing.vValorAcrescimoIt     + vItServ.dataSet.FieldByName('ACRESC_ITEM').AsFloat,-2);
          end;
          vItServ.dataSet.Next;
        end;
      finally
      	vItServ.dataSet.First;
        vItServ.dataSet.EnableControls;
      end;
    end;

    pLabel.Caption := 'NUM ' + trim(vSing.vTipoVenda) + ': ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) + chr(13) + chr(13);

    pLabel.Caption := pLabel.Caption +
    								  'Valor bruto.............: ' + Format('%0.2m', [vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc]) + chr(13);

    if vSing.vTipoVenda = 'OS' then
    begin
    	if vSing.vValorDescontoProd > 0 then
	  		pLabel.Caption := pLabel.Caption +
                    	'Valor desconto produto..: ' + Format('%0.2m', [vSing.vValorDescontoProd]) + chr(13)
    	else
    		pLabel.Caption := pLabel.Caption +
                    	'Valor desconto produto..: ' + Format('%0.2m', [0.00]) + chr(13);

    	if vSing.vValorDescontoServ > 0 then
	  		pLabel.Caption := pLabel.Caption +
                    	'Valor desconto serviço..: ' + Format('%0.2m', [vSing.vValorDescontoServ]) + chr(13)
    	else
    		pLabel.Caption := pLabel.Caption +
                    	'Valor desconto serviço..: ' + Format('%0.2m', [0.00]) + chr(13);
    end;

    if vSing.vValorDesconto > 0 then
	  	pLabel.Caption := pLabel.Caption +
                    	'Valor desconto..........: ' + Format('%0.2m', [vSing.vValorDesconto]) + chr(13)
    else
    	pLabel.Caption := pLabel.Caption +
                    	'Valor desconto..........: ' + Format('%0.2m', [0.00]) + chr(13);

    if vSing.vValorAcrescimo > 0 then
    	pLabel.Caption := pLabel.Caption +
                    	'Valor acréscimo.........: ' + Format('%0.2m', [vSing.vValorAcrescimo]) + chr(13)
    else
    	pLabel.Caption := pLabel.Caption +
                    	'Valor acréscimo.........: ' + Format('%0.2m', [0.00]) + chr(13);

    pLabel.Caption := pLabel.Caption +
                      'Valor líquido...........: ' + Format('%0.2m', [RoundTo(dataSet.FieldByName('VALOR_TOTAL').AsFloat,-2)])+ chr(13)+chr(13);

    if vSing.vValorDescontoProd > 0 then
    	pLabel.Caption := pLabel.Caption +
                      'Desconto apurado de prod: ' + Format('%0.2f', [((vSing.vValorDescontoProd) / vValorTotalProd) * 100])+'%' + chr(13)
    else
      pLabel.Caption := pLabel.Caption +
                      'Desconto apurado de prod: ' + Format('%0.2f', [0.00]) + '%' + chr(13);

    if vSing.vTipoVenda = 'OS' then
    begin
      if vSing.vValorDescontoServ > 0 then
        pLabel.Caption := pLabel.Caption +
                      'Desconto apurado de serv: ' + Format('%0.2f', [((vSing.vValorDescontoServ) / vValorTotalServ) * 100])+'%' + chr(13)
      else
        pLabel.Caption := pLabel.Caption +
      						    'Desconto apurado de serv: ' + Format('%0.2f', [0.00]) + '%' + chr(13);
    end;
    
    if vSing.vValorDesconto > 0 then
    	pLabel.Caption := pLabel.Caption +
                  	vDadosIni.IfThen(vSing.vTipoVenda = 'REQ',
                    	'Desconto apurado na REQ.: ',
      						    'Desconto apurado na OS..: ') + Format('%0.2f', [((vSing.vValorDesconto) / (vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc)) * 100])+'%' + chr(13)
    else
    	pLabel.Caption := pLabel.Caption +
                    vDadosIni.IfThen(vSing.vTipoVenda = 'REQ',
                    	'Desconto apurado na REQ.: ',
      						    'Desconto apurado na OS..: ') + Format('%0.2f', [0.00]) + '%' + chr(13);


//    if vSing.vValorAcrescimo > 0 then
//      pLabel.Caption := pLabel.Caption +
//      						    'Acréscimo apurado de..: ' + Format('%0.2f', [((vSing.vValorAcrescimo) / (vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc)) * 100])+'%' + chr(13)
//    else
//      pLabel.Caption := pLabel.Caption +
//      						    'Acréscimo apurado de..: ' + Format('%0.2f', [0.00])+'%' + chr(13);

    pLabel.Visible:=true;
    vDadosIni.fechaStatusProcessamento;
  finally
    enableControlsDataSets;
  end;
end;

function TPedVenda._validaDescontoRegraVND(pTodas: boolean): boolean;
var
  vPercDescGeral: Currency;
  vcondicoesCliente: string;
  vtemp: string;
  vtemp2: string;
  buscas2: TIBQuery;
  I: Integer;

  function _existeCondPagPadrao(pTipo: string): boolean;
  var
    vSql: string;
  begin
    Result := False;

    if not vDadosIni.vCliente.vCondPagPorCliente then
      exit;

    vSql  := ' SELECT FIRST 1 COND_PAG.COD_COND_PAG, COND_PAG.DESC_COND_PAG, COND_PAG.SEQPRECO FROM COND_PAG ' +
    	' INNER JOIN COND_PAG_EMPRESA ON ' +
      ' 	COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
      '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' WHERE COND_PAG.NATUREZA_CP <> ''C'' ' +
      ' AND COND_PAG.ATIVO = 1 ';

    if trim(pTipo) = 'PRE' then
      vSql := vSql + ' AND COALESCE(COND_PAG.COND_PADRAO_CL_PREST, ''N'') = ''T'' '
    else
      vSql := vSql + ' AND COALESCE(COND_PAG.COND_PADRAO_CL_VND, ''N'') = ''T'' ';

    buscas2.Close;
    buscas2.SQL.Text := vSql;
    buscas2.Open;

    Result := buscas2.RecordCount > 0;
  end;

begin
	try
    result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    vcondicoesCliente := '';
    if (vDadosIni.vCliente.vCondPagPorCliente) then
    begin
      buscas2.Close;
      buscas2.SQL.Text := ' select nome_cliente, controles_fp, cond_pag_vnd, cond_pag_pre from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Open;

      vcondicoesCliente := Trim(buscas2.FieldByName(IfThen(vSing.vTipoVenda = 'PRE', 'cond_pag_pre', 'cond_pag_vnd')).AsString);

      if trim(vcondicoesCliente) <> '' then
        if ContainsStr(trim(vcondicoesCliente), ',')
          and (Copy(trim(vcondicoesCliente), 1, 1) = '(')
          and (Copy(trim(vcondicoesCliente), Length(trim(vcondicoesCliente)), 1) <> ')') then
        begin
          vtemp := '';
          vtemp2 := '';
          for I := 1 to Length(trim(vcondicoesCliente)) do
          begin
            vtemp := vtemp + trim(vcondicoesCliente[I]);
            if trim(vcondicoesCliente[I]) = ',' then
              vtemp2 := vtemp;
          end;
          vcondicoesCliente := Copy(vtemp2, 1, Length(vtemp2) - 1) + ')';
        end;

      if (vDadosIni.vCliente.vCondPagPorCliente)
        and ((trim(vcondicoesCliente) <> '') or (_existeCondPagPadrao(vSing.vTipoVenda)))  then
      begin
        buscas2.Close;
        buscas2.SQL.Text := '';
        if trim(vcondicoesCliente) <> '' then
        begin
          buscas2.SQL.Text := buscas2.SQL.Text + ' SELECT COND_PAG.COD_COND_PAG FROM COND_PAG ' +
            ' INNER JOIN COND_PAG_EMPRESA ON ' +
            ' 	COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
            '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
            ' WHERE COND_PAG.COD_COND_PAG IN ' + vcondicoesCliente +
            ' AND COND_PAG.ATIVO = 1 ' +
            ' UNION ';
        end;

        buscas2.SQL.Text := buscas2.SQL.Text +
          ' SELECT COND_PAG.COD_COND_PAG FROM COND_PAG ' +
          ' INNER JOIN COND_PAG_EMPRESA ON ' +
          ' 	COND_PAG_EMPRESA.COD_COND_PAG = COND_PAG.COD_COND_PAG ' +
          '   AND COND_PAG_EMPRESA.COD_EMPRESA = ' + vDadosIni.codEmpresa +
          ' WHERE COALESCE(COND_PAG.' + IfThen(vSing.vTipoVenda = 'PRE', 'COND_PADRAO_CL_PREST', 'COND_PADRAO_CL_VND') + ', ''N'') = ''T'' ' +
          ' AND COND_PAG.ATIVO = 1 ';
        buscas2.Open;

        if buscas2.RecordCount > 0 then
        begin
          vcondicoesCliente := '(';
          buscas2.First;
          while not buscas2.Eof do
          begin
            if buscas2.RecNo = 1 then
              vcondicoesCliente := vcondicoesCliente + IntToStr(buscas2.FieldByName('COD_COND_PAG').AsInteger)
            else
              vcondicoesCliente := vcondicoesCliente + ', ' + IntToStr(buscas2.FieldByName('COD_COND_PAG').AsInteger);

            buscas2.Next;
          end;
          vcondicoesCliente := vcondicoesCliente + ')';
        end;
      end;
    end;

    if vSing.vTipoVenda ='ORC' then
    begin
      if (FTipoRegraVND = 'REQ') or vSing.vOrcamentoSoPecas then
      begin
        if Trim(vDadosIni.vEmp.vTipoVendaPadrao) <> '' then
          FTipoVndOSRegraVND := Trim(vDadosIni.vEmp.vTipoVendaPadrao)
        else
          FTipoVndOSRegraVND := 'V';
      end
      else
      begin
        if dataSet.FieldByName('tipo_os').AsString = '' then
          FTipoVndOSRegraVND := retornaValor('select first 1 tipo_os AS VALOR from tipo_vendas ' +
            ' where tipo=''OS'' order by ordemexibicao')
        else
          FTipoVndOSRegraVND := dataSet.FieldByName('tipo_os').AsString;
      end;
    end;

    vRVnd.vOpPag.dataSet.AfterScroll := RegraOpPagAfterScroll;
    vRVnd.vOpPag.Close;
    vRVnd.vOpPag.dataSet.CommandText := ' select ' +
      ' c.codigo_ctrl, ' +
      ' c.docs, ' +
      ' cp.desc_cond_pag, ' +
      ' cp.cod_cond_pag, ' +
      ' rv.tipovnd_os, ' +
      ' coalesce(rv.valormindoc, 0) valormindoc, ' +
      ' coalesce(rv.valormaxdoc, 0) valormaxdoc, ' +
      ' coalesce(rv.parcelamin, 0) parcelamin, ' +
      ' coalesce(rv.parcelamax, 0) parcelamax, ' +
      ' case when (rv.max_desc is null) then ' +
      '				 100 ' +
      '			 else ' +
      ' 			 coalesce(rv.max_desc, 0) ' +
      '	end max_desc, ' +
      ' case when (rv.max_descprod is null) then ' +
      '				 100 ' +
      '			 else ' +
      '				 coalesce(rv.max_descprod, 0) ' +
      ' end max_descprod, ' +
      ' case when (rv.max_descserv is null) then ' +
      '				 100 ' +
      '			 else ' +
      ' 			 coalesce(rv.max_descserv, 0) ' +
      '	end max_descserv, ' +
      ' coalesce(rv.maxparcelas, 0) maxparcelas, ' +
      ' coalesce((select qtde_parc from retorna_qtde_cond_pag(cp.desc_cond_pag)), 0) qtde_parc, ' +
      ' coalesce(rv.prazomax, 0) prazomax, ' +
      ' coalesce((select dias_prazo from retorna_qtde_cond_pag(cp.desc_cond_pag)), 0) dias_prazo, ' +
      ' rv.cod_regravnd, ' +
      ' case ' +

      ' when ((c.docs = ''S2'') and (coalesce((select dias_prazo from retorna_qtde_cond_pag(cp.desc_cond_pag)), 0) > coalesce(rv.prazomax, 0))) then ''Barrado'' ' +

      ' when ((c.docs = ''S2'') and (coalesce((select qtde_parc from retorna_qtde_cond_pag(cp.desc_cond_pag)), 0) > coalesce(rv.maxparcelas, 0))) then ''Barrado'' ' +

      ' when (coalesce(rv.valormindoc, 0) > :pValorTotal) then ''Barrado'' ' +

      ' when (:pValorTotal > coalesce(rv.valormaxdoc, 0)) then ''Barrado'' ' +

      '	when ((:pMax_desc > 0) ' +
      '		and (rv.max_desc = 0)) then ''Barrado'' ' +

      '	when ((:pMax_descprod > 0) ' +
      '		and (rv.max_descprod = 0)) then ''Barrado'' ' +

      '	when ((:pMax_descserv > 0) ' +
      '		and (rv.max_descserv = 0)) then ''Barrado'' ' +

      '	when ((:pMax_desc > 0) ' +
      '   and (rv.max_desc > 0) ' +
      '		and (:pMax_desc > rv.max_desc)) then ''Barrado'' ' +

      '	when ((:pMax_descprod > 0) ' +
      '   and (rv.max_descprod > 0) ' +
      '		and (:pMax_descprod > rv.max_descprod)) then ''Barrado'' ' +

      '	when ((:pMax_descserv > 0) ' +
      '   and (rv.max_descserv > 0) ' +
      '		and (:pMax_descserv > rv.max_descserv)) then ''Barrado'' ' +

      ' when ((select count(*) from regras_vendas rv1 ' +
      '				 where rv1.cod_regravnd = rv.cod_regravnd ' +
      '				 and rv1.cod_empresa = rv.cod_empresa ' +
      '        and ((rv1.pessoafisica = :pPessoafisica) or (rv1.pessoafisica = ''A''))) <= 0) then ''Barrado'' ' +

      ' when ((select count(*) from regravnd_tipo rtp1 ' +
      '				 where rtp1.cod_regravnd = rv.cod_regravnd ' +
      '				 and rtp1.cod_empresa = rv.cod_empresa ' +
      '        and rtp1.tipo = :pTipo) <= 0) then ''Barrado'' ' +

      ' when ((select count(*) from regravnd_tipo_vendas rt1 ' +
      '				 inner join tipo_vendas tp1 on ' +
      ' 			   tp1.tipo = rt1.tipo ' +
      ' 				 and case when (tp1.tipo = ''REQ'') then tp1.sigla else tp1.tipo_os end = rt1.tipovnd_os ' +
      '			   where rt1.cod_regravnd = rv.cod_regravnd ' +
      '			   and rt1.cod_empresa = rv.cod_empresa ' +
      '        and rt1.tipo = :pTipo ' +
      '        and rt1.tipovnd_os = :pTipovnd_os ' +
      '				 and tp1.ativo = 1) <= 0) then ''Barrado'' ' +

      vDadosIni.IfThen(vRVnd.dataSet.FieldByName('CODIGO_CTRL').AsInteger > 0,
        ' when ((select count(*) from regravnd_controle rc1 ' +
        '        inner join controles ctrl1 on ' +
        '				 	 ctrl1.codigo_ctrl = rc1.codigo_ctrl ' +
        '					 and ctrl1.codigo_emp = rc1.cod_empresa ' +
        '			   where rc1.cod_regravnd = rv.cod_regravnd ' +
        '			   and rc1.cod_empresa = rv.cod_empresa ' +
        '			   and rc1.codigo_ctrl = :pCodigo_ctrl ' +
        '   		 and ctrl1.cxent = ''S'' ' +
        '				 and ctrl1.ativo = 1) <= 0) then ''Barrado'' ', '') +

      vDadosIni.IfThen(dataSet.FieldByName('COD_COND_PAG').AsInteger > 0,
        ' when ((select count(*) from regravnd_condpag rp1 ' +
        '				 inner join cond_pag cond1 on ' +
        '				   cond1.cod_cond_pag = rp1.cod_cond_pag ' +
        '			   where rp1.cod_regravnd = rv.cod_regravnd ' +
        '        and rp1.cod_empresa = rv.cod_empresa ' +
        '        and rp1.cod_cond_pag = :pCod_cond_pag ' +
        '				 and cond1.ativo = 1) <= 0) then ''Barrado'' ', '');

    vRVnd.vOpPag.dataSet.CommandText := vRVnd.vOpPag.dataSet.CommandText +
      ' else ''Liberado'' end as status, ' +
      ' rv.sobrepor_promocao, ' +
      ' rv.sobrepor_tabpreco, ' +
      ' rv.sobrepor_maxdescprod, ' +
      ' rv.vlvnd_mindesc, ' +
      ' c.nome_ctrl ' +
      ' from regras_vendas rv ' +

      vDadosIni.IfThen(pTodas, '',
        ' inner join regravnd_tipo rtp on ' +
        '		rtp.cod_regravnd = rv.cod_regravnd ' +
        '		and rtp.cod_empresa = rv.cod_empresa ') +

      vDadosIni.IfThen(pTodas, '',
        ' inner join regravnd_tipo_vendas rt on ' +
        '		rt.cod_regravnd = rv.cod_regravnd ' +
        '		and rt.cod_empresa = rv.cod_empresa ') +

      ' inner join regravnd_condpag rc on ' +
      '		rc.cod_regravnd = rv.cod_regravnd ' +
      '		and rc.cod_empresa = rv.cod_empresa ' +
      ' inner join cond_pag cp on ' +
      '		rc.cod_cond_pag = cp.cod_cond_pag ' +
      ' 	and cp.ativo = 1 ' +
      ' inner join regravnd_controle rctrl on ' +
      '		rctrl.cod_regravnd = rv.cod_regravnd ' +
      '		and rctrl.cod_empresa = rv.cod_empresa ' +
      ' inner join controles c on ' +
      '		c.codigo_ctrl = rctrl.codigo_ctrl ' +
      '		and c.codigo_emp = rctrl.cod_empresa ' +
      '   and c.cxent = ''S'' ' +
      '		and c.ativo = 1 ' +
      ' where rv.cod_empresa = :pCod_empresa ' +
      ' and rv.ativo = 1 ' +

      vDadosIni.IfThen((vDadosIni.vCliente.vCondPagPorCliente) and (trim(vcondicoesCliente) <> ''),
        ' and rc.cod_cond_pag in ' + vcondicoesCliente, '') +

      vDadosIni.IfThen(pTodas, '',
        ' and ((rv.pessoafisica = :pPessoafisica) or (rv.pessoafisica = ''A'')) ') +

      vDadosIni.IfThen(pTodas, '',
        ' and rtp.tipo = :pTipo ') +

      vDadosIni.IfThen(pTodas, '',
        ' and rt.tipo = :pTipo ' +
        ' and rt.tipovnd_os = :pTipovnd_os ') +

      ' and c.codigo_ctrl = :pCodigo_ctrl ' +
      ' and rv.cod_regravnd = :pCod_regravnd ' +
      ' order by status desc, 2 ';

    vRVnd.vOpPag.dataSet.Params.ParamByName('pCod_regravnd').AsInteger := vRVnd.dataSet.FieldByName('cod_regravnd').AsInteger;

    vRVnd.vOpPag.dataSet.Params.ParamByName('pCod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);

    vRVnd.vOpPag.dataSet.Params.ParamByName('pPessoafisica').AsString := trim(FTipoPessoaRegraVND);

    vRVnd.vOpPag.dataSet.Params.ParamByName('pTipovnd_os').AsString := trim(FTipoVndOSRegraVND);

    vRVnd.vOpPag.dataSet.Params.ParamByName('pTipo').AsString := trim(FTipoRegraVND);

    if vRVnd.dataSet.FieldByName('codigo_ctrl').AsInteger > 0 then
      vRVnd.vOpPag.dataSet.Params.ParamByName('pCodigo_ctrl').AsInteger := vRVnd.dataSet.FieldByName('codigo_ctrl').AsInteger;

    if dataSet.FieldByName('cod_cond_pag').AsInteger > 0 then
      vRVnd.vOpPag.dataSet.Params.ParamByName('pCod_cond_pag').AsInteger := dataSet.FieldByName('cod_cond_pag').AsInteger;

    vRVnd.vOpPag.dataSet.Params.ParamByName('pValorTotal').AsFloat := dataSet.FieldByName('valor_total').AsFloat;

    vRVnd.vOpPag.dataSet.Params.ParamByName('pMax_desc').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPerc, 5);

    vRVnd.vOpPag.dataSet.Params.ParamByName('pMax_descprod').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPercProd, 5);

    vRVnd.vOpPag.dataSet.Params.ParamByName('pMax_descserv').AsFloat := vDadosIni.StrToFloatFormat(FvlDescPercServ, 5);

    vRVnd.vOpPag.Open;

    vRVnd.vOpPag.dataSet.Filter := '';
    vRVnd.vOpPag.dataSet.Filtered := False;

    if not vRVnd.vOpPag.IsEmpty then
      result := True;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVenda.existeItensDuplicados: boolean;
var
  item: array of array[1..4] of string;
  i, qtde: integer;
begin
  try
    disableControlsDataSets;
    try
      SetLength(item, vItProd.dataSet.RecordCount);
      i := -1;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        inc(i);
        item[i, 1] := vItProd.dataSet.FieldByName('grupo_prod').AsString;
        item[i, 2] := vItProd.dataSet.FieldByName('cod_prod').AsString;
        item[i, 3] := vItProd.dataSet.FieldByName('codigo_nop').AsString;
        item[i, 4] := '0';
        vItProd.dataSet.Next;
      end;
      i := -1;
      qtde := 0;
      vItProd.dataSet.First;
      while not vItProd.dataSet.Eof do
      begin
        inc(i);
        if (item[i, 1] = vItProd.dataSet.FieldByName('grupo_prod').AsString) and
          (item[i, 2] = vItProd.dataSet.FieldByName('cod_prod').AsString) and
          (item[i, 3] = vItProd.dataSet.FieldByName('codigo_nop').AsString) then
        begin
          if item[i, 4] = '1' then
            raise exception.create('Produto Duplicado: Gr:' + item[i, 1] + ' Cod:' + item[i, 2] +
              ' CFOP:' + item[i, 3] + #13 + 'Corrija para prosseguir');
          item[i, 4] := '1';
        end;
        vItProd.dataSet.Next;
      end;
      //Verificando duplicidade de servicos
      if vSing.vTipoVenda <> 'REQ' then
      begin
        SetLength(item, vItServ.dataSet.RecordCount);
        i := -1;
        vItServ.dataSet.First;
        while not vItServ.dataSet.Eof do
        begin
          inc(i);
          item[i, 1] := vItServ.dataSet.FieldByName('cod_servico').AsString;
          item[i, 2] := vItServ.dataSet.FieldByName('codigo_nop').AsString;
          item[i, 3] := '0';
          vItServ.dataSet.Next;
        end;
        i := -1;
        qtde := 0;
        vItServ.dataSet.First;
        while not vItServ.dataSet.Eof do
        begin
          inc(i);
          if (item[i, 1] = vItServ.dataSet.FieldByName('cod_servico').AsString) and
            (item[i, 2] = vItServ.dataSet.FieldByName('codigo_nop').AsString) then
          begin
            if item[i, 3] = '1' then
              raise exception.create('Serviço Duplicado: Cod:' + item[i, 1] + ' CFOP:' + item[i, 2] +
                #13 + 'Corrija para prosseguir');
            item[i, 3] := '1';
          end;
          vItServ.dataSet.Next;
        end;
      end;
    except
      on e: exception do
      begin
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(vSing.vTipoVenda + ' ' + dataSet.FieldByName('nped').AsString + ' ' + e.Message);
      end;
    end;
  finally
    enableControlsDataSets;
  end;
end;

function TPedVenda.existeSegmento(codigoSeguimento: integer): boolean;
begin
  Result := ExecutaComandosSql('select codigo_esp from especie_veiculo' +
    ' where codigo_esp = ' + IntToStr(codigoSeguimento));
end;

function TPedVenda.existeTipoServico(codigoServico: integer): boolean;
begin
  Result := ExecutaComandosSql('select tp.cod_servico from tipo_servico tp' +
  	' inner join tipo_servico_empresa te on te.cod_servico = tp.cod_servico and te.cod_empresa = ' + vDadosIni.codEmpresa +
    ' where tp.cod_servico = ' + IntToStr(codigoServico));
end;

function TPedVenda.existeVendaVan: Boolean;
var
	vDescrTipoVenda: string;
  vNomeVendedor: string;
begin
	Result := True;

  if dataSet.FieldByName('NPED').AsInteger > 0 then
  	Exit;

  if dataSet.FieldByName('COD_VENDEDOR').AsInteger <= 0 then
  	Exit;

  if trim(dataSet.FieldByName('TIPV').AsString) = '' then
  	Exit;

	if dataSet.State <> dsInsert then
  	Exit;

  if (vSing.vTipoVenda <> 'REQ') then
  	Exit;

  buscas.Close;
  buscas.SQL.Text := ' select tv.cod_tipo, tv.tipo, tv.descricao from tipo_vendas tv ' +
  	' where tv.tipo = :tipo ' +
    ' and tv.sigla = :sigla ' +
    ' and tv.usar_conferencia_produto = ''S'' ';
  buscas.ParamByName('TIPO').AsString := vSing.vTipoVenda;
  buscas.ParamByName('SIGLA').AsString := dataSet.FieldByName('TIPV').AsString;
  buscas.Open;

  if buscas.IsEmpty then
  	Exit;

  vDescrTipoVenda := trim(buscas.FieldByName('DESCRICAO').AsString);

  buscas.Close;
  buscas.SQL.Text := ' select first 1 pd.nped, pd.tipo, pd.cod_empresa, pd.cod_vendedor, ' +
  	' pd.data_ped, pd.data_fech, pd.status_ped from pedvenda pd ' +
    ' where coalesce(pd.status_ped, '''') = '''' ' +
    ' and pd.tipo = :tipo ' +
    ' and pd.cod_empresa = :cod_empresa ' +
    ' and pd.tipv = :tipv ' +
    ' and pd.cod_vendedor = :cod_vendedor ';
  buscas.ParamByName('TIPO').AsString := vSing.vTipoVenda;
  buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.ParamByName('TIPV').AsString := dataSet.FieldByName('TIPV').AsString;
  buscas.ParamByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
  buscas.Open;

  if not buscas.IsEmpty then
  begin
  	Result := False;

    buscas.Close;
    buscas.SQL.Text := ' select col.cod_vendedor, col.cod_empresa, col.nome_vendedor from colaborador col ' +
      ' where col.cod_vendedor = :cod_vendedor ' +
      ' and col.cod_empresa = :cod_empresa ';
    buscas.ParamByName('COD_VENDEDOR').AsInteger := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  	buscas.Open;

    vNomeVendedor := trim(buscas.FieldByName('NOME_VENDEDOR').AsString);

    if not vDadosIni.PesqPros('VND284', 'PERMITIR', getTipoVenda, 'PEDVENDA',
			dataSet.FieldByName('NPED').AsString, buscas, true) then
		begin
      vDadosIni.vPesquisa := 'Já existe uma venda aberta com o tipo de venda ' + QuotedStr(trim(vDescrTipoVenda)) +
      	' para o vendedor ' + QuotedStr(vNomeVendedor);
			exit;
		end;

    Result := True;
  end;
end;

procedure TPedVenda.fichaVeiculoAparelho(veicAparelho: string);
var
  temp: string;
  I: Integer;
begin
  qrItFicha := TIBQuery(DtmPed.qrItFicha);

  if veicAparelho = 'V' then
  begin
    if not vDadosIni.PesqPros('VND070', 'VISUALIZAR', dataSet.FieldByName('TIPO').AsString + ' - PLACA: ' + dataset.FieldByName('PLACA').AsString, 'PEDVENDA',
    	dataset.FieldByName('NPED').AsString, buscas, true) then
      	Exit;

    DtmPed.dsFichaVeicApar.DataSet := DtmPed.qrFichaV;
    qrItFicha.DataSource := DtmPed.dsFichaVeicApar;
    qrficha := TIBQuery(DtmPed.qrFichaV);

    abreFichaVeiculoAparelho(
    	veicAparelho,
      dataSet.FieldByName('nped').AsInteger,
      dataSet.FieldByName('tipo').AsString,
      dataSet.FieldByName('chassi').AsString,
      dataSet.FieldByName('placa').AsString,
      dataSet.FieldByName('cod_veiculo').AsInteger,
      dataSet.FieldByName('cod_equip').AsInteger);

    if frmFichaVeicApar = nil then
    begin
      Application.CreateForm(TfrmFichaVeicApar, frmFichaVeicApar);

      if DtmPedVenda = nil then
        DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

      vDadosIni.AlterarDataSourceComponentes(frmFichaVeicApar, DtmPed);
    end;

    frmFichaVeicApar.ckOS.Checked  := False;
    frmFichaVeicApar.ckOrc.Checked := False;

    frmFichaVeicApar.veicAparelho := veicAparelho;
    frmFichaVeicApar.nped         := dataSet.FieldByName('nped').AsInteger;
    frmFichaVeicApar.tipo         := dataSet.FieldByName('tipo').AsString;
    frmFichaVeicApar.chassi       := dataSet.FieldByName('chassi').AsString;
    frmFichaVeicApar.placa        := dataSet.FieldByName('placa').AsString;
    frmFichaVeicApar.cod_veic     := dataSet.FieldByName('cod_veiculo').AsInteger;
    frmFichaVeicApar.cod_equip    := dataSet.FieldByName('cod_equip').AsInteger;
    frmFichaVeicApar.cadped       := Self;

    if Trim(dataSet.FieldByName('tipo').AsString) = 'OS' then
    	frmFichaVeicApar.ckOS.Checked  := True
    else
    	frmFichaVeicApar.ckOrc.Checked := True;

    frmFichaVeicApar.DBGrid1.DataSource.DataSet := qrficha;
    frmFichaVeicApar.Caption   := 'Ficha do Veículo';
    frmFichaVeicApar.showmodal;
  end
  else
  begin
    if not vDadosIni.PesqPros('VND071', 'VISUALIZAR', dataSet.FieldByName('TIPO').AsString + ' - EQUIPAMENTO: ' + dataset.FieldByName('COD_EQUIP').AsString, 'PEDVENDA',
    	dataset.FieldByName('NPED').AsString, buscas, true) then
      	Exit;

    DtmPed.dsFichaVeicApar.DataSet := DtmPed.qrFichaAp;
    qrItFicha.DataSource := DtmPed.dsFichaVeicApar;
    qrficha := TIBQuery(DtmPed.qrFichaAp);

    abreFichaVeiculoAparelho(
    	veicAparelho,
      dataSet.FieldByName('nped').AsInteger,
      dataSet.FieldByName('tipo').AsString,
      dataSet.FieldByName('chassi').AsString,
      dataSet.FieldByName('placa').AsString,
      dataSet.FieldByName('cod_veiculo').AsInteger,
      dataSet.FieldByName('cod_equip').AsInteger);

    if frmFichaVeicApar = nil then
    begin
      Application.CreateForm(TfrmFichaVeicApar, frmFichaVeicApar);

      if DtmPedVenda = nil then
        DtmPedVenda := TDtmPedVenda.Create(DtmPedVenda);

      vDadosIni.AlterarDataSourceComponentes(frmFichaVeicApar, DtmPed);
    end;

    frmFichaVeicApar.ckOS.Checked  := False;
    frmFichaVeicApar.ckOrc.Checked := False;

    frmFichaVeicApar.veicAparelho := veicAparelho;
    frmFichaVeicApar.nped         := dataSet.FieldByName('nped').AsInteger;
    frmFichaVeicApar.tipo         := dataSet.FieldByName('tipo').AsString;
    frmFichaVeicApar.chassi       := dataSet.FieldByName('chassi').AsString;
    frmFichaVeicApar.placa        := dataSet.FieldByName('placa').AsString;
    frmFichaVeicApar.cod_veic     := dataSet.FieldByName('cod_veiculo').AsInteger;
