procedure TPedVenda.set_campos_relFichaOS(nped, num_nf, cgc_emp, data_nf,
  nome_cliente, cpfcgc, endereco, cidade, bairro, fone_cliente,
  fone_trab, data_fech, horafechamento, aparelho_ped, desc_serv_ped, nome_vendedor, fone_vendedor, nome_emp,
  telefone_emp, email_emp: TQRLabel);
begin
  buscas.close;
  buscas.SQL.Text := 'select ped.nped, ped.data_ped,ped.num_nf,e.cgc_emp,ped.data_nf,c.nome_cliente, ' +
    'c.cpfcgc,c.endereco,c.num_end_cliente,c.cidade,uf.sigla_uf,c.bairro,c.fone_cliente,c.fone_trab, ' +
    'ped.data_fech,ped.hora_fech,ped.cod_equip,ped.aparelho_ped,s.cod_servico,s.desc_serv_ped, ' +
    'ped.cod_vendedor,col.nome_vendedor,col.fone_vendedor,e.nome_emp,e.telefone_emp,e.email_emp ' +
    'from equipamento eq inner join pedvenda ped ' +
    'on eq.cod_equip=ped.cod_equip and eq.cod_empresa=ped.cod_empresa ' +
    'inner join pedvenda_serv s ' +
    'on ped.nped=s.nped and ped.cod_empresa=s.cod_empresa ' +
    'inner join clientes c ' +
    'on ped.cod_cliente=c.cod_cliente and ped.cod_empresa=c.cod_empresa ' +
    'inner join estados uf ' +
    'on c.codigo_uf=uf.codigo_uf ' +
    'inner join colaborador col ' +
    'on col.cod_vendedor=s.cod_vendedor and col.cod_empresa=ped.cod_empresa ' +
    'inner join empresa e ' +
    'on ped.cod_empresa = e.cod_empresa ' +
    'where ped.cod_empresa=' + vDadosIni.codEmpresa +
    ' and ped.tipo=''OS'' and ped.nped=' + dataSet.FieldByName('NPED').AsString;
  buscas.Open;
  nped.Caption := 'Ficha da Ordem de Serviço Número: ' + trim(buscas.FieldByName('NPED').AsString);
  num_nf.caption := 'Nota Fiscal: ' + trim(buscas.FieldByName('num_nf').AsString);
  cgc_emp.Caption := 'CNPJ: ' + trim(buscas.FieldByName('cgc_emp').AsString);
  data_nf.Caption := 'Data: ' + trim(buscas.FieldByName('data_ped').AsString); //trim(buscas.FieldByName('data_nf').AsString);
  nome_cliente.Caption := 'Cliente: ' + trim(buscas.FieldByName('nome_cliente').AsString);
  cpfcgc.Caption := 'CPF/CNPJ: ' + trim(buscas.FieldByName('cpfcgc').AsString);
  endereco.Caption := 'Endereço: ' + trim(buscas.FieldByName('endereco').AsString) + ', ' +
    trim(buscas.FieldByName('num_end_cliente').AsString);
  cidade.Caption := 'Cidade: ' + trim(buscas.FieldByName('cidade').AsString) + ' - ' + trim(buscas.FieldByName('sigla_uf').AsString);
  bairro.Caption := 'Bairro: ' + trim(buscas.FieldByName('bairro').AsString);
  fone_cliente.Caption := 'Fone: ' + trim(buscas.FieldByName('fone_cliente').AsString);
  fone_trab.Caption := 'Fone Trab.: ' + trim(buscas.FieldByName('fone_trab').AsString);
  data_fech.Caption := 'Data: ' + trim(buscas.FieldByName('data_fech').AsString);
  horafechamento.Caption := 'Hora: ' + trim(buscas.FieldByName('hora_fech').Asstring);
  aparelho_ped.Caption := 'Objeto: ' + vDadosIni.StrZero(trim(buscas.FieldByName('cod_equip').AsString), 6) + '  -  ' +
    trim(buscas.FieldByName('aparelho_ped').AsString);
  desc_serv_ped.Caption := 'Problema: ' + vDadosIni.StrZero(trim(buscas.FieldByName('cod_servico').AsString), 6) + '  -  ' +
    trim(buscas.FieldByName('desc_serv_ped').AsString);
  nome_vendedor.Caption := 'Técnico: ' + vDadosIni.StrZero(trim(buscas.FieldByName('cod_vendedor').AsString), 6) + '  -  ' +
    trim(buscas.FieldByName('nome_vendedor').AsString);
  fone_vendedor.Caption := 'Tel.: ' + trim(buscas.FieldByName('fone_vendedor').AsString);
  nome_emp.Caption := trim(buscas.FieldByName('nome_emp').AsString);
  telefone_emp.Caption := 'Tel.: ' + trim(buscas.FieldByName('telefone_emp').AsString);
  email_emp.Caption := 'e-mail: ' + trim(buscas.FieldByName('email_emp').AsString);
  buscas.close;
end;

procedure TPedVenda.showFiscal;
begin
  try
    if getTipoVenda = 'ORC' then
      vDadosIni.vFiscalAtivo := 'N';
    if vDadosIni.vTerminalFiscal <> 'S' then
      vDadosIni.vFiscalAtivo := 'N';
    if vDadosIni.vFiscalAtivo = 'N' then
      exit;
    if comucFiscal = nil then
      comucFiscal := TComunic.Create;
    comucFiscal.showFiscal;
    if getTipoVenda = 'ORC' then
      vDadosIni.vFiscalAtivo := 'N';
  except
    Application.MessageBox('Sistema para emissão de cupom fiscal não pode ser aberto', 'Atenção', 0 + 64);
  end;
end;

