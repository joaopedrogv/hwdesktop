  procedure CabReq;
  var
    temp: string;
    vtemp: string;
    captionsItens: string;
    NomeImp, BairroImp, EnderecoImp, CEPImp, CidadeImp, CPFCGCImp, FoneImp,
      CondPagImp, VencImp, InscImp: string;
  begin
    if (DataSet.FieldByName('Cod_cliente').AsInteger = strtoint(vDadosIni.vCliente.vCodClientePadrao))
      and (vSing.vTipoVenda = 'ORC') and (trim(dataSet.FieldByName('NOME_CLI_ORC').AsString) <> '') then
    begin
      NomeImp     := '*' + Trim(dataSet.FieldByName('NOME_CLI_ORC').AsString);
      FoneImp     := Trim(dataSet.FieldByName('FONE_RECEB').AsString);
      BairroImp   := Trim(dataSet.FieldByName('BAIRRO_RECEB').AsString);
      EnderecoImp := Trim(dataSet.FieldByName('END_RECEB').AsString);
      CEPImp      := Trim(dataSet.FieldByName('CEP_RECEB').AsString);
      CidadeImp   := Trim(dataSet.FieldByName('CIDA_RECEB').AsString);
      CPFCGCImp   := Trim(dataSet.FieldByName('CPFCGC').AsString);
      InscImp     := '';
    end
    else if (DataSet.FieldByName('Cod_cliente').AsInteger = strtoint(vDadosIni.vCliente.vCodClientePadrao))
      and (vSing.vTipoVenda <> 'ORC') and (trim(dataSet.FieldByName('NOME_CLI_ORC').AsString) <> '') then
    begin
      NomeImp     := '*' + Trim(dataSet.FieldByName('NOME_CLI_ORC').AsString);
      FoneImp     := '';
      BairroImp   := Trim(dataSet.FieldByName('BAIRRO_AVL').AsString);
      EnderecoImp := Trim(dataSet.FieldByName('END_AVL').AsString);
      CEPImp      := Trim(dataSet.FieldByName('CEP_AVL').AsString);
      CidadeImp   := Trim(dataSet.FieldByName('CIDA_AVL').AsString) + '-' + Trim(dataSet.FieldByName('ESTA_AVL').AsString);
      CPFCGCImp   := Trim(dataSet.FieldByName('CPFCGC').AsString);
      InscImp     := '';
    end
    else
    begin
    {  if FDadosImpressao.vImpNomeFantasia then
        NomeImp := vCliente.DataSet.FieldByName('Cod_cliente').AsString + ' ' +
          trim(vCliente.DataSet.FieldByName('nome_cliente').AsString) + ' - ' +
          trim(vCliente.DataSet.FieldByName('RAZAO').AsString)
      else
        NomeImp := vCliente.DataSet.FieldByName('Cod_cliente').AsString + ' '
          + trim(vCliente.DataSet.FieldByName('RAZAO').AsString);
      FoneImp     := vCliente.DataSet.FieldByName('FONE_CLIENTE').AsString;
      BairroImp   := Trim(vCliente.DataSet.FieldByName('BAIRRO').AsString);
      EnderecoImp := Trim(copy(vCliente.DataSet.FieldByName('ENDERECO').AsString, 1, 27)) +
        vDadosIni.IfThen(Trim(vCliente.DataSet.FieldByName('NUM_END_CLIENTE').AsString) <> '',
          ', ' + trim(copy(vCliente.DataSet.FieldByName('NUM_END_CLIENTE').AsString, 1, 7)),'') +
        vDadosIni.IfThen(Trim(vCliente.DataSet.FieldByName('COMPLEMENTO').AsString) <> '',
          ', ' + trim(vCliente.DataSet.FieldByName('COMPLEMENTO').AsString), '');
      CEPImp      := Trim(vCliente.DataSet.FieldByName('CEP').AsString);
      vCliente.vEst.abreEstado(vCliente.DataSet.FieldByName('CODIGO_UF').AsInteger);
      CidadeImp   := Trim(vCliente.DataSet.FieldByName('CIDADE').AsString) + '/' + vCliente.vEst.DataSet.FieldByName('SIGLA_UF').AsString;
      CPFCGCImp   := Trim(vCliente.DataSet.FieldByName('CPFCGC').AsString);
      InscImp := vCliente.DataSet.FieldByName('INSC_EST').AsString}
      try
        AClienteEndAdic := vCliente.endAdic.cliente_ped;
        with AClienteEndAdic do
        begin
          if FDadosImpressao.vImpNomeFantasia then
            NomeImp     := Format('%d - %s - %s', [cod_cliente, nome_cliente, razao])
          else
            NomeImp     := Format('%d - %s', [cod_cliente, razao]);
          FoneImp     := telefone;
          BairroImp   := bairro;
          EnderecoImp := Copy(logradouro, 1, 27) +
                         IfThen(numero <> '', ', ' + Copy(numero, 1, 7)) +
                         IfThen(complemento <> '', ', ' + Copy(complemento, 1, 7));
          CEPImp      := cep;
          CidadeImp   := cidade + '/' + uf;
          CPFCGCImp   := cpfcgc;
          InscImp     := insc_est;
        end;
      finally
        if Assigned(AClienteEndAdic) then
          FreeAndNil(AClienteEndAdic);
      end
    end;

    CondPagImp := retornaValor(' select cond_pag.desc_cond_pag as valor from cond_pag ' +
    	' where cond_pag.cod_cond_pag = ' + IntToStr(dataSet.FieldByName('COD_COND_PAG').AsInteger));

    if trim(CondPagImp) = '' then
    begin
    	vCondPag.dataSet.Locate('COD_COND_PAG', dataSet.FieldByName('COD_COND_PAG').AsInteger, []);
      CondPagImp := trim(vCondPag.DataSet.FieldByName('DESC_COND_PAG').AsString);
  	end;

    if (vDadosIni.vEmp.vModoFaturamento = 'S') and (vSing.vTipoVenda <> 'ORC') then
      CondPagImp := 'Cond.Pag.: ' + Trim(CondPagImp) + ' / ' + Trim(DataSet.FieldByName('obs_cxl_rq').AsString)
    else
      CondPagImp := 'Cond.Pag.: ' + Trim(CondPagImp);

    if (vSing.vTipoVenda <> 'ORC') then
    begin
      VencImp := 'Venciment: ' + retornaValor('select min(fp.data_venc) as valor from formpagamento fp ' +
        ' where fp.nrequisicao= ' + DataSet.FieldByName('NPED').AsString +
        ' and tpdocs=' + quotedstr(trim(vSing.vTipoVenda)) +
        ' and fp.cod_empresa= ' + vDadosIni.codEmpresa +
        ' and fp.ativo=1');
    end
    else
      VencImp := 'Venciment:';

    RdpDav.Impf(linha,   1, copy('CLIENTE..: ' + NomeImp, 1, 88), [negrito, comp17]);
    RdpDav.Impf(linha,  90,      'Bairro...: ' + BairroImp      , [         comp17]);
    linha := linha + 1;
    RdpDav.Impf(linha,   1,      'ENDERECO : ' + EnderecoImp    , [         comp17]);
    RdpDav.Impf(linha,  90,        'Cep....: ' + copy(CEPImp, 1, 5) + '-' +
                                                 copy(CEPImp, 6, 3), [comp17]);
    RdpDav.Impf(linha, 110, 'Data Aber:' + FormatDateTime('dd/mm/yy', dataSet.FieldByName('data_ped').AsDateTime) + ' ' +
      vDadosIni.StrZero(dataSet.FieldByName('HORAABERTURA').AsInteger, 2) + ':' +
      vDadosIni.StrZero(dataSet.FieldByName('MINABERTURA').AsInteger, 2), [comp17]);

    linha := linha + 1;

    RdpDav.Impf(linha, 1, 'Cidade/UF: ' + CidadeImp, [comp17]);
    if Length(CondPagImp) >= 42 then
      RdpDav.Impf(linha, 48, Copy(CondPagImp, 1, 133 - 48 - Length(VencImp)) + ' ' + VencImp, [comp17])
    else
    begin
      RdpDav.Impf(linha, 48, CondPagImp, [comp17]);
      RdpDav.Impf(linha, 90, VencImp, [comp17]);
    end;
    linha := linha + 1;
    RdpDav.Impf(linha,  1, 'CGC/CPF..: ' + CPFCGCImp, [comp17]);
    RdpDav.Impf(linha, 48, 'Insc.....: ' + InscImp  , [comp17]);
    if trim(dataSet.FieldByName('STATUS_PED').asstring) = 'FECHADA' then
    begin
    	if (trim(DataSet.FieldByName('NOME_US_FECH').AsString) = '') or (not ped_vnd_imprimir_usuario_que_fechou) then
        RdpDav.Impf(linha, 90, 'Resp.....: ' + vColab.DataSet.FieldByName('NOME_VENDEDOR').AsString, [comp17])
      else
        RdpDav.Impf(linha, 90, 'Resp.....: ' +
          Copy(trim(vColab.DataSet.FieldByName('NOME_VENDEDOR').AsString), 1, 15) + ' / ' +
          Copy(trim(DataSet.FieldByName('NOME_US_FECH').AsString), 1, 15), [comp17]);
    end
    else
    	RdpDav.Impf(linha, 90, 'Resp.....: ' + vColab.DataSet.FieldByName('NOME_VENDEDOR').AsString, [comp17]);
    linha := linha + 1;
    RdpDav.Impf(linha,  1, 'Telef....: ' + FoneImp  , [comp17]);

    if vPesobruto = '' then
      vPesobruto := Format('%10.2n', [vItProd.getPesoBrutoProdutos]);
    RdpDav.Impf(linha, 48, 'Peso Br..: ' + vPesobruto, [comp17]);
    RdpDav.Impf(linha, 90, dataSet.FieldByName('nped').DisplayLabel + ': ' + // 'Num Venda: ' +
      vDadosIni.StrZero(dataSet.FieldByName('nped').AsInteger,
      7), [negrito,comp17]);
    if dataSet.FieldByName('cod_carga').AsInteger > 0 then
			RdpDav.Impf(linha, 110, dataSet.FieldByName('cod_carga').DisplayLabel + ': ' + // 'Num Venda: ' +
				vDadosIni.StrZero(dataSet.FieldByName('cod_carga').AsInteger,
				4), [comp17])
		else
		begin
			if trim(dataSet.FieldByName('STATUS_PED').asstring) = 'FECHADA' then
				RdpDav.Impf(linha, 110, 'Data Fech:' + FormatDateTime('dd/mm/yy', dataSet.FieldByName('data_fech').AsDateTime) + ' ' +
				vDadosIni.StrZero(dataSet.FieldByName('HORAFECHAMENTO').AsInteger, 2) + ':' +
				vDadosIni.StrZero(dataSet.FieldByName('MINFECHAMENTO').AsInteger, 2), [comp17])
		end;

    linha := linha + 1;
    if (vSing.vTipoVenda = 'OS') or (vSing.vTipoVenda = 'ORC') then
    begin
      if vDadosIni.vEmp.vUsarAparelho <> 'S' then
      begin
        if not vVeic.dataSet.Active then
        begin
          vVeic.abreVeiculo(dataSet.FieldByName('cod_veiculo').AsInteger);
          vVeic.IndexFieldNames := 'codigo';
          vVeic.FindNearest([dataSet.FieldByName('cod_veiculo').AsInteger]);
        end;

        if (TFrmCadPedVenda(FrmCadPed) <> nil)
        	and (buscaVeiculo(dataSet.FieldByName('PLACA').AsString, 1, TFrmCadPedVenda(FrmCadPed).Memo1)) then
        begin
          if (trim(dataSet.FieldByName('placa').AsString) = trim(vVeic.dataSet.FieldByName('placa').AsString))
          	or (trim(vDadosIni.retornaPlacaNovaAntiga(dataSet.FieldByName('placa').AsString)) = trim(vVeic.dataSet.FieldByName('placa').AsString))
            or (trim(dataSet.FieldByName('placa').AsString) = trim(vDadosIni.retornaPlacaNovaAntiga(vVeic.dataSet.FieldByName('placa').AsString))) then

          begin
            RdpDav.Impf(linha, 1, 'Modelo...: ' + vVeic.dataSet.FieldByName('DESCMODELO').AsString,
              [comp17]);
            RdpDav.Impf(linha, 48, 'Marca/Cor: ' + trim(vVeic.dataSet.FieldByName('MARCA_V').AsString) + ' / ' + trim(vVeic.dataSet.FieldByName('COR').AsString), [comp17]);
            RdpDav.Impf(linha, 90, 'Ano Fab..: ' + vDadosIni.StrZero(vVeic.dataSet.FieldByName('ANOFAB').AsString, 2), [comp17]);
						if vSing.vTipoVenda = 'OS' then
							if trim(dataSet.FieldByName('STATUS_PED').asstring) = '' then
								RdpDav.Impf(linha, 110, 'Status OS: ABERTA',[comp17])
							else
              	RdpDav.Impf(linha, 110, 'Status OS: ' + dataSet.FieldByName('STATUS_PED').asstring,[comp17]);
            linha := linha + 1;
            RdpDav.Impf(linha,  1, 'Placa....: ' + vVeic.dataSet.FieldByName('PLACA').AsString,[comp17]);
            if FDadosImpressao.vImpChassi then
              RdpDav.Impf(linha, 22, 'Chassi:' + vVeic.dataSet.FieldByName('chassi').AsString,[comp17]);
            RdpDav.Impf(linha, 48, 'Renavam.: ' + vVeic.dataSet.FieldByName('RENAVAM').AsString,[comp17]);
            RdpDav.Impf(linha, 90, 'Kilometros: ' + dataSet.FieldByName('KM_V').asstring,[comp17]);
          end
          else
          begin
            if vSing.vTipoVenda = 'OS' then
              if trim(dataSet.FieldByName('STATUS_PED').asstring) = '' then
                RdpDav.Impf(linha, 110, 'Status OS: ABERTA',[comp17])
              else
              	RdpDav.Impf(linha, 110, 'Status OS: ' + dataSet.FieldByName('STATUS_PED').asstring,[comp17]);
          end;
        end
        else
        begin
          if vSing.vTipoVenda = 'OS' then
            if trim(dataSet.FieldByName('STATUS_PED').asstring) = '' then
              RdpDav.Impf(linha, 90, 'Status OS: ABERTA',[comp17])
            else
            	RdpDav.Impf(linha, 90, 'Status OS: ' + dataSet.FieldByName('STATUS_PED').asstring,[comp17]);
        end;
      end
      else
      begin
        RdpDav.Impf(linha, 1, copy('OBJETO : ' + dataSet.FieldByName('APARELHO_PED').AsString,1,108), [comp17]);
        if (vSing.vTipoVenda = 'OS') then
          if (Length(trim(dataSet.FieldByName('APARELHO_PED').AsString))<81)  then
          begin
