              'Favor Verificar no cadastro');
        end
        else
        begin
          if Trim(buscas.FieldByName('consumo').AsString) = 'S' then
            raise exception.create('Produto não é para consumo. Tipos Vendas de consumo, ' + chr(13) +
              'Favor Verificar no cadastro');
        end;
      end;
    end;
    if venda.dataSet.FieldByName('TIPO').AsString <> 'ORC' then
    begin
      if dataSet.FieldByName('PREC_CUSM_PROD').AsCurrency <= 0 then
        raise exception.create('Produto com custo médio Zerado, ' + chr(13) +
          'Favor Verificar Custo deste produto no cadastro');
    end;
    Result := true;
    }
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TProdutoPed.buscaProduto(grupo: integer; codigo: string): boolean;
begin
  montaSelect('select p.*, ' +
  	' coalesce(est.estoque, 0) estoque_disponivel, ' +
 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
    ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
  	' where p.grupo_prod = ' + IntToStr(grupo) +
    ' and p.cod_prod = ' + QuotedStr(trim(codigo)) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and p.ativo = 1 ');// + ' and coalesce(consumo,'''') <> ''S''');
  Result := not dataSet.IsEmpty
end;

constructor TProdutoPed.create(AOwner: TPedVenda; pDtm: TDtmPedVenda);
begin
	FOwner := AOwner;

  DataSet := TClientDataSet(pDtm.cdsprod);
  transacao := TIBTransaction(pDtm.IBTransPedVenda);
  Buscas := TIBQuery(pDtm.qrBuscas);
  vBarra := TCodBarraPed.create(pDtm);
  vSim := TProdSimilarPed.create(FOwner, pDtm);
end;

destructor TProdutoPed.Destroy;
begin
  vBarra.Free;
  vBarra := nil;
  FreeAndNil(vSim);
  inherited;
end;

