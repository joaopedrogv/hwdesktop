function TPedVenda.abreFormParcelamentoContas(pProdServ: string; var pContas: RContas;
	pTotInd: string; pValorTot: Double; pCodFornecedor: Integer; pFornecedor: string; pAlter: boolean): Boolean;
var
  formulario: TfrmPadrao;
  I: Integer;
  buscas2: TIBQuery;
begin
  try
    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    if pValorTot <= 0 then
    begin
      Result := true;
      exit;
    end;

    try
      formulario := TfrmPadrao.Create(Application);
      formulario.Width := 620;
      formulario.Height := 500;
      formulario.Position := poScreenCenter;
      formulario.Caption := vDadosIni.IfThen(pProdServ = 'P', 'Produtos', 'Serviços') + ' de Terceiro - Contas a pagar';
      TFrmCadPedVenda(FrmCadPed).ListBox3.Clear;
      TFrmCadPedVenda(FrmCadPed).pnFaturaPd.Parent := formulario;
      formulario.AutoSize := True;
      formulario.AutoScroll := False;
      formulario.ShowHint := True;
      formulario.BorderIcons := [];

      TFrmCadPedVenda(FrmCadPed).DBText14.DataSource := nil;
      TFrmCadPedVenda(FrmCadPed).DBText14.DataField := '';

      TFrmCadPedVenda(FrmCadPed).DBText11.DataSource := nil;
      TFrmCadPedVenda(FrmCadPed).DBText11.DataField := '';

      if pProdServ = 'P' then
      begin
        TFrmCadPedVenda(FrmCadPed).DBText11.DataSource := DtmPed.dsProdTerceiro;
        TFrmCadPedVenda(FrmCadPed).DBText11.DataField := 'NOME_FORNECEDOR';

        TFrmCadPedVenda(FrmCadPed).DBText14.DataSource := DtmPed.dsProdTerceiro;
        TFrmCadPedVenda(FrmCadPed).DBText14.DataField := 'DESCRICAO';
      end
      else
      begin
        TFrmCadPedVenda(FrmCadPed).DBText11.DataSource := DtmPed.dsServTerceiro;
        TFrmCadPedVenda(FrmCadPed).DBText11.DataField := 'NOME_FORNECEDOR';

        TFrmCadPedVenda(FrmCadPed).DBText14.DataSource := DtmPed.dsServTerceiro;
        TFrmCadPedVenda(FrmCadPed).DBText14.DataField := 'DESCR_SERVT';
      end;

      TFrmCadPedVenda(FrmCadPed).Panel65.Visible := (pTotInd <> 'T');

      TFrmCadPedVenda(FrmCadPed).Edit14.Text := dataSet.FieldByName('NPED').AsString;
      TFrmCadPedVenda(FrmCadPed).EditHw3.AsValue := pValorTot;
      if not TFrmCadPedVenda(FrmCadPed).cdsDesp.IsEmpty then
        TFrmCadPedVenda(FrmCadPed).edcreditoQtdeParcelas.Value := TFrmCadPedVenda(FrmCadPed).cdsDesp.RecordCount
      else
       TFrmCadPedVenda(FrmCadPed).edcreditoQtdeParcelas.Value := 1;

      TFrmCadPedVenda(FrmCadPed).BitBtn66.Enabled := true;
      TFrmCadPedVenda(FrmCadPed).BitBtn67.Enabled := true;
      TFrmCadPedVenda(FrmCadPed).btGerar.Enabled := true;
      TFrmCadPedVenda(FrmCadPed).btApagarDesp.Enabled := true;

      if pAlter then
      begin
        TFrmCadPedVenda(FrmCadPed).ListBox3.Clear;
        TFrmCadPedVenda(FrmCadPed).Edit14.Enabled := False;
        TFrmCadPedVenda(FrmCadPed).EditHw3.Enabled := False;
        TFrmCadPedVenda(FrmCadPed).cdsDesp.EmptyDataSet;

        gerarContas(pProdServ, pContas, pAlter);
      end;

      result := (formulario.ShowModal = mrOk);
    finally
      if Result then
      begin
        try
          for I := 0 to (FContas.parcelas - 1) do
          begin
            buscas.Close;
            buscas.SQL.Text := 'INSERT INTO CONTAS_A_PAGAR (CODIGO_EMP, COD_FORN_NFE, NOME_FOR_CTP, N_CONTA_PLC,' +
               ' CODIGO_CTRL, TIPO_CTP, N_DOC_CTP, NPARCELA, QTDE_PARC, DATA_VENC_CTP, VALOR_CTP, DATA_ENT_CTP, VALOR_CTP_ORIG, VL_CONTABIL,' +
               ' NATL_CTP, HISTORICO_CTP, NUM_NOTA_NFE, COD_CONTRP, SERIE, N_DOC_CTP_ORIG, DTREFERENCIA, REF_FRETE, ' +
               ' COD_DESPESA, N_CHEQ_CTP, NOMINAL_CTP, NPED, TIPO_NPED)' +
               ' VALUES' +
               ' (:CODIGO_EMP, :COD_FORN_NFE, :NOME_FOR_CTP, :N_CONTA_PLC,' +
               ' :CODIGO_CTRL, :TIPO_CTP, :N_DOC_CTP, :NPARCELA, :QTDE_PARC, :DATA_VENC_CTP, :VALOR_CTP, :DATA_ENT_CTP, :VALOR_CTP_ORIG, :VL_CONTABIL,' +
               ' :NATL_CTP, :HISTORICO_CTP, :NUM_NOTA_NFE, :COD_CONTRP, :SERIE, :N_DOC_CTP_ORIG, :DTREFERENCIA, :REF_FRETE, ' +
               ' :COD_DESPESA, :N_CHEQ_CTP, :NOMINAL_CTP, :NPED, :TIPO_NPED)';
            buscas.ParamByName('COD_CONTRP').AsInteger := Gencodigo('CONTAS_A_PAGAR', DtmPed.SpIncCodigo, vDadosIni.codEmpresa); ;
            buscas.ParamByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
            buscas.ParamByName('TIPO_NPED').AsString := dataSet.FieldByName('TIPO').AsString;
            buscas.ParamByName('CODIGO_EMP').AsString := vDadosIni.codEmpresa;
            buscas.ParamByName('NUM_NOTA_NFE').Value := Null;
            buscas.ParamByName('SERIE').Value := Null;           
            buscas.ParamByName('COD_FORN_NFE').AsInteger := pCodFornecedor;
            buscas.ParamByName('NOME_FOR_CTP').AsString := copy(Trim(pFornecedor),1,35);
            buscas.ParamByName('N_CONTA_PLC').AsFloat := StrToFloat(vDadosIni.vPedVnd.gerarContasApagarNumConta);
            buscas.ParamByName('CODIGO_CTRL').AsInteger := 1; //FContas.Controle[I];
            buscas.ParamByName('TIPO_CTP').AsString := 'D';
            buscas.ParamByName('N_DOC_CTP').AsString := copy(FContas.numeroDocumento[I],1,20);
            buscas.ParamByName('NPARCELA').AsInteger := I + 1;
            buscas.ParamByName('QTDE_PARC').AsInteger := FContas.parcelas;
            buscas.ParamByName('DATA_VENC_CTP').AsDate := StrToDate(FContas.vencimentoDocumento[i]);
            buscas.ParamByName('VALOR_CTP').AsCurrency := FContas.valorDocumento[I];
            buscas.ParamByName('VL_CONTABIL').AsCurrency := FContas.valorDocumento[I];
            buscas.ParamByName('VALOR_CTP_ORIG').AsCurrency := pValorTot;
            buscas.ParamByName('DATA_ENT_CTP').AsDateTime := vDadosIni.diaFFinanceiro+1;
            buscas.ParamByName('NATL_CTP').AsString := 'C';
            buscas.ParamByName('HISTORICO_CTP').AsString := copy(FContas.historico[I],1,100);
            buscas.ParamByName('N_DOC_CTP_ORIG').AsString := dataSet.FieldByName('NPED').AsString;
            buscas.ParamByName('DTREFERENCIA').AsDate := StrToDate(FContas.dataReferencia[I]);
            buscas.ParamByName('REF_FRETE').AsString := 'N';
            buscas.ParamByName('N_CHEQ_CTP').AsString := Copy(trim(FContas.NCHQ[I]), 1, 10);
            buscas.ParamByName('NOMINAL_CTP').AsString := Copy(trim(FContas.NCHQNominal[I]), 1, 35);
            if pos('F', FContas.numeroDocumento[i]) > 0 then
              buscas.ParamByName('REF_FRETE').AsString := 'F';
            buscas.Prepare;
            buscas.ExecSQL;

            vDadosIni.GravaAuditoria('VND237', 'EDITAR', copy(FContas.numeroDocumento[I],1,20) + ' - ' + copy(FContas.historico[I],1,60), 'PEDVENDA',
              dataSet.FieldByName('NPED').AsString, buscas);
          end;
        except
          RollBackTransacao;
        end;
      end;
      TFrmCadPedVenda(FrmCadPed).DBEdit1.Enabled := TFrmCadPedVenda(FrmCadPed).cdsDesp.IsEmpty;
      TFrmCadPedVenda(FrmCadPed).pnFaturaPd.Parent := TFrmCadPedVenda(FrmCadPed).tsFaturasServTerc;
      if Assigned(formulario) then
        FreeAndNil(formulario);
    end;
  finally
  	if Assigned(buscas2) then
    	FreeAndNil(buscas2);
  end;
end;

function TPedVenda.abreFormStatusOS: Boolean;
var
  formulario: TfrmPadrao;
  vdtSetTemp: TClientDataSet;
  vdtsourceTemp: TDataSource;
begin
  try
  	result := false;

  	if isempty then
    	exit;

    if vSing.vTipoVenda = 'OS' then
    begin
      if not vDadosIni.PesqPros('VND118', 'VISUALIZAR', 'VISUALIZAR STATUS ' + vSing.vTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        exit;
    end
    else if vSing.vTipoVenda = 'ORC' then
    begin
      if not vDadosIni.PesqPros('VND120', 'VISUALIZAR', 'VISUALIZAR STATUS ' + vSing.vTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        exit;
    end
    else if vSing.vTipoVenda = 'REQ' then
    begin
      if not vDadosIni.PesqPros('VND123', 'VISUALIZAR', 'VISUALIZAR STATUS ' + vSing.vTipoVenda, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        exit;
    end
    else
      exit;
      
    vOcorr.abreOcorreciaPed(dataSet.FieldByName('NPED').AsInteger, dataSet.FieldByName('TIPO').AsString);

    try
      formulario := TfrmPadrao.Create(Application);

      vdtsourceTemp := TDataSource.Create(nil);

      vdtSetTemp := TClientDataSet.Create(nil);
      
      buscas.close;
      buscas.sql.text := 'select DESCRICAO,TIPO_OS from tipo_vendas where tipo = ''TMO'' order by ordemexibicao';
      buscas.open;

      vdtSetTemp.FieldDefs.Clear;
      vdtSetTemp.FieldDefs.Add('DESCRICAO', ftString, 20, false);
      vdtSetTemp.FieldDefs.Add('ST_TERM_SERV', ftFixedChar, 40, false);
      vdtSetTemp.CreateDataSet;
      vdtSetTemp.Open;
      while not buscas.eof do
      begin
        vdtSetTemp.Insert;
        vdtSetTemp.FieldByName('DESCRICAO').AsString := buscas.FieldByName('DESCRICAO').AsString;
        vdtSetTemp.FieldByName('ST_TERM_SERV').AsString := buscas.FieldByName('TIPO_OS').AsString;
        vdtSetTemp.post;
        buscas.Next;
      end;  

    	vdtsourceTemp.DataSet := vdtSetTemp;
      vdtSetTemp.Open;
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.ListSource := vdtsourceTemp;
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.ListField := 'DESCRICAO';
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.KeyField := 'ST_TERM_SERV';
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.DataField := 'ST_TERM_SERV';
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.DataSource := DtmPed.dsPedVenda;
      //    TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.KeyValue:='ST_TERM_SERV';
      //    TFrmCadPedVenda(FrmCadPed).DBComboBox10.DataSource:=DtmPedVenda.dsPedVenda;
      //    TFrmCadPedVenda(FrmCadPed).DBComboBox10.Enabled:=false;
    
      formulario.Width := 620;
      formulario.Height := 500;
      formulario.Position := poScreenCenter;
      if vSing.vTipoVenda = 'OS' then
        formulario.Caption := 'Ocorrências e Status da OS ' + dataSet.FieldByName('NPED').AsString
      else if vSing.vTipoVenda = 'ORC' then
        formulario.Caption := 'Ocorrências e Status do Orçamento ' + dataSet.FieldByName('NPED').AsString
      else if vSing.vTipoVenda = 'REQ' then
        formulario.Caption := 'Ocorrências e Status da Requisição ' + dataSet.FieldByName('NPED').AsString;

      TFrmCadPedVenda(FrmCadPed).pnStatusOS.Parent := formulario;
      TFrmCadPedVenda(FrmCadPed).DBLookupComboBox24.Enabled := false;
      formulario.AutoSize := True;
      formulario.AutoScroll := False;
      formulario.ShowHint := true;

  //    if vSing.vTipoVenda = 'OS' then
  //      TFrmCadPedVenda(FrmCadPed).SpeedButton22.Hint := 'Alterando Status OS - [VND117]'
  //    else if vSing.vTipoVenda = 'REQ' then
  //      TFrmCadPedVenda(FrmCadPed).SpeedButton22.Hint := 'Alterando Status Requisição - [VND124]'
  //    else
  //      TFrmCadPedVenda(FrmCadPed).SpeedButton22.Hint := 'Alterando Status Orçamento - [VND121]';

      result := (formulario.ShowModal = mrOk);

    finally
      if result then
      begin
        result := inherited post;
        if result then
          result := inherited apply;
        if Result then
          result := CommitaTransacao
        else
          RollBackTransacao;
        if Result then
        begin
          if vSing.vTipoVenda = 'OS' then
            vDadosIni.GravaAuditoria('VND117', 'ALTERAR', 'SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
          else if vSing.vTipoVenda = 'ORC' then
            vDadosIni.GravaAuditoria('VND121', 'ALTERAR', 'SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('VND124', 'ALTERAR', 'SUCESSO', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        end
        else
        begin
          if vSing.vTipoVenda = 'OS' then
            vDadosIni.GravaAuditoria('VND117', 'ALTERAR', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
          else if vSing.vTipoVenda = 'ORC' then
            vDadosIni.GravaAuditoria('VND121', 'ALTERAR', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas)
          else
            vDadosIni.GravaAuditoria('VND124', 'ALTERAR', 'FALHA', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
        end;
      end
      else if dataSet.State = dsEdit then
        cancel;

      TFrmCadPedVenda(FrmCadPed).pnStatusOS.Parent := TFrmCadPedVenda(FrmCadPed).tsOutros2;

      if Assigned(vdtSetTemp) then
        FreeAndNil(vdtSetTemp);

      if Assigned(vdtsourceTemp) then
        FreeAndNil(vdtsourceTemp);

      if Assigned(formulario) then
        FreeAndNil(formulario);
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TPedVenda.abreItemFicha(pNped: Integer; pTipo: string);
begin
	qrItFicha.Close;
  qrItFicha.SQL.Text :=
  	' SELECT OS.NPED AS N_OS, 2 ORDEM, OS.NITEM, ''SERVICOS'' TP, ' +
    ' OS.COD_SERVICO, ''      '' COD_PROD, OS.QUANT_SERV_PED, OS.DESC_SERV_PED, ' +
    ' OS.VALOR_UN_SERV, OS.VALOR_TOT_SERV, OS.PRC_INT_SERV, COR.NOME_VENDEDOR FROM PEDVENDA_SERV OS ' +
    ' INNER JOIN COLABORADOR COR ON OS.COD_VENDEDOR = COR.COD_VENDEDOR AND OS.COD_EMPRESA = COR.COD_EMPRESA ' +
    ' WHERE OS.NPED = :N_OS ' +
    ' AND OS.TIPO = :TIPO ' +
    ' AND OS.COD_EMPRESA = :COD_EMPRESA ' +
    ' AND OS.ATIVO = 1 ' +
    ' AND ((OS.STATUS <> ''CANCELADO'') OR (OS.STATUS is null)) ' +
    ' union ' +
    ' SELECT PR.NPED AS N_OS, 1 ORDEM, PR.NITEM, ''PRODUTOS'' TP, ' +
    ' PR.GRUPO_PROD, PR.COD_PROD, PR.QUANT_PED_ITEM, ' +
    ' PR.DESCR_PROD_PED, PR.VLUN_PED_ITEM, PR.VLTOT_PED_ITEM, CAST(''0.00'' AS DOUBLE PRECISION), ' +
    ' COR.NOME_VENDEDOR FROM PEDVENDA_PROD PR ' +
    ' INNER JOIN COLABORADOR COR ON PR.COD_VENDEDOR = COR.COD_VENDEDOR AND PR.COD_EMPRESA = COR.COD_EMPRESA ' +
    ' WHERE PR.NPED = :N_OS ' +
    ' AND PR.TIPO = :TIPO ' +
    ' AND PR.COD_EMPRESA = :COD_EMPRESA ' +
    ' AND PR.ATIVO = 1 ' +
    ' AND ((PR.STATUS <> ''CANCELADO'') OR (PR.STATUS IS NULL)) ' +
    ' union ' +
    ' SELECT PVST.NPED AS N_OS, 4 ORDEM, 0 ORDEM, ''SRVTERC '' TP, ' +
    ' CAST(0 AS INTEGER), ''      '' COD_PROD, CAST(''0.00'' AS DOUBLE PRECISION), ' +
    ' PVST.DESCR_SERVT, PVST.VL_SERVT, PVST.VL_SERVT, CAST(''0.00'' AS DOUBLE PRECISION), CAST('''' AS CHAR(35)) ' +
    ' FROM PEDVENDA_SERV_TERC PVST ' +
    ' WHERE PVST.NPED = :N_OS ' +
    ' AND PVST.TIPO = :TIPO ' +
    ' AND PVST.COD_EMPRESA = :COD_EMPRESA ' +
    ' AND PVST.ATIVO = 1 ' +
    ' union ' +
    ' SELECT PVPT.NPED AS N_OS, 3 ORDEM, 0 ORDEM, ''PRDTERC '' TP, ' +
    ' CAST(0 AS INTEGER), ''      '' COD_PROD, CAST(''0.00'' AS DOUBLE PRECISION), ' +
    ' PVPT.DESCRICAO, PVPT.VL_UNIT, PVPT.VL_TOTAL, CAST(''0.00'' AS DOUBLE PRECISION), CAST('''' AS CHAR(35)) ' +
    ' FROM PEDVENDA_PROD_TERC PVPT ' +
    ' WHERE PVPT.NPED = :N_OS ' +
    ' AND PVPT.TIPO = :TIPO ' +
    ' AND PVPT.COD_EMPRESA = :COD_EMPRESA ' +
    ' AND PVPT.ATIVO = 1 ' +
    ' ORDER BY 1, 2, 3 ';
  qrItFicha.ParamByName('N_OS').AsInteger := pNped;
  qrItFicha.ParamByName('TIPO').AsString := pTipo;
  qrItFicha.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
  qrItFicha.Open;
end;

procedure TPedVenda.abreItFichaAfterScroll(DataSet: TDataSet);
begin
	if dataSet.IsEmpty then
    abreItemFicha(-1, '')
  else
    abreItemFicha(dataSet.FieldByName('N_OS').AsInteger, dataSet.FieldByName('TIPO').AsString);
end;

function TPedVenda.abreNFSE_CANCELADAS: boolean;
begin
  Result := vNFSE_CANCELADAS.montaSelect('SELECT DISTINCT N.NUM_NFSE, N.COD_RPS, N.COD_EMPRESA, N.COD_CLIENTE, N.NOME_CLIENTE, '+
	'N.DATA_CANC, N.VALOR_NFSE, N.SERIE, N.SUB_SERIE, N.ATIVO, N.MOTIVO_CANCELAMENTO, N.EMISSAO_NFSE '+
	'FROM NFSE_CANCELADAS N WHERE N.COD_RPS = 0 AND N.COD_EMPRESA = ' + vDadosIni.codEmpresa);
end;

