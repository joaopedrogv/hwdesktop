        ' where cb.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cb.cod_barra = ' + QuotedStr(pCodBarra) +
        ' and cb.ativo = 1') then
        	raiseExceptionCreate('Código de barras não encontrado', 'EditFiscalCodBarraDev');

      if not ExecutaComandosSql('select num_fab_prod from produtos p ' +
        ' where p.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and p.num_fab_prod = ' + QuotedStr(pCodBarra) +
        ' and p.ativo = 1') then
        	raiseExceptionCreate('Produto não encontrado', 'EditFiscalCodBarraDev');
    end
    else
    begin
      vCodGrupoDev := buscas.FieldByName('GRUPO_PROD').AsInteger;
      vCodProdDev := trim(buscas.FieldByName('COD_PROD').AsString);
    end;

    if (nGradeSelecionada <= 0) then
      if (not GradeNoCodigo) and (ProdutoPossuiGrade(vCodGrupoDev, vCodProdDev)) then
        SelecionaGradeProd(vCodGrupoDev, vCodProdDev, pCodBarra);

    dtSet.Filtered := false;
    dtSet.Filter := ' GRUPO_PROD = ' + inttostr(vCodGrupoDev) +
      ' and COD_PROD = ' + QuotedStr(vCodProdDev) +
      ' and COD_GRADE = ' + inttostr(nGradeSelecionada) +
      ' and STATUS <> ''CANCELADO''';
    dtSet.Filtered := true;
    if dtSet.isEmpty then
    begin
      dtSet.Filtered := false;
      raiseExceptionCreate('Produto/Grade informado não encontrado no pedido de venda para ser devolvido.', 'EditFiscalCodBarraDev');
    end;

    result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
