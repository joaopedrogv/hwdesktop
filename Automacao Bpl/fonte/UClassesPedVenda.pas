    APedVenda.vItProd.buscas := TIBQuery(DtmPedVenda.qrbuscasVnd);
    APedVenda.transacao := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    APedVenda.vMovimentaEstoque.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);
    APedVenda.vMovimentaEstoqueEC.Transaction := TIBTransaction(DtmPedVenda.ibTransPedVnd);

    APedVenda.abrePedVenda(pNped);

