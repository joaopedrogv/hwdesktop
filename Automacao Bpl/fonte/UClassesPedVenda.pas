class function TPedVenda.cadTransfEstF: boolean;
begin
	if not vDadosIni._mdiAberto('pkPedidoVenda', 'TFrmCadPedVendaEST', 'NAME') then
    exit;

  try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Venda Produtos');
    vDadosIni.vtpVenda := 'REQ';

    if FrmCadPedVendaEST = nil then
      Application.CreateForm(TFrmCadPedVenda, FrmCadPedVendaEST);

    if not FrmCadPedVendaEST.Enabled then
      vDadosIni.vTipoForm := 2;

    FrmCadPedVendaEST.ShowModal;
  finally
  	vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPedVenda.calculaAcrescimoPeloPercentual: boolean;
var
  vrTemp: Currency;
begin
  Result := true;
  vrTemp := 0;
  if dataSet.State in [dsEdit, dsInsert] then
  begin
    if dataSet.FieldByName('acresc_p_serv').AsFloat > 0 then
    begin
      vrTemp := dataSet.FieldByName('acresc_p_serv').AsFloat * vValorTotalServ / 100;
      dataSet.FieldByName('acrescimo').AsCurrency := vrTemp;
    end;

    if dataSet.FieldByName('acresc_p_prod').AsCurrency > 0 then
    begin
      vrTemp := vrTemp + dataSet.FieldByName('acresc_p_prod').AsFloat * vValorTotalProd / 100;
      dataSet.FieldByName('acrescimo').AsCurrency := vrTemp;
    end;
  end;
end;

function TPedVenda.calculaAcrescimoPeloValor: boolean;
var
  vrTemp: Currency;
begin
  Result := true;
  vrTemp := 0;
  if dataSet.State in [dsEdit, dsInsert] then
  begin
    if dataSet.FieldByName('acrescimo').AsFloat > 0 then
    begin
      vrTemp := dataSet.FieldByName('acrescimo').AsFloat * vValorTotalProd / (vValorTotalProd
        + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc);
      dataSet.FieldByName('acresc_p_prod').AsCurrency := vrTemp;
      vrTemp := dataSet.FieldByName('acrescimo').AsFloat * vValorTotalServ / (vValorTotalProd +
        vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc);
      dataSet.FieldByName('acresc_p_serv').AsCurrency := vrTemp;
    end;
  end;
end;

function TPedVenda.calculaDescontoAcrescimo: boolean;
var
  vTemp, vValorDescontoParaServ, vValorDescontoParaProd,vValorDescItemProdServ: Currency;
  vTipoPessoa, str:string;
begin
  result := false;
  try
    disableControlsDataSets;
    try
      result := true;
      vSing.vRateioAcrescimoProd := 0;
      vSing.vRateioAcrescimoServ := 0;
      vSing.vRateioDescontoProd  := 0;
      vSing.vRateioDescontoServ  := 0;
      vSing.vValorAcrescimo := 0;
      vSing.vValorDesconto := 0;
      vSing.vValorAcrescimoProd := 0;
      vSing.vValorDescontoProd := 0;
      vSing.vValorAcrescimoServ := 0;
      vSing.vValorDescontoServ := 0;
      vValorDescItemProdServ:=0;
      vValorProdPermDesc := 0;
      vSing.vValorRateioAcrescimo := 0;
      vSing.vValorRateioDesconto := 0;
      vValorDescontoParaProd := 0;
      vValorDescontoParaServ := 0;
      FvlDescPercServ:=0;
      FVlProdPermDesc := 0; //total dos produtos com preço que permite desconto
      FVlProd  := 0; //total dos produtos que permite desconto
      FVlProdP := 0; //total dos produtos em promoção que permite desconto
      FVlProdT := 0; //total dos produtos do preço da "tabela praticada" que permite desconto
      FvlProdQ := 0; //total dos produtos do preço por quantidade que permite desconto
      if (vItProd.dtSet.IsEmpty) and (vItServ.dtSet.IsEmpty) then
        exit;

      if dataSet.FieldByName('acrescimo').AsCurrency < 0 then
        raiseExceptionCreate('Acréscimo não deve ser menor que zero', '');

      if dataSet.FieldByName('acresc_p_prod').AsCurrency < 0 then
        raiseExceptionCreate('Percentual de acréscimo não deve ser menor que zero', '');

      if dataSet.FieldByName('acresc_p_serv').AsCurrency < 0 then
        raiseExceptionCreate('Percentual de acréscimo não deve ser menor que zero', '');

      if dataSet.FieldByName('desconto').AsCurrency < 0 then
        raiseExceptionCreate('Desconto não deve ser menor que zero', '');

      if dataSet.FieldByName('desc_p_prod').AsFloat < 0 then
        raiseExceptionCreate('Percentual de desconto não deve ser menor que zero', '');

      if dataSet.FieldByName('desc_p_serv').AsCurrency < 0 then
        raiseExceptionCreate('Percentual de desconto não deve ser menor que zero', '');

      if vDadosIni.vEmp.vUsarPoliticasDesc then
        vTipoPessoa:=retornaValor('select case when (strlen(trim(cli.cpfcgc))<=11) then ''S'' else ''N'' end as valor '+
          ' from clientes cli where cli.cod_cliente='+ inttostr(dataSet.FieldByName('COD_CLIENTE').Asinteger)+
          ' and cli.cod_empresa='+vDadosIni.codEmpresa);

      vItProd.dtSet.First; //dataset temporário
      while not vItProd.dtSet.Eof do
      begin
        if trim(vItProd.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
        begin
          if ExecutaComandosSql('select grupo_prod, cod_prod from produtos ' +
          	' where grupo_prod = ' + IntToStr(vItProd.dtSet.FieldByName('grupo_prod').AsInteger) +
            ' and cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +// ' and coalesce(consumo,'''') <> ''S''' +
            ' and coalesce(PERMITIR_DESCONTO, '''') <> ''N'' and coalesce(EM_PROMOCAO, '''') <> ''S''')
            and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'P')
            and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'T')
            and (vItProd.dtSet.FieldByName('TABPRATICADA').AsString <> 'Q') then
          begin
            vValorProdPermDesc := vValorProdPermDesc + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
            FVlProdPermDesc := FVlProdPermDesc + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
            vValorDescontoParaProd := vValorDescontoParaProd + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;
          end
          else if ExecutaComandosSql('select grupo_prod, cod_prod from produtos ' +
          	' where grupo_prod = ' + IntToStr(vItProd.dtSet.FieldByName('grupo_prod').AsInteger) +
            ' and cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +// ' and coalesce(consumo,'''') <> ''S''' +
            ' and coalesce(PERMITIR_DESCONTO,'''') <> ''N'' and coalesce(EM_PROMOCAO, '''') <> ''S''')
            and (vDadosIni.strIn(vItProd.dtSet.FieldByName('TABPRATICADA').AsString, ['P', 'T', 'Q']))
            and (vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat > 0) then
          begin
          	vValorProdPermDesc := vValorProdPermDesc + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
            FVlProdPermDesc := FVlProdPermDesc + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
            if (vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat > vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat) then
              vValorDescontoParaProd := vValorDescontoParaProd + vItProd.dtSet.FieldByName('MAX_DESC_TAB').AsFloat
       	    else
        	    vValorDescontoParaProd := vValorDescontoParaProd + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;
          end
          else if vDadosIni.vEmp.vUsarPoliticasDesc then
          begin
            if ExecutaComandosSql('select grupo_prod, cod_prod from produtos ' +
            	' where grupo_prod = ' + IntToStr(vItProd.dtSet.FieldByName('grupo_prod').AsInteger) +
              ' and cod_prod = ' + QuotedStr(trim(vItProd.dtSet.FieldByName('cod_prod').AsString)) +
              ' and cod_empresa = ' + vDadosIni.codEmpresa + //' and coalesce(consumo,'''') <> ''S''' +
              ' and coalesce(PERMITIR_DESCONTO,'''')<>''N'' ') then
            begin
            	FVlProd    := FVlProd  + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat;
              if (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'P')  then
                FVlProdP := FVlProdP + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat
              else if (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'T') then
                FVlProdT := FVlProdT + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat
              else if (vItProd.dtSet.FieldByName('TABPRATICADA').AsString = 'Q') then
                FVlProdQ := FVlProdQ + vItProd.dtSet.FieldByName('VLTOT_PED_ITEM').AsFloat
              else
                vValorDescontoParaProd := vValorDescontoParaProd + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;
            end;
          end;
          vSing.vRateioAcrescimoProd := vSing.vRateioAcrescimoProd + vItProd.dtSet.FieldByName('RATEIO_ACRESC').AsFloat;
          vSing.vRateioDescontoProd  := vSing.vRateioDescontoProd  + vItProd.dtSet.FieldByName('RATEIO_DESC').AsFloat;

          vSing.vValorAcrescimo     := vSing.vValorAcrescimo + vItProd.dtSet.FieldByName('ACRESC_ITEM').AsFloat;
          vSing.vValorDesconto      := vSing.vValorDesconto + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;

          vSing.vValorAcrescimoProd := vSing.vValorAcrescimoProd + vItProd.dtSet.FieldByName('ACRESC_ITEM').AsFloat;
          vSing.vValorDescontoProd  := vSing.vValorDescontoProd + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;

          vValorDescItemProdServ    := vValorDescItemProdServ + vItProd.dtSet.FieldByName('DESC_ITEM').AsFloat;
        end;
        vItProd.dtSet.Next;
      end;

      vItServ.dtSet.First; //dataset temporário
      while not vItServ.dtSet.Eof do
      begin
        if trim(vItServ.dtSet.FieldByName('STATUS').AsString) <> 'CANCELADO' then
        begin
        	vSing.vRateioAcrescimoServ := vSing.vRateioAcrescimoServ + vItServ.dtSet.FieldByName('RATEIO_ACRESC').AsFloat;
          vSing.vRateioDescontoServ  := vSing.vRateioDescontoServ  + vItServ.dtSet.FieldByName('RATEIO_DESC').AsFloat;

          vSing.vValorAcrescimo := vSing.vValorAcrescimo + vItServ.dtSet.FieldByName('ACRESC_ITEM').AsFloat;
          vSing.vValorDesconto := vSing.vValorDesconto + vItServ.dtSet.FieldByName('DESC_ITEM').AsFloat;

          vSing.vValorAcrescimoServ := vSing.vValorAcrescimoServ + vItServ.dtSet.FieldByName('ACRESC_ITEM').AsFloat;
          vSing.vValorDescontoServ := vSing.vValorDescontoServ + vItServ.dtSet.FieldByName('DESC_ITEM').AsFloat;

          vValorDescItemProdServ := vValorDescItemProdServ + vItServ.dtSet.FieldByName('DESC_ITEM').AsFloat;
          vValorDescontoParaServ := vValorDescontoParaServ + vItServ.dtSet.FieldByName('DESC_ITEM').AsFloat;
        end;
        vItServ.dtSet.Next;
      end;

      calculaTotalItens;
      disableControlsDataSets;

      vSing.vValorRateioAcrescimo := Roundto((vSing.vValorAcrescimo +
      	dataSet.FieldByName('acrescimo').AsCurrency +
        (dataSet.FieldByName('acresc_p_prod').AsCurrency * vValorTotalProd) / 100), -2);

      vSing.vValorAcrescimo       := Roundto(vSing.vValorAcrescimo +
      	dataSet.FieldByName('acrescimo').AsCurrency +
        (dataSet.FieldByName('acresc_p_prod').AsCurrency * vValorTotalProd / 100), -2);

      vSing.vValorRateioAcrescimo := Roundto(vSing.vValorRateioAcrescimo +
        (dataSet.FieldByName('acresc_p_serv').AsCurrency * vValorTotalServ / 100), -2);

      vSing.vValorAcrescimo       := Roundto(vSing.vValorAcrescimo +
        (dataSet.FieldByName('acresc_p_serv').AsCurrency * vValorTotalServ / 100), -2);

      vSing.vValorRateioDesconto  := RoundTo((vSing.vValorDesconto +
      	dataSet.FieldByName('desconto').AsCurrency +
      	(dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc) / 100), -2);

      vSing.vValorDesconto        := RoundTo(vSing.vValorDesconto +
      	dataSet.FieldByName('desconto').AsCurrency +
      	(((dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc) / 100)), -2);

      vSing.vValorRateioDesconto  := RoundTo(vSing.vValorRateioDesconto +
      	(((dataSet.FieldByName('desc_p_serv').AsFloat * vValorTotalServ) / 100)), -2);

      vSing.vValorDesconto        := RoundTo(vSing.vValorDesconto +
      	(((dataSet.FieldByName('desc_p_serv').AsFloat * vValorTotalServ) / 100)), -2);

      vSing.vValorDescontoProd    := RoundTo(vSing.vValorDescontoProd +
      	dataSet.FieldByName('desconto').AsCurrency +
      	(((dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc) / 100)), -2);

      vSing.vValorDescontoServ    := RoundTo(vSing.vValorDescontoServ +
        dataSet.FieldByName('desconto').AsCurrency +
      	(((dataSet.FieldByName('desc_p_serv').AsFloat * vValorTotalServ) / 100)), -2);

      vValorDescontoParaProd      := RoundTo(vValorDescontoParaProd +
      	dataSet.FieldByName('desconto').AsCurrency +
      	(((dataSet.FieldByName('desc_p_prod').AsFloat * vValorProdPermDesc) / 100)), -2);

      vValorDescontoParaServ      := RoundTo(vValorDescontoParaServ +
      	dataSet.FieldByName('desconto').AsCurrency +
      	(((dataSet.FieldByName('desc_p_serv').AsCurrency * vValorTotalServ) / 100)), -2);

      //variáveis usadas na política de descontos
      if vDadosIni.vEmp.vUsarPoliticasDesc then
      begin
      	FvlDescPercProd := 0;
        FvlDescPercServ := 0;
        FVndMinParaDesc := vValorTotalProd + vValorTotalServ;

        if vSing.vValorDesconto > 0 then
        	FvlDescPerc     := ((vSing.vValorDesconto) / (vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc)) * 100
        else
        	FvlDescPerc     := 0;

        if vSing.vTipoVenda = 'REQ' then
        begin
        	FvlDescPercProd := FvlDescPerc;
          FvlDescPercServ := 0;
        end
        else
        begin
          if vSing.vValorDescontoProd > 0 then
            FvlDescPercProd := ((vSing.vValorDescontoProd) / (vValorTotalProd)) * 100
          else
            FvlDescPercProd := 0;

          if vSing.vValorDescontoServ > 0 then
            FvlDescPercServ := ((vSing.vValorDescontoServ) / (vValorTotalServ)) * 100
          else
            FvlDescPercServ := 0;
        end;
      end;

      if ((vValorTotalProd + vValorTotalServ) > 0) then
      begin
        if dataSet.State in [dsinsert, dsEdit] then
        if not vDadosIni.vEmp.vUsarPoliticasDesc then
        begin
          if (vValorProdPermDesc = 0) and (vValorTotalProd > 0) and (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
          begin
            dataSet.FieldByName('desc_p_prod').AsFloat := 0;
            if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit24')
            else
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit29');
          end;
          if (vValorProdPermDesc = 0) and (vValorTotalProd > 0) and (getDescontoSemValorNF > 0) and (vValorTotalServ = 0) then
          begin
            dataSet.FieldByName('desconto').AsCurrency       := ffloat('nf_dc_vicmdeson');
            dataSet.FieldByName('nf_dc_desconto').AsCurrency := 0;
            if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit21')
            else
              raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.' + chr(13) + 'Nenhum dos produtos permite desconto.'), 'dbedit31');
          end;

          if (vValorTotalServ > 0) then
          begin
            if (((dataSet.FieldByName('desc_p_serv').AsCurrency * vValorTotalServ) / 100) >= vValorTotalServ) then
              raiseExceptionCreate('Desconto percentual nos serviços maior que o permitido', 'dbedit30');
          end
          else if dataSet.FieldByName('desc_p_serv').AsCurrency > 0 then
            dataSet.FieldByName('desc_p_serv').AsCurrency := 0;

          if ((vValorProdPermDesc + vValorTotalServ) = 0) and ((vSing.vValorDesconto > 0) or (getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_prod').AsFloat > 0)) then
          begin
            if (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
            begin
              if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
                raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit24')
              else
                raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit29');
            end
            else if getDescontoSemValorNF > 0 then
              if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
                raiseExceptionCreate('Desconto nos produtos maior que o permitido', 'dbedit21')
              else
                raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit31');
          end
          else if ((vValorProdPermDesc + vValorTotalServ) > 0) and ((vSing.vValorDesconto > 0) or (getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_prod').AsFloat > 0)) then
          begin
            if ((((getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
              vValorProdPermDesc) + vValorDescontoParaProd - getDescontoSemValorNF) > vValorProdPermDesc) and (vValorProdPermDesc>0) then
              if (dataSet.FieldByName('desc_p_prod').AsFloat > 0) then
              begin
                if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
                  raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit24')
                else
                  raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit29');
              end
              else if getDescontoSemValorNF > 0 then
                if (vSing.vTipoVenda = 'REQ') or ((vSing.vTipoVenda = 'ORC') and (vSing.vOrcamentoSoPecas)) then
                  raiseExceptionCreate('Desconto nos produtos maior que o permitido', 'dbedit21')
                else
                  raiseExceptionCreate(Pchar('Desconto nos produtos maior que o permitido.'), 'dbedit31');
          end;

          if ((vValorProdPermDesc + vValorTotalServ) > 0) and ((getDescontoSemValorNF > 0) or (dataSet.FieldByName('desc_p_serv').AsCurrency > 0)) then
            if ((((getDescontoSemValorNF / (vValorProdPermDesc + vValorTotalServ)) *
              vValorTotalServ) + vValorDescontoParaServ - getDescontoSemValorNF) > vValorTotalServ) and (vValorTotalServ > 0) then
              raiseExceptionCreate(Pchar('Desconto nos serviços maior que o permitido.'), 'dbedit31');
        end;
      end
      else
      begin
        if dataSet.State in [dsEdit, dsInsert] then
        begin
          dataSet.FieldByName('desconto').AsCurrency := ffloat('nf_dc_vicmdeson');
          dataSet.FieldByName('desc_p_prod').AsFloat := 0;
          dataSet.FieldByName('desc_p_serv').AsCurrency := 0;
          dataSet.FieldByName('nf_dc_desconto').AsCurrency := 0;
          if (vSing.vTipoVenda = 'REQ') then
          begin
            dataSet.FieldByName('acrescimo').AsCurrency := 0;
            dataSet.FieldByName('acresc_p_prod').AsCurrency := 0;
            dataSet.FieldByName('acresc_p_serv').AsCurrency := 0;
          end;
        end;
      end;
//      if (vValorProdPermDesc > 0) or (vValorTotalServ>0) then
//      begin
//        vSing.vValorRateioDesconto := RoundTo( vSing.vValorRateioDesconto + dataSet.FieldByName('desconto').AsCurrency,-2);
//        vSing.vValorDesconto := RoundTo(vSing.vValorDesconto + dataSet.FieldByName('desconto').AsCurrency, -2);
//      end;
//      vSing.vValorRateioDesconto := RoundTo(vSing.vValorRateioDesconto + vValorDescontoParaServ, -2);
//      vSing.vValorDesconto := Roundto(vSing.vValorDesconto + vValorDescontoParaServ, -2);

//    calculaTotais;
      if dataSet.State in [dsinsert, dsEdit] then
        dataSet.FieldByName('valor_total').AsCurrency := {vDadosIni.StrToFloatFormat}RoundTo(vValorTotalProd + vValorTotalServ +
          vValorTotalProdTerc + vValorTotalServTerc + vSing.vValorRateioAcrescimo - vSing.vValorRateioDesconto, -2);
      vSing.vValorTotalLiq := dataSet.FieldByName('valor_total').AsCurrency;
      vSing.vValorTotalBruto := vValorTotalProd + vValorTotalServ + vValorTotalProdTerc + vValorTotalServTerc;

      Result := true;
    except
      on e: exception do
      begin
        Result := false;

        str := sLineBreak + sLineBreak +
               Format('Total dos produtos que permitem desconto: %n', [FVlProdPermDesc]) + sLineBreak +
               Format('Total dos produtos em promoção que permitem desconto: %n', [FVlProdP]) + sLineBreak +
               Format('Total dos produtos com tabela diferenciada que permitem desconto: %n', [FVlProdT]) + sLineBreak +
               Format('Total dos produtos com preço por quantidade que permitem desconto: %n', [FvlProdQ]);

        Application.MessageBox(pchar(e.Message + str), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;

  finally
    enableControlsDataSets;
  end;
end;

procedure TPedVenda.calcularComissaoPorVenda;
var
  vIncComissaoVnd: Double;
  vIncComissaoPart: Double;
begin
  try
    if vSing.vTipoVenda <> 'REQ' then
      exit;

    if not vDadosIni.vPedVnd.comissaoPorVenda then
      exit;

    vIncComissaoVnd := 0;
    vIncComissaoPart := 0;
    
    disableControlsDataSets;
    if not vItProd.dataSet.Active then
      vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);

    vItProd.dataSet.First;
    while not vItProd.dataSet.Eof do
    begin
      if vItProd.dataSet.FieldByName('status').AsString <> 'CANCELADO' then
      begin
        vIncComissaoVnd := vIncComissaoVnd + vItProd.dataSet.FieldByName('vl_comissao_vend').AsFloat;
        if (vDadosIni.vPedVnd.habPartipante) and (vItProd.dataSet.FieldByName('vl_comissao_vend1').AsInteger > 0) then
          vIncComissaoPart := vIncComissaoPart + vItProd.dataSet.FieldByName('vl_comissao_vend1').AsFloat;
      end;
      vItProd.dataSet.Next;
    end;
    vItProd.dataSet.First;

    if not (dataSet.State in [dsInsert, dsEdit]) then
      dataSet.Edit;
    dataSet.FieldByName('vl_comissao_vend').AsFloat := vIncComissaoVnd;
    if (vDadosIni.vPedVnd.habPartipante) and (vIncComissaoPart > 0) and (dataSet.FieldByName('cod_vendedor1').AsInteger > 0) then
    	dataSet.FieldByName('vl_comissao_vend1').AsFloat := vIncComissaoPart; 
  finally
     enableControlsDataSets;
  end;
end;

procedure TPedVenda.calculaTotais;
begin
  try
    disableControlsDataSets;
    if not vItProd.dataSet.Active then
    begin
    	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
      vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
    end;
    if vSing.vTipoVenda <> 'REQ' then
    begin
      if not vItServ.dataSet.Active then
        vItServ.abrePedVendaServ(dataSet.FieldByName('nped').AsInteger);
      if not vItProdTerc.dataSet.Active then
        vItProdTerc.abreProdTerceiro(dataSet.FieldByName('nped').AsInteger);
      if not vItServTerc.dataSet.Active then
        vItServTerc.abreServicoTerceiro(dataSet.FieldByName('nped').AsInteger);
    end;
    setValotTotalProdutos(vItProd.getValorItensBruto);
//  vItProd.CalculaValorTotalItens;
    setValotTotalServicos(vItServ.getValorServBruto);
//  vItServ.CalculaValorTotalItens;
    setValotTotalProdTerc(vItProdTerc.getValorItens);
    setValotTotalServTerc(vItServTerc.getValorItens);
    calculaDescontoAcrescimo;
    if dataSet.State in [dsinsert, dsEdit] then
    begin
      if (vSing.vValorRateioAcrescimo=0) and  (vSing.vValorRateioDesconto=0) then
        dataSet.FieldByName('valor_total').AsCurrency := vDadosIni.StrToFloatFormat(vValorTotalProd + vValorTotalServ +
        vValorTotalProdTerc + vValorTotalServTerc +
        {vSing.vValorRateioAcrescimo - vSing.vValorRateioDesconto +}
        vSing.vValorAcrescimoIt - vSing.vValorDescontoIt +
        vSing.vValorAcrescimoItServ - vSing.vValorDescontoItServ, 2)
      else
      	dataSet.FieldByName('valor_total').AsCurrency := vDadosIni.StrToFloatFormat(vValorTotalProd + vValorTotalServ +
        vValorTotalProdTerc + vValorTotalServTerc +
        vSing.vValorRateioAcrescimo - vSing.vValorRateioDesconto, 2);
    end;
    vSing.vValorTotalLiq := dataSet.FieldByName('valor_total').AsCurrency;
    vSing.vValorTotalBruto := vValorTotalProd + vValorTotalServ + vValorTotalProdTerc +
      vValorTotalServTerc;
    if (dataSet.FieldByName('SAVEAUTO').AsString = 'S')
    	and (dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
    	and (dataSet.FieldByName('NPED').AsInteger > 0)
      and (dataSet.State = dsEdit) then
    begin
      if outroUsuarioEditando then
        Exit;

      dataSet.Post;
      inherited Apply;
      CommitaTransacao;
      dataSet.Edit;
    end;
  finally
    enableControlsDataSets;
  end;
end;

procedure TPedVenda.calculaTotalItens;
begin
  if not vItProd.dataSet.Active then
  begin
  	vItProd.vListarImprimirItemVan := retornaVendaTipoVan;
    vItProd.abrePedVendaProd(dataSet.FieldByName('nped').AsInteger);
  end;
  if vSing.vTipoVenda <> 'REQ' then
  begin
    if not vItServ.dataSet.Active then
      vItServ.abrePedVendaServ(dataSet.FieldByName('nped').AsInteger);
    if not vItProdTerc.dataSet.Active then
      vItProdTerc.abreProdTerceiro(dataSet.FieldByName('nped').AsInteger);
    if not vItServTerc.dataSet.Active then
      vItServTerc.abreServicoTerceiro(dataSet.FieldByName('nped').AsInteger);
  end;
  setValotTotalProdutos(vItProd.getValorItensBruto);
  setValotTotalServicos(vItServ.getValorServBruto);
  setValotTotalProdTerc(vItProdTerc.getValorItens);
  setValotTotalServTerc(vItServTerc.getValorItens);
end;

function TPedVenda.cancelaNFSEXT(pMotivoCancelamento: string; pDataCancelamento: TDateTime): boolean;
begin
	try
  	Result := False;

		if not vDadosIni.PesqPros('VND176', 'CANCELA NFSE_EXT', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, True) then
      Exit;

    if not (Application.MessageBox(PChar('NFS-EXT ' + dataSet.FieldByName('NUM_NFEEXT').AsString +
    ' de ' + DateToStr(dataSet.FieldByName('DATA_NFEXT').AsDateTime) +
    ', o Cancelamento limpará os dados desta NFS das seguintes O.S.: ' + #13 + osVinculadasNFSE  + ', deseja continuar?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYes) then
			Exit;

    vDadosIni.vPesquisa := verificaCamposObrigatoriosBH(
    																										dataSet.FieldByName('NUM_NFEEXT').AsString,
                                                      	YearOf(dataSet.FieldByName('DATA_NFEXT').AsDateTime)
                                                        );
		if Trim(vDadosIni.vPesquisa) <> '' then
    	Exit;
      
    Result := insereNFSEXT(
    										   dataSet.FieldByName('NUM_NFEEXT').AsString,
                           YearOf(dataSet.FieldByName('DATA_NFEXT').AsDateTime),
                           pMotivoCancelamento,
                           pDataCancelamento
                           );
  except on E: Exception do
  begin
  	Result := False;
    registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;
  end;
end;

function TPedVenda.CancelarDAV: boolean;
var
  vnped, vnDav: integer;
  vtpped: string;
  vdtcanc: Tdate;
  A1,A2, M1,M2, D1,D2: Word;
  vStatusSeparacao: string;
  vvaletroca: string;
  vvaleregaste: string;
begin
  result := false;
  if isempty then
    exit;

  vnped := dataSet.FieldByName('NPED').AsInteger;

  dataSet.Refresh;

  if (fint('nped') <> vnped)
    and (not dataSet.Locate('NPED;TIPO', VarArrayOf([fint('NPED'), fstr('TIPO')]), [loCaseInsensitive])) then
  begin
    ShowAtencao('Falha ao selecionar registro. Tente novamente');
    Exit;
  end;

  vtpped := dataSet.FieldByName('TIPO').AsString;
  vnDav := dataSet.FieldByName('NPREVENDA').AsInteger;
  vvaletroca := dataSet.FieldByName('VALE_TROCA').AsString;
  vvaleregaste := IfThen(dataSet.FieldByName('VALOR_VALE_PRG').AsFloat > 0, 'S', 'N');
  vvaleregaste := retornaValeResgate(dataSet.FieldByName('NPED').AsInteger, dataSet.FieldByName('TIPO').AsString,
      vvaletroca, vvaleregaste);
      
  if trim(dataSet.FieldByName('STATUS_PED').AsString) = 'CANCELADO' then
  begin
    Application.MessageBox('Venda já está Cancelada.', 'Informação', MB_ICONINFORMATION + MB_OK);
    exit;
  end;

  if (Trim(dataSet.FieldByName('tipo').AsString) = 'REQ') then
  begin
    if (vDadosIni.vEmp.vUSAR_SEPARACAO_PED = 'S') then
    begin
      vStatusSeparacao := getStatusPedidoESeparacao(dataSet.FieldByName('nped').AsInteger);
      if vDadosIni.getCampoPipe(vStatusSeparacao,2) <> '' then
      begin
        Application.MessageBox('Pedido selecionado para cancelamento com registros de separação', 'Atenção', MB_ICONWARNING + MB_OK);
        if not vDadosIni.PesqPros('VND187', 'CANCELAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', IntToStr(dataSet.FieldByName('nped').AsInteger), buscas, true, True) then
          raiseExceptionCreate('Pedido não pode ser cancelado. Já esta em processo de separação com status: ' + vDadosIni.getCampoPipe(vStatusSeparacao,2), '' );
      end;
    end;

    if (UpperCase(vDadosIni.vEmp.vUsarConferenciaCegaSaida) = 'S2') then
      if existeConferencia(dataSet.FieldByName('NPED').AsInteger) then
      begin
        Application.MessageBox('Pedido selecionado para cancelamento com registros de Conferência Cega', 'Atenção', MB_ICONWARNING + MB_OK);
        if not vDadosIni.PesqPros('VND188', 'CANCELAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', IntToStr(dataSet.FieldByName('nped').AsInteger), buscas, true, True) then
          raiseExceptionCreate('Pedido não pode ser cancelado. Já esta em processo de Conferência', '' );
      end;
  end;

  if not vDadosIni.PesqPros('VND104', 'CANCELAR', dataSet.FieldByName('TIPO').AsString,
    'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
    exit;

  if Application.MessageBox(pchar('Tem certeza que deseja continuar o cancelamento deste DAV?'), 'Confirmação',
    MB_ICONQUESTION + MB_YESNO) = IDNO then
    exit;

  if vDadosIni.vEcommerce.vHabilitarEcommerce then
    if dataSet.FieldByName('ID_COMMERCE').AsInteger > 0 then
    begin
      if Application.MessageBox(pchar('Pedido realizado pelo E-Commerce, deseja cancelar assim mesmo?' + #13 + #13 +
      	'Caso informe sim o mesmo será cancelado automaticamento no E-Commerce.'), 'Atenção',
        MB_ICONWARNING + MB_YESNO + MB_DEFBUTTON2) = IDNO then
        exit;

      if not vDadosIni.PesqPros('VND250', 'CANCELAR', dataSet.FieldByName('TIPO').AsString,
        'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, true) then
        exit;
    end;  

  if trim(dataSet.FieldByName('STATUS_PED').AsString) = 'FECHADA' then
  begin
    decodedate(dataSet.FieldByName('DATA_FECH').AsDateTime, A1, M1, D1);
    decodedate(vDadosIni.getDataHoraBanco(buscas), A2, M2, D2);
    if not((A1=A2) and (M1=M2)) and ((trim(vtpped) = 'OS') or (vtpped = 'REQ')) then
      if not vDadosIni.PesqPros('VND164','CANCELAR', dataSet.FieldByName('TIPO').AsString,'PEDVENDA',
      	dataSet.FieldByName('NPED').AsString, buscas, true) then
          exit;
  end;
  if trim(dataSet.FieldByName('STATUS_PED').AsString) = 'FECHADA' then
  begin
//    if not verificarDevolucao('CANCELAR') then
//    begin
//      Result := false;
//      Exit;
//    end;

    if trim(vtpped) = 'OS' then
      Application.MessageBox('A OS precisa ser reaberta antes de ser cancelada.', 'Informação', MB_ICONINFORMATION + MB_OK)
    else if vtpped = 'REQ' then
      Application.MessageBox('A requisição precisa ser reaberta antes de ser cancelada.', 'Informação', MB_ICONINFORMATION + MB_OK);

    if reabrirVenda(False, true) then
    begin
      try
        // Atualizar Lembrete Agenda Oficina
        salvarAgendamento(true);
        atualizarLembreteAgenda(vnped, 'CANCELADA');
        //Grava histórico do veículo
        GravarHistEstMoto('CANCELADO');
        //Apagar Contas a pagar
        apagarContasPagar(vnped);
        vdtcanc := vDadosIni.getDataBanco(buscas);
        vDadosIni.abreStatusProcessamento('', 'Executando o cancelamento...');
        ExecutaComandosSqlExec('update pedvenda v set v.status_ped=''CANCELADO'',DATA_FECH = ' +
          QuotedStr(FormatDateTime('mm/dd/yyyy', vdtcanc)) +
          ' where v.nped=' + inttostr(vnped) +
          ' and v.tipo=' + QuotedStr(vtpped) +
          ' and v.cod_empresa=' + vDadosIni.codEmpresa + ' and v.ativo=1');
        ExecutaComandosSqlExec('update pedvenda_prod pp set pp.status=''CANCELADO''' +
          ' where pp.nped=' + inttostr(vnped) +
          ' and pp.tipo=' + QuotedStr(vtpped) +
          ' and pp.cod_empresa=' + vDadosIni.codEmpresa + ' and pp.ativo=1');
        ExecutaComandosSqlExec('update pedvenda_serv ps set ps.status=''CANCELADO''' +
          ' where ps.nped=' + inttostr(vnped) +
          ' and ps.tipo=' + QuotedStr(vtpped) +
          ' and ps.cod_empresa=' + vDadosIni.codEmpresa + ' and ps.ativo=1');

        // Atualizar pontos programa de fidelidade (requisição/ordem de serviço - tipo regaste/troca)
        if ((vvaletroca = 'S') or (vvaleregaste = 'S')) then
        begin
          if not vDadosIni.setarPontosProgFidelidade(vnped, vtpped, buscas, false, 0, '', false, true, vvaletroca = 'S', vvaleregaste = 'S') then
          begin
            RollBackTransacao;
            Result := false;
            exit;
          end;
        end;

        if (Trim(vtpped) = 'OS') or (Trim(vtpped) = 'REQ') then
        begin
          vDadosIni.informarSituacaoPedido( vnped, Trim(vtpped), 'PEDIDO', 'Nao Autorizado', '', buscas, False, False, False);            
          vDadosIni.informarSituacaoPedido( vnped, Trim(vtpped), 'SEPARACAO', 'Iniciado', '', buscas, False, False, True);
        end;

        if CommitaTransacao then
        begin
          result := true;
          if vnDav > 0 then  //No caso se usa DAV
						vMD5Func._gravaMD5_DAV(buscas, vnDav);
        end
        else
        begin
          Result := false;
          Application.MessageBox('Falha ao Cancelar DAV!', 'Informação', MB_ICONEXCLAMATION + MB_OK);
        end;
        vDadosIni.fechaStatusProcessamento;
      except
        on e: exception do
        begin
          vDadosIni.fechaStatusProcessamento;
          Result := false;
          Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
          registraErro(e.Message);
        end;
      end;
    end;
  end
  else if trim(dataSet.FieldByName('STATUS_PED').AsString) = '' then
  begin
    try
      if not verificarDevolucao('CANCELAR') then
      begin
        Result := false;
        Exit;
      end;

      // Atualizar Lembrete Agenda Oficina
      salvarAgendamento(true);
      atualizarLembreteAgenda(vnped, 'CANCELADA');
      //Grava histórico do veículo
      GravarHistEstMoto('CANCELADO');
      //Apagar contas a pagar
      apagarContasPagar(vnped);
      vdtcanc := vDadosIni.getDataBanco(buscas);
      vDadosIni.abreStatusProcessamento('', 'Executando o cancelamento...');
      ExecutaComandosSqlExec('update pedvenda v set v.status_ped=''CANCELADO'',DATA_FECH = ' +
        QuotedStr(FormatDateTime('mm/dd/yyyy', vdtcanc)) +
        ' where v.nped=' + inttostr(vnped) +
        ' and v.tipo=' + QuotedStr(vtpped) +
        ' and v.cod_empresa=' + vDadosIni.codEmpresa + ' and v.ativo=1');
      ExecutaComandosSqlExec('update pedvenda_prod pp set pp.status=''CANCELADO''' +
        ' where pp.nped=' + inttostr(vnped) +
        ' and pp.tipo=' + QuotedStr(vtpped) +
        ' and pp.cod_empresa=' + vDadosIni.codEmpresa + ' and pp.ativo=1');
      ExecutaComandosSqlExec('update pedvenda_serv ps set ps.status=''CANCELADO''' +
        ' where ps.nped=' + inttostr(vnped) +
        ' and ps.tipo=' + QuotedStr(vtpped) +
        ' and ps.cod_empresa=' + vDadosIni.codEmpresa + ' and ps.ativo=1');

      // Atualizar pontos programa de fidelidade (requisição/ordem de serviço - tipo regaste/troca)
      if ((vvaletroca = 'S') or (vvaleregaste = 'S')) then
      begin
        if not vDadosIni.setarPontosProgFidelidade(vnped, vtpped, buscas, false, 0, '', false, true, vvaletroca = 'S', vvaleregaste = 'S') then
        begin
          RollBackTransacao;
          Result := false;
          exit;
        end;
      end;

      if (Trim(vtpped) = 'OS') or (Trim(vtpped) = 'REQ') then
      begin
        vDadosIni.informarSituacaoPedido( vnped, Trim(vtpped), 'PEDIDO', 'Nao Autorizado', '', buscas, False, False, False);
        vDadosIni.informarSituacaoPedido( vnped, Trim(vtpped), 'SEPARACAO', 'Iniciado', '', buscas, False, False, True);
      end;

      if CommitaTransacao then
      begin
        result := true;
        if vnDav > 0 then
          vMD5Func._gravaMD5_DAV(buscas, vnDav);
      end
      else
      begin
        Result := false;
        Application.MessageBox('Falha ao Cancelar DAV!', 'Informação', MB_ICONEXCLAMATION + MB_OK);
      end;
      vDadosIni.fechaStatusProcessamento;
    except
      on e: exception do
      begin
        vDadosIni.fechaStatusProcessamento;
        Result := false;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
        registraErro(e.Message);
      end;
    end;
  end;
end;

