function TPedVendaProd._alterarValorOriginal: Boolean;
var
 vValor: Double;
 vTemp: string;
begin
  Result := False;
  vTemp := dataSet.FieldByName('VLO_UNITARIO').AsString;
  if InputQuery('Informe o valor original', 'Informe o valor original deste item.', vTemp) then
  begin
    if not TryStrToFloat(vTemp, vValor) then
    begin
      Application.MessageBox('Valor original do item inválido', 'Atenção', 0 + 64);
      Exit;
    end;
    if vValor < 0 then
    begin
      Application.MessageBox('Valor original do item inválido', 'Atenção', 0 + 64);
      Exit;
    end;
  end
  else
   exit;

  buscas.Close;
  buscas.SQL.Text := 'UPDATE PEDVENDA_PROD SET VLO_UNITARIO = :VLO_UNITARIO ' +
    ' WHERE NPED = :NPED AND TIPO = :TIPO AND GRUPO_PROD = :GRUPO_PROD AND COD_PROD = :COD_PROD ' +
    ' AND NITEM = :NITEM AND COD_EMPRESA = :COD_EMPRESA AND COD_GRADE = :COD_GRADE AND CODIGO_NOP = :CODIGO_NOP ';
  buscas.ParamByName('VLO_UNITARIO').AsFloat := vValor;
  buscas.ParamByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
  buscas.ParamByName('TIPO').AsString := dataSet.FieldByName('TIPO').AsString;
  buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
  buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
  buscas.ParamByName('NITEM').AsInteger := dataSet.FieldByName('NITEM').AsInteger;
  buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
  buscas.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
  buscas.ParamByName('CODIGO_NOP').AsFloat := dataSet.FieldByName('CODIGO_NOP').AsFloat;
  buscas.ExecSQL;

 if transacao.InTransaction then
   transacao.Commit;
  dataSet.RefreshRecord;
  Result := true;
end;

function TPedVendaProd._atribuirComissaoMinVend(
	pTipo: string; pTipoREQ: string; pTipoOS: string; pTipoORC: string; pCodCondPag: Integer): Boolean;
var
	ConfigImp: TConfig_sistema_class;
	MontarPacelamentoStr: TMontarPacelamentoStr;
  vParcelas: TStringList;
  vStringListTiposReqOs: TStringList;
  vStringListGrupoReqOs: TStringList;
  vExisteTpVnd: Boolean;
  vComissaoCond: Double;
  vComissaoMinVend: Double;
  vFatorConvCond: Double;
  vComissaoGrupo: Double;
  vDescrCondPag: string;
  I: Integer;
begin
	Result := True;

  if not vDadosIni.vPedVnd.AcrescCondPagComissaoVend then
    exit;

  try
  	ConfigImp := TConfig_sistema_class.getConf('ped_vnd_acresc_condpag_comissao_vend', buscas, vDadosIni.cod_empresa);

  	vStringListTiposReqOs := TStringList.Create;
    vStringListGrupoReqOs := TStringList.Create;

    if trim(pTipo) = 'REQ' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoREQ')), ',')
    else if trim(pTipo) = 'OS' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoOS')), ',')
    else if trim(pTipo) = 'ORC' then
      vStringListTiposReqOs := vDadosIni.Split(UpperCase(ConfigImp.ReadString('Configuracao', 'TipoORC')), ',');

    for I := 0 to vStringListTiposReqOs.Count - 1 do
    begin
      if (trim(pTipo) = 'REQ')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(pTipoREQ))) then
      begin
        vExisteTpVnd := True;
        Break;
      end
      else if (trim(pTipo) = 'OS')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(pTipoOS))) then
      begin
        vExisteTpVnd := True;
        Break;
      end
      else if (trim(pTipo) = 'ORC')
        and ((trim(vStringListTiposReqOs[I]) = 'TODOS')
          or (trim(vStringListTiposReqOs[I]) = trim(pTipoORC))) then
      begin
        vExisteTpVnd := True;
        Break;
      end;
    end;

    if not vExisteTpVnd then
      Exit;

    try
      vFatorConvCond := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'FatorPrazoPag')));
    except
      vFatorConvCond := 0;
    end;

    try
      vComissaoMinVend := StrToFloat(trim(ConfigImp.ReadString('Configuracao', 'ComissaoMinVendedor')));
    except
      vComissaoMinVend := 0;
    end;

    SqlOpen(' select pc.conteudo_flag, pc.perc_peso from perfil_vendedor pv ' +
      ' inner join perfil_comissao pc on pv.codigo_perfil = pc.codigo_perfil ' +
      ' where pv.ativo = 1 ' +
      ' and pv.cod_vendedor = ' + IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger) +
      ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pc.tipo_perfil = ''Venda Geral'' ' +
      ' and pc.tipo_serv_prod = ''Produto'' ' +
      ' and pc.flag_serv_prod = ''Grupo Produto'' ', buscas);

    vComissaoGrupo := 0;
    vStringListGrupoReqOs.Text := trim(buscas.FieldByName('conteudo_flag').AsString);

    for I := 0 to vStringListGrupoReqOs.Count - 1 do
      if trim(vStringListGrupoReqOs[I]) = IntToStr(dataSet.FieldByName('GRUPO_PROD').AsInteger) then
      begin
        vComissaoGrupo := buscas.FieldByName('perc_peso').AsFloat;
        Break;
      end;

    if vComissaoGrupo > 0 then
    	vPercComissaoVnd3 := vComissaoGrupo
    else
    	vPercComissaoVnd3 := vComissaoMinVend;

    @MontarPacelamentoStr := GetProcAddress(vDadosIni.vCadBasicos.AHandle, PChar('MontarPacelamentoStr'));
    if Assigned(MontarPacelamentoStr) then
    begin
    	try
        vParcelas := TStringList.Create;

        // Comissao Cond Pag
        vValorAcrescCondPag := 0;
        if vFatorConvCond > 0 then
        begin
          SqlOpen(' select cond_pag.desc_cond_pag from cond_pag ' +
            ' where cond_pag.cod_cond_pag = ' + IntToStr(pCodCondPag), buscas);
          vDescrCondPag := trim(buscas.FieldByName('desc_cond_pag').AsString);

          vParcelas.Text := MontarPacelamentoStr(
            pCodCondPag,
            vDescrCondPag,
            1000,
            '00000',
            '',
            '',
            '',
            '',
            0,
            0,
            0,
            0,
            True);

          vComissaoCond := 0;
          for I := 0 to vParcelas.Count - 1 do
            vComissaoCond := vComissaoCond + StrToDate(vDadosIni.getCampoPipe(trim(vParcelas[I]), 3)) - vDadosIni.getDataBanco(buscas);
          if vParcelas.Count > 1 then
            vComissaoCond := vComissaoCond / vParcelas.Count;

          // Acrescimo em percentual
          vValorAcrescCondPag := vValorAcrescCondPag + (vFatorConvCond * vComissaoCond);
        end;
      finally
        FreeAndNil(vParcelas);
      end;
    end;

  finally
  	if Assigned(ConfigImp) then
      FreeAndNil(ConfigImp);
    if Assigned(vParcelas) then
    	FreeAndNil(vParcelas);
    if Assigned(vStringListTiposReqOs) then
    	FreeAndNil(vStringListTiposReqOs);
    if Assigned(vStringListGrupoReqOs) then
      FreeAndNil(vStringListGrupoReqOs);
  end;
end;

function TPedVendaProd._atualizarValorNFUnitario: boolean;
begin
	Result := True;
	if (dataSet.FieldByName('QUANT_PED_ITEM_CONV').AsFloat > 0)
  	and (dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat > 0)
    and (trim(dataSet.FieldByName('UNIDADE').AsString) <> '')
    and (trim(dataSet.FieldByName('UNIDADE_CONV').AsString) <> '')
    and (trim(dataSet.FieldByName('OPERACAO_CONV').AsString) <> '')
    and (dataSet.FieldByName('FATOR_CONV').AsFloat > 0)
    and (UpperCase(trim(dataSet.FieldByName('UNIDADE_CONV').AsString)) <> UpperCase(trim(dataSet.FieldByName('UNIDADE').AsString))) then
  begin
  	if dataSet.FieldByName('OPERACAO_CONV').AsString = 'M' then
    begin
    	dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
        dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat *
        dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

    	dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
        dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat *
        dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
    end
    else if dataSet.FieldByName('OPERACAO_CONV').AsString = 'D' then
    begin
    	dataSet.FieldByName('VLUN_PED_NF').AsFloat := RoundTo(
        dataSet.FieldByName('VLUN_PED_NF_CONV').AsFloat /
        dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));

    	dataSet.FieldByName('VLUN_PED_ITEM').AsFloat := RoundTo(
        dataSet.FieldByName('VLUN_PED_ITEM_CONV').AsFloat /
        dataSet.FieldByName('FATOR_CONV').AsFloat, - StrToInt(vSing.vCasasDecimais));
    end;
  end;
end;

