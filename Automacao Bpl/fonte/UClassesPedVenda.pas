procedure TPedVenda.arredondar;
begin
  //  if vEmp.dataSet.FieldByName('ARREDOND').AsString = 'S' then
  if vDadosIni.vEmp.vArredondVlVenda = 'S' then
  begin
    if (dataSet.FieldByName('VALOR_TOTAL').AsCurrency >
      trunc(dataSet.FieldByName('VALOR_TOTAL').AsCurrency)) and
      (dataSet.FieldByName('VALOR_TOTAL').AsCurrency <
      (trunc(dataSet.FieldByName('VALOR_TOTAL').AsCurrency) + 1)) then
    begin
      if Application.MessageBox(pchar('Deseja arredondar Valor?'), 'Confirmção', MB_ICONQUESTION +
        MB_YESNO) = IDYES then
      begin
        if dataSet.State = dsBrowse then
          dataSet.Edit;

        if f_str('nf_ac_calctrib') = 'S' then
        begin
          dataSet.FieldByName('NF_DC_DESCONTO').AsCurrency := ffloat('NF_DC_DESCONTO') + (ffloat('VALOR_TOTAL') - Trunc(ffloat('VALOR_TOTAL')));
          dataSet.FieldByName('DESCONTO').AsCurrency       := ffloat('NF_DC_DESCONTO') + ffloat('NF_DC_VICMDESON');
        end
        else
        dataSet.FieldByName('DESCONTO').AsCurrency := dataSet.FieldByName('DESCONTO').AsCurrency +
          (dataSet.FieldByName('VALOR_TOTAL').AsCurrency -
          trunc(dataSet.FieldByName('VALOR_TOTAL').AsCurrency));
        dataSet.FieldByName('VALOR_TOTAL').AsCurrency :=
          trunc(dataSet.FieldByName('VALOR_TOTAL').AsCurrency);
        calculaDescontoAcrescimo;
        //        calculaDescontoPeloValor;
      end;
    end;
  end;
end;

