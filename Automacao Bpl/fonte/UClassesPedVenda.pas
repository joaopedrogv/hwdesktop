        if (pTipo = 'REQ') and (not vItServ.dtSetIt.IsEmpty) then
          Application.MessageBox(pchar('Os Itens de Serviços selecionados não serão mesclados para Requisição de Venda.'), 'Atenção', MB_ICONINFORMATION + MB_OK);

        if not vItProd.dtSetIt.IsEmpty then
