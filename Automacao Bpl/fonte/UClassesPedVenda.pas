{ TPedVendaServTerc }

function TPedVendaServTerc.abreServicoTerceiro(nPed: integer): boolean;
var
	I: Integer;
begin
	try
    dataset.close;
  except
  end;
  result := montaSelect(' SELECT * FROM PEDVENDA_SERV_TERC ' +
  	' WHERE NPED = ' + inttostr(nPed) +
    ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and ATIVO = 1 ' +
    ' ORDER BY SEQID ');

  dataSet.First;
  dtSet.open;
  dtSet.EmptyDataSet;
  while not DataSet.Eof do
  begin
    dtSet.Insert;
    dtSet.FieldByName('NPED').AsInteger := DataSet.FieldByName('NPED').AsInteger;
    dtSet.FieldByName('TIPO').AsString := DataSet.FieldByName('TIPO').AsString;
    dtSet.FieldByName('DESCR_SERVT').AsString := DataSet.FieldByName('DESCR_SERVT').AsString;
    dtSet.FieldByName('COD_EMPRESA').AsInteger := DataSet.FieldByName('COD_EMPRESA').AsInteger;
    dtSet.FieldByName('VL_SERVT').AsFloat := DataSet.FieldByName('VL_SERVT').AsFloat;
    dtSet.FieldByName('ATIVO').AsInteger := DataSet.FieldByName('ATIVO').AsInteger;
    dtSet.FieldByName('VLUN_ORIG').AsFloat := DataSet.FieldByName('VLUN_ORIG').AsFloat;
    dtSet.FieldByName('VLCUSTO').AsFloat := DataSet.FieldByName('VLCUSTO').AsFloat;
    dtSet.FieldByName('COD_FORNECEDOR').AsInteger := DataSet.FieldByName('COD_FORNECEDOR').AsInteger;
    dtSet.FieldByName('NOME_FORNECEDOR').AsString := DataSet.FieldByName('NOME_FORNECEDOR').AsString;
    dtSet.Post;

    DataSet.Next;
  end;
  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;

  defineCamposDtSetTemp;
  if Assigned(dtSetTemp) then
  begin
  	vSeqId := 0;
    
    dtSetTemp.Close;
    dtSetTemp.CommandText := ' SELECT * FROM PEDVENDA_SERV_TERC ' +
      ' WHERE NPED = ' + inttostr(nPed) +
      ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
      ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
      ' and ATIVO = 1 ' +
      ' ORDER BY SEQID ';
    dtSetTemp.Open;
    dtSetTemp.EmptyDataSet;

    dataSet.First;
    while not dataSet.Eof do
    begin
      dtSetTemp.Insert;
      for I := 0 to dataSet.Fields.Count - 1 do
        dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
      dtSetTemp.Post;
      vSeqId := dataSet.FieldByName('SEQID').AsInteger;

      dataSet.Next;
    end;
    dataSet.First;
  end;
end;

function TPedVendaServTerc.abreServicoTerceiro(nPed: integer; pTipo: string;
  pMesclar: boolean): boolean;
var
  i: integer;
begin
  try
    dataset.close;
  except
  end;
  result := montaSelect(' SELECT * FROM PEDVENDA_SERV_TERC ' +
  	' WHERE NPED = ' + inttostr(nPed) +
    ' and TIPO = ' + QuotedStr(vSing.vTipoVenda) +
    ' and COD_EMPRESA = ' + vDadosIni.codEmpresa +
    ' and ATIVO = 1 ' +
    ' ORDER BY SEQID ');

  if not dtSetIt.Active then
    dtSetIt.open;
  //  if pEmptyDataSet then
  //    dtSetIt.EmptyDataSet;
  DataSet.First;
  while not DataSet.Eof do
  begin
    if not dtSetIt.Locate('NPED;TIPO;DESCR_SERVT;COD_EMPRESA',
    	VarArrayOf([dataset.FieldByName('NPED').AsInteger,
                  trim(dataset.FieldByName('TIPO').AsString),
                  trim(dataset.FieldByName('DESCR_SERVT').AsString),
                  dataset.FieldByName('COD_EMPRESA').AsInteger]), [loCaseInsensitive]) then
    begin
      dtSetIt.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
        dtSetIt.FieldByName(dataSet.Fields[I].FieldName).Value :=
          dataSet.Fields[I].Value;

      dtSetIt.Post;
    end;
    DataSet.Next;
  end;
  if DataSet.ControlsDisabled then
    DataSet.EnableControls;
  DataSet.First;
end;

procedure TPedVendaServTerc.atualizarDtSetTemp(acao: string; pAtualizarSeqId: boolean = false);
var
  I: Integer;
begin
	if dtSetTemp = nil then
  	exit;

	if acao = 'EXCLUIR' then
  begin
    try
      dtSetTemp.Filter := ' nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
        ' and tipo = ' + QuotedStr(trim(dataSet.FieldByName('tipo').AsString)) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and descr_servt = ' + QuotedStr(dataSet.FieldByName('descr_servt').AsString);
      dtSetTemp.Filtered := true;

      if not dtSetTemp.IsEmpty then
        dtSetTemp.Delete;
    finally
      dtSetTemp.Filtered := false;
    end;
  end
	else if (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'N') or (pAtualizarSeqId) then
  begin
    if acao = 'EDITAR' then
    begin
      try
        dtSetTemp.Filter := ' nped = ' + IntToStr(dataSet.FieldByName('nped').AsInteger) +
          ' and tipo = ' + QuotedStr(trim(dataSet.FieldByName('tipo').AsString)) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and descr_servt = ' + QuotedStr(vDadosIni.IfThen(pAtualizarSeqId,
          	dataSet.FieldByName('descr_servt').AsString, descricaoTemp));
        dtSetTemp.Filtered := true;

        if not dtSetTemp.IsEmpty then
          dtSetTemp.Edit
        else
          dtSetTemp.Insert;
        for i := 0 to dataSet.Fields.Count - 1 do
        	dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
        dtSetTemp.Post;
      finally
        dtSetTemp.Filtered := false;
      end;
    end
    else if acao = 'INSERIR' then
    begin
      dtSetTemp.Insert;
      for i := 0 to dataSet.Fields.Count - 1 do
    		dtSetTemp.FieldByName(dataSet.Fields[I].FieldName).Value := dataSet.Fields[I].Value;
      dtSetTemp.Post;
    end;
  end;
end;

procedure TPedVendaServTerc.CalculaValorTotalItens;
begin
  vTotalServ := 0;
  nItem := 0;
  if vSing.vTipoVenda = 'REQ' then
    exit;
  dataSet.First;
  while not dataSet.Eof do
  begin
    vTotalServ := vTotalServ + dataSet.FieldByName('VL_SERVT').AsCurrency;
    inc(nItem);
    dataSet.Next;
  end;
end;

function TPedVendaServTerc.cancel: boolean;
var
  vRecNoItem: Integer;
  vTemp: string;
begin
  Result := false;
  if dataSet.State in [dsInsert, dsedit] then
  begin
    dataSet.Cancel;
    Result := true;
  end
  else if dataSet.State = dsBrowse then
  begin
    if dataSet.IsEmpty then
    begin
      Result := false;
      exit;
    end;
    vTemp := 'Deseja apagar o serviço de terceiro?';
    if FOwner.CancelarVariosItens then
    	vTemp := 'Deseja apagar os serviços de terceiro selecionados?';    
    if Application.MessageBox(pchar(vTemp), 'Confirmação',
      MB_ICONQUESTION + MB_YESNO) = IDYES then
    begin
       try
         if FOwner.CancelarVariosItens then
         begin
           dataSet.Filtered := false;
           dataSet.Filter := ' SEL =''S'' ';
           dataSet.Filtered := true;

           if dataSet.IsEmpty then
           begin
              Application.MessageBox(pchar('Nenhum item selecionado, favor selecionar'), 'Atenção', MB_ICONINFORMATION + MB_OK);
              Exit;
           end;
           dataSet.First;
         end;

         if not FOwner.CancelarVariosItens then
         begin
           atualizarDtSetTemp('EXCLUIR');
           delete;
         end
         else
         begin
         	 while not dataSet.Eof do
           begin
           	 atualizarDtSetTemp('EXCLUIR');
             delete;
           end;
         end;
       finally
          if FOwner.CancelarVariosItens then
          begin
            dataSet.Filtered := false;
            dataSet.Filter := '';
//            dataSet.IndexFieldNames := 'NITEM';
          end;
       end;
      Result := true;

      if (Result)
      	and (FOwner.dataSet.FieldByName('SAVEAUTO').AsString = 'S')
        and (FOwner.dataSet.FieldByName('STATUS_PED').AsString <> 'CANCELADO')
        and (FOwner.dataSet.FieldByName('NPED').AsInteger > 0) then
      begin
        vRecNoItem := dataSet.RecNo;
        Result := Apply;
        if Result then
          if FOwner.setCalculoPendente then // dentro deste metodo ja tem um commit
            abreServicoTerceiro(FOwner.dataSet.FieldByName('nped').AsInteger);
//        if not FOwner.CancelarVariosItens then
         if not dataSet.IsEmpty then
           dataSet.RecNo := vRecNoItem;
      end;
    end;
  end;
end;

constructor TPedVendaServTerc.create(AOwner: TPedVenda; pDtm: TDtmPedVenda);
begin
	FOwner := AOwner;

  DataSet := TClientDataSet(pDtm.cdsServTerceiro);
  transacao := TIBTransaction(pDtm.IBTransPedVenda);
  Buscas := TIBQuery(pDtm.qrBuscas);
  dataSet.BeforePost := pedVendaServTercBeforePost;
  TFloatField(dataSet.FieldByName('VL_SERVT')).currency := false;

  dtSet.Free;
  dtSet := nil;
  dtSet := TClientDataSet(pDtm.cdsItemServTercTemp);
  if dtSet.active then
    dtSet.close;
  DtSet.CreateDataSet;

  try
    fTempDespesas := TClientDataSet.Create(nil);
    fTempDespesas.Close;
    fTempDespesas.FieldDefs.Clear;
    fTempDespesas.FieldDefs.Add('COD_FORNECEDOR', ftInteger, 0, false);
    fTempDespesas.FieldDefs.Add('NOME_FORNECEDOR', ftString, 35, false);
    fTempDespesas.FieldDefs.Add('VLCUSTO', ftFloat, 0, false);
  except
  end;

  if fTempDespesas.Tag = 0 then
  try
    fTempDespesas.CreateDataSet;
    fTempDespesas.Tag := 22;
  except
  end;
end;

function TPedVendaServTerc.defineCamposDtSetTemp: boolean;
