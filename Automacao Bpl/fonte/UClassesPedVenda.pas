    	pLabel.Caption := pLabel.Caption +
      'Desconto apurado serviço menor ou igual Max Desc Serv da política    (X)' + chr(13)
    else if ((vSing.vValorDescontoServ /
  		dataSet.FieldbyName('TOT_SERV').AsFloat) * 100) > pDataSetOpPag.FieldByName('MAX_DESCSERV').AsFloat then
     	pLabel.Caption := pLabel.Caption +
      'Desconto apurado serviço maior que Max Desc Serv da política         ( )' + chr(13)
    else
    	pLabel.Caption := pLabel.Caption +
      'Desconto apurado serviço menor ou igual Max Desc Serv da política    (X)' + chr(13);
  end;

  if (vSing.vValorDesconto <= 0)
  	or (pDataSetOpPag.FieldByName('MAX_DESC').IsNull) then
  	pLabel.Caption := pLabel.Caption +
      'Desconto apurado do documento menor ou igual Max Desc da política    (X)' + chr(13)
  else if ((vSing.vValorDesconto /
  		(dataSet.FieldbyName('TOT_PROD').AsFloat +
       dataSet.FieldbyName('TOT_SERV').AsFloat) +
       dataSet.FieldbyName('TOT_PROD_TERC').AsFloat +
       dataSet.FieldbyName('TOT_SERV_TERC').AsFloat) * 100) > pDataSetOpPag.FieldByName('MAX_DESC').AsFloat then
    pLabel.Caption := pLabel.Caption +
    	'Desconto apurado do documento maior que Max Desc da política         ( )' + chr(13)
  else
    pLabel.Caption := pLabel.Caption +
      'Desconto apurado do documento menor ou igual Max Desc da política    (X)' + chr(13);


	pLabel.Visible := true;
end;

function TPedVenda._existeCreditosQuitados(pNPED: integer; pTipo: string): boolean;
begin
  Result := false;

  buscas.Close;
  buscas.SQL.Text := 'SELECT * FROM CONTROLE_CREDITOS ' +
    ' WHERE TP_DOC_V = :TP_DOC_V AND N_DOC_V = :N_DOC_V AND CODIGO_EMP = :CODIGO_EMP AND STATUS_C = :STATUS_C';
  buscas.Params.ParamByName('N_DOC_V').AsInteger := pNPED;
  buscas.Params.ParamByName('TP_DOC_V').AsString := pTipo;
  buscas.Params.ParamByName('STATUS_C').AsString := 'QUITADO';
  buscas.Params.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
  buscas.Open;

  if buscas.IsEmpty then
  begin
    buscas.Close;
    buscas.SQL.Text := 'SELECT * FROM CONTROLE_CHEQUE ' +
      ' WHERE TP_DOC_V = :TP_DOC_V AND N_DOC_V = :N_DOC_V AND CODIGO_EMP = :CODIGO_EMP AND STATUS_CH = :STATUS_CH';
    buscas.Params.ParamByName('N_DOC_V').AsInteger := pNPED;
    buscas.Params.ParamByName('TP_DOC_V').AsString := pTipo;
    buscas.Params.ParamByName('STATUS_CH').AsString := 'QUITADO';
    buscas.Params.ParamByName('CODIGO_EMP').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
  end;

  if not buscas.IsEmpty then
  begin
     if Application.MessageBox(pchar('Existem créditos/cheques recebidos para esta venda, Deseja alterar o cliente e vendedor nos créditos, cheques e formas de pagamento?'), 'Confirmação',
        MB_ICONQUESTION + MB_YESNO) = IDNO then
          exit;

     vDadosIni.vInibeMensPesqPros := 'S';
     if not vDadosIni.PesqPros('VND161', 'VALIDAR', trim(pTipo) + ' - ALTERAR CLIENTE E VENDEDOR EM CREDITOS JÁ RECEBIDOS', 'PEDVENDA',
     	IntToStr(pNPED), buscas, true) then
       exit;

     Result := true;
  end
  else
    Result := true;
end;

function TPedVenda._gravaDevolucaoVND: boolean;
begin
  result := false;
  try
    vItProd.dataSet.First;
    while not vItProd.dataSet.Eof do
    begin
      if vItProd.dataSet.FieldByName('STATUS').AsString <> 'CANCELADO' then
      begin
        vItProd.dataSet.Edit;
        vItProd.dataSet.FieldByName('TIPV').AsString := dataSet.FieldByName('TIPV').AsString;
        vItProd.dataSet.post;
      end;
      vItProd.dataSet.Next;
    end;
    vItProd.Apply;
    if not (dataSet.State = dsEdit) then
      inherited edit;
    if vItProd.getValorItensLiquido = 0 then
    begin
      vSing.vValorAcrescimo := 0;
      vSing.vValorDesconto := 0;
      vSing.vValorAcrescimoProd := 0;
      vSing.vValorDescontoProd := 0;
      vSing.vValorAcrescimoServ := 0;
      vSing.vValorDescontoServ := 0; 
      vSing.vValorTotalBruto := 0;
      vSing.vValorRateioDesconto := 0;
      vSing.vValorRateioAcrescimo := 0;
      vSing.vValorDescontoIt := 0;
      vSing.vValorAcrescimoIt := 0;
      vSing.vValorTotalLiq := 0;
      vSing.vValorAcrescimoItServ := 0;
      vSing.vValorDescontoItServ := 0;
    end;

    calculaTotais;
    arredondar;
    if not (dataSet.State = dsEdit) then
      inherited edit;
    calculaTotais;
    if not (dataSet.State = dsEdit) then
      inherited edit;
    if not efetuaRateios then
      Exit;

    inherited post;
    {
    Agora o calculo da comissao é feito no metodo de rateio
    if (vDadosIni.vUsarPlano <> 'S') and (vDadosIni.vUsarPlano <> '2') then
      if not verificaComissaoProdutos then
        exit;
    }
    result := Apply;
//  if result then
//  begin
    result := CommitaTransacao;
    if not Result then
    begin
      raise exception.create('Erro na gravação d' + vSing.nomeVenda + ' número ' +
        dataSet.FieldByName('nped').AsString);
    end
    else
      abrePedVenda(dataSet.FieldByName('nped').AsInteger);
    result := vItProd.Apply;
    if not Result then
    begin
      dataSet.edit;
      exit;
    end;
    result := CommitaTransacao;
    if not Result then
    begin
      vDadosIni.GravaAuditoria('VND130', 'DEVOLVER', 'FALHA - ', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
      raise exception.create('Erro na gravação d' + vSing.nomeVenda + ' número ' +
        dataSet.FieldByName('nped').AsString);
    end
    else
    begin
      vDadosIni.GravaAuditoria('VND130', 'DEVOLVER', 'SUCESSO - ', 'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas);
      Refresh;
    end;
//  end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;

end;

