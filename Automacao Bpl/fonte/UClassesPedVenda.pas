function TPedVenda.incluirOcorrencia(historico: string; data, hora: string): boolean;
begin
  try
    if not vOcorr.Active then
      vOcorr.abreOcorreciaPed(dataSet.FieldByName('nped').AsInteger, dataSet.FieldByName('tipo').AsString);
    if trim(historico) = '' then
      raise exception.create('Histórico da ocorrencia deve ser preenchido');

    vOcorr.Insert;
    vOcorr.dataSet.FieldByName('HISTORICO_OC').AsString := historico;
    vOcorr.dataSet.FieldByName('COD_OCORRENCIA').AsInteger := GenCodigo('OCORRENCIAS_OS', DtmPed.SpIncCodigo, vDadosIni.codEmpresa);
    vOcorr.dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    vOcorr.dataSet.FieldByName('NPED').AsInteger := dataSet.FieldByName('nped').AsInteger;
    vOcorr.dataSet.FieldByName('n_os').AsInteger := dataSet.FieldByName('nped').AsInteger;
    vOcorr.dataSet.FieldByName('tipo').AsString := dataSet.FieldByName('tipo').AsString;
    if (data <> '  /  /    ') and (hora <> '  :  :  ') then
      vOcorr.dataSet.FieldByName('DATA_E_HORA').Value := StrToDate(data) + StrToTime(hora)
    else if (data = '  /  /    ') and (hora <> '  :  :  ') then
      vOcorr.dataSet.FieldByName('DATA_E_HORA').Value := vDadosIni.getDataBanco(buscas) +
        StrToTime(hora)
    else if (data <> '  /  /    ') and (hora = '  :  :  ') then
      vOcorr.dataSet.FieldByName('DATA_E_HORA').Value := StrToDate(data) +
        StrToTime(FormatDateTime('hh:mm:ss', vDadosIni.getDataHoraBanco(buscas)))
        //        strtotime(DateTimeToStr(vDadosIni.getDataHoraBanco(buscas)))
    else
      vOcorr.dataSet.FieldByName('DATA_E_HORA').Value := vDadosIni.getDataHoraBanco(buscas);
    vOcorr.Post;
  except
    on e: exception do
    begin
      Result := true;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TPedVenda.iniciaFormaPagamento: Boolean;
var
	hdFormPag: THandle;
  vFp2: TComunicacaoFormaPagamento;
  vProcesso: string;
begin
  Result := False;

  if (vDadosIni.vEmp.vModoFaturamento = 'S')
    and (vDadosIni.vPedVnd.ReceberPeloFinanceiro)
    and (vDadosIni.vSistema <> 'Cxl') then
  begin
    if vDadosIni.ReceberPeloFinanceiro(dataSet.FieldByName('NPED').AsInteger,
      dataSet.FieldByName('TIPO').AsString, buscas) <> 'S' then
    begin
      Result := true;
      exit;
    end;

    vProcesso := 'VND254';
    if trim(dataSet.FieldByName('TIPO').AsString) = 'OS' then
      vProcesso := 'VND255';

    vDadosIni.vInibeMensPesqPros := 'S';
    if not vDadosIni.PesqPros(vProcesso, 'HABILITAR', '"'+trim(dataSet.FieldByName('TIPO').AsString)+'" ' + dataSet.FieldByName('NPED').AsString,
     'PEDVENDA', dataSet.FieldByName('NPED').AsString, buscas, false) then
    begin
      Result := true;
      exit;
    end;
  end;

  try
    CarregaPacote('pkFormPag', hdFormPag);
    vFp2 := TComunicacaoFormaPagamento.Create;
    Result := vFp2.iniciaFormaPagamento(dataSet.FieldByName('nped').AsInteger,
      dataSet.FieldByName('cod_cond_pag').AsInteger, 0,
      dataSet.FieldByName('cod_cliente').AsInteger,
      dataSet.FieldByName('cod_vendedor').AsInteger,
      vSing.vTipoVenda, dataSet.FieldByName('valor_total').AsCurrency);
  finally
    UnloadPackage(hdFormPag);
  end;
end;

function TPedVenda.iniciarSeparacao: Boolean;
var
  vNumPedVenda: Integer;
  vStatusPed, vStatusSepConf: string;
begin
  Result := False;

  if not vDadosIni.PesqPros('VND184', 'ALTERAR', dataSet.FieldByName('TIPO').AsString, 'PEDVENDA', IntToStr(dataSet.FieldByName('NPED').AsInteger), buscas, true) then
    Exit;

  try
    vNumPedVenda := dataSet.FieldByName('NPED').AsInteger;
    buscas.Close;
    buscas.SQL.Text := 'select STATUS_PED, STATUS_SEP_CONF, TIPV, COD_CLIENTE, APROVADA_GERENTE, AUTORIZADO_FINANCEIRO' +
      ' from PEDVENDA' +
      ' WHERE NPED = ' + IntToStr(vNumPedVenda) +
      ' AND TIPO = ''REQ'' AND COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;
    vStatusPed := Trim(buscas.FieldByName('STATUS_PED').AsString);
    vStatusSepConf := Trim(buscas.FieldByName('STATUS_SEP_CONF').AsString);

    if Trim(vStatusPed) <> '' then
      raiseExceptionCreate('Pedido não pode ser separado pois esta : ' + vStatusPed, '');

    if (Trim(vStatusSepConf) <> '') and (Trim(vStatusSepConf) <> 'SEPARACAO') then
      raiseExceptionCreate('Pedido não pode ser separado pois já esta como: ' + vStatusSepConf, '');

    if not gerenteAutorizou(vNumPedVenda) then
      raiseExceptionCreate('Pedido não pode ser separado pois está aguardando autorização do Gerente', '');

    if not financeiroAutorizou(vNumPedVenda) then
      raiseExceptionCreate('Pedido não pode ser separado pois está aguardando liberação do Financeiro', '');

    vDadosIni.informarSituacaoPedido( vNumPedVenda, 'REQ', 'SEPARACAO', 'Iniciado', '', buscas, False, False, False);

    Result := vDadosIni.mudarStatusSeparacao(vNumPedVenda, 'REQ', cEmSeparacao, buscas, True);

    if Result then
      vDadosIni.GravaAuditoria('VND184', 'ALTERAR', 'SUCESSO', 'PEDVENDA', IntToStr(vNumPedVenda), buscas)
    else
      vDadosIni.GravaAuditoria('VND184', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);

  except on E: Exception do
    begin
      Result := False;
      vDadosIni.GravaAuditoria('VND184', 'ALTERAR', 'FALHA', 'PEDVENDA', IntToStr(vNumPedVenda), buscas);
      Application.MessageBox(PChar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      registrarEntrega('function TPedVenda.iniciarSeparacao. Erro: ' + e.Message);
    end;
  end;
end;

function TPedVenda.insereNFSEXT(pNUM_NFEEXT: string; pAno: Word; pMotivoCancelamento: string; pDataCancelamento: TDateTime): boolean;
var
	qrNFSE_CANCELADAS: TIBQuery;
  vExisteCancelamentoItem: boolean;
begin
	try
    Result := False;

    qrNFSE_CANCELADAS := TIBQuery(DtmPed.qrBuscas2);

    buscas.Close;
    buscas.SQL.Text := 'SELECT DISTINCT P.NUM_NFEEXT NUM_NFSE, P.NPED N_OS, P.COD_EMPRESA, C.NOME_CLIENTE, ' +
		'P.VALOR_NFEXT VALOR_NFSE, P.DATA_NFEXT EMISSAO_NFSE, T.CNAE_SERV CNAE, T.CTISS, T.NFS_SERVICO, T.ALIQ_ISS, C.COD_CLIENTE, ' +
		'(CASE WHEN COALESCE(C.ISS_RETIDO, 0) = 0 THEN COALESCE(T.ISS_RETIDO, 2) ELSE C.ISS_RETIDO END) ISS_RETIDO '+
		'FROM PEDVENDA P '+
		'LEFT JOIN CLIENTES C ON C.COD_CLIENTE = P.COD_CLIENTE AND C.COD_EMPRESA = P.COD_EMPRESA '+
		'LEFT JOIN PEDVENDA_SERV PS ON PS.NPED = P.NPED AND PS.TIPO = P.TIPO AND PS.COD_EMPRESA = P.COD_EMPRESA '+
		'LEFT JOIN TIPO_SERVICO T ON T.COD_SERVICO = PS.COD_SERVICO '+
		'WHERE P.NUM_NFEEXT = :NUM_NFEEXT AND EXTRACT(YEAR FROM P.DATA_NFEXT) = :ANO AND P.COD_EMPRESA = :COD_EMPRESA';

    buscas.ParamByName('NUM_NFEEXT').AsString := pNUM_NFEEXT;
    buscas.ParamByName('ANO').AsWord := pAno;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

    buscas.Open;

    if buscas.IsEmpty then
    	Exit;

    buscas.First;

    while not buscas.Eof do
    begin
      //LIMPA DADOS DA OS
      qrNFSE_CANCELADAS.Close;
      qrNFSE_CANCELADAS.SQL.Text := 'UPDATE PEDVENDA P SET P.NUM_NFEEXT = NULL, P.DATA_NFEXT = NULL, P.VALOR_NFEXT = NULL WHERE P.NPED = :NPED AND P.TIPO = ''OS'' AND P.COD_EMPRESA = :COD_EMPRESA';
			qrNFSE_CANCELADAS.ParamByName('NPED').AsInteger := buscas.FieldByName('N_OS').AsInteger;
			qrNFSE_CANCELADAS.ParamByName('COD_EMPRESA').AsInteger := buscas.FieldByName('COD_EMPRESA').AsInteger;

      qrNFSE_CANCELADAS.ExecSQL;
      
    	vExisteCancelamentoItem := existeCancelamentoItem(
                                                        buscas.FieldByName('N_OS').AsInteger,
                                                        buscas.FieldByName('ISS_RETIDO').AsInteger,
                                                        pAno,
      																									buscas.FieldByName('NUM_NFSE').AsString,
                                                        buscas.FieldByName('CNAE').AsString,
                                                        buscas.FieldByName('CTISS').AsString,
                                                        buscas.FieldByName('NFS_SERVICO').AsString,
                                                        buscas.FieldByName('ALIQ_ISS').AsFloat
                                                        );
                                                              
      if vExisteCancelamentoItem then
      begin
        buscas.Next;
        Continue;
      end;
      
      qrNFSE_CANCELADAS.Close;
      qrNFSE_CANCELADAS.SQL.Text :=
      'INSERT INTO NFSE_CANCELADAS (NUM_NFSE, COD_RPS, N_OS, COD_EMPRESA, NOME_CLIENTE, DATA_CANC, VALOR_NFSE, SERIE, SUB_SERIE, ATIVO, MOTIVO_CANCELAMENTO, EMISSAO_NFSE, CNAE, CTISS, NFS_SERVICO, ALIQ_ISS, COD_CLIENTE, ISS_RETIDO) '+
      'VALUES (:NUM_NFSE, :COD_RPS, :N_OS, :COD_EMPRESA, :NOME_CLIENTE, :DATA_CANC, :VALOR_NFSE, :SERIE, :SUB_SERIE, :ATIVO, :MOTIVO_CANCELAMENTO, :EMISSAO_NFSE, :CNAE, :CTISS, :NFS_SERVICO, :ALIQ_ISS, :COD_CLIENTE, :ISS_RETIDO)';
      
    	qrNFSE_CANCELADAS.ParamByName('NUM_NFSE').AsString := buscas.FieldByName('NUM_NFSE').AsString;
    	qrNFSE_CANCELADAS.ParamByName('COD_RPS').AsInteger := 0;
    	qrNFSE_CANCELADAS.ParamByName('N_OS').AsInteger := buscas.FieldByName('N_OS').AsInteger;
    	qrNFSE_CANCELADAS.ParamByName('COD_EMPRESA').AsInteger := buscas.FieldByName('COD_EMPRESA').AsInteger;
    	qrNFSE_CANCELADAS.ParamByName('NOME_CLIENTE').AsString := buscas.FieldByName('NOME_CLIENTE').AsString;
    	qrNFSE_CANCELADAS.ParamByName('DATA_CANC').AsDateTime := pDataCancelamento;
    	qrNFSE_CANCELADAS.ParamByName('VALOR_NFSE').AsCurrency := buscas.FieldByName('VALOR_NFSE').AsCurrency;
    	qrNFSE_CANCELADAS.ParamByName('SERIE').AsInteger := 1;
    	qrNFSE_CANCELADAS.ParamByName('SUB_SERIE').AsInteger := 0;
    	qrNFSE_CANCELADAS.ParamByName('ATIVO').AsInteger := 1;
    	qrNFSE_CANCELADAS.ParamByName('MOTIVO_CANCELAMENTO').AsString := pMotivoCancelamento;      
    	qrNFSE_CANCELADAS.ParamByName('EMISSAO_NFSE').AsDateTime := buscas.FieldByName('EMISSAO_NFSE').AsDateTime;
    	qrNFSE_CANCELADAS.ParamByName('CNAE').AsString := buscas.FieldByName('CNAE').AsString;
    	qrNFSE_CANCELADAS.ParamByName('CTISS').AsString := buscas.FieldByName('CTISS').AsString;
    	qrNFSE_CANCELADAS.ParamByName('NFS_SERVICO').AsString := buscas.FieldByName('NFS_SERVICO').AsString;
    	qrNFSE_CANCELADAS.ParamByName('ALIQ_ISS').AsFloat := buscas.FieldByName('ALIQ_ISS').AsFloat;
    	qrNFSE_CANCELADAS.ParamByName('COD_CLIENTE').AsInteger := buscas.FieldByName('COD_CLIENTE').AsInteger;
    	qrNFSE_CANCELADAS.ParamByName('ISS_RETIDO').AsInteger := buscas.FieldByName('ISS_RETIDO').AsInteger;

      qrNFSE_CANCELADAS.ExecSQL;

      buscas.Next;
    end;

    Result := CommitaTransacao;
    if Result then
      Refresh;
  except on E: Exception do
    begin
      RollBackTransacao;
      Result := False;
      registraErro(e.Message);
      Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
    end;
  end;
end;

function TPedVenda.inserirVenda(vendaRapida: boolean): boolean;
