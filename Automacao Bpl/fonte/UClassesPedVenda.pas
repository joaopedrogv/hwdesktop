  zerar;
  inherited;
end;

function TGradeProdVendaPed.insert(nped, grupoprod, codgrade: integer; cod_prod,
  tipo: string; qtde: Double): boolean;
var
  vEdit: Integer;
begin
  Result := false;
  vEdit := 0;
  dtSet.First;
  while not dtSet.Eof do
  begin
    if (dtSet.FieldByName('cod_grade').AsInteger = codgrade) and
      (dtSet.FieldByName('grupo_prod').AsInteger = grupoprod) and
      (dtSet.FieldByName('cod_prod').AsString = cod_prod) and
      (dtSet.FieldByName('tipo').AsString = tipo) then
    begin
      vEdit := 1;
      Break;
    end;
    dtSet.Next;
  end;
  if vEdit = 1 then
    dtSet.Edit
  else
    dtSet.Insert;
  dtSet.FieldByName('cod_grade').AsInteger := codgrade;
  dtSet.FieldByName('grupo_prod').AsInteger := grupoprod;
  dtSet.FieldByName('cod_prod').AsString := cod_prod;
  dtSet.FieldByName('cod_empresa').AsString := vDadosIni.codEmpresa;
  dtSet.FieldByName('tipo').AsString := tipo;
  dtSet.FieldByName('qtde').AsFloat := dtSet.FieldByName('qtde').AsFloat + qtde;
  dtSet.FieldByName('nreq').AsInteger := nped;
  dtSet.Post;
  Result := true;
end;

procedure TGradeProdVendaPed.zerar;
begin
  while not dtSet.IsEmpty do
    dtSet.Delete;
end;

