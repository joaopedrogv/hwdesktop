function TContaCorrenteClientes.abreContaCorrente(pCodCliente: Integer; pCPFCGC: string; pDBGrid: TDBGrid;
	pLabel: TLabel; pVencidos: boolean = false): boolean;
var
  I: Integer;
  ANode, ANode2: TtreeNode;
  vtemp: string;
begin
  Result := false;

  if pVencidos then
    if not vDadosIni.PesqPros('CLI222', 'VISUALIZAR', 'CLIENTE: ' + IntToStr(pCodCliente),
       'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
      Exit;

  FrmCadClientes.PanelTreeView.Height := 0;
  // Atualizar saldo conta corrente
  vDadosIni.atualizarSaldoCC(
  	pCodCliente,
    pCPFCGC,
    pLabel,
    pVencidos,
    vQtdeGrid,
    buscas,
  	vSaldoCC,
    vValorCC,
    vPagGrid,
    vRecordPagGrid,
    vMaxPagGrid,
    vRecordCount);

  vSaldosEmp.abreSaldosEmp(pCodCliente, pCPFCGC);

  FrmCadClientes.BitBtnPrimeiroExtratoContaCorrente.Enabled := vPagGrid > 0;
  FrmCadClientes.BitBtnAnteriorExtratoContaCorrente.Enabled := vPagGrid > 0;
  FrmCadClientes.BitBtnProximoExtratoContaCorrente.Enabled  := (vRecordCount > 0) and (vPagGrid + 1 <> vMaxPagGrid);
  FrmCadClientes.BitBtnUltimoExtratoContaCorrente.Enabled   := (vRecordCount > 0) and (vPagGrid + 1 <> vMaxPagGrid);

  FrmCadClientes.Label350.Caption := FormatFloat('#,##0', vSaldoCC);

  // Buscas dados taxa conversão
  vDadosIni.buscasdadostaxaConv(buscas);
  if vDadosIni.vProgFid.vHabilitarProgFid then
    FrmCadClientes.Label359.Caption := 'R$ ' + FormatFloat('#,##0.00', vSaldoCC * buscas.FieldByName('PERC_PROG_FID').AsFloat);
//  else if vDadosIni.vCashback.vHabilitarCashback then
//    FrmCadClientes.Label359.Caption := 'R$ ' + FormatFloat('#,##0.00', vValorCC);

  vtemp := ' cl.cpfcgc = ' +  QuotedStr(pCPFCGC);
  if trim(pCPFCGC) = '' then
  	vtemp := ' cl.cod_cliente = ' + IntToStr(pCodCliente);

  Result := montaSelect(' select first ' + IntToStr(vQtdeGrid) + ' skip ' + IntToStr(vQtdeGrid * vPagGrid) + ' cc.* from conta_corrente_prog_fidelidade cc ' +
    ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
    ' left join empresa_prog_fid empg on coalesce(cc.cod_emp_resp, cc.cod_empresa) = empg.cod_empresa ' +
  	' where ' + vtemp +
    ' and coalesce(cc.cod_emp_resp, cc.cod_empresa) in (case when (empg.cod_empresa > 0) then empg.cod_empresa else ' + vDadosIni.codEmpresa + ' end) ' +
   vDadosIni.IfThen(not pVencidos,
   		' and cc.data_venc_prog >= %s ',
   		' and cc.data_venc_prog < %s ') +
   ' order by cc.data desc, cc.codigo desc ', [vDadosIni.FusoDateFb]);

  TFloatField(dataSet.FieldByName('VALOR')).DisplayFormat := '#,##0.00';
  dataSet.FieldByName('NVALECUPOM').Tag := 0;

  if dataSet.Active then
    for I := 0 to pDBGrid.Columns.Count - 1 do
     if pDBGrid.Columns[i].FieldName = 'JSONCLASSES' then
       pDBGrid.Columns[i].ButtonStyle := cbsEllipsis;

  Result := true;
end;

constructor TContaCorrenteClientes.create;
begin
  DataSet := TClientDataSet(DtmClientes.cdsContaCorrenteCli);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);

  dataSet.AfterScroll := DetContaCorrenteAfterScroll;

  if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
   or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'P') then
	  dataSet.FieldByName('PONTOS').Tag := 2
  else
  	dataSet.FieldByName('PONTOS').Tag := 1;


  if (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'A')
   or (vDadosIni.vProgFid.vExibirReciboPontosValorAmbos = 'V') then
	  dataSet.FieldByName('VALOR').Tag := 2
  else
  	dataSet.FieldByName('VALOR').Tag := 1;

  vRegrasValeCompraProgFid := TRegrasValeCompraProgFid.create;
  vRegrasValeTrocaProgFid := TRegrasValeTrocaProgFid.create;
  vEmpresaProgFid := TEmpresaProgFid.create;
  vTransSaldoProgFid := TTransSaldoProgFid.create;
  vDocProgFid := TDocProgFid.create;
  vResgateValeCupom := TResgateValeCupom.create;
  vSaldosEmp := TSaldosEmp.create;
end;

function TContaCorrenteClientes.delete(pCodCliente: Integer): boolean;
var
  codigo: string;
begin
  Result := False;

  if dataSet.IsEmpty then
    Exit;

  codigo := dataSet.FieldByName('CODIGO').AsString;

  if not vDadosIni.PesqPros('CLI219', 'EXCLUIR', 'CLIENTE: ' + IntToStr(pCodCliente),
     'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas, true) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir o lançamento ?',
    'Confirmação', MB_YESNO + MB_ICONQUESTION) <> IDYES then
    Exit;

  SqlOpen(' select codigo, ndoc, tipodoc from conta_corrente_prog_fidelidade ' +
    ' where cod_cliente = ' + IntToStr(pCodCliente) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by codigo desc ');

  if not buscas.IsEmpty then
    if buscas.FieldByName('CODIGO').AsInteger <> dataSet.FieldByName('CODIGO').AsInteger then
    begin
      Application.MessageBox(pchar('Somente é possível excluir o último lançamento da conta.'), 'Atenção', MB_ICONERROR + MB_OK);
      Refresh;
      exit;
    end;

  SqlOpen(' select codigo, tipo, descricao, ndoc, tipodoc, vale, ' +
  	 ' case when (coalesce((select result from pos(''RESGATE'', descricao)), 0) > 0) then ''S'' else ''N'' end resgate ' +
    '   from conta_corrente_prog_fidelidade ' +
    ' where codigo = ' + IntToStr(dataSet.FieldByName('CODIGO').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by codigo desc ');

  if (not buscas.IsEmpty) then
    if ((buscas.FieldByName('ndoc').AsInteger > 0) or (trim(buscas.FieldByName('tipodoc').AsString) <> '')) then
    begin
      if (trim(buscas.FieldByName('resgate').AsString) = 'S')
        and	(trim(buscas.FieldByName('vale').AsString) = 'S')
        and (trim(buscas.FieldByName('tipo').AsString) = 'DÉBITO') then
      begin
         if not vDadosIni.PesqPros('CLI231', 'EXCLUIR', 'CLIENTE: ' + IntToStr(pCodCliente) +
           ' NDOC: ' + IntToStr(dataSet.FieldByName('NDOC').AsInteger) +
           ' TIPODOC: ' + trim(dataSet.FieldByName('TIPODOC').AsString),
           'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas, true) then
          Exit;

          SqlOpen(' select (case when (count(ndoc) > 0) then 1 else 0 end) formas from existe_formas ' +
            '(' + IntToStr(dataSet.FieldByName('NDOC').AsInteger) + ', ' +
          	 QuotedStr(trim(dataSet.FieldByName('TIPODOC').AsString)) + ', ' +
             vDadosIni.codEmpresa + ')');
          if buscas.FieldByName('formas').AsInteger > 0 then
          begin
            Result := false;
            Application.MessageBox(pchar('Não é possível excluir esse lançamento, documento se encontra recebido: ' + #13 + #13 +
              'Nº Doc: ' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) + #13 +
              'Tipo Doc: ' + trim(dataSet.FieldByName('tipodoc').AsString)),
              'Atenção', MB_ICONERROR + MB_OK);
            exit;
          end;
      end
      else
      begin
        Result := false;
        Application.MessageBox(pchar('Somente é possível excluir lançamentos avulsos ou de vale resgate pendentes.'), 'Atenção', MB_ICONERROR + MB_OK);
        Refresh;
        exit;
      end;
    end;

  buscas.Close;
  buscas.SQL.Text := ' delete from conta_corrente_prog_fidelidade ' +
    ' where codigo = ' + IntToStr(dataSet.FieldByName('CODIGO').AsInteger) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;

  try
    buscas.ExecSQL;

    CommitaTransacao;
    vDadosIni.GravaAuditoria('CLI219', 'EXCLUIR', 'SUCESSO', 'CONTA_CORRENTE_PROG_FIDELIDADE', codigo, buscas);
  except
    RollBackTransacao;
    vDadosIni.GravaAuditoria('CLI219', 'EXCLUIR', 'FALHA', 'CONTA_CORRENTE_PROG_FIDELIDADE', codigo, buscas);
  end;
  Result := true;
  Refresh;
end;

