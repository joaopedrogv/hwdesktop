	try
  	Result := False;

    if not vDadosIni.PesqPros('CLI288', 'EXCLUIR',
    	'Ctr ' + IntToStr(vCOD_CONTRATO),
      'CLIENTES_COM_CONTRATO_PROD',
    	IntToStr(vCOD_CONTRATO_PROD), buscas, true) then
