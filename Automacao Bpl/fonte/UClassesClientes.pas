            else if (REnviarContratos.vDataIniAd <> '') and (REnviarContratos.vDataFimAd <> '') then
              REnviarContratos.vsqlAdicional := REnviarContratos.vsqlAdicional + REnviarContratos.vCampoAd +
                ' >= ' + REnviarContratos.vDataIniAd;
            Break;
          end;
          if Trim(REnviarContratos.vSqlAdicional) <> '' then
		      	REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional + ' and ';

          if REnviarContratos.vCondicaoAd = 'like' then
          begin
//          	if (REnviarContratos.vCampoAd = 'NOME_CLIENTE') or (REnviarContratos.vCampoAd = 'RAZAO')
