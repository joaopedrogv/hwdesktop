function TCadClientes.post: boolean;
var
  acao, AStr: string;
  CEPs: tcep;
begin
  try
    Result := false;
    if not vDadosIni.PesqPros('CLI024', 'CONFIRMAR', 'CONFIRMANDO COD CLIENTE: ' +
      dataSet.FieldByName('COD_CLIENTE').AsString, 'CLIENTES', dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      if Trim(fDadosEndereco) <> '' then
        if Trim(fDadosEndereco) <> (Trim(dataSet.FieldByName('CEP').AsString) + '|' +
          Trim(dataSet.FieldByName('ENDERECO').AsString) + '|' +
          Trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString) + '|' +
          Trim(dataSet.FieldByName('COMPLEMENTO').AsString) + '|' +
          Trim(dataSet.FieldByName('BAIRRO').AsString) + '|' +
          Trim(dataSet.FieldByName('CIDADE').AsString) + '|' +
          Trim(dataSet.FieldByName('CODIGO_UF').AsString) + '|') then
          if Application.MessageBox('Endereço principal alterado. Deseja copiar o endereço principal para o de cobrança?',
            'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
            setMesmoEnderecoCobIgualPrincipal;

    if Trim(dataSet.FieldByName('ENDERECO').AsString) <> '' then
    if Trim(vDadosIni.apenasNumeros(dataSet.FieldByName('END_COBRANCA').AsString)) = '' then
    begin
      Application.MessageBox('Não foi encontrado o número no endereço de cobrança', 'Atenção', 0 + 64);
      if not vDadosIni.PesqPros('CLI199', 'VALIDAR', dataSet.FieldByName('END_COBRANCA').AsString, 'CLIENTES',
        IntToStr(dataSet.FieldByName('cod_cliente').AsInteger), buscas, True, True) then
        Exit;
    end;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

  	if trim(dataSet.FieldByName('CL_GERAR_PONTOS').AsString) = '' then
      dataSet.FieldByName('CL_GERAR_PONTOS').AsString := 'S';
    if trim(dataSet.FieldByName('REC_NOT').AsString) = '' then
      dataSet.FieldByName('REC_NOT').AsString := 'S';
    if trim(dataSet.FieldByName('BARRAMENTO_AUTOMATICO').AsString) = '' then
  		dataSet.FieldByName('BARRAMENTO_AUTOMATICO').AsString := 'S';

    if acao = 'INSERIR' then
      dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES', DtmClientes.SpIncCodigo,
        vDadosIni.codEmpresa);

    if (dataSet.FieldByName('cod_pais').AsInteger <> 1058) and (dataSet.FieldByName('cod_pais').AsInteger > 0) then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select codigo_uf from estados where ibge_codigo_uf = 99';
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        dataSet.FieldByName('CODIGO_UF').AsInteger := buscas.FieldByName('CODIGO_UF').AsInteger;

        if dataSet.FieldByName('CODIGO_UF').AsInteger > 0 then
        begin
          SqlOpen(' select codigo_uf, sigla_uf from estados ' +
            ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('CODIGO_UF').AsInteger), buscas);

          if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
            dataSet.FieldByName('ESTADOS_UF').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
        end;
      end;

      buscas.Close;
      buscas.SQL.Text := 'select cod_cidade from cidades where IBGE_COD_CIDADE = 9999999';
      buscas.Open;

      if not buscas.IsEmpty then
      begin
        dataSet.FieldByName('COD_CIDADE').AsInteger := buscas.FieldByName('COD_CIDADE').AsInteger;
        dataSet.FieldByName('CIDADE').AsString := 'EXTERIOR';
      end;

      dataSet.FieldByName('NFE_INDIEDEST').AsInteger := 9;
      dataSet.FieldByName('INSC_EST').AsString := 'ISENTO';
    end;
//    else if vDadosIni.strEstaContidoEm(Trim(dataSet.FieldByName('INSC_EST').AsString), ['', 'ISENTO']) then
//      dataSet.FieldByName('NFE_INDIEDEST').AsInteger := 9
//    else if dataSet.FieldByName('NFE_INDIEDEST').AsInteger = 2 then
//      dataSet.FieldByName('NFE_INDIEDEST').AsInteger := 1;

    AtualizarConveniados;

    BarrarClientesOutrasFiliaisPeloCPFCNPJ;

    vDadosIni.vPesquisa := dataSet.FieldByName('COD_CLIENTE').AsString;

    AStr := Trim(dataSet.FieldByName('COND_PAG_VND').AsString);
    dataSet.FieldByName('COND_PAG_VND').AsString := vCondPagVND.GetCondPagCliente;
    if Trim(AStr) <> Trim(dataSet.FieldByName('COND_PAG_VND').AsString) then
      vDadosIni.GravaAuditoria('CLI207', 'ALTERAR', 'ANT:' + AStr + ' NOVO:' +   Trim(dataSet.FieldByName('COND_PAG_VND').AsString), 'CLIENTES', dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

    AStr := Trim(dataSet.FieldByName('COND_PAG_PRE').AsString);
    dataSet.FieldByName('COND_PAG_PRE').AsString := vCondPagPre.GetCondPagCliente;
    if Trim(AStr) <> Trim(dataSet.FieldByName('COND_PAG_PRE').AsString) then
      vDadosIni.GravaAuditoria('CLI208', 'ALTERAR', 'ANT:' + AStr + ' NOVO:' +   Trim(dataSet.FieldByName('COND_PAG_PRE').AsString), 'CLIENTES', dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

    dataSet.FieldByName('DATA_MOD_CAD').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('CPFCGC').AsString := HelperDocumento.CnpjOuCpfTratado( fstr('CPFCGC') );
    dataSet.FieldByName('REP_INT_ACTIVE').AsInteger := 1;

    Result := inherited post;

    CEPs._GravarCEPAutomatico(dataSet.FieldByName('CEP').AsString,
      dataSet.FieldByName('CODIGO_UF').AsInteger,
      dataSet.FieldByName('COD_CIDADE').AsInteger,
      dataSet.FieldByName('COD_BAIRRO').AsInteger,
      dataSet.FieldByName('ENDERECO').asstring, '', '', '', '', '');

    _gravarAtributos(dataSet.FieldByName('COD_CLIENTE').AsInteger);

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') and (EndDocAd.dataSet.ChangeCount = 0) then
    begin
      Cancel;

      if (Foto.emTransacao) or (Foto.dataSet.ChangeCount > 0) then
        CommitaTransacao
      else
        RollBackTransacao;
      Result := true;
      Exit;
    end;

    Result := (vDadosIni.IfThen(CupomDescontoCliente.dataSet.ChangeCount > 0, CupomDescontoCliente.Apply, true))
      and (EndDocAd.Apply)
      and (Frotas.Salvar)
      and (FtribAd.Salvar)
      and (FContato.Apply)
      and (FContatoMsg.Apply);

    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('CLI024', acao, 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
      if acao = 'INSERIR' then
      begin
        vDadosIni.vPesquisa := dataSet.FieldByName('COD_CLIENTE').asstring;
        Application.MessageBox(Pchar('Código do cliente : ' +
          vDadosIni.strzero(dataSet.FieldByName('COD_CLIENTE').asstring, 6)), 'Informação', MB_OK +
          MB_ICONQUESTION + MB_DEFBUTTON1);
      end;
    end
    else
    begin
      vDadosIni.GravaAuditoria('CLI024', acao, 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
      Application.MessageBox('O cadastro não pôde ser realizado.' + chr(13) +
        'Verifique as possíveis causas e tente novamente.', 'Aviso', MB_OK + MB_ICONERROR +
        MB_DEFBUTTON1);
      Refresh;
      FechaQuerys;
      RollBackTransacao;
      exit;
    end;
    //Refresh;
//    if result then
//      if Replicar then
//        RepliCliente.ReplicaCliente(dataset, acao);
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;
