function TCadPedidoCompraClProd.GetNotas: NotasPedidoCompraCliente;
begin
  Self.queryCons.SQL(
    'select nf.cod_nf, nf.num_nf, env.nitem_nf, env.qtde_env ' +
    ' from pedidocompracl_itens_env env' +
    ' inner join notafiscal nf on nf.cod_nf = env.cod_nf and nf.cod_empresa = env.cod_empresa' +
    ' where env.codigo = %d and env.cod_empresa = %d and env.nitem = %d' +
    ' order by num_nf',
    [fint('codigo'), vDadosIni.cod_empresa, fint('nitem')]).Open().Last().First();

  SetLength(Result, Self.queryCons.query.RecordCount);

  while not Self.queryCons.Eof() do
  begin
    Result[ Self.queryCons.query.RecNo - 1].CodNF  := Self.queryCons.fint('cod_nf');
    Result[ Self.queryCons.query.RecNo - 1].NumNF  := Self.queryCons.fint('num_nf');
    Result[ Self.queryCons.query.RecNo - 1].QtdeNF := Self.queryCons.ffloat('qtde_env');

    Self.queryCons.Next();
  end;
end;

function TCadPedidoCompraClProd.Insert(APedido: NovoPedidoDados): boolean;
begin
  if inherited Insert then
  begin
    Result := True;

    queryCons.SQL(
      'select p.num_fab_prod, p.descr_prod, g.cod_grade, g.descricao as descr_grade' +
      ' from produtos p' +
      ' left join cod_grade_prod gp on gp.grupo_prod = p.grupo_prod and gp.cod_prod = p.cod_prod' +
      '   and gp.cod_grade = %d and gp.cod_empresa = p.cod_empresa ' +
      ' left join grade g on g.cod_grade = gp.cod_grade and g.cod_empresa = gp.cod_empresa ' +
      ' where p.grupo_prod = %d and p.cod_prod = ''%s'' and p.cod_empresa = %d',
      [ APedido.CodGrade, APedido.GrupoProd, APedido.CodProd, vDadosIni.cod_empresa]
    ).Open();

    dataSet.FieldByName('COD_EMPRESA').AsInteger := vDadosIni.cod_empresa;
    dataSet.FieldByName('GRUPO_PROD').AsInteger := APedido.GrupoProd;
    dataSet.FieldByName('COD_PROD').AsString := APedido.CodProd;
    dataSet.FieldByName('NUM_FAB_PROD').AsString := queryCons.fstr('NUM_FAB_PROD');
    dataSet.FieldByName('COD_GRADE').AsInteger := APedido.CodGrade;
    dataSet.FieldByName('QUANT').AsFloat := APedido.Quantidade;
    dataSet.FieldByName('VALOR').AsFloat := APedido.ValorUn;
    dataSet.FieldByName('DESCR_PROD').AsString := queryCons.fstr('DESCR_PROD') + IfThen(queryCons.fint('COD_GRADE') > 0, ' ' + queryCons.fstr('DESCR_GRADE'));
    dataSet.FieldByName('VALOR_TOT').AsFloat := ffloat('QUANT') * ffloat('VALOR');
  end;
end;

