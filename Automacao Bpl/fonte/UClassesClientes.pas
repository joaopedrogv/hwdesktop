procedure TCadClientes.DetalhesRecebimentoModalidade;
begin
  try
    if vLancQuit = nil then
      vLancQuit := TLancamentosquit.Create;
    vLancQuit.buscas.Close;
    vLancQuit.buscas.SQL.Text := 'Select l.*,ctr.nome_ctrl from lancamentos l, controles ctr ' +
      ' where l.codigo_ctrl = ctr.codigo_ctrl and lote_ent = ' +
      inttostr(vDetalheRec.buscas.FieldByName('LOTE_QUIT').asinteger) +
      // + inttostr(vDetalheRec.buscas.FieldByName('LOTE_ENT').asinteger) +
    ' and l.codigo_emp = ctr.codigo_emp and l.codigo_emp = ' + vDadosIni.codEmpresa;
    vLancQuit.buscas.Open;
    vLancQuit.vTotLanc := 0;
    while not vLancQuit.buscas.eof do
    begin
      vLancQuit.vTotLanc := vLancQuit.vTotLanc + vLancQuit.buscas.FieldByName('VALOR_L').AsFloat;
      vLancQuit.buscas.next;
    end;
    if vCheqQuit = nil then
      vCheqQuit := TChequesquit.Create;
    vCheqQuit.buscas.Close;
    vCheqQuit.buscas.sql.Text := 'select chq.*,ctr.Nome_ctrl from controle_cheque chq,controles ctr '
      +
      ' where chq.codigo_ctrl = ctr.codigo_ctrl and lote_ent = ' +
      inttostr(vDetalheRec.buscas.FieldByName('LOTE_QUIT').asinteger) +
      ' and chq.codigo_emp = ctr.codigo_emp and chq.codigo_Emp =' + vDadosIni.codEmpresa;
    vCheqQuit.buscas.Open;
    vCheqQuit.vTotCheq := 0;
    while not vCheqQuit.buscas.eof do
    begin
      vCheqQuit.vTotCheq := vCheqQuit.vTotCheq + vCheqQuit.buscas.FieldByName('VALOR_CH').AsFloat;
      vCheqQuit.buscas.next;
    end;

    if vCredQuit = nil then
      vCredQuit := TCreditosquit.Create;
    vCredQuit.buscas.Close;
    vCredQuit.buscas.sql.Text :=
      'select cred.*,ctr.Nome_ctrl from controle_creditos cred,controles ctr ' +
      ' where cred.codigo_ctrl = ctr.codigo_ctrl and cred.lote_ent = ' +
      inttostr(vDetalheRec.buscas.FieldByName('LOTE_QUIT').asinteger) +
      ' and cred.codigo_Emp = ctr.codigo_emp and ctr.codigo_emp = ' + vDadosIni.codEmpresa;
    vCredQuit.buscas.Open;
    vCredQuit.vTotCred := 0;
    while not vCredQuit.buscas.eof do
    begin
      vCredQuit.vTotCred := vCredQuit.vTotCred + vCredQuit.buscas.FieldByName('VALOR_C').AsFloat;
      vCredQuit.buscas.next;
    end;
    Application.CreateForm(TFrmDetalheRecMod, FrmDetalheRecMod);
    FrmDetalheRecMod.vLanc := vLancQuit.vTotLanc;
    FrmDetalheRecMod.vCred := vCredQuit.vTotCred;
    FrmDetalheRecMod.vCheq := vCheqQuit.vTotCheq;
    FrmDetalheRecMod.showModal;

  finally
    vCredQuit.Free;
    vCredQuit := nil;
    vCheqQuit.Free;
    vCheqQuit := nil;
    vLancQuit.Free;
    vLancQuit := nil;
    FrmDetalheRecMod.Free;
    FrmDetalheRecMod := nil;
  end;
end;

procedure TCadClientes.DetalhesRecebimentoPrestacao;
var
  docs: string;
begin
  if not vDadosIni.PesqPros('CLI157', 'EXIBIR', '', 'CLIENTES',
    dataSet.FieldByName('COD_CLIENTE').asstring, buscas, true) then
    exit;
  try
    if vDetalheRec = nil then
      vDetalheRec := TDetalhesRec.Create;

    vDetalheRec.buscas.Close;
    vDetalheRec.buscas.sql.Text := 'select * from baixa_creditos ' +
    	' where codigo_emp = ' + inttostr(Creditos.buscas.fieldbyname('CODIGO_EMP').asinteger) +
      ' and cod_cred=' + inttostr(Creditos.buscas.fieldbyname('COD_CRED').asinteger) +
      ' order by cod_cred';
    vDetalheRec.buscas.Open;
    while not vDetalheRec.buscas.Eof do
    begin
      docs := docs + trim(vDetalheRec.buscas.FieldByName('N_DOC_C').asstring) + ' / ';
      vDetalheRec.buscas.Next;
    end;
    vDetalheRec.buscas.First;
    Application.CreateForm(TFrmDetalheRec, FrmDetalheRec);
    FrmDetalheRec.Cli := Cliente;
    FrmDetalheRec.Label1.Caption := 'Cliente: ' +
      Trim(dataSet.FieldByName('NOME_CLIENTE').AsString);
    FrmDetalheRec.Label2.Caption := 'Nº Documento: ' + docs;
    FrmDetalheRec.Label3.Caption := 'Valor Original do Crédito: ' + Format('%m',
      [vDetalheRec.buscas.FieldByName('VALOR_C').AsFloat]);
    FrmDetalheRec.Cli := self;
    FrmDetalheRec.showModal;
  finally
    FrmDetalheRec.Free;
    FrmDetalheRec := nil;
  end;
end;

