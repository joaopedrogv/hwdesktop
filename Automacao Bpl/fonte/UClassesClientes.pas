        ' left join retorna_vl_cred_aberto ( ' +
        '							cl.cod_cliente, ' +
        '							cl.cod_empresa, ' +
        '							cl.cpfcgc) cred_aberto on 1 = 1 ' +
        ' left join retorna_vl_chq_aberto ( ' +
        '							cl.cod_cliente, ' +
        '							cl.cod_empresa, ' +
        '							cl.cpfcgc) chq_aberto on 1 = 1 ' +
        ' left join retorna_vl_recant_aberto ( ' +
        '							cl.cod_cliente, ' +
        '							cl.cod_empresa, ' +
