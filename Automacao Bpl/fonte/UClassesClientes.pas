//             ' (' + IntToStr(buscas2.RecNo) + '/' + IntToStr(buscas2.RecordCount) + ')');
//
//           buscas.Close;
//           buscas.SQL.Text :=
//             ' execute procedure movimenta_estoque (' +
//             '	 :grupo_prod, ' +
//             '	 :cod_prod, ' +
//             '	 :cod_empresa, ' +
//             '	 :cod_grade, ' +
