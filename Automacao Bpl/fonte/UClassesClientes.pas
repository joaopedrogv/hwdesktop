function TContaCorrenteClientes.insert(pCodCliente: Integer; pCodEmpresa: Integer = 0; pCodTrans: Integer = 0): boolean;
var
  I: Integer;
begin
  Result := False;

   if not vDadosIni.PesqPros('CLI218', 'INCLUIR', 'CLIENTE: ' + IntToStr(pCodCliente),
     'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
    Exit;

  if not vDadosIni.verificaProgramaFid(buscas) then
    exit;

  Result := inherited insert;

  if not result then
    Exit;

  vCodTransf := 0;
  vCodEmpTransf := 0;
  
  dataSet.FieldByName('COD_EMPRESA').AsInteger := strToInt(vDadosIni.codEmpresa);
  dataSet.FieldByName('COD_EMP_RESP').AsInteger := strToInt(vDadosIni.codEmpresa);
  dataSet.FieldByName('COD_CLIENTE').AsInteger := pCodCliente;
  if pCodTrans > 0 then
  begin
    vCodTransf := pCodTrans;
    vCodEmpTransf := pCodEmpresa;
    SqlOpen(' select * from conta_corrente_prog_fidelidade ' +
    	' where codigo = ' + IntToStr(pCodTrans) +
      ' and cod_empresa = ' + IntToStr(pCodEmpresa));

    for I := 0 to dataSet.FieldCount - 1 do
     if (dataSet.Fields[I].FieldName <> 'COD_EMPRESA')
      and (dataSet.Fields[I].FieldName <> 'COD_CLIENTE')
      and (dataSet.Fields[I].FieldName <> 'COD_EMP_DEST')
      and (dataSet.Fields[I].FieldName <> 'COD_CLIENTE_DEST')
      and (dataSet.Fields[I].FieldName <> 'PENDENTE') then
       dataSet.Fields[I].Value := buscas.FieldByName(dataSet.Fields[I].FieldName).Value;

    SqlOpen(' select identificacao_emp, cgc_emp from empresa ' +
    	' where cod_empresa = ' + IntToStr(pCodEmpresa));
    dataSet.FieldByName('DESCRICAO').AsString := 'CRÉDITO REF TRANSFERÊNCIA DE SALDO - ' + trim(buscas.FieldByName('identificacao_emp').AsString);
    FrmCadClientes.GroupBoxEmpresaProgFid.Caption := 'Empresa origem:';
    FrmCadClientes.labelIdentificacaoLanc.Caption := trim(buscas.FieldByName('identificacao_emp').AsString);
    FrmCadClientes.labelCPFCNPJLanc.Caption := trim(buscas.FieldByName('cgc_emp').AsString);

    dataSet.FieldByName('TIPODOC').AsString := 'TRF';
    dataSet.FieldByName('TIPO').AsString := 'CRÉDITO';
    FrmCadClientes.DBComboBox16.ItemIndex := 0;
  end
  else if pCodEmpresa > 0 then
  begin
    SqlOpen(' select identificacao_emp, cgc_emp from empresa ' +
    	' where cod_empresa = ' + IntToStr(pCodEmpresa));
    dataSet.FieldByName('DESCRICAO').AsString := 'DÉBITO REF TRANSFERÊNCIA DE SALDO - ' + trim(buscas.FieldByName('identificacao_emp').AsString);
    FrmCadClientes.GroupBoxEmpresaProgFid.Caption := 'Empresa destino:';
    FrmCadClientes.labelIdentificacaoLanc.Caption := buscas.FieldByName('identificacao_emp').AsString;
    FrmCadClientes.labelCPFCNPJLanc.Caption := buscas.FieldByName('cgc_emp').AsString;

    SqlOpen(' select cpfcgc from clientes ' +
    	' where cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + 
      ' and cod_empresa = ' + vDadosIni.codEmpresa);

    // Atualizar saldo conta corrente
    vDadosIni.atualizarSaldoCC(
    	dataSet.FieldByName('COD_CLIENTE').AsInteger,
      buscas.FieldByName('CPFCGC').AsString,
    	FrmCadClientes.Label348,
      false,
      vQtdeGrid,
      buscas,
    	vSaldoCC,
      vValorCC,
      vPagGrid,
      vRecordPagGrid,
      vMaxPagGrid,
      vRecordCount);

    dataSet.FieldByName('PONTOS').AsFloat := vSaldoCC;

    dataSet.FieldByName('COD_EMP_DEST').AsInteger := pCodEmpresa;
    dataSet.FieldByName('COD_CLIENTE_DEST').AsInteger := vCodClienteDest;
    dataSet.FieldByName('TIPODOC').AsString := 'TRF';
    dataSet.FieldByName('TIPO').AsString := 'DÉBITO';
    dataSet.FieldByName('PENDENTE').AsString := 'S';
    FrmCadClientes.DBComboBox16.ItemIndex := 1;
  end;
  FrmCadClientes.GroupBoxEmpresaProgFid.Visible := pCodEmpresa > 0;
  FrmCadClientes.DBComboBox16.Enabled := pCodEmpresa <= 0;
  FrmCadClientes.DBEdit202.Enabled := pCodTrans <= 0;
end;

function TContaCorrenteClientes.marcaComoConcluida(pCodCliente: Integer): boolean;
begin
  try
    if not vDadosIni.PesqPros('CLI230', 'CONCLUIDO', 'CLIENTE: ' + IntToStr(pCodCliente),
     'CONTA_CORRENTE_PROG_FIDELIDADE', vTransSaldoProgFid.dataSet.FieldByName('CODIGO').AsString, buscas, true) then
    Exit;

    if not (vTransSaldoProgFid.dataSet.State in [dsInsert, dsEdit]) then    
      vTransSaldoProgFid.dataSet.Edit;
    vTransSaldoProgFid.dataSet.FieldByName('PENDENTE').AsString := 'N';
    vTransSaldoProgFid.dataSet.Post;

    if vTransSaldoProgFid.dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if result then
      result := vTransSaldoProgFid.apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI230', 'CONCLUIDO', 'SUCESSO', 'CONTA_CORRENTE_PROG_FIDELIDADE', vTransSaldoProgFid.dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI230', 'CONCLUIDO', 'FALHA', 'CONTA_CORRENTE_PROG_FIDELIDADE', vTransSaldoProgFid.dataSet.FieldByName('CODIGO').AsString, buscas);

  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContaCorrenteClientes.marcarDesmarcaLinha(vDataSet: TDataSet): boolean;
begin
  if vDataSet.IsEmpty then
    Exit;

  vDataSet.Edit;
  vDataSet.FieldByName('SEL').AsString := IfThen(vDataSet.FieldByName('SEL').AsString = 'S', '', 'S');
  vDataSet.Post;
end;

function TContaCorrenteClientes.post(pCodCliente: Integer; pCPFCGC: string; pCodEmpTransf, pCodTransf: Integer): boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

   if not vDadosIni.PesqPros('CLI220', acao, 'CLIENTE: ' + IntToStr(pCodCliente),
     'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
    Exit;

    if trim(dataSet.FieldByName('TIPO').AsString) = '' then
      raiseExceptionCreate('Natureza não informada!', 'DBComboBox16');
    if trim(dataSet.FieldByName('DESCRICAO').AsString) = '' then
      raiseExceptionCreate('Histórico não informado!', 'DBEdit201');
    if dataSet.FieldByName('PONTOS').AsFloat <= 0 then
      raiseExceptionCreate('Pontos não informado!', 'DBEdit202');

    if (trim(dataSet.FieldByName('TIPO').AsString) = 'DÉBITO')
      and (dataSet.FieldByName('COD_EMP_DEST').AsInteger > 0) then
    begin         
      // Atualizar saldo conta corrente
      vDadosIni.atualizarSaldoCC(
      	pCodCliente,
        pCPFCGC,
        FrmCadClientes.Label348,
        false,
        vQtdeGrid,
        buscas,
      	vSaldoCC,
        vValorCC,
        vPagGrid,
        vRecordPagGrid,
        vMaxPagGrid,
        vRecordCount);

      if dataSet.FieldByName('PONTOS').AsFloat > vSaldoCC then
        raiseExceptionCreate('Valor a transferir maior que o saldo disponível do cliente: ' + #13 + #13 +
          'Saldo disponível: ' + FormatFloat('#,##0', vSaldoCC) + #13 +
          'Valor a transferir: ' +FormatFloat('#,##0', dataSet.FieldByName('PONTOS').AsFloat), 'DBEdit202');
    end;
    
    // Buscas dados taxa conversão
    vDadosIni.buscasdadostaxaConv(buscas);
    dataSet.FieldByName('COD_TAXA_PROG_FID').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
    dataSet.FieldByName('PERC_PROG_FID').AsFloat := buscas.FieldByName('PERC_PROG_FID').AsFloat;
    dataSet.FieldByName('DATA_VENC_PROG').AsDateTime := vDadosIni.getDataBanco(buscas) + buscas.FieldByName('PERIODO_VENC_PONTOS').AsInteger;
    dataSet.FieldByName('VALOR').AsFloat := dataSet.FieldByName('PONTOS').AsFloat * dataSet.FieldByName('PERC_PROG_FID').AsFloat;
    dataSet.FieldByName('DATA').AsDateTime := vDadosIni.getDataBanco(buscas);
    dataSet.FieldByName('DATA_LANC').AsDateTime := vDadosIni.getDataBanco(buscas); 

    if dataSet.State in [dsInsert] then
      dataSet.FieldByName('CODIGO').AsInteger := Gencodigo('CONTA_CORRENTE_PROG_FIDELIDADE', DtmClientes.SpIncCodigo,
        vDadosIni.codEmpresa);

    if (trim(dataSet.FieldByName('TIPODOC').AsString) = 'TRF')
      and (trim(dataSet.FieldByName('TIPO').AsString) = 'DÉBITO') then
      dataSet.FieldByName('NDOC').AsInteger := dataSet.FieldByName('CODIGO').AsInteger;

    Result := inherited post;

    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      exit;
    end;

    if result then
      result := apply;

    if vCodTransf > 0 then
    begin
      buscas.Close;
      buscas.SQL.Text := ' update conta_corrente_prog_fidelidade set pendente = ''N'' ' +
        ' where codigo = ' + IntToStr(vCodTransf) +
        ' and cod_empresa = ' + IntToStr(vCodEmpTransf);
      buscas.ExecSQL;
    end;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI220', acao, 'SUCESSO', 'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI220', acao, 'FALHA', 'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas);
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContaCorrenteClientes.visualizarValeCompra(
