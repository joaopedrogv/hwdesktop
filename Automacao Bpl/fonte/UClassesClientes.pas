function TCadClientes.verificarCpfCnpjJaExite: boolean;
var
  vMensagem: string;
  vEfetivarComoCliente, vExisteNaLixeira, vExisteNoPossiveis, vExisteAtivo: Boolean;
  vCpfCgc, vCpfCgcAnt: string;
begin
  Result := False;
  if Trim(dataSet.FieldByName('cpfcgc').AsString) = '' then
    if not vDadosIni.vCliente.vConfCPF then
      Exit;

  // atual
  vCpfCgc := OnlyNumber(Trim(dataSet.FieldByName('cpfcgc').AsString));

  vExisteNaLixeira := ExecutaComandosSql('select first 1 cod_cliente from clientes' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 0' +
    ' and cpfcgc = ' + QuotedStr(vCpfCgc) +
    ' and cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger));
  vExisteAtivo := ExecutaComandosSql('select first 1 cod_cliente from clientes' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1' +
    ' and cpfcgc = ' + QuotedStr(vCpfCgc) +
    ' and cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger));
  vExisteNoPossiveis := ExecutaComandosSql('select first 1 cod_cliente from clientes' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 2' +
    ' and cpfcgc = ' + QuotedStr(vCpfCgc) +
    ' and cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger));

  if (not vExisteNaLixeira) and (not vExisteAtivo) and (not vExisteNoPossiveis) then
    Exit;

  buscas.Close;
  buscas.SQL.Text := 'select cod_cliente, nome_cliente, razao, cpfcgc, ativo from clientes' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = :ativo' +
    ' and cpfcgc = ' + QuotedStr(vCpfCgc) +
    ' and cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger);

  if vExisteAtivo then
  begin
    Result := True;
    buscas.ParamByName('ativo').AsInteger := 1;
    buscas.Open;
    buscas.FetchAll;
    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then // mode insercao
    begin
      if buscas.RecordCount > 1 then
      begin
        Application.MessageBox(PChar('Já existe mais de um cliente ativo com o CPF/CNPJ informado. O cadastro não pode continuar' + #13 +
          'Por favor corrija estes cadastros duplicados'), 'Atenção', 64);
        Exit;
      end
      else if buscas.RecordCount = 1 then
      begin
        vMensagem :=
          'Cliente se encontra ativo no cadastro com o mesmo CPF/CNPJ ' + #13 + #13 +
          'Codigo: ' + buscas.FieldByName('cod_cliente').AsString + #13 +
          'Nome: ' + buscas.FieldByName('nome_cliente').AsString + #13 +
          'Razao Social: ' + buscas.FieldByName('razao').AsString + #13 +
          'CPF/CNPJ: ' + buscas.FieldByName('cpfcgc').AsString + #13 + #13 +
          'Deseja cancelar este cadastro e editar o cliente encontrado?';
        if Application.MessageBox(PChar(vMensagem), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          Cancel;
          montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
            Fsql_inner +
            ' WHERE CLIENTES.COD_CLIENTE = ' + IntToStr(buscas.FieldByName('COD_CLIENTE').AsInteger) +
            ' AND CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa);
          if Edit then
            Exit
          else
          begin
            Application.MessageBox(PChar('Não foi possivel selecionar o registro para alteração' + #13 +
              'Localize manualmente o registro para continuar'), 'Atenção', 64);
            Exit;
          end;
        end
        else
        begin
          Exit;
        end;
      end;
    end
    else // modo edicao
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select cpfcgc from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Open;
      // anterior
      vCpfCgcAnt := Trim(buscas2.FieldByName('cpfcgc').AsString);

      if vCpfCgc <> vCpfCgcAnt then // cpf atual difere do anterior, foi alterado
      begin
        Application.MessageBox(PChar('Já existe(m) cliente(s) ativo(s) com o CPF/CNPJ informado. O cadastro não pode continuar' + #13 +
          'Por favor corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Exit;
      end;

      if buscas.RecordCount >= 1 then // mais de um registro com o mesmo cpfcgc
      begin
        Application.MessageBox(PChar('Existe(m) cliente(s) ativo(s) com o CPF/CNPJ informado' + #13 +
          'Por favor corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Result := False;
      end;
    end;
  end;

  if vExisteNaLixeira then
  begin
    Result := True;
    buscas.Close;
    buscas.ParamByName('ativo').AsInteger := 0;
    buscas.Open;
    buscas.FetchAll;

    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then // insercao
    begin
      if buscas.RecordCount > 1 then
      begin
        Application.MessageBox(PChar('Já existe mais de um cliente na lixeira com o CPF/CNPJ informado. O cadastro não pode continuar' + #13 +
          'Por favor corrija estes cadastros duplicados'), 'Atenção', 64);
        Exit;
      end
      else if buscas.RecordCount = 1 then
      begin
        vMensagem :=
          'Cliente se encontra na lixeira com o mesmo CPF/CNPJ ' + #13 + #13 +
          'Codigo: ' + buscas.FieldByName('cod_cliente').AsString + #13 +
          'Nome: ' + buscas.FieldByName('nome_cliente').AsString + #13 +
          'Razao Social: ' + buscas.FieldByName('razao').AsString + #13 +
          'CPF/CNPJ: ' + buscas.FieldByName('cpfcgc').AsString + #13 + #13 +
          'Deseja mover o registro da lixeira para o cadastro de clientes?';
        if Application.MessageBox(PChar(vMensagem), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin  
          Cancel;
          montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
            Fsql_inner +
            ' WHERE CLIENTES.COD_CLIENTE = ' + IntToStr(buscas.FieldByName('COD_CLIENTE').AsInteger) +
            ' AND CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa);
          if Edit then
          begin
            dataset.FieldByName('ativo').AsInteger := 1;
            Exit;
          end
          else
          begin
            Application.MessageBox(PChar('Não foi possivel selecionar o registro para alteração' + #13 +
              'Localize manualmente o registro para continuar'), 'Atenção', 64);
            Exit;
          end;
        end
        else
        begin
          Exit;
        end;
      end;
    end
    else // edicao
    begin 
      buscas2.Close;
      buscas2.SQL.Text := 'select cpfcgc from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Open;
      // anterior
      vCpfCgcAnt := Trim(buscas2.FieldByName('cpfcgc').AsString);

      if vCpfCgc <> vCpfCgcAnt then // cpf atual difere do anterior, foi alterado
      begin
        Application.MessageBox(PChar('Já existe(m) cliente(s) na lixeira(s) com o CPF/CNPJ informado. O cadastro não pode continuar' + #13 +
          'Por favor verifique na lixeira e corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Exit;
      end;

      if buscas.RecordCount >= 1 then // mais de um registro com o mesmo cpfcgc
      begin
        Application.MessageBox(PChar('Existe(m) cliente(s) na lixeira com o CPF/CNPJ informado' + #13 +
          'Por favor corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Result := False;
      end;
    end;
  end;

  if vExisteNoPossiveis then
  begin
    Result := True;
    buscas.Close;
    buscas.ParamByName('ativo').AsInteger := 2;
    buscas.Open;
    buscas.FetchAll;

    if dataSet.FieldByName('cod_cliente').AsInteger = 0 then // insercao
    begin
      if buscas.RecordCount > 1 then
      begin
        Application.MessageBox(PChar('Já existe mais de um cliente cadastrado como Possivel Cliente. O cadastro não pode continuar' + #13 +
          'Por favor corrija estes cadastros duplicados'), 'Atenção', 64);
        Exit;
      end
      else if buscas.RecordCount = 1 then
      begin
        vMensagem :=
          'Cliente se encontra no cadastro de Possiveis Clientes com o mesmo CPF/CNPJ ' + #13 + #13 +
          'Codigo: ' + buscas.FieldByName('cod_cliente').AsString + #13 +
          'Nome: ' + buscas.FieldByName('nome_cliente').AsString + #13 +
          'Razao Social: ' + buscas.FieldByName('razao').AsString + #13 +
          'CPF/CNPJ: ' + buscas.FieldByName('cpfcgc').AsString + #13 + #13 +
          'Deseja mover o registro para o cadastro de clientes?';
        if Application.MessageBox(PChar(vMensagem), 'Confirmação', MB_ICONQUESTION + MB_YESNO) = IDYES then
        begin
          Cancel;
          montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
            Fsql_inner +
            ' WHERE CLIENTES.COD_CLIENTE = ' + IntToStr(buscas.FieldByName('COD_CLIENTE').AsInteger) +
            ' AND CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa);
          if Edit then
          begin
            dataset.FieldByName('ativo').AsInteger := 1;
            Exit;
          end
          else
          begin
            Application.MessageBox(PChar('Não foi possivel selecionar o registro para alteração' + #13 +
              'Localize manualmente o registro para continuar'), 'Atenção', 64);
            Result := True;
            Exit;
          end;
        end
        else if not vDadosIni.PesqPros('CLI198', 'VALIDAR', 'CPF/CNPJ:' + vCpfCgc, 'CLIENTES', '', buscas,
          True, True, True) then
          Exit;
      end;
    end
    else // edicao
    begin 
      buscas2.Close;
      buscas2.SQL.Text := 'select cpfcgc from clientes' +
        ' where cod_cliente = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Open;
      // anterior
      vCpfCgcAnt := Trim(buscas2.FieldByName('cpfcgc').AsString);

      if vCpfCgc <> vCpfCgcAnt then // cpf atual difere do anterior, foi alterado
      begin
        Application.MessageBox(PChar('Já existe(m) cliente(s) no cadastro de Possiveis Clientes. O cadastro não pode continuar' + #13 +
          'Por favor verifique e corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Exit;
      end;

      if buscas.RecordCount >= 1 then // mais de um registro com o mesmo cpfcgc
      begin
        Application.MessageBox(PChar('Existe(m) cliente(s) no cadastro de Possíveis Clientes com o CPF/CNPJ informado' + #13 +
          'Por favor corrija este(s) cadastro(s) duplicado(s)'), 'Atenção', 64);
        Result := False;
      end;
    end;

  end;
end;

function TCadClientes.verificarTelefoneCelular(pTestar: boolean; pCodCliente: Integer;
 pCpfCgc: string; pEmail: string; pCelular: string): boolean;
var
 vdigitocontrole: Integer;
 I: Integer;
 vmensagem: string;
 J: Integer;
 vListEmail: TStringList;
begin
  inherited;
  Result := true;

  if vDadosIni.vEmp.vConfFormPagamento <> 'PED' then
    exit;

  if not vDadosIni.vProgFid.vHabilitarProgFid then
    exit;

  if not vDadosIni.vProgFid.vHabilitarProgFidAPI then
    exit;

  if StrToInt(vDadosIni.vCliente.vCodClientePadrao) = pCodCliente then
    exit;

  if not vDadosIni.vProgFid.vHabilitarFuncaoCNPJIntegracaoAPI then
	  if Length(trim(pCpfCgc)) <> 11 then
  		exit;

  pCelular  := vDadosIni.apenasNumeros(pCelular);  

  vListEmail := TStringList.create;
  if Pos(';', pEmail) > 0 then
    vListEmail := vDadosIni.Split(pEmail, ';')
  else if Pos(',', pEmail) > 0 then
    vListEmail := vDadosIni.Split(pEmail, ',')
  else if Pos('|', pEmail) > 0 then
    vListEmail := vDadosIni.Split(pEmail, '|')
  else
  begin
    vListEmail.Add(pEmail);
  end;

  if trim(pCelular) = '' then
  begin
    Application.MessageBox(pchar('Celular não informado!'), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);

    if (pTestar) then
    begin
      Result := false;

      if not vDadosIni.PesqPros('CLI250', 'PERMITIR', '', 'CLIENTES',
      	IntToStr(pCodCliente), buscas, true) then
      begin
        Application.MessageBox(pchar('Celular não informado!'), 'Erro', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      Result := true;
    end
  end;

  if not pTestar then
    exit;

   // Testar tamanho do telefone
   if Length(trim(pCelular)) = 11 then
   begin
     // Verificar o 3º dígito
     vdigitocontrole := StrToInt(Copy(trim(pCelular), 3, 1));
     if not ((vdigitocontrole >= 6) and (vdigitocontrole <= 9)) then
     begin
       if pTestar then
         Application.MessageBox(PChar('Telefone informado não é celular!'),
           'Erro', MB_OK + MB_ICONERROR + MB_DEFBUTTON1)
       else
         Application.MessageBox(PChar('Telefone informado não é celular!'),
           'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
       if (pTestar) then Result := false;
       exit;
     end
     else if (pTestar) then
     begin
       SqlOpen(' select first 6 cod_cliente, nome_cliente, '  +
        ' email, cpfcgc, fone_celular from clientes ' +
        ' where fone_celular = ' + QuotedStr(pCelular) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_cliente <> ' + IntToStr(pCodCliente));
       if not buscas.IsEmpty then
       begin
         vmensagem := '';
         J := 0;

         buscas.First;
         while not buscas.Eof do
         begin
           Inc(J);
           vmensagem := vmensagem +
             IntToStr(buscas.FieldByName('cod_cliente').AsInteger) +
             ' - ' + trim(buscas.FieldByName('nome_cliente').AsString) +
             ' (' + trim(buscas.FieldByName('cpfcgc').AsString) + ')' + #13;
           buscas.Next;
         end;
         if buscas.RecordCount > 5 then
          vmensagem := vmensagem + '...';

         Result := false;

         vmensagem := 'Celular ' +
         		QuotedStr(trim(buscas.FieldByName('fone_celular').AsString)) +
         		' sendo utilizado em outro(s) cliente(s): ' + #13 + vmensagem;

         Application.MessageBox(Pchar(vmensagem), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);

         if not vDadosIni.PesqPros('CLI251', 'PERMITIR', '', 'CLIENTES',
          IntToStr(pCodCliente), buscas, true) then
         begin
           Application.MessageBox(pchar(vmensagem), 'Erro', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
           exit;
         end;

         Result := true;
       end;
     end;
   end
   else if trim(pCelular) <> '' then
   begin
     Application.MessageBox(PChar('Telefone informado não é celular!'), 'Atenção', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
     if (pTestar) then Result := false;
     exit;
   end;
end;

