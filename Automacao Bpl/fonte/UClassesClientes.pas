      ' from pedvenda ' +
      ' WHERE cod_cliente = ' + ClasseCli.buscas.FieldByName('COD_CLIENTE').asstring +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and status_ped = ''FECHADA'' ' +
      ' and ativo=1 ' +
      ' and ((tipo = ''OS'' and tipo_os in ' + vDadosIni.vTipoVendaOS + ') or (tipo = ''REQ''))' +
      //correção
      ' order by DATA_FECH desc ';
    buscas.open;
    if not buscas.IsEmpty then
    begin
      if not buscas.FieldByName('DATA_FECH').isnull then
        vdata := buscas.FieldByName('DATA_FECH').value;
