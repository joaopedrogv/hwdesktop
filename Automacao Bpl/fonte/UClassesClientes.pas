                    ' (emp.cod_empresa || '' - '' || trim(coalesce(emp.identificacao_emp, ''''))) identificacao_emp, ' +
                    ' (select sum(case when(trim(cc2.tipo) = ''CRÉDITO'') then ' +
                    '             cc2.pontos ' +
                    '         else ' +
                    '             (-1) * cc2.pontos end) pontos from conta_corrente_prog_fidelidade cc2 ' +
                    ' inner join clientes cl2 on cl2.cod_cliente = cc2.cod_cliente and cl2.cod_empresa = cc2.cod_empresa ' +
                    ' left join empresa_prog_fid empg2 on coalesce(cc2.cod_emp_resp, cc2.cod_empresa) = empg2.cod_empresa ' +
