function TRedistribuirCarteiras._moverClientesParaColaboradorSelecionado: Boolean;
var
  vtemp, vFiltro: string;
begin
  try
    dataSet.Filter := 'sel = ''S''';
    dataSet.Filtered := True;
    vtemp := '';

    try

      dataSet.First;
      while not dataSet.Eof do
      begin
        Application.ProcessMessages;
        vtemp := ',' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) + vtemp;
        vDadosIni.GravaAuditoria('CLI185', 'ALTERAR',
          'VEND ' + dataSet.FieldByName('COD_VENDEDOR').AsString +
          ' NOVO ' + vColabDest.dataSet.FieldByName('COD_VENDEDOR').AsString, 'CLIENTES',
          IntToStr(dataSet.FieldByName('cod_cliente').AsInteger), buscas);
        dataSet.Next;
      end;
      if vtemp = '' then
        raiseExceptionCreate('Nenhum registro selecionado', '');

      vtemp := Copy(vtemp, 2, length(vtemp));

      buscas.Close;
      if (Trim(vColabDest.dataSet.FieldByName('NOME_VENDEDOR').AsString) = 'SEM VINCULO') and
       (vColabDest.dataSet.FieldByName('cod_vendedor').AsInteger = 0) then
        buscas.SQL.Text := 'update clientes set cod_vendedor = null' +
          ' where cod_cliente in (' + vtemp + ') and cod_empresa = ' + vDadosIni.codEmpresa
      else
        buscas.SQL.Text := 'update clientes set cod_vendedor = ' + IntToStr(vColabDest.dataSet.FieldByName('cod_vendedor').AsInteger) +
          ' where cod_cliente in (' + vtemp + ') and cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.ExecSQL;

      Result := CommitaTransacao;
      if Result then
      begin
        vDadosIni.GravaAuditoria('CLI185', 'ALTERAR', 'SUCESSO', 'CLIENTES', '', buscas);
        Application.MessageBox('Processo concluído com sucesso!', 'Atenção', 64);
      end
      else
        vDadosIni.GravaAuditoria('CLI185', 'ALTERAR', 'FALHA', 'CLIENTES', '', buscas);

    except on e: exception do
      begin
        RollBackTransacao;
        Result := False;
        vDadosIni.GravaAuditoria('CLI185', 'ALTERAR', 'FALHA', 'CLIENTES', '', buscas);
        registraErro('TRedistribuirCarteiras._moverClientesParaColaboradorSelecionado. Erro: ' + e.Message);
        Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', 0 + 64);
      end;
    end;

  finally
    dataSet.Refresh;
    dataSet.Filter := vFiltro;
    dataSet.Filtered := True;
  end;
end;

