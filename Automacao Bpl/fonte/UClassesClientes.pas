                     buscas.ParamByName('COD_EMPRESA').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
                     buscas.ParamByName('NDOC').AsInteger := vReq;
                     buscas.ParamByName('TIPODOC').AsString := vtiporeq;
                     buscas.ParamByName('COD_EMP_TIPODOC').AsInteger := StrToInt(vDadosIni.codEmpresa);
                     buscas.ExecSQL;
                   end;

                   vResgateValeCupom.dataSet.Next;
