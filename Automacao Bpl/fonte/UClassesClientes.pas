procedure TCadClientes._carregarCartaemWord(pCodCarta: Integer);
var
	vRichText: TRichEdit;
  vSr: TSearchRec;
  vDestino : string;
  vTemp: Integer;
begin
  if (vDadosIni.vOpenOfficeExportRel = 'S') then
  begin
  	vTemp := Random(1000);

    if not DirectoryExists(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas') then
      CreateDir(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas');

    if not DirectoryExists(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas') then
    	CreateDir(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas');

    if not DirectoryExists(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas') then
    begin
	    Application.MessageBox(pchar('Não foi possível criar diretório. ' + #13 + #13 +
      	'Diretório: ' + vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas'), 'Atenção', MB_ICONERROR + MB_OK);
      exit;
    end;

    FindFirst(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas' + '\*.rtf', faDirectory, vSr);
    while FindNext(vSr) = 0 do
    begin
      if vSr.Name <> '..' then
      begin
        if pos('rtf', vSr.Name) > 0 then
          DeleteFile(PChar(vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas' + '\' + vSr.Name));
      end;
    end;

  	vDestino := vDadosIni._getSpecialFolderPath(CSIDL_APPDATA) + '\Hw Sistemas\ModCartas\' + IntToStr(pCodCarta) + '-' + IntToStr(vTemp) + '.rtf';

  	vRichText         := TRichEdit.Create(Application);
    vRichText.Parent  := FrmCadClientes;
    vRichText.Visible := false;
    vRichText.Clear;
    vRichText.Name    := 'vRichText' + IntToStr(vTemp);
    vRichText.Text    :=
    	vDadosIni._TrocaTAGsDaCarta(
        cCliente,
      	pCodCarta,
        dataSet.FieldByName('COD_CLIENTE').AsInteger,
        '',
        '',
        0,
        0,
        '-1'
      );

    try
      vRichText.Lines.SaveToFile(vDestino);

      vDadosIni.WriteToOpWrite(vDestino);

    finally
    	if FileExists(vDestino) then
      	DeleteFile(PChar(vDestino));
    end;
  end
  else
    vDadosIni.WriteToMSWord(
    	vDadosIni._TrocaTAGsDaCarta(
        cCliente,
        pCodCarta,
      	dataSet.FieldByName('COD_CLIENTE').AsInteger,
        '',
        '',
        0,
        0,
        '-1'
      )
    );
end;

