function TCadClientes.getCodClienteEmpresas(vCpfCnpj,
  vCodEmpresa: string): integer;
begin
  buscas.Close;
  buscas.SQL.text := 'select cod_cliente from clientes where cpfcgc = ' + QuotedStr(vCpfCnpj) +
    ' and ativo = 1 and cod_empresa = ' + vCodEmpresa;
  buscas.open;
  if buscas.IsEmpty then
    result := 0
  else
    result := buscas.fieldbyname('cod_cliente').AsInteger;
  buscas.close;
end;

procedure TCadClientes.GravaLogConfirmacao(Processo, Status: string; SimNao: boolean);
begin
  if SimNao then
  begin
    if Status = 'E' then
      vDadosIni.GravaAuditoria(Processo, 'ALTERACAO CONFIRMADA', 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
        //      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
    else if Status = 'I' then
      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO CONFIRMADA', 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
    //      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
  end
  else
  begin
    if Status = 'E' then
      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
        //      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO NÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
    else if Status = 'I' then
      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO NÃO CONFIRMADA', 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
    //      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO NÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
  end;
end;

procedure TCadClientes.ImprimirReciboCredito;
var
  RdImpRec: TRelatoriosCli;
  docsDoRecibo, dataVencRecibos, valorporextenso, strTemp: AnsiString;
  i, quebradelinha, meioFolha, qtdCaracterLinha: integer;
  TotalRecibos: Currency;
  unicoRecibo: boolean;
  strTempRestante: string;
begin
  if vDetalheRec.buscas.IsEmpty then
    exit;
  RdImpRec := TRelatoriosCli.create;
  RdImpRec.rdp.OpcoesPreview.CaptionPreview := 'Recibo do Cliente';
  RdImpRec.rdp.CaptionSetup := 'Configurar impressão do Recibo do cliente';
  RdImpRec.rdp.TitulodoRelatorio := 'Recibo do Cliente';
  vDadosIni._LimparVarSendEmail;
  RdImpRec.rdp.OnSendMail := vDadosini._SendMailRdPrint;
  RdImpRec.rdp.OpcoesPreview.Preview := true;
  RdImpRec.rdp.FonteTamanhoPadrao := S17cpp;
  RdImpRec.rdp.TamanhoQteColunas := 80;
  meioFolha := trunc(RdImpRec.rdp.TamanhoQteColunas / 2);
  qtdCaracterLinha := 81;
  if not vDadosIni.ModImp(RdImpRec.rdp) then
    exit;
  RdImpRec.linha := 1;
  RdImpRec.rdp.abrir;
  RdImpRec.rdp.Imp(RdImpRec.linha, 1, vDadosIni.Replicate('_', RdImpRec.rdp.TamanhoQteColunas));
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.query.Close;
  RdImpRec.query.SQL.Text := 'select * from baixa_creditos where codigo_emp=' + vDadosIni.codEmpresa
    +
    ' and cod_cred=' + inttostr(Creditos.buscas.fieldbyname('COD_CRED').asinteger);
  RdImpRec.query.Open;
  docsDoRecibo := '';
  dataVencRecibos := '';
  TotalRecibos := 0;
  unicoRecibo := false;
  if
    Application.MessageBox(PChar('Deseja imprimir todas as baixas do crédito em um único recibo?'),
    'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
  begin
    unicoRecibo := true;
    RdImpRec.query.First;
    while not RdImpRec.query.Eof do
    begin
      TotalRecibos := TotalRecibos + RdImpRec.query.FieldByName('VALOR_QUITADO').AsCurrency;
      docsDoRecibo := docsDoRecibo + trim(RdImpRec.query.FieldByName('N_DOC_C').asstring) + ' / ';
      dataVencRecibos := dataVencRecibos + RdImpRec.query.FieldByName('DATA_VENC_C').asstring +
        ' - ';
      RdImpRec.query.Next;
    end;
  end
  else
  begin
    if RdImpRec.query.Locate('SEQ_BXCRED', vDetalheRec.buscas.fieldbyname('SEQ_BXCRED').asinteger,
      []) then
    begin
      TotalRecibos := TotalRecibos + RdImpRec.query.FieldByName('VALOR_QUITADO').AsCurrency;
      docsDoRecibo := docsDoRecibo + trim(RdImpRec.query.FieldByName('N_DOC_C').asstring) + ' / ';
      dataVencRecibos := dataVencRecibos + trim(RdImpRec.query.FieldByName('DATA_VENC_C').asstring)
        +
        ' - ';
    end;
  end;
  if TotalRecibos <= 0 then
  begin
    Application.MessageBox(PChar('Não é possível imprimir recibo com valor igual a zero'),
      'Aviso', MB_OK + MB_ICONWARNING + MB_DEFBUTTON1);
    exit;
  end;
  strTemp := 'RECIBO : ' + copy(docsDoRecibo, 1, length(docsDoRecibo) - 2);
  while Length(strTemp) > qtdCaracterLinha do
  begin
    for I := qtdCaracterLinha downto 1 do
    begin
      if (strTemp[i] = '/') then
      begin
        quebradelinha := i;
        break;
      end;
    end;
    RdImpRec.rdp.Imp(RdImpRec.linha, 1, copy(strTemp, 1, quebradelinha - 1));
    RdImpRec.linha := RdImpRec.linha + 1;
    strTemp := copy(strTemp, quebradelinha + 1, length(strTemp))
  end;
  RdImpRec.rdp.Imp(RdImpRec.linha, 1, trim(copy(strTemp, 1, length(strTemp) - 1)));
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.Imp(RdImpRec.linha, 1, 'CLIENTE: ' +
    vDadosIni.strzero(dataSet.FieldByName('COD_CLIENTE').AsInteger, 6));
  RdImpRec.linha := RdImpRec.linha + 2;

  if length('Recebemos de: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString) +
    ' a quantia supra de ' + format('%m', [TotalRecibos])) + 10 < qtdCaracterLinha then
    RdImpRec.rdp.Imp(RdImpRec.linha, 10, 'Recebemos de: ' +
      trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' a  quantia supra de ' + format('%m',
      [TotalRecibos]))
  else
  begin
    quebradelinha := pos(' R$', 'Recebemos de: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString)
      + ' a  quantia supra de ' + format('%m', [TotalRecibos]));
    RdImpRec.rdp.Imp(RdImpRec.linha, 10, copy('Recebemos de: ' +
      trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' a  quantia supra de ' + format('%m',
      [TotalRecibos]), 1, quebradelinha));
    RdImpRec.linha := RdImpRec.linha + 1;
    RdImpRec.rdp.Imp(RdImpRec.linha, 1, trim(copy('Recebemos de: ' +
      trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' a  quantia supra de ' + format('%m',
      [TotalRecibos]), quebradelinha, 20)));
    RdImpRec.rdp.Imp(RdImpRec.linha, length(trim(copy('Recebemos de: ' +
      trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' a  quantia supra de ' + format('%m',
      [TotalRecibos]), quebradelinha, 20))), ' ' +
      vDadosIni.replicate('*', qtdCaracterLinha - 1 - length(trim(copy('Recebemos de: ' +
      trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' a  quantia supra de ' + format('%m',
      [TotalRecibos]), quebradelinha, 20)))));
  end;
  RdImpRec.linha := RdImpRec.linha + 1;

  valorporextenso := vDadosIni.NumeroParaExtenso(TotalRecibos);
  while length(valorporextenso) > qtdCaracterLinha do
  begin
    strTemp := TrimLeft(copy(valorporextenso, 1, qtdCaracterLinha));
    for I := qtdCaracterLinha downto 1 do
    begin
      if (strTemp[i] = ' ') then
      begin
        quebradelinha := i;
        break;
      end;
    end;
    strTemp := trim(copy(valorporextenso, 1, quebradelinha));
    valorporextenso := trim(copy(valorporextenso, quebradelinha, length(valorporextenso)));
    RdImpRec.rdp.imp(RdImpRec.linha, 1, strTemp);
    RdImpRec.linha := RdImpRec.linha + 1;
  end;
  strTemp := Trim(copy(valorporextenso, 1, length(valorporextenso)));
  RdImpRec.rdp.imp(RdImpRec.linha, 1, strTemp + ' ' + vDadosIni.replicate('*', qtdCaracterLinha - 2
    - length(strTemp)));
  RdImpRec.linha := RdImpRec.linha + 2;

  if unicoRecibo then //Caso seja uma única impressão de varios recibos de mesmo
  begin
    strTemp := 'Referente as notas promissorias: ' + copy(docsDoRecibo, 1, length(docsDoRecibo) -
      2);
    while Length(strTemp) > qtdCaracterLinha do
    begin
      for I := qtdCaracterLinha downto 1 do
      begin
        if (strTemp[i] = '/') then
        begin
          quebradelinha := i;
          break;
        end;
      end;
      RdImpRec.rdp.Imp(RdImpRec.linha, 1, copy(strTemp, 1, quebradelinha - 1));
      RdImpRec.linha := RdImpRec.linha + 1;
      strTemp := copy(strTemp, quebradelinha + 1, length(strTemp))
    end;
    RdImpRec.rdp.Imp(RdImpRec.linha, 1, trim(copy(strTemp, 1, length(strTemp) - 1)));
    RdImpRec.linha := RdImpRec.linha + 1;

    strTemp := 'Com respectivos Vencimentos em: ' + copy(dataVencRecibos, 1, length(dataVencRecibos)
      - 2);
    while Length(strTemp) > qtdCaracterLinha do
    begin
      for I := qtdCaracterLinha downto 1 do
      begin
        if (strTemp[i] = '-') then
        begin
          quebradelinha := i;
          break;
        end;
      end;
      RdImpRec.rdp.Imp(RdImpRec.linha, 1, copy(strTemp, 1, quebradelinha - 1));
      RdImpRec.linha := RdImpRec.linha + 1;
      strTemp := copy(strTemp, quebradelinha + 1, length(strTemp))
    end;
    RdImpRec.rdp.Imp(RdImpRec.linha, 1, trim(copy(strTemp, 1, length(strTemp) - 1)));
    RdImpRec.linha := RdImpRec.linha + 2;
  end
  else
  begin
    RdImpRec.rdp.Imp(RdImpRec.linha, 1, 'Referente a nota promissoria: ' + copy(docsDoRecibo, 1,
      length(docsDoRecibo) - 2) + ' Com Vencimento em: ' + copy(dataVencRecibos, 1,
      length(dataVencRecibos) - 2));
    RdImpRec.linha := RdImpRec.linha + 2;
  end;

  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, trim(vDadosIni.vEmp.vCidade) + ', ' +
    datetostr(date),
    [comp17]);
  RdImpRec.linha := RdImpRec.linha + 3;
  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, vDadosIni.replicate('_',
    length(vDadosIni.vEmp.vnomeEmpresa)), [comp17]);
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, trim(vDadosIni.vEmp.vnomeEmpresa), [comp17]);
  RdImpRec.linha := RdImpRec.linha + 2;
  RdImpRec.rdp.Imp(RdImpRec.linha, 1, vDadosIni.replicate('_', RdImpRec.rdp.TamanhoQteColunas));
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, trim(vDadosIni.vEmp.vEndereco) + ', ' +
    trim(vDadosIni.vEmp.vNumeroEnd) + ', ' + trim(vDadosIni.vEmp.vBairro) + ' CEP: ' +
    trim(vDadosIni.vEmp.vCEP), [comp17]);
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, trim(vDadosIni.vEmp.vCidade) + ' - ' +
    trim(vDadosIni.vEmp.vSiglaUF), [comp17]);
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.ImpC(RdImpRec.linha, meioFolha, 'Inscr. Estadual: ' + trim(vDadosIni.vEmp.vIE) +
    ' - CNPJ: ' + trim(vDadosIni.vEmp.vCNPJ), [comp17]);
  RdImpRec.linha := RdImpRec.linha + 1;
  RdImpRec.rdp.Imp(RdImpRec.linha, 1, vDadosIni.replicate('_', RdImpRec.rdp.TamanhoQteColunas));
  RdImpRec.rdp.Fechar;
end;

function TCadClientes.insert: boolean;
begin
	if not dataSet.Active then
    abreClientes(0);

  Result := inherited Insert;
  if Result then
  begin
	  dataSet.FieldByName('CL_GERAR_PONTOS').AsString := 'S';
    dataSet.FieldByName('REC_NOT').AsString := 'S';
    dataSet.FieldByName('BARRAMENTO_AUTOMATICO').AsString := 'S';
  end;
  vCondPagVND.abreCondPag('VND', dataSet.FieldByName('COND_PAG_VND').AsString);
  vCondPagPre.abreCondPag('PRE', dataSet.FieldByName('COND_PAG_PRE').AsString);
  CupomDescontoCliente.abreCupomDesconto(-1);
  EndDocAd.abrir;
  Frotas.Iniciar(0);
  FtribAd.Iniciar(0);
  FContato.Abrir;
  FContatoMsg.Abrir;

  if (Result) and (fCadastroSimplificado) then
  begin
    abreTipoCliente;
    PreencheCampos;
  end;
end;

function TCadClientes.JaExisteCPFCNPJ: boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select * from clientes where cpfcgc = ' +
    quotedstr(dataSet.FieldByName('CPFCGC').AsString) + ' and cod_empresa = ' +
    vDadosIni.codEmpresa;
  buscas.Open;
  if (not buscas.IsEmpty) and (dataset.FieldByName('COD_CLIENTE').AsInteger <>
    buscas.FieldByName('COD_CLIENTE').AsInteger) then
    //(dataSet.FieldByName('CPFCGC').AsString <> dataSet.FieldByName('CPFCGC').OldValue) then
  begin
    if buscas.FieldByName('ATIVO').AsInteger = 2 then
    begin
      if Application.MessageBox(PChar('O cliente de CPF/CNPJ ''' +
        dataSet.FieldByName('CPFCGC').asstring + ''' já está cadastrado como possível cliente. '
        +
        chr(13) +
        'Deseja alterar os dados deste cliente e torná-lo efetivo cliente desta empresa?'),
        'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
      begin
        Cancel;
        montaSelect(' SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
          Fsql_inner +
          ' WHERE CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa +
          ' AND CLIENTES.ATIVO = 2 ' +
          ' AND CLIENTES.CPFCGC = ' + QuotedStr(buscas.FieldByName('CPFCGC').AsString));
        dataSet.IndexFieldNames := 'CPFCGC';
        dataSet.FindNearest([buscas.FieldByName('CPFCGC').AsString]);
        if (dataSet.FieldByName('CPFCGC').AsString = buscas.FieldByName('CPFCGC').AsString) then
        begin
          Edit;
          dataSet.FieldByName('ATIVO').AsInteger := 1;
          Result := false;
        end;
      end
      else
        result := true;
    end
    else if buscas.FieldByName('ATIVO').AsInteger = 1 then
    begin
      if Application.MessageBox(PChar('O cliente de CPF/CNPJ ''' +
        dataSet.FieldByName('CPFCGC').asstring + ''' já está cadastrado. ' + chr(13) +
        'Deseja alterar os dados deste cliente?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = mrYES then
      begin
        Cancel;
        montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
          Fsql_inner +
          ' WHERE CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa +
          ' AND CLIENTES.ATIVO = 1 ' +
          ' AND CLIENTES.CPFCGC = ' + QuotedStr(buscas.FieldByName('CPFCGC').AsString));
        dataSet.IndexFieldNames := 'CPFCGC';
        dataSet.FindNearest([buscas.FieldByName('CPFCGC').AsString]);
        if (dataSet.FieldByName('CPFCGC').AsString = buscas.FieldByName('CPFCGC').AsString) then
        begin
          Edit;
          Result := false;
        end;
      end
      else
        result := true;
    end
    else if buscas.FieldByName('ATIVO').AsInteger = 0 then
    begin
      if Application.MessageBox(PChar('O cliente de CPF/CNPJ ''' +
        dataSet.FieldByName('CPFCGC').asstring +
        ''' já está cadastrado mas não está ativo no banco de dados.' + chr(13) +
        'Deseja voltá-lo para o ativo e alterar seus dados?'), 'Confirmação', MB_YESNO +
        MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
      begin
        Cancel;
        montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
          Fsql_inner +
          ' WHERE CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa +
          ' AND CLIENTES.ATIVO = 0 ' +
          ' AND CLIENTES.CPFCGC = ' + QuotedStr(buscas.FieldByName('CPFCGC').AsString));
        dataSet.IndexFieldNames := 'CPFCGC';
        dataSet.FindNearest([buscas.FieldByName('CPFCGC').AsString]);
        if (dataSet.FieldByName('CPFCGC').AsString = buscas.FieldByName('CPFCGC').AsString) then
        begin
          Edit;
          dataSet.FieldByName('ATIVO').AsInteger := 1;
          Result := false;
        end;
      end
      else
        result := true;
    end
    else
      result := false;
  end
  else
    result := false;
end;

