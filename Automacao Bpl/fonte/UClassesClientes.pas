function TCadClientes._gravarAtributos(vCod: Integer): Boolean;
var
 buscas2: TIBQuery;
begin
  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

 fTempAtributos.First;
 while not fTempAtributos.Eof do
 begin
  buscas2.Close;
  buscas2.SQL.Text := ' select * from atributos_fornec' +
   ' where cod_cliente = ' + IntToStr(vCod) +
   ' and cod_atributo = '+ IntToStr(fTempAtributos.FieldByName('COD_ATRIBUTO').AsInteger) +
   ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas2.Prepare;
  buscas2.Open;

  if fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat > 0 then
    if buscas2.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO ATRIBUTOS_FORNEC (COD_ATRIBUTO, COD_CLIENTE, COD_EMPRESA, VALOR_ATRIBUTO, ATIVO)' +
       ' VALUES (:COD_ATRIBUTO, :COD_CLIENTE, :COD_EMPRESA, :VALOR_ATRIBUTO, :ATIVO)';
      buscas.ParamByName('COD_ATRIBUTO').AsInteger := fTempAtributos.FieldByName('COD_ATRIBUTO').AsInteger;
      buscas.ParamByName('COD_CLIENTE').AsInteger := fTempAtributos.FieldByName('COD_CLIENTE').AsInteger;
      buscas.ParamByName('COD_EMPRESA').AsInteger := fTempAtributos.FieldByName('COD_EMPRESA').AsInteger;
      buscas.ParamByName('VALOR_ATRIBUTO').AsFloat := fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat;
      buscas.ParamByName('ATIVO').AsInteger := fTempAtributos.FieldByName('ATIVO').AsInteger;
      buscas.ExecSQL;
    end;

    if not buscas2.IsEmpty then
    begin
      if fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat <= 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := ' DELETE FROM ATRIBUTOS_FORNEC ' +
         ' WHERE COD_ATRIBUTO = :COD_ATRIBUTO AND COD_CLIENTE = :COD_CLIENTE AND COD_EMPRESA = :COD_EMPRESA';
        buscas.ParamByName('COD_ATRIBUTO').AsInteger := fTempAtributos.FieldByName('COD_ATRIBUTO').AsInteger;
        buscas.ParamByName('COD_CLIENTE').AsInteger := fTempAtributos.FieldByName('COD_CLIENTE').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := fTempAtributos.FieldByName('COD_EMPRESA').AsInteger;
        buscas.ExecSQL;
      end
      else if (fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat <> buscas2.FieldByName('VALOR_ATRIBUTO').AsFloat) then
      begin
        buscas.Close;
        buscas.SQL.Text := ' UPDATE ATRIBUTOS_FORNEC SET VALOR_ATRIBUTO = :VALOR_ATRIBUTO, ATIVO = :ATIVO ' +
         ' WHERE COD_ATRIBUTO = :COD_ATRIBUTO AND COD_CLIENTE = :COD_CLIENTE AND COD_EMPRESA = :COD_EMPRESA';
        buscas.ParamByName('VALOR_ATRIBUTO').AsFloat := fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat;
        buscas.ParamByName('ATIVO').AsInteger := fTempAtributos.FieldByName('ATIVO').AsInteger;
        buscas.ParamByName('COD_ATRIBUTO').AsInteger := fTempAtributos.FieldByName('COD_ATRIBUTO').AsInteger;
        buscas.ParamByName('COD_CLIENTE').AsInteger := fTempAtributos.FieldByName('COD_CLIENTE').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := fTempAtributos.FieldByName('COD_EMPRESA').AsInteger;
        buscas.ExecSQL;
      end;
    end;
  fTempAtributos.Next;
 end;
 fTempAtributos.First;
end;

function TCadClientes._gravarFotoCliente(codigo: integer = 1; pAlt: boolean = false): boolean;
var
  b: TMemoryStream;
  buscas2: TIBQuery;
  vTemp: string;
begin
  try
    try
      result := false;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      if not vDadosIni.PesqPros('CLI171', 'GRAVAR', '', 'FOTOS',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
        Exit;

      // gravando a fotografia que se encontra num TImage comum
      // e transferindo-o diretamente para a tabela e sem nenhum
      // swap em disco
      b := TMemoryStream.Create;
      Foto.ImageCli.Picture.Graphic.SaveToStream(b); // Image1 é um TImage qualquer
      buscas2.Close;
      buscas2.SQL.Text :=' select * from fotos where codigo=' +
        inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + ' and tipo = ' + IntToStr(codigo) +
        ' and cod_empresa=' + vDadosIni.codEmpresa+ ' order by nitem desc';
      buscas2.Open;

      if codigo = 1 then
       if not buscas2.IsEmpty then
         if Application.MessageBox('Tem certeza que deseja alterar a foto do cliente?',
           'Alterar Foto', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
             exit;

      vTemp := '';
      if codigo = 2 then
       if not InputQuery('Informe a Descrição:', 'Informe a descrição da Imagem', vTemp) then
       begin
          Application.MessageBox('Descrição não informada!', 'Atenção', 0 + 64);
          Exit;
       end;
      vTemp := UpperCase(trim(vTemp));

      if not buscas2.IsEmpty then
      begin
        if codigo = 1 then
        begin
          buscas.Close;
          buscas.SQL.Text := 'update fotos set foto=:pFoto_jpg, descricao = ''FOTO''' +
            ' where codigo=' + inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
            ' and tipo = ' + IntToStr(codigo) + ' and cod_empresa=' + vDadosIni.codEmpresa;
          buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
          buscas.ExecSQL;
        end
        else
        begin
           if pAlt then
           begin
             buscas.Close;
             buscas.SQL.Text := 'update fotos set foto=:pFoto_jpg, descricao = ' + QuotedStr(Copy(vTemp, 1, 30)) +
               ' where codigo=' + inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
               ' and tipo = ' + IntToStr(codigo) + ' and nitem = '+IntToStr(Foto.dataSet.FieldByName('NITEM').AsInteger) +
               ' and cod_empresa=' + vDadosIni.codEmpresa;
             buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
             buscas.ExecSQL;
           end
           else
           begin
             buscas.Close;
             buscas.SQL.Text := 'INSERT INTO FOTOS (CODIGO, TIPO, COD_EMPRESA, NITEM, DESCRICAO, FOTO, EXTENSAO) ' +
              ' VALUES (' + inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
              ' , '+IntToStr(codigo)+', ' + vDadosIni.codEmpresa + ' , '+ IntToStr(buscas2.FieldByName('NITEM').AsInteger + 1)+', '+ QuotedStr(Copy(vTemp, 1, 30)) +', :pFoto_jpg, ''jpg'' )';
             buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
             buscas.ExecSQL;
           end;
        end;
      end
      else
      begin
        if codigo = 1 then
        begin
          buscas.Close;
          buscas.SQL.Text := 'INSERT INTO FOTOS (CODIGO, TIPO, COD_EMPRESA, NITEM, DESCRICAO, FOTO, EXTENSAO) ' +
            ' VALUES (' + inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
            ' , 1, ' + vDadosIni.codEmpresa + ' , 1, ''FOTO'', :pFoto_jpg, ''jpg'' )';
          buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
          buscas.ExecSQL;
        end
        else
        begin
          buscas.Close;
          buscas.SQL.Text := 'INSERT INTO FOTOS (CODIGO, TIPO, COD_EMPRESA, NITEM, DESCRICAO, FOTO, EXTENSAO) ' +
             ' VALUES (' + inttostr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
             ' , '+IntToStr(codigo)+', ' + vDadosIni.codEmpresa + ' , 1, ' + QuotedStr(Copy(vTemp, 1, 30)) +', :pFoto_jpg, ''jpg'' )';
          buscas.ParamByName('pFoto_jpg').LoadFromStream(b, ftBlob);
          buscas.ExecSQL;
        end;
      end;
      result := true;
      Application.MessageBox('Dados do usuario atualizados com sucesso !', 'Informação');
    except
      on e: exception do
      begin
        Application.MessageBox(Pchar(e.message), 'Erro ao atualizar dados :');
        Exit;
      end;
    end;
  finally
    if b <> nil then
      b.Destroy;
  end;
end;

function TCadClientes._importarClienteOutraEmpresa: boolean;
var
  i:integer;
begin
  try
    result:=false;
    if dataSet.State <> dsInsert then
      exit;
    if trim(dataSet.FieldByName('CPFCGC').AsString)= '' then
      exit;
    buscas.Close;
    buscas.SQL.Text := 'select first 1 * from clientes where cpfcgc = ' +
      quotedstr(trim(dataSet.FieldByName('CPFCGC').AsString)) + ' and cod_empresa <> ' +
      vDadosIni.codEmpresa+ ' order by cod_empresa';
    buscas.Open;
    if buscas.IsEmpty then
      exit;
    if  Application.MessageBox(Pchar('Cliente já está cadastrado na Empresa '+vDadosIni.StrZero(buscas.FieldByName('cod_empresa').AsInteger,3)+'.'+chr(13)+
     'Deseja importar dados do cliente dessa empresa?'),
      'Importar dados do Cliente de outra empresa', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      for i := 0 to buscas.FieldCount - 1 do
      begin
        if dataSet.FindField(buscas.Fields[i].FieldName) is TField then
        if dataSet.FindField(buscas.Fields[i].FieldName).FieldName = buscas.Fields[i].FieldName  then
          dataSet.FindField(buscas.Fields[i].FieldName).AsVariant := buscas.Fields[i].AsVariant;
      end;
      dataSet.FieldByName('COD_CLIENTE').AsInteger := 0;
//      dataSet.FieldByName('TIPVCLIENTE').AsString := 'V';
      dataSet.FieldByName('COD_LOCALIDADE').AsVariant := null;
      dataSet.FieldByName('COD_VENDEDOR').AsVariant := null;
      dataSet.FieldByName('COD_CONTADOR').AsVariant := null;
      dataSet.FieldByName('COD_TAB_PRECO').AsVariant := null;
      dataSet.FieldByName('US_CAD_CLI').AsInteger := vDadosIni.vCodUsuario;
      dataSet.FieldByName('COD_EMPRESA').AsInteger := strtoint(vDadosIni.codEmpresa);
      dataSet.FieldByName('DATA_CADASTRO').AsDateTime := date;
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      dataSet.FieldByName('COD_PAIS').AsInteger := 1058;
      buscas.Close;
      buscas.SQL.Text := 'select padrao_consumidor_final from empresa' +
                         ' where cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      if Trim(buscas.FieldByName('padrao_consumidor_final').AsString) <> '' then
        dataSet.FieldByName('consumidor_final').AsString := Trim(buscas.FieldByName('padrao_consumidor_final').AsString);
      result:=true;
    end;

  finally
    buscas.Close;
  end;
end;

procedure TCadClientes._litaModelosCarta(var pCbModelosCartas: TComboBox);
begin
  buscas.Close;
  buscas.SQL.Text := 'select mc.cod_carta,mc.descricao from modcartas mc ' +
    ' where mc.cod_empresa=' + vDadosIni.codEmpresa +
    ' and coalesce(mc.TIPO,'''')=''CLI'' ' +
    ' and mc.ativo=1 order by mc.descricao asc';
  buscas.Open;
  pCbModelosCartas.Items.Clear;
  while not buscas.eof do
  begin
    pCbModelosCartas.Items.Add(buscas.FieldByName('COD_CARTA').AsString + ' | ' +
      buscas.FieldByName('DESCRICAO').AsString);
    buscas.Next;
  end;
  buscas.Close;
end;

