function TCadClientes.CurvaABCAtrasoPagamento(ProgressBar: TProgressBar; Panel: TPanel): boolean;
var
  Qtd: string;
  Contador, QuantidadeControleCreditos: Integer;
  vqtcl: integer;
begin
  //  Parar := 0;
  Panel.Caption := 'Atraso no pagamento de Compras';
  if ExecutaComandosSqlExec('update clientes set clatrasocompra = ''A4'', V_A_COMPRA = 0, M_A_COMPRA = 0 ' +
    ' where cod_empresa = ' + vDadosIni.codEmpresa) then
  begin
    if CommitaTransacao then
      result := true
    else
    begin
      result := false;
      Application.MessageBox('Erro ao registrar classificação do cliente quanto a atraso em pagamento de compras.', 'Erro', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;
  end
  else
  begin
    RollBackTransacao;
    result := false;
    Application.MessageBox('Erro ao registrar classificação do cliente quanto a atraso em pagamento de compras.', 'Erro', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
    exit;
  end;

  ClasseCli.buscas.Close;
  ClasseCli.buscas.SQL.Text := 'select cod_cliente, SUM(datq_c - data_venc_c) as dias from controle_creditos' +
    ' where data_rec_c>=:datainicial' +
    ' and data_venc_c < datq_c' +
    ' and cod_cliente is not null ' +
    ' and codigo_emp = ' + vDadosIni.codEmpresa +
    ' group by cod_cliente' +
    ' order by 2 desc ';
  ClasseCli.buscas.ParamByName('datainicial').AsDate := date - (QtdMesEmpresa * 30);
  ClasseCli.buscas.Prepare;
  ClasseCli.buscas.Open;
  ClasseCli.buscas.FetchAll;
  QuantidadeControleCreditos := ClasseCli.buscas.RecordCount;
  ClasseCli.buscas.First;
  Contador := 1;

  ProgressBar.Min := 0;
  ProgressBar.Max := QuantidadeControleCreditos;
  ProgressBar.Position := 0;
  vqtcl := 0;
  while not ClasseCli.buscas.Eof do
  begin
    Application.ProcessMessages;
    if Parar = 1 then
      break;
    if (Contador <= QuantidadeControleCreditos * 10 / 100) and
      (ClasseCli.buscas.FieldByName('DIAS').AsFloat <> 0) then
      Qtd := 'A1'
    else if (Contador <= QuantidadeControleCreditos * 30 / 100) and
      (ClasseCli.buscas.FieldByName('DIAS').AsFloat <> 0) then
      Qtd := 'A2'
    else if (Contador <= QuantidadeControleCreditos * 100 / 100) and
      (ClasseCli.buscas.FieldByName('DIAS').AsFloat <> 0) then
      Qtd := 'A3'
    else
      Qtd := 'A4';
    if Qtd <> 'A4' then
    begin
    	vatualizacliente.Close;
      vatualizacliente.sql.text := ' update clientes set CLATRASOCOMPRA = ' + quotedstr(Qtd) + ', ' +
        ' V_A_COMPRA = ' + vDadosIni.trocaVirgulaPorPonto(floattostr(ClasseCli.buscas.FieldByName('DIAS').Asfloat)) + ', ' +
        ' M_A_COMPRA = ' + vDadosIni.trocaVirgulaPorPonto(vDadosIni.tirapontos(Format('%8.' + IntToStr(NumeroCasasDecimais) + 'n', [ClasseCli.buscas.FieldByName('DIAS').AsFloat / QtdMesEmpresa]), NumeroCasasDecimais)) +
        ' where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_cliente = ' + ClasseCli.buscas.FieldByName('COD_CLIENTE').asstring;
      vatualizacliente.Prepare;
      vatualizacliente.ExecSQL;
      vqtcl := vqtcl + 1;
      if vqtcl = 50 then
      begin
        vtransabccliente.Commit;
        vqtcl := 0;
      end;
    end
    else
    begin
    	vatualizacliente.Close;
      vatualizacliente.sql.text := 'update clientes set CLATRASOCOMPRA = ' + quotedstr(Qtd) + ', V_A_COMPRA = 0, M_A_COMPRA = 0 ' +
        ' where cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_cliente = ' + ClasseCli.buscas.FieldByName('COD_CLIENTE').asstring;
      vatualizacliente.Prepare;
      vatualizacliente.ExecSQL;
      vqtcl := vqtcl + 1;
      if vqtcl = 50 then
      begin
        vtransabccliente.Commit;
        vqtcl := 0;
      end;
    end;
    ClasseCli.buscas.Next;
    Panel.Caption := 'Classificando clientes quanto ao atraso em pagamento de compras ' +
      vDadosIni.strzero(contador, 6) + ' de ' + vDadosIni.strzero(QuantidadeControleCreditos, 6);
    Inc(Contador);
    ProgressBar.Position := ProgressBar.Position + 1;
  end;
  if vtransabccliente.InTransaction then
    vtransabccliente.Commit;
  CommitaTransacao;
  buscas.close;
  ClasseCli.buscas.Close;
  if Parar = 1 then
  begin
    result := false;
    Application.MessageBox('A definição da Curva ABC dos clientes será interrompida neste momento.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1)
  end
  else
    Result := true;
end;

