      if contLinha <= 3 then
      begin
        DtmClientes.RdpFichaCliente.ImpF(linha, 1, sObservacao[i], [comp17]);
        contLinha := contLinha + 1;
        inc(linha);
      end;
    end
    else
    begin
      while (trim(Copy(sObservacao[i], j, 132)) <> '') do
      begin
        if contLinha <= 3 then
        begin
          DtmClientes.RdpFichaCliente.ImpF(linha, 1, Copy(sObservacao[i], j, 132), [comp17]);
          contLinha := contLinha + 1;
          inc(linha);
        end;
        j := j + 132;
      end;
      j := 0;
    end;
  end;
  DtmClientes.RdpFichaCliente.ImpF(linha, 1, vDadosIni.Replicate('=', 132), [comp17]);
  inc(linha);
  inc(linha);
  DtmClientes.RdpFichaCliente.ImpC(linha, 33, '____________________', [comp17, Sublinhado]);
  DtmClientes.RdpFichaCliente.ImpC(linha, 99, '_____/_____/________', [comp17, Sublinhado]);
  inc(linha);
  DtmClientes.RdpFichaCliente.ImpC(linha, 33, 'Declarante', [comp17, Negrito]);
  DtmClientes.RdpFichaCliente.ImpC(linha, 99, 'Data', [comp17, Negrito]);
  inc(linha);
  inc(linha);
  DtmClientes.RdpFichaCliente.ImpC(linha, 33, '________________________________', [comp17,
    Sublinhado]);
  DtmClientes.RdpFichaCliente.ImpC(linha, 99, '____________________', [comp17, Sublinhado]);
  inc(linha);
  DtmClientes.RdpFichaCliente.ImpC(linha, 33, 'Aprovação diretor/Gerente/Analis', [comp17,
    Negrito]);
  DtmClientes.RdpFichaCliente.ImpC(linha, 99, 'Vendedor', [comp17, Negrito]);
  DtmClientes.RdpFichaCliente.Fechar;

end;

procedure TCadClientes.RelFichaCliente(dataIni, DataFin: string);
var
  i, vnctr, num_nota, cont, cont2: integer;
  vacres, vacrestotal: double;
  vdesc, vdesctotal: double;
  total, sub_total: double;
  vcpfcgc: string;
  imprimirDadosCred: boolean;
begin
  try
    imprimirDadosCred := true;
    if ClasseCli = nil then
      ClasseCli := TPesquisa.create;
    ClasseCli.buscas.Close;
    ClasseCli.buscas.SQL.Text := 'select COD_EMPRESA from empresa where ativo =1';
    ClasseCli.buscas.Open;
    ClasseCli.buscas.FetchAll;
    SetLength(CodigosEmpresa, ClasseCli.buscas.RecordCount);
    ClasseCli.buscas.First;
    i := 0;
    CodigosEmpresa[i] := vDadosIni.codEmpresa;
    inc(i);
    while not ClasseCli.buscas.EOF do
    begin
      if ClasseCli.buscas.FieldByName('COD_EMPRESA').AsInteger<>strtoint(vDadosIni.codEmpresa) then
      begin
        CodigosEmpresa[i] := ClasseCli.buscas.FieldByName('COD_EMPRESA').AsString;
        inc(i);
      end;
      ClasseCli.buscas.Next;
    end;
    vcpfcgc := dataSet.FieldByName('CPFCGC').AsString;
    DtmClientes.RdpFichaCliente.OpcoesPreview.CaptionPreview := 'Ficha do Cliente';
    DtmClientes.RdpFichaCliente.CaptionSetup := 'Ficha do Cliente';
    DtmClientes.RdpFichaCliente.TitulodoRelatorio := 'Ficha do Cliente';
    vDadosIni._LimparVarSendEmail;
    DtmClientes.RdpFichaCliente.OnSendMail := vDadosini._SendMailRdPrint;
    DtmClientes.RdpFichaCliente.OpcoesPreview.Preview := true;
    DtmClientes.RdpFichaCliente.FonteTamanhoPadrao := S17cpp;
    DtmClientes.RdpFichaCliente.TamanhoQteColunas := 132;
    if not DtmClientes.RdpFichaCliente.EstaAberto then
      DtmClientes.RdpFichaCliente.Abrir;
    for i := 0 to Length(CodigosEmpresa) - 1 do
    begin
      vpag := 0;
      linha := 1;
      codigoCliente := getCodClienteEmpresas(vcpfcgc, CodigosEmpresa[i]);
      if codigoCliente <> 0 then
      begin
        vnctr := 0;
        cont := 0;
        //      num_nota := 0;
        if i <> 0 then
          DtmClientes.RdpFichaCliente.Novapagina;
        CabecalhoRelFichaCli(CodigosEmpresa[i], dataIni, DataFin);
        ClasseCli.buscas.Close;
        ClasseCli.buscas.SQL.Text := 'select it.nitem,pv.tipo,pv.nped,it.grupo_prod,it.cod_prod,' +
          ' it.descr_prod_ped,it.quant_ped_item,it.vlun_ped_item,' +
          ' it.vltot_ped_item,it.n_nf,pv.data_fech,pr.num_fab_prod,it.rateio_desc,it.rateio_acresc' +
          ' from pedvenda pv,pedvenda_prod it,produtos pr' +
          ' where it.nped = pv.nped and ' +
          ' pv.cod_cliente = :vcod and pv.data_fech >= :vdat1 ' +
          ' and it.tipo = pv.tipo ' +
          ' and pv.data_fech <= :vdat2' +
          ' and ((it.status is null) or (it.status <> ''CANCELADO'')) ' +
          ' and ((pv.tipo = ''REQ'' and pv.tipv in ' + vDadosIni.vTipoVendaREQ +
          ') or (pv.tipo = ''OS'' and pv.tipo_os in ' + vDadosIni.vTipoVendaOS + '))' +
          ' and it.cod_prod = pr.cod_prod and it.grupo_prod = pr.grupo_prod ' +
          ' and pv.cod_empresa = it.cod_empresa' +
          ' and it.cod_empresa = pr.cod_empresa' +
          ' and pv.cod_empresa = ' + CodigosEmpresa[i] + ' and pv.ativo=1 ' +
          ' union' +
          ' SELECT s.nitem,pv.tipo,pv.nped,s.cod_servico,''      '',s.desc_serv_ped,s.quant_serv_ped,' +
          ' s.valor_un_serv,s.valor_tot_serv,s.n_nf,pv.data_fech,''                    '',s.rateio_desc,s.rateio_acresc' +
          ' FROM  pedvenda pv, pedvenda_serv s' +
          ' WHERE s.nped = pv.nped' +
          ' and s.tipo = pv.tipo ' +
          ' and ((s.status is null) or (s.status <> ''CANCELADO'')) ' +
          ' and pv.cod_cliente = :vcod and pv.data_fech >= :vdat1 and' +
          ' pv.data_fech <= :vdat2 and s.cod_empresa = pv.cod_empresa' +
          ' and pv.cod_empresa = ' + CodigosEmpresa[i] + ' and pv.ativo=1' +
          ' and (pv.tipo = ''OS'' and pv.tipo_os in ' + vDadosIni.vTipoVendaOS + ')' +
          'union ' +
          'SELECT d.seqid,''DEV'',d.sequencia,d.grupo_prod,d.cod_prod,' +
          'substr(d.descricao,1,60),(-1)*d.quant,(-1)*d.valor,(-1)*(d.valor*d.quant),d.NUM_NOTA_NFE,' +
          'd.data,d.num_fab_prod,0, 0 FROM  devolucao d ' +
          'WHERE d.cod_cliente = :vcod and ' +
          'd.data >= :vdat1 and d.data <= :vdat2 and ' +
          'd.cod_empresa = ' + CodigosEmpresa[i] + ' and d.ativo=1 ' +
          ' order by 2,11,3,1';
        ClasseCli.buscas.Params[0].value := codigoCliente;
        ClasseCli.buscas.Params[1].value := strtodate(dataIni);
        ClasseCli.buscas.Params[2].value := strtodate(dataFin);
        ClasseCli.buscas.Open;
        total := 0;
        sub_total := 0;
        vacres := 0;
        vdesc := 0;
        vacrestotal := 0;
        vdesctotal := 0;
        num_nota := ClasseCli.buscas.FieldByName('NPED').AsInteger;
        while not ClasseCli.buscas.eof do
        begin
          if vnctr <> ClasseCli.buscas.FieldByName('NPED').AsInteger then
          begin
            vnctr := ClasseCli.buscas.FieldByName('NPED').AsInteger;
            if ClasseCli.buscas.FieldByName('TIPO').AsString = 'REQ' then
              DtmClientes.RdpFichaCliente.Imp(linha, 14, 'PRODUTOS CONF REQ:' +
                ClasseCli.buscas.FieldByName('NPED').asstring);
            if trim(ClasseCli.buscas.FieldByName('TIPO').AsString) = 'OS' then
              DtmClientes.RdpFichaCliente.Imp(linha, 14, 'PRODUTOS CONF O.S.:' +
                ClasseCli.buscas.FieldByName('NPED').asstring);
            if trim(ClasseCli.buscas.FieldByName('TIPO').AsString) = 'DEV' then
              DtmClientes.RdpFichaCliente.Imp(linha, 14, 'PRODUTOS CONF DEV.:' +
                ClasseCli.buscas.FieldByName('NPED').asstring);
            DtmClientes.RdpFichaCliente.Imp(linha, 2,
              ClasseCli.buscas.FieldByName('DATA_FECH').asstring);
            DtmClientes.RdpFichaCliente.ImpF(linha, 12, '|', [comp17]);
            DtmClientes.RdpFichaCliente.ImpF(linha, 89, '|', [comp17]);
            DtmClientes.RdpFichaCliente.ImpF(linha, 101, '|', [comp17]);
            DtmClientes.RdpFichaCliente.ImpF(linha, 121, '|', [comp17]);
            linha := linha + 1;
          end;
          if linha >= 60 then
          begin
            linha := 1;
            DtmClientes.RdpFichaCliente.novapagina;
            CabecalhoRelFichaCli(CodigosEmpresa[i], dataIni, DataFin);
            cont2:=0;
          end;
          DtmClientes.RdpFichaCliente.ImpF(linha, 12, '|', [comp17]);
          DtmClientes.RdpFichaCliente.ImpF(linha, 89, '|', [comp17]);
          DtmClientes.RdpFichaCliente.ImpF(linha, 101, '|', [comp17]);
          DtmClientes.RdpFichaCliente.ImpF(linha, 121, '|', [comp17]);

          DtmClientes.RdpFichaCliente.Imp(linha, 14,
            copy(trim(ClasseCli.buscas.FieldByName('NUM_FAB_PROD').AsString) + ' ' +
            ClasseCli.buscas.FieldByName('DESCR_PROD_PED').AsString, 1, 40));
          DtmClientes.RdpFichaCliente.Imp(linha, 56,
            alndir(ClasseCli.buscas.FieldByName('QUANT_PED_ITEM').asstring, 6));
          DtmClientes.RdpFichaCliente.Imp(linha, 65, alndir(format('%n',
            [ClasseCli.buscas.FieldByName('VLUN_PED_ITEM').AsFloat]), 10));
          DtmClientes.RdpFichaCliente.Imp(linha, 79, alndir(format('%n',
            [ClasseCli.buscas.FieldByName('VLTOT_PED_ITEM').AsFloat]), 10));
          //        if (QRFichaCCOLUMN1.value <> 'N.F') then
          total := total + ClasseCli.buscas.FieldByName('VLTOT_PED_ITEM').AsFloat;
          DtmClientes.RdpFichaCliente.Imp(linha, 92,
            vDadosIni.strzero(ClasseCli.buscas.FieldByName('N_NF').AsString, 6));

          buscas.Close;
          buscas.SQL.Text := 'select * from controle_creditos ' +
            ' where cod_cliente = :vcod and ' +
//            ' tp_doc_v =:vdocv and
          ' n_doc_v = :vndocv and ' +
            ' codigo_emp = ' + CodigosEmpresa[i];
          buscas.params[0].value := codigoCliente;
{          if ClasseCli.buscas.FieldByName('TIPO').AsString = 'REQ' then
            buscas.params[1].value := 'REQ'
          else if ClasseCli.buscas.FieldByName('TIPO').AsString = 'OS' then
            buscas.params[1].value := 'O'
          else
            buscas.params[1].value := '0';
}
          buscas.params[1].value := ClasseCli.buscas.FieldByName('NPED').asstring;
          if ClasseCli.buscas.FieldByName('TIPO').asstring <> 'DEV' then
            buscas.Open;
          if buscas.eof then
          begin
//            linha := linha + 1;
          end;

          if imprimirDadosCred then
          begin
            cont2 := linha;
            while not buscas.eof do
            begin
              DtmClientes.RdpFichaCliente.Imp(cont2, 102, trim(buscas.FieldByName('N_DOC_C').AsString) + '-'
                + buscas.FieldByName('DATA_VENC_C').asstring);
              if buscas.FieldByName('DATQ_C').asstring <> '' then
                DtmClientes.RdpFichaCliente.Imp(cont2, 122, buscas.FieldByName('DATQ_C').asstring);
              buscas.next;
              if not buscas.eof then
              begin
                cont2 := cont2 + 1;
                DtmClientes.RdpFichaCliente.ImpF(cont2, 12, '|', [comp17]);
                DtmClientes.RdpFichaCliente.ImpF(cont2, 89, '|', [comp17]);
                DtmClientes.RdpFichaCliente.ImpF(cont2, 101, '|', [comp17]);
                DtmClientes.RdpFichaCliente.ImpF(cont2, 121, '|', [comp17]);
              end
              else
              begin
                cont2 := cont2 + 1;
              end;
              imprimirDadosCred := false;
            end;
          end;
          sub_total := sub_total + ClasseCli.buscas.FieldByName('VLTOT_PED_ITEM').AsFloat;
          vacres := vacres + ClasseCli.buscas.FieldByName('RATEIO_ACRESC').AsFloat;
          vdesc := vdesc + ClasseCli.buscas.FieldByName('RATEIO_DESC').AsFloat;

          vacrestotal := vacrestotal + ClasseCli.buscas.FieldByName('RATEIO_ACRESC').AsFloat;
          vdesctotal := vdesctotal + ClasseCli.buscas.FieldByName('RATEIO_DESC').AsFloat;
          ClasseCli.buscas.next;
          cont := cont + 1;
          linha := linha + 1;
          if (num_nota <> ClasseCli.buscas.FieldByName('NPED').AsInteger) or
            (ClasseCli.buscas.RecordCount = cont) then
          begin
            imprimirDadosCred := true;
            num_nota := ClasseCli.buscas.FieldByName('NPED').AsInteger;
            if cont2 > linha then
              linha := cont2 + 1;
            DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'SUBTOTAL:', [negrito]);
            DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [sub_total]),
              [negrito]);
            linha := linha + 1;
            DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'Desconto:', [negrito]);
            DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [vdesc]), [negrito]);
            linha := linha + 1;
            DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'Acrescimo:', [negrito]);
            DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [vacres]), [negrito]);
            linha := linha + 1;
            DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'Liquido:', [negrito]);
            DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [sub_total - vdesc + vacres]),
              [negrito]);
            sub_total := 0;
            vdesc := 0;
            vacres := 0;
            linha := linha + 2;
          end;
        end;
        linha := linha + 2;
        DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'VALOR TOTAL:', [negrito]);
        DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [total]), [negrito]);
        linha := linha + 1;
        DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'Desconto Total:', [negrito]);
        DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [vdesctotal]), [negrito]);
        linha := linha + 1;
        DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'Acrescimo Total:', [negrito]);
        DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [vacrestotal]), [negrito]);
        linha := linha + 1;
        DtmClientes.RdpFichaCliente.ImpD(linha, 75, 'VALOR TOTAL LIQUIDO:', [negrito]);
        DtmClientes.RdpFichaCliente.ImpD(linha, 89, 'R$' + format('%n', [total - vdesctotal + vacrestotal]),
          [negrito]);
        if buscas.Active then
          buscas.close;
        ClasseCli.buscas.close;
      end;
    end;
  finally
    if DtmClientes.RdpFichaCliente.EstaAberto then
      DtmClientes.RdpFichaCliente.Fechar;
  end;
end;

