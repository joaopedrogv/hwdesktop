      end;

    if trim(dataset.FieldByName('cond_pag_pre').AsString) <> '' then
    	if ContainsStr(trim(dataSet.FieldByName('cond_pag_pre').AsString), ',')
      	and (Copy(trim(dataset.FieldByName('cond_pag_pre').AsString), 1, 1) = '(')
