    fTempAjuste.FieldByName('VALOR_PROD').DisplayLabel := 'Valor Prod';
    TFloatField(fTempAjuste.FieldByName('VALOR_PROD')).DisplayFormat := '#,##0.00';
    fTempAjuste.FieldByName('VALOR_CONTRATO').DisplayLabel := 'Valor Anterior';
    TFloatField(fTempAjuste.FieldByName('VALOR_CONTRATO')).DisplayFormat := '#,##0.00';
    fTempAjuste.FieldByName('VALOR_AJUSTADO').DisplayLabel := 'Valor Ajustado';
    TFloatField(fTempAjuste.FieldByName('VALOR_AJUSTADO')).DisplayFormat := '#,##0.00';
    fTempAjuste.FieldByName('PERC_REAJUSTE').DisplayLabel := 'Perc Ajuste';

    fTempAjuste.FieldByName('COD_EMPRESA').Visible := false;
//    fTempAjuste.FieldByName('PERC_REAJUSTE').Visible := false;

