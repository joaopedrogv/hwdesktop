        if (trim(codFaturamento) = '') then
          vDadosIni.GravaAuditoria('CLI105', 'RESTAURAR', '', 'TIPO_FATURAMENTO',
            dataSet.FieldByName('CODIGO_FATURAMENTO').AsString, buscas);

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('CLI105', 'RESTAURAR REGISTRO', 'SUCESSO', 'TIPO_FATURAMENTO',
        vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
      vDadosIni.GravaAuditoria('CLI105', 'RESTAURAR REGISTRO', 'FALHA', 'TIPO_FATURAMENTO',
        vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas);
    end;

    if Result then
    	Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

