                      vDadosIni.FusoSqlInnerDate +
                        ' WHERE COD_EMPRESA = ' + IntToStr(vcod_empresa) +
                        ' ORDER BY CODIGO DESC ', buscas2);


                     if not buscas2.IsEmpty then
