function TContratosComClientes._getDadosContrato: Boolean;
begin
  Result := False;

  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  vDESCR_CONTRATO := trim(dataSet.FieldByName('DESCR_CONTRATO').AsString);
  vCOD_CLIENTE := dataSet.FieldByName('COD_CLIENTE').AsInteger;
  vCOD_SERVICO := dataSet.FieldByName('COD_SERVICO').AsInteger;
  vCOD_SERVICO_ANT := dataSet.FieldByName('COD_SERVICO').AsInteger;
  vCOD_CONTROLE := dataSet.FieldByName('COD_CONTROLE').AsInteger;
  vCOD_COLABORADOR := dataSet.FieldByName('COD_VENDEDOR').AsInteger;
  vDIA_VENCIMENTO := dataSet.FieldByName('DIA_VENCIMENTO').AsInteger;
  vDIA_FATURAMENTO := dataSet.FieldByName('DIA_FATURAMENTO').AsInteger;
  vDIAS_APOS_VENC := dataSet.FieldByName('DIAS_APOS_VENC').AsInteger;
//  vVALOR_CONTRATO := dataSet.FieldByName('VALOR_CONTRATO').AsFloat;
  vDATA_INICIAL_VIGENCIA := dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime;
  vDATA_CANCELAMENTO := dataSet.FieldByName('DATA_CANCELAMENTO').AsDateTime;
  vDATA_FINAL_VIGENCIA := dataSet.FieldByName('DATA_FINAL_VIGENCIA').AsDateTime;
  vDATA_IMPRESSAOBOL_INICIAL := dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime;
  vOBS := trim(dataSet.FieldByName('OBS').AsString);
  vSTATUS := dataSet.FieldByName('STATUS').AsString;
  vTIPO_OS := dataSet.FieldByName('TIPO_OS').AsString;
  vCONTRATOS_CADA_MES := vDadosIni.IfThen(dataSet.FieldByName('CONTRATOS_CADA_MES').AsInteger > 0, dataSet.FieldByName('CONTRATOS_CADA_MES').AsInteger, 1);

  if vDATA_IMPRESSAOBOL_INICIAL = 0 then
    vBOLETO := ''
  else
    vBOLETO := 'S';

  vGerarNFS    := vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_NFS').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_NFS').AsString));

  vGerarNF     := vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_NF').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_NF').AsString));

  vGerarRecLoc := vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_REC_LOC').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_REC_LOC').AsString));

  vGerarBoleto := vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_BOLETO').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_BOLETO').AsString));

  atribuirValorContrato;

  Result := True;

end;

function TContratosComClientes._getDadosRelatorio(
	pIndiceRel: Integer): Boolean;
begin
  vIndiceRel := pIndiceRel;
  vDataTemp := vDadosIni.getDataBanco(buscas);
  vDataTemp := EndOfTheMonth(vDataTemp) + 1;

  fRelCab.AfterScroll := _RelCabecalhoAfterScroll;

  fRelCab.Close;
  fRelCab.SQL.Text :=
  	' select distinct ' +
		' cs.desc_servico as descr_contrato_tmp, cc.cod_empresa ';

  if vAgruparRelatorio = 1 then
  	fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' , ' +
    	' cs.cod_servico, ' +
      ' null grupo_prod, ' +
      ' null cod_prod, ' +
      ' null cod_grade ';

  fRelCab.SQL.Text := fRelCab.SQL.Text +
  	' from clientes_com_contrato cc ' +
    ' inner join clientes c on ' +
    '		c.cod_cliente = cc.cod_cliente ' +
    '		and c.cod_empresa = cc.cod_empresa ';

  if vAgruparRelatorio = 0 then
  	fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' left join sp_contratos(cc.cod_contrato, cc.cod_empresa) cs on 1 = 1 '
  else
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' left join sp_contratos_serv(cc.cod_contrato, cc.cod_empresa) cs on 1 = 1 ';

  fRelCab.SQL.Text := fRelCab.SQL.Text +
	 	' where cc.cod_empresa = :cod_empresa ' +
    ' and cs.cod_servico is not null ';

  if pIndiceRel = 1 then
  begin
    if fSTATUS <> 'Todos' then
      fRelCab.SQL.Text := fRelCab.SQL.Text +
      	' and cc.status = :status ';
  end
  else if pIndiceRel = 2 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' and cc.data_final_vigencia < :data_final_vigencia ';

    if fSTATUS <> 'Todos' then
      fRelCab.SQL.Text := fRelCab.SQL.Text +
      	' and cc.status = :status ';
  end
  else if pIndiceRel = 3 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' and cc.data_final_vigencia >= :dataIni and cc.data_final_vigencia <= :dataFim ';

    if fSTATUS <> 'Todos' then
      fRelCab.SQL.Text := fRelCab.SQL.Text +
      	' and cc.status = :status ';
  end
  else if pIndiceRel = 4 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' and ((cc.data_inicial_vigencia is null)  or (cc.data_inicial_vigencia <= :dataini))' +
      ' and ((not cc.data_inicial_boleto is null) and (cc.data_inicial_boleto <= :dataIni)) ' +
      ' and (cc.status = ''Ativo'') ' +
      ' and (select case when (max(pd.data_fech) is null) then ' +
      '    								 datediff(month, date ''01.01.2000'', :dataIni) ' +
      '  								 else ' +
      '	 									 datediff(month, max(pd.data_fech), :dataIni) ' +
      '							end from pedvenda pd ' +
      '  		 inner join pedvenda_serv pds on pds.nped = pd.nped and pds.tipo = pd.tipo and pds.cod_empresa = pd.cod_empresa ' +
      '  		 where pds.cod_contrato = cc.cod_contrato ' +
      '			 and pds.tipo = ''OS'' ' +
      '			 and pds.cod_empresa = cc.cod_empresa) >= coalesce(cc.contratos_cada_mes, 1) ';
  end
  else if pIndiceRel = 5 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' and (((cc.data_inicial_vigencia <= :dataIni) and (cc.data_inicial_boleto >= :dataIni)) ' +
      ' or (cc.data_inicial_vigencia > :dataIni) ' +
      ' or (cc.status <> ''Ativo'')) ';
  end
  else if pIndiceRel = 6 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' and ((cc.data_inicial_vigencia is null)  or (cc.data_inicial_vigencia <= :dataini)) ' +
      ' and (cc.status = ''Ativo'') ' +
      ' and (select case when (max(pd.data_fech) is null) then ' +
      '    								 datediff(month, date ''01.01.2000'', :dataIni) ' +
      '  								 else ' +
      '	 									 datediff(month, max(pd.data_fech), :dataIni) ' +
      '							end from pedvenda pd ' +
      '  		 inner join pedvenda_serv pds on pds.nped = pd.nped and pds.tipo = pd.tipo and pds.cod_empresa = pd.cod_empresa ' +
      '      where pds.cod_contrato = cc.cod_contrato ' +
      '			 and pds.tipo = ''OS'' ' +
      '			 and pds.cod_empresa = cc.cod_empresa) >= coalesce(cc.contratos_cada_mes, 1) ';
  end
  else if (pIndiceRel = 7) then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' and ((cc.data_inicial_vigencia >= :dataini) and (cc.data_inicial_vigencia <= :dataFim)) ';

  	if fSTATUS <> 'Todos' then
      fRelCab.SQL.Text := fRelCab.SQL.Text +
      	' and cc.status = :status ';
  end
  else if pIndiceRel = 8 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' and ((cc.data_inicial_vigencia > :dataini) or (cc.status <> ''Ativo'')) ';
  end
  else if pIndiceRel = 9 then
  begin
    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' and ((cc.data_inicial_vigencia >= :dataini)) ';

    if fSTATUS <> 'Todos' then
      fRelCab.SQL.Text := fRelCab.SQL.Text +
      	' and cc.status = :status ';
  end;

  if vAgruparRelatorio = 1 then
  begin
  	fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' union ' +
      ' select distinct ' +
      ' cp.descr_prod as descr_contrato_tmp, cc.cod_empresa ';

  	fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' , ' +
    	' null cod_servico, ' +
      ' cp.grupo_prod, ' +
      ' cp.cod_prod, ' +
      ' cp.cod_grade ';

    fRelCab.SQL.Text := fRelCab.SQL.Text +
    	' from clientes_com_contrato cc ' +
      ' inner join clientes c on ' +
    	'		c.cod_cliente = cc.cod_cliente ' +
    	'		and c.cod_empresa = cc.cod_empresa ';

    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' left join sp_contratos_prod (cc.cod_contrato, cc.cod_empresa) cp on 1 = 1 ';

    fRelCab.SQL.Text := fRelCab.SQL.Text +
      ' where cc.cod_empresa = :cod_empresa ' +
      ' and cp.grupo_prod is not null ';

    if pIndiceRel = 1 then
    begin
      if fSTATUS <> 'Todos' then
        fRelCab.SQL.Text := fRelCab.SQL.Text +
          ' and cc.status = :status ';
    end
    else if pIndiceRel = 2 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and cc.data_final_vigencia < :data_final_vigencia ';

      if fSTATUS <> 'Todos' then
        fRelCab.SQL.Text := fRelCab.SQL.Text +
          ' and cc.status = :status ';
    end
    else if pIndiceRel = 3 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and cc.data_final_vigencia >= :dataIni and cc.data_final_vigencia <= :dataFim ';

      if fSTATUS <> 'Todos' then
        fRelCab.SQL.Text := fRelCab.SQL.Text +
          ' and cc.status = :status ';
    end
    else if pIndiceRel = 4 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and ((cc.data_inicial_vigencia is null)  or (cc.data_inicial_vigencia <= :dataini))' +
        ' and ((not cc.data_inicial_boleto is null) and (cc.data_inicial_boleto <= :dataIni)) ' +
        ' and (cc.status = ''Ativo'') ' +
        ' and (select case when (max(pd.data_fech) is null) then ' +
        '    								 datediff(month, date ''01.01.2000'', :dataIni) ' +
        '  								 else ' +
        '	 									 datediff(month, max(pd.data_fech), :dataIni) ' +
        '						  end from pedvenda pd ' +
        '  		 inner join pedvenda_serv pds on pds.nped = pd.nped and pds.tipo = pd.tipo and pds.cod_empresa = pd.cod_empresa ' +
        '  		 where pds.cod_contrato = cc.cod_contrato ' +
        '			 and pds.tipo = ''OS'' ' +
        '			 and pds.cod_empresa = cc.cod_empresa) >= coalesce(cc.contratos_cada_mes, 1) ';
    end
    else if pIndiceRel = 5 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and (((cc.data_inicial_vigencia <= :dataIni) and (cc.data_inicial_boleto >= :dataIni)) ' +
        ' or (cc.data_inicial_vigencia > :dataIni) ' +
        ' or (cc.status <> ''Ativo'')) ';
    end
    else if pIndiceRel = 6 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and ((cc.data_inicial_vigencia is null)  or (cc.data_inicial_vigencia <= :dataini)) ' +
        ' and (cc.status = ''Ativo'') ' +
        ' and (select case when (max(pd.data_fech) is null) then ' +
        '    								 datediff(month, date ''01.01.2000'', :dataIni) ' +
        '  								 else ' +
        '	 									 datediff(month, max(pd.data_fech), :dataIni) ' +
        '						  end from pedvenda pd ' +
        '  		 inner join pedvenda_serv pds on pds.nped = pd.nped and pds.tipo = pd.tipo and pds.cod_empresa = pd.cod_empresa ' +
        '  		 where pds.cod_contrato = cc.cod_contrato ' +
        '			 and pds.tipo = ''OS'' ' +
        '			 and pds.cod_empresa = cc.cod_empresa) >= coalesce(cc.contratos_cada_mes, 1) ';
    end
    else if (pIndiceRel = 7) then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and ((cc.data_inicial_vigencia >= :dataini) and (cc.data_inicial_vigencia <= :dataFim)) ';

      if fSTATUS <> 'Todos' then
        fRelCab.SQL.Text := fRelCab.SQL.Text +
          ' and cc.status = :status ';
    end
    else if pIndiceRel = 8 then
    begin
      fRelCab.SQL.Text := fRelCab.SQL.Text +
        ' and ((cc.data_inicial_vigencia > :dataini) or (cc.status <>''Ativo''))';
    end
    else if pIndiceRel = 9 then
