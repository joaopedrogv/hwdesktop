procedure TCadClientes.dataSetClientesCalcFields(DataSet: TDataSet);
begin
	if not DataSet.FieldByName('DATA_NASC').IsNull then
  begin
  	if trim(DataSet.FieldByName('DIA_NASCIMENTO').AsString) = '' then
  		DataSet.FieldByName('DIA_NASCIMENTO').AsString := FormatDateTime('dd', DataSet.FieldByName('DATA_NASC').AsDateTime);

    if trim(DataSet.FieldByName('MES_NASCIMENTO').AsString) = '' then
  		DataSet.FieldByName('MES_NASCIMENTO').AsString := FormatDateTime('mm', DataSet.FieldByName('DATA_NASC').AsDateTime);

    if trim(DataSet.FieldByName('ANO_NASCIMENTO').AsString) = '' then
  		DataSet.FieldByName('ANO_NASCIMENTO').AsString := FormatDateTime('yyyy', DataSet.FieldByName('DATA_NASC').AsDateTime);
  end;  
end;

function TCadClientes.delete: boolean;
var
	vApagar: boolean;
  codCliente, nomeFantasia, razaoSocial, cpfcpnpj: string;
  vtemp: string;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      vApagar := dataSet.FieldByName('ATIVO').AsInteger <> 1;
      codCliente := trim(dataSet.FieldByName('COD_CLIENTE').AsString);
      nomeFantasia := trim(dataSet.FieldByName('NOME_CLIENTE').AsString);
      razaoSocial := trim(dataSet.FieldByName('RAZAO').AsString);
      cpfcpnpj := trim(dataSet.FieldByName('CPFCGC').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vApagar := dataSet.FieldByName('ATIVO').AsInteger <> 1;
        codCliente := '';
        nomeFantasia := '';
        razaoSocial := '';
        cpfcpnpj := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(codCliente) <> '') then
        prepare_loop('COD_CLIENTE = ' + codCliente)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'CLIENTE' + #13 +
          'Código: ' + codCliente + #13 +
          'Nome Fantasia: ' + nomeFantasia + #13 +
          'Razão Social: ' + razaoSocial + #13 +
          'CPF/CNPJ: ' + cpfcpnpj;

        if (trim(codCliente) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('CLI005', '', '', 'CLIENTES',
          vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a Lixeira?' + #13 + #13 +
          'CLIENTE' + #13 +
          'Código: ' + codCliente + #13 +
          'Nome Fantasia: ' + nomeFantasia + #13 +
          'Razão Social: ' + razaoSocial + #13 +
          'CPF/CNPJ: ' + cpfcpnpj;

        if (trim(codCliente) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('CLI033', '', '', 'CLIENTES',
          vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo cliente(s) permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo cliente(s) para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo cliente(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo cliente(s) para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
        	SqlOpen(' select first 1 nped, tipo, cod_empresa from pedvenda ' +
          	' where cod_cliente = %d and cod_empresa = %d ',
           	[fint('cod_cliente'), fint('cod_empresa')], buscas);

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 cod_nf, cod_empresa from notafiscal ' +
              '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 numeronota, cod_empresa from nf_serie_d ' +
              '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 cod_nfce, cod_empresa from nfce ' +
            '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if not buscas.IsEmpty then
          begin
            vtemp := 'Cliente utilizado em Vendas/Nota Fiscal/Nota Fiscal série D/Nota Fiscal de Consumidor Eletrônica' +
              ', não é possível excluir.' + #13 + #13 +
              'CLIENTE' + #13 +
              'Código: ' + dataSet.FieldByName('COD_CLIENTE').AsString + #13 +
              'Nome Fantasia: ' + dataSet.FieldByName('NOME_CLIENTE').AsString + #13 +
              'Razão Social: ' + dataSet.FieldByName('RAZAO').AsString + #13 +
              'CPF/CNPJ: ' + dataSet.FieldByName('CPFCGC').AsString;

            Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            RollBackTransacao;
            exit;
          end;

        	SqlExec(' update clientes set ativo = 99 ' +
            ' where cod_cliente = %d and cod_empresa = %d ',
            [fint('cod_cliente'), fint('cod_empresa')], buscas);

          if (trim(codCliente) = '') then
            vDadosIni.GravaAuditoria('CLI005', 'EXCLUIR', '', 'CLIENTES',
              dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
        end
        else
        begin
          SqlExec(' update clientes set ativo = 0 ' +
            ' where cod_cliente = %d and cod_empresa = %d ',
            [fint('cod_cliente'), fint('cod_empresa')], buscas);

          if (trim(codCliente) = '') then
            vDadosIni.GravaAuditoria('CLI033', 'EXCLUIR', '', 'CLIENTES',
              dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CLI005', 'CLI033'),
        'EXCLUIR', 'SUCESSO', 'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CLI005', 'CLI033'),
        'EXCLUIR', 'FALHA', 'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

