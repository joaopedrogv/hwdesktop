var
	vtemp, vtemp2: string;
  I: Integer;
begin
  Result := inherited Edit;
  if (Result) and (fCadastroSimplificado) then
    PreencheCampos;
  if Result then
  begin
    dataSet.FieldByName('NOME_CLIENTE').AsString := UpperCase(trim(dataSet.FieldByName('NOME_CLIENTE').AsString));
    dataSet.FieldByName('RAZAO').AsString := UpperCase(trim(dataSet.FieldByName('RAZAO').AsString));
    dataSet.FieldByName('US_MOD_CL').AsInteger := vDadosIni.vCodUsuario;

    if trim(dataSet.FieldByName('CL_GERAR_PONTOS').AsString) = '' then
      dataSet.FieldByName('CL_GERAR_PONTOS').AsString := 'S';
