procedure TCadClientes.renconciliaErro(DataSet: TCustomClientDataSet;
  E: EReconcileError; UpdateKind: TUpdateKind; var Action: TReconcileAction);
begin
  try
    //'FK_CST_MUD_CLIENTE');
    if (Pos('FK_ITENS_CARTA_CLIENTE', UpperCase(e.Message)) <> 0) then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe carta de cobrança relacionadas a este cliente', 'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_NF_SERIE_D_CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe NF série D para este cliente',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_NF_VENDA_CLIENTES__CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe NF de venda em nome deste cliente',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_OUTRAS_NF_CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe ''Outras NF'' em nome deste cliente.', 'Erro',
        MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_PERFIL_CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe perfis cadastrados para este cliente.',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_REQVENDA_CLIENTES__CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe requisição de venda em nome deste cliente.', 'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_VEICULOS_CLIENTES__CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe veículo cadastrado em nome deste cliente.',
        'Erro', MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
    if Pos('FK_PEDVENDA_CLIENTES', UpperCase(e.Message)) <> 0 then
    begin
      Application.MessageBox('Erro ao deletar cliente' + chr(13) +
        'Existe pedido de venda em nome deste cliente.', 'Erro',
        MB_OK + MB_ICONERROR);
      registraErro('E0002 ' + e.Message);
      Abort;
    end;
  finally
    RollBackTransacao;
    Self.DataSet.CancelUpdates;
  end;

end;
{
procedure TCadClientes.ReplicaCliente(Tabela: string);
var
  i, j: integer;
  vcamps: string;
  RepliEmp: array of string;
begin
  buscas.close;
  buscas.sql.Text := 'select * from TAB_REP where TABELA = ' + quotedstr(Tabela);
  buscas.Open;
  if not Buscas.isempty then
    vcamps := Buscas.fieldbyname('EXCTO_CAMPO').asstring;
  buscas.close;
  buscas.sql.Text := 'select count(cod_empresa) as qtdemp from EMPRESA where COD_EMPRESA <> ' + vDadosIni.codEmpresa;
  buscas.Open;
  SetLength(RepliEmp, buscas.FieldByName('QTDEMP').asinteger);
  if buscas.FieldByName('QTDEMP').asinteger <> 0 then
  begin
    buscas.close;
    buscas.sql.Text := 'select cod_empresa from EMPRESA where COD_EMPRESA <> ' + vDadosIni.codEmpresa;
    buscas.Open;
    for I := 0 to Length(RepliEmp) - 1 do
    begin
      RepliEmp[i] := buscas.FieldByName('cod_empresa').AsString;
    end;
    buscas.close;
    buscas.sql.Text := 'select * from clientes where cod_cliente = ' + dataSet.FieldByName('COD_CLIENTE').asstring +
      '  and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo =1';
    buscas.Open;
    for I := 0 to Length(RepliEmp) - 1 do
    begin
      dataSet.Insert;
      for j := 0 to buscas.FieldCount - 1 do
      begin
        if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
          Dataset.Fields[j].value := buscas.Fields[j].value;
      end;
      dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
      dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES', DtmClientes.SpIncCodigo, RepliEmp[i]);
      try
        dataSet.Post;
      except
        dataSet.Cancel;
      end;
    end;
  end;
end;
}

function TCadClientes.Replicar: boolean;
begin
  if ExecutaComandosSql('select cod_empresa from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
    vDadosIni.codEmpresa) then
  begin
    result := ExecutaComandosSql('select * from TAB_REP where TABELA = ''CLIENTES''');
    if result then
      if RepliCliente = nil then
        RepliCliente := TRepliCliente.create;
  end
  else
    result := false;
end;

function TCadClientes.restaurarLixeira: boolean;
var
	codCliente, nomeFantasia, razaoSocial, cpfcpnpj: string;
  vtemp: string;
begin
	try
    result := false;
    if dataSet.IsEmpty then
    	exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      codCliente := dataSet.FieldByName('COD_CLIENTE').AsString;
      nomeFantasia := trim(dataSet.FieldByName('NOME_CLIENTE').AsString);
      razaoSocial := trim(dataSet.FieldByName('RAZAO').AsString);
      cpfcpnpj := trim(dataSet.FieldByName('CPFCGC').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        codCliente := '';
	      nomeFantasia := '';
        razaoSocial := '';
        cpfcpnpj := '';
      end;
    finally
    	prepare_loop_done;
    end;

    try
    	if (trim(codCliente) <> '') then
        prepare_loop('COD_CLIENTE = ' + codCliente)
      else
        prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
          'CLIENTE' + #13 +
          'Codigo: ' + codCliente + #13 +
          'Nome Fantasia: ' + nomeFantasia + #13 +
          'Razão Social: ' + razaoSocial + #13 +
          'CPF/CNPJ: ' + cpfcpnpj;

    	if (trim(codCliente) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('CLI008', 'RESTAURAR', '', 'CLIENTES',
      	vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas, false) then
  				exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando cliente(s)');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando cliente(s) (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update clientes set ativo = 1 ' +
          ' where cod_cliente = %d and cod_empresa = %d ',
          [fint('cod_cliente'), fint('cod_empresa')], buscas);

        if (trim(codCliente) = '') then
          vDadosIni.GravaAuditoria('CLI008', 'RESTAURAR', '', 'CLIENTES',
            dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    result := CommitaTransacao;
    if Result then
    begin
      vDadosIni.GravaAuditoria('CLI008', 'RESTAURAR REGISTRO', 'SUCESSO', 'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
      vDadosIni.GravaAuditoria('CLI008', 'RESTAURAR REGISTRO', 'FALHA', 'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end;

    if Result then
    	montaSelect(ultimasql);
//	    Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

