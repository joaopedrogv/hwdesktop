procedure TCadClientes.PreencherCamposDisplay(pBuscas: TIBQuery);
var
	I: Integer;
  vbuscas: TIBQuery;
begin
	try
    vbuscas := TIBQuery.Create(Application);
    vbuscas.Database := pBuscas.Database;
    vbuscas.Transaction := pBuscas.Transaction;

    if DtmClientes = nil then
      DtmClientes := TDtmClientes.Create(DtmClientes);

    if DtmClientes.CdsClientes.FieldCount > 0 then
    begin
      for I := 0 to DtmClientes.CdsClientes.FieldCount - 1 do
      begin
      	vbuscas.Close;
        vbuscas.SQL.Text := ' select rdb$relation_name, rdb$field_name from rdb$relation_fields ' +
        	' where rdb$relation_name = :NOME_TABELA ' +
          ' and rdb$field_name = :CAMPO ';
        vbuscas.ParamByName('NOME_TABELA').AsString := 'CLIENTES';
        vbuscas.ParamByName('CAMPO').AsString := DtmClientes.CdsClientes.Fields[I].FieldName;
        vbuscas.Open;
        
        if not vbuscas.IsEmpty then
        begin
          vbuscas.Close;
          vbuscas.SQL.Text := ' UPDATE OR INSERT INTO CAMPOS_DISPLAY (NOME_TABELA, CAMPO, DISPLAY, TAMANHO, TAG) ' +
            ' VALUES (:NOME_TABELA, :CAMPO, :DISPLAY, :TAMANHO, :TAG) ' +
            ' MATCHING (NOME_TABELA, CAMPO); ';
          vbuscas.ParamByName('NOME_TABELA').AsString := 'CLIENTES';
          vbuscas.ParamByName('CAMPO').AsString := DtmClientes.CdsClientes.Fields[I].FieldName;
          vbuscas.ParamByName('DISPLAY').AsString := DtmClientes.CdsClientes.Fields[I].DisplayLabel;
          vbuscas.ParamByName('TAMANHO').AsInteger := DtmClientes.CdsClientes.Fields[I].Size;
          vbuscas.ParamByName('TAG').AsInteger := DtmClientes.CdsClientes.Fields[I].Tag;
          vbuscas.ExecSQL;
        end;
      end;

      if vbuscas.Transaction.InTransaction then
        vbuscas.Transaction.Commit;
    end;
  except
    on E: Exception do
    begin
      Application.MessageBox(pchar('Erro: ' + e.Message ), 'Atenção', 0 + 64);
      registraErro('function TCadClientes.PreencherCamposDisplay. Erro: ' + e.Message);
    end;
  end;
end;

function TCadClientes.redefinirSenhaUsuarioHwCloud: boolean;
var
  vContato, vEmail: string;
  vListaEmail: TStringList;
  I: Integer;
begin
  Result := False;

  if dataSet.IsEmpty then
    Exit;

  if trim(dataSet.FieldByName('CPFCGC').AsString) = '' then
  begin
    Application.MessageBox(pchar('Cliente sem CNPJ / CPF, não é possível redefinir senha.'), 'Atenção', MB_ICONERROR + MB_OK);
    Exit;
  end;

  try
    vListaEmail := TStringList.Create;

    vContato := dataSet.FieldByName('EMAIL').AsString;
    vEmail := '';

    for I := 1 to Length(vContato) do
    begin
      if (vContato[I] = ';') or (vContato[I] = ',') or (vContato[I] = '|') then
      begin
        if Trim(vEmail) <> '' then
        begin
          if vDadosIni._ValidarEMail(Trim(vEmail), False) then
          begin
            vListaEmail.Add(trim(vEmail));
            Break;
          end;
        end;
        vEmail := '';
      end
      else
        vEmail := vEmail + vContato[I];
    end;

    if (vListaEmail.Count <= 0) then
      if (trim(vEmail) <> '') then
        if vDadosIni._ValidarEMail(Trim(vEmail), False) then
          vListaEmail.Add(trim(vEmail));

    vContato := '';
    if (vListaEmail.Count > 0) then
      vContato := vListaEmail[0];

    if Application.MessageBox('Deseja redefinir senha do cliente?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = IDNO then
      Exit;
      
    if not vDadosIni.PesqPros('CLI298', 'CONSULTA', '', 'CLIENTES',
  	   dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
        Exit;
                   
    if not hwc_cad_usuario_senha(
      Format(';databaseName=%s;empresaid=%s;silent=false;userHW=HW;userLevel=10',
               [vDadosIni.vBancoHW, vDadosIni.codEmpresa]),
      dataSet.FieldByName('CPFCGC').AsString,
      dataSet.FieldByName('CPFCGC').AsString,
      dataSet.FieldByName('COD_CLIENTE').AsString,
      'CE',
      vContato,
      'I') then
        Exit;

    Application.MessageBox(pchar('Senha do cliente redefinida.'), 'Atenção', MB_OK + MB_ICONINFORMATION);

    Result := True;
  finally
    if Assigned(vListaEmail) then
      FreeAndNil(vListaEmail);
  end;
end;

procedure TCadClientes.RelFichaFinanceiraCli(dataIni, DataFin: string);
var
  vdatultc: Tdate;
  valorDoc: currency;
  vqtdCp: real;
  vcpfcgc: string;
  i: integer;
begin
  try
    buscas.Close;
    buscas.SQL.Text := ' select * from empresa ' +
    	' where ativo = 1';
    buscas.Open;
    buscas.FetchAll; //mesmo que last
    SetLength(CodigosEmpresa, buscas.RecordCount);
    buscas.First;
    i := 0;
    CodigosEmpresa[i] := vDadosIni.codEmpresa;
    inc(i);
    while not buscas.EOF do
    begin
      if buscas.FieldByName('COD_EMPRESA').AsInteger<>strtoint(vDadosIni.codEmpresa) then
      begin
        CodigosEmpresa[i] := buscas.FieldByName('COD_EMPRESA').AsString;
        inc(i);
      end;
      Buscas.Next;
    end;
    vcpfcgc := dataSet.FieldByName('CPFCGC').AsString;
    DtmClientes.RdpFichaCliente.OpcoesPreview.CaptionPreview := 'Ficha Financeira do Cliente';
    DtmClientes.RdpFichaCliente.CaptionSetup := 'Ficha Financeira do Cliente';
    DtmClientes.RdpFichaCliente.TitulodoRelatorio := 'Ficha Financeira do Cliente';
    vDadosIni._LimparVarSendEmail;
    DtmClientes.RdpFichaCliente.OnSendMail := vDadosini._SendMailRdPrint;
    DtmClientes.RdpFichaCliente.OpcoesPreview.Preview := true;
    DtmClientes.RdpFichaCliente.FonteTamanhoPadrao := S10cpp;
    DtmClientes.RdpFichaCliente.TamanhoQteColunas := 80;
    DtmClientes.RdpFichaCliente.OpcoesPreview.Preview := true;
    DtmClientes.RdpFichaCliente.Abrir;
    for i := 0 to Length(CodigosEmpresa) - 1 do
    begin
      vpag := 0;
      linha := 1;
      codigoCliente := getCodClienteEmpresas(vcpfcgc, CodigosEmpresa[i]);
      if codigoCliente <> 0 then
      begin
        if i <> 0 then
          DtmClientes.RdpFichaCliente.Novapagina;
        CabecalhoRelFichaFinCli(CodigosEmpresa[i], dataIni, DataFin);
        
        buscas.Close;
