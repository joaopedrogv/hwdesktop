      dataSet.FieldByName('REC_NOT').AsString := 'S';
    if trim(dataSet.FieldByName('BARRAMENTO_AUTOMATICO').AsString) = '' then
  		dataSet.FieldByName('BARRAMENTO_AUTOMATICO').AsString := 'S';

    if trim(dataSet.FieldByName('controles_fp').AsString) <> '' then
    	if ContainsStr(trim(dataSet.FieldByName('controles_fp').AsString), ',')
      	and (Copy(trim(dataSet.FieldByName('controles_fp').AsString), 1, 1) = '(')
      	and (Copy(trim(dataSet.FieldByName('controles_fp').AsString), Length(trim(dataSet.FieldByName('controles_fp').AsString)), 1) <> ')') then
      begin
      	vtemp := '';
        vtemp2 := '';
      	for I := 1 to Length(trim(dataSet.FieldByName('controles_fp').AsString)) do
        begin
          vtemp := vtemp + trim(dataSet.FieldByName('controles_fp').AsString[I]);
          if trim(dataSet.FieldByName('controles_fp').AsString[I]) = ',' then
          	vtemp2 := vtemp;
        end;
        dataSet.FieldByName('controles_fp').AsString := Copy(vtemp2, 1, Length(vtemp2) - 1) + ')';
      end;

    if trim(dataset.FieldByName('cond_pag_vnd').AsString) <> '' then
