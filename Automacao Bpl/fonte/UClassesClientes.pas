    	' order by 2 '
  else
    fRelDetalhes.SQL.Text := fRelDetalhes.SQL.Text +
    	' order by 1 ';

  if vIndiceRel = 1 then
  begin
    if fSTATUS <> 'Todos' then
      fRelDetalhes.ParamByName('status').AsString := fSTATUS;
  end
  else if vIndiceRel = 2 then
  begin
  	fRelDetalhes.ParamByName('data_final_vigencia').AsDate := vDadosIni.FusoDate(True);

    if fSTATUS <> 'Todos' then
      fRelDetalhes.ParamByName('status').AsString := fSTATUS;
  end
  else if vIndiceRel = 3 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := StartOfTheMonth(vDataTemp);
    fRelDetalhes.ParamByName('dataFim').AsDate := EndOfTheMonth(vDataTemp);

  	if fSTATUS <> 'Todos' then
      fRelDetalhes.ParamByName('status').AsString := fSTATUS;
  end
  else if vIndiceRel = 4 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if vIndiceRel = 5 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if vIndiceRel = 6 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if vIndiceRel = 7 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := StartOfTheMonth(vDataBasePrGeradorOs);
    fRelDetalhes.ParamByName('dataFim').AsDate := EndOfTheMonth(vDataBasePrGeradorOs);

    if fSTATUS <> 'Todos' then
      fRelDetalhes.ParamByName('status').AsString := fSTATUS;
  end
  else if vIndiceRel = 8 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if vIndiceRel = 9 then
  begin
    fRelDetalhes.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);

    if fSTATUS <> 'Todos' then
      fRelDetalhes.ParamByName('status').AsString := fSTATUS;
  end;

  fRelDetalhes.ParamByName('cod_empresa').AsInteger         := StrToInt(vDadosIni.codEmpresa);
  if vAgruparRelatorio = 0 then
  	fRelDetalhes.ParamByName('descr_contrato_tmp').AsString := fRelCab.FieldByName('descr_contrato_tmp').AsString
  else
  begin
  	fRelDetalhes.ParamByName('cod_servico').Value       := fRelCab.FieldByName('cod_servico').Value;
    fRelDetalhes.ParamByName('grupo_prod').Value        := fRelCab.FieldByName('grupo_prod').Value;
    fRelDetalhes.ParamByName('cod_prod').Value          := fRelCab.FieldByName('cod_prod').Value;
    fRelDetalhes.ParamByName('cod_grade').Value         := fRelCab.FieldByName('cod_grade').Value;
  end;
  fRelDetalhes.Open;
  fRelDetalhes.FetchAll;
end;

function TContratosComClientes._abreFormAjustarContratos: Boolean;
var
  formulario: TfrmPadrao;
  somenteSelecinados: boolean;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 832;
    formulario.Height := 525;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Reajustar valor dos serviços dos contratos';
    frmCadContratosClientes.pnAjustarContrato.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.ShowHint := true;
    formulario.KeyPreview := True;
    fTempAjuste.EmptyDataSet;

    somenteSelecinados := Application.MessageBox('Reajustar contratos' + chr(13) +
      'Deseja reajustar somente os selecionados?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES;

    try
    	if somenteSelecinados then
      begin
	      dataSet.Filtered := false;
        dataSet.Filter  := ' SEL = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum contrato selecionado.', 'Informação', MB_OK + MB_ICONINFORMATION +  MB_DEFBUTTON1);
          exit;
        end;
      end;

      try
        vDadosIni.abreStatusProcessamento('', 'Selecionando contratos...');
        dataSet.DisableControls;

        dataSet.First;
        while not dataSet.Eof do
        begin
          if dataSet.FieldByName('ASSINATURA_VINDI_ID').AsInteger <= 0 then
          begin
            fTempAjuste.Insert;
            fTempAjuste.FieldByName('COD_CONTRATO').AsInteger := dataSet.FieldByName('COD_CONTRATO').AsInteger;
            fTempAjuste.FieldByName('NOME_CLIENTE').AsString := dataSet.FieldByName('NOME_CLIENTE').AsString;
            fTempAjuste.FieldByName('COD_CLIENTE').AsInteger := dataSet.FieldByName('COD_CLIENTE').AsInteger;
            fTempAjuste.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
            fTempAjuste.FieldByName('DESCR_CONTRATO').AsString := dataSet.FieldByName('DESCR_CONTRATO').AsString;
            fTempAjuste.FieldByName('NOME_CTRL').AsString := dataSet.FieldByName('NOME_CTRL').AsString;

            buscas.Close;
            buscas.SQL.Text :=
              ' select coalesce(clientes_com_contrato.valor_contrato, 0) valor from clientes_com_contrato ' +
              ' where clientes_com_contrato.cod_contrato = ' + IntToStr(dataSet.FieldByName('COD_CONTRATO').AsInteger) +
              ' and clientes_com_contrato.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and clientes_com_contrato.cod_servico > 0 ' +
              ' union all ' +
              ' select sum(coalesce(clientes_com_contrato_serv.qtde, 0) * coalesce(clientes_com_contrato_serv.valor_un, 0)) valor from clientes_com_contrato ' +
              ' inner join clientes_com_contrato_serv on ' +
              '     clientes_com_contrato_serv.cod_contrato = clientes_com_contrato.cod_contrato ' +
              '     and clientes_com_contrato_serv.cod_empresa = clientes_com_contrato.cod_empresa ' +
              ' where clientes_com_contrato.cod_contrato = ' + IntToStr(dataSet.FieldByName('COD_CONTRATO').AsInteger) +
              ' and clientes_com_contrato.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and clientes_com_contrato.cod_servico = 0 ';
            buscas.Open;

            ftempajuste.FieldByName('VALOR_SERV').AsFloat := 0;
            if buscas.IsEmpty then
              ftempajuste.FieldByName('VALOR_SERV').AsFloat := 0
            else
            begin
              buscas.first;
              while not buscas.eof do
              begin
                fTempAjuste.FieldByName('VALOR_SERV').AsFloat :=
                  fTempAjuste.FieldByName('VALOR_SERV').AsFloat + buscas.FieldByName('valor').asfloat;

                buscas.next;
              end;
            end;

            buscas.Close;
            buscas.SQL.Text :=
              ' select sum(coalesce(clientes_com_contrato_prod.qtde, 0) * coalesce(clientes_com_contrato_prod.valor_un, 0)) valor from clientes_com_contrato ' +
              ' inner join clientes_com_contrato_prod on ' +
              '     clientes_com_contrato_prod.cod_contrato = clientes_com_contrato.cod_contrato ' +
              '     and clientes_com_contrato_prod.cod_empresa = clientes_com_contrato.cod_empresa ' +
              ' where clientes_com_contrato.cod_contrato = ' + IntToStr(dataSet.FieldByName('COD_CONTRATO').AsInteger) +
              ' and clientes_com_contrato.cod_empresa = ' + vDadosIni.codEmpresa;
            buscas.Open;

            fTempAjuste.FieldByName('VALOR_PROD').AsFloat := 0;
            if buscas.IsEmpty then
              fTempAjuste.FieldByName('VALOR_PROD').AsFloat := 0
            else
            begin
              buscas.First;
              while not buscas.Eof do
              begin
                fTempAjuste.FieldByName('VALOR_PROD').AsFloat :=
                  fTempAjuste.FieldByName('VALOR_PROD').AsFloat + buscas.FieldByName('VALOR').AsFloat;

                buscas.Next;
              end;
            end;

            fTempAjuste.FieldByName('VALOR_CONTRATO').AsFloat :=
            	ftempajuste.FieldByName('VALOR_SERV').AsFloat +
            	fTempAjuste.FieldByName('VALOR_PROD').AsFloat;
            	//dataSet.FieldByName('VALOR_CONTRATO').AsFloat;
            fTempAjuste.Post;
          end;

          dataSet.Next;
        end;
        fTempAjuste.IndexFieldNames := 'COD_CONTRATO';
        fTempAjuste.First;
      finally
        dataSet.EnableControls;
        vDadosIni.fechaStatusProcessamento;
      end;

    finally
    	if somenteSelecinados then
        dataSet.Filtered := false;
    end;
    dataSet.First;

    frmCadContratosClientes.DBGrid2.DataSource := fTempAjusteDtSource;
    result := (formulario.ShowModal = IDOK);
  finally
    frmCadContratosClientes.pnAjustarContrato.Parent := frmCadContratosClientes.TabSheet8;
    formulario.Free;
    formulario := nil;
  end;
end;

