        ' coalesce(valor_ctr.valor_contrato, 0) valor_contrato, ' +
        ' coalesce(valor_ctr.valor_prod, 0) valor_prod, ' +
        ' coalesce(valor_ctr.valor_serv, 0) valor_serv, ' +
        ' coalesce(valor_bol.valor_boleto, 0) valor_boleto, ' +
        ' coalesce(ctr.contratos_cada_mes, 1) contratos_cada_mes, ' +
        ' coalesce(qtde_mes.qtde_mes_ult_ger, 0) qtde_mes_ult_ger, ' +
        ' coalesce(ctr.dia_vencimento, 0) dia_vencimento, ' +
        ' coalesce(ctr.dias_apos_venc, 0) dias_apos_venc, ' +
        ' ctr.cod_vendedor, col.nome_vendedor, ' +
        ' ctr.cod_controle, ctrl.nome_ctrl, ctrl.docs, ' +
        ' coalesce(ctrl.nao_gera_finan, ''N'') nao_gera_finan, ' +
        ' coalesce(ctrl.usar_boleto, ''N'') usar_boleto, ' +
        ' ctr.tipo_os, ' +
        ' coalesce(ctr.gerar_nfs, ''S'') gerar_nfs, ' +
        ' coalesce(ctr.gerar_nf, ''S'') gerar_nf, ' +
        ' coalesce(ctr.gerar_rec_loc, ''S'') gerar_rec_loc, ' +
