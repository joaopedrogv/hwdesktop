  try
    result := false;
    if dataSet.IsEmpty then
    	exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      codFaturamento := dataSet.FieldByName('CODIGO_FATURAMENTO').AsString;
      descricaoFaturamento := dataSet.FieldByName('DESC_FAT').AsString;

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        codFaturamento := '';
        descricaoFaturamento := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(codFaturamento) <> '') then
        prepare_loop('CODIGO_FATURAMENTO = ' + codFaturamento)
      else
        prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
          'TIPO DE FATURAMENTO' + #13 +
          'Código: ' + codFaturamento + #13 +
          'Descrição: ' + descricaoFaturamento;

    	if (trim(codFaturamento) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('CLI105', 'RESTAURAR', '', 'TIPO_FATURAMENTO',
      	vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas, false) then
  				exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de faturamento');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de faturamento (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update tipo_faturamento set ativo = 1 ' +
          ' where codigo_faturamento = %d ',
