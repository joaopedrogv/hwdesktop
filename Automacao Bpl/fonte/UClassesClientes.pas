function TCadPedidoCompraCl.abreClientes(pCodCliente: Integer): Boolean;
begin
  fCliente.Close;
  fCliente.CommandText :=  ' SELECT COD_CLIENTE, NOME_CLIENTE, RAZAO FROM CLIENTES ' +
  	 ' WHERE cod_cliente = ' + inttostr(pCodCliente) + ' and cod_empresa = ' + vDadosIni.codEmpresa +
    ' and ativo = 1 ';
  fCliente.Open;

  Result := not fCliente.IsEmpty;
end;

function TCadPedidoCompraCl.abrePedidoCompraCl(pCodigo: Integer): Boolean;
begin
	Result := montaSelect(' SELECT * FROM PEDIDOCOMPRACL ' +
  	' WHERE CODIGO = ' + IntToStr(pCodigo) +
    ' AND COD_EMPRESA = ' + vDadosIni.codEmpresa);
end;

constructor TCadPedidoCompraCl.create;
begin
	DataSet := TClientDataSet(DtmClientes.cdsPedidoCompraCl);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);
  fCliente := TClientDataSet(DtmClientes.cdsConsClientePed);

	vProdPed := TCadPedidoCompraClProd.create;
end;

function TCadPedidoCompraCl.Delete: boolean;
var
  vCodFormula: string;
begin
  Result := False;
  if dataSet.IsEmpty then
    exit;

  vCodFormula := dataSet.FieldByName('CODIGO').AsString;

  if not vDadosIni.PesqPros('BAS545', 'EXCLUIR', '', 'PEDIDOCOMPRACL',
    dataSet.FieldByName('CODIGO').AsString, buscas, false) then
    Exit;

  if Application.MessageBox('Tem certeza que deseja excluir este registro permanentemente?',
    'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
    Exit;

  result := inherited Delete;
  if Result then
    result := Apply;

  if result then
    result := CommitaTransacao;

  if Result then
    vDadosIni.GravaAuditoria('BAS545', 'EXCLUIR', 'SUCESSO', 'PEDIDOCOMPRACL', vCodFormula, buscas)
  else
    vDadosIni.GravaAuditoria('BAS545', 'EXCLUIR', 'FALHA', 'PEDIDOCOMPRACL', vCodFormula, buscas);

  Result := true;
  Refresh;
end;

destructor TCadPedidoCompraCl.Destroy;
begin
	vProdPed.Free;
  vProdPed := nil;

  inherited;
end;

function TCadPedidoCompraCl.edit: boolean;
begin
	Result := False;
  if not vDadosIni.PesqPros('BAS544', 'ALTERAR', '', 'PEDIDOCOMPRACL',
    '', buscas, false) then
    Exit;

  if inherited Edit then
  begin
    Result := True;
    if dataSet.FieldByName('COD_USUARIO').IsNull then
    	dataSet.FieldByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
    dataSet.FieldByName('ATIVO').AsInteger := dataSet.FieldByName('ATIVO').AsInteger;

    vCodigo := dataSet.FieldByName('CODIGO').AsInteger;

    vProdPed.abreProdPed(dataSet.FieldByName('CODIGO').AsInteger);

    abreClientes(dataSet.FieldByName('COD_CLIENTE').AsInteger);
  end;
end;

function TCadPedidoCompraCl.Post(APedido: NovoPedidoDados): boolean;
var
  acao: string;
begin
  try
    if not vDadosIni.PesqPros('BAS546', 'SALVAR', '', 'PEDIDOCOMPRACL', fstr('CODIGO')) and
      not vDadosIni.PesqPros('BAS550', 'SALVAR', 'Ped ' + vProdPed.fstr('CODIGO'), 'PEDIDOCOMPRACL_ITENS', fstr('NITEM')) then
      Exit;

    Self.Validar();

    vProdPed.Validar();

    acao := IfThen(dataSet.State = dsEdit, 'EDITAR', 'INSERIR');

    if not (vProdPed.dataSet.State in [dsEdit, dsInsert]) and (vProdPed.dataSet.RecordCount = 0) then
      raiseExceptionCreate('Produto nao informado');

    if dataSet.FieldByName('CODIGO').AsInteger <= 0 then
      dataSet.FieldByName('CODIGO').AsInteger := Gencodigo('PEDIDOCOMPRACL', buscas, vDadosIni.codEmpresa);

    if vProdPed.dataSet.FieldByName('NITEM').AsInteger = 0 then
    begin
      if (vProdPed.dataSet.State in [dsBrowse]) then
        vProdPed.dataSet.Edit;

      vProdPed.dataSet.FieldByName('CODIGO').AsInteger := fint('codigo');
      vProdPed.dataSet.FieldByName('NITEM').AsInteger := Gencodigo('PEDIDOCOMPRACL_ITENS', buscas, vDadosIni.codEmpresa);
    end;

    if vProdPed.dataSet.State in [dsEdit, dsInsert] then
      vProdPed.dataSet.Post;

    Result := False;
    try

      Result := (inherited post) and
        ((DataSet.ChangeCount = 0) or (Self.Apply)) and
        ((vProdPed.DataSet.ChangeCount = 0) or (vProdPed.Apply));

      if Result then
        CommitaTransacao;

    finally
      if Result then
        vDadosIni.GravaAuditoria('BAS546', acao, 'SUCESSO', 'PEDIDOCOMPRACL', dataSet.FieldByName('CODIGO').AsString)
      else
        vDadosIni.GravaAuditoria('BAS546', acao, 'FALHA', 'PEDIDOCOMPRACL', dataSet.FieldByName('CODIGO').AsString);
      if Result then
        vDadosIni.GravaAuditoria('BAS550', acao, 'SUCESSO', 'PEDIDOCOMPRACL_ITENS', dataSet.FieldByName('CODIGO').AsString)
      else
        vDadosIni.GravaAuditoria('BAS550', acao, 'FALHA', 'PEDIDOCOMPRACL_ITENS', dataSet.FieldByName('CODIGO').AsString);
    end;

  except on E: Exception do
    begin
      Result := false;
      ShowErro(e.Message);
      registraErro(e.Message);
    end;
  end;
end;

procedure TCadPedidoCompraCl.Validar;
begin
  if trim(dataSet.FieldByName('NUM_PEDIDO').AsString) = '' then
    raiseExceptionCreate('Número do pedido de compra deve ser informado', 'DBEdit2');

  if trim(dataSet.FieldByName('DATA_PEDIDO').AsString) = '' then
    raiseExceptionCreate('Data do pedido de compra deve ser informado', 'DBEdit3');

  if dataSet.FieldByName('COD_CLIENTE').AsInteger <= 0 then
    raiseExceptionCreate('Código do cliente deve ser informado', 'DBEdit4');
end;

function TCadPedidoCompraCl.Insert: boolean;
begin
	Result := False;
  if not vDadosIni.PesqPros('BAS543', 'INCLUIR', '', 'PEDIDOCOMPRACL',
    '', buscas, True) then
    Exit;

  if not dataSet.Active then
    montaSelect('select p.* from pedidocompracl p ' +
      ' where p.codigo=0 and p.ativo=0 and p.cod_empresa =0 ');

  if inherited Insert then
  begin
    Result := True;
    dataSet.FieldByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
    dataSet.FieldByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
    dataSet.FieldByName('ATIVO').AsFloat := 1;

    vCodigo := 0;

    vProdPed.abreProdPed(-1);
    abreClientes(-1);
  end;
end;

function TCadPedidoCompraCl.post: boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    if not vDadosIni.PesqPros('BAS546', 'SALVAR', '', 'PEDIDOCOMPRACL',
      dataSet.FieldByName('CODIGO').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    Validar();

    if acao = 'INSERIR' then
    begin
    	vCodigo := Gencodigo('PEDIDOCOMPRACL', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
      dataSet.FieldByName('CODIGO').AsInteger := vCodigo;
    end;

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('BAS546', acao, 'SUCESSO', 'PEDIDOCOMPRACL',
        dataSet.FieldByName('CODIGO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('BAS546', acao, 'FALHA', 'PEDIDOCOMPRACL',
        dataSet.FieldByName('CODIGO').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: exception do
    begin
      Result := false;
      if dataSet.State = dsBrowse then
        dataSet.Edit;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadPedidoCompraCl._abreFormProd: Boolean;
begin
	Result := vDadosIni.abreForm('Produto - Contrato', frmCadPedidoCompraClienteNfe.pnCadProdutosCtr, [ofAutoSize, ofEscapeExit, ofAlignAllClientWinCtrl]);
end;

procedure TCadPedidoCompraCl._cadPedidoCompraCl(pTipoForm: Integer);
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Abrindo Pedido de Compra Cliente (NFe)');
    if dtmClientes = nil then
      dtmClientes := TdtmClientes.Create(dtmClientes);

    vDadosIni.vTipoForm := pTipoForm;

    if not vDadosIni.PesqPros('BAS541', 'CONSULTA', '', 'PEDIDOCOMPRACL', '',
      dtmClientes.qrBuscas, False) then
    begin
      vDadosIni.fechaStatusProcessamento;
      Exit;
    end;

    if frmCadPedidoCompraClienteNfe = nil then
    begin
      if pTipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';

      Application.CreateForm(TfrmCadPedidoCompraClienteNfe, frmCadPedidoCompraClienteNfe);
    end;

    if (pTipoForm > 0) and (not frmCadPedidoCompraClienteNfe.Visible) then
      frmCadPedidoCompraClienteNfe.ShowModal
    else if (not frmCadPedidoCompraClienteNfe.Visible) then
      frmCadPedidoCompraClienteNfe.Show
    else if frmCadPedidoCompraClienteNfe.FormStyle = fsMDIChild then
      frmCadPedidoCompraClienteNfe.Show
    else
      frmCadPedidoCompraClienteNfe.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

