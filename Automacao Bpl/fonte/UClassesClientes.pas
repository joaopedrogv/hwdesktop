                 vnumvale := Gencodigo('VALE_CUPONS', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);

                 buscasEmp.Close;
                 buscasEmp.SQL.Text := ' select ' +
                    ' case when (emp.cod_empresa = cast(:COD_EMPRESA as Integer)) then 0 else emp.cod_empresa end ordem, ' +
