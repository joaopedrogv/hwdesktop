  fTempAjuste.FieldDefs.Add('VALOR_PROD', ftFloat, 0, false);
  fTempAjuste.FieldDefs.Add('VALOR_CONTRATO', ftFloat, 0, false);
  fTempAjuste.FieldDefs.Add('VALOR_AJUSTADO', ftFloat, 0, false);
  fTempAjuste.FieldDefs.Add('COD_EMPRESA', ftInteger, 0, false);
  fTempAjuste.FieldDefs.Add('DESCR_CONTRATO', ftString, 75, false);
  fTempAjuste.FieldDefs.Add('NOME_CTRL', ftString, 35, false);
  fTempAjuste.FieldDefs.Add('COD_CLIENTE', ftInteger, 0, false);
  fTempAjuste.FieldDefs.Add('PERC_REAJUSTE', ftFloat, 0, false);

  if fTempAjuste.Tag = 0 then
  try
    fTempAjuste.CreateDataSet;
    fTempAjuste.Tag := 1;

    fTempAjuste.FieldByName('COD_CONTRATO').DisplayLabel := 'Cod Contrato';
    fTempAjuste.FieldByName('COD_CLIENTE').DisplayLabel := 'Cod Cliente';
    fTempAjuste.FieldByName('NOME_CLIENTE').DisplayLabel := 'Cliente';
    fTempAjuste.FieldByName('DESCR_CONTRATO').DisplayLabel := 'Contrato';
    fTempAjuste.FieldByName('NOME_CTRL').DisplayLabel := 'Controle';
