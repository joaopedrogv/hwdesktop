                       if (StrToInt(vDadosIni.codEmpresa) = vcod_empresa) then
                        if (vpontostotalcliente < vPontosVale) then
                        begin
                          vpontosrestante := vpontosrestante - (vPontosVale - vpontostotalcliente);
                          vpontoslancamentos := vpontoslancamentos + (vPontosVale - vpontostotalcliente);
                        end;
                     end;
                   end
                   else if vDadosIni.vCashback.vHabilitarCashback then
                   begin
                     if (vvalorempresa >= vvalorrestante) then
                     begin
                       vvalorlancamentos := vvalorrestante;
                       vvalorrestante := 0;
                     end
                     else
                     begin
                       vvalorlancamentos := vvalorempresa;
                       vvalorrestante := vvalorrestante - vvalorempresa;

                       if (StrToInt(vDadosIni.codEmpresa) = vcod_empresa) then
