function TTipoCliente.restaurarRegistro: boolean;
var
	codtpcliente, descricaotpcliente: string;
  vtemp: string;
begin
  try
    result := false;
    if dataSet.IsEmpty then
    	exit;

    if dataSet.FieldByName('ATIVO').asinteger <> 0 then
    begin
      Application.MessageBox('Registro já está ativo' + chr(13) +
          'Não é necessário restaurá-lo', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      codtpcliente := dataSet.FieldByName('CODIGO_TIPO').AsString;
      descricaotpcliente := dataSet.FieldByName('DESCRICAO_TIPO').AsString;

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        codtpcliente := '';
        descricaotpcliente := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
    	if (trim(codtpcliente) <> '') then
        prepare_loop('CODIGO_TIPO = ' + codtpcliente)
      else
        prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja restaurar este registro?' + #13 + #13 +
          'TIPO DE CLIENTE' + #13 +
          'Código: ' + codtpcliente + #13 +
          'Descrição: ' + descricaotpcliente;

    	if (trim(codtpcliente) = '') then
          vtemp := 'Tem certeza que deseja restaurar os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados?';

      if not vDadosIni.PesqPros('CLI095', 'RESTAURAR', '', 'TIPOS_CLIENTES',
      	vDadosIni.IfThen(trim(codtpcliente) <> '', codtpcliente, ''), buscas, false) then
  				exit;

      if Application.MessageBox(PChar(vtemp),
        'Restaurar Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
        exit;

      vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de cliente');

      dataset.First;
      while not dataset.Eof do
      begin
      	vDadosIni.abreStatusProcessamento('', 'Restaurando tipo(s) de cliente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        SqlExec(' update tipos_clientes set ativo = 1 ' +
          ' where codigo_tipo = %d ',
          [fint('codigo_tipo')], buscas);

        if (trim(codtpcliente) = '') then
          vDadosIni.GravaAuditoria('CLI095', 'RESTAURAR', '', 'TIPOS_CLIENTES',
            dataSet.FieldByName('CODIGO_TIPO').AsString, buscas);

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('CLI095', 'RESTAURAR REGISTRO', 'SUCESSO', 'TIPOS_CLIENTES',
        vDadosIni.IfThen(trim(codtpcliente) <> '', codtpcliente, ''), buscas);
    end
    else
    begin
    	RollBackTransacao;
      vDadosIni.GravaAuditoria('CLI095', 'RESTAURAR REGISTRO', 'FALHA', 'TIPOS_CLIENTES',
        vDadosIni.IfThen(trim(codtpcliente) <> '', codtpcliente, ''), buscas);
    end;

    if Result then
    	Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

