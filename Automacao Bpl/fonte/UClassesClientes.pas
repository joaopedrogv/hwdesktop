                     dataSet.FieldByName('DATA_VENC_PROG').AsDateTime := vDadosIni.getDataBanco(buscas3) + vperiodoVencPtos;
                     dataSet.FieldByName('PERC_PROG_FID').AsFloat := vpercProgFid;
