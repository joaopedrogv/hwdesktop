function TCadClientes.AtualizarSituacaoCaixa(pAtualizarEmpresa: boolean = true; pExibirMensagem: boolean = true): boolean;
var
	vcpf: string;
  codEmpresas: string;
  vVisualizarCreditosVenc: boolean;
  vNaoQuitado, vQuitado: Boolean;
  vControle: Integer;
begin
	Result := false;
	possuiDebito := false;
  possuiVale := false;

  vVisualizarCreditosVenc := vDadosIni.getConfSisBool('cl_ficha_exib_somente_cred_cheq_venc', buscas);

	Creditos := TPesquisa.create;
  Cheques := TPesquisa1.create;
  Recibos := TPesquisa2.create;
  vdataat := vDadosIni.getDataBanco(buscas);
  try
    vDadosIni.abreStatusProcessamento('', 'Verificando debitos do cliente');

    buscas.Close;
    buscas.SQL.Text := ' select clientes.cpfcgc from clientes ' +
      ' where clientes.cod_cliente = ' + IntToStr(dataset.FieldByName('COD_CLIENTE').AsInteger) +
      ' and clientes.cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.open;
    vcpf := trim(buscas.FieldByName('cpfcgc').AsString);

    if pAtualizarEmpresa then
    begin
      buscas.Close;
      buscas.SQL.Text := ' select emp.cod_empresa, emp.identificacao_emp, emp.cgc_emp from empresa emp ' +
        '	where emp.ativo = 1 ' +
        vDadosIni.IfThen(trim(vcpf) = '',
        	' and emp.cod_empresa = ' + vDadosIni.codEmpresa,
	        vDadosIni.IfThen(vDadosIni.vEmp.vFinanceiroUnificado,
  	        ' and emp.cod_empresa in ' + vDadosIni.vEmp.vCodigoUnificadas, '')) +
        ' order by emp.cod_empresa ';
      buscas.open;

      fTempEmpresas.EmptyDataSet;

      buscas.First;
      while not buscas.Eof do
      begin
        fTempEmpresas.Insert;
        if vDadosIni.vEmp.vFinanceiroUnificado then
          fTempEmpresas.FieldByName('SEL').AsString := 'S'
        else if buscas.FieldByName('COD_EMPRESA').AsInteger = StrToInt(vDadosIni.codEmpresa) then
          fTempEmpresas.FieldByName('SEL').AsString := 'S';
        fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger := buscas.FieldByName('COD_EMPRESA').AsInteger;
        fTempEmpresas.FieldByName('IDENTIFICACAO_EMP').AsString := buscas.FieldByName('IDENTIFICACAO_EMP').AsString;
        fTempEmpresas.FieldByName('CGC_EMP').AsString := buscas.FieldByName('CGC_EMP').AsString;
        fTempEmpresas.Post;

        buscas.Next;
      end;
    end;

    codEmpresas := '(';
    
    fTempEmpresas.IndexFieldNames := 'COD_EMPRESA';
    fTempEmpresas.First;
    try
      fTempEmpresas.DisableControls;
      fTempEmpresas.First;
      while not fTempEmpresas.Eof do
      begin
        if fTempEmpresas.FieldByName('SEL').AsString = 'S' then
          codEmpresas := codEmpresas + IntToStr(fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger) + ',';

        fTempEmpresas.Next;
      end;
    finally
      fTempEmpresas.EnableControls;
    end;

    codEmpresas := Copy(codEmpresas, 1, Length(codEmpresas) - 1);
    codEmpresas := codEmpresas + ')';

    fTempEmpresas.IndexFieldNames := 'COD_EMPRESA';
    fTempEmpresas.First;

    buscas.Close;
    buscas.SQL.Text := ' select sum(coalesce(controle_creditos.valor_c, 0)) as TotalEmAberto from controle_creditos ' +
      ' inner join controles on ' +
      '		controles.codigo_ctrl = controle_creditos.codigo_ctrl ' +
      '		and controles.codigo_emp = controle_creditos.codigo_emp ' +
      '		and trim(coalesce(controles.exibir_doc, ''A'')) in ('''', ''A'', ''S'') ' +
      ' inner join clientes on ' +
      '		clientes.cod_cliente = controle_creditos.cod_cliente ' +
      '		and clientes.cod_empresa = controle_creditos.cod_emp_mult ' +
      ' where controle_creditos.datq_c is null ' +
      ' and ' + vDadosIni.IfThen(trim(vcpf) = '',
      	 'controle_creditos.cod_cliente = ' + IntToStr(dataset.FieldByName('COD_CLIENTE').AsInteger),
         'clientes.cpfcgc = ' + QuotedStr(vcpf)) +
      ' and controle_creditos.data_rec_c <= ' + quotedstr(FormatDateTime('mm/dd/yyyy', vdataat)) +
