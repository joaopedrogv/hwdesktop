{ TAgendamentos }

constructor TAgendamentos.create;
begin
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  DataSet := TClientDataSet(DtmClientes.cdsAgendamento);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  buscas := TIBQuery.Create(nil);
  buscas.Database := DtmClientes.qrAgendamento.Database;
  buscas.Transaction := transacao;
  FdtSetTipoContato := TClientDataSet.Create(nil);
  FdtSetTipoContato.Close;
  FdtSetTipoContato.FieldDefs.Clear;
  FdtSetTipoContato.FieldDefs.Add('CODIGO', ftInteger, 0, false);
  FdtSetTipoContato.FieldDefs.Add('CONTATOFINALIZACAO', ftString, 32, false);
  FdtSetTipoContato.CreateDataSet;
  FdtSetTipoContato.Open;

  FdtSetFinalizacao := TClientDataSet.Create(nil);
  FdtSetFinalizacao.Close;
  FdtSetFinalizacao.FieldDefs.Clear;
  FdtSetFinalizacao.FieldDefs.Add('CODIGO', ftInteger, 0, false);
  FdtSetFinalizacao.FieldDefs.Add('CONTATOFINALIZACAO', ftString, 32, false);
  FdtSetFinalizacao.CreateDataSet;
  FdtSetFinalizacao.Open;
  buscas.Close;
  buscas.SQL.Text := 'select * from sobreagendamentos';
  buscas.Open;
  while not buscas.eof do
  begin
    if trim(buscas.FieldByName('TIPO').AsString) = 'INICIALIZACAO' then
    begin
      FdtSetTipoContato.Insert;
      FdtSetTipoContato.FieldByName('CODIGO').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
      FdtSetTipoContato.FieldByName('CONTATOFINALIZACAO').AsString :=
        buscas.FieldByName('CONTATOFINALIZACAO').AsString;
      FdtSetTipoContato.Post;
    end else begin
      FdtSetFinalizacao.Insert;
      FdtSetFinalizacao.FieldByName('CODIGO').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
      FdtSetFinalizacao.FieldByName('CONTATOFINALIZACAO').AsString :=
        buscas.FieldByName('CONTATOFINALIZACAO').AsString;
      FdtSetFinalizacao.Post;
    end;
    buscas.Next;
  end;
  buscas.Close;

  dsTipoContato := TDataSource.Create(nil);
  dsTipoContato.DataSet := FdtSetTipoContato;
  dsFinalizacao := TDataSource.Create(nil);
  dsFinalizacao.DataSet := FdtSetFinalizacao;
end;

destructor TAgendamentos.destroy;
begin
  FdtSetFinalizacao.free;
  FdtSetFinalizacao := nil;
  FdtSetTipoContato.Free;
  FdtSetTipoContato := nil;
  inherited;
end;

