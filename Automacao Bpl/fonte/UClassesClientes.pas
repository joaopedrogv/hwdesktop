  SimNao: boolean);
begin
  if SimNao then
  begin
    if Status = 'E' then
      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO CONFIRMADA', 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
        //      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
    else if Status = 'I' then
      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO CONFIRMADA', 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
    //      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
  end
  else
  begin
    if Status = 'E' then
      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
        //      vDadosIni.GravaAuditoria(Processo, 'ALTERAÇÃO NÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas)
    else if Status = 'I' then
      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO NÃO CONFIRMADA', 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
    //      vDadosIni.GravaAuditoria(Processo, 'INCLUSÃO NÃO CONFIRMADA ' + dataSet.FieldByName('COD_CLIENTE').asstring, buscas);
  end;
end;

function TPossivelCliente.insert: boolean;
begin
	Result := inherited Insert;

  if not Result then
  	Exit;

  Preenchecampos;
  TipoCliente.abreTipoCliente;

  abreBairros;
  dataSet.FieldByName('COD_BAIRRO').AsInteger := Lbairro.buscas.FieldByName('COD_BAIRRO').AsInteger;

  abreCidades;
  dataSet.FieldByName('COD_CIDADE').AsInteger := LCidade.buscas.FieldByName('COD_CIDADE').AsInteger;

  abreEstados;
  dataSet.FieldByName('CODIGO_UF').AsInteger := LEstado.buscas.FieldByName('CODIGO_UF').AsInteger;

  dataSet.FieldByName('EST_CODIGO_UF').AsInteger := dataSet.FieldByName('CODIGO_UF').AsInteger;
  dataSet.FieldByName('CODIGO_TIPO').AsInteger := 1;
  dataSet.FieldByName('CEP').AsString := '.';
  dataSet.FieldByName('ENDERECO').AsString := '.';
  dataSet.FieldByName('BAIRRO').AsString := '.';
  dataSet.FieldByName('CIDADE').AsString := '.';
  dataSet.FieldByName('ESTADOS_UF').AsString := '.';
  dataSet.FieldByName('DESC_TP_CLIENTE').AsString := '.';
end;

function TPossivelCliente.JaExisteCPFCNPJ: boolean;
begin
  buscas.Close;
  buscas.SQL.Text := 'select * from clientes ' +
  	 ' where cpfcgc = ' + QuotedStr(dataSet.FieldByName('CPFCGC').AsString) +
    ' and cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;
  if (not buscas.IsEmpty) and (dataSet.FieldByName('CPFCGC').AsString <>
    dataSet.FieldByName('CPFCGC').OldValue) then
  begin
