      	and (Copy(trim(dataset.FieldByName('cond_pag_vnd').AsString), 1, 1) = '(')
      	and (Copy(trim(dataset.FieldByName('cond_pag_vnd').AsString), Length(trim(dataset.FieldByName('cond_pag_vnd').AsString)), 1) <> ')') then
      begin
      	vtemp := '';
