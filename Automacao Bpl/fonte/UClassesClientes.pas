begin
  Close;
  inherited;
end;

function TFaturamento.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    //    campocomerro := '';
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if trim(dataSet.FieldByName('DESC_FAT').AsString) = '' then
      raise exception.create('O campo de descrição de faturamento não pode ser vazio!')
    else
    begin
      if acao = 'EDITAR' then
      begin
        if trim(dataSet.FieldByName('DESC_FAT').OldValue) <>
          trim(dataSet.FieldByName('DESC_FAT').NewValue) then
          if ExecutaComandosSql('select DESC_FAT from TIPO_FATURAMENTO ' +
          	' where DESC_FAT = ' + QuotedStr(dataSet.FieldByName('DESC_FAT').AsString) +
            ' and ATIVO <> 99 ') then
            raise exception.create('Tipo de faturamento já existe cadastrado no banco de dados!');
      end
      else if ExecutaComandosSql('select DESC_FAT from TIPO_FATURAMENTO ' +
      	' where DESC_FAT = ' + QuotedStr(dataSet.FieldByName('DESC_FAT').AsString) +
        ' and ATIVO <> 99 ') then
        raise exception.create('Tipo de faturamento já existe cadastrado no banco de dados!');
    end;

    if acao = 'INSERIR' then
    begin
      buscas.close;
      buscas.SQL.Text := 'select GEN_ID(INC_COD_FATURAMENTO,1) from rdb$database';
      buscas.Open;
      dataSet.FieldByName('CODIGO_FATURAMENTO').AsInteger := buscas.FieldByName('GEN_ID').asinteger;
      buscas.close;
    end;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI107', acao, 'SUCESSO', 'TIPO_FATURAMENTO',
        dataSet.FieldByName('CODIGO_FATURAMENTO').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI107', acao, 'FALHA', 'TIPO_FATURAMENTO',
        dataSet.FieldByName('CODIGO_FATURAMENTO').AsString, buscas);
    if Result then
      Refresh
    else if acao = 'INSERIR' then
      raise exception.create('Erro ao inserir');
  except
    on e: exception do
    begin
      Result := false;
      if e.Message <> 'Erro ao inserir' then
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK)
      else
      begin
        Application.MessageBox('Erro ao gravar registro. Código do Faturamento duplicado.' + chr(13)
          +
          'O código do Faturamento será incrementado em 1 para que você possa tentar novamente.',
          'Informação', MB_OK + MB_ICONINFORMATION +
          MB_DEFBUTTON1);
        dataSet.FieldByName('COD_SERVICO').AsVariant := null;
      end;
    end;
  end;
end;

