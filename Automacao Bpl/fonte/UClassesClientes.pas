          fTempContratos.FieldByName('DIAS_APOS_VENC').AsInteger := buscas.FieldByName('DIAS_APOS_VENC').AsInteger;
          fTempContratos.FieldByName('COD_VENDEDOR').AsInteger := buscas.FieldByName('COD_VENDEDOR').AsInteger;
          fTempContratos.FieldByName('NOME_VENDEDOR').AsString := buscas.FieldByName('NOME_VENDEDOR').AsString;
          fTempContratos.FieldByName('NAO_GERA_FINAN').AsString := buscas.FieldByName('NAO_GERA_FINAN').AsString;

          fTempContratos.FieldByName('GERAR_NFS').AsString := buscas.FieldByName('GERAR_NFS').AsString;
          fTempContratos.FieldByName('GERAR_NF').AsString := buscas.FieldByName('GERAR_NF').AsString;
        	fTempContratos.FieldByName('GERAR_REC_LOC').AsString := buscas.FieldByName('GERAR_REC_LOC').AsString;
        	fTempContratos.FieldByName('GERAR_BOLETO').AsString := buscas.FieldByName('GERAR_BOLETO').AsString;

          fTempContratos.FieldByName('USAR_BOLETO').AsString := buscas.FieldByName('USAR_BOLETO').AsString;
