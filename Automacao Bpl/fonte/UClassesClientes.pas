  end
  else if pIndiceRel = 4 then
  begin
    fRelCab.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if pIndiceRel = 5 then
  begin
    fRelCab.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if pIndiceRel = 6 then
  begin
    fRelCab.ParamByName('dataIni').AsDate := (vDataBasePrGeradorOs);
  end
  else if (pIndiceRel = 7) then
