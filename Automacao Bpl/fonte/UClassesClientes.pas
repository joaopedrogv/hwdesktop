                       try
                         if StrToInt(Config.ReadString('Conf', 'DiasVencimento')) > 0 then
                           vperiodoVencPtos := StrToInt(Config.ReadString('Conf', 'DiasVencimento'))
                         else
                           vperiodoVencPtos := 0;
                       except
                         vperiodoVencPtos := 0;
                       end;
                     finally
                       if Assigned(Config) then
                         FreeAndNil(Config);
                     end;
                   end;

                   if ((vpontoslancamentos > 0) and (vDadosIni.vProgFid.vHabilitarProgFid))
                 	 	 or ((vvalorlancamentos > 0) and (vDadosIni.vCashback.vHabilitarCashback)) then
                   begin
                     dataSet.Insert;
                     dataSet.FieldByName('COD_EMPRESA').AsInteger := strToInt(vDadosIni.codEmpresa);
                     dataSet.FieldByName('COD_EMP_RESP').AsInteger := vcod_empresa;
