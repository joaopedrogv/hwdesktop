procedure TRedistribuirCarteiras._aplicarFiltro(pNome, pRazao, pCidade, pBairro,
  pLocalidade, pSetor: string; pTodosColab, pSemViculo: Boolean);
var
  vTemp: string;
begin
  vTemp := '';
  if pSemViculo then
    vTemp := 'cod_vendedor = 0'
  else
    vTemp := 'cod_vendedor <> 0';

  if not pSemViculo then
    if not pTodosColab then
      vTemp := vTemp + 'AND COD_VENDEDOR = ' + IntToStr(vColabOr.dataSet.FieldByName('cod_vendedor').AsInteger);

  if Trim(pNome) <> '' then
    vTemp := vTemp + 'AND NOME_CLIENTE LIKE ''%' + Trim(pNome) + '%''';

  if Trim(pRazao) <> '' then
    vTemp := vTemp + 'AND RAZAO LIKE ''%' + Trim(pRazao) + '%''';

  if Trim(pCidade) <> '' then
    vTemp := vTemp + 'AND CIDADE LIKE ''%' + Trim(pCidade) + '%''';

  if Trim(pBairro) <> '' then
    vTemp := vTemp + 'AND BAIRRO LIKE ''%' + Trim(pBairro) + '%''';

  if Trim(pLocalidade) <> '' then
    vTemp := vTemp + 'AND LOCALIDADE LIKE ''%' + Trim(pLocalidade) + '%''';

  if Trim(pSetor) <> '' then
    vTemp := vTemp + 'AND SETOR LIKE ''%' + Trim(pSetor) + '%''';

  dataSet.Filter := vTemp;
  dataSet.Filtered := True;

end;

procedure TRedistribuirCarteiras._desmarcarTodos;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desmarcando todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      Application.ProcessMessages;
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

