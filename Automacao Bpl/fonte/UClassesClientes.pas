    //          if Application.MessageBox ('Deseja gerar vale troca do saldo da conta corrente do cliente?',
    //            'Atenção' ,MB_ICONINFORMATION + MB_YESNO) <> IDYES then
    //            exit;

               if trim(vDadosIni.vProgFid.vTipoVendaReqTroca) = '' then
