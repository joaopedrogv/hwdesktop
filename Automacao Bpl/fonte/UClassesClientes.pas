        FreeAndNil(vConf);
    end;

    frmGeradorOSFormasBoletas.PageControl2.ActivePage         := frmGeradorOSFormasBoletas.TabSheet5;

    vDadosIni.abreForm('Geração de O.S./Formas de Pagamento/Boletas', frmGeradorOSFormasBoletas.pnGeradorOS, [ofEscapeExit, ofAlignAllClientWinCtrl]);
  finally
  	frmGeradorOSFormasBoletas.BitBtn8.Click;
  end;
