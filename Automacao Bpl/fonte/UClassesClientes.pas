function TFaturamento.delete: boolean;
var
  vApagar: boolean;
	codFaturamento, descricaoFaturamento: string;
	vtemp: string;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
    	vApagar := dataSet.FieldByName('ATIVO').AsInteger <> 1;
      codFaturamento := dataSet.FieldByName('CODIGO_FATURAMENTO').AsString;
      descricaoFaturamento := dataSet.FieldByName('DESC_FAT').AsString;

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        vApagar := dataSet.FieldByName('ATIVO').AsInteger <> 1;
        codFaturamento := '';
        descricaoFaturamento := '';
      end;
    finally
      prepare_loop_done;
    end;

    try
      if (trim(codFaturamento) <> '') then
        prepare_loop('CODIGO_FATURAMENTO = ' + codFaturamento)
      else
        prepare_loop('SEL = ''S''');

      if vApagar then
      begin
        vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'TIPO DE FATURAMENTO' + #13 +
          'Código: ' + codFaturamento + #13 +
          'Descrição: ' + descricaoFaturamento;

        if (trim(codFaturamento) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('CLI103', '', '', 'TIPO_FATURAMENTO',
          vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
          exit;
      end
      else
      begin
        vtemp := 'Tem certeza que deseja mover este registro para a Lixeira?' + #13 + #13 +
          'TIPO DE FATURAMENTO' + #13 +
          'Código: ' + codFaturamento + #13 +
          'Descrição: ' + descricaoFaturamento;

        if (trim(codFaturamento) = '') then
          vtemp := 'Tem certeza que deseja mover os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados para a lixeira?';

        if not vDadosIni.PesqPros('CLI104', '', '', 'TIPO_FATURAMENTO',
          vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          exit;
      end;

      if vApagar then
        vDadosIni.abreStatusProcessamento('', 'Excluíndo tipo(s) de faturamento permanentemente')
      else
        vDadosIni.abreStatusProcessamento('', 'Movendo tipo(s) de faturamento para lixeira');

      dataset.First;
      while not dataset.Eof do
      begin
        if vApagar then
          vDadosIni.abreStatusProcessamento('', 'Excluíndo tipo(s) de faturamento permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')')
        else
          vDadosIni.abreStatusProcessamento('', 'Movendo tipo(s) de faturamento para lixeira (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

        if vApagar then
        begin
          SqlExec(' update tipo_faturamento set ativo = 99 ' +
            ' where codigo_faturamento = %d ',
            [fint('codigo_faturamento')], buscas);

          if (trim(codFaturamento) = '') then
            vDadosIni.GravaAuditoria('CLI103', 'EXCLUIR', '', 'TIPO_FATURAMENTO',
              dataSet.FieldByName('CODIGO_FATURAMENTO').AsString, buscas);
        end
        else
        begin
          SqlExec(' update tipo_faturamento set ativo = 0 ' +
            ' where codigo_faturamento = %d ',
            [fint('codigo_faturamento')], buscas);

          if (trim(codFaturamento) = '') then
            vDadosIni.GravaAuditoria('CLI104', 'EXCLUIR', '', 'c',
              dataSet.FieldByName('CODIGO_FATURAMENTO').AsString, buscas);
        end;

        dataset.Next;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    Result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CLI103', 'CLI104'),
        'EXCLUIR', 'SUCESSO', 'TIPO_FATURAMENTO',
        vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria(vDadosIni.IfThen(vApagar, 'CLI103', 'CLI104'),
        'EXCLUIR', 'FALHA', 'TIPO_FATURAMENTO',
        vDadosIni.IfThen(trim(codFaturamento) <> '', codFaturamento, ''), buscas);
    end;

    if Result then
      Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

