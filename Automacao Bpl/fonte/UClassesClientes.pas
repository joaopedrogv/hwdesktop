                 if result then
                   result := apply;

                 SqlOpen(' select cod_cliente, nome_cliente, cpfcgc from clientes ' +
                   ' where cod_cliente = ' + IntToStr(pCodCliente) +
                   ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2);

                 buscas.Close;
                 buscas.SQL.Text := ' INSERT INTO VALE_CUPONS ( ' +
                    ' CODIGO, ERP_API, COD_EMPRESA, NOME, CPF, CARTAO, PONTOS, VALOR, ' +
                    ' DESCRICAO, EMPRESA, VALIDADO, OPERADOR, DATAHORA, ' +
                    ' NDOC, TIPODOC, COD_EMP_TIPODOC, NUM_DOC, TIPO_DOC, COD_EMP_DOC) ' +
                    ' VALUES ( ' +
                    ' :CODIGO, :ERP_API, :COD_EMPRESA, :NOME, :CPF, :CARTAO, :PONTOS, :VALOR, ' +
                    ' :DESCRICAO, :EMPRESA, :VALIDADO, :OPERADOR, :DATAHORA, ' +
