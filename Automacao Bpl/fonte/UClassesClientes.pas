    '  inner join tipo_preco t on t.cod_tppreco = p.cod_tppreco and t.cod_empresa = p.cod_empresa' +
    '  where cod_promocao = ' + IntToStr(pCod) + ' and t.tipo = ''T'' and p.ativo = 1 and p.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Prepare;
