procedure TRegrasValeTrocaProgFid.ObterTotal_pontos(pLabel, pLabel2: TLabel; var pPontosTroca: Double; var pValorTroca: Double);
var
  vPontos: Double;
  vRecno: Integer;
begin
  pPontosTroca := 0;
  pValorTroca := 0;

  vRecno := 0;

//  if fTempValeTroca.RecNo >= 0 then
//    vRecno := fTempValeTroca.RecNo;

  fTempValeTroca.First;
  while not fTempValeTroca.Eof do
  begin
     pPontosTroca := pPontosTroca + fTempValeTroca.FieldByName('tot_pontos').AsFloat;
     pValorTroca := pValorTroca + fTempValeTroca.FieldByName('valor_tot').AsFloat;

     fTempValeTroca.Next;
  end;
  fTempValeTroca.First;

//  fTempValeTroca.RecNo := vRecno;

  pLabel.Caption := 'Pontos: ' + FormatFloat('#,##0', pPontosTroca);
  pLabel2.Caption := 'Valor: ' + FormatFloat('#,##0.00', pValorTroca);
end;

