function TCadClientes.sugerirPossivelCliente(pPanel: TPanel; pGrid: TDBGrid): Boolean;
var
  vList: TStrings;
  vSql: string;
  vtmpDataSetProvider: TDataSetProvider;
  vtmpDataSet: TClientDataSet;
  vtmpQuery: TIBQuery;
  vtmpDataSource: TDataSource;
  vTodosPossiveisClientes: Boolean;
begin
  Result := False;

  if not vDadosIni.getConfSisBool('cl_cad_sugerir_possivel_cliente', Cliente.buscas) then
    Exit;

  vtmpQuery := TIBQuery.Create(Application);
  vtmpQuery.Database := buscas.Database;
  vtmpQuery.Transaction := buscas.Transaction;

  vtmpDataSetProvider := TDataSetProvider.Create(Application);
  vtmpDataSetProvider.DataSet := vtmpQuery;
  vtmpDataSetProvider.Options := [poAllowCommandText,poUseQuoteChar];
  vtmpDataSetProvider.Name := 'DSPDatasetPossivelCliente';

  vtmpDataSet := TClientDataSet.Create(Application);
  vtmpDataSet.ProviderName := 'DSPDatasetPossivelCliente';

  vtmpDataSource := TDataSource.Create(Application);
  vtmpDataSource.AutoEdit := False;
  vtmpDataSource.DataSet := vtmpDataSet;

  pGrid.Options := pGrid.Options - [dgEditing];
  pGrid.DataSource := vtmpDataSource;

  try

    vList := TStringList.Create;
    vList := vDadosIni.getConfSisBlob('cl_cad_sugerir_possivel_cliente', Cliente.buscas);

    vTodosPossiveisClientes := True;
    vSql := '';
    if vList.Count > 1 then
    begin
      vTodosPossiveisClientes := vDadosIni.getValue(vList[1], 1) = 'T';
      vSql := vDadosIni.getValue(vList[1], 2);
    end;

    if Trim(vSql) = '' then
      vSql :=
        ' cod_cliente "Codigo", nome_cliente "Cliente", fone_cliente "Telefone", apelido "Apelido", data_nasc "Data Nasc",' +
        ' endereco "Logradouro", num_end_cliente "Num", complemento "Complemento", bairro "Bairro", cidade "Cidade",' +
        ' sexo "Sexo", email "email"';

    vSql := 'select ' + vSql + ', nome_cliente "filter" from clientes ' +
    	' where cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ativo = 2';
    if not vTodosPossiveisClientes then
      vSql := vSql + ' and US_CAD_CLI = ' + IntToStr(vDadosIni.vCodUsuario);
    vSql := vSql + ' order by nome_cliente';

    vtmpQuery.SQL.Text := vSql;
    vtmpDataSet.Close;
    vtmpDataSet.CommandText := vSql;
    vtmpDataSet.Open;

    if vtmpDataSet.IsEmpty then
      Exit;
      
    if vDadosIni.abreForm('Possiveis clientes. Selecione para continuar', pPanel, [ofAutoSize]) then
      if vtmpDataSet.FieldByName('Codigo').AsInteger > 0 then
      begin
        montaSelect('SELECT ' + Fsql_campos + ' FROM CLIENTES ' +
          Fsql_inner +
          ' WHERE CLIENTES.COD_CLIENTE = ' + IntToStr(vtmpDataSet.FieldByName('CODIGO').AsInteger) +
          ' AND CLIENTES.COD_EMPRESA = ' + vDadosIni.codEmpresa);
        Result := True;
      end;
  finally
    FreeAndNil(vtmpDataSource);
    FreeAndNil(vtmpDataSet);
    FreeAndNil(vtmpDataSetProvider);
    FreeAndNil(vtmpQuery);
  end;
end;

function TCadClientes.TestaCPFCNPJ: boolean;
begin
  result := true;
  if trim(dataSet.FieldByName('CPFCGC').AsString) = '' then
  begin
    Application.MessageBox('Preenchimento do Campo CPF/CNPJ é obrigatório', 'Informação', MB_OK
      + MB_ICONERROR + MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if (length(trim(dataSet.FieldByName('CPFCGC').asstring)) <> 14) and
    (length((trim(dataSet.FieldByName('CPFCGC').asstring))) <> 11) then
  begin
    Application.MessageBox('CPF/CNPJ Inválido.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('.', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Ponto.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('-', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Traço.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('/', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Barra.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if length(trim(dataSet.FieldByName('CPFCGC').asstring)) = 11 then
  begin
    if CPF(trim(dataSet.FieldByName('CPFCGC').asstring)) then
    begin
      dataSet.FieldByName('CPFCGC').EditMask := '999.999.999-99;0;';
      result := true;
    end
    else
    begin
      Application.MessageBox('Erro ao Cadastrar CPF' + chr(13) + 'CPF Inválido.', 'Informação',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end;
  end
  else if length((trim(dataSet.FieldByName('CPFCGC').asstring))) = 14 then
    if CNPJ(trim(dataSet.FieldByName('CPFCGC').asstring)) then
    begin
      dataSet.FieldByName('CPFCGC').EditMask := HelperCNPJ.EditMask;//'99.999.999/9999-99;0;';
//      dataSet.FieldByName('CONVENIADO').asstring := 'N';
      dataSet.FieldByName('COD_CONVENIO').AsVariant := null;
      dataSet.FieldByName('NATURALID').AsVariant := null;
      dataSet.FieldByName('DATA_NASC').AsVariant := null;
      dataSet.FieldByName('SEXO').AsVariant := null;
      dataSet.FieldByName('ESTADO_CIVIL').AsVariant := null;
      dataSet.FieldByName('CONJUGE').AsVariant := null;
      dataSet.FieldByName('PAI').AsVariant := null;
      dataSet.FieldByName('MAE').AsVariant := null;
      dataSet.FieldByName('RG').AsVariant := null;
      dataSet.FieldByName('EXPEDIC').AsVariant := null;
      dataSet.FieldByName('ORG_EXPEDIC').AsVariant := null;
      result := true;
    end
    else
    begin
      Application.MessageBox('Erro ao Cadastrar CNPJ' + chr(13) + 'CNPJ Inválido.', 'Informação',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end;
end;

