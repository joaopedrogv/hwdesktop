procedure TCadClientes.ListaControlesFicha(CheckListBox: TCheckListBox);
var
  i: integer;
begin
  buscas.Close;
  buscas.SQL.Text := 'select * from CONTROLES where CXENT = ''S'' and DOCS = ''S2''' +
    ' and codigo_emp = ' + vDadosIni.codEmpresa + ' order by NOME_CTRL';
  buscas.Open;
  buscas.FetchAll;
  SetLength(CodigosControles, buscas.RecordCount);
  buscas.First;
  i := 0;
  while not buscas.EOF do
  begin
    CheckListBox.Items.Add(buscas.FieldByName('NOME_CTRL').AsString);
    CodigosControles[i] := buscas.FieldByName('CODIGO_CTRL').AsString;
    Buscas.Next;
    Inc(i);
  end;
end;

function TCadClientes.ListaEtiquetasCli: integer;
begin
  result := 0;
  buscas.Close;
  buscas.SQL.Text := 'select cod_etiqueta,descricao from CABECALHO_ETIQUETA where cod_empresa=' +
    vDadosIni.codEmpresa +
    ' and ativo = 1 and upper(TABELA)= ' + quotedstr('CLIENTES');
  buscas.Open;
  if buscas.IsEmpty then
  begin
    result := 0;
    Application.MessageBox('Não existe ainda nenhuma etiqueta configurada para clientes.',
      'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
    exit;
  end;
  try
    Application.CreateForm(TFrmSelEtiquetaCli, FrmSelEtiquetaCli);
    FrmSelEtiquetaCli.DataSource1.DataSet := buscas;
    //    FrmSelEtiquetaCli.DBLookupCombo1.DataField := 'COD_ETIQUETA;DESCRICAO';
    FrmSelEtiquetaCli.DBLookupComboBox1.ListSource := FrmSelEtiquetaCli.DataSource1;
    FrmSelEtiquetaCli.DBLookupComboBox1.ListField := 'DESCRICAO;COD_ETIQUETA';
    FrmSelEtiquetaCli.DBLookupComboBox1.KeyField := 'DESCRICAO';
    if FrmSelEtiquetaCli.showModal = mrOK then
    begin
      if FrmSelEtiquetaCli.DBLookupComboBox1.Text <> '' then
        result := buscas.FieldByName('COD_ETIQUETA').AsInteger
      else
        result := 0;
    end
    else
      result := 0;
    buscas.close;
  finally
    FrmSelEtiquetaCli.Free;
    FrmSelEtiquetaCli := nil;
  end;
end;

function TCadClientes.LocCliConveniado(codcliente: integer): string;
begin
  buscas.Close;
  buscas.SQL.Text := 'SELECT * FROM CLIENTES WHERE CONVENIADO=''S''' +
    ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo=1 and cod_cliente = ' +
    inttostr(codcliente);
  buscas.Open;
  result := buscas.FieldByName('NOME_CLIENTE').AsString;
  if (buscas.IsEmpty) and (not dataset.FieldByName('COD_CONVENIO').IsNull) then
  begin
    Application.MessageBox('Código do cliente selecionado não é de um cliente conveniado.',
      'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
    dataSet.FieldByName('COD_CONVENIO').AsVariant := null;
  end;
  if dataSet.FieldByName('COD_CONVENIO').IsNull then
    dataSet.FieldByName('COD_TAB_PRECO').AsVariant := null
  else
    dataSet.FieldByName('COD_TAB_PRECO').AsInteger := buscas.FieldByName('COD_TAB_PRECO').AsInteger;
  buscas.close;
end;

