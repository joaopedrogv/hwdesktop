function TEnviarContratosClientes.verificaDespesasNF(
	pNumOs: Integer;
  pTipo: string;
  pValorTotal: Double;
  pValorProd: Double;
  pValorServ: Double;
  pValorBol: Double): boolean;
var
	vValorNF: Double;
  vValorProd: Double;

  vValorTotalPedVenda: Double;
  vValorRetencaoProd: Double;
  buscas2: TIBQuery;

  vAtualizarItens: Boolean;
  vAtualizarFP: Boolean;
  vAtualizarBol: Boolean;
begin
	try
  	try
      Result := True;

      vAtualizarItens := False;
      vAtualizarFP    := False;
      vAtualizarBol   := False;

      SqlOpen(' select notafiscal.valor_total ' +
      	' from notafiscal ' +
        ' inner join pedvenda on ' +
        '   pedvenda.nped = notafiscal.nped ' +
        '   and pedvenda.tipo = notafiscal.tipo_ped ' +
        '   and pedvenda.cod_empresa = notafiscal.cod_empresa ' +
        '   and pedvenda.num_nf = notafiscal.num_nf ' +
        '   and pedvenda.serie_nf = notafiscal.serie ' +
        ' where notafiscal.nped = ' + IntToStr(pNumOS) +
        ' and notafiscal.tipo_ped = ' + QuotedStr(pTipo) +
        ' and notafiscal.cod_empresa = ' + vDadosIni.codEmpresa, buscas);

      vValorNF       := buscas.FieldByName('VALOR_TOTAL').AsFloat;

      SqlOpen(' select sum(coalesce(vltot_ped_item, 0) + coalesce(rateio_acresc, 0) - coalesce(rateio_desc, 0)) valor_prod from pedvenda_prod ' +
        ' where nped = ' + IntToStr(pNumOs) +
        ' and tipo = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(status,'''') <> ''CANCELADO'' ', buscas);

      vValorProd     := buscas.FieldByName('VALOR_PROD').AsFloat;

      if (vValorNF <= vValorProd) then
        Exit;

      SqlOpen(' select n_seq_bol, cod_cobrebem, nosso_numero_banco, remessa_enviada from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas).FetchAll;

      buscas.First;
      while not buscas.Eof do
      begin
        if trim(buscas.FieldByName('NOSSO_NUMERO_BANCO').AsString) <> '' then
          exit
        else if buscas.FieldByName('COD_COBREBEM').AsInteger > 0 then
          exit
        else if trim(buscas.FieldByName('REMESSA_ENVIADA').AsString) = 'S' then
          exit;

        buscas.Next;
      end;

      vValorRetencaoProd := 0;
      SqlOpen(' select seqform, ' +
        ' cod_empresa, ' +
        ' coalesce(prcss, ''N'') prcss, ' +
        ' permitir_excluir, ' +
        ' coalesce(valordoc, 0) valordoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).FetchAll;

      buscas.First;
      while not buscas.Eof do
      begin
    		// Forma de pagamento processada
        if trim(buscas.FieldByName('PRCSS').AsString) = 'S' then
          exit;

        if trim(buscas.FieldByName('PERMITIR_EXCLUIR').AsString) = 'R' then
        	vValorRetencaoProd := vValorRetencaoProd + buscas.FieldByName('VALORDOC').AsFloat;

        buscas.Next;
      end;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      SqlOpen(' select ' +
        ' pedvenda_prod.nped, ' +
        ' pedvenda_prod.tipo, ' +
        ' pedvenda_prod.grupo_prod, ' +
        ' pedvenda_prod.cod_prod, ' +
        ' pedvenda_prod.nitem, ' +
        ' pedvenda_prod.cod_empresa, ' +
        ' pedvenda_prod.cod_grade, ' +
        ' pedvenda_prod.codigo_nop, ' +
        ' notafiscal_item.valor_icmsub, ' +
        ' notafiscal_item.rateio_seguro, ' +
        ' notafiscal_item.valor_ipi, ' +
        ' notafiscal_item.rateio_outdesp, ' +
        ' notafiscal_item.valor_ii ' +
        ' from pedvenda_prod ' +
        ' inner join notafiscal_item on ' +
        ' 	notafiscal_item.nped = pedvenda_prod.nped ' +
        '		and notafiscal_item.tipo_ped = pedvenda_prod.tipo ' +
        ' 	and notafiscal_item.grupo_prod = pedvenda_prod.grupo_prod ' +
        ' 	and notafiscal_item.cod_prod = pedvenda_prod.cod_prod ' +
        ' 	and notafiscal_item.nitem_ped = pedvenda_prod.nitem ' +
        ' 	and notafiscal_item.cod_empresa = pedvenda_prod.cod_empresa ' +
        ' where pedvenda_prod.nped = ' + IntToStr(pNumOS) +
        ' and pedvenda_prod.tipo = ' + QuotedStr(pTipo) +
        ' and pedvenda_prod.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and (pedvenda_prod.status <> ''CANCELADO'' or pedvenda_prod.status is null) ', buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        buscas.Close;
        buscas.SQL.Text := 'update pedvenda_prod pvp ' +
          ' set pvp.rateio_acresc = :vl_desp_nf ' + //coalesce(pvp.rateio_acresc, 0) + :vl_desp_nf
          ', pvp.vl_desp_nf = :vl_desp_nf ' +
          ' where pvp.nped = ' + buscas2.FieldByName('nped').AsString +
          ' and pvp.tipo = ' + QuotedStr(buscas2.FieldByName('tipo').AsString) +
          ' and pvp.grupo_prod = ' + buscas2.FieldByName('grupo_prod').AsString +
          ' and pvp.cod_prod = ' + QuotedStr(buscas2.FieldByName('cod_prod').AsString) +
          ' and pvp.nitem = ' + buscas2.FieldByName('nitem').AsString +
          ' and pvp.cod_empresa = ' + vDadosIni.codEmpresa;
        buscas.ParamByName('vl_desp_nf').AsFloat :=
          buscas2.FieldByName('valor_icmsub').AsFloat +
          buscas2.FieldByName('rateio_seguro').AsFloat +
          buscas2.FieldByName('valor_ipi').AsFloat +
          buscas2.FieldByName('rateio_outdesp').AsFloat +
          buscas2.FieldByName('valor_ii').AsFloat;

        buscas.ParamByName('vl_desp_nf').AsFloat := vDadosIni.StrToFloatFormat(buscas.ParamByName('vl_desp_nf').AsFloat, 2);
        buscas.ExecSQL;

        vAtualizarItens := True;

        buscas2.Next;
      end;

      SqlOpen(' select sum(coalesce(vltot_ped_item, 0) + coalesce(rateio_acresc, 0) - coalesce(rateio_desc, 0)) soma from pedvenda_prod ' +
        ' where nped = ' + IntToStr(pNumOs) +
        ' and tipo = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(status,'''') <> ''CANCELADO''' +
        ' union all' +
        ' select sum(coalesce(valor_tot_serv, 0) + coalesce(rateio_acresc, 0) - coalesce(rateio_desc, 0)) soma from pedvenda_serv ' +
        ' where nped = ' + IntToStr(pNumOs) +
        ' and tipo = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and coalesce(status,'''') <> ''CANCELADO''' +
        ' union all' +
        ' select sum(coalesce(vl_total, 0)) soma from pedvenda_prod_terc ' +
        ' where nped = ' + IntToStr(pNumOs) +
        ' and tipo = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' union all' +
        ' select sum(coalesce(vl_servt, 0)) soma from pedvenda_serv_terc ' +
        ' where nped = ' + IntToStr(pNumOs) +
        ' and tipo = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).FetchAll;
      buscas2.FetchAll;

      vValorTotalPedVenda := 0;
      buscas2.First;
      while not buscas2.Eof do
      begin
        vValorTotalPedVenda := vValorTotalPedVenda + buscas2.FieldByName('soma').AsFloat;

        buscas2.Next;
      end;

      buscas.Close;
      buscas.SQL.Text := 'update pedvenda set valor_total = :valor_total' +
        ' where cod_empresa = :cod_empresa and tipo = :tipo and nped = :nped';
      buscas.ParamByName('NPED').AsInteger := pNumOs;
      buscas.ParamByName('TIPO').AsString := pTipo;
      buscas.ParamByName('COD_EMPRESA').AsString := vDadosIni.codEmpresa;
      buscas.ParamByName('VALOR_TOTAL').AsFloat := vDadosIni.StrToFloatFormat(vValorTotalPedVenda, 2);
      buscas.ExecSQL;

      SqlOpen(' select seqform, cod_empresa, ' +
        ' coalesce(valordoc, 0) valordoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        if (vDadosIni.StrToFloatFormat(pValorProd + vValorRetencaoProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorProd + pValorServ + vValorRetencaoProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2)) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE FORMPAGAMENTO SET VALORDOC = (VALORDOC + :VALOR_DESP) ' +
            ' WHERE SEQFORM = ' + IntToStr(buscas2.FieldByName('SEQFORM').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(buscas2.FieldByName('COD_EMPRESA').AsInteger);
          buscas.ParamByName('VALOR_DESP').AsFloat := vDadosIni.StrToFloatFormat(vValorNF - pValorProd, 2);
          buscas.ExecSQL;

          vAtualizarFP := True;
        end;

        buscas2.Next;
      end;

      SqlOpen(' select n_seq_bol, cod_empresa, ' +
        ' coalesce(vl_doc_bol, 0) vl_doc_bol from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        if (vDadosIni.StrToFloatFormat(pValorProd + vValorRetencaoProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorProd + pValorServ + vValorRetencaoProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2)) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' UPDATE BOLETAS SET VL_DOC_BOL = (VL_DOC_BOL + :VALOR_DESP) ' +
            ' WHERE N_SEQ_BOL = ' + IntToStr(buscas2.FieldByName('N_SEQ_BOL').AsInteger) +
            ' AND COD_EMPRESA = ' + IntToStr(buscas2.FieldByName('COD_EMPRESA').AsInteger);
          buscas.ParamByName('VALOR_DESP').AsFloat := vDadosIni.StrToFloatFormat(vValorNF - pValorProd, 2);
          buscas.ExecSQL;

          vAtualizarBol := True;
        end;

        buscas2.Next;
      end;

      if (vAtualizarItens) and (vAtualizarFP) and ((pValorBol > 0) and (vAtualizarBol)) then
      	CommitaTransacao
      else if (vAtualizarItens) and (vAtualizarFP) and (pValorBol <= 0) then
      	CommitaTransacao
      else
      	RollBackTransacao;

      buscas.Close;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
    if Assigned(buscas2) then
      FreeAndNil(buscas2);
  end;
end;

function TEnviarContratosClientes.verificarConfRetencaoNF: Boolean;
var
	controles: TStrings;
	conf: TConfig_sistema_class;
  vDocs: string;
  vControle: string;
  I: Integer;
begin
	try
    try
      Result := True;

      controles := NewStringList(True);

      conf := TCfg_sis.getConf('nf_s_retencoes_federais', buscas, vDadosIni.cod_empresa);

      if not conf.AsBoolean then
      begin
        Application.MessageBox(pchar('Favor habilitar a configuração "nf_s_retencoes_federais"' +
          ' e informar os controles para IRRF/CSLL/PIS/COFINS.' + #13 + #13 +
          'Para realizar o lançamento do Valor do ISS Retido da NFe de Produtos.'), 'Atenção', MB_ICONERROR + MB_OK);
        Result := False;
        exit;
      end;

      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_IRRF', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_CSLL', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_PIS', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_COFINS', 0)));

      if conf.ReadInteger('Controles', 'Retencao_IRRF', 0) <= 0 then
      begin
        Application.MessageBox(pchar('Favor informar controle configurado como baixa automática' +
          ' ou controle configurado para não gerar financeiro (Retencao_IRRF).' + #13 + #13 +
          'Para realizar o lançamento do Valor do ISS Retido da NFe de Produtos.'), 'Atenção', MB_ICONERROR + MB_OK);
        Result := False;
        exit;
      end;

      if conf.ReadInteger('Controles', 'Retencao_CSLL', 0) <= 0 then
      begin
        Application.MessageBox(pchar('Favor informar controle configurado como baixa automática' +
          ' ou controle configurado para não gerar financeiro (Retencao_CSLL).' + #13 + #13 +
          'Para realizar o lançamento do Valor do ISS Retido da NFe de Produtos.'), 'Atenção', MB_ICONERROR + MB_OK);
        Result := False;
        exit;
      end;

      if conf.ReadInteger('Controles', 'Retencao_PIS', 0) <= 0 then
      begin
        Application.MessageBox(pchar('Favor informar controle configurado como baixa automática' +
          ' ou controle configurado para não gerar financeiro (Retencao_PIS).' + #13 + #13 +
          'Para realizar o lançamento do Valor do ISS Retido da NFe de Produtos.'), 'Atenção', MB_ICONERROR + MB_OK);
        Result := False;
        exit;
      end;

      if conf.ReadInteger('Controles', 'Retencao_COFINS', 0) <= 0 then
      begin
        Application.MessageBox(pchar('Favor informar controle configurado como baixa automática' +
          ' ou controle configurado para não gerar financeiro (Retencao_COFINS).' + #13 + #13 +
          'Para realizar o lançamento do Valor do ISS Retido da NFe de Produtos.'), 'Atenção', MB_ICONERROR + MB_OK);
        Result := False;
        exit;
      end;

      for I := 0 to controles.Count - 1 do
      begin
        SqlOpen(' select codigo_ctrl, codigo_emp, nome_ctrl, docs, ' +
          ' coalesce(nao_gera_finan, ''N'') nao_gera_finan, ' +
          ' coalesce(baixa_automatica, ''N'') baixa_automatica, ' +
          ' coalesce(n_conta_bx_auto, 0) n_conta_bx_auto from controles ' +
          ' where codigo_ctrl = ' + controles[I] +
          ' and codigo_emp = ' + vDadosIni.codEmpresa +
          ' and ativo <> 99 ', buscas);

        if buscas.IsEmpty then
        begin
          Application.MessageBox(pchar('Controle não encontrado,' +
            ' favor informar controle configurado como baixa automática' +
            ' ou controle configurado para não gerar financeiro.' + #13 + #13 +
            'Para realizar o lançamento do Valor das Retenções Federais da NFe'), 'Atenção', MB_ICONERROR + MB_OK);
          Result := False;
          exit;
        end;

        vControle := trim(buscas.FieldByName('NOME_CTRL').AsString);
        vDocs     := trim(buscas.FieldByName('DOCS').AsString);

        if (buscas.FieldByName('NAO_GERA_FINAN').AsString = 'S')
          and (buscas.FieldByName('BAIXA_AUTOMATICA').AsString = 'S') then
        begin
          Application.MessageBox(pchar('Controle deve ser como baixa automática ou configurado para não gerar financeiro.' + #13 + #13 +
            'CONTROLE' + #13 +
            'Cod Controle: ' + trim(controles[I]) + #13 +
            'Descrição: ' + trim(vControle) + #13 + #13 +
            'Para realizar o lançamento das Retenções Federais da NFSe'), 'Atenção', MB_ICONERROR + MB_OK);
          Result := False;
          exit;
        end;

        if (buscas.FieldByName('BAIXA_AUTOMATICA').AsString = 'S')
          and (buscas.FieldByName('N_CONTA_BX_AUTO').AsFloat <= 0) then
        begin
          Application.MessageBox(pchar('Favor informar o número da conta de saída plc para baixa automática.' +
            'CONTROLE' + #13 +
            'Cod Controle: ' + trim(controles[I]) + #13 +
            'Descrição: ' + trim(vControle) + #13 + #13 +
            'Para realizar o lançamento das Retenções Federais da NFSe'), 'Atenção', MB_ICONERROR + MB_OK);
          Result := False;
          exit;
        end;
      end;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
  	if Assigned(conf) then
      FreeAndNil(conf);
    if Assigned(controles) then
      FreeAndNil(controles);
  end;
end;

function TEnviarContratosClientes.verificarConfRetencaoNFS: Boolean;
begin
	try
  	Result := True;

    if vDadosIni.vPedVnd.ctrlIssRetidoNFSe <= 0 then
    begin
    	Application.MessageBox(pchar('Controle não informado "ped_vnd_os_ctrl_iss_retido_nfse",' +
      	' favor informar controle configurado como baixa automática' +
      	' ou controle configurado para não gerar financeiro.' + #13 + #13 +
        'Para realizar o lançamento do Valor do ISS Retido da NFSe de Serviços.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' select codigo_ctrl, codigo_emp, docs, ' +
      ' coalesce(nao_gera_finan, ''N'') nao_gera_finan, ' +
    	' coalesce(baixa_automatica, ''N'') baixa_automatica, ' +
      ' coalesce(n_conta_bx_auto, 0) n_conta_bx_auto from controles ' +
    	' where codigo_ctrl = ' + IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe) +
      ' and codigo_emp = ' + vDadosIni.codEmpresa +
      ' and ativo <> 99 ';
    buscas.Open;

    if buscas.IsEmpty then
    begin
    	Application.MessageBox(pchar('Controle não encontrado "ped_vnd_os_ctrl_iss_retido_nfse",' +
      	' favor informar controle configurado como baixa automática' +
      	' ou controle configurado para não gerar financeiro.' + #13 + #13 +
        'Para realizar o lançamento do Valor do ISS Retido da NFSe de Serviços.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      exit;
    end;

    if (buscas.FieldByName('NAO_GERA_FINAN').AsString <> 'S')
    	and (buscas.FieldByName('BAIXA_AUTOMATICA').AsString <> 'S') then
    begin
      Application.MessageBox(pchar('Controle deve ser como baixa automática' +
      	' ou configurado para não gerar financeiro "ped_vnd_os_ctrl_iss_retido_nfse".' + #13 + #13 +
        'Para realizar o lançamento do Valor do ISS Retido da NFSe de Serviços.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      exit;
    end;

    if (buscas.FieldByName('BAIXA_AUTOMATICA').AsString = 'S')
    	and (buscas.FieldByName('N_CONTA_BX_AUTO').AsFloat <= 0) then
    begin
    	Application.MessageBox(pchar('Favor informar o número da conta de saída plc para baixa automática "ped_vnd_os_ctrl_iss_retido_nfse".' +
     		'Para realizar o lançamento do Valor do ISS Retido da NFSe de Serviços.'), 'Atenção', MB_ICONERROR + MB_OK);
      Result := False;
      exit;
    end;
  except
  	on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TEnviarContratosClientes.ResolverRetencoesDocumentosFiscais(
  pNumOs: Integer;
  pTipo: string): boolean;
var
  vValorTotBol: Double;
  VTotRetNFSe, VTotRetNFe, VTotOS, VTotBoletos, VRetRestante, VTotProdutos, VTotServicos, Valor: Currency;
  vretir, vretcsll, vretpis, vretcofins, vretcp, vretiss: Currency;
  I, seqForm: Integer;
  txtRet, ndoc, docsctrl: string;
  controles: TStrings;
	conf: TConfig_sistema_class;
  retNFSeOS: RetencoesNFSeDaOSOutput;
  qExec: TIBQuery;
  queryExec: TQuery_OOP;
begin
  conf := nil;
  controles := NewStringList(True);
  qExec := Self.Create_new_fb_query(buscas.Transaction);
  queryExec := QueryHelper.CreateObj(qExec);
	try
    try
      Result := True;

      queryCons.Open(
        'select first 1 ' +
        ' iif(notafiscal.situacao_nfe = ''Autorizada'', 0, 1) ordem_nota, ' +
        ' pedvenda.valor_total, pedvenda.num_nfeext, pedvenda.num_nf, ' +
      	' notafiscal.cod_nf, notafiscal.situacao_nfe, ' +
        ' coalesce(notafiscal.valor_total, 0) valor_nf, ' +
        ' notafiscal.valor_irrf, notafiscal.vretcsll, notafiscal.vretpis, notafiscal.vretcofins, ' +
        ' coalesce((select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedvenda_prod ' +
        '           where pedvenda_prod.nped = pedvenda.nped ' +
        '           and pedvenda_prod.tipo = pedvenda.tipo ' +
        '           and pedvenda_prod.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_prod.status <> ''CANCELADO'' or pedvenda_prod.status is null)), 0) valor_tot_prod, ' +
        ' coalesce((select sum(coalesce(pedvenda_serv.valor_tot_serv, 0)) from pedvenda_serv ' +
        '           where pedvenda_serv.nped = pedvenda.nped ' +
        '           and pedvenda_serv.tipo = pedvenda.tipo ' +
        '           and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null)), 0) valor_tot_serv, ' +
        ' coalesce((select sum(coalesce(boletas.vl_doc_bol, 0)) from boletas ' +
        '						where num_nf_vnd = pedvenda.nped ' +
        ' 					and tipo_emissao = pedvenda.tipo ' +
        ' 					and cod_empresa = pedvenda.cod_empresa ' +
        ' 					and ativo = 1), 0) valor_tot_bol ' +
        ' from pedvenda ' +
        ' left join notafiscal on ' +
        '     notafiscal.nped = pedvenda.nped ' +
        '     and notafiscal.tipo_ped = pedvenda.tipo ' +
        '     and notafiscal.cod_empresa = pedvenda.cod_empresa ' +
        ' where pedvenda.nped = ' + IntToStr(pNumOs) +
        ' and pedvenda.tipo =  ' + QuotedStr(pTipo) +
        ' and pedvenda.cod_empresa = '+ vDadosIni.codEmpresa +
        ' and pedvenda.status_ped = ''FECHADA'' ' +
        ' order by ordem_nota, notafiscal.cod_nf desc');

      VTotOS       := queryCons.fcurr('valor_total', -2);
      VTotBoletos  := queryCons.fcurr('valor_tot_bol', -2);
      VTotProdutos := queryCons.fcurr('valor_tot_prod', -2);
      VTotServicos := queryCons.fcurr('valor_tot_serv', -2);

      vretir     := queryCons.fcurr('valor_irrf', -2);
      vretcsll   := queryCons.fcurr('vretcsll', -2);
      vretpis    := queryCons.fcurr('vretpis', -2);
      vretcofins := queryCons.fcurr('vretcofins', -2);
      vretiss    := 0;
      vretcp     := 0;

      VTotRetNFe := vretir + vretcsll + vretpis + vretcofins + vretiss + vretcp;

      if (VTotRetNFe > 0) and queryCons.fdif('situacao_nfe', 'Autorizada') then
        raise Exception.Create(
          'NFe modelo 55 não está "Autorizada" e possui valores de retenção. ' + sLineBreak +
          'Por favor acesse o módulo da NFe e resolva a situação antes de continuar'
        );

      queryCons.SQL(
        'select sum(iif(n.situacao = 5, 0, 1)) nao_autorizada, sum(ns.vretirrf) vretirrf, sum(ns.vretcp) vretcp, sum(ns.vretpis) vretpis, ' +
        'sum(ns.vretcofins) vretcofins, sum(ns.vretcsll) vretcsll, sum(ns.vretiss) vretiss ' +
        'from nfse_os ns ' +
        'inner join nfse n on n.id = ns.nfse_id and n.situacao <> 0 ' +
        'where ns.nped = :nped and ns.tipo = :tipo and ns.cod_empresa = :cod_empresa')
        .ParamValue('nped', pNumOs)
        .ParamValue('tipo', pTipo)
        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
        .Open();

      VTotRetNFSe := queryCons.fcurr('vretiss', -2)
        + queryCons.fcurr('vretirrf', -2)
        + queryCons.fcurr('vretcsll', -2)
        + queryCons.fcurr('vretpis', -2)
        + queryCons.fcurr('vretcofins', -2)
        + queryCons.fcurr('vretcp', -2);

      if queryCons.fint('nao_autorizada') > 0 then
      begin
        if VTotRetNFSe > 0 then
          raise Exception.Create(
            'NFSe não está "Autorizada" e possui valores de retenção. ' + sLineBreak +
            'Por favor acesse o módulo da NFSe e resolva a situação antes de continuar'
          )
        else if Container.GetInstance().ErpFeaturesFactory.CreateChecarPossivelRetencaoNFSeUseCase()
          .Executar(pNumOs)
        then
          raise Exception.Create(
            'NFSe não está "Autorizada" e provavelmente há retenções de tributos. ' + sLineBreak +
            'Por favor acesse o módulo da NFSe e resolva a situação antes de continuar'
          );
      end;

      vretiss    := vretiss    + queryCons.fcurr('vretiss', -2);
      vretir     := vretir     + queryCons.fcurr('vretirrf', -2);
      vretcsll   := vretcsll   + queryCons.fcurr('vretcsll', -2);
      vretpis    := vretpis    + queryCons.fcurr('vretpis', -2);
      vretcofins := vretcofins + queryCons.fcurr('vretcofins', -2);
      vretcp     := vretcp     + queryCons.fcurr('vretcp', -2);


      

      {retNFSeOS := Container.GetInstance().ErpFeaturesFactory.CreateObterRetencoesNFSeDaOSUseCase().Executar(pNumOs);

      VTotRetNFSe := retNFSeOS.VRetIRRF
        + retNFSeOS.VRetCSLL
        + retNFSeOS.VRetPIS
        + retNFSeOS.VRetCOFINS
        + retNFSeOS.VRetISS
        + retNFSeOS.VRetCP;

      vretir     := vretir     + retNFSeOS.VRetIRRF;
      vretcsll   := vretcsll   + retNFSeOS.VRetCSLL;
      vretpis    := vretpis    + retNFSeOS.VRetPIS;
      vretcofins := vretcofins + retNFSeOS.VRetCOFINS;
      vretiss    := vretiss    + retNFSeOS.VRetISS;
      vretcp     := vretcp     + retNFSeOS.VRetCP;
      }
      if (VTotRetNFSe + VTotRetNFe) <= 0 then
        Exit;

      conf := TCfg_sis.getConf('nf_s_retencoes_federais', buscas, vDadosIni.cod_empresa);

      if not conf.AsBoolean and (vretiss <= 0) then
        Exit;

      // Boleto impresso
      queryCons.Open(' select n_seq_bol, cod_cobrebem, nosso_numero_banco, remessa_enviada from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ').First();
      while not queryCons.Eof do
      begin
        if not queryCons.fempty('NOSSO_NUMERO_BANCO')
          or (queryCons.fint('COD_COBREBEM') > 0)
          or queryCons.fequals('REMESSA_ENVIADA', 'S') then
          Exit;

        queryCons.Next;
      end;

      // Formas de pagamento
      queryCons.Open(
        ' select' +
        '   seqform, cod_empresa, prcss, permitir_excluir, ndoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa).First;
      while not queryCons.Eof do
      begin
        ndoc := IfThen(ndoc <> '', ndoc, queryCons.fstr('ndoc'));

    		// Forma de pagamento processada
        if queryCons.fequals('PRCSS', 'S')
          or queryCons.fequals('permitir_excluir', 'I')
      		or queryCons.fequals('permitir_excluir', 'R') then
      		exit;

        queryCons.Next;
      end;

      {$REGION 'Update FormaPagamento e Boletos'}

      queryCons.SQL(
        'select fp.seqform, fp.valordoc, b.n_seq_bol, b.vl_doc_bol ' +
        'from formpagamento fp ' +
        'left join boletas b on b.seqform = fp.seqform and b.cod_empresa = fp.cod_empresa ' +
        'where fp.nrequisicao = %d and fp.tpdocs = ''%s'' and fp.cod_empresa = %d ' +
        'order by fp.seqform',
        [pNumOs, pTipo, vDadosIni.cod_empresa]
      ).Open().Last().First();

      while not queryCons.Eof do
      begin
        case queryCons.RecordCount of
          1: // 1 registro na fp e nos boletos
            begin
              if queryCons.fcurr('valordoc', -2) = VTotOS then
                queryExec.SQL(
                  ' update formpagamento set valordoc = :valordoc ' +
                  ' where seqform = :seqform and cod_empresa = :cod_empresa')
                  .ParamValue('seqform', queryCons.fint('seqform'))
                  .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                  .ParamAsFloat('valordoc', (VTotOS - VTotRetNFSe - VTotRetNFe))
                  .ExecSQL();

              if (queryCons.fint('n_seq_bol') > 0) and (queryCons.fcurr('vl_doc_bol', -2) = VTotOS) then
                queryExec.SQL(
                  'update boletas set vl_doc_bol = :vl_doc_bol ' +
                  'where n_seq_bol = :n_seq_bol and cod_empresa = :cod_empresa')
                  .ParamValue('n_seq_bol', queryCons.fint('n_seq_bol'))
                  .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                  .ParamAsFloat('vl_doc_bol', (VTotOS - VTotRetNFSe - VTotRetNFe))
                  .ExecSQL();
            end;

          2: // 2 registros
            begin
              case queryCons.RecNo of
                1: // Registro 1 para Servico
                  begin
                    if queryCons.fcurr('valordoc', -2) = VTotServicos then
                      queryExec.SQL(
                        ' update formpagamento set valordoc = :valordoc ' +
                        ' where seqform = :seqform and cod_empresa = :cod_empresa')
                        .ParamValue('seqform', queryCons.fint('seqform'))
                        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                        .ParamAsFloat('valordoc', (VTotServicos - VTotRetNFSe))
                        .ExecSQL();

                    if (queryCons.fint('n_seq_bol') > 0) and (queryCons.fcurr('vl_doc_bol', -2) = VTotServicos) then
                      queryExec.SQL(
                        'update boletas set vl_doc_bol = :vl_doc_bol ' +
                        'where n_seq_bol = :n_seq_bol and cod_empresa = :cod_empresa')
                        .ParamValue('n_seq_bol', queryCons.fint('n_seq_bol'))
                        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                        .ParamAsFloat('vl_doc_bol', (VTotServicos - VTotRetNFSe))
                        .ExecSQL();
                  end;

                2: // Registro 2 para Produto
                  begin     
                    if queryCons.fcurr('valordoc', -2) = VTotProdutos then
                      queryExec.SQL(
                        ' update formpagamento set valordoc = :valordoc ' +
                        ' where seqform = :seqform and cod_empresa = :cod_empresa')
                        .ParamValue('seqform', queryCons.fint('seqform'))
                        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                        .ParamAsFloat('valordoc', (VTotProdutos - VTotRetNFe))
                        .ExecSQL();

                    if (queryCons.fint('n_seq_bol') > 0) and (queryCons.fcurr('vl_doc_bol', -2) = VTotProdutos) then
                      queryExec.SQL(
                        'update boletas set vl_doc_bol = :vl_doc_bol ' +
                        'where n_seq_bol = :n_seq_bol and cod_empresa = :cod_empresa')
                        .ParamValue('n_seq_bol', queryCons.fint('n_seq_bol'))
                        .ParamValue('cod_empresa', vDadosIni.cod_empresa)
                        .ParamAsFloat('vl_doc_bol', (VTotProdutos - VTotRetNFe))
                        .ExecSQL();
                  end;
              end;
            end;
        end;

        queryCons.Next();
      end;

      {$ENDREGION}

      controles.Add(IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_IRRF', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_CSLL', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_PIS', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_COFINS', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_CP', 0)));

      if ContainsText(ndoc, '-') then
        ndoc := Copy(ndoc, 1, Pos('-', ndoc) -1);

      for I := 0 to controles.Count - 1 do
      begin
        if controles[I] <> '0' then
        begin
          Valor := IfThen(conf.ReadString('Controles', 'Retencao_IRRF'  , '0') = controles[I], vretir) +
                   IfThen(conf.ReadString('Controles', 'Retencao_CSLL'  , '0') = controles[I], vretcsll) +
                   IfThen(conf.ReadString('Controles', 'Retencao_PIS'   , '0') = controles[I], vretpis) +
                   IfThen(conf.ReadString('Controles', 'Retencao_COFINS', '0') = controles[I], vretcofins) +
                   IfThen(conf.ReadString('Controles', 'Retencao_CP'    , '0') = controles[I], vretcp) +
                   IfThen(IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe)        = controles[I], vretiss);

          if Valor > 0 then
          begin
            txtRet := '';
            if (conf.ReadString('Controles', 'Retencao_IRRF', '0') = controles[I]) then
              txtRet := IfThen(vretir > 0, 'IR');

            if (conf.ReadString('Controles', 'Retencao_CSLL', '0') = controles[I]) and (vretcsll > 0) then
              txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'CSLL';

            if (conf.ReadString('Controles', 'Retencao_PIS', '0') = controles[I]) and (vretpis > 0) then
              txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'PIS';

            if (conf.ReadString('Controles', 'Retencao_COFINS', '0') = controles[I]) and (vretcofins > 0) then
              txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'COFINS';

            if (conf.ReadString('Controles', 'Retencao_CP', '0') = controles[I]) and (vretcp > 0) then
              txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'CP';

            if (IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe) = controles[I]) and (vretiss > 0) then
              txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'ISS';

            queryCons.SQL(
              'select first 1 ' +
              '( SELECT COD FROM INCREMENTA_CODIGO(:COD_EMPRESA, ''FORMPAGAMENTO'')) seqform, ' +
              'c.docs ' +
              'from rdb$database ' +
              'left join controles c on c.codigo_ctrl = :CODIGO_CTRL and c.codigo_emp = :COD_EMPRESA ')
              .ParamValue('COD_EMPRESA', vDadosIni.cod_empresa)
              .ParamValue('CODIGO_CTRL', StrToInt(controles[I]))
              .Open();

            seqForm := queryCons.fint('seqform'); //Self.Gencodigo('FORMPAGAMENTO', buscas, vDadosIni.codEmpresa);
            docsctrl := queryCons.fstr('docs');

            queryExec.SQL(
              'execute block ' +
              'as ' +
              'begin ' +
              '  execute statement ''INSERT INTO FORMPAGAMENTO ('' ' +
              '    || ''SEQFORM,'' ' +
              '    || (select LIST(NAME) from spdb_fields_all(''FORMPAGAMENTO'') t where t.name not in (''SEQFORM'')) ' +
              '    || '') SELECT FIRST 1 %d, '' ' +
              '    || (select LIST(NAME) from spdb_fields_all(''FORMPAGAMENTO'') t where t.name not in (''SEQFORM'')) ' +
              '    || '' FROM FORMPAGAMENTO WHERE NREQUISICAO = %d AND TPDOCS = ''''%s'''' AND COD_EMPRESA = %d ORDER BY SEQFORM''; ' +
              'end ',
              [ seqForm, pNumOs, pTipo, vDadosIni.cod_empresa]
            ).ExecSQL();

            queryExec.SQL(
              'update formpagamento set ' +
              '  TIP_CNT = ''C'' ' +
              '  , PERMITIR_EXCLUIR = ''I'' ' +
              '  , COD_CONTROLE = :COD_CONTROLE ' +
              '  , TIPDOC = :TIPDOC ' +
              '  , HISTORICO = :HISTORICO ' +
              '  , VALORDOC = :VALORDOC ' +
              '  , VALOR_CONTABIL = :VALOR_CONTABIL ' +
              '  , NDOC = :NDOC ' +
              'where seqform = :seqform and cod_empresa = :cod_empresa')
              .ParamValue('seqform', seqForm)
              .ParamValue('cod_empresa', vDadosIni.cod_empresa)
              .ParamValue('COD_CONTROLE', StrToInt(controles[I]))
              .ParamValue('TIPDOC', docsctrl)
              .ParamValue('HISTORICO', Copy('RETENCAO DOC FISCAL ' + txtRet, 1, 80))
              .ParamAsCurrency('VALORDOC', Valor)
              .ParamAsCurrency('VALOR_CONTABIL', Valor)
              .ParamValue('NDOC', ndoc)
              .ExecSQL();
          end;
        end;
      end;

    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
    controles.Free();
    conf.Free();
    queryExec.Free();
    qExec.Free();
  end;
end;

function TEnviarContratosClientes.verificaRetencaoTributosFederais(
  pProdServ: string; pNumOs: Integer; pTipo: string; pCodCliente: Integer): boolean;
var
  vValorTotFp, vValorTotProd, vValorTotServ, vValorTotBol: Double;
  vValorNFSe, vValorIssRetidoNFSe: Double;
  vValorNFe, vValorIssRetidoNFe: Double;
  totRet, retAtual, vretir, vretcsll, vretpis, vretcofins: Double;
  vCodControle: Integer;
  vCodControles: string;
  controles: TStrings;
	conf: TConfig_sistema_class;
  I: Integer;
begin
  Result := True;
  {
	try
    try
      Result := True;

      SqlOpen(' select notafiscal.cod_nf, notafiscal.cod_empresa, ' +
      	' pedvenda.num_nfeext, pedvenda.num_nf, ' +
        ' coalesce(notafiscal.valor_total, 0) valor_nf, ' +
        ' notafiscal.valor_irrf, notafiscal.vretcsll, notafiscal.vretpis, notafiscal.vretcofins, ' +
        ' coalesce((select sum(coalesce(formpagamento.valordoc, 0)) from formpagamento ' +
        '           where formpagamento.nrequisicao = pedvenda.nped ' +
        '           and formpagamento.tpdocs = pedvenda.tipo ' +
        '           and formpagamento.cod_empresa = pedvenda.cod_empresa), 0) valor_tot_fp, ' +
        ' coalesce((select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedvenda_prod ' +
        '           where pedvenda_prod.nped = pedvenda.nped ' +
        '           and pedvenda_prod.tipo = pedvenda.tipo ' +
        '           and pedvenda_prod.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_prod.status <> ''CANCELADO'' or pedvenda_prod.status is null)), 0) valor_tot_prod, ' +
        ' coalesce((select sum(coalesce(pedvenda_serv.valor_tot_serv, 0)) from pedvenda_serv ' +
        '           where pedvenda_serv.nped = pedvenda.nped ' +
        '           and pedvenda_serv.tipo = pedvenda.tipo ' +
        '           and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null)), 0) valor_tot_serv, ' +
        ' coalesce((select sum(coalesce(boletas.vl_doc_bol, 0)) from boletas ' +
        '						where num_nf_vnd = pedvenda.nped ' +
        ' 					and tipo_emissao = pedvenda.tipo ' +
        ' 					and cod_empresa = pedvenda.cod_empresa ' +
        ' 					and ativo = 1), 0) valor_tot_bol, ' +
        ' coalesce((select sum(coalesce(pedvenda_serv.valor_nfse, 0)) from pedvenda_serv ' +
        '           where pedvenda_serv.nped = pedvenda.nped ' +
        '           and pedvenda_serv.tipo = pedvenda.tipo ' +
        '           and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null)), 0) valor_nfse, ' +
      	' coalesce((select sum(coalesce(pedvenda_serv.issret_servico, 0)) from pedvenda_serv ' +
        '           where pedvenda_serv.nped = pedvenda.nped ' +
        '           and pedvenda_serv.tipo = pedvenda.tipo ' +
        '           and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null)), 0) issret_servico ' +
        ' from pedvenda ' +
        ' left join notafiscal on ' +
        '     notafiscal.nped = pedvenda.nped ' +
        '     and notafiscal.tipo_ped = pedvenda.tipo ' +
        '     and notafiscal.cod_empresa = pedvenda.cod_empresa ' +
        ' where pedvenda.nped = ' + IntToStr(pNumOs) +
        ' and pedvenda.tipo =  ' + QuotedStr(pTipo) +
        ' and pedvenda.cod_empresa = '+ vDadosIni.codEmpresa +
        ' and pedvenda.status_ped = ''FECHADA'' ', buscas);

      if pProdServ = 'S' then
      begin
      	if buscas.FieldByName('issret_servico').AsFloat <= 0 then
          Exit;
      end
      else
      begin
        if vDadosIni.StrToFloatFormat(
        		buscas.FieldByName('valor_irrf').AsFloat +
        		buscas.FieldByName('vretcsll').AsFloat +
            buscas.FieldByName('vretpis').AsFloat +
            buscas.FieldByName('vretcofins').AsFloat, 2) <= 0 then
          Exit;
      end;

      vValorTotFp         := buscas.FieldByName('valor_tot_fp').AsFloat;
      vValorTotProd       := buscas.FieldByName('valor_tot_prod').AsFloat;
      vValorTotServ       := buscas.FieldByName('valor_tot_serv').AsFloat;
      vValorTotBol        := buscas.FieldByName('valor_tot_bol').AsFloat;
      vValorNFSe          := buscas.FieldByName('valor_nfse').AsFloat;
      vValorNFe           := buscas.FieldByName('valor_nf').AsFloat;

      vretir     				  := buscas.FieldByName('valor_irrf').AsFloat;
      vretcsll            := buscas.FieldByName('vretcsll').AsFloat;
      vretpis             := buscas.FieldByName('vretpis').AsFloat;
      vretcofins          := buscas.FieldByName('vretcofins').AsFloat;

    	vValorIssRetidoNFSe := buscas.FieldByName('issret_servico').AsFloat;
      vValorIssRetidoNFe  := (vretir) + (vretcsll) + (vretpis) + (vretcsll);

      if (pProdServ = 'S') and (vValorIssRetidoNFSe <= 0) then
        Exit
      else if (pProdServ = 'P') and (vValorIssRetidoNFe <= 0) then           
      	Exit;

      // Boleto impresso
      SqlOpen(' select n_seq_bol, cod_cobrebem, nosso_numero_banco, remessa_enviada from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas).FetchAll;
      buscas.First;
      while not buscas.Eof do
      begin
        if trim(buscas.FieldByName('NOSSO_NUMERO_BANCO').AsString) <> '' then
          exit
        else if buscas.FieldByName('COD_COBREBEM').AsInteger > 0 then
          exit
        else if trim(buscas.FieldByName('REMESSA_ENVIADA').AsString) = 'S' then
          exit;

        buscas.Next;
      end;


      controles := NewStringList(True);

      if pProdServ = 'P' then
      begin
      	conf := TCfg_sis.getConf('nf_s_retencoes_federais', buscas, vDadosIni.cod_empresa);

        if not conf.AsBoolean then
          Exit;

        controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_IRRF', 0)));
        controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_CSLL', 0)));
        controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_PIS', 0)));
        controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_COFINS', 0)));
      end
      else
      	controles.Add(IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe));

      SqlOpen(' select seqform, ' +
        ' cod_empresa, ' +
        ' coalesce(prcss, ''N'') prcss, ' +
        ' permitir_excluir, ' +
        ' coalesce(valordoc, 0) valordoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas).FetchAll;

      buscas.First;
      while not buscas.Eof do
      begin
    		// Forma de pagamento processada
        if trim(buscas.FieldByName('PRCSS').AsString) = 'S' then
          exit
        else if (pProdServ = 'P') and (trim(buscas.FieldByName('permitir_excluir').AsString) = 'I') then
      		exit
        else if (pProdServ = 'S') and (trim(buscas.FieldByName('permitir_excluir').AsString) = 'R') then
      		exit;

        buscas.Next;
      end;

      if pProdServ = 'P' then
      begin
        if not corrigirFpIssRetidoNFe(
          pNumOs,
          pTipo,
          vValorTotServ,
          vValorTotProd,
          vValorTotBol,
          vValorIssRetidoNFSe,
          vretir,
          vRetcsll,
          vRetpis,
          vRetcofins) then
        begin
          Result := False;
          exit;
        end;
      end
      else
      begin
        if not corrigirFpIssRetidoNFSe(
          pNumOs,
          pTipo,
          vValorTotServ,
          vValorTotProd,
          vValorTotBol,
          vValorIssRetidoNFSe,
          vretir,
          vRetcsll,
          vRetpis,
          vRetcofins) then
        begin
          Result := False;
          exit;
        end;
      end;

    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
    if Assigned(controles) then
      FreeAndNil(controles);
    if Assigned(conf) then
      FreeAndNil(conf);
  end;
  }
end;

function TEnviarContratosClientes.corrigirFpIssRetidoNFe(
	pNumOs: Integer;
  pTipo: string;
  pValorTotServ: Double;
  pValorTotProd: Double;
  pValorTotBol: Double;
  pValorIssRetidoNFSe: Double;
  pValor_irrf: Double;
  pRetcsll: Double;
  pRetpis: Double;
  pRetcofins: Double): boolean;
var
	buscas2, buscasCampos, buscasExec: TIBQuery;

  vValorIssRetidoNFe: Double;

  totRet, retAtual, vretir, vretcsll, vretpis, vretcofins: Double;
	txtRet: string;
  controles: TStrings;
	conf: TConfig_sistema_class;
  vCodControle: Integer;
  vDocs: string;
  vTxtRet: string;
  I: Integer;

  vAtualizarFP: Boolean;
  vAtualizarFP_Ret: Boolean;
  vAtualizarBol: Boolean;
begin
  Result := True;
  {
  try
    try
      Result := True;

      vAtualizarFP     := False;
      vAtualizarFP_Ret := False;
      vAtualizarBol    := False;

      vValorIssRetidoNFe := (pValor_irrf) + (pRetcsll) + (pRetpis) + (pRetcofins);

      if vValorIssRetidoNFe <= 0 then
        exit;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      buscasCampos := TIBQuery.Create(Application);
      buscasCampos.Database := buscas.Database;
      buscasCampos.Transaction := buscas.Transaction;

      buscasExec := TIBQuery.Create(Application);
      buscasExec.Database := buscas.Database;
      buscasExec.Transaction := buscas.Transaction;

      SqlOpen(' select rdb$field_name campo from rdb$relation_fields ' +
        ' where rdb$relation_name = ''FORMPAGAMENTO'' ', buscasCampos);

      SqlOpen(' select notafiscal.cod_nf, notafiscal.cod_empresa, ' +
        ' coalesce(notafiscal.valor_total, 0) valor_nf, ' +
        ' notafiscal.valor_irrf, notafiscal.vretcsll, notafiscal.vretpis, notafiscal.vretcofins, ' +
        ' coalesce((select sum(coalesce(formpagamento.valordoc, 0)) from formpagamento ' +
        '           where formpagamento.nrequisicao = pedvenda.nped ' +
        '           and formpagamento.tpdocs = pedvenda.tipo ' +
        '           and formpagamento.cod_empresa = pedvenda.cod_empresa), 0) valor_tot_fp, ' +
        ' coalesce((select sum(coalesce(pedvenda_prod.vltot_ped_item, 0)) from pedvenda_prod ' +
        '           where pedvenda_prod.nped = pedvenda.nped ' +
        '           and pedvenda_prod.tipo = pedvenda.tipo ' +
        '           and pedvenda_prod.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_prod.status <> ''CANCELADO'' or pedvenda_prod.status is null)), 0) valor_tot_prod, ' +
        ' coalesce((select sum(coalesce(pedvenda_serv.valor_tot_serv, 0)) from pedvenda_serv ' +
        '           where pedvenda_serv.nped = pedvenda.nped ' +
        '           and pedvenda_serv.tipo = pedvenda.tipo ' +
        '           and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
        '           and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null)), 0) valor_tot_serv ' +
        ' from pedvenda ' +
        ' inner join notafiscal on ' +
        '     notafiscal.nped = pedvenda.nped ' +
        '     and notafiscal.tipo_ped = pedvenda.tipo ' +
        '     and notafiscal.cod_empresa = pedvenda.cod_empresa ' +
        ' where pedvenda.nped = ' + IntToStr(pNumOs) +
        ' and pedvenda.tipo =  ' + QuotedStr(pTipo) +
        ' and pedvenda.cod_empresa = '+ vDadosIni.codEmpresa, buscas);

      vretir     				  := buscas.FieldByName('valor_irrf').AsFloat;
      vretcsll            := buscas.FieldByName('vretcsll').AsFloat;
      vretpis             := buscas.FieldByName('vretpis').AsFloat;
      vretcofins          := buscas.FieldByName('vretcofins').AsFloat;


      totRet              := (vretir) +
                             (vretcsll) +
                             (vretpis) +
                             (vretcofins);

      if totRet <= 0 then
        Exit;

      controles := NewStringList(True);

      conf := TCfg_sis.getConf('nf_s_retencoes_federais', buscas, vDadosIni.cod_empresa);

      if not conf.AsBoolean then
        Exit;

      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_IRRF', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_CSLL', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_PIS', 0)));
      controles.Add(IntToStr(conf.ReadInteger('Controles', 'Retencao_COFINS', 0)));

      SqlOpen(' select n_seq_bol, cod_empresa, ' +
        ' coalesce(vl_doc_bol, 0) vl_doc_bol from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        if (vDadosIni.StrToFloatFormat(pValorTotServ, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
        	or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2)) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' update boletas set vl_doc_bol = (vl_doc_bol - :issret_servico) ' +
            ' where n_seq_bol = ' + IntToStr(buscas2.FieldByName('n_seq_bol').AsInteger) +
            ' and cod_empresa = ' + IntToStr(buscas2.FieldByName('cod_empresa').AsInteger);
          buscas.ParamByName('issret_servico').AsFloat := vDadosIni.StrToFloatFormat(vValorIssRetidoNFe, 2);
          buscas.ExecSQL;

          vAtualizarBol   := True;
        end;

        buscas2.Next;
      end;

      SqlOpen(' select seqform, ' +
        ' cod_empresa, ' +
        ' cod_controle, ' +
        ' coalesce(prcss, ''N'') prcss, ' +
        ' coalesce(valordoc, 0) valordoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
      	if (vDadosIni.StrToFloatFormat(pValorTotServ, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
        	or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))then
        begin
          buscas.Close;
          buscas.SQL.Text := ' update formpagamento set valordoc = (valordoc - :issret_servico) ' +
            ' where seqform = ' + IntToStr(buscas2.FieldByName('seqform').AsInteger) +
            ' and cod_empresa = ' + IntToStr(buscas2.FieldByName('cod_empresa').AsInteger);
          buscas.ParamByName('issret_servico').AsFloat := vDadosIni.StrToFloatFormat(vValorIssRetidoNFe, 2);
          buscas.ExecSQL;

          vAtualizarFP   := True;
        end;


        buscas2.Next;
      end;

      for I := 0 to controles.Count - 1 do
        if controles[I] <> '0' then
        begin
        	SqlOpen(' select codigo_ctrl, codigo_emp, nome_ctrl, docs from controles ' +
            ' where codigo_ctrl = ' + controles[I] +
            ' and codigo_emp = ' + vDadosIni.codEmpresa +
            ' and ativo <> 99 ', buscas);

          vCodControle := StrToInt(trim(controles[I]));
          vDocs        := trim(buscas.FieldByName('docs').AsString);

          retAtual := IfThen(conf.ReadString('Controles', 'Retencao_IRRF'  , '0') = controles[I], pValor_irrf) +
                  IfThen(conf.ReadString('Controles', 'Retencao_CSLL'  , '0') = controles[I], pRetcsll) +
                  IfThen(conf.ReadString('Controles', 'Retencao_PIS'   , '0') = controles[I], pRetpis) +
                  IfThen(conf.ReadString('Controles', 'Retencao_COFINS', '0') = controles[I], pRetcofins);

          txtRet := '';
          if (conf.ReadString('Controles', 'Retencao_IRRF', '0') = controles[I]) then
            txtRet := IfThen(vretir > 0, 'IR');

          if (conf.ReadString('Controles', 'Retencao_CSLL', '0') = controles[I]) and (vretcsll > 0) then
            txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'CSLL';

          if (conf.ReadString('Controles', 'Retencao_PIS', '0') = controles[I]) and (vretpis > 0) then
            txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'PIS';

          if (conf.ReadString('Controles', 'Retencao_COFINS', '0') = controles[I]) and (vretcofins > 0) then
            txtRet := txtRet + IfThen(txtRet <> '', ', ') + 'COFINS';

          SqlOpen(' select first 1 * from formpagamento ' +
            ' where nrequisicao = ' + IntToStr(pNumOs) +
            ' and tpdocs = ' + QuotedStr(pTipo) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and cod_controle <> ' + controles[I], buscas).FetchAll;

          buscas.First;
          while not buscas.Eof do
          begin
            buscasExec.Close;
            buscasExec.SQL.Text := 'INSERT INTO FORMPAGAMENTO (';

            buscasCampos.First;
            while not buscasCampos.Eof do
            begin
              if buscasCampos.RecNo = 1 then
                buscasExec.SQL.Text := buscasExec.SQL.Text + trim(buscasCampos.FieldByName('CAMPO').AsString)
              else
                buscasExec.SQL.Text := buscasExec.SQL.Text + ', ' + trim(buscasCampos.FieldByName('CAMPO').AsString);

              buscasCampos.Next;
            end;

            buscasExec.SQL.Text := buscasExec.SQL.Text + ') VALUES (';

            buscasCampos.First;
            while not buscasCampos.Eof do
            begin
              if buscasCampos.RecNo = 1 then
                buscasExec.SQL.Text := buscasExec.SQL.Text + ':' + trim(buscasCampos.FieldByName('CAMPO').AsString)
              else
                buscasExec.SQL.Text := buscasExec.SQL.Text + ', ' + ':' + trim(buscasCampos.FieldByName('CAMPO').AsString);

              buscasCampos.Next;
            end;

            buscasExec.SQL.Text := buscasExec.SQL.Text + ');';

            buscasCampos.First;
            while not buscasCampos.Eof do
            begin
              if buscas.FindField(trim(buscasCampos.FieldByName('CAMPO').AsString)) <> nil then
                buscasExec.ParamByName(trim(buscasCampos.FieldByName('CAMPO').AsString)).Value :=
                  buscas.FieldByName(trim(buscasCampos.FieldByName('CAMPO').AsString)).Value;

              buscasCampos.Next;
            end;

            buscasExec.ParamByName('SEQFORM').AsInteger := Gencodigo('FORMPAGAMENTO', buscas2, vDadosIni.codEmpresa);
            buscasExec.ParamByName('COD_CONTROLE').AsInteger := vCodControle;
            buscasExec.ParamByName('TIPDOC').AsString := vDocs;
            buscasExec.ParamByName('HISTORICO').AsString := 'RETENCAO TRIBUTOS FEDERAIS ' + vTxtRet;
            buscasExec.ParamByName('TIP_CNT').AsString := 'C';
            buscasExec.ParamByName('VALORDOC').AsFloat := retAtual;
            buscasExec.ParamByName('VALOR_CONTABIL').AsFloat := retAtual;
            buscasExec.ParamByName('PERMITIR_EXCLUIR').AsString := 'I';

            if ContainsText(buscasExec.ParamByName('NDOC').AsString, '-') then
            	buscasExec.ParamByName('NDOC').AsString :=
              	Copy(trim(buscasExec.ParamByName('NDOC').AsString), 1, Length(trim(buscasExec.ParamByName('NDOC').AsString)) - 2);

            buscasExec.ExecSQL;

            vAtualizarFP_Ret := True;

            buscas.Next;
          end;

          if (vAtualizarFP) and (vAtualizarFP_Ret) and ((pValorTotBol > 0) and (vAtualizarBol)) then
          	CommitaTransacao
          else if (vAtualizarFP) and (vAtualizarFP_Ret) and (pValorTotBol <= 0) then
          	CommitaTransacao
          else
          	RollBackTransacao;
        end;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
  	if Assigned(buscas2) then
      FreeAndNil(buscas2);
    if Assigned(buscasCampos) then
      FreeAndNil(buscasCampos);
    if Assigned(buscasExec) then
      FreeAndNil(buscasExec);
    if Assigned(controles) then
      FreeAndNil(controles);
    if Assigned(conf) then
      FreeAndNil(conf);
  end;
  }
end;

function TEnviarContratosClientes.corrigirFpIssRetidoNFSe(
  pNumOs: Integer;
  pTipo: string;
  pValorTotServ: Double;
  pValorTotProd: Double;
  pValorTotBol: Double;
  pValorIssRetidoNFSe: Double;
  pValor_irrf: Double;
  pRetcsll: Double;
  pRetpis: Double;
  pRetcofins: Double): boolean;
var
	buscas2, buscasCampos, buscasExec: TIBQuery;
  vValorIssRetidoNFe: Double;
  vCodControle: Integer;
  vDocs: string;

  vAtualizarFP: Boolean;
  vAtualizarFP_Ret: Boolean;
  vAtualizarBol: Boolean;
begin
  Result := True;
  {
	try
    try
      Result := True;

      vAtualizarFP     := False;
      vAtualizarFP_Ret := False;
      vAtualizarBol    := False;

      if pValorIssRetidoNFSe <= 0 then
        exit;

      vValorIssRetidoNFe := (pValor_irrf) + (pRetcsll) + (pRetpis) + (pRetcofins);

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := buscas.Database;
      buscas2.Transaction := buscas.Transaction;

      buscasCampos := TIBQuery.Create(Application);
      buscasCampos.Database := buscas.Database;
      buscasCampos.Transaction := buscas.Transaction;

      buscasExec := TIBQuery.Create(Application);
      buscasExec.Database := buscas.Database;
      buscasExec.Transaction := buscas.Transaction;

      SqlOpen(' select rdb$field_name campo from rdb$relation_fields ' +
        ' where rdb$relation_name = ''FORMPAGAMENTO'' ', buscasCampos);

      SqlOpen(' select n_seq_bol, cod_empresa, ' +
        ' coalesce(vl_doc_bol, 0) vl_doc_bol from boletas ' +
        ' where num_nf_vnd = ' + IntToStr(pNumOs) +
        ' and tipo_emissao = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and ativo = 1 ', buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        if (vDadosIni.StrToFloatFormat(pValorTotServ, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
        	or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('vl_doc_bol').AsFloat, 2)) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' update boletas set vl_doc_bol = (vl_doc_bol - :issret_servico) ' +
            ' where n_seq_bol = ' + IntToStr(buscas2.FieldByName('n_seq_bol').AsInteger) +
            ' and cod_empresa = ' + IntToStr(buscas2.FieldByName('cod_empresa').AsInteger);
          buscas.ParamByName('issret_servico').AsFloat := vDadosIni.StrToFloatFormat(pValorIssRetidoNFSe, 2);
          buscas.ExecSQL;

          vAtualizarBol   := True;
        end;

        buscas2.Next;
      end;

      SqlOpen(' select seqform, ' +
        ' cod_empresa, ' +
        ' cod_controle, ' +
        ' coalesce(prcss, ''N'') prcss, ' +
        ' coalesce(valordoc, 0) valordoc from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa, buscas2).FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
      	if (vDadosIni.StrToFloatFormat(pValorTotServ, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
        	or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2))
          or (vDadosIni.StrToFloatFormat(pValorTotServ +
          																pValorTotProd +
                                          pValorIssRetidoNFSe +
                                          vValorIssRetidoNFe, 2) = vDadosIni.StrToFloatFormat(buscas2.FieldByName('valordoc').AsFloat, 2)) then
        begin
          buscas.Close;
          buscas.SQL.Text := ' update formpagamento set valordoc = (valordoc - :issret_servico) ' +
            ' where seqform = ' + IntToStr(buscas2.FieldByName('seqform').AsInteger) +
            ' and cod_empresa = ' + IntToStr(buscas2.FieldByName('cod_empresa').AsInteger);
          buscas.ParamByName('issret_servico').AsFloat := vDadosIni.StrToFloatFormat(pValorIssRetidoNFSe, 2);
          buscas.ExecSQL;

          vAtualizarFP   := True;
        end;

        buscas2.Next;
      end;

      SqlOpen(' select codigo_ctrl, codigo_emp, nome_ctrl, docs from controles ' +
        ' where codigo_ctrl = ' + IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe) +
        ' and codigo_emp = ' + vDadosIni.codEmpresa +
        ' and ativo <> 99 ', buscas);

      vCodControle := buscas.FieldByName('CODIGO_CTRL').AsInteger;
      vDocs        := buscas.FieldByName('DOCS').AsString;

      SqlOpen(' select first 1 * from formpagamento ' +
        ' where nrequisicao = ' + IntToStr(pNumOs) +
        ' and tpdocs = ' + QuotedStr(pTipo) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cod_controle <> ' + IntToStr(vDadosIni.vPedVnd.ctrlIssRetidoNFSe), buscas).FetchAll;

      buscas.First;
      while not buscas.Eof do
      begin
        buscasExec.Close;
        buscasExec.SQL.Text := 'INSERT INTO FORMPAGAMENTO (';

        buscasCampos.First;
        while not buscasCampos.Eof do
        begin
          if buscasCampos.RecNo = 1 then
            buscasExec.SQL.Text := buscasExec.SQL.Text + trim(buscasCampos.FieldByName('CAMPO').AsString)
          else
            buscasExec.SQL.Text := buscasExec.SQL.Text + ', ' + trim(buscasCampos.FieldByName('CAMPO').AsString);

          buscasCampos.Next;
        end;

        buscasExec.SQL.Text := buscasExec.SQL.Text + ') VALUES (';

        buscasCampos.First;
        while not buscasCampos.Eof do
        begin
          if buscasCampos.RecNo = 1 then
            buscasExec.SQL.Text := buscasExec.SQL.Text + ':' + trim(buscasCampos.FieldByName('CAMPO').AsString)
          else
            buscasExec.SQL.Text := buscasExec.SQL.Text + ', ' + ':' + trim(buscasCampos.FieldByName('CAMPO').AsString);

          buscasCampos.Next;
        end;

        buscasExec.SQL.Text := buscasExec.SQL.Text + ');';

        buscasCampos.First;
        while not buscasCampos.Eof do
        begin
          if buscas.FindField(trim(buscasCampos.FieldByName('CAMPO').AsString)) <> nil then
            buscasExec.ParamByName(trim(buscasCampos.FieldByName('CAMPO').AsString)).Value :=
              buscas.FieldByName(trim(buscasCampos.FieldByName('CAMPO').AsString)).Value;

          buscasCampos.Next;
        end;

        buscasExec.ParamByName('SEQFORM').AsInteger := Gencodigo('FORMPAGAMENTO', buscas2, vDadosIni.codEmpresa);
        buscasExec.ParamByName('COD_CONTROLE').AsInteger := vCodControle;
        buscasExec.ParamByName('TIPDOC').AsString := vDocs;
        buscasExec.ParamByName('HISTORICO').AsString := 'VALOR DO ISS RETIDO DA NFSe DE SERVICOS';
        buscasExec.ParamByName('TIP_CNT').AsString := 'C';
        buscasExec.ParamByName('VALORDOC').AsFloat := vDadosIni.StrToFloatFormat(pValorIssRetidoNFSe, 2);
        buscasExec.ParamByName('VALOR_CONTABIL').AsFloat := vDadosIni.StrToFloatFormat(pValorIssRetidoNFSe, 2);
        buscasExec.ParamByName('PERMITIR_EXCLUIR').AsString := 'R';

        if ContainsText(buscasExec.ParamByName('NDOC').AsString, '-') then
            	buscasExec.ParamByName('NDOC').AsString :=
              	Copy(buscasExec.ParamByName('NDOC').AsString, 1, Length(trim(buscasExec.ParamByName('NDOC').AsString)) - 2);

        buscasExec.ExecSQL;

        vAtualizarFP_Ret := True;

        buscas.Next;
      end;

      if (vAtualizarFP) and (vAtualizarFP_Ret) and ((pValorTotBol > 0) and (vAtualizarBol)) then
        CommitaTransacao
      else if (vAtualizarFP) and (vAtualizarFP_Ret) and (pValorTotBol <= 0) then
        CommitaTransacao
      else
      	RollBackTransacao;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
    if Assigned(buscas2) then
    	FreeAndNil(buscas2);
    if Assigned(buscasCampos) then
      FreeAndNil(buscasCampos);
    if Assigned(buscasExec) then
    	FreeAndNil(buscasExec);
  end;
  }
end;

constructor TEnviarContratosClientes.create;
begin
  DataSet := TClientDataSet(DtmClientes.cdsEnviarContratosClientes);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);

  try
    fTempBolContratos := TClientDataSet.Create(nil);
    fTempBolContratos.Close;
    fTempBolContratos.FieldDefs.Clear;
    fTempBolContratos.FieldDefs.Add('NPED', ftInteger, 0, false);
    fTempBolContratos.FieldDefs.Add('TIPO', ftString, 3, false);
    fTempBolContratos.FieldDefs.Add('N_SEQ_BOL', ftInteger, 0, false);
  except
  end;

  if fTempBolContratos.Tag = 0 then
  try
    fTempBolContratos.CreateDataSet;
    fTempBolContratos.Tag := 22;
  except
  end;
end;

function TEnviarContratosClientes.enviarImprimir(
  pNumOS: Integer; pTipo: string;
  pImprimir: boolean; pEnviar: boolean; pGerarZip: boolean;
  pValorTotal: Double; pValorProd: Double; pValorServ: Double; pValorBol: Double;
  pCodCliente: Integer; pCodCobrebem: Integer;
  pListaBol: TStringList;
  pArrayOrigem: arrayorigem;
  pArrayaplicativo: arrayaplicativo;
  pStringListAnexosRecLoc: TStringList;
  pStringListAnexosNFS: TStringList;
  pStringListAnexosNF: TStringList;
  pStringListAnexosBol: TStringList;
  pImprimirArrayorigem: arrayorigem;
  pEnviarArrayorigem: arrayorigem;
  pGerarZipArrayOrigem: arrayorigem;
  pIncReg: Integer; pTotReg: Integer;
  pHint: string;
  pHandleDllNF: THandle; 
  var pImprimiu: Boolean; var pEnviou: Boolean; var pGerouZip: Boolean): Boolean;
type
  TArrayString = array of string;
var
  I, J, K, Z: Integer;
  parametros: TStrings;
  fone: string;
  vCodNF: Integer;
  AstrWide: WideString;
  vImprimirBol: Boolean;
  vStringListAnexos: TStringList;
  vGerarBoleto: Boolean;
  vDataHoraBanco: TDateTime;
  vQtdPdf: Integer;
  vDiretorioDest: WideString;
  anexosNFS: TArrayString;
  vArquivos: array of WideString;
  vAplicativo: TAplicativoEnv;
  vAssunto, vMensagem: string;
  vStringListContatoAplicativo: TStringList;
  vExisteArrayorigem: arrayorigem;
  vGerouNF: Boolean;
  vArrayContato: arraycontato;
  vGerouArrayOrigem: arrayorigem;
begin
  try
  	 Result := True;

    vGerouArrayOrigem := [];

    pImprimiu := False;
    pEnviou   := False;
    pGerouZip := False;

    vCodNF          := 0;

    vExisteArrayorigem := [];

    vGerarBoleto    := False;

    vStringListAnexos := TStringList.Create;
    vStringListAnexos.Duplicates := dupIgnore;
    vStringListAnexos.Clear;

    if (pValorServ > 0) and ((cReciboLoc in pImprimirArrayorigem) or (cReciboLoc in pEnviarArrayorigem) or (cReciboLoc in pGerarZipArrayOrigem)) then
    	vExisteArrayorigem := vExisteArrayorigem + [cReciboLoc];

    if (pValorServ > 0) and ((cNfse in pImprimirArrayorigem) or (cNfse in pEnviarArrayorigem) or (cReciboLoc in pGerarZipArrayOrigem)) then
    begin
      SqlOpen(' select pedvenda_serv.nped, pedvenda_serv.tipo, pedvenda_serv.cod_empresa, ' +
      		  ' pedvenda_serv.cod_rps, pedvenda_serv.n_nf from pedvenda ' +
      		  ' inner join pedvenda_serv on ' +
              '		pedvenda_serv.nped = pedvenda.nped ' +
              '		and pedvenda_serv.tipo = pedvenda.tipo ' +
              '		and pedvenda_serv.cod_empresa = pedvenda.cod_empresa ' +
              ' where pedvenda.nped = ' + IntToStr(pNumOS) +
              ' and pedvenda.tipo = ' + QuotedStr(pTipo) +
              ' and pedvenda.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and pedvenda.status_ped = ''FECHADA'' ' +
              ' and (pedvenda_serv.status <> ''CANCELADO'' or pedvenda_serv.status is null) ' +
              ' and pedvenda_serv.n_nf > 0 ');
      if not buscas.IsEmpty then
        vExisteArrayorigem := vExisteArrayorigem + [cNfse];
    end;

    if (pValorProd > 0) and ((cNfe in pImprimirArrayorigem) or (cNfe in pEnviarArrayorigem) or (cNfe in pGerarZipArrayOrigem)) then
    begin
      SqlOpen(' select notafiscal.cod_nf, notafiscal.num_nf, notafiscal.serie, notafiscal.modelo_nf, ' +
      		  ' notafiscal.chave_nfe, notafiscal.situacao_nfe from notafiscal ' +
              ' inner join pedvenda on ' +
              '   pedvenda.nped = notafiscal.nped ' +
              '   and pedvenda.tipo = notafiscal.tipo_ped ' +
              '   and pedvenda.cod_empresa = notafiscal.cod_empresa ' +
              '   and pedvenda.num_nf = notafiscal.num_nf ' +
              '   and pedvenda.serie_nf = notafiscal.serie ' +
              ' where notafiscal.nped = ' + IntToStr(pNumOS) +
              ' and notafiscal.tipo_ped = ' + QuotedStr(pTipo) +
              ' and notafiscal.cod_empresa = ' + vDadosIni.codEmpresa);
    	vCodNF     := buscas.FieldByName('COD_NF').AsInteger;

      if not buscas.IsEmpty then
        vExisteArrayorigem := vExisteArrayorigem + [cNfe];
    end;

    if (pValorBol > 0) and ((cBoleto in pImprimirArrayorigem) or (cBoleto in pEnviarArrayorigem) or (cBoleto in pGerarZipArrayOrigem)) then
    begin
    	SqlOpen(' select boletas.n_seq_bol from boletas ' +
      	     ' where boletas.num_nf_vnd = ' + IntToStr(pNumOS) +
              ' and boletas.tipo_emissao = ' + QuotedStr(pTipo) +
              ' and boletas.cod_empresa = ' + vDadosIni.codEmpresa +
              ' and boletas.ativo = 1 ');
      if not buscas.IsEmpty then
        vExisteArrayorigem := vExisteArrayorigem + [cBoleto];
    end;

    try

    	// Gerar PDF - LOCACAO
      if (cReciboLoc in vExisteArrayorigem) and (pValorServ > 0) and ((cReciboLoc in pImprimirArrayorigem) or (cReciboLoc in pEnviarArrayorigem) or (cReciboLoc in pGerarZipArrayOrigem)) then
      begin
      	try
          vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Preparando Locação)');

          try
            vDadosIni.vDirArqLocacao := '';
            if not vDadosIni.imprimirReciboLocacao(
              buscas,
              pNumOS,
              pTipo,
              pCodCliente,
              'CONTRATO',
              False,
              False,
              False,
              ((cReciboLoc in pImprimirArrayorigem) or (cReciboLoc in pEnviarArrayorigem) or (cReciboLoc in pGerarZipArrayOrigem))) then
                exit;
          finally
            if FileExists(PChar(trim(vDadosIni.vDirArqLocacao))) then
            begin
              vStringListAnexos.Add(trim(vDadosIni.vDirArqLocacao));

              for I := 0 to vStringListAnexos.Count - 1 do
                pStringListAnexosRecLoc.Add(vStringListAnexos[I]);
              
              if trim(vDadosIni.vDirArqLocacao) <> '' then
              	 vGerouArrayOrigem := vGerouArrayOrigem + [cReciboLoc];
            end;

            vDadosIni.vDirArqLocacao := '';
          end;
        finally
          vDadosIni.fechaStatusProcessamento;
        end;
      end;

      // Gerar PDF - NFS
      if (cNfse in vExisteArrayorigem) and (pValorServ > 0) and ((cNfse in pImprimirArrayorigem) or (cNfse in pEnviarArrayorigem) or (cNfse in pGerarZipArrayOrigem)) then
      begin
        try
        	 vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Preparando NFS)');

          anexosNFS := TArrayString(CallerNFSeFeatures.CriarAnexosEmail(pNumOS, True));

          for I := 0 to High(anexosNFS) do
          begin
            if ContainsText(anexosNFS[I], '-nfse') or ContainsText(anexosNFS[I], '.xml') then
              vStringListAnexos.Add(anexosNFS[I])
            else if FileExists(anexosNFS[I]) then
              SysUtils.DeleteFile(anexosNFS[I]);
          end;

          for I := 0 to vStringListAnexos.Count - 1 do
          	pStringListAnexosNFS.Add(vStringListAnexos[I]);

          if Length(anexosNFS) > 0 then
          	vGerouArrayOrigem := vGerouArrayOrigem + [cNfse];
        finally
          vDadosIni.fechaStatusProcessamento;
        end;
      end;

      // Gerar PDF - NF
      if (cNfe in vExisteArrayorigem) and (pValorProd > 0) and ((cNfe in pImprimirArrayorigem) or (cNfe in pEnviarArrayorigem) or (cNfe in pGerarZipArrayOrigem)) then
      begin
      	try
          vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Preparando NF)');

          if not ImprimirNFGerarPDF(
            pHandleDllNF,
            vCodNF,
            False,
            ((cNfe in pImprimirArrayorigem) or (cNfe in pEnviarArrayorigem) or (cNfe in pGerarZipArrayOrigem)),
            vGerouNF,
            vStringListAnexos) then
            Exit;

          for I := 0 to vStringListAnexos.Count - 1 do
          	pStringListAnexosNF.Add(vStringListAnexos[I]);

          if vGerouNF then
          	vGerouArrayOrigem := vGerouArrayOrigem + [cNfe];
        finally
          vDadosIni.fechaStatusProcessamento;
        end;
      end;

      // Gerar Boleto
      vGerarBoleto :=
      	((pValorServ > 0) and (cReciboLoc in vGerouArrayOrigem))
        	 or ((pValorServ > 0) and (cNfse in vGerouArrayOrigem))
          or ((pValorProd > 0) and (cNfe in vGerouArrayOrigem))
          or ((pValorBol > 0) and ((cBoleto in pImprimirArrayorigem) or (cBoleto in pEnviarArrayorigem) or (cBoleto in pGerarZipArrayOrigem)));

      if (pValorServ > 0 ) and ((cReciboLoc in pImprimirArrayorigem) or (cReciboLoc in pEnviarArrayorigem) or (cReciboLoc in pGerarZipArrayOrigem)) then // Rec
        vGerarBoleto := (vGerarBoleto) and (cReciboLoc in vGerouArrayOrigem);
      if (pValorServ > 0) and ((cNfse in pImprimirArrayorigem) or (cNfse in pEnviarArrayorigem) or (cNfse in pGerarZipArrayOrigem)) then // NFS
        vGerarBoleto := (vGerarBoleto) and (cNfse in vGerouArrayOrigem);
      if (pValorProd > 0) and ((cNfe in pImprimirArrayorigem) or (cNfe in pEnviarArrayorigem) or (cNfe in pGerarZipArrayOrigem)) then   // NF
        vGerarBoleto := (vGerarBoleto) and (cNfe in vGerouArrayOrigem);
      if (pValorBol > 0) and ((cBoleto in pImprimirArrayorigem) or (cBoleto in pEnviarArrayorigem) or (cBoleto in pGerarZipArrayOrigem)) then // Bol
        vGerarBoleto := (vGerarBoleto);

      // Gerar PDF - BOL
      if (cBoleto in vExisteArrayorigem) and (pValorBol > 0) and ((cBoleto in pImprimirArrayorigem) or (cBoleto in pEnviarArrayorigem) or (cBoleto in pGerarZipArrayOrigem)) then
      begin
        if (vGerarBoleto) then
        begin
        	try
            vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Preparando BOLETO)');

            if not vDadosIni.gerar_boleto(
              False,
              False,
              [],
              nil,
              cContrato,
              pListaBol,
              False,
              False,
              pCodCobrebem,
              False) then
                exit;

            vStringListAnexos := getArquivosBoletoParaAnexos(
                                     pNumOS,
                                     'OS',
                                     pCodCobrebem,
                                     pListaBol);

             for I := 0 to vStringListAnexos.Count - 1 do
               pStringListAnexosBol.Add(vStringListAnexos[I]);

             if vStringListAnexos.Count > 0 then
               vGerouArrayOrigem := vGerouArrayOrigem + [cBoleto];
          finally
            vDadosIni.fechaStatusProcessamento;
          end;
        end;
      end;

      // Imprimir
      pImprimiu :=
      	((pValorServ > 0) and (cReciboLoc in pImprimirArrayorigem) and (cReciboLoc in vGerouArrayOrigem))
        	 or ((pValorServ > 0) and (cNfse in pImprimirArrayorigem) and (cNfse in vGerouArrayOrigem))
          or ((pValorProd > 0) and (cNfe in pImprimirArrayorigem) and (cNfe in vGerouArrayOrigem))
          or ((pValorBol > 0) and (cBoleto in pImprimirArrayorigem) and (cBoleto in vGerouArrayOrigem));

      if (pValorServ > 0) and (cReciboLoc in pImprimirArrayorigem) then // Rec
      	pImprimiu := (pImprimiu) and (cReciboLoc in vGerouArrayOrigem);
      if (pValorServ > 0) and (cNfse in pImprimirArrayorigem) then // NFS
      	pImprimiu := (pImprimiu) and (cNfse in vGerouArrayOrigem);
      if (pValorProd > 0) and (cNfe in pImprimirArrayorigem) then // NF
      	pImprimiu := (pImprimiu) and (cNfe in vGerouArrayOrigem);
      if (pValorBol > 0) and (cBoleto in pImprimirArrayorigem) then // Bol
      	pImprimiu := (pImprimiu) and (cBoleto in vGerouArrayOrigem);

      // Enviar
      pEnviou :=
      	((pValorServ > 0) and (cReciboLoc in pEnviarArrayorigem) and (cReciboLoc in vGerouArrayOrigem))
        	 or ((pValorServ > 0) and (cNfse in pEnviarArrayorigem) and (cNfse in vGerouArrayOrigem))
          or ((pValorProd > 0) and (cNfe in pEnviarArrayorigem) and (cNfe in vGerouArrayOrigem))
          or ((pValorBol > 0) and (cBoleto in pEnviarArrayorigem) and (cBoleto in vGerouArrayOrigem));

      if (pValorServ > 0) and (cReciboLoc in pEnviarArrayorigem) then // Rec
      	pEnviou := (pEnviou) and (cReciboLoc in vGerouArrayOrigem);
      if (pValorServ > 0) and (cNfse in pEnviarArrayorigem) then // NFS
      	pEnviou := (pEnviou) and (cNfse in vGerouArrayOrigem);
      if (pValorProd > 0) and (cNfe in pEnviarArrayorigem) then // NF
      	pEnviou := (pEnviou) and (cNfe in vGerouArrayOrigem);
      if (pValorBol > 0) and (cBoleto in pEnviarArrayorigem) then // Bol
      	pEnviou := (pEnviou) and (cBoleto in vGerouArrayOrigem);

      // Gerar Zip
      pGerouZip :=
      	((pValorServ > 0) and (cReciboLoc in pGerarZipArrayOrigem) and (cReciboLoc in vGerouArrayOrigem))
        	 or ((pValorServ > 0) and (cNfse in pGerarZipArrayOrigem) and (cNfse in vGerouArrayOrigem))
          or ((pValorProd > 0) and (cNfe in pGerarZipArrayOrigem) and (cNfe in vGerouArrayOrigem))
          or ((pValorBol > 0) and (cBoleto in pGerarZipArrayOrigem) and (cBoleto in vGerouArrayOrigem));

      if (pValorServ > 0) and (cReciboLoc in pGerarZipArrayOrigem) then // Rec
      	pGerouZip := (pGerouZip) and (cReciboLoc in vGerouArrayOrigem);
      if (pValorServ > 0) and (cNfse in pGerarZipArrayOrigem) then // NFS
      	pGerouZip := (pGerouZip) and (cNfse in vGerouArrayOrigem);
      if (pValorProd > 0) and (cNfe in pGerarZipArrayOrigem) then // NF
      	pGerouZip := (pGerouZip) and (cNfe in vGerouArrayOrigem);
      if (pValorBol > 0) and (cBoleto in pGerarZipArrayOrigem) then // Bol
      	pGerouZip := (pGerouZip) and (cBoleto in vGerouArrayOrigem);

      // Imprimir
      if (pValorTotal > 0)
      	and ((cNfse in pImprimirArrayorigem)
        	 or (cNfe in pImprimirArrayorigem)
          or (cBoleto in pImprimirArrayorigem)
          or (cReciboLoc in pImprimirArrayorigem)) then
      begin
        if (pImprimiu) then
        begin
          vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Preparando Impressão)');

          for I := 0 to vStringListAnexos.Count - 1 do
            if ExtractFileExt(LowerCase(vStringListAnexos[I])) = '.pdf' then
            begin
              vQtdPdf := Length(vArquivos) + 1;
              SetLength(vArquivos, vQtdPdf);
              vArquivos[vQtdPdf - 1] := vStringListAnexos[I];
            end;

          if (Length(vArquivos) > 0) then
          begin
          	if (Length(vArquivos) <= 1) then
            begin
              vDiretorioDest := vArquivos[0];
              PdfHelper.Print(vDiretorioDest, PrintHelper.GetDefaultPrinter(), False);
            end
            else
            begin
              vDiretorioDest := GetPathTemp('') + Trim(pTipo) + IntToStr(pNumOS) + '.pdf';
              if PdfHelper.Merge(vArquivos, vDiretorioDest) then
                PdfHelper.Print(vDiretorioDest, PrintHelper.GetDefaultPrinter(), True);
            end;
          end;
        end;
      end;

      //Enviar
      if (pValorTotal > 0)
      	and ((cNfse in pEnviarArrayorigem)
        	 or (cNfe in pEnviarArrayorigem)
          or (cBoleto in pEnviarArrayorigem)
          or (cReciboLoc in pEnviarArrayorigem)) then
      begin
        if (pEnviou) then
        begin
        	 try
            vDadosIni.abreStatusProcessamento('', pHint + ' - ' + IntToStr(pIncReg) + '/' + IntToStr(pTotReg) + ' (Enviando Mensagem)');

            vArrayContato := vDadosIni.retornaArrayContato(pCodCliente, cContrato);
            for K := 0 to Length(vArrayContato) - 1 do
            begin
              vDadosIni.retornaMensagemEnv(cContrato, vArrayContato[K].Aplicativo, vAssunto, vMensagem);

              if not vDadosIni.EnvEmail(
                  vAssunto,
                  vMensagem,
                pCodCliente,
                  vArrayContato[K].Aplicativo,
                '',
                  '',
                  cContrato,
                vStringListAnexos.Text,
                vStringListAnexos.Count,
                  false,
                  vArrayContato[K].Identificacao,
                  vArrayContato[K].Contato,
                  vArrayContato[K].Avulso) then
                  Exit;
            end;
          finally
            vDadosIni.fechaStatusProcessamento;
          end;
        end;
      end;      

      vDataHoraBanco := vDadosIni.getDataHoraBanco(buscas);

      if (pValorBol > 0)
        and (pEnviou)
        and (cBoleto in vExisteArrayorigem)
        and (cBoleto in vGerouArrayOrigem)
        and (cBoleto in pArrayOrigem)
        and (cEmail in pArrayaplicativo) then
      begin
        for I := 0 to pListaBol.Count - 1 do
        begin
          if StrToInt(pListaBol[I]) > 0 then
          begin
            if not InserirEnvDoc(
              buscas,
              'BOL',
              StrToInt(pListaBol[I]),
              'E',
              vDataHoraBanco) then
                exit;
          end;
        end;
      end;

      if (pValorBol > 0)
        and (pEnviou)
        and (cBoleto in vExisteArrayorigem)
        and (cBoleto in vGerouArrayOrigem)
        and (cBoleto in pArrayOrigem)
        and (cWhatsApp in pArrayaplicativo) then
      begin
        for I := 0 to pListaBol.Count - 1 do
        begin
          if StrToInt(pListaBol[I]) > 0 then
          begin
            if not InserirEnvDoc(
              buscas,
              'BOL',
              StrToInt(pListaBol[I]),
              'W',
              vDataHoraBanco) then
                exit;
          end;
        end;
      end;

      if (pValorServ > 0)
        and (pEnviou)
        and (cReciboLoc in vExisteArrayorigem)
        and (cReciboLoc in vGerouArrayOrigem)
        and (cReciboLoc in pArrayOrigem)
        and (cEmail in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'LOC' + trim(pTipo),
          pNumOS,
          'E',
          vDataHoraBanco) then
            exit;
      end;

      if (pValorServ > 0)
        and (pEnviou)
        and (cReciboLoc in vExisteArrayorigem)
        and (cReciboLoc in vGerouArrayOrigem)
        and (cReciboLoc in pArrayOrigem)
        and (cWhatsApp in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'LOC' + trim(pTipo),
          pNumOS,
          'W',
          vDataHoraBanco) then
            exit;
      end;

      if (pValorServ > 0)
        and (pEnviou)
        and (cNfse in vExisteArrayorigem)
        and (cNfse in vGerouArrayOrigem)
        and (cNfse in pArrayOrigem)
        and (cEmail in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'NFS',
          pNumOS,
          'E',
          vDataHoraBanco) then
            exit;
      end;

      if (pValorServ > 0)
        and (pEnviou)
        and (cNfse in vExisteArrayorigem)
        and (cNfse in vGerouArrayOrigem)
        and (cNfse in pArrayOrigem)
        and (cWhatsApp in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'NFS',
          pNumOS,
          'W',
          vDataHoraBanco) then
            exit;
      end;

      if (pValorProd > 0)
        and (pEnviou)
        and (cNfe in vExisteArrayorigem)
        and (cNfe in vGerouArrayOrigem)
        and (cNfe in pArrayOrigem)
        and (cEmail in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'NF',
          pNumOS,
          'E',
          vDataHoraBanco) then
            exit;
      end;

      if (pValorProd > 0)
        and (pEnviou)
        and (cNfe in vExisteArrayorigem)
        and (cNfe in vGerouArrayOrigem)
        and (cNfe in pArrayOrigem)
        and (cWhatsApp in pArrayaplicativo) then
      begin
        if not InserirEnvDoc(
          buscas,
          'NF',
          pNumOS,
          'W',
          vDataHoraBanco) then
            exit;
      end;
    finally
    	if not pGerarZip then
       if Assigned(vStringListAnexos) then
         for I := 0 to vStringListAnexos.Count - 1 do
           if FileExists(PChar(trim(vStringListAnexos[I]))) then
             DeleteFile(PChar(trim(vStringListAnexos[I])));

      if Assigned(vStringListAnexos) then
        vStringListAnexos.Free;

    end;
  except
  	on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TEnviarContratosClientes.enviarNFSeBoleto(
  pImprimir: boolean;
  pEnviar: boolean;
  pGerarZip: boolean;
  pArrayAplicativo: arrayaplicativo;
  pArrayOrigem: arrayorigem;
  pCodGerador: Integer;
  pEnderecoArquivoZip: string
): boolean;
var
  AHandlePacoteNF: THandle;
  AHandleDllNF : THandle;
  AProcedure: TGerarEnviarNF;
  vOrdemServico, vTipoPed, vNF, vCliente, vTotDoc, vTotProd, vTotServ, vTotBol, vLocacao: TStringList;
  vListaBoletas, vListaBoletasTemp: TStringList;
  vGerarNFS, vGerarNF, vGerarRecLoc, vGerarBoleto: TStringList;
  var vImprimir, vEnviar, vGerarZip: boolean;
  vCodCliente, vCodBrebem: Integer;
  vIssRetidoCliente, vIssRetidoTipoServ: Integer;
  vValorTotServ, vValorNFSE, vValorIssRetido, vValorFp: Double;
  vPrcssFp: string;
  I, J, Y, Z: Integer;
  vMens, vMens2: string;
  vOOK: boolean;
  vProcess: string;

  fone: string;
  handleDll: THandle;
  parametros: TStrings;
  vSql: string;
  ConfigEnvContr: TConfig_sistema_class;

  vPausarCadaQuantosContratos: string;
  vPausarPorQuantosSegungos: string;
  vIncRegEnv: Integer;
  vExisteBoleto: Boolean;

  vEnvRecLocNFS: boolean;
  vNFSTmp: boolean;
  vRECTmp: boolean;

  vGerouRec: boolean;
  vGerouNFS: boolean;
  vGerouNF: boolean;
  vGerouBol: boolean;

  vStringListAnexosRecLoc: TStringList;
  vStringListAnexosNFS: TStringList;
  vStringListAnexosNF: TStringList;
  vStringListAnexosBol: TStringList;

  vImprimiu: boolean;
  vEnviou: boolean;
  vGerouZip: boolean;
  resolverRetencoes: Boolean;
  vtemp: string;
  vestadozero, vestado: string;
  vImprimirArrayOrigem: arrayorigem;
  vEnviarArrayOrigem: arrayorigem;
  vGerarZipArrayOrigem: arrayorigem;

  vArrayAnexosRecLoc: array of WideString;
  vArrayAnexosNFS: array of WideString;
  vArrayAnexosNF: array of WideString;
  vArrayAnexosBol: array of WideString;
begin
  try
  	 try
      Result := false;
      vExisteBoleto := False;
      fTempBolContratos.EmptyDataSet;

      vStringListAnexosRecLoc := TStringList.Create;
      vStringListAnexosRecLoc.Duplicates := dupIgnore;
      vStringListAnexosRecLoc.Clear;

      vStringListAnexosNFS := TStringList.Create;
      vStringListAnexosNFS.Duplicates := dupIgnore;
      vStringListAnexosNFS.Clear;

      vStringListAnexosNF := TStringList.Create;
      vStringListAnexosNF.Duplicates := dupIgnore;
      vStringListAnexosNF.Clear;

      vStringListAnexosBol := TStringList.Create;
      vStringListAnexosBol.Duplicates := dupIgnore;
      vStringListAnexosBol.Clear;

      vCodbrebem := 0;
      vIncRegEnv := 0;

      if not DirectoryExists(ExtractFilePath(Application.ExeName) + '\TempCtrNF') then
        CreateDir(ExtractFilePath(Application.ExeName) + '\TempCtrNF');

      if not DirectoryExists(ExtractFilePath(Application.ExeName) + '\TempCtrNF') then
      begin
        Application.MessageBox(PChar('Falha ao criar diretório: ' + #13 +
        	 ExtractFilePath(Application.ExeName) + '\TempCtrNF'), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
        exit;
      end;

      if pGerarZip then
        if not DirectoryExists(pEnderecoArquivoZip) then
        begin
          Application.MessageBox(PChar('Diretório arquivo zip não encontrado: ' + #13 +
       	   pEnderecoArquivoZip), 'Atenção', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          exit;
        end;

      if (cNfse in pArrayOrigem) then
        if not verificarConfRetencaoNFS then
          exit;

      if (cNfe in pArrayOrigem) then
      	if not verificarConfRetencaoNF then
          exit;

      ConfigEnvContr := TConfig_sistema_class.getConf('contratos_clientes_env_ctr', buscas, vDadosIni.cod_empresa);
      if ConfigEnvContr.value1_f = 1 then
      begin
        vPausarCadaQuantosContratos := UpperCase(trim(ConfigEnvContr.ReadString('Conf', 'PausarCadaQuantosContratos')));
        try
          strtoint(vPausarCadaQuantosContratos);
        except
          vPausarCadaQuantosContratos := '0';
        end;

        vPausarPorQuantosSegungos := UpperCase(trim(ConfigEnvContr.ReadString('Conf', 'PausarPorQuantosSegungos')));
        try
          strtoint(vPausarPorQuantosSegungos);
        except
          vPausarPorQuantosSegungos := '0';
        end;
      end
      else
      begin
        vPausarCadaQuantosContratos := '0';
        vPausarPorQuantosSegungos := '0';
      end;

      vSql := dataSet.CommandText;

      vOrdemServico                := TStringList.Create;
      vTipoPed                     := TStringList.Create;
      vNF                          := TStringList.Create;
      vCliente                     := TStringList.Create;
      vTotDoc                      := TStringList.Create;
      vTotProd                     := TStringList.Create;
      vTotServ                     := TStringList.Create;
      vTotBol                      := TStringList.Create;

      vGerarNFS                    := TStringList.Create;
      vGerarNF                     := TStringList.Create;
      vGerarRecLoc                 := TStringList.Create;
      vGerarBoleto                 := TStringList.Create;

      vLocacao                     := TStringList.Create;
      vListaBoletas                := TStringList.Create;
      vListaBoletasTemp            := TStringList.Create;

      vOrdemServico.Duplicates     := dupIgnore;
      vTipoPed.Duplicates          := dupAccept;
      vNF.Duplicates               := dupAccept;
      vCliente.Duplicates          := dupAccept;
      vTotDoc.Duplicates           := dupAccept;
      vTotProd.Duplicates          := dupAccept;
      vTotServ.Duplicates          := dupAccept;
      vTotBol.Duplicates           := dupAccept;

      vGerarNFS.Duplicates         := dupAccept;
      vGerarNF.Duplicates          := dupAccept;
		vGerarRecLoc.Duplicates      := dupAccept;
      vGerarBoleto.Duplicates      := dupAccept;

      vLocacao.Duplicates          := dupAccept;
      vListaBoletas.Duplicates     := dupIgnore;
      vListaBoletasTemp.Duplicates := dupIgnore;

      vOrdemServico.Clear;
      vTipoPed.Clear;
      vNF.Clear;
      vCliente.Clear;
      vTotDoc.Clear;
      vTotProd.Clear;
      vTotServ.Clear;
      vTotBol.Clear;

      vGerarNFS.Clear;
      vGerarNF.Clear;
      vGerarRecLoc.Clear;
      vGerarBoleto.Clear;

      vLocacao.Clear;
      vListaBoletas.Clear;
      vListaBoletasTemp.Clear;

      if (dataSet.IsEmpty) then
      begin
        Application.MessageBox(pchar('Nenhuma Ordem de Serviço informada.'), 'Atenção', MB_ICONERROR + MB_OK);
        exit;
      end;

      if (cNfse in pArrayOrigem) and (pEnviar) then
      begin
        if not vDadosIni.PesqPros('VND269', 'ENVIAR - NFS', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cNfse in pArrayOrigem) and (pImprimir) then
      begin
        if not vDadosIni.PesqPros('VND268', 'IMPRIMIR - NFS', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cNfse in pArrayOrigem) and (pGerarZip) then
      begin
        if not vDadosIni.PesqPros('VND300', 'GERAR ZIP - NFS', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end;

      if (cNfe in pArrayOrigem) and (pEnviar) then
      begin
        if not vDadosIni.PesqPros('VND272', 'ENVIAR - NF', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cNfe in pArrayOrigem) and (pImprimir) then
      begin
        if not vDadosIni.PesqPros('VND273', 'IMPRIMIR - NF', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cNfe in pArrayOrigem) and (pGerarZip) then
      begin
        if not vDadosIni.PesqPros('VND301', 'GERAR ZIP - NF', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end;

      if (cReciboLoc in pArrayOrigem) and (pEnviar) then
      begin
        if not vDadosIni.PesqPros('VND275', 'ENVIAR - REC LOC', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cReciboLoc in pArrayOrigem) and (pImprimir) then
      begin
        if not vDadosIni.PesqPros('VND274', 'IMPRIMIR - REC LOC', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cReciboLoc in pArrayOrigem) and (pGerarZip) then
      begin
        if not vDadosIni.PesqPros('VND302', 'GERAR ZIP - REC LOC', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end;

      if (cBoleto in pArrayOrigem) and (pEnviar) then
      begin
        if not vDadosIni.PesqPros('BOL038', 'ENVIAR - BOL', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cBoleto in pArrayOrigem) and (pImprimir) then
      begin
        if not vDadosIni.PesqPros('BOL010', 'IMPRIMIR - BOL', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end
      else if (cBoleto in pArrayOrigem) and (pGerarZip) then
      begin
        if not vDadosIni.PesqPros('BOL042', 'GERAR ZIP - BOL', '', 'PEDVENDA', '', buscas, true) then
          exit;
      end;

      ConfigEnvContr := TConfig_sistema_class.getConf('contratos_clientes_env_ctr_rec_loc_nfs', buscas, vDadosIni.cod_empresa);
      vEnvRecLocNFS := ConfigEnvContr.value1_f = 1;

      try
        dataSet.DisableControls;
        dataSet.Filter := 'SEL = ''S''';
        dataSet.Filtered := True;

        if (dataSet.IsEmpty) then
        begin
          Application.MessageBox(pchar('Nenhuma Ordem de Serviço selecionada.'), 'Atenção', MB_ICONERROR + MB_OK);
          exit;
        end;

        SqlOpen(' select nome_uf from estados where codigo_uf = 0 ', buscas);
        vestadozero := trim(buscas.FieldByName('nome_uf').AsString);

        dataSet.First;
        while not dataSet.Eof do
        begin
          if dataSet.FieldByName('SEL').AsString = 'S' then
          begin
          	if (trim(dataSet.FieldByName('CPFCGC').AsString) = '')
              or (trim(dataSet.FieldByName('CEP').AsString) = '')
            	or (dataSet.FieldByName('CODIGO_UF').AsInteger <= 0)
              or (dataSet.FieldByName('COD_CIDADE').AsInteger <= 0)
              or (dataSet.FieldByName('COD_BAIRRO').AsInteger <= 0) then
            begin
            	vestado := vDadosIni.IfThen(dataSet.FieldByName('CODIGO_UF').AsInteger <= 0,
                trim(vestadozero),
                trim(dataSet.FieldByName('SIGLA_UF').AsString));

              Application.MessageBox(pchar('Cliente sem CNPJ / CPF: ' + #13 + #13 +
              	'CLIENTE' + #13 +
                'Cod Cliente: ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) + #13 +
                'Nome Fantasia: ' + trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + #13 +
                'Razão Social: ' + trim(dataSet.FieldByName('RAZAO').AsString) + #13 +
                'Estado:' + vestado + #13 +
                'Cidade: ' + trim(dataSet.FieldByName('NOME_CIDADE').AsString) + #13 +
                'Bairro: ' + trim(dataSet.FieldByName('NOME_BAIRRO').AsString) + #13 + #13 +
                'Favor verificar antes de continuar.'), 'Atenção', MB_ICONERROR + MB_OK);
              exit;
            end;

            if vOrdemServico.IndexOf(IntToStr(dataSet.FieldByName('NPED').AsInteger)) < 0 then
            begin
              vOrdemServico.Add(IntToStr(dataSet.FieldByName('NPED').AsInteger));
              vTipoPed.Add(trim(dataSet.FieldByName('TIPO').AsString));
              vNF.Add(IntToStr(dataSet.FieldByName('COD_NF').AsInteger) + '|' +
              	IntToStr(dataSet.FieldByName('NUM_NF').AsInteger) + '|' +
                trim(dataSet.FieldByName('SERIE_NF').AsString) + '|');
              vCliente.Add(IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger));
              vTotDoc.Add(FloatToStr(dataSet.FieldByName('VALOR_TOTAL').AsFloat));
              vTotProd.Add(FloatToStr(dataSet.FieldByName('TOT_PROD').AsFloat));
              vTotServ.Add(FloatToStr(dataSet.FieldByName('TOT_SERV').AsFloat));
              vTotBol.Add(FloatToStr(dataSet.FieldByName('TOT_BOLETAS').AsFloat));
              vLocacao.Add(trim(dataSet.FieldByName('LOCACAO').AsString));

              vGerarNFS.Add(vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_NFS').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_NFS').AsString)));

              vGerarNF.Add(vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_NF').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_NF').AsString)));

              vGerarRecLoc.Add(vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_REC_LOC').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_REC_LOC').AsString)));

              vGerarBoleto.Add(vDadosIni.IfThen(trim(dataSet.FieldByName('GERAR_BOLETO').AsString) = '', 'S', trim(dataSet.FieldByName('GERAR_BOLETO').AsString)));

              if (dataSet.FieldByName('TOT_BOLETAS').AsFloat > 0) and (dataSet.FieldByName('GERAR_BOLETO').AsString = 'S') then
              	vExisteBoleto := True;

              SqlOpen(' select n_seq_bol from boletas ' +
                ' where num_nf_vnd = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
                ' and tipo_emissao = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and ativo = 1 ', buscas).FetchAll;

              buscas.First;
              while not buscas.Eof do
              begin
                fTempBolContratos.Filter := 'NPED = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
                  ' AND TIPO = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
                  ' AND N_SEQ_BOL = ' + IntToStr(buscas.FieldByName('N_SEQ_BOL').AsInteger);
                fTempBolContratos.Filtered := True;

                if fTempBolContratos.IsEmpty then
                begin
                  fTempBolContratos.Insert;
                  fTempBolContratos.FieldByName('NPED').AsInteger := dataSet.FieldByName('NPED').AsInteger;
                  fTempBolContratos.FieldByName('TIPO').AsString := dataSet.FieldByName('TIPO').AsString;
                  fTempBolContratos.FieldByName('N_SEQ_BOL').AsInteger := buscas.FieldByName('N_SEQ_BOL').AsInteger;
                  fTempBolContratos.Post;
                end;

                if vListaBoletas.IndexOf(IntToStr(buscas.FieldByName('N_SEQ_BOL').AsInteger)) < 0 then
                  vListaBoletas.Add(IntToStr(buscas.FieldByName('N_SEQ_BOL').AsInteger));

              	if not vDadosIni.sincronizarDadosContatoClienteAplicativo(
                  dataSet.FieldByName('COD_CLIENTE').AsInteger) then
                  	Exit;

                buscas.Next;
              end;
            end;
          end;

          dataSet.Next;
        end;
      finally
        dataSet.EnableControls;
        dataSet.Filter := '';
        dataSet.Filtered := False;
        dataSet.First;
      end;

      vDadosIni.vNaoExibirTelaConfEmailWhatsAppTemp := true;

      vMens := 'Deseja ' + vDadosIni.IfThen(pImprimir, 'Imprimir', '') +
                           vDadosIni.IfThen(pImprimir and pEnviar, '/', '') +
                           vDadosIni.IfThen(pEnviar, 'Enviar', '') +
                           vDadosIni.IfThen((pImprimir or pEnviar) and pGerarZip, '/', '') +
                           vDadosIni.IfThen(pGerarZip, 'Gerar Arquivo(s) (*.zip)', '') + '?';

      vMens2 := vDadosIni.IfThen(pImprimir, 'Imprimindo', '') +
                vDadosIni.IfThen(pImprimir and pEnviar, '/', '') +
                vDadosIni.IfThen(pEnviar, 'Enviando', '') +
                vDadosIni.IfThen((pImprimir or pEnviar) and pGerarZip, '/', '') +
                vDadosIni.IfThen(pGerarZip, 'Gerando Arquivo(s) (*.zip)', '');

      vDadosIni.abreStatusProcessamento('', vMens2);

      vOOK := Application.MessageBox(pchar(vMens),
        'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = idyes;

      if not vOOK then
        Exit;

      if (cNfe in pArrayOrigem) and ((pImprimir) or (pEnviar) or (pGerarZip)) then
      begin
        CarregaPacote('pkNF', AHandlePacoteNF);

        if AHandlePacoteNF = 0 then
        begin
          Application.MessageBox('Pacote Nota Fiscal não carregado', 'Atenção', 0 + 64);
          Exit;
        end;

        AHandleDllNF := LoadLibrary(PAnsiChar('hw.nfe.dx.dll'));

        if AHandleDllNF = 0 then
        begin
          Application.MessageBox('Dll hw.nfe.dx.dll não carregado', 'Atenção', 0 + 64);
          Exit;
        end;
      end;

      if (vOrdemServico.Count > 0) and (vExisteBoleto)
        and (cBoleto in pArrayOrigem)
        and ((pImprimir) or (pEnviar) or (pGerarZip)) then
      begin
        vCodbrebem := vDadosIni.selecionar_convenio(
          (pImprimir) or (pGerarZip),
          pEnviar,
          cContrato,
          vListaBoletas,
          False);

        if vCodbrebem <= 0 then
        begin
          Application.MessageBox('Convênio não informado, favor verificar antes de continuar.',
            'Atenção', MB_ICONINFORMATION + MB_OK + MB_DEFBUTTON1);
          Result := False;
          exit;
        end;
      end;

      for I := 0 to vOrdemServico.Count - 1 do
      begin
        Application.ProcessMessages;

        if vDadosIni.vHwCloudIA.vUsarServMensageria <> 'S' then
          if ConfigEnvContr.value1_f = 1 then
          begin
            Inc(vIncRegEnv);
            if I > 0 then
              if (StrToInt(trim(vPausarCadaQuantosContratos)) > 0) and (StrToInt(trim(vPausarPorQuantosSegungos)) > 0) then
              begin
                if (vIncRegEnv > StrToInt(vPausarCadaQuantosContratos)) then
                begin
                  vDadosIni.abreStatusProcessamento('',
                    'Aguarde ' + trim(vPausarPorQuantosSegungos) + ' segundo(s)' +
                    ' - ' + IntToStr(I + 1) + '/' + IntToStr(vOrdemServico.Count));
                  Sleep(StrToInt(vPausarPorQuantosSegungos) * 1000);
                  vIncRegEnv := 1;
                end;
              end;
          end;

        vNFSTmp := True;
        if vEnvRecLocNFS then
          vNFSTmp := (trim(vLocacao[I]) <> 'S');

        vRECTmp := True;
        if vEnvRecLocNFS then
          vRECTmp := (trim(vLocacao[I]) = 'S');

        vImprimir            := pImprimir;
        vEnviar              := pEnviar;
        vGerarZip            := pGerarZip;

        vGerouRec            := False;
        vGerouNFS            := False;
        vGerouNF             := False;
        vGerouBol            := False;

        vImprimiu            := False;
        vEnviou              := False;
        vGerouZip            := False;

        vDadosIni.abreStatusProcessamento('', vMens2 + ' - ' + IntToStr(I + 1) + '/' + IntToStr(vOrdemServico.Count));

        //Carregar boleto
        if (trim(vGerarBoleto[I]) = 'S')
          and (cBoleto in pArrayOrigem)
          and (StrToFloat(vTotBol[I]) > 0) then
        begin
          fTempBolContratos.Filter := 'NPED = ' + vOrdemServico[I] +
            ' AND TIPO = ' + QuotedStr(vTipoPed[I]);
          fTempBolContratos.Filtered := True;

          vListaBoletasTemp.Clear;
          fTempBolContratos.First;
          while not fTempBolContratos.Eof do
          begin
            vListaBoletasTemp.Add(IntToStr(fTempBolContratos.FieldByName('N_SEQ_BOL').AsInteger));

            fTempBolContratos.Next;
          end;
        end;

        resolverRetencoes := False;

        //Enviar NFS
      //Gerar NFS
        if (vNFSTmp)
          and (trim(vGerarNFS[I]) = 'S')
          and (cNfse in pArrayOrigem)
          and (StrToFloat(vTotServ[I]) > 0) then
        begin
          try
            vImprimir := False;
            vEnviar   := False;
            vGerarZip := False;

            CallerNFSeFeatures.Emitir( StrToInt(vOrdemServico[I]), True );
          finally
            vImprimir := pImprimir;
            vEnviar   := pEnviar;
            vGerarZip := pGerarZip;
          end;

          resolverRetencoes := True;

          //Verificar iss retido
          {
          if not verificaRetencaoTributosFederais(
            'S',
            StrToInt(vOrdemServico[I]),
            vTipoPed[I],
            StrToInt(vCliente[I])) then
              exit;
          }
        end;

      //Gerar NF
        if (trim(vGerarNF[I]) = 'S')
          and (cNfe in pArrayOrigem)
          and (StrToFloat(vTotProd[I]) > 0) then
        begin
          try
             @AProcedure := GetProcAddress(AHandlePacoteNF, 'GerarEnviarNF');
            if Assigned(AProcedure) then
              AProcedure(
                StrToInt(vOrdemServico[I]),
                vTipoPed[I],
                StrToInt(vDadosIni.getCampoPipe(vNF[I], 1)),
                StrToInt(vDadosIni.getCampoPipe(vNF[I], 2)),
                vDadosIni.getCampoPipe(vNF[I], 3),
                False);

            resolverRetencoes := True;

            //Verificar iss retido
            {
            if not verificaRetencaoTributosFederais(
             'P',
              StrToInt(vOrdemServico[I]),
              vTipoPed[I],
              StrToInt(vCliente[I])) then
                exit;
            }
          finally
          end;
        end;

        if resolverRetencoes and not ResolverRetencoesDocumentosFiscais(StrToInt(vOrdemServico[I]), vTipoPed[I]) then
          Exit;

        if (trim(vGerarNF[I]) = 'S')
          and (cNfe in pArrayOrigem)
          and (StrToFloat(vTotProd[I]) > 0) then
        begin
          if not verificaDespesasNF(
             StrToInt(vOrdemServico[I]),
            vTipoPed[I],
            StrToFloat(vTotDoc[I]),
            StrToFloat(vTotProd[I]),
            StrToFloat(vTotServ[I]),
            StrToFloat(vTotBol[I])) then
              exit;
        end;

        vImprimirArrayOrigem := [];
        if (vNFSTmp) and (cNfse in pArrayOrigem) and (trim(vGerarNFS[I]) = 'S') and (pImprimir) and (StrToFloat(vTotServ[I]) > 0) then
          vImprimirArrayOrigem := vImprimirArrayOrigem + [cNfse];
        if (cNfe in pArrayOrigem) and (trim(vGerarNF[I]) = 'S') and (pImprimir) and (StrToFloat(vTotProd[I]) > 0) then
          vImprimirArrayOrigem := vImprimirArrayOrigem + [cNfe];
        if (cBoleto in pArrayOrigem) and (trim(vGerarBoleto[I]) = 'S') and (pImprimir) and (StrToFloat(vTotBol[I]) > 0) then
          vImprimirArrayOrigem := vImprimirArrayOrigem + [cBoleto];
        if (vRECTmp) and (cReciboLoc in pArrayOrigem) and (trim(vGerarRecLoc[I]) = 'S') and (pImprimir) and (StrToFloat(vTotServ[I]) > 0) then
          vImprimirArrayOrigem := vImprimirArrayOrigem + [cReciboLoc];

        vEnviarArrayOrigem := [];
        if (vNFSTmp) and (cNfse in pArrayOrigem) and (trim(vGerarNFS[I]) = 'S') and (pEnviar) and (StrToFloat(vTotServ[I]) > 0) then
          vEnviarArrayOrigem := vEnviarArrayOrigem + [cNfse];
        if (cNfe in pArrayOrigem) and (trim(vGerarNF[I]) = 'S') and (pEnviar) and (StrToFloat(vTotProd[I]) > 0) then
          vEnviarArrayOrigem := vEnviarArrayOrigem + [cNfe];
        if (cBoleto in pArrayOrigem) and (trim(vGerarBoleto[I]) = 'S') and (pEnviar) and (StrToFloat(vTotBol[I]) > 0) then
          vEnviarArrayOrigem := vEnviarArrayOrigem + [cBoleto];
        if (vRECTmp) and (cReciboLoc in pArrayOrigem) and (trim(vGerarRecLoc[I]) = 'S') and (pEnviar) and (StrToFloat(vTotServ[I]) > 0) then
          vEnviarArrayOrigem := vEnviarArrayOrigem + [cReciboLoc];

        vGerarZipArrayOrigem := [];
        if (vNFSTmp) and (cNfse in pArrayOrigem) and (trim(vGerarNFS[I]) = 'S') and (pGerarZip) and (StrToFloat(vTotServ[I]) > 0) then
          vGerarZipArrayOrigem := vGerarZipArrayOrigem + [cNfse];
        if (cNfe in pArrayOrigem) and (trim(vGerarNF[I]) = 'S') and (pGerarZip) and (StrToFloat(vTotProd[I]) > 0) then
          vGerarZipArrayOrigem := vGerarZipArrayOrigem + [cNfe];
        if (cBoleto in pArrayOrigem) and (trim(vGerarBoleto[I]) = 'S') and (pGerarZip) and (StrToFloat(vTotBol[I]) > 0) then
          vGerarZipArrayOrigem := vGerarZipArrayOrigem + [cBoleto];
        if (vRECTmp) and (cReciboLoc in pArrayOrigem) and (trim(vGerarRecLoc[I]) = 'S') and (pGerarZip) and (StrToFloat(vTotServ[I]) > 0) then
          vGerarZipArrayOrigem := vGerarZipArrayOrigem + [cReciboLoc];

          //Imprimir/Enviar NFS, NF, Locacao e Boleto
        if ((cNfse in pArrayOrigem) and (StrToFloat(vTotServ[I]) > 0))
          or ((cNfe in pArrayOrigem) and (StrToFloat(vTotProd[I]) > 0))
          or ((cBoleto in pArrayOrigem) and (StrToFloat(vTotBol[I]) > 0))
          or ((cReciboLoc in pArrayOrigem) and (StrToFloat(vTotServ[I]) > 0))	 then
        begin
          if not enviarImprimir(
            StrToInt(vOrdemServico[I]),
            vTipoPed[I],
            pImprimir,
            pEnviar,
            pGerarZip,
            StrToFloat(vTotDoc[I]),
            StrToFloat(vTotProd[I]),
            StrToFloat(vTotServ[I]),
            StrToFloat(vTotBol[I]),
            StrToInt(vCliente[I]),
            vCodBrebem,
            vListaBoletasTemp,
            pArrayOrigem,
            pArrayAplicativo,
            vStringListAnexosRecLoc,
            vStringListAnexosNFS,
            vStringListAnexosNF,
            vStringListAnexosBol,
            vImprimirArrayOrigem,
            vEnviarArrayOrigem,
            vGerarZipArrayOrigem,
            I + 1,
            vOrdemServico.Count,
            vMens2,
            AHandleDllNF,
            vImprimiu,
            vEnviou,
            vGerouZip) then
              exit;
        end;

        if (StrToFloat(vTotServ[I]) > 0) and (vGerouNFS) then
        begin
          if (cNfse in pArrayOrigem) and (vEnviou) and (pEnviar) then
          begin
            vDadosIni.GravaAuditoria('VND269', 'ENVIAR - NFS', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cNfse in pArrayOrigem) and (vImprimiu) and (pImprimir) then
          begin
            vDadosIni.GravaAuditoria('VND268', 'IMPRIMIR - NFS', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cNfse in pArrayOrigem) and (vGerouZip) and (pGerarZip) then
          begin
            vDadosIni.GravaAuditoria('VND300', 'GERAR ZIP - NFS', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end;
        end;

        if (StrToFloat(vTotProd[I]) > 0) and (vGerouNF) then
        begin
          if (cNfe in pArrayOrigem) and (vEnviou) and (pEnviar) then
          begin
            vDadosIni.GravaAuditoria('VND272', 'ENVIAR - NF', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cNfe in pArrayOrigem) and (vImprimiu) and (pImprimir) then
          begin
            vDadosIni.GravaAuditoria('VND273', 'IMPRIMIR - NF', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cNfe in pArrayOrigem) and (vGerouZip) and (pGerarZip) then
          begin
            vDadosIni.GravaAuditoria('VND301', 'GERAR ZIP - NF', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
        end;

        if (StrToFloat(vTotServ[I]) > 0) and (vGerouRec) then
        begin
          if (cReciboLoc in pArrayOrigem) and (vEnviou) and (pEnviar) then
          begin
            vDadosIni.GravaAuditoria('VND275', 'ENVIAR - REC LOC', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cReciboLoc in pArrayOrigem) and (vImprimiu) and (pImprimir) then
          begin
            vDadosIni.GravaAuditoria('VND274', 'IMPRIMIR - REC LOC', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cReciboLoc in pArrayOrigem) and (vGerouZip) and (pGerarZip) then
          begin
            vDadosIni.GravaAuditoria('VND302', 'GERAR ZIP - REC LOC', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
        end;

        if (StrToFloat(vTotBol[I]) > 0) and (vGerouBol) then
        begin
          if (cBoleto in pArrayOrigem) and (vEnviou) and (pEnviar) then
          begin
            vDadosIni.GravaAuditoria('BOL038', 'ENVIAR - BOL', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cBoleto in pArrayOrigem) and (vImprimiu) and (pImprimir) then
          begin
            vDadosIni.GravaAuditoria('BOL010', 'IMPRIMIR - BOL', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end
          else if (cBoleto in pArrayOrigem) and (vGerouZip) and (pGerarZip) then
          begin
            vDadosIni.GravaAuditoria('BOL042', 'GERAR ZIP - BOL', '', 'PEDVENDA', vTipoPed[I] + ' ' + vOrdemServico[I], buscas);
          end;
        end;

        CommitaTransacao;
      end;

      if pGerarZip then
      begin
        if vStringListAnexosRecLoc.Count > 0 then
        begin
          vDadosIni.abreStatusProcessamento('', 'Montando arquivo (*.zip) - Recibo Locação - ' + IntToStr(vStringListAnexosRecLoc.Count));

          SetLength(vArrayAnexosRecLoc, 0);
          for I := 0 to vStringListAnexosRecLoc.Count - 1 do
          begin
            SetLength(vArrayAnexosRecLoc, Length(vArrayAnexosRecLoc) + 1);
            vArrayAnexosRecLoc[High(vArrayAnexosRecLoc)] := vStringListAnexosRecLoc[I];
          end;
          CompactarArquivosMD5(vArrayAnexosRecLoc, pEnderecoArquivoZip + '\rec_loc.zip');
        end;

        if vStringListAnexosNFS.Count > 0 then
        begin
        	 vDadosIni.abreStatusProcessamento('', 'Montando arquivo (*.zip) - NFSe - ' + IntToStr(vStringListAnexosNFS.Count));

          SetLength(vArrayAnexosNFS, 0);
          for I := 0 to vStringListAnexosNFS.Count - 1 do
          begin
            SetLength(vArrayAnexosNFS, Length(vArrayAnexosNFS) + 1);
            vArrayAnexosNFS[High(vArrayAnexosNFS)] := vStringListAnexosNFS[I];
          end;
          CompactarArquivosMD5(vArrayAnexosNFS, pEnderecoArquivoZip + '\nfs.zip');
        end;

        if vStringListAnexosNF.Count > 0 then
        begin
          vDadosIni.abreStatusProcessamento('', 'Montando arquivo (.*zip) - NFe - ' + IntToStr(vStringListAnexosNF.Count));

          SetLength(vArrayAnexosNF, 0);
          for I := 0 to vStringListAnexosNF.Count - 1 do
          begin
            SetLength(vArrayAnexosNF, Length(vArrayAnexosNF) + 1);
            vArrayAnexosNF[High(vArrayAnexosNF)] := vStringListAnexosNF[I];
          end;
          CompactarArquivosMD5(vArrayAnexosNF, pEnderecoArquivoZip + '\nf.zip');
        end;

        if vStringListAnexosBol.Count > 0 then
        begin
          vDadosIni.abreStatusProcessamento('', 'Montando arquivo (*.zip) - Boleto - ' + IntToStr(vStringListAnexosBol.Count));
          
          SetLength(vArrayAnexosBol, 0);
          for I := 0 to vStringListAnexosBol.Count - 1 do
          begin
            SetLength(vArrayAnexosBol, Length(vArrayAnexosBol) + 1);
            vArrayAnexosBol[High(vArrayAnexosBol)] := vStringListAnexosBol[I];
          end;
          CompactarArquivosMD5(vArrayAnexosBol, pEnderecoArquivoZip + '\bol.zip');
        end;
      end;

      if (cNfse in pArrayOrigem) and (pEnviar) then
      begin
        vDadosIni.GravaAuditoria('VND269', 'ENVIAR - NFS', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cNfse in pArrayOrigem) and (pImprimir) then
      begin
        vDadosIni.GravaAuditoria('VND268', 'IMPRIMIR - NFS', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cNfse in pArrayOrigem) and (pGerarZip) then
      begin
        vDadosIni.GravaAuditoria('VND300', 'GERAR ZIP - NFS', 'SUCESSO', 'PEDVENDA', '', buscas);
      end;

      if (cNfe in pArrayOrigem) and (pEnviar) then
      begin
        vDadosIni.GravaAuditoria('VND272', 'ENVIAR - NF', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cNfe in pArrayOrigem) and (pImprimir) then
      begin
        vDadosIni.GravaAuditoria('VND273', 'IMPRIMIR - NF', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cNfe in pArrayOrigem) and (pGerarZip) then
      begin
        vDadosIni.GravaAuditoria('VND301', 'GERAR ZIP - NF', 'SUCESSO', 'PEDVENDA', '', buscas);
      end;

      if (cReciboLoc in pArrayOrigem) and (pEnviar) then
      begin
        vDadosIni.GravaAuditoria('VND275', 'ENVIAR - REC LOC', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cReciboLoc in pArrayOrigem) and (pImprimir) then
      begin
        vDadosIni.GravaAuditoria('VND274', 'IMPRIMIR - REC LOC', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cReciboLoc in pArrayOrigem) and (pGerarZip) then
      begin
        vDadosIni.GravaAuditoria('VND302', 'GERAR ZIP - REC LOC', 'SUCESSO', 'PEDVENDA', '', buscas);
      end;

      if (cBoleto in pArrayOrigem) and (pEnviar) then
      begin
        vDadosIni.GravaAuditoria('BOL038', 'ENVIAR BOL', 'SUCESSO', 'PEDVENDA', '', buscas);
      end
      else if (cBoleto in pArrayOrigem) and (pImprimir) then
      begin
        vDadosIni.GravaAuditoria('BOL010', 'IMPRIMIR - BOL', 'SUCESSO',	'PEDVENDA', '', buscas);
      end
      else if (cBoleto in pArrayOrigem) and (pGerarZip) then
      begin
        vDadosIni.GravaAuditoria('BOL042', 'GERAR ZIP - BOL', 'SUCESSO', 'PEDVENDA', '', buscas);
      end;

      CommitaTransacao;

      if trim(vSql) <> '' then
      begin
        dataSet.Close;
        dataSet.CommandText := vSql;
        dataSet.Open;
      end
      else
        dataSet.Refresh;

      Result := true;
    finally
    	if Assigned(vStringListAnexosRecLoc) then
        for I := 0 to vStringListAnexosRecLoc.Count - 1 do
          if FileExists(PChar(trim(vStringListAnexosRecLoc[I]))) then
            DeleteFile(PChar(trim(vStringListAnexosRecLoc[I])));

      if Assigned(vStringListAnexosNFS) then
        for I := 0 to vStringListAnexosNFS.Count - 1 do
          if FileExists(PChar(trim(vStringListAnexosNFS[I]))) then
            DeleteFile(PChar(trim(vStringListAnexosNFS[I])));

      if Assigned(vStringListAnexosNF) then
        for I := 0 to vStringListAnexosNF.Count - 1 do
          if FileExists(PChar(trim(vStringListAnexosNF[I]))) then
            DeleteFile(PChar(trim(vStringListAnexosNF[I])));

      if Assigned(vStringListAnexosBol) then
        for I := 0 to vStringListAnexosBol.Count - 1 do
          if FileExists(PChar(trim(vStringListAnexosBol[I]))) then
            DeleteFile(PChar(trim(vStringListAnexosBol[I])));

      if Assigned(vStringListAnexosRecLoc) then
        vStringListAnexosRecLoc.Free;

      if Assigned(vStringListAnexosNFS) then
        vStringListAnexosNFS.Free;

      if Assigned(vStringListAnexosNF) then
        vStringListAnexosNF.Free;

      if Assigned(vStringListAnexosBol) then
        vStringListAnexosBol.Free;

//    	if AHandlePacoteNF <> 0 then
//    		Free(AHandlePacoteNF);
    	if AHandleDllNF <> 0 then
    		FreeLibrary(AHandleDllNF);
      vDadosIni.fechaStatusProcessamento;
    end;

    if pGerarZip then
    begin
      vTemp := '';
      if Length(vArrayAnexosRecLoc) > 0 then
        if FileExists(pEnderecoArquivoZip + '\rec_loc.zip') then
          vtemp := vtemp + pEnderecoArquivoZip + '\rec_loc.zip' + #13;

      if Length(vArrayAnexosNFS) > 0 then
        if FileExists(pEnderecoArquivoZip + '\nfs.zip') then
          vtemp := vtemp + pEnderecoArquivoZip + '\nfs.zip' + #13;

      if Length(vArrayAnexosNF) > 0 then
        if FileExists(pEnderecoArquivoZip + '\nf.zip') then
          vtemp := vtemp + pEnderecoArquivoZip + '\nf.zip' + #13;

      if Length(vArrayAnexosBol) > 0 then
        if FileExists(pEnderecoArquivoZip + '\bol.zip') then
          vtemp := vtemp + pEnderecoArquivoZip + '\bol.zip' + #13;

      if trim(vTemp) <> '' then
        Application.MessageBox(PChar('Arquivo(s) *.zip gerado(s) com sucesso !' + #13 + #13 +
        	 vtemp), 'Informação');
    end;      
  except
    on e: exception do
    begin
      Result := false;

      if (cNfse in pArrayOrigem) and (pEnviar) then
        vDadosIni.GravaAuditoria('VND269', 'ENVIAR - NFS', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cNfse in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('VND268', 'IMPRIMIR - NFS', 'FALHA', 'PEDVENDA', '', buscas)
