    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadClientes.DadosPessoaisObrigatorios: boolean;
var
  vListaEmail: TStringList;
  vEmails: string;
  I: Integer;
begin
  try
    Result := true;
    if trim(dataSet.FieldByName('TIPO').Asstring) = '' then
      raiseExceptionCreate('Tipo ''CLIENTE'', ''FORNECEDOR'' ou  ''AMBOS'' não informado.' + chr(13) + 'Campo Requerido.', 'DBComboBox8');

    if trim(dataSet.FieldByName('NOME_CLIENTE').AsString) = '' then
      raiseExceptionCreate('Nome do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit7');

    if trim(dataSet.FieldByName('RAZAO').asstring) = '' then
      raiseExceptionCreate('Razao Social não Informada' + chr(13) + 'Campo Requerido.', 'DBEdit8');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('CPFCGC').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF/CNPJ', 'DBEdit6');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('cpfcgc').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      begin
      	if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 11 then
        begin
        	if not CPF(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
            raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
              'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF válido', 'DBEdit6');
        end
      	else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 14 then
        begin
        	if not CNPJ(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
            raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
              'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CNPJ válido', 'DBEdit6');
        end
        else
          raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
            'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF/CNPJ válido', 'DBEdit6');
      end;

    //    if dataSet.FieldByName('CODIGO_TIPO').IsNull then
    //      raiseExceptionCreate('Tipo de Cliente / Fornecedor não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox2');

    if (dataSet.FieldByName('CODIGO_TIPO').IsNull) then
      //and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Tipo Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox2');

    if (dataSet.FieldByName('CPFCGC').EditMask = '999.999.999-99;0;') and
      (dataSet.FieldByName('NATURALID').IsNull) and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Naturalidade não informada.' + chr(13) + 'Campo Requerido.', 'DBEdit24');

    if (dataSet.FieldByName('DATA_NASC').AsDateTime > date) and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Data de Nascimento maior que data atual.' + chr(13) + 'Favor verificar.', 'DBEdit20');

    if (dataSet.FieldByName('CPFCGC').EditMask = '999.999.999-99;0;') and
      (dataSet.FieldByName('DATA_NASC').IsNull) and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Data de nascimento não informada.' + chr(13) + 'Campo Requerido.', 'DBEdit20');

    if (dataSet.FieldByName('SEXO').AsString = '') and (dataSet.FieldByName('CPFCGC').EditMask =
      '999.999.999-99;0;') and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Sexo do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBComboBox4')
    else if (dataSet.FieldByName('SEXO').AsString = '') then
      dataset.fieldbyname('SEXO').asstring := 'M';

    if (dataSet.FieldByName('CPFCGC').EditMask = '999.999.999-99;0;') and
      (trim(dataSet.FieldByName('PAI').asstring) = '') and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Filiação não informada.' + chr(13) + 'Campo Requerido.', 'DBEdit25');

    if (dataSet.FieldByName('CPFCGC').EditMask = '999.999.999-99;0;') and
      (trim(dataSet.FieldByName('MAE').asstring) = '') and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('Filiação não informada.' + chr(13) + 'Campo Requerido.', 'DBEdit26');

    if trim(dataSet.FieldByName('CEP').AsString) = '' then
      raiseExceptionCreate('CEP não informado' + chr(13) + 'Campo Requerido.', 'DBEdit12');

    if Length(trim(dataSet.FieldByName('CEP').AsString)) <> 8 then
      raiseExceptionCreate('CEP incorreto' + chr(13) + 'Campo Requerido.', 'DBEdit12');

    if trim(dataSet.FieldByName('ENDERECO').AsString) = '' then
      raiseExceptionCreate('Endereço do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit9');

    if dataSet.FieldByName('NUM_END_CLIENTE').IsNull then
      raiseExceptionCreate('Número do Logradouro não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit68');

    if not SetNomeBairro then
    begin
      vNomeCampoErro := 'DBEdit10';
      Result := False;
      exit;
    end;
    if not SetNomeCidade then
    begin
      vNomeCampoErro := 'DBEdit11';
      Result := False;
      exit;
    end;
    if not SetNomeEstado then
    begin
      vNomeCampoErro := 'DBLookupComboBox1';
      Result := False;
      exit;
    end;

    if dataSet.FieldByName('CODIGO_UF').IsNull then
      raiseExceptionCreate('UF não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox1');

    if dataSet.FieldByName('cod_localidade').AsString <> '' then
    begin
      if not ExecutaComandosSql('select cod_localidade from localidade' +
        ' where cod_localidade = ' + IntToStr(dataSet.FieldByName('cod_localidade').AsInteger) +
        ' and cod_empresa = ' + vDadosIni.codEmpresa + ' and ativo = 1') then
      	raiseExceptionCreate('Localidade informada não encontrada no cadastro', 'DBEdit91');
    end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('email').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar o e-mail', 'DBEdit69');

    if Trim(dataSet.FieldByName('email').AsString) <> '' then
    begin
      vEmails := LowerCase(Trim(dataSet.FieldByName('email').AsString));
      vEmails := StringReplace(vEmails, ',', ';', [rfReplaceAll]);
      vListaEmail := TStringList.Create;
      vListaEmail.Clear;
      vListaEmail.Sorted := True;
      vListaEmail.Sort;
      vListaEmail.Duplicates := dupIgnore;
      vListaEmail := vDadosIni.Split(vEmails, ';');
      for I := 0 to vListaEmail.Count - 1 do
        if Trim(vListaEmail[i]) <> '' then
          if not vDadosIni.validaTextoEMail2(Trim(vListaEmail[i])) then
            raiseExceptionCreate('Email "' + Trim(vListaEmail[i]) + '" informado inválido', 'DBEdit69');

      dataSet.FieldByName('email').AsString := vEmails;

      if vDadosIni.vEcommerce.vHabilitarEcommerce then
        if (trim(dataSet.FieldByName('email').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
        begin
        	if vListaEmail.Count > 1 then
	        	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
  	          'Para sincronizar os cupons de desconto com E-Commerce é necessário informar somente 1 e-mail, ' +
              'pois este email será utilizado para cadastrar/sincronizar os dados do cliente com o E-Commerce', 'DBEdit69');

        	for I := 0 to vListaEmail.Count - 1 do
		        if Trim(vListaEmail[i]) <> '' then
            begin
              buscas.Close;
              buscas.SQL.Text := 'select cod_cliente, cod_empresa, email from clientes ' +
                ' where cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and email = ' + QuotedStr(Trim(vListaEmail[i]));
              buscas.Open;

              if not buscas.IsEmpty then
                raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
                  'Para sincronizar os cupons de desconto com E-Commerce não deve existir outro cliente com o e-mail informado, ' +
                  'pois o E-Commerce não aceita clientes com o mesmo e-mail', 'DBEdit69');
            end;
        end;
    end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('fone_celular').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar o telefone celular', 'DBEdit204');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
    begin
      if (trim(dataSet.FieldByName('fone_celular').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select cod_cliente, cod_empresa, fone_celular from clientes ' +
          ' where cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and fone_celular = ' + QuotedStr(trim(dataSet.FieldByName('fone_celular').AsString));
        buscas.Open;

        if not buscas.IsEmpty then
          raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
            'Para sincronizar os cupons de desconto com E-Commerce não deve existir outro cliente com o telefone celular informado, ' +
            'pois o E-Commerce não aceita clientes com o mesmo telefone celular', 'DBEdit204');
      end;
    end;

    if vDadosIni.vCashback.vHabilitarCashback then
    begin
      if (trim(dataSet.FieldByName('CPFCGC').AsString) = '') and (trim(dataSet.FieldByName('FONE_CELULAR').AsString) = '') then
      	raiseExceptionCreate('Empresa utiliza o Programa de Cashback: '+ #13 + #13 +
        	'Para sincronizar os clientes é necessário informar CPF/CNPJ ou Celular', 'DBEdit6');
    end;


    if not TestaInscEstadual then
    begin
      vNomeCampoErro := 'DBEdit13';
      Result := False;
      exit;
    end;

    if not ValidaInscEstadual then
    begin
      vNomeCampoErro := 'DBEdit13';
      Result := False;
      exit;
    end;

    if (dataSet.FieldByName('CPFCGC').EditMask = '999.999.999-99;0;') and
      (trim(dataSet.FieldByName('RG').asstring) = '') and (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      raiseExceptionCreate('RG não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit32');

    if (trim(dataSet.FieldByName('NATURALID').AsString) = '') and
      (dataSet.FieldByName('TIPO').Asstring <> 'F') then
      dataSet.FieldByName('NATURALID').AsString := dataSet.FieldByName('CIDADE').AsString;
    if (dataSet.FieldByName('TIPO').Asstring = 'F') then
    begin
      dataSet.FieldByName('EST_CODIGO_UF').AsInteger := dataSet.FieldByName('CODIGO_UF').AsInteger;

      if dataSet.FieldByName('EST_CODIGO_UF').AsInteger > 0 then
      begin
         SqlOpen(' select codigo_uf, sigla_uf from estados ' +
          ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('EST_CODIGO_UF').AsInteger) +
          ' and ativo = 1 ');
         if not buscas.IsEmpty then
           dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
      end;
    end;

    if not (vDadosIni.vRegistro.vSisAutomacao) and (vDadosIni.vRegistro.vSisSupervisor) then
    begin
      if (trim(dataSet.FieldByName('END_COBRANCA').AsString) = '') then
        dataSet.FieldByName('END_COBRANCA').AsString := dataSet.FieldByName('ENDERECO').AsString;
      if (trim(dataSet.FieldByName('COD_BAIRRO_COBRANCA').AsString) = '') then
        dataSet.FieldByName('COD_BAIRRO_COBRANCA').AsInteger :=
          dataSet.FieldByName('COD_BAIRRO').AsInteger;
      if (trim(dataSet.FieldByName('CEP_COBRANCA').AsString) = '') then
        dataSet.FieldByName('CEP_COBRANCA').AsString := dataSet.FieldByName('CEP').AsString;
      if (trim(dataSet.FieldByName('COD_CIDADE_COBRANCA').AsString) = '') then
        dataSet.FieldByName('COD_CIDADE_COBRANCA').AsString :=
          dataSet.FieldByName('COD_CIDADE').AsString;
      if (trim(dataSet.FieldByName('EST_CODIGO_UF').AsString) = '') then
      begin
        dataSet.FieldByName('EST_CODIGO_UF').AsInteger :=
          dataSet.FieldByName('CODIGO_UF').AsInteger;

        if dataSet.FieldByName('CODIGO_UF').AsInteger > 0 then
        begin
          SqlOpen(' select codigo_uf, sigla_uf from estados ' +
            ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('CODIGO_UF').AsInteger), buscas);

          if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
            dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
        end;
      end;

      if (trim(dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString) = '') then
      	dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(dataSet.FieldByName('ESTADOS_UF').AsString);
    end;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

