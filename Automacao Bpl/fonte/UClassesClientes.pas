    Cheques.buscas.open;

    try
    	Cheques.buscas.DisableControls;
      Cheques.buscas.First;
      while not Cheques.buscas.eof do
      begin
        if Cheques.buscas.fieldbyname('TIP_BAIXA').asstring = 'D' then
          vtdevchq := vtdevchq + Cheques.buscas.FieldByName('VALOR_CH').Ascurrency;
        Cheques.buscas.next;
      end;
    finally
    	Cheques.buscas.EnableControls;
    end;
    Cheques.buscas.FieldByName('CODIGO_EMP').Visible := false;
    Cheques.buscas.FieldByName('COD_EMP_MULT').Visible := false;
    Cheques.buscas.FieldByName('COD_EMP_MULT').DisplayLabel := 'Cod Empresa';
    Cheques.buscas.FieldByName('IDENTIFICACAO_EMP').DisplayLabel := 'Empresa';
    Cheques.buscas.FieldByName('CODIGO_CH').DisplayLabel := 'Cod Cheque';
    Cheques.buscas.FieldByName('N_CH').DisplayLabel := 'Num Cheque';
    Cheques.buscas.FieldByName('DATA_REC').DisplayLabel := 'Data de Cadastro';
    Cheques.buscas.FieldByName('DATA_VENC').DisplayLabel := 'Data de Venc';
    Cheques.buscas.FieldByName('VALOR_CH').DisplayLabel := 'Valor';
    Cheques.buscas.FieldByName('DATQ_CH').DisplayLabel := 'Data quitação';
    Cheques.buscas.FieldByName('TIP_BAIXA').DisplayLabel := 'Tipo de Baixa';
    (Cheques.buscas.FieldByName('VALOR_CH') as tfloatfield).currency := true;
    Cheques.buscas.FieldByName('NOME_CTRL').DisplayLabel := 'Nome Controle';
    Cheques.buscas.FieldByName('DIAS_ATRASO').DisplayLabel := 'Dias Atraso';
    TFloatField(Cheques.buscas.FieldByName('DIAS_ATRASO')).DisplayFormat := '#,##0.00';

    Recibos.buscas.First;
    Creditos.buscas.First;
    Cheques.buscas.First;

    if Assigned(FrmSituacaoCx) then
    begin
    	if vVisualizarCreditosVenc then
      begin
      	FrmSituacaoCx.GbFiltrarCC.Visible := False;
        FrmSituacaoCx.GbFiltrarCC.Height := 0;
      end;
      if vVisualizarCreditosVenc then
      begin
      	FrmSituacaoCx.GbFiltrarCH.Enabled := False;
        FrmSituacaoCx.GbFiltrarCH.Height := 0;
      end;

      FrmSituacaoCx.Label117.Caption   := SituacaoCaixa[0];
      FrmSituacaoCx.Label118.Caption   := SituacaoCaixa[1];
      FrmSituacaoCx.Label121.Caption   := SituacaoCaixa[2];
      FrmSituacaoCx.Label122.Caption   := SituacaoCaixa[3];
      FrmSituacaoCx.Label8.Caption     := SituacaoCaixa[4];
      FrmSituacaoCx.Label10.Caption    := SituacaoCaixa[5];
      FrmSituacaoCx.LbDev.Caption      := format('%n', [vtdev]);
      FrmSituacaoCx.LbLiquido.Caption  := format('%n', [vtpg - vtdev]);
      FrmSituacaoCx.lbDevChq.Caption   := format('%n', [vtdevchq]);
      FrmSituacaoCx.LbLiqChq.Caption   := format('%n', [vtpgchq - vtdevchq]);
      FrmSituacaoCx.LbVencCred.Caption := format('%n', [vtotcredvenc]);
      FrmSituacaoCx.LbVencChq.Caption  := format('%n', [vtotchqvenc]);
    end;

    if (pExibirMensagem) and (possuiDebito) then
	    Application.MessageBox('Cliente com débito em atraso', 'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);

    Result := true;
  finally
  	vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TCadClientes.BarrarClientesOutrasFiliaisPeloCPFCNPJ;
var
  AList: TStrings;
  ACodigoEmpStr, ACodigoEmpStrIn: string;
  I, ACodigoEmp, ACodigoFaturamentoOld: Integer;
begin
  if (Trim(dataSet.FieldByName('cpfcgc').AsString) = '') or
    (not vDadosIni.getConfSisBool('cl_hab_faturamento_unico_entre_empresas', buscas)) then
    Exit;

  AList := TStringList.Create;
  try
    AList := vDadosIni.getConfSisBlob('cl_hab_faturamento_unico_entre_empresas', buscas);
    if Pos('EMPRESAS:', UpperCase(AList.Text)) = 0 then
      Exit;

    buscas.Close;
    buscas.SQL.Text := 'select cl.CODIGO_FATURAMENTO from CLIENTES cl' +
      ' where cl.COD_CLIENTE = ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
      ' and cl.COD_EMPRESA = ' + vDadosIni.codEmpresa;
    buscas.Open;

    ACodigoFaturamentoOld := buscas.FieldByName('CODIGO_FATURAMENTO').AsInteger;
    buscas.Close;

    if ACodigoFaturamentoOld = dataSet.FieldByName('CODIGO_FATURAMENTO').AsInteger then
      Exit;

    AList.Text := Copy(AList.Text, Pos('EMPRESAS:', UpperCase(AList.Text)) + 9, Length(AList.Text));
    AList := vDadosIni.SplitS(AList.Text, '|');

    ACodigoEmpStrIn := '';
    for I := 0 to AList.Count - 1 do
    begin
      ACodigoEmpStr := vDadosIni.apenasNumeros(AList[I]);
      if TryStrToInt(ACodigoEmpStr, ACodigoEmp) then
        if StrToInt(vDadosIni.codEmpresa) <> ACodigoEmp then
          ACodigoEmpStrIn := ACodigoEmpStrIn + IfThen(Trim(ACodigoEmpStrIn) = '', '(', ',') + IntToStr(ACodigoEmp);
    end;

    ACodigoEmpStrIn := ACodigoEmpStrIn + IfThen(Trim(ACodigoEmpStrIn) <> '', ')');
    if ACodigoEmpStrIn = '' then
      Exit;

    buscas.Close;
    buscas.SQL.Text := ' update clientes set CODIGO_FATURAMENTO = :CODIGO_FATURAMENTO' +
      ' where cpfcgc = :cpfcgc and cod_empresa in ' + ACodigoEmpStrIn;
    buscas.ParamByName('cpfcgc').AsString := Trim(dataSet.FieldByName('cpfcgc').AsString);
    buscas.ParamByName('CODIGO_FATURAMENTO').AsInteger := dataSet.FieldByName('CODIGO_FATURAMENTO').AsInteger;
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := ' update clientes set CODIGO_FATURAMENTO = :CODIGO_FATURAMENTO' +
      ' where cpfcgc = :cpfcgc and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger);
    buscas.ParamByName('cpfcgc').AsString := Trim(dataSet.FieldByName('cpfcgc').AsString);
    buscas.ParamByName('CODIGO_FATURAMENTO').AsInteger := dataSet.FieldByName('CODIGO_FATURAMENTO').AsInteger;
    buscas.ExecSQL;
  finally
    FreeAndNil(AList);
  end;
end;

function TCadClientes.DadosAdicionaisObrigatorios: boolean;
begin
  try
    Result := true;

     if dataSet.FieldByName('COD_TAB_PRECO').AsInteger > 0 then
      if not _existePrecTabCliente(dataSet.FieldByName('COD_TAB_PRECO').AsInteger) then
       raiseExceptionCreate('Preço de Tabela não encontrado!', 'DBEdit100');

//    if (pos(dataSet.FieldByName('TIPVCLIENTE').AsString, 'VACTLOP') = 0) and
     if not ExecutaComandosSql('select * from tipo_vendas where sigla = ''' + dataSet.FieldByName('TIPVCLIENTE').AsString + ''' and tipo = ''REQ'' and ativo = 1') and
     	(dataSet.FieldByName('TIPO').Asstring <> 'F') then
        raiseExceptionCreate(PChar('Tipo de Venda ''' + dataSet.FieldByName('TIPVCLIENTE').asstring + ''' Incorreto'), 'DBComboBox6');

     if Trim(dataSet.FieldByName('DESB_CL_CONTAS_QUIT').Asstring) <> '' then
       if (Trim(dataSet.FieldByName('DESB_CL_CONTAS_QUIT').Asstring) <> 'S') and
         (Trim(dataSet.FieldByName('DESB_CL_CONTAS_QUIT').Asstring) <> 'N') then
    	     raiseExceptionCreate('Campo "Desnegativar cliente ao quitar todas as contas" deve ser preenchido com "Sim" ou "Não"', 'DBComboBox12');

    if Trim(dataSet.FieldByName('BARRAMENTO_AUTOMATICO').Asstring) <> '' then
      if (Trim(dataSet.FieldByName('BARRAMENTO_AUTOMATICO').Asstring) <> 'S') and
        (Trim(dataSet.FieldByName('BARRAMENTO_AUTOMATICO').Asstring) <> 'N') then
        	raiseExceptionCreate('Campo "Barramento automático após vencimento" deve ser preenchido com "Sim" ou "Não"', 'DBComboBox18');

  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadClientes.DadosComplementaresObrigatorios: boolean;
begin
  try
    Result := true;
    if trim(dataSet.FieldByName('CEP_COBRANCA').AsString) = '' then
      if dataSet.FieldByName('TIPO').AsString = 'F' then
        raiseExceptionCreate('Endereço de cobrança do Fornecedor não informado (CEP)' + chr(13) + 'Campo Requerido.', 'DBEdit18')
      else
        raiseExceptionCreate('Endereço de cobrança do Cliente não informado (CEP)' + chr(13) + 'Campo Requerido.', 'DBEdit18');

    if Length(trim(dataSet.FieldByName('CEP_COBRANCA').AsString)) <> 8 then
      if dataSet.FieldByName('TIPO').AsString = 'F' then
        raiseExceptionCreate('Endereço de cobrança do Fornecedor incorreto (CEP)' + chr(13) + 'Campo Requerido.', 'DBEdit18')
      else
        raiseExceptionCreate('Endereço de cobrança do Cliente incorreto (CEP)' + chr(13) + 'Campo Requerido.', 'DBEdit18');

    if trim(dataSet.FieldByName('END_COBRANCA').AsString) = '' then
      if dataSet.FieldByName('TIPO').AsString = 'F' then
        raiseExceptionCreate('Endereço de cobrança do Fornecedor não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit15')
      else
        raiseExceptionCreate('Endereço de cobrança do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit15');

    if dataSet.FieldByName('COD_BAIRRO_COBRANCA').IsNull then
      raiseExceptionCreate('Bairro de cobrança não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit17');

    if not SetNomeBairroCobranca then
    begin
      vNomeCampoErro := 'DBEdit17';
      Result := False;
      exit;
    end;
    if not SetNomeCidadeCobranca then
    begin
      vNomeCampoErro := 'DBEdit16';
      Result := False;
      exit;
    end;
    if not SetNomeEstadoCobranca then
    begin
      vNomeCampoErro := 'DBLookupComboBox3';
      Result := False;
      exit;
    end;

    if dataSet.FieldByName('EST_CODIGO_UF').IsNull then
  	  raiseExceptionCreate('UF de cobrança não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox3');
 
  except
