{ TCadClientesTribAd }

function TCadClientesTribAd.Adicionar(Acod_trib_pf: Integer): Boolean;
var
  I: Integer;
  Aperfil: TProdutos_trib_pf_class;
begin
  Result := False;
  if Acod_trib_pf = 0 then
    Exit;

  for I := 0 to Self.Count - 1 do
    if Acod_trib_pf = Self.Items[I].cod_trib_pf then
      Exit;

  if not FOwner.SqlOpen('select %s from produtos_trib_pf' +
                        ' where cod_trib_pf = %d and cod_empresa = %s',
                        [TProdutos_trib_pf_class.GetFieldsSql(), Acod_trib_pf, vDadosIni.codEmpresa],
                         FOwner.buscas).IsEmpty then
  begin
    Self.New.SetValuesFrom(FOwner.buscas);
    Result := True;
  end;
end;

constructor TCadClientesTribAd.Create(Aowner: TCadClientes);
begin
  inherited Create;
  FOwner := Aowner;
  Fdest_seqid := 0;
  FlistOrig := TProdutos_trib_pf_classList.Create;
  FconsPerfis := TDataSet_OOP.Create(dtmAtivo.bancoHw);
  with FconsPerfis.dataSet do
  begin
    Close;
    CommandText := Format('select cod_trib_pf id, descricao_pf, sigla_uf "Siglas Estados", contribuinte, pessoa tipo_pessoa,' +
                          ' consumidor_final, cst_icms, codigo_nop "CFOP", aliq_intra, aliq_inter, mva, perc_red_prod perc_red,' +
                          ' fcp_aliq from produtos_trib_pf where cod_empresa = %s and ativo = 1 order by 1', [vDadosIni.codEmpresa]);
