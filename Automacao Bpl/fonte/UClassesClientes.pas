function TCSTMudCliente.post: boolean;
var
  acao: string;
begin
  try
    Result := false;

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;
    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    dataSet.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    dataSet.FieldByName('COD_CLIENTE').AsInteger := ClienteAtual;

    if trim(dataSet.FieldByName('CST_INTERNO').AsString) = '' then
      raiseExceptionCreate('CST Interno deve ser informado.', 'DBEDIT3');

    if trim(dataSet.FieldByName('CST_EXTERNO').AsString) = '' then
      raiseExceptionCreate('CST Externo deve ser informado.', 'DBEDIT4');

    if dataSet.FieldByName('CFOP_INTERNO').AsFloat = 0 then
      raiseExceptionCreate('CFOP Interno deve ser informado.', 'DBEDIT7');

    if not existeCFOP(dataSet.FieldByName('CFOP_INTERNO').AsFloat) then
      raiseExceptionCreate('CFOP não encontrado no cadastro ou não informado.', 'DBEDIT7');

    if dataSet.FieldByName('CFOP_EXTERNO').AsFloat = 0 then
      raiseExceptionCreate('CFOP Externo deve ser informado.', 'DBEDIT8');

    if not existeCFOP(dataSet.FieldByName('CFOP_EXTERNO').AsFloat) then
      raiseExceptionCreate('CFOP não encontrado no cadastro ou não informado.', 'DBEDIT8');

    if dataSet.FieldByName('ALIQ_INTERNA').AsFloat = 0 then
      dataSet.FieldByName('ALIQ_INTERNA').AsFloat := 0;
    if dataSet.FieldByName('ALIQ_EXTERNA').AsFloat = 0 then
      dataSet.FieldByName('ALIQ_EXTERNA').AsFloat := 0;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI161', acao, 'SUCESSO', 'CST_MUD_CLIENTE',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI161', acao, 'FALHA', 'CST_MUD_CLIENTE',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
    Refresh;
  except
    on e: exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCSTMudCliente.TestarCst(vCST: string): boolean;
begin
  TestarCst := true;
  if vcst = '' then
  begin
    Application.MessageBox('Cst Não Informado.', 'Informação', MB_OK + MB_ICONINFORMATION +
      MB_DEFBUTTON1);
    TestarCst := false;
  end
  else
  begin
    if copy(vcst, 1, 1) = '' then
    begin
      Application.MessageBox('Primeiro Digito Cst Incorreto.', 'Informação', MB_OK +
        MB_ICONINFORMATION + MB_DEFBUTTON1);
      TestarCst := false;
    end
    else
    begin
      if pos(copy(vcst, 1, 1), '012345678') = 0 then
      begin
        Application.MessageBox('Primeiro Digito Cst Incorreto.', 'Informação', MB_OK +
          MB_ICONINFORMATION + MB_DEFBUTTON1);
        TestarCst := false;
      end;
    end;
    if copy(vcst, 2, 1) = '' then
    begin
      Application.MessageBox('Segundo Digito Cst Incorreto.', 'Informação', MB_OK +
        MB_ICONINFORMATION + MB_DEFBUTTON1);
      TestarCst := false;
    end
    else
    begin
      if pos(copy(vcst, 2, 1), '012345679') = 0 then
      begin
        Application.MessageBox('Segundo Digito Cst Incorreto.', 'Informação', MB_OK +
          MB_ICONINFORMATION + MB_DEFBUTTON1);
        TestarCst := false;
      end;
    end;
    if copy(vcst, 3, 1) = '' then
    begin
      Application.MessageBox('Terceiro Digito Cst Incorreto.', 'Informação', MB_OK +
        MB_ICONINFORMATION + MB_DEFBUTTON1);
      TestarCst := false;
    end
    else
    begin
      if pos(copy(vcst, 3, 1), '01') = 0 then
      begin
        Application.MessageBox('Terceiro Digito Cst Incorreto.', 'Informação', MB_OK +
          MB_ICONINFORMATION + MB_DEFBUTTON1);
        TestarCst := false;
      end;
    end;
  end;
end;

