procedure TContaCorrenteClientes.DetContaCorrenteAfterScroll(DataSet: TDataSet);
begin
  if dataSet.IsEmpty then
  begin
    FrmCadClientes.TreeView1.Items.Clear;
    FrmCadClientes.PanelTreeView.Height := 0;
    exit;
  end;
  if (not dataSet.IsEmpty)
   and (trim(dataSet.FieldByName('JSONCLASSES').AsString) = '')
   and (vSaldosEmp.dataSet.IsEmpty) then
  begin
    FrmCadClientes.TreeView1.Items.Clear;
    FrmCadClientes.PanelTreeView.Height := 0;
    exit;
  end;
  if FrmCadClientes <> nil then
  begin
  	try
    	FrmCadClientes.TreeView1.Visible := False;

      if FrmCadClientes.PanelTreeView.Height > 0 then
        _GravaConfiguracoesInteger('FrmCadClientes.PanelTreeView.Height', FrmCadClientes.PanelTreeView.Height);

      vDadosIni.getPontosProgFidelidade(dataSet.FieldByName('JSONCLASSES').AsString, FrmCadClientes.TreeView1);
      FrmCadClientes.PanelTreeView.Height := IfThen(_LerConfiguracoesRegistroInteger('FrmCadClientes.PanelTreeView.Height') = 0,
        124, _LerConfiguracoesRegistroInteger('FrmCadClientes.PanelTreeView.Height'));
      FrmCadClientes.GroupBoxSaldosEmpresas.Width := IfThen(_LerConfiguracoesRegistroInteger('FrmCadClientes.GroupBoxSaldosEmpresas.Width') = 0,
        285, _LerConfiguracoesRegistroInteger('FrmCadClientes.GroupBoxSaldosEmpresas.Width'));

      if FrmCadClientes.PanelTreeView.Height < 124 then
        FrmCadClientes.PanelTreeView.Height := 124;
      if FrmCadClientes.GroupBoxSaldosEmpresas.Width < 285 then
        FrmCadClientes.GroupBoxSaldosEmpresas.Width := 285;
    finally
      FrmCadClientes.TreeView1.Visible := True;
    end;
  end;
end;

function TContaCorrenteClientes.estornarValeCompra: boolean;
var
 buscas2: TIBQuery;
 vcpf: string;
 vcodcliente: Integer;
 vpontosvale: Double;
 vnumvale: string;
 vsel: boolean;
begin
   vcodcliente := 0;
   vpontosvale := 0;
   vnumvale := '';
   vcpf := '';
   vsel := false;
   Result := true;
  try
     if not vDadosIni.PesqPros('CLI253', 'ESTORNAR VALE', '',
      'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
       Exit;

     buscas2 := TIBQuery.Create(Application);
     buscas2.Database := buscas.Database;
		 buscas2.Transaction := buscas.Transaction;

     vResgateValeCupom.dataSet.First;
     while not vResgateValeCupom.dataSet.Eof do
     begin
     	 if vResgateValeCupom.dataSet.FieldByName('SEL').AsString = 'S' then
         if not vsel then vsel := true;

       vResgateValeCupom.dataSet.Next;
     end;

     if not vsel then
     begin
       Application.MessageBox(pchar('Nenhum vale selecionado.'), 'Atenção', MB_ICONERROR + MB_OK);
       Result := false;
       exit;
     end;

     vResgateValeCupom.dataSet.First;
     while not vResgateValeCupom.dataSet.Eof do
     begin
       if vResgateValeCupom.dataSet.FieldByName('SEL').AsString = 'S' then
       begin
         buscas.Close;
         buscas.SQL.Text := ' SELECT CODIGO, NDOC FROM VALE_CUPONS '+
            ' WHERE CODIGO = :CODIGO AND ERP_API = :ERP_API AND COD_EMPRESA = :COD_EMPRESA ';
         buscas.ParamByName('CODIGO').AsString := vResgateValeCupom.dataSet.FieldByName('CODIGO').AsString;
         buscas.ParamByName('ERP_API').AsString := vResgateValeCupom.dataSet.FieldByName('ERP_API').AsString;
         buscas.ParamByName('COD_EMPRESA').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
         buscas.Open;

         if buscas.FieldByName('ndoc').AsInteger > 0 then
         begin
           Application.MessageBox(pchar('Vale ' + buscas.FieldByName('codigo').AsString +
              ' já foi utilizado, não é possível estornar.'), 'Atenção', MB_ICONERROR + MB_OK);
           Result := false;
           exit;
         end;

         vpontosvale := vResgateValeCupom.dataSet.FieldByName('PONTOS').AsFloat;
         vnumvale := vResgateValeCupom.dataSet.FieldByName('CODIGO').AsString;
         vcpf := vResgateValeCupom.dataSet.FieldByName('CPF').AsString;

         buscas.Close;
         buscas.SQL.Text := ' SELECT * FROM CONTA_CORRENTE_PROG_FIDELIDADE ' +
            ' WHERE NVALECUPOM = :NVALECUPOM AND ERP_API = :ERP_API AND COD_EMPRESA = :COD_EMPRESA ';
         buscas.ParamByName('NVALECUPOM').AsString := vResgateValeCupom.dataSet.FieldByName('CODIGO').AsString;
         buscas.ParamByName('ERP_API').AsString := vResgateValeCupom.dataSet.FieldByName('ERP_API').AsString;
         buscas.ParamByName('COD_EMPRESA').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
         buscas.Open;

         if buscas.IsEmpty then
         begin
           Application.MessageBox(pchar('Lançamento de origem do vale ' + buscas.FieldByName('codigo').AsString +
           		' não encontrado, não é possível estornar.'), 'Atenção', MB_ICONERROR + MB_OK);
           Result := false;
           exit;
         end;

         vcodcliente := buscas.FieldByName('COD_CLIENTE').AsInteger;

         buscas2.Close;
         buscas2.SQL.Text := ' UPDATE VALE_CUPONS SET NDOC = :NDOC, TIPODOC = :TIPODOC ' +
            ' WHERE CODIGO = :CODIGO AND ERP_API = :ERP_API AND COD_EMPRESA = :COD_EMPRESA ';
         buscas2.ParamByName('NDOC').AsInteger := buscas.FieldByName('CODIGO').AsInteger;
         buscas2.ParamByName('TIPODOC').AsString := 'EST';
         buscas2.ParamByName('CODIGO').AsString := vResgateValeCupom.dataSet.FieldByName('CODIGO').AsString;
         buscas2.ParamByName('ERP_API').AsString := vResgateValeCupom.dataSet.FieldByName('ERP_API').AsString;
         buscas2.ParamByName('COD_EMPRESA').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
         buscas2.ExecSQL;

         dataSet.Insert;
         dataSet.FieldByName('COD_EMPRESA').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
         dataSet.FieldByName('COD_EMP_RESP').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMPRESA').AsInteger;
         dataSet.FieldByName('COD_CLIENTE').AsInteger := buscas.FieldByName('COD_CLIENTE').AsInteger;
         dataSet.FieldByName('COD_TAXA_PROG_FID').AsInteger := buscas.FieldByName('COD_TAXA_PROG_FID').AsInteger;
         dataSet.FieldByName('DATA_VENC_PROG').AsDateTime := buscas.FieldByName('DATA_VENC_PROG').AsDateTime;
         dataSet.FieldByName('PERC_PROG_FID').AsFloat := buscas.FieldByName('PERC_PROG_FID').AsFloat;
         dataSet.FieldByName('DATA').AsDateTime := vDadosIni.getDataBanco(buscas2);
         dataSet.FieldByName('DATA_LANC').AsDateTime := vDadosIni.getDataBanco(buscas2);
         dataSet.FieldByName('CODIGO').AsInteger := Gencodigo('CONTA_CORRENTE_PROG_FIDELIDADE', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
         dataSet.FieldByName('TIPO').AsString := 'CRÉDITO';
         dataSet.FieldByName('DESCRICAO').AsString := trim(buscas.FieldByName('DESCRICAO').AsString);// + ' (ESTORNO)';
         dataSet.FieldByName('NVALECUPOM').AsString := vResgateValeCupom.fstr('CODIGO');
      //               dataSet.FieldByName('DESCRICAO').AsString := 'DÉBITO REF A ' +
      //                IfThen(trim(vtiporeq) = 'REQ', 'VENDA ',
      //                IfThen(trim(vtiporeq) = 'MOT', 'VENDA VEÍCULO ', 'ORDEM DE SERVIÇO ') ) + 'RESGATE Nº ' + IntToStr(vReq);
         dataSet.FieldByName('PONTOS').AsFloat := buscas.FieldByName('PONTOS').AsFloat;
         dataSet.FieldByName('VALOR').AsFloat := buscas.FieldByName('VALOR').AsFloat;
      //               dataSet.FieldByName('NDOC').AsInteger := vReq;
      //               dataSet.FieldByName('TIPODOC').AsString := vtiporeq;
    //     dataSet.FieldByName('VALE').AsString := 'S';
    //     dataSet.FieldByName('NVALECUPOM').AsInteger := vnumvale;


         if vResgateValeCupom.dataSet.FieldByName('NUM_DOC').AsInteger > 0 then
         begin
           dataSet.FieldByName('NDOC').AsInteger := vResgateValeCupom.dataSet.FieldByName('NUM_DOC').AsInteger;
           dataSet.FieldByName('TIPODOC').AsString := vResgateValeCupom.dataSet.FieldByName('TIPO_DOC').AsString;
           dataSet.FieldByName('COD_EMP_TIPODOC').AsInteger := vResgateValeCupom.dataSet.FieldByName('COD_EMP_DOC').AsInteger;
         end;

         dataSet.FieldByName('ERP_API').AsString := 'E';
         dataSet.Post;
    //     Apply;
       end;

       vResgateValeCupom.dataSet.Next;
     end;

     vResgateValeCupom.dataSet.First;

     if result then
       result := apply;

     if result then
       result := CommitaTransacao;

     if Result then
     begin
       vDadosIni.GravaAuditoria('CLI253', 'ESTORNAR VALE', 'SUCESSO - ' +
         'CLIENTE: ' + vDadosIni.IfThen(vcodcliente > 0, IntToStr(vcodcliente), vcpf) +
         ' VALE: ' + vnumvale + ' PONTOS: ' + FormatFloat('#,##0', vpontosvale),
         'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas);
       Application.MessageBox(pchar('Vale resgate estornado com sucesso '), 'Atenção', MB_ICONINFORMATION + MB_OK);
  //                 Application.MessageBox(pchar('Vale resgate para ' +
  //                    IfThen(vtiporeq = 'MOT', 'Comando de Faturamento', IfThen(vtiporeq = 'OS', 'Ordem de Serviço', 'Requisição')) +
  //                    ' Nº ' + IntToStr(vReq) + ' gerado com sucesso '), 'Atenção', MB_ICONINFORMATION + MB_OK);
     end
     else
     begin
       RollBackTransacao;
       vDadosIni.GravaAuditoria('CLI253', 'ESTORNAR VALE', 'FALHA - ' +
        'CLIENTE: ' + vDadosIni.IfThen(vcodcliente > 0, IntToStr(vcodcliente), vcpf) +
        ' VALE: ' + vnumvale + ' PONTOS: ' + FormatFloat('#,##0', vpontosvale),
        'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas);
       exit;
     end;
  except
    on e: Exception do
    begin
      Result := False;
      RollBackTransacao;
      Application.MessageBox(pchar('Erro ao estorna vale resgate: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro('Erro ao estorna vale resgate: ' + e.Message);
    end;
  end;
end;

function TContaCorrenteClientes.gerarValeCompra(pCodCliente: Integer; pCPFCGC: string;
  pTrocarMecadorias: boolean;
	pLabel: TLabel; pCadCliente: TCadClientes; pIniciar: boolean; Sender: TObject): boolean;
var
  vPontosVale: Double;
  vValorVale: Double;
  vReq, vPreVenda, vDav: Integer;
  vTiporeq: string;
  vValorReq: Double;
  vCOD_CLIENTE: Integer;
  vNOME_CLIENTE: string;
  buscasEmp, buscas2, buscas3: TIBQuery;
  APedVenda: TReg_PedVenda;
  ARegistros: TGeraRegistros;
  I, ACodVendedor: Integer;
  AFreteNaBase: Boolean;
  ANomeVend: string;
  vnumvale: Integer;
  vnitem: Integer;
  vEstoqueDisponivel: Double;

  vcod_empresa: Integer;

  vpontosrestante: Double;
  vpontoslancamentos: Double;
  vpontosempresa: Double;
  vpontostotalcliente: Double;

  vvalorrestante: Double;
  vvalorlancamentos: Double;
  vvalorempresa: Double;
  vvalortotalcliente: Double;

  vcodigoProgFid: Integer;
  vperiodoVencPtos: Integer;
  vpercProgFid: Double;
  vdataVencProgFid: TDateTime;
  vsel: boolean;
  vPesquisaReqOs: string;
  Config: TConfig_sistema_class;
begin
	 vReq := 0;
   vnumvale := 0;
   vtiporeq := '';

	 if vDadosIni.vProgFid.vHabilitarProgFid then
     //
   else if vDadosIni.vCashback.vHabilitarCashback then
   begin
     SqlOpen(' select vl.* from vale_cupons vl ' +
    	 ' left join empresa_prog_fid empg on vl.cod_empresa = empg.cod_empresa ' +
			 ' where vl.cpf = ' + QuotedStr(pCadCliente.dataSet.FieldByName('CPFCGC').AsString) +
       ' and vl.cod_empresa in (case when (empg.cod_empresa > 0) then empg.cod_empresa else ' + vDadosIni.codEmpresa + ' end) ' +
       ' and coalesce(vl.ndoc, 0) = 0 ', buscas);

     if not buscas.IsEmpty then
