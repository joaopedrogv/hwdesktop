function TCadClientes.AtualizarConveniados: boolean;
begin
  Result := True;

  if (dataset.FieldByName('CONVENIADO').AsString = 'S')
  and (dataset.FieldByName('COD_TAB_PRECO').AsInteger > 0) then
  begin
    buscas.Close;
    buscas.SQL.Text := 'SELECT * FROM CLIENTES ' +
     ' WHERE COD_EMPRESA = ' + vDadosIni.codEmpresa +
     ' AND COD_CONVENIO = ' + IntToStr(dataset.FieldByName('COD_CLIENTE').AsInteger) +
     ' AND COD_TAB_PRECO <> ' + IntToStr(dataset.FieldByName('COD_TAB_PRECO').AsInteger);
    buscas.Open;

    if not buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' UPDATE CLIENTES SET COD_TAB_PRECO = ' + IntToStr(dataset.FieldByName('COD_TAB_PRECO').AsInteger) +
        ' WHERE COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' AND COD_CONVENIO = ' + IntToStr(dataset.FieldByName('COD_CLIENTE').AsInteger) +
        ' AND COD_TAB_PRECO <> ' + IntToStr(dataset.FieldByName('COD_TAB_PRECO').AsInteger);
      buscas.ExecSQL;  
    end;
  end;

end;

