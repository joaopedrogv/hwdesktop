//             ' 	 1); ';
//           buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
//           buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
//           buscas.ParamByName('cod_empresa').AsInteger := vDadosIni.cod_empresa;
//           buscas.ParamByName('cod_grade').AsInteger := buscas2.FieldByName('cod_grade').AsInteger;
//           buscas.ParamByName('qtde').AsFloat := buscas2.FieldByName('quant_ped_item').AsFloat;
//           buscas.ExecSQL;
//
//           buscas2.Next;
//         end;
//       end;
     finally
       fTempContratos.EnableControls;
       vDadosIni.fechaStatusProcessamento;
     end;

     if vQtdeGerado > 0 then
     begin
       buscas.Close;
       buscas.SQL.Text := ' UPDATE OR INSERT INTO GERADOR_OSBOL ' +
       	  ' (COD_GERADOR, COD_EMPRESA, STATUS_GERADOR, ' +
          ' VALOR_GERADOR, VALOR_GERADO, VALOR_BOL_GERADOR, VALOR_BOL_GERADO, ' +
          ' DATA_BASE_DOC, DATA_GERADOR, MES_VENCIMENTO, ANO_VENCIMENTO, ' +
          ' DIA_FATURAMENTO_INI, DIA_FATURAMENTO_FIM, ' +
          ' STATUS_TMO, COD_VENDEDOR, COD_OP_CXL, COD_SUB_GRUPO, UTILIZA_CXL, ' +
          ' GERAR_BOLETO, GERAR_BOLETO_PROD_SERV, AGRUPAR_CONTR, DESCONS_CTRL, ' +
          ' QTDE_GERADOR, QTDE_GERADO) ' +
          ' VALUES (:COD_GERADOR, :COD_EMPRESA, :STATUS_GERADOR, ' +
          ' :VALOR_GERADOR, :VALOR_GERADO, :VALOR_BOL_GERADOR, :VALOR_BOL_GERADO, ' +
          ' :DATA_BASE_DOC, :DATA_GERADOR, :MES_VENCIMENTO, :ANO_VENCIMENTO, ' +
          ' :DIA_FATURAMENTO_INI, :DIA_FATURAMENTO_FIM, ' +
          ' :STATUS_TMO, :COD_VENDEDOR, :COD_OP_CXL, :COD_SUB_GRUPO, :UTILIZA_CXL, ' +
          ' :GERAR_BOLETO, :GERAR_BOLETO_PROD_SERV, :AGRUPAR_CONTR, :DESCONS_CTRL, ' +
          ' :QTDE_GERADOR, :QTDE_GERADO) ' +
          ' MATCHING (COD_GERADOR, COD_EMPRESA);';

       buscas.ParamByName('COD_GERADOR').AsInteger := vCodGerador;

       buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);

       buscas.ParamByName('STATUS_GERADOR').AsString := 'CONCLUIDO';

       buscas.ParamByName('VALOR_GERADOR').AsFloat := vValorGerador;

       buscas.ParamByName('VALOR_GERADO').AsFloat := vValorGerado;

       buscas.ParamByName('VALOR_BOL_GERADOR').AsFloat := vValorBolGerador;

       buscas.ParamByName('VALOR_BOL_GERADO').AsFloat := vValorBolGerado;

       buscas.ParamByName('QTDE_GERADOR').AsInteger := vQtdeGerador;

       buscas.ParamByName('QTDE_GERADO').AsInteger := vQtdeGerado;

       buscas.ParamByName('DATA_BASE_DOC').AsDateTime := vDATA_BASE_VENDA;

       buscas.ParamByName('DATA_GERADOR').AsDateTime := vDadosIni.getDataBanco(buscas2);

       buscas.ParamByName('MES_VENCIMENTO').AsInteger := vMES_VENCIMENTO;

       buscas.ParamByName('ANO_VENCIMENTO').AsInteger := vANO_VENCIMENTO;

       buscas.ParamByName('DIA_FATURAMENTO_INI').AsInteger := vDIAS_FAT_INI;

       buscas.ParamByName('DIA_FATURAMENTO_FIM').AsInteger := vDIAS_FAT_FIM;

       buscas.ParamByName('STATUS_TMO').AsString := trim(vSTATUS_TMO);

       buscas.ParamByName('COD_VENDEDOR').AsInteger := vCOD_COLABORADOR;

       buscas.ParamByName('COD_OP_CXL').AsInteger := vCOD_OP_CXL;

       buscas.ParamByName('COD_SUB_GRUPO').AsInteger := vSUB_GRUPO;

       buscas.ParamByName('UTILIZA_CXL').AsString := vDadosIni.IfThen(vUTILIZA_CXL, 'S', 'N');

       buscas.ParamByName('GERAR_BOLETO').AsString := vDadosIni.IfThen(vGERAR_BOLETO, 'S', 'N');

       buscas.ParamByName('GERAR_BOLETO_PROD_SERV').AsString := vDadosIni.IfThen(vGERAR_BOLETO_PROD_SERV, 'S', 'N');

       buscas.ParamByName('AGRUPAR_CONTR').AsString := vDadosIni.IfThen(vAGRUPAR_CONTRATOS, 'S', 'N');

       buscas.ParamByName('DESCONS_CTRL').AsString := vDadosIni.IfThen(vDESCONSIDERAR_REGRA_CTRL, 'S', 'N');

       buscas.ExecSQL;
     end;

     result := CommitaTransacao;
     if Result then
       vDadosIni.GravaAuditoria('CLI209', 'CONFIRMAR', 'SUCESSO', 'GERADOR_OSBOL', IntToStr(vCodGerador), buscas)
     else
       vDadosIni.GravaAuditoria('CLI209', 'CONFIRMAR', 'FALHA', 'GERADOR_OSBOL', IntToStr(vCodGerador),  buscas);

     if Result then
     begin
       if vQtdeGerado <= 0 then
       	 Application.MessageBox('Nenhum faturamento de contrato gerado!', 'Atenção', MB_ICONERROR + MB_OK)
       else
       begin
         if (vDadosIni.vEstoqueNegativo <> 'S') and (vExistemContratosNaoGerados) then
           Application.MessageBox('Processo concluído!', 'Atenção', 64)
         else
           Application.MessageBox('Processo concluído com sucesso!', 'Atenção', 64);

         if (vDadosIni.vEstoqueNegativo <> 'S') and (vExistemContratosNaoGerados) then
           Application.MessageBox('Alguns faturamentos dos contratos não foram gerados, favor verificar na aba "NÃO GERADOS"', 'Atenção', MB_ICONWARNING + MB_OK);
       end;
     end;
   finally
     fTempContratos.Filtered := False;
  
     if Assigned(vConf) then
       FreeAndNil(vConf);

     if Assigned(buscas2) then
       FreeAndNil(buscas2);

     if Assigned(buscas3) then
       FreeAndNil(buscas3);

     if Assigned(buscasC) then
       FreeAndNil(buscasC);

     if Assigned(fTempListaProdutos) then
       FreeAndNil(fTempListaProdutos);

     if Assigned(fTempListaCtrProdutos) then
       FreeAndNil(fTempListaCtrProdutos);

     if Assigned(fTempListaProdutosDtSource) then
       FreeAndNil(fTempListaProdutosDtSource);
   end;

  except on E: Exception do
    begin
      fTempContratos.Filtered := False;
      RollBackTransacao;
      Result := False;

      vDadosIni.GravaAuditoria('CLI209', 'CONFIRMAR', 'FALHA', 'GERADOR_OSBOL', IntToStr(vCodGerador), buscas);

      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

