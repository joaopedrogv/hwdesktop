procedure TCadClientes._addControlesFormaPagamento;
var
  vTempControle: Boolean;
  vTemp, vTempAnt: string;
  RecNo: Integer;
begin
  if not(dataSet.State in [dsinsert, dsEdit]) then
    Exit;

  if not vDadosIni.PesqPros('CLI186', 'ALTERAR', '', 'CLIENTES',
    dataSet.FieldByName('COD_CLIENTE').AsString, buscas, True) then
    Exit;

  vControles.storeRecNo;

  vControles.Edit;
  if (Trim(vControles.fstr('fp_padrao_cl')) = 'T') then
  begin
  	if Trim(vControles.fstr('sel')) = 'S' then //Registro marcado
    begin
	  	vControles.dataSet.FieldByName('ordem').AsInteger := 2;
  		vControles.dataSet.FieldByName('sel').AsString := 'T';
    end
    else //Registro desmarcado
    begin
    	vControles.dataSet.FieldByName('ordem').AsInteger := 1;
  		vControles.dataSet.FieldByName('sel').AsString := 'S';
    end;
  end
  else if (Trim(vControles.fstr('sel')) = 'S') then //Registro marcado
  begin
    vControles.dataSet.FieldByName('ordem').AsInteger := 3;
    vControles.dataSet.FieldByName('sel').AsString := 'Z';
  end
  else //Registro desmarcado
  begin
    vControles.dataSet.FieldByName('ordem').AsInteger := 1;
    vControles.dataSet.FieldByName('sel').AsString := 'S';
  end;
  vControles.Post;

  vControles.prepare_loop('', [ol_disableControls, ol_go_first] );
  try
    vTemp := '';
    vControles.First;
    while not vControles.Eof do
    begin
      if vControles.fstr('sel') = 'S' then
        vTemp := vTemp + IntToStr(vControles.dataSet.FieldByName('codigo_ctrl').AsInteger) + ',';
      vControles.Next;
    end;
  finally
    vControles.prepare_loop_done();
    vControles.restoreRecNo;
    vControles.dataSet.IndexFieldNames := 'ORDEM; QSEQPERF';
    vControles.First;
  end;

  if vTemp <> '' then
  begin
    vTemp := Copy(vTemp, 1, Length(vTemp) - 1);

    vTemp := '(' + vTemp + ')';
  end;

  vTempAnt := Trim(dataSet.FieldByName('controles_fp').AsString);

  dataSet.FieldByName('controles_fp').AsString := vTemp;

  vDadosIni.GravaAuditoria('CLI186', 'ALTERAR', 'ANTERIOR: ' + vTempAnt + ' NOVO: '+vTemp , 'CLIENTES',
    dataSet.FieldByName('COD_CLIENTE').AsString, buscas);
end;

