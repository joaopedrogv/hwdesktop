function TGeradorOS._abreFormEnviarContratosClientes(Tipoform,
  pCodGerador: Integer): boolean;
begin
  try
    if not vDadosIni.PesqPros('CLI215', 'ABRIR', '', 'PEDVENDA ',
      dataSet.FieldByName('COD_GERADOR').AsString, buscas, true) then
      Exit;

    vDadosIni.abreStatusProcessamento('', 'Abrindo Contratos Gerados, código do gerador ' + IntToStr(pCodGerador) + ' ...');

    vDadosIni.vTipoForm := TipoForm;
    if DtmClientes = nil then
      DtmClientes := TDtmClientes.Create(DtmClientes);

    if frmEnviarContratosClientes = nil then
    begin
      if TipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TfrmEnviarContratosClientes, frmEnviarContratosClientes);
    end;

    if not frmEnviarContratosClientes.DBGrid1.DataSource.DataSet.IsEmpty then
    	if trim(vDadosIni.apenasNumeros(frmEnviarContratosClientes.Caption)) <> '' then
        if pCodGerador <> StrToInt(trim(vDadosIni.apenasNumeros(frmEnviarContratosClientes.Caption))) then
        	if not (frmEnviarContratosClientes.DBGrid1.DataSource.DataSet.State in [dsInsert, dsEdit]) then
        		frmEnviarContratosClientes.DBGrid1.DataSource.DataSet.Close;

    frmEnviarContratosClientes.Caption := 'Imprimir/Enviar Contratos Gerados:' + ' ' + IntToStr(pCodGerador);
    frmEnviarContratosClientes.Tag := pCodGerador;
    frmEnviarContratosClientes.vCodGerador := pCodGerador;

    if (TipoForm > 0) and (not frmEnviarContratosClientes.Visible) then
    	frmEnviarContratosClientes.ShowModal
    else if (not frmEnviarContratosClientes.Visible) then
    	frmEnviarContratosClientes.Show
    else if frmEnviarContratosClientes.FormStyle = fsMDIChild then
      frmEnviarContratosClientes.Show
    else
      frmEnviarContratosClientes.ShowModal;
  finally
     vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TGeradorOS._desmarcaLinha(DtSet: TDataSet);
begin
  if DtSet.IsEmpty then
    exit;

  vContrSel := vContrSel - 1;

  DtSet.Edit;
  DtSet.FieldByName('SEL').AsString := '';
  DtSet.Post;
end;

procedure TGeradorOS._desmarcarTodos(DtSet: TDataSet);
var
	vRecno: Integer;
begin
  try
  	vContrSel := 0;
    
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');
    DtSet.DisableControls;

    vRecno := DtSet.RecNo;
    DtSet.First;
    while not DtSet.Eof do
    begin
      DtSet.Edit;
      DtSet.FieldByName('sel').AsString := '';
      DtSet.Post;
      DtSet.Next;
    end;

  finally
    DtSet.RecNo := vRecno;
    DtSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end
end;

