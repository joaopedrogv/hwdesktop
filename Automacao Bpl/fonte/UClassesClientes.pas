  DtmClientes.RdpFichaCliente.Imp(linha, 30, 'Fantasia: ' +
    dataSet.FieldByName('NOME_CLIENTE').AsString);
  linha := linha + 1;
  DtmClientes.RdpFichaCliente.Imp(linha, 1, 'Contato.: ' + dataSet.FieldByName('CONTATO').asstring);
  DtmClientes.RdpFichaCliente.Imp(linha, 30, 'Insc.Est: ' +
    dataSet.FieldByName('INSC_EST').asstring);
  linha := linha + 1;
  DtmClientes.RdpFichaCliente.Imp(linha, 1, 'CPF/CNPJ: ' + dataSet.FieldByName('CPFCGC').asstring);
  DtmClientes.RdpFichaCliente.Imp(linha, 30, 'RG......: ' + dataSet.FieldByName('RG').asstring);
  linha := linha + 1;
