          if (not vAGRUPAR_CONTRATOS) then
          begin
            fTempContratos.FieldByName('COD_CONTRATO').AsInteger := buscas.FieldByName('COD_CONTRATO').AsInteger;
            fTempContratos.FieldByName('DESCR_CONTRATO').AsString := UpperCase(trim(buscas.FieldByName('DESCR_CONTRATO').AsString));
          end;

