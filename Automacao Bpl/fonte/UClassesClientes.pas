function TEnviarContratosClientes._abreFormOpcoesEnvioNFSeBoleto(pCodGerador: Integer): boolean;
var
  formulario: TfrmPadrao;
  I: Integer;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 832;
    formulario.Height := 525;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Opções de Envio NFS, NF, Recibo Locação e Boleto: ' + IntToStr(pCodGerador);
    frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.KeyPreview := True;
    formulario.ShowHint := True;
    formulario.BorderIcons := [];

    frmEnviarContratosClientes.SpeedButton9.Visible := vDadosIni.vHwCloudIA.vUsarServMensageria <> 'S';

    frmEnviarContratosClientes.ckNFS.Checked            := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckNFS.Name, True);
    frmEnviarContratosClientes.ckNF.Checked             := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckNF.Name);
    frmEnviarContratosClientes.ckRecibo.Checked         := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckRecibo.Name);
    frmEnviarContratosClientes.ckBoleto.Checked         := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckBoleto.Name);

    frmEnviarContratosClientes.ckImprimir.Checked       := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckImprimir.Name);
    frmEnviarContratosClientes.ckEnviar.Checked         := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckEnviar.Name, True);
  	 frmEnviarContratosClientes.ckGerarArqZipado.Checked := _LerConfiguracoesRegistroBoolean(frmEnviarContratosClientes.ckGerarArqZipado.Name);

    if frmEnviarContratosClientes.CheckListBoxAplicativo.Items.Count = 1 then
      frmEnviarContratosClientes.CheckListBoxAplicativo.Checked[0] := True
    else
    begin
      for I := 0 to frmEnviarContratosClientes.CheckListBoxAplicativo.Items.Count - 1 do
        frmEnviarContratosClientes.CheckListBoxAplicativo.Checked[I] :=
          _LerConfiguracoesRegistroBoolean(
            frmEnviarContratosClientes.CheckListBoxAplicativo.Name + trim(frmEnviarContratosClientes.CheckListBoxAplicativo.Items[I]), False);
    end;

    frmEnviarContratosClientes.GroupBoxAplicativo.Visible := (frmEnviarContratosClientes.ckEnviar.Visible) and (frmEnviarContratosClientes.ckEnviar.Checked);
    frmEnviarContratosClientes.CheckListBoxAplicativo.Visible := frmEnviarContratosClientes.GroupBoxAplicativo.Visible;

    frmEnviarContratosClientes.GroupBoxArquivoZip.Visible := (frmEnviarContratosClientes.ckGerarArqZipado.Visible) and (frmEnviarContratosClientes.ckGerarArqZipado.Checked);
    frmEnviarContratosClientes.EdArquivoZip.Text := _LerConfiguracoesRegistroString(frmEnviarContratosClientes.EdArquivoZip.Name);

    if (frmEnviarContratosClientes.GroupBoxAplicativo.Visible) and (frmEnviarContratosClientes.GroupBoxArquivoZip.Visible) then
      frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Height := 295
    else if frmEnviarContratosClientes.GroupBoxAplicativo.Visible then
      frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Height := 254
    else if frmEnviarContratosClientes.GroupBoxArquivoZip.Visible then
      frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Height := 193
    else
      frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Height := 152;

    result := (formulario.ShowModal = IDOK);

  finally
    if Result then
    begin
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckNFS.Name, frmEnviarContratosClientes.ckNFS.Checked);
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckNF.Name, frmEnviarContratosClientes.ckNF.Checked);
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckRecibo.Name, frmEnviarContratosClientes.ckRecibo.Checked);
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckBoleto.Name, frmEnviarContratosClientes.ckBoleto.Checked);

      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckImprimir.Name, frmEnviarContratosClientes.ckImprimir.Checked);
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckEnviar.Name, frmEnviarContratosClientes.ckEnviar.Checked);
      _GravaConfiguracoesBoolean(frmEnviarContratosClientes.ckGerarArqZipado.Name, frmEnviarContratosClientes.ckGerarArqZipado.Checked);

      for I := 0 to frmEnviarContratosClientes.CheckListBoxAplicativo.Items.Count - 1 do
      	_GravaConfiguracoesBoolean(
        	frmEnviarContratosClientes.CheckListBoxAplicativo.Name + trim(frmEnviarContratosClientes.CheckListBoxAplicativo.Items[I]),
        	frmEnviarContratosClientes.CheckListBoxAplicativo.Checked[I]);

      _GravaConfiguracoesString(frmEnviarContratosClientes.EdArquivoZip.Name, frmEnviarContratosClientes.EdArquivoZip.Text);
    end;
    frmEnviarContratosClientes.pnOpcoesEnviarNFSeBoleto.Parent := frmEnviarContratosClientes.TabSheet4;
    formulario.Free;
    formulario := nil;
  end;
end;

function TEnviarContratosClientes._defineSqlAdicional(
  pCodGerador: Integer): boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
begin
  result := true;
  REnviarContratos.vSqlAdicional :=
  	' VW_CONTRATOS_CL.TIPO = ''OS'' ' +
  	' AND VW_CONTRATOS_CL.COD_GERADOR = ' + IntToStr(pCodGerador);

  tempSql := '';
//  if (REnviarContratos.vCampo = 'Nome Cliente') then
//    tempSql := 'CLIENTES.NOME_CLIENTE '
//  else if (REnviarContratos.vCampo = 'Razao Cliente') then
//    tempSql := 'CLIENTES.RAZAO '
//  else if (REnviarContratos.vCampo = 'Email') then
//    tempSql := 'CLIENTES.EMAIL '
//  else if (REnviarContratos.vCampo = 'CPF / CNPJ') then
//  	tempSql := 'CLIENTES.CPFCGC '
//  else if (REnviarContratos.vCampo = 'Num Seq Boleto') then
//    tempSql := 'BOLETAS.N_SEQ_BOL '
//  else if (REnviarContratos.vCampo = 'Nosso Numero') then
//    tempSql := 'BOLETAS.NOSSO_NUMERO_BANCO '
//  else if (REnviarContratos.vCampo = 'Remessa Enviada') then
//    tempSql := 'BOLETAS.REMESSA_ENVIADA '
//  else if (REnviarContratos.vCampo = 'Cod Cobrebem') then
//    tempSql := 'BOLETAS.COD_COBREBEM '
//  else if REnviarContratos.vCampo = 'Html Boleto' then
//    tempSql := 'BOLETAS.HTMLBOLETO '
//  else if REnviarContratos.vCampo = 'Email Bol' then
//    tempSql := 'BOLETAS.ENV_EMAIL_BOL '
//  else if REnviarContratos.vCampo = 'Data Email Bol' then
//  	tempSql := 'BOLETAS.DATA_EMAIL_BOL '
//  else if REnviarContratos.vCampo = 'WhatsApp Bol' then
//  	tempSql := 'BOLETAS.ENV_WHATSAPP_BOL'
//  else if REnviarContratos.vCampo = 'Data WhatsApp Bol' then
//  	tempSql := 'BOLETAS.DATA_WHATSAPP_BOL';

  if tempSql  <> '' then
  begin
    if REnviarContratos.vCondicao = 'Igual' then
      tempTipo := '= '
    else if REnviarContratos.vCondicao = 'Maior' then
      tempTipo := '> '
    else if REnviarContratos.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if REnviarContratos.vCondicao = 'Menor' then
      tempTipo := '< '
    else if REnviarContratos.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if REnviarContratos.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (REnviarContratos.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (REnviarContratos.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + REnviarContratos.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(REnviarContratos.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(REnviarContratos.vValor);
    REnviarContratos.vValor := '';
    if Trim(REnviarContratos.vSqlAdicional) <> '' then
      REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional + ' and ' + tempSql
    else
      REnviarContratos.vSqlAdicional := tempSql;
  end;

  if REnviarContratos.avancada then
  begin
    if (REnviarContratos.vPendNFS)
      or (REnviarContratos.vPendNF)
      or (REnviarContratos.vPendRecLoc)
      or (REnviarContratos.vPendBoleto) then
    begin
      REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional +
          ' and ';
      if (REnviarContratos.vPendNFS) then
        REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional +
          ' VW_CONTRATOS_CL.PEND_NFS = ''S'' '
      else if (REnviarContratos.vPendNFS) then
        REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional +
          ' VW_CONTRATOS_CL.PEND_NFS = ''S'' '
      else if (REnviarContratos.vPendRecLoc) then
        REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional +
          ' VW_CONTRATOS_CL.PEND_REC_LOC = ''S'' '
      else if (REnviarContratos.vPendBoleto) then
        REnviarContratos.vSqlAdicional := REnviarContratos.vSqlAdicional +
          ' VW_CONTRATOS_CL.PEND_BOLETO = ''S'' ';
    end;
  end;


  if REnviarContratos.vAdicional then
  begin
    if REnviarContratos.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(REnviarContratos.vDataIniAd);
      except
        REnviarContratos.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(REnviarContratos.vDataFimAd);
      except
        REnviarContratos.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if REnviarContratos.vDataIniAd <> '' then
          REnviarContratos.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(REnviarContratos.vDataIniAd)));
        if REnviarContratos.vDataFimAd <> '' then
          REnviarContratos.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(REnviarContratos.vDataFimAd)));
      end;
    end
    else if REnviarContratos.vValorAd = '' then
      exit;
    if REnviarContratos.vCondicaoAd = 'Igual' then
      REnviarContratos.vCondicaoAd := '='
    else if REnviarContratos.vCondicaoAd = 'Maior' then
      REnviarContratos.vCondicaoAd := '>'
    else if REnviarContratos.vCondicaoAd = 'Maior ou Igual' then
      REnviarContratos.vCondicaoAd := '>='
    else if REnviarContratos.vCondicaoAd = 'Menor' then
      REnviarContratos.vCondicaoAd := '<'
    else if REnviarContratos.vCondicaoAd = 'Menor ou Igual' then
      REnviarContratos.vCondicaoAd := '<='
    else if REnviarContratos.vCondicaoAd = 'Diferente' then
      REnviarContratos.vCondicaoAd := '<>'
    else if (REnviarContratos.vCondicaoAd = 'Esta contido') then
      REnviarContratos.vCondicaoAd := 'like'
    else if (REnviarContratos.vCondicaoAd = 'Começa') then
      REnviarContratos.vCondicaoAd := 'Começa'
    else
      REnviarContratos.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(REnviarContratos.vCampoAd) then
        begin
//          if REnviarContratos.vCampo = REnviarContratos.vCampoAd then
