function TCondPagClFor.selecionaCondPag(tipo: string): boolean;
begin
  if tipo = 'C' then
    montaSelect(' select 0 cod_cond_pag, '' '' desc_cond_pag from rdb$database ' +
    	' union ' +
    	' select cond_pag.cod_cond_pag, cond_pag.desc_cond_pag from cond_pag ' +
      ' inner join cond_pag_empresa on ' +
      '	  cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
      '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
      ' where cond_pag.natureza_cp <> ''C'' ' +
      ' and cond_pag.ativo = 1 ')
  else if tipo = 'F' then
    montaSelect(' select 0 cod_cond_pag, '' '' desc_cond_pag from rdb$database ' +
    	' union ' +
    	' select cond_pag.cod_cond_pag, cond_pag.desc_cond_pag from cond_pag ' +
      ' inner join cond_pag_empresa on ' +
      '	  cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
      '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
      ' where cond_pag.natureza_cp <> ''V'' ' +
      ' and cond_pag.ativo = 1 ')
  else
    montaSelect(' select 0 cod_cond_pag, '' '' desc_cond_pag from rdb$database ' +
    	' union ' +
    	' select cond_pag.cod_cond_pag, cond_pag.desc_cond_pag from cond_pag ' +
      ' inner join cond_pag_empresa on ' +
      '	  cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
      '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
      ' where cond_pag.ativo = 1 ');
end;

