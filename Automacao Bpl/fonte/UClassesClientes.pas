        '             ctr.cod_vendedor, ' +
        '             ctr.cod_controle, ' +
        '             ctr.tipo_os, ' +
        '							coalesce(ctr.contratos_cada_mes, 1), ' +
        '							:data_base_venda, ' +
                    	vDadosIni.IfThen(not vAGRUPAR_CONTRATOS, '0', '1') + ',' +
        							vDadosIni.IfThen(not vDESCONSIDERAR_REGRA_CTRL, '0', '1') + ') valor_ctr on 1 = 1 ' +
        ' left join retorna_valor_bol_ctr( ' +
        '             ctr.cod_contrato, ' +
        '             ctr.cod_empresa, ' +
        '             ctr.cod_cliente, ' +
        '             coalesce(ctr.dia_vencimento, 0), ' +
        '							coalesce(ctr.dias_apos_venc, 0), ' +
        '             ctr.cod_vendedor, ' +
        '             ctr.cod_controle, ' +
        '             ctr.tipo_os, ' +
        '							coalesce(ctr.contratos_cada_mes, 1), ' +
        '							:data_base_venda, ' +
        							vDadosIni.IfThen(not vAGRUPAR_CONTRATOS, '0', '1') + ',' +
        						  vDadosIni.IfThen(not vDESCONSIDERAR_REGRA_CTRL, '0', '1') + ') valor_bol on 1 = 1 ' +
        ' left join retorna_qtde_mes_ult_ger( ' +
        '             ctr.cod_contrato, ' +
        '             ctr.cod_empresa, ' +
        '             ctr.cod_cliente, ' +
        '							coalesce(ctr.dia_vencimento, 0), ' +
        '							coalesce(ctr.dias_apos_venc, 0), ' +
        '             ctr.cod_vendedor, ' +
        '             ctr.cod_controle, ' +
        '             ctr.tipo_os, ' +
        '							coalesce(ctr.contratos_cada_mes, 1), ' +
