  buscas.close;
end;

function TCadClientes.ValidaInscEstadual: boolean;
var
  resultado: integer;
begin
  resultado := ConsisteInscricaoEstadual(PChar(dataSet.FieldByName('INSC_EST').AsString),
    PChar(Cliente.RetornaUF(dataSet.FieldByName('CODIGO_UF').AsInteger)));
  if resultado <> 0 then
    result := false
  else
    result := true;
end;
function TCadClientes.validarCadastrosSimplificado: Boolean;
var
  vListaEmail: TStrings;
  vEmails: string;
  I: Integer;
  Field: TField;
begin
  try
    Result := false;

    if Trim(dataSet.FieldByName('razao').AsString) = '' then
      dataSet.FieldByName('razao').AsString := Trim(dataSet.FieldByName('nome_cliente').AsString);
    dataSet.FieldByName('nome_cliente').AsString := Trim(dataSet.FieldByName('nome_cliente').AsString);

    checkFieldEmpty('nome_cliente', 'Nome do cliente de preenchimento obrigatório', 'DBEdit111');

    if vDadosIni.vCliente.vConfCPF then
    begin
      checkFieldEmpty('cpfcgc', 'CPF/CNPJ do cliente de preenchimento obrigatório', 'DBEdit112');

      if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 11 then
      begin
        if not CPF(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
          raiseExceptionCreate('CPF do cliente inválido', 'DBEdit112');
      end
      else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 14 then
      begin
        if not CNPJ(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
          raiseExceptionCreate('CNPJ do cliente inválido', 'DBEdit112');
      end
      else
        raiseExceptionCreate('CPF/CNPJ do cliente inválido', 'DBEdit112');
    end
    else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 11 then
      if not CPF(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
        raiseExceptionCreate('CPF do cliente inválido', 'DBEdit112');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('cpfcgc').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF/CNPJ', 'DBEdit112');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('cpfcgc').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      begin
      	if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 11 then
        begin
        	if not CPF(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
            raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
              'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF válido', 'DBEdit112');
        end
      	else if Length(Trim(dataSet.FieldByName('cpfcgc').AsString)) = 14 then
        begin
        	if not CNPJ(Trim(dataSet.FieldByName('cpfcgc').AsString)) then
            raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
              'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CNPJ válido', 'DBEdit112');
        end
        else
          raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
            'Para sincronizar os cupons de desconto com E-Commerce é necessário informar CPF/CNPJ válido', 'DBEdit112');
      end;

    Field := dataSet.FieldByName('cep');
    if Field.AsString = '' then
      Field.AsString := vDadosIni.Replicate(' ', Field.Size)
    else if (Length(trim(Field.AsString)) <> 0) and (Length(trim(Field.AsString)) <> 8) then
      raiseExceptionCreate('CEP incorreto' + chr(13) + 'Deve conter 8 dígitos númericos', 'DBEdit114');
    Field := dataSet.FieldByName('endereco');
    if Field.AsString = '' then Field.AsString := vDadosIni.Replicate(' ', Field.Size);
    Field := dataSet.FieldByName('num_end_cliente');
    if Field.AsString = '' then Field.AsString := vDadosIni.Replicate(' ', Field.Size);
    Field := dataSet.FieldByName('bairro');
    if Field.AsString = '' then Field.AsString := vDadosIni.Replicate(' ', Field.Size);
    Field := dataSet.FieldByName('cidade');
    if Field.AsString = '' then Field.AsString := vDadosIni.Replicate(' ', Field.Size);
    Field := dataSet.FieldByName('codigo_uf');
    if Field.AsInteger = 0 then Field.AsInteger := vDadosIni.vEmp.vCodigo_Uf;
    Field := dataSet.FieldByName('est_codigo_uf');
    if Field.AsInteger = 0 then Field.AsInteger := vDadosIni.vEmp.vCodigo_Uf;

    {checkFieldEmpty('cep', 'CEP do endereço do cliente de preenchimento obrigatório', 'DBEdit114');

    if Length(trim(dataSet.FieldByName('CEP').AsString)) <> 8 then
      raiseExceptionCreate('CEP incorreto' + chr(13) + 'Campo Requerido.', 'DBEdit114');

    checkFieldEmpty('endereco', 'Logradouro do endereço do cliente de preenchimento obrigatório', 'DBEdit115');

    checkFieldEmpty('num_end_cliente', 'Número do endereço do cliente de preenchimento obrigatório', 'DBEdit116');

    checkFieldEmpty('bairro', 'Bairro do endereço do cliente de preenchimento obrigatório', 'DBEdit118');

    checkFieldEmpty('cidade', 'Cidade do endereço do cliente de preenchimento obrigatório', 'DBEdit119');

    checkFieldEmpty('codigo_uf', 'Estado do endereço do cliente de preenchimento obrigatório', 'DBLookupComboBox29');}

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('email').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar o e-mail', 'DBEdit126');
          
    if Trim(dataSet.FieldByName('email').AsString) <> '' then
    begin
      vEmails := StringReplace(LowerCase(Trim(dataSet.FieldByName('email').AsString)), ',', ';', [rfReplaceAll]);
      vListaEmail := TStringList.Create;
      vListaEmail.Clear;
      TStringList(vListaEmail).Sorted := True;
      TStringList(vListaEmail).Sort;
      TStringList(vListaEmail).Duplicates := dupIgnore;
      vListaEmail := vDadosIni.Split(vEmails, ';');
      for I := 0 to vListaEmail.Count - 1 do
        if Trim(vListaEmail[i]) <> '' then
          if not vDadosIni.validaTextoEMail2(Trim(vListaEmail[i])) then
            raiseExceptionCreate('email "' + Trim(vListaEmail[i]) + '" informado inválido', 'DBEdit126');
      dataSet.FieldByName('email').AsString := vEmails;

    	if vDadosIni.vEcommerce.vHabilitarEcommerce then
        if (trim(dataSet.FieldByName('email').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
        begin
        	if vListaEmail.Count > 1 then
	        	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
  	          'Para sincronizar os cupons de desconto com E-Commerce é necessário informar somente 1 e-mail, ' +
              'pois este email será utilizado para cadastrar/sincronizar os dados do cliente com o E-Commerce', 'DBEdit126');

        	for I := 0 to vListaEmail.Count - 1 do
		        if Trim(vListaEmail[i]) <> '' then
            begin
              buscas.Close;
              buscas.SQL.Text := 'select cod_cliente, cod_empresa, email from clientes ' +
                ' where cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and email = ' + QuotedStr(Trim(vListaEmail[i]));
              buscas.Open;

              if not buscas.IsEmpty then
              begin
                raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
                  'Para sincronizar os cupons de desconto com E-Commerce não deve existir outro cliente com o e-mail informado, ' +
                  'pois o E-Commerce não aceita clientes com o mesmo e-mail', 'DBEdit126');
              end;
            end;
        end;
    end;

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
	    if (trim(dataSet.FieldByName('fone_celular').AsString) = '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      	raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
        	'Para sincronizar os cupons de desconto com E-Commerce é necessário informar o telefone celular', 'DBEdit205');

    if vDadosIni.vEcommerce.vHabilitarEcommerce then
    begin
      if (trim(dataSet.FieldByName('fone_celular').AsString) <> '') and (CupomDescontoCliente.dataSet.RecordCount > 0) then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select cod_cliente, cod_empresa, fone_celular from clientes ' +
          ' where cod_cliente <> ' + IntToStr(dataSet.FieldByName('cod_cliente').AsInteger) +
          ' and cod_empresa = ' + vDadosIni.codEmpresa +
          ' and fone_celular = ' + QuotedStr(trim(dataSet.FieldByName('fone_celular').AsString));
        buscas.Open;

        if not buscas.IsEmpty then
          raiseExceptionCreate('Empresa utiliza o E-Commerce: '+ #13 + #13 +
            'Para sincronizar os cupons de desconto com E-Commerce não deve existir outro cliente com o telefone celular informado, ' +
            'pois o E-Commerce não aceita clientes com o mesmo telefone celular', 'DBEdit205');
      end;
    end;

    if vDadosIni.vCashback.vHabilitarCashback then
    begin
      if (trim(dataSet.FieldByName('CPFCGC').AsString) = '') and (trim(dataSet.FieldByName('FONE_CELULAR').AsString) = '') then
      	raiseExceptionCreate('Empresa utiliza o Programa de Cashback: '+ #13 + #13 +
        	'Para sincronizar os clientes é necessário informar CPF/CNPJ ou Celular', 'DBEdit112');
    end;

    if not TestaInscEstadual then
    begin
      vNomeCampoErro := 'DBEdit128';
      exit;
    end;

    if not ValidaInscEstadual then
    begin
      vNomeCampoErro := 'DBEdit128';
      exit;
    end;

    Result := True;

  except on E: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TCadClientes.validarCamposPersonalizados: Boolean;
var
  vLista, listOut: TStrings;
  I: Integer;
  fName: string;

  {$REGION 'handleErro'}
  procedure handleCampoErro;
  var
//    J: Integer;
    str: string;
  begin
    for str in listOut do
      if Trim(LowerCase(vDadosIni.getValue(str, 1))) = Trim(LowerCase(fName)) then
      begin
        vNomeCampoErro := vNomeCampoErro + ';' + vDadosIni.getValue(str, 3);
        Break;
      end;
  end;
  
  {$ENDREGION}

begin
  Result := True;
  vLista := TStringList.Create;
  if cadastroSimplificado then
  begin
	  vLista := vDadosIni.getConfSisBlob('cl_cad_simpl_campos_obrigatorios', buscas);
    listOut := vDadosIni.getConfSisBlob('cl_cad_campos_obrigatorios', buscas);
  end
  else
  begin
  	vLista := vDadosIni.getConfSisBlob('cl_cad_campos_obrigatorios', buscas);
    listOut := vDadosIni.getConfSisBlob('cl_cad_simpl_campos_obrigatorios', buscas);
  end;

  if vLista.Count = 0 then
    Exit;

  Result := False;
  try

    for I := 0 to vLista.Count - 1 do
      if I > 0 then
      begin
        fStrTmp := Trim(vDadosIni.getValue(vLista.Strings[I], 4));
        if dataset.FindField(vDadosIni.getValue(vLista.Strings[I], 1)) <> nil then
        begin
          fName := vDadosIni.getValue(vLista.Strings[I], 1);
          checkFieldEmpty(
            vDadosIni.getValue(vLista.Strings[I], 1),
            vDadosIni.getValue(vLista.Strings[I], 2),
            vDadosIni.getValue(vLista.Strings[I], 3));
        end;
      end;

    Result := True;

  except on E: Exception do
    begin
      Result := False;
      handleCampoErro;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

