function cl_abreCliente(ACodCliente: Integer): boolean;
var
  ACadCliente: TCadClientes;
begin
  Result := False;
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  ACadCliente := TCadClientes.create;

  try
  	ACadCliente.abreClientes(ACodCliente);
  finally
    vDadosIni.vPesquisa := '';
  end;
  Result := true;
end;

procedure cl_cadCliente(ATipoForm: integer);
begin
	try
  	if vDadosIni.getCampoPipe(vDadosIni.vPesquisa, 1) = 'ANIVERSARIANTE_CLIENTE' then
      vDadosIni.abreStatusProcessamento('', 'Verificando aniversariantes do dia')
    else
      vDadosIni.abreStatusProcessamento('', 'Abrindo Cadastro do cliente...');

    vDadosIni.vTipoForm := ATipoForm;
    if DtmClientes = nil then
      DtmClientes := TDtmClientes.Create(DtmClientes);

    if FrmCadClientes = nil then
    begin
      if ATipoForm > 0 then
        vDadosIni.vModalOuChild := 'M';
      Application.CreateForm(TFrmCadClientes, FrmCadClientes);
    end
    else if ATipoForm = 2 then
      vDadosIni.vTipoForm := 3;

    if (ATipoForm > 0) and (not FrmCadClientes.Visible) then
    	FrmCadClientes.ShowModal
    else if (not FrmCadClientes.Visible) then
      FrmCadClientes.Show
    else if FrmCadClientes.FormStyle = fsMDIChild then
      FrmCadClientes.Show
    else
    	FrmCadClientes.ShowModal;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function cl_abreSituacaoDeCaixa(
	ACodCliente: Integer;
  ASempreExibirFicha: Boolean;
  AVenda: Boolean;
  AMensagem: string): boolean;
var
  ACadCliente: TCadClientes;
begin
	Result := False;
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  ACadCliente := TCadClientes.create;

  ACadCliente.abreClientes(ACodCliente);

  Result := ACadCliente.SituacaoDeCaixa(ASempreExibirFicha, AVenda, AMensagem);
end;

function cl_abreExtrato_form(ACodCliente: Integer): boolean;
var
  ACadCliente: TCadClientes;
begin
  Result := False;
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  ACadCliente := TCadClientes.create;

  try
  	vDadosIni.vPesquisa := 'EXTRATO_CLIENTE|' + IntToStr(ACodCliente) + '|';
    ACadCliente.CadCliente(1);
  finally
    vDadosIni.vPesquisa := '';
  end;
  Result := true;
end;

function cl_abreFormValeResgateTroca(ACodCliente: Integer; ACPFCGC: string; pTrocarMecadorias: boolean): boolean;
var
  ACadCliente: TCadClientes;
begin
  Result := False;
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  ACadCliente := TCadClientes.create;

  if trim(ACPFCGC) = '' then
  begin
    ACadCliente.SqlOpen(' select cpfcgc from clientes ' +
      ' where cod_cliente = ' + IntToStr(ACodCliente) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa, ACadCliente.buscas);
    ACPFCGC := trim(ACadCliente.buscas.FieldByName('cpfcgc').AsString);
  end;

  Result := ACadCliente.abreFormValeResgateTroca(ACodCliente, ACPFCGC, pTrocarMecadorias, 'PROGFID|V|')
end;

function NovoPedidoViaContrato(APedido: NovoPedidoDados): Boolean;
begin
  if frmCadPedidoCompraClienteNfe <> nil then
    Result := frmCadPedidoCompraClienteNfe.NovoPedido(APedido)
  else
  begin
    Application.CreateForm(TfrmCadPedidoCompraClienteNfe, frmCadPedidoCompraClienteNfe);
    frmCadPedidoCompraClienteNfe.FormStyle := fsNormal;
    frmCadPedidoCompraClienteNfe.Visible := False;
    try
      Result := frmCadPedidoCompraClienteNfe.NovoPedido(APedido)
    finally
      frmCadPedidoCompraClienteNfe.EnableAlign;
      frmCadPedidoCompraClienteNfe.EnableAutoRange;
      frmCadPedidoCompraClienteNfe.Enabled := True;
    end;
  end;
end;

function AlterPedidoViaContrato(APedido: PedidoCompraDoContrato): Boolean;
begin
  if frmCadPedidoCompraClienteNfe <> nil then
    Result := frmCadPedidoCompraClienteNfe.AlterarPedido(APedido)
  else
  begin
    Application.CreateForm(TfrmCadPedidoCompraClienteNfe, frmCadPedidoCompraClienteNfe);
    frmCadPedidoCompraClienteNfe.FormStyle := fsNormal;
    frmCadPedidoCompraClienteNfe.Visible := False;
    try
      Result := frmCadPedidoCompraClienteNfe.AlterarPedido(APedido)
    finally
      frmCadPedidoCompraClienteNfe.EnableAlign;
      frmCadPedidoCompraClienteNfe.EnableAutoRange;
      frmCadPedidoCompraClienteNfe.Enabled := True;
    end;
  end;
end;

