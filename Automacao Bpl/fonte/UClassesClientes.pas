begin
//  if Length(FarrayRotas) > 0 then
    for I := Low(FarrayRotas) to High(FarrayRotas) do
      if Assigned(FarrayRotas[I]) then
      begin
        Arota := FarrayRotas[I];
        FreeAndNil(Arota);
      end;
  SetLength(FarrayRotas, 0);

  for I := Low(FarrayTribAd) to High(FarrayTribAd) do
    if Assigned(FarrayTribAd[I]) then
    begin
      AtribAd := FarrayTribAd[I];
      FreeAndNil(AtribAd);
    end;
  SetLength(FarrayTribAd, 0);

  dataSet.AfterScroll := nil;
  montaSelect('select * from clientes_end_doc_add' +
              ' where cod_cliente = ' + IntToStr(FOwer.dataSet.FieldByName('cod_cliente').AsInteger) +
              ' and cod_empresa = ' + IntToStr(FOwer.dataSet.FieldByName('cod_empresa').AsInteger) +
              ' and ativo = 1');
  storeRecNo;
  try
    dataSet.First;
    while not dataSet.Eof do
    begin

      {$REGION 'obtendo rotas'}
      Arota := TCadClientesRotas.Create(FOwer);
      Arota.Iniciar(f_int('seqid'));

      SetLength(FarrayRotas, Length(FarrayRotas) + 1);
      FarrayRotas[High(FarrayRotas)] := Arota;
      {$ENDREGION}

      {$REGION 'obtendo tributacao adicional'}
      AtribAd := TCadClientesTribAd.Create(FOwer);
      AtribAd.Iniciar(f_int('seqid'));

      SetLength(FarrayTribAd, Length(FarrayTribAd) + 1);
      FarrayTribAd[High(FarrayTribAd)] := AtribAd;
      {$ENDREGION}

      dataSet.Next;
    end;
  finally
    restoreRecNo;
  end;
  dataSet.AfterScroll := dataSetAfterScroll;
  dataSetAfterScroll(dataSet);
end;

function TCadClientesEndDocAdd.Apply: Boolean;
var
  I: Integer;
begin
  dataSet.DisableControls;
  try
    dataSet.First;
    while not dataSet.Eof do
    begin
      if dataSet.FieldByName('cod_cliente').AsInteger = 0 then
      begin
        dataSet.Edit;
        dataSet.FieldByName('cod_cliente').AsInteger := FOwer.dataSet.FieldByName('cod_cliente').AsInteger;
        dataSet.Post;
      end;
      dataSet.Next;
    end;
  finally
    dataSet.EnableControls;
  end;
  if dataSet.ChangeCount > 0 then
  begin
    Result := inherited Apply;
    dataSet.Refresh;
  end
  else
    Result := True;
  if Result then
  begin
    dataSet.AfterScroll := nil;
    for I := Low(FarrayRotas) to High(FarrayRotas) do
      FarrayRotas[I].Salvar;
      
    for I := Low(FarrayTribAd) to High(FarrayTribAd) do
      FarrayTribAd[I].Salvar;
  end;
end;

procedure TCadClientesEndDocAdd.ConsultaCEP(Awebservice: Boolean);
var
  Acep: TCEP;
  AretCEP: TCep_class;
begin
  if Trim(dataSet.FieldByName('cep').AsString) = '' then
    Exit;

  Acep := TCEP.create;
  try
    AretCEP := Acep.GetCEP(dataSet.FieldByName('cep').AsString);

    if (not Assigned(AretCEP)) and (Awebservice) then
      if Acep._ConsultarWebService(dataSet.FieldByName('cep').AsString) then
        AretCEP := Acep.GetCEP(dataSet.FieldByName('cep').AsString);

    if Assigned(AretCEP) then
    begin
      dataSet.FieldByName('XLGR').AsString        := AretCEP.endereco;
      dataSet.FieldByName('XBAIRRO').AsString     := AretCEP.bairro;
      dataSet.FieldByName('CMUN').AsInteger       := SqlOpen('select ibge_cod_cidade from cidades where cod_cidade = ' + IntToStr(AretCEP.cod_cidade)).FieldByName('ibge_cod_cidade').AsInteger;
      dataSet.FieldByName('COD_CIDADE').AsInteger := AretCEP.cod_cidade;
      dataSet.FieldByName('XMUN').AsString        := AretCEP.cidade;
      dataSet.FieldByName('UF').AsString          := AretCEP.sigla_estado;
      dataSet.FieldByName('CPAIS').AsInteger      := 1058;
      dataSet.FieldByName('XPAIS').AsString       := 'BRASIL';
    end;
  finally
    FreeAndNil(Acep);
  end;
end;

constructor TCadClientesEndDocAdd.Create(AOwer: TCadClientes);
begin
  inherited Create;

  if not Assigned(AOwer) then
    raise Exception.Create('Ower não referenciado');

  FOwer     := TCadClientes(AOwer);
  dataSet   := TClientDataSet(DtmClientes.cdsEndDocAdd);
  transacao := TIBTransaction(FOwer.transacao);
  Buscas    := TIBQuery(FOwer.buscas);

  FlkCidade    := TDadosLookUp_OOP.create;
  FlkBairro    := TDadosLookUp_OOP.create;
  FlkPais      := TDadosLookUp_OOP.create;
  FlkIndIEDest := TDadosLookUp_OOP.create;

  SetLength(FarrayRotas, 0);
  SetLength(FarrayTribAd, 0);
end;

procedure TCadClientesEndDocAdd.dataSetAfterScroll(DataSet: TDataSet);
var
  I: Integer;
begin
  Frotas := nil;
  for I := Low(FarrayRotas) to High(FarrayRotas) do
    if FarrayRotas[I].dest_seqid = f_int('seqid') then
    begin
      Frotas := FarrayRotas[I];
      Break;
    end;

  FtribAd := nil;
  for I := Low(FarrayTribAd) to High(FarrayTribAd) do
    if FarrayTribAd[I].dest_seqid = f_int('seqid') then
    begin
      FtribAd := FarrayTribAd[I];
      Break;
    end;

  if Assigned(FEndScroll) then
    FEndScroll;  
end;

function TCadClientesEndDocAdd.Delete: Boolean;
begin
  Result := False;
  if dataSet.IsEmpty then
    Exit
  else if dataSet.FieldByName('seqid').AsInteger <= 0 then
  begin
    dataSet.Delete;
    Result := True;
  end
  else if inherited Edit then
  begin
    dataSet.FieldByName('ativo').AsInteger := IfThen(dataSet.FieldByName('ativo').AsInteger = 0, 1);
    dataSet.Post;
    Result := True;
    if Assigned(Frotas) then
      while Frotas.Count > 0 do
        Frotas.Remover(vDadosIni.StrZero(Frotas.Items[0].cod_rota, 3));

    if Assigned(FtribAd) then
      while FtribAd.Count > 0 do
        FtribAd.Remover(FtribAd.Items[0].cod_trib_pf);
  end;
  if Assigned(FEndScroll) then
    FEndScroll;
end;

destructor TCadClientesEndDocAdd.Destroy;
begin
  if Assigned(FlkCidade) then
    FreeAndNil(FlkCidade);

  if Assigned(FlkBairro) then
    FreeAndNil(FlkBairro);
    
  if Assigned(FlkPais) then
    FreeAndNil(FlkPais);
    
  if Assigned(FlkIndIEDest) then
    FreeAndNil(FlkIndIEDest);
  inherited;
end;

function TCadClientesEndDocAdd.Edit: Boolean;
var
  I: Integer;
begin
  Result := inherited Edit;
  if not Result then
    Frotas := nil
  else
  begin
    for I := Low(FarrayRotas) to High(FarrayRotas) do
      if FarrayRotas[I].dest_seqid = f_int('seqid') then
      begin
        Frotas := FarrayRotas[I];
        Break;
      end;
      
    for I := Low(FarrayTribAd) to High(FarrayTribAd) do
      if FarrayTribAd[I].dest_seqid = f_int('seqid') then
      begin
        FtribAd := FarrayTribAd[I];
        Break;
      end;
  end;
end;

function TCadClientesEndDocAdd.Insert: Boolean;
begin
  Result := inherited Insert;
  if Result then
  begin
    dataSet.FieldByName('seqid').AsInteger     := 0 - dataSet.RecordCount;
    dataSet.FieldByName('ativo').AsInteger     := 1;
    dataSet.FieldByName('insc_est').AsString   := FOwer.dataSet.FieldByName('insc_est').AsString;
    dataSet.FieldByName('indiedest').AsInteger := FOwer.dataSet.FieldByName('nfe_indiedest').AsInteger;
    dataSet.FieldByName('im').AsString         := FOwer.dataSet.FieldByName('insc_municipal').AsString;
    dataSet.FieldByName('email').AsString      := FOwer.dataSet.FieldByName('email').AsString;
    dataSet.FieldByName('cpais').AsInteger     := FOwer.dataSet.FieldByName('cod_pais').AsInteger;
    dataSet.FieldByName('xpais').AsString      := SqlOpen('select nome_pais from paises' +
                                                          ' where cod_pais = ' + IntToStr(dataSet.FieldByName('cpais').AsInteger)).
                                                          FieldByName('nome_pais').AsString;
    dataSet.FieldByName('insc_est').AsString   := IfThen(f_str('insc_est') = '', 'ISENTO', f_str('insc_est'));
    dataSet.FieldByName('indiedest').AsInteger := IfThen(f_int('indiedest') > 0, f_int('indiedest'), IfThen(f_str('insc_est') = 'ISENTO', 9, 1));
  end;
end;

function TCadClientesEndDocAdd.Post: Boolean;
begin
  Result := False;
  try
    checkFieldEmpty('TIPO', 'Tipo precisa ser preenchido'      , 'DBedit201');
    checkFieldEmpty('CEP' , 'CEP precisa ser preenchido'       , 'DBedit332');
    checkFieldEmpty('XLGR', 'Logradouro precisa ser preenchido', 'DBedit333');

    if dataSet.FieldByName('UF').AsString <> 'EX' then
      if ConsisteInscricaoEstadual(PChar(dataSet.FieldByName('INSC_EST').AsString),
                                   PChar(dataSet.FieldByName('UF').AsString)) <> 0 then
      raiseExceptionCreate('Inscrição estadual incorreta para o estado selecionado', 'DBEdit328');

    dataSet.FieldByName('cod_cliente').AsInteger := FOwer.dataSet.FieldByName('cod_cliente').AsInteger;
    dataSet.FieldByName('cod_empresa').AsInteger := FOwer.dataSet.FieldByName('cod_empresa').AsInteger;

    Result := inherited Post;
    if Result and (Assigned(Frotas)) then
      Frotas.Salvar;
      
    if Result and (Assigned(FtribAd)) then
      FtribAd.Salvar;
    

  except on E: Exception do
    begin
      registraErro('TCadClientesEndDocAdd.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);    
    end;
  end;
end;

{ TDocProgFid }

function TDocProgFid.abreDocProgFid(pDataIni, pDataFim: string; pReq, pOS, pCf: boolean; pCodcliente: Integer): boolean;
var
  vtemp: string;
begin
  vtemp :=
   ' select pd.tipo, pd.nped ndoc, pd.data_ped data, pd.data_fech, pd.tipv tipo_venda, pd.valor_total, ' +
   ' pd.cod_vendedor, col.nome_vendedor, pd.cod_cliente, cl.nome_cliente,' +
   ' case when ((coalesce((select ndoc from existe_formas(pd.nped, pd.tipo, pd.cod_empresa)), 0)) > 0) then 1 else 0 end formas ' +
   ' 		from pedvenda pd ' +
   ' inner join colaborador col on col.cod_vendedor = pd.cod_vendedor and col.cod_empresa = pd.cod_empresa ' +
   ' inner join clientes cl on cl.cod_cliente = pd.cod_cliente and cl.cod_empresa = pd.cod_empresa ' +
   ' where pd.tipo = ''REQ'' and pd.data_fech >= :dtini and pd.data_fech <= :dtfim ' +
   ' and pd.cod_empresa = :cod_empresa and pd.status_ped = ''FECHADA'' ' +
   ' and pd.cod_cliente = :cod_cliente ' +
   ' union ' +
   ' select pd.tipo, pd.nped ndoc, pd.data_ped data, pd.data_fech, pd.tipo_os tipo_venda, pd.valor_total, ' +
   ' pd.cod_vendedor, col.nome_vendedor, pd.cod_cliente, cl.nome_cliente,' +
   ' case when ((coalesce((select ndoc from existe_formas(pd.nped, pd.tipo, pd.cod_empresa)), 0)) > 0) then 1 else 0 end formas ' +
   ' 		from pedvenda pd ' +
   ' inner join colaborador col on col.cod_vendedor = pd.cod_vendedor and col.cod_empresa = pd.cod_empresa ' +
   ' inner join clientes cl on cl.cod_cliente = pd.cod_cliente and cl.cod_empresa = pd.cod_empresa ' +
   ' where pd.tipo = ''OS'' and pd.data_fech >= :dtini and pd.data_fech <= :dtfim ' +
   ' and pd.cod_empresa = :cod_empresa and pd.status_ped = ''FECHADA'' ' +
   ' and pd.cod_cliente = :cod_cliente ' +
   ' union ' +
   ' select ''MOT'' tipo, cf.n_comando ndoc, cf.data_ven data, cf.data_fech, cf.tipo_v tipo_venda, cf.valtot_v valor_total, ' +
   ' cf.covend_v cod_vendedor, col.nome_vendedor, cf.clientes_v cod_cliente, cl.nome_cliente, ' +
   ' case when ((coalesce((select ndoc from existe_formas(cf.n_comando, ''MOT'', cf.cod_empresa)), 0)) > 0) then 1 else 0 end formas ' +
   ' 		from com_fat cf ' +
   ' inner join colaborador col on col.cod_vendedor = cf.covend_v and col.cod_empresa = cf.cod_empresa ' +
   ' inner join clientes cl on cl.cod_cliente = cf.clientes_v and cl.cod_empresa = cf.cod_empresa ' +
   ' where cf.natureza = ''S'' and cf.data_fech >= :dtini and cf.data_fech <= :dtfim ' +
   ' and cf.cod_empresa = :cod_empresa and cf.status_v = ''FECHADO'' ' +
   ' and cf.clientes_v = :cod_cliente ' +
   ' order by 4 desc, 2 desc, 1 asc  ';

  dataSet.Close;
  dataSet.CommandText := vtemp;
  dataSet.Params.ParamByName('dtini').AsString := pDataIni;
  dataSet.Params.ParamByName('dtfim').AsString := pDataFim;
  dataSet.Params.ParamByName('cod_cliente').AsInteger := pCodcliente;
  dataSet.Params.ParamByName('cod_empresa').AsInteger := StrToInt(vDadosIni.codEmpresa);
  dataSet.Open;

  dataSet.Filtered := false;
  if (pReq) or (pOS) or (pCf) then
  begin
    dataSet.Filter := 'trim(TIPO) in (';
    if pReq then
      dataSet.Filter := dataSet.Filter + '''REQ'', ';
    if pOS then
      dataSet.Filter := dataSet.Filter + '''OS'', ';
    if pCf then
      dataSet.Filter := dataSet.Filter + '''MOT'', ';
    dataSet.Filter := Copy(dataSet.Filter, 1, Length(dataSet.Filter) - 2) + ')';
    dataSet.Filtered := true;
  end;
  Result := not dataSet.IsEmpty;
  TFloatField(dataSet.FieldByName('VALOR_TOTAL')).DisplayFormat := '#,##0.00';
  TFloatField(dataSet.FieldByName('VALOR_TOTAL')).currency := true;
end;

constructor TDocProgFid.create;
begin
  DataSet := TClientDataSet(DtmClientes.cdsDocProgFid);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);
end;

function TDocProgFid.existePendencia(pRegrasValeCompraProgFid: TRegrasValeCompraProgFid): boolean;
var
  vValorCC: Double;
  vValor: string;
begin
   Result := true;

   vValor := FrmCadClientes.lbValorVale.Caption;
   vValor := StringReplace(vValor, 'R$', '', [rfReplaceAll]);

   if (trim(dataSet.FieldByName('tipo').AsString) = 'REQ') or (trim(dataSet.FieldByName('tipo').AsString) = 'OS') then
   begin
     SqlOpen(' select vale_troca from pedvenda ' +
       ' where nped = ' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) +
       ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
       ' and cod_empresa = ' + vDadosIni.codEmpresa);
     Result := trim(buscas.FieldByName('vale_troca').AsString) <> 'S';
     if not Result then
     begin
       Result := false;
       Application.MessageBox(pchar('Documento selecionado configurado como vale troca, favor verificar.'), 'Atenção', MB_ICONERROR + MB_OK);
       exit;
     end;
   end;

   SqlOpen(' select case when (count(ndoc) > 0) then 1 else 0 end formas from existe_formas  ' +
     '(' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) + ', ' +
   	QuotedStr(dataSet.FieldByName('tipo').AsString) + ', ' +
      vDadosIni.codEmpresa + ') ');
   Result := buscas.FieldByName('formas').AsInteger <= 0;
   if not Result then
   begin
     Result := false;
     Application.MessageBox(pchar('Documento selecionado possui formas de pagamento, favor verificar.'), 'Atenção', MB_ICONERROR + MB_OK);
     exit;
   end;

   SqlOpen(' select sum(coalesce(valor, 0)) valor from conta_corrente_prog_fidelidade ' +
   	' where ndoc = ' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) +
      ' and tipodoc = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
      ' and cod_emp_tipodoc = ' + vDadosIni.codEmpresa +
      ' and vale = ''S'' ');
   vValorCC := buscas.FieldByName('valor').AsFloat;

   if (vValorCC + vDadosIni.vTempValorResgateTroca > dataSet.FieldByName('VALOR_TOTAL').AsFloat) then
   begin
     Result := false;
     Application.MessageBox(pchar('Valor do(s) vale(s) informado(s) não pode(m) ser maior que o valor do documento selecionado: ' + #13 + #13 +
       'Valor do(s) vale(s).....: R$ ' + FormatFloat('#,##00.00', vValorCC + vDadosIni.vTempValorResgateTroca) + #13 +
       'Valor do documento: R$ ' +  FormatFloat('#,##0.00', dataSet.FieldByName('VALOR_TOTAL').AsFloat)),
       'Atenção', MB_ICONERROR + MB_OK);
     exit;
   end;

   if (trim(dataSet.FieldByName('tipo').AsString) = 'REQ') or (trim(dataSet.FieldByName('tipo').AsString) = 'OS') then
   begin
     SqlOpen(' select status_ped from pedvenda ' +
       ' where nped = ' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) +
       ' and tipo = ' + QuotedStr(dataSet.FieldByName('tipo').AsString) +
       ' and cod_empresa = ' + vDadosIni.codEmpresa);
     Result := trim(buscas.FieldByName('status_ped').AsString) = 'FECHADA';
   end
   else
   begin
     SqlOpen(' select status_v from com_fat ' +
     	 ' where n_comando = ' + IntToStr(dataSet.FieldByName('ndoc').AsInteger) +
       ' and cod_empresa = ' + vDadosIni.codEmpresa);
     Result := trim(buscas.FieldByName('status_v').AsString) = 'FECHADO';
   end;

   if not Result then
   begin
     Result := false;
     Application.MessageBox(pchar('Documento selecionado não esta fechado, favor verificar.'), 'Atenção', MB_ICONERROR + MB_OK);
     exit;
   end;
end;

{ TCadClientesRotas }

function TCadClientesRotas.Adicionar(var Arota: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  Arota := UpperCase(Arota);
  if (Length(Arota) <> 2) or
    ( vDadosIni.apenasLetras(Arota[1]) = '' ) or
    ( vDadosIni.apenasLetraseNumeros(Arota[2]) = '' ) then
  begin
    vDadosIni.ShowErro('Rota inválida. Por favor informe o primeiro caracter uma letra e o segundo um número. EX''s: A1, A2, A3, B1, C1, C2');
    Exit;
  end;

  Result := True;
  for I := 0 to Self.Count - 1 do
    if Self.Items[I].rota = Arota then
    begin
      Result := False;
      Exit;
    end;
  Self.New.rota := Arota;
end;

function TCadClientesRotas.Adicionar(Arota: TRotas_entr_class): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to Self.Count - 1 do
    if Arota.cod_rota = Self.Items[I].cod_rota then
      Exit;

  Result := True;
  Self.Add(Arota.Clone);
end;

constructor TCadClientesRotas.Create(Aowner: TCadClientes);
begin
  inherited Create;
  FOwner := Aowner;
  Fdest_seqid := 0;
  FlistOrig := TRotas_entr_classList.Create;
end;

destructor TCadClientesRotas.Destroy;
begin
  if Assigned(FlistOrig) then
  begin
    FlistOrig.Clear;
    FreeAndNil(FlistOrig);
  end;
  inherited;
end;

function TCadClientesRotas.GetRotasAtivas: TRotas_entr_classList;
begin
  Result := TRotas_entr_classList.Create;
  FOwner.SqlOpen('select ' + TRotas_entr_class.GetFieldsSql('re') + ' from ROTAS_ENTR re' +
                 ' where re.cod_empresa = %s ' +
                 ' order by re.rota',
                 [vDadosIni.codEmpresa], FOwner.buscas).First;
  while not FOwner.buscas.Eof do
  begin
    Result.New.SetValuesFrom(FOwner.buscas);
    FOwner.buscas.Next;
  end;
  FOwner.buscas.Close;
end;

procedure TCadClientesRotas.Iniciar(Adest_seqid: Integer);
begin
  Fdest_seqid := Adest_seqid;
  Self.Clear;
  FlistOrig.Clear;
  if FOwner.dataSet.State = dsEdit then
  begin
    FOwner.SqlOpen('select ' + TRotas_entr_class.GetFieldsSql('re') + ' from ROTAS_ENTR_CLIENTE rc' +
                   ' inner join rotas_entr re on re.cod_rota = rc.cod_rota and re.cod_empresa = rc.cod_empresa' +
                   ' where rc.cod_cliente = %d and rc.cod_empresa = %s and rc.end_doc_add_seqid %s %d' +
                   ' order by re.rota',
                   [FOwner.f_int('cod_cliente'), vDadosIni.codEmpresa, IfThen(Adest_seqid < 0, '<>', '=') , Fdest_seqid], FOwner.buscas).First;
    while not FOwner.buscas.Eof do
    begin
      Self.New.SetValuesFrom(FOwner.buscas);
      FlistOrig.New.SetValuesFrom(FOwner.buscas);
      FOwner.buscas.Next;
    end;
  end;
end;

function TCadClientesRotas.Remover(Arota: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to Self.Count - 1 do
    if Self.Items[I].cod_rota = StrToIntDef(Copy(Arota, 1, 3), 0) then
    begin
      Result := True;
      Self.Delete(I);
      Break;
    end;
end;

function TCadClientesRotas.Salvar: Boolean;
var
  AlistDel, AlistInsert: TRotas_entr_classList;
  I, J: Integer;
  AdoSomething: Boolean;
begin
  Result := True;
  AlistDel := TRotas_entr_classList.Create;
  AlistInsert := TRotas_entr_classList.Create;
  try
    //criando lista de insert
    for I := 0 to Self.Count - 1 do
    begin
      AdoSomething := True;
      for J := 0 to FlistOrig.Count - 1 do
        if Self.Items[I].cod_rota = FlistOrig.Items[J].cod_rota then
        begin
          AdoSomething := False;
          Break;
        end;
      if AdoSomething then
        AlistInsert.Add(Self.Items[I].Clone);
    end;

    // criando lista de delete
    for I := 0 to FlistOrig.Count - 1 do
    begin
      AdoSomething := True;
      for J := 0 to Self.Count - 1 do
      if FlistOrig.Items[I].cod_rota = Self.Items[J].cod_rota then
        begin
          AdoSomething := False;
          Break;
        end;
      if AdoSomething then
        AlistDel.Add(FlistOrig.Items[I].Clone);
    end;

    for I := 0 to AlistDel.Count - 1 do with AlistDel.Items[I] do
      FOwner.SqlExec('delete from ROTAS_ENTR_CLIENTE' +
                     ' where cod_rota = %d and cod_empresa = %d and cod_cliente = %d and end_doc_add_seqid = %d',
                     [cod_rota, cod_empresa, FOwner.f_int('cod_cliente'), Fdest_seqid]);

    for I := 0 to AlistInsert.Count - 1 do with AlistInsert.Items[I] do
      FOwner.SqlExec(Format('insert into ROTAS_ENTR_CLIENTE (cod_rota, cod_empresa, cod_cliente, end_doc_add_seqid) values (%d, %d, %d, %d)',
                     [cod_rota, cod_empresa, FOwner.f_int('cod_cliente'), Fdest_seqid]), FOwner.buscas);
