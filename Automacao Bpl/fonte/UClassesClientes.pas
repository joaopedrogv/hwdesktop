          if (buscas.FieldByName('LIMITE_CREDITO').AsFloat > 0)
          	and (RoundTo(buscas.FieldByName('VALOR_CONTRATO').AsFloat +
                         buscas.FieldByName('VALOR_CRED_ABERTO').AsFloat +
                         buscas.FieldByName('VALOR_CHQ_ABERTO').AsFloat
            	   , -2)
            	> RoundTo(buscas.FieldByName('LIMITE_CREDITO').AsFloat, - 2)) then
          				fTempContratos.FieldByName('LIMITE_CREDITO_ESTOURADO').AsString := 'S'
          else
          				fTempContratos.FieldByName('LIMITE_CREDITO_ESTOURADO').AsString := 'N';

          if buscas.FieldByName('VALOR_CRED_VENC').AsFloat > 0 then
        		fTempContratos.FieldByName('COM_DEBITO').AsString := 'S'
          else if buscas.FieldByName('VALOR_CHQ_VENC').AsFloat > 0 then
          	fTempContratos.FieldByName('COM_DEBITO').AsString := 'S'
          else
          	fTempContratos.FieldByName('COM_DEBITO').AsString := 'N';

          fTempContratos.FieldByName('CODIGO_FATURAMENTO').AsInteger := buscas.FieldByName('CODIGO_FATURAMENTO').AsInteger;
          fTempContratos.FieldByName('DESC_FAT').AsString := buscas.FieldByName('DESC_FAT').AsString;
          fTempContratos.FieldByName('STATUS_F').AsString := buscas.FieldByName('STATUS_F').AsString;

          fTempContratos.FieldByName('NOME_VENDEDOR').AsString := UpperCase(trim(buscas.FieldByName('NOME_VENDEDOR').AsString));
          fTempContratos.FieldByName('NOME_CTRL').AsString := UpperCase(trim(buscas.FieldByName('NOME_CTRL').AsString));

          fTempContratos.FieldByName('VALOR_CRED_ABERTO').AsFloat := buscas.FieldByName('VALOR_CRED_ABERTO').AsFloat;
          fTempContratos.FieldByName('VALOR_CHQ_ABERTO').AsFloat := buscas.FieldByName('VALOR_CHQ_ABERTO').AsFloat;
          fTempContratos.FieldByName('VALOR_REC_ABERTO').AsFloat := buscas.FieldByName('VALOR_REC_ABERTO').AsFloat;

          fTempContratos.FieldByName('VALOR_CRED_VENC').AsFloat := buscas.FieldByName('VALOR_CRED_VENC').AsFloat;
          fTempContratos.FieldByName('VALOR_CHQ_VENC').AsFloat := buscas.FieldByName('VALOR_CHQ_VENC').AsFloat;

          fTempContratos.FieldByName('VALOR_CONTRATO').AsFloat := buscas.FieldByName('VALOR_CONTRATO').AsFloat;
          fTempContratos.FieldByName('VALOR_PROD').AsFloat := buscas.FieldByName('VALOR_PROD').AsFloat;
          fTempContratos.FieldByName('VALOR_SERV').AsFloat := buscas.FieldByName('VALOR_SERV').AsFloat;
          fTempContratos.FieldByName('VALOR_BOLETO').AsFloat := buscas.FieldByName('VALOR_BOLETO').AsFloat;
          fTempContratos.FieldByName('COD_CONTROLE').AsInteger := buscas.FieldByName('COD_CONTROLE').AsInteger;
          fTempContratos.FieldByName('DOCS').AsString := buscas.FieldByName('DOCS').AsString;

          if buscas.FieldByName('DIAS_APOS_VENC').AsInteger > 0 then
          	vdataVenc := vDataBanco + buscas.FieldByName('DIAS_APOS_VENC').AsInteger
          else
          begin
            if not TryEncodeDate(vANO_VENCIMENTO, vMES_VENCIMENTO, buscas.FieldByName('DIA_VENCIMENTO').AsInteger, vdataVenc) then
              vdataVenc := EndOfTheMonth(EncodeDate(vANO_VENCIMENTO, vMES_VENCIMENTO, 1));
          end;

