function TContratosComClientes._abrirEquipamentos: Boolean;
begin
  buscas.Close;
  buscas.SQL.Text :=
    ' select e.cod_equip "Codigo", ' +
    ' coalesce(e.vlr_equi,0) "Valor", ' +
    ' e.nom_equip "Equipamento", ' +
    ' e.n_serie "N° Série",' +
    ' e.modelo "Modelo", ' +
    ' e.marca "Marca" from equipamento e' +
    ' where e.tip_equip = ''E'' ' +
    ' and e.cod_prop = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
    ' and e.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and comcontrato = ''S'' ' +
    ' and e.ativo = 1';
  buscas.Open;

  TFloatField(buscas.FieldByName('valor')).DisplayFormat := '##0.00';

  vSoma := 0;

  buscas.First;
  while not buscas.Eof do
  begin
    vSoma := vSoma + buscas.FieldByName('valor').AsFloat;
    buscas.Next;
  end;
  buscas.First;

//  FrmCadClientes.Label144.Caption := Format('%0.2f', [vSoma]);
  frmCadContratosClientes.Label144.Caption := Format('%0.2f', [vSoma]);
end;

function TContratosComClientes._excluirDadosContrato: Boolean;
var
	vCodContrato: Integer;
  vNomeCliente: string;
  vRazaoCliente: string;
  vTipoContrato: string;
  vValor: Double;
begin
  if not dataSet.Active then
    Exit;

  if dataSet.IsEmpty then
    Exit;

  try
  	vCodContrato := dataSet.FieldByName('COD_CONTRATO').AsInteger;
    vNomeCliente := trim(dataSet.FieldByName('NOME_CLIENTE').AsString);
    vRazaoCliente := trim(dataSet.FieldByName('RAZAO').AsString);
    vTipoContrato := trim(dataSet.FieldByName('DESC_SERVICO').AsString);
    vValor := dataSet.FieldByName('VALOR_CONTRATO').AsFloat;

    prepare_loop('SEL = ''S''');
    if not dataset.IsEmpty then
    begin
    	vCodContrato := 0;
      vNomeCliente := '';
      vRazaoCliente := '';
      vTipoContrato := '';
      vValor := 0;
    end;
  finally
    prepare_loop_done;
  end;

  try
  	try
      if vCodContrato > 0 then
        prepare_loop('COD_CONTRATO = ' + IntToStr(vCodContrato))
      else
        prepare_loop('SEL = ''S''');

      if vCodContrato > 0 then
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja excluir este contrato?' + #13 + #13 +
          'CONTRATO' + #13 +
          'Cod Contrato: ' + IntToStr(vCodContrato) + #13+
          'Cliente (Nome Fantasia): ' + trim(vNomeCliente) + #13 +
          'Cliente (Razão Social): ' + trim(vRazaoCliente) + #13 +
          'Valor Contrato: ' + FormatFloat('0.00', vValor)),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
            Exit;
      end
      else
      begin
        if Application.MessageBox(PChar('Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' contratos selecionados?'),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
          Exit;
      end;

      if not vDadosIni.PesqPros('CLI176', 'EXCLUIR', '', 'CLIENTES_COM_CONTRATO', '', buscas, true) then
        Exit;

      try
        dataset.DisableControls;
        dataset.First;
        while not dataset.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Excluíndo contratos (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          buscas.Close;
          buscas.SQL.Text := ' delete from clientes_com_contrato ' +
            ' where cod_contrato = ' + IntToStr(dataSet.FieldByName('COD_CONTRATO').AsInteger) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa;
          buscas.ExecSQL;

          vDadosIni.GravaAuditoria('CLI176', 'EXCLUIR', '', 'CLIENTES_COM_CONTRATO',
            dataSet.FieldByName('COD_CONTRATO').AsString, buscas);

          dataset.Next;
        end;
      finally
        dataset.EnableControls;
      end;
    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;

    CommitaTransacao;

    Result := True;

    if Result then
      vDadosIni.GravaAuditoria('CLI176', 'EXCLUIR', 'SUCESSO', 'CLIENTES_COM_CONTRATO', '', buscas);

//    _selecionaContratos(vCOD_CLIENTE);
	  dataSet.Refresh;

  except on E: Exception do
    begin                                                                      
      Result := False;
      vDadosIni.GravaAuditoria('CLI176', 'EXCLUIR', 'FALHA', 'CLIENTES_COM_CONTRATO',
      	vDadosIni.IfThen(vCodContrato > 0, IntToStr(vCodContrato), ''), buscas);
      Application.MessageBox(pchar('Erro ao excluir contrato. Erro: ' + e.Message), 'Atenção', 0 + 64);
    end;
  end;
end;

function TContratosComClientes._salvarDadosContrato: Boolean;
var
	vCodContratoTmp: Integer;
begin
  try
    Result := False;

    vCodContratoTmp := 0;
    if not vDadosIni.PesqPros('CLI183', 'SALVAR', '', 'CLIENTES_COM_CONTRATO',
     dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
     exit;

    if vCOD_CLIENTE = 0 then
      raiseExceptionCreate('Nenhum cliente informado', 'EditHw7');

    if not abreClientes(vCOD_CLIENTE) then
      raiseExceptionCreate('Cliente não encontrado', 'EditHw7');

//    if vCOD_SERVICO = 0 then
//      raiseExceptionCreate('Nenhum serviço informado', 'EditHw1');
//
//    if not buscarContrato(vCOD_SERVICO) then
//   		raiseExceptionCreate('Serviço não encontrado', 'EditHw1');
//
//    if not buscarContrato(vCOD_SERVICO, true) then
//      raiseExceptionCreate('CFOP do Serviço não informado no cadastro', 'EditHw1');

    if vCOD_CONTROLE = 0 then
      raiseExceptionCreate('Controle deve ser informado', 'EditHw2');

    if not buscarControle(vCOD_CONTROLE) then
      raiseExceptionCreate('Controle não encontrado', 'EditHw2');

    if vCOD_COLABORADOR = 0 then
      raiseExceptionCreate('Vendedor deve ser informado', 'EditHw5');

    if not buscarVendedor(vCOD_COLABORADOR) then
    	raiseExceptionCreate('Vendedor não encontrado', 'EditHw5');

    if (vDIA_VENCIMENTO <= 0) and (vDIAS_APOS_VENC <= 0) then
      raiseExceptionCreate('Dia de Vencimento deve ser informado', 'EditHw3');

    if vDIA_VENCIMENTO > 31 then
      raiseExceptionCreate('Dia de Vencimento não deve ser maior que 31', 'EditHw3');

    if (vDIA_FATURAMENTO < 0) then
      raiseExceptionCreate('Dia do Faturamento não deve ser menor que 0', 'EditHw10');

    if (vDIA_FATURAMENTO > 31) then
      raiseExceptionCreate('Dia do Faturamento não deve ser maior que 31', 'EditHw10');

    if Trim(vTIPO_OS) = '' then
      raiseExceptionCreate('Tipo de OS deve ser informado', 'ComboBox13');

//    if vVALOR_CONTRATO <= 0 then
//      raiseExceptionCreate('Valor do contrato deve ser informado', 'EditHw4');

    if Trim(fSTATUS) = '' then
      raiseExceptionCreate('Status deve ser informado', 'ComboBox9');

    if ((vCONTRATOS_CADA_MES < 0) or (vCONTRATOS_CADA_MES > 12)) then
      raiseExceptionCreate('Gerar Contratos a Cada Mês não esta preenchido corretamente', 'EditHw6');

    if vCONTRATOS_CADA_MES <= 0 then
      raiseExceptionCreate('Gerar Contratos a Cada Mês deve ser informado', 'EditHw6');

    if vDATA_INICIAL_VIGENCIA <= 0 then
    	raiseExceptionCreate('Data Inicial Vigência deve ser informado', 'MaskEdit10');

    if vDATA_FINAL_VIGENCIA <= 0 then
    	raiseExceptionCreate('Data Final Vigência deve ser informado', 'MaskEdit11');

    if not vDATA_IMPRESSAO_BOLETO then
      vDATA_IMPRESSAOBOL_INICIAL := 0
    else
    begin
      if vDATA_IMPRESSAOBOL_INICIAL <= 0 then
	      raiseExceptionCreate('Data Inicial Impressão do Boleto inválida!', 'MaskEdit16');
    end;

    if Trim(fSTATUS) = 'Cancelado' then
    	if vDATA_CANCELAMENTO <= 0 then
    		raiseExceptionCreate('Data de Cancelamento deve ser informado', 'MaskEdit4');

    if vBOLETO = 'S' then
      if vDATA_INICIAL_VIGENCIA > vDATA_IMPRESSAOBOL_INICIAL  then
        raiseExceptionCreate('Data Inicial da Vigência não deve ser maior que Data Inicial da Impressão do boleto ', 'MaskEdit10');

    if Trim(fSTATUS) = 'Rescindido' then
    	if (Length(Trim(fOBS)) <= 14) then
      	raiseExceptionCreate('Favor informar o motivo da rescisão (Tamanho mínimo 15 caracteres)', 'MemoOBSCtr');


    if Trim(vMODO) = 'INSERIR' then
    begin
//    	if vCOD_SERVICO > 0 then
//        if not _verificarContrato(vCOD_CLIENTE, vCOD_SERVICO) then
//        begin
//          if Application.MessageBox('Contrato com este tipo de serviço já existe para este cliente, Deseja continuar ?',
//            'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
//            Exit;
//
//          if not vDadosIni.PesqPros('CLI182', 'PERMITIR', '', 'CLIENTES_COM_CONTRATO',
//            '', buscas, false) then
//            Exit;
//        end;

      vCodContratoTmp := Gencodigo('CLIENTES_COM_CONTRATO', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO CLIENTES_COM_CONTRATO ' +
        ' (COD_CONTRATO, COD_EMPRESA, DESCR_CONTRATO, COD_CLIENTE,  ' +
        ' COD_SERVICO, COD_CONTROLE, COD_VENDEDOR, DIA_VENCIMENTO, DIA_FATURAMENTO, DIAS_APOS_VENC, ' +
        //' VALOR_CONTRATO, ' +
        ' DATA_INICIAL_VIGENCIA, DATA_FINAL_VIGENCIA, STATUS, TIPO_OS, ' +
        ' DATA_INICIAL_BOLETO, DATA_CANCELAMENTO, CONTRATOS_CADA_MES, OBS, ' +
        ' GERAR_NFS, GERAR_NF, GERAR_REC_LOC, GERAR_BOLETO)' +
        ' VALUES ' +
        ' (:COD_CONTRATO, :COD_EMPRESA, :DESCR_CONTRATO, :COD_CLIENTE, ' +
        ' :COD_SERVICO, :COD_CONTROLE, :COD_VENDEDOR, :DIA_VENCIMENTO, :DIA_FATURAMENTO, :DIAS_APOS_VENC, ' +
        //' :VALOR_CONTRATO, ' +
        ' :DATA_INICIAL_VIGENCIA, :DATA_FINAL_VIGENCIA, :STATUS, :TIPO_OS, ' +
        ' :DATA_INICIAL_BOLETO, :DATA_CANCELAMENTO, :CONTRATOS_CADA_MES, :OBS, ' +
        ' :GERAR_NFS, :GERAR_NF, :GERAR_REC_LOC, :GERAR_BOLETO)';
      buscas.ParamByName('COD_CONTRATO').AsInteger := vCodContratoTmp;
    end
    else
    begin
    	vCodContratoTmp := vCOD_CONTRATO;
      buscas.Close;
      buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO SET ' +
        ' COD_CLIENTE = :COD_CLIENTE, DESCR_CONTRATO = :DESCR_CONTRATO, ' +
        ' COD_SERVICO = :COD_SERVICO, COD_CONTROLE = :COD_CONTROLE, COD_VENDEDOR = :COD_VENDEDOR,' +
        ' DIA_VENCIMENTO = :DIA_VENCIMENTO, DIA_FATURAMENTO = :DIA_FATURAMENTO, DIAS_APOS_VENC = :DIAS_APOS_VENC, ' +
        //' VALOR_CONTRATO = :VALOR_CONTRATO, ' +
        ' DATA_INICIAL_VIGENCIA = :DATA_INICIAL_VIGENCIA, ' +
        ' DATA_FINAL_VIGENCIA = :DATA_FINAL_VIGENCIA,' +
        ' STATUS = :STATUS, TIPO_OS = :TIPO_OS, ' +
        ' DATA_INICIAL_BOLETO = :DATA_INICIAL_BOLETO, ' +
        ' DATA_CANCELAMENTO = :DATA_CANCELAMENTO, ' +
        ' CONTRATOS_CADA_MES = :CONTRATOS_CADA_MES, OBS = :OBS, ' +
        ' GERAR_NFS = :GERAR_NFS, GERAR_NF = :GERAR_NF, ' +
        ' GERAR_REC_LOC = :GERAR_REC_LOC, GERAR_BOLETO = :GERAR_BOLETO, ' +
        ' US_MOD_CL = ' + IntToStr(vDadosIni.vCodUsuario) +
        ' WHERE COD_CONTRATO = :COD_CONTRATO AND COD_EMPRESA = :COD_EMPRESA ';
      buscas.ParamByName('COD_CONTRATO').AsInteger := vCodContratoTmp;
    end;
    buscas.ParamByName('COD_CLIENTE').AsInteger := vCOD_CLIENTE;
    buscas.ParamByName('DESCR_CONTRATO').AsString := trim(vDESCR_CONTRATO);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('COD_SERVICO').AsInteger := 0;//vCOD_SERVICO;
    buscas.ParamByName('COD_CONTROLE').AsInteger := vCOD_CONTROLE;
    buscas.ParamByName('COD_VENDEDOR').AsInteger := vCOD_COLABORADOR;
    buscas.ParamByName('DIA_VENCIMENTO').AsInteger := vDIA_VENCIMENTO;
    buscas.ParamByName('DIA_FATURAMENTO').AsInteger := vDIA_FATURAMENTO;
    buscas.ParamByName('DIAS_APOS_VENC').AsInteger := vDIAS_APOS_VENC;
//    buscas.ParamByName('VALOR_CONTRATO').AsFloat := vVALOR_CONTRATO;

    if vDATA_INICIAL_VIGENCIA = 0 then
      buscas.ParamByName('DATA_INICIAL_VIGENCIA').Value := Null
    else
      buscas.ParamByName('DATA_INICIAL_VIGENCIA').AsDate := vDATA_INICIAL_VIGENCIA;

    if vDATA_FINAL_VIGENCIA = 0 then
      buscas.ParamByName('DATA_FINAL_VIGENCIA').Value := Null
    else
      buscas.ParamByName('DATA_FINAL_VIGENCIA').AsDate := vDATA_FINAL_VIGENCIA;

    if vDATA_IMPRESSAOBOL_INICIAL = 0 then
      buscas.ParamByName('DATA_INICIAL_BOLETO').Value := Null
    else
      buscas.ParamByName('DATA_INICIAL_BOLETO').AsDate := vDATA_IMPRESSAOBOL_INICIAL;

    if vDATA_CANCELAMENTO = 0 then
    	buscas.ParamByName('DATA_CANCELAMENTO').Value := Null
    else
    	buscas.ParamByName('DATA_CANCELAMENTO').AsDate := vDATA_CANCELAMENTO;

    buscas.ParamByName('CONTRATOS_CADA_MES').AsInteger := vCONTRATOS_CADA_MES;
    buscas.ParamByName('STATUS').AsString := trim(vSTATUS);
    buscas.ParamByName('TIPO_OS').AsString := trim(vTIPO_OS);
    buscas.ParamByName('OBS').AsString := trim(vOBS);
    buscas.ParamByName('GERAR_NFS').AsString     := vDadosIni.IfThen(trim(vGerarNFS) = '', 'S', vGerarNFS);
    buscas.ParamByName('GERAR_NF').AsString      := vDadosIni.IfThen(trim(vGerarNF) = '', 'S', vGerarNF);
    buscas.ParamByName('GERAR_REC_LOC').AsString := vDadosIni.IfThen(trim(vGerarRecLoc) = '', 'S', vGerarRecLoc);
    buscas.ParamByName('GERAR_BOLETO').AsString  := vDadosIni.IfThen(trim(vGerarBoleto) = '', 'S', vGerarBoleto);
    buscas.ExecSQL;

    CommitaTransacao;

    Result := True;

    if Result then
    vDadosIni.GravaAuditoria('CLI183', vMODO, 'SUCESSO', 'CLIENTES_COM_CONTRATO',
      dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

    if vCodContratoTmp > 0 then
    	_selecionaContratCod(vCodContratoTmp)
    else
    	_selecionaContratos(vCOD_CLIENTE);

  except on E: Exception do
    begin
      Result := False;

      vDadosIni.GravaAuditoria('CLI183', vMODO, 'FALHA', 'CLIENTES_COM_CONTRATO',
      dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

function TContratosComClientes._selecionaContratCod(
  pCodContrato: Integer): Boolean;
begin
	Result := montaSelect('select cc.*, ts.desc_servico, co.nome_vendedor, c.nome_ctrl, c.usar_boleto, ' +
  	' cl.nome_cliente, cl.razao, cl.cpfcgc, cl.fone_cliente, cl.fone_celular, cl.email, ' +
    ' cl.codigo_uf, est.sigla_uf, ' +
    ' cl.cod_cidade, cid.nome_cidade, ' +
    ' cl.cod_bairro, bai.nome_bairro, ' +
    ' cl.cep, cl.endereco, cl.num_end_cliente ' +
    ' from clientes_com_contrato cc ' +
    ' inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
    ' left join estados est on est.codigo_uf = cl.codigo_uf ' +
    ' left join cidades cid on cid.cod_cidade = cl.cod_cidade ' +
    ' left join bairros bai on bai.cod_bairro = cl.cod_bairro ' +
    ' inner join tipo_servico ts on ts.cod_servico = cc.cod_servico ' +
    ' inner join controles c on c.codigo_ctrl = cc.cod_controle and c.codigo_emp = cc.cod_empresa ' +
    ' left join colaborador co on co.cod_vendedor = cc.cod_vendedor and co.cod_empresa = cc.cod_empresa ' +
    ' where cc.cod_contrato = ' + IntToStr(pCodContrato) +
    ' and cc.cod_empresa = ' + vDadosIni.codEmpresa);
end;

