    if dataset.FieldByName('COD_BAIRRO').IsNull then
      raiseExceptionCreate('Bairro não informado.' + chr(13) + 'Campo Requerido.', 'DBEDIT76');

    if not ExecutaComandosSql('select COD_BAIRRO from bairros where ativo=1 and COD_BAIRRO =' +
      dataSet.FieldByName('COD_BAIRRO').AsString) then
      raiseExceptionCreate('Bairro do Cliente adicional não encontrado.' + chr(13) +
        'Campo Requerido.', 'DBEDIT76');

    if trim(dataSet.FieldByName('BAIRRO').AsString) = '' then
      dataSet.FieldByName('BAIRRO').AsString :=
        retornaValor('select NOME_BAIRRO as valor from bairros where ativo=1 and COD_BAIRRO =' +
        dataSet.FieldByName('COD_BAIRRO').AsString);

    if dataset.FieldByName('COD_CIDADE').IsNull then
      raiseExceptionCreate('Cidade não informada.' + chr(13) + 'Campo Requerido.', 'DBEDIT77');

    if not ExecutaComandosSql('SELECT COD_CIDADE FROM CIDADES where ativo=1 and COD_CIDADE =' +
      dataSet.FieldByName('COD_CIDADE').AsString) then
      raiseExceptionCreate('Cidade do Cliente adicional não encontrada.' + chr(13) +
        'Campo Requerido.', 'DBEDIT76');

    if trim(dataSet.FieldByName('CIDADE').AsString) = '' then
      dataSet.FieldByName('CIDADE').AsString :=
        retornaValor('select NOME_CIDADE as valor from cidades where ativo=1 and COD_CIDADE =' +
        dataSet.FieldByName('COD_CIDADE').AsString);

    if trim(dataset.FieldByName('ESTADO').AsString) = '' then
      raiseExceptionCreate('UF não informado.' + chr(13) + 'Campo Requerido.',
        'DBLookupComboBox13');

    if dataset.FieldByName('CEP').AsString = '' then
      raiseExceptionCreate('CEP do cliente adicional não informado' + chr(13) + 'Campo Requerido.',
        'DBEDIT70');

    dataSet.FieldByName('fone').AsString := vDadosIni.StringReplace2(
      dataSet.FieldByName('fone').AsString, '()-', '   ', True);

    dataSet.FieldByName('fax').AsString := vDadosIni.StringReplace2(
      dataSet.FieldByName('fax').AsString, '()-', '   ', True);

    dataSet.FieldByName('CEP').AsString := vDadosIni.StringReplace2(
      dataSet.FieldByName('CEP').AsString, '-', ' ', True);

    dataSet.FieldByName('EMAIL').AsString := LowerCase(dataSet.FieldByName('EMAIL').AsString);

    if dataSet.State = dsInsert then
      dataSet.FieldByName('SEQCAD').AsInteger := Gencodigo('END_PCLIENTES', DtmClientes.SpIncCodigo,
        vDadosIni.codEmpresa)
    else
      dataSet.FieldByName('US_MOD_US').AsInteger := vDadosIni.vCodUsuario;

    Result := inherited post;

    if result and (dataSet.ChangeCount = 0) and (acao = 'EDITAR') then
    begin
      Cancel;
      RollBackTransacao;
      Result := true;
      Exit;
    end;
    if result then
      result := apply;
    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI154', acao, 'SUCESSO', 'END_PCLIENTES',
        dataSet.FieldByName('SEQCAD').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI154', acao, 'FALHA', 'END_PCLIENTES',
        dataSet.FieldByName('SEQCAD').AsString, buscas);
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

