function TPossivelCliente.post: boolean;
var
	acao: string;
begin
	try
    Result := false;

    if not vDadosIni.PesqPros('CLI024', 'SALVAR', '', 'CLIENTES',
      dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
      Exit;

    if dataSet.State = dsInsert then
      acao := 'INSERIR'
    else
      acao := 'EDITAR';

    if acao = 'INSERIR' then
    	dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);

    Result := inherited post;

    if (DataSet.ChangeCount = 0) then
      Result := True
    else
      Result := Apply;

    if result then
      result := CommitaTransacao;

    if Result then
      vDadosIni.GravaAuditoria('CLI024', acao, 'SUCESSO', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas)
    else
      vDadosIni.GravaAuditoria('CLI024', acao, 'FALHA', 'CLIENTES',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

    if Result then
      Refresh;

  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

procedure TPossivelCliente.Preenchecampos;
begin
  if dataSet.State = dsEdit then
  begin
    dataSet.FieldByName('ATIVO').AsInteger := 2;
    dataSet.FieldByName('TIPO').AsString := 'C';
  end
  else
  begin
    if vDadosIni.vCliente.vConfCPF then
      if dataSet.FieldByName('CPFCGC').EditMask = HelperCNPJ.EditMask then//'99.999.999/9999-99;0;' then
        dataSet.FieldByName('CATEGORIA').AsString := 'CCJ'
      else
        dataSet.FieldByName('CATEGORIA').AsString := 'CCF';
    dataSet.FieldByName('TIPO').AsString := 'C';
//    buscas.close;
//    buscas.SQL.Text :=
//      'select valor from codigo where tabela=''CLIENTES'' and ativo = 1 and cod_empresa=' +
//      vDadosIni.codEmpresa;
//    buscas.open;
    dataSet.FieldByName('COD_CLIENTE').AsInteger := 0;//buscas.FieldByName('VALOR').AsInteger + 1;
    dataSet.FieldByName('TIPVCLIENTE').AsString := IfThen(trim(vDadosIni.vCliente.vTipoVendaPadrao) <> '',
    	  Copy(trim(vDadosIni.vCliente.vTipoVendaPadrao), 1, 1), 'V');
