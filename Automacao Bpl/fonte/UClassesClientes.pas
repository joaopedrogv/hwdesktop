function TContratosComClientes._getDetalhesVendas: Boolean;
var
	fTempServ: TClientDataSet;
  fTempProd: TClientDataSet;
begin
	try
    fTempServ := TClientDataSet.Create(nil);
    fTempServ.Close;
    fTempServ.FieldDefs.Clear;
    fTempServ.FieldDefs.Add('COD_SERVICO', ftInteger, 0, false);
  except
  end;

	if fTempServ.Tag = 0 then
	try
    fTempServ.CreateDataSet;
  except
  end;

  try
    fTempProd := TClientDataSet.Create(nil);
    fTempProd.Close;
    fTempProd.FieldDefs.Clear;
    fTempProd.FieldDefs.Add('GRUPO_PROD', ftInteger, 0, false);
    fTempProd.FieldDefs.Add('COD_PROD', ftString, 6, false);
    fTempProd.FieldDefs.Add('COD_GRADE', ftInteger, 0, false);
  except
  end;

	if fTempProd.Tag = 0 then
	try
    fTempProd.CreateDataSet;
  except
  end;

  vProdCtr.abreProdCtr(dataSet.FieldByName('COD_CONTRATO').AsInteger);
	vServCtr.abreServCtr(dataSet.FieldByName('COD_CONTRATO').AsInteger);

  fTempProd.EmptyDataSet;
  vProdCtr.dataSet.First;
  while not vProdCtr.dataSet.Eof do
  begin
  	fTempProd.Insert;
    fTempProd.FieldByName('GRUPO_PROD').AsInteger := vProdCtr.dataSet.FieldByName('GRUPO_PROD').AsInteger;
    fTempProd.FieldByName('COD_PROD').AsString := vProdCtr.dataSet.FieldByName('COD_PROD').AsString;
    fTempProd.FieldByName('COD_GRADE').AsInteger := vProdCtr.dataSet.FieldByName('COD_GRADE').AsInteger;
    fTempProd.Post;

  	vProdCtr.dataSet.Next;
  end;

  fTempServ.EmptyDataSet;
  vServCtr.dataSet.First;
  while not vServCtr.dataSet.Eof do
  begin
  	ftempServ.Insert;
    ftempServ.FieldByName('COD_SERVICO').AsInteger := vServCtr.dataSet.FieldByName('COD_SERVICO').AsInteger;
    ftempServ.Post;

    vServCtr.dataSet.Next;
  end;

  fVendas.Close;
  fVendas.CommandText := '';
  if dataSet.FieldByName('COD_SERVICO').AsInteger > 0 then
    fVendas.CommandText :=
      ' select pv.nped, pv.data_ped, pv.data_fech, pv.valor_total,' +
      ' pv.status_ped, pv.tipo_os, pv.num_nf, pv.data_nf, pv.num_nfeext, pv.data_nfext ,' +
      ' cl.nome_cliente, cl.razao, cl.cpfcgc ' +
      ' from pedvenda pv' +
      ' inner join pedvenda_serv ps on ps.nped = pv.nped and ps.tipo = pv.tipo and ps.cod_empresa = pv.cod_empresa' +
      ' inner join clientes cl on cl.cod_cliente = pv.cod_cliente and cl.cod_empresa = pv.cod_empresa ' +
      ' where pv.cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
      ' and ps.cod_servico = ' + IntToStr(dataSet.FieldByName('COD_SERVICO').AsInteger) +
      ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pv.tipo = ''OS'' ' +
      ' and pv.cod_gerador > 0 ';

  if not fTempProd.IsEmpty then
  begin
    if trim(fVendas.CommandText) <> '' then
      fVendas.CommandText := fVendas.CommandText +
        ' union ';

    fVendas.CommandText := fVendas.CommandText +
      ' select pv.nped, pv.data_ped, pv.data_fech, pv.valor_total,' +
      ' pv.status_ped, pv.tipo_os, pv.num_nf, pv.data_nf, pv.num_nfeext, pv.data_nfext ,' +
      ' cl.nome_cliente, cl.razao, cl.cpfcgc ' +
      ' from pedvenda pv' +
      ' inner join pedvenda_prod pp on pp.nped = pv.nped and pp.tipo = pv.tipo and pp.cod_empresa = pv.cod_empresa' +
      ' inner join clientes cl on cl.cod_cliente = pv.cod_cliente and cl.cod_empresa = pv.cod_empresa ' +
      ' where pv.cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
      ' and ( ';

    fTempProd.First;
    while not fTempProd.Eof do
    begin
    	fVendas.CommandText := fVendas.CommandText +
      	vDadosIni.IfThen(fTempProd.RecNo = 1, '', ' or ') +
        	' (pp.grupo_prod = ' + IntToStr(fTempProd.FieldByName('GRUPO_PROD').AsInteger) +
          ' and pp.cod_prod = ' + QuotedStr(fTempProd.FieldByName('COD_PROD').AsString) +
          ' and pp.cod_grade = ' + IntToStr(fTempProd.FieldByName('COD_GRADE').AsInteger) + ') ';

      fTempProd.Next;
    end;

    fVendas.CommandText := fVendas.CommandText + ') '+
      ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pv.tipo = ''OS'' ' +
      ' and pv.cod_gerador > 0 ';

  end;

  if not fTempServ.IsEmpty then
  begin
  	if trim(fVendas.CommandText) <> '' then
      fVendas.CommandText := fVendas.CommandText +
        ' union ';

    fVendas.CommandText := fVendas.CommandText +
      ' select pv.nped, pv.data_ped, pv.data_fech, pv.valor_total,' +
      ' pv.status_ped, pv.tipo_os, pv.num_nf, pv.data_nf, pv.num_nfeext, pv.data_nfext ,' +
      ' cl.nome_cliente, cl.razao, cl.cpfcgc ' +
      ' from pedvenda pv' +
      ' inner join pedvenda_serv ps on ps.nped = pv.nped and ps.tipo = pv.tipo and ps.cod_empresa = pv.cod_empresa' +
      ' inner join clientes cl on cl.cod_cliente = pv.cod_cliente and cl.cod_empresa = pv.cod_empresa ' +
      ' where pv.cod_cliente = ' + IntToStr(dataSet.FieldByName('COD_CLIENTE').AsInteger) +
      ' and ps.cod_servico in ( ';

    fTempServ.First;
    while not fTempServ.Eof do
    begin
    	fVendas.CommandText := fVendas.CommandText +
      	vDadosIni.IfThen(fTempServ.RecNo = 1, '', ', ') + IntToStr(fTempServ.FieldByName('COD_SERVICO').AsInteger);

      fTempServ.Next;
    end;

    fVendas.CommandText := fVendas.CommandText + ') '+
      ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and pv.tipo = ''OS'' ' +
      ' and pv.cod_gerador > 0 ';
  end;

  fVendas.CommandText :=
    ' select distinct nped, data_ped, data_fech, valor_total, ' +
    ' status_ped, tipo_os, num_nf, data_nf, num_nfeext, data_nfext, ' +
    ' nome_cliente, razao, cpfcgc from ( ' +
    fVendas.CommandText + ')';

  fVendas.Open;
end;

function TContratosComClientes._habilitarBoleto: boolean;
begin
  vBOLETO := '';

  fControles.Close;
  fControles.CommandText := 'select codigo_ctrl, nome_ctrl, usar_boleto from controles' +
    ' where codigo_emp = ' + vDadosIni.codEmpresa +
    ' and cxent = ''S''' +
    ' and ativo = 1';
  fControles.Open;

  vBOLETO := fControles.FieldByName('USAR_BOLETO').AsString;
end;

procedure TContratosComClientes._marcaDesmarcaLinha(DtSet: TDataSet);
begin
  if DtSet.IsEmpty then
    exit;

  DtSet.Edit;
  if DtSet.FieldByName('SEL').AsString = 'S' then
    DtSet.FieldByName('SEL').AsString := ''
  else
    DtSet.FieldByName('SEL').AsString := 'S';
  DtSet.Post;
end;

procedure TContratosComClientes._marcaLinha(DtSet: TDataSet);
begin
  if DtSet.IsEmpty then
    exit;

  DtSet.Edit;
  DtSet.FieldByName('SEL').AsString := 'S';
  DtSet.Post;
end;

procedure TContratosComClientes._marcarTodos(DtSet: TDataSet);
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');
    DtSet.DisableControls;
    
    DtSet.First;
    while not DtSet.Eof do
    begin
      DtSet.Edit;
      DtSet.FieldByName('sel').AsString := 'S';
      DtSet.Post;
      DtSet.Next;
    end;
    DtSet.First;

  finally
  	DtSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

