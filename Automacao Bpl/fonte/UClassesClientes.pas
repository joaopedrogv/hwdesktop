function TTransSaldoProgFid.verificarRegistro: boolean;
var
  vcodigo: Integer;
begin
  Result := false;

  vcodigo := dataSet.FieldByName('codigo').AsInteger;
  try
    dataSet.RefreshRecord;
    if vcodigo <> dataSet.FieldByName('codigo').AsInteger then
    begin
      Result := False;
      Application.MessageBox('Registro selecionado foi modificado por outro usuário. Favor verificar',
        'Atenção', 0 + 64);
      Exit;
    end;

    Result := true;

  except on E: Exception do
    begin
      if Pos('changed by another user', e.Message) > 0 then
      begin
        Result := False;
        Application.MessageBox('Registro selecionado foi modificado por outro usuário. Favor verificar',
          'Atenção', 0 + 64);
        Exit;
      end;
    end;
  end;
end;

