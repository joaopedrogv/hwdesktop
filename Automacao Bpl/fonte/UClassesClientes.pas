function TContratosComClientesServ.buscarTipoServ(pCodTipoServ: Integer;
  pNatureza: boolean): Boolean;
begin
	buscas.Close;
  buscas.SQL.Text := 'select tipo_servico.cod_servico, tipo_servico.codigo_nop, tipo_servico.valor_servico from tipo_servico ' +
    ' inner join tipo_servico_empresa on tipo_servico_empresa.cod_servico = tipo_servico.cod_servico and tipo_servico_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
    ' where tipo_servico.cod_servico = ' + IntToStr(pCodTipoServ) +
    ' and tipo_servico.ativo = 1 ';
  buscas.Open;

  if pNatureza then
    Result := (buscas.FieldByName('codigo_nop').AsFloat > 0)
  else
    Result := not buscas.IsEmpty;
end;

function TContratosComClientesServ.buscarTipoServico(pCodTipoServ: Integer;
  pNatureza: boolean): Boolean;
begin
	try
    vCOD_SERVICO := 0;
    vQTDE        := 0;
    vVALOR_UN    := 0;

    buscas.Close;
    buscas.SQL.Text := 'select tipo_servico.cod_servico, tipo_servico.codigo_nop, tipo_servico.valor_servico from tipo_servico ' +
      ' inner join tipo_servico_empresa on tipo_servico_empresa.cod_servico = tipo_servico.cod_servico and tipo_servico_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
      ' where tipo_servico.cod_servico = ' + IntToStr(pCodTipoServ) +
      ' and tipo_servico.ativo = 1 ';
    buscas.Open;

    if pNatureza then
      Result := (buscas.FieldByName('codigo_nop').AsFloat > 0)
    else
      Result := not buscas.IsEmpty;

    if Result then
    begin
    	vCOD_SERVICO := buscas.FieldByName('cod_servico').AsInteger;
      vQTDE        := 1;
      vVALOR_UN    := buscas.FieldByName('valor_servico').AsFloat;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

