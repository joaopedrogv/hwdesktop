      frmGeradorOSFormasBoletas.EditHwSubGrupoOS.Enabled                    := False;
      frmGeradorOSFormasBoletas.DBLookupComboBoxSubGrupoOS.Enabled          := False;

      frmGeradorOSFormasBoletas.RadioGroup1.ItemIndex                       := vDadosIni.vGeradorFaturamentoContratos.vOrdem;

      frmGeradorOSFormasBoletas.RadioGroup1.Enabled                         := False; 

    finally
