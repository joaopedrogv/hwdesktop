function TCheckCheck.abreConsultas(pCodCliente: integer): Boolean;
begin
	Result := montaSelect('SELECT * FROM CONSULTA_CREDCL C WHERE C.COD_CLIENTE = ' +
  IntToStr(pCodCliente) + ' AND C.COD_EMPRESA = ' + vDadosIni.codEmpresa +
  ' ORDER BY C.DATA_CONSULTA DESC, C.HORA_CONSULTA DESC');
end;

procedure TCheckCheck.cadCheckCheck;
begin
  if vDadosIni.vEmp.vUsarCheckCheck <> 'S' then
  begin
    Application.MessageBox('Empresa não configurada para usar o Check Check!', 'Atenção', 0 + 64);
    Exit;
  end;

	if not vDadosIni.PesqPros('CHK001', 'ABRE FORM CONSULTA CHECK CHECK', '', 'CONSULTA_CREDCL', '', buscas, True) then
  	Exit;

  if frmCheckCheck = nil then
    Application.CreateForm(TfrmCheckCheck, frmCheckCheck);

  frmCheckCheck.ShowModal;
end;

function TCheckCheck.clienteTipoConsulta(pCodCliente: integer): string;
begin
	try
    Result := '';
    
    buscas.Close;
    buscas.SQL.Text := 'SELECT COALESCE(C.CNSCHECKCHECK, '''') CNSCHECKCHECK FROM CLIENTES C WHERE C.COD_CLIENTE = :COD_CLIENTE AND C.COD_EMPRESA = :COD_EMPRESA';
    buscas.ParamByName('COD_CLIENTE').AsInteger := pCodCliente;
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    if buscas.IsEmpty then
    	Exit;

    Result := Trim(buscas.FieldByName('CNSCHECKCHECK').AsString);
  except on E: Exception do
  begin
  	Result := '';
		registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;  
  end;
end;

constructor TCheckCheck.create;
begin
	if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  dataSet := TClientDataSet(DtmClientes.cdsCheckCheck);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  buscas := TIBQuery(DtmClientes.qrBuscas);

  vTipoConsulta := TTipoConsultaCheckCheck.create;
end;

function consultaCheckCheck(pCodCliente, pCodEmpresa: integer; pValor: Real; pTipoConsulta: WideString; pTeste: LongBool): LongBool; stdcall; external 'HWCheckCheck.dll';

function TCheckCheck.efetuarConsultaCheckCheck(pCodCliente: integer;
  pValor: Real; pTipoConsulta: string = ''): boolean;
var
	vteste: string;
begin
  try
    try
      Result := False;

      vDadosIni.abreStatusProcessamento('Check Check', 'Consultando Cliente no Check Check');

      if vDadosIni.vEmp.vUsarCheckCheck <> 'S' then
      begin
      	Result := True;
        Exit;
      end;

      if ((pTipoConsulta = '') and (clienteTipoConsulta(pCodCliente) = '')) then
      begin
      	Result := True;
        Exit;
      end;

      if (pTipoConsulta = '') then
				pTipoConsulta := clienteTipoConsulta(pCodCliente);

    	if not(existeConfiguracao(pTipoConsulta)) then
      	Exit;

      if not vDadosIni.PesqPros('CHK002', 'EFETUAR CONSULTA CHECK CHECK', '', 'CLIENTES', IntToStr(pCodCliente), buscas, True) then
        Exit;
      
      Result := consultaCheckCheck(pCodCliente, StrToInt(vDadosIni.codEmpresa), pValor, pTipoConsulta , False);

      if Result then
        Refresh;
    except on E: Exception do
    begin
      Result := False;
      registraErro(e.Message);
      Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
    end;
    end;
  finally
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TCheckCheck.existeConfiguracao(pTipoConsulta: string): Boolean;
begin
	try
    Result := False;

    buscas.Close;
    buscas.SQL.Text := 'SELECT C.IDPL_CHECKCHECK, C.CDACESSO_CHECKCHECK, C.PWS_CHECKCHECK '+
		'FROM CHECKCHECK C '+
		'WHERE C.ATIVO = 1 AND C.TIPO_CONSULTA = :TIPO_CONSULTA '+
		'AND C.COD_EMPRESA = :COD_EMPRESA';
    buscas.ParamByName('TIPO_CONSULTA').AsString := Trim(pTipoConsulta);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    if buscas.IsEmpty then
    	Exit;
      
    if ((buscas.FieldByName('IDPL_CHECKCHECK').AsString = '')
    or (buscas.FieldByName('CDACESSO_CHECKCHECK').AsString = '')
    or (buscas.FieldByName('PWS_CHECKCHECK').AsString = '')) then
    	Exit;

    Result := True;    
  except on E: Exception do
  begin
  	Result := False;
		registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );  
  end;
  end;
end;

function TCheckCheck.permitirEnvioMobile: Boolean;
begin
	try
    Result := False;

    if dataSet.IsEmpty then
			Exit;

    if dataSet.FieldByName('ACAO_CONSULTA').AsString = 'LIBERADO' then
			Exit;    

    if Trim(dataSet.FieldByName('USUARIO_LIBEROU').AsString) <> '' then
    	Exit;

    if not vDadosIni.PesqPros('CHK003', 'PERMITIR ENVIO PEDIDO MOBILE', '', 'CONSULTA_CREDCL', dataSet.FieldByName('COD_CONSULTACRED').AsString, buscas, True) then
      Exit;

		if not Edit then
    	Exit;

    dataSet.FieldByName('USUARIO_LIBEROU').AsString := vDadosIni.vNomeUsuario;

    Post;
    Result := Apply;

    if Result then
    	CommitaTransacao
    else
    	RollBackTransacao;
  except on E: Exception do
  begin
  	Result := False;
    RollBackTransacao;
		registraErro(e.Message);
    Application.MessageBox(pchar('Erro: ' + E.Message), 'Atenção', 0 + 64 );
  end;
  end;
end;

