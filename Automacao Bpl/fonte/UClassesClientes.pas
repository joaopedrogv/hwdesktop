                 buscas.ParamByName('OPERADOR').AsString := vDadosIni.vNomeFuncionario;
                 buscas.ParamByName('DATAHORA').AsDateTime := vDadosIni.getDataHoraBanco(buscas2);
                 buscas.ParamByName('NDOC').AsInteger := vReq;
                 buscas.ParamByName('TIPODOC').AsString := vtiporeq;
                 buscas.ParamByName('COD_EMP_TIPODOC').AsInteger := StrToInt(vDadosIni.codEmpresa);
                 buscas.ExecSQL;
               end;

               if pTrocarMecadorias then
               begin
                 vResgateValeCupom.dataSet.First;
                 while not vResgateValeCupom.dataSet.Eof do
                 begin
                   if vResgateValeCupom.dataSet.FieldByName('SEL').AsString = 'S' then
                   begin
                     buscas.Close;
                     buscas.SQL.Text := ' UPDATE CONTA_CORRENTE_PROG_FIDELIDADE SET ' +
                      ' NDOC = :NDOC, TIPODOC = :TIPODOC, COD_EMP_TIPODOC = :COD_EMP_TIPODOC ' +
                     	' WHERE NVALECUPOM = :NVALECUPOM AND ERP_API = :ERP_API AND COD_EMPRESA = :COD_EMPRESA ';
