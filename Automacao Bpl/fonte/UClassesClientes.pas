      if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
        dataSet.FieldByName('ESTADOS_UF').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
    end;

    if (dataSet.FieldByName('EST_CODIGO_UF').AsInteger > 0) and (trim(dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString) = '') then
    begin
      SqlOpen(' select codigo_uf, sigla_uf from estados ' +
        ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('EST_CODIGO_UF').AsInteger), buscas);

      if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
        dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
    end;
  end;
  if not vDadosIni.getConfSisBool('cl_cad_questionar_enderprincipal_cobrancao', buscas) then
    fDadosEndereco := ''
  else
    fDadosEndereco :=
      Trim(dataSet.FieldByName('CEP').AsString) + '|' +
      Trim(dataSet.FieldByName('ENDERECO').AsString) + '|' +
      Trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString) + '|' +
      Trim(dataSet.FieldByName('COMPLEMENTO').AsString) + '|' +
      Trim(dataSet.FieldByName('BAIRRO').AsString) + '|' +
      Trim(dataSet.FieldByName('CIDADE').AsString) + '|' +
      Trim(dataSet.FieldByName('CODIGO_UF').AsString) + '|';

  vCondPagVND.abreCondPag('VND', dataSet.FieldByName('COND_PAG_VND').AsString);
  vCondPagPre.abreCondPag('PRE', dataSet.FieldByName('COND_PAG_PRE').AsString);
  CupomDescontoCliente.abreCupomDesconto(dataSet.FieldByName('COD_CLIENTE').AsInteger);
  EndDocAd.abrir;
  Frotas.Iniciar(0);
  FtribAd.Iniciar(0);
  FContato.Abrir;
  FContatoMsg.Abrir;
end;

