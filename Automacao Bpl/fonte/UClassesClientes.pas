procedure TCadClientes._marcarDesmarcarSituacaoDeCaixa;
var
	vRegistroSel: boolean;
begin
	if fTempEmpresas.IsEmpty then
  	exit;

  if fTempEmpresas.FieldByName('SEL').AsString = 'S' then
  begin
    if not vDadosIni.PesqPros('CLI270', 'DESMARCAR EMPRESA', '', 'CLIENTES', '', buscas, true) then
	    exit;
  end
  else
  begin
  	if not vDadosIni.PesqPros('CLI269', 'MARCAR EMPRESA', '', 'CLIENTES', '', buscas, true) then
	    exit;
  end;

  vRegistroSel := false;
  try
  	vDadosIni.abreStatusProcessamento('', 'Aguarde. Marcando/desmarcando registro');
    fTempEmpresas.DisableControls;

    fTempEmpresas.Edit;
    if fTempEmpresas.FieldByName('SEL').AsString = 'S' then
      fTempEmpresas.FieldByName('sel').AsString := ''
    else
      fTempEmpresas.FieldByName('sel').AsString := 'S';
    fTempEmpresas.Post;

    if fTempEmpresas.FieldByName('SEL').AsString = 'S' then
    begin
	    vDadosIni.GravaAuditoria('CLI270', 'DESMARCAR EMPRESA', '',
  	  	'CLIENTES', IntToStr(fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger), buscas);
    end
    else
    begin
      vDadosIni.GravaAuditoria('CLI269', 'MARCAR EMPRESA', '',
      	'CLIENTES', IntToStr(fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger), buscas);
    end;

    fTempEmpresas.First;
    while not fTempEmpresas.Eof do
    begin
      if fTempEmpresas.FieldByName('sel').AsString = 'S' then
      begin
      	vRegistroSel := true;
        break;
      end;

      fTempEmpresas.Next;
    end;
    fTempEmpresas.First;

    if not vRegistroSel then
    begin
    	fTempEmpresas.First;
      while not fTempEmpresas.Eof do
      begin
        if fTempEmpresas.FieldByName('cod_empresa').AsInteger = StrToInt(vDadosIni.codEmpresa) then
        begin
        	fTempEmpresas.Edit;
          fTempEmpresas.FieldByName('sel').AsString := 'S';
          fTempEmpresas.Post;

          fTempEmpresas.First;
          break;
        end;

      	fTempEmpresas.Next;
      end;
    end;

    AtualizarSituacaoCaixa(false);

    if not vRegistroSel then
	    Application.MessageBox(pchar('Não é possível desmarcar todas empresas.'), 'Atenção', MB_ICONERROR + MB_OK);
  finally
    vDadosIni.fechaStatusProcessamento;
    fTempEmpresas.EnableControls;
  end;
end;

procedure TCadClientes._marcarTodos;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');

    if not dataSet.Active then
      Exit;

   	checkUnCheckAllRows(True); 
    {
    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := 'S';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;
    }
  finally
  	dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TCadClientes._marcarTodosSituacaoDeCaixa;
begin
	if fTempEmpresas.IsEmpty then
  	exit;

  if not vDadosIni.PesqPros('CLI269', 'MARCAR EMPRESA', '', 'CLIENTES', '', buscas, true) then
    exit;
    
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');
    fTempEmpresas.DisableControls;

    fTempEmpresas.First;
    while not fTempEmpresas.Eof do
    begin
      fTempEmpresas.Edit;
      fTempEmpresas.FieldByName('sel').AsString := 'S';
      fTempEmpresas.Post;

      vDadosIni.GravaAuditoria('CLI269', 'MARCAR EMPRESA', '',
      	'CLIENTES', IntToStr(fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger), buscas);

      fTempEmpresas.Next;
    end;
    fTempEmpresas.First;

    AtualizarSituacaoCaixa(false);
  finally
  	fTempEmpresas.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TCadClientes._abreAtributos(vCod: Integer): Boolean;
var
 buscas2: TIBQuery;
 vValor, vNotas: double;
begin
  try
    Result := false;

    buscas2 := TIBQuery.Create(Application);
    buscas2.Database := buscas.Database;
    buscas2.Transaction := buscas.Transaction;

    buscas.Close;
    buscas.SQL.Text := 'select atr.cod_atributo, atr.descricao_atributo, 0 valor_atributo from atributos atr' +
      ' where atr.ativo = 1 and atr.cod_empresa = ' + vDadosIni.codEmpresa + ' order by atr.descricao_atributo';
    buscas.Prepare;
    buscas.Open;

    vNotas := 0;
    buscas.First;
    fTempAtributos.EmptyDataSet;
    while not buscas.Eof do
    begin
      buscas2.Close;
      buscas2.SQL.Text := 'select atr.cod_atributo, atr.descricao_atributo, atf.* from atributos atr' +
      ' left join atributos_fornec atf on atf.cod_atributo = atr.cod_atributo and atf.cod_empresa = atr.cod_empresa ' +
      ' left join clientes cl on cl.cod_cliente = atf.cod_cliente and cl.cod_empresa = atf.cod_empresa ' +
      ' where atr.cod_atributo = ' + IntToStr(buscas.FieldByName('COD_ATRIBUTO').AsInteger) +
      ' and atr.ativo = 1 and atf.cod_cliente = ' + IntToStr(vCod) + ' and atr.cod_empresa = ' + vDadosIni.codEmpresa;
      buscas2.Prepare;
      buscas2.Open;
      if not buscas2.IsEmpty then
       vValor := buscas2.FieldByName('VALOR_ATRIBUTO').AsFloat
      else
       vValor := 0;

      vNotas := vNotas + vValor;

      Result := true;
      fTempAtributos.Insert;
      fTempAtributos.FieldByName('COD_ATRIBUTO').AsInteger := buscas.FieldByName('COD_ATRIBUTO').AsInteger;
      fTempAtributos.FieldByName('COD_CLIENTE').AsInteger := vCod;
      fTempAtributos.FieldByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      fTempAtributos.FieldByName('DESCRICAO_ATRIBUTO').AsString := buscas.FieldByName('DESCRICAO_ATRIBUTO').AsString;
      fTempAtributos.FieldByName('VALOR_ATRIBUTO').AsFloat := vValor;
      fTempAtributos.FieldByName('ATIVO').AsInteger := 1;
      fTempAtributos.Post;
      buscas.Next;
    end;
    Cliente.dataSet.FieldByName('VALOR_ATRIBUTOS').AsFloat := vNotas;

    buscas.First;
    fTempAtributos.First;
    fTempAtributos.IndexFieldNames := 'DESCRICAO_ATRIBUTO';

    FrmCadClientes.DBGrid15.DataSource := fTempAtributosDtSource;
  except
  end;
end;

function TCadClientes._abreControlesFormaPagamento: Boolean;
var
  buscasTmp: TIBQuery;
begin
	buscasTmp := TIBQuery.Create(Application);
  buscasTmp.Database := buscas.Database;
  buscasTmp.Transaction := buscas.Transaction;

  try
    vControles.ClientOpen(
    	' select case when (coalesce(fp_padrao_cl, '''') = ''T'') then 2 else 3 end ordem, ' +
      ' coalesce(fp_padrao_cl, ''N'') fp_padrao_cl, ' +
      ' case when (coalesce(fp_padrao_cl, ''N'') = ''T'') then ''T'' else ''Z'' end sel, ' +
      ' codigo_ctrl, nome_ctrl, usar_boleto, qseqperf from controles' +
      ' where cxent = ''S'' ' +
      ' and ativo = 1 ' +
      ' and codigo_emp = ' + vDadosIni.codEmpresa +
      ' order by 1, qseqperf ');
    vControles.dataSet.IndexFieldNames := 'SEL; QSEQPERF';

    vControles.prepare_loop();
    try
    	vControles.First;
      while not vControles.Eof do
      begin
        if (pos('(' + IntToStr(vControles.dataSet.FieldByName('codigo_ctrl').AsInteger) + ',', Trim(dataSet.FieldByName('controles_fp').AsString)) > 0) or
          (pos(',' + IntToStr(vControles.dataSet.FieldByName('codigo_ctrl').AsInteger) + ',', Trim(dataSet.FieldByName('controles_fp').AsString)) > 0) or
          (pos(',' + IntToStr(vControles.dataSet.FieldByName('codigo_ctrl').AsInteger) + ')', Trim(dataSet.FieldByName('controles_fp').AsString)) > 0) or
          (pos('(' + IntToStr(vControles.dataSet.FieldByName('codigo_ctrl').AsInteger) + ')', Trim(dataSet.FieldByName('controles_fp').AsString)) > 0) then
        begin
          vControles.Edit;
          vControles.dataSet.FieldByName('ordem').AsInteger := 1;
          vControles.dataSet.FieldByName('sel').AsString := 'S';
          vControles.Post;
        end
        else
        begin
          vControles.Edit;
          if vControles.dataSet.FieldByName('sel').AsString = 'T' then
          begin
          	vControles.dataSet.FieldByName('ordem').AsInteger := 2;
	          vControles.dataSet.FieldByName('sel').AsString := 'T';
          end
          else
          begin
          	vControles.dataSet.FieldByName('ordem').AsInteger := 3;
          	vControles.dataSet.FieldByName('sel').AsString := '';
          end;
          vControles.Post;
        end;

        vControles.next;
      end;
    finally
      vControles.prepare_loop_done();
      vControles.dataSet.IndexFieldNames := 'ORDEM; QSEQPERF';
      vControles.First;
    end;

  except
    on E: Exception do begin
      Result := False;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

