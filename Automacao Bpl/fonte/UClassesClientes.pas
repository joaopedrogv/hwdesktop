      statusDataset := 'E'
    else
      statusDataset := 'I';

    if not (dataSet.State in [dsInsert, dsEdit]) then
    begin
      result := true;
      exit;
    end;

    if trim(dataSet.FieldByName('DESCRICAO_TIPO').AsString) = '' then
      raiseExceptionCreate('Descrição do tipo não foi informada.', 'DBEdit2')
    else
    begin
      if statusDataset = 'E' then
      begin
        if trim(dataSet.FieldByName('DESCRICAO_TIPO').OldValue) <>
          trim(dataSet.FieldByName('DESCRICAO_TIPO').NewValue) then
          if ExecutaComandosSql(' select CODIGO_TIPO from TIPOS_CLIENTES ' +
          	' where DESCRICAO_TIPO = ' + QuotedStr(dataSet.FieldByName('DESCRICAO_TIPO').AsString) +
            ' and ATIVO <> 99 ') then
             raiseExceptionCreate('Tipo de cliente já existe cadastrado.', 'DBEdit2');
      end
      else if ExecutaComandosSql('select CODIGO_TIPO from TIPOS_CLIENTES ' +
      	' where DESCRICAO_TIPO = ' + QuotedStr(dataSet.FieldByName('DESCRICAO_TIPO').AsString) +
        ' and ATIVO <> 99 ') then
        	raiseExceptionCreate('Tipo de cliente já existe cadastrado.', 'DBEdit2');
    end;

    if trim(dataSet.FieldByName('CODIGO_TIPO').AsString) = '' then
      dataSet.FieldByName('CODIGO_TIPO').AsInteger := Incrementacodigo;

    Result := inherited post;
    if not result then
    begin
      (*      if statusDataset = 'I' then
            begin
              if Application.MessageBox('Erro ao gravar registro.' + chr(13) + 'Deseja incrementar o código sequencial dos tipos de clientes em 1 e tentar novamente?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
              begin
      //          ExecutaComandosSql('select GEN_ID(INC_COD_TCLI,1) from rdb$database');
      //          PreencheCampos;
                exit;
              end
              else
              begin
                Result := true;
                Exit;
              end;
            end
            else
            begin*)
      Application.MessageBox('Erro ao gravar registro.', 'Erro', MB_OK + MB_ICONERROR +
        MB_DEFBUTTON1);
      Cancel;
      Result := true;
      Exit;
      //      end;
    end;
    if dataSet.ChangeCount = 0 then
    begin
      Result := true;
      Exit;
    end;
    if Apply then
    begin
      if CommitaTransacao then
      begin
        //        IncrementaCodigo;
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('CLI097', 'ALTERAÇÃO CONFIRMADA', 'SUCESSO', 'TIPOS_CLIENTES',
            dataSet.FieldByName('CODIGO_TIPO').AsString, buscas)
            //          vDadosIni.GravaAuditoria('CLI097', 'ALTEREÇÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_TIPO').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('CLI097', 'INCLUSAO CONFIRMADA', 'SUCESSO', 'TIPOS_CLIENTES',
            dataSet.FieldByName('CODIGO_TIPO').AsString, buscas);
        //          vDadosIni.GravaAuditoria('CLI097', 'INCLUSÃO CONFIRMADA ' +
        //            dataSet.FieldByName('CODIGO_TIPO').asstring, buscas);
      end
      else
      begin
        if statusDataset = 'E' then
          vDadosIni.GravaAuditoria('CLI097', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA',
            'TIPOS_CLIENTES', dataSet.FieldByName('CODIGO_TIPO').AsString, buscas)
            //          vDadosIni.GravaAuditoria('CLI097', 'ALTEREÇÃO NÃO CONFIRMADA ' +
//            dataSet.FieldByName('CODIGO_TIPO').asstring, buscas)
        else if statusDataset = 'I' then
          vDadosIni.GravaAuditoria('CLI097', 'INCLUSAO NÃO CONFIRMADA', 'FALHA', 'TIPOS_CLIENTES',
            dataSet.FieldByName('CODIGO_TIPO').AsString, buscas);
        //          vDadosIni.GravaAuditoria('CLI097', 'INCLUSÃO NÃO CONFIRMADA ' +
        //            dataSet.FieldByName('CODIGO_TIPO').asstring, buscas);
      end;
    end
    else
    begin
      Cancel;
      RollBackTransacao;
      if statusDataset = 'E' then
        vDadosIni.GravaAuditoria('CLI097', 'ALTERAÇÃO NÃO CONFIRMADA', 'FALHA', 'TIPOS_CLIENTES',
          dataSet.FieldByName('CODIGO_TIPO').AsString, buscas)
          //        vDadosIni.GravaAuditoria('CLI097', 'ALTEREÇÃO NÃO CONFIRMADA ' +
//          dataSet.FieldByName('CODIGO_TIPO').asstring, buscas)
      else if statusDataset = 'I' then
        vDadosIni.GravaAuditoria('CLI097', 'INCLUSAO NÃO CONFIRMADA', 'FALHA', 'TIPOS_CLIENTES',
          dataSet.FieldByName('CODIGO_TIPO').AsString, buscas);
      //        vDadosIni.GravaAuditoria('CLI097', 'INCLUSÃO NÃO CONFIRMADA ' +
      //          dataSet.FieldByName('CODIGO_TIPO').asstring, buscas);
    end;
    Refresh;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
