function TRegrasValeTrocaProgFid.editarQtdeMercadoriasTroca(
  pCodCliente: Integer; pLabel, pLabel2: TLabel): boolean;
var
 vQuant: string;
begin
  Result := true;

  if fTempValeTroca.IsEmpty then
    exit;

  if not vDadosIni.PesqPros('CLI227', 'ALTERAR', 'CLIENTE: ' + IntToStr(pCodCliente) +
   ' GRUPO: ' + IntToStr(fTempValeTroca.FieldByName('GRUPO_PROD').AsInteger) +
   ' COD: ' + trim(fTempValeTroca.FieldByName('COD_PROD').AsString),
   'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
   Exit;

  vQuant := FloatToStr(fTempValeTroca.FieldByName('QTDE').AsFloat);

  if not InputQuery('Informe', 'Informe a quantidade', vQuant) then
    exit;

  try
    StrToFloat(vQuant);
  except
    Application.MessageBox(pchar('Quantidade incorreta!'), 'Atenção', MB_ICONERROR + MB_OK);
  end;

  if StrToFloat(vQuant) <= 0  then
  begin
    Application.MessageBox(pchar('Quantidade não informada!'), 'Atenção', MB_ICONERROR + MB_OK);
    exit;
  end;

  fTempValeTroca.Edit;
  fTempValeTroca.FieldByName('QTDE').AsFloat := StrToFloat(vQuant);
  fTempValeTroca.FieldByName('VALOR_TOT').AsFloat := fTempValeTroca.FieldByName('VALOR').AsFloat *
    fTempValeTroca.FieldByName('QTDE').AsFloat;
  fTempValeTroca.FieldByName('TOT_PONTOS').AsFloat := fTempValeTroca.FieldByName('PONTOS').AsFloat *
    fTempValeTroca.FieldByName('QTDE').AsFloat;
  fTempValeTroca.Post;
                                   
  ObterTotal_pontos(pLabel, pLabel2, vDadosIni.vTempPontosResgateTroca, vDadosIni.vTempValorResgateTroca);
end;

function TRegrasValeTrocaProgFid.excluirMercadoriasTroca(pCodCliente: Integer;
  pLabel, pLabel2: TLabel): boolean;
var
  vOK: boolean;
begin
  Result := true;

  if fTempValeTroca.IsEmpty then
  begin
    Application.MessageBox('Nenhum produto selecionado!', 'Atenção', 0 + 64);
    exit;
  end;

  vOK := false;

  if not vDadosIni.PesqPros('CLI225', 'REMOVER', 'CLIENTE: ' + IntToStr(pCodCliente),
   'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
   Exit;

  fTempValeTroca.First;
  while not fTempValeTroca.Eof do
  begin
    if fTempValeTroca.FieldByName('SEL').AsString = 'S' then
    begin
      vOK := true;
      fTempValeTroca.delete;
    end
    else
      fTempValeTroca.Next;
  end;
  fTempValeTroca.First;

  if not vOK then
  	Application.MessageBox('Nenhum produto selecionado!', 'Atenção', 0 + 64);

  ObterTotal_pontos(pLabel, pLabel2, vDadosIni.vTempPontosResgateTroca, vDadosIni.vTempValorResgateTroca);
end;

function TRegrasValeTrocaProgFid.incluirMercadoriasTroca(pCodCliente: Integer;
  pLabel, pLabel2: TLabel): boolean;
var
  vrecno: Integer;
  vOK: boolean;
begin
  Result := true;
  vOK := false;

  if dataSet.IsEmpty then
  begin
    Application.MessageBox('Nenhum produto selecionado!', 'Atenção', 0 + 64);
    exit;
  end;

  if not vDadosIni.PesqPros('CLI224', 'ADICIONAR', 'CLIENTE: ' + IntToStr(pCodCliente),
   'CONTA_CORRENTE_PROG_FIDELIDADE', '', buscas, true) then
   Exit;

  vrecno := dataSet.RecNo;

  dataSet.First;
  while not dataSet.Eof do
  begin
    if dataSet.FieldByName('SEL').AsString = 'S' then
    begin
      dataSet.Edit;
      dataSet.FieldByName('SEL').AsString := '';
      dataSet.Post;

      fTempValeTroca.Insert;
      fTempValeTroca.FieldByName('num_fab_prod').AsString := dataSet.FieldByName('num_fab_prod').AsString;
      fTempValeTroca.FieldByName('descr_prod').AsString := dataSet.FieldByName('descr_prod').AsString;
      fTempValeTroca.FieldByName('grupo_prod').AsInteger := dataSet.FieldByName('grupo_prod').AsInteger;
      fTempValeTroca.FieldByName('cod_prod').AsString := dataSet.FieldByName('cod_prod').AsString;
      fTempValeTroca.FieldByName('cod_grade').AsInteger := dataSet.FieldByName('cod_grade').AsInteger;
      fTempValeTroca.FieldByName('qtde').AsFloat := 1;
      fTempValeTroca.FieldByName('pontos').AsFloat := dataSet.FieldByName('pontos').AsFloat;
      fTempValeTroca.FieldByName('valor').AsFloat := dataSet.FieldByName('valor').AsFloat;
      fTempValeTroca.FieldByName('tot_pontos').AsFloat := fTempValeTroca.FieldByName('pontos').AsFloat;
      fTempValeTroca.FieldByName('valor_tot').AsFloat := fTempValeTroca.FieldByName('valor').AsFloat;
      fTempValeTroca.Post;

      vOK := true;
    end;

    dataSet.Next;
  end;
  dataSet.First;

  dataSet.RecNo := vrecno;

  if not vOK then
  	Application.MessageBox('Nenhum produto selecionado!', 'Atenção', 0 + 64);

  vDadosIni.vDtSetTmp := TClientDataSet(fTempValeTroca);

  ObterTotal_pontos(pLabel, pLabel2, vDadosIni.vTempPontosResgateTroca, vDadosIni.vTempValorResgateTroca);
end;

function TRegrasValeTrocaProgFid.marcarDesmarcaLinha(
  vDataSet: TDataSet): boolean;
begin
  if vDataSet.IsEmpty then
    Exit;

  vDataSet.Edit;
  vDataSet.FieldByName('SEL').AsString := IfThen(vDataSet.FieldByName('SEL').AsString = 'S', '', 'S');
