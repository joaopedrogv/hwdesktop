function TContratosComClientesServ.delete(Contratos: TContratosComClientes): boolean;
begin
	try
  	Result := False;

  	if not vDadosIni.PesqPros('CLI284', 'EXCLUIR',
      'Ctr ' + IntToStr(vCOD_CONTRATO),
      'CLIENTES_COM_CONTRATO_SERV',
    	IntToStr(vCOD_CONTRATO_SERV), buscas, true) then
	    exit;

  	if Application.MessageBox('Deseja remover serviço?',
      'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> idyes then
      	exit;

    buscas.Close;
    buscas.SQL.Text := ' DELETE FROM CLIENTES_COM_CONTRATO_SERV ' +
    	' WHERE COD_CONTRATO_SERV = :COD_CONTRATO_SERV ' +
      ' AND COD_EMPRESA = :COD_EMPRESA; ';
    buscas.ParamByName('COD_CONTRATO_SERV').AsInteger := vCOD_CONTRATO_SERV;
    buscas.ParamByName('COD_EMPRESA').AsInteger    := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;

    CommitaTransacao;

    vDadosIni.GravaAuditoria('CLI284', 'EXCLUIR', 'SUCESSO', 'CLIENTES_COM_CONTRATO_SERV', IntToStr(vCOD_CONTRATO_SERV), buscas);

    abreServCtr(Contratos);

    Result := True;
  except
    on e: Exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('CLI284', 'EXCLUIR', 'FALHA', 'CLIENTES_COM_CONTRATO_SERV', IntToStr(vCOD_CONTRATO_SERV), buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContratosComClientesServ.post(Contratos: TContratosComClientes): boolean;
begin
  try
  	Result := False;

  	if not vDadosIni.PesqPros('CLI285', 'SALVAR',
    	'Ctr ' + IntToStr(vCOD_CONTRATO),
      'CLIENTES_COM_CONTRATO_SERV',
    	'', buscas, true) then
	    exit;

    if vCOD_SERVICO = 0 then
      raiseExceptionCreate('Serviço não informado', 'EditHwCodServ');

    if not buscarTipoServ(vCOD_SERVICO) then
   		raiseExceptionCreate('Serviço não encontrado', 'EditHwCodServ');

    if not buscarTipoServ(vCOD_SERVICO, true) then
      raiseExceptionCreate('CFOP do Serviço não informado no cadastro', 'EditHwCodServ');

    if vQTDE <= 0 then
      raiseExceptionCreate('Quantidade não informada', 'EditHwQtdeServ');

    if vVALOR_UN <= 0 then
      raiseExceptionCreate('Valor unitário não informada', 'EditHwValorUnServ');

    if trim(vMODO) = 'INSERIR' then
    begin
    	if vCOD_SERVICO > 0 then
        if not _verificarContrato(vCOD_CONTRATO, vCOD_SERVICO) then
        begin
          if Application.MessageBox('Contrato com este tipo de serviço já existe, Deseja continuar ?',
            'Atenção', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> IDYES then
            Exit;

          if not vDadosIni.PesqPros('CLI182', 'PERMITIR', 'SERV: ' + IntToStr(vCOD_SERVICO), 'CLIENTES_COM_CONTRATO_SERV',
            IntToStr(vCOD_CONTRATO), buscas, false) then
            Exit;
        end;

      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO CLIENTES_COM_CONTRATO_SERV ' +
        ' (COD_CONTRATO_SERV, COD_EMPRESA, COD_CONTRATO, COD_SERVICO, QTDE, VALOR_UN) ' +
        ' VALUES ' +
        ' (:COD_CONTRATO_SERV, :COD_EMPRESA, :COD_CONTRATO, :COD_SERVICO, :QTDE, :VALOR_UN); ';
      vCOD_CONTRATO_SERV := Gencodigo('CLIENTES_COM_CONTRATO_SERV', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
    	buscas.ParamByName('COD_CONTRATO_SERV').AsInteger := vCOD_CONTRATO_SERV;
    end
    else
    begin
    	buscas.Close;
      buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO_SERV SET ' +
      	' COD_CONTRATO = :COD_CONTRATO, ' +
        ' COD_SERVICO = :COD_SERVICO, ' +
        ' QTDE = :QTDE, ' +
        ' VALOR_UN = :VALOR_UN ' +
        ' WHERE COD_CONTRATO_SERV = :COD_CONTRATO_SERV ' +
        ' AND COD_EMPRESA = :COD_EMPRESA; ';
      buscas.ParamByName('COD_CONTRATO_SERV').AsInteger := vCOD_CONTRATO_SERV;
    end;
    buscas.ParamByName('COD_EMPRESA').AsInteger    := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('COD_CONTRATO').AsInteger   := vCOD_CONTRATO;
    buscas.ParamByName('COD_SERVICO').AsInteger    := vCOD_SERVICO;
    buscas.ParamByName('QTDE').AsFloat             := Round(vQTDE);
    buscas.ParamByName('VALOR_UN').AsFloat         := vVALOR_UN;
    buscas.ExecSQL;

    buscas.Close;
    buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO SET ' +
    	' COD_SERVICO = :COD_SERVICO ' +
    	' WHERE COD_CONTRATO = :COD_CONTRATO ' +
      ' AND COD_EMPRESA = :COD_EMPRESA; ';
    buscas.ParamByName('COD_CONTRATO').AsInteger   := vCOD_CONTRATO;
    buscas.ParamByName('COD_EMPRESA').AsInteger    := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('COD_SERVICO').AsInteger    := 0;
    buscas.ExecSQL;

    CommitaTransacao;

    vDadosIni.GravaAuditoria('CLI285', trim(vModo), 'SUCESSO', 'CLIENTES_COM_CONTRATO_SERV', IntToStr(vCOD_CONTRATO_SERV), buscas);

    abreServCtr(Contratos);

    Result := True;
	except
    on e: Exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('CLI285', trim(vModo), 'FALHA', 'CLIENTES_COM_CONTRATO_SERV', IntToStr(vCOD_CONTRATO_SERV), buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

