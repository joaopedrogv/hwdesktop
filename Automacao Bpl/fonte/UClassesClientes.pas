function TPossivelCliente.TestaCPFCNPJ: boolean;
begin
  result := true;
  if trim(dataSet.FieldByName('CPFCGC').AsString) = '' then
  begin
    Application.MessageBox('Preenchimento do Campo CPF/CNPJ é obrigatório', 'Informação', MB_OK
      + MB_ICONERROR + MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if (length(trim(dataSet.FieldByName('CPFCGC').asstring)) <> 14) and
    (length((trim(dataSet.FieldByName('CPFCGC').asstring))) <> 11) then
  begin
    Application.MessageBox('CPF/CNPJ Inválido.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('.', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Ponto.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('-', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Traço.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if pos('/', dataSet.FieldByName('CPFCGC').asstring) > 0 then
  begin
    Application.MessageBox('Digitar sem Barra.', 'Informação', MB_OK + MB_ICONERROR +
      MB_DEFBUTTON1);
    result := false;
    exit;
  end;
  if length(trim(dataSet.FieldByName('CPFCGC').asstring)) = 11 then
  begin
    if CPF(trim(dataSet.FieldByName('CPFCGC').asstring)) then
    begin
      dataSet.FieldByName('CPFCGC').EditMask := '999.999.999-99;0;';
      result := true;
    end
    else
    begin
      Application.MessageBox('Erro ao Cadastrar CPF' + chr(13) + 'CPF Inválido.', 'Informação',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end;
  end
  else if length((trim(dataSet.FieldByName('CPFCGC').asstring))) = 14 then
    if CGC(trim(dataSet.FieldByName('CPFCGC').asstring)) then
    begin
      dataSet.FieldByName('CPFCGC').EditMask := HelperCNPJ.EditMask;//'99.999.999/9999-99;0;';
//      dataSet.FieldByName('CONVENIADO').asstring := 'N';
      dataSet.FieldByName('COD_CONVENIO').AsVariant := null;
      dataSet.FieldByName('NATURALID').AsVariant := null;
      dataSet.FieldByName('DATA_NASC').AsVariant := null;
      dataSet.FieldByName('SEXO').AsVariant := null;
      dataSet.FieldByName('ESTADO_CIVIL').AsVariant := null;
      dataSet.FieldByName('CONJUGE').AsVariant := null;
      dataSet.FieldByName('PAI').AsVariant := null;
      dataSet.FieldByName('MAE').AsVariant := null;
      dataSet.FieldByName('RG').AsVariant := null;
      dataSet.FieldByName('EXPEDIC').AsVariant := null;
      dataSet.FieldByName('ORG_EXPEDIC').AsVariant := null;
      result := true;
    end
    else
    begin
      Application.MessageBox('Erro ao Cadastrar CNPJ' + chr(13) + 'CNPJ Inválido.', 'Informação',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end;
end;

function TPossivelCliente.TestaInscEstadual: boolean;
begin
  result := true;
  if (dataSet.FieldByName('INSC_EST').AsString = '') or
    (pos(copy(dataSet.FieldByName('INSC_EST').AsString, 1, 1), '0123456789P') = 0) then
  begin
    dataSet.FieldByName('INSC_EST').AsString := 'ISENTO';
    result := true;
  end
  else
  begin
    if pos('.', dataSet.FieldByName('INSC_EST').AsString) > 0 then
    begin
      Application.MessageBox('Digitar sem Ponto.', 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end
    else if pos('-', dataSet.FieldByName('INSC_EST').AsString) > 0 then
    begin
      Application.MessageBox('Digitar sem Traço.', 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end
    else if pos('/', dataSet.FieldByName('INSC_EST').AsString) > 0 then
    begin
      Application.MessageBox('Digitar sem Barra.', 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      result := false;
    end
    else
      result := true;
  end;
end;

function TPossivelCliente.ValidaInscEstadual: boolean;
var
  resultado: integer;
begin
  resultado := ConsisteInscricaoEstadual(PChar(dataSet.FieldByName('INSC_EST').AsString),
    PChar(PCliente.Cli.RetornaUF(dataSet.FieldByName('CODIGO_UF').AsInteger)));
  if resultado <> 0 then
    result := false
  else
    result := true;
end;

procedure TPossivelCliente._desmarcarTodos;
begin
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;

  finally
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

function TPossivelCliente._importarClienteOutraEmpresa: boolean;
var
  i:integer;
begin
  try
    result:=false;
    if dataSet.State <> dsInsert then
      exit;
    if trim(dataSet.FieldByName('CPFCGC').AsString)= '' then
      exit;
    buscas.Close;
    buscas.SQL.Text := 'select first 1 * from clientes where cpfcgc = ' +
      quotedstr(trim(dataSet.FieldByName('CPFCGC').AsString)) + ' and cod_empresa <> ' +
      vDadosIni.codEmpresa+ ' order by cod_empresa';
    buscas.Open;
    if buscas.IsEmpty then
      exit;
    if  Application.MessageBox(Pchar('Cliente já está cadastrado na Empresa '+vDadosIni.StrZero(buscas.FieldByName('cod_empresa').AsInteger,3)+'.'+chr(13)+
     'Deseja importar dados do cliente dessa empresa?'),
      'Importar dados do Cliente de outra empresa', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDYES then
    begin
      for i := 0 to buscas.FieldCount - 1 do
      begin
        if dataSet.FindField(buscas.Fields[i].FieldName) is TField then
        if dataSet.FindField(buscas.Fields[i].FieldName).FieldName = buscas.Fields[i].FieldName  then
          dataSet.FindField(buscas.Fields[i].FieldName).AsVariant := buscas.Fields[i].AsVariant;
      end;
      dataSet.FieldByName('COD_CLIENTE').AsInteger := 0;
      dataSet.FieldByName('TIPVCLIENTE').AsString := IfThen(trim(vDadosIni.vCliente.vTipoVendaPadrao) <> '',
    	  Copy(trim(vDadosIni.vCliente.vTipoVendaPadrao), 1, 1), 'V');
      dataSet.FieldByName('US_CAD_CLI').AsInteger := vDadosIni.vCodUsuario;
      dataSet.FieldByName('COD_EMPRESA').AsInteger := strtoint(vDadosIni.codEmpresa);
      dataSet.FieldByName('DATA_CADASTRO').AsDateTime := date;
      dataSet.FieldByName('ATIVO').AsInteger := 1;
      dataSet.FieldByName('COD_PAIS').AsInteger := 1058;
      buscas.Close;
      buscas.SQL.Text := 'select padrao_consumidor_final from empresa' +
                         ' where cod_empresa = ' + vDadosIni.codEmpresa;
      buscas.Open;
      if Trim(buscas.FieldByName('padrao_consumidor_final').AsString) <> '' then
        dataSet.FieldByName('consumidor_final').AsString := Trim(buscas.FieldByName('padrao_consumidor_final').AsString);

      if vDadosIni.vCliente.vConfCPF then
        if dataSet.FieldByName('CPFCGC').EditMask = HelperCNPJ.EditMask then//'99.999.999/9999-99;0;' then
          dataSet.FieldByName('CATEGORIA').AsString := 'CCJ'
        else
          dataSet.FieldByName('CATEGORIA').AsString := 'CCF';
      dataSet.FieldByName('TIPO').AsString := 'C';
      dataSet.FieldByName('COD_CLIENTE').AsInteger := 0;
      dataSet.FieldByName('TIPVCLIENTE').AsString := IfThen(trim(vDadosIni.vCliente.vTipoVendaPadrao) <> '',
    	  Copy(trim(vDadosIni.vCliente.vTipoVendaPadrao), 1, 1), 'V');
      dataSet.FieldByName('US_CAD_CLI').AsInteger := vDadosIni.vCodUsuario;
      dataSet.FieldByName('COD_EMPRESA').AsInteger := strtoint(vDadosIni.codEmpresa);
      dataSet.FieldByName('DATA_CADASTRO').AsDateTime := date;
      dataSet.FieldByName('ATIVO').AsInteger := 2;
      result:=true;
    end;

  finally
    buscas.Close;
  end;
end;

function TPossivelCliente._LocalizaVendedor(var pDBLookupCBox:TDBLookupComboBox): boolean;
begin
  pDBLookupCBox.KeyField:='COD_VENDEDOR';
  pDBLookupCBox.ListField:='NOME_VENDEDOR';
  pDBLookupCBox.ListSource := dsQueryPC;
  FQueryPC.Close;
  FQueryPC.SQL.Text := 'select c.cod_vendedor,c.nome_vendedor ' +
    ' from colaborador c , funcoes f ' +
    ' where c.cod_funcao=f.cod_funcao ' +
    ' and f.desc_funcao like ''%VENDEDOR%''' +
    ' and c.ativo=1 and c.cod_empresa=' + vDadosIni.codEmpresa;
  FQueryPC.Open;
  FQueryPC.FetchAll;
  result := true;
  if not dataset.FieldByName('COD_VENDEDOR').IsNull then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select c.cod_vendedor,c.nome_vendedor ' +
      ' from colaborador c , funcoes f ' +
      ' where c.cod_funcao=f.cod_funcao ' +
      ' and f.desc_funcao like ''%VENDEDOR%''' +
      ' and c.cod_vendedor = :codcolaborador ' +
      ' and c.ativo=1 and c.cod_empresa=' + vDadosIni.codEmpresa;
    buscas.ParamByName('codcolaborador').AsInteger := dataset.FieldByName('COD_VENDEDOR').AsInteger;
    buscas.Open;
    if (buscas.IsEmpty) then
    begin
      result := false;
      Application.MessageBox('Código do funcionário selecionado não é de um vendedor.',
        'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
    end;
  end;
  buscas.close;
end;

