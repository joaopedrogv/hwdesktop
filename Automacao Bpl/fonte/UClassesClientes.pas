end;

function TCadClientes._recuperarFotoCliente: boolean;
var
  vStream: TStream;
  vStream2: TMemoryStream;
  Jpg: TJpegImage;
  Bmp: Graphics.TBitmap;
begin
  // Primeiramente vamos apagar a imagem contida no recipiente TImage
  result := false;
  Foto.ImageCli.Picture.Bitmap := nil;
  if not vDadosIni.PesqPros('CLI168', 'RECUPERAR', '', 'FOTOS',
    dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
    Exit;
  jpg := nil;
  Bmp := nil;
  if Foto.IsEmpty then
  begin
    vStream2 := TMemoryStream.Create;
    Foto.ImageCliSemFoto.Visible := true;
    Foto.ImageCliSemFoto.Picture.Graphic.SaveToStream(vStream2);
    vStream2.Position := 0;
    if vStream2.Size > 0 then
      Foto.ImageCli.Picture.Bitmap.LoadFromStream(vStream2);
    Foto.ImageCliSemFoto.Visible := false;
    vStream2.Destroy;
    Jpg.Free;
    Bmp.Free;
    exit;
  end;
  Foto.ImageCli.Picture.Bitmap := nil;
  // transferindo a fotografia para o objeto TStream
  vStream := Foto.dataSet.CreateBlobStream(Foto.dataSet.FieldByName('foto'), bmRead);
  // agora transferindo do TStream para um recipiente TImage
  if vStream.Size > 0 then
  begin
    // aqui ta o problema, como recuperar o jpeg do banco
    // perceba que a variavel 'Jpg' é do tipo TJpegImage que por sua vez é uma classe TGraphic
    // e que portanto poderá ser assinalada a propriedade Image1.Picure[.Graphic]
    try
      Jpg := TJpegImage.Create;
      Jpg.LoadFromStream(vStream);
      Foto.ImageCli.Picture.Assign(Jpg);
    except
    end;
  end
  else
  begin
    // Essa seria a maneira natural de eliminar um desenho dentro do
    // TImage, pois se fizessemos um Image1.Picture.Graphic:=nil como
    // sugerem alguns exemplos na internet, provocariamos um 'access violation',
    // pois um nulo não pode ser tratado como bitmap ou jpeg.
    Foto.ImageCli.Picture.Assign(nil);
  end;
  // Vamos liberar
  vStream.Destroy;
  jpg.Free;
end;

function TCadClientes._ValidarEMail(pStr: string; pExibirErro: boolean = false): Boolean;
begin
  pStr := Trim(UpperCase(pStr));
  if Pos('@', pStr) > 1 then
  begin
    System.Delete(pStr, 1, pos('@', pStr));
    Result := (Length(pStr) > 0) and (Pos('.', pStr) > 2);
  end
  else begin
    if pExibirErro then
      Application.MessageBox(pchar('CLIENTE: ' + dataSet.FieldByName('COD_CLIENTE').AsString + ' - ' +
        trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' | E-Mail: ' +
        trim(dataSet.FieldByName('email').AsString)), 'Informação', MB_OK + MB_ICONINFORMATION);
    Result := False;
  end;
end;

