//            else if (REnviarContratos.vCampoAd = 'N_SEQ_BOL') or (REnviarContratos.vCampoAd = 'NOSSO_NUMERO_BANCO')
//               or (REnviarContratos.vCampoAd = 'REMESSA_ENVIADA') or (REnviarContratos.vCampoAd = 'COD_COBREBEM')
//               or (REnviarContratos.vCampoAd = 'HTMLBOLETO')
//               or (rEnviarContratos.vCampoAd = 'ENV_EMAIL_BOL') or (rEnviarContratos.vCampoAd = 'DATA_EMAIL_BOL')
//               or (rEnviarContratos.vCampoAd = 'ENV_WHATSAPP_BOL') or (rEnviarContratos.vCampoAd = 'DATA_WHATSAPP_BOL') then
//                 REnviarContratos.vsqlAdicional := REnviarContratos.vsqlAdicional + 'BOLETAS.' + REnviarContratos.vCampoAd + ' like ' + QuotedStr('%' + REnviarContratos.vValorAd + '%')
//            else
              	 REnviarContratos.vsqlAdicional := REnviarContratos.vsqlAdicional +
                 	 'VW_CONTRATOS_CL.' + REnviarContratos.vCampoAd + ' like ' + QuotedStr('%' + REnviarContratos.vValorAd + '%')
          end
          else if REnviarContratos.vCondicaoAd = 'Começa' then
          begin
//            if (REnviarContratos.vCampoAd = 'NOME_CLIENTE') or (REnviarContratos.vCampoAd = 'RAZAO')
