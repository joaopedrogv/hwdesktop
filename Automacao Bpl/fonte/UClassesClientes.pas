procedure TCadClientes.setMesmoEnderecoCobIgualPrincipal;
begin
  if dataSet.State in [dsEdit, dsInsert] then
  begin
    dataSet.FieldByName('CEP_COBRANCA').AsString := dataSet.FieldByName('CEP').AsString;
    dataSet.FieldByName('END_COBRANCA').AsString := dataSet.FieldByName('ENDERECO').AsString +
      vDadosIni.IfThen(Trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString) <> '',
        ', ' + Trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString), '') +
      vDadosIni.IfThen(Trim(dataSet.FieldByName('COMPLEMENTO').AsString) <> '',
