    TFloatField(fTempContratos.FieldByName('VALOR_CRED_VENC')).DisplayFormat    := '#0.00';
    TFloatField(fTempContratos.FieldByName('VALOR_CHQ_VENC')).DisplayFormat     := '#0.00';
    TFloatField(fTempContratos.FieldByName('LIMITE_CREDITO')).DisplayFormat     := '#0.00';
    TFloatField(fTempContratos.FieldByName('VALOR_CONTRATO')).DisplayFormat     := '#0.00';
    TFloatField(fTempContratos.FieldByName('VALOR_PROD')).DisplayFormat         := '#0.00';
    TFloatField(fTempContratos.FieldByName('VALOR_SERV')).DisplayFormat         := '#0.00';
    TFloatField(fTempContratos.FieldByName('VALOR_BOLETO')).DisplayFormat       := '#0.00';

    fTempContratosDtSource := TDataSource.Create(nil);
    fTempContratosDtSource.DataSet := fTempContratos;
  except
  end;

  abreDataSets;
end;

function TGeradorOS.deleteContratos: boolean;
var
  codGerador, vindi, acao: string;
  codColaborador, Colaborador: string;
  dataCaixaCXL: TDateTime;
  buscas2: TIBQuery;
begin
  Result := True;
  if dataSet.IsEmpty then
    exit;

  acao := 'EXCLUIR' + vDadosIni.IfThen(trim(vindi) = 'S', ' - VINDI', '');
  if not vDadosIni.PesqPros('CLI210', acao, '', 'GERADOR_OSBOL', '', buscas, false) then
    exit;

  buscas2 := TIBQuery.Create(Application);
  buscas2.Database := buscas.Database;
  buscas2.Transaction := buscas.Transaction;

  codGerador := dataSet.FieldByName('COD_GERADOR').AsString;
  vindi := trim(dataSet.FieldByName('VINDI').AsString);
  codColaborador := IntToStr(dataSet.FieldByName('COD_VENDEDOR').AsInteger);
  Colaborador := trim(dataSet.FieldByName('NOME_VENDEDOR').AsString);
  dataCaixaCXL := dataSet.FieldByName('DATA_BASE_DOC').AsDateTime;

  if Application.MessageBox('Tem certeza que deseja excluir Ordem de Serviço, Formas de Pagamentos e Boletas?',
    'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
			Exit;

  if trim(dataSet.FieldByName('VINDI').AsString) = 'S' then
  	if Application.MessageBox('Faturamento de contrato gerado pela Vindi.' + chr(13) + chr(13) +
      'Deseja apagar assim mesmo?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) <> IDYES then
        Exit;

  try
    if vDadosIni.vEmp.vModoFaturamento = 'S' then
    begin
      buscas.Close;
      buscas.SQL.Text := ' SELECT COUNT(*) FROM FECD_CXL ' +
         ' WHERE DIA_F_CXL = :DIA_F_CXL AND OP_CXL = :OP_CXL AND CODIGO_EMP = :COD_EMPRESA  ' +
         ' AND STATUS_CXL = ''FECHADO'' ';
      buscas.ParamByName('DIA_F_CXL').AsDateTime := dataCaixaCXL;
      buscas.ParamByName('OP_CXL').AsInteger := StrToInt(codColaborador);
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.Open;

      if buscas.FieldByName('COUNT').AsInteger > 0 then
      begin
        Application.MessageBox(PChar('Caixa dia ' + QuotedStr(FormatDateTime('dd/MM/yyyy', dataCaixaCXL)) +
          ' do OPERADOR: ' + QuotedStr(Colaborador) + ' se encontra FECHADO não é possível excluir.'), 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
        exit;
      end;
    end;

    buscas.Close;
    buscas.SQL.Text := ' SELECT COUNT(*) FROM FORMPAGAMENTO ' +
      ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA  ' +
      ' AND COALESCE(PRCSS, ''N'') = ''S'' ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if buscas.FieldByName('COUNT').AsInteger > 0 then
    begin
      Application.MessageBox('Financeiro já foi processado não é possível excluir.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' SELECT COUNT(*) FROM BOLETAS ' +
       ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA  ' +
       ' AND COALESCE(NOSSO_NUMERO_BANCO, '''') <> '''' ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if buscas.FieldByName('COUNT').AsInteger > 0 then
    begin
      Application.MessageBox('Boletas geradas já possuem nosso número não é possível excluir.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' SELECT COUNT(*) FROM PEDVENDA ' +
      ' INNER JOIN PEDVENDA_PROD ON ' +
      '		PEDVENDA_PROD.NPED = PEDVENDA.NPED ' +
      ' 	AND PEDVENDA_PROD.TIPO = PEDVENDA.TIPO ' +
      '   AND PEDVENDA_PROD.COD_EMPRESA = PEDVENDA.COD_EMPRESA ' +
      ' WHERE PEDVENDA.COD_GERADOR = :COD_GERADOR ' +
      ' AND PEDVENDA.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND PEDVENDA.STATUS_PED = ''FECHADA'' ' +
      ' AND (PEDVENDA_PROD.STATUS <> ''CANCELADO'' or PEDVENDA_PROD.STATUS IS NULL) ' +
      ' AND PEDVENDA_PROD.N_NF > 0 ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if buscas.FieldByName('COUNT').AsInteger > 0 then
    begin
      Application.MessageBox('Número de nota fiscal de produto gerado não é possível excluir.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' SELECT COUNT(*) FROM PEDVENDA ' +
      ' INNER JOIN PEDVENDA_SERV ON ' +
      '		PEDVENDA_SERV.NPED = PEDVENDA.NPED ' +
      ' 	AND PEDVENDA_SERV.TIPO = PEDVENDA.TIPO ' +
      '   AND PEDVENDA_SERV.COD_EMPRESA = PEDVENDA.COD_EMPRESA ' +
      ' WHERE PEDVENDA.COD_GERADOR = :COD_GERADOR ' +
      ' AND PEDVENDA.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND PEDVENDA.STATUS_PED = ''FECHADA'' ' +
      ' AND (PEDVENDA_SERV.STATUS <> ''CANCELADO'' or PEDVENDA_SERV.STATUS IS NULL) ' +
      ' AND PEDVENDA_SERV.COD_RPS > 0 ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if buscas.FieldByName('COUNT').AsInteger > 0 then
    begin
      Application.MessageBox('Código do RPS gerado não é possível excluir.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    buscas.Close;
    buscas.SQL.Text := ' SELECT COUNT(*) FROM PEDVENDA ' +
      ' INNER JOIN PEDVENDA_SERV ON ' +
      '		PEDVENDA_SERV.NPED = PEDVENDA.NPED ' +
      ' 	AND PEDVENDA_SERV.TIPO = PEDVENDA.TIPO ' +
      '   AND PEDVENDA_SERV.COD_EMPRESA = PEDVENDA.COD_EMPRESA ' +
      ' WHERE PEDVENDA.COD_GERADOR = :COD_GERADOR ' +
      ' AND PEDVENDA.COD_EMPRESA = :COD_EMPRESA ' +
      ' AND PEDVENDA.STATUS_PED = ''FECHADA'' ' +
      ' AND (PEDVENDA_SERV.STATUS <> ''CANCELADO'' or PEDVENDA_SERV.STATUS IS NULL) ' +
      ' AND PEDVENDA_SERV.N_NF > 0 ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.Open;
    if buscas.FieldByName('COUNT').AsInteger > 0 then
    begin
      Application.MessageBox('Número de nota fiscal de serviço gerado não é possível excluir.', 'Informação', MB_OK + MB_ICONINFORMATION + MB_DEFBUTTON1);
      exit;
    end;

    try
      vDadosIni.abreStatusProcessamento('', 'Apagando ORDEM DE SERVIÇO');

      buscas2.Close;
      buscas2.SQL.Text := ' SELECT ' +
        ' PEDVENDA_PROD.GRUPO_PROD, ' +
        ' PEDVENDA_PROD.COD_PROD, ' +
        ' PEDVENDA_PROD.COD_EMPRESA, ' +
        ' PEDVENDA_PROD.COD_GRADE, ' +
        ' SUM(COALESCE(PEDVENDA_PROD.QUANT_PED_ITEM, 0)) QUANT_PED_ITEM ' +
        ' FROM PEDVENDA ' +
        ' INNER JOIN PEDVENDA_PROD ON ' +
        '		PEDVENDA_PROD.NPED = PEDVENDA.NPED ' +
        ' 	AND PEDVENDA_PROD.TIPO = PEDVENDA.TIPO ' +
        '   AND PEDVENDA_PROD.COD_EMPRESA = PEDVENDA.COD_EMPRESA ' +
        ' WHERE PEDVENDA.COD_GERADOR = :COD_GERADOR ' +
        ' AND PEDVENDA.COD_EMPRESA = :COD_EMPRESA ' +
        ' AND PEDVENDA.STATUS_PED = ''FECHADA'' ' +
        ' AND (PEDVENDA_PROD.STATUS <> ''CANCELADO'' or PEDVENDA_PROD.STATUS IS NULL) ' +
        ' GROUP BY 1, 2, 3, 4 ';
      buscas2.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
      buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas2.Open;
      buscas2.FetchAll;

      buscas2.First;
      while not buscas2.Eof do
      begin
        Application.ProcessMessages;

        vDadosIni.abreStatusProcessamento('',
          'Atualizando estoque' +
          ' Grupo Prod ' + IntToStr(buscas2.FieldByName('grupo_prod').AsInteger) +
          ' Cod Prod ' + trim(buscas2.FieldByName('cod_prod').AsString) +
          ' Cod Grade ' + IntToStr(buscas2.FieldByName('cod_grade').AsInteger) +
          ' (' + IntToStr(buscas2.RecNo) + '/' + IntToStr(buscas2.RecordCount) + ')');

        buscas.Close;
        buscas.SQL.Text :=
          ' execute procedure movimenta_estoque (' +
          '		:grupo_prod, ' +
          '		:cod_prod, ' +
          '		:cod_empresa, ' +
          '		:cod_grade, ' +
          ' 	:qtde, ' +
          ' 	0, ' +
          ' 	1); ';
        buscas.ParamByName('grupo_prod').AsInteger := buscas2.FieldByName('grupo_prod').AsInteger;
        buscas.ParamByName('cod_prod').AsString := buscas2.FieldByName('cod_prod').AsString;
        buscas.ParamByName('cod_empresa').AsInteger := vDadosIni.cod_empresa;
        buscas.ParamByName('cod_grade').AsInteger := buscas2.FieldByName('cod_grade').AsInteger;
        buscas.ParamByName('qtde').AsFloat := buscas2.FieldByName('quant_ped_item').AsFloat;
        buscas.ExecSQL;

        buscas2.Next;
      end;

      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM PEDVENDA ' +
         ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA; ';
      buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;
    finally
      vDadosIni.fechaStatusProcessamento;
    end;

    try
      vDadosIni.abreStatusProcessamento('', 'Apagando FORMAS DE PAGAMENTO');
      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM FORMPAGAMENTO ' +
         ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA; ';
      buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;
    finally
       vDadosIni.fechaStatusProcessamento;
    end;


    try
      vDadosIni.abreStatusProcessamento('', 'Apagando BOLETAS');
      buscas.Close;
      buscas.SQL.Text := ' DELETE FROM BOLETAS ' +
         ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA; ';
      buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
      buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
      buscas.ExecSQL;
    finally
       vDadosIni.fechaStatusProcessamento;
    end;

    buscas.Close;
    buscas.SQL.Text := ' DELETE FROM GERADOR_OSBOL ' +
       ' WHERE COD_GERADOR = :COD_GERADOR AND COD_EMPRESA = :COD_EMPRESA; ';
    buscas.ParamByName('COD_GERADOR').AsInteger := StrToInt(codGerador);
    buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
    buscas.ExecSQL;

    vDadosIni.GravaAuditoria(
      'CLI210',
      acao,
      'SUCESSO',
      'GERADOR_OSBOL',
      codGerador,
      buscas);

    CommitaTransacao;

    Application.MessageBox('Processo concluído com sucesso!', 'Atenção', 64);
  except
    on E: Exception do
    begin
      Result := False;
      RollBackTransacao;
      vDadosIni.GravaAuditoria(
        'CLI210',
        acao,
        'FALHA',
        'GERADOR_OSBOL',
        codGerador,
        buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;

  Refresh;
end;

function TGeradorOS.gerarContratos(pOrdem: Integer): boolean;
var
	 vValorBoletas, vValorBoletasGer, vValorContratos, vValorContratosGer: Double;
   vDataBanco, vdataVenc: TDateTime;
   buscas2: TIBQuery;
   vInc: Integer;
begin
  try
    buscas2 := TIBQuery.Create(Application);
  	buscas2.Database := buscas.Database;
  	buscas2.Transaction := buscas.Transaction;

    vDataBanco := vDadosIni.getDataBanco(buscas2);

    fTempContratos.FieldByName('COD_CONTRATO').Visible := (not vAGRUPAR_CONTRATOS);
    fTempContratos.FieldByName('DESCR_CONTRATO').Visible := (not vAGRUPAR_CONTRATOS);

    Result := False;

    if not vDadosIni.PesqPros('CLI205', 'GERAR', '', 'CLIENTES_COM_CONTRATO ', '', buscas, true) then
      Exit;

    if vDATA_BASE_VENDA <= 0 then
    	raiseExceptionCreate('Data base documento de venda não informado', 'MaskEditDataBase');

    if vUTILIZA_CXL then
    begin
    	if vCOD_OP_CXL <= 0 then
	      raiseExceptionCreate('Operador CXL não informado', 'EditHwOperadorCXL')
      else
      begin
      	buscas.close;
        buscas.sql.text := ' select col.cod_vendedor, col.cod_empresa from colaborador col ' +
          ' where col.cod_vendedor = ' + IntToStr(vCOD_OP_CXL) +
          ' and col.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and col.ativo = 1 ';
        buscas.open;

        if buscas.isempty then
          raiseExceptionCreate('Operador CXL não encontrado!', 'EditHwOperadorCXL');

        buscas.close;
        buscas.sql.text := ' select * from fecd_cxl fd ' +
          ' where fd.dia_f_cxl = ''' + FormatDateTime('mm/dd/yyyy', vDATA_BASE_VENDA) + ''' ' +
          ' and fd.op_cxl = ' + IntToStr(vCOD_OP_CXL) + ' and (status_cxl is null or status_cxl = '''') ' +
          ' and fd.codigo_emp = ' + vDadosIni.codEmpresa;
        buscas.open;

        if buscas.isempty then
          raiseExceptionCreate('Dia do CXL para o Operador informado não existe ou está fechado!', 'MaskEditDataBase');
      end;
    end;

    if vCOD_COLABORADOR <= 0 then
      raiseExceptionCreate('Colaborador não informado', 'EditHwColaborador')
    else
    begin
      buscas.close;
      buscas.sql.text := ' select col.cod_vendedor, col.cod_empresa from colaborador col ' +
        ' where col.cod_vendedor = ' + IntToStr(vCOD_COLABORADOR) +
        ' and col.cod_empresa = ' + vDadosIni.codEmpresa +
        ' and col.ativo = 1 ';
      buscas.open;

      if buscas.isempty then
        raiseExceptionCreate('Colaborador não encontrado!', 'EditHwColaborador');
    end;

    if vSUB_GRUPO < 0 then
      raiseExceptionCreate('Subgrupo não informado', 'EditHwSubGrupoOS')
		else
    begin
    	buscas.close;
      buscas.sql.text := ' select codigo_subgr, descricao from sub_grupo s ' +
	 			' where codigo_subgr = ' + IntToStr(vSUB_GRUPO) +
        ' and ativo = 1 ';
      buscas.open;

      if buscas.isempty then
        raiseExceptionCreate('Subgrupo não encontrado!', 'EditHwSubGrupoOS');
    end;

    if trim(vSTATUS_TMO) = '' then
      raiseExceptionCreate('Status TMO não informado', 'DBLookupComboBox2');

    if vMES_VENCIMENTO <= 0 then
      raiseExceptionCreate('Mês vencimento não informado', 'EditHwMesVencimento');

    if (vMES_VENCIMENTO <= 0) or (vMES_VENCIMENTO > 12) then
      raiseExceptionCreate('Mês vencimento incorreto', 'EditHwMesVencimento');

    if vANO_VENCIMENTO <= 0 then
      raiseExceptionCreate('Ano vencimento não informado', 'EditHwAnoVencimento');

    if (Length(IntToStr(vANO_VENCIMENTO)) <= 3) or (Length(IntToStr(vANO_VENCIMENTO)) > 4) then
    	raiseExceptionCreate('Ano vencimento incorreto', 'EditHwAnoVencimento');

    if (vDIAS_FAT_INI < 0) then
      raiseExceptionCreate('Dia de faturamento inicial não deve ser menor que 0', 'EditHwDiaFaturamentoIni');

    if (vDIAS_FAT_FIM < 0) then
      raiseExceptionCreate('Dia de faturamento final não deve ser menor que 0', 'EditHwDiaFaturamentoFim');

    if (vDIAS_FAT_FIM > 31) then
      raiseExceptionCreate('Dia de faturamento final não deve ser maior que 31', 'EditHwDiaFaturamentoFim');

    if (vDIAS_FAT_INI > vDIAS_FAT_FIM) then
      raiseExceptionCreate('Dia de faturamento inicial não deve ser maior que o dia de faturamento final', 'EditHwDiaFaturamentoIni');

    buscas.close;
    buscas.sql.text := ' select ((select result from strzero(extract(month from p.data_fech),2))||''/''||' +
      ' (select result from strzero(extract(year from p.data_fech),4))) as MES ' +
      ' from pedvenda p ' +
      ' where p.status_contrato= ''S'' and  (extract(month from p.data_fech)) = ''' + FormatDateTime('mm', vDATA_BASE_VENDA) + ''' ' +
      ' and (extract(year from p.data_fech)) = ''' + FormatDateTime('yyyy', vDATA_BASE_VENDA) + ''' ' +
      ' and p.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and p.status_ped = ''FECHADA'' ';
    buscas.open;
    if not buscas.isempty then
    begin
      vDadosIni.vInibeMensPesqPros := 'S';
    	if not vDadosIni.PesqPros('CLI214', 'PERMITIR', '', 'CLIENTES_COM_CONTRATO ', '', buscas, true) then
	     raiseExceptionCreate('Não é possível emitir novos contratos, Existem Contratos Emitidos neste mês!', 'MaskEditDataBase');
    end;

    frmGeradorOSFormasBoletas.Memo1.Lines.Clear;

    buscas.close;
    buscas.sql.text :=
    	' select cl.cod_cliente, cl.nome_cliente, ctr.valor_contrato, ' +
      ' coalesce(ctr.dia_vencimento, 0) dia_vencimento, ' +
      ' coalesce(ctr.dias_apos_venc, 0) dias_apos_venc, ' +
      ' ctr.cod_controle, ctr.data_inicial_boleto, ctr.cod_servico, serv.desc_servico, serv.codigo_nop, ' +
      ' ctr.data_inicial_vigencia, ctr.tipo_os, ctr.cod_vendedor from clientes_com_contrato ctr ' +
      ' inner join clientes cl on ' +
      '		ctr.cod_cliente = cl.cod_cliente ' +
      '		and ctr.cod_empresa = cl.cod_empresa ' +
      ' inner join tipo_servico serv on ' +
      '		ctr.cod_servico = serv.cod_servico ' +
      ' where ctr.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ctr.cod_servico > 0 ' +
      ' and (serv.codigo_nop = 0 or serv.codigo_nop is null) ' +
      ' and ctr.status = ''Ativo'' ' +
      ' union ' +
      ' select cl.cod_cliente, cl.nome_cliente, ctr.valor_contrato, ' +
      ' coalesce(ctr.dia_vencimento, 0) dia_vencimento, ' +
      ' coalesce(ctr.dias_apos_venc, 0) dias_apos_venc, ' +
      ' ctr.cod_controle, ctr.data_inicial_boleto, ctr_serv.cod_servico, serv.desc_servico, serv.codigo_nop, ' +
      ' ctr.data_inicial_vigencia, ctr.tipo_os, ctr.cod_vendedor from clientes_com_contrato_serv ctr_serv ' +
      ' inner join clientes_com_contrato ctr on ' +
      '		ctr.cod_contrato = ctr_serv.cod_contrato ' +
      '   and ctr.cod_empresa = ctr_serv.cod_empresa ' +
      ' inner join clientes cl on ' +
      '		ctr.cod_cliente = cl.cod_cliente ' +
      '		and ctr.cod_empresa = cl.cod_empresa ' +
      ' inner join tipo_servico serv on ' +
      '		ctr_serv.cod_servico = serv.cod_servico ' +
      ' where ctr_serv.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and ctr_serv.cod_servico > 0 ' +
      ' and ctr.cod_servico = 0 ' +
      ' and (serv.codigo_nop = 0 or serv.codigo_nop is null) ' +
      ' and ctr.status = ''Ativo'' ';
    buscas.open;
    if not buscas.IsEmpty then
    begin
      try
        buscas.DisableControls;
        buscas.First;
        while not buscas.eof do
        begin
          Application.ProcessMessages;

          frmGeradorOSFormasBoletas.Memo1.Lines.Add(copy(buscas.fieldbyname('nome_cliente').AsString, 1, 15) +
            ' SERVICO: ' +
            IntToStr(buscas.FieldByName('cod_servico').AsInteger) + ' ' +
            trim(buscas.FieldByName('desc_servico').AsString) + ' - CFOP');
          buscas.next;
        end;
      finally
        buscas.EnableControls;
      end;
      buscas.close;
      frmGeradorOSFormasBoletas.PageControl1.ActivePage := frmGeradorOSFormasBoletas.TabSheet2;
      frmGeradorOSFormasBoletas.TabSheet2.Show;
      raiseExceptionCreate('Serviço(s) sem o cfop informado!', 'Memo1');
    end;
    buscas.Close;

    if Application.MessageBox('Deseja consultar os contratos cadastrados para gerar faturamento?', 'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
    begin
      Result := false;
      exit;
    end;

    vDadosIni.abreStatusProcessamento('', 'Aguarde... Consultando Contratos');

    buscas.Close;
    if (not vAGRUPAR_CONTRATOS) then
    begin
