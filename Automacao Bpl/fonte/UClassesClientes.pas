  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);
end;

{ TCadClientesContatos }

function TCadClientesContatos.Abrir: TCadClientesContatos;
begin
  FTipo.Abrir;
  Result := Self;
  ClientOpen('select * from clientes_contato where cod_cliente = %d and cod_empresa = %d',
             [FOwner.fint('cod_cliente'), vDadosIni.cod_empresa]);
  dataSet.FieldByName('tipo_id').OnGetText := DataSetGetText;
  dataSet.FieldByName('telefone').EditMask := FOwner.dataSet.FieldByName('fone_cliente').EditMask;
  dataSet.FieldByName('id').Required       := False;
end;

function TCadClientesContatos.Apply: Boolean;
var
  I: Integer;
begin
  prepare_loop();
  try
    while not dataSet.Eof do
    begin
      if fint('cod_cliente') = 0 then
      begin
        dataSet.Edit;
        fdata('cod_cliente').Put(FOwner.fint('cod_cliente'));
        fdata('cod_empresa').Put(vDadosIni.cod_empresa);
        dataSet.Post;
      end;
      dataSet.Next;
    end;
  finally
    prepare_loop_done();
  end;
  if dataSet.ChangeCount > 0 then
  begin
    Result := inherited Apply;
    dataSet.Refresh;
  end
  else
    Result := True;
end;

constructor TCadClientesContatos.Create(AOwer: TCadClientes);
begin
  inherited Create(dtmAtivo.bancoHw, AOwer.transacao);
  FOwner := AOwer;
  FTipo := TTipo_Contato.Create(dtmAtivo.bancoHw);
  TableName := 'CLIENTES_CONTATO';
  FID := 0 - 999999; 
end;

function TCadClientesContatos.DataAudit: string;
begin
  StrAuditoria := Format('%d-%s-%s-%s', [fint('tipo_id'), fstr('contato'), fstr('telefone'), fstr('email')]);
  Result := StrAuditoria;
end;

procedure TCadClientesContatos.DataSetGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
begin
  if Sender.FieldName = 'ID' then
    Text := IfThen(fint('ID') < 0 , '0', fstr('id'))
  else if Sender.FieldName = 'TIPO_ID' then
    if FTipo.Active then    
    begin
    	if fint('tipo_id') <= 0 then
      	Text :=  ''
      else
      begin
      FTipo.dataSet.Locate('ID', fint('tipo_id'), []);
      Text := FTipo.fstr('tipo');
    end;  
end;
end;

function TCadClientesContatos.Delete: Boolean;
begin
  Result := False;
  if dataSet.IsEmpty then
    Exit;

  try
    if not Auditor.Processo('CLI256', DataAudit, KeyAudit).ExigirConfirmacao.Excluir.Permitido then
      Exit;

    //SqlExec('delete from clientes_contato where cod_cliente = %d and id = %d', [fint('cod_cliente'), fint('id')]);
    Result := inherited Delete;

    Auditor.GravarMensagem('EXCLUIDO - AGUARDANDO SALVAR CLIENTE');

  except on E: Exception do
    begin
      transacao.Rollback;
      vDadosIni.ShowErro('Erro ao excluir Contato. Erro: %s', [e.Message]);
      vDadosIni.registraErro('TCadClientesContatos.Delete Erro: ' + e.Message);
    end;
  end;
end;

destructor TCadClientesContatos.Destroy;
begin
  FTipo.Free;
  inherited;
end;

function TCadClientesContatos.KeyAudit: string;
begin
  StrAuditoriaCod := Format('%d-%d', [FOwner.fint('cod_cliente'), fint('id')]);
  Result := StrAuditoriaCod;
end;

function TCadClientesContatos.Post: Boolean;
var
  lista: TStrings;
  I: Integer;
begin
  Result := False;
  try
    if fint('tipo_id') = 0 then
      raiseExceptionCreate('O campo tipo de contato deve ser preenchido', 'ed_contato_tipo');

    if fempty('contato') and fempty('telefone') and fempty('email') then
      raiseExceptionCreate('Pelo menos 1 dos 3 campos deve ser preenchido, "Contato, telefone ou email"', 'ed_contato_contato');

    if not fempty('email') then
    begin
      lista := NewStringList(True, StrReplace(fstr('email'), [';', '/', ' '], ','), ',');
      for I := 0 to lista.Count - 1 do
        if (Trim(lista[i]) <> '') and (not vDadosIni.validaTextoEMail2(Trim(lista[i]))) then
          raiseExceptionCreate('email "' + Trim(lista[i]) + '" informado inválido', 'ed_contato_email');
      fdata('email').Put(StrReplace(fstr('email'), [';', '/', ' '], ','));
    end;

    if fint('id') = 0 then
    begin
      fdata('id').Put(FID);
      FID := FID + 1;
    end;

    fdata('cod_cliente').Put(FOwner.fint('cod_cliente'));
    fdata('cod_empresa').Put(vDadosIni.cod_empresa);
    fdata('id').Put(fint('id'));

    Result := inherited Post;

    Auditor.GravarMensagem(DataAudit);

  except on E: Exception do
    begin
      registraErro('TCadClientesContatos.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);    
    end;
  end;
end;

{ TTipo_Contato }

function TTipo_Contato.Abrir: TTipo_Contato;
begin
  Result := Self;
  ClientOpen('select * from tipo_contato where cod_empresa = %d', [vDadosIni.cod_empresa]);
  TableName := 'TIPO_CONTATO';
end;

function TTipo_Contato.Delete: Boolean;
begin
  Result := False;
  if dataSet.IsEmpty then
    Exit;

  if SqlOpen('select count(*) as contador from clientes_contato where cod_empresa = %d and tipo_id = %d',
             [vDadosIni.cod_empresa, fint('id')]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Tipo de contato está sendo usado em %d registros. Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  if SqlOpen('select count(*) as contador from msg_contato_tipo where cod_empresa = %d and id_tipo_contato = %d',
             [vDadosIni.cod_empresa, fint('id')]).FieldByName('contador').AsInteger > 0 then
  begin
    ShowErro('Tipo de contato está sendo usado em %d registros. Não é permitido excluir', [buscas.FieldByName('contador').AsInteger]);
    Exit;
  end;

  dataSet.Delete;
  if Apply then
  begin
    CommitaTransacao;
    Auditor.Sucesso.Salvar.GravarMensagem('');
    Refresh;
    Result := True;
  end
  else
  begin
    RollBackTransacao;
    Auditor.Falha.Salvar.GravarMensagem('');
    Result := False;
  end;  
end;

function TTipo_Contato.Post: Boolean;
begin
  Result := False;
  try
    if fempty('tipo') then
      raiseExceptionCreate('O tipo de contato deve ser preenchido');

    if not SqlOpen('select tipo from tipo_contato where cod_empresa = %d and tipo = %s and id <> %d',
                   [vDadosIni.cod_empresa, fstrq('tipo'), fint('id')]).IsEmpty then
      raiseExceptionCreate('Já existe um tipo com a mesma descrição');

    fdata('cod_empresa').Put(vDadosIni.cod_empresa);
    fdata('id').Put(IfThen(fint('id') > 0, fint('id')));

    if inherited Post then
    begin
      Result := Apply;
      CommitaTransacao;
      Auditor.Salvar.Sucesso.GravarMensagem(fstr('tipo'));
      Refresh;
    end
    else
    begin
      Result := False;
      RollBackTransacao;
      Auditor.Salvar.Falha.GravarMensagem(fstr('tipo'));
    end;

  except on E: Exception do
    begin
      RollBackTransacao;
      Auditor.Salvar.Falha.GravarMensagem(fstr('tipo'));
      registraErro('TTipo_Contato.Post Erro: ' + e.Message);
      vDadosIni.ShowErro('Erro ao salvar dados' + #13 + #13 + E.Message);    
    end;
  end;
end;

