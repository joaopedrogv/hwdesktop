function TCodigoFornecedor.delete: Boolean;
var
  vOldGrupo, vOldCodigo, vOldCodForn: string;
begin
  Result := False;
  vOldGrupo := dataSet.FieldByName('GRUPO_PROD').AsString;
  vOldCodigo := dataSet.FieldByName('COD_PROD').AsString;
  vOldCodForn := dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString;

  try
    buscas.Close;
    if UpperCase(trim(dataSet.FieldByName('TABELA').AsString)) = 'PRODUTOS_FORN_NFE2' then
	  begin
  		SqlExec(Format(' delete from produtos_forn_nfe2 ' +
      							 ' where cpfcgc = %s ' +
                     ' and grupo_prod = %d ' +
                     ' and cod_prod = %s ' +
                     ' and cod_empresa = %d ' +
                     ' and num_fab_fornecedor = %s ',
                     [QuotedStr(dataSet.FieldByName('CPFCGC').AsString),
                     	dataSet.FieldByName('GRUPO_PROD').AsInteger,
                    	QuotedStr(dataSet.FieldByName('COD_PROD').AsString),
                      dataSet.FieldByName('COD_EMPRESA').AsInteger,
                      QuotedStr(dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString)]));
    end
    else if UpperCase(trim(dataSet.FieldByName('TABELA').AsString)) = 'PRODUTOS_FORN_NFE' then
    begin
      SqlExec(Format(' delete from produtos_forn_nfe ' +
      							 ' where cod_fornecedor = %d ' +
                     ' and grupo_prod = %d ' +
                     ' and cod_prod = %s ' +
                     ' and cod_empresa = %d ' +
                     ' and num_fab_fornecedor = %s ',
                     [dataSet.FieldByName('COD_FORNECEDOR').AsInteger,
                      dataSet.FieldByName('GRUPO_PROD').AsInteger,
                      QuotedStr(dataSet.FieldByName('COD_PROD').AsString),
                      dataSet.FieldByName('COD_EMPRESA').AsInteger,
                      QuotedStr(dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString)]));
    end
    else
    begin
      SqlExec(Format(' delete from codigo_fornecedor' +
        						 ' where COD_FORNECEDOR = %d ' +
                     ' and GRUPO_PROD = %d ' +
                     ' and COD_PROD = %s ' +
                     ' and COD_EMPRESA = %d ' +
                     ' and NUM_FAB_FORNECEDOR = %s ',
      							 [dataSet.FieldByName('COD_FORNECEDOR').AsInteger,
                      dataSet.FieldByName('GRUPO_PROD').AsInteger,
                      QuotedStr(dataSet.FieldByName('COD_PROD').AsString),
                      dataSet.FieldByName('COD_EMPRESA').AsInteger,
                      QuotedStr(dataSet.FieldByName('NUM_FAB_FORNECEDOR').AsString)]));
    end;

    vDadosIni.GravaAuditoria('CLI166', 'EXCLUIR', 'GRUPO: ' + vOldGrupo + ' COD: ' + vOldCodigo +
      ' COD FORN: ' + vOldCodForn, 'CODIGO_FORNECEDOR', '', buscas);

    Result := True;

    dataSet.Refresh;

    fAlteracao := True;
  except

  end;

end;

function TCodigoFornecedor.salvaAteracoes: boolean;
begin

  Result := true;
  if fAlteracao then
  begin

    if Application.MessageBox('Deseja salvar alterações?', 'Confirmação', MB_ICONQUESTION +
      MB_YESNO) = IDYES then
    begin
      CommitaTransacao;
      vDadosIni.GravaAuditoria('CLI166', 'EXCLUIR', 'CONFIRMACAO DE EXCLUSAO', 'CODIGO_FORNECEDOR',
        '', buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('CLI166', 'EXCLUIR', 'NAO CONFIRMACAO DE EXCLUSAO',
        'CODIGO_FORNECEDOR', '', buscas);
    end;

  end;

end;

