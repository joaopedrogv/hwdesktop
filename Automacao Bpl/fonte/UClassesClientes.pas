function TRepliCliente.ReplicaCliente(DataSetCli: TPossivelCliente;
  var status: string): boolean;
var
  i, j,k: integer;
  incluirNaEdicao, vcamps: string;
  RepliEmp: array of string;
begin
  result := true;
  buscas.close;
  buscas.sql.Text := 'select * from TAB_REP where TABELA = ''CLIENTES''';
  buscas.Open;
  //  if not Buscas.isempty then
  vcamps := Buscas.fieldbyname('EXCTO_CAMPO').asstring;
  incluirNaEdicao := Buscas.fieldbyname('INCLUIRNAALTERACAO').asstring;

  buscas.close;
  buscas.sql.Text :=
    'select count(cod_empresa) as qtdemp from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
    vDadosIni.codEmpresa;
  buscas.Open;
  SetLength(RepliEmp, buscas.FieldByName('QTDEMP').asinteger);
  if buscas.FieldByName('QTDEMP').asinteger <> 0 then
  begin
    buscas.close;
    buscas.sql.Text := 'select cod_empresa from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
      vDadosIni.codEmpresa;
    buscas.Open;
    for I := 0 to Length(RepliEmp) - 1 do
    begin
      RepliEmp[i] := buscas.FieldByName('cod_empresa').AsString;
    end;
    if status = 'I' then
    begin
      for I := 0 to Length(RepliEmp) - 1 do
      begin
        if abreRepliCliente(trim(DataSetCli.dataSet.FieldByName('CPFCGC').asstring), RepliEmp[i],
          DataSetCli.dataSet) then
        begin
          if dataSet.IsEmpty then
          begin
            dataSet.Insert;
            for j := 0 to DataSetCli.dataSet.FieldCount - 1 do
            begin
              if pos(Dataset.Fields[j].FieldName, vcamps) = 0 then
                if Dataset.Fields[j].FieldName = DataSetCli.dataSet.Fields[j].FieldName then
                  Dataset.Fields[j].value := DataSetCli.dataSet.Fields[j].value;
            end;
            dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
            dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES',
              DtmClientes.SpIncCodigoRepli, RepliEmp[i]);
            dataSet.FieldByName('ATIVO').AsInteger := 2;
            if not post then
            begin
              Cancel;
              result := false;
              buscas.Close;
              exit;
            end;
          end
          else
          begin
            buscas.close;
            buscas.sql.Text := 'select * from TAB_ALT where TABELA = ''CLIENTES''';
            buscas.Open;
            status := 'E';
            dataSet.Edit;
            buscas.First;
            while not buscas.eof do
            begin
              dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                DataSetCli.dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
              buscas.next;
            end;
            dataSet.FieldByName('ATIVO').AsInteger := 2;
            buscas.Close;
            if not Post then
            begin
              Cancel;
              result := false;
              exit;
            end;
          end;

          if dataSet.ChangeCount > 0 then
          begin
            if apply then
              result := true
            else
            begin
              DataSetCli.GravaLogConfirmacao('CLI028', status, false);
              Application.MessageBox('Erro ao replicar dados do cliente para as outras empresas',
                'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              result := false;
              buscas.Close;
              exit
            end;
          end
          else
            result := false;
        end;
      end;
    end
    else if status = 'E' then
    begin
      buscas.close;
      buscas.sql.Text := 'select * from TAB_ALT where TABELA = ''CLIENTES''';
      buscas.Open;
      for I := 0 to Length(RepliEmp) - 1 do
      begin
        if abreRepliCliente(trim(DataSetCli.dataSet.FieldByName('CPFCGC').asstring), RepliEmp[i],
          DataSetCli.dataSet) then
        begin
          if not dataSet.IsEmpty then
          begin
            status := 'E';
            dataSet.Edit;
            buscas.First;
            while not buscas.eof do
            begin
              dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                DataSetCli.dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
              buscas.next;
            end;
            dataSet.FieldByName('ATIVO').AsInteger := 2;
            if not Post then
            begin
              Cancel;
              result := false;
              buscas.Close;
              exit;
            end;
          end
          else
          begin
            if incluirNaEdicao = 'S' then
            begin
              status := 'I';
              dataSet.insert;
              for j := 0 to DataSetCli.dataSet.FieldCount - 1 do
              begin
                for k := 0 to Dataset.FieldCount - 1 do
                begin
                  if Dataset.Fields[k].FieldName = DataSetCli.dataSet.Fields[j].FieldName then
                    if pos(Dataset.Fields[k].FieldName, vcamps) = 0 then
                    begin
                      Dataset.Fields[k].value := DataSetCli.dataSet.Fields[j].value;
                      break;
                    end;
                end;
              end;
              dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
              dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES',
                DtmClientes.SpIncCodigoRepli, RepliEmp[i]);
              dataSet.FieldByName('ATIVO').AsInteger := 2;
              if not Post then
              begin
                Cancel;
                result := false;
                exit;
              end;
            end;
          end;
          if dataSet.ChangeCount > 0 then
          begin
            if apply then
              result := true
            else
            begin
              Application.MessageBox('Erro ao replicar dados do cliente para as outras empresas',
                'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
              DataSetCli.Cli.GravaLogConfirmacao('CLI028', status, false);
              result := false;
              buscas.Close;
              exit;
            end;
          end
          else
            result := false;
        end;
      end;
    end;
  end;
  buscas.Close;
end;

function TRepliCliente.ReplicaCliente(DataSetCli: TClientDataSet; var status: string): boolean;
var
  i, j, k: integer;
  incluirNaEdicao, vcamps: string;
  RepliEmp: array of string;
  teveAlteracao: boolean;
begin
  try
    teveAlteracao := false;
    result := false;
    if trim(DataSetCli.FieldByName('CPFCGC').AsString) = '' then
    begin
      Application.MessageBox('Replicação de dados do cliente para as outras empresas não é possível para cliente sem CPF ou CNPJ.', 'Aviso', MB_OK + MB_ICONASTERISK + MB_DEFBUTTON1);
      exit;
    end;
    buscas.close;
    buscas.sql.Text := 'select * from TAB_REP where TABELA = ''CLIENTES''';
    buscas.Open;
    vcamps := Buscas.fieldbyname('EXCTO_CAMPO').asstring;
    incluirNaEdicao := Buscas.fieldbyname('INCLUIRNAALTERACAO').asstring;

    buscas.close;
    buscas.sql.Text :=
      'select count(cod_empresa) as qtdemp from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
      vDadosIni.codEmpresa;
    buscas.Open;
    SetLength(RepliEmp, buscas.FieldByName('QTDEMP').asinteger);
    if buscas.FieldByName('QTDEMP').asinteger <> 0 then
    begin
      buscas.close;
      buscas.sql.Text := 'select cod_empresa from EMPRESA where ativo = 1 and COD_EMPRESA <> ' +
        vDadosIni.codEmpresa;
      buscas.Open;
      buscas.First;
      for I := 0 to Length(RepliEmp) - 1 do
      begin
        RepliEmp[i] := buscas.FieldByName('cod_empresa').AsString;
        buscas.Next;
      end;
      if status = 'INSERIR' then
      begin
        for I := 0 to Length(RepliEmp) - 1 do
        begin
          if abreRepliCliente(trim(DataSetCli.FieldByName('CPFCGC').asstring), RepliEmp[i],
            DataSetCli) then
          begin
            if dataSet.IsEmpty then
            begin
              dataSet.Insert;

              for j := 0 to DataSetCli.FieldCount - 1 do
              begin
                for k := 0 to Dataset.FieldCount - 1 do
                begin
                  if Dataset.Fields[k].FieldName = DataSetCli.Fields[j].FieldName then
                    if pos(Dataset.Fields[k].FieldName, vcamps) = 0 then
                    begin
                      Dataset.Fields[k].value := DataSetCli.Fields[j].value;
                      break;
                    end;
                end;
              end;
              dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
              dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES',
                DtmClientes.SpIncCodigoRepli, RepliEmp[i]);
              dataSet.FieldByName('ATIVO').AsInteger := 1;
              result := inherited post;
              if (result) and (dataSet.ChangeCount > 0) then
                teveAlteracao := true;
              if result then
                result := Apply;
              if result then
                result := CommitaTransacao;
              if result then
                vDadosIni.GravaAuditoria('CLI028', status, 'SUCESSO', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas)
              else
                vDadosIni.GravaAuditoria('CLI028', status, 'FALHA', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas);
            end
            else
            begin
              buscas.close;
              buscas.sql.Text := 'select * from TAB_ALT where TABELA = ''CLIENTES''';
              buscas.Open;
              status := 'EDITAR';
              inherited Edit;
              buscas.First;
              while not buscas.eof do
              begin
                dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                  DataSetCli.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
                buscas.next;
              end;
              dataSet.FieldByName('ATIVO').AsInteger := 1;
              buscas.Close;
              result := inherited post;
              if (result) and (dataSet.ChangeCount > 0) then
                teveAlteracao := true;
              if result then
                result := Apply;
              if result then
                result := CommitaTransacao;
              if result then
                vDadosIni.GravaAuditoria('CLI028', status, 'SUCESSO', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas)
              else
                vDadosIni.GravaAuditoria('CLI028', status, 'FALHA', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas);
            end;
          end;
        end;
      end
      else if status = 'EDITAR' then
      begin
        for I := 0 to Length(RepliEmp) - 1 do
        begin
          if abreRepliCliente(trim(DataSetCli.FieldByName('CPFCGC').asstring), RepliEmp[i],
            DataSetCli) then
          begin
            if not dataSet.IsEmpty then
            begin
              buscas.close;
              buscas.sql.Text := 'select * from TAB_ALT where TABELA = ''CLIENTES''';
              buscas.Open;
              status := 'EDITAR';
              inherited Edit;
              buscas.First;
              while not buscas.eof do
              begin
                dataSet.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value :=
                  DataSetCli.FieldByName(trim(buscas.fieldbyname('CAMPO_ALT').asstring)).value;
                buscas.next;
              end;
              dataSet.FieldByName('ATIVO').AsInteger := 1;
              result := inherited post;
              if (result) and (dataSet.ChangeCount > 0) then
                teveAlteracao := true;
              if result then
                result := Apply;
              if result then
                result := CommitaTransacao;
              if result then
                vDadosIni.GravaAuditoria('CLI028', status, 'SUCESSO', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas)
              else
                vDadosIni.GravaAuditoria('CLI028', status, 'FALHA', 'CLIENTES',
                  DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas);
            end
            else
            begin
              if incluirNaEdicao = 'S' then
              begin
                status := 'INSERIR';
                dataSet.insert;
                for j := 0 to DataSetCli.FieldCount - 1 do
                begin
                  for k := 0 to Dataset.FieldCount - 1 do
                  begin
                    if Dataset.Fields[k].FieldName = DataSetCli.Fields[j].FieldName then
                      if pos(Dataset.Fields[k].FieldName, vcamps) = 0 then
                      begin
                        Dataset.Fields[k].value := DataSetCli.Fields[j].value;
                        break;
                      end;
                  end;
                end;
                dataSet.FieldByName('COD_EMPRESA').asinteger := strtoint(RepliEmp[i]);
                dataSet.FieldByName('COD_CLIENTE').AsInteger := Gencodigo('CLIENTES',
                  DtmClientes.SpIncCodigoRepli, RepliEmp[i]);
                dataSet.FieldByName('ATIVO').AsInteger := 1;
                result := inherited post;
                if (result) and (dataSet.ChangeCount > 0) then
                  teveAlteracao := true;
                if result then
                  result := Apply;
                if result then
                  result := CommitaTransacao;
                if result then
                  vDadosIni.GravaAuditoria('CLI028', status, 'SUCESSO', 'CLIENTES',
                    DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas)
                else
                  vDadosIni.GravaAuditoria('CLI028', status, 'FALHA', 'CLIENTES',
                    DataSetCli.FieldByName('COD_CLIENTE').AsString, buscas);
              end;
            end;
          end;
        end;
      end;
    end;
    if (not result) and teveAlteracao then
      Application.MessageBox('Erro ao replicar dados do cliente para as outras empresas.', 'Aviso',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
  except
    on e: Exception do
    begin
      Result := False;
      Cancel;
      RollBackTransacao;
      Application.MessageBox('Erro ao replicar dados do cliente para as outras empresas.', 'Aviso',
        MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      registraErro(e.Message);
    end;
  end;
end;

