function TCadClientes._defineSqlAdicional: boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  vCampoTemp, vCampoTempAd, vCondicaoTmp, vCondicaoTmpAd: string;
begin
  result := true;
  vCons.sqladicional := '';

  vCampoTemp := '';
  if UpperCase(trim(vCons.campo)) = 'LOCALIDADE' then
    vCampoTemp := 'LOCALIDADE.LOCALIDADE'
  else if UpperCase(trim(vCons.campo)) = 'SETOR' then
    vCampoTemp := 'SETOR.SETOR';

   if Trim(vCampoTemp) <> '' then
   begin
     vCons.valor := UpperCase(trim(vCons.valor));
     
     vCondicaoTmp := trim(vCons.condicao);
     if vCondicaoTmp = 'Igual' then
       vCondicaoTmp := '='
     else if vCondicaoTmp = 'Maior' then
       vCondicaoTmp := '>'
     else if vCondicaoTmp = 'Maior ou Igual' then
       vCondicaoTmp := '>='
     else if vCondicaoTmp = 'Menor' then
       vCondicaoTmp := '<'
     else if vCondicaoTmp = 'Menor ou Igual' then
       vCondicaoTmp := '<='
     else if vCondicaoTmp = 'Diferente' then
       vCondicaoTmp := '<>'
     else if (vCondicaoTmp = 'Esta contido') then
       vCondicaoTmp := 'like'
     else if (vCondicaoTmp = 'Começa') then
       vCondicaoTmp := 'Começa'
     else
       vCondicaoTmp := '=';

     if vCondicaoTmp = 'like' then
       vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTemp + ' like ' + QuotedStr('%' + vCons.valor + '%')
     else if vCondicaoTmp = 'Começa' then
       vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTemp + ' like ' + QuotedStr(vCons.valor + '%')
     else
       vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTemp + ' ' + vCondicaoTmp + ' ' + QuotedStr(vCons.valor);

     vCons.valor := '';
     vCons.campo := 'Todos';
     vCons.ordem := vCampoTemp;
   end;

  if vCons.comCtr then
    if (trim(vCons.statusCtr) <> '') and (UpperCase(trim(vCons.statusCtr)) <> 'TODOS') then
      vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' TRIM(CLIENTES_COM_CONTRATO.STATUS) = ' + QuotedStr(trim(vCons.statusCtr));

  if vCons.adicional then
  begin
    if (UpperCase(trim(vCons.campoAd)) <> 'TIPO') and (trim(vCons.tipoCl) <> '') then
      if trim(vCons.tipoCl) = 'A' then
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.TIPO = ' + QuotedStr(trim(vCons.tipoCl))
      else
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' (CLIENTES.TIPO = ' + QuotedStr(trim(vCons.tipoCl)) + ' or CLIENTES.TIPO = ''A'') ';

    if (trim(vCons.diaIniAniv) <> '')
    	and (trim(vCons.diaFimAniv) <> '')
      and (trim(vCons.mesAniv) <> '') then
    begin
      vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') +
        ' extract(DAY from CLIENTES.DATA_NASC) >= ' + trim(vCons.diaIniAniv) +
        ' and extract(DAY from CLIENTES.DATA_NASC) <= ' + trim(vCons.diaFimAniv) +
        ' and extract(MONTH from CLIENTES.DATA_NASC) = ' + trim(vCons.mesAniv);
    end;

    if (trim(vCons.qtdeCompras) <> '')
    	or (trim(vCons.somaCompras) <> '')
      or (trim(vCons.clientesAssiduos) <> '')
      or (trim(vCons.atrasoCompras) <> '')
      or (trim(vCons.lucroClientes) <> '') then
    begin
      if trim(vCons.qtdeCompras) <> '' then
      begin
        if vCons.veiculos then
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLQTDVEICULO = ' + QuotedStr(trim(vCons.qtdeCompras))
        else
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLQTDCOMPRA = ' + QuotedStr(trim(vCons.qtdeCompras));
      end;

      if trim(vCons.somaCompras) <> '' then
      begin
        if vCons.veiculos then
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLSOMAVEICULO = ' + QuotedStr(trim(vCons.somaCompras))
        else
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLSOMACOMPRA = ' + QuotedStr(trim(vCons.somaCompras));
      end;

      if trim(vCons.clientesAssiduos) <> '' then
      begin
        if vCons.veiculos then
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLULTIMOVEICULO = ' + QuotedStr(trim(vCons.clientesAssiduos))
        else
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLULTIMACOMPRA = ' + QuotedStr(trim(vCons.clientesAssiduos));
      end;

      if trim(vCons.atrasoCompras) <> '' then
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLATRASOCOMPRA = ' + QuotedStr(trim(vCons.atrasoCompras));

      if trim(vCons.lucroClientes) <> '' then
      begin
        if vCons.veiculos then
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLLUCROVEICULO = ' + QuotedStr(trim(vCons.lucroClientes))
        else
          vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.CLLUCROCLIENTE = ' + QuotedStr(trim(vCons.lucroClientes));
      end;
    end;

    vCons.valorAd := UpperCase(trim(vCons.valorAd));
    if vCons.porDataAd then
    begin
      try
        erro := 0;
        StrToDate(vCons.dataIniAd);
      except
        vCons.dataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(vCons.dataFimAd);
      except
        vCons.dataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if vCons.dataIniAd <> '' then
          vCons.dataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(vCons.dataIniAd)));
        if vCons.dataFimAd <> '' then
          vCons.dataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(vCons.dataFimAd)));
      end;
    end
    else if vCons.valorAd = '' then
      exit;

    vCampoTempAd := '';
    if UpperCase(trim(vCons.campoAd)) = 'LOCALIDADE' then
      vCampoTempAd := 'LOCALIDADE.LOCALIDADE'
    else if UpperCase(trim(vCons.campoAd)) = 'SETOR' then
      vCampoTempAd := 'SETOR.SETOR';

    if Trim(vCampoTempAd) <> '' then
    begin
      vCondicaoTmpAd := trim(vCons.condicaoAd);
      if vCondicaoTmpAd = 'Igual' then
        vCondicaoTmpAd := '='
      else if vCondicaoTmpAd = 'Maior' then
        vCondicaoTmpAd := '>'
      else if vCondicaoTmpAd = 'Maior ou Igual' then
        vCondicaoTmpAd := '>='
      else if vCondicaoTmpAd = 'Menor' then
        vCondicaoTmpAd := '<'
      else if vCondicaoTmpAd = 'Menor ou Igual' then
        vCondicaoTmpAd := '<='
      else if vCondicaoTmpAd = 'Diferente' then
        vCondicaoTmpAd := '<>'
      else if (vCondicaoTmpAd = 'Esta contido') then
        vCondicaoTmpAd := 'like'
      else if (vCondicaoTmpAd = 'Começa') then
        vCondicaoTmpAd := 'Começa'
      else
        vCondicaoTmpAd := '=';

      if vCondicaoTmpAd = 'like' then
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTempAd + ' like ' + QuotedStr('%' + vCons.valorAd + '%')
      else if vCondicaoTmpAd = 'Começa' then
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTempAd + ' like ' + QuotedStr(vCons.valorAd + '%')
      else
        vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + vCampoTempAd + ' ' + vCondicaoTmpAd + ' ' + QuotedStr(vCons.valorAd);

      vCons.valorAd := '';
      Exit;
    end;

    if vCons.condicaoAd = 'Igual' then
      vCons.condicaoAd := '='
    else if vCons.condicaoAd = 'Maior' then
      vCons.condicaoAd := '>'
    else if vCons.condicaoAd = 'Maior ou Igual' then
      vCons.condicaoAd := '>='
    else if vCons.condicaoAd = 'Menor' then
      vCons.condicaoAd := '<'
    else if vCons.condicaoAd = 'Menor ou Igual' then
      vCons.condicaoAd := '<='
    else if vCons.condicaoAd = 'Diferente' then
      vCons.condicaoAd := '<>'
    else if (vCons.condicaoAd = 'Esta contido') then
      vCons.condicaoAd := 'like'
    else if (vCons.condicaoAd = 'Começa') then
      vCons.condicaoAd := 'Começa'
    else
      vCons.condicaoAd := '=';
      
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(vCons.campoAd) then
        begin
          vCons.campoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((vCons.condicaoAd = 'Começa') or (vCons.condicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(vCons.valorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(vCons.valorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            vCons.condicaoAd := '=';
            vCons.valorAd := vDadosIni.trocaVirgulaPorPonto(vCons.valorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if (vCons.dataIniAd <> '') and (vCons.dataFimAd <> '') then
              vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd + ' >= ' + vCons.dataIniAd + ' AND ' + ' CLIENTES.' + vCons.campoAd + ' <= ' + vCons.dataFimAd
            else if (vCons.dataFimAd <> '') then
              vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd + ' <= ' + vCons.dataIniAd
            else if (vCons.dataIniAd <> '') and (vCons.dataFimAd <> '') then
              vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd + ' >= ' + ' CLIENTES.' + vCons.dataIniAd;
            Break;
          end;

          if vCons.condicaoAd = 'like' then
            vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd +
              ' like ' + QuotedStr('%' + vCons.valorAd + '%')
          else if vCons.condicaoAd = 'Começa' then
            vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd +
              ' like ' + QuotedStr(vCons.valorAd + '%')
          else
            vCons.sqladicional := vCons.sqladicional + IfThen(trim(vCons.sqladicional) <> '', ' and ', ' ') + ' CLIENTES.' + vCons.campoAd + ' ' + vCons.condicaoAd + ' ' + QuotedStr(vCons.valorAd);
          Break;
        end;
      end;
    end;
  end;
end;

function TCadClientes._deletarFoto: boolean;
begin
  result := false;
  if Foto.dataSet.FieldByName('TIPO').AsInteger = 1 then
   if Application.MessageBox('Tem certeza que deseja deletar a foto do cliente?',
     'Apagar Foto', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
     exit;

  if Foto.dataSet.FieldByName('TIPO').AsInteger <> 1 then
    if Application.MessageBox('Tem certeza que deseja deletar o documento do cliente?',
      'Apagar Foto', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) = IDNO then
      exit;

  if not vDadosIni.PesqPros('CLI172', 'DELETAR', '', 'FOTOS',
    dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
    Exit;
  if Foto.IsEmpty then
    exit;
  result := Foto.Delete;
  if Result then
    result := Foto.Apply;
  if Result then
    _recuperarFotoCliente;
end;

procedure TCadClientes._desmarcarTodos;
begin
  try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');

    if not dataSet.Active then
      Exit;

    checkUnCheckAllRows(False); 
    {
    dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      dataSet.Edit;
      dataSet.FieldByName('sel').AsString := '';
      dataSet.Post;
      dataSet.Next;
    end;
    dataSet.First;
    }
  finally
    dataSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

procedure TCadClientes._desmarcarTodosSituacaoDeCaixa;
begin
	if fTempEmpresas.IsEmpty then
  	exit;

  if not vDadosIni.PesqPros('CLI270', 'DESMARCAR EMPRESA', '', 'CLIENTES', '', buscas, true) then
    exit;
    
	try
    vDadosIni.abreStatusProcessamento('', 'Aguarde. Desfazendo a seleção de todos os registros');
    fTempEmpresas.DisableControls;

    fTempEmpresas.First;
    while not fTempEmpresas.Eof do
    begin
      fTempEmpresas.Edit;
      if fTempEmpresas.FieldByName('cod_empresa').AsInteger = StrToInt(vDadosIni.codEmpresa) then
      	fTempEmpresas.FieldByName('sel').AsString := 'S'
      else
	      fTempEmpresas.FieldByName('sel').AsString := '';
      fTempEmpresas.Post;

      vDadosIni.GravaAuditoria('CLI270', 'DESMARCAR EMPRESA', '',
      	'CLIENTES', IntToStr(fTempEmpresas.FieldByName('COD_EMPRESA').AsInteger), buscas);
      
      fTempEmpresas.Next;
    end;
    fTempEmpresas.First;

    AtualizarSituacaoCaixa(false);

    Application.MessageBox(pchar('Não é possível desmarcar todas empresas.'), 'Atenção', MB_ICONERROR + MB_OK);
  finally
  	fTempEmpresas.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end
end;

function TCadClientes._enviarEmailCliente(pEmLote: boolean; pAnexoModeloCarta: boolean; pCodModeloCarta: integer; pTelaCadastro: integer): boolean;
var
  formulario: TfrmPadrao;
  xAnexo, i: Integer;
  IdAnexo: TIdAttachmentFile;
  AuthSSL: TIdSSLIOHandlerSocketOpenSSL;
  IdSMTP : TIdSMTP;
  IdMessage : TIdMessage;
  htmpart, txtpart, parentPart: TIdText;
  vData: TDate;
  vLogDeErros: TStringList;
  html, linhaEmBranco: ansistring;
  IdUserPassProvider: TIdUserPassProvider;
  IdSASLCRAMMD5 : TIdSASLCRAMMD5;
//  IdSASLCRAMSHA1 : TIdSASLCRAMSHA1;
  IdSASLPlain : TIdSASLPlain;
  IdSASLLogin : TIdSASLLogin;
  IdSASLSKey : TIdSASLSKey;
  IdSASLOTP : TIdSASLOTP;
  AdressList, CCList, BCCList: TStrings;
  RetornoDll: string;
//  IdSASLAnonymous : TIdSASLAnonymous;
//  IdSASLExternal : TIdSASLExternal;
begin
  result := false;
  if not vDadosIni.PesqPros('CLI180', 'ENVIAR E-MAIL AO CLIENTE', 'INICIANDO PROCESSO', 'CLIENTES', dataSet.FieldByName('COD_CLIENTE').AsString, buscas, True) then
    exit;

  linhaEmBranco := '<html xmlns="http://www.w3.org/1999/xhtml"> ' +
    ' <head> <meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> ' +
    ' </head> <body> <p>&nbsp;</p> <p>&nbsp;</p> </body> </html> ';
  dataSet.Filtered := false;
  dataSet.Filter := 'SEL=''S'' ';
  dataSet.Filtered := true;
  if IsEmpty then
  begin
    Application.MessageBox('Nenhum cliente selecionado para o envio de email', 'Informação', MB_OK);
    dataSet.Filtered := false;
    exit;
  end;
  dataSet.First;

  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 620;
    formulario.Height := 500;
    formulario.Position := poScreenCenter;
    formulario.Caption := 'Enviar E-mail ao cliente';
    FrmCadClientes.CheckBoxEmail.Checked := false;
    FrmCadClientes.labelremetente.caption := 'Remetente : "' + vDadosIni.vEmp.vRemetente_email_cobranca + '"' + '  <' + vDadosIni.vEmp.vEmail_cobranca + '>';
    FrmCadClientes.RichEditMsg.Clear;
    FrmCadClientes.RichEditMsg2.Clear;
    FrmCadClientes.RichEditMsg3.Clear;
    FrmCadClientes.EditAssunto.Text := ''; //vDadosIni.vEmp.vAssunto_cobranca;
    FrmCadClientes.EditCC.Text := '';
    FrmCadClientes.EditCCO.Text := '';
    FrmCadClientes.MemoAnexos.Clear;
    FrmCadClientes.EditPara.Text := dataSet.FieldByName('email').AsString;
    FrmCadClientes.pnEnviarCartaViaEmail.Parent := formulario;
    _litaModelosCarta(FrmCadClientes.ComboBoxModeloCarta);
    buscas.Close;
    if pTelaCadastro = 7 then
    begin
     	FrmCadClientes.EditAssunto.Text := vDadosIni.vSugServico.vAssuntoPadraoEmail;
      FrmCadClientes.RichEditMsg.Lines.Text := vDadosIni.vSugServico.vMensagemPadraoEmail.Text;
    end;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.KeyPreview := True;
    vLogDeErros := TStringList.Create();
    result := (formulario.ShowModal = IDOK);

  finally
    try
      if result then
      begin
        IdSMTP := TIdSMTP.Create(nil);
        IdMessage := TIdMessage.Create(nil);
        pEmLote := FrmCadClientes.CheckBoxEmail.Checked;
        pAnexoModeloCarta := FrmCadClientes.CheckModeloCarta.Checked;
        if pAnexoModeloCarta then
          if vDadosIni.isnumeroint(trim(copy(FrmCadClientes.ComboBoxModeloCarta.Text, 1, pos('|', FrmCadClientes.ComboBoxModeloCarta.Text) - 1))) then
            pCodModeloCarta := strtoint(trim(copy(FrmCadClientes.ComboBoxModeloCarta.Text, 1, pos('|', FrmCadClientes.ComboBoxModeloCarta.Text) - 1)));

        if not pEmLote then
        begin
          IdMessage.Recipients.Clear;
          if not _ValidarEMail(trim(FrmCadClientes.EditPara.Text), true) then
          begin
            vLogDeErros.Add('CLIENTE: ' + dataSet.FieldByName('COD_CLIENTE').AsString + ' - ' +
              trim(dataSet.FieldByName('NOME_CLIENTE').AsString) + ' | E-Mail: ' +
              trim(dataSet.FieldByName('email').AsString));
          end
          else
          begin
            try
              vDadosIni.abreStatusProcessamento('', 'Enviando e-mail para o cliente: ' +
                dataSet.FieldByName('COD_CLIENTE').AsString + ' - ' +
                trim(dataSet.FieldByName('NOME_CLIENTE').AsString));
              IdMessage.Recipients.EMailAddresses := FrmCadClientes.EditPara.Text;
              IdMessage.CCList.EMailAddresses := FrmCadClientes.EditCC.Text;
              IdMessage.BccList.EMailAddresses := FrmCadClientes.EditCCO.Text;
              IdMessage.Subject := FrmCadClientes.EditAssunto.Text + ' - ' + DateTimeToStr(vDadosIni.getDataHoraBanco(buscas));
              IdMessage.CharSet := 'ISO-8859-1';
              IdMessage.Date := vDadosIni.getDataHoraBanco(buscas);
              IdMessage.From.Address := vDadosIni.vEmp.vEmail_cobranca;
              IdMessage.From.Name := vDadosIni.vEmp.vRemetente_email_cobranca;
              IdMessage.ContentType := 'multipart/mixed'; //'multipart/related';//'multipart/alternative';//mixed';
        //      IdMessage.ContentDisposition := 'inline';
              IdMessage.Encoding := meMIME;
              IdMessage.IsEncoded := true;
              IdMessage.MessageParts.Clear;
              IdMessage.Body.Clear;

              IdSMTP.Host := vDadosIni.vEmp.vSmtp_cobranca;
              IdSMTP.Username := vDadosIni.vEmp.vLogin_cobranca;
              IdSMTP.Password := vDadosIni.vEmp.vSenha_email_cobranca;
              if vDadosIni.vEmp.vEmailUsaSegurancaSSL then
              begin
                AuthSSL := TIdSSLIOHandlerSocketOpenSSL.Create(nil);
                IdSMTP.IOHandler := AuthSSL;
                IdSMTP.UseTLS := utUseImplicitTLS;
                AuthSSL.SSLOptions.Method := sslvSSLv3;
                AuthSSL.SSLOptions.Mode   := sslmClient;
                if vDadosIni.vEmp.vSmtpporta_cobranca = 0 then
                  IdSMTP.Port := 465  //ou 587 em alguns servidores
                else
                	IdSMTP.Port := vDadosIni.vEmp.vSmtpporta_cobranca;
              end
              else
              begin
                if vDadosIni.vEmp.vSmtpporta_cobranca = 0 then
                  IdSMTP.Port := 25  //ou 587 em alguns servidores
                else  IdSMTP.Port := vDadosIni.vEmp.vSmtpporta_cobranca;
              end;

              if vDadosIni.vEmp.vEmailUsaAutenticacao then
              begin
                IdSMTP.AuthType := atSASL;
                IdUserPassProvider := TIdUserPassProvider.Create(IdSMTP);
                IdUserPassProvider.Username := vDadosIni.vEmp.vLogin_cobranca;
                IdUserPassProvider.Password := vDadosIni.vEmp.vSenha_email_cobranca;
                IdSASLCRAMMD5 := TIdSASLCRAMMD5.Create(IdSMTP);
                IdSASLCRAMMD5.UserPassProvider := IdUserPassProvider;
////                IdSASLCRAMSHA1 := TIdSASLCRAMSHA1.Create(IdSMTP);
////                IdSASLCRAMSHA1.UserPassProvider := IdUserPassProvider;
                IdSASLPlain := TIdSASLPlain.Create(IdSMTP);
                IdSASLPlain.UserPassProvider := IdUserPassProvider;
                IdSASLLogin := TIdSASLLogin.Create(IdSMTP);  // same as sasDefault
                IdSASLLogin.UserPassProvider := IdUserPassProvider;
                IdSASLSKey := TIdSASLSKey.Create(IdSMTP);
                IdSASLSKey.UserPassProvider := IdUserPassProvider;
                IdSASLOTP := TIdSASLOTP.Create(IdSMTP);
                IdSASLOTP.UserPassProvider := IdUserPassProvider;
//                IdSASLAnonymous := TIdSASLAnonymous.Create(IdSMTP);  // doesnt use a IdUserPassProvider
//                IdSASLExternal := TIdSASLExternal.Create(IdSMTP);  // doesnt use a IdUserPassProvider
                IdSMTP.SASLMechanisms.Clear;
                with IdSMTP.SASLMechanisms.Add do
                begin
                  SASL := IdSASLCRAMMD5;
////                  SASL := IdSASLCRAMSHA1;
                  SASL := IdSASLPlain;
                  SASL := IdSASLSKey;
                  SASL := IdSASLOTP;
                  SASL := IdSASLLogin;
//                  SASL := IdSASLAnonymous;
//                  SASL := IdSASLExternal;
                end;
              end
              else
                IdSMTP.AuthType := atNone;

              //Trata a Prioridade da mensagem
              case FrmCadClientes.ComboBoxPrioridade.ItemIndex of
                0: IdMessage.Priority := mpHigh;
                1: IdMessage.Priority := mpNormal;
                2: IdMessage.Priority := mpLow;
              end;

              {txtpart := TIdText.Create(IdMessage.MessageParts);
              txtpart.Body.Text := FrmCadClientes.RichEditMsg.Lines.Text;
              txtpart.ContentType := 'text/plain';
              txtpart.ContentTransfer :='7bit';

              parentPart := TIdText.Create(IdMessage.MessageParts);
              parentPart.ContentType := 'multipart/related';
              parentPart.Body.Clear;}

    //          IdMessage.Body.Text := FrmCadClientes.RichEditMsg.Text;

              if FrmCadClientes.tsMsgEmail1.PageIndex = 0 then
                html := vDadosIni._RichTextTOHTML(FrmCadClientes.RichEditMsg)
              else if FrmCadClientes.tsMsgEmail2.PageIndex = 0 then
                html := FrmCadClientes.RichEditMsg2.Lines.Text
              else html := vDadosIni._RichTextTOHTML(FrmCadClientes.RichEditMsg3);

              if FrmCadClientes.tsMsgEmail1.PageIndex = 1 then
                html := html + linhaEmBranco + vDadosIni._RichTextTOHTML(FrmCadClientes.RichEditMsg)
              else if FrmCadClientes.tsMsgEmail2.PageIndex = 1 then
                html := html + linhaEmBranco + FrmCadClientes.RichEditMsg2.Lines.Text
              else html := html + linhaEmBranco + vDadosIni._RichTextTOHTML(FrmCadClientes.RichEditMsg3);

              if FrmCadClientes.tsMsgEmail1.PageIndex = 2 then
                html := html + linhaEmBranco + vDadosIni._RichTextTOHTML(FrmCadClientes.RichEditMsg)
              else if FrmCadClientes.tsMsgEmail2.PageIndex = 2 then
