        vDadosIni.GravaAuditoria('VND300', 'GERAR ZIP - NFS', 'FALHA', 'PEDVENDA', '', buscas);

      if (cNfe in pArrayOrigem) and (pEnviar) then
        vDadosIni.GravaAuditoria('VND272', 'ENVIAR - NF', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cNfe in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('VND273', 'IMPRIMIR - NF', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cNfe in pArrayOrigem) and (pGerarZip) then
        vDadosIni.GravaAuditoria('VND301', 'GERAR ZIP - NF', 'FALHA', 'PEDVENDA', '', buscas);

      if (cReciboLoc in pArrayOrigem) and (pEnviar) then
        vDadosIni.GravaAuditoria('VND275', 'ENVIAR - REC LOC ', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cReciboLoc in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('VND274', 'IMPRIMIR - REC LOC', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cReciboLoc in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('VND302', 'GERAR ZIP - REC LOC', 'FALHA', 'PEDVENDA', '', buscas);

      if (cBoleto in pArrayOrigem) and (pEnviar) then
        vDadosIni.GravaAuditoria('BOL038', 'ENVIAR - BOL', 'FALHA', 'PEDVENDA', '', buscas)
      else if (cBoleto in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('BOL010', 'IMPRIMIR - BOL', 'FALHA',	'PEDVENDA', '', buscas)
      else if (cBoleto in pArrayOrigem) and (pImprimir) then
        vDadosIni.GravaAuditoria('BOL042', 'GERAR ZIP - BOL', 'FALHA',	'PEDVENDA', '', buscas);

      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TEnviarContratosClientes.getArquivosBoletoParaAnexos(
	pNumOS: Integer;
  pTipo: string;
  pCodbrebem: Integer;
	pListaBol: TStringList): TStringList;
var
  AFileHTML: TStrings;
  AFileSettings: TStrings;
  ANameHtml, ANamePDF: string;
  I: Integer;
begin
	try
  	Result := TStringList.Create;
    Result.Duplicates := dupIgnore;

    SqlOpen(' select tipo_api from cobrebem ' +
            ' where cod_cobrebem = ' + IntToStr(pCodBrebem) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ativo = 1 ', buscas);

    if buscas.FieldByName('TIPO_API').AsString = 'S' then
    begin
    	for I := 0 to pListaBol.Count - 1 do
      begin
        SqlOpen(' select n_seq_bol, htmlboleto from boletas ' +
                ' where n_seq_bol = ' + pListaBol[I] +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and ativo = 1 ', buscas);

        if not buscas.IsEmpty then
        begin
          ANamePDF := ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + 'bol_' +
          	IntToStr(buscas.FieldByName('N_SEQ_BOL').AsInteger) + '.pdf';

          ANamePDF := Base64Helper.DecodeFile(
          	Copy(buscas.FieldByName('htmlboleto').AsString,
            	Pos('|', buscas.FieldByName('htmlboleto').AsString) + 1,
            	Length(buscas.FieldByName('htmlboleto').AsString)), ANamePDF);
              
        	if FileExists(ANamePDF) then
            Result.Add(ANamePDF);
        end;
      end
    end
    else
    begin
      AFileHTML := TStringList.Create;
      AFileSettings := TStringList.Create;
      AFileSettings.Clear;

      AFileSettings.Add('[Settings]');
      AFileSettings.Add('HTML=');
      AFileSettings.Add('PDF=');
      AFileSettings.Add('OpenAfterSave=0');

      for I := 0 to pListaBol.Count - 1 do
      begin
        SqlOpen(' select n_seq_bol, htmlboleto from boletas ' +
                ' where n_seq_bol = ' + pListaBol[I] +
                ' and cod_empresa = ' + vDadosIni.codEmpresa +
                ' and ativo = 1 ', buscas);

        if not buscas.IsEmpty then
        begin
          AFileHTML.Text := buscas.FieldByName('htmlboleto').AsString;

          if AFileHTML.Count > 0 then
          begin
            ANameHTML := ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + 'bol_' +
              IntToStr(buscas.FieldByName('n_seq_bol').AsInteger) + '.html';
            ANamePDF := ExtractFilePath(Application.ExeName) + '\TempCtrNF\' +  'bol_' +
              IntToStr(buscas.FieldByName('n_seq_bol').AsInteger) + '.pdf';

            AFileHTML.SaveToFile(ANameHtml);

            AFileSettings[1] := 'HTML=' + ANameHtml;
            AFileSettings[2] := 'PDF=' + ANamePDF;
            AFileSettings.SaveToFile(ExtractFilePath(Application.ExeName) + 'htm2pdf.ini');
            CreateProcessSimple('htm2pdf.exe "' + ANameHtml + '" "' + ANamePDF + '" /silent', True);

            if FileExists(ANamePDF) then
              Result.Add(ANamePDF);

            DeleteFile(PChar(ANameHtml));
          end
        end;
      end;
      buscas.Close;
    end;
  finally
  	if Assigned(AFileHTML) then
    	FreeAndNil(AFileHTML);
    if Assigned(AFileSettings) then
      FreeAndNil(AFileSettings);
  end;
end;

function TEnviarContratosClientes.ImprimirNFGerarPDF(
	pHandle: THandle;
	pCodNF: Integer;
  pImprimirNF: Boolean;
  pGerarPDF: Boolean;
  var pGerouNF: Boolean;
  var pStringListAnexos: TStringList): Boolean;
var
	vChaveNF: string;
	Anfs: array of Integer;
  Anfe_imprimir: Tnfe_imprimir;
  vstrWide: WideString;
  vErros: string;
  vStringXML: TStringList;
begin
	try
    try
      Result   := False;

      vStringXML := TStringList.Create;

      vChaveNF := '';

      SqlOpen(' select notafiscal.cod_nf, notafiscal.num_nf, notafiscal.serie, notafiscal.modelo_nf, ' +
              ' notafiscal.chave_nfe, notafiscal.situacao_nfe, notafiscal.xml_nfe from notafiscal ' +
              ' where notafiscal.cod_nf = ' + IntToStr(pCodNF) +
              ' and notafiscal.cod_empresa = ' + vDadosIni.codEmpresa, buscas);
      if (buscas.FieldByName('cod_nf').AsInteger > 0)
        and (trim(buscas.FieldByName('situacao_nfe').AsString) = 'Autorizada')
        and (trim(buscas.FieldByName('xml_nfe').AsString) <> '') then
      begin
        vChaveNF := trim(buscas.FieldByName('chave_nfe').AsString);
                        
        SetLength(Anfs, 1);
        Anfs[0] := pCodNF;

        Anfe_imprimir := GetProcAddress(pHandle, PChar('nfe_imprimir'));
        if Assigned(@Anfe_imprimir) then
          if not Anfe_imprimir(
            Anfs,
            pImprimirNF,
            pGerarPDF,
            vDadosIni.IfThen(pGerarPDF,
              ExtractFilePath(Application.ExeName) + '\TempCtrNF\',
              ''),
            StrToInt(vDadosIni.codEmpresa),
            vDadosIni.vBancoHW,
            vstrWide) then
          begin
            if Trim(vstrWide) <> '' then
            begin
              vErros := vstrWide;
              Application.MessageBox(PChar(Trim(vErros) + ' ' + '- Cod NF: ' + IntToStr(pCodNF)), 'Atenção', MB_ICONERROR + MB_OK);
            end;
          end;

          vStringXML.Add(buscas.FieldByName('xml_nfe').AsString);
          vStringXML.SaveToFile(ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + vChaveNF + '-nfe.xml');

          if (FileExists(PChar(ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + vChaveNF + '-nfe.pdf')))
          	and (FileExists(PChar(ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + vChaveNF + '-nfe.xml'))) then
          begin
            pGerouNF := True;
            pStringListAnexos.Add(ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + vChaveNF + '-nfe.pdf');
            pStringListAnexos.Add(ExtractFilePath(Application.ExeName) + '\TempCtrNF\' + vChaveNF + '-nfe.xml');
          end;
      end;

      Result := True;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
  	if Assigned(vStringXML) then
      vStringXML.Free;
  end;
end;

function TEnviarContratosClientes.InserirEnvDoc(
	pBuscas: TIBQuery; pTipoDoc: string; pNumDoc: Integer; pTipoEnv: string; pDataEnv: TDateTime): boolean;
var
	buscas2: TIBQuery;
	vCodRps: Integer;
  vCodNF: Integer;
begin
	try
    try
      Result := true;

      buscas2 := TIBQuery.Create(Application);
      buscas2.Database := pBuscas.Database;
      buscas2.Transaction := pBuscas.Transaction;

      if (trim(pTipoDoc) = 'NFS') or (trim(pTipoDoc) = 'RPS') then
      begin
        buscas2.Close;
        buscas2.SQL.Text := ' SELECT DISTINCT PEDVENDA_SERV.COD_RPS FROM PEDVENDA ' +
          ' INNER JOIN PEDVENDA_SERV ON ' +
          '   PEDVENDA_SERV.NPED = PEDVENDA.NPED ' +
          '   AND PEDVENDA_SERV.TIPO = PEDVENDA.TIPO ' +
          '   AND PEDVENDA_SERV.COD_EMPRESA = PEDVENDA.COD_EMPRESA ' +
          ' WHERE PEDVENDA_SERV.NPED = :NPED ' +
          ' AND PEDVENDA_SERV.TIPO = :TIPO ' +
          ' AND PEDVENDA_SERV.COD_EMPRESA = :COD_EMPRESA ' +
          ' AND PEDVENDA.STATUS_PED = ''FECHADA'' ' +
          ' AND (PEDVENDA_SERV.STATUS <> ''CANCELADO'' OR PEDVENDA_SERV.STATUS IS NULL) ' +
          ' AND PEDVENDA_SERV.COD_RPS > 0 ';
        buscas2.ParamByName('NPED').AsInteger := pNumDoc;
        buscas2.ParamByName('TIPO').AsString := 'OS';
        buscas2.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas2.Open;
        buscas2.FetchAll;

        buscas2.First;
        while not buscas2.Eof do
        begin
          vCodRps := buscas2.FieldByName('COD_RPS').AsInteger;

          if vCodRps > 0 then
          begin
            pBuscas.Close;
            pBuscas.SQL.Text := ' INSERT INTO ENV_DOC ' +
              ' (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO) ' +
              ' VALUES (:NUM_DOC, :COD_EMPRESA, :TIPO_ENV, :DATA_ENV, :COD_USUARIO); ';
            pBuscas.ParamByName('NUM_DOC').AsString := 'RPS_' + IntToStr(vCodRps);
            pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
            pBuscas.ParamByName('TIPO_ENV').AsString := trim(pTipoEnv);
            pBuscas.ParamByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
            pBuscas.ParamByName('DATA_ENV').AsDateTime := pDataEnv;
            pBuscas.ExecSQL;
          end;

          buscas2.Next;
        end;
      end
      else if (trim(pTipoDoc) = 'NF') then
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' SELECT NOTAFISCAL.COD_NF FROM NOTAFISCAL ' +
        	' INNER JOIN PEDVENDA ON ' +
          '   PEDVENDA.NPED = NOTAFISCAL.NPED ' +
          '   AND PEDVENDA.TIPO = NOTAFISCAL.TIPO_PED ' +
          '   AND PEDVENDA.COD_EMPRESA = NOTAFISCAL.COD_EMPRESA ' +
          '   AND PEDVENDA.NUM_NF = NOTAFISCAL.NUM_NF ' +
          '   AND PEDVENDA.SERIE_NF = NOTAFISCAL.SERIE ' +
          ' WHERE NOTAFISCAL.NPED = :NPED ' +
          ' AND NOTAFISCAL.TIPO_PED = :TIPO ' +
          ' AND NOTAFISCAL.COD_EMPRESA = :COD_EMPRESA ';
        pBuscas.ParamByName('NPED').AsInteger := pNumDoc;
        pBuscas.ParamByName('TIPO').AsString := 'OS';
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        pBuscas.Open;

        vCodNF := pBuscas.FieldByName('COD_NF').AsInteger;

        if vCodNF > 0 then
        begin
          pBuscas.Close;
          pBuscas.SQL.Text := ' INSERT INTO ENV_DOC ' +
            ' (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO) ' +
            ' VALUES (:NUM_DOC, :COD_EMPRESA, :TIPO_ENV, :DATA_ENV, :COD_USUARIO); ';
          pBuscas.ParamByName('NUM_DOC').AsString := trim(pTipoDoc) + '_' + IntToStr(vCodNF);
          pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
          pBuscas.ParamByName('TIPO_ENV').AsString := trim(pTipoEnv);
          pBuscas.ParamByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
          pBuscas.ParamByName('DATA_ENV').AsDateTime := pDataEnv;
          pBuscas.ExecSQL;
        end;
      end
      else
      begin
        pBuscas.Close;
        pBuscas.SQL.Text := ' INSERT INTO ENV_DOC ' +
          ' (NUM_DOC, COD_EMPRESA, TIPO_ENV, DATA_ENV, COD_USUARIO) ' +
          ' VALUES (:NUM_DOC, :COD_EMPRESA, :TIPO_ENV, :DATA_ENV, :COD_USUARIO); ';
        pBuscas.ParamByName('NUM_DOC').AsString := trim(pTipoDoc) + '_' + IntToStr(pNumDoc);
        pBuscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        pBuscas.ParamByName('TIPO_ENV').AsString := trim(pTipoEnv);
        pBuscas.ParamByName('COD_USUARIO').AsInteger := vDadosIni.vCodUsuario;
        pBuscas.ParamByName('DATA_ENV').AsDateTime := pDataEnv;
        pBuscas.ExecSQL;
      end;

      if pBuscas.Transaction.InTransaction then
        pBuscas.Transaction.Commit;
    except
      on e: exception do
      begin
        Result := false;
        RollBackTransacao;
        Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      end;
    end;
  finally
  	if Assigned(buscas2) then
      FreeAndNil(buscas2);
  end;
end;

function TEnviarContratosClientes.limparDadosBoleto(pNossoNumero, RemessaEnviada, pRetirarCredito, pCarne, pOutrosDados: boolean): boolean;
var
  vListaBoletas: TStringList;
begin
  try
    Result := false;

    vListaBoletas := TStringList.Create;

    vListaBoletas.Clear;

    try
      dataSet.DisableControls;
      dataSet.First;
      while not dataSet.Eof do
      begin
        if dataSet.FieldByName('SEL').AsString = 'S' then
        begin
          SqlOpen(' select n_seq_bol, cod_cobrebem, nosso_numero_banco, remessa_enviada from boletas ' +
            ' where num_nf_vnd = ' + IntToStr(dataSet.FieldByName('NPED').AsInteger) +
            ' and tipo_emissao = ' + QuotedStr(dataSet.FieldByName('TIPO').AsString) +
            ' and cod_empresa = ' + vDadosIni.codEmpresa +
            ' and ativo = 1 ', buscas).FetchAll;

          buscas.First;
          while not buscas.Eof do
          begin
            vListaBoletas.Add(IntToStr(buscas.FieldByName('N_SEQ_BOL').AsInteger));

            buscas.Next;
          end;
        end;

        dataSet.Next;
      end;
    finally
    	dataSet.EnableControls;
	    dataSet.First;

    end;

    if vListaBoletas.Count <= 0 then
      raiseExceptionCreate('Nenhuma Ordem de Serviço selecionada.', '');

    if not vDadosIni.limpardados_boleto(pNossoNumero, RemessaEnviada, pRetirarCredito, pCarne, pOutrosDados, vListaBoletas) then
      raiseExceptionCreate('Ocorreu um limpar dados Boletos, favor verificar.', '');

    dataSet.Refresh;

    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;

end;

