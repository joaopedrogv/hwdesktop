procedure TGeradorOS._marcarTodos(DtSet: TDataSet);
var
	vRecno: Integer;
begin
  try
  	vContrSel := 0;

    vDadosIni.abreStatusProcessamento('', 'Aguarde. Selecionando todos os registros');
    DtSet.DisableControls;

    vRecno := DtSet.RecNo;
    DtSet.First;
    while not DtSet.Eof do
    begin
      if not ((DtSet.FieldByName('CONTRATOS_CADA_MES').AsInteger > 0) and
        (DtSet.FieldByName('CONTRATOS_CADA_MES').AsInteger >
        DtSet.FieldByName('QTDE_MES_ULT_GER').AsInteger)) then
      begin
      	vContrSel := vContrSel + 1;

        DtSet.Edit;
        DtSet.FieldByName('sel').AsString := 'S';
        DtSet.Post;
      end;
      DtSet.Next;
    end;

  finally
  	DtSet.RecNo := vRecno;
    DtSet.EnableControls;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

