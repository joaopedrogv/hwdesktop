function TCadClientes.ChangeClienteFaturamento(iCodCliFat: Integer): string;
begin
  Result := '';
  if iCodCliFat <= 0 then
    Exit;

  queryCons.Table('clientes', 'cpfcgc, cod_cliente, nome_cliente, razao')
    .Equals('cod_cliente', iCodCliFat)
    .Equals('cod_empresa', vDadosIni.cod_empresa)
    .Open;

  if queryCons.IsEmpty then
  begin
    ShowAtencao('Cliente não localizado');
    Exit;
  end;

  Result := queryCons.fstr('cpfcgc') + ' - ' + queryCons.fstr('nome_cliente');
  if queryCons.fstr('nome_cliente') <> queryCons.fstr('razao') then
    Result := Result + '/' + queryCons.fstr('razao');

  if dataSet.State in [dsEdit, dsInsert] then
    dataSet.FieldByName('cod_cli_fat').AsInteger := iCodCliFat;
end;

