  begin
    result := ExecutaComandosSql('select * from cst_mud_cliente where cod_cliente = ' +
      inttostr(codcliente) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cst_interno = ' + QuotedStr(dataSet.FieldByName('CST_INTERNO').AsString) +
      ' and aliq_interna = ' +
      vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('ALIQ_INTERNA').AsFloat)) +
      ' and cfop_interno = ' +
      vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('CFOP_INTERNO').AsFloat)));
  end
  else if dataSet.State = dsInsert then
  begin
    buscas.Close;
    buscas.SQL.Text := 'select * from cst_mud_cliente where cod_cliente = ' + inttostr(codcliente) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa +
      ' and cst_interno = ' + QuotedStr(dataSet.FieldByName('CST_INTERNO').AsString) +
      ' and aliq_interna = ' +
      vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('ALIQ_INTERNA').AsFloat)) +
      ' and cfop_interno = ' +
      vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('CFOP_INTERNO').AsFloat));
    buscas.Open;
    if not buscas.IsEmpty then
    begin
      if Application.MessageBox(PChar('Este item já existe.' + chr(13) +
        'Deseja alterar os dados deste item?'), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = mrYES then
      begin
        Cancel;
        dataSet.IndexFieldNames := 'CST_INTERNO;ALIQ_INTERNA;CFOP_INTERNO';
        dataSet.FindNearest([buscas.FieldByName('CST_INTERNO').AsString,
          buscas.FieldByName('ALIQ_INTERNA').AsFloat, buscas.FieldByName('CFOP_INTERNO').AsFloat]);
        if (dataset.FieldByName('CST_INTERNO').AsString = buscas.FieldByName('CST_INTERNO').AsString)
          and
          (dataset.FieldByName('ALIQ_INTERNA').AsFloat = buscas.FieldByName('ALIQ_INTERNA').AsFloat)
          and
          (dataset.FieldByName('CFOP_INTERNO').AsFloat = buscas.FieldByName('CFOP_INTERNO').AsFloat)
          then
        begin
          if not edit then
          begin
            result := true;
            exit;
          end
          else
            result := false;
        end;
      end
      else
      begin
        result := true;
        exit;
      end;
    end
    else
      result := true;
  end
  else if dataSet.State = dsEdit then
  begin
    if (dataSet.FieldByName('CST_INTERNO').AsString <> dataSet.FieldByName('CST_INTERNO').OldValue)
      or
      (dataSet.FieldByName('ALIQ_INTERNA').AsFloat <> dataSet.FieldByName('ALIQ_INTERNA').OldValue)
      or
      (dataSet.FieldByName('CFOP_INTERNO').AsFloat <> dataSet.FieldByName('CFOP_INTERNO').OldValue)
      then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select * from cst_mud_cliente where cod_cliente = ' + inttostr(codcliente)
        +
        ' and cod_empresa = ' + vDadosIni.codEmpresa +
        ' and cst_interno = ' + QuotedStr(dataSet.FieldByName('CST_INTERNO').AsString) +
        ' and aliq_interna = ' +
        vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('ALIQ_INTERNA').AsFloat)) +
        ' and cfop_interno = ' +
        vDadosIni.trocaVirgulaPorPonto(FloatToStr(dataSet.FieldByName('CFOP_INTERNO').AsFloat));
      buscas.Open;
      if not buscas.IsEmpty then
      begin
        if Application.MessageBox(PChar('Esta modificação está apontando para um item já existe.'
          + chr(13) + 'Deseja alterar os dados deste item já existente?'), 'Confirmação', MB_YESNO
          + MB_ICONQUESTION + MB_DEFBUTTON1) = mrYES then
        begin
          Cancel;
          dataSet.IndexFieldNames := 'CST_INTERNO;ALIQ_INTERNA;CFOP_INTERNO';
          dataSet.FindNearest([buscas.FieldByName('CST_INTERNO').AsString,
            buscas.FieldByName('ALIQ_INTERNA').AsFloat,
              buscas.FieldByName('CFOP_INTERNO').AsFloat]);
          if (dataset.FieldByName('CST_INTERNO').AsString =
            buscas.FieldByName('CST_INTERNO').AsString) and
            (dataset.FieldByName('ALIQ_INTERNA').AsFloat =
            buscas.FieldByName('ALIQ_INTERNA').AsFloat) and
            (dataset.FieldByName('CFOP_INTERNO').AsFloat =
            buscas.FieldByName('CFOP_INTERNO').AsFloat) then
          begin
            if not edit then
            begin
              result := true;
              exit;
            end
            else
              result := false;
          end;
        end
        else
        begin
          result := true;
          exit;
        end;
      end
      else
        result := true;
    end;
  end;
end;

