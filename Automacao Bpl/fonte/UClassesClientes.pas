      begin
        frmGeradorOSFormasBoletas.EditHwColaborador.AsValue                 := 0;
        frmGeradorOSFormasBoletas.DBLookupComboBoxColaborador.KeyValue      := 0;
      end;

      frmGeradorOSFormasBoletas.LabelColaborador.Enabled                    := False;
      frmGeradorOSFormasBoletas.EditHwColaborador.Enabled                   := False;
      frmGeradorOSFormasBoletas.DBLookupComboBoxColaborador.Enabled         := False;

      if vDadosIni.vGeradorFaturamentoContratos.vCodSubGrupoOS <> 0 then
      begin
      	try
          frmGeradorOSFormasBoletas.EditHwSubGrupoOS.AsValue                := vDadosIni.vGeradorFaturamentoContratos.vCodSubGrupoOS;
          frmGeradorOSFormasBoletas.DBLookupComboBoxSubGrupoOS.KeyValue     := frmGeradorOSFormasBoletas.EditHwSubGrupoOS.AsValue;
        except
