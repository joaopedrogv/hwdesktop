destructor TCadClientesTribAd.Destroy;
begin
  if Assigned(FlistOrig) then
  begin
    FlistOrig.Clear;
    FreeAndNil(FlistOrig);
  end;
  if Assigned(FconsPerfis) then
  begin
    FconsPerfis.dataSet.Close;
    FconsPerfis.FreeDbComponents(True);
    FreeAndNil(FconsPerfis);
  end;  
  inherited;
end;

procedure TCadClientesTribAd.Iniciar(Adest_seqid: Integer);
begin
  Fdest_seqid := Adest_seqid;
  Self.Clear;
  FlistOrig.Clear;
  if FOwner.dataSet.State = dsEdit then with FOwner do
  begin
    SqlOpen('select %s from clientes_trib_ad ct' +
            ' inner join produtos_trib_pf pt on pt.cod_trib_pf = ct.cod_trib_pf and pt.cod_empresa = ct.cod_empresa' +
            ' where ct.cod_cliente = %d and ct.cod_empresa = %s and ct.end_doc_add_seqid %s %d' +
            ' order by ct.cod_trib_pf',
            [TProdutos_trib_pf_class.GetFieldsSql('pt'), f_int('cod_cliente'), vDadosIni.codEmpresa,
             IfThen(Adest_seqid < 0, '<>', '=') , Fdest_seqid], buscas).First;
    Self.SetValuesFrom(buscas);
    FlistOrig.SetValuesFrom(buscas);
  end;
end;

function TCadClientesTribAd.Remover(Acod_trib_pf: Integer): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to Self.Count - 1 do
    if Self.Items[I].cod_trib_pf = Acod_trib_pf then
    begin
      Result := True;
      Self.Delete(I);
      Break;
    end;
end;

function TCadClientesTribAd.Remover(Aperfil: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to Self.Count - 1 do
    if Pos(Format('[ID:%d]', [Self.Items[I].cod_trib_pf]), Aperfil) = 1 then
    begin
      Result := True;
      Self.Delete(I);
      Break;
    end;
end;

function TCadClientesTribAd.Salvar: Boolean;
var
  AlistDel, AlistInsert: Tprodutos_trib_pf_classList;
  I, J: Integer;
  AdoSomething: Boolean;
begin
  Result := True;
  AlistDel := TProdutos_trib_pf_classList.Create;
  AlistInsert := TProdutos_trib_pf_classList .Create;
  try
    //criando lista de insert
    for I := 0 to Self.Count - 1 do
    begin
      AdoSomething := True;
      for J := 0 to FlistOrig.Count - 1 do
        if Self.Items[I].cod_trib_pf = FlistOrig.Items[J].cod_trib_pf then
        begin
          AdoSomething := False;
          Break;
        end;
      if AdoSomething then
        AlistInsert.Add(Self.Items[I].Clone);
    end;

    // criando lista de delete
    for I := 0 to FlistOrig.Count - 1 do
    begin
      AdoSomething := True;
      for J := 0 to Self.Count - 1 do
      if FlistOrig.Items[I].cod_trib_pf = Self.Items[J].cod_trib_pf then
        begin
          AdoSomething := False;
          Break;
        end;
      if AdoSomething then
        AlistDel.Add(FlistOrig.Items[I].Clone);
    end;

    for I := 0 to AlistDel.Count - 1 do with AlistDel.Items[I] do
      FOwner.SqlExec('delete from clientes_trib_ad' +
                     ' where cod_cliente = %d and cod_empresa = %d and end_doc_add_seqid = %d and cod_trib_pf = %d',
                     [FOwner.f_int('cod_cliente'), cod_empresa, Fdest_seqid, cod_trib_pf]);

    for I := 0 to AlistInsert.Count - 1 do with AlistInsert.Items[I] do
      FOwner.SqlExec(Format('insert into clientes_trib_ad (cod_cliente, cod_empresa, end_doc_add_seqid, cod_trib_pf) values (%d, %d, %d, %d)',
                     [FOwner.f_int('cod_cliente'), cod_empresa, Fdest_seqid, cod_trib_pf]));
  finally
    FreeAndNil(AlistDel);
    FreeAndNil(AlistInsert);    
  end;
end;

