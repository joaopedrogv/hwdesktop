                 SqlOpen(' select coalesce(venda, ''N'') venda, coalesce(gerar_pontos, ''N'') gerar_pontos from tipo_vendas ' +
                   ' where sigla = ''' + trim(vDadosIni.vProgFid.vTipoVendaReqTroca) + ''' and tipo = ''REQ'' and ativo = 1');

