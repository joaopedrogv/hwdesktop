function TCadClientes.ControlesSelecionados(CheckListBox: TCheckListBox): boolean;
var
  i: integer;
begin
  result := true;
  ControlesSelec := '(';
  for i := 0 to CheckListBox.Items.Count - 1 do
  begin
    if CheckListBox.Checked[i] then
    begin
      if ControlesSelec = '(' then
        ControlesSelec := ControlesSelec + CodigosControles[i]
      else
        ControlesSelec := ControlesSelec + ',' + CodigosControles[i];
    end;
  end;
  ControlesSelec := ControlesSelec + ')';

  if ControlesSelec = '()' then
  begin
    Application.MessageBox('Selecione pelo menos um controle.', 'Aviso', MB_OK + MB_ICONWARNING +
      MB_DEFBUTTON1);
    CheckListBox.SetFocus;
    result := false;
  end;
end;

function TCadClientes.CPF(num: string): boolean;
var
  N1, n2, n3, n4, n5, n6, n7, n8, n9: integer;
  D1, d2: integer;
  Digitado, calculado: string;
begin
  n1 := StrToInt(num[1]);
  n2 := StrToInt(num[2]);
  n3 := StrToInt(num[3]);
  n4 := StrToInt(num[4]);
  n5 := StrToInt(num[5]);
  n6 := StrToInt(num[6]);
  n7 := StrToInt(num[7]);
  n8 := StrToInt(num[8]);
  n9 := StrToInt(num[9]);
  d1 := n9 * 2 + n8 * 3 + n7 * 4 + n6 * 5 + n5 * 6 + n4 * 7 + n3 * 8 + n2 * 9 + n1 * 10;
  d1 := 11 - (d1 mod 11);
  if d1 >= 10 then
    d1 := 0;
  d2 := d1 * 2 + n9 * 3 + n8 * 4 + n7 * 5 + n6 * 6 + n5 * 7 + n4 * 8 + n3 * 9 + n2 * 10 + n1 * 11;
  d2 := 11 - (d2 mod 11);
  if d2 >= 10 then
    d2 := 0;
  calculado := inttostr(d1) + inttostr(d2);
  digitado := num[10] + num[11];
  if calculado = digitado then
    cpf := true
  else
    cpf := false;
end;

