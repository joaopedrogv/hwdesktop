function TGeradorOS._getDetalhesVendas(pCogGerador: Integer): Boolean;
begin
  fVendas.Close;
  fVendas.CommandText :=
    ' select pv.nped, pv.data_ped, pv.data_fech, pv.valor_total,' +
    ' pv.status_ped, pv.tipo_os, pv.num_nf, pv.data_nf, pv.num_nfeext, pv.data_nfext, ' +
    ' cl.nome_cliente, cl.razao, cl.cpfcgc ' +
    ' from pedvenda pv' +
    ' inner join clientes cl on cl.cod_cliente = pv.cod_cliente and cl.cod_empresa = pv.cod_empresa ' +
    ' where pv.cod_gerador = ' + IntToStr(pCogGerador) +
    ' and pv.cod_empresa = ' + vDadosIni.codEmpresa +
    ' and pv.tipo = ''OS''';
  fVendas.Open;
end;

procedure TGeradorOS._marcaDesmarcaLinha(DtSet: TDataSet);
begin
  if DtSet.IsEmpty then
    exit;

  DtSet.Edit;
  if DtSet.FieldByName('SEL').AsString = 'S' then
  begin
  	vContrSel := vContrSel - 1;
    
    DtSet.FieldByName('SEL').AsString := '';
  end
  else
  begin
    if (DtSet.FieldByName('CONTRATOS_CADA_MES').AsInteger > 0) and
       (DtSet.FieldByName('CONTRATOS_CADA_MES').AsInteger >
       DtSet.FieldByName('QTDE_MES_ULT_GER').AsInteger) then
      Application.MessageBox(pchar('Contrato selecionado já foi gerado no período informado'), 'Atenção', MB_ICONERROR + MB_OK)
    else
    begin
      vContrSel := vContrSel + 1;

      DtSet.FieldByName('SEL').AsString := 'S';
    end;
  end;
  DtSet.Post;
end;

procedure TGeradorOS._marcaLinha(DtSet: TDataSet);
