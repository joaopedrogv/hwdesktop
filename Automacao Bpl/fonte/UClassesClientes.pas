function TContratosComClientes.ajustarValorContratos(pValorAjuste: Double): Boolean;
begin
  try	
    vDadosIni.abreStatusProcessamento('', 'Ajustando contratos...');
    fTempAjuste.DisableControls;
    
    fTempAjuste.First;
    while not fTempAjuste.Eof do
    begin
      fTempAjuste.Edit;
      fTempAjuste.FieldByName('VALOR_AJUSTADO').AsFloat :=
      	RoundTo(vDadosIni.IfThen(pValorAjuste > 0, pValorAjuste, 1) * fTempAjuste.FieldByName('VALOR_SERV').AsFloat, -2) +
        RoundTo(fTempAjuste.FieldByName('VALOR_PROD').AsFloat, -2);
      fTempAjuste.FieldByName('PERC_REAJUSTE').AsFloat := pValorAjuste;
      fTempAjuste.Post;
    
      fTempAjuste.Next;
    end;

    fTempAjuste.First;
  finally
    vDadosIni.fechaStatusProcessamento;
    fTempAjuste.EnableControls;
  end;
  
end;

function TContratosComClientes.atribuirValorContrato: Double;
begin
	vVALOR_CONTRATO := 0;
  vVALOR_SERV     := 0;
  vVALOR_PROD     := 0;

	try
  	vServCtr.dataSet.DisableControls;
    vServCtr.dataSet.First;
    while not vServCtr.dataSet.Eof do
    begin
    	vVALOR_CONTRATO := vVALOR_CONTRATO + vServCtr.dataSet.FieldByName('VALOR_TOT').AsFloat;

      vVALOR_SERV     := vVALOR_SERV     + vServCtr.dataSet.FieldByName('VALOR_TOT').AsFloat;

      vServCtr.dataSet.Next;
    end;
  finally
  	vServCtr.dataSet.First;
  	vServCtr.dataSet.EnableControls;
  end;

  try
    vProdCtr.dataSet.DisableControls;
    vProdCtr.dataSet.First;
    while not vProdCtr.dataSet.Eof do
  	begin
      vVALOR_CONTRATO := vVALOR_CONTRATO + vProdCtr.dataSet.FieldByName('VALOR_TOT').AsFloat;

      vVALOR_PROD     := vVALOR_PROD     + vProdCtr.dataSet.FieldByName('VALOR_TOT').AsFloat;

      vProdCtr.dataSet.Next;
    end;
  finally
  	vProdCtr.dataSet.First;
    vProdCtr.dataSet.EnableControls;
  end;

  vVALOR_CONTRATO := RoundTo(vVALOR_CONTRATO, -2);
  vVALOR_SERV     := RoundTo(vVALOR_SERV, - 2);
  vVALOR_PROD     := RoundTo(vVALOR_PROD, -2);
end;

function TContratosComClientes.atualizarContratosEmLote: boolean;
var
	vIndexFieldNames: string;
	vIndexName: string;
  vRecNo: Integer;
	vCodigo: Integer;
  vSQL: string;
  fTempListaContratos: TClientDataSet;
  vUSAR_BOLETO: string;
begin
	vSQL := '';
  
	if not vDadosIni.PesqPros('CLI263', 'ATUALIZAR', '', 'CLIENTES_COM_CONTRATO', '', buscas, False) then
    Exit;

	try
    try
    	vIndexFieldNames := dataSet.IndexFieldNames;
    	vIndexName       := dataSet.IndexName;
      vRecNo           := dataSet.RecNo;

      try
        dataSet.Filtered := false;
        dataSet.Filter := 'sel = ''S'' ';
        dataSet.Filtered := true;

        if dataSet.IsEmpty then
        begin
          Application.MessageBox('Nenhum contrato selecionado.', 'Atenção',
            MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
          dataSet.Refresh;
          exit;
        end;

        fTempListaContratos := TClientDataSet.Create(nil);
        fTempListaContratos.Close;
        fTempListaContratos.FieldDefs.Clear;
        fTempListaContratos.FieldDefs.Add('COD_CONTRATO', ftInteger, 0, false);
        fTempListaContratos.close;
        fTempListaContratos.CreateDataSet;
        fTempListaContratos.EmptyDataSet;

        try
          dataSet.DisableControls;
          dataSet.First;
          while not dataSet.Eof do
          begin
            vDadosIni.abreStatusProcessamento('', 'Atualizando dados contratos (' +
              IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

            if dataSet.FieldByName('sel').AsString = 'S' then
            begin
              fTempListaContratos.Insert;
              fTempListaContratos.FieldByName('COD_CONTRATO').AsInteger := dataSet.FieldByName('COD_CONTRATO').AsInteger;
              fTempListaContratos.Post;
            end;

            dataSet.Next;
          end;

          vSQL := dataSet.CommandText;
        finally
          dataSet.EnableControls;
        end;
      finally
        dataSet.Filtered := False;
      end;

      if vHAB_COD_CONTROLE then
      begin
        if vCOD_CONTROLE <= 0 then
          raiseExceptionCreate('Controle deve ser informado', 'EdControle');

        SqlOpen(' select codigo_ctrl, nome_ctrl, usar_boleto from controles ' +
          ' where codigo_ctrl = ' + IntToStr(vCOD_CONTROLE) +
          ' and codigo_emp = ' + vDadosIni.codEmpresa +
          ' and cxent = ''S'' ' +
          ' and ativo = 1 ', buscas);

         if buscas.IsEmpty then
          raiseExceptionCreate('Controle não encontrado', 'EdControle');

        vUSAR_BOLETO := buscas.FieldByName('USAR_BOLETO').AsString;

        if buscas.FieldByName('USAR_BOLETO').AsString = 'S' then
        begin
          if vDATA_INICIAL_VIGENCIA <= 0 then
            raiseExceptionCreate('Controle do tipo usar boleto bancário, favor informar a data inicial vigência do contrato deve ser informada', 'meDataInicialContrato');

          if vDATA_FINAL_VIGENCIA <= 0 then
            raiseExceptionCreate('Controle do tipo usar boleto bancário, favor informar a data final vigência do contrato deve ser informada', 'meDataFinalContrato');

          if vDATA_IMPRESSAOBOL_INICIAL <= 0 then
            raiseExceptionCreate('Controle do tipo usar boleto bancário, favor informar a data inicial da impressão da boleta deve ser informada', 'meDataFinalContrato');

        	if vDATA_IMPRESSAOBOL_INICIAL < vDATA_INICIAL_VIGENCIA then
		        raiseExceptionCreate('Controle do tipo usar boleto bancário, data inicial da impressão do boleto não deve ser menor que data inicial da vigência', 'meDataInicialBoleto');
        end;
      end;

      if vHAB_COD_COLABORADOR then
      begin
        if vCOD_COLABORADOR <= 0 then
          raiseExceptionCreate('Vendedor deve ser informado', 'EdVendedor');

        if not ExecutaComandosSql(' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao from colaborador c ' +
          ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
          ' where c.cod_vendedor = ' + IntToStr(vCOD_COLABORADOR) +
          ' and c.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and c.ativo = 1 ' +
          ' and f.desc_funcao like ''%VENDEDOR%'' ') then
          raiseExceptionCreate('Vendedor não encontrado', 'EdVendedor');
      end;

      if vHAB_DIA_VENCIMENTO then
      begin
        if vDIA_VENCIMENTO <= 0 then
          raiseExceptionCreate('Dia de Vencimento deve ser informado', 'EdDiaVencimento');

      	if vDIA_VENCIMENTO > 31 then
        	raiseExceptionCreate('Dia de Vencimento não deve ser maior que 31', 'EdDiaVencimento');
      end;

      if vHAB_DIAS_APOS_VENC then
      begin
        if vDIAS_APOS_VENC <= 0 then
        	raiseExceptionCreate('Dias de Vencimento Após Faturamento deve ser informado', 'EdDiasAposVenc');
      end;

      if vHAB_DIA_FATURAMENTO then
      begin
        if vDIA_FATURAMENTO <= 0 then
        	raiseExceptionCreate('Dia do Faturamento deve ser informado', 'EdDiaFaturamento');

        if vDIA_FATURAMENTO > 31 then
        	raiseExceptionCreate('Dia do Faturamento não deve ser maior que 31', 'EdDiaFaturamento');
      end;

      if vHAB_TIPO_OS then
      begin
        if trim(vTIPO_OS) = '' then
          raiseExceptionCreate('Tipo de OS deve ser informado', 'cbTipoOS');
      end;

      if vHAB_CONTRATOS_CADA_MES then
      begin
        if vCONTRATOS_CADA_MES <= 0 then
          raiseExceptionCreate('Gerar Contratos a Cada deve ser informado', 'EdGerarContratosAcada');
      end;

      if vHAB_DATA_VIGENCIA_CONTRATO then
      begin
        if vDATA_INICIAL_VIGENCIA <= 0 then
          raiseExceptionCreate('Data Inicial Vigência do Contrato deve ser informado', 'meDataInicialContrato');

        if vDATA_FINAL_VIGENCIA <= 0 then
          raiseExceptionCreate('Data Final Vigência do Contrato deve ser informado', 'meDataFinalContrato');
      end;

      if vHAB_DATA_IMPRESSAOBOL_INICIAL then
      begin
        if vDATA_IMPRESSAOBOL_INICIAL <= 0 then
          raiseExceptionCreate('Data Inicial Impressão boleto deve ser informado', 'meDataInicialBoleto');
      end;

      if (vHAB_DATA_IMPRESSAOBOL_INICIAL) and (vHAB_DATA_VIGENCIA_CONTRATO) then
      begin
      	if (vDATA_INICIAL_VIGENCIA > vDATA_IMPRESSAOBOL_INICIAL) then
        	raiseExceptionCreate('Data Inicial Vigência não deve ser maior que a Data Inicial Impressão Boleto', 'meDataInicialBoleto');
      end;

      if vHAB_GERAR_NFS then
      begin
        if (vGerarNFS <> 'S') and (vGerarNFS <> 'N') then
        	raiseExceptionCreate('Gerar NFS deve ser informado', 'cbGerarNFS');
      end;

      if vHAB_GERAR_NF then
      begin
        if (vGerarNF <> 'S') and (vGerarNF <> 'N') then
        	raiseExceptionCreate('Gerar NF deve ser informado', 'cbGerarNF');
      end;

      if vHAB_GERAR_REC_LOC then
      begin
        if (vGerarRecLoc <> 'S') and (vGerarRecLoc <> 'N') then
        	raiseExceptionCreate('Gerar Recibo Locação deve ser informado', 'cbGerarRecLoc');
      end;

      if vHAB_GERAR_BOLETO then
      begin
        if (vGerarBoleto <> 'S') and (vGerarBoleto <> 'N') then
        	raiseExceptionCreate('Gerar Boleto deve ser informado', 'cbGerarBoleto');
      end;

     if (not vHAB_COD_COLABORADOR)
      and (not vHAB_COD_CONTROLE)
      and (not vHAB_DIA_VENCIMENTO)
      and (not vHAB_DIA_FATURAMENTO)
      and (not vHAB_DIAS_APOS_VENC)
      and (not vHAB_CONTRATOS_CADA_MES)
      and (not vHAB_STATUS)
      and (not vHAB_TIPO_OS)
      and (not vHAB_DATA_VIGENCIA_CONTRATO)
      and (not vHAB_DATA_IMPRESSAOBOL_INICIAL)
      and (not vHAB_OBS)
      and (not vHAB_GERAR_NFS)
      and (not vHAB_GERAR_NF)
      and (not vHAB_GERAR_REC_LOC)
      and (not vHAB_GERAR_BOLETO) then
      	raiseExceptionCreate('Nenhum opção selecionada!', '');

      try
        fTempListaContratos.DisableControls;
        fTempListaContratos.First;
        while not fTempListaContratos.Eof do
        begin
          vDadosIni.abreStatusProcessamento('', 'Atualizando dados dos contratos (' +
            IntToStr(fTempListaContratos.RecNo) + '/' + IntToStr(fTempListaContratos.RecordCount) + ')');

          _selecionaContratCod(fTempListaContratos.FieldByName('COD_CONTRATO').AsInteger);


          if not dataSet.IsEmpty then
          begin
          	if dataSet.FieldByName('ASSINATURA_VINDI_ID').AsInteger <= 0 then
            begin
              vCodigo := dataSet.FieldByName('COD_CONTRATO').AsInteger;

              if (vHAB_DATA_VIGENCIA_CONTRATO <> vHAB_DATA_IMPRESSAOBOL_INICIAL) then
              begin
                if (vHAB_DATA_VIGENCIA_CONTRATO) and (dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime > 0) then
                	if vDATA_INICIAL_VIGENCIA > dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime then
                  	raiseExceptionCreate('Data Inicial Vigência não deve ser maior que a Data Inicial Impressão Boleto', 'meDataInicialContrato');

                if (vHAB_DATA_IMPRESSAOBOL_INICIAL) and (dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime > 0) then
                	if dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime > vDATA_IMPRESSAOBOL_INICIAL then
										raiseExceptionCreate('Data Inicial Vigência não deve ser maior que a Data Inicial Impressão Boleto', 'meDataInicialContrato');
              end;

              dataSet.Edit;

              if vHAB_COD_CONTROLE then
              begin
                if vUSAR_BOLETO <> 'S' then
                	dataSet.FieldByName('DATA_INICIAL_BOLETO').Value := Null;
              end
              else
              begin
                if dataSet.FieldByName('USAR_BOLETO').AsString <> 'S' then
                  dataSet.FieldByName('DATA_INICIAL_BOLETO').Value := Null;
              end;

              if vHAB_COD_CONTROLE then
                dataSet.FieldByName('COD_CONTROLE').AsInteger := vCOD_CONTROLE;

              if vHAB_COD_COLABORADOR then
                dataSet.FieldByName('COD_VENDEDOR').AsInteger := vCOD_COLABORADOR;

              if vHAB_DIA_VENCIMENTO then
              begin
                dataSet.FieldByName('DIA_VENCIMENTO').AsInteger := vDIA_VENCIMENTO;
                dataSet.FieldByName('DIAS_APOS_VENC').AsInteger := 0;
              end;

              if vHAB_DIA_FATURAMENTO then
                dataSet.FieldByName('DIA_FATURAMENTO').AsInteger := vDIA_FATURAMENTO;

              if vHAB_DIAS_APOS_VENC then
              begin
                dataSet.FieldByName('DIAS_APOS_VENC').AsInteger := vDIAS_APOS_VENC;
                dataSet.FieldByName('DIA_VENCIMENTO').AsInteger := 0;
              end;

              if vHAB_TIPO_OS then
                dataSet.FieldByName('TIPO_OS').AsString := trim(vTIPO_OS);

              if vHAB_CONTRATOS_CADA_MES then
                dataSet.FieldByName('CONTRATOS_CADA_MES').AsInteger := vCONTRATOS_CADA_MES;

              if vHAB_DATA_VIGENCIA_CONTRATO then
              begin
                dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime := vDATA_INICIAL_VIGENCIA;
                dataSet.FieldByName('DATA_FINAL_VIGENCIA').AsDateTime := vDATA_FINAL_VIGENCIA;
              end;

              if vHAB_DATA_IMPRESSAOBOL_INICIAL then
              begin
              	if vHAB_COD_CONTROLE then
                begin
                  if vUSAR_BOLETO = 'S' then
                		dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime := vDATA_IMPRESSAOBOL_INICIAL;
                end
                else
                begin
                  if dataSet.FieldByName('USAR_BOLETO').AsString = 'S' then
                    dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime := vDATA_IMPRESSAOBOL_INICIAL;
                end;
              end
              else
              begin
                if dataSet.FieldByName('DATA_INICIAL_BOLETO').IsNull then
                begin
                  if vHAB_COD_CONTROLE then
                	begin
                    if vUSAR_BOLETO = 'S' then
                    	dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime := dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime;
                  end
                  else
                  begin
                    if dataSet.FieldByName('USAR_BOLETO').AsString = 'S' then
                      dataSet.FieldByName('DATA_INICIAL_BOLETO').AsDateTime := dataSet.FieldByName('DATA_INICIAL_VIGENCIA').AsDateTime;
                  end;
                end;
              end;

              if vHAB_STATUS then
                dataSet.FieldByName('STATUS').AsString := trim(vSTATUS);

              if vHAB_OBS then
                dataSet.FieldByName('OBS').AsString := trim(vOBS);

              if vHAB_GERAR_NFS then
                dataSet.FieldByName('GERAR_NFS').AsString := vGerarNFS;

              if vHAB_GERAR_NF then
                dataSet.FieldByName('GERAR_NF').AsString := vGerarNF;

              if vHAB_GERAR_REC_LOC then
                dataSet.FieldByName('GERAR_REC_LOC').AsString := vGerarRecLoc;

              if vHAB_GERAR_BOLETO then
                dataSet.FieldByName('GERAR_BOLETO').AsString := vGerarBoleto;

              dataSet.Post;

              if (not Apply) and (dataSet.ChangeCount > 0) then
              begin
                dataSet.CancelUpdates;
                RollBackTransacao;
                Result := False;

                dataSet.Close;
                dataSet.CommandText := vSQL;
                dataSet.Open;

                Exit;
              end;

              vDadosIni.GravaAuditoria('CLI263', 'ATUALIZAR', '', 'CLIENTES_COM_CONTRATO', IntToStr(vCodigo), buscas);
            end;
          end;

          fTempListaContratos.Next;
        end;
      finally
        fTempListaContratos.EnableControls;
      end;

      Result := True;

      CommitaTransacao;

      if Result then
      	vDadosIni.GravaAuditoria('CLI263', 'ATUALIZAR',	'SUCESSO', 'CLIENTES_COM_CONTRATO', '', buscas);

      dataSet.Close;
      dataSet.CommandText := vSQL;
      dataSet.Open;

      if Result then
      	dataSet.Refresh;
    finally
    	dataSet.Filtered        := false;
      dataSet.IndexName       := vIndexName;
      dataSet.IndexFieldNames := vIndexFieldNames;
      if dataSet.RecordCount >= vRecNo then
	      dataSet.RecNo           := vRecNo;
      dataSet.EnableControls;
      vDadosIni.fechaStatusProcessamento;
    end;
  except
    on e: exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('CLI263', 'ATUALIZAR',	'FALHA', 'CLIENTES_COM_CONTRATO', '', buscas);
      RollBackTransacao;

      if trim(vSQL) <> '' then
      begin
		    dataSet.Close;
  	    dataSet.CommandText := vSQL;
	    	dataSet.Open;
    	end;

      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContratosComClientes.atualizarContratosTabNova(pCodContrato: Integer): boolean;
begin
	try
    Result := False;

    buscas.Close;
    buscas.SQL.Text := ' select clientes_com_contrato.cod_servico, ' +
    	' clientes_com_contrato.valor_contrato from clientes_com_contrato ' +
    	' where clientes_com_contrato.cod_contrato = ' + IntToStr(pCodContrato) +
      ' and clientes_com_contrato.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and clientes_com_contrato.cod_servico > 0 ';
    buscas.Open;

    if not buscas.IsEmpty then
    begin
      vServCtr.vMODO              := 'INSERIR';
      vServCtr.vCOD_CONTRATO      := Contratos.dataSet.FieldByName('COD_CONTRATO').AsInteger;
      vServCtr.vCOD_CONTRATO_SERV := 0;

      vServCtr.vCOD_SERVICO       := buscas.FieldByName('COD_SERVICO').AsInteger;
      vServCtr.vQTDE              := 1;
      vServCtr.vVALOR_UN          := buscas.FieldByName('VALOR_CONTRATO').AsFloat;

      if not vServCtr.post(Contratos) then
        exit;
    end;

    Result := True;
  except
  	on e: exception do
    begin
      Result := false;
      RollBackTransacao;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
    end;
  end;
end;

function TContratosComClientes.buscarContrato(pCodContrato: Integer; pNatureza: boolean): Boolean;
begin
   buscas.Close;
   buscas.SQL.Text := 'select tipo_servico.cod_servico, tipo_servico.codigo_nop from tipo_servico ' +
	   ' inner join tipo_servico_empresa on tipo_servico_empresa.cod_servico = tipo_servico.cod_servico and tipo_servico_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
     ' where tipo_servico.cod_servico = ' + IntToStr(pCodContrato) +
     ' and tipo_servico.ativo = 1 ';
   buscas.Open;

   if pNatureza then
     Result := (buscas.FieldByName('codigo_nop').AsFloat > 0)
   else
	  Result := not buscas.IsEmpty;
end;

function TContratosComClientes.buscarControle(pCodControle: Integer): Boolean;
begin
  buscas.Close;
  buscas.SQL.Text := ' select controles.codigo_ctrl, controles.nome_ctrl, controles.usar_boleto from controles ' +
    ' where controles.codigo_emp = ' + vDadosIni.codEmpresa +
    ' and controles.codigo_ctrl = ' + IntToStr(pCodControle) +
    ' and controles.cxent = ''S''' +
    ' and controles.ativo = 1';
  buscas.Open;

  Result := not buscas.IsEmpty;
end;

function TContratosComClientes.buscarVendedor(pCodVendedor: Integer): Boolean;
begin
   buscas.Close;
   buscas.SQL.Text := ' select c.cod_vendedor, c.nome_vendedor, f.desc_funcao from colaborador c ' +
     ' inner join funcoes f on f.cod_funcao = c.cod_funcao ' +
     ' where c.cod_empresa = ' + vDadosIni.codEmpresa +
     ' and c.ativo = 1 and c.cod_vendedor = ' + IntToStr(pCodVendedor) +
     ' and f.desc_funcao like ''%VENDEDOR%'' ';
   buscas.Open;
   Result := not buscas.IsEmpty;
end;

function TContratosComClientes._defineSqlAdicional: Boolean;
var
  I, erro: Integer;
  //  vsqlAdicional: string;
  formatodata: string;
  tempTipo: string;
  tempSql: string;
  vStatus: string;
begin
  result := true;
  rContratos.vSqlAdicional := '';

  tempSql := '';
  if rContratos.vCampo = 'Controle' then
    tempSql := 'CONTROLES.NOME_CTRL '
  else if rContratos.vCampo = 'Vendedor' then
    tempSql := 'COLABORADOR.NOME_VENDEDOR '
  else if rContratos.vCampo = 'Tipo Contrato' then
    tempSql := 'TIPO_SERVICO.DESC_SERVICO '
  else if (rContratos.vCampo = 'Nome Cliente') then
    tempSql := 'CLIENTES.NOME_CLIENTE '
  else if (rContratos.vCampo = 'Razao Cliente') then
    tempSql := 'CLIENTES.RAZAO '
  else if (rContratos.vCampo = 'CPF / CNPJ') then
    tempSql := 'CLIENTES.CPFCGC '
  else if (rContratos.vCampo = 'Fone') then
    tempSql := 'CLIENTES.FONE_CLIENTE '
  else if (rContratos.vCampo = 'Email') then
    tempSql := 'CLIENTES.EMAIL '
  else if (rContratos.vCampo = 'Cep') then
    tempSql := 'CLIENTES.CEP '
  else if (rContratos.vCampo = 'Endereco') then
    tempSql := 'CLIENTES.ENDERECO '
  else if (rContratos.vCampo = 'Numero') then
    tempSql := 'CLIENTES.NUM_END_CLIENTE '
  else if rContratos.vCampo = 'Sigla' then
    tempSql := 'ESTADOS.SIGLA_UF '
  else if rContratos.vCampo = 'Cidade' then
    tempSql := 'CIDADES.NOME_CIDADE '
  else if rContratos.vCampo = 'Bairro' then
    tempSql := 'BAIRROS.NOME_BAIRRO ';

  if tempSql  <> '' then
  begin
    if rContratos.vCondicao = 'Igual' then
      tempTipo := '= '
    else if rContratos.vCondicao = 'Maior' then
      tempTipo := '> '
    else if rContratos.vCondicao = 'Maior ou Igual' then
      tempTipo := '>= '
    else if rContratos.vCondicao = 'Menor' then
      tempTipo := '< '
    else if rContratos.vCondicao = 'Menor ou Igual' then
      tempTipo := '<= '
    else if rContratos.vCondicao = 'Diferente' then
      tempTipo := '<> '
    else if (rContratos.vCondicao = 'Esta contido') then
      tempTipo := 'like'
    else if (rContratos.vCondicao = 'Começa') then
      tempTipo := 'Começa'
    else
      tempTipo := '= ';

    if tempTipo = 'like' then
      tempSql := tempSql + tempTipo + QuotedStr('%' + rContratos.vValor + '%')
    else if tempTipo = 'Começa' then
      tempSql := tempSql + 'like' + QuotedStr(rContratos.vValor + '%')
    else
      tempSql := tempSql + tempTipo + QuotedStr(rContratos.vValor);
    rContratos.vValor := '';
    if Trim(rContratos.vSqlAdicional) <> '' then
      rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' and ' + tempSql
    else
      rContratos.vSqlAdicional := tempSql;
  end;

  if rContratos.vAdicional then
  begin
    if rContratos.vPorDataAd then
    begin
      try
        erro := 0;
        StrToDate(rContratos.vDataIniAd);
      except
        rContratos.vDataIniAd := '';
        erro := erro + 1;
      end;
      try
        StrToDate(rContratos.vDataFimAd);
      except
        rContratos.vDataFimAd := '';
        erro := erro + 1;
      end;
      if erro = 2 then
      begin
        Application.MessageBox('Data adicional Inválida. Informe no mínimo uma data correta',
          'Atenção', MB_OK + MB_ICONINFORMATION);
      end
      else
      begin
        if (pos('/', ShortDateFormat) <> 0) or (pos('-', ShortDateFormat) <> 0) then
          formatodata := 'mm/dd/yyyy'
        else if pos('.', ShortDateFormat) <> 0 then
          formatodata := 'dd.mm.yyyy';
        if rContratos.vDataIniAd <> '' then
          rContratos.vDataIniAd := QuotedStr(FormatDateTime(formatodata, strtodate(rContratos.vDataIniAd)));
        if rContratos.vDataFimAd <> '' then
          rContratos.vDataFimAd := QuotedStr(FormatDateTime(formatodata, strtodate(rContratos.vDataFimAd)));
      end;
    end
    else if rContratos.vValorAd = '' then
      exit;
    if rContratos.vCondicaoAd = 'Igual' then
      rContratos.vCondicaoAd := '='
    else if rContratos.vCondicaoAd = 'Maior' then
      rContratos.vCondicaoAd := '>'
    else if rContratos.vCondicaoAd = 'Maior ou Igual' then
      rContratos.vCondicaoAd := '>='
    else if rContratos.vCondicaoAd = 'Menor' then
      rContratos.vCondicaoAd := '<'
    else if rContratos.vCondicaoAd = 'Menor ou Igual' then
      rContratos.vCondicaoAd := '<='
    else if rContratos.vCondicaoAd = 'Diferente' then
      rContratos.vCondicaoAd := '<>'
    else if (rContratos.vCondicaoAd = 'Esta contido') then
      rContratos.vCondicaoAd := 'like'
    else if (rContratos.vCondicaoAd = 'Começa') then
      rContratos.vCondicaoAd := 'Começa'
    else
      rContratos.vCondicaoAd := '=';
    for I := 0 to dataSet.FieldCount - 1 do
    begin
      if Dataset.Fields[I].FieldKind = fkData then
      begin
        if UpperCase(dataset.Fields[I].DisplayName) = UpperCase(rContratos.vCampoAd) then
        begin
//          if rContratos.vCampo = rContratos.vCampoAd then
//          begin
//            rContratos.vsqlAdicional := '';
//            exit;
//          end;
          rContratos.vCampoAd := DataSet.Fields[I].FieldName;
          if ((Dataset.Fields[I] is TIntegerField) or (Dataset.Fields[I] is TFloatField) or
            (Dataset.Fields[I] is TCurrencyField) or (DataSet.Fields[I] is TSmallintField)) and
            ((rContratos.vCondicaoAd = 'Começa') or (rContratos.vCondicaoAd = 'Começa')) then
          begin
            if ((Dataset.Fields[I] is TIntegerField) or (DataSet.Fields[I] is TSmallintField)) then
            try
              strtoint(rContratos.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Informe um valor inteiro.'), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end
            else if ((Dataset.Fields[I] is TFloatField) or (DataSet.Fields[I] is TCurrencyField))
              then
            try
              strtofloat(rContratos.vValorAd);
            except
              Application.MessageBox(PChar('Valor para consulta adicional inválido.' + chr(13) +
                'Verifique os dados de sua pesquisa e tente novamente.' + chr(13) +
                'Não digite pontos e utilize como separador de decimais a vígula.'), 'Atenção',
                MB_ICONEXCLAMATION + MB_OK);
              result := false;
              exit;
            end;
            rContratos.vCondicaoAd := '=';
            rContratos.vValorAd := vDadosIni.trocaVirgulaPorPonto(rContratos.vValorAd);
          end
          else if (DataSet.Fields[i] is TDateField) or (DataSet.Fields[i] is TDateTimeField) then
          begin
            if Trim(rContratos.vSqlAdicional) <> '' then
		      	rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' and ';

            if (rContratos.vDataIniAd <> '') and (rContratos.vDataFimAd <> '') then
              rContratos.vSqlAdicional := rContratos.vsqlAdicional + rContratos.vCampoAd +
                ' >= ' + rContratos.vDataIniAd + ' and ' + rContratos.vCampoAd + ' <= ' + rContratos.vDataFimAd
            else if (rContratos.vDataFimAd <> '') then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + rContratos.vCampoAd +
                ' <= ' + rContratos.vDataIniAd
            else if (rContratos.vDataIniAd <> '') and (rContratos.vDataFimAd <> '') then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + rContratos.vCampoAd +
                ' >= ' + rContratos.vDataIniAd;
            Break;
          end;
          if Trim(rContratos.vSqlAdicional) <> '' then
		      rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' and ';

          if rContratos.vCondicaoAd = 'like' then
          begin
          	if rContratos.vCampoAd = 'NOME_CTRL' then
	           rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CONTROLES.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_VENDEDOR' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'COLABORADOR.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'DESC_SERVICO' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'TIPO_SERVICO.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if (rContratos.vCampoAd = 'NOME_CLIENTE') or (rContratos.vCampoAd = 'RAZAO') or (rContratos.vCampoAd = 'CPFCGC')
            	or (rContratos.vCampoAd = 'FONE_CLIENTE') or (rContratos.vCampoAd = 'EMAIL') or (rContratos.vCampoAd = 'CEP')
               or (rContratos.vCampoAd = 'ENDERECO') or (rContratos.vCampoAd = 'NUM_END_CLIENTE') then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'SIGLA_UF' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'ESTADOS.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_CIDADE' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CIDADES.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_BAIRRO' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'BAIRROS.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
            else
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES_COM_CONTRATO.' + rContratos.vCampoAd + ' like ' + QuotedStr('%' + rContratos.vValorAd + '%')
          end
          else if rContratos.vCondicaoAd = 'Começa' then
          begin
            if rContratos.vCampoAd = 'NOME_CTRL' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CONTROLES.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_VENDEDOR' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'COLABORADOR.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'DESC_SERVICO' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'TIPO_SERVICO.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if (rContratos.vCampoAd = 'NOME_CLIENTE') or (rContratos.vCampoAd = 'RAZAO') or (rContratos.vCampoAd = 'CPFCGC')
            	or (rContratos.vCampoAd = 'FONE_CLIENTE') or (rContratos.vCampoAd = 'EMAIL') or (rContratos.vCampoAd = 'CEP')
               or (rContratos.vCampoAd = 'ENDERECO') or (rContratos.vCampoAd = 'NUM_END_CLIENTE') then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'SIGLA_UF' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'ESTADOS.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_CIDADE' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CIDADES.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else if rContratos.vCampoAd = 'NOME_BAIRRO' then
            	rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'BAIRROS.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
            else
	            rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES_COM_CONTRATO.' + rContratos.vCampoAd + ' like ' + QuotedStr(rContratos.vValorAd + '%')
          end
          else //if rContratos.vCondicaoAd <> 'Começa' then
          begin
            if rContratos.vCampoAd = 'NOME_CTRL' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CONTROLES.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if rContratos.vCampoAd = 'NOME_VENDEDOR' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'COLABORADOR.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if rContratos.vCampoAd = 'DESC_SERVICO' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'TIPO_SERVICO.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if (rContratos.vCampoAd = 'NOME_CLIENTE') or (rContratos.vCampoAd = 'RAZAO') or (rContratos.vCampoAd = 'CPFCGC')
            	or (rContratos.vCampoAd = 'FONE_CLIENTE') or (rContratos.vCampoAd = 'EMAIL') or (rContratos.vCampoAd = 'CEP')
               or (rContratos.vCampoAd = 'ENDERECO') or (rContratos.vCampoAd = 'NUM_END_CLIENTE') then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if rContratos.vCampoAd = 'SIGLA_UF' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'ESTADOS.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if rContratos.vCampoAd = 'NOME_CIDADE' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CIDADES.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else if rContratos.vCampoAd = 'NOME_BAIRRO' then
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'BAIRROS.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd)
            else
              rContratos.vsqlAdicional := rContratos.vsqlAdicional + 'CLIENTES_COM_CONTRATO.' + rContratos.vCampoAd + ' ' + rContratos.vCondicaoAd + ' ' + QuotedStr(rContratos.vValorAd);
          end;
          Break;
        end;
      end;
    end;
  end;

  if (rContratos.avancada) then
  begin
  	if (trim(rContratos.vListaStatus) <>  '') then
    begin
      if Trim(rContratos.vSqlAdicional) <> '' then
        rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' and ';

      rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' CLIENTES_COM_CONTRATO.STATUS in ';

      rContratos.vsqlAdicional := rContratos.vsqlAdicional + '(' + trim(rContratos.vListaStatus) + ')';
    end;
  end;

  if rContratos.vERP <> rContratos.vPagOnline then
  begin
  	if Trim(rContratos.vSqlAdicional) <> '' then
    	rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' and ';

    if rContratos.vERP then
  		rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' COALESCE(CLIENTES_COM_CONTRATO.ASSINATURA_VINDI_ID, 0) <= 0 '
    else if rContratos.vPagOnline then
    	rContratos.vSqlAdicional := rContratos.vSqlAdicional + ' CLIENTES_COM_CONTRATO.ASSINATURA_VINDI_ID > 0 ';
  end;                                                                                                         
end;

function TContratosComClientes.confirmarAjusteContratos: Boolean;
var
	vdatabanco: TDateTime;
begin
  try
    Result := True;

    if Application.MessageBox('Reajuste de contratos.' + chr(13) +
      'Deseja confirmar o reajuste no valor dos contratos?',
      'Confirmação', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON2) = IDNO then
    begin
    	Result := False;
    	exit;
    end;

    try
      vdatabanco := vDadosIni.getDataBanco(buscas);

      vDadosIni.abreStatusProcessamento('', 'Confirmando ajuste dos contratos...');
   	  fTempAjuste.DisableControls;

      fTempAjuste.First;
      while not fTempAjuste.Eof do
      begin
      	Application.ProcessMessages;

      	vDadosIni.abreStatusProcessamento('', 'Ajustando contratos - ' + IntToStr(fTempAjuste.RecNo) + '/' + IntToStr(fTempAjuste.RecordCount));

        buscas.Close;
        buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO SET ' +
        	' VALOR_CONTRATO = :VALOR_CONTRATO, VALOR_SERV = :VALOR_CONTRATO, ' +
          ' DATA_REAJUSTE = :DATA_REAJUSTE, PERC_REAJUSTE = :PERC_REAJUSTE, US_MOD_CL = :US_MOD_CL ' +
          ' WHERE COD_CONTRATO = :COD_CONTRATO ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ' +
          ' AND COD_SERVICO > 0 ';
        buscas.ParamByName('COD_CONTRATO').AsInteger := fTempAjuste.FieldByName('COD_CONTRATO').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ParamByName('VALOR_CONTRATO').AsFloat := fTempAjuste.FieldByName('VALOR_AJUSTADO').AsFloat;
        buscas.ParamByName('DATA_REAJUSTE').AsDateTime := vdatabanco;
        buscas.ParamByName('PERC_REAJUSTE').AsFloat := fTempAjuste.FieldByName('PERC_REAJUSTE').AsFloat;
        buscas.ParamByName('US_MOD_CL').AsInteger := vDadosIni.vCodUsuario;
        buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO_SERV SET ' +
        	' VALOR_UN = (:PERC_REAJUSTE * VALOR_UN) ' +
        	' WHERE COD_CONTRATO = :COD_CONTRATO ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ';
        buscas.ParamByName('COD_CONTRATO').AsInteger := fTempAjuste.FieldByName('COD_CONTRATO').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
	      buscas.ParamByName('PERC_REAJUSTE').AsFloat := fTempAjuste.FieldByName('PERC_REAJUSTE').AsFloat;
      	buscas.ExecSQL;

        buscas.Close;
        buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO SET ' +
        	' DATA_REAJUSTE = :DATA_REAJUSTE, PERC_REAJUSTE = :PERC_REAJUSTE, US_MOD_CL = :US_MOD_CL ' +
          ' WHERE COD_CONTRATO = :COD_CONTRATO ' +
          ' AND COD_EMPRESA = :COD_EMPRESA ' +
          ' AND COD_SERVICO = 0 ';
        buscas.ParamByName('COD_CONTRATO').AsInteger := fTempAjuste.FieldByName('COD_CONTRATO').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := StrToInt(vDadosIni.codEmpresa);
        buscas.ParamByName('DATA_REAJUSTE').AsDateTime := vdatabanco;
        buscas.ParamByName('PERC_REAJUSTE').AsFloat := fTempAjuste.FieldByName('PERC_REAJUSTE').AsFloat;
        buscas.ParamByName('US_MOD_CL').AsInteger := vDadosIni.vCodUsuario;
        buscas.ExecSQL;

        vDadosIni.GravaAuditoria('CLI213', 'AJUSTAR',
        	'PERC: ' + FloatToStr(fTempAjuste.FieldByName('PERC_REAJUSTE').AsFloat),
          'CLIENTES_COM_CONTRATO', IntToStr(fTempAjuste.FieldByName('COD_CONTRATO').AsInteger), buscas);

        fTempAjuste.Next;
      end;
      fTempAjuste.First;
    finally
       vDadosIni.fechaStatusProcessamento;
       fTempAjuste.EnableConstraints;
    end;

    vDadosIni.GravaAuditoria('CLI213', 'AJUSTAR', 'SUCESSO', 'CLIENTES_COM_CONTRATO', '', buscas);

    CommitaTransacao;

    Application.MessageBox('Ajuste de contratos realizado com sucesso!', 'Atenção', 64);
  except on E: Exception do
    begin
      RollBackTransacao;
      Result := False;
      vDadosIni.GravaAuditoria('CLI213', 'AJUSTAR', 'FALHA', 'CLIENTES_COM_CONTRATO', '', buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', 0 + 64);
      registraErro(e.Message);
    end;
  end;
end;

constructor TContratosComClientes.create;
begin
  if DtmClientes = nil then
    DtmClientes := TDtmClientes.Create(DtmClientes);
  DataSet := TClientDataSet(DtmClientes.cdsContratoCl);
  transacao := TIBTransaction(DtmClientes.IBTransClientes);
  Buscas := TIBQuery(DtmClientes.qrBuscas);
  fCliente := TClientDataSet(DtmClientes.cdsConsCliente);
  fControles := TClientDataSet(DtmClientes.cdsCtrl);
  fContratos := TClientDataSet(DtmClientes.cdsTipServ);
  fColaborador := TClientDataSet(DtmClientes.cdsColoborador);
  fSelect := TClientDataSet(DtmClientes.cdsVendedor);
  fVendas := TClientDataSet(DtmClientes.cdsContratosOS);

  vServCtr := TContratosComClientesServ.create;
  vProdCtr := TContratosComClientesProd.create;
