                   'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas);
                 Application.MessageBox(pchar('Vale resgate gerado com sucesso '), 'Atenção', MB_ICONINFORMATION + MB_OK);
//                 Application.MessageBox(pchar('Vale resgate para ' +
//                    IfThen(vtiporeq = 'MOT', 'Comando de Faturamento', IfThen(vtiporeq = 'OS', 'Ordem de Serviço', 'Requisição')) +
//                    ' Nº ' + IntToStr(vReq) + ' gerado com sucesso '), 'Atenção', MB_ICONINFORMATION + MB_OK);
               end
               else
               begin
                 RollBackTransacao;
                 vDadosIni.GravaAuditoria('CLI221', 'GERAR', 'FALHA - ' +
                  'CLIENTE: ' + IntToStr(pCodCliente) + ' PONTOS - SALDO: ' + FormatFloat('#,##0', vSaldoCC) + ' ' + vtiporeq + ':' + IntToStr(vReq),
                  'CONTA_CORRENTE_PROG_FIDELIDADE', dataSet.FieldByName('CODIGO').AsString, buscas);
                 exit;
               end;
            except
              on e: Exception do
              begin
                Result := False;
