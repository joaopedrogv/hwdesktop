      	for I := 1 to Length(trim(dataset.FieldByName('cond_pag_vnd').AsString)) do
        begin
          vtemp := vtemp + trim(dataset.FieldByName('cond_pag_vnd').AsString[I]);
          if trim(dataset.FieldByName('cond_pag_vnd').AsString[I]) = ',' then
          	vtemp2 := vtemp;
