function TCodigoFornecedor.BuscarGrade(CodGrade: Integer): Boolean;
begin
  Result := false;

  buscas.Close;
  buscas.SQL.Text := 'SELECT * FROM GRADE ' +
    ' WHERE COD_GRADE =' + IntToStr(CodGrade) +
    ' and ATIVO =1';
  buscas.Open;

  if (((CodGrade > 0) and (buscas.IsEmpty)) or (CodGrade < 0)) then
  begin
    Application.MessageBox('Grade não encontrada', 'Atenção', MB_ICONWARNING + MB_OK);
    exit;
  end;

  Result := true;
end;

function TCodigoFornecedor.buscarPalavraOuFrase(palavra: string): boolean;
var
  ponteiro: TBookmark;
  encontrou1, encontrou2: boolean;
  i: integer;
  j: Integer;
begin
  try
    if dataSet.IsEmpty then
      Exit;
    encontrou1 := false;
    ponteiro := dataSet.GetBookmark;
    i := dataSet.RecordCount;
    j := 0;
    while not encontrou1 do
    begin
      dataSet.Next;
      encontrou1 :=
        (Pos(UpperCase(palavra), UpperCase(dataSet.FieldByName(vNomeDoCampoPesquisa).AsString)) >
        0);
      if dataSet.Eof then
        dataSet.First;
      inc(j);
      if j + 1 > i then
      begin
        dataSet.GotoBookmark(ponteiro);
        Exit;
      end;
    end;
  finally
    Result := encontrou1;
  end;

end;

