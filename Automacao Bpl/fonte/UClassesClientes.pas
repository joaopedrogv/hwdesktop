                       vcodigoProgFid := buscas2.FieldByName('codigo').AsInteger;
                       vperiodoVencPtos := buscas2.FieldByName('periodo_venc_pontos').AsInteger;
                       vpercProgFid := buscas2.FieldByName('perc_prog_fid').AsFloat;
                       vdataVencProgFid := buscas2.FieldByName('data_venc_prog').AsDateTime;
