                     dataSet.FieldByName('DESCRICAO').AsString := Copy('DÉBITO REF A REQUISIÇÃO TROCA Nº ' + IntToStr(vReq) + ' - ' + trim(vDadosIni.vEmp.vnomeEmpresa), 1, 100);

