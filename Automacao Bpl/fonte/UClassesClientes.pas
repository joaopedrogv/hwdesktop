function TCadPedidoCompraClProd.abreProdPed(CodPed: Integer): Boolean;
var
	vNumFabProdTmp: string;
	vDescrProdTmp: string;
begin
	Result := montaSelect(' select pedidocompracl_itens.* from pedidocompracl_itens ' +
    ' where pedidocompracl_itens.codigo = ' + IntToStr(CodPed) +
		' and pedidocompracl_itens.cod_empresa = ' + vDadosIni.codEmpresa +
    ' order by pedidocompracl_itens.nitem ');

  try
  	dataSet.DisableControls;
    dataSet.First;
    while not dataSet.Eof do
    begin
      buscas.Close;
      buscas.SQL.Text := 'select produtos.num_fab_prod, produtos.descr_prod from produtos ' +
        ' where produtos.grupo_prod = :grupo_prod ' +
        ' and produtos.cod_prod = :cod_prod ' +
        ' and produtos.cod_empresa = :cod_empresa ';
      buscas.ParamByName('GRUPO_PROD').AsInteger := dataSet.FieldByName('GRUPO_PROD').AsInteger;
      buscas.ParamByName('COD_PROD').AsString := dataSet.FieldByName('COD_PROD').AsString;
      buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
      buscas.Open;

      vNumFabProdTmp := trim(buscas.FieldByName('NUM_FAB_PROD').AsString);
      vDescrProdTmp := trim(buscas.FieldByName('DESCR_PROD').AsString);

      if dataSet.FieldByName('COD_GRADE').AsInteger > 0 then
      begin
        buscas.Close;
        buscas.SQL.Text := ' select grade.descricao from grade ' +
          ' where grade.cod_grade = :cod_grade ' +
          ' and grade.cod_empresa = :cod_empresa ';
        buscas.ParamByName('COD_GRADE').AsInteger := dataSet.FieldByName('COD_GRADE').AsInteger;
        buscas.ParamByName('COD_EMPRESA').AsInteger := dataSet.FieldByName('COD_EMPRESA').AsInteger;
        buscas.Open;

        vDescrProdTmp := trim(vDescrProdTmp) + ' ' + trim(buscas.FieldByName('DESCRICAO').AsString);
      end;

      dataSet.Edit;

      dataSet.FieldByName('DESCR_PROD').AsString := trim(vDescrProdTmp);
      dataSet.FieldByName('NUM_FAB_PROD').AsString := trim(vNumFabProdTmp);
      dataSet.FieldByName('VALOR_TOT').AsFloat :=
        dataSet.FieldByName('QUANT').AsFloat *
        dataSet.FieldByName('VALOR').AsFloat;
      dataSet.Post;

      dataSet.Next;
    end;
  finally
  	dataSet.EnableControls;
  	dataSet.First;
  end;
end;

