      Result := false;
      vDadosIni.GravaAuditoria('CLI288', 'EXCLUIR', 'FALHA', 'CLIENTES_COM_CONTRATO_PROD', IntToStr(vCOD_CONTRATO_PROD), buscas);
			Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContratosComClientesProd.GetPedidos(ACodCliente: Integer): PedidosComprasDoContrato;
var
  pedido: PedidoCompraDoContrato;
begin
  Self.queryCons.SQL(
    'select pc.codigo, pit.nitem, pc.data_pedido, pc.num_pedido, pit.nitem_nfe, pit.quant, sum(env.qtde_env) qtde_env' +
    ' from pedidocompracl_itens pit' +
    ' left join pedidocompracl_itens_env env on env.codigo = pit.codigo and env.cod_empresa = pit.cod_empresa' +
    '   and env.nitem = pit.nitem' +
    ' inner join pedidocompracl pc on pc.codigo = pit.codigo and pc.cod_empresa = pit.cod_empresa' +
    ' where pit.grupo_prod = %d and pit.cod_prod = ''%s'' and pit.cod_grade = %d and pit.cod_empresa = %d' +
    ' group by codigo, nitem, data_pedido, num_pedido, nitem_nfe, quant' +
    ' order by data_pedido desc, num_pedido' ,
    [fint('grupo_prod'), fstr('cod_prod'), fint('cod_grade'), vDadosIni.cod_empresa]).Open().Last().First();

  Result := PedidosComprasDoContrato.Create();
  //SetLength(Result, Self.queryCons.query.RecordCount);

  while not Self.queryCons.Eof() do
  begin
    pedido := PedidoCompraDoContrato.Create;

    pedido.Codigo  := Self.queryCons.fint('codigo');
    pedido.NItem  := Self.queryCons.fint('nitem');
    pedido.DataPedido  := Self.queryCons.fdate('data_pedido');
    pedido.Numero  := Self.queryCons.fstr('num_pedido');
    pedido.NumItem  := Self.queryCons.fint('nitem_nfe');
    pedido.QtdePed := Self.queryCons.ffloat('quant');
    pedido.QtdeEnv := Self.queryCons.ffloat('qtde_env');
//    Result[ Self.queryCons.query.RecNo - 1].Codigo  := Self.queryCons.fint('codigo');
//    Result[ Self.queryCons.query.RecNo - 1].DataPedido  := Self.queryCons.fdate('data_pedido');
//    Result[ Self.queryCons.query.RecNo - 1].Numero  := Self.queryCons.fstr('num_pedido');
//    Result[ Self.queryCons.query.RecNo - 1].NumItem  := Self.queryCons.fint('nitem_nfe');
//    Result[ Self.queryCons.query.RecNo - 1].QtdePed := Self.queryCons.ffloat('quant');
//    Result[ Self.queryCons.query.RecNo - 1].QtdeEnv := Self.queryCons.ffloat('qtde_env');

    Result.Add( pedido );
    Self.queryCons.Next();
  end;
end;

function TContratosComClientesProd.post(Contratos: TContratosComClientes): boolean;
begin
	try
    Result := False;

    if not vDadosIni.PesqPros('CLI289', 'SALVAR',
    	'Ctr ' + IntToStr(vCOD_CONTRATO),
      'CLIENTES_COM_CONTRATO_PROD',
    	'', buscas, true) then
	    exit;

  	if vGRUPO_PROD <= 0 then
      raiseExceptionCreate('Produto não informado', 'EditNumFabProd');

    if trim(vCOD_PROD) = '' then
    	raiseExceptionCreate('Produto não informado', 'EditNumFabProd');

    if not buscarProd(vGRUPO_PROD, vCOD_PROD, 0) then
    	raiseExceptionCreate('Produto não encontrado', 'EditNumFabProd');

    if vCOD_GRADE > 0 then
      if not buscarProd(vGRUPO_PROD, vCOD_PROD, vCOD_GRADE) then
        raiseExceptionCreate('Grade não encontrada para o produto', 'EditNumFabProd');

    if vQTDE <= 0 then
      raiseExceptionCreate('Quantidade não informada', 'EditHwQtdeProd');

    if vVALOR_UN <= 0 then
      raiseExceptionCreate('Valor unitário não informada', 'EditHwValorUnProd');

    buscas.Close;
    if trim(vMODO) = 'INSERIR' then
    begin
      buscas.SQL.Text := ' INSERT INTO CLIENTES_COM_CONTRATO_PROD ' +
      	' (COD_CONTRATO_PROD, COD_EMPRESA, COD_CONTRATO, GRUPO_PROD, COD_PROD, COD_GRADE, QTDE, VALOR_UN) ' +
        ' VALUES ' +
        ' (:COD_CONTRATO_PROD, :COD_EMPRESA, :COD_CONTRATO, :GRUPO_PROD, :COD_PROD, :COD_GRADE, :QTDE, :VALOR_UN); ';
      vCOD_CONTRATO_PROD := Gencodigo('CLIENTES_COM_CONTRATO_PROD', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
      buscas.ParamByName('COD_CONTRATO_PROD').AsInteger := vCOD_CONTRATO_PROD;
    end
    else
    begin
      buscas.SQL.Text := ' UPDATE CLIENTES_COM_CONTRATO_PROD SET ' +
      	' COD_CONTRATO = :COD_CONTRATO, ' +
        ' GRUPO_PROD = :GRUPO_PROD, ' +
        ' COD_PROD = :COD_PROD, ' +
        ' COD_GRADE = :COD_GRADE, ' +
        ' QTDE = :QTDE, ' +
        ' VALOR_UN = :VALOR_UN ' +
        ' WHERE COD_CONTRATO_PROD = :COD_CONTRATO_PROD ' +
        ' AND COD_EMPRESA = :COD_EMPRESA; ';
      buscas.ParamByName('COD_CONTRATO_PROD').AsInteger := vCOD_CONTRATO_PROD;
    end;
    buscas.ParamByName('COD_EMPRESA').AsInteger    := StrToInt(vDadosIni.codEmpresa);
    buscas.ParamByName('COD_CONTRATO').AsInteger   := vCOD_CONTRATO;
    buscas.ParamByName('GRUPO_PROD').AsInteger     := vGRUPO_PROD;
    buscas.ParamByName('COD_PROD').AsString        := vCOD_PROD;
    buscas.ParamByName('COD_GRADE').AsInteger      := vCOD_GRADE;
    buscas.ParamByName('QTDE').AsFloat             := vQTDE;
    buscas.ParamByName('VALOR_UN').AsFloat         := vVALOR_UN;
    buscas.ExecSQL;

    CommitaTransacao;

    vDadosIni.GravaAuditoria('CLI289', trim(vModo), 'SUCESSO', 'CLIENTES_COM_CONTRATO_PROD', IntToStr(vCOD_CONTRATO_PROD), buscas);

    abreProdCtr(Contratos);

  	Result := True;
	except
    on e: Exception do
    begin
      Result := false;
      vDadosIni.GravaAuditoria('CLI289', trim(vModo), 'FALHA', 'CLIENTES_COM_CONTRATO_PROD', IntToStr(vCOD_CONTRATO_PROD), buscas);
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContratosComClientesProd._abreFormSelecionaGradeProd(grupo: integer;
  codProd: string): boolean;
var
  formulario: TfrmPadrao;
begin
  try
    formulario := TfrmPadrao.Create(Application);
    formulario.Width := 800;
    formulario.Height := 600;
    formulario.Position := poScreenCenter;
    formulario.BorderIcons := [];
    formulario.Caption := 'Selecionar Grade do produto';
    frmCadContratosClientes.pnSelecionaGradeProd.Parent := formulario;
    formulario.AutoSize := True;
    formulario.AutoScroll := False;
    formulario.KeyPreview := True;

    frmCadContratosClientes.Label38.Caption := '';
    frmCadContratosClientes.Label39.Caption := '';
    frmCadContratosClientes.Label40.Caption := '';

    buscas.Close;
    buscas.SQL.Text := 'select pr.descr_prod, g.cod_grade,g.descricao,g.descricao1,' +
      ' (cgp.qtde - coalesce((select sum(pp.quant_ped_item) from  pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped=pp.nped and v.cod_empresa=pp.cod_empresa and pp.tipo=v.tipo' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade=cgp.cod_grade ' +
      ' and pp.cod_empresa =cgp.cod_empresa ' +
      ' and ((v.status_ped <>''FECHADA'') or (v.status_ped is null))' +
      ' and (pp.status<>''CANCELADO'' or pp.status is null)' +
      //' and v.NPED<>' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
    ' and v.tipo<>''ORC''),0)) as qtd_item_disponivel, ' +
      ' cgp.qtde, ' +
      '(coalesce((select sum(pp.quant_ped_item) from  pedvenda_prod pp ' +
      ' inner join pedvenda v on v.nped=pp.nped and v.cod_empresa=pp.cod_empresa and pp.tipo=v.tipo' +
      ' where pp.grupo_prod = cgp.grupo_prod ' +
      ' and pp.cod_prod = cgp.cod_prod ' +
      ' and pp.cod_grade=cgp.cod_grade ' +
      ' and pp.cod_empresa =cgp.cod_empresa ' +
      ' and ((v.status_ped <>''FECHADA'') or (v.status_ped is null))' +
      ' and (pp.status<>''CANCELADO'' or pp.status is null)' +
      //' and v.NPED<>' + inttostr(dataSet.FieldByName('NPED').AsInteger) +
      ' and v.tipo<>''ORC''),0)) as qtd_item_pedAberto from grade g' +
      ' inner join cod_grade_prod cgp on g.cod_grade=cgp.cod_grade and g.cod_empresa =cgp.cod_empresa ' +
      ' inner join produtos pr on pr.grupo_prod = cgp.grupo_prod and pr.cod_prod = cgp.cod_prod and pr.cod_empresa = cgp.cod_empresa' +
      ' where cgp.grupo_prod = ' + inttostr(grupo) +
      ' and cgp.cod_prod = ' + QuotedStr(codProd) +
      ' and cgp.cod_empresa =' + vDadosIni.codEmpresa +
      ' order by g.cod_grade';
    buscas.open;
    buscas.FieldByName('cod_grade').DisplayLabel := 'Grade';
    buscas.FieldByName('descricao').DisplayLabel := 'Descrição 1';
    buscas.FieldByName('descricao1').DisplayLabel := 'Descrição 2';
    buscas.FieldByName('qtde').DisplayLabel := 'Qtd. total da grade';
    buscas.FieldByName('qtd_item_pedAberto').DisplayLabel := 'Qtd. em Vendas em Aberto';
    buscas.FieldByName('qtd_item_disponivel').DisplayLabel := 'Qtd. Disponível';
    buscas.FieldByName('descr_prod').Visible := false;
    frmCadContratosClientes.dsSelecionaGradeProd.dataSet := buscas;
    frmCadContratosClientes.Label38.Caption := buscas.FieldByName('descr_prod').Text;
    frmCadContratosClientes.Label39.Caption := IntToStr(grupo);
    frmCadContratosClientes.Label40.Caption := codProd;
    result := (formulario.ShowModal = IDOK);
    nGradeSelecionada := buscas.FieldByName('cod_grade').AsInteger;

  finally
    buscas.close;
    frmCadContratosClientes.pnSelecionaGradeProd.Parent := frmCadContratosClientes.tsSelecionaGradeProd;
    formulario.Free;
    formulario := nil;
  end;
end;

