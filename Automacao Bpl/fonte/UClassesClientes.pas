function TContratosComClientes._consultar_vendedor: boolean;
var
  cod_vendedor: string;
begin
  fSelect.Close;
  fSelect.CommandText := ' select c.cod_vendedor from colaborador c ' +
    ' inner join funcoes f on f.cod_funcao  = c.cod_funcao ' +
    ' where f.desc_funcao like ''%VENDEDOR%'' and c.cod_empresa = ' + vDadosIni.codEmpresa;
  fSelect.Open;

  fSelect.First;
  while not fSelect.Eof do
