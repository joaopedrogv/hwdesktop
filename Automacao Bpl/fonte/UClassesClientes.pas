function TCadClientes.SituacaoDeCaixa(sempreExibirFicha: boolean; venda: boolean = false; mensagem: string = ''): Boolean;
var
	vVisualizarCreditosVenc: Boolean;
  vMensagem: string;
begin
  try
    Result := false;

    SetLength(SituacaoCaixa, 6);

    AtualizarSituacaoCaixa;

    if (((possuiVale) and (not Recibos.buscas.IsEmpty)) and (not possuiDebito)) then
	    Application.MessageBox('Cliente possui Vale Compra / Recibos', 'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);

    if sempreExibirFicha then
      ShowFormulario := True
    else if (possuiDebito and ((not Creditos.buscas.IsEmpty) or (not Cheques.buscas.IsEmpty) or (not Recibos.buscas.IsEmpty))) 	or
            ((possuiVale) and (not Recibos.buscas.IsEmpty)) then
      ShowFormulario := vDadosIni.PesqPros('VND253', 'VISUALIZAR', '', '', fstr('COD_CLIENTE'), buscas, False, False, True);

    if ShowFormulario then
    begin
      Application.CreateForm(TFrmSituacaoCx, FrmSituacaoCx);

      ControleCred.abreControles;
      ControleCheq.abreControles;

      FrmSituacaoCx.DblControleCC.KeyValue := 0;
      FrmSituacaoCx.DblControleCH.KeyValue := 0;

      vVisualizarCreditosVenc := vDadosIni.getConfSisBool('cl_ficha_exib_somente_cred_cheq_venc', buscas);
      if vVisualizarCreditosVenc then
      begin
      	FrmSituacaoCx.GbFiltrarCC.Visible := False;
        FrmSituacaoCx.GbFiltrarCC.Height := 0;
      end;
      if vVisualizarCreditosVenc then
      begin
      	FrmSituacaoCx.GbFiltrarCH.Enabled := False;
        FrmSituacaoCx.GbFiltrarCH.Height := 0;
      end;

      FrmSituacaoCx.Label117.Caption   := SituacaoCaixa[0];
      FrmSituacaoCx.Label118.Caption   := SituacaoCaixa[1];
      FrmSituacaoCx.Label121.Caption   := SituacaoCaixa[2];
      FrmSituacaoCx.Label122.Caption   := SituacaoCaixa[3];
      FrmSituacaoCx.Label8.Caption     := SituacaoCaixa[4];
      FrmSituacaoCx.Label10.Caption    := SituacaoCaixa[5];
      FrmSituacaoCx.LbDev.Caption      := format('%n', [vtdev]);
      FrmSituacaoCx.LbLiquido.Caption  := format('%n', [vtpg - vtdev]);
      FrmSituacaoCx.lbDevChq.Caption   := format('%n', [vtdevchq]);
      FrmSituacaoCx.LbLiqChq.Caption   := format('%n', [vtpgchq - vtdevchq]);
      FrmSituacaoCx.LbVencCred.Caption := format('%n', [vtotcredvenc]);
      FrmSituacaoCx.LbVencChq.Caption  := format('%n', [vtotchqvenc]);

      FrmSituacaoCx.DBGrid1.DataSource := fTempEmpresasDtSource;
      FrmSituacaoCx.Caption := 'Situação de Caixa [Ficha financeira do cliente: ' +
        trim(dataSet.FieldByName('NOME_CLIENTE').asstring) + ']';
      FrmSituacaoCx.vCliente := self;
      FrmSituacaoCx.showModal;
    end;

    if ((possuiDebito) and (venda)) then
    begin
    	vMensagem := 'Cliente com debito, Deseja continuar a venda?';
      if trim(mensagem) <> '' then
      	vMensagem := mensagem;

      if Application.MessageBox(PChar(vMensagem), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = IDNO then
        Exit;

      if not vDadosIni.PesqPros('VND157', 'PERMITIR', '', '',
        dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
        Exit;
    end;

    Result := true;

  finally
    buscas.close;
    Recibos.buscas.close;
    Creditos.buscas.close;
    Cheques.buscas.Close;
    FrmSituacaoCx.Free;
    FrmSituacaoCx := nil;
    if FrmCadClientes <> nil then
      formClienteAberto := true;
    vDadosIni.fechaStatusProcessamento;
  end;
end;

