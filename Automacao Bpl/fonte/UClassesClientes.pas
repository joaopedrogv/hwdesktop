                    ' and cc2.data_venc_prog >= ' + vDadosIni.FusoDateFb(True) + ') pontosgeral, ' +
                    ' (select sum(case when(trim(cc2.tipo) = ''CRÉDITO'') then ' +
                    '             cc2.valor ' +
                    '         else ' +
                    '             (-1) * cc2.valor end) valor from conta_corrente_prog_fidelidade cc2 ' +
                    ' inner join clientes cl2 on cl2.cod_cliente = cc2.cod_cliente and cl2.cod_empresa = cc2.cod_empresa ' +
                    ' left join empresa_prog_fid empg2 on coalesce(cc2.cod_emp_resp, cc2.cod_empresa) = empg2.cod_empresa ' +
                    ' where cl2.cpfcgc = :CPFCGC ' +
                    ' and coalesce(cc2.cod_emp_resp, cc2.cod_empresa) in (case when(empg2.cod_empresa > 0) then empg2.cod_empresa else cast(:COD_EMPRESA as Integer) end) ' +
                    ' and cc2.data_venc_prog >= ' + vDadosIni.FusoDateFb(True) + ') valorgeral, ' +
                    ' coalesce(( ' +
                    ' 	select sum(case when(trim(cc.tipo) = ''CRÉDITO'') then ' +
                    '											cc.pontos ' +
                    '										else ' +
                    '											(-1) * cc.pontos end) pontos ' +
                    ' 	from conta_corrente_prog_fidelidade cc ' +
                    ' 	inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
                    ' 	where cl.cpfcgc = :CPFCGC ' +
                    ' 	and cc.data_venc_prog >= ' + vDadosIni.FusoDateFb(True) +
                    ' 	and coalesce(cc.cod_emp_resp, cc.cod_empresa) = emp.cod_empresa), 0) pontos, ' +
                    ' coalesce(( ' +
                    ' 	select sum(case when(trim(cc.tipo) = ''CRÉDITO'') then ' +
                    '									    cc.valor ' +
                    '										else ' +
                    '											(-1) * cc.valor end) valor ' +
                    ' 	from conta_corrente_prog_fidelidade cc ' +
                    ' 	inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
                    ' 	where cl.cpfcgc = :CPFCGC ' +
                    ' 	and cc.data_venc_prog >= ' + vDadosIni.FusoDateFb(True) +
                    ' 	and coalesce(cc.cod_emp_resp, cc.cod_empresa) = emp.cod_empresa), 0) valor ' +
                    ' from empresa emp ' +
                    ' left join empresa_prog_fid empg on empg.cod_empresa = emp.cod_empresa ' +
                    ' where emp.cod_empresa in (case when(empg.cod_empresa > 0) then empg.cod_empresa else cast(:COD_EMPRESA as Integer) end) ' +
                    ' and coalesce((select cs.value1_f from config_sistema cs ' +
