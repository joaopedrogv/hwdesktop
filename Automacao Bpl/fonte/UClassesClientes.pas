                     dataSet.FieldByName('DATA_LANC').AsDateTime := vDadosIni.getDataBanco(buscas);
                     dataSet.FieldByName('CODIGO').AsInteger := Gencodigo('CONTA_CORRENTE_PROG_FIDELIDADE', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);
