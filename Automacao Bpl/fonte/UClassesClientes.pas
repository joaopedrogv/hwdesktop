procedure TContratosComClientes.InserirTipoContato(
  pCk_contrato_pla_tipos_contato: TCheckListBox);
begin
	pCk_contrato_pla_tipos_contato.Clear;

  buscas.Close;
  buscas.SQL.Text := ' select tipo_contato.id, tipo_contato.tipo from tipo_contato ' +
  	' where tipo_contato.cod_empresa = ' + vDadosIni.codEmpresa;
  buscas.Open;
  buscas.FetchAll;

  buscas.First;
  while not buscas.Eof do
  begin
  	pCk_contrato_pla_tipos_contato.Items.Add(
      vDadosIni.StrZero(buscas.FieldByName('id').AsInteger, 3) + ' | ' +
    	trim(buscas.FieldByName('tipo').AsString)
    );

    buscas.Next;
  end;

  if pCk_contrato_pla_tipos_contato.Count = 1 then
  	pCk_contrato_pla_tipos_contato.Checked[pCk_contrato_pla_tipos_contato.Count - 1] := True;
end;

procedure TContratosComClientes.inserirTpServicoZero;
begin
	try
    buscas.Close;
    buscas.SQL.Text := ' SELECT COD_SERVICO FROM TIPO_SERVICO ' +
      ' WHERE COD_SERVICO = :COD_SERVICO ';
    buscas.ParamByName('COD_SERVICO').AsInteger    := 0;
    buscas.Open;

    if buscas.IsEmpty then
    begin
      buscas.Close;
      buscas.SQL.Text := ' INSERT INTO TIPO_SERVICO  (COD_SERVICO, DESC_SERVICO, ATIVO) ' +
        ' VALUES (:COD_SERVICO, :DESC_SERVICO, :ATIVO); ';
      buscas.ParamByName('COD_SERVICO').AsInteger  := 0;
      buscas.ParamByName('DESC_SERVICO').AsString  := 'SEM SERVICO';
      buscas.ParamByName('ATIVO').AsInteger        := 99;
      buscas.ExecSQL;

      CommitaTransacao;
    end;
  except
    on e: Exception do
    begin
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

