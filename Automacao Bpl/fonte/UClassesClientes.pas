function TCadClientes._abreFormCapturaWecam: boolean;
var
  HandleWebCam: THandle;
  a: TMemoryStream;
  Jpg: TJpegImage;
  Bmp: Graphics.TBitmap;
begin
  try
    result := false;
    if not vDadosIni.PesqPros('CLI169', 'GRAVAR', '', 'FOTOS',
      dataSet.FieldByName('COD_CLIENTE').AsString, buscas, true) then
      Exit;
    HandleWebCam := 0;
    HandleWebCam := LoadLibrary('CapturaFoto.DLL');
    if HandleWebCam <> 0 then
    begin
      @_getImagemCapturadaWebCam := GetProcAddress(HandleWebCam, '_getImagemCapturadaWebCam');
    end
    else
    begin
      Application.MessageBox(PChar('DLL para capturar imagem da WebCam não encontrada'),
        'Informação', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
      exit;
    end;
    try
      jpg := nil;
      Bmp := nil;
      Foto.ImageCli.Picture.Bitmap := nil;
      a := TMemoryStream.Create;
      a := _getImagemCapturadaWebCam;
      if a = nil then
      begin
        _recuperarFotoCliente;
        a.Free;
        exit;
      end;

      if a.Size > 0 then
      begin
        // aqui ta o problema, como recuperar o jpeg do banco
        // perceba que a variavel 'Jpg' é do tipo TJpegImage que por sua vez é uma classe TGraphic
        // e que portanto poderá ser assinalada a propriedade Image1.Picure[.Graphic]
        try
          Bmp := Graphics.TBitmap.Create;
          Bmp.LoadFromStream(a);
          Jpg := TJpegImage.Create;
          Jpg.Assign(Bmp);
          Foto.ImageCli.Picture.Assign(Jpg);
        except
        end;
      end
      else
      begin
        // Essa seria a maneira natural de eliminar um desenho dentro do
        // TImage, pois se fizessemos um Image1.Picture.Graphic:=nil como
        // sugerem alguns exemplos na internet, provocariamos um 'access violation',
        // pois um nulo não pode ser tratado como bitmap ou jpeg.
        Foto.ImageCli.Picture.Assign(nil);
      end;
      result := true;
//      Application.MessageBox('Imagem Capturada com sucesso!', 'Informação', MB_OK +
//        MB_ICONINFORMATION);
      _gravarFotoCliente(1);
      Foto.abreFotoCliente;

    except
      on e: exception do
      begin
        Application.MessageBox(Pchar(e.message), 'Erro ao capturar imagem: ', MB_ICONERROR);
      end;
    end;
  finally
    FreeLibrary(HandleWebCam);
  end;
end;

