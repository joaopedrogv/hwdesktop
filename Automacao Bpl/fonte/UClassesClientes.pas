function TContratosComClientes._cancelar: boolean;
begin
  vDESCR_CONTRATO := '';
  vCOD_CLIENTE := 0;
  vCOD_SERVICO := 0;
  vCOD_SERVICO_ANT := 0;
  vCOD_CONTROLE := 0;
  vCOD_COLABORADOR := 0;
  vDIA_VENCIMENTO := 0;
  vDIA_FATURAMENTO := 0;
  vDIAS_APOS_VENC := 0;
  VMODO := '';
  vBOLETO := '';
  vOBS := '';
	vVALOR_CONTRATO := 0;
  vVALOR_SERV := 0;
  vVALOR_PROD := 0;
  vDATA_INICIAL_VIGENCIA := 0;
  vDATA_FINAL_VIGENCIA := 0;
  vDATA_IMPRESSAOBOL_INICIAL := 0;
  vDATA_CANCELAMENTO := 0;
  vCONTRATOS_CADA_MES := 1;
  vSTATUS := '';
  vTIPO_OS := '';
  vGerarNFS := 'S';
  vGerarNF := 'S';
  vGerarRecLoc := 'S';
  vGerarBoleto := 'S';

  fControles.Close;
  fControles.CommandText := ' select controles.codigo_ctrl, controles.nome_ctrl, controles.usar_boleto from controles ' +
    ' where controles.codigo_emp = ' + vDadosIni.codEmpresa +
    ' and controles.cxent = ''S'' ' +
    ' and controles.ativo = 1 ';
  fControles.Open;

  fContratos.Close;
