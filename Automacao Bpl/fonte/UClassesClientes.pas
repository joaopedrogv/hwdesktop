function TPossivelCliente.DadosPessoaisObrigatorios: boolean;
begin
	try
    Result := true;

    if trim(dataSet.FieldByName('NOME_CLIENTE').AsString) = '' then
    	raiseExceptionCreate('Nome do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit7');

		if trim(dataSet.FieldByName('RAZAO').asstring) = '' then
      raiseExceptionCreate('Razao Social não Informada' + chr(13) + 'Campo Requerido.', 'DBEdit8');

    if trim(dataSet.FieldByName('ENDERECO').AsString) = '' then
      raiseExceptionCreate('Endereço do Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit9');

    if dataSet.FieldByName('CEP').IsNull then
      raiseExceptionCreate('CEP não informado' + chr(13) + 'Campo Requerido.', 'DBEdit12');

    if dataSet.FieldByName('COD_BAIRRO').IsNull then
      raiseExceptionCreate('Bairro não informado.' + chr(13) + 'Campo Requerido.', 'DBEdit10');

    SetNomeBairro;
    if trim(dataSet.FieldByName('BAIRRO').AsString) = '' then
      raiseExceptionCreate('Bairro do Cliente em branco.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox7');

    if dataSet.FieldByName('COD_CIDADE').IsNull then
      raiseExceptionCreate('Cidade não informada.' + chr(13) + 'Campo Requerido.', 'DBEdit11');

    SetNomeCidade;
    if trim(dataSet.FieldByName('CIDADE').AsString) = '' then
      raiseExceptionCreate('Cidade do Cliente em branco.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox6');

    if dataSet.FieldByName('CODIGO_UF').IsNull then
      raiseExceptionCreate('UF não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox1');

    SetNomeEstado;
    if trim(dataSet.FieldByName('ESTADOS_UF').AsString) = '' then
      raiseExceptionCreate('UF do Cliente em branco.' + chr(13) + 'Campo Requerido.', 'DBEdit5');

    if dataSet.FieldByName('DATA_NASC').AsDateTime > date then
      raiseExceptionCreate('Data de Nascimento maior que data atual.' + chr(13) + 'Favor verificar.', 'DBEdit20');

    if dataSet.FieldByName('CODIGO_TIPO').IsNull then
      raiseExceptionCreate('Tipo Cliente não informado.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox2');

    SetNomeTipoCliente;
    if trim(dataSet.FieldByName('DESC_TP_CLIENTE').AsString) = '' then
      raiseExceptionCreate('Tipo Cliente em branco.' + chr(13) + 'Campo Requerido.', 'DBLookupComboBox2');

    if trim(dataSet.FieldByName('NATURALID').AsString) = '' then
      dataSet.FieldByName('NATURALID').AsString := dataSet.FieldByName('CIDADE').AsString;

    dataSet.FieldByName('DATA_MOD_CAD').AsDateTime := vDadosIni.getDataBanco(buscas);

    if dataSet.FieldByName('EST_CODIGO_UF').IsNull then
    begin
      dataSet.FieldByName('EST_CODIGO_UF').asinteger := dataSet.FieldByName('CODIGO_UF').asinteger;

      if dataSet.FieldByName('EST_CODIGO_UF').AsInteger > 0 then
      begin
         SqlOpen(' select codigo_uf, sigla_uf from estados ' +
          ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('EST_CODIGO_UF').AsInteger) +
          ' and ativo = 1 ');
         if not buscas.IsEmpty then
           dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
      end;
    end;
  except
    on e: Exception do
    begin
      Result := False;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TPossivelCliente.delete: boolean;
var
	codCliente, nomeFantasia, razaoSocial, cpfcpnpj: string;
  vtemp: string;
begin
	try
    Result := False;
    if dataSet.IsEmpty then
      exit;

    try
      codCliente := trim(dataSet.FieldByName('COD_CLIENTE').AsString);
      nomeFantasia := trim(dataSet.FieldByName('NOME_CLIENTE').AsString);
      razaoSocial := trim(dataSet.FieldByName('RAZAO').AsString);
      cpfcpnpj := trim(dataSet.FieldByName('CPFCGC').AsString);

      prepare_loop('SEL = ''S''');
      if not dataset.IsEmpty then
      begin
        codCliente := '';
        nomeFantasia := '';
        razaoSocial := '';
        cpfcpnpj := '';
      end;
    finally
      prepare_loop_done;
    end;

  	try
      if (trim(codCliente) <> '') then
        prepare_loop('COD_CLIENTE = ' + codCliente)
      else
        prepare_loop('SEL = ''S''');

      vtemp := 'Tem certeza que deseja excluir este registro permanentemente?' + #13 + #13 +
          'CLIENTE' + #13 +
          'Código: ' + codCliente + #13 +
          'Nome Fantasia: ' + nomeFantasia + #13 +
          'Razão Social: ' + razaoSocial + #13 +
          'CPF/CNPJ: ' + cpfcpnpj;

        if (trim(codCliente) = '') then
          vtemp := 'Tem certeza que deseja excluir os ' + IntToStr(dataSet.RecordCount) + ' registros selecionados permanentemente?';

        if not vDadosIni.PesqPros('CLI036', '', '', 'CLIENTES',
          vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas, false) then
          exit;

        if Application.MessageBox(PChar(vtemp),
          'Excluir Registro', MB_YESNO + MB_ICONQUESTION + MB_DEFBUTTON1) <> idyes then
          exit;

        vDadosIni.abreStatusProcessamento('', 'Excluíndo cliente(s) permanentemente');

        dataset.First;
        while not dataset.Eof do
        begin
        	vDadosIni.abreStatusProcessamento('', 'Excluíndo cliente(s) permanentemente (' + IntToStr(dataSet.RecNo) + '/' + IntToStr(dataSet.RecordCount) + ')');

          SqlOpen(' select first 1 nped, tipo, cod_empresa from pedvenda ' +
          	' where cod_cliente = %d and cod_empresa = %d ',
           	[fint('cod_cliente'), fint('cod_empresa')], buscas);

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 cod_nf, cod_empresa from notafiscal ' +
              '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 numeronota, cod_empresa from nf_serie_d ' +
              '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if buscas.IsEmpty then
          begin
          	SqlOpen(' select first 1 cod_nfce, cod_empresa from nfce ' +
            '	where cod_cliente = %d and cod_empresa = %d ',
              [fint('cod_cliente'), fint('cod_empresa')], buscas);
          end;

          if not buscas.IsEmpty then
          begin
            vtemp := 'Cliente utilizado em Vendas/Nota Fiscal/Nota Fiscal série D/Nota Fiscal de Consumidor Eletrônica' +
              ', não é possível excluir.' + #13 + #13 +
              'CLIENTE' + #13 +
              'Código: ' + dataSet.FieldByName('COD_CLIENTE').AsString + #13 +
              'Nome Fantasia: ' + dataSet.FieldByName('NOME_CLIENTE').AsString + #13 +
              'Razão Social: ' + dataSet.FieldByName('RAZAO').AsString + #13 +
              'CPF/CNPJ: ' + dataSet.FieldByName('CPFCGC').AsString;

            Application.MessageBox(PChar(vtemp), 'Aviso', MB_OK + MB_ICONERROR + MB_DEFBUTTON1);
            RollBackTransacao;
            exit;
          end;

        	SqlExec(' update clientes set ativo = 99 ' +
            ' where cod_cliente = %d and cod_empresa = %d ',
            [fint('cod_cliente'), fint('cod_empresa')], buscas);

          if (trim(codCliente) = '') then
            vDadosIni.GravaAuditoria('CLI036', 'EXCLUIR', '', 'CLIENTES',
              dataSet.FieldByName('COD_CLIENTE').AsString, buscas);

          dataset.Next;
        end;

    finally
      vDadosIni.fechaStatusProcessamento;
      prepare_loop_done;
    end;
    Result := CommitaTransacao;

    if Result then
    begin
      vDadosIni.GravaAuditoria('CLI036', 'EXCLUIR', 'SUCESSO',
      	'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end
    else
    begin
      RollBackTransacao;
      vDadosIni.GravaAuditoria('CLI036', 'EXCLUIR', 'FALHA',
      	'CLIENTES',
        vDadosIni.IfThen(trim(codCliente) <> '', codCliente, ''), buscas);
    end;

    if Result then
      montaSelect(ultimasql);
    //Refresh;
  except
    on E: Exception do
		begin
			RollBackTransacao;
      vDadosIni.fechaStatusProcessamento;
      Result := false;
      Application.MessageBox(pchar('Erro: ' + e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

