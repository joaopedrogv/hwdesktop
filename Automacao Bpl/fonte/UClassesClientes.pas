{ TCondPagClientes }

procedure TCondPagClientes.abreCondPag(ATipo: string; ACondicoesCliente: string);
var
  ASelecao: TStringList;
  I: Integer;
begin
  dataSet.DisableControls;
  dataSet.EmptyDataSet;
  dataSet.IndexFieldNames := 'COD_COND_PAG';
  ASelecao := TStringList.Create;
  FMax := 0;
  try
    ACondicoesCliente := StringReplace(ACondicoesCliente, '(', ',', [rfIgnoreCase]);
    ACondicoesCliente := StringReplace(ACondicoesCliente, ')', ',', [rfIgnoreCase]);
    ACondicoesCliente := StringReplace(ACondicoesCliente, ' ', '', [rfIgnoreCase]);
    ASelecao := vDadosIni.Split(ACondicoesCliente, ',');
    FMax := ASelecao.Count + 1;
    buscas.Close;
    buscas.SQL.Text :=
      ' select cod_cond_pag, desc_cond_pag, seqpreco, modalidade, ' +
      ' coalesce(cond_padrao_cl_vnd, ''N'') cond_padrao_cl_vnd, ' +
      ' coalesce(cond_padrao_cl_prest, ''N'') cond_padrao_cl_prest from cond_pag' +
      ' where cond_pag.ativo = 1 ' +
      ' and cond_pag.natureza_cp = ''T'' ' +
      ' union' +
      ' select cod_cond_pag, desc_cond_pag, seqpreco, modalidade, ' +
      ' coalesce(cond_padrao_cl_vnd, ''N'') cond_padrao_cl_vnd, ' +
      ' coalesce(cond_padrao_cl_prest, ''N'') cond_padrao_cl_prest from cond_pag' +
      ' where cond_pag.ativo = 1 ' +
      ' and cond_pag.natureza_cp = ''V'' ' +
      ' union' +
      ' select cod_cond_pag, desc_cond_pag, seqpreco, modalidade, ' +
      ' coalesce(cond_padrao_cl_vnd, ''N'') cond_padrao_cl_vnd, ' +
      ' coalesce(cond_padrao_cl_prest, ''N'') cond_padrao_cl_prest from cond_pag' +
      ' where cond_pag.ativo = 1 ' +
      ' and cond_pag.natureza_cp is null' +
      ' order by 2';
    buscas.Open;
    buscas.First;
    while not buscas.Eof do
    begin
      dataSet.Insert;
      dataSet.FieldByName('SEL').AsString   := 'Z';
      dataSet.FieldByName('TIPO').AsInteger := 3;
      dataSet.FieldByName('COD_COND_PAG').AsInteger      := buscas.FieldByName('COD_COND_PAG').AsInteger;
      dataSet.FieldByName('DESC_COND_PAG').AsString      := buscas.FieldByName('DESC_COND_PAG').AsString;
      dataSet.FieldByName('SEQPRECO').AsString           := buscas.FieldByName('SEQPRECO').AsString;
      dataSet.FieldByName('MODALIDADE').AsString         := buscas.FieldByName('MODALIDADE').AsString;
      dataSet.FieldByName('COND_PADRAO_CL_VND').AsString := buscas.FieldByName('COND_PADRAO_CL_VND').AsString;
      dataSet.FieldByName('COND_PADRAO_CL_PREST').AsString := buscas.FieldByName('COND_PADRAO_CL_PREST').AsString;
      for I := 0 to ASelecao.Count - 1 do
      begin
        if StrToIntDef(ASelecao[I], -1) = buscas.FieldByName('COD_COND_PAG').AsInteger then
        begin
          dataSet.FieldByName('SEL').AsString   := vDadosIni.StrZero(I, 11);
          dataSet.FieldByName('TIPO').AsInteger := 1;
        end;
      end;

      if dataSet.FieldByName('SEL').AsString = 'Z' then
	      if (trim(ATipo) = 'VND') and (dataSet.FieldByName('COND_PADRAO_CL_VND').AsString = 'T') then
        begin
  	     	dataSet.FieldByName('SEL').AsString   := 'T';
          dataSet.FieldByName('TIPO').AsInteger := 2;
        end
      	else if (trim(ATipo) = 'PRE') and (dataSet.FieldByName('COND_PADRAO_CL_PREST').AsString = 'T') then
        begin
  	     	dataSet.FieldByName('SEL').AsString   := 'T';
          dataSet.FieldByName('TIPO').AsInteger := 2;
        end;
      dataSet.Post;

      buscas.Next;
    end;
    buscas.Close;
  finally
    FreeAndNil(ASelecao);
    dataSet.IndexFieldNames := 'TIPO;SEL;DESC_COND_PAG';
    dataSet.First;
    dataSet.EnableControls;
  end;
end;

constructor TCondPagClientes.create(ABuscas: TIBQuery);
begin
  buscas := TIBQuery(ABuscas);
  FDSCondPag := TDataSource.Create(ABuscas.Owner);
  dataSet := TClientDataSet.Create(ABuscas.Owner);
  dataSet.FieldDefs.Add('COD_COND_PAG', ftInteger, 0);
  dataSet.FieldDefs.Add('DESC_COND_PAG', ftString, 30);
  dataSet.FieldDefs.Add('SEQPRECO', ftString, 1);
  dataSet.FieldDefs.Add('MODALIDADE', ftString, 1);
  dataSet.FieldDefs.Add('COND_PADRAO_CL_VND', ftString, 1);
  dataSet.FieldDefs.Add('COND_PADRAO_CL_PREST', ftString, 1);
  dataSet.FieldDefs.Add('TIPO', ftInteger, 0);
  dataSet.FieldDefs.Add('SEL', ftString, 11);
  dataSet.CreateDataSet;

  FDSCondPag.DataSet := dataSet;
  FDSCondPag.AutoEdit := False;

  dataSet.FieldByName('COD_COND_PAG').DisplayLabel := 'Código';
  dataSet.FieldByName('DESC_COND_PAG').DisplayLabel := 'Descrição';
  dataSet.FieldByName('SEQPRECO').DisplayLabel := 'Seq Preço';
  dataSet.FieldByName('MODALIDADE').DisplayLabel := 'Modalidade';
  dataSet.FieldByName('COND_PADRAO_CL_VND').Visible := False;
  dataSet.FieldByName('COND_PADRAO_CL_PREST').Visible := False;
  dataSet.FieldByName('TIPO').Visible := False;
  dataSet.FieldByName('SEL').Visible := False;
end;

destructor TCondPagClientes.Destroy;
begin
  FreeAndNil(FDSCondPag);
  inherited;
end;

function TCondPagClientes.GetCondPagCliente: string;
var
  ACondicoesCliente: String;
begin
  ACondicoesCliente := '';
  dataSet.DisableControls;
  dataSet.IndexFieldNames := 'SEL';
  dataSet.Filter := 'SEL <> ''Z''';
  dataSet.Filtered := True;
  try
    dataSet.First;
    while not dataSet.Eof do
    begin
      if (dataSet.FieldByName('sel').AsString <> 'Z') and (dataSet.FieldByName('sel').AsString <> 'T') then
        ACondicoesCliente :=  IfThen(ACondicoesCliente =  '', '(') +
          ACondicoesCliente + IfThen(ACondicoesCliente <> '', ',') + dataSet.FieldByName('COD_COND_PAG').AsString;
      dataSet.Next;
    end;
    ACondicoesCliente := ACondicoesCliente + IfThen(ACondicoesCliente <> '', ')');
  finally
    Result := ACondicoesCliente;
    dataSet.Filter := '';
    dataSet.Filtered := False;
    dataSet.IndexFieldNames := 'SEL;DESC_COND_PAG';
    dataSet.First;
    dataSet.EnableControls;
  end;
end;

function TCondPagClientes.GetPrimeiraCondPagCliente(
  ACondicoesCliente: string; ACondDefault: Integer): Integer;
var
  AList: TStringList;
  vTemp: string;
  I: Integer;
begin
  if ACondicoesCliente <> '' then
  begin
  	buscas.Close;
	  buscas.SQL.Text := ' select cond_pag.cod_cond_pag from cond_pag ' +
    	' inner join cond_pag_empresa on ' +
      '		cond_pag_empresa.cod_cond_pag = cond_pag.cod_cond_pag ' +
      '   and cond_pag_empresa.cod_empresa = ' + vDadosIni.codEmpresa +
  		' where cond_pag.cod_cond_pag in ' + ACondicoesCliente +
      ' and cond_pag.ativo = 1 ';
    buscas.Open;
    buscas.FetchAll;

    vTemp := '';
    buscas.First;
    while not buscas.Eof do
    begin
    	if trim(vTemp) = '' then
    		vTemp := IntToStr(buscas.FieldByName('cod_cond_pag').AsInteger)
      else
      	vTemp := vTemp + ',' + IntToStr(buscas.FieldByName('cod_cond_pag').AsInteger);

      buscas.Next;
    end;

    if vTemp <> '' then
    begin
      ACondicoesCliente := '(' + vTemp + ')';

      ACondicoesCliente := StringReplace(ACondicoesCliente, '(', ',', [rfIgnoreCase]);
      ACondicoesCliente := StringReplace(ACondicoesCliente, ')', ',', [rfIgnoreCase]);
      ACondicoesCliente := StringReplace(ACondicoesCliente, ' ', '', [rfIgnoreCase]);
      AList := TStringList.Create;
      try
        AList := vDadosIni.Split(ACondicoesCliente, ',');
        if AList.IndexOf(IntToStr(ACondDefault)) > 0 then
        begin
          Result := ACondDefault;
          Exit;
        end;
        for I := 0 to AList.Count - 1 do
          if StrToIntDef(AList[I], -1) > 0 then
          begin
            Result := StrToIntDef(AList[I], -1);
            Break;
          end;
      finally
        FreeAndNil(AList);
      end;
    end;
  end;
end;

procedure TCondPagClientes.marcaDesmarcaCondPag(pTipo: string);
begin
  if dataSet.IsEmpty then
    Exit;

  storeRecNo;
  try
    dataSet.Edit;
    if (trim(pTipo) = 'VND') and (Trim(dataSet.FieldByName('cond_padrao_cl_vnd').AsString) = 'T') then //Registro marcado
    begin
    	if (Trim(dataSet.FieldByName('sel').AsString) <> 'Z')
      	and (Trim(dataSet.FieldByName('sel').AsString) <> 'T') then //Registro marcado
      begin
      	dataSet.FieldByName('tipo').AsInteger := 2;
        dataSet.FieldByName('sel').AsString := 'T';
      end
      else
      begin
      	dataSet.FieldByName('tipo').AsInteger := 1;
  	    dataSet.FieldByName('sel').AsString := vDadosIni.StrZero(FMax, 11);
	      FMax := FMax + 1;
      end;
    end
    else if (trim(pTipo) = 'PRE') and (Trim(dataSet.FieldByName('cond_padrao_cl_prest').AsString) = 'T') then //Registro marcado
    begin
      if (Trim(dataSet.FieldByName('sel').AsString) <> 'Z')
      	and (Trim(dataSet.FieldByName('sel').AsString) <> 'T') then //Registro marcado
      begin
      	dataSet.FieldByName('tipo').AsInteger := 2;
        dataSet.FieldByName('sel').AsString := 'T';
      end
      else
      begin
      	dataSet.FieldByName('tipo').AsInteger := 1;
  	    dataSet.FieldByName('sel').AsString := vDadosIni.StrZero(FMax, 11);
	      FMax := FMax + 1;
      end;
    end
    else if (Trim(dataSet.FieldByName('sel').AsString) <> 'Z') then //Registro marcado
    begin
    	dataSet.FieldByName('tipo').AsInteger := 3;
      dataSet.FieldByName('sel').AsString := 'Z';
    end
    else //Registro desmarcado
    begin
    	dataSet.FieldByName('tipo').AsInteger := 1;
      dataSet.FieldByName('sel').AsString := vDadosIni.StrZero(FMax, 11);
      FMax := FMax + 1;
    end;
    dataSet.Post;
  finally
  	prepare_loop_done();
    restoreRecNo;
    dataSet.IndexFieldNames := 'TIPO;SEL;DESC_COND_PAG';
    dataSet.First;
  end;
end;

