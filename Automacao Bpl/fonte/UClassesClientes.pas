  dataSet.FieldByName('cod_cliente').AsInteger := pCadCliente.dataSet.FieldByName('COD_CLIENTE').AsInteger;
  dataSet.FieldByName('desconto_em').AsString := 'PERCENTUAL';
  dataSet.FieldByName('desconto_valor').AsFloat := 0;
  dataSet.FieldByName('util_per_val').AsString := 'N';
  dataSet.FieldByName('data_ini_vl').Value := Null;
  dataSet.FieldByName('data_fim_vl').Value := Null;
end;

function TCupomDescontoCliente.Post(pCadCliente: TCadClientes): Boolean;
var
  acao: string;
  codigo: integer;
begin
  try
    Result := false;

    codigo := dataSet.FieldByName('ID').AsInteger;

    if not vDadosIni.PesqPros('CLI267', 'SALVAR', 'CLIENTE ' + IntToStr(pCadCliente.dataSet.FieldByName('COD_CLIENTE').AsInteger),
    	'CUPOM_DESCONTO_EC', IntToStr(codigo), buscas, true) then
	      Exit;

    if dataSet.State = dsEdit then
      acao := 'EDITAR'
    else
      acao := 'INSERIR';

    if (trim(dataSet.FieldByName('DESCONTO_EM').AsString) <> 'PERCENTUAL') and (trim(dataSet.FieldByName('DESCONTO_EM').AsString) <> 'VALOR') then
      raiseExceptionCreate('Campo "Desconto em" incorreto', 'DBComboBoxDescontoEmCupomEC');

    if dataSet.FieldByName('DESCONTO_VALOR').AsFloat <= 0 then
      raiseExceptionCreate('Desconto não informado', 'DBEditDescontoValorCupomEC');

  	if (trim(dataSet.FieldByName('DESCONTO_EM').AsString) = 'PERCENTUAL') then
    	if dataSet.FieldByName('DESCONTO_VALOR').AsFloat >= 100 then
	      raiseExceptionCreate('Desconto não deve ser maior ou igual a 100%', 'DBEditDescontoValorCupomEC');

    if (trim(dataSet.FieldByName('UTIL_PER_VAL').AsString) = 'S') then
    	if (dataSet.FieldByName('DATA_INI_VL').IsNull) then
      	raiseExceptionCreate('Data inicial de validade não informada', 'DBEditDataIniValidade');

    if (trim(dataSet.FieldByName('UTIL_PER_VAL').AsString) = 'S') then
    	if (dataSet.FieldByName('DATA_FIM_VL').IsNull) then
      	raiseExceptionCreate('Data final de validade não informada', 'DBEditDataFimValidade');

    if (trim(dataSet.FieldByName('UTIL_PER_VAL').AsString) = 'S') then
    	if (dataSet.FieldByName('DATA_INI_VL').AsDateTime > dataSet.FieldByName('DATA_FIM_VL').AsDateTime) then
      	raiseExceptionCreate('Data inicial de validade não deve ser maior que a data final de validade', 'DBEditDataFimValidade');

    if acao = 'INSERIR' then
    begin
      dataSet.FieldByName('ID').AsInteger :=
        Gencodigo('CUPOM_DESCONTO_EC', DtmClientes.SpIncCodigo, vDadosIni.codEmpresa);

    end;

    Result := inherited post;

