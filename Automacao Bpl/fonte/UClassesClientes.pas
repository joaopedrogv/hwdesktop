function TPossivelCliente.edit: boolean;
begin
  Result := inherited Edit;

  if not Result then
  	Exit;

	if (dataSet.FieldByName('CODIGO_TIPO').AsInteger > 0) and (trim(dataSet.FieldByName('DESC_TP_CLIENTE').AsString) = '') then
  begin
    SqlOpen(' select codigo_tipo, descricao_tipo from tipos_clientes ' +
      ' where codigo_tipo = ' + IntToStr(dataSet.FieldByName('CODIGO_TIPO').AsInteger), buscas);

    if buscas.FieldByName('CODIGO_TIPO').AsInteger > 0 then
      dataSet.FieldByName('DESC_TP_CLIENTE').AsString := trim(buscas.FieldByName('DESCRICAO_TIPO').AsString);
  end;

  if (dataSet.FieldByName('COD_BAIRRO').AsInteger > 0) and (trim(dataSet.FieldByName('BAIRRO').AsString) = '') then
  begin
    SqlOpen(' select cod_bairro, nome_bairro from bairros ' +
      ' where cod_bairro = ' + IntToStr(dataSet.FieldByName('COD_BAIRRO').AsInteger), buscas);

    if buscas.FieldByName('COD_BAIRRO').AsInteger > 0 then
      dataSet.FieldByName('BAIRRO').AsString := trim(buscas.FieldByName('NOME_BAIRRO').AsString);
  end;

  if (dataSet.FieldByName('COD_CIDADE').AsInteger > 0) and (trim(dataSet.FieldByName('CIDADE').AsString) = '') then
  begin
    SqlOpen(' select cod_cidade, nome_cidade from cidades ' +
      ' where cod_cidade = ' + IntToStr(dataSet.FieldByName('COD_CIDADE').AsInteger), buscas);

    if buscas.FieldByName('COD_CIDADE').AsInteger > 0 then
      dataSet.FieldByName('CIDADE').AsString := trim(buscas.FieldByName('NOME_CIDADE').AsString);
  end;

  if (dataSet.FieldByName('CODIGO_UF').AsInteger > 0) and (trim(dataSet.FieldByName('ESTADOS_UF').AsString) = '') then
  begin
    SqlOpen(' select codigo_uf, sigla_uf from estados ' +
      ' where codigo_uf = ' + IntToStr(dataSet.FieldByName('CODIGO_UF').AsInteger), buscas);

    if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
      dataSet.FieldByName('ESTADOS_UF').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
  end;

  Preenchecampos;
  TipoCliente.abreTipoCliente;
  abreBairros;
  abreCidades;
  abreEstados;
end;

