function TCadClientes.MesmoEndCobranca: boolean;
var
  msgPergunta: string;
begin
  result := false;
  if (trim(dataSet.FieldByName('END_COBRANCA').AsString) = '') or
    (trim(dataSet.FieldByName('COD_BAIRRO_COBRANCA').AsString) = '') or
    (trim(dataSet.FieldByName('CEP_COBRANCA').AsString) = '') or
    (trim(dataSet.FieldByName('COD_CIDADE_COBRANCA').AsString) = '') or
    (trim(dataSet.FieldByName('EST_CODIGO_UF').AsString) = '') or
    (dataSet.FieldByName('CEP_COBRANCA').AsString = '00000000') then
  begin
    if dataSet.FieldByName('TIPO').AsString = 'F' then
      msgPergunta := 'Deseja repetir o endereço do Fornecedor para o endereço de Cobrança?'
    else
      msgPergunta := 'Endereço para Cobrança é o mesmo do Endereço Pessoal?';
    if dataSet.State = dsInsert then
    begin
      if Application.MessageBox(pchar(msgPergunta), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = mrYES then
      begin
        if trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString) <> '' then
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('ENDERECO').AsString) + ', ' +
            trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString)
        else
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('ENDERECO').AsString);

        if trim(dataSet.FieldByName('COMPLEMENTO').AsString) <> '' then
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('END_COBRANCA').AsString) + ', ' +
            trim(dataSet.FieldByName('COMPLEMENTO').AsString);

        dataSet.FieldByName('COD_BAIRRO_COBRANCA').AsInteger :=
          dataSet.FieldByName('COD_BAIRRO').AsInteger;
        dataSet.FieldByName('CEP_COBRANCA').AsString :=
        	dataSet.FieldByName('CEP').AsString;
        dataSet.FieldByName('COD_CIDADE_COBRANCA').AsString :=
          dataSet.FieldByName('COD_CIDADE').AsString;
        dataSet.FieldByName('EST_CODIGO_UF').AsInteger :=
          dataSet.FieldByName('CODIGO_UF').AsInteger;

        if (trim(dataSet.FieldByName('ESTADOS_UF').AsString) = '') then
        begin
          SqlOpen(' select codigo_uf, sigla_uf from estados ' +
            ' where codigo_uf = ' +  IntToStr(dataSet.FieldByName('CODIGO_UF').AsInteger), buscas);

          if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
            dataSet.FieldByName('ESTADOS_UF').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
        end;

        dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(dataSet.FieldByName('ESTADOS_UF').AsString);
        result := true;
      end
      else
        result := false;
    end
    else if (dataSet.State = dsEdit) and (dataSet.FieldByName('CEP_COBRANCA').AsString = '00000000') then
    begin
      if Application.MessageBox(pchar(msgPergunta), 'Confirmação', MB_YESNO + MB_ICONQUESTION +
        MB_DEFBUTTON1) = mrYES then
      begin
        if trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString) <> '' then
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('ENDERECO').AsString) + ', ' +
            trim(dataSet.FieldByName('NUM_END_CLIENTE').AsString)
        else
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('ENDERECO').AsString);

        if trim(dataSet.FieldByName('COMPLEMENTO').AsString) <> '' then
          dataSet.FieldByName('END_COBRANCA').AsString :=
            trim(dataSet.FieldByName('END_COBRANCA').AsString) + ', ' +
            trim(dataSet.FieldByName('COMPLEMENTO').AsString);

        dataSet.FieldByName('COD_BAIRRO_COBRANCA').AsInteger :=
          dataSet.FieldByName('COD_BAIRRO').AsInteger;
        dataSet.FieldByName('CEP_COBRANCA').AsString :=
        	dataSet.FieldByName('CEP').AsString;
        dataSet.FieldByName('COD_CIDADE_COBRANCA').AsString :=
          dataSet.FieldByName('COD_CIDADE').AsString;
        dataSet.FieldByName('EST_CODIGO_UF').AsInteger :=
          dataSet.FieldByName('CODIGO_UF').AsInteger;

        if (trim(dataSet.FieldByName('ESTADOS_UF').AsString) = '') then
        begin
          SqlOpen(' select codigo_uf, sigla_uf from estados ' +
            ' where codigo_uf = ' +  IntToStr(dataSet.FieldByName('CODIGO_UF').AsInteger), buscas);

          if buscas.FieldByName('CODIGO_UF').AsInteger > 0 then
            dataSet.FieldByName('ESTADOS_UF').AsString := trim(buscas.FieldByName('SIGLA_UF').AsString);
        end;

        dataSet.FieldByName('ESTADOS_UF_COBRANCA').AsString := trim(dataSet.FieldByName('ESTADOS_UF').AsString);
        result := true;
      end
      else
        result := false;
    end;
  end;
end;

