{ TSaldosEmp }

function TSaldosEmp.abreSaldosEmp(pCodCliente: Integer; pCPFCGC: string): boolean;
var
  vtemp, vtemp2: string;
begin
	vtemp := ' cl.cpfcgc = ' + QuotedStr(trim(pCPFCGC));
	vtemp2 := '';
  if trim(pCPFCGC) = '' then
  begin
  	vtemp := ' cl.cod_cliente = ' + IntToStr(pCodCliente);
  	vtemp2 := ' and emp.cod_empresa = ' + vDadosIni.codEmpresa;
  end;
  
  Result := montaSelect(' select (emp.cod_empresa || '' - '' || trim(coalesce(emp.identificacao_emp, ''''))) identificacao_emp, ' +
  	' coalesce(( ' +
    '    select sum(case when (trim(cc.tipo) = ''CRÉDITO'') then cc.pontos else (-1) * cc.pontos end) pontos ' +
    ' 	 from conta_corrente_prog_fidelidade cc ' +
    ' 	 inner join clientes cl on cl.cod_cliente = cc.cod_cliente and cl.cod_empresa = cc.cod_empresa ' +
    ' 	 where ' + vtemp + 
    '		 and cc.data_venc_prog >= ' + vDadosIni.FusoDateFb +
    ' 	 and coalesce(cc.cod_emp_resp, cc.cod_empresa) = emp.cod_empresa), 0) saldo ' +
    ' from empresa emp ' +
//    ' left join empresa_prog_fid empg on empg.cod_empresa = emp.cod_empresa ' +
//    ' where emp.cod_empresa in (case when(empg.cod_empresa > 0) then empg.cod_empresa else  cast(' + vDadosIni.codEmpresa + ' as Integer) end) ' +
    ' where coalesce((select cs.value1_f from config_sistema cs ' +
    '					where cs.chave = ''prog_fid_hab'' and cs.cod_empresa = emp.cod_empresa ' +
    '					and cs.value1_f = 1), 0) = 1 ' +
    ' and emp.ativo = 1 ' + vtemp2 +
    ' order by emp.cod_empresa ');
end;

