//               buscas.ParamByName('COD_EMP_TIPODOC').AsInteger := vDadosIni.cod_empresa;

               if (vDadosIni.vProgFid.vHabilitarProgFid) then
               	 //
               else if (vDadosIni.vCashback.vHabilitarCashback) and (vReq > 0) then
               begin
                 buscas.ParamByName('NUM_DOC').AsInteger := vReq;
                 buscas.ParamByName('TIPO_DOC').AsString := vtiporeq;
                 buscas.ParamByName('COD_EMP_DOC').AsInteger := vDadosIni.cod_empresa;
               end;
