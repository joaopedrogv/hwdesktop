function TColaboadorRedCarteiras._abreColaborador: Boolean;
var
  vSqlTmp: string;
begin
  vSqlTmp := '';
  if vDest then
    vSqlTmp := ' union select 0, ''SEM VINCULO'', '' '' FROM RDB$DATABASE';

  fQuery.SQL.Text := 'select co.cod_vendedor, co.nome_vendedor, F.desc_funcao from colaborador co' +
    ' inner join funcoes f on f.cod_funcao = co.cod_funcao' +
    ' where co.ativo = 1 and f.desc_funcao like ''%VEND%'' and co.cod_empresa = ' + vDadosIni.codEmpresa + vSqlTmp;
  Result := montaSelect(fQuery.SQL.Text);
end;

