function TContaCorrenteClientes.testarCliente(pCodCliente,
  pCodEmpresa: Integer): boolean;
var
  vFantasia, vRazao, vCPF: string;
begin
  try
    Result := true;

    SqlOpen(' select cod_cliente, nome_cliente, razao, cpfcgc from clientes ' +
    	' where cod_cliente = ' + IntToStr(pCodCliente) +
      ' and cod_empresa = ' + vDadosIni.codEmpresa);
    vFantasia := trim(buscas.FieldByName('NOME_CLIENTE').AsString);
    vRazao := trim(buscas.FieldByName('RAZAO').AsString);
    vCPF := trim(buscas.FieldByName('CPFCGC').AsString);

    SqlOpen(' select cod_cliente, nome_cliente, razao, cpfcgc from clientes ' +
    	' where cpfcgc = ''' + vCPF + ''' ' +
      ' and cod_empresa = ' + IntToStr(pCodEmpresa));
    vCodClienteDest := buscas.FieldByName('COD_CLIENTE').AsInteger;

    if buscas.IsEmpty then
    begin
      Result := false;
      Application.MessageBox(pchar('Cliente não encontrado na empresa de destino da transferência: ' + #13 + #13 +
        'Nome fantasia: ' + vFantasia + #13 +
        'Razão Social: ' + vRazao + #13 +
        'CPF/CNPJ: ' + vCPF), 'Atenção', MB_ICONERROR + MB_OK);
      exit;
    end;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

function TContaCorrenteClientes.testarEmpresa(pCodEmpresa: Integer): boolean;
var
  vIdentificacao: string;
begin
  try
    Result := true;

    SqlOpen(' select emp.cod_empresa, emp.identificacao_emp, ' +
    	' coalesce((select cs.value1_f from config_sistema cs ' +
      '						where cs.chave = ''prog_fid_hab'' and cs.cod_empresa = emp.cod_empresa), 0) prog_fid ' +
      ' from empresa emp ' +
      ' where emp.cod_empresa = ' + IntToStr(pCodEmpresa));
    vIdentificacao := IntToStr(buscas.FieldByName('cod_empresa').AsInteger) + ' - ' +
    	trim(buscas.FieldByName('identificacao_emp').AsString);

    if buscas.FieldByName('prog_fid').AsFloat <> 1 then
    begin
      Result := false;
      Application.MessageBox(pchar('Programa de Fidelidade não está configurado na empresa: ' + #13 + #13 +
        'Empresa: ' + vIdentificacao), 'Atenção', MB_ICONERROR + MB_OK);
      exit;
    end;

    SqlOpen(' select empg.cod_empresa from empresa_prog_fid empg ' +
    	' where empg.cod_empresa = ' + IntToStr(pCodEmpresa));

    if not buscas.IsEmpty then
    begin
      Result := false;
      Application.MessageBox(pchar('Saldo da conta corrente do cliente está unificado, ' +
      	' não é necessário transferir'), 'Atenção', MB_ICONERROR + MB_OK);
      exit;
    end;  

  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONERROR + MB_OK);
      registraErro(e.Message);
    end;
  end;
end;

