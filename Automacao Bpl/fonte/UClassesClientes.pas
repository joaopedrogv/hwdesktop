          fTempContratos.FieldByName('CPFCGC').AsString := UpperCase(trim(buscas.FieldByName('CPFCGC').AsString));
          fTempContratos.FieldByName('NOME_CLIENTE').AsString := UpperCase(trim(buscas.FieldByName('NOME_CLIENTE').AsString));
          fTempContratos.FieldByName('RAZAO').AsString := UpperCase(trim(buscas.FieldByName('RAZAO').AsString));

