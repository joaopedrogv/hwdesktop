procedure TCadClientes.PreencheCampos;
var
  vTemp: string;
begin
  if dataSet.State = dsEdit then
  begin
    dataSet.FieldByName('ATIVO').AsInteger := 1;
    if dataSet.FieldByName('COD_PAIS').AsInteger = 0 then
      dataSet.FieldByName('COD_PAIS').AsInteger := 1058;
  end
  else
  begin
    if fCadastroSimplificado then
    begin
      dataSet.FieldByName('tipo').AsString := 'A';
      dataSet.FieldByName('codigo_tipo').AsInteger := LTipoCli.buscas.FieldByName('codigo_tipo').AsInteger;

      if (dataSet.FieldByName('CODIGO_TIPO').AsInteger > 0) then
      begin
	      SqlOpen(' select codigo_tipo, descricao_tipo from tipos_clientes ' +
  	    	' where codigo_tipo = ' + IntToStr(dataSet.FieldByName('CODIGO_TIPO').AsInteger), buscas);

        if buscas.FieldByName('CODIGO_TIPO').AsInteger > 0 then
	        dataSet.FieldByName('DESC_TP_CLIENTE').AsString := trim(buscas.FieldByName('DESCRICAO_TIPO').AsString);	
      end;
    end;
    if vDadosIni.vCliente.vConfCPF then
      if dataSet.FieldByName('CPFCGC').EditMask = HelperCNPJ.EditMask then//'99.999.999/9999-99;0;' then
        dataSet.FieldByName('CATEGORIA').AsString := 'CNF'
      else
        dataSet.FieldByName('CATEGORIA').AsString := 'CCF';
    //    buscas.close;
    //    buscas.SQL.Text := 'select valor from codigo where tabela=''CLIENTES'' and ativo = 1 and cod_empresa=' + vDadosIni.codEmpresa;
    //    buscas.open;
    dataSet.FieldByName('COD_CLIENTE').AsInteger := 0;
    //        buscas.FieldByName('VALOR').AsInteger + 1
    dataSet.FieldByName('TIPVCLIENTE').AsString := IfThen(trim(vDadosIni.vCliente.vTipoVendaPadrao) <> '',
    	  Copy(trim(vDadosIni.vCliente.vTipoVendaPadrao), 1, 1), 'V');
    dataSet.FieldByName('US_CAD_CLI').AsInteger := vDadosIni.vCodUsuario;
    dataSet.FieldByName('COD_EMPRESA').AsInteger := strtoint(vDadosIni.codEmpresa);
    dataSet.FieldByName('DATA_CADASTRO').AsDateTime := date;
    dataSet.FieldByName('ATIVO').AsInteger := 1;
    dataSet.FieldByName('COD_PAIS').AsInteger := 1058;
    
    buscas.Close;
    buscas.SQL.Text := 'select padrao_consumidor_final from empresa' +
      ' where cod_empresa = ' + vDadosIni.codEmpresa;
    buscas.Open;
    if Trim(buscas.FieldByName('padrao_consumidor_final').AsString) <> '' then
      dataSet.FieldByName('consumidor_final').AsString := Trim(buscas.FieldByName('padrao_consumidor_final').AsString);

    if vDadosIni.vEmp.vUsarControlesCliente = 'S' then
    begin
      buscas.Close;
      buscas.SQL.Text := 'select codigo_ctrl, nome_ctrl, usar_boleto from controles ' +
        ' where cxent = ''S'' ' +
        ' and ativo = 1 ' +
        ' and codigo_emp = ' + vDadosIni.codEmpresa +
        ' and fp_padrao_cl = ''S'' ' +
        ' order by qseqperf ';
      buscas.Open;

      vTemp := '';
      buscas.First;
      while not buscas.Eof do
      begin
        vTemp := vTemp + IntToStr(buscas.FieldByName('codigo_ctrl').AsInteger) + ',';
        buscas.Next;
      end;

      if vTemp <> '' then
      begin
        vTemp := Copy(vTemp, 1, Length(vTemp) - 1);
        vTemp := '(' + vTemp + ')';
      end;
      dataSet.FieldByName('controles_fp').AsString := vTemp;
    end;

    if vDadosIni.vCliente.vCondPagPorCliente then
    begin
    	buscas.Close;
      buscas.SQL.Text := 'select cod_cond_pag, desc_cond_pag from cond_pag ' +
      	' where ativo = 1 ' +
        ' and cond_padrao_cl_vnd = ''S'' ' +
        ' order by cod_cond_pag ';
      buscas.Open;
      
      vTemp := '';
      buscas.First;
      while not buscas.Eof do
      begin
        vTemp := vTemp + IntToStr(buscas.FieldByName('cod_cond_pag').AsInteger) + ',';
        buscas.Next;
      end;

      if vTemp <> '' then
      begin
        vTemp := Copy(vTemp, 1, Length(vTemp) - 1);
        vTemp := '(' + vTemp + ')';
      end;
      dataSet.FieldByName('cond_pag_vnd').AsString := vTemp;

      buscas.Close;
      buscas.SQL.Text := 'select cod_cond_pag, desc_cond_pag from cond_pag ' +
      	' where ativo = 1 ' +
        ' and cond_padrao_cl_prest = ''S'' ' +
        ' order by cod_cond_pag ';
      buscas.Open;
      
      vTemp := '';
      buscas.First;
      while not buscas.Eof do
      begin
        vTemp := vTemp + IntToStr(buscas.FieldByName('cod_cond_pag').AsInteger) + ',';
        buscas.Next;
      end;

      if vTemp <> '' then
      begin
        vTemp := Copy(vTemp, 1, Length(vTemp) - 1);
        vTemp := '(' + vTemp + ')';
      end;
      dataSet.FieldByName('cond_pag_pre').AsString := vTemp;
    end;
  end;
end;

