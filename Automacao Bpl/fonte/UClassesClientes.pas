          ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
          ' where cb.cod_barra = ' + QuotedStr(codBarra) +
          ' and cb.cod_empresa = ' + vDadosIni.codEmpresa +
          ' and p.ativo = 1';
        buscas.Open;
      end;
      buscas.FetchAll;

      if (buscas.IsEmpty) and (trim(vCOD_PROD) = '') then
      begin
        buscas.Close;
        buscas.SQL.Text := 'select distinct p.*, ' +
          ' coalesce(est.estoque, 0) estoque_disponivel, ' +
			 	  ' coalesce(est.est_prima, 0) estoque_produzir from produtos p ' +
        	' inner join cod_barra cb on p.grupo_prod=cb.grupo_prod and p.cod_prod=cb.cod_prod and p.cod_empresa=cb.cod_empresa ' +
          ' left join getestoquedisponivel(p.grupo_prod, p.cod_prod, 0, p.cod_empresa, 0, '''', 0, 0) est on 1 = 1 ' +
          ' where p.cod_empresa=' + vDadosIni.codEmpresa +
          ' and p.descr_prod like ' + QuotedStr(codBarra + '%') + ' and p.ativo = 1' +
          ' order by p.descr_prod ';
        buscas.Open;
        buscas.FetchAll;
      end;

      if not buscas.IsEmpty then
        if buscas.RecordCount > 1 then
        begin
        	TFloatField(buscas.FieldByName('PREC_TAB_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_PUBLICO')).currency := True;
          TFloatField(buscas.FieldByName('PRECO_PROMOCAO')).currency := True;
        	TFloatField(buscas.FieldByName('PREC_30_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_60_PROD')).currency := True;
          TFloatField(buscas.FieldByName('PREC_90_PROD')).currency := True;
        	TFloatField(buscas.FieldByName('ESTOQUE_DISPONIVEL')).DisplayFormat := '#,##0.000';
          TFloatField(buscas.FieldByName('ESTOQUE_PRODUZIR')).DisplayFormat   := '#,##0.000';
          if not vDadosIni._abreFormEscolhaProdutosIni(buscas) then
          begin
            Result := false;
            raise exception.create('Produto não encontrado');
            exit;
          end;
        end;

      if buscas.IsEmpty then
      begin
        Result := false;
        raise exception.create('Produto não encontrado');
        exit;
      end
      else
      begin
        vCOD_PROD := trim(buscas.FieldByName('cod_prod').AsString);
        vGRUPO_PROD := buscas.FieldByName('grupo_prod').AsInteger;
      end;
      buscas.close;
    end
    else
    begin
    	if (vGRUPO_PROD > 0) or (trim(vCOD_PROD) <> '') then
      begin
      	Result := true;
        exit;
      end;
      Result := false;
      raise exception.create('Produto não encontrado');
    end;

    if not Result then
      exit;

    if (not GradeNoCodigo) and ExecutaComandosSql(
    	' select first 1 cgp.cod_grade from cod_grade_prod cgp' +
      ' inner join grade g on g.cod_grade = cgp.cod_grade and g.cod_empresa = cgp.cod_empresa ' +
      ' where cgp.grupo_prod = ' + IntToStr(vGRUPO_PROD) +
      ' and cgp.cod_prod = ' + QuotedStr(trim(vCOD_PROD)) +
      ' and cgp.cod_empresa = ' + vDadosIni.codEmpresa) then
       _abreFormSelecionaGradeProd(vGRUPO_PROD, vCOD_PROD);

      if nGradeSelecionada <> 0 then
        vCOD_GRADE := nGradeSelecionada;
//      else
//        vCOD_GRADE := vCOD_GRADE;

    buscas.Close;
    if vCOD_GRADE > 0 then
    	buscas.SQL.Text := ' select PRODUTOS.GRUPO_PROD, PRODUTOS.COD_PROD, ' +
      	' PRODUTOS.DESCR_PROD, PRODUTOS.NUM_FAB_PROD, PRODUTOS.VL_ULT_COMPRA, ' +
        ' PRODUTOS.PREC_CUS_PROD, PRODUTOS.PREC_TAB_PROD, ' +
        '	PRODUTOS.PREC_PUBLICO, PRODUTOS.CUSTO_HONDA, GRADE.DESCRICAO AS DESCR_GRADE from PRODUTOS ' +
        ' inner join COD_GRADE_PROD on ' +
        '     COD_GRADE_PROD.GRUPO_PROD = PRODUTOS.GRUPO_PROD ' +
        '     and COD_GRADE_PROD.COD_PROD = PRODUTOS.COD_PROD ' +
        '     and COD_GRADE_PROD.COD_GRADE = ' + IntToStr(vCOD_GRADE) +
        '     and COD_GRADE_PROD.COD_EMPRESA = PRODUTOS.COD_EMPRESA ' +
        ' inner join GRADE on ' +
        '     GRADE.COD_GRADE = COD_GRADE_PROD.COD_GRADE ' +
        '     and GRADE.COD_EMPRESA = COD_GRADE_PROD.COD_EMPRESA ' +
        '	where PRODUTOS.GRUPO_PROD = ' + IntToStr(vGRUPO_PROD) +
        ' and PRODUTOS.COD_PROD = ' + QuotedStr(vCOD_PROD) +
        ' and PRODUTOS.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' and PRODUTOS.ATIVO = 1 '
    else
      buscas.SQL.Text := ' select PRODUTOS.GRUPO_PROD, PRODUTOS.COD_PROD, ' +
      	' PRODUTOS.DESCR_PROD, PRODUTOS.NUM_FAB_PROD, PRODUTOS.VL_ULT_COMPRA, ' +
        ' PRODUTOS.PREC_CUS_PROD, PRODUTOS.PREC_TAB_PROD, ' +
        ' PRODUTOS.PREC_PUBLICO, PRODUTOS.CUSTO_HONDA from PRODUTOS ' +
        '	where PRODUTOS.GRUPO_PROD = ' + IntToStr(vGRUPO_PROD) +
        ' and PRODUTOS.COD_PROD = ' + QuotedStr(vCOD_PROD) +
        ' and PRODUTOS.COD_EMPRESA = ' + vDadosIni.codEmpresa +
        ' and PRODUTOS.ATIVO = 1 ';
    buscas.Open;

    vVALOR_UN     := buscas.FieldByName('PREC_TAB_PROD').AsFloat;
    if vCOD_GRADE > 0 then
    	vDESCR_PROD   := trim(buscas.FieldByName('DESCR_PROD').AsString) + ' ' + trim(buscas.FieldByName('DESCR_GRADE').AsString)
    else
    	vDESCR_PROD   := trim(buscas.FieldByName('DESCR_PROD').AsString);
    vNUM_FAB_PROD := trim(buscas.FieldByName('NUM_FAB_PROD').AsString);
    vGRUPO_PROD   := buscas.FieldByName('GRUPO_PROD').AsInteger;
    vCOD_PROD     := trim(buscas.FieldByName('COD_PROD').AsString);

    Result := true;
  except
    on e: exception do
    begin
      Result := false;
      Application.MessageBox(pchar(e.Message), 'Atenção', MB_ICONEXCLAMATION + MB_OK);
    end;
  end;
end;

function TContratosComClientesProd.buscarProd(
	pGrupoProd: Integer;
  pCodProd: string;
	pCodGrade: Integer): Boolean;
begin
	buscas.Close;
  if pCodGrade > 0 then
  	buscas.SQL.Text := ' select produtos.grupo_prod, produtos.cod_prod, produtos.cod_empresa from produtos ' +
    	' inner join cod_grade_prod on ' +
      '     cod_grade_prod.grupo_prod = produtos.grupo_prod ' +
      '     and cod_grade_prod.cod_prod = produtos.cod_prod ' +
      '     and cod_grade_prod.cod_grade = ' + IntToStr(pCodGrade) +
      '     and cod_grade_prod.cod_empresa = produtos.cod_empresa ' +
      ' where produtos.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and produtos.cod_prod = ' + QuotedStr(pCodProd) +
      ' and produtos.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and produtos.ativo = 1 '
  else
    buscas.SQL.Text := ' select produtos.grupo_prod, produtos.cod_prod, produtos.cod_empresa from produtos ' +
      ' where produtos.grupo_prod = ' + IntToStr(pGrupoProd) +
      ' and produtos.cod_prod = ' + QuotedStr(pCodProd) +
      ' and produtos.cod_empresa = ' + vDadosIni.codEmpresa +
      ' and produtos.ativo = 1 ';
  buscas.Open;

  Result := not buscas.IsEmpty;
end;

