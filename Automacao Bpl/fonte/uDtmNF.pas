procedure TdtmNF.cdsManDestCSITNFEGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
begin
  if Sender.AsString = '2' then
    Text := 'Denegada'
  else if Sender.AsString = '3' then
    Text := 'Cancelada'
  else
    Text := 'Autorizada';
end;

procedure TdtmNF.cdsManDestTPNFGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
begin
