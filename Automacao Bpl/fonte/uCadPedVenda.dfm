                    Font.Style = [fsBold]
                    Lines.Strings = (
                      
                        'ATEN'#199#195'O:   TORNA-SE OBRIGAT'#211'RIO O PREENCHIMENTO COMPLETO DESTA O' +
                        'RDEM DE SERVI'#199'O.'
                      ''
                      
                        '1- Caso o defeito n'#227'o seja do produto, o cliente pagar'#225' a taxa d' +
                        'e visita ao t'#233'cnico.'
                      
                        '2- O retorno da Assist'#234'ncia em garantia deve ser feito ap'#243's a co' +
                        'nclus'#227'o do servi'#231'o, enviando por fax ou e-mail a c'#243'pia da nota'
                      'fiscal, juntamente com o parecer do t'#233'cnico.'
                      '3- N'#227'o h'#225' garantia sem Nota Fiscal do Cliente.'
                      
                        '4- Para o pedido de pe'#231'a ser solicitado '#233' obrigat'#243'rio o retorno ' +
                        'da OS com c'#243'digo, descri'#231#227'o da pe'#231'a e o modelo com gera'#231#227'o do'
                      'aparelho.')
                    ParentFont = False
                    Transparent = False
                    WordWrap = True
                    FontSize = 8
                  end
