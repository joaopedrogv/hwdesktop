implementation

uses uDtmAtivo;

{$R *.dfm}   

procedure LiberarDTM;
begin
  if Assigned(dtmConfig) then
    FreeAndNil(dtmConfig);
end;

exports
  LiberarDTM;

procedure TdtmConfig.cdsMenusBeforeOpen(DataSet: TDataSet);
begin
  dtmAtivo.mudaSelect(TClientDataSet(DataSet),Self);
end;

procedure TdtmConfig.cdswsScriptERROGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
begin
   if not cdswsScriptERRO.IsNull then
    Text := Copy(cdswsScriptERRO.AsString, 1, 200) + '...';
end;

procedure TdtmConfig.cdswsScriptSQLGetText(Sender: TField; var Text: string;
  DisplayText: Boolean);
begin
 if not cdswsScriptSQL.IsNull then
    Text := Copy(cdswsScriptSQL.AsString, 1, 200) + '...';
end;

procedure TdtmConfig.DataModuleCreate(Sender: TObject);
var
  J, I: Integer;
begin
  for J := 0 to Self.ComponentCount - 1 do
    if Self.Components[J] is TClientDataSet then
      for I := 0 to TClientDataSet(Self.Components[J]).FieldCount - 1 do
      begin
        TClientDataSet(Self.Components[J]).IndexDefs.Add('IDXA' +
          TClientDataSet(Self.Components[J]).Fields[I].FieldName,
          TClientDataSet(Self.Components[J]).Fields[I].FieldName, []);
        TClientDataSet(Self.Components[J]).IndexDefs.Add('IDXD' +
          TClientDataSet(Self.Components[J]).Fields[I].FieldName,
          TClientDataSet(Self.Components[J]).Fields[I].FieldName, [ixDescending]);
      end;
end;

end.
