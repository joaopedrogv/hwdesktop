procedure TdtmProdutos.CdsProdutosBeforeOpen(DataSet: TDataSet);
begin
  dtmAtivo.mudaSelect(TClientDataSet(DataSet), self);
end;

procedure TdtmProdutos.CdsProdutosLISTA_IMAGENSGetText(Sender: TField;
  var Text: string; DisplayText: Boolean);
begin
	if not CdsProdutosLISTA_IMAGENS.IsNull then
    Text := Copy(CdsProdutosLISTA_IMAGENS.AsString, 1, 7) + '...';
end;

procedure TdtmProdutos.CdsProdutosOBS_ETIQGetText(Sender: TField;
  var Text: string; DisplayText: Boolean);
begin
	if not CdsProdutosOBS_ETIQ.IsNull then
    Text := vDadosIni.IfThen(Length(trim(CdsProdutosOBS_ETIQ.AsString)) > 50,
    	Copy(trim(CdsProdutosOBS_ETIQ.AsString), 1, 50) + '...',
      trim(CdsProdutosOBS_ETIQ.AsString));
end;

procedure TdtmProdutos.CdsProdutosUSAR_DEBCREDGetText(Sender: TField;
  var Text: string; DisplayText: Boolean);
begin
	 if not CdsProdutosGRUPO_PROD.IsNull then
   begin
     if CdsProdutosUSAR_DEBCRED.IsNull then
       Text := 'S'
     else if trim(CdsProdutosUSAR_DEBCRED.AsString) = 'N' then
       Text := 'N'
     else
       Text := 'S';
   end;
end;

