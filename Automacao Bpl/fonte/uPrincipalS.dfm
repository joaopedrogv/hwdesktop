      '         VALUES (4, '#39'PAF-ECF'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (5, '#39'VEICULOS'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (6, '#39'POSVENDA'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (7, '#39'FOLLOWUP'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (8, '#39'HWADM'#39');'
      ''
      'COMMIT WORK;'
      ''
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 1);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 2);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 3);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 4);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 5);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 6);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 7);'
      'INSERT INTO SENHAS_ERP (USUARIO, COD_EMPRESA, COD_APLICATIVO)'
      '                VALUES ('#39'HW'#39', 1, 8);'
      ''
      'COMMIT WORK;'
      ''
      'DELETE FROM MENUS_AUTO WHERE COD_MENU >= 500;'
      ''
      'COMMIT WORK;')
