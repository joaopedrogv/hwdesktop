        'nda'#39', 0, 1);'
      
        'INSERT INTO MENUS_AUTO_SISTEMA (COD_APLICATIVO, NOME_MENU, STATU' +
        'S_MENU, ENABLE_MENU, DESC_MENU, '
      'NIVEL_MENU, ATIVO)'
      
        '                        VALUES (6, '#39'MenuCadastros'#39', '#39'V'#39', '#39'H'#39', '#39'C' +
        'adastros'#39', 0, 1);'
      
        'INSERT INTO MENUS_AUTO_SISTEMA (COD_APLICATIVO, NOME_MENU, STATU' +
        'S_MENU, ENABLE_MENU, DESC_MENU, '
      'NIVEL_MENU, ATIVO)'
      
        '                        VALUES (6, '#39'CadastrosDeClientes'#39', '#39'V'#39', '#39 +
        'H'#39', '#39'Cadastro de Clientes'#39', 0, 1);'
      
        'INSERT INTO MENUS_AUTO_SISTEMA (COD_APLICATIVO, NOME_MENU, STATU' +
        'S_MENU, ENABLE_MENU, DESC_MENU, '
      'NIVEL_MENU, ATIVO)'
      
        '                        VALUES (6, '#39'Clientes'#39', '#39'V'#39', '#39'H'#39', '#39'Client' +
        'es'#39', 0, 1);'
      
        'INSERT INTO MENUS_AUTO_SISTEMA (COD_APLICATIVO, NOME_MENU, STATU' +
        'S_MENU, ENABLE_MENU, DESC_MENU, '
      'NIVEL_MENU, ATIVO)'
      
        '                        VALUES (6, '#39'ConsultadeClientesShiftF4'#39', ' +
        #39'V'#39', '#39'H'#39', '#39'Consulta de Clientes'#39', 0, 1);'
      ''
      'COMMIT WORK;'
      ''
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (1, '#39'AUTOMACAO'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (2, '#39'CAIXA GERAL'#39');'
      'INSERT INTO ERP (COD_APLICATIVO, NOME_APLICATIVO)'
      '         VALUES (3, '#39'CAIXA AUXILIAR'#39');'
