                  Height = 97
                  Color = clBtnFace
                  Ctl3D = False
                  Lines.Strings = (
                    
                      'Os itens podem ser importados para o sistema a partir de um XML ' +
                      'ou pela '
                    
                      'chave de acesso da NF-e. Quando utilizado este recurso o sistema' +
                      ' n'#227'o ir'#225' '
                    
                      'fazer o c'#225'lculo da Substitui'#231#227'o Tribut'#225'ria, por'#233'm, o sistema ir'#225 +
                      ' armazenar '
                    
                      'os valores de Base de ICMS ST e Valor de ICMS ST contidos no XML' +
                      '.'
                    
                      'Se deseja que o sistema efetue o c'#225'lculo da ST, ative a op'#231#227'o ab' +
                      'aixo e'
                    
                      'certifique-se que as informa'#231#245'es para o c'#225'lculo de ST estejam co' +
                      'rretas.')
                  ParentCtl3D = False
                  ReadOnly = True
                  TabOrder = 0
                end
