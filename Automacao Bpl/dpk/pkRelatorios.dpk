package pkRelatorios;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  pkAtivos,
  vcl,
  pkEditHw,
  vclx,
  ibxpress,
  dbrtl,
  dsnap,
  vcldb,
  dcl7cr10;

contains
  uRelatorios in '..\fonte\uRelatorios.pas' {frmRelatorios},
  UClassesRelatorios in '..\fonte\UClassesRelatorios.pas',
  uDtmRelatorios in '..\fonte\uDtmRelatorios.pas' {dtmRelatorios: TDataModule},
  USelEmpresas in '..\fonte\USelEmpresas.pas';

end.
