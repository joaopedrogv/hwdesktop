package pkBoletos;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}
{%File 'pkBoletos_INFO.txt'}

requires
  rtl,
  pkAtivos,
  vcl,
  vcldb,
  dbrtl,
  bdertl,
  DelPrint2006,
  VclSmp,
  vclx,
  designide,
  xmlrtl,
  vclactnband,
  pkCadastrosBasicos;

contains
  UCadBoleto in '..\fonte\UCadBoleto.pas' {frmCadBoletos},
  UDtmBoleto in '..\fonte\UDtmBoleto.pas' {DtmBoletos},
  UClassesBoleto in '..\fonte\UClassesBoleto.pas',
  UCadCobrebem in '..\fonte\UCadCobrebem.pas' {frmCadCobreBem},
  USelecionaCobrebem in '..\fonte\USelecionaCobrebem.pas' {frmSelecionaCobrebem},
  uBoletosProtesto in '..\fonte\uBoletosProtesto.pas' {frmBoletosProtesto},
  uArquivosBoleto in '..\fonte\uArquivosBoleto.pas' {frmArquivosBoleto},
  UConfEmail in '..\fonte\UConfEmail.pas' {frmConfEmail};

end.
