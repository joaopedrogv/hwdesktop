package pkMobile;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  pkAtivos,
  vcl,
  vcldb,
  dbrtl;

contains
  UDtmMobile in '..\fonte\UDtmMobile.pas' {dtmMobile: TDataModule},
  UClassesMobile in '..\fonte\UClassesMobile.pas',
  uCadMobile in '..\fonte\uCadMobile.pas' {frmCadMobile},
  uCadMensMobile in '..\fonte\uCadMensMobile.pas' {frmCadMensMob};

end.
