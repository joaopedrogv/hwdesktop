package pkColaborador;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  PkFormularios,
  pkAtivos,
  vcl,
  vcldb,
  dbrtl,
  dsnap,
  ibxpress,
  bdertl,
  QR5RunD2006,
  pkCadastrosBasicos,
  pkBoletos,
  vcljpg,
  vclx;

contains
  uCadFuncoes in '..\fonte\uCadFuncoes.pas' {frmCadFuncoes},
  uDtmColaborador in '..\fonte\uDtmColaborador.pas' {dtmColaborador: TDataModule},
  UclassesColaborador in '..\fonte\UclassesColaborador.pas',
  ucadColaborador in '..\fonte\ucadColaborador.pas' {frmCadcolaborador},
  UCadDebitoCredito in '..\fonte\UCadDebitoCredito.pas' {frmCadDebitoCredito},
  ucadParticipante in '..\fonte\ucadParticipante.pas' {frmCadParticipante},
  uCadCalendColaboradorExc in '..\fonte\uCadCalendColaboradorExc.pas' {frmCadCalendColaboradoExc},
  uCadCalendEscalaSemanal in '..\fonte\uCadCalendEscalaSemanal.pas' {frmCadCalendEscalaSemanal},
  uCadJornadaTrabalho in '..\fonte\uCadJornadaTrabalho.pas' {frmCadJornadaTrabalho};

end.
