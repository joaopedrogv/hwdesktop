package pkSugestaoCompras;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  PkFormularios,
  pkAtivos,
  vcldb,
  dbrtl;

contains
  UDtmSugestaoCompras in '..\fonte\UDtmSugestaoCompras.pas' {dtmSugestaoCompras: TDataModule},
  uCadPedidoCompra in '..\fonte\uCadPedidoCompra.pas' {frmCadPedidoCompra},
  UClasseSugestaoCompras in '..\fonte\UClasseSugestaoCompras.pas',
  UDefinirCasseServ in '..\fonte\UDefinirCasseServ.pas' {FrmDefinirClasseServ},
  USugestaoCompras in '..\fonte\USugestaoCompras.pas' {FrmSugestaoCompra};

end.
