package pkRecibo;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  vcldb,
  dbrtl,
  PkFormularios,
  pkAtivos,
  QR5RunD2006,
  vcljpg,
  bdertl,
  vclx,
  pkEditMoeda,
  pkFormPag;

contains
  UCadRecibo in '..\fonte\UCadRecibo.pas' {frmCadRecibo},
  UclassesRecibo in '..\fonte\UclassesRecibo.pas',
  UdtmRecibo in '..\fonte\UdtmRecibo.pas' {dtmRecibo: TDataModule},
  UReciboSimples in '..\fonte\UReciboSimples.pas' {frmReciboSimples};

end.
