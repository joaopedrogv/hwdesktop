package PkTerminaisF;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\default.txaPackage'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UdtmTerminalF\default.txaPackage'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UTerminalF\default.txaPackage'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UClassesFinalizadores\default.txaPackage'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\default.txvpck'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UClassesFinalizadores\default.txvpck'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UdtmTerminalF\default.txvpck'}
{%TogetherDiagram 'ModelSupport_PkTerminaisF\UTerminalF\default.txvpck'}

requires
  rtl,
  vcl,
  vcldb,
  dbrtl,
  dsnap,
  ibxpress,
  pkAtivos,
  PkFormularios,
  VclSmp,
  vclx,
  xhCntrls100,
  xhStd100;

contains
  UTerminalF in 'fonte\UTerminalF.pas',
  UdtmTerminalF in 'fonte\UdtmTerminalF.pas' {dtmTerminaisF: TDataModule},
  UClassesFinalizadores in 'fonte\UClassesFinalizadores.pas',
  UdetalhesResD in 'fonte\UdetalhesResD.pas' {FrmDetalhesResD},
  USincTerminais in 'fonte\USincTerminais.pas' {FrmSincTerminais},
  UArqFiscal in 'fonte\UArqFiscal.pas' {FrmArqUsados},
  uSelTerminal in 'fonte\uSelTerminal.pas' {frmSelTerminalF},
  uGTNSerieECF in 'fonte\uGTNSerieECF.pas' {frmGtNSerieECF},
  UArqFrente in 'fonte\UArqFrente.pas',
  uClasseLayoutFiscal in 'fonte\uClasseLayoutFiscal.pas',
  uAssistenteDeConfiguracaoFiscal in 'fonte\uAssistenteDeConfiguracaoFiscal.pas' {frmAssistemConfigFiscal},
  uClassesAssistenConfig in 'fonte\uClassesAssistenConfig.pas',
  uDtmAssistente in 'fonte\uDtmAssistente.pas' {dtmAssistente: TDataModule},
  uCopiaHwF in '..\Fiscal Bpl\fonte\uCopiaHwF.pas';

end.
