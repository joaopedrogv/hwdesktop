package pkLancamentos;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  pkAtivos,
  PkFormularios,
  vcl,
  vcldb,
  dbrtl,
  pkCadastrosBasicosCx,
  pkImportFinanceiro;

contains
  uDtmLancamentos in '..\fonte\uDtmLancamentos.pas' {dtmLancamentos: TDataModule},
  uClassesLancamentos in '..\fonte\uClassesLancamentos.pas',
  uCadLancamentos in '..\fonte\uCadLancamentos.pas' {frmLancamentos},
  UParBoletim in '..\fonte\UParBoletim.pas' {FrmParBol},
  UPmapa in '..\fonte\UPmapa.pas' {FrmpMapa},
  UFech_dia in '..\fonte\UFech_dia.pas' {FrmFech_Dia},
  Uconcilia in '..\fonte\Uconcilia.pas' {FrmConcilia},
  uDetalhesRecebimentoContrapartida in '..\fonte\uDetalhesRecebimentoContrapartida.pas' {frmDetalhesRecebimentoContrapartida};

end.
