package pkContasAReceber;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}
{%File 'pkContasAReceber_INFO.txt'}

requires
  rtl,
  pkAtivos,
  vcl,
  vcldb,
  dbrtl,
  pkCadastrosBasicosCx,
  pkImportFinanceiro,
  vclx,
  IndyCore,
  IndySystem,
  IndyProtocols,
  dsnap,
  VclSmp,
  QR5RunD2006,
  vcljpg,
  bdertl,
  pkContasAPagar,
  ibxpress;

contains
  uDtmContasAReceber in '..\fonte\uDtmContasAReceber.pas' {dtmContasAReceber: TDataModule},
  uClassesContasAReceber in '..\fonte\uClassesContasAReceber.pas',
  uCadContasAReceber in '..\fonte\uCadContasAReceber.pas' {frmCadContasAReceber},
  URelClDev in '..\fonte\URelClDev.pas' {FrmPRelClDev},
  UPnivelEndiv in '..\fonte\UPnivelEndiv.pas' {FrmPNivelEndiv},
  UCartasCobranca in '..\fonte\UCartasCobranca.pas' {frmCartasCobranca},
  UConciliaCartao in '..\fonte\UConciliaCartao.pas' {FrmConciliaCartao},
  uclassesconciliacartao in '..\fonte\uclassesconciliacartao.pas',
  uNotEnvFinanc in '..\fonte\uNotEnvFinanc.pas' {frmNotEnvFinanc},
  UConciliacaoCartaoConfere in '..\fonte\UConciliacaoCartaoConfere.pas' {FrmConciliaCartaoConfere},
  uNegativarDesnegativarCliente in '..\fonte\uNegativarDesnegativarCliente.pas' {frmNegativarDesnegativarCl};

end.
