procedure TdtmContasAPagar.cdsContaAPagarBeforeOpen(DataSet: TDataSet);
begin
  dtmAtivo.mudaSelect(TClientDataSet(DataSet), dtmContasAPagar);
end;

procedure TdtmContasAPagar.cdsObsCredOBSERVACAOGetText(Sender: TField;
  var Text: string; DisplayText: Boolean);
begin
   Text := Copy(Sender.AsString, 1, 100);
end;

procedure TdtmContasAPagar.DataModuleCreate(Sender: TObject);
var
  J, I: Integer;
begin
  for J := 0 to Self.ComponentCount - 1 do
    if (Self.Components[J] is TClientDataSet) and (TClientDataSet(Self.Components[J]).Tag = 1) then
      for I := 0 to TClientDataSet(Self.Components[J]).FieldCount - 1 do
      begin
        TClientDataSet(Self.Components[J]).IndexDefs.Add('IDXA' +
          TClientDataSet(Self.Components[J]).Fields[I].FieldName,
          TClientDataSet(Self.Components[J]).Fields[I].FieldName, []);
        TClientDataSet(Self.Components[J]).IndexDefs.Add('IDXD' +
          TClientDataSet(Self.Components[J]).Fields[I].FieldName,
          TClientDataSet(Self.Components[J]).Fields[I].FieldName, [ixDescending]);
      end;
end;

procedure TdtmContasAPagar.dspContaAPagarGetTableName(Sender: TObject;
  DataSet: TDataSet; var TableName: WideString);
begin
  TableName := 'CONTAS_A_PAGAR';
end;

