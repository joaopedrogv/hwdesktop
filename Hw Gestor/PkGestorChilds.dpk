requires
  rtl,
  pkAtivos,
  PkFormularios,
  vcl,
  tee,
  xhCntrls100,
  xhChart100,
  xhStd100,
  vclx,
  dbrtl,
  vcldb,
  ibxpress,
  dsnap,
  xhDsgn100,
  dcldb,
  vcldesigner,
  designide,
  xmlrtl,
  vclactnband,
  dclstd,
  xhExport100,
  QR5RunD2006,
  vcljpg,
  bdertl,
  pkEquipamentos,
  pkMargem;

contains
  UMetas in 'fontes\UMetas.pas' {FrmMetas},
  UdtmGestorHw in 'fontes\UdtmGestorHw.pas' {DtmGestorHw: TDataModule},
  UClassesGestor in 'fontes\UClassesGestor.pas',
  UCustosGestor in 'fontes\UCustosGestor.pas' {FrmCustos},
  UPainelControl in 'fontes\UPainelControl.pas' {FrmPainelControl},
  Ufinanceiros in 'fontes\Ufinanceiros.pas' {FrmFinanceiros},
  URelatorio in 'fontes\URelatorio.pas' {FrmRelatorio},
  UFopag in 'fontes\UFopag.pas' {FrmFopag},
  UCtSalGestor in 'fontes\UCtSalGestor.pas' {FrmContasSalario},
  Udepreciacao in 'fontes\Udepreciacao.pas' {FrmDepreciacao},
  UEnsaiosDescontos in 'fontes\UEnsaiosDescontos.pas' {FrmEnsaiosDescontos},
  UCotacaoCompraVenda in 'fontes\UCotacaoCompraVenda.pas' {FrmSugestCompraVenda},
  UVisualizavinculosDpto in 'fontes\UVisualizavinculosDpto.pas' {FrmVisualDpto},
  uCadListaCotacao in 'fontes\uCadListaCotacao.pas' {frmCadListaCotacao},
  uCadAtributos in 'fontes\uCadAtributos.pas' {frmCadAtributos},
  uRelDREComparativo in 'fontes\uRelDREComparativo.pas' {frmRelDREComparativo};

end.
