package pkConsultasOLAP;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  dbrtl,
  dsnap,
  vcldb,
  ibxpress,
  xhCntrls100,
  dclstd,
  designide,
  xmlrtl,
  vclactnband,
  vclx,
  vcldesigner,
  dcldb,
  xhStd100,
  tee,
  xhChart100,
  xhDsgn100,
  xhExport100,
  PkFormularios,
  enterHw;

contains
  UClassesConsGeral in '..\UClassesConsGeral.pas',
  UConsGeral in '..\UConsGeral.pas' {FrmConsGeral},
  UdtmConsGeral in '..\UdtmConsGeral.pas' {DtmConsGeral},
  UvincConsultaUsuario in '..\UvincConsultaUsuario.pas' {FrmvincUsuario},
  UvisualizadorOLAP_2 in '..\UvisualizadorOLAP_2.pas' {FrmVisualizaOlap_2},
  uStatusProcessamento_2 in '..\uStatusProcessamento_2.pas' {frmStatusProcessamento_2},
  uBuildConsulta in '..\uBuildConsulta.pas' {frmBuilConsultaOLAP};

end.
