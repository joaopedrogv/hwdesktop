package pkUtils;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  dbrtl;

contains
  json_utils in '..\src\json_utils.pas',
  JsonListAdapter in '..\src\json\JsonListAdapter.pas',
  OldRttiMarshal in '..\src\json\OldRttiMarshal.pas',
  OldRttiUnMarshal in '..\src\json\OldRttiUnMarshal.pas',
  RestJsonOldRTTI in '..\src\json\RestJsonOldRTTI.pas',
  RestJsonUtils in '..\src\json\RestJsonUtils.pas',
  superobject in '..\src\json\superobject.pas',
  USock in '..\USock.pas';

end.
